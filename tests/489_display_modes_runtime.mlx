// The modes a display's monitor offers and a display's mode changed while
// the system runs (projects/brix/kernel/display_modes.mlx, built for the
// host), on EDIDs written here from the standard's layout and against a
// driver and a clock that are tables:
// - the user's monitor's first block as far as the machine's logs give
//   it (its own timing, 3840x1080 at 59.99 Hz, and an extension block
//   that was not passed on): the mode, marked the monitor's own, and what
//   a driver with a link's limit says of it;
// - an EDID with established timings (a bit each, those of the third kind
//   in a descriptor) and standard timings (codes in the base block and in
//   a descriptor): each mode with the numbers of the standards' tables
//   (mode_tables.mlx, which tools/check_display_modes.py holds against
//   Linux's file), a code the table has no timing for, the codes that are
//   none, the timing with reduced blanking for a monitor that takes it;
// - an EDID whose extension names video codes, with a timing written out
//   beside them: the codes' modes, the monitor's favourite's mark taken
//   off, an interlaced one, one with its pixels sent twice, a code beyond
//   the table, a mode named twice kept once, the order;
// - no EDID, and one that does not add up: the mode that runs alone;
// - every request: a mode asked for (pending, the time left), confirmed
//   (kept for the next boots), not confirmed (the clock running out: the
//   kernel takes it back, once), taken back by hand, a second request
//   while one is pending, confirming and taking back with nothing
//   pending, a mode the display does not have, a size of a driver that
//   makes any, one refused by the driver's word with nothing written, the
//   mode that runs asked for again, a change that fails with the mode
//   before back or not, a way back that fails, a remembered mode set at
//   boot, forgotten, the modes listed anew when the monitor says more of
//   itself while a change is pending;
// - the room a list takes in the value arena, for an EDID that names
//   every kind of timing many times: less than 64 KiB;
// - what is remembered: the file's text written, read, replaced for one
//   display beside another's, forgotten, lines that are none; and what a
//   boot does with it (set; left when the boot sets nothing; forgotten
//   when the monitor's own mode was asked for by hand);
// - the records a program reads, byte for byte, and the lines' words.
// Exits 13.
const std = @import("std")
const dm = @import("../projects/brix/kernel/display_modes.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const turns = @import("std.turns")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

// ---- An EDID being written: three blocks' room.
var bytes: [384]u8 = undefined

fn seal(block: usize) -> void {
    var sum: usize = 0
    var k: usize = 0
    while k < 127 {
        sum += @intCast(usize, bytes[block + k])
        k += 1
    }
    bytes[block + 127] = @intCast(u8, (256 - sum % 256) % 256)
}

// A base block without timings: the header, a maker, a product and a
// serial number, EDID 1.`revision`, a digital input, no established
// timings, the standard timings' codes unused (01 01), four descriptors
// that are none, and `extensions` blocks said to follow.
fn base(revision: u8, extensions: u8) -> void {
    var k: usize = 0
    while k < 384 {
        bytes[k] = 0
        k += 1
    }
    k = 1
    while k < 7 {
        bytes[k] = 0xFF
        k += 1
    }
    bytes[8] = 0x4C
    bytes[9] = 0x2D
    bytes[10] = 0x12
    bytes[11] = 0x34
    bytes[12] = 0x78
    bytes[13] = 0x56
    bytes[14] = 0x34
    bytes[15] = 0x12
    bytes[18] = 1
    bytes[19] = revision
    bytes[20] = 0xA5
    k = 38
    while k < 54 {
        bytes[k] = 1
        k += 1
    }
    k = 0
    while k < 4 {
        bytes[54 + k * 18 + 3] = 0x10
        k += 1
    }
    bytes[126] = extensions
    seal(0)
}

// A detailed timing's 18 bytes at `at` (as tests/459 writes them).
fn timing(at: usize, clock: usize, width: usize, hBlank: usize, hFront: usize, hSync: usize, height: usize, vBlank: usize, vFront: usize, vSync: usize, flags: u8) -> void {
    bytes[at] = @intCast(u8, (clock / 10) & 0xFF)
    bytes[at + 1] = @intCast(u8, (clock / 10) >> 8)
    bytes[at + 2] = @intCast(u8, width & 0xFF)
    bytes[at + 3] = @intCast(u8, hBlank & 0xFF)
    bytes[at + 4] = @intCast(u8, ((width >> 8) << 4) | (hBlank >> 8))
    bytes[at + 5] = @intCast(u8, height & 0xFF)
    bytes[at + 6] = @intCast(u8, vBlank & 0xFF)
    bytes[at + 7] = @intCast(u8, ((height >> 8) << 4) | (vBlank >> 8))
    bytes[at + 8] = @intCast(u8, hFront & 0xFF)
    bytes[at + 9] = @intCast(u8, hSync & 0xFF)
    bytes[at + 10] = @intCast(u8, ((vFront & 0xF) << 4) | (vSync & 0xF))
    bytes[at + 11] = @intCast(u8, ((hFront >> 8) << 6) | ((hSync >> 8) << 4) | ((vFront >> 4) << 2) | (vSync >> 4))
    bytes[at + 12] = 0xB0
    bytes[at + 13] = 0x50
    bytes[at + 14] = 0x41
    bytes[at + 15] = 0
    bytes[at + 16] = 0
    bytes[at + 17] = flags
}

// The user's monitor's own timing as the machine's log gives it:
// "3840x1080 at 59.99 Hz: pixel clock 270270 kHz, h 3840 4040 (front 48
// sync 32 +), v 1080 1115 (front 3 sync 5 -)".
fn userTiming(at: usize) -> void { timing(at, 270270, 3840, 200, 48, 32, 1080, 35, 3, 5, 0x1A) }

// ---- A driver that is a table: what it is asked, in order; what it
// answers is set beforehand.
var judged: usize = 0
var sets: usize = 0
var backs: usize = 0
var lastSet: dm.Mode = undefined
var lastBack: dm.Mode = undefined
var lastWhich: usize = 0
// A link's most in kHz (0: none) and an adapter's memory in bytes (0:
// endless).
var limit: usize = 0
var memory: usize = 0
var give = dm.Set.done
var giveBack = dm.Set.done
var pictureBefore: dm.Picture = undefined

fn judge(which: usize, mode: *dm.Mode) -> void {
    judged += 1
    if limit != 0 && mode.*.timed && mode.*.timing.clock > limit {
        mode.*.why = dm.Why.TOO_FAST
        mode.*.limit = limit
    }
    if memory != 0 && mode.*.width * mode.*.height * 4 > memory { mode.*.why = dm.Why.MEMORY }
}

fn set(which: usize, mode: *const dm.Mode, picture: *dm.Picture) -> dm.Set {
    sets += 1
    lastSet = mode.*
    lastWhich = which
    if give != dm.Set.done { return give }
    pictureBefore = picture.*
    picture.*.address = 0x1000000 * sets
    picture.*.width = mode.*.width
    picture.*.height = mode.*.height
    picture.*.pitch = mode.*.width * 4
    return dm.Set.done
}

fn back(which: usize, before: *const dm.Mode, picture: *dm.Picture) -> dm.Set {
    backs += 1
    lastBack = before.*
    if giveBack != dm.Set.done { return giveBack }
    picture.* = pictureBefore
    return dm.Set.done
}

fn driver(kind: usize, timed: bool, anySize: bool) -> dm.Driver {
    return dm.Driver.{ .kind = kind, .which = 7, .timed = timed, .anySize = anySize, .judge = judge, .set = set, .back = back }
}

fn quiet() -> void {
    judged = 0
    sets = 0
    backs = 0
    limit = 0
    memory = 0
    give = dm.Set.done
    giveBack = dm.Set.done
}

// ---- A clock that is a table: each look gives the next time.
const SECOND: usize = 1000000000
const TIMES = [_]usize{ 100 * SECOND, 101 * SECOND, 114 * SECOND, 115 * SECOND - 1, 115 * SECOND, 116 * SECOND, 200 * SECOND, 214 * SECOND, 215 * SECOND + 5, 300 * SECOND }
var looked: usize = 0

fn now() -> usize {
    const time = TIMES[looked]
    looked += 1
    return time
}

var state: dm.State = undefined
var list: dm.List = undefined

fn at(width: usize, height: usize, millihertz: usize) -> usize {
    var k: usize = 0
    while k < state.list.count {
        const m = &state.list.modes[k]
        if m.*.width == width && m.*.height == height && m.*.millihertz == millihertz { return k }
        k += 1
    }
    return dm.NONE
}

fn inList(width: usize, height: usize, millihertz: usize) -> usize {
    var k: usize = 0
    while k < list.count {
        const m = &list.modes[k]
        if m.*.width == width && m.*.height == height && m.*.millihertz == millihertz { return k }
        k += 1
    }
    return dm.NONE
}

// Whether list mode `k` has this timing.
fn timed(k: usize, clock: usize, hTotal: usize, hFront: usize, hSync: usize, hPositive: bool, vTotal: usize, vFront: usize, vSync: usize, vPositive: bool) -> bool {
    if k == dm.NONE { return false }
    const m = &list.modes[k]
    const t = &m.*.timing
    return m.*.timed && t.*.clock == clock && t.*.hTotal == hTotal && t.*.hFront == hFront && t.*.hSync == hSync && t.*.hPositive == hPositive && t.*.vTotal == vTotal && t.*.vFront == vFront && t.*.vSync == vSync && t.*.vPositive == vPositive
}

fn word32(from: [*]const u8, offset: usize) -> usize {
    return @intCast(usize, from[offset]) | (@intCast(usize, from[offset + 1]) << 8) | (@intCast(usize, from[offset + 2]) << 16) | (@intCast(usize, from[offset + 3]) << 24)
}

// What sayMode and sayWhy write.
const LOG: usize = 512
var log: [LOG]u8 = undefined
var logged: usize = 0

fn write(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length && logged < LOG {
        log[logged] = text[k]
        logged += 1
        k += 1
    }
}

fn said(text: []const u8) -> bool {
    if text.length != logged { return false }
    var k: usize = 0
    while k < logged {
        if log[k] != text[k] { return false }
        k += 1
    }
    return true
}

fn theUsersMonitor() -> void {
    // Its first block alone, as the firmware passes it on: the own
    // timing, and one extension block named that is not there.
    base(3, 1)
    userTiming(54)
    seal(0)
    dm.read(bytes[0..128], &list)
    expect(list.count == 1 && list.unnamed == 0 && list.beyond == 0, "the user's monitor's first block: one mode")
    const own = inList(3840, 1080, 59998)
    expect(own == 0 && list.modes[0].own && list.modes[0].source == dm.Source.DETAILED, "3840x1080 at 59.998 Hz, the monitor's own, written out")
    expect(timed(own, 270270, 4040, 48, 32, true, 1115, 3, 5, false), "its timing as the log gives it")
    expect(dm.monitorName(bytes[0..128]) == 0x4C2D123478563412, "the monitor's name: its maker, product and serial number")
    // The same through a display's state, with a driver of a link that
    // carries 339999 kHz (HDMI without scrambling) and then one that
    // carries a DVI link's 165000 kHz: the reason and the limit.
    quiet()
    limit = 339999
    var picture = dm.Picture.{ .address = 0xD0500000, .width = 3840, .height = 1080, .pitch = 15360 }
    const tmds = driver(dm.Kind.RADEON_TMDS, true, false)
    state.begin(&tmds, bytes[0..128], &picture, 59867, null)
    expect(state.list.count == 1 && state.runs.own && state.runs.millihertz == 59998, "what runs (59.867 frames a second counted) is the monitor's own mode")
    expect(state.list.modes[0].why == dm.Why.NONE, "a link of 340 MHz carries the monitor's own mode")
    limit = 165000
    state.judge()
    expect(state.list.modes[0].why == dm.Why.TOO_FAST && state.list.modes[0].limit == 165000, "a link of 165 MHz does not: more than the output carries, with its most")
    logged = 0
    dm.sayMode(write, &state.list.modes[0])
    expect(said("3840x1080 at 59.99 Hz"), "the mode's words")
    logged = 0
    dm.sayWhy(write, state.list.modes[0].why, state.list.modes[0].limit)
    expect(said("more than this output carries (165 MHz at most)"), "the reason's words")
    // The firmware's own mode on that monitor (1280x960, which the
    // monitor's block does not name) is listed as what runs.
    limit = 339999
    picture = dm.Picture.{ .address = 0xD0000000, .width = 1280, .height = 960, .pitch = 5120 }
    state.begin(&tmds, bytes[0..128], &picture, 59981, null)
    expect(state.list.count == 2 && state.list.modes[0].own && state.list.modes[1].source == dm.Source.RUNNING && state.list.modes[1].width == 1280 && state.list.modes[1].millihertz == 59981, "the firmware's mode beside the monitor's own")
    expect(state.list.modes[1].why == dm.Why.NO_TIMING, "which a driver that sends a timing cannot be asked for: it has none")
}

fn namedTimings() -> void {
    // Established timings (800x600 at 60, 640x480 at 60 and 720x400 at
    // 70 in byte 35; 1024x768 at 60 and the interlaced 1024x768 in byte
    // 36; 1152x864 at 75 in byte 37) and standard timings (1920x1080,
    // 1280x1024 and 1600x1200 at 60 Hz, 1152x864 at 60 Hz, which VESA's
    // table has no row for, a code of 00 00 and one of 20 20), EDID 1.3.
    base(3, 0)
    bytes[35] = 0x01 | 0x20 | 0x80
    bytes[36] = 0x08 | 0x10
    bytes[37] = 0x80
    bytes[38] = 0xD1
    bytes[39] = 0xC0
    bytes[40] = 0x81
    bytes[41] = 0x80
    bytes[42] = 0xA9
    bytes[43] = 0x40
    bytes[44] = 0x71
    bytes[45] = 0x40
    bytes[46] = 0x00
    bytes[47] = 0x00
    bytes[48] = 0x20
    bytes[49] = 0x20
    seal(0)
    dm.read(bytes[0..128], &list)
    expect(list.count == 10 && list.unnamed == 0, "six established and four standard timings")
    expect(timed(inList(800, 600, 60316), 40000, 1056, 40, 128, true, 628, 1, 4, true), "800x600 at 60 Hz: 40 MHz, 1056 by 628")
    expect(timed(inList(640, 480, 59940), 25175, 800, 16, 96, false, 525, 10, 2, false), "640x480 at 60 Hz: 25.175 MHz, 800 by 525")
    expect(timed(inList(720, 400, 70081), 28320, 900, 18, 108, false, 449, 12, 2, true), "720x400 at 70 Hz")
    expect(timed(inList(1024, 768, 60003), 65000, 1344, 24, 136, false, 806, 3, 6, false), "1024x768 at 60 Hz: 65 MHz, 1344 by 806")
    const interlaced = inList(1024, 768, 86956)
    expect(timed(interlaced, 44900, 1264, 8, 176, true, 817, 0, 8, true) && list.modes[interlaced].timing.interlaced, "1024x768 interlaced, 87 fields a second")
    expect(timed(inList(1152, 864, 75000), 108000, 1600, 64, 128, true, 900, 1, 3, true), "1152x864 at 75 Hz")
    expect(timed(inList(1920, 1080, 60000), 148500, 2200, 88, 44, false, 1125, 4, 5, false) && list.modes[inList(1920, 1080, 60000)].source == dm.Source.STANDARD, "1920x1080 at 60 Hz by its code: VESA's 148.5 MHz, 2200 by 1125")
    expect(timed(inList(1280, 1024, 60019), 108000, 1688, 48, 112, true, 1066, 1, 3, true), "1280x1024 at 60 Hz by its code")
    expect(timed(inList(1600, 1200, 60000), 162000, 2160, 64, 192, true, 1250, 1, 3, true), "1600x1200 at 60 Hz by its code")
    const bare = inList(1152, 864, 60000)
    expect(bare != dm.NONE && !list.modes[bare].timed && list.modes[bare].source == dm.Source.STANDARD, "1152x864 at 60 Hz: a size and a rate, no timing")
    // The largest first.
    expect(list.modes[0].width == 1920 && list.modes[1].width == 1600 && list.modes[2].width == 1280 && list.modes[9].width == 720, "the largest first")
    expect(list.modes[3].millihertz == 75000 && list.modes[4].millihertz == 60000 && list.modes[3].width == 1152, "of one size the higher rate first")
    // A driver that sends a timing judges them: the interlaced one and
    // the one without a timing cannot be set.
    quiet()
    var picture = dm.Picture.{ .address = 0x100000, .width = 1024, .height = 768, .pitch = 4096 }
    const tmds = driver(dm.Kind.RADEON_TMDS, true, false)
    state.begin(&tmds, bytes[0..128], &picture, 0, null)
    expect(state.list.modes[at(1024, 768, 86956)].why == dm.Why.INTERLACED && judged == 8, "an interlaced picture is not built, and the driver is not asked about it")
    expect(state.list.modes[at(1152, 864, 60000)].why == dm.Why.NO_TIMING, "a mode without a timing cannot be sent")
    expect(state.runs.millihertz == 60003 && state.list.count == 10, "what runs with no rate known: the listed mode of that size")
    // One that sets a size alone can set them all.
    const plain = driver(dm.Kind.QEMU, false, true)
    state.begin(&plain, bytes[0..128], &picture, 0, null)
    expect(state.list.modes[at(1024, 768, 86956)].why == dm.Why.NONE && state.list.modes[at(1152, 864, 60000)].why == dm.Why.NONE, "a driver that sets a size alone sets every one")

    // EDID 1.4 with a range descriptor that says reduced blanking is
    // taken: the standard timing's code for 1440x900 at 60 Hz gives the
    // row with reduced blanking (88.75 MHz), and 1600x1200 at 120 Hz,
    // which VESA has with reduced blanking alone, a timing; without the
    // descriptor the second has none. The descriptors: more standard
    // timings (1680x1050 at 60 Hz, the HDTV size 1360x765 that means
    // 1366x768) and established timings of the third kind (1440x900 at
    // 60 Hz with reduced blanking and without, 1920x1200 at 60 Hz
    // without).
    base(4, 0)
    bytes[38] = 0x95
    bytes[39] = 0x00
    bytes[40] = 0xA9
    bytes[41] = 0x7C
    bytes[54 + 3] = 0xFD
    bytes[54 + 10] = 0x04
    bytes[54 + 15] = 0x10
    bytes[72 + 3] = 0xFA
    bytes[72 + 5] = 0xB3
    bytes[72 + 6] = 0x00
    bytes[72 + 7] = 0x8B
    bytes[72 + 8] = 0xC0
    var k: usize = 4
    while k < 6 {
        bytes[72 + 5 + k * 2] = 1
        bytes[72 + 6 + k * 2] = 1
        k += 1
    }
    bytes[72 + 9] = 1
    bytes[72 + 10] = 1
    bytes[72 + 11] = 1
    bytes[72 + 12] = 1
    bytes[90 + 3] = 0xF7
    bytes[90 + 5] = 0x0A
    // (Row 17 and 18: byte 2's bits 6 and 5; row 39: byte 4's bit 0.)
    bytes[90 + 8] = 0x60
    bytes[90 + 10] = 0x01
    seal(0)
    dm.read(bytes[0..128], &list)
    expect(timed(inList(1440, 900, 59901), 88750, 1600, 48, 32, true, 926, 3, 6, false), "1440x900 at 60 Hz with reduced blanking, for a monitor that takes it")
    expect(timed(inList(1440, 900, 59887), 106500, 1904, 80, 152, false, 934, 3, 6, true), "and without, by the established timings of the third kind")
    expect(timed(inList(1600, 1200, 119917), 268250, 1760, 48, 32, true, 1271, 3, 4, false), "1600x1200 at 120 Hz, which VESA has with reduced blanking alone")
    expect(timed(inList(1680, 1050, 59883), 119000, 1840, 48, 32, true, 1080, 3, 6, false), "1680x1050 at 60 Hz from a descriptor's code")
    expect(timed(inList(1366, 768, 59789), 85500, 1792, 70, 143, true, 798, 3, 3, true), "the HDTV code as 1366x768")
    expect(timed(inList(1920, 1200, 59884), 193250, 2592, 136, 200, false, 1245, 3, 6, true), "1920x1200 at 60 Hz of the third kind")
    expect(list.count == 6 && list.unnamed == 0, "six modes, each once")
    // Without the range descriptor.
    bytes[54 + 3] = 0x10
    bytes[54 + 10] = 0
    bytes[54 + 15] = 0
    seal(0)
    dm.read(bytes[0..128], &list)
    expect(inList(1440, 900, 59901) != dm.NONE && inList(1440, 900, 59887) != dm.NONE, "both rows of 1440x900 by their bits")
    const fast = inList(1600, 1200, 120000)
    expect(fast != dm.NONE && !list.modes[fast].timed && inList(1600, 1200, 119917) == dm.NONE, "1600x1200 at 120 Hz without a timing for a monitor that does not say it takes reduced blanking")
    // The table's rows by size, rate and blanking.
    expect(dm.findDmt(1920, 1080, 60, false) != dm.dmtRows() && dm.findDmt(1920, 1080, 60, true) == dm.dmtRows() && dm.findDmt(1920, 1080, 61, false) == dm.dmtRows(), "VESA's table by size, rate and blanking")
}

fn videoCodes() -> void {
    // A base block with the monitor's own timing (1920x1080 at 60 Hz, the
    // standards' 148.5 MHz) and a CTA-861 extension: a video block that
    // names 1920x1080 at 60 Hz (the monitor's favourite: the upper bit),
    // 1280x720 at 60, 1920x1080 at 50, the interlaced 1920x1080, the
    // 720x480 picture with its pixels sent twice, 3840x2160 at 60 Hz and a
    // code beyond the table; then, written out, 2560x1440 at 60 Hz.
    base(3, 1)
    timing(54, 148500, 1920, 280, 88, 44, 1080, 45, 4, 5, 0x1E)
    seal(0)
    bytes[128] = 0x02
    bytes[129] = 0x03
    bytes[130] = 12
    bytes[131] = 0x00
    bytes[132] = 0x47
    bytes[133] = 0x90
    bytes[134] = 4
    bytes[135] = 31
    bytes[136] = 5
    bytes[137] = 6
    bytes[138] = 97
    bytes[139] = 200
    timing(128 + 12, 241500, 2560, 160, 48, 32, 1440, 41, 3, 5, 0x1A)
    seal(128)
    dm.read(bytes[0..256], &list)
    expect(list.count == 7 && list.unnamed == 1 && list.beyond == 0, "seven modes, and a code the table does not have")
    expect(list.modes[0].width == 3840 && list.modes[0].height == 2160 && list.modes[0].source == dm.Source.VIDEO_CODE && timed(0, 594000, 4400, 176, 88, true, 2250, 8, 10, true), "3840x2160 at 60 Hz by its code: 594 MHz")
    expect(list.modes[1].width == 2560 && list.modes[1].source == dm.Source.DETAILED && timed(1, 241500, 2720, 48, 32, true, 1481, 3, 5, false), "the extension's timing written out")
    const own = inList(1920, 1080, 60000)
    expect(own == 2 && list.modes[own].own && list.modes[own].source == dm.Source.DETAILED, "1920x1080 at 60 Hz once: the timing written out, the monitor's own, not the code's")
    expect(timed(inList(1920, 1080, 50000), 148500, 2640, 528, 44, true, 1125, 4, 5, true), "1920x1080 at 50 Hz by its code")
    const fields = inList(1920, 1080, 60000 + 0)
    var interlaced: usize = dm.NONE
    var k: usize = 0
    while k < list.count {
        if list.modes[k].width == 1920 && list.modes[k].timed && list.modes[k].timing.interlaced { interlaced = k }
        k += 1
    }
    expect(fields != dm.NONE && interlaced != dm.NONE && list.modes[interlaced].millihertz == 60000 && interlaced > own, "the interlaced 1920x1080 beside it, after it")
    expect(timed(inList(1280, 720, 60000), 74250, 1650, 110, 40, true, 750, 5, 5, true), "1280x720 at 60 Hz by its code")
    const twice = inList(720, 480, 59940)
    expect(twice != dm.NONE && list.modes[twice].doubled && list.modes[twice].timing.interlaced, "720x480 with its pixels sent twice")
    // Judged by a driver that sends a timing over a link of 340 MHz.
    quiet()
    limit = 339999
    var picture = dm.Picture.{ .address = 0x100000, .width = 1920, .height = 1080, .pitch = 7680 }
    const tmds = driver(dm.Kind.RADEON_TMDS, true, false)
    state.begin(&tmds, bytes[0..256], &picture, 60000, null)
    expect(state.list.modes[0].why == dm.Why.TOO_FAST && state.list.modes[0].limit == 339999, "3840x2160 at 60 Hz is more than the link carries")
    expect(state.list.modes[at(720, 480, 59940)].why == dm.Why.INTERLACED, "the interlaced one with pixels sent twice: interlaced is said first")
    expect(state.runs.own && state.runs.source == dm.Source.DETAILED, "what runs is the monitor's own")
    // The extension block not passed on: the base block's mode alone.
    dm.read(bytes[0..128], &list)
    expect(list.count == 1 && list.modes[0].own, "without the extension block: the base block's")
    // An extension block that does not add up is left out.
    bytes[140] = bytes[140] ^ 0x01
    dm.read(bytes[0..256], &list)
    expect(list.count == 1, "an extension block that does not add up names nothing")

    // An interlaced timing written out: its numbers down are a field's.
    base(3, 0)
    timing(54, 74250, 1920, 280, 88, 44, 540, 22, 2, 5, 0x9E)
    seal(0)
    dm.read(bytes[0..128], &list)
    expect(list.count == 1 && list.modes[0].height == 1080 && list.modes[0].timing.vTotal == 1125 && list.modes[0].millihertz == 60000 && !list.modes[0].own, "an interlaced timing written out: the frame's size, the fields' rate")
}

fn noEdid() -> void {
    quiet()
    var picture = dm.Picture.{ .address = 0xE0000000, .width = 1024, .height = 768, .pitch = 4096 }
    const none = driver(dm.Kind.FIRMWARE, false, false)
    state.begin(&none, bytes[0..0], &picture, 0, null)
    expect(state.list.count == 1 && state.list.modes[0].source == dm.Source.RUNNING && state.list.modes[0].width == 1024 && state.list.modes[0].millihertz == 0, "no EDID: the mode that runs alone")
    logged = 0
    dm.sayMode(write, &state.list.modes[0])
    expect(said("1024x768"), "a mode whose rate is not known")
    base(3, 0)
    userTiming(54)
    seal(0)
    bytes[60] = bytes[60] ^ 0x40
    dm.read(bytes[0..128], &list)
    expect(list.count == 0 && dm.monitorName(bytes[0..128]) == 0, "an EDID that does not add up names nothing")
    bytes[60] = bytes[60] ^ 0x40
    bytes[3] = 0
    dm.read(bytes[0..128], &list)
    expect(list.count == 0, "bytes that are no EDID")
}

// The EDID the requests run on: the own mode 1920x1080 at 60 Hz, and by
// their bits 1024x768, 800x600 and 640x480 at 60 Hz.
fn fourModes() -> void {
    base(3, 0)
    timing(54, 148500, 1920, 280, 88, 44, 1080, 45, 4, 5, 0x1E)
    bytes[35] = 0x01 | 0x20
    bytes[36] = 0x08
    seal(0)
}

fn requests() -> void {
    fourModes()
    quiet()
    looked = 0
    var picture = dm.Picture.{ .address = 0x100000, .width = 1920, .height = 1080, .pitch = 7680 }
    const tmds = driver(dm.Kind.RADEON_TMDS, true, false)
    state.begin(&tmds, bytes[0..128], &picture, 59950, null)
    expect(state.list.count == 4 && state.runs.own && !state.pending && state.changes == 0 && state.last == dm.Answer.none, "four modes, the own one runs, nothing pending")
    var words: [48]u8 = undefined
    state.describe(0, &words)
    expect(word32(&words, 0) == 0 && word32(&words, 8) == 2 && word32(&words, 16) == 0 && word32(&words, 24) == 60000 && word32(&words, 32) == dm.Kind.RADEON_TMDS && word32(&words, 40) == 0, "the display's state at the start: a driver that changes modes, nothing pending")

    // Asked for: it runs, pending, fifteen seconds from the request.
    expect(state.ask(1024, 768, 60003, now()) == dm.Answer.changed && sets == 1 && lastWhich == 7 && lastSet.width == 1024 && lastSet.timing.clock == 65000, "a mode asked for: the driver sets it, with its timing")
    expect(state.pending && state.deadline == 115 * SECOND && state.runs.width == 1024 && state.before.width == 1920 && state.changes == 1, "it is pending, the mode before kept")
    expect(state.picture.width == 1024 && state.picture.pitch == 4096 && state.picture.address == 0x1000000, "the display's picture is the new one")
    state.describe(101 * SECOND, &words)
    expect(word32(&words, 0) == 1 && word32(&words, 8) == 3 && word32(&words, 16) == (14 * SECOND) & 0xFFFFFFFF && word32(&words, 20) == (14 * SECOND) >> 32 && word32(&words, 24) == 60003 && word32(&words, 40) == 1, "the state says pending, fourteen seconds left, changed")
    var record: [64]u8 = undefined
    state.record(at(1024, 768, 60003), &record)
    expect(word32(&record, 0) == 1024 && word32(&record, 4) == 768 && word32(&record, 8) == 60003 && word32(&record, 12) == dm.Flag.RUNS | dm.Flag.CAN && word32(&record, 16) == 0 && word32(&record, 20) == dm.Source.ESTABLISHED, "the record of the mode that runs")
    expect(word32(&record, 24) == 65000 && word32(&record, 28) == 1344 && word32(&record, 32) == 24 && word32(&record, 36) == 136 && word32(&record, 40) == 806 && word32(&record, 44) == 3 && word32(&record, 48) == 6 && word32(&record, 52) == 0 && word32(&record, 56) == 0 && word32(&record, 60) == 0, "its timing in the record")
    state.record(at(1920, 1080, 60000), &record)
    expect(word32(&record, 12) == dm.Flag.OWN | dm.Flag.CAN | dm.Flag.BEFORE && word32(&record, 52) == 3, "the record of the mode before: the monitor's own, the one that comes back")

    // A second request while it is pending: busy, the driver not asked.
    expect(state.ask(800, 600, 60316, now()) == dm.Answer.busy && sets == 1 && state.runs.width == 1024 && state.deadline == 115 * SECOND, "a second request while one is pending: busy, nothing done")
    // The clock: not yet at 114 s, not a nanosecond before, at 115 s the
    // kernel takes it back, once.
    expect(!state.tick(now()) && !state.tick(now()) && backs == 0, "before the time is over nothing is taken back")
    expect(state.tick(now()) && backs == 1 && state.last == dm.Answer.timed_out, "at fifteen seconds the kernel takes it back")
    expect(!state.pending && state.runs.width == 1920 && state.runs.own && state.picture.address == 0x100000 && state.picture.pitch == 7680 && state.changes == 2, "the mode before runs again, on its picture")
    expect(!state.tick(now()) && backs == 1 && !state.hasKept, "and is not taken back again; nothing is remembered")
    state.describe(116 * SECOND, &words)
    expect(word32(&words, 8) == 2 && word32(&words, 16) == 0 && word32(&words, 40) == 5, "the state says: taken back by the kernel")

    // Asked for and confirmed: it stays and is kept for the next boots.
    expect(state.ask(800, 600, 60316, now()) == dm.Answer.changed && state.deadline == 215 * SECOND, "another mode asked for")
    expect(state.confirm() == dm.Answer.confirmed && !state.pending && state.hasKept && state.keep && state.kept.width == 800 && state.runs.width == 800, "confirmed: it stays and is kept")
    expect(!state.tick(now()) && !state.tick(now()) && backs == 1 && state.runs.width == 800, "the clock running on takes nothing back")
    state.record(at(800, 600, 60316), &record)
    expect(word32(&record, 12) == dm.Flag.RUNS | dm.Flag.CAN | dm.Flag.KEPT, "its record says it runs and is the one kept")
    state.describe(300 * SECOND, &words)
    expect(word32(&words, 8) == 10 && word32(&words, 40) == 3, "the state says a mode is remembered")
    expect(state.confirm() == dm.Answer.nothing_pending && state.takeBack() == dm.Answer.nothing_pending && backs == 1, "confirming and taking back with nothing pending")

    // Taken back by hand.
    expect(state.ask(640, 480, 59940, now()) == dm.Answer.changed && state.takeBack() == dm.Answer.taken_back && backs == 2 && state.runs.width == 800 && !state.pending, "taken back by the program: the mode before, the confirmed one")
    expect(state.hasKept && state.kept.width == 800, "what is kept stays the confirmed one")

    // What cannot be asked for.
    const setsBefore = sets
    const changesBefore = state.changes
    expect(state.ask(1280, 1024, 60019, 0) == dm.Answer.not_listed, "a mode the display does not have")
    expect(state.ask(800, 600, 60316, 0) == dm.Answer.already && !state.pending, "the mode that runs asked for again: nothing to do")
    expect(state.ask(1024, 768, 0, 0) == dm.Answer.changed && state.runs.millihertz == 60003 && state.confirm() == dm.Answer.confirmed, "a size asked for at any rate")
    limit = 100000
    expect(state.ask(1920, 1080, 60000, 0) == dm.Answer.refused && state.lastWhy == dm.Why.TOO_FAST && sets == setsBefore + 1 && !state.pending, "a mode the output does not carry: refused, nothing written")
    state.describe(0, &words)
    expect(word32(&words, 40) == 9 | (dm.Why.TOO_FAST << 8), "the state says refused, and why")
    limit = 0
    expect(state.changes == changesBefore + 1, "only the change that was made counts")

    // A change that fails.
    give = dm.Set.back
    expect(state.ask(640, 480, 59940, 0) == dm.Answer.failed_back && !state.pending && state.runs.width == 1024 && state.changes == changesBefore + 1, "a change that fails with the mode before back: nothing pending, nothing changed")
    give = dm.Set.lost
    expect(state.ask(640, 480, 59940, 0) == dm.Answer.failed_lost && !state.pending && state.runs.width == 1024 && state.changes == changesBefore + 2, "one that is not known to be back: programs are told to look")
    give = dm.Set.refused
    expect(state.ask(640, 480, 59940, 0) == dm.Answer.refused && state.lastWhy == dm.Why.CARD && state.changes == changesBefore + 2, "one the driver refuses when it is to set it")
    give = dm.Set.done

    // A way back that fails: by hand, and by the clock, which does not
    // try again.
    expect(state.ask(640, 480, 59940, 1000) == dm.Answer.changed, "a mode asked for")
    giveBack = dm.Set.lost
    const backsBefore = backs
    expect(state.takeBack() == dm.Answer.failed_lost && !state.pending && backs == backsBefore + 1 && state.runs.width == 640, "a way back that fails: said, and pending no more")
    giveBack = dm.Set.done
    expect(state.ask(800, 600, 60316, 2000) == dm.Answer.changed, "a mode asked for")
    giveBack = dm.Set.back
    expect(state.tick(2000 + dm.CONFIRM_TIME) && state.last == dm.Answer.failed_back && !state.tick(3000 + dm.CONFIRM_TIME) && backs == backsBefore + 2, "the kernel's own way back failing is not gone again")
    giveBack = dm.Set.done
}

fn sizesAndBoot() -> void {
    // A driver that makes any size its memory holds (16 MiB).
    fourModes()
    quiet()
    memory = 16 * 1024 * 1024
    var picture = dm.Picture.{ .address = 0xFD000000, .width = 1024, .height = 768, .pitch = 4096 }
    const plain = driver(dm.Kind.QEMU, false, true)
    state.begin(&plain, bytes[0..128], &picture, 0, null)
    var words: [48]u8 = undefined
    state.describe(0, &words)
    expect(word32(&words, 8) == 6 && word32(&words, 24) == 60003 && word32(&words, 32) == dm.Kind.QEMU, "a driver that makes sizes not listed says so")
    expect(state.ask(1000, 700, 0, 5) == dm.Answer.changed && lastSet.width == 1000 && lastSet.height == 700 && !lastSet.timed && lastSet.source == dm.Source.ASKED && state.pending, "a size that is not listed, asked of a driver that makes any")
    expect(state.confirm() == dm.Answer.confirmed && state.kept.width == 1000 && state.kept.millihertz == 0, "confirmed and kept")
    expect(state.ask(1000, 700, 0, 6) == dm.Answer.already, "the same size again")
    expect(state.ask(4096, 2160, 0, 7) == dm.Answer.refused && state.lastWhy == dm.Why.MEMORY, "a size the memory does not hold")
    expect(state.ask(0, 700, 0, 8) == dm.Answer.not_listed, "no size at all")
    // (A size nothing names has no rate: asked for with one, it is none;
    // the record would say a made-up rate.)
    expect(state.ask(1000, 704, 75000, 9) == dm.Answer.not_listed && state.ask(800, 600, 0xFFFFFFFF, 9) == dm.Answer.not_listed && state.runs.width == 1000 && !state.pending, "a size that is not listed, asked for at a rate: none")
    logged = 0
    dm.sayWhy(write, dm.Why.MEMORY, 0)
    expect(said("more than the adapter's memory holds"), "the reason's words")

    // At boot: a mode remembered from an earlier boot is set, not
    // pending; one the display no longer has, one the driver refuses.
    quiet()
    const tmds = driver(dm.Kind.RADEON_TMDS, true, false)
    picture = dm.Picture.{ .address = 0x100000, .width = 1920, .height = 1080, .pitch = 7680 }
    state.begin(&tmds, bytes[0..128], &picture, 60000, null)
    expect(state.restore(1024, 768, 60003) == dm.Answer.confirmed && sets == 1 && !state.pending && state.runs.width == 1024 && state.hasKept && state.kept.width == 1024 && !state.keep, "a remembered mode set at boot: it runs, not pending, kept, not written again")
    expect(!state.tick(1000 * SECOND), "and no clock takes it back")
    state.begin(&tmds, bytes[0..128], &picture, 60000, null)
    expect(state.restore(1280, 1024, 60019) == dm.Answer.not_listed && sets == 1 && !state.hasKept, "a remembered mode the monitor does not name: nothing set")
    limit = 50000
    expect(state.restore(1024, 768, 60003) == dm.Answer.refused && state.lastWhy == dm.Why.TOO_FAST && sets == 1 && state.hasKept, "one the output does not carry: nothing set, still the one kept")
    limit = 0
    expect(state.restore(1920, 1080, 60000) == dm.Answer.already && sets == 1, "the mode that runs already")
    state.forget()
    expect(!state.hasKept && !state.keep, "forgotten")

    // The monitor says more of itself later (more of its EDID was read):
    // the modes are listed anew, and what runs, what is pending and the
    // mode before stay.
    quiet()
    state.begin(&tmds, bytes[0..128], &picture, 60000, null)
    expect(state.ask(1024, 768, 60003, 50) == dm.Answer.changed && state.list.count == 4, "a mode asked for on the monitor of four modes")
    base(3, 0)
    timing(54, 148500, 1920, 280, 88, 44, 1080, 45, 4, 5, 0x1E)
    timing(72, 241500, 2560, 160, 48, 32, 1440, 41, 3, 5, 0x1A)
    bytes[35] = 0x01
    seal(0)
    state.relist(bytes[0..128])
    expect(state.list.count == 4 && at(2560, 1440, 59950) == 0 && at(640, 480, 59940) == dm.NONE, "listed anew: the new monitor's modes")
    expect(state.pending && state.runs.width == 1024 && at(1024, 768, 60003) != dm.NONE && state.list.modes[at(1024, 768, 60003)].source == dm.Source.ESTABLISHED && state.before.width == 1920, "the mode that runs is listed beside them though the monitor does not name it; it is still pending")
    expect(state.takeBack() == dm.Answer.taken_back && state.runs.width == 1920 && state.runs.own, "and taken back to the mode before")
    fourModes()

    // The reasons' words.
    logged = 0
    dm.sayWhy(write, dm.Why.NO_DRIVER, 0)
    expect(said("this display is as the firmware left it, and no driver of this system sets its mode"), "no driver")
    logged = 0
    dm.sayWhy(write, dm.Why.OUTPUT, 0)
    expect(said("the display's driver changes the mode of an HDMI or DVI output only"), "another kind of output")
    logged = 0
    dm.sayWhy(write, dm.Why.INTERLACED, 0)
    expect(said("an interlaced picture, which is not built"), "interlaced")
    logged = 0
    dm.sayWhy(write, dm.Why.NO_TIMING, 0)
    expect(said("the monitor names it by size and rate alone, and the standard's table has no timing for it"), "no timing")
}

fn sameText(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

var file: [512]u8 = undefined

// What is remembered for the next boots: the file's text, and what a boot
// does with it.
fn rememberedText() -> void {
    const card: usize = 0x1002
    const model: usize = 0x67DF
    const monitor: usize = 0x4C2D123478563412
    var kept: dm.Kept = undefined
    expect(!dm.remembered("", card, model, monitor, &kept), "an empty file remembers nothing")
    const first = dm.Kept.{ .width = 1920, .height = 1080, .millihertz = 60000 }
    var length = dm.remember("", card, model, monitor, &first, file[0..])
    expect(sameText(file[0..length], "mode 1002:67df 4c2d123478563412 1920x1080@60000\n"), "a mode's line: the adapter, the monitor, the size and the rate")
    expect(dm.remembered(file[0..length], card, model, monitor, &kept) && kept.width == 1920 && kept.height == 1080 && kept.millihertz == 60000, "the line read again")
    expect(!dm.remembered(file[0..length], card, model, monitor + 1, &kept) && !dm.remembered(file[0..length], 0x1234, 0x1111, monitor, &kept), "another monitor on the card, or the monitor on another card: not theirs")
    // Another display's line, a line of words and one that is no mode's
    // stay as they are; this display's is replaced.
    const text = "# set at boot\nmode 1002:67df 4c2d123478563412 1920x1080@60000\nmode 1234:1111 0000000000000000 1280x720@0\nmode nonsense\n"
    const second = dm.Kept.{ .width = 2560, .height = 1080, .millihertz = 59940 }
    length = dm.remember(text, card, model, monitor, &second, file[0..])
    expect(sameText(file[0..length], "# set at boot\nmode 1234:1111 0000000000000000 1280x720@0\nmode nonsense\nmode 1002:67df 4c2d123478563412 2560x1080@59940\n"), "a display's line replaced, the others kept")
    expect(dm.remembered(file[0..length], card, model, monitor, &kept) && kept.width == 2560 && kept.millihertz == 59940, "the new mode read")
    expect(dm.remembered(file[0..length], 0x1234, 0x1111, 0, &kept) && kept.width == 1280 && kept.height == 720 && kept.millihertz == 0, "a size alone, for a monitor without a name")
    length = dm.remember(text, card, model, monitor, null, file[0..])
    expect(sameText(file[0..length], "# set at boot\nmode 1234:1111 0000000000000000 1280x720@0\nmode nonsense\n") && !dm.remembered(file[0..length], card, model, monitor, &kept), "forgotten: the display's line taken out")
    expect(dm.remember(text, card, model, monitor, &second, file[0..16]) > 16, "a text that does not fit is said to be longer than the room")
    // Of two lines for one display the last counts.
    expect(dm.remembered("mode 1002:67df 4c2d123478563412 800x600@60316\nmode 1002:67df 4c2d123478563412 640x480@59940\n", card, model, monitor, &kept) && kept.width == 640, "the last of two lines")
    expect(dm.remembered("mode 1002:67DF 4C2D123478563412 1920x1080@60000\r\n", card, model, monitor, &kept), "capital digits and a return at the line's end")
    // Lines that are no mode's.
    expect(!dm.remembered("mode 1002:67dg 4c2d123478563412 1920x1080@60000\n", card, model, monitor, &kept), "a digit that is none")
    expect(!dm.remembered("mode 1002:67df 4c2d123478563412 1920x1080\n", card, model, monitor, &kept), "no rate")
    expect(!dm.remembered("mode 1002:67df 4c2d123478563412 0x1080@60000\n", card, model, monitor, &kept), "no width")
    expect(!dm.remembered("mode 1002:67df 4c2d123478563412 1920x1080@60000 more\n", card, model, monitor, &kept), "words after the mode")
    expect(!dm.remembered("mode 1002:67df 4c2d12347856341 1920x1080@60000\n", card, model, monitor, &kept), "a monitor's name that is too short")
    expect(!dm.remembered("main 1002:67df\n", card, model, monitor, &kept), "another file's line")
    // What a boot does with a remembered mode: set, unless the boot sets
    // no mode of its own choosing; forgotten when the monitor's own mode
    // was asked for by hand at this start, whatever else.
    expect(dm.atBoot(false, true) == dm.AtBoot.set && dm.atBoot(false, false) == dm.AtBoot.leave, "a boot sets the remembered mode, or leaves it when it sets nothing")
    expect(dm.atBoot(true, true) == dm.AtBoot.forget && dm.atBoot(true, false) == dm.AtBoot.forget, "the monitor's own mode asked for by hand forgets it")
}

// The room a list takes in the value arena (the kernel's is 4 MiB a
// processor, given back only when it next enters a program: the lists of
// every display are made at boot, before any program runs). An EDID that
// names every established timing, every one of the third kind, eight
// standard codes and six more in a descriptor, and twenty video codes:
// its list is made with less than 64 KiB, and a hundred lists one after
// the other (a monitor plugged in again and again) with a hundred times
// that at most.
fn arenaKeptSmall() -> void {
    base(4, 1)
    bytes[35] = 0xFF
    bytes[36] = 0xFF
    bytes[37] = 0x80
    var k: usize = 0
    while k < 8 {
        bytes[38 + k * 2] = @intCast(u8, 0x31 + k * 0x10)
        bytes[39 + k * 2] = 0x40
        k += 1
    }
    bytes[57] = 0xF7
    bytes[59] = 0x0A
    k = 0
    while k < 6 {
        bytes[60 + k] = 0xFF
        k += 1
    }
    bytes[57 + 18] = 0xFA
    k = 0
    while k < 6 {
        bytes[54 + 18 + 5 + k * 2] = @intCast(u8, 0x61 + k * 0x10)
        bytes[54 + 18 + 6 + k * 2] = 0x00
        k += 1
    }
    seal(0)
    bytes[128] = 0x02
    bytes[129] = 0x03
    bytes[130] = 25
    bytes[131] = 0x00
    bytes[132] = 0x54
    k = 0
    while k < 20 {
        bytes[133 + k] = @intCast(u8, 1 + k * 5)
        k += 1
    }
    seal(128)
    const arena = turns.locate()
    expect(arena != 0, "the value arena is found")
    if arena == 0 { return }
    const before = turns.used(arena)
    dm.read(bytes[0..256], &list)
    const one = turns.used(arena) - before
    expect(list.count > 60, "the rich EDID gives its modes")
    expect(one < 65536, "one list is made with less than 64 KiB of the value arena")
    k = 0
    while k < 100 {
        dm.read(bytes[0..256], &list)
        k += 1
    }
    expect(turns.used(arena) - before < 101 * 65536, "a hundred lists take a hundred times that at most")
}

// Two modes of one size: the monitor's own written out at 50 Hz, and 60
// Hz by a standard code (listed first, its rate the higher). Asked for at
// any rate, the size is the monitor's own mode of it (the spec's rule).
fn ownOfItsSize() -> void {
    base(3, 0)
    timing(54, 148500, 1920, 720, 528, 44, 1080, 45, 4, 5, 0x1E)
    bytes[38] = 0xD1
    bytes[39] = 0xC0
    seal(0)
    quiet()
    memory = 16 * 1024 * 1024
    var picture = dm.Picture.{ .address = 0xFD000000, .width = 1024, .height = 768, .pitch = 4096 }
    const plain = driver(dm.Kind.QEMU, false, true)
    state.begin(&plain, bytes[0..128], &picture, 0, null)
    expect(state.list.count == 3 && state.list.modes[0].millihertz == 60000 && !state.list.modes[0].own && state.list.modes[1].millihertz == 50000 && state.list.modes[1].own, "of one size the higher rate first, the monitor's own after it")
    expect(state.ask(1920, 1080, 0, 1) == dm.Answer.changed && lastSet.millihertz == 50000 && lastSet.own, "a size asked for at any rate: the monitor's own mode of it")
}

pub fn main() -> u8 {
    arenaKeptSmall()
    ownOfItsSize()
    theUsersMonitor()
    namedTimings()
    videoCodes()
    noEdid()
    requests()
    sizesAndBoot()
    rememberedText()
    if failed != 0 { return failed }
    return 13
}
