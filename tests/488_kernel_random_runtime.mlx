// The kernel's random number generator (projects/brix/kernel/random.mlx)
// built for the host: its block function against RFC 8439's test vector
// (2.3.2) and, for keys, counters and nonces at chance, against
// std.crypto.chacha's; what counts as a processor's random words (not
// all zeros, all ones or all the same: what a source that is stuck
// gives); the generator fit for secrets only when it is keyed from such
// words, and giving numbers all the same when it is not; the same seed
// the same numbers, another seed, another moment or another request
// others; an answer of any length (none, one byte, a block, a byte more,
// several blocks) whose bytes are those of the answer a byte longer; the
// key made anew at every request and never what an answer held; bytes
// that are not few values over and over.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const std = @import("std")
const chacha = @import("std.crypto.chacha")
const random = @import("../projects/brix/kernel/random.mlx")

fn seedOf(a: usize, b: usize, c: usize, d: usize, fromProcessor: bool, counter: usize, clock: usize) -> random.Seed {
    var seed: random.Seed = undefined
    seed.processor = [4]usize{ a, b, c, d }
    seed.fromProcessor = fromProcessor
    seed.counter = counter
    seed.clock = clock
    return seed
}

fn same(left: []const u8, right: []const u8) -> bool { return std.text.same(left, right) }

// A sequence for the test's own keys (xorshift: only to have many).
var state: usize = 0x2545F4914F6CDD1D // (per run)

fn chance() -> usize {
    state ^= state << 13
    state ^= state >> 7
    state ^= state << 17
    return state
}

var first: [300]u8 = undefined // (per run)
var second: [300]u8 = undefined // (per run)

pub fn main() -> u8 {
    // RFC 8439, 2.3.2: the key 00 01 .. 1f, the nonce 00 00 00 09 00 00
    // 00 4a 00 00 00 00, the block 1.
    var key: [8]usize = undefined
    var k: usize = 0
    while k < 8 {
        key[k] = (k * 4) | ((k * 4 + 1) << 8) | ((k * 4 + 2) << 16) | ((k * 4 + 3) << 24)
        k += 1
    }
    var nonce = [3]usize{ 0x09000000, 0x4a000000, 0 }
    var out: [64]u8 = undefined
    random.block(&key, 1, &nonce, &out)
    const expected = [64]u8{
        0x10, 0xf1, 0xe7, 0xe4, 0xd1, 0x3b, 0x59, 0x15, 0x50, 0x0f, 0xdd, 0x1f, 0xa3, 0x20, 0x71, 0xc4,
        0xc7, 0xd1, 0xf4, 0xc7, 0x33, 0xc0, 0x68, 0x03, 0x04, 0x22, 0xaa, 0x9a, 0xc3, 0xd4, 0x6c, 0x4e,
        0xd2, 0x82, 0x64, 0x46, 0x07, 0x9f, 0xaa, 0x09, 0x14, 0xc2, 0xd7, 0x05, 0xd9, 0x8b, 0x02, 0xa2,
        0xb5, 0x12, 0x9c, 0xd1, 0xde, 0x16, 0x4e, 0xb9, 0xcb, 0xd0, 0x83, 0xe8, 0xa2, 0x50, 0x3c, 0x4e,
    }
    k = 0
    while k < 64 {
        if out[k] != expected[k] { return 1 }
        k += 1
    }
    // Against std.crypto.chacha (the keystream is what a text of zeros
    // becomes), for keys, counters and nonces at chance.
    var zeros: [64]u8 = undefined
    k = 0
    while k < 64 {
        zeros[k] = 0
        k += 1
    }
    var round: usize = 0
    while round < 200 {
        var keyBytes: [32]u8 = undefined
        var nonceBytes: [12]u8 = undefined
        k = 0
        while k < 8 {
            key[k] = chance() & 0xFFFFFFFF
            keyBytes[k * 4] = @intCast(u8, key[k] & 255)
            keyBytes[k * 4 + 1] = @intCast(u8, (key[k] >> 8) & 255)
            keyBytes[k * 4 + 2] = @intCast(u8, (key[k] >> 16) & 255)
            keyBytes[k * 4 + 3] = @intCast(u8, (key[k] >> 24) & 255)
            k += 1
        }
        k = 0
        while k < 3 {
            nonce[k] = chance() & 0xFFFFFFFF
            nonceBytes[k * 4] = @intCast(u8, nonce[k] & 255)
            nonceBytes[k * 4 + 1] = @intCast(u8, (nonce[k] >> 8) & 255)
            nonceBytes[k * 4 + 2] = @intCast(u8, (nonce[k] >> 16) & 255)
            nonceBytes[k * 4 + 3] = @intCast(u8, (nonce[k] >> 24) & 255)
            k += 1
        }
        const counter = chance() & 0xFFFFFFFF
        random.block(&key, counter, &nonce, &out)
        var theirs: [64]u8 = undefined
        chacha.chacha20(&keyBytes, @intCast(u64, counter), &nonceBytes, &zeros, 64, &theirs)
        if !same(out[0..64], theirs[0..64]) { return 2 }
        round += 1
    }
    // (The words' upper halves do not count: a key's word is 32 bits.)
    k = 0
    while k < 8 {
        key[k] = k + 1
        k += 1
    }
    random.block(&key, 7, &nonce, &out)
    var wide: [8]usize = key
    wide[3] |= 0xABCD00000000
    var wideOut: [64]u8 = undefined
    random.block(&wide, 7 | (5 << 32), &nonce, &wideOut)
    if !same(out[0..64], wideOut[0..64]) { return 3 }

    // What a processor's source gives, as far as can be told.
    var words = [4]usize{ 0x1122334455667788, 0x99AABBCCDDEEFF00, 0x0123456789ABCDEF, 0xFEDCBA9876543210 }
    if !random.plausible(&words) { return 4 }
    words[2] = 0
    if random.plausible(&words) { return 5 }
    words[2] = 0xFFFFFFFFFFFFFFFF
    if random.plausible(&words) { return 6 }
    words = [4]usize{ 7, 7, 7, 7 }
    if random.plausible(&words) { return 7 }
    words = [4]usize{ 7, 7, 7, 8 }
    if !random.plausible(&words) { return 8 }

    // Fit for secrets: keyed from the processor's words, and only then.
    var generator: random.Generator = undefined
    var seed = seedOf(0x1122334455667788, 0x99AABBCCDDEEFF00, 0x0123456789ABCDEF, 0xFEDCBA9876543210, true, 123456789, 1794948067)
    generator.init(&seed)
    if !generator.fit { return 9 }
    seed.fromProcessor = false
    generator.init(&seed)
    if generator.fit { return 10 }
    seed = seedOf(0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, 0xFFFFFFFFFFFFFFFF, true, 123456789, 1794948067)
    generator.init(&seed)
    if generator.fit { return 11 }
    seed = seedOf(0, 1, 2, 3, true, 123456789, 1794948067)
    generator.init(&seed)
    if generator.fit { return 12 }

    // The same seed and the same moments: the same numbers. (The check
    // that follows needs it: a generator that gave other numbers each
    // time by itself could not be told from one that works.)
    seed = seedOf(0x1122334455667788, 0x99AABBCCDDEEFF00, 0x0123456789ABCDEF, 0xFEDCBA9876543210, true, 123456789, 1794948067)
    var other: random.Generator = undefined
    generator.init(&seed)
    other.init(&seed)
    generator.fill(&first, 300, 1000)
    other.fill(&second, 300, 1000)
    if !same(first[0..300], second[0..300]) { return 14 }
    // The next request's are others, also at the same moment.
    generator.fill(&second, 300, 1000)
    if same(first[0..300], second[0..300]) || same(first[0..64], second[0..64]) { return 15 }
    // Another moment, another seed (one bit of a processor's word, of
    // the counter, of the clock): others.
    generator.init(&seed)
    generator.fill(&second, 300, 1001)
    if same(first[0..32], second[0..32]) { return 16 }
    var bit: usize = 0
    while bit < 3 {
        var changed = seed
        if bit == 0 { changed.processor[3] ^= 1 }
        if bit == 1 { changed.counter ^= 1 }
        if bit == 2 { changed.clock ^= 1 }
        generator.init(&changed)
        generator.fill(&second, 300, 1000)
        if same(first[0..32], second[0..32]) { return 17 }
        bit += 1
    }
    // Without the processor's words the numbers still differ with the
    // counter and the clock, and are those of the same counter and clock
    // again.
    var poor = seedOf(0, 0, 0, 0, false, 5000, 1794948067)
    generator.init(&poor)
    generator.fill(&first, 64, 9)
    generator.init(&poor)
    generator.fill(&second, 64, 9)
    if !same(first[0..64], second[0..64]) { return 18 }
    poor.counter = 5001
    generator.init(&poor)
    generator.fill(&second, 64, 9)
    if same(first[0..64], second[0..64]) { return 19 }
    poor.counter = 5000
    poor.clock = 1794948068
    generator.init(&poor)
    generator.fill(&second, 64, 9)
    if same(first[0..64], second[0..64]) { return 20 }

    // Any length: the bytes of an answer are the first bytes of the
    // answer a byte longer made from the same state at the same moment
    // (no byte depends on how many are asked for, but the key's own
    // step, which takes the length in: so the same length is asked for
    // in two ways); nothing is written past the length.
    const lengths = [7]usize{ 0, 1, 63, 64, 65, 128, 300 }
    var l: usize = 0
    while l < 7 {
        const length = lengths[l]
        k = 0
        while k < 300 {
            first[k] = 0xA5
            second[k] = 0xA5
            k += 1
        }
        generator.init(&seed)
        other.init(&seed)
        generator.fill(&first, length, 77)
        other.fill(&second, length, 77)
        if !same(first[0..300], second[0..300]) { return 21 }
        k = length
        while k < 300 {
            if first[k] != 0xA5 { return 22 }
            k += 1
        }
        l += 1
    }

    // The key is made anew at every request, and the key that is kept
    // is none an answer was made with: an answer's bytes do not hold it.
    generator.init(&seed)
    var before: [8]usize = generator.key
    generator.fill(&first, 300, 55)
    var changedWords: usize = 0
    k = 0
    while k < 8 {
        if generator.key[k] != before[k] { changedWords += 1 }
        k += 1
    }
    if changedWords < 6 || generator.requests != 2 { return 23 }
    var keyBytes: [32]u8 = undefined
    k = 0
    while k < 8 {
        keyBytes[k * 4] = @intCast(u8, generator.key[k] & 255)
        keyBytes[k * 4 + 1] = @intCast(u8, (generator.key[k] >> 8) & 255)
        keyBytes[k * 4 + 2] = @intCast(u8, (generator.key[k] >> 16) & 255)
        keyBytes[k * 4 + 3] = @intCast(u8, (generator.key[k] >> 24) & 255)
        k += 1
    }
    if std.text.contains(first[0..300], keyBytes[0..8]) || std.text.contains(first[0..300], keyBytes[16..24]) { return 24 }

    // Words: all different in a thousand, and every byte value among
    // sixteen thousand bytes, none of them far more often than its share.
    generator.init(&seed)
    var seen: [1000]usize = undefined
    k = 0
    while k < 1000 {
        seen[k] = generator.next(k)
        var j: usize = 0
        while j < k {
            if seen[j] == seen[k] { return 25 }
            j += 1
        }
        k += 1
    }
    var counts: [256]usize = undefined
    k = 0
    while k < 256 {
        counts[k] = 0
        k += 1
    }
    round = 0
    while round < 64 {
        generator.fill(&first, 256, round)
        k = 0
        while k < 256 {
            counts[@intCast(usize, first[k])] += 1
            k += 1
        }
        round += 1
    }
    k = 0
    while k < 256 {
        // (64 is each value's share; a value that never comes, or comes
        // 150 times, is no chance.)
        if counts[k] == 0 || counts[k] > 150 { return 26 }
        k += 1
    }
    return 13
}
