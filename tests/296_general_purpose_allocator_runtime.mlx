// The general-purpose allocator (std/bootstrap/general_purpose_allocator.mlx)
// behind the Allocator interface: blocks of every size class and large
// ones, their alignment, frees that come back on the next allocation,
// resizes in place and by copy, the accounting, deinit, and four threads
// allocating and freeing through one heap at once. Exits 13 on success.
const bootstrap = @import("../std/bootstrap/root.mlx")

extern("c") fn pthread_create(thread: *u64, attributes: usize, start: usize, argument: usize) -> i32
extern("c") fn pthread_join(thread: u64, result: usize) -> i32

const gpa = bootstrap.general_purpose_allocator

fn fill(block: [*]u8, length: usize, value: u8) -> void {
    var index: usize = 0
    while index < length {
        block[index] = value
        index += 1
    }
}

fn filled(block: [*]u8, length: usize, value: u8) -> bool {
    var index: usize = 0
    while index < length {
        if block[index] != value { return false }
        index += 1
    }
    return true
}

// Each thread: 2000 rounds of allocating eight blocks of growing sizes,
// writing them, checking them and freeing them.
export fn worker(argument: usize) -> usize {
    var heap: *gpa.Heap = undefined
    unsafe { heap = @ptrFromInt(*gpa.Heap, argument) }
    const allocator = gpa.interface(heap)
    var round: usize = 0
    while round < 2000 {
        var blocks: [8]usize = [8]usize{ 0, 0, 0, 0, 0, 0, 0, 0 }
        var index: usize = 0
        while index < 8 {
            const length = 24 + index * 300
            const block = allocator.alloc(length, 8)
            if block == null { return 1 }
            fill(block.?, length, @intCast(u8, round + index))
            blocks[index] = @intFromPtr(block.?)
            index += 1
        }
        index = 0
        while index < 8 {
            const length = 24 + index * 300
            var block: [*]u8 = undefined
            unsafe { block = @ptrFromInt([*]u8, blocks[index]) }
            if !filled(block, length, @intCast(u8, round + index)) { return 2 }
            allocator.free(block, length, 8)
            index += 1
        }
        round += 1
    }
    return 0
}

pub fn main() -> u8 {
    var heap = gpa.init(bootstrap.page_allocator.init())
    const allocator = gpa.interface(&heap)

    // Three blocks of one class: distinct, 16-aligned, each holding its own
    // bytes; the middle one freed comes back first.
    const first = allocator.alloc(24, 8).?
    const second = allocator.alloc(24, 8).?
    const third = allocator.alloc(24, 8).?
    if @intFromPtr(first) == @intFromPtr(second) || @intFromPtr(second) == @intFromPtr(third) { return 1 }
    if @intFromPtr(first) % 16 != 0 || @intFromPtr(second) % 16 != 0 { return 2 }
    if @intFromPtr(second) - @intFromPtr(first) != gpa.blockSize(24, 8) { return 3 }
    fill(first, 24, 1)
    fill(second, 24, 2)
    fill(third, 24, 3)
    if !filled(first, 24, 1) || !filled(second, 24, 2) || !filled(third, 24, 3) { return 4 }
    allocator.free(second, 24, 8)
    const again = allocator.alloc(20, 8).?
    if @intFromPtr(again) != @intFromPtr(second) { return 5 }
    if gpa.liveBytes(&heap) != 68 { return 6 }

    // Alignment: 64, 512 and a page; the blocks hold their bytes.
    const aligned64 = allocator.alloc(40, 64).?
    const aligned512 = allocator.alloc(100, 512).?
    const page = allocator.alloc(100, 4096).?
    if @intFromPtr(aligned64) % 64 != 0 || @intFromPtr(aligned512) % 512 != 0 || @intFromPtr(page) % 4096 != 0 { return 7 }
    fill(page, 100, 9)
    if !filled(page, 100, 9) { return 8 }
    allocator.free(aligned64, 40, 64)
    allocator.free(aligned512, 100, 512)
    allocator.free(page, 100, 4096)

    // A large block (a mapping of its own) and one aligned beyond a page.
    const large = allocator.alloc(1048576, 16).?
    large[0] = 5
    large[1048575] = 6
    if large[0] != 5 || large[1048575] != 6 || gpa.largeCount(&heap) != 1 { return 9 }
    const huge_alignment = allocator.alloc(3000, 65536).?
    if @intFromPtr(huge_alignment) % 65536 != 0 { return 10 }
    fill(huge_alignment, 3000, 4)
    if !filled(huge_alignment, 3000, 4) || gpa.largeCount(&heap) != 2 { return 11 }
    allocator.free(huge_alignment, 3000, 65536)
    allocator.free(large, 1048576, 16)
    if gpa.largeCount(&heap) != 0 { return 12 }

    // Resizing: within the class in place, beyond it a copy that keeps the
    // bytes; the live count follows.
    fill(first, 24, 7)
    const same = allocator.resize(first, 24, 30, 8)
    if same == null || @intFromPtr(same.?) != @intFromPtr(first) || !filled(first, 24, 7) { return 13 }
    const moved = allocator.resize(first, 30, 5000, 8)
    if moved == null || @intFromPtr(moved.?) == @intFromPtr(first) || !filled(moved.?, 24, 7) { return 14 }
    if gpa.liveBytes(&heap) != 20 + 24 + 5000 { return 15 }
    allocator.free(moved.?, 5000, 8)
    allocator.free(again, 20, 8)
    allocator.free(third, 24, 8)
    if gpa.liveBytes(&heap) != 0 { return 16 }

    // Every class, in and out.
    var length: usize = 1
    while length <= 32768 {
        const block = allocator.alloc(length, 1).?
        block[0] = 1
        block[length - 1] = 2
        allocator.free(block, length, 1)
        length = length * 2 + 3
    }

    // Four threads on the one heap.
    var threads: [4]u64 = [4]u64{ 0, 0, 0, 0 }
    var index: usize = 0
    while index < 4 {
        var slot: *u64 = undefined
        unsafe { slot = @ptrFromInt(*u64, @intFromPtr(&threads) + index * 8) }
        if pthread_create(slot, 0, @intFromPtr(worker), @intFromPtr(&heap)) != 0 { return 17 }
        index += 1
    }
    index = 0
    while index < 4 {
        const joined = pthread_join(threads[index], 0)
        index += 1
    }
    if gpa.liveBytes(&heap) != 0 { return 18 }
    if gpa.slabCount(&heap) == 0 { return 19 }

    gpa.deinit(&heap)
    if gpa.slabCount(&heap) != 0 { return 20 }
    const after = allocator.alloc(24, 8).?
    after[0] = 1
    allocator.free(after, 24, 8)
    gpa.deinit(&heap)
    return 13
}
