// A firmware that is a table, for the EFI loader's choice part
// (projects/brix/image/efi.mlx's `choiceCode` and `choiceData`: the very
// text brix-image puts at the application's entry), so that the part is
// run on the host: assembled here by the same assembler, put into memory
// that may be run, and entered as a firmware enters an application (the
// image's handle in rcx, the system table in rdx, by Microsoft's
// convention), with a `ret` after it where efiMain follows in an image.
//
// The system table and the services' tables are words of this file; the
// services themselves are a few lines of assembly beside the part, each
// reading its answer from a word the test sets and writing down what it
// was called with:
// - ReadKeyStroke gives the keys of a list one after the other (each a
//   status and a character: a key, "no key yet" or an error) and `idle`
//   when the list is used up;
// - Stall counts its calls and the microseconds;
// - GetVariable answers as a variable store does: the status the test
//   sets (not found, an error), else the variable's bytes when the room
//   holds them, else "too small" with the size;
// - SetVariable writes down its arguments and the byte, and answers what
//   the test sets;
// - OutputString writes down the text's place.
// Every service counts a call whose stack is not aligned as the
// convention has it, and leaves every register a callee may change full
// of ones. The bridge by which the part is entered writes down the
// registers the part must leave as it found them.
const std = @import("std")
const efi = @import("../../projects/brix/image/efi.mlx")
const assemble = @import("../../projects/brix/image/assemble.mlx")
const layout = @import("../../projects/brix/layout.mlx")
const choice = @import("../../projects/brix/display_choice.mlx")

// The firmware's answers the loader tells apart.
pub const NOT_READY: usize = 0x8000000000000006
pub const NOT_FOUND: usize = 0x800000000000000E
pub const TOO_SMALL: usize = 0x8000000000000005
pub const DEVICE_ERROR: usize = 0x8000000000000007
pub const WRITE_PROTECTED: usize = 0x8000000000000008
pub const OUT_OF_RESOURCES: usize = 0x8000000000000009

// What the bridge enters the part with.
pub const HANDLE: usize = 0x1234
pub const RBX: usize = 0xB0B0
pub const RSI: usize = 0x5151

// How many keys a list holds.
pub const KEYS: usize = 400

// The bridge: entered as Mlx calls a function (the system table in rdi).
const BRIDGE = [_][]const u8{
    "bridge:",
    "pushq %rbx",
    "pushq %rbp",
    "pushq %r12",
    "pushq %r13",
    "pushq %r14",
    "pushq %r15",
    "subq $8, %rsp", // (aligned: the part is entered as an application is)
    "movq %rdi, %rdx",
    "movq $0x1234, %rcx",
    "movq $0xB0B0, %rbx",
    "movq $0x5151, %rsi",
    "call choice_entry",
    "movq %rcx, after_rcx(%rip)",
    "movq %rdx, after_rdx(%rip)",
    "movq %rbx, after_rbx(%rip)",
    "movq %rsi, after_rsi(%rip)",
    "addq $8, %rsp",
    "popq %r15",
    "popq %r14",
    "popq %r13",
    "popq %r12",
    "popq %rbp",
    "popq %rbx",
    "ret",
    "choice_entry:"
    // (The part follows, and a `ret`.)
}

// The services (Microsoft's convention: rcx, rdx, r8, r9, then the
// stack; a fifth argument is at 0x28(%rsp) on entry).
const SERVICES = [_][]const u8{
    "ret",
    // ReadKeyStroke(this, key)
    "fake_read:",
    "movq %rsp, %rax",
    "andq $15, %rax",
    "cmpq $8, %rax",
    "je fake_read_straight",
    "addq $1, fake_crooked(%rip)",
    "fake_read_straight:",
    "addq $1, fake_reads(%rip)",
    "movq %rcx, fake_read_this(%rip)",
    "movq fake_key_at(%rip), %rax",
    "cmpq fake_key_count(%rip), %rax",
    "jae fake_read_idle",
    "addq $1, fake_key_at(%rip)",
    "shlq $4, %rax",
    "leaq fake_keys(%rip), %r8",
    "addq %rax, %r8",
    "movq (%r8), %rax", // its status
    "testq %rax, %rax",
    "jnz fake_done",
    "movq 8(%r8), %rax", // its character
    "movw $0, (%rdx)",
    "movw %ax, 2(%rdx)",
    "xorq %rax, %rax",
    "jmp fake_done",
    "fake_read_idle:",
    "movq fake_idle(%rip), %rax",
    "jmp fake_done",
    // Stall(microseconds)
    "fake_stall:",
    "movq %rsp, %rax",
    "andq $15, %rax",
    "cmpq $8, %rax",
    "je fake_stall_straight",
    "addq $1, fake_crooked(%rip)",
    "fake_stall_straight:",
    "addq $1, fake_stalls(%rip)",
    "addq %rcx, fake_stalled(%rip)",
    "xorq %rax, %rax",
    "jmp fake_done",
    // GetVariable(name, guid, attributes, &size, data)
    "fake_get:",
    "movq %rsp, %rax",
    "andq $15, %rax",
    "cmpq $8, %rax",
    "je fake_get_straight",
    "addq $1, fake_crooked(%rip)",
    "fake_get_straight:",
    "addq $1, fake_gets(%rip)",
    "movq %rcx, fake_get_name(%rip)",
    "movq %rdx, fake_get_guid(%rip)",
    "movq %r8, fake_get_attributes(%rip)",
    "movq (%r9), %rax",
    "movq %rax, fake_get_room(%rip)",
    "movq fake_var_status(%rip), %rax",
    "testq %rax, %rax",
    "jnz fake_done",
    "movq fake_var_size(%rip), %r10",
    "cmpq %rax, %r10", // (no bytes: there is no such variable)
    "je fake_get_none",
    "cmpq fake_get_room(%rip), %r10",
    "jbe fake_get_fits",
    "movq %r10, (%r9)",
    "movabs $0x8000000000000005, %rax",
    "jmp fake_done",
    "fake_get_none:",
    "movabs $0x800000000000000E, %rax",
    "jmp fake_done",
    "fake_get_fits:",
    "movq %r10, (%r9)",
    "movq 0x28(%rsp), %r8",
    "leaq fake_var_data(%rip), %r11",
    "fake_get_byte:",
    "testq %r10, %r10",
    "jz fake_done",
    "movb (%r11), %cl",
    "movb %cl, (%r8)",
    "addq $1, %r8",
    "addq $1, %r11",
    "subq $1, %r10",
    "jmp fake_get_byte",
    // SetVariable(name, guid, attributes, size, data)
    "fake_set:",
    "movq %rsp, %rax",
    "andq $15, %rax",
    "cmpq $8, %rax",
    "je fake_set_straight",
    "addq $1, fake_crooked(%rip)",
    "fake_set_straight:",
    "addq $1, fake_sets(%rip)",
    "movq %rcx, fake_set_name(%rip)",
    "movq %rdx, fake_set_guid(%rip)",
    "movq %r8, fake_set_attributes(%rip)",
    "movq %r9, fake_set_size(%rip)",
    "movq 0x28(%rsp), %r10",
    "movzbl (%r10), %eax",
    "movq %rax, fake_set_byte(%rip)",
    "movq fake_set_status(%rip), %rax",
    "jmp fake_done",
    // OutputString(this, text)
    "fake_output:",
    "movq %rsp, %rax",
    "andq $15, %rax",
    "cmpq $8, %rax",
    "je fake_output_straight",
    "addq $1, fake_crooked(%rip)",
    "fake_output_straight:",
    "addq $1, fake_says(%rip)",
    "movq %rcx, fake_say_this(%rip)",
    "movq %rdx, fake_said(%rip)",
    "xorq %rax, %rax",
    // What a service may change, changed (rax is its answer).
    "fake_done:",
    "movq $-1, %rcx",
    "movq $-1, %rdx",
    "movq $-1, %r8",
    "movq $-1, %r9",
    "movq $-1, %r10",
    "movq $-1, %r11",
    "ret"
}

// The words the services read and write (each a quad, in this order
// from `fake_words`), the keys' list, and the payload's first page.
const WORDS = [_][]const u8{
    ".balign 8, 0",
    "after_rcx: .quad 0",
    "after_rdx: .quad 0",
    "after_rbx: .quad 0",
    "after_rsi: .quad 0",
    "fake_crooked: .quad 0",
    "fake_reads: .quad 0",
    "fake_read_this: .quad 0",
    "fake_key_at: .quad 0",
    "fake_key_count: .quad 0",
    "fake_idle: .quad 0",
    "fake_stalls: .quad 0",
    "fake_stalled: .quad 0",
    "fake_gets: .quad 0",
    "fake_get_name: .quad 0",
    "fake_get_guid: .quad 0",
    "fake_get_attributes: .quad 0",
    "fake_get_room: .quad 0",
    "fake_var_status: .quad 0",
    "fake_var_size: .quad 0",
    "fake_var_data: .quad 0",
    "fake_sets: .quad 0",
    "fake_set_name: .quad 0",
    "fake_set_guid: .quad 0",
    "fake_set_attributes: .quad 0",
    "fake_set_size: .quad 0",
    "fake_set_byte: .quad 0",
    "fake_set_status: .quad 0",
    "fake_says: .quad 0",
    "fake_say_this: .quad 0",
    "fake_said: .quad 0",
    "fake_keys:",
    ".skip 6400", // (KEYS of 16 bytes)
    "payload:",
    ".skip 0x300"
}

// Where the code is, and its labels' places.
var memory: usize = 0
var bridge: usize = 0
var payload: usize = 0
var keys: usize = 0
var choiceWords: usize = 0
var choiceWordsEnd: usize = 0
var afterRcx: usize = 0
var afterRdx: usize = 0
var afterRbx: usize = 0
var afterRsi: usize = 0
var crookedAt: usize = 0
var readsAt: usize = 0
var readThisAt: usize = 0
var keyAt: usize = 0
var keyCount: usize = 0
var idleAt: usize = 0
var stallsAt: usize = 0
var stalledAt: usize = 0
var getsAt: usize = 0
var getNameAt: usize = 0
var getGuidAt: usize = 0
var getAttributesAt: usize = 0
var getRoomAt: usize = 0
var varStatusAt: usize = 0
var varSizeAt: usize = 0
var varDataAt: usize = 0
var setsAt: usize = 0
var setNameAt: usize = 0
var setGuidAt: usize = 0
var setAttributesAt: usize = 0
var setSizeAt: usize = 0
var setByteAt: usize = 0
var setStatusAt: usize = 0
var saysAt: usize = 0
var sayThisAt: usize = 0
var saidAt: usize = 0
var readService: usize = 0
var stallService: usize = 0
var getService: usize = 0
var setService: usize = 0
var outputService: usize = 0

// Why `make` failed.
var problemText: []const u8 = undefined

pub fn problem() -> []const u8 { return problemText }

fn word(address: usize) -> usize { return unsafe { @ptrFromInt(*usize, address) }.* }

fn put(address: usize, value: usize) -> void {
    const at = unsafe { @ptrFromInt(*usize, address) }
    at.* = value
}

fn place(name: []const u8) -> usize {
    const offset = assemble.offsetOf(name)
    if offset == null {
        problemText = name
        return 0
    }
    return memory + offset.?
}

// The part and the services assembled and put where they can be run;
// false (and `problem`) when that cannot be done here.
pub fn make() -> bool {
    const room: usize = 65536
    if !assemble.init() {
        problemText = "no memory for the assembler"
        return false
    }
    var t: assemble.Text = undefined
    if !t.init() {
        problemText = "no memory for the text"
        return false
    }
    t.lines(BRIDGE[0..BRIDGE.length])
    efi.choiceCode(&t)
    t.lines(SERVICES[0..SERVICES.length])
    efi.choiceData(&t)
    t.lines(WORDS[0..WORDS.length])
    memory = std.linux.mapAnonymous(room)
    if memory == 0 {
        problemText = "no memory for the code"
        return false
    }
    const none = [_]assemble.External{}
    if !assemble.place(unsafe { @ptrFromInt([*]u8, memory) }, 0, room, t.text(), 0, none[0..none.length]) {
        problemText = assemble.problem()
        return false
    }
    problemText = ""
    bridge = place("bridge")
    payload = place("payload")
    keys = place("fake_keys")
    choiceWords = place("choice_table")
    choiceWordsEnd = place("choice_guid")
    afterRcx = place("after_rcx")
    afterRdx = place("after_rdx")
    afterRbx = place("after_rbx")
    afterRsi = place("after_rsi")
    crookedAt = place("fake_crooked")
    readsAt = place("fake_reads")
    readThisAt = place("fake_read_this")
    keyAt = place("fake_key_at")
    keyCount = place("fake_key_count")
    idleAt = place("fake_idle")
    stallsAt = place("fake_stalls")
    stalledAt = place("fake_stalled")
    getsAt = place("fake_gets")
    getNameAt = place("fake_get_name")
    getGuidAt = place("fake_get_guid")
    getAttributesAt = place("fake_get_attributes")
    getRoomAt = place("fake_get_room")
    varStatusAt = place("fake_var_status")
    varSizeAt = place("fake_var_size")
    varDataAt = place("fake_var_data")
    setsAt = place("fake_sets")
    setNameAt = place("fake_set_name")
    setGuidAt = place("fake_set_guid")
    setAttributesAt = place("fake_set_attributes")
    setSizeAt = place("fake_set_size")
    setByteAt = place("fake_set_byte")
    setStatusAt = place("fake_set_status")
    saysAt = place("fake_says")
    sayThisAt = place("fake_say_this")
    saidAt = place("fake_said")
    readService = place("fake_read")
    stallService = place("fake_stall")
    getService = place("fake_get")
    setService = place("fake_set")
    outputService = place("fake_output")
    if problemText.length != 0 { return false }
    if std.linux.syscall3(std.linux.SYS_mprotect, memory, room, std.linux.PROT_READ | std.linux.PROT_WRITE | std.linux.PROT_EXEC) != 0 {
        problemText = "the code's memory may not be run here"
        return false
    }
    return true
}

// What of the firmware is there (all of it, on a firmware as it should
// be): the system table itself, its console input and that one's
// ReadKeyStroke, the boot services and their Stall, the run-time
// services and their GetVariable and SetVariable, the console output and
// its OutputString.
pub const Has = struct {
    table: bool
    input: bool
    read: bool
    boot: bool
    stall: bool
    runtime: bool
    get: bool
    set: bool
    output: bool
    say: bool

    pub fn all() -> Has { return Has.{ .table = true, .input = true, .read = true, .boot = true, .stall = true, .runtime = true, .get = true, .set = true, .output = true, .say = true } }
}

// A key of the list: a character the keyboard gives.
pub const Key = struct {
    status: usize
    character: usize

    pub fn of(character: usize) -> Key { return Key.{ .status = 0, .character = character } }
    // No key at that look.
    pub fn notYet() -> Key { return Key.{ .status = NOT_READY, .character = 0 } }
    // The keyboard's error at that look.
    pub fn failing(status: usize) -> Key { return Key.{ .status = status, .character = 0 } }
}

// The firmware's tables (the words the loader reads: the system table's
// ConIn at 48, ConOut at 64, run-time services at 88, boot services at
// 96; ReadKeyStroke and OutputString at 8 of theirs; GetVariable at 72
// and SetVariable at 88; Stall at 248).
var systemTable: [16]usize = undefined
var input: [4]usize = undefined
var output: [4]usize = undefined
var runtime: [16]usize = undefined
var boot: [40]usize = undefined

// What a start left.
pub const Left = struct {
    // The word in the payload's boot information.
    word: usize
    // How often each service was called, and with what.
    reads: usize
    stalls: usize
    stalled: usize
    gets: usize
    getRoom: usize
    getAttributes: usize
    sets: usize
    setAttributes: usize
    setSize: usize
    setByte: usize
    says: usize
    // Calls whose stack was not aligned.
    crooked: usize
    // Whether the variable was named as it should be (its name as 16-bit
    // characters and its GUID, at each call), and the console and the
    // keyboard called with their own tables.
    named: bool
    owned: bool
    // The registers after the part.
    rcx: usize
    rdx: usize
    rbx: usize
    rsi: usize
    // Where the system table is (what rdx has to be afterwards; 0: the
    // start had none).
    table: usize
}

// Whether `at` holds the variable's name, 16 bits a character and a 0.
fn isName(at: usize) -> bool {
    if at == 0 { return false }
    const characters = unsafe { @ptrFromInt([*]const u16, at) }
    var k: usize = 0
    while k < choice.NAME.length {
        if @intCast(usize, characters[k]) != @intCast(usize, choice.NAME[k]) { return false }
        k += 1
    }
    return characters[choice.NAME.length] == 0
}

fn isGuid(at: usize) -> bool {
    if at == 0 { return false }
    const bytes = unsafe { @ptrFromInt([*]const u8, at) }
    var k: usize = 0
    while k < choice.GUID.length {
        if bytes[k] != choice.GUID[k] { return false }
        k += 1
    }
    return true
}

// The text the console was told last, as bytes into `into` (16-bit
// characters, each of which has to be plain); how many, 0 when nothing
// was said or it is not plain.
pub fn said(into: []u8) -> usize {
    const at = word(saidAt)
    if at == 0 { return 0 }
    const characters = unsafe { @ptrFromInt([*]const u16, at) }
    var k: usize = 0
    while characters[k] != 0 {
        if k == into.length || characters[k] > 126 { return 0 }
        into[k] = @intCast(u8, characters[k])
        k += 1
    }
    return k
}

// One start: the keys the keyboard gives one after the other and what
// it answers when they are used up (`idle`); the variable (`status`:
// the store's answer when it is not 0; else `size` bytes, 0 for none,
// the first eight of them `data`); what a write is answered (`refusal`,
// 0: taken); what of the firmware is there.
pub fn start(list: []const Key, idle: usize, status: usize, size: usize, data: usize, refusal: usize, has: *const Has) -> Left {
    // The part's own words as an image has them (zero), and the
    // services' words; the payload's boot information empty.
    var at = choiceWords
    while at < choiceWordsEnd {
        put(at, 0)
        at += 8
    }
    at = afterRcx
    while at < keys {
        put(at, 0)
        at += 8
    }
    put(payload + layout.Blob.BOOT_INFO + layout.Info.CHOICE, 0)
    var k: usize = 0
    while k < list.length && k < KEYS {
        put(keys + 16 * k, list[k].status)
        put(keys + 16 * k + 8, list[k].character)
        k += 1
    }
    put(keyCount, k)
    put(idleAt, idle)
    put(varStatusAt, status)
    put(varSizeAt, size)
    put(varDataAt, data)
    put(setStatusAt, refusal)
    k = 0
    while k < 16 {
        systemTable[k] = 0
        runtime[k] = 0
        k += 1
    }
    k = 0
    while k < 40 {
        boot[k] = 0
        k += 1
    }
    k = 0
    while k < 4 {
        input[k] = 0
        output[k] = 0
        k += 1
    }
    if has.*.read { input[1] = readService }
    if has.*.say { output[1] = outputService }
    if has.*.get { runtime[9] = getService }
    if has.*.set { runtime[11] = setService }
    if has.*.stall { boot[31] = stallService }
    if has.*.input { systemTable[6] = @intFromPtr(&input) }
    if has.*.output { systemTable[8] = @intFromPtr(&output) }
    if has.*.runtime { systemTable[11] = @intFromPtr(&runtime) }
    if has.*.boot { systemTable[12] = @intFromPtr(&boot) }
    const table: usize = if has.*.table { @intFromPtr(&systemTable) } else { 0 }
    const enter = unsafe { @ptrFromInt(fn(usize) -> usize, bridge) }
    _ = enter(table)
    var named = true
    if word(getsAt) != 0 && (!isName(word(getNameAt)) || !isGuid(word(getGuidAt))) { named = false }
    if word(setsAt) != 0 && (!isName(word(setNameAt)) || !isGuid(word(setGuidAt))) { named = false }
    var owned = true
    if word(readsAt) != 0 && word(readThisAt) != @intFromPtr(&input) { owned = false }
    if word(saysAt) != 0 && word(sayThisAt) != @intFromPtr(&output) { owned = false }
    return Left.{ .word = word(payload + layout.Blob.BOOT_INFO + layout.Info.CHOICE), .reads = word(readsAt), .stalls = word(stallsAt), .stalled = word(stalledAt), .gets = word(getsAt), .getRoom = word(getRoomAt), .getAttributes = word(getAttributesAt), .sets = word(setsAt), .setAttributes = word(setAttributesAt), .setSize = word(setSizeAt), .setByte = word(setByteAt), .says = word(saysAt), .crooked = word(crookedAt), .named = named, .owned = owned, .rcx = word(afterRcx), .rdx = word(afterRdx), .rbx = word(afterRbx), .rsi = word(afterRsi), .table = table }
}

// The word the loader hands over for how far the card's engines go
// (layout.Info.STAGE, engine_choice.mlx's), after `start`: for
// tests/493_gpu_engines_found_runtime.mlx.
pub fn stageWord() -> usize { return word(payload + layout.Blob.BOOT_INFO + layout.Info.STAGE) }
