// A Radeon RX 580 (Polaris 10) as a table, for the tests of the kernel's
// first stages toward a card that takes commands (tests/493_gpu_engines_
// found_runtime.mlx and 494_gpu_engines_memory_runtime.mlx): the
// registers by number, the SMC's words behind its index and data pair,
// the queues behind the selector, the aperture's 256 MiB and the card's
// memory beyond it behind the index window, the system's memory set
// aside for the card, a clock that is the test's (it goes on by what the
// driver pauses and by a microsecond each time it is read), every write
// in order, the log.
//
// It answers as the machine's logs show the user's card (/tmp/brix-next/
// machine, 17 Nov: 8192 MiB at 0xf400000000, the aperture of 256 MiB,
// GRBM_STATUS 0x3028, controller 0 showing the monitor's own mode of
// 3840x1080 at 0x500000 of the aperture, 59.98 frames a second) and, for
// what no log has shown yet, as the study (gpu-accel-kernel.verified.md
// 1.1, 2, 3.3) expects a card the firmware started to answer: the SMC
// running its ROM (clock on, program counter below 0x20100, protected
// mode, the hard key), the engines halted, no ring, the GART off, the
// host path's surface words 0, the system aperture VRAM's bounds. What
// the card does when the driver writes is as Linux's code counts on:
// the interrupt ring writes its entries and its write pointer where it
// was told, an entry raises the interrupt when the ring re-arms on the
// read pointer and the interrupt is routed (and, while the kernel starts
// with the processor's interrupts off, the message waits at the
// processor, not taken: `interruptsOn`); a flush request is answered;
// a queue lets go when asked to dequeue.
//
// What the card can be made to do wrong is a variable each, below.
const std = @import("std")
const engines = @import("../../projects/brix/kernel/gpu_engines.mlx")
const scanout = @import("../../projects/brix/kernel/gpu_display.mlx")
const atom = @import("../../projects/brix/kernel/atom.mlx")
const rom = @import("./atom_rom.mlx")

pub const ROOM: usize = 0x10000
pub const NEVER: usize = 0xFFFFFFFFFFFFFFFF

pub var registers: [ROOM]usize = undefined

// The clock in nanoseconds, how far it goes each time it is read, the
// driver's pauses.
pub var clock: usize = 0
pub var stride: usize = 1000
pub var pauses: usize = 0

// Every register write, in order.
pub const WRITES: usize = 16384
pub var writtenTo: [WRITES]usize = undefined
pub var writtenWith: [WRITES]usize = undefined
pub var written: usize = 0

// The SMC's words (address, value), a few dozen.
pub const SMC_ROOM: usize = 64
pub var smcAddress: [SMC_ROOM]usize = undefined
pub var smcValue: [SMC_ROOM]usize = undefined
pub var smcCount: usize = 0
// Its program counter goes on by this each time it is read (in its ROM).
pub var counterStep: usize = 0x14

// The memory controller's IO debug space: the word at 0x9f.
pub var listVersion: usize = 0x03B4DC40

// The queues' words, by the selector's micro engine, pipe and queue
// (the KIQ's and compute ring 0's are the ones read).
pub const QUEUES: usize = 128
pub var queueActive: [QUEUES]usize = undefined
pub var queueDequeue: [QUEUES]usize = undefined
pub var queueRead: [QUEUES]usize = undefined
pub var queueWrite: [QUEUES]usize = undefined
// A queue that does not let go when asked.
pub var queueHolds = false

// The aperture (256 MiB, made at the first reset), the card's memory
// beyond it (a few words), the system's memory set aside for the card.
pub const VIEW: usize = 256 * 1024 * 1024
pub var vram: usize = 0
pub const BEYOND: usize = 16
pub var beyondAt: [BEYOND]usize = undefined
pub var beyondValue: [BEYOND]usize = undefined
pub var beyondCount: usize = 0
pub const DMA_BASE: usize = 0x0000000123400000
pub const DMA_BYTES: usize = 2048 * 4096
pub var dmaMemory: usize = 0
pub var dmaUsed: usize = 0
pub var dmaPages: usize = 2048
pub var dmaBase: usize = DMA_BASE

// The PCI command word, whether the card can raise a message-signalled
// interrupt, whether it was routed, how many came and were taken.
pub var command: usize = 0x0406
pub var routable = true
pub var routed = false
pub var messages: usize = 0
// The processor's interrupts: off while the kernel starts (as on the
// machine: the kernel turns them on for the first program), when a
// message that comes waits at the processor, not taken.
pub var interruptsOn = false
pub var waitingMessage = false

// The log, and whether it is kept off the screen now; how many times it
// was put aside.
pub const LOG: usize = 262144
pub var log: [LOG]u8 = undefined
pub var logged: usize = 0
pub var aside = false
pub var asides: usize = 0

// The firmware files (the repository's own, loaded by the test).
pub const FILES: usize = 9
pub var fileName: [FILES][]const u8 = undefined
pub var fileBytes: [FILES][]const u8 = undefined
pub var fileCount: usize = 0
// A file that is not there, or one cut short (NEVER: none).
pub var fileMissing: usize = NEVER
pub var fileShort: usize = NEVER

// The picture: controller 0's surface (an offset in the aperture),
// pitch, height and totals; its frames a second (thousandths).
pub var pictureOffset: usize = 0x500000
pub var pictureWidth: usize = 3840
pub var pictureHeight: usize = 1080
pub var millihertz: usize = 59980

// What the card can be made to do wrong.
// A register that does not take what is written (NEVER: none).
pub var stuck: usize = NEVER
// A word of the aperture that does not hold what is written (an offset;
// NEVER: none).
pub var badWord: usize = NEVER
// A word of the card's memory the index window sees otherwise than the
// aperture (an offset; NEVER: none): an entry the card does not see.
pub var unseen: usize = NEVER
// The word beyond the aperture does not hold.
pub var beyondBad = false
// When this register is written (NEVER: never): the frames stop, the
// memory interface runs dry, a pixel of the picture changes, a fault is
// recorded in address space 0.
pub var stopFramesAt: usize = NEVER
pub var dryAt: usize = NEVER
pub var scribbleAt: usize = NEVER
pub var faultAt: usize = NEVER
pub var framesStopped = false
// The address space the fault is recorded in (0 or 1).
pub var faultSpace: usize = 0
// When this register is written the frames come at `slowTo` thousandths
// of a hertz from then on (NEVER: never).
pub var slowAt: usize = NEVER
pub var slowTo: usize = 0
// The interrupt ring overflows at the next entries it gets: its write
// pointer carries RB_OVERFLOW, in the register and written back, until
// the driver clears it (IH_RB_CNTL's WPTR_OVERFLOW_CLEAR).
pub var overflow = false
var overflowing = false
// The memory controller busy with something besides the display's
// reading (MCC_BUSY in SRBM_STATUS) for good.
pub var mcBusy = false
// Entries the interrupt ring gets once it is on (their source), at the
// first pause after; a storm (entries at every pause); entries whose
// interrupt does not come; a write pointer not written back; the ring
// busy.
pub var pending: usize = 0
pub var pendingSource: usize = 42
pub var storm = false
pub var noMessage = false
pub var noWriteBack = false
pub var ringBusy = false
// The card gone (every register reads all ones) once this register is
// written.
pub var goneAt: usize = NEVER
pub var gone = false

fn mem(at: usize) -> *usize { return unsafe { @ptrFromInt(*usize, at) } }

fn word32(at: usize) -> *u32 { return unsafe { @ptrFromInt(*u32, at) } }

pub fn smcSet(address: usize, value: usize) -> void {
    var k: usize = 0
    while k < smcCount {
        if smcAddress[k] == address {
            smcValue[k] = value
            return
        }
        k += 1
    }
    if smcCount < SMC_ROOM {
        smcAddress[smcCount] = address
        smcValue[smcCount] = value
        smcCount += 1
    }
}

pub fn smcGet(address: usize) -> usize {
    var k: usize = 0
    while k < smcCount {
        if smcAddress[k] == address { return smcValue[k] }
        k += 1
    }
    return 0
}

fn selected() -> usize {
    const s = registers[engines.SRBM_GFX_CNTL]
    return (((s >> 2) & 3) * 32 + (s & 3) * 8 + ((s >> 8) & 7)) % QUEUES
}

// The frame counter of controller 0: the frames since the clock began.
fn frames() -> usize {
    if framesStopped { return 7 }
    return (clock / 1000) * millihertz / 1000000000 & 0xFFFFFF
}

fn beyondFind(offset: usize) -> usize {
    var k: usize = 0
    while k < beyondCount {
        if beyondAt[k] == offset { return k }
        k += 1
    }
    return NEVER
}

fn windowOffset() -> usize { return (registers[engines.MM_INDEX_HI] << 31) | (registers[engines.MM_INDEX] & engines.MM_INDEX__MM_OFFSET) }

pub fn read(number: usize) -> u32 {
    if gone { return 0xFFFFFFFF }
    var value = registers[number % ROOM]
    if number == scanout.CRTC_STATUS_FRAME_COUNT {
        value = frames()
    } else if number == engines.SMC_IND_DATA_11 {
        const address = registers[engines.SMC_IND_INDEX_11]
        value = smcGet(address)
        if address == engines.ixSMC_PC_C { smcSet(address, value + counterStep) }
    } else if number == engines.MC_SEQ_IO_DEBUG_DATA {
        value = if registers[engines.MC_SEQ_IO_DEBUG_INDEX] == engines.ixMC_IO_DEBUG_UP_159 { listVersion } else { 0 }
    } else if number == engines.MM_DATA && registers[engines.MM_INDEX] & engines.MM_INDEX__MM_APER != 0 {
        const offset = windowOffset()
        if offset + 4 <= VIEW {
            value = @intCast(usize, word32(vram + offset).*)
            if offset & ~@intCast(usize, 7) == unseen { value = value ^ 0x10 }
        } else {
            const k = beyondFind(offset)
            value = if k == NEVER { 0 } else { beyondValue[k] }
            if beyondBad { value = value ^ 1 }
        }
    } else if number == engines.CP_HQD_ACTIVE {
        value = queueActive[selected()]
    } else if number == engines.CP_HQD_DEQUEUE_REQUEST {
        value = queueDequeue[selected()]
    } else if number == engines.CP_HQD_PQ_RPTR {
        value = queueRead[selected()]
    } else if number == engines.CP_HQD_PQ_WPTR {
        value = queueWrite[selected()]
    } else if number == engines.IH_RB_CNTL {
        value = value & ~engines.IH_RB_CNTL__WPTR_OVERFLOW_CLEAR
    } else if number == engines.VM_L2_CNTL2 {
        value = value & ~(engines.VM_L2_CNTL2__INVALIDATE_ALL_L1_TLBS | engines.VM_L2_CNTL2__INVALIDATE_L2_CACHE)
    } else if number == engines.SRBM_STATUS {
        value = engines.SRBM_STATUS__MCB_BUSY | (if ringBusy { engines.SRBM_STATUS__IH_BUSY } else { 0 }) | (if mcBusy { engines.SRBM_STATUS__MCC_BUSY } else { 0 })
    } else if number == engines.DMIF_STATUS {
        value = registers[number]
    }
    return @intCast(u32, value & 0xFFFFFFFF)
}

pub fn write(number: usize, value32: u32) -> void {
    const value = @intCast(usize, value32)
    if written < WRITES {
        writtenTo[written] = number
        writtenWith[written] = value
    }
    written += 1
    if gone { return }
    if number == goneAt { gone = true }
    if number == stopFramesAt { framesStopped = true }
    if number == dryAt { registers[engines.DMIF_STATUS] |= engines.DMIF_STATUS__DMIF_UNDERFLOW }
    if number == scribbleAt {
        mem(vram + pictureOffset + 64).* ^= 0xFF
        scribbleAt = NEVER
    }
    if number == faultAt {
        registers[engines.VM_CONTEXT0_PROTECTION_FAULT_STATUS + faultSpace] = 0x1004
        registers[engines.VM_CONTEXT0_PROTECTION_FAULT_ADDR + faultSpace] = 0x0FF00800
    }
    if number == slowAt { millihertz = slowTo }
    if number == engines.IH_RB_CNTL && value & engines.IH_RB_CNTL__WPTR_OVERFLOW_CLEAR != 0 && overflowing {
        overflowing = false
        registers[engines.IH_RB_WPTR] &= ~engines.IH_RB_WPTR__RB_OVERFLOW
        const back = writeBack()
        if back != NEVER { word32(dmaMemory + back - dmaBase).* &= ~@intCast(u32, engines.IH_RB_WPTR__RB_OVERFLOW) }
    }
    if number == stuck { return }
    if number == engines.SMC_IND_DATA_11 {
        smcSet(registers[engines.SMC_IND_INDEX_11], value)
        return
    }
    if number == engines.MM_DATA && registers[engines.MM_INDEX] & engines.MM_INDEX__MM_APER != 0 {
        const offset = windowOffset()
        if offset + 4 <= VIEW {
            word32(vram + offset).* = value32
        } else {
            var k = beyondFind(offset)
            if k == NEVER && beyondCount < BEYOND {
                k = beyondCount
                beyondAt[k] = offset
                beyondCount += 1
            }
            if k != NEVER { beyondValue[k] = value }
        }
        return
    }
    if number == engines.CP_HQD_DEQUEUE_REQUEST {
        queueDequeue[selected()] = value
        if value & engines.CP_HQD_DEQUEUE_REQUEST__DEQUEUE_REQ != 0 && !queueHolds { queueActive[selected()] = 0 }
        return
    }
    if number == engines.CP_HQD_PQ_RPTR {
        queueRead[selected()] = value
        return
    }
    if number == engines.CP_HQD_PQ_WPTR {
        queueWrite[selected()] = value
        return
    }
    if number == engines.VM_INVALIDATE_REQUEST {
        registers[engines.VM_INVALIDATE_RESPONSE] = value
        return
    }
    registers[number % ROOM] = value
}

pub fn now() -> usize {
    clock += stride
    return clock
}

// The interrupt ring's entries delivered as the card would: at the
// write pointer, the pointer moved and written back, the interrupt
// raised when the ring re-arms on the read pointer and it is routed.
// Where the card writes its write pointer back, in the memory set aside
// (NEVER: elsewhere).
fn writeBack() -> usize {
    const back = (registers[engines.IH_RB_WPTR_ADDR_HI] << 32) | (registers[engines.IH_RB_WPTR_ADDR_LO] & engines.IH_RB_WPTR_ADDR_LO__ADDR)
    if back >= dmaBase && back + 4 <= dmaBase + DMA_BYTES { return back }
    return NEVER
}

fn deliver(count: usize) -> void {
    const control = registers[engines.IH_RB_CNTL]
    if control & engines.IH_RB_CNTL__RB_ENABLE == 0 { return }
    const ring = registers[engines.IH_RB_BASE] << 8
    var pointer = registers[engines.IH_RB_WPTR] & (engines.IH_RING_BYTES - 1) & ~engines.IH_RB_WPTR__RB_OVERFLOW
    var k: usize = 0
    while k < count {
        if ring >= dmaBase && ring + engines.IH_RING_BYTES <= dmaBase + DMA_BYTES {
            word32(dmaMemory + ring - dmaBase + pointer).* = @intCast(u32, pendingSource)
            word32(dmaMemory + ring - dmaBase + pointer + 4).* = 0
            word32(dmaMemory + ring - dmaBase + pointer + 8).* = 0
        }
        pointer = (pointer + engines.IH_ENTRY_BYTES) & (engines.IH_RING_BYTES - 1)
        k += 1
    }
    if overflow {
        overflow = false
        overflowing = true
    }
    const reported = if overflowing { pointer | engines.IH_RB_WPTR__RB_OVERFLOW } else { pointer }
    registers[engines.IH_RB_WPTR] = reported
    const back = writeBack()
    if !noWriteBack && control & engines.IH_RB_CNTL__WPTR_WRITEBACK_ENABLE != 0 && back != NEVER { word32(dmaMemory + back - dmaBase).* = @intCast(u32, reported) }
    if routed && !noMessage && control & engines.IH_RB_CNTL__ENABLE_INTR != 0 {
        if interruptsOn {
            messages += 1
        } else {
            waitingMessage = true
        }
    }
}

pub fn pause(microseconds: usize) -> void {
    pauses += 1
    clock += microseconds * 1000
    if registers[engines.IH_RB_CNTL] & engines.IH_RB_CNTL__RB_ENABLE != 0 {
        if pending != 0 {
            const count = pending
            pending = 0
            deliver(count)
        } else if storm {
            deliver(32)
        }
    }
}

pub fn say(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length && logged < LOG {
        log[logged] = text[k]
        logged += 1
        k += 1
    }
}

pub fn putAside(on: bool) -> void {
    if on { asides += 1 }
    aside = on
}

pub fn vramRead(offset: usize) -> usize {
    if offset + 8 > VIEW { return NEVER }
    var value = mem(vram + offset).*
    if offset == badWord { value = value ^ 1 }
    return value
}

pub fn vramWrite(offset: usize, value: usize) -> void {
    if offset + 8 > VIEW { return }
    mem(vram + offset).* = value
}

pub fn dma(bytes: usize) -> usize {
    const size = (bytes + 4095) / 4096 * 4096
    if dmaUsed + size > dmaPages * 4096 { return 0 }
    const at = dmaBase + dmaUsed
    dmaUsed += size
    return at
}

pub fn memoryRead(physical: usize) -> u32 {
    if physical < dmaBase || physical + 4 > dmaBase + DMA_BYTES { return 0xFFFFFFFF }
    return word32(dmaMemory + physical - dmaBase).*
}

pub fn pciCommand() -> usize { return command }

pub fn route() -> bool {
    routed = routable
    return routable
}

pub fn interrupts() -> usize { return messages }

pub fn waiting() -> bool { return waitingMessage }

pub fn file(name: []const u8) -> []const u8 {
    var k: usize = 0
    while k < fileCount {
        if same(fileName[k], name) {
            if k == fileMissing { return fileBytes[k][0..0] }
            if k == fileShort { return fileBytes[k][0..fileBytes[k].length - 4] }
            return fileBytes[k]
        }
        k += 1
    }
    return name[0..0]
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

// A file of the repository's firmware read into memory of its own.
pub fn load(name: []const u8) -> bool {
    if fileCount >= FILES { return false }
    var path: [128]u8 = undefined
    const prefix = "projects/brix/firmware/amdgpu/"
    var k: usize = 0
    while k < prefix.length {
        path[k] = prefix[k]
        k += 1
    }
    var j: usize = 0
    while j < name.length {
        path[k] = name[j]
        k += 1
        j += 1
    }
    path[k] = 0
    const room: usize = 300000
    const into = std.linux.mapAnonymous(room)
    if into == 0 { return false }
    const length = std.fs.readFile(path[0..k + 1].pointer, unsafe { @ptrFromInt([*]u8, into) }, room)
    if length == 0 { return false }
    fileName[fileCount] = name
    fileBytes[fileCount] = unsafe { @ptrFromInt([*]const u8, into) }[0..length]
    fileCount += 1
    return true
}

pub fn hands() -> engines.Hands {
    return engines.Hands.{ .read = read, .write = write, .now = now, .pause = pause, .say = say, .aside = putAside, .vramRead = vramRead, .vramWrite = vramWrite, .dma = dma, .memoryRead = memoryRead, .command = pciCommand, .route = route, .interrupts = interrupts, .waiting = waiting, .file = file }
}

// The ROM this card's firmware has, as far as the stages read it: the
// firmware information with its default clocks (300.00 MHz each: 30000
// tens of kHz) and GFX_Info (revision 2.3, 24 bytes: 1, 8, 4, 8, 9, 1, 2,
// 8: the user's ROM's numbers as the study read them on the host).
var builder: rom.Builder = undefined
pub var machine: atom.Atom = undefined
var scratch: [1024]u32 = undefined

pub fn makeRom(gfx: bool) -> bool {
    builder.begin(81, 35)
    const info = builder.firmware(100000, 25000, 100000, 2970000, 6000000, 626100, 100000)
    builder.poke32(info + engines.ATOM_FIRMWARE_INFO_V2_2__ulDefaultEngineClock, 30000)
    builder.poke32(info + engines.ATOM_FIRMWARE_INFO_V2_2__ulDefaultMemoryClock, 30000)
    if gfx {
        _ = builder.openData(engines.GFX_Info, 2, 3)
        const numbers = [_]usize{ 1, 8, 4, 8, 9, 1, 2, 8 }
        for n in numbers { builder.byte(n) }
        var k: usize = 0
        while k < 12 {
            builder.byte(0)
            k += 1
        }
        builder.closeData()
    }
    builder.finish()
    return machine.open(builder.image(), scratch[0..]) == atom.Opened.ok
}

// The card anew as the user's machine has it after a boot that set the
// monitor's own mode: every register as such a card answers, the
// aperture's memory empty but for nothing, nothing wrong.
pub fn reset() -> void {
    var k: usize = 0
    while k < ROOM {
        registers[k] = 0
        k += 1
    }
    k = 0
    while k < QUEUES {
        queueActive[k] = 0
        queueDequeue[k] = 0
        queueRead[k] = 0
        queueWrite[k] = 0
        k += 1
    }
    if vram == 0 { vram = std.linux.mapAnonymous(VIEW) }
    if dmaMemory == 0 { dmaMemory = std.linux.mapAnonymous(DMA_BYTES) }
    clear(vram, VIEW)
    clear(dmaMemory, DMA_BYTES)
    clock = 1000000000
    stride = 1000
    pauses = 0
    written = 0
    logged = 0
    aside = false
    asides = 0
    smcCount = 0
    beyondCount = 0
    dmaUsed = 0
    dmaPages = 2048
    dmaBase = DMA_BASE
    command = 0x0406
    routable = true
    routed = false
    messages = 0
    interruptsOn = false
    waitingMessage = false
    listVersion = 0x03B4DC40
    counterStep = 0x14
    queueHolds = false
    fileMissing = NEVER
    fileShort = NEVER
    stuck = NEVER
    badWord = NEVER
    unseen = NEVER
    beyondBad = false
    stopFramesAt = NEVER
    dryAt = NEVER
    scribbleAt = NEVER
    faultAt = NEVER
    framesStopped = false
    faultSpace = 0
    mcBusy = false
    slowAt = NEVER
    slowTo = 0
    overflow = false
    overflowing = false
    pending = 0
    pendingSource = 42
    storm = false
    noMessage = false
    noWriteBack = false
    ringBusy = false
    goneAt = NEVER
    gone = false
    millihertz = 59980
    // The memory, as the machine's log has it.
    registers[engines.CONFIG_MEMSIZE] = 8192
    registers[engines.MC_VM_FB_LOCATION] = 0xF5FFF400
    registers[engines.GRBM_STATUS] = 0x3028
    registers[engines.BIOS_SCRATCH_7] = engines.ATOM_S7_ASIC_INIT_COMPLETE_MASK
    registers[engines.BIF_FB_EN] = engines.BIF_FB_EN__FB_READ_EN | engines.BIF_FB_EN__FB_WRITE_EN
    registers[engines.MC_VM_SYSTEM_APERTURE_LOW_ADDR] = 0x0F400000
    registers[engines.MC_VM_SYSTEM_APERTURE_HIGH_ADDR] = 0x0F5FFFFF
    registers[engines.MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR] = 0x0F400000
    registers[engines.MC_SEQ_SUP_CNTL] = engines.MC_SEQ_SUP_CNTL__RUN
    registers[engines.MC_SEQ_MISC0] = engines.MC_SEQ_MISC0__MT__GDDR5 | 0x80
    registers[engines.MC_SEQ_TRAIN_WAKEUP_CNTL] = engines.MC_SEQ_TRAIN_WAKEUP_CNTL__TRAIN_DONE_D0 | engines.MC_SEQ_TRAIN_WAKEUP_CNTL__TRAIN_DONE_D1
    registers[engines.MC_ARB_RAMCFG] = 0x80
    // The engines halted (the study's 11, card 1: what is expected).
    registers[engines.CP_ME_CNTL] = engines.CP_ME_CNTL__ME_HALT | engines.CP_ME_CNTL__PFP_HALT | engines.CP_ME_CNTL__CE_HALT
    registers[engines.CP_MEC_CNTL] = engines.CP_MEC_CNTL__MEC_ME1_HALT | engines.CP_MEC_CNTL__MEC_ME2_HALT
    registers[engines.SDMA0_F32_CNTL] = engines.SDMA0_F32_CNTL__HALT
    registers[engines.SDMA1_F32_CNTL] = engines.SDMA0_F32_CNTL__HALT
    registers[engines.GB_ADDR_CONFIG] = 0x22011003
    // The SMC running its ROM: clock on, a program counter of its ROM,
    // protected mode, the hard key.
    smcSet(engines.ixSMC_SYSCON_CLOCK_CNTL_0, 0)
    smcSet(engines.ixSMC_PC_C, 0x1A2C)
    smcSet(engines.ixSMU_FIRMWARE, engines.SMU_FIRMWARE__SMU_MODE | engines.SMU_FIRMWARE__SMU_SEL)
    smcSet(engines.ixRCU_UC_EVENTS, engines.RCU_UC_EVENTS__boot_seq_done)
    smcSet(engines.ixFIRMWARE_FLAGS, 0)
    smcSet(engines.ixSMU_EFUSE_0 + engines.AVFS_FUSE_WORD * 4, 1)
    smcSet(engines.ixCG_MULT_THERMAL_STATUS, 41 << 9)
    smcSet(engines.ixCG_FDO_CTRL2, 5 << 11)
    smcSet(engines.ixCG_THERMAL_STATUS, 51 << 9)
    smcSet(engines.ixCG_FDO_CTRL1, 255)
    // Controller 0 shows the monitor's own mode, out of the aperture.
    picture(0x500000, 3840, 1080, 4040, 1115)
}

fn clear(at: usize, bytes: usize) -> void {
    var k: usize = 0
    while k < bytes {
        mem(at + k).* = 0
        k += 8
    }
}

// Controller 0's picture: at `offset` of the aperture, `width` by
// `height` (the pitch the width), the timing's totals.
pub fn picture(offset: usize, width: usize, height: usize, hTotal: usize, vTotal: usize) -> void {
    pictureOffset = offset
    pictureWidth = width
    pictureHeight = height
    registers[scanout.CRTC_CONTROL] = 0x80410311
    registers[scanout.GRPH_ENABLE] = 1
    registers[scanout.GRPH_PRIMARY_SURFACE_ADDRESS] = (0xF400000000 + offset) & 0xFFFFFFFF
    registers[scanout.GRPH_PRIMARY_SURFACE_ADDRESS_HIGH] = (0xF400000000 + offset) >> 32
    registers[scanout.GRPH_PITCH] = width
    registers[scanout.GRPH_Y_END] = height
    registers[scanout.CRTC_H_TOTAL] = hTotal - 1
    registers[scanout.CRTC_V_TOTAL] = vTotal - 1
    // Something drawn on it, so that a sum tells.
    var k: usize = 0
    while k < width * height * 4 {
        mem(vram + offset + k).* = k *% 0x9E3779B97F4A7C15
        k += 4096
    }
}

// No picture of the kernel's on the card (another adapter shows it).
pub fn noPicture() -> void {
    registers[scanout.CRTC_CONTROL] = 0
    registers[scanout.GRPH_ENABLE] = 0
}

// What is in the log.
pub fn has(text: []const u8) -> bool { return after(text, 0) != NEVER }

pub fn after(text: []const u8, from: usize) -> usize {
    var at = from
    while at + text.length <= logged {
        var k: usize = 0
        while k < text.length && log[at + k] == text[k] { k += 1 }
        if k == text.length { return at + text.length }
        at += 1
    }
    return NEVER
}

pub fn count(text: []const u8) -> usize {
    var found: usize = 0
    var at: usize = 0
    while true {
        at = after(text, at)
        if at == NEVER { return found }
        found += 1
    }
    return found
}

// The register writes from `from` on, as the test lists them: whether
// they are `numbers` with `values` in that order (NEVER in `values`: any
// value), and where the first difference is (NEVER: none).
pub fn writesFrom(from: usize, numbers: []const usize, values: []const usize) -> usize {
    var k: usize = 0
    while k < numbers.length {
        if from + k >= written { return k }
        if writtenTo[from + k] != numbers[k] { return k }
        if values[k] != NEVER && writtenWith[from + k] != values[k] { return k }
        k += 1
    }
    if from + numbers.length != written { return numbers.length }
    return NEVER
}

// Whether a register is the display's: one of DCE 11.2's (dce_11_2_d.h's
// numbers, but for its audio controller's, which are of another
// function's space), as runs from first to last where no two of the
// header's numbers lie more than 16 apart: tools/check_gpu_registers.py
// makes the runs from the header again and holds these against them.
pub const DISPLAY_RUNS = [_]usize{ 0xC0, 0xD7, 0xED, 0x17E, 0x280, 0x2E0, 0x2F5, 0x33D, 0x358, 0x36E, 0x3E0, 0x49A, 0x1600, 0x167B, 0x169B, 0x178F, 0x17A8, 0x17C5, 0x17E4, 0x183D, 0x184E, 0x18D2, 0x1A00, 0x1AE6, 0x1AFE, 0x1B07, 0x1B24, 0x1CE6, 0x1CFE, 0x1D07, 0x1D24, 0x1EE6, 0x1EFE, 0x1F07, 0x1F24, 0x1FFF, 0x4000, 0x40E6, 0x40FE, 0x4107, 0x4124, 0x42E6, 0x42FE, 0x4307, 0x4324, 0x44E6, 0x44FE, 0x4507, 0x4524, 0x4700, 0x4724, 0x474F, 0x476D, 0x479C, 0x47B3, 0x47B3, 0x47C6, 0x47E0, 0x4800, 0x4A48, 0x4A6B, 0x4A7E, 0x4AA0, 0x4AE1, 0x4B00, 0x4B48, 0x4B6B, 0x4B7E, 0x4BA0, 0x4BE1, 0x4C00, 0x4C48, 0x4C6B, 0x4C7E, 0x4CA0, 0x4CE1, 0x4D00, 0x4D48, 0x4D6B, 0x4D7E, 0x4DA0, 0x4DE1, 0x4E00, 0x4E48, 0x4E6B, 0x4E7E, 0x4EA0, 0x4EE1, 0x4F00, 0x4F48, 0x4F6B, 0x4F7E, 0x4FA0, 0x4FE1, 0x5400, 0x5448, 0x546B, 0x547E, 0x54A0, 0x54E1, 0x5600, 0x5648, 0x566B, 0x567E, 0x56A0, 0x56E1, 0x5700, 0x5748, 0x576B, 0x577E, 0x57A0, 0x57E1, 0x59A0, 0x59AA, 0x59C0, 0x59F1, 0x5A84, 0x5CA1, 0x5D98, 0x5DD7, 0x5E18, 0x5E38, 0x5F68, 0x5F72, 0x5FD0, 0x5FFF, 0x9800, 0x9900, 0x9924, 0x994F, 0x996D, 0x999C, 0x99B3, 0x99B3, 0x99C6, 0x99E0, 0x9A00, 0x9DC0 }

pub fn display(number: usize) -> bool {
    var k: usize = 0
    while k < DISPLAY_RUNS.length {
        if number >= DISPLAY_RUNS[k] && number <= DISPLAY_RUNS[k + 1] { return true }
        k += 2
    }
    return false
}

// How many of the writes from `from` on are the display's.
pub fn displayWrites(from: usize) -> usize {
    var found: usize = 0
    var k = from
    while k < written && k < WRITES {
        if display(writtenTo[k]) { found += 1 }
        k += 1
    }
    return found
}
