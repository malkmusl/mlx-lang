// A call's result is a value, no place: its slice is a `[]const u8`.
fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

fn whole() -> [4]u8 { return [4]u8{ 1, 2, 3, 4 } }

pub fn main() -> u8 {
    fill(whole()[0..2])
    return whole()[1]
}
