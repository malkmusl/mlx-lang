// An element and a field of a constant, through any chain of them, are
// constants: so are the slices of the arrays there.
const GRID = [2][3]u8{ [3]u8{ 1, 2, 3 }, [3]u8{ 4, 5, 6 } }
const Limits = struct { low: i32, steps: [3]u8 }
const LIMITS = [2]Limits{ Limits.{ .low = -4, .steps = [3]u8{ 7, 8, 9 } }, Limits.{ .low = 0, .steps = [3]u8{ 1, 1, 1 } } }

fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

pub fn main() -> u8 {
    fill(GRID[1][0..2])
    fill(LIMITS[1].steps[1..])
    return GRID[1][0] + LIMITS[1].steps[1]
}
