// An element of a constant, through any chain of them, is a constant: so
// is the slice of the array there.
const GRID = [2][3]u8{ [3]u8{ 1, 2, 3 }, [3]u8{ 4, 5, 6 } }

fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

pub fn main() -> u8 {
    fill(GRID[1][0..2])
    return GRID[1][0]
}
