// A field of an element of a constant is a constant: so is the slice of
// the array there.
const Limits = struct { low: i32, steps: [3]u8 }
const LIMITS = [2]Limits{ Limits.{ .low = -4, .steps = [3]u8{ 7, 8, 9 } }, Limits.{ .low = 0, .steps = [3]u8{ 1, 1, 1 } } }

fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

pub fn main() -> u8 {
    fill(LIMITS[1].steps[1..])
    return LIMITS[1].steps[1]
}
