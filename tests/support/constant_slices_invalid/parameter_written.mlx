// An array parameter is taken by value, and it is the caller's own
// storage (aggregates are passed by address): its slice is a `[]const
// u8`. (As a `[]u8` it let `poke` change `mine`: main returned 9.)
fn poke(taken: [8]u8) -> void {
    const part = taken[0..4]
    part[1] = 9
}

pub fn main() -> u8 {
    var mine: [8]u8 = undefined
    mine[1] = 1
    poke(mine)
    return mine[1]
}
