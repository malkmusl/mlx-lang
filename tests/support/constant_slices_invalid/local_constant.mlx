// A local `const` is a constant too: a buffer that is filled is a `var`.
fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

pub fn main() -> u8 {
    const buffer = [4]u8{ 1, 2, 3, 4 }
    fill(buffer[0..])
    return buffer[1]
}
