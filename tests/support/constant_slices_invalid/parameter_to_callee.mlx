// The slice of an array parameter does not go where a `[]u8` is taken:
// the callee would write into the caller's array.
fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

fn clear(taken: [8]u8) -> void { fill(taken[0..]) }

pub fn main() -> u8 {
    var mine: [8]u8 = undefined
    mine[1] = 1
    clear(mine)
    return mine[1]
}
