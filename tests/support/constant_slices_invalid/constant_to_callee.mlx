// The slice of a module's constant does not go where a `[]u8` is taken:
// the callee would write through it. (It compiled, and filled a copy.)
const BYTES = [6]u8{ 10, 20, 30, 40, 50, 60 }

fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

pub fn main() -> u8 {
    fill(BYTES[0..6])
    return BYTES[2]
}
