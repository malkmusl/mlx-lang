// The payload of an optional is no place that is written (`held.?[1] =
// 7` is refused as well), also a variable's: the slice of an array there
// is a `[]const u8`.
fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

pub fn main() -> u8 {
    var held: ?[4]u8 = [4]u8{ 1, 2, 3, 4 }
    fill(held.?[0..])
    return 0
}
