// A field of a `*const Self` is not written: the slice of the array
// there is a `[]const u8`.
const Record = struct {
    bytes: [4]u8

    fn clear(self: *const Self) -> void { fill(self.*.bytes[0..]) }
}

fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

pub fn main() -> u8 {
    var record = Record.{ .bytes = [4]u8{ 1, 2, 3, 4 } }
    record.clear()
    return record.bytes[0]
}
