// What a `*const` pointer points to is not written: the slice of an
// array reached through one is a `[]const u8`, as a field of a `*const
// Self` too.
const Record = struct {
    bytes: [4]u8

    fn clear(self: *const Self) -> void { fill(self.*.bytes[0..]) }
}

fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

fn first(target: *const [4]u8) -> void { fill(target.*[0..2]) }

pub fn main() -> u8 {
    var record = Record.{ .bytes = [4]u8{ 1, 2, 3, 4 } }
    record.clear()
    first(&record.bytes)
    return record.bytes[0]
}
