// A constant of another module reached through a third is a constant
// (the variable beside it is one: tests/443_constant_slices_runtime.mlx
// writes that): its slice is a `[]const u8`.
const outer = @import("../../modules/443_outer.mlx")

fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

pub fn main() -> u8 {
    fill(outer.inner.FIXED[0..])
    return outer.inner.FIXED[0]
}
