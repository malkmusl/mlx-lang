// A field of a parameter taken by value is as little writable as the
// parameter: the slice of an array in it is a `[]const u8`.
const Record = struct { bytes: [4]u8, count: usize }

fn fill(into: []u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = 99
        k += 1
    }
}

fn clear(record: Record) -> void { fill(record.bytes[0..]) }

pub fn main() -> u8 {
    var mine = Record.{ .bytes = [4]u8{ 1, 2, 3, 4 }, .count = 4 }
    clear(mine)
    return mine.bytes[1]
}
