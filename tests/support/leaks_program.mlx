// std.leaks in a program (tests/run_debug_allocator.sh): with
// MLX_LEAK_CHECK=1 the page allocator is watched from crash.install on, as
// in every program of MLX (and its memory written to
// $XDG_RUNTIME_DIR/mlx/memory at the mark and the report); what the loop allocates
// and keeps (every third turn's block) is said as one place at the end,
// what was set up before the mark is not, nor a cache's block kept on
// purpose (leaks.keep). Each turn's values grow the compiler's arena,
// which the report says too, unless the loop gives them back (any
// argument: std.turns). Without MLX_LEAK_CHECK nothing is said. Exits
// with the number of blocks the report counted.
const std = @import("std")
const crash = @import("std.crash")
const leaks = @import("std.leaks")
const turns_module = @import("std.turns")

fn setUp() -> usize {
    const block = std.page_allocator.init().alloc(4096, 4096)
    return @intFromPtr(block.?)
}

fn turn(number: usize) -> void {
    const pages = std.page_allocator.init()
    const block = pages.alloc(4096, 4096).?
    block[0] = 1
    if number % 3 != 0 { pages.free(block, 4096, 4096) }
    if number == 4 {
        const cache = pages.alloc(8192, 4096).?
        leaks.keep(cache)
    }
    // 16 KiB of values a turn.
    var values: [16384]u8 = undefined
    values[number] = 1
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const installed = crash.install()
    const kept = setUp()
    leaks.mark()
    var turns: turns_module.Turns = undefined
    turns_module.begin(&turns, arguments.length > 1, false)
    var number: usize = 0
    while number < 9 {
        turns_module.turn(&turns)
        turn(number)
        number += 1
    }
    return @intCast(u8, leaks.report())
}
