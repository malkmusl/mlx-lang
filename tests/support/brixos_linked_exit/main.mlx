// A program that names a C function is a linked one: on Linux it leaves
// through the C library's exit when main returns. On brixOS there is no
// C library to call (the kernel loads the program as it is, nothing fills
// its imports): it has to leave by process_exit, and must not import
// exit. (std.vulkan's loader names dlopen, so every std.ui program is
// such a one: the greeter returned from main into a call through an
// empty import, a jump to nowhere.) tools/ensure_compiler.sh builds this
// for brixOS and looks for the import.
extern("c") fn getpid() -> i32

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length > 64 { _ = getpid() }
    return 0
}
