// The user's whole Radeon as a table, for the tests of the monitor
// followed from one output to another (tests/485_gpu_switch_runtime.mlx
// and 486_gpu_switch_plan_runtime.mlx): tests/support/tmds_card.mlx's
// display (its registers, the card's tables as programs of the test's,
// the frame counter, every write in order) and tests/support/
// plug_card.mlx's hot plug lines and I2C engine (with a monitor's EDID
// memory behind each DDC line and a script of what happens when) put
// together as one card with one clock, and a ROM with the user's five
// connectors as the machine's log of 17 Nov names them: two DisplayPort
// on DIG 2 and 3 (hot plug lines 1 and 5, DDC entries 1 and 3), two HDMI
// on DIG 4 (line 6, entry 0) and DIG 5 (line 4, entry 2), a DVI-D with
// two links on DIG 0 (line 3, entry 5); the HDMI encoders may carry 300
// MHz and more (the ROM's capability record says so for the user's).
// Which of the card's DDC lines an entry is was not read on the card:
// here entry n is line n.
//
// A register goes to the plug card when it is a hot plug line's, the
// pins' word of the lines, the I2C engine's, a DDC line's pins' or the
// time base the engine's speed comes from; every other one to the
// display card. Nothing of a real card's ROM is in here.
const scanout = @import("../../projects/brix/kernel/gpu_display.mlx")
const ddc = @import("../../projects/brix/kernel/gpu_ddc.mlx")
const plug = @import("../../projects/brix/kernel/gpu_plug.mlx")
const atom = @import("../../projects/brix/kernel/atom.mlx")
const rom = @import("./atom_rom.mlx")
const display = @import("./tmds_card.mlx")
const lines = @import("./plug_card.mlx")

pub const NEVER: usize = 0xFFFFFFFF

// The user's connectors, in the ROM's order.
pub const CONNECTORS = [_]usize{ 0x3113, 0x3213, 0x310C, 0x320C, 0x3104 }
pub const ENCODERS = [_]usize{ 0x2120, 0x2220, 0x2121, 0x2221, 0x211E }
pub const PINS = [_]usize{ 1, 5, 6, 4, 3 }
pub const PIN_SHIFTS = [_]usize{ 0, 26, 28, 24, 16 }
pub const ENTRIES = [_]usize{ 1, 3, 0, 2, 5 }
pub const CLOCK_PINS = [_]usize{ 0x4869, 0x486D, 0x4871, 0x4875, 0x4879, 0x487D }
// Each connector's back end, hot plug line and DDC line, by the above.
pub const BACK_ENDS = [_]usize{ 2, 3, 4, 5, 0 }
pub const LINES = [_]usize{ 1, 5, 6, 4, 3 }

fn theirs(number: usize) -> bool {
    if number >= plug.DC_HPD_INT_STATUS && number < plug.DC_HPD_INT_STATUS + 6 * plug.HPD_STEP { return true }
    if number == plug.DC_GPIO_HPD_MASK || number == 0x488D { return true }
    if number >= ddc.DC_I2C_CONTROL && number <= ddc.DC_I2C_DATA { return true }
    if number >= ddc.DC_GPIO_DDC1_MASK && number < ddc.DC_GPIO_DDC1_MASK + 4 * ddc.LINES { return true }
    return number == ddc.MICROSECOND_TIME_BASE_DIV
}

// The one clock: the display card's goes on at every look, the plug
// card's follows it (and its script with it).
fn follow() -> void {
    lines.stride = 0
    lines.clock = display.clock
    _ = lines.now()
}

pub fn now() -> usize {
    const at = display.now()
    follow()
    return at
}

// Time passed without a look (the test's, between ticks).
pub fn pass(nanoseconds: usize) -> void {
    display.clock += nanoseconds
    follow()
}

pub fn pause(microseconds: usize) -> void {
    lines.pauses += 1
    lines.paused += microseconds
    pass(microseconds * 1000)
}

pub fn read(number: usize) -> u32 {
    if theirs(number) { return lines.read(number) }
    return display.read(number)
}

// The driver's own writes: the display's as tmds_card counts them, the
// engine's and the pins' as plug_card does.
pub fn write(number: usize, value: u32) -> void {
    if theirs(number) {
        lines.write(number, value)
        return
    }
    display.write(number, value)
}

// The log is the display card's.
pub fn card() -> scanout.Card { return scanout.Card.{ .read = read, .now = now, .write = display.logWrite } }

pub fn hands() -> ddc.Hands { return ddc.Hands.{ .write = write } }

// Everything forgotten: no register holds anything, nothing is on any
// line, nothing is wrong with the card.
pub fn reset() -> void {
    display.reset()
    lines.reset()
    lines.clock = 0
    display.clock = 1000000000
    follow()
}

// The firmware's state of the user's machine: controller 0 runs its
// 1280x960 picture (tmds_card's `firmware`) out of front end and back end
// 4 in DVI mode on the PLL 4 at `kilohertz`; every other back end is as
// the log of 17 Nov reads it (off, mode 1, hot plug select 0, its symbol
// clock on); every front end's HDMI word 0x10001; every hot plug line's
// block on with its pin the block's, high where `high` has the line's
// bit (1 << line).
pub fn users(kilohertz: usize, high: usize) -> void {
    reset()
    // (The engine runs as long as the bytes take on the wire, 90 us a
    // byte: a reading from the ticks finds a run over at the next one.)
    lines.byClock = true
    var n: usize = 0
    while n < 6 {
        display.store(scanout.DIG[n] + scanout.DIG_BE_CNTL, 0x00010000)
        display.store(scanout.DIG[n] + scanout.DIG_BE_EN_CNTL, 0x100)
        display.store(scanout.DIG[n] + scanout.HDMI_CONTROL, 0x00010001)
        n += 1
    }
    display.firmware(0, 4, 4, false, 6, kilohertz)
    n = 1
    while n <= 6 {
        lines.line(n, (high >> @intCast(u6, n)) & 1 != 0)
        n += 1
    }
}

// A monitor on connector `k` (its DDC line), whose EDID is `bytes`; and
// its line high or low from `at` on (NEVER: now).
pub fn monitor(k: usize, bytes: []const u8) -> void { lines.monitor(ENTRIES[k], bytes, true) }

pub fn unplug(k: usize) -> void { lines.unplug(ENTRIES[k]) }

pub fn line(k: usize, high: bool, at: usize) -> void {
    if at == NEVER {
        lines.line(LINES[k], high)
        return
    }
    lines.lineLater(at, LINES[k], high)
}

// The ROM: the six tables of a TMDS change as tmds_card's programs (the
// table at `odd` of the list ending as `ending` says), the user's
// connectors with their pins and DDC lines, and the HDMI encoders'
// capability. Finished.
pub fn makeRom(builder: *rom.Builder, odd: usize, ending: display.Ending) -> void {
    const end = [_]u8{0x5B}
    builder.begin(81, 35)
    var k: usize = 0
    while k < rom.MODE_TABLES[0..].length {
        _ = builder.command(rom.MODE_TABLES[k], 0, 0, end[0..])
        k += 1
    }
    builder.revise(13, 2, 1)
    _ = builder.command(0, 0, 0, end[0..])
    k = 0
    while k < display.TABLES[0..].length {
        const table = display.TABLES[k]
        var how = if table == 46 { display.Ending.answer } else { display.Ending.plain }
        if table == odd { how = ending }
        _ = builder.command(table, 0, display.TABLE_WORDS[k] * 4, display.program(table, display.TABLE_WORDS[k], how))
        k += 1
    }
    builder.revise(12, 1, 7)
    builder.revise(76, 1, 6)
    builder.revise(4, 1, 5)
    builder.revise(35, 1, 1)
    builder.revise(49, 1, 3)
    builder.revise(46, 2, 1)
    _ = builder.firmware(100000, 6000, 200000, 16000, 600000, 625000, 0)
    _ = builder.objects(CONNECTORS[0..], ENCODERS[0..], PINS[0..], ENTRIES[0..])
    _ = builder.scratch(64)
    builder.generator(3600000)
    var registers: [5]usize = undefined
    k = 0
    while k < 5 {
        registers[k] = 0x488D
        k += 1
    }
    _ = builder.pins(1, PINS[0..], registers[0..], PIN_SHIFTS[0..])
    _ = lines.lines(builder, 1, CLOCK_PINS[0..])
    builder.capability(2, 0x0006)
    builder.capability(3, 0x0006)
    builder.finish()
}
