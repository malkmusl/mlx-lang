// A second reference rasterizer for our Vulkan driver's stage (c) (test
// 516), written by its reviewer apart from tests/support/reference_raster.
// mlx and from the host card's model (projects/brix/vulkan/card_draw.mlx),
// from the Vulkan specification's rules as its reviewer knows them (the
// specification is not among the sources this work may fetch):
//
//   - the clip coordinates as the test's vertex shader computes them in
//     f32 (support/spirv/triangle.mlx's `transformed`: the identity with a
//     last row (wx, wy, 0, 1), so w = wx x + wy y + 1);
//   - the view volume -w <= x, y <= w, 0 <= z <= w: a triangle's samples
//     outside the viewport's rectangle are not covered (its corners at
//     whole pixels here, so no sample lies on its border);
//   - x_f = (p_x / 2) x_d + o_x and y_f likewise, o the viewport's centre,
//     p its size (a negative height turns it upside down, Vulkan 1.1);
//     the vertices on the 1/256 grid of subPixelPrecisionBits 8, a value
//     halfway between two of its points marked ambiguous (the rounding is
//     the implementation's: the case is left out);
//   - the area a = -1/2 sum(x_i y_(i+1) - x_(i+1) y_i) in framebuffer
//     coordinates, a > 0 counter-clockwise; culled as the cull mode says
//     for the front face given;
//   - a sample at the pixel's centre covered when it is inside each edge;
//     on an edge's line when that edge is a top edge (level, the triangle
//     below it) or a left edge (not level, the triangle on its right):
//     the tie rule this driver takes (the specification asks only that
//     two triangles sharing an edge cover its samples once); within the
//     scissor;
//   - the colour interpolated with perspective: each vertex's area weight
//     over its w, normalised, then clamped to [0, 1] and scaled by 255 to
//     the nearest integer (compared within one unit).
pub const N: usize = 32

pub const Case = struct {
    x: [3]f32
    y: [3]f32
    r: [3]f32
    g: [3]f32
    b: [3]f32
    wx: f32
    wy: f32
    // VK_CULL_MODE_* (1 front, 2 back), the front face clockwise
    cull: u32
    clockwise: bool
    vx: f32
    vy: f32
    vw: f32
    vh: f32
    sx: i32
    sy: i32
    sw: u32
    sh: u32
}

pub var want: [32 * 32 * 4]u32 = undefined
pub var covered: [32 * 32]bool = undefined
pub var ambiguous = false

fn mul(a: f32, b: f32) -> f32 { return a * b }

// The clip coordinates of vertex k in f32, the matrix times (x, y, 0, 1)
// row by row as the compiler sums them (column 0, 1, 2, 3).
fn clip(c: *const Case, k: usize, row: usize) -> f32 {
    const m0 = [4]f32{ 1.0, 0.0, 0.0, c.*.wx }
    const m1 = [4]f32{ 0.0, 1.0, 0.0, c.*.wy }
    const m3 = [4]f32{ 0.0, 0.0, 0.0, 1.0 }
    var s = mul(m0[row], c.*.x[k]) + mul(m1[row], c.*.y[k])
    s = s + mul(0.0, 0.0)
    s = s + mul(m3[row], 1.0)
    return s
}

fn grid(v: f64) -> i64 {
    const scaled = v * 256.0
    const below = @floor(scaled)
    const rest = scaled - below
    if rest > 0.4999 && rest < 0.5001 { ambiguous = true }
    var n = @intFromFloat(i64, below)
    if rest >= 0.5 { n += 1 }
    return n
}

fn cross(ax: i64, ay: i64, bx: i64, by: i64, cx: i64, cy: i64) -> i64 { return (bx - ax) * (cy - ay) - (by - ay) * (cx - ax) }

// Whether a sample on the line of edge a -> b is the triangle's whose
// third vertex is c (y grows downwards).
fn ownsEdge(ax: i64, ay: i64, bx: i64, by: i64, cx: i64, cy: i64) -> bool {
    if ay == by { return cy > ay }
    // c right of the edge: c's x beyond the edge's x at c's height
    const n = (cx - ax) * (by - ay) - (cy - ay) * (bx - ax)
    return (n > 0) == (by - ay > 0)
}

fn unorm(v: f64) -> u32 {
    var c = v
    if !(c > 0.0) { c = 0.0 }
    if c > 1.0 { c = 1.0 }
    return @intFromFloat(u32, @floor(c * 255.0 + 0.5))
}

// The pixels case `c` gives on a clear of 0 (alpha 0 uncovered, 255
// covered); `ambiguous` when a vertex lies halfway on the grid.
pub fn expect(c: *const Case) -> void {
    ambiguous = false
    var k: usize = 0
    while k < N * N {
        covered[k] = false
        want[4 * k] = 0
        want[4 * k + 1] = 0
        want[4 * k + 2] = 0
        want[4 * k + 3] = 0
        k += 1
    }
    var px: [3]i64 = undefined
    var py: [3]i64 = undefined
    var w: [3]f64 = undefined
    const hw = @floatCast(f64, c.*.vw) / 2.0
    const hh = @floatCast(f64, c.*.vh) / 2.0
    k = 0
    while k < 3 {
        w[k] = @floatCast(f64, clip(c, k, 3))
        px[k] = grid(hw * (@floatCast(f64, clip(c, k, 0)) / w[k]) + (@floatCast(f64, c.*.vx) + hw))
        py[k] = grid(hh * (@floatCast(f64, clip(c, k, 1)) / w[k]) + (@floatCast(f64, c.*.vy) + hh))
        k += 1
    }
    var sum: i64 = 0
    k = 0
    while k < 3 {
        const n = (k + 1) % 3
        sum += px[k] * py[n] - px[n] * py[k]
        k += 1
    }
    if sum == 0 { return }
    const counterClockwise = sum < 0
    const front = if c.*.clockwise { !counterClockwise } else { counterClockwise }
    if (front && (c.*.cull & 1) != 0) || (!front && (c.*.cull & 2) != 0) { return }
    const left = if c.*.vw > 0.0 { c.*.vx } else { c.*.vx + c.*.vw }
    const right = if c.*.vw > 0.0 { c.*.vx + c.*.vw } else { c.*.vx }
    const top = if c.*.vh > 0.0 { c.*.vy } else { c.*.vy + c.*.vh }
    const bottom = if c.*.vh > 0.0 { c.*.vy + c.*.vh } else { c.*.vy }
    var j: usize = 0
    while j < N {
        var i: usize = 0
        while i < N {
            const fx = @floatFromInt(f32, i) + 0.5
            const fy = @floatFromInt(f32, j) + 0.5
            const ii = @intCast(i64, i)
            const jj = @intCast(i64, j)
            const inScissor = ii >= @intCast(i64, c.*.sx) && ii < @intCast(i64, c.*.sx) + @intCast(i64, c.*.sw) && jj >= @intCast(i64, c.*.sy) && jj < @intCast(i64, c.*.sy) + @intCast(i64, c.*.sh)
            if inScissor && fx > left && fx < right && fy > top && fy < bottom {
                const sx = ii * 256 + 128
                const sy = jj * 256 + 128
                var inside = true
                var e: usize = 0
                while e < 3 {
                    const a = e
                    const b = (e + 1) % 3
                    const o = (e + 2) % 3
                    const s = cross(px[a], py[a], px[b], py[b], sx, sy)
                    const so = cross(px[a], py[a], px[b], py[b], px[o], py[o])
                    if s == 0 {
                        if !ownsEdge(px[a], py[a], px[b], py[b], px[o], py[o]) { inside = false }
                    } else if (s > 0) != (so > 0) {
                        inside = false
                    }
                    e += 1
                }
                if inside {
                    const l0 = @floatFromInt(f64, cross(px[1], py[1], px[2], py[2], sx, sy)) / w[0]
                    const l1 = @floatFromInt(f64, cross(px[2], py[2], px[0], py[0], sx, sy)) / w[1]
                    const l2 = @floatFromInt(f64, cross(px[0], py[0], px[1], py[1], sx, sy)) / w[2]
                    const total = l0 + l1 + l2
                    const at = j * N + i
                    covered[at] = true
                    want[4 * at] = unorm((l0 * @floatCast(f64, c.*.r[0]) + l1 * @floatCast(f64, c.*.r[1]) + l2 * @floatCast(f64, c.*.r[2])) / total)
                    want[4 * at + 1] = unorm((l0 * @floatCast(f64, c.*.g[0]) + l1 * @floatCast(f64, c.*.g[1]) + l2 * @floatCast(f64, c.*.g[2])) / total)
                    want[4 * at + 2] = unorm((l0 * @floatCast(f64, c.*.b[0]) + l1 * @floatCast(f64, c.*.b[1]) + l2 * @floatCast(f64, c.*.b[2])) / total)
                    want[4 * at + 3] = 255
                }
            }
            i += 1
        }
        j += 1
    }
}
