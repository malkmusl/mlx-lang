// The globals of a program that start zero, of many shapes, beside ones
// that do not, and the checks of tests/512_zero_data_runtime.mlx (a
// dynamically linked program) and tests/support/zero_data_static.mlx (the
// same as a static one): the zero ones are in the program's .bss, in
// memory only (the file is smaller than they are), the writable segment's
// memory size covers them and its file size does not, every byte of them
// reads zero at the start, and the others hold their values, before and
// after the zero ones are written over. `check` says 13 when every check
// holds, else the number of the first that failed.
const std = @import("std")

const fs = std.fs

const Point = struct {
    x: u32
    y: u64
    z: u8
}

const Wide = struct {
    first: [3]u64
    second: Point
    third: [5]u16
}

// Four lanes: aligned to 16, more than a word.
const Lanes = @Vector(4, u32)

// More than the program's file holds: 4 MiB.
const BIG: usize = 4194304

// Zero and undefined ones, each followed by one with a value, so the
// place of every one moves when the zero ones go apart.
var big: [BIG]u8 = undefined
var magic: u64 = 0x1122334455667788
var words: [4096]u64 = undefined
var negative_zero: f64 = -0.0
var zeros: [8]u32 = [8]u32{ 0, 0, 0, 0, 0, 0, 0, 0 }
var mixed: Point = Point.{ .x = 0, .y = 7, .z = 0 }
var origin: Point = Point.{ .x = 0, .y = 0, .z = 0 }
var tail: [4]u8 = [4]u8{ 0, 0, 0, 9 }
var points: [64]Point = undefined
var small: u8 = 5
var counter: u64 = 0
var truth: bool = true
var flag: bool = false
// After a byte and after a word that start zero: each one's place rounded
// up to 16.
var lanes: Lanes = undefined
var tick: u8 = 0
var more_lanes: [2]Lanes = undefined
var half: f32 = 0.5
var real: f64 = 0.0
var pointer: ?*u8 = null
var bytes: []u8 = undefined
var maybe: ?u32 = null
var some: ?u32 = 0
var wide: Wide = undefined
var empty_wide: Wide = Wide.{ .first = [3]u64{ 0, 0, 0 }, .second = Point.{ .x = 0, .y = 0, .z = 0 }, .third = [5]u16{ 0, 0, 0, 0, 0 } }
// An address the start writes into a global whose image is zero.
var first_word: ?[*]u64 = &words[0]
var last: u16 = 0xBEEF

// Bytes of a global.
fn place(address: usize) -> [*]u8 {
    return unsafe { @ptrFromInt([*]u8, address) }
}

// Whether `size` bytes at `address` are all `value`.
fn allAre(address: usize, size: usize, value: u8) -> bool {
    const at = place(address)
    var index: usize = 0
    while index < size {
        if at[index] != value { return false }
        index += 1
    }
    return true
}

fn read16(image: [*]const u8, at: usize) -> usize {
    return @intCast(usize, image[at]) | (@intCast(usize, image[at + 1]) << 8)
}

fn read32(image: [*]const u8, at: usize) -> usize {
    return read16(image, at) | (read16(image, at + 2) << 16)
}

fn read64(image: [*]const u8, at: usize) -> usize {
    return read32(image, at) | (read32(image, at + 4) << 32)
}

// The zero globals: where each is and its size (the 14th, first_word, the
// one the start writes an address into).
const ZERO_COUNT: usize = 17

fn zeroAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(&big) }
    if index == 1 { return @intFromPtr(&words) }
    if index == 2 { return @intFromPtr(&zeros) }
    if index == 3 { return @intFromPtr(&origin) }
    if index == 4 { return @intFromPtr(&points) }
    if index == 5 { return @intFromPtr(&counter) }
    if index == 6 { return @intFromPtr(&flag) }
    if index == 7 { return @intFromPtr(&real) }
    if index == 8 { return @intFromPtr(&pointer) }
    if index == 9 { return @intFromPtr(&bytes) }
    if index == 10 { return @intFromPtr(&maybe) }
    if index == 11 { return @intFromPtr(&wide) }
    if index == 12 { return @intFromPtr(&empty_wide) }
    if index == 13 { return @intFromPtr(&first_word) }
    if index == 14 { return @intFromPtr(&lanes) }
    if index == 15 { return @intFromPtr(&tick) }
    return @intFromPtr(&more_lanes)
}

fn zeroSize(index: usize) -> usize {
    if index == 0 { return @sizeOf([BIG]u8) }
    if index == 1 { return @sizeOf([4096]u64) }
    if index == 2 { return @sizeOf([8]u32) }
    if index == 3 { return @sizeOf(Point) }
    if index == 4 { return @sizeOf([64]Point) }
    if index == 5 { return @sizeOf(u64) }
    if index == 6 { return @sizeOf(bool) }
    if index == 7 { return @sizeOf(f64) }
    if index == 8 { return @sizeOf(?*u8) }
    if index == 9 { return @sizeOf([]u8) }
    if index == 10 { return @sizeOf(?u32) }
    if index == 11 { return @sizeOf(Wide) }
    if index == 12 { return @sizeOf(Wide) }
    if index == 13 { return @sizeOf(?[*]u64) }
    if index == 14 { return @sizeOf(Lanes) }
    if index == 15 { return @sizeOf(u8) }
    return @sizeOf([2]Lanes)
}

// The ones with a value: where each is and its size.
const VALUE_COUNT: usize = 9

fn valueAddress(index: usize) -> usize {
    if index == 0 { return @intFromPtr(&magic) }
    if index == 1 { return @intFromPtr(&negative_zero) }
    if index == 2 { return @intFromPtr(&mixed) }
    if index == 3 { return @intFromPtr(&tail) }
    if index == 4 { return @intFromPtr(&small) }
    if index == 5 { return @intFromPtr(&truth) }
    if index == 6 { return @intFromPtr(&half) }
    if index == 7 { return @intFromPtr(&some) }
    return @intFromPtr(&last)
}

fn valueSize(index: usize) -> usize {
    if index == 0 { return @sizeOf(u64) }
    if index == 1 { return @sizeOf(f64) }
    if index == 2 { return @sizeOf(Point) }
    if index == 3 { return @sizeOf([4]u8) }
    if index == 4 { return @sizeOf(u8) }
    if index == 5 { return @sizeOf(bool) }
    if index == 6 { return @sizeOf(f32) }
    if index == 7 { return @sizeOf(?u32) }
    return @sizeOf(u16)
}

// The globals with a value hold it.
fn valuesHold() -> bool {
    if magic != 0x1122334455667788 { return false }
    if @bitCast(u64, negative_zero) != 0x8000000000000000 { return false }
    if mixed.x != 0 || mixed.y != 7 || mixed.z != 0 { return false }
    if tail[0] != 0 || tail[1] != 0 || tail[2] != 0 || tail[3] != 9 { return false }
    if small != 5 || !truth || half != 0.5 { return false }
    if some == null || some.? != 0 { return false }
    return last == 0xBEEF
}

// A section's header by its name; 0 when there is none.
fn sectionNamed(image: [*]const u8, size: usize, name: []const u8) -> usize {
    const headers = read64(image, 40)
    const count = read16(image, 60)
    const names_header = headers + read16(image, 62) * 64
    if headers + count * 64 > size || names_header + 64 > size { return 0 }
    const names = read64(image, names_header + 24)
    var index: usize = 1
    while index < count {
        const header = headers + index * 64
        const at = names + read32(image, header)
        var same = at + name.length < size && image[at + name.length] == 0
        var k: usize = 0
        while same && k < name.length {
            if image[at + k] != name[k] { same = false }
            k += 1
        }
        if same { return header }
        index += 1
    }
    return 0
}

pub fn check() -> u8 {
    // Every byte of the zero ones reads zero at the start, the others
    // hold their values, and the start wrote its address.
    var index: usize = 0
    var zero_total: usize = 0
    while index < ZERO_COUNT {
        if index != 13 && !allAre(zeroAddress(index), zeroSize(index), 0) { return 1 }
        zero_total += zeroSize(index)
        index += 1
    }
    if first_word == null || @intFromPtr(first_word.?) != @intFromPtr(&words) { return 2 }
    // Those aligned beyond a word at their alignment.
    if @intFromPtr(&lanes) % @alignOf(Lanes) != 0 || @intFromPtr(&more_lanes) % @alignOf(Lanes) != 0 { return 22 }
    if !valuesHold() { return 3 }

    // The program's file: smaller than its zero globals.
    var own: [4096]u8 = undefined
    const own_bytes: [*]u8 = &own
    if fs.executablePath(own_bytes, 4096) == 0 { return 4 }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const loaded = fs.readFileAlloc(own_bytes, allocator)
    if loaded == null { return 5 }
    const file = loaded.?
    const image: [*]const u8 = file.items
    const size = file.length
    if size < 64 || image[0] != 127 || image[1] != 69 || image[4] != 2 { return 6 }
    if size >= BIG { return 7 }

    // The writable segment: its memory goes on past its file bytes, over
    // every zero global; the others are in its file bytes.
    const program_headers = read64(image, 32)
    const program_count = read16(image, 56)
    var segment: usize = 0
    var k: usize = 0
    while k < program_count {
        const header = program_headers + k * 56
        if read32(image, header) == 1 && read32(image, header + 4) & 2 != 0 { segment = header }
        k += 1
    }
    if segment == 0 { return 8 }
    const segment_start = read64(image, segment + 16)
    const file_end = segment_start + read64(image, segment + 32)
    const memory_end = segment_start + read64(image, segment + 40)
    if memory_end < file_end + zero_total { return 9 }
    if read64(image, segment + 8) + read64(image, segment + 32) > size { return 10 }

    // .bss: no bits in the file, allocated and writable, after the file's
    // part of the segment and to its memory's end; .data in the file.
    const zero_section = sectionNamed(image, size, ".bss")
    const data_section = sectionNamed(image, size, ".data")
    if zero_section == 0 || data_section == 0 { return 11 }
    if read32(image, zero_section + 4) != 8 || read64(image, zero_section + 8) != 3 { return 12 }
    if read32(image, data_section + 4) != 1 || read64(image, data_section + 8) != 3 { return 14 }
    const zero_start = read64(image, zero_section + 16)
    const zero_end = zero_start + read64(image, zero_section + 32)
    const data_start = read64(image, data_section + 16)
    const data_end = data_start + read64(image, data_section + 32)
    if zero_start < file_end || zero_end != memory_end { return 15 }
    if data_start < segment_start || data_end > file_end { return 16 }
    if read64(image, data_section + 32) >= BIG { return 17 }
    // .bss says the alignment its start has: that of its most aligned
    // global at least.
    const zero_alignment = read64(image, zero_section + 48)
    if zero_alignment < @alignOf(Lanes) || zero_start % zero_alignment != 0 { return 23 }

    // Each zero global in .bss, each other one in .data.
    index = 0
    while index < ZERO_COUNT {
        if zeroAddress(index) < zero_start || zeroAddress(index) + zeroSize(index) > zero_end { return 18 }
        index += 1
    }
    index = 0
    while index < VALUE_COUNT {
        if valueAddress(index) < data_start || valueAddress(index) + valueSize(index) > data_end { return 19 }
        index += 1
    }
    fs.ArrayList.deinit(file)

    // Written over, the zero ones hold what was written and none of the
    // others changed: nothing overlaps.
    index = 0
    while index < ZERO_COUNT {
        const at = place(zeroAddress(index))
        var byte: usize = 0
        while byte < zeroSize(index) {
            at[byte] = 0xA5
            byte += 1
        }
        index += 1
    }
    if !valuesHold() { return 20 }
    index = 0
    while index < ZERO_COUNT {
        if !allAre(zeroAddress(index), zeroSize(index), 0xA5) { return 21 }
        index += 1
    }
    return 13
}
