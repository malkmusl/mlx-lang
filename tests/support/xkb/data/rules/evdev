// Rules for the test data: one or two layouts, two options.
! model = keycodes
  * = evdev

! model = types
  * = complete

! model = compat
  * = complete

! model layout = symbols
  * * = pc+%l%(v)

! model layout[1] = symbols
  * * = pc+%l[1]%(v[1])

! model layout[2] = symbols
  * * = +%l[2]%(v[2]):2

! option = symbols
  grp:caps_toggle = +group(caps_toggle)
  lv3:lsgt_latch = +level3(lsgt_latch)
