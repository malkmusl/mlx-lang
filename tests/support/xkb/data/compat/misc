xkb_compatibility "misc" {
    interpret ISO_Level3_Latch+Any {
        useModMapMods = level1;
        virtualModifier = LevelThree;
        action = LatchMods(modifiers=LevelThree,latchToLock);
    };
    // Augmented: Caps Lock keeps locking.
    interpret Caps_Lock {
        action = SetMods(modifiers=Shift);
    };
};
