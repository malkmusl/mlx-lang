default partial alphanumeric_keys
xkb_symbols "basic" {
    name[Group1] = "English (US)";
    key <AE01> { [ 1, exclam ] };
    key <AE02> { [ 2, at ] };
    key <AD01> { [ q, Q ] };
    key <AD02> { [ w, W ] };
    key <AC01> { [ a, A ] };
    key <AB01> { [ z, Z ] };
    key <LSGT> { [ less, greater ] };
};

// Defaults for the keys after them, augment, replace, an alias.
partial alphanumeric_keys
xkb_symbols "intl" {
    include "us(basic)"
    name[Group1] = "English (US, intl.)";
    key.type[Group1] = "FOUR_LEVEL";
    key <AE01> { [ 1, exclam, onesuperior, exclamdown ] };
    key <AD01> { type[Group1] = "FOUR_LEVEL_ALPHABETIC", [ q, Q, adiaeresis, Adiaeresis ] };
    augment key <AE02> { [ 9, parenleft, twosuperior ] };
    replace key <LSGT> { [ bar ] };
    key <AC12> { [ w, W, aring, Aring ] };
    include "level3(ralt_switch)"
};
