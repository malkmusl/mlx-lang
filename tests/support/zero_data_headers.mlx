// The headers of an image mlx4 wrote, read from its file, for what test
// 512 cannot run on the host (tests/run_std_modules.sh runs it on each):
//
//   zero_data_headers FILE BYTES   FILE keeps at least BYTES of globals
//                                  that start zero in a .bss
//   zero_data_headers FILE none    FILE has no .bss (a kernel's: every
//                                  global in its file)
//
// With a .bss: the section names are whole (e_shstrndx names .shstrtab,
// every name ends inside it); .bss is SHT_NOBITS, allocated and writable,
// aligned, at the file offset its segment's mapping gives its address,
// from the end of the writable PT_LOAD's file bytes to the end of its
// memory, and the memory goes on past the file bytes by BYTES at least;
// .data is in the file bytes; each data symbol of .dynsym lies in the
// section it names, .data or .bss; the version sections keep their names.
// Without: no .bss, and every PT_LOAD's memory size is its file size.
// Exits 13 when all of that holds, else the number of the first check
// that failed.
const std = @import("std")

const fs = std.fs

const SHT_PROGBITS: usize = 1
const SHT_STRTAB: usize = 3
const SHT_NOBITS: usize = 8
const SHT_DYNSYM: usize = 11
const SHT_GNU_VERDEF: usize = 0x6FFFFFFD
const SHT_GNU_VERSYM: usize = 0x6FFFFFFF
const ALLOCATED_AND_WRITABLE: usize = 3
const STT_OBJECT: usize = 1

fn read16(image: [*]const u8, at: usize) -> usize {
    return @intCast(usize, image[at]) | (@intCast(usize, image[at + 1]) << 8)
}

fn read32(image: [*]const u8, at: usize) -> usize {
    return read16(image, at) | (read16(image, at + 2) << 16)
}

fn read64(image: [*]const u8, at: usize) -> usize {
    return read32(image, at) | (read32(image, at + 4) << 32)
}

// The image and what its headers say, read once.
const Image = struct {
    bytes: [*]const u8
    size: usize
    sections: usize
    count: usize
    names: usize
    namesSize: usize
}

fn header(image: Image, index: usize) -> usize { return image.sections + index * 64 }

// Whether section `index` is called `name`.
fn named(image: Image, index: usize, name: []const u8) -> bool {
    const at = read32(image.bytes, header(image, index))
    if at + name.length >= image.namesSize { return false }
    var k: usize = 0
    while k < name.length {
        if image.bytes[image.names + at + k] != name[k] { return false }
        k += 1
    }
    return image.bytes[image.names + at + name.length] == 0
}

// The index of the section called `name`; 0 when there is none.
fn sectionNamed(image: Image, name: []const u8) -> usize {
    var index: usize = 1
    while index < image.count {
        if named(image, index, name) { return index }
        index += 1
    }
    return 0
}

// The writable PT_LOAD's header; 0 when there is none.
fn writableSegment(image: Image) -> usize {
    const headers = read64(image.bytes, 32)
    var k: usize = 0
    var found: usize = 0
    while k < read16(image.bytes, 56) {
        const at = headers + k * 56
        if read32(image.bytes, at) == 1 && read32(image.bytes, at + 4) & 2 != 0 { found = at }
        k += 1
    }
    return found
}

// A decimal number; 0 for none.
fn decimal(text: [*]const u8) -> usize {
    var value: usize = 0
    var k: usize = 0
    while text[k] >= 48 && text[k] <= 57 {
        value = value * 10 + @intCast(usize, text[k] - 48)
        k += 1
    }
    return value
}

// Without a .bss: none named so, and each PT_LOAD all in its file.
fn checkNone(image: Image) -> u8 {
    if sectionNamed(image, ".bss") != 0 { return 20 }
    const headers = read64(image.bytes, 32)
    var k: usize = 0
    while k < read16(image.bytes, 56) {
        const at = headers + k * 56
        if read32(image.bytes, at) == 1 && read64(image.bytes, at + 32) != read64(image.bytes, at + 40) { return 21 }
        k += 1
    }
    return 13
}

fn checkZero(image: Image, least: usize) -> u8 {
    const segment = writableSegment(image)
    if segment == 0 { return 30 }
    const segment_offset = read64(image.bytes, segment + 8)
    const segment_address = read64(image.bytes, segment + 16)
    const file_end = segment_address + read64(image.bytes, segment + 32)
    const memory_end = segment_address + read64(image.bytes, segment + 40)
    if memory_end < file_end + least { return 31 }

    const zero = sectionNamed(image, ".bss")
    if zero == 0 { return 32 }
    const at = header(image, zero)
    if read32(image.bytes, at + 4) != SHT_NOBITS || read64(image.bytes, at + 8) != ALLOCATED_AND_WRITABLE { return 33 }
    const zero_address = read64(image.bytes, at + 16)
    const zero_size = read64(image.bytes, at + 32)
    const alignment = read64(image.bytes, at + 48)
    if alignment < 8 || alignment & (alignment - 1) != 0 || zero_address % alignment != 0 { return 34 }
    // (At the offset the segment's mapping gives its address.)
    if read64(image.bytes, at + 24) != segment_offset + (zero_address - segment_address) { return 35 }
    if zero_address < file_end || zero_address + zero_size != memory_end || zero_size < least { return 36 }

    const data = sectionNamed(image, ".data")
    if data == 0 { return 37 }
    const data_at = header(image, data)
    if read32(image.bytes, data_at + 4) != SHT_PROGBITS || read64(image.bytes, data_at + 8) != ALLOCATED_AND_WRITABLE { return 38 }
    if read64(image.bytes, data_at + 16) < segment_address || read64(image.bytes, data_at + 16) + read64(image.bytes, data_at + 32) > file_end { return 39 }

    // The data symbols of .dynsym, each in the section it names.
    const symbols = sectionNamed(image, ".dynsym")
    if symbols != 0 {
        const symbols_at = header(image, symbols)
        if read32(image.bytes, symbols_at + 4) != SHT_DYNSYM { return 40 }
        const first = read64(image.bytes, symbols_at + 24)
        const count = read64(image.bytes, symbols_at + 32) / 24
        var index: usize = 1
        while index < count {
            const symbol = first + index * 24
            const section = read16(image.bytes, symbol + 6)
            if @intCast(usize, image.bytes[symbol + 4] & 15) == STT_OBJECT {
                if section != data && section != zero { return 41 }
                const place = header(image, section)
                const start = read64(image.bytes, place + 16)
                const end = start + read64(image.bytes, place + 32)
                const value = read64(image.bytes, symbol + 8)
                if value < start || value + read64(image.bytes, symbol + 16) > end { return 42 }
            }
            index += 1
        }
    }

    // The version sections, when there are any, under their own names.
    var index: usize = 1
    while index < image.count {
        const kind = read32(image.bytes, header(image, index) + 4)
        if kind == SHT_GNU_VERSYM && !named(image, index, ".gnu.version") { return 43 }
        if kind == SHT_GNU_VERDEF && !named(image, index, ".gnu.version_d") { return 44 }
        index += 1
    }
    return 13
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 { return 2 }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const loaded = fs.readFileAlloc(arguments[1], allocator)
    if loaded == null { return 3 }
    const file = loaded.?
    const bytes: [*]const u8 = file.items
    const size = file.length
    if size < 64 || bytes[0] != 127 || bytes[1] != 69 || bytes[2] != 76 || bytes[3] != 70 || bytes[4] != 2 { return 4 }

    // The section names: whole, and their own section called .shstrtab.
    const sections = read64(bytes, 40)
    const count = read16(bytes, 60)
    const names_index = read16(bytes, 62)
    if sections + count * 64 > size || names_index == 0 || names_index >= count { return 5 }
    const names_at = sections + names_index * 64
    var image = Image.{ .bytes = bytes, .size = size, .sections = sections, .count = count, .names = read64(bytes, names_at + 24), .namesSize = read64(bytes, names_at + 32) }
    if read32(bytes, names_at + 4) != SHT_STRTAB || image.names + image.namesSize > size { return 6 }
    if image.namesSize == 0 || bytes[image.names + image.namesSize - 1] != 0 { return 7 }
    if !named(image, names_index, ".shstrtab") { return 8 }
    var index: usize = 1
    while index < count {
        if read32(bytes, header(image, index)) >= image.namesSize { return 9 }
        index += 1
    }

    const mode = arguments[2]
    if mode[0] == 110 { return checkNone(image) }
    const least = decimal(mode)
    if least == 0 { return 10 }
    return checkZero(image, least)
}
