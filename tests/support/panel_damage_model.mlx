// tools/check_brix_draw.sh: what std.ui's panel tells its compositor
// (std/src/ui/wayland/panel_damage.mlx), without a compositor. The steps
// of panel.redraw (pickSlot, bringUp, the draw, changed, given) on a Panel
// record whose two slots are plain memory, against a compositor as kepler's
// CPU renderer is one: it keeps a copy of the surface and takes of each
// buffer only what the damage says. It lets a buffer go at once, or after
// a few frames, or when the next one came (a renderer that shows buffers
// in place), and now and then takes a buffer whole (its copy was gone).
//
// Three clients, 200000 frames each, of pictures that change in boxes at
// chance, not at all, or everywhere, with new buffers of another size and
// surfaces hidden in between:
// - one that keeps its frames: where `kept` says so the canvas must hold
//   what its last draw left; it draws what changed and names it, or says
//   that nothing did;
// - one that draws every frame whole and names nothing (the comparison
//   with the frame before finds the damage);
// - one that draws whole and names what changed.
// After every frame given, and after every frame said to change nothing,
// the compositor's copy must be the picture the client means to show: a
// rectangle too small, a slot not brought up to date or a comparison that
// stops early leaves old pixels in it.
// Exits 13.
const std = @import("std")
const panel_module = @import("std.ui.wayland.panel")
const damage_module = @import("std.ui.wayland.panel_damage")

const Panel = panel_module.Panel

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var seed: u64 = 2685821657736338717 // (per run)

fn chance() -> u64 {
    seed = seed ^ (seed << 13)
    seed = seed ^ (seed >> 7)
    seed = seed ^ (seed << 17)
    return seed
}

fn below(limit: usize) -> usize { return @intCast(usize, chance() % @intCast(u64, limit)) }

const MOST: usize = 48 * 40

// The two slots (with room to lie apart, as two pools do), the picture
// meant, what the keeping client's last draw left, the compositor's copy.
var slots: [MOST * 2 + 64]u32 = undefined // (per run)
var other_pool: [MOST + 8]u32 = undefined // (per run)
var meant: [MOST]u32 = undefined // (per run)
var drawn: [MOST]u32 = undefined // (per run)
var copy: [MOST]u32 = undefined // (per run)

// The panel's record: only what panel_damage.mlx reads of it is set.
var panel_bytes: [65536]u8 = undefined // (per run)

fn pixelsOf(panel: *Panel, slot: usize) -> [*]u32 {
    unsafe { return @ptrFromInt([*]u32, panel_module.slotAddress(panel, slot)) }
}

// New buffers of another size (odd widths and one pixel among them),
// whatever in them, in one pool or in two.
fn resize(panel: *Panel) -> void {
    panel.*.width = 1 + below(48)
    panel.*.height = 1 + below(40)
    panel.*.slotBytes = panel.*.width * panel.*.height * 4 + below(3) * 4
    panel.*.second = below(3) == 0
    panel.*.memory.address = @intFromPtr(&slots) + below(2) * 4
    panel.*.secondMemory.address = @intFromPtr(&other_pool) + below(2) * 4
    panel.*.busy[0] = false
    panel.*.busy[1] = false
    damage_module.forget(panel)
    var index: usize = 0
    while index < MOST * 2 + 64 {
        slots[index] = @intCast(u32, chance() >> 32)
        index += 1
    }
    index = 0
    while index < MOST + 8 {
        other_pool[index] = @intCast(u32, chance() >> 32)
        index += 1
    }
}

// The picture meant changes: not at all, in a few boxes, or everywhere.
fn change(panel: *Panel) -> void {
    const width = panel.*.width
    const height = panel.*.height
    const pick = below(10)
    if pick == 0 { return }
    if pick == 1 {
        var index: usize = 0
        while index < width * height {
            meant[index] = @intCast(u32, chance() >> 32)
            index += 1
        }
        return
    }
    var boxes = 1 + below(3)
    while boxes > 0 {
        const left = below(width)
        const top = below(height)
        const columns = 1 + below(width - left)
        const rows = 1 + below(if below(2) == 0 { height - top } else { 1 })
        // (Often what was there already: a box drawn again as it was.)
        const value = if below(4) == 0 { meant[top * width + left] } else { @intCast(u32, chance() >> 32) }
        var row = top
        while row < top + rows && row < height {
            var column = left
            while column < left + columns {
                meant[row * width + column] = value
                column += 1
            }
            row += 1
        }
        boxes -= 1
    }
}

// What the compositor takes of the buffer in `slot`: this rectangle.
fn take(panel: *Panel, slot: usize, x: i32, y: i32, width: i32, height: i32) -> void {
    const pixels = pixelsOf(panel, slot)
    const wide = @intCast(i32, panel.*.width)
    const high = @intCast(i32, panel.*.height)
    var row = if y < 0 { 0 } else { y }
    while row < y + height && row < high {
        var column = if x < 0 { 0 } else { x }
        while column < x + width && column < wide {
            const at = @intCast(usize, row) * panel.*.width + @intCast(usize, column)
            copy[at] = pixels[at]
            column += 1
        }
        row += 1
    }
}

const KEEPING: usize = 0
const COMPARING: usize = 1
const NAMING: usize = 2

fn copyIsThePicture(panel: *Panel) -> bool {
    var index: usize = 0
    while index < panel.*.width * panel.*.height {
        if copy[index] != meant[index] { return false }
        index += 1
    }
    return true
}

fn run(kind: usize, rounds: usize) -> u8 {
    if @sizeOf(Panel) > 65536 { return 1 }
    const panel: *Panel = unsafe { @ptrCast(*Panel, &panel_bytes) }
    var index: usize = 0
    while index < 65536 {
        panel_bytes[index] = 0
        index += 1
    }
    panel.*.frames = panel_module.FRAMES_CPU
    panel.*.keepsFrames = kind == KEEPING
    resize(panel)
    index = 0
    while index < MOST {
        meant[index] = @intCast(u32, chance() >> 32)
        index += 1
    }
    // How the compositor holds buffers (0: lets go at once; 1: after a
    // few frames; 2: when the next one replaced it), and for how many
    // frames more each slot is held.
    var holds = below(3)
    var hold: [2]usize = [2]usize{ 0, 0 }
    var given_frames: usize = 0
    var parts: usize = 0
    var nothings: usize = 0
    var round: usize = 0
    while round < rounds {
        if below(400) == 0 { resize(panel) }
        if below(700) == 0 { damage_module.forget(panel) }
        if below(300) == 0 { holds = below(3) }
        var held: usize = 0
        while held < 2 {
            if hold[held] > 0 {
                hold[held] -= 1
                if hold[held] == 0 { panel.*.busy[held] = false }
            }
            held += 1
        }
        change(panel)
        const width = panel.*.width
        const height = panel.*.height
        const picked = damage_module.pickSlot(panel)
        if picked < 0 {
            round += 1
            continue
        }
        const slot = @intCast(usize, picked)
        if panel.*.busy[slot] {
            say("FAIL a slot the compositor holds was picked to draw into\n")
            return 2
        }
        panel.*.damageCount = 0
        panel.*.damageAll = false
        panel.*.damageNone = false
        damage_module.bringUp(panel, slot)
        const pixels = pixelsOf(panel, slot)
        if below(40) == 0 { panel.*.owesCommit = true }
        // The draw.
        if kind == KEEPING && panel.*.kept {
            var left = width
            var top = height
            var right: usize = 0
            var bottom: usize = 0
            index = 0
            while index < width * height {
                if pixels[index] != drawn[index] {
                    say("FAIL kept is true and the canvas does not hold the frame drawn last\n")
                    return 3
                }
                if meant[index] != drawn[index] {
                    pixels[index] = meant[index]
                    const x = index % width
                    const y = index / width
                    if x < left { left = x }
                    if x + 1 > right { right = x + 1 }
                    if y < top { top = y }
                    if y + 1 > bottom { bottom = y + 1 }
                }
                index += 1
            }
            if right > left {
                panel_module.damage(panel, @intCast(i32, left), @intCast(i32, top), @intCast(i32, right - left), @intCast(i32, bottom - top))
            } else {
                panel_module.unchanged(panel)
            }
        } else {
            index = 0
            while index < width * height {
                pixels[index] = meant[index]
                index += 1
            }
            if kind == KEEPING {
                panel_module.damage(panel, 0, 0, @intCast(i32, width), @intCast(i32, height))
            } else if kind == NAMING && given_frames > 0 && panel.*.keptSlot >= 0 {
                // What changed since the frame given last, in two boxes:
                // the upper and the lower half of the rows that differ.
                var first: usize = height
                var last: usize = 0
                index = 0
                while index < width * height {
                    if meant[index] != copy[index] {
                        if index / width < first { first = index / width }
                        last = index / width + 1
                    }
                    index += 1
                }
                if last > first {
                    const middle = first + (last - first) / 2
                    panel_module.damage(panel, 0, @intCast(i32, first), @intCast(i32, width), @intCast(i32, middle - first))
                    panel_module.damage(panel, 0, @intCast(i32, middle), @intCast(i32, width), @intCast(i32, last - middle))
                }
            }
        }
        if kind == KEEPING {
            index = 0
            while index < width * height {
                drawn[index] = meant[index]
                index += 1
            }
        }
        panel.*.kept = false
        // After the draw, as panel.redraw has it.
        var part: [4]i32 = [4]i32{ 0, 0, @intCast(i32, width), @intCast(i32, height) }
        var changed = damage_module.changed(panel, slot, &part)
        if changed == damage_module.NOTHING {
            nothings += 1
            if !panel.*.owesCommit {
                if given_frames > 0 && panel.*.keptSlot >= 0 && !copyIsThePicture(panel) {
                    say("FAIL a frame said to change nothing was not given, and the compositor's copy is not the picture\n")
                    return 4
                }
                round += 1
                continue
            }
            changed = damage_module.SAME
            part = [4]i32{ 0, 0, 1, 1 }
        }
        panel.*.owesCommit = false
        panel.*.busy[slot] = true
        // The compositor: all of the buffer for a first frame, where the
        // client says so, and now and then whatever the damage.
        if changed == damage_module.ALL || given_frames == 0 || panel.*.keptSlot < 0 || below(60) == 0 {
            take(panel, slot, 0, 0, @intCast(i32, width), @intCast(i32, height))
        } else if changed == damage_module.NAMED {
            var rect: usize = 0
            while rect < panel.*.damageCount {
                take(panel, slot, panel.*.damageRects[rect * 4], panel.*.damageRects[rect * 4 + 1], panel.*.damageRects[rect * 4 + 2], panel.*.damageRects[rect * 4 + 3])
                rect += 1
            }
            parts += 1
        } else {
            take(panel, slot, part[0], part[1], part[2], part[3])
            parts += 1
        }
        damage_module.given(panel, slot, changed, &part)
        given_frames += 1
        if holds == 0 {
            panel.*.busy[slot] = false
        } else if holds == 1 {
            hold[slot] = 1 + below(3)
        } else {
            hold[slot] = 0
            if panel.*.busy[1 - slot] && below(4) != 0 { hold[1 - slot] = 1 }
        }
        if !copyIsThePicture(panel) {
            say(if kind == KEEPING { "FAIL a client that keeps its frames: " } else if kind == COMPARING { "FAIL a client that names nothing: " } else { "FAIL a client that names its damage: " })
            say("after a frame the compositor's copy is not the picture\n")
            return 5
        }
        round += 1
    }
    // (Frames of parts were among them, and frames of nothing.)
    if parts < rounds / 20 { return 6 }
    if kind == KEEPING && nothings < rounds / 100 { return 7 }
    return 0
}

pub fn main() -> u8 {
    var status = run(KEEPING, 200000)
    if status != 0 { return status }
    status = run(COMPARING, 200000)
    if status != 0 { return status }
    status = run(NAMING, 200000)
    if status != 0 { return status }
    return 13
}
