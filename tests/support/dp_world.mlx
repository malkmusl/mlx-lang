// The user's whole Radeon as a table with a DisplayPort monitor behind an
// AUX channel (tests/support/dpswitch_card.mlx), and the kernel's side put
// together as gpu.mlx and gpu_together.mlx put it: the boot, the timer's
// ticks, what they found due made on the trap's way back; for the tests
// of what the DisplayPort switch's review left open (tests/513_gpu_dp_
// fallback_runtime.mlx, 514_gpu_dp_adapter_runtime.mlx). As tests/510's
// own, with what gpu.mlx does beside it now: a passive adapter looked for
// over a DisplayPort connector's DDC line (gpu_dpwatch.mlx's `useDdc`),
// and the boot's plan made again for the link that remains after a
// training fell back (gpu.mlx's `planAgain`).
// Nothing of a real card's ROM or of a real monitor is in here.
const std = @import("std")
const scanout = @import("../../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../../projects/brix/kernel/edid.mlx")
const mode = @import("../../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../../projects/brix/kernel/gpu_set.mlx")
const atom = @import("../../projects/brix/kernel/atom.mlx")
const videorom = @import("../../projects/brix/kernel/gpu_rom.mlx")
const plug = @import("../../projects/brix/kernel/gpu_plug.mlx")
const ddc = @import("../../projects/brix/kernel/gpu_ddc.mlx")
const aux = @import("../../projects/brix/kernel/gpu_aux.mlx")
const dplink = @import("../../projects/brix/kernel/gpu_link.mlx")
const rule = @import("../../projects/brix/kernel/gpu_switch.mlx")
const changing = @import("../../projects/brix/kernel/gpu_change.mlx")
const together = @import("../../projects/brix/kernel/gpu_together.mlx")
const dpwatch = @import("../../projects/brix/kernel/gpu_dpwatch.mlx")
const dm = @import("../../projects/brix/kernel/display_modes.mlx")
const rom = @import("./atom_rom.mlx")
const display = @import("./tmds_card.mlx")
const lines = @import("./plug_card.mlx")
const sw = @import("./switch_card.mlx")
const sink = @import("./dp_monitor.mlx")
const card = @import("./dpswitch_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

// ---- What a test expects, and the log.
pub var show = false
pub var failed: u8 = 0
pub var name: []const u8 = undefined

pub fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected (")
    say(name)
    say("): ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

pub fn line(text: []const u8) -> void { expect(display.has(text), text) }

pub fn once(text: []const u8) -> void { expect(display.count(text) == 1, text) }

pub fn noLine(text: []const u8) -> void {
    if !display.has(text) { return }
    say("said, but should not be (")
    say(name)
    say("): ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

pub fn named(title: []const u8) -> void {
    name = title
    if show {
        say("-- ")
        say(title)
        say("\n")
    }
}

fn logWrite(text: []const u8) -> void {
    display.logWrite(text)
    if show { say(text) }
}

pub const MS: usize = 1000000
pub const NEVER: usize = 0xFFFFFFFF

pub fn out() -> scanout.Card { return scanout.Card.{ .read = card.read, .now = sw.now, .write = logWrite } }

// ---- The ROM and what is read of it (the user's five connectors).
var builder: rom.Builder = undefined
pub var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
pub var board: videorom.Board = undefined
pub var information: videorom.Firmware = undefined

// ---- The EDIDs: the user's (3840x1080 at 270270 kHz, 4040 by 1115, its
// HDMI block in the extension), the user's with a second timing of its
// size (3840x1080 at 30 Hz, 135140 kHz), and a monitor of 1920x1080 alone
// at 148500 kHz (one block, no HDMI block).
pub var users: [256]u8 = undefined
pub var twoRates: [256]u8 = undefined
pub var small: [256]u8 = undefined

fn resum(bytes: []u8, block: usize) -> void {
    var sum: usize = 0
    var k: usize = 0
    while k < 127 {
        sum += @intCast(usize, bytes[block * 128 + k])
        k += 1
    }
    bytes[block * 128 + 127] = @intCast(u8, (256 - (sum & 0xFF)) & 0xFF)
}

fn makeEdids() -> void {
    _ = lines.edid(users[0..], 2, true)
    const wide = [_]u8{ 0x93, 0x69, 0x00, 0xC8, 0xF0, 0x38, 0x23, 0x40, 48, 32, 0x35, 0x00 }
    var k: usize = 0
    while k < 12 {
        users[54 + k] = wide[k]
        k += 1
    }
    users[71] = 0x1A
    users[38] = 0xD1
    users[39] = 0xC0
    users[40] = 0x81
    users[41] = 0xC0
    resum(users[0..], 0)
    k = 0
    while k < 256 {
        twoRates[k] = users[k]
        k += 1
    }
    k = 0
    while k < 18 {
        twoRates[72 + k] = users[54 + k]
        k += 1
    }
    twoRates[72] = 0xCA
    twoRates[73] = 0x34
    resum(twoRates[0..], 0)
    _ = lines.edid(small[0..], 1, false)
    // (1920x1080 at 148500 kHz: 2200 by 1125, the CEA-861 timing.)
    const full = [_]u8{ 0x02, 0x3A, 0x80, 0x18, 0x71, 0x38, 0x2D, 0x40, 0x58, 0x2C, 0x45, 0x00 }
    k = 0
    while k < 12 {
        small[54 + k] = full[k]
        k += 1
    }
    small[71] = 0x1E
    small[38] = 0x01
    small[39] = 0x01
    small[40] = 0x01
    small[41] = 0x01
    resum(small[0..], 0)
}

// The world made ready once: the EDIDs, the ROM, what is lent.
pub fn begin(arguments: [][*]const u8) -> void {
    name = "the world made ready"
    show = std.process.count(arguments) > 1
    makeEdids()
    sw.makeRom(&builder, sw.NEVER, display.Ending.plain)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
    lend()
}

// ---- The kernel's side, as gpu.mlx and modes.mlx put it together.
pub var watch: plug.Watch = undefined
pub var verdict: plug.Verdict = undefined
pub var follow: rule.Follow = undefined
pub var decided: rule.Decision = undefined
pub var bootReadout: scanout.Readout = undefined
pub var bootPlan: mode.Plan = undefined
pub var bootResult: set.Result = undefined
pub var memory: scanout.Memory = undefined
pub var seen: changing.Seen = undefined
var machinery: changing.Lent = undefined
var switchLent: rule.Lent = undefined
var lentHands: set.Hands = undefined
var lentTables: set.Tables = undefined
pub var facts: mode.Rom = undefined
var ddcHands: ddc.Hands = undefined
pub var driver: together.Driver = undefined
var watching = false
pub var state: dm.State = undefined
var stateDriver: dm.Driver = undefined
pub var sinks: dpwatch.Sinks = undefined
var auxCard: scanout.Card = undefined
const BASE: usize = 0xD0000000
// Whether the boot lends the I2C engine for adapters (gpu.mlx does).
pub var adapters = true
// How often the boot's plan was made again for the link that remains.
pub var replans: usize = 0

fn hold() -> usize { return 0 }

fn release() -> void {}

fn stateJudge(which: usize, asked: *dm.Mode) -> void { together.judge(&driver, asked) }

fn picture(result: dm.Set, into: *dm.Picture) -> dm.Set {
    if result != dm.Set.done { return result }
    into.*.address = BASE + seen.plan.offset
    into.*.width = seen.plan.width
    into.*.height = seen.plan.height
    into.*.pitch = seen.plan.pitch * 4
    return result
}

fn stateSet(which: usize, asked: *const dm.Mode, into: *dm.Picture) -> dm.Set {
    if !asked.*.timed { return dm.Set.refused }
    return picture(together.set(&driver, &asked.*.timing), into)
}

fn stateBack(which: usize, before: *const dm.Mode, into: *dm.Picture) -> dm.Set { return picture(together.back(&driver, before), into) }

fn lend() -> void {
    lentHands = set.Hands.{ .write = card.write, .clear = display.clear }
    lentTables = set.Tables.{ .machine = &machine, .hands = card.hands(), .aside = display.setAside }
    facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    ddcHands = ddc.Hands.{ .write = card.write }
    stateDriver = dm.Driver.{ .kind = dm.Kind.RADEON_TMDS, .which = 0, .timed = true, .anySize = false, .judge = stateJudge, .set = stateSet, .back = stateBack }
    auxCard = out()
}

// The user's card's clocks (the display clock 118032 kHz, the reference
// clock 600 MHz, their tables as the user's ROM rounds, every DTO's
// modulo 600000000).
pub fn asTheUsers() -> void {
    display.store(0x124, 0x1800005D)
    display.clockAtOrBelow = true
    display.referenceAsRom = true
    var c: usize = 0
    while c < 6 {
        display.store(0x142 + 4 * c, 600000000)
        c += 1
    }
}

// The machine as the user's (the firmware's 1280x960 out of the HDMI
// connector 2 by DVI signalling, every line low), the monitor on
// DisplayPort connector `dp` (NEVER: none) with the registers `revision`,
// `rate`, `lanes` and the EDID `bytes`, or on HDMI 2 (`hdmi`).
pub fn usersWith(title: []const u8, dp: usize, hdmi: bool, revision: usize, rate: usize, lanes: usize, bytes: []const u8) -> void {
    if title.length != 0 { named(title) }
    card.reset()
    sw.users(107962, 0)
    card.pull()
    asTheUsers()
    if hdmi {
        sw.monitor(2, bytes)
        sw.line(2, true, sw.NEVER)
    }
    if dp != NEVER { card.dpMonitor(dp, revision, rate, lanes, bytes, true) }
}

fn sinkHeard(k: usize) -> ?*const dplink.Heard {
    if k >= watch.ports.count || !dpwatch.usable(&watch.ports.ports[k]) { return null }
    return &watch.ports.ports[k].dp
}

fn bootAttempt(c: *const scanout.Card) -> void {
    var s = verdict.output
    if decided.act == rule.Act.move {
        const target = rule.targetFor(&watch.ports, &follow, decided, false)
        s = decided.to
        mode.makeMove(c, &bootReadout, &memory, &target, &watch.ports.ports[s].monitor, &watch.ports.ports[s].offer, &facts, sinkHeard(decided.to), sinkHeard(decided.from), &bootPlan)
        mode.say(c, &bootPlan)
        mode.list(c, &bootPlan)
        _ = set.attemptMove(c, &lentHands, &lentTables, dpwatch.channelFor(&sinks, &watch.ports, decided.to), dpwatch.channelFor(&sinks, &watch.ports, decided.from), &bootPlan, true, &bootResult)
    } else if s < watch.ports.count && watch.ports.ports[s].heard.outcome == ddc.Outcome.read {
        mode.makeFor(c, &bootReadout, &memory, &watch.ports.ports[s].monitor, &watch.ports.ports[s].offer, &facts, mode.Wish.own, &bootPlan)
        mode.say(c, &bootPlan)
        _ = set.attemptWith(c, &lentHands, &lentTables, &bootPlan, true, &bootResult)
    } else {
        bootResult.outcome = set.Outcome.untouched
        bootPlan.situation = mode.Situation.none
    }
}

fn unsaid(text: []const u8) -> void {}

// The boot as gpu.mlx makes it (tests/510's, with the adapters and the
// plan made again for the link that remains).
pub fn boot() -> void {
    const c = out()
    const h = ddc.Hands.{ .write = card.write }
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    plug.detect(&watch.ports, &verdict)
    plug.askAtBoot(&c, &h, sw.pause, 6, 100000, &watch.ports, &watch.reader)
    dpwatch.begin(&sinks, aux.Port.{ .card = &auxCard, .write = card.auxWrite }, card.ackWrite, true)
    if adapters { dpwatch.useDdc(&sinks, &ddcHands, sw.pause, 6, 100000, &watch.reading, &board) }
    rule.useSinks(&sinks)
    dpwatch.atBoot(&sinks, &watch.ports)
    decided = rule.atBoot(&c, &watch.ports, &verdict, &follow, rule.How.follows)
    memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
    scanout.report(&c, &memory, &bootReadout)
    replans = 0
    bootAttempt(&c)
    // (gpu.mlx's `planAgain`.)
    while bootResult.outcome != set.Outcome.done && replans < dplink.PLANS_AGAIN && bootPlan.situation == mode.Situation.displayport {
        var record = &watch.ports.ports[if decided.act == rule.Act.move { decided.to } else { verdict.output }].dp
        if !dplink.remains(&c, record, bootResult.remaining) { break }
        const quiet = scanout.Card.{ .read = card.read, .now = sw.now, .write = unsaid }
        scanout.report(&quiet, &memory, &bootReadout)
        replans += 1
        bootAttempt(&c)
    }
    plug.serveAll(&c, &watch.ports)
    var controller: usize = 0
    if bootPlan.situation != mode.Situation.none { controller = bootPlan.controller }
    const showing = plug.servedBy(&watch.ports, controller)
    var bytes: []const u8 = users[0..0]
    if showing != plug.NONE && watch.ports.ports[showing].heard.outcome == ddc.Outcome.read { bytes = watch.ports.ports[showing].heard.data() }
    rule.begin(&follow, follow.how, &watch.ports, controller, memory.pictureWidth, memory.pictureHeight, bytes, 0, 0, 0)
    _ = rule.carried(&c, &follow, &watch.ports, &bootPlan, &bootResult, decided)
    if bootResult.outcome == set.Outcome.done && !bootPlan.move.keep {
        memory.pictureOffset = bootPlan.offset
        memory.pictureBytes = bootPlan.bytes
        memory.pictureWidth = bootPlan.width
        memory.pictureHeight = bootPlan.height
        memory.picturePitch = bootPlan.pitch
    }
    changing.begin(&seen)
    seen.memory = memory
    if showing != plug.NONE { seen.offer = watch.ports.ports[showing].offer }
    machinery = changing.Lent.{ .card = out(), .hands = lentHands, .tables = &lentTables, .rom = facts, .hold = hold, .release = release, .aside = display.setAside }
    display.setAside(true)
    changing.look(&machinery, &seen)
    display.setAside(false)
    switchLent = rule.Lent.{ .hands = &lentHands, .tables = &lentTables, .rom = &facts, .memory = &seen.memory, .readout = &seen.readout, .plan = &seen.plan, .result = &seen.result, .change = &machinery, .seen = &seen }
    watching = true
    driver.card = out()
    driver.watch = &watch
    driver.follow = &follow
    driver.lent = &switchLent
    driver.change = &machinery
    driver.seen = &seen
    driver.hands = &ddcHands
    driver.pause = sw.pause
    driver.watching = &watching
    together.begin(&driver)
    together.useSinks(&driver, &sinks)
    var listed: []const u8 = users[0..128]
    if together.modeEdid(&driver).length != 0 { listed = together.modeEdid(&driver) }
    stateDriver.kind = changing.kindOf(&seen)
    const p = dm.Picture.{ .address = BASE + memory.pictureOffset, .width = memory.pictureWidth, .height = memory.pictureHeight, .pitch = memory.picturePitch * 4 }
    state.begin(&stateDriver, listed, &p, changing.rate(&seen), null)
    listedMonitors = driver.monitors
}

// ---- The timer's ticks (10 ms apart) and what each found due.
var listedMonitors: usize = 0
// How many of the switch's changes were made.
pub var made: usize = 0

fn after() -> void {
    if state.pending && display.clock >= state.deadline { _ = state.tick(display.clock) }
    if together.isDue(&driver) {
        const due = together.carryDue(&driver, &state)
        if due == together.Due.made {
            listedMonitors = driver.monitors
            made += 1
        }
    }
    if driver.monitors != listedMonitors {
        state.relist(together.modeEdid(&driver))
        listedMonitors = driver.monitors
    }
}

pub fn ticks(until: usize) -> void {
    while display.clock < until {
        sw.pass(10 * MS)
        together.tick(&driver)
        after()
    }
}

// ---- What the card shows.
pub fn onDto() -> bool { return display.raw(0x140) & 0x10 != 0 }

pub fn backOn(n: usize) -> bool { return display.raw(scanout.DIG[n] + scanout.DIG_BE_EN_CNTL) & 1 != 0 }

pub fn backMode(n: usize) -> usize { return (display.raw(scanout.DIG[n] + scanout.DIG_BE_CNTL) >> 16) & 7 }

pub fn streamOn(m: usize) -> bool { return display.raw(scanout.DIG[m] + scanout.DP_VID_STREAM_CNTL) & 1 != 0 }

pub fn locked(lanes: usize) -> bool {
    var k: usize = 0
    while k < lanes {
        if !sink.lockOf[k] { return false }
        k += 1
    }
    return true
}

// The early blanking controller 0 runs with (CRTC_CONTROL's bits 20 to 22).
pub fn early() -> usize { return (display.raw(scanout.CRTC_CONTROL) >> 20) & 7 }

// The table runs the card saw, in order, from write `from` on: each one's
// table and its first two words.
const RUNS: usize = 256
pub var runTable: [RUNS]usize = undefined
pub var runWord0: [RUNS]usize = undefined
pub var runWord1: [RUNS]usize = undefined
pub var runCount: usize = 0

pub fn collectRuns(from: usize) -> void {
    runCount = 0
    var w0: usize = 0
    var w1: usize = 0
    var k = from
    while k < display.written && k < display.WRITES {
        if display.writtenByTable[k] && display.writtenTo[k] == display.MAIL { w0 = display.writtenWith[k] }
        if display.writtenByTable[k] && display.writtenTo[k] == display.MAIL + 1 { w1 = display.writtenWith[k] }
        if display.writtenByTable[k] && display.writtenTo[k] == display.GO && runCount < RUNS {
            runTable[runCount] = display.writtenWith[k]
            runWord0[runCount] = w0
            runWord1[runCount] = w1
            runCount += 1
        }
        k += 1
    }
}

// Where the first run of table `table` stands whose word 0 has `value` in
// its bits `mask` and whose word 1 has `value1` in its bits `mask1`, from
// `from` on (NEVER: none).
pub fn runOf(from: usize, table: usize, mask: usize, value: usize, mask1: usize, value1: usize) -> usize {
    var k = from
    while k < runCount {
        if runTable[k] == table && runWord0[k] & mask == value && runWord1[k] & mask1 == value1 { return k }
        k += 1
    }
    return NEVER
}

// How many runs of table `table` whose word 0 has `value` in its bits
// `mask`.
pub fn runsOf(table: usize, mask: usize, value: usize) -> usize {
    var n: usize = 0
    var k: usize = 0
    while k < runCount {
        if runTable[k] == table && runWord0[k] & mask == value { n += 1 }
        k += 1
    }
    return n
}

pub fn inOrder(a: usize, b: usize, c: usize, d: usize) -> bool {
    if a == NEVER || b == NEVER || c == NEVER || d == NEVER { return false }
    return a < b && b < c && c < d
}

// The tables' numbers in the card's command table list and the
// transmitter's actions.
pub const SET_PIXEL_CLOCK: usize = 12
pub const ENABLE_CRTC: usize = 35
pub const SET_CRTC_TIMING: usize = 49
pub const SET_DCE_CLOCK: usize = 46
pub const TRANSMITTER: usize = 76
pub const OFF: usize = 0
pub const ON: usize = 1
pub const INIT: usize = 7

pub fn phyRun(from: usize, phy: usize, action: usize) -> usize { return runOf(from, TRANSMITTER, 0xFFFF, phy | (action << 8), 0, 0) }

// The transmitter's "on" for transmitter `phy` at link rate `code` (tens
// of MHz in word 1: 1.62 Gbit/s is 16200) on `lanes` lanes (word 0's
// fourth byte).
pub fn onAt(from: usize, phy: usize, code: usize, lanes: usize) -> usize { return runOf(from, TRANSMITTER, 0xFF00FFFF, phy | (ON << 8) | (lanes << 24), 0xFFFF, code * 2700) }

// The index of the driver's last write to `register` (NEVER: none), and
// of its first one from `from` on.
pub fn lastWrite(register: usize) -> usize {
    var found = NEVER
    var k: usize = 0
    while k < display.written && k < display.WRITES {
        if !display.writtenByTable[k] && display.writtenTo[k] == register { found = k }
        k += 1
    }
    return found
}

pub fn firstWrite(from: usize, register: usize) -> usize {
    var k = from
    while k < display.written && k < display.WRITES {
        if !display.writtenByTable[k] && display.writtenTo[k] == register { return k }
        k += 1
    }
    return NEVER
}

// The index of the run in the card's list of writes (its GO word) that is
// the transmitter's "on" for `phy` at `code` on `lanes`, the last of
// them (NEVER: none).
pub fn lastOnWrite(phy: usize, code: usize, lanes: usize) -> usize {
    var found = NEVER
    var w0: usize = 0
    var w1: usize = 0
    var k: usize = 0
    while k < display.written && k < display.WRITES {
        if display.writtenByTable[k] && display.writtenTo[k] == display.MAIL { w0 = display.writtenWith[k] }
        if display.writtenByTable[k] && display.writtenTo[k] == display.MAIL + 1 { w1 = display.writtenWith[k] }
        if display.writtenByTable[k] && display.writtenTo[k] == display.GO && display.writtenWith[k] == TRANSMITTER && w0 & 0xFF00FFFF == phy | (ON << 8) | (lanes << 24) && w1 & 0xFFFF == code * 2700 { found = k }
        k += 1
    }
    return found
}
