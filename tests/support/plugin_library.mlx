// A plugin (`mlx4 --plugin`): a shared object for a host that is not an Mlx
// program. tests/run_foreign.sh loads it from python3 (ctypes, a C host
// whose r14/r15 mean nothing to Mlx) and calls its exports on several
// threads at once: each call runs on an arena of its own.

const Point = struct { x: i64, y: i64 }

fn point(value: i64) -> Point { return Point.{ .x = value, .y = value * 3 } }

fn sum(count: i64) -> i64 {
    var total: i64 = 0
    var index: i64 = 0
    while index < count {
        // Each struct comes from the call's aggregate arena.
        const made = point(index)
        total += made.x + made.y
        index += 1
    }
    return total
}

// 4 * (0 + 1 + ... + count - 1).
export fn mlx_plugin_sum(count: i64) -> i64 { return sum(count) }

// A callback the host calls back into (like libobs): the same.
export fn mlx_plugin_twice(value: i64) -> i64 {
    const made = point(value)
    return made.x * 2
}

// A data symbol (`export const`): C code reads it as it reads a global
// (ctypes: in_dll), and may write it. To Mlx the constant is a compile-time
// value, so the plugin reads the word back through the dynamic linker: its
// own file (dladdr on one of its functions) opened again without loading,
// then dlsym.
export const mlx_plugin_level: u32 = 7

extern("c") fn dladdr(address: usize, info: usize) -> i32
extern("c") fn dlopen(path: [*]const u8, flags: i32) -> usize
extern("c") fn dlsym(handle: usize, name: [*]const u8) -> usize
extern("c") fn dlclose(handle: usize) -> i32

export fn mlx_plugin_level_now() -> u32 {
    // Dl_info: the file's name, its base, the symbol's name and address.
    var info: [4]usize = [4]usize{ 0, 0, 0, 0 }
    if dladdr(@intFromPtr(mlx_plugin_level_now), @intFromPtr(&info)) == 0 || info[0] == 0 { return 0 }
    var path: [*]const u8 = undefined
    unsafe { path = @ptrFromInt([*]const u8, info[0]) }
    // RTLD_LAZY | RTLD_NOLOAD
    const handle = dlopen(path, 5)
    if handle == 0 { return 0 }
    var name: [*]const u8 = undefined
    unsafe { name = @ptrCast([*]const u8, "mlx_plugin_level") }
    const address = dlsym(handle, name)
    const closed = dlclose(handle)
    if address == 0 { return 0 }
    var word: *const u32 = undefined
    unsafe { word = @ptrFromInt(*const u32, address) }
    return word.*
}
