// A library split in two (tests/275_import_cycle_order_runtime.mlx): lib
// holds the types and imports part for its work; part's signatures use
// lib's types.
const part = @import("./part.mlx")

pub const State = struct {
    value: usize
}

pub const STEP: usize = 3

pub fn twice(state: *State) -> usize { return part.add(state, state.*.value) }

pub fn base(state: *State) -> usize { return state.*.value + STEP }
