// A module that uses lib.mlx (tests/275_import_cycle_order_runtime.mlx):
// its declarations need lib's, so it waits for the lib/part cycle.
const lib = @import("./lib.mlx")

pub fn start(value: usize) -> lib.State { return lib.State.{ .value = value } }

pub fn run(state: *lib.State) -> usize { return lib.twice(state) }
