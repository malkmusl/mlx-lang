// The shared object tests/271_shared_object_runtime.mlx loads: built with
// `mlx4 --shared` by tests/run_foreign.sh. It has no main; its one export
// hands out functions by index, which the loading program calls through
// pointers. They build structs (aggregates, which live in the calling
// program's arena), keep a count in the caller's record and return a
// string literal of this object.
pub const Point = struct { x: i32, y: i32 }

pub const Record = struct {
    calls: usize
    last: Point
}

const VERSION: usize = 271

fn makePoint(value: i32) -> Point {
    return Point.{ .x = value, .y = value * 3 }
}

fn visit(record: *Record, value: usize) -> usize {
    const point = makePoint(@intCast(i32, value))
    record.*.last = point
    record.*.calls += 1
    return @intCast(usize, point.y) + VERSION
}

fn name() -> []const u8 {
    return "shared object"
}

export fn mlx_test_entry(index: usize) -> usize {
    if index == 0 { return VERSION }
    if index == 1 { return @intFromPtr(visit) }
    if index == 2 {
        unsafe { return @intFromPtr(@ptrCast([*]const u8, name())) }
    }
    if index == 3 { return name().length }
    return 0
}
