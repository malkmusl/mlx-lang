// Hashes passwords under the settings standard input names, for
// tools/check_crypt.sh, which compares what std.crypt makes with what
// the system's crypt(3) makes of the same.
//
// Each line is "SETTING EXPECTED HEXPASSWORD": the setting to hash
// under, the hash crypt(3) made of it, and the password as hex digits
// (so that a password may hold spaces, tabs or any byte at all).
//
// For each line one line comes back:
//
//     HASH ok        the hash, and verify took the expected hash for
//                    this password and refused a changed one
//     HASH bad-...   verify did not (which of the two follows)
//     - refused      std.crypt does not know this setting
const std = @import("std")
const crypt = @import("std.crypt")

fn hexValue(byte: u8) -> u8 {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 97 && byte <= 102 { return byte - 97 + 10 }
    if byte >= 65 && byte <= 70 { return byte - 65 + 10 }
    return 255
}

// The hex digits of `text` as bytes in `into`: how many, or 0 when the
// text is not pairs of hex digits.
fn unhex(text: []const u8, into: [*]u8, capacity: usize) -> usize {
    if text.length % 2 != 0 || text.length / 2 > capacity { return 0 }
    var index: usize = 0
    while index < text.length {
        const high = hexValue(text[index])
        const low = hexValue(text[index + 1])
        if high == 255 || low == 255 { return 0 }
        into[index / 2] = high * 16 + low
        index += 2
    }
    return text.length / 2
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stdout(), text)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var input: [1048576]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &input) }
    var filled: usize = 0
    while filled < 1048576 {
        const got = std.linux.syscall3(0, 0, @intFromPtr(bytes) + filled, 1048576 - filled)
        if got <= 0 { break }
        filled += @bitCast(usize, got)
    }
    var at: usize = 0
    while at < filled {
        var end = at
        while end < filled && input[end] != 10 { end += 1 }
        const line = bytes[at..end]
        at = end + 1
        // The three fields.
        var first: usize = 0
        while first < line.length && line[first] != 32 { first += 1 }
        if first >= line.length { continue }
        var second = first + 1
        while second < line.length && line[second] != 32 { second += 1 }
        if second >= line.length { continue }
        const setting = line[0..first]
        const expected = line[first + 1 .. second]
        var password: [1024]u8 = undefined
        var passwordBytes: [*]u8 = undefined
        unsafe { passwordBytes = @ptrCast([*]u8, &password) }
        const length = unhex(line[second + 1 .. line.length], passwordBytes, 1024)
        if length == 0 && second + 1 != line.length { continue }
        const given = passwordBytes[0..length]
        var out: [256]u8 = undefined
        var outBytes: [*]u8 = undefined
        unsafe { outBytes = @ptrCast([*]u8, &out) }
        const written = crypt.hash(given, setting, outBytes, 256)
        if written == 0 {
            say("- refused\n")
            continue
        }
        say(outBytes[0..written])
        // The hash the system made has to be the one this verifies, and
        // a password one byte different has to be refused.
        if !crypt.verify(given, expected) {
            say(" bad-rejected-the-right-password\n")
            continue
        }
        var changed: [1024]u8 = undefined
        var changedBytes: [*]u8 = undefined
        unsafe { changedBytes = @ptrCast([*]u8, &changed) }
        var index: usize = 0
        while index < length {
            changedBytes[index] = given[index]
            index += 1
        }
        changedBytes[length] = 88
        if crypt.verify(changedBytes[0 .. length + 1], expected) {
            say(" bad-took-another-password\n")
            continue
        }
        say(" ok\n")
    }
    return 0
}
