// What mlx-console shows after receiving the bytes of a file, drawn the
// way the console draws (std.ui.terminal with no padding, the monospaced
// font at the given height, the cursor shown), written as raw ARGB pixels:
// tools/check_console.sh compares it with the console's framebuffer file.
//
//     console_expected WIDTH HEIGHT FONT_SIZE BYTES_FILE OUT_FILE
//
// Exits 2 without a font (the check skips the comparison then), 3 on a bad
// argument, 4 when a file cannot be read or written.
const std = @import("std")
const ui = @import("std.ui")
const terminal = @import("std.terminal")
const ui_terminal = @import("std.ui.terminal")
const text = @import("std.ui.text")
const canvas_module = @import("std.ui.canvas")

fn number(arguments: [][*]const u8, index: usize) -> usize {
    var result: usize = 0
    for byte in std.string.asSlice(std.process.argument(arguments, index)) {
        if byte < 48 || byte > 57 { return 0 }
        result = result * 10 + @intCast(usize, byte - 48)
    }
    return result
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 6 { return 3 }
    const width = number(arguments, 1)
    const height = number(arguments, 2)
    const font_size = number(arguments, 3)
    if width < 64 || height < 32 || font_size < 6 { return 3 }
    const allocator = std.page_allocator.init()
    var mono: text.Text = undefined
    if !text.loadMonoText(&mono, @intCast(u32, font_size), allocator) { return 2 }
    var screen: terminal.Screen = undefined
    var view: ui_terminal.View = undefined
    ui_terminal.init(&view, &screen, &mono, @intCast(i32, font_size), 0)
    var columns = ui_terminal.columnsFor(&view, @intCast(i32, width))
    var rows = ui_terminal.rowsFor(&view, @intCast(i32, height))
    if columns < 2 { columns = 2 }
    if rows < 1 { rows = 1 }
    if !terminal.init(&screen, allocator, columns, rows, 5000) { return 4 }
    view.focused = true
    const input = std.fs.open(std.process.argument(arguments, 4).pointer, 0, 0)
    if !std.fs.isValid(input) { return 4 }
    const bytes = std.fs.readToEndAlloc(input, allocator)
    const closed = std.fs.close(input)
    terminal.feed(&screen, bytes.items[0..bytes.length])
    const memory = allocator.alloc(width * height * 4, 16)
    if memory == null { return 4 }
    var canvas: canvas_module.Canvas = undefined
    unsafe { canvas.pixels = @ptrCast([*]u32, memory.?) }
    canvas.width = width
    canvas.height = height
    canvas.stride = width
    canvas.swapRedBlue = false
    canvas.device = 0
    canvas.opacity = 255
    ui_terminal.draw(&view, &canvas, ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height)))
    const output = std.fs.open(std.process.argument(arguments, 5).pointer, 577, 420)
    if !std.fs.isValid(output) { return 4 }
    var pixel_bytes: [*]const u8 = undefined
    unsafe { pixel_bytes = @ptrCast([*]const u8, memory.?) }
    if !std.fs.writeAllBytes(output, pixel_bytes, width * height * 4) { return 4 }
    const done = std.fs.close(output)
    return 0
}
