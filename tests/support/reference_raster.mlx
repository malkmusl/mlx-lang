// A reference rasterizer for our Vulkan driver's stage (c) (tests 515 and
// 516): the pixels a draw of triangles must give, from the rules of the
// Vulkan specification's chapters on vertex post-processing and
// rasterization, written here as the author knows them (the specification
// itself is not among the sources this work may fetch; nothing of it is
// copied, and nothing here is taken from the host card's model,
// projects/brix/vulkan/card_draw.mlx):
//
//   - the clip coordinates divided by w; the framebuffer coordinates
//     x_f = (p_x / 2) x_d + o_x, y_f = (p_y / 2) y_d + o_y with p the
//     viewport's size and o its centre;
//   - the vertices snapped to the device's sub-pixel grid (subPixelPrecision
//     Bits 8: 1/256 of a pixel; the rounding of a value halfway between two
//     points of the grid is the implementation's, and the cases avoid it);
//   - a triangle's area a = -1/2 * sum(x_i y_(i+1) - x_(i+1) y_i): a > 0
//     counter-clockwise, so front-facing with VK_FRONT_FACE_COUNTER_
//     CLOCKWISE; culled as the cull mode says; no area, no fragment;
//   - one sample at the pixel's centre (x + 1/2, y + 1/2); covered when it
//     lies inside the triangle; a sample on an edge belongs to exactly one
//     of two triangles that share the edge: the specification leaves which
//     to the implementation, and this reference takes the top-left rule
//     (an edge whose inside lies below it, or to its right, owns its
//     samples), the tests checking both that rule's pixels and that a
//     shared edge's samples are covered once;
//   - a triangle strip's triangle i is the vertices i, i + (1 + i % 2),
//     i + (2 - i % 2), its first vertex the provoking one (flat inputs
//     take its value);
//   - an input interpolated with perspective: the barycentrics of the
//     sample weighted by 1/w;
//   - a colour into an R8G8B8A8_UNORM or B8G8R8A8_UNORM pixel clamped to
//     [0, 1] and scaled by 255 to the nearest integer (the specification:
//     to one of the two nearest, the nearest preferred; the tests compare
//     interpolated colours within one unit, constant ones exactly);
//   - blending with ONE and ONE (the sum, clamped), or none.
//
// Numbers in doubles; the pixels as their four components (r, g, b, a)
// of 0 .. 255.
pub const MOST_VERTICES: usize = 16
pub const MOST_PIXELS: usize = 64 * 64

pub const Vertex = struct {
    // Clip coordinates and the colour (r, g, b; alpha 1).
    x: f64
    y: f64
    z: f64
    w: f64
    r: f64
    g: f64
    b: f64
}

pub const Draw = struct {
    vertices: [16]Vertex
    count: usize
    strip: bool
    // VK_CULL_MODE_FRONT_BIT 1, BACK 2; VK_FRONT_FACE_CLOCKWISE when true.
    cull: u32
    clockwise: bool
    flat: bool
    additive: bool
    // The viewport.
    vx: f64
    vy: f64
    vw: f64
    vh: f64
}

pub var pixels: [64 * 64 * 4]u32 = undefined
pub var covered: [64 * 64]u32 = undefined
pub var width: usize = 0
pub var height: usize = 0

pub fn clear(w: usize, h: usize, r: u32, g: u32, b: u32, a: u32) -> void {
    width = w
    height = h
    var k: usize = 0
    while k < w * h {
        pixels[4 * k] = r
        pixels[4 * k + 1] = g
        pixels[4 * k + 2] = b
        pixels[4 * k + 3] = a
        covered[k] = 0
        k += 1
    }
}

fn floor(x: f64) -> f64 { return @floor(x) }

// The nearest point of the 1/256 grid (ties to even).
fn snap(x: f64) -> i64 {
    const scaled = x * 256.0
    const down = floor(scaled)
    var n = @intFromFloat(i64, down)
    const rest = scaled - down
    if rest > 0.5 || (rest == 0.5 && (n & 1) != 0) { n += 1 }
    return n
}

fn unit(c: f64) -> u32 {
    var v = c
    if !(v > 0.0) { v = 0.0 }
    if v > 1.0 { v = 1.0 }
    const scaled = v * 255.0
    var n = @intFromFloat(i64, floor(scaled))
    if scaled - floor(scaled) >= 0.5 { n += 1 }
    return @intCast(u32, n)
}

// Twice the signed area of a, b, p (positive: p left of a -> b in y-down
// coordinates turned clockwise on the screen).
fn side(ax: i64, ay: i64, bx: i64, by: i64, px: i64, py: i64) -> i64 { return (bx - ax) * (py - ay) - (by - ay) * (px - ax) }

fn owns(ax: i64, ay: i64, bx: i64, by: i64) -> bool {
    const dy = by - ay
    return dy < 0 || (dy == 0 && bx - ax > 0)
}

fn triangle(d: *const Draw, i0: usize, i1: usize, i2: usize) -> void {
    const ids = [3]usize{ i0, i1, i2 }
    var x: [3]i64 = undefined
    var y: [3]i64 = undefined
    var q: [3]f64 = undefined
    var k: usize = 0
    while k < 3 {
        const v = &d.*.vertices[ids[k]]
        const xd = v.*.x / v.*.w
        const yd = v.*.y / v.*.w
        x[k] = snap(d.*.vw / 2.0 * xd + (d.*.vx + d.*.vw / 2.0))
        y[k] = snap(d.*.vh / 2.0 * yd + (d.*.vy + d.*.vh / 2.0))
        q[k] = 1.0 / v.*.w
        k += 1
    }
    // a = -1/2 sum(x_i y_(i+1) - x_(i+1) y_i)
    var sum: i64 = 0
    k = 0
    while k < 3 {
        const n = (k + 1) % 3
        sum += x[k] * y[n] - x[n] * y[k]
        k += 1
    }
    if sum == 0 { return }
    const counterClockwise = sum < 0
    const front = if d.*.clockwise { !counterClockwise } else { counterClockwise }
    if (front && (d.*.cull & 1) != 0) || (!front && (d.*.cull & 2) != 0) { return }
    // the vertices in the order whose inside is positive
    var ox: [3]i64 = x
    var oy: [3]i64 = y
    if sum < 0 {
        ox[1] = x[2]
        oy[1] = y[2]
        ox[2] = x[1]
        oy[2] = y[1]
    }
    var py: usize = 0
    while py < height {
        var px: usize = 0
        while px < width {
            const sx = @intCast(i64, px) * 256 + 128
            const sy = @intCast(i64, py) * 256 + 128
            var inside = true
            k = 0
            while k < 3 {
                const n = (k + 1) % 3
                const e = side(ox[k], oy[k], ox[n], oy[n], sx, sy)
                if e < 0 || (e == 0 && !owns(ox[k], oy[k], ox[n], oy[n])) { inside = false }
                k += 1
            }
            if inside {
                const b0 = @floatFromInt(f64, side(x[1], y[1], x[2], y[2], sx, sy)) * q[0]
                const b1 = @floatFromInt(f64, side(x[2], y[2], x[0], y[0], sx, sy)) * q[1]
                const b2 = @floatFromInt(f64, side(x[0], y[0], x[1], y[1], sx, sy)) * q[2]
                const total = b0 + b1 + b2
                const v0 = &d.*.vertices[i0]
                const v1 = &d.*.vertices[i1]
                const v2 = &d.*.vertices[i2]
                var r = v0.*.r
                var g = v0.*.g
                var b = v0.*.b
                if !d.*.flat {
                    r = (b0 * v0.*.r + b1 * v1.*.r + b2 * v2.*.r) / total
                    g = (b0 * v0.*.g + b1 * v1.*.g + b2 * v2.*.g) / total
                    b = (b0 * v0.*.b + b1 * v1.*.b + b2 * v2.*.b) / total
                }
                const at = py * width + px
                const colour = [4]u32{ unit(r), unit(g), unit(b), 255 }
                var c: usize = 0
                while c < 4 {
                    var value = colour[c]
                    if d.*.additive {
                        value += pixels[4 * at + c]
                        if value > 255 { value = 255 }
                    }
                    pixels[4 * at + c] = value
                    c += 1
                }
                covered[at] += 1
            }
            px += 1
        }
        py += 1
    }
}

// The draw's triangles into the pixels.
pub fn draw(d: *const Draw) -> void {
    var t: usize = 0
    if !d.*.strip {
        while t + 3 <= d.*.count {
            triangle(d, t, t + 1, t + 2)
            t += 3
        }
        return
    }
    while t + 3 <= d.*.count {
        const odd = t % 2
        triangle(d, t, t + 1 + odd, t + 2 - odd)
        t += 1
    }
}
