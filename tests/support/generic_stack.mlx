// A generic type declared here, instantiated by the program importing it.
pub fn Stack(comptime T: type, comptime capacity: usize) -> type {
    return struct {
        items: [capacity]T
        length: usize

        pub const LIMIT: usize = capacity

        pub fn init() -> Self {
            var result: Self = undefined
            result.length = 0
            return result
        }

        pub fn push(self: *Self, value: T) -> bool {
            if self.*.length == capacity { return false }
            self.*.items[self.*.length] = value
            self.*.length += 1
            return true
        }

        pub fn pop(self: *Self) -> ?T {
            if self.*.length == 0 { return null }
            self.*.length -= 1
            return self.*.items[self.*.length]
        }
    }
}

pub fn Wrapper(comptime T: type) -> type {
    return struct {
        inner: T

        pub fn unwrap(self: *Self) -> *T {
            return &self.*.inner
        }
    }
}
