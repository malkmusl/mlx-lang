// A plugin without a C library (`mlx4 --plugin --stack-arena --no-libc`):
// no import, so its DT_NEEDED is empty, and its exports take their
// aggregate arena from their own stack frame, so a call costs no system
// call. tests/run_foreign.sh loads it from python3 on several threads at
// once. What mlxlibc is built as.

const Point = struct { x: i64, y: i64 }

fn point(value: i64) -> Point { return Point.{ .x = value, .y = value * 3 } }

// 4 * (0 + 1 + ... + count - 1): `count` structs from the call's arena
// (16 bytes each; a 64 KiB stack arena holds 4000 of them).
export fn mlx_free_sum(count: i64) -> i64 {
    var total: i64 = 0
    var index: i64 = 0
    while index < count {
        const made = point(index)
        total += made.x + made.y
        index += 1
    }
    return total
}

// A global: one word the host and the plugin share.
export var mlx_free_calls: u64 = 0

export fn mlx_free_count() -> u64 {
    mlx_free_calls += 1
    return mlx_free_calls
}
