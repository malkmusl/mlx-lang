const a = @import("./a.mlx")
const b = @import("./b.mlx")

// (Nothing in it: only ever behind a pointer.)
pub const Handle = extern struct {
}

pub const Keeper = extern struct {
    first: ?*a.A
    pair: b.Pair
    handle: ?*Handle
}

pub fn weigh(first: ?*a.A, keeper: ?*Keeper) -> u32 {
    return first.?.*.pair.n + keeper.?.*.pair.small.n
}
