// One of three modules that import one another and name one another's
// records in their own (tests/441_types_across_import_ring_runtime.mlx).
const b = @import("./b.mlx")
const c = @import("./c.mlx")

pub const A = extern struct {
    next: ?*b.B
    pair: b.Pair
    handle: ?*c.Handle
    list: ?[*]?*c.Keeper
}

pub const Small = extern struct {
    n: u32
}

pub fn sizeOfB() -> usize { return @sizeOf(b.B) }
