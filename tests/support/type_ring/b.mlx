const a = @import("./a.mlx")
const c = @import("./c.mlx")

pub const B = extern struct {
    back: ?*a.A
    keeper: c.Keeper
    call: ?fn(?*a.A, ?*c.Keeper) -> u32
}

// (A record of this module with one of a's inside, inside one of a's.)
pub const Pair = extern struct {
    n: u32
    small: a.Small
}
