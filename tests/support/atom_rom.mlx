// A small video BIOS ROM made in memory, for the tests of the kernel's
// table interpreter and ROM reading (projects/brix/kernel/atom.mlx,
// gpu_rom.mlx): the PCI ROM's first bytes, AMD's mark, the dates and
// names, the ATOM header, the two lists, and whatever command and data
// tables a test puts in, with the length byte and the checksum set at
// the end. The places are Linux 6.6's (atom.h, atombios.h's
// ATOM_ROM_HEADER, atomfirmware.h's atombios_image_offset, drivers/pci/
// rom.c for the PCI data structure). No bytes of a real card's ROM are
// in here.
//
// A test: `begin`, then for each table `command` (or `openCommand`, bytes,
// `closeCommand`) and `dataTable`, perhaps `programs`, then `finish`, and
// `image()` is the ROM. What a damaged ROM needs is done to the bytes
// afterwards (`poke`, `resum`).

pub const ROOM: usize = 65536
// Where the fixed parts lie in a ROM made here.
pub const STRINGS: usize = 0x100
pub const PCI_DATA: usize = 0x1C0
pub const HEADER: usize = 0x200
pub const COMMANDS: usize = 0x240
pub const DATA: usize = 0x300
pub const FIRST: usize = 0x400

pub const Builder = struct {
    bytes: [ROOM]u8
    // Where the next byte goes, and how many bytes the ROM has when it
    // is finished (whole blocks of 512).
    at: usize
    size: usize
    commandCount: usize
    dataCount: usize
    // The table being written: where it begins.
    open: usize

    pub fn poke(self: *Self, at: usize, value: usize) -> void { self.*.bytes[at] = @intCast(u8, value & 0xFF) }

    pub fn poke16(self: *Self, at: usize, value: usize) -> void {
        self.poke(at, value)
        self.poke(at + 1, value >> 8)
    }

    pub fn poke32(self: *Self, at: usize, value: usize) -> void {
        self.poke16(at, value)
        self.poke16(at + 2, value >> 16)
    }

    pub fn peek(self: *const Self, at: usize) -> usize { return @intCast(usize, self.*.bytes[at]) }

    pub fn peek16(self: *const Self, at: usize) -> usize { return self.peek(at) | (self.peek(at + 1) << 8) }

    pub fn text(self: *Self, at: usize, words: []const u8) -> void {
        var k: usize = 0
        while k < words.length {
            self.*.bytes[at + k] = words[k]
            k += 1
        }
    }

    // The next bytes.
    pub fn byte(self: *Self, value: usize) -> void {
        self.poke(self.*.at, value)
        self.*.at += 1
    }

    pub fn word(self: *Self, value: usize) -> void {
        self.poke16(self.*.at, value)
        self.*.at += 2
    }

    pub fn long(self: *Self, value: usize) -> void {
        self.poke32(self.*.at, value)
        self.*.at += 4
    }

    pub fn put(self: *Self, bytes: []const u8) -> void {
        var k: usize = 0
        while k < bytes.length {
            self.byte(@intCast(usize, bytes[k]))
            k += 1
        }
    }

    pub fn here(self: *const Self) -> usize { return self.*.at }

    // An empty ROM with lists of `commands` and `datas` entries (81 and
    // 35 are a real one's), every entry 0: the names "113-TEST-001" (the
    // part number), "TEST ROM FOR BRIXOS" (the name) and the date
    // 11/11/26 12:34.
    pub fn begin(self: *Self, commands: usize, datas: usize) -> void {
        var k: usize = 0
        while k < ROOM {
            self.*.bytes[k] = 0
            k += 1
        }
        self.*.commandCount = commands
        self.*.dataCount = datas
        self.*.open = 0
        self.poke16(0, 0xAA55)
        // The PCI data structure: "PCIR", AMD's vendor number, a device,
        // the image's length in blocks (set by finish), the last image.
        self.poke16(0x18, PCI_DATA)
        self.text(PCI_DATA, "PCIR")
        self.poke16(PCI_DATA + 4, 0x1002)
        self.poke16(PCI_DATA + 6, 0x67DF)
        self.poke(PCI_DATA + 21, 0x80)
        self.text(0x30, " 761295520")
        self.poke16(0x48, HEADER)
        self.text(0x50, "11/11/26 12:34")
        // Two strings, then a line's end, then the name.
        self.poke(0x2F, 2)
        self.poke16(0x6E, STRINGS)
        self.text(STRINGS, "113-TEST-001")
        self.text(STRINGS + 13, "POLARIS10")
        self.poke(STRINGS + 23, 0x0D)
        self.poke(STRINGS + 24, 0x0A)
        self.text(STRINGS + 25, "TEST ROM FOR BRIXOS   ")
        // The ATOM header: its length and revision, "ATOM", the lists.
        self.poke16(HEADER, 0x24)
        self.poke(HEADER + 2, 1)
        self.poke(HEADER + 3, 1)
        self.text(HEADER + 4, "ATOM")
        self.poke16(HEADER + 0x1E, COMMANDS)
        self.poke16(HEADER + 0x20, DATA)
        self.poke16(COMMANDS, 4 + 2 * commands)
        self.poke(COMMANDS + 2, 1)
        self.poke(COMMANDS + 3, 1)
        self.poke16(DATA, 4 + 2 * datas)
        self.poke(DATA + 2, 1)
        self.poke(DATA + 3, 1)
        self.*.at = FIRST
        self.*.size = 0
    }

    // A command table begun at the next byte and entered in the list at
    // `index`: its header (the length is set by closeCommand), a work
    // space of `work` words and a parameter space of `parameters` bytes.
    // Where it begins (jump targets count from there).
    pub fn openCommand(self: *Self, index: usize, work: usize, parameters: usize) -> usize {
        self.*.open = self.*.at
        self.poke16(COMMANDS + 4 + 2 * index, self.*.at)
        self.word(0)
        self.byte(1)
        self.byte(1)
        self.byte(work)
        self.byte(parameters)
        return self.*.open
    }

    pub fn closeCommand(self: *Self) -> void { self.poke16(self.*.open, self.*.at - self.*.open) }

    // A whole command table: its header and `code`.
    pub fn command(self: *Self, index: usize, work: usize, parameters: usize, code: []const u8) -> usize {
        const start = self.openCommand(index, work, parameters)
        self.put(code)
        self.closeCommand()
        return start
    }

    // A command table's format and content revision set (they are 1 and
    // 1 otherwise).
    pub fn revise(self: *Self, index: usize, format: usize, content: usize) -> void {
        const start = self.peek16(COMMANDS + 4 + 2 * index)
        self.poke(start + 2, format)
        self.poke(start + 3, content)
    }

    // A data table begun at the next byte and entered in the list at
    // `index`, with its revision; closeData sets its length.
    pub fn openData(self: *Self, index: usize, format: usize, content: usize) -> usize {
        self.*.open = self.*.at
        self.poke16(DATA + 4 + 2 * index, self.*.at)
        self.word(0)
        self.byte(format)
        self.byte(content)
        return self.*.open
    }

    pub fn closeData(self: *Self) -> void { self.poke16(self.*.open, self.*.at - self.*.open) }

    // The ROM's end: whole blocks of 512 bytes, the length byte, and the
    // byte at 0x21 (free in a ROM made here) chosen so that all bytes add up
    // to 0.
    pub fn finish(self: *Self) -> void {
        self.*.size = (self.*.at + 511) / 512 * 512
        self.poke(2, self.*.size / 512)
        self.poke16(PCI_DATA + 16, self.*.size / 512)
        self.resum()
    }

    pub fn resum(self: *Self) -> void {
        self.poke(0x21, 0)
        var sum: usize = 0
        var k: usize = 0
        while k < self.*.size {
            sum += self.peek(k)
            k += 1
        }
        self.poke(0x21, (256 - (sum & 0xFF)) & 0xFF)
    }

    pub fn image(self: *const Self) -> []const u8 { return self.*.bytes[0..self.*.size] }

    // The firmware information (data table 4) of format 2.2, with these
    // clocks in kHz: the pixel clock PLL's reference, what may go into
    // the PLL and come out of it, the display engine's clock and
    // DisplayPort's reference.
    pub fn firmware(self: *Self, reference: usize, inputLeast: usize, inputMost: usize, outputLeast: usize, outputMost: usize, engine: usize, displayPort: usize) -> usize {
        const start = self.openData(4, 2, 2)
        var k: usize = 4
        while k < 108 {
            self.byte(0)
            k += 1
        }
        self.poke32(start + 4, 0x0F320100)
        self.poke32(start + 32, outputMost / 10)
        self.poke32(start + 40, engine / 10)
        self.poke32(start + 56, outputLeast / 10)
        self.poke16(start + 74, inputLeast / 10)
        self.poke16(start + 76, inputMost / 10)
        self.poke16(start + 82, reference / 10)
        self.poke16(start + 86, displayPort / 10)
        self.closeData()
        return start
    }

    // The object table (data table 22) with a display path for each
    // connector: its object number, its encoder's, its hot plug pin and
    // its DDC line (0xFF: no such record). Where the table begins.
    pub fn objects(self: *Self, connectors: []const usize, encoders: []const usize, pins: []const usize, lines: []const usize) -> usize {
        const count = connectors.length
        const start = self.openData(22, 1, 3)
        // The header's seven words are set when the parts are laid out.
        var k: usize = 0
        while k < 14 {
            self.byte(0)
            k += 1
        }
        self.poke16(start + 4, 0xFFFF)
        // The connectors' objects; their sources and records follow the
        // tables.
        const connectorTable = self.*.at
        self.poke16(start + 6, connectorTable - start)
        self.byte(count)
        self.byte(0)
        self.word(0)
        k = 0
        while k < count {
            self.word(connectors[k])
            self.word(0)
            self.word(0)
            self.word(0)
            k += 1
        }
        const encoderTable = self.*.at
        self.poke16(start + 10, encoderTable - start)
        self.byte(count)
        self.byte(0)
        self.word(0)
        k = 0
        while k < count {
            self.word(encoders[k])
            self.word(0)
            self.word(0)
            self.word(0)
            k += 1
        }
        const paths = self.*.at
        self.poke16(start + 14, paths - start)
        self.byte(count)
        self.byte(1)
        self.word(0)
        k = 0
        while k < count {
            self.word(1 << @intCast(u6, k))
            self.word(10)
            self.word(connectors[k])
            self.word(0x1100)
            self.word(encoders[k])
            k += 1
        }
        // A record that ends a list, for the encoders.
        const end = self.*.at
        self.byte(0xFF)
        self.byte(2)
        k = 0
        while k < count {
            self.poke16(encoderTable + 4 + k * 8 + 4, end - start)
            // The connector's one source, no destination.
            self.poke16(connectorTable + 4 + k * 8 + 2, self.*.at - start)
            self.byte(1)
            self.word(encoders[k])
            self.byte(0)
            self.poke16(connectorTable + 4 + k * 8 + 4, self.*.at - start)
            if pins[k] != 0xFF {
                self.byte(2)
                self.byte(4)
                self.byte(pins[k])
                self.byte(0)
            }
            if lines[k] != 0xFF {
                self.byte(1)
                self.byte(4)
                self.byte(0x80 | lines[k])
                self.byte(0)
            }
            self.byte(0xFF)
            self.byte(2)
            k += 1
        }
        self.closeData()
        return start
    }

    // How much scratch the tables ask for (data table 11), in KiB.
    pub fn scratch(self: *Self, kilobytes: usize) -> usize {
        const start = self.openData(11, 1, 4)
        self.long(0)
        self.word(kilobytes)
        self.word(0)
        self.closeData()
        return start
    }

    // The board's table of pins (data table 12, of the content revision
    // `content`; Linux's display core reads 1): for each pin the number
    // the other tables name it by, the register it is read by and the
    // bit in it.
    pub fn pins(self: *Self, content: usize, ids: []const usize, registers: []const usize, shifts: []const usize) -> usize {
        const start = self.openData(12, 2, content)
        var k: usize = 0
        while k < ids.length {
            self.word(registers[k])
            self.byte(shifts[k])
            self.byte(ids[k])
            k += 1
        }
        self.closeData()
        return start
    }

    // What the card's own clock generator gives, in kHz, put into the
    // firmware information that is there.
    pub fn generator(self: *Self, kilohertz: usize) -> void {
        const start = self.peek16(DATA + 4 + 2 * 4)
        self.poke32(start + 20, kilohertz / 10)
    }

    // A capability record (a word of flags; bit 2: HDMI at 300 MHz and
    // more) for the `index`th encoder of the object table that is there,
    // put at the next bytes: the encoder's records are this one and the
    // one that ends a list.
    pub fn capability(self: *Self, index: usize, flags: usize) -> void {
        const start = self.peek16(DATA + 4 + 2 * 22)
        const encoders = start + self.peek16(start + 10)
        self.poke16(encoders + 4 + index * 8 + 4, self.*.at - start)
        self.byte(20)
        self.byte(4)
        self.word(flags)
        self.byte(0xFF)
        self.byte(2)
    }
}

// The board of the user's machine as far as the log tells it (an HDMI
// connector on DIG 4), with two more connectors of a test's choosing: in
// this order an HDMI connector on the transmitter UNIPHY E (hot plug pin
// 4, DDC line 4), a DisplayPort on UNIPHY A (pin 1, line 1) and a DVI-D
// on UNIPHY D (pin 6, no DDC line). (An object's number, ObjectID.h: the
// kind in bits 12 to 14, 2 an encoder and 3 a connector; which of
// several in bits 8 to 10; what it is in the low byte: 0x0C HDMI, 0x13
// DisplayPort, 0x04 DVI-D with two links; 0x1E, 0x20 and 0x21 the
// transmitter pairs UNIPHY A and B, C and D, E and F.)
pub const BOARD_CONNECTORS = [_]usize{ 0x310C, 0x3113, 0x3104 }
pub const BOARD_ENCODERS = [_]usize{ 0x2121, 0x211E, 0x2220 }
pub const BOARD_PINS = [_]usize{ 4, 1, 6 }
pub const BOARD_LINES = [_]usize{ 4, 1, 0xFF }

// A ROM as a Polaris card's is laid out, with nothing of a real one's in
// it: lists of 81 and 35 entries, the firmware information (a reference
// of 100 MHz, 16 to 600 MHz out of the PLL), the board above, scratch of
// 64 KiB; and `table` (a command table's code) at each of the places a
// mode set's tables have, the revisions a test's choice. `finish` is
// still to be called (after whatever else the test puts in).
pub const MODE_TABLES = [_]usize{ 12, 76, 4, 35, 34, 49, 13, 17, 65, 46, 42, 6 }

pub fn polaris(builder: *Builder, table: []const u8) -> void {
    builder.begin(81, 35)
    var k: usize = 0
    while k < MODE_TABLES[0..].length {
        _ = builder.command(MODE_TABLES[k], 0, 0, table)
        k += 1
    }
    builder.revise(12, 1, 7)
    builder.revise(76, 1, 6)
    builder.revise(4, 1, 5)
    builder.revise(13, 2, 1)
    _ = builder.command(0, 0, 0, table)
    _ = builder.firmware(100000, 6000, 200000, 16000, 600000, 625000, 0)
    _ = builder.objects(BOARD_CONNECTORS[0..], BOARD_ENCODERS[0..], BOARD_PINS[0..], BOARD_LINES[0..])
    _ = builder.scratch(64)
}

// What a mode set through the tables needs beside `polaris`: the board's
// pins placed (the HDMI connector's pin 4 on the card's hot plug line 2,
// the DisplayPort's pin 1 on line 1, the DVI-D's pin 6 on line 6: the
// register 0x488d, DC_GPIO_HPD_A, and its bits 8, 0 and 28), the clock
// generator's 3600 MHz, and the revisions Linux's display core fills
// blocks for where `polaris` leaves 1.1: the timing's table 1.3, the
// display engine's clock's 2.1. `finish` is still to be called.
pub const BOARD_PIN_REGISTERS = [_]usize{ 0x488D, 0x488D, 0x488D }
pub const BOARD_PIN_SHIFTS = [_]usize{ 8, 0, 28 }

pub fn modeSet(builder: *Builder) -> void {
    builder.revise(49, 1, 3)
    builder.revise(46, 2, 1)
    builder.generator(3600000)
    _ = builder.pins(1, BOARD_PINS[0..], BOARD_PIN_REGISTERS[0..], BOARD_PIN_SHIFTS[0..])
}
