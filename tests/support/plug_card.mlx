// A Radeon's connectors, hot plug lines and I2C engine as a table, for
// the tests of the kernel's looking for the monitor and of its reading an
// EDID over a DDC line (tests/483_gpu_plug_detect_runtime.mlx and
// 484_gpu_ddc_edid_runtime.mlx): the registers by number, a clock that is
// the test's (it goes on only by what the driver pauses and by what the
// test adds), every write in order, the log, and behind each of the six
// DDC lines a monitor's EDID memory or nothing.
//
// The I2C engine here does what Linux 6.6's dce_i2c_hw.c counts on, as far
// as that file shows it (nothing of a real card's is in here):
// DC_I2C_DATA is a window onto a buffer with an index (a write with the
// index bit puts the index, a write stores a byte and moves the index on
// unless it sets the index for reading, a read gives a byte and moves it
// on); a write of DC_I2C_GO from 0 to 1 runs the messages
// DC_I2C_TRANSACTION0 on say, as many as DC_I2C_CONTROL's count names,
// against what is on the line DC_I2C_DDC_SELECT names: an address byte
// each, a write's bytes after it, the bytes read put behind everything
// that was sent; the status word says "used by software" for `runLooks`
// looks (or, with `byClock`, for as long as the bytes take on the wire
// at 100 kHz, nine bits each) and then how the run ended; a status reset
// in DC_I2C_CONTROL
// clears that, a soft reset stops a run.
// A monitor: its EDID answers at 0x50 (a byte written is where the next
// read begins in the 256 bytes of the segment), its segment pointer at
// 0x30 when it has one, and the pointer falls back to 0 at a stop.
// The engine does not run when the driver left out what Linux sets
// first: then `protocol` says what, and the run ends as aborted.
//
// What the card can be made to do wrong is a variable each, below.
const scanout = @import("../../projects/brix/kernel/gpu_display.mlx")
const ddc = @import("../../projects/brix/kernel/gpu_ddc.mlx")
const plug = @import("../../projects/brix/kernel/gpu_plug.mlx")
const rom = @import("./atom_rom.mlx")

pub const ROOM: usize = 0x8000
pub const NEVER: usize = 0xFFFFFFFF

pub var registers: [ROOM]usize = undefined
// The clock in nanoseconds, and what it goes on by each time it is asked
// (0: only the test and the driver's pauses move it).
pub var clock: usize = 0
pub var stride: usize = 0
// Every pause the driver made: how many, and their microseconds in all.
pub var pauses: usize = 0
pub var paused: usize = 0

// Every write, in order.
pub const WRITES: usize = 8192
pub var writtenTo: [WRITES]usize = undefined
pub var writtenWith: [WRITES]usize = undefined
pub var written: usize = 0
// How often the engine's status word and its data word were read, and
// every register read in all.
pub var statusReads: usize = 0
pub var dataReads: usize = 0
pub var reads: usize = 0

// What is on each DDC line.
pub const MEMORY: usize = 1024
// A passive adapter's I2C address (drm_dp_dual_mode_helper.c).
pub const ADAPTER_ADDR: usize = 0x40
pub const Monitor = struct {
    there: bool
    bytes: [MEMORY]u8
    count: usize
    // Whether it has a segment pointer (one of two blocks at most often
    // has none, and does not acknowledge its address).
    segments: bool
    // A passive adapter's registers at I2C address 0x40 (DP dual mode:
    // tests/514_gpu_dp_adapter_runtime.mlx), when it has them: a byte
    // written is where the next read begins.
    adapter: bool
    adapterBytes: [32]u8
}
pub var monitors: [6]Monitor = undefined

// The engine.
var buffer: [ddc.I2C_HW_BUFFER_SIZE_DCE100]u8 = undefined
var index: usize = 0
var filled: usize = 0
var forReading = false
var running = false
var looksLeft: usize = 0
var ending: usize = 0
// How many looks at the status a run takes; how many runs were made; how
// many messages the last one got through.
pub var runLooks: usize = 3
// The run takes the wire's time by the clock instead (90 us a byte).
pub var byClock = false
var doneAt: usize = 0
pub var runs: usize = 0
pub var messagesDone: usize = 0
// What the driver did that the engine does not take (0: nothing), the
// first of it.
pub var protocol: usize = 0
pub const NOT_REQUESTED: usize = 1
pub const NOT_ENABLED: usize = 2
pub const WRONG_SPEED: usize = 3
pub const PINS_NOT_THE_ENGINES: usize = 4
pub const PAD_NOT_I2C: usize = 5
pub const HELD_IN_RESET: usize = 6
pub const NO_START: usize = 7
pub const WRONG_DIRECTION: usize = 8
pub const NO_STOP_AT_THE_END: usize = 9
pub const DATA_READ_UNSET: usize = 10
pub const NO_TIME_LIMIT: usize = 11
pub const PULL_DOWNS_OFF: usize = 12
pub const BUFFER_OVERRUN: usize = 13

// What the card can be made to do wrong.
// The engine stays "used by software" for ever (until a soft reset).
pub var staysBusy = false
// The engine says "used by software" before any run, whatever status
// reset is written, until a soft reset.
pub var stuck = false
// The runs whose number's bit is set here (counted from 0) stay "used by
// software" until a soft reset.
pub var busyRuns: usize = 0
var staysNow = false
// From the run number `nackFrom` on (counted from 0), for `nackRuns`
// runs, the message number `nackMessage` is not acknowledged.
pub var nackFrom: usize = NEVER
pub var nackRuns: usize = 0
pub var nackMessage: usize = 0
// Likewise a run that ends in the engine's time limit, or aborted.
pub var limitFrom: usize = NEVER
pub var limitRuns: usize = 0
pub var abortFrom: usize = NEVER
pub var abortRuns: usize = 0
// From the read number `spoilFrom` of an EDID block on (counted from 0,
// reads of 128 bytes), for `spoilReads` reads, a byte comes out wrong.
pub var spoilFrom: usize = NEVER
pub var spoilReads: usize = 0
pub var blockReads: usize = 0
// A register that does not take a write (it keeps what it holds), once
// so many runs were started.
pub var deaf: usize = NEVER
pub var deafFrom: usize = 0
// Bits of the status word that no status reset clears (a missing
// acknowledge or a time limit of an earlier run that stays).
pub var stale: usize = 0

// The log.
pub const LOG: usize = 65536
pub var log: [LOG]u8 = undefined
pub var logged: usize = 0

pub fn raw(number: usize) -> usize { return if number < ROOM { registers[number] } else { 0 } }

pub fn store(number: usize, value: usize) -> void {
    if number < ROOM { registers[number] = value }
}

fn wrong(what: usize) -> void {
    if protocol == 0 { protocol = what }
}

fn within(from: usize, count: usize, at: usize) -> bool { return from != NEVER && at >= from && at < from + count }

// The messages run against what is on the line.
fn run() -> void {
    const control = registers[ddc.DC_I2C_CONTROL]
    const line = (control >> 8) & 7
    const number = runs
    runs += 1
    messagesDone = 0
    running = true
    looksLeft = runLooks
    doneAt = clock
    staysNow = number < 64 && (busyRuns >> @intCast(u6, number)) & 1 != 0
    ending = ddc.DC_I2C_SW_STATUS__DC_I2C_SW_DONE
    // What Linux sets before a run, held.
    if registers[ddc.DC_I2C_ARBITRATION] & ddc.DC_I2C_ARBITRATION__DC_I2C_SW_USE_I2C_REG_REQ == 0 { wrong(NOT_REQUESTED) }
    if line >= 6 {
        wrong(NOT_ENABLED)
    } else {
        const setup = registers[ddc.DC_I2C_DDC1_SETUP + 2 * line]
        const pins = registers[ddc.DC_GPIO_DDC1_MASK + 4 * line]
        if setup & ddc.DC_I2C_DDC1_SETUP__DC_I2C_DDC1_ENABLE == 0 { wrong(NOT_ENABLED) }
        if setup >> 24 == 0 { wrong(NO_TIME_LIMIT) }
        if registers[ddc.DC_I2C_DDC1_SPEED + 2 * line] >> 16 != prescale() { wrong(WRONG_SPEED) }
        if pins & (ddc.DC_GPIO_DDC1_MASK__DC_GPIO_DDC1DATA_MASK | ddc.DC_GPIO_DDC1_MASK__DC_GPIO_DDC1CLK_MASK) != 0 { wrong(PINS_NOT_THE_ENGINES) }
        if pins & ddc.DC_GPIO_DDC1_MASK__AUX_PAD1_MODE != 0 { wrong(PAD_NOT_I2C) }
        if pins & ddc.DC_GPIO_DDC1_MASK__DC_GPIO_DDC1DATA_PD_EN == 0 || pins & ddc.DC_GPIO_DDC1_MASK__DC_GPIO_DDC1CLK_PD_EN == 0 { wrong(PULL_DOWNS_OFF) }
    }
    if control & (ddc.DC_I2C_CONTROL__DC_I2C_SOFT_RESET | ddc.DC_I2C_CONTROL__DC_I2C_SW_STATUS_RESET) != 0 { wrong(HELD_IN_RESET) }
    if protocol != 0 {
        ending = ddc.DC_I2C_SW_STATUS__DC_I2C_SW_ABORTED
        return
    }
    if within(limitFrom, limitRuns, number) {
        ending = ddc.DC_I2C_SW_STATUS__DC_I2C_SW_TIMEOUT
        return
    }
    if within(abortFrom, abortRuns, number) {
        ending = ddc.DC_I2C_SW_STATUS__DC_I2C_SW_ABORTED
        return
    }
    const monitor = &monitors[line]
    const count = ((control >> 20) & 3) + 1
    var segment: usize = 0
    var place: usize = 0
    var adapterPlace: usize = 0
    var next: usize = 0
    var received: usize = 0
    var k: usize = 0
    while k < count {
        const word = registers[ddc.DC_I2C_TRANSACTION0 + k]
        const reading = word & 1 != 0
        const bytes = (word >> 16) & 0x3FF
        if word & ddc.DC_I2C_TRANSACTION0__DC_I2C_START0 == 0 { wrong(NO_START) }
        const address = @intCast(usize, buffer[next])
        next += 1
        if (address & 1 != 0) != reading { wrong(WRONG_DIRECTION) }
        const device = address >> 1
        const atAdapter = device == ADAPTER_ADDR
        var acknowledged = (monitor.*.there && (device == ddc.DDC_ADDR || (device == ddc.DDC_SEGMENT_ADDR && monitor.*.segments))) || (atAdapter && monitor.*.adapter)
        if within(nackFrom, nackRuns, number) && k == nackMessage { acknowledged = false }
        doneAt += (1 + (if acknowledged { bytes } else { 0 })) * 90000
        if !acknowledged {
            const first: usize = 0x1000
            ending = ddc.DC_I2C_SW_STATUS__DC_I2C_SW_STOPPED_ON_NACK | (first << @intCast(u6, k))
            return
        }
        if reading {
            const whole = bytes == ddc.EDID_LENGTH
            var b: usize = 0
            while b < bytes {
                const at = segment * 256 + place
                var value: u8 = if at < monitor.*.count { monitor.*.bytes[at] } else { 0xFF }
                if atAdapter {
                    value = if adapterPlace < 32 { monitor.*.adapterBytes[adapterPlace] } else { 0xFF }
                    adapterPlace += 1
                }
                if whole && b == 40 && within(spoilFrom, spoilReads, blockReads) { value = value ^ 0x10 }
                if filled + received < buffer[0..].length {
                    buffer[filled + received] = value
                } else {
                    wrong(BUFFER_OVERRUN)
                }
                received += 1
                if !atAdapter { place = (place + 1) & 0xFF }
                b += 1
            }
            if whole { blockReads += 1 }
        } else {
            var b: usize = 0
            while b < bytes {
                const value = @intCast(usize, buffer[next])
                next += 1
                if atAdapter {
                    adapterPlace = value
                } else if device == ddc.DDC_SEGMENT_ADDR {
                    segment = value
                } else {
                    place = value
                }
                b += 1
            }
        }
        // (A stop: the segment pointer falls back.)
        if word & ddc.DC_I2C_TRANSACTION0__DC_I2C_STOP0 != 0 { segment = 0 }
        if k + 1 == count && word & ddc.DC_I2C_TRANSACTION0__DC_I2C_STOP0 == 0 { wrong(NO_STOP_AT_THE_END) }
        messagesDone += 1
        k += 1
    }
    if protocol != 0 { ending = ddc.DC_I2C_SW_STATUS__DC_I2C_SW_ABORTED }
}

// The prescale the engine's clock asks for at 100 kHz, as the card's
// time base word and its ROM's crystal give it.
pub var crystal: usize = 100000

pub fn prescale() -> usize {
    const base = registers[ddc.MICROSECOND_TIME_BASE_DIV]
    var divider = (base >> 8) & 0x7F
    if divider == 0 { divider = 2 }
    const source = if base & 0x7F == 0 { (crystal >> 1) * 2 } else { (base & 0x7F) * 1000 }
    return source / divider / 100
}

pub fn read(number: usize) -> u32 {
    reads += 1
    if number >= ROOM { return 0xFFFFFFFF }
    if number == ddc.DC_I2C_SW_STATUS {
        statusReads += 1
        if stuck { return @intCast(u32, ddc.DC_I2C_STATUS__DC_I2C_STATUS_USED_BY_SW) }
        if running {
            const busy = if byClock { clock < doneAt } else { looksLeft != 0 }
            if staysBusy || staysNow || busy {
                if looksLeft != 0 { looksLeft -= 1 }
                return @intCast(u32, ddc.DC_I2C_STATUS__DC_I2C_STATUS_USED_BY_SW)
            }
            running = false
            registers[number] = ending
        }
        return @intCast(u32, registers[number] | stale)
    }
    if number == ddc.DC_I2C_DATA {
        dataReads += 1
        if !forReading { wrong(DATA_READ_UNSET) }
        const value = if index < buffer[0..].length { @intCast(usize, buffer[index]) } else { 0 }
        index += 1
        return @intCast(u32, value << 8)
    }
    return @intCast(u32, registers[number] & 0xFFFFFFFF)
}

pub fn write(number: usize, value: u32) -> void {
    const word = @intCast(usize, value)
    if written < WRITES {
        writtenTo[written] = number
        writtenWith[written] = word
    }
    written += 1
    if number >= ROOM || (number == deaf && runs >= deafFrom) { return }
    if number == ddc.DC_I2C_DATA {
        if word & ddc.DC_I2C_DATA__DC_I2C_INDEX_WRITE != 0 {
            index = (word >> 16) & 0x3FF
            if index == 0 { filled = 0 }
        }
        forReading = word & ddc.DC_I2C_DATA__DC_I2C_DATA_RW != 0
        if !forReading {
            if index < buffer[0..].length {
                buffer[index] = @intCast(u8, (word >> 8) & 0xFF)
            } else {
                wrong(BUFFER_OVERRUN)
            }
            index += 1
            filled = index
        }
        return
    }
    if number == ddc.DC_I2C_CONTROL {
        const was = registers[number]
        registers[number] = word
        if word & ddc.DC_I2C_CONTROL__DC_I2C_SW_STATUS_RESET != 0 && !running { registers[ddc.DC_I2C_SW_STATUS] = 0 }
        if word & ddc.DC_I2C_CONTROL__DC_I2C_SOFT_RESET != 0 {
            running = false
            stuck = false
            registers[ddc.DC_I2C_SW_STATUS] = 0
        }
        if word & ddc.DC_I2C_CONTROL__DC_I2C_GO != 0 && was & ddc.DC_I2C_CONTROL__DC_I2C_GO == 0 { run() }
        return
    }
    if number == ddc.DC_I2C_ARBITRATION {
        // (The status field is the card's to say.)
        registers[number] = (word & ~ddc.DC_I2C_ARBITRATION__DC_I2C_REG_RW_CNTL_STATUS) | (registers[number] & ddc.DC_I2C_ARBITRATION__DC_I2C_REG_RW_CNTL_STATUS)
        return
    }
    registers[number] = word
}

// What happens to the card while the driver looks, by the clock: a
// register takes a value when the clock has come to a time (in the
// order they were put down).
pub const SCRIPT: usize = 64
pub var scriptAt: [SCRIPT]usize = undefined
pub var scriptRegister: [SCRIPT]usize = undefined
pub var scriptValue: [SCRIPT]usize = undefined
pub var scripted: usize = 0
pub var scriptDone: usize = 0

pub fn later(at: usize, number: usize, value: usize) -> void {
    if scripted == SCRIPT { return }
    scriptAt[scripted] = at
    scriptRegister[scripted] = number
    scriptValue[scripted] = value
    scripted += 1
}

// A hot plug line high or low in both sense bits from `at` on.
pub fn lineLater(at: usize, number: usize, high: bool) -> void {
    later(at, plug.DC_HPD_INT_STATUS + (number - 1) * plug.HPD_STEP, if high { plug.DC_HPD_INT_STATUS__DC_HPD_SENSE | plug.DC_HPD_INT_STATUS__DC_HPD_SENSE_DELAYED } else { 0 })
}

fn happen() -> void {
    while scriptDone < scripted && clock >= scriptAt[scriptDone] {
        registers[scriptRegister[scriptDone]] = scriptValue[scriptDone]
        scriptDone += 1
    }
}

pub fn now() -> usize {
    clock += stride
    happen()
    return clock
}

pub fn pause(microseconds: usize) -> void {
    pauses += 1
    paused += microseconds
    clock += microseconds * 1000
}

pub fn logWrite(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length && logged < LOG {
        log[logged] = text[k]
        logged += 1
        k += 1
    }
}

pub fn has(text: []const u8) -> bool { return after(text, 0) != NEVER }

// Where in the log the text ends that is found first from `from` on, or
// NEVER.
pub fn after(text: []const u8, from: usize) -> usize {
    var at = from
    while at + text.length <= logged {
        var k: usize = 0
        while k < text.length && log[at + k] == text[k] { k += 1 }
        if k == text.length { return at + text.length }
        at += 1
    }
    return NEVER
}

pub fn count(text: []const u8) -> usize {
    var found: usize = 0
    var at: usize = 0
    while true {
        at = after(text, at)
        if at == NEVER { return found }
        found += 1
    }
    return found
}

// What was said and written forgotten; the registers and the monitors
// stay.
pub fn forget() -> void {
    logged = 0
    written = 0
    statusReads = 0
    dataReads = 0
    reads = 0
    pauses = 0
    paused = 0
}

// Everything forgotten: no register holds anything, nothing is on any
// line, nothing is wrong with the card. The time base word names 27 MHz
// halved (a prescale of 135 at 100 kHz).
pub fn reset() -> void {
    var k: usize = 0
    while k < ROOM {
        registers[k] = 0
        k += 1
    }
    k = 0
    while k < 6 {
        monitors[k].there = false
        monitors[k].count = 0
        monitors[k].segments = false
        monitors[k].adapter = false
        k += 1
    }
    registers[ddc.MICROSECOND_TIME_BASE_DIV] = 0x021B
    crystal = 100000
    clock = 1000000000
    stride = 0
    index = 0
    filled = 0
    forReading = false
    running = false
    looksLeft = 0
    ending = 0
    runLooks = 3
    runs = 0
    messagesDone = 0
    protocol = 0
    staysBusy = false
    stuck = false
    busyRuns = 0
    staysNow = false
    byClock = false
    doneAt = 0
    nackFrom = NEVER
    nackRuns = 0
    nackMessage = 0
    limitFrom = NEVER
    limitRuns = 0
    abortFrom = NEVER
    abortRuns = 0
    spoilFrom = NEVER
    spoilReads = 0
    blockReads = 0
    deaf = NEVER
    deafFrom = 0
    stale = 0
    scripted = 0
    scriptDone = 0
    forget()
}

pub fn card() -> scanout.Card { return scanout.Card.{ .read = read, .now = now, .write = logWrite } }

pub fn hands() -> ddc.Hands { return ddc.Hands.{ .write = write } }

// A hot plug line (1 to 6) as the firmware of a started card leaves it:
// its block on, its pin the block's, and the line high or low in both
// sense bits.
pub fn line(number: usize, high: bool) -> void {
    const at = (number - 1) * plug.HPD_STEP
    registers[plug.DC_HPD_CONTROL + at] = plug.DC_HPD_CONTROL__DC_HPD_EN | 0x1000
    registers[plug.DC_HPD_INT_STATUS + at] = if high { plug.DC_HPD_INT_STATUS__DC_HPD_SENSE | plug.DC_HPD_INT_STATUS__DC_HPD_SENSE_DELAYED } else { 0 }
    registers[plug.DC_HPD_TOGGLE_FILT_CNTL + at] = 50 | (10 << 20)
}

// The line's two sense bits each by itself.
pub fn sense(number: usize, now: bool, delayed: bool) -> void {
    var word = registers[plug.DC_HPD_INT_STATUS + (number - 1) * plug.HPD_STEP] & ~(plug.DC_HPD_INT_STATUS__DC_HPD_SENSE | plug.DC_HPD_INT_STATUS__DC_HPD_SENSE_DELAYED)
    if now { word |= plug.DC_HPD_INT_STATUS__DC_HPD_SENSE }
    if delayed { word |= plug.DC_HPD_INT_STATUS__DC_HPD_SENSE_DELAYED }
    registers[plug.DC_HPD_INT_STATUS + (number - 1) * plug.HPD_STEP] = word
}

// Controller `controller`'s picture sent by the front end `front`
// through the back end `back` in `mode` (gpu_display's MODE_).
pub fn output(controller: usize, front: usize, back: usize, mode: usize) -> void {
    registers[scanout.OFFSETS[controller] + scanout.CRTC_CONTROL] = 0x1
    registers[scanout.DIG[front] + scanout.DIG_FE_CNTL] = controller
    registers[scanout.DIG[back] + scanout.DIG_BE_EN_CNTL] = 0x1
    const select: usize = 0x100
    registers[scanout.DIG[back] + scanout.DIG_BE_CNTL] = (select << @intCast(u6, front)) | (mode << 16)
}

// A passive adapter's registers on DDC line `on` (0 to 5): `bytes` from
// its address 00h on (none: an adapter without registers, as a type 1
// adapter to DVI may be).
pub fn adapterAt(on: usize, bytes: []const u8) -> void {
    const m = &monitors[on]
    m.*.adapter = bytes.length != 0
    var k: usize = 0
    while k < 32 {
        m.*.adapterBytes[k] = if k < bytes.length { bytes[k] } else { 0 }
        k += 1
    }
}

// A monitor on DDC line `on` (0 to 5) whose EDID is `bytes`.
pub fn monitor(on: usize, bytes: []const u8, segments: bool) -> void {
    const m = &monitors[on]
    m.*.there = true
    m.*.segments = segments
    m.*.count = if bytes.length > MEMORY { MEMORY } else { bytes.length }
    var k: usize = 0
    while k < m.*.count {
        m.*.bytes[k] = bytes[k]
        k += 1
    }
}

pub fn unplug(on: usize) -> void { monitors[on].there = false }

// The ROM's table of DDC lines (data table 10, content revision
// `content`): an entry for each of `registers`, the entry's clock pin's
// register (the others as a real line has them beside it: mask, enable
// and input a number before and one and two after).
pub fn lines(builder: *rom.Builder, content: usize, clockRegisters: []const usize) -> usize {
    const start = builder.openData(10, 1, content)
    var k: usize = 0
    while k < clockRegisters.length {
        const a = clockRegisters[k]
        builder.word(a - 1)
        builder.word(a + 1)
        builder.word(a + 2)
        builder.word(a)
        builder.word(a - 1)
        builder.word(a + 1)
        builder.word(a + 2)
        builder.word(a)
        builder.byte(0x90 | k)
        builder.byte(0)
        builder.byte(0)
        builder.byte(0)
        builder.byte(0)
        builder.byte(8)
        builder.byte(8)
        builder.byte(8)
        builder.byte(8)
        builder.byte(0)
        builder.byte(0)
        k += 1
    }
    builder.closeData()
    return start
}

// A ROM with these connectors (atom_rom.mlx's `objects`: each
// connector's object, its encoder's, its hot plug pin and the entry of
// its DDC line; 0xFF: no such record), the pins placed (`pinIds` by
// `pinShifts` in DC_GPIO_HPD_A), and the table of DDC lines. Finished.
pub fn makeRom(builder: *rom.Builder, connectors: []const usize, encoders: []const usize, pins: []const usize, entries: []const usize, pinIds: []const usize, pinShifts: []const usize, clockRegisters: []const usize) -> void {
    const end = [_]u8{0x5B}
    builder.begin(81, 35)
    _ = builder.command(0, 0, 0, end[0..])
    _ = builder.firmware(crystal, 6000, 200000, 16000, 600000, 625000, 0)
    _ = builder.objects(connectors, encoders, pins, entries)
    var pinRegisters: [8]usize = undefined
    var k: usize = 0
    while k < 8 {
        pinRegisters[k] = 0x488D
        k += 1
    }
    if pinIds.length != 0 { _ = builder.pins(1, pinIds, pinRegisters[0..pinIds.length], pinShifts) }
    if clockRegisters.length != 0 { _ = lines(builder, 1, clockRegisters) }
    builder.finish()
}

// An EDID of `blocks` blocks (1 to 8) into `into`: a base block with the
// header, a name of the test's, one detailed timing (3840x1080 at 60 Hz:
// 266.64 MHz) and the count of extension blocks; a first extension that
// is a CTA block with the HDMI vendor's block (up to 300 MHz) when
// `hdmi`; further extensions of a tag of their own; every block adding
// up to 0. How many bytes.
pub fn edid(into: []u8, blocks: usize, hdmi: bool) -> usize {
    var k: usize = 0
    while k < blocks * 128 {
        into[k] = 0
        k += 1
    }
    k = 1
    while k < 7 {
        into[k] = 0xFF
        k += 1
    }
    into[8] = 0x09
    into[9] = 0x38
    into[18] = 1
    into[19] = 4
    // The detailed timing: 26664 * 10 kHz; 3840 across with 160 of
    // blanking (48 front, 32 sync), 1080 down with 31 (3 front, 10 sync);
    // separate sync, the line's pulse the high one.
    into[54] = 0x28
    into[55] = 0x68
    into[56] = 0x00
    into[57] = 0xA0
    into[58] = 0xF0
    into[59] = 0x38
    into[60] = 0x1F
    into[61] = 0x40
    into[62] = 48
    into[63] = 32
    into[64] = 0x3A
    into[65] = 0x00
    into[71] = 0x1A
    into[126] = @intCast(u8, blocks - 1)
    var b: usize = 1
    while b < blocks {
        const at = b * 128
        if b == 1 {
            // A CTA extension of revision 3: its data blocks end at byte
            // 4 + 8, where no timing follows.
            into[at] = 0x02
            into[at + 1] = 3
            into[at + 2] = if hdmi { 12 } else { 4 }
            if hdmi {
                // The vendor's block: tag 3, seven bytes: 0x000C03, the
                // address 1.0.0.0, no flags, 60 * 5 MHz.
                into[at + 4] = 0x67
                into[at + 5] = 0x03
                into[at + 6] = 0x0C
                into[at + 7] = 0x00
                into[at + 8] = 0x10
                into[at + 9] = 0x00
                into[at + 10] = 0x00
                into[at + 11] = 60
            }
        } else {
            into[at] = 0x40
            into[at + 1] = @intCast(u8, b)
        }
        b += 1
    }
    b = 0
    while b < blocks {
        var sum: usize = 0
        k = 0
        while k < 127 {
            sum += @intCast(usize, into[b * 128 + k])
            k += 1
        }
        into[b * 128 + 127] = @intCast(u8, (256 - (sum & 0xFF)) & 0xFF)
        b += 1
    }
    return blocks * 128
}
