#version 450
// Sample shaders compiled by glslang in tests/run_vulkan.sh and validated
// with std.spirv.module.
layout(local_size_x = 32, local_size_y = 2) in;
layout(set = 0, binding = 0) buffer Data { float scale; uint v[]; } data;
layout(set = 0, binding = 1) uniform sampler2D tex;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D img;
layout(push_constant) uniform P { int mode; uint count; } pc;
shared uint scratch[64];
void main() {
    uint i = gl_GlobalInvocationID.x;
    scratch[gl_LocalInvocationIndex] = i;
    barrier();
    switch (pc.mode) { case 0: data.v[i] = i; break; case 1: data.v[i] *= 2u; break; default: data.v[i] = scratch[(i + 1) % 64]; }
    for (uint k = 0; k < pc.count; ++k) { if ((k & 1u) == 0u) continue; data.v[i] += k; }
    vec4 c = textureLod(tex, vec2(float(i) / 64.0, 0.5), 0.0);
    imageStore(img, ivec2(i, 0), c);
    atomicAdd(data.v[0], 1u);
}
