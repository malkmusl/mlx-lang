// A compute shader written with std.spirv.builder (tests 254 and 255):
//
//     layout(local_size_x = 64) in;
//     layout(set = 0, binding = 0) buffer Data { uint values[]; };
//     void main() { uint i = gl_GlobalInvocationID.x; values[i] = values[i] * 2 + i; }
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")

pub const LOCAL_SIZE: u32 = 64

pub fn build(b: *builder.Builder) -> void {
    builder.capability(b, spv.Capability.shader)
    builder.memoryModel(b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)

    const void_type = builder.typeVoid(b)
    const function_type = builder.typeFunction(b, void_type, null, 0)
    const uint = builder.typeInt(b, 32, false)
    const uvec3 = builder.typeVector(b, uint, 3)
    const input_uvec3 = builder.typePointer(b, spv.StorageClass.input, uvec3)
    const global_id = builder.variable(b, input_uvec3, spv.StorageClass.input)
    const values = builder.typeRuntimeArray(b, uint)
    var members: [1]u32 = [1]u32{ values }
    var data: u32 = 0
    unsafe { data = builder.typeStruct(b, @ptrCast([*]const u32, &members), 1) }
    const data_pointer = builder.typePointer(b, spv.StorageClass.storageBuffer, data)
    const buffer = builder.variable(b, data_pointer, spv.StorageClass.storageBuffer)
    const uint_pointer = builder.typePointer(b, spv.StorageClass.storageBuffer, uint)
    const zero = builder.constant(b, uint, 0)
    const two = builder.constant(b, uint, 2)

    builder.decorateBuiltIn(b, global_id, spv.BuiltIn.globalInvocationId)
    builder.decorateValue(b, values, spv.Decoration.arrayStride, 4)
    builder.memberDecorateValue(b, data, 0, spv.Decoration.offset, 0)
    builder.decorate(b, data, spv.Decoration.block)
    builder.decorateValue(b, buffer, spv.Decoration.descriptorSet, 0)
    builder.decorateValue(b, buffer, spv.Decoration.binding, 0)

    const main = builder.function(b, void_type, spv.FUNCTION_CONTROL_NONE, function_type)
    const entry = builder.label(b)
    const id = builder.load(b, uvec3, global_id)
    const index = builder.compositeExtract(b, uint, id, 0)
    var chain: [2]u32 = [2]u32{ zero, index }
    var element: u32 = 0
    unsafe { element = builder.accessChain(b, uint_pointer, buffer, @ptrCast([*]const u32, &chain), 2) }
    const value = builder.load(b, uint, element)
    const doubled = builder.binary(b, spv.Op.iMul, uint, value, two)
    const sum = builder.binary(b, spv.Op.iAdd, uint, doubled, index)
    builder.store(b, element, sum)
    builder.returnVoid(b)
    builder.functionEnd(b)

    var interfaces: [1]u32 = [1]u32{ global_id }
    unsafe { builder.entryPoint(b, spv.ExecutionModel.glCompute, main, "main", @ptrCast([*]const u32, &interfaces), 1) }
    builder.localSize(b, main, LOCAL_SIZE, 1, 1)
    builder.name(b, main, "main")
    builder.name(b, buffer, "data")
}
