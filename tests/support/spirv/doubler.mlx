// A compute shader written with std.spirv.builder (tests 254, 255 and
// 508): the doubler of our Vulkan driver's self-test, which is kept beside
// the driver (projects/brix/vulkan/doubler.mlx: it is the driver's own),
// given here as before:
//
//     layout(local_size_x = 64) in;
//     layout(set = 0, binding = 0) buffer Data { uint values[]; };
//     void main() { uint i = gl_GlobalInvocationID.x; values[i] = values[i] * 2 + i; }
const builder = @import("std.spirv.builder")
const own = @import("../../../projects/brix/vulkan/doubler.mlx")

pub const LOCAL_SIZE: u32 = own.LOCAL_SIZE

pub fn build(b: *builder.Builder) -> void { own.build(b) }
