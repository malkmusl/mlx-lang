// A fragment shader of float operations for test 516 (its reviewer's),
// written with std.spirv.builder: each component of its colour one
// operation of the compiler's float path whose operands are not
// symmetric, so that an operand swapped or a condition turned round shows:
//
//   layout(location = 0) flat in vec3 shade;
//   layout(location = 0) out vec4 colour;
//   void main() {
//       colour = vec4(shade.r - 0.25,                  // OpFSub, a constant second
//                     shade.g <= 0.5 ? 1.0 : 0.0,      // OpFOrdLessThanEqual, OpSelect
//                     mix(shade.b, 1.0, 0.25),         // GLSL.std.450 FMix
//                     fract(shade.r + 1.25));          // OpFAdd, GLSL.std.450 Fract
//   }
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")

fn ids(list: []const u32) -> [*]const u32 { return list.pointer }

fn extended(b: *builder.Builder, type_id: u32, set: u32, which: u32, operands_: []const u32) -> u32 {
    const id = builder.newId(b)
    var operands: [7]u32 = undefined
    operands[0] = type_id
    operands[1] = id
    operands[2] = set
    operands[3] = which
    var k: usize = 0
    while k < operands_.length {
        operands[4 + k] = operands_[k]
        k += 1
    }
    builder.instruction(b, builder.SECTION_FUNCTION, spv.Op.extInst, ids(operands[0..]), 4 + operands_.length)
    return id
}

fn construct(b: *builder.Builder, type_id: u32, parts: []const u32) -> u32 {
    const id = builder.newId(b)
    var operands: [6]u32 = undefined
    operands[0] = type_id
    operands[1] = id
    var k: usize = 0
    while k < parts.length {
        operands[2 + k] = parts[k]
        k += 1
    }
    builder.instruction(b, builder.SECTION_FUNCTION, spv.Op.compositeConstruct, ids(operands[0..]), 2 + parts.length)
    return id
}

// GLSL.std.450's numbers (Mesa's src/compiler/spirv/GLSL.std.450.h).
const FRACT: u32 = 10
const FMIX: u32 = 46

pub fn reckoned(b: *builder.Builder) -> void {
    builder.capability(b, spv.Capability.shader)
    const glsl = builder.extInstImport(b, "GLSL.std.450")
    builder.memoryModel(b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)
    const void_type = builder.typeVoid(b)
    const function_type = builder.typeFunction(b, void_type, null, 0)
    const float = builder.typeFloat(b, 32)
    const vec3 = builder.typeVector(b, float, 3)
    const vec4 = builder.typeVector(b, float, 4)
    const bool_type = builder.typeBool(b)
    const zero = builder.constant(b, float, 0)
    const one = builder.constant(b, float, 0x3F800000)
    const quarter = builder.constant(b, float, 0x3E800000)
    const half = builder.constant(b, float, 0x3F000000)
    const five_quarters = builder.constant(b, float, 0x3FA00000)
    const shade = builder.variable(b, builder.typePointer(b, spv.StorageClass.input, vec3), spv.StorageClass.input)
    const colour = builder.variable(b, builder.typePointer(b, spv.StorageClass.output, vec4), spv.StorageClass.output)
    builder.decorateValue(b, shade, spv.Decoration.location, 0)
    builder.decorate(b, shade, spv.Decoration.flat)
    builder.decorateValue(b, colour, spv.Decoration.location, 0)
    const main = builder.function(b, void_type, spv.FUNCTION_CONTROL_NONE, function_type)
    _ = builder.label(b)
    const s = builder.load(b, vec3, shade)
    const r = builder.compositeExtract(b, float, s, 0)
    const g = builder.compositeExtract(b, float, s, 1)
    const bl = builder.compositeExtract(b, float, s, 2)
    const red = builder.binary(b, spv.Op.fSub, float, r, quarter)
    const low = builder.binary(b, spv.Op.fOrdLessThanEqual, bool_type, g, half)
    const green = builder.newId(b)
    const select_operands = [5]u32{ float, green, low, one, zero }
    builder.instruction(b, builder.SECTION_FUNCTION, spv.Op.select, ids(select_operands[0..]), 5)
    const mix_operands = [3]u32{ bl, one, quarter }
    const blue = extended(b, float, glsl, FMIX, mix_operands[0..])
    const fract_operands = [1]u32{ builder.binary(b, spv.Op.fAdd, float, r, five_quarters) }
    const alpha = extended(b, float, glsl, FRACT, fract_operands[0..])
    const parts = [4]u32{ red, green, blue, alpha }
    builder.store(b, colour, construct(b, vec4, parts[0..]))
    builder.returnVoid(b)
    builder.functionEnd(b)
    const interfaces = [2]u32{ shade, colour }
    builder.entryPoint(b, spv.ExecutionModel.fragment, main, "main", ids(interfaces[0..]), 2)
    builder.executionMode(b, main, spv.ExecutionMode.originUpperLeft, null, 0)
}
