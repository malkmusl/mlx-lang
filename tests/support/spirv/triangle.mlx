// The shaders of the first triangle (our Vulkan driver's stage (c): tests
// 515 and 516), written with std.spirv.builder:
//
//   vertex (`vertex`):
//     layout(location = 0) in vec2 position;
//     layout(location = 1) in vec3 colour;
//     layout(location = 0) out vec3 shade;
//     void main() { gl_Position = vec4(position, 0.0, 1.0); shade = colour; }
//   vertex through a matrix (`transformed`), the position in gl_PerVertex:
//     layout(push_constant) uniform Push { mat4 transform; float scale; } push;
//     out gl_PerVertex { vec4 gl_Position; float gl_PointSize; };
//     void main() { gl_Position = push.transform * vec4(position * push.scale, 0.0, 1.0); shade = colour; }
//   fragment (`fragment`):
//     layout(location = 0) in vec3 shade;
//     layout(location = 0) out vec4 colour;
//     void main() { colour = vec4(shade, 1.0); }
//   fragment of one colour (`flat`): the input flat
//     layout(location = 0) flat in vec3 shade; ... the same
//   fragment that works (`worked`): clamps, mixes and compares
//     void main() {
//         vec3 c = clamp(shade * 1.5 - vec3(0.25), 0.0, 1.0);
//         float m = max(c.r, max(c.g, c.b));
//         colour = m > 0.5 ? vec4(c, 1.0) : vec4(mix(c, vec3(1.0), 0.5), 0.5);
//     }
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")

fn ids(list: []const u32) -> [*]const u32 { return list.pointer }

pub const Kind = enum(u8) {
    vertex,
    transformed,
    fragment,
    flat,
    worked,
}

pub fn build(b: *builder.Builder, kind: Kind) -> void {
    builder.capability(b, spv.Capability.shader)
    const glsl = if kind == Kind.worked { builder.extInstImport(b, "GLSL.std.450") } else { 0 }
    builder.memoryModel(b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)
    const void_type = builder.typeVoid(b)
    const function_type = builder.typeFunction(b, void_type, null, 0)
    const float = builder.typeFloat(b, 32)
    const vec2 = builder.typeVector(b, float, 2)
    const vec3 = builder.typeVector(b, float, 3)
    const vec4 = builder.typeVector(b, float, 4)
    const zero = builder.constant(b, float, 0)
    const one = builder.constant(b, float, 0x3F800000)
    if kind == Kind.vertex || kind == Kind.transformed {
        const input_vec2 = builder.typePointer(b, spv.StorageClass.input, vec2)
        const input_vec3 = builder.typePointer(b, spv.StorageClass.input, vec3)
        const output_vec3 = builder.typePointer(b, spv.StorageClass.output, vec3)
        const output_vec4 = builder.typePointer(b, spv.StorageClass.output, vec4)
        const position = builder.variable(b, input_vec2, spv.StorageClass.input)
        const colour = builder.variable(b, input_vec3, spv.StorageClass.input)
        const shade = builder.variable(b, output_vec3, spv.StorageClass.output)
        builder.decorateValue(b, position, spv.Decoration.location, 0)
        builder.decorateValue(b, colour, spv.Decoration.location, 1)
        builder.decorateValue(b, shade, spv.Decoration.location, 0)
        var out_position: u32 = 0
        var per_vertex: u32 = 0
        var push: u32 = 0
        var mat4: u32 = 0
        var push_mat4: u32 = 0
        var push_float: u32 = 0
        const int = builder.typeInt(b, 32, true)
        const index0 = builder.constant(b, int, 0)
        const index1 = builder.constant(b, int, 1)
        if kind == Kind.vertex {
            out_position = builder.variable(b, output_vec4, spv.StorageClass.output)
            builder.decorateBuiltIn(b, out_position, spv.BuiltIn.position)
        } else {
            const members = [2]u32{ vec4, float }
            const block = builder.typeStruct(b, ids(members[0..]), 2)
            builder.memberDecorateValue(b, block, 0, spv.Decoration.builtIn, @intCast(u32, @intFromEnum(spv.BuiltIn.position)))
            builder.memberDecorateValue(b, block, 1, spv.Decoration.builtIn, @intCast(u32, @intFromEnum(spv.BuiltIn.pointSize)))
            builder.decorate(b, block, spv.Decoration.block)
            const block_pointer = builder.typePointer(b, spv.StorageClass.output, block)
            per_vertex = builder.variable(b, block_pointer, spv.StorageClass.output)
            mat4 = typeMatrix(b, vec4, 4)
            const push_members = [2]u32{ mat4, float }
            const push_block = builder.typeStruct(b, ids(push_members[0..]), 2)
            builder.memberDecorateValue(b, push_block, 0, spv.Decoration.offset, 0)
            builder.op3(b, builder.SECTION_ANNOTATION, spv.Op.memberDecorate, push_block, 0, @intFromEnum(spv.Decoration.colMajor))
            builder.memberDecorateValue(b, push_block, 0, spv.Decoration.matrixStride, 16)
            builder.memberDecorateValue(b, push_block, 1, spv.Decoration.offset, 64)
            builder.decorate(b, push_block, spv.Decoration.block)
            const push_pointer = builder.typePointer(b, spv.StorageClass.pushConstant, push_block)
            push = builder.variable(b, push_pointer, spv.StorageClass.pushConstant)
            push_mat4 = builder.typePointer(b, spv.StorageClass.pushConstant, mat4)
            push_float = builder.typePointer(b, spv.StorageClass.pushConstant, float)
        }
        const main = builder.function(b, void_type, spv.FUNCTION_CONTROL_NONE, function_type)
        _ = builder.label(b)
        var xy = builder.load(b, vec2, position)
        if kind == Kind.transformed {
            const chain = [1]u32{ index1 }
            const scale_pointer = builder.accessChain(b, push_float, push, ids(chain[0..]), 1)
            const scale = builder.load(b, float, scale_pointer)
            xy = builder.binary(b, spv.Op.vectorTimesScalar, vec2, xy, scale)
        }
        const x = builder.compositeExtract(b, float, xy, 0)
        const y = builder.compositeExtract(b, float, xy, 1)
        const parts = [4]u32{ x, y, zero, one }
        var point = construct(b, vec4, parts[0..])
        if kind == Kind.vertex {
            builder.store(b, out_position, point)
        } else {
            const chain = [1]u32{ index0 }
            const transform_pointer = builder.accessChain(b, push_mat4, push, ids(chain[0..]), 1)
            const transform = builder.load(b, mat4, transform_pointer)
            point = builder.binary(b, spv.Op.matrixTimesVector, vec4, transform, point)
            const position_pointer = builder.accessChain(b, output_vec4, per_vertex, ids(chain[0..]), 1)
            builder.store(b, position_pointer, point)
        }
        const c = builder.load(b, vec3, colour)
        builder.store(b, shade, c)
        builder.returnVoid(b)
        builder.functionEnd(b)
        const interfaces = [4]u32{ position, colour, shade, if kind == Kind.vertex { out_position } else { per_vertex } }
        if kind == Kind.transformed {
            const all = [5]u32{ position, colour, shade, per_vertex, push }
            builder.entryPoint(b, spv.ExecutionModel.vertex, main, "main", ids(all[0..]), 4)
        } else {
            builder.entryPoint(b, spv.ExecutionModel.vertex, main, "main", ids(interfaces[0..]), 4)
        }
        return
    }
    const input_vec3 = builder.typePointer(b, spv.StorageClass.input, vec3)
    const output_vec4 = builder.typePointer(b, spv.StorageClass.output, vec4)
    const shade = builder.variable(b, input_vec3, spv.StorageClass.input)
    const colour = builder.variable(b, output_vec4, spv.StorageClass.output)
    builder.decorateValue(b, shade, spv.Decoration.location, 0)
    if kind == Kind.flat { builder.decorate(b, shade, spv.Decoration.flat) }
    builder.decorateValue(b, colour, spv.Decoration.location, 0)
    var quarter: u32 = 0
    var half: u32 = 0
    var three_halves: u32 = 0
    var bool_type: u32 = 0
    if kind == Kind.worked {
        quarter = builder.constant(b, float, 0x3E800000)
        half = builder.constant(b, float, 0x3F000000)
        three_halves = builder.constant(b, float, 0x3FC00000)
        bool_type = builder.typeBool(b)
    }
    const main = builder.function(b, void_type, spv.FUNCTION_CONTROL_NONE, function_type)
    _ = builder.label(b)
    const s = builder.load(b, vec3, shade)
    if kind != Kind.worked {
        const r = builder.compositeExtract(b, float, s, 0)
        const g = builder.compositeExtract(b, float, s, 1)
        const bl = builder.compositeExtract(b, float, s, 2)
        const parts = [4]u32{ r, g, bl, one }
        builder.store(b, colour, construct(b, vec4, parts[0..]))
    } else {
        const quarters = [3]u32{ quarter, quarter, quarter }
        const shifted = builder.binary(b, spv.Op.fSub, vec3, builder.binary(b, spv.Op.vectorTimesScalar, vec3, s, three_halves), construct(b, vec3, quarters[0..]))
        const zeros = [3]u32{ zero, zero, zero }
        const ones = [3]u32{ one, one, one }
        const low = construct(b, vec3, zeros[0..])
        const high = construct(b, vec3, ones[0..])
        const c = extended(b, vec3, glsl, 43, shifted, low, high)
        const r = builder.compositeExtract(b, float, c, 0)
        const g = builder.compositeExtract(b, float, c, 1)
        const bl = builder.compositeExtract(b, float, c, 2)
        const m = extended(b, float, glsl, 40, r, extended(b, float, glsl, 40, g, bl, 0), 0)
        const bright = builder.binary(b, spv.Op.fOrdGreaterThan, bool_type, m, half)
        const strong_parts = [4]u32{ r, g, bl, one }
        const strong = construct(b, vec4, strong_parts[0..])
        const halves = [3]u32{ half, half, half }
        const mixed = extended(b, vec3, glsl, 46, c, high, construct(b, vec3, halves[0..]))
        const weak_parts = [2]u32{ mixed, half }
        const weak = construct(b, vec4, weak_parts[0..])
        const picked = select(b, vec4, bright, strong, weak)
        builder.store(b, colour, picked)
    }
    builder.returnVoid(b)
    builder.functionEnd(b)
    const interfaces = [2]u32{ shade, colour }
    builder.entryPoint(b, spv.ExecutionModel.fragment, main, "main", ids(interfaces[0..]), 2)
    builder.executionMode(b, main, spv.ExecutionMode.originUpperLeft, null, 0)
}

fn typeMatrix(b: *builder.Builder, column: u32, count: u32) -> u32 {
    const id = builder.newId(b)
    builder.op3(b, builder.SECTION_GLOBAL, spv.Op.typeMatrix, id, column, count)
    return id
}

// OpCompositeConstruct of `parts`.
fn construct(b: *builder.Builder, type_id: u32, parts: []const u32) -> u32 {
    const id = builder.newId(b)
    var operands: [6]u32 = undefined
    operands[0] = type_id
    operands[1] = id
    var k: usize = 0
    while k < parts.length {
        operands[2 + k] = parts[k]
        k += 1
    }
    builder.instruction(b, builder.SECTION_FUNCTION, spv.Op.compositeConstruct, ids(operands[0..]), 2 + parts.length)
    return id
}

// OpExtInst of GLSL.std.450 (`which`), one to three operands (0: none).
fn extended(b: *builder.Builder, type_id: u32, set: u32, which: u32, x: u32, y: u32, z: u32) -> u32 {
    const id = builder.newId(b)
    var operands: [7]u32 = undefined
    operands[0] = type_id
    operands[1] = id
    operands[2] = set
    operands[3] = which
    operands[4] = x
    var count: usize = 5
    if y != 0 {
        operands[5] = y
        count = 6
    }
    if z != 0 {
        operands[6] = z
        count = 7
    }
    builder.instruction(b, builder.SECTION_FUNCTION, spv.Op.extInst, ids(operands[0..]), count)
    return id
}

fn select(b: *builder.Builder, type_id: u32, condition: u32, yes: u32, no: u32) -> u32 {
    const id = builder.newId(b)
    const operands = [5]u32{ type_id, id, condition, yes, no }
    builder.instruction(b, builder.SECTION_FUNCTION, spv.Op.select, ids(operands[0..]), 5)
    return id
}
