// std.ui.terminal_input without a window (for tools/check_terminal.sh):
// selections by cells, words and lines (and across a wrapped line and a
// history that drops lines), the mouse reports a program asks for (SGR and
// X10, Shift still selecting), the wheel on the alternate screen, the
// paste filter and dropped files as quoted paths. Exits 0 on success, else
// the number of the check that failed.
const std = @import("std")
const ui = @import("std.ui")
const terminal = @import("std.terminal")
const ui_terminal = @import("std.ui.terminal")
const input = @import("std.ui.terminal_input")
const ui_keys = @import("std.ui.keys")

const CELL_WIDTH: i32 = 8
const CELL_HEIGHT: i32 = 16
const PADDING: i32 = 4
const LEFT: u32 = 272

fn escape(screen: *terminal.Screen, sequence: []const u8) -> void {
    terminal.feedByte(screen, 27)
    terminal.feed(screen, sequence)
}

// A view without a font: cells of CELL_WIDTH x CELL_HEIGHT pixels.
fn setUp(view: *ui_terminal.View, screen: *terminal.Screen) -> void {
    view.*.screen = screen
    view.*.cellWidth = CELL_WIDTH
    view.*.cellHeight = CELL_HEIGHT
    view.*.fontHeight = 15
    view.*.padding = PADDING
    view.*.hasSelection = false
    view.*.selecting = false
    view.*.selectionUnit = 1
    view.*.seenHistoryCount = screen.*.historyCount
    view.*.seenHistoryStart = screen.*.historyStart
    view.*.seenAlternate = screen.*.onAlternate
    view.*.pressTime = 0
    view.*.pressCount = 0
    view.*.reportedButton = ui_terminal.NO_BUTTON
}

// The middle of cell (row, column), and the boundary before it.
fn cellX(column: i32) -> i32 { return PADDING + column * CELL_WIDTH + CELL_WIDTH / 2 }
fn edgeX(column: i32) -> i32 { return PADDING + column * CELL_WIDTH + 1 }
fn rowY(row: i32) -> i32 { return PADDING + row * CELL_HEIGHT + CELL_HEIGHT / 2 }

fn area() -> ui.Rect { return ui.rect(0, 0, PADDING * 2 + 20 * CELL_WIDTH, PADDING * 2 + 4 * CELL_HEIGHT) }

// A drag from boundary (row, column) to (to_row, to_column).
fn drag(view: *ui_terminal.View, row: i32, column: i32, to_row: i32, to_column: i32, now: usize) -> void {
    var out: [64]u8 = undefined
    _ = input.press(view, area(), edgeX(column), rowY(row), LEFT, 0, now, &out)
    _ = input.motion(view, area(), edgeX(to_column), rowY(to_row), 0, &out)
    _ = input.release(view, area(), edgeX(to_column), rowY(to_row), LEFT, 0, &out)
}

// Clicks `count` times in a row on cell (row, column).
fn clicks(view: *ui_terminal.View, row: i32, column: i32, count: usize, now: usize) -> void {
    var out: [64]u8 = undefined
    var index: usize = 0
    while index < count {
        _ = input.press(view, area(), cellX(column), rowY(row), LEFT, 0, now + index * 100, &out)
        _ = input.release(view, area(), cellX(column), rowY(row), LEFT, 0, &out)
        index += 1
    }
}

fn selected(view: *ui_terminal.View, expected: []const u8) -> bool {
    var buffer: [512]u8 = undefined
    const length = input.selectedText(view, &buffer, 512)
    const bytes: [*]const u8 = &buffer
    return std.text.same(bytes[0..length], expected)
}

fn bytesAre(out: [*]const u8, length: usize, expected: []const u8) -> bool {
    return std.text.same(out[0..length], expected)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var screen: terminal.Screen = undefined
    if !terminal.init(&screen, allocator, 20, 4, 10) { return 1 }
    var view: ui_terminal.View = undefined
    setUp(&view, &screen)
    terminal.feed(&screen, "hello world\r\nsecond line\r\n")
    // 2: a drag over "hello"; 3: a double click on "world"; 4: a triple
    // click takes the line, its blanks gone; 5: a drag over two lines.
    drag(&view, 0, 0, 0, 5, 1000)
    if !selected(&view, "hello") { return 2 }
    clicks(&view, 0, 8, 2, 5000)
    if !selected(&view, "world") { return 3 }
    clicks(&view, 0, 2, 3, 9000)
    if !selected(&view, "hello world") { return 4 }
    drag(&view, 0, 6, 1, 6, 13000)
    if !selected(&view, "world\nsecond") { return 5 }
    // 26: Shift and a click move the far end of the selection.
    drag(&view, 0, 0, 0, 5, 15000)
    var shift_out: [64]u8 = undefined
    _ = input.press(&view, area(), edgeX(11), rowY(0), LEFT, ui_keys.SHIFT, 16000, &shift_out)
    _ = input.release(&view, area(), edgeX(11), rowY(0), LEFT, ui_keys.SHIFT, &shift_out)
    if !selected(&view, "hello world") { return 26 }
    // 6: a click alone selects nothing.
    clicks(&view, 1, 3, 1, 17000)
    if view.hasSelection { return 6 }
    // 7: a line the program wrapped is one line of text (it scrolled the
    // screen a line: it is on rows 1 and 2).
    terminal.feed(&screen, "abcdefghijklmnopqrstuvwxy\r\n")
    input.follow(&view)
    drag(&view, 1, 0, 2, 5, 21000)
    if !selected(&view, "abcdefghijklmnopqrstuvwxy") { return 7 }
    // 8: lines dropped off the history's top move the selection with
    // them (10 lines of history, 4 on the screen: feed enough to fill it
    // and then some).
    var line: usize = 0
    while line < 12 {
        terminal.feed(&screen, "filler\r\n")
        line += 1
    }
    input.follow(&view)
    terminal.feed(&screen, "marked text\r\n")
    terminal.feed(&screen, "after\r\n")
    input.follow(&view)
    // "marked text" is two lines above the cursor's line (row 3): row 1.
    clicks(&view, 1, 0, 3, 30000)
    if !selected(&view, "marked text") { return 8 }
    terminal.feed(&screen, "one\r\ntwo\r\nthree\r\n")
    input.follow(&view)
    if !selected(&view, "marked text") { return 9 }
    // 10: the program asks for the mouse in SGR: a press and a release on
    // cell (row 1, column 2) are reported, not selected.
    var out: [64]u8 = undefined
    const out_bytes: [*]const u8 = &out
    escape(&screen, "[?1000h")
    escape(&screen, "[?1006h")
    var length = input.press(&view, area(), cellX(2), rowY(1), LEFT, 0, 40000, &out)
    if !bytesAre(out_bytes, length, "\x1b[<0;3;2M") { return 10 }
    length = input.release(&view, area(), cellX(2), rowY(1), LEFT, 0, &out)
    if !bytesAre(out_bytes, length, "\x1b[<0;3;2m") { return 11 }
    // 12: Ctrl adds 16; the wheel up is 64.
    length = input.press(&view, area(), cellX(0), rowY(0), 274, ui_keys.CONTROL, 41000, &out)
    if !bytesAre(out_bytes, length, "\x1b[<17;1;1M") { return 12 }
    _ = input.release(&view, area(), cellX(0), rowY(0), 274, ui_keys.CONTROL, &out)
    length = input.wheel(&view, area(), cellX(4), rowY(3), -1, 0, &out)
    if !bytesAre(out_bytes, length, "\x1b[<64;5;4M") { return 13 }
    // 14: X10 encoding: ESC [ M and three bytes; a release is code 3.
    escape(&screen, "[?1006l")
    length = input.press(&view, area(), cellX(2), rowY(1), LEFT, 0, 42000, &out)
    if !bytesAre(out_bytes, length, "\x1b[M #\"") { return 14 }
    length = input.release(&view, area(), cellX(2), rowY(1), LEFT, 0, &out)
    if !bytesAre(out_bytes, length, "\x1b[M##\"") { return 15 }
    // 16: Shift still selects while the program has the mouse.
    length = input.press(&view, area(), edgeX(0), rowY(2), LEFT, ui_keys.SHIFT, 43000, &out)
    _ = input.motion(&view, area(), edgeX(3), rowY(2), ui_keys.SHIFT, &out)
    _ = input.release(&view, area(), edgeX(3), rowY(2), LEFT, ui_keys.SHIFT, &out)
    if length != 0 || !selected(&view, "thr") { return 16 }
    escape(&screen, "[?1000l")
    // 17: on the alternate screen the wheel sends arrow keys, and going
    // there ends the selection.
    escape(&screen, "[?1049h")
    input.follow(&view)
    if view.hasSelection { return 17 }
    length = input.wheel(&view, area(), cellX(0), rowY(0), 1, 0, &out)
    if !bytesAre(out_bytes, length, "\x1b[B\x1b[B\x1b[B") { return 18 }
    escape(&screen, "[?1049l")
    // 19: a paste loses its escapes and other controls, CR LF and LF
    // become CR, a C1 control (U+009B) goes, tabs and UTF-8 stay.
    const pasted = "ls\nrm x\x1b[201~y\r\n\x07a\tb\xc2\x9bc\xc3\xa4"
    var filtered: [64]u8 = undefined
    var written: usize = 0
    const stopped = input.filterPaste(pasted, 0, &filtered, 64, &written)
    const filtered_bytes: [*]const u8 = &filtered
    if stopped != pasted.length || !bytesAre(filtered_bytes, written, "ls\rrm x[201~y\ra\tbc\xc3\xa4") { return 19 }
    // 20: a short buffer takes the paste in parts.
    var first_part: [4]u8 = undefined
    const next = input.filterPaste(pasted, 0, &first_part, 4, &written)
    if next != 4 || written != 4 { return 20 }
    // 21: bracketed paste when asked.
    if input.pasteBegin(&view, &out) != 0 { return 21 }
    escape(&screen, "[?2004h")
    length = input.pasteBegin(&view, &out)
    if !bytesAre(out_bytes, length, "\x1b[200~") { return 22 }
    length = input.pasteEnd(&view, &out)
    if !bytesAre(out_bytes, length, "\x1b[201~") { return 23 }
    // 24: dropped files as quoted paths; 25: only whole paths fit.
    const list = "file:///home/u/a%20b.txt\r\n# a comment\r\nfile://localhost/tmp/it's\r\n"
    var paths: [128]u8 = undefined
    const paths_bytes: [*]const u8 = &paths
    length = input.quotedPaths(list, &paths, 128)
    if !bytesAre(paths_bytes, length, "'/home/u/a b.txt' '/tmp/it'\\''s' ") { return 24 }
    length = input.quotedPaths(list, &paths, 24)
    if !bytesAre(paths_bytes, length, "'/home/u/a b.txt' ") { return 25 }
    return 0
}
