// The user's whole Radeon as a table with a DisplayPort monitor, for the
// tests of the picture brought to and from a DisplayPort output
// (tests/510_gpu_dp_switch_runtime.mlx): tests/support/switch_card.mlx's
// card (the display, the card's tables as programs of the test's, the hot
// plug lines, the I2C engine with an EDID memory behind each DDC line, the
// user's five connectors in the ROM) and tests/support/dp_monitor.mlx's
// monitor behind an AUX channel (its registers, its EDID behind the I2C
// bridge, lanes that lock by what the card sends, the DTO's frame
// counter). The monitor is one: it is on one of the two DisplayPort
// connectors at a time (connector 0: DIG 2, hot plug line 1, AUX channel
// 1; connector 1: DIG 3, line 5, channel 3), or on none, and moving it is
// its cable moved. A register goes to the plug card as switch_card.mlx
// sends it there, but for the DDC pins' words of the two DisplayPort
// connectors, which are the AUX channel's (nothing asks those monitors
// over DDC); every other one to the monitor's side, which gives the
// display card's own for what it does not model.
// Nothing of a real card's ROM or of a real monitor is in here.
const scanout = @import("../../projects/brix/kernel/gpu_display.mlx")
const plug = @import("../../projects/brix/kernel/gpu_plug.mlx")
const ddc = @import("../../projects/brix/kernel/gpu_ddc.mlx")
const atom = @import("../../projects/brix/kernel/atom.mlx")
const display = @import("./tmds_card.mlx")
const lines = @import("./plug_card.mlx")
const sw = @import("./switch_card.mlx")
const sink = @import("./dp_monitor.mlx")

pub const NEVER: usize = 0xFFFFFFFF
// The two DisplayPort connectors: their back ends, hot plug lines (1 to
// 6) and AUX channels (the DDC entries the ROM names: entry n is line n).
pub const DP_BACK_ENDS = [_]usize{ 2, 3 }
pub const DP_LINES = [_]usize{ 1, 5 }
pub const DP_CHANNELS = [_]usize{ 1, 3 }
// Where the monitor is when it is on no connector: an AUX channel and a
// back end nothing uses.
const NOWHERE_CHANNEL: usize = 5
const NOWHERE_BACK: usize = 6

// The connector the monitor is on (0 or 1; NEVER: none).
pub var on: usize = NEVER
// How often the short pulse's latch was acknowledged.
pub var acks: usize = 0
// The DisplayPort connector a passive adapter is plugged into (0 or 1;
// NEVER: none): its DDC line's pins are the plug card's I2C engine's then
// (tests/514_gpu_dp_adapter_runtime.mlx), as an HDMI connector's are.
pub var adapterOn: usize = NEVER

fn dpPins(number: usize) -> bool {
    var k: usize = 0
    while k < 2 {
        const at = ddc.DC_GPIO_DDC1_MASK + 4 * DP_CHANNELS[k]
        if k != adapterOn && number >= at && number < at + 4 { return true }
        k += 1
    }
    return false
}

fn auxRegister(number: usize) -> bool {
    if number == 0x483B || number == 0x483C || dpPins(number) { return true }
    return number >= 0x5C00 && number < 0x5C00 + 0x1C * 6
}

fn theirs(number: usize) -> bool {
    if dpPins(number) { return false }
    if number >= plug.DC_HPD_INT_STATUS && number < plug.DC_HPD_INT_STATUS + 6 * plug.HPD_STEP { return true }
    if number == plug.DC_GPIO_HPD_MASK || number == 0x488D { return true }
    if number >= ddc.DC_I2C_CONTROL && number <= ddc.DC_I2C_DATA { return true }
    if number >= ddc.DC_GPIO_DDC1_MASK && number < ddc.DC_GPIO_DDC1_MASK + 4 * ddc.LINES { return true }
    return number == ddc.MICROSECOND_TIME_BASE_DIV
}

// The monitor's side reads the hot plug line it watches in the display
// card's registers: the plug card's lines copied there.
fn sync() -> void {
    var h: usize = 0
    while h < 6 {
        display.store(plug.DC_HPD_INT_STATUS + plug.HPD_STEP * h, lines.registers[plug.DC_HPD_INT_STATUS + plug.HPD_STEP * h])
        h += 1
    }
}

pub fn read(number: usize) -> u32 {
    if theirs(number) { return lines.read(number) }
    sync()
    return sink.read(number)
}

// The driver's own writes of the display.
pub fn write(number: usize, value: u32) -> void {
    if theirs(number) {
        lines.write(number, value)
        return
    }
    display.write(number, value)
}

// The AUX channel's writes (gpu_aux.mlx's Port).
pub fn auxWrite(number: usize, value: u32) -> void {
    sync()
    sink.auxWrite(number, value)
}

// A hot plug line's interrupt word written (gpu_dpwatch.mlx's
// acknowledgement of a short pulse): the latch cleared.
pub fn ackWrite(number: usize, value: u32) -> void {
    if number >= 0x1899 && number < 0x1899 + 6 * plug.HPD_STEP && (number - 0x1899) % plug.HPD_STEP == 0 && @intCast(usize, value) & 0x100000 != 0 {
        acks += 1
        const status = number - 1
        lines.registers[status] = lines.registers[status] & ~@intCast(usize, 0x100)
    }
    lines.write(number, value & ~@intCast(u32, 0x100000))
}

// The card as a table reaches it: the monitor's side's (it notes the
// transmitter's table for the lanes), reading as above.
pub fn hands() -> atom.Hands {
    var all = sink.hands()
    all.read = read
    return all
}

pub fn card() -> scanout.Card { return scanout.Card.{ .read = read, .now = sw.now, .write = display.logWrite } }

// The monitor on DisplayPort connector `k`, its line high now (or not:
// `high`); the monitor's own registers and EDID as `revision`, `rate`,
// `lanes` and `bytes` say.
pub fn dpMonitor(k: usize, revision: usize, rate: usize, lanes: usize, bytes: []const u8, high: bool) -> void {
    sink.monitor(revision, rate, lanes, true)
    var b: usize = 0
    while b < 256 {
        sink.edid[b] = if b < bytes.length { bytes[b] } else { 0 }
        b += 1
    }
    place(k)
    if high { lines.line(DP_LINES[k], true) }
}

// The monitor's cable put into DisplayPort connector `k` (its registers
// as they were: a monitor that was off holds no link).
pub fn place(k: usize) -> void {
    on = k
    sink.backEnd = DP_BACK_ENDS[k]
    sink.line = DP_LINES[k] - 1
    sink.channel = DP_CHANNELS[k]
    sink.txOn = false
    var lane: usize = 0
    while lane < 4 {
        sink.clockOf[lane] = false
        sink.lockOf[lane] = false
        lane += 1
    }
}

// The monitor's cable pulled from the DisplayPort connector it is on, its
// line low now.
pub fn pull() -> void {
    if on != NEVER { lines.line(DP_LINES[on], false) }
    on = NEVER
    sink.backEnd = NOWHERE_BACK
    sink.line = 4
    sink.channel = NOWHERE_CHANNEL
    var lane: usize = 0
    while lane < 4 {
        sink.clockOf[lane] = false
        sink.lockOf[lane] = false
        lane += 1
    }
}

// Everything forgotten (switch_card's `reset` and the monitor's), no
// monitor on a DisplayPort connector.
pub fn reset() -> void {
    sink.reset()
    sw.reset()
    on = NEVER
    acks = 0
    adapterOn = NEVER
    pull()
}

// The firmware's state of the user's machine with its picture on
// DisplayPort connector `k` instead (as dp_monitor.mlx's `firmware` has a
// DisplayPort output: controller 0's 1280x960 out of front end and back
// end `k`'s DIG, a link of `lanes` lanes at `code`, trained, its stream on,
// the DTO at 108 MHz), every other back end off as the log of 17 Nov reads
// it, the card's straps allowing HDMI, the lines high whose bits `high`
// has. The monitor's own registers as
// `dpMonitor` sets them, and its cable in that connector, holding the link.
pub fn usersOnDp(k: usize, code: usize, lanes: usize, high: usize, revision: usize, rate: usize, bytes: []const u8) -> void {
    reset()
    lines.byClock = true
    var n: usize = 0
    while n < 6 {
        display.store(scanout.DIG[n] + scanout.DIG_BE_CNTL, 0x00010000)
        display.store(scanout.DIG[n] + scanout.DIG_BE_EN_CNTL, 0x100)
        display.store(scanout.DIG[n] + scanout.HDMI_CONTROL, 0x00010001)
        n += 1
    }
    dpMonitor(k, revision, rate, lanes, bytes, false)
    sink.firmware(0, DP_BACK_ENDS[k], code, lanes)
    // The card's straps as tmds_card.mlx's firmware has them: HDMI allowed.
    display.store(0x4818, 0x8000)
    display.store(0x4819, 0)
    n = 1
    while n <= 6 {
        lines.line(n, (high >> @intCast(u6, n)) & 1 != 0)
        n += 1
    }
}
