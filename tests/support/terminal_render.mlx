// std.ui.terminal end to end on a CPU canvas (for tools/check_terminal.sh):
// a screen with text, a red background cell and the cursor is drawn with
// the monospaced TrueType font, and the pixels say so: the red cell is
// red, the cursor cell is the cursor's colour, the 'H' cell has ink, and a
// blank cell is the background. Exits 0 on success, else the number of the
// check that failed (2: no font, so the check is skipped by the script).
const std = @import("std")
const ui = @import("std.ui")
const terminal = @import("std.terminal")
const ui_terminal = @import("std.ui.terminal")
const text = @import("std.ui.text")
const canvas_module = @import("std.ui.canvas")

fn pixelAt(canvas: *canvas_module.Canvas, x: i32, y: i32) -> u32 {
    return canvas.*.pixels[@intCast(usize, y) * canvas.*.stride + @intCast(usize, x)]
}

// The pixels of cell (row, column) that are not `background`.
fn inkIn(canvas: *canvas_module.Canvas, view: *ui_terminal.View, row: i32, column: i32, background: u32) -> usize {
    var ink: usize = 0
    var y = view.*.padding + row * view.*.cellHeight
    const y_end = y + view.*.cellHeight
    while y < y_end {
        var x = view.*.padding + column * view.*.cellWidth
        const x_end = x + view.*.cellWidth
        while x < x_end {
            if pixelAt(canvas, x, y) != background { ink += 1 }
            x += 1
        }
        y += 1
    }
    return ink
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var screen: terminal.Screen = undefined
    if !terminal.init(&screen, allocator, 20, 4, 10) { return 1 }
    var mono: text.Text = undefined
    if !text.loadMonoText(&mono, 16, allocator) { return 2 }
    var view: ui_terminal.View = undefined
    ui_terminal.init(&view, &screen, &mono, 16, 4)
    // "Hi", a space, a red cell, then the cursor on the fifth cell.
    terminal.feed(&screen, "Hi ")
    terminal.feedByte(&screen, 27)
    terminal.feed(&screen, "[41m ")
    terminal.feedByte(&screen, 27)
    terminal.feed(&screen, "[0m")
    const width = ui_terminal.pixelWidth(&view, 20)
    const height = ui_terminal.pixelHeight(&view, 4)
    const memory = allocator.alloc(@intCast(usize, width * height) * 4, 16)
    if memory == null { return 3 }
    var canvas: canvas_module.Canvas = undefined
    unsafe { canvas.pixels = @ptrCast([*]u32, memory.?) }
    canvas.width = @intCast(usize, width)
    canvas.height = @intCast(usize, height)
    canvas.stride = @intCast(usize, width)
    canvas.swapRedBlue = false
    canvas.device = 0
    canvas.opacity = 255
    ui_terminal.draw(&view, &canvas, ui.rect(0, 0, width, height))
    const middle_y = view.padding + view.cellHeight / 2
    const centre = view.cellWidth / 2
    if !view.monospaced || view.cellWidth < 4 || view.cellHeight < 8 { return 4 }
    if pixelAt(&canvas, view.padding + 3 * view.cellWidth + centre, middle_y) != terminal.paletteColor(1) { return 5 }
    if pixelAt(&canvas, view.padding + 4 * view.cellWidth + centre, middle_y) != view.cursorColor { return 6 }
    if inkIn(&canvas, &view, 0, 0, view.background) < 5 { return 7 }
    if inkIn(&canvas, &view, 2, 2, view.background) != 0 { return 8 }
    // Inverse video swaps the cell's colours.
    terminal.feedByte(&screen, 27)
    terminal.feed(&screen, "[2;1H")
    terminal.feedByte(&screen, 27)
    terminal.feed(&screen, "[7m ")
    ui_terminal.draw(&view, &canvas, ui.rect(0, 0, width, height))
    if pixelAt(&canvas, view.padding + centre, view.padding + view.cellHeight + view.cellHeight / 2) != view.foreground { return 9 }
    return 0
}
