// A program that crashes three calls deep, for tools/check_crash_report.sh:
// argv[1] picks how (index: an index out of range, null: a store through
// address 8, deep: a recursion without end, abort: SIGABRT, as abort(), fail: crash.fail, values: a full value arena,
// context: the index crash after saying what it was doing, as the
// compilers do, where: crash.contextAt, then a store through a bad
// address with a context pointing at memory given back, which the report
// leaves out; broken: index, the handler made to fault naming a frame).

const std = @import("std")
const crash = @import("std.crash")

fn pick(values: []const usize, at: usize) -> usize {
    return values[at]
}

fn middle(at: usize) -> usize {
    const values: [4]usize = [4]usize{ 1, 2, 3, 4 }
    return pick(values[0..4], at) + 1
}

fn store(address: usize) -> void {
    unsafe { @ptrFromInt(*usize, address).* = 1 }
}

fn deeper(depth: usize) -> usize {
    var padding: [64]usize = undefined
    padding[depth % 64] = depth
    return deeper(depth + 1) + padding[depth % 64]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const installed = crash.install()
    var how: u8 = 0
    if arguments.length > 1 { how = arguments[1][0] }
    if how == 110 { store(8) } else if how == 98 { crash.faultWhileNaming = true } else if how == 97 { abort() } else if how == 102 { crash.fail("the compositor ended the connection (a test)") } else if how == 118 { return hoardAll() }
    if how == 99 { crash.contextAt("compiling", "src/widget.c", 12) } else if how == 119 { gone() }
    if how == 100 { return @intCast(u8, deeper(0) % 2) }
    return @intCast(u8, middle(3 + arguments.length) % 2)
}

// A context in a mapping the program gave back: the report says nothing
// of it rather than crashing again reading it.
fn gone() -> void {
    const mapped = std.linux.mapAnonymous(4096)
    const text: [*]u8 = unsafe { @ptrFromInt([*]u8, mapped) }
    text[0] = 120
    crash.context(text[0..1])
    _ = std.linux.syscall2(std.linux.SYS_munmap, mapped, 4096)
    store(16)
}

fn abort() -> void {
    const self = std.linux.syscall0(39)
    const raised = std.linux.syscall2(62, @bitCast(usize, self), 6)
}

// A loop that never gives its values back: a mebibyte a turn until the
// value arena (1 GiB) is full.
fn hoardAll() -> u8 {
    var kept: usize = 0
    var turn: usize = 0
    while turn < 4096 {
        kept += hoard(turn)
        turn += 1
    }
    return @intCast(u8, kept % 2)
}

fn hoard(turn: usize) -> usize {
    var block: [1048576]u8 = undefined
    block[turn % 1048576] = 1
    return @intCast(usize, block[turn % 1048576])
}
