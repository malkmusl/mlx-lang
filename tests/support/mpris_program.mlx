// The port's MPRIS player (projects/webkit/port/mlx/mediasession.mlx) on a
// bus of its own, for tools/check_mpris.sh: takes the name, tells a
// track that plays, then polls the bus for up to 20 seconds, writing
// each command it gets as a line ("command KIND TIME"); PlayPause
// pauses or plays again (a Get sees the change), a SetPosition ends it
// with exit 13. Exit 2 without a bus, 3 when the cover could not be
// written, 1 when no SetPosition came.
const std = @import("std")
const mediasession = @import("../../projects/webkit/port/mlx/mediasession.mlx")
const time = @import("../../std/bootstrap/time.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }
fn sayNumber(value: usize) -> void { _ = std.io.writeUnsigned(std.io.stdout(), value) }

fn update(session: usize, status: u32, position: i64, seeked: u32, art: usize, artLength: usize) -> void {
    const title: []const u8 = "Ein Lied"
    const artist: []const u8 = "Jemand"
    const album: []const u8 = "Das Album"
    const url: []const u8 = "https://example.org/lied.mp4"
    mediasession.sessionUpdate(session, status, @intFromPtr(title.pointer), title.length, @intFromPtr(artist.pointer), artist.length, @intFromPtr(album.pointer), album.length, art, artLength, @intFromPtr(url.pointer), url.length, 180000000, position, 1, 1, 0, seeked)
}

pub fn main() -> u8 {
    const session = mediasession.sessionOpen()
    if session == 0 {
        say("no bus\n")
        return 2
    }
    var status = mediasession.PLAYING
    var position: i64 = 12000000
    // The cover: a 2 by 2 PNG (red, green over blue, white) the controls
    // get as mpris:artUrl, a file:// one.
    var cover: [4]u32 = undefined
    cover[0] = 0xffff0000
    cover[1] = 0xff00ff00
    cover[2] = 0xff0000ff
    cover[3] = 0xffffffff
    var art: [1024]u8 = undefined
    const artLength = mediasession.sessionCover(session, @intFromPtr(&cover), 2, 2, 2, @intFromPtr(&art), 1024)
    if artLength == 0 {
        say("no cover\n")
        mediasession.sessionClose(session)
        return 3
    }
    update(session, status, position, 0, @intFromPtr(&art), artLength)
    say("ready\n")
    const started = time.monotonicNanoseconds()
    var result: u8 = 1
    while time.monotonicNanoseconds() - started < 20000000000 {
        var kind: u32 = 0
        var when: i64 = 0
        while mediasession.sessionPoll(session, @intFromPtr(&kind), @intFromPtr(&when)) != 0 {
            say("command ")
            sayNumber(@intCast(usize, kind))
            say(" ")
            _ = std.io.writeSigned(std.io.stdout(), @intCast(isize, when))
            say("\n")
            if kind == mediasession.COMMAND_PLAY_PAUSE {
                status = if status == mediasession.PLAYING { mediasession.PAUSED } else { mediasession.PLAYING }
                update(session, status, position, 0, @intFromPtr(&art), artLength)
            } else if kind == mediasession.COMMAND_SEEK_TO {
                position = when
                update(session, status, position, 1, @intFromPtr(&art), artLength)
                result = 13
            }
        }
        if result == 13 { break }
        if mediasession.sessionConnected(session) == 0 { break }
        _ = time.sleepNanoseconds(50000000)
    }
    mediasession.sessionClose(session)
    return result
}
