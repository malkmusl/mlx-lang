// For 393: functions small enough to be inlined (or marked so) that read
// module variables whose names the caller has as locals.
var dirs: usize = 7
var scale: u32 = 3
var count: u32 = 40

pub fn get(index: usize) -> usize { return dirs + index }

pub inline fn scaled(value: u32) -> u32 { return value * scale }

// Inlined into the caller with get inlined into it in turn.
pub inline fn twice(index: usize) -> usize { return get(index) + get(index) }

pub inline fn counted() -> u32 { return count }
