// A Radeon whose picture leaves by a TMDS output, as a table, for the
// tests of the kernel's mode set through the card's firmware tables
// (tests/474_gpu_tmds_sequence_runtime.mlx and 475_gpu_tmds_blocks_
// runtime.mlx): the display's registers by number, a clock that goes on
// at every look, a frame counter that runs as the controller's timing and
// its PLL's clock say, and every write in order, the driver's and the
// tables' in one list.
//
// The card's tables are in a ROM made here (tests/support/atom_rom.mlx),
// and each is the same small program: it writes the words it was told,
// as they are, into the "mail" registers (MAIL and the five after it:
// numbers the display has nothing at), then its own place in the ROM's
// list into GO. So a table's run stands in the list of writes as its
// parameter block, word for word, and then its number. On the write to
// GO the card does what the real table is for, as far as the driver
// looks: the transmitter's table turns the back end's bit on and off, the
// controller's table the controller's, the pixel clock's table sets the
// PLL's clock and puts the controller on it, the timing's table writes
// the timing's words by Linux's arithmetic, the display engine's clock's
// table sets the divider and answers with the clock. Nothing of a real
// card's ROM is in here.
//
// What the card can be made to do wrong is a variable each, below.
const scanout = @import("../../projects/brix/kernel/gpu_display.mlx")
const atom = @import("../../projects/brix/kernel/atom.mlx")
const rom = @import("./atom_rom.mlx")

pub const ROOM: usize = 0x8000
pub const STEP: usize = 500
pub const NEVER: usize = 0xFFFFFFFF

// Where a table leaves what it was told, where it says it has run, and
// where the display engine's clock's table finds its answer.
pub const MAIL: usize = 0x7F00
pub const GO: usize = 0x7F10
pub const ANSWER: usize = 0x7F11

pub var registers: [ROOM]usize = undefined
// The four sets of urgency marks of each controller, behind one word.
pub var marks: [24]usize = undefined
pub var clock: usize = 0
// Each PHY's PLL: its clock in kHz.
pub var pll: [6]usize = undefined

// Every write, in order: the register, the word, whether a table made it.
pub const WRITES: usize = 4096
pub var writtenTo: [WRITES]usize = undefined
pub var writtenWith: [WRITES]usize = undefined
pub var writtenByTable: [WRITES]bool = undefined
pub var written: usize = 0
// How many of them the driver made itself, and how many tables ran (came
// to their write to GO).
pub var driverWrites: usize = 0
pub var runs: usize = 0
// The picture memory cleared (offset, bytes; how often), and whether a
// write came before.
pub var clearedAt: usize = 0
pub var clearedBytes: usize = 0
pub var cleared: usize = 0
pub var writtenBeforeClear = false

// What the card can be made to do wrong.
// The driver's own write number `spoilAt` (counted from 0) does not
// hold: this bit of it comes out the other way.
pub var spoilAt: usize = NEVER
pub var spoilBit: usize = 0
// A state that never comes: from the `stuckFrom`th write to this
// register on, these bits of it read as this value.
pub var stuckRegister: usize = NEVER
pub var stuckMask: usize = 0
pub var stuckValue: usize = 0
pub var stuckFrom: usize = 0
pub var stuckSeen: usize = 0
// A register that takes no more writes after its first `deafAfter`.
pub var deafRegister: usize = NEVER
pub var deafAfter: usize = 0
pub var deafSeen: usize = 0
// The table run number `refuseRun` (counted from 0) is stopped at its
// write to GO: the card does not take it, and the table has not done its
// work.
pub var refuseRun: usize = NEVER
// The pixel clock's table leaves the PLL's clock as it is; puts the
// controller on another PLL.
pub var clockDeaf = false
pub var wrongSource = false
// The pixel clock's table leaves the PLL's clock as it is from its
// `clockDeafFrom`th run on (counted from 0): a PLL that took a clock on
// the way there and takes none on the way back.
pub var clockDeafFrom: usize = NEVER
pub var clockRuns: usize = 0
// The pixel clock's table, at its first run, sets the PLL this many
// thousandths below the clock it was told: a PLL that takes a clock, but
// not quite the one asked for.
pub var clockShort: usize = 0
// The timing's table writes a line's pulse a pixel longer than told.
pub var timingOdd = false
// The transmitter's table: does not turn the back end on; does not turn
// it off; writes the mode it was told into the back end's word and takes
// every front end off it.
pub var transmitterDeaf = false
pub var transmitterStays = false
pub var transmitterRewrites = false
// The controller's state bit stays set whatever its table does.
pub var stateSticks = false
// The frame counter stands while the back end's transmitter is off.
pub var framesNeedTransmitter = false
// The frame counter stands while this register holds this value.
pub var freezeRegister: usize = NEVER
pub var freezeValue: usize = 0
// A state the card's tables do not bring: while as many tables have run as
// `heldFrom` and fewer than `heldUntil`, these bits of this register read
// as this value.
pub var heldRegister: usize = NEVER
pub var heldMask: usize = 0
pub var heldValue: usize = 0
pub var heldFrom: usize = 0
pub var heldUntil: usize = 0
// The memory interface says it ran dry once this register is written.
pub var dryAfter: usize = NEVER
pub var dry = false

// The log.
pub const LOG: usize = 262144
pub var log: [LOG]u8 = undefined
pub var logged: usize = 0
pub var asides: usize = 0
pub var aside = false

pub fn raw(number: usize) -> usize { return if number < ROOM { registers[number] } else { 0 } }

pub fn store(number: usize, value: usize) -> void {
    if number < ROOM { registers[number] = value }
}

// Which controller's block a register is in (6: none's).
fn controllerOf(number: usize) -> usize {
    var c: usize = 0
    while c < 6 {
        if number >= 0x1A00 + scanout.OFFSETS[c] && number < 0x1C00 + scanout.OFFSETS[c] { return c }
        c += 1
    }
    return 6
}

// The divider a number in the display engine's clock's word names, in
// quarters (Linux's dentist_get_divider_from_did, written out again
// here).
pub fn dividerOf(number: usize) -> usize {
    var id = number & 0x7F
    if id < 8 { id = 8 }
    if id < 0x40 { return 8 + (id - 8) }
    if id < 0x60 { return 64 + 2 * (id - 0x40) }
    if id < 0x7E { return 128 + 4 * (id - 0x60) }
    return 248 + 264 * (id - 0x7E)
}

// Controller `c`'s frame counter: it runs when the controller is on and
// its PLL has a clock.
fn frameCount(c: usize) -> usize {
    const at = scanout.OFFSETS[c]
    if raw(at + 0x1B9C) & 1 == 0 { return 7 }
    const n = raw(0x143 + 4 * c) & 7
    if n >= 6 || pll[n] == 0 { return 7 }
    if framesNeedTransmitter && raw(scanout.DIG[n] + 0x48) & 1 == 0 { return 7 }
    if freezeRegister != NEVER && raw(freezeRegister) == freezeValue { return 7 }
    const period = (raw(at + 0x1B80) + 1) * (raw(at + 0x1B87) + 1) * 1000000 / pll[n]
    if period == 0 { return 7 }
    return (clock / period) & 0xFFFFFF
}

pub fn read(number: usize) -> u32 {
    var value = raw(number)
    const c = controllerOf(number)
    if c < 6 {
        const local = number - scanout.OFFSETS[c]
        if local == 0x1B33 { value = marks[c * 4 + ((raw(scanout.OFFSETS[c] + 0x1B32) >> 8) & 3)] }
        if local == 0x1BA6 { return @intCast(u32, frameCount(c)) }
        // The states that follow what was asked for: the controller's,
        // the blanking's.
        if local == 0x1B9C { value = if stateSticks { value | 0x10000 } else { (value & ~@intCast(usize, 0x10000)) | ((value & 1) << 16) } }
        if local == 0x1B9D { value = (value & ~@intCast(usize, 1)) | ((value >> 8) & 1) }
    }
    // The buffers are given or given back at once.
    if number >= 0x321 && number < 0x327 { value = value | 0x10 }
    if number == 0x2F7 && dry { value = value | 0x10000000 }
    if number == stuckRegister && stuckSeen >= stuckFrom { value = (value & ~stuckMask) | stuckValue }
    if number == heldRegister && runs >= heldFrom && runs < heldUntil { value = (value & ~heldMask) | heldValue }
    return @intCast(u32, value)
}

// What a table's run does to the card (the file's head).
fn effect(table: usize) -> void {
    const w0 = raw(MAIL)
    const w1 = raw(MAIL + 1)
    const w2 = raw(MAIL + 2)
    const w3 = raw(MAIL + 3)
    const w4 = raw(MAIL + 4)
    const w5 = raw(MAIL + 5)
    if table == 76 {
        const phy = w0 & 0xFF
        const action = (w0 >> 8) & 0xFF
        if phy < 7 {
            const back = scanout.DIG[phy]
            if action == 1 && !transmitterDeaf {
                store(back + 0x48, raw(back + 0x48) | 1)
                if transmitterRewrites { store(back + 0x47, (raw(back + 0x47) & ~@intCast(usize, 0x77F00)) | (((w0 >> 16) & 7) << 16)) }
            }
            if action == 0 && !transmitterStays { store(back + 0x48, raw(back + 0x48) & ~@intCast(usize, 1)) }
        }
    } else if table == 35 {
        const c = w0 & 0xFF
        if c < 6 { store(scanout.OFFSETS[c] + 0x1B9C, (raw(scanout.OFFSETS[c] + 0x1B9C) & ~@intCast(usize, 1)) | ((w0 >> 8) & 1)) }
    } else if table == 12 {
        const n = if (w1 & 0xFF) >= 20 { (w1 & 0xFF) - 20 } else { 6 }
        const c = w2 & 0xFF
        if n < 6 && c < 6 {
            if !clockDeaf && clockRuns < clockDeafFrom { pll[n] = w0 / 10 }
            if clockRuns == 0 { pll[n] = pll[n] * (1000 - clockShort) / 1000 }
            clockRuns += 1
            store(0x140 + 4 * c, raw(0x140 + 4 * c) & ~@intCast(usize, 0x10))
            store(0x143 + 4 * c, (raw(0x143 + 4 * c) & ~@intCast(usize, 0x17)) | (if wrongSource { (n + 1) % 6 } else { n }))
        }
    } else if table == 49 {
        const c = w5 & 0xFF
        if c < 6 {
            const at = scanout.OFFSETS[c]
            const width = w0 & 0xFFFF
            const hTotal = width + (w0 >> 16)
            const height = w1 & 0xFFFF
            const vTotal = height + (w1 >> 16)
            const hEnd = hTotal - width - (w2 & 0xFFFF)
            const vEnd = vTotal - height - (w3 & 0xFFFF)
            store(at + 0x1B80, hTotal - 1)
            store(at + 0x1B87, vTotal - 1)
            store(at + 0x1B81, (hEnd << 16) | (hEnd + width))
            store(at + 0x1B8D, (vEnd << 16) | (vEnd + height))
            store(at + 0x1B82, ((w2 >> 16) + (if timingOdd { 1 } else { 0 })) << 16)
            store(at + 0x1B8E, (w3 >> 16) << 16)
            store(at + 0x1B83, (w4 >> 1) & 1)
            store(at + 0x1B8F, (w4 >> 2) & 1)
        }
    } else if table == 46 && (w1 & 0xFF) == 0 {
        // The slowest clock of the divider's that is the one asked for
        // at least (the generator's 3600 MHz times four over the
        // divider).
        var id: usize = 0x7F
        while id > 8 && 4 * 3600000 / dividerOf(id) < w0 * 10 { id -= 1 }
        store(0x124, (raw(0x124) & ~@intCast(usize, 0x7F)) | id)
        store(ANSWER, 4 * 3600000 / dividerOf(id) / 10)
    }
}

fn put(number: usize, value: u32, byTable: bool) -> bool {
    var word = @intCast(usize, value)
    if byTable && number == GO && runs == refuseRun {
        runs += 1
        return false
    }
    if cleared == 0 { writtenBeforeClear = true }
    if number == stuckRegister { stuckSeen += 1 }
    if written < WRITES {
        writtenTo[written] = number
        writtenWith[written] = word
        writtenByTable[written] = byTable
    }
    written += 1
    if !byTable {
        if driverWrites == spoilAt { word = word ^ spoilBit }
        driverWrites += 1
    }
    if number == dryAfter { dry = true }
    if number == deafRegister {
        deafSeen += 1
        if deafSeen > deafAfter { return true }
    }
    const c = controllerOf(number)
    if c < 6 && number - scanout.OFFSETS[c] == 0x1B33 {
        marks[c * 4 + ((raw(scanout.OFFSETS[c] + 0x1B32) >> 8) & 3)] = word
        return true
    }
    store(number, word)
    if byTable && number == GO {
        runs += 1
        effect(word)
    }
    return true
}

// The card as the driver's own hands write it.
pub fn write(number: usize, value: u32) -> void { _ = put(number, value, false) }

pub fn clear(offset: usize, bytes: usize) -> void {
    clearedAt = offset
    clearedBytes = bytes
    cleared += 1
}

pub fn now() -> usize {
    clock += STEP
    return clock
}

// The card as a table reaches it.
fn tableWrite(number: usize, value: u32) -> bool { return put(number, value, true) }

fn otherRead(number: usize) -> u32 { return 0 }

fn otherWrite(number: usize, value: u32) -> bool { return true }

fn delay(microseconds: usize) -> void { clock += microseconds * 1000 }

pub fn hands() -> atom.Hands {
    return atom.Hands.{ .registers = ROOM, .read = read, .write = tableWrite, .pllRead = otherRead, .pllWrite = otherWrite, .mcRead = otherRead, .mcWrite = otherWrite, .delay = delay, .now = now }
}

pub fn logWrite(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length && logged < LOG {
        log[logged] = text[k]
        logged += 1
        k += 1
    }
}

// What is said is for the log alone, or for the screen too (the test
// only counts how often that was switched).
pub fn setAside(on: bool) -> void {
    aside = on
    asides += 1
}

pub fn has(text: []const u8) -> bool {
    if text.length > logged { return false }
    var at: usize = 0
    while at + text.length <= logged {
        var k: usize = 0
        while k < text.length && log[at + k] == text[k] { k += 1 }
        if k == text.length { return true }
        at += 1
    }
    return false
}

// Where in the log the text ends that is found first from `from` on, or
// NEVER when it is not there from that place: one line after another in
// their order.
pub fn after(text: []const u8, from: usize) -> usize {
    var at = from
    while at + text.length <= logged {
        var k: usize = 0
        while k < text.length && log[at + k] == text[k] { k += 1 }
        if k == text.length { return at + text.length }
        at += 1
    }
    return NEVER
}

// How often the text is in the log.
pub fn count(text: []const u8) -> usize {
    var found: usize = 0
    var at: usize = 0
    while true {
        at = after(text, at)
        if at == NEVER { return found }
        found += 1
    }
    return found
}

// Everything forgotten: no register holds anything, nothing is wrong with
// the card.
pub fn reset() -> void {
    var k: usize = 0
    while k < ROOM {
        registers[k] = 0
        k += 1
    }
    k = 0
    while k < 24 {
        marks[k] = 0
        k += 1
    }
    k = 0
    while k < 6 {
        pll[k] = 0
        k += 1
    }
    clock = 0
    written = 0
    driverWrites = 0
    runs = 0
    cleared = 0
    writtenBeforeClear = false
    spoilAt = NEVER
    stuckRegister = NEVER
    stuckSeen = 0
    deafRegister = NEVER
    deafSeen = 0
    refuseRun = NEVER
    clockDeaf = false
    wrongSource = false
    clockDeafFrom = NEVER
    clockRuns = 0
    clockShort = 0
    timingOdd = false
    transmitterDeaf = false
    transmitterStays = false
    transmitterRewrites = false
    stateSticks = false
    framesNeedTransmitter = false
    freezeRegister = NEVER
    heldRegister = NEVER
    dryAfter = NEVER
    dry = false
    logged = 0
    asides = 0
    aside = false
}

// The writes counted anew (after a plan was made, before it is carried
// out).
pub fn forget() -> void {
    written = 0
    driverWrites = 0
    runs = 0
    cleared = 0
    writtenBeforeClear = false
    stuckSeen = 0
    deafSeen = 0
}

// The firmware's state of the user's kind: controller `c` runs the
// picture's own 1280x960 timing (1800 by 1000; the pulses begin the
// counters: 112 and 3 long, both the high ones; a front porch of 96
// pixels and of one line), the 1280x960 picture at the start of the
// card's memory (8 GiB at 0xf400000000) as its surface, nothing scaled;
// it leaves by front end `m` on back end `n` in TMDS mode (DVI, or HDMI),
// the back end watching hot plug line `line`; the controller's clock is
// PLL `n`'s, which gives `kilohertz`; the display engine's clock is the
// generator's 3600 MHz over 6 (divider number 0x18: 600 MHz); the
// firmware's scratch words hold some notes (in word 2 the two bits Linux
// clears and others); the card's straps allow HDMI; the formatter sends
// RGB; hot plug line 2 says a monitor is there.
pub fn firmware(c: usize, m: usize, n: usize, hdmi: bool, line: usize, kilohertz: usize) -> void {
    const at = scanout.OFFSETS[c]
    store(0x809, 0xF5FFF400)
    store(at + 0x1B9C, 0x00010001)
    store(at + 0x1B80, 1799)
    store(at + 0x1B87, 999)
    store(at + 0x1B81, (424 << 16) | 1704)
    store(at + 0x1B8D, (39 << 16) | 999)
    store(at + 0x1B82, 112 << 16)
    store(at + 0x1B8E, 3 << 16)
    store(at + 0x1A00, 1)
    store(at + 0x1A01, 2)
    store(at + 0x1A04, 0)
    store(at + 0x1A07, 0xF4)
    store(at + 0x1A06, 1280)
    store(at + 0x1A0D, 1280)
    store(at + 0x1A0E, 960)
    store(at + 0x1A12, 1)
    store(at + 0x1AC3, 960)
    store(at + 0x1B5C, 0)
    store(at + 0x1B5D, (1280 << 16) | 960)
    store(at + 0x1AC1, 0x1006B0)
    store(at + 0x1B53, 0x11)
    store(0x321 + c, 0x12)
    store(at + 0x1B32, 0x00010100)
    marks[c * 4] = 0x00FA0030
    marks[c * 4 + 1] = 0x00FA0040
    store(at + 0x1BB6, 0x100)
    store(at + 0x1B30, 0x0001242B)
    store(at + 0x1BB3, 0x00003101)
    store(at + 0x1BBE, 2)
    store(at + 0x1B88, 0)
    store(at + 0x1B89, 0)
    store(scanout.DIG[n] + 0x48, 0x101)
    store(scanout.DIG[n] + 0x47, ((line - 1) << 28) | ((if hdmi { 3 } else { 2 }) << 16) | (@intCast(usize, 0x100) << @intCast(u6, m)))
    store(scanout.DIG[m] + 0x00, (raw(scanout.DIG[m]) & ~@intCast(usize, 7)) | c | 0x1000000)
    store(0x140 + 4 * c, 0)
    store(0x143 + 4 * c, n)
    if n < 6 { pll[n] = kilohertz }
    store(0x124, 0x08000018)
    store(0x5CB, 0x20010005)
    store(0x5CF, 0x00000010)
    store(0x4818, 0x8000)
    store(0x4819, 0)
    store(0x18A0, 2)
    if n < 6 { store(PHYPLL[n], 0x101) }
}

// The PHY PLLs' words (the header's PHYPLLA_ to PHYPLLF_PIXCLK_RESYNC_
// CNTL).
pub const PHYPLL = [_]usize{ 0x100, 0x101, 0x102, 0x103, 0x10C, 0x13E }

// What a table's program ends with.
pub const Ending = enum(u8) {
    // Its run said, the table's end.
    plain,
    // The display engine's clock's table: its answer put into the first
    // word it was told.
    answer,
    // The table's end at once: it writes nothing.
    nothing,
    // After its run is said, an opcode that is none.
    broken,
    // After its run is said, a wait of 200 ms and back to it, for ever.
    loop
}

var code: [96]u8 = undefined

// The program of the table at `table` of the list that is told `words`
// words (the file's head), ending as `ending` says.
pub fn program(table: usize, words: usize, ending: Ending) -> []const u8 {
    var at: usize = 0
    if ending != Ending.nothing {
        var k: usize = 0
        while k < words {
            // MOVE REG[MAIL + k] = PS[k]
            code[at] = 0x01
            code[at + 1] = 0x01
            code[at + 2] = @intCast(u8, (MAIL + k) & 0xFF)
            code[at + 3] = @intCast(u8, (MAIL + k) >> 8)
            code[at + 4] = @intCast(u8, k)
            at += 5
            k += 1
        }
        // MOVE REG[GO] = the table's number
        code[at] = 0x01
        code[at + 1] = 0x05
        code[at + 2] = @intCast(u8, GO & 0xFF)
        code[at + 3] = @intCast(u8, GO >> 8)
        code[at + 4] = @intCast(u8, table)
        code[at + 5] = 0
        code[at + 6] = 0
        code[at + 7] = 0
        at += 8
    }
    if ending == Ending.answer {
        // MOVE PS[0] = REG[ANSWER]
        code[at] = 0x02
        code[at + 1] = 0x00
        code[at + 2] = 0x00
        code[at + 3] = @intCast(u8, ANSWER & 0xFF)
        code[at + 4] = @intCast(u8, ANSWER >> 8)
        at += 5
    }
    if ending == Ending.broken {
        code[at] = 0x00
        at += 1
    }
    if ending == Ending.loop {
        // DELAY 200 ms; JUMP to the delay (a table's program begins six
        // bytes into the table).
        const back = 6 + at
        code[at] = 0x50
        code[at + 1] = 200
        code[at + 2] = 0x43
        code[at + 3] = @intCast(u8, back & 0xFF)
        code[at + 4] = @intCast(u8, back >> 8)
        at += 5
    }
    code[at] = 0x5B
    return code[0..at + 1]
}

// The tables a TMDS change runs: their places in the ROM's list and how
// many words each is told (the transmitter's and the pixel clock's 16
// bytes, the encoder's 12, the controller's 4, the timing's 24, the
// display engine's clock's 8).
pub const TABLES = [_]usize{ 76, 12, 4, 35, 49, 46 }
pub const TABLE_WORDS = [_]usize{ 4, 4, 3, 1, 6, 2 }

// A ROM as a Polaris card's is laid out (atom_rom.mlx's `polaris` and
// `modeSet`), with the six tables as programs of this file; the table at
// `odd` of the list (NEVER: none) ends as `ending` says. Finished.
pub fn makeRom(builder: *rom.Builder, odd: usize, ending: Ending) -> void {
    const end = [_]u8{0x5B}
    rom.polaris(builder, end[0..])
    var k: usize = 0
    while k < TABLES[0..].length {
        const table = TABLES[k]
        var how = if table == 46 { Ending.answer } else { Ending.plain }
        if table == odd { how = ending }
        _ = builder.command(table, 0, TABLE_WORDS[k] * 4, program(table, TABLE_WORDS[k], how))
        k += 1
    }
    builder.revise(12, 1, 7)
    builder.revise(76, 1, 6)
    builder.revise(4, 1, 5)
    builder.revise(35, 1, 1)
    rom.modeSet(builder)
    builder.finish()
}
