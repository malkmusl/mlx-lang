// Module-level `pub var` globals for 297: read and written from another
// module (`module.name`), their addresses taken there.
pub const Pair = struct { first: u32, second: u32 }

pub var count: usize = 3
pub var buffer: [8]u8 = undefined
pub var pair: Pair = undefined
pub var text: []const u8 = undefined
pub var cursor: *u8 = undefined

pub fn bump() -> usize {
    count += 1
    return count
}

pub fn fill(value: u8) -> void {
    var index: usize = 0
    while index < buffer.length {
        buffer[index] = value + @intCast(u8, index)
        index += 1
    }
}
