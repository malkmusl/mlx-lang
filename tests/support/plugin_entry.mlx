// A plugin with an entry point and an initializer (`mlx4 --plugin
// --stack-arena --no-libc --entry=mlx_entry_start --init=mlx_entry_init`):
// run as a program, the kernel enters mlx_entry_start with the stack as
// it left it (argc first), and it exits with argc + 6; loaded by a dynamic
// linker, DT_INIT runs mlx_entry_init first, which the host sees in
// mlx_entry_ready. The shape of mlxlibc as a program's loader.
extern("syscall") fn syscall1(number: usize, a1: usize) -> isize {}

export var mlx_entry_ready: u64 = 0

export fn mlx_entry_init() -> void {
    mlx_entry_ready = 7
}

export fn mlx_entry_start() -> void {
    var argc: usize = 0
    unsafe { argc = @ptrFromInt(*usize, @frameAddress() + 8).* }
    const exited = syscall1(231, argc + 6)
}

export fn mlx_entry_ready_now() -> u64 { return mlx_entry_ready }
