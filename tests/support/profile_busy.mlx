// A program that spends its time in spin (called by work, called by
// main), for tools/check_profile.sh.

fn spin(rounds: usize) -> usize {
    var value: usize = 1
    var at: usize = 0
    while at < rounds {
        value = (value * 6364136223846793005 + 1442695040888963407) % 1000000007
        at += 1
    }
    return value
}

fn work(times: usize) -> usize {
    var sum: usize = 0
    var at: usize = 0
    while at < times {
        sum += spin(1000000)
        at += 1
    }
    return sum
}

pub fn main() -> u8 {
    return @intCast(u8, work(60) % 2)
}
