// std.terminal.pty with a real program (for tools/check_terminal.sh): a
// shell on a 40x10 pty prints two lines and its terminal size; the output
// goes through std.terminal and the cells hold the text, the colour and
// the size the kernel told the shell. Exits 0 on success, else the number
// of the check that failed.
const std = @import("std")
const terminal = @import("std.terminal")
const pty = @import("std.terminal.pty")

fn text(screen: *terminal.Screen, row: usize, expected: []const u8) -> bool {
    var index: usize = 0
    for byte in expected {
        if terminal.visibleCell(screen, row, index).*.codepoint != @intCast(u32, byte) { return false }
        index += 1
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var screen: terminal.Screen = undefined
    if !terminal.init(&screen, allocator, 40, 10, 10) { return 1 }
    var argv: [4][*]const u8 = undefined
    var environment: [3][*]const u8 = undefined
    unsafe {
        argv[0] = @ptrCast([*]const u8, "/bin/sh")
        argv[1] = @ptrCast([*]const u8, "-c")
        argv[2] = @ptrCast([*]const u8, "printf 'line one\\n'; printf '\\033[1;31mred\\033[0m\\n'; stty size")
        argv[3] = @ptrFromInt([*]const u8, 0)
        environment[0] = @ptrCast([*]const u8, "TERM=xterm-256color")
        environment[1] = @ptrCast([*]const u8, "PATH=/usr/bin:/bin")
        environment[2] = @ptrFromInt([*]const u8, 0)
    }
    var child: pty.Child = undefined
    var argv_pointer: [*][*]const u8 = undefined
    var environment_pointer: [*][*]const u8 = undefined
    unsafe {
        argv_pointer = @ptrCast([*][*]const u8, &argv)
        environment_pointer = @ptrCast([*][*]const u8, &environment)
    }
    if !pty.spawn(&child, argv[0], argv_pointer, environment_pointer, 40, 10) { return 2 }
    var buffer: [4096]u8 = undefined
    var buffer_bytes: [*]u8 = undefined
    unsafe { buffer_bytes = @ptrCast([*]u8, &buffer) }
    // Read until the program ended and its output is drained (at most ~5 s).
    var waited: usize = 0
    var ended = false
    var open = true
    while open && waited < 500 {
        const got = pty.read(&child, buffer_bytes, 4096)
        if got > 0 {
            terminal.feed(&screen, buffer_bytes[0..@bitCast(usize, got)])
        } else if got == pty.EAGAIN {
            if ended {
                open = false
            } else {
                if pty.wait(&child) != null { ended = true }
                const slept = std.time.sleepNanoseconds(10000000)
                waited += 1
            }
        } else {
            open = false
        }
    }
    pty.hangUp(&child)
    if !text(&screen, 0, "line one") { return 3 }
    if !text(&screen, 1, "red") { return 4 }
    const red = terminal.visibleCell(&screen, 1, 0)
    if red.*.foreground != terminal.paletteColor(9) || red.*.flags & terminal.BOLD == 0 { return 5 }
    if !text(&screen, 2, "10 40") { return 6 }
    if screen.cursorRow != 3 || screen.cursorColumn != 0 { return 7 }
    return 0
}
