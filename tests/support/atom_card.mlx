// A card that is a table, for the tests of the kernel's table
// interpreter (projects/brix/kernel/atom.mlx): registers, PLL and memory
// controller registers that read what was written to them last and, never
// written, a number worked out from the register's own number and a seed;
// a clock that goes on by what is waited; and every read, write and wait
// written down in order. tools/atom_reference/reference.c is the same
// card in C for Linux's interpreter, number for number, so that what the
// two interpreters do to it can be held side by side.
const atom = @import("../../projects/brix/kernel/atom.mlx")

const M32: usize = 0xFFFFFFFF

// Register numbers a table can name: sixteen bits and a register block of
// sixteen bits more.
pub const REGISTERS: usize = 0x20000
pub const EVENTS: usize = 8192

pub const Kind = enum(u8) { read, write, pll_read, pll_write, mc_read, mc_write, delay }

pub const Event = struct {
    kind: Kind
    number: usize
    value: usize
}

// The three register spaces: the words, and in which `round` each was
// written last (a word of an earlier round reads as never written).
var words: [REGISTERS]u32 = undefined
var stamps: [REGISTERS]u32 = undefined
var pllWords: [256]u32 = undefined
var pllStamps: [256]u32 = undefined
var mcWords: [256]u32 = undefined
var mcStamps: [256]u32 = undefined
var round: u32 = 0
var seed: usize = 0

// What was done, in order (the first EVENTS of it; `count` goes on), and
// all of it folded into one number.
pub var events: [EVENTS]Event = undefined
pub var count: usize = 0
pub var digest: usize = 0
// The clock in nanoseconds: it goes on by what is waited and by `tick`
// each time it is looked at.
pub var clock: usize = 0
pub var tick: usize = 0
// Hands that may not write: a write is not taken, and not written down.
pub var readOnly = false
// Told of each thing as it is written down (a program that prints them).
fn nobody(kind: Kind, number: usize, value: usize) -> void {}
pub var watcher: fn(Kind, usize, usize) -> void = nobody

// Everything forgotten: no register written, no event, the clock at 0.
pub fn reset(withSeed: usize) -> void {
    if round == 0 {
        var k: usize = 0
        while k < REGISTERS {
            stamps[k] = 0
            k += 1
        }
        k = 0
        while k < 256 {
            pllStamps[k] = 0
            mcStamps[k] = 0
            k += 1
        }
    }
    round += 1
    seed = withSeed & M32
    count = 0
    digest = 0xCBF29CE484222325
    clock = 0
    tick = 0
    readOnly = false
}

// What a register that was never written reads as. `space`: 0 the
// registers, 1 the PLL's, 2 the memory controller's.
pub fn seeded(space: usize, number: usize) -> usize {
    var x = (number * 2654435761 + seed + space * 0x9E3779B1) & M32
    x = x ^ (x >> 15)
    x = (x * 2246822519) & M32
    x = x ^ (x >> 13)
    return x
}

fn note(kind: Kind, number: usize, value: usize) -> void {
    if count < EVENTS { events[count] = Event.{ .kind = kind, .number = number, .value = value } }
    count += 1
    digest = (digest ^ @intCast(usize, @intFromEnum(kind))) *% 1099511628211
    digest = (digest ^ number) *% 1099511628211
    digest = (digest ^ value) *% 1099511628211
    const told = watcher
    told(kind, number, value)
}

// A register set without its being written down (what the card holds
// before a run).
pub fn hold(number: usize, value: usize) -> void {
    if number >= REGISTERS { return }
    words[number] = @intCast(u32, value & M32)
    stamps[number] = round
}

// What a register holds, without its being written down.
pub fn held(number: usize) -> usize {
    if number >= REGISTERS { return 0 }
    return if stamps[number] == round { @intCast(usize, words[number]) } else { seeded(0, number) }
}

pub fn read(number: usize) -> u32 {
    const value = held(number)
    note(Kind.read, number, value)
    return @intCast(u32, value)
}

pub fn write(number: usize, value: u32) -> bool {
    if readOnly { return false }
    note(Kind.write, number, @intCast(usize, value))
    if number < REGISTERS {
        words[number] = value
        stamps[number] = round
    }
    return true
}

pub fn pllRead(number: usize) -> u32 {
    const at = number & 0xFF
    const value = if pllStamps[at] == round { @intCast(usize, pllWords[at]) } else { seeded(1, at) }
    note(Kind.pll_read, at, value)
    return @intCast(u32, value)
}

pub fn pllWrite(number: usize, value: u32) -> bool {
    if readOnly { return false }
    note(Kind.pll_write, number & 0xFF, @intCast(usize, value))
    pllWords[number & 0xFF] = value
    pllStamps[number & 0xFF] = round
    return true
}

pub fn mcRead(number: usize) -> u32 {
    const at = number & 0xFF
    const value = if mcStamps[at] == round { @intCast(usize, mcWords[at]) } else { seeded(2, at) }
    note(Kind.mc_read, at, value)
    return @intCast(u32, value)
}

pub fn mcWrite(number: usize, value: u32) -> bool {
    if readOnly { return false }
    note(Kind.mc_write, number & 0xFF, @intCast(usize, value))
    mcWords[number & 0xFF] = value
    mcStamps[number & 0xFF] = round
    return true
}

pub fn delay(microseconds: usize) -> void {
    note(Kind.delay, microseconds, 0)
    clock += microseconds * 1000
}

pub fn now() -> usize {
    clock += tick
    return clock
}

// The card as the interpreter's hands.
pub fn hands() -> atom.Hands {
    return atom.Hands.{ .registers = REGISTERS, .read = read, .write = write, .pllRead = pllRead, .pllWrite = pllWrite, .mcRead = mcRead, .mcWrite = mcWrite, .delay = delay, .now = now }
}
