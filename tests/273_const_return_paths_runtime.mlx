// What `return` hands back from a function with a `const` aggregate local
// (a copy in the frame): a slice held in the local's field points
// elsewhere (here: a string literal) and comes back as it is; a slice of
// an array held in the local is rebased onto a copy that outlives the
// frame; an `if` of struct values comes back whole. The first case used
// to be rebased as if it pointed into the local (a dangling pointer), which
// broke the keys table of mlx-settings (desktop-shared/keys.mlx). Exits 13.
const Named = struct {
    code: u32
    name: []const u8
}

fn named(index: usize) -> Named {
    return match index {
        0 => Named.{ .code = 16, .name = "Q" },
        1 => Named.{ .code = 103, .name = "Up" },
        else => Named.{ .code = 0, .name = "" }
    }
}

// The name of the entry with `code`: a field of a const local.
fn nameOf(code: u32) -> []const u8 {
    var index: usize = 0
    while index < 3 {
        const entry = named(index)
        if entry.code == code { return entry.name }
        index += 1
    }
    return ""
}

const Buffer = struct {
    bytes: [4]u8
}

// A slice of the const local's own array.
fn head(source: *const Buffer) -> []const u8 {
    const copy = source.*
    return copy.bytes[0..2]
}

const Pair = struct {
    a: i32
    b: i32
}

fn pick(first: bool, source: *const Pair) -> Pair {
    const kept = source.*
    return if first { kept } else { Pair.{ .a = 7, .b = 8 } }
}

fn clobber() -> u64 {
    var noise: [16]u64 = undefined
    var index: usize = 0
    while index < 16 {
        noise[index] = 0xdeadbeef
        index += 1
    }
    return noise[3]
}

pub fn main() -> u8 {
    const up = nameOf(103)
    const noise = clobber()
    if up.length != 2 || up[0] != 85 || up[1] != 112 { return 1 }
    var buffer = Buffer.{ .bytes = [4]u8{ 1, 2, 3, 4 } }
    const part = head(&buffer)
    buffer.bytes[0] = 9
    const more = clobber()
    if part.length != 2 || part[0] != 1 || part[1] != 2 { return 2 }
    const pair = Pair.{ .a = 3, .b = 4 }
    const chosen = pick(true, &pair)
    const other = pick(false, &pair)
    if chosen.a != 3 || chosen.b != 4 || other.a != 7 || other.b != 8 { return 3 }
    return 13
}
