// A function type written where a builtin takes a type, bare and under
// the type prefixes: `@ptrCast(fn(u8) -> u8, raw)`, `?fn(...)`,
// `[*]?fn(...)` (a table of methods read through a raw pointer, as a
// translated C++ vtable is). Exits 13.
const S = extern struct { a: u64 }

fn increment(value: u8) -> u8 { return value + 1 }
fn add(s: *S, by: u64) -> u64 { return s.*.a + by }
fn sub(s: *S, by: u64) -> u64 { return s.*.a - by }

var table: [2]?fn(*S, u64) -> u64 = undefined

pub fn main() -> u8 {
    const raw: ?[*]u8 = unsafe { @ptrCast(?[*]u8, increment) }
    const plain = unsafe { @ptrCast(fn(u8) -> u8, raw.?) }
    const optional = unsafe { @ptrCast(?fn(u8) -> u8, raw) }
    var total: u64 = @intCast(u64, plain(1))
    if optional != null { total += @intCast(u64, optional.?(2)) }
    table[0] = add
    table[1] = sub
    var s: S = S.{ .a = 4 }
    const slots: ?[*]u8 = unsafe { @ptrCast(?[*]u8, &table) }
    const methods = unsafe { @ptrCast([*]?fn(*S, u64) -> u64, slots.?) }
    total += methods[0].?(&s, 1)
    total += methods[1].?(&s, 1)
    return @intCast(u8, total)
}
