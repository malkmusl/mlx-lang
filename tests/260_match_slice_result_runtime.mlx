// A match expression whose value is a slice carries both words (pointer and
// length) out of its arms, like `if` expressions: the length used to be
// dropped, and survived on x86_64 only because the arm's call left it in
// rdx (aarch64 reuses x1 and crashed). Exits 13.
fn pick(opcode: u16) -> []const u8 {
    if opcode == 0 { return "usun" }
    return ""
}

fn signature(which: u8, opcode: u16) -> []const u8 {
    return match which {
        0 => pick(opcode),
        1 => "hi",
        else => "x",
    }
}

fn length(text: []const u8) -> usize {
    var count: usize = 0
    for byte in text { count += 1 }
    return count
}

pub fn main() -> u8 {
    if length(signature(0, 0)) != 4 || signature(0, 0)[3] != 110 { return 1 }
    if length(signature(0, 1)) != 0 { return 2 }
    if length(signature(1, 0)) != 2 || signature(1, 0)[1] != 105 { return 3 }
    if length(signature(9, 0)) != 1 { return 4 }
    return 13
}
