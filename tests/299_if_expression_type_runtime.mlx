// The type of an if expression whose first branch is a bare literal is the
// other branch's (`if c { 1 } else { size }` is a usize), so a comparison
// of it is unsigned; and a comparison takes its signedness from whichever
// side is an unsigned integer. Values above the signed range tell the two
// apart. Exits 13 on success.
fn atLeastOne(size: usize) -> usize { return if size == 0 { 1 } else { size } }

fn limitBelow(alignment: usize) -> usize {
    const most: usize = 18446744073709551615
    return most - alignment - 16 - 64
}

fn fits(size: usize, alignment: usize) -> bool {
    const wanted = if size == 0 { 1 } else { size }
    const limit = limitBelow(alignment)
    return !(wanted > limit)
}

pub fn main() -> u8 {
    if !fits(100, 16) { return 1 }
    if fits(18446744073709551615 - 8, 16) { return 2 }
    if atLeastOne(0) != 1 { return 3 }
    if atLeastOne(5) != 5 { return 4 }
    const huge: usize = 18446744073709551615 - 1
    const chosen = if huge > 10 { huge } else { 0 }
    if chosen != huge { return 5 }
    // A literal on the left of an unsigned comparison.
    if 1 > huge { return 6 }
    if !(1 < huge) { return 7 }
    // A float branch: the else branch's type too.
    const scale = if huge == 0 { 1.0 } else { @floatFromInt(f64, @intCast(i64, 7)) }
    if scale < 6.5 || scale > 7.5 { return 8 }
    return 13
}
