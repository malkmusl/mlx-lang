const strings = @import("./modules/135_string.zin")

pub fn main() -> u8 {
    const value = strings.escaped()
    var length: usize = 0
    for byte in value {
        length += 1
    }
    if length != 3 || value[0] != 111 || value[1] != 107 || value[2] != 10 {
        return 1
    }
    unsafe {
        if @ptrCast([*]const u8, value)[3] != 0 {
            return 2
        }
    }
    return 13
}
