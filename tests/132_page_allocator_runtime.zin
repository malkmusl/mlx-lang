const bootstrap = @import("../std/bootstrap/root.zin")

pub fn main() -> u8 {
    const page_allocator = bootstrap.page_allocator.init()
    const allocation = bootstrap.allocator.alloc(page_allocator, 4096, 8)
    if allocation == null {
        return 1
    }
    const memory = allocation.?
    memory[0] = 13
    const result = memory[0]
    bootstrap.allocator.free(page_allocator, memory, 4096, 8)
    return result
}
