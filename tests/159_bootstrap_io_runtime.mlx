const bootstrap = @import("../std/bootstrap/root.mlx")

pub fn main() -> u8 {
    const output = bootstrap.io.stdout()
    if bootstrap.io.write(output, "mlx") != 3 { return 1 }
    if !bootstrap.io.writeAll(output, " io ") { return 2 }
    if !bootstrap.io.writeUnsigned(output, 13) { return 3 }
    if !bootstrap.io.writeAll(output, " ") { return 4 }
    if !bootstrap.io.writeHex(output, 13) { return 5 }
    if !bootstrap.io.writeLine(output, "") { return 6 }

    const word = bootstrap.string.fromSlice("string")
    if !bootstrap.io.printString(word) { return 7 }
    if !bootstrap.io.println(" output") { return 8 }
    return 13
}
