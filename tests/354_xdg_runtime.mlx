// std.xdg over environments of the test's own: $XDG_CONFIG_HOME when it
// is absolute, else $HOME/.config (a relative or empty variable is
// ignored); the other kinds' defaults under $HOME; nothing without a
// home; a path that does not fit is not cut off; the runtime directory;
// the system's lists, their defaults, and the walk over them that skips
// empty and relative entries; a user's folder (userDirectory) from the
// environment's XDG_DOWNLOAD_DIR, from user-dirs.dirs ($HOME/... and an
// absolute path), else $HOME/Downloads. Exits 13 when every check holds, else the
// number of the first check that failed.
const std = @import("std")
const xdg = @import("std.xdg")

fn entry(text: []const u8) -> [*]const u8 { return text.pointer }

fn same(bytes: [*]const u8, length: usize, expected: []const u8) -> bool {
    return std.text.same(bytes[0..length], expected) && bytes[length] == 0
}

pub fn main() -> u8 {
    var full: [5][*]const u8 = undefined
    full[0] = entry("HOME=/home/ada\x00")
    full[1] = entry("XDG_CONFIG_HOME=/etc/ada\x00")
    full[2] = entry("XDG_RUNTIME_DIR=/run/user/1000\x00")
    full[3] = entry("XDG_DATA_DIRS=/opt/share::relative:/usr/share\x00")
    unsafe { full[4] = @ptrFromInt([*]const u8, 0) }
    const with_variables: [*][*]const u8 = &full

    var bare: [3][*]const u8 = undefined
    bare[0] = entry("HOME=/home/bob\x00")
    bare[1] = entry("XDG_CONFIG_HOME=relative/config\x00")
    unsafe { bare[2] = @ptrFromInt([*]const u8, 0) }
    const with_home: [*][*]const u8 = &bare

    var none: [2][*]const u8 = undefined
    none[0] = entry("HOME=\x00")
    unsafe { none[1] = @ptrFromInt([*]const u8, 0) }
    const homeless: [*][*]const u8 = &none

    var buffer: [64]u8 = undefined
    const bytes: [*]u8 = &buffer

    // The variable when it is absolute, else $HOME's default.
    var length = xdg.path(with_variables, xdg.CONFIG, "/mlx/audio.conf", bytes, 64)
    if !same(bytes, length, "/etc/ada/mlx/audio.conf") { return 1 }
    length = xdg.path(with_home, xdg.CONFIG, "/mlx/audio.conf", bytes, 64)
    if !same(bytes, length, "/home/bob/.config/mlx/audio.conf") { return 2 }
    length = xdg.home(with_variables, xdg.DATA, bytes, 64)
    if !same(bytes, length, "/home/ada/.local/share") { return 3 }
    length = xdg.home(with_home, xdg.CACHE, bytes, 64)
    if !same(bytes, length, "/home/bob/.cache") { return 4 }
    length = xdg.home(with_home, xdg.STATE, bytes, 64)
    if !same(bytes, length, "/home/bob/.local/state") { return 5 }

    // No home, and a path too long for the buffer.
    if xdg.home(homeless, xdg.CONFIG, bytes, 64) != 0 { return 6 }
    if xdg.path(with_home, xdg.CONFIG, "/mlx/audio.conf", bytes, 32) != 0 { return 7 }
    // Exactly fitting, with its NUL.
    if xdg.home(with_home, xdg.CACHE, bytes, 17) != 16 { return 8 }

    if !std.text.same(xdg.runtimeDirectory(with_variables), "/run/user/1000") { return 9 }
    if xdg.runtimeDirectory(with_home).length != 0 { return 10 }

    // The lists and their defaults.
    if !std.text.same(xdg.dataDirectories(with_home), "/usr/local/share:/usr/share") { return 11 }
    if !std.text.same(xdg.configDirectories(with_home), "/etc/xdg") { return 12 }
    const list = xdg.dataDirectories(with_variables)
    var at: usize = 0
    var directory: []const u8 = undefined
    if !xdg.nextDirectory(list, &at, &directory) || !std.text.same(directory, "/opt/share") { return 14 }
    if !xdg.nextDirectory(list, &at, &directory) || !std.text.same(directory, "/usr/share") { return 15 }
    if xdg.nextDirectory(list, &at, &directory) { return 16 }

    // A user's folder.
    var given: [3][*]const u8 = undefined
    given[0] = entry("HOME=/home/ada\x00")
    given[1] = entry("XDG_DOWNLOAD_DIR=/data/incoming\x00")
    unsafe { given[2] = @ptrFromInt([*]const u8, 0) }
    const with_folder: [*][*]const u8 = &given
    if !same(bytes, xdg.userDirectory(with_folder, "DOWNLOAD", "/Downloads", bytes, 64), "/data/incoming") { return 17 }
    if !same(bytes, xdg.userDirectory(with_home, "DOWNLOAD", "/Downloads", bytes, 64), "/home/bob/Downloads") { return 18 }
    const folder = "/tmp/mlx-xdg-test-354\x00"
    _ = std.fs.makeDir(folder.pointer, 0o755)
    const dirs = "/tmp/mlx-xdg-test-354/user-dirs.dirs\x00"
    const file = std.fs.open(dirs.pointer, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 0o644)
    if !std.fs.isValid(file) { return 19 }
    _ = std.fs.writeAll(file, "# written by xdg-user-dirs-update\nXDG_DESKTOP_DIR=\"$HOME/Schreibtisch\"\nXDG_DOWNLOAD_DIR=\"$HOME/T\xc3\xa9l\xc3\xa9chargements\"\nXDG_MUSIC_DIR=\"/srv/music\"\n")
    _ = std.fs.close(file)
    var configured: [3][*]const u8 = undefined
    configured[0] = entry("HOME=/home/eve\x00")
    configured[1] = entry("XDG_CONFIG_HOME=/tmp/mlx-xdg-test-354\x00")
    unsafe { configured[2] = @ptrFromInt([*]const u8, 0) }
    const with_dirs: [*][*]const u8 = &configured
    const downloads = xdg.userDirectory(with_dirs, "DOWNLOAD", "/Downloads", bytes, 64)
    const music = xdg.userDirectory(with_dirs, "MUSIC", "/Music", bytes, 64)
    const music_ok = same(bytes, music, "/srv/music")
    const pictures_ok = same(bytes, xdg.userDirectory(with_dirs, "PICTURES", "/Pictures", bytes, 64), "/home/eve/Pictures")
    const downloads_ok = same(bytes, xdg.userDirectory(with_dirs, "DOWNLOAD", "/Downloads", bytes, 64), "/home/eve/T\xc3\xa9l\xc3\xa9chargements")
    _ = std.fs.delete(dirs.pointer)
    _ = std.fs.removeDir(folder.pointer)
    if downloads == 0 || !downloads_ok { return 20 }
    if !music_ok { return 21 }
    if !pictures_ok { return 22 }
    return 13
}
