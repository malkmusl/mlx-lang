// std.displays (std/src/displays.mlx): a picture on a further display,
// fitted, on ordinary memory.
// - Where the picture lies: the same shape fills the display, a wider
//   picture has bars above and below, a narrower one beside it (1280x800
//   on 800x600 is 800x500, fifty rows down; 1024x768 on 1920x1080 is 1440
//   across, 240 in), the wide monitor's stretched picture on the board's
//   own adapter (shape 3840:1080 on 1024x768: 1024x288), a display whose
//   own pixels are not square, sides that would be nothing are a pixel.
// - What is brought: a plain colour comes out as itself at any pair of
//   sizes, the bars are black, nothing beside the display's rows is
//   written; a display of the frame's size gets the frame; a frame twice
//   the size comes out as the means of its 2x2 blocks, one half the size
//   as 2x2 blocks of its pixels; red and blue change places for a
//   red-first display; frames at chance against the mean worked out in
//   whole numbers over each pixel's part of the frame (within one).
// - Only what changed: after a rectangle of the frame changed and was
//   named, the display is what it is when the whole frame is brought
//   anew, and no more pixels were written than the rectangle covers on
//   the display (and its neighbours by a pixel).
// - In slices: brought a few rows at a time, with changes named in
//   between, the display ends as the whole frame's.
// - Seven displays at most; a display the frame is too large for is not
//   taken.
// Exits 13.
const std = @import("std")
const displays = @import("std.displays")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn fail(what: []const u8, a: usize, b: usize) -> u8 {
    say("FAIL ")
    say(what)
    say(" (")
    number(a)
    say(", ")
    number(b)
    say(")\n")
    return 1
}

// The frame (FRAME_W by FRAME_H at most) and two displays (SIDE by SIDE at
// most, a guard row above and below and a guard pixel after each row).
const FRAME_W: usize = 96
const FRAME_H: usize = 64
const SIDE: usize = 200
const GUARD: u32 = 0x5A5A5A5A
var frame: [FRAME_W * FRAME_H]u32 = undefined
var shown: [(SIDE + 1) * (SIDE + 2)]u32 = undefined
var whole: [(SIDE + 1) * (SIDE + 2)]u32 = undefined

var seed: u64 = 0x9E3779B97F4A7C15

fn chance() -> usize {
    seed = seed ^ (seed << 13)
    seed = seed ^ (seed >> 7)
    seed = seed ^ (seed << 17)
    return @intCast(usize, seed >> 11)
}

fn guard(memory: [*]u32) -> void {
    var k: usize = 0
    while k < (SIDE + 1) * (SIDE + 2) {
        memory[k] = GUARD
        k += 1
    }
}

// The display's first pixel in its memory (after the guard row), its rows
// SIDE + 1 pixels apart.
fn at(memory: [*]u32) -> usize { return @intFromPtr(memory) + (SIDE + 1) * 4 }

fn pixel(memory: [*]const u32, x: usize, y: usize) -> u32 { return memory[(y + 1) * (SIDE + 1) + x] }

// Whether everything outside the display's `width` by `height` pixels is
// still the guard.
fn guarded(memory: [*]const u32, width: usize, height: usize) -> bool {
    var k: usize = 0
    while k < (SIDE + 1) * (SIDE + 2) {
        const row = k / (SIDE + 1)
        const column = k % (SIDE + 1)
        const inside = row >= 1 && row <= height && column < width
        if !inside && memory[k] != GUARD { return false }
        k += 1
    }
    return true
}

fn channel(value: u32, which: usize) -> usize { return @intCast(usize, (value >> @intCast(u5, which * 8)) & 255) }

// The mean of the frame's part under the display's pixel (column, row) of
// a picture `across` by `down` that shows a frame `wide` by `high`, a
// channel, in whole numbers: every pixel of the frame by the part of it
// inside (positions cut to 1/256 of a pixel, as the module cuts them),
// the nearest whole number.
fn mean(wide: usize, high: usize, across: usize, down: usize, column: usize, row: usize, which: usize) -> usize {
    const left = column * wide * 256 / across
    const right = (column + 1) * wide * 256 / across
    const top = row * high * 256 / down
    const bottom = (row + 1) * high * 256 / down
    var sum: usize = 0
    var y = top / 256
    while y * 256 < bottom {
        const yFrom = if y * 256 > top { y * 256 } else { top }
        const yTo = if (y + 1) * 256 < bottom { (y + 1) * 256 } else { bottom }
        var x = left / 256
        while x * 256 < right {
            const xFrom = if x * 256 > left { x * 256 } else { left }
            const xTo = if (x + 1) * 256 < right { (x + 1) * 256 } else { right }
            sum += channel(frame[y * wide + x], which) * (xTo - xFrom) * (yTo - yFrom)
            x += 1
        }
        y += 1
    }
    const area = (right - left) * (bottom - top)
    return (sum + area / 2) / area
}

fn near(a: usize, b: usize) -> bool { return if a > b { a - b <= 1 } else { b - a <= 1 } }

fn fits(pw: usize, ph: usize, w: usize, h: usize, sw: usize, sh: usize, x: usize, y: usize, fw: usize, fh: usize) -> bool {
    const got = displays.fit(pw, ph, w, h, sw, sh)
    return got.x == x && got.y == y && got.width == fw && got.height == fh
}

// The frame of `wide` by `high` filled at chance, in flat patches and
// single pixels (text and plain areas both).
fn fill(wide: usize, high: usize) -> void {
    var k: usize = 0
    while k < wide * high {
        frame[k] = @intCast(u32, chance() & 0xFFFFFF) | 0xFF000000
        k += 1
    }
    var patches: usize = 0
    while patches < 6 {
        const colour = @intCast(u32, chance() & 0xFFFFFF) | 0xFF000000
        const x = chance() % wide
        const y = chance() % high
        const w = 1 + chance() % (wide - x)
        const h = 1 + chance() % (high - y)
        var row = y
        while row < y + h {
            var column = x
            while column < x + w {
                frame[row * wide + column] = colour
                column += 1
            }
            row += 1
        }
        patches += 1
    }
}

// A frame of `wide` by `high` on a display of `width` by `height`, brought
// whole into `memory`; false when the display is not taken.
fn show(further: *displays.Further, memory: [*]u32, wide: usize, high: usize, width: usize, height: usize, swap: bool) -> bool {
    guard(memory)
    displays.begin(further, wide, high, 0, 0)
    if !displays.attach(further, at(memory), width, height, (SIDE + 1) * 4, swap, 0, 0) { return false }
    _ = displays.serve(further, @intFromPtr(&frame), wide * 4, 0)
    return true
}

pub fn main() -> u8 {
    // ---- where the picture lies ----
    if !fits(1920, 1080, 1280, 720, 0, 0, 0, 0, 1280, 720) { return fail("the same shape does not fill the display", 0, 0) }
    if !fits(1280, 800, 800, 600, 0, 0, 0, 50, 800, 500) { return fail("1280x800 on 800x600 is not 800x500, 50 down", displays.fit(1280, 800, 800, 600, 0, 0).height, displays.fit(1280, 800, 800, 600, 0, 0).y) }
    if !fits(1024, 768, 1920, 1080, 0, 0, 240, 0, 1440, 1080) { return fail("1024x768 on 1920x1080 is not 1440 across, 240 in", displays.fit(1024, 768, 1920, 1080, 0, 0).width, displays.fit(1024, 768, 1920, 1080, 0, 0).x) }
    // The wide monitor's picture (whatever its mode: its screen's shape
    // counts) on the board's adapter.
    if !fits(3840, 1080, 1024, 768, 0, 0, 0, 240, 1024, 288) { return fail("a 3840:1080 picture on 1024x768 is not 1024x288", displays.fit(3840, 1080, 1024, 768, 0, 0).height, displays.fit(3840, 1080, 1024, 768, 0, 0).y) }
    // A display whose own picture is stretched (1920x1080 shown on a
    // screen of 3840:1080): a 16:9 picture takes half its columns.
    if !fits(16, 9, 1920, 1080, 3840, 1080, 480, 0, 960, 1080) { return fail("a 16:9 picture on a 1920x1080 mode shown 32:9 is not 960 across", displays.fit(16, 9, 1920, 1080, 3840, 1080).width, displays.fit(16, 9, 1920, 1080, 3840, 1080).x) }
    if !fits(10000, 1, 100, 50, 0, 0, 0, 24, 100, 1) { return fail("a side that would be nothing is not a pixel", displays.fit(10000, 1, 100, 50, 0, 0).height, displays.fit(10000, 1, 100, 50, 0, 0).y) }
    if !fits(1, 10000, 100, 50, 0, 0, 49, 0, 1, 50) { return fail("a side that would be nothing is not a pixel (across)", displays.fit(1, 10000, 100, 50, 0, 0).width, displays.fit(1, 10000, 100, 50, 0, 0).x) }
    // (Shapes at chance: inside the display, one side the display's, the
    // other within a pixel of the shape's, in the middle.)
    var round: usize = 0
    while round < 2000 {
        const pw = 1 + chance() % 4000
        const ph = 1 + chance() % 4000
        const w = 1 + chance() % 4000
        const h = 1 + chance() % 4000
        const got = displays.fit(pw, ph, w, h, 0, 0)
        if got.width == 0 || got.height == 0 || got.x + got.width > w || got.y + got.height > h { return fail("a fitted picture reaches outside its display", w, h) }
        if got.width != w && got.height != h { return fail("a fitted picture touches neither pair of edges", w, h) }
        if got.x != (w - got.width) / 2 || got.y != (h - got.height) / 2 { return fail("a fitted picture is not in the middle", got.x, got.y) }
        // (width * ph against height * pw: equal but for the rounding of
        // one side to a whole pixel.)
        const one = got.width * ph
        const other = got.height * pw
        const slack = if got.width == w { pw } else { ph }
        if got.width > 1 && got.height > 1 && (if one > other { one - other } else { other - one }) > slack { return fail("a fitted picture has another shape than the picture", w, h) }
        round += 1
    }

    // ---- what is brought ----
    var further: displays.Further = undefined
    var other: displays.Further = undefined
    // A plain colour, any sizes: itself inside the picture, black beside
    // it, nothing outside the display.
    round = 0
    while round < 300 {
        const wide = 1 + chance() % FRAME_W
        const high = 1 + chance() % FRAME_H
        const width = 1 + chance() % SIDE
        const height = 1 + chance() % SIDE
        const colour = @intCast(u32, chance() & 0xFFFFFF) | 0xFF000000
        var k: usize = 0
        while k < wide * high {
            frame[k] = colour
            k += 1
        }
        const swap = round % 3 == 0
        if show(&further, &shown, wide, high, width, height, swap) {
            const place = displays.fit(wide, high, width, height, 0, 0)
            const wanted = if swap { (colour & 0xFF00FF00) | ((colour & 255) << 16) | ((colour >> 16) & 255) } else { colour }
            var y: usize = 0
            while y < height {
                var x: usize = 0
                while x < width {
                    const inside = x >= place.x && x < place.x + place.width && y >= place.y && y < place.y + place.height
                    const got = pixel(&shown, x, y)
                    if inside && got != wanted { return fail("a plain colour does not come out as itself", @intCast(usize, got), @intCast(usize, wanted)) }
                    if !inside && got != 0 { return fail("a bar is not black", x, y) }
                    x += 1
                }
                y += 1
            }
            if !guarded(&shown, width, height) { return fail("something was written outside the display", width, height) }
            if displays.waiting(&further) { return fail("something waits after everything was brought", wide, high) }
            displays.close(&further)
        } else if wide <= place15(wide, high, width, height) {
            return fail("a display the frame is not too large for was not taken", width, height)
        }
        round += 1
    }

    // The frame's own size: the frame; red first: red and blue changed.
    fill(40, 30)
    if !show(&further, &shown, 40, 30, 40, 30, false) { return fail("a display of the frame's size was not taken", 40, 30) }
    var y: usize = 0
    while y < 30 {
        var x: usize = 0
        while x < 40 {
            if pixel(&shown, x, y) != frame[y * 40 + x] { return fail("a display of the frame's size does not show the frame", x, y) }
            x += 1
        }
        y += 1
    }
    displays.close(&further)
    if !show(&further, &shown, 40, 30, 40, 30, true) { return fail("a red-first display was not taken", 40, 30) }
    y = 0
    while y < 30 {
        var x: usize = 0
        while x < 40 {
            const p = frame[y * 40 + x]
            if pixel(&shown, x, y) != ((p & 0xFF00FF00) | ((p & 255) << 16) | ((p >> 16) & 255)) { return fail("a red-first display does not get red and blue changed", x, y) }
            x += 1
        }
        y += 1
    }
    displays.close(&further)

    // Half the size: the means of the 2x2 blocks. Twice the size: 2x2
    // blocks of the pixels.
    fill(40, 30)
    if !show(&further, &shown, 40, 30, 20, 15, false) { return fail("a display of half the size was not taken", 20, 15) }
    y = 0
    while y < 15 {
        var x: usize = 0
        while x < 20 {
            var which: usize = 0
            while which < 3 {
                const sum = channel(frame[2 * y * 40 + 2 * x], which) + channel(frame[2 * y * 40 + 2 * x + 1], which) + channel(frame[(2 * y + 1) * 40 + 2 * x], which) + channel(frame[(2 * y + 1) * 40 + 2 * x + 1], which)
                if channel(pixel(&shown, x, y), which) != (sum + 2) / 4 { return fail("half the size is not the mean of four pixels", channel(pixel(&shown, x, y), which), (sum + 2) / 4) }
                which += 1
            }
            x += 1
        }
        y += 1
    }
    displays.close(&further)
    if !show(&further, &shown, 40, 30, 80, 60, false) { return fail("a display of twice the size was not taken", 80, 60) }
    y = 0
    while y < 60 {
        var x: usize = 0
        while x < 80 {
            if pixel(&shown, x, y) != frame[(y / 2) * 40 + x / 2] { return fail("twice the size is not each pixel four times", x, y) }
            x += 1
        }
        y += 1
    }
    displays.close(&further)

    // Frames and sizes at chance against the mean in whole numbers.
    round = 0
    while round < 120 {
        const wide = 1 + chance() % FRAME_W
        const high = 1 + chance() % FRAME_H
        const width = 1 + chance() % SIDE
        const height = 1 + chance() % SIDE
        fill(wide, high)
        const swap = round % 4 == 1
        if show(&further, &shown, wide, high, width, height, swap) {
            const place = displays.fit(wide, high, width, height, 0, 0)
            var row: usize = 0
            while row < place.height {
                var column: usize = 0
                while column < place.width {
                    const got = pixel(&shown, place.x + column, place.y + row)
                    var which: usize = 0
                    while which < 3 {
                        const wanted = mean(wide, high, place.width, place.height, column, row, which)
                        // (A red-first display has the frame's blue where
                        // red is.)
                        const there = if swap { 2 - which } else { which }
                        if !near(channel(got, there), wanted) { return fail("a pixel is not the mean of its part of the frame", channel(got, there), wanted) }
                        which += 1
                    }
                    column += 1
                }
                row += 1
            }
            if !guarded(&shown, width, height) { return fail("something was written outside the display (frames at chance)", width, height) }
            displays.close(&further)
        }
        round += 1
    }

    // ---- only what changed, and in slices ----
    round = 0
    while round < 150 {
        const wide = 8 + chance() % (FRAME_W - 8)
        const high = 8 + chance() % (FRAME_H - 8)
        const width = 8 + chance() % (SIDE - 8)
        const height = 8 + chance() % (SIDE - 8)
        fill(wide, high)
        if show(&further, &shown, wide, high, width, height, false) {
            const place = displays.fit(wide, high, width, height, 0, 0)
            // Changes: named one by one; brought whole (even rounds) or a
            // few of the frame's pixels at a time with the next change
            // named in between (odd rounds).
            var changes: usize = 0
            var bound: usize = 0
            const before = further.pixels
            while changes < 4 {
                const x = chance() % wide
                const top = chance() % high
                const w = 1 + chance() % (wide - x)
                const h = 1 + chance() % (high - top)
                var row = top
                while row < top + h {
                    var column = x
                    while column < x + w {
                        frame[row * wide + column] = @intCast(u32, chance() & 0xFFFFFF) | 0xFF000000
                        column += 1
                    }
                    row += 1
                }
                displays.damage(&further, x, top, w, h)
                // (No more of the display than the rectangle covers, a
                // pixel more on each side.)
                bound += (w * place.width / wide + 3) * (h * place.height / high + 3)
                if round % 2 == 0 {
                    _ = displays.serve(&further, @intFromPtr(&frame), wide * 4, 0)
                } else {
                    _ = displays.bringSome(&further, @intFromPtr(&frame), wide * 4, 1 + chance() % 200)
                }
                changes += 1
            }
            if round % 2 == 0 && further.pixels - before > bound { return fail("more of the display was written than changed", further.pixels - before, bound) }
            var turns: usize = 0
            while displays.bringSome(&further, @intFromPtr(&frame), wide * 4, 1 + chance() % 200) {
                turns += 1
                if turns > 100000 { return fail("slices do not come to an end", wide, high) }
            }
            if displays.waiting(&further) { return fail("something waits after the last slice", wide, high) }
            // The same frame brought whole to a display of its own.
            if !show(&other, &whole, wide, high, width, height, false) { return fail("the display to compare with was not taken", width, height) }
            var k: usize = 0
            while k < (SIDE + 1) * (SIDE + 2) {
                if shown[k] != whole[k] { return fail("after changes named, the display is not what the whole frame gives", k % (SIDE + 1), k / (SIDE + 1)) }
                k += 1
            }
            displays.close(&other)
            displays.close(&further)
        }
        round += 1
    }

    // ---- how many, and which not ----
    fill(FRAME_W, FRAME_H)
    guard(&shown)
    displays.begin(&further, FRAME_W, FRAME_H, 0, 0)
    var taken: usize = 0
    while taken < 9 {
        if !displays.attach(&further, at(&shown), 50, 50, (SIDE + 1) * 4, false, 0, 0) { break }
        taken += 1
    }
    if taken != displays.MAX || further.count != displays.MAX { return fail("not seven displays at most", taken, further.count) }
    displays.close(&further)
    // (96x64 on a display of 6x4: sixteen times across.)
    displays.begin(&further, FRAME_W, FRAME_H, 0, 0)
    if displays.attach(&further, at(&shown), 6, 4, (SIDE + 1) * 4, false, 0, 0) { return fail("a display the frame is sixteen times too large for was taken", 6, 4) }
    if displays.serve(&further, @intFromPtr(&frame), FRAME_W * 4, 0) || displays.waiting(&further) { return fail("without a display something waits", 0, 0) }
    displays.damageAll(&further)
    return 13
}

// The widest frame a display of `width` by `height` takes for a frame of
// the shape `wide`:`high` (fifteen times its picture's width; 0 when the
// height is what does not fit).
fn place15(wide: usize, high: usize, width: usize, height: usize) -> usize {
    const place = displays.fit(wide, high, width, height, 0, 0)
    if high > place.height * 15 { return 0 }
    return place.width * 15
}
