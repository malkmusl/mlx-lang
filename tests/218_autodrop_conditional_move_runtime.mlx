// A runtime ownership flag keeps conditional moves exactly-once.
const OwnedCounter = @noncopy(struct) {
    counter: *u8

    fn deinit(self: *Self) -> void {
        self.*.counter.* += 1
    }
}

fn conditionalMove(counter: *u8, take: bool) -> void {
    const source = OwnedCounter.{ .counter = counter }
    if take {
        const destination = @move(source)
    }
}

fn main() -> u8 {
    var drops: u8 = 0
    conditionalMove(&drops, false)
    conditionalMove(&drops, true)
    return drops
}
