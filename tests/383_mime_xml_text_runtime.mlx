// std.http.mime and std.xml.text's writing side: media types guessed
// from a file name's extension (the case ignored, a compound extension,
// the base name of a path), from the first bytes of data (signatures,
// tags after white space, text or not) and from both as GIO answers;
// text escaped for character data, for an attribute, for ASCII output
// and for HTML; names checked as Name, NCName, QName and Nmtoken, with
// or without blanks around them, beyond ASCII, and bytes that are not
// UTF-8 refused. Exits 13 when every check holds, else the number of the
// first check that failed.
const mime = @import("std.http.mime")
const text = @import("std.xml.text")

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

const Out = struct {
    bytes: [256]u8
    length: usize
}

fn outWrite(context: usize, bytes: []const u8) -> void {
    const out = unsafe { @ptrFromInt(*Out, context) }
    for byte in bytes {
        if out.*.length < 256 {
            out.*.bytes[out.*.length] = byte
            out.*.length += 1
        }
    }
}

fn escaped(value: []const u8, mode: text.Escape, expected: []const u8) -> bool {
    var out: Out = undefined
    out.length = 0
    const sink = text.Sink.{ .context = @intFromPtr(&out), .write = outWrite }
    text.writeEscaped(sink, value, mode)
    return same(out.bytes[0..out.length], expected)
}

pub fn main() -> u8 {
    var uncertain = false
    // By name.
    if !same(mime.byName("index.html", &uncertain), "text/html") || !uncertain { return 1 }
    if !same(mime.byName("/var/www/Photo.JPG", &uncertain), "image/jpeg") || uncertain { return 2 }
    if !same(mime.byName("backup.tar.gz", &uncertain), "application/x-compressed-tar") { return 3 }
    if !same(mime.byName("backup.gz", &uncertain), "application/gzip") { return 4 }
    if mime.byName("Makefile", &uncertain).length != 0 || mime.byName("png", &uncertain).length != 0 || mime.byName("dir.png/file", &uncertain).length != 0 { return 5 }
    if !same(mime.baseName("a/b/c.txt"), "c.txt") || !same(mime.baseName("c.txt"), "c.txt") || mime.baseName("a/").length != 0 { return 6 }
    if !mime.hasExtension("x.WOFF2", "woff2") || mime.hasExtension("xwoff2", "woff2") || mime.hasExtension("woff2", "woff2") { return 7 }
    // By data.
    if !same(mime.byData("\x89PNG\r\n\x1a\n\x00\x00", &uncertain), "image/png") || uncertain { return 8 }
    if !same(mime.byData("  \n<!DOCTYPE HTML><html>", &uncertain), "text/html") || !same(mime.byData("<svg xmlns=", &uncertain), "image/svg+xml") || !same(mime.byData("<?xml version", &uncertain), "application/xml") { return 9 }
    if !same(mime.byData("RIFF\x00\x00\x00\x00WEBPVP8 ", &uncertain), "image/webp") || !same(mime.byData("wOF2", &uncertain), "font/woff2") || !same(mime.byData("%PDF-1.7", &uncertain), "application/pdf") { return 10 }
    if !same(mime.byData("plain words, caf\xc3\xa9\n", &uncertain), "text/plain") || uncertain { return 11 }
    if !same(mime.byData("\x00\x01\x02", &uncertain), mime.UNKNOWN) || !uncertain { return 12 }
    if !same(mime.byData("caf\xe9", &uncertain), mime.UNKNOWN) || !same(mime.byData("", &uncertain), mime.EMPTY) { return 14 }
    if !mime.isText("a\tb\x0cc\r\n") || mime.isText("a\x7f") || mime.isText("a\x1b[0m") { return 15 }
    // Both, as GIO answers.
    if !same(mime.guess("a.html", true, "", false, &uncertain), "text/html") || !uncertain { return 16 }
    if !same(mime.guess("a.html", true, "<html>", true, &uncertain), "text/html") || uncertain { return 17 }
    if !same(mime.guess("a.bin", true, "GIF89a", true, &uncertain), "image/gif") || uncertain { return 18 }
    if !same(mime.guess("", false, "", false, &uncertain), mime.UNKNOWN) || !uncertain { return 19 }
    if !same(mime.guess("a.bin", true, "", true, &uncertain), mime.EMPTY) || uncertain { return 20 }
    // The table in turn.
    var at: usize = 0
    var extension: []const u8 = ""
    var type_: []const u8 = ""
    var count: usize = 0
    while mime.nextEntry(&at, &extension, &type_, &uncertain) {
        if extension.length == 0 || type_.length == 0 { return 21 }
        count += 1
    }
    if count != 48 { return 22 }

    // Escaping.
    if !escaped("a < b & c > \"d\" é\r\n\x01z", text.Escape.content, "a &lt; b &amp; c &gt; \"d\" é&#13;\nz") { return 23 }
    if !escaped("a < b & c > \"d\" é\r\n\x01z", text.Escape.attribute, "a &lt; b &amp; c &gt; &quot;d&quot; é&#13;\n\x01z") { return 24 }
    if !escaped("a < b & c > \"d\" é\r\n\x01z", text.Escape.html, "a &lt; b &amp; c &gt; \"d\" é\r\nz") { return 25 }
    if !escaped("é€\xf0\x9f\x98\x80 x\xe9y\r", text.Escape.contentAscii, "&#xE9;&#x20AC;&#x1F600; x&#233;y&#13;") { return 26 }
    if !escaped("", text.Escape.content, "") || !escaped("plain", text.Escape.attribute, "plain") { return 27 }
    // A reference at the very end, and a sequence cut short.
    if !escaped("tail\xc3", text.Escape.contentAscii, "tail&#195;") || !escaped("x<", text.Escape.content, "x&lt;") { return 28 }

    // Names.
    if !text.isName("a:b-c.d_e1") || !text.isName("_x") || !text.isName(":x") || text.isName("1x") || text.isName("") || text.isName("a b") || text.isName("-a") { return 29 }
    if !text.isNCName("ab") || text.isNCName("a:b") || text.isNCName(":a") { return 30 }
    if !text.isQName("a:b") || !text.isQName("ab") || text.isQName("a:b:c") || text.isQName("a:") || text.isQName(":b") || text.isQName("a:1") { return 31 }
    if !text.isNmtoken("1x") || !text.isNmtoken("-a:b") || text.isNmtoken("") || text.isNmtoken("a b") { return 32 }
    if !text.isName("caf\xc3\xa9") || !text.isName("\xe4\xb8\xad") || text.isName("caf\xe9") || text.isName("caf\xc3") { return 33 }
    if text.validName(" a ", text.NameKind.name, false) || !text.validName(" a ", text.NameKind.name, true) || !text.validName("\t p:q\n", text.NameKind.qName, true) || text.validName(" ", text.NameKind.name, true) { return 34 }
    if text.nameEnd("ab cd", 0, false, true) != 2 || text.nameEnd("ab cd", 2, false, true) != 2 || text.nameEnd("ab cd", 3, false, true) != 5 || text.nameEnd("a:b", 0, false, false) != 1 { return 35 }
    return 13
}
