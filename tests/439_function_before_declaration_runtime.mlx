// A function named in a module-level initializer above its declaration:
// a table of functions and a function pointer declared before the
// functions (a translated C++ vtable standing before its class). The
// signature is typed where the name is first met. Exits 13.
var table: [2]?[*]u8 = [2]?[*]u8{ unsafe { @ptrCast(?[*]u8, f) }, unsafe { @ptrCast(?[*]u8, g) }, }
var chosen: ?fn(u32) -> u32 = g
fn f(a: u32) -> u32 {
    return a + 1
}
fn g(a: u32) -> u32 {
    return a * 2
}
pub fn main() -> u8 {
    const first = unsafe { @ptrCast(fn(u32) -> u32, table[0].?) }
    const second = unsafe { @ptrCast(fn(u32) -> u32, table[1].?) }
    return @intCast(u8, first(4) + second(3) + chosen.?(1))
}
