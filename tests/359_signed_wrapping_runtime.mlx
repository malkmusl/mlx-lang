// The wrapping operators (+%, -%, *%) on a narrow signed type give a value
// sign-extended like any other: the result used to be masked to the
// type's width only, so a negative i32 from `a -% b` was large and
// positive to the comparisons, divisions and widenings after it (a width
// left over in Arabic justification compared as positive). Exits 13.
const std = @import("std")

fn value(v: i32) -> i32 { return v }

pub fn main(arguments: [][*]const u8) -> u8 {
    const a = value(449)
    const b = value(834)
    const r = a -% b
    if r > 134 { return 1 }
    if r / 5 != -77 { return 2 }
    if @intCast(i64, r) != -385 { return 3 }
    var total: i32 = value(3)
    total -%= 10
    if total >= 0 { return 4 }
    const product = value(-7) *% value(3)
    if product != -21 || product > 0 { return 5 }
    const sum = value(2147483647) +% value(1)
    if sum >= 0 || @intCast(i64, sum) != -2147483648 { return 6 }
    var small: i16 = @intCast(i16, value(5))
    small = small -% @intCast(i16, value(9))
    if small >= 0 || @intCast(i32, small) != -4 { return 7 }
    const wide = @intCast(u32, value(5)) -% @intCast(u32, value(9))
    if wide != 0xFFFFFFFC { return 8 }
    return 13
}
