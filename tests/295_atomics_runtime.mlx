// The atomic builtins (spec/00-language/atomics-tls.xml): loads, stores,
// the read-modify-writes and the compare-exchanges at every width and
// signedness, with the values they answer, the fences, and four threads
// counting on one word through @atomicRmw and through a lock made of
// @cmpxchgWeak and @atomicStore. Exits 13 on success.
extern("c") fn pthread_create(thread: *u64, attributes: usize, start: usize, argument: usize) -> i32
extern("c") fn pthread_join(thread: u64, result: usize) -> i32

const ROUNDS: u64 = 100000

const Shared = struct {
    counter: u64
    lock: u32
    guarded: u64
}

// Each thread adds ROUNDS to the counter, and ROUNDS to the guarded word
// under the lock (0 free, 1 taken).
export fn worker(argument: usize) -> usize {
    var shared: *Shared = undefined
    unsafe { shared = @ptrFromInt(*Shared, argument) }
    var round: u64 = 0
    while round < ROUNDS {
        const previous = @atomicRmw(u64, &shared.*.counter, add, 1, monotonic)
        while true {
            const taken = @cmpxchgWeak(u32, &shared.*.lock, 0, 1, acquire, monotonic)
            if taken.0 { break }
        }
        shared.*.guarded += 1
        @atomicStore(u32, &shared.*.lock, 0, release)
        round += 1
    }
    return 0
}

pub fn main() -> u8 {
    var word: u64 = 5
    if @atomicLoad(u64, &word, seq_cst) != 5 { return 1 }
    @atomicStore(u64, &word, 9, seq_cst)
    if word != 9 { return 2 }
    if @atomicRmw(u64, &word, add, 3, seq_cst) != 9 || word != 12 { return 3 }
    if @atomicRmw(u64, &word, sub, 2, acq_rel) != 12 || word != 10 { return 4 }
    if @atomicRmw(u64, &word, xchg, 100, seq_cst) != 10 || word != 100 { return 5 }
    if @atomicRmw(u64, &word, and, 60, seq_cst) != 100 || word != 36 { return 6 }
    if @atomicRmw(u64, &word, or, 3, seq_cst) != 36 || word != 39 { return 7 }
    if @atomicRmw(u64, &word, xor, 255, seq_cst) != 39 || word != 216 { return 8 }
    if @atomicRmw(u64, &word, max, 300, seq_cst) != 216 || word != 300 { return 9 }
    if @atomicRmw(u64, &word, min, 7, seq_cst) != 300 || word != 7 { return 10 }
    if @atomicRmw(u64, &word, nand, 5, seq_cst) != 7 || word != 18446744073709551610 { return 11 }

    // Narrow and signed: max and min go by the sign, the answers come back
    // sign-extended, the sums wrap at the width.
    var small: i8 = -3
    if @atomicRmw(i8, &small, max, 2, seq_cst) != -3 || small != 2 { return 12 }
    if @atomicRmw(i8, &small, min, -7, seq_cst) != 2 || small != -7 { return 13 }
    if @atomicLoad(i8, &small, acquire) != -7 { return 14 }
    var half: u16 = 65535
    if @atomicRmw(u16, &half, add, 2, seq_cst) != 65535 || half != 1 { return 15 }
    var byte: u8 = 200
    if @atomicRmw(u8, &byte, add, 100, monotonic) != 200 || byte != 44 { return 16 }
    var quad: u32 = 4000000000
    if @atomicRmw(u32, &quad, xchg, 7, seq_cst) != 4000000000 || quad != 7 { return 17 }
    @atomicStore(u8, &byte, 3, release)
    if @atomicLoad(u8, &byte, monotonic) != 3 { return 18 }

    // A compare-exchange says whether it swapped and what it saw.
    var slot: u32 = 10
    const first = @cmpxchgStrong(u32, &slot, 10, 20, seq_cst, monotonic)
    if !first.0 || first.1 != 10 || slot != 20 { return 19 }
    const second = @cmpxchgStrong(u32, &slot, 10, 30, seq_cst, seq_cst)
    if second.0 || second.1 != 20 || slot != 20 { return 20 }
    var signed_slot: i16 = -2
    const third = @cmpxchgWeak(i16, &signed_slot, -2, 5, acq_rel, acquire)
    if !third.0 || third.1 != -2 || signed_slot != 5 { return 21 }
    var address_slot: usize = 0
    const fourth = @cmpxchgStrong(usize, &address_slot, 0, @intFromPtr(&word), release, monotonic)
    if !fourth.0 || address_slot != @intFromPtr(&word) { return 22 }
    @fence(seq_cst)
    @fence(acquire)
    @fence(release)
    @fence(acq_rel)

    var shared = Shared.{ .counter = 0, .lock = 0, .guarded = 0 }
    var threads: [4]u64 = [4]u64{ 0, 0, 0, 0 }
    var index: usize = 0
    while index < 4 {
        // (Mlx has no &array[i]; the element's address is computed.)
        var slot: *u64 = undefined
        unsafe { slot = @ptrFromInt(*u64, @intFromPtr(&threads) + index * 8) }
        if pthread_create(slot, 0, @intFromPtr(worker), @intFromPtr(&shared)) != 0 { return 23 }
        index += 1
    }
    index = 0
    while index < 4 {
        const joined = pthread_join(threads[index], 0)
        index += 1
    }
    if @atomicLoad(u64, &shared.counter, seq_cst) != 4 * ROUNDS { return 24 }
    if shared.guarded != 4 * ROUNDS { return 25 }
    return 13
}
