// The compositor's damage tracking (projects/desktop/compositor/scene.mlx):
// every change to the scene reports what it covers, each of the two frame
// slots is composed only in what it lacks (takeDamage), and the result
// must equal a frame composed from scratch. A random sequence of the
// changes the compositor makes (windows moved, raised, resized and
// redrawn, focus, the cursor, popups, subsurfaces moved, restacked and
// redrawn, a window with a blur region behind it) is played against
// three targets:
// two slots composed the nested way (into the slot itself) and a frame
// kept the freestanding way (composed once, its damaged part copied into
// each slot).
//
// The blur behind a surface is kept from frame to frame and made again
// only where what lies below the surface changed, so the frame from
// scratch is composed with nothing kept (scene.composeAnew): a blur kept
// too long differs from it. The play is repeated with what a desktop has:
// a background, a blurred bar along the top and a blurred dock at the
// bottom, with windows moving under the bar, the background changing, the
// bar and the dock committing (whole, or a part with the damage the
// client names: only that part is copied and only that part of the scene
// damaged), the pointer crossing them, the bar resized,
// its blur taken away, the bar itself taken away and brought back; and
// once more on an output large enough for a blur of several tiles. Frames
// in which nothing below a blurred surface changed (the pointer moved, the
// bar committed) must blur nothing.
//
// Before that: the multiplication the blur's passes divide with against
// the division, for every sum there can be; the blur itself against the
// passes scene.mlx made it with before (boxPass, kept here as it was),
// pixel for pixel; and the cases a kept blur must go through told one by
// one (told), each with what it must and must not blur and draw again.
// Exits 13.
const std = @import("std")
const ui = @import("std.ui")
const state = @import("../projects/desktop/compositor/state.mlx")
const scene = @import("../projects/desktop/compositor/scene.mlx")
const buffers = @import("../projects/desktop/compositor/buffers.mlx")

const Compositor = state.Compositor
const Surface = state.Surface

const WINDOWS: usize = 4
// A count that says "keeps no valid blur" (keptTiles).
const NOTHING: usize = 18446744073709551615

// xorshift64.
fn random(seed: *u64, limit: u64) -> u64 {
    var value = seed.*
    value = value ^ (value << 13)
    value = value ^ (value >> 7)
    value = value ^ (value << 17)
    seed.* = value
    return value % limit
}

fn randomInt(seed: *u64, low: i32, high: i32) -> i32 {
    return low + @intCast(i32, random(seed, @intCast(u64, high - low + 1)))
}

fn zero(memory: [*]u8, size: usize) -> void {
    var index: usize = 0
    while index < size {
        memory[index] = 0
        index += 1
    }
}

// Fills a surface's pixels with one color (alpha included: 255 or less).
fn paint(surface: *Surface, color: u32) -> void {
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrCast([*]u32, surface.*.pixels) }
    var index: usize = 0
    while index < surface.*.pixelWidth * surface.*.pixelHeight {
        pixels[index] = color
        index += 1
    }
    surface.*.opaque = color >> 24 == 255
    surface.*.translucentRow = 0
}

// Fills a rectangle of a surface (inside it) with one color.
fn paintRect(surface: *Surface, area: ui.Rect, color: u32) -> void {
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrCast([*]u32, surface.*.pixels) }
    var row = area.y
    while row < ui.bottom(area) {
        var column = area.x
        while column < ui.right(area) {
            pixels[@intCast(usize, row) * surface.*.pixelWidth + @intCast(usize, column)] = color
            column += 1
        }
        row += 1
    }
}

// A buffer committed with the damage its client names: new pixels of
// `color` in a part of the surface (often reaching outside it), and around
// them, in the buffer, not what the surface shows (the client draws there
// already). Taken and reported as a commit does it (buffers.mlx
// takePixels, windows.mlx applyCommit): the part alone, or, when all of it
// was named or the part is off the output, the surface.
fn commitPart(compositor: *Compositor, seed: *u64, target: *Surface, color: u32) -> void {
    const width = target.*.pixelWidth
    const height = target.*.pixelHeight
    const size = width * height * 4
    const client = state.allocate(compositor, size)
    const client_pixels: [*]u32 = unsafe { @ptrCast([*]u32, client) }
    const named = ui.rect(randomInt(seed, -6, @intCast(i32, width) - 1), randomInt(seed, -6, @intCast(i32, height) - 1), randomInt(seed, 1, @intCast(i32, width)), randomInt(seed, 1, @intCast(i32, height)))
    const drawn = ui.intersect(named, ui.rect(0, 0, @intCast(i32, width), @intCast(i32, height)))
    var at: usize = 0
    while at < width * height {
        const inside = ui.contains(drawn, @intCast(i32, at % width), @intCast(i32, at / width))
        client_pixels[at] = if inside { color } else { 1431655765 ^ @intCast(u32, at) }
        at += 1
    }
    const before = scene.surfaceBounds(target)
    var part: ui.Rect = undefined
    if !(buffers.takePixels(target, @intFromPtr(client), width, height, width * 4, false, named, &part) && scene.damagePart(compositor, target, part)) {
        scene.damageRect(compositor, before)
        scene.damageContent(compositor, target)
    }
    state.release(compositor, client, size)
}

fn resize(compositor: *Compositor, surface: *Surface, width: usize, height: usize, color: u32) -> void {
    if surface.*.pixelCapacity > 0 { state.release(compositor, surface.*.pixels, surface.*.pixelCapacity) }
    surface.*.pixels = state.allocate(compositor, width * height * 4)
    surface.*.pixelCapacity = width * height * 4
    surface.*.pixelWidth = width
    surface.*.pixelHeight = height
    // (As after a commit: the copy holds all of the buffer.)
    surface.*.copied = true
    surface.*.scaledCopy = false
    paint(surface, color)
}

fn makeSurface(compositor: *Compositor, role: u8, x: i32, y: i32, width: usize, height: usize, color: u32) -> *Surface {
    var surface: *Surface = undefined
    const memory = state.allocate(compositor, @sizeOf(Surface))
    zero(memory, @sizeOf(Surface))
    unsafe { surface = @ptrCast(*Surface, memory) }
    surface.*.compositor = compositor
    surface.*.role = role
    surface.*.x = x
    surface.*.y = y
    surface.*.hasGeometry = false
    surface.*.pixelCapacity = 0
    surface.*.hasContent = true
    surface.*.mapped = true
    surface.*.parent = 0
    surface.*.titleLength = 0
    surface.*.children = state.newList(compositor.*.allocator)
    surface.*.belowCount = 0
    surface.*.subX = 0
    surface.*.subY = 0
    surface.*.hasInputRegion = false
    surface.*.inputCount = 0
    surface.*.hasBlur = false
    surface.*.blurCount = 0
    surface.*.blurKept = 0
    resize(compositor, surface, width, height, color)
    return surface
}

// A subsurface of `parent` at (x, y) in it, above or below it.
fn makeSubsurface(compositor: *Compositor, parent: *Surface, x: i32, y: i32, above: bool, color: u32) -> *Surface {
    const child = makeSurface(compositor, state.ROLE_SUBSURFACE, 0, 0, 30, 24, color)
    child.*.mapped = false
    child.*.parent = @intFromPtr(parent)
    child.*.subX = x
    child.*.subY = y
    if above {
        parent.*.children = state.listAppend(parent.*.children, @intFromPtr(child))
    } else {
        parent.*.children = state.listInsert(parent.*.children, 0, @intFromPtr(child))
        parent.*.belowCount += 1
    }
    return child
}

fn randomColor(seed: *u64) -> u32 {
    const alpha = if random(seed, 3) == 0 { @intCast(u32, random(seed, 255)) } else { 255 }
    // Premultiplied: channels at most alpha.
    return (alpha << 24) | ((@intCast(u32, random(seed, 256)) * alpha / 255) << 16) | ((@intCast(u32, random(seed, 256)) * alpha / 255) << 8) | (@intCast(u32, random(seed, 256)) * alpha / 255)
}

// A translucent color (what a bar over a blur is painted with).
fn glassColor(seed: *u64) -> u32 {
    const alpha = 40 + @intCast(u32, random(seed, 160))
    return (alpha << 24) | ((@intCast(u32, random(seed, 256)) * alpha / 255) << 16) | ((@intCast(u32, random(seed, 256)) * alpha / 255) << 8) | (@intCast(u32, random(seed, 256)) * alpha / 255)
}

fn differs(a: [*]const u8, b: [*]const u8, count: usize) -> usize {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return index }
        index += 1
    }
    return count
}

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }
fn sayNumber(value: usize) -> void { _ = std.io.writeUnsigned(std.io.stdout(), value) }

fn fail(width: usize, step: usize, change: u64, what: []const u8, at: usize) -> bool {
    say("output ")
    sayNumber(width)
    say(" wide, step ")
    sayNumber(step)
    say(" (change ")
    sayNumber(@intCast(usize, change))
    say("): ")
    say(what)
    say(" differs from the full frame at pixel ")
    sayNumber(at / 4 % width)
    say(",")
    sayNumber(at / 4 / width)
    say("\n")
    return false
}

// A compositor record with what scene.mlx reads of it: an output of
// width x height with nothing on it, the pointer inside.
fn setUp(compositor: *Compositor, width: usize, height: usize) -> void {
    var raw: [*]u8 = undefined
    unsafe { raw = @ptrCast([*]u8, compositor) }
    zero(raw, @sizeOf(Compositor))
    compositor.*.allocator = std.page_allocator.init()
    compositor.*.width = width
    compositor.*.height = height
    compositor.*.stack = state.newList(compositor.*.allocator)
    compositor.*.blurred = state.newList(compositor.*.allocator)
    compositor.*.surfaces = state.newList(compositor.*.allocator)
    compositor.*.pointerInside = true
    compositor.*.pointerX = 100
    compositor.*.pointerY = 80
    compositor.*.cursorSurface = 0
    compositor.*.cursorHotspotX = 0
    compositor.*.cursorHotspotY = 0
    compositor.*.cursorHidden = false
    compositor.*.resizing = 0
    compositor.*.resizeEdges = 0
    compositor.*.hoverEdges = 0
    compositor.*.hasText = false
    compositor.*.needsRedraw = false
    compositor.*.damage = ui.rect(0, 0, 0, 0)
    compositor.*.slotDamage[0] = ui.rect(0, 0, 0, 0)
    compositor.*.slotDamage[1] = ui.rect(0, 0, 0, 0)
}

// Gives `surface` a blur region of `count` rectangles added (x, y, width,
// height each, in `rects`), as protocols.mlx applyBlur does on a commit.
fn setBlur(compositor: *Compositor, surface: *Surface, rects: [*]const i32, count: usize) -> void {
    var index: usize = 0
    while index < count {
        surface.*.blurOps[index].subtract = false
        surface.*.blurOps[index].x = rects[index * 4]
        surface.*.blurOps[index].y = rects[index * 4 + 1]
        surface.*.blurOps[index].width = rects[index * 4 + 2]
        surface.*.blurOps[index].height = rects[index * 4 + 3]
        index += 1
    }
    surface.*.blurCount = count
    surface.*.hasBlur = count > 0
    const listed = state.listContains(compositor.*.blurred, @intFromPtr(surface))
    if surface.*.hasBlur && !listed { compositor.*.blurred = state.listAppend(compositor.*.blurred, @intFromPtr(surface)) }
    if !surface.*.hasBlur && listed { compositor.*.blurred = state.listRemove(compositor.*.blurred, @intFromPtr(surface)) }
    if !surface.*.hasBlur { scene.forgetBlur(compositor, surface) }
}

// How many tiles were blurred for what `surface` keeps of its blur, or
// NOTHING when it keeps no valid blur.
fn keptTiles(surface: *const Surface) -> usize {
    if surface.*.blurKept == 0 { return NOTHING }
    const blur = state.keptBlurAt(surface.*.blurKept)
    return if blur.*.valid { blur.*.tiles } else { NOTHING }
}

// ---------------------------------------------------------------------------
// The blur as scene.mlx made it before blurs were kept: boxPass and what it
// calls, and blurBehind (with the whole output as its clip), as they were.

fn boxPass(source: [*]const u32, target: [*]u32, start: usize, count: usize, step: usize, radius: i32) -> void {
    const window = @intCast(u32, radius * 2 + 1)
    var sums: [4]u32 = [4]u32{ 0, 0, 0, 0 }
    var offset: i32 = 0 - radius
    while offset <= radius {
        const at = clampIndex(offset, count)
        addPixel(&sums, source[start + at * step])
        offset += 1
    }
    var index: usize = 0
    while index < count {
        target[start + index * step] = ((sums[0] / window) << 24) | ((sums[1] / window) << 16) | ((sums[2] / window) << 8) | (sums[3] / window)
        const leaving = clampIndex(@intCast(i32, index) - radius, count)
        const entering = clampIndex(@intCast(i32, index) + radius + 1, count)
        subtractPixel(&sums, source[start + leaving * step])
        addPixel(&sums, source[start + entering * step])
        index += 1
    }
}

fn clampIndex(value: i32, count: usize) -> usize {
    if value < 0 { return 0 }
    if value >= @intCast(i32, count) { return count - 1 }
    return @intCast(usize, value)
}

fn addPixel(sums: *[4]u32, pixel: u32) -> void {
    sums.*[0] += pixel >> 24
    sums.*[1] += (pixel >> 16) & 255
    sums.*[2] += (pixel >> 8) & 255
    sums.*[3] += pixel & 255
}

fn subtractPixel(sums: *[4]u32, pixel: u32) -> void {
    sums.*[0] -= pixel >> 24
    sums.*[1] -= (pixel >> 16) & 255
    sums.*[2] -= (pixel >> 8) & 255
    sums.*[3] -= pixel & 255
}

fn widen(area: ui.Rect, amount: i32) -> ui.Rect {
    return ui.rect(area.x - amount, area.y - amount, area.width + amount * 2, area.height + amount * 2)
}

fn blurBefore(compositor: *Compositor, pixels: [*]u8, surface: *const Surface) -> void {
    const bounds = scene.blurBounds(surface)
    const area = ui.intersect(bounds, scene.outputRect(compositor))
    if ui.isEmpty(area) { return }
    // What the blur reads: the area and what lies within reach of it.
    const source = ui.intersect(widen(area, scene.BLUR_REACH), scene.outputRect(compositor))
    const width = @intCast(usize, source.width)
    const height = @intCast(usize, source.height)
    const size = width * height * 4
    const first_memory = state.allocate(compositor, size)
    const second_memory = state.allocate(compositor, size)
    var first: [*]u32 = undefined
    var second: [*]u32 = undefined
    var output: [*]u32 = undefined
    unsafe {
        first = @ptrCast([*]u32, first_memory)
        second = @ptrCast([*]u32, second_memory)
        output = @ptrCast([*]u32, pixels)
    }
    const stride = compositor.*.width
    var row: usize = 0
    while row < height {
        state.copyPixels(@intFromPtr(first) + row * width * 4, @intFromPtr(output) + ((@intCast(usize, source.y) + row) * stride + @intCast(usize, source.x)) * 4, width)
        row += 1
    }
    var pass: i32 = 0
    while pass < scene.BLUR_PASSES {
        row = 0
        while row < height {
            boxPass(first, second, row * width, width, 1, scene.BLUR_RADIUS)
            row += 1
        }
        var column: usize = 0
        while column < width {
            boxPass(second, first, column, height, width, scene.BLUR_RADIUS)
            column += 1
        }
        pass += 1
    }
    // Back into the output inside the region.
    const ops: [*]const state.RegionOp = &surface.*.blurOps
    const left = scene.originX(surface)
    const top = scene.originY(surface)
    var y = area.y
    while y < ui.bottom(area) {
        var x = area.x
        while x < ui.right(area) {
            if state.regionContains(ops, surface.*.blurCount, x - left, y - top) {
                output[@intCast(usize, y) * stride + @intCast(usize, x)] = first[@intCast(usize, y - source.y) * width + @intCast(usize, x - source.x)]
            }
            x += 1
        }
        y += 1
    }
    state.release(compositor, first_memory, size)
    state.release(compositor, second_memory, size)
}

// A box's mean as the passes take it now ((sum * factor) >> shift) is the
// division by the box's size, for every sum of that many bytes; and two
// sums in one word, 32 bits apart (as the passes divide them), stay apart.
fn checkMean() -> bool {
    const window = @intCast(u64, scene.BLUR_RADIUS * 2 + 1)
    var sum: u64 = 0
    while sum <= window * 255 {
        if (sum * scene.BLUR_MEAN_FACTOR) >> scene.BLUR_MEAN_SHIFT != sum / window {
            say("the blur's mean of ")
            sayNumber(@intCast(usize, sum))
            say(" is not the sum divided\n")
            return false
        }
        sum += 1
    }
    sum = 0
    while sum <= window * 255 {
        const other = window * 255 - sum
        const both = ((sum | (other << 32)) * scene.BLUR_MEAN_FACTOR) >> scene.BLUR_MEAN_SHIFT
        if both & 255 != (sum / window) & 255 || (both >> 32) & 255 != (other / window) & 255 {
            say("two sums in one word do not stay apart at ")
            sayNumber(@intCast(usize, sum))
            say("\n")
            return false
        }
        sum += 1
    }
    return true
}

// The blur against the one before: random pictures (windows, opaque and
// translucent, over the background) under a transparent surface with a
// blur region of one to three rectangles (one of them taken out again at
// times), anywhere on an output of several tiles, also over its edges.
// Composed from scratch, composed with the blur kept, and composed again
// with the blur kept after the picture changed, each must be the picture
// without the blur with blurBefore over it.
fn checkBlur(seed: *u64) -> bool {
    const WIDTH: usize = 700
    const HEIGHT: usize = 300
    var compositor: Compositor = undefined
    setUp(&compositor, WIDTH, HEIGHT)
    compositor.pointerInside = false
    var below: [3]*Surface = undefined
    var index: usize = 0
    while index < 3 {
        below[index] = makeSurface(&compositor, state.ROLE_LAYER, 0, 0, 200, 120, 4278190080)
        compositor.stack = state.listAppend(compositor.stack, @intFromPtr(below[index]))
        index += 1
    }
    const pane = makeSurface(&compositor, state.ROLE_LAYER, 0, 0, 100, 100, 0)
    compositor.stack = state.listAppend(compositor.stack, @intFromPtr(pane))
    const bytes = WIDTH * HEIGHT * 4
    const got = state.allocate(&compositor, bytes)
    const want = state.allocate(&compositor, bytes)
    const kept = state.allocate(&compositor, bytes)
    var rects: [12]i32 = undefined
    var round: usize = 0
    while round < 14 {
        // The pane: small ones too (smaller than a box), and ones larger
        // than a tile either way.
        const wide = if round % 3 == 0 { randomInt(seed, 1, 40) } else { randomInt(seed, 30, 690) }
        const high = if round % 4 == 1 { randomInt(seed, 1, 30) } else { randomInt(seed, 20, 280) }
        resize(&compositor, pane, @intCast(usize, wide), @intCast(usize, high), 0)
        pane.*.x = randomInt(seed, -60, @intCast(i32, WIDTH) - 20)
        pane.*.y = randomInt(seed, -40, @intCast(i32, HEIGHT) - 10)
        if round % 5 == 0 {
            pane.*.x = 0
            pane.*.y = 0
        }
        const count = 1 + @intCast(usize, random(seed, 3))
        index = 0
        while index < count {
            rects[index * 4] = randomInt(seed, -10, wide / 2)
            rects[index * 4 + 1] = randomInt(seed, -10, high / 2)
            rects[index * 4 + 2] = randomInt(seed, 1, wide + 20)
            rects[index * 4 + 3] = randomInt(seed, 1, high + 20)
            index += 1
        }
        if round % 2 == 0 {
            // All of it.
            rects[0] = 0
            rects[1] = 0
            rects[2] = wide
            rects[3] = high
        }
        const rect_values: [*]const i32 = &rects
        setBlur(&compositor, pane, rect_values, count)
        if count > 1 && random(seed, 2) == 0 { pane.*.blurOps[count - 1].subtract = true }
        var turn: usize = 0
        while turn < 2 {
            // The picture below: placed anew, then (the second turn) one
            // of its windows moved and one painted again.
            index = 0
            while index < 3 {
                if turn == 0 || index == round % 3 {
                    below[index].*.x = randomInt(seed, -50, @intCast(i32, WIDTH) - 50)
                    below[index].*.y = randomInt(seed, -30, @intCast(i32, HEIGHT) - 30)
                }
                if turn == 0 || index == (round + 1) % 3 { paint(below[index], randomColor(seed)) }
                index += 1
            }
            scene.composeAnew(&compositor, got, scene.outputRect(&compositor))
            scene.compose(&compositor, kept, scene.outputRect(&compositor))
            pane.*.hasBlur = false
            scene.composeAnew(&compositor, want, scene.outputRect(&compositor))
            pane.*.hasBlur = true
            blurBefore(&compositor, want, pane)
            var at = differs(got, want, bytes)
            if at < bytes {
                say("round ")
                sayNumber(round)
                say(": the blur made from scratch is not the blur as it was made before at pixel ")
                sayNumber(at / 4 % WIDTH)
                say(",")
                sayNumber(at / 4 / WIDTH)
                say("\n")
                return false
            }
            at = differs(kept, want, bytes)
            if at < bytes {
                say("round ")
                sayNumber(round)
                say(if turn == 0 { ": the blur as it is kept" } else { ": the kept blur made again where the picture changed" })
                say(" is not the blur as it was made before at pixel ")
                sayNumber(at / 4 % WIDTH)
                say(",")
                sayNumber(at / 4 / WIDTH)
                say("\n")
                return false
            }
            turn += 1
        }
        round += 1
    }
    return true
}

// What frames are composed into: the two slots composed the nested way,
// the two filled the freestanding way from our own frame, that frame, and
// the frame from scratch.
const Screens = struct {
    width: usize
    bytes: usize
    slots: [2][*]u8
    copied: [2][*]u8
    frame: [*]u8
    reference: [*]u8
    // What the last frame's slot lacked.
    region: ui.Rect
}

fn makeScreens(compositor: *Compositor, screens: *Screens) -> void {
    screens.*.width = compositor.*.width
    screens.*.bytes = compositor.*.width * compositor.*.height * 4
    screens.*.reference = state.allocate(compositor, screens.*.bytes)
    screens.*.slots[0] = state.allocate(compositor, screens.*.bytes)
    screens.*.slots[1] = state.allocate(compositor, screens.*.bytes)
    screens.*.copied[0] = state.allocate(compositor, screens.*.bytes)
    screens.*.copied[1] = state.allocate(compositor, screens.*.bytes)
    screens.*.frame = state.allocate(compositor, screens.*.bytes)
    screens.*.region = ui.rect(0, 0, 0, 0)
    // Both slots start with garbage, as buffers do.
    var index: usize = 0
    while index < screens.*.bytes {
        screens.*.slots[0][index] = 170
        screens.*.slots[1][index] = 85
        screens.*.copied[0][index] = 1
        screens.*.copied[1][index] = 2
        screens.*.frame[index] = 3
        index += 1
    }
}

// A frame into `slot`: composed into the slot itself (nested), and our
// frame composed in what changed, the slot's region copied from it
// (freestanding), in either order (the backends do one or the other, and
// what one keeps of a blur the other finds). Each is held against the
// frame from scratch; returns what differs (at `at.*`), or "" when nothing
// does.
fn present(compositor: *Compositor, screens: *Screens, slot: usize, frame_first: bool, at: *usize) -> []const u8 {
    var changed: ui.Rect = undefined
    const region = scene.takeDamage(compositor, slot, &changed)
    screens.*.region = ui.rect(region.x, region.y, region.width, region.height)
    if frame_first { scene.compose(compositor, screens.*.frame, changed) }
    scene.compose(compositor, screens.*.slots[slot], region)
    if !frame_first { scene.compose(compositor, screens.*.frame, changed) }
    var row = region.y
    while row < ui.bottom(region) {
        const line = (@intCast(usize, row) * screens.*.width + @intCast(usize, region.x)) * 4
        state.copyPixels(@intFromPtr(screens.*.copied[slot]) + line, @intFromPtr(screens.*.frame) + line, @intCast(usize, region.width))
        row += 1
    }
    // The truth: everything from scratch, nothing kept.
    scene.composeAnew(compositor, screens.*.reference, scene.outputRect(compositor))
    at.* = differs(screens.*.slots[slot], screens.*.reference, screens.*.bytes)
    if at.* < screens.*.bytes { return "the slot composed in place" }
    at.* = differs(screens.*.frame, screens.*.reference, screens.*.bytes)
    if at.* < screens.*.bytes { return "the frame composed in what changed" }
    at.* = differs(screens.*.copied[slot], screens.*.reference, screens.*.bytes)
    if at.* < screens.*.bytes { return "the slot copied from the frame" }
    return ""
}

// ---------------------------------------------------------------------------
// What a kept blur must go through, one case after the other: frames that
// must blur nothing, frames that must blur again, and the ways a blur stops
// being kept.

const Told = struct {
    compositor: *Compositor
    screens: *Screens
    turn: usize
}

// A frame (slots and orders by turns); says `what` when it is wrong.
fn frameOf(told: *Told, what: []const u8) -> bool {
    var at: usize = 0
    told.*.turn += 1
    const wrong = present(told.*.compositor, told.*.screens, told.*.turn % 2, told.*.turn % 4 < 2, &at)
    if wrong.length == 0 { return true }
    say(what)
    say(": ")
    say(wrong)
    say(" differs from the full frame at pixel ")
    sayNumber(at / 4 % told.*.screens.*.width)
    say(",")
    sayNumber(at / 4 / told.*.screens.*.width)
    say("\n")
    return false
}

// Whether `surface`'s blur was kept through the frames since it had taken
// `tiles` (nothing blurred for it); says `what` when it was not.
fn keptAs(surface: *const Surface, tiles: usize, what: []const u8) -> bool {
    if tiles != NOTHING && keptTiles(surface) == tiles { return true }
    say(what)
    say(": the blur was made again, or is not kept\n")
    return false
}

// Whether it was blurred again, and is kept.
fn blurredAgain(surface: *const Surface, tiles: usize, what: []const u8) -> bool {
    if tiles != NOTHING && keptTiles(surface) != NOTHING && keptTiles(surface) > tiles { return true }
    say(what)
    say(": the blur was not made again, or is not kept\n")
    return false
}

fn movePointer(compositor: *Compositor, x: i32, y: i32) -> void {
    scene.damageCursor(compositor)
    compositor.*.pointerX = x
    compositor.*.pointerY = y
    scene.damageCursor(compositor)
}

fn moveWindow(compositor: *Compositor, surface: *Surface, x: i32, y: i32) -> void {
    scene.damageSurface(compositor, surface)
    surface.*.x = x
    surface.*.y = y
    scene.damageSurface(compositor, surface)
}

// The background painted in `area`, reported as that rectangle.
fn changeBackground(compositor: *Compositor, wallpaper: *Surface, area: ui.Rect, color: u32) -> void {
    paintRect(wallpaper, area, color)
    scene.damageRect(compositor, area)
}

fn told() -> bool {
    const WIDTH: usize = 320
    const HEIGHT: usize = 200
    var compositor: Compositor = undefined
    setUp(&compositor, WIDTH, HEIGHT)
    compositor.pointerX = 200
    compositor.pointerY = 130
    const wallpaper = makeSurface(&compositor, state.ROLE_LAYER, 0, 0, WIDTH, HEIGHT, 4280299584)
    wallpaper.*.layer = state.LAYER_BACKGROUND
    const under = makeSurface(&compositor, state.ROLE_TOPLEVEL, 150, 80, 100, 60, 4291611852)
    const glass = makeSurface(&compositor, state.ROLE_TOPLEVEL, 40, 70, 80, 60, 1613771904)
    const bar = makeSurface(&compositor, state.ROLE_LAYER, 0, 0, WIDTH, 22, 2420113408)
    bar.*.layer = state.LAYER_TOP
    const dock = makeSurface(&compositor, state.ROLE_LAYER, 90, 154, 140, 46, 0)
    dock.*.layer = state.LAYER_TOP
    paintRect(dock, ui.rect(6, 8, 128, 32), 2417012736)
    dock.*.opaque = false
    var rects: [12]i32 = undefined
    const rect_values: [*]const i32 = &rects
    rects[0] = 4
    rects[1] = 4
    rects[2] = 1000
    rects[3] = 1000
    setBlur(&compositor, glass, rect_values, 1)
    rects[0] = 0
    rects[1] = 0
    rects[2] = 320
    rects[3] = 22
    setBlur(&compositor, bar, rect_values, 1)
    rects[0] = 6
    rects[1] = 14
    rects[2] = 128
    rects[3] = 20
    rects[4] = 10
    rects[5] = 8
    rects[6] = 120
    rects[7] = 6
    rects[8] = 10
    rects[9] = 34
    rects[10] = 120
    rects[11] = 6
    setBlur(&compositor, dock, rect_values, 3)
    compositor.stack = state.listAppend(compositor.stack, @intFromPtr(wallpaper))
    compositor.stack = state.listAppend(compositor.stack, @intFromPtr(under))
    compositor.stack = state.listAppend(compositor.stack, @intFromPtr(glass))
    compositor.stack = state.listAppend(compositor.stack, @intFromPtr(bar))
    compositor.stack = state.listAppend(compositor.stack, @intFromPtr(dock))
    var screens: Screens = undefined
    makeScreens(&compositor, &screens)
    var all: Told = undefined
    all.compositor = &compositor
    all.screens = &screens
    all.turn = 0
    const it = &all
    scene.damageAll(&compositor)
    if !frameOf(it, "the first frame") || !frameOf(it, "the first frame into the other slot") { return false }

    // The pointer into the bar, along it and out of it below; the bar
    // committing; the pointer over the dock and the dock committing: what
    // lies behind the bars stays, nothing is blurred.
    var bar_tiles = keptTiles(bar)
    var dock_tiles = keptTiles(dock)
    var glass_tiles = keptTiles(glass)
    movePointer(&compositor, 120, 10)
    if !frameOf(it, "the pointer into the bar") || !keptAs(bar, bar_tiles, "the pointer into the bar") { return false }
    movePointer(&compositor, 170, 12)
    if !frameOf(it, "the pointer along the bar") || !keptAs(bar, bar_tiles, "the pointer along the bar") { return false }
    movePointer(&compositor, 170, 36)
    if !frameOf(it, "the pointer out of the bar") || !keptAs(bar, bar_tiles, "the pointer out of the bar") { return false }
    // (Drawn again: where the pointer was in the last two frames and is
    // now, nothing of the bar around that.)
    if screens.region.width > 80 {
        say("the pointer out of the bar: drawn again ")
        sayNumber(@intCast(usize, screens.region.width))
        say(" pixels wide\n")
        return false
    }
    scene.damageContent(&compositor, bar)
    paint(bar, 2686517248)
    scene.damageContent(&compositor, bar)
    if !frameOf(it, "the bar committing") || !keptAs(bar, bar_tiles, "the bar committing") { return false }
    movePointer(&compositor, 160, 180)
    if !frameOf(it, "the pointer over the dock") || !keptAs(dock, dock_tiles, "the pointer over the dock") { return false }
    scene.damageContent(&compositor, dock)
    paintRect(dock, ui.rect(6, 8, 128, 32), 2150645760)
    scene.damageContent(&compositor, dock)
    if !frameOf(it, "the dock committing") || !keptAs(dock, dock_tiles, "the dock committing") { return false }
    movePointer(&compositor, 70, 100)
    if !frameOf(it, "the pointer over the glass window") || !keptAs(glass, glass_tiles, "the pointer over the glass window") { return false }
    scene.damageContent(&compositor, glass)
    paint(glass, 1345335296)
    scene.damageContent(&compositor, glass)
    if !frameOf(it, "the glass window committing") || !keptAs(glass, glass_tiles, "the glass window committing") { return false }
    // Everything drawn again with nothing changed (a frame of the opening
    // fade): nothing blurred either.
    scene.damageAll(&compositor)
    if !frameOf(it, "the whole screen again") || !keptAs(bar, bar_tiles, "the whole screen again") || !keptAs(dock, dock_tiles, "the whole screen again (the dock)") { return false }

    // A window moving to right under the bar, along it, and half behind
    // it: the bar's blur follows, the dock's stays.
    moveWindow(&compositor, under, 150, 26)
    if !frameOf(it, "a window moved under the bar") || !blurredAgain(bar, bar_tiles, "a window moved under the bar") || !keptAs(dock, dock_tiles, "a window moved under the bar (the dock)") { return false }
    bar_tiles = keptTiles(bar)
    moveWindow(&compositor, under, 162, 26)
    if !frameOf(it, "a window moving along the bar") || !blurredAgain(bar, bar_tiles, "a window moving along the bar") { return false }
    // (Drawn again: the window's two places and the bar within reach of
    // them, not the bar from end to end.)
    if screens.region.width > 200 {
        say("a window moving along the bar: drawn again ")
        sayNumber(@intCast(usize, screens.region.width))
        say(" pixels wide\n")
        return false
    }
    bar_tiles = keptTiles(bar)
    moveWindow(&compositor, under, 162, 8)
    if !frameOf(it, "a window moved behind the bar") || !blurredAgain(bar, bar_tiles, "a window moved behind the bar") { return false }
    bar_tiles = keptTiles(bar)
    // That window committing where the bar's blur reads it, and where it
    // does not (far below the bar, with the frame around it drawn again).
    scene.damageContent(&compositor, under)
    paint(under, 4278238420)
    scene.damageContent(&compositor, under)
    if !frameOf(it, "a window behind the bar committing") || !blurredAgain(bar, bar_tiles, "a window behind the bar committing") { return false }
    moveWindow(&compositor, under, 150, 80)
    if !frameOf(it, "the window moved away") { return false }
    bar_tiles = keptTiles(bar)
    scene.damageContent(&compositor, under)
    paint(under, 4294923520)
    scene.damageContent(&compositor, under)
    if !frameOf(it, "a window far from the bar committing") || !keptAs(bar, bar_tiles, "a window far from the bar committing") { return false }

    // The background changing behind the bar, and far from everything
    // blurred.
    changeBackground(&compositor, wallpaper, ui.rect(20, 5, 60, 30), 4293980400)
    if !frameOf(it, "the background changed behind the bar") || !blurredAgain(bar, bar_tiles, "the background changed behind the bar") { return false }
    bar_tiles = keptTiles(bar)
    dock_tiles = keptTiles(dock)
    changeBackground(&compositor, wallpaper, ui.rect(270, 90, 30, 20), 4278255360)
    if !frameOf(it, "the background changed elsewhere") || !keptAs(bar, bar_tiles, "the background changed elsewhere") || !keptAs(dock, dock_tiles, "the background changed elsewhere (the dock)") { return false }
    // Just within reach of the bar's blur, and just out of it.
    changeBackground(&compositor, wallpaper, ui.rect(200, 22 + scene.BLUR_REACH - 1, 9, 1), 4294967295)
    if !frameOf(it, "the background changed at the end of the bar's reach") || !blurredAgain(bar, bar_tiles, "the background changed at the end of the bar's reach") { return false }
    bar_tiles = keptTiles(bar)
    changeBackground(&compositor, wallpaper, ui.rect(200, 22 + scene.BLUR_REACH, 9, 1), 4294901760)
    if !frameOf(it, "the background changed past the bar's reach") || !keptAs(bar, bar_tiles, "the background changed past the bar's reach") { return false }

    // The glass window raised over a window that lay over its edge: what
    // was above it is under it now, also where no pixel changed.
    moveWindow(&compositor, under, 110, 90)
    scene.raise(&compositor, @intFromPtr(under))
    if !frameOf(it, "a window raised over the glass window") { return false }
    scene.raise(&compositor, @intFromPtr(glass))
    if !frameOf(it, "the glass window raised") { return false }
    moveWindow(&compositor, under, 150, 80)
    if !frameOf(it, "the window moved from under the glass window") { return false }

    // The bar resized (its commit, its blur region set to match), then its
    // blur taken away and given back, then the bar itself.
    scene.damageContent(&compositor, bar)
    resize(&compositor, bar, WIDTH, 30, 2686517248)
    scene.damageSurface(&compositor, bar)
    rects[0] = 0
    rects[1] = 0
    rects[2] = 320
    rects[3] = 30
    setBlur(&compositor, bar, rect_values, 1)
    scene.damageSurface(&compositor, bar)
    scene.damageContent(&compositor, bar)
    if !frameOf(it, "the bar resized") { return false }
    movePointer(&compositor, 60, 20)
    bar_tiles = keptTiles(bar)
    movePointer(&compositor, 64, 21)
    if !frameOf(it, "the pointer in the resized bar") || !keptAs(bar, bar_tiles, "the pointer in the resized bar") { return false }
    scene.damageSurface(&compositor, bar)
    setBlur(&compositor, bar, rect_values, 0)
    scene.damageSurface(&compositor, bar)
    if !frameOf(it, "the bar's blur taken away") { return false }
    scene.damageSurface(&compositor, bar)
    setBlur(&compositor, bar, rect_values, 1)
    scene.damageSurface(&compositor, bar)
    if !frameOf(it, "the bar's blur given back") { return false }
    scene.damageSurface(&compositor, bar)
    compositor.stack = state.listRemove(compositor.stack, @intFromPtr(bar))
    if !frameOf(it, "the bar taken away") { return false }
    changeBackground(&compositor, wallpaper, ui.rect(100, 0, 80, 44), 4288230399)
    if !frameOf(it, "the background changed where the bar was") { return false }
    compositor.stack = state.listAppend(compositor.stack, @intFromPtr(bar))
    scene.restack(&compositor)
    scene.damageSurface(&compositor, bar)
    if !frameOf(it, "the bar brought back") { return false }

    // What the bar keeps given back with nothing said, the pointer moving
    // in the bar: the blur is made out of the frame, which must hold all
    // it reads (our frame first: no slot's larger region helps).
    if !frameOf(it, "a frame") { return false }
    while all.turn % 4 != 3 { if !frameOf(it, "a frame") { return false } }
    scene.forgetBlur(&compositor, bar)
    movePointer(&compositor, 90, 14)
    if !frameOf(it, "the pointer in a bar that keeps nothing") { return false }
    // The same for the dock, with two changes beside it in two frames,
    // left and right of it: neither reaches its blur, the two together,
    // which a slot lacks, do.
    while all.turn % 4 != 1 { if !frameOf(it, "a frame") { return false } }
    scene.forgetBlur(&compositor, dock)
    changeBackground(&compositor, wallpaper, ui.rect(2, 170, 8, 8), 4294967040)
    if !frameOf(it, "a change left of a dock that keeps nothing") { return false }
    changeBackground(&compositor, wallpaper, ui.rect(300, 170, 8, 8), 4278255615)
    if !frameOf(it, "a change right of a dock that keeps nothing") { return false }

    // The glass window drawn no more, reported as the rectangle it covers;
    // the background changing beside it, where only its blur reads; drawn
    // again, reported the same way: what it kept while it was not drawn is
    // not what lies below it now.
    if !frameOf(it, "a frame") || !frameOf(it, "a frame") { return false }
    if keptTiles(glass) == NOTHING {
        say("the glass window keeps no blur before it goes\n")
        return false
    }
    scene.damageRect(&compositor, scene.surfaceBounds(glass))
    glass.*.dismissed = true
    scene.damageRect(&compositor, scene.surfaceBounds(glass))
    if !frameOf(it, "the glass window drawn no more") { return false }
    changeBackground(&compositor, wallpaper, ui.rect(glass.*.x - 12, glass.*.y + 10, 8, 30), 4294967295)
    if !frameOf(it, "the background changed beside where the glass window was") { return false }
    scene.damageRect(&compositor, scene.surfaceBounds(glass))
    glass.*.dismissed = false
    scene.damageRect(&compositor, scene.surfaceBounds(glass))
    if !frameOf(it, "the glass window drawn again") { return false }
    return true
}

// The play: `steps` random changes on an output of width x height, each
// reported the way the compositor reports it, each frame composed the
// three ways and held against the frame from scratch. `desktop`: with a
// background, a blurred bar and a blurred dock.
fn play(width: usize, height: usize, steps: usize, desktop: bool, start: u64) -> bool {
    var generator: u64 = start
    const seed = &generator
    const wide = @intCast(i32, width)
    const high = @intCast(i32, height)
    var compositor: Compositor = undefined
    setUp(&compositor, width, height)

    // The background: a layer surface under everything, all of the output.
    var wallpaper: *Surface = undefined
    if desktop {
        wallpaper = makeSurface(&compositor, state.ROLE_LAYER, 0, 0, width, height, 4278190080 | @intCast(u32, random(seed, 16777216)))
        wallpaper.*.layer = state.LAYER_BACKGROUND
        compositor.stack = state.listAppend(compositor.stack, @intFromPtr(wallpaper))
    }
    var windows: [4]*Surface = undefined
    var index: usize = 0
    while index < WINDOWS {
        windows[index] = makeSurface(&compositor, state.ROLE_TOPLEVEL, randomInt(seed, -20, wide - 70), randomInt(seed, -10, high - 40), @intCast(usize, randomInt(seed, 20, wide * 7 / 16)), @intCast(usize, randomInt(seed, 20, high / 2)), randomColor(seed))
        compositor.stack = state.listAppend(compositor.stack, @intFromPtr(windows[index]))
        index += 1
    }
    // A popup of the first window, and a client cursor surface.
    const popup = makeSurface(&compositor, state.ROLE_POPUP, windows[0].*.x + 10, windows[0].*.y + 10, 40, 30, randomColor(seed))
    popup.*.parent = @intFromPtr(windows[0])
    compositor.stack = state.listAppend(compositor.stack, @intFromPtr(popup))
    const cursor = makeSurface(&compositor, state.ROLE_CURSOR, 0, 0, 12, 20, 2147516416)
    cursor.*.mapped = false
    // Subsurfaces: one above the second window, one below the third (it
    // shows where it sticks out), and one nested in the first.
    var subsurfaces: [3]*Surface = undefined
    subsurfaces[0] = makeSubsurface(&compositor, windows[1], 10, 8, true, randomColor(seed))
    subsurfaces[1] = makeSubsurface(&compositor, windows[2], -12, 30, false, randomColor(seed))
    subsurfaces[2] = makeSubsurface(&compositor, subsurfaces[0], 15, 12, true, randomColor(seed))
    // The last window is translucent and blurs what is behind the middle of it.
    const glass = windows[WINDOWS - 1]
    paint(glass, 1610612768)
    glass.*.blurOps[0].subtract = false
    glass.*.blurOps[0].x = 4
    glass.*.blurOps[0].y = 4
    glass.*.blurOps[0].width = 1000
    glass.*.blurOps[0].height = 1000
    glass.*.blurOps[1].subtract = true
    glass.*.blurOps[1].x = 10
    glass.*.blurOps[1].y = 10
    glass.*.blurOps[1].width = 6
    glass.*.blurOps[1].height = 6
    glass.*.blurCount = 2
    glass.*.hasBlur = true
    compositor.blurred = state.listAppend(compositor.blurred, @intFromPtr(glass))
    compositor.keyboardFocus = @intFromPtr(windows[WINDOWS - 1])
    // The bar along the top, blurred behind all of it, and the dock in the
    // middle of the bottom edge, blurred behind its rounded bar: layer
    // surfaces above the windows.
    var bar: *Surface = undefined
    var dock: *Surface = undefined
    var rects: [12]i32 = undefined
    const rect_values: [*]const i32 = &rects
    var bar_shown = true
    if desktop {
        bar = makeSurface(&compositor, state.ROLE_LAYER, 0, 0, width, 22, glassColor(seed))
        bar.*.layer = state.LAYER_TOP
        rects[0] = 0
        rects[1] = 0
        rects[2] = wide
        rects[3] = 22
        setBlur(&compositor, bar, rect_values, 1)
        compositor.stack = state.listAppend(compositor.stack, @intFromPtr(bar))
        dock = makeSurface(&compositor, state.ROLE_LAYER, wide / 2 - 70, high - 46, 140, 46, 0)
        dock.*.layer = state.LAYER_TOP
        paintRect(dock, ui.rect(6, 8, 128, 32), glassColor(seed))
        dock.*.opaque = false
        rects[0] = 6
        rects[1] = 14
        rects[2] = 128
        rects[3] = 20
        rects[4] = 10
        rects[5] = 8
        rects[6] = 120
        rects[7] = 6
        rects[8] = 10
        rects[9] = 34
        rects[10] = 120
        rects[11] = 6
        setBlur(&compositor, dock, rect_values, 3)
        compositor.stack = state.listAppend(compositor.stack, @intFromPtr(dock))
    }
    scene.damageAll(&compositor)

    var screens: Screens = undefined
    makeScreens(&compositor, &screens)

    // The blurred surfaces, for the count of what their blurs took.
    var blurred: [3]*Surface = undefined
    blurred[0] = glass
    var blurred_count: usize = 1
    if desktop {
        blurred[1] = bar
        blurred[2] = dock
        blurred_count = 3
    }
    var tiles: [3]usize = undefined
    // Frames after which a blur was still kept though the frame drew
    // within it (the pointer over it, its surface committing).
    var kept_through: usize = 0
    // Changes that blurred again what they had to.
    var blurred_again: usize = 0

    var step: usize = 0
    var last_slot: usize = 1
    while step < steps {
        index = 0
        while index < blurred_count {
            tiles[index] = keptTiles(blurred[index])
            index += 1
        }
        // A change, reported the way shell.mlx reports it.
        const change = random(seed, if desktop { 19 } else { 10 })
        const chosen = @intCast(usize, random(seed, @intCast(u64, WINDOWS)))
        const window = windows[chosen]
        // Whether the change leaves what lies below every blurred surface
        // as it is (nothing may be blurred for it then).
        var above_all = false
        if change == 0 {
            // Moved (an interactive move): before and after. On the
            // desktop often to right under the bar.
            scene.damageSurface(&compositor, window)
            if desktop && random(seed, 3) == 0 {
                window.*.x += randomInt(seed, -12, 12)
                window.*.y = randomInt(seed, 4, 44)
            } else {
                window.*.x += randomInt(seed, -30, 30)
                window.*.y += randomInt(seed, -30, 30)
            }
            scene.damageSurface(&compositor, window)
        } else if change == 1 {
            // New content committed (windows.mlx applyCommit): all of it,
            // or a part with its damage.
            if random(seed, 3) == 0 {
                commitPart(&compositor, seed, window, if window == glass { glassColor(seed) } else { randomColor(seed) })
            } else {
                scene.damageContent(&compositor, window)
                paint(window, if window == glass { glassColor(seed) } else { randomColor(seed) })
                scene.damageContent(&compositor, window)
            }
        } else if change == 2 {
            // Resized by a commit: before and after.
            scene.damageContent(&compositor, window)
            resize(&compositor, window, @intCast(usize, randomInt(seed, 20, wide * 7 / 16)), @intCast(usize, randomInt(seed, 20, high / 2)), randomColor(seed))
            scene.damageContent(&compositor, window)
        } else if change == 3 {
            // Focus.
            const old = compositor.keyboardFocus
            if old != 0 { scene.damageSurface(&compositor, state.surfaceAt(old)) }
            compositor.keyboardFocus = @intFromPtr(window)
            scene.damageSurface(&compositor, window)
        } else if change == 4 {
            // Raised (with its popup).
            scene.raise(&compositor, @intFromPtr(window))
        } else if change == 5 {
            // The pointer moved; over a border the cursor changes shape. On
            // the desktop often across the bar or the dock.
            scene.damageCursor(&compositor)
            compositor.pointerX = randomInt(seed, -5, wide + 5)
            compositor.pointerY = randomInt(seed, -5, high + 5)
            if desktop && random(seed, 2) == 0 { compositor.pointerY = if random(seed, 3) == 0 { randomInt(seed, high - 50, high) } else { randomInt(seed, 0, 45) } }
            compositor.hoverEdges = @intCast(u32, random(seed, 16))
            scene.damageCursor(&compositor)
            above_all = true
        } else if change == 6 {
            // A client cursor set, or unset, or hidden.
            scene.damageCursor(&compositor)
            const choice = random(seed, 3)
            compositor.cursorSurface = if choice == 0 { @intFromPtr(cursor) } else { 0 }
            compositor.cursorHidden = choice == 2
            compositor.cursorHotspotX = randomInt(seed, 0, 11)
            compositor.cursorHotspotY = randomInt(seed, 0, 19)
            scene.damageCursor(&compositor)
            above_all = true
        } else if change == 7 {
            // The popup placed again, or the window geometry set.
            scene.damageSurface(&compositor, popup)
            popup.*.x = windows[0].*.x + randomInt(seed, -10, 60)
            popup.*.y = windows[0].*.y + randomInt(seed, -10, 60)
            scene.damageSurface(&compositor, popup)
            scene.damageSurface(&compositor, window)
            window.*.hasGeometry = random(seed, 2) == 0
            window.*.geometryX = randomInt(seed, 0, 8)
            window.*.geometryY = randomInt(seed, 0, 8)
            window.*.geometryWidth = @intCast(i32, window.*.pixelWidth) - window.*.geometryX - randomInt(seed, 0, 8)
            window.*.geometryHeight = @intCast(i32, window.*.pixelHeight) - window.*.geometryY - randomInt(seed, 0, 8)
            if window.*.geometryWidth < 1 || window.*.geometryHeight < 1 { window.*.hasGeometry = false }
            scene.damageSurface(&compositor, window)
        } else if change == 8 {
            // A subsurface moved (its parent's commit applied the position),
            // redrawn, or placed on the other side of its parent.
            const child = subsurfaces[@intCast(usize, random(seed, 3))]
            const parent = state.surfaceAt(child.*.parent)
            const what = random(seed, 3)
            if what == 1 && random(seed, 2) == 0 {
                commitPart(&compositor, seed, child, randomColor(seed))
            } else if what == 1 {
                scene.damageContent(&compositor, child)
                paint(child, randomColor(seed))
                scene.damageContent(&compositor, child)
            } else {
                scene.damageSurface(&compositor, child)
                if what == 0 {
                    child.*.subX = randomInt(seed, -20, 60)
                    child.*.subY = randomInt(seed, -20, 60)
                } else {
                    const at = state.listIndexOf(parent.*.children, @intFromPtr(child))
                    parent.*.children = state.listRemove(parent.*.children, @intFromPtr(child))
                    if at < parent.*.belowCount {
                        parent.*.belowCount -= 1
                        parent.*.children = state.listAppend(parent.*.children, @intFromPtr(child))
                    } else {
                        parent.*.children = state.listInsert(parent.*.children, 0, @intFromPtr(child))
                        parent.*.belowCount += 1
                    }
                }
                scene.damageSurface(&compositor, child)
            }
        } else if change == 9 {
            // Nothing changed this time (a frame callback only); or the
            // glass window minimized (windows.mlx setMinimized), or shown
            // again and raised (focus).
            if random(seed, 3) == 0 {
                if glass.*.minimized {
                    glass.*.minimized = false
                    scene.raise(&compositor, @intFromPtr(glass))
                } else {
                    scene.damageSurface(&compositor, glass)
                    glass.*.minimized = true
                }
            }
        } else if change == 10 {
            // The bar commits (its clock; all of it, or a part with its
            // damage): what is behind it stays.
            if bar_shown && random(seed, 2) == 0 {
                commitPart(&compositor, seed, bar, glassColor(seed))
            } else {
                if bar_shown { scene.damageContent(&compositor, bar) }
                paint(bar, glassColor(seed))
                if bar_shown { scene.damageContent(&compositor, bar) }
            }
            above_all = true
        } else if change == 11 {
            // The background changes: in a rectangle, reported as that, or
            // all of it by its commit.
            const left = randomInt(seed, 0, wide - 2)
            const top = if random(seed, 2) == 0 { randomInt(seed, 0, 50) } else { randomInt(seed, 0, high - 2) }
            const area = ui.intersect(ui.rect(left, top, randomInt(seed, 1, wide), randomInt(seed, 1, high / 2)), scene.outputRect(&compositor))
            const color = 4278190080 | @intCast(u32, random(seed, 16777216))
            if random(seed, 4) == 0 {
                scene.damageContent(&compositor, wallpaper)
                paint(wallpaper, color)
                scene.damageContent(&compositor, wallpaper)
            } else {
                paintRect(wallpaper, area, color)
                scene.damageRect(&compositor, area)
            }
        } else if change == 12 {
            // The bar resized by its commit, its blur region set to match
            // (applyCommit, then protocols.mlx applyBlur).
            const tall = randomInt(seed, 6, 34)
            if bar_shown { scene.damageContent(&compositor, bar) }
            resize(&compositor, bar, width, @intCast(usize, tall), glassColor(seed))
            if bar.*.hasBlur {
                if bar_shown { scene.damageSurface(&compositor, bar) }
                rects[0] = 0
                rects[1] = 0
                rects[2] = wide
                rects[3] = tall
                setBlur(&compositor, bar, rect_values, 1)
                if bar_shown { scene.damageSurface(&compositor, bar) }
            }
            if bar_shown { scene.damageContent(&compositor, bar) }
        } else if change == 13 {
            // The bar's blur taken away or given back (applyBlur), or the
            // bar itself: unmapped (windows.mlx unmap) and mapped again
            // (protocols.mlx mapLayer), at times as a surface that is new.
            if random(seed, 2) == 0 {
                if bar_shown { scene.damageSurface(&compositor, bar) }
                rects[0] = 0
                rects[1] = 0
                rects[2] = wide
                rects[3] = @intCast(i32, bar.*.pixelHeight)
                setBlur(&compositor, bar, rect_values, if bar.*.hasBlur { 0 } else { 1 })
                if bar_shown { scene.damageSurface(&compositor, bar) }
            } else if bar_shown {
                scene.damageSurface(&compositor, bar)
                compositor.stack = state.listRemove(compositor.stack, @intFromPtr(bar))
                bar_shown = false
                if random(seed, 2) == 0 { scene.forgetBlur(&compositor, bar) }
            } else {
                compositor.stack = state.listAppend(compositor.stack, @intFromPtr(bar))
                scene.restack(&compositor)
                bar_shown = true
                scene.damageSurface(&compositor, bar)
            }
        } else if change == 14 {
            // The dock commits, or slides (launching.mlx dockStep).
            if random(seed, 2) == 0 {
                scene.damageContent(&compositor, dock)
                paintRect(dock, ui.rect(6, 8, 128, 32), glassColor(seed))
                scene.damageContent(&compositor, dock)
                above_all = true
            } else {
                scene.damageSurface(&compositor, dock)
                dock.*.y = high - 46 + randomInt(seed, 0, 40)
                scene.damageSurface(&compositor, dock)
            }
        } else if change == 15 {
            // The glass window sent to another workspace, or back
            // (workspaces.mlx moveWindow: everything is drawn again).
            glass.*.workspace = if glass.*.workspace == 0 { 1 } else { 0 }
            scene.damageAll(&compositor)
        } else if change == 16 {
            // The dock waits before it hides (dockStep keeps the frames
            // coming), the pointer moving over it meanwhile.
            scene.damageContent(&compositor, dock)
            scene.damageCursor(&compositor)
            compositor.pointerX = dock.*.x + randomInt(seed, 0, 140)
            compositor.pointerY = dock.*.y + randomInt(seed, 0, 46)
            scene.damageCursor(&compositor)
            above_all = true
        } else if change == 17 {
            // What a blurred surface keeps of its blur is given back, with
            // nothing reported (nothing on the screen changed): the frames
            // after make its blur out of what they draw, and the pointer
            // moves near it.
            const which = blurred[@intCast(usize, random(seed, 3))]
            scene.forgetBlur(&compositor, which)
            if random(seed, 2) == 0 {
                scene.damageCursor(&compositor)
                compositor.pointerX = which.*.x + randomInt(seed, -30, 60)
                compositor.pointerY = which.*.y + randomInt(seed, -30, 60)
                scene.damageCursor(&compositor)
            }
        } else {
            // The glass window drawn no more, or drawn again, reported as
            // the rectangle it covers and nothing more.
            scene.damageRect(&compositor, scene.surfaceBounds(glass))
            glass.*.dismissed = !glass.*.dismissed
            scene.damageRect(&compositor, scene.surfaceBounds(glass))
        }
        if !compositor.needsRedraw {
            step += 1
            continue
        }

        // A frame into one slot: the same one again at times (the host
        // released it quickly), else the other.
        const slot = if random(seed, 4) == 0 { last_slot } else { 1 - last_slot }
        last_slot = slot
        var at: usize = 0
        const wrong = present(&compositor, &screens, slot, random(seed, 2) == 0, &at)
        if wrong.length != 0 { return fail(width, step, change, wrong, at) }
        const region = screens.region
        // What the blurs took: nothing where nothing below them changed.
        index = 0
        while index < blurred_count {
            const now = keptTiles(blurred[index])
            if above_all && tiles[index] != NOTHING {
                const blur = state.keptBlurAt(blurred[index].*.blurKept)
                if blur.*.tiles != tiles[index] {
                    say("output ")
                    sayNumber(width)
                    say(" wide, step ")
                    sayNumber(step)
                    say(" (change ")
                    sayNumber(@intCast(usize, change))
                    say("): a blur was made again though nothing below its surface changed\n")
                    return false
                }
                if now != NOTHING && !ui.isEmpty(ui.intersect(region, blur.*.area)) { kept_through += 1 }
            }
            if !above_all && tiles[index] != NOTHING && now != NOTHING && now != tiles[index] { blurred_again += 1 }
            index += 1
        }
        step += 1
    }
    // The play must have had both: blurs kept through frames that drew
    // over them, and blurs made again in part.
    if kept_through < steps / 40 || blurred_again < steps / 40 {
        say("output ")
        sayNumber(width)
        say(" wide: blurs were kept through ")
        sayNumber(kept_through)
        say(" frames and made again in part ")
        sayNumber(blurred_again)
        say(" times in ")
        sayNumber(steps)
        say(" steps: too few to tell\n")
        return false
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if !checkMean() { return 1 }
    var generator: u64 = 88172645463325252
    if !checkBlur(&generator) { return 1 }
    if !told() { return 1 }
    // Windows only, as the play was before the blur was kept; the desktop;
    // the desktop on an output of several tiles.
    if !play(320, 200, 600, false, 2463534242) { return 1 }
    if !play(320, 200, 700, true, 1442695040888963407) { return 1 }
    if !play(720, 300, 160, true, 6364136223846793005) { return 1 }
    return 13
}
