// std.bootstrap mem.copy and mem.set give the bytes a byte loop gives: at
// the lengths where their loops hand over to one another (words, blocks
// of half a KiB, of a page), sixteen alignments, guards on both sides,
// and copies that overlap by a gap near the length and near the block
// sizes, both ways.
// Exits 13.
const std = @import("std")
const mem = @import("../std/bootstrap/mem.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn at(base: [*]u8, offset: usize) -> [*]u8 { return unsafe { @ptrFromInt([*]u8, @intFromPtr(base) + offset) } }

const ROOM: usize = 40000

fn same(a: [*]const u8, b: [*]const u8, n: usize) -> bool {
    return mem_eql(a, b, n)
}

fn mem_eql(a: [*]const u8, b: [*]const u8, n: usize) -> bool {
    var k: usize = 0
    while k < n {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

fn paint(b: [*]u8, c: [*]u8) -> void {
    var k: usize = 0
    while k < ROOM {
        b[k] = 0xEE
        c[k] = 0xEE
        k += 1
    }
}

fn both(b: [*]u8, c: [*]u8, a: [*]const u8) -> void {
    var k: usize = 0
    while k < ROOM {
        b[k] = a[k]
        c[k] = a[k]
        k += 1
    }
}

// The next length to try: every one to 96, then those around where one
// loop hands over to the next (half a KiB, a KiB, a page, a page and a
// half, two pages), to the end at 9300.
fn next(length: usize) -> usize {
    if length < 96 { return length + 1 }
    const marks = [_]usize{ 500, 1010, 2040, 4080, 4590, 5100, 8180, 9270 }
    var k: usize = 0
    while k < 8 {
        if length < marks[k] { return marks[k] }
        if length < marks[k] + 44 { return length + 1 }
        k += 1
    }
    return 9301
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const a = allocator.alloc(ROOM, 4096).?
    const b = allocator.alloc(ROOM, 4096).?
    const c = allocator.alloc(ROOM, 4096).?
    var seed: usize = 11
    var k: usize = 0
    while k < ROOM {
        seed = (seed *% 6364136223846793005) +% 1442695040888963407
        a[k] = @intCast(u8, (seed >> 33) & 255)
        k += 1
    }
    var cases: usize = 0
    var bad: usize = 0
    var length: usize = 0
    while length <= 9300 {
        var offset: usize = 0
        while offset < 16 {
            const value: u8 = @intCast(u8, (length * 13 + offset) % 256)
            paint(b, c)
            mem.set(at(b, 64 + offset), value, length)
            k = 0
            while k < length {
                c[64 + offset + k] = value
                k += 1
            }
            if !same(b, c, ROOM) {
                bad += 1
                if bad < 5 {
                    say("set differs at length ")
                    number(length)
                    say("\n")
                }
            }
            const so = (offset * 5 + 3) % 16
            paint(b, c)
            mem.copy(at(b, 64 + offset), at(a, so), length)
            k = 0
            while k < length {
                c[64 + offset + k] = a[so + k]
                k += 1
            }
            if !same(b, c, ROOM) {
                bad += 1
                if bad < 5 {
                    say("copy differs at length ")
                    number(length)
                    say("\n")
                }
            }
            cases += 2
            offset += 1
        }
        // Overlapping and touching: gaps relative to the length and to
        // the block sizes, both ways.
        var g: usize = 0
        while g < 12 {
            var gap: usize = 0
            if g == 0 { gap = length }
            if g == 1 { gap = length + 1 }
            if g == 2 && length > 0 { gap = length - 1 }
            if g == 3 { gap = 511 }
            if g == 4 { gap = 512 }
            if g == 5 { gap = 4095 }
            if g == 6 { gap = 4096 }
            if g == 7 { gap = 3 }
            if g == 8 { gap = 8 }
            if g == 9 && length > 8 { gap = length - 8 }
            if g == 10 && length > 512 { gap = length - 512 }
            if g == 11 { gap = 0 }
            var ways: usize = 0
            while ways < 2 {
                both(b, c, a)
                const from: usize = 15000 + (length % 7)
                const to = if ways == 0 { from + gap } else { from - gap }
                mem.copy(at(b, to), at(b, from), length)
                k = 0
                while k < length {
                    c[to + k] = c[from + k]
                    k += 1
                }
                if !same(b, c, ROOM) {
                    bad += 1
                    if bad < 5 {
                        say("an overlapping copy differs at length ")
                        number(length)
                        say(" gap ")
                        number(gap)
                        say("\n")
                    }
                }
                cases += 1
                ways += 1
            }
            g += 1
        }
        length = next(length)
    }
    number(cases)
    say(" cases; differing from the byte loop: ")
    number(bad)
    say("\n")
    return if bad == 0 { 13 } else { 1 }
}
