// The kernel's stage 5 toward a Radeon that takes commands, its first two
// steps (projects/brix/kernel/gpu_compute.mlx's G1 and G2, built for the
// host), against the user's RX 580 as a table (tests/support/mec_card.mlx
// on the cards of tests 493 to 501: 4 shader engines of 9 compute units
// and 2 render back ends each, as the ROM says), after stages 0 to 4
// passed at a boot that goes to stage 5, with the study's steps
// (gpu-accel-kernel.verified.md 5.1 to 5.4, 8.4 G1 and G2) written out here
// a second time, write for write:
// - G1: the golden words of 5.2 where Linux's rule gives another value than
//   the card holds, each said with what it was (the two tables written out
//   here from the study, row for row; tools/check_gpu_registers.py holds
//   the code's against Linux's), the SMC's clock divider by its index pair;
//   5.3 in Linux's order but DMIF_ADDR_CALC and HDP_ADDR_CONFIG: the read
//   timeout, the address configuration, 32 tile and 15 macrotile words (the
//   8th not written), the render back ends of each shader engine and the
//   raster configuration, the compute units of each, the static memory
//   word, address spaces 0 to 7 (0x378, 0x338, the shared aperture's base)
//   and 8 to 15 (init_compute_vmid's words), the global data store's words
//   of 8 to 15 and then of 1 to 15, the FIFO sizes and the arbiter's order
//   with every engine selected; every register read back, under its queue
//   selector; its line (36 units 9 9 9 9, 8 of 8 back ends); a card with
//   fewer back ends (no raster configuration written, said); every failure
//   (a register that does not hold, one of an address space, the clock
//   divider word, no compute unit, no back end, the picture, the card gone)
//   with every register and the divider word as before; the refusals (no
//   GFX_Info, the mark);
// - G2: RLC_SPM_VMID, the RLC stopped (its enable, the idle interrupts, the
//   serial buses of each shader engine waited for, then the others),
//   reset by its bit's pulse, started; its line; every failure (the RLC
//   that does not run, the SPM word, a bus that stays busy, the reset bit
//   that stays) with the RLC stopped and its words as before; G2 refused
//   without G1;
// - F2 at a boot of stage 5: the RLC and the compute processor halted again
//   (stage 5 starts them from there), and the stages' order: D1 failing
//   with copy engine 0 not reading its ring and no fault at a boot of
//   stage 5 tries Linux's order (G1, G2, D1 once more) and says which
//   worked; at stage 4 it does not; a D1 that faults is not tried again;
// - through all of it no register of the display's is written.
// With an argument the log of every case is printed.
// Exits 13.
const std = @import("std")
const engines = @import("../projects/brix/kernel/gpu_engines.mlx")
const loaded = @import("../projects/brix/kernel/gpu_smc_sdma.mlx")
const compute = @import("../projects/brix/kernel/gpu_compute.mlx")
const card = @import("./support/engine_card.mlx")
const smc = @import("./support/smc_card.mlx")
const mec = @import("./support/mec_card.mlx")
const crash = @import("std.crash")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn hex(value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(text[0..2 + digits])
}

fn shown() -> void {
    if show {
        say(card.log[0..card.logged])
        say("--\n")
    }
}

const N = card.NEVER

var e: engines.Engines = undefined
var l: loaded.Loaded = undefined
var c: compute.Compute = undefined
var where: engines.Card = undefined

// The card anew as the user's (the kernel's small picture at the
// aperture's start), the records begun for a boot that goes to `stage`.
fn fresh(stage: usize) -> void {
    mec.reset()
    card.picture(0, 1280, 960, 1800, 1000)
    card.registers[loaded.SMC_RESP_0] = 1
    where = engines.Card.{ .device = 0x67DF, .revision = 0xE7, .view = card.VIEW, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .dmaBase = card.DMA_BASE, .dmaPages = 2048, .rom = &card.machine }
    const hands = mec.hands()
    engines.begin(&e, &hands, &where, stage)
    const more = mec.more()
    loaded.begin(&l, &more)
    compute.begin(&c)
}

// Stages 0 to 4 run at a boot that goes to stage 5; whether D2 passed.
fn upToD2() -> bool {
    fresh(5)
    engines.run(&e)
    if e.i1 != engines.Outcome.passed { return false }
    if !loaded.smcFirmware(&e, &l) { return false }
    if !loaded.engineFirmware(&e, &l) { return false }
    if !loaded.firstEngine(&e, &l) { return false }
    return loaded.bothEngines(&e, &l)
}

fn upToG1() -> bool {
    if !upToD2() { return false }
    return compute.settings(&e, &l, &c)
}

// ---- The writes a step is wanted to make, written out from the study.

const WANT: usize = 1024
var wantNumber: [WANT]usize = undefined
var wantValue: [WANT]usize = undefined
var wanted: usize = 0

fn want(number: usize, value: usize) -> void {
    wantNumber[wanted] = number
    wantValue[wanted] = value
    wanted += 1
}

fn writesAre(from: usize, what: []const u8) -> bool {
    const at = card.writesFrom(from, wantNumber[0..wanted], wantValue[0..wanted])
    if at == N { return true }
    say("the writes of ")
    say(what)
    say(" differ from the study's at write ")
    hex(at)
    if at < wanted {
        say(": wanted register ")
        hex(wantNumber[at])
        say(" = ")
        hex(wantValue[at])
    }
    if from + at < card.written && from + at < card.WRITES {
        say(", written register ")
        hex(card.writtenTo[from + at])
        say(" = ")
        hex(card.writtenWith[from + at])
    }
    say("\n")
    return false
}

// The temperature read through the SMC's index (and the index put back).
fn wantCool(index: usize) -> void {
    want(engines.SMC_IND_INDEX_11, engines.ixCG_MULT_THERMAL_STATUS)
    want(engines.SMC_IND_INDEX_11, index)
}

fn wantAlive() -> void {
    want(engines.SCRATCH_REG0, engines.SCRATCH_TRIAL)
    want(engines.SCRATCH_REG0, 0)
}

// The study's 5.2, both tables (register, mask, value), in their order.
const STUDY_GOLDEN = [_]usize{ 0xCD4, 0x000C0FC0, 0x000C0200, 0x2684, 0x0001F3CF, 0x00007208, 0x2686, 0x0F000000, 0x0F000000, 0x2683, 0x000001FF, 0x00000040, 0x260D, 0xF00FFFFF, 0x00000400, 0x22FC, 0xFFFFFFFF, 0x20000001, 0xC281, 0x0000FF0F, 0x00000000, 0xA0D4, 0x3F3FFFFF, 0x16000012, 0xA0D5, 0x0000003F, 0x0000002A, 0xEC49, 0x00000003, 0x0001003C, 0xEC9D, 0xFFFFFFFF, 0x0001003C, 0x2300, 0x07F80000, 0x07180000, 0x2542, 0x000F000F, 0x000B0000, 0x2B80, 0x00100000, 0xF31FFF7F, 0x2B05, 0x000003FF, 0x000000F7, 0x2B04, 0xFFFFFFFF, 0x00000000, 0x2232, 0x00000004, 0x00000004 }
const STUDY_COMMON = [_]usize{ 0xC200, 0xE0000000, 0xA0D4, 0x16000012, 0xA0D5, 0x0000002A, 0x263E, 0x22011003, 0x31DC, 0x00000800, 0x31DD, 0x00000800, 0x31E6, 0x00FF7FBF, 0x31E7, 0x00FF7FAF }
// Polaris 10's tiling words (the study's 5.3 step 3: 31 tile modes and 14
// macrotile modes set, the rest 0), worked out by script from gfx_v8_0.c.
const STUDY_TILES = [_]usize{ 0x00800310, 0x00800B10, 0x00801310, 0x00801B10, 0x00802B10, 0x00802B08, 0x00802B14, 0x00802954, 0x00000304, 0x02000308, 0x02000310, 0x06000314, 0x06000154, 0x02400308, 0x02400310, 0x02400330, 0x06400314, 0x06400154, 0x0040030C, 0x0100030C, 0x0100031C, 0x01000334, 0x01000324, 0x01000164, 0x0040031C, 0x01000320, 0x01000338, 0x02C00308, 0x02C00310, 0x06C00314, 0x06C00154, 0 }
const STUDY_MACROTILES = [_]usize{ 0xE8, 0xE8, 0xE8, 0xE8, 0xD4, 0xC0, 0xC0, 0, 0xEC, 0xE8, 0xD4, 0xD0, 0x80, 0x40, 0x40, 0 }

// The golden words as Linux's rule gives them on the card as it is now,
// those that differ; how many.
fn wantGolden() -> usize {
    var changed: usize = 0
    var k: usize = 0
    while k < STUDY_GOLDEN.length {
        const was = before[STUDY_GOLDEN[k]]
        const value = if STUDY_GOLDEN[k + 1] == 0xFFFFFFFF { STUDY_GOLDEN[k + 2] } else { (was & ~STUDY_GOLDEN[k + 1]) | STUDY_GOLDEN[k + 2] }
        if value != was {
            want(STUDY_GOLDEN[k], value)
            changed += 1
        }
        k += 3
    }
    // (The second table writes over the first: what the card holds then.)
    k = 0
    while k < STUDY_COMMON.length {
        var holds = before[STUDY_COMMON[k]]
        var j: usize = 0
        while j < wanted {
            if wantNumber[j] == STUDY_COMMON[k] { holds = wantValue[j] }
            j += 1
        }
        if STUDY_COMMON[k + 1] != holds {
            want(STUDY_COMMON[k], STUDY_COMMON[k + 1])
            changed += 1
        }
        k += 2
    }
    return changed
}

const ALL: usize = 0xE0000000

fn wantSelect(se: usize) -> void { want(0xC200, 0x40000000 | (se << 16)) }

// The study's 5.3 in Linux's order, but DMIF_ADDR_CALC and HDP_ADDR_CONFIG;
// `raster`: all back ends there.
fn wantConstants(raster: bool) -> void {
    want(0x2000, (before[0x2000] & ~@intCast(usize, 0xFF)) | 0xFF)
    want(0x263E, 0x22011003)
    var k: usize = 0
    while k < 32 {
        want(0x2644 + k, STUDY_TILES[k])
        k += 1
    }
    k = 0
    while k < 16 {
        if k != 7 { want(0x2664 + k, STUDY_MACROTILES[k]) }
        k += 1
    }
    var se: usize = 0
    while se < 4 {
        wantSelect(se)
        se += 1
    }
    want(0xC200, ALL)
    if raster {
        want(0xA0D4, 0x16000012)
        want(0xA0D5, 0x2A)
    }
    se = 0
    while se < 4 {
        wantSelect(se)
        se += 1
    }
    want(0xC200, ALL)
    se = 0
    while se < 4 {
        wantSelect(se)
        se += 1
    }
    want(0xC200, ALL)
    want(0x2581, 0x1B)
    var n: usize = 0
    while n < 8 {
        want(0x391, n << 4)
        want(0x230D, if n == 0 { 0x378 } else { 0x338 })
        want(0x230A, if n == 0 { 0 } else { 0x2000 })
        want(0x230B, 1)
        want(0x230C, 0)
        n += 1
    }
    want(0x391, 0)
    n = 8
    while n < 16 {
        want(0x391, n << 4)
        want(0x230D, 0x5E)
        want(0x230B, 1)
        want(0x230C, 0)
        want(0x230A, 0x60006000)
        n += 1
    }
    want(0x391, 0)
    n = 8
    while n < 16 {
        want(0x3300 + 2 * n, 0)
        want(0x3301 + 2 * n, 0)
        want(0x3320 + n, 0)
        want(0x3330 + n, 0)
        n += 1
    }
    n = 1
    while n < 16 {
        want(0x3300 + 2 * n, 0)
        want(0x3301 + 2 * n, 0)
        want(0x3320 + n, 0)
        want(0x3330 + n, 0)
        n += 1
    }
    want(0xC200, ALL)
    want(0x22F3, 0x20 | (0x100 << 6) | (0x30 << 15) | (0x130 << 23))
    want(0x31C0, (before[0x31C0] & ~@intCast(usize, 0xFFF)) | 0x492)
}

// The read-back: the queue selector written where an address space's
// words are read, back to 0 at the end.
fn wantReadBack() -> void {
    var n: usize = 1
    while n < 16 {
        want(0x391, n << 4)
        n += 1
    }
    want(0x391, 0)
}

// The registers before a step, and whether those the step wrote are as
// they were (but the scratch register, the SMC's index and data, the
// selectors, and the `but` words).
var before: [card.ROOM]usize = undefined
var shBefore: [16][4]usize = undefined

fn keep() -> void {
    var k: usize = 0
    while k < card.ROOM {
        before[k] = card.registers[k]
        k += 1
    }
    var n: usize = 0
    while n < 16 {
        var j: usize = 0
        while j < 4 {
            shBefore[n][j] = mec.shMem[n][j]
            j += 1
        }
        n += 1
    }
}

fn asBefore(from: usize, but: []const usize) -> bool {
    var k = from
    while k < card.written && k < card.WRITES {
        const number = card.writtenTo[k]
        var spared = number == engines.SCRATCH_REG0 || number == engines.SMC_IND_INDEX_11 || number == engines.SMC_IND_DATA_11 || number == engines.SRBM_GFX_CNTL || number == loaded.GRBM_GFX_INDEX
        for b in but {
            if b == number { spared = true }
        }
        if !spared && card.registers[number] != before[number] {
            say("register ")
            hex(number)
            say(" is ")
            hex(card.registers[number])
            say(", was ")
            hex(before[number])
            say("\n")
            return false
        }
        k += 1
    }
    var n: usize = 0
    while n < 16 {
        var j: usize = 0
        while j < 4 {
            if mec.shMem[n][j] != shBefore[n][j] {
                say("an address space's shader memory word is not as before\n")
                return false
            }
            j += 1
        }
        n += 1
    }
    return card.registers[loaded.GRBM_GFX_INDEX] == ALL && card.registers[engines.SRBM_GFX_CNTL] == 0
}

// ---- G1.

fn theSettings() -> void {
    expect(upToD2(), "S0 to D2 at stage 5")
    expect(card.registers[engines.RLC_CNTL] & 1 == 0 && card.registers[engines.CP_MEC_CNTL] == 0x50000000, "F2 at stage 5: the RLC and the compute processor halted again")
    line(" (stage 5 starts them from there)")
    keep()
    const from = card.written
    const index = card.registers[engines.SMC_IND_INDEX_11]
    expect(compute.settings(&e, &l, &c), "G1 on the user's card")
    shown()
    wanted = 0
    wantCool(index)
    const changed = wantGolden()
    want(engines.SMC_IND_INDEX_11, engines.ixCG_ACLK_CNTL)
    want(engines.SMC_IND_INDEX_11, index)
    want(engines.SMC_IND_INDEX_11, engines.ixCG_ACLK_CNTL)
    want(engines.SMC_IND_DATA_11, 0x18)
    want(engines.SMC_IND_INDEX_11, index)
    wantConstants(true)
    wantReadBack()
    want(engines.SMC_IND_INDEX_11, engines.ixCG_ACLK_CNTL)
    want(engines.SMC_IND_INDEX_11, index)
    wantCool(index)
    wantAlive()
    expect(writesAre(from, "G1"), "G1 write for write: the golden words that differ, the clock divider, the constants in Linux's order, the read-back")
    expect(changed == 19 && c.golden == 20, "19 golden words differ on this card, and the clock divider")
    expect(card.smcGet(engines.ixCG_ACLK_CNTL) == 0x18, "the SMC's clock divider is 0x18")
    expect(c.units == 36 && c.perEngine[0] == 9 && c.perEngine[3] == 9 && c.backends == 8 && c.backendMask == 0xFF && c.raster, "36 compute units, 9 an engine, 8 render back ends")
    expect(mec.shMem[0][0] == 0x378 && mec.shMem[1][0] == 0x338 && mec.shMem[7][1] == 0x2000 && mec.shMem[8][0] == 0x5E && mec.shMem[15][1] == 0x60006000 && mec.shMem[0][1] == 0, "the address spaces' shader memory words")
    expect(c.rasterRead[0] == 0x16000012 && c.rasterRead[1] == 0x2A, "shader engine 0's raster words kept for the graphics ring")
    line("gpu: golden 0xcd4 was 0x0 now 0xc0200\n")
    line("gpu: golden 0x31e7 was 0x0 now 0xff7faf\n")
    line("gpu: golden: the SMC's clock divider word was 0x0 now 0x18\n")
    noLine("gpu: golden 0xc281")
    noLine("gpu: golden 0x263e")
    line("gpu: step G1: the graphics block's settings: golden words changed: 20 (said above); its constants as Linux sets them but DMIF_ADDR_CALC and HDP_ADDR_CONFIG (stage 6 writes them): address configuration 0x22011003, tiling words 32 and 15; 36 compute units in 4 shader engines (9 9 9 9); 8 of 8 render back ends (raster configuration 0x16000012 0x2a); ")
    line(" registers written, each read back; 41 C before, 41 C after; picture ")
    expect(card.registers[0x303] == 0 && card.registers[0xBD2] == 0, "DMIF_ADDR_CALC and HDP_ADDR_CONFIG not written")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

// A failure of G1: every register as before, the divider word too.
fn settingsFailWith(text: []const u8, what: []const u8) -> void {
    keep()
    const aclk = card.smcGet(engines.ixCG_ACLK_CNTL)
    const from = card.written
    const passed = compute.settings(&e, &l, &c)
    shown()
    expect(!passed && c.g1 == engines.Outcome.failed, what)
    expect(asBefore(from, [_]usize{}[0..]), "every register G1 wrote as before")
    expect(card.smcGet(engines.ixCG_ACLK_CNTL) == aclk, "the clock divider word as before")
    line(text)
    line("; the block's words as before the step (")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn theSettingsFailures() -> void {
    expect(upToD2(), "S0 to D2")
    card.stuck = 0x2647
    settingsFailWith("gpu: step G1 failed: a register does not hold what was written: 0x2647 reads 0x0 where 0x801b10 was written; the block's words", "a tile word that does not hold")
    expect(upToD2(), "S0 to D2")
    card.stuck = 0x230A
    settingsFailWith("gpu: step G1 failed: a register does not hold what was written: 0x230a reads 0x0 where 0x2000 was written (queue selector 0x10)", "an address space's word that does not hold")
    expect(upToD2(), "S0 to D2")
    card.stuck = engines.SMC_IND_DATA_11
    settingsFailWith("gpu: step G1 failed: the SMC's clock divider word does not hold what was written", "the clock divider word")
    expect(upToD2(), "S0 to D2")
    var s: usize = 0
    while s < 4 {
        mec.cuInactive[s] = 0xFFFF
        s += 1
    }
    settingsFailWith("gpu: step G1 failed: the card says it has no compute unit", "no compute unit")
    expect(upToD2(), "S0 to D2")
    s = 0
    while s < 4 {
        mec.rbDisabled[s] = 0xFF
        s += 1
    }
    settingsFailWith("gpu: step G1 failed: the card says it has no render back end", "no render back end")
    expect(upToD2(), "S0 to D2")
    card.scribbleAt = 0x2581
    settingsFailWith("gpu: step G1 failed: the picture's memory changed (sum ", "the picture minds")
    expect(upToD2(), "S0 to D2")
    card.goneAt = 0x2581
    expect(!compute.settings(&e, &l, &c) && c.g1 == engines.Outcome.failed, "the card gone: G1 fails")
    line("gpu: step G1 failed: the card no longer answers as it did; the block's words as before the step (")
    // A card with a render back end fewer: the raster configuration not
    // written, said; G1 passes.
    expect(upToD2(), "S0 to D2")
    mec.rbDisabled[2] = 0xFD
    const from = card.written
    expect(compute.settings(&e, &l, &c), "G1 with 7 render back ends")
    shown()
    expect(c.backends == 7 && c.backendMask == 0xEF && !c.raster, "7 of 8, the raster configuration not written")
    var raster = false
    var k = from
    while k < card.written {
        if card.writtenTo[k] == 0xA0D4 && card.writtenWith[k] == 0x16000012 && k > from + 40 { raster = true }
        k += 1
    }
    expect(!raster, "no raster configuration of all back ends written by setup_rb")
    line("7 of 8 render back ends (mask 0xef: the raster configuration of a card with fewer is not built; it matters for drawing, stage 6)")
    // The refusals: no GFX_Info, the mark.
    expect(upToD2(), "S0 to D2")
    e.found.gfxFound = false
    var at = card.written
    expect(!compute.settings(&e, &l, &c) && c.g1 == engines.Outcome.refused && card.written == at, "no GFX_Info: refused before a write")
    line("gpu: step G1 refused: the card's ROM does not give the graphics block's numbers (GFX_Info), or gives more shader engines, arrays or units than its selectors hold\n")
    expect(upToD2(), "S0 to D2")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 85 << 9)
    at = card.written
    expect(!compute.settings(&e, &l, &c) && c.g1 == engines.Outcome.refused && card.written == at + 2, "85 C: G1 refused, only the temperature read")
    line("gpu: step G1 refused: the card is at 85 C (no step begins at 85 C or more)\n")
}

// ---- G2.

fn theRlc() -> void {
    expect(upToG1(), "S0 to G1")
    card.registers[engines.RLC_SPM_VMID] = 0x30
    keep()
    const from = card.written
    const index = card.registers[engines.SMC_IND_INDEX_11]
    const interrupts = card.registers[loaded.CP_INT_CNTL_RING0]
    expect(compute.rlc(&e, &l, &c), "G2 on the user's card")
    shown()
    wanted = 0
    wantCool(index)
    want(0xEC71, 0x3F)
    want(0xEC00, 0)
    want(0x306A, interrupts & ~@intCast(usize, 0x3C0000))
    var se: usize = 0
    while se < 4 {
        wantSelect(se)
        se += 1
    }
    want(0xC200, ALL)
    want(0x2008, 4)
    want(0x2008, 0)
    want(0xEC00, 1)
    want(0x306A, interrupts | 0x3C0000)
    wantCool(index)
    wantAlive()
    expect(writesAre(from, "G2"), "G2 write for write: SPM VMID, the RLC stopped, the serial buses of each engine, the reset's pulse, started")
    expect(mec.rlcResets == 1 && card.registers[engines.RLC_CNTL] == 1, "the RLC reset once and running")
    line("gpu: step G2: RLC stopped, reset and started: control 0x1 (was 0x0), status 0x0 (was 0x0), GRBM status 2 0x8 (was 0x8), serdes idle after ")
    line(" us; SPM VMID 0x30 -> 0x3f; 41 C before, 41 C after; picture ")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn rlcFailsWith(text: []const u8, what: []const u8) -> void {
    keep()
    const from = card.written
    const passed = compute.rlc(&e, &l, &c)
    shown()
    expect(!passed && c.g2 == engines.Outcome.failed, what)
    expect(asBefore(from, [_]usize{ engines.RLC_CNTL, loaded.CP_INT_CNTL_RING0, compute.GRBM_SOFT_RESET }[0..]), "every register G2 wrote as before")
    expect(card.registers[engines.RLC_CNTL] & 1 == 0 && card.registers[loaded.CP_INT_CNTL_RING0] & 0x3C0000 == before[loaded.CP_INT_CNTL_RING0] & 0x3C0000, "the RLC stopped, the idle interrupts as before")
    line(text)
    line("; the RLC stopped (control 0x0), its words as before the step (")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn theRlcFailures() -> void {
    expect(upToG1(), "S0 to G1")
    card.stuck = engines.RLC_CNTL
    rlcFailsWith("gpu: step G2 failed: the RLC does not run (control 0x0)", "an RLC that does not run")
    expect(upToG1(), "S0 to G1")
    card.stuck = engines.RLC_SPM_VMID
    rlcFailsWith("gpu: step G2 failed: the SPM address space word does not hold (it reads 0x0)", "the SPM word")
    expect(upToG1(), "S0 to G1")
    mec.serdesBusy[2] = true
    rlcFailsWith("gpu: step G2 failed: the RLC's serial bus of shader engine 2, array 0, of its compute units, stayed busy for 100 ms", "a serial bus that stays busy")
    expect(upToG1(), "S0 to G1")
    mec.noncuBusy = true
    rlcFailsWith("gpu: step G2 failed: the RLC's serial buses besides the compute units' stayed busy for 100 ms (0x10000)", "the other serial buses busy")
    expect(upToG1(), "S0 to G1")
    mec.resetSticks = true
    rlcFailsWith("gpu: step G2 failed: the RLC's reset bit stays set (0x4)", "the reset bit that stays")
    // Refused without G1.
    expect(upToD2(), "S0 to D2")
    const at = card.written
    expect(!compute.rlc(&e, &l, &c) && c.g2 == engines.Outcome.refused && card.written == at, "G2 without G1: refused before a write")
    line("gpu: step G2 refused: the graphics block's settings are not made (step G1)\n")
}

// ---- The order of a boot: D1 in Linux's order.

fn theOrder() -> void {
    // Copy engine 0 reads its ring only once the RLC runs: at a boot of
    // stage 5, D1 fails, G1 and G2 follow, D1 passes, then D2 and the rest
    // of stage 5.
    fresh(5)
    mec.sdmaNeedsRlc = true
    smc.dead = 0
    engines.run(&e)
    compute.run(&e, &l, &c)
    shown()
    expect(l.f2 == engines.Outcome.passed && l.d1 == engines.Outcome.passed && l.d2 == engines.Outcome.passed && c.g1 == engines.Outcome.passed && c.g2 == engines.Outcome.passed && c.g3 == engines.Outcome.passed && c.g4 == engines.Outcome.passed, "D1 in Linux's order, then D2 and G3, G4")
    line("gpu: step D1 failed: copy engine 0 did not write within 100 ms")
    line("gpu: copy engine 0 did not read its ring: Linux's order follows, the graphics block's settings and the RLC first (G1 and G2), then D1 once more\n")
    line("gpu: D1 passed in Linux's order (G1 and G2 first): the copy engines need the graphics block started on this card\n")
    expect(card.count("gpu: step G1:") == 1 && card.count("gpu: step G2:") == 1, "G1 and G2 once")
    expect(card.after("gpu: step G2:", 0) < card.after("gpu: step D1: copy engine 0 runs", 0) && card.after("gpu: step D1: copy engine 0 runs", 0) < card.after("gpu: step D2:", 0), "G2, then D1, then D2")
    // At stage 4 no second order.
    fresh(4)
    mec.sdmaNeedsRlc = true
    smc.dead = 0
    engines.run(&e)
    compute.run(&e, &l, &c)
    expect(l.d1 == engines.Outcome.failed && c.g1 == engines.Outcome.not_tried, "stage 4: D1 failed, no G1")
    noLine("Linux's order follows")
    // A copy engine that never reads: Linux's order tried, said to fail.
    fresh(5)
    smc.dead = 0
    engines.run(&e)
    compute.run(&e, &l, &c)
    expect(l.d1 == engines.Outcome.failed && c.g2 == engines.Outcome.passed && l.d2 == engines.Outcome.not_tried, "D1 fails in both orders")
    line("gpu: D1 failed in Linux's order as well (G1 and G2 first)\n")
    // A D1 that faults: not tried again.
    fresh(5)
    card.faultAt = 0x3484
    engines.run(&e)
    compute.run(&e, &l, &c)
    expect(l.d1 == engines.Outcome.failed && c.g1 == engines.Outcome.not_tried, "a fault in D1: no second order")
    noLine("Linux's order follows")
    // A copy engine that does not read its ring and a fault besides: the
    // study's condition for Linux's order is "no fault", so it is not tried
    // (the case above reads its ring: only this one holds that clause).
    fresh(5)
    smc.dead = 0
    card.faultAt = 0x3484
    engines.run(&e)
    compute.run(&e, &l, &c)
    expect(l.d1 == engines.Outcome.failed && !l.unread && c.g1 == engines.Outcome.not_tried, "a D1 that neither reads nor stays clear of faults: no second order")
    noLine("Linux's order follows")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) == 2
    _ = crash.install()
    if !card.makeRom(true) {
        say("the ROM could not be made\n")
        return 5
    }
    const names = [_][]const u8{ "polaris10_pfp_2.bin", "polaris10_me_2.bin", "polaris10_ce_2.bin", "polaris10_mec_2.bin", "polaris10_rlc.bin", "polaris10_sdma.bin", "polaris10_sdma1.bin", "polaris10_k_smc.bin", "polaris10_smc_sk.bin" }
    for name in names {
        if !card.load(name) {
            say("the firmware files could not be read (run from the repository's top)\n")
            return 6
        }
    }
    // The code's golden tables are the study's.
    var k: usize = 0
    var same = compute.GOLDEN_GRAPHICS_WORDS.length == STUDY_GOLDEN.length
    while same && k < STUDY_GOLDEN.length {
        if compute.GOLDEN_GRAPHICS_WORDS[k] != STUDY_GOLDEN[k] { same = false }
        k += 1
    }
    k = 0
    same = same && compute.GOLDEN_COMMON_WORDS.length == STUDY_COMMON.length / 2 * 3
    while same && k < STUDY_COMMON.length / 2 {
        if compute.GOLDEN_COMMON_WORDS[k * 3] != STUDY_COMMON[k * 2] || compute.GOLDEN_COMMON_WORDS[k * 3 + 1] != 0xFFFFFFFF || compute.GOLDEN_COMMON_WORDS[k * 3 + 2] != STUDY_COMMON[k * 2 + 1] { same = false }
        k += 1
    }
    expect(same, "the golden tables are the study's 5.2, row for row")
    theSettings()
    theSettingsFailures()
    theRlc()
    theRlcFailures()
    theOrder()
    if failed != 0 { return failed }
    return 13
}
