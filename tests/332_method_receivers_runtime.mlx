// Method calls as spec/00-language/aggregates.xml's MethodCallSugar has
// them: `value.method(args)` is `Type.method(value, args)`, a method taking
// a pointer gets the address of an addressable value (a local, a field, an
// element), and a pointer calls the methods of what it points to. Before,
// a pointer receiver and the address taken for one did not type at all.
// Exits 13.
const Counter = struct {
    total: usize

    pub fn add(self: *Self, amount: usize) -> void {
        self.*.total += amount
    }

    pub fn doubled(self: *const Self) -> usize {
        return self.*.total * 2
    }

    pub fn value(self: Self) -> usize {
        return self.total
    }
}

const Holder = struct {
    counter: Counter
    counters: [3]Counter
}

const Color = enum(u8) {
    red, green, blue

    pub fn next(self: Self) -> Self {
        if self == Color.red { return Color.green }
        if self == Color.green { return Color.blue }
        return Color.red
    }
}

fn bumpThrough(holder: *Holder) -> void {
    holder.*.counter.add(10)
    holder.*.counters[2].add(20)
}

pub fn main() -> u8 {
    var counter = Counter.{ .total = 1 }
    counter.add(5)
    if counter.total != 6 { return 1 }
    if counter.doubled() != 12 { return 2 }
    if counter.value() != 6 { return 3 }
    const pointer = &counter
    pointer.add(1)
    if pointer.doubled() != 14 || pointer.*.value() != 7 { return 4 }
    var holder = Holder.{ .counter = Counter.{ .total = 0 }, .counters = [3]Counter{ Counter.{ .total = 0 }, Counter.{ .total = 0 }, Counter.{ .total = 0 } } }
    holder.counter.add(3)
    holder.counters[1].add(4)
    bumpThrough(&holder)
    if holder.counter.total != 13 || holder.counters[1].total != 4 || holder.counters[2].total != 20 { return 5 }
    const fixed = Counter.{ .total = 9 }
    if fixed.doubled() != 18 || fixed.value() != 9 { return 6 }
    var color = Color.red
    color = color.next().next()
    if color != Color.blue { return 7 }
    var index: usize = 0
    while index < 3 {
        holder.counters[index].add(index)
        index += 1
    }
    if holder.counters[2].total != 22 { return 8 }
    return 13
}
