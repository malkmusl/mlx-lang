// std.dbus's address entries (transports, values with %XX escapes) and
// EXTERNAL authentication on a descriptor of one's own, against servers
// played by child processes: one that agrees to pass descriptors, one
// that does not, one that rejects the client. Exits 13 when every check
// holds, else the number of the first check that failed.
const std = @import("std")
const dbus = @import("std.dbus")

const linux = std.linux

// The server's side: reads the client's lines up to BEGIN (answering OK
// and, when `agree`, AGREE_UNIX_FD; REJECTED when `reject`), then checks
// that the NUL and the uid's hex digits came first and sends a byte the
// client must not have read.
fn serve(descriptor: isize, agree: bool, reject: bool) -> u8 {
    var bytes: [512]u8 = undefined
    const bytes_pointer: [*]u8 = &bytes
    var have: usize = 0
    var answered_auth = false
    var answered_fds = false
    while true {
        if have >= 512 { return 20 }
        const got = linux.read(descriptor, bytes_pointer + have, 512 - have)
        if got <= 0 { return if reject { 0 } else { 21 } }
        have += @bitCast(usize, got)
        const seen = bytes_pointer[0..have]
        if !answered_auth && std.text.contains(seen, "\r\n") {
            answered_auth = true
            if reject {
                if !linux.writeAll(descriptor, "REJECTED EXTERNAL\r\n") { return 22 }
            } else {
                if !linux.writeAll(descriptor, "OK 0123456789abcdef0123456789abcdef\r\n") { return 22 }
            }
        }
        if !answered_fds && std.text.contains(seen, "NEGOTIATE_UNIX_FD\r\n") {
            answered_fds = true
            const answer: []const u8 = if agree { "AGREE_UNIX_FD\r\n" } else { "ERROR not here\r\n" }
            if !linux.writeAll(descriptor, answer) { return 23 }
        }
        if std.text.contains(seen, "BEGIN\r\n") { break }
    }
    if bytes[0] != 0 || !std.text.startsWith(bytes_pointer[1..have], "AUTH EXTERNAL ") { return 24 }
    // The uid in decimal, hex-encoded: "1000" is "31303030".
    var expected: [32]u8 = undefined
    const expected_bytes: [*]u8 = &expected
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = @intCast(usize, linux.process.realUserId())
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var length: usize = 0
    const hex = "0123456789abcdef"
    while count > 0 {
        count -= 1
        expected[length] = hex[@intCast(usize, digits[count] >> 4)]
        expected[length + 1] = hex[@intCast(usize, digits[count] & 15)]
        length += 2
    }
    if !std.text.startsWith(bytes_pointer[15..have], expected_bytes[0..length]) { return 25 }
    if !linux.writeAll(descriptor, "M") { return 26 }
    return 0
}

// Authenticates against a child server: what authenticate returned, or
// a check number above 100 when something else went wrong.
fn against(agree: bool, reject: bool, guid: [*]u8) -> isize {
    var pair: [2]i32 = [2]i32{ -1, -1 }
    if linux.socket.socketPair(linux.socket.AF_UNIX, linux.socket.SOCK_STREAM, 0, &pair) < 0 { return 101 }
    const client = @intCast(isize, pair[0])
    const server = @intCast(isize, pair[1])
    const child = linux.process.fork()
    if child == 0 {
        linux.close(client)
        linux.exitGroup(@intCast(usize, serve(server, agree, reject)))
    }
    linux.close(server)
    if child < 0 { return 102 }
    const result = dbus.authenticate(client, linux.process.realUserId(), true, guid)
    // What the server sent after BEGIN is still there to read.
    if result >= 0 {
        var byte: [1]u8 = [1]u8{ 0 }
        const byte_bytes: [*]u8 = &byte
        if linux.read(client, byte_bytes, 1) != 1 || byte[0] != 77 { return 103 }
    }
    linux.close(client)
    var status: usize = 0
    if linux.process.waitProcess(child, &status, 0) != child || !linux.process.succeeded(status) { return 104 }
    return result
}

pub fn main(arguments: [][*]const u8) -> u8 {
    // Transports and values.
    if !std.text.same(dbus.addressTransport("unix:path=/run/bus"), "unix") { return 1 }
    if dbus.addressTransport("nothing").length != 0 { return 1 }
    var value: [64]u8 = undefined
    const value_bytes: [*]u8 = &value
    var length = dbus.addressValue("unix:path=/run/bus,guid=abc", "path", value_bytes, 64)
    if length != 8 || !std.text.same(value_bytes[0..8], "/run/bus") || value[8] != 0 { return 2 }
    length = dbus.addressValue("unix:path=/run/bus,guid=abc", "guid", value_bytes, 64)
    if length != 3 || !std.text.same(value_bytes[0..3], "abc") { return 3 }
    length = dbus.addressValue("unix:abstract=%2ftmp%2Fdbus-x,guid=1", "abstract", value_bytes, 64)
    if length != 11 || !std.text.same(value_bytes[0..11], "/tmp/dbus-x") { return 4 }
    if dbus.addressValue("unix:path=/run/bus", "abstract", value_bytes, 64) != -1 { return 5 }
    if dbus.addressValue("unix:path=/a%zz", "path", value_bytes, 64) != -2 { return 6 }
    if dbus.addressValue("unix:path=/a%2", "path", value_bytes, 64) != -2 { return 6 }
    if dbus.addressValue("unix:path=/run/bus", "path", value_bytes, 4) != -2 { return 7 }
    if dbus.addressValue("nocolon", "path", value_bytes, 64) != -1 { return 7 }

    // Authentication: descriptor passing agreed, refused, the client
    // rejected.
    var guid: [33]u8 = undefined
    const guid_bytes: [*]u8 = &guid
    const agreed = against(true, false, guid_bytes)
    if agreed != 1 { return if agreed > 100 { @intCast(u8, agreed - 90) } else { 8 } }
    if !std.text.same(guid_bytes[0..32], "0123456789abcdef0123456789abcdef") || guid[32] != 0 { return 9 }
    const refused = against(false, false, guid_bytes)
    if refused != 0 { return if refused > 100 { @intCast(u8, refused - 90) } else { 10 } }
    const rejected = against(false, true, guid_bytes)
    if rejected != -1 { return if rejected > 100 { @intCast(u8, rejected - 90) } else { 11 } }
    return 13
}
