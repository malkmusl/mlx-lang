// A module-level constant whose initializer is another constant's name
// (`const T: []const u8 = NAME`, `module.NAME`, in its module or another)
// has that constant's value: it once lowered to nothing ("unresolved
// backend symbol") or, untyped across modules, to an empty slice.
// Exits 13.
const support = @import("./support/constant_alias.mlx")

const HERE = "hello"
const ALIAS = HERE
const TYPED: []const u8 = HERE
const OTHER: []const u8 = support.NAME

pub fn main() -> u8 {
    if ALIAS.length != 5 || TYPED.length != 5 || TYPED[4] != 111 { return 1 }
    if OTHER.length != 3 || OTHER[0] != 97 { return 2 }
    if support.TYPED.length != 3 || support.UNTYPED.length != 3 || support.UNTYPED[2] != 99 { return 3 }
    return 13
}
