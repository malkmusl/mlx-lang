// logserve's parts that need no network (projects/brix/tools/logserve),
// built for the host: a request's head read (what is still waited for,
// GET and HEAD with their path, other methods, what is no HTTP/1
// request, a head over the limit), the fixed pages a path names and
// every other path naming none, the kernel log's "gpu:" lines, a saved
// log that is the kernel log's beginning, a network link's record in
// words, the text that grows, and the pages that need no kernel log (the
// list, the refusal, the one text's first and last line); then the edges:
// the limit's number, a query or a fragment that names a file, a NUL and
// encoded dots in a path, request lines that are none, a second request
// behind the first, and a head that comes a byte at a time.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const std = @import("std")
const brix = std.os.brix
const request = @import("../projects/brix/tools/logserve/request.mlx")
const pages = @import("../projects/brix/tools/logserve/pages.mlx")
const Text = @import("../projects/brix/tools/logserve/text.mlx").Text

const same = std.text.same

fn verdictOf(bytes: []const u8) -> request.Verdict { return request.read(bytes).verdict }

// A request whose head is `length` bytes of one long path, with or
// without its end.
var long: [request.LIMIT + 64]u8 = undefined // (per run)

fn longRequest(length: usize, ended: bool) -> []const u8 {
    const start = "GET /"
    const end = " HTTP/1.1\r\n\r\n"
    var k: usize = 0
    while k < length {
        long[k] = if k < start.length { start[k] } else { 97 }
        k += 1
    }
    if ended {
        k = 0
        while k < end.length {
            long[length - end.length + k] = end[k]
            k += 1
        }
    }
    return long[0..length]
}

fn link(up: bool, asking: bool, configured: u32, speed: u32) -> brix.NetworkLink {
    var l: brix.NetworkLink = undefined
    l.up = up
    l.asking = asking
    l.configured = configured
    l.speed = speed
    l.hardware = [6]u8{ 0x52, 0x54, 0x00, 0xab, 0xcd, 0x0f }
    l.driver = [8]u8{ 105, 103, 98, 0, 0, 0, 0, 0 }
    l.driverLength = 3
    l.address = [4]u8{ 10, 10, 36, 57 }
    l.mask = [4]u8{ 255, 255, 254, 0 }
    l.gateway = [4]u8{ 10, 10, 36, 1 }
    l.nameServer = [4]u8{ 10, 10, 0, 53 }
    l.received = 1234
    l.sent = 56
    return l
}

pub fn main() -> u8 {
    // A head that has not ended is waited for; one that has is read.
    if verdictOf("") != request.Verdict.more || verdictOf("GE") != request.Verdict.more || verdictOf("GET /klog HTTP/1.1\r\nHost: brix\r\n") != request.Verdict.more { return 1 }
    var asked = request.read("GET /klog HTTP/1.1\r\nHost: brix\r\nAccept: */*\r\n\r\n")
    if asked.verdict != request.Verdict.served || asked.headOnly || !same(asked.method, "GET") || !same(asked.path, "/klog") { return 2 }
    asked = request.read("HEAD /all?since=boot#end HTTP/1.0\r\n\r\n")
    if asked.verdict != request.Verdict.served || !asked.headOnly || !same(asked.method, "HEAD") || !same(asked.path, "/all") { return 3 }
    // (Bare line feeds, as a person types them into nc.)
    asked = request.read("GET / HTTP/1.1\n\n")
    if asked.verdict != request.Verdict.served || !same(asked.path, "/") { return 4 }
    // Other methods are told apart from what is no request (with what
    // follows the head, a body, left alone).
    asked = request.read("POST /klog HTTP/1.1\r\nContent-Length: 3\r\n\r\nabc")
    if asked.verdict != request.Verdict.otherMethod || !same(asked.method, "POST") || !same(asked.path, "/klog") { return 5 }
    if verdictOf("OPTIONS * HTTP/1.1\r\n\r\n") != request.Verdict.otherMethod || verdictOf("DELETE /klog HTTP/1.1\r\n\r\n") != request.Verdict.otherMethod { return 6 }
    // What is no HTTP/1 request: no version, an empty target, another
    // version, a proxy's target, and, without waiting for a line's end,
    // what cannot become a method.
    if verdictOf("GET /klog\r\n\r\n") != request.Verdict.malformed || verdictOf("GET  HTTP/1.1\r\n\r\n") != request.Verdict.malformed { return 7 }
    if verdictOf("GET / HTTP/2.0\r\n\r\n") != request.Verdict.malformed || verdictOf("GET / HTTP/1.15\r\n\r\n") != request.Verdict.malformed || verdictOf("GET http://brix/klog HTTP/1.1\r\n\r\n") != request.Verdict.malformed { return 8 }
    if verdictOf("\x16\x03\x01") != request.Verdict.malformed || verdictOf("get /") != request.Verdict.malformed || verdictOf("ABCDEFGHIJKLMNOPQ") != request.Verdict.malformed { return 9 }
    // The limit: a head that ends within it is read, one that has not
    // ended by then is too long, one byte less is still waited for.
    if verdictOf(longRequest(request.LIMIT, true)) != request.Verdict.served || request.read(longRequest(request.LIMIT, true)).path.length != request.LIMIT - 17 { return 10 }
    if verdictOf(longRequest(request.LIMIT, false)) != request.Verdict.tooLong || verdictOf(longRequest(request.LIMIT - 1, false)) != request.Verdict.more { return 11 }

    // The fixed pages by their names; no other path names one.
    if pages.find("/") != pages.Page.index || pages.find("/all") != pages.Page.all || pages.find("/klog") != pages.Page.klog || pages.find("/gpu") != pages.Page.gpu { return 12 }
    if pages.find("/boot.log") != pages.Page.bootLog || pages.find("/boot.previous.log") != pages.Page.previousLog || pages.find("/system") != pages.Page.system { return 14 }
    if pages.find("") != pages.Page.none || pages.find("/klog/") != pages.Page.none || pages.find("/KLOG") != pages.Page.none || pages.find("/devices/klog") != pages.Page.none || pages.find("/../devices/klog") != pages.Page.none || pages.find("//") != pages.Page.none || pages.find("/all/../klog") != pages.Page.none || pages.find("/system/settings/shadow") != pages.Page.none { return 15 }
    if !same(pages.kind(pages.Page.index), "text/html; charset=utf-8") || !same(pages.kind(pages.Page.klog), "text/plain; charset=utf-8") || !same(pages.kind(pages.Page.all), "text/plain; charset=utf-8") { return 16 }

    // The kernel log's lines that begin with "gpu:" (not those that have
    // it further on), the last one without a line's end too.
    var text: Text = undefined
    text.init()
    if pages.gpuLines("brixOS: probing gpu\ngpu: config_memsize 8192\n gpu: indented\nnot gpu: this\ngpu:\nthe last gpu: no\ngpu: raw 1b80: 00000f9f", &text) != 3 { return 17 }
    if !same(text.slice(), "gpu: config_memsize 8192\ngpu:\ngpu: raw 1b80: 00000f9f\n") { return 18 }
    text.deinit()
    if pages.gpuLines("", &text) != 0 || pages.gpuLines("brixOS: no card\n", &text) != 0 || text.length != 0 { return 19 }

    // A saved log that is the kernel log's beginning.
    if !pages.isStartOf("boot\n", "boot\nlater\n") || !pages.isStartOf("boot\n", "boot\n") || pages.isStartOf("boat\n", "boot\nlater\n") || pages.isStartOf("boot\nlater\nmore\n", "boot\nlater\n") { return 20 }

    // A link's record in words.
    var l = link(true, false, brix.NetworkLink.DHCP, 1000)
    pages.linkWords(&text, 0, &l)
    if !same(text.slice(), "net0: igb, hardware address 52:54:00:ab:cd:0f, cable connected, 1000 Mbit/s\nnet0: address 10.10.36.57, netmask 255.255.254.0, gateway 10.10.36.1, name server 10.10.0.53 (by DHCP)\nnet0: 1234 frames received, 56 sent\n") { return 21 }
    text.deinit()
    l = link(true, true, brix.NetworkLink.NONE, 0)
    pages.linkWords(&text, 1, &l)
    if !same(text.slice(), "net1: igb, hardware address 52:54:00:ab:cd:0f, cable connected\nnet1: no address yet (DHCP is asking)\nnet1: 1234 frames received, 56 sent\n") { return 22 }
    text.deinit()
    l = link(false, false, brix.NetworkLink.SETTINGS, 0)
    pages.linkWords(&text, 0, &l)
    if !same(text.slice(), "net0: igb, hardware address 52:54:00:ab:cd:0f, no cable\nnet0: address 10.10.36.57, netmask 255.255.254.0, gateway 10.10.36.1, name server 10.10.0.53 (from /system/settings/network)\nnet0: 1234 frames received, 56 sent\n") { return 23 }
    text.deinit()
    l = link(false, false, brix.NetworkLink.NONE, 0)
    pages.linkWords(&text, 0, &l)
    if std.text.find(text.slice(), "\nnet0: no address\n") == text.length { return 24 }
    text.deinit()
    // (A configuration that came without a gateway and a name server.)
    l = link(true, false, brix.NetworkLink.SETTINGS, 0)
    l.gateway = [4]u8{ 0, 0, 0, 0 }
    l.nameServer = [4]u8{ 0, 0, 0, 0 }
    pages.linkWords(&text, 0, &l)
    if std.text.find(text.slice(), "\nnet0: address 10.10.36.57, netmask 255.255.254.0, gateway none, name server none (from /system/settings/network)\n") == text.length { return 34 }
    text.deinit()

    // The text that grows: a megabyte and a half in pieces of 7 bytes,
    // every byte where it was put; numbers and addresses.
    var k: usize = 0
    while k < 200000 {
        text.add("0123456")
        k += 1
    }
    if text.short || text.length != 1400000 || text.capacity < text.length { return 25 }
    k = 0
    while k < text.length {
        if text.bytes[k] != @intCast(u8, 48 + k % 7) { return 26 }
        k += 4099
    }
    text.deinit()
    if text.length != 0 || text.slice().length != 0 { return 27 }
    text.number(0)
    text.add(" ")
    text.number(18446744073709551615)
    text.add(" ")
    text.address([4]u8{ 192, 168, 1, 20 })
    if !same(text.slice(), "0 18446744073709551615 192.168.1.20") { return 28 }
    text.deinit()

    // The pages that need no kernel log: the list names every page, a
    // path that names none is refused with the pages there are, and the
    // one text begins with the machine and ends with its last line.
    if !pages.build(pages.Page.index, &text) { return 29 }
    if std.text.find(text.slice(), "href=\"/all\"") == text.length || std.text.find(text.slice(), "href=\"/gpu\"") == text.length || std.text.find(text.slice(), "href=\"/klog\"") == text.length || std.text.find(text.slice(), "href=\"/boot.log\"") == text.length || std.text.find(text.slice(), "href=\"/boot.previous.log\"") == text.length || std.text.find(text.slice(), "href=\"/system\"") == text.length { return 30 }
    text.deinit()
    if pages.build(pages.Page.none, &text) || !same(text.slice(), "logserve has no such page. It has: / /all /gpu /gpu.rom /klog /boot.log /boot.previous.log /system\n") { return 31 }
    // The graphics card's ROM: a page of its own, bytes and no text; on
    // a machine whose kernel read none, said so.
    if pages.find("/gpu.rom") != pages.Page.gpuRom || pages.find("/gpu.rom/") != pages.Page.none || pages.find("/devices/gpurom") != pages.Page.none || !same(pages.kind(pages.Page.gpuRom), "application/octet-stream") { return 46 }
    text.deinit()
    if !pages.build(pages.Page.index, &text) || std.text.find(text.slice(), "href=\"/gpu.rom\"") == text.length { return 47 }
    text.deinit()
    if pages.build(pages.Page.gpuRom, &text) || !same(text.slice(), "no video BIOS ROM here: /devices/gpurom cannot be opened (the graphics driver read none at boot)\n") { return 48 }
    text.deinit()
    if !pages.build(pages.Page.all, &text) || !std.text.startsWith(text.slice(), "==== /system: the machine and its network links ====\n") || !std.text.endsWith(text.slice(), "\n==== end ====\n") { return 32 }
    if std.text.find(text.slice(), "\n==== /gpu: the kernel log's lines that begin with \"gpu:\" (") == text.length || std.text.find(text.slice(), "\n==== /klog: ") == text.length || std.text.find(text.slice(), "\n==== /boot.log: ") == text.length || std.text.find(text.slice(), "\n==== /boot.previous.log: ") == text.length { return 33 }
    text.deinit()

    // The limit is the 2048 bytes the refusal's text says.
    if request.LIMIT != 2048 { return 35 }
    // What follows a ? or a # is no part of the path, whatever it names;
    // a NUL, an encoded dot or slash, a second slash stay in the path as
    // they came, and such a path names no page.
    asked = request.read("GET /gpu?/devices/klog HTTP/1.1\r\n\r\n")
    if asked.verdict != request.Verdict.served || !same(asked.path, "/gpu") || pages.find(asked.path) != pages.Page.gpu { return 36 }
    asked = request.read("GET /klog#/devices/klog?x HTTP/1.1\r\n\r\n")
    if asked.verdict != request.Verdict.served || !same(asked.path, "/klog") { return 37 }
    asked = request.read("GET /klog\x00/../devices/klog HTTP/1.1\r\n\r\n")
    if asked.verdict != request.Verdict.served || asked.path.length != 22 || pages.find(asked.path) != pages.Page.none { return 38 }
    if pages.find("/klog\x00") != pages.Page.none || pages.find("/klog%00") != pages.Page.none || pages.find("/%2e%2e/devices/klog") != pages.Page.none || pages.find("/./klog") != pages.Page.none || pages.find("//klog") != pages.Page.none || pages.find("/klog/.") != pages.Page.none || pages.find("/..%2fdevices%2fklog") != pages.Page.none || pages.find("/klog;x") != pages.Page.none || pages.find("/klo") != pages.Page.none { return 39 }
    // What is no request line: two blanks or a tab between its parts, a
    // blank after the version, a target that is no path; a method of 16
    // letters is one (and refused as another method).
    if verdictOf("GET  / HTTP/1.1\r\n\r\n") != request.Verdict.malformed || verdictOf("GET\t/ HTTP/1.1\r\n\r\n") != request.Verdict.malformed || verdictOf("GET / HTTP/1.1 \r\n\r\n") != request.Verdict.malformed { return 40 }
    if verdictOf("GET ?x HTTP/1.1\r\n\r\n") != request.Verdict.malformed || verdictOf("GET * HTTP/1.1\r\n\r\n") != request.Verdict.malformed || verdictOf("GET \\klog HTTP/1.1\r\n\r\n") != request.Verdict.malformed || verdictOf(" / HTTP/1.1\r\n\r\n") != request.Verdict.malformed { return 41 }
    if verdictOf("ABCDEFGHIJKLMNOP / HTTP/1.1\r\n\r\n") != request.Verdict.otherMethod { return 42 }
    // A second request behind the first is not read.
    asked = request.read("GET /gpu HTTP/1.1\r\n\r\nGET /devices/klog HTTP/1.1\r\n\r\n")
    if asked.verdict != request.Verdict.served || !same(asked.path, "/gpu") { return 43 }
    // A head that comes a byte at a time: every beginning of it is still
    // waited for, the whole is the request.
    const whole = "HEAD /system?x HTTP/1.0\r\nHost: brix\r\n\r\n"
    k = 0
    while k < whole.length {
        if verdictOf(whole[0..k]) != request.Verdict.more { return 44 }
        k += 1
    }
    asked = request.read(whole)
    if asked.verdict != request.Verdict.served || !asked.headOnly || !same(asked.path, "/system") { return 45 }
    return 13
}
