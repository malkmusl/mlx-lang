// std.spawn: a program found in PATH with its output captured, its exit
// status (and a signal's), a descriptor moved to an agreed number, the
// working directory, vfork, a detached program, and one that cannot run
// (127). Exits 13 when every check holds, else the number of the first
// check that failed.
const std = @import("std")
const spawn = @import("std.spawn")

fn arguments3(into: *[4][*]const u8, first: []const u8, second: []const u8, third: []const u8) -> [*][*]const u8 {
    unsafe {
        into.*[0] = @ptrCast([*]const u8, first.pointer)
        into.*[1] = @ptrCast([*]const u8, second.pointer)
        into.*[2] = @ptrCast([*]const u8, third.pointer)
        into.*[3] = @ptrFromInt([*]const u8, 0)
        return @ptrCast([*][*]const u8, into)
    }
}

// A literal's bytes (NUL-terminated, as the compiler lays them out).
fn c(text: []const u8) -> [*]const u8 { return text.pointer }

fn same(bytes: [*]const u8, length: isize, text: []const u8) -> bool {
    if length != @intCast(isize, text.length) { return false }
    return std.text.same(bytes[0..text.length], text)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const environment = std.process.environmentEntries(arguments)
    var argv: [4][*]const u8 = undefined
    var output: [256]u8 = undefined
    const output_bytes: [*]u8 = &output
    var status: usize = 0

    // sh found in PATH, its output (and errors) captured.
    var options = spawn.options(c("sh"), arguments3(&argv, "sh", "-c", "echo out; echo err >&2; exit 3"), environment)
    options.searchPath = true
    var length = spawn.capture(&options, true, output_bytes, 256, &status)
    if !same(output_bytes, length, "out\nerr\n") || status != 3 { return 1 }
    options = spawn.options(c("sh"), arguments3(&argv, "sh", "-c", "echo out; echo err >&2"), environment)
    // Errors not captured go where they are set to go.
    options.errors = std.linux.open(c("/dev/null"), std.linux.O_WRONLY | std.linux.O_CLOEXEC, 0)
    options.searchPath = true
    length = spawn.capture(&options, false, output_bytes, 256, &status)
    if !same(output_bytes, length, "out\n") || status != 0 { return 2 }

    // A signal's status, and output beyond the room read and dropped.
    options = spawn.options(c("/bin/sh"), arguments3(&argv, "sh", "-c", "echo 0123456789; kill -9 $$"), environment)
    length = spawn.capture(&options, false, output_bytes, 4, &status)
    if !same(output_bytes, length, "0123") || status != 137 { return 3 }

    // A descriptor at an agreed number, and the working directory.
    var read_end: isize = -1
    var write_end: isize = -1
    if !std.linux.pipe(&read_end, &write_end, std.linux.O_CLOEXEC) { return 4 }
    options = spawn.options(c("/bin/sh"), arguments3(&argv, "sh", "-c", "pwd >&5"), environment)
    options.extra = write_end
    options.extraAt = 5
    const tmp: []const u8 = "/tmp"
    options.directory = tmp.pointer
    options.shareMemory = true
    const pid = spawn.start(&options)
    std.linux.close(write_end)
    if pid <= 0 || spawn.wait(pid) != 0 { return 5 }
    if !same(output_bytes, std.linux.read(read_end, output_bytes, 256), "/tmp\n") { return 6 }
    std.linux.close(read_end)

    // Not found: 127; PATH empty and no fallback: 127 too.
    options = spawn.options(c("/no/such/program"), arguments3(&argv, "x", "y", "z"), environment)
    if spawn.wait(spawn.start(&options)) != 127 { return 7 }
    options = spawn.options(c("no-such-program-anywhere"), arguments3(&argv, "x", "y", "z"), environment)
    options.searchPath = true
    if spawn.wait(spawn.start(&options)) != 127 { return 8 }

    // Detached: the intermediate child is reaped, nothing else is ours.
    options = spawn.options(c("/bin/true"), arguments3(&argv, "true", "", ""), environment)
    options.detach = true
    if spawn.start(&options) <= 0 { return 9 }
    var ended: usize = 0
    if !spawn.ended(-1, &ended) || ended != 255 { return 10 }
    return 13
}
