// std.crypto's symmetric parts against their standards' vectors: HMAC
// with SHA-384 and SHA-512 (RFC 4231's cases 2 and 6), HKDF-SHA256
// (RFC 5869's case 1), AES-128/192/256 both ways (FIPS 197's C.1 to
// C.3), AES-GCM
// (the GCM specification's test cases 2, 4 and 16, and case 4's key at
// 192 bits), ChaCha20, Poly1305 and their AEAD (RFC 8439's 2.4.2, 2.5.2
// and 2.8.2), with forged tags refused; AES-GCM with IVs of 8 and 60
// bytes (test cases 5 and 6) and a tag cut to 12 bytes, PBKDF2 with
// HMAC-SHA1 (RFC 6070) and HMAC-SHA256, the AES key wrap under 192 and
// 256-bit KEKs (RFC 3394, 4.2 and 4.3), what WebCrypto asks of them.
// Exits 13 when every check holds,
// else the number of the first check that failed.
const aes = @import("std.aes")
const base64 = @import("std.base64")
const hash = @import("std.crypto.hash")
const gcm = @import("std.crypto.gcm")
const chacha = @import("std.crypto.chacha")

const SUNSCREEN = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
const GCM_PLAIN = "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39"
const GCM_AAD = "feedfacedeadbeeffeedfacedeadbeefabaddad2"
const GCM_NONCE = "cafebabefacedbaddecaf888"

// Hex text into `out`: its byte count (0 for text that is not hex).
fn unhex(text: []const u8, out: [*]u8) -> usize {
    if !base64.hexDecode(text, out) { return 0 }
    return text.length / 2
}

fn isHex(bytes: [*]const u8, length: usize, hex: []const u8) -> bool {
    var text: [512]u8 = undefined
    const out: [*]u8 = &text
    if length * 2 != hex.length { return false }
    const count = base64.hexEncode(bytes[0..length], out)
    var index: usize = 0
    while index < count {
        if text[index] != hex[index] { return false }
        index += 1
    }
    return true
}

fn hmacIs(algorithm: hash.Algorithm, key: []const u8, message: []const u8, hex: []const u8) -> bool {
    var mac: [64]u8 = undefined
    const out: [*]u8 = &mac
    hash.hmac(algorithm, key, message, out)
    return isHex(out, hash.digestLength(algorithm), hex)
}

fn aesIs(keyHex: []const u8, hex: []const u8) -> bool {
    var key: [32]u8 = undefined
    const k: [*]u8 = &key
    const length = unhex(keyHex, k)
    var block: [16]u8 = undefined
    const b: [*]u8 = &block
    if unhex("00112233445566778899aabbccddeeff", b) != 16 { return false }
    var cipher: aes.Aes = undefined
    if !aes.aesInit(&cipher, k, length) { return false }
    aes.aesEncrypt(&cipher, b)
    if !isHex(b, 16, hex) { return false }
    // And back, four blocks at once as well as one.
    var four: [64]u8 = undefined
    const f: [*]u8 = &four
    var index: usize = 0
    while index < 64 {
        four[index] = block[index % 16]
        index += 1
    }
    aes.aesDecryptBlocks(&cipher, f, 4)
    aes.aesDecrypt(&cipher, b)
    aes.aesFinish(&cipher)
    index = 0
    while index < 64 {
        if four[index] != block[index % 16] { return false }
        index += 1
    }
    return isHex(b, 16, "00112233445566778899aabbccddeeff")
}

// Seals the plaintext with the key, compares ciphertext and tag, opens
// it again, and refuses it with a bit of the tag or the AAD changed.
fn gcmIs(keyHex: []const u8, nonceHex: []const u8, plainHex: []const u8, aadHex: []const u8, sealedHex: []const u8, tagHex: []const u8) -> bool {
    var key: [32]u8 = undefined
    var nonce: [12]u8 = undefined
    var plain: [64]u8 = undefined
    var aad: [32]u8 = undefined
    var sealed: [64]u8 = undefined
    var tag: [16]u8 = undefined
    var back: [64]u8 = undefined
    const k: [*]u8 = &key
    const n: [*]u8 = &nonce
    const p: [*]u8 = &plain
    const a: [*]u8 = &aad
    const s: [*]u8 = &sealed
    const t: [*]u8 = &tag
    const o: [*]u8 = &back
    const keyLength = unhex(keyHex, k)
    if unhex(nonceHex, n) != 12 { return false }
    const length = unhex(plainHex, p)
    const aadLength = unhex(aadHex, a)
    var aead: gcm.Gcm = undefined
    if !gcm.init(&aead, k, keyLength) { return false }
    gcm.seal(&aead, n, a[0..aadLength], p, length, s, t)
    if !isHex(s, length, sealedHex) || !isHex(t, 16, tagHex) { return false }
    if !gcm.open(&aead, n, a[0..aadLength], s, length, t, o) { return false }
    if !isHex(o, length, plainHex) { return false }
    tag[3] = tag[3] ^ 4
    if gcm.open(&aead, n, a[0..aadLength], s, length, t, o) { return false }
    tag[3] = tag[3] ^ 4
    if aadLength > 0 {
        aad[0] = aad[0] ^ 1
        if gcm.open(&aead, n, a[0..aadLength], s, length, t, o) { return false }
    }
    gcm.finish(&aead)
    return true
}

// sealIv and openIv with an IV of any length and a tag of `tagLength`.
fn gcmIvIs(keyHex: []const u8, ivHex: []const u8, sealedHex: []const u8, tagHex: []const u8, tagLength: usize) -> bool {
    var key: [32]u8 = undefined
    var iv: [64]u8 = undefined
    var plain: [64]u8 = undefined
    var aad: [32]u8 = undefined
    var sealed: [64]u8 = undefined
    var tag: [16]u8 = undefined
    var back: [64]u8 = undefined
    const k: [*]u8 = &key
    const v: [*]u8 = &iv
    const p: [*]u8 = &plain
    const a: [*]u8 = &aad
    const s: [*]u8 = &sealed
    const t: [*]u8 = &tag
    const o: [*]u8 = &back
    const keyLength = unhex(keyHex, k)
    const ivLength = unhex(ivHex, v)
    const length = unhex(GCM_PLAIN, p)
    const aadLength = unhex(GCM_AAD, a)
    var aead: gcm.Gcm = undefined
    if !gcm.init(&aead, k, keyLength) { return false }
    if !gcm.sealIv(&aead, v[0..ivLength], a[0..aadLength], p, length, s, t, tagLength) { return false }
    if !isHex(s, length, sealedHex) || !isHex(t, tagLength, tagHex) { return false }
    if !gcm.openIv(&aead, v[0..ivLength], a[0..aadLength], s, length, t, tagLength, o) { return false }
    if !isHex(o, length, GCM_PLAIN) { return false }
    tag[tagLength - 1] = tag[tagLength - 1] ^ 1
    if gcm.openIv(&aead, v[0..ivLength], a[0..aadLength], s, length, t, tagLength, o) { return false }
    gcm.finish(&aead)
    return true
}

fn pbkdf2Is(algorithm: hash.Algorithm, password: []const u8, salt: []const u8, rounds: u64, hex: []const u8) -> bool {
    var out: [64]u8 = undefined
    const bytes: [*]u8 = &out
    if !hash.pbkdf2(algorithm, password, salt, rounds, bytes, hex.length / 2) { return false }
    return isHex(bytes, hex.length / 2, hex)
}

fn wrapIs(kekHex: []const u8, plainHex: []const u8, wrappedHex: []const u8) -> bool {
    var kek: [32]u8 = undefined
    var plain: [32]u8 = undefined
    var wrapped: [40]u8 = undefined
    var back: [32]u8 = undefined
    const k: [*]u8 = &kek
    const p: [*]u8 = &plain
    const w: [*]u8 = &wrapped
    const b: [*]u8 = &back
    const kekLength = unhex(kekHex, k)
    const length = unhex(plainHex, p)
    if !aes.wrapWith(k, kekLength, p, length, w) || !isHex(w, length + 8, wrappedHex) { return false }
    if !aes.unwrapWith(k, kekLength, w, length + 8, b) || !isHex(b, length, plainHex) { return false }
    wrapped[5] = wrapped[5] ^ 1
    return !aes.unwrapWith(k, kekLength, w, length + 8, b)
}

pub fn main() -> u8 {
    // HMAC (RFC 4231).
    if !hmacIs(hash.Algorithm.sha384, "Jefe", "what do ya want for nothing?", "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649") { return 1 }
    if !hmacIs(hash.Algorithm.sha512, "Jefe", "what do ya want for nothing?", "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737") { return 2 }
    var long_key: [131]u8 = undefined
    var index: usize = 0
    while index < 131 {
        long_key[index] = 170
        index += 1
    }
    const big_key: [*]const u8 = &long_key
    if !hmacIs(hash.Algorithm.sha384, big_key[0..131], "Test Using Larger Than Block-Size Key - Hash Key First", "4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952") { return 3 }

    // HKDF (RFC 5869, A.1).
    var ikm: [22]u8 = undefined
    var salt: [13]u8 = undefined
    var info: [10]u8 = undefined
    index = 0
    while index < 22 {
        ikm[index] = 11
        if index < 13 { salt[index] = @intCast(u8, index) }
        if index < 10 { info[index] = @intCast(u8, 240 + index) }
        index += 1
    }
    const ikm_bytes: [*]const u8 = &ikm
    const salt_bytes: [*]const u8 = &salt
    const info_bytes: [*]const u8 = &info
    var prk: [32]u8 = undefined
    const prk_bytes: [*]u8 = &prk
    hash.hkdfExtract(hash.Algorithm.sha256, salt_bytes[0..13], ikm_bytes[0..22], prk_bytes)
    if !isHex(prk_bytes, 32, "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5") { return 4 }
    var okm: [42]u8 = undefined
    const okm_bytes: [*]u8 = &okm
    if !hash.hkdfExpand(hash.Algorithm.sha256, prk_bytes[0..32], info_bytes[0..10], okm_bytes, 42) { return 5 }
    if !isHex(okm_bytes, 42, "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865") { return 6 }

    // AES (FIPS 197, C.1 to C.3).
    if !aesIs("000102030405060708090a0b0c0d0e0f", "69c4e0d86a7b0430d8cdb78070b4c55a") { return 7 }
    if !aesIs("000102030405060708090a0b0c0d0e0f1011121314151617", "dda97ca4864cdfe06eaf70a0ec0d7191") { return 8 }
    if !aesIs("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "8ea2b7ca516745bfeafc49904b496089") { return 9 }

    // AES-GCM.
    if !gcmIs("00000000000000000000000000000000", "000000000000000000000000", "00000000000000000000000000000000", "", "0388dace60b6a392f328c2b971b2fe78", "ab6e47d42cec13bdf53a67b21257bddf") { return 10 }
    if !gcmIs("feffe9928665731c6d6a8f9467308308", GCM_NONCE, GCM_PLAIN, GCM_AAD, "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091", "5bc94fbc3221a5db94fae95ae7121a47") { return 11 }
    if !gcmIs("feffe9928665731c6d6a8f9467308308feffe9928665731c6d6a8f9467308308", GCM_NONCE, GCM_PLAIN, GCM_AAD, "522dc1f099567d07f47f37a32a84427d643a8cdcbfe5c0c97598a2bd2555d1aa8cb08e48590dbb3da7b08b1056828838c5f61e6393ba7a0abcc9f662", "76fc6ece0f4e1768cddf8853bb2d551b") { return 12 }
    if !gcmIs("feffe9928665731c6d6a8f9467308308feffe9928665731c", GCM_NONCE, GCM_PLAIN, GCM_AAD, "3980ca0b3c00e841eb06fac4872a2757859e1ceaa6efd984628593b40ca1e19c7d773d00c144c525ac619d18c84a3f4718e2448b2fe324d9ccda2710", "2519498e80f1478f37ba55bd6d27618c") { return 14 }

    // ChaCha20 (RFC 8439, 2.4.2).
    var key: [32]u8 = undefined
    var nonce: [12]u8 = undefined
    var text: [114]u8 = undefined
    var tag: [16]u8 = undefined
    var back: [114]u8 = undefined
    const k: [*]u8 = &key
    const n: [*]u8 = &nonce
    const t: [*]u8 = &text
    const g: [*]u8 = &tag
    const o: [*]u8 = &back
    index = 0
    while index < 32 {
        key[index] = @intCast(u8, index)
        index += 1
    }
    if unhex("000000000000004a00000000", n) != 12 { return 15 }
    chacha.chacha20(k, 1, n, SUNSCREEN.pointer, 114, t)
    if !isHex(t, 114, "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d") { return 16 }

    // Poly1305 (2.5.2), whole and in pieces.
    if unhex("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b", k) != 32 { return 17 }
    chacha.poly1305(k, "Cryptographic Forum Research Group", g)
    if !isHex(g, 16, "a8061dc1305136c6c22b8baf0c0127a9") { return 18 }
    var mac: chacha.Poly1305 = undefined
    chacha.polyInit(&mac, k)
    chacha.polyUpdate(&mac, "Cryptographic")
    chacha.polyUpdate(&mac, " Forum Research")
    chacha.polyUpdate(&mac, " Group")
    chacha.polyFinish(&mac, g)
    if !isHex(g, 16, "a8061dc1305136c6c22b8baf0c0127a9") { return 19 }

    // The AEAD (2.8.2).
    index = 0
    while index < 32 {
        key[index] = @intCast(u8, 128 + index)
        index += 1
    }
    if unhex("070000004041424344454647", n) != 12 { return 20 }
    var aad: [12]u8 = undefined
    const a: [*]u8 = &aad
    if unhex("50515253c0c1c2c3c4c5c6c7", a) != 12 { return 21 }
    chacha.seal(k, n, a[0..12], SUNSCREEN.pointer, 114, t, g)
    if !isHex(t, 114, "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116") { return 22 }
    if !isHex(g, 16, "1ae10b594f09e26a7e902ecbd0600691") { return 23 }
    if !chacha.open(k, n, a[0..12], t, 114, g, o) { return 24 }
    index = 0
    while index < 114 {
        if back[index] != SUNSCREEN[index] { return 25 }
        index += 1
    }
    text[113] = text[113] ^ 128
    if chacha.open(k, n, a[0..12], t, 114, g, o) { return 26 }

    // AES-GCM with other IVs (the GCM specification's cases 5 and 6) and
    // case 4's tag cut to 12 bytes.
    if !gcmIvIs("feffe9928665731c6d6a8f9467308308", "cafebabefacedbad", "61353b4c2806934a777ff51fa22a4755699b2a714fcdc6f83766e5f97b6c742373806900e49f24b22b097544d4896b424989b5e1ebac0f07c23f4598", "3612d2e79e3b0785561be14aaca2fccb", 16) { return 27 }
    if !gcmIvIs("feffe9928665731c6d6a8f9467308308", "9313225df88406e555909c5aff5269aa6a7a9538534f7da1e4c303d2a318a728c3c0c95156809539fcf0e2429a6b525416aedbf5a0de6a57a637b39b", "8ce24998625615b603a033aca13fb894be9112a5c3a211a8ba262a3cca7e2ca701e4a9a4fba43c90ccdcb281d48c7c6fd62875d2aca417034c34aee5", "619cc5aefffe0bfa462af43c1699d050", 16) { return 28 }
    if !gcmIvIs("feffe9928665731c6d6a8f9467308308", GCM_NONCE, "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091", "5bc94fbc3221a5db94fae95a", 12) { return 29 }

    // PBKDF2 (RFC 6070 for HMAC-SHA1).
    if !pbkdf2Is(hash.Algorithm.sha1, "password", "salt", 1, "0c60c80f961f0e71f3a9b524af6012062fe037a6") { return 30 }
    if !pbkdf2Is(hash.Algorithm.sha1, "password", "salt", 4096, "4b007901b765489abead49d926f721d065a429c1") { return 31 }
    if !pbkdf2Is(hash.Algorithm.sha1, "passwordPASSWORDpassword", "saltSALTsaltSALTsaltSALTsaltSALTsalt", 4096, "3d2eec4fe41c849b80c8d83662c0e44a8b291a964cf2f07038") { return 32 }
    if !pbkdf2Is(hash.Algorithm.sha256, "password", "salt", 1, "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b") { return 33 }
    if !pbkdf2Is(hash.Algorithm.sha256, "password", "salt", 4096, "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a") { return 34 }

    // The AES key wrap under 192 and 256-bit KEKs (RFC 3394, 4.2, 4.3).
    if !wrapIs("000102030405060708090a0b0c0d0e0f1011121314151617", "00112233445566778899aabbccddeeff", "96778b25ae6ca435f92b5b97c050aed2468ab8a17ad84e5d") { return 35 }
    if !wrapIs("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "00112233445566778899aabbccddeeff", "64e8c3f9ce0f5ba263e9777905818a2a93c8191e7d6e8ae7") { return 36 }
    if !wrapIs("000102030405060708090a0b0c0d0e0f", "00112233445566778899aabbccddeeff", "1fa68b0a8112b447aef34bd8fb5a7b829d3e862371d2cfe5") { return 37 }
    return 13
}
