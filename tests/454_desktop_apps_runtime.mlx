// The desktop's one notion of an app (projects/desktop/shared/apps.mlx
// and pins.mlx), on the host. tests/run_desktop_apps.sh makes the data
// directories this program is started with (XDG_DATA_DIRS, HOME): the
// repository's bundles Vector.app, Polaris.app and Control.app under
// apps/, and under applications/ the desktop entries of foreign software:
// org.gnome.Nautilus.desktop, firefox.desktop (StartupWMClass=Navigator,
// its icon in the hicolor theme), polaris.desktop, a second entry for
// polaris, and office-writer.desktop and office-calc.desktop, two apps
// of one program. A bundle made there, Marker.app (its app.ini with
// carriage returns, Id=org.example.marker), has a desktop entry of
// another program beside it that goes by its name: marker.desktop.
//
// - scan: the bundles and the foreign entries, sorted by name; the bundle
//   wins over the desktop entry for the same program, two desktop entries
//   that start one program both count;
// - find, the one way from a name to an entry: by the app id the program
//   gives its windows (Id= in app.ini: "org.mlx.files"; a desktop
//   entry's file name), by the entry's file name ("Polaris"), by its
//   StartupWMClass ("polaris", "Navigator"), by the last part of a
//   reverse-DNS id ("nautilus"), whatever the case, also with
//   ".desktop" at its end; nothing for a name no entry has;
// - findEntry: the app whose own entry a path is, where two entries
//   answer to one name; none for a file elsewhere;
// - nameFor: the entry's Name; "Terminal" for the Mlx terminal without an
//   entry; else the name asked with;
// - loadIcon and iconFileOf: a bundle's own icon.png, a theme's file for a
//   desktop entry, the same file at another size;
// - entryPath and entryFile: the bundle's directory and its app.ini, the
//   desktop entry file;
// - pins: "terminal" is the Mlx terminal's entry; a pin is found by the
//   app it stands for, whatever name it has it by, and unpinning an app
//   takes every pin of it; a dropped URI names a
//   bundle (its directory, or its app.ini) or a desktop entry; the pins
//   file is written with the folders above it (a home without .config)
//   and read back.
//
// Exits 13; another number says which check failed.
const std = @import("std")
const apps_module = @import("../projects/desktop/shared/apps.mlx")
const pins_module = @import("../projects/desktop/shared/pins.mlx")

const Apps = apps_module.Apps

fn nameIs(apps: *Apps, asked: []const u8, wanted: []const u8) -> bool {
    const found = apps_module.find(apps, asked)
    return found < apps.*.count && std.text.same(apps_module.nameOf(apps_module.appAt(apps, found)), wanted)
}

fn missing(apps: *Apps, asked: []const u8) -> bool {
    return apps_module.find(apps, asked) == apps.*.count
}

fn finds(apps: *Apps) -> u8 {
    // The ids the programs give their windows.
    if !nameIs(apps, "org.mlx.files", "Polaris") { return 20 }
    if !nameIs(apps, "org.mlx.settings", "Control") { return 21 }
    if !nameIs(apps, "org.mlx.terminal", "Vector") { return 22 }
    if !nameIs(apps, "org.gnome.Nautilus", "Files") { return 23 }
    if !nameIs(apps, "firefox", "Firefox") { return 24 }
    // The entries' file names and their programs (StartupWMClass).
    if !nameIs(apps, "Polaris", "Polaris") { return 25 }
    if !nameIs(apps, "polaris", "Polaris") { return 26 }
    if !nameIs(apps, "CONTROL", "Control") { return 27 }
    if !nameIs(apps, "vector", "Vector") { return 28 }
    if !nameIs(apps, "Navigator", "Firefox") { return 29 }
    // The last part of a reverse-DNS id.
    if !nameIs(apps, "nautilus", "Files") { return 30 }
    if !nameIs(apps, "terminal", "Vector") { return 31 }
    // No entry.
    if !missing(apps, "org.mlx.nothing") { return 32 }
    if !missing(apps, "") { return 33 }
    if !missing(apps, "org.mlx") { return 34 }
    // With the desktop entry's suffix (some windows, some pins).
    if !nameIs(apps, "firefox.desktop", "Firefox") { return 35 }
    if !nameIs(apps, "org.mlx.files.desktop", "Polaris") { return 36 }
    if !missing(apps, "nothing.desktop") || !missing(apps, ".desktop") { return 37 }
    // An app.ini with carriage returns: its Id= is the id all the same.
    if !nameIs(apps, "org.example.marker", "Marker") { return 38 }
    // Two entries answer to "marker": the desktop entry by its id, before
    // the bundle by its file name.
    if !nameIs(apps, "marker", "Marker Pen") { return 39 }
    return 0
}

// The app whose own entry is at DATA`rest` (count: none).
fn entryAt(apps: *Apps, data: [*]const u8, rest: []const u8) -> usize {
    var path: apps_module.Path = undefined
    apps_module.pathClear(&path)
    apps_module.pathAddC(&path, data)
    apps_module.pathAdd(&path, rest)
    return apps_module.findEntry(apps, path.bytes[0..path.length])
}

fn dropped(apps: *Apps, data: [*]const u8) -> u8 {
    const bundle = apps_module.find(apps, "org.example.marker")
    const pen = apps_module.find(apps, "marker")
    if bundle == pen || bundle == apps.*.count || pen == apps.*.count { return 90 }
    // The bundle's directory (as the launcher drags it), with a slash at
    // its end, its app.ini; the desktop entry's file.
    if entryAt(apps, data, "/apps/Marker.app") != bundle { return 91 }
    if entryAt(apps, data, "/apps/Marker.app/") != bundle { return 92 }
    if entryAt(apps, data, "/apps/Marker.app/app.ini") != bundle { return 93 }
    if entryAt(apps, data, "/applications/marker.desktop") != pen { return 94 }
    if entryAt(apps, data, "/applications/firefox.desktop") != apps_module.find(apps, "firefox") { return 95 }
    // Not an app's entry: a file elsewhere with such a name, the wrong
    // kind of entry for the name, a folder of the data directory.
    var elsewhere: apps_module.Path = undefined
    apps_module.pathClear(&elsewhere)
    apps_module.pathAdd(&elsewhere, "/elsewhere/Marker.app")
    if apps_module.findEntry(apps, elsewhere.bytes[0..elsewhere.length]) != apps.*.count { return 96 }
    if entryAt(apps, data, "/applications/Marker.app") != apps.*.count { return 97 }
    if entryAt(apps, data, "/apps") != apps.*.count || entryAt(apps, data, "") != apps.*.count { return 98 }
    return 0
}

fn names(apps: *Apps, empty: *Apps) -> u8 {
    if !std.text.same(apps_module.nameFor(apps, "org.mlx.files"), "Polaris") { return 40 }
    if !std.text.same(apps_module.nameFor(apps, "org.mlx.terminal"), "Vector") { return 41 }
    if !std.text.same(apps_module.nameFor(apps, "org.other.App"), "org.other.App") { return 42 }
    if !std.text.same(apps_module.nameFor(empty, "org.mlx.terminal"), "Terminal") { return 43 }
    if !std.text.same(apps_module.nameFor(empty, "org.mlx.files"), "org.mlx.files") { return 44 }
    return 0
}

fn icons(apps: *Apps) -> u8 {
    const polaris = apps_module.appAt(apps, apps_module.find(apps, "org.mlx.files"))
    if apps_module.iconFileOf(polaris).length != 0 { return 50 }
    if !apps_module.loadIcon(apps, polaris, 48) { return 51 }
    if !std.text.endsWith(apps_module.iconFileOf(polaris), "/apps/Polaris.app/icon.png") { return 52 }
    if apps_module.imageOf(polaris).*.width != 48 { return 53 }
    // The same file for another asker's size (a dock's, a launcher's).
    if !apps_module.loadIcon(apps, polaris, 76) || apps_module.imageOf(polaris).*.width != 76 { return 54 }
    if !std.text.endsWith(apps_module.iconFileOf(polaris), "/apps/Polaris.app/icon.png") { return 55 }
    const firefox = apps_module.appAt(apps, apps_module.find(apps, "firefox"))
    if !apps_module.loadIcon(apps, firefox, 56) { return 56 }
    if !std.text.endsWith(apps_module.iconFileOf(firefox), "/icons/hicolor/64x64/apps/firefox.png") { return 57 }
    if !apps_module.loadIcon(apps, firefox, 76) || apps_module.imageOf(firefox).*.width != 76 { return 58 }
    // An entry whose icon no file has: none.
    const nautilus = apps_module.appAt(apps, apps_module.find(apps, "nautilus"))
    if apps_module.loadIcon(apps, nautilus, 48) || apps_module.iconFileOf(nautilus).length != 0 { return 59 }
    return 0
}

fn entries(apps: *Apps) -> u8 {
    var path: apps_module.Path = undefined
    const polaris = apps_module.appAt(apps, apps_module.find(apps, "polaris"))
    if !apps_module.entryPath(apps, polaris, &path) || !std.text.endsWith(path.bytes[0..path.length], "/apps/Polaris.app") { return 60 }
    if !apps_module.entryFile(apps, polaris, &path) || !std.text.endsWith(path.bytes[0..path.length], "/apps/Polaris.app/app.ini") { return 61 }
    const firefox = apps_module.appAt(apps, apps_module.find(apps, "firefox"))
    if !apps_module.entryPath(apps, firefox, &path) || !std.text.endsWith(path.bytes[0..path.length], "/applications/firefox.desktop") { return 62 }
    if !apps_module.entryFile(apps, firefox, &path) || !std.text.endsWith(path.bytes[0..path.length], "/applications/firefox.desktop") { return 63 }
    return 0
}

fn pinned(apps: *Apps, environment: [*][*]const u8, allocator: std.allocator.Allocator) -> u8 {
    const polaris = apps_module.find(apps, "org.mlx.files")
    const vector = apps_module.find(apps, "org.mlx.terminal")
    const control = apps_module.find(apps, "org.mlx.settings")
    if pins_module.appOf(apps, "terminal") != vector { return 70 }
    if pins_module.appOf(apps, "Polaris") != polaris || pins_module.appOf(apps, "org.mlx.files") != polaris { return 71 }
    if pins_module.appOf(apps, "gone") != apps.*.count { return 72 }
    // A pins file from before the ids ("terminal", the bundle's name).
    var pins: pins_module.Pins = undefined
    pins.count = 0
    pins_module.insert(&pins, "terminal", 0)
    pins_module.insert(&pins, "Polaris", 1)
    if pins_module.findApp(&pins, apps, vector) != 0 || pins_module.findApp(&pins, apps, polaris) != 1 { return 73 }
    if pins_module.findApp(&pins, apps, control) != pins.count { return 74 }
    // Unpinning takes every pin of the app: such a file may name the
    // terminal twice ("terminal" by the dock, "Vector" by the launcher).
    var old: pins_module.Pins = undefined
    old.count = 0
    pins_module.insert(&old, "terminal", 0)
    pins_module.insert(&old, "Vector", 1)
    pins_module.insert(&old, "Polaris", 2)
    pins_module.insert(&old, "org.mlx.terminal", 3)
    pins_module.removeApp(&old, apps, vector)
    if old.count != 1 || !std.text.same(pins_module.idAt(&old, 0), "Polaris") { return 85 }
    pins_module.removeApp(&old, apps, control)
    if old.count != 1 { return 86 }
    pins_module.removeApp(&old, apps, polaris)
    if old.count != 0 { return 87 }
    // What a drop names.
    if !std.text.same(pins_module.idFromUri("file:///system/share/apps/Polaris.app\r\n"), "Polaris") { return 75 }
    if !std.text.same(pins_module.idFromUri("file:///system/share/apps/Polaris.app/\r\n"), "Polaris") { return 76 }
    if !std.text.same(pins_module.idFromUri("file:///system/share/apps/Polaris.app/app.ini"), "Polaris") { return 77 }
    if !std.text.same(pins_module.idFromUri("file:///usr/share/applications/firefox.desktop\r\n"), "firefox") { return 78 }
    if pins_module.idFromUri("file:///users/brix/notes.txt\r\n").length != 0 { return 79 }
    if pins_module.idFromUri("").length != 0 { return 80 }
    // Written where the user's settings are, the folders made; read back.
    pins_module.insert(&pins, apps_module.idOf(apps_module.appAt(apps, control)), pins.count)
    if !pins_module.write(environment, pins_module.APPS, &pins) { return 81 }
    var again: pins_module.Pins = undefined
    if !pins_module.read(environment, pins_module.APPS, allocator, &again) || again.count != 3 { return 82 }
    if !std.text.same(pins_module.idAt(&again, 2), "org.mlx.settings") { return 83 }
    if pins_module.findApp(&again, apps, control) != 2 { return 84 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.heap.allocator()
    const environment = std.process.environmentEntries(arguments)
    var apps: Apps = undefined
    if !apps_module.init(&apps, environment, allocator) { return 1 }
    apps_module.scan(&apps)
    // Control, Files, Firefox, Marker, Marker Pen, Office Calc, Office
    // Writer, Polaris, Vector: polaris.desktop is the bundle's program
    // again and does not count; the two desktop entries of the program
    // office both do.
    if apps.count != 9 { return 10 }
    if !std.text.same(apps_module.nameOf(apps_module.appAt(&apps, 0)), "Control") { return 11 }
    if !std.text.same(apps_module.nameOf(apps_module.appAt(&apps, 8)), "Vector") { return 12 }
    if !std.text.same(apps_module.idOf(apps_module.appAt(&apps, 7)), "org.mlx.files") { return 13 }
    if !std.text.same(apps_module.fileOf(apps_module.appAt(&apps, 7)), "Polaris") { return 14 }
    if !std.text.same(apps_module.nameOf(apps_module.appAt(&apps, 5)), "Office Calc") || !std.text.same(apps_module.nameOf(apps_module.appAt(&apps, 6)), "Office Writer") { return 16 }
    // No apps at all: a data directory that is not there.
    var nowhere: [3][*]const u8 = undefined
    unsafe {
        nowhere[0] = @ptrCast([*]const u8, "HOME=/nonexistent/home")
        nowhere[1] = @ptrCast([*]const u8, "XDG_DATA_DIRS=/nonexistent/share")
        nowhere[2] = @ptrFromInt([*]const u8, 0)
    }
    var empty: Apps = undefined
    if !apps_module.init(&empty, &nowhere, allocator) { return 2 }
    apps_module.scan(&empty)
    if empty.count != 0 { return 15 }

    var result = finds(&apps)
    if result != 0 { return result }
    result = names(&apps, &empty)
    if result != 0 { return result }
    result = icons(&apps)
    if result != 0 { return result }
    result = entries(&apps)
    if result != 0 { return result }
    result = dropped(&apps, apps_module.environmentValue(environment, "XDG_DATA_DIRS"))
    if result != 0 { return result }
    result = pinned(&apps, environment, allocator)
    if result != 0 { return result }
    return 13
}
