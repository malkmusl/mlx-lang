// The kernel's stage 3 toward a Radeon that takes commands (projects/brix/
// kernel/gpu_smc_sdma.mlx's steps F1 and F2, built for the host), against
// the user's RX 580 as a table whose SMC answers as the study expects
// (tests/support/smc_card.mlx on the card of tests 493 and 494), with the
// study's steps (gpu-accel-kernel.verified.md 3.3, 3.4, 8.4 F1 and F2,
// 8.7) written out here a second time, write for write:
// - the digits 3 and 4 and the line that says them;
// - F1: polaris10_start_smu in protected mode in its order (the reset,
//   the upload of polaris10_k_smc.bin's 32497 words by the index's auto
//   increment, the status cleared, the clock, the release, the ROM's
//   interrupts, the start's trigger PPSMC_MSG_Test with 0x20000 whose
//   answer is said and not judged, done and passed, the flags cleared,
//   reset and release, the firmware's flag), the self-test (the clock,
//   the program counter in RAM and moving, the flag, the version word the
//   uploaded payload's word 5, 0x02171100, not the file header's
//   0x00171100); the start without protection (the jump word at 0); an
//   SMC found running: nothing uploaded, no trigger sent; every refusal
//   (the file, its start address, the mark of 85 C) with nothing written;
//   every failure (the image refused, no end, no flag, a counter that
//   stands, another version word, the picture, the card gone) with the SMC
//   held in reset; a ROM that does not say its interrupts (said, gone on);
// - F2: the copies at Linux's places in the system's memory the GART maps,
//   the list (nine entries) word for word in the card's memory, the five
//   messages with their parameters in Linux's order, the load status, what
//   the SMC left of the engines and the engines halted again as Linux's
//   stop leaves them (the RLC's serial buses waited for per shader
//   engine), the copy engines too at stage 3; every refusal (a file, the
//   ROM's GFX_Info, the soft registers' place, no room, the mark); every
//   failure (an answer that is not 1 to each message, no answer, a part
//   loaded, nothing loaded with the AVFS fuse and without, an image the
//   SMC cannot read through the GART, a fault, the picture, the card
//   gone) with the engines halted again; a warm start (the SMC found
//   running loads again);
// - the stages: 3 runs F1 and F2 and no copy engine; 2 runs neither; the
//   way down at stage 3;
// - firmware files cut short as S0 reads them, an SMC found running the
//   other key's firmware, a failed F2 at a boot beyond stage 4;
// - through all of it no register of the display's is written.
// With an argument the log of every case is printed.
// Exits 13.
const std = @import("std")
const engines = @import("../projects/brix/kernel/gpu_engines.mlx")
const loaded = @import("../projects/brix/kernel/gpu_smc_sdma.mlx")
const stages = @import("../projects/brix/engine_choice.mlx")
const choice = @import("../projects/brix/display_choice.mlx")
const card = @import("./support/engine_card.mlx")
const smc = @import("./support/smc_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

// A number said in hexadecimal.
fn hex(value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(text[0..2 + digits])
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

fn shown() -> void {
    if show {
        say(card.log[0..card.logged])
        say("--\n")
    }
}

const N = card.NEVER
const MIB: usize = 1024 * 1024
const LIMIT: usize = 192 * MIB
const BASE: usize = 0xF400000000
const GART: usize = 0xFF00000000

var e: engines.Engines = undefined
var l: loaded.Loaded = undefined
var where: engines.Card = undefined

// The card anew as the user's, the kernel's small picture at the
// aperture's start, stages 0 to 2 run (the boot's `stage` asked); whether
// stage 2 passed.
fn fresh(stage: usize) -> bool { return freshCut(stage, N) }

// The same with a firmware file cut short (`short`: its index among the
// files loaded below; N: none) as S0 reads it.
fn freshCut(stage: usize, short: usize) -> bool {
    smc.reset()
    card.fileShort = short
    card.picture(0, 1280, 960, 1800, 1000)
    where = engines.Card.{ .device = 0x67DF, .revision = 0xE7, .view = card.VIEW, .pictureOffset = card.pictureOffset, .pictureBytes = card.pictureWidth * card.pictureHeight * 4, .dmaBase = card.DMA_BASE, .dmaPages = 2048, .rom = &card.machine }
    const hands = smc.hands()
    engines.begin(&e, &hands, &where, stage)
    const more = smc.more()
    loaded.begin(&l, &more)
    engines.run(&e)
    return e.i1 == engines.Outcome.passed
}

// ---- The writes a step is wanted to make, written out from the study.

const WANT: usize = 256
var wantNumber: [WANT]usize = undefined
var wantValue: [WANT]usize = undefined
var wanted: usize = 0

fn want(number: usize, value: usize) -> void {
    wantNumber[wanted] = number
    wantValue[wanted] = value
    wanted += 1
}

// A word of the SMC's read (its index written), written (index, data),
// a field of one written (read: the index; written: the index, the data).
fn wantRead(address: usize) -> void { want(engines.SMC_IND_INDEX_11, address) }

fn wantWrite(address: usize, value: usize) -> void {
    want(engines.SMC_IND_INDEX_11, address)
    want(engines.SMC_IND_DATA_11, value)
}

fn wantField(address: usize, value: usize) -> void {
    want(engines.SMC_IND_INDEX_11, address)
    wantWrite(address, value)
}

// A message with its parameter (smu7_send_msg_to_smc_with_parameter).
fn wantMessage(number: usize, parameter: usize) -> void {
    want(loaded.SMC_MSG_ARG_0, parameter)
    want(loaded.SMC_RESP_0, 0)
    want(loaded.SMC_MESSAGE_0, number)
}

// The temperature read before a step and the index put back; after it
// the same and the scratch register's trial (gpu_engines.mlx's alive).
fn wantCool() -> void {
    wantRead(engines.ixCG_MULT_THERMAL_STATUS)
    want(engines.SMC_IND_INDEX_11, 0)
}

fn wantAlive() -> void {
    want(engines.SCRATCH_REG0, engines.SCRATCH_TRIAL)
    want(engines.SCRATCH_REG0, 0)
}

// Whether the writes from `from` on are the wanted ones; the first that
// differs said.
fn writesAre(from: usize, what: []const u8) -> bool {
    const at = card.writesFrom(from, wantNumber[0..wanted], wantValue[0..wanted])
    if at == N { return true }
    say("the writes of ")
    say(what)
    say(" differ from the study's at write ")
    hex(at)
    if at < wanted {
        say(": wanted register ")
        hex(wantNumber[at])
        say(" = ")
        hex(wantValue[at])
    }
    if from + at < card.written && from + at < card.WRITES {
        say(", written register ")
        hex(card.writtenTo[from + at])
        say(" = ")
        hex(card.writtenWith[from + at])
    }
    say("\n")
    return false
}

fn payload(name: []const u8) -> []const u8 {
    const bytes = card.file(name)
    const size = le(bytes, 20)
    const at = le(bytes, 24)
    return bytes[at..at + size]
}

fn le(bytes: []const u8, at: usize) -> usize { return @intCast(usize, bytes[at]) | (@intCast(usize, bytes[at + 1]) << 8) | (@intCast(usize, bytes[at + 2]) << 16) | (@intCast(usize, bytes[at + 3]) << 24) }

// ---- The digits 3 and 4.

var collected: [512]u8 = undefined
var collectedLength: usize = 0

fn collect(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length && collectedLength < collected.length {
        collected[collectedLength] = text[k]
        collectedLength += 1
        k += 1
    }
}

fn stageLine(d: *const stages.Decision, text: []const u8) -> void {
    collectedLength = 0
    stages.say(collect, d, true)
    expect(same(collected[0..collectedLength], text), text)
}

fn theDigits() -> void {
    expect(stages.BUILT == 4, "the kernel has the stages up to 4")
    const looked = choice.Word.LOOKED
    var d = stages.decide(stages.Word.of(51), looked, choice.Choice.native)
    expect(d.stage == 3 && !d.beyond, "3: stage 3")
    stageLine(&d, "gpu: this boot: the card's engines up to stage 3, the SMC's firmware and the engines' firmware (3 was pressed at this start and holds for this boot only)\n")
    d = stages.decide(stages.Word.of(52), looked, choice.Choice.native)
    expect(d.stage == 4 && !d.beyond, "4: stage 4")
    stageLine(&d, "gpu: this boot: the card's engines up to stage 4, the two copy engines (4 was pressed at this start and holds for this boot only)\n")
    d = stages.decide(stages.Word.of(55), looked, choice.Choice.native)
    expect(d.stage == 4 && d.beyond, "7: as far as 4")
    stageLine(&d, "gpu: this boot: the card's engines up to stage 4, the two copy engines (7 was pressed at this start; this kernel has the stages up to 4)\n")
    d = stages.decide(stages.Word.of(52), looked, choice.Choice.firmware)
    expect(d.stage == 0 && d.firmware, "4 with F: stage 0")
    d = stages.decide(stages.Word.LOOKED, looked, choice.Choice.native)
    stageLine(&d, "gpu: this boot: the card's engines are only read, stage 0 (no digit was pressed; 1 to 4 held while the machine starts goes further)\n")
}

// ---- F1.

// F1's writes in protected mode as polaris10_start_smu_in_protection_mode
// makes them (the study's 3.3, steps 1 to 10), the self-test's reads
// after them.
fn wantProtectedStart() -> void {
    wantRead(engines.ixSMC_SYSCON_CLOCK_CNTL_0)
    wantRead(engines.ixSMC_PC_C)
    wantRead(engines.ixSMU_FIRMWARE)
    wantRead(engines.ixSMU_FIRMWARE)
    wantField(engines.ixSMC_SYSCON_RESET_CNTL, 1)
    want(engines.SMC_IND_INDEX_11, 0x20000)
    want(loaded.SMC_IND_ACCESS_CNTL, 0x800)
    want(loaded.SMC_IND_ACCESS_CNTL, 0)
    wantWrite(engines.ixSMU_STATUS, 0)
    wantField(engines.ixSMC_SYSCON_CLOCK_CNTL_0, 0)
    wantField(engines.ixSMC_SYSCON_RESET_CNTL, 0)
    wantRead(engines.ixRCU_UC_EVENTS)
    wantMessage(0x100, 0x20000)
    wantRead(engines.ixSMU_STATUS)
    wantRead(engines.ixSMU_STATUS)
    wantWrite(engines.ixFIRMWARE_FLAGS, 0)
    wantField(engines.ixSMC_SYSCON_RESET_CNTL, 1)
    wantField(engines.ixSMC_SYSCON_RESET_CNTL, 0)
    wantRead(engines.ixFIRMWARE_FLAGS)
}

fn wantSelfTest() -> void {
    wantRead(engines.ixSMC_SYSCON_CLOCK_CNTL_0)
    wantRead(engines.ixSMC_PC_C)
    wantRead(engines.ixSMC_PC_C)
    wantRead(engines.ixFIRMWARE_FLAGS)
    want(engines.SMC_IND_INDEX_11, 0x20014)
    want(loaded.SMC_IND_ACCESS_CNTL, 0)
}

// The SMC's RAM holds the payload of `name` word for word.
fn ramHolds(name: []const u8) -> bool {
    const bytes = payload(name)
    var k: usize = 0
    while k < bytes.length / 4 {
        if smc.ramWord(0x20000 + 4 * k) != le(bytes, 4 * k) && !(0x20000 + 4 * k == engines.ixFIRMWARE_FLAGS) { return false }
        k += 1
    }
    return true
}

fn held() -> bool { return card.smcGet(engines.ixSMC_SYSCON_RESET_CNTL) & 1 == 1 && smc.smc == smc.Smc.held }

fn theStart() -> void {
    expect(fresh(3), "stages 0 to 2 on the user's card")
    const from = card.written
    expect(loaded.smcFirmware(&e, &l), "F1 on the user's card")
    shown()
    wanted = 0
    wantCool()
    wantProtectedStart()
    wantSelfTest()
    wantCool()
    wantAlive()
    expect(writesAre(from, "F1"), "F1 write for write as polaris10_start_smu_in_protection_mode")
    expect(smc.ramWrites == 32497 && ramHolds("polaris10_k_smc.bin"), "the payload of polaris10_k_smc.bin uploaded word for word, 32497 words")
    expect(smc.smc == smc.Smc.running && smc.askedCount == 1 && smc.asked[0] == 0x100 && smc.askedWith[0] == 0x20000, "the SMC runs; the one message the start's trigger")
    expect(l.versionWord == 0x02171100 && l.headerVersion == 0x00171100, "the version word is the payload's word 5, not the header's")
    line("gpu: the start's trigger (message 0x100 with 0x20000) answered 0x1; the SMC had answered nothing before it (1 s waited for that, twice, as Linux waits)\n")
    line("gpu: step F1: SMC firmware polaris10_k_smc.bin uploaded (32497 words, protected mode), start passed (status 0x3, trigger answered 0x1), interrupts enabled; program counter 0x20a40 then 0x20a54, version word in RAM 0x2171100 as uploaded (the file's header says 0x171100); 41 C before, 41 C after; picture ")
    line(" before and after, same sum (")
    expect(card.displayWrites(0) == 0, "F1 writes nothing of the display's")

    // An answer the SMC had given before: no second waited.
    expect(fresh(3), "S0 to I1")
    card.registers[loaded.SMC_RESP_0] = 1
    expect(loaded.smcFirmware(&e, &l), "F1 with an earlier answer")
    line("gpu: the start's trigger (message 0x100 with 0x20000) answered 0x1\n")
    noLine("the SMC had answered nothing before it")

    // The start's trigger answered "not known" (0xfe): said, not judged,
    // as Linux does not look at it; the start is judged by done and passed.
    expect(fresh(3), "S0 to I1")
    smc.triggerAnswer = 0xFE
    expect(loaded.smcFirmware(&e, &l), "a trigger answered 0xfe: F1 passes")
    line("gpu: the start's trigger (message 0x100 with 0x20000) answered 0xfe;")
    line("start passed (status 0x3, trigger answered 0xfe)")

    // The ROM does not say its interrupts are on: said, gone on.
    expect(fresh(3), "S0 to I1")
    smc.romSilent = true
    expect(loaded.smcFirmware(&e, &l), "a ROM that does not say its interrupts: F1 goes on and passes")
    line("gpu: the SMC's ROM did not say its interrupts are on within 1 s (events 0x80): Linux goes on, so does the step\n")
}

fn theUnprotected() -> void {
    expect(fresh(3), "S0 to I1")
    card.smcSet(engines.ixSMU_FIRMWARE, engines.SMU_FIRMWARE__SMU_SEL)
    const from = card.written
    expect(loaded.smcFirmware(&e, &l), "F1 without protection")
    shown()
    // polaris10_start_smu_in_non_protection_mode, in its order.
    wanted = 0
    wantCool()
    wantRead(engines.ixSMC_SYSCON_CLOCK_CNTL_0)
    wantRead(engines.ixSMC_PC_C)
    wantRead(engines.ixSMU_FIRMWARE)
    wantRead(engines.ixSMU_FIRMWARE)
    wantRead(engines.ixRCU_UC_EVENTS)
    wantWrite(engines.ixFIRMWARE_FLAGS, 0)
    wantField(engines.ixSMC_SYSCON_RESET_CNTL, 1)
    want(engines.SMC_IND_INDEX_11, 0x20000)
    want(loaded.SMC_IND_ACCESS_CNTL, 0x800)
    want(loaded.SMC_IND_ACCESS_CNTL, 0)
    want(engines.SMC_IND_INDEX_11, 0)
    want(loaded.SMC_IND_ACCESS_CNTL, 0)
    want(engines.SMC_IND_DATA_11, 0xE0008040)
    wantField(engines.ixSMC_SYSCON_CLOCK_CNTL_0, 0)
    wantField(engines.ixSMC_SYSCON_RESET_CNTL, 0)
    wantRead(engines.ixFIRMWARE_FLAGS)
    wantSelfTest()
    wantCool()
    wantAlive()
    expect(writesAre(from, "F1 without protection"), "F1 without protection write for write")
    expect(smc.askedCount == 0, "no message without protection")
    line("gpu: step F1: SMC firmware polaris10_k_smc.bin uploaded (32497 words, not protected), started from the jump word at 0, interrupts enabled; program counter 0x20a40 then 0x20a54, version word in RAM 0x2171100 as uploaded")
    expect(card.smcGet(0) == 0xE0008040, "the jump word at the SMC's address 0")
}

fn theFoundRunning() -> void {
    smc.reset()
    smc.smcRunning()
    card.picture(0, 1280, 960, 1800, 1000)
    where = engines.Card.{ .device = 0x67DF, .revision = 0xE7, .view = card.VIEW, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .dmaBase = card.DMA_BASE, .dmaPages = 2048, .rom = &card.machine }
    const hands = smc.hands()
    engines.begin(&e, &hands, &where, 3)
    const more = smc.more()
    loaded.begin(&l, &more)
    engines.run(&e)
    expect(e.i1 == engines.Outcome.passed, "S0 to I1 with the SMC running")
    line("SMC firmware running: all halted now")
    const from = card.written
    expect(loaded.smcFirmware(&e, &l), "F1 with the SMC found running")
    shown()
    wanted = 0
    wantCool()
    wantRead(engines.ixSMC_SYSCON_CLOCK_CNTL_0)
    wantRead(engines.ixSMC_PC_C)
    wantSelfTest()
    wantCool()
    wantAlive()
    expect(writesAre(from, "F1 found running"), "F1 found running: nothing uploaded, nothing written but index words")
    expect(smc.ramWrites == 0 && smc.askedCount == 0, "no upload, no trigger sent to a running SMC")
    line("gpu: step F1: the SMC runs firmware already (found running): nothing uploaded, no trigger sent; program counter ")
    line(", version word in RAM 0x2171100 (the same as polaris10_k_smc.bin's 0x2171100)")
    // A warm start: the SMC found running loads the engines' firmware
    // again (the study's card 26).
    expect(loaded.engineFirmware(&e, &l), "F2 with the SMC found running")
    line("gpu: step F2: the SMC loaded RLC 0x11e,")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn theRefusals() -> void {
    // The SMC's file: missing (S0 says it; F1 refused before a write).
    expect(fresh(3), "S0 to I1 with the SMC's file missing")
    card.fileMissing = 7
    e.found.files[engines.FILES.length].holds = engines.Holds.missing
    var at = card.written
    expect(!loaded.smcFirmware(&e, &l) && l.f1 == engines.Outcome.refused && card.written == at, "no SMC file: refused, nothing written")
    line("gpu: step F1 refused: the SMC's firmware file polaris10_k_smc.bin does not hold (step S0 says why)\n")
    card.fileMissing = N
    // Made for another place in the SMC's RAM.
    expect(fresh(3), "S0 to I1")
    var copy: [140000]u8 = undefined
    const original = card.fileBytes[7]
    var k: usize = 0
    while k < original.length {
        copy[k] = original[k]
        k += 1
    }
    copy[34] = 3
    card.fileBytes[7] = copy[0..original.length]
    at = card.written
    expect(!loaded.smcFirmware(&e, &l) && card.written == at, "another start address: refused")
    line("gpu: step F1 refused: polaris10_k_smc.bin is made for the SMC's address 0x30000, Linux puts it at 0x20000\n")
    card.fileBytes[7] = original
    // The mark: 85 C.
    expect(fresh(3), "S0 to I1")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 85 << 9)
    at = card.written
    expect(!loaded.smcFirmware(&e, &l) && l.f1 == engines.Outcome.refused, "85 C: refused")
    wanted = 0
    wantCool()
    expect(writesAre(at, "F1 at 85 C"), "at the mark only the temperature is read")
    line("gpu: step F1 refused: the card is at 85 C (no step begins at 85 C or more)\n")
    expect(fresh(3), "S0 to I1")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 84 << 9)
    expect(loaded.smcFirmware(&e, &l), "84 C: F1 runs")
    line("; 84 C before, 84 C after;")
}

// A failure of F1: the SMC held in reset afterwards, the line.
fn failsWith(text: []const u8, what: []const u8) -> void {
    const passed = loaded.smcFirmware(&e, &l)
    shown()
    expect(!passed && l.f1 == engines.Outcome.failed, what)
    expect(held(), "the SMC held in reset after a failed F1")
    line(text)
    line("; the SMC is held in reset; 41 C before")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn theFailures() -> void {
    expect(fresh(3), "S0 to I1")
    smc.refuse = true
    failsWith("gpu: step F1 failed: the card did not take the image (status 0x1)", "the image refused")
    expect(fresh(3), "S0 to I1")
    smc.neverDone = true
    failsWith("gpu: step F1 failed: the SMC did not end its start within 1 s (status 0x0)", "no end of the start")
    expect(fresh(3), "S0 to I1")
    smc.noFlags = true
    failsWith("gpu: step F1 failed: the firmware did not say its interrupts are on within 1 s (flags 0x0)", "no flag")
    expect(fresh(3), "S0 to I1")
    smc.stuckCounter = true
    failsWith("gpu: step F1 failed: the SMC's program counter does not move (0x20a40)", "a counter that stands")
    expect(fresh(3), "S0 to I1")
    smc.otherVersion = true
    failsWith("gpu: step F1 failed: the version word in the SMC's RAM is not the uploaded one (0x2171000)", "another version word")
    expect(fresh(3), "S0 to I1")
    card.scribbleAt = loaded.SMC_MESSAGE_0
    failsWith("gpu: step F1 failed: the picture's memory changed (sum ", "the picture minds")
    expect(fresh(3), "S0 to I1")
    card.goneAt = loaded.SMC_MESSAGE_0
    const passed = loaded.smcFirmware(&e, &l)
    expect(!passed && l.f1 == engines.Outcome.failed, "the card gone: F1 fails")
    line("gpu: step F1 failed: the card no longer answers as it did; the SMC is held in reset")
}

// ---- F2.

// Where the study's 3.4 puts each copy from the copies' start, by
// FILES' index (pfp, me, ce, mec, rlc, sdma, sdma1), and MEC's jump table.
const PLACES = [_]usize{ 0xB000, 0x10000, 0x8000, 0x15000, 0x98000, 0x0, 0x4000 }
const JUMP_TABLE: usize = 0x56000

fn copiesHold() -> bool {
    var k: usize = 0
    while k < engines.FILES.length {
        const bytes = payload(engines.FILES[k])
        var n: usize = 0
        while n < bytes.length {
            if @intCast(usize, card.memoryRead(l.copies + PLACES[k] + n)) != le(bytes, n) { return false }
            n += 4
        }
        k += 1
    }
    const mec = card.file(engines.FILES[engines.MEC_FILE])
    const first = le(mec, 36) * 4
    var n: usize = 0
    while n < le(mec, 40) * 4 {
        if @intCast(usize, card.memoryRead(l.copies + JUMP_TABLE + n)) != le(payload(engines.FILES[engines.MEC_FILE]), first + n) { return false }
        n += 4
    }
    return true
}

// The list in the card's memory, word for word as the study's 3.4 has it.
fn listHolds() -> bool {
    const at = card.vram + LIMIT + 0x81000
    const words = [_]usize{ 1, 9 }
    if @intCast(usize, word32(at)) != words[0] || @intCast(usize, word32(at + 4)) != words[1] { return false }
    // id, the file (FILES' index), the place, the size's kind (0 payload,
    // 1 MEC without its jump table, 2 the jump table), the flag.
    const ids = [_]usize{ 10, 3, 4, 5, 6, 7, 8, 1, 2 }
    const files = [_]usize{ 4, 2, 0, 1, 3, 3, 3, 5, 6 }
    const kinds = [_]usize{ 0, 0, 0, 0, 1, 2, 2, 0, 0 }
    const flags = [_]usize{ 1, 0, 0, 0, 1, 0, 0, 0, 0 }
    var k: usize = 0
    while k < 9 {
        const entry = at + 8 + k * 28
        const bytes = card.file(engines.FILES[files[k]])
        var address = GART + l.copies - card.DMA_BASE + PLACES[files[k]]
        var size = le(bytes, 20)
        if kinds[k] == 1 { size = le(bytes, 36) * 4 }
        if kinds[k] == 2 {
            address = GART + l.copies - card.DMA_BASE + JUMP_TABLE
            size = le(bytes, 40) * 4
        }
        const wantedWords = [_]usize{ ids[k] | ((le(bytes, 16) & 0xFFFF) << 16), address >> 32, address & 0xFFFFFFFF, 0, 0, size, flags[k] }
        var w: usize = 0
        while w < 7 {
            if @intCast(usize, word32(entry + 4 * w)) != wantedWords[w] { return false }
            w += 1
        }
        k += 1
    }
    // The three entries left over are 0.
    k = 8 + 9 * 28
    while k < 344 {
        if @intCast(usize, word32(at + k)) != 0 { return false }
        k += 4
    }
    return true
}

fn word32(at: usize) -> u32 { return unsafe { @ptrFromInt(*u32, at) }.* }

// The engines as Linux's stop leaves them.
fn haltedAgain() -> bool {
    const me = engines.CP_ME_CNTL__ME_HALT | engines.CP_ME_CNTL__PFP_HALT | engines.CP_ME_CNTL__CE_HALT
    return card.registers[engines.CP_ME_CNTL] & me == me && card.registers[engines.CP_MEC_CNTL] == 0x50000000 && card.registers[engines.RLC_CNTL] & 1 == 0 && card.registers[loaded.GRBM_GFX_INDEX] == 0xE0000000
}

fn upToF1(stage: usize) -> bool {
    if !fresh(stage) { return false }
    card.registers[loaded.SMC_RESP_0] = 1
    return loaded.smcFirmware(&e, &l)
}

fn wantHalts(copy: bool) -> void {
    want(engines.CP_ME_CNTL, 0x15000000)
    want(engines.CP_MEC_CNTL, 0x50000000)
    want(engines.RLC_CNTL, 0)
    want(loaded.CP_INT_CNTL_RING0, 0)
    var se: usize = 0
    while se < 4 {
        want(loaded.GRBM_GFX_INDEX, 0x40000000 | se << 16)
        se += 1
    }
    want(loaded.GRBM_GFX_INDEX, 0xE0000000)
    if copy {
        want(engines.SDMA0_CNTL, 2)
        want(engines.SDMA1_CNTL, 2)
        want(engines.SDMA0_GFX_RB_CNTL, 0)
        want(engines.SDMA0_GFX_IB_CNTL, 0)
        want(engines.SDMA1_GFX_RB_CNTL, 0)
        want(engines.SDMA1_GFX_IB_CNTL, 0)
        want(engines.SDMA0_F32_CNTL, 1)
        want(engines.SDMA1_F32_CNTL, 1)
    }
}

fn theLoad() -> void {
    expect(upToF1(3), "S0 to F1")
    const from = card.written
    expect(loaded.engineFirmware(&e, &l), "F2 on the user's card")
    shown()
    const status = 0x3FA24 + 108
    wanted = 0
    wantCool()
    want(engines.SMC_IND_INDEX_11, 0x20030)
    want(loaded.SMC_IND_ACCESS_CNTL, 0)
    wantWrite(status, 0)
    const buffer = BASE + LIMIT + 0x82000
    const list = BASE + LIMIT + 0x81000
    wantMessage(0x252, buffer >> 32)
    wantMessage(0x253, buffer & 0xFFFFFFFF)
    want(engines.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)
    wantMessage(0x250, list >> 32)
    wantMessage(0x251, list & 0xFFFFFFFF)
    wantMessage(0x254, 0x47E)
    wantRead(status)
    wantHalts(true)
    wantCool()
    wantAlive()
    expect(writesAre(from, "F2"), "F2 write for write as smu7_request_smu_load_fw, then Linux's stop of the engines")
    expect(smc.askedCount == 6 && smc.asked[1] == 0x252 && smc.askedWith[1] == 0xF4 && smc.asked[2] == 0x253 && smc.askedWith[2] == 0x0C082000 && smc.asked[3] == 0x250 && smc.askedWith[3] == 0xF4 && smc.asked[4] == 0x251 && smc.askedWith[4] == 0x0C081000 && smc.asked[5] == 0x254 && smc.askedWith[5] == 0x47E, "the five messages with their parameters in Linux's order")
    expect(l.copies == card.DMA_BASE + 0x12000 && copiesHold(), "the copies at Linux's places (SDMA 0, SDMA 1, CE, PFP, ME, MEC and its jump table, MEC2's room, RLC)")
    expect(listHolds(), "the list word for word as the study's 3.4")
    expect(smc.loadedBits == 0x47E && smc.ramWord(status) == 0x47E, "every engine's image read through the GART and held by the SMC: load status 0x47e")
    expect(haltedAgain() && card.registers[engines.SDMA0_F32_CNTL] & 1 == 1 && card.registers[engines.SDMA1_F32_CNTL] & 1 == 1, "the engines halted again, the copy engines too at stage 3")
    line("gpu: step F2: the SMC loaded RLC 0x11e, CE 0x8c, PFP 0xfe, ME 0xa7, MEC 0x2da, SDMA 0 0x3a, SDMA 1 0x3a (load status 0x47e) after ")
    line(" us, reading them through the GART; no fault; it left ME 0x15000000, MEC 0x0, RLC 0x1 (before: 0x15000000, 0x50000000, 0x0); halted again: ME 0x15000000, MEC 0x50000000, RLC 0x0; 41 C before, 41 C after; picture ")
    expect(card.displayWrites(0) == 0, "F2 writes nothing of the display's")

    // At stage 4 the copy engines are not halted (D1 starts them).
    expect(upToF1(4), "S0 to F1 at stage 4")
    const at = card.written
    expect(loaded.engineFirmware(&e, &l), "F2 at stage 4")
    wanted = 0
    wantCool()
    want(engines.SMC_IND_INDEX_11, 0x20030)
    want(loaded.SMC_IND_ACCESS_CNTL, 0)
    wantWrite(status, 0)
    wantMessage(0x252, buffer >> 32)
    wantMessage(0x253, buffer & 0xFFFFFFFF)
    want(engines.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)
    wantMessage(0x250, list >> 32)
    wantMessage(0x251, list & 0xFFFFFFFF)
    wantMessage(0x254, 0x47E)
    wantRead(status)
    wantHalts(false)
    wantCool()
    wantAlive()
    expect(writesAre(at, "F2 at stage 4"), "F2 at stage 4: the copy engines left for D1")
}

// A failure of F2: the engines halted again, the line.
fn loadFailsWith(text: []const u8, what: []const u8) -> void {
    const passed = loaded.engineFirmware(&e, &l)
    shown()
    expect(!passed && l.f2 == engines.Outcome.failed, what)
    expect(haltedAgain(), "the engines halted again after a failed F2")
    line(text)
    line("; the engines halted again (ME 0x15000000, MEC 0x50000000, RLC 0x0); 41 C before")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn theLoadFailures() -> void {
    const messages = [_]usize{ 0x252, 0x253, 0x250, 0x251, 0x254 }
    const texts = [_][]const u8{ "gpu: step F2 failed: the SMC answered 0xfe to message 0x252;", "gpu: step F2 failed: the SMC answered 0xfe to message 0x253;", "gpu: step F2 failed: the SMC answered 0xfe to message 0x250;", "gpu: step F2 failed: the SMC answered 0xfe to message 0x251;", "gpu: step F2 failed: the SMC answered 0xfe to message 0x254;" }
    var k: usize = 0
    while k < messages.length {
        expect(upToF1(3), "S0 to F1")
        smc.answerTo = messages[k]
        smc.answerWith = 0xFE
        loadFailsWith(texts[k], "an answer that is not done")
        expect(smc.askedCount == 2 + k, "no message after the one not done")
        k += 1
    }
    expect(upToF1(3), "S0 to F1")
    smc.silentTo = 0x254
    loadFailsWith("gpu: step F2 failed: the SMC answered 0x0 to message 0x254 (no answer within 1 s);", "no answer to LoadUcodes")
    expect(upToF1(3), "S0 to F1")
    smc.loadOnly = 0x408
    loadFailsWith("gpu: step F2 failed: the SMC loaded only RLC, CE within 1 s (load status 0x408): not PFP, ME, MEC, SDMA 0, SDMA 1;", "a part loaded")
    expect(upToF1(3), "S0 to F1")
    smc.loadOnly = 0
    loadFailsWith("gpu: step F2 failed: the SMC loaded nothing within 1 s (load status 0x0); the card's AVFS fuse is 0x1: Linux writes its default levels into the SMC before LoadUcodes on such a card (the study's 10, item 7), the next thing to add;", "nothing loaded, AVFS fuse 1")
    expect(upToF1(3), "S0 to F1")
    smc.loadOnly = 0
    e.found.fuse = 0
    loadFailsWith("gpu: step F2 failed: the SMC loaded nothing within 1 s (load status 0x0); the card's AVFS fuse is 0x0: the study names nothing further for this;", "nothing loaded, no AVFS")
    // The RLC's copy not reachable through the GART: the SMC does not load
    // it and the card keeps the fault.
    expect(upToF1(3), "S0 to F1")
    const page = (0x12000 + 0x98000) / 4096
    const entry = unsafe { @ptrFromInt(*usize, card.vram + LIMIT + page * 8) }
    entry.* = 0
    loadFailsWith("gpu: step F2 failed: the SMC loaded only CE, PFP, ME, MEC, SDMA 0, SDMA 1 within 1 s (load status 0x7e): not RLC; a fault in address space 0 at page 0xff000aa (status 0x1004)", "an image the SMC cannot reach")
    // Everything loaded, but a fault kept in address space 0.
    expect(upToF1(3), "S0 to F1")
    card.faultAt = loaded.SMC_MESSAGE_0
    loadFailsWith("gpu: step F2 failed: a fault in address space 0 at page 0xff00800 (status 0x1004);", "a fault")
    // The picture minds; the card gone.
    expect(upToF1(3), "S0 to F1")
    card.scribbleAt = engines.HDP_MEM_COHERENCY_FLUSH_CNTL
    loadFailsWith("gpu: step F2 failed: the picture's memory changed (sum ", "the picture minds")
    expect(upToF1(3), "S0 to F1")
    card.goneAt = loaded.SMC_MESSAGE_0
    const passed = loaded.engineFirmware(&e, &l)
    expect(!passed && l.f2 == engines.Outcome.failed, "the card gone: F2 fails")
    line("gpu: step F2 failed: the card no longer answers as it did; the engines halted again")
}

fn theLoadRefusals() -> void {
    // A file of an engine's that does not hold.
    expect(upToF1(3), "S0 to F1")
    e.found.files[4].holds = engines.Holds.length
    var at = card.written
    expect(!loaded.engineFirmware(&e, &l) && l.f2 == engines.Outcome.refused && card.written == at, "a file that does not hold: refused, nothing written")
    line("gpu: step F2 refused: the firmware file polaris10_rlc.bin does not hold (step S0 says why)\n")
    // No GFX_Info in the ROM.
    expect(upToF1(3), "S0 to F1")
    e.found.gfxFound = false
    at = card.written
    expect(!loaded.engineFirmware(&e, &l) && card.written == at, "no GFX_Info: refused")
    line("gpu: step F2 refused: the card's ROM does not say how many shader engines it has (GFX_Info): the RLC the SMC starts could not be stopped as Linux stops it\n")
    // The soft registers' place is not the file's.
    expect(upToF1(3), "S0 to F1")
    smc.ram[12] = smc.ram[12] ^ 0x4
    at = card.written
    expect(!loaded.engineFirmware(&e, &l) && l.f2 == engines.Outcome.refused, "another soft registers' place: refused")
    expect(smc.askedCount == 1, "nothing asked of the SMC")
    line("gpu: step F2 refused: the SMC's RAM says its soft registers are at 0x3fa20, polaris10_k_smc.bin says 0x3fa24: nothing is asked of it\n")
    // No room for the copies.
    expect(upToF1(3), "S0 to F1")
    card.dmaPages = 100
    expect(!loaded.engineFirmware(&e, &l) && l.f2 == engines.Outcome.refused, "no room: refused")
    line("gpu: step F2 refused: no room for the firmware's copies in the memory set aside for the card\n")
    // The mark.
    expect(upToF1(3), "S0 to F1")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 90 << 9)
    expect(!loaded.engineFirmware(&e, &l) && l.f2 == engines.Outcome.refused, "90 C: refused")
    line("gpu: step F2 refused: the card is at 90 C (no step begins at 85 C or more)\n")
}

// ---- The stages and the way down.

fn theStages() -> void {
    expect(fresh(3), "S0 to I1 at stage 3")
    loaded.run(&e, &l)
    shown()
    expect(l.f1 == engines.Outcome.passed && l.f2 == engines.Outcome.passed && l.d1 == engines.Outcome.not_tried, "stage 3: F1 and F2, no copy engine")
    noLine("gpu: step D1")
    expect(card.registers[engines.SDMA0_F32_CNTL] & 1 == 1 && card.registers[engines.SDMA1_F32_CNTL] & 1 == 1 && haltedAgain(), "stage 3 ends with every engine halted")
    const at = card.written
    loaded.stop(&e, &l)
    line("gpu: stopped for the way down: interrupt ring off (")
    noLine("copy engines halted (")
    noLine("the doorbells off")
    expect(card.registers[engines.IH_RB_CNTL] & 1 == 0 && card.written > at, "the way down at stage 3: the ring off")
    expect(fresh(2), "S0 to I1 at stage 2")
    loaded.run(&e, &l)
    expect(l.f1 == engines.Outcome.not_tried, "stage 2: no F1")
    noLine("gpu: step F1")
    // A stage 2 that failed: nothing of stage 3.
    smc.reset()
    card.picture(0, 1280, 960, 1800, 1000)
    card.command = 0x0002
    const hands = smc.hands()
    engines.begin(&e, &hands, &where, 3)
    const more = smc.more()
    loaded.begin(&l, &more)
    engines.run(&e)
    loaded.run(&e, &l)
    expect(e.i1 == engines.Outcome.refused && l.f1 == engines.Outcome.not_tried, "no stage 3 after a stage 2 that did not pass")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

// The review's cards: firmware files cut short as S0 reads them (the SMC's
// file: F1 refused before a write; MEC's: F1 runs, F2 refused before a
// write), an SMC already running another key's firmware (its version said
// as not the file's, F2 refused before a message), and a failed F2 at a
// boot that goes beyond stage 4 (the engines halted all the same).
fn theReviewsCards() -> void {
    expect(freshCut(3, 7), "S0 to I1 with the SMC's file cut short")
    expect(e.found.files[engines.FILES.length].holds == engines.Holds.length, "S0 finds the SMC's file cut short")
    var at = card.written
    expect(!loaded.smcFirmware(&e, &l) && l.f1 == engines.Outcome.refused && card.written == at, "the SMC's file cut short: F1 refused, nothing written")
    line("gpu: step F1 refused: the SMC's firmware file polaris10_k_smc.bin does not hold (step S0 says why)\n")
    expect(freshCut(3, 3), "S0 to I1 with MEC's file cut short")
    expect(loaded.smcFirmware(&e, &l), "F1 does not need MEC's file")
    at = card.written
    const asked = smc.askedCount
    expect(!loaded.engineFirmware(&e, &l) && l.f2 == engines.Outcome.refused && card.written == at && smc.askedCount == asked, "MEC's file cut short: F2 refused, nothing written or asked")
    line("gpu: step F2 refused: the firmware file polaris10_mec_2.bin does not hold (step S0 says why)\n")
    // The SMC found running the soft key's firmware: F1 passes and says the
    // version is not the file's; F2 refused (another soft registers' place)
    // before any message.
    expect(fresh(3), "S0 to I1")
    const soft = card.fileBytes[8]
    var k: usize = 0
    while k < le(soft, 20) / 4 {
        smc.ram[k] = @intCast(u32, le(soft, le(soft, 24) + 4 * k))
        k += 1
    }
    smc.runningAsIs()
    expect(loaded.smcFirmware(&e, &l) && l.running, "another firmware found running: F1 passes")
    line(" (NOT the same as polaris10_k_smc.bin's 0x2171100)")
    expect(!loaded.engineFirmware(&e, &l) && l.f2 == engines.Outcome.refused && smc.askedCount == 0, "its soft registers elsewhere: F2 refused, nothing asked")
    line("gpu: step F2 refused: the SMC's RAM says its soft registers are at 0x3fa14, polaris10_k_smc.bin says 0x3fa24")
    // A boot that goes beyond stage 4 (a later kernel's): a failed F2
    // still leaves every engine halted.
    expect(upToF1(5), "S0 to F1 at stage 5")
    smc.loadOnly = 0
    loadFailsWith("gpu: step F2 failed: the SMC loaded nothing within 1 s (load status 0x0);", "nothing loaded at stage 5")
    expect(card.registers[engines.SDMA0_F32_CNTL] & 1 == 1 && card.registers[engines.SDMA1_F32_CNTL] & 1 == 1, "the copy engines halted too")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) == 2
    if !card.makeRom(true) {
        say("the ROM could not be made\n")
        return 5
    }
    const names = [_][]const u8{ "polaris10_pfp_2.bin", "polaris10_me_2.bin", "polaris10_ce_2.bin", "polaris10_mec_2.bin", "polaris10_rlc.bin", "polaris10_sdma.bin", "polaris10_sdma1.bin", "polaris10_k_smc.bin", "polaris10_smc_sk.bin" }
    for name in names {
        if !card.load(name) {
            say("the firmware files could not be read (run from the repository's top)\n")
            return 6
        }
    }
    theDigits()
    theStart()
    theUnprotected()
    theFoundRunning()
    theRefusals()
    theFailures()
    theLoad()
    theLoadFailures()
    theLoadRefusals()
    theStages()
    theReviewsCards()
    if failed != 0 { return failed }
    return 13
}
