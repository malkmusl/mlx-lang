// Three shapes the standard containers take: methods on `self: *Self`
// called through a `var`; a nested `pub const Entry = struct { key: *K,
// value: *V }` and an iterator type inside the returned struct, an
// iterator given out by a method (the nested struct's `Self` is itself;
// the table names itself `Table` for them); and a method returning
// several values, `-> (bool, ?*V)`. Exits 13.
fn Table(comptime K: type, comptime V: type) -> type {
    return struct {
        keys: [4]K
        values: [4]V
        length: usize

        pub const Table = Self

        pub const Entry = struct {
            key: *K
            value: *V
        }

        pub const Iterator = struct {
            table: *Table
            index: usize

            pub fn next(self: *Self) -> ?Entry {
                if self.*.index >= self.*.table.*.length { return null }
                const at = self.*.index
                self.*.index += 1
                return Entry.{ .key = &self.*.table.*.keys[at], .value = &self.*.table.*.values[at] }
            }
        }

        pub fn init() -> Self {
            var result: Self = undefined
            result.length = 0
            return result
        }

        pub fn put(self: *Self, key: K, value: V) -> bool {
            if self.*.length == 4 { return false }
            self.*.keys[self.*.length] = key
            self.*.values[self.*.length] = value
            self.*.length += 1
            return true
        }

        // Whether the key was there, and where its value is.
        pub fn getOrPut(self: *Self, key: K, value: V) -> (bool, ?*V) {
            var index: usize = 0
            while index < self.*.length {
                if self.*.keys[index] == key { return -> (true, &self.*.values[index]) }
                index += 1
            }
            if !self.*.put(key, value) { return -> (false, null) }
            return -> (false, &self.*.values[self.*.length - 1])
        }

        pub fn iterator(self: *Self) -> Iterator {
            return Iterator.{ .table = self, .index = 0 }
        }
    }
}

fn main() -> u8 {
    var table = Table(u8, u32).init()
    if !table.put(1, 10) || !table.put(2, 0) { return 1 }
    const found = table.getOrPut(2, 99)
    if !found.0 { return 2 }
    const slot = found.1
    if slot == null { return 3 }
    if slot.?.* != 0 { return 4 }
    slot.?.* = 20
    const made = table.getOrPut(3, 30)
    if made.0 { return 5 }
    if made.1 == null || made.1.?.* != 30 { return 6 }
    var sum: u32 = 0
    var keys: u8 = 0
    var entries = table.iterator()
    while true {
        const entry = entries.next()
        if entry == null { break }
        sum += entry.?.value.*
        keys += entry.?.key.*
    }
    if sum != 60 { return 7 }
    if keys != 6 { return 8 }
    var iterator: Table(u8, u32).Iterator = table.iterator()
    const first = iterator.next()
    if first == null || first.?.key.* != 1 { return 9 }
    const entry: Table(u8, u32).Entry = first.?
    entry.value.* += 3
    if table.values[0] != 13 { return 10 }
    return @intCast(u8, table.values[0])
}
