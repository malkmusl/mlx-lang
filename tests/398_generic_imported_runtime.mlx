// A generic type from another module, with a comptime integer parameter
// and a wrapper around an instance of another generic.
const generic = @import("./support/generic_stack.mlx")

const Bytes = generic.Stack(u8, 4)

fn main() -> u8 {
    var bytes = Bytes.init()
    if !bytes.push(1) || !bytes.push(2) || !bytes.push(3) || !bytes.push(4) { return 1 }
    if bytes.push(5) { return 2 }
    if Bytes.LIMIT != 4 { return 3 }
    var words = generic.Stack(u32, 2).init()
    if !words.push(1000) { return 4 }
    const popped = words.pop()
    if popped == null || popped.? != 1000 { return 5 }
    if words.pop() != null { return 6 }
    var wrapped: generic.Wrapper(generic.Stack(u8, 4)) = undefined
    wrapped.inner = bytes
    if wrapped.unwrap().*.pop().? != 4 { return 7 }
    if wrapped.inner.length != 3 { return 8 }
    var total: u8 = 0
    while true {
        const top = bytes.pop()
        if top == null { break }
        total += top.?
    }
    if total != 10 { return 9 }
    return 13
}
