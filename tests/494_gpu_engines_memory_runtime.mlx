// The kernel's stages 1 and 2 toward a Radeon that takes commands
// (projects/brix/kernel/gpu_engines.mlx's steps M1, M2 and I1, built for
// the host), against the card that is a table of tests/493 (tests/
// support/engine_card.mlx: the user's RX 580), with the study's steps
// (gpu-accel-kernel.verified.md 2.2, 2.4, 4.3, 4.6, 4.7, 8.4) written
// out here a second time, write for write:
// - M1: the aperture divided (the display's part up to 192 MiB of the
//   256), the driver's first 2 MiB written with a pattern, read back and
//   cleared, the word at 4 GiB of the card's memory through the index
//   window read, tried and put back, the window's index words as they
//   were found; refused where a controller's picture or the kernel's
//   display reaches into the driver's part, where the aperture is too
//   small; failed by a word that does not hold, by the word beyond the
//   aperture, by the memory controller's sequencer, by the picture
//   (frames, the memory interface, the picture's memory);
// - M2: Linux's memory start up to the GART where it differs from what
//   the card holds (the golden words, the default page, the AGP words),
//   the table (2048 entries for the memory set aside, the rest the dummy
//   page with no flag), the host path's flush, the twenty steps of
//   gmc_v8_0_gart_enable in their order with their values, the flush
//   request, the window's reads of four entries; refused for a host path
//   word that is not 0, the aperture's access not on, no memory set aside
//   or memory beyond 40 bits, no page for the dummy, M1 not passed;
//   failed by a register that does not hold, a fault, a GART entry that
//   reads back otherwise, an entry the card does not see, the picture
//   (each way), the card gone; and after every failure every register M2
//   wrote is what the firmware had (the way back);
// - I1: tonga_ih_irq_init in its order with its values, the interrupt
//   routed as a message, the ring silent for a second; entries that come
//   with their interrupt taken and their read pointer told; failed by a
//   register that does not hold, a storm, a write pointer not written
//   back, a ring that stays busy, entries whose interrupt does not come,
//   the picture; after every failure the ring off and every register as
//   the firmware had it; refused without M2, with bus mastering off,
//   without room for the ring; a card without MSI;
// - the way down (stop): the ring off, the GART left on;
// - through all of it no register of the display's is written.
// With an argument the log of every case is printed.
// Exits 13.
const std = @import("std")
const engines = @import("../projects/brix/kernel/gpu_engines.mlx")
const card = @import("./support/engine_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

const N = card.NEVER
const MIB: usize = 1024 * 1024
const LIMIT: usize = 192 * MIB
const BASE: usize = 0xF400000000

var e: engines.Engines = undefined
var where: engines.Card = undefined

// The card anew as the user's, a small picture of the kernel's at the
// aperture's start (the firmware's 1280x960 at 60 Hz) unless the case
// asks for the monitor's own; S0 at `stage`.
fn fresh(stage: usize, big: bool) -> bool {
    card.reset()
    if !big { card.picture(0, 1280, 960, 1800, 1000) }
    where = engines.Card.{ .device = 0x67DF, .revision = 0xE7, .view = card.VIEW, .pictureOffset = card.pictureOffset, .pictureBytes = card.pictureWidth * card.pictureHeight * 4, .dmaBase = card.DMA_BASE, .dmaPages = 2048, .rom = &card.machine }
    const hands = card.hands()
    engines.begin(&e, &hands, &where, stage)
    return engines.found(&e)
}

fn shown() -> void {
    if show {
        say(card.log[0..card.logged])
        say("--\n")
    }
}

// ---- M1.

fn m1Writes(from: usize, index: usize, high: usize) -> bool {
    const beyond: usize = 0x100000000
    const low = (beyond & engines.MM_INDEX__MM_OFFSET) | engines.MM_INDEX__MM_APER
    const hi = beyond >> 31
    const trial = engines.pattern(beyond) & 0xFFFFFFFF
    const numbers = [_]usize{ engines.MM_INDEX, engines.MM_INDEX_HI, engines.MM_INDEX, engines.MM_INDEX_HI, engines.MM_DATA, engines.MM_INDEX, engines.MM_INDEX_HI, engines.MM_INDEX, engines.MM_INDEX_HI, engines.MM_DATA, engines.MM_INDEX, engines.MM_INDEX_HI, engines.MM_INDEX, engines.MM_INDEX_HI, engines.SCRATCH_REG0, engines.SCRATCH_REG0 }
    const values = [_]usize{ low, hi, low, hi, trial, low, hi, low, hi, 0, low, hi, index, high, engines.SCRATCH_TRIAL, 0 }
    return card.writesFrom(from, numbers[0..], values[0..]) == N
}

fn driverPartClear() -> bool {
    var at = LIMIT
    while at < LIMIT + engines.PROVED {
        if card.vramRead(at) != 0 { return false }
        at += 8
    }
    return true
}

fn theAperture() -> void {
    expect(fresh(1, true), "S0 before M1")
    card.registers[engines.MM_INDEX] = 0x5428
    card.registers[engines.MM_INDEX_HI] = 0
    const from = card.written
    const before = card.asides
    expect(engines.divide(&e), "M1 on the user's card")
    shown()
    expect(e.m1 == engines.Outcome.passed && e.limit == LIMIT, "the aperture divided at 192 MiB")
    expect(m1Writes(from, 0x5428, 0), "M1's registers write for write: the window's words, the word beyond tried and put back, the index words as found")
    expect(driverPartClear() && card.beyondCount == 1 && card.beyondValue[0] == 0, "the driver's part cleared, the word beyond as it was")
    expect(card.asides == before + 1 && !card.aside, "the picture watched with the log off the screen")
    line("gpu: step M1: the aperture is the display's up to 192 MiB and the driver's from there; 2 MiB of it written, read back and cleared; a word at 4096 MiB of the card's memory reads back by the index window; picture 59.97 Hz before and after, same sum (")
    expect(card.displayWrites(0) == 0, "M1 writes nothing of the display's")

    // Refusals: the picture reaches into the driver's part; the kernel's
    // display does; the aperture is too small.
    expect(fresh(1, true), "S0")
    card.picture(190 * MIB, 3840, 1080, 4040, 1115)
    var at = card.written
    expect(!engines.divide(&e) && e.m1 == engines.Outcome.refused && card.written == at, "a controller's picture in the driver's part: refused, nothing written")
    line("gpu: step M1 refused: controller 0's picture reaches to 205.8 MiB of the aperture, into the driver's part from 192 MiB\n")
    expect(fresh(1, true), "S0")
    card.noPicture()
    where.pictureOffset = 190 * MIB
    e.card.pictureOffset = 190 * MIB
    at = card.written
    expect(!engines.divide(&e) && card.written == at, "the kernel's display in the driver's part: refused")
    line("gpu: step M1 refused: the kernel's display reaches to 205.8 MiB of the aperture, into the driver's part from 192 MiB\n")
    expect(fresh(1, false), "S0")
    e.card.view = 96 * MIB
    expect(!engines.divide(&e), "an aperture too small: refused")
    line("gpu: step M1 refused: the aperture in the kernel's view is 96 MiB, too small to give the driver 64 MiB of it\n")

    // Failures: a word that does not hold, the word beyond, the
    // sequencer, the picture.
    expect(fresh(1, false), "S0")
    card.badWord = LIMIT + 0x1238
    expect(!engines.divide(&e) && e.m1 == engines.Outcome.failed, "a word that does not hold: M1 fails")
    line("gpu: step M1 failed: the card's memory at 192 MiB + 0x1238 of the aperture reads ")
    line(" was written; nothing else was written\n")
    expect(fresh(1, false), "S0")
    card.beyondBad = true
    expect(!engines.divide(&e), "the word beyond does not hold: M1 fails")
    line("gpu: step M1 failed: the word at 0x100000000 of the card's memory reads ")
    expect(card.registers[engines.MM_INDEX] == 0 && card.registers[engines.MM_INDEX_HI] == 0, "the window's index words as found after a failure too")
    expect(fresh(1, false), "S0")
    card.registers[engines.MC_SEQ_SUP_CNTL] = 0
    at = card.written
    expect(!engines.divide(&e) && card.written == at, "the sequencer stopped: M1 fails before a write")
    line("gpu: step M1 failed: the memory controller's sequencer does not run (0x0): the driver's memory is not tried\n")
    expect(fresh(1, false), "S0")
    card.stopFramesAt = engines.MM_DATA
    expect(!engines.divide(&e), "the frames stop: M1 fails")
    line("gpu: step M1 failed: the picture's frames: 59.97 Hz before, 0.00 Hz after; nothing else was written\n")
    expect(fresh(1, false), "S0")
    card.scribbleAt = engines.MM_DATA
    expect(!engines.divide(&e), "the picture's memory changes: M1 fails")
    line("gpu: step M1 failed: the picture's memory changed (sum ")
    expect(fresh(1, false), "S0")
    card.dryAt = engines.MM_INDEX_HI
    expect(!engines.divide(&e), "the memory interface runs dry: M1 fails")
    line("gpu: step M1 failed: the memory interface ran dry (DMIF_STATUS says an underflow); nothing else was written\n")
    // A card with no picture of the kernel's.
    expect(fresh(1, false), "S0")
    card.noPicture()
    e.card.pictureBytes = 0
    expect(engines.divide(&e), "no picture to watch: M1 passes")
    line("; no picture of the kernel's on this card to watch (")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

// ---- M2.

var found: [card.ROOM]usize = undefined

fn keepRegisters() -> void {
    var k: usize = 0
    while k < card.ROOM {
        found[k] = card.registers[k]
        k += 1
    }
}

// Every register as the firmware had it but for the commands and the
// window's words (the way back).
fn asFound() -> bool {
    var k: usize = 0
    while k < card.ROOM {
        const fault = k == engines.VM_CONTEXT0_PROTECTION_FAULT_STATUS || k == engines.VM_CONTEXT0_PROTECTION_FAULT_ADDR || k == engines.VM_CONTEXT1_PROTECTION_FAULT_STATUS || k == engines.VM_CONTEXT1_PROTECTION_FAULT_ADDR
        const command = fault || k == engines.VM_INVALIDATE_REQUEST || k == engines.VM_INVALIDATE_RESPONSE || k == engines.HDP_MEM_COHERENCY_FLUSH_CNTL || k == engines.MM_INDEX || k == engines.MM_INDEX_HI || k == engines.MM_DATA || k == engines.DMIF_STATUS || k == engines.SMC_IND_INDEX_11
        if !command && card.registers[k] != found[k] {
            if show {
                say("not as found: register ")
                hexSay(k)
                say("\n")
            }
            return false
        }
        k += 1
    }
    return true
}

fn hexSay(value: usize) -> void {
    var text: [16]u8 = undefined
    var k: usize = 0
    while k < 16 {
        const digit = (value >> @intCast(u6, (15 - k) * 4)) & 15
        text[k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(text[0..16])
}

const DUMMY: usize = card.DMA_BASE
const TABLE: usize = BASE + LIMIT
const DEFAULT_PAGE: usize = BASE + LIMIT + 65536 * 8

// M2's writes as the study's 8.4 gives them for the user's card as the
// table has it: what differs of Linux's memory start, then the twenty
// steps, then the window's reads; their count.
var numbers: [128]usize = undefined
var values: [128]usize = undefined
var listed: usize = 0

fn w(number: usize, value: usize) -> void {
    numbers[listed] = number
    values[listed] = value
    listed += 1
}

fn m2List(index: usize, high: usize) -> void {
    listed = 0
    // The golden words: the four apertures' low addresses are 0 on this
    // card, Linux's rule gives 0x0fffffff; the arbiter's word is 0
    // already.
    w(engines.VM_PRT_APERTURE0_LOW_ADDR, 0x0FFFFFFF)
    w(engines.VM_PRT_APERTURE1_LOW_ADDR, 0x0FFFFFFF)
    w(engines.VM_PRT_APERTURE2_LOW_ADDR, 0x0FFFFFFF)
    w(engines.VM_PRT_APERTURE3_LOW_ADDR, 0x0FFFFFFF)
    // The system aperture is VRAM's already; its default page is ours.
    w(engines.MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR, DEFAULT_PAGE >> 12)
    // The AGP words: base 0 already, top and bottom made empty.
    w(engines.MC_VM_AGP_TOP, 0x0FFFFFFF)
    w(engines.MC_VM_AGP_BOT, 0x0FFFFFFF)
    // The host path flushed after the table.
    w(engines.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)
    // gmc_v8_0_gart_enable.
    w(engines.MC_VM_MX_L1_TLB_CNTL, 0x1 | 0x2 | (3 << 3) | 0x40)
    w(engines.VM_L2_CNTL, 0x1 | 0x2 | 0x200 | 0x400 | 0x800 | (7 << 15) | (1 << 19))
    w(engines.VM_L2_CNTL2, 0x3)
    w(engines.VM_L2_CNTL3, 0x100000 | 9 | (9 << 15))
    w(engines.VM_L2_CNTL4, 0)
    w(engines.VM_CONTEXT0_PAGE_TABLE_START_ADDR, 0xFF00000000 >> 12)
    w(engines.VM_CONTEXT0_PAGE_TABLE_END_ADDR, 0xFF0FFFFFFF >> 12)
    w(engines.VM_CONTEXT0_PAGE_TABLE_BASE_ADDR, TABLE >> 12)
    w(engines.VM_CONTEXT0_PROTECTION_FAULT_DEFAULT_ADDR, DUMMY >> 12)
    w(engines.VM_CONTEXT0_CNTL2, 0)
    w(engines.VM_CONTEXT0_CNTL, 0x1 | 0x10)
    w(engines.VM_L2_CONTEXT1_IDENTITY_APERTURE_LOW_ADDR, 0)
    w(engines.VM_L2_CONTEXT1_IDENTITY_APERTURE_HIGH_ADDR, 0)
    w(engines.VM_L2_CONTEXT_IDENTITY_PHYSICAL_OFFSET, 0)
    w(engines.VM_CONTEXT1_PAGE_TABLE_START_ADDR, 0)
    w(engines.VM_CONTEXT1_PAGE_TABLE_END_ADDR, 0x1000000 - 1)
    var space: usize = 1
    while space < 8 {
        w(0x54F + space, TABLE >> 12)
        space += 1
    }
    while space < 16 {
        w(0x50E + space - 8, TABLE >> 12)
        space += 1
    }
    w(engines.VM_CONTEXT1_PROTECTION_FAULT_DEFAULT_ADDR, DUMMY >> 12)
    w(engines.VM_CONTEXT1_CNTL2, 4)
    const faults: usize = 0x10 | 0x80 | 0x400 | 0x2000 | 0x10000 | 0x80000 | 0x400000
    w(engines.VM_CONTEXT1_CNTL, 0x1 | (1 << 1) | faults | (1 << 24))
    w(engines.VM_CONTEXT1_CNTL, 0x1 | (1 << 1) | faults | (1 << 24))
    w(engines.VM_INVALIDATE_REQUEST, 1)
    // The card alive: the scratch register given a value and put back.
    w(engines.SCRATCH_REG0, engines.SCRATCH_TRIAL)
    w(engines.SCRATCH_REG0, 0)
    // The four entries read through the window: two words each.
    const entries = [_]usize{ 0, 2047, 2048, 65535 }
    for which in entries {
        const at = LIMIT + which * 8
        w(engines.MM_INDEX, (at & 0x7FFFFFFF) | 0x80000000)
        w(engines.MM_INDEX_HI, at >> 31)
        w(engines.MM_INDEX, ((at + 4) & 0x7FFFFFFF) | 0x80000000)
        w(engines.MM_INDEX_HI, (at + 4) >> 31)
    }
    w(engines.MM_INDEX, index)
    w(engines.MM_INDEX_HI, high)
}

fn upToM1(big: bool) -> bool {
    if !fresh(1, big) { return false }
    return engines.divide(&e)
}

fn tableAsWritten() -> bool {
    var k: usize = 0
    while k < 65536 {
        const wanted = if k < 2048 { ((card.DMA_BASE + k * 4096) & 0x0000FFFFFFFFF000) | 0x77 } else { DUMMY & 0x0000FFFFFFFFF000 }
        if card.vramRead(LIMIT + k * 8) != wanted { return false }
        k += 1
    }
    return true
}

fn theGart() -> void {
    expect(upToM1(true), "S0 and M1 before M2")
    keepRegisters()
    const from = card.written
    expect(engines.gart(&e), "M2 on the user's card")
    shown()
    expect(e.m2 == engines.Outcome.passed, "M2 passed")
    m2List(0, 0)
    const differs = card.writesFrom(from, numbers[0..listed], values[0..listed])
    expect(differs == N, "M2's registers write for write, in the study's order")
    if differs != N && show {
        say("the first difference at write ")
        hexSay(differs)
        say(", register ")
        if from + differs < card.written { hexSay(card.writtenTo[from + differs]) }
        say(" value ")
        if from + differs < card.written { hexSay(card.writtenWith[from + differs]) }
        say("\n")
    }
    expect(tableAsWritten(), "the table: the 2048 pages set aside with flags 0x77, the rest the dummy page with no flag")
    expect(e.dummy == DUMMY && e.table == TABLE && e.defaultPage == DEFAULT_PAGE, "the dummy page, the table at 192 MiB, the default page after it")
    line("gpu: 0x52c was 0x0 now 0xfffffff\n")
    line("gpu: 0x80f was 0xf400000 now 0xf40c080\n")
    line("gpu: 0x80a was 0x0 now 0xfffffff\n")
    line("gpu: memory controller busy bits over 1 ms: display 1000 of 1000, others 0 of 1000\n")
    line("gpu: flush of address space 0: response 0x0 -> 0x1 -> 0x1\n")
    line("gpu: after step M2: the scratch register takes 0xcafebabe, GRBM status 0x3028, SRBM status 0x200 and 0x0\n")
    line("gpu: step M2: GART 256 MiB at 0xff00000000, its table at 0xf40c000000 (192 MiB of the aperture), 2048 of 65536 entries map 8 MiB at 0x123400000; system aperture 0xf400000000..0xf5ffffffff (as found); no fault; picture 59.97 Hz before and after, same sum (")
    expect(card.displayWrites(0) == 0, "M2 writes nothing of the display's")
    noLine("the memory controller is not idle")

    // The golden words, the aperture, the AGP words and the host path's
    // control as Linux leaves them already: none of them written.
    expect(upToM1(false), "S0 and M1")
    const golden = [_]usize{ engines.VM_PRT_APERTURE0_LOW_ADDR, engines.VM_PRT_APERTURE1_LOW_ADDR, engines.VM_PRT_APERTURE2_LOW_ADDR, engines.VM_PRT_APERTURE3_LOW_ADDR }
    for number in golden { card.registers[number] = 0x0FFFFFFF }
    card.registers[engines.MC_VM_AGP_TOP] = 0x0FFFFFFF
    card.registers[engines.MC_VM_AGP_BOT] = 0x0FFFFFFF
    card.registers[engines.MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR] = DEFAULT_PAGE >> 12
    card.registers[engines.MC_ARB_WTM_GRPWT_RD] = 0x3
    card.registers[engines.HDP_MISC_CNTL] = 0x1
    var at = card.written
    expect(engines.gart(&e), "M2 where the card holds Linux's words")
    expect(card.writtenTo[at] == engines.MC_ARB_WTM_GRPWT_RD && card.writtenWith[at] == 0 && card.writtenTo[at + 1] == engines.HDP_MISC_CNTL && card.writtenWith[at + 1] == 0 && card.writtenTo[at + 2] == engines.HDP_MEM_COHERENCY_FLUSH_CNTL, "only what differs: the arbiter's group 0 and the host path's control")
    line("gpu: 0x9e1 was 0x3 now 0x0\n")
    line("gpu: 0xbd3 was 0x1 now 0x0\n")

    // Refusals, each before any write.
    expect(upToM1(false), "S0 and M1")
    card.registers[0xB0B] = 0x1234
    e.found.hostPathNonZero = 1
    e.found.hostPathFirst = 0xB0B
    e.found.hostPathValue = 0x1234
    at = card.written
    expect(!engines.gart(&e) && e.m2 == engines.Outcome.refused && card.written == at, "a host path word that is not 0: refused")
    line("gpu: step M2 refused: the host path's surface word 0xb0b is 0x1234 (Linux writes 0 there without looking): left alone\n")
    expect(upToM1(false), "S0 and M1")
    card.registers[engines.BIF_FB_EN] = 1
    at = card.written
    expect(!engines.gart(&e) && card.written == at, "the aperture's access not on: refused")
    line("gpu: step M2 refused: the processor's access to the aperture reads 0x1, not as a card whose picture the processor draws has it\n")
    expect(upToM1(false), "S0 and M1")
    e.card.dmaBase = 0
    expect(!engines.gart(&e), "no memory set aside: refused")
    line("gpu: step M2 refused: the memory set aside for the card is missing or beyond the card's 40 bits\n")
    expect(upToM1(false), "S0 and M1")
    e.card.dmaBase = 0xFFFFF00000
    expect(!engines.gart(&e), "memory beyond 40 bits: refused")
    expect(upToM1(false), "S0 and M1")
    card.dmaPages = 0
    expect(!engines.gart(&e) && e.dummy == 0, "no page for the dummy: refused")
    line("gpu: step M2 refused: no page of the memory set aside for the card is left for the dummy page\n")
    expect(fresh(1, false), "S0 only")
    expect(!engines.gart(&e), "M1 not passed: refused")
    line("gpu: step M2 refused: the aperture is not divided (step M1)\n")

    // Failures, each with the way back.
    failing(engines.VM_L2_CNTL3, N, N, N, N, N, "gpu: step M2 failed: a register does not hold what was written: 0x502 (0x0, not 0x148009); the GART's words put back as the firmware had them (")
    failing(N, engines.VM_CONTEXT0_CNTL, N, N, N, N, "gpu: step M2 failed: a fault in address space 0 at page 0xff00800 (0x1004); the GART's words put back as the firmware had them (")
    failing(N, N, LIMIT + 5 * 8, N, N, N, "gpu: step M2 failed: the GART's table reads back otherwise at entry 0x5 (")
    failing(N, N, N, LIMIT + 2048 * 8, N, N, "gpu: step M2 failed: the card does not see the GART's entry 0x800 (")
    failing(N, N, N, N, engines.VM_CONTEXT0_CNTL, N, "gpu: step M2 failed: the picture's memory changed (sum ")
    failing(N, N, N, N, N, engines.MC_VM_MX_L1_TLB_CNTL, "gpu: step M2 failed: the picture's frames: 59.97 Hz before, 0.00 Hz after; the GART's words put back as the firmware had them (")
    failing(engines.SCRATCH_REG0, N, N, N, N, N, "gpu: step M2 failed: the card no longer answers as it did; the GART's words put back as the firmware had them (")
    // (The review's cases: the GART's own switch that does not hold; a
    // fault in address space 1.)
    failing(engines.VM_CONTEXT0_CNTL, N, N, N, N, N, "gpu: step M2 failed: a register does not hold what was written: 0x504 (0x0, not 0x11); the GART's words put back as the firmware had them (")
    faultSpace = 1
    failing(N, engines.VM_CONTEXT1_CNTL, N, N, N, N, "gpu: step M2 failed: a fault in address space 1 at page 0xff00800 (0x1004); the GART's words put back as the firmware had them (")
    faultSpace = 0
    // The memory interface run dry; the card gone.
    expect(upToM1(false), "S0 and M1")
    keepRegisters()
    card.dryAt = engines.VM_L2_CNTL
    expect(!engines.gart(&e) && asFound(), "the memory interface runs dry: M2 fails, every register back")
    line("gpu: step M2 failed: the memory interface ran dry (DMIF_STATUS says an underflow); the GART's words put back as the firmware had them (")
    expect(upToM1(false), "S0 and M1")
    card.goneAt = engines.VM_INVALIDATE_REQUEST
    expect(!engines.gart(&e), "the card gone: M2 fails")
    line("gpu: step M2 failed: the card no longer answers as it did; the GART's words put back as the firmware had them (")
    expect(card.displayWrites(0) == 0, "nothing of the display's, the ways back too")
}

// M2 failing by one wrong thing of the card's, and every register M2
// wrote what the firmware had. (`faultSpace`: the address space the
// card records its fault in.)
var faultSpace: usize = 0

fn failing(stuck: usize, fault: usize, bad: usize, unseen: usize, scribble: usize, frames: usize, wanted: []const u8) -> void {
    if !upToM1(false) {
        expect(false, "S0 and M1")
        return
    }
    keepRegisters()
    card.stuck = stuck
    card.faultAt = fault
    card.faultSpace = faultSpace
    card.badWord = bad
    card.unseen = unseen
    card.scribbleAt = scribble
    card.stopFramesAt = frames
    expect(!engines.gart(&e) && e.m2 == engines.Outcome.failed, wanted)
    line(wanted)
    expect(asFound(), "after a failure every register M2 wrote is the firmware's again")
    expect(e.kept.count == 0, "nothing kept after the way back")
    shown()
}

// ---- I1.

const RING: usize = card.DMA_BASE + 4096
const POINTERS: usize = card.DMA_BASE + 4096 + 65536

fn i1List() -> void {
    listed = 0
    w(engines.IH_RB_CNTL, 0)
    w(engines.IH_RB_RPTR, 0)
    w(engines.IH_RB_WPTR, 0)
    w(engines.INTERRUPT_CNTL2, DUMMY >> 8)
    w(engines.INTERRUPT_CNTL, 0)
    w(engines.IH_RB_BASE, RING >> 8)
    w(engines.IH_RB_CNTL, 0x8020011C)
    w(engines.IH_RB_WPTR_ADDR_LO, POINTERS & 0xFFFFFFFF)
    w(engines.IH_RB_WPTR_ADDR_HI, POINTERS >> 32)
    w(engines.IH_RB_RPTR, 0)
    w(engines.IH_RB_WPTR, 0)
    w(engines.IH_DOORBELL_RPTR, 0)
    w(engines.IH_RB_CNTL, 0x0022011D)
    w(engines.SCRATCH_REG0, engines.SCRATCH_TRIAL)
    w(engines.SCRATCH_REG0, 0)
}

fn upToM2() -> bool {
    if !fresh(2, false) { return false }
    if !engines.divide(&e) { return false }
    return engines.gart(&e)
}

fn ringAsFound() -> bool {
    const words = [_]usize{ engines.IH_RB_CNTL, engines.IH_RB_BASE, engines.IH_RB_RPTR, engines.IH_RB_WPTR, engines.IH_RB_WPTR_ADDR_HI, engines.IH_RB_WPTR_ADDR_LO, engines.IH_DOORBELL_RPTR, engines.INTERRUPT_CNTL, engines.INTERRUPT_CNTL2 }
    for number in words {
        if card.registers[number] != found[number] { return false }
    }
    return true
}

fn theRing() -> void {
    expect(upToM2(), "S0, M1, M2 before I1")
    card.registers[engines.INTERRUPT_CNTL] = 0x9
    card.registers[engines.IH_DOORBELL_RPTR] = 0x100001E8
    var from = card.written
    expect(engines.interrupts(&e), "I1 on the user's card")
    shown()
    expect(e.i1 == engines.Outcome.passed && e.ringUp && card.routed, "the ring up, the interrupt routed")
    i1List()
    values[4] = 0
    values[11] = 0x1E8
    var differs = card.writesFrom(from, numbers[0..listed], values[0..listed])
    expect(differs == N, "I1's registers write for write, in tonga_ih_irq_init's order")
    expect(e.ring == RING && e.pointers == POINTERS, "the ring and its pointer page in the memory set aside")
    line("gpu: step I1: interrupt ring of 4096 entries at 0x123401000 (bus address), control 0x22011d, pointers 0x0 and 0x0 after 1 s, no entry, interrupts taken: 0, idle (status 0x0); picture 59.97 Hz before and after, same sum (")
    expect(card.displayWrites(0) == 0, "I1 writes nothing of the display's")
    // The way down.
    from = card.written
    engines.stop(&e)
    expect(!e.ringUp && card.registers[engines.IH_RB_CNTL] & 0x20001 == 0, "the way down: the ring off")
    line("gpu: stopped for the way down: interrupt ring off (0x20011c); the GART stays on\n")
    expect(card.registers[engines.VM_CONTEXT0_CNTL] & 1 == 1, "the GART stays on")
    from = card.written
    engines.stop(&e)
    expect(card.written == from, "a second way down does nothing")

    // Entries that come, with their interrupt: taken, the read pointer
    // told. While the kernel starts the processor's interrupts are off:
    // the card's message waits at the processor, not taken, and that is
    // the interrupt that came.
    expect(upToM2(), "S0, M1, M2")
    card.pending = 3
    from = card.written
    expect(engines.interrupts(&e), "entries with their interrupt, the processor's interrupts off while the kernel starts: I1 passes")
    expect(e.entries == 3 && card.registers[engines.IH_RB_RPTR] == 48, "three entries taken, the read pointer told")
    line("pointers 0x30 and 0x30 after 1 s, entries: 3 (sources 42), interrupts taken: 0, one waits at the processor (interrupts are off while the kernel starts), idle")
    // The same with the processor's interrupts on (the steps asked for
    // from the running system): the interrupt taken.
    expect(upToM2(), "S0, M1, M2")
    card.interruptsOn = true
    card.pending = 3
    expect(engines.interrupts(&e), "entries with their interrupt taken: I1 passes")
    line("entries: 3 (sources 42), interrupts taken: 1, idle")
    noLine("waits at the processor")
    // An interrupt of the card's waiting at the processor before the
    // ring came up: a new one cannot be told from it, and the line says
    // so.
    expect(upToM2(), "S0, M1, M2")
    card.waitingMessage = true
    card.noMessage = true
    card.pending = 3
    expect(engines.interrupts(&e), "an interrupt of the card's waiting before: nothing to judge by")
    line("entries: 3 (sources 42), interrupts taken: 0, one of the card's waited at the processor before the ring came up (a new one cannot be told from it), idle")
    // A card without MSI: the ring does not re-arm on the read pointer.
    expect(upToM2(), "S0, M1, M2")
    card.routable = false
    from = card.written
    expect(engines.interrupts(&e), "no MSI: I1 passes")
    i1List()
    values[4] = 0
    values[6] = 0x8000011C
    values[12] = 0x0002011D
    differs = card.writesFrom(from, numbers[0..listed], values[0..listed])
    expect(differs == N, "without MSI the ring is not armed on the read pointer")
    line("interrupts taken: 0 (none can come: the card has neither MSI nor MSI-X)")

    // Refusals.
    expect(fresh(2, false), "S0 only")
    expect(!engines.interrupts(&e) && e.i1 == engines.Outcome.refused, "no GART: refused")
    line("gpu: step I1 refused: the GART is not on (step M2), whose dummy page the ring is given\n")
    expect(upToM2(), "S0, M1, M2")
    card.command = 0x2
    from = card.written
    expect(!engines.interrupts(&e) && card.written == from, "bus mastering off: refused, nothing written")
    line("gpu: step I1 refused: the card's bus mastering is off (PCI command 0x2): it may not write the system's memory\n")
    expect(upToM2(), "S0, M1, M2")
    card.dmaPages = 8
    expect(!engines.interrupts(&e), "no room for the ring: refused")
    line("gpu: step I1 refused: no room for the ring in the memory set aside for the card\n")

    // Failures, each with the ring off and its words as found.
    ringFails(1, "gpu: step I1 failed: a register does not hold what was written: 0xe31 (0x0, not 0x1234010); the interrupt ring is off again, its words as the firmware had them (")
    ringFails(2, "gpu: step I1 failed: a storm: more entries in a second than the ring holds (")
    ringFails(3, "gpu: step I1 failed: the card does not write its write pointer back where it was told (0x0, not 0x30)")
    ringFails(4, "gpu: step I1 failed: the interrupt ring stays busy (0x20200); the interrupt ring is off again")
    ringFails(5, "gpu: step I1 failed: entries came and their interrupt did not (0x3); the interrupt ring is off again")
    ringFails(6, "gpu: step I1 failed: the picture's frames: 59.97 Hz before, 0.00 Hz after; the interrupt ring is off again")
    expect(card.displayWrites(0) == 0, "nothing of the display's, the ways back too")
}

fn ringFails(how: usize, wanted: []const u8) -> void {
    if !upToM2() {
        expect(false, "S0, M1, M2")
        return
    }
    keepRegisters()
    if how == 1 { card.stuck = engines.IH_RB_BASE }
    if how == 2 { card.storm = true }
    if how == 3 {
        card.noWriteBack = true
        card.pending = 3
    }
    if how == 4 { card.ringBusy = true }
    if how == 5 {
        card.noMessage = true
        card.pending = 3
    }
    if how == 6 { card.stopFramesAt = engines.IH_RB_BASE }
    expect(!engines.interrupts(&e) && e.i1 == engines.Outcome.failed && !e.ringUp, wanted)
    line(wanted)
    expect(ringAsFound(), "after a failure the ring's words are the firmware's again")
    expect(card.registers[engines.IH_RB_CNTL] & 0x20001 == 0, "the ring off")
    // The way back begins as Linux turns the ring off (tonga_ih_irq_disable:
    // the ring and its interrupt off, both pointers 0), then the step's
    // thirteen registers as the firmware had them, last first.
    if card.written <= card.WRITES && card.written >= 16 {
        const at = card.written - 16
        expect(card.writtenTo[at] == engines.IH_RB_CNTL && card.writtenWith[at] & 0x20001 == 0 && card.writtenTo[at + 1] == engines.IH_RB_RPTR && card.writtenWith[at + 1] == 0 && card.writtenTo[at + 2] == engines.IH_RB_WPTR && card.writtenWith[at + 2] == 0 && card.writtenTo[at + 3] == engines.IH_RB_CNTL, "the way back begins with the ring turned off as Linux does")
    }
    shown()
    // Nothing for the way down.
    const from = card.written
    engines.stop(&e)
    expect(card.written == from, "the way down after a failed I1 does nothing")
}

// ---- The stages of a boot, through `run`.

fn theStages() -> void {
    card.reset()
    card.picture(0, 1280, 960, 1800, 1000)
    where = engines.Card.{ .device = 0x67DF, .revision = 0xE7, .view = card.VIEW, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .dmaBase = card.DMA_BASE, .dmaPages = 2048, .rom = &card.machine }
    const hands = card.hands()
    var stage: usize = 0
    while stage <= 2 {
        card.reset()
        card.picture(0, 1280, 960, 1800, 1000)
        engines.begin(&e, &hands, &where, stage)
        engines.run(&e)
        expect(e.s0 == engines.Outcome.passed, "S0 at every stage")
        expect((e.m1 == engines.Outcome.passed) == (stage >= 1) && (e.m2 == engines.Outcome.passed) == (stage >= 1) && (e.i1 == engines.Outcome.passed) == (stage >= 2), "each stage goes as far as it says")
        expect(card.displayWrites(0) == 0, "no register of the display's at any stage")
        if stage == 0 {
            var k: usize = 0
            var others: usize = 0
            while k < card.written {
                if card.writtenTo[k] != engines.SMC_IND_INDEX_11 && card.writtenTo[k] != engines.MC_SEQ_IO_DEBUG_INDEX && card.writtenTo[k] != engines.SRBM_GFX_CNTL { others += 1 }
                k += 1
            }
            expect(others == 0, "stage 0 writes no register but the index words")
        }
        stage += 1
    }
    // A failed M1 stops the stages.
    card.reset()
    card.picture(0, 1280, 960, 1800, 1000)
    card.badWord = LIMIT
    engines.begin(&e, &hands, &where, 2)
    engines.run(&e)
    expect(e.m1 == engines.Outcome.failed && e.m2 == engines.Outcome.not_tried && e.i1 == engines.Outcome.not_tried, "a failed step stops the stages after it")
}

// ---- What the review added: words the firmware left otherwise than
// Linux's start would, a memory controller that stays busy, frames a
// little off, an interrupt ring that overflows.

// A field set as Linux's REG_SET_FIELD sets it: the mask's bits cleared,
// the value put in.
fn setField(word: usize, mask: usize, value: usize) -> usize {
    var shift: usize = 0
    while (mask >> @intCast(u6, shift)) & 1 == 0 { shift += 1 }
    return (word & ~mask) | ((value << @intCast(u6, shift)) & mask)
}

fn theFirmwareWords() -> void {
    // Every word M2 changes by a field holds other bits the firmware set;
    // the words M2 writes where they differ do differ.
    const l1: usize = 0x20 | 0x780
    const l2: usize = 0x7000 | 0x8000 | 0x180000 | 0x3E00000
    const l23: usize = 0x80000000 | 0x3F | 0xF8000
    const l24: usize = 0x40000 | 0x3F | 0x3FFC0
    const c0: usize = 0x8 | 0x6
    const c1: usize = 0x249248
    expect(upToM1(false), "S0 and M1")
    card.registers[engines.MC_VM_MX_L1_TLB_CNTL] = l1
    card.registers[engines.VM_L2_CNTL] = l2
    card.registers[engines.VM_L2_CNTL3] = l23
    card.registers[engines.VM_L2_CNTL4] = l24
    card.registers[engines.VM_CONTEXT0_CNTL] = c0
    card.registers[engines.VM_CONTEXT1_CNTL] = c1
    card.registers[engines.MC_VM_AGP_BASE] = 0x123
    card.registers[engines.MC_VM_AGP_TOP] = 0
    card.registers[engines.MC_VM_AGP_BOT] = 0x10
    card.registers[engines.HDP_REG_COHERENCY_FLUSH_CNTL] = 1
    card.registers[engines.MC_VM_SYSTEM_APERTURE_HIGH_ADDR] = 0x0F4FFFFF
    card.registers[engines.HDP_MISC_CNTL] = 0x11
    keepRegisters()
    const from = card.written
    expect(engines.gart(&e), "M2 over the firmware's own words")
    // gmc_v8_0_mc_program's words where they differ, in its order, then
    // gmc_v8_0_gart_enable's fields over what the firmware left.
    listed = 0
    w(engines.VM_PRT_APERTURE0_LOW_ADDR, 0x0FFFFFFF)
    w(engines.VM_PRT_APERTURE1_LOW_ADDR, 0x0FFFFFFF)
    w(engines.VM_PRT_APERTURE2_LOW_ADDR, 0x0FFFFFFF)
    w(engines.VM_PRT_APERTURE3_LOW_ADDR, 0x0FFFFFFF)
    w(engines.HDP_REG_COHERENCY_FLUSH_CNTL, 0)
    w(engines.MC_VM_SYSTEM_APERTURE_HIGH_ADDR, 0x0F5FFFFF)
    w(engines.MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR, DEFAULT_PAGE >> 12)
    w(engines.MC_VM_AGP_BASE, 0)
    w(engines.MC_VM_AGP_TOP, 0x0FFFFFFF)
    w(engines.MC_VM_AGP_BOT, 0x0FFFFFFF)
    w(engines.HDP_MISC_CNTL, 0x10)
    w(engines.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)
    var v = setField(l1, 0x1, 1)
    v = setField(v, 0x2, 1)
    v = setField(v, 0x18, 3)
    v = setField(v, 0x40, 1)
    v = setField(v, 0x20, 0)
    w(engines.MC_VM_MX_L1_TLB_CNTL, v)
    v = setField(l2, 0x1, 1)
    v = setField(v, 0x2, 1)
    v = setField(v, 0x200, 1)
    v = setField(v, 0x400, 1)
    v = setField(v, 0x38000, 7)
    v = setField(v, 0x180000, 1)
    v = setField(v, 0x800, 1)
    w(engines.VM_L2_CNTL, v)
    w(engines.VM_L2_CNTL2, 0x3)
    v = setField(l23, 0x100000, 1)
    v = setField(v, 0x3F, 9)
    v = setField(v, 0xF8000, 9)
    w(engines.VM_L2_CNTL3, v)
    w(engines.VM_L2_CNTL4, l24 & ~@intCast(usize, 0x3FFC0))
    w(engines.VM_CONTEXT0_PAGE_TABLE_START_ADDR, 0xFF00000000 >> 12)
    w(engines.VM_CONTEXT0_PAGE_TABLE_END_ADDR, 0xFF0FFFFFFF >> 12)
    w(engines.VM_CONTEXT0_PAGE_TABLE_BASE_ADDR, TABLE >> 12)
    w(engines.VM_CONTEXT0_PROTECTION_FAULT_DEFAULT_ADDR, DUMMY >> 12)
    w(engines.VM_CONTEXT0_CNTL2, 0)
    v = setField(c0, 0x1, 1)
    v = setField(v, 0x6, 0)
    v = setField(v, 0x10, 1)
    w(engines.VM_CONTEXT0_CNTL, v)
    w(engines.VM_L2_CONTEXT1_IDENTITY_APERTURE_LOW_ADDR, 0)
    w(engines.VM_L2_CONTEXT1_IDENTITY_APERTURE_HIGH_ADDR, 0)
    w(engines.VM_L2_CONTEXT_IDENTITY_PHYSICAL_OFFSET, 0)
    w(engines.VM_CONTEXT1_PAGE_TABLE_START_ADDR, 0)
    w(engines.VM_CONTEXT1_PAGE_TABLE_END_ADDR, 0x1000000 - 1)
    var space: usize = 1
    while space < 8 {
        w(0x54F + space, TABLE >> 12)
        space += 1
    }
    while space < 16 {
        w(0x50E + space - 8, TABLE >> 12)
        space += 1
    }
    w(engines.VM_CONTEXT1_PROTECTION_FAULT_DEFAULT_ADDR, DUMMY >> 12)
    w(engines.VM_CONTEXT1_CNTL2, 4)
    v = setField(c1, 0x1, 1)
    v = setField(v, 0x6, 1)
    const defaults = [_]usize{ 0x10, 0x80, 0x400, 0x2000, 0x10000, 0x80000, 0x400000 }
    for bit in defaults { v = setField(v, bit, 1) }
    v = setField(v, 0xF000000, 1)
    w(engines.VM_CONTEXT1_CNTL, v)
    w(engines.VM_CONTEXT1_CNTL, v)
    w(engines.VM_INVALIDATE_REQUEST, 1)
    const differs = card.writesFrom(from, numbers[0..listed], values[0..listed])
    // (The writes after the flush: the alive check and the window's reads,
    // as in m2List.)
    expect(differs == N || differs >= listed, "M2 over the firmware's words: write for write, every bit it does not set kept")
    if differs != N && differs < listed && show {
        say("the first difference at write ")
        hexSay(differs)
        say(", register ")
        hexSay(card.writtenTo[from + differs])
        say(" value ")
        hexSay(card.writtenWith[from + differs])
        say("\n")
    }
    line("gpu: 0x1528 was 0x1 now 0x0\n")
    line("gpu: 0x80e was 0xf4fffff now 0xf5fffff\n")
    line("gpu: 0x80c was 0x123 now 0x0\n")
    line("gpu: 0x80a was 0x0 now 0xfffffff\n")
    line("gpu: 0x80b was 0x10 now 0xfffffff\n")
    line("gpu: 0xbd3 was 0x11 now 0x10\n")
    line("; system aperture 0xf400000000..0xf5ffffffff (")
    // The same words, and a register that does not hold: every one of
    // them back as the firmware had it.
    expect(upToM1(false), "S0 and M1")
    card.registers[engines.MC_VM_MX_L1_TLB_CNTL] = l1
    card.registers[engines.VM_L2_CNTL] = l2
    card.registers[engines.VM_L2_CNTL3] = l23
    card.registers[engines.VM_L2_CNTL4] = l24
    card.registers[engines.VM_CONTEXT0_CNTL] = c0
    card.registers[engines.VM_CONTEXT1_CNTL] = c1
    card.registers[engines.MC_VM_AGP_BASE] = 0x123
    card.registers[engines.MC_VM_AGP_BOT] = 0x10
    card.registers[engines.HDP_REG_COHERENCY_FLUSH_CNTL] = 1
    card.registers[engines.MC_VM_SYSTEM_APERTURE_HIGH_ADDR] = 0x0F4FFFFF
    card.registers[engines.HDP_MISC_CNTL] = 0x11
    keepRegisters()
    card.stuck = engines.VM_CONTEXT1_PAGE_TABLE_END_ADDR
    expect(!engines.gart(&e), "a register that does not hold over the firmware's words: M2 fails")
    expect(asFound(), "every word back as the firmware had it, its own bits too")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn theBusyController() -> void {
    // The memory controller busy with more than the display's reading,
    // for good: each of Linux's two waits ends at its 100 ms, says so, and
    // the step goes on as Linux does.
    expect(upToM1(false), "S0 and M1")
    card.mcBusy = true
    const paused = card.pauses
    expect(engines.gart(&e), "a memory controller that stays busy: M2 goes on as Linux does")
    expect(card.count("gpu: the memory controller is not idle after 100 ms (0xa00): Linux goes on, so does the step\n") == 2, "said at both waits")
    line("gpu: memory controller busy bits over 1 ms: display 1000 of 1000, others 1000 of 1000\n")
    expect(card.pauses - paused >= 2 * engines.AMDGPU_MAX_USEC_TIMEOUT && card.pauses - paused < 2 * engines.AMDGPU_MAX_USEC_TIMEOUT + 2000, "each wait ends at Linux's count")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn theFrames() -> void {
    // Frames 2 % slower after the GART comes on: M2 fails and goes back.
    expect(upToM1(false), "S0 and M1")
    keepRegisters()
    card.slowAt = engines.VM_CONTEXT0_CNTL
    card.slowTo = 58780
    expect(!engines.gart(&e) && asFound(), "frames 2 % off: M2 fails, every register back")
    line("gpu: step M2 failed: the picture's frames: 59.97 Hz before, 58.")
    // Half a per cent is the measuring's own: M2 passes.
    expect(upToM1(false), "S0 and M1")
    card.slowAt = engines.VM_CONTEXT0_CNTL
    card.slowTo = 59680
    expect(engines.gart(&e), "frames half a per cent off: M2 passes")
}

fn theOverflow() -> void {
    // The ring overflows (the card says so in its write pointer): the
    // entries are taken from the one after the write pointer, as Linux
    // does, and the overflow cleared (IH_RB_CNTL's bit 31).
    expect(upToM2(), "S0, M1, M2")
    card.overflow = true
    card.pending = 3
    const from = card.written
    expect(engines.interrupts(&e), "an overflow: I1 passes")
    shown()
    var cleared = false
    var k = from
    while k < card.written && k < card.WRITES {
        if card.writtenTo[k] == engines.IH_RB_CNTL && card.writtenWith[k] & engines.IH_RB_CNTL__WPTR_OVERFLOW_CLEAR != 0 && card.writtenWith[k] & engines.IH_RB_CNTL__RB_ENABLE != 0 { cleared = true }
        k += 1
    }
    expect(cleared, "the overflow cleared as Linux clears it")
    expect(e.entries == 4095 && e.readPointer == 48, "taken from the entry after the write pointer round to it")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) == 2
    if !card.makeRom(true) {
        say("the ROM could not be made\n")
        return 5
    }
    const names = [_][]const u8{ "polaris10_pfp_2.bin", "polaris10_me_2.bin", "polaris10_ce_2.bin", "polaris10_mec_2.bin", "polaris10_rlc.bin", "polaris10_sdma.bin", "polaris10_sdma1.bin", "polaris10_k_smc.bin", "polaris10_smc_sk.bin" }
    for name in names {
        if !card.load(name) {
            say("the firmware files could not be read (run from the repository's top)\n")
            return 6
        }
    }
    theAperture()
    theGart()
    theRing()
    theStages()
    theFirmwareWords()
    theBusyController()
    theFrames()
    theOverflow()
    if failed != 0 { return failed }
    return 13
}
