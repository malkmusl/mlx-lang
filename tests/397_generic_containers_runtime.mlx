// Generic containers over an allocator: a list used as the element of a
// list, a map built from a list inside another generic, a body constant
// (`Entry`) used by fields and methods.
const std = @import("std")

fn List(comptime T: type) -> type {
    return struct {
        items: [*]T
        length: usize
        capacity: usize
        allocator: std.allocator.Allocator

        pub fn init(allocator: std.allocator.Allocator) -> Self {
            unsafe {
                return Self.{ .items = @ptrCast([*]T, allocator.alloc(4 * @sizeOf(T), @alignOf(T)).?), .length = 0, .capacity = 4, .allocator = allocator }
            }
        }

        pub fn push(self: *Self, value: T) -> void {
            if self.*.length == self.*.capacity {
                unsafe {
                    const grown = @ptrCast([*]T, self.*.allocator.alloc(self.*.capacity * 2 * @sizeOf(T), @alignOf(T)).?)
                    var index: usize = 0
                    while index < self.*.length {
                        grown[index] = self.*.items[index]
                        index += 1
                    }
                    self.*.allocator.free(@ptrCast([*]u8, self.*.items), self.*.capacity * @sizeOf(T), @alignOf(T))
                    self.*.items = grown
                }
                self.*.capacity *= 2
            }
            self.*.items[self.*.length] = value
            self.*.length += 1
        }

        pub fn at(self: *Self, index: usize) -> ?*T {
            if index >= self.*.length { return null }
            return &self.*.items[index]
        }

        pub fn get(self: *Self, index: usize) -> ?T {
            if index >= self.*.length { return null }
            return self.*.items[index]
        }

        pub fn slice(self: *Self) -> []T {
            return self.*.items[0..self.*.length]
        }

        pub fn release(self: *Self) -> void {
            unsafe { self.*.allocator.free(@ptrCast([*]u8, self.*.items), self.*.capacity * @sizeOf(T), @alignOf(T)) }
        }
    }
}

fn Map(comptime K: type, comptime V: type) -> type {
    const Entry = struct {
        key: K
        value: V
    }
    return struct {
        entries: List(Entry)

        pub fn init(allocator: std.allocator.Allocator) -> Self {
            return Self.{ .entries = List(Entry).init(allocator) }
        }

        pub fn put(self: *Self, key: K, value: V) -> void {
            self.*.entries.push(Entry.{ .key = key, .value = value })
        }

        pub fn get(self: *Self, key: K) -> ?V {
            var index: usize = 0
            while index < self.*.entries.length {
                const entry = self.*.entries.at(index).?
                if entry.*.key == key { return entry.*.value }
                index += 1
            }
            return null
        }

        pub fn count(self: *Self) -> usize {
            return self.*.entries.length
        }
    }
}

fn main() -> u8 {
    const allocator = std.page_allocator.init()
    var rows = List(List(u8)).init(allocator)
    var row = List(u8).init(allocator)
    row.push(7)
    row.push(9)
    rows.push(row)
    var second = List(u8).init(allocator)
    second.push(1)
    rows.push(second)
    const first = rows.at(0).?
    if first.*.length != 2 { return 1 }
    if first.*.get(1).? != 9 { return 2 }
    if rows.at(1).?.*.get(0).? != 1 { return 3 }
    if rows.get(5) != null { return 4 }
    const total = first.*.slice()[0] + first.*.slice()[1]
    if total != 16 { return 5 }

    var ages = Map(u8, u32).init(allocator)
    ages.put(1, 30)
    ages.put(2, 0)
    ages.put(3, 40)
    if ages.count() != 3 { return 6 }
    const found = ages.get(3)
    if found == null { return 7 }
    if found.? != 40 { return 8 }
    const zero = ages.get(2)
    if zero == null { return 9 }
    if zero.? != 0 { return 10 }
    if ages.get(4) != null { return 11 }

    var names = Map(u32, []const u8).init(allocator)
    names.put(5, "five")
    const name = names.get(5)
    if name == null { return 12 }
    if name.?.length != 4 { return 13 }
    var index: usize = 0
    while index < 10 {
        row.push(@intCast(u8, index))
        index += 1
    }
    if row.length != 12 { return 14 }
    return 13
}
