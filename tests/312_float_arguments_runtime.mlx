// Functions mixing integer and float parameters past the sixth integer
// register, and `@intFromFloat(T, value)` without a declared result type.
// Older compilers took @intFromFloat for a one-argument builtin, so its
// result had no type unless a declaration supplied one. Exits 13 when
// every check holds, else the number of the first check that failed.
fn many(r0: usize, r1: usize, r2: usize, r3: usize, r4: usize, r5: usize, r6: usize, x0: f64) -> usize {
    return r0 + r1 + r2 + r3 + r4 + r5 + r6 + @intFromFloat(usize, x0)
}

fn mixed(a: usize, x0: f64, b: usize, c: usize, d: usize, e: usize, f: usize, g: usize, x1: f64) -> usize {
    return a + b + c + d + e + f + g + @intFromFloat(usize, x0 + x1)
}

fn convert(x0: f64) -> usize { return @intFromFloat(usize, x0) }

pub fn main() -> u8 {
    if many(1, 2, 3, 4, 5, 6, 7, 2.0) != 30 { return 1 }
    if mixed(1, 2.0, 3, 4, 5, 6, 7, 8, 1.0) != 37 { return 2 }
    if convert(3.75) != 3 { return 3 }
    const whole = @intFromFloat(i64, -2.25)
    if whole != -2 { return 4 }
    return 13
}
