// The kernel's stage 5 toward a Radeon that takes commands, its last two
// steps (projects/brix/kernel/gpu_compute.mlx's G3 and G4, through
// gpu_ring.mlx, the ring as an interface; built for the host), against the
// user's RX 580 as a table whose compute processor runs its queues as
// Linux's code counts on (tests/support/mec_card.mlx), after stages 0 to 4
// and G1, G2 passed, with the study's steps (gpu-accel-kernel.verified.md
// 5.5 to 5.11, 4.5, 8.4 G3 and G4, 8.7) written out here a second time,
// write for write and word for word:
// - G3: the idle interrupts off, the KIQ named to the RLC (0x48, then with
//   0x80), its queue selected (2, 1, 0), its descriptor as
//   gfx_v8_0_mqd_init makes it, field by field (struct vi_mqd's words, the
//   allocation's two masks), its registers written from it in
//   gfx_v8_0_mqd_commit's order; the compute processor unhalted; ring 0's
//   descriptor (1, 0, 0) field by field; the doorbells' range 0 to 0x5c and
//   on; the KIQ's first submission SET_RESOURCES and MAP_QUEUES word for
//   word, padded to 256, by the KIQ's doorbell 0; the map taken; the KIQ's
//   ring test, then ring 0's (by doorbell 0x10), word for word; the idle
//   interrupts on; its line;
// - G3's failures, each with every register as before, the queues let go
//   and the processors halted: the compute processor dead (both trials),
//   the KIQ refusing the map (both trials), the KIQ not answering its test
//   (no unmap), ring 0 not answering (taken back through the KIQ), the
//   picture, the card gone; the study's second trial when the map is
//   taken only after the graphics ring ran its clear state: everything of
//   the first put back, the graphics ring's registers and its first
//   submission of 916 words (885 values of the clear state) word for word,
//   its ring test, then the map: the line says which order worked; the
//   refusals (no G2, no doorbells, the mark);
// - G4: CP_ME1_PIPE0_INT_CNTL's end-of-pipe interrupt on; Linux's indirect
//   buffer test on ring 0: the buffer's five words and the frame's thirty
//   (ACQUIRE_MEM, the host path's flush with bit CP2, the buffer valid in
//   address space 0, the host path's invalidate, RELEASE_MEM with the
//   interrupt) word for word, the word written, fence 1, the interrupt
//   ring's entry of source 181 and ring 0x04, its interrupt; its failures
//   (no entry, no fence, a ring that does not read: hung and taking no new
//   work, a privileged register fault, no interrupt) with the interrupt's
//   word as before; refused without G3;
// - the ring interface beside: refusals of `submit`, the KIQ's fence, the
//   graphics ring's frame of 38 words (SURFACE_SYNC, COND_EXEC with its
//   count patched, the flush by the pre-fetch parser, the two
//   EVENT_WRITE_EOP), a wait by the fence word alone;
// - the way down: ring 0 taken back through the KIQ (UNMAP_QUEUES and the
//   KIQ's test word for word), the processors halted, the queues let go,
//   the RLC off, then the copy engines, the interrupt ring, the doorbells;
// - the review's cards: the way down on a card whose halted compute
//   processor does no dequeue (the queues dequeued first, with 2, then the
//   halt; both queues' request word and pointers 0; after the watch's
//   second mark the wait bounded and said), queues that write no read
//   pointer back (the map taken: no second trial), a KIQ 50 ms late
//   (passes) and 150 ms late (fails, no unmap), an end-of-pipe entry of
//   another ring, a buffer the queue passes over, the card gone while G4
//   waits, a boot of stage 5 on a card left running, what `submit`
//   refuses (no words, a length beyond 20 bits, an address off 4 bytes or
//   beyond 48 bits, an address space beyond 15);
// - the watch: after a failed F1, and while rings run: at 85 C no new work
//   (G4 refused, submit refused), below it again work, at 95 C every ring
//   stopped; once a second;
// - through all of it no register of the display's is written.
// With an argument the log of every case is printed.
// Exits 13.
const std = @import("std")
const engines = @import("../projects/brix/kernel/gpu_engines.mlx")
const loaded = @import("../projects/brix/kernel/gpu_smc_sdma.mlx")
const compute = @import("../projects/brix/kernel/gpu_compute.mlx")
const ring = @import("../projects/brix/kernel/gpu_ring.mlx")
const card = @import("./support/engine_card.mlx")
const smc = @import("./support/smc_card.mlx")
const mec = @import("./support/mec_card.mlx")
const crash = @import("std.crash")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn hex(value: usize) -> void {
    var digits: usize = 1
    while digits < 16 && (value >> @intCast(u6, digits * 4)) != 0 { digits += 1 }
    var text: [18]u8 = undefined
    text[0] = 48
    text[1] = 120
    var k: usize = 0
    while k < digits {
        const digit = (value >> @intCast(u6, (digits - 1 - k) * 4)) & 15
        text[2 + k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(text[0..2 + digits])
}

fn shown() -> void {
    if show {
        say(card.log[0..card.logged])
        say("--\n")
    }
}

const N = card.NEVER
const GART: usize = 0xFF00000000
const NOP: usize = 0xFFFF1000

var e: engines.Engines = undefined
var l: loaded.Loaded = undefined
var c: compute.Compute = undefined
var where: engines.Card = undefined

fn fresh(stage: usize) -> void {
    mec.reset()
    card.picture(0, 1280, 960, 1800, 1000)
    card.registers[loaded.SMC_RESP_0] = 1
    where = engines.Card.{ .device = 0x67DF, .revision = 0xE7, .view = card.VIEW, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .dmaBase = card.DMA_BASE, .dmaPages = 2048, .rom = &card.machine }
    const hands = mec.hands()
    engines.begin(&e, &hands, &where, stage)
    const more = mec.more()
    loaded.begin(&l, &more)
    compute.begin(&c)
}

// Stages 0 to 4, G1 and G2 at a boot that goes to stage 5.
fn upToG2() -> bool {
    fresh(5)
    engines.run(&e)
    if e.i1 != engines.Outcome.passed { return false }
    if !loaded.smcFirmware(&e, &l) || !loaded.engineFirmware(&e, &l) || !loaded.firstEngine(&e, &l) || !loaded.bothEngines(&e, &l) { return false }
    return compute.settings(&e, &l, &c) && compute.rlc(&e, &l, &c)
}

fn upToG3() -> bool {
    if !upToG2() { return false }
    return compute.queues(&e, &l, &c)
}

// The whole of stage 5 at a boot, as gpu.mlx runs it.
fn boot() -> void {
    fresh(5)
    engines.run(&e)
    compute.run(&e, &l, &c)
}

fn gart(physical: usize) -> usize { return GART + physical - card.DMA_BASE }

// ---- The writes a step is wanted to make.

const WANT: usize = 1024
var wantNumber: [WANT]usize = undefined
var wantValue: [WANT]usize = undefined
var wanted: usize = 0

fn want(number: usize, value: usize) -> void {
    wantNumber[wanted] = number
    wantValue[wanted] = value
    wanted += 1
}

fn writesAre(from: usize, what: []const u8) -> bool {
    const at = card.writesFrom(from, wantNumber[0..wanted], wantValue[0..wanted])
    if at == N { return true }
    say("the writes of ")
    say(what)
    say(" differ from the study's at write ")
    hex(at)
    if at < wanted {
        say(": wanted register ")
        hex(wantNumber[at])
        say(" = ")
        hex(wantValue[at])
    }
    if from + at < card.written && from + at < card.WRITES {
        say(", written register ")
        hex(card.writtenTo[from + at])
        say(" = ")
        hex(card.writtenWith[from + at])
    }
    say("\n")
    return false
}

fn wantCool(index: usize) -> void {
    want(engines.SMC_IND_INDEX_11, engines.ixCG_MULT_THERMAL_STATUS)
    want(engines.SMC_IND_INDEX_11, index)
}

// The scratch register given a value and put back (what it held).
fn wantAlive(was: usize) -> void {
    want(engines.SCRATCH_REG0, engines.SCRATCH_TRIAL)
    want(engines.SCRATCH_REG0, was)
}

fn memoryWord(at: usize) -> usize { return @intCast(usize, card.memoryRead(at)) }

fn memoryIs(at: usize, words: []const usize) -> bool {
    var k: usize = 0
    while k < words.length {
        if memoryWord(at + 4 * k) != words[k] {
            say("the word at ")
            hex(at + 4 * k)
            say(" is ")
            hex(memoryWord(at + 4 * k))
            say(", not ")
            hex(words[k])
            say("\n")
            return false
        }
        k += 1
    }
    return true
}

// Whether the ring's words from `from` (words) up to `to` are NOPs.
fn nopsFrom(at: usize, from: usize, to: usize) -> bool {
    var k = from
    while k < to {
        if memoryWord(at + 4 * k) != NOP { return false }
        k += 1
    }
    return true
}

// ---- The queue descriptor, from the study's 5.6 table.

const KIQ: usize = 0
const RING0: usize = 1

var mqd: [516]usize = undefined

// What the card's registers of a queue held (mec_card.mlx's defaults; the
// doorbell word and the four engine_card.mlx keeps: 0).
fn held(q: usize, number: usize) -> usize {
    if number == compute.CP_HQD_PQ_DOORBELL_CONTROL { return 0 }
    return mec.queueDefault(q, number - 0x3245)
}

fn expectedMqd(which: usize) -> void {
    const me: usize = if which == KIQ { 2 } else { 1 }
    const pipe: usize = if which == KIQ { 1 } else { 0 }
    const q = mec.queueOf(me, pipe, 0)
    const doorbell: usize = if which == KIQ { 0 } else { 0x10 }
    const record = c.writeBack + 32 * which
    var k: usize = 0
    while k < 516 {
        mqd[k] = 0
        k += 1
    }
    mqd[514] = 0xFFFFFFFF
    mqd[515] = 0xFFFFFFFF
    mqd[0] = 0xC0310800
    mqd[11] = 1
    mqd[23] = 0xFFFFFFFF
    mqd[24] = 0xFFFFFFFF
    mqd[26] = 0xFFFFFFFF
    mqd[27] = 0xFFFFFFFF
    mqd[32] = 3
    const address = gart(c.mqd[which])
    mqd[126] = (address + 2056) & 0xFFFFFFFF
    mqd[127] = (address + 2056) >> 32
    mqd[128] = address & 0xFFFFFFFC
    mqd[129] = address >> 32
    mqd[130] = if which == KIQ { 1 } else { 0 }
    mqd[131] = 0
    mqd[132] = (held(q, 0x3249) & ~@intCast(usize, 0x3FF00)) | (0x53 << 8)
    mqd[135] = held(q, 0x324C)
    const base = gart(c.rings[which]) >> 8
    mqd[136] = base & 0xFFFFFFFF
    mqd[137] = base >> 32
    mqd[138] = 0
    mqd[139] = gart(record) & 0xFFFFFFFC
    mqd[140] = (gart(record) >> 32) & 0xFFFF
    mqd[141] = gart(record + 4) & 0xFFFFFFFC
    mqd[142] = (gart(record + 4) >> 32) & 0xFFFF
    mqd[143] = (doorbell << 2) | 0x40000000
    mqd[144] = 0
    mqd[145] = (held(q, 0x3256) & ~@intCast(usize, 0x3F | 0x3F00 | 0x10000000 | 0x20000000)) | 10 | (9 << 8) | 0x40000000 | 0x80000000
    mqd[149] = (held(q, 0x325A) & ~@intCast(usize, 0x300000 | 0x18000000)) | (3 << 20) | (3 << 27)
    mqd[150] = (held(q, 0x325B) & ~@intCast(usize, 0x18000000)) | (3 << 27)
    mqd[162] = held(q, 0x3267) & ~@intCast(usize, 0xF)
    const eop = gart(c.eop[which]) >> 8
    mqd[165] = eop & 0xFFFFFFFF
    mqd[166] = eop >> 32
    mqd[167] = (held(q, 0x326C) & ~@intCast(usize, 0x3F)) | 9
    mqd[168] = held(q, 0x326D)
    mqd[169] = held(q, 0x326E)
    mqd[170] = held(q, 0x326F)
    mqd[171] = held(q, 0x3270)
    mqd[172] = held(q, 0x3271)
    mqd[173] = (held(q, 0x3272) & ~@intCast(usize, 0x6)) | (3 << 1)
    mqd[174] = held(q, 0x3273)
    mqd[175] = held(q, 0x3274)
    mqd[176] = held(q, 0x3275)
    mqd[177] = held(q, 0x3276)
    mqd[179] = held(q, 0x3278)
    mqd[180] = held(q, 0x3279)
    mqd[181] = held(q, 0x327A)
}

// The descriptor in memory as the table gives it, word for word.
fn mqdHolds(which: usize, what: []const u8) -> bool {
    expectedMqd(which)
    var k: usize = 0
    while k < 516 {
        if memoryWord(c.mqd[which] + 4 * k) != mqd[k] {
            say(what)
            say(": descriptor word ")
            hex(k)
            say(" is ")
            hex(memoryWord(c.mqd[which] + 4 * k))
            say(", not ")
            hex(mqd[k])
            say("\n")
            return false
        }
        k += 1
    }
    return true
}

// gfx_v8_0_mqd_commit's writes from the KIQ's descriptor.
fn wantCommit(poll: usize) -> void {
    expectedMqd(KIQ)
    want(0x3083, poll & ~@intCast(usize, 0x80000000))
    var r: usize = 0x3248
    while r <= 0x326C {
        want(r, mqd[r - 0x3245 + 128])
        r += 1
    }
    want(0x326D, mqd[168])
    want(0x326E, mqd[169])
    want(0x3279, mqd[180])
    r = 0x326F
    while r <= 0x3278 {
        want(r, mqd[r - 0x3245 + 128])
        r += 1
    }
    want(0x3245, mqd[128])
    want(0x3246, mqd[129])
    want(0x3247, mqd[130])
}

// The registers before a step, and whether those the step wrote are as
// they were (but the scratch register, the SMC's index, the selectors,
// the interrupt ring's read pointer and the `but` words), each queue's
// registers too.
var before: [card.ROOM]usize = undefined
var queuesBefore: [mec.QUEUES][mec.WORDS]usize = undefined

fn keep() -> void {
    var k: usize = 0
    while k < card.ROOM {
        before[k] = card.registers[k]
        k += 1
    }
    var q: usize = 0
    while q < mec.QUEUES {
        var w: usize = 0
        while w < mec.WORDS {
            queuesBefore[q][w] = mec.queueRegs[q][w]
            w += 1
        }
        q += 1
    }
}

fn asBefore(from: usize, but: []const usize) -> bool {
    var k = from
    while k < card.written && k < card.WRITES {
        const number = card.writtenTo[k]
        var spared = number == engines.SCRATCH_REG0 || number == engines.SMC_IND_INDEX_11 || number == engines.SRBM_GFX_CNTL || number == loaded.GRBM_GFX_INDEX || number == engines.IH_RB_RPTR || (number >= mec.FIRST && number <= mec.LAST)
        for b in but {
            if b == number { spared = true }
        }
        if !spared && card.registers[number] != before[number] {
            say("register ")
            hex(number)
            say(" is ")
            hex(card.registers[number])
            say(", was ")
            hex(before[number])
            say("\n")
            return false
        }
        k += 1
    }
    var q: usize = 0
    while q < mec.QUEUES {
        var w: usize = 0
        while w < mec.WORDS {
            const number = mec.FIRST + w
            // (A queue the KIQ mapped has the registers the compute
            // processor loaded from its descriptor: the card's doing.)
            const mapped = mec.maps != 0 && q == mec.mappedQueue
            if !mapped && number != engines.CP_HQD_ACTIVE && mec.queueRegs[q][w] != queuesBefore[q][w] {
                say("a queue's register ")
                hex(number)
                say(" of queue ")
                hex(q)
                say(" is ")
                hex(mec.queueRegs[q][w])
                say(", was ")
                hex(queuesBefore[q][w])
                say("\n")
                return false
            }
            w += 1
        }
        q += 1
    }
    return card.registers[engines.SRBM_GFX_CNTL] == 0
}

// The processors halted and both queues let go.
fn halted() -> bool {
    return card.registers[engines.CP_MEC_CNTL] == 0x50000000 && card.registers[engines.CP_ME_CNTL] & 0x15000000 == 0x15000000 && card.queueActive[mec.queueOf(2, 1, 0)] == 0 && card.queueActive[mec.queueOf(1, 0, 0)] == 0
}

// ---- G3.

fn theQueues() -> void {
    expect(upToG2(), "S0 to G2 at stage 5")
    keep()
    const from = card.written
    const bells = smc.bells
    const index = card.registers[engines.SMC_IND_INDEX_11]
    const interrupts = card.registers[loaded.CP_INT_CNTL_RING0]
    const schedulers = card.registers[engines.RLC_CP_SCHEDULERS]
    const poll = card.registers[0x3083]
    const status = card.registers[engines.CP_PQ_STATUS]
    expect(compute.queues(&e, &l, &c), "G3 on the user's card")
    shown()
    wanted = 0
    wantCool(index)
    want(0x306A, interrupts & ~@intCast(usize, 0x3C0000))
    want(0xECAA, (schedulers & 0xFFFFFF00) | 0x48)
    want(0xECAA, (schedulers & 0xFFFFFF00) | 0xC8)
    want(0x391, 0x9)
    wantCommit(poll)
    want(0x391, 0)
    want(0x208D, 0)
    want(0x391, 0x4)
    want(0x391, 0)
    want(0x305C, 0)
    want(0x305D, 0x5C)
    want(0x30B8, status | 2)
    want(0x391, 0x4)
    want(0x391, 0)
    want(0xC040, 0xCAFEDEAD)
    want(0xC040, 0xCAFEDEAD)
    want(0x306A, interrupts | 0x3C0000)
    wantCool(index)
    wantAlive(0xDEADBEEF)
    expect(writesAre(from, "G3"), "G3 write for write: the KIQ named, its registers from its descriptor in mqd_commit's order, the processor unhalted, the doorbells' range, the map's looks, the two scratch tests")
    expect(mqdHolds(KIQ, "the KIQ"), "the KIQ's descriptor field by field as gfx_v8_0_mqd_init makes it")
    expect(mqdHolds(RING0, "ring 0"), "ring 0's descriptor field by field")
    // The KIQ's ring: SET_RESOURCES and MAP_QUEUES, padded to 256; its
    // ring test after them.
    const descriptor = gart(c.mqd[1])
    const pointer = gart(c.writeBack + 32 + 4)
    const kiqWords = [_]usize{ 0xC006A000, 0, 1, 0, 0, 0, 0, 0, 0xC005A200, 0x20000000, 0x40, descriptor & 0xFFFFFFFF, descriptor >> 32, pointer & 0xFFFFFFFF, pointer >> 32 }
    expect(memoryIs(c.rings[0], kiqWords[0..]) && nopsFrom(c.rings[0], 15, 256), "the KIQ's first submission word for word, padded to 256")
    const scratchWords = [_]usize{ 0xC0017900, 0x40, 0xDEADBEEF }
    expect(memoryIs(c.rings[0] + 1024, scratchWords[0..]) && nopsFrom(c.rings[0], 259, 512), "the KIQ's ring test word for word after it")
    expect(memoryIs(c.rings[1], scratchWords[0..]) && nopsFrom(c.rings[1], 3, 256), "ring 0's ring test word for word")
    expect(smc.bells == bells + 3 && smc.bellIndex[bells] == 0 && smc.bellValue[bells] == 256 && smc.bellIndex[bells + 1] == 0 && smc.bellValue[bells + 1] == 512 && smc.bellIndex[bells + 2] == 0x10 && smc.bellValue[bells + 2] == 256, "the doorbells in order: the KIQ's 0 with 256 and 512, ring 0's 0x10 with 256")
    expect(memoryWord(c.writeBack + 4) == 512 && memoryWord(c.writeBack + 36) == 256 && memoryWord(c.writeBack) == 512 && memoryWord(c.writeBack + 32) == 256, "both records: the write pointers told, the read pointers written back")
    expect(mec.resources == 1 && mec.queueMask == 1 && mec.maps == 1 && mec.mappedQueue == mec.queueOf(1, 0, 0), "SET_RESOURCES with ring 0's bit, MAP_QUEUES for (1, 0, 0)")
    expect(c.kiq.up && c.compute.up && !c.graphics.up && !c.second, "the KIQ and ring 0 up, no graphics ring")
    line("gpu: step G3: KIQ (2.1.0) answers after 0 us; compute ring 0 (1.0.0) mapped through it after ")
    line(" us, its doorbell 0x10; Linux's order without the graphics ring; 41 C before, 41 C after; picture ")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn queuesFailWith(text: []const u8, what: []const u8) -> void {
    keep()
    const from = card.written
    const passed = compute.queues(&e, &l, &c)
    shown()
    expect(!passed && c.g3 == engines.Outcome.failed, what)
    expect(asBefore(from, [_]usize{ engines.CP_MEC_CNTL, engines.CP_ME_CNTL, engines.CP_HQD_DEQUEUE_REQUEST, engines.CP_HQD_PQ_RPTR, engines.CP_HQD_PQ_WPTR }[0..]) && halted(), "every register G3 wrote as before, the processors halted, the queues let go")
    expect(!c.kiq.up && !c.compute.up && !c.graphics.up, "no ring up")
    line(text)
    line("; the processors halted (ME 0x15000000, MEC 0x50000000), the queues let go, their words as before the step (")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn theQueuesFailures() -> void {
    expect(upToG2(), "S0 to G2")
    mec.mecDead = true
    queuesFailWith("gpu: step G3 failed: the KIQ did not take the map within 100 ms (compute ring 0's queue is not active; KIQ: read pointer 0x0 (the queue's own 0x0, its write pointer 0x100, active 0x1), write pointer 0x100, fence 0x0 of 0x0", "a compute processor that runs nothing: both trials fail")
    line("; in the second trial (the graphics ring before the map) as well")
    line("gpu: the KIQ did not take the map: KIQ read pointer 0x0")
    expect(upToG2(), "S0 to G2")
    mec.mapRefused = true
    queuesFailWith("gpu: step G3 failed: the KIQ did not take the map within 100 ms (compute ring 0's queue is not active; KIQ: read pointer 0x100 (the queue's own 0x100", "a KIQ that refuses the map")
    expect(mec.maps == 0 && mec.clearStates == 1, "no map, the graphics ring's clear state sent in the second trial")
    expect(upToG2(), "S0 to G2")
    mec.kiqMute = true
    queuesFailWith("gpu: step G3 failed: the KIQ did not write the scratch register within 100 ms (read pointer 0x200", "a KIQ that does not answer its test")
    expect(mec.unmaps == 0, "no unmap asked of a KIQ that does not answer")
    expect(upToG2(), "S0 to G2")
    mec.ringDeaf = true
    queuesFailWith("gpu: step G3 failed: compute ring 0 did not write the scratch register within 100 ms (read pointer 0x0 (the queue's own 0x0, its write pointer 0x100, active 0x1), write pointer 0x100", "ring 0 that does not answer")
    expect(mec.unmaps == 1, "ring 0 taken back through the KIQ")
    expect(upToG2(), "S0 to G2")
    card.scribbleAt = 0x305D
    queuesFailWith("gpu: step G3 failed: the picture's memory changed (sum ", "the picture minds")
    expect(upToG2(), "S0 to G2")
    card.goneAt = 0x305D
    expect(!compute.queues(&e, &l, &c) && c.g3 == engines.Outcome.failed, "the card gone: G3 fails")
    line("gpu: step G3 failed: the card no longer answers as it did; the processors halted")
    // The refusals: before any write.
    expect(upToG2(), "S0 to G2")
    c.g2 = engines.Outcome.failed
    var at = card.written
    expect(!compute.queues(&e, &l, &c) && c.g3 == engines.Outcome.refused && card.written == at, "no G2: refused before a write")
    line("gpu: step G3 refused: the RLC is not started (step G2)\n")
    expect(upToG2(), "S0 to G2")
    l.doorbellsOn = false
    at = card.written
    expect(!compute.queues(&e, &l, &c) && c.g3 == engines.Outcome.refused && card.written == at, "no doorbells: refused before a write")
    line("gpu: step G3 refused: the KIQ and the compute rings are told their write pointer by doorbell, and the doorbells are not on (step D2)\n")
    expect(upToG2(), "S0 to G2")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 85 << 9)
    at = card.written
    expect(!compute.queues(&e, &l, &c) && c.g3 == engines.Outcome.refused && card.written == at + 2, "85 C: G3 refused, only the temperature read")
    line("gpu: step G3 refused: the card is at 85 C (no step begins at 85 C or more)\n")
}

// The study's second trial: the map taken only once the graphics ring ran
// its clear state.
fn theSecondTrial() -> void {
    expect(upToG2(), "S0 to G2")
    mec.mapNeedsGraphics = true
    const bells = smc.bells
    expect(compute.queues(&e, &l, &c), "G3 in the second trial")
    shown()
    expect(c.second && c.graphics.up && c.compute.up && mec.maps == 1 && mec.clearStates == 1 && mec.contextValues == 887, "the graphics ring's clear state (885 values and the raster configuration's 2), then the map")
    line("gpu: the KIQ did not take the map: KIQ read pointer 0x100")
    line("; everything of the trial put back, the second trial (Linux's order with the graphics ring and its clear state before the map) follows\n")
    line("; in the second trial: the graphics ring and its clear state first (it answers after 0 us), as Linux's order has it")
    // The graphics ring's registers (gfx_v8_0_cp_gfx_resume, 5.6's table).
    const g = gart(c.rings[2])
    const rptr = gart(c.writeBack + 64)
    expect(card.registers[compute.CP_RB0_CNTL] == 0x0041880A && card.registers[compute.CP_RB0_BASE] == (g >> 8) & 0xFFFFFFFF && card.registers[compute.CP_RB0_BASE_HI] == g >> 40 && card.registers[compute.CP_RB0_RPTR_ADDR] == rptr & 0xFFFFFFFF && card.registers[compute.CP_RB0_RPTR_ADDR_HI] == (rptr >> 32) & 0xFF && card.registers[compute.CP_RB_DOORBELL_CONTROL] == 0x40000080 && card.registers[compute.CP_RB_DOORBELL_RANGE_LOWER] == 0x80 && card.registers[compute.CP_RB_DOORBELL_RANGE_UPPER] == 0x7FFFFC && card.registers[compute.CP_MAX_CONTEXT] == 7 && card.registers[compute.CP_DEVICE_ID] == 1 && card.registers[engines.CP_ME_CNTL] & 0x15000000 == 0, "the graphics ring's registers as cp_gfx_resume writes them, its processors unhalted")
    // Its first submission: 916 words, padded to 1024.
    const head = [_]usize{ 0xC0004A00, 0x20000000, 0xC0012800, 0x80000000, 0x80000000, 0xC0D46900, 0 }
    expect(memoryIs(c.rings[2], head[0..]), "the preamble, the context control, the first run's header and its register")
    const tail = [_]usize{ 0xC0026900, 0xD4, 0x16000012, 0x2A, 0xC0004A00, 0x30000000, 0xC0001200, 0, 0xC0021100, 3, 0x8000, 0x8000 }
    expect(memoryIs(c.rings[2] + 904 * 4, tail[0..]) && nopsFrom(c.rings[2], 916, 1024), "the raster configuration, the end of the clear state, CLEAR_STATE, SET_BASE: 916 words, then NOPs to 1024")
    const scratchWords = [_]usize{ 0xC0017900, 0x40, 0xDEADBEEF }
    expect(memoryIs(c.rings[2] + 1024 * 4, scratchWords[0..]), "the graphics ring's test after it")
    expect(smc.bellIndex[bells + 1] == 0x20 && smc.bellValue[bells + 1] == 1024 && smc.bellIndex[bells + 3] == 0x20 && smc.bellValue[bells + 3] == 1280, "the graphics ring told by its doorbell 0x20: its first submission, then its test")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

// ---- G4.

fn frameWords(buffer: usize, into: *[30]usize) -> void {
    const fence = gart(c.writeBack + 32 + 8)
    const words = [_]usize{ 0xC0055800, 0x28C40000, 0xFFFFFFFF, 0xFF, 0, 0, 0xA, 0xC0053C00, 0x43, 0x1537, 0x1538, 4, 4, 0x20, 0xC0023F00, gart(buffer) & 0xFFFFFFFC, (gart(buffer) >> 32) & 0xFFFF, 0x800005, 0xC0033700, 0x100000, 0xBCC, 0, 1, 0xC0054900, 0x38514, 0x22000000, fence & 0xFFFFFFFC, fence >> 32, 1, 0 }
    var k: usize = 0
    while k < 30 {
        into.*[k] = words[k]
        k += 1
    }
}

fn theEndOfPipe() -> void {
    expect(upToG3(), "S0 to G3")
    keep()
    card.interruptsOn = true
    card.waitingMessage = false
    const taken = card.messages
    const from = card.written
    const index = card.registers[engines.SMC_IND_INDEX_11]
    const entries = e.entries
    const pointer = e.readPointer
    expect(compute.endOfPipe(&e, &l, &c), "G4 on the user's card")
    shown()
    wanted = 0
    wantCool(index)
    want(0x3085, before[0x3085] | 0x4000000)
    want(engines.IH_RB_RPTR, (pointer + 16) & 0xFFFF)
    wantCool(index)
    wantAlive(card.registers[engines.SCRATCH_REG0])
    expect(writesAre(from, "G4"), "G4 write for write: the pipe's end-of-pipe interrupt on, the interrupt ring's read pointer told once the entry is taken, nothing else")
    const slot = gart(c.writeBack + 256)
    const buffer = [_]usize{ 0xC0033700, 0x00100500, slot & 0xFFFFFFFF, slot >> 32, 0xDEADBEEF }
    expect(memoryIs(c.buffers, buffer[0..]), "the indirect buffer's five words (gfx_v8_0_ring_test_ib)")
    var frame: [30]usize = undefined
    frameWords(c.buffers, &frame)
    expect(memoryIs(c.rings[1] + 1024, frame[0..]) && nopsFrom(c.rings[1], 256 + 30, 512), "the frame's thirty words after the ring test (the study's 5.10), then NOPs to 512")
    expect(memoryWord(c.writeBack + 256) == 0xDEADBEEF && memoryWord(c.writeBack + 40) == 1 && c.compute.done == 1, "the buffer's word written, fence 1")
    expect(e.entries == entries + 1 && mec.eopEntries == 1, "one entry in the interrupt ring")
    const entry = e.ring + ((e.readPointer - 16) & 0xFFFF)
    expect(memoryWord(entry) == 181 && memoryWord(entry + 8) == 4, "the entry: source 181, ring id 0x04 (micro engine 1, pipe 0, queue 0)")
    expect(card.messages == taken + 1, "its interrupt")
    expect(mec.buffers == 1 && mec.bufferSpace == 0 && mec.flushBits == 4 && mec.invalidates >= 1 && mec.syncs == 1, "the buffer run in address space 0, the flush by bit CP2, the invalidate, the memory sync")
    line("gpu: step G4: an indirect buffer of 5 words ran on compute ring 0: memory written, fence 1, end-of-pipe entry (source 181, ring 0x4) after ")
    line(" us, interrupts taken: 1; 41 C before, 41 C after; picture ")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn endFailsWith(text: []const u8, what: []const u8) -> void {
    keep()
    const from = card.written
    const passed = compute.endOfPipe(&e, &l, &c)
    shown()
    expect(!passed && c.g4 == engines.Outcome.failed, what)
    expect(asBefore(from, [_]usize{}[0..]) && card.registers[0x3085] == before[0x3085], "the interrupt's word as before")
    line(text)
    line("; the end-of-pipe interrupt's word as before (")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

fn theEndOfPipeFailures() -> void {
    expect(upToG3(), "S0 to G3")
    mec.noEntry = true
    endFailsWith("gpu: step G4 failed: compute ring 0's indirect buffer test did not end: the fence came, its end-of-pipe entry did not, within 1000 ms; read pointer 0x200", "no entry")
    expect(upToG3(), "S0 to G3")
    mec.noFenceWrite = true
    endFailsWith("gpu: step G4 failed: compute ring 0's indirect buffer test did not end: the fence did not come within 1000 ms; read pointer 0x200", "no fence")
    expect(!c.compute.hung, "a ring that read its words is not hung")
    expect(upToG3(), "S0 to G3")
    mec.ringDeaf = true
    endFailsWith("gpu: step G4 failed: compute ring 0's indirect buffer test did not end: the ring is hung: its read pointer did not move in 1000 ms; read pointer 0x100", "a ring that does not read")
    expect(c.compute.hung, "hung: no new work")
    line(" registers); compute ring 0 takes no new work")
    expect(ring.submit(&e, &l, &c.compute, gart(c.buffers), 5, 0) == ring.NONE, "a hung ring takes no submission")
    expect(upToG3(), "S0 to G3")
    mec.privFault = true
    endFailsWith("gpu: step G4 failed: compute ring 0's indirect buffer test did not end: a privileged register fault for the ring (data 0x1234); read pointer", "a privileged register fault")
    expect(upToG3(), "S0 to G3")
    card.interruptsOn = true
    card.waitingMessage = false
    card.noMessage = true
    endFailsWith("gpu: step G4 failed: the end-of-pipe entry came and its interrupt did not", "no interrupt")
    // Refused without G3.
    expect(upToG2(), "S0 to G2")
    const at = card.written
    expect(!compute.endOfPipe(&e, &l, &c) && c.g4 == engines.Outcome.refused && card.written == at, "no G3: refused")
    line("gpu: step G4 refused: compute ring 0 does not run (step G3)\n")
}

// ---- The ring interface beside stage 5's use of it.

fn theInterface() -> void {
    expect(ring.ringId(1, 0, 0) == 4 && ring.ringId(2, 1, 0) == 9 && ring.ringId(1, 3, 7) == 0x77, "the ring ids gfx_v8_0_eop_irq reads")
    expect(ring.nop() == NOP && ring.packet3(ring.PACKET3_SET_UCONFIG_REG, 1) == 0xC0017900, "the NOP and a header")
    expect(upToG3(), "S0 to G3")
    // Refusals: the KIQ, a program's address space, a refused ring.
    const at = c.compute.wptr
    expect(ring.submit(&e, &l, &c.kiq, gart(c.buffers), 5, 0) == ring.NONE && ring.submit(&e, &l, &c.compute, gart(c.buffers), 5, 1) == ring.NONE && c.compute.wptr == at, "no buffer on the KIQ, none in a program's address space before stage 7, nothing written")
    c.compute.refused = true
    expect(ring.submit(&e, &l, &c.compute, gart(c.buffers), 5, 0) == ring.NONE && c.compute.wptr == at, "a refused ring takes nothing")
    c.compute.refused = false
    // A submission waited for by the fence word alone, twice: fences 1 and 2.
    const slot = gart(c.writeBack + 256)
    const words = [_]usize{ 0xC0033700, 0x00100500, slot & 0xFFFFFFFF, slot >> 32, 0x12345678 }
    var k: usize = 0
    while k < 5 {
        smc.memoryWrite(c.buffers + 4 * k, @intCast(u32, words[k]))
        k += 1
    }
    var fence = ring.submit(&e, &l, &c.compute, gart(c.buffers), 5, 0)
    expect(fence == 1 && ring.wait(&e, &l, &c.compute, fence, false, 1000) == ring.Waited.done, "fence 1 by its word")
    fence = ring.submit(&e, &l, &c.compute, gart(c.buffers), 5, 0)
    expect(fence == 2 && ring.wait(&e, &l, &c.compute, fence, false, 1000) == ring.Waited.done && memoryWord(c.writeBack + 256) == 0x12345678, "fence 2, the word written")
    // The KIQ's fence (gfx_v8_0_ring_emit_fence_kiq), with its interrupt.
    const kiqAt = c.kiq.wptr
    ring.fence(&l, &c.kiq, 7, true)
    const record = gart(c.writeBack + 8)
    const kiqFence = [_]usize{ 0xC0033700, 0x00100500, record & 0xFFFFFFFF, record >> 32, 7, 0xC0033700, 0x100000, 0x30B5, 0, 0x20000000 }
    expect(memoryIs(c.rings[0] + kiqAt * 4, kiqFence[0..]), "the KIQ's fence and its interrupt's write, word for word")
    // The graphics ring's frame (the second trial brings it up): 38 words.
    expect(upToG2(), "S0 to G2")
    mec.mapNeedsGraphics = true
    expect(compute.queues(&e, &l, &c) && c.graphics.up, "G3 with the graphics ring")
    const g = &c.graphics
    const from = g.*.wptr
    fence = ring.submit(&e, &l, g, gart(c.buffers), 5, 0)
    const cond = gart(c.writeBack + 64 + 16)
    const back = gart(c.writeBack + 64 + 8)
    const frame = [_]usize{ 0xC0034300, 0x28C40000, 0xFFFFFFFF, 0, 0xA, 0xC0032200, cond & 0xFFFFFFFF, cond >> 32, 0, 28, 0xC0053C00, 0x143, 0x1537, 0x1538, 1, 1, 0x20, 0xC0023F00, gart(c.buffers) & 0xFFFFFFFC, (gart(c.buffers) >> 32) & 0xFFFF, 5, 0xC0033700, 0x40100000, 0xBCC, 0, 1, 0xC0044700, 0x38514, back & 0xFFFFFFFC, ((back >> 32) & 0xFFFF) | 0x20000000, 0, 0, 0xC0044700, 0x38514, back & 0xFFFFFFFC, ((back >> 32) & 0xFFFF) | 0x22000000, 1, 0 }
    expect(fence == 1 && memoryIs(c.rings[2] + from * 4, frame[0..]), "the graphics ring's frame of 38 words (the study's 5.10), the conditional count patched to 28")
    expect(memoryWord(c.writeBack + 64 + 16) == 1 && ring.wait(&e, &l, g, fence, false, 1000) == ring.Waited.done, "the conditional word 1, fence 1 by its word")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

// ---- The way down, and the stages of a boot.

fn theWayDown() -> void {
    boot()
    shown()
    expect(l.d2 == engines.Outcome.passed && c.g1 == engines.Outcome.passed && c.g2 == engines.Outcome.passed && c.g3 == engines.Outcome.passed && c.g4 == engines.Outcome.passed, "a boot of stage 5: every step")
    line("gpu: step F2: ")
    line(" (stage 5 starts them from there)")
    expect(card.after("gpu: step D2:", 0) < card.after("gpu: step G1:", 0) && card.after("gpu: step G1:", 0) < card.after("gpu: step G2:", 0) && card.after("gpu: step G2:", 0) < card.after("gpu: step G3:", 0) && card.after("gpu: step G3:", 0) < card.after("gpu: step G4:", 0), "D2, G1, G2, G3, G4 in order")
    const kiqAt = c.kiq.wptr
    const from = card.written
    compute.stop(&e, &l, &c)
    shown()
    // (gfx_v8_0_kcq_disable writes UNMAP_QUEUES and the KIQ's test commits it
    // with its own three words: one submission of nine words.)
    const unmap = [_]usize{ 0xC004A300, 0x20000001, 0x40, 0, 0, 0, 0xC0017900, 0x40, 0xDEADBEEF }
    expect(memoryIs(c.rings[0] + kiqAt * 4, unmap[0..]) && nopsFrom(c.rings[0], kiqAt + 9, kiqAt + 256), "UNMAP_QUEUES (reset queues, ring 0's doorbell) and the KIQ's test in one submission, word for word")
    expect(mec.unmaps == 1 && halted() && card.registers[engines.RLC_CNTL] & 1 == 0, "ring 0 taken back, the processors halted, the queues let go, the RLC off")
    expect(card.registers[engines.SDMA0_F32_CNTL] & 1 == 1 && card.registers[engines.IH_RB_CNTL] & 0x20001 == 0 && card.registers[engines.BIF_DOORBELL_APER_EN] == 0, "then the copy engines, the interrupt ring, the doorbells")
    line("gpu: stopped for the way down: compute ring 0 taken back through the KIQ, the block idle, processors halted (ME 0x15000000, MEC 0x50000000), the queues let go, RLC off (0x0)\n")
    expect(card.after("RLC off", 0) < card.after("copy engines halted", 0) && card.after("copy engines halted", 0) < card.after("interrupt ring off", 0), "the graphics block before the copy engines, then the interrupt ring")
    var k = from
    var display = false
    while k < card.written {
        if card.display(card.writtenTo[k]) { display = true }
        k += 1
    }
    expect(!display, "nothing of the display's on the way down")
    // A boot of stage 4: nothing of stage 5; the way down as stage 4's.
    fresh(4)
    engines.run(&e)
    compute.run(&e, &l, &c)
    expect(l.d2 == engines.Outcome.passed && c.g1 == engines.Outcome.not_tried, "stage 4: no stage 5")
    compute.stop(&e, &l, &c)
    noLine("RLC off")
}

// ---- The review's cards (each a case the first tests did not hold).

// The first write at or after `from` of `number` with `value` (N: none).
fn writeAt(from: usize, number: usize, value: usize) -> usize {
    var k = from
    while k < card.written && k < card.WRITES {
        if card.writtenTo[k] == number && card.writtenWith[k] == value { return k }
        k += 1
    }
    return N
}

// The way down on a card whose dequeue a halted compute processor does
// not carry out: the KIQ (never unmapped, as in Linux) is dequeued with 2
// while the processor runs, then the processors are halted
// (gfx_v8_0_pre_soft_reset's order, the study's 8.7); both queues get the
// request word and their pointers 0, active or not (deactivate_hqd).
fn theWayDownInOrder() -> void {
    boot()
    const from = card.written
    const asked = mec.dequeueAsked
    compute.stop(&e, &l, &c)
    shown()
    expect(mec.dequeueAsked == asked + 1 && mec.dequeueValue == 2, "the KIQ dequeued once, with 2 (reset queues)")
    expect(halted(), "both queues let go, the processors halted")
    line("the block idle, processors halted (ME 0x15000000, MEC 0x50000000), the queues let go, RLC off (0x0)\n")
    const dequeue = writeAt(from, engines.CP_HQD_DEQUEUE_REQUEST, 2)
    const halt = writeAt(from, engines.CP_MEC_CNTL, 0x50000000)
    expect(dequeue != N && halt != N && dequeue < halt, "the dequeue asked before the compute processor is halted")
    const ring0 = writeAt(from, engines.SRBM_GFX_CNTL, 0x4)
    expect(ring0 != N && card.writtenTo[ring0 + 1] == engines.CP_HQD_DEQUEUE_REQUEST && card.writtenWith[ring0 + 1] == 0 && card.writtenTo[ring0 + 2] == engines.CP_HQD_PQ_RPTR && card.writtenWith[ring0 + 2] == 0 && card.writtenTo[ring0 + 3] == engines.CP_HQD_PQ_WPTR && card.writtenWith[ring0 + 3] == 0, "ring 0, unmapped and inactive: its request word and pointers 0 all the same")
    // After the watch's second mark the processors are halted already: the
    // dequeue cannot be done, the wait ends and the line says so.
    boot()
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 96 << 9)
    card.clock += 1000000000
    compute.heat(&e, &l, &c)
    expect(c.stopped, "96 C: every ring stopped")
    const began = card.clock
    compute.stop(&e, &l, &c)
    shown()
    line("), a queue did not let go in 100 ms, RLC off (0x0)\n")
    expect(card.clock - began < 1000000000, "the way down ends, its waits bounded")
}

// A card whose queues write no read pointer back: the KIQ takes the map
// (ring 0's queue is active), so no second trial and no line that says
// the map was not taken; G3 fails at its own self-test, the read pointer.
fn theMapWithoutReadBack() -> void {
    expect(upToG2(), "S0 to G2")
    mec.noReadBack = true
    queuesFailWith("gpu: step G3 failed: compute ring 0's read pointer is not its write pointer (read pointer 0x0 (the queue's own 0x100", "queues that write no read pointer back")
    expect(mec.maps == 1 && mec.clearStates == 0 && !c.second, "the map taken once, no second trial")
    noLine("the KIQ did not take the map")
    expect(mec.unmaps == 1, "ring 0 taken back through the KIQ, which answers")
}

// A KIQ that writes the scratch register late: within the bound G3 passes
// and says when; beyond it G3 fails, no unmap is asked of it, and the
// write that comes after the step changes nothing of what was put back.
fn theLateKiq() -> void {
    expect(upToG2(), "S0 to G2")
    mec.kiqLate = 50000
    expect(compute.queues(&e, &l, &c), "a KIQ 50 ms late: G3 passes")
    shown()
    line("gpu: step G3: KIQ (2.1.0) answers after 500")
    expect(c.kiqWaited >= 50000 && c.kiqWaited < 50010, "the KIQ's 50 ms said")
    expect(upToG2(), "S0 to G2")
    mec.kiqLate = 150000
    queuesFailWith("gpu: step G3 failed: the KIQ did not write the scratch register within 100 ms (", "a KIQ 150 ms late")
    expect(mec.unmaps == 0, "no unmap asked of a KIQ that did not answer in time")
}

// An end-of-pipe entry with another ring's id (queue 1 of the same pipe):
// not ring 0's; G4 says the entry did not come, the entry counted as
// another's.
fn theOtherRingsEntry() -> void {
    expect(upToG3(), "S0 to G3")
    mec.entryRing = ring.ringId(1, 0, 1)
    const others = l.others
    endFailsWith("gpu: step G4 failed: compute ring 0's indirect buffer test did not end: the fence came, its end-of-pipe entry did not, within 1000 ms; read pointer 0x200", "an entry of ring id 0x14")
    expect(l.others == others + 1 && c.compute.entries == 0, "the entry taken as another's, none for ring 0")
}

// A buffer the queue passes over (the fence after it comes): G4 says the
// word the buffer was to write. The card gone while G4 waits: the wait
// sees it at its first look, not at its bound.
fn theEndOfPipeMore() -> void {
    expect(upToG3(), "S0 to G3")
    mec.bufferSkipped = true
    endFailsWith("gpu: step G4 failed: the indirect buffer's word reads 0xcafedead where 0xdeadbeef was written", "a buffer the queue passes over")
    expect(upToG3(), "S0 to G3")
    card.goneAt = 0x3085
    expect(!compute.endOfPipe(&e, &l, &c) && c.g4 == engines.Outcome.failed, "the card gone in G4: it fails")
    shown()
    expect(c.how == ring.Waited.gone && c.compute.waited < 1000, "the wait sees the card gone at once")
    line("gpu: step G4 failed: the card no longer answers as it did")
}

// A boot of stage 5 on a card a start before this one left running (the
// SMC's firmware running, the processors unhalted, the RLC on, both queues
// active, the doorbells on): S0 lets the queues go while the processors
// run and halts them (the study's 8.7), F1 uploads nothing, F2 loads and
// halts again, and stage 5 begins from there and passes.
fn theCardLeftRunning() -> void {
    fresh(5)
    smc.smcRunning()
    card.registers[engines.CP_MEC_CNTL] = 0
    card.registers[engines.CP_ME_CNTL] = 0
    card.registers[engines.RLC_CNTL] = 1
    card.registers[engines.BIF_DOORBELL_APER_EN] = 1
    card.queueActive[mec.queueOf(2, 1, 0)] = 1
    card.queueActive[mec.queueOf(1, 0, 0)] = 1
    engines.run(&e)
    compute.run(&e, &l, &c)
    shown()
    line("gpu: step S0: the card was left running by a start before this one: compute queues active, processors running, RLC running, doorbells on")
    noLine("a queue did not let go")
    expect(l.f1 == engines.Outcome.passed && smc.askedCount != 0 && c.g3 == engines.Outcome.passed && c.g4 == engines.Outcome.passed, "F1 uploads nothing, F2 loads, G1 to G4 pass")
    line(" (stage 5 starts them from there)")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

// What a caller hands `submit` never reaches the packet's other fields:
// no words, a length beyond the field's 20 bits (one that would set the
// address space's bits), an address not on 4 bytes or beyond 48 bits, an
// address space beyond 15: refused, nothing written.
fn theSubmitBounds() -> void {
    expect(upToG3(), "S0 to G3")
    const r = &c.compute
    const at = r.*.wptr
    const buffer = gart(c.buffers)
    const first = memoryWord(c.rings[1] + at * 4)
    expect(ring.submit(&e, &l, r, buffer, 0, 0) == ring.NONE, "no words: refused")
    expect(ring.submit(&e, &l, r, buffer, 0x1000005, 0) == ring.NONE, "a length that reaches the address space's bits: refused")
    expect(ring.submit(&e, &l, r, buffer, 0x100000, 0) == ring.NONE, "a length beyond 20 bits: refused")
    expect(ring.submit(&e, &l, r, buffer + 2, 5, 0) == ring.NONE, "an address not on 4 bytes: refused")
    expect(ring.submit(&e, &l, r, buffer | (@intCast(usize, 1) << 48), 5, 0) == ring.NONE, "an address beyond 48 bits: refused")
    expect(ring.submit(&e, &l, r, buffer, 5, 16) == ring.NONE, "an address space beyond 15: refused")
    expect(r.*.wptr == at && r.*.sent == 0 && memoryWord(c.rings[1] + at * 4) == first && mec.buffers == 0, "nothing written, no fence counted, nothing run")
    expect(ring.submit(&e, &l, r, buffer, 5, 0) == 1, "five words in address space 0: taken")
}

// ---- The watch.

fn theWatch() -> void {
    boot()
    // 41 C: nothing said, once a second.
    var logged = card.logged
    compute.heat(&e, &l, &c)
    expect(card.logged == logged && c.watchDegrees == 41, "41 C: read, nothing said")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 86 << 9)
    compute.heat(&e, &l, &c)
    expect(c.watchMark == 0, "not before a second has passed")
    card.clock += 1000000000
    compute.heat(&e, &l, &c)
    line("gpu: the card is at 86 C, the first mark (85 C): no ring takes new work\n")
    expect(c.compute.refused && ring.submit(&e, &l, &c.compute, gart(c.buffers), 5, 0) == ring.NONE, "86 C: no new work")
    expect(!compute.endOfPipe(&e, &l, &c) && c.g4 == engines.Outcome.refused, "G4 refused at the mark")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 80 << 9)
    card.clock += 1000000000
    compute.heat(&e, &l, &c)
    line("gpu: the card is at 80 C again, below the first mark (85 C): the rings take work again\n")
    expect(!c.compute.refused, "80 C: work again")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 96 << 9)
    card.clock += 1000000000
    compute.heat(&e, &l, &c)
    line("gpu: the card is at 96 C, the second mark (95 C): every ring stopped until the next boot\n")
    expect(c.stopped && card.registers[engines.CP_MEC_CNTL] == 0x50000000 && card.registers[engines.SDMA0_F32_CNTL] & 1 == 1 && card.registers[engines.SDMA1_F32_CNTL] & 1 == 1, "96 C: the processors and the copy engines halted")
    logged = card.logged
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 41 << 9)
    card.clock += 1000000000
    compute.heat(&e, &l, &c)
    expect(card.logged == logged, "stopped until the next boot: nothing more")
    // After a failed F1 (no ring runs): the watch said and on.
    fresh(5)
    smc.refuse = true
    engines.run(&e)
    compute.run(&e, &l, &c)
    expect(l.f1 == engines.Outcome.failed, "F1 fails")
    line("gpu: the card's temperature is watched by the kernel from now on, once a second (the SMC is held in reset): 41 C now\n")
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 90 << 9)
    card.clock += 1000000000
    compute.heat(&e, &l, &c)
    line("gpu: the card is at 90 C, the first mark (85 C): no ring takes new work\n")
    // Without a failed F1 and with no ring: no watch.
    fresh(2)
    engines.run(&e)
    compute.run(&e, &l, &c)
    logged = card.logged
    card.smcSet(engines.ixCG_MULT_THERMAL_STATUS, 99 << 9)
    card.clock += 1000000000
    compute.heat(&e, &l, &c)
    expect(card.logged == logged && !c.stopped, "stage 2: nothing watched")
    expect(card.displayWrites(0) == 0, "nothing of the display's")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) == 2
    _ = crash.install()
    if !card.makeRom(true) {
        say("the ROM could not be made\n")
        return 5
    }
    const names = [_][]const u8{ "polaris10_pfp_2.bin", "polaris10_me_2.bin", "polaris10_ce_2.bin", "polaris10_mec_2.bin", "polaris10_rlc.bin", "polaris10_sdma.bin", "polaris10_sdma1.bin", "polaris10_k_smc.bin", "polaris10_smc_sk.bin" }
    for name in names {
        if !card.load(name) {
            say("the firmware files could not be read (run from the repository's top)\n")
            return 6
        }
    }
    theQueues()
    theQueuesFailures()
    theSecondTrial()
    theEndOfPipe()
    theEndOfPipeFailures()
    theInterface()
    theWayDown()
    theWayDownInOrder()
    theMapWithoutReadBack()
    theLateKiq()
    theOtherRingsEntry()
    theEndOfPipeMore()
    theCardLeftRunning()
    theSubmitBounds()
    theWatch()
    if failed != 0 { return failed }
    return 13
}
