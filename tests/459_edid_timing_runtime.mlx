// The kernel's reading of a monitor's EDID (projects/brix/kernel/edid.mlx,
// built for the host) on blocks written here from the standard's layout:
// a base block whose preferred timing is the monitor's own (3840x1080 at
// 60 Hz, the numbers of a reduced-blanking timing), one that lists the
// same size at 120, 100 and 60 Hz (the least demanding is taken), one
// whose own mode is only in a CTA-861 extension, in a DisplayID extension
// (type I and type VII), the well-known 1080p timing's eighteen bytes as
// they stand in the standards, a wrong checksum, bytes that are no EDID,
// none at all, an extension that does not add up, only interlaced or stereo
// timings, only a slow one, a descriptor whose numbers are no timing.
// With an argument, the lines the kernel would say are printed.
// Exits 13.
const std = @import("std")
const edid = @import("../projects/brix/kernel/edid.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

// The EDID being written: two blocks' room.
var bytes: [256]u8 = undefined

// What `edid.say` writes.
const LOG: usize = 2048
var log: [LOG]u8 = undefined
var logged: usize = 0
var show = false

fn write(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length && logged < LOG {
        log[logged] = text[k]
        logged += 1
        k += 1
    }
    if show { say(text) }
}

fn has(text: []const u8) -> bool {
    if text.length > logged { return false }
    var at: usize = 0
    while at + text.length <= logged {
        var k: usize = 0
        while k < text.length && log[at + k] == text[k] { k += 1 }
        if k == text.length { return true }
        at += 1
    }
    return false
}

var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

// A block's last byte set so that its bytes add up to 0.
fn seal(block: usize) -> void {
    var sum: usize = 0
    var k: usize = 0
    while k < 127 {
        sum += @intCast(usize, bytes[block + k])
        k += 1
    }
    bytes[block + 127] = @intCast(u8, (256 - sum % 256) % 256)
}

// A base block without descriptors: the header, a maker and a product,
// EDID 1.4, a digital input, and `extensions` blocks said to follow.
fn base(extensions: u8) -> void {
    var k: usize = 0
    while k < 256 {
        bytes[k] = 0
        k += 1
    }
    k = 1
    while k < 7 {
        bytes[k] = 0xFF
        k += 1
    }
    bytes[8] = 0x4C
    bytes[9] = 0x2D
    bytes[10] = 0x12
    bytes[11] = 0x34
    bytes[16] = 1
    bytes[17] = 33
    bytes[18] = 1
    bytes[19] = 4
    bytes[20] = 0xA5
    bytes[21] = 120
    bytes[22] = 34
    bytes[23] = 120
    bytes[24] = 0x3A
    // Four descriptors that are no timings (their first three bytes 0, a
    // tag, 0): the monitor's name, and three empty ones.
    k = 0
    while k < 4 {
        const at = 54 + k * 18
        bytes[at + 3] = if k == 0 { 0xFC } else { 0x10 }
        k += 1
    }
    const name = "WIDE 49\n     "
    k = 0
    while k < 13 {
        bytes[54 + 5 + k] = name[k]
        k += 1
    }
    bytes[126] = extensions
    seal(0)
}

// A detailed timing's 18 bytes at `at`, as the standard lays them out:
// the clock in 10 kHz, the low eight bits of each size and blanking with
// their upper four bits paired in the byte after, the porches and pulses
// (ten bits across, six down), the picture's size in mm, no borders, and
// the flags (0x18: separate digital sync; 0x04 and 0x02: the vertical and
// the horizontal pulse high; 0x80: interlaced).
fn timing(at: usize, clock: usize, width: usize, hBlank: usize, hFront: usize, hSync: usize, height: usize, vBlank: usize, vFront: usize, vSync: usize, flags: u8) -> void {
    bytes[at] = @intCast(u8, (clock / 10) & 0xFF)
    bytes[at + 1] = @intCast(u8, (clock / 10) >> 8)
    bytes[at + 2] = @intCast(u8, width & 0xFF)
    bytes[at + 3] = @intCast(u8, hBlank & 0xFF)
    bytes[at + 4] = @intCast(u8, ((width >> 8) << 4) | (hBlank >> 8))
    bytes[at + 5] = @intCast(u8, height & 0xFF)
    bytes[at + 6] = @intCast(u8, vBlank & 0xFF)
    bytes[at + 7] = @intCast(u8, ((height >> 8) << 4) | (vBlank >> 8))
    bytes[at + 8] = @intCast(u8, hFront & 0xFF)
    bytes[at + 9] = @intCast(u8, hSync & 0xFF)
    bytes[at + 10] = @intCast(u8, ((vFront & 0xF) << 4) | (vSync & 0xF))
    bytes[at + 11] = @intCast(u8, ((hFront >> 8) << 6) | ((hSync >> 8) << 4) | ((vFront >> 4) << 2) | (vSync >> 4))
    bytes[at + 12] = 0xB0
    bytes[at + 13] = 0x50
    bytes[at + 14] = 0x41
    bytes[at + 15] = 0
    bytes[at + 16] = 0
    bytes[at + 17] = flags
}

// The monitor's own timing as the tests use it: 3840x1080 at 60 Hz with
// reduced blanking (4000 by 1111 in all, 266.64 MHz), the horizontal
// pulse high and the vertical one low.
fn own(at: usize) -> void { timing(at, 266640, 3840, 160, 48, 32, 1080, 31, 3, 10, 0x1A) }

// A CTA-861 extension block (tag 2, revision 3) whose detailed timings
// begin at `offset`.
fn cta(offset: u8) -> void {
    bytes[128] = 0x02
    bytes[129] = 0x03
    bytes[130] = offset
    bytes[131] = 0x01
}

// A DisplayID extension block (tag 0x70) with one data block of detailed
// timings (`tag` 3: type I, in 10 kHz; 0x22: type VII, in kHz), `count`
// of them to be written at 136 and after; the section's own checksum is
// set by `sealSection`.
fn displayId(version: u8, tag: u8, count: usize) -> void {
    bytes[128] = 0x70
    bytes[129] = version
    bytes[130] = @intCast(u8, 3 + count * 20)
    bytes[131] = 0x03
    bytes[132] = 0
    bytes[133] = tag
    bytes[134] = 0
    bytes[135] = @intCast(u8, count * 20)
}

fn sealSection() -> void {
    const length = @intCast(usize, bytes[130])
    var sum: usize = 0
    var k: usize = 0
    while k < 4 + length {
        sum += @intCast(usize, bytes[129 + k])
        k += 1
    }
    bytes[129 + 4 + length] = @intCast(u8, (256 - sum % 256) % 256)
}

fn put16(at: usize, value: usize) -> void {
    bytes[at] = @intCast(u8, value & 0xFF)
    bytes[at + 1] = @intCast(u8, (value >> 8) & 0xFF)
}

// A DisplayID detailed timing's 20 bytes: every number less one, the
// clock in `unit` kHz, the pulses' polarity in bit 15 of the porches.
fn timingDisplayId(at: usize, unit: usize, clock: usize, width: usize, hBlank: usize, hFront: usize, hSync: usize, hHigh: bool, height: usize, vBlank: usize, vFront: usize, vSync: usize, vHigh: bool, options: u8) -> void {
    const stored = clock / unit - 1
    bytes[at] = @intCast(u8, stored & 0xFF)
    bytes[at + 1] = @intCast(u8, (stored >> 8) & 0xFF)
    bytes[at + 2] = @intCast(u8, (stored >> 16) & 0xFF)
    bytes[at + 3] = options
    put16(at + 4, width - 1)
    put16(at + 6, hBlank - 1)
    put16(at + 8, (hFront - 1) | (if hHigh { 0x8000 } else { 0 }))
    put16(at + 10, hSync - 1)
    put16(at + 12, height - 1)
    put16(at + 14, vBlank - 1)
    put16(at + 16, (vFront - 1) | (if vHigh { 0x8000 } else { 0 }))
    put16(at + 18, vSync - 1)
}

// The first `count` bytes read, and what the kernel would say of them.
fn run(name: []const u8, count: usize) -> edid.Monitor {
    logged = 0
    if show {
        say("-- ")
        say(name)
        say("\n")
    }
    const m = edid.read(bytes[0..count])
    edid.say(write, &m)
    return m
}

fn isOwn(m: *const edid.Monitor) -> bool {
    const t = &m.*.timing
    return m.*.state == edid.State.found && m.*.width == 3840 && m.*.height == 1080 && t.*.clock == 266640 && t.*.width == 3840 && t.*.hTotal == 4000 && t.*.hFront == 48 && t.*.hSync == 32 && t.*.hPositive && t.*.height == 1080 && t.*.vTotal == 1111 && t.*.vFront == 3 && t.*.vSync == 10 && !t.*.vPositive && !t.*.interlaced && t.millihertz() == 60000
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1

    // The preferred timing in the base block.
    base(0)
    own(54)
    seal(0)
    var m = run("a base block with a preferred timing", 128)
    expect(isOwn(&m), "the base block's preferred timing")
    expect(m.timings == 1 && m.ofOwnSize == 1 && m.extension == edid.Extension.none, "one timing, no extension")
    expect(has("gpu: the monitor's own timing is 3840x1080 at 60.00 Hz: pixel clock 266640 kHz, h 3840 4000 (front 48 sync 32 +), v 1080 1111 (front 3 sync 10 -)\n"), "the line of the preferred timing")
    expect(!has("least demanding"), "one timing is not the least of several")

    // The same size at three rates (120 Hz preferred, 60 Hz after it, 100
    // Hz in the extension) and a smaller mode: the 60 Hz one is taken.
    base(1)
    timing(54, 549120, 3840, 160, 48, 32, 1080, 64, 3, 10, 0x1A)
    own(72)
    timing(90, 148500, 1920, 280, 88, 44, 1080, 45, 4, 5, 0x1E)
    seal(0)
    cta(4)
    timing(132, 454400, 3840, 160, 48, 32, 1080, 56, 3, 10, 0x1A)
    seal(128)
    m = run("the monitor's size at 120, 60 and 100 Hz", 256)
    expect(isOwn(&m), "the least demanding of three")
    expect(m.timings == 4 && m.ofOwnSize == 3 && m.extension == edid.Extension.cta, "four timings, three of the own size")
    expect(has(" v 1080 1111 (front 3 sync 10 -) (the least demanding of 3 of that size)\n"), "the line says how many there were")

    // The own mode only in the CTA extension (the base block has no
    // timing); after it the 1080p timing as the standards print it (02 3A
    // 80 18 71 38 2D 40 58 2C 45 00 ...: 148.5 MHz, 1920 of 2200, 1080 of
    // 1125, porches 88 and 4, pulses 44 and 5, both high).
    base(1)
    cta(4)
    own(132)
    const known = [_]u8{ 0x02, 0x3A, 0x80, 0x18, 0x71, 0x38, 0x2D, 0x40, 0x58, 0x2C, 0x45, 0x00, 0xFD, 0x1E, 0x11, 0x00, 0x00, 0x1E }
    var k: usize = 0
    while k < 18 {
        bytes[150 + k] = known[k]
        k += 1
    }
    seal(128)
    m = run("the own mode only in the CTA extension", 256)
    expect(isOwn(&m), "the extension's first timing is the own one")
    expect(m.timings == 2 && m.ofOwnSize == 1, "two timings in the extension")
    expect(has("gpu: the monitor's own timing is 3840x1080 at 60.00 Hz: pixel clock 266640 kHz, h 3840 4000 (front 48 sync 32 +), v 1080 1111 (front 3 sync 10 -)\n"), "the line of the extension's timing")

    // The well-known timing alone, first in the extension: its numbers.
    base(1)
    cta(4)
    k = 0
    while k < 18 {
        bytes[132 + k] = known[k]
        k += 1
    }
    seal(128)
    m = run("the 1080p timing of the standards", 256)
    expect(m.state == edid.State.found && m.width == 1920 && m.height == 1080, "1920x1080 found")
    expect(m.timing.clock == 148500 && m.timing.hTotal == 2200 && m.timing.hFront == 88 && m.timing.hSync == 44 && m.timing.hPositive, "its horizontal numbers")
    expect(m.timing.vTotal == 1125 && m.timing.vFront == 4 && m.timing.vSync == 5 && m.timing.vPositive && !m.timing.interlaced, "its vertical numbers")
    expect(has("gpu: the monitor's own timing is 1920x1080 at 60.00 Hz: pixel clock 148500 kHz, h 1920 2200 (front 88 sync 44 +), v 1080 1125 (front 4 sync 5 +)\n"), "its line")

    // The extension is not passed on (128 bytes only): the base block
    // alone, which has no timing here.
    m = run("the base block without its extension", 128)
    expect(m.state == edid.State.no_timing && m.extension == edid.Extension.none, "no timing without the extension")
    expect(has("gpu: the monitor's EDID has no detailed timing: its own timing is not known\n"), "the line of an EDID without a timing")

    // A CTA extension that says it has no timings, and one whose offset
    // is none.
    base(1)
    cta(0)
    own(132)
    seal(128)
    m = run("a CTA extension without timings", 256)
    expect(m.state == edid.State.no_timing && m.extension == edid.Extension.cta, "an offset of 0: no timings read")
    cta(2)
    seal(128)
    m = run("a CTA extension with an offset that is none", 256)
    expect(m.state == edid.State.no_timing, "an offset of 2: no timings read")

    // A DisplayID extension: a type I timing (the clock in 10 kHz), then a
    // type VII one (in kHz), each with a second timing of the same size at
    // 100 Hz before it.
    base(1)
    displayId(0x12, 0x03, 2)
    timingDisplayId(136, 10, 454400, 3840, 160, 48, 32, true, 1080, 56, 3, 10, false, 0x80)
    timingDisplayId(156, 10, 266640, 3840, 160, 48, 32, true, 1080, 31, 3, 10, false, 0)
    sealSection()
    seal(128)
    m = run("the own mode in a DisplayID extension (type I)", 256)
    expect(isOwn(&m), "DisplayID type I")
    expect(m.timings == 2 && m.ofOwnSize == 2 && m.extension == edid.Extension.displayid, "two DisplayID timings")
    base(1)
    displayId(0x20, 0x22, 2)
    timingDisplayId(136, 1, 454400, 3840, 160, 48, 32, true, 1080, 56, 3, 10, false, 0x80)
    timingDisplayId(156, 1, 266640, 3840, 160, 48, 32, true, 1080, 31, 3, 10, false, 0)
    sealSection()
    seal(128)
    m = run("the own mode in a DisplayID extension (type VII)", 256)
    expect(isOwn(&m), "DisplayID type VII")
    // A section whose own checksum is wrong is left out.
    bytes[129 + 4 + 43] ^= 0x01
    seal(128)
    m = run("a DisplayID section that does not add up", 256)
    expect(m.state == edid.State.no_timing && m.extension == edid.Extension.bad_checksum, "the section left out")
    expect(has("gpu: the EDID's extension block does not add up: left out\n"), "the line of the section left out")

    // A wrong checksum of the base block: nothing is taken from it.
    base(0)
    own(54)
    seal(0)
    bytes[60] ^= 0x10
    m = run("a base block that does not add up", 128)
    expect(m.state == edid.State.bad_checksum && m.width == 0 && m.timings == 0, "a wrong checksum")
    expect(has("gpu: the monitor's EDID does not add up (a wrong checksum): its own timing is not taken from it\n"), "the line of a wrong checksum")
    expect(!has("own timing is 3840"), "no timing from a block that does not add up")

    // An extension that does not add up: the base block still counts.
    base(1)
    own(54)
    seal(0)
    cta(4)
    timing(132, 454400, 3840, 160, 48, 32, 1080, 56, 3, 10, 0x1A)
    seal(128)
    bytes[140] ^= 0x01
    m = run("an extension that does not add up", 256)
    expect(isOwn(&m) && m.timings == 1 && m.extension == edid.Extension.bad_checksum, "the base block's timing without the extension's")
    expect(has("gpu: the EDID's extension block does not add up: left out\n"), "the line of the extension left out")

    // Bytes that are no EDID, and none at all.
    base(0)
    own(54)
    bytes[3] = 0
    seal(0)
    m = run("bytes without the header", 128)
    expect(m.state == edid.State.no_header, "no header")
    expect(has("gpu: the monitor's EDID is none (its first bytes are not an EDID's): its own timing is not known\n"), "the line of bytes that are no EDID")
    m = run("no EDID", 0)
    expect(m.state == edid.State.none && logged == 0, "none: nothing said")
    m = run("half a block", 64)
    expect(m.state == edid.State.none && logged == 0, "half a block is none")

    // Only interlaced timings of the own size.
    base(0)
    timing(54, 74250, 1920, 280, 88, 44, 540, 22, 2, 5, 0x9E)
    seal(0)
    m = run("only an interlaced timing", 128)
    expect(m.state == edid.State.interlaced && m.width == 1920 && m.height == 540, "only interlaced")
    expect(has("gpu: the monitor's EDID has only interlaced or stereo timings of its own size, 1920x540: none is taken\n"), "the line of interlaced timings")

    // A timing for stereo glasses (the flags' bits 6 and 5, either set) is
    // not one to send a plain picture with: alone it gives no timing; the
    // plain one of the same size after it is the one taken, though the
    // stereo one is the slower. In a DisplayID block the options' bits 6
    // and 5 as 1 are stereo alone, as 2 a timing for either.
    base(0)
    timing(54, 266640, 3840, 160, 48, 32, 1080, 31, 3, 10, 0x3A)
    seal(0)
    m = run("only a stereo timing", 128)
    expect(m.state == edid.State.interlaced && m.width == 3840 && m.height == 1080 && m.ofOwnSize == 1, "only stereo")
    expect(has("gpu: the monitor's EDID has only interlaced or stereo timings of its own size, 3840x1080: none is taken\n"), "the line of stereo timings")
    base(0)
    timing(54, 266640, 3840, 160, 48, 32, 1080, 31, 3, 10, 0x5A)
    timing(72, 454400, 3840, 160, 48, 32, 1080, 56, 3, 10, 0x1A)
    seal(0)
    m = run("a stereo timing of 60 Hz and a plain one of 100 Hz", 128)
    expect(m.state == edid.State.found && m.timing.clock == 454400 && !m.timing.stereo && m.ofOwnSize == 2, "the plain timing, not the stereo one")
    base(1)
    displayId(0x12, 0x03, 2)
    timingDisplayId(136, 10, 266640, 3840, 160, 48, 32, true, 1080, 31, 3, 10, false, 0xA0)
    timingDisplayId(156, 10, 454400, 3840, 160, 48, 32, true, 1080, 56, 3, 10, false, 0x40)
    sealSection()
    seal(128)
    m = run("DisplayID: a stereo timing and one for either", 256)
    expect(m.state == edid.State.found && m.timing.clock == 454400 && m.ofOwnSize == 2, "DisplayID: stereo alone is passed over, one for either is taken")

    // A CTA extension filled to its end: six timings from byte 19, the
    // last one's last byte the one before the block's checksum. The last
    // is the only one of 60 Hz: it is read.
    base(1)
    cta(19)
    var slot: usize = 0
    while slot < 5 {
        timing(128 + 19 + slot * 18, 454400, 3840, 160, 48, 32, 1080, 56, 3, 10, 0x1A)
        slot += 1
    }
    own(128 + 19 + 5 * 18)
    seal(128)
    m = run("a CTA extension filled to its end", 256)
    expect(isOwn(&m) && m.timings == 6 && m.ofOwnSize == 6, "the last timing of a full CTA block")

    // Only a slow timing of the own size, and two slow ones: the faster.
    base(0)
    timing(54, 297000, 3840, 560, 176, 88, 2160, 90, 8, 10, 0x1E)
    timing(72, 297000, 3840, 1440, 528, 88, 2160, 90, 8, 10, 0x1E)
    seal(0)
    m = run("3840x2160 at 30 and 25 Hz only", 128)
    expect(m.state == edid.State.found && m.timing.hTotal == 4400 && m.timing.millihertz() == 30000 && m.ofOwnSize == 2, "the faster of two slow timings")
    expect(has("gpu: the monitor's own timing is 3840x2160 at 30.00 Hz: pixel clock 297000 kHz, h 3840 4400 (front 176 sync 88 +), v 2160 2250 (front 8 sync 10 +) (the least demanding of 2 of that size)\n"), "the line of the slow timing")

    // A slow one and one of 50 Hz and more: the latter, whichever comes
    // first; and of 75 and 59.94 Hz the 59.94.
    base(0)
    timing(54, 297000, 3840, 560, 176, 88, 2160, 90, 8, 10, 0x1E)
    timing(72, 594000, 3840, 560, 176, 88, 2160, 90, 8, 10, 0x1E)
    seal(0)
    m = run("30 Hz preferred, 60 Hz after it", 128)
    expect(m.state == edid.State.found && m.timing.clock == 594000 && m.timing.millihertz() == 60000, "60 Hz before 30 Hz")
    base(0)
    timing(54, 78750, 1024, 288, 16, 96, 768, 32, 1, 3, 0x1E)
    timing(72, 64930, 1024, 320, 24, 136, 768, 38, 3, 6, 0x18)
    seal(0)
    m = run("75 Hz preferred, 59.94 Hz after it", 128)
    expect(m.state == edid.State.found && m.timing.clock == 64930 && m.timing.millihertz() == 59939 && !m.timing.hPositive && !m.timing.vPositive, "the lower of two rates above 50 Hz")
    expect(has(" at 59.93 Hz: pixel clock 64930 kHz, h 1024 1344 (front 24 sync 136 -), v 768 806 (front 3 sync 6 -)"), "a rate with a fraction, both pulses low")

    // Porches and pulses that need the upper bits of their fields (ten
    // bits across: 528 and 300; six down: 40 and 20).
    base(0)
    timing(54, 297000, 3840, 1440, 528, 300, 2160, 90, 40, 20, 0x1E)
    seal(0)
    m = run("porches and pulses with upper bits", 128)
    expect(m.state == edid.State.found && m.timing.hTotal == 5280 && m.timing.vTotal == 2250, "the totals of a timing with long porches")
    expect(m.timing.hFront == 528 && m.timing.hSync == 300 && m.timing.vFront == 40 && m.timing.vSync == 20, "porches and pulses with upper bits")
    expect(has("gpu: the monitor's own timing is 3840x2160 at 25.00 Hz: pixel clock 297000 kHz, h 3840 5280 (front 528 sync 300 +), v 2160 2250 (front 40 sync 20 +)\n"), "the line of a timing with long porches")

    // A descriptor whose numbers are no timing (the blanking shorter than
    // porch and pulse) is passed over: the next one is the own.
    base(0)
    timing(54, 266640, 3840, 60, 48, 32, 1080, 31, 3, 10, 0x1A)
    own(72)
    seal(0)
    m = run("a descriptor that is no timing", 128)
    expect(isOwn(&m) && m.timings == 1, "the timing after one that is none")

    if failed != 0 { return failed }
    return 13
}
