// The materialized std.wayland modules match the canonical XML: interface
// versions, declaration-order opcodes, since-versions, libwayland message
// signatures, object/new_id argument interfaces, destructor flags, exact
// enum values (including escaped names such as wl_output.transform._90),
// interface lookup by name, and std.wayland.flags on bitfield enums. Exits 13.
const wl = @import("std.wayland")

fn same(left: []const u8, right: []const u8) -> bool {
    var left_length: usize = 0
    for byte in left { left_length += 1 }
    var right_length: usize = 0
    for byte in right { right_length += 1 }
    if left_length != right_length { return false }
    var index: usize = 0
    for byte in left {
        if right[index] != byte { return false }
        index += 1
    }
    return true
}

pub fn main() -> u8 {
    if wl.interfaces.COUNT != 28 { return 1 }
    if wl.wl_compositor.VERSION != 7 || wl.xdg_toplevel.VERSION != 7 { return 2 }
    if wl.interfaces.interfaceVersion(wl.Interface.wl_seat) != 11 { return 3 }
    if !same(wl.wl_surface.name(), "wl_surface") || wl.wl_surface.interface() != wl.Interface.wl_surface { return 4 }

    // Opcodes follow declaration order; since-versions are exact.
    if wl.wl_surface.REQUEST_ATTACH != 1 || wl.wl_surface.REQUEST_OFFSET != 10 || wl.wl_surface.REQUEST_OFFSET_SINCE != 5 { return 5 }
    if wl.wl_display.EVENT_DELETE_ID != 1 || wl.xdg_toplevel.EVENT_WM_CAPABILITIES_SINCE != 5 { return 6 }

    // Signatures and metadata tables.
    if !same(wl.interfaces.requestSignature(wl.Interface.wl_registry, 0), "usun") { return 7 }
    if !same(wl.interfaces.requestSignature(wl.Interface.wl_surface, 1), "?oii") { return 8 }
    if !same(wl.interfaces.requestSignature(wl.Interface.wl_shm, 0), "nhi") { return 9 }
    if !same(wl.interfaces.requestSignature(wl.Interface.xdg_positioner, 8), "3ii") { return 10 }
    if !same(wl.interfaces.eventSignature(wl.Interface.wl_display, 0), "ous") { return 11 }
    if !same(wl.interfaces.eventName(wl.Interface.wl_pointer, 5), "frame") { return 12 }
    if !wl.interfaces.eventDestructor(wl.Interface.wl_callback, 0) || wl.interfaces.requestDestructor(wl.Interface.wl_surface, 1) { return 14 }
    if !wl.interfaces.requestDestructor(wl.Interface.wl_surface, 0) { return 15 }
    var target = wl.Interface.wl_display
    if !wl.interfaces.requestArgInterface(wl.Interface.xdg_wm_base, 2, 1, &target) || target != wl.Interface.wl_surface { return 16 }
    if !wl.interfaces.eventArgInterface(wl.Interface.wl_data_device, 0, 0, &target) || target != wl.Interface.wl_data_offer { return 17 }
    if wl.interfaces.requestArgInterface(wl.Interface.wl_registry, 0, 3, &target) { return 18 }
    if wl.interfaces.requestCount(wl.Interface.wl_callback) != 0 || wl.interfaces.eventCount(wl.Interface.wl_keyboard) != 6 { return 19 }
    unsafe {
        if !wl.interfaces.lookup(@ptrCast([*]const u8, "xdg_popup"), 9, &target) || target != wl.Interface.xdg_popup { return 20 }
        if wl.interfaces.lookup(@ptrCast([*]const u8, "xdg_popu"), 8, &target) { return 21 }
    }

    // Enums keep the exact XML values.
    if @intFromEnum(wl.wl_output.Transform._90) != 1 || @intFromEnum(wl.wl_output.Transform.flipped_270) != 7 { return 22 }
    if @intFromEnum(wl.wl_shm.Format.xrgb8888) != 1 || @intFromEnum(wl.wl_shm.Format.nv12) != 842094158 { return 23 }
    if @intFromEnum(wl.wl_display.Error.implementation) != 3 { return 24 }
    if @intFromEnum(wl.xdg_positioner.Anchor.bottom_right) != 8 { return 25 }

    // Bitfields combine through std.wayland.flags.
    const pointer = @intFromEnum(wl.wl_seat.Capability.pointer)
    const keyboard = @intFromEnum(wl.wl_seat.Capability.keyboard)
    const mask = wl.flags.with(pointer, keyboard)
    if mask != 3 || !wl.flags.has(mask, keyboard) || wl.flags.has(wl.flags.without(mask, keyboard), keyboard) { return 26 }
    if wl.flags.any(mask, @intFromEnum(wl.wl_seat.Capability.touch)) { return 27 }
    return 13
}
