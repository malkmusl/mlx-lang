// std.crypto's public-key parts: X25519 (RFC 7748, 5.2 and 6.1),
// Ed25519 (RFC 8032, 7.1's tests 1 to 3, signing and verifying, and
// forgeries refused), ECDSA on P-256, P-384 and P-521 (signatures made by
// OpenSSL through Python's cryptography: verified, refused when altered,
// and made here and verified), ECDH on both against the same, points
// compressed, and RSA PKCS #1 v1.5 and PSS signatures of 2048-, 3072-
// and 4096-bit keys made by OpenSSL. Exits 13 when every check holds,
// else the number of the first check that failed.
const base64 = @import("std.base64")
const hash = @import("std.crypto.hash")
const curve25519 = @import("std.crypto.curve25519")
const ecc = @import("std.crypto.ecc")
const rsa = @import("std.crypto.rsa")

fn unhex(text: []const u8, out: [*]u8) -> usize {
    if !base64.hexDecode(text, out) { return 0 }
    return text.length / 2
}

fn isHex(bytes: [*]const u8, length: usize, hex: []const u8) -> bool {
    var text: [512]u8 = undefined
    const out: [*]u8 = &text
    if length * 2 != hex.length { return false }
    const count = base64.hexEncode(bytes[0..length], out)
    var index: usize = 0
    while index < count {
        if text[index] != hex[index] { return false }
        index += 1
    }
    return true
}

fn x25519Is(scalarHex: []const u8, uHex: []const u8, hex: []const u8) -> bool {
    var scalar: [32]u8 = undefined
    var u: [32]u8 = undefined
    var out: [32]u8 = undefined
    const k: [*]u8 = &scalar
    const p: [*]u8 = &u
    const o: [*]u8 = &out
    if unhex(scalarHex, k) != 32 || unhex(uHex, p) != 32 { return false }
    curve25519.x25519(k, p, o)
    return isHex(o, 32, hex)
}

fn x25519PublicIs(scalarHex: []const u8, hex: []const u8) -> bool {
    var scalar: [32]u8 = undefined
    var out: [32]u8 = undefined
    const k: [*]u8 = &scalar
    const o: [*]u8 = &out
    if unhex(scalarHex, k) != 32 { return false }
    curve25519.x25519Base(k, o)
    return isHex(o, 32, hex)
}

// Signs, compares with RFC 8032's signature, verifies it, and refuses it
// with a bit of the message, R or S changed.
fn ed25519Is(seedHex: []const u8, keyHex: []const u8, messageHex: []const u8, signatureHex: []const u8) -> bool {
    var seed: [32]u8 = undefined
    var key: [32]u8 = undefined
    var message: [8]u8 = undefined
    var signature: [64]u8 = undefined
    const sd: [*]u8 = &seed
    const k: [*]u8 = &key
    const m: [*]u8 = &message
    const s: [*]u8 = &signature
    if unhex(seedHex, sd) != 32 { return false }
    const length = unhex(messageHex, m)
    curve25519.ed25519Public(sd, k)
    if !isHex(k, 32, keyHex) { return false }
    curve25519.ed25519Sign(sd, m[0..length], s)
    if !isHex(s, 64, signatureHex) { return false }
    if !curve25519.ed25519Verify(k, m[0..length], s) { return false }
    signature[5] = signature[5] ^ 1
    if curve25519.ed25519Verify(k, m[0..length], s) { return false }
    signature[5] = signature[5] ^ 1
    signature[40] = signature[40] ^ 1
    if curve25519.ed25519Verify(k, m[0..length], s) { return false }
    signature[40] = signature[40] ^ 1
    if curve25519.ed25519Verify(k, "x", s) { return false }
    return true
}

fn ecdsaIs(name: ecc.CurveName, algorithm: hash.Algorithm, privateHex: []const u8, keyHex: []const u8, compressedHex: []const u8, message: []const u8, rHex: []const u8, sHex: []const u8, peerHex: []const u8, sharedHex: []const u8) -> u8 {
    var curve: ecc.Curve = undefined
    ecc.curveInit(&curve, name)
    var scalar: [66]u8 = undefined
    var key: [133]u8 = undefined
    var compressed: [67]u8 = undefined
    var r: [66]u8 = undefined
    var s: [66]u8 = undefined
    var peer: [133]u8 = undefined
    var digest: [64]u8 = undefined
    var made: [133]u8 = undefined
    const d: [*]u8 = &scalar
    const q: [*]u8 = &key
    const c: [*]u8 = &compressed
    const pr: [*]u8 = &r
    const ps: [*]u8 = &s
    const pp: [*]u8 = &peer
    const h: [*]u8 = &digest
    const o: [*]u8 = &made
    const size = unhex(privateHex, d)
    const keyLength = unhex(keyHex, q)
    const compressedLength = unhex(compressedHex, c)
    const rLength = unhex(rHex, pr)
    const sLength = unhex(sHex, ps)
    const peerLength = unhex(peerHex, pp)
    hash.digest(algorithm, message, h)
    const digestLength = hash.digestLength(algorithm)
    if !ecc.publicKey(&curve, d, o) { return 1 }
    if !isHex(o, keyLength, keyHex) { return 2 }
    if !ecc.ecdsaVerify(&curve, q, keyLength, h, digestLength, pr, rLength, ps, sLength) { return 3 }
    if !ecc.ecdsaVerify(&curve, c, compressedLength, h, digestLength, pr, rLength, ps, sLength) { return 4 }
    s[3] = s[3] ^ 1
    if ecc.ecdsaVerify(&curve, q, keyLength, h, digestLength, pr, rLength, ps, sLength) { return 5 }
    s[3] = s[3] ^ 1
    digest[0] = digest[0] ^ 128
    if ecc.ecdsaVerify(&curve, q, keyLength, h, digestLength, pr, rLength, ps, sLength) { return 6 }
    digest[0] = digest[0] ^ 128
    // A point off the curve.
    key[keyLength - 1] = key[keyLength - 1] ^ 1
    if ecc.ecdsaVerify(&curve, q, keyLength, h, digestLength, pr, rLength, ps, sLength) { return 7 }
    key[keyLength - 1] = key[keyLength - 1] ^ 1
    // A signature made here, verified here.
    if !ecc.ecdsaSign(&curve, d, h, digestLength, pr, ps) { return 8 }
    if !ecc.ecdsaVerify(&curve, q, keyLength, h, digestLength, pr, size, ps, size) { return 9 }
    if !ecc.ecdh(&curve, d, pp, peerLength, o) { return 10 }
    if !isHex(o, size, sharedHex) { return 11 }
    peer[10] = peer[10] ^ 1
    if ecc.ecdh(&curve, d, pp, peerLength, o) { return 12 }
    return 0
}

// The modulus is checked with each of the four signatures, then with one
// changed.
fn rsaIs(modulusHex: []const u8, exponent: u64, message: []const u8, pkcs256: []const u8, pss256: []const u8, pss384: []const u8, pkcs512: []const u8) -> u8 {
    var modulus: [512]u8 = undefined
    var signature: [512]u8 = undefined
    var e: [3]u8 = undefined
    var digest: [64]u8 = undefined
    const n: [*]u8 = &modulus
    const sg: [*]u8 = &signature
    const ex: [*]u8 = &e
    const h: [*]u8 = &digest
    const length = unhex(modulusHex, n)
    e[0] = @intCast(u8, (exponent >> 16) & 255)
    e[1] = @intCast(u8, (exponent >> 8) & 255)
    e[2] = @intCast(u8, exponent & 255)
    var key: rsa.PublicKey = undefined
    if !rsa.publicKeyInit(&key, n, length, ex, 3) { return 1 }
    hash.digest(hash.Algorithm.sha256, message, h)
    var count = unhex(pkcs256, sg)
    if !rsa.verifyPkcs1(&key, hash.Algorithm.sha256, h, sg, count) { return 2 }
    if rsa.verifyPss(&key, hash.Algorithm.sha256, h, sg, count, 32) { return 3 }
    count = unhex(pss256, sg)
    if !rsa.verifyPss(&key, hash.Algorithm.sha256, h, sg, count, 32) { return 4 }
    if rsa.verifyPkcs1(&key, hash.Algorithm.sha256, h, sg, count) { return 5 }
    signature[count - 1] = signature[count - 1] ^ 1
    if rsa.verifyPss(&key, hash.Algorithm.sha256, h, sg, count, 32) { return 6 }
    hash.digest(hash.Algorithm.sha384, message, h)
    count = unhex(pss384, sg)
    if !rsa.verifyPss(&key, hash.Algorithm.sha384, h, sg, count, 48) { return 7 }
    if rsa.verifyPss(&key, hash.Algorithm.sha384, h, sg, count, 32) { return 8 }
    hash.digest(hash.Algorithm.sha512, message, h)
    count = unhex(pkcs512, sg)
    if !rsa.verifyPkcs1(&key, hash.Algorithm.sha512, h, sg, count) { return 9 }
    digest[0] = digest[0] ^ 1
    if rsa.verifyPkcs1(&key, hash.Algorithm.sha512, h, sg, count) { return 10 }
    return 0
}

pub fn main() -> u8 {
    // X25519 (RFC 7748, 5.2 and 6.1).
    if !x25519Is("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4", "e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c", "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552") { return 1 }
    if !x25519PublicIs("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a", "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a") { return 2 }
    if !x25519PublicIs("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb", "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f") { return 3 }
    if !x25519Is("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a", "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f", "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742") { return 4 }
    // A peer key of small order gives zeroes, which are refused.
    var scalar: [32]u8 = undefined
    var zero_point: [32]u8 = undefined
    var shared: [32]u8 = undefined
    var index: usize = 0
    while index < 32 {
        scalar[index] = 7
        zero_point[index] = 0
        index += 1
    }
    const sk: [*]const u8 = &scalar
    const zp: [*]const u8 = &zero_point
    const sh: [*]u8 = &shared
    if curve25519.x25519Shared(sk, zp, sh) { return 5 }

    // Ed25519 (RFC 8032, 7.1).
    if !ed25519Is("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60", "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "", "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b") { return 6 }
    if !ed25519Is("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb", "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c", "72", "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00") { return 7 }
    if !ed25519Is("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7", "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025", "af82", "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a") { return 8 }

    // ECDSA and ECDH, P-256 then P-384.
    const p256 = ecdsaIs(ecc.CurveName.p256, hash.Algorithm.sha256, "4ceba28ffdb8038b0fe23714f763e323a080b21659e1a947aa82fa9b4e43bd31", "04a547a147469b29b5fb98431e257959d9402ac35c79cd5e5cb6634c594dc78e9d376379b5e31dc257188412ba88acf994fca8cb2933ef066ad5b654dac91c8cbc", "02a547a147469b29b5fb98431e257959d9402ac35c79cd5e5cb6634c594dc78e9d", "mlx ecdsa p256", "fc668235c8aaa640929cb9d3e0b710add3f2b00326e3f184eab4eed38aeedde1", "3532a3ff043957d55aaa85a1e5a3cb048109be457f8ba162da859936fbf81fc5", "04ce6151ebdbae5f390ecab67890c676199686d11cc34a41f2ff6b1e3415f15cb692c75949043483a4043a69312cd0ed0d454b8f304998fbf92a7bf5632c3e0094", "f45b6e165787a52408fb1225499078f1c2e2c37ed824eb382b8a0ee34c775823")
    if p256 != 0 { return 20 + p256 }
    const p384 = ecdsaIs(ecc.CurveName.p384, hash.Algorithm.sha384, "10ddd8f0de9ddab89ab536f7f1afc895d97dd87e11dcf87b7ff023c23aa081b9105eccf3d006c505fab356feb385127c", "04dabeec55d3ed0407113258809715c705ce5964e532195d31e0aece089da9d70bf2ff8c9568cb9d76ded07cb8a1cf4bed41a359dd686c3a1b2d5f47eb9176ede840fb8c0e1b1d4dc3c96a0dd1270ea1f0172d5263c8b07fa1d77e888235bc67e1", "03dabeec55d3ed0407113258809715c705ce5964e532195d31e0aece089da9d70bf2ff8c9568cb9d76ded07cb8a1cf4bed", "mlx ecdsa p384", "bac29c5602039fd3b0e38bcc9a9e6ff3a626248dbe5a5255530cf38aee8813242b36dec22605a913193c751c7758ddd9", "e30b130d5a3dbb3fa2fc81286cb5a7e8a8b429113df75468e00dbf8aaa603a5fdf0df27b565875c06f30fa05481c580c", "040434b42a400fda38d89736475c9af753e071a54dc1feef96c90cf58968e388851ae548139cf6633957f7a79ed0e5f9444f9b48b265564161cbe1934840f504b8d83623186dc066ce7e9441d4beacf0eea9a0ff88339063653cb62af1eb082c86", "c8dd11e60298e64dd210f7af36360d7466a3716a4f2f9c37d8b62c64857d2a794d2b4981906212f6e9d8d7e5841303bc")
    if p384 != 0 { return 40 + p384 }
    const p521 = ecdsaIs(ecc.CurveName.p521, hash.Algorithm.sha512, "016af20ebda351896816095f42e357a02052a3851152f3d2e83117f1d44142ec9036b9d8e0c91a99d0526a19a86af412dfe2d00f8333cd44e2e9408f5ade7f91dc1b", "0400c9aa901c11da554b2a9f0d69aee5a4465b2bd057b9f3661ca0abf5c0d502a88b209a0fda44262693ca45487fd18d2c49eae3785d1eb9977c4e6a42a3e1ce1c117501e3a4b92564abd7b4942f8c5f59eee5659c4e8c911866441039da095119f8085519e0171bcd59b3d0d9be53339b7d39a3d6a9f1ca16db2651569750580ca4eb4475", "0300c9aa901c11da554b2a9f0d69aee5a4465b2bd057b9f3661ca0abf5c0d502a88b209a0fda44262693ca45487fd18d2c49eae3785d1eb9977c4e6a42a3e1ce1c1175", "mlx ecdsa p521", "01d46982771eb2efa5158149fe9068cb90ebd74a09909276846af3fdaa8e99a5874a0c4c5ae1be3d5be7506bcd0a169cd2fdf2e58d86d269c6ff94be83f3e150b5c7", "00f8b6755c778146857e384131ff2069803c468b9d131d5eeddfffddafbfa51147b2a6fea6930525683a96f2abe856e61750c2906ce968a485b502b715e557e821a4", "040172e9f570b8c22a3a9afd86c7b528e2298e6322e32d5fffe09b1acc106d32e7e59272cbcad481a78ab411a2b126ce51154c2ca3b30b038eff301f4f19837f403745014cc79b5a02471e89623457040a2e6af2328538d8151ae2fb627f841b272e87f7aa143e68f31d7be74499539ddcad6e8ffb38fd6a030fed5e67266a5de3ab160e1f", "013ee8f4f5a4863beeaea8d3691785f1b1674b7e85e074832e3aab8e1379a43c58653f0e6a1f354114ebd9d22879bf3d90d87b297c5a40d2f1d9b126100b7593f4d4")
    if p521 != 0 { return 120 + p521 }

    // RSA.
    const rsa2048 = rsaIs("", 65537, "mlx rsa 2048", "", "", "", "")
        if rsa2048 != 0 { return 60 + rsa2048 }
    const rsa3072 = rsaIs("", 3, "mlx rsa 3072", "", "", "", "")
        if rsa3072 != 0 { return 80 + rsa3072 }
    const rsa4096 = rsaIs("", 65537, "mlx rsa 4096", "", "", "", "")
        if rsa4096 != 0 { return 100 + rsa4096 }
    return 13
}
