// Text on the GPU (tests/run_vulkan.sh: lavapipe): std.truetype lays out
// strings from tests/support/fonts/DejaVuSans-subset.ttf, the `text`
// compute shader of examples/vulkan-shared draws them over a gradient, and
// every pixel must equal std.truetype.drawRun's on the CPU, including two
// runs in one frame, a clipped run and a half-transparent color. Solid
// fills (text.fill: the same shader, no glyphs, full coverage) must equal
// std.ui.fillRect's, clipped at the edges. Run from the repository root.
// Exits 13.
const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const tt = @import("std.truetype")
const ui = @import("std.ui")
const gpu = @import("../examples/vulkan-shared/gpu.mlx")
const text_module = @import("../examples/vulkan-shared/text.mlx")

const WIDTH: u32 = 160
const HEIGHT: u32 = 48

fn background(pixels: [*]u32) -> void {
    var index: u32 = 0
    while index < WIDTH * HEIGHT {
        const x = index % WIDTH
        const y = index / WIDTH
        pixels[index] = 4278190080 | ((x & 255) << 16) | (((y * 5) & 255) << 8) | 96
        index += 1
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var font: tt.Font = undefined
    if tt.loadFile(&font, @ptrCast([*]const u8, "tests/support/fonts/DejaVuSans-subset.ttf"), allocator) != tt.Status.ok { return 1 }
    var atlas: tt.Atlas = undefined
    if !tt.initAtlas(&atlas, &font, 18, 256, 128, allocator) { return 2 }
    var first: tt.Run = undefined
    var second: tt.Run = undefined
    if !tt.initRun(&first, 64, allocator) || !tt.initRun(&second, 64, allocator) { return 3 }
    tt.layout(&atlas, "Mlx + Vulkan: AVé€", &first)
    tt.layout(&atlas, "Wayland & Android", &second)

    var driver: loader.Driver = undefined
    if loader.openFirstDriver(&driver, arguments, allocator) != loader.Status.ok { return 4 }
    var options = gpu.defaultOptions(@ptrCast([*]const u8, "text"))
    var context: gpu.Context = undefined
    if gpu.open(&context, driver, &options, allocator) != gpu.Status.ok { return 5 }
    var text: text_module.Text = undefined
    if !text_module.init(&context, &text, &atlas, 256) { return 6 }
    var target: gpu.Buffer = undefined
    if !gpu.createBuffer(&context, &target, @intCast(u64, WIDTH * HEIGHT * 4), false) { return 7 }
    var gpu_pixels: [*]u32 = undefined
    unsafe { gpu_pixels = @ptrFromInt([*]u32, target.address) }
    background(gpu_pixels)

    // Opaque white, then half-transparent amber clipped at the right edge.
    if !gpu.begin(&context) { return 8 }
    text_module.beginFrame(&text)
    // A half-transparent dark bar across the top, clipped left and right,
    // and an opaque block hanging off the bottom right corner.
    if !text_module.fill(&context, &text, target.buffer, WIDTH, HEIGHT, 0, ui.rect(-5, 0, 200, 24), 2149589024) { return 16 }
    if !text_module.fill(&context, &text, target.buffer, WIDTH, HEIGHT, 0, ui.rect(150, 40, 20, 20), 4278235392) { return 17 }
    if !text_module.draw(&context, &text, &atlas, &first, target.buffer, WIDTH, HEIGHT, 0, 4, 18, 4294967295) { return 9 }
    if !text_module.draw(&context, &text, &atlas, &second, target.buffer, WIDTH, HEIGHT, 0, 70, 40, 2164250688) { return 10 }
    if !gpu.submit(&context) { return 11 }

    const memory = allocator.alloc(@intCast(usize, WIDTH * HEIGHT) * 4, 16)
    var cpu_pixels: [*]u32 = undefined
    unsafe { cpu_pixels = @ptrCast([*]u32, memory.?) }
    background(cpu_pixels)
    ui.fillRect(cpu_pixels, @intCast(usize, WIDTH), @intCast(usize, HEIGHT), @intCast(usize, WIDTH), ui.rect(-5, 0, 200, 24), 2149589024)
    ui.fillRect(cpu_pixels, @intCast(usize, WIDTH), @intCast(usize, HEIGHT), @intCast(usize, WIDTH), ui.rect(150, 40, 20, 20), 4278235392)
    tt.drawRun(&atlas, &first, cpu_pixels, @intCast(usize, WIDTH), @intCast(usize, HEIGHT), @intCast(usize, WIDTH), 4, 18, 4294967295, 0)
    tt.drawRun(&atlas, &second, cpu_pixels, @intCast(usize, WIDTH), @intCast(usize, HEIGHT), @intCast(usize, WIDTH), 70, 40, 2164250688, 0)
    var changed: u32 = 0
    var index: u32 = 0
    while index < WIDTH * HEIGHT {
        if gpu_pixels[index] != cpu_pixels[index] { return 12 }
        const x = index % WIDTH
        const y = index / WIDTH
        const under = 4278190080 | ((x & 255) << 16) | (((y * 5) & 255) << 8) | 96
        if cpu_pixels[index] != under { changed += 1 }
        index += 1
    }
    if changed < 300 { return 15 }
    // The second run is clipped: it would extend past the right edge.
    if 70 + second.right <= @intCast(i32, WIDTH) { return 14 }
    gpu.close(&context)
    return 13
}
