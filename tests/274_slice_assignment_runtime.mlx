// A slice is two words, the pointer and the length, and every way a slice
// is stored writes both: a local assigned again (from a literal, a call, a
// sub-slice, in a loop), a struct field, and an optional slice (?[]const
// u8, the slice itself; null is pointer 0) in a local, a field, a return
// and an argument. Assignment used to store the pointer only, so a local
// kept its old length and a field had none, and an optional slice was one
// word, so it lost its length on the way (std.wayland's nullable strings,
// wl_data_offer.accept, then read past it). Exits 13.
const Holder = struct {
    text: []const u8
    other: ?[]const u8
    after: usize
}

fn count(value: []const u8) -> usize {
    var length: usize = 0
    for byte in value { length += 1 }
    return length
}

fn pick(first: bool) -> []const u8 { return if first { "abc" } else { "defghij" } }

fn optional(first: bool) -> ?[]const u8 {
    if first { return null }
    return "defghij"
}

// A nullable string and an argument after it, as the generated Wayland
// requests have them.
fn measure(text: ?[]const u8, after: usize) -> usize {
    if text == null { return after }
    return count(text.?) * 100 + text.?.length * 10 + after
}

pub fn main() -> u8 {
    var failures: u8 = 0
    var s: []const u8 = "abc"
    s = "defghij"
    if count(s) != 7 || s.length != 7 { failures += 1 }
    var t: []const u8 = pick(true)
    t = pick(false)
    if count(t) != 7 || t.length != 7 { failures += 1 }
    var buffer: [16]u8 = undefined
    var w: []const u8 = buffer[0..3]
    w = buffer[0..9]
    if count(w) != 9 || w.length != 9 { failures += 1 }
    var x: []const u8 = "a"
    var i: usize = 0
    while i < 3 {
        x = if i == 2 { "abcdef" } else { "ab" }
        i += 1
    }
    if count(x) != 6 || x.length != 6 { failures += 1 }

    var h: Holder = undefined
    h.after = 42
    h.text = "abc"
    h.text = "defghij"
    if count(h.text) != 7 || h.text.length != 7 { failures += 1 }
    h.other = "defghij"
    if h.other == null || count(h.other.?) != 7 || h.other.?.length != 7 { failures += 1 }
    h.other = null
    if h.other != null || h.after != 42 { failures += 1 }

    const o = optional(false)
    if o == null || count(o.?) != 7 { failures += 1 }
    if optional(true) != null { failures += 1 }
    var p: ?[]const u8 = "abc"
    p = null
    if p != null { failures += 1 }
    if measure("defghij", 3) != 773 { failures += 1 }
    if measure(null, 5) != 5 { failures += 1 }
    return 13 + failures
}
