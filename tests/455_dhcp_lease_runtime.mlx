// The kernel's DHCP client (projects/brix/kernel/net/lease.mlx, built for
// the host) on a clock and a wire of the test's own: DISCOVER and its
// pauses while nobody answers, the OFFER's REQUEST, an ACK with and
// without the lease's times, a router, a name server and a netmask, a
// T1 of no seconds and a lease of one second (no REQUEST with every
// tick), the REQUEST to the server at T1 with RENEWING's fields, an ACK that
// extends, silence until T2's REQUEST to everyone, the lease's end (the
// address given up, discovery again), a NAK, a lease for ever, a clock
// that jumps far ahead in one step, and answers that are cut short,
// malformed, or another exchange's or another machine's.
// Exits 13.
const std = @import("std")
const lease = @import("../projects/brix/kernel/net/lease.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

const SECOND: usize = lease.SECOND

// The clock, and the wire: the message sent last, from where to where,
// and how many were sent.
var clock: usize = 0
var sent: [512]u8 = undefined
var sentLength: usize = 0
var sentFrom: [4]u8 = undefined
var sentTo: [4]u8 = undefined
var sends: usize = 0

fn now() -> usize { return clock }

fn send(message: [*]const u8, length: usize, source: [*]const u8, destination: [*]const u8) -> void {
    var k: usize = 0
    while k < length && k < 512 {
        sent[k] = message[k]
        k += 1
    }
    sentLength = length
    k = 0
    while k < 4 {
        sentFrom[k] = source[k]
        sentTo[k] = destination[k]
        k += 1
    }
    sends += 1
}

var failed = false

fn expect(condition: bool, what: []const u8) -> void {
    if condition { return }
    failed = true
    say("FAIL ")
    say(what)
    say("\n")
}

fn word(bytes: [*]const u8, at: usize) -> usize {
    return (@intCast(usize, bytes[at]) << 24) | (@intCast(usize, bytes[at + 1]) << 16) | (@intCast(usize, bytes[at + 2]) << 8) | @intCast(usize, bytes[at + 3])
}

fn is(bytes: [*]const u8, a: u8, b: u8, c: u8, d: u8) -> bool { return bytes[0] == a && bytes[1] == b && bytes[2] == c && bytes[3] == d }

// Where option `wanted` of the message sent last has its value (0: it is
// not there).
fn sentOption(wanted: u8) -> usize {
    var at: usize = 240
    while at + 1 < sentLength {
        const option = sent[at]
        if option == 255 { return 0 }
        if option == 0 {
            at += 1
            continue
        }
        if option == wanted { return at + 2 }
        at += 2 + @intCast(usize, sent[at + 1])
    }
    return 0
}

// The message sent last from its byte `offset` on.
fn sentAt(offset: usize) -> [*]const u8 { return unsafe { @ptrFromInt([*]const u8, @intFromPtr(&sent) + offset) } }

fn sentKind() -> u8 {
    const at = sentOption(53)
    return if at == 0 { 0 } else { sent[at] }
}

fn sentXid() -> usize { return word(&sent, 4) }

// An answer being made: the fixed part for `kind` of exchange `xid` with
// "your address" a.b.c.d, then options, then the end.
var answer: [512]u8 = undefined
var answerLength: usize = 0

const MAC = [_]u8{ 0x52, 0x54, 0x00, 0x12, 0x34, 0x56 }

fn begin(kind: u8, xid: usize, a: u8, b: u8, c: u8, d: u8) -> void {
    var k: usize = 0
    while k < 512 {
        answer[k] = 0
        k += 1
    }
    answer[0] = 2
    answer[1] = 1
    answer[2] = 6
    answer[4] = @intCast(u8, (xid >> 24) & 255)
    answer[5] = @intCast(u8, (xid >> 16) & 255)
    answer[6] = @intCast(u8, (xid >> 8) & 255)
    answer[7] = @intCast(u8, xid & 255)
    answer[16] = a
    answer[17] = b
    answer[18] = c
    answer[19] = d
    k = 0
    while k < 6 {
        answer[28 + k] = MAC[k]
        k += 1
    }
    answer[236] = 0x63
    answer[237] = 0x82
    answer[238] = 0x53
    answer[239] = 0x63
    answer[240] = 53
    answer[241] = 1
    answer[242] = kind
    answerLength = 243
}

fn address(option: u8, a: u8, b: u8, c: u8, d: u8) -> void {
    answer[answerLength] = option
    answer[answerLength + 1] = 4
    answer[answerLength + 2] = a
    answer[answerLength + 3] = b
    answer[answerLength + 4] = c
    answer[answerLength + 5] = d
    answerLength += 6
}

fn seconds(option: u8, value: usize) -> void {
    address(option, @intCast(u8, (value >> 24) & 255), @intCast(u8, (value >> 16) & 255), @intCast(u8, (value >> 8) & 255), @intCast(u8, value & 255))
}

var client: lease.Client = undefined

// The answer, ended, given to the client.
fn give() -> lease.Change {
    answer[answerLength] = 255
    return client.receive(&answer, answerLength + 1)
}

const OFFER: u8 = 2
const ACK: u8 = 5
const NAK: u8 = 6
const SERVER = [_]u8{ 10, 10, 36, 1 }

// A client that has just started: its DISCOVER is on the wire.
fn fresh() -> void {
    clock = 5 * SECOND
    sends = 0
    client.init(lease.Outside.{ .now = now, .send = send }, &MAC)
    client.start()
}

// The server's OFFER of 10.10.36.77 for the DISCOVER on the wire: the
// client's REQUEST is on the wire after it.
fn offer() -> void {
    begin(OFFER, sentXid(), 10, 10, 36, 77)
    address(54, 10, 10, 36, 1)
    _ = give()
}

// The ACK for the REQUEST on the wire with everything in it: a lease of
// `time` seconds with T1 and T2 (0: left out).
fn ackFull(time: usize, renew: usize, rebind: usize) -> lease.Change {
    begin(ACK, sentXid(), 10, 10, 36, 77)
    address(1, 255, 255, 255, 0)
    address(3, 10, 10, 36, 1)
    address(6, 10, 10, 36, 53)
    address(54, 10, 10, 36, 1)
    if time != 0 { seconds(51, time) }
    if renew != 0 { seconds(58, renew) }
    if rebind != 0 { seconds(59, rebind) }
    return give()
}

// A client holding 10.10.36.77 for `time` seconds, the REQUEST sent at
// second 5.
fn bound(time: usize, renew: usize, rebind: usize) -> void {
    fresh()
    offer()
    _ = ackFull(time, renew, rebind)
}

fn discovery() -> void {
    fresh()
    expect(client.asking() && !client.has(), "asking after the start")
    expect(sends == 1 && sentLength == 300, "one DISCOVER of 300 bytes at the start")
    expect(sent[0] == 1 && sent[1] == 1 && sent[2] == 6 && sentKind() == 1, "the DISCOVER is a request, Ethernet, kind 1")
    expect(is(&sentFrom, 0, 0, 0, 0) && is(&sentTo, 255, 255, 255, 255), "the DISCOVER goes from 0.0.0.0 to everyone")
    expect(sent[10] == 0x80 && sent[11] == 0 && word(&sent, 12) == 0, "the DISCOVER asks for a broadcast answer and names no address")
    var k: usize = 0
    while k < 6 {
        expect(sent[28 + k] == MAC[k], "the hardware address in the DISCOVER")
        k += 1
    }
    const wanted = sentOption(55)
    expect(wanted != 0 && sent[wanted - 1] == 6 && sent[wanted] == 1 && sent[wanted + 1] == 3 && sent[wanted + 2] == 6 && sent[wanted + 3] == 51 && sent[wanted + 4] == 58 && sent[wanted + 5] == 59, "the DISCOVER wants netmask, router, name server, lease, T1, T2")
    // Nobody answers: again after 1, 2, 4, 8, 16, 16, 16 seconds, with
    // the same number, and for as long as nobody does.
    const xid = sentXid()
    const pauses = [_]usize{ 1, 2, 4, 8, 16, 16, 16, 16 }
    k = 0
    while k < 8 {
        clock += pauses[k] * SECOND - 1
        expect(client.tick() == lease.Change.none && sends == k + 1, "no DISCOVER before its pause is over")
        clock += 1
        expect(client.tick() == lease.Change.none && sends == k + 2 && sentKind() == 1 && sentXid() == xid, "the DISCOVER again when its pause is over")
        k += 1
    }
    expect(sent[8] == 0 && sent[9] == 79, "the DISCOVER says for how many seconds it has asked")
    // The link comes up: now, and from the short pause again.
    clock += 3 * SECOND
    client.linkUp()
    expect(sends == 10 && sentKind() == 1, "a DISCOVER at once when the link comes up")
    clock += SECOND
    _ = client.tick()
    expect(sends == 11, "the pause is short again after the link came up")
}

fn offerAndRequest() -> void {
    fresh()
    const xid = sentXid()
    offer()
    expect(client.asking() && client.state == lease.State.requesting, "requesting after the OFFER")
    expect(sends == 2 && sentKind() == 3 && sentXid() == xid, "a REQUEST with the exchange's number after the OFFER")
    expect(is(&sentFrom, 0, 0, 0, 0) && is(&sentTo, 255, 255, 255, 255), "the REQUEST goes from 0.0.0.0 to everyone")
    expect(word(&sent, 12) == 0 && sent[10] == 0x80, "the first REQUEST names no own address and asks for a broadcast answer")
    const asked = sentOption(50)
    const server = sentOption(54)
    expect(asked != 0 && is(sentAt(asked), 10, 10, 36, 77), "the REQUEST asks for the offered address")
    expect(server != 0 && is(sentAt(server), 10, 10, 36, 1), "the REQUEST names the offering server")
    // Nobody answers the REQUEST: again after 1, 2 and 4 seconds, and 8
    // seconds after the last one discovery starts again.
    const pauses = [_]usize{ 1, 2, 4 }
    var k: usize = 0
    while k < 3 {
        clock += pauses[k] * SECOND
        _ = client.tick()
        expect(sends == 3 + k && sentKind() == 3, "the REQUEST again")
        k += 1
    }
    clock += 8 * SECOND
    _ = client.tick()
    expect(sends == 6 && sentKind() == 1 && client.state == lease.State.discovering && sentXid() != xid, "discovery again, with another number, when the REQUEST is not answered")
}

fn acknowledged() -> void {
    // Everything in the answer.
    fresh()
    offer()
    expect(ackFull(3600, 600, 3000) == lease.Change.configured, "an ACK is a configuration")
    expect(client.has() && !client.asking() && client.state == lease.State.bound, "bound after the ACK")
    expect(is(&client.address, 10, 10, 36, 77) && is(&client.mask, 255, 255, 255, 0) && is(&client.router, 10, 10, 36, 1) && is(&client.nameServer, 10, 10, 36, 53) && is(&client.server, 10, 10, 36, 1), "the ACK's address, netmask, router, name server and server")
    expect(client.leaseTime == 3600 && client.left() == 3600, "the lease's time")
    expect(client.renewAt == (5 + 600) * SECOND && client.rebindAt == (5 + 3000) * SECOND && client.endsAt == (5 + 3600) * SECOND, "T1 and T2 as the server says, from when the REQUEST went")
    clock += 100 * SECOND
    expect(client.left() == 3500, "the lease's seconds left")

    // A REQUEST that went twice: the lease counts from the first.
    fresh()
    offer()
    clock += SECOND
    _ = client.tick()
    expect(sends == 3 && sentKind() == 3, "the REQUEST again after a second")
    _ = ackFull(3600, 0, 0)
    expect(client.endsAt == (5 + 3600) * SECOND, "the lease counts from the first REQUEST")

    // No T1 and T2: half and seven eighths.
    bound(3600, 0, 0)
    expect(client.renewAt == (5 + 1800) * SECOND && client.rebindAt == (5 + 3150) * SECOND, "T1 and T2 are half and seven eighths of the lease where the answer has none")
    // Times that do not fit (T1 after T2, T2 after the end): the same.
    bound(3600, 3000, 600)
    expect(client.renewAt == (5 + 1800) * SECOND && client.rebindAt == (5 + 3150) * SECOND, "T1 after T2 is not taken")
    bound(3600, 600, 4000)
    expect(client.renewAt == (5 + 1800) * SECOND && client.rebindAt == (5 + 3150) * SECOND, "T2 after the lease's end is not taken")
    bound(3600, 900, 0)
    expect(client.renewAt == (5 + 900) * SECOND && client.rebindAt == (5 + 3150) * SECOND, "T1 alone is taken")

    // No router, no name server: none (not what a lease before had, not
    // anything else).
    fresh()
    offer()
    begin(ACK, sentXid(), 10, 10, 36, 77)
    address(1, 255, 255, 252, 0)
    address(54, 10, 10, 36, 1)
    seconds(51, 3600)
    expect(give() == lease.Change.configured, "an ACK without a router and a name server is a configuration")
    expect(is(&client.address, 10, 10, 36, 77) && is(&client.mask, 255, 255, 252, 0) && is(&client.router, 0, 0, 0, 0) && is(&client.nameServer, 0, 0, 0, 0), "no router and no name server in the answer: none")

    // No netmask: the address's class's. No server named in the ACK: the
    // offer's.
    fresh()
    offer()
    begin(ACK, sentXid(), 10, 10, 36, 77)
    seconds(51, 3600)
    _ = give()
    expect(is(&client.mask, 255, 0, 0, 0) && is(&client.server, 10, 10, 36, 1), "no netmask in the answer: the class's; no server: the offer's")
    var mask: [4]u8 = undefined
    const b = [_]u8{ 172, 16, 1, 2 }
    const c = [_]u8{ 192, 168, 1, 2 }
    const d = [_]u8{ 224, 0, 0, 1 }
    lease.classMask(&b, &mask)
    expect(is(&mask, 255, 255, 0, 0), "172.16.1.2's class")
    lease.classMask(&c, &mask)
    expect(is(&mask, 255, 255, 255, 0), "192.168.1.2's class")
    lease.classMask(&d, &mask)
    expect(is(&mask, 255, 255, 255, 255), "224.0.0.1 has no class with hosts")
}

// A renewal is never due the moment its answer came (the next REQUEST
// went out with every answer then, as fast as the server answered): a
// T1 of no seconds is not taken, and half of a lease of one second is
// half a second.
fn soonest() -> void {
    fresh()
    offer()
    begin(ACK, sentXid(), 10, 10, 36, 77)
    address(54, 10, 10, 36, 1)
    seconds(51, 3600)
    seconds(58, 0)
    seconds(59, 3000)
    expect(give() == lease.Change.configured && client.renewAt == (5 + 1800) * SECOND && client.rebindAt == (5 + 3150) * SECOND, "a T1 of no seconds is not taken: half and seven eighths")
    expect(client.tick() == lease.Change.none && sends == 2 && client.state == lease.State.bound, "no REQUEST the moment the answer came")
    // The shortest lease there is, of a server that answers every
    // REQUEST at once, held for three seconds on a tick of 10 ms: a
    // REQUEST every half second, six of them, and the address all along.
    bound(1, 0, 0)
    expect(client.leaseTime == 1 && client.renewAt == 5 * SECOND + SECOND / 2 && client.rebindAt == 5 * SECOND + (SECOND / 8) * 7 && client.endsAt == 6 * SECOND, "a lease of one second: T1 after half a second, T2 after seven eighths")
    var asked: usize = 0
    var step: usize = 0
    while step < 300 {
        clock += SECOND / 100
        const before = sends
        expect(client.tick() == lease.Change.none && client.has(), "a lease of one second is held while its server answers")
        if sends != before {
            asked += 1
            expect(sentKind() == 3 && is(&sentTo, 10, 10, 36, 1), "a lease of one second is renewed of its server")
            _ = ackFull(1, 0, 0)
        }
        step += 1
    }
    expect(asked == 6, "a lease of one second is asked for again twice a second, not with every tick")
}

fn renewal() -> void {
    bound(3600, 600, 3000)
    const first = sentXid()
    clock = (5 + 600) * SECOND - 1
    expect(client.tick() == lease.Change.none && sends == 2 && client.state == lease.State.bound, "nothing before T1")
    clock += 1
    expect(client.tick() == lease.Change.none && sends == 3 && client.state == lease.State.renewing, "a message at T1")
    expect(client.has() && !client.asking(), "the address is held while it is renewed")
    expect(sentKind() == 3 && sentXid() != first, "T1's message is a REQUEST of a new exchange")
    expect(is(&sentFrom, 10, 10, 36, 77) && is(&sentTo, 10, 10, 36, 1), "T1's REQUEST goes from the own address to the server")
    expect(is(sentAt(12), 10, 10, 36, 77) && sent[10] == 0 && sent[11] == 0, "T1's REQUEST names the own address and asks for no broadcast")
    expect(sentOption(50) == 0 && sentOption(54) == 0, "T1's REQUEST has no requested-address and no server-identifier option")
    expect(is(sentAt(16), 0, 0, 0, 0) && sentLength == 300, "T1's REQUEST leaves \"your address\" empty")
    // The ACK extends: the lease runs from when this REQUEST went, and
    // nothing changed.
    clock += 2 * SECOND
    expect(ackFull(3600, 600, 3000) == lease.Change.renewed, "an ACK with the same configuration renews")
    expect(client.state == lease.State.bound && client.endsAt == (605 + 3600) * SECOND && client.renewAt == (605 + 600) * SECOND, "the renewed lease runs from its REQUEST")
    expect(client.left() == 3598, "the renewed lease's seconds left")
    clock = (605 + 600) * SECOND - 1
    expect(client.tick() == lease.Change.none && sends == 3, "nothing before the renewed lease's T1")
    clock += 1
    _ = client.tick()
    expect(sends == 4 && client.state == lease.State.renewing, "the renewed lease is renewed at its T1")
    // An ACK that changes something (another name server) is a new
    // configuration.
    begin(ACK, sentXid(), 10, 10, 36, 77)
    address(1, 255, 255, 255, 0)
    address(3, 10, 10, 36, 1)
    address(6, 10, 10, 36, 54)
    address(54, 10, 10, 36, 1)
    seconds(51, 3600)
    expect(give() == lease.Change.configured && is(&client.nameServer, 10, 10, 36, 54), "a renewal with another name server is a new configuration")
}

fn silence() -> void {
    // T1 1800, T2 3150, the end 3600 (after second 5).
    bound(3600, 0, 0)
    clock = (5 + 1800) * SECOND
    _ = client.tick()
    expect(sends == 3 && is(&sentTo, 10, 10, 36, 1), "T1's REQUEST to the server")
    const xid = sentXid()
    // Nobody answers: again after half of what is left to T2 (675, then
    // 337.5 seconds), to the server.
    clock += 675 * SECOND - 1
    _ = client.tick()
    expect(sends == 3, "no second REQUEST before half the time to T2")
    clock += 1
    _ = client.tick()
    expect(sends == 4 && is(&sentTo, 10, 10, 36, 1) && sentXid() == xid, "the REQUEST again after half the time to T2")
    clock += 337 * SECOND + SECOND / 2
    _ = client.tick()
    expect(sends == 5 && client.state == lease.State.renewing, "and after half of the rest")
    // (Not more often than once a minute.)
    clock = (5 + 3150) * SECOND - 61 * SECOND
    _ = client.tick()
    const before = sends
    clock += 59 * SECOND
    _ = client.tick()
    expect(sends == before, "a REQUEST is not sent again within a minute")
    // T2: to everyone, from the own address, the own address named.
    clock = (5 + 3150) * SECOND
    expect(client.tick() == lease.Change.none && client.state == lease.State.rebinding, "rebinding at T2")
    expect(sends == before + 1 && sentKind() == 3 && is(&sentFrom, 10, 10, 36, 77) && is(&sentTo, 255, 255, 255, 255), "T2's REQUEST goes from the own address to everyone")
    expect(is(sentAt(12), 10, 10, 36, 77) && sentOption(50) == 0 && sentOption(54) == 0 && sentXid() == xid, "T2's REQUEST has RENEWING's fields and number")
    expect(client.has(), "the address is still held after T2")
    // The end: the address is given up, and a DISCOVER goes at once.
    clock = (5 + 3600) * SECOND - 1
    expect(client.tick() != lease.Change.lost && client.has(), "the address is held to the lease's last second")
    const sentBefore = sends
    clock += 1
    expect(client.tick() == lease.Change.lost, "the lease's end gives the address up")
    expect(!client.has() && client.asking() && client.reason == lease.Reason.expired && client.left() == 0, "asking again, the lease ran out")
    expect(is(&client.address, 0, 0, 0, 0) && is(&client.router, 0, 0, 0, 0) && is(&client.nameServer, 0, 0, 0, 0), "nothing is left of the configuration")
    expect(sends == sentBefore + 1 && sentKind() == 1 && is(&sentFrom, 0, 0, 0, 0) && is(&sentTo, 255, 255, 255, 255) && word(&sent, 12) == 0 && sentXid() != xid, "a DISCOVER from 0.0.0.0 with a new number at the lease's end")
    expect(client.tick() == lease.Change.none, "the address is given up once")
    // And an address again from there.
    offer()
    expect(ackFull(3600, 0, 0) == lease.Change.configured && client.has() && client.endsAt == (5 + 3600 + 3600) * SECOND, "a new lease after the old one ran out")

    // A rebinding lease that is answered is bound again.
    bound(3600, 0, 0)
    clock = (5 + 3150) * SECOND
    _ = client.tick()
    expect(client.state == lease.State.rebinding, "rebinding without having renewed (the clock went from before T1 to T2)")
    expect(ackFull(3600, 0, 0) == lease.Change.renewed && client.state == lease.State.bound && client.endsAt == (5 + 3150 + 3600) * SECOND, "an ACK while rebinding renews")
}

fn refused() -> void {
    // A NAK while renewing: the address is given up at once.
    bound(3600, 600, 3000)
    clock = (5 + 600) * SECOND
    _ = client.tick()
    const before = sends
    begin(NAK, sentXid(), 0, 0, 0, 0)
    address(54, 10, 10, 36, 1)
    expect(give() == lease.Change.lost, "a NAK while renewing gives the address up")
    expect(!client.has() && client.asking() && client.reason == lease.Reason.refused && is(&client.address, 0, 0, 0, 0), "asking again, the server refused")
    expect(sends == before + 1 && sentKind() == 1 && is(&sentFrom, 0, 0, 0, 0), "a DISCOVER after the NAK")
    // A NAK for the offer's REQUEST: nothing was held, so nothing is
    // lost; discovery again when the pause is over.
    fresh()
    offer()
    begin(NAK, sentXid(), 0, 0, 0, 0)
    expect(give() == lease.Change.none && client.state == lease.State.discovering && sends == 2, "a NAK for the offer: discovering, nothing sent yet")
    clock += 2 * SECOND
    _ = client.tick()
    expect(sends == 3 && sentKind() == 1, "a DISCOVER when the pause after the NAK is over")
    // A NAK while bound (nothing was asked) is nobody's answer.
    bound(3600, 600, 3000)
    begin(NAK, sentXid(), 0, 0, 0, 0)
    expect(give() == lease.Change.none && client.has(), "a NAK that answers nothing is not taken")
}

fn forEver() -> void {
    bound(lease.FOR_EVER, 0, 0)
    expect(client.has() && client.leaseTime == lease.FOR_EVER && client.left() == lease.FOR_EVER, "a lease of 0xFFFFFFFF does not end")
    clock += 400 * 365 * 86400 * SECOND
    expect(client.tick() == lease.Change.none && sends == 2 && client.has() && client.left() == lease.FOR_EVER, "a lease for ever is never renewed and never ends")
    // An answer without a lease time (BOOTP's): the same.
    fresh()
    offer()
    expect(ackFull(0, 0, 0) == lease.Change.configured && client.leaseTime == lease.FOR_EVER, "an ACK without a lease time is a lease for ever")
    clock += 86400 * SECOND
    expect(client.tick() == lease.Change.none && sends == 2, "and is not renewed")
    // The longest lease that ends: its times do not overflow.
    bound(0xFFFFFFFE, 0, 0)
    expect(client.left() == 0xFFFFFFFE && client.endsAt == (5 + 0xFFFFFFFE) * SECOND, "the longest lease that ends")
}

fn jumps() -> void {
    // From before T1 to after the end in one step: given up, a DISCOVER,
    // no REQUEST on the way.
    bound(3600, 600, 3000)
    clock += 86400 * SECOND
    expect(client.tick() == lease.Change.lost && sends == 3 && sentKind() == 1 && client.asking(), "a clock that jumps past the lease's end gives the address up")
    // From before T1 to between T2 and the end: straight to everyone.
    bound(3600, 600, 3000)
    clock = (5 + 3300) * SECOND
    expect(client.tick() == lease.Change.none && client.state == lease.State.rebinding && sends == 3 && is(&sentTo, 255, 255, 255, 255) && is(&sentFrom, 10, 10, 36, 77), "a clock that jumps past T2 asks everyone")
    // While renewing, past the end.
    bound(3600, 600, 3000)
    clock = (5 + 600) * SECOND
    _ = client.tick()
    clock += 30 * 86400 * SECOND
    expect(client.tick() == lease.Change.lost && sentKind() == 1, "a clock that jumps past the end while renewing gives the address up")
}

fn notTaken() -> void {
    fresh()
    offer()
    const xid = sentXid()
    // Cut short: before the options, in an option's length, in its value.
    begin(ACK, xid, 10, 10, 36, 77)
    seconds(51, 3600)
    expect(client.receive(&answer, 200) == lease.Change.none, "an answer cut before its options is not taken")
    expect(client.receive(&answer, 242) == lease.Change.none, "an answer cut in its first option is not taken")
    expect(client.receive(&answer, 244) == lease.Change.none, "an answer cut after an option's number is not taken")
    expect(client.receive(&answer, 247) == lease.Change.none, "an answer cut in an option's value is not taken")
    // An option that says it is longer than the message.
    begin(ACK, xid, 10, 10, 36, 77)
    answer[answerLength] = 6
    answer[answerLength + 1] = 200
    answerLength += 2
    expect(client.receive(&answer, answerLength + 6) == lease.Change.none, "an option longer than the message: not taken")
    // The wrong magic number, a request instead of a reply, another kind
    // of hardware.
    begin(ACK, xid, 10, 10, 36, 77)
    seconds(51, 3600)
    answer[237] = 0
    expect(give() == lease.Change.none, "another magic number: not taken")
    begin(ACK, xid, 10, 10, 36, 77)
    seconds(51, 3600)
    answer[0] = 1
    expect(give() == lease.Change.none, "a request is not an answer")
    begin(ACK, xid, 10, 10, 36, 77)
    seconds(51, 3600)
    answer[2] = 16
    expect(give() == lease.Change.none, "another hardware's length: not taken")
    // No kind, no address, a lease of no seconds.
    begin(ACK, xid, 10, 10, 36, 77)
    answer[240] = 0
    answer[241] = 0
    answer[242] = 0
    seconds(51, 3600)
    expect(give() == lease.Change.none, "an answer without its kind: not taken")
    begin(ACK, xid, 0, 0, 0, 0)
    seconds(51, 3600)
    expect(give() == lease.Change.none, "an ACK without an address: not taken")
    begin(ACK, xid, 10, 10, 36, 77)
    seconds(51, 0)
    expect(give() == lease.Change.none, "an ACK with a lease of no seconds: not taken")
    // Another exchange's, another machine's.
    begin(ACK, xid + 1, 10, 10, 36, 77)
    seconds(51, 3600)
    expect(give() == lease.Change.none, "another exchange's answer: not taken")
    begin(ACK, xid, 10, 10, 36, 77)
    seconds(51, 3600)
    answer[33] = 0x57
    expect(give() == lease.Change.none, "an answer for another hardware address: not taken")
    // An OFFER where an ACK is waited for.
    begin(OFFER, xid, 10, 10, 36, 78)
    expect(give() == lease.Change.none, "a second OFFER while requesting: not taken")
    expect(client.state == lease.State.requesting && !client.has() && sends == 2, "none of them moved the client")
    // And the one that is right.
    begin(ACK, xid, 10, 10, 36, 77)
    seconds(51, 3600)
    expect(give() == lease.Change.configured && client.has(), "the right answer after them is taken")
    // An ACK while bound (nothing was asked), an ACK to a client that
    // never started.
    begin(ACK, xid, 10, 10, 36, 99)
    seconds(51, 60)
    expect(give() == lease.Change.none && is(&client.address, 10, 10, 36, 77) && client.leaseTime == 3600, "an ACK nobody asked for: not taken")
    client.init(lease.Outside.{ .now = now, .send = send }, &MAC)
    expect(give() == lease.Change.none && client.tick() == lease.Change.none && !client.asking() && !client.has(), "a client that was not started takes nothing and sends nothing")
    // While discovering: an ACK is not an OFFER, an OFFER of no address
    // is none.
    fresh()
    begin(ACK, sentXid(), 10, 10, 36, 77)
    seconds(51, 3600)
    expect(give() == lease.Change.none && client.state == lease.State.discovering, "an ACK while discovering: not taken")
    begin(OFFER, sentXid(), 0, 0, 0, 0)
    expect(give() == lease.Change.none && client.state == lease.State.discovering && sends == 1, "an OFFER of no address: not taken")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = arguments
    discovery()
    offerAndRequest()
    acknowledged()
    soonest()
    renewal()
    silence()
    refused()
    forEver()
    jumps()
    notTaken()
    if failed { return 1 }
    return 13
}
