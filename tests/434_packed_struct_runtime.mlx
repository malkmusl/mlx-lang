// Packed structs (spec aggregates.xml PackedLayout, types.xml: packed
// fields occupy exactly N bits): no padding, the fields' offsets in bits,
// the struct the size of the integer holding them (1, 2, 4 or 8 bytes);
// fields read and written through shifts and masks, signed fields with
// their sign (a bool keeps its 8 bits: it is not an integer); literals, module-level constants, compound assignments,
// access through a pointer, and @bitCast between the struct and an
// integer of its width. Exits 13 when every check holds, else the number
// of the first check that failed.
const Color = packed struct {
    r: u9
    g: u9
    b: u9
    e: u5
}

const Flags = packed struct {
    on: bool
    level: u3
    sign: i4
}

const Wide = packed struct {
    low: u40
    high: u24
}

const Three = packed struct {
    a: u6
    b: u6
    c: u6
}

const PRESET = Color.{ .r = 1, .g = 2, .b = 3, .e = 4 }
var shared: Color = Color.{ .r = 511, .g = 0, .b = 256, .e = 31 } // (per run)

fn exponent(c: *const Color) -> u32 { return @intCast(u32, c.*.e) }

fn setGreen(c: *Color, value: u9) -> void { c.*.g = value }

pub fn main() -> u8 {
    if @sizeOf(Color) != 4 { return 1 }
    if @sizeOf(Flags) != 2 { return 2 }
    if @sizeOf(Wide) != 8 { return 3 }
    if @sizeOf(Three) != 4 { return 4 }
    var c: Color = undefined
    c.r = 1
    c.g = 2
    c.b = 3
    c.e = 4
    if @bitCast(u32, c) != 1 + (2 << 9) + (3 << 18) + (4 << 27) { return 5 }
    if c.r != 1 || c.g != 2 || c.b != 3 || c.e != 4 { return 6 }
    c.g = 511
    if c.r != 1 || c.g != 511 || c.b != 3 || c.e != 4 { return 7 }
    c.e += 1
    if c.e != 5 || c.b != 3 { return 8 }
    const literal = Color.{ .r = 300, .g = 0, .b = 7, .e = 31 }
    if @bitCast(u32, literal) != 300 + (7 << 18) + (31 << 27) { return 9 }
    if @bitCast(u32, PRESET) != 1 + (2 << 9) + (3 << 18) + (4 << 27) { return 10 }
    if shared.r != 511 || shared.g != 0 || shared.b != 256 || shared.e != 31 { return 11 }
    setGreen(&shared, 77)
    if shared.g != 77 || shared.r != 511 { return 12 }
    if exponent(&shared) != 31 { return 14 }
    const back = @bitCast(Color, @intCast(u32, 5 + (6 << 9) + (7 << 18) + (8 << 27)))
    if back.r != 5 || back.g != 6 || back.b != 7 || back.e != 8 { return 15 }
    var f: Flags = undefined
    f.on = true
    f.level = 5
    f.sign = -3
    if @bitCast(u16, f) != 1 + (5 << 8) + (13 << 11) { return 16 }
    if !f.on || f.level != 5 || f.sign != -3 { return 17 }
    if @intCast(i32, f.sign) + 3 != 0 { return 18 }
    f.on = false
    if f.on || @bitCast(u16, f) != (5 << 8) + (13 << 11) { return 19 }
    var w: Wide = undefined
    w.low = 0xFFFFFFFFFF
    w.high = 0xABCDEF
    if w.low != 0xFFFFFFFFFF || w.high != 0xABCDEF { return 20 }
    if @bitCast(u64, w) != 0xABCDEFFFFFFFFFFF { return 21 }
    const t = Three.{ .a = 63, .b = 1, .c = 32 }
    if @bitCast(u32, t) != 63 + (1 << 6) + (32 << 12) { return 22 }
    const pointer: *const Color = &c
    if pointer.*.g != 511 { return 23 }
    return 13
}
