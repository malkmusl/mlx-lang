// Types written over a comptime type parameter resolve in a generic
// function's signature and body: `[*]T`, `[]const T`, `?T`, `*T` as
// parameters and results, `[*]T` as a local. Exits 13.
const std = @import("std")

fn manyParam(comptime T: type, p: [*]T) -> usize {
    return @sizeOf(T)
}

fn sliceParam(comptime T: type, p: []const T) -> usize {
    return p.length
}

fn optionalReturn(comptime T: type, value: T) -> ?T {
    return value
}

fn pointerReturn(comptime T: type, p: *T) -> *T {
    return p
}

fn manyLocal(comptime T: type, allocator: std.allocator.Allocator) -> usize {
    const bytes = allocator.alloc(4 * @sizeOf(T), @alignOf(T)).?
    var items: [*]T = undefined
    unsafe { items = @ptrCast([*]T, bytes) }
    return @intFromPtr(items) & 1
}

fn main() -> u8 {
    var words: [4]u32 = [4]u32{ 1, 2, 3, 4 }
    const a = manyParam(u32, &words)
    const b = sliceParam(u32, words[0..4])
    const c = optionalReturn(u32, 7)
    const d = pointerReturn(u32, &words[1])
    const e = manyLocal(u32, std.page_allocator.init())
    if a != 4 || b != 4 || c.? != 7 || d.* != 2 || e != 0 { return 1 }
    return 13
}
