// Regression test for a real IR-lowering bug: initializing a memory-typed
// (array/struct/union) field of an aggregate literal with `undefined`
// dereferenced a bogus address instead of leaving the field's already
// -allocated storage untouched, crashing with SIGSEGV.
//
// Root cause: `lowerAggregateLiteral`'s per-field loop always lowered the
// initializer expression and called `storeAggregateValue` /
// `aggregate_copy.emit` for a memory-typed field, regardless of what the
// initializer was. `undefined` lowers to a single scalar `const_i 0`
// (`lowerNode`'s `undefined_literal` case) for every type uniformly -- fine
// for a scalar field, but for a memory-typed field `aggregate_copy.emit`
// treats that value as the *source address* to copy from and unconditionally
// `load`s through it, so an `undefined` array/struct/union field inside a
// `Type.{ ... }` literal dereferenced address 0 and crashed. A whole
// -variable `var x: T = undefined` was already handled correctly elsewhere
// (`lowerBindingInitializer`, which allocates fresh uninitialized storage
// instead of trying to copy from a bogus source) -- this bug was specific to
// per-field `undefined` inside an aggregate literal. Fixed by skipping the
// store entirely for a memory-typed field initialized with `undefined`,
// matching `lowerBindingInitializer`'s treatment (see
// compiler/selfhost/ir/lower.mlx's `lowerAggregateLiteral`).
//
// Exercises an array field and a nested-struct field, each initialized with
// `undefined` inside a struct literal, both locally and returned by value
// from a function -- and confirms sibling fields that ARE given real values
// in the same literal still land correctly (the fix must not skip real
// stores, only true `undefined` ones).

const std = @import("std")

const Inner = struct {
    a: usize
    b: usize
}

const Holder = struct {
    words: [8]usize
    inner: Inner
    tag: usize
}

fn makeHolder() -> Holder {
    return Holder.{ .words = undefined, .inner = undefined, .tag = 42 }
}

pub fn main() -> u8 {
    var failures: u8 = 0

    const local: Holder = Holder.{ .words = undefined, .inner = undefined, .tag = 7 }
    if local.tag != 7 { failures |= 1 }

    const returned: Holder = makeHolder()
    if returned.tag != 42 { failures |= 2 }

    return failures
}
