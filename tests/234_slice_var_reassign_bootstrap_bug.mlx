// Regression test for a mlx0 (bootstrap) codegen bug: a `var` of slice type
// (`[]const u8`) initialized from an empty string literal, then reassigned
// inside an `unsafe` block to a pointer-derived slice of nonzero length,
// silently keeps a stale/zero length. Iterating the reassigned slice (or
// passing it on) then observes zero elements instead of the real content.
//
// Discovered while threading a `path: []const u8` diagnostic parameter
// through compiler/selfhost/driver/pipeline.mlx: `var failing_path: []const
// u8 = ""; unsafe { failing_path = ptr[0..len] }` produced a length-0 slice
// even though `len` was genuinely 16. The workaround is to avoid the
// pre-declared-empty-then-reassigned pattern and instead return the slice
// directly from a function (see modules/loader.mlx `modulePath`), which
// works correctly. This test pins the underlying bug so a future fix to
// mlx0's slice-assignment lowering is caught.
//
// Expected once fixed: exit 13. Currently fails (observed count 0, not 11).
const io = @import("../std/bootstrap/io.mlx")

pub fn main() -> u8 {
    var x: []const u8 = ""
    unsafe {
        const literal = "hello world"
        const pointer = @ptrCast([*]const u8, literal)
        x = pointer[0..11]
    }
    var count: usize = 0
    for byte in x { count += 1 }
    if count != 11 { return 1 }
    return 13
}
