// The kernel's read-out of a Polaris card's display controller
// (projects/brix/kernel/gpu_display.mlx, built for the host) on register
// tables of the test's own, the numbers written here as Linux's headers
// have them: the firmware's 1280x960 picture scaled by the card onto a
// 3840x1080 timing (the surface, viewport, scaler and line buffer the next
// stage would set), the same picture inside borders, a 1280x960 timing on
// another controller that sends the picture as it is, controllers that
// are off, and states that do not fit together, where nothing is
// concluded. The frames in a second against a clock of the test's, the
// raw dump's lines, flags beside the fields that are read, every
// controller at its own numbers, two controllers on, and that no register
// is read whose reading changes something.
// With an argument, the log of every state is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

// The card: registers by number (those not set read 0), a clock that goes
// on by STEP at every look, and one frame counter that runs with it (from
// `frameStart`, in 24 bits).
const ROOM: usize = 256
const STEP: usize = 500
var numbers: [ROOM]usize = undefined
var values: [ROOM]usize = undefined
var used: usize = 0
var clock: usize = 0
var frameCounter: usize = 0
var framePeriod: usize = 0
var frameStart: usize = 0
// Whether a register was read that must not be: one whose reading moves
// something on, or one outside the register aperture.
var forbidden = false

// The log the read-out writes.
const LOG: usize = 32768
var log: [LOG]u8 = undefined
var logged: usize = 0
var show = false

fn set(number: usize, value: usize) -> void {
    var k: usize = 0
    while k < used {
        if numbers[k] == number {
            values[k] = value
            return
        }
        k += 1
    }
    numbers[used] = number
    values[used] = value
    used += 1
}

// The controllers' register offsets (vid.h), and their VGA words
// (D1VGA_CONTROL to D6VGA_CONTROL), which are not at the offsets.
const OFFSETS = [_]usize{ 0x0, 0x200, 0x400, 0x2600, 0x2800, 0x2A00 }
const VGA = [_]usize{ 0xCC, 0xCE, 0xF8, 0xF9, 0xFA, 0xFB }

fn read(number: usize) -> u32 {
    if number >= 0x10000 || number < 2 { forbidden = true }
    var n: usize = 0
    while n < 6 {
        // The colour table's data, the scaler's coefficient memory and the
        // timing's test window.
        const local = if number >= OFFSETS[n] { number - OFFSETS[n] } else { 0 }
        if (local >= 0x1A7A && local <= 0x1A7C) || local == 0x1B40 || local == 0x1B41 || local == 0x1BC6 || local == 0x1BC7 { forbidden = true }
        n += 1
    }
    if framePeriod != 0 && number == frameCounter { return @intCast(u32, (frameStart + clock / framePeriod) & 0xFFFFFF) }
    var k: usize = 0
    while k < used {
        if numbers[k] == number { return @intCast(u32, values[k]) }
        k += 1
    }
    return 0
}

fn now() -> usize {
    clock += STEP
    return clock
}

fn write(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length && logged < LOG {
        log[logged] = text[k]
        logged += 1
        k += 1
    }
    if show { say(text) }
}

fn has(text: []const u8) -> bool {
    if text.length > logged { return false }
    var at: usize = 0
    while at + text.length <= logged {
        var k: usize = 0
        while k < text.length && log[at + k] == text[k] { k += 1 }
        if k == text.length { return true }
        at += 1
    }
    return false
}

// The first expectation that did not hold (0: all did).
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(has(text), text) }

fn noLine(text: []const u8) -> void {
    if !has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

// A state begun: no registers, the card's 8 GiB at 0xf400000000
// (MC_VM_FB_LOCATION), the clock at 0, no frame counter running.
fn begin(name: []const u8) -> void {
    used = 0
    logged = 0
    clock = 0
    framePeriod = 0
    frameCounter = 0
    frameStart = 0
    set(0x809, 0xF5FFF400)
    if show {
        say("-- ")
        say(name)
        say("\n")
    }
}

// A controller on at offset `at` with a timing: the size shown, the
// totals, the sync pulse and what follows it to the picture (the counters
// begin with the sync, as amdgpu's display core sets them).
fn timing(at: usize, width: usize, height: usize, hTotal: usize, vTotal: usize, hSync: usize, hBack: usize, vSync: usize, vBack: usize) -> void {
    set(at + 0x1B9C, 0x00010001)
    set(at + 0x1B80, hTotal - 1)
    set(at + 0x1B87, vTotal - 1)
    set(at + 0x1B81, ((hSync + hBack) << 16) | (hSync + hBack + width))
    set(at + 0x1B8D, ((vSync + vBack) << 16) | (vSync + vBack + height))
    set(at + 0x1B82, hSync << 16)
    set(at + 0x1B8E, vSync << 16)
    set(at + 0x1B8F, 1)
}

// The firmware's picture as a controller's surface: 1280x960, 32 bits a
// pixel in rows, at the start of the card's memory, all of it in the
// viewport.
fn picture(at: usize) -> void {
    set(at + 0x1A00, 1)
    set(at + 0x1A01, 2)
    set(at + 0x1A04, 0)
    set(at + 0x1A07, 0xF4)
    set(at + 0x1A06, 1280)
    set(at + 0x1A0D, 1280)
    set(at + 0x1A0E, 960)
    set(at + 0x1B5C, 0)
    set(at + 0x1B5D, (1280 << 16) | 960)
}

// Controller 0 as the machine may have it: the monitor's 3840x1080 timing
// (4000x1111 in all, a frame every 16.6665 ms), the picture made large by
// the scaler, out by DisplayPort on DIG 1, four lanes.
fn scaled() -> void {
    timing(0, 3840, 1080, 4000, 1111, 32, 80, 10, 15)
    picture(0)
    set(0x1B42, 1)
    set(0x1B43, 0x303)
    set(0x1B49, 0x555555)
    set(0x1B4C, 0xE38E38)
    set(0x1AC1, 0x1006B0)
    set(0x321, 0x12)
    set(0x4B48, 0x101)
    set(0x4B47, 0x10000200)
    set(0x4B00, 0x400)
    set(0x4BA3, 3)
    set(0x4BA0, 0x10)
    set(0x4BA4, 0x10001)
    set(0x140, 0x10)
    set(0x141, 266640000)
    set(0x142, 600000000)
    frameCounter = 0x1BA6
    framePeriod = 16666500
}

// What the kernel knows of the firmware's picture: 1280x960 at the start
// of an aperture of 256 MiB.
fn known() -> scanout.Memory {
    return scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
}

var readout: scanout.Readout = undefined

// The state read out, with the raw dump after it.
fn run(memory: *const scanout.Memory) -> void {
    const card = scanout.Card.{ .read = read, .now = now, .write = write }
    scanout.report(&card, memory, &readout)
    scanout.dump(&card, &readout)
}

// The scaled state with one thing wrong: nothing is concluded, and the
// log says what does not fit.
fn wrong(name: []const u8, number: usize, value: usize, fault: scanout.Fault, what: []const u8) -> void {
    begin(name)
    scaled()
    framePeriod = 0
    set(number, value)
    const memory = known()
    run(&memory)
    expect(!readout.plausible, name)
    expect(readout.faults[0] == fault, name)
    expect(readout.shows[0] == scanout.Shows.not_plausible, name)
    line(what)
    line("): the register map needs correcting\n")
    noLine("the card scales")
    noLine("the monitor is sent")
    noLine("would set")
    noLine("next stage")
    // (All six controllers' registers in the dump then: controller 5's
    // formatter is the last of them.)
    line(" 45f2: 00000000\n")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    var memory = known()

    // (a) The card scales.
    begin("the firmware's picture scaled by the card (a)")
    scaled()
    run(&memory)
    line("gpu: the card's memory is 0xf400000000 to 0xf5ffffffff of its own addresses (fb_location 0xf5fff400)\n")
    line("gpu: controller 0 is on (control 0x10001): 3840x1080 of 4000x1111, h blank 3952..112 sync 0..32 +, v blank 1105..25 sync 0..10 -\n")
    line("gpu: controller 0 surface on at 0xf400000000 (0x0 of the card's memory), pitch 1280, x 0..1280, y 0..960, control 0x2 (depth 2, format 0, array mode 0)\n")
    line("gpu: controller 0 viewport 0,0 1280x960 to fill 3840x1080, borders left 0 right 0 top 0 bottom 0\n")
    line("gpu: controller 0 scaler mode 1 (on), bypass 0, taps 4x4, ratios 0x555555 0xe38e38 (as the sizes give), line buffer config 1 size 1712, DMIF buffers 2\n")
    line("gpu: controller 0 goes out by DIG 1 (front end 1): DisplayPort, 4 lanes, trained, stream on\n")
    line("gpu: controller 0 counts 60.000 frames a second: a pixel clock of 266642 kHz (measured; the PLL is not read, its registers are not known here)\n")
    line("gpu: controller 0 clock made for DisplayPort: phase 266640000 of modulo 600000000 (of a reference of 600004 kHz, by the measured clock)\n")
    line("gpu: controllers off: 1 2 3 4 5\n")
    line("gpu: controller 0 shows 3840x1080 from a picture of 1280x960: the card scales\n")
    line("gpu: next stage: a picture of 3840x1080 on the running controller (surface, viewport, scaler off, line buffer; clock, timing and link only for another size)\n")
    line("gpu: would set a picture of 3840x1080 after the firmware's: 16200 KiB at 0x500000 of the aperture\n")
    line("gpu: would set surface address 0xf400500000, pitch 3840, x 0..3840, y 0..1080, control 0x2 as it is\n")
    line("gpu: would set viewport 0,0 3840x1080, scaler mode 0 (off, its prescaler bit too), borders 0, line buffer config 0\n")
    noLine("not plausible")
    noLine("not there yet")
    expect(readout.plausible && readout.on == 1, "one controller on, plausible")
    expect(readout.shows[0] == scanout.Shows.scaled && readout.shows[1] == scanout.Shows.off && readout.shows[5] == scanout.Shows.off, "controller 0 scaled, the others off")
    expect(readout.base == 0xF400000000 && readout.top == 0xF5FFFFFFFF, "the card's memory")
    const c = &readout.controllers[0]
    expect(c.*.width == 3840 && c.*.height == 1080 && c.*.hTotal == 4000 && c.*.vTotal == 1111, "the timing decoded")
    expect(c.*.filledWidth() == 3840 && c.*.surfaceWidth() == 1280 && c.*.surfaceHeight() == 960, "the sizes")
    expect(c.*.encoder.found && c.*.encoder.backEnd == 1 && c.*.encoder.mode == scanout.MODE_DISPLAYPORT && c.*.encoder.lanes == 4, "the encoder")
    expect(c.*.rate.frames == 8 && c.*.rate.millihertz == 60000 && c.*.rate.kilohertz == 266642, "the frames counted")
    const p = scanout.plan(c, &memory, readout.base)
    expect(p.fits && p.width == 3840 && p.height == 1080 && p.pitch == 3840, "the plan's size")
    expect(p.offset == 0x500000 && p.bytes == 16588800 && p.address == 0xF400500000 && p.control == 2 && p.lineBuffer == 0, "the plan's place")
    // The dump: the words outside the controllers, the encoders, and of
    // the controllers only the one that is on.
    line("gpu: raw 0809: f5fff400 00cc: 00000000 00ce: 00000000 00f8: 00000000 00000000 00000000 00000000\n")
    line("gpu: raw 0321: 00000012 00000000 00000000 00000000 00000000 00000000\n")
    line("gpu: raw 0140: 00000010 0fe49a80 23c34600 00000000 00000000 00000000 00000000 00000000\ngpu: raw 0148: ")
    line("gpu: raw 1b9c: 00010001 1d9c: 00000000 1f9c: 00000000 419c: 00000000 439c: 00000000 459c: 00000000\n")
    line("gpu: raw 4b00: 00000400 4b09: 00000000 4b47: 10000200 00000101 4ba0: 00000010 00000000 4ba3: 00000003 00010001\ngpu: raw 4ba8: 00000000 00000000 00000000\n")
    line("gpu: raw 5400: 00000000 5409: ")
    line("gpu: raw 1a00: 00000001 00000002 00000000 00000000 00000000 00000000 00000500 000000f4\n")
    line("gpu: raw 1a08: 00000000 00000000 00000000 00000000 00000000 00000500 000003c0 1a10: 00000000\n")
    line("gpu: raw 1ac0: 00000000 001006b0 00000000 00000000 1b30: 00000000 00000000 00000000 00000000\n")
    line("gpu: raw 1b34: 00000000 00000000 00000000 00000000 1b42: 00000001 00000303 ")
    line(" 1b5b: 00000000 00000000 050003c0 00000000 00000000\ngpu: raw 1b6d: 00000000\n")
    line("gpu: raw 1b80: 00000f9f 00700f70 00200000 00000000 00000000 00000000 00000000 00000456\n")
    line(" 1bee: 00000000 1bf2: 00000000\n")
    noLine(" 1d80:")
    noLine(" 45f2:")

    // A surface taller than the picture, of which the picture's part is
    // shown, is the picture all the same.
    begin("a surface larger than the picture")
    scaled()
    framePeriod = 0
    set(0x1A0E, 1024)
    run(&memory)
    line("gpu: controller 0 shows 3840x1080 from a picture of 1280x960: the card scales\n")
    noLine("not plausible")

    // Ratios that are not what the two sizes give are said beside them.
    begin("ratios of other sizes")
    scaled()
    framePeriod = 0
    set(0x1B49, 0x800000)
    run(&memory)
    line("gpu: controller 0 scaler mode 1 (on), bypass 0, taps 4x4, ratios 0x800000 0xe38e38 (the sizes give 0x555555 0xe38e38), line buffer")

    // The same with no picture known to the kernel (the card is not the
    // console's): the new surface goes after the one shown.
    begin("the same on a card that is not the console's")
    scaled()
    memory.pictureWidth = 0
    memory.pictureBytes = 0
    run(&memory)
    line("gpu: controller 0 shows 3840x1080 from a picture of 1280x960: the card scales\n")
    line("gpu: would set a picture of 3840x1080 after the one shown: 16200 KiB at 0x500000 of the aperture\n")
    memory = known()

    // The picture in borders: the timing is the larger one, nothing is
    // scaled. (The frame counter stands still here.)
    begin("the firmware's picture inside borders")
    scaled()
    framePeriod = 0
    set(0x1B42, 0)
    set(0x1B5E, (1280 << 16) | 1280)
    set(0x1B5F, (60 << 16) | 60)
    run(&memory)
    line("gpu: controller 0 viewport 0,0 1280x960 to fill 1280x960, borders left 1280 right 1280 top 60 bottom 60\n")
    line("gpu: controller 0 scaler mode 0 (off), bypass 0, taps 4x4, ratios 0x555555 0xe38e38, line buffer config 1 size 1712, DMIF buffers 2\n")
    line("gpu: controller 0: the pixel clock is not read (the PLL's registers are not known here) and not measured (no frames counted)\n")
    line("gpu: controller 0 clock made for DisplayPort: phase 266640000 of modulo 600000000\n")
    line("gpu: controller 0 shows 3840x1080 with a picture of 1280x960 inside borders: the card adds them\n")
    line("gpu: would set surface address 0xf400500000, pitch 3840, x 0..3840, y 0..1080, control 0x2 as it is\n")
    expect(readout.shows[0] == scanout.Shows.bordered && readout.controllers[0].rate.frames == 0, "bordered, no rate")

    // (b) Controller 3 sends the picture as it is, by HDMI on DIG 0, 62.5
    // times a second.
    begin("a 1280x960 timing: the monitor stretches (b)")
    timing(0x2600, 1280, 960, 1800, 1000, 112, 248, 3, 36)
    picture(0x2600)
    set(0x4A48, 0x1)
    set(0x4A47, 0x30100)
    set(0x4A00, 0x403)
    frameCounter = 0x2600 + 0x1BA6
    framePeriod = 16000000
    run(&memory)
    line("gpu: controller 3 is on (control 0x10001): 1280x960 of 1800x1000, h blank 1640..360 sync 0..112 +, v blank 999..39 sync 0..3 -\n")
    line("gpu: controller 3 viewport 0,0 1280x960 to fill 1280x960, borders left 0 right 0 top 0 bottom 0\n")
    line("gpu: controller 3 scaler mode 0 (off), bypass 0, taps 1x1, ratios 0x0 0x0, line buffer config 0 size 0, DMIF buffers 0\n")
    line("gpu: controller 3 goes out by DIG 0 (front end 0): TMDS (HDMI)\n")
    line("gpu: controller 3 counts 62.500 frames a second: a pixel clock of 112500 kHz (measured; the PLL is not read, its registers are not known here)\n")
    line("gpu: controllers off: 0 1 2 4 5\n")
    line("gpu: controller 3 shows a picture of 1280x960 as it is: the monitor is sent 1280x960\n")
    line("gpu: next stage: another size needs the pixel clock (a PLL), the timing and the link (a TMDS clock) set: not there yet\n")
    noLine("would set")
    noLine("not plausible")
    noLine("clock made for DisplayPort")
    expect(readout.shows[3] == scanout.Shows.as_it_is && readout.shows[0] == scanout.Shows.off && readout.on == 1, "controller 3 as it is")
    // (Its registers are at their offset: the timing's at 0x4180.)
    line("gpu: raw 4180: 00000707 01680668 00700000 ")
    line("gpu: raw 4a00: 00000403 4a09: 00000000 4a47: 00030100 00000001 ")
    noLine(" 1b80:")

    // The same by DisplayPort: the link is what would have to be trained.
    begin("a 1280x960 timing by DisplayPort")
    timing(0x2600, 1280, 960, 1800, 1000, 112, 248, 3, 36)
    picture(0x2600)
    set(0x5448, 0x1)
    set(0x5447, 0x2000)
    set(0x4F00, 0x3)
    set(0x54A3, 1)
    run(&memory)
    line("gpu: controller 3 goes out by DIG 6 (front end 5): DisplayPort, 2 lanes, not trained, stream off\n")
    line("gpu: next stage: another size needs the pixel clock (a PLL), the timing and the link (DisplayPort, to be trained) set: not there yet\n")

    // Every controller off (one of them a block that does not answer): a
    // wrong map when the firmware shows a picture, nothing to say on a
    // card that shows none.
    begin("no controller on, a picture on the screen")
    set(0x1F9C, 0xFFFFFFFF)
    run(&memory)
    line("gpu: controllers off: 0 1 2 3 4 5\n")
    line("gpu: the read-out is not plausible (no controller is on, yet the firmware shows a picture): the register map needs correcting\n")
    noLine("the card scales")
    noLine("the monitor is sent")
    noLine("would set")
    line(" 45f2: 00000000\n")
    expect(!readout.plausible && readout.on == 0 && readout.shows[2] == scanout.Shows.off, "all off, not plausible")

    begin("no controller on, no picture")
    memory.pictureWidth = 0
    run(&memory)
    line("gpu: controllers off: 0 1 2 3 4 5\n")
    noLine("not plausible")
    expect(readout.plausible && readout.on == 0, "all off, nothing wrong")
    memory = known()

    // One controller on and one off beside it, both said.
    begin("two controllers, the second off")
    scaled()
    set(0x1D9C, 0x00010000)
    run(&memory)
    line("gpu: controllers off: 1 2 3 4 5\n")
    expect(readout.on == 1 && !readout.controllers[1].on && readout.controllers[1].control == 0x10000, "controller 1 off")

    // States that do not fit together.
    wrong("totals smaller than what is shown", 0x1B80, 99, scanout.Fault.totals, "gpu: the read-out is not plausible (controller 0 shows 3840x1080 of totals 100x1111")
    wrong("a pitch of nothing", 0x1A06, 0, scanout.Fault.pitch, "gpu: the read-out is not plausible (controller 0: a pitch of 0 for a surface 1280 wide")
    wrong("an address outside the card's memory", 0x1A07, 0, scanout.Fault.address, "gpu: the read-out is not plausible (controller 0: the surface at 0x0 is not in the 256 MiB from 0xf400000000")
    wrong("an address past the aperture", 0x1A04, 0x10000000, scanout.Fault.address, "gpu: the read-out is not plausible (controller 0: the surface at 0xf410000000 is not in the 256 MiB from 0xf400000000")
    wrong("a surface smaller than what is shown", 0x1A0E, 768, scanout.Fault.viewport, "gpu: the read-out is not plausible (controller 0: a viewport 0,0 1280x960 on a surface of 1280x768")
    wrong("a viewport that is not the firmware's picture", 0x1B5D, (1024 << 16) | 768, scanout.Fault.picture, "gpu: the read-out is not plausible (controller 0: the viewport shows 1024x768, pitch 1280, from 0x0 of the memory; the firmware's picture is 1280x960, pitch 1280, at 0x0")
    wrong("a surface elsewhere than the firmware's picture", 0x1A04, 0x100000, scanout.Fault.picture, "from 0x100000 of the memory; the firmware's picture is 1280x960, pitch 1280, at 0x0")
    wrong("rows longer than the firmware's picture has them", 0x1A06, 1344, scanout.Fault.picture, "gpu: the read-out is not plausible (controller 0: the viewport shows 1280x960, pitch 1344, from 0x0 of the memory; the firmware's picture is 1280x960, pitch 1280, at 0x0")
    wrong("the scaler off between two sizes", 0x1B42, 0, scanout.Fault.scaler, "gpu: the read-out is not plausible (controller 0: the scaler is off, yet a picture of 1280x960 is to fill 3840x1080")
    wrong("a memory of no size", 0x809, 0, scanout.Fault.memory, "gpu: the read-out is not plausible (the card's memory at 0x0 to 0xffffff is none")
    wrong("a memory word of all ones", 0x809, 0xFFFFFFFF, scanout.Fault.memory, "gpu: the read-out is not plausible (the card's memory at 0xffff000000 to 0xffffffffff is none")
    wrong("a surface in tiles", 0x1A01, 0x400002, scanout.Fault.tiled, "gpu: the read-out is not plausible (controller 0: a surface in tiles (array mode 4)")
    wrong("16 bits a pixel", 0x1A01, 1, scanout.Fault.depth, "gpu: the read-out is not plausible (controller 0: a surface of depth 1")
    wrong("the VGA's picture", 0xCC, 1, scanout.Fault.vga, "gpu: the read-out is not plausible (controller 0 is in VGA mode")
    wrong("the surface off", 0x1A00, 0, scanout.Fault.no_surface, "gpu: the read-out is not plausible (controller 0 is on with its surface off")
    wrong("a surface of no size", 0x1A0D, 0, scanout.Fault.extent, "gpu: the read-out is not plausible (controller 0: a surface of no size, x 0..0, y 0..960")
    wrong("no viewport", 0x1B5D, 0, scanout.Fault.viewport, "gpu: the read-out is not plausible (controller 0: a viewport 0,0 0x0 on a surface of 1280x960")
    wrong("a viewport past the surface", 0x1B5C, 640 << 16, scanout.Fault.viewport, "gpu: the read-out is not plausible (controller 0: a viewport 640,0 1280x960 on a surface of 1280x960")

    // Counters that begin elsewhere than with the sync: the size shown is
    // still what lies between the blankings, around the total.
    begin("blankings that go around the total")
    scaled()
    framePeriod = 0
    set(0x1B81, (260 << 16) | 100)
    set(0x1B8D, (40 << 16) | 9)
    run(&memory)
    line("gpu: controller 0 is on (control 0x10001): 3840x1080 of 4000x1111, h blank 100..260 sync 0..32 +, v blank 9..40 sync 0..10 -\n")
    line("gpu: controller 0 shows 3840x1080 from a picture of 1280x960: the card scales\n")

    // The picture's size shown from two rows further down a taller
    // surface is not the picture.
    begin("a viewport that begins elsewhere than the firmware's picture")
    scaled()
    framePeriod = 0
    set(0x1A0E, 1024)
    set(0x1B5C, 2)
    run(&memory)
    line("gpu: the read-out is not plausible (controller 0: the viewport shows 1280x960, pitch 1280, from 0x2800 of the memory; the firmware's picture is 1280x960, pitch 1280, at 0x0): the register map needs correcting\n")
    noLine("the card scales")
    expect(readout.faults[0] == scanout.Fault.picture, "the viewport's start")

    // A counter that is no frame counter (it runs away) gives no rate.
    begin("a counter that runs away")
    scaled()
    framePeriod = 40
    run(&memory)
    line("not measured (no frames counted)")
    line("gpu: controller 0 shows 3840x1080 from a picture of 1280x960: the card scales\n")

    // The frame counter going around its 24 bits while it is counted: the
    // same frames.
    begin("a frame counter that goes around")
    scaled()
    frameStart = 0xFFFFFC
    run(&memory)
    line("gpu: controller 0 counts 60.000 frames a second: a pixel clock of 266642 kHz (measured; the PLL is not read, its registers are not known here)\n")
    expect(readout.controllers[0].rate.frames == 8, "eight frames around the counter's end")

    // Bits beside the fields that are read (other fields of the same
    // registers, as dce_11_2_sh_mask.h has them) change nothing of what is
    // decoded: the surface address's DFQ bit, the surface control's banks,
    // tile split and pipe configuration, the blank state without the
    // blanking, the interlace word's next field, the composite sync, the
    // scaler's prescaler bit, the line buffer's partitions, the VGA word's
    // timing select, the clock word's source, the link's status.
    begin("flags beside the fields")
    scaled()
    set(0x1A04, 0x00000001)
    set(0x1A01, 0x0C042846)
    set(0x1A00, 0x3)
    set(0x1B9D, 0x00010001)
    set(0x1B9E, 0x00030000)
    set(0x1B83, 0x00010000)
    set(0x1B42, 0x11)
    set(0x1AC1, 0x001306B0)
    set(0xCC, 0x00010100)
    set(0x140, 0x31)
    set(0x4BA0, 0x110)
    run(&memory)
    line("gpu: controller 0 is on (control 0x10001): 3840x1080 of 4000x1111, h blank 3952..112 sync 0..32 +, v blank 1105..25 sync 0..10 -\n")
    line("gpu: controller 0 surface on at 0xf400000000 (0x0 of the card's memory), pitch 1280, x 0..1280, y 0..960, control 0xc042846 (depth 2, format 0, array mode 0)\n")
    line("gpu: controller 0 scaler mode 1 (on, prescaler on), bypass 0, taps 4x4, ratios 0x555555 0xe38e38 (as the sizes give), line buffer config 1 size 1712, DMIF buffers 2\n")
    line("gpu: controller 0 goes out by DIG 1 (front end 1): DisplayPort, 4 lanes, trained, stream on\n")
    line("gpu: controller 0 clock made for DisplayPort: phase 266640000 of modulo 600000000 (of a reference of 600004 kHz, by the measured clock)\n")
    line("gpu: controller 0 shows 3840x1080 from a picture of 1280x960: the card scales\n")
    line("gpu: would set surface address 0xf400500000, pitch 3840, x 0..3840, y 0..1080, control 0xc042846 as it is\n")
    noLine("not plausible")
    noLine("blanked")
    noLine("interlaced")
    noLine("in VGA mode")
    expect(readout.controllers[0].address == 0xF400000000 && readout.controllers[0].dto && readout.controllers[0].lineBuffer == 1 && readout.controllers[0].scalerMode == 1 && readout.controllers[0].prescaler, "flags beside the fields")

    // Borders that are not the same on both sides: left and top are the
    // upper halves of their words.
    begin("the picture inside uneven borders")
    scaled()
    framePeriod = 0
    set(0x1B42, 0)
    set(0x1B5E, (1200 << 16) | 1360)
    set(0x1B5F, (50 << 16) | 70)
    run(&memory)
    line("gpu: controller 0 viewport 0,0 1280x960 to fill 1280x960, borders left 1200 right 1360 top 50 bottom 70\n")
    line("gpu: controller 0 shows 3840x1080 with a picture of 1280x960 inside borders: the card adds them\n")

    // A surface much taller than the picture (two of 1024 rows): the new
    // one goes after all of it, not into its lower half.
    begin("a surface that ends long after the picture")
    scaled()
    framePeriod = 0
    set(0x1A0E, 2048)
    run(&memory)
    line("gpu: controller 0 shows 3840x1080 from a picture of 1280x960: the card scales\n")
    line("gpu: would set a picture of 3840x1080 after the firmware's: 16200 KiB at 0xa00000 of the aperture\n")
    line("gpu: would set surface address 0xf400a00000, pitch 3840, x 0..3840, y 0..1080, control 0x2 as it is\n")

    // Every controller at its own numbers: the timing, the surface and the
    // frame counter at its offset, its buffers and its clock words in the
    // tables that are not at the offsets; and its VGA word.
    var n: usize = 0
    while n < 6 {
        begin("a controller at its own numbers")
        timing(OFFSETS[n], 1280, 960, 1800, 1000, 112, 248, 3, 36)
        picture(OFFSETS[n])
        set(0x321 + n, 0x14)
        set(0x140 + n * 4, 0x10)
        set(0x141 + n * 4, 108000000)
        set(0x142 + n * 4, 600000000)
        frameCounter = OFFSETS[n] + 0x1BA6
        framePeriod = 16000000
        run(&memory)
        const one = &readout.controllers[n]
        expect(readout.on == 1 && readout.plausible && readout.shows[n] == scanout.Shows.as_it_is, "a controller at its own numbers: as it is")
        expect(one.*.width == 1280 && one.*.height == 960 && one.*.hTotal == 1800 && one.*.vTotal == 1000 && one.*.pitch == 1280 && one.*.address == 0xF400000000, "a controller at its own numbers: decoded")
        expect(one.*.buffers == 4 && one.*.dto && one.*.dtoPhase == 108000000 && one.*.dtoModulo == 600000000, "a controller at its own numbers: its buffers and clock words")
        expect(one.*.rate.frames == 8 && one.*.rate.millihertz == 62500 && one.*.rate.kilohertz == 112500, "a controller at its own numbers: its frames")
        line(" as it is: the monitor is sent 1280x960\n")

        begin("a controller's VGA word")
        timing(OFFSETS[n], 1280, 960, 1800, 1000, 112, 248, 3, 36)
        picture(OFFSETS[n])
        set(VGA[n], 1)
        run(&memory)
        expect(!readout.plausible && readout.faults[n] == scanout.Fault.vga && readout.shows[n] == scanout.Shows.not_plausible, "a controller's VGA word")
        line(" is in VGA mode, its surface is not what it shows): the register map needs correcting\n")
        noLine("the monitor is sent")
        n += 1
    }

    // A timing that is neither the picture's nor a wide monitor's (the
    // firmware's largest, 1280x1024, the picture made taller by the card):
    // said as it is, and the line on the next stage says what another
    // size would need.
    begin("a 1280x1024 timing the picture is scaled to")
    timing(0, 1280, 1024, 1688, 1066, 112, 248, 3, 38)
    picture(0)
    set(0x1B42, 1)
    set(0x1B43, 0x303)
    run(&memory)
    line("gpu: controller 0 is on (control 0x10001): 1280x1024 of 1688x1066, h blank 1640..360 sync 0..112 +, v blank 1065..41 sync 0..3 -\n")
    line("gpu: controller 0 shows 1280x1024 from a picture of 1280x960: the card scales\n")
    line("gpu: next stage: a picture of 1280x1024 on the running controller (surface, viewport, scaler off, line buffer; clock, timing and link only for another size)\n")
    line("gpu: would set a picture of 1280x1024 after the firmware's: 5120 KiB at 0x500000 of the aperture\n")
    line("gpu: would set surface address 0xf400500000, pitch 1280, x 0..1280, y 0..1024, control 0x2 as it is\n")

    // Two controllers on the firmware's picture (the second sends it as it
    // is): each is concluded for.
    begin("two controllers on the same picture")
    scaled()
    framePeriod = 0
    timing(0x200, 1280, 960, 1800, 1000, 112, 248, 3, 36)
    picture(0x200)
    run(&memory)
    line("gpu: controllers off: 2 3 4 5\n")
    line("gpu: controller 0 shows 3840x1080 from a picture of 1280x960: the card scales\n")
    line("gpu: controller 1 shows a picture of 1280x960 as it is: the monitor is sent 1280x960\n")
    line(" 1d80: 00000707 ")
    noLine(" 1f80:")
    expect(readout.on == 2 && readout.plausible && readout.shows[0] == scanout.Shows.scaled && readout.shows[1] == scanout.Shows.as_it_is, "two controllers on")

    // One of two whose numbers do not fit: nothing is concluded for either.
    begin("two controllers, one that does not fit")
    scaled()
    framePeriod = 0
    timing(0x200, 1280, 960, 1800, 1000, 112, 248, 3, 36)
    run(&memory)
    line("gpu: the read-out is not plausible (controller 1 is on with its surface off): the register map needs correcting\n")
    noLine("the card scales")
    noLine("would set")
    expect(readout.on == 2 && !readout.plausible && readout.faults[0] == scanout.Fault.none && readout.faults[1] == scanout.Fault.no_surface, "one of two does not fit")

    expect(!forbidden, "no register read whose reading changes something")
    if failed != 0 { return failed }
    return 13
}
