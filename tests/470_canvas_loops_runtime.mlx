// std.ui.canvas's and std.ui.text's pixel loops give the pixels the plain
// loops they replace give, bit for bit: a colour over a pixel for every
// coverage, alpha and channel (and words that are no premultiplied colour
// at all); runs of pixels stored at every length up to where blocks take
// over; clear, fillRect, fillRoundedRect, strokeRoundedRect, drawImageRect
// and a row of coverage at chance (sizes 0 and 1, odd widths, boxes off
// the canvas on each side, every alpha, both byte orders, rows wider than
// the canvas, an opacity), each against a loop that works a pixel out and
// blends it; text against a loop over its glyphs' coverage, and text a
// character to a cell against each character drawn alone and cut to its
// cell; std.truetype's own drawing of a run (a title bar's text) against
// its plain loop. Nothing is written outside the canvas's rows.
// Exits 13.
const std = @import("std")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const tt = @import("std.truetype")
const png = @import("std.png")

const Canvas = canvas_module.Canvas

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

// ---------------------------------------------------------------------------
// Chance

var seed: u64 = 88172645463325252 // (per run)

fn chance() -> u64 {
    seed = seed ^ (seed << 13)
    seed = seed ^ (seed >> 7)
    seed = seed ^ (seed << 17)
    return seed
}

fn below(limit: usize) -> usize { return @intCast(usize, chance() % @intCast(u64, limit)) }

// From `low` to `high`, both among them.
fn between(low: i32, high: i32) -> i32 { return low + @intCast(i32, below(@intCast(usize, high - low + 1))) }

fn word() -> u32 { return @intCast(u32, chance() >> 32) }

// A premultiplied colour: mostly of a middling alpha, often none or all of
// it, sometimes nothing at all.
fn colour() -> u32 {
    const pick = below(8)
    if pick == 0 { return 0 }
    var alpha: u32 = @intCast(u32, below(256))
    if pick == 1 || pick == 2 { alpha = 255 }
    if pick == 3 { alpha = @intCast(u32, below(3)) }
    if pick == 4 { alpha = 253 + @intCast(u32, below(3)) }
    return canvas_module.color(alpha, @intCast(u32, below(256)), @intCast(u32, below(256)), @intCast(u32, below(256)))
}

// ---------------------------------------------------------------------------
// The plain loops (std.ui.canvas as it was: a pixel at a time)

fn plainDiv255(value: u32) -> u32 { return ((value + 128) * 257) >> 16 }

fn least(a: u32, b: u32) -> u32 { return if a < b { a } else { b } }

fn plainOver(under: u32, color: u32, coverage: u32) -> u32 {
    if coverage == 0 { return under }
    var alpha = color >> 24
    var red = (color >> 16) & 255
    var green = (color >> 8) & 255
    var blue = color & 255
    if coverage < 255 {
        alpha = plainDiv255(alpha * coverage)
        red = plainDiv255(red * coverage)
        green = plainDiv255(green * coverage)
        blue = plainDiv255(blue * coverage)
    }
    if alpha == 255 { return (alpha << 24) | (red << 16) | (green << 8) | blue }
    const keep = 255 - alpha
    const a = alpha + plainDiv255((under >> 24) * keep)
    const r = red + plainDiv255(((under >> 16) & 255) * keep)
    const g = green + plainDiv255(((under >> 8) & 255) * keep)
    const b = blue + plainDiv255((under & 255) * keep)
    return (least(a, 255) << 24) | (least(r, 255) << 16) | (least(g, 255) << 8) | least(b, 255)
}

fn swapped(color: u32) -> u32 {
    return color & 4278255360 | (color & 16711680) >> 16 | (color & 255) << 16
}

fn plainBlend(canvas: *Canvas, x: i32, y: i32, color: u32, coverage: u32) -> void {
    if x < 0 || y < 0 || x >= @intCast(i32, canvas.*.width) || y >= @intCast(i32, canvas.*.height) { return }
    const at = @intCast(usize, y) * canvas.*.stride + @intCast(usize, x)
    if canvas.*.swapRedBlue {
        canvas.*.pixels[at] = swapped(plainOver(swapped(canvas.*.pixels[at]), color, coverage))
        return
    }
    canvas.*.pixels[at] = plainOver(canvas.*.pixels[at], color, coverage)
}

fn plainClear(canvas: *Canvas, color: u32) -> void {
    const stored = if canvas.*.swapRedBlue { swapped(color) } else { color }
    var row: usize = 0
    while row < canvas.*.height {
        var column: usize = 0
        while column < canvas.*.width {
            canvas.*.pixels[row * canvas.*.stride + column] = stored
            column += 1
        }
        row += 1
    }
}

fn plainFillRect(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, given: u32) -> void {
    const color = canvas_module.faded(canvas, given)
    var row: i32 = 0
    while row < height {
        var column: i32 = 0
        while column < width {
            plainBlend(canvas, x + column, y + row, color, 255)
            column += 1
        }
        row += 1
    }
}

fn plainFillRounded(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, radius: i32, given: u32) -> void {
    const color = canvas_module.faded(canvas, given)
    var row: i32 = 0
    while row < height {
        var column: i32 = 0
        while column < width {
            const coverage = ui.roundedCoverage(column, row, width, height, radius)
            if coverage > 0 { plainBlend(canvas, x + column, y + row, color, coverage) }
            column += 1
        }
        row += 1
    }
}

fn plainStroke(canvas: *Canvas, x: i32, y: i32, width: i32, height: i32, radius: i32, thickness: i32, given: u32) -> void {
    const color = canvas_module.faded(canvas, given)
    var row: i32 = 0
    while row < height {
        var column: i32 = 0
        while column < width {
            const outer = ui.roundedCoverage(column, row, width, height, radius)
            const inner = ui.roundedCoverage(column - thickness, row - thickness, width - thickness * 2, height - thickness * 2, if radius > thickness { radius - thickness } else { 0 })
            if outer > inner { plainBlend(canvas, x + column, y + row, color, outer - inner) }
            column += 1
        }
        row += 1
    }
}

fn clampTo(value: i32, limit: i32) -> i32 {
    if value < 0 { return 0 }
    if value >= limit { return limit - 1 }
    return value
}

fn plainSample(image: *const png.Image, sx: i32, sy: i32) -> u32 {
    const width = @intCast(i32, image.*.width)
    const height = @intCast(i32, image.*.height)
    const x0 = clampTo(if sx < 0 { 0 } else { sx / 256 }, width)
    const y0 = clampTo(if sy < 0 { 0 } else { sy / 256 }, height)
    const x1 = clampTo(x0 + 1, width)
    const y1 = clampTo(y0 + 1, height)
    const fx = @intCast(u32, if sx < 0 { 0 } else { sx % 256 })
    const fy = @intCast(u32, if sy < 0 { 0 } else { sy % 256 })
    const a = image.*.pixels[@intCast(usize, y0 * width + x0)]
    const b = image.*.pixels[@intCast(usize, y0 * width + x1)]
    const c = image.*.pixels[@intCast(usize, y1 * width + x0)]
    const d = image.*.pixels[@intCast(usize, y1 * width + x1)]
    var result: u32 = 0
    var shift: u32 = 0
    while shift < 32 {
        const top = ((a >> shift) & 255) * (256 - fx) + ((b >> shift) & 255) * fx
        const bottom = ((c >> shift) & 255) * (256 - fx) + ((d >> shift) & 255) * fx
        const value = (top * (256 - fy) + bottom * fy) / 65536
        result = result | (least(value, 255) << shift)
        shift += 8
    }
    return result
}

fn plainImage(canvas: *Canvas, image: *const png.Image, x: i32, y: i32, width: i32, height: i32, given: u32) -> void {
    const opacity = given * (if canvas.*.opacity > 255 { 255 } else { canvas.*.opacity }) / 255
    if width <= 0 || height <= 0 || image.*.width == 0 { return }
    const source_width = @intCast(i32, image.*.width)
    const source_height = @intCast(i32, image.*.height)
    var row: i32 = 0
    while row < height {
        var column: i32 = 0
        while column < width {
            const sx = ((column * 2 + 1) * source_width * 128) / width - 128
            const sy = ((row * 2 + 1) * source_height * 128) / height - 128
            plainBlend(canvas, x + column, y + row, plainSample(image, sx, sy), opacity)
            column += 1
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// Two canvases of the same pixels, rows of others above, below and beside

const MAX_WIDTH: usize = 96
const MAX_HEIGHT: usize = 40
const GUARD: usize = 3
const ROOM: usize = (MAX_WIDTH + 8) * (MAX_HEIGHT + 2 * GUARD)

var first: [ROOM]u32 = undefined // (per run)
var second: [ROOM]u32 = undefined // (per run)

// Both canvases anew: a size and a stride at chance (the sizes 0 and 1 and
// odd ones among them), the same pixels in both: of a few colours side by
// side or all different, as a picture has them.
fn pair(one: *Canvas, other: *Canvas) -> void {
    var width = below(MAX_WIDTH + 1)
    var height = below(MAX_HEIGHT + 1)
    const small = below(10)
    if small == 0 { width = below(2) }
    if small == 1 { height = below(2) }
    const stride = width + below(9)
    const flat = below(3)
    var flat_pixel = colour()
    var index: usize = 0
    while index < ROOM {
        if flat != 0 && below(9) == 0 { flat_pixel = colour() }
        const pixel = if flat == 0 { word() } else { flat_pixel }
        first[index] = pixel
        second[index] = pixel
        index += 1
    }
    const swap = below(4) == 0
    const opacity: u32 = if below(5) == 0 { @intCast(u32, below(256)) } else { 255 }
    // (The canvases start GUARD rows into their memory.)
    var one_pixels: [*]u32 = undefined
    var other_pixels: [*]u32 = undefined
    unsafe {
        one_pixels = @ptrFromInt([*]u32, @intFromPtr(&first) + GUARD * (MAX_WIDTH + 8) * 4)
        other_pixels = @ptrFromInt([*]u32, @intFromPtr(&second) + GUARD * (MAX_WIDTH + 8) * 4)
    }
    one.* = Canvas.{ .pixels = one_pixels, .width = width, .height = height, .stride = stride, .swapRedBlue = swap, .device = 0, .opacity = opacity }
    other.* = Canvas.{ .pixels = other_pixels, .width = width, .height = height, .stride = stride, .swapRedBlue = swap, .device = 0, .opacity = opacity }
}

fn same() -> bool {
    var index: usize = 0
    while index < ROOM {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

// A box that lies on the canvas, across an edge of it, or off it.
fn boxStart(extent: usize) -> i32 { return between(-24, @intCast(i32, extent) + 8) }
fn boxSize() -> i32 {
    const pick = below(8)
    if pick == 0 { return between(-2, 1) }
    if pick == 1 { return between(60, 140) }
    return between(1, 48)
}

// ---------------------------------------------------------------------------

fn overEverywhere() -> bool {
    // One channel beside its alpha, for every alpha, coverage and (every
    // third and the last) value of what is under and of the channel.
    var coverage: u32 = 0
    while coverage < 256 {
        var alpha: u32 = 0
        while alpha < 256 {
            var value: u32 = 0
            while value < 256 {
                const color = (alpha << 24) | (least(value, alpha) << 16) | (value << 8) | (alpha * value / 255)
                const under = ((255 - value) << 24) | (value << 16) | ((alpha ^ value) << 8) | (255 - alpha)
                if canvas_module.over(under, color, coverage) != plainOver(under, color, coverage) { return false }
                value += if value < 252 { 3 } else { 1 }
            }
            alpha += 1
        }
        coverage += 1
    }
    // Any words at all (a channel above its alpha: sums held at 255).
    var round: usize = 0
    while round < 400000 {
        const under = word()
        const color = word()
        const cover = @intCast(u32, below(256))
        if canvas_module.over(under, color, cover) != plainOver(under, color, cover) { return false }
        if canvas_module.over(under, color, 255) != plainOver(under, color, 255) { return false }
        round += 1
    }
    return true
}

var run: [5000]u32 = undefined // (per run)

fn storedRuns() -> bool {
    const pixels: [*]u32 = &run
    var start: usize = 0
    while start < 3 {
        var count: usize = 0
        while count < 4700 {
            var index: usize = 0
            while index < 5000 {
                run[index] = 0x11223344
                index += 1
            }
            const stored = word()
            canvas_module.storePixels(@intFromPtr(pixels) + (8 + start) * 4, count, stored)
            index = 0
            while index < 5000 {
                const inside = index >= 8 + start && index < 8 + start + count
                if run[index] != (if inside { stored } else { 0x11223344 }) { return false }
                index += 1
            }
            // (Every length to 300, where words hand over to blocks; then
            // around the blocks' and the pages' ends.)
            count += if count < 300 || count % 128 >= 125 || count % 128 < 3 { 1 } else { 61 }
        }
        start += 1
    }
    return true
}

fn shapes() -> u8 {
    var one: Canvas = undefined
    var other: Canvas = undefined
    var round: usize = 0
    while round < 6000 {
        pair(&one, &other)
        const color = colour()
        const x = boxStart(one.width)
        const y = boxStart(one.height)
        const width = boxSize()
        const height = boxSize()
        const kind = round % 5
        if kind == 0 {
            canvas_module.clear(&one, color)
            plainClear(&other, color)
        } else if kind == 1 {
            canvas_module.fillRect(&one, x, y, width, height, color)
            plainFillRect(&other, x, y, width, height, color)
        } else if kind == 2 {
            const radius = if below(6) == 0 { between(-2, 70) } else { between(0, 12) }
            canvas_module.fillRoundedRect(&one, x, y, width, height, radius, color)
            plainFillRounded(&other, x, y, width, height, radius, color)
        } else if kind == 3 {
            const radius = if below(6) == 0 { between(-2, 70) } else { between(0, 12) }
            const thickness = if below(6) == 0 { between(-1, 30) } else { between(1, 4) }
            canvas_module.strokeRoundedRect(&one, x, y, width, height, radius, thickness, color)
            plainStroke(&other, x, y, width, height, radius, thickness, color)
        } else {
            const cover = @intCast(u32, below(256))
            const px = between(-2, @intCast(i32, one.width) + 2)
            const py = between(-2, @intCast(i32, one.height) + 2)
            canvas_module.blend(&one, px, py, color, cover)
            plainBlend(&other, px, py, color, cover)
        }
        if !same() { return @intCast(u8, 20 + kind) }
        round += 1
    }
    return 0
}

var picture: [40 * 40]u32 = undefined // (per run)

fn images() -> bool {
    var one: Canvas = undefined
    var other: Canvas = undefined
    var image: png.Image = undefined
    image.pixels = &picture
    var round: usize = 0
    while round < 1500 {
        pair(&one, &other)
        image.width = 1 + below(40)
        image.height = 1 + below(40)
        // A picture with parts of nothing, parts of one colour and edges.
        const kind = below(3)
        var index: usize = 0
        var pixel = colour()
        while index < image.width * image.height {
            if kind == 0 || below(7) == 0 { pixel = colour() }
            if kind == 2 && below(4) == 0 { pixel = 0 }
            picture[index] = pixel
            index += 1
        }
        const x = boxStart(one.width)
        const y = boxStart(one.height)
        const width = boxSize()
        const height = boxSize()
        // (As it is, all but as it is, or faded by any amount.)
        const fade = below(6)
        const given: u32 = if fade == 0 { @intCast(u32, below(256)) } else if fade == 1 { 254 } else { 255 }
        canvas_module.drawImageRect(&one, &image, x, y, width, height, given)
        plainImage(&other, &image, x, y, width, height, given)
        if !same() { return false }
        round += 1
    }
    return true
}

var covers: [MAX_WIDTH + 8]u8 = undefined // (per run)

fn coverage() -> bool {
    var one: Canvas = undefined
    var other: Canvas = undefined
    var mixes: canvas_module.Mixes = undefined
    var round: usize = 0
    while round < 4000 {
        pair(&one, &other)
        if one.width > 0 && one.height > 0 {
            const color = colour()
            const from = below(one.width)
            const count = below(one.width - from + 1)
            // Nothing covered for stretches, all of it, edges between.
            const kind = below(4)
            var index: usize = 0
            var cover: u8 = 0
            while index < count {
                if kind == 0 || below(5) == 0 { cover = @intCast(u8, below(256)) }
                if kind == 1 && below(3) != 0 { cover = 0 }
                if kind == 2 && below(3) != 0 { cover = 255 }
                covers[index] = cover
                index += 1
            }
            // Several rows with what was mixed kept between them, as text
            // is drawn.
            canvas_module.beginMixes(&mixes)
            const cover_bytes: [*]const u8 = &covers
            var row: usize = 0
            while row < one.height {
                canvas_module.coverSpan(&one, row * one.stride + from, cover_bytes, count, color, &mixes)
                index = 0
                while index < count {
                    if covers[index] > 0 { plainBlend(&other, @intCast(i32, from + index), @intCast(i32, row), color, @intCast(u32, covers[index])) }
                    index += 1
                }
                row += 1 + below(3)
            }
            if !same() { return false }
        }
        round += 1
    }
    return true
}

fn atlasOf(text: *text_module.Text) -> *tt.Atlas {
    unsafe { return @ptrCast(*tt.Atlas, &text.*.atlas) }
}

fn runOf(text: *text_module.Text) -> *tt.Run {
    unsafe { return @ptrCast(*tt.Run, &text.*.run) }
}

// Text as it was drawn: the run's coverage at each of its pixels, blended.
fn plainText(canvas: *Canvas, text: *text_module.Text, string: []const u8, x: i32, y: i32, given: u32, limit: i32) -> void {
    const color = canvas_module.faded(canvas, given)
    const run_ = runOf(text)
    tt.layout(atlasOf(text), string, run_)
    const baseline = y + text.*.ascent
    var row = run_.*.top
    while row < run_.*.bottom {
        var column = run_.*.left
        while column < run_.*.right && (limit <= 0 || column < limit) {
            const cover = tt.runCoverage(atlasOf(text), run_, column, row)
            if cover > 0 { plainBlend(canvas, x + column, baseline + row, color, cover) }
            column += 1
        }
        row += 1
    }
}

// Text a character to a cell: each character drawn alone at its cell's
// left, and of it what lies in the cell.
fn plainCells(canvas: *Canvas, text: *text_module.Text, string: []const u8, x: i32, y: i32, given: u32, pitch: i32, top: i32, height: i32) -> void {
    const color = canvas_module.faded(canvas, given)
    const run_ = runOf(text)
    const baseline = y + text.*.ascent
    var cell: i32 = 0
    var at: usize = 0
    while at < string.length {
        var length: usize = 1
        if string[at] >= 240 { length = 4 } else if string[at] >= 224 { length = 3 } else if string[at] >= 192 { length = 2 }
        if at + length > string.length { length = string.length - at }
        tt.layout(atlasOf(text), string[at..at + length], run_)
        var row = run_.*.top
        while row < run_.*.bottom {
            var column = run_.*.left
            while column < run_.*.right {
                const inside = column >= 0 && column < pitch && baseline + row >= top && baseline + row < top + height
                const cover = if inside { tt.runCoverage(atlasOf(text), run_, column, row) } else { 0 }
                if cover > 0 { plainBlend(canvas, x + cell * pitch + column, baseline + row, color, cover) }
                column += 1
            }
            row += 1
        }
        cell += 1
        at += length
    }
}

var row_cover: [300]u8 = undefined // (per run)

// A row of a run's coverage (what drawing text goes by) against the run's
// coverage pixel by pixel, for any stretch of the row; nothing written
// before or after the stretch.
fn rowCoverage(text: *text_module.Text) -> bool {
    const into: [*]u8 = &row_cover
    var round: usize = 0
    while round < 400 {
        const string = if round % 2 == 0 { "AVAToj fi {W}" } else { "gy|_^" }
        const run_ = runOf(text)
        if round % 4 < 2 { tt.layout(atlasOf(text), string, run_) } else { tt.layoutCells(atlasOf(text), string.pointer, string.length, run_, between(2, 12), between(-14, -2), between(-6, 6)) }
        const from = between(run_.*.left - 6, run_.*.right + 3)
        const count = below(200)
        const y = between(run_.*.top - 2, run_.*.bottom + 1)
        var index: usize = 0
        while index < 300 {
            row_cover[index] = 77
            index += 1
        }
        tt.runRowCoverage(atlasOf(text), run_, y, from, count, into + 50)
        index = 0
        while index < 300 {
            const wanted = if index >= 50 && index < 50 + count { tt.runCoverage(atlasOf(text), run_, from + @intCast(i32, index - 50), y) } else { 77 }
            if @intCast(u32, row_cover[index]) != wanted { return false }
            index += 1
        }
        round += 1
    }
    return true
}

// std.truetype's own drawing of a run (a compositor's title bars), as it
// was: the run's coverage looked up for each pixel of its box.
fn plainRun(atlas: *const tt.Atlas, run_: *const tt.Run, pixels: [*]u32, width: usize, height: usize, stride: usize, origin_x: i32, origin_y: i32, color_: u32, flags: u32) -> void {
    var y = run_.*.top
    while y < run_.*.bottom {
        const target_y = origin_y + y
        if target_y >= 0 && target_y < @intCast(i32, height) {
            var x = run_.*.left
            while x < run_.*.right {
                const target_x = origin_x + x
                if target_x >= 0 && target_x < @intCast(i32, width) {
                    const cover = tt.runCoverage(atlas, run_, x, y)
                    if cover != 0 {
                        const at = @intCast(usize, target_y) * stride + @intCast(usize, target_x)
                        if flags & tt.FLAG_SWAP_RED_BLUE != 0 {
                            pixels[at] = swapped(tt.blendCoverage(swapped(pixels[at]), color_, cover))
                        } else {
                            pixels[at] = tt.blendCoverage(pixels[at], color_, cover)
                        }
                    }
                }
                x += 1
            }
        }
        y += 1
    }
}

fn runs(text: *text_module.Text) -> bool {
    var one: Canvas = undefined
    var other: Canvas = undefined
    var round: usize = 0
    while round < 500 {
        pair(&one, &other)
        const string = if round % 3 == 0 { "Mlx Terminal  60 fps" } else if round % 3 == 1 { "AVA Wj" } else { "" }
        tt.layout(atlasOf(text), string, runOf(text))
        const x = between(-40, @intCast(i32, one.width))
        const y = between(-6, @intCast(i32, one.height) + 6)
        const color = word()
        const flags: u32 = if below(3) == 0 { tt.FLAG_SWAP_RED_BLUE } else { 0 }
        tt.drawRun(atlasOf(text), runOf(text), one.pixels, one.width, one.height, one.stride, x, y, color, flags)
        plainRun(atlasOf(text), runOf(text), other.pixels, other.width, other.height, other.stride, x, y, color, flags)
        if !same() { return false }
        round += 1
    }
    return true
}

fn texts(text: *text_module.Text, mono: bool) -> bool {
    var one: Canvas = undefined
    var other: Canvas = undefined
    const letters = "AVWTyjgq|_{}@#MWfi.,;'^~ \xc3\x84\xc3\x89\xc3\xa5\xc3\x9f\xe2\x82\xac\xe2\x94\x82\xe2\x94\x80"
    var line: [64]u8 = undefined
    var round: usize = 0
    while round < 900 {
        pair(&one, &other)
        // A line of characters at chance (whole UTF-8 sequences).
        var length: usize = 0
        const wanted = below(14)
        var count: usize = 0
        while count < wanted && length < 56 {
            var from = below(letters.length)
            while letters[from] & 192 == 128 { from -= 1 }
            var size: usize = 1
            if letters[from] >= 224 { size = 3 } else if letters[from] >= 192 { size = 2 }
            var k: usize = 0
            while k < size {
                line[length] = letters[from + k]
                length += 1
                k += 1
            }
            count += 1
        }
        const bytes: [*]const u8 = &line
        const string = bytes[0..length]
        const color = colour()
        const x = between(-30, @intCast(i32, one.width))
        const y = between(-20, @intCast(i32, one.height))
        if mono && round % 2 == 0 {
            const pitch = between(1, 14)
            const top = y + between(-3, 6)
            const height = between(0, 22)
            text_module.drawCells(&one, text, string, x, y, color, pitch, top, height)
            plainCells(&other, text, string, x, y, color, pitch, top, height)
        } else {
            const limit = if below(3) == 0 { between(1, 60) } else { 0 }
            text_module.drawText(&one, text, string, x, y, color, limit)
            plainText(&other, text, string, x, y, color, limit)
        }
        if !same() { return false }
        round += 1
    }
    return true
}

pub fn main() -> u8 {
    if !overEverywhere() {
        say("FAIL a colour over a pixel is not what the plain sums give\n")
        return 1
    }
    if !storedRuns() {
        say("FAIL a run of pixels is not stored as a loop stores it\n")
        return 2
    }
    const shape = shapes()
    if shape != 0 {
        say("FAIL a clear (20), fill (21), rounded fill (22), outline (23) or blend (24) is not the plain loop's\n")
        return shape
    }
    if !images() {
        say("FAIL a scaled image is not the plain loop's\n")
        return 3
    }
    if !coverage() {
        say("FAIL a row of coverage is not the plain loop's\n")
        return 4
    }
    const allocator = std.heap.allocator()
    var text: text_module.Text = undefined
    var mono: text_module.Text = undefined
    if text_module.loadText(&text, 15, allocator) {
        if !rowCoverage(&text) {
            say("FAIL a row of a run's coverage is not its coverage pixel by pixel, or reaches past its stretch\n")
            return 7
        }
        if !texts(&text, false) {
            say("FAIL text is not the plain loop's\n")
            return 5
        }
        if !runs(&text) {
            say("FAIL std.truetype's drawing of a run is not the plain loop's\n")
            return 8
        }
    } else {
        say("(no font found: text is not compared)\n")
    }
    if text_module.loadMonoText(&mono, 13, allocator) {
        if !texts(&mono, true) {
            say("FAIL text a character to a cell is not each character drawn alone and cut to its cell\n")
            return 6
        }
    }
    return 13
}
