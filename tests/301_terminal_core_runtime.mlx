// std.terminal, the screen a terminal emulator keeps: printing with
// wrapping, UTF-8 and a wide character, the C0 controls, cursor movement,
// erasing, inserting and deleting, a scrolling region, SGR colours and
// attributes, the alternate screen, the history and the view into it, a
// resize, the title and the reports a program asks for. Exits 13 on
// success, else 18 plus the number of the first check that failed.
const std = @import("std")
const terminal = @import("std.terminal")

fn cell(screen: *terminal.Screen, row: usize, column: usize) -> *terminal.Cell {
    return terminal.visibleCell(screen, row, column)
}

fn text(screen: *terminal.Screen, row: usize, from: usize, expected: []const u8) -> bool {
    var index: usize = 0
    for byte in expected {
        if cell(screen, row, from + index).*.codepoint != @intCast(u32, byte) { return false }
        index += 1
    }
    return true
}

fn esc(screen: *terminal.Screen, rest: []const u8) -> void {
    terminal.feedByte(screen, 27)
    terminal.feed(screen, rest)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var screen: terminal.Screen = undefined
    if !terminal.init(&screen, allocator, 10, 4, 20) { return 19 }
    // 2: plain text, the cursor after it.
    terminal.feed(&screen, "hello")
    if !text(&screen, 0, 0, "hello") || screen.cursorColumn != 5 || screen.cursorRow != 0 { return 20 }
    // 3: wrapping at the right edge onto the next line.
    terminal.feed(&screen, " world!")
    if !text(&screen, 0, 5, " worl") || !text(&screen, 1, 0, "d!") || screen.cursorRow != 1 || screen.cursorColumn != 2 { return 21 }
    // 4: CR, LF, a tab.
    terminal.feed(&screen, "\r\n\tx")
    if screen.cursorRow != 2 || !text(&screen, 2, 8, "x") { return 22 }
    // 5: UTF-8 (ä is two bytes) and a wide character taking two cells.
    terminal.feed(&screen, "\r\n")
    var utf8: [7]u8 = [7]u8{ 195, 164, 230, 151, 165, 98, 0 }
    var utf8_bytes: [*]const u8 = undefined
    unsafe { utf8_bytes = @ptrCast([*]const u8, &utf8) }
    terminal.feed(&screen, utf8_bytes[0..6])
    if cell(&screen, 3, 0).*.codepoint != 228 || cell(&screen, 3, 1).*.codepoint != 26085 || cell(&screen, 3, 1).*.width != 2 || cell(&screen, 3, 2).*.width != 0 || cell(&screen, 3, 3).*.codepoint != 98 { return 23 }
    // 6: a line feed at the bottom scrolls, the top line into the history.
    terminal.feed(&screen, "\n")
    if screen.historyCount != 1 || !text(&screen, 0, 0, "d!") || screen.cursorRow != 3 { return 24 }
    // 7: the view scrolled up one line shows the history line.
    terminal.scrollView(&screen, 1)
    if screen.viewOffset != 1 || !text(&screen, 0, 0, "hello worl") || !text(&screen, 1, 0, "d!") { return 25 }
    terminal.resetView(&screen)
    // 8: CUP, ED 2, then CUP again and text; EL from the cursor.
    esc(&screen, "[2J")
    esc(&screen, "[2;3H")
    terminal.feed(&screen, "abcdef")
    esc(&screen, "[2;5H")
    esc(&screen, "[K")
    if !text(&screen, 1, 2, "ab") || cell(&screen, 1, 4).*.codepoint != 32 || cell(&screen, 1, 6).*.codepoint != 32 { return 26 }
    // 9: ICH and DCH.
    esc(&screen, "[2;3H")
    esc(&screen, "[2@")
    if !text(&screen, 1, 2, "  ab") { return 27 }
    esc(&screen, "[2P")
    if !text(&screen, 1, 2, "ab") { return 27 }
    // 10: SGR: red on blue, bold, then reset.
    esc(&screen, "[2J")
    esc(&screen, "[H")
    esc(&screen, "[31;44;1mR")
    esc(&screen, "[0mN")
    const red = cell(&screen, 0, 0)
    if red.*.foreground != terminal.paletteColor(9) || red.*.background != terminal.paletteColor(4) || red.*.flags & terminal.BOLD == 0 { return 28 }
    const plain = cell(&screen, 0, 1)
    if plain.*.foreground != terminal.DEFAULT || plain.*.background != terminal.DEFAULT || plain.*.flags != 0 { return 28 }
    // 11: 256 colours and direct colours, inverse and underline.
    esc(&screen, "[38;5;208;48;2;10;20;30;7;4mX")
    const fancy = cell(&screen, 0, 2)
    if fancy.*.foreground != terminal.paletteColor(208) || fancy.*.background != 4278850590 || fancy.*.flags & terminal.INVERSE == 0 || fancy.*.flags & terminal.UNDERLINE == 0 { return 29 }
    esc(&screen, "[m")
    // 12: a scrolling region: lines 2..3 scroll, line 1 and 4 stay.
    esc(&screen, "[2J")
    esc(&screen, "[1;1Hone")
    esc(&screen, "[2;1Htwo")
    esc(&screen, "[3;1Hthree")
    esc(&screen, "[4;1Hfour")
    esc(&screen, "[2;3r")
    esc(&screen, "[3;1H")
    terminal.feed(&screen, "\n")
    if !text(&screen, 0, 0, "one") || !text(&screen, 1, 0, "three") || cell(&screen, 2, 0).*.codepoint != 32 || !text(&screen, 3, 0, "four") { return 30 }
    esc(&screen, "[r")
    // 13: IL and DL.
    esc(&screen, "[2;1H")
    esc(&screen, "[L")
    if cell(&screen, 1, 0).*.codepoint != 32 || !text(&screen, 2, 0, "three") { return 31 }
    esc(&screen, "[M")
    if !text(&screen, 1, 0, "three") || cell(&screen, 3, 0).*.codepoint != 32 { return 31 }
    // 14: the alternate screen keeps the main one.
    esc(&screen, "[?1049h")
    if cell(&screen, 0, 0).*.codepoint != 32 { return 32 }
    terminal.feed(&screen, "alt")
    esc(&screen, "[?1049l")
    if !text(&screen, 0, 0, "one") || screen.onAlternate { return 32 }
    // 15: DSR 6 reports the cursor; DA answers.
    esc(&screen, "[3;4H")
    esc(&screen, "[6n")
    var reply: [32]u8 = undefined
    var reply_bytes: [*]u8 = undefined
    unsafe { reply_bytes = @ptrCast([*]u8, &reply) }
    var length = terminal.takeResponses(&screen, reply_bytes, 32)
    if length != 6 || reply[0] != 27 || reply[1] != 91 || reply[2] != 51 || reply[3] != 59 || reply[4] != 52 || reply[5] != 82 { return 33 }
    esc(&screen, "[c")
    length = terminal.takeResponses(&screen, reply_bytes, 32)
    if length != 5 || reply[2] != 63 || reply[3] != 54 || reply[4] != 99 { return 33 }
    // 16: the title from OSC 0 (BEL) and OSC 2 (ST).
    esc(&screen, "]0;First")
    terminal.feedByte(&screen, 7)
    if !terminal.takeTitleChange(&screen) || !std.text.same(terminal.titleText(&screen), "First") { return 34 }
    esc(&screen, "]2;Second")
    esc(&screen, "\\")
    if !std.text.same(terminal.titleText(&screen), "Second") { return 34 }
    // 17: modes: application cursor keys, bracketed paste, cursor hidden.
    esc(&screen, "[?1h")
    esc(&screen, "[?2004h")
    esc(&screen, "[?25l")
    if !screen.applicationCursor || !screen.bracketedPaste || terminal.cursorShown(&screen) { return 35 }
    esc(&screen, "[?25h")
    // 18: DEC special graphics: q is a horizontal line.
    esc(&screen, "(0")
    esc(&screen, "[4;1Hq")
    esc(&screen, "(B")
    if cell(&screen, 3, 0).*.codepoint != 9472 { return 36 }
    // 19: a resize to 6 columns and 3 rows keeps the top left; the cursor
    // line stays on screen.
    esc(&screen, "[4;2H")
    if !terminal.resize(&screen, 6, 3) || screen.columns != 6 || screen.rows != 3 { return 37 }
    if screen.cursorRow != 2 || !text(&screen, 0, 0, "three") { return 37 }
    // 20: save and restore the cursor (DECSC/DECRC) with attributes.
    esc(&screen, "[1;2H")
    esc(&screen, "[32m")
    esc(&screen, "7")
    esc(&screen, "[3;3H")
    esc(&screen, "[0m")
    esc(&screen, "8")
    if screen.cursorRow != 0 || screen.cursorColumn != 1 || screen.foreground != terminal.paletteColor(2) { return 38 }
    // 21: autowrap off keeps writing in the last column.
    esc(&screen, "[?7l")
    esc(&screen, "[1;1Habcdefgh")
    if !text(&screen, 0, 0, "abcdeh") || screen.cursorRow != 0 { return 39 }
    terminal.deinit(&screen)
    return 13
}
