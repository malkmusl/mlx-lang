// std.aac: a short sound effect (Chromium's media/test/data/sfx, BSD
// licensed; AAC-LC, 44.1 kHz, mono) decoded from its MP4 (through
// std.mp4: 14 blocks, the edit list's 1024-sample priming) and from its
// ADTS stream (configureAdts, adtsFrame), each compared with 2048
// samples of the WAV it was encoded from at the loudest place: the
// signal-to-noise ratio must be above 15 dB (the encoder's loss is about
// 22 dB). Then damaged data refused without a trap, and reset(). Exits 13
// when every check holds, else the number of the first check that failed.
const std = @import("std")
const mp4 = @import("std.mp4")
const aac = @import("std.aac")

const OFFSET: usize = 8448
const DELAY: usize = 1024

// The decoded samples (every block appended) compared with `reference`
// at OFFSET + DELAY: true when the SNR is above 15 dB.
fn close(samples: [*]const f32, count: usize) -> bool {
    if count < OFFSET + DELAY + 2048 { return false }
    var signal: f64 = 0.0
    var noise: f64 = 0.0
    var index: usize = 0
    while index < 2048 {
        const want = @floatFromInt(f64, reference[index])
        const got = @floatCast(f64, samples[OFFSET + DELAY + index]) * 32768.0
        signal += want * want
        noise += (want - got) * (want - got)
        index += 1
    }
    if noise == 0.0 { return true }
    return signal > noise * 31.6
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const decoder = aac.create(allocator)
    if decoder == null { return 1 }
    const d = decoder.?
    var pcm: [16 * aac.FRAME]f32 = undefined
    var frame: [aac.MAX_CHANNELS * aac.FRAME]f32 = undefined

    // The MP4.
    var movie: mp4.Movie = undefined
    mp4.init(&movie, allocator)
    var samples: mp4.Samples = undefined
    mp4.initSamples(&samples, allocator)
    var used: usize = 0
    if mp4.parse(&movie, &sfxMp4, 2254, &samples, &used) != mp4.Status.ok { return 2 }
    const index = mp4.trackOfKind(&movie, mp4.KIND_AUDIO)
    if index >= mp4.MAX_TRACKS { return 3 }
    const track = mp4.track(&movie, index)
    if track.*.codec != mp4.CODEC_AAC || track.*.rate != 44100 || track.*.channels != 1 || track.*.editMediaTime != 1024 { return 4 }
    if aac.configure(d, &track.*.config, track.*.configLength) != aac.Status.ok { return 5 }
    if d.*.rate != 44100 || d.*.channelConfig != 1 { return 6 }
    var count: usize = 0
    var blocks: usize = 0
    var sample: mp4.Sample = undefined
    while mp4.nextSample(&movie, index, &sample) {
        if aac.decode(d, &sfxMp4[sample.offset], sample.size, &frame) != aac.Status.ok { return 7 }
        if d.*.channels != 1 { return 8 }
        var i: usize = 0
        while i < aac.FRAME {
            pcm[count + i] = frame[i]
            i += 1
        }
        count += aac.FRAME
        blocks += 1
    }
    if blocks != 14 { return 9 }
    if !close(&pcm, count) { return 10 }

    // The ADTS stream.
    var at: usize = 0
    var dataOffset: usize = 0
    var dataLength: usize = 0
    if !aac.adtsFrame(&sfxAdts, 1548, 0, &dataOffset, &dataLength) { return 11 }
    if aac.configureAdts(d, &sfxAdts, 1548) != aac.Status.ok { return 12 }
    if d.*.rate != 44100 || d.*.channelConfig != 1 { return 14 }
    count = 0
    blocks = 0
    while aac.adtsFrame(&sfxAdts, 1548, at, &dataOffset, &dataLength) {
        if aac.decode(d, &sfxAdts[dataOffset], dataLength, &frame) != aac.Status.ok { return 15 }
        var i: usize = 0
        while i < aac.FRAME {
            pcm[count + i] = frame[i]
            i += 1
        }
        count += aac.FRAME
        blocks += 1
        at = dataOffset + dataLength
    }
    if blocks != 14 || at != 1548 { return 16 }
    if !close(&pcm, count) { return 17 }

    // Damage: a block cut short, and one with its bytes inverted, are
    // refused; the decoder goes on afterwards.
    var copy: [167]u8 = undefined
    var i: usize = 0
    while i < 167 {
        copy[i] = ~sfxAdts[7 + i]
        i += 1
    }
    if aac.decode(d, &copy, 167, &frame) == aac.Status.ok { return 18 }
    if aac.decode(d, &sfxAdts[7], 40, &frame) == aac.Status.ok { return 19 }
    aac.reset(d)
    if aac.decode(d, &sfxAdts[7], 167, &frame) != aac.Status.ok { return 20 }
    // Not configured: refused.
    const fresh = aac.create(allocator)
    if fresh == null { return 21 }
    if aac.decode(fresh.?, &sfxAdts[7], 167, &frame) != aac.Status.corrupt { return 22 }
    aac.destroy(fresh.?)
    aac.destroy(d)
    mp4.deinitSamples(&samples)
    mp4.deinit(&movie)
    return 13
}

