// `@bitCast(u32, f32_value)` is the float's 32 bits and nothing above
// them, also when held in a local first and when the same generic was
// instantiated with f64 before. Exits 13.
fn bitsOf(comptime T: type, v: T) -> u64 {
    if @bitSizeOf(T) == 32 {
        return @intCast(u64, @bitCast(u32, v))
    }
    return @bitCast(u64, v)
}

fn wide(comptime T: type, v: T) -> u64 {
    if @bitSizeOf(T) == 32 {
        const narrow = @bitCast(u32, v)
        return @intCast(u64, narrow)
    }
    return @bitCast(u64, v)
}

fn main() -> u8 {
    const one: f64 = 1.0
    const small: f32 = 1.5
    const b = bitsOf(f32, small)
    if b != 1069547520 { return 1 }
    const a = bitsOf(f64, one)
    if a != 4607182418800017408 { return 2 }
    const c = wide(f64, one)
    if c != 4607182418800017408 { return 3 }
    const d = wide(f32, small)
    if d != 1069547520 { return 4 }
    return 13
}
