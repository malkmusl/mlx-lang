// A pointer to an array is a many-item pointer to its first element, with
// no cast: in a binding, an argument, a field, a return value and an
// assignment, a `*const [N]T` only as a `[*]const T`. A many-item pointer
// steps by whole elements: `p + n`, `p - n`, `p += n`, `p -= n`.

const Pixel = struct {
    red: u8,
    green: u8,
    blue: u8,
    alpha: u32
}

const Holder = struct {
    store: [6]u16,
    view: [*]u16
}

fn total(values: [*]const u32, count: usize) -> u32 {
    var sum: u32 = 0
    var at: usize = 0
    while at < count {
        sum += values[at]
        at += 1
    }
    return sum
}

fn fill(bytes: [*]u8, count: usize, value: u8) -> void {
    var at: usize = 0
    while at < count {
        bytes[at] = value
        at += 1
    }
}

fn firstOf(holder: *Holder) -> [*]u16 {
    return &holder.*.store
}

fn steppedBack(end: [*]u32, count: u32) -> [*]u32 {
    return end - count
}

pub fn main() -> u8 {
    var bytes: [8]u8 = [8]u8{ 0, 0, 0, 0, 0, 0, 0, 0 }
    const view: [*]u8 = &bytes
    view[3] = 9
    if bytes[3] != 9 { return 1 }
    fill(&bytes, 8, 4)
    if bytes[0] != 4 || bytes[7] != 4 { return 2 }

    const numbers = [4]u32{ 10, 20, 30, 40 }
    const read: [*]const u32 = &numbers
    if total(&numbers, 4) != 100 || read[2] != 30 { return 3 }

    var holder: Holder = undefined
    holder.view = &holder.store
    holder.view[5] = 77
    if holder.store[5] != 77 || firstOf(&holder)[5] != 77 { return 4 }

    var words: [6]u32 = [6]u32{ 1, 2, 3, 4, 5, 6 }
    var cursor: [*]u32 = &words
    const third = cursor + 2
    if third[0] != 3 || third[1] != 4 { return 5 }
    cursor += 4
    if cursor[1] != 6 { return 6 }
    cursor -= 3
    if cursor[0] != 2 { return 7 }
    const start: [*]u32 = &words
    var back: u32 = 2
    if steppedBack(start + 5, back)[0] != 4 { return 8 }
    const skip: usize = 1
    if (third + skip)[0] != 4 || (third - skip)[0] != 2 { return 9 }

    // Elements wider than a byte and with padding: steps of @sizeOf(Pixel).
    var pixels: [3]Pixel = undefined
    var pixel: [*]Pixel = &pixels
    var index: u8 = 0
    while index < 3 {
        pixel[0].red = index
        pixel[0].alpha = 1000 + @intCast(u32, index)
        pixel += 1
        index += 1
    }
    if pixels[2].red != 2 || pixels[1].alpha != 1001 { return 10 }
    if @intFromPtr(pixel) - @intFromPtr(&pixels) != 3 * @sizeOf(Pixel) { return 11 }
    return 13
}
