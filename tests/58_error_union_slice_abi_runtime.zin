// Tests error-union ABI transport for a string slice by unwrapping it and checking its final byte is 99.
fn source() ![]const u8 {
    return "abc"
}

fn forward() ![]const u8 {
    return source()
}

pub fn main() !void {
    const value = try forward()
    var last: u8 = 0
    for item in value {
        last = item
    }
    while last != 99 {}
}
