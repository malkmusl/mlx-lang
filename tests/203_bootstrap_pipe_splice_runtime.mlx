const std = @import("std")

pub fn main() -> u8 {
    var source_bytes: [6]u8 = [6]u8{ 115, 112, 108, 105, 99, 101 }
    var output_bytes: [6]u8 = [6]u8{ 0, 0, 0, 0, 0, 0 }
    unsafe {
        const source_path = @ptrCast([*]const u8, "/tmp/mlx-splice-source")
        const output_path = @ptrCast([*]const u8, "/tmp/mlx-splice-output")
        const flags = std.fs.READ_WRITE | std.fs.CREATE | std.fs.TRUNCATE
        const source = std.fs.open(source_path, flags, 384)
        const output = std.fs.open(output_path, flags, 384)
        if !std.fs.isValid(source) || !std.fs.isValid(output) { return 1 }
        if !std.fs.writeAllBytes(source, @ptrCast([*]const u8, source_bytes[0..6]), 6) { return 2 }
        if std.fs.seek(source, 0, std.fs.SEEK_START) != 0 { return 3 }

        const created = std.fs.makePipe()
        if created == null { return 4 }
        const pipe = created.?
        const read_end = std.fs.File.{ .descriptor = pipe.readDescriptor }
        const write_end = std.fs.File.{ .descriptor = pipe.writeDescriptor }
        if std.fs.splice(source, write_end, 6) != 6 { return 5 }
        if std.fs.splice(read_end, output, 6) != 6 { return 6 }
        if !std.fs.close(read_end) || !std.fs.close(write_end) { return 7 }
        if std.fs.seek(output, 0, std.fs.SEEK_START) != 0 { return 8 }
        if std.fs.read(output, @ptrCast([*]u8, output_bytes[0..6]), 6) != 6 { return 9 }
        if !std.fs.close(source) || !std.fs.close(output) { return 10 }
        if !std.fs.delete(source_path) || !std.fs.delete(output_path) { return 11 }
    }
    if output_bytes[0] != 115 || output_bytes[5] != 101 { return 12 }
    return 13
}
