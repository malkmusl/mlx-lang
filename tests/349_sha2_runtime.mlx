// std.sha2's SHA-224 and SHA-384 with the examples of FIPS 180-4 (NIST's
// "abc", the two-block messages and a million "a"), and nothing; the
// SHA-256, SHA-512 and SHA-1 of "abc" alongside. Exits 13 when every
// check holds, else the number of the first check that failed.
const sha1 = @import("std.sha1")
const sha2 = @import("std.sha2")
const base64 = @import("std.base64")

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn digestIs(digest: [*]const u8, length: usize, hex: []const u8) -> bool {
    var text: [128]u8 = undefined
    const out: [*]u8 = &text
    const count = base64.hexEncode(digest[0..length], out)
    return same(out[0..count], hex)
}

fn sha224Is(message: []const u8, hex: []const u8) -> bool {
    var digest: [28]u8 = undefined
    sha2.sha224(message, &digest)
    const bytes: [*]const u8 = &digest
    return digestIs(bytes, 28, hex)
}

fn sha384Is(message: []const u8, hex: []const u8) -> bool {
    var digest: [48]u8 = undefined
    sha2.sha384(message, &digest)
    const bytes: [*]const u8 = &digest
    return digestIs(bytes, 48, hex)
}

pub fn main() -> u8 {
    if !sha224Is("abc", "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7") { return 1 }
    if !sha224Is("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "75388b16512776cc5dba5da1fd890150b0c6455cb4f58b1952522525") { return 2 }
    if !sha224Is("", "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f") { return 3 }
    if !sha384Is("abc", "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7") { return 4 }
    if !sha384Is("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu", "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039") { return 5 }
    if !sha384Is("", "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b") { return 6 }

    // A million "a", a thousand at a time.
    var thousand: [1000]u8 = undefined
    var index: usize = 0
    while index < 1000 {
        thousand[index] = 97
        index += 1
    }
    const piece: [*]const u8 = &thousand
    var small: sha2.Sha256 = undefined
    var large: sha2.Sha512 = undefined
    sha2.sha224Init(&small)
    sha2.sha384Init(&large)
    index = 0
    while index < 1000 {
        sha2.sha224Update(&small, piece[0..1000])
        sha2.sha384Update(&large, piece[0..1000])
        index += 1
    }
    var digest224: [28]u8 = undefined
    var digest384: [48]u8 = undefined
    sha2.sha224Final(&small, &digest224)
    sha2.sha384Final(&large, &digest384)
    const bytes224: [*]const u8 = &digest224
    const bytes384: [*]const u8 = &digest384
    if !digestIs(bytes224, 28, "20794655980c91d8bbb4c1ea97618a4bf03f42581948b2ee4ee7ad67") { return 7 }
    if !digestIs(bytes384, 48, "9d0e1809716474cb086e834e310a4a1ced149e9c00f248527972cec5704c2a5b07b8b3dc38ecc4ebae97ddd87f3d8985") { return 8 }

    var digest256: [32]u8 = undefined
    sha2.sha256("abc", &digest256)
    const bytes256: [*]const u8 = &digest256
    if !digestIs(bytes256, 32, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") { return 9 }
    var digest512: [64]u8 = undefined
    sha2.sha512("abc", &digest512)
    const bytes512: [*]const u8 = &digest512
    if !digestIs(bytes512, 64, "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f") { return 10 }
    var digest160: [20]u8 = undefined
    sha1.sha1("abc", &digest160)
    const bytes160: [*]const u8 = &digest160
    if !digestIs(bytes160, 20, "a9993e364706816aba3e25717850c26c9cd0d89d") { return 11 }
    return 13
}
