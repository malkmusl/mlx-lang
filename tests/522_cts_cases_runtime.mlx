// The Vulkan conformance suite's cases our driver must pass over the host
// card (projects/cts/check-cases.txt), as the suite's own result file
// says them: tools/check_cts.sh builds deqp-vk (./mlx build cts) and runs
// the list as one group with tools/run_cts.sh, which writes
// mlx-out/cts/results/check-cases.qpa; the build is too long for this
// runner, so this reads what the run wrote. Every case of the list must
// be in the file once, its result must end there (not cut off by a crash,
// the suite's watchdog or the next run's cases) and say Pass, and the file
// must hold no other case. Every run in the file must be the suite at the
// tag the port builds (its release name) against our driver (no other
// Vulkan library named on its command line). The reading is first held
// against made-up result files, each with one of those faults, and
// tools/run_cts.sh against a stand-in for the suite (tools/check_cts.sh
// --runner: a crash, a case the suite does not have, not supported for
// want of the port, each told as it ended). Exits 13 when every check
// holds, else the number of the first that failed, with the case on the
// error output.
const std = @import("std")
const spawn = @import("std.spawn")

const CASES: []const u8 = "projects/cts/check-cases.txt"
const RESULTS: []const u8 = "mlx-out/cts/results/check-cases.qpa"
const BEGIN: []const u8 = "#beginTestCaseResult "
const END: []const u8 = "#endTestCaseResult"
const TERMINATED: []const u8 = "#terminateTestCaseResult"
const PASS: []const u8 = "<Result StatusCode=\"Pass\">"
const RELEASE: []const u8 = "#sessionInfo releaseName "
const COMMAND_LINE: []const u8 = "#sessionInfo commandLineParameters "
// The suite's tag, which the port's build writes into the suite as its
// release name (projects/cts/UPSTREAM.md, vk-gl-cts.tag).
const TAG: []const u8 = "vulkan-cts-1.3.10.0"
// The suite's option that loads another Vulkan library than our driver.
const OTHER_LIBRARY: []const u8 = "--deqp-vk-library-path"

fn tell(what: []const u8, case: []const u8, check: u8) -> u8 {
    _ = std.io.eprint("522: ")
    _ = std.io.eprint(what)
    _ = std.io.eprintln(case)
    return check
}

// How often `needle` occurs in `text`.
fn count(text: []const u8, needle: []const u8) -> usize {
    var found: usize = 0
    var at: usize = 0
    while at < text.length {
        const next = std.text.find(text[at..text.length], needle)
        if next >= text.length - at { break }
        found += 1
        at += next + needle.length
    }
    return found
}

// The line of `text` that starts at `start`, without its line end.
fn lineAt(text: []const u8, start: usize) -> []const u8 {
    var end = start
    while end < text.length && text[end] != 10 { end += 1 }
    return text[start..end]
}

// The result of the case whose heading starts `rest`: the text after the
// heading up to the first of its end, another case's heading (a run cut
// off and the next one's cases) or a termination, and whether that first
// one is its end.
fn caseResult(rest: []const u8, heading: usize) -> ([]const u8, bool) {
    const body = rest[heading..rest.length]
    const ending = std.text.find(body, END)
    const other = std.text.find(body, BEGIN)
    const stopped = std.text.find(body, TERMINATED)
    var first = ending
    if other < first { first = other }
    if stopped < first { first = stopped }
    return (body[0..first], ending == first && ending < body.length)
}

// Whether every run in `results` is the suite at TAG against our driver:
// 0 when it is, else the check that failed and the line it was about.
fn sessions(results: []const u8) -> (u8, []const u8) {
    var releases: usize = 0
    var start: usize = 0
    while start < results.length {
        const line = lineAt(results, start)
        start += line.length + 1
        if std.text.startsWith(line, RELEASE) {
            releases += 1
            if !std.text.same(std.text.trimmed(line[RELEASE.length..line.length]), TAG) { return (9, line) }
        }
        if std.text.startsWith(line, COMMAND_LINE) && std.text.contains(line, OTHER_LIBRARY) { return (8, line) }
    }
    if releases == 0 { return (9, "(no #sessionInfo releaseName)") }
    return (0, "")
}

// The verdict on `results` for the cases `list` names: 13 when every
// check holds, else the number of the first that failed, with what it
// was about (a case, a line).
fn judge(list: []const u8, results: []const u8) -> (u8, []const u8) {
    var heading: [512]u8 = undefined
    const heading_bytes: [*]u8 = &heading
    var cases: usize = 0
    var start: usize = 0
    while start < list.length {
        var end = start
        while end < list.length && list[end] != 10 { end += 1 }
        var line: []const u8 = list[start..end]
        const comment = std.text.find(line, "#")
        line = std.text.trimmed(line[0..comment])
        start = end + 1
        if line.length == 0 { continue }
        cases += 1
        var at = std.text.append(heading_bytes, 0, 512, BEGIN)
        at = std.text.append(heading_bytes, at, 512, line)
        at = std.text.appendByte(heading_bytes, at, 512, 10)
        const name = heading_bytes[0..at]
        if count(results, name) != 1 { return (3, line) }
        const from = std.text.find(results, name)
        const result = caseResult(results[from..results.length], name.length)
        if !result.1 { return (4, line) }
        if !std.text.contains(result.0, PASS) { return (5, line) }
    }
    if cases == 0 { return (6, CASES) }
    // No case beside the list's (a list cut short shows here).
    if count(results, BEGIN) != cases { return (7, RESULTS) }
    const session = sessions(results)
    if session.0 != 0 { return session }
    return (13, "")
}

fn verdictOf(list: []const u8, results: []const u8) -> u8 { return judge(list, results).0 }

// The made-up result files: a run's head, cases in it, and a head of
// another run with another library.
const HEAD: []const u8 = "#sessionInfo releaseName vulkan-cts-1.3.10.0\n#sessionInfo commandLineParameters \"--deqp-compute-only=enable\"\n\n#beginSession\n"
const FOREIGN: []const u8 = "#sessionInfo releaseName vulkan-cts-1.3.10.0\n#sessionInfo commandLineParameters \"--deqp-vk-library-path=/usr/lib/libvulkan.so.1\"\n\n#beginSession\n"
const UNKNOWN: []const u8 = "#sessionInfo releaseName unknown\n#sessionInfo commandLineParameters \"--deqp-compute-only=enable\"\n\n#beginSession\n"
const ONE: []const u8 = "#beginTestCaseResult t.one\n<TestCaseResult CasePath=\"t.one\">\n <Result StatusCode=\"Pass\">Ok</Result>\n</TestCaseResult>\n#endTestCaseResult\n\n"
const TWO: []const u8 = "#beginTestCaseResult t.two\n<TestCaseResult CasePath=\"t.two\">\n <Result StatusCode=\"Pass\">Ok</Result>\n</TestCaseResult>\n#endTestCaseResult\n\n"
const THREE: []const u8 = "#beginTestCaseResult t.three\n<TestCaseResult CasePath=\"t.three\">\n <Result StatusCode=\"Pass\">Ok</Result>\n</TestCaseResult>\n#endTestCaseResult\n\n"
const ONE_FAILED: []const u8 = "#beginTestCaseResult t.one\n<TestCaseResult CasePath=\"t.one\">\n <Result StatusCode=\"Fail\">wrong</Result>\n</TestCaseResult>\n#endTestCaseResult\n\n"
const ONE_CUT_OFF: []const u8 = "#beginTestCaseResult t.one\n<TestCaseResult CasePath=\"t.one\">\n <Text>began</Text>\n"
const ONE_TERMINATED: []const u8 = "#beginTestCaseResult t.one\n<TestCaseResult CasePath=\"t.one\">\n#terminateTestCaseResult Crash\n"
const LIST: []const u8 = "# the cases\nt.one\nt.two   # the second\n"

var made: [4096]u8 = undefined

// The parts one after the other.
fn joined(a: []const u8, b: []const u8, c: []const u8, d: []const u8) -> []const u8 {
    const bytes: [*]u8 = &made
    var at = std.text.append(bytes, 0, 4096, a)
    at = std.text.append(bytes, at, 4096, b)
    at = std.text.append(bytes, at, 4096, c)
    at = std.text.append(bytes, at, 4096, d)
    return bytes[0..at]
}

// The made-up files, each with the verdict it must have: 0 when all are
// judged so, else the first one that was not (counted from 1).
fn selfCheck() -> u8 {
    if verdictOf(LIST, joined(HEAD, ONE, TWO, "")) != 13 { return 1 }
    // A case cut off by a crash: the run after it goes on with the next.
    if verdictOf(LIST, joined(HEAD, ONE_CUT_OFF, HEAD, TWO)) != 4 { return 2 }
    if verdictOf(LIST, joined(HEAD, ONE_TERMINATED, HEAD, TWO)) != 4 { return 3 }
    if verdictOf(LIST, joined(HEAD, ONE_CUT_OFF, "", "")) != 4 { return 4 }
    if verdictOf(LIST, joined(HEAD, ONE_FAILED, TWO, "")) != 5 { return 5 }
    if verdictOf(LIST, joined(HEAD, TWO, "", "")) != 3 { return 6 }
    if verdictOf(LIST, joined(HEAD, ONE, ONE, TWO)) != 3 { return 7 }
    if verdictOf(LIST, joined(HEAD, ONE, TWO, THREE)) != 7 { return 8 }
    if verdictOf(LIST, joined(HEAD, ONE, FOREIGN, TWO)) != 8 { return 9 }
    if verdictOf(LIST, joined(UNKNOWN, ONE, TWO, "")) != 9 { return 10 }
    if verdictOf(LIST, joined(ONE, TWO, "", "")) != 9 { return 11 }
    return 0
}

// tools/check_cts.sh --runner: 0 when it ends with 0 and says so, else
// the check that failed (what it said on the error output).
fn runnerCheck(arguments: [][*]const u8) -> u8 {
    const environment = std.process.environmentEntries(arguments)
    var argv: [3][*]const u8 = undefined
    argv[0] = "tools/check_cts.sh".pointer
    argv[1] = "--runner".pointer
    argv[2] = unsafe { @ptrFromInt([*]const u8, 0) }
    var options = spawn.options("tools/check_cts.sh".pointer, unsafe { @ptrCast([*][*]const u8, &argv) }, environment)
    var captured: [8192]u8 = undefined
    const captured_bytes: [*]u8 = &captured
    var ending = spawn.Ending.lost()
    const length = spawn.capture(&options, true, captured_bytes, 8192, &ending)
    if length < 0 { return 40 }
    const output = captured_bytes[0..@intCast(usize, length)]
    if ending.status() != 0 || !std.text.contains(output, "check_cts.sh: tools/run_cts.sh tells every case of the stand-in suite as it ended\n") {
        _ = std.io.eprintln("522: what tools/check_cts.sh --runner said:")
        _ = std.io.eprint(output)
        return 41
    }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const wrong = selfCheck()
    if wrong != 0 {
        var number: [8]u8 = undefined
        const number_bytes: [*]u8 = &number
        const length = std.text.appendUnsigned(number_bytes, 0, 8, @intCast(usize, wrong))
        _ = std.io.eprint("522: the reading of a result file judges a made-up one wrongly, number ")
        _ = std.io.eprintln(number_bytes[0..length])
        return 20 + wrong
    }
    const runner = runnerCheck(arguments)
    if runner != 0 { return runner }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const list_loaded = std.fs.readFileAlloc(CASES.pointer, allocator)
    if list_loaded == null { return tell("no list of cases at ", CASES, 1) }
    const results_loaded = std.fs.readFileAlloc(RESULTS.pointer, allocator)
    if results_loaded == null { return tell("no result file (tools/check_cts.sh writes it) at ", RESULTS, 2) }
    const list_file = list_loaded.?
    const results_file = results_loaded.?
    const list: []const u8 = list_file.items[0..list_file.length]
    const results: []const u8 = results_file.items[0..results_file.length]
    const verdict = judge(list, results)
    const subject = verdict.1
    if verdict.0 == 3 { return tell("not in the result file once: ", subject, 3) }
    if verdict.0 == 4 { return tell("its result does not end (a crash, the watchdog, a run cut off): ", subject, 4) }
    if verdict.0 == 5 { return tell("did not pass: ", subject, 5) }
    if verdict.0 == 6 { return tell("no case in ", subject, 6) }
    if verdict.0 == 7 { return tell("other cases than the list's in ", subject, 7) }
    if verdict.0 == 8 { return tell("a run against another Vulkan library than our driver: ", subject, 8) }
    if verdict.0 == 9 { return tell("a run of another suite than the port's tag: ", subject, 9) }
    std.fs.ArrayList.deinit(list_file)
    std.fs.ArrayList.deinit(results_file)
    return 13
}
