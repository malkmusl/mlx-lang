// Module-level declarations resolve in any order: a constant, a variable,
// a struct field and a function signature may name a type declared further
// down. Older compilers analyzed the module top to bottom once and failed
// on the first name not analyzed yet. Exits 13 when every check holds, else
// the number of the first check that failed.
const FAVOURITE: Color = Color.green
var current: Color = Color.blue

const Scratch = struct { scientific: Scientific, count: u32 }

fn exponentOf(value: Scientific) -> i32 { return value.exponent }

const Scientific = struct { mantissa: u64, exponent: i32 }
const Color = enum(u8) { red, green, blue }

pub fn main() -> u8 {
    if FAVOURITE != Color.green { return 1 }
    if current != Color.blue { return 2 }
    current = Color.red
    if current != Color.red { return 3 }
    var scratch: Scratch = undefined
    scratch.scientific.mantissa = 5
    scratch.scientific.exponent = -2
    scratch.count = 1
    if scratch.scientific.mantissa != 5 || exponentOf(scratch.scientific) != -2 || scratch.count != 1 { return 4 }
    return 13
}
