// The optimizer joins a block entered only by falling through from the
// branch right before its label (br X; label X): the branch and the
// label go, so a value computed before them is read in the same block
// after (the backend's register cache keeps it in a register). A block
// branched to from elsewhere too stays. Exits 13 when every check holds,
// else the number of the first check that failed.
const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const lir = @import("../compiler/selfhost/ir/lir.mlx")
const optimize = @import("../compiler/selfhost/ir/optimize.mlx")

pub fn main() -> u8 {
    const allocator: page_allocator.Allocator = page_allocator.init()
    var ir = lir.init(allocator)
    var main_pointer: [*]const u8 = undefined
    unsafe { main_pointer = @ptrCast([*]const u8, "main") }
    const main_symbol = lir.addSymbol(&ir, main_pointer, 4)
    const label = lir.addInst(&ir, lir.labelInst(lir.NONE, main_symbol))
    const value = lir.addInst(&ir, lir.constI(lir.NONE, 13))
    // Block 1 only falls through from here: joined.
    const branch_one = lir.addInst(&ir, lir.branch(1))
    const label_one = lir.addInst(&ir, lir.blockLabelInst(1))
    // Block 2 is branched to from block 3 too: kept.
    const branch_two = lir.addInst(&ir, lir.branch(2))
    const label_two = lir.addInst(&ir, lir.blockLabelInst(2))
    const returned = lir.addInst(&ir, lir.retInst(lir.NONE, value))
    const label_three = lir.addInst(&ir, lir.blockLabelInst(3))
    const back = lir.addInst(&ir, lir.branch(2))

    const result = optimize.run(&ir, allocator)
    if result.blocksMerged != 1 { return 1 }
    if lir.getInst(&ir, branch_one).opcode != lir.Opcode.dead || lir.getInst(&ir, label_one).opcode != lir.Opcode.dead { return 2 }
    if lir.getInst(&ir, branch_two).opcode != lir.Opcode.br || lir.getInst(&ir, label_two).opcode != lir.Opcode.label { return 3 }
    if lir.getInst(&ir, label).opcode != lir.Opcode.label || lir.getInst(&ir, returned).opcode != lir.Opcode.ret { return 4 }
    lir.deinit(&ir)
    return 13
}
