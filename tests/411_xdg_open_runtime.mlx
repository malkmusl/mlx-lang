// std.xdg.open over a home of the test's own (a temporary folder): a
// file's type by its name and a folder's (inode/directory); the default
// application of a type from mimeapps.list (its first entry that
// exists), else from an entry whose MimeType lists the type; the command
// of an entry's Exec line with %f, %U and none; and a file opened (the
// entry's command, run detached, writes what it was given). Exits 13
// when every check holds, else the number of the first check that
// failed.
const std = @import("std")
const open = @import("std.xdg.open")

const Bytes = std.ArrayList(u8)

fn put(path: []const u8, text: []const u8) -> bool {
    var name = Bytes.init(std.heap.allocator())
    defer name.deinit()
    if !name.appendSlice(path) || !name.append(0) { return false }
    const file = std.fs.open(name.items().pointer, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 0o755)
    if !std.fs.isValid(file) { return false }
    const ok = std.fs.writeAllBytes(file, text.pointer, text.length)
    _ = std.fs.close(file)
    return ok
}

fn joined(into: *Bytes, a: []const u8, b: []const u8) -> []const u8 {
    into.clearRetainingCapacity()
    _ = into.appendSlice(a)
    _ = into.appendSlice(b)
    return into.items()
}

fn check(root: []const u8) -> u8 {
    var path = Bytes.init(std.heap.allocator())
    defer path.deinit()
    var other = Bytes.init(std.heap.allocator())
    defer other.deinit()
    var made = Bytes.init(std.heap.allocator())
    defer made.deinit()
    // $HOME/.local/share/applications, $HOME/.config, the data dirs'.
    _ = std.fs.makeDirectories(joined(&path, root, "/home/.local/share/applications"), 0o755)
    _ = std.fs.makeDirectories(joined(&path, root, "/home/.config"), 0o755)
    _ = std.fs.makeDirectories(joined(&path, root, "/share/applications"), 0o755)
    _ = std.fs.makeDirectories(joined(&path, root, "/home/Pictures"), 0o755)
    if !put(joined(&path, root, "/home/.local/share/applications/viewer.desktop"), "[Desktop Entry]\nType=Application\nName=Viewer\nExec=/bin/viewer --show %f\nMimeType=image/png;\n") { return 1 }
    if !put(joined(&path, root, "/share/applications/browser.desktop"), "[Desktop Entry]\nType=Application\nName=Browser\nExec=/bin/browser %U\nMimeType=text/html;image/png;\n") { return 2 }
    if !put(joined(&path, root, "/share/applications/files.desktop"), "[Desktop Entry]\nType=Application\nName=Files\nMimeType=inode/directory;\n") { return 3 }
    _ = joined(&other, root, "/written")
    var script = Bytes.init(std.heap.allocator())
    defer script.deinit()
    _ = script.appendSlice("[Desktop Entry]\nType=Application\nName=Writer\nExec=/bin/sh -c 'echo \"$0\" > ")
    _ = script.appendSlice(other.items())
    _ = script.appendSlice("'\nMimeType=text/plain;\n")
    if !put(joined(&path, root, "/share/applications/writer.desktop"), script.items()) { return 4 }
    // (mimeapps.list's default for image/png: a missing entry, then the
    // browser.)
    if !put(joined(&path, root, "/home/.config/mimeapps.list"), "[Added Associations]\nimage/png=viewer.desktop;\n[Default Applications]\nimage/png=missing.desktop;browser.desktop;\n") { return 5 }
    var environment: [4][*]const u8 = undefined
    var home = Bytes.init(std.heap.allocator())
    defer home.deinit()
    _ = home.appendSlice("HOME=")
    _ = home.appendSlice(root)
    _ = home.appendSlice("/home\x00")
    var dirs = Bytes.init(std.heap.allocator())
    defer dirs.deinit()
    _ = dirs.appendSlice("XDG_DATA_DIRS=")
    _ = dirs.appendSlice(root)
    _ = dirs.appendSlice("/share\x00")
    environment[0] = home.items().pointer
    environment[1] = dirs.items().pointer
    environment[2] = "PATH=/usr/bin:/bin\x00".pointer
    environment[3] = unsafe { @ptrFromInt([*]const u8, 0) }
    const env: [*][*]const u8 = &environment
    // Types.
    if !std.text.same(open.mimeTypeOf("/x/report.PDF"), "application/pdf") || !std.text.same(open.mimeTypeOf(joined(&path, root, "/home/Pictures")), "inode/directory") { return 6 }
    // Defaults.
    var id = Bytes.init(std.heap.allocator())
    defer id.deinit()
    if !open.defaultApplication(env, "image/png", &id) || !std.text.same(id.items(), "browser.desktop") { return 7 }
    if !open.defaultApplication(env, "inode/directory", &id) || !std.text.same(id.items(), "files.desktop") { return 8 }
    if !open.defaultApplication(env, "text/html", &id) || !std.text.same(id.items(), "browser.desktop") { return 9 }
    if open.defaultApplication(env, "audio/ogg", &id) { return 10 }
    // Commands.
    if !open.command(env, "viewer.desktop", "/tmp/a b's.png", &made) || !std.text.same(made.items(), "exec /bin/viewer --show '/tmp/a b'\\''s.png'\x00") { return 11 }
    if !open.command(env, "browser.desktop", "/tmp/a b.html", &made) || !std.text.same(made.items(), "exec /bin/browser 'file:///tmp/a%20b.html'\x00") { return 12 }
    if open.command(env, "files.desktop", "/tmp", &made) { return 14 }
    // A file opened: the writer's command runs and writes its path.
    const target = joined(&path, root, "/note.txt")
    if !put(target, "a note\n") { return 15 }
    var targetCopy = Bytes.init(std.heap.allocator())
    defer targetCopy.deinit()
    _ = targetCopy.appendSlice(target)
    if !open.open(env, targetCopy.items()) { return 16 }
    var waited: usize = 0
    var text: [512]u8 = undefined
    _ = other.append(0)
    while waited < 300 {
        const got = std.fs.readFile(other.items().pointer, &text, 512)
        if got > 0 {
            var expected = Bytes.init(std.heap.allocator())
            defer expected.deinit()
            _ = expected.appendSlice(targetCopy.items())
            _ = expected.append(10)
            return if std.text.same(text[0..got], expected.items()) { 13 } else { 18 }
        }
        _ = std.time.sleepNanoseconds(10000000)
        waited += 1
    }
    return 17
}

pub fn main() -> u8 {
    var rootBytes: [128]u8 = undefined
    const root_bytes: [*]u8 = &rootBytes
    var length = std.text.append(root_bytes, 0, 128, "/tmp/mlx-test-411-")
    length = std.text.appendUnsigned(root_bytes, length, 128, @intCast(usize, std.linux.syscall0(39)))
    root_bytes[length] = 0
    if std.fs.exists(root_bytes) { _ = std.fs.removeTree(root_bytes) }
    const result = check(root_bytes[0..length])
    _ = std.fs.removeTree(root_bytes)
    return result
}
