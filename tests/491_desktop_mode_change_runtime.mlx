// The desktop laid out anew when the display's mode changes while the
// compositor runs (projects/desktop/compositor/output_size.mlx), and the
// question whether to keep the mode (mode_question.mlx), on the host:
//
// - where a window goes in a work area that changed (keepInside): the
//   room beside it shared out as before, one partly off the new screen
//   brought inside it, one larger than the new screen made its size, a
//   change and its way back putting it where it was;
// - a compositor with the top bar and the dock and a window in every
//   state, from 1024x768 to 800x600, to the user's 3840x1080 and back:
//   the bar's new width and place, the dock in the middle of the bottom,
//   the work area they leave; a maximized window in it, a fullscreen one
//   on the whole output, one snapped to the left in the new left half,
//   two tiled columns as tall as the new work area, floating ones inside
//   it (one off the new screen, one larger than it, a minimized one), the
//   rectangle a maximized window goes back to inside it too;
// - the question: its card and buttons on screens small and large, the
//   seconds it counts down, what it says (English and German, rates with
//   hundredths cut as the kernel says them), Enter keeping, Escape going
//   back, other keys held from the windows, a click on a button answering
//   (press and release on the same one), a click elsewhere answering
//   nothing; a key or button held since before it came up let go to the
//   windows (a window's move ends), the release of one it took its own
//   even once it is gone; drawn on the CPU: the screen dimmed around it, the card in
//   its colour, the Keep button in the accent. Exits 13.
const std = @import("std")
const ui = @import("std.ui")
const state = @import("../projects/desktop/compositor/state.mlx")
const scene = @import("../projects/desktop/compositor/scene.mlx")
const protocols = @import("../projects/desktop/compositor/protocols.mlx")
const windows = @import("../projects/desktop/compositor/windows.mlx")
const output_size = @import("../projects/desktop/compositor/output_size.mlx")
const question = @import("../projects/desktop/compositor/mode_question.mlx")

const Compositor = state.Compositor
const Surface = state.Surface

// evdev's codes of the pointer's left and right buttons.
const LEFT: u32 = 272
const RIGHT: u32 = 273

fn zeroed(compositor: *Compositor, size: usize) -> [*]u8 {
    const memory = state.allocate(compositor, size)
    std.mem.set(memory, 0, size)
    return memory
}

fn setTitle(surface: *Surface, title: []const u8) -> void {
    var index: usize = 0
    while index < title.length {
        surface.*.title[index] = title[index]
        index += 1
    }
    surface.*.titleLength = title.length
}

fn add(compositor: *Compositor, surface: *Surface) -> void {
    compositor.*.surfaces = state.listAppend(compositor.*.surfaces, @intFromPtr(surface))
    compositor.*.stack = state.listAppend(compositor.*.stack, @intFromPtr(surface))
}

// A window as a client would have it (no xdg_surface here: what it is
// told goes nowhere, what it is told to be stays in the record).
fn window(compositor: *Compositor, title: []const u8, x: i32, y: i32, width: usize, height: usize) -> *Surface {
    const surface: *Surface = unsafe { @ptrCast(*Surface, zeroed(compositor, @sizeOf(Surface))) }
    surface.*.compositor = compositor
    surface.*.role = state.ROLE_TOPLEVEL
    surface.*.hasToplevel = true
    surface.*.mapped = true
    surface.*.hasContent = true
    surface.*.x = x
    surface.*.y = y
    surface.*.pixelWidth = width
    surface.*.pixelHeight = height
    surface.*.children = state.newList(compositor.*.allocator)
    setTitle(surface, title)
    add(compositor, surface)
    return surface
}

// A layer surface (a panel) mapped at the size it was configured to.
fn layer(compositor: *Compositor, title: []const u8, anchor: u32, width: u32, height: u32, exclusive: i32, margin: i32) -> *Surface {
    const surface: *Surface = unsafe { @ptrCast(*Surface, zeroed(compositor, @sizeOf(Surface))) }
    surface.*.compositor = compositor
    surface.*.role = state.ROLE_LAYER
    surface.*.hasLayerSurface = true
    surface.*.mapped = true
    surface.*.hasContent = true
    surface.*.anchor = anchor
    surface.*.layerWidth = width
    surface.*.layerHeight = height
    surface.*.exclusiveZone = exclusive
    surface.*.marginBottom = margin
    surface.*.layer = 2
    surface.*.children = state.newList(compositor.*.allocator)
    setTitle(surface, title)
    commitLayer(surface)
    add(compositor, surface)
    return surface
}

// The panel's client takes the size it was told and commits it.
fn commitLayer(surface: *Surface) -> void {
    surface.*.pixelWidth = @intCast(usize, protocols.layerWantedWidth(surface))
    surface.*.pixelHeight = @intCast(usize, protocols.layerWantedHeight(surface))
    protocols.placeLayer(surface)
}

// The output becomes `width` by `height`; the panels' clients commit what
// they were told, as theirs do. Before they do, what the compositor did by
// itself is looked at: the dock (its size stays) placed in the middle of
// the new bottom, the work area counted from the new size, the maximized
// window (`maximized`, when there is one) told it (0, or what is wrong).
fn resize(compositor: *Compositor, bar: *Surface, dock: *Surface, maximized: ?*Surface, width: usize, height: usize) -> u8 {
    const oldWidth = compositor.*.width
    const oldHeight = compositor.*.height
    compositor.*.width = width
    compositor.*.height = height
    output_size.resized(compositor, oldWidth, oldHeight)
    if dock.*.x != (@intCast(i32, width) - 317) / 2 || dock.*.y != @intCast(i32, height) - 150 - 8 { return 1 }
    const area = scene.workArea(compositor)
    if area.x != 0 || area.y != 30 || area.width != @intCast(i32, width) || area.height != @intCast(i32, height) - 30 - 72 { return 2 }
    if maximized != null && maximized.?.*.configuredWidth != area.width - 4 { return 3 }
    commitLayer(bar)
    commitLayer(dock)
    protocols.updateReserves(compositor)
    return 0
}

// The window's outer rectangle (frame and title bar with it) inside the
// work area.
fn inside(compositor: *Compositor, surface: *Surface) -> bool {
    const area = scene.workArea(compositor)
    const frame = scene.frameWidth(surface)
    const title = scene.titleHeight(surface)
    const left = scene.windowX(surface) - frame
    const top = scene.windowY(surface) - frame - title
    const width = scene.windowWidth(surface) + 2 * frame
    const height = scene.windowHeight(surface) + 2 * frame + title
    return left >= area.x && top >= area.y && left + width <= area.x + area.width && top + height <= area.y + area.height
}

// A floating window's client takes the size it was told (when it was).
fn commitWindow(surface: *Surface) -> void {
    if surface.*.configuredWidth > 0 { surface.*.pixelWidth = @intCast(usize, surface.*.configuredWidth) }
    if surface.*.configuredHeight > 0 { surface.*.pixelHeight = @intCast(usize, surface.*.configuredHeight) }
}

fn layout() -> u8 {
    var compositor: Compositor = undefined
    unsafe { std.mem.set(@ptrCast([*]u8, &compositor), 0, @sizeOf(Compositor)) }
    compositor.allocator = std.page_allocator.init()
    compositor.width = 1024
    compositor.height = 768
    compositor.titleBars = true
    compositor.animations = false
    compositor.verbose = false
    compositor.surfaces = state.newList(compositor.allocator)
    compositor.stack = state.newList(compositor.allocator)
    compositor.blurred = state.newList(compositor.allocator)
    compositor.toplevelHandles = state.newList(compositor.allocator)
    compositor.extHandles = state.newList(compositor.allocator)
    compositor.outputs = state.newList(compositor.allocator)
    var workspace: usize = 0
    while workspace < state.MAX_WORKSPACES {
        compositor.columns[workspace] = state.newList(compositor.allocator)
        workspace += 1
    }

    // The top bar across the top (30 high, reserving its height) and the
    // dock in the middle of the bottom (317x150, reserving 64 and its
    // margin of 8), as horizon and orbit ask.
    const bar = layer(&compositor, "horizon", state.ANCHOR_TOP | state.ANCHOR_LEFT | state.ANCHOR_RIGHT, 0, 30, 30, 0)
    const dock = layer(&compositor, "orbit", state.ANCHOR_BOTTOM, 317, 150, 64, 8)
    protocols.updateReserves(&compositor)
    var area = scene.workArea(&compositor)
    if bar.*.pixelWidth != 1024 || bar.*.x != 0 || bar.*.y != 0 { return 20 }
    if dock.*.x != (1024 - 317) / 2 || dock.*.y != 768 - 150 - 8 { return 21 }
    if area.x != 0 || area.y != 30 || area.width != 1024 || area.height != 768 - 30 - 72 { return 22 }

    // A window in every state.
    const maximized = window(&compositor, "maximized", 40, 60, 500, 300)
    windows.setMaximized(maximized, true)
    commitWindow(maximized)
    windows.pinState(maximized)
    const full = window(&compositor, "fullscreen", 100, 100, 400, 300)
    windows.setFullscreen(full, true)
    commitWindow(full)
    windows.pinState(full)
    const snapped = window(&compositor, "snapped", 300, 200, 400, 300)
    windows.snapTo(snapped, state.SNAP_LEFT)
    commitWindow(snapped)
    // Two columns on workspace 2, which tiles.
    compositor.workspaceTiling[1] = true
    const first = window(&compositor, "first column", 0, 0, 300, 300)
    const second = window(&compositor, "second column", 0, 0, 300, 300)
    first.*.workspace = 1
    second.*.workspace = 1
    first.*.tiled = true
    second.*.tiled = true
    compositor.columns[1] = state.listAppend(compositor.columns[1], @intFromPtr(first))
    compositor.columns[1] = state.listAppend(compositor.columns[1], @intFromPtr(second))
    protocols.updateReserves(&compositor)
    commitWindow(first)
    commitWindow(second)
    // Floating: one at the bottom right (partly off an 800x600 screen),
    // one larger than an 800x600 screen, one minimized far right.
    const corner = window(&compositor, "corner", 700, 450, 300, 200)
    const large = window(&compositor, "large", 20, 60, 900, 560)
    const hidden = window(&compositor, "minimized", 880, 500, 120, 100)
    hidden.*.minimized = true
    if !inside(&compositor, corner) || !inside(&compositor, large) || !inside(&compositor, hidden) { return 23 }
    const cornerX = scene.windowX(corner)
    const cornerY = scene.windowY(corner)
    const restoreX = maximized.*.restoreX
    const restoreY = maximized.*.restoreY
    if !maximized.*.hasRestore || restoreX != 40 || restoreY != 60 { return 24 }

    // ---- 1024x768 to 800x600 ----
    if resize(&compositor, bar, dock, maximized, 800, 600) != 0 { return 25 }
    area = scene.workArea(&compositor)
    if protocols.layerWantedWidth(bar) != 800 || bar.*.pixelWidth != 800 || bar.*.x != 0 || bar.*.y != 0 { return 30 }
    if dock.*.pixelWidth != 317 || dock.*.x != (800 - 317) / 2 || dock.*.y != 600 - 150 - 8 { return 31 }
    if area.x != 0 || area.y != 30 || area.width != 800 || area.height != 600 - 30 - 72 { return 32 }
    // Maximized: the new work area inside its frame and title bar.
    if maximized.*.configuredWidth != area.width - 4 || maximized.*.configuredHeight != area.height - 4 - scene.TITLE_HEIGHT { return 33 }
    if scene.windowX(maximized) != area.x + 2 || scene.windowY(maximized) != area.y + 2 + scene.TITLE_HEIGHT { return 34 }
    // ... and the rectangle it goes back to inside the new area.
    if maximized.*.restoreX < area.x || maximized.*.restoreY < area.y || maximized.*.restoreX + maximized.*.restoreWidth > area.x + area.width { return 35 }
    // Fullscreen: the whole output.
    if full.*.configuredWidth != 800 || full.*.configuredHeight != 600 || scene.windowX(full) != 0 || scene.windowY(full) != 0 { return 36 }
    // Snapped to the left: the new left half.
    const half = scene.snapRect(&compositor, state.SNAP_LEFT)
    if half.width != 400 || snapped.*.configuredWidth != half.width - 4 || snapped.*.configuredHeight != half.height - 4 - scene.TITLE_HEIGHT { return 37 }
    if scene.windowX(snapped) != half.x + 2 || scene.windowY(snapped) != half.y + 2 + scene.TITLE_HEIGHT { return 38 }
    // The columns as tall as the new work area, side by side in it.
    const columnHeight = area.height - 16 - 4 - scene.TITLE_HEIGHT
    if first.*.configuredHeight != columnHeight || second.*.configuredHeight != columnHeight { return 39 }
    if scene.windowY(first) != area.y + 8 + 2 + scene.TITLE_HEIGHT || scene.windowX(second) <= scene.windowX(first) { return 40 }
    // Floating ones: inside; the large one asked for the size that fits.
    commitWindow(large)
    if !inside(&compositor, corner) || !inside(&compositor, large) || !inside(&compositor, hidden) { return 41 }
    if large.*.configuredWidth != area.width - 4 || large.*.configuredHeight != area.height - 4 - scene.TITLE_HEIGHT { return 42 }
    if scene.windowWidth(corner) != 300 || scene.windowHeight(corner) != 200 { return 43 }

    // ---- to the user's monitor, 3840x1080 ----
    if resize(&compositor, bar, dock, maximized, 3840, 1080) != 0 { return 45 }
    area = scene.workArea(&compositor)
    if bar.*.pixelWidth != 3840 || dock.*.x != (3840 - 317) / 2 || dock.*.y != 1080 - 158 { return 50 }
    if maximized.*.configuredWidth != 3840 - 4 || full.*.configuredWidth != 3840 || full.*.configuredHeight != 1080 { return 51 }
    if snapped.*.configuredWidth != 1920 - 4 { return 52 }
    if first.*.configuredHeight != area.height - 16 - 4 - scene.TITLE_HEIGHT { return 53 }
    if !inside(&compositor, corner) || !inside(&compositor, large) || !inside(&compositor, hidden) { return 54 }

    // ---- and back to 1024x768: the corner window where it was ----
    if resize(&compositor, bar, dock, maximized, 1024, 768) != 0 { return 55 }
    if !inside(&compositor, corner) || !inside(&compositor, hidden) { return 60 }
    const dx = scene.windowX(corner) - cornerX
    const dy = scene.windowY(corner) - cornerY
    if dx < -2 || dx > 2 || dy < -2 || dy > 2 { return 61 }
    if bar.*.pixelWidth != 1024 || maximized.*.configuredWidth != 1024 - 4 || full.*.configuredWidth != 1024 { return 62 }
    windows.setMaximized(maximized, false)
    if scene.windowX(maximized) < 0 || maximized.*.configuredWidth > 1024 { return 63 }
    return 0
}

fn places() -> u8 {
    // The room beside a window shared out as before: a third of it on the
    // left stays a third.
    var placed = output_size.keepInside(ui.rect(100, 30, 400, 300), ui.rect(0, 30, 700, 600), ui.rect(0, 30, 1300, 900))
    if placed.x != 300 || placed.y != 30 + 300 * 0 || placed.width != 400 || placed.height != 300 { return 1 }
    placed = output_size.keepInside(ui.rect(100, 330, 400, 300), ui.rect(0, 30, 700, 600), ui.rect(0, 30, 1300, 900))
    if placed.y != 30 + 600 { return 2 }
    // Partly off the new screen: inside it.
    placed = output_size.keepInside(ui.rect(900, 600, 300, 200), ui.rect(0, 0, 1280, 800), ui.rect(0, 0, 800, 600))
    if placed.x < 0 || placed.x + placed.width > 800 || placed.y + placed.height > 600 { return 3 }
    // Off the old screen already: brought inside.
    placed = output_size.keepInside(ui.rect(-50, -20, 300, 200), ui.rect(0, 0, 1280, 800), ui.rect(0, 0, 1280, 800))
    if placed.x != 0 || placed.y != 0 { return 4 }
    // Larger than the new area: its size.
    placed = output_size.keepInside(ui.rect(10, 10, 1000, 700), ui.rect(0, 0, 1280, 800), ui.rect(0, 30, 800, 500))
    if placed.x != 0 || placed.y != 30 || placed.width != 800 || placed.height != 500 { return 5 }
    // There and back: where it was.
    var k: i32 = 0
    while k < 50 {
        const start = ui.rect(k * 13, k * 7 + 30, 320, 240)
        const before = ui.rect(0, 30, 1024, 666)
        const after = ui.rect(0, 30, 3840, 978)
        const there = output_size.keepInside(start, before, after)
        const back = output_size.keepInside(there, after, before)
        if back.x - start.x > 1 || start.x - back.x > 1 || back.y - start.y > 1 || start.y - back.y > 1 { return 6 }
        k += 1
    }
    return 0
}

fn sameText(bytes: [*]const u8, length: usize, text: []const u8) -> bool { return std.text.same(bytes[0..length], text) }

fn asking() -> u8 {
    var compositor: Compositor = undefined
    unsafe { std.mem.set(@ptrCast([*]u8, &compositor), 0, @sizeOf(Compositor)) }
    compositor.allocator = std.page_allocator.init()
    compositor.width = 1920
    compositor.height = 1080
    compositor.blurred = state.newList(compositor.allocator)
    compositor.hasText = false
    compositor.scheme.accent = 0x5AA0FF

    // The card and its buttons, on screens small and large.
    const sizes = [4][2]usize{ [2]usize{ 640, 480 }, [2]usize{ 800, 600 }, [2]usize{ 1920, 1080 }, [2]usize{ 3840, 1080 } }
    var k: usize = 0
    while k < 4 {
        const w = sizes[k][0]
        const h = sizes[k][1]
        const card = question.card(w, h)
        const keep = question.keepButton(w, h)
        const back = question.backButton(w, h)
        if card.x < 0 || card.y < 0 || card.x + card.width > @intCast(i32, w) || card.y + card.height > @intCast(i32, h) { return 1 }
        if (@intCast(i32, w) - card.width) / 2 != card.x { return 2 }
        if keep.x < card.x || keep.x + keep.width > card.x + card.width || keep.y + keep.height > card.y + card.height { return 3 }
        if back.x + back.width >= keep.x || back.x < card.x || back.y != keep.y { return 4 }
        if question.buttonAt(w, h, keep.x + 5, keep.y + 5) != state.QUESTION_KEEP || question.buttonAt(w, h, back.x + 5, back.y + 5) != state.QUESTION_BACK { return 5 }
        if question.buttonAt(w, h, card.x + 5, card.y + 5) != 0 || question.buttonAt(w, h, 0, 0) != 0 { return 6 }
        k += 1
    }

    // The seconds counted up: 15 at once, 12 while between 11 and 12 are
    // left, 1 in the last, 0 once the time has come.
    if question.secondsLeft(15000000, 0) != 15 || question.secondsLeft(15000000, 3500000) != 12 || question.secondsLeft(15000000, 14999999) != 1 || question.secondsLeft(15000000, 15000000) != 0 || question.secondsLeft(15000000, 99000000) != 0 { return 10 }

    // What it says.
    question.show(&compositor, 1920, 1080, 60000, 15000000000, false)
    const asked = &compositor.question
    if !asked.*.shown || asked.*.seconds != 15 || asked.*.answer != 0 { return 11 }
    var text: [128]u8 = undefined
    const bytes: [*]u8 = &text
    var length = question.line(asked, 12, false, bytes)
    if !sameText(bytes, length, "1920 × 1080 at 60 Hz. It goes back in 12 s.") { return 12 }
    length = question.line(asked, 12, true, bytes)
    if !sameText(bytes, length, "1920 × 1080 mit 60 Hz. Zurück in 12 s.") { return 13 }
    asked.*.millihertz = 60316
    length = question.line(asked, 3, false, bytes)
    if !sameText(bytes, length, "1920 × 1080 at 60.31 Hz. It goes back in 3 s.") { return 14 }
    asked.*.millihertz = 59940
    length = question.line(asked, 1, false, bytes)
    if !sameText(bytes, length, "1920 × 1080 at 59.94 Hz. It goes back in 1 s.") { return 15 }
    if !std.text.same(question.heading(false), "Keep this display mode?") || !std.text.same(question.keepLabel(false), "Keep") || !std.text.same(question.backLabel(false), "Go back") { return 16 }

    // The keys: any is held from the windows; Escape goes back, Enter (and
    // the keypad's) keeps.
    if !question.key(&compositor, 30, true) || asked.*.answer != 0 { return 20 }
    if !question.key(&compositor, 1, true) || asked.*.answer != state.QUESTION_BACK { return 21 }
    asked.*.answer = 0
    // Enter held since before the question came up (the terminal where
    // `display 1280x800` was typed has its press): its release is the
    // terminal's, which repeats the key until it sees it, and it answers
    // nothing.
    if question.key(&compositor, 28, false) || asked.*.answer != 0 { return 22 }
    if !question.key(&compositor, 28, true) || asked.*.answer != state.QUESTION_KEEP { return 23 }
    asked.*.answer = 0
    if !question.key(&compositor, 96, true) || asked.*.answer != state.QUESTION_KEEP { return 24 }
    asked.*.answer = 0
    // The releases of the keys it took the press of are its own; a second
    // release of one is not.
    if !question.key(&compositor, 30, false) || !question.key(&compositor, 1, false) || !question.key(&compositor, 28, false) || !question.key(&compositor, 96, false) || asked.*.answer != 0 { return 25 }
    if question.key(&compositor, 30, false) || question.key(&compositor, 600, false) { return 26 }

    // Clicks: on Keep and let go there, keeps; on Go back, goes back;
    // pressed on one and let go on the other, nothing; elsewhere nothing,
    // but held from the windows all the same.
    const keep = question.keepButton(1920, 1080)
    const back = question.backButton(1920, 1080)
    if !question.button(&compositor, LEFT, keep.x + 3, keep.y + 3, true) || asked.*.answer != 0 { return 30 }
    if !question.button(&compositor, LEFT, keep.x + 9, keep.y + 9, false) || asked.*.answer != state.QUESTION_KEEP { return 31 }
    asked.*.answer = 0
    _ = question.button(&compositor, LEFT, back.x + 3, back.y + 3, true)
    _ = question.button(&compositor, LEFT, back.x + 3, back.y + 3, false)
    if asked.*.answer != state.QUESTION_BACK { return 32 }
    asked.*.answer = 0
    _ = question.button(&compositor, LEFT, keep.x + 3, keep.y + 3, true)
    _ = question.button(&compositor, LEFT, back.x + 3, back.y + 3, false)
    if asked.*.answer != 0 { return 33 }
    if !question.button(&compositor, LEFT, 10, 10, true) || !question.button(&compositor, LEFT, 10, 10, false) || asked.*.answer != 0 { return 34 }
    // A button held since before the question came up (a window's title
    // bar pressed and dragged): its release is the windows', and the move
    // ends; no answer comes of it, even over Keep.
    const dragged: *Surface = unsafe { @ptrCast(*Surface, zeroed(&compositor, @sizeOf(Surface))) }
    dragged.*.compositor = &compositor
    compositor.moving = @intFromPtr(dragged)
    compositor.buttonsDown = 1
    if question.button(&compositor, LEFT, keep.x + 3, keep.y + 3, false) || asked.*.answer != 0 { return 36 }
    if !question.button(&compositor, LEFT, keep.x + 3, keep.y + 3, false) { windows.pointerButton(&compositor, LEFT, false) }
    if compositor.moving != 0 || compositor.buttonsDown != 0 { return 37 }
    // The pointer over a button lights it.
    question.motion(&compositor, back.x + 4, back.y + 4)
    if asked.*.hover != state.QUESTION_BACK { return 35 }

    // Drawn: the screen dimmed around the card, the card in its colour,
    // Keep in the accent.
    const size = compositor.width * compositor.height * 4
    const pixels = state.allocate(&compositor, size)
    const words: [*]u32 = unsafe { @ptrCast([*]u32, pixels) }
    var at: usize = 0
    while at < compositor.width * compositor.height {
        words[at] = 0xFFC8C8C8
        at += 1
    }
    question.draw(&compositor, pixels, ui.rect(0, 0, 1920, 1080))
    const outside = words[5 * 1920 + 5]
    if outside == 0xFFC8C8C8 || (outside & 0xFF) >= 0xC8 || (outside & 0xFF) < 0x40 { return 40 }
    const card = question.card(1920, 1080)
    const inCard = words[@intCast(usize, card.y + 60) * 1920 + @intCast(usize, card.x + 10)]
    if inCard != 0xFF202030 { return 41 }
    const onKeep = words[@intCast(usize, keep.y + keep.height / 2) * 1920 + @intCast(usize, keep.x + 4)]
    if onKeep != 0xFF5AA0FF { return 42 }

    // Hidden: keys and clicks are the windows' again; a key and a button
    // it took the press of before it went are still its own when let go.
    _ = question.key(&compositor, 57, true)
    _ = question.button(&compositor, RIGHT, 10, 10, true)
    question.hide(&compositor)
    if compositor.question.shown || question.key(&compositor, 28, true) || question.button(&compositor, LEFT, keep.x + 3, keep.y + 3, true) { return 50 }
    if !question.key(&compositor, 57, false) || !question.button(&compositor, RIGHT, 10, 10, false) || compositor.question.answer != 0 { return 51 }
    if question.key(&compositor, 28, false) || question.button(&compositor, LEFT, keep.x + 3, keep.y + 3, false) { return 52 }
    return 0
}

pub fn main() -> u8 {
    const placed = places()
    if placed != 0 { return placed }
    const laid = layout()
    if laid != 0 { return 100 + laid }
    const answered = asking()
    if answered != 0 { return 180 + answered }
    return 13
}
