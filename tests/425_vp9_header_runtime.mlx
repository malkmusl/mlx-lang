pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const made = vp9.create(allocator)
    if made == null { return 1 }
    const v = made.?
    const h = &v.*.header
    var at: usize = 32
    var frames: usize = 0
    var firstAt: usize = 0
    var firstSize: usize = 0
    var secondAt: usize = 0
    var secondSize: usize = 0
    while at + 12 <= LENGTH {
        const size = @intCast(usize, stream[at]) | (@intCast(usize, stream[at + 1]) << 8) | (@intCast(usize, stream[at + 2]) << 16)
        at += 12
        if at + size > LENGTH { return 2 }
        var sizes: [8]usize = undefined
        if vp9.superframe(&stream[at], size, &sizes) != 1 || sizes[0] != size { return 3 }
        if vp9.frame(v, &stream[at], size) != vp9.Status.ok { return 4 }
        if h.*.showExistingFrame || h.*.profile != 0 || h.*.bitDepth != 8 || !h.*.subsamplingX || !h.*.subsamplingY { return 5 }
        if h.*.width != 48 || h.*.height != 32 || h.*.miCols != 6 || h.*.miRows != 4 || h.*.sb64Cols != 1 { return 6 }
        const key = frames == 0 || frames == 4
        if key != (h.*.frameType == vp9.KEY_FRAME) { return 7 }
        if key && (h.*.refreshFrameFlags != 0xff || !h.*.pastIndependence || !h.*.resetAll) { return 8 }
        if !key {
            var k: usize = 0
            while k < 3 {
                if h.*.refFrameIdx[k] >= 8 || !v.*.slots[@intCast(usize, h.*.refFrameIdx[k])].valid { return 9 }
                k += 1
            }
        }
        if h.*.compressedSize == 0 || h.*.compressedAt + @intCast(usize, h.*.compressedSize) > size { return 10 }
        vp9.finishFrame(v)
        if frames == 0 {
            firstAt = at
            firstSize = size
            var k: usize = 0
            while k < 8 {
                if !v.*.slots[k].valid || v.*.slots[k].width != 48 || v.*.slots[k].height != 32 { return 11 }
                k += 1
            }
        }
        if frames == 1 {
            secondAt = at
            secondSize = size
        }
        frames += 1
        at += size
    }
    if frames != 6 { return 12 }
    // A superframe: the first two frames and an index of two 2-byte sizes.
    const total = firstSize + secondSize + 6
    const memory = allocator.alloc(total, 16)
    if memory == null { return 14 }
    const sf = memory.?
    var k: usize = 0
    while k < firstSize {
        sf[k] = stream[firstAt + k]
        k += 1
    }
    k = 0
    while k < secondSize {
        sf[firstSize + k] = stream[secondAt + k]
        k += 1
    }
    const marker: u8 = 0xc0 | (1 << 3) | 1
    sf[total - 6] = marker
    sf[total - 5] = @intCast(u8, firstSize & 255)
    sf[total - 4] = @intCast(u8, firstSize >> 8)
    sf[total - 3] = @intCast(u8, secondSize & 255)
    sf[total - 2] = @intCast(u8, secondSize >> 8)
    sf[total - 1] = marker
    var sizes: [8]usize = undefined
    if vp9.superframe(sf, total, &sizes) != 2 || sizes[0] != firstSize || sizes[1] != secondSize { return 15 }
    // A frame marker other than 2.
    sf[0] = 0x00
    if vp9.frame(v, sf, firstSize) == vp9.Status.ok { return 16 }
    allocator.free(sf, total, 16)
    vp9.destroy(v)
    return 13
}
