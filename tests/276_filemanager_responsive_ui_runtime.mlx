// The Files UI has one responsive layout contract for Wayland and Android:
// wide desktops keep the sidebar, compact windows hide it, phones also drop
// the list header, and Android density scales sizes without changing the
// logical breakpoint. Safe insets and list/grid item placement are shared.
// Exits 13.
const ui = @import("std.ui")
const files_ui = @import("../examples/filemanager-shared/ui.mlx")

fn same(area: ui.Rect, x: i32, y: i32, width: i32, height: i32) -> bool {
    return area.x == x && area.y == y && area.width == width && area.height == height
}

pub fn main() -> u8 {
    const wide = files_ui.layout(940, 580, ui.uniform(0), true, 1)
    if wide.mode != files_ui.Mode.wide { return 1 }
    if !same(wide.sidebar, 0, 0, 200, 580) { return 2 }
    if !same(wide.toolbar, 200, 0, 740, 52) || !same(wide.listHeader, 200, 52, 740, 28) { return 3 }
    if !same(wide.content, 200, 80, 740, 470) || !same(wide.status, 200, 550, 740, 30) { return 4 }
    if !same(wide.backButton, 212, 11, 30, 30) || !same(wide.forwardButton, 246, 11, 30, 30) { return 5 }
    if !same(wide.search, 736, 11, 190, 30) || !same(wide.gridButton, 664, 11, 30, 30) || !same(wide.listButton, 694, 11, 30, 30) { return 6 }
    if files_ui.columns(&wide) != 6 || files_ui.cellWidth(&wide) != 118 { return 7 }

    const compact = files_ui.layout(560, 340, ui.uniform(0), true, 1)
    if compact.mode != files_ui.Mode.compact || !ui.isEmpty(compact.sidebar) { return 8 }
    if !same(compact.toolbar, 0, 0, 560, 52) || !same(compact.listHeader, 0, 52, 560, 28) { return 9 }
    if !same(compact.content, 0, 80, 560, 230) || !same(compact.status, 0, 310, 560, 30) { return 10 }

    const safe = ui.insets(24, 16, 30, 16)
    const phone = files_ui.layout(360, 640, safe, true, 1)
    if phone.mode != files_ui.Mode.phone || !ui.isEmpty(phone.sidebar) || !ui.isEmpty(phone.listHeader) || !ui.isEmpty(phone.search) { return 11 }
    if !same(phone.toolbar, 16, 24, 328, 56) || !same(phone.content, 16, 80, 328, 494) || !same(phone.status, 16, 574, 328, 36) { return 12 }
    if !same(files_ui.itemRect(&phone, 2, 10, true), 16, 174, 328, 52) { return 14 }
    if files_ui.columns(&phone) != 2 || !same(files_ui.itemRect(&phone, 3, 10, false), 180, 198, 152, 116) { return 15 }

    // A 2x-density phone keeps the phone breakpoint in logical pixels while
    // all touch and content metrics are doubled.
    const dense = files_ui.layout(720, 1280, ui.insets(48, 0, 60, 0), true, 2)
    if dense.mode != files_ui.Mode.phone || dense.toolbar.height != 112 || dense.rowHeight != 104 || dense.buttonSize != 80 { return 16 }
    if !same(dense.content, 0, 160, 720, 988) || !same(dense.status, 0, 1148, 720, 72) { return 17 }

    // Even the tiny framebuffer used by the Android runtime harness must
    // yield clipped, non-negative regions instead of overlapping arithmetic.
    const tiny = files_ui.layout(48, 32, ui.insets(2, 2, 2, 2), true, 1)
    if tiny.content.width < 0 || tiny.content.height < 0 || tiny.toolbar.width < 0 || tiny.status.height < 0 { return 18 }
    if files_ui.density(1080, 2400) != 3 || files_ui.density(720, 1280) != 2 || files_ui.density(360, 640) != 1 { return 19 }
    return 13
}
