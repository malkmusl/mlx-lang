// A local non-copyable value can only be transferred with @move.
const OwnedCounter = @noncopy(struct) {
    counter: *u8

    fn deinit(self: *Self) -> void {
        self.*.counter.* += 1
    }
}

fn main() -> u8 {
    var drops: u8 = 0
    const source = OwnedCounter.{ .counter = &drops }
    const copy = source
    return drops
}
