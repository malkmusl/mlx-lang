pub fn main() u8 {
    const value: u8 = 7
    const ValueType = @typeOf(value)
    const layout = @sizeOf(ValueType) + @alignOf(u32) + @bitSizeOf(i13)
    const predicates = @isInteger(ValueType) + @isFloat(f32) + @isPointer(*u8) + @isSlice([]u8) + @isArray([3]u8) + @isOptional(?u8) + @isErrorUnion(!u8) + @isCopyable(u8)
    const casted = @intCast(u8, 7)
    return layout + predicates + casted
}
