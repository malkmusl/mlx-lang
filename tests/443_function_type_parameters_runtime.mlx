// A function type whose parameter is a function type itself (and one
// whose parameter is a tuple): the outer type's parameters stay its own,
// in their order, with the inner type's listed apart. A C++ function
// pointer taking a function pointer, as the translator writes it
// (`void (*)(const Color &, PixelWriteFunction, uint8_t *)`).
// Exits 13.
fn inner(a: ?[*]const u8, b: ?[*]u8) -> void {
    b.?[0] = a.?[0] + 1
}

fn outer(x: *u8, f: ?fn(?[*]const u8, ?[*]u8) -> void, d: ?[*]u8) -> void {
    f.?(unsafe { @ptrCast(?[*]const u8, x) }, d)
}

fn sum(pair: (u8, u8), scale: fn(u8) -> u8) -> u8 {
    return scale(pair.0) + pair.1
}

fn twice(x: u8) -> u8 { return x * 2 }

pub fn main() -> u8 {
    var source: u8 = 5
    var dest: [2]u8 = undefined
    var write: ?fn(*u8, ?fn(?[*]const u8, ?[*]u8) -> void, ?[*]u8) -> void = undefined
    write = outer
    var pixel: ?fn(?[*]const u8, ?[*]u8) -> void = inner
    write.?(&source, pixel, &dest)
    if dest[0] != 6 { return 1 }
    const add: fn((u8, u8), fn(u8) -> u8) -> u8 = sum
    const pair: (u8, u8) = .{ 2, 3 }
    if add(pair, twice) != 7 { return 2 }
    return dest[0] + add(pair, twice)
}
