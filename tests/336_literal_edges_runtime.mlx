// Integers written out at the edges of their types still compile: each
// type's least and greatest value, through a declaration, an assignment,
// an argument, a return, an optional, an error union and the fields and
// elements of literals (tests/335_type_mismatches.mlx has the ones past
// the edges). Exits 13.
const Range = struct { low: i8, high: u16 }
const Failure = error { Failed }

fn widest() -> u64 { return 18446744073709551615 }

fn lowest() -> i64 { return -9223372036854775808 }

fn maybe(present: bool) -> ?u8 {
    if present { return 255 }
    return null
}

fn checked(fail: bool) -> Failure!i16 {
    if fail { return Failure.Failed }
    return -32768
}

fn least16() -> Failure!i16 {
    const value = try checked(false)
    if value != -32768 { return Failure.Failed }
    return value
}

fn halve(value: u32) -> u32 { return value / 2 }

pub fn main() -> u8 {
    var byte: u8 = 0
    byte = 255
    const least: i8 = -128
    const most: i32 = 2147483647
    const range = Range.{ .low = -128, .high = 65535 }
    const row = [3]i16{ -32768, 0, 32767 }
    var wide = widest()
    wide = wide - 18446744073709551614
    if byte != 255 || least != -128 || most != 2147483647 { return 1 }
    if range.low != -128 || range.high != 65535 { return 2 }
    if row[0] != -32768 || row[2] != 32767 { return 3 }
    if wide != 1 || lowest() != -9223372036854775808 { return 4 }
    if maybe(true).? != 255 || maybe(false) != null { return 5 }
    const signed = least16()
    if halve(4294967295) != 2147483647 { return 7 }
    return 13
}

test "the error union's least value" {
    const value = try least16()
}
