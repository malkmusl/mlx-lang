// A struct's own constants name the lengths of its array fields:
// `pub const MAX: usize = 4` and `entries: [MAX]Entry` in the same struct
// (also as `Self.MAX`, by the struct's name, through another constant of
// it, and a struct's constant in another module as `module.Type.NAME`),
// and of the locals of its functions (`var values: [MAX]usize`, which
// the lowering once left without a size: every element at one place). They are evaluated ahead of the fields when they are known
// without the struct's layout. Exits 13 when the layout and the values
// are right.
const limits = @import("./support/aggregate_constants.mlx")

pub const Entry = struct {
    kind: u8
    offset: usize

    pub fn isOpen(self: *const Self) -> bool { return self.*.kind != 0 }
}

pub const Table = struct {
    pub const MAX: usize = 4
    pub const NAME_LENGTH = MAX * 4
    entries: [MAX]Entry
    names: [Self.NAME_LENGTH]u8
    spare: [Table.MAX]u16
    other: [limits.Limits.COUNT]u8
    count: usize

    // MAX values in a local array of MAX elements.
    pub fn spread(base: usize) -> usize {
        var values: [MAX]usize = undefined
        var k: usize = 0
        while k < MAX {
            values[k] = base + k
            k += 1
        }
        return values[0] + values[MAX - 1] * 100
    }

    pub fn open(self: *Self, kind: u8) -> usize {
        var k: usize = 0
        while k < MAX {
            if !self.*.entries[k].isOpen() {
                self.*.entries[k].kind = kind
                self.*.count += 1
                return k
            }
            k += 1
        }
        return MAX
    }
}

var table: Table = undefined // (per run)

pub fn main() -> u8 {
    var k: usize = 0
    while k < Table.MAX {
        table.entries[k] = Entry.{ .kind = 0, .offset = 0 }
        k += 1
    }
    table.count = 0
    var opened: usize = 0
    while table.open(1) != Table.MAX { opened += 1 }
    if opened != 4 || table.count != 4 { return 1 }
    if @sizeOf(Table) != 4 * 16 + 16 + 8 + 8 + 8 { return 2 }
    if Table.NAME_LENGTH != 16 { return 3 }
    if Table.spread(1) != 401 { return 4 }
    return 13
}
