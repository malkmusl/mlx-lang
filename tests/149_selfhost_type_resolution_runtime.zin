const lexer = @import("../compiler/selfhost/lexer.zin")
const parser_module = @import("../compiler/selfhost/parser.zin")
const types = @import("../compiler/selfhost/types.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")

pub fn main() -> u8 {
    const source = "const scalar: i13 = 0\nconst pointer: *const u8 = undefined\nconst array: [0x10]u16 = undefined\nconst callable: fn(u8, ?*u8) -> (u16, f64) = undefined\nconst owned: @nocopy(struct) { value: u8 } = undefined\n"
    const allocator = page_allocator.init()
    const tokens = lexer.scanAll(allocator, source)
    var nodes = parser_module.initStore(allocator, tokens.length * 2)
    var parser = parser_module.init(source, tokens, &nodes)
    const root_index = parser_module.parse(&parser)
    if parser.errorCount != 0 { return 1 }
    var store = types.init(allocator)
    var declaration = parser_module.nodeAt(&nodes, root_index).lhs

    const scalar_node = parser_module.nodeAt(&nodes, declaration)
    const scalar = types.resolve(source, tokens, &nodes, &store, scalar_node.lhs)
    if types.get(&store, scalar).*.kind != types.Kind.integer || types.get(&store, scalar).*.bits != 13 { return 2 }
    if types.get(&store, scalar).*.flags & types.FLAG_SIGNED == 0 { return 3 }

    declaration = scalar_node.next
    const pointer_node = parser_module.nodeAt(&nodes, declaration)
    const pointer = types.resolve(source, tokens, &nodes, &store, pointer_node.lhs)
    if types.get(&store, pointer).*.kind != types.Kind.pointer { return 4 }
    if types.get(&store, pointer).*.flags & types.FLAG_CONSTANT == 0 { return 5 }

    declaration = pointer_node.next
    const array_node = parser_module.nodeAt(&nodes, declaration)
    const array = types.resolve(source, tokens, &nodes, &store, array_node.lhs)
    if types.get(&store, array).*.kind != types.Kind.array || types.get(&store, array).*.bits != 16 { return 6 }

    declaration = array_node.next
    const callable_node = parser_module.nodeAt(&nodes, declaration)
    const callable = types.resolve(source, tokens, &nodes, &store, callable_node.lhs)
    if types.resolve(source, tokens, &nodes, &store, callable_node.lhs) != callable { return 10 }
    const function_value = types.get(&store, callable)
    if function_value.*.kind != types.Kind.function || function_value.*.extraLength != 2 { return 7 }
    const result = types.get(&store, function_value.*.lhs)
    if result.*.kind != types.Kind.tuple || result.*.extraLength != 2 { return 8 }

    declaration = callable_node.next
    const owned_node = parser_module.nodeAt(&nodes, declaration)
    const owned = types.resolve(source, tokens, &nodes, &store, owned_node.lhs)
    if types.get(&store, owned).*.copyability != types.Copyability.explicit_nocopy { return 9 }

    types.deinit(&store)
    parser_module.deinitStore(&nodes)
    lexer.deinit(tokens)
    return 13
}
