const Mode = enum(u8) {
    idle
    active
}

const Value = union {
    byte: u8
    word: u32
}

const OwnedMode = @nocopy(enum(u8)) {
    idle
    active
}

pub fn main() u8 {
    const layout = @sizeOf(Mode) + @sizeOf(Value) + @sizeOf(@fieldType(Value, "word"))
    const traits = @isEnum(Mode) + @isUnion(Value) + @fieldCount(Mode) + @fieldCount(Value) + @isCopyable(OwnedMode)
    return layout + traits
}
