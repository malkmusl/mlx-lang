// std.ui.chooser without a window: a folder of the test's own (a
// temporary one) with folders and files; the places of a home of its own
// (Home, the user's folders that exist, "/"); the path field showing
// the folder; Tab completing a name as far as the entries agree, a
// folder's whole with its slash; Enter going to a folder typed, and
// choosing a file typed (chosen, CHOSEN pending); "~" over the list
// starting a path in the field; the folder chosen in kept for the app and
// started in the next time; std.ui.glyphs' kinds of files by MIME type
// and name. Exits 13 when every check holds, else the
// number of the first check that failed.
const std = @import("std")
const chooser = @import("std.ui.chooser")
const field = @import("std.ui.field")
const glyphs = @import("std.ui.glyphs")

const Bytes = std.ArrayList(u8)

fn joined(into: *Bytes, a: []const u8, b: []const u8) -> []const u8 {
    into.clearRetainingCapacity()
    _ = into.appendSlice(a)
    _ = into.appendSlice(b)
    return into.items()
}

fn touch(path: []const u8) -> bool {
    var name = Bytes.init(std.heap.allocator())
    defer name.deinit()
    if !name.appendSlice(path) || !name.append(0) { return false }
    const file = std.fs.open(name.items().pointer, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 0o644)
    if !std.fs.isValid(file) { return false }
    _ = std.fs.close(file)
    return true
}

// Types TEXT into the chooser, a key a byte (the path field has the keys).
fn type_(files: *chooser.Chooser, text: []const u8) -> void {
    var index: usize = 0
    while index < text.length {
        _ = chooser.keyTyped(files, 30, 0, text[index..index + 1])
        index += 1
    }
}

fn check(root: []const u8) -> u8 {
    var path = Bytes.init(std.heap.allocator())
    defer path.deinit()
    _ = std.fs.makeDirectories(joined(&path, root, "/home/Downloads"), 0o755)
    _ = std.fs.makeDirectories(joined(&path, root, "/home/Music"), 0o755)
    _ = std.fs.makeDirectories(joined(&path, root, "/home/projects/alpha"), 0o755)
    _ = std.fs.makeDirectories(joined(&path, root, "/home/state"), 0o755)
    if !touch(joined(&path, root, "/home/projects/report-2025.txt")) || !touch(joined(&path, root, "/home/projects/report-2026.txt")) || !touch(joined(&path, root, "/home/projects/alpha/notes.md")) { return 1 }
    var homeVariable = Bytes.init(std.heap.allocator())
    defer homeVariable.deinit()
    _ = homeVariable.appendSlice("HOME=")
    _ = homeVariable.appendSlice(root)
    _ = homeVariable.appendSlice("/home\x00")
    var stateVariable = Bytes.init(std.heap.allocator())
    defer stateVariable.deinit()
    _ = stateVariable.appendSlice("XDG_STATE_HOME=")
    _ = stateVariable.appendSlice(root)
    _ = stateVariable.appendSlice("/home/state\x00")
    var environment: [3][*]const u8 = undefined
    environment[0] = homeVariable.items().pointer
    environment[1] = stateVariable.items().pointer
    environment[2] = unsafe { @ptrFromInt([*]const u8, 0) }
    const env: [*][*]const u8 = &environment
    var home = Bytes.init(std.heap.allocator())
    defer home.deinit()
    _ = home.appendSlice(root)
    _ = home.appendSlice("/home")
    var files = chooser.Chooser.init()
    defer files.deinit()
    chooser.startFor(&files, env, "org.mlx.test", home.items(), false, "")
    // The places: Home, Downloads, Music (no Desktop, ...), "/".
    if files.places.count() != 4 { return 2 }
    var names = Bytes.init(std.heap.allocator())
    defer names.deinit()
    if !std.text.same(chooser.folder(&files), home.items()) { return 3 }
    // The path field shows the folder with a slash.
    var expected = Bytes.init(std.heap.allocator())
    defer expected.deinit()
    if !std.text.same(field.text(&files.location), joined(&expected, home.items(), "/")) { return 4 }
    // Typing in the field (as if it had the keys): "pro" Tab completes to
    // "projects/", "rep" Tab to "report-202", then "6.txt" Enter chooses.
    files.editing = true
    field.set(&files.location, "pro")
    _ = chooser.keyTyped(&files, chooser.KEY_TAB, 0, "")
    if !std.text.same(field.text(&files.location), "projects/") { return 5 }
    _ = chooser.keyTyped(&files, chooser.KEY_ENTER, 0, "")
    if !std.text.same(chooser.folder(&files), joined(&expected, home.items(), "/projects")) { return 6 }
    files.editing = true
    field.set(&files.location, "rep")
    _ = chooser.keyTyped(&files, chooser.KEY_TAB, 0, "")
    if !std.text.same(field.text(&files.location), "report-202") { return 7 }
    type_(&files, "6.txt")
    if !std.text.same(field.text(&files.location), "report-2026.txt") { return 8 }
    _ = chooser.keyTyped(&files, chooser.KEY_ENTER, 0, "")
    var chosen = Bytes.init(std.heap.allocator())
    defer chosen.deinit()
    chooser.paths(&files, &chosen)
    if !std.text.same(chosen.items(), joined(&expected, home.items(), "/projects/report-2026.txt\n")) { return 9 }
    if files.pending != chooser.CHOSEN { return 10 }
    // "~" over the list starts a path in the field; an absolute folder
    // typed is gone to.
    files.editing = false
    _ = chooser.keyTyped(&files, 41, 0, "~")
    if !files.editing || !std.text.same(field.text(&files.location), "~") { return 11 }
    type_(&files, "/Music")
    _ = chooser.keyTyped(&files, chooser.KEY_ENTER, 0, "")
    if !std.text.same(chooser.folder(&files), joined(&expected, home.items(), "/Music")) { return 12 }
    // The folder chosen in, kept: the next start is there.
    var other = chooser.Chooser.init()
    defer other.deinit()
    chooser.startFor(&other, env, "org.mlx.test", home.items(), false, "")
    if !std.text.same(chooser.folder(&other), joined(&expected, home.items(), "/projects")) { return 14 }
    // Another app's starts in the folder given.
    chooser.startFor(&other, env, "org.mlx.other", home.items(), false, "")
    if !std.text.same(chooser.folder(&other), home.items()) { return 15 }
    // Files' kinds.
    if glyphs.fileKind("a.bin", "image/png") != glyphs.FILE_IMAGE || glyphs.fileKind("photo.JPG", "") != glyphs.FILE_IMAGE || glyphs.fileKind("x.tar.gz", "") != glyphs.FILE_ARCHIVE { return 16 }
    if glyphs.fileKind("paper.pdf", "") != glyphs.FILE_DOCUMENT || glyphs.fileKind("notes.txt", "") != glyphs.FILE_TEXT || glyphs.fileKind("main.mlx", "") != glyphs.FILE_CODE || glyphs.fileKind("data", "application/octet-stream") != glyphs.FILE_GENERIC { return 17 }
    if glyphs.fileKind("song", "audio/ogg") != glyphs.FILE_AUDIO || glyphs.fileKind("clip.webm", "") != glyphs.FILE_VIDEO || glyphs.fileKind("Pictures", "inode/directory") != glyphs.FILE_FOLDER { return 18 }
    return 13
}

pub fn main() -> u8 {
    var rootBytes: [128]u8 = undefined
    const root_bytes: [*]u8 = &rootBytes
    var length = std.text.append(root_bytes, 0, 128, "/tmp/mlx-test-412-")
    length = std.text.appendUnsigned(root_bytes, length, 128, @intCast(usize, std.linux.syscall0(39)))
    root_bytes[length] = 0
    if std.fs.exists(root_bytes) { _ = std.fs.removeTree(root_bytes) }
    const result = check(root_bytes[0..length])
    _ = std.fs.removeTree(root_bytes)
    return result
}
