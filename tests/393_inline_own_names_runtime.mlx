// An inlined function reads its own module's variables, whatever the
// caller's locals are named: the caller here has locals named `dirs`,
// `scale`, `count` and `index`, as the variables and parameters of the
// functions it calls (tests/support/inline_names.mlx), which are inlined
// (small, or marked `inline`) at every level. The inliner once read the
// caller's local instead (mlx-cc's prefix snapshot found it: a local
// `dirs` read in place of paths.mlx's `dirs`). Exits 13 when every value
// is the callee's.
const names = @import("./support/inline_names.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    const dirs = arguments.length + 100
    const scale: u32 = 1000
    var count: u32 = 5
    var index: usize = 2
    if names.get(0) != 7 { return 1 }
    if names.get(index) != 9 { return 2 }
    if names.scaled(2) != 6 { return 3 }
    if names.twice(1) != 16 { return 4 }
    if names.counted() != 40 { return 5 }
    // (The locals still the caller's.)
    count += 1
    index += 1
    if dirs != arguments.length + 100 || scale != 1000 || count != 6 || index != 3 { return 6 }
    return 13
}
