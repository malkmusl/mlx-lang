// std.json pull tokenizer: objects, arrays, keys, literals, numbers, string
// escapes (including surrogate pairs), skipValue, integer parsing and
// grammar errors. Exits 13.
const json = @import("std.json")

fn check(tokenizer: *json.Tokenizer, token: *json.Token, kind: json.TokenKind) -> bool {
    const more = json.next(tokenizer, token)
    return token.*.kind == kind
}

fn lengthOf(value: []const u8) -> usize {
    var length: usize = 0
    for byte in value { length += 1 }
    return length
}

fn start(tokenizer: *json.Tokenizer, source: []const u8) -> void {
    unsafe { json.initAt(tokenizer, @ptrCast([*]const u8, source), lengthOf(source)) }
}

fn rejects(source: []const u8, code: json.ErrorCode) -> bool {
    var tokenizer: json.Tokenizer = undefined
    var token: json.Token = undefined
    start(&tokenizer, source)
    while json.next(&tokenizer, &token) {}
    return token.kind == json.TokenKind.invalid && json.errorCode(&tokenizer) == code
}

fn accepts(source: []const u8) -> bool {
    var tokenizer: json.Tokenizer = undefined
    var token: json.Token = undefined
    start(&tokenizer, source)
    while json.next(&tokenizer, &token) {}
    return token.kind == json.TokenKind.endOfDocument && !json.failed(&tokenizer)
}

fn integerOf(source: []const u8, expected: i64) -> bool {
    var value: i64 = 0
    var raw: json.String = undefined
    unsafe { raw = json.String.{ .pointer = @ptrCast([*]const u8, source), .length = lengthOf(source) } }
    return json.parseInteger(raw, &value) && value == expected
}

fn rejectsInteger(source: []const u8) -> bool {
    var value: i64 = 0
    var raw: json.String = undefined
    unsafe { raw = json.String.{ .pointer = @ptrCast([*]const u8, source), .length = lengthOf(source) } }
    return !json.parseInteger(raw, &value)
}

pub fn main() -> u8 {
    const document = "{\n  \"file_format_version\": \"1.0.1\",\n  \"ICD\": { \"library_path\": \"libvulkan_lvp.so\", \"api_version\": \"1.4.318\" },\n  \"list\": [1, -2.5e3, true, false, null, [], {}],\n  \"text\": \"a\\\"b\\\\c\\n\\u00e9\\ud83d\\ude00\"\n}"
    var tokenizer: json.Tokenizer = undefined
    var token: json.Token = undefined
    start(&tokenizer, document)

    if !check(&tokenizer, &token, json.TokenKind.objectStart) || json.depth(&tokenizer) != 1 { return 1 }
    if !check(&tokenizer, &token, json.TokenKind.key) || !json.equals(token.value, "file_format_version") { return 2 }
    if !check(&tokenizer, &token, json.TokenKind.string) || !json.equals(token.value, "1.0.1") { return 3 }
    if !check(&tokenizer, &token, json.TokenKind.key) || !json.equals(token.value, "ICD") { return 4 }
    if !check(&tokenizer, &token, json.TokenKind.objectStart) || json.depth(&tokenizer) != 2 { return 5 }
    if !check(&tokenizer, &token, json.TokenKind.key) || !json.equals(token.value, "library_path") { return 6 }
    if !check(&tokenizer, &token, json.TokenKind.string) || !json.equals(token.value, "libvulkan_lvp.so") { return 7 }
    if !check(&tokenizer, &token, json.TokenKind.key) { return 8 }
    if !check(&tokenizer, &token, json.TokenKind.string) { return 9 }
    if !check(&tokenizer, &token, json.TokenKind.objectEnd) || json.depth(&tokenizer) != 1 { return 10 }
    if !check(&tokenizer, &token, json.TokenKind.key) || !json.equals(token.value, "list") { return 11 }
    if !check(&tokenizer, &token, json.TokenKind.arrayStart) { return 12 }
    if !check(&tokenizer, &token, json.TokenKind.number) || !json.equals(token.value, "1") { return 14 }
    if !check(&tokenizer, &token, json.TokenKind.number) || !json.equals(token.value, "-2.5e3") { return 15 }
    if !check(&tokenizer, &token, json.TokenKind.trueValue) { return 16 }
    if !check(&tokenizer, &token, json.TokenKind.falseValue) { return 17 }
    if !check(&tokenizer, &token, json.TokenKind.nullValue) { return 18 }
    if !check(&tokenizer, &token, json.TokenKind.arrayStart) { return 19 }
    if !json.skipValue(&tokenizer, token) || json.depth(&tokenizer) != 2 { return 20 }
    if !check(&tokenizer, &token, json.TokenKind.objectStart) { return 21 }
    if !check(&tokenizer, &token, json.TokenKind.objectEnd) { return 22 }
    if !check(&tokenizer, &token, json.TokenKind.arrayEnd) || json.depth(&tokenizer) != 1 { return 23 }
    if !check(&tokenizer, &token, json.TokenKind.key) || !json.equals(token.value, "text") { return 24 }
    if !check(&tokenizer, &token, json.TokenKind.string) || json.isPlain(token.value) { return 25 }
    var decoded: [32]u8 = undefined
    unsafe {
        const length = json.decodeString(token.value, @ptrCast([*]u8, &decoded), 32)
        if length != 12 { return 26 }
    }
    // a " b \ c \n é (C3 A9) 😀 (F0 9F 98 80)
    if decoded[0] != 97 || decoded[1] != 34 || decoded[3] != 92 || decoded[5] != 10 { return 27 }
    if decoded[6] != 195 || decoded[7] != 169 { return 28 }
    if decoded[8] != 240 || decoded[9] != 159 || decoded[10] != 152 || decoded[11] != 128 { return 29 }
    if !check(&tokenizer, &token, json.TokenKind.objectEnd) || json.depth(&tokenizer) != 0 { return 30 }
    if json.next(&tokenizer, &token) || token.kind != json.TokenKind.endOfDocument || json.failed(&tokenizer) { return 31 }

    // skipValue over a whole nested object from its start token.
    start(&tokenizer, "[{\"a\": [1, {\"b\": 2}], \"c\": {}}, 7]")
    if !check(&tokenizer, &token, json.TokenKind.arrayStart) { return 32 }
    if !check(&tokenizer, &token, json.TokenKind.objectStart) { return 33 }
    if !json.skipValue(&tokenizer, token) { return 34 }
    if !check(&tokenizer, &token, json.TokenKind.number) || !json.equals(token.value, "7") { return 35 }

    if !accepts("  42 ") || !accepts("\"x\"") || !accepts("[]") || !accepts("{\"k\":[true,{\"n\":null}]}") || !accepts("-0.0E+1") { return 36 }
    if !rejects("", json.ErrorCode.unexpectedEnd) { return 37 }
    if !rejects("[1, 2", json.ErrorCode.unexpectedEnd) { return 38 }
    if !rejects("[1 2]", json.ErrorCode.expectedCommaOrEnd) { return 39 }
    if !rejects("{\"a\" 1}", json.ErrorCode.expectedColon) { return 40 }
    if !rejects("{1: 2}", json.ErrorCode.expectedKey) { return 41 }
    if !rejects("{\"a\": 1,}", json.ErrorCode.expectedKey) { return 42 }
    if !rejects("[1]]", json.ErrorCode.trailingContent) { return 43 }
    if !rejects("[1}", json.ErrorCode.mismatchedClose) { return 44 }
    if !rejects("[tru]", json.ErrorCode.invalidLiteral) { return 45 }
    if !rejects("[01]", json.ErrorCode.expectedCommaOrEnd) { return 46 }
    if !rejects("[1.]", json.ErrorCode.invalidNumber) { return 47 }
    if !rejects("[\"a\\x\"]", json.ErrorCode.invalidEscape) { return 48 }
    if !rejects("[\"a\nb\"]", json.ErrorCode.invalidString) { return 49 }
    if !rejects("\"open", json.ErrorCode.invalidString) { return 50 }
    if !rejects("1 2", json.ErrorCode.trailingContent) { return 51 }
    if !rejects("[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]", json.ErrorCode.tooDeep) { return 52 }

    if !integerOf("0", 0) || !integerOf("-17", -17) || !integerOf("9223372036854775807", 9223372036854775807) { return 53 }
    if !integerOf("-9223372036854775808", -9223372036854775807 - 1) { return 54 }
    if !rejectsInteger("9223372036854775808") || !rejectsInteger("1.5") || !rejectsInteger("-") || !rejectsInteger("") { return 55 }
    var unsigned: u64 = 0
    var raw: json.String = undefined
    unsafe { raw = json.String.{ .pointer = @ptrCast([*]const u8, "18446744073709551615"), .length = 20 } }
    if !json.parseUnsigned(raw, &unsigned) || unsigned != 18446744073709551615 { return 56 }
    unsafe { raw = json.String.{ .pointer = @ptrCast([*]const u8, "18446744073709551616"), .length = 20 } }
    if json.parseUnsigned(raw, &unsigned) { return 57 }

    // An unpaired surrogate is rejected by decodeString.
    unsafe { raw = json.String.{ .pointer = @ptrCast([*]const u8, "\\ud83d"), .length = 6 } }
    unsafe { if json.decodeString(raw, @ptrCast([*]u8, &decoded), 32) != -1 { return 58 } }
    return 13
}
