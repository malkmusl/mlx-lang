// The address of a field or element is as writable as the place it is in:
// `&heap.lock` of a variable and `&heap.*.count` through a mutable pointer
// are `*u32`, and `text.*[i] = v` stores through a pointer to an array.
// Older compilers typed every field address `*const T`. Exits 13 when every
// check holds, else the number of the first check that failed.
const Heap = struct { lock: u32, count: u32 }
const Scratch = struct { text: [16]u8, length: usize }

fn countOf(heap: *Heap) -> *u32 { return &heap.*.count }

fn put(text: *[16]u8, at: usize, upper: bool) -> void {
    text.*[at] = if upper { 69 } else { 101 }
    text.*[at + 1] = 48
}

pub fn main() -> u8 {
    var heap = Heap.{ .lock = 1, .count = 2 }
    const lock: *u32 = &heap.lock
    lock.* = 7
    const count = countOf(&heap)
    count.* = 6
    if heap.lock != 7 || heap.count != 6 { return 1 }

    var scratch: Scratch = undefined
    put(&scratch.text, 3, true)
    if scratch.text[3] != 69 || scratch.text[4] != 48 { return 2 }

    var values: [4]u32 = undefined
    const second: *u32 = &values[1]
    second.* = 9
    if values[1] != 9 { return 3 }
    return 13
}
