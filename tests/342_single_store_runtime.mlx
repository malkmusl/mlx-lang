// Locals stored once (ir/single_store.mlx): a load the store dominates
// reads the stored value directly, a load it does not dominate still
// reads the local. Exits 13.
fn square(value: usize) -> usize { return value * value }

// A const in a loop body read in later blocks of the same pass.
fn classify(text: []const u8) -> usize {
    var digits: usize = 0
    var letters: usize = 0
    var index: usize = 0
    while index < text.length {
        const byte = text[index]
        const lowercase = byte | 32
        if byte >= 48 && byte <= 57 {
            digits += 1
        } else if lowercase >= 97 && lowercase <= 122 {
            letters += 1
        }
        index += 1
    }
    return digits * 100 + letters
}

// Stored in one branch of the first pass only: later passes read what
// that pass stored, not the value made in their own pass.
fn firstSquare(count: usize) -> usize {
    var kept: usize = undefined
    var total: usize = 0
    var turn: usize = 0
    while turn < count {
        const made = square(turn + 3)
        if turn == 0 { kept = made }
        total += kept
        turn += 1
    }
    return total
}

// Read before its only store in the loop: each pass sees the last pass's
// value.
fn previous(count: usize) -> usize {
    var last: usize = undefined
    var sum: usize = 0
    var turn: usize = 0
    while turn < count {
        if turn > 0 { sum += last }
        last = turn * 10
        turn += 1
    }
    return sum
}

// A var never assigned again, read in nested loops; a narrow const.
fn nested() -> bool {
    var limit: usize = 4
    var hits: usize = 0
    var outer: usize = 0
    while outer < limit {
        var inner: usize = 0
        while inner < limit {
            const small: u8 = @intCast(u8, (outer * 4 + inner) & 255)
            if small % 3 == 0 { hits += 1 }
            inner += 1
        }
        outer += 1
    }
    return hits == 6
}

pub fn main() -> u8 {
    if classify("ab12_Z9x") != 300 + 4 { return 1 }
    if firstSquare(4) != 9 * 4 { return 2 }
    if previous(4) != 0 + 10 + 20 { return 3 }
    if !nested() { return 4 }
    return 13
}
