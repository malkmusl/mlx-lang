// Module-level string constants used as values, in this module and from an
// imported one, lower to their string literals (NUL-terminated). Exits 13.
const constants = @import("./support/strings/constants.mlx")

const LOCAL = "local name"

fn cLength(text: [*]const u8) -> usize {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return length
}

fn sliceLength(text: []const u8) -> usize {
    var length: usize = 0
    for byte in text { length += 1 }
    return length
}

pub fn main() -> u8 {
    var pointer: [*]const u8 = undefined
    unsafe { pointer = @ptrCast([*]const u8, LOCAL) }
    if cLength(pointer) != 10 { return 1 }
    if sliceLength(LOCAL) != 10 { return 2 }
    unsafe { pointer = @ptrCast([*]const u8, constants.NAME) }
    if cLength(pointer) != 14 || pointer[3] != 75 { return 3 }
    if sliceLength(constants.NAME) != 14 { return 4 }
    // "a\\tb" keeps its escaped backslash: a, \, t, b.
    unsafe { pointer = @ptrCast([*]const u8, constants.ESCAPED) }
    if cLength(pointer) != 4 || pointer[1] != 92 { return 5 }
    return 13
}
