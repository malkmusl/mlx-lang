// std.heap: the program's heap, made on first use, the one heap wherever
// allocator() is called; its state in the tiny-page region shared by
// every image; blocks taken, resized and given back with the heap's
// accounting following; a block's footprint (its size class in a slab,
// its pages when large); a reservation of a GiB through the page
// allocator (MAP_NORESERVE); under the leak check (std.leaks.watchAlways)
// allocator() is the debug allocator over the heap, which counts the
// program's blocks and not the heap's slabs nor what page_allocator.
// backing() gives; deinit gives the slabs back. Exits 13 on success
// (another number: the check that failed).
const std = @import("std")
const heap = @import("std.heap")
const leaks = @import("std.leaks")

const tiny = std.tinypage_allocator
const gpa = std.general_purpose_allocator

fn main() -> u8 {
    const allocator = heap.allocator()
    const again = heap.allocator()
    if @intFromPtr(allocator.context) != @intFromPtr(again.context) { return 1 }
    if @intFromPtr(allocator.context) != @intFromPtr(heap.pointer()) { return 2 }
    // The heap's state in the shared region, where there is one.
    if heap.isShared() {
        if tiny.shared() == 0 || @intFromPtr(heap.pointer()) != tiny.shared() + 64 { return 3 }
    }
    // Blocks taken and given back, the accounting following.
    const before = heap.liveBytes()
    const small = allocator.alloc(100, 8)
    if small == null { return 4 }
    if heap.liveBytes() != before + 100 { return 5 }
    small.?[0] = 7
    small.?[99] = 9
    if !heap.owns(@intFromPtr(small.?)) { return 6 }
    if heap.footprint(@intFromPtr(small.?), 100, 8) != gpa.blockSize(100, 8) { return 7 }
    if gpa.blockSize(100, 8) != 128 { return 8 }
    // Resized within the class, in place.
    const grown = allocator.resize(small.?, 100, 120, 8)
    if grown == null || @intFromPtr(grown.?) != @intFromPtr(small.?) { return 9 }
    if grown.?[0] != 7 || grown.?[99] != 9 { return 10 }
    if heap.liveBytes() != before + 120 { return 11 }
    // A large block: a mapping of its own, its footprint whole pages.
    const large = allocator.alloc(100000, 8)
    if large == null { return 12 }
    if heap.owns(@intFromPtr(large.?)) { return 14 }
    if heap.footprint(@intFromPtr(large.?), 100000, 8) != 102400 { return 15 }
    if heap.largeCount() < 1 { return 16 }
    allocator.free(large.?, 100000, 8)
    allocator.free(grown.?, 120, 8)
    if heap.liveBytes() != before { return 17 }
    // Blocks come zeroed, as the page allocator's: the block just given
    // back (its first word the free list's) comes back clear, and so
    // does what a resize adds.
    const reused = allocator.alloc(100, 8)
    if reused == null { return 32 }
    if reused.?[0] != 0 || reused.?[8] != 0 || reused.?[99] != 0 { return 33 }
    reused.?[0] = 5
    const widened = allocator.resize(reused.?, 100, 128, 8)
    if widened == null || widened.?[0] != 5 || widened.?[127] != 0 { return 34 }
    const moved = allocator.resize(widened.?, 128, 40000, 8)
    if moved == null || moved.?[0] != 5 || moved.?[39999] != 0 { return 35 }
    allocator.free(moved.?, 40000, 8)
    // A reservation of a GiB from the page allocator, touched here and
    // there, then given back.
    const pages = std.page_allocator.init()
    const reserved = pages.alloc(1073741824, 4096)
    if reserved == null { return 18 }
    reserved.?[0] = 1
    reserved.?[536870912] = 2
    reserved.?[1073741823] = 3
    if reserved.?[536870912] != 2 { return 19 }
    pages.free(reserved.?, 1073741824, 4096)
    // Watched: allocator() is the debug allocator over the heap, which
    // sees the program's blocks (and not the heap's slabs, nor what the
    // backing allocator gives).
    leaks.watchAlways()
    const watched = heap.allocator()
    if @intFromPtr(watched.context) == @intFromPtr(heap.pointer()) { return 20 }
    const live_before = leaks.liveCount()
    const first = watched.alloc(24, 8)
    const second = watched.alloc(40000, 8)
    const third = watched.alloc(3000, 16)
    if first == null || second == null || third == null { return 21 }
    if leaks.liveCount() != live_before + 3 { return 22 }
    const backing = std.page_allocator.backing()
    const slab = backing.alloc(262144, 4096)
    if slab == null { return 23 }
    if leaks.liveCount() != live_before + 3 { return 24 }
    backing.free(slab.?, 262144, 4096)
    watched.free(second.?, 40000, 8)
    watched.free(first.?, 24, 8)
    if leaks.liveCount() != live_before + 1 { return 25 }
    if leaks.report() != live_before + 1 { return 26 }
    watched.free(third.?, 3000, 16)
    if leaks.liveCount() != live_before { return 27 }
    if leaks.problemCount() != 0 { return 28 }
    // Everything given back: the slabs go, and the heap is usable again.
    if heap.liveBytes() != before { return 29 }
    heap.deinit()
    if heap.slabCount() != 0 { return 30 }
    const after = heap.allocator().alloc(16, 8)
    if after == null { return 31 }
    heap.allocator().free(after.?, 16, 8)
    return 13
}
