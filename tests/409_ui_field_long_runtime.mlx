// std.ui.field with a long text (a URL of 4 KB and more): no fixed size,
// the text grows in its std.heap block as it is set and typed (into the
// middle too, and past 8 KB), the caret moves by characters and words,
// Home and End, Shift selects and Backspace takes the selection; drawn
// with the focus, the field scrolls sideways so that the caret at the end
// is in view (its pixels where it is drawn), and a click places the caret
// at the character under it (found by halving, not by measuring each
// start); wipe and deinit leave nothing behind. Exits 13 (a check's number
// when one fails).
const std = @import("std")
const ui = @import("std.ui")
const view = @import("std.ui.view")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const theme_module = @import("std.ui.theme")
const field = @import("std.ui.field")
const keys = @import("std.ui.keys")

const WIDTH: usize = 400
const HEIGHT: usize = 60
const LONG: usize = 4096
// The field's area.
const LEFT: i32 = 20
const TOP: i32 = 10
const AREA_WIDTH: i32 = 300
const AREA_HEIGHT: i32 = 30

fn frame(context: *view.Ui, canvas: *canvas_module.Canvas, address: *field.Field) -> bool {
    view.begin(context, canvas)
    canvas_module.clear(canvas, context.*.theme.*.background)
    const clicked = field.textField(context, view.id("address"), ui.rect(LEFT, TOP, AREA_WIDTH, AREA_HEIGHT), address, "Address", false)
    return view.end(context)
}

fn pixel(canvas: *canvas_module.Canvas, x: i32, y: i32) -> u32 { return canvas.*.pixels[@intCast(usize, y) * WIDTH + @intCast(usize, x)] }

// A URL of `length` bytes: a scheme and host, then path segments of
// letters and digits, "/end" last.
fn longUrl(into: [*]u8, length: usize) -> void {
    const start = "https://example.org/"
    var at: usize = 0
    for c in start {
        into[at] = c
        at += 1
    }
    while at < length - 4 {
        into[at] = if at % 16 == 15 { 47 } else { @intCast(u8, 97 + at % 26) }
        at += 1
    }
    for c in "/end" {
        into[at] = c
        at += 1
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.heap.allocator()
    var memory = allocator.alloc(WIDTH * HEIGHT * 4, 16).?
    var canvas: canvas_module.Canvas = undefined
    unsafe { canvas.pixels = @ptrCast([*]u32, memory) }
    canvas.width = WIDTH
    canvas.height = HEIGHT
    canvas.device = 0
    canvas.stride = WIDTH
    canvas.swapRedBlue = false
    canvas.opacity = 255
    var theme = theme_module.light()
    var font: text_module.Text = undefined
    font.loaded = false
    if !text_module.loadText(&font, 15, allocator) { return 1 }
    var context: view.Ui = undefined
    view.init(&context, &theme, &font, &font, &font)

    var address: field.Field = undefined
    field.init(&address)
    if field.capacity(&address) != 0 || field.text(&address).length != 0 { return 2 }
    var url_memory = allocator.alloc(3 * LONG, 1).?
    const url: [*]u8 = url_memory
    longUrl(url, LONG)

    // Set whole: 4 KB, nothing cut, the caret at the end.
    field.set(&address, url[0..LONG])
    if field.text(&address).length != LONG || !std.text.same(field.text(&address), url[0..LONG]) { return 3 }
    if address.cursor != LONG || address.anchor != LONG || field.capacity(&address) < LONG { return 4 }

    // Typing into the middle: after the scheme, a character of two bytes.
    var result = field.fieldKey(&address, keys.HOME, 0, "")
    if address.cursor != 0 || result != field.KEY_MOVED { return 5 }
    result = field.fieldKey(&address, keys.RIGHT, keys.CONTROL, "")
    if address.cursor != 5 { return 6 }
    result = field.fieldKey(&address, 18, 0, "é")
    if result != field.KEY_EDITED || address.cursor != 7 || field.text(&address).length != LONG + 2 { return 7 }
    if !std.text.same(field.text(&address)[0..10], "httpsé://") || !std.text.same(field.text(&address)[LONG - 2..LONG + 2], "/end") { return 8 }
    result = field.fieldKey(&address, keys.BACKSPACE, 0, "")
    if field.text(&address).length != LONG || address.cursor != 5 || !std.text.same(field.text(&address), url[0..LONG]) { return 9 }

    // Past 8 KB: the end typed onto twice more.
    result = field.fieldKey(&address, keys.END, 0, "")
    field.insert(&address, url[0..LONG])
    field.insert(&address, url[0..LONG])
    if field.text(&address).length != 3 * LONG || address.cursor != 3 * LONG || !std.text.same(field.text(&address)[2 * LONG..3 * LONG], url[0..LONG]) { return 10 }

    // Shift selecting back to the first 4 KB's end, Backspace taking it.
    var steps: usize = 0
    while steps < 2 * LONG {
        result = field.fieldKey(&address, keys.LEFT, keys.SHIFT, "")
        steps += 1
    }
    if field.selectionStart(&address) != LONG || field.selectionEnd(&address) != 3 * LONG { return 11 }
    result = field.fieldKey(&address, keys.BACKSPACE, 0, "")
    if result != field.KEY_EDITED || !std.text.same(field.text(&address), url[0..LONG]) || field.hasSelection(&address) { return 12 }
    // Ctrl+A, then Shift+Home from the end: all of it, then its start.
    result = field.fieldKey(&address, keys.A, keys.CONTROL, "")
    if field.selectionStart(&address) != 0 || field.selectionEnd(&address) != LONG { return 13 }

    // Without the focus the field shows the text's start.
    context.time = 0
    var again = frame(&context, &canvas, &address)
    if address.scroll != 0 { return 20 }
    // With it, the caret at the end: scrolled so that the caret is in view.
    view.setFocus(&context, view.id("address"))
    result = field.fieldKey(&address, keys.END, 0, "")
    again = frame(&context, &canvas, &address)
    const whole = text_module.measure(&font, field.text(&address))
    if whole < 20 * AREA_WIDTH || address.scroll < whole - AREA_WIDTH { return 21 }
    const left = LEFT + theme.padding
    const width = LEFT + AREA_WIDTH - theme.padding - left
    const caret_x = left + whole - address.scroll
    if caret_x < left || caret_x > left + width { return 22 }
    if pixel(&canvas, caret_x, TOP + AREA_HEIGHT / 2) != theme.caret { return 23 }
    // The text's end is drawn (ink left of the caret), its start is not
    // drawn over the field's left edge.
    var ink = false
    var x = caret_x - 30
    while x < caret_x - 2 {
        var y = TOP + 8
        while y < TOP + AREA_HEIGHT - 8 {
            if pixel(&canvas, x, y) != theme.field { ink = true }
            y += 1
        }
        x += 1
    }
    if !ink { return 24 }
    if pixel(&canvas, LEFT + 2, TOP + AREA_HEIGHT / 2) == theme.text { return 25 }

    // Home: back at the start, scrolled back.
    result = field.fieldKey(&address, keys.HOME, 0, "")
    again = frame(&context, &canvas, &address)
    if address.scroll != 0 { return 26 }

    // A click in the scrolled field places the caret at the character
    // under the pointer: the end of the 3000th byte.
    address.cursor = 3000
    address.anchor = 3000
    const target = text_module.measure(&font, field.text(&address)[0..3000])
    address.scroll = target - 100
    const pointer_x = left + target - address.scroll
    const moved = view.pointerMove(&context, pointer_x, TOP + AREA_HEIGHT / 2)
    again = frame(&context, &canvas, &address)
    const pressed = view.pointerButton(&context, true)
    again = frame(&context, &canvas, &address)
    if address.cursor != 3000 || address.anchor != 3000 { return 30 }
    // Dragged left by 100 pixels: a selection back to where it reached.
    const dragged = view.pointerMove(&context, pointer_x - 100, TOP + AREA_HEIGHT / 2)
    again = frame(&context, &canvas, &address)
    const released = view.pointerButton(&context, false)
    if field.selectionEnd(&address) != 3000 || field.selectionStart(&address) >= 3000 || field.selectionStart(&address) < 2900 { return 31 }
    if field.offsetAt(&address, &font, text_module.measure(&font, field.text(&address)[0..LONG - 4])) != LONG - 4 { return 32 }

    // Drawing a 4 KB field is quick (only what is in view is laid out):
    // 200 frames in well under a second.
    const before = std.time.milliseconds()
    var count: usize = 0
    while count < 200 {
        again = frame(&context, &canvas, &address)
        count += 1
    }
    if std.time.milliseconds() - before > 1000 { return 40 }

    // Wiped: the block all zero; deinit gives it back.
    const block = address.bytes
    const room = field.capacity(&address)
    field.wipe(&address)
    if field.text(&address).length != 0 || field.capacity(&address) != room { return 50 }
    var index: usize = 0
    while index < room {
        if block[index] != 0 { return 51 }
        index += 1
    }
    field.deinit(&address)
    if field.capacity(&address) != 0 || field.text(&address).length != 0 { return 52 }
    // And grows again from nothing.
    field.set(&address, url[0..LONG])
    if !std.text.same(field.text(&address), url[0..LONG]) { return 53 }
    field.deinit(&address)
    return 13
}
