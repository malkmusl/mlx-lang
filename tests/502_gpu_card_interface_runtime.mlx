// The kernel interface of our Vulkan driver (spec/04-stdlib/os/brix.xml,
// <GpuDevices> and the calls 80 to 85; the study's 3.5), on the host's
// card (projects/brix/vulkan/card_host.mlx), built for the host:
// - the card's record: the kernel's own encoder (projects/brix/kernel/
//   gpu_record.mlx) writes each field at the offset the spec's GpuDevice
//   gives it (the spec's text read here, every field), std.gpucard reads
//   every field back; the user's RX 580 as the host card describes it;
//   reads of the record at every offset and of every length, as a node's
//   read gives them; a record shorter than its fixed part or one whose
//   first word says less refused, a later kernel's longer one read as far
//   as this one goes;
// - the calls as the kernel answers them: the cards counted and
//   described, a card that is not there; contexts made (a handle of its
//   own each, never 0), the card's record read through one, ended; each of
//   the six calls on a context refused with unsupported, on a handle that
//   is no context with wrong_kind, on a handle closed (also when its slot
//   is used again), on 0 and on a made-up one with invalid_handle; the
//   contexts all taken (too_many) and given back;
// - std.gpucard's numbers: the calls NATIVE_BASE + 80 to 85, the handle's
//   kind 10, the spec's Calls and Kinds saying the same; its paths, names,
//   compute units and the reasons in words.
// With an argument, each failing check is printed.
// Exits 13.
const std = @import("std")
const gpucard = @import("std.gpucard")
const record = @import("../projects/brix/kernel/gpu_record.mlx")
const offering = @import("../projects/brix/kernel/gpu_offer.mlx")
const engines = @import("../projects/brix/kernel/gpu_engines.mlx")
const host = @import("../projects/brix/vulkan/card_host.mlx")
const card = @import("../projects/brix/vulkan/card.mlx")

const Status = std.os.brix.Status
const TOO_MANY: isize = 21

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }
fn sayNumber(value: u64) -> void { _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, value)) }

var failed: u8 = 0
var show = false

fn check(number: u8, holds: bool) -> void {
    if holds { return }
    if failed == 0 { failed = number }
    if show {
        say("check ")
        sayNumber(@intCast(u64, number))
        say(" fails\n")
    }
}

fn get32(bytes: [*]const u8, at: usize) -> usize { return @intCast(usize, bytes[at]) | (@intCast(usize, bytes[at + 1]) << 8) | (@intCast(usize, bytes[at + 2]) << 16) | (@intCast(usize, bytes[at + 3]) << 24) }

fn get64(bytes: [*]const u8, at: usize) -> usize { return get32(bytes, at) | (get32(bytes, at + 4) << 32) }

fn equal(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

// A record whose every field differs from every other (the bytes too).
fn distinct() -> record.Facts {
    return record.Facts.{
        .flags = 0x0000000F,
        .vendor = 0x11121314,
        .device = 0x21222324,
        .revision = 0x31323334,
        .pci = 0x41424344,
        .graphics = 0x51525354,
        .shaderEngines = 0x61626364,
        .arraysPerEngine = 0x71727374,
        .computeUnitsPerArray = 0x81828384,
        .renderBackendsPerEngine = 0x91929394,
        .engineClock = 0xA1A2A3A4,
        .memoryClock = 0xB1B2B3B4,
        .computeRings = 0xC1C2C3C4,
        .graphicsRings = 0xD1D2D3D4,
        .copyRings = 0xE1E2E3E4,
        .why = 0xF1F2F3F4,
        .memory = 0x0102030405060708,
        .visible = 0x1112131415161718,
        .picture = 0x2122232425262728,
        .system = 0x3132333435363738,
        .name = "A card of the test's own: 31 by",
    }
}

// The value a field of `distinct` has, by the spec's name for it.
fn fieldValue(f: *const record.Facts, name: []const u8) -> usize {
    if equal(name, "length") { return record.RECORD }
    if equal(name, "flags") { return @intCast(usize, f.*.flags) }
    if equal(name, "vendor") { return @intCast(usize, f.*.vendor) }
    if equal(name, "device") { return @intCast(usize, f.*.device) }
    if equal(name, "revision") { return @intCast(usize, f.*.revision) }
    if equal(name, "pci") { return @intCast(usize, f.*.pci) }
    if equal(name, "graphics") { return @intCast(usize, f.*.graphics) }
    if equal(name, "shader_engines") { return @intCast(usize, f.*.shaderEngines) }
    if equal(name, "arrays_per_engine") { return @intCast(usize, f.*.arraysPerEngine) }
    if equal(name, "compute_units_per_array") { return @intCast(usize, f.*.computeUnitsPerArray) }
    if equal(name, "render_backends_per_engine") { return @intCast(usize, f.*.renderBackendsPerEngine) }
    if equal(name, "engine_clock") { return @intCast(usize, f.*.engineClock) }
    if equal(name, "memory_clock") { return @intCast(usize, f.*.memoryClock) }
    if equal(name, "compute_rings") { return @intCast(usize, f.*.computeRings) }
    if equal(name, "graphics_rings") { return @intCast(usize, f.*.graphicsRings) }
    if equal(name, "copy_rings") { return @intCast(usize, f.*.copyRings) }
    if equal(name, "why") { return @intCast(usize, f.*.why) }
    if equal(name, "reserved") || equal(name, "name") { return 0 }
    if equal(name, "memory") { return f.*.memory }
    if equal(name, "visible") { return f.*.visible }
    if equal(name, "picture") { return f.*.picture }
    if equal(name, "system") { return f.*.system }
    return 0xDEADDEADDEADDEAD
}

// The spec's text, whole.
var specText: [*]const u8 = undefined
var specLength: usize = 0

fn loadSpec() -> bool {
    const loaded = std.fs.readFileAlloc("spec/04-stdlib/os/brix.xml".pointer, std.heap.allocator())
    if loaded == null { return false }
    specText = loaded.?.items
    specLength = loaded.?.length
    return true
}

fn spec() -> []const u8 { return specText[0..specLength] }

// Where `needle` is in `hay` from `from` on (hay.length: nowhere).
fn find(hay: []const u8, needle: []const u8, from: usize) -> usize {
    var at = from
    while at + needle.length <= hay.length {
        if equal(hay[at..at + needle.length], needle) { return at }
        at += 1
    }
    return hay.length
}

// The attribute `name="..."`'s value in `element` (empty: none).
fn attribute(element: []const u8, name: []const u8) -> []const u8 {
    var key: [32]u8 = undefined
    var length: usize = 0
    while length < name.length {
        key[length] = name[length]
        length += 1
    }
    key[length] = 61
    key[length + 1] = 34
    length += 2
    const at = find(element, key[0..length], 0)
    if at >= element.length { return element[0..0] }
    const start = at + length
    var end = start
    while end < element.length && element[end] != 34 { end += 1 }
    return element[start..end]
}

fn decimal(text: []const u8) -> usize {
    var value: usize = 0
    for byte in text { value = value * 10 + @intCast(usize, byte - 48) }
    return value
}

// The spec's GpuDevice: every field at the offset it names holds what the
// kernel's encoder wrote for it; the fields cover the record without gap.
fn testSpecRecord() -> void {
    check(1, loadSpec())
    if specLength == 0 { return }
    const text = spec()
    const begin = find(text, "<GpuDevice note=", 0)
    const end = find(text, "</GpuDevice>", begin)
    check(2, begin < text.length && end < text.length)
    if end >= text.length { return }
    const facts = distinct()
    var bytes: [record.RECORD]u8 = undefined
    record.encode(&facts, &bytes)
    var fields: usize = 0
    var covered: usize = 0
    var at = begin
    while true {
        at = find(text, "<Field ", at)
        if at >= end { break }
        var close = at
        while close < end && text[close] != 62 { close += 1 }
        const element = text[at..close]
        const offset = decimal(attribute(element, "at"))
        const kind = attribute(element, "type")
        const name = attribute(element, "name")
        const want = fieldValue(&facts, name)
        check(3, want != 0xDEADDEADDEADDEAD)
        check(4, offset == covered)
        if equal(kind, "u32") {
            check(5, get32(&bytes, offset) == want & 0xFFFFFFFF)
            covered = offset + 4
        } else if equal(kind, "u64") {
            check(6, get64(&bytes, offset) == want)
            covered = offset + 8
        } else if equal(kind, "[32]u8") {
            check(7, equal(bytes[offset..offset + 31], facts.name))
            check(8, bytes[offset + 31] == 0)
            covered = offset + 32
        } else {
            check(9, false)
        }
        fields += 1
        at = close
    }
    check(10, fields == 23)
    check(11, covered == record.RECORD)
    // The length the spec says.
    check(12, find(text[begin..end], "136 bytes", 0) < end - begin)
}

// The spec's calls and kinds, as std.gpucard numbers them.
fn testSpecCalls() -> void {
    if specLength == 0 { return }
    const text = spec()
    check(20, find(text, "<Call n=\"80\">gpu_memory(gpu h, size, flags) -> memory h", 0) < text.length)
    check(21, find(text, "<Call n=\"81\">gpu_memory_of(gpu h, address, size) -> memory h", 0) < text.length)
    check(22, find(text, "<Call n=\"82\">gpu_map(gpu h, memory h, offset, size, card address, flags)", 0) < text.length)
    check(23, find(text, "<Call n=\"83\">gpu_unmap(gpu h, card address, size)", 0) < text.length)
    check(24, find(text, "<Call n=\"84\">gpu_submit(gpu h, streams*, count, fence h or 0) -> sequence", 0) < text.length)
    check(25, find(text, "<Call n=\"85\">gpu_fence(gpu h) -> h", 0) < text.length)
    check(26, find(text, "<Call n=\"86\">", 0) == text.length)
    check(27, find(text, "<Kinds>process group node stream channel session memory timer socket gpu</Kinds>", 0) < text.length)
    const base = std.os.brix.NATIVE_BASE
    check(28, gpucard.GPU_MEMORY == base + 80 && gpucard.GPU_MEMORY_OF == base + 81 && gpucard.GPU_MAP == base + 82)
    check(29, gpucard.GPU_UNMAP == base + 83 && gpucard.GPU_SUBMIT == base + 84 && gpucard.GPU_FENCE == base + 85)
    // The handle's kind is the tenth: the Kinds' order from 1.
    check(30, gpucard.KIND == 10 && std.os.brix.Kind.SOCKET == 9)
    check(31, gpucard.RECORD == record.RECORD)
    // The flags and the reasons, the same numbers on both sides.
    check(32, gpucard.Flag.STARTED == record.Flag.STARTED && gpucard.Flag.PICTURE == record.Flag.PICTURE && gpucard.Flag.ROM_COUNTS == record.Flag.ROM_COUNTS && gpucard.Flag.SYSTEM_MEMORY == record.Flag.SYSTEM_MEMORY)
    check(33, gpucard.Why.NONE == record.Why.NONE && gpucard.Why.NOT_STARTED_YET == record.Why.NOT_STARTED_YET && gpucard.Why.CARD_NOT_STARTED == record.Why.CARD_NOT_STARTED && gpucard.Why.OTHER_CARD == record.Why.OTHER_CARD)
    // A stream's record is 24 bytes, as the spec has it.
    check(34, @sizeOf(gpucard.Stream) == 24)
    check(35, find(text, "each stream a record of 24 bytes", 0) < text.length)
}

// The record through std.gpucard, every field back.
fn testRoundTrip() -> void {
    const facts = distinct()
    var bytes: [record.RECORD]u8 = undefined
    record.encode(&facts, &bytes)
    var device: gpucard.Device = undefined
    check(40, gpucard.decode(&bytes, record.RECORD, &device))
    check(41, device.length == 136 && device.flags == facts.flags && device.vendor == facts.vendor && device.device == facts.device && device.revision == facts.revision)
    check(42, device.pci == facts.pci && device.graphics == facts.graphics && device.shaderEngines == facts.shaderEngines && device.arraysPerEngine == facts.arraysPerEngine)
    check(43, device.computeUnitsPerArray == facts.computeUnitsPerArray && device.renderBackendsPerEngine == facts.renderBackendsPerEngine && device.engineClock == facts.engineClock && device.memoryClock == facts.memoryClock)
    check(44, device.computeRings == facts.computeRings && device.graphicsRings == facts.graphicsRings && device.copyRings == facts.copyRings && device.why == facts.why)
    check(45, device.memory == @intCast(u64, facts.memory) && device.visible == @intCast(u64, facts.visible) && device.picture == @intCast(u64, facts.picture) && device.system == @intCast(u64, facts.system))
    check(46, equal(gpucard.nameOf(&device), facts.name))
    // Too short, a first word that says less: no record.
    check(47, !gpucard.decode(&bytes, record.RECORD - 1, &device))
    bytes[0] = 132
    check(48, !gpucard.decode(&bytes, record.RECORD, &device))
    // A later kernel's longer record: its first word says 160, read as far
    // as this one goes.
    var longer: [160]u8 = undefined
    record.encode(&facts, &longer)
    var k: usize = record.RECORD
    while k < 160 {
        longer[k] = 0x5A
        k += 1
    }
    longer[0] = 160
    check(49, gpucard.decode(&longer, 160, &device) && device.length == 160 && device.why == facts.why && device.system == @intCast(u64, facts.system))
    // A name of 40 bytes keeps its first 31 and its NUL.
    var long_name = facts
    long_name.name = "Forty bytes of a name, longer than room."
    record.encode(&long_name, &bytes)
    check(50, gpucard.decode(&bytes, record.RECORD, &device) && equal(gpucard.nameOf(&device), long_name.name[0..31]))
    // The same facts give the same bytes, and nothing beyond the record is
    // written.
    var twice: [record.RECORD + 8]u8 = undefined
    k = 0
    while k < record.RECORD + 8 {
        twice[k] = 0xEE
        k += 1
    }
    record.encode(&facts, &twice)
    record.encode(&facts, &bytes)
    k = 0
    var same = true
    while k < record.RECORD {
        if twice[k] != bytes[k] { same = false }
        k += 1
    }
    check(51, same && twice[record.RECORD] == 0xEE && twice[record.RECORD + 7] == 0xEE)
}

// A node's reads of the record: at every offset, of every length.
fn testReads() -> void {
    const facts = host.rx580(0)
    var whole: [record.RECORD]u8 = undefined
    record.encode(&facts, &whole)
    var ok = true
    var offset: usize = 0
    while offset <= record.RECORD + 4 {
        var capacity: usize = 0
        while capacity <= record.RECORD + 4 {
            var into: [record.RECORD + 8]u8 = undefined
            var k: usize = 0
            while k < record.RECORD + 8 {
                into[k] = 0xCC
                k += 1
            }
            const got = record.readAt(&facts, offset, &into, capacity)
            var want: usize = 0
            if offset < record.RECORD { want = record.RECORD - offset }
            if want > capacity { want = capacity }
            if got != want { ok = false }
            k = 0
            while k < got {
                if into[k] != whole[offset + k] { ok = false }
                k += 1
            }
            if into[got] != 0xCC { ok = false }
            capacity += 7
        }
        offset += 5
    }
    check(60, ok)
}

// The user's card, as the host card describes it.
fn testUsersCard() -> void {
    host.reset()
    const facts = host.rx580(0)
    check(70, host.add(&facts) == 0)
    const interface = host.interface()
    const count = interface.count
    const describe = interface.describe
    check(71, count() == 1)
    var device: gpucard.Device = undefined
    check(72, describe(0, &device) == 0)
    check(73, device.vendor == 0x1002 && device.device == 0x67DF && device.revision == 0xE7 && device.pci == 0x2100)
    check(74, device.memory == 8192 * 1024 * 1024 && device.visible == 256 * 1024 * 1024 && device.picture == 4800 * 1024)
    check(75, device.graphics == 0x801 && gpucard.computeUnits(&device) == 36 && device.shaderEngines == 4 && device.renderBackendsPerEngine == 2)
    check(76, device.engineClock == 300000 && device.memoryClock == 300000)
    check(77, device.computeRings == 0 && device.why == gpucard.Why.NOT_STARTED_YET)
    check(78, device.flags & gpucard.Flag.STARTED != 0 && device.flags & gpucard.Flag.PICTURE != 0 && device.flags & gpucard.Flag.SYSTEM_MEMORY == 0)
    check(79, equal(gpucard.nameOf(&device), "Radeon RX 580 (Polaris 10)"))
    check(80, describe(1, &device) == -Status.not_found)
    // A second card, and one too many.
    const other = host.rx580(1)
    check(81, host.add(&other) == 1 && count() == 2)
    check(82, describe(1, &device) == 0 && device.computeRings == 1 && device.why == gpucard.Why.NONE)
    check(83, host.add(&other) == 2 && host.add(&other) == 3 && host.add(&other) == host.MOST_CARDS && count() == 4)
    host.reset()
    check(84, count() == 0 && describe(0, &device) == -Status.not_found)
}

// The calls on contexts, as the kernel answers them.
fn testContexts() -> void {
    host.reset()
    const facts = host.rx580(0)
    _ = host.add(&facts)
    const interface = host.interface()
    const open = interface.open
    const close = interface.close
    const describeContext = interface.describeContext
    const memory = interface.memory
    const memoryOf = interface.memoryOf
    const map = interface.map
    const unmap = interface.unmap
    const submit = interface.submit
    const fence = interface.fence
    check(90, open(1) == -Status.not_found)
    const first = open(0)
    const second = open(0)
    check(91, first > 0 && second > 0 && first != second && host.living() == 2)
    const a = @intCast(u32, first)
    var device: gpucard.Device = undefined
    check(92, describeContext(a, &device) == 0 && device.device == 0x67DF)
    // Each call refused with a plain status.
    check(93, memory(a, 4096, gpucard.Memory.CARD) == -Status.unsupported)
    check(94, memoryOf(a, 0x10000, 4096) == -Status.unsupported)
    check(95, map(a, 7, 0, 4096, 0x200000, gpucard.Access.READ) == -Status.unsupported)
    check(96, unmap(a, 0x200000, 4096) == -Status.unsupported)
    var streams: [1]gpucard.Stream = undefined
    streams[0] = gpucard.Stream.{ .engine = gpucard.Engine.COMPUTE, .flags = 0, .address = 0x200000, .words = 8 }
    check(97, submit(a, @intFromPtr(&streams), 1, 0) == -Status.unsupported)
    check(98, fence(a) == -Status.unsupported)
    // A handle that is no context: the node opened to read.
    const node = host.openToRead(0)
    check(99, node > 0)
    const n = @intCast(u32, node)
    check(100, describeContext(n, &device) == 0)
    check(101, memory(n, 4096, 0) == -Status.wrong_kind && memoryOf(n, 0, 4096) == -Status.wrong_kind && map(n, 0, 0, 0, 0, 0) == -Status.wrong_kind)
    check(102, unmap(n, 0, 0) == -Status.wrong_kind && submit(n, 0, 0, 0) == -Status.wrong_kind && fence(n) == -Status.wrong_kind)
    check(103, close(n) == 0)
    // No handle, a made-up one, one closed.
    check(104, memory(0, 4096, 0) == -Status.invalid_handle && fence(0x12345) == -Status.invalid_handle && fence(0xFFFFFFFF) == -Status.invalid_handle)
    check(105, close(a) == 0 && host.living() == 1)
    check(106, fence(a) == -Status.invalid_handle && describeContext(a, &device) == -Status.invalid_handle && close(a) == -Status.invalid_handle)
    // The slot used again: the old handle stays invalid.
    const again = open(0)
    check(107, again > 0 && @intCast(u32, again) != a && (@intCast(usize, again) & 0xFF) == (@intCast(usize, a) & 0xFF))
    check(108, fence(a) == -Status.invalid_handle && fence(@intCast(u32, again)) == -Status.unsupported)
    _ = close(@intCast(u32, again))
    _ = close(@intCast(u32, second))
    check(109, host.living() == 0)
    // Every context taken: too_many; one given back, one made.
    var handles: [64]u32 = undefined
    var k: usize = 0
    var all = true
    while k < host.MOST_CONTEXTS {
        const made = open(0)
        if made <= 0 { all = false }
        handles[k] = if made > 0 { @intCast(u32, made) } else { 0 }
        k += 1
    }
    check(110, all && host.living() == 64)
    check(111, open(0) == -TOO_MANY)
    check(112, close(handles[17]) == 0 && open(0) > 0 && open(0) == -TOO_MANY)
    host.reset()
    check(113, host.living() == 0 && fence(handles[3]) == -Status.invalid_handle)
}

// std.gpucard's helpers.
fn testHelpers() -> void {
    var path: [16]u8 = undefined
    const length = gpucard.path(0, &path)
    check(120, equal(path[0..length], "/devices/gpu0"))
    const third = gpucard.path(3, &path)
    check(121, equal(path[0..third], "/devices/gpu3"))
    check(122, equal(gpucard.whyText(gpucard.Why.NOT_STARTED_YET), "the system starts none of the card's engines yet"))
    check(123, equal(gpucard.whyText(gpucard.Why.CARD_NOT_STARTED), "the firmware did not start the card"))
    check(124, equal(gpucard.whyText(gpucard.Why.OTHER_CARD), "the system knows the engines of a Polaris 10 card alone"))
    check(125, equal(gpucard.whyText(gpucard.Why.NONE), "an engine takes commands"))
    // The memory flags and the access bits as the spec numbers them.
    check(126, gpucard.Memory.CARD == 1 && gpucard.Memory.SYSTEM == 2 && gpucard.Memory.EITHER == 3 && gpucard.Memory.PROCESSOR == 0x10 && gpucard.Memory.WRITE_COMBINED == 0x20 && gpucard.Memory.ZEROED == 0x40 && gpucard.Memory.LOW == 0x80 && gpucard.Memory.SHAREABLE == 0x100)
    check(127, gpucard.Access.READ == 1 && gpucard.Access.WRITE == 2 && gpucard.Access.EXECUTE == 4)
    check(128, gpucard.Engine.GRAPHICS == 0 && gpucard.Engine.COMPUTE == 1 && gpucard.Engine.COPY == 2)
}

// The kernel's own record of the card (gpu_offer.mlx: what gpu.mlx and the
// engines' first look read): the user's RX 580 as the machine's boot gives
// it is byte for byte what the host card stands in with; a card the
// firmware did not start, another card, a boot whose engines were not
// read; the GART on; the display's picture as a mode change leaves it.
fn usersCard() -> offering.Card {
    return offering.Card.{ .present = true, .vendor = 0x1002, .device = 0x67DF, .revision = 0xE7, .pci = 0x2100, .visible = 256 * 1024 * 1024, .picture = 1280 * 960 * 4, .name = "Radeon RX 580 (Polaris 10)" }
}

var seen: engines.Engines = undefined

// What the engines' first look finds on the user's card (the ROM's
// GFX_Info 8.1: 4 shader engines, 8 tile pipes, 9 compute units an
// array, 1 array an engine, 2 render back ends an engine, 8 texture
// channel caches; its default clocks in tens of kHz).
fn usersEngines() -> *const engines.Engines {
    seen.found.started = true
    seen.found.polaris10 = true
    seen.found.vramBytes = 8192 * 1024 * 1024
    seen.found.gfxFound = true
    const gfx = [_]usize{ 1, 8, 4, 8, 9, 1, 2, 8 }
    var k: usize = 0
    while k < 8 {
        seen.found.gfx[k] = gfx[k]
        k += 1
    }
    seen.found.engineClock = 30000
    seen.found.memoryClock = 30000
    seen.m2 = engines.Outcome.not_tried
    return &seen
}

fn sameBytes(a: *const record.Facts, b: *const record.Facts) -> bool {
    var left: [record.RECORD]u8 = undefined
    var right: [record.RECORD]u8 = undefined
    record.encode(a, &left)
    record.encode(b, &right)
    var k: usize = 0
    while k < record.RECORD {
        if left[k] != right[k] { return false }
        k += 1
    }
    return true
}

fn testKernelRecord() -> void {
    const card = usersCard()
    var facts: record.Facts = undefined
    offering.gather(&card, usersEngines(), &facts)
    const stands = host.rx580(0)
    check(130, sameBytes(&facts, &stands))
    check(131, facts.graphics == 0x801 && facts.shaderEngines == 4 && facts.arraysPerEngine == 1 && facts.computeUnitsPerArray == 9 && facts.renderBackendsPerEngine == 2)
    check(132, facts.engineClock == 300000 && facts.memoryClock == 300000 && facts.memory == 8192 * 1024 * 1024 && facts.system == 256 * 1024 * 1024)
    check(133, facts.flags == record.Flag.STARTED | record.Flag.PICTURE | record.Flag.ROM_COUNTS && facts.why == record.Why.NOT_STARTED_YET && facts.computeRings == 0)
    // The GART on (the engines' second memory step passed).
    seen.m2 = engines.Outcome.passed
    offering.gather(&card, &seen, &facts)
    check(134, facts.flags & record.Flag.SYSTEM_MEMORY != 0)
    // A mode change: the picture of 3840x1080 the record gives now.
    var changed = card
    changed.picture = 3840 * 1080 * 4
    offering.gather(&changed, usersEngines(), &facts)
    check(135, facts.picture == 3840 * 1080 * 4 && facts.flags & record.Flag.PICTURE != 0)
    // No picture in this card's memory (the board's own adapter shows it).
    changed.picture = 0
    offering.gather(&changed, usersEngines(), &facts)
    check(136, facts.picture == 0 && facts.flags & record.Flag.PICTURE == 0)
    // The engines not read at this boot: a Polaris 10 all the same, its
    // memory not known.
    offering.gather(&card, null, &facts)
    check(137, facts.why == record.Why.NOT_STARTED_YET && facts.memory == 0 && facts.system == 0 && facts.flags == record.Flag.STARTED | record.Flag.PICTURE && facts.shaderEngines == 0 && facts.visible == 256 * 1024 * 1024)
    // A card the firmware did not start: nothing but what PCI says.
    var cold = card
    cold.present = false
    cold.picture = 0
    offering.gather(&cold, usersEngines(), &facts)
    check(138, facts.why == record.Why.CARD_NOT_STARTED && facts.flags == 0 && facts.memory == 0 && facts.engineClock == 0 && facts.device == 0x67DF && facts.pci == 0x2100)
    // Another card (an RX 560): no engine of it is known.
    var other = card
    other.device = 0x67EF
    seen.found.polaris10 = false
    offering.gather(&other, &seen, &facts)
    check(139, facts.why == record.Why.OTHER_CARD && facts.memory == 0 && facts.flags & record.Flag.ROM_COUNTS == 0)
}

// The kernel's table of contexts: each held by its descriptors, the last
// one closed ends it; every one taken.
fn testKernelContexts() -> void {
    var table: offering.Contexts = undefined
    table.reset()
    check(140, table.living() == 0)
    const first = table.begin(0)
    const second = table.begin(0)
    check(141, first != second && first < offering.MOST_CONTEXTS && second < offering.MOST_CONTEXTS && table.living() == 2 && table.cardOf(second) == 0)
    // A duplicate holds the first: its close leaves the context.
    table.retain(first)
    table.release(first)
    check(142, table.living() == 2)
    table.release(first)
    check(143, table.living() == 1)
    // Ended: a stray release or retain of it changes nothing.
    table.release(first)
    table.retain(first)
    check(144, table.living() == 1)
    table.release(second)
    check(145, table.living() == 0)
    var k: usize = 0
    var all = true
    while k < offering.MOST_CONTEXTS {
        if table.begin(0) >= offering.MOST_CONTEXTS { all = false }
        k += 1
    }
    check(146, all && table.begin(0) == offering.MOST_CONTEXTS && table.living() == 64)
    table.release(17)
    check(147, table.begin(0) == 17 && table.living() == 64)
    check(148, offering.MOST_CONTEXTS == host.MOST_CONTEXTS)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = arguments.length > 1
    testSpecRecord()
    testSpecCalls()
    testRoundTrip()
    testReads()
    testUsersCard()
    testContexts()
    testHelpers()
    testKernelRecord()
    testKernelContexts()
    if failed != 0 { return failed }
    return 13
}
