// std.uri and std.http.message: URIs split into their parts, references
// resolved against a base (RFC 3986's examples), normalized and written,
// percent-coding and query pairs; HTTP heads read as libsoup reads them
// (request and status lines, header lines folded, bad lines passed over),
// written, their bodies' framing and the rules of redirects. Exits 13
// when every check holds, else the number of the first check that
// failed.
const uri = @import("std.uri")
const message = @import("std.http.message")
const headers = @import("std.http.headers")

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

const Written = struct {
    bytes: [1024]u8
    length: usize
}

fn append(context: usize, bytes: []const u8) -> void {
    const w: *Written = unsafe { @ptrFromInt(*Written, context) }
    var index: usize = 0
    while index < bytes.length {
        if w.*.length < 1024 {
            w.*.bytes[w.*.length] = bytes[index]
            w.*.length += 1
        }
        index += 1
    }
}

fn uriSink(w: *Written) -> uri.Sink {
    w.*.length = 0
    return uri.Sink.{ .context = @intFromPtr(w), .write = append }
}

fn headerSink(w: *Written) -> headers.Sink {
    w.*.length = 0
    return headers.Sink.{ .context = @intFromPtr(w), .write = append }
}

fn written(w: *Written) -> []const u8 { return w.*.bytes[0..w.*.length] }

fn resolves(base: *const uri.Uri, reference: []const u8, expected: []const u8) -> bool {
    var out: [512]u8 = undefined
    const n = uri.resolve(base, reference, out[0..512])
    return same(out[0..n], expected)
}

pub fn main() -> u8 {
    var w: Written = undefined
    var u: uri.Uri = undefined

    // Parts.
    if !uri.parse("https://user:pw@Example.com:8443/a/b%20c?q=1&r#top", &u) { return 1 }
    if !same(u.scheme, "https") || !same(u.userinfo, "user:pw") || !same(u.host, "Example.com") || !same(u.port, "8443") || !same(u.path, "/a/b%20c") || !same(u.query, "q=1&r") || !same(u.fragment, "top") { return 2 }
    if !u.hasScheme || !u.hasAuthority || !u.hasUserinfo || !u.hasPort || !u.hasQuery || !u.hasFragment || uri.portOf(&u) != 8443 || uri.usesDefaultPort(&u) { return 3 }
    if !uri.parse("http://[::1]:8080/", &u) || !same(u.host, "[::1]") || !same(uri.hostName(&u), "::1") || uri.portOf(&u) != 8080 { return 4 }
    if !uri.parse("http://example.com", &u) || !same(u.host, "example.com") || u.path.length != 0 || u.hasPort || uri.portOf(&u) != 80 || !uri.usesDefaultPort(&u) { return 5 }
    if !uri.parse("/relative/path?x", &u) || u.hasScheme || u.hasAuthority || !same(u.path, "/relative/path") || !same(u.query, "x") { return 6 }
    if !uri.parse("mailto:a@b.c", &u) || !same(u.scheme, "mailto") || u.hasAuthority || !same(u.path, "a@b.c") { return 7 }
    if uri.parse("http://host:12a/", &u) || uri.parse("http://[::1/", &u) || uri.parse("http://h/a b", &u) || uri.parse("http://h/%zz", &u) { return 8 }
    if !uri.parse("file:///etc/hosts", &u) || !u.hasAuthority || u.host.length != 0 || !same(u.path, "/etc/hosts") { return 9 }
    if !uri.parse("//h/p", &u) || u.hasScheme || !same(u.host, "h") || !same(u.path, "/p") { return 10 }
    if !uri.parse("x:?q", &u) || !same(u.scheme, "x") || u.path.length != 0 || !same(u.query, "q") { return 11 }

    // Written back, normalized, the target and the Host header.
    if !uri.parse("HTTP://Example.COM:80/?q#f", &u) { return 12 }
    uri.write(uriSink(&w), &u)
    if !same(written(&w), "HTTP://Example.COM:80/?q#f") { return 14 }
    uri.writeNormalized(uriSink(&w), &u)
    if !same(written(&w), "http://example.com/?q") { return 15 }
    if !uri.parse("http://h:8080", &u) { return 16 }
    uri.writeNormalized(uriSink(&w), &u)
    if !same(written(&w), "http://h:8080/") { return 17 }
    uri.writeTarget(uriSink(&w), &u)
    if !same(written(&w), "/") { return 18 }
    uri.writeHostHeader(uriSink(&w), &u)
    if !same(written(&w), "h:8080") { return 19 }
    if !uri.parse("https://h:443/p?a=b", &u) { return 20 }
    uri.writeHostHeader(uriSink(&w), &u)
    if !same(written(&w), "h") { return 21 }
    uri.writeTarget(uriSink(&w), &u)
    if !same(written(&w), "/p?a=b") { return 22 }
    var v: uri.Uri = undefined
    if !uri.parse("HTTPS://H/other", &v) || !uri.sameOrigin(&u, &v) || !uri.parse("http://h/", &v) || uri.sameOrigin(&u, &v) { return 23 }

    // RFC 3986 5.4's examples.
    var base: uri.Uri = undefined
    if !uri.parse("http://a/b/c/d;p?q", &base) { return 24 }
    if !resolves(&base, "g:h", "g:h") || !resolves(&base, "g", "http://a/b/c/g") || !resolves(&base, "./g", "http://a/b/c/g") || !resolves(&base, "g/", "http://a/b/c/g/") { return 25 }
    if !resolves(&base, "/g", "http://a/g") || !resolves(&base, "//g", "http://g") || !resolves(&base, "?y", "http://a/b/c/d;p?y") || !resolves(&base, "g?y", "http://a/b/c/g?y") { return 26 }
    if !resolves(&base, "#s", "http://a/b/c/d;p?q#s") || !resolves(&base, "g#s", "http://a/b/c/g#s") || !resolves(&base, "g?y#s", "http://a/b/c/g?y#s") || !resolves(&base, ";x", "http://a/b/c/;x") { return 27 }
    if !resolves(&base, "g;x", "http://a/b/c/g;x") || !resolves(&base, "g;x?y#s", "http://a/b/c/g;x?y#s") || !resolves(&base, "", "http://a/b/c/d;p?q") || !resolves(&base, ".", "http://a/b/c/") { return 28 }
    if !resolves(&base, "./", "http://a/b/c/") || !resolves(&base, "..", "http://a/b/") || !resolves(&base, "../", "http://a/b/") || !resolves(&base, "../g", "http://a/b/g") { return 29 }
    if !resolves(&base, "../..", "http://a/") || !resolves(&base, "../../", "http://a/") || !resolves(&base, "../../g", "http://a/g") { return 30 }
    if !resolves(&base, "../../../g", "http://a/g") || !resolves(&base, "../../../../g", "http://a/g") || !resolves(&base, "/./g", "http://a/g") || !resolves(&base, "/../g", "http://a/g") { return 31 }
    if !resolves(&base, "g.", "http://a/b/c/g.") || !resolves(&base, ".g", "http://a/b/c/.g") || !resolves(&base, "g..", "http://a/b/c/g..") || !resolves(&base, "..g", "http://a/b/c/..g") { return 32 }
    if !resolves(&base, "./../g", "http://a/b/g") || !resolves(&base, "./g/.", "http://a/b/c/g/") || !resolves(&base, "g/./h", "http://a/b/c/g/h") || !resolves(&base, "g/../h", "http://a/b/c/h") { return 33 }
    if !resolves(&base, "g;x=1/./y", "http://a/b/c/g;x=1/y") || !resolves(&base, "g;x=1/../y", "http://a/b/c/y") || !resolves(&base, "g?y/./x", "http://a/b/c/g?y/./x") || !resolves(&base, "g#s/../x", "http://a/b/c/g#s/../x") { return 34 }
    if !resolves(&base, "http:g", "http:g") { return 35 }
    if !uri.parse("http://h", &base) || !resolves(&base, "x", "http://h/x") || !resolves(&base, "../x", "http://h/x") { return 36 }
    var out: [8]u8 = undefined
    if uri.resolve(&base, "/a/very/long/path", out[0..8]) != 0 || uri.resolve(&base, "ht tp", out[0..8]) != 0 { return 37 }

    // Percent-coding and query pairs.
    var decoded: [64]u8 = undefined
    var n = uri.decode("a%20b+c%2F", decoded[0..64], true)
    if n != 6 || !same(decoded[0..6], "a b c/") { return 38 }
    if uri.decode("%2", decoded[0..64], false) != -1 || uri.decode("%zz", decoded[0..64], false) != -1 { return 39 }
    uri.encode(uriSink(&w), "a b/\u{e9}~", "/")
    if !same(written(&w), "a%20b/%C3%A9~") { return 40 }
    var at: usize = 0
    var name: []const u8 = ""
    var value: []const u8 = ""
    var hasValue = false
    if !uri.nextPair("a=1&&b;c=", &at, &name, &value, &hasValue) || !same(name, "a") || !same(value, "1") { return 41 }
    if !uri.nextPair("a=1&&b;c=", &at, &name, &value, &hasValue) || !same(name, "b") || hasValue { return 42 }
    if !uri.nextPair("a=1&&b;c=", &at, &name, &value, &hasValue) || !same(name, "c") || !hasValue || value.length != 0 { return 43 }
    if uri.nextPair("a=1&&b;c=", &at, &name, &value, &hasValue) { return 44 }

    // Request lines.
    var request: message.RequestLine = undefined
    const head = "\r\nGET /index.html?x HTTP/1.1\r\nHost: h\r\nX-Folded: one\r\n two\r\n\tthree  \r\nbad line\r\n :nothing\r\nName with space: v\r\nLast: v\r\n\r\n"
    if !message.parseRequestLine(head, &request) || request.status != 200 || !same(request.method, "GET") || !same(request.target, "/index.html?x") || request.version != message.Version.http11 { return 45 }
    if message.parseRequestLine("GET /", &request) || request.status != 400 { return 46 }
    if message.parseRequestLine("GET / HTTP/2.0\r\n", &request) || request.status != 505 { return 47 }
    if !message.parseRequestLine("GET / HTTP/1.0\n", &request) || request.version != message.Version.http10 { return 48 }
    if message.parseRequestLine("GET / HTTP/1.1 extra\r\n", &request) || request.status != 400 { return 49 }
    // Header lines.
    var it = message.headerLinesFrom(head, request.headersAt)
    var folded: [256]u8 = undefined
    if !message.nextHeader(&it, &name, &value, folded[0..256]) || !same(name, "Host") || !same(value, "h") { return 50 }
    if !message.nextHeader(&it, &name, &value, folded[0..256]) || !same(name, "X-Folded") || !same(value, "one two three") { return 51 }
    if !message.nextHeader(&it, &name, &value, folded[0..256]) || !same(name, "Last") || !same(value, "v") { return 52 }
    if message.nextHeader(&it, &name, &value, folded[0..256]) || it.truncated { return 53 }
    it = message.headerLines("HTTP/1.1 200 OK\r\nA: 1\r\nB: 2")
    if !message.nextHeader(&it, &name, &value, folded[0..256]) || !same(name, "A") { return 54 }
    if message.nextHeader(&it, &name, &value, folded[0..256]) || !it.truncated { return 55 }
    if message.headEnd("HTTP/1.1 200 OK\r\nA: 1\r\n\r\nbody") != 25 || message.headEnd("A: 1\n\nx") != 6 || message.headEnd("A: 1\r\n") != 6 { return 56 }
    // Status lines.
    var status: message.StatusLine = undefined
    if !message.parseStatusLine("HTTP/1.1 404 Not Found \r\n", &status) || status.code != 404 || !same(status.phrase, "Not Found") || status.version != message.Version.http11 { return 57 }
    if !message.parseStatusLine("HTTP/1.0 200", &status) || status.code != 200 || status.phrase.length != 0 || status.version != message.Version.http10 { return 58 }
    if !message.parseStatusLine("ICY 200 OK", &status) || status.code != 200 { return 59 }
    if message.parseStatusLine("HTTP/1.1 99 x", &status) || message.parseStatusLine("HTTP/1.1 2000 x", &status) || message.parseStatusLine("HTTP/3 200 x", &status) || message.parseStatusLine("nope", &status) { return 60 }
    // Written.
    message.writeRequestLine(headerSink(&w), "POST", "/a", message.Version.http11)
    message.writeHeader(headerSink(&w), "Host", "h")
    const s = headers.Sink.{ .context = @intFromPtr(&w), .write = append }
    w.length = 0
    message.writeRequestLine(s, "POST", "/a", message.Version.http11)
    message.writeHeader(s, "Host", "h")
    message.writeHeadEnd(s)
    if !same(written(&w), "POST /a HTTP/1.1\r\nHost: h\r\n\r\n") { return 61 }
    message.writeStatusLine(headerSink(&w), message.Version.http10, 404, "Not Found")
    if !same(written(&w), "HTTP/1.0 404 Not Found\r\n") { return 62 }

    // Framing and redirects.
    var length: u64 = 0
    var bad = false
    if message.framingOf("chunked", true, "12", true, true, &length, &bad) != message.Framing.chunked { return 63 }
    if message.framingOf("", false, "12", true, true, &length, &bad) != message.Framing.length || length != 12 || bad { return 64 }
    if message.framingOf("", false, "1x", true, true, &length, &bad) != message.Framing.eof || !bad { return 65 }
    if message.framingOf("", false, "", false, true, &length, &bad) != message.Framing.eof || message.framingOf("", false, "", false, false, &length, &bad) != message.Framing.none { return 66 }
    if !message.responseHasNoBody(204, "GET") || !message.responseHasNoBody(200, "HEAD") || !message.responseHasNoBody(101, "GET") || message.responseHasNoBody(200, "GET") { return 67 }
    if message.redirectOf(303, "POST") != message.Redirect.asGet || message.redirectOf(302, "POST") != message.Redirect.asGet || message.redirectOf(301, "POST") != message.Redirect.asGet { return 68 }
    if message.redirectOf(302, "GET") != message.Redirect.same || message.redirectOf(308, "HEAD") != message.Redirect.same || message.redirectOf(307, "POST") != message.Redirect.none || message.redirectOf(200, "GET") != message.Redirect.none || message.redirectOf(304, "GET") != message.Redirect.none { return 69 }
    return 13
}
