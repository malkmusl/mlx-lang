// std.sql, the SQLite-compatible engine (compiler/libc/sqlite3 is the C
// API over it): SQLite's texts for reals and its reading of numbers;
// the SQL statements of WebKit's databases parsed (the corpus
// compiler/libc/sqlite3/tests/webkit_corpus.h holds, read from the
// file); statements run on a memory database (expressions, GROUP BY,
// indexes, joins, collations, a CHECK constraint's error); a file of
// thousands of rows written, closed and read again, its integrity checked.
// What SQLite answers is in each check. Exits 13 when every check holds,
// else the number of the first check that failed.
const std = @import("std")
const sql = @import("std.sql")
const parser = @import("std.sql.parser")
const ast = @import("std.sql.ast")
const gpa = std.general_purpose_allocator

const mem = sql.mem
const value = sql.value
const engine = sql.engine
const core = sql.core
const numbers = sql.numbers

var heap: gpa.Heap = undefined

fn sameText(a: []const u8, b: []const u8) -> bool { return mem.same(a, b) }

// SQLite's text for a real.
fn realIs(r: f64, expected: []const u8) -> bool {
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = numbers.appendReal(&b, r)
    const good = sameText(mem.bufferText(&b), expected)
    mem.freeBuffer(&b)
    return good
}

// The rows of the statements of `text` as "a|b;c|d" (NULL for NULL, the
// error message for an error).
var rows: mem.Buffer = undefined

fn answer(db: usize, text: []const u8) -> []const u8 {
    rows.length = 0
    var at: usize = 0
    while at < text.length {
        var st: usize = 0
        var tail: usize = 0
        const rc = engine.prepare(core.database(db), @intFromPtr(text.pointer) + at, text.length - at, &st, &tail)
        if rc != core.OK {
            _ = mem.appendText(&rows, mem.bufferText(&core.database(db).*.message))
            return mem.bufferText(&rows)
        }
        at += tail
        if st == 0 { continue }
        while true {
            const s = engine.step(st)
            if s == core.ROW {
                if rows.length > 0 { _ = mem.appendText(&rows, ";") }
                var i: usize = 0
                while i < engine.columnCount(st) {
                    if i > 0 { _ = mem.appendText(&rows, "|") }
                    const v = engine.column(st, i)
                    if v.*.kind == value.NULL {
                        _ = mem.appendText(&rows, "NULL")
                    } else if v.*.kind == value.INTEGER || v.*.kind == value.REAL {
                        _ = value.appendNumber(&rows, v)
                    } else {
                        _ = mem.append(&rows, v.*.data, v.*.length)
                    }
                    i += 1
                }
                continue
            }
            if s != core.DONE {
                rows.length = 0
                _ = mem.appendDecimal(&rows, @intCast(i64, core.database(db).*.errorCode))
                _ = mem.appendText(&rows, " ")
                _ = mem.appendText(&rows, mem.bufferText(&core.database(db).*.message))
                _ = engine.finalize(st)
                return mem.bufferText(&rows)
            }
            break
        }
        _ = engine.finalize(st)
    }
    return mem.bufferText(&rows)
}

// The C string literal at `at` in `text` (escapes undone) into `out`;
// where it ends.
fn cString(text: usize, length: usize, at: usize, out: *mem.Buffer) -> usize {
    var i = at + 1
    out.*.length = 0
    while i < length && mem.get8(text + i) != 34 {
        var c = mem.get8(text + i)
        if c == 92 && i + 1 < length {
            i += 1
            c = mem.get8(text + i)
        }
        _ = mem.appendByte(out, c)
        i += 1
    }
    return i + 1
}

// Parses every statement of the corpus file: how many there are, and how
// many failed.
fn parseCorpus(path: []const u8, failed: *usize) -> usize {
    failed.* = 0
    const fd = sql.os.openFile(mem.dupText(path), false, false)
    if fd < 0 { return 0 }
    const size = @intCast(usize, sql.os.sizeOf(fd))
    const text = mem.alloc(size + 1)
    if !sql.os.readAt(fd, text, size, 0) { return 0 }
    sql.os.closeFile(fd)
    var statement: mem.Buffer = undefined
    mem.initBuffer(&statement)
    var total: usize = 0
    var i: usize = 0
    // Each entry: { "file", line, "statement" },
    while i + 6 < size {
        if mem.get8(text + i) == 123 && mem.get8(text + i + 1) == 32 && mem.get8(text + i + 2) == 34 {
            var at = cString(text, size, i + 2, &statement)
            while at < size && mem.get8(text + at) != 34 && mem.get8(text + at) != 10 { at += 1 }
            if at < size && mem.get8(text + at) == 34 {
                at = cString(text, size, at, &statement)
                total += 1
                var arena: ast.Arena = undefined
                ast.initArena(&arena)
                var p: parser.Parser = undefined
                parser.init(&p, &arena, statement.data, statement.length)
                const node = parser.parseStatement(&p)
                if p.failed || node == 0 { failed.* += 1 }
                parser.deinit(&p)
                ast.freeArena(&arena)
            }
            i = at
            continue
        }
        i += 1
    }
    mem.freeBuffer(&statement)
    mem.free(text)
    return total
}

pub fn main() -> u8 {
    heap = gpa.init(std.page_allocator.init())
    sql.use(gpa.interface(&heap))
    mem.initBuffer(&rows)

    // Reals as SQLite writes them ("%!.15g"), numbers as it reads them.
    if !realIs(0.1, "0.1") || !realIs(100.0, "100.0") || !realIs(1.0e300, "1.0e+300") { return 1 }
    if !realIs(3.14159265358979, "3.14159265358979") || !realIs(0.0 - 2.5e-7, "-2.5e-07") || !realIs(123456789012345678.0, "1.23456789012346e+17") { return 2 }
    var parsed: numbers.Parsed = undefined
    const spaced = "  42  "
    numbers.parse(@intFromPtr(spaced.pointer), spaced.length, &parsed)
    if parsed.kind != numbers.INTEGER || !parsed.whole || parsed.integer != 42 { return 3 }
    const prefix = "12abc"
    numbers.parse(@intFromPtr(prefix.pointer), prefix.length, &parsed)
    if parsed.whole || parsed.integer != 12 { return 4 }

    // WebKit's statements parse, but for the 13 SQLite's parser refuses
    // too (texts WebKit completes at run time: format strings, parameter
    // lists).
    var failed: usize = 0
    const total = parseCorpus("compiler/libc/sqlite3/tests/webkit_corpus.h", &failed)
    if total != 409 { return 5 }
    if failed != 13 { return 6 }

    var db: usize = 0
    if engine.open(":memory:", engine.OPEN_READWRITE | engine.OPEN_CREATE, &db) != core.OK { return 7 }
    if !sameText(answer(db, "SELECT 1 + 2, 'a' || 'b', 7 / 2, 7 / 2.0, NULL IS NULL, typeof(1e3), CAST('12abc' AS INTEGER);"), "3|ab|3|3.5|1|real|12") { return 8 }
    _ = answer(db, "CREATE TABLE p(id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE, dept INTEGER CHECK (dept > 0)); CREATE INDEX p_name ON p(name);")
    _ = answer(db, "INSERT INTO p(name, dept) VALUES ('bob', 1), ('Ann', 1), ('cy', 2), ('Dee', 2), ('eve', 3);")
    if !sameText(answer(db, "SELECT dept, count(*), group_concat(name) FROM p GROUP BY dept ORDER BY dept;"), "1|2|bob,Ann;2|2|cy,Dee;3|1|eve") { return 9 }
    if !sameText(answer(db, "SELECT name FROM p ORDER BY name;"), "Ann;bob;cy;Dee;eve") { return 10 }
    if !sameText(answer(db, "SELECT id FROM p WHERE name = 'ANN';"), "2") { return 11 }
    if !sameText(answer(db, "INSERT INTO p(name, dept) VALUES ('zed', 0);"), "275 CHECK constraint failed: dept > 0") { return 12 }
    if !sameText(answer(db, "SELECT a.name, b.name FROM p a JOIN p b ON a.dept = b.dept AND a.id < b.id ORDER BY a.id;"), "bob|Ann;cy|Dee") { return 13 }
    if !sameText(answer(db, "SELECT max(id), sum(dept), avg(dept) FROM p WHERE name LIKE '%e%';"), "5|5|2.5") { return 14 }
    _ = engine.close(db, false)

    // A file: written, closed, read again.
    const path = "/tmp/mlx-372-sql.db"
    _ = sql.os.remove(mem.dupText(path))
    if engine.open(path, engine.OPEN_READWRITE | engine.OPEN_CREATE, &db) != core.OK { return 15 }
    _ = answer(db, "PRAGMA page_size = 1024; CREATE TABLE t(id INTEGER PRIMARY KEY, k TEXT, v BLOB); CREATE INDEX t_k ON t(k); BEGIN;")
    var i: usize = 0
    var statement: mem.Buffer = undefined
    mem.initBuffer(&statement)
    while i < 3000 {
        statement.length = 0
        _ = mem.appendText(&statement, "INSERT INTO t(k, v) VALUES ('key-")
        _ = mem.appendDecimal(&statement, @intCast(i64, (i * 7919) % 3000))
        _ = mem.appendText(&statement, "', zeroblob(")
        _ = mem.appendDecimal(&statement, @intCast(i64, (i * 37) % 1500))
        _ = mem.appendText(&statement, "));")
        _ = answer(db, mem.bufferText(&statement))
        i += 1
    }
    mem.freeBuffer(&statement)
    _ = answer(db, "COMMIT; DELETE FROM t WHERE id % 4 = 0;")
    _ = engine.close(db, false)
    if engine.open(path, engine.OPEN_READWRITE, &db) != core.OK { return 16 }
    if !sameText(answer(db, "PRAGMA integrity_check;"), "ok") { return 17 }
    if !sameText(answer(db, "SELECT count(*), sum(length(v)), max(k) FROM t;"), "2250|1685250|key-999") { return 18 }
    if !sameText(answer(db, "SELECT id FROM t WHERE k = 'key-1234';"), "1887") { return 19 }
    if !sameText(answer(db, "PRAGMA page_size;"), "1024") { return 20 }
    _ = engine.close(db, false)
    _ = sql.os.remove(mem.dupText(path))
    return 13
}
