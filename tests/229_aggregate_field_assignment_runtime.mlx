// Aggregate field assignment copies the value bytes rather than its address.
const Pair = struct {
    left: u8
    right: u8
}

const Holder = struct {
    pair: Pair
    sentinel: u8
}

fn main() -> u8 {
    var holder = Holder.{ .pair = Pair.{ .left = 1, .right = 2 }, .sentinel = 7 }
    const initialized = holder.pair.left + holder.pair.right + holder.sentinel
    const replacement = Pair.{ .left = 13, .right = 22 }
    holder.pair = replacement
    return initialized + holder.pair.left + holder.pair.right + holder.sentinel
}
