// A function returning a struct, union or array by value writes it into
// storage its caller provides (lir.FLAG_RETURN_SLOT): through chains of
// calls that return a call's result, from a parameter, past defers, by
// pointer and generic calls, with arguments on the stack, and in loops,
// where results kept by value need no arena. Exits 13.
const turns = @import("std.turns")

const Point = struct { x: i64, y: i64 }
const Wide = struct { a: u64, b: u64, c: u64, d: u64, e: u64 }
const Shape = union(enum(u8)) {
    dot: Point,
    wide: Wide
}

const Maker = fn(i64) -> Point

var kept: *Point = undefined

fn made(x: i64) -> Point { return Point.{ .x = x, .y = x * 2 } }
fn forwarded(x: i64) -> Point { return made(x + 1) }
fn twice(x: i64) -> Point { return forwarded(forwarded(x).y) }
fn same(p: Point) -> Point { return p }
fn swapped(p: Point) -> Point {
    const q = Point.{ .x = p.y, .y = p.x }
    return q
}

// The value returned is the one `return` saw; a defer changing the local
// afterwards does not reach the caller.
fn deferred() -> Point {
    var p = Point.{ .x = 1, .y = 2 }
    defer p.x = 99
    return p
}

fn branches(flag: bool) -> Point {
    if flag { return made(3) }
    var p = made(4)
    p.y += 1
    return p
}

fn countdown(n: i64) -> Point {
    if n == 0 { return Point.{ .x = 0, .y = 0 } }
    const below = countdown(n - 1)
    return Point.{ .x = below.x + n, .y = below.y + 1 }
}

fn spread(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: f64) -> Wide {
    return Wide.{ .a = a + b, .b = c + d, .c = e + f, .d = g, .e = @intFromFloat(u64, h) }
}

fn triple(seed: u32) -> [3]u32 { return [3]u32{ seed, seed + 1, seed + 2 } }

fn shaped(wide: bool) -> Shape {
    if wide { return Shape.{ .wide = Wide.{ .a = 1, .b = 2, .c = 3, .d = 4, .e = 5 } } }
    return Shape.{ .dot = Point.{ .x = 7, .y = 8 } }
}

fn pick(comptime T: type, first: T, second: T, take_first: bool) -> T {
    if take_first { return first }
    return second
}

fn through(maker: Maker, x: i64) -> Point { return maker(x) }

fn sumLoop(count: i64) -> i64 {
    var total: i64 = 0
    var i: i64 = 0
    while i < count {
        const p = made(i)
        total += p.x + p.y
        i += 1
    }
    return total
}

fn keepsOlder(count: i64) -> i64 {
    var points: [4]Point = undefined
    var i: i64 = 0
    while i < count {
        points[@intCast(usize, i)] = made(i)
        i += 1
    }
    return points[0].y + points[1].y + points[2].y + points[3].y
}

fn used(base: usize) -> usize { return if base == 0 { 0 } else { turns.used(base) } }

pub fn main() -> u8 {
    const base = turns.locate()
    const a = made(5)
    if a.x != 5 || a.y != 10 { return 1 }
    const b = forwarded(5)
    if b.x != 6 || b.y != 12 { return 2 }
    // forwarded(4) is (5, 10); forwarded(10) is (11, 22).
    const c = twice(4)
    if c.x != 11 || c.y != 22 { return 3 }
    var original = Point.{ .x = 1, .y = 2 }
    const copy = same(original)
    original.x = 50
    if copy.x != 1 || copy.y != 2 { return 4 }
    const turned = swapped(copy)
    if turned.x != 2 || turned.y != 1 { return 5 }
    const later = deferred()
    if later.x != 1 { return 6 }
    const first = branches(true)
    const second = branches(false)
    if first.y != 6 || second.y != 9 { return 7 }
    const sum = countdown(10)
    if sum.x != 55 || sum.y != 10 { return 8 }
    const wide = spread(1, 2, 3, 4, 5, 6, 7, 8.0)
    if wide.a != 3 || wide.b != 7 || wide.c != 11 || wide.d != 7 || wide.e != 8 { return 9 }
    const three = triple(40)
    if three[0] + three[1] + three[2] != 123 { return 10 }
    const dot = shaped(false)
    const box = shaped(true)
    var shapes: u64 = 0
    match dot {
        .dot => { shapes += @intCast(u64, dot.dot.x) },
        .wide => { shapes += 100 }
    }
    match box {
        .dot => { shapes += 1000 },
        .wide => { shapes += box.wide.e }
    }
    if shapes != 12 { return 11 }
    const picked = pick(Point, made(1), made(2), false)
    if picked.x != 2 { return 12 }
    const maker: Maker = forwarded
    const indirect = through(maker, 9)
    if indirect.x != 10 || indirect.y != 20 { return 14 }
    // Results kept by value in a loop: 3 * (0 + 1 + ... + 99).
    var before = used(base)
    if sumLoop(100) != 14850 { return 15 }
    if used(base) != before { return 16 }
    if keepsOlder(4) != 12 { return 17 }
    // A result whose address outlives the caller's frame keeps the arena.
    before = used(base)
    var global = made(21)
    kept = &global
    if base != 0 && used(base) == before { return 18 }
    if kept.*.y != 42 { return 19 }
    return 13
}
