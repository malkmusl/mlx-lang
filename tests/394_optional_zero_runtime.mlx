// An optional integer holding 0 is not null: `?usize`, `?u8` and `?u32`
// carry a tag after the payload (as a second word in registers, as the
// byte after the payload in memory), as does an optional struct (its
// address, the tag byte after the struct). An optional pointer stays the
// pointer (null: 0). Returned, held in locals and in fields, assigned,
// compared with null and unwrapped. Exits 13 on success (a bit per
// failing case otherwise).
const Pair = struct {
    a: u8
    b: u8
}

fn findZero(wanted: u8) -> ?usize {
    if wanted == 0 { return 0 }
    return null
}

fn findByte(wanted: u8) -> ?u8 {
    if wanted == 0 { return 0 }
    return null
}

fn findPair(wanted: u8) -> ?Pair {
    if wanted == 0 { return Pair.{ .a = 0, .b = 0 } }
    return null
}

var slot: u8 = 0

fn findPointer(wanted: u8) -> ?*u8 {
    if wanted == 0 { return &slot }
    return null
}

fn negative(present: bool) -> ?i32 {
    if present { return -5 }
    return null
}

const Holder = struct {
    count: ?u32
    pair: ?Pair
    sizes: [2]?usize
}

var global_count: ?u32 = 0
var global_none: ?u32 = null

fn total(values: [3]?u8) -> u8 {
    var sum: u8 = 0
    var index: usize = 0
    while index < 3 {
        if values[index] != null { sum += values[index].? }
        index += 1
    }
    return sum
}

fn main() -> u8 {
    var failures: u8 = 0
    const found = findZero(0)
    if found == null { failures |= 1 }
    if found != null && found.? != 0 { failures |= 1 }
    const missing = findZero(1)
    if missing != null { failures |= 2 }
    const byte = findByte(0)
    if byte == null || byte.? != 0 { failures |= 4 }
    const pair = findPair(0)
    if pair == null { failures |= 8 }
    if pair != null && pair.?.a != 0 { failures |= 8 }
    const none_pair = findPair(1)
    if none_pair != null { failures |= 16 }
    const pointer = findPointer(0)
    if pointer == null || pointer.?.* != 0 { failures |= 32 }
    if findPointer(1) != null { failures |= 32 }
    var stored: ?usize = 0
    if stored == null { failures |= 64 }
    stored = null
    if stored != null { failures |= 64 }
    stored = 7
    if stored == null || stored.? != 7 { failures |= 64 }
    var holder = Holder.{ .count = 0, .pair = null, .sizes = [2]?usize{ 0, null } }
    if holder.count == null || holder.pair != null { failures |= 128 }
    if holder.sizes[0] == null || holder.sizes[1] != null { failures |= 128 }
    holder.count = null
    holder.pair = Pair.{ .a = 1, .b = 2 }
    if holder.count != null || holder.pair == null || holder.pair.?.b != 2 { failures |= 128 }
    if global_count == null || global_count.? != 0 || global_none != null { failures |= 128 }
    const below = negative(true)
    if below == null || below.? != -5 || below.? >= 0 { failures |= 128 }
    if negative(false) != null { failures |= 128 }
    if total([3]?u8{ 0, null, 5 }) != 5 { failures |= 128 }
    var chosen: ?u32 = null
    if found != null { chosen = 0 }
    if chosen == null { failures |= 128 }
    if failures != 0 { return failures }
    return 13
}
