// A misspelt local and a function nothing declares: each is reported as
// an unknown name (MLX-E3001) at its use, the local with the name in scope
// it is closest to as help, before the statement's own error. Older
// compilers said only "invalid local declaration" or "return value does
// not match function type".
fn half(value: f64) -> f64 { return halve(value) }

pub fn main() -> u8 {
    const total: u32 = 3
    const more = totl + 1
    return @intCast(u8, more)
}
