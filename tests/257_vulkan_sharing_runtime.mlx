// The Vulkan example plumbing (examples/vulkan-shared) on a real driver
// (tests/run_vulkan.sh: lavapipe): the pattern shader renders into imported
// host memory (a memfd mapping, as a wl_shm pool), the blit shader
// composites from a memfd imported as a dma-buf (the compositor's
// linux-dmabuf path) into a device buffer, and a dma-buf is exported when
// the driver can. Exits 13.
const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const wl = @import("std.wayland")
const gpu = @import("../examples/vulkan-shared/gpu.mlx")
const shaders = @import("../examples/vulkan-shared/shaders.mlx")

const WIDTH: u32 = 64
const HEIGHT: u32 = 48

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var driver: loader.Driver = undefined
    if loader.openFirstDriver(&driver, arguments, allocator) != loader.Status.ok { return 1 }
    var options = gpu.defaultOptions(@ptrCast([*]const u8, "sharing"))
    options.wantSharing = true
    var context: gpu.Context = undefined
    if gpu.open(&context, driver, &options, allocator) != gpu.Status.ok { return 2 }
    if !context.dmaBufImport || !context.hostMemory { return 3 }

    var pattern_code: [*]u32 = undefined
    const pattern_words = shaders.build(allocator, 0, &pattern_code)
    var pattern: gpu.Kernel = undefined
    if !gpu.createKernel(&context, &pattern, pattern_code, pattern_words, 1, shaders.PATTERN_WORDS) { return 4 }
    var blit_code: [*]u32 = undefined
    const blit_words = shaders.build(allocator, 1, &blit_code)
    var blit: gpu.Kernel = undefined
    if !gpu.createKernel(&context, &blit, blit_code, blit_words, 2, shaders.BLIT_WORDS) { return 5 }

    // Render into a memfd mapping, as into a wl_shm pool.
    var pool: wl.SharedMemory = undefined
    if !wl.transport.createSharedMemory(&pool, 16384) { return 6 }
    var host: gpu.Buffer = undefined
    if !gpu.importHostMemory(&context, &host, pool.address, 16384) { return 7 }
    var push = shaders.Pattern.{ .width = WIDTH, .height = HEIGHT, .time = 10, .pointerX = 32, .pointerY = 24, .flags = shaders.FLAG_POINTER }
    var one: [1]vk.Buffer = [1]vk.Buffer{ host.buffer }
    if !gpu.begin(&context) { return 8 }
    unsafe { if !gpu.dispatch(&context, &pattern, @ptrCast([*]const vk.Buffer, &one), &push, gpu.groups(WIDTH, 8), gpu.groups(HEIGHT, 8)) { return 9 } }
    if !gpu.submit(&context) { return 10 }
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrCast([*]u32, pool.bytes()) }
    // (0, 0): red 10, green 5, blue 20.
    if pixels[0] != 4278846740 { return 11 }
    // On the ring (30 pixels right of the pointer): amber 0xFFFFD040.
    if pixels[24 * WIDTH + 62] != 4294955072 { return 12 }

    // Composite a memfd offered as a dma-buf into a device buffer.
    var client: wl.SharedMemory = undefined
    if !wl.transport.createSharedMemory(&client, 4096) { return 14 }
    var source: [*]u32 = undefined
    unsafe { source = @ptrCast([*]u32, client.bytes()) }
    var index: u32 = 0
    while index < 256 {
        source[index] = 4278190080 | index
        index += 1
    }
    source[256] = 2151686160
    source[257] = 2151686160
    var imported: gpu.Buffer = undefined
    const duplicate = @bitCast(i32, @intCast(u32, std.linux.syscall1(32, @bitCast(usize, client.handle.descriptor))))
    if !gpu.importBuffer(&context, &imported, duplicate, 4096) { return 15 }
    var output: gpu.Buffer = undefined
    if !gpu.createBuffer(&context, &output, @intCast(u64, WIDTH * HEIGHT * 4), false) { return 16 }
    var blit_push = shaders.Blit.{ .sourceWidth = 16, .sourceHeight = 16, .sourceStride = 16, .sourceOffset = 0, .targetWidth = WIDTH, .targetHeight = HEIGHT, .targetX = 4294967292, .targetY = 40, .flags = shaders.FLAG_OPAQUE, .targetOffset = 0 }
    var two: [2]vk.Buffer = [2]vk.Buffer{ imported.buffer, output.buffer }
    if !gpu.begin(&context) { return 17 }
    unsafe { if !gpu.dispatch(&context, &blit, @ptrCast([*]const vk.Buffer, &two), &blit_push, 2, 2) { return 18 } }
    if !gpu.submit(&context) { return 19 }
    var out: [*]u32 = undefined
    unsafe { out = @ptrFromInt([*]u32, output.address) }
    // Target (0, 40) is source (4, 0); target (11, 47) is source (15, 7);
    // rows below 40 and columns from 12 on are untouched (zero).
    if out[40 * WIDTH] != 4278190084 { return 20 }
    if out[47 * WIDTH + 11] != 4278190080 | (7 * 16 + 15) { return 21 }
    if out[39 * WIDTH] != 0 || out[40 * WIDTH + 12] != 0 { return 22 }

    // Premultiplied blending of a solid (stride 0) half-transparent
    // rectangle, placed through targetOffset and clipped to one row:
    // 0x80402010 over 0xFF000004 gives 0xFF402012.
    var blend_push = shaders.Blit.{ .sourceWidth = 2, .sourceHeight = 4, .sourceStride = 0, .sourceOffset = 256, .targetWidth = WIDTH, .targetHeight = 1, .targetX = 0, .targetY = 0, .flags = 0, .targetOffset = 40 * WIDTH }
    if !gpu.begin(&context) { return 24 }
    unsafe { if !gpu.dispatch(&context, &blit, @ptrCast([*]const vk.Buffer, &two), &blend_push, 1, 1) { return 25 } }
    if !gpu.submit(&context) { return 26 }
    if out[40 * WIDTH] != 4282392594 || out[40 * WIDTH + 1] != 4282392594 { return 27 }
    if out[40 * WIDTH + 2] != 4278190086 || out[41 * WIDTH] != 4278190100 { return 28 }

    if context.dmaBufExport {
        var exported: gpu.Buffer = undefined
        if !gpu.createBuffer(&context, &exported, 4096, true) || exported.fd < 0 { return 23 }
    }
    gpu.close(&context)
    return 13
}
