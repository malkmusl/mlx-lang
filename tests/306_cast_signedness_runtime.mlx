// A cast that changes an integer's signedness without widening it makes
// the value read as its new type everywhere after: -3 as an i32 bit-cast
// to u32 is 4294967293, also once widened to u64, and 4294967293 as a u32
// bit-cast to i32 is -3, also once widened to i64. Older compilers kept
// the old type's extension in the register, so the widening that followed
// sign-extended the u32 and zero-extended the i32. Exits 13 when every
// check holds, else the number of the first check that failed.
fn widenUnsigned(quotient: i32) -> u64 { return @intCast(u64, @bitCast(u32, quotient)) }

fn widenSigned(bits: u32) -> i64 { return @intCast(i64, @bitCast(i32, bits)) }

fn byteOf(value: i8) -> u32 { return @intCast(u32, @bitCast(u8, value)) }

fn signedOf(value: u16) -> i64 { return @intCast(i64, @bitCast(i16, value)) }

pub fn main() -> u8 {
    if widenUnsigned(-3) != 4294967293 { return 1 }
    if widenSigned(4294967293) != -3 { return 2 }
    if byteOf(-1) != 255 { return 3 }
    if signedOf(65535) != -1 { return 4 }
    if widenUnsigned(7) != 7 || widenSigned(7) != 7 { return 5 }
    return 13
}
