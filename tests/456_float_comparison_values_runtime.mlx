// A comparison of floats used as a value, not only as a condition: passed
// to a function, held in a const or a var and passed on, in a struct's
// field, returned, negated, mixed with integer comparisons in one call,
// for f64 and f32, with NaN. An fcmp is typed by its operands; before, a
// call passed its bool in a float register and the callee read whatever
// its general register held (mostly: true). Exits 13.
const Pair = struct {
    ok: bool
    value: f64
}

noinline fn take(value: bool) -> u8 { return if value { 1 } else { 0 } }
noinline fn takeSecond(first: u32, second: bool, third: f64) -> u8 { return if second && third == 2.5 && first == 7 { 1 } else { 0 } }
noinline fn takeMany(a: bool, b: bool, c: bool, d: bool) -> u8 {
    var bits: u8 = 0
    if a { bits |= 1 }
    if b { bits |= 2 }
    if c { bits |= 4 }
    if d { bits |= 8 }
    return bits
}
noinline fn half() -> f64 { return 0.5 }
noinline fn halfSingle() -> f32 { return 0.5 }
noinline fn nan() -> f64 {
    const zero = half() - 0.5
    return zero / zero
}
noinline fn less(a: f64, b: f64) -> bool { return a < b }
noinline fn wrap(ok: bool, value: f64) -> Pair { return Pair.{ .ok = ok, .value = value } }

pub fn main() -> u8 {
    const quarter: f64 = 0.25
    const h = half()
    if take(quarter > h) != 0 { return 1 }
    if take(quarter < h) != 1 { return 2 }
    if take(quarter == h) != 0 || take(quarter != h) != 1 { return 3 }
    if take(quarter >= h) != 0 || take(quarter <= h) != 1 { return 4 }
    const held = quarter > h
    if take(held) != 0 { return 5 }
    var kept = quarter > h
    if take(kept) != 0 { return 6 }
    kept = quarter < h
    if take(kept) != 1 { return 7 }
    if takeSecond(7, quarter < h, 2.5) != 1 || takeSecond(7, quarter > h, 2.5) != 0 { return 8 }
    const n: i32 = 3
    if takeMany(quarter < h, n > 5, h > quarter, n < 5) != 13 { return 9 }
    if take(!(quarter > h)) != 1 { return 10 }
    if take(less(quarter, h)) != 1 || take(less(h, quarter)) != 0 { return 11 }
    const pair = wrap(quarter > h, h)
    if pair.ok || pair.value != 0.5 { return 12 }
    // NaN compares false except with !=.
    const odd = nan()
    if take(odd < h) != 0 || take(odd > h) != 0 || take(odd == odd) != 0 || take(odd != odd) != 1 { return 14 }
    // f32 the same.
    const small: f32 = 0.25
    const single = halfSingle()
    if take(small > single) != 0 || take(small < single) != 1 { return 15 }
    const held_single = small >= single
    if take(held_single) != 0 { return 16 }
    return 13
}
