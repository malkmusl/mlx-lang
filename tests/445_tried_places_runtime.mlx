// A place reached through a `try` is as writable as it is without one:
// the slice of what a tried call's `*T` points to is a `[]T`, a pointer
// capture over it a `*T`, and its elements are assigned, also at an index
// that is tried. (Sema's question whether a place may be written typed
// the place's parts without the function's return type, so a `try` among
// them had no type and the place counted as not writable: `&place` gave
// a `*const`, and since slices follow the place
// (tests/443_constant_slices_runtime.mlx) such a slice was refused where a
// `[]T` was wanted.) Ends with 0; with an error when a check fails.
const Failure = error { Missing, Wrong }

fn found(target: *[4]u8) -> Failure!*[4]u8 { return target }

fn which() -> Failure!usize { return 0 }

const Record = struct { bytes: [4]u8, count: usize }

fn record(target: *Record) -> Failure!*Record { return target }

fn fill(into: []u8, value: u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = value
        k += 1
    }
}

fn bump(target: *u8) -> void { target.* += 1 }

pub fn main() -> Failure!void {
    var held = [4]u8{ 1, 2, 3, 4 }
    // The slice of what the tried pointer points to, written through.
    fill((try found(&held)).*[0..2], 5)
    if held[0] != 5 || held[1] != 5 || held[2] != 3 { return Failure.Wrong }
    // A pointer capture over it.
    for *item in (try found(&held)).* { item.* += 1 }
    if held[0] != 6 || held[3] != 5 { return Failure.Wrong }
    // An element of it, at a tried index; its address.
    (try found(&held)).*[try which()] = 9
    bump(&(try found(&held)).*[1])
    if held[0] != 9 || held[1] != 7 { return Failure.Wrong }
    // A field of what a tried pointer points to, and its slice.
    var kept = Record.{ .bytes = [4]u8{ 1, 1, 1, 1 }, .count = 0 }
    (try record(&kept)).*.count = 4
    fill((try record(&kept)).*.bytes[1..3], 8)
    if kept.count != 4 || kept.bytes[0] != 1 || kept.bytes[1] != 8 || kept.bytes[2] != 8 || kept.bytes[3] != 1 { return Failure.Wrong }
}
