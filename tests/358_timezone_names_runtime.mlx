// std.timezone's abbreviations and loadSetting: a POSIX rule names its
// standard and daylight time ("CET"/"CEST" either side of the switch on
// the last Sunday of March 2026), a numeric one without its <>, a zone
// without daylight time has its one name, a name that is neither a zone
// nor a rule is UTC by that name, nothing at all is UTC; and,
// when the system has the zone file, Europe/Berlin (TZif) says CET in
// January 2026 and CEST in July 2026 (past its last transition: from the
// rule at its end) and LMT before 1893. Exits 13 when every check holds,
// else the number of the first check that failed.
const std = @import("std")
const timezone = @import("std.timezone")

pub fn main() -> u8 {
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(timezone.Zone), 8)
    if memory == null { return 1 }
    var zone: *timezone.Zone = undefined
    unsafe { zone = @ptrCast(*timezone.Zone, memory.?) }

    // 2026-03-29 01:00:00 UTC, the switch to summer time.
    const switch_at: i64 = 1774746000
    timezone.loadSetting(zone, ":CET-1CEST,M3.5.0,M10.5.0/3", allocator)
    if !std.text.same(timezone.abbreviationAt(zone, switch_at - 1), "CET") { return 2 }
    if !std.text.same(timezone.abbreviationAt(zone, switch_at), "CEST") { return 3 }
    if timezone.offsetAt(zone, switch_at) != 7200 { return 4 }

    timezone.loadSetting(zone, "<+03>-3", allocator)
    if !std.text.same(timezone.abbreviationAt(zone, 0), "+03") || timezone.offsetAt(zone, 0) != 10800 { return 5 }
    timezone.loadSetting(zone, "EST5", allocator)
    if !std.text.same(timezone.abbreviationAt(zone, switch_at), "EST") || timezone.offsetAt(zone, 0) != -18000 { return 6 }
    timezone.loadSetting(zone, "FOO", allocator)
    if !std.text.same(timezone.abbreviationAt(zone, 0), "FOO") || timezone.offsetAt(zone, 0) != 0 { return 7 }
    timezone.loadSetting(zone, "x", allocator)
    if !std.text.same(timezone.abbreviationAt(zone, 0), "UTC") || timezone.offsetAt(zone, 0) != 0 { return 11 }

    if std.fs.exists("/usr/share/zoneinfo/Europe/Berlin".pointer) {
        timezone.loadSetting(zone, "Europe/Berlin", allocator)
        // 2026-01-15 and 2026-07-15, noon UTC.
        if !std.text.same(timezone.abbreviationAt(zone, 1768478400), "CET") || timezone.offsetAt(zone, 1768478400) != 3600 { return 8 }
        if !std.text.same(timezone.abbreviationAt(zone, 1784116800), "CEST") || timezone.offsetAt(zone, 1784116800) != 7200 { return 9 }
        // 1890: local mean time.
        if !std.text.same(timezone.abbreviationAt(zone, -2524521600), "LMT") { return 10 }
    }
    allocator.free(memory.?, @sizeOf(timezone.Zone), 8)
    return 13
}
