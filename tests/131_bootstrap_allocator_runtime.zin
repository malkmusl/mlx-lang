const bootstrap = @import("../std/bootstrap/root.zin")

fn fakeAlloc(context: usize, length: usize, alignment: usize) -> ?[*]u8 {
    unsafe {
        return @ptrFromInt([*]u8, context + length + alignment)
    }
}

fn fakeResize(context: usize, memory: [*]u8, old_length: usize, new_length: usize, alignment: usize) -> ?[*]u8 {
    return memory
}

fn fakeFree(context: usize, memory: [*]u8, length: usize, alignment: usize) -> void {}

pub fn main() -> u8 {
    const allocator = bootstrap.allocator.Allocator.{
        .context = 4,
        .allocFn = fakeAlloc,
        .resizeFn = fakeResize,
        .freeFn = fakeFree,
    }
    const memory = bootstrap.allocator.alloc(allocator, 8, 1).?
    return @intCast(u8, @intFromPtr(memory))
}
