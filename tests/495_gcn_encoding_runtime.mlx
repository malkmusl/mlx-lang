// The encoder and the decoder of our shader compiler for the RX 580
// (projects/brix/vulkan/encode.mlx, decode.mlx; the instruction table
// isa.mlx, generated from Mesa's aco_opcodes.py) on instructions of every
// format the card has, each held against the words LLVM's assembler gives
// for it on this generation (llvm-mc -triple=amdgcn -mcpu=tonga
// -show-encoding, LLVM 18, run when this test was written; its output is
// recorded below as numbers, so the test needs no llvm-mc):
//   SOP2 (a literal, vcc_lo, exec and vcc, inline constants), SOPK
//   (s_movk, s_cmpk, s_getreg's field, s_setreg_imm32's literal), SOP1
//   (64-bit moves, saveexec, m0), SOPC (64-bit, a literal), SOPP (the end,
//   s_nop, branches forwards and backwards, the wait word, s_sendmsg),
//   SMEM (an immediate of 20 bits, an offset register, a buffer load of
//   eight words with glc, a store), VOP2 (carry, v_cndmask's vcc, a
//   literal, an inline float, v_madmk's constant), VOP1 (a scalar source,
//   v_readfirstlane, a literal), VOPC (a negative inline constant, v_cmpx
//   with an SGPR), VOP3 (the multiplies, three sources, abs, neg, clamp and
//   both output modifiers), VOP3b (a carry into any pair, a carry in from
//   one, v_div_scale), VOP1/2/C in the VOP3 form, VINTRP (p1, p2 with
//   attribute 31 .w, mov from p20), DS (offsets of 16 bits and the two of
//   write2, gds, 64 bits), MUBUF (offen, idxen, an SGPR offset, offset
//   4095, glc, slc, an atomic), MTBUF (two formats, off), MIMG (load,
//   sample with its sampler, store, atomic, gather with da), FLAT (load,
//   store with glc and slc, an atomic), EXP (a colour target with done
//   and vm, a position, a parameter compressed), DPP (quad_perm, row_shl
//   with masks and bound_ctrl) and SDWA (selects, preserve, a comparison
//   with its sign extension); the inline constants' edges;
// for each: the record encodes into exactly those words, the words decode
// into exactly that record, and the record's text names the instruction.
// Then the table: 946 instructions (the 762 rows the study counts less
// FLAT's 8 d16 forms, which MUBUF's own GFX8 column lacks, and 192
// comparisons), in order, each name once, none of GFX9's that GFX8 lacks
// (v_add_u32 0x34, s_mul_hi_u32, flat_load_ubyte_d16 and the GLOBAL and
// SCRATCH forms are not there), every one encodable in its own format, and its words decoding
// back to it (v_mul_lo_i32 and v_mul_lo_u32 share a number on GFX8: the
// table's first is the one decoded). And what may not be written: an
// instruction of another format's number, a VOP2 whose second source is
// not a vector register, a literal in the VOP3 form, an SMEM base at an
// odd register, an immediate of 21 bits, a resource not at a multiple of
// four, an offset of 13 bits.
// With an argument, each failing check is printed.
// Exits 13.
const std = @import("std")
const isa = @import("../projects/brix/vulkan/isa.mlx")
const encode = @import("../projects/brix/vulkan/encode.mlx")
const decode = @import("../projects/brix/vulkan/decode.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn sayNumber(value: u64) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

var failed: u16 = 0
var show = false

fn check(number: u16, holds: bool) -> void {
    if holds { return }
    if failed == 0 { failed = number }
    if show {
        say("check ")
        sayNumber(@intCast(u64, number))
        say(" fails\n")
    }
}

fn v(n: u16) -> u16 { return encode.VGPR + n }

fn same(a: *const encode.Inst, b: *const encode.Inst) -> bool {
    return a.*.op.format == b.*.op.format && a.*.op.number == b.*.op.number && a.*.form == b.*.form && a.*.dst == b.*.dst && a.*.dst2 == b.*.dst2 && a.*.src0 == b.*.src0 && a.*.src1 == b.*.src1 && a.*.src2 == b.*.src2 && a.*.src3 == b.*.src3 && a.*.literal == b.*.literal && a.*.imm == b.*.imm && a.*.flags == b.*.flags && a.*.mods == b.*.mods && a.*.extra == b.*.extra
}

fn startsWith(text: []const u8, head: []const u8) -> bool {
    if head.length > text.length { return false }
    var k: usize = 0
    while k < head.length {
        if text[k] != head[k] { return false }
        k += 1
    }
    return true
}

// The record against LLVM's words (one, two or three): encoded, decoded,
// named.
fn expect(number: u16, i: encode.Inst, words: []const u32) -> void {
    var out: [3]u32 = [3]u32{ 0, 0, 0 }
    const n = encode.encode(&i, out[0..])
    var encoded = n == words.length
    var k: usize = 0
    while encoded && k < n {
        if out[k] != words[k] { encoded = false }
        k += 1
    }
    var back: encode.Inst = undefined
    const length = decode.decode(words, 0, &back)
    const decoded = length == words.length && same(&back, &i)
    var text: decode.Text = undefined
    decode.clear(&text)
    decode.text(&i, &text)
    const named = startsWith(text.bytes[0..text.length], decode.name(i.op))
    if show && !(encoded && decoded && named) {
        say("case ")
        sayNumber(@intCast(u64, number))
        say(if encoded { "" } else { ": not encoded so" })
        say(if decoded { "" } else { ": not decoded so" })
        say(if named { "" } else { ": not named" })
        say("\n")
    }
    check(number, encoded && decoded && named)
}

fn make(op: isa.Op, dst: u16, src0: u16, src1: u16) -> encode.Inst {
    var i = encode.blank(op)
    i.dst = dst
    i.src0 = src0
    i.src1 = src1
    return i
}

fn testScalar() -> void {
    expect(1, make(isa.S_ADD_U32, 4, 2, 3), [_]u32{ 0x80040302 }[0..])
    var i = make(isa.S_MUL_I32, 101, encode.VCC, encode.LITERAL)
    i.literal = 0x12345678
    expect(2, i, [_]u32{ 0x9265FF6A, 0x12345678 }[0..])
    expect(3, make(isa.S_AND_B64, encode.EXEC, encode.EXEC, encode.VCC), [_]u32{ 0x86FE6A7E }[0..])
    expect(4, make(isa.S_CSELECT_B64, 20, encode.constant(0xFFFFFFFF), encode.constant(0)), [_]u32{ 0x859480C1 }[0..])
    i = make(isa.S_MOVK_I32, 4, 0, 0)
    i.imm = 0x64
    expect(5, i, [_]u32{ 0xB0040064 }[0..])
    i = make(isa.S_CMPK_EQ_U32, 9, 0, 0)
    i.imm = 0xFFFE
    expect(6, i, [_]u32{ 0xB409FFFE }[0..])
    i = make(isa.S_GETREG_B32, 5, 0, 0)
    i.imm = 0x1801
    expect(7, i, [_]u32{ 0xB8851801 }[0..])
    i = make(isa.S_SETREG_IMM32_B32, 0, encode.LITERAL, 0)
    i.imm = 0x0701
    i.literal = 0xABCDEF00
    expect(8, i, [_]u32{ 0xBA000701, 0xABCDEF00 }[0..])
    expect(9, make(isa.S_MOV_B32, 4, 2, 0), [_]u32{ 0xBE840002 }[0..])
    expect(10, make(isa.S_MOV_B64, 4, encode.EXEC, 0), [_]u32{ 0xBE84017E }[0..])
    expect(11, make(isa.S_AND_SAVEEXEC_B64, 20, 24, 0), [_]u32{ 0xBE942018 }[0..])
    expect(12, make(isa.S_NOT_B32, encode.M0, encode.constant(0xFFFFFFF0), 0), [_]u32{ 0xBEFC04D0 }[0..])
    // (13 is the number of a run that passes: this one is 129)
    expect(129, make(isa.S_CMP_EQ_U32, 0, 2, encode.constant(0)), [_]u32{ 0xBF068002 }[0..])
    expect(14, make(isa.S_CMP_LG_U64, 0, 20, encode.constant(0)), [_]u32{ 0xBF138014 }[0..])
    i = make(isa.S_CMP_LT_I32, 0, 3, encode.LITERAL)
    i.literal = 0x80000000
    expect(15, i, [_]u32{ 0xBF04FF03, 0x80000000 }[0..])
    expect(16, encode.blank(isa.S_ENDPGM), [_]u32{ 0xBF810000 }[0..])
    i = encode.blank(isa.S_NOP)
    i.imm = 7
    expect(17, i, [_]u32{ 0xBF800007 }[0..])
    i = encode.blank(isa.S_BRANCH)
    i.imm = 3
    expect(18, i, [_]u32{ 0xBF820003 }[0..])
    i = encode.blank(isa.S_CBRANCH_EXECZ)
    i.imm = 0xFFFD
    expect(19, i, [_]u32{ 0xBF88FFFD }[0..])
    i = encode.blank(isa.S_WAITCNT)
    i.imm = encode.waitWord(0, 0, 0)
    expect(20, i, [_]u32{ 0xBF8C0000 }[0..])
    i.imm = encode.waitWord(3, encode.WAIT_EXP_MASK, encode.WAIT_LGKM_MASK)
    expect(21, i, [_]u32{ 0xBF8C0F73 }[0..])
    i = encode.blank(isa.S_SENDMSG)
    i.imm = 3
    expect(22, i, [_]u32{ 0xBF900003 }[0..])
}

fn smem(op: isa.Op, data: u16, base: u16, offset: u32, immediate: bool) -> encode.Inst {
    var i = encode.blank(op)
    i.dst = data
    i.src0 = base
    if immediate {
        i.flags = encode.IMM
        i.imm = offset
    } else {
        i.src1 = @intCast(u16, offset)
    }
    return i
}

fn testMemoryScalar() -> void {
    expect(30, smem(isa.S_LOAD_DWORDX4, 4, 2, 0, true), [_]u32{ 0xC00A0101, 0x00000000 }[0..])
    expect(31, smem(isa.S_LOAD_DWORD, 9, 4, 0xFFFFF, true), [_]u32{ 0xC0020242, 0x000FFFFF }[0..])
    expect(32, smem(isa.S_LOAD_DWORDX2, 10, 2, 7, false), [_]u32{ 0xC0040281, 0x00000007 }[0..])
    var i = smem(isa.S_BUFFER_LOAD_DWORDX8, 16, 8, 0x40, true)
    i.flags |= encode.GLC
    expect(33, i, [_]u32{ 0xC02F0404, 0x00000040 }[0..])
    expect(34, smem(isa.S_STORE_DWORD, 5, 2, 0x10, true), [_]u32{ 0xC0420141, 0x00000010 }[0..])
}

fn vop3(op: isa.Op, dst: u16, dst2: u16, a: u16, b: u16, c: u16, mods: u32) -> encode.Inst {
    var i = encode.blank(op)
    if op.format != isa.Format.vop3 { i.form = encode.Form.vop3 }
    i.dst = dst
    i.dst2 = dst2
    i.src0 = a
    i.src1 = b
    i.src2 = c
    i.mods = mods
    return i
}

fn testVector() -> void {
    expect(40, make(isa.V_ADD_CO_U32, v(2), v(0), v(1)), [_]u32{ 0x32040300 }[0..])
    expect(41, make(isa.V_CNDMASK_B32, v(1), v(2), v(3)), [_]u32{ 0x00020702 }[0..])
    expect(42, make(isa.V_LSHLREV_B32, v(2), encode.constant(2), v(1)), [_]u32{ 0x24040282 }[0..])
    var i = make(isa.V_AND_B32, v(2), encode.LITERAL, v(1))
    i.literal = 0xFF
    expect(43, i, [_]u32{ 0x260402FF, 0x000000FF }[0..])
    expect(44, make(isa.V_MUL_F32, v(255), encode.FLOAT_HALF + 7, v(254)), [_]u32{ 0x0BFFFCF7 }[0..])
    i = make(isa.V_MADMK_F32, v(1), v(2), v(3))
    i.literal = 0x41000000
    expect(45, i, [_]u32{ 0x2E020702, 0x41000000 }[0..])
    expect(46, make(isa.V_MOV_B32, v(1), 2, 0), [_]u32{ 0x7E020202 }[0..])
    expect(47, make(isa.V_READFIRSTLANE_B32, 4, v(1), 0), [_]u32{ 0x7E080501 }[0..])
    expect(48, make(isa.V_CVT_U32_F32, v(3), v(4), 0), [_]u32{ 0x7E060F04 }[0..])
    expect(49, make(isa.V_RCP_F32, v(1), encode.FLOAT_HALF, 0), [_]u32{ 0x7E0244F0 }[0..])
    i = make(isa.V_NOT_B32, v(7), encode.LITERAL, 0)
    i.literal = 0x12345678
    expect(50, i, [_]u32{ 0x7E0E56FF, 0x12345678 }[0..])
    expect(51, make(isa.V_CMP_LT_U32, encode.VCC, v(0), v(1)), [_]u32{ 0x7D920300 }[0..])
    expect(52, make(isa.V_CMP_LG_I32, encode.VCC, encode.constant(0xFFFFFFFF), v(2)), [_]u32{ 0x7D8A04C1 }[0..])
    expect(53, make(isa.V_CMPX_GT_U32, encode.VCC, 5, v(6)), [_]u32{ 0x7DB80C05 }[0..])
    expect(54, vop3(isa.V_MUL_LO_I32, v(2), 0, v(0), v(1), 0, 0), [_]u32{ 0xD2850002, 0x00020300 }[0..])
    expect(55, vop3(isa.V_MUL_HI_U32, v(5), 0, 3, v(6), 0, 0), [_]u32{ 0xD2860005, 0x00020C03 }[0..])
    expect(56, vop3(isa.V_BFE_U32, v(1), 0, v(2), encode.constant(4), encode.constant(8), 0), [_]u32{ 0xD1C80001, 0x02210902 }[0..])
    expect(57, vop3(isa.V_MAD_U32_U24, v(1), 0, v(2), v(3), v(4), 0), [_]u32{ 0xD1C30001, 0x04120702 }[0..])
    // |v2|, -v3, clamp, mul:2: abs bit 0, neg bit 1 (<< 3), omod 1 (<< 6)
    i = vop3(isa.V_ADD_F32, v(1), 0, v(2), v(3), 0, 1 | 2 << 3 | 1 << 6)
    i.flags = encode.CLAMP
    expect(58, i, [_]u32{ 0xD1018101, 0x48020702 }[0..])
    expect(59, vop3(isa.V_FMA_F32, v(1), 0, v(2), v(3), v(4), 1 | 1 << 3 | 3 << 6), [_]u32{ 0xD1CB0101, 0x3C120702 }[0..])
    expect(60, vop3(isa.V_ADD_CO_U32, v(2), 4, v(0), v(1), 0, 0), [_]u32{ 0xD1190402, 0x00020300 }[0..])
    expect(61, vop3(isa.V_ADDC_CO_U32, v(2), 6, v(0), v(1), 4, 0), [_]u32{ 0xD11C0602, 0x00120300 }[0..])
    expect(62, vop3(isa.V_CMP_EQ_U32, 6, 0, 2, v(1), 0, 0), [_]u32{ 0xD0CA0006, 0x00020202 }[0..])
    expect(63, vop3(isa.V_CNDMASK_B32, v(1), 0, v(2), v(3), 4, 0), [_]u32{ 0xD1000001, 0x00120702 }[0..])
    expect(64, vop3(isa.V_MOV_B32, v(1), 0, 3, 0, 0, 0), [_]u32{ 0xD1410001, 0x00000003 }[0..])
    expect(65, vop3(isa.V_DIV_SCALE_F32, v(1), encode.VCC, v(2), v(3), v(4), 0), [_]u32{ 0xD1E06A01, 0x04120702 }[0..])
}

fn interp(op: isa.Op, dst: u16, source: u16, attribute: u32, channel: u32) -> encode.Inst {
    var i = encode.blank(op)
    i.dst = dst
    i.src0 = source
    i.extra = attribute | channel << 8
    return i
}

fn ds(op: isa.Op, dst: u16, address: u16, data0: u16, data1: u16, offsets: u32, gds: bool) -> encode.Inst {
    var i = encode.blank(op)
    i.dst = dst
    i.src0 = address
    i.src1 = data0
    i.src2 = data1
    i.imm = offsets
    if gds { i.flags = encode.GDS }
    return i
}

fn buffer(op: isa.Op, data: u16, address: u16, resource: u16, soffset: u16, offset: u32, flags: u32) -> encode.Inst {
    var i = encode.blank(op)
    i.dst = data
    i.src0 = address
    i.src1 = resource
    i.src2 = soffset
    i.imm = offset
    i.flags = flags
    return i
}

fn image(op: isa.Op, data: u16, address: u16, resource: u16, sampler: u16, mask: u32, flags: u32) -> encode.Inst {
    var i = encode.blank(op)
    i.dst = data
    i.src0 = address
    i.src1 = resource
    i.src2 = sampler
    i.extra = mask
    i.flags = flags
    return i
}

fn testMemory() -> void {
    expect(70, interp(isa.V_INTERP_P1_F32, v(1), v(2), 0, 0), [_]u32{ 0xD4040002 }[0..])
    expect(71, interp(isa.V_INTERP_P2_F32, v(5), v(6), 31, 3), [_]u32{ 0xD4157F06 }[0..])
    expect(72, interp(isa.V_INTERP_MOV_F32, v(1), 1, 3, 2), [_]u32{ 0xD4060E01 }[0..])
    // DS: what a field does not name decodes as v0 (a vector register)
    expect(73, ds(isa.DS_READ_B32, v(1), v(2), v(0), v(0), 4, false), [_]u32{ 0xD86C0004, 0x01000002 }[0..])
    expect(74, ds(isa.DS_WRITE_B32, v(0), v(2), v(1), v(0), 0xFFFF, false), [_]u32{ 0xD81AFFFF, 0x00000102 }[0..])
    expect(75, ds(isa.DS_WRITE2_B32, v(0), v(1), v(2), v(3), 4 | 8 << 8, false), [_]u32{ 0xD81C0804, 0x00030201 }[0..])
    expect(76, ds(isa.DS_ADD_U32, v(0), v(1), v(2), v(0), 0, true), [_]u32{ 0xD8010000, 0x00000201 }[0..])
    expect(77, ds(isa.DS_READ_B64, v(4), v(6), v(0), v(0), 0, false), [_]u32{ 0xD8EC0000, 0x04000006 }[0..])
    expect(78, buffer(isa.BUFFER_LOAD_DWORD, v(3), v(2), 4, encode.constant(0), 0, encode.OFFEN), [_]u32{ 0xE0501000, 0x80010302 }[0..])
    expect(79, buffer(isa.BUFFER_STORE_DWORD, v(3), v(2), 4, 9, 4095, encode.OFFEN | encode.GLC | encode.SLC), [_]u32{ 0xE0725FFF, 0x09010302 }[0..])
    expect(80, buffer(isa.BUFFER_LOAD_DWORDX4, v(4), v(2), 8, encode.constant(0), 0, encode.OFFEN | encode.IDXEN), [_]u32{ 0xE05C3000, 0x80020402 }[0..])
    expect(81, buffer(isa.BUFFER_ATOMIC_ADD, v(1), v(2), 4, encode.constant(0), 0, encode.OFFEN | encode.GLC), [_]u32{ 0xE1085000, 0x80010102 }[0..])
    // tfe (llvm-mc: buffer_load_dword v[1:2], v2, s[8:11], 0 offen tfe)
    expect(127, buffer(isa.BUFFER_LOAD_DWORD, v(1), v(2), 8, encode.constant(0), 0, encode.OFFEN | encode.TFE), [_]u32{ 0xE0501000, 0x80820102 }[0..])
    // MTBUF: the format is data format | number format << 4 (32 and
    // FLOAT: 4 | 7 << 4; 8_8_8_8 and UNORM: 10)
    var t = buffer(isa.TBUFFER_LOAD_FORMAT_X, v(1), v(2), 4, encode.constant(0), 0, encode.OFFEN)
    t.extra = 4 | 7 << 4
    expect(82, t, [_]u32{ 0xEBA01000, 0x80010102 }[0..])
    t = buffer(isa.TBUFFER_STORE_FORMAT_XYZW, v(1), v(0), 8, 3, 16, 0)
    t.extra = 10
    expect(83, t, [_]u32{ 0xE8538010, 0x03020100 }[0..])
    expect(84, image(isa.IMAGE_LOAD, v(1), v(2), 8, 0, 0xF, encode.UNORM), [_]u32{ 0xF0001F00, 0x00020102 }[0..])
    expect(85, image(isa.IMAGE_SAMPLE, v(1), v(2), 8, 4, 0xF, 0), [_]u32{ 0xF0800F00, 0x00220102 }[0..])
    expect(86, image(isa.IMAGE_STORE, v(5), v(1), 16, 0, 0x3, encode.UNORM | encode.GLC), [_]u32{ 0xF0203300, 0x00040501 }[0..])
    expect(87, image(isa.IMAGE_ATOMIC_ADD, v(1), v(2), 8, 0, 0x1, encode.UNORM | encode.GLC), [_]u32{ 0xF0483100, 0x00020102 }[0..])
    expect(88, image(isa.IMAGE_GATHER4, v(1), v(5), 8, 12, 0x1, encode.DA), [_]u32{ 0xF1004100, 0x00620105 }[0..])
    var f = make(isa.FLAT_LOAD_DWORD, v(1), v(2), v(0))
    expect(89, f, [_]u32{ 0xDC500000, 0x01000002 }[0..])
    f = make(isa.FLAT_STORE_DWORDX2, v(0), v(2), v(4))
    f.flags = encode.GLC | encode.SLC
    expect(90, f, [_]u32{ 0xDC770000, 0x00000402 }[0..])
    f = make(isa.FLAT_ATOMIC_SWAP, v(1), v(2), v(4))
    f.flags = encode.GLC
    expect(91, f, [_]u32{ 0xDD010000, 0x01000402 }[0..])
    // EXP: targets mrt0 (0), pos0 (12), param3 (32 + 3)
    var e = encode.blank(isa.Op.{ .format = isa.Format.exp, .number = 0 })
    e.src0 = v(1)
    e.src1 = v(2)
    e.src2 = v(3)
    e.src3 = v(4)
    e.extra = 0xF
    e.flags = encode.DONE | encode.VALID_MASK
    expect(92, e, [_]u32{ 0xC400180F, 0x04030201 }[0..])
    e.src0 = v(5)
    e.src1 = v(6)
    e.src2 = v(7)
    e.src3 = v(8)
    e.imm = 12
    e.flags = 0
    expect(93, e, [_]u32{ 0xC40000CF, 0x08070605 }[0..])
    e.src0 = v(1)
    e.src1 = v(0)
    e.src2 = v(0)
    e.src3 = v(0)
    e.imm = 35
    e.extra = 3
    e.flags = encode.COMPRESSED
    expect(94, e, [_]u32{ 0xC4000633, 0x00000001 }[0..])
}

fn testModifiers() -> void {
    // DPP: dpp_ctrl in extra, row_mask | bank_mask << 4 in mods
    var d = make(isa.V_MOV_B32, v(1), v(2), 0)
    d.form = encode.Form.dpp
    d.extra = 0xB1
    d.mods = 0xF | 0xF << 4
    expect(100, d, [_]u32{ 0x7E0202FA, 0xFF00B102 }[0..])
    d = make(isa.V_ADD_F32, v(1), v(2), v(3))
    d.form = encode.Form.dpp
    d.extra = 0x101
    d.mods = 0xA | 0x1 << 4
    d.flags = encode.BOUND_CTRL
    expect(101, d, [_]u32{ 0x020206FA, 0xA1090102 }[0..])
    // SDWA: dst_sel | dst_unused << 3 | src0_sel << 8 | src1_sel << 16
    var s = make(isa.V_MOV_B32, v(1), v(2), 0)
    s.form = encode.Form.sdwa
    s.extra = 5 << 8
    expect(102, s, [_]u32{ 0x7E0202F9, 0x00050002 }[0..])
    s = make(isa.V_ADD_F32, v(1), v(2), v(3))
    s.form = encode.Form.sdwa
    s.extra = 6 | 2 << 3 | 2 << 8 | 4 << 16
    expect(103, s, [_]u32{ 0x020206F9, 0x04021602 }[0..])
    // a comparison in the SDWA form: the selects only (and the sign
    // extension), the result in vcc
    s = make(isa.V_CMP_LT_U32, encode.VCC, v(1), v(2))
    s.form = encode.Form.sdwa
    s.extra = 1 << 8 | 4 << 16
    expect(104, s, [_]u32{ 0x7D9204F9, 0x04010001 }[0..])
    s.extra = 5 << 8 | 0x800 | 3 << 16
    expect(105, s, [_]u32{ 0x7D9204F9, 0x030D0001 }[0..])
}

// The inline constants: 0 to 64 and -1 to -16 inline, the rest literals
// (aco_ir.h's ranges).
fn testConstants() -> void {
    check(106, encode.constant(0) == 128 && encode.constant(64) == 192 && encode.constant(65) == encode.LITERAL)
    check(107, encode.constant(0xFFFFFFFF) == 193 && encode.constant(0xFFFFFFF0) == 208 && encode.constant(0xFFFFFFEF) == encode.LITERAL)
}

// What may not be written.
fn refused(i: encode.Inst) -> bool {
    var out: [3]u32 = undefined
    return encode.encode(&i, out[0..]) == 0
}

fn testRefused() -> void {
    // v_add_u32 is GFX9's VOP2 0x34: GFX8 has no such number
    check(110, refused(make(isa.Op.{ .format = isa.Format.vop2, .number = 0x34 }, v(1), v(2), v(3))))
    check(111, refused(make(isa.V_ADD_CO_U32, v(1), v(2), 3)))
    var i = vop3(isa.V_MUL_LO_U32, v(1), 0, encode.LITERAL, v(2), 0, 0)
    i.literal = 99
    check(112, refused(i))
    check(113, refused(smem(isa.S_LOAD_DWORD, 4, 3, 0, true)))
    check(114, refused(smem(isa.S_LOAD_DWORD, 4, 2, 0x100000, true)))
    check(115, refused(buffer(isa.BUFFER_LOAD_DWORD, v(1), v(2), 5, encode.constant(0), 0, encode.OFFEN)))
    check(116, refused(buffer(isa.BUFFER_LOAD_DWORD, v(1), v(2), 4, encode.constant(0), 4096, encode.OFFEN)))
    // and words that are none: a VOP2 number GFX8 lacks
    var back: encode.Inst = undefined
    check(117, decode.decode([_]u32{ 0x68020702 }[0..], 0, &back) == 0)
    // a literal word that is missing
    check(118, decode.decode([_]u32{ 0x260402FF }[0..], 0, &back) == 0)
}

fn testTable() -> void {
    check(120, isa.COUNT == 946)
    // in order, and each name once
    var ordered = true
    var k: usize = 1
    while k < isa.COUNT {
        if isa.CODE[k] < isa.CODE[k - 1] { ordered = false }
        k += 1
    }
    check(121, ordered)
    // counts by format: the study's table rows and the comparisons
    var counts: [17]u32 = undefined
    k = 0
    while k < 17 {
        counts[k] = 0
        k += 1
    }
    k = 0
    while k < isa.COUNT {
        counts[@intCast(usize, isa.CODE[k] >> 16)] += 1
        k += 1
    }
    check(122, counts[0] == 44 && counts[1] == 21 && counts[2] == 49 && counts[3] == 20 && counts[4] == 30 && counts[5] == 25)
    check(123, counts[6] == 52 && counts[7] == 76 && counts[8] == 198 && counts[9] == 77 && counts[10] == 3)
    check(124, counts[11] == 147 && counts[12] == 59 && counts[13] == 16 && counts[14] == 89 && counts[15] == 40)
    // GFX9's that GFX8 lacks are not there
    check(125, encode.find(isa.Op.{ .format = isa.Format.vop2, .number = 0x34 }) == isa.COUNT)
    // ... nor FLAT's d16 forms (flat_load_ubyte_d16 is GFX9's 0x20)
    check(128, encode.find(isa.Op.{ .format = isa.Format.flat, .number = 0x20 }) == isa.COUNT)
    // every instruction encodes in its own format and decodes back
    var all = true
    k = 0
    while k < isa.COUNT {
        const format = @enumFromInt(isa.Format, @intCast(u8, isa.CODE[k] >> 16))
        const op = isa.Op.{ .format = format, .number = @intCast(u16, isa.CODE[k] & 0xFFFF) }
        var i = encode.blank(op)
        // registers every format takes
        if format == isa.Format.vop2 || format == isa.Format.vop1 || format == isa.Format.vop3 || format == isa.Format.vintrp || format == isa.Format.ds || format == isa.Format.flat || format == isa.Format.mubuf || format == isa.Format.mtbuf || format == isa.Format.mimg {
            i.dst = v(1)
            i.src0 = v(2)
            i.src1 = v(3)
            i.src2 = v(4)
        }
        if format == isa.Format.vopc {
            i.dst = encode.VCC
            i.src1 = v(3)
        }
        if format == isa.Format.mubuf || format == isa.Format.mtbuf {
            i.src1 = 4
            i.src2 = encode.constant(0)
        }
        if format == isa.Format.mimg {
            i.src1 = 8
            i.src2 = 4
        }
        if format == isa.Format.vintrp && op.number == isa.V_INTERP_MOV_F32.number { i.src0 = 0 }
        if format == isa.Format.smem {
            i.src0 = 2
            i.flags = encode.IMM
        }
        if format == isa.Format.sopk && op.number == isa.S_SETREG_IMM32_B32.number { i.src0 = encode.LITERAL }
        if format == isa.Format.vop2 && (op.number == isa.V_MADMK_F32.number || op.number == isa.V_MADAK_F32.number || op.number == isa.V_MADMK_F16.number || op.number == isa.V_MADAK_F16.number) {
            i.literal = 1
        }
        if format == isa.Format.vop1 && op.number == isa.V_READFIRSTLANE_B32.number { i.dst = 5 }
        if format == isa.Format.vop3 && op.number == isa.V_READLANE_B32_E64.number { i.dst = 5 }
        if format == isa.Format.vop3 && encode.hasSecondDestination(op) { i.dst2 = encode.VCC }
        var out: [3]u32 = undefined
        const n = encode.encode(&i, out[0..])
        var back: encode.Inst = undefined
        if n == 0 || decode.decode(out[0..n], 0, &back) != n {
            if show {
                say("  not round: ")
                say(decode.name(op))
                say("\n")
            }
            all = false
        } else if back.op.format != op.format || back.op.number != op.number {
            // v_mul_lo_i32 and v_mul_lo_u32 share their number on GFX8
            if !(op.number == isa.V_MUL_LO_U32.number && back.op.number == isa.V_MUL_LO_U32.number) {
                all = false
            }
        }
        k += 1
    }
    check(126, all)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = arguments.length > 1
    testScalar()
    testMemoryScalar()
    testVector()
    testMemory()
    testModifiers()
    testConstants()
    testRefused()
    testTable()
    if failed != 0 { return if failed > 255 { 255 } else { @intCast(u8, failed) } }
    return 13
}
