// std.wayland.protocol parses the vendored canonical wayland.xml and
// xdg-shell.xml into the Protocol AST, assigns opcodes by declaration order,
// and rejects schema violations with stable error kinds. Exits 13.
const std = @import("std")
const xml = @import("std.xml")
const protocol = @import("std.wayland.protocol")

fn lengthOf(value: []const u8) -> usize {
    var length: usize = 0
    for byte in value { length += 1 }
    return length
}

fn load(path: []const u8, allocator: std.allocator.Allocator) -> std.array_list.ArrayList {
    unsafe {
        const file = std.fs.open(@ptrCast([*]const u8, path), 0, 0)
        const contents = std.fs.readToEndAlloc(file, allocator)
        const closed = std.fs.close(file)
        return contents
    }
}

fn rejects(source: []const u8, kind: protocol.ErrorKind) -> bool {
    const allocator = std.page_allocator.init()
    var parsed: protocol.Protocol = undefined
    var diagnostic: protocol.Diagnostic = undefined
    unsafe {
        if protocol.parse(&parsed, allocator, @ptrCast([*]const u8, source), lengthOf(source), &diagnostic) { return false }
    }
    return diagnostic.kind == kind
}

pub fn main() -> u8 {
    const allocator = std.page_allocator.init()
    const core = load("std/protocols/wayland/wayland.xml", allocator)
    if core.length < 100000 { return 1 }
    var parsed: protocol.Protocol = undefined
    var diagnostic: protocol.Diagnostic = undefined
    if !protocol.parse(&parsed, allocator, core.items, core.length, &diagnostic) { return 2 }
    if !xml.equals(parsed.name, "wayland") || !parsed.hasCopyright { return 3 }
    if protocol.interfaceCount(&parsed) != 23 { return 4 }
    if parsed.requests.length != 72 || parsed.events.length != 62 || parsed.args.length != 217 { return 5 }
    if parsed.enums.length != 28 || parsed.entries.length != 230 { return 6 }

    const display = protocol.interfaceAt(&parsed, 0)
    if !xml.equals(display.*.name, "wl_display") || display.*.version != 1 { return 7 }
    if display.*.requestCount != 2 || display.*.eventCount != 2 || display.*.enumCount != 1 { return 8 }
    const get_registry = protocol.requestAt(&parsed, display, 1)
    if !xml.equals(get_registry.*.name, "get_registry") || get_registry.*.opcode != 1 { return 9 }
    const registry_arg = protocol.argAt(&parsed, get_registry, 0)
    if registry_arg.*.kind != protocol.ArgType.newId || !xml.equals(registry_arg.*.interfaceName, "wl_registry") { return 10 }
    const error_event = protocol.eventAt(&parsed, display, 0)
    if !xml.equals(error_event.*.name, "error") || error_event.*.argCount != 3 { return 11 }
    if protocol.argAt(&parsed, error_event, 2).*.kind != protocol.ArgType.string { return 12 }

    // wl_registry.bind carries a generic new_id (no interface attribute).
    const registry = protocol.findInterface(&parsed, std.string.fromSlice("wl_registry")).?
    const bind = protocol.requestAt(&parsed, registry, 0)
    const bind_id = protocol.argAt(&parsed, bind, 1)
    if bind_id.*.kind != protocol.ArgType.newId || bind_id.*.interfaceName.length != 0 { return 14 }

    // wl_callback.done is a destructor event; wl_surface.attach has a nullable object.
    const callback = protocol.findInterface(&parsed, std.string.fromSlice("wl_callback")).?
    if !protocol.eventAt(&parsed, callback, 0).*.destructor { return 15 }
    const surface = protocol.findInterface(&parsed, std.string.fromSlice("wl_surface")).?
    const attach = protocol.requestAt(&parsed, surface, 1)
    if !xml.equals(attach.*.name, "attach") || !protocol.argAt(&parsed, attach, 0).*.allowNull { return 16 }
    const offset = protocol.requestAt(&parsed, surface, 10)
    if !xml.equals(offset.*.name, "offset") || offset.*.since != 5 { return 17 }

    // Enums: explicit values, hexadecimal values and bitfields.
    const shm = protocol.findInterface(&parsed, std.string.fromSlice("wl_shm")).?
    const format = protocol.findEnum(&parsed, shm, std.string.fromSlice("format")).?
    if format.*.bitfield || protocol.entryAt(&parsed, format, 1).*.value != 1 { return 18 }
    if protocol.entryAt(&parsed, format, 2).*.value != 0x20203843 { return 19 }
    const output = protocol.findInterface(&parsed, std.string.fromSlice("wl_output")).?
    const transform = protocol.findEnum(&parsed, output, std.string.fromSlice("transform")).?
    if !xml.equals(protocol.entryAt(&parsed, transform, 1).*.name, "90") { return 20 }
    const seat = protocol.findInterface(&parsed, std.string.fromSlice("wl_seat")).?
    if !protocol.findEnum(&parsed, seat, std.string.fromSlice("capability")).?.*.bitfield { return 21 }
    protocol.deinit(&parsed)

    const shell = load("std/protocols/wayland/xdg-shell.xml", allocator)
    if !protocol.parse(&parsed, allocator, shell.items, shell.length, &diagnostic) { return 22 }
    if !xml.equals(parsed.name, "xdg_shell") || protocol.interfaceCount(&parsed) != 5 { return 23 }
    const wm_base = protocol.interfaceAt(&parsed, 0)
    if !xml.equals(wm_base.*.name, "xdg_wm_base") || wm_base.*.version != 7 { return 24 }
    const toplevel = protocol.findInterface(&parsed, std.string.fromSlice("xdg_toplevel")).?
    const wm_capabilities = protocol.eventAt(&parsed, toplevel, 3)
    if !xml.equals(wm_capabilities.*.name, "wm_capabilities") || wm_capabilities.*.since != 5 { return 25 }
    protocol.deinit(&parsed)

    // Schema violations are hard errors.
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><request name=\"r\"><arg name=\"a\" type=\"float\"/></request></interface></protocol>", protocol.ErrorKind.unknownArgType) { return 30 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><bogus/></interface></protocol>", protocol.ErrorKind.unknownElement) { return 31 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\" color=\"red\"/></protocol>", protocol.ErrorKind.unknownAttribute) { return 32 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"2\"><event name=\"e\" since=\"3\"/></interface></protocol>", protocol.ErrorKind.sinceTooLarge) { return 33 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><request name=\"destroy\"/></interface></protocol>", protocol.ErrorKind.destroyNotDestructor) { return 34 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><request name=\"r\"><arg name=\"a\" type=\"int\" allow-null=\"true\"/></request></interface></protocol>", protocol.ErrorKind.allowNullNotAllowed) { return 35 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><enum name=\"e\"/></interface></protocol>", protocol.ErrorKind.emptyEnum) { return 36 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><enum name=\"e\" bitfield=\"true\"><entry name=\"a\" value=\"1\"/></enum><request name=\"r\"><arg name=\"a\" type=\"int\" enum=\"e\"/></request></interface></protocol>", protocol.ErrorKind.bitfieldIntArgument) { return 37 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><request name=\"r\"><arg name=\"a\" type=\"uint\" interface=\"x\"/></request></interface></protocol>", protocol.ErrorKind.interfaceNotAllowed) { return 38 }
    if !rejects("<protocol name=\"p\"><interface name=\"2i\" version=\"1\"/></protocol>", protocol.ErrorKind.invalidIdentifier) { return 39 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"2\" frozen=\"true\"/></protocol>", protocol.ErrorKind.frozenVersion) { return 40 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><description>x</description></interface></protocol>", protocol.ErrorKind.descriptionWithoutSummary) { return 41 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><event name=\"e\"/><event name=\"e\"/></interface></protocol>", protocol.ErrorKind.duplicateName) { return 42 }
    if !rejects("<protocol name=\"p\"/>", protocol.ErrorKind.missingInterface) { return 43 }
    if !rejects("<wayland/>", protocol.ErrorKind.unexpectedRoot) { return 44 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"><enum name=\"e\"><entry name=\"a\" value=\"0x100000000\"/></enum></interface></protocol>", protocol.ErrorKind.invalidEntryValue) { return 45 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"2\"><request name=\"r\" since=\"2\" deprecated-since=\"2\"/></interface></protocol>", protocol.ErrorKind.deprecatedSinceNotAfterSince) { return 46 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\">text</interface></protocol>", protocol.ErrorKind.unexpectedText) { return 47 }
    if !rejects("<protocol name=\"p\"><interface name=\"i\" version=\"1\"></protocol>", protocol.ErrorKind.xml) { return 48 }
    return 13
}
