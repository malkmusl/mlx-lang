// A slice's `.pointer` is its first word: a many-item pointer to its
// elements (`[*]const T` for a `[]const T`), what an unsafe
// @ptrCast([*]const u8, text) stood for. `.length` is the second.

fn first(bytes: [*]const u8) -> u8 {
    return bytes[0]
}

fn fill(bytes: [*]u8, count: usize, value: u8) -> void {
    var at: usize = 0
    while at < count {
        bytes[at] = value
        at += 1
    }
}

const Words = struct {
    values: []const u32
}

pub fn main() -> u8 {
    const text: []const u8 = "hello"
    if first(text.pointer) != 104 { return 1 }
    const tail = text[2..]
    if tail.pointer[0] != 108 { return 2 }
    if @intFromPtr(text.pointer) + 2 != @intFromPtr(tail.pointer) { return 3 }

    var buffer: [4]u8 = [4]u8{ 0, 0, 0, 0 }
    const view: []u8 = buffer[0..4]
    fill(view.pointer, view.length, 7)
    if buffer[3] != 7 { return 4 }
    const shifted = view.pointer + 1
    if shifted[2] != 7 { return 5 }

    const numbers = [3]u32{ 5, 6, 7 }
    const words = Words.{ .values = numbers[0..3] }
    if words.values.pointer[2] != 7 { return 6 }
    return 13
}
