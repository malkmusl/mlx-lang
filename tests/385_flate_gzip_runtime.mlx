// std.flate.gzip: a gzip file written in pieces (with a flush in the
// middle) and read back in odd pieces, its bytes a gzip member that
// std.flate's gunzip reads too; two members in one file read as one;
// a file that is not gzip read as it is; data after the last member left
// alone; a damaged member and a truncated one refused with their errors;
// the whole-file conveniences. Exits 13 when every check holds, else the
// number of the first check that failed.
const std = @import("std")
const gzip = @import("std.flate.gzip")
const flate = @import("std.flate")
const fs = @import("../std/bootstrap/fs.mlx")

const A = "/tmp/mlx-385-a.gz"
const B = "/tmp/mlx-385-b.gz"
const C = "/tmp/mlx-385-c.gz"
const PLAIN = "/tmp/mlx-385-plain.txt"
const DAMAGED = "/tmp/mlx-385-damaged.gz"
const SHORT = "/tmp/mlx-385-short.gz"

const LENGTH: usize = 100000

fn fillPattern(bytes: [*]u8, length: usize, seed: u8) -> void {
    var index: usize = 0
    while index < length {
        // Text-like, repetitive enough to compress, varied enough to
        // need the window.
        const word = (index / 7 + @intCast(usize, seed)) % 97
        bytes[index] = @intCast(u8, 32 + (word * 3 + index % 7) % 90)
        index += 1
    }
}

fn same(a: [*]const u8, b: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// Reads the file with pieces of `piece` bytes (growing by one each time)
// into `into`; the total, or 0 on an error with `err` set.
fn readAllInPieces(path: [*]const u8, allocator: std.allocator.Allocator, into: [*]u8, capacity: usize, piece: usize, err: *gzip.Error) -> usize {
    var reader: gzip.Reader = undefined
    err.* = gzip.Error.none
    if !gzip.openRead(&reader, allocator, path) {
        err.* = gzip.Error.file
        return 0
    }
    var total: usize = 0
    var size = piece
    while total < capacity {
        var room = size
        if room > capacity - total { room = capacity - total }
        const got = gzip.read(&reader, into + total, room)
        if got < 0 {
            err.* = gzip.readerError(&reader)
            gzip.readerClose(&reader)
            return 0
        }
        if got == 0 { break }
        total += @intCast(usize, got)
        size += 1
    }
    if reader.position != @intCast(u64, total) { err.* = gzip.Error.damaged }
    gzip.readerClose(&reader)
    return total
}

fn copyFile(from: [*]const u8, to: [*]const u8, appendTo: bool, cut: usize, damageAt: usize) -> bool {
    var raw: [262144]u8 = undefined
    const bytes: [*]u8 = &raw
    var length = fs.readFile(from, bytes, 262144)
    if length == 0 { return false }
    if cut > 0 && cut < length { length = cut }
    if damageAt > 0 && damageAt < length { bytes[damageAt] = bytes[damageAt] ^ 255 }
    const flags = fs.WRITE_ONLY | fs.CREATE | (if appendTo { fs.APPEND } else { fs.TRUNCATE })
    const file = fs.open(to, flags, 420)
    if !fs.isValid(file) { return false }
    const ok = fs.writeAllBytes(file, bytes, length)
    return fs.close(file) && ok
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const memory = allocator.alloc(3 * LENGTH + 262144, 16)
    if memory == null { return 1 }
    const original: [*]u8 = memory.?
    const back: [*]u8 = original + LENGTH
    const second: [*]u8 = original + 2 * LENGTH
    const raw: [*]u8 = original + 3 * LENGTH
    fillPattern(original, LENGTH, 1)
    fillPattern(second, LENGTH, 2)
    // Written in pieces, a flush in the middle.
    var writer: gzip.Writer = undefined
    if !gzip.openWrite(&writer, allocator, A.pointer, 6) { return 2 }
    var at: usize = 0
    var piece: usize = 1
    while at < LENGTH {
        var count = piece
        if count > LENGTH - at { count = LENGTH - at }
        if !gzip.write(&writer, original[at..at + count]) { return 3 }
        at += count
        piece = piece * 2 + 1
        if at > LENGTH / 2 && piece > 1000 && !gzip.flush(&writer) { return 4 }
    }
    if writer.position != LENGTH || !gzip.writerClose(&writer) { return 5 }
    // Its bytes are a gzip member std.flate reads.
    const rawLength = fs.readFile(A.pointer, raw, 262144)
    if rawLength < 18 || raw[0] != 31 || raw[1] != 139 || rawLength >= LENGTH { return 6 }
    if flate.gzipSize(raw, rawLength) != LENGTH || flate.gunzip(raw, rawLength, back, LENGTH) != LENGTH || !same(back, original, LENGTH) { return 7 }
    // Read back in odd pieces.
    var err = gzip.Error.none
    if readAllInPieces(A.pointer, allocator, back, LENGTH, 1, &err) != LENGTH || !same(back, original, LENGTH) || err != gzip.Error.none { return 8 }
    if readAllInPieces(A.pointer, allocator, back, LENGTH, 9000, &err) != LENGTH || !same(back, original, LENGTH) { return 9 }
    // Two members read as one; then data after the last member left alone.
    if !gzip.writeFile(allocator, B.pointer, second[0..LENGTH], 9) { return 10 }
    if !copyFile(A.pointer, C.pointer, false, 0, 0) || !copyFile(B.pointer, C.pointer, true, 0, 0) { return 11 }
    const both = allocator.alloc(2 * LENGTH, 16)
    if both == null { return 12 }
    if readAllInPieces(C.pointer, allocator, both.?, 2 * LENGTH, 4000, &err) != 2 * LENGTH || !same(both.?, original, LENGTH) || !same(both.? + LENGTH, second, LENGTH) { return 14 }
    const plain = fs.open(PLAIN.pointer, fs.WRITE_ONLY | fs.CREATE | fs.TRUNCATE, 420)
    if !fs.isValid(plain) || !fs.writeAllBytes(plain, original, 5000) || !fs.close(plain) { return 15 }
    if !copyFile(A.pointer, C.pointer, false, 0, 0) || !copyFile(PLAIN.pointer, C.pointer, true, 0, 0) { return 16 }
    if readAllInPieces(C.pointer, allocator, both.?, 2 * LENGTH, 7, &err) != LENGTH || !same(both.?, original, LENGTH) { return 17 }
    // Not gzip: as it is.
    if readAllInPieces(PLAIN.pointer, allocator, back, LENGTH, 3, &err) != 5000 || !same(back, original, 5000) { return 18 }
    var result: flate.Buffer = undefined
    if !gzip.readFile(allocator, PLAIN.pointer, &result) || result.length != 5000 || !same(result.bytes, original, 5000) { return 19 }
    flate.freeBuffer(allocator, &result)
    if !gzip.readFile(allocator, C.pointer, &result) || result.length != LENGTH || !same(result.bytes, original, LENGTH) { return 20 }
    flate.freeBuffer(allocator, &result)
    // Damaged and truncated members.
    if !copyFile(A.pointer, DAMAGED.pointer, false, 0, rawLength / 2) { return 21 }
    if readAllInPieces(DAMAGED.pointer, allocator, back, LENGTH, 5000, &err) != 0 || err != gzip.Error.damaged { return 22 }
    if !copyFile(A.pointer, SHORT.pointer, false, rawLength - 100, 0) { return 23 }
    if readAllInPieces(SHORT.pointer, allocator, back, LENGTH, 5000, &err) != 0 || err != gzip.Error.unexpectedEnd { return 24 }
    if gzip.readFile(allocator, SHORT.pointer, &result) { return 25 }
    var missing: gzip.Reader = undefined
    if gzip.openRead(&missing, allocator, "/tmp/mlx-385-no-such-file.gz".pointer) { return 26 }
    // An empty member.
    if !gzip.writeFile(allocator, B.pointer, "", 1) || readAllInPieces(B.pointer, allocator, back, LENGTH, 100, &err) != 0 || err != gzip.Error.none { return 27 }
    return 13
}
