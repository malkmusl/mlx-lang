// Records of modules that import one another, naming one another
// (tests/support/type_ring: a.A has a pointer to b.B and a b.Pair inside,
// b.B a pointer back to a.A and a c.Keeper inside, c.Keeper a pointer to
// a.A and a b.Pair, b.Pair an a.Small): whichever module's declarations
// are analyzed first, a record of a module whose turn has not come is
// analyzed when it is named, in its own module, and one still being worked
// out is the record it will be behind a pointer. Before, the first module
// of the ring failed with "the type of this field could not be resolved".
// Exits 13.
const a = @import("./support/type_ring/a.mlx")
const b = @import("./support/type_ring/b.mlx")
const c = @import("./support/type_ring/c.mlx")

pub fn main() -> u8 {
    var first: a.A = undefined
    var second: b.B = undefined
    first.next = &second
    first.pair.n = 4
    first.pair.small.n = 100
    first.handle = null
    first.list = null
    second.back = &first
    second.keeper.first = &first
    second.keeper.pair.n = 50
    second.keeper.pair.small.n = 2
    second.keeper.handle = null
    second.call = c.weigh
    var total: u32 = second.call.?(second.back, &second.keeper)
    total += first.next.?.*.back.?.*.pair.n
    // (The sizes as each module sees them: a's pointers and b.Pair, c's
    // record with a b.Pair inside, b.B the same from a and from here.)
    if a.sizeOfB() == @sizeOf(b.B) && @sizeOf(a.A) == 32 && @sizeOf(c.Keeper) == 24 && @sizeOf(b.Pair) == 8 { total += 3 }
    return @intCast(u8, total)
}
