// A `while true` that no `break` ends never completes: a function may
// end with it (every way out of it is a `return`), where a `return` was
// asked for after it before. A `break` of a loop inside it, or one that
// names a loop around it, does not end it; a `continue` that names it
// does not either. Exits 13.
fn steps(start: u32) -> u32 {
    var state: u32 = 0
    var total: u32 = start
    dispatch: while true {
        if state == 0 {
            total += 1
            state = 1
        }
        if state == 1 {
            var k: u32 = 0
            while true {
                k += 1
                if k == 3 { break }
            }
            total += k
            if total < 10 {
                state = 0
                continue :dispatch
            }
            return total
        }
    }
}

fn firstAbove(limit: u32) -> u32 {
    var n: u32 = 0
    while true {
        n += 2
        if n > limit { return n }
    }
}

fn inner(limit: u32) -> u32 {
    var found: u32 = 0
    outer: while true {
        while true {
            found += 1
            if found >= limit { break :outer }
        }
    }
    return found
}

pub fn main() -> u8 {
    // steps(2): 2 +1 +3 = 6, again +1 +3 = 10.
    return @intCast(u8, steps(2) + firstAbove(1) - inner(1) + 2)
}
