// std.wayland Linux transport: a message plus a shared-memory handle crosses a
// Unix socket pair with SCM_RIGHTS; both ends map the same memory; epoll
// and waitAny report readiness; a listener accepts a path connection; the environment
// snapshot resolves variables. Exits 13.
const std = @import("std")
const wire = @import("std.wayland.wire")
const transport = @import("std.wayland.transport.linux")

pub fn main() -> u8 {
    const allocator = std.page_allocator.init()
    var left_descriptor: isize = -1
    var right_descriptor: isize = -1
    if !transport.socketPair(&left_descriptor, &right_descriptor) { return 1 }
    var left: transport.Connection = undefined
    var right: transport.Connection = undefined
    if !transport.init(&left, allocator, left_descriptor) { return 2 }
    if !transport.init(&right, allocator, right_descriptor) { return 3 }

    // Shared memory: create, map writable, write a pattern.
    const memory = transport.createSharedMemory(4096)
    if memory < 0 { return 4 }
    const address = transport.mapSharedMemory(memory, 4096, true)
    if address == 0 { return 5 }
    unsafe {
        const bytes = @ptrFromInt([*]u8, address)
        bytes[0] = 77
        bytes[4095] = 88
    }

    var writer: wire.Writer = undefined
    wire.begin(&writer, 5, 2)
    wire.putHandle(&writer, memory)
    wire.putInt(&writer, 4096)
    if !wire.finish(&writer) { return 6 }
    if transport.queue(&left, &writer) != 0 { return 7 }
    if transport.pendingOutput(&left) != 12 { return 8 }
    if transport.flush(&left) != 0 { return 9 }
    if transport.pendingOutput(&left) != 0 { return 10 }

    // epoll reports the right end readable with its registration token.
    const event_loop = transport.createEventLoop()
    if event_loop < 0 { return 11 }
    if !transport.watch(event_loop, right_descriptor, 4242, false) { return 12 }
    var events: transport.Events = undefined
    if transport.waitEvents(event_loop, &events, 1000) != 1 { return 14 }
    if transport.eventToken(&events, 0) != 4242 { return 15 }
    if (transport.eventFlags(&events, 0) & std.linux.event.EPOLLIN) == 0 { return 16 }

    // waitAny reports exactly the readable descriptor.
    var watched: [2]isize = [2]isize{ left_descriptor, right_descriptor }
    var ready: [2]bool = [2]bool{ true, false }
    unsafe {
        if transport.waitAny(@ptrCast([*]const isize, &watched), 2, @ptrCast([*]bool, &ready), 1000) != 1 { return 33 }
    }
    if ready[0] || !ready[1] { return 34 }

    if transport.receive(&right) != 12 { return 17 }
    if transport.bufferedInput(&right) != 12 || transport.bufferedHandles(&right) != 1 { return 18 }
    const message = transport.inputPointer(&right)
    if wire.headerObject(message) != 5 || wire.headerOpcode(message) != 2 || wire.headerSize(message) != 12 { return 19 }
    const received = transport.handlePointer(&right)[0]
    if received < 0 || received == memory { return 20 }
    transport.consume(&right, 12, 1)
    if transport.bufferedInput(&right) != 0 || transport.bufferedHandles(&right) != 0 { return 21 }

    // The received handle maps the same memory object.
    const peer = transport.mapSharedMemory(received, 4096, false)
    if peer == 0 { return 22 }
    unsafe {
        const view = @ptrFromInt([*]const u8, peer)
        if view[0] != 77 || view[4095] != 88 { return 23 }
    }
    transport.unmapSharedMemory(peer, 4096)
    transport.unmapSharedMemory(address, 4096)
    transport.close(received)

    // Nothing more to read: EAGAIN, then end of stream after the peer closes.
    if transport.receive(&right) != transport.EAGAIN { return 24 }
    transport.deinit(&left)
    if transport.receive(&right) != 0 { return 25 }
    transport.deinit(&right)
    transport.close(event_loop)

    // Path sockets with the libwayland lock-file convention.
    var lock: isize = -1
    unsafe {
        transport.unlinkPath(@ptrCast([*]const u8, "/tmp/mlx-wayland-transport-test"))
        lock = transport.lockPath(@ptrCast([*]const u8, "/tmp/mlx-wayland-transport-test.lock"))
    }
    if lock < 0 { return 26 }
    var listener: isize = -1
    unsafe { listener = transport.listenPath(@ptrCast([*]const u8, "/tmp/mlx-wayland-transport-test"), 31) }
    if listener < 0 { return 27 }
    var client: isize = -1
    unsafe { client = transport.connectPath(@ptrCast([*]const u8, "/tmp/mlx-wayland-transport-test"), 31) }
    if client < 0 { return 28 }
    if transport.wait(listener, false, 1000) != 1 { return 29 }
    const accepted = transport.accept(listener)
    if accepted < 0 { return 30 }
    transport.close(accepted)
    transport.close(client)
    transport.close(listener)
    unsafe {
        transport.unlinkPath(@ptrCast([*]const u8, "/tmp/mlx-wayland-transport-test"))
        transport.unlinkPath(@ptrCast([*]const u8, "/tmp/mlx-wayland-transport-test.lock"))
    }
    transport.close(lock)

    // A peer that does not read: the output buffer grows past its first
    // 64 KiB (a client busy for seconds while the pointer moves) instead
    // of EAGAIN at once; 1 MiB of messages are taken, and read back whole
    // once the peer reads.
    var slow_left: isize = -1
    var slow_right: isize = -1
    if !transport.socketPair(&slow_left, &slow_right) { return 33 }
    var writer_end: transport.Connection = undefined
    var reader_end: transport.Connection = undefined
    if !transport.init(&writer_end, allocator, slow_left) { return 34 }
    if !transport.init(&reader_end, allocator, slow_right) { return 35 }
    var sent: usize = 0
    var messages: usize = 0
    while sent < 1048576 {
        var filler: wire.Writer = undefined
        wire.begin(&filler, 7, 1)
        wire.putUint(&filler, @intCast(u32, messages))
        wire.putUint(&filler, 0x5a5a5a5a)
        if !wire.finish(&filler) { return 36 }
        if transport.queue(&writer_end, &filler) != 0 { return 37 }
        sent += filler.length
        messages += 1
    }
    if transport.pendingOutput(&writer_end) < 1048576 - 262144 { return 38 }
    var read_back: usize = 0
    var rounds: usize = 0
    while read_back < sent && rounds < 100000 {
        const flushed = transport.flush(&writer_end)
        if flushed < 0 && flushed != transport.EAGAIN { return 39 }
        const got = transport.receive(&reader_end)
        if got > 0 {
            read_back += @bitCast(usize, got)
            transport.consume(&reader_end, @bitCast(usize, got), 0)
        } else if got != transport.EAGAIN { return 40 }
        rounds += 1
    }
    if read_back != sent { return 41 }
    transport.deinit(&writer_end)
    transport.deinit(&reader_end)

    var environment: transport.Environment = undefined
    if !transport.loadEnvironment(&environment, allocator) { return 31 }
    const missing = transport.lookupEnvironment(&environment, "MLX_WAYLAND_SURELY_UNSET")
    if !wire.isNull(missing) { return 32 }
    transport.freeEnvironment(&environment)
    return 13
}
