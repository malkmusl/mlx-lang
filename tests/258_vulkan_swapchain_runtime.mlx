// The swapchain path of the Vulkan examples (examples/vulkan-shared/
// swapchain.mlx, what examples/vulkan-android presents with) on a real
// driver (tests/run_vulkan.sh: lavapipe), through a VK_EXT_headless_surface
// instead of an Android window: create the swapchain, render and present
// frames, recreate it, and check the frame the pattern shader produced.
// Exits 13.
const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const gpu = @import("../examples/vulkan-shared/gpu.mlx")
const shaders = @import("../examples/vulkan-shared/shaders.mlx")
const swapchain = @import("../examples/vulkan-shared/swapchain.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var driver: loader.Driver = undefined
    if loader.openFirstDriver(&driver, arguments, allocator) != loader.Status.ok { return 1 }
    var instance_extensions: [2][*]const u8 = undefined
    var device_extensions: [1][*]const u8 = undefined
    unsafe {
        instance_extensions[0] = @ptrCast([*]const u8, vk.KHR_SURFACE_EXTENSION_NAME)
        instance_extensions[1] = @ptrCast([*]const u8, vk.EXT_HEADLESS_SURFACE_EXTENSION_NAME)
        device_extensions[0] = @ptrCast([*]const u8, vk.KHR_SWAPCHAIN_EXTENSION_NAME)
    }
    var options = gpu.defaultOptions(@ptrCast([*]const u8, "swapchain"))
    unsafe {
        options.instanceExtensions = @ptrCast([*]const [*]const u8, &instance_extensions)
        options.deviceExtensions = @ptrCast([*]const [*]const u8, &device_extensions)
    }
    options.instanceExtensionCount = 2
    options.deviceExtensionCount = 1
    var context: gpu.Context = undefined
    if gpu.open(&context, driver, &options, allocator) != gpu.Status.ok { return 2 }

    var code: [*]u32 = undefined
    const words = shaders.build(allocator, 0, &code)
    var pattern: gpu.Kernel = undefined
    if !gpu.createKernel(&context, &pattern, code, words, 1, shaders.PATTERN_WORDS) { return 3 }

    var surface_info = vk.HeadlessSurfaceCreateInfoEXT.init()
    var surface: vk.SurfaceKHR = 0
    if vk.createHeadlessSurfaceEXT(context.instanceCommands, context.instance, &surface_info, null, &surface) != vk.Result.success { return 4 }
    var chain: swapchain.Swapchain = undefined
    if !swapchain.create(&context, &chain, surface, 64, 48) { return 5 }
    if chain.width != 64 || chain.height != 48 || chain.imageCount < 2 { return 6 }

    var push = shaders.Pattern.{ .width = 0, .height = 0, .time = 0, .pointerX = 10, .pointerY = 10, .flags = shaders.FLAG_POINTER }
    var frame: u32 = 0
    while frame < 5 {
        push.time = frame * 2
        if swapchain.present(&context, &chain, &pattern, push) != swapchain.FrameStatus.presented { return 7 }
        frame += 1
    }
    // The last frame (time 8) in the shader's layout for the chosen format.
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrFromInt([*]u32, chain.frame.address) }
    const red: u32 = (5 + 8) & 255
    const green: u32 = (3 + 4) & 255
    const blue: u32 = ((5 ^ 3) + 16) & 255
    const expected = if chain.formatFlags & shaders.FLAG_SWAP_RED_BLUE != 0 { 4278190080 | (blue << 16) | (green << 8) | red } else { 4278190080 | (red << 16) | (green << 8) | blue }
    if pixels[3 * 64 + 5] != expected { return 8 }

    // A new size: recreate on the same surface.
    swapchain.destroy(&context, &chain, true)
    if !swapchain.create(&context, &chain, surface, 32, 32) || chain.width != 32 { return 9 }
    if swapchain.present(&context, &chain, &pattern, push) != swapchain.FrameStatus.presented { return 10 }
    swapchain.destroy(&context, &chain, false)
    gpu.close(&context)
    return 13
}
