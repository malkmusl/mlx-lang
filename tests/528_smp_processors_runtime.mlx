// brixOS's processors as the firmware lists them, built for the host
// (projects/brix/kernel/processors.mlx, which smp.mlx starts them by),
// against MADTs written here as a firmware writes them:
// - one, 8, 9 (past the old ceiling of eight), 64, 255 local APICs (the
//   most eight-bit ids name: 255 is nobody), and 256 (the 256th an
//   x2APIC entry: left while the local APICs are in xAPIC mode, counted
//   beyond; listed in x2APIC mode), and more than 256 (counted over);
// - x2APIC entries of ids beyond 255 (listed in x2APIC mode only), one
//   for a processor a local APIC entry names already (one processor),
//   ids that name nobody (0xFF, 0xFFFFFFFF), other entries between;
// - processors that are off: not listed, counted, and of them those the
//   firmware may bring on later as Linux counts them (online capable in a
//   table of revision 5 or later; every one in an older table);
// - an entry that is too short or reaches beyond the table ends it;
// - the sets of processors (Mask: 256 bits, four words): set, unset,
//   has, count, the lowest but one, across the words' edges;
// - the arena divided among the processors found (layout.Memory): four
//   MiB each up to eight, the region divided while each share is 512 KiB
//   or more, 512 KiB each past that with the shares beyond the region
//   from the frames; every share whole steps, inside the region, none
//   over another; at 256 processors 56 shares in the region, 199 not;
// - the layout's room for 256: the trampoline's counter, room, blocks and
//   ids in its page, a GDT of 256 TSS descriptors under the 16-bit limit,
//   a processor's block and TSS in its page.
// Exits 13.
const std = @import("std")
const layout = @import("../projects/brix/layout.mlx")
const processors = @import("../projects/brix/kernel/processors.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn fail(what: []const u8, a: usize, b: usize) -> u8 {
    say("FAIL ")
    say(what)
    say(" (")
    number(a)
    say(", ")
    number(b)
    say(")\n")
    return 1
}

// A table being written: its bytes and its length so far.
const ROOM: usize = 8192
var table: [ROOM]u8 = undefined
var length: usize = 0

fn put8(at: usize, value: usize) -> void { table[at] = @intCast(u8, value & 0xFF) }

fn put32(at: usize, value: usize) -> void {
    put8(at, value)
    put8(at + 1, value >> 8)
    put8(at + 2, value >> 16)
    put8(at + 3, value >> 24)
}

// A new MADT of `revision`: its header, the local APICs' address, the
// flags (one PC-AT PIC).
fn begin(revision: usize) -> void {
    var k: usize = 0
    while k < ROOM {
        table[k] = 0
        k += 1
    }
    table[0] = 65
    table[1] = 80
    table[2] = 73
    table[3] = 67
    put8(8, revision)
    put32(36, 0xFEE00000)
    put32(40, 1)
    length = processors.ENTRIES
    put32(4, length)
}

fn grow(size: usize) -> usize {
    const at = length
    length += size
    put32(4, length)
    return at
}

// A processor's local APIC (type 0).
fn lapic(uid: usize, id: usize, flags: usize) -> void {
    const at = grow(8)
    put8(at, 0)
    put8(at + 1, 8)
    put8(at + 2, uid)
    put8(at + 3, id)
    put32(at + 4, flags)
}

// A processor's x2APIC (type 9).
fn x2apic(uid: usize, id: usize, flags: usize) -> void {
    const at = grow(16)
    put8(at, 9)
    put8(at + 1, 16)
    put32(at + 4, id)
    put32(at + 8, flags)
    put32(at + 12, uid)
}

// An I/O APIC (type 1) and an override (type 2): entries the reading
// passes over.
fn others() -> void {
    var at = grow(12)
    put8(at, 1)
    put8(at + 1, 12)
    put32(at + 4, 0xFEC00000)
    at = grow(10)
    put8(at, 2)
    put8(at + 1, 10)
}

var listed: processors.Listed = undefined

fn read(x2: bool) -> void {
    const bytes: [*]const u8 = &table
    processors.read(bytes, x2, &listed)
}

const ON: usize = processors.ENABLED
const CAPABLE: usize = processors.ONLINE_CAPABLE

// `count` processors that are on, ids 0 to count - 1, local APIC entries.
fn many(count: usize) -> void {
    begin(5)
    var k: usize = 0
    while k < count {
        lapic(k, k, ON)
        k += 1
    }
}

fn inOrder(count: usize) -> bool {
    if listed.count != count { return false }
    var k: usize = 0
    while k < count {
        if @intCast(usize, listed.ids[k]) != k { return false }
        k += 1
    }
    return true
}

fn clean() -> bool { return listed.disabled == 0 && listed.capable == 0 && listed.beyond == 0 && listed.over == 0 && listed.twice == 0 }

pub fn main() -> u8 {
    // ---- one, eight, nine, 64, 255 ----
    const counts = [_]usize{ 1, 8, 9, 64, 255 }
    for count in counts {
        many(count)
        read(false)
        if !inOrder(count) || !clean() { return fail("processors listed are not the table's, in its order", count, listed.count) }
        read(true)
        if !inOrder(count) { return fail("x2APIC mode lists other processors", count, listed.count) }
    }
    // (Entries of other kinds between them change nothing.)
    begin(5)
    lapic(0, 0, ON)
    others()
    lapic(1, 1, ON)
    others()
    read(false)
    if !inOrder(2) || !clean() { return fail("other entries between the processors' change what is listed", listed.count, 0) }

    // ---- 256: the last an x2APIC entry (id 255) ----
    many(255)
    x2apic(255, 255, ON)
    read(false)
    if listed.count != 255 || listed.beyond != 1 { return fail("an id of 255 in xAPIC mode is not left and counted", listed.count, listed.beyond) }
    read(true)
    if listed.count != 256 || listed.beyond != 0 || @intCast(usize, listed.ids[255]) != 255 { return fail("256 processors in x2APIC mode are not 256", listed.count, listed.beyond) }
    // (And more than 256: the first 256 listed, the rest counted.)
    begin(5)
    var k: usize = 0
    while k < 300 {
        x2apic(k, k * 2, ON)
        k += 1
    }
    read(true)
    if listed.count != processors.MAX || listed.over != 44 || @intCast(usize, listed.ids[255]) != 510 { return fail("past 256 processors the first 256 are not listed and the rest counted", listed.count, listed.over) }

    // ---- x2APIC ids beyond 255, a processor named twice, nobody ----
    begin(5)
    lapic(0, 0, ON)
    lapic(1, 1, ON)
    x2apic(2, 300, ON)
    x2apic(3, 70000, ON)
    x2apic(4, 1, ON)
    lapic(5, 0xFF, ON)
    x2apic(6, 0xFFFFFFFF, ON)
    read(false)
    if listed.count != 2 || listed.beyond != 2 || listed.twice != 1 { return fail("x2APIC ids in xAPIC mode are not left, or a processor named twice not one", listed.count, listed.beyond) }
    read(true)
    if listed.count != 4 || listed.ids[2] != 300 || listed.ids[3] != 70000 || listed.twice != 1 || listed.beyond != 0 { return fail("x2APIC ids are not listed in x2APIC mode", listed.count, @intCast(usize, listed.ids[3])) }
    if !listed.has(70000) || listed.has(0xFF) || listed.has(5) { return fail("has() says otherwise than the list", 0, 0) }

    // ---- processors that are off ----
    begin(5)
    lapic(0, 0, ON)
    lapic(1, 1, 0)
    lapic(2, 2, CAPABLE)
    x2apic(3, 400, CAPABLE)
    x2apic(4, 401, 0)
    lapic(5, 5, ON | CAPABLE)
    read(true)
    if listed.count != 2 || listed.ids[1] != 5 { return fail("processors that are off are listed", listed.count, 0) }
    if listed.disabled != 4 || listed.capable != 2 { return fail("of those off, the online capable ones are not counted apart", listed.disabled, listed.capable) }
    // (A table older than ACPI 6.3: every one that is off may come.)
    put8(8, 4)
    read(true)
    if listed.disabled != 4 || listed.capable != 4 { return fail("in an older table every processor off is not one that may come", listed.disabled, listed.capable) }

    // ---- an entry too short, or beyond the table ----
    begin(5)
    lapic(0, 0, ON)
    var at = grow(2)
    put8(at, 0)
    put8(at + 1, 0)
    lapic(1, 1, ON)
    read(false)
    if listed.count != 1 { return fail("an entry of no length does not end the table", listed.count, 0) }
    begin(5)
    lapic(0, 0, ON)
    lapic(1, 1, ON)
    put32(4, length - 3)
    read(false)
    if listed.count != 1 { return fail("an entry beyond the table's length is read", listed.count, 0) }

    // ---- sets of processors ----
    var mask: processors.Mask = undefined
    mask.clear()
    if mask.count() != 0 || mask.firstBut(processors.MAX).0 { return fail("an empty set has processors", mask.count(), 0) }
    const edges = [_]usize{ 0, 63, 64, 127, 128, 191, 192, 255 }
    for edge in edges { mask.set(edge) }
    if mask.count() != 8 { return fail("a set of eight does not count eight", mask.count(), 0) }
    for edge in edges {
        if !mask.has(edge) { return fail("a set does not have what was put in", edge, 0) }
    }
    const between = [_]usize{ 1, 62, 65, 126, 129, 190, 193, 254 }
    for gap in between {
        if mask.has(gap) { return fail("a set has what was not put in", gap, 0) }
    }
    var first = mask.firstBut(processors.MAX)
    if !first.0 || first.1 != 0 { return fail("the lowest is not 0", first.1, 0) }
    first = mask.firstBut(0)
    if !first.0 || first.1 != 63 { return fail("the lowest but 0 is not 63", first.1, 0) }
    mask.unset(0)
    mask.unset(63)
    first = mask.firstBut(64)
    if !first.0 || first.1 != 127 { return fail("the lowest but 64 is not 127 (across a word)", first.1, 0) }
    var left: usize = 0
    while left < 255 {
        mask.unset(left)
        left += 1
    }
    first = mask.firstBut(7)
    if mask.count() != 1 || !first.0 || first.1 != 255 { return fail("the last bit alone is not found", mask.count(), first.1) }
    if mask.firstBut(255).0 { return fail("the lowest but the only one is something", 0, 0) }
    var all: usize = 0
    while all < processors.MAX {
        mask.set(all)
        all += 1
    }
    if mask.count() != 256 { return fail("a full set is not 256", mask.count(), 0) }
    var low: usize = 0
    while low < 64 {
        if processors.lowest(@intCast(usize, 1) << @intCast(u6, low)) != low { return fail("the lowest bit's number", low, 0) }
        low += 1
    }

    // ---- the arena divided ----
    const M = layout.Memory
    const plans = [_]usize{ 1, 2, 7, 8, 15, 28, 55, 56, 57, 63, 127, 254, 255 }
    for others in plans {
        const share = M.arenaShare(others)
        const inRegion = M.arenasInRegion(others)
        if share < M.ARENA_LEAST || share > M.ARENA_MOST || share % M.ARENA_STEP != 0 { return fail("a share is not whole steps between the least and the most", others, share) }
        if inRegion > others || inRegion * share > M.ARENA_SIZE - M.ARENA_FIRST { return fail("more shares in the region than it holds", others, inRegion) }
        if inRegion < others && share != M.ARENA_LEAST { return fail("shares beyond the region that are not the least", others, share) }
        if inRegion == others && others * share > M.ARENA_SIZE - M.ARENA_FIRST { return fail("the region does not hold every share", others, share) }
        var cpu: usize = 1
        while cpu <= inRegion {
            const base = M.arenaOf(cpu, others)
            if base < M.ARENA + M.ARENA_FIRST || base + share > M.ARENA + M.ARENA_SIZE || base + share > M.FREE { return fail("a share is not inside the region", others, cpu) }
            if cpu > 1 && base != M.arenaOf(cpu - 1, others) + share { return fail("shares are not one after the other", others, cpu) }
            cpu += 1
        }
        if others <= 7 && share != M.ARENA_MOST { return fail("up to eight processors a share is not 4 MiB", others, share) }
    }
    if M.arenaOf(0, 63) != M.ARENA || M.ARENA_FIRST != 0x400000 { return fail("the first processor's arena is not the region's first 4 MiB", 0, 0) }
    if M.arenaShare(255) != 0x80000 || M.arenasInRegion(255) != 56 { return fail("at 256 processors the share is not 512 KiB with 56 in the region", M.arenaShare(255), M.arenasInRegion(255)) }
    if M.arenaShare(15) != 0x1D0000 || M.arenasInRegion(15) != 15 { return fail("at 16 processors the region is not divided", M.arenaShare(15), 0) }

    // ---- room for 256 ----
    if M.MAX_CPUS != processors.MAX { return fail("the layout's processors are not the MADT's", M.MAX_CPUS, processors.MAX) }
    const Ap = layout.Ap
    if Ap.STARTED + 4 > Ap.ROOM || Ap.ROOM + 4 > Ap.BLOCKS || Ap.SIZE > Ap.BLOCKS || Ap.GDTR + 6 > Ap.STARTED { return fail("the trampoline's words reach into each other", Ap.ROOM, Ap.BLOCKS) }
    if Ap.BLOCKS + 8 * M.MAX_CPUS > Ap.IDS || Ap.IDS + 4 * M.MAX_CPUS > Ap.END || Ap.END > 0x1000 { return fail("the trampoline's tables are not in its page", Ap.IDS, Ap.END) }
    if layout.Selector.TSS + 16 * M.MAX_CPUS > 0x10000 { return fail("a GDT for 256 processors is past the 16-bit limit", 0, 0) }
    if layout.PerCpu.INDEX + 8 > layout.PerCpu.TSS_AT || layout.PerCpu.TSS_AT + 104 > 0x1000 || layout.Blob.PERCPU_SIZE > layout.PerCpu.TSS_AT { return fail("a processor's block and TSS are not in its page", 0, 0) }
    if Ap.CLOSED & (Ap.CLOSED - 1) != 0 || Ap.CLOSED <= M.MAX_CPUS { return fail("the closed mark is a count", Ap.CLOSED, 0) }
    return 13
}
