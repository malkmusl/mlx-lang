// The RX 580's registers as the generated modules hold them
// (projects/brix/registers, made by tools/gpu_registers_generate.py)
// against the specifications they are made from, read by this test's own
// parser: Linux v6.6's asic_reg headers (every #define of a number, the
// enums of gfx_8_0_enum.h) and Mesa mesa-24.0.0's register database (its
// JSON through std.json's tokenizer), both as projects/brix/registers/
// upstream keeps them. For each block's module (bif_5_0, dce_11_2,
// gfx_8_0, gmc_8_1, oss_3_0, smu_7_1_3): every constant is the number its
// name gives in the block's headers (a register its mmNAME or ixNAME, a
// field its _MASK and __SHIFT, an enum value its enum's entry), the
// registers are SELECTION's (and gfx_8_0's the 32 the database has in
// another form), each with every field the header gives it, and the
// display's MMIO_RUNS are made again from dce_11_2_d.h. For the database's
// modules (gfx8, gfx8_enums): every register at the database's byte
// offset, every field at its bits with the enum it takes, every enum with
// every value, nothing else. The inputs' sha256 are the ones SOURCES pins
// and the modules' heads say. Some constants are compared as compiled
// (imported) with the sources' numbers too. And the cases where the
// database and Linux's headers differ are found again and named: the 32
// SQ_WAVE registers the database has among the MMIO words that Linux has
// in the SQ's index space (SQ_WAVE_MODE: MMIO 0x44 against ixSQ_WAVE_MODE
// 0x11), two fields only the database names, 754 registers to which only
// Linux gives a field (the whole word), 11 enums only the database has;
// every other register (1464), field (3441) and enum value (622) the same;
// gfx8.mlx's head names each case.
// Run from the repository's root. A failing check prints its line.
// Exits 13.
const std = @import("std")
const json = @import("std.json")
const sha2 = @import("std.sha2")
const gfx8 = @import("../projects/brix/registers/gfx8.mlx")
const gfx8_enums = @import("../projects/brix/registers/gfx8_enums.mlx")
const bif_5_0 = @import("../projects/brix/registers/bif_5_0.mlx")
const dce_11_2 = @import("../projects/brix/registers/dce_11_2.mlx")
const gfx_8_0 = @import("../projects/brix/registers/gfx_8_0.mlx")
const gmc_8_1 = @import("../projects/brix/registers/gmc_8_1.mlx")
const oss_3_0 = @import("../projects/brix/registers/oss_3_0.mlx")
const smu_7_1_3 = @import("../projects/brix/registers/smu_7_1_3.mlx")

const Map = std.StringHashMap(u64)
const NONE: u64 = 18446744073709551615

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn sayNumber(value: u64) -> void {
    var digits: [24]u8 = undefined
    const n = std.text.appendHex(&digits, 0, 24, @intCast(usize, value))
    say("0x")
    say(digits[0..n])
}

var failed: u16 = 0

// A check that does not hold: its number and what it says, the first one's
// number the test's exit.
fn check(number: u16, holds: bool, what: []const u8, name: []const u8) -> bool {
    if holds { return true }
    if failed == 0 { failed = number }
    var digits: [8]u8 = undefined
    const n = std.text.appendUnsigned(&digits, 0, 8, @intCast(usize, number))
    say("check ")
    say(digits[0..n])
    say(" fails: ")
    say(what)
    if name.length != 0 {
        say(": ")
        say(name)
    }
    say("\n")
    return false
}

fn same(a: []const u8, b: []const u8) -> bool { return std.text.same(a, b) }

// A file of the repository's (a literal path, as the compiler ends it with
// a NUL), whole; empty when it cannot be read.
fn load(path: []const u8) -> []const u8 {
    const got = std.fs.readFileAlloc(path.pointer, std.heap.allocator())
    if got == null { return "" }
    return unsafe { @ptrCast([*]const u8, got.?.items) }[0..got.?.length]
}

// Keys made of two names (an enum's and its value's), kept for the maps.
var keyRoom: [262144]u8 = undefined
var keyUsed: usize = 0

fn joined(a: []const u8, b: []const u8) -> []const u8 {
    const start = keyUsed
    if keyUsed + a.length + b.length + 1 > 262144 { return "" }
    for byte in a {
        keyRoom[keyUsed] = byte
        keyUsed += 1
    }
    keyRoom[keyUsed] = 46
    keyUsed += 1
    for byte in b {
        keyRoom[keyUsed] = byte
        keyUsed += 1
    }
    return keyRoom[start..keyUsed]
}

// A name with words before and after it, for one lookup (not kept: the
// next call writes over it).
var lookRoom: [512]u8 = undefined

fn around4(a: []const u8, b: []const u8, c: []const u8, d: []const u8) -> []const u8 {
    var n: usize = 0
    if a.length + b.length + c.length + d.length > 512 { return "" }
    for byte in a {
        lookRoom[n] = byte
        n += 1
    }
    for byte in b {
        lookRoom[n] = byte
        n += 1
    }
    for byte in c {
        lookRoom[n] = byte
        n += 1
    }
    for byte in d {
        lookRoom[n] = byte
        n += 1
    }
    return lookRoom[0..n]
}

fn around(before: []const u8, name: []const u8, after: []const u8) -> []const u8 { return around4(before, name, after, "") }

// ---- The test's own reading of the sources.

fn isWord(byte: u8) -> bool {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

// The number written at text[start..]: hexadecimal after 0x, else decimal,
// C's U and L after it passed over; NONE when there is none. `end` is
// where it ends.
fn numberAt(text: []const u8, start: usize, end: *usize) -> u64 {
    var at = start
    var value: u64 = 0
    var digits: usize = 0
    if at + 1 < text.length && text[at] == 48 && (text[at + 1] == 120 || text[at + 1] == 88) {
        at += 2
        while at < text.length && std.text.hexValue(text[at]) < 16 {
            value = value * 16 + @intCast(u64, std.text.hexValue(text[at]))
            digits += 1
            at += 1
        }
    } else {
        while at < text.length && text[at] >= 48 && text[at] <= 57 {
            value = value * 10 + @intCast(u64, text[at] - 48)
            digits += 1
            at += 1
        }
    }
    if digits == 0 { return NONE }
    while at < text.length && (text[at] == 85 || text[at] == 117 || text[at] == 76 || text[at] == 108) { at += 1 }
    end.* = at
    return value
}

// Every `#define NAME NUMBER` of a header. Of a field header also, for
// each register (the name before a field's first "__"), how many fields
// it has with both a mask and a shift, and how many of them are the whole
// word. How many numbers were read.
fn defines(text: []const u8, into: *Map) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < text.length {
        var stop = at
        while stop < text.length && text[stop] != 10 { stop += 1 }
        if stop - at > 8 && std.text.startsWith(text[at..stop], "#define ") {
            var k = at + 8
            while k < stop && (text[k] == 32 || text[k] == 9) { k += 1 }
            const first = k
            while k < stop && isWord(text[k]) { k += 1 }
            const name = text[first..k]
            while k < stop && (text[k] == 32 || text[k] == 9) { k += 1 }
            var end: usize = 0
            const value = numberAt(text, k, &end)
            if value != NONE && name.length != 0 {
                _ = into.*.put(name, value)
                count += 1
            }
        }
        at = stop + 1
    }
    return count
}

fn fieldsOf(masks: *Map, text: []const u8, counts: *Map, whole: *Map) -> void {
    var at: usize = 0
    while at < text.length {
        var stop = at
        while stop < text.length && text[stop] != 10 { stop += 1 }
        if stop - at > 8 && std.text.startsWith(text[at..stop], "#define ") {
            var k = at + 8
            while k < stop && (text[k] == 32 || text[k] == 9) { k += 1 }
            const first = k
            while k < stop && isWord(text[k]) { k += 1 }
            const name = text[first..k]
            if std.text.endsWith(name, "_MASK") {
                const base = name[0..name.length - 5]
                const cut = std.text.find(base, "__")
                if cut < base.length && masks.*.get(around("", base, "__SHIFT")) != null {
                    const register = base[0..cut]
                    const had = counts.*.get(register)
                    _ = counts.*.put(register, if had == null { 1 } else { had.? + 1 })
                    if masks.*.get(name).? == 4294967295 {
                        const was = whole.*.get(register)
                        _ = whole.*.put(register, if was == null { 1 } else { was.? + 1 })
                    }
                }
            }
        }
        at = stop + 1
    }
}

// The value `entry` has in enum `name` of an enum header; NONE when the
// header has no such enum or it no such value. `count` gets how many
// values the enum has.
fn enumValue(text: []const u8, name: []const u8, entry: []const u8, count: *usize) -> u64 {
    count.* = 0
    const head = around("typedef enum ", name, " {")
    const start = std.text.find(text, head)
    if start >= text.length { return NONE }
    var at = start + head.length
    var found = NONE
    while at < text.length && text[at] != 125 {
        while at < text.length && (text[at] == 32 || text[at] == 9 || text[at] == 10 || text[at] == 13 || text[at] == 44) { at += 1 }
        if at >= text.length || text[at] == 125 { break }
        const first = at
        while at < text.length && isWord(text[at]) { at += 1 }
        const word = text[first..at]
        while at < text.length && (text[at] == 32 || text[at] == 9 || text[at] == 61) { at += 1 }
        var end: usize = at
        const value = numberAt(text, at, &end)
        if value == NONE { return NONE }
        at = end
        count.* += 1
        if same(word, entry) { found = value }
    }
    return found
}

// The database: its registers (gfx8.json's and Mesa's own additions for
// GFX8), the types' fields, the enums' values.
const Register = struct {
    name: []const u8
    at: u64
    kind: []const u8
    mine: bool
}
const Field = struct {
    name: []const u8
    low: u64
    high: u64
    takes: []const u8
}
const Entry = struct {
    of: []const u8
    name: []const u8
    value: u64
}
var registers: [2048]Register = undefined
var registerCount: usize = 0
var fields: [8192]Field = undefined
var fieldCount: usize = 0
var entries: [4096]Entry = undefined
var entryCount: usize = 0
var enumNames: [256][]const u8 = undefined
var enumCount: usize = 0

fn is(token: *const json.Token, kind: json.TokenKind) -> bool { return token.*.kind == kind }

// Reads one of the database's files: the types' fields go to `fields`, a
// type's first and last in `firsts` and `ends`.
fn readDatabase(text: []const u8, mine: bool, firsts: *Map, ends: *Map) -> bool {
    var t: json.Tokenizer = undefined
    json.initAt(&t, text.pointer, text.length)
    var token: json.Token = undefined
    var keys: [8][]const u8 = undefined
    var k: usize = 0
    while k < 8 {
        keys[k] = ""
        k += 1
    }
    var name: []const u8 = ""
    var at: u64 = NONE
    var kind: []const u8 = ""
    var chip = false
    var low: u64 = NONE
    var high: u64 = NONE
    var bit: usize = 0
    var takes: []const u8 = ""
    var value: u64 = NONE
    var typeFirst: usize = 0
    while json.next(&t, &token) {
        const depth = json.depth(&t)
        const raw = std.string.asSlice(token.value)
        if is(&token, json.TokenKind.key) {
            if depth < 8 { keys[depth] = raw }
            continue
        }
        var number: u64 = NONE
        if is(&token, json.TokenKind.number) {
            var parsed: u64 = 0
            if !json.parseUnsigned(token.value, &parsed) { return false }
            number = parsed
        }
        const section = keys[1]
        if same(section, "register_mappings") {
            if is(&token, json.TokenKind.objectStart) && depth == 3 {
                name = ""
                at = NONE
                kind = ""
                chip = false
            } else if is(&token, json.TokenKind.string) && depth == 3 && same(keys[3], "name") {
                name = raw
            } else if is(&token, json.TokenKind.string) && depth == 3 && same(keys[3], "type_ref") {
                kind = raw
            } else if is(&token, json.TokenKind.string) && depth == 4 && same(keys[3], "chips") && same(raw, "gfx8") {
                chip = true
            } else if is(&token, json.TokenKind.number) && depth == 4 && same(keys[3], "map") && same(keys[4], "at") {
                at = number
            } else if is(&token, json.TokenKind.string) && depth == 4 && same(keys[3], "map") && same(keys[4], "to") && !same(raw, "mm") {
                return false
            } else if is(&token, json.TokenKind.objectEnd) && depth == 2 && chip {
                if registerCount == 2048 || name.length == 0 || at == NONE { return false }
                registers[registerCount] = Register.{ .name = name, .at = at, .kind = kind, .mine = mine }
                registerCount += 1
            }
        } else if same(section, "register_types") {
            if is(&token, json.TokenKind.objectStart) && depth == 3 {
                typeFirst = fieldCount
            } else if is(&token, json.TokenKind.objectStart) && depth == 5 {
                name = ""
                low = NONE
                high = NONE
                bit = 0
                takes = ""
            } else if is(&token, json.TokenKind.number) && depth == 6 && same(keys[5], "bits") {
                if bit == 0 { low = number } else { high = number }
                bit += 1
            } else if is(&token, json.TokenKind.string) && depth == 5 && same(keys[5], "name") {
                name = raw
            } else if is(&token, json.TokenKind.string) && depth == 5 && same(keys[5], "enum_ref") {
                takes = raw
            } else if is(&token, json.TokenKind.objectEnd) && depth == 4 {
                if fieldCount == 8192 || bit != 2 || name.length == 0 { return false }
                fields[fieldCount] = Field.{ .name = name, .low = low, .high = high, .takes = takes }
                fieldCount += 1
            } else if is(&token, json.TokenKind.objectEnd) && depth == 2 {
                _ = firsts.*.put(keys[2], @intCast(u64, typeFirst))
                _ = ends.*.put(keys[2], @intCast(u64, fieldCount))
            }
        } else if same(section, "enums") {
            if is(&token, json.TokenKind.objectStart) && depth == 3 {
                if enumCount == 256 { return false }
                enumNames[enumCount] = keys[2]
                enumCount += 1
            } else if is(&token, json.TokenKind.objectStart) && depth == 5 {
                name = ""
                value = NONE
            } else if is(&token, json.TokenKind.string) && depth == 5 && same(keys[5], "name") {
                name = raw
            } else if is(&token, json.TokenKind.number) && depth == 5 && same(keys[5], "value") {
                value = number
            } else if is(&token, json.TokenKind.objectEnd) && depth == 4 {
                if entryCount == 4096 || name.length == 0 || value == NONE { return false }
                entries[entryCount] = Entry.{ .of = keys[2], .name = name, .value = value }
                entryCount += 1
            }
        }
    }
    return !json.failed(&t)
}

fn mask(low: u64, high: u64) -> u64 {
    return ((@intCast(u64, 1) << @intCast(u6, high - low + 1)) - 1) << @intCast(u6, low)
}

// ---- A generated module read as text: its constants (a struct's own
// with the struct's name) and the numbers of its one table.
const Constant = struct {
    name: []const u8
    value: u64
    inside: []const u8
    note: []const u8
}
var constants: [16384]Constant = undefined
var constantCount: usize = 0
var table: [512]u64 = undefined
var tableCount: usize = 0

fn readModule(text: []const u8) -> bool {
    constantCount = 0
    tableCount = 0
    var inside: []const u8 = ""
    var array = false
    var at: usize = 0
    while at < text.length {
        var stop = at
        while stop < text.length && text[stop] != 10 { stop += 1 }
        const line = text[at..stop]
        at = stop + 1
        if line.length == 0 || std.text.startsWith(line, "//") { continue }
        if same(line, "}") {
            inside = ""
            array = false
            continue
        }
        if array {
            var k: usize = 0
            while k < line.length {
                while k < line.length && (line[k] == 32 || line[k] == 44) { k += 1 }
                if k >= line.length { break }
                var end: usize = k
                const value = numberAt(line, k, &end)
                if value == NONE || tableCount == 512 { return false }
                table[tableCount] = value
                tableCount += 1
                k = end
            }
            continue
        }
        var k: usize = 0
        while k < line.length && line[k] == 32 { k += 1 }
        if !std.text.startsWith(line[k..line.length], "pub const ") { return false }
        k += 10
        const first = k
        while k < line.length && isWord(line[k]) { k += 1 }
        const name = line[first..k]
        const rest = line[k..line.length]
        if same(rest, " = struct {") {
            inside = name
            continue
        }
        if same(rest, " = [_]usize{") {
            array = true
            continue
        }
        if !std.text.startsWith(rest, " = ") { return false }
        var end: usize = 0
        const value = numberAt(line, k + 3, &end)
        if value == NONE || constantCount == 16384 { return false }
        var note: []const u8 = ""
        if end < line.length {
            if !std.text.startsWith(line[end..line.length], " // ") { return false }
            note = line[end + 4..line.length]
        }
        constants[constantCount] = Constant.{ .name = name, .value = value, .inside = inside, .note = note }
        constantCount += 1
    }
    return true
}

// ---- The six blocks.
const Block = struct {
    module: []const u8
    registers: []const u8
    fields: []const u8
}
const BLOCKS = [6]Block{
    Block.{ .module = "bif_5_0", .registers = "projects/brix/registers/upstream/linux-v6.6/asic_reg/bif/bif_5_0_d.h", .fields = "projects/brix/registers/upstream/linux-v6.6/asic_reg/bif/bif_5_0_sh_mask.h" },
    Block.{ .module = "dce_11_2", .registers = "projects/brix/registers/upstream/linux-v6.6/asic_reg/dce/dce_11_2_d.h", .fields = "projects/brix/registers/upstream/linux-v6.6/asic_reg/dce/dce_11_2_sh_mask.h" },
    Block.{ .module = "gfx_8_0", .registers = "projects/brix/registers/upstream/linux-v6.6/asic_reg/gca/gfx_8_0_d.h", .fields = "projects/brix/registers/upstream/linux-v6.6/asic_reg/gca/gfx_8_0_sh_mask.h" },
    Block.{ .module = "gmc_8_1", .registers = "projects/brix/registers/upstream/linux-v6.6/asic_reg/gmc/gmc_8_1_d.h", .fields = "projects/brix/registers/upstream/linux-v6.6/asic_reg/gmc/gmc_8_1_sh_mask.h" },
    Block.{ .module = "oss_3_0", .registers = "projects/brix/registers/upstream/linux-v6.6/asic_reg/oss/oss_3_0_d.h", .fields = "projects/brix/registers/upstream/linux-v6.6/asic_reg/oss/oss_3_0_sh_mask.h" },
    Block.{ .module = "smu_7_1_3", .registers = "projects/brix/registers/upstream/linux-v6.6/asic_reg/smu/smu_7_1_3_d.h", .fields = "projects/brix/registers/upstream/linux-v6.6/asic_reg/smu/smu_7_1_3_sh_mask.h" },
}
const MODULE_FILES = [6][]const u8{
    "projects/brix/registers/bif_5_0.mlx",
    "projects/brix/registers/dce_11_2.mlx",
    "projects/brix/registers/gfx_8_0.mlx",
    "projects/brix/registers/gmc_8_1.mlx",
    "projects/brix/registers/oss_3_0.mlx",
    "projects/brix/registers/smu_7_1_3.mlx",
}
const UPSTREAM = "projects/brix/registers/upstream/"
const ENUM_HEADER = "projects/brix/registers/upstream/linux-v6.6/asic_reg/gca/gfx_8_0_enum.h"
const SELECTION = "projects/brix/registers/SELECTION"
const SOURCES = "projects/brix/registers/upstream/SOURCES"
const DATABASE = "projects/brix/registers/upstream/mesa-24.0.0/src/amd/registers/gfx8.json"
const DATABASE_MINE = "projects/brix/registers/upstream/mesa-24.0.0/src/amd/registers/registers-manually-defined.json"

// The 32 registers the database has among the MMIO words and Linux in the
// SQ's index space; the fields and enums only the database has.
const ELSEWHERE = [32][]const u8{ "SQ_WAVE_MODE", "SQ_WAVE_STATUS", "SQ_WAVE_TRAPSTS", "SQ_WAVE_HW_ID", "SQ_WAVE_GPR_ALLOC", "SQ_WAVE_LDS_ALLOC", "SQ_WAVE_IB_STS", "SQ_WAVE_PC_LO", "SQ_WAVE_PC_HI", "SQ_WAVE_INST_DW0", "SQ_WAVE_INST_DW1", "SQ_WAVE_IB_DBG0", "SQ_WAVE_IB_DBG1", "SQ_WAVE_TBA_LO", "SQ_WAVE_TBA_HI", "SQ_WAVE_TMA_LO", "SQ_WAVE_TMA_HI", "SQ_WAVE_TTMP0", "SQ_WAVE_TTMP1", "SQ_WAVE_TTMP2", "SQ_WAVE_TTMP3", "SQ_WAVE_TTMP4", "SQ_WAVE_TTMP5", "SQ_WAVE_TTMP6", "SQ_WAVE_TTMP7", "SQ_WAVE_TTMP8", "SQ_WAVE_TTMP9", "SQ_WAVE_TTMP10", "SQ_WAVE_TTMP11", "SQ_WAVE_M0", "SQ_WAVE_EXEC_LO", "SQ_WAVE_EXEC_HI" }
const ONLY_DATABASE_FIELDS = [2][]const u8{ "SQ_IMG_SAMP_WORD3.UPGRADED_DEPTH", "SQ_THREAD_TRACE_MASK.RANDOM_SEED" }
const ONLY_DATABASE_ENUMS = [11][]const u8{ "CB_COLOR_DCC_CONTROL__MAX_UNCOMPRESSED_BLOCK_SIZE", "CB_COLOR_DCC_CONTROL__MIN_COMPRESSED_BLOCK_SIZE", "CLIP_RULE", "EXCP_EN", "FLOAT_MODE", "PA_SU_SC_MODE_CNTL__POLYMODE_FRONT_PTYPE", "PA_SU_SC_MODE_CNTL__POLY_MODE", "PA_SU_VTX_CNTL__ROUND_MODE", "QUANT_MODE", "ROP3", "VGT_HS_OFFCHIP_PARAM__OFFCHIP_GRANULARITY" }

fn listed(list: []const []const u8, name: []const u8) -> bool {
    for item in list {
        if same(item, name) { return true }
    }
    return false
}

// The number the block's headers give a constant's name: a register its
// mmNAME or ixNAME, a field its _MASK, a shift its __SHIFT.
fn headerNumber(name: []const u8, registers: *Map, masks: *Map) -> u64 {
    var got: ?u64 = null
    if std.text.startsWith(name, "ix") {
        got = registers.*.get(name)
    } else if std.text.endsWith(name, "__SHIFT") {
        got = masks.*.get(name)
    } else if std.text.contains(name, "__") {
        got = masks.*.get(around("", name, "_MASK"))
    } else {
        got = registers.*.get(around("mm", name, ""))
    }
    if got == null { return NONE }
    return got.?
}

// SELECTION's names for a block.
var chosen: [1024][]const u8 = undefined
var chosenCount: usize = 0
var chosenEnums: usize = 0

fn readSelection(text: []const u8, module: []const u8) -> void {
    chosenCount = 0
    chosenEnums = 0
    var mine = false
    var at: usize = 0
    while at < text.length {
        var stop = at
        while stop < text.length && text[stop] != 10 { stop += 1 }
        const line = text[at..stop]
        at = stop + 1
        if line.length == 0 || line[0] == 35 { continue }
        if line[0] == 91 {
            mine = line.length == module.length + 2 && same(line[1..line.length - 1], module)
            continue
        }
        if !mine { continue }
        if std.text.startsWith(line, "enum ") {
            chosenEnums += 1
        } else if chosenCount < 1024 {
            chosen[chosenCount] = line
            chosenCount += 1
        }
    }
}

// The sha256 of `bytes` as the generator writes it.
fn digestOf(bytes: []const u8, into: *[64]u8) -> []const u8 {
    var digest: [32]u8 = undefined
    sha2.sha256(bytes, &digest)
    const hex = "0123456789abcdef"
    var k: usize = 0
    while k < 32 {
        into.*[2 * k] = hex[@intCast(usize, digest[k] >> 4)]
        into.*[2 * k + 1] = hex[@intCast(usize, digest[k] & 15)]
        k += 1
    }
    return into.*[0..64]
}

// An input pinned: SOURCES has its sha256 on its line, the module's head
// has it too.
fn pinned(base: u16, path: []const u8, sources: []const u8, head: []const u8) -> void {
    var room: [64]u8 = undefined
    const bytes = load(path)
    const digest = digestOf(bytes, &room)
    const tail = path[UPSTREAM.length..path.length]
    const line = std.text.find(sources, around("", tail, " "))
    var stop = line
    while stop < sources.length && sources[stop] != 10 { stop += 1 }
    _ = check(base, bytes.length != 0 && line < sources.length && std.text.endsWith(sources[line..stop], digest), "SOURCES pins the input's sha256", path)
    _ = check(base + 1, std.text.contains(head, digest), "the module's head says the input's sha256", path)
}

fn headOf(text: []const u8) -> []const u8 {
    const at = std.text.find(text, "\npub const ")
    return text[0..at]
}

// ---- One block's module against its headers.
fn holdBlock(n: usize, selection: []const u8, sources: []const u8, enumText: []const u8) -> void {
    const allocator = std.heap.allocator()
    const block = BLOCKS[n]
    const base = @intCast(u16, 100 + 20 * n)
    var numbers = Map.init(allocator)
    var masks = Map.init(allocator)
    var counts = Map.init(allocator)
    var whole = Map.init(allocator)
    const registerText = load(block.registers)
    const fieldText = load(block.fields)
    const moduleText = load(MODULE_FILES[n])
    if !check(base, registerText.length != 0 && fieldText.length != 0 && moduleText.length != 0, "the block's headers and module are there", block.module) { return }
    _ = defines(registerText, &numbers)
    _ = defines(fieldText, &masks)
    fieldsOf(&masks, fieldText, &counts, &whole)
    if !check(base + 1, readModule(moduleText), "the module reads as constants", block.module) { return }
    // Every constant the number its name gives in the headers.
    var registersSeen: usize = 0
    var fieldTotal: usize = 0
    var wrong: usize = 0
    var k: usize = 0
    while k < constantCount {
        const c = constants[k]
        k += 1
        if c.inside.length != 0 {
            var values: usize = 0
            if !check(base + 2, enumValue(enumText, c.inside, c.name, &values) == c.value, "an enum value is its enum header's", c.name) { wrong += 1 }
            continue
        }
        if !check(base + 3, headerNumber(c.name, &numbers, &masks) == c.value, "a constant is the number its name gives in the block's headers", c.name) { wrong += 1 }
        if !std.text.contains(c.name, "__") {
            registersSeen += 1
            // Every field of it, each with its mask and its shift.
            var mine: usize = 0
            var shifts: usize = 0
            var j: usize = 0
            const plain = if std.text.startsWith(c.name, "ix") { c.name[2..c.name.length] } else { c.name }
            const prefix = around("", plain, "__")
            while j < constantCount {
                if constants[j].inside.length == 0 && std.text.startsWith(constants[j].name, prefix) {
                    if std.text.endsWith(constants[j].name, "__SHIFT") { shifts += 1 } else { mine += 1 }
                }
                j += 1
            }
            const has = counts.get(plain)
            const given: usize = if has == null { 0 } else { @intCast(usize, has.?) }
            _ = check(base + 4, mine == given && shifts == given, "a register comes with every field its header gives it, each with its mask and its shift", c.name)
            fieldTotal += mine
        }
    }
    // The registers SELECTION names, and gfx_8_0's 32 of another form.
    readSelection(selection, block.module)
    var named: usize = 0
    k = 0
    while k < chosenCount {
        var found = false
        var j: usize = 0
        while j < constantCount {
            if constants[j].inside.length == 0 && same(constants[j].name, chosen[k]) { found = true }
            j += 1
        }
        _ = check(base + 5, found, "a register SELECTION names is in its module", chosen[k])
        if found { named += 1 }
        k += 1
    }
    const forced: usize = if same(block.module, "gfx_8_0") { 32 } else { 0 }
    _ = check(base + 6, registersSeen == chosenCount + forced, "the module has SELECTION's registers and no others", block.module)
    if same(block.module, "gfx_8_0") {
        for name in ELSEWHERE {
            var found = false
            var j: usize = 0
            while j < constantCount {
                if constants[j].inside.length == 0 && std.text.startsWith(constants[j].name, "ix") && same(constants[j].name[2..constants[j].name.length], name) { found = true }
                j += 1
            }
            _ = check(base + 7, found, "Linux's form of a register the database has otherwise is generated", name)
        }
        // The enums SELECTION names, each whole.
        var structs: usize = 0
        var last: []const u8 = ""
        k = 0
        while k < constantCount {
            if constants[k].inside.length != 0 && !same(constants[k].inside, last) {
                last = constants[k].inside
                structs += 1
                var values: usize = 0
                _ = enumValue(enumText, last, "", &values)
                var mine: usize = 0
                var j: usize = 0
                while j < constantCount {
                    if same(constants[j].inside, last) { mine += 1 }
                    j += 1
                }
                _ = check(base + 8, mine == values, "an enum comes with every value", last)
            }
            k += 1
        }
        _ = check(base + 9, structs == chosenEnums && structs > 0, "the enums SELECTION names", block.module)
    }
    // The display's runs made again: every register number from 0xC0 on,
    // the aliases left out, a gap of more than 16 dwords ending a run.
    if same(block.module, "dce_11_2") {
        var seen: [65536]bool = undefined
        var s: usize = 0
        while s < 65536 {
            seen[s] = false
            s += 1
        }
        var beyond = false
        var at: usize = 0
        while at < registerText.length {
            var stop = at
            while stop < registerText.length && registerText[stop] != 10 { stop += 1 }
            const line = registerText[at..stop]
            at = stop + 1
            if !std.text.startsWith(line, "#define mm") { continue }
            var e: usize = 10
            while e < line.length && isWord(line[e]) { e += 1 }
            const name = line[8..e]
            while e < line.length && (line[e] == 32 || line[e] == 9) { e += 1 }
            var end: usize = 0
            const value = numberAt(line, e, &end)
            if value == NONE || value < 192 || std.text.endsWith(name, "_ALIAS") { continue }
            if value >= 65536 {
                beyond = true
                continue
            }
            seen[@intCast(usize, value)] = true
        }
        var runs: [512]u64 = undefined
        var runCount: usize = 0
        var first: u64 = NONE
        var lastSeen: u64 = 0
        var v: usize = 0
        while v < 65536 {
            if seen[v] {
                if first == NONE {
                    first = @intCast(u64, v)
                } else if @intCast(u64, v) - lastSeen > 16 {
                    runs[runCount] = first
                    runs[runCount + 1] = lastSeen
                    runCount += 2
                    first = @intCast(u64, v)
                }
                lastSeen = @intCast(u64, v)
            }
            v += 1
        }
        runs[runCount] = first
        runs[runCount + 1] = lastSeen
        runCount += 2
        var alike = !beyond && runCount == tableCount && runCount == dce_11_2.MMIO_RUNS.length
        var r: usize = 0
        while alike && r < runCount {
            alike = runs[r] == table[r] && runs[r] == @intCast(u64, dce_11_2.MMIO_RUNS[r])
            r += 1
        }
        _ = check(base + 10, alike, "MMIO_RUNS are dce_11_2_d.h's runs", "")
    }
    // Some as compiled, against the headers' numbers.
    var ok = true
    if n == 0 {
        ok = bif_5_0.MM_INDEX == numbers.get("mmMM_INDEX").? && bif_5_0.MM_INDEX__MM_APER == masks.get("MM_INDEX__MM_APER_MASK").? && bif_5_0.MM_INDEX__MM_APER__SHIFT == masks.get("MM_INDEX__MM_APER__SHIFT").? && bif_5_0.CONFIG_MEMSIZE == numbers.get("mmCONFIG_MEMSIZE").?
    } else if n == 1 {
        ok = dce_11_2.DMIF_ADDR_CALC == numbers.get("mmDMIF_ADDR_CALC").? && dce_11_2.DMIF_STATUS__DMIF_UNDERFLOW == masks.get("DMIF_STATUS__DMIF_UNDERFLOW_MASK").? && dce_11_2.VGA_RENDER_CONTROL__VGA_VSTATUS_CNTL__SHIFT == masks.get("VGA_RENDER_CONTROL__VGA_VSTATUS_CNTL__SHIFT").?
    } else if n == 2 {
        var values: usize = 0
        ok = gfx_8_0.CP_ME_CNTL == numbers.get("mmCP_ME_CNTL").? && gfx_8_0.CP_ME_CNTL__ME_HALT == masks.get("CP_ME_CNTL__ME_HALT_MASK").? && gfx_8_0.ixSQ_WAVE_MODE == numbers.get("ixSQ_WAVE_MODE").? && gfx_8_0.SQ_WAVE_MODE__FP_ROUND == masks.get("SQ_WAVE_MODE__FP_ROUND_MASK").? && gfx_8_0.RLC_CNTL == numbers.get("mmRLC_CNTL").? && gfx_8_0.MTYPE.MTYPE_UC == enumValue(enumText, "MTYPE", "MTYPE_UC", &values) && gfx_8_0.SH_MEM_ALIGNMENT_MODE.SH_MEM_ALIGNMENT_MODE_UNALIGNED == enumValue(enumText, "SH_MEM_ALIGNMENT_MODE", "SH_MEM_ALIGNMENT_MODE_UNALIGNED", &values)
    } else if n == 3 {
        ok = gmc_8_1.VM_L2_CNTL == numbers.get("mmVM_L2_CNTL").? && gmc_8_1.VM_L2_CNTL__EFFECTIVE_L2_QUEUE_SIZE == masks.get("VM_L2_CNTL__EFFECTIVE_L2_QUEUE_SIZE_MASK").? && gmc_8_1.VM_L2_CNTL__EFFECTIVE_L2_QUEUE_SIZE__SHIFT == masks.get("VM_L2_CNTL__EFFECTIVE_L2_QUEUE_SIZE__SHIFT").? && gmc_8_1.ixMC_IO_DEBUG_UP_159 == numbers.get("ixMC_IO_DEBUG_UP_159").? && gmc_8_1.ATC_MISC_CG == numbers.get("mmATC_MISC_CG").?
    } else if n == 4 {
        ok = oss_3_0.IH_RB_CNTL == numbers.get("mmIH_RB_CNTL").? && oss_3_0.IH_RB_CNTL__RB_SIZE == masks.get("IH_RB_CNTL__RB_SIZE_MASK").? && oss_3_0.SDMA1_GFX_RB_CNTL == numbers.get("mmSDMA1_GFX_RB_CNTL").? && oss_3_0.SRBM_STATUS__VMC_BUSY == masks.get("SRBM_STATUS__VMC_BUSY_MASK").?
    } else {
        ok = smu_7_1_3.ixSMC_PC_C == numbers.get("ixSMC_PC_C").? && smu_7_1_3.SMC_IND_INDEX_11 == numbers.get("mmSMC_IND_INDEX_11").? && smu_7_1_3.CG_THERMAL_INT__DIG_THERM_INTH == masks.get("CG_THERMAL_INT__DIG_THERM_INTH_MASK").? && smu_7_1_3.SMC_SYSCON_CLOCK_CNTL_0__ck_disable == masks.get("SMC_SYSCON_CLOCK_CNTL_0__ck_disable_MASK").?
    }
    _ = check(base + 11, ok, "the module's constants as compiled are the headers' numbers", block.module)
    // The inputs pinned.
    const head = headOf(moduleText)
    pinned(base + 12, block.registers, sources, head)
    pinned(base + 14, block.fields, sources, head)
    if same(block.module, "gfx_8_0") { pinned(base + 16, ENUM_HEADER, sources, head) }
    _ = check(base + 18, wrong == 0 && fieldTotal > 0 && registersSeen > 0, "the block held", block.module)
}

// ---- The database's modules, and the database against Linux's headers.
fn holdDatabase(sources: []const u8, enumText: []const u8) -> void {
    const allocator = std.heap.allocator()
    var firsts = Map.init(allocator)
    var ends = Map.init(allocator)
    const text = load(DATABASE)
    const mine = load(DATABASE_MINE)
    if !check(240, text.length != 0 && mine.length != 0, "the database's files are there", "") { return }
    if !check(241, readDatabase(text, false, &firsts, &ends), "gfx8.json reads", "") { return }
    if !check(242, readDatabase(mine, true, &firsts, &ends), "registers-manually-defined.json reads", "") { return }
    _ = check(243, registerCount == 1496 && enumCount == 96, "1496 registers (1491 and Mesa's own 5) and 96 enums", "")
    // gfx8.mlx: every register, field and enum it takes, nothing else.
    const moduleText = load("projects/brix/registers/gfx8.mlx")
    if !check(244, readModule(moduleText), "gfx8.mlx reads as constants", "") { return }
    var byName = Map.init(allocator)
    var k: usize = 0
    while k < constantCount {
        _ = byName.put(constants[k].name, @intCast(u64, k))
        k += 1
    }
    var expected: usize = 0
    var wrong: usize = 0
    k = 0
    while k < registerCount {
        const r = registers[k]
        k += 1
        expected += 1
        const at = byName.get(r.name)
        if !check(245, at != null && constants[@intCast(usize, at.?)].value == r.at, "a register is at the database's byte offset", r.name) { wrong += 1 }
        if r.kind.length == 0 { continue }
        const first = firsts.get(r.kind)
        if !check(246, first != null, "a register's type is the database's", r.name) { continue }
        var f = @intCast(usize, first.?)
        const end = @intCast(usize, ends.get(r.kind).?)
        while f < end {
            const field = fields[f]
            f += 1
            expected += 2
            const m = byName.get(around(r.name, "__", field.name))
            if !check(247, m != null && constants[@intCast(usize, m.?)].value == mask(field.low, field.high) && same(constants[@intCast(usize, m.?)].note, field.takes), "a field is the database's bits and takes its enum", around(r.name, "__", field.name)) { wrong += 1 }
            const s = byName.get(around4(r.name, "__", field.name, "__SHIFT"))
            if !check(248, s != null && constants[@intCast(usize, s.?)].value == field.low, "a field's shift is its lowest bit", r.name) { wrong += 1 }
        }
    }
    _ = check(249, expected == constantCount, "gfx8.mlx holds the database's registers and fields and nothing else", "")
    // Compiled, against the database's numbers.
    const blend = byName.get("CB_BLEND0_CONTROL")
    var ok = blend != null && gfx8.CB_BLEND0_CONTROL == constants[@intCast(usize, blend.?)].value && gfx8.CB_BLEND0_CONTROL == 0x28780 && gfx8.SQ_WAVE_MODE == 68 && gfx8.SDMA0_STATUS_REG == 53300 && gfx8.CB_BLEND0_CONTROL__COLOR_SRCBLEND == 31
    pinned(250, DATABASE, sources, headOf(moduleText))
    pinned(252, DATABASE_MINE, sources, headOf(moduleText))
    const databaseHead = headOf(moduleText)
    // gfx8_enums.mlx: every enum with every value.
    const enumModule = load("projects/brix/registers/gfx8_enums.mlx")
    if !check(254, readModule(enumModule), "gfx8_enums.mlx reads as constants", "") { return }
    var values = Map.init(allocator)
    k = 0
    while k < constantCount {
        _ = values.put(joined(constants[k].inside, constants[k].name), constants[k].value)
        k += 1
    }
    _ = check(255, constantCount == entryCount, "gfx8_enums.mlx holds the database's enum values and nothing else", "")
    k = 0
    while k < entryCount {
        const got = values.get(around(entries[k].of, ".", entries[k].name))
        if !check(256, got != null && got.? == entries[k].value, "an enum value is the database's", entries[k].name) { wrong += 1 }
        k += 1
    }
    pinned(257, DATABASE, sources, headOf(enumModule))
    ok = ok && gfx8_enums.ArrayMode.ARRAY_2D_TILED_THIN1 == values.get("ArrayMode.ARRAY_2D_TILED_THIN1").? && gfx8_enums.ROP3.X_0X05 == values.get("ROP3.X_0X05").?
    _ = check(259, ok, "the database's modules as compiled are its numbers", "")

    // The database against Linux's gca headers (and oss for Mesa's own).
    var gcaRegisters = Map.init(allocator)
    var gcaMasks = Map.init(allocator)
    var gcaCounts = Map.init(allocator)
    var gcaWhole = Map.init(allocator)
    var ossRegisters = Map.init(allocator)
    var ossMasks = Map.init(allocator)
    var ossCounts = Map.init(allocator)
    var ossWhole = Map.init(allocator)
    const gcaFields = load(BLOCKS[2].fields)
    const ossFields = load(BLOCKS[4].fields)
    _ = defines(load(BLOCKS[2].registers), &gcaRegisters)
    _ = defines(gcaFields, &gcaMasks)
    fieldsOf(&gcaMasks, gcaFields, &gcaCounts, &gcaWhole)
    _ = defines(load(BLOCKS[4].registers), &ossRegisters)
    _ = defines(ossFields, &ossMasks)
    fieldsOf(&ossMasks, ossFields, &ossCounts, &ossWhole)
    var sameRegisters: usize = 0
    var otherNumbers: usize = 0
    var elsewhere: usize = 0
    var nowhere: usize = 0
    var sameFields: usize = 0
    var otherBits: usize = 0
    var onlyDatabase: usize = 0
    var wholeWord: usize = 0
    var onlyLinux: usize = 0
    k = 0
    while k < registerCount {
        const r = registers[k]
        k += 1
        var masksOf: *Map = &gcaMasks
        var countsOf: *Map = &gcaCounts
        var wholeOf: *Map = &gcaWhole
        var at = gcaRegisters.get(around("mm", r.name, ""))
        if at == null {
            at = ossRegisters.get(around("mm", r.name, ""))
            masksOf = &ossMasks
            countsOf = &ossCounts
            wholeOf = &ossWhole
        }
        if at != null {
            if at.? * 4 == r.at { sameRegisters += 1 } else { otherNumbers += 1 }
        } else {
            masksOf = &gcaMasks
            countsOf = &gcaCounts
            wholeOf = &gcaWhole
            const index = gcaRegisters.get(around("ix", r.name, ""))
            if index == null {
                nowhere += 1
                continue
            }
            elsewhere += 1
            _ = check(260, listed(ELSEWHERE[0..32], r.name) && index.? * 4 == r.at, "a register the database has among the MMIO words and Linux in the SQ's index space, at four times its number", r.name)
            _ = check(261, std.text.contains(databaseHead, r.name), "gfx8.mlx's head names it", r.name)
        }
        var described: usize = 0
        if r.kind.length != 0 {
            var f = @intCast(usize, firsts.get(r.kind).?)
            const end = @intCast(usize, ends.get(r.kind).?)
            while f < end {
                const field = fields[f]
                f += 1
                described += 1
                const m = masksOf.*.get(around4(r.name, "__", field.name, "_MASK"))
                const s = masksOf.*.get(around4(r.name, "__", field.name, "__SHIFT"))
                if m == null || s == null {
                    onlyDatabase += 1
                    const pair = joined(r.name, field.name)
                    _ = check(262, listed(ONLY_DATABASE_FIELDS[0..2], pair), "a field only the database names", pair)
                    _ = check(263, std.text.contains(databaseHead, pair), "gfx8.mlx's head names it", pair)
                    described -= 1
                } else if m.? == mask(field.low, field.high) && s.? == field.low {
                    sameFields += 1
                } else {
                    otherBits += 1
                }
            }
        }
        const theirs = countsOf.*.get(r.name)
        const linuxFields: usize = if theirs == null { 0 } else { @intCast(usize, theirs.?) }
        if r.kind.length == 0 {
            const w = wholeOf.*.get(r.name)
            const wholeFields: usize = if w == null { 0 } else { @intCast(usize, w.?) }
            wholeWord += wholeFields
            onlyLinux += linuxFields - wholeFields
        } else if linuxFields > described {
            onlyLinux += linuxFields - described
        }
    }
    _ = check(264, sameRegisters == 1464 && otherNumbers == 0 && nowhere == 0, "1464 registers at the same place, none at another, none Linux lacks", "")
    _ = check(265, elsewhere == 32, "32 registers in the SQ's index space", "")
    _ = check(266, sameFields == 3441 && otherBits == 0, "3441 fields with the same bits, none at other bits", "")
    _ = check(267, onlyDatabase == 2 && onlyLinux == 0, "2 fields only the database names, none only Linux of the registers it describes", "")
    _ = check(268, wholeWord == 754, "754 registers to which only Linux gives a field, the whole word", "")
    // The enums.
    var sameValues: usize = 0
    var otherValues: usize = 0
    var onlyEnums: usize = 0
    k = 0
    while k < enumCount {
        const name = enumNames[k]
        k += 1
        var count: usize = 0
        _ = enumValue(enumText, name, "", &count)
        if count == 0 {
            onlyEnums += 1
            _ = check(269, listed(ONLY_DATABASE_ENUMS[0..11], name), "an enum only the database has", name)
            _ = check(270, std.text.contains(databaseHead, name), "gfx8.mlx's head names it", name)
            continue
        }
        var e: usize = 0
        while e < entryCount {
            if same(entries[e].of, name) {
                if enumValue(enumText, name, entries[e].name, &count) == entries[e].value { sameValues += 1 } else { otherValues += 1 }
            }
            e += 1
        }
    }
    _ = check(271, onlyEnums == 11 && sameValues == 622 && otherValues == 0, "11 enums only the database has, 622 values the same, none other", "")
    _ = check(272, wrong == 0, "the database held", "")
}

pub fn main() -> u8 {
    const sources = load(SOURCES)
    const selection = load(SELECTION)
    const enumText = load(ENUM_HEADER)
    if !check(1, sources.length != 0 && selection.length != 0 && enumText.length != 0, "SOURCES, SELECTION and gfx_8_0_enum.h are there (run from the repository's root)", "") { return 1 }
    var n: usize = 0
    while n < 6 {
        holdBlock(n, selection, sources, enumText)
        n += 1
    }
    holdDatabase(sources, enumText)
    if failed != 0 { return if failed < 256 && failed != 13 { @intCast(u8, failed) } else { 255 } }
    return 13
}
