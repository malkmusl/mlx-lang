// std.vulkan.icd, the driver side of the loader interface, checked against
// a real driver (tests/run_vulkan.sh: lavapipe, manifest path in argv[1]):
// a manifest written with icd.writeManifest reads back through the loader
// and opens the driver; the instance and physical device handles the driver
// returns start with the loader magic; negotiation follows the contract.
// Exits 13.
const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const icd = @import("std.vulkan.icd")
const json = @import("std.json")

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()

    // Negotiation and dispatchable headers.
    var version: u32 = 7
    if icd.negotiate(&version, 5) != vk.Result.success || version != 5 { return 1 }
    version = 4
    if icd.negotiate(&version, 5) != vk.Result.success || version != 4 { return 2 }
    version = 2
    if icd.negotiate(&version, 5) != vk.Result.errorIncompatibleDriver { return 3 }
    var header: icd.DispatchableHeader = undefined
    icd.initDispatchable(&header)
    if !icd.hasLoaderMagic(@intFromPtr(&header)) || header.loaderData != 30261470 { return 4 }

    // JSON escaping round-trips through the tokenizer.
    const original = std.string.fromSlice("a\"b\\c\nd")
    var escaped: [64]u8 = undefined
    var written: isize = 0
    unsafe { written = json.escapeString(original, @ptrCast([*]u8, &escaped), 64) }
    // "a\"b\\c\nd" with quotes: 12 bytes.
    if written != 12 || escaped[0] != 34 || escaped[2] != 92 || escaped[3] != 34 || escaped[8] != 92 || escaped[9] != 110 { return 5 }
    var tokenizer: json.Tokenizer = undefined
    var token: json.Token = undefined
    unsafe { json.initAt(&tokenizer, @ptrCast([*]const u8, &escaped), 12) }
    if !json.next(&tokenizer, &token) || token.kind != json.TokenKind.string { return 18 }
    var decoded: [16]u8 = undefined
    var decoded_length: isize = 0
    unsafe { decoded_length = json.decodeString(token.value, @ptrCast([*]u8, &decoded), 16) }
    if decoded_length != 7 || decoded[1] != 34 || decoded[3] != 92 || decoded[5] != 10 || decoded[6] != 100 { return 19 }
    unsafe { if json.escapeString(original, @ptrCast([*]u8, &escaped), 11) != -1 { return 20 } }

    if std.process.count(arguments) < 2 { return 6 }
    const path = std.process.argument(arguments, 1)
    var manifest_text = std.array_list.ArrayList.init(allocator, 512)
    if !icd.writeManifest(&manifest_text, std.string.fromSlice("libvulkan_lvp.so"), vk.makeApiVersion(0, 1, 3, 0), false) { return 7 }
    const file = std.fs.open(path.pointer, 577, 420)
    if !std.fs.isValid(file) { return 8 }
    if !std.fs.writeAllBytes(file, manifest_text.items, manifest_text.length) { return 9 }
    const closed = std.fs.close(file)

    var manifest: loader.Manifest = undefined
    if loader.readManifestFile(allocator, path.pointer, &manifest) != loader.Status.ok { return 10 }
    if manifest.apiVersion != vk.API_VERSION_1_3 || manifest.portability { return 11 }
    var driver: loader.Driver = undefined
    if loader.openDriver(&driver, &manifest, allocator) != loader.Status.ok { return 12 }
    if driver.interfaceVersion != icd.INTERFACE_VERSION { return 14 }

    var info = vk.InstanceCreateInfo.init()
    var instance: vk.Instance = 0
    if vk.createInstance(driver.global, &info, null, &instance) != vk.Result.success { return 15 }
    if !icd.hasLoaderMagic(instance) { return 16 }
    var commands: vk.InstanceCommands = undefined
    vk.loadInstanceCommands(&commands, instance, driver.getInstanceProcAddr)
    var count: u32 = 1
    var physical: vk.PhysicalDevice = 0
    const listed = vk.enumeratePhysicalDevices(&commands, instance, &count, &physical)
    if count != 1 || !icd.hasLoaderMagic(physical) { return 17 }
    vk.destroyInstance(&commands, instance, null)
    loader.closeDriver(&driver)
    return 13
}
