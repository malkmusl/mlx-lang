// Values that do not fit their place: each is said at the value before the
// statement's own error. An integer written out names its range where the
// type cannot hold it (older compilers took `var small: u8 = 300`, kept
// the low bits and trapped on the next overflow check), and a value of
// another type names what was expected and what was found, at a
// declaration, an assignment, an argument, a return, a field or element of
// a literal, and between the operands of an operator (older compilers said
// only "invalid local declaration" or "expression type could not be
// resolved"). An offset on a single-item pointer and an array literal of
// another length than its type say so; both, and any initializer that does
// not type, used to pass when the declaration wrote its type out and ended
// at the backend as "unresolved backend symbol" or as stray bytes.
const Point = struct { x: i16, y: i16 }

fn take(count: u64) -> u64 { return count }

fn level() -> u8 { return 256 }

fn first(points: []const Point) -> ?*const Point { return points.length }

pub fn main() -> u8 {
    var index: usize = 2
    var small: u8 = 300
    const below: u32 = -1
    small = index
    const passed = take(index)
    const point = Point.{ .x = 40000, .y = 0 }
    const row = [3]u8{ 1, 2, 777 }
    const flag: bool = 1
    const sum = small + index
    const digest: [4]u8 = [4]u8{ 0, 0, 0, 0, 0 }
    const bytes: [*]const u8 = &index + 4
    const later: u8 = undeclared
    return small
}
