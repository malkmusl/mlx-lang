// A bare `return` in a function returning `!void` (or `E!void`) is a
// success, as falling off its end is. Older compilers left whatever the
// last call put in the return register, which the caller's `try` took for
// an error. Exits 13 when every check holds, else the number of the first
// check that failed.
const Failure = error { Bad }

var touched: u32 = 0
var reached: u32 = 0

fn early(stop: bool) -> !void {
    if stop { return }
    touched = 1
}

fn named(stop: bool) -> Failure!void {
    if stop { return }
    touched = 2
}

fn length(text: []const u8) -> usize { return text.length }

// A call right before the bare return leaves a non-zero value in the
// register a `!void` caller reads the error from.
fn afterCall(text: []const u8) -> !void {
    if length(text) > 0 { return }
    touched = 3
}

fn run() -> !void {
    try early(true)
    try named(true)
    try afterCall("not empty")
    try early(false)
    reached = 1
}

pub fn main() -> u8 {
    @discardError(run())
    if reached != 1 { return 1 }
    if touched != 1 { return 2 }
    return 13
}
