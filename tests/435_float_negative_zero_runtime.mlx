// A float's negation flips its sign bit (IEEE 754): -(0.0) is -0.0 (the
// sign bit set, equal to 0.0 all the same), -(-0.0) is +0.0, and the
// other values negate as before, in f32 and f64, through variables and
// through a division that comes out zero (as Mat4::Ortho's -(r + l) /
// (r - l) does in ANGLE). Exits 13 when every check holds, else the number
// of the first check that failed.
var seed: u32 = 0 // (per run; the values below come from it at run time)

pub fn main() -> u8 {
    const zero32: f32 = @floatFromInt(f32, seed)
    const zero64: f64 = @floatFromInt(f64, seed)
    const three: f32 = @floatFromInt(f32, seed + 3)
    const quarter: f64 = @floatFromInt(f64, seed + 1) / 4.0
    const negative32: f32 = -zero32
    if @bitCast(u32, negative32) != 0x80000000 { return 1 }
    if negative32 != 0.0 { return 2 }
    const back32: f32 = -negative32
    if @bitCast(u32, back32) != 0 { return 3 }
    const negative64: f64 = -zero64
    if @bitCast(u64, negative64) != 0x8000000000000000 { return 4 }
    if negative64 != 0.0 { return 5 }
    const divided: f32 = -(zero32 / 4.0)
    if @bitCast(u32, divided) != 0x80000000 { return 6 }
    const minusThree: f32 = -three
    if minusThree != -3.0 { return 7 }
    if -minusThree != 3.0 { return 8 }
    const minusQuarter: f64 = -quarter
    if minusQuarter != -0.25 { return 9 }
    if @bitCast(u64, -minusQuarter) != @bitCast(u64, quarter) { return 10 }
    return 13
}
