// region_loads (the shared LIR): a load from a place of the frame that
// nothing else can reach is the value the writes before it left there,
// followed through a copy of the place (as a struct passed by value is
// copied), made of two narrower constant stores when the load is wider
// (two int fields read as the word a call passes; a struct's fields
// stored after it was zeroed, each byte its last write's), and bitcast when the
// value's type is not the load's (a double stored, a word loaded). The
// places then read by nothing lose their writes.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const lir = @import("../compiler/selfhost/ir/lir.mlx")
const region_loads = @import("../compiler/selfhost/ir/region_loads.mlx")

const WORD: usize = 5
const DOUBLE: usize = 6

fn place(depth: usize, bytes: usize) -> lir.Inst {
    var inst = lir.initInst(lir.Opcode.frame_local, WORD)
    inst.arg0 = depth
    inst.arg1 = bytes
    return inst
}

fn at(base: usize, offset: usize) -> lir.Inst {
    var inst = lir.initInst(lir.Opcode.gep, WORD)
    inst.arg0 = base
    inst.arg1 = offset
    inst.arg2 = 1
    return inst
}

fn load(address: usize, width: usize, type_id: usize) -> lir.Inst {
    var inst = lir.initInst(lir.Opcode.load, type_id)
    inst.arg0 = address
    inst.arg1 = width
    inst.arg2 = 0
    return inst
}

fn store(address: usize, value: usize, width: usize) -> lir.Inst {
    var inst = lir.initInst(lir.Opcode.store, lir.NONE)
    inst.arg0 = address
    inst.arg1 = value
    inst.arg2 = width
    return inst
}

fn copy(destination: usize, source: usize, bytes: usize) -> lir.Inst {
    var inst = lir.initInst(lir.Opcode.mem_copy, lir.NONE)
    inst.arg0 = destination
    inst.arg1 = source
    inst.arg2 = bytes
    return inst
}

pub fn main() -> u8 {
    const allocator: page_allocator.Allocator = page_allocator.init()
    var ir = lir.init(allocator)
    var name: [*]const u8 = undefined
    unsafe { name = @ptrCast([*]const u8, "configured") }
    const symbol = lir.addSymbol(&ir, name, 10)
    _ = lir.addInst(&ir, lir.labelInst(lir.NONE, symbol))
    // The configuration: a word 7 at 0, a double's bits at 8.
    const config = lir.addInst(&ir, place(64, 16))
    const seven = lir.addInst(&ir, lir.constI(WORD, 7))
    _ = lir.addInst(&ir, store(config, seven, 8))
    const bits = lir.addInst(&ir, lir.constI(DOUBLE, 4609434218613702656))
    const eight = lir.addInst(&ir, lir.constI(WORD, 8))
    const second = lir.addInst(&ir, at(config, eight))
    _ = lir.addInst(&ir, store(second, bits, 8))
    // Passed by value: copied whole.
    const argument = lir.addInst(&ir, place(128, 16))
    _ = lir.addInst(&ir, copy(argument, config, 16))
    const kind = lir.addInst(&ir, load(argument, 8, WORD))
    const second_copied = lir.addInst(&ir, at(argument, eight))
    const handicap = lir.addInst(&ir, load(second_copied, 8, WORD))
    // Two ints, read as one word.
    const pair = lir.addInst(&ir, place(192, 8))
    const one = lir.addInst(&ir, lir.constI(WORD, 1))
    _ = lir.addInst(&ir, store(pair, one, 4))
    const four = lir.addInst(&ir, lir.constI(WORD, 4))
    const high = lir.addInst(&ir, at(pair, four))
    const two = lir.addInst(&ir, lir.constI(WORD, 2))
    _ = lir.addInst(&ir, store(high, two, 4))
    const both = lir.addInst(&ir, load(pair, 8, WORD))
    // A struct { char a; short b; } zeroed whole, then its fields stored:
    // each byte is its own last write's (the zero only in the padding).
    const small = lir.addInst(&ir, place(256, 8))
    const zero = lir.addInst(&ir, lir.constI(WORD, 0))
    _ = lir.addInst(&ir, store(small, zero, 4))
    const letter = lir.addInst(&ir, lir.constI(WORD, 122))
    _ = lir.addInst(&ir, store(small, letter, 1))
    const two_bytes = lir.addInst(&ir, lir.constI(WORD, 2))
    const field = lir.addInst(&ir, at(small, two_bytes))
    const three_hundred = lir.addInst(&ir, lir.constI(WORD, 300))
    _ = lir.addInst(&ir, store(field, three_hundred, 2))
    const returned = lir.addInst(&ir, load(small, 4, WORD))
    const sum = lir.addInst(&ir, lir.binary(lir.Opcode.add, WORD, kind, handicap))
    const partial = lir.addInst(&ir, lir.binary(lir.Opcode.add, WORD, sum, both))
    const total = lir.addInst(&ir, lir.binary(lir.Opcode.add, WORD, partial, returned))
    _ = lir.addInst(&ir, lir.retInst(WORD, total))

    const result = region_loads.run(&ir, allocator)
    if result.loadsFolded != 4 { return 1 }
    const folded_kind = lir.getInst(&ir, kind)
    if folded_kind.opcode != lir.Opcode.copy || folded_kind.arg0 != seven { return 2 }
    // (The double's bits keep the load's class: bitcast, not copied.)
    const folded_handicap = lir.getInst(&ir, handicap)
    if folded_handicap.opcode != lir.Opcode.bitcast || folded_handicap.arg0 != bits { return 3 }
    const folded_both = lir.getInst(&ir, both)
    if folded_both.opcode != lir.Opcode.const_i || folded_both.arg0 != 8589934593 { return 4 }
    const folded_small = lir.getInst(&ir, returned)
    if folded_small.opcode != lir.Opcode.const_i || folded_small.arg0 != 300 * 65536 + 122 { return 7 }
    // Nothing reads the four places any more: their writes are gone.
    if result.regionsDropped != 4 { return 5 }
    var index: usize = 0
    while index < lir.instCount(&ir) {
        const inst = lir.getInst(&ir, index)
        if inst.opcode == lir.Opcode.store || inst.opcode == lir.Opcode.mem_copy { return 6 }
        index += 1
    }
    lir.deinit(&ir)
    return 13
}
