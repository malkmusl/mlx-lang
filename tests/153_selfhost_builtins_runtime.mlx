const lexer = @import("../compiler/selfhost/lexer.zin")
const parser_module = @import("../compiler/selfhost/parser.zin")
const builtins = @import("../compiler/selfhost/builtins.zin")
const types = @import("../compiler/selfhost/types.zin")
const symbols = @import("../compiler/selfhost/symbols.zin")
const sema = @import("../compiler/selfhost/sema.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")

fn registryWorks() -> bool {
    const source = "Vector alignCast alignOf atomicLoad atomicRmw atomicStore bitCast bitSizeOf cmpxchgStrong cmpxchgWeak compileError decl discardError enumFromInt fence field fieldCount fieldType floatCast floatFromInt hasDecl hasField import intCast intFromEnum intFromFloat intFromPtr isArray isCopyable isEnum isErrorUnion isFloat isInteger isOptional isPointer isSlice isStruct isUnion languageVersion move nocopy offsetOf ptrCast ptrFromInt reduce select setEvalBranchQuota shuffle sizeOf splat tagOf typeInfo typeOf"
    const allocator = page_allocator.init()
    const tokens = lexer.scanAll(allocator, source)
    var index: usize = 0
    while index < 53 {
        if @intCast(usize, @intFromEnum(builtins.lookup(source, tokens, index))) != index + 1 { return false }
        index += 1
    }
    if !builtins.acceptsArity(builtins.Kind.typeOf, 1) || builtins.acceptsArity(builtins.Kind.typeOf, 2) { return false }
    if !builtins.acceptsArity(builtins.Kind.ptrCast, 2) || builtins.acceptsArity(builtins.Kind.ptrCast, 1) { return false }
    const unknown_tokens = lexer.scanAll(allocator, "unknown")
    if builtins.lookup("unknown", unknown_tokens, 0) != builtins.Kind.invalid { return false }
    lexer.deinit(unknown_tokens)
    lexer.deinit(tokens)
    return true
}

pub fn main() -> u8 {
    if !registryWorks() { return 1 }
    const source = "const Bytes = @Vector(4, u8)\nfn inspect(pointer: *u8) -> usize {\nconst Pointer = @typeOf(pointer)\nconst size = @sizeOf(u8)\nconst predicate = @isPointer(*u8)\nconst casted = @ptrCast(*u8, pointer)\nreturn @intFromPtr(casted)\n}\n"
    const allocator = page_allocator.init()
    const tokens = lexer.scanAll(allocator, source)
    var nodes = parser_module.initStore(allocator, tokens.length * 2)
    var parser = parser_module.init(source, tokens, &nodes)
    const root = parser_module.parse(&parser)
    if parser.errorCount != 0 { return 2 }
    var type_store = types.init(allocator)
    var symbol_store = symbols.initStore(allocator, 24)
    var root_scope = symbols.initRootScope(allocator, 8)
    if symbols.collectRoot(source, tokens, &nodes, root, &symbol_store, &root_scope) != 0 { return 3 }
    if sema.analyzeDeclarations(source, tokens, &nodes, root, &type_store, &symbol_store, &root_scope) != 0 { return 4 }
    const vector_type = types.get(&type_store, symbols.symbolAt(&symbol_store, 0).*.valueTypeId)
    if vector_type.*.kind != types.Kind.vector || vector_type.*.bits != 4 { return 5 }
    if sema.analyzeFunctionBodies(source, tokens, &nodes, root, &type_store, &symbol_store, &root_scope) != 0 { return 6 }
    symbols.deinitScope(&root_scope)
    symbols.deinitStore(&symbol_store)
    types.deinit(&type_store)
    parser_module.deinitStore(&nodes)
    lexer.deinit(tokens)
    return 13
}
