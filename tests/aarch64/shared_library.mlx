// Shared-library fixture for tools/check_aarch64_shared_library.py, built
// with --target=aarch64-android: exported functions (called by the checker
// through the emulator) and foreign C functions (bound by the checker to
// stubs, which deliberately leave garbage above narrow results).
extern("c") fn getpid() -> i32
extern("c") fn write(fd: i32, buffer: [*]const u8, length: usize) -> isize
extern("c") fn negative_one() -> i32
extern("c") fn small_byte() -> u8

fn helper(x: usize) -> usize { return x * 2 }

export fn mlx_add(a: usize, b: usize) -> usize { return a + b + helper(a) }

export fn mlx_hello() -> isize {
    unsafe { return write(1, @ptrCast([*]const u8, "hello from mlx\n"), 15) }
}

export fn mlx_pid() -> i32 { return getpid() }

export fn mlx_sum_to(n: usize) -> usize {
    var total: usize = 0
    var i: usize = 1
    while i <= n {
        total += i
        i += 1
    }
    return total
}

export fn mlx_foreign_negative() -> i32 {
    if negative_one() < 0 { return 1 }
    return 0
}

export fn mlx_param_negative(x: i32) -> i32 {
    if x < 0 { return 1 }
    return 0
}

export fn mlx_byte_plus_one() -> usize {
    return @intCast(usize, small_byte()) + 1
}

// Many arguments: the ninth and tenth arrive on the stack.
export fn mlx_ten(a: usize, b: usize, c: usize, d: usize, e: usize, f: usize, g: usize, h: usize, i: usize, j: usize) -> usize {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8 + i * 9 + j * 10
}

// Aggregate allocation from exported code initializes the runtime arena.
export fn mlx_arena() -> usize {
    var values: [64]usize = undefined
    var index: usize = 0
    while index < 64 {
        values[index] = index * index
        index += 1
    }
    return values[63] + values[1]
}
