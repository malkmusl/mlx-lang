const lexer = @import("../compiler/selfhost/lexer.mlx")
const parser_module = @import("../compiler/selfhost/parser.mlx")
const types = @import("../compiler/selfhost/types.mlx")
const symbols = @import("../compiler/selfhost/symbols.mlx")
const sema = @import("../compiler/selfhost/sema.mlx")
const comptime_module = @import("../compiler/selfhost/comptime.mlx")
const page_allocator = @import("../std/bootstrap/page_allocator.mlx")

pub fn main() -> u8 {
    const allocator: page_allocator.Allocator = page_allocator.init()

    // A comptime-evaluable expression that exhausts a deliberately tiny
    // branch quota must be distinguished from a generically unsupported
    // expression so callers can report MLX-E5002 instead of MLX-E5001.
    const quota_source = "const value = 1 + 2 + 3\n"
    const quota_tokens = lexer.scanAll(allocator, quota_source)
    var quota_nodes = parser_module.initStore(allocator, quota_tokens.length * 2)
    var quota_parser = parser_module.init(quota_source, quota_tokens, &quota_nodes)
    const quota_root = parser_module.parse(&quota_parser)
    if quota_parser.errorCount != 0 { return 1 }
    const quota_declaration = parser_module.nodeAt(&quota_nodes, quota_root).lhs
    const quota_initializer = parser_module.nodeAt(&quota_nodes, quota_declaration).rhs
    var quota_types = types.init(allocator)
    var quota_symbols = symbols.initStore(allocator, 16)
    var quota_scope = symbols.initRootScope(allocator, 8)
    const exhausted = comptime_module.evaluate(quota_source, quota_tokens, &quota_nodes, &quota_types, &quota_symbols, &quota_scope, quota_initializer, 1)
    if comptime_module.isValid(exhausted) { return 2 }
    if exhausted.reason != comptime_module.Reason.quota_exceeded { return 3 }
    symbols.deinitScope(&quota_scope)
    types.deinit(&quota_types)
    symbols.deinitStore(&quota_symbols)
    parser_module.deinitStore(&quota_nodes)
    lexer.deinit(quota_tokens)

    // A generically unsupported comptime expression keeps the default
    // "unsupported" reason, not "quota_exceeded".
    const bad_source = "const value = \"not a number\"\n"
    const bad_tokens = lexer.scanAll(allocator, bad_source)
    var bad_nodes = parser_module.initStore(allocator, bad_tokens.length * 2)
    var bad_parser = parser_module.init(bad_source, bad_tokens, &bad_nodes)
    const bad_root = parser_module.parse(&bad_parser)
    if bad_parser.errorCount != 0 { return 4 }
    const bad_declaration = parser_module.nodeAt(&bad_nodes, bad_root).lhs
    const bad_initializer = parser_module.nodeAt(&bad_nodes, bad_declaration).rhs
    var bad_types = types.init(allocator)
    var bad_symbols = symbols.initStore(allocator, 16)
    var bad_scope = symbols.initRootScope(allocator, 8)
    const unsupported = comptime_module.evaluate(bad_source, bad_tokens, &bad_nodes, &bad_types, &bad_symbols, &bad_scope, bad_initializer, 1000000)
    if comptime_module.isValid(unsupported) { return 5 }
    if unsupported.reason != comptime_module.Reason.unsupported { return 6 }
    symbols.deinitScope(&bad_scope)
    types.deinit(&bad_types)
    symbols.deinitStore(&bad_symbols)
    parser_module.deinitStore(&bad_nodes)
    lexer.deinit(bad_tokens)

    // An enum whose explicit discriminant cannot be evaluated at compile
    // time must now be rejected instead of silently discarding the type.
    const enum_source = "const Bad = enum(u16) {\none = 1 / 0\ntwo\n}\n"
    const enum_tokens = lexer.scanAll(allocator, enum_source)
    var enum_nodes = parser_module.initStore(allocator, enum_tokens.length * 2)
    var enum_parser = parser_module.init(enum_source, enum_tokens, &enum_nodes)
    const enum_root = parser_module.parse(&enum_parser)
    if enum_parser.errorCount != 0 { return 7 }
    var enum_types = types.init(allocator)
    var enum_symbols = symbols.initStore(allocator, 16)
    var enum_scope = symbols.initRootScope(allocator, 8)
    if symbols.collectRoot(enum_source, enum_tokens, &enum_nodes, enum_root, &enum_symbols, &enum_scope) != 0 { return 8 }
    if sema.analyzeDeclarations(enum_source, "", enum_tokens, &enum_nodes, enum_root, &enum_types, &enum_symbols, &enum_scope) == 0 { return 9 }
    symbols.deinitScope(&enum_scope)
    types.deinit(&enum_types)
    symbols.deinitStore(&enum_symbols)
    parser_module.deinitStore(&enum_nodes)
    lexer.deinit(enum_tokens)

    return 13
}
