const bootstrap = @import("../std/bootstrap/root.mlx")

fn fakeAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    unsafe {
        return @ptrFromInt([*]u8, @intFromPtr(context) + length + alignment)
    }
}

fn fakeResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> bool {
    return true
}

fn fakeRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> ?[*]u8 {
    return memory
}

fn fakeFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {}

const VTABLE: bootstrap.allocator.VTable = bootstrap.allocator.VTable.{
    .alloc = fakeAlloc,
    .resize = fakeResize,
    .remap = fakeRemap,
    .free = fakeFree,
}

pub fn main() -> u8 {
    unsafe {
        const allocator = bootstrap.allocator.Allocator.{
            .ptr = @ptrFromInt(*anyopaque, 4),
            .vtable = &VTABLE,
        }
        const memory = allocator.alloc(8, 1).?
        return @intCast(u8, @intFromPtr(memory))
    }
}
