// std.xml.sax: the SAX2 events and errors of libxml2's push parser
// (2.9.14), as the system's libxml2 gave them for the same documents:
// namespaces, attributes (defaulted from the DTD, normalized),
// entities expanded (XML_PARSE_NOENT) and reported, character
// references, comments, processing instructions and CDATA; the same
// events whether the document comes whole or a byte at a time; UTF-16
// and Latin-1 documents; an error's code, message and position; content
// parsed apart (xmlParseContent); an entity loop reported, not
// recursed into without end.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const std = @import("std")
const sax = @import("std.xml.sax")
const text = @import("std.xml.text")

// The events, one per line, written by the handler's callbacks.
var log: text.Buffer = undefined

fn add(s: []const u8) -> void { text.bufferAddText(&log, s) }
fn addString(s: usize) -> void {
    if s == 0 {
        add("-")
    } else {
        text.bufferAddString(&log, s)
    }
}
fn addCount(n: i64) -> void { text.addDecimalTo(&log, n) }

fn onStartDocument(u: usize) -> void { add("startDocument\n") }
fn onEndDocument(u: usize) -> void { add("endDocument\n") }

fn onStart(u: usize, local: usize, prefix: usize, uri: usize, nbNs: i64, ns: usize, nbAtts: i64, nbDef: i64, atts: usize) -> void {
    add("start ")
    addString(local)
    add(" ")
    addString(prefix)
    add(" ")
    addString(uri)
    var i: i64 = 0
    while i < nbNs {
        add(" xmlns:")
        addString(text.getWord(ns + @intCast(usize, i) * 16))
        add("=")
        addString(text.getWord(ns + @intCast(usize, i) * 16 + 8))
        i += 1
    }
    add(" defaulted ")
    addCount(nbDef)
    i = 0
    while i < nbAtts {
        const a = atts + @intCast(usize, i) * 40
        add(" ")
        addString(text.getWord(a + 8))
        add(":")
        addString(text.getWord(a))
        add("=[")
        text.bufferAdd(&log, text.getWord(a + 24), text.getWord(a + 32) - text.getWord(a + 24))
        add("]")
        i += 1
    }
    add("\n")
}

fn onEnd(u: usize, local: usize, prefix: usize, uri: usize) -> void {
    add("end ")
    addString(local)
    add("\n")
}

fn onChars(u: usize, s: usize, n: i64) -> void {
    add("chars [")
    text.bufferAdd(&log, s, @intCast(usize, n))
    add("]\n")
}

fn onCdata(u: usize, s: usize, n: i64) -> void {
    add("cdata [")
    text.bufferAdd(&log, s, @intCast(usize, n))
    add("]\n")
}

fn onComment(u: usize, s: usize) -> void {
    add("comment [")
    addString(s)
    add("]\n")
}

fn onPI(u: usize, target: usize, data: usize) -> void {
    add("pi ")
    addString(target)
    add(" [")
    addString(data)
    add("]\n")
}

fn onReference(u: usize, name: usize) -> void {
    add("reference ")
    addString(name)
    add("\n")
}

fn onEntityDecl(u: usize, name: usize, etype: i64, publicId: usize, systemId: usize, content: usize) -> void {
    add("entityDecl ")
    addString(name)
    add(" ")
    addCount(etype)
    add(" [")
    addString(content)
    add("]\n")
}

fn onError(u: usize, r: *sax.ErrorRecord) -> void {
    add("error ")
    addCount(r.*.code)
    add(" ")
    addCount(r.*.line)
    add(":")
    addCount(r.*.col)
    add(" ")
    addString(r.*.message)
}

fn handler() -> sax.Handler {
    var h = sax.emptyHandler()
    h.startDocument = @intFromPtr(onStartDocument)
    h.endDocument = @intFromPtr(onEndDocument)
    h.startElementNs = @intFromPtr(onStart)
    h.endElementNs = @intFromPtr(onEnd)
    h.characters = @intFromPtr(onChars)
    h.cdataBlock = @intFromPtr(onCdata)
    h.comment = @intFromPtr(onComment)
    h.processingInstruction = @intFromPtr(onPI)
    h.reference = @intFromPtr(onReference)
    h.entityDecl = @intFromPtr(onEntityDecl)
    h.reportError = @intFromPtr(onError)
    return h
}

fn logIs(expected: []const u8) -> bool {
    const ok = log.length == expected.length && text.same(log.address, @intFromPtr(expected.pointer), log.length)
    if !ok {
        const ignored = std.io.print("got:\n")
        const ignored2 = std.io.writeAllBytes(std.io.stdout(), text.bytes(log.address), log.length)
    }
    return ok
}

// The document pushed CHUNK bytes at a time (0: whole) with OPTIONS;
// the parse's answer at the end.
fn push(allocator: std.allocator.Allocator, doc: []const u8, chunk: usize, options: u64) -> i64 {
    log.length = 0
    const address = sax.createPush(allocator, handler(), 0, 0)
    if address == 0 { return -100 }
    const p = sax.parserAt(address)
    const ignored = sax.useOptions(p, options)
    var at: usize = 0
    while at < doc.length {
        var n = if chunk == 0 { doc.length } else { chunk }
        if n > doc.length - at { n = doc.length - at }
        const r = sax.parseChunk(p, @intFromPtr(doc.pointer) + at, n, false)
        at += n
    }
    const result = sax.parseChunk(p, 0, 0, true)
    sax.free(address)
    return result
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    if !text.bufferInit(&log, allocator, 4096) { return 1 }

    // Namespaces, a DTD's entities and attribute defaults, references.
    const doc = "<?xml version=\"1.0\"?>\n<!DOCTYPE r [<!ENTITY e \"x<b>y</b>\"><!ATTLIST r d CDATA 'dv' t NMTOKENS ' a  b '>]>\n<r xmlns=\"urn:a\" xmlns:p=\"urn:p\" p:a='1' b=\"2 &amp; 3\">t&e;<!--c--><?pi d?><p:q/>&lt;&#x41;<![CDATA[<x>]]></r>\n"
    const expected = "startDocument\nentityDecl e 1 [x<b>y</b>]\nstart r - urn:a xmlns:-=urn:a xmlns:p=urn:p defaulted 2 p:a=[1] -:b=[2 & 3] -:d=[dv] -:t=[a b]\nchars [t]\nchars [x]\nstart b - urn:a defaulted 0\nchars [y]\nend b\ncomment [c]\npi pi [d]\nstart q p urn:p defaulted 0\nend q\nchars [<]\nchars [A]\ncdata [<x>]\nend r\nendDocument\n"
    if push(allocator, doc, 0, sax.PARSE_NOENT) != 0 { return 2 }
    if !logIs(expected) { return 3 }
    // A byte at a time: the same events.
    if push(allocator, doc, 1, sax.PARSE_NOENT) != 0 { return 4 }
    if !logIs(expected) { return 5 }
    // Without NOENT: the entity's content parsed the first time it is
    // referenced (its events with it, as libxml2's), then the reference.
    if push(allocator, "<!DOCTYPE r [<!ENTITY e 'v'>]><r>&e;</r>", 7, 0) != 0 { return 6 }
    if !logIs("startDocument\nentityDecl e 1 [v]\nstart r - - defaulted 0\nchars [v]\nreference e\nend r\nendDocument\n") { return 7 }

    // Errors: libxml2's codes, messages and positions (a fatal error
    // stops the events: no endDocument).
    if push(allocator, "<a>\n <b></a>", 0, 0) != 76 { return 8 }
    if !logIs("startDocument\nstart a - - defaulted 0\nchars [\n ]\nstart b - - defaulted 0\nerror 76 2:9 Opening and ending tag mismatch: b line 2 and a\n") { return 9 }
    if push(allocator, "<r a='1' a='2'>&undefined;</r>", 0, 0) != 42 { return 10 }
    if !logIs("startDocument\nerror 42 1:15 Attribute a redefined\n") { return 11 }

    // UTF-16 with a byte order mark; Latin-1 declared.
    const utf16 = "\xff\xfe<\x00r\x00>\x00\xe9\x00<\x00/\x00r\x00>\x00"
    if push(allocator, utf16, 3, 0) != 0 { return 12 }
    if !logIs("startDocument\nstart r - - defaulted 0\nchars [\xc3\xa9]\nend r\nendDocument\n") { return 13 }
    if push(allocator, "<?xml version='1.0' encoding='ISO-8859-1'?><r>caf\xe9</r>", 0, 0) != 0 { return 14 }
    if !logIs("startDocument\nstart r - - defaulted 0\nchars [caf]\nchars [\xc3\xa9]\nend r\nendDocument\n") { return 15 }

    // Content in memory (xmlParseContent), as WebKit parses a fragment.
    log.length = 0
    const fragment = "<p>a</p>b<i/>"
    const memory = sax.createMemory(allocator, handler(), @intFromPtr(fragment.pointer), fragment.length)
    if memory == 0 { return 16 }
    sax.parserAt(memory).*.instate = sax.STATE_CONTENT
    sax.parseContent(sax.parserAt(memory))
    if sax.byteConsumed(sax.parserAt(memory)) != 13 { return 17 }
    sax.free(memory)
    if !logIs("start p - - defaulted 0\nchars [a]\nend p\nchars [b]\nstart i - - defaulted 0\nend i\n") { return 18 }

    // An entity loop: reported once the recursion is deep enough.
    if push(allocator, "<!DOCTYPE r [<!ENTITY a '&b;'><!ENTITY b '&a;'>]><r>&a;</r>", 0, sax.PARSE_NOENT) != 89 { return 19 }

    text.bufferFree(&log)
    return 13
}
