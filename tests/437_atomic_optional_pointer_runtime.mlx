// An atomic on an optional pointer (`?*T`, `?[*]T`): the pointer's word,
// null its zero — a C++ `std::atomic<T *>` translated. Load, store,
// exchange and compare-exchange. Exits 21.
const Node = extern struct { value: u64 }

var head: ?*Node = null
var bytes: ?[*]u8 = null

pub fn main() -> u8 {
    var first: Node = Node.{ .value = 5 }
    var second: Node = Node.{ .value = 9 }
    var total: u64 = 0
    if @atomicLoad(?*Node, &head, seq_cst) == null { total += 1 }
    @atomicStore(?*Node, &head, &first, seq_cst)
    const loaded = @atomicLoad(?*Node, &head, acquire)
    if loaded != null { total += loaded.?.*.value }
    const before = @atomicRmw(?*Node, &head, xchg, &second, seq_cst)
    if before != null { total += before.?.*.value }
    const now = @atomicLoad(?*Node, &head, seq_cst)
    if now != null { total += now.?.*.value }
    var storage: [4]u8 = [4]u8{ 1, 0, 0, 0 }
    @atomicStore(?[*]u8, &bytes, &storage, release)
    const seen = @atomicLoad(?[*]u8, &bytes, seq_cst)
    if seen != null { total += @intCast(u64, seen.?[0]) }
    return @intCast(u8, total)
}
