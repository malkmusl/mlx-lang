// std.demangle: C++ names as c++filt (GNU binutils) writes them, for
// g++'s and clang++'s manglings (nested and local names, substitutions,
// template parameters, operators, constructors, destructors, conversions,
// lambdas, function and member pointers, references to arrays, literals,
// vtables, guard variables, thunks, clones), and mlx-cc's own spellings
// (class template instances named with their arguments' codes, function
// template arguments after the nested name and separated by commas, no
// result type, values as plain numbers). A name it cannot read gives 0, a
// text too long for the buffer is cut with "...". Exits 13 when every
// check holds, else the number of the first check that failed.
const demangle = @import("std.demangle")

var buffer: [256]u8 = undefined

fn same(name: []const u8, expected: []const u8) -> bool {
    const out: [*]u8 = &buffer
    const length = demangle.demangle(name, out, 256)
    if length != expected.length { return false }
    var index: usize = 0
    while index < length {
        if out[index] != expected[index] { return false }
        index += 1
    }
    return true
}

pub fn main() -> u8 {
    if !same("_ZN7WebCore4Node11appendChildERNS_4NodeE", "WebCore::Node::appendChild(WebCore::Node&)") { return 1 }
    if !same("_Z5outeri", "outer(int)") { return 2 }
    if !same("_ZNK3Foo3getEv", "Foo::get() const") { return 3 }
    if !same("_ZN3FooC1Ev", "Foo::Foo()") || !same("_ZN3FooD0Ev", "Foo::~Foo()") { return 4 }
    if !same("_ZNSt6vectorIiSaIiEE9push_backERKi", "std::vector<int, std::allocator<int> >::push_back(int const&)") { return 5 }
    if !same("_Z3maxIiET_S0_S0_", "int max<int>(int, int)") { return 6 }
    if !same("_ZZ4mainE5count", "main::count") { return 7 }
    if !same("_ZTV3Foo", "vtable for Foo") || !same("_ZTI3Foo", "typeinfo for Foo") { return 8 }
    if !same("_ZN12_GLOBAL__N_14workEv", "(anonymous namespace)::work()") { return 9 }
    if !same("_ZN3FooplERKS_", "Foo::operator+(Foo const&)") || !same("_ZN3FooaSEOS_", "Foo::operator=(Foo&&)") { return 10 }
    if !same("_Z1fPFviE", "f(void (*)(int))") || !same("_Z1fM3FooFivE", "f(int (Foo::*)())") { return 11 }
    if !same("_ZN3Foo3barEv.cold", "Foo::bar() [clone .cold]") { return 12 }
    if !same("_ZNKSt8functionIFvvEEclEv", "std::function<void ()>::operator()() const") { return 14 }
    if !same("_ZZ7countervENKUlvE_clEv", "counter()::{lambda()#1}::operator()() const") { return 15 }
    if !same("_ZThn8_N3Foo3barEv", "non-virtual thunk to Foo::bar()") || !same("_ZGVZ4mainE1x", "guard variable for main::x") { return 16 }
    if !same("_ZN3FoocviEv", "Foo::operator int()") { return 17 }
    if !same("_ZNKSt6vectorIPN7WebCore4NodeESaIS2_EE4sizeEv", "std::vector<WebCore::Node*, std::allocator<WebCore::Node*> >::size() const") { return 18 }
    if !same("_ZSt4moveIRiEONSt16remove_referenceIT_E4typeEOS2_", "std::remove_reference<int&>::type&& std::move<int&>(int&)") { return 19 }
    if !same("_Z1fRA10_i", "f(int (&) [10])") || !same("_Z1fILi3EEvv", "void f<3>()") || !same("_Z1fILb1EEvv", "void f<true>()") { return 20 }
    if !same("_ZN5boost6detail17sp_counted_impl_pINS_10shared_ptrIiEEE7disposeEv", "boost::detail::sp_counted_impl_p<boost::shared_ptr<int> >::dispose()") { return 21 }
    // mlx-cc's.
    if !same("_ZN8geometry9Holder<i>4pokeEPN8geometry5ShapeEi", "geometry::Holder<int>::poke(geometry::Shape*, int)") { return 22 }
    if !same("_ZN3WTF57Vector<j,1,N3WTF15CrashOnOverflowE,16,N3WTF10FastMallocE>8capacityEv", "WTF::Vector<unsigned int, 1, WTF::CrashOnOverflow, 16, WTF::FastMalloc>::capacity()") { return 23 }
    if !same("_Z16WTFCrashWithInfoIPN3JSC6JSCellE,N3JSC6JSTypeE,mEiPKcPKcPN3JSC6JSCellEN3JSC6JSTypeEm", "WTFCrashWithInfo<JSC::JSCell*, JSC::JSType, unsigned long>(int, char const*, char const*, JSC::JSCell*, JSC::JSType, unsigned long)") { return 24 }
    if !same("_ZN3JSC8GCClient4Heap25callbackGlobalObjectSpaceEI1Ev", "JSC::GCClient::Heap::callbackGlobalObjectSpace<1>()") { return 25 }
    if !same("_ZN3WTF8enumNameEILN3JSC18BufferMemoryResult4KindE62Ev", "WTF::enumName<(JSC::BufferMemoryResult::Kind)62>()") { return 26 }
    if !same("_ZN1A1fEIZN1B1gEvEUlvE_Ev", "A::f<B::g()::{lambda()#1}>()") { return 27 }
    // Not read: not mangled, an expression in an argument.
    if !same("main", "") || !same("_Z1fIXadL_Z1gvEEEvv", "") { return 28 }
    // Too long: cut.
    const out: [*]u8 = &buffer
    const long_name = "_ZN3WTF57Vector<j,1,N3WTF15CrashOnOverflowE,16,N3WTF10FastMallocE>8capacityEv"
    const cut = demangle.demangle(long_name, out, 32)
    if cut != 32 || out[0] != 87 || out[29] != 46 || out[31] != 46 { return 29 }
    return 13
}
