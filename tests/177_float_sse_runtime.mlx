fn arithmetic(left: f64, right: f64) -> f64 {
    return (left + right) * right / left - right
}

fn mixed(integer_a: u8, float_a: f64, integer_b: u16, float_b: f32) -> u8 {
    if integer_a != 7 { return 1 }
    if float_a != 1.5 { return 2 }
    if integer_b != 513 { return 3 }
    if float_b != @floatCast(f32, 3.5) { return 4 }
    return 13
}

pub fn main() -> u8 {
    const result = arithmetic(2.0, 3.0)
    if result != 4.5 { return 5 }
    if !(result > 4.0) { return 6 }
    if !(result >= 4.5) { return 7 }
    if !(result < 5.0) { return 8 }
    if !(result <= 4.5) { return 9 }

    const zero = @floatCast(f64, 0.0)
    const nan = zero / zero
    if nan == nan { return 10 }
    if !(nan != nan) { return 11 }
    if nan < zero || nan <= zero || nan > zero || nan >= zero { return 12 }

    return mixed(7, 1.5, 513, @floatCast(f32, 3.5))
}
