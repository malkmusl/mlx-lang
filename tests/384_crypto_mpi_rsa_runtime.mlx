// std.crypto.mpi and std.crypto.rsa's private half: integers of any size
// read from and written as hexadecimal, added, multiplied, divided both
// ways with signs, compared, shifted, raised modulo odd (Montgomery) and
// even moduli, their gcd and inverse, primes told from composites and
// found; then an RSA key from its parameters: PKCS #1 v1.5 and PSS
// signatures that Python computed (and that std's verification
// accepts), OAEP and PKCS #1 v1.5 encryption with fixed seeds and
// padding, decryption of both, the same key without p and q, random
// seeds, salts and paddings round-tripped, and a key generated. Exits 13
// when every check holds, else the number of the first check that
// failed.
const std = @import("std")
const mpi = @import("std.crypto.mpi")
const rsa = @import("std.crypto.rsa")
const hash = @import("std.crypto.hash")

const N = "DEEA09D1F2963929E00A588F61450939ED31E5CA042E52232BE947E5B5AADF606C85E7A09D2121426EE7D6430CCB2608A8C2991D8C5759AE777CB25724A86791916F83EFA3530DCBC494BA230F31140B64E39389F2F1B06A67738B97A9E5D5FF7DAC927A9EA1B5948A2763A73EEB6524C9E078CF54D326667789E29A69D9DCB1"
const D = "0EDBF5BDDEA07C2CC20C1A816B43DB74B6AEA0F15594436228110FBB7C9FC86E6069902A451322690FE4C923F4D03D67AE1D33B0F42C15F4B2EF1761C6F6295A1B3654B3D2222A3A1615BFB577B2437FA24B4A75BAF30FA21326DE1627EE14E327B00F37D087C4B0D9C8D96137B3CF61C1236CCD3666F1F6708C6E969B55A309"
const P = "DF27B474402615F619BAA4A49F0AC0170928CA2CECA468E9CE6BA18B8AD12FC9A0D4F2E345FFB65D9F9BC6D3ADAE2C57EAFD6A994409A2329EF50006A43E3769"
const Q = "FFB941D2B225999D15F5B42D2C57FAD0D64B960D01374711CC63BBB911EEDED90770623545BE83C28F87425FB9C25AFB6989B3AC88EC029F9873A6AA03D75A09"
const DIGEST = "2CF24DBA5FB0A30E26E83B2AC5B9E29E1B161E5C1FA7425E73043362938B9824"
const PKCS1SIG = "97D4B62785580C3EAF08F3EA1DDCEF071B530403DA5A703BC847C5AD815150928C82D85967912569F613430B2D9C47DA7390BF7DA719AFC292C823D0E25E6389A778B6C3C06BD6ECC9B026EF2C8640E5CBDC0761BE88732A4A0938AF4A2F05EBE20CA3CE6D3348F1444B26E976DB3CF968C728134DE963380958ADEAA5FD5DF6"
const PSSSALT = "000102030405060708090A0B0C0D0E0F101112131415161718191A1B1C1D1E1F"
const PSSSIG = "6D74CA275F84F284BD94DF9C42718D7FDE242E78558905FEAFC80EEB55545829792276FA3EA6D0AF123AD0369D77FA9549B0BBFEA48FA728142CA15F650BB233AE466BA0176598D7C4CB88F50DE352543DAA5F6171511DB0C79C897EA3245785834F48B286BF32191EE2DC2F80D7A18C865C168FA6C1047C84CF6C01D12C488D"
const OAEPSEED = "6465666768696A6B6C6D6E6F707172737475767778797A7B7C7D7E7F80818283"
const OAEPCIPHER = "A03854E8EE9E8B1A4A93ED3C75CEA296C47414BFA23D86892A166D574ECEE9F02D2B8A1559FC273DC0EE5FC4CD63CCCF26953B3C605BA5344A4FB5E954903A984144F8C7C6783B6B0452B9982FAA2104A72F5BC179D0F53D3BDEFA6DB00281AA71AF8CE926BF1897020B98AFC79FA3F6CD3324901C2F324A275654D352F6A984"
const PKCS1CIPHER = "D9FDF196AA7C4554FFAAABD5F2869658CE0F2BAFBACFFD980D3D0BEEA87C436B0C83CAAA4B5AC376722EEDEE9B949B78C40A203D29200D6EFF4B5062091758A9CD86B9E3383E78065E0B708418E56306C96AB85D097687144EB392D71DDAA37F5C7E058ACFB399C6DCDFB7685D248B0814450FBD96311D0D80892DC29507FFAF"

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn hexIs(m: *const mpi.Mpi, expected: []const u8) -> bool {
    var text: [1100]u8 = undefined
    const n = mpi.writeHex(m, text[0..1100])
    return same(text[0..n], expected)
}

fn nibble(c: u8) -> u8 {
    if c >= '0' && c <= '9' { return c - '0' }
    if c >= 'a' && c <= 'f' { return c - 'a' + 10 }
    return c - 'A' + 10
}

// Hex text as bytes; the count.
fn unhex(text: []const u8, out: [*]u8) -> usize {
    var index: usize = 0
    while index + 1 < text.length {
        out[index / 2] = (nibble(text[index]) << 4) | nibble(text[index + 1])
        index += 2
    }
    return text.length / 2
}

fn bytesAre(bytes: [*]const u8, length: usize, hex: []const u8) -> bool {
    var expected: [600]u8 = undefined
    const count = unhex(hex, &expected)
    return count == length && same(bytes[0..length], expected[0..count])
}

const Keys = struct {
    secret: rsa.PrivateKey
    plain: rsa.PrivateKey
    made: rsa.PrivateKey
    nBytes: [128]u8
    eBytes: [3]u8
    dBytes: [128]u8
    pBytes: [64]u8
    qBytes: [64]u8
    digest: [32]u8
    salt: [32]u8
    seed: [32]u8
    out: [512]u8
    back: [512]u8
    message: [512]u8
    padding: [128]u8
}

fn checkMpi(allocator: mpi.Allocator) -> u8 {
    var a: mpi.Mpi = undefined
    var b: mpi.Mpi = undefined
    var w: mpi.Mpi = undefined
    var r: mpi.Mpi = undefined
    var m: mpi.Mpi = undefined
    mpi.init(&a, allocator)
    mpi.init(&b, allocator)
    mpi.init(&w, allocator)
    mpi.init(&r, allocator)
    mpi.init(&m, allocator)
    if !mpi.fromHex(&a, "400000000000000000000000000003039") || !mpi.fromHex(&b, "0x3FFFFFFFFFFFFFFFFF") || !hexIs(&a, "400000000000000000000000000003039") || !hexIs(&b, "3FFFFFFFFFFFFFFFFF") { return 1 }
    if mpi.fromHex(&w, "") || mpi.fromHex(&w, "12G") || !mpi.fromHex(&w, "-0") || !mpi.isZero(&w) || !hexIs(&w, "0") || mpi.bitLength(&a) != 131 || mpi.bitLength(&b) != 70 || mpi.byteLength(&a) != 17 { return 2 }
    if !mpi.mul(&w, &a, &b) || !hexIs(&w, "FFFFFFFFFFFFFFFFFC00000000000C0E3FFFFFFFFFFFFFCFC7") { return 3 }
    if !mpi.divRem(&w, &r, &a, &b) || !hexIs(&w, "1000000000000000") || !hexIs(&r, "1000000000003039") { return 4 }
    if !mpi.gcd(&w, &a, &b) || !hexIs(&w, "1") { return 5 }
    if !mpi.fromHex(&m, "7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF") || !mpi.setU64(&w, 3) || !mpi.invm(&r, &w, &m) || !hexIs(&r, "55555555555555555555555555555555") { return 6 }
    if !mpi.powm(&w, &a, &b, &m) || !hexIs(&w, "4C17D56A8B20641ABC43E49B880A83D5") || !mpi.powmPublic(&r, &a, &b, &m) || mpi.compare(&w, &r) != 0 { return 7 }
    if !mpi.setU64(&r, 12345) || !mpi.setU64(&w, 0) || !mpi.setBit(&w, 100) || !mpi.powm(&w, &a, &r, &w) || !hexIs(&w, "100E950EA9B4E32BC3F1E6379") { return 8 }
    // Signs: floor and truncating division of -a by b.
    a.negative = true
    if !hexIs(&a, "-400000000000000000000000000003039") || !mpi.mod(&w, &a, &b) || !hexIs(&w, "3FEFFFFFFFFFFFCFC6") { return 9 }
    if !mpi.divRem(&w, &r, &a, &b) || !hexIs(&w, "-1000000000000000") || !hexIs(&r, "-1000000000003039") { return 10 }
    if !mpi.floorDivRem(&w, null, &a, &b) || !hexIs(&w, "-1000000000000001") { return 11 }
    if !mpi.set(&w, &a) || !mpi.sub(&w, &w, &a) || !mpi.isZero(&w) || mpi.isNegative(&w) || !mpi.add(&w, &a, &b) || !mpi.isNegative(&w) || mpi.compare(&w, &a) <= 0 || mpi.compare(&a, &b) >= 0 || mpi.compareU64(&a, 0) != -1 { return 12 }
    a.negative = false
    if !mpi.sub(&w, &b, &a) || !mpi.add(&w, &w, &a) || mpi.compare(&w, &b) != 0 || mpi.compareU64(&b, 18446744073709551615) != 1 { return 14 }
    if mpi.divRem(&w, &r, &a, &w) && mpi.isZero(&w) { return 15 }
    // Bits and shifts.
    if !mpi.setU64(&w, 1) || !mpi.shiftLeft(&w, &w, 130) || !mpi.addU64(&w, &w, 12345) || mpi.compare(&w, &a) != 0 || !mpi.shiftRight(&w, &w, 64) || !hexIs(&w, "40000000000000000") || !mpi.testBit(&a, 130) || mpi.testBit(&a, 129) || !mpi.testBit(&a, 0) { return 16 }
    if !mpi.subU64(&w, &a, 12345) || !hexIs(&w, "400000000000000000000000000000000") || mpi.remainderU64(&a, 7) != 6 { return 17 }
    mpi.clearHigh(&w, 64)
    if !mpi.isZero(&w) || !mpi.set(&w, &a) || !mpi.mulU64(&w, &w, 16) || !hexIs(&w, "4000000000000000000000000000030390") { return 18 }
    mpi.clearBit(&w, 4)
    if !hexIs(&w, "4000000000000000000000000000030380") { return 19 }
    // Bytes.
    var bytes: [17]u8 = undefined
    mpi.toBytes(&a, bytes[0..17])
    if bytes[0] != 4 || bytes[16] != 0x39 || bytes[15] != 0x30 || !mpi.fromBytes(&w, bytes[0..17]) || mpi.compare(&w, &a) != 0 || !mpi.setI64(&w, -5) || !hexIs(&w, "-5") { return 20 }
    // Primes.
    if !mpi.isProbablePrime(&m, 10) || !mpi.setU64(&w, 2305843009213693951) || !mpi.isProbablePrime(&w, 10) || !mpi.mul(&w, &w, &w) || mpi.isProbablePrime(&w, 10) || !mpi.mulU64(&r, &m, 3) || mpi.isProbablePrime(&r, 10) || !mpi.setU64(&r, 1) || mpi.isProbablePrime(&r, 10) { return 21 }
    if !mpi.setU64(&r, 65537) || !mpi.generatePrime(&w, 128, &r) || mpi.bitLength(&w) != 128 || !mpi.isProbablePrime(&w, 10) || !mpi.subU64(&b, &w, 1) || !mpi.gcd(&b, &b, &r) || !hexIs(&b, "1") { return 22 }
    mpi.deinit(&a)
    mpi.deinit(&b)
    mpi.deinit(&w)
    mpi.deinit(&r)
    mpi.deinit(&m)
    return 0
}

fn checkRsa(allocator: mpi.Allocator, keys: *Keys) -> u8 {
    const nLength = unhex(N, &keys.*.nBytes)
    keys.*.eBytes[0] = 1
    keys.*.eBytes[1] = 0
    keys.*.eBytes[2] = 1
    const dLength = unhex(D, &keys.*.dBytes)
    const pLength = unhex(P, &keys.*.pBytes)
    const qLength = unhex(Q, &keys.*.qBytes)
    _ = unhex(DIGEST, &keys.*.digest)
    _ = unhex(PSSSALT, &keys.*.salt)
    _ = unhex(OAEPSEED, &keys.*.seed)
    const secret = &keys.*.secret
    if !rsa.privateKeyInit(secret, allocator, keys.*.nBytes[0..nLength], keys.*.eBytes[0..3], keys.*.dBytes[0..dLength], keys.*.pBytes[0..pLength], keys.*.qBytes[0..qLength]) || !secret.*.hasCrt || secret.*.public.size != 128 { return 30 }
    // p and q swapped do not make n.
    if rsa.privateKeyInit(&keys.*.plain, allocator, keys.*.nBytes[0..nLength], keys.*.eBytes[0..3], keys.*.dBytes[0..dLength], keys.*.pBytes[0..pLength], keys.*.pBytes[0..pLength]) { return 31 }
    const out: [*]u8 = &keys.*.out
    const digest: [*]const u8 = &keys.*.digest
    if !rsa.signPkcs1(secret, hash.Algorithm.sha256, digest, out) || !bytesAre(out, 128, PKCS1SIG) { return 32 }
    if !rsa.verifyPkcs1(&secret.*.public, hash.Algorithm.sha256, digest, out, 128) { return 33 }
    if !rsa.signPss(secret, hash.Algorithm.sha256, digest, keys.*.salt[0..32], out) || !bytesAre(out, 128, PSSSIG) { return 34 }
    if !rsa.verifyPss(&secret.*.public, hash.Algorithm.sha256, digest, out, 128, 32) { return 35 }
    // OAEP: the cipher Python made decrypts; the same seed makes it.
    const back: [*]u8 = &keys.*.back
    var cipher: [128]u8 = undefined
    const cipherBytes: [*]u8 = &cipher
    _ = unhex(OAEPCIPHER, cipherBytes)
    var length: usize = 0
    if !rsa.decryptOaep(secret, hash.Algorithm.sha256, "", cipher[0..128], back, &length) || !same(back[0..length], "secret message") { return 36 }
    if !rsa.encryptOaep(&secret.*.public, hash.Algorithm.sha256, "", "secret message", keys.*.seed[0..32], out) || !bytesAre(out, 128, OAEPCIPHER) { return 37 }
    if rsa.decryptOaep(secret, hash.Algorithm.sha256, "label", cipher[0..128], back, &length) { return 38 }
    cipher[127] = cipher[127] ^ 1
    if rsa.decryptOaep(secret, hash.Algorithm.sha256, "", cipher[0..128], back, &length) { return 39 }
    // PKCS #1 v1.5 encryption with the padding Python used.
    var index: usize = 0
    while index < 111 {
        keys.*.padding[index] = @intCast(u8, (index * 7) % 255 + 1)
        index += 1
    }
    if !rsa.encryptPkcs1With(&secret.*.public, "secret message", keys.*.padding[0..111], out) || !bytesAre(out, 128, PKCS1CIPHER) { return 40 }
    if !rsa.decryptPkcs1(secret, out[0..128], back, &length) || !same(back[0..length], "secret message") { return 41 }
    // Random seeds, salts and paddings round-trip.
    if !rsa.encryptPkcs1(&secret.*.public, "another one", out) || bytesAre(out, 128, PKCS1CIPHER) || !rsa.decryptPkcs1(secret, out[0..128], back, &length) || !same(back[0..length], "another one") { return 42 }
    if !rsa.encryptOaepRandom(&secret.*.public, hash.Algorithm.sha1, "lbl", "x", out) || !rsa.decryptOaep(secret, hash.Algorithm.sha1, "lbl", out[0..128], back, &length) || !same(back[0..length], "x") { return 43 }
    if !rsa.signPssRandom(secret, hash.Algorithm.sha256, digest, 20, out) || !rsa.verifyPss(&secret.*.public, hash.Algorithm.sha256, digest, out, 128, 20) || rsa.verifyPss(&secret.*.public, hash.Algorithm.sha256, digest, out, 128, 32) { return 44 }
    // Too long for the padding.
    index = 0
    while index < 200 {
        keys.*.message[index] = 'm'
        index += 1
    }
    if rsa.encryptPkcs1(&secret.*.public, keys.*.message[0..118], out) || !rsa.encryptPkcs1(&secret.*.public, keys.*.message[0..117], out) || rsa.encryptOaepRandom(&secret.*.public, hash.Algorithm.sha256, "", keys.*.message[0..63], out) || !rsa.encryptOaepRandom(&secret.*.public, hash.Algorithm.sha256, "", keys.*.message[0..62], out) { return 45 }
    // The key with d alone signs the same.
    const plain = &keys.*.plain
    if !rsa.privateKeyInit(plain, allocator, keys.*.nBytes[0..nLength], keys.*.eBytes[0..3], keys.*.dBytes[0..dLength], "", "") || plain.*.hasCrt { return 46 }
    if !rsa.signPkcs1(plain, hash.Algorithm.sha256, digest, out) || !bytesAre(out, 128, PKCS1SIG) { return 47 }
    // A key made here.
    const made = &keys.*.made
    if !rsa.generateKey(made, allocator, 1024, 65537) || !made.*.hasCrt || made.*.public.bits != 1024 { return 48 }
    if !rsa.signPkcs1(made, hash.Algorithm.sha384, digest, out) || !rsa.verifyPkcs1(&made.*.public, hash.Algorithm.sha384, digest, out, 128) || rsa.verifyPkcs1(&secret.*.public, hash.Algorithm.sha384, digest, out, 128) { return 49 }
    if !rsa.encryptOaepRandom(&made.*.public, hash.Algorithm.sha256, "", "made here", out) || !rsa.decryptOaep(made, hash.Algorithm.sha256, "", out[0..128], back, &length) || !same(back[0..length], "made here") || rsa.decryptOaep(secret, hash.Algorithm.sha256, "", out[0..128], back, &length) { return 50 }
    return 0
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const failed = checkMpi(allocator)
    if failed != 0 { return failed }
    const memory = allocator.alloc(@sizeOf(Keys), 16)
    if memory == null { return 29 }
    const keys = unsafe { @ptrCast(*Keys, memory.?) }
    const result = checkRsa(allocator, keys)
    if result != 0 { return result }
    return 13
}
