// Floats kept in xmm8..xmm15 by the slot they belong to (x86_64's
// encoder): a value is read from the register while nothing else can
// have changed its slot, and from memory again after a label, a call, a
// store to the slot, a store through a pointer or a copy. Each check
// mixes those with the values in flight; the values are exact in binary.
// Exits 13 on success (another number: the check that failed).
const Point = struct { x: f64, y: f64 }

fn scaled(value: f64, factor: f64) -> f64 {
    // Many floats of its own, in the registers the caller's were in.
    const a = value * 2.0
    const b = a + 1.0
    const c = b * 4.0
    const d = c - 4.0
    const e = d / 8.0
    return e * factor
}

fn set(target: *f64, value: f64) -> void { target.* = value }

pub fn main() -> usize {
    // More values in flight than registers: the oldest are read again.
    const a: f64 = 1.5
    const b = a + 1.0
    const c = b + 1.0
    const d = c + 1.0
    const e = d + 1.0
    const f = e + 1.0
    const g = f + 1.0
    const h = g + 1.0
    const i = h + 1.0
    const j = i + 1.0
    const k = j + 1.0
    if a + b + c + d + e + f + g + h + i + j + k != 71.5 { return 1 }
    if k * a != 17.25 { return 2 }
    // Across a call.
    const before = a * 4.0
    const called = scaled(before, 0.5)
    if called != 3.0 { return 3 }
    if before + called != 9.0 { return 4 }
    // A local changed through a pointer, then read in the same block.
    var held: f64 = 2.5
    const twice = held * 2.0
    set(&held, 7.0)
    if held != 7.0 { return 5 }
    if twice != 5.0 { return 6 }
    var direct: f64 = 3.0
    const pointer = &direct
    const tripled = direct * 3.0
    pointer.* = 11.0
    if direct + tripled != 20.0 { return 7 }
    // Struct fields, written and read back.
    var point = Point.{ .x = 1.25, .y = 2.5 }
    const sum = point.x + point.y
    point.x = 10.0
    if point.x + sum != 13.75 { return 8 }
    // Branches and loops: the joins read from memory.
    var total: f64 = 0.0
    var step: usize = 0
    while step < 10 {
        const value: f64 = @floatFromInt(f64, step)
        total = if step % 2 == 0 { total + value * 0.5 } else { total - value * 0.25 }
        step += 1
    }
    if total != 3.75 { return 9 }
    // f32 next to f64.
    const small: f32 = 1.5
    const wide: f64 = 1.5
    const small_sum = small + small * 2.0
    const wide_sum = wide + wide * 2.0
    if small_sum != 4.5 { return 10 }
    if wide_sum != 4.5 { return 11 }
    if @floatCast(f64, small_sum) != wide_sum { return 12 }
    return 13
}
