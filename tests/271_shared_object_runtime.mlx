// Shared objects (`mlx4 --shared`): tests/run_foreign.sh builds
// tests/support/shared_object_library.mlx into an ET_DYN object and runs
// this program with its path. It is loaded twice, from two copies (two
// objects for the dynamic linker), with dlopen; its export is found with
// dlsym; functions it hands out are called through pointers with a record
// of this program, and build their structs in this program's aggregate
// arena (a thousand calls grow it by the struct each call returns, no
// more: the export kept this program's arena). A string of the object is
// read. Exits 13.
const std = @import("std")

extern("c") fn dlopen(name: [*]const u8, flags: i32) -> usize
extern("c") fn dlsym(handle: usize, name: [*]const u8) -> usize

const Point = struct { x: i32, y: i32 }
const Record = struct {
    calls: usize
    last: Point
}

const Entry = fn(usize) -> usize
const Visit = fn(*Record, usize) -> usize

fn arenaMark() -> usize {
    var probe: [8]u8 = undefined
    return @intFromPtr(&probe)
}

// The export's address in a newly loaded copy; 0 when it failed.
fn load(path: [*]const u8) -> usize {
    const library = dlopen(path, 2)
    if library == 0 { return 0 }
    unsafe { return dlsym(library, @ptrCast([*]const u8, "mlx_test_entry")) }
}

fn entryAt(address: usize) -> Entry {
    var entry: Entry = undefined
    unsafe { entry = @ptrFromInt(Entry, address) }
    return entry
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if std.process.count(arguments) < 3 { return 1 }
    const first_address = load(std.process.argument(arguments, 1).pointer)
    const second_address = load(std.process.argument(arguments, 2).pointer)
    if first_address == 0 || second_address == 0 { return 20 }
    const first = entryAt(first_address)
    const second = entryAt(second_address)
    if first(0) != 271 || second(0) != 271 { return 2 }
    // Two objects: the same function at two addresses.
    if first(1) == second(1) { return 3 }

    var visit: Visit = undefined
    unsafe { visit = @ptrFromInt(Visit, first(1)) }
    var record: Record = undefined
    record.calls = 0
    const before = arenaMark()
    var index: usize = 0
    var result: usize = 0
    while index < 1000 {
        result = visit(&record, index)
        index += 1
    }
    const growth = arenaMark() - before
    if result != 999 * 3 + 271 { return 4 }
    if record.calls != 1000 || record.last.x != 999 || record.last.y != 2997 { return 5 }
    // One Point (8 bytes) per call, and the mark's own 8 bytes.
    if growth != 1000 * 8 + 8 { return 6 }

    unsafe { visit = @ptrFromInt(Visit, second(1)) }
    if visit(&record, 5) != 15 + 271 || record.calls != 1001 { return 7 }

    var text: [*]const u8 = undefined
    unsafe { text = @ptrFromInt([*]const u8, first(2)) }
    const expected = "shared object"
    if first(3) != expected.length { return 8 }
    index = 0
    while index < expected.length {
        if text[index] != expected[index] { return 9 }
        index += 1
    }
    return 13
}
