// The kernel's DisplayPort link (projects/brix/kernel/gpu_link.mlx, with
// the plan of gpu_mode.mlx and its carrying out by gpu_set.mlx) on the
// host, against a card that is a table and a monitor behind its AUX
// channel that is one too (tests/support/dp_monitor.mlx over
// tmds_card.mlx): the sequences as they were worked out from Linux 6.6's
// display core, write for write, table run for table run and AUX
// transaction for transaction, in one order.
//
// The machine: controller 0 runs the firmware's 1280x960 (108 MHz by the
// DTO), front end 2 on back end 1 (UNIPHY B), a DisplayPort connector on
// hot plug line 2 with AUX channel 1 behind it as the ROM made here says;
// the monitor's own mode is 3840x1080 at 266.64 MHz.
//
// What is held:
// - a link that is too slow (1.62 Gbit/s on 2 lanes) taken down and
//   trained at 2.7 Gbit/s on 4 lanes: every event of the change (THERE),
//   and of the way back when the monitor loses the new link under the
//   picture (BACK); the monitor then holds the firmware's link again and
//   every register of the display is as it was;
// - the same to every rate and count of lanes a timing can ask for, the
//   transmitter's table told each, the monitor told each, M for each;
// - a link that is not trained (the card says so; the monitor holds
//   nothing; its lanes are not locked) trained;
// - a link that has room kept, by the registers alone as before, the
//   monitor's lanes read afterwards (KEPT); lanes lost under the kept
//   link: the registers back, and the firmware's link trained again;
// - the firmware's own link taken down and trained again (the choice
//   "rehearsal": REHEARSAL), the picture where it was;
// - the asking alone: its transactions, and no write to anything but
//   the AUX channel's own words;
// - a boot that keeps the firmware's picture: no write, no table, no
//   transaction;
// - a training whose rounds take what the monitor asks for, with the
//   waits the driver has to make; one that fails in each way there is
//   (a clock that does not come, the same swing five times, six rounds
//   without equalisation, the clock lost meanwhile on some lanes or on
//   all, lanes that drop afterwards), four tries with the link taken
//   down between and the pauses growing, then the way back;
// - a failure at every step: each write of the driver's that does not
//   hold, each table run stopped by the card, each access to the monitor
//   unanswered; after each the firmware's state is back, or the change
//   came through by a second try of the training;
// - the way back's own endings: a table that does not run to its end
//   (the output left as that left it), a firmware's link that does not
//   train again (not said to be back), a register that stays;
// - another controller, front end, back end, hot plug line and AUX
//   channel; and that the longest dark time is said before the first
//   write.
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const dplink = @import("../projects/brix/kernel/gpu_link.mlx")
const aux = @import("../projects/brix/kernel/gpu_aux.mlx")
const rom = @import("./support/atom_rom.mlx")
const card = @import("./support/tmds_card.mlx")
const sink = @import("./support/dp_monitor.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn logWrite(text: []const u8) -> void {
    card.logWrite(text)
    if show { say(text) }
}

// The ROM and what is read of it.
var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined

// The ROM made for the board as the monitor's file has it (`caps`: the
// encoder's capability record) and opened.
fn open(caps: usize, ending: card.Ending) -> void {
    sink.makeRom(&builder, caps, ending)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
}

var readout: scanout.Readout = undefined
var plan: mode.Plan = undefined
var result: set.Result = undefined
var memory: scanout.Memory = undefined
var heard: dplink.Heard = undefined
var outCard: scanout.Card = undefined
var port: aux.Port = undefined
var channel: aux.Channel = undefined

// The registers as they were before a change.
var before: [card.ROOM]usize = undefined
var beforeMarks: [24]usize = undefined

fn remember() -> void {
    var k: usize = 0
    while k < card.ROOM {
        before[k] = card.registers[k]
        k += 1
    }
    k = 0
    while k < 24 {
        beforeMarks[k] = card.marks[k]
        k += 1
    }
}

// Whether every register of the display holds what it held. Not held:
// the tables' mail; the bits that are the card's own answers; and the
// AUX channel's own words (its blocks and the pads' calibration), which
// a transaction leaves as it leaves them: `auxAsBefore` holds the three
// of them that the firmware's state is.
fn asBefore() -> bool {
    var k: usize = 0
    while k < card.ROOM {
        var answers: usize = 0
        if k >= 0x321 && k < 0x327 { answers = 0x10 }
        if k == 0x1A11 || k == 0x1C11 || k == 0x1E11 { answers = 0x4 }
        const mail = k >= card.MAIL && k <= card.ANSWER
        const channels = (k >= 0x5C00 && k < 0x5CA8) || k == 0x483B || k == 0x483C
        if (card.registers[k] ^ before[k]) & ~answers != 0 && !mail && !channels {
            if show {
                const out = scanout.Card.{ .read = sink.read, .now = card.now, .write = say }
                say("differs: ")
                out.hexDigits(k, 4)
                say(" ")
                out.hexDigits(card.registers[k], 8)
                say(" was ")
                out.hexDigits(before[k], 8)
                say("\n")
            }
            return false
        }
        k += 1
    }
    k = 0
    while k < 24 {
        if card.marks[k] != beforeMarks[k] { return false }
        k += 1
    }
    return true
}

// The AUX channel's control word, its receive window and its pins' word
// as before.
fn auxAsBefore() -> bool {
    const at = 0x5C00 + 0x1C * sink.channel
    return card.registers[at] == before[at] && card.registers[at + 0x0A] == before[at + 0x0A] && card.registers[0x4868 + 4 * sink.channel] == before[0x4868 + 4 * sink.channel]
}

// The monitor holds the link `code` on `lanes` lanes, every lane locked,
// awake, no pattern; and the transmitter is on for it.
fn monitorHolds(code: usize, lanes: usize) -> bool {
    var k: usize = 0
    while k < lanes {
        if !sink.clockOf[k] || !sink.lockOf[k] { return false }
        k += 1
    }
    return @intCast(usize, sink.dpcd[0x100]) == code && @intCast(usize, sink.dpcd[0x101]) == (lanes | 0x80) && @intCast(usize, sink.dpcd[0x600]) == 1 && @intCast(usize, sink.dpcd[0x102]) == 0 && sink.txOn && sink.txCode == code && sink.txLanes == lanes
}

// The monitor: its own timing 3840x1080 at 60 Hz (266.64 MHz, 4000 by
// 1111, porches 48 and 3, pulses 32 high and 10 low).
fn wide() -> edid.Monitor {
    return edid.Monitor.{ .state = edid.State.found, .width = 3840, .height = 1080, .timing = edid.Timing.{ .clock = 266640, .width = 3840, .hTotal = 4000, .hFront = 48, .hSync = 32, .hPositive = true, .height = 1080, .vTotal = 1111, .vFront = 3, .vSync = 10, .vPositive = false, .interlaced = false, .stereo = false }, .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.none }
}

// What the kernel knows of the firmware's picture: 1280x960 at the start
// of an aperture of 256 MiB.
fn known() -> scanout.Memory {
    return scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
}

// The card read out, the monitor asked when the boot's choice lets it be
// (`asking`), the plan made and said, with the ROM that is open.
fn make(monitor: *const edid.Monitor, wish: mode.Wish, asking: bool) -> void {
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    const offer = edid.nothing()
    outCard = scanout.Card.{ .read = sink.read, .now = card.now, .write = logWrite }
    port = aux.Port.{ .card = &outCard, .write = sink.auxWrite }
    channel = aux.Channel.open(&port, sink.channel, sink.line)
    memory = known()
    scanout.report(&outCard, &memory, &readout)
    remember()
    var said: ?*const dplink.Heard = null
    if asking {
        dplink.ask(&channel, &heard)
        said = &heard
    }
    mode.makeWith(&outCard, &readout, &memory, monitor, &offer, &facts, wish, said, &plan)
    mode.say(&outCard, &plan)
    mode.list(&outCard, &plan)
    sink.forget()
}

// The plan carried out (or not), lent the tables and the channel.
fn carry(asked: bool) -> bool {
    const hands = set.Hands.{ .write = sink.write, .clear = card.clear }
    const lent = set.Tables.{ .machine = &machine, .hands = sink.hands(), .aside = card.setAside }
    return set.attemptLink(&outCard, &hands, &lent, &channel, &plan, asked, &result)
}

// The machine of the file's head made anew with nothing wrong: the
// firmware's link at `code` on `lanes` lanes, a monitor of DisplayPort
// 1.2 that can 5.4 Gbit/s on 4 lanes and pattern 3, a card whose ROM
// allows 5.4 Gbit/s.
fn machineWith(name: []const u8, code: usize, lanes: usize) -> void {
    sink.reset()
    if show {
        say("-- ")
        say(name)
        say("\n")
    }
    open(0x02, card.Ending.plain)
    sink.monitor(0x12, 0x14, 4, true)
    sink.firmware(0, 2, code, lanes)
}

// The same, and the plan for the wide monitor, the monitor asked.
fn again(name: []const u8, code: usize, lanes: usize) -> void {
    machineWith(name, code, lanes)
    const monitor = wide()
    make(&monitor, mode.Wish.own, true)
}

// An event of the list (the card's writes, the tables' words in the mail
// registers and their runs, the monitor's transactions) as two numbers.
// A write: the register and the word. A transaction that writes the
// monitor's registers: W and the address, then how many bytes in the
// top byte and the bytes from the low end; one that reads them: R and
// the address, then the length.
const W: usize = 0x1000000
const R: usize = 0x2000000
const OTHER: usize = 0x4000000

fn eventOf(k: usize, second: bool) -> usize {
    if card.writtenTo[k] != sink.EVENT { return if second { card.writtenWith[k] } else { card.writtenTo[k] } }
    const t = card.writtenWith[k]
    const command = @intCast(usize, sink.headOf[t]) >> 4
    const length = if sink.lengthOf[t] == sink.NEVER { 0 } else { sink.lengthOf[t] }
    if command == 0x9 { return if second { length } else { R + sink.addressOf[t] } }
    if command != 0x8 { return if second { length } else { OTHER + sink.addressOf[t] } }
    if !second { return W + sink.addressOf[t] }
    var bytes: usize = 0
    var j: usize = 0
    while j < length && j < 7 {
        bytes = bytes | (@intCast(usize, sink.dataOf[t * 16 + j]) << @intCast(u6, 8 * j))
        j += 1
    }
    return (length << 56) | bytes
}

// The events from number `from` on against a sequence worked out by
// hand; all of them to the list's end when `whole`. Where the sequence
// ends in the list.
fn sameEvents(name: []const u8, from: usize, pairs: []const usize, whole: bool) -> usize {
    const out = scanout.Card.{ .read = sink.read, .now = card.now, .write = say }
    var k: usize = 0
    while k * 2 + 1 < pairs.length && from + k < card.written {
        const first = eventOf(from + k, false)
        const second = eventOf(from + k, true)
        if first != pairs[k * 2] || second != pairs[k * 2 + 1] {
            say("not as expected: ")
            say(name)
            out.field(": event ", k + 1)
            say(" is ")
            out.hexDigits(first, 8)
            say(" = ")
            out.hexDigits(second >> 32, 8)
            out.hexDigits(second & 0xFFFFFFFF, 8)
            say(", worked out ")
            out.hexDigits(pairs[k * 2], 8)
            say(" = ")
            out.hexDigits(pairs[k * 2 + 1] >> 32, 8)
            out.hexDigits(pairs[k * 2 + 1] & 0xFFFFFFFF, 8)
            say("\n")
            if failed == 0 { failed = 3 }
            return from + k
        }
        k += 1
    }
    if k * 2 < pairs.length || (whole && card.written != from + pairs.length / 2) {
        say("not as expected: ")
        say(name)
        out.field(": ", card.written - from)
        out.field(" events, worked out ", pairs.length / 2)
        say("\n")
        if failed == 0 { failed = 3 }
    }
    return from + k
}

// How many of the events from `from` to `until` are runs of the
// transmitter's table with this action (0 off, 1 on, 11 the drive).
fn runsOf(action: usize, from: usize, until: usize) -> usize {
    var count: usize = 0
    var k = from
    while k + 4 < until && k + 4 < card.written {
        if card.writtenTo[k] == card.MAIL && card.writtenByTable[k] && card.writtenTo[k + 4] == card.GO && card.writtenWith[k + 4] == 76 && (card.writtenWith[k] >> 8) & 0xFF == action { count += 1 }
        k += 1
    }
    return count
}

// The whole change from 1.62 Gbit/s on 2 lanes to 2.7 Gbit/s on 4 lanes,
// from the document of the sequence (its step names in brackets):
// controller 0, front end 2 (the block at 0x4c00), back end 1 (0x4b00),
// the connector's kind 0x13 on hot plug line 2. A table's run is the
// words of its block in the mail registers 0x7f00 on, then the table's
// place in the ROM's list in 0x7f10.
const THERE = [_]usize{
    // [P1] dce110_set_safe_displaymarks: each set chosen (the field into
    // the word as it stands, 0x00010100), its marks at their highest.
    0x1B32, 0x00010000, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010100, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010200, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010300, 0x1B33, 0xFFFFFFFF,
    // [P3] Before the first table: scratch word 6 (0x10) with bit 29
    // set, word 2 (0x20010005) without bits 29 and 16.
    0x05CF, 0x20000010, 0x05CB, 0x00000005,
    // [Q1] dce110_stream_encoder_dp_blank on front end 2: the stop put
    // off to a frame's end (DP_VID_STREAM_DIS_DEFER 2 into 0x10001), the
    // stream disabled, then (after its state) the steer FIFO's reset.
    0x4CA4, 0x00010201, 0x4CA4, 0x00010200, 0x4CA5, 0x00000001,
    // [D1] The monitor told its power state D3.
    W + 0x600, (1 << 56) | 0x02,
    // [D2] UNIPHYTransmitterControl, DISABLE: 01 | 00 | 00 | 00 | 00 00
    // 00 00 | 02 | 00 | 13 | 00 | 00 00 00 00.
    0x7F00, 0x00000001, 0x7F01, 0x00000000, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    // [D3] link_encoder_disable: the pattern word 0, "trained" 0 (of
    // 0x10); the panel mode word reads 0 and is not written.
    0x4BB0, 0x00000000, 0x4BA0, 0x00000000,
    // [D4] Front end 2 off back end 1: bit 10 of DIG_BE_CNTL
    // (0x10000400).
    0x4B47, 0x10000000,
    // [Q2] dce110_tg_set_blank(true).
    0x1BB6, 0x00010000, 0x1B9D, 0x00000100,
    // [E0] The critical state bit into scratch word 6.
    0x05CF, 0x20000110,
    // [C] The DTO's phase for 266.64 MHz; the timing (4000 by 1111: the
    // totals less one, the most and the fewest lines, the blankings
    // 112..3952 and 28..1108, the pulses 32 and 10, the frame's the low
    // one), no pixel counted twice, the rows asked for 4 lines early
    // with the prefetch.
    0x0141, 0x0FE49A80,
    0x1B80, 0x00000F9F, 0x1B87, 0x00000456, 0x1B89, 0x00000456, 0x1B88, 0x00000456,
    0x1B81, 0x00700F70, 0x1B8D, 0x001C0454,
    0x1B82, 0x00200000, 0x1B83, 0x00000000, 0x1B8E, 0x000A0000, 0x1B8F, 0x00000001,
    0x1BA9, 0x00000000, 0x1BB3, 0x00004007,
    // [E1, E2] The back end's mode 0; front end 2 on it again.
    0x4B47, 0x10000000, 0x4B47, 0x10000400,
    // [E3] The lanes' count less one; the scrambler's advance (it is set:
    // 0x0001ff10).
    0x4BA3, 0x00000003, 0x4BB6, 0x0001FF10,
    // [E4] UNIPHYTransmitterControl, ENABLE: 01 | 01 | 00 | 04 | 78 69 00
    // 00 | 02 | 00 | 13 | 00 | 00 00 00 00 (27000 tens of kHz).
    0x7F00, 0x04000101, 0x7F01, 0x00006978, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    // [E5] The monitor told D0; [E6] its panel mode word read (each
    // read of the monitor's registers has the read of one byte at their
    // start before it); the training's wait read twice (revision 1.2).
    W + 0x600, (1 << 56) | 0x01,
    R + 0x000, 1, R + 0x10A, 1,
    R + 0x000, 1, R + 0x00E, 1,
    R + 0x000, 1, R + 0x00E, 1,
    // [T0] No pattern; 8b/10b; downspread; 4 lanes with enhanced
    // framing; the rate.
    W + 0x102, (1 << 56) | 0x00, W + 0x108, (1 << 56) | 0x01, W + 0x107, (1 << 56) | 0x10, W + 0x101, (1 << 56) | 0x84, W + 0x100, (1 << 56) | 0x0A,
    // [T1] The card sends pattern 1: the pattern word 0, "trained" 0, the
    // bypass off, no test sequence. One round: the drive a lane (01 | 0b
    // | 00 | 04 | 78 69 00 00 | 02 | 00 | 13 | ...), the monitor told
    // pattern 1 without scrambling and four drive bytes in one write,
    // its status read.
    0x4BB0, 0x00000000, 0x4BA0, 0x00000000, 0x4BAF, 0x00000000, 0x4BB5, 0x00000000,
    0x7F00, 0x04000B01, 0x7F01, 0x00006978, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x04000B01, 0x7F01, 0x00006978, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x04000B01, 0x7F01, 0x00006978, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x04000B01, 0x7F01, 0x00006978, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    W + 0x102, (5 << 56) | 0x21,
    R + 0x000, 1, R + 0x202, 6,
    // [T2] Pattern 3: the pattern word 2. One round.
    0x4BB0, 0x00000002, 0x4BA0, 0x00000000, 0x4BAF, 0x00000000, 0x4BB5, 0x00000000,
    0x7F00, 0x04000B01, 0x7F01, 0x00006978, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x04000B01, 0x7F01, 0x00006978, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x04000B01, 0x7F01, 0x00006978, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x04000B01, 0x7F01, 0x00006978, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    W + 0x102, (5 << 56) | 0x23,
    R + 0x000, 1, R + 0x202, 6,
    // [T3] The monitor's pattern off.
    W + 0x102, (1 << 56) | 0x00,
    // [T4] The card to its idle pattern: the framing (an idle interval
    // of 0x2000, the enhanced one), the scrambler's count 0x1ff,
    // "trained", the bypass off, no test sequence.
    0x4BAB, 0x10002000, 0x4BB6, 0x0001FF10, 0x4BA0, 0x00000010, 0x4BAF, 0x00000000, 0x4BB5, 0x00000000,
    // [T5] After 5 ms the six bytes from 200h.
    R + 0x000, 1, R + 0x200, 6,
    // [U1] The mode and the front end once more; dce110_enable_stream:
    // the early blanking for the 4 lanes trained (3840 is a multiple of
    // 4: the lanes' count) into 0x00010001.
    0x4B47, 0x10000400, 0x4B47, 0x10000400,
    0x1B9C, 0x00410001,
    // [U2] dce110_stream_encoder_dp_unblank: M and N held, N 0x8000, M
    // for 266.64 over 270 MHz (0x7e68), the generator on, DIG_START, the
    // steer FIFO out of reset, the stream enabled.
    0x4CA8, 0x00000000, 0x4CA9, 0x00008000, 0x4CAA, 0x00007E68, 0x4CA8, 0x00000100, 0x4C00, 0x00000400, 0x4CA5, 0x00000000, 0x4CA4, 0x00000201,
    // [E0'] The critical state bit out of scratch word 6.
    0x05CF, 0x20000010,
    // [S] A pixel's duration (3750 ps); four buffers; the scaler off;
    // the surface of 3840x1080 at 0x500000 of the card's memory; the
    // picture shown; the mark set chosen as it was.
    0x1B30, 0x00010EA6, 0x0321, 0x00000014,
    0x1AC1, 0x000006B0, 0x1B53, 0x00000000, 0x1B5E, 0x00000000, 0x1B5F, 0x00000000, 0x1B45, 0x00000000, 0x1B42, 0x00000000, 0x1B5C, 0x00000000, 0x1B5D, 0x0F000438,
    0x1A11, 0x00010000, 0x1A00, 0x00000001, 0x1A09, 0x00000000, 0x1A0A, 0x00000000, 0x1A0B, 0x00000000, 0x1A0C, 0x00000000, 0x1A0D, 0x00000F00, 0x1A0E, 0x00000438, 0x1A06, 0x00000F00, 0x1AC3, 0x00000438,
    0x1A12, 0x00000000, 0x1A07, 0x000000F4, 0x1A08, 0x000000F4, 0x1A04, 0x00500000, 0x1A05, 0x00500000, 0x1A11, 0x00000000,
    0x1BB6, 0x00010000, 0x1B9D, 0x00000000,
    0x1B32, 0x00010100,
    // [J] After the frames were counted: the monitor's lanes once more.
    R + 0x000, 1, R + 0x202, 6,
}

// The way back from there to the firmware's 1.62 Gbit/s on 2 lanes: the
// same sequence towards the firmware's state.
const BACK = [_]usize{
    // The scratch words as for every table (they are so already); the
    // stream stopped (it runs: 0x00010201).
    0x05CF, 0x20000010, 0x05CB, 0x00000005,
    0x4CA4, 0x00010201, 0x4CA4, 0x00010200, 0x4CA5, 0x00000001,
    // The link down: D3, the transmitter off, the pattern word, "trained".
    W + 0x600, (1 << 56) | 0x02,
    0x7F00, 0x00000001, 0x7F01, 0x00000000, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x4BB0, 0x00000000, 0x4BA0, 0x00000000,
    0x4B47, 0x10000000,
    0x1BB6, 0x00010000, 0x1B9D, 0x00000100,
    0x05CF, 0x20000110,
    // The firmware's clock and timing: 108 MHz, 1800 by 1000, its own
    // words for the rest.
    0x0141, 0x066FF300,
    0x1B80, 0x00000707, 0x1B87, 0x000003E7, 0x1B89, 0x00000000, 0x1B88, 0x00000000,
    0x1B81, 0x01A806A8, 0x1B8D, 0x002703E7,
    0x1B82, 0x00700000, 0x1B83, 0x00000000, 0x1B8E, 0x00030000, 0x1B8F, 0x00000000,
    0x1BA9, 0x00000000, 0x1BB3, 0x00003101,
    0x4B47, 0x10000000, 0x4B47, 0x10000400,
    // The firmware's own link: 2 lanes, the transmitter on at 16200 tens
    // of kHz (01 | 01 | 00 | 02 | 48 3f 00 00 | ...), the monitor told 2
    // lanes at the rate 0x06, a round each with the drive twice.
    0x4BA3, 0x00000001, 0x4BB6, 0x0001FF10,
    0x7F00, 0x02000101, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    W + 0x600, (1 << 56) | 0x01,
    R + 0x000, 1, R + 0x10A, 1,
    R + 0x000, 1, R + 0x00E, 1,
    R + 0x000, 1, R + 0x00E, 1,
    W + 0x102, (1 << 56) | 0x00, W + 0x108, (1 << 56) | 0x01, W + 0x107, (1 << 56) | 0x10, W + 0x101, (1 << 56) | 0x82, W + 0x100, (1 << 56) | 0x06,
    0x4BB0, 0x00000000, 0x4BA0, 0x00000000, 0x4BAF, 0x00000000, 0x4BB5, 0x00000000,
    0x7F00, 0x02000B01, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x02000B01, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    W + 0x102, (3 << 56) | 0x21,
    R + 0x000, 1, R + 0x202, 6,
    0x4BB0, 0x00000002, 0x4BA0, 0x00000000, 0x4BAF, 0x00000000, 0x4BB5, 0x00000000,
    0x7F00, 0x02000B01, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x02000B01, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    W + 0x102, (3 << 56) | 0x23,
    R + 0x000, 1, R + 0x202, 6,
    W + 0x102, (1 << 56) | 0x00,
    0x4BAB, 0x10002000, 0x4BB6, 0x0001FF10, 0x4BA0, 0x00000010, 0x4BAF, 0x00000000, 0x4BB5, 0x00000000,
    R + 0x000, 1, R + 0x200, 6,
    // The mode and the front end once more, and the early blanking as
    // the firmware had it, where the plan wrote it.
    0x4B47, 0x10000400, 0x4B47, 0x10000400,
    0x1B9C, 0x00010001,
    // The stream with the firmware's own N and M (0x5555: 108 over 162
    // MHz); the critical state out; the two scratch words whole.
    0x4CA8, 0x00000000, 0x4CA9, 0x00008000, 0x4CAA, 0x00005555, 0x4CA8, 0x00000100, 0x4C00, 0x00000400, 0x4CA5, 0x00000000, 0x4CA4, 0x00000201,
    0x05CF, 0x20000010,
    0x05CF, 0x00000010, 0x05CB, 0x20010005,
    // The firmware's picture: its words for the duration, the buffers,
    // the scaler and the surface, shown.
    0x1B30, 0x0001242B, 0x0321, 0x00000012,
    0x1AC1, 0x001006B0, 0x1B53, 0x00000011, 0x1B5E, 0x00000000, 0x1B5F, 0x00000000, 0x1B45, 0x00000000, 0x1B42, 0x00000000, 0x1B5C, 0x00000000, 0x1B5D, 0x050003C0,
    0x1A11, 0x00010000, 0x1A00, 0x00000001, 0x1A09, 0x00000000, 0x1A0A, 0x00000000, 0x1A0B, 0x00000000, 0x1A0C, 0x00000000, 0x1A0D, 0x00000500, 0x1A0E, 0x000003C0, 0x1A06, 0x00000500, 0x1AC3, 0x000003C0,
    0x1A12, 0x00000001, 0x1A07, 0x000000F4, 0x1A08, 0x00000000, 0x1A04, 0x00000000, 0x1A05, 0x00000000, 0x1A11, 0x00000000,
    0x1BB6, 0x00000100, 0x1B9D, 0x00000000,
    // The urgency marks, each set what it held, the set chosen as it
    // was.
    0x1B32, 0x00010000, 0x1B33, 0x00FA0030,
    0x1B32, 0x00010100, 0x1B33, 0x00FA0040,
    0x1B32, 0x00010200, 0x1B33, 0x00000000,
    0x1B32, 0x00010300, 0x1B33, 0x00000000,
    0x1B32, 0x00010100,
    // Every register held against the firmware's once more: the
    // stream's word still says that a stop is put off to a frame's end
    // (the firmware's did not).
    0x4CA4, 0x00010001,
    // The monitor's lanes on the firmware's link.
    R + 0x000, 1, R + 0x202, 6,
}

// A link that has room (2.7 Gbit/s on 4 lanes) kept: what stood before
// there was a way to ask, and the monitor's lanes read afterwards.
const KEPT = [_]usize{
    0x1B32, 0x00010000, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010100, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010200, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010300, 0x1B33, 0xFFFFFFFF,
    0x4CA4, 0x00010201, 0x4CA4, 0x00010200, 0x4CA5, 0x00000001,
    0x1BB6, 0x00010000, 0x1B9D, 0x00000100,
    0x0141, 0x0FE49A80,
    0x1B80, 0x00000F9F, 0x1B87, 0x00000456, 0x1B89, 0x00000456, 0x1B88, 0x00000456,
    0x1B81, 0x00700F70, 0x1B8D, 0x001C0454,
    0x1B82, 0x00200000, 0x1B83, 0x00000000, 0x1B8E, 0x000A0000, 0x1B8F, 0x00000001,
    0x1BA9, 0x00000000, 0x1BB3, 0x00004007,
    0x1B9C, 0x00410001,
    0x4CA8, 0x00000000, 0x4CA9, 0x00008000, 0x4CAA, 0x00007E68, 0x4CA8, 0x00000100, 0x4C00, 0x00000400, 0x4CA5, 0x00000000, 0x4CA4, 0x00010201,
    0x1B30, 0x00010EA6, 0x0321, 0x00000014,
    0x1AC1, 0x000006B0, 0x1B53, 0x00000000, 0x1B5E, 0x00000000, 0x1B5F, 0x00000000, 0x1B45, 0x00000000, 0x1B42, 0x00000000, 0x1B5C, 0x00000000, 0x1B5D, 0x0F000438,
    0x1A11, 0x00010000, 0x1A00, 0x00000001, 0x1A09, 0x00000000, 0x1A0A, 0x00000000, 0x1A0B, 0x00000000, 0x1A0C, 0x00000000, 0x1A0D, 0x00000F00, 0x1A0E, 0x00000438, 0x1A06, 0x00000F00, 0x1AC3, 0x00000438,
    0x1A12, 0x00000000, 0x1A07, 0x000000F4, 0x1A08, 0x000000F4, 0x1A04, 0x00500000, 0x1A05, 0x00500000, 0x1A11, 0x00000000,
    0x1BB6, 0x00010000, 0x1B9D, 0x00000000,
    0x1B32, 0x00010100,
    R + 0x000, 1, R + 0x202, 6,
}

// The firmware's own link (1.62 Gbit/s on 2 lanes) taken down and
// trained again: no marks, no clock, no timing, no picture's words; the
// stream with the firmware's own N and M; the picture shown again.
const REHEARSAL = [_]usize{
    0x05CF, 0x20000010, 0x05CB, 0x00000005,
    0x4CA4, 0x00010201, 0x4CA4, 0x00010200, 0x4CA5, 0x00000001,
    W + 0x600, (1 << 56) | 0x02,
    0x7F00, 0x00000001, 0x7F01, 0x00000000, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x4BB0, 0x00000000, 0x4BA0, 0x00000000,
    0x4B47, 0x10000000,
    0x1BB6, 0x00010000, 0x1B9D, 0x00000100,
    0x05CF, 0x20000110,
    0x4B47, 0x10000000, 0x4B47, 0x10000400,
    0x4BA3, 0x00000001, 0x4BB6, 0x0001FF10,
    0x7F00, 0x02000101, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    W + 0x600, (1 << 56) | 0x01,
    R + 0x000, 1, R + 0x10A, 1,
    R + 0x000, 1, R + 0x00E, 1,
    R + 0x000, 1, R + 0x00E, 1,
    W + 0x102, (1 << 56) | 0x00, W + 0x108, (1 << 56) | 0x01, W + 0x107, (1 << 56) | 0x10, W + 0x101, (1 << 56) | 0x82, W + 0x100, (1 << 56) | 0x06,
    0x4BB0, 0x00000000, 0x4BA0, 0x00000000, 0x4BAF, 0x00000000, 0x4BB5, 0x00000000,
    0x7F00, 0x02000B01, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x02000B01, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    W + 0x102, (3 << 56) | 0x21,
    R + 0x000, 1, R + 0x202, 6,
    0x4BB0, 0x00000002, 0x4BA0, 0x00000000, 0x4BAF, 0x00000000, 0x4BB5, 0x00000000,
    0x7F00, 0x02000B01, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    0x7F00, 0x02000B01, 0x7F01, 0x00003F48, 0x7F02, 0x00130002, 0x7F03, 0x00000000, 0x7F10, 76,
    W + 0x102, (3 << 56) | 0x23,
    R + 0x000, 1, R + 0x202, 6,
    W + 0x102, (1 << 56) | 0x00,
    0x4BAB, 0x10002000, 0x4BB6, 0x0001FF10, 0x4BA0, 0x00000010, 0x4BAF, 0x00000000, 0x4BB5, 0x00000000,
    R + 0x000, 1, R + 0x200, 6,
    0x4B47, 0x10000400, 0x4B47, 0x10000400,
    0x4CA8, 0x00000000, 0x4CA9, 0x00008000, 0x4CAA, 0x00005555, 0x4CA8, 0x00000100, 0x4C00, 0x00000400, 0x4CA5, 0x00000000, 0x4CA4, 0x00000201,
    0x05CF, 0x20000010,
    0x1BB6, 0x00010000, 0x1B9D, 0x00000000,
    R + 0x000, 1, R + 0x202, 6,
}

// What the asking alone sends: is the monitor awake (600h), its first
// sixteen registers, what it holds (100h and 101h, 107h, 202h to 207h);
// each read with the read of one byte at the registers' start before it.
const ASKING = [_]usize{
    R + 0x000, 1, R + 0x600, 1,
    R + 0x000, 1, R + 0x000, 16,
    R + 0x000, 1, R + 0x100, 2,
    R + 0x000, 1, R + 0x107, 1,
    R + 0x000, 1, R + 0x202, 6,
}

// A monitor that is hard to train at the new rate (2.7 Gbit/s) alone:
// its lanes ask for one step of swing more each round until 2, and for a
// step of pre-emphasis; at the firmware's rate it trains at once.
fn hard() -> void {
    sink.faultRate = 0x0A
    sink.stepwise = true
    sink.lockAfter = 2
    var k: usize = 0
    while k < 4 {
        sink.needSwing[k] = 2
        sink.needPre[k] = 1
        k += 1
    }
}

// After a change that failed: the firmware's state is back, said so and
// in fact (every register, the channel's words, the monitor's link).
fn back(name: []const u8, code: usize, lanes: usize) -> void {
    channel.end()
    const fine = result.outcome == set.Outcome.back && asBefore() && auxAsBefore() && monitorHolds(code, lanes)
    if !fine && !show {
        say("in: ")
        say(name)
        say("\n")
    }
    expect(result.outcome == set.Outcome.back, "after a failure: said to be back")
    expect(asBefore(), "after a failure: every register as it was")
    expect(auxAsBefore(), "after a failure: the AUX channel's words as they were")
    expect(monitorHolds(code, lanes), "after a failure: the monitor holds the firmware's link, locked")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    const out = scanout.Card.{ .read = sink.read, .now = card.now, .write = say }

    // ---- A link that is too slow: taken down and trained.
    again("a link that is too slow, trained at 2.70 Gbit/s on 4 lanes", 0x06, 2)
    expect(plan.complete && plan.situation == mode.Situation.displayport && plan.dp.case == mode.LinkCase.retrain && plan.dp.asked && plan.dp.trainable, "too slow: the link is to be trained again")
    expect(plan.dp.firmware.code == 0x06 && plan.dp.firmware.lanes == 2 && plan.dp.target.code == 0x0A && plan.dp.target.lanes == 4 && plan.dp.most.code == 0x14 && plan.dp.most.lanes == 4 && plan.dp.next.code == 0x14 && plan.dp.next.lanes == 2, "too slow: 2.70 Gbit/s on 4 lanes, next 5.40 on 2")
    expect(plan.offset == 0x500000 && plan.dp.channel == 1 && plan.dp.output.line == 2 && plan.dp.output.backEnd == 1 && plan.dp.output.connector == 0x13 && plan.dp.output.pattern == 3, "too slow: the output as the ROM has it")
    line("gpu: plan (b, DisplayPort): the link has 2 lanes at 1.62 Gbit/s (by M 0x5555 over N 0x8000), room for 108000 kHz at 24 bits: 266640 kHz does not fit\n")
    line("gpu: plan (b, DisplayPort): the link is too slow: it is taken down and trained at 2.70 Gbit/s on 4 lanes (the lowest rate and the fewest lanes that carry 266640 kHz; the most both ends have is 5.40 Gbit/s on 4 lanes; the next that would do is 5.40 Gbit/s on 2 lanes)\n")
    line("gpu: DIG 1 is UNIPHY B; the ROM puts a connector of the kind \"DisplayPort\" behind it: AUX 1 (DDC line 2), hot plug line 2; both ends have up to 5.40 Gbit/s on 4 lanes\n")
    line("gpu: the display clock is 600000 kHz (the ROM's own figure 625000 kHz): 266640 kHz needs 321967, which it is\n")
    line("gpu: would take the link down (the link taken down)\ngpu:   the monitor told its power state D3 (AUX write 600h = 02)\ngpu:   table UNIPHYTransmitterControl, transmitter 1 off (when the back end reads on): 01 00 00 00 00 00 00 00 02 00 13 00 00 00 00 00\n")
    line("gpu: would train the link at 2.70 Gbit/s on 4 lanes (the link brought up and trained)\ngpu:   the lanes' count (4) and the scrambler's start in the back end\ngpu:   table UNIPHYTransmitterControl, transmitter 1 on: 01 01 00 04 78 69 00 00 02 00 13 00 00 00 00 00\n")
    line("gpu:   the monitor told the link: 102h = 00, 108h = 01, 107h = 10, 101h = 84, 100h = 0a\n")
    line("the first: 01 0b 00 04 78 69 00 00 02 00 13 00 00 00 00 00), the monitor told, 100 us or 400 us, its status read")
    line("gpu: on the way back would take the link down (the link taken down)\ngpu: on the way back would train the link at 1.62 Gbit/s on 2 lanes (the firmware's own link brought up and trained)\n")
    expect(card.written == 0 && sink.transactions == 0 && sink.strayWrites == 0, "the plan: nothing written for it")
    // A boot that keeps the firmware's picture: nothing at all.
    expect(!carry(false) && card.written == 0 && card.runs == 0 && sink.transactions == 0 && sink.auxWritten == 0 && card.cleared == 0 && result.outcome == set.Outcome.untouched, "the firmware's picture kept: no write, no table, no transaction")
    line("gpu: nothing is written to the card and none of its tables is run: this boot keeps the firmware's picture\n")
    // Without the monitor's channel lent, or the card's tables: nothing.
    {
        const hands = set.Hands.{ .write = sink.write, .clear = card.clear }
        const lent = set.Tables.{ .machine = &machine, .hands = sink.hands(), .aside = card.setAside }
        expect(!set.attemptLink(&outCard, &hands, &lent, null, &plan, true, &result) && card.written == 0 && card.runs == 0 && sink.transactions == 0 && result.outcome == set.Outcome.untouched, "without the channel lent: no write, no table, no transaction")
        line("gpu: the monitor's own mode is not set, the firmware's picture stays: the monitor's AUX channel is not lent\n")
        expect(!set.attemptLink(&outCard, &hands, null, &channel, &plan, true, &result) && card.written == 0 && sink.transactions == 0, "without the tables lent: no write")
        line("gpu: the monitor's own mode is not set, the firmware's picture stays: the card's tables are not lent\n")
    }
    const saidBefore = card.logged
    expect(carry(true), "too slow: the change comes through")
    _ = sameEvents("the retrain", 0, THERE[0..], true)
    expect(result.outcome == set.Outcome.done && result.trainings == 1 && result.trainingsBack == 0 && result.runs == 10 && result.course.tries == 1 && result.course.clockRounds == 1 && result.course.equaliseRounds == 1 && result.locked, "too slow: one training of a round each, ten table runs")
    expect(monitorHolds(0x0A, 4) && @intCast(usize, sink.dpcd[0x107]) == 0x10 && @intCast(usize, sink.dpcd[0x108]) == 0x01, "too slow: the monitor holds 2.70 Gbit/s on 4 lanes")
    expect(card.cleared == 1 && card.clearedAt == 0x500000 && !card.writtenBeforeClear, "too slow: the new picture's memory cleared first")
    line("gpu: train 2.70x4, clock recovery, round 1: drive swing 0 pre 0; lanes 1 1 1 1, aligned 0, asked swing 0 0 0 0 pre 0 0 0 0\n")
    line("gpu: train 2.70x4, equalisation, round 1: drive swing 0 pre 0; lanes 7 7 7 7, aligned 1, asked swing 0 0 0 0 pre 0 0 0 0\n")
    line("gpu: train 2.70x4: trained in 1 + 1 rounds with pattern 3 at swing 0 pre 0; holds after 5 ms (try 1 of 4, ")
    line("gpu: transmitter 1 on at 2.70 Gbit/s on 4 lanes: the table left DIG 1 on, mode 0, front ends 0x4, lanes 4\n")
    line("gpu: the lanes' drive table ran 7 more times, each as the run said\n")
    line("gpu: the monitor's lanes are locked after the change (status 77 77 01 01 00 00; it says its port is in sync)\n")
    line("gpu: controller 0 shows a picture of 3840x1080 as it is, 60.000 frames a second: the monitor's own mode is set, on a link trained at 2.70 Gbit/s on 4 lanes (10 table runs, 89 writes, each read back)\n")
    // The longest dark time is said before the first write, and holds.
    const bound = card.after("gpu: setting the monitor's own mode on a link trained for it: carrying out the plan's 72 writes and the link's own steps (said as they run); the screen is dark meanwhile, ", saidBefore)
    expect(bound != card.NEVER && bound < card.after("gpu: 4ca4 & 00010000 is 00000000", saidBefore), "the longest dark time said before the first write")
    expect(result.longest >= 4 * dplink.TRY_TIME && result.longestBack >= 4 * dplink.TRY_TIME && card.clock < result.longest, "the bound holds the trainings' own")
    // (A round runs the drive table once a lane: four lanes there, two
    // on the way back, four tries of a round beyond the try's own time
    // each, a table given two seconds.)
    expect(result.longest >= result.longestBack + 4 * 2 * 2000000000, "the bound counts a table's run for every lane")
    // The waits the driver made: 100 us before the status in clock
    // recovery, 400 us in the equalisation, 5 ms before the lanes are
    // read once more, 1 ms after the monitor was woken.
    expect(sink.leastClockWait >= 100000 && sink.leastClockWait < 400000 && sink.leastEqualiseWait >= 400000 && sink.holdsWaited >= 5000000 && sink.wokeWaited >= 1000000, "the training's waits")
    // And the link was down for a tenth of a second at least.
    expect(sink.leastOff >= 100000000 && sink.leastOff != sink.NEVER, "the link down for a tenth of a second")
    line("gpu: would wait 100000 us (the monitor sees the link gone)\n")

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- The way back: the monitor loses the new link under the picture
    // (at the fourth read of its lanes: the one after the frames).
    again("the monitor loses the new link under the picture", 0x06, 2)
    sink.dropsAtRead = 3
    expect(!carry(true) && result.reason == set.Reason.monitor && result.trainings == 1 && result.trainingsBack == 1, "lost under the picture: not done, the firmware's link trained again")
    const turn = sameEvents("the change before the way back", 0, THERE[0..], false)
    _ = sameEvents("the way back", turn, BACK[0..], true)
    line("gpu: the monitor's lanes are NOT all locked after the change (status 00 00 00 00 00 00; it does not say its port is in sync)\n")
    line("gpu: the monitor's lanes are not locked on the new link with the picture on it\n")
    line("gpu: putting the firmware's state back (the link down, the firmware's clock and timing, the link trained at its own 1.62 Gbit/s on 2 lanes, its stream)\n")
    line("gpu: train 1.62x2: trained in 1 + 1 rounds with pattern 3 at swing 0 pre 0; holds after 5 ms (try 1 of 4, ")
    line("gpu: the monitor's lanes are locked with the firmware's state back (status 77 00 01 01 00 00; it says its port is in sync)\n")
    line(" table runs and a training at the firmware's own 1.62 Gbit/s on 2 lanes: the lanes' drive is that training's, not what the firmware's own ended with); the controller counts frames (60.000 a second, as before)\n")
    line("gpu: the firmware's state is back (")
    back("lost under the picture", 0x06, 2)

    // A firmware whose framing word is another than the training's: said
    // after the way back, and not called the firmware's.
    again("a firmware with another framing word", 0x06, 2)
    card.store(0x4BAB, 0x00002000)
    remember()
    sink.dropsAtRead = 3
    expect(!carry(true) && result.linkWords == 1 && result.outcome == set.Outcome.back, "another framing word: one link word differs after the way back")
    line("gpu: DIG 1's framing word holds 0x10002000 where the firmware had 0x2000 (the training's own value)\n")
    line("; 1 of the back end's link words holds the training's value where the firmware had another (said above)")

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- Every rate and count of lanes: a monitor that has just that
    // much, a clock that just that carries (below the DTO's 600 MHz),
    // from a firmware's link of one lane at 1.62 Gbit/s.
    for code in dplink.RATES {
        for lanes in dplink.LANE_COUNTS {
            if code == 0x06 && lanes == 1 { continue }
            // (The display engine's 600 MHz are enough for a pixel clock
            // of 490 MHz.)
            var room = code * 27000 * 8 * lanes / 24
            if room > 490000 { room = 490000 }
            // (8.1 Gbit/s on 4 lanes is first for no such clock: it is
            // trained as a firmware's own link below.)
            if code == 0x1E && lanes == 4 { continue }
            machineWith("a rate and a count of lanes", 0x06, 1)
            open(0x0A, card.Ending.plain)
            sink.monitor(0x14, code, lanes, true)
            var monitor = wide()
            monitor.timing.clock = room
            make(&monitor, mode.Wish.own, true)
            const fine = plan.complete && plan.dp.case == mode.LinkCase.retrain && plan.dp.target.code == code && plan.dp.target.lanes == lanes && carry(true) && monitorHolds(code, lanes)
            if !fine {
                out.fieldHex("at the rate ", code)
                out.field(" on lanes ", lanes)
                say("\n")
            }
            expect(fine, "a rate and a count of lanes: planned, trained, held by the monitor")
            // The transmitter told the rate in tens of kHz and the lanes;
            // the drive once a lane in each of the two rounds; the lanes'
            // count less one; the early blanking; M.
            var on: usize = 0
            while on + 4 < card.written && !(card.writtenTo[on] == card.MAIL && (card.writtenWith[on] >> 8) & 0xFF == 1 && card.writtenByTable[on]) { on += 1 }
            expect(on + 4 < card.written && card.writtenWith[on] == (0x00000101 | (lanes << 24)) && card.writtenWith[on + 1] == code * 2700 && card.writtenWith[on + 2] == 0x00130002, "a rate and a count of lanes: the transmitter's block")
            expect(runsOf(0, 0, card.written) == 1 && runsOf(1, 0, card.written) == 1 && runsOf(11, 0, card.written) == 2 * lanes, "a rate and a count of lanes: the table's runs")
            expect(card.raw(0x4BA3) == lanes - 1 && (card.raw(0x1B9C) >> 20) & 7 == (if 3840 % lanes != 0 { 3840 % lanes } else { lanes }) && card.raw(0x4CAA) == 0x8000 * room / (code * 27000), "a rate and a count of lanes: the lanes, the early blanking, M")
        }
    }

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- A link that is not trained.
    again("the card says the link is not trained", 0x06, 2)
    card.store(0x4BA0, 0)
    const monitor = wide()
    make(&monitor, mode.Wish.own, true)
    expect(plan.complete && plan.dp.case == mode.LinkCase.train && plan.dp.target.code == 0x0A && plan.dp.target.lanes == 4, "not trained by the card's word: trained")
    line("gpu: plan (b, DisplayPort): the card says the link is not trained or its stream is off: it is trained at 2.70 Gbit/s on 4 lanes")
    expect(carry(true) && monitorHolds(0x0A, 4), "not trained by the card's word: comes through")
    _ = sameEvents("the training of a link that was not trained", 0, THERE[0..], true)

    again("the monitor holds nothing", 0x0A, 4)
    sink.dpcd[0x100] = 0
    sink.dpcd[0x101] = 0
    sink.clockOf[0] = false
    sink.lockOf[0] = false
    make(&monitor, mode.Wish.own, true)
    expect(plan.complete && plan.dp.case == mode.LinkCase.train && plan.dp.firmware.code == 0x0A && plan.dp.firmware.lanes == 4 && plan.dp.target.code == 0x0A && plan.dp.target.lanes == 4, "the monitor holds nothing: trained, the way back by the card's words")
    line("gpu: plan (b, DisplayPort): the monitor holds no link: it is trained at 2.70 Gbit/s on 4 lanes")
    expect(carry(true) && monitorHolds(0x0A, 4) && result.trainings == 1, "the monitor holds nothing: comes through")

    again("the monitor's lanes are not locked", 0x0A, 4)
    sink.lockOf[2] = false
    make(&monitor, mode.Wish.own, true)
    expect(plan.complete && plan.dp.case == mode.LinkCase.train, "lanes not locked: trained, not kept")
    line("gpu: the monitor holds 2.70 Gbit/s on 4 lanes, NOT all locked (status 77 71 00 01 00 00), power on\n")
    line("gpu: plan (b, DisplayPort): the monitor's lanes are not all locked: the link is trained at 2.70 Gbit/s on 4 lanes")
    expect(carry(true) && monitorHolds(0x0A, 4), "lanes not locked: comes through")

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- A link that has room: kept.
    again("a link that has room, kept", 0x0A, 4)
    expect(plan.complete && plan.dp.case == mode.LinkCase.keep && plan.dp.asked && plan.dp.trainable && plan.backCount != 0, "room: the link is kept, and could be trained again")
    line("gpu: plan (b, DisplayPort): the link has 4 lanes at 2.70 Gbit/s (by M 0x3333 over N 0x8000), room for 360000 kHz at 24 bits: 266640 kHz fits\n")
    line("gpu: plan (b, DisplayPort): the monitor holds the same link with every lane locked: it is kept\n")
    line("gpu: should the monitor lose the link, would train the link at 2.70 Gbit/s on 4 lanes (the firmware's own link brought up and trained)\n")
    expect(carry(true) && result.outcome == set.Outcome.done && result.runs == 0 && result.trainings == 0 && result.locked, "room: done by the registers alone")
    _ = sameEvents("the kept link", 0, KEPT[0..], true)
    expect(card.runs == 0 && monitorHolds(0x0A, 4), "room: no table run, the monitor holds its link")
    line("gpu: the monitor's lanes are locked after the change (the kept link) (status 77 77 01 01 00 00; it says its port is in sync)\n")

    // The same without the monitor asked: the same writes, and nothing
    // sent to the monitor.
    machineWith("a link that has room, the monitor not asked", 0x0A, 4)
    make(&monitor, mode.Wish.own, false)
    expect(plan.complete && plan.dp.case == mode.LinkCase.keep && !plan.dp.asked && plan.backCount == 0, "room, not asked: kept on the card's word")
    expect(carry(true) && sink.transactions == 0 && sink.auxWritten == 0, "room, not asked: done, nothing sent")
    _ = sameEvents("the kept link, not asked", 0, KEPT[0..KEPT[0..].length - 4], true)

    // The monitor does not answer: kept on the card's word as well.
    machineWith("a link that has room, a monitor that does not answer", 0x0A, 4)
    sink.silentFrom = 0
    make(&monitor, mode.Wish.own, true)
    expect(heard.state == dplink.Asked.silent && plan.complete && plan.dp.case == mode.LinkCase.keep && !plan.dp.asked, "room, no answer: kept on the card's word")

    // Lanes lost under the kept link: the registers back, and the
    // firmware's own link trained again.
    again("a kept link the monitor loses", 0x0A, 4)
    sink.dropsAtRead = 0
    expect(!carry(true) && result.reason == set.Reason.monitor && result.trainingsBack == 1 && result.outcome == set.Outcome.back && result.locked, "kept and lost: the firmware's link trained again")
    line("gpu: the monitor's lanes are NOT all locked after the change (the kept link) (status 00 00 00 00 00 00; it does not say its port is in sync)\n")
    line("gpu: putting the firmware's state back\n")
    line("gpu: the monitor's lanes are NOT all locked with the firmware's registers back (status 00 00 00 00 00 00; it does not say its port is in sync)\n")
    line("gpu: the monitor's lanes are not locked on the firmware's link: it is taken down and trained again at its own 2.70 Gbit/s on 4 lanes; the screen is dark meanwhile, ")
    line("gpu: train 2.70x4: trained in 1 + 1 rounds with pattern 3 at swing 0 pre 0; holds after 5 ms (try 1 of 4, ")
    line("gpu: the monitor's lanes are locked with the firmware's link trained again (status 77 77 01 01 00 00; it says its port is in sync)\n")
    expect(runsOf(0, 0, card.written) == 1 && runsOf(1, 0, card.written) == 1 && runsOf(11, 0, card.written) == 8, "kept and lost: the link down, up, a round each")
    back("kept and lost", 0x0A, 4)

    // The same where the link cannot be trained again (no ROM is lent to
    // the plan): the registers back, and said as what it is.
    machineWith("a kept link the monitor loses, no way to train", 0x0A, 4)
    {
        const none = mode.Rom.{ .machine = null, .board = null, .firmware = null }
        const offer = edid.nothing()
        outCard = scanout.Card.{ .read = sink.read, .now = card.now, .write = logWrite }
        port = aux.Port.{ .card = &outCard, .write = sink.auxWrite }
        channel = aux.Channel.open(&port, sink.channel, sink.line)
        memory = known()
        scanout.report(&outCard, &memory, &readout)
        remember()
        dplink.ask(&channel, &heard)
        mode.makeWith(&outCard, &readout, &memory, &monitor, &offer, &none, mode.Wish.own, &heard, &plan)
        mode.say(&outCard, &plan)
        sink.forget()
    }
    expect(plan.complete && plan.dp.case == mode.LinkCase.keep && plan.dp.asked && !plan.dp.trainable && plan.backCount == 0, "kept, no ROM: kept, not trainable")
    line("gpu: plan (b, DisplayPort): the monitor holds the same link with every lane locked: it is kept (it could not be trained again here: the card's video BIOS was not read or does not hold: its tables cannot be run)\n")
    sink.dropsAtRead = 0
    expect(!carry(true) && result.outcome == set.Outcome.unsure && card.runs == 0 && asBefore(), "kept and lost, no ROM: the registers back, not said to be back")
    line("gpu: the firmware's link cannot be trained again here: the monitor may show nothing until a restart\n")
    line("gpu: the firmware's state is NOT known to be back: the registers this driver wrote have the firmware's values again (")

    // A kept link's change that fails at a register: back by the
    // registers, the monitor still locked, no training.
    again("a kept link, a write that does not hold", 0x0A, 4)
    card.spoilAt = 13
    card.spoilBit = 0x1
    expect(!carry(true) && result.reason == set.Reason.read_back && result.outcome == set.Outcome.back && result.trainingsBack == 0 && card.runs == 0 && result.locked, "kept, a write that does not hold: back by the registers alone")
    back("kept, a write that does not hold", 0x0A, 4)

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- The firmware's own link taken down and trained again.
    machineWith("the firmware's own link trained again", 0x06, 2)
    make(&monitor, mode.Wish.rehearsal, true)
    expect(plan.complete && plan.rehearsal && plan.situation == mode.Situation.displayport && plan.dp.case == mode.LinkCase.retrain && plan.dp.target.code == 0x06 && plan.dp.target.lanes == 2, "rehearsal: the firmware's own rate and lanes")
    line("gpu: plan (the firmware's own link trained again): the link has 2 lanes at 1.62 Gbit/s (by M 0x5555 over N 0x8000), room for 108000 kHz at 24 bits\n")
    line("gpu: plan (the firmware's own link trained again): the link is taken down and trained again at 1.62 Gbit/s on 2 lanes, its own rate and lanes; the clock, the timing and the picture are left as they are\n")
    expect(carry(true) && result.outcome == set.Outcome.done && card.cleared == 0, "rehearsal: comes through, nothing cleared")
    _ = sameEvents("the rehearsal", 0, REHEARSAL[0..], true)
    line("gpu: training the firmware's own link again: carrying out the plan's ")
    line("gpu: controller 0 runs the firmware's own mode again, 60.000 frames a second, on its own link taken down and trained again at 1.62 Gbit/s on 2 lanes: the picture is where it was (")
    expect(monitorHolds(0x06, 2), "rehearsal: the monitor holds the firmware's link again")
    // (Only the scratch words differ, as Linux leaves them, the
    // blanking's word, and the stream's, which still says that a stop is
    // put off to a frame's end.)
    card.store(0x5CF, before[0x5CF])
    card.store(0x5CB, before[0x5CB])
    card.store(0x1BB6, before[0x1BB6])
    expect(card.raw(0x4CA4) == 0x201, "rehearsal: the stream runs")
    card.store(0x4CA4, before[0x4CA4])
    expect(asBefore(), "rehearsal: every other register as it was")

    // 8.1 Gbit/s on 4 lanes, as a firmware's own link trained again (a
    // card whose ROM allows it, a monitor that can it): the table told
    // 81000 tens of kHz (68 3c 01 00).
    machineWith("8.1 Gbit/s on 4 lanes", 0x1E, 4)
    open(0x0A, card.Ending.plain)
    sink.monitor(0x14, 0x1E, 4, true)
    make(&monitor, mode.Wish.rehearsal, true)
    expect(plan.complete && plan.dp.target.code == 0x1E && plan.dp.target.lanes == 4 && carry(true) && monitorHolds(0x1E, 4), "8.1 Gbit/s on 4 lanes: trained")
    {
        var on: usize = 0
        while on + 4 < card.written && !(card.writtenTo[on] == card.MAIL && (card.writtenWith[on] >> 8) & 0xFF == 1 && card.writtenByTable[on]) { on += 1 }
        expect(on + 4 < card.written && card.writtenWith[on] == 0x04000101 && card.writtenWith[on + 1] == 0x00013C68, "8.1 Gbit/s on 4 lanes: the transmitter's block")
    }

    // ---- The asking alone.
    machineWith("the asking alone", 0x06, 2)
    outCard = scanout.Card.{ .read = sink.read, .now = card.now, .write = logWrite }
    port = aux.Port.{ .card = &outCard, .write = sink.auxWrite }
    channel = aux.Channel.open(&port, sink.channel, sink.line)
    remember()
    dplink.ask(&channel, &heard)
    channel.end()
    _ = sameEvents("the asking", 0, ASKING[0..], true)
    expect(heard.state == dplink.Asked.heard && card.driverWrites == 0 && card.runs == 0 && sink.strayWrites == 0 && sink.auxWritten != 0 && asBefore() && auxAsBefore(), "the asking alone: nothing written but the AUX channel's own words")
    line("gpu: hot plug line 2 reads high (sense 1, delayed 1; its block is on)\n")
    line("gpu: AUX 1: on, watching hot plug line 2, pins in AUX mode, free, receive window 1 (control 0x100001)\n")
    line("gpu: AUX 1: the data word read 0x0 before the first request, 0x0 before its reply\n")
    line("gpu: the monitor's capabilities: 12 14 c4 01 00 00 01 00 00 00 00 00 00 00 00 00\n")
    line("gpu: the monitor: DisplayPort 1.2, up to 5.40 Gbit/s on 4 lanes, patterns up to 3, enhanced framing, downspread\n")
    line("gpu: the monitor holds 1.62 Gbit/s on 2 lanes, all locked (status 77 00 01 01 00 00), power on\n")
    line("gpu: left out of what Linux tells a monitor: the source's name at 300h\n")

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- A training whose rounds take what the monitor asks for.
    again("a monitor that asks for more", 0x06, 2)
    hard()
    expect(carry(true) && result.course.tries == 1 && result.course.clockRounds == 3 && result.course.equaliseRounds == 2 && result.course.drive.swing == 2 && result.course.drive.pre == 1, "asks for more: three rounds and two, swing 2 and pre-emphasis 1")
    line("gpu: train 2.70x4, clock recovery, round 1: drive swing 0 pre 0; lanes 0 0 0 0, aligned 0, asked swing 1 1 1 1 pre 1 1 1 1\n")
    line("gpu: train 2.70x4, clock recovery, round 2: drive swing 1 pre 1; lanes 0 0 0 0, aligned 0, asked swing 2 2 2 2 pre 1 1 1 1\n")
    line("gpu: train 2.70x4, clock recovery, round 3: drive swing 2 pre 1; lanes 1 1 1 1, aligned 0, asked swing 2 2 2 2 pre 1 1 1 1\n")
    line("gpu: train 2.70x4, equalisation, round 1: drive swing 2 pre 1; lanes 1 1 1 1, aligned 0, asked swing 2 2 2 2 pre 1 1 1 1\n")
    line("gpu: train 2.70x4, equalisation, round 2: drive swing 2 pre 1; lanes 7 7 7 7, aligned 1, asked swing 2 2 2 2 pre 1 1 1 1\n")
    line("gpu: train 2.70x4: trained in 3 + 2 rounds with pattern 3 at swing 2 pre 1; holds after 5 ms (try 1 of 4, ")
    // The drive told the table (swing in bits 0 and 1, pre-emphasis in 3
    // and 4) and the monitor (with the bits for the highest): the third
    // round's 0x0a, and at 103h the bytes 0a 0a 0a 0a.
    {
        var third: usize = 0
        var seen: usize = 0
        var k: usize = 0
        while k < card.written {
            if card.writtenTo[k] == sink.EVENT && sink.addressOf[card.writtenWith[k]] == 0x103 {
                seen += 1
                if seen == 2 { third = card.writtenWith[k] }
            }
            k += 1
        }
        expect(seen == 3 && sink.lengthOf[third] == 4 && @intCast(usize, sink.dataOf[third * 16]) == 0x0A && @intCast(usize, sink.dataOf[third * 16 + 3]) == 0x0A, "asks for more: later rounds tell the drive bytes at 103h")
        var drives: usize = 0
        k = 0
        while k + 4 < card.written {
            if card.writtenTo[k] == card.MAIL && card.writtenByTable[k] && card.writtenWith[k] == 0x040A0B01 { drives += 1 }
            k += 1
        }
        expect(drives == 4 * 3, "asks for more: the table told swing 2 and pre-emphasis 1 a lane, in three rounds")
        expect(runsOf(11, 0, card.written) == 4 * 5, "asks for more: the drive a lane in each of five rounds")
    }
    // A swing of 3 is told with its "highest reached" bit.
    again("a monitor that asks for the highest", 0x06, 2)
    sink.faultRate = 0x0A
    sink.needSwing[1] = 3
    expect(carry(true) && result.course.drive.swing == 3 && result.course.drive.pre == 0 && result.course.clockRounds == 2, "asks for the highest: swing 3 for all lanes")
    {
        var found = false
        var k: usize = 0
        while k < card.written {
            if card.writtenTo[k] == sink.EVENT && sink.addressOf[card.writtenWith[k]] == 0x103 && @intCast(usize, sink.dataOf[card.writtenWith[k] * 16]) == 0x07 { found = true }
            k += 1
        }
        expect(found, "asks for the highest: told as 07 (swing 3, highest reached)")
    }
    // The monitor's own wait (its byte 0Eh: 4 is 16 ms in both).
    again("a monitor that asks for a longer wait", 0x06, 2)
    sink.dpcd[0x00E] = 4
    make(&monitor, mode.Wish.own, true)
    line("the monitor told, 16000 us or 16000 us, its status read")
    expect(carry(true) && sink.leastClockWait >= 16000000 && sink.leastEqualiseWait >= 16000000, "a longer wait: 16 ms before each status read")

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- A training that fails, each way there is: four tries, the link
    // taken down between, pauses of 100, 150 and 200 ms; then the way
    // back, on which the monitor trains at once.
    again("the same swing five times", 0x06, 2)
    sink.faultRate = 0x0A
    sink.stubborn = true
    expect(!carry(true) && result.reason == set.Reason.link, "the same swing five times: fails")
    line("gpu: train 2.70x4, clock recovery, round 5: drive swing 0 pre 0; lanes 0 0 0 0, aligned 0, asked swing 0 0 0 0 pre 0 0 0 0\n")
    noLine("gpu: train 2.70x4, clock recovery, round 6")
    line("gpu: train 2.70x4: failed at clock recovery on lane 0, which points to a lower rate (try 4 of 4; the last status 0 0 0 0, drive swing 0 pre 0)\n")
    // (Then the link falls back as Linux decides: 1.62 Gbit/s on 4 lanes,
    // at which this monitor trains at once, and which does not carry the
    // timing: the link that remains, tests/513.)
    line("gpu: train 2.70x4: falls back to 1.62 Gbit/s on 4 lanes as Linux decides (decide_fallback_link_setting: a lower rate; it does not carry the stream, and is tried for the link that remains)\n")
    line("gpu: step 38 of 83 failed (the link's own step: it trained at a link that does not carry the timing): train the link at 2.70 Gbit/s on 4 lanes (the link brought up and trained)\n")
    expect(card.count("gpu: train 2.70x4: failed at clock recovery on lane 0") == 4 && card.count("gpu: train 2.70x4, clock recovery, round 5") == 4, "the same swing five times: four tries of five rounds")
    // (The link down once at the plan's step, three times between the
    // tries and once before the fallback's try, on four times and once
    // more, the drive five rounds of four lanes a try and a round each of
    // the fallback's two patterns; and on the way back down, on and two
    // rounds of two lanes.)
    expect(runsOf(0, 0, card.written) == 1 + 3 + 1 + 1 && runsOf(1, 0, card.written) == 4 + 1 + 1 && runsOf(11, 0, card.written) == 4 * 5 * 4 + 2 * 4 + 2 * 2, "the same swing five times: the table's runs")
    expect(sink.turnedOn == 6 && sink.turnedOnAt[1] - sink.turnedOnAt[0] >= 100000000 && sink.turnedOnAt[2] - sink.turnedOnAt[1] >= 150000000 && sink.turnedOnAt[3] - sink.turnedOnAt[2] >= 200000000 && sink.turnedOnAt[1] - sink.turnedOnAt[0] < 150000000 && sink.turnedOnAt[2] - sink.turnedOnAt[1] < 200000000, "the same swing five times: the pauses between the tries grow")
    back("the same swing five times", 0x06, 2)

    // The same swing five times is judged by the swing alone: a lane
    // that asks for the swing it has and for more pre-emphasis.
    again("the same swing five times, more pre-emphasis asked", 0x06, 2)
    sink.faultRate = 0x0A
    sink.stubborn = true
    sink.needPre[0] = 1
    expect(!carry(true), "the same swing, more pre-emphasis: fails")
    line("gpu: train 2.70x4, clock recovery, round 5: drive swing 0 pre 1; lanes 0 0 0 0, aligned 0, asked swing 0 0 0 0 pre 1 0 0 0\n")
    noLine("gpu: train 2.70x4, clock recovery, round 6")
    back("the same swing, more pre-emphasis", 0x06, 2)

    again("a clock that does not come at the highest swing", 0x06, 2)
    sink.faultRate = 0x0A
    sink.stepwise = true
    sink.needSwing[1] = 4
    expect(!carry(true), "a clock that does not come: fails")
    line("gpu: train 2.70x4, clock recovery, round 4: drive swing 3 pre 0; lanes 1 0 1 1, aligned 0, asked swing 3 3 3 3 pre 0 0 0 0\n")
    noLine("gpu: train 2.70x4, clock recovery, round 5")
    line("gpu: train 2.70x4: failed at clock recovery on lane 1, which points to a lower rate (try 1 of 4; the last status 1 0 1 1, drive swing 3 pre 0)\n")
    back("a clock that does not come", 0x06, 2)

    again("six rounds without equalisation", 0x06, 2)
    sink.faultRate = 0x0A
    sink.needPre[3] = 4
    expect(!carry(true), "six rounds without equalisation: fails")
    line("gpu: train 2.70x4, equalisation, round 6: drive swing 0 pre 3; lanes 7 7 7 1, aligned 0, asked swing 0 0 0 0 pre 0 0 0 3\n")
    noLine("gpu: train 2.70x4, equalisation, round 7")
    line("gpu: train 2.70x4: failed at equalisation: six rounds without it, which points to fewer lanes (try 4 of 4; the last status 7 7 7 1, drive swing 0 pre 3)\n")
    {
        // (A pre-emphasis of 3 at a swing of 0: told the table as 0x18,
        // the monitor as 0x38, with the bit for the highest.)
        var table = false
        var told = false
        var k: usize = 0
        while k < card.written {
            if card.writtenTo[k] == card.MAIL && card.writtenByTable[k] && card.writtenWith[k] == 0x04180B01 { table = true }
            if card.writtenTo[k] == sink.EVENT && sink.addressOf[card.writtenWith[k]] == 0x103 && @intCast(usize, sink.dataOf[card.writtenWith[k] * 16]) == 0x38 { told = true }
            k += 1
        }
        expect(table && told, "six rounds without equalisation: pre-emphasis 3 told as 18 and 38")
    }
    back("six rounds without equalisation", 0x06, 2)

    // A pre-emphasis asked that the swing leaves no room for is cut (at
    // swing 2: to 1).
    again("a pre-emphasis the swing leaves no room for", 0x06, 2)
    sink.faultRate = 0x0A
    sink.needSwing[0] = 2
    sink.needPre[1] = 3
    expect(!carry(true), "a pre-emphasis that is cut: the lane never locks")
    line("gpu: train 2.70x4, equalisation, round 6: drive swing 2 pre 1; lanes 7 1 7 7, aligned 0, asked swing 2 2 2 2 pre 0 3 0 0\n")
    back("a pre-emphasis that is cut", 0x06, 2)

    again("the clock lost on a lane in the equalisation", 0x06, 2)
    sink.faultRate = 0x0A
    sink.losesClockIn = 2
    expect(!carry(true), "the clock lost on some lanes: fails")
    line("gpu: train 2.70x4: failed at equalisation: clock recovery lost on some lanes, which points to fewer lanes (try 4 of 4; the last status 7 7 0 7, drive swing 0 pre 0)\n")
    back("the clock lost on some lanes", 0x06, 2)

    again("the clock lost on the first lane in the equalisation", 0x06, 2)
    sink.faultRate = 0x0A
    sink.losesClockIn = 0
    expect(!carry(true), "the clock lost on all lanes: fails")
    line("gpu: train 2.70x4: failed at equalisation: clock recovery lost on all lanes, which points to a lower rate (try 4 of 4; the last status 0 7 7 7, drive swing 0 pre 0)\n")
    back("the clock lost on all lanes", 0x06, 2)

    again("lanes that drop when the pattern is taken off", 0x06, 2)
    sink.faultRate = 0x0A
    sink.dropsAtExit = true
    expect(!carry(true), "lanes that drop afterwards: fails")
    line("gpu: train 2.70x4: failed at it trained, but a lane was not locked 5 ms later, the link does not hold (try 4 of 4; the last status 7 7 7 7, drive swing 0 pre 0)\n")
    // (After a failure the card is not put to its idle pattern at this
    // rate; here it trained, so it was: "trained" was written 0x10 four
    // times on the way there.)
    back("lanes that drop afterwards", 0x06, 2)

    // The same swing five times is judged by what lane 0 asks for (Linux:
    // "settings are the same for all lanes, so comparing first lane is
    // sufficient"): lane 0, whose clock never comes, asks for swing 1 and
    // has it from the second round on; lane 1 asks for swing 0 whatever
    // it is given. Six rounds, not a hundred.
    again("the same swing five times, by lane 0's asking", 0x06, 2)
    sink.faultRate = 0x0A
    sink.needSwing[0] = 4
    sink.asksSwing[0] = 1
    sink.asksSwing[1] = 0
    expect(!carry(true), "the same swing by lane 0: fails")
    line("gpu: train 2.70x4, clock recovery, round 6: drive swing 1 pre 0; lanes 0 1 1 1, aligned 0, asked swing 1 0 1 1 pre 0 0 0 0\n")
    noLine("gpu: train 2.70x4, clock recovery, round 7")
    back("the same swing by lane 0", 0x06, 2)

    // A training that fails at the lowest rate leaves the card on its
    // idle pattern after every try, as Linux does there (at another rate
    // the pattern stays on): the firmware's own link at 1.62 Gbit/s
    // trained again, a monitor whose clock never comes. "Trained" is
    // written four times on the way there and four times on the way
    // back.
    machineWith("a training that fails at the lowest rate", 0x06, 2)
    {
        const small = wide()
        make(&small, mode.Wish.rehearsal, true)
    }
    sink.stubborn = true
    expect(!carry(true) && result.outcome == set.Outcome.unsure, "the lowest rate: fails, and is not known to be back")
    {
        var told: usize = 0
        var k: usize = 0
        while k < card.written {
            if card.writtenTo[k] == 0x4BA0 && card.writtenWith[k] & 0x10 != 0 { told += 1 }
            k += 1
        }
        expect(told == 8 && card.count("gpu: train 1.62x2: failed at clock recovery on lane 0") == 8, "the lowest rate: the card on its idle pattern after each failed try")
    }
    channel.end()

    // A back end whose panel mode word the firmware left at another
    // value than an external monitor's: cleared when the link goes down,
    // after the transmitter's "off" and before its "on" (and said).
    machineWith("a panel mode word that is not 0", 0x06, 2)
    card.store(0x4BA7, 1)
    {
        const small = wide()
        make(&small, mode.Wish.own, true)
    }
    expect(carry(true), "a panel mode word of 1: the mode comes")
    line("gpu: DIG 1's panel mode word reads 0x1: written 0, an external monitor's\n")
    {
        var at: usize = 0
        while at < card.written && card.writtenTo[at] != 0x4BA7 { at += 1 }
        expect(at < card.written && card.writtenWith[at] == 0 && runsOf(0, 0, at) == 1 && runsOf(1, 0, at) == 0, "a panel mode word of 1: cleared with the link down, before the transmitter comes on")
    }
    channel.end()

    again("a cable that carries two lanes", 0x06, 2)
    sink.cableLanes = 2
    expect(!carry(true), "a cable of two lanes: fails")
    line("gpu: train 2.70x4: failed at clock recovery on lane 0, which points to a lower rate (try 4 of 4; the last status 0 0 0 0, drive swing 0 pre 0)\n")
    back("a cable of two lanes", 0x06, 2)

    again("a drive table that does nothing", 0x06, 2)
    hard()
    sink.driveDeaf = true
    expect(!carry(true), "a drive that does nothing: fails")
    line("gpu: train 2.70x4, clock recovery, round 1: drive swing 0 pre 0; lanes 0 0 0 0, aligned 0, asked swing 1 1 1 1 pre 1 1 1 1\n")
    sink.driveDeaf = false
    // (The monitor is told a drive the card does not have: no lane's
    // clock comes; the way back's own link trains, its drive is 0.)

    // A training that comes through at its second try (the monitor
    // misses one access): the link taken down between, 100 ms.
    again("a training's second try", 0x06, 2)
    sink.silentFrom = 16
    sink.silentUntil = 16 + 32
    expect(carry(true) && result.course.tries == 2 && monitorHolds(0x0A, 4), "a second try: comes through")
    line("gpu: train 2.70x4: failed at the monitor did not answer (try 1 of 4; the last status 1 1 1 1, drive swing 0 pre 0)\n")
    line("; holds after 5 ms (try 2 of 4, ")
    expect(runsOf(0, 0, card.written) == 2 && runsOf(1, 0, card.written) == 2 && sink.turnedOnAt[1] - sink.turnedOnAt[0] >= 100000000, "a second try: the link down between, a pause")

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- A failure at every step. The good run first, to know how many
    // writes, table runs and accesses there are.
    again("the hard monitor, nothing wrong", 0x06, 2)
    hard()
    expect(carry(true), "the hard monitor: comes through")
    const writes = card.driverWrites
    const runs = card.runs
    const accesses = sink.transactions
    if show {
        out.field("the hard monitor: writes ", writes)
        out.field(", table runs ", runs)
        out.field(", transactions ", accesses)
        say("\n")
    }
    expect(writes == 89 && runs == 22 && accesses == 33, "the hard monitor: 89 writes, 22 table runs, 33 transactions")

    // Each write of the driver's, a bit of it the other way. A bit that
    // the write is read back by: found there, and the firmware's state
    // back; or, in the training, the try ends and the second comes
    // through. A bit of the word that the write only carries (it was
    // read and written back as it was) is not the write's to hold: the
    // change comes through, or fails later by what the bit does, and
    // then the firmware's state is not said to be back, since that bit
    // is not the driver's to give back.
    const BITS = [_]usize{ 0x1, 0x10, 0x100, 0x400, 0x10000, 0x100000, 0x20000000 }
    var unseen: usize = 0
    var retried: usize = 0
    var late: usize = 0
    var at: usize = 0
    while at < writes {
        var seen = false
        for bit in BITS {
            again("a write that does not hold", 0x06, 2)
            hard()
            card.spoilAt = at
            card.spoilBit = bit
            if carry(true) {
                expect(result.outcome == set.Outcome.done, "a spoiled write not found: done")
                if result.course.tries == 2 {
                    seen = true
                    retried += 1
                }
            } else if result.reason == set.Reason.read_back || result.reason == set.Reason.link {
                seen = true
                back("a write that does not hold", 0x06, 2)
            } else {
                late += 1
                expect(result.outcome == set.Outcome.back == (asBefore() && monitorHolds(0x06, 2)), "a bit that is not the write's: back said only when it is")
            }
        }
        if !seen {
            unseen += 1
            if show {
                out.field("no bit of write ", at)
                say(" is read back\n")
            }
        }
        at += 1
    }
    if show {
        out.field("spoiled writes: not read back ", unseen)
        out.field(", found by a second try ", retried)
        out.field(", failed later ", late)
        say("\n")
    }
    // (Not read back: DIG_START, which may clear itself, as before.)
    expect(unseen == 1 && retried != 0 && late != 0, "every write of the driver's is read back, but the encoder's start bit")

    // Each table run stopped by the card.
    at = 0
    while at < runs {
        again("a table run stopped", 0x06, 2)
        hard()
        card.refuseRun = at
        expect(!carry(true) && result.reason == set.Reason.link, "a table run stopped: the change fails")
        back("a table run stopped", 0x06, 2)
        at += 1
    }
    line("gpu: train 2.70x4: failed at a table's run (try 1 of 4; ")

    // Each access to the monitor unanswered (all its tries): the
    // firmware's state back, or the training's second try.
    var second: usize = 0
    var returned: usize = 0
    at = 0
    while at < accesses {
        again("an access unanswered", 0x06, 2)
        hard()
        sink.silentFrom = at
        sink.silentUntil = at + 32
        if carry(true) {
            second += 1
            expect(result.course.tries == 2 && monitorHolds(0x0A, 4), "an access unanswered in the training: its second try")
        } else {
            returned += 1
            back("an access unanswered", 0x06, 2)
        }
        at += 1
    }
    // (Back: the monitor's power state at the plan's own step, where the
    // firmware's link is kept; and the lanes' read after the frames.)
    expect(returned == 3 && second == accesses - 3, "an access unanswered: back at the first and after the frames, else a second try")
    again("the monitor does not take its power state", 0x06, 2)
    sink.silentFrom = 0
    sink.silentUntil = 32
    expect(!carry(true) && card.runs == 0 && result.trainings == 0 && result.trainingsBack == 0, "no power state: no table run, no training")
    line("gpu: AUX 1: no answer at 600h (status 0x81: timeout) after 32 tries\n")
    line("gpu: the monitor did not take its power state: the firmware's link is kept\n")
    line("gpu: putting the firmware's state back (the link was not touched: the stream started again, the registers)\n")
    back("no power state", 0x06, 2)

    // A monitor that is gone for good in the middle of the training: no
    // way back trains; said, and not called back.
    again("a monitor that is gone", 0x06, 2)
    sink.silentFrom = 16
    expect(!carry(true) && result.outcome == set.Outcome.unsure && result.doubts != 0 && !result.locked, "a monitor that is gone: not said to be back")
    line("gpu: train 1.62x2: failed at the monitor did not answer (try 4 of 4; ")
    line("gpu: the firmware's own link did not train again: the card sends its idle pattern and the stream all the same; the monitor may show nothing until a restart\n")
    line("gpu: the firmware's state is NOT known to be back: the registers this driver wrote have the firmware's values again (")
    // (The card was put to its idle pattern and told "trained" all the
    // same, and the stream runs.)
    expect(card.raw(0x4BA0) & 0x10 != 0 && card.raw(0x4CA4) & 1 != 0 && card.raw(0x141) == 108000000 && card.raw(0x1B80) == 1799, "a monitor that is gone: idle pattern, the stream, the firmware's clock and timing")

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- The way back's own endings.
    // A table that does not run to its end on the way back: nothing more
    // is run.
    again("the way back's table stopped", 0x06, 2)
    sink.dropsAtRead = 3
    card.refuseRun = 11
    expect(!carry(true) && result.outcome == set.Outcome.lost && result.trainingsBack == 1, "the way back's table stopped: the way back did not come to its end")
    line("gpu: the way back ends at its step ")
    line("gpu: the way back did not come to its end: the output is left as that left it until a restart; the registers this driver wrote have the firmware's values again (")

    // A transmitter that does not come on again: said, the way goes on,
    // not called back.
    again("the way back's transmitter stays off", 0x06, 2)
    sink.dropsAtRead = 3
    card.heldRegister = 0x4B48
    card.heldMask = 0x1
    card.heldValue = 0
    card.heldFrom = 11
    card.heldUntil = 1000
    expect(!carry(true) && result.outcome == set.Outcome.unsure && result.doubts != 0, "the way back's transmitter stays off: not said to be back")
    line("gpu: transmitter 1 on at 1.62 Gbit/s on 2 lanes: the table left DIG 1 OFF, mode 0, front ends 0x4, lanes 2\n")
    line("gpu: train 1.62x2: failed at the back end does not read on after its table (try 4 of 4; ")
    line("gpu: on the way back, not as it should be (the way goes on): train the link at 1.62 Gbit/s on 2 lanes (the firmware's own link brought up and trained)\n")

    // A transmitter that does not come on at all: the back end is off
    // when the link is to go down again, so its table is not run for
    // that (once, at the plan's own step, and never after).
    again("a transmitter that does not come on", 0x06, 2)
    card.transmitterDeaf = true
    expect(!carry(true) && result.outcome == set.Outcome.unsure, "a transmitter that does not come on: not said to be back")
    line("gpu: transmitter 1 is off already: its table is not run and the back end's words are left\n")
    expect(runsOf(0, 0, card.written) == 1 && runsOf(1, 0, card.written) == 8, "a transmitter that does not come on: turned off once, on eight times")
    line("gpu: the firmware's own link did not train again: the card sends its idle pattern and the stream all the same; the monitor may show nothing until a restart\n")

    // The way back's training comes through, but the monitor's lanes do
    // not read locked afterwards (the last write of the change did not
    // hold; the seventh read of the lanes is the one after the way
    // back): not said to be back.
    again("the firmware's link lost again after the way back", 0x06, 2)
    card.spoilAt = 88
    card.spoilBit = 0x100
    sink.dropsAtRead = 6
    expect(!carry(true) && result.reason == set.Reason.read_back && result.trainingsBack == 1 && result.course.end == dplink.End.trained && !result.locked && result.doubts == 1 && result.outcome == set.Outcome.unsure, "lost again after the way back: not said to be back")
    line("gpu: the monitor's lanes are NOT all locked with the firmware's state back (status 00 00 00 00 00 00; it does not say its port is in sync)\n")
    line("gpu: the firmware's state is NOT known to be back: the registers this driver wrote have the firmware's values again (")

    // A register that does not take the firmware's value again.
    again("a register that stays", 0x06, 2)
    sink.dropsAtRead = 3
    card.deafRegister = 0x1B87
    card.deafAfter = 1
    expect(!carry(true) && result.outcome == set.Outcome.astray && result.astray == 1, "a register that stays: not all back")
    line("gpu: 1b87 holds 00000456, the firmware had 000003e7\n")
    line("gpu: the firmware's state is NOT all back: 1 register differs")

    // ---- Another place: controller 2, front end 3, back end 4 (UNIPHY
    // E), hot plug line 6, AUX channel 0.
    sink.reset()
    if show { say("-- another controller, front end, back end, line and channel\n") }
    sink.backEnd = 4
    sink.line = 5
    sink.channel = 0
    open(0x02, card.Ending.plain)
    sink.monitor(0x12, 0x14, 4, true)
    sink.firmware(2, 3, 0x06, 2)
    make(&monitor, mode.Wish.own, true)
    expect(plan.complete && plan.controller == 2 && plan.dp.case == mode.LinkCase.retrain && plan.dp.channel == 0 && plan.dp.output.line == 6 && plan.dp.output.backEnd == 4 && plan.dp.frontEnd == 3, "another place: the output as the ROM and the read-out have it")
    line("gpu: hot plug line 6 reads high (sense 1, delayed 1; its block is on)\n")
    line("gpu: AUX 0: on, watching hot plug line 6, pins in AUX mode, free, receive window 1 (control 0x500001)\n")
    line("gpu: DIG 4 is UNIPHY E; the ROM puts a connector of the kind \"DisplayPort\" behind it: AUX 0 (DDC line 1), hot plug line 6; both ends have up to 5.40 Gbit/s on 4 lanes\n")
    line("gpu:   table UNIPHYTransmitterControl, transmitter 4 on: 04 01 00 04 78 69 00 00 06 00 13 00 00 00 00 00\n")
    expect(carry(true) && monitorHolds(0x0A, 4), "another place: comes through")
    {
        // Every write is in controller 2's block (0x400 on), front end
        // 3's (0x4d00), back end 4's (0x4e00), the DTO's third word, the
        // third buffers' word, the scratch words or the tables' mail.
        var strange: usize = 0
        var k: usize = 0
        while k < card.written {
            const number = card.writtenTo[k]
            const fine = number == sink.EVENT || (number >= 0x1E00 && number < 0x2000) || (number >= 0x4D00 && number < 0x4F00) || number == 0x149 || number == 0x323 || number == 0x5CF || number == 0x5CB || (number >= card.MAIL && number <= card.GO)
            if !fine { strange += 1 }
            k += 1
        }
        expect(strange == 0, "another place: no write outside its own blocks")
        var on: usize = 0
        while on + 4 < card.written && !(card.writtenTo[on] == card.MAIL && (card.writtenWith[on] >> 8) & 0xFF == 1 && card.writtenByTable[on]) { on += 1 }
        expect(on + 4 < card.written && card.writtenWith[on] == 0x04000104 && card.writtenWith[on + 2] == 0x00130006, "another place: the table told transmitter 4 and line 6")
        expect(card.raw(0x4E47) == ((5 << 28) | 0x800) && card.raw(0x4EA3) == 3 && card.raw(0x4DAA) == 0x7E68 && card.raw(0x149) == 266640000, "another place: the words of its blocks")
    }
    line("gpu: controller 2 shows a picture of 3840x1080 as it is, 60.000 frames a second: the monitor's own mode is set, on a link trained at 2.70 Gbit/s on 4 lanes (")

    // ---- A boot that keeps the firmware's picture, on every link a
    // firmware can leave (each rate and count of lanes, trained or not)
    // and for either wish: the monitor is not asked, the plan is made on
    // the card's word, and nothing at all is written, run or sent,
    // whether the plan is one that would keep the link, one that is
    // refused, or none.
    {
        var runs: usize = 0
        var touched: usize = 0
        for code in dplink.RATES {
            for lanes in dplink.LANE_COUNTS {
                var trained: usize = 0
                while trained < 2 {
                    var wishes: usize = 0
                    while wishes < 2 {
                        machineWith("the firmware's picture kept", code, lanes)
                        if trained == 0 { card.store(0x4BA0, card.raw(0x4BA0) & ~@intCast(usize, 0x10)) }
                        const quiet = wide()
                        make(&quiet, if wishes == 0 { mode.Wish.own } else { mode.Wish.rehearsal }, false)
                        const done = carry(false)
                        if done || card.written != 0 || card.runs != 0 || sink.transactions != 0 || sink.auxWritten != 0 || sink.strayWrites != 0 || card.cleared != 0 || result.outcome != set.Outcome.untouched || !asBefore() || !auxAsBefore() { touched += 1 }
                        runs += 1
                        wishes += 1
                    }
                    trained += 1
                }
            }
        }
        expect(runs == 48 && touched == 0, "the firmware's picture kept, on every link: no write, no table, no transaction")
    }

    if failed != 0 { return failed }
    return 13
}
