// std.truetype on tests/support/fonts/DejaVuSans-subset.ttf (DejaVu Sans
// subset: short loca, cmap formats 4 and 12, compound glyphs, a legacy kern
// table). Checks the tables and metrics against fontTools, glyph bitmaps
// whose placement matches FreeType's (unhinted) and whose coverage sums are
// fixed here, the atlas, layout with kerning, drawRun's blending, and that
// truncated or foreign data is rejected. Run from the repository root.
// Exits 13.
const std = @import("std")
const tt = @import("std.truetype")

fn coverageSum(bitmap: tt.Bitmap) -> usize {
    var sum: usize = 0
    var index: usize = 0
    while index < bitmap.width * bitmap.height {
        sum += @intCast(usize, bitmap.pixels[index])
        index += 1
    }
    return sum
}

pub fn main() -> u8 {
    const allocator = std.page_allocator.init()
    var font: tt.Font = undefined
    if tt.loadFile(&font, @ptrCast([*]const u8, "tests/support/fonts/DejaVuSans-subset.ttf"), allocator) != tt.Status.ok { return 1 }
    if font.unitsPerEm != 2048 || font.numGlyphs != 105 || font.longLoca { return 2 }
    if font.cmapFormat != 12 || font.kernCount != 285 { return 3 }
    if font.ascender != 1901 || font.descender != -483 || font.lineGap != 0 { return 4 }

    // Characters, metrics, kerning.
    const a = tt.glyphIndex(&font, 65)
    const v = tt.glyphIndex(&font, 86)
    const e_acute = tt.glyphIndex(&font, 233)
    if a != 34 || v != 55 || e_acute != 100 { return 5 }
    if tt.glyphIndex(&font, 66304) != 103 { return 6 }
    if tt.glyphIndex(&font, 19968) != 0 || tt.glyphIndex(&font, 1114111) != 0 { return 7 }
    if tt.advanceWidth(&font, a) != 1401 || tt.advanceWidth(&font, tt.glyphIndex(&font, 32)) != 651 { return 8 }
    if tt.kerning(&font, a, v) != -131 || tt.kerning(&font, tt.glyphIndex(&font, 84), tt.glyphIndex(&font, 111)) != -348 { return 9 }
    if tt.kerning(&font, v, v) != 0 { return 10 }

    // Bitmaps at 24 pixels per em: FreeType places them identically.
    var bitmap: tt.Bitmap = undefined
    if !tt.rasterize(&font, a, 0.01171875, allocator, &bitmap) { return 11 }
    if bitmap.width != 19 || bitmap.height != 18 || bitmap.left != 0 || bitmap.top != -18 { return 12 }
    if coverageSum(bitmap) != 23754 { return 13 }
    // The apex row of "A" is dark in the middle, clear at the sides.
    if bitmap.pixels[1 * 19 + 7] != 255 || bitmap.pixels[1 * 19 + 1] != 0 { return 14 }
    // "é" is a compound glyph (e plus the acute accent).
    if !tt.rasterize(&font, e_acute, 0.01171875, allocator, &bitmap) { return 15 }
    if bitmap.width != 15 || bitmap.height != 21 || bitmap.left != 1 || bitmap.top != -20 { return 16 }
    if coverageSum(bitmap) != 22246 { return 17 }
    // The space has no outline.
    if !tt.rasterize(&font, tt.glyphIndex(&font, 32), 0.01171875, allocator, &bitmap) || bitmap.width != 0 { return 18 }

    // Atlas and layout: "AV" at 20 pixels (ascender to descender) kerns
    // (1401 - 131 + 1401) * 20 / 2384 = 22.4 pixels.
    var atlas: tt.Atlas = undefined
    if !tt.initAtlas(&atlas, &font, 20, 256, 64, allocator) { return 19 }
    if atlas.ascent != 16 || atlas.descent != 4 || atlas.lineHeight != 20 { return 20 }
    var run: tt.Run = undefined
    if !tt.initRun(&run, 32, allocator) { return 21 }
    tt.layout(&atlas, "AV", &run)
    if run.count != 2 || run.advance != 22 { return 22 }
    if run.quads[1].x <= run.quads[0].x || run.top >= 0 || run.bottom != 0 { return 23 }
    const revision = atlas.revision
    tt.layout(&atlas, "VA", &run)
    if atlas.revision != revision { return 24 }
    // UTF-8: "é" is two bytes, one glyph.
    tt.layout(&atlas, "é €", &run)
    if run.count != 2 { return 25 }

    // drawRun: white on black gives each pixel the run's coverage.
    tt.layout(&atlas, "Mlx", &run)
    const width: usize = 48
    const height: usize = 24
    const memory = allocator.alloc(width * height * 4, 16)
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrCast([*]u32, memory.?) }
    var index: usize = 0
    while index < width * height {
        pixels[index] = 4278190080
        index += 1
    }
    tt.drawRun(&atlas, &run, pixels, width, height, width, 2, 18, 4294967295, 0)
    var inked: usize = 0
    var y: i32 = 0
    while y < @intCast(i32, height) {
        var x: i32 = 0
        while x < @intCast(i32, width) {
            const coverage = tt.runCoverage(&atlas, &run, x - 2, y - 18)
            const pixel = pixels[@intCast(usize, y) * width + @intCast(usize, x)]
            if pixel != 4278190080 | (coverage << 16) | (coverage << 8) | coverage { return 26 }
            if coverage > 0 { inked += 1 }
            x += 1
        }
        y += 1
    }
    if inked < 100 { return 27 }
    // Half-transparent red over blue.
    // alpha 128: red (255 * 128 + 127) / 255 = 128, blue (255 * 127 + 127) / 255 = 127.
    if tt.blendCoverage(4278190335, 2164195328, 255) != 4286578815 { return 28 }

    // Rejected input.
    var bad: tt.Font = undefined
    var junk: [64]u8 = undefined
    index = 0
    while index < 64 {
        junk[index] = @intCast(u8, index)
        index += 1
    }
    unsafe {
        if tt.init(&bad, @ptrCast([*]const u8, &junk), 64) != tt.Status.notTrueType { return 29 }
        if tt.init(&bad, font.data, 100) != tt.Status.missingTable { return 30 }
        if tt.init(&bad, font.data, 8) != tt.Status.truncated { return 31 }
    }
    if tt.loadFile(&bad, @ptrCast([*]const u8, "tests/support/fonts/missing.ttf"), allocator) != tt.Status.unreadable { return 32 }
    tt.close(&font)
    return 13
}
