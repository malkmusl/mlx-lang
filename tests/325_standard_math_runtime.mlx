// std.math: sines, e^x and the logarithms within an ulp of the exact value
// (these inputs give the correctly rounded double), rounding halves away
// from zero, cube roots, and the edges: NaN and minus infinity from ln, 0
// and infinity from e^x past its range. Exits 13 when every check holds,
// else the number of the first check that failed.
const math = @import("std.math")

pub fn main() -> u8 {
    if @bitCast(u64, math.sin(1.0)) != 4605754516372524270 { return 1 }
    if @bitCast(u64, math.cos(2.0)) != 13824540291724702213 { return 2 }
    if @bitCast(u64, math.sin(100.0)) != 13826108192625282488 { return 3 }
    if @bitCast(u64, math.exp(-3.5)) != 4584361024591036262 { return 4 }
    if @bitCast(u64, math.ln(10.0)) != 4612367379483415830 { return 5 }
    if math.log2(1024.0) != 10.0 || math.log10(1000.0) != 3.0 { return 6 }
    if math.cbrt(27.0) != 3.0 || math.cbrt(-8.0) != -2.0 { return 7 }
    if math.round(-2.5) != -3.0 || math.round(2.5) != 3.0 || math.round(0.49999999999999994) != 0.0 { return 8 }
    if !math.isNan(math.ln(-1.0)) || math.ln(0.0) != math.negativeInfinity() { return 9 }
    if math.exp(1000.0) != math.infinity() || math.exp(-1000.0) != 0.0 { return 10 }
    // sin(pi) is pi's rounding error, 1.2246467991473532e-16.
    if @bitCast(u64, math.sin(math.pi)) != 4368955796522032135 { return 11 }
    if math.floor(-0.5) != -1.0 || math.ceil(-0.5) != 0.0 { return 12 }
    return 13
}
