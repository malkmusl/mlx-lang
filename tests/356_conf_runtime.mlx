// std.conf over a settings file of the test's own: entries with blanks
// (and a CR) around keys and values, an empty value, comments, blank
// lines and a line without "=" passed over, groups; parseLine's kinds;
// find; parseSwitch's words. Exits 13 when every check holds, else the
// number of the first check that failed.
const std = @import("std")
const conf = @import("std.conf")

pub fn main() -> u8 {
    const text = "# MLX Audio\nvolume = 80\n\n  mute=on\r\nnot a setting\n[Desktop Entry]\nName = Files\nExec =\n# Name = commented\n[Other]\nName=Other\n"
    var reader = conf.lines(text)
    var entry: conf.Entry = undefined
    if !conf.next(&reader, &entry) || !std.text.same(entry.key, "volume") || !std.text.same(entry.value, "80") || entry.group.length != 0 { return 1 }
    if !conf.next(&reader, &entry) || !std.text.same(entry.key, "mute") || !std.text.same(entry.value, "on") { return 2 }
    if !conf.next(&reader, &entry) || !std.text.same(entry.key, "Name") || !std.text.same(entry.value, "Files") || !std.text.same(entry.group, "Desktop Entry") { return 3 }
    if !conf.next(&reader, &entry) || !std.text.same(entry.key, "Exec") || entry.value.length != 0 { return 4 }
    if !conf.next(&reader, &entry) || !std.text.same(entry.value, "Other") || !std.text.same(entry.group, "Other") { return 5 }
    if conf.next(&reader, &entry) { return 6 }

    if conf.parseLine("  # comment", &entry) != conf.BLANK { return 7 }
    if conf.parseLine("", &entry) != conf.BLANK { return 8 }
    if conf.parseLine("no equals here", &entry) != conf.OTHER { return 9 }
    if conf.parseLine("[Group]", &entry) != conf.GROUP || !std.text.same(entry.group, "Group") { return 10 }
    if conf.parseLine("a = b = c", &entry) != conf.ENTRY || !std.text.same(entry.key, "a") || !std.text.same(entry.value, "b = c") { return 11 }

    const mute = conf.find(text, "mute")
    if mute == null || !std.text.same(mute.?, "on") { return 12 }
    if conf.find(text, "missing") != null { return 14 }

    var on = false
    if !conf.parseSwitch("yes", &on) || !on { return 15 }
    if !conf.parseSwitch("0", &on) || on { return 16 }
    on = true
    if conf.parseSwitch("maybe", &on) || !on { return 17 }
    return 13
}
