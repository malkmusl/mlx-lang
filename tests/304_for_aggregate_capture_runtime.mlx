// `for value in items` over elements of a struct, an array or a slice: the
// capture is the element's value, every word of it. Older compilers loaded
// the first word of a struct or array element as if it were its address
// (a segfault on the first field read) and kept one word of a slice (its
// length lost). Exits 13 when every check holds, else the number of the
// first check that failed.
const Box = struct { x: i32, y: i32, w: i32, h: i32 }

pub fn main() -> u8 {
    var boxes: [2]Box = undefined
    boxes[0] = Box.{ .x = 1, .y = 2, .w = 3, .h = 4 }
    boxes[1] = Box.{ .x = 1, .y = 2, .w = 3, .h = 5 }
    var height: i32 = 0
    for box in boxes { height += box.h }
    if height != 9 { return 1 }

    // The capture is a value: changing the element through the array in
    // the body does not change it.
    var first_seen: i32 = 0
    for box, index in boxes {
        boxes[index].h = 100
        if index == 0 { first_seen = box.h }
    }
    if first_seen != 4 { return 2 }

    var names: [3][]const u8 = undefined
    names[0] = "ab"
    names[1] = "cde"
    names[2] = "f"
    var total: usize = 0
    for name in names { total += name.length }
    if total != 6 { return 3 }

    var grid: [2][3]u8 = undefined
    grid[0][2] = 3
    grid[1][2] = 6
    var corner: u8 = 0
    for row in grid { corner += row[2] }
    if corner != 9 { return 4 }
    return 13
}
