// std.colorprofile: colour transforms whose pixels are Little CMS's
// (2.14), as the system's Little CMS gave them for the same profiles: an
// RGB profile of wide primaries and gamma 2.2 to the built-in sRGB in
// BGRA (the matrix-shaper optimization of WebKit's decoders, alpha left
// as it is), sRGB to grey, 16-bit RGB (the prelinearized grid), the
// perceptual intent (black point compensation of version 4 profiles);
// the sRGB tone curve; a damaged profile refused.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const std = @import("std")
const cp = @import("std.colorprofile")

fn same8(a: [*]const u8, b: [*]const u8, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn same16(a: [*]const u16, b: [*]const u16, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn pattern(pixels: [*]u8, count: usize) -> void {
    var index: usize = 0
    while index < count {
        pixels[index] = @intCast(u8, (index * 37 + 11) & 255)
        index += 1
    }
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const srgb = cp.createSRGBProfile(allocator)
    if srgb == 0 { return 1 }
    if cp.colorSpace(srgb) != 0x52474220 { return 2 }

    var white: [3]f64 = undefined
    white[0] = 0.3127
    white[1] = 0.3290
    white[2] = 1.0
    var primaries: [9]f64 = undefined
    primaries[0] = 0.68
    primaries[1] = 0.32
    primaries[2] = 1.0
    primaries[3] = 0.265
    primaries[4] = 0.69
    primaries[5] = 1.0
    primaries[6] = 0.15
    primaries[7] = 0.06
    primaries[8] = 1.0
    const gamma = cp.curve.buildGamma(allocator, 2.2)
    var curves: [3]usize = undefined
    curves[0] = gamma
    curves[1] = gamma
    curves[2] = gamma
    const wide = cp.profile.createRGB(allocator, @intFromPtr(&white), @intFromPtr(&primaries), @intFromPtr(&curves))
    if wide == 0 { return 3 }
    var d50: [3]f64 = undefined
    cp.matrix.xyzToxyY(cp.mem.D50X, cp.mem.D50Y, cp.mem.D50Z, &d50)
    const gray = cp.profile.createGray(allocator, @intFromPtr(&d50), gamma)
    if gray == 0 { return 4 }

    // WebKit's decoders: BGRA, relative colorimetry, in place.
    var pixels: [64]u8 = undefined
    pattern(&pixels, 64)
    const bgra = cp.createTransform(allocator, wide, cp.TYPE_BGRA_8, srgb, cp.TYPE_BGRA_8, cp.INTENT_RELATIVE_COLORIMETRIC, 0)
    if bgra == 0 { return 5 }
    cp.transformPixels(bgra, &pixels, &pixels, 16)
    const expectedBgra = [64]u8{ 0, 42, 91, 122, 155, 196, 241, 14, 39, 85, 133, 162, 199, 241, 0, 54, 84, 127, 174, 202, 249, 8, 60, 94, 126, 168, 213, 242, 0, 55, 103, 134, 167, 207, 253, 26, 53, 98, 145, 174, 211, 253, 0, 66, 97, 139, 186, 214, 255, 23, 73, 106, 139, 180, 225, 254, 18, 68, 116, 146, 183, 225, 0, 38 }
    if !same8(&pixels, &expectedBgra, 64) { return 6 }
    cp.deleteTransform(bgra)

    // RGB to grey.
    pattern(&pixels, 64)
    var grays: [16]u8 = undefined
    const toGray = cp.createTransform(allocator, srgb, cp.TYPE_RGB_8, gray, cp.TYPE_GRAY_8, cp.INTENT_RELATIVE_COLORIMETRIC, 0)
    if toGray == 0 { return 7 }
    cp.transformPixels(toGray, &pixels, &grays, 16)
    const expectedGray = [16]u8{ 50, 153, 119, 120, 221, 88, 196, 57, 162, 124, 129, 230, 96, 205, 65, 171 }
    if !same8(&grays, &expectedGray, 16) { return 8 }
    cp.deleteTransform(toGray)

    // 16 bits.
    var words: [24]u16 = undefined
    var index: usize = 0
    while index < 24 {
        words[index] = @intCast(u16, index * 2851 + 77)
        index += 1
    }
    var out16: [24]u16 = undefined
    const wide16 = cp.createTransform(allocator, srgb, cp.TYPE_RGB_16, wide, cp.TYPE_RGB_16, cp.INTENT_RELATIVE_COLORIMETRIC, 0)
    if wide16 == 0 { return 9 }
    unsafe { cp.transformPixels(wide16, @ptrCast([*]const u8, &words), @ptrCast([*]u8, &out16), 8) }
    const expected16 = [24]u16{ 2343, 4912, 7221, 10424, 12380, 14801, 18178, 20244, 22753, 26243, 28380, 30953, 34528, 36719, 39343, 42986, 45222, 47888, 51589, 53861, 56563, 60315, 62618, 20766 }
    if !same16(&out16, &expected16, 24) { return 10 }
    cp.deleteTransform(wide16)

    // The perceptual intent: black point compensation (sRGB is version 4).
    var rgb: [15]u8 = undefined
    const perceptual = cp.createTransform(allocator, wide, cp.TYPE_RGB_8, srgb, cp.TYPE_RGB_8, cp.INTENT_PERCEPTUAL, 0)
    if perceptual == 0 { return 11 }
    cp.transformPixels(perceptual, &pixels, &rgb, 5)
    const expectedPerceptual = [15]u8{ 0, 45, 87, 112, 162, 201, 255, 0, 33, 75, 127, 167, 191, 238, 0 }
    if !same8(&rgb, &expectedPerceptual, 15) { return 12 }
    cp.deleteTransform(perceptual)

    // The sRGB curve: as a float (its bits) and in 16 bits.
    const curve = cp.profile.srgbCurve(allocator)
    const half = cp.curve.evalFloat(cp.curve.curveAt(curve), @floatCast(f32, 0.5))
    if @bitCast(u32, half) != 0x3e5b2d9a { return 14 }
    if cp.curve.eval16(cp.curve.curveAt(curve), 0x4000) != 3334 { return 15 }
    cp.curve.freeCurve(curve)

    // Not a profile: no 'acsp'; too short.
    var junk: [200]u8 = undefined
    index = 0
    while index < 200 {
        junk[index] = @intCast(u8, index & 255)
        index += 1
    }
    if cp.openProfile(allocator, &junk, 200) != 0 { return 16 }
    if cp.openProfile(allocator, &junk, 100) != 0 { return 17 }

    cp.curve.freeCurve(gamma)
    cp.closeProfile(gray)
    cp.closeProfile(wide)
    cp.closeProfile(srgb)
    return 13
}
