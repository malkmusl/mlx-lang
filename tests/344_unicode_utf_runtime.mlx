// std.unicode.utf: UTF-8 and UTF-16 read and written a code point at a
// time (one, two, three and four bytes; surrogate pairs), ill-formed
// UTF-8 read as U+FFFD for each maximal subpart (an overlong form, a
// surrogate, a truncated sequence, a stray trail byte), validity and
// counts, and whole texts converted both ways with an allocator. No
// tables and no C library: the program stays static. Exits 13.
const std = @import("std")
const utf = @import("std.unicode.utf")

fn decodesTo(text: []const u8, codepoint: u32, length: usize) -> bool {
    const decoded = utf.decode8(text, 0)
    return decoded.codepoint == codepoint && decoded.length == length
}

fn run() -> !u8 {
    if !decodesTo("A", 65, 1) || !decodesTo("é", 233, 2) || !decodesTo("€", 8364, 3) || !decodesTo("😀", 128512, 4) { return 1 }
    // Overlong, surrogate, past U+10FFFF, truncated, a lone trail byte.
    if !decodesTo("\xc0\xaf", utf.REPLACEMENT, 1) || !decodesTo("\xed\xa0\x80", utf.REPLACEMENT, 1) { return 2 }
    if !decodesTo("\xf4\x90\x80\x80", utf.REPLACEMENT, 1) || !decodesTo("\xe2\x82", utf.REPLACEMENT, 2) || !decodesTo("\x80", utf.REPLACEMENT, 1) { return 3 }
    var bytes: [4]u8 = undefined
    if utf.encode8(128512, &bytes) != 4 || bytes[0] != 240 || bytes[3] != 128 { return 4 }
    if utf.encode8(55296, &bytes) != 3 || bytes[0] != 239 || bytes[1] != 191 || bytes[2] != 189 { return 5 }
    var units: [2]u16 = undefined
    if utf.encode16(128512, &units) != 2 || units[0] != 55357 || units[1] != 56832 { return 6 }
    if !utf.valid8("grüße, 世界 😀") || utf.valid8("a\xffb") || !utf.valid8("\xef\xbf\xbd") { return 7 }
    if utf.count8("grüße😀") != 6 || utf.units16Of("grüße😀") != 7 { return 8 }

    const allocator = std.page_allocator.init()
    const text16 = try utf.toUtf16(allocator, "a\xffé😀")
    if text16.length != 5 || text16[1] != 65533 || text16[2] != 233 || text16[3] != 55357 { return 9 }
    const decoded = utf.decode16(text16, 3)
    if decoded.codepoint != 128512 || decoded.length != 2 { return 10 }
    const text8 = try utf.toUtf8(allocator, text16)
    if !std.text.same(text8, "a\xef\xbf\xbdé😀") { return 11 }
    utf.free16(allocator, text16)
    utf.free8(allocator, text8)
    // An unpaired surrogate reads as U+FFFD.
    var lone: [2]u16 = [2]u16{ 56320, 65 }
    const lonely = try utf.toUtf8(allocator, lone[0..2])
    if !std.text.same(lonely, "\xef\xbf\xbdA") { return 12 }
    return 13
}

pub fn main() -> !void {
    const code = try run()
    _ = std.linux.syscall1(231, @intCast(usize, code))
}
