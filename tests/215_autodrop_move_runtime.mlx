// @move transfers the sole pending deinitialization obligation.
const OwnedCounter = @noncopy(struct) {
    counter: *u8

    fn deinit(self: *Self) -> void {
        self.*.counter.* += 1
    }
}

fn main() -> u8 {
    var drops: u8 = 0
    {
        const source = OwnedCounter.{ .counter = &drops }
        const destination = @move(source)
    }
    return drops
}
