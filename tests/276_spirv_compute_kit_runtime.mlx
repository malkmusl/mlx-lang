// std.spirv.compute: a kernel declared with compute.declare (floats, two
// buffers, push constants) that uses its helpers (pushWord, load, element,
// select, openIf/closeIf, flagSet, channel, pack, packAlpha, glsl) builds
// a module std.spirv.module validates, with the ids declare promises.
// Exits 13.
const std = @import("std")
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")
const compute = @import("std.spirv.compute")
const module = @import("std.spirv.module")

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var b: builder.Builder = undefined
    builder.init(&b, allocator, spv.version(1, 3))
    var kernel: compute.Kernel = undefined
    compute.declare(&b, &kernel, 3, 2, true)
    if kernel.float == 0 || kernel.glsl == 0 || kernel.buffers[0] == 0 || kernel.buffers[1] == 0 { return 1 }
    if kernel.buffers[0] == kernel.buffers[1] { return 2 }

    const main_function = builder.function(&b, kernel.voidType, spv.FUNCTION_CONTROL_NONE, kernel.functionType)
    const entry = builder.label(&b)
    const id = builder.load(&b, kernel.uvec3, kernel.globalId)
    const x = builder.compositeExtract(&b, kernel.uint, id, 0)
    const width = compute.pushWord(&b, &kernel, 0)
    const flags = compute.pushWord(&b, &kernel, 1)
    const inside = builder.binary(&b, spv.Op.uLessThan, kernel.boolean, x, width)
    const done = compute.openIf(&b, inside)
    const source = compute.load(&b, &kernel, kernel.buffers[1], x)
    const red = compute.channel(&b, &kernel, source, 16)
    const blue = compute.channel(&b, &kernel, source, 0)
    // Red and blue swapped when flag 1 is set.
    const swap = compute.flagSet(&b, &kernel, flags, 1)
    const first = compute.select(&b, kernel.uint, swap, blue, red)
    const last = compute.select(&b, kernel.uint, swap, red, blue)
    const opaque = compute.pack(&b, &kernel, first, compute.channel(&b, &kernel, source, 8), last)
    const half = compute.packAlpha(&b, &kernel, compute.constant(&b, &kernel, 128), first, kernel.zero, last)
    const chosen = compute.select(&b, kernel.uint, compute.flagSet(&b, &kernel, flags, 2), half, opaque)
    // A float through GLSL.std.450: sqrt(x) as a float, kept when above 1.
    const as_float = builder.unary(&b, spv.Op.convertUToF, kernel.float, x)
    var operands: [1]u32 = [1]u32{ as_float }
    var root: u32 = 0
    unsafe { root = compute.glsl(&b, &kernel, compute.GLSL_SQRT, @ptrCast([*]const u32, &operands), 1) }
    const one = builder.constant(&b, kernel.float, 1065353216)
    const big = builder.binary(&b, spv.Op.fOrdGreaterThan, kernel.boolean, root, one)
    const written = compute.select(&b, kernel.uint, big, chosen, kernel.zero)
    builder.store(&b, compute.element(&b, &kernel, kernel.buffers[0], x), written)
    compute.closeIf(&b, done)
    builder.returnVoid(&b)
    builder.functionEnd(&b)
    compute.finish(&b, &kernel, main_function, 8, 8)

    const count = builder.wordCount(&b)
    const memory = allocator.alloc(count * 4, 4)
    if memory == null { return 3 }
    var words: [*]u32 = undefined
    unsafe { words = @ptrCast([*]u32, memory.?) }
    builder.writeWords(&b, words)
    var diagnostic: module.Diagnostic = undefined
    const result = module.validate(words, count, allocator, &diagnostic)
    if result != module.Error.none { return 4 }
    return 13
}
