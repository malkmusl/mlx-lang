// Full reinitialization restores a moved-from binding's drop obligation.
const OwnedCounter = @noncopy(struct) {
    counter: *u8

    fn deinit(self: *Self) -> void {
        self.*.counter.* += 1
    }
}

fn main() -> u8 {
    var drops: u8 = 0
    {
        var source = OwnedCounter.{ .counter = &drops }
        const destination = @move(source)
        source = OwnedCounter.{ .counter = &drops }
    }
    return drops
}
