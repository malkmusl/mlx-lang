const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const lir = @import("../compiler/selfhost/ir/lir.mlx")
const optimize = @import("../compiler/selfhost/ir/optimize.mlx")

pub fn main() -> u8 {
    const allocator: page_allocator.Allocator = page_allocator.init()
    var ir = lir.init(allocator)
    var main_pointer: [*]const u8 = undefined
    unsafe { main_pointer = @ptrCast([*]const u8, "main") }
    const main_symbol = lir.addSymbol(&ir, main_pointer, 4)
    const label = lir.addInst(&ir, lir.labelInst(lir.NONE, main_symbol))
    const value = lir.addInst(&ir, lir.constI(lir.NONE, 13))
    const returned = lir.addInst(&ir, lir.retInst(lir.NONE, value))
    const unreachable_value = lir.addInst(&ir, lir.constI(lir.NONE, 99))
    const unreachable_return = lir.addInst(&ir, lir.retInst(lir.NONE, unreachable_value))

    const result = optimize.run(&ir, allocator)
    if result.postTerminatorInstructionsEliminated != 2 { return 1 }
    if lir.getInst(&ir, label).opcode == lir.Opcode.dead || lir.getInst(&ir, returned).opcode == lir.Opcode.dead { return 2 }
    if lir.getInst(&ir, unreachable_value).opcode != lir.Opcode.dead || lir.getInst(&ir, unreachable_return).opcode != lir.Opcode.dead { return 3 }
    lir.deinit(&ir)
    return 13
}
