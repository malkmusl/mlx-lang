// Inside a function: a generic type bound to a local constant and used
// as a type, and a struct with methods declared locally. Exits 13.
fn Same(comptime T: type) -> type { return T }

fn Box(comptime T: type) -> type {
    return struct {
        value: T

        pub fn get(self: Self) -> T {
            return self.value
        }
    }
}

const Byte = Same(u8)

fn main() -> u8 {
    const value: Byte = 5
    const Local = Same(u16)
    const wide: Local = 300
    const Small = Box(u8)
    const boxed = Small.{ .value = 6 }
    const P = struct {
        a: u8

        pub fn get(self: Self) -> u8 { return self.a }
    }
    const p = P.{ .a = 2 }
    return value + @intCast(u8, wide - 300) + boxed.get() + p.get()
}
