// std.HashMap, std.AutoHashMap and std.StringHashMap: entries put, got,
// replaced, removed and fetched, a map that grows through its rehashes,
// getOrPut, putNoClobber, the iterators (entries, keys, values), clone,
// clearRetainingCapacity and clearAndFree, a context with state (keys
// that are indexes into a table of the caller's), struct keys by
// autoHash, a map dropped where its scope ends (deinit by the language),
// and 100 000 inserts and removes under the leak check with every block
// given back (and a snapshot for `mlx-codemap memory`). Exits 13 on
// success (another number: the check that failed).
const std = @import("std")
const leaks = @import("std.leaks")
const hash = @import("std.hash")

const Point = struct {
    x: i32
    y: i32
}

// A context over keys that are indexes into `names` (what a code index
// keeps: the table holds the names, the map their numbers).
const NameContext = struct {
    names: []const []const u8

    pub fn hash(self: Self, key: u32) -> u64 {
        return hash.wyhash(self.names[@intCast(usize, key)], 0)
    }

    pub fn eql(self: Self, a: u32, b: u32) -> bool {
        const context = hash.StringContext.{}
        return hash.StringContext.eql(context, self.names[@intCast(usize, a)], self.names[@intCast(usize, b)])
    }
}

fn next(seed: *u64) -> u64 {
    seed.* = seed.* *% 6364136223846793005 +% 1442695040888963407
    return seed.* >> 33
}

// A map made and filled in a scope of its own: its deinit runs where
// the scope ends, under the leak check.
fn fillAndDrop(allocator: std.allocator.Allocator) -> usize {
    var map = std.AutoHashMap(u64, u64).init(allocator)
    var at: u64 = 0
    while at < 1000 {
        if !map.put(at, at * 2) { return 0 }
        at += 1
    }
    return map.count()
}

fn main() -> u8 {
    leaks.watchAlways()
    const allocator = std.heap.allocator()
    const live_before = leaks.liveCount()
    {
        // Strings to numbers.
        var names = std.StringHashMap(u32).init(allocator)
        if names.count() != 0 || names.contains("one") || names.get("one") != null { return 1 }
        if !names.put("one", 1) || !names.put("two", 2) || !names.put("three", 3) { return 2 }
        if names.count() != 3 { return 3 }
        const two = names.get("two")
        if two == null || two.? != 2 { return 4 }
        if names.get("four") != null { return 5 }
        // Replaced.
        if !names.put("two", 22) || names.count() != 3 { return 6 }
        if names.get("two").? != 22 { return 7 }
        // By content: a copy of the key finds the entry.
        var copy: [3]u8 = [3]u8{ 111, 110, 101 }
        const copy_bytes: [*]const u8 = &copy
        const copied: []const u8 = copy_bytes[0..3]
        if names.get(copied) == null || names.get(copied).? != 1 { return 8 }
        // A pointer to the value, changed in place.
        const pointer = names.getPtr("three")
        if pointer == null { return 9 }
        pointer.?.* = 33
        if names.get("three").? != 33 { return 10 }
        // putNoClobber: the key there, nothing changes.
        if names.putNoClobber("one", 100) || names.get("one").? != 1 { return 11 }
        if !names.putNoClobber("four", 4) || names.get("four").? != 4 { return 12 }
        // getOrPut: found, and made.
        const found = names.getOrPut("four")
        if !found.0 || found.1 == null || found.1.?.* != 4 { return 14 }
        const made = names.getOrPut("five")
        if made.0 || made.1 == null { return 15 }
        made.1.?.* = 5
        if names.get("five").? != 5 || names.count() != 5 { return 16 }
        // Removed, fetched.
        if !names.remove("one") || names.remove("one") || names.contains("one") || names.count() != 4 { return 17 }
        const fetched = names.fetchRemove("two")
        if fetched == null || fetched.? != 22 || names.fetchRemove("two") != null || names.count() != 3 { return 18 }
        // The iterators: every entry once, the sum of the values.
        var entries = names.iterator()
        var seen: usize = 0
        var sum: u32 = 0
        while true {
            const entry = entries.next()
            if entry == null { break }
            seen += 1
            sum += entry.?.value.*
            if entry.?.key.*.length == 0 { return 19 }
        }
        if seen != 3 || sum != 33 + 4 + 5 { return 20 }
        var keys = names.keyIterator()
        var key_count: usize = 0
        while keys.next() != null { key_count += 1 }
        var values = names.valueIterator()
        var value_sum: u32 = 0
        while true {
            const value = values.next()
            if value == null { break }
            value_sum += value.?.*
        }
        if key_count != 3 || value_sum != 42 { return 21 }
        // Cloned: the same entries, apart.
        const cloned = names.clone()
        if cloned == null { return 22 }
        var clone = cloned.?
        if clone.count() != 3 || clone.get("three").? != 33 { return 23 }
        if !clone.put("six", 6) || names.contains("six") { return 24 }
        // Cleared, the memory kept; then given back.
        const slots_before = names.capacity()
        names.clearRetainingCapacity()
        if names.count() != 0 || names.capacity() != slots_before || names.contains("three") { return 25 }
        if !names.put("again", 1) || names.get("again").? != 1 { return 26 }
        names.clearAndFree()
        if names.count() != 0 || names.capacity() != 0 { return 27 }
        if !names.put("after", 2) || names.get("after").? != 2 { return 28 }
    }
    // Grown through its rehashes: 10 000 numbers, every one found with
    // its value, the others not; half removed, the rest still there.
    {
        var numbers = std.AutoHashMap(u32, u64).init(allocator)
        var at: u32 = 0
        while at < 10000 {
            if !numbers.put(at * 7, @intCast(u64, at)) { return 29 }
            at += 1
        }
        if numbers.count() != 10000 { return 30 }
        if numbers.capacity() < 10000 { return 31 }
        at = 0
        while at < 10000 {
            const value = numbers.get(at * 7)
            if value == null || value.? != @intCast(u64, at) { return 32 }
            if numbers.contains(at * 7 + 1) { return 33 }
            at += 1
        }
        at = 0
        while at < 10000 {
            if at % 2 == 0 && !numbers.remove(at * 7) { return 34 }
            at += 1
        }
        if numbers.count() != 5000 { return 35 }
        at = 0
        while at < 10000 {
            const value = numbers.get(at * 7)
            if at % 2 == 0 && value != null { return 36 }
            if at % 2 == 1 && (value == null || value.? != @intCast(u64, at)) { return 37 }
            at += 1
        }
        // Room asked for ahead of time.
        var roomy = std.AutoHashMap(u32, u32).init(allocator)
        if !roomy.ensureTotalCapacity(5000) || roomy.capacity() < 5000 { return 38 }
        const slots = roomy.capacity()
        at = 0
        while at < 5000 {
            if !roomy.put(at, at) { return 39 }
            at += 1
        }
        if roomy.capacity() != slots { return 40 }
    }
    // Struct keys by autoHash, and a context with state.
    {
        var points = std.AutoHashMap(Point, []const u8).init(allocator)
        if !points.put(Point.{ .x = 1, .y = -1 }, "a") || !points.put(Point.{ .x = 2, .y = 0 }, "b") { return 41 }
        const a = points.get(Point.{ .x = 1, .y = -1 })
        if a == null || !hash.autoEql([]const u8, a.?, "a") { return 42 }
        if points.get(Point.{ .x = -1, .y = 1 }) != null { return 43 }
        const table: [4][]const u8 = [4][]const u8{ "alpha", "beta", "gamma", "alpha" }
        var indexes = std.HashMap(u32, u32, NameContext).initContext(allocator, NameContext.{ .names = table[0..4] })
        if !indexes.put(0, 10) || !indexes.put(1, 11) || !indexes.put(2, 12) { return 44 }
        // Key 3 names "alpha" too: the same entry as key 0.
        if !indexes.contains(3) || indexes.get(3).? != 10 || indexes.count() != 3 { return 45 }
        if !indexes.put(3, 30) || indexes.get(0).? != 30 || indexes.count() != 3 { return 46 }
    }
    // A map dropped where its scope ends: nothing of it is out afterwards.
    if fillAndDrop(allocator) != 1000 { return 47 }
    if leaks.liveCount() != live_before { return 48 }
    // 100 000 inserts and removes, in a pseudo-random order, under the
    // leak check: the map stays right, and every block goes back.
    {
        var stress = std.AutoHashMap(u64, u32).init(allocator)
        var held: [4096]u64 = undefined
        var count: usize = 0
        var seed: u64 = 99
        var round: usize = 0
        while round < 100000 {
            const choice = next(&seed)
            if count < 4096 && (count == 0 || choice % 3 != 0) {
                const key = next(&seed) % 1000000
                if !stress.contains(key) {
                    if !stress.put(key, @intCast(u32, round & 4294967295)) { return 49 }
                    held[count] = key
                    count += 1
                }
            } else {
                const at = @intCast(usize, choice) % count
                if !stress.remove(held[at]) { return 50 }
                count -= 1
                held[at] = held[count]
            }
            round += 1
        }
        if stress.count() != count { return 51 }
        var at: usize = 0
        while at < count {
            if !stress.contains(held[at]) { return 52 }
            at += 1
        }
        leaks.writeNow()
        stress.deinit()
    }
    if leaks.liveCount() != live_before || leaks.problemCount() != 0 { return 53 }
    return 13
}
