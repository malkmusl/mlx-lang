// A @noncopy field is its parent's to drop. The compiler drops the
// bindings that go out of scope, never the fields of what it drops (no
// implicit destructor chain): a parent's deinit calls its fields' deinit,
// and a parent that does not leaves them undropped. Exits 13 on success.
const Child = @noncopy(struct) {
    drops: *u8

    fn deinit(self: *Self) -> void {
        self.*.drops.* += 1
    }
}

const Parent = @noncopy(struct) {
    child: Child
    drops: *u8

    fn deinit(self: *Self) -> void {
        self.*.drops.* += 10
        self.*.child.deinit()
    }
}

const Careless = @noncopy(struct) {
    child: Child

    fn deinit(self: *Self) -> void {}
}

fn Holder(comptime T: type) -> type {
    return @noncopy(struct) {
        inner: T
        drops: *u8

        fn deinit(self: *Self) -> void {
            self.*.drops.* += 100
            self.*.inner.deinit()
        }
    }
}

fn main() -> u8 {
    var child_drops: u8 = 0
    var parent_drops: u8 = 0
    {
        const parent = Parent.{ .child = Child.{ .drops = &child_drops }, .drops = &parent_drops }
    }
    if parent_drops != 10 { return 1 }
    if child_drops != 1 { return 2 }
    {
        const careless = Careless.{ .child = Child.{ .drops = &child_drops } }
    }
    if child_drops != 1 { return 3 }
    {
        const holder = Holder(Child).{ .inner = Child.{ .drops = &child_drops }, .drops = &parent_drops }
    }
    if parent_drops != 110 { return 4 }
    if child_drops != 2 { return 5 }
    return 13
}
