// A compute shader built with std.spirv.builder runs on a Vulkan driver
// opened by std.vulkan.loader (tests/run_vulkan.sh points VK_DRIVER_FILES
// at lavapipe): 256 invocations compute values[i] = values[i] * 2 + i in a
// host-visible storage buffer. Exits 13.
const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")
const module = @import("std.spirv.module")
const doubler = @import("./support/spirv/doubler.mlx")

const COUNT: u32 = 256

fn findMemoryType(properties: *const vk.PhysicalDeviceMemoryProperties, bits: u32, wanted: vk.MemoryPropertyFlags) -> u32 {
    var index: u32 = 0
    while index < properties.*.memoryTypeCount {
        if bits & (@intCast(u32, 1) << @intCast(u5, index)) != 0 && properties.*.memoryTypes[index].propertyFlags & wanted == wanted { return index }
        index += 1
    }
    return 4294967295
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()

    // The shader.
    var shader: builder.Builder = undefined
    builder.init(&shader, allocator, spv.version(1, 3))
    doubler.build(&shader)
    const word_count = builder.wordCount(&shader)
    const code_memory = allocator.alloc(word_count * 4, 4)
    if code_memory == null { return 1 }
    var code: [*]u32 = undefined
    unsafe { code = @ptrCast([*]u32, code_memory.?) }
    builder.writeWords(&shader, code)
    var diagnostic: module.Diagnostic = undefined
    if module.validate(code, word_count, allocator, &diagnostic) != module.Error.none { return 2 }

    // Driver, instance, device.
    var driver: loader.Driver = undefined
    if loader.openFirstDriver(&driver, arguments, allocator) != loader.Status.ok { return 3 }
    var application = vk.ApplicationInfo.init()
    application.apiVersion = vk.API_VERSION_1_1
    var instance_info = vk.InstanceCreateInfo.init()
    instance_info.pApplicationInfo = &application
    var instance: vk.Instance = 0
    if vk.createInstance(driver.global, &instance_info, null, &instance) != vk.Result.success { return 4 }
    var instance_commands: vk.InstanceCommands = undefined
    vk.loadInstanceCommands(&instance_commands, instance, driver.getInstanceProcAddr)
    var physical_count: u32 = 1
    var physical: vk.PhysicalDevice = 0
    const listed = vk.enumeratePhysicalDevices(&instance_commands, instance, &physical_count, &physical)
    if physical_count == 0 { return 5 }
    var memory_properties: vk.PhysicalDeviceMemoryProperties = undefined
    vk.getPhysicalDeviceMemoryProperties(&instance_commands, physical, &memory_properties)
    var families: [8]vk.QueueFamilyProperties = undefined
    var family_count: u32 = 8
    unsafe { vk.getPhysicalDeviceQueueFamilyProperties(&instance_commands, physical, &family_count, @ptrCast([*]vk.QueueFamilyProperties, &families)) }
    var family: u32 = 0
    while family < family_count && families[family].queueFlags & vk.QUEUE_COMPUTE_BIT == 0 { family += 1 }
    if family == family_count { return 6 }
    var queue_info = vk.DeviceQueueCreateInfo.init()
    queue_info.queueFamilyIndex = family
    queue_info.queueCount = 1
    var priority: u32 = 1065353216 // 1.0f
    unsafe { queue_info.pQueuePriorities = @ptrCast([*]const f32, &priority) }
    var device_info = vk.DeviceCreateInfo.init()
    device_info.queueCreateInfoCount = 1
    device_info.pQueueCreateInfos = &queue_info
    var device: vk.Device = 0
    if vk.createDevice(&instance_commands, physical, &device_info, null, &device) != vk.Result.success { return 7 }
    var d: vk.DeviceCommands = undefined
    vk.loadDeviceCommands(&d, device, instance_commands.vkGetDeviceProcAddr)
    var queue: vk.Queue = 0
    vk.getDeviceQueue(&d, device, family, 0, &queue)

    // The storage buffer, filled with 1000 + i.
    var buffer_info = vk.BufferCreateInfo.init()
    buffer_info.size = @intCast(u64, COUNT) * 4
    buffer_info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT
    buffer_info.sharingMode = vk.SharingMode.exclusive
    var buffer: vk.Buffer = 0
    if vk.createBuffer(&d, device, &buffer_info, null, &buffer) != vk.Result.success { return 8 }
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(&d, device, buffer, &requirements)
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.allocationSize = requirements.size
    allocation.memoryTypeIndex = findMemoryType(&memory_properties, requirements.memoryTypeBits, vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT)
    var memory: vk.DeviceMemory = 0
    if vk.allocateMemory(&d, device, &allocation, null, &memory) != vk.Result.success { return 9 }
    if vk.bindBufferMemory(&d, device, buffer, memory, 0) != vk.Result.success { return 10 }
    var mapped: ?*anyopaque = null
    if vk.mapMemory(&d, device, memory, 0, vk.WHOLE_SIZE, 0, &mapped) != vk.Result.success { return 11 }
    var values: [*]u32 = undefined
    unsafe { values = @ptrCast([*]u32, mapped.?) }
    var index: u32 = 0
    while index < COUNT {
        values[index] = 1000 + index
        index += 1
    }

    // Shader module, descriptor set layout, pipeline.
    var module_info = vk.ShaderModuleCreateInfo.init()
    module_info.codeSize = word_count * 4
    module_info.pCode = code
    var shader_module: vk.ShaderModule = 0
    if vk.createShaderModule(&d, device, &module_info, null, &shader_module) != vk.Result.success { return 12 }
    var binding: vk.DescriptorSetLayoutBinding = vk.DescriptorSetLayoutBinding.init()
    binding.binding = 0
    binding.descriptorType = vk.DescriptorType.storageBuffer
    binding.descriptorCount = 1
    binding.stageFlags = vk.SHADER_STAGE_COMPUTE_BIT
    var layout_info = vk.DescriptorSetLayoutCreateInfo.init()
    layout_info.bindingCount = 1
    layout_info.pBindings = &binding
    var set_layout: vk.DescriptorSetLayout = 0
    if vk.createDescriptorSetLayout(&d, device, &layout_info, null, &set_layout) != vk.Result.success { return 14 }
    var pipeline_layout_info = vk.PipelineLayoutCreateInfo.init()
    pipeline_layout_info.setLayoutCount = 1
    pipeline_layout_info.pSetLayouts = &set_layout
    var pipeline_layout: vk.PipelineLayout = 0
    if vk.createPipelineLayout(&d, device, &pipeline_layout_info, null, &pipeline_layout) != vk.Result.success { return 15 }
    var pipeline_info = vk.ComputePipelineCreateInfo.init()
    pipeline_info.stage = vk.PipelineShaderStageCreateInfo.init()
    pipeline_info.stage.stage = vk.SHADER_STAGE_COMPUTE_BIT
    pipeline_info.stage.module = shader_module
    unsafe { pipeline_info.stage.pName = @ptrCast([*]const u8, "main") }
    pipeline_info.layout = pipeline_layout
    var pipeline: vk.Pipeline = 0
    if vk.createComputePipelines(&d, device, 0, 1, &pipeline_info, null, &pipeline) != vk.Result.success { return 16 }

    // Descriptor set pointing at the buffer.
    var pool_size: vk.DescriptorPoolSize = vk.DescriptorPoolSize.init()
    pool_size.type_ = vk.DescriptorType.storageBuffer
    pool_size.descriptorCount = 1
    var pool_info = vk.DescriptorPoolCreateInfo.init()
    pool_info.maxSets = 1
    pool_info.poolSizeCount = 1
    pool_info.pPoolSizes = &pool_size
    var descriptor_pool: vk.DescriptorPool = 0
    if vk.createDescriptorPool(&d, device, &pool_info, null, &descriptor_pool) != vk.Result.success { return 17 }
    var set_allocation = vk.DescriptorSetAllocateInfo.init()
    set_allocation.descriptorPool = descriptor_pool
    set_allocation.descriptorSetCount = 1
    set_allocation.pSetLayouts = &set_layout
    var descriptor_set: vk.DescriptorSet = 0
    if vk.allocateDescriptorSets(&d, device, &set_allocation, &descriptor_set) != vk.Result.success { return 18 }
    var buffer_descriptor: vk.DescriptorBufferInfo = vk.DescriptorBufferInfo.init()
    buffer_descriptor.buffer = buffer
    buffer_descriptor.offset = 0
    buffer_descriptor.range = vk.WHOLE_SIZE
    var write = vk.WriteDescriptorSet.init()
    write.dstSet = descriptor_set
    write.dstBinding = 0
    write.descriptorCount = 1
    write.descriptorType = vk.DescriptorType.storageBuffer
    write.pBufferInfo = &buffer_descriptor
    vk.updateDescriptorSets(&d, device, 1, &write, 0, null)

    // Record, submit, wait.
    var command_pool_info = vk.CommandPoolCreateInfo.init()
    command_pool_info.queueFamilyIndex = family
    var command_pool: vk.CommandPool = 0
    if vk.createCommandPool(&d, device, &command_pool_info, null, &command_pool) != vk.Result.success { return 19 }
    var command_allocation = vk.CommandBufferAllocateInfo.init()
    command_allocation.commandPool = command_pool
    command_allocation.level = vk.CommandBufferLevel.primary
    command_allocation.commandBufferCount = 1
    var commands: vk.CommandBuffer = 0
    if vk.allocateCommandBuffers(&d, device, &command_allocation, &commands) != vk.Result.success { return 20 }
    var begin = vk.CommandBufferBeginInfo.init()
    begin.flags = vk.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
    if vk.beginCommandBuffer(&d, commands, &begin) != vk.Result.success { return 21 }
    vk.cmdBindPipeline(&d, commands, vk.PipelineBindPoint.compute, pipeline)
    vk.cmdBindDescriptorSets(&d, commands, vk.PipelineBindPoint.compute, pipeline_layout, 0, 1, &descriptor_set, 0, null)
    vk.cmdDispatch(&d, commands, COUNT / doubler.LOCAL_SIZE, 1, 1)
    var barrier = vk.MemoryBarrier.init()
    barrier.srcAccessMask = vk.ACCESS_SHADER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_HOST_READ_BIT
    vk.cmdPipelineBarrier(&d, commands, vk.PIPELINE_STAGE_COMPUTE_SHADER_BIT, vk.PIPELINE_STAGE_HOST_BIT, 0, 1, &barrier, 0, null, 0, null)
    if vk.endCommandBuffer(&d, commands) != vk.Result.success { return 22 }
    var fence_info = vk.FenceCreateInfo.init()
    var fence: vk.Fence = 0
    if vk.createFence(&d, device, &fence_info, null, &fence) != vk.Result.success { return 23 }
    var submit = vk.SubmitInfo.init()
    submit.commandBufferCount = 1
    submit.pCommandBuffers = &commands
    if vk.queueSubmit(&d, queue, 1, &submit, fence) != vk.Result.success { return 24 }
    if vk.waitForFences(&d, device, 1, &fence, vk.TRUE, 10000000000) != vk.Result.success { return 25 }

    index = 0
    while index < COUNT {
        if values[index] != (1000 + index) * 2 + index { return 26 }
        index += 1
    }

    vk.unmapMemory(&d, device, memory)
    vk.destroyFence(&d, device, fence, null)
    vk.destroyCommandPool(&d, device, command_pool, null)
    vk.destroyDescriptorPool(&d, device, descriptor_pool, null)
    vk.destroyPipeline(&d, device, pipeline, null)
    vk.destroyPipelineLayout(&d, device, pipeline_layout, null)
    vk.destroyDescriptorSetLayout(&d, device, set_layout, null)
    vk.destroyShaderModule(&d, device, shader_module, null)
    vk.destroyBuffer(&d, device, buffer, null)
    vk.freeMemory(&d, device, memory, null)
    vk.destroyDevice(&d, device, null)
    vk.destroyInstance(&instance_commands, instance, null)
    return 13
}
