// std.glob: stars (several as one, and at either end), "?", sets with
// ranges, negation by "!" and "^", a "]" first as a member, a "[" without
// its "]" as itself; backslash escapes in matches (in sets too) and
// quoted bytes in matchesQuoted, where a backslash is plain. Exits 13
// when every check holds, else the number of the first check that failed.
const glob = @import("std.glob")

pub fn main() -> u8 {
    if !glob.matches("*.mlx", "main.mlx") || glob.matches("*.mlx", "main.mlxx") { return 1 }
    if !glob.matches("a**b", "ab") || !glob.matches("*", "") || glob.matches("?", "") { return 2 }
    if !glob.matches("m?in.*", "main.c") || glob.matches("m?in", "mn") { return 3 }
    if !glob.matches("[a-c]x", "bx") || glob.matches("[a-c]x", "dx") { return 4 }
    if !glob.matches("[!a-c]x", "dx") || !glob.matches("[^a-c]x", "dx") || glob.matches("[!a-c]x", "ax") { return 5 }
    if !glob.matches("[]a]", "]") || !glob.matches("[]a]", "a") || glob.matches("[]a]", "b") { return 6 }
    if !glob.matches("[a-]", "-") || !glob.matches("a[b", "a[b") || glob.matches("a[b", "ab") { return 7 }
    if !glob.matches("\\*", "*") || glob.matches("\\*", "x") || !glob.matches("[\\]]", "]") { return 8 }
    if !glob.matches("*/x", "a/b/x") || !glob.matches("*", ".hidden") { return 9 }
    if !glob.matches("*a*b*c*", "xxaxxbxxcxx") || glob.matches("*a*b*c*", "xxaxxcxxbxx") { return 10 }

    // Quoted bytes: the star of "a*" quoted is itself; a backslash is plain.
    var mask: [3]u8 = [3]u8{ 0, 1, 0 }
    const quoted: [*]const u8 = &mask
    if !glob.matchesQuoted("a*b", quoted, "a*b") || glob.matchesQuoted("a*b", quoted, "axxb") { return 11 }
    var plain: [3]u8 = [3]u8{ 0, 0, 0 }
    const unquoted: [*]const u8 = &plain
    if !glob.matchesQuoted("a*b", unquoted, "axxb") { return 12 }
    if !glob.matchesQuoted("\\?", unquoted, "\\x") { return 14 }
    return 13
}
