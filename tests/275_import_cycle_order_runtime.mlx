// An import cycle (tests/support/import_cycle: lib.mlx and part.mlx import
// each other, part's signatures use lib's types) reached through a module
// that uses it (user.mlx, loaded first). The declarations are analyzed
// cycle first: at the module the cycle's others import, once no other
// cycle is waited for; a module only waiting for the cycle is never where
// it is broken. Picking the first loaded module waiting (user.mlx) failed
// with "declaration type could not be resolved". Exits 13.
const user = @import("./support/import_cycle/user.mlx")

pub fn main() -> u8 {
    var state = user.start(5)
    return @intCast(u8, user.run(&state))
}
