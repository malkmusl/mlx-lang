// std.webp's decoders (std.webp.vp8, vp8l, alpha, decode, demux): small
// files made by libwebp's encoder, each with the 8-bit RGBA the system's
// libwebp decodes it to: lossy, lossless, lossy with a lossless alpha
// plane and with a raw one (gradient-filtered), and an animation (its
// first frame, and the demuxer's canvas, loop, background and frames).
// The incremental decoder fed a file cut short finishes the rows libwebp
// finishes (its last_y). Then damaged data: not a WebP, cut short. And
// the encoder: a picture with alpha encoded (losslessly) and decoded
// again is the same picture.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const std = @import("std")
const webp = @import("std.webp")

const io = webp.io
const decode = webp.decode
const demux = webp.demux

fn same(a: [*]const u8, b: [*]const u8, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// Decodes FILE (LENGTH bytes); true when it is WIDTH x HEIGHT with the
// pixels EXPECTED.
fn decodes(file: [*]const u8, length: usize, width: usize, height: usize, expected: [*]const u8) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var picture: webp.Picture = undefined
    if webp.decodeRgba(&picture, file, length, allocator) != webp.Status.ok { return false }
    const good = picture.width == width && picture.height == height && same(picture.pixels, expected, width * height * 4)
    webp.deinitPicture(&picture)
    return good
}

fn status(file: [*]const u8, length: usize) -> webp.Status {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var picture: webp.Picture = undefined
    const result = webp.decodeRgba(&picture, file, length, allocator)
    if result == webp.Status.ok { webp.deinitPicture(&picture) }
    return result
}

// The incremental decoder given the first CUT bytes of FILE at once (as
// WebPIUpdate); true when it answers STATUS with LAST_Y rows done.
fn rowsDone(file: [*]const u8, cut: usize, expectedStatus: i32, lastY: i64) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const address = decode.newDecoder(0, 0, allocator)
    const idec = decode.idecAt(address)
    idec.*.output.colorspace = io.MODE_RGBA
    const result = decode.update(idec, @intFromPtr(file), cut)
    var rows: i64 = 0 - 1
    const output = decode.outputBuffer(idec)
    if output != 0 && io.rgbaOf(io.bufferAt(output)) != 0 { rows = idec.*.params.lastY }
    decode.deleteDecoder(address)
    return result == expectedStatus && rows == lastY
}

pub fn main() -> u8 {
    if !decodes(&lossyFile, 212, 13, 11, &lossyPixels) { return 1 }
    if !decodes(&losslessFile, 158, 13, 11, &losslessPixels) { return 2 }
    if !decodes(&alphaLosslessFile, 208, 9, 7, &alphaLosslessPixels) { return 3 }
    if !decodes(&alphaRawFile, 220, 9, 7, &alphaRawPixels) { return 4 }
    if !decodes(&animationFile, 538, 13, 11, &animationPixels) { return 5 }

    // The animation's demuxer.
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var state: i32 = 0
    const d = demux.create(@intFromPtr(&animationFile), 538, true, &state, allocator)
    if d == 0 || state != demux.DONE { return 6 }
    const dm = demux.demuxerAt(d)
    if demux.getI(dm, demux.CANVAS_WIDTH) != 13 || demux.getI(dm, demux.CANVAS_HEIGHT) != 11 { return 7 }
    if demux.getI(dm, demux.FRAME_COUNT) != 4 || demux.getI(dm, demux.LOOP_COUNT) != 3 { return 8 }
    if demux.getI(dm, demux.BACKGROUND_COLOR) != 0x80ff8040 { return 9 }
    var frame: demux.Iterator = undefined
    if !demux.getFrame(d, 3, &frame) { return 10 }
    if frame.xOffset != 2 || frame.yOffset != 0 || frame.width != 7 || frame.height != 6 || frame.duration != 90 { return 11 }
    if frame.disposeMethod != demux.DISPOSE_NONE || frame.blendMethod != demux.NO_BLEND || frame.hasAlpha != 1 { return 12 }
    if frame.fragmentBytes != @intFromPtr(&animationFile) + 332 || frame.fragmentSize != 98 { return 14 }
    if !demux.nextFrame(&frame) || frame.frameNum != 4 || frame.blendMethod != demux.BLEND || frame.xOffset != 4 { return 15 }
    if demux.nextFrame(&frame) { return 16 }
    demux.delete(d)

    // Rows done as the data comes (libwebp's last_y).
    if !rowsDone(&rowsFile, 100, io.SUSPENDED, 0 - 1) { return 17 }
    if !rowsDone(&rowsFile, 350, io.SUSPENDED, 7) { return 18 }
    if !rowsDone(&rowsFile, 600, io.SUSPENDED, 23) { return 19 }
    if !rowsDone(&rowsFile, 678, io.OK, 40) { return 20 }
    if !rowsDone(&rowsLosslessFile, 260, io.SUSPENDED, 16) { return 21 }
    if !rowsDone(&rowsLosslessFile, 300, io.SUSPENDED, 32) { return 22 }
    if !rowsDone(&rowsLosslessFile, 304, io.OK, 40) { return 23 }

    // Damaged data.
    var copy: [400]u8 = undefined
    var index: usize = 0
    while index < 212 {
        copy[index] = lossyFile[index]
        index += 1
    }
    const view: [*]const u8 = &copy
    if status(view, 212) != webp.Status.ok { return 24 }
    copy[0] = 0x51
    if status(view, 212) != webp.Status.notWebP { return 25 }
    copy[0] = 0x52
    if status(view, 100) != webp.Status.corrupt { return 26 }
    if status(view, 10) != webp.Status.notWebP { return 27 }

    // The encoder's round trip.
    var encoded: webp.encode.Bytes = undefined
    webp.encode.initBytes(&encoded, allocator)
    if !webp.encodeRgba(&encoded, &alphaLosslessPixels, 9, 7) { return 28 }
    const file: [*]const u8 = unsafe { @ptrFromInt([*]const u8, encoded.data) }
    if !decodes(file, encoded.size, 9, 7, &alphaLosslessPixels) { return 29 }
    webp.encode.freeBytes(&encoded)
    return 13
}

