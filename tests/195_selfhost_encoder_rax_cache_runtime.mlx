const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const encoder = @import("../compiler/selfhost/backend/x86_64/encoder.mlx")
const target = @import("../compiler/selfhost/backend/x86_64/target.mlx")

pub fn main() -> u8 {
    const allocator = page_allocator.init()
    var value = encoder.init(allocator)
    encoder.emitMovRegMem(&value, target.Register.rax, 24)
    const first_length = encoder.pos(&value)
    encoder.emitMovRegMem(&value, target.Register.rax, 24)
    if encoder.pos(&value) != first_length || encoder.cachedRaxLoads(&value) != 1 { return 1 }
    encoder.emitAdd(&value, target.Register.rax, target.Register.rcx)
    encoder.emitMovRegMem(&value, target.Register.rax, 24)
    if encoder.pos(&value) == first_length + 3 { return 2 }
    encoder.deinit(&value)
    return 13
}
