// A program's globals that start zero in its .bss, in memory only
// (tests/support/zero_data.mlx): undefined and zero ones of many shapes
// (a 4 MiB array, arrays of words and of structs, structs of zeros, an
// integer, a bool, a float, a null pointer, an undefined slice, a null
// optional, a pointer the start writes, vectors aligned to 16) beside
// ones with a value (a word, -0.0, a struct and an array partly zero, a
// byte, true, a float, an optional holding 0). The program's file is
// smaller than they are, its writable segment's memory size covers them
// and its file size does not, a .bss section (SHT_NOBITS) names them and
// says their alignment, .data the others, every byte reads zero at the
// start and at its alignment, and writing them changes none of the
// others.
// Naming a C function makes this a dynamically linked program (object/
// elf64_dynamic.mlx); tests/support/zero_data_static.mlx is the same
// program static (object/elf64.mlx), tests/run_std_modules.sh runs both.
// Exits 13.
const zero_data = @import("./support/zero_data.mlx")

extern("c") fn getpid() -> i32

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length > 64 { _ = getpid() }
    return zero_data.check()
}
