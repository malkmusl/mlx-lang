// A module bound to a local constant in a function body (`const io =
// std.io`, `const x = @import("./x.mlx")`) or imported in place
// (`@import("./x.mlx").VALUE`): calls, values and types through it reach
// the module's declarations as through a module-level alias (the backend
// had no name for the callee: MLX-E3004 without a symbol, or a crash in
// the encoder; a value read through it was garbage). Exits 13 when every
// check holds, else the number of the first check that failed.
const std = @import("std")

fn viaLocal() -> usize {
    const text = std.text
    const io = std.io
    if !io.print("") { return 1 }
    const bytes = "abc"
    if !text.same(bytes, "abc") { return 2 }
    const sink = io.stderr()
    _ = sink
    return 0
}

pub fn main() -> u8 {
    const failed = viaLocal()
    if failed != 0 { return @intCast(u8, failed) }
    const fs = std.fs
    var status: fs.Stat = undefined
    if fs.status("/".pointer, &status) != 0 { return 3 }
    // Imported in a body, and in place.
    const x = @import("./support/body_import.mlx")
    if x.VALUE != 70 { return 4 }
    if x.seven() != 7 { return 5 }
    if @import("./support/body_import.mlx").VALUE != 70 { return 6 }
    if @import("./support/body_import.mlx").seven() != 7 { return 7 }
    const io = @import("std.io")
    if !io.print("") { return 8 }
    return 13
}
