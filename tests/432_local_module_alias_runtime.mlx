// A module bound to a local constant in a function body (`const io =
// std.io`): calls and values through it reach the module's declarations
// as through a module-level alias (the backend had no name for the
// callee: MLX-E3004 without a symbol). Exits 13 when every check holds,
// else the number of the first check that failed.
const std = @import("std")

fn viaLocal() -> usize {
    const text = std.text
    const io = std.io
    if !io.print("") { return 1 }
    const bytes = "abc"
    if !text.same(bytes, "abc") { return 2 }
    const sink = io.stderr()
    _ = sink
    return 0
}

pub fn main() -> u8 {
    const failed = viaLocal()
    if failed != 0 { return @intCast(u8, failed) }
    const fs = std.fs
    var status: fs.Stat = undefined
    if fs.status("/".pointer, &status) != 0 { return 3 }
    return 13
}
