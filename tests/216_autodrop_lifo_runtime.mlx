// Automatic deinitializers share lexical LIFO ordering.
const OwnedDigit = @noncopy(struct) {
    result: *u8
    digit: u8

    fn deinit(self: *Self) -> void {
        self.*.result.* = self.*.result.* * 10 + self.*.digit
    }
}

fn main() -> u8 {
    var result: u8 = 0
    {
        const first = OwnedDigit.{ .result = &result, .digit = 1 }
        const second = OwnedDigit.{ .result = &result, .digit = 2 }
    }
    return result
}
