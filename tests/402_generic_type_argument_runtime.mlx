// A comptime type argument that is not a type name written out: a
// constant bound to `@childType(T)`, `@typeOf(a[0])`, a literal type with
// index expressions as the other arguments, from inside another generic.
// The instance is the resolved type's, and the arguments are evaluated in
// the caller's instance. Exits 13 on success (a bit per failing variant
// otherwise).
fn leaf(comptime T: type, a: T, b: T) -> bool {
    return a == b
}

// The element type bound to a constant first.
fn variantV(comptime T: type, a: T, b: T) -> bool {
    const Element = @childType(T)
    return leaf(Element, a[0], b[0])
}

// The same, in a loop with locals.
fn variantW(comptime T: type, a: T, b: T) -> bool {
    const Element = @childType(T)
    if a.length != b.length { return false }
    var at: usize = 0
    while at < a.length {
        if !leaf(Element, a[at], b[at]) { return false }
        at += 1
    }
    return true
}

// The element type bound, locals typed by it, then the generic call.
fn variantW2(comptime T: type, a: T, b: T) -> bool {
    const Element = @childType(T)
    if a.length != b.length { return false }
    var at: usize = 0
    while at < a.length {
        const x: Element = a[at]
        const y: Element = b[at]
        if !leaf(Element, x, y) { return false }
        at += 1
    }
    return true
}

// A literal element type, index arguments, in a generic.
fn variantX(comptime T: type, a: T, b: T) -> bool {
    var at: usize = 0
    while at < a.length {
        if !leaf(u8, a[at], b[at]) { return false }
        at += 1
    }
    return true
}

// The type of an expression as the argument.
fn variantY(comptime T: type, a: T, b: T) -> bool {
    const x: @childType(T) = a[0]
    const y: @childType(T) = b[0]
    return leaf(@typeOf(a[0]), x, y)
}

fn main() -> u8 {
    var failures: u8 = 0
    if !variantV([]const u8, "abc", "abc") { failures |= 1 }
    if !variantW([]const u8, "abc", "abc") { failures |= 2 }
    if variantV([]const u8, "abc", "xbc") { failures |= 4 }
    if variantW([]const u8, "abc", "abd") { failures |= 8 }
    var numbers: [3]u32 = [3]u32{ 1, 2, 3 }
    var others: [3]u32 = [3]u32{ 1, 2, 4 }
    if !variantW([]const u32, numbers[0..3], numbers[0..3]) { failures |= 16 }
    if variantW([]const u32, numbers[0..3], others[0..3]) { failures |= 32 }
    if !variantW2([]const u8, "abc", "abc") || variantW2([]const u8, "abc", "abd") { failures |= 64 }
    var starts: [3]u32 = [3]u32{ 7, 2, 3 }
    if !variantX([]const u8, "abc", "abc") || !variantY([]const u8, "abc", "abc") || variantY([]const u32, numbers[0..3], starts[0..3]) { failures |= 128 }
    if !variantW2([]const u32, numbers[0..3], numbers[0..3]) || variantW2([]const u32, numbers[0..3], others[0..3]) { failures |= 64 }
    if failures != 0 { return failures }
    return 13
}
