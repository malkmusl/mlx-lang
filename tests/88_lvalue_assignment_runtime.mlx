const Pair = struct {
    left: u8
    right: u8
}

fn main() u8 {
    var pair: Pair = Pair.{ .left = 3, .right = 4 }
    pair.left += 2
    var values: [2]u8 = [2]u8{ 5, 6 }
    values[1] *= 2
    var extra: u8 = 7
    const pointer = &extra
    pointer.* += 1
    return pair.left + values[1] + pointer.*
}
