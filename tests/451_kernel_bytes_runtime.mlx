// The kernel's Bytes.fill and Bytes.copy (projects/brix/kernel/bytes.mlx,
// built for the host) give the bytes a byte loop gives: at the lengths
// where their loops hand over to one another, sixteen alignments, guards
// on both sides, ranges apart (the kernel copies no others).
// Exits 13.
const std = @import("std")
const Bytes = @import("../projects/brix/kernel/bytes.mlx").Bytes

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn at(base: [*]u8, offset: usize) -> [*]u8 { return unsafe { @ptrFromInt([*]u8, @intFromPtr(base) + offset) } }

const ROOM: usize = 24000

fn same(a: [*]const u8, b: [*]const u8, n: usize) -> bool {
    var k: usize = 0
    while k < n {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

fn paint(b: [*]u8, c: [*]u8) -> void {
    var k: usize = 0
    while k < ROOM {
        b[k] = 0xEE
        c[k] = 0xEE
        k += 1
    }
}

fn both(b: [*]u8, c: [*]u8, a: [*]const u8) -> void {
    var k: usize = 0
    while k < ROOM {
        b[k] = a[k]
        c[k] = a[k]
        k += 1
    }
}

// The next length to try: every one to 96, then those around where one
// loop hands over to the next (half a KiB, a KiB, a page, a page and a
// half, two pages), to the end at 9300.
fn next(length: usize) -> usize {
    if length < 96 { return length + 1 }
    const marks = [_]usize{ 500, 1010, 2040, 4080, 4590, 5100, 8180, 9270 }
    var k: usize = 0
    while k < 8 {
        if length < marks[k] { return marks[k] }
        if length < marks[k] + 44 { return length + 1 }
        k += 1
    }
    return 9301
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const a = allocator.alloc(ROOM, 4096).?
    const b = allocator.alloc(ROOM, 4096).?
    const c = allocator.alloc(ROOM, 4096).?
    var seed: usize = 7
    var k: usize = 0
    while k < ROOM {
        seed = (seed *% 6364136223846793005) +% 1442695040888963407
        a[k] = @intCast(u8, (seed >> 33) & 255)
        k += 1
    }
    var cases: usize = 0
    var bad: usize = 0
    var length: usize = 0
    while length <= 9300 {
        var offset: usize = 0
        while offset < 16 {
            // fill 0 and fill nonzero
            var v: usize = 0
            while v < 2 {
                const value: u8 = if v == 0 { 0 } else { @intCast(u8, 1 + (length * 13 + offset) % 255) }
                paint(b, c)
                Bytes.fill(at(b, 64 + offset), length, value)
                k = 0
                while k < length {
                    c[64 + offset + k] = value
                    k += 1
                }
                if !same(b, c, ROOM) {
                    bad += 1
                    if bad < 5 {
                        say("fill differs at length ")
                        number(length)
                        say("\n")
                    }
                }
                cases += 1
                v += 1
            }
            // copy apart, the source at another alignment
            const so = (offset * 5 + 3) % 16
            paint(b, c)
            Bytes.copy(at(b, 64 + offset), at(a, so), length)
            k = 0
            while k < length {
                c[64 + offset + k] = a[so + k]
                k += 1
            }
            if !same(b, c, ROOM) {
                bad += 1
                if bad < 5 {
                    say("copy differs at length ")
                    number(length)
                    say("\n")
                }
            }
            cases += 1
            offset += 1
        }
        length = next(length)
    }
    number(cases)
    say(" cases of fill and copy apart; differing: ")
    number(bad)
    say("\n")
    return if bad == 0 { 13 } else { 1 }
}
