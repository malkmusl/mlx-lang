// std.fs's whole files, in a folder of the test's own under /tmp:
// makeDirectories makes a nested folder (and says so again when it is
// there), makeParents the folders of a file; writeFile writes a file that
// readFile, readFileResult and readFileAlloc read back whole (or its first
// bytes into a short buffer); replaceFile replaces it and leaves no .new;
// a missing file reads as 0, -1 and null; executablePath names this
// program. Exits 13 when every check holds, else the number of the first
// check that failed.
const std = @import("std")

const fs = std.fs

fn same(bytes: [*]const u8, length: usize, expected: []const u8) -> bool {
    return std.text.same(bytes[0..length], expected)
}

pub fn main() -> u8 {
    var root: [128]u8 = undefined
    const root_bytes: [*]u8 = &root
    var length = std.text.append(root_bytes, 0, 128, "/tmp/mlx-test-353-")
    length = std.text.appendUnsigned(root_bytes, length, 128, @bitCast(usize, std.linux.syscall0(39)))
    const root_length = length
    root[length] = 0
    if fs.exists(root_bytes) { _ = fs.removeTree(root_bytes) }

    // A folder three levels down, made twice.
    length = std.text.append(root_bytes, root_length, 128, "/a/b/c")
    if !fs.makeDirectories(root_bytes[0..length], 448) { return 1 }
    root[length] = 0
    if !fs.isDirectory(root_bytes) { return 2 }
    if !fs.makeDirectories(root_bytes[0..length], 448) { return 3 }

    // The folders of a file, then the file.
    length = std.text.append(root_bytes, root_length, 128, "/d/e/file.txt")
    if !fs.makeParents(root_bytes[0..length], 493) { return 4 }
    root[length] = 0
    if fs.exists(root_bytes) { return 5 }
    const text = "first line\nsecond line\n"
    if !fs.writeFile(root_bytes, text.pointer, text.length, 420) { return 6 }
    if fs.isDirectory(root_bytes) { return 7 }

    var buffer: [64]u8 = undefined
    const buffer_bytes: [*]u8 = &buffer
    const read = fs.readFile(root_bytes, buffer_bytes, 64)
    if !same(buffer_bytes, read, text) { return 8 }
    // A short buffer gets the first bytes.
    if fs.readFileResult(root_bytes, buffer_bytes, 5) != 5 || !same(buffer_bytes, 5, "first") { return 9 }
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const loaded = fs.readFileAlloc(root_bytes, allocator)
    if loaded == null { return 10 }
    const contents = loaded.?
    if !same(contents.items, contents.length, text) { return 11 }
    fs.ArrayList.deinit(contents)

    // Replaced whole: the new bytes, and no PATH.new after.
    if !fs.replaceFile(root_bytes, "new".pointer, 3, 384) { return 12 }
    if !same(buffer_bytes, fs.readFile(root_bytes, buffer_bytes, 64), "new") { return 14 }
    var status: fs.Stat = undefined
    if fs.status(root_bytes, &status) != 0 || status.mode & 511 != 384 { return 15 }
    length = std.text.append(root_bytes, length, 128, ".new")
    root[length] = 0
    if fs.exists(root_bytes) { return 16 }

    // A file that is not there.
    if fs.readFile(root_bytes, buffer_bytes, 64) != 0 { return 17 }
    if fs.readFileResult(root_bytes, buffer_bytes, 64) != -1 { return 18 }
    if fs.readFileAlloc(root_bytes, allocator) != null { return 19 }

    // This program's own path ends with its name.
    var own: [4096]u8 = undefined
    const own_bytes: [*]u8 = &own
    const own_length = fs.executablePath(own_bytes, 4096)
    if own_length == 0 || own[0] != 47 || own[own_length] != 0 { return 20 }
    if !std.text.endsWith(own_bytes[0..own_length], "353_fs_whole_files_runtime") { return 21 }
    // A tiny buffer still ends in a NUL.
    if fs.executablePath(own_bytes, 4) != 3 || own[3] != 0 { return 22 }

    root[root_length] = 0
    if !fs.removeTree(root_bytes) { return 23 }
    return 13
}
