// Our Vulkan driver (projects/brix/vulkan) on the kernel's native calls 80
// to 85 served for real (projects/brix/kernel/gpu_work.mlx), on the host:
// the driver's interface to the kernel answered by the kernel's own code
// (tests/support/calls_card.mlx: the record as gpu_offer.mlx makes it, the
// contexts as gpu_programs.mlx keeps them, the records and statuses as
// native/gpucalls.mlx turns them) on the user's RX 580 as the table of
// tests 504 to 507 and 517 after stages 0 to 7, the programs' buffers
// that the kernel copied, checked and put on compute ring 0 run by the
// Vulkan host card's engine over what the address space's table maps.
// Where the driver's own path cannot run here (card_brix.mlx is the
// native calls themselves), the word-for-word contract between it,
// std.gpucard and the kernel:
// - the contract: the calls' numbers, a stream record's bytes as the
//   kernel decodes them, the flags of memory, mapping, engines and fence
//   states, every status the driver tells apart, the record's flag and
//   reason for the calls;
// - the driver on the card: one physical device, its memory as the kernel
//   gives it (the card's memory beyond the aperture device local, the
//   system's host visible, no device-local type the processor maps),
//   vkCreateDevice with its self-test (the doubler and the division) run
//   on the card through the kernel's checks, a copy through the card's
//   own memory (cleared by the kernel, word for word), everything given
//   back at the end;
// - the self-test failing on the card: a reciprocal a unit high refuses
//   the device; a card that hangs in the self-test refuses it and, the
//   watchdog's ten seconds later, leaves compute ring 0 down: the next
//   vkCreateDevice refused with the record's reason, the vkinfo line;
// - a device lost: a hang after it was made (the fence's wait answers
//   VK_ERROR_DEVICE_LOST, later submits too); a fault in its address space
//   (a copy from memory given back) loses that device alone, another goes
//   on;
// - the compositor's choice at start on brixOS (projects/desktop/
//   compositor/card_choice.mlx): the first frame held against the
//   processor's pixel for pixel, and its one line for every outcome.
// Run from the repository root. With an argument, the kernel's log of
// every case is printed.
// Exits 13.
const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")
const gpucard = @import("std.gpucard")
const driver = @import("../projects/brix/vulkan/driver.mlx")
const device = @import("../projects/brix/vulkan/device.mlx")
const selftest = @import("../projects/brix/vulkan/selftest.mlx")
const work = @import("../projects/brix/kernel/gpu_work.mlx")
const record = @import("../projects/brix/kernel/gpu_record.mlx")
const Status = @import("../projects/brix/kernel/status.mlx").Status
const choice = @import("../projects/desktop/compositor/card_choice.mlx")
const calls = @import("./support/calls_card.mlx")
const engine = @import("./support/engine_card.mlx")
const crash = @import("std.crash")

const brix = std.os.brix

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(engine.has(text), text) }

fn shown() -> void {
    if show {
        say(engine.log[0..engine.logged])
        say("--\n")
    }
}

fn equal(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

const MIB: usize = 1024 * 1024
const SYSTEM_MOST: usize = 64 * MIB

// ---- The contract.

fn contract() -> void {
    expect(gpucard.GPU_MEMORY == brix.NATIVE_BASE + work.FIRST_CALL && gpucard.GPU_MEMORY_OF == gpucard.GPU_MEMORY + 1 && gpucard.GPU_MAP == gpucard.GPU_MEMORY + 2 && gpucard.GPU_UNMAP == gpucard.GPU_MEMORY + 3 && gpucard.GPU_SUBMIT == gpucard.GPU_MEMORY + 4 && gpucard.GPU_FENCE == gpucard.GPU_MEMORY + 5, "the six calls' numbers: NATIVE_BASE + 80 to 85, the kernel's")
    // A stream record as std.gpucard lays it out, read by the kernel.
    expect(@sizeOf(gpucard.Stream) == work.STREAM_BYTES, "a stream record is 24 bytes")
    var records = [2]gpucard.Stream{ gpucard.Stream.{ .engine = gpucard.Engine.COPY, .flags = 0x5A5A0001, .address = 0x0000012345678A00, .words = 0x0000000100000008 }, gpucard.Stream.{ .engine = gpucard.Engine.COMPUTE, .flags = 0, .address = 0x200000, .words = 64 } }
    const bytes: [*]const u8 = unsafe { @ptrCast([*]const u8, &records) }
    const one = work.streamOf(bytes, 0)
    const two = work.streamOf(bytes, 1)
    expect(one.engine == 2 && one.flags == 0x5A5A0001 && one.address == 0x0000012345678A00 && one.words == 0x0000000100000008, "the first record's fields, every byte where the kernel reads it")
    expect(two.engine == @intCast(u32, work.COMPUTE) && two.flags == 0 && two.address == 0x200000 && two.words == 64, "the second record 24 bytes on")
    expect(gpucard.Memory.CARD == work.CARD && gpucard.Memory.SYSTEM == work.SYSTEM && gpucard.Memory.EITHER == work.EITHER && gpucard.Memory.PROCESSOR == work.PROCESSOR && gpucard.Memory.WRITE_COMBINED == work.WRITE_COMBINED && gpucard.Memory.ZEROED == work.ZEROED && gpucard.Memory.LOW == work.LOW && gpucard.Memory.SHAREABLE == work.SHAREABLE, "gpu_memory's flags")
    expect(gpucard.Access.READ == work.READ && gpucard.Access.WRITE == work.WRITE && gpucard.Access.EXECUTE == work.EXECUTE, "gpu_map's rights")
    expect(@intCast(usize, gpucard.Engine.GRAPHICS) == work.GRAPHICS && @intCast(usize, gpucard.Engine.COMPUTE) == work.COMPUTE && @intCast(usize, gpucard.Engine.COPY) == work.COPY, "the engines")
    expect(brix.State.READABLE == work.READABLE && brix.State.PEER_GONE == work.PEER_GONE, "a fence's states")
    // Every status the calls answer, as the native call gives it.
    expect(Status.code(Status.invalid_handle) == brix.Status.invalid_handle && Status.code(Status.wrong_kind) == brix.Status.wrong_kind && Status.code(Status.no_right) == brix.Status.no_right && Status.code(Status.timed_out) == brix.Status.timed_out && Status.code(Status.not_found) == brix.Status.not_found && Status.code(Status.exists) == brix.Status.exists, "the statuses (1)")
    expect(Status.code(Status.no_memory) == brix.Status.no_memory && Status.code(Status.bad_address) == brix.Status.bad_address && Status.code(Status.invalid) == brix.Status.invalid && Status.code(Status.peer_gone) == brix.Status.peer_gone && Status.code(Status.unsupported) == brix.Status.unsupported && Status.code(Status.busy) == brix.Status.busy, "the statuses (2)")
    expect(Status.code(Status.peer_gone) == device.PEER_GONE && Status.code(Status.timed_out) == device.TIMED_OUT && Status.code(Status.no_memory) == device.NO_MEMORY && Status.code(Status.too_many) == device.TOO_MANY, "the four the driver tells apart: peer_gone 11, timed_out 5, no_memory 8, too_many 21")
    expect(gpucard.Flag.PROGRAMS == record.Flag.PROGRAMS && gpucard.Why.RING_DOWN == record.Why.RING_DOWN && record.Why.RING_DOWN == work.WHY_RING_DOWN && gpucard.RECORD == record.RECORD, "the record's flag for the calls, its reason 4, its size")
}

// ---- The driver over the kernel's calls, through the loader.

var instanceCommands: vk.InstanceCommands = undefined
var deviceCommands: vk.DeviceCommands = undefined
var opened: loader.Driver = undefined
var instance: vk.Instance = 0
var physical: vk.PhysicalDevice = 0
var memoryProperties: vk.PhysicalDeviceMemoryProperties = undefined

// An argument list whose environment names no manifest of the host's.
var block: [3][*]const u8 = undefined

fn noManifests() -> [][*]const u8 {
    block[0] = unsafe { @ptrFromInt([*]const u8, 0) }
    block[1] = "VK_DRIVER_FILES=/nonexistent/none.json".pointer
    block[2] = unsafe { @ptrFromInt([*]const u8, 0) }
    return block[0..0]
}

// The driver offered over the kernel's calls and an instance made: how
// many physical devices it has.
fn start() -> u32 {
    _ = driver.offer(calls.interface())
    var manifests: loader.Manifests = undefined
    _ = loader.findDrivers(&manifests, noManifests(), std.heap.allocator())
    _ = loader.openDriver(&opened, loader.manifestAt(&manifests, 0), std.heap.allocator())
    var application = vk.ApplicationInfo.init()
    application.apiVersion = vk.API_VERSION_1_1
    var info = vk.InstanceCreateInfo.init()
    info.pApplicationInfo = &application
    instance = 0
    _ = vk.createInstance(opened.global, &info, null, &instance)
    vk.loadInstanceCommands(&instanceCommands, instance, opened.getInstanceProcAddr)
    var count: u32 = 1
    physical = 0
    _ = vk.enumeratePhysicalDevices(&instanceCommands, instance, &count, unsafe { @ptrCast([*]vk.PhysicalDevice, &physical) })
    if count == 1 { vk.getPhysicalDeviceMemoryProperties(&instanceCommands, physical, &memoryProperties) }
    return count
}

fn stop() -> void {
    if instance != 0 { vk.destroyInstance(&instanceCommands, instance, null) }
    instance = 0
}

// vkCreateDevice on the physical device (its self-test runs in it).
fn makeDevice(into: *vk.Device) -> vk.Result {
    var queueInfo = vk.DeviceQueueCreateInfo.init()
    queueInfo.queueFamilyIndex = 0
    queueInfo.queueCount = 1
    var priority: u32 = 1065353216
    queueInfo.pQueuePriorities = unsafe { @ptrCast([*]const f32, &priority) }
    var deviceInfo = vk.DeviceCreateInfo.init()
    deviceInfo.queueCreateInfoCount = 1
    deviceInfo.pQueueCreateInfos = unsafe { @ptrCast([*]const vk.DeviceQueueCreateInfo, &queueInfo) }
    into.* = 0
    const made = vk.createDevice(&instanceCommands, physical, &deviceInfo, null, into)
    if made == vk.Result.success { vk.loadDeviceCommands(&deviceCommands, into.*, instanceCommands.vkGetDeviceProcAddr) }
    return made
}

fn dropDevice(handle: vk.Device) -> void { if handle != 0 { vk.destroyDevice(&deviceCommands, handle, null) } }

// The first memory type with every flag of `flags` and none of `without`.
fn typeWith(flags: u32, without: u32) -> u32 {
    var k: u32 = 0
    while k < memoryProperties.memoryTypeCount {
        const has = memoryProperties.memoryTypes[k].propertyFlags
        if (has & flags) == flags && (has & without) == 0 { return k }
        k += 1
    }
    return 0xFFFFFFFF
}

// A buffer of `bytes` in memory of type `kind`, bound (and mapped at
// `mapped` when not null).
fn makeBuffer(handle: vk.Device, bytes: u64, kind: u32, buffer: *vk.Buffer, memory: *vk.DeviceMemory, mapped: ?*usize) -> bool {
    var info = vk.BufferCreateInfo.init()
    info.size = bytes
    info.usage = vk.BUFFER_USAGE_STORAGE_BUFFER_BIT | vk.BUFFER_USAGE_TRANSFER_SRC_BIT | vk.BUFFER_USAGE_TRANSFER_DST_BIT
    if vk.createBuffer(&deviceCommands, handle, &info, null, buffer) != vk.Result.success { return false }
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(&deviceCommands, handle, buffer.*, &requirements)
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.allocationSize = requirements.size
    allocation.memoryTypeIndex = kind
    if vk.allocateMemory(&deviceCommands, handle, &allocation, null, memory) != vk.Result.success { return false }
    if vk.bindBufferMemory(&deviceCommands, handle, buffer.*, memory.*, 0) != vk.Result.success { return false }
    if mapped != null {
        var address: ?*anyopaque = null
        if vk.mapMemory(&deviceCommands, handle, memory.*, 0, vk.WHOLE_SIZE, 0, &address) != vk.Result.success { return false }
        mapped.?.* = @intFromPtr(address.?)
    }
    return true
}

var commandPool: vk.CommandPool = 0
var cb: vk.CommandBuffer = 0

fn begin(handle: vk.Device) -> void {
    var info = vk.CommandPoolCreateInfo.init()
    info.flags = vk.COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT
    _ = vk.createCommandPool(&deviceCommands, handle, &info, null, &commandPool)
    var allocation = vk.CommandBufferAllocateInfo.init()
    allocation.commandPool = commandPool
    allocation.level = vk.CommandBufferLevel.primary
    allocation.commandBufferCount = 1
    _ = vk.allocateCommandBuffers(&deviceCommands, handle, &allocation, unsafe { @ptrCast([*]vk.CommandBuffer, &cb) })
    var beginInfo = vk.CommandBufferBeginInfo.init()
    beginInfo.flags = vk.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
    _ = vk.beginCommandBuffer(&deviceCommands, cb, &beginInfo)
}

// The command buffer (none: `count` 0) submitted with a fence and waited
// for at most `timeout`: the submit's answer, else the wait's.
fn submitAndWait(handle: vk.Device, count: u32, timeout: u64) -> vk.Result {
    var fenceInfo = vk.FenceCreateInfo.init()
    var fence: vk.Fence = 0
    _ = vk.createFence(&deviceCommands, handle, &fenceInfo, null, &fence)
    var submit = vk.SubmitInfo.init()
    submit.commandBufferCount = count
    submit.pCommandBuffers = unsafe { @ptrCast([*]const vk.CommandBuffer, &cb) }
    var queueHandle: vk.Queue = 0
    vk.getDeviceQueue(&deviceCommands, handle, 0, 0, &queueHandle)
    var answer = vk.queueSubmit(&deviceCommands, queueHandle, 1, &submit, fence)
    if answer == vk.Result.success { answer = vk.waitForFences(&deviceCommands, handle, 1, &fence, vk.TRUE, timeout) }
    vk.destroyFence(&deviceCommands, handle, fence, null)
    return answer
}

fn endCommands(handle: vk.Device) -> void {
    if commandPool != 0 { vk.destroyCommandPool(&deviceCommands, handle, commandPool, null) }
    commandPool = 0
}

// Everything the program had given back: no handle, no context, no
// memory object, no mapping, no frame held, the card's memory free.
fn allBack(what: []const u8) -> void {
    expect(calls.handles() == 0 && work.living(&calls.w) == 0 && work.objects(&calls.w) == 0 && work.mapped(&calls.w) == 0, what)
    expect(calls.framesHeld() == 0 && calls.frameMisses == 0 && work.cardFree(&calls.w) == 7936 * MIB && work.holding(&calls.w, calls.PROCESS).system == 0, "and every frame and the card's memory back")
}

// ---- The driver on the card.

fn onTheCard() -> void {
    expect(calls.boot(7, SYSTEM_MOST), "a boot of stage 7: the calls served")
    line("gpu: programs' work on compute ring 0: 7936 MiB of the card's memory and 64 MiB of the system's for programs, address spaces 1 to 7, streams checked and copied")
    const facts = calls.facts()
    expect(facts.computeRings == 1 && facts.why == record.Why.NONE && facts.flags & record.Flag.PROGRAMS != 0 && facts.flags & record.Flag.SYSTEM_MEMORY != 0 && facts.system == SYSTEM_MOST, "the record: compute ring 0, the calls' flag, the system's memory for programs")
    expect(start() == 1, "one physical device")
    var properties: vk.PhysicalDeviceProperties = undefined
    vk.getPhysicalDeviceProperties(&instanceCommands, physical, &properties)
    const name: [*]const u8 = &properties.deviceName
    var length: usize = 0
    while length < 256 && name[length] != 0 { length += 1 }
    expect(equal(name[0..length], "AMD Radeon RX 580 (Polaris 10)"), "its name, from the record: AMD Radeon RX 580 (Polaris 10)")
    // Its memory: the card's beyond the aperture (device local), the
    // system's for programs (host visible: coherent, and cached), no type
    // of the card's memory the processor maps.
    expect(memoryProperties.memoryHeapCount == 2 && memoryProperties.memoryHeaps[0].size == @intCast(u64, 7936 * MIB) && memoryProperties.memoryHeaps[0].flags == vk.MEMORY_HEAP_DEVICE_LOCAL_BIT && memoryProperties.memoryHeaps[1].size == @intCast(u64, SYSTEM_MOST) && memoryProperties.memoryHeaps[1].flags == 0, "two heaps: 7936 MiB of the card's own, 64 MiB of the system's")
    expect(memoryProperties.memoryTypeCount == 3 && memoryProperties.memoryTypes[0].propertyFlags == vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT && memoryProperties.memoryTypes[0].heapIndex == 0 && memoryProperties.memoryTypes[1].heapIndex == 1 && memoryProperties.memoryTypes[2].heapIndex == 1, "three types: device local; host visible and coherent; and cached")
    expect(typeWith(vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT | vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT, 0) == 0xFFFFFFFF, "no device-local type the processor maps")
    // vkCreateDevice: its self-test on the card.
    var handle: vk.Device = 0
    const made = makeDevice(&handle)
    shown()
    expect(made == vk.Result.success && driver.refusal() == driver.Refusal.NONE, "vkCreateDevice: made")
    expect(selftest.last.outcome == selftest.Outcome.passed, "its self-test passed (the doubler and the division)")
    expect(calls.buffers >= 1 && calls.failed == 0 && calls.w.refusedStreams == 0 && calls.w.submitted == calls.buffers, "on the card: every submit a buffer of the program's on compute ring 0, through the kernel's checks, none refused")
    expect(calls.dispatched == 2, "two dispatches ran on the card: the doubler's and the division's")
    expect(work.living(&calls.w) == 1 && work.spaceOf(&calls.w, 0) == 1, "its context, in address space 1")
    // A copy through the card's own memory: from a host-visible buffer to
    // a device-local one and back to a third.
    const bytes: u64 = 3 * 4096 + 256
    var source: vk.Buffer = 0
    var middle: vk.Buffer = 0
    var target: vk.Buffer = 0
    var sourceMemory: vk.DeviceMemory = 0
    var middleMemory: vk.DeviceMemory = 0
    var targetMemory: vk.DeviceMemory = 0
    var from: usize = 0
    var to: usize = 0
    const visible = typeWith(vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT, 0)
    const local = typeWith(vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT, 0)
    // (The card's memory a program gets is cleared by the card: what was
    // there before is not seen.)
    std.mem.set(unsafe { @ptrFromInt([*]u8, engine.beyondVram) }, 0xAB, 1 * MIB)
    const ready = makeBuffer(handle, bytes, visible, &source, &sourceMemory, &from) && makeBuffer(handle, bytes, local, &middle, &middleMemory, null) && makeBuffer(handle, bytes, visible, &target, &targetMemory, &to)
    expect(ready, "three buffers: two the processor maps, one of the card's own memory")
    expect(calls.w.filled >= 1, "the card's memory cleared by the card (DMA_DATA fills on compute ring 0)")
    const a: [*]u32 = unsafe { @ptrFromInt([*]u32, from) }
    const b: [*]u32 = unsafe { @ptrFromInt([*]u32, to) }
    var k: usize = 0
    while k < @intCast(usize, bytes / 4) {
        a[k] = @intCast(u32, k) *% 2654435761
        b[k] = 0x5A5A5A5A
        k += 1
    }
    begin(handle)
    var region = vk.BufferCopy.init()
    region.size = bytes
    // First the device-local buffer as the card gave it (zeroed), into the
    // target's second half... as a whole: target from middle, then middle
    // from source, then target from middle again.
    vk.cmdCopyBuffer(&deviceCommands, cb, middle, target, 1, &region)
    var barrier = vk.MemoryBarrier.init()
    barrier.srcAccessMask = vk.ACCESS_TRANSFER_WRITE_BIT | vk.ACCESS_TRANSFER_READ_BIT
    barrier.dstAccessMask = vk.ACCESS_TRANSFER_WRITE_BIT | vk.ACCESS_TRANSFER_READ_BIT
    vk.cmdPipelineBarrier(&deviceCommands, cb, vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, null, 0, null)
    _ = vk.endCommandBuffer(&deviceCommands, cb)
    expect(submitAndWait(handle, 1, 1000000000) == vk.Result.success, "the copy from the card's memory: submitted and done")
    var zero = true
    k = 0
    while k < @intCast(usize, bytes / 4) {
        if b[k] != 0 { zero = false }
        k += 1
    }
    expect(zero, "the card's new memory read back zeroed, every word (not the 0xAB that was there)")
    _ = vk.resetCommandBuffer(&deviceCommands, cb, 0)
    var beginInfo = vk.CommandBufferBeginInfo.init()
    _ = vk.beginCommandBuffer(&deviceCommands, cb, &beginInfo)
    vk.cmdCopyBuffer(&deviceCommands, cb, source, middle, 1, &region)
    vk.cmdPipelineBarrier(&deviceCommands, cb, vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, null, 0, null)
    vk.cmdCopyBuffer(&deviceCommands, cb, middle, target, 1, &region)
    _ = vk.endCommandBuffer(&deviceCommands, cb)
    expect(submitAndWait(handle, 1, 1000000000) == vk.Result.success, "through the card's memory and back: submitted and done")
    var same = true
    k = 0
    while k < @intCast(usize, bytes / 4) {
        if b[k] != a[k] { same = false }
        k += 1
    }
    expect(same, "every word through the card's memory and back")
    endCommands(handle)
    vk.destroyBuffer(&deviceCommands, handle, source, null)
    vk.destroyBuffer(&deviceCommands, handle, middle, null)
    vk.destroyBuffer(&deviceCommands, handle, target, null)
    vk.freeMemory(&deviceCommands, handle, sourceMemory, null)
    vk.freeMemory(&deviceCommands, handle, middleMemory, null)
    vk.freeMemory(&deviceCommands, handle, targetMemory, null)
    dropDevice(handle)
    stop()
    allBack("the device and the instance given back: nothing held")
}

// ---- The self-test failing on the card.

fn selfTestFails() -> void {
    // The card's reciprocal a unit high: the division does not survive it.
    expect(calls.boot(7, SYSTEM_MOST), "served")
    calls.rcpError = 1
    expect(start() == 1, "one physical device")
    var handle: vk.Device = 0
    expect(makeDevice(&handle) == vk.Result.errorInitializationFailed && driver.refusal() == driver.Refusal.SELF_TEST && selftest.last.outcome == selftest.Outcome.wrong && selftest.last.division, "a reciprocal a unit high: vkCreateDevice refused, the division's word wrong")
    stop()
    allBack("the refused device's context and memory given back")
    // A card that hangs in the self-test: the wait's five seconds pass.
    expect(calls.boot(7, SYSTEM_MOST), "served")
    calls.choke = true
    expect(start() == 1, "one physical device")
    const clock = engine.clock
    expect(makeDevice(&handle) == vk.Result.errorInitializationFailed && driver.refusal() == driver.Refusal.SELF_TEST && selftest.last.outcome == selftest.Outcome.failed && selftest.last.answer == vk.Result.timeout, "the card hangs in the self-test: refused after its wait")
    expect(engine.clock - clock >= 5000000000, "after five seconds of the card's time")
    stop()
    expect(calls.handles() == 0 && work.living(&calls.w) == 1, "the program's handles closed; the context waits for its work on the ring")
    // The timer goes on: ten seconds after the ring last moved, it is left
    // down.
    var ticks: usize = 0
    while !work.ringDown(&calls.w) && ticks < 20000 {
        engine.clock += calls.TICK
        work.tick(&calls.w)
        ticks += 1
    }
    shown()
    expect(work.ringDown(&calls.w), "the watchdog: compute ring 0 left down")
    line("gpu: compute ring 0 has not moved for 10 s")
    line("it stays down until the next boot")
    line("gpu: context 0 (process 100) lost: compute ring 0 hung in its work")
    const after = calls.facts()
    expect(after.computeRings == 0 && after.why == record.Why.RING_DOWN && after.flags & record.Flag.PROGRAMS == 0, "the record: no ring, why 4")
    expect(calls.framesHeld() != 0, "the memory a hung ring may touch is not given back")
    // The next program: the device refused with the record's reason.
    expect(start() == 1, "the physical device still")
    expect(makeDevice(&handle) == vk.Result.errorInitializationFailed && driver.refusal() == driver.Refusal.NO_ENGINE, "vkCreateDevice refused: no engine takes commands")
    expect(equal(gpucard.whyText(after.why), "the card's compute ring hung and stays down until the next start"), "vkinfo's reason: the card's compute ring hung and stays down until the next start")
    stop()
}

// ---- A device lost, another going on.

fn deviceLost() -> void {
    // A hang after the device was made.
    expect(calls.boot(7, SYSTEM_MOST), "served")
    expect(start() == 1, "one physical device")
    var handle: vk.Device = 0
    expect(makeDevice(&handle) == vk.Result.success, "a device")
    calls.choke = true
    cb = 0
    expect(submitAndWait(handle, 0, device.FOREVER) == vk.Result.errorDeviceLost, "a submit the card hangs in: its wait answers VK_ERROR_DEVICE_LOST (the watchdog's ten seconds)")
    line("gpu: context 0 (process 100) lost: compute ring 0 hung in its work")
    expect(submitAndWait(handle, 0, 1000) == vk.Result.errorDeviceLost, "a later submit: VK_ERROR_DEVICE_LOST")
    dropDevice(handle)
    stop()
    // A fault: a copy from memory given back.
    expect(calls.boot(7, SYSTEM_MOST), "served")
    expect(start() == 1, "one physical device")
    var first: vk.Device = 0
    var second: vk.Device = 0
    expect(makeDevice(&first) == vk.Result.success, "a first device")
    const firstCommands = deviceCommands
    expect(makeDevice(&second) == vk.Result.success, "a second device")
    expect(work.spaceOf(&calls.w, 0) == 1 && work.spaceOf(&calls.w, 1) == 2, "in address spaces 1 and 2")
    const secondCommands = deviceCommands
    deviceCommands = firstCommands
    const visible = typeWith(vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT, 0)
    var source: vk.Buffer = 0
    var target: vk.Buffer = 0
    var sourceMemory: vk.DeviceMemory = 0
    var targetMemory: vk.DeviceMemory = 0
    expect(makeBuffer(first, 8192, visible, &source, &sourceMemory, null) && makeBuffer(first, 8192, visible, &target, &targetMemory, null), "two buffers of the first device")
    begin(first)
    var region = vk.BufferCopy.init()
    region.size = 8192
    vk.cmdCopyBuffer(&deviceCommands, cb, source, target, 1, &region)
    _ = vk.endCommandBuffer(&deviceCommands, cb)
    // (The source's memory given back before the copy runs: a program's
    // error, the card's fault.)
    vk.freeMemory(&deviceCommands, first, sourceMemory, null)
    const faults = calls.faulted
    expect(submitAndWait(first, 1, 1000000000) == vk.Result.errorDeviceLost, "the copy from memory no longer mapped: the card faults, the device is lost")
    expect(calls.faulted == faults + 1, "one fault of the card's in address space 1")
    line("gpu: context 0 (process 100) lost: a fault in its address space")
    expect(submitAndWait(first, 0, 1000) == vk.Result.errorDeviceLost, "the first device's later submit: lost")
    // The second goes on.
    deviceCommands = secondCommands
    cb = 0
    expect(submitAndWait(second, 0, 1000000000) == vk.Result.success, "the second device's submit runs")
    deviceCommands = firstCommands
    endCommands(first)
    vk.destroyBuffer(&deviceCommands, first, source, null)
    vk.destroyBuffer(&deviceCommands, first, target, null)
    vk.freeMemory(&deviceCommands, first, targetMemory, null)
    dropDevice(first)
    deviceCommands = secondCommands
    dropDevice(second)
    stop()
    allBack("both devices given back: nothing held")
}

// ---- The compositor's choice and its line.

fn said(outcome: choice.Outcome, check: choice.Check, why: []const u8, wanted: []const u8) -> void {
    var made: choice.Line = undefined
    choice.say(&made, outcome, "AMD Radeon RX 580 (Polaris 10)", 1280, 960, check, why)
    if equal(choice.text(&made), wanted) { return }
    say("the compositor's line: ")
    say(choice.text(&made))
    expect(false, wanted)
}

fn compositorChoice() -> void {
    var theirs: [64]u32 = undefined
    var ours: [64]u32 = undefined
    var k: usize = 0
    while k < 64 {
        theirs[k] = @intCast(u32, k) *% 2654435761
        ours[k] = theirs[k]
        k += 1
    }
    var check = choice.compare(&theirs, &ours, 64)
    expect(check.differ == 0, "two frames the same: no pixel differs")
    ours[37] = 0
    ours[50] ^= 1
    check = choice.compare(&theirs, &ours, 64)
    expect(check.differ == 2 && check.first == 37, "two pixels differ, the first the 38th")
    ours[37] = theirs[37]
    ours[50] = theirs[50]
    ours[63] = ~theirs[63]
    check = choice.compare(&theirs, &ours, 64)
    expect(check.differ == 1 && check.first == 63, "the last pixel alone differs: seen")
    const none = choice.Check.{ .differ = 0, .first = 0 }
    said(choice.Outcome.card, none, "", "renderer: the Vulkan device AMD Radeon RX 580 (Polaris 10) composes the desktop: its self-test and the first frame's check passed (1280x960, the same as the processor's, pixel for pixel); frames reach the screen by copy through a readback buffer\n")
    said(choice.Outcome.no_device, none, "", "renderer: no Vulkan device (no graphics card our driver serves); composing on the processor\n")
    said(choice.Outcome.refused, none, "no engine of the card takes commands at this boot", "renderer: the Vulkan device AMD Radeon RX 580 (Polaris 10) is found; no engine of the card takes commands at this boot: composing on the processor\n")
    said(choice.Outcome.refused, none, driver.refusalText(driver.Refusal.NO_COUNTS), "renderer: the Vulkan device AMD Radeon RX 580 (Polaris 10) is found; the card's record does not count its compute units: composing on the processor\n")
    said(choice.Outcome.no_renderer, none, "", "renderer: the Vulkan device AMD Radeon RX 580 (Polaris 10) opens, but the Vulkan renderer does not start on it (the line before says why): composing on the processor\n")
    said(choice.Outcome.not_composed, none, "", "renderer: the Vulkan device AMD Radeon RX 580 (Polaris 10) opens, but its first frame could not be composed on it: composing on the processor\n")
    said(choice.Outcome.differs, choice.Check.{ .differ = 3, .first = 1280 * 5 + 17 }, "", "renderer: the Vulkan device AMD Radeon RX 580 (Polaris 10) opens, but its first frame is not the processor's: 3 pixels differ, the first at 17,5: composing on the processor\n")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) == 2
    _ = crash.install()
    if !engine.makeRom(true) {
        say("the ROM could not be made\n")
        return 5
    }
    const names = [_][]const u8{ "polaris10_pfp_2.bin", "polaris10_me_2.bin", "polaris10_ce_2.bin", "polaris10_mec_2.bin", "polaris10_rlc.bin", "polaris10_sdma.bin", "polaris10_sdma1.bin", "polaris10_k_smc.bin", "polaris10_smc_sk.bin" }
    for name in names {
        if !engine.load(name) {
            say("the firmware files could not be read (run from the repository's top)\n")
            return 6
        }
    }
    contract()
    onTheCard()
    selfTestFails()
    deviceLost()
    compositorChoice()
    if failed != 0 { return failed }
    return 13
}
