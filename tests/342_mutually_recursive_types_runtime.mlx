// Types that name each other through pointers: two structs pointing at
// each other, and a struct with a field pointing to a function type that
// takes the struct (as C's interfaces have them: ICU's UText and its
// UTextFuncs). Before, the first of them did not resolve while the second
// was being worked out, and the compile failed with "declaration type
// could not be resolved". Exits 42.
const Node = struct {
    value: i32,
    edge: ?*Edge,
}

const Edge = struct {
    weight: i32,
    to: ?*Node,
}

const Text = struct {
    length: i64,
    funcs: ?*const Funcs,
}

const Access = fn(text: *Text, index: i64) -> i64

const Funcs = struct {
    size: i32,
    access: ?Access,
}

fn half(text: *Text, index: i64) -> i64 { return text.*.length / 2 + index }

pub fn main() -> u8 {
    var a = Node.{ .value = 10, .edge = null }
    var b = Node.{ .value = 20, .edge = null }
    var e = Edge.{ .weight = 2, .to = &b }
    a.edge = &e
    const reached = a.edge.?.*.to.?.*.value * a.edge.?.*.weight
    const funcs = Funcs.{ .size = 16, .access = half }
    var text = Text.{ .length = 4, .funcs = &funcs }
    const access = text.funcs.?.*.access.?
    return @intCast(u8, reached + @intCast(i32, access(&text, 0)))
}
