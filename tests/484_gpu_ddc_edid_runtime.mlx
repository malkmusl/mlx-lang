// A monitor's EDID read by the kernel's driver over a DDC line with a
// Radeon's I2C engine (projects/brix/kernel/gpu_ddc.mlx and the asking
// part of gpu_plug.mlx, built for the host), against a card that is a
// table with an EDID memory behind each line (tests/support/
// plug_card.mlx says what its engine does).
//
// A connector's DDC line out of the ROM's table (every line; no record,
// no table, a table of another revision, an entry beyond the table, a
// register that is no line's). Then the transfers, word for word and
// wait for wait as worked out here by hand from Linux 6.6's dce_i2c_hw.c,
// hw_ddc.c and hw_gpio.c: the first look (a byte asked for) and a block
// beyond the second with its segment pointer, on a card whose engine and
// pin words hold other things beforehand: every write in order, how
// often the status and the data word are read, the pauses, and every
// word as it was found afterwards; every line at its own words; a pad
// left in AUX mode. An EDID of one block, of two, of four (the segment
// pointer), of eight (four are kept); nothing on the line; a missing
// acknowledge in the middle, once and every time; an engine that stays
// busy (Linux's bound to the look, a soft reset); the engine's time
// limit and an aborted run; a block whose sum is wrong, once, every time
// and in an extension; a base block of nothing; a register that does not
// take its old value back; everything that refuses before a write. The
// same reading a piece a tick, with no pause and the bounds by the clock.
// Then the asking: at boot (who is asked, what is said, an EDID held
// against the loader's) and while brixOS runs (asked when plugged in,
// once more a second later when nothing answers, forgotten when
// unplugged, one at a time, nobody at a boot that lends no hands).
// And: four blocks read on each of the six lines whatever the engine's
// and the pins' words held, every word as found; a missing acknowledge
// at every message of every transfer, once and for good; an engine that
// never finishes, with a clock that goes and with one that stands
// still; 255 blocks named; a control word left with its resets on; a
// failure that stays in the status word; a block read again with tries
// of its own; the two seconds between blocks; the user's monitor's own
// timing said; a reading under way while its monitor is pulled and
// another plugged in; an hour of ticks and a minute of moving the
// monitor with hands lent.
// With an argument the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const ddc = @import("../projects/brix/kernel/gpu_ddc.mlx")
const plug = @import("../projects/brix/kernel/gpu_plug.mlx")
const rom = @import("./support/atom_rom.mlx")
const card = @import("./support/plug_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn once(text: []const u8) -> void { expect(card.count(text) == 1, text) }

fn sayHex(value: usize) -> void {
    const digits = "0123456789abcdef"
    var k: usize = 8
    while k > 0 {
        k -= 1
        const digit = (value >> @intCast(u6, k * 4)) & 15
        say(digits[digit..digit + 1])
    }
}

var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var watch: plug.Watch = undefined
var reader: ddc.Reader = undefined
var transfer: ddc.Transfer = undefined

// The monitors' EDIDs.
var one: [1024]u8 = undefined
var two: [1024]u8 = undefined
var four: [1024]u8 = undefined
var eight: [1024]u8 = undefined
var plain: [1024]u8 = undefined

// The board of tests/483: an HDMI connector (DIG 4, hot plug line 2, the
// card's DDC2), a DisplayPort (DIG 0, line 1, DDC3), a DVI-D (DIG 3,
// line 6, DDC1) and a second HDMI (DIG 1, line 4, DDC6).
const CONNECTORS = [_]usize{ 0x310C, 0x3113, 0x3104, 0x320C }
const ENCODERS = [_]usize{ 0x2121, 0x211E, 0x2220, 0x221E }
const PINS = [_]usize{ 4, 1, 6, 3 }
const SHIFTS = [_]usize{ 8, 0, 28, 24 }
const ENTRIES = [_]usize{ 2, 0, 1, 3 }
const CLOCKS = [_]usize{ 0x4871, 0x4869, 0x486D, 0x487D }

fn open() -> void {
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readBoard(&machine, &board)
}

fn wires() -> void {
    // Every line: an HDMI connector whose entry's clock pin is DDC1 to
    // DDC6 (0x4869 and every fourth number after it).
    var n: usize = 0
    while n < 6 {
        const clocks = [_]usize{ 0x4885, 0x4869 + 4 * n }
        const entries = [_]usize{1}
        card.reset()
        card.makeRom(&builder, CONNECTORS[0..1], ENCODERS[0..1], PINS[0..1], entries[0..], PINS[0..1], SHIFTS[0..1], clocks[0..])
        open()
        const wire = ddc.wireOf(&machine, &board.connectors[0])
        expect(wire.why == ddc.Unwired.wired && wire.line == n && wire.entry == 1 && wire.hardware, "the connector's line is the one whose clock pin the ROM's entry names")
        n += 1
    }
    // No record; an entry that is the table's count (Linux reads behind
    // the table for it) and one beyond; a register that is no line's
    // clock pin (a line's mask word, the VGA line's, one before the
    // first).
    const none = [_]usize{0xFF}
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..1], ENCODERS[0..1], PINS[0..1], none[0..], PINS[0..1], SHIFTS[0..1], CLOCKS[0..])
    open()
    expect(ddc.wireOf(&machine, &board.connectors[0]).why == ddc.Unwired.no_record && ddc.wireOf(&machine, &board.connectors[0]).line == ddc.NONE, "a connector without an I2C record has no line")
    const beyond = [_]usize{ 4, 5 }
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..2], ENCODERS[0..2], PINS[0..2], beyond[0..], PINS[0..2], SHIFTS[0..2], CLOCKS[0..])
    open()
    expect(ddc.wireOf(&machine, &board.connectors[0]).why == ddc.Unwired.beyond_table && ddc.wireOf(&machine, &board.connectors[1]).why == ddc.Unwired.beyond_table, "an entry the table does not have")
    const odd = [_]usize{ 0x4868, 0x4881, 0x4865, 0x486A }
    const all = [_]usize{ 0, 1, 2, 3 }
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..], ENCODERS[0..], PINS[0..], all[0..], PINS[0..], SHIFTS[0..], odd[0..])
    open()
    var k: usize = 0
    while k < 4 {
        expect(ddc.wireOf(&machine, &board.connectors[k]).why == ddc.Unwired.not_a_line, "a register that is no DDC line's clock pin")
        k += 1
    }
    // No table of lines; one of another content revision.
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..1], ENCODERS[0..1], PINS[0..1], ENTRIES[1..2], PINS[0..1], SHIFTS[0..1], CLOCKS[0..0])
    open()
    expect(ddc.wireOf(&machine, &board.connectors[0]).why == ddc.Unwired.no_table, "a ROM without the table of DDC lines")
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..1], ENCODERS[0..1], PINS[0..1], ENTRIES[1..2], PINS[0..1], SHIFTS[0..1], CLOCKS[0..])
    builder.poke(builder.peek16(rom.DATA + 4 + 2 * 10) + 3, 2)
    builder.resum()
    open()
    expect(ddc.wireOf(&machine, &board.connectors[0]).why == ddc.Unwired.no_table, "a table of DDC lines of another revision is not read")
}

// A card whose engine and line 2 (DDC3) hold other things than a
// transfer leaves: the pins' word with its strength bits and no
// pull-downs, the engine left on another line, a priority bit in the
// arbitration word, another speed, a short time limit with delays and
// drive bits, stale message words.
fn found() -> void {
    card.reset()
    card.store(0x4870, 0x11000000)
    card.store(0x16D4, 0x00000100)
    card.store(0x16D5, 0x00000001)
    card.store(0x16E2, 0x00190301)
    card.store(0x16E3, 0x03050607)
    card.store(0x16EB, 0x00002001)
    card.store(0x16EC, 0x00050000)
}

// The engine's and the pins' words as they are now.
const KEPT_FROM = [_]usize{ 0x16D4, 0x16D8, 0x4868 }
const KEPT_TO = [_]usize{ 0x16D6, 0x16ED, 0x487F }
var before: [64]usize = undefined

fn remember() -> void {
    var at: usize = 0
    var r: usize = 0
    while r < 3 {
        var number = KEPT_FROM[r]
        while number <= KEPT_TO[r] {
            before[at] = card.raw(number)
            at += 1
            number += 1
        }
        r += 1
    }
}

fn asBefore() -> bool {
    var at: usize = 0
    var r: usize = 0
    while r < 3 {
        var number = KEPT_FROM[r]
        while number <= KEPT_TO[r] {
            if before[at] != card.raw(number) {
                if show {
                    say("register ")
                    sayHex(number)
                    say(" holds ")
                    sayHex(card.raw(number))
                    say(" and held ")
                    sayHex(before[at])
                    say("\n")
                }
                return false
            }
            at += 1
            number += 1
        }
        r += 1
    }
    return true
}

// The writes made, held against a list.
fn wrote(registers: []const usize, words: []const usize, what: []const u8) -> void {
    var same = card.written == registers.length
    var k: usize = 0
    while k < registers.length && k < card.written {
        if card.writtenTo[k] != registers[k] || card.writtenWith[k] != words[k] {
            same = false
            if show {
                say("write ")
                sayHex(k)
                say(": ")
                sayHex(card.writtenTo[k])
                say(" <- ")
                sayHex(card.writtenWith[k])
                say(", expected ")
                sayHex(registers[k])
                say(" <- ")
                sayHex(words[k])
                say("\n")
            }
        }
        k += 1
    }
    if show && card.written != registers.length {
        say("writes made: ")
        sayHex(card.written)
        say(", expected: ")
        sayHex(registers.length)
        say("\n")
    }
    expect(same, what)
}

// A transfer gone through with the pauses it asks for.
fn through(t: *ddc.Transfer) -> void {
    const c = card.card()
    const h = card.hands()
    while true {
        const next = t.step(&c, &h, true)
        if next == ddc.Next.done { break }
        if next == ddc.Next.wait { card.pause(t.*.pause) }
    }
}

// The first look, one byte asked for, on line 2: 25 writes.
const LOOK_TO = [_]usize{ 0x4870, 0x16D5, 0x16E2, 0x16D4, 0x16E3, 0x16D5, 0x16EA, 0x16EE, 0x16EE, 0x16EB, 0x16EE, 0x16D4, 0x16E3, 0x16D4, 0x16D4, 0x16EE, 0x16D4, 0x16D5, 0x16EA, 0x16EB, 0x16E2, 0x16E3, 0x16D4, 0x16D5, 0x4870 }
const LOOK_WITH = [_]usize{
    // The pins the engine's, pulled down.
    0x11001010,
    // The engine asked for; 100 kHz (the prescale 135, threshold 2,
    // start and stop timing 2); the status reset and line 2; time limit
    // 255 and enabled; no queueing.
    0x00100001, 0x00870202, 0x00000208, 0xFF050647, 0x00100001,
    // 0x50 written a byte (the offset 0), no stop; its address byte with
    // the buffer's index at 0; the byte.
    0x00011100, 0x8000A000, 0x00000000,
    // 0x50 read a byte, a stop after it; its address byte.
    0x00013101, 0x0000A100,
    // The run: the status reset; the drive bits and delays 0; two
    // messages; go.
    0x00000208, 0xFF000044, 0x00100200, 0x00100201,
    // The index behind the three bytes sent, for reading.
    0x80030001,
    // The engine let go: the status reset, done and the request off.
    0x00100209, 0x00200001,
    // Every word as it was found.
    0x00000000, 0x00002001, 0x00190301, 0x03050607, 0x00000100, 0x00000001, 0x11000000
}

// Block 2 (the third) read on line 2: its segment pointer first, 29
// writes.
const BLOCK_TO = [_]usize{ 0x4870, 0x16D5, 0x16E2, 0x16D4, 0x16E3, 0x16D5, 0x16EA, 0x16EE, 0x16EE, 0x16EB, 0x16EE, 0x16EE, 0x16EC, 0x16EE, 0x16D4, 0x16E3, 0x16D4, 0x16D4, 0x16EE, 0x16D4, 0x16D5, 0x16EA, 0x16EB, 0x16EC, 0x16E2, 0x16E3, 0x16D4, 0x16D5, 0x4870 }
const BLOCK_WITH = [_]usize{
    0x11001010, 0x00100001, 0x00870202, 0x00000208, 0xFF050647, 0x00100001,
    // 0x30 written a byte (segment 1), no stop.
    0x00011100, 0x80006000, 0x00000100,
    // 0x50 written a byte (the offset 0), no stop.
    0x00011100, 0x0000A000, 0x00000000,
    // 0x50 read 128 bytes, a stop after them.
    0x00803101, 0x0000A100,
    // The run of three messages.
    0x00000208, 0xFF000044, 0x00200200, 0x00200201,
    // The index behind the five bytes sent.
    0x80050001,
    0x00200209, 0x00200001,
    0x00000000, 0x00002001, 0x00050000, 0x00190301, 0x03050607, 0x00000100, 0x00000001, 0x11000000
}

fn wordForWord() -> void {
    found()
    card.monitor(2, four[0..512], true)
    remember()
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 1)
    through(&transfer)
    expect(transfer.succeeded() && transfer.got == 1 && transfer.received[0] == 0x00, "the first look is answered with the EDID's first byte")
    wrote(LOOK_TO[0..], LOOK_WITH[0..], "the first look's writes, word for word")
    // Looks at the status: before each message and before the run (the
    // engine is idle), after the message that does not end the run, four
    // in the wait (three that say it runs), one when the engine is let
    // go; a pause of a microsecond after each look that said it runs.
    expect(card.statusReads == 9 && card.pauses == 3 && card.paused == 3 && card.dataReads == 1, "the first look's looks at the status, its pauses and its read of the data word")
    expect(transfer.bound == 8960 && transfer.looks == 3, "the bound of the first look's wait: 320 us times 28")
    expect(asBefore() && transfer.restored && transfer.writes == 25, "after the first look every word holds what it held")
    expect(card.protocol == 0 && card.runs == 1 && card.messagesDone == 2, "the engine took the first look as Linux drives it")

    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x30, 1)
    transfer.write(0x50, 0)
    transfer.read(0x50, 128)
    through(&transfer)
    wrote(BLOCK_TO[0..], BLOCK_WITH[0..], "a block's writes with its segment pointer, word for word")
    var same = transfer.succeeded() && transfer.got == 128
    var k: usize = 0
    while k < 128 {
        if transfer.received[k] != four[256 + k] { same = false }
        k += 1
    }
    expect(same, "the third block's bytes")
    expect(card.statusReads == 11 && card.pauses == 3 && card.dataReads == 128, "a block's looks at the status, its pauses and its reads of the data word")
    expect(transfer.bound == 337280, "the bound of a block's wait behind a segment pointer: 320 us times 1054")
    expect(asBefore() && transfer.restored && card.protocol == 0, "after a block every word holds what it held")
    // The second block needs no segment pointer: 320 us times 1044.
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 128)
    transfer.read(0x50, 128)
    through(&transfer)
    expect(transfer.succeeded() && transfer.bound == 334080 && transfer.received[0] == four[128] && transfer.received[127] == four[255], "the second block, and the bound of its wait")
    expect(card.writtenTo[8] == 0x16EE && card.writtenWith[8] == 0x00008000, "the second block's offset byte")

    // Every line at its own words (the numbers are the header's).
    const masks = [_]usize{ 0x4868, 0x486C, 0x4870, 0x4874, 0x4878, 0x487C }
    const speeds = [_]usize{ 0x16DE, 0x16E0, 0x16E2, 0x16E4, 0x16E6, 0x16E8 }
    const setups = [_]usize{ 0x16DF, 0x16E1, 0x16E3, 0x16E5, 0x16E7, 0x16E9 }
    var n: usize = 0
    while n < 6 {
        card.reset()
        card.monitor(n, two[0..256], false)
        card.forget()
        transfer.begin(n, 6, 100000)
        transfer.write(0x50, 0)
        transfer.read(0x50, 128)
        through(&transfer)
        var right = transfer.succeeded() && card.protocol == 0 && transfer.received[8] == two[8]
        k = 0
        while k < card.written {
            const to = card.writtenTo[k]
            const shared = to == 0x16D4 || to == 0x16D5 || to == 0x16EA || to == 0x16EB || to == 0x16EE
            if !shared && to != masks[n] && to != speeds[n] && to != setups[n] { right = false }
            k += 1
        }
        expect(right && card.writtenTo[0] == masks[n] && card.writtenTo[2] == speeds[n] && card.writtenTo[4] == setups[n], "a line's transfer writes that line's words and the engine's, no others")
        expect((card.writtenWith[3] >> 8) & 7 == n, "the engine is told the line")
        n += 1
    }

    // A pad left in AUX mode: switched to I2C by a write of its own, and
    // put back afterwards; with a pin's output enable set, 2 ms waited
    // first.
    found()
    card.store(0x4870, 0x11011010)
    card.monitor(2, two[0..256], false)
    remember()
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 1)
    through(&transfer)
    expect(transfer.succeeded() && card.protocol == 0, "a transfer on a pad that was the AUX channel's")
    expect(card.writtenTo[0] == 0x4870 && card.writtenWith[0] == 0x11001010 && card.writtenTo[1] == 0x16D5, "the pad's mode bit cleared before the engine is asked for")
    expect(card.paused == 3 && asBefore(), "no wait for a pad whose pins were not driven, and the pad's mode back afterwards")
    found()
    card.store(0x4870, 0x11011010)
    card.store(0x4872, 0x00000100)
    card.monitor(2, two[0..256], false)
    remember()
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 1)
    through(&transfer)
    expect(transfer.succeeded() && card.paused == 2003 && card.pauses == 4 && asBefore(), "2 ms waited before the pad of a driven pin is switched")
    // Both pins held as plain pins beforehand: given to the engine, and
    // plain pins again afterwards.
    found()
    card.store(0x4870, 0x11000101)
    card.monitor(2, two[0..256], false)
    remember()
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 1)
    through(&transfer)
    expect(transfer.succeeded() && card.protocol == 0 && card.writtenTo[0] == 0x4870 && card.writtenWith[0] == 0x11001010 && asBefore(), "pins that were plain pins are the engine's for the transfer and plain pins again after it")
    // The pull-downs on and the pins the engine's already: no write to
    // the pins' word at all.
    found()
    card.store(0x4870, 0x11001010)
    card.monitor(2, two[0..256], false)
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 1)
    through(&transfer)
    expect(transfer.succeeded() && card.written == 23 && card.writtenTo[0] == 0x16D5, "a pins' word that is as it has to be is not written")
    // The crystal of the ROM where the time base word names no clock:
    // 100 MHz halved, at 100 kHz: 500.
    found()
    card.store(0x13B, 0)
    card.monitor(2, two[0..256], false)
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 1)
    through(&transfer)
    expect(transfer.succeeded() && card.protocol == 0 && card.writtenWith[2] == 0x01F40202, "the engine's clock from the ROM's crystal")
}

fn readOn(wire: *const ddc.Wire, lines: usize, crystal: usize) -> void {
    const c = card.card()
    const h = card.hands()
    card.forget()
    remember()
    ddc.read(&c, &h, card.pause, wire, lines, crystal, &reader)
}

fn sameBytes(bytes: []const u8, count: usize) -> bool {
    if reader.heard.count != count { return false }
    var k: usize = 0
    while k < count {
        if reader.heard.bytes[k] != bytes[k] { return false }
        k += 1
    }
    return true
}

fn edids() -> void {
    const wire = ddc.Wire.{ .line = 2, .entry = 1, .hardware = true, .why = ddc.Unwired.wired }
    // One block; two; four with the segment pointer; eight, of which
    // four are kept.
    found()
    card.monitor(2, one[0..128], false)
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 1 && reader.heard.extensions == 0 && reader.heard.complete && sameBytes(one[0..], 128), "an EDID of one block")
    expect(reader.heard.transfers == 2 && card.runs == 2 && asBefore() && reader.heard.restored && card.protocol == 0, "one block: the first look and a block, every word back")
    found()
    card.monitor(2, two[0..256], false)
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 2 && reader.heard.complete && sameBytes(two[0..], 256), "an EDID of two blocks")
    expect(reader.heard.transfers == 3 && asBefore() && card.protocol == 0 && reader.heard.line == 2, "two blocks in three transfers, no segment pointer sent")
    var k: usize = 0
    var segment = false
    while k < card.written {
        if card.writtenTo[k] == 0x16EE && card.writtenWith[k] & 0xFF00 == 0x6000 { segment = true }
        k += 1
    }
    expect(!segment, "a monitor of two blocks is never sent the segment pointer's address")
    found()
    card.monitor(2, four[0..512], true)
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 4 && reader.heard.extensions == 3 && reader.heard.complete && sameBytes(four[0..], 512), "an EDID of four blocks, the last two behind the segment pointer")
    expect(reader.heard.transfers == 5 && asBefore() && card.protocol == 0, "four blocks in five transfers")
    found()
    card.monitor(2, eight[0..1024], true)
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 4 && reader.heard.extensions == 7 && !reader.heard.complete && sameBytes(eight[0..], 512), "of eight blocks four are kept, and the EDID is not said to be complete")

    // Nothing on the line: the first look is not acknowledged, five
    // times.
    found()
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.no_answer && reader.heard.failure == ddc.Failure.not_acknowledged && reader.heard.transfers == 5 && card.runs == 5, "nothing answers: five tries")
    expect(reader.heard.count == 0 && asBefore() && reader.heard.restored && card.dataReads == 0, "nothing answers: nothing is read, every word back")
    expect(reader.heard.status & 0x100 != 0, "the status word of the missing acknowledge is kept")

    // A missing acknowledge in the middle (the read's address, after
    // the offset was taken): once, then every time.
    found()
    card.monitor(2, two[0..256], false)
    card.nackFrom = 1
    card.nackRuns = 1
    card.nackMessage = 1
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 2 && sameBytes(two[0..], 256) && reader.heard.transfers == 4, "a transfer that is not acknowledged once is made again")
    found()
    card.monitor(2, two[0..256], false)
    card.nackFrom = 1
    card.nackRuns = 99
    card.nackMessage = 1
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.failed && reader.heard.failure == ddc.Failure.not_acknowledged && reader.heard.transfers == 6 && asBefore(), "a block that is never acknowledged: five tries, then given up")
    // In an extension block: the base block is the EDID.
    found()
    card.monitor(2, two[0..256], false)
    card.nackFrom = 2
    card.nackRuns = 99
    card.nackMessage = 0
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 1 && !reader.heard.complete && reader.heard.extensions == 1 && sameBytes(two[0..], 128) && reader.heard.transfers == 7, "an extension block that cannot be read ends the EDID before it")

    // An engine that stays busy: Linux's bound to the look, then a soft
    // reset; five tries.
    found()
    card.monitor(2, two[0..256], false)
    card.staysBusy = true
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.failed && reader.heard.failure == ddc.Failure.stays_busy && reader.heard.transfers == 5, "an engine that stays busy: five tries")
    // (Each try: four looks before the run, 8960 in the wait, one when
    // the engine is let go; a pause after each of the wait's but the
    // last.)
    expect(card.statusReads == 5 * (4 + 8960 + 1) && card.pauses == 5 * 8959, "the wait for a busy engine ends at Linux's bound, to the look")
    var reset = false
    k = 0
    while k < card.written {
        if card.writtenTo[k] == 0x16D4 && card.writtenWith[k] & 0xA == 0xA { reset = true }
        k += 1
    }
    expect(reset && asBefore() && reader.heard.restored, "a busy engine is reset, and every word put back")
    expect(reader.heard.took >= 5 * 8959000 && reader.heard.took < 100000000, "five tries at a busy engine take 45 ms")
    // Busy in a block's read: 334080 looks a try, and the reading's two
    // seconds end the tries.
    found()
    card.monitor(2, two[0..256], false)
    card.runLooks = 0
    readOn(&wire, 6, 100000)
    card.staysBusy = true
    const c = card.card()
    const h = card.hands()
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 128)
    through(&transfer)
    expect(transfer.failure == ddc.Failure.stays_busy && transfer.looks == 334080 && card.pauses == 334079, "a block's wait ends after 334080 looks")

    // The reading's two seconds: the base block read at its fifth try
    // (four busy ones of a third of a second each), then an extension
    // block that stays busy: after its second try the two seconds are
    // over, and no third is made.
    found()
    card.monitor(2, two[0..256], false)
    card.busyRuns = 0xFDE
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 1 && !reader.heard.complete && reader.heard.transfers == 8 && card.runs == 8, "no transfer is begun after the reading's two seconds")
    expect(reader.heard.took >= ddc.BUDGET && reader.heard.took < ddc.BUDGET + 400000000 && asBefore(), "the reading ends soon after its two seconds, every word back")

    // The engine's time limit, and a run it gives up: tried again.
    found()
    card.monitor(2, two[0..256], false)
    card.limitFrom = 0
    card.limitRuns = 2
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.transfers == 5 && sameBytes(two[0..], 256), "the engine's time limit twice, then read")
    found()
    card.monitor(2, two[0..256], false)
    card.limitFrom = 0
    card.limitRuns = 99
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.failed && reader.heard.failure == ddc.Failure.time_limit && reader.heard.status & 0x20 != 0 && asBefore(), "the engine's time limit every time")
    found()
    card.monitor(2, two[0..256], false)
    card.abortFrom = 1
    card.abortRuns = 99
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.failed && reader.heard.failure == ddc.Failure.aborted && reader.heard.transfers == 6, "a run the engine gives up every time")

    // A block whose sum is wrong: read again; four times wrong: the
    // base block does not hold; in an extension: the base block is the
    // EDID.
    found()
    card.monitor(2, two[0..256], false)
    card.spoilFrom = 0
    card.spoilReads = 1
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 2 && sameBytes(two[0..], 256) && card.blockReads == 3, "a block that does not add up is read again")
    found()
    card.monitor(2, two[0..256], false)
    card.spoilFrom = 0
    card.spoilReads = 99
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.does_not_hold && reader.heard.sum == 0x10 && card.blockReads == 4 && reader.heard.count == 0 && asBefore(), "a base block that never adds up: four reads, no EDID")
    found()
    card.monitor(2, two[0..256], false)
    card.spoilFrom = 1
    card.spoilReads = 99
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 1 && !reader.heard.complete && card.blockReads == 5 && sameBytes(two[0..], 128), "an extension block that never adds up is left out")
    // A base block whose header is wrong (its sum right), and one of
    // nothing but zeroes (read once).
    plain[1] = 0x7F
    plain[127] = @intCast(u8, (@intCast(usize, plain[127]) + 0x80) & 0xFF)
    found()
    card.monitor(2, plain[0..128], false)
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.does_not_hold && reader.heard.sum == 0 && card.blockReads == 4, "a base block without the header does not hold")
    k = 0
    while k < 128 {
        plain[k] = 0
        k += 1
    }
    found()
    card.monitor(2, plain[0..128], false)
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.does_not_hold && card.blockReads == 1, "a base block of nothing is read once")

    // A register that does not take its old value back.
    found()
    card.monitor(2, one[0..128], false)
    readOn(&wire, 6, 100000)
    found()
    card.monitor(2, one[0..128], false)
    const hh = card.hands()
    const cc = card.card()
    card.forget()
    remember()
    reader.start(&cc, &wire, 6, 100000)
    var steps: usize = 0
    while reader.busy() {
        // (The setup word stops taking writes once the run is started.)
        if card.runs == 1 { card.deaf = 0x16E3 }
        if reader.step(&cc, &hh, true) == ddc.Next.wait { card.pause(reader.pause) }
        steps += 1
    }
    expect(!reader.heard.restored && reader.heard.stuck == 0x16E3 && !asBefore(), "a word that does not take its old value back is said")

    // What refuses before a write.
    const nowhere = ddc.Wire.{ .line = ddc.NONE, .entry = 0xFF, .hardware = false, .why = ddc.Unwired.no_record }
    found()
    readOn(&nowhere, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.failed && reader.heard.failure == ddc.Failure.no_line && card.written == 0 && card.reads == 0, "no line: nothing is touched")
    const soft = ddc.Wire.{ .line = 2, .entry = 1, .hardware = false, .why = ddc.Unwired.wired }
    found()
    card.monitor(2, two[0..256], false)
    readOn(&soft, 6, 100000)
    expect(reader.heard.failure == ddc.Failure.not_hardware && card.written == 0 && card.reads == 0, "a line the ROM does not give the engine: nothing is touched")
    const sixth = ddc.Wire.{ .line = 5, .entry = 1, .hardware = true, .why = ddc.Unwired.wired }
    found()
    card.monitor(5, two[0..256], false)
    readOn(&sixth, 5, 100000)
    expect(reader.heard.failure == ddc.Failure.no_such_line && card.written == 0 && reader.heard.transfers == 1, "the sixth line of a card that has five: no write, no second try")
    readOn(&sixth, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 2, "the sixth line of a card that has six")
    found()
    card.monitor(2, two[0..256], false)
    card.store(0x16DA, 2)
    readOn(&wire, 6, 100000)
    expect(reader.heard.failure == ddc.Failure.taken_by_hardware && card.written == 0 && reader.heard.transfers == 5, "a line the card's hardware uses: no write")
    found()
    card.monitor(2, two[0..256], false)
    card.store(0x16D5, 0x9)
    readOn(&wire, 6, 100000)
    expect(reader.heard.failure == ddc.Failure.taken_by_controller && card.written == 0, "an engine that is the microcontroller's alone: no write")
    found()
    card.monitor(2, two[0..256], false)
    card.store(0x13B, 0x7F01)
    readOn(&wire, 6, 100000)
    expect(reader.heard.failure == ddc.Failure.no_clock && card.written == 0 && reader.heard.transfers == 1, "a time base that gives no prescale: no write")
    found()
    card.monitor(2, two[0..256], false)
    card.store(0x13B, 0)
    readOn(&wire, 6, 0)
    expect(reader.heard.failure == ddc.Failure.no_clock && card.written == 0, "no time base and no crystal: no write")
    found()
    card.monitor(2, two[0..256], false)
    card.store(0x16D4, 0xFFFFFFFF)
    readOn(&wire, 6, 100000)
    expect(reader.heard.failure == ddc.Failure.no_answer_from_card && card.written == 0, "an engine that does not answer: no write")
    // An engine that says "used by software" before it is started: not
    // started, let go with a soft reset, and the next try finds it free.
    found()
    card.monitor(2, two[0..256], false)
    card.stuck = true
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 2 && reader.heard.transfers == 4 && card.runs == 3 && asBefore(), "an engine that is busy beforehand is not started, but reset and tried again")
    expect(card.writtenTo[9] == 0x16D4 && card.writtenWith[9] & 0xA == 0xA && card.writtenTo[8] == 0x16EE, "the busy engine is reset after its first message was put in, before any run")
}

// The same reading a piece a tick: no pause, the bounds by the clock.
fn byTicks() -> void {
    const c = card.card()
    const h = card.hands()
    const wire = ddc.Wire.{ .line = 2, .entry = 1, .hardware = true, .why = ddc.Unwired.wired }
    found()
    card.byClock = true
    card.monitor(2, four[0..512], true)
    remember()
    card.forget()
    reader.start(&c, &wire, 6, 100000)
    var ticks: usize = 0
    while reader.busy() && ticks < 1000 {
        card.clock += 10000000
        var pieces: usize = 0
        while reader.step(&c, &h, false) == ddc.Next.again && pieces < 16 { pieces += 1 }
        expect(pieces < 16, "a tick's pieces come to a wait")
        ticks += 1
    }
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 4 && sameBytes(four[0..], 512) && card.pauses == 0, "an EDID read a piece a tick, without a pause")
    // (The first look is over at the tick after it was started, 0.36 ms
    // on the wire; a block's 11.8 ms take two ticks; each transfer is
    // begun at the tick the one before it ended.)
    expect(ticks == 10 && asBefore() && card.protocol == 0, "four blocks in ten ticks, every word back")
    // A busy engine: given up when the bound has passed by the clock (a
    // first look's 8.96 ms: at the next tick).
    found()
    card.monitor(2, two[0..256], false)
    card.staysBusy = true
    card.forget()
    reader.start(&c, &wire, 6, 100000)
    ticks = 0
    while reader.busy() && ticks < 1000 {
        card.clock += 10000000
        var pieces: usize = 0
        while reader.step(&c, &h, false) == ddc.Next.again && pieces < 16 { pieces += 1 }
        ticks += 1
    }
    expect(reader.heard.failure == ddc.Failure.stays_busy && ticks == 6 && card.pauses == 0 && card.statusReads < 60, "a busy engine by ticks: the bound is the clock's")
    // A pad to settle: not switched before 2 ms have passed.
    found()
    card.store(0x4870, 0x11011010)
    card.store(0x4872, 0x00000001)
    card.monitor(2, one[0..128], false)
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 1)
    expect(transfer.step(&c, &h, false) == ddc.Next.wait && card.written == 0 && transfer.pause == 2000, "the pad's pins are given time to let go")
    card.clock += 1000000
    expect(transfer.step(&c, &h, false) == ddc.Next.wait && card.written == 0, "a millisecond is not enough")
    card.clock += 1000000
    expect(transfer.step(&c, &h, false) == ddc.Next.again && card.written == 1 && card.writtenTo[0] == 0x4870 && card.writtenWith[0] == 0x11001010, "after 2 ms the pad is switched to I2C")
}

fn fourBoard() -> void {
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..], ENCODERS[0..], PINS[0..], ENTRIES[0..], PINS[0..], SHIFTS[0..], CLOCKS[0..])
    open()
    card.line(2, false)
    card.line(1, false)
    card.line(6, false)
    card.line(4, false)
}

fn dump() -> void {
    if !show { return }
    say(card.log[0..card.logged])
    say("--\n")
}

// Which EDID counts for a connector against what the loader passed on,
// worked out and said.
fn which(port: *const plug.Port, loader: []const u8) -> plug.Counts {
    const c = card.card()
    var at: usize = 0
    const counts = plug.counts(&port.*.heard, loader, &at)
    plug.sayCounts(&c, port, counts, at, loader.length)
    return counts
}

// The user's machine as its log of 17 November has it: five connectors
// (two DisplayPort on DIG 2 and 3, hot plug lines 1 and 5; HDMI on DIG 4
// and line 6, and on DIG 5 and line 4; DVI-D on DIG 0 and line 3), the
// firmware's picture out of the first HDMI connector in DVI mode, a
// monitor whose EDID has its HDMI block in the extension, and a firmware
// that gives the loader the EDID's first block alone. (Which of the
// card's DDC lines the ROM's entries are is not known yet: here entry n
// is line n.)
fn usersMachine() -> void {
    const c = card.card()
    const h = card.hands()
    const connectors = [_]usize{ 0x3113, 0x3213, 0x310C, 0x320C, 0x3104 }
    const encoders = [_]usize{ 0x2120, 0x2220, 0x2121, 0x2221, 0x211E }
    const pins = [_]usize{ 1, 5, 6, 4, 3 }
    const shifts = [_]usize{ 0, 26, 28, 24, 16 }
    const entries = [_]usize{ 1, 3, 0, 2, 5 }
    const clocks = [_]usize{ 0x4869, 0x486D, 0x4871, 0x4875, 0x4879, 0x487D }
    card.reset()
    card.makeRom(&builder, connectors[0..], encoders[0..], pins[0..], entries[0..], pins[0..], shifts[0..], clocks[0..])
    open()
    var n: usize = 1
    while n <= 6 {
        card.line(n, n == 6)
        n += 1
    }
    card.output(0, 4, 4, scanout.MODE_DVI)
    card.monitor(0, two[0..256], false)
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    card.forget()
    plug.sayPorts(&c, &watch.ports)
    var verdict: plug.Verdict = undefined
    plug.detect(&watch.ports, &verdict)
    plug.sayVerdict(&c, &watch.ports, &verdict)
    expect(card.written == 0, "the user's machine is looked at without a write")
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    const port = &watch.ports.ports[2]
    const counts = which(port, two[0..128])
    dump()
    once("gpu: connector 0 (DisplayPort, DIG 2, hot plug line 1): nothing is plugged in\n")
    once("gpu: connector 1 (DisplayPort, DIG 3, hot plug line 5): nothing is plugged in\n")
    once("gpu: connector 2 (HDMI, DIG 4, hot plug line 6): a monitor is plugged in; the firmware's picture goes out here\n")
    once("gpu: connector 3 (HDMI, DIG 5, hot plug line 4): nothing is plugged in\n")
    once("gpu: connector 4 (DVI-D (dual link), DIG 0, hot plug line 3): nothing is plugged in\n")
    once("gpu: the monitor is on the HDMI connector 2 (DIG 4, hot plug line 6): the TMDS path\n")
    once("gpu: connector 2 (HDMI): the monitor says 3840x1080 at 60 Hz, HDMI, up to 300 MHz (EDID of 2 blocks over DDC line 0, the card's DDC1)\n")
    once("gpu: connector 2 (HDMI): the loader passed on the first 1 block of it alone: the plan goes by all 2, read from the connector now\n")
    expect(verdict.what == plug.Case.there && verdict.output == 2 && counts == plug.Counts.connectors_longer && plug.fromConnector(counts), "the user's machine: the monitor found, and the EDID read from the connector counts")
    // What the loader's one block says, and what the plan gets now.
    const loaders = edid.offer(two[0..128])
    expect(!loaders.hdmi && loaders.extensions == 1 && loaders.given == 0, "the loader's block alone does not say that the monitor is an HDMI one")
    expect(port.*.offer.hdmi && port.*.offer.limit == 300000 && port.*.offer.extensions == 1 && port.*.offer.given == 1 && port.*.monitor.state == edid.State.found && port.*.monitor.timing.clock == 266640, "the EDID read over DDC says it, with the monitor's own timing")
    expect(card.protocol == 0 && watch.ports.ports[2].heard.restored, "the engine took the reading, and every word is back")
}

fn atBoot() -> void {
    const c = card.card()
    const h = card.hands()
    // The firmware's picture on the HDMI connector (the card's DDC2), a
    // DVI monitor on the second HDMI connector (DDC6), nothing on the
    // DVI connector.
    fourBoard()
    card.line(2, true)
    card.line(4, true)
    card.output(0, 4, 4, scanout.MODE_DVI)
    card.monitor(1, two[0..256], false)
    card.monitor(5, one[0..128], false)
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    card.forget()
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    dump()
    once("gpu: connector 0 (HDMI): the monitor says 3840x1080 at 60 Hz, HDMI, up to 300 MHz (EDID of 2 blocks over DDC line 2, the card's DDC2)\n")
    once("gpu: connector 3 (HDMI): the monitor says 3840x1080 at 60 Hz, DVI (its EDID has no HDMI block) (EDID of 1 block over DDC line 3, the card's DDC6)\n")
    noLine("connector 1")
    noLine("connector 2")
    const first = &watch.ports.ports[0]
    expect(first.*.heard.outcome == ddc.Outcome.read && first.*.heard.count == 256 && first.*.monitor.state == edid.State.found && first.*.monitor.width == 3840 && first.*.offer.hdmi && first.*.offer.limit == 300000 && first.*.heardAt != 0, "the record: the EDID as read and what it says")
    expect(watch.ports.ports[1].heard.outcome == ddc.Outcome.not_asked && watch.ports.ports[2].heard.outcome == ddc.Outcome.not_asked, "the record of who was not asked")
    expect(card.protocol == 0, "the engine took the boot's readings")
    // Held against the EDID the loader passed on.
    var at: usize = 99
    expect(plug.against(&first.*.heard, two[0..256], &at) == plug.Against.same, "the same EDID as the loader's")
    expect(plug.against(&first.*.heard, two[0..128], &at) == plug.Against.same, "the same as far as the loader's goes")
    expect(plug.against(&first.*.heard, two[0..0], &at) == plug.Against.no_other, "the loader passed none on")
    two[200] = two[200] ^ 1
    expect(plug.against(&first.*.heard, two[0..256], &at) == plug.Against.differs && at == 200, "another EDID than the loader's, and where")
    two[200] = two[200] ^ 1
    // Which of the two the plan is made from, and the line that says so.
    card.forget()
    expect(which(first, two[0..256]) == plug.Counts.same && plug.fromConnector(plug.Counts.same), "the same EDID: the one read")
    once("gpu: connector 0 (HDMI): it is the EDID the loader passed on\n")
    expect(which(first, two[0..128]) == plug.Counts.connectors_longer && plug.fromConnector(plug.Counts.connectors_longer), "the loader has the first block alone: the one read counts")
    once("gpu: connector 0 (HDMI): the loader passed on the first 1 block of it alone: the plan goes by all 2, read from the connector now\n")
    expect(which(first, two[0..0]) == plug.Counts.connectors_alone && plug.fromConnector(plug.Counts.connectors_alone), "the loader has none: the one read counts")
    once("gpu: connector 0 (HDMI): the loader passed no EDID on: the one read from the connector counts\n")
    two[12] = two[12] ^ 1
    expect(which(first, two[0..256]) == plug.Counts.connectors_other && plug.fromConnector(plug.Counts.connectors_other), "another EDID, read whole: the one read counts")
    once("gpu: connector 0 (HDMI): the EDID read from the connector differs from the one the loader passed on (from byte 12 on): the one read now counts, it is the monitor that is there\n")
    first.*.heard.complete = false
    expect(which(first, two[0..256]) == plug.Counts.loaders_other && !plug.fromConnector(plug.Counts.loaders_other), "another EDID, not read whole: the loader's counts")
    once("gpu: connector 0 (HDMI): the EDID read from the connector differs from the one the loader passed on (from byte 12 on) and was not read whole: the loader's counts\n")
    two[12] = two[12] ^ 1
    first.*.heard.count = 128
    first.*.heard.blocks = 1
    expect(which(first, two[0..256]) == plug.Counts.loaders_longer && !plug.fromConnector(plug.Counts.loaders_longer), "the loader has more of the same EDID: the loader's counts")
    once("gpu: connector 0 (HDMI): it is the EDID the loader passed on as far as it was read: the loader's, which has more of it, counts\n")
    first.*.heard.outcome = ddc.Outcome.no_answer
    first.*.heard.count = 0
    expect(which(first, two[0..256]) == plug.Counts.loaders && !plug.fromConnector(plug.Counts.loaders), "nothing read: the loader's counts")
    once("gpu: connector 0 (HDMI): the EDID the loader passed on counts\n")
    const said = card.logged
    expect(which(first, two[0..0]) == plug.Counts.nothing && !plug.fromConnector(plug.Counts.nothing) && card.logged == said, "nothing read and nothing passed on: nothing to say")

    // What is said of a reading that failed.
    fourBoard()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    plug.survey(&c, &machine, &board, &watch.ports)
    card.forget()
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    once("gpu: connector 0 (HDMI): nothing answers on DDC line 2, the card's DDC2: no EDID (a monitor that is off, or none)\n")
    card.monitor(1, eight[0..1024], true)
    card.forget()
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    once("gpu: connector 0 (HDMI): the monitor says 3840x1080 at 60 Hz, HDMI, up to 300 MHz (EDID of 4 blocks over DDC line 2, the card's DDC2; it names 8: the others were not read or do not hold)\n")
    card.monitor(1, two[0..256], false)
    card.spoilFrom = 0
    card.spoilReads = 99
    card.forget()
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    once("gpu: connector 0 (HDMI): what answers on DDC line 2, the card's DDC2, gives no EDID that holds (its base block adds up to 0x10)\n")
    card.spoilFrom = card.NEVER
    card.staysBusy = true
    card.forget()
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    once("gpu: connector 0 (HDMI): its EDID could not be read over DDC line 2, the card's DDC2: the I2C engine stayed busy (the engine's status 0x1)\n")
    card.staysBusy = false
    card.deaf = 0x16E1
    card.deafFrom = card.runs + 1
    card.forget()
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    line("gpu: DDC line 2, the card's DDC2: the register 0x16e1 did not take back what it held before the EDID was read\n")
    dump()
    // A connector whose line the ROM does not give.
    const none = [_]usize{ 0xFF, 0, 1, 3 }
    card.reset()
    card.makeRom(&builder, CONNECTORS[0..], ENCODERS[0..], PINS[0..], none[0..], PINS[0..], SHIFTS[0..], CLOCKS[0..])
    open()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    plug.survey(&c, &machine, &board, &watch.ports)
    card.forget()
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    once("gpu: connector 0 (HDMI): its monitor cannot be asked: the ROM names no DDC line for it\n")
    expect(card.written == 0, "a connector without a DDC line: nothing is written")
    dump()
}

// A tick every 10 ms until `until`.
var most: usize = 0

fn ticks(until: usize, lend: bool) -> void {
    const c = card.card()
    const h = card.hands()
    while card.clock + 10000000 <= until {
        card.clock += 10000000
        const reads = card.reads
        if lend {
            plug.tick(&c, &h, &watch)
        } else {
            plug.tick(&c, null, &watch)
        }
        if card.reads - reads > most { most = card.reads - reads }
    }
}

fn whileRunning() -> void {
    const c = card.card()
    const ms: usize = 1000000
    fourBoard()
    card.byClock = true
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.monitor(1, two[0..256], false)
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    card.forget()
    const start = card.clock

    // A monitor plugged into the second HDMI connector at 50 ms: said at
    // 600 ms, asked from the next tick on, heard a few ticks later.
    card.monitor(5, two[0..256], false)
    card.lineLater(start + 50 * ms, 4, true)
    ticks(start + 590 * ms, true)
    expect(card.written == 0, "nobody is asked before the plug counts")
    ticks(start + 600 * ms, true)
    once("gpu: something was plugged into connector 3 (HDMI)\n")
    expect(watch.reading == 3 && card.written == 0, "the reading is begun at the tick the plug is said")
    ticks(start + 800 * ms, true)
    once("gpu: connector 3 (HDMI): the monitor says 3840x1080 at 60 Hz, HDMI, up to 300 MHz (EDID of 2 blocks over DDC line 3, the card's DDC6)\n")
    expect(watch.reading == plug.NONE && watch.ports.ports[3].heard.outcome == ddc.Outcome.read && watch.ports.ports[3].heard.count == 256 && watch.ports.ports[3].monitor.width == 3840, "the record after the reading")
    expect(card.pauses == 0 && card.protocol == 0, "a reading by ticks pauses nowhere")
    expect(watch.ports.ports[3].heardAt >= start + 600 * ms && watch.ports.ports[3].heardAt <= start + 800 * ms, "when it was heard")

    // Unplugged: said, and what was heard is forgotten.
    card.lineLater(start + 1050 * ms, 4, false)
    card.unplug(5)
    ticks(start + 1300 * ms, true)
    once("gpu: the monitor was unplugged from connector 3 (HDMI)\n")
    expect(watch.ports.ports[3].heard.outcome == ddc.Outcome.not_asked && watch.ports.ports[3].heard.count == 0 && watch.ports.ports[3].monitor.state == edid.State.none, "an unplugged monitor's EDID is forgotten")

    // Plugged in again, its DDC pins making contact 700 ms after the
    // hot plug pin: nothing answers at first, a second later it does;
    // one line.
    card.forget()
    card.lineLater(start + 2050 * ms, 4, true)
    ticks(start + 2700 * ms, true)
    expect(watch.ports.ports[3].asked == 1 && watch.ports.ports[3].askAt != 0 && card.logged != 0, "nothing answered: to be asked again")
    noLine("nothing answers")
    card.monitor(5, one[0..128], false)
    ticks(start + 3590 * ms, true)
    noLine("the monitor says")
    ticks(start + 3800 * ms, true)
    once("gpu: connector 3 (HDMI): the monitor says 3840x1080 at 60 Hz, DVI (its EDID has no HDMI block) (EDID of 1 block over DDC line 3, the card's DDC6)\n")
    expect(watch.ports.ports[3].asked == 2, "asked twice")
    // And one that never answers: said after the second asking.
    card.lineLater(start + 4050 * ms, 4, false)
    card.unplug(5)
    card.lineLater(start + 5050 * ms, 4, true)
    card.forget()
    ticks(start + 6590 * ms, true)
    noLine("nothing answers")
    ticks(start + 6800 * ms, true)
    once("gpu: connector 3 (HDMI): nothing answers on DDC line 3, the card's DDC6: no EDID (a monitor that is off, or none)\n")
    ticks(start + 9000 * ms, true)
    once("nothing answers")
    expect(watch.ports.ports[3].heard.outcome == ddc.Outcome.no_answer, "the record of a monitor that does not answer")

    // Unplugged while its EDID is read for the second time (the engine
    // busy in a block's read, a third of a second a try): what the
    // reading gives is nothing's, and nothing is said or kept of it.
    // (First pulled and put back; its first asking is not answered.)
    card.monitor(5, two[0..256], false)
    card.nackFrom = card.runs
    card.nackRuns = 5
    card.lineLater(start + 9010 * ms, 4, false)
    card.lineLater(start + 9210 * ms, 4, true)
    card.forget()
    ticks(start + 9900 * ms, true)
    once("gpu: something was plugged into connector 3 (HDMI)\n")
    expect(watch.ports.ports[3].asked == 1 && watch.ports.ports[3].askAt != 0 && watch.reading == plug.NONE, "the first asking was not answered")
    const second = card.runs
    var waited: usize = 0
    while (watch.ports.ports[3].asked < 2 || card.runs < second + 2) && waited < 300 {
        ticks(card.clock + 10 * ms, true)
        waited += 1
    }
    expect(waited < 300, "the second asking comes a second after the first, and reads its first block")
    card.staysBusy = true
    const pulled = card.clock
    card.lineLater(pulled + 50 * ms, 4, false)
    card.unplug(5)
    ticks(pulled + 400 * ms, true)
    expect(card.count("gpu: what was plugged in was unplugged from connector 3 (HDMI)\n") == 2, "the unplug is said while the reading goes on")
    expect(watch.reading == 3, "the reading of the unplugged connector's EDID goes on to its end")
    ticks(pulled + 2500 * ms, true)
    card.staysBusy = false
    expect(watch.reading == plug.NONE && watch.ports.ports[3].heard.outcome == ddc.Outcome.not_asked && watch.ports.ports[3].askAt == 0, "what was read for an unplugged connector is not kept")
    noLine("could not be read")
    noLine("the monitor says")
    // (On to the next whole second.)
    const later = start + ((card.clock - start) / (1000 * ms) + 1) * 1000 * ms
    ticks(later, true)

    // Two at once (the DVI connector and the firmware's HDMI, unplugged
    // and plugged again): read one after the other.
    card.forget()
    card.monitor(0, one[0..128], false)
    card.lineLater(later + 50 * ms, 2, false)
    card.lineLater(later + 250 * ms, 2, true)
    card.lineLater(later + 250 * ms, 6, true)
    ticks(later + 800 * ms, true)
    expect(watch.reading != plug.NONE, "one EDID is being read")
    ticks(later + 1200 * ms, true)
    once("gpu: something was plugged into connector 0 (HDMI), where the picture goes out\n")
    once("gpu: something was plugged into connector 2 (DVI-D (dual link))\n")
    once("gpu: connector 0 (HDMI): the monitor says 3840x1080 at 60 Hz, HDMI, up to 300 MHz (EDID of 2 blocks over DDC line 2, the card's DDC2)\n")
    once("gpu: connector 2 (DVI-D (dual link)): the monitor says 3840x1080 at 60 Hz, DVI (its EDID has no HDMI block) (EDID of 1 block over DDC line 1, the card's DDC1)\n")
    expect(card.protocol == 0 && card.pauses == 0, "two readings, one after the other")
    // Something plugged into the DisplayPort connector: said, not asked.
    card.forget()
    card.lineLater(later + 1250 * ms, 1, true)
    ticks(later + 2000 * ms, true)
    once("gpu: something was plugged into connector 1 (DisplayPort)\n")
    expect(card.written == 0 && watch.ports.ports[1].heard.outcome == ddc.Outcome.not_asked, "a DisplayPort connector's monitor is not asked over DDC")
    // (What a tick reads at most: a block's 128 bytes and what lets the
    // engine go and begins the next transfer.)
    expect(most < 220, "a tick's work is bounded")
    dump()

    // A boot that lends no hands: plugs are said, nobody is asked.
    fourBoard()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.monitor(5, two[0..256], false)
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    card.forget()
    card.lineLater(card.clock + 50 * ms, 4, true)
    ticks(card.clock + 3000 * ms, false)
    once("gpu: something was plugged into connector 3 (HDMI)\n")
    expect(card.written == 0 && watch.reading == plug.NONE && watch.ports.ports[3].heard.outcome == ddc.Outcome.not_asked, "without hands nobody is asked and nothing is written")
}

// A number of the test's own making (the same every run).
var seed: usize = 20261117

fn random() -> usize {
    seed = (seed * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF
    return (seed >> 33) & 0x7FFFFFFF
}

// The engine's and every line's words holding anything (but the bit that
// starts a run, and nothing that says the engine is taken): what a
// firmware or another driver may have left.
fn anything() -> void {
    card.reset()
    card.store(0x16D4, random() & 0x0030070E)
    card.store(0x16D5, random() & 0x00301113)
    var n: usize = 0
    while n < 6 {
        card.store(0x16DE + 2 * n, random() & 0xFFFF0313)
        card.store(0x16DF + 2 * n, random() & 0xFFFFFFF3)
        card.store(0x4868 + 4 * n, random() & 0xFF5151D1)
        card.store(0x486A + 4 * n, random() & 0x0101)
        n += 1
    }
    n = 0
    while n < 4 {
        card.store(0x16EA + n, random() & 0x03FF3101)
        n += 1
    }
}

fn still(microseconds: usize) -> void {}

var many: [1024]u8 = undefined
var users: [1024]u8 = undefined
var other: [1024]u8 = undefined

// A block's last byte set so that the block adds up to 0.
fn resum(bytes: []u8, block: usize) -> void {
    var sum: usize = 0
    var k: usize = 0
    while k < 127 {
        sum += @intCast(usize, bytes[block * 128 + k])
        k += 1
    }
    bytes[block * 128 + 127] = @intCast(u8, (256 - (sum & 0xFF)) & 0xFF)
}

// Cards of every kind: an EDID of four blocks read on each of the six
// lines whatever the engine's and the pins' words held, and every word
// as it was found; a missing acknowledge at every message of every
// transfer, once and for good; an engine that never finishes, with a
// clock that goes and with one that stands still; one busy beforehand;
// bytes that come out wrong at every read; 255 blocks named; a block
// named that is not there.
fn everyCard() -> void {
    const c = card.card()
    const h = card.hands()
    var on: usize = 0
    while on < 6 {
        var round: usize = 0
        while round < 10 {
            const wire = ddc.Wire.{ .line = on, .entry = on, .hardware = true, .why = ddc.Unwired.wired }
            anything()
            card.monitor(on, four[0..512], true)
            readOn(&wire, 6, 100000)
            expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 4 && reader.heard.complete && sameBytes(four[0..], 512), "four blocks read whatever the card's words held")
            expect(card.protocol == 0 && asBefore() && reader.heard.restored, "the engine driven as Linux drives it and every word as found, whatever it held")
            round += 1
        }
        on += 1
    }
    const wire = ddc.Wire.{ .line = 1, .entry = 1, .hardware = true, .why = ddc.Unwired.wired }
    // The transfers of a four-block read: the first look (two messages),
    // blocks 0 and 1 (two), blocks 2 and 3 (three, the segment pointer
    // first).
    var run: usize = 0
    while run < 5 {
        const messages: usize = if run < 3 { 2 } else { 3 }
        var message: usize = 0
        while message < messages {
            anything()
            card.monitor(1, four[0..512], true)
            card.nackFrom = run
            card.nackRuns = 1
            card.nackMessage = message
            readOn(&wire, 6, 100000)
            expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 4 && reader.heard.transfers == 6 && asBefore(), "a missing acknowledge once, at any message: one transfer more, the whole EDID, every word back")
            anything()
            card.monitor(1, four[0..512], true)
            card.nackFrom = run
            card.nackRuns = 1000
            card.nackMessage = message
            readOn(&wire, 6, 100000)
            if run == 0 {
                expect(reader.heard.outcome == ddc.Outcome.no_answer && reader.heard.failure == ddc.Failure.not_acknowledged && reader.heard.transfers == 5, "the first look never acknowledged: nothing answers")
            } else if run == 1 {
                expect(reader.heard.outcome == ddc.Outcome.failed && reader.heard.failure == ddc.Failure.not_acknowledged && reader.heard.count == 0, "the base block never acknowledged: no EDID")
            } else {
                expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == run - 1 && reader.heard.count == (run - 1) * 128 && !reader.heard.complete, "an extension never acknowledged: the blocks before it are the EDID, not complete")
            }
            expect(asBefore() && reader.heard.restored && card.protocol == 0, "every word back after a missing acknowledge")
            message += 1
        }
        run += 1
    }
    // An engine that never finishes: Linux's bound to the look, five
    // times; then with a clock that stands still (the pauses do not
    // move it) from the first block on: the counts alone end it.
    anything()
    card.monitor(1, four[0..512], true)
    card.staysBusy = true
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.failed && reader.heard.failure == ddc.Failure.stays_busy && reader.heard.transfers == 5 && asBefore(), "an engine that never finishes: given up, every word back")
    expect(card.statusReads >= 5 * 8960 && card.statusReads < 5 * 8960 + 40, "the first look's wait is Linux's bound, five times")
    anything()
    card.monitor(1, four[0..512], true)
    card.busyRuns = 0xFFFFFFFE
    card.forget()
    remember()
    ddc.read(&c, &h, still, &wire, 6, 100000, &reader)
    expect(reader.heard.outcome == ddc.Outcome.failed && reader.heard.failure == ddc.Failure.stays_busy && reader.heard.transfers == 6 && asBefore(), "the block's wait ends by its count where the clock stands still")
    expect(card.statusReads > 5 * 334080 && card.statusReads < 5 * 334080 + 200, "five waits of Linux's bound for a block, and no more")
    // Busy before anything was started: reset, and read.
    anything()
    card.monitor(1, four[0..512], true)
    card.stuck = true
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 4 && asBefore(), "an engine busy beforehand is reset and used")
    // Bytes that come out wrong at every read of a block.
    anything()
    card.monitor(1, four[0..512], true)
    card.spoilFrom = 0
    card.spoilReads = 1000
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.does_not_hold && reader.heard.count == 0 && reader.heard.transfers == 5 && asBefore(), "a base block that never adds up: four reads, no EDID")
    anything()
    card.monitor(1, four[0..512], true)
    card.spoilFrom = 1
    card.spoilReads = 1000
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 1 && !reader.heard.complete && reader.heard.transfers == 6 && asBefore(), "extensions that never add up: the base block is the EDID")
    // 255 extension blocks named: by a monitor of two blocks without a
    // segment pointer, and by one whose memory has four.
    var k: usize = 0
    while k < 512 {
        many[k] = four[k]
        k += 1
    }
    many[126] = 255
    resum(many[0..], 0)
    anything()
    card.monitor(1, many[0..256], false)
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 2 && reader.heard.extensions == 255 && !reader.heard.complete && asBefore(), "255 named, two there: two read, not complete")
    anything()
    card.monitor(1, many[0..512], true)
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 4 && reader.heard.count == 512 && !reader.heard.complete && asBefore(), "255 named: four kept, not complete")
    // An extension named that is not there (beyond its memory the
    // monitor gives 0xFF).
    anything()
    card.monitor(1, two[0..128], false)
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 1 && !reader.heard.complete && asBefore(), "a block of 0xFF is no extension")
}

// What the tests above did not hold of a transfer and a reading.
fn corners() -> void {
    const c = card.card()
    const h = card.hands()
    const wire = ddc.Wire.{ .line = 2, .entry = 1, .hardware = true, .why = ddc.Unwired.wired }
    // The arbitration word alone does not answer: refused before a write.
    found()
    card.monitor(2, two[0..256], false)
    card.store(0x16D5, 0xFFFFFFFF)
    readOn(&wire, 6, 100000)
    expect(reader.heard.failure == ddc.Failure.no_answer_from_card && card.written == 0 && reader.heard.transfers == 1, "an arbitration word that does not answer: refused before a write")
    // A control word the firmware left with its resets and a count: the
    // word written at the engine's setup has them off (setup_engine's
    // DC_I2C_SOFT_RESET, DC_I2C_SEND_RESET and DC_I2C_TRANSACTION_COUNT
    // 0), and the word is as found afterwards.
    found()
    card.store(0x16D4, 0x00300506)
    card.monitor(2, four[0..512], true)
    remember()
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 1)
    through(&transfer)
    expect(transfer.succeeded() && card.writtenTo[3] == 0x16D4 && card.writtenWith[3] == 0x00000208, "the engine's setup clears the resets and the count a firmware left")
    expect(asBefore() && card.protocol == 0, "and the control word is as found afterwards")
    // A missing acknowledge that stays in the status word whatever is
    // reset: seen after the message that does not end the run, and no
    // run is started (Linux gives the transfer up there).
    found()
    card.monitor(2, two[0..256], false)
    card.stale = 0x100
    remember()
    card.forget()
    transfer.begin(2, 6, 100000)
    transfer.write(0x50, 0)
    transfer.read(0x50, 1)
    through(&transfer)
    expect(!transfer.succeeded() && transfer.failure == ddc.Failure.not_acknowledged && card.runs == 0, "a failure in the status word before the run: no run is started")
    card.stale = 0
    expect(asBefore(), "and every word is back")
    // A status word with a missing acknowledge and the time limit both:
    // the missing acknowledge counts (get_channel_status's order).
    found()
    card.stale = 0x20
    transfer.begin(2, 6, 100000)
    transfer.read(0x50, 1)
    through(&transfer)
    expect(transfer.failure == ddc.Failure.not_acknowledged && transfer.status & 0x120 == 0x120, "a missing acknowledge comes before the time limit")
    card.stale = 0
    // A block that does not hold is read again with five tries of its
    // own: the first read's sum is wrong, the next four transfers are
    // not acknowledged, the fifth gets through.
    found()
    card.monitor(2, two[0..256], false)
    card.spoilFrom = 0
    card.spoilReads = 1
    card.nackFrom = 2
    card.nackRuns = 4
    card.nackMessage = 0
    readOn(&wire, 6, 100000)
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 2 && sameBytes(two[0..], 256) && reader.heard.transfers == 8 && asBefore(), "a block read again has five tries of its own")
    // The two seconds are held between an EDID's blocks too: a clock
    // that goes on 0.3 s each time it is asked.
    found()
    card.monitor(2, four[0..512], true)
    card.stride = 300000000
    readOn(&wire, 6, 100000)
    card.stride = 0
    expect(reader.heard.outcome == ddc.Outcome.read && reader.heard.blocks == 3 && !reader.heard.complete && asBefore(), "no block is begun after the reading's two seconds")
}

// The user's monitor's own timing as the machine's log has it (270270
// kHz, 3840 of 4040, 1080 of 1115: 59.998 frames a second) is said as 60
// Hz; and the asking at boot is counted in the record.
fn usersTiming() -> void {
    const c = card.card()
    const h = card.hands()
    var k: usize = 0
    while k < 256 {
        users[k] = two[k]
        k += 1
    }
    users[54] = 0x93
    users[55] = 0x69
    users[56] = 0x00
    users[57] = 0xC8
    users[58] = 0xF0
    users[59] = 0x38
    users[60] = 0x23
    users[61] = 0x40
    users[62] = 48
    users[63] = 32
    users[64] = 0x35
    users[65] = 0x00
    resum(users[0..], 0)
    fourBoard()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_DVI)
    card.monitor(1, users[0..256], false)
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    card.forget()
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    dump()
    const port = &watch.ports.ports[0]
    expect(port.*.monitor.timing.clock == 270270 && port.*.monitor.timing.hTotal == 4040 && port.*.monitor.timing.vTotal == 1115 && port.*.monitor.timing.millihertz() < 60000, "the user's monitor's timing, a little under 60 frames a second")
    once("gpu: connector 0 (HDMI): the monitor says 3840x1080 at 60 Hz, HDMI, up to 300 MHz (EDID of 2 blocks over DDC line 2, the card's DDC2)\n")
    expect(port.*.asked == 1 && watch.ports.ports[1].asked == 0 && watch.ports.ports[3].asked == 0, "who was asked at boot is in the record")
}

// A reading that is under way when its monitor is pulled and another is
// plugged in: what it gives is not said of the new monitor (its base
// block was the old one's); the new one is asked for itself.
fn movedMeanwhile() -> void {
    const c = card.card()
    const ms: usize = 1000000
    var k: usize = 0
    while k < 128 {
        other[k] = one[k]
        k += 1
    }
    // (1920 across instead of 3840.)
    other[56] = 0x80
    other[58] = 0x70
    resum(other[0..], 0)
    fourBoard()
    card.byClock = true
    card.output(0, 4, 4, scanout.MODE_HDMI)
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    card.forget()
    const start = card.clock
    // The first monitor (two blocks) plugged into the second HDMI
    // connector at 50 ms: taken at 600 ms, its base block read at once;
    // the engine then stays busy four times at its second block (0.33 s
    // each).
    card.monitor(5, two[0..256], false)
    card.busyRuns = 0x3C
    card.lineLater(start + 50 * ms, 4, true)
    ticks(start + 690 * ms, true)
    expect(watch.reading == 3 && watch.reader.heard.blocks == 1, "the first monitor's base block is read")
    // Pulled at 700 ms (taken at 900), another monitor plugged in at 950
    // (taken at 1500), the reading still under way.
    card.lineLater(start + 700 * ms, 4, false)
    card.lineLater(start + 950 * ms, 4, true)
    ticks(start + 940 * ms, true)
    card.monitor(5, other[0..128], false)
    ticks(start + 1600 * ms, true)
    // (Not "the monitor": it had not been heard to the end.)
    once("gpu: what was plugged in was unplugged from connector 3 (HDMI)\n")
    expect(card.count("gpu: something was plugged into connector 3 (HDMI)\n") == 2 && watch.reading == 3, "the second plug is taken while the first reading is under way")
    ticks(start + 4000 * ms, true)
    dump()
    noLine("the monitor says 3840x1080")
    once("gpu: connector 3 (HDMI): the monitor says 1920x1080 at ")
    expect(watch.ports.ports[3].heard.outcome == ddc.Outcome.read && watch.ports.ports[3].heard.blocks == 1 && watch.ports.ports[3].heard.complete && watch.ports.ports[3].monitor.width == 1920, "the record holds the monitor that is there")
    expect(card.protocol == 0 && watch.reading == plug.NONE, "the engine was driven as Linux drives it throughout")
}

// With hands lent: an hour of ticks on a card that stands still (a
// monitor on the firmware's output, heard at boot) writes nothing; and a
// monitor moved between the two HDMI connectors every three seconds for
// a minute is heard once at each plug, each move said once, the engine's
// words as found at the end.
fn lent() -> void {
    const c = card.card()
    const h = card.hands()
    fourBoard()
    card.line(2, true)
    card.output(0, 4, 4, scanout.MODE_HDMI)
    card.monitor(1, two[0..256], false)
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    plug.askAtBoot(&c, &h, card.pause, 6, 100000, &watch.ports, &watch.reader)
    card.forget()
    var t: usize = 0
    while t < 360000 {
        card.clock += 10000000
        plug.tick(&c, &h, &watch)
        t += 1
    }
    expect(card.written == 0 && card.logged == 0 && watch.ports.looks == 36000, "an hour of ticks with hands lent on a still card: not a write, not a word")

    anything()
    card.makeRom(&builder, CONNECTORS[0..], ENCODERS[0..], PINS[0..], ENTRIES[0..], PINS[0..], SHIFTS[0..], CLOCKS[0..])
    open()
    card.line(2, false)
    card.line(1, false)
    card.line(6, false)
    card.line(4, false)
    card.byClock = true
    card.output(0, 4, 4, scanout.MODE_HDMI)
    plug.survey(&c, &machine, &board, &watch.ports)
    watch.begin(&c, 6, 100000)
    card.forget()
    remember()
    t = 0
    while t < 6000 {
        if t % 300 == 0 {
            const first = (t / 300) % 2 == 0
            card.sense(2, first, first)
            card.sense(4, !first, !first)
            if first {
                card.monitor(1, two[0..256], false)
                card.unplug(5)
            } else {
                card.monitor(5, two[0..256], false)
                card.unplug(1)
            }
        }
        card.clock += 10000000
        plug.tick(&c, &h, &watch)
        t += 1
    }
    dump()
    expect(card.protocol == 0 && asBefore(), "after a minute of moving the monitor every word of the engine and the pins is as found")
    expect(card.count("the monitor says 3840x1080 at 60 Hz, HDMI, up to 300 MHz") == 20, "the monitor is heard once at each plug")
    expect(card.count("was plugged into") == 20 && card.count("was unplugged from") == 19 && card.count("gpu:") == 59, "each move said once, and nothing else")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    _ = card.edid(one[0..], 1, false)
    _ = card.edid(two[0..], 2, true)
    _ = card.edid(four[0..], 4, true)
    _ = card.edid(eight[0..], 8, true)
    _ = card.edid(plain[0..], 1, false)
    wires()
    wordForWord()
    edids()
    byTicks()
    usersMachine()
    atBoot()
    whileRunning()
    everyCard()
    corners()
    usersTiming()
    movedMeanwhile()
    lent()
    if failed != 0 { return failed }
    return 13
}
