// A @noncopy generic instance is dropped like a non-generic one: at
// scope exit (in LIFO order), not after a move, once after a
// conditional move, on return transfer, at loop exits, and as a
// by-value parameter.
fn Owned(comptime T: type) -> type {
    return @noncopy(struct) {
        value: T
        drops: *u8

        pub fn init(drops: *u8, value: T) -> Self {
            return Self.{ .value = value, .drops = drops }
        }

        pub fn get(self: *Self) -> T {
            return self.*.value
        }

        fn deinit(self: *Self) -> void {
            self.*.drops.* += 1
        }
    }
}

fn create(drops: *u8) -> Owned(u32) {
    const local = Owned(u32).init(drops, 7)
    return @move(local)
}

fn consume(value: Owned(u8)) -> u8 {
    return value.value
}

fn conditional(drops: *u8, take: bool) -> void {
    const source = Owned(u8).init(drops, 1)
    if take {
        const destination = @move(source)
    }
}

fn main() -> u8 {
    var drops: u8 = 0
    {
        var owned = Owned(u32).init(&drops, 40)
        const other = Owned(u8).init(&drops, 2)
        if @intCast(u8, owned.get()) + other.value != 42 { return 1 }
    }
    if drops != 2 { return 2 }
    {
        const source = Owned(u8).init(&drops, 3)
        const destination = @move(source)
        if destination.value != 3 { return 3 }
    }
    if drops != 3 { return 4 }
    conditional(&drops, true)
    conditional(&drops, false)
    if drops != 5 { return 5 }
    {
        const received = create(&drops)
        if received.value != 7 { return 6 }
    }
    if drops != 6 { return 7 }
    const given = Owned(u8).init(&drops, 9)
    if consume(@move(given)) != 9 { return 8 }
    if drops != 7 { return 9 }
    var index: u8 = 0
    while index < 3 {
        const iteration = Owned(u8).init(&drops, index)
        index += 1
        if index == 1 { continue }
        if index == 2 { break }
    }
    if drops != 9 { return 10 }
    var counted: u8 = 0
    {
        var reinitialized = Owned(u8).init(&counted, 1)
        const moved = @move(reinitialized)
        reinitialized = Owned(u8).init(&counted, 2)
    }
    if counted != 2 { return 11 }
    return 13
}
