// std.png.saveFile: a 61x37 image (a gradient, translucent stripes, a
// repeated pattern LZ77 matches) written as RGBA and as RGB reads back with
// std.png.loadFile as the same premultiplied pixels (translucent ones
// within one step per channel; RGB ones opaque). Exits 13.
const std = @import("std")
const png = @import("std.png")

const WIDTH: usize = 61
const HEIGHT: usize = 37

fn pixelAt(x: usize, y: usize) -> u32 {
    var alpha: u32 = 255
    if y >= 10 && y < 14 { alpha = @intCast(u32, x * 4) }
    if y == 20 { alpha = 0 }
    var red = @intCast(u32, (x * 255) / WIDTH)
    var green = @intCast(u32, (y * 255) / HEIGHT)
    var blue = @intCast(u32, ((x / 4 + y / 4) % 2) * 200)
    red = red * alpha / 255
    green = green * alpha / 255
    blue = blue * alpha / 255
    return (alpha << 24) | (red << 16) | (green << 8) | blue
}

fn near(first: u32, second: u32, tolerance: u32) -> bool {
    var shift: u32 = 0
    while shift < 32 {
        const a = (first >> shift) & 255
        const b = (second >> shift) & 255
        const difference = if a > b { a - b } else { b - a }
        if difference > tolerance { return false }
        shift += 8
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var words: [2257]u32 = undefined
    var y: usize = 0
    while y < HEIGHT {
        var x: usize = 0
        while x < WIDTH {
            words[y * WIDTH + x] = pixelAt(x, y)
            x += 1
        }
        y += 1
    }
    var pixels: [*]const u32 = undefined
    unsafe { pixels = @ptrCast([*]const u32, &words) }
    unsafe {
        if !png.saveFile(@ptrCast([*]const u8, "/tmp/mlx-png-encode-rgba.png"), pixels, WIDTH, HEIGHT, WIDTH, true, allocator) { return 1 }
        if !png.saveFile(@ptrCast([*]const u8, "/tmp/mlx-png-encode-rgb.png"), pixels, WIDTH, HEIGHT, WIDTH, false, allocator) { return 2 }
    }
    var image: png.Image = undefined
    unsafe {
        if png.loadFile(&image, @ptrCast([*]const u8, "/tmp/mlx-png-encode-rgba.png"), allocator) != png.Status.ok { return 3 }
    }
    if image.width != WIDTH || image.height != HEIGHT { return 4 }
    var index: usize = 0
    while index < WIDTH * HEIGHT {
        const tolerance: u32 = if words[index] >> 24 == 255 { 0 } else { 1 }
        if !near(image.pixels[index], words[index], tolerance) { return 5 }
        index += 1
    }
    png.deinit(&image)
    unsafe {
        if png.loadFile(&image, @ptrCast([*]const u8, "/tmp/mlx-png-encode-rgb.png"), allocator) != png.Status.ok { return 6 }
    }
    index = 0
    while index < WIDTH * HEIGHT {
        if image.pixels[index] >> 24 != 255 { return 7 }
        if words[index] >> 24 == 255 && image.pixels[index] != words[index] { return 8 }
        index += 1
    }
    png.deinit(&image)
    return 13
}
