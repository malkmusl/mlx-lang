const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const lir = @import("../compiler/selfhost/ir/lir.mlx")
const optimize = @import("../compiler/selfhost/ir/optimize.mlx")
const encoder = @import("../compiler/selfhost/backend/x86_64/encoder.mlx")
const target = @import("../compiler/selfhost/backend/x86_64/target.mlx")

fn optimizerFusesComparison(allocator: page_allocator.Allocator) -> bool {
    var ir = lir.init(allocator)
    const left = lir.addInst(&ir, lir.initInst(lir.Opcode.param, lir.NONE))
    const right = lir.addInst(&ir, lir.initInst(lir.Opcode.param, lir.NONE))
    var comparison = lir.initInst(lir.Opcode.icmp, lir.NONE)
    comparison.arg0 = @intCast(usize, @intFromEnum(lir.CmpPredicate.ult))
    comparison.arg1 = left
    comparison.arg2 = right
    const comparison_index = lir.addInst(&ir, comparison)
    const branch_index = lir.addInst(&ir, lir.condBranch(comparison_index, 7, 9))
    const result = optimize.run(&ir, allocator)
    const fused = result.comparisonBranchesFused == 1 && lir.getInst(&ir, comparison_index).opcode == lir.Opcode.dead && lir.getInst(&ir, branch_index).opcode == lir.Opcode.icmp_br && lir.getInst(&ir, branch_index).arg0 == comparison_index
    lir.deinit(&ir)
    return fused
}

fn encoderUsesMemoryOperands(allocator: page_allocator.Allocator) -> bool {
    var value = encoder.init(allocator)
    encoder.emitAddMem(&value, target.Register.rax, 24)
    encoder.emitCmpMem(&value, target.Register.rax, 24)
    const valid = encoder.memoryOperands(&value) == 2 && encoder.pos(&value) == 8 && value.buf.*.items[0] == 72 && value.buf.*.items[1] == 3 && value.buf.*.items[2] == 69 && value.buf.*.items[3] == 232 && value.buf.*.items[4] == 72 && value.buf.*.items[5] == 59
    encoder.deinit(&value)
    return valid
}

fn optimizerMarksSingleNextUse(allocator: page_allocator.Allocator) -> bool {
    var ir = lir.init(allocator)
    const value = lir.addInst(&ir, lir.constI(lir.NONE, 13))
    const returned = lir.addInst(&ir, lir.retInst(lir.NONE, value))
    const result = optimize.run(&ir, allocator)
    const retained = lir.getInst(&ir, value).flags & lir.FLAG_RETAIN_NEXT != 0 && lir.getInst(&ir, returned).arg0 == value
    lir.deinit(&ir)
    return retained
}

pub fn main() -> u8 {
    const allocator: page_allocator.Allocator = page_allocator.init()
    if !optimizerFusesComparison(allocator) { return 1 }
    if !encoderUsesMemoryOperands(allocator) { return 2 }
    if !optimizerMarksSingleNextUse(allocator) { return 3 }
    return 13
}
