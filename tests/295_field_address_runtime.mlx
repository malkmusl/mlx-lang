// The address of a field is a pointer that can be written through: &x.f
// of a var, &p.*.f through a pointer, of a nested field, of an element of
// an array field, and of a local, each passed to a function taking *T and
// bound to a result (the compiler once made every such address a *const
// T, so only the address of a plain var could be passed). Exits 13.
const Inner = struct {
    on: bool
}

const State = struct {
    on: bool
    count: u32
    inner: Inner
    values: [4]u32
}

fn flip(on: *bool) -> bool {
    on.* = !on.*
    return true
}

fn bump(count: *u32) -> u32 {
    count.* += 1
    return count.*
}

fn stateOf(state: *State) -> *State { return state }

pub fn main() -> u8 {
    var state = State.{ .on = false, .count = 0, .inner = Inner.{ .on = false }, .values = [4]u32{ 1, 2, 3, 4 } }
    // A field of a var.
    const a = flip(&state.on)
    if !a || !state.on { return 1 }
    // A field through a pointer.
    const pointer = stateOf(&state)
    const b = bump(&pointer.*.count)
    if b != 1 || state.count != 1 { return 2 }
    // The result dropped.
    _ = bump(&pointer.*.count)
    if state.count != 2 { return 3 }
    // A nested field, an element of an array field.
    const c = flip(&state.inner.on)
    if !c || !state.inner.on { return 4 }
    const d = bump(&state.values[2])
    if d != 4 || state.values[2] != 4 { return 5 }
    const e = bump(&pointer.*.values[0])
    if e != 2 || state.values[0] != 2 { return 6 }
    // A local, and the address kept in a const.
    var flag = false
    const f = flip(&flag)
    if !f || !flag { return 7 }
    const count = &pointer.*.count
    const g = bump(count)
    if g != 3 || state.count != 3 { return 8 }
    // In a condition, as before.
    if flip(&pointer.*.inner.on) {
        if state.inner.on { return 9 }
    }
    return 13
}
