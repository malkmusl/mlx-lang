const diagnostic = @import("../compiler/selfhost/diagnostic.zin")

pub fn main() -> u8 {
    const value = diagnostic.create(
        diagnostic.Code.unexpected_byte,
        diagnostic.Phase.lexer,
        diagnostic.Severity.failure,
        2,
        7,
        8,
        "unexpected byte",
    )
    if value.fileId != 2 || value.byteStart != 7 || value.byteEnd != 8 || value.messageLength != 15 {
        return 1
    }
    if !diagnostic.render(value) { return 2 }
    return 13
}
