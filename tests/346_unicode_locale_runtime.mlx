// std.unicode's locale parts through their native API, over cldr.dat
// ($MLX_UNICODE_DATA, or mlx-out/share/mlx-unicode/cldr.dat beside the
// program's directory; `./mlx build unicode` makes it): locale IDs and
// BCP 47 tags, likely subtags, display names, a moment's fields in a
// calendar and a zone, numbers by skeletons, plural categories, dates by
// skeletons and patterns, lists and relative times; and the zones of
// std.timezone.database by name. Exits 13.
const std = @import("std")
const unicode = @import("std.unicode")
const utf = @import("std.unicode.utf")
const locale = @import("std.unicode.locale")
const displaynames = @import("std.unicode.locale.displaynames")
const calendar = @import("std.unicode.calendar")
const number = @import("std.unicode.format.number")
const plural = @import("std.unicode.format.plural")
const date = @import("std.unicode.format.date")
const list = @import("std.unicode.format.list")
const reltime = @import("std.unicode.format.reltime")
const database = @import("std.timezone.database")

fn same(allocator: utf.Allocator, made: []const u8, expected: []const u8) -> bool {
    const equal = std.text.same(made, expected)
    utf.free8(allocator, made)
    return equal
}

// 2023-11-14 22:13:20 UTC.
const MOMENT: f64 = 1700000000000.0

fn run() -> !u8 {
    const allocator = std.page_allocator.init()
    if !same(allocator, try locale.canonical(allocator, "en-us"), "en_US") { return 1 }
    if !same(allocator, try locale.toLanguageTag(allocator, "de_DE@collation=phonebook"), "de-DE-u-co-phonebk") { return 1 }
    if !same(allocator, try locale.fromLanguageTag(allocator, "sr-Latn-RS"), "sr_Latn_RS") { return 1 }
    if !same(allocator, try locale.maximize(allocator, "zh_TW"), "zh_Hant_TW") { return 1 }
    if !same(allocator, try locale.minimize(allocator, "en_Latn_US"), "en") { return 1 }
    if !same(allocator, try displaynames.languageName(allocator, "fr", "de"), "allemand") { return 2 }
    if !same(allocator, try displaynames.regionName(allocator, "en", "419"), "Latin America") { return 2 }

    const berlin = try calendar.fieldsAt("de_DE", "Europe/Berlin", MOMENT)
    if berlin.year != 2023 || berlin.month != 11 || berlin.day != 14 || berlin.hour != 23 || berlin.minute != 13 || berlin.weekday != 3 || berlin.zoneOffset != 3600000 { return 3 }
    const thai = try calendar.fieldsAt("th_TH", "Asia/Bangkok", MOMENT)
    if thai.year != 2566 || thai.day != 15 { return 3 }
    if !same(allocator, try calendar.calendarType(allocator, "ja_JP@calendar=japanese"), "japanese") { return 3 }

    if !same(allocator, try number.formatNumber(allocator, "de", "currency/EUR", 1234.5), "1.234,50\u{a0}€") { return 4 }
    if !same(allocator, try number.formatNumber(allocator, "en", "percent scale/100", 0.25), "25%") { return 4 }
    if !same(allocator, try number.formatNumber(allocator, "en", "compact-short", 1500000.0), "1.5M") { return 4 }
    var formatter = try number.openFormatter(allocator, "hi", "")
    if !same(allocator, try number.formatInteger(allocator, &formatter, 12345678), "1,23,45,678") { return 4 }
    number.closeFormatter(&formatter)
    if (try plural.category("ru", 3.0, false)) != plural.Category.few { return 5 }
    if (try plural.category("en", 3.0, true)) != plural.Category.few { return 5 }

    if !same(allocator, try date.formatSkeleton(allocator, "en_US", "yMMMMd", "UTC", MOMENT), "November 14, 2023") { return 6 }
    if !same(allocator, try date.formatSkeleton(allocator, "de", "yMMMMdHHmm", "Europe/Berlin", MOMENT), "14. November 2023 um 23:13") { return 6 }
    if !same(allocator, try date.formatPattern(allocator, "fr", "EEEE d MMMM", "UTC", MOMENT), "mardi 14 novembre") { return 6 }

    const fruit = [3][]const u8{ "Äpfel", "Birnen", "Pflaumen" }
    if !same(allocator, try list.joinList(allocator, "de", fruit[0..3], list.ListKind.conjunction, list.ListWidth.wide), "Äpfel, Birnen und Pflaumen") { return 7 }
    if !same(allocator, try list.joinList(allocator, "en", fruit[0..2], list.ListKind.disjunction, list.ListWidth.wide), "Äpfel or Birnen") { return 7 }
    if !same(allocator, try reltime.formatRelative(allocator, "en", 1.0, reltime.RelativeUnit.day, false), "tomorrow") { return 8 }
    if !same(allocator, try reltime.formatRelative(allocator, "es", -2.0, reltime.RelativeUnit.hour, true), "hace 2 horas") { return 8 }

    if database.lookup("Mars/Olympus") != null || database.lookup("US/Pacific") == null { return 9 }
    if database.offsetOf("Asia/Kolkata", 1700000000).? != 19800 { return 9 }
    if database.offsetOf("America/New_York", 1690000000).? != -14400 { return 9 }
    if database.lookupSetting(":/usr/share/zoneinfo/Europe/Paris") == null { return 9 }
    return 13
}

pub fn main() -> !void {
    const code = try run()
    _ = std.linux.syscall1(231, @intCast(usize, code))
}
