// Float literals meeting an f32: bindings, assignments, parameters (direct
// and through a function pointer), returns, fields and the other operand of
// arithmetic and comparisons all get the f32 value, not the low half of the
// f64 literal. Exits 13.
const Scale = fn(usize, f32, i32) -> i32

const Rate = struct {
    hertz: f32,
    count: u32,
}

fn whole(value: f32) -> i32 {
    const result: i32 = @intFromFloat(i32, value)
    return result
}

fn scaled(base: usize, value: f32, offset: i32) -> i32 {
    const result: i32 = @intFromFloat(i32, value)
    return result + offset + @intCast(i32, base)
}

fn half() -> f32 {
    return 0.5
}

fn bits(value: f32) -> u32 {
    return @bitCast(u32, value)
}

pub fn main() -> u8 {
    // 120.0 as f32 is 0x42F00000.
    const rate: f32 = 120.0
    if @bitCast(u32, rate) != 1123024896 { return 1 }
    if bits(120.0) != 1123024896 { return 2 }
    if whole(120.0) != 120 || whole(rate) != 120 { return 3 }
    if scaled(1, 120.0, 2) != 123 { return 4 }
    var call: Scale = undefined
    unsafe { call = @ptrFromInt(Scale, @intFromPtr(scaled)) }
    if call(0, 60.0, 0) != 60 { return 5 }
    if bits(half()) != 1056964608 { return 6 }

    var current: f32 = 1.0
    current = 90.0
    if whole(current) != 90 { return 7 }
    current += 30.0
    if whole(current) != 120 { return 8 }

    const setting = Rate.{ .hertz = 60.0, .count = 2 }
    if whole(setting.hertz) != 60 || setting.count != 2 { return 9 }

    if rate != 120.0 || rate < 119.5 || !(rate > 90.0) { return 10 }
    if whole(rate * 0.5) != 60 || whole(2.0 * rate) != 240 { return 11 }

    // f64 stays f64.
    const wide: f64 = 120.0
    if @bitCast(u64, wide) != 4638144666238189568 { return 12 }
    return 13
}
