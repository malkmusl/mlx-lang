// Narrow integers (u8, i8, u16, i16, u32) hold canonical values in their
// registers after a left shift (the bits shifted out are lost, the sign
// extended), a complement, and a narrowing or sign-changing @intCast:
// comparisons and widenings see the value the type names, not the high
// bits of the 64-bit operation. Exits 13 when every check holds, else the
// number of the first check that failed.
var eight: u8 = 0x81 // (per run)
var sixteen: u16 = 0x8001 // (per run)
var one: u8 = 1 // (per run)
var s: i8 = -3 // (per run)
var wide: usize = 0x1FF // (per run)
var neg: isize = -1 // (per run)
var a: u8 = 250 // (per run)
var b: u8 = 10 // (per run)

pub fn main() -> u8 {
    const shifted: u8 = eight << one
    if shifted != 2 { return 1 }
    const inverted: u8 = ~eight
    if inverted != 0x7E { return 2 }
    const shifted16: u16 = sixteen << one
    if shifted16 != 2 { return 3 }
    if @intCast(usize, shifted) + @intCast(usize, inverted) != 128 { return 4 }
    var x: u8 = eight
    x <<= one
    if x != 2 { return 5 }
    var y: u16 = sixteen
    y <<= 1
    if y != 2 { return 6 }
    const sh: i8 = s << one
    if sh != -6 { return 7 }
    const big: i8 = @intCast(i8, 0x40) << one
    if big != -128 { return 8 }
    const inv: i8 = ~s
    if inv != 2 { return 9 }
    const cut: u8 = @intCast(u8, wide)
    if cut != 0xFF { return 10 }
    const cut16: i16 = @intCast(i16, wide)
    if cut16 != 511 { return 11 }
    const un: u32 = @intCast(u32, neg)
    if un != 0xFFFFFFFF { return 12 }
    const back: i8 = @intCast(i8, un)
    if back != -1 { return 14 }
    const widened: i64 = @intCast(i64, back)
    if widened != -1 { return 15 }
    if @intCast(u64, @intCast(u32, neg)) != 0xFFFFFFFF { return 16 }
    const added: u8 = a +% b
    if added != 4 { return 17 }
    const multiplied: u8 = a *% b
    if multiplied != 196 { return 18 }
    const combined: u8 = eight &<< one
    if combined != 0 { return 19 }
    return 13
}
