// continue and break both run automatic cleanups for the exited body scope.
const OwnedCounter = @noncopy(struct) {
    counter: *u8

    fn deinit(self: *Self) -> void {
        self.*.counter.* += 1
    }
}

fn main() -> u8 {
    var drops: u8 = 0
    var index: u8 = 0
    while index < 3 {
        const iteration = OwnedCounter.{ .counter = &drops }
        index += 1
        if index == 1 { continue }
        if index == 2 { break }
    }
    return drops
}
