const std = @import("std")
const apps = @import("../projects/desktop/shared/apps.mlx")
const places = @import("../projects/desktop/shared/places.mlx")

const ROOT = "/tmp/mlx-files-trash-regression"
const DATA = "/tmp/mlx-files-trash-regression/data"
const TRASH = "/tmp/mlx-files-trash-regression/data/Trash"
const TRASH_FILES = "/tmp/mlx-files-trash-regression/data/Trash/files"
const TRASH_INFO = "/tmp/mlx-files-trash-regression/data/Trash/info"

fn removeDirectory(text: []const u8) -> void {
    var path: apps.Path = undefined
    apps.pathClear(&path)
    apps.pathAdd(&path, text)
    const removed = std.fs.removeDir(apps.pathEnd(&path))
}

fn isDirectory(text: []const u8) -> bool {
    var path: apps.Path = undefined
    apps.pathClear(&path)
    apps.pathAdd(&path, text)
    var status: std.fs.Stat = undefined
    if std.fs.status(apps.pathEnd(&path), &status) != 0 { return false }
    return status.mode & 61440 == 16384
}

pub fn main(arguments: [][*]const u8) -> u8 {
    // Keep the fixture repeatable when a previous run stopped early.
    removeDirectory(TRASH_FILES)
    removeDirectory(TRASH_INFO)
    removeDirectory(TRASH)
    removeDirectory(DATA)
    removeDirectory(ROOT)

    var environment: [3][*]const u8 = undefined
    unsafe {
        environment[0] = @ptrCast([*]const u8, "HOME=/tmp/mlx-files-trash-regression/home")
        environment[1] = @ptrCast([*]const u8, "XDG_DATA_HOME=/tmp/mlx-files-trash-regression/data")
        environment[2] = @ptrFromInt([*]const u8, 0)
    }
    var pointer: [*][*]const u8 = undefined
    unsafe { pointer = @ptrCast([*][*]const u8, &environment) }

    var files: apps.Path = undefined
    if !places.ensureTrash(pointer, &files) { return 1 }
    if !isDirectory(DATA) { return 2 }
    if !isDirectory(TRASH) { return 3 }
    if !isDirectory(TRASH_FILES) { return 4 }
    if !isDirectory(TRASH_INFO) { return 5 }
    if !isDirectory(apps.pathEnd(&files)[0..files.length]) { return 6 }

    removeDirectory(TRASH_FILES)
    removeDirectory(TRASH_INFO)
    removeDirectory(TRASH)
    removeDirectory(DATA)
    removeDirectory(ROOT)
    return 13
}
