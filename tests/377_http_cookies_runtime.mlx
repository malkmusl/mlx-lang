// std.http.cookie and std.http.cookiejar: Set-Cookie values read with
// libsoup's rules (domains, default paths, Max-Age and Expires, SameSite),
// written back, matched against hosts and paths; a jar fed what
// mlx-soup's cookies.c feeds one, giving the headers libsoup gives
// (order, HttpOnly, Secure, the prefixes, expiry, third parties), the
// "changed" notices, and the cookies.txt lines. Exits 13 when every check
// holds, else the number of the first check that failed.
const std = @import("std")
const cookie = @import("std.http.cookie")
const jar_module = @import("std.http.cookiejar")
const headers = @import("std.http.headers")

const NOW: i64 = 1800000000

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

const Written = struct {
    bytes: [4096]u8
    length: usize
}

fn append(context: usize, bytes: []const u8) -> void {
    const w: *Written = unsafe { @ptrFromInt(*Written, context) }
    var index: usize = 0
    while index < bytes.length {
        if w.*.length < 4096 {
            w.*.bytes[w.*.length] = bytes[index]
            w.*.length += 1
        }
        index += 1
    }
}

fn sinkOf(w: *Written) -> headers.Sink {
    w.*.length = 0
    return headers.Sink.{ .context = @intFromPtr(w), .write = append }
}

fn written(w: *Written) -> []const u8 { return w.*.bytes[0..w.*.length] }

// The "changed" notices, as cookies.c prints them: "old -> new" names.
var notices: Written = undefined

fn noteChange(context: usize, old: ?*const cookie.Cookie, new: ?*const cookie.Cookie) -> void {
    append(@intFromPtr(&notices), if old != null { old.?.*.name } else { "(none)" })
    append(@intFromPtr(&notices), " -> ")
    append(@intFromPtr(&notices), if new != null { new.?.*.name } else { "(none)" })
    append(@intFromPtr(&notices), "\n")
}

fn origin(host: []const u8, path: []const u8, https: bool) -> jar_module.Origin { return jar_module.Origin.{ .host = host, .path = path, .https = https } }

fn request(host: []const u8, path: []const u8, https: bool, forHttp: bool) -> jar_module.Request {
    return jar_module.Request.{ .host = host, .path = path, .https = https, .forHttp = forHttp, .safeMethod = true, .topLevelNavigation = false, .hasTopLevel = false, .topLevelHost = "", .hasSiteForCookies = false, .siteForCookiesHost = "" }
}

fn header(jar: *jar_module.Jar, host: []const u8, path: []const u8, https: bool, forHttp: bool, w: *Written) -> []const u8 {
    var found: jar_module.Found = undefined
    const r = request(host, path, https, forHttp)
    jar_module.cookiesFor(jar, &r, NOW, &found)
    jar_module.writeCookieHeader(sinkOf(w), &found)
    jar_module.freeFound(jar, &found)
    return written(w)
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var w: Written = undefined

    // Matching.
    if !cookie.hostMatches(".example.com", "www.example.com") || !cookie.hostMatches(".example.com", "example.com") || cookie.hostMatches(".example.com", "notexample.com") { return 1 }
    if !cookie.pathMatches("/a", "/a/b") || cookie.pathMatches("/a", "/ab") || !cookie.pathMatches("/a/", "/a/b") || !cookie.pathMatches("", "/x") { return 2 }
    if !same(cookie.defaultPath("/a/b"), "/a") || !same(cookie.defaultPath("/c"), "/") || !same(cookie.defaultPath(""), "/") { return 3 }
    if !cookie.isIpAddress("192.168.1.1") || cookie.isIpAddress("192.168.1") || cookie.isIpAddress("256.1.1.1") || !cookie.isIpAddress("::1") || cookie.isIpAddress("example.com") { return 4 }

    // Set-Cookie values read.
    var c: cookie.Cookie = undefined
    if !cookie.parseSetCookie(allocator, "id=7; Path=/x; Max-Age=60; Secure; HttpOnly; SameSite=Strict", true, "www.example.com", "/a/b", NOW, &c) { return 5 }
    if !same(c.name, "id") || !same(c.value, "7") || !same(c.domain, "www.example.com") || !same(c.path, "/x") || !c.hasExpires || c.expires != NOW + 60 || !c.secure || !c.httpOnly || c.sameSite != cookie.SameSite.strict { return 6 }
    cookie.writeSetCookie(sinkOf(&w), &c)
    if !same(written(&w), "id=7; expires=Fri, 15-Jan-2027 08:01:00 GMT; path=/x; domain=www.example.com; SameSite=Strict; secure; HttpOnly") { return 7 }
    cookie.writeCookieHeader(sinkOf(&w), &c)
    if !same(written(&w), "id=7") { return 8 }
    cookie.cookieFree(allocator, &c)
    // A domain gets its dot; the path defaults to the request's directory;
    // an Expires in the past; a value without a name.
    if !cookie.parseSetCookie(allocator, "a=1; Domain=example.com; Expires=Thu, 01 Jan 1970 00:00:00 GMT", true, "www.example.com", "/a/b", NOW, &c) { return 9 }
    if !same(c.domain, ".example.com") || !same(c.path, "/a") || !c.hasExpires || c.expires != 0 || c.sameSite != cookie.SameSite.lax { return 10 }
    cookie.cookieFree(allocator, &c)
    if cookie.parseSetCookie(allocator, "a=1; Domain=com", true, "www.example.com", "/", NOW, &c) { return 11 }
    if cookie.parseSetCookie(allocator, "a=1; Domain=other.org", true, "www.example.com", "/", NOW, &c) { return 12 }
    if !cookie.parseSetCookie(allocator, "justvalue", true, "h", "/", NOW, &c) || !same(c.name, "") || !same(c.value, "justvalue") { return 14 }
    cookie.writeCookieHeader(sinkOf(&w), &c)
    if !same(written(&w), "justvalue") { return 15 }
    cookie.cookieFree(allocator, &c)
    if !cookie.parseSetCookie(allocator, "a=1; Max-Age=-5", false, "", "", NOW, &c) || !c.hasExpires || c.expires != 0 || !same(c.path, "/") { return 16 }
    cookie.cookieFree(allocator, &c)

    // The jar, fed what cookies.c feeds one.
    var jar: jar_module.Jar = undefined
    jar_module.init(&jar, allocator)
    notices.length = 0
    jar_module.onChanged(&jar, noteChange, 0)
    const www = origin("www.example.com", "/a/b", false)
    const root = origin("www.example.com", "/", false)
    const secure = origin("www.example.com", "/", true)
    jar_module.setCookie(&jar, "one=1", &www, false, "", NOW)
    jar_module.setCookie(&jar, "two=2; Path=/", &www, false, "", NOW)
    jar_module.setCookie(&jar, "three=3; Path=/a/b/c", &www, false, "", NOW)
    jar_module.setCookie(&jar, "dom=d; Domain=example.com", &root, false, "", NOW)
    jar_module.setCookie(&jar, "http=h; HttpOnly", &root, false, "", NOW)
    jar_module.setCookie(&jar, "sec=s; Secure", &root, false, "", NOW)
    jar_module.setCookie(&jar, "sec=s; Secure; Path=/", &secure, false, "", NOW)
    jar_module.setCookie(&jar, "__Secure-a=1", &secure, false, "", NOW)
    jar_module.setCookie(&jar, "__Secure-b=1; Secure", &secure, false, "", NOW)
    jar_module.setCookie(&jar, "__Host-a=1; Secure; Path=/; Domain=example.com", &secure, false, "", NOW)
    jar_module.setCookie(&jar, "__Host-b=1; Secure; Path=/", &secure, false, "", NOW)
    jar_module.setCookie(&jar, "none=n; SameSite=None", &root, false, "", NOW)
    jar_module.setCookie(&jar, "lax=l; SameSite=Lax; Secure", &secure, false, "", NOW)
    jar_module.setCookie(&jar, "public=p; Domain=com", &root, false, "", NOW)
    jar_module.setCookie(&jar, "other=o; Domain=other.com", &root, false, "", NOW)
    jar_module.setCookie(&jar, "gone=g; Max-Age=0", &root, false, "", NOW)
    jar_module.setCookie(&jar, "two=22; Path=/", &root, false, "", NOW)
    jar_module.setCookie(&jar, "ctl=a\x01b", &root, false, "", NOW)
    if !same(written(&notices), "(none) -> one\n(none) -> two\n(none) -> three\n(none) -> dom\n(none) -> http\n(none) -> sec\n(none) -> __Secure-b\n(none) -> __Host-b\n(none) -> lax\ntwo -> two\n") { return 17 }
    if !same(header(&jar, "www.example.com", "/a/b/c", false, true, &w), "three=3; one=1; dom=d; http=h; two=22") { return 18 }
    if !same(header(&jar, "www.example.com", "/a/b", false, true, &w), "one=1; dom=d; http=h; two=22") { return 19 }
    if !same(header(&jar, "www.example.com", "/", true, true, &w), "dom=d; http=h; sec=s; __Secure-b=1; __Host-b=1; lax=l; two=22") { return 20 }
    if !same(header(&jar, "www.example.com", "/", true, false, &w), "dom=d; sec=s; __Secure-b=1; __Host-b=1; lax=l; two=22") { return 21 }
    if !same(header(&jar, "example.com", "/", false, true, &w), "dom=d") { return 22 }
    if !same(header(&jar, "sub.www.example.com", "/", false, true, &w), "dom=d") { return 23 }
    if !same(header(&jar, "other.org", "/", false, true, &w), "") { return 24 }
    if jar_module.count(&jar) != 9 { return 25 }

    // Expiring a cookie by setting it again in the past; deleting.
    notices.length = 0
    jar_module.setCookie(&jar, "one=x; Expires=Thu, 01 Jan 1970 00:00:00 GMT", &www, false, "", NOW)
    if !same(written(&notices), "one -> (none)\n") { return 26 }
    if !same(header(&jar, "www.example.com", "/a/b", false, true, &w), "dom=d; http=h; two=22") { return 27 }
    const dom = cookie.view("dom", "d", ".example.com", true, "/", true)
    notices.length = 0
    jar_module.deleteCookie(&jar, &dom)
    if !same(written(&notices), "dom -> (none)\n") { return 28 }
    if !same(header(&jar, "www.example.com", "/", false, true, &w), "http=h; two=22") { return 29 }

    // Third parties.
    jar.policy = jar_module.Policy.noThirdParty
    const tracker = origin("tracker.net", "/", false)
    const img = origin("img.example.com", "/", false)
    jar_module.setCookie(&jar, "track=1", &tracker, true, "www.example.com", NOW)
    jar_module.setCookie(&jar, "img=1", &img, true, "www.example.com", NOW)
    if !same(header(&jar, "tracker.net", "/", false, true, &w), "") { return 30 }
    if !same(header(&jar, "img.example.com", "/", false, true, &w), "img=1") { return 31 }
    jar.policy = jar_module.Policy.grandfatheredThirdParty
    jar_module.setCookie(&jar, "grand=1", &img, true, "elsewhere.org", NOW)
    if !same(header(&jar, "img.example.com", "/", false, true, &w), "img=1; grand=1") { return 32 }
    jar.policy = jar_module.Policy.never
    jar_module.setCookie(&jar, "no=1", &img, true, "img.example.com", NOW)
    if !same(header(&jar, "img.example.com", "/", false, true, &w), "img=1; grand=1") { return 33 }
    if !same(jar_module.baseDomain("www.example.co.uk"), "example.co.uk") || !same(jar_module.baseDomain("co.uk"), "co.uk") || !same(jar_module.baseDomain("192.168.1.1"), "192.168.1.1") { return 34 }

    // SameSite with a top-level site.
    var strict = request("www.example.com", "/", true, true)
    strict.hasTopLevel = true
    strict.topLevelHost = "other.org"
    var found: jar_module.Found = undefined
    jar_module.cookiesFor(&jar, &strict, NOW, &found)
    jar_module.writeCookieHeader(sinkOf(&w), &found)
    jar_module.freeFound(&jar, &found)
    // (lax is Lax and the request is not a top-level navigation: left out;
    // http and two are Lax too; sec and the prefixed ones as well.)
    if !same(written(&w), "") { return 35 }
    strict.topLevelNavigation = true
    jar_module.cookiesFor(&jar, &strict, NOW, &found)
    jar_module.writeCookieHeader(sinkOf(&w), &found)
    jar_module.freeFound(&jar, &found)
    if !same(written(&w), "http=h; sec=s; __Secure-b=1; __Host-b=1; lax=l; two=22") { return 36 }
    jar_module.deinit(&jar)

    // A text jar's file.
    var text: jar_module.Jar = undefined
    jar_module.init(&text, allocator)
    jar_module.setCookie(&text, "keep=1; Max-Age=3600", &root, false, "", NOW)
    jar_module.setCookie(&text, "session=1", &root, false, "", NOW)
    jar_module.setCookie(&text, "secure=1; Max-Age=3600; Secure; HttpOnly; SameSite=Strict", &secure, false, "", NOW)
    jar_module.setCookie(&text, "keep=2; Max-Age=3600", &root, false, "", NOW)
    jar_module.writeText(sinkOf(&w), &text)
    const file = "# HTTP Cookie File\n# http://www.netscape.com/newsref/std/cookie_spec.html\n# This is a generated file!  Do not edit.\n# To delete cookies, use the Cookie Manager.\n\nwww.example.com\tFALSE\t/\tFALSE\t1800003600\tkeep\t2\tLax\n#HttpOnly_www.example.com\tFALSE\t/\tTRUE\t1800003600\tsecure\t1\tStrict\n"
    if !same(written(&w), file) { return 37 }
    jar_module.deinit(&text)
    // Read again (the session cookie is not there), and one line taken out.
    jar_module.init(&text, allocator)
    jar_module.loadText(&text, file, NOW + 10)
    if jar_module.count(&text) != 2 { return 38 }
    if !same(header(&text, "www.example.com", "/", true, true, &w), "keep=2; secure=1") { return 39 }
    const keep = cookie.view("keep", "2", "www.example.com", true, "/", true)
    jar_module.rewriteText(sinkOf(&w), file, true, &keep, null, NOW)
    if !same(written(&w), "#HttpOnly_www.example.com\tFALSE\t/\tTRUE\t1800003600\tsecure\t1\tStrict\n") { return 40 }
    var fresh = cookie.view("new", "n", "h", true, "/", true)
    fresh.hasExpires = true
    fresh.expires = 5
    jar_module.rewriteText(sinkOf(&w), "", false, null, &fresh, NOW)
    if !same(written(&w), "# HTTP Cookie File\n# http://www.netscape.com/newsref/std/cookie_spec.html\n# This is a generated file!  Do not edit.\n# To delete cookies, use the Cookie Manager.\n\nh\tFALSE\t/\tFALSE\t5\tnew\tn\tLax\n") { return 41 }
    jar_module.deinit(&text)
    return 13
}
