const lexer = @import("../compiler/selfhost/lexer.zin")
const parser_module = @import("../compiler/selfhost/parser.zin")
const types = @import("../compiler/selfhost/types.zin")
const symbols = @import("../compiler/selfhost/symbols.zin")
const sema = @import("../compiler/selfhost/sema.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")

pub fn main() -> u8 {
    const source = "const Pair = struct {\nleft: u8\nright: u16\n}\nconst number: u8 = 13\nconst inferred = 42\nfn pair(a: u8, b: u16) -> (u8, u16) { return -> (a, b) }\nfn use() -> u8 { return number }\n"
    const allocator = page_allocator.init()
    const tokens = lexer.scanAll(allocator, source)
    var nodes = parser_module.initStore(allocator, tokens.length * 2)
    var parser = parser_module.init(source, tokens, &nodes)
    const root = parser_module.parse(&parser)
    if parser.errorCount != 0 { return 1 }

    var type_store = types.init(allocator)
    var symbol_store = symbols.initStore(allocator, 8)
    var root_scope = symbols.initRootScope(allocator, 8)
    if symbols.collectRoot(source, tokens, &nodes, root, &symbol_store, &root_scope) != 0 { return 2 }
    if sema.analyzeDeclarations(source, tokens, &nodes, root, &type_store, &symbol_store, &root_scope) != 0 { return 3 }
    if symbol_store.length != 5 { return 4 }

    const pair_type = symbols.symbolAt(&symbol_store, 0)
    if types.get(&type_store, pair_type.*.typeId).*.kind != types.Kind.type_type { return 5 }
    if types.get(&type_store, pair_type.*.valueTypeId).*.kind != types.Kind.struct_type { return 6 }

    const number = symbols.symbolAt(&symbol_store, 1)
    if types.get(&type_store, number.*.typeId).*.kind != types.Kind.integer || types.get(&type_store, number.*.typeId).*.bits != 8 { return 7 }
    const inferred = symbols.symbolAt(&symbol_store, 2)
    if types.get(&type_store, inferred.*.typeId).*.kind != types.Kind.comptime_int_type { return 8 }

    const pair_function = types.get(&type_store, symbols.symbolAt(&symbol_store, 3).*.typeId)
    if pair_function.*.kind != types.Kind.function || pair_function.*.extraLength != 2 { return 9 }
    const result = types.get(&type_store, pair_function.*.lhs)
    if result.*.kind != types.Kind.tuple || result.*.extraLength != 2 { return 10 }
    const use_function = types.get(&type_store, symbols.symbolAt(&symbol_store, 4).*.typeId)
    if use_function.*.kind != types.Kind.function || types.get(&type_store, use_function.*.lhs).*.bits != 8 { return 11 }

    symbols.deinitScope(&root_scope)
    symbols.deinitStore(&symbol_store)
    types.deinit(&type_store)
    parser_module.deinitStore(&nodes)
    lexer.deinit(tokens)
    return 13
}
