// Our Vulkan driver's stage (a) (projects/brix/vulkan/driver.mlx) over the
// host's card (card_host.mlx), built for the host, held against what the
// Vulkan registry in the repository (std/registry/vulkan/vk.xml, read here
// whole) requires of each entry point:
// - the loader/driver interface: the versions negotiated; the driver
//   offered to std.vulkan.loader and found by its native path first, by
//   the name "builtin:brix-radeon", only while it has a card; opened by
//   its entry points; nothing found without a card;
// - which commands answer: every command of the registry asked of
//   vkGetInstanceProcAddr with a null instance, with an instance, of
//   vk_icdGetPhysicalDeviceProcAddr and of vkGetDeviceProcAddr: exactly
//   the global commands without an instance; with one, every instance-level
//   command of Vulkan 1.0 and 1.1 (the instance's version) and the device's
//   three (vkGetDeviceProcAddr, vkDestroyDevice, vkGetDeviceQueue) and no
//   other (no extension's name either); the device's three alone through
//   the device; the physical device's commands through their own entry;
// - the result codes: every code a command returned in all of this is one
//   the registry gives that command (its successcodes or errorcodes);
// - the two-call pattern of every command that has one: the count alone,
//   a short array (VK_INCOMPLETE where the command returns a result, the
//   count cut), an array larger than needed, nothing written beyond;
// - the structures: the structure types the driver reads and writes are
//   the registry's numbers; the properties (the user's RX 580: its name,
//   ids, version 1.0, the limits' sample counts), the driver's record
//   chained to vkGetPhysicalDeviceProperties2 (its stage in the
//   information string) and a chained structure it does not know left as
//   it was; every feature false, and the registry's one required feature
//   of Vulkan 1.0 (robustBufferAccess) the one gap the driver states; the
//   memory (heaps and types within the registry's maximum counts, each
//   type on a heap, a device-local heap, a host-visible coherent type,
//   the order the types must have); the one queue family; no format
//   feature, no image format, no sparse format, no external handle; each
//   physical device a group of its own;
// - vkCreateInstance (a wrong structure, a layer, an extension refused; a
//   version above the instance's taken, as an instance of 1.1 must);
//   vkCreateDevice refused with VK_ERROR_INITIALIZATION_FAILED while the
//   card's record lists no compute ring, and no context opened; on a card
//   that lists one, a context on the card held by the device and given
//   back with it, the queue (the loader's word at its start, the same
//   each time, none of another family or index); a feature, an extension,
//   another family refused; every context taken: VK_ERROR_TOO_MANY_OBJECTS;
// - std.gpu's open over the driver: the device is found (its name), and
//   refused on a card without a compute ring; on one with a ring std.gpu
//   says the driver lacks commands it uses, and calls none of them;
// - a card the driver does not serve (a Polaris 11) is not listed.
// With an argument, each failing check is printed.
// Exits 13.
const std = @import("std")
const vk = @import("std.vulkan")
const icd = @import("std.vulkan.icd")
const loader = @import("std.vulkan.loader")
const registry = @import("std.vulkan.registry")
const xml = @import("std.xml")
const gpu = @import("std.gpu")
const gpucard = @import("std.gpucard")
const record = @import("../projects/brix/kernel/gpu_record.mlx")
const host = @import("../projects/brix/vulkan/card_host.mlx")
const driver = @import("../projects/brix/vulkan/driver.mlx")
const listing = @import("../projects/brix/tools/vkinfo/listing.mlx")

const String = std.string.String

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }
fn sayNumber(value: u64) -> void { _ = std.io.writeUnsigned(std.io.stdout(), @intCast(usize, value)) }

var failed: u8 = 0
var show = false

fn check(number: u8, holds: bool) -> void {
    if holds { return }
    if failed == 0 { failed = number }
    if show {
        say("check ")
        sayNumber(@intCast(u64, number))
        say(" fails\n")
    }
}

fn equal(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

fn text(value: String) -> []const u8 { return value.pointer[0..value.length] }

// Where `needle` is in `hay` (hay.length: nowhere).
fn find(hay: []const u8, needle: []const u8) -> usize {
    var at: usize = 0
    while at + needle.length <= hay.length {
        if equal(hay[at..at + needle.length], needle) { return at }
        at += 1
    }
    return hay.length
}

// The C string's bytes.
fn cText(bytes: [*]const u8) -> []const u8 {
    var length: usize = 0
    while bytes[length] != 0 { length += 1 }
    return bytes[0..length]
}

// ---------------------------------------------------------------------------
// The registry, read

const MOST_COMMANDS: usize = 2400

const Command = struct {
    name: []const u8
    // An alias's command (empty: none).
    alias: []const u8
    // For the API "vulkan" (not vulkansc alone).
    vulkan: bool
    returnsResult: bool
    firstParam: []const u8
    successCodes: []const u8
    errorCodes: []const u8
    // The core version that requires it: 0 for 1.0, 1 for 1.1, 9 none of
    // these.
    version: usize
}

var commands: [MOST_COMMANDS]Command = undefined
var commandCount: usize = 0
var source: [*]const u8 = undefined
var sourceLength: usize = 0
// The features VK_VERSION_1_0 requires: "struct.name" each.
var required10: [8][]const u8 = undefined
var required10Count: usize = 0

fn findCommand(name: []const u8) -> usize {
    var k: usize = 0
    while k < commandCount {
        if equal(commands[k].name, name) { return k }
        k += 1
    }
    return commandCount
}

fn hasApi(api: []const u8, wanted: []const u8) -> bool {
    if api.length == 0 { return true }
    var start: usize = 0
    var k: usize = 0
    while k <= api.length {
        if k == api.length || api[k] == 44 {
            if equal(api[start..k], wanted) { return true }
            start = k + 1
        }
        k += 1
    }
    return false
}

// The whole of an element's content skipped (after its start tag's
// attributes).
fn skip(tokenizer: *xml.Tokenizer, token: *xml.Token) -> void {
    var depth: usize = 1
    while depth > 0 && xml.next(tokenizer, token) {
        if token.*.kind == xml.TokenKind.elementStart { depth += 1 }
        if token.*.kind == xml.TokenKind.elementEnd { depth -= 1 }
    }
}

// A <command> element's attributes and content.
fn readCommand(tokenizer: *xml.Tokenizer, token: *xml.Token) -> void {
    var entry = Command.{ .name = "", .alias = "", .vulkan = true, .returnsResult = false, .firstParam = "", .successCodes = "", .errorCodes = "", .version = 9 }
    var lastText: []const u8 = ""
    var inProto = false
    var inParam = false
    var paramSeen = false
    var paramApiOk = true
    var depth: usize = 1
    var element: []const u8 = "command"
    while depth > 0 && xml.next(tokenizer, token) {
        const kind = token.*.kind
        if kind == xml.TokenKind.attribute {
            const name = text(token.*.name)
            const value = text(token.*.value)
            if depth == 1 {
                if equal(name, "name") { entry.name = value }
                if equal(name, "alias") { entry.alias = value }
                if equal(name, "api") { entry.vulkan = hasApi(value, "vulkan") }
                if equal(name, "successcodes") { entry.successCodes = value }
                if equal(name, "errorcodes") { entry.errorCodes = value }
            }
            if equal(element, "param") && equal(name, "api") { paramApiOk = hasApi(value, "vulkan") }
        } else if kind == xml.TokenKind.elementStart {
            depth += 1
            element = text(token.*.name)
            if depth == 2 && equal(element, "proto") { inProto = true }
            if depth == 2 && equal(element, "param") {
                inParam = true
                paramApiOk = true
            }
        } else if kind == xml.TokenKind.text {
            lastText = text(token.*.value)
        } else if kind == xml.TokenKind.elementEnd {
            const ended = text(token.*.name)
            if inProto && equal(ended, "type") { entry.returnsResult = equal(lastText, "VkResult") }
            if inProto && equal(ended, "name") { entry.name = lastText }
            if inParam && !paramSeen && paramApiOk && equal(ended, "type") {
                entry.firstParam = lastText
                paramSeen = true
            }
            if depth == 2 && equal(ended, "proto") { inProto = false }
            if depth == 2 && equal(ended, "param") { inParam = false }
            depth -= 1
            element = ""
        }
    }
    if entry.name.length == 0 || commandCount >= MOST_COMMANDS { return }
    commands[commandCount] = entry
    commandCount += 1
}

// The version a <feature>'s name stands for (VK_VERSION_1_0, VK_BASE_
// VERSION_1_1, ...): 0, 1, or 9.
fn versionOf(name: []const u8) -> usize {
    if name.length < 4 { return 9 }
    const tail = name[name.length - 4..name.length]
    const core = name.length > 3 && equal(name[0..3], "VK_")
    if !core { return 9 }
    if equal(tail, "_1_0") { return 0 }
    if equal(tail, "_1_1") { return 1 }
    return 9
}

// A <feature> element (its start tag taken): its own name and api, then
// the commands its <require>s name take its version, and the features
// VK_VERSION_1_0 requires are kept.
fn readFeature(tokenizer: *xml.Tokenizer, token: *xml.Token) -> void {
    var depth: usize = 1
    var name: []const u8 = ""
    var version: usize = 9
    var featureApi = true
    var element: []const u8 = ""
    var itemName: []const u8 = ""
    var itemStruct: []const u8 = ""
    var itemApi = true
    var requireApi = true
    while depth > 0 && xml.next(tokenizer, token) {
        const kind = token.*.kind
        if kind == xml.TokenKind.elementStart {
            depth += 1
            element = text(token.*.name)
            itemName = ""
            itemStruct = ""
            itemApi = true
            if depth == 2 { requireApi = true }
        } else if kind == xml.TokenKind.attribute {
            const attribute = text(token.*.name)
            const value = text(token.*.value)
            if depth == 1 && equal(attribute, "name") {
                name = value
                version = versionOf(value)
            }
            if depth == 1 && equal(attribute, "api") { featureApi = hasApi(value, "vulkan") }
            if depth == 2 && equal(attribute, "api") { requireApi = hasApi(value, "vulkan") }
            if depth == 3 && equal(attribute, "name") { itemName = value }
            if depth == 3 && equal(attribute, "struct") { itemStruct = value }
            if depth == 3 && equal(attribute, "api") { itemApi = hasApi(value, "vulkan") }
        } else if kind == xml.TokenKind.elementEnd {
            if depth == 3 && featureApi && requireApi && itemApi && version != 9 {
                if equal(element, "command") {
                    const at = findCommand(itemName)
                    if at < commandCount && commands[at].version > version { commands[at].version = version }
                }
                if equal(element, "feature") && equal(name, "VK_VERSION_1_0") && required10Count < 8 {
                    required10[required10Count] = itemStruct
                    required10[required10Count + 1] = itemName
                    required10Count += 2
                }
            }
            depth -= 1
        }
    }
}

fn readRegistry() -> bool {
    const loaded = std.fs.readFileAlloc("std/registry/vulkan/vk.xml".pointer, std.heap.allocator())
    if loaded == null { return false }
    source = loaded.?.items
    sourceLength = loaded.?.length
    var tokenizer: xml.Tokenizer = undefined
    var token: xml.Token = undefined
    xml.initAt(&tokenizer, source, sourceLength)
    var inCommands = false
    while xml.next(&tokenizer, &token) {
        if token.kind == xml.TokenKind.elementStart {
            const element = text(token.name)
            if equal(element, "commands") {
                inCommands = true
            } else if inCommands && equal(element, "command") {
                readCommand(&tokenizer, &token)
            } else if equal(element, "feature") && xml.depth(&tokenizer) == 2 {
                readFeature(&tokenizer, &token)
            }
        } else if token.kind == xml.TokenKind.elementEnd && equal(text(token.name), "commands") {
            inCommands = false
        }
    }
    // An alias takes its command's version and codes.
    var k: usize = 0
    while k < commandCount {
        if commands[k].alias.length > 0 {
            const at = findCommand(commands[k].alias)
            if at < commandCount {
                commands[k].returnsResult = commands[at].returnsResult
                commands[k].firstParam = commands[at].firstParam
                commands[k].successCodes = commands[at].successCodes
                commands[k].errorCodes = commands[at].errorCodes
            }
        }
        k += 1
    }
    return !xml.failed(&tokenizer) && commandCount > 600
}

// Whether `code`'s name is in the command's codes.
fn among(list: []const u8, code: []const u8) -> bool {
    var start: usize = 0
    var k: usize = 0
    while k <= list.length {
        if k == list.length || list[k] == 44 {
            if equal(list[start..k], code) { return true }
            start = k + 1
        }
        k += 1
    }
    return false
}

fn resultName(result: vk.Result) -> []const u8 {
    if result == vk.Result.success { return "VK_SUCCESS" }
    if result == vk.Result.incomplete { return "VK_INCOMPLETE" }
    if result == vk.Result.errorOutOfHostMemory { return "VK_ERROR_OUT_OF_HOST_MEMORY" }
    if result == vk.Result.errorInitializationFailed { return "VK_ERROR_INITIALIZATION_FAILED" }
    if result == vk.Result.errorLayerNotPresent { return "VK_ERROR_LAYER_NOT_PRESENT" }
    if result == vk.Result.errorExtensionNotPresent { return "VK_ERROR_EXTENSION_NOT_PRESENT" }
    if result == vk.Result.errorFeatureNotPresent { return "VK_ERROR_FEATURE_NOT_PRESENT" }
    if result == vk.Result.errorIncompatibleDriver { return "VK_ERROR_INCOMPATIBLE_DRIVER" }
    if result == vk.Result.errorTooManyObjects { return "VK_ERROR_TOO_MANY_OBJECTS" }
    if result == vk.Result.errorFormatNotSupported { return "VK_ERROR_FORMAT_NOT_SUPPORTED" }
    return "(another)"
}

// A result the driver gave for `command`: one the registry gives it.
fn gave(number: u8, command: []const u8, result: vk.Result) -> void {
    const at = findCommand(command)
    check(number, at < commandCount && commands[at].returnsResult)
    if at >= commandCount { return }
    const name = resultName(result)
    check(number, among(commands[at].successCodes, name) || among(commands[at].errorCodes, name))
}

// ---------------------------------------------------------------------------
// The driver, reached

// The level a command is at by its first parameter.
fn deviceLevel(first: []const u8) -> bool {
    return equal(first, "VkDevice") || equal(first, "VkQueue") || equal(first, "VkCommandBuffer") || equal(first, "VkExternalComputeQueueNV")
}

fn instanceLevel(first: []const u8) -> bool { return equal(first, "VkInstance") || equal(first, "VkPhysicalDevice") }

fn isGlobal(name: []const u8) -> bool {
    return equal(name, "vkCreateInstance") || equal(name, "vkEnumerateInstanceVersion") || equal(name, "vkEnumerateInstanceExtensionProperties") || equal(name, "vkEnumerateInstanceLayerProperties") || equal(name, "vkGetInstanceProcAddr")
}

fn deviceThree(name: []const u8) -> bool { return equal(name, "vkGetDeviceProcAddr") || equal(name, "vkDestroyDevice") || equal(name, "vkGetDeviceQueue") }

var nameBuffer: [128]u8 = undefined

fn cName(name: []const u8) -> [*]const u8 {
    var k: usize = 0
    while k < name.length && k < 127 {
        nameBuffer[k] = name[k]
        k += 1
    }
    nameBuffer[k] = 0
    const bytes: [*]const u8 = &nameBuffer
    return bytes
}

const GetProcAddr = fn(usize, ?[*]const u8) -> usize

fn ask(entry: usize, handle: usize, name: []const u8) -> usize {
    var function: GetProcAddr = unsafe { @ptrFromInt(GetProcAddr, entry) }
    return function(handle, cName(name))
}

// An argument list of none whose environment sets VK_DRIVER_FILES to a
// manifest that is not there, laid out as main gets its arguments (them,
// a null, the environment, a null): the loader then reads no manifest of
// the host's, whatever drivers it has installed.
var block: [3][*]const u8 = undefined

fn noManifests() -> [][*]const u8 {
    block[0] = unsafe { @ptrFromInt([*]const u8, 0) }
    block[1] = "VK_DRIVER_FILES=/nonexistent/none.json".pointer
    block[2] = unsafe { @ptrFromInt([*]const u8, 0) }
    return block[0..0]
}

var global: vk.GlobalCommands = undefined
var instanceCommands: vk.InstanceCommands = undefined
var deviceCommands: vk.DeviceCommands = undefined

fn setUp(computeRings: u32) -> void {
    host.reset()
    const facts = host.rx580(computeRings)
    _ = host.add(&facts)
    driver.use(host.interface())
}

fn makeInstance(apiVersion: u32) -> vk.Instance {
    var application = vk.ApplicationInfo.init()
    application.apiVersion = apiVersion
    var info = vk.InstanceCreateInfo.init()
    info.pApplicationInfo = &application
    var instance: vk.Instance = 0
    vk.loadGlobalCommands(&global, driver.instanceProcAddr())
    const made = vk.createInstance(&global, &info, null, &instance)
    gave(60, "vkCreateInstance", made)
    if made != vk.Result.success { return 0 }
    vk.loadInstanceCommands(&instanceCommands, instance, driver.instanceProcAddr())
    return instance
}

// ---------------------------------------------------------------------------
// The checks

fn testInterface() -> void {
    var version: u32 = 5
    check(20, driver.negotiate(&version) == vk.Result.success && version == 5)
    version = 7
    check(21, driver.negotiate(&version) == vk.Result.success && version == 5)
    version = 4
    check(22, driver.negotiate(&version) == vk.Result.success && version == 4)
    version = 2
    check(23, driver.negotiate(&version) == vk.Result.errorIncompatibleDriver)
    // Through the loader's native path: found only with a card.
    host.reset()
    check(24, driver.offer(host.interface()))
    var manifests: loader.Manifests = undefined
    const noArguments = noManifests()
    _ = loader.findDrivers(&manifests, noArguments, std.heap.allocator())
    var builtIns: usize = 0
    var k: usize = 0
    while k < manifests.count {
        if loader.manifestAt(&manifests, k).*.builtIn != 0 { builtIns += 1 }
        k += 1
    }
    check(25, builtIns == 0)
    const facts = host.rx580(0)
    _ = host.add(&facts)
    const found = loader.findDrivers(&manifests, noArguments, std.heap.allocator())
    // (VK_DRIVER_FILES names a manifest that is not there: the offered
    // driver is all there is, also where the host has drivers installed.)
    check(26, found == 1 && loader.manifestAt(&manifests, 0).*.builtIn == 1)
    check(27, equal(cText(loader.manifestPath(loader.manifestAt(&manifests, 0))), "builtin:brix-radeon"))
    check(28, loader.manifestAt(&manifests, 0).*.apiVersion == driver.INSTANCE_VERSION)
    // Offered again: one entry still.
    check(29, driver.offer(host.interface()) && loader.offered() == 1)
    var opened: loader.Driver = undefined
    check(30, loader.openDriver(&opened, loader.manifestAt(&manifests, 0), std.heap.allocator()) == loader.Status.ok)
    check(31, opened.interfaceVersion == 5 && opened.library == 0 && opened.getInstanceProcAddr == driver.instanceProcAddr() && opened.getPhysicalDeviceProcAddr == driver.physicalDeviceProcAddr())
    check(32, opened.apiVersion == driver.INSTANCE_VERSION && opened.global.*.vkCreateInstance != 0 && opened.global.*.vkEnumerateInstanceVersion != 0)
    var asked: u32 = 0
    const answered = vk.enumerateInstanceVersion(opened.global, &asked)
    gave(33, "vkEnumerateInstanceVersion", answered)
    check(34, asked == driver.INSTANCE_VERSION && vk.apiVersionMajor(asked) == 1 && vk.apiVersionMinor(asked) == 1 && vk.apiVersionPatch(asked) == vk.HEADER_VERSION)
    loader.closeDriver(&opened)
}

// Every command of the registry asked of each entry.
fn testWhichAnswer() -> void {
    setUp(1)
    const instance = makeInstance(vk.API_VERSION_1_1)
    check(40, instance != 0)
    if instance == 0 { return }
    var physical: vk.PhysicalDevice = 0
    var count: u32 = 1
    _ = vk.enumeratePhysicalDevices(&instanceCommands, instance, &count, unsafe { @ptrCast([*]vk.PhysicalDevice, &physical) })
    var info = vk.DeviceCreateInfo.init()
    var queueInfo = vk.DeviceQueueCreateInfo.init()
    queueInfo.queueFamilyIndex = 0
    queueInfo.queueCount = 1
    info.queueCreateInfoCount = 1
    info.pQueueCreateInfos = unsafe { @ptrCast([*]const vk.DeviceQueueCreateInfo, &queueInfo) }
    var device: vk.Device = 0
    check(41, vk.createDevice(&instanceCommands, physical, &info, null, &device) == vk.Result.success)
    const entry = driver.instanceProcAddr()
    const physicalEntry = driver.physicalDeviceProcAddr()
    const deviceEntry = ask(entry, instance, "vkGetDeviceProcAddr")
    var wrongGlobal = 0
    var wrongInstance = 0
    var wrongPhysical = 0
    var wrongDevice = 0
    var answered: usize = 0
    var k: usize = 0
    while k < commandCount {
        const c = &commands[k]
        k += 1
        if !c.*.vulkan { continue }
        const name = c.*.name
        // Through the instance: the 1.0 and 1.1 instance-level commands and
        // the device's three.
        const core = c.*.alias.length == 0 && c.*.version <= 1
        const wantInstance = core && (isGlobal(name) || instanceLevel(c.*.firstParam) || deviceThree(name))
        const viaInstance = ask(entry, instance, name)
        if (viaInstance != 0) != wantInstance { wrongInstance += 1 }
        if viaInstance != 0 { answered += 1 }
        if (ask(entry, 0, name) != 0) != (core && isGlobal(name)) { wrongGlobal += 1 }
        const wantPhysical = core && equal(c.*.firstParam, "VkPhysicalDevice")
        const viaPhysical = ask(physicalEntry, instance, name)
        if (viaPhysical != 0) != wantPhysical || (wantPhysical && viaPhysical != viaInstance) { wrongPhysical += 1 }
        if device != 0 {
            const viaDevice = ask(deviceEntry, device, name)
            if (viaDevice != 0) != (core && deviceThree(name)) || (viaDevice != 0 && viaDevice != viaInstance) { wrongDevice += 1 }
        }
    }
    check(42, wrongGlobal == 0)
    check(43, wrongInstance == 0)
    check(44, wrongPhysical == 0)
    check(45, wrongDevice == 0)
    // As many as the registry has of these: 31 (of 1.0 the four global
    // commands and 16 of the instance and its physical devices beside the
    // device's three; of 1.1 the version and 11 of the instance's).
    var expected: usize = 0
    k = 0
    while k < commandCount {
        const c = &commands[k]
        if c.*.vulkan && c.*.alias.length == 0 && c.*.version <= 1 && (isGlobal(c.*.name) || instanceLevel(c.*.firstParam) || deviceThree(c.*.name)) { expected += 1 }
        k += 1
    }
    check(46, answered == expected && expected == 31)
    // No name that is not a command's, nor null.
    check(47, ask(entry, instance, "vkNoSuchCommand") == 0 && ask(entry, instance, "vkCreateInstanceX") == 0 && ask(entry, instance, "vkCreateInstanc") == 0)
    var nothing: GetProcAddr = unsafe { @ptrFromInt(GetProcAddr, entry) }
    check(48, nothing(instance, null) == 0)
    if device != 0 {
        vk.loadDeviceCommands(&deviceCommands, device, instanceCommands.vkGetDeviceProcAddr)
        vk.destroyDevice(&deviceCommands, device, null)
    }
    vk.destroyInstance(&instanceCommands, instance, null)
}

fn testVersionAndInstance() -> void {
    setUp(0)
    vk.loadGlobalCommands(&global, driver.instanceProcAddr())
    // A wrong structure, a layer, an extension.
    var info = vk.InstanceCreateInfo.init()
    var instance: vk.Instance = 0
    info.sType = vk.StructureType.deviceCreateInfo
    var result = vk.createInstance(&global, &info, null, &instance)
    gave(61, "vkCreateInstance", result)
    check(62, result == vk.Result.errorInitializationFailed)
    info = vk.InstanceCreateInfo.init()
    const layerName = [_][*]const u8{ "VK_LAYER_KHRONOS_validation".pointer }
    info.enabledLayerCount = 1
    info.ppEnabledLayerNames = &layerName
    result = vk.createInstance(&global, &info, null, &instance)
    gave(63, "vkCreateInstance", result)
    check(64, result == vk.Result.errorLayerNotPresent)
    info = vk.InstanceCreateInfo.init()
    const extensionName = [_][*]const u8{ "VK_KHR_surface".pointer }
    info.enabledExtensionCount = 1
    info.ppEnabledExtensionNames = &extensionName
    result = vk.createInstance(&global, &info, null, &instance)
    gave(65, "vkCreateInstance", result)
    check(66, result == vk.Result.errorExtensionNotPresent)
    // A version above the instance's is taken (1.1 and later must not
    // refuse one); none at all too.
    const higher = makeInstance(vk.API_VERSION_1_3)
    check(67, higher != 0 && icd.hasLoaderMagic(higher))
    if higher != 0 { vk.destroyInstance(&instanceCommands, higher, null) }
    info = vk.InstanceCreateInfo.init()
    result = vk.createInstance(&global, &info, null, &instance)
    check(68, result == vk.Result.success)
    vk.loadInstanceCommands(&instanceCommands, instance, driver.instanceProcAddr())
    vk.destroyInstance(&instanceCommands, instance, null)
    // The instance's extensions and layers: none; a layer's: no layer.
    var count: u32 = 9
    var properties: [4]vk.ExtensionProperties = undefined
    result = vk.enumerateInstanceExtensionProperties(&global, null, &count, null)
    gave(69, "vkEnumerateInstanceExtensionProperties", result)
    check(70, result == vk.Result.success && count == 0)
    count = 4
    result = vk.enumerateInstanceExtensionProperties(&global, "VK_LAYER_x".pointer, &count, &properties)
    gave(71, "vkEnumerateInstanceExtensionProperties", result)
    check(72, result == vk.Result.errorLayerNotPresent)
    var layers: [2]vk.LayerProperties = undefined
    count = 2
    result = vk.enumerateInstanceLayerProperties(&global, &count, &layers)
    gave(73, "vkEnumerateInstanceLayerProperties", result)
    check(74, result == vk.Result.success && count == 0)
}

// The properties, features, memory, queue family and the rest of the
// physical device's queries.
fn testPhysicalDevice() -> void {
    setUp(0)
    const instance = makeInstance(vk.API_VERSION_1_1)
    if instance == 0 { return }
    // Two-call: the count, a short array, a long one.
    var count: u32 = 0
    var result = vk.enumeratePhysicalDevices(&instanceCommands, instance, &count, null)
    gave(80, "vkEnumeratePhysicalDevices", result)
    check(81, result == vk.Result.success && count == 1)
    var devices: [3]vk.PhysicalDevice = [3]vk.PhysicalDevice{ 7, 7, 7 }
    count = 0
    result = vk.enumeratePhysicalDevices(&instanceCommands, instance, &count, &devices)
    gave(82, "vkEnumeratePhysicalDevices", result)
    check(83, result == vk.Result.incomplete && count == 0 && devices[0] == 7)
    count = 3
    result = vk.enumeratePhysicalDevices(&instanceCommands, instance, &count, &devices)
    gave(84, "vkEnumeratePhysicalDevices", result)
    check(85, result == vk.Result.success && count == 1 && devices[0] != 0 && devices[1] == 7 && icd.hasLoaderMagic(devices[0]))
    const physical = devices[0]
    // The properties.
    var properties = vk.PhysicalDeviceProperties.init()
    vk.getPhysicalDeviceProperties(&instanceCommands, physical, &properties)
    check(86, properties.apiVersion == driver.DEVICE_VERSION && vk.apiVersionMinor(properties.apiVersion) == 0 && properties.vendorID == 0x1002 && properties.deviceID == 0x67DF)
    check(87, properties.deviceType == vk.PhysicalDeviceType.discreteGpu && equal(cText(&properties.deviceName), "AMD Radeon RX 580 (Polaris 10)"))
    check(88, properties.limits.maxComputeWorkGroupSize[0] >= 8 && properties.limits.maxComputeWorkGroupCount[0] >= 480 && properties.limits.maxPushConstantsSize >= 128 && properties.limits.framebufferColorSampleCounts == 0xF)
    check(89, properties.limits.timestampComputeAndGraphics == vk.FALSE && properties.limits.maxSamplerAnisotropy == 16.0 && properties.limits.pointSizeRange[1] == 8191.875)
    // ...2 with the driver's record chained, and one it does not know after
    // it, left as it was.
    var unknown = vk.PhysicalDeviceDriverProperties.init()
    unknown.sType = vk.StructureType.physicalDeviceIdProperties
    unknown.driverInfo[0] = 0x5A
    var driverRecord = vk.PhysicalDeviceDriverProperties.init()
    driverRecord.pNext = &unknown
    var properties2 = vk.PhysicalDeviceProperties2.init()
    properties2.pNext = &driverRecord
    vk.getPhysicalDeviceProperties2(&instanceCommands, physical, &properties2)
    check(90, properties2.properties.deviceID == 0x67DF && equal(cText(&driverRecord.driverInfo), driver.INFO) && equal(cText(&driverRecord.driverName), driver.DRIVER_NAME))
    check(91, driverRecord.conformanceVersion.major == 0 && unknown.driverInfo[0] == 0x5A && driverRecord.pNext == &unknown)
    // The driver's record behind a structure it does not know: found all
    // the same.
    var behind = vk.PhysicalDeviceDriverProperties.init()
    unknown.pNext = &behind
    driverRecord.pNext = null
    properties2.pNext = &unknown
    vk.getPhysicalDeviceProperties2(&instanceCommands, physical, &properties2)
    check(119, equal(cText(&behind.driverInfo), driver.INFO) && unknown.driverInfo[0] == 0x5A)
    // Every feature false: also robustBufferAccess, the one 1.0 requires.
    var features: vk.PhysicalDeviceFeatures = undefined
    var bytes: [*]u8 = unsafe { @ptrCast([*]u8, &features) }
    var k: usize = 0
    while k < @sizeOf(vk.PhysicalDeviceFeatures) {
        bytes[k] = 0xFF
        k += 1
    }
    vk.getPhysicalDeviceFeatures(&instanceCommands, physical, &features)
    var any = false
    k = 0
    while k < @sizeOf(vk.PhysicalDeviceFeatures) {
        if bytes[k] != 0 { any = true }
        k += 1
    }
    check(92, !any && features.robustBufferAccess == vk.FALSE)
    check(93, required10Count == 2 && equal(required10[0], "VkPhysicalDeviceFeatures") && equal(required10[1], "robustBufferAccess"))
    var features2 = vk.PhysicalDeviceFeatures2.init()
    features2.features.shaderInt64 = vk.TRUE
    vk.getPhysicalDeviceFeatures2(&instanceCommands, physical, &features2)
    check(94, features2.features.shaderInt64 == vk.FALSE && features2.sType == vk.StructureType.physicalDeviceFeatures2)
    // The memory.
    var memory = vk.PhysicalDeviceMemoryProperties.init()
    vk.getPhysicalDeviceMemoryProperties(&instanceCommands, physical, &memory)
    // (The user's card at this stage: its GART is not on, so the card
    // reaches none of the system's memory.)
    check(95, memory.memoryHeapCount == 2 && memory.memoryHeapCount <= 16 && memory.memoryTypeCount == 2 && memory.memoryTypeCount <= 32)
    check(96, memory.memoryHeaps[0].size == (8192 - 256) * 1024 * 1024 && memory.memoryHeaps[1].size == 256 * 1024 * 1024 - 4800 * 1024 && memory.memoryTypes[0].heapIndex == 0 && memory.memoryTypes[1].heapIndex == 1 && memory.memoryTypes[1].propertyFlags == vk.MEMORY_PROPERTY_DEVICE_LOCAL_BIT | vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT)
    var hostVisible = false
    var deviceHeap = false
    var ordered = true
    k = 0
    while k < @intCast(usize, memory.memoryTypeCount) {
        const flags = memory.memoryTypes[k].propertyFlags
        if memory.memoryTypes[k].heapIndex >= memory.memoryHeapCount { ordered = false }
        if flags & 6 == 6 { hostVisible = true }
        // A type whose flags are a strict subset of a later one's comes
        // first: none later may be a strict subset of it.
        var later = k + 1
        while later < @intCast(usize, memory.memoryTypeCount) {
            const other = memory.memoryTypes[later].propertyFlags
            if other & flags == other && other != flags { ordered = false }
            later += 1
        }
        k += 1
    }
    k = 0
    while k < @intCast(usize, memory.memoryHeapCount) {
        if memory.memoryHeaps[k].flags & vk.MEMORY_HEAP_DEVICE_LOCAL_BIT != 0 { deviceHeap = true }
        k += 1
    }
    check(97, hostVisible && deviceHeap && ordered)
    var memory2 = vk.PhysicalDeviceMemoryProperties2.init()
    vk.getPhysicalDeviceMemoryProperties2(&instanceCommands, physical, &memory2)
    check(98, memory2.memoryProperties.memoryTypeCount == 2 && memory2.memoryProperties.memoryHeaps[1].size == memory.memoryHeaps[1].size)
    // The queue family, both forms, both calls.
    var families: [3]vk.QueueFamilyProperties = undefined
    families[1].queueCount = 77
    count = 0
    vk.getPhysicalDeviceQueueFamilyProperties(&instanceCommands, physical, &count, null)
    check(99, count == 1)
    count = 3
    vk.getPhysicalDeviceQueueFamilyProperties(&instanceCommands, physical, &count, &families)
    check(100, count == 1 && families[0].queueFlags == vk.QUEUE_COMPUTE_BIT | vk.QUEUE_TRANSFER_BIT && families[0].queueCount == 1 && families[0].timestampValidBits == 0 && families[1].queueCount == 77)
    count = 0
    vk.getPhysicalDeviceQueueFamilyProperties(&instanceCommands, physical, &count, &families)
    check(101, count == 0)
    var families2: [2]vk.QueueFamilyProperties2 = undefined
    families2[0] = vk.QueueFamilyProperties2.init()
    families2[1] = vk.QueueFamilyProperties2.init()
    count = 2
    vk.getPhysicalDeviceQueueFamilyProperties2(&instanceCommands, physical, &count, &families2)
    check(102, count == 1 && families2[0].queueFamilyProperties.queueFlags & vk.QUEUE_COMPUTE_BIT != 0 && families2[0].sType == vk.StructureType.queueFamilyProperties2)
    // No format feature, no image format, no sparse format, no external
    // handle.
    var format: vk.FormatProperties = undefined
    format.bufferFeatures = 0xFFFF
    vk.getPhysicalDeviceFormatProperties(&instanceCommands, physical, vk.Format.b8g8r8a8Unorm, &format)
    check(103, format.bufferFeatures == 0 && format.linearTilingFeatures == 0 && format.optimalTilingFeatures == 0)
    var image: vk.ImageFormatProperties = undefined
    result = vk.getPhysicalDeviceImageFormatProperties(&instanceCommands, physical, vk.Format.b8g8r8a8Unorm, vk.ImageType.type2d, vk.ImageTiling.linear, 1, 0, &image)
    gave(104, "vkGetPhysicalDeviceImageFormatProperties", result)
    check(105, result == vk.Result.errorFormatNotSupported)
    var imageInfo = vk.PhysicalDeviceImageFormatInfo2.init()
    var image2 = vk.ImageFormatProperties2.init()
    result = vk.getPhysicalDeviceImageFormatProperties2(&instanceCommands, physical, &imageInfo, &image2)
    gave(106, "vkGetPhysicalDeviceImageFormatProperties2", result)
    check(107, result == vk.Result.errorFormatNotSupported)
    count = 5
    vk.getPhysicalDeviceSparseImageFormatProperties(&instanceCommands, physical, vk.Format.b8g8r8a8Unorm, vk.ImageType.type2d, vk.SAMPLE_COUNT_1_BIT, 1, vk.ImageTiling.optimal, &count, null)
    check(108, count == 0)
    var bufferInfo = vk.PhysicalDeviceExternalBufferInfo.init()
    var external = vk.ExternalBufferProperties.init()
    external.externalMemoryProperties.compatibleHandleTypes = 0xFF
    vk.getPhysicalDeviceExternalBufferProperties(&instanceCommands, physical, &bufferInfo, &external)
    check(109, external.externalMemoryProperties.compatibleHandleTypes == 0 && external.externalMemoryProperties.externalMemoryFeatures == 0)
    // The device's extensions and layers: none.
    var extensions: [2]vk.ExtensionProperties = undefined
    count = 2
    result = vk.enumerateDeviceExtensionProperties(&instanceCommands, physical, null, &count, &extensions)
    gave(110, "vkEnumerateDeviceExtensionProperties", result)
    check(111, result == vk.Result.success && count == 0)
    result = vk.enumerateDeviceExtensionProperties(&instanceCommands, physical, "VK_LAYER_x".pointer, &count, null)
    gave(112, "vkEnumerateDeviceExtensionProperties", result)
    check(113, result == vk.Result.errorLayerNotPresent)
    // A group of its own.
    var groups: [2]vk.PhysicalDeviceGroupProperties = undefined
    groups[0] = vk.PhysicalDeviceGroupProperties.init()
    groups[1] = vk.PhysicalDeviceGroupProperties.init()
    groups[1].physicalDeviceCount = 99
    count = 0
    result = vk.enumeratePhysicalDeviceGroups(&instanceCommands, instance, &count, null)
    gave(114, "vkEnumeratePhysicalDeviceGroups", result)
    check(115, result == vk.Result.success && count == 1)
    count = 2
    result = vk.enumeratePhysicalDeviceGroups(&instanceCommands, instance, &count, &groups)
    check(116, result == vk.Result.success && count == 1 && groups[0].physicalDeviceCount == 1 && groups[0].physicalDevices[0] == physical && groups[0].subsetAllocation == vk.FALSE && groups[1].physicalDeviceCount == 99)
    count = 0
    result = vk.enumeratePhysicalDeviceGroups(&instanceCommands, instance, &count, &groups)
    gave(117, "vkEnumeratePhysicalDeviceGroups", result)
    check(118, result == vk.Result.incomplete && count == 0)
    vk.destroyInstance(&instanceCommands, instance, null)
}

fn deviceInfo(queue: *vk.DeviceQueueCreateInfo, family: u32, count: u32) -> vk.DeviceCreateInfo {
    queue.* = vk.DeviceQueueCreateInfo.init()
    queue.*.queueFamilyIndex = family
    queue.*.queueCount = count
    var info = vk.DeviceCreateInfo.init()
    info.queueCreateInfoCount = 1
    info.pQueueCreateInfos = unsafe { @ptrCast([*]const vk.DeviceQueueCreateInfo, queue) }
    return info
}

fn firstPhysical(instance: vk.Instance) -> vk.PhysicalDevice {
    var physical: vk.PhysicalDevice = 0
    var count: u32 = 1
    _ = vk.enumeratePhysicalDevices(&instanceCommands, instance, &count, unsafe { @ptrCast([*]vk.PhysicalDevice, &physical) })
    return physical
}

fn testDevice() -> void {
    // No compute ring: refused, no context.
    setUp(0)
    var instance = makeInstance(vk.API_VERSION_1_1)
    if instance == 0 { return }
    var physical = firstPhysical(instance)
    var queue: vk.DeviceQueueCreateInfo = undefined
    var info = deviceInfo(&queue, 0, 1)
    var device: vk.Device = 0
    var result = vk.createDevice(&instanceCommands, physical, &info, null, &device)
    gave(130, "vkCreateDevice", result)
    check(131, result == vk.Result.errorInitializationFailed && driver.refusal() == driver.Refusal.NO_ENGINE && host.living() == 0)
    vk.destroyInstance(&instanceCommands, instance, null)
    // A ring: a context held by the device.
    setUp(1)
    instance = makeInstance(vk.API_VERSION_1_1)
    physical = firstPhysical(instance)
    info = deviceInfo(&queue, 0, 1)
    result = vk.createDevice(&instanceCommands, physical, &info, null, &device)
    gave(132, "vkCreateDevice", result)
    check(133, result == vk.Result.success && device != 0 && icd.hasLoaderMagic(device) && host.living() == 1 && driver.contextOf(device) != 0)
    if result == vk.Result.success {
        vk.loadDeviceCommands(&deviceCommands, device, instanceCommands.vkGetDeviceProcAddr)
        check(134, deviceCommands.vkGetDeviceQueue != 0 && deviceCommands.vkDestroyDevice != 0 && deviceCommands.vkQueueSubmit == 0 && deviceCommands.vkAllocateMemory == 0 && deviceCommands.vkCreateCommandPool == 0)
        var first: vk.Queue = 0
        var second: vk.Queue = 0
        var other: vk.Queue = 5
        vk.getDeviceQueue(&deviceCommands, device, 0, 0, &first)
        vk.getDeviceQueue(&deviceCommands, device, 0, 0, &second)
        check(135, first != 0 && first == second && icd.hasLoaderMagic(first))
        vk.getDeviceQueue(&deviceCommands, device, 0, 1, &other)
        check(136, other == 0)
        other = 5
        vk.getDeviceQueue(&deviceCommands, device, 1, 0, &other)
        check(137, other == 0)
        // The context is the card's: its record through it.
        var through: gpucard.Device = undefined
        const interface = host.interface()
        const describeContext = interface.describeContext
        check(138, describeContext(driver.contextOf(device), &through) == 0 && through.device == 0x67DF)
        vk.destroyDevice(&deviceCommands, device, null)
        check(139, host.living() == 0)
    }
    // A feature, an extension, another family, two queues.
    var features: vk.PhysicalDeviceFeatures = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &features) }
    var k: usize = 0
    while k < @sizeOf(vk.PhysicalDeviceFeatures) {
        bytes[k] = 0
        k += 1
    }
    features.robustBufferAccess = vk.TRUE
    info = deviceInfo(&queue, 0, 1)
    info.pEnabledFeatures = &features
    result = vk.createDevice(&instanceCommands, physical, &info, null, &device)
    gave(140, "vkCreateDevice", result)
    check(141, result == vk.Result.errorFeatureNotPresent && host.living() == 0)
    var features2 = vk.PhysicalDeviceFeatures2.init()
    features2.features.shaderInt64 = vk.TRUE
    info = deviceInfo(&queue, 0, 1)
    info.pNext = &features2
    result = vk.createDevice(&instanceCommands, physical, &info, null, &device)
    check(142, result == vk.Result.errorFeatureNotPresent)
    info = deviceInfo(&queue, 0, 1)
    const extensionName = [_][*]const u8{ "VK_KHR_swapchain".pointer }
    info.enabledExtensionCount = 1
    info.ppEnabledExtensionNames = &extensionName
    result = vk.createDevice(&instanceCommands, physical, &info, null, &device)
    gave(143, "vkCreateDevice", result)
    check(144, result == vk.Result.errorExtensionNotPresent)
    info = deviceInfo(&queue, 1, 1)
    result = vk.createDevice(&instanceCommands, physical, &info, null, &device)
    check(145, result == vk.Result.errorInitializationFailed && driver.refusal() == driver.Refusal.NONE)
    info = deviceInfo(&queue, 0, 2)
    result = vk.createDevice(&instanceCommands, physical, &info, null, &device)
    check(146, result == vk.Result.errorInitializationFailed && host.living() == 0)
    // Every context of the card taken by others: too many objects.
    const interface = host.interface()
    const open = interface.open
    k = 0
    while k < host.MOST_CONTEXTS {
        _ = open(0)
        k += 1
    }
    info = deviceInfo(&queue, 0, 1)
    result = vk.createDevice(&instanceCommands, physical, &info, null, &device)
    gave(147, "vkCreateDevice", result)
    check(148, result == vk.Result.errorTooManyObjects && driver.refusal() == driver.Refusal.NO_CONTEXT)
    vk.destroyInstance(&instanceCommands, instance, null)
}

// The structure types the driver reads and writes, against the registry's
// numbers.
fn testStructureTypes() -> void {
    var model: registry.Registry = undefined
    var selection: registry.Selection = undefined
    selection.maxMinor = 2
    selection.extensionCount = 0
    selection.everyExtension = false
    selection.platform = std.string.fromSlice("")
    registry.initAt(&model, std.heap.allocator(), source, sourceLength, selection)
    check(150, registry.parse(&model) && registry.resolve(&model))
    const names = [_][]const u8{ "VkInstanceCreateInfo", "VkDeviceCreateInfo", "VkPhysicalDeviceProperties2", "VkPhysicalDeviceDriverProperties", "VkPhysicalDeviceFeatures2", "VkPhysicalDeviceMemoryProperties2", "VkQueueFamilyProperties2", "VkFormatProperties2", "VkImageFormatProperties2", "VkPhysicalDeviceGroupProperties", "VkExternalBufferProperties", "VkExternalFenceProperties", "VkExternalSemaphoreProperties" }
    const ours = [_]vk.StructureType{ vk.StructureType.instanceCreateInfo, vk.StructureType.deviceCreateInfo, vk.StructureType.physicalDeviceProperties2, vk.StructureType.physicalDeviceDriverProperties, vk.StructureType.physicalDeviceFeatures2, vk.StructureType.physicalDeviceMemoryProperties2, vk.StructureType.queueFamilyProperties2, vk.StructureType.formatProperties2, vk.StructureType.imageFormatProperties2, vk.StructureType.physicalDeviceGroupProperties, vk.StructureType.externalBufferProperties, vk.StructureType.externalFenceProperties, vk.StructureType.externalSemaphoreProperties }
    var k: usize = 0
    var matched: usize = 0
    while k < names.length {
        const found = registry.findType(&model, std.string.fromSlice(names[k]))
        check(151, found != registry.NONE)
        if found != registry.NONE {
            const type_ = registry.typeAt(&model, found)
            const first = registry.memberAt(&model, type_.*.memberStart)
            check(152, equal(text(first.*.name), "sType"))
            const enumerant = registry.findEnumerant(&model, first.*.values)
            check(153, enumerant != registry.NONE)
            if enumerant != registry.NONE && registry.enumerantAt(&model, enumerant).*.value == @intCast(i64, @intFromEnum(ours[k])) { matched += 1 }
        }
        k += 1
    }
    check(154, matched == names.length)
    // The limits on the counts the memory record holds.
    const heaps = registry.findEnumerant(&model, std.string.fromSlice("VK_MAX_MEMORY_HEAPS"))
    const types = registry.findEnumerant(&model, std.string.fromSlice("VK_MAX_MEMORY_TYPES"))
    check(155, heaps != registry.NONE && types != registry.NONE)
}

// std.gpu over the driver: the device found, then refused.
fn testStdGpu() -> void {
    var k: usize = 0
    var rings: u32 = 0
    while rings < 2 {
        host.reset()
        const facts = host.rx580(rings)
        _ = host.add(&facts)
        _ = driver.offer(host.interface())
        var manifests: loader.Manifests = undefined
        _ = loader.findDrivers(&manifests, noManifests(), std.heap.allocator())
        var opened: loader.Driver = undefined
        check(160, loader.openDriver(&opened, loader.manifestAt(&manifests, 0), std.heap.allocator()) == loader.Status.ok)
        var context: gpu.Context = undefined
        var options = gpu.defaultOptions("test".pointer)
        options.wantSharing = true
        const status = gpu.open(&context, opened, &options, std.heap.allocator())
        check(161, equal(cText(gpu.deviceName(&context)), "AMD Radeon RX 580 (Polaris 10)"))
        if rings == 0 {
            check(162, status == gpu.Status.deviceFailed && host.living() == 0)
        } else {
            check(163, status == gpu.Status.driverIncomplete && host.living() == 0)
        }
        rings += 1
    }
    k += 1
}

// Whether `memory` holds what Vulkan asks of every device: a heap of the
// device's own memory, a type the processor maps coherently, each type on
// a heap, no heap without bytes, the types in the order Vulkan requires.
fn wellFormed(memory: *const vk.PhysicalDeviceMemoryProperties) -> bool {
    var hostVisible = false
    var deviceHeap = false
    var k: usize = 0
    while k < @intCast(usize, memory.*.memoryHeapCount) {
        if memory.*.memoryHeaps[k].size == 0 { return false }
        if memory.*.memoryHeaps[k].flags & vk.MEMORY_HEAP_DEVICE_LOCAL_BIT != 0 { deviceHeap = true }
        k += 1
    }
    k = 0
    while k < @intCast(usize, memory.*.memoryTypeCount) {
        const flags = memory.*.memoryTypes[k].propertyFlags
        if memory.*.memoryTypes[k].heapIndex >= memory.*.memoryHeapCount { return false }
        if flags & 6 == 6 { hostVisible = true }
        var later = k + 1
        while later < @intCast(usize, memory.*.memoryTypeCount) {
            const other = memory.*.memoryTypes[later].propertyFlags
            if other & flags == other && other != flags { return false }
            later += 1
        }
        k += 1
    }
    return hostVisible && deviceHeap
}

// The memory of cards in other states than the user's at this stage.
fn memoryOf(facts: *const record.Facts, into: *vk.PhysicalDeviceMemoryProperties) -> void {
    host.reset()
    _ = host.add(facts)
    driver.use(host.interface())
    const instance = makeInstance(vk.API_VERSION_1_1)
    const physical = firstPhysical(instance)
    vk.getPhysicalDeviceMemoryProperties(&instanceCommands, physical, into)
    vk.destroyInstance(&instanceCommands, instance, null)
}

fn testMemoryStates() -> void {
    var memory = vk.PhysicalDeviceMemoryProperties.init()
    // The GART on: the system's memory the card reaches is a heap of its
    // own with the processor's two types.
    var on = host.rx580(0)
    on.flags |= record.Flag.SYSTEM_MEMORY
    memoryOf(&on, &memory)
    check(180, memory.memoryHeapCount == 3 && memory.memoryTypeCount == 4 && wellFormed(&memory))
    check(181, memory.memoryHeaps[1].size == 256 * 1024 * 1024 && memory.memoryHeaps[1].flags == 0 && memory.memoryTypes[1].heapIndex == 1 && memory.memoryTypes[2].heapIndex == 1 && memory.memoryTypes[2].propertyFlags & vk.MEMORY_PROPERTY_HOST_CACHED_BIT != 0)
    // A card the firmware did not start (the board's own adapter shows the
    // picture): its memory is not known, nor the GART; the aperture alone,
    // and the device's memory in it.
    var cold = host.rx580(0)
    cold.flags = 0
    cold.memory = 0
    cold.system = 0
    cold.picture = 0
    cold.why = record.Why.CARD_NOT_STARTED
    memoryOf(&cold, &memory)
    check(182, memory.memoryHeapCount == 1 && memory.memoryHeaps[0].size == 256 * 1024 * 1024 && memory.memoryTypeCount == 2 && memory.memoryTypes[0].heapIndex == 0 && wellFormed(&memory))
    // The user's card as listed above: well formed too.
    var users = host.rx580(0)
    memoryOf(&users, &memory)
    check(183, wellFormed(&memory))
}

// The native path negotiates the loader/driver interface with an offered
// driver as with a library: one that refuses every version is not
// opened, one that answers 3 is opened at 3, without the physical
// device's entry (version 4 brought it).
fn refuseAll(version: *u32) -> vk.Result { return vk.Result.errorIncompatibleDriver }

fn onlyThree(version: *u32) -> vk.Result {
    version.* = 3
    return vk.Result.success
}

fn testNativeNegotiation() -> void {
    host.reset()
    const facts = host.rx580(0)
    _ = host.add(&facts)
    check(190, driver.offer(host.interface()))
    var refusing = loader.BuiltIn.{ .name = "refusing", .negotiate = @intFromPtr(refuseAll), .getInstanceProcAddr = driver.instanceProcAddr(), .getPhysicalDeviceProcAddr = driver.physicalDeviceProcAddr(), .apiVersion = driver.INSTANCE_VERSION, .available = 0 }
    var three = refusing
    three.name = "three"
    three.negotiate = @intFromPtr(onlyThree)
    check(191, loader.offer(&refusing) && loader.offer(&three))
    var manifests: loader.Manifests = undefined
    check(192, loader.findDrivers(&manifests, noManifests(), std.heap.allocator()) == 3)
    var opened: loader.Driver = undefined
    check(193, loader.openDriver(&opened, loader.manifestAt(&manifests, 1), std.heap.allocator()) == loader.Status.interfaceUnsupported)
    check(194, loader.openDriver(&opened, loader.manifestAt(&manifests, 2), std.heap.allocator()) == loader.Status.ok && opened.interfaceVersion == 3 && opened.getPhysicalDeviceProcAddr == 0 && opened.getInstanceProcAddr == driver.instanceProcAddr())
    check(195, loader.openDriver(&opened, loader.manifestAt(&manifests, 0), std.heap.allocator()) == loader.Status.ok && opened.interfaceVersion == 5)
}

// A card the driver does not serve: not listed.
fn testOtherCard() -> void {
    host.reset()
    var facts = host.rx580(0)
    facts.device = 0x67EF
    _ = host.add(&facts)
    const ours = host.rx580(0)
    _ = host.add(&ours)
    driver.use(host.interface())
    const instance = makeInstance(vk.API_VERSION_1_1)
    var count: u32 = 0
    _ = vk.enumeratePhysicalDevices(&instanceCommands, instance, &count, null)
    check(170, count == 1)
    var physical: vk.PhysicalDevice = 0
    count = 1
    _ = vk.enumeratePhysicalDevices(&instanceCommands, instance, &count, unsafe { @ptrCast([*]vk.PhysicalDevice, &physical) })
    var properties = vk.PhysicalDeviceProperties.init()
    vk.getPhysicalDeviceProperties(&instanceCommands, physical, &properties)
    check(171, properties.deviceID == 0x67DF)
    vk.destroyInstance(&instanceCommands, instance, null)
    // vkinfo's line without a device: no card node, or a card the driver
    // does not serve (its node is there).
    check(173, equal(listing.noDevice(0), "vkinfo: no Vulkan device: this machine has no graphics card our driver serves (no /devices/gpu0) and no other driver\n"))
    check(174, find(listing.noDevice(1), "no /devices/gpu0") == listing.noDevice(1).length && find(listing.noDevice(1), "does not serve") < listing.noDevice(1).length)
    // No card at all: an instance without devices.
    host.reset()
    const empty = makeInstance(vk.API_VERSION_1_1)
    count = 4
    const result = vk.enumeratePhysicalDevices(&instanceCommands, empty, &count, null)
    check(172, result == vk.Result.success && count == 0)
    vk.destroyInstance(&instanceCommands, empty, null)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = arguments.length > 1
    check(1, readRegistry())
    if sourceLength == 0 { return 1 }
    testInterface()
    testWhichAnswer()
    testVersionAndInstance()
    testPhysicalDevice()
    testDevice()
    testStructureTypes()
    testStdGpu()
    testOtherCard()
    testMemoryStates()
    // (Last: it offers the loader two drivers more.)
    testNativeNegotiation()
    if failed != 0 { return failed }
    return 13
}
