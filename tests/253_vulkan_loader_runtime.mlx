// std.vulkan.loader end to end on a real driver (run by tests/run_vulkan.sh
// with VK_DRIVER_FILES naming lavapipe): open the driver, create an instance
// and a device, record vkCmdFillBuffer + vkCmdCopyBuffer into host-visible
// buffers, submit, wait on a fence and read the result through a mapping.
// Exits 13.
const std = @import("std")
const vk = @import("std.vulkan")
const loader = @import("std.vulkan.loader")

const SIZE: u64 = 4096

fn findMemoryType(properties: *const vk.PhysicalDeviceMemoryProperties, bits: u32, wanted: vk.MemoryPropertyFlags) -> u32 {
    var index: u32 = 0
    while index < properties.*.memoryTypeCount {
        if bits & (@intCast(u32, 1) << @intCast(u5, index)) != 0 && properties.*.memoryTypes[index].propertyFlags & wanted == wanted { return index }
        index += 1
    }
    return 4294967295
}

fn createBuffer(device: vk.Device, commands: *const vk.DeviceCommands, memory_properties: *const vk.PhysicalDeviceMemoryProperties, buffer: *vk.Buffer, memory: *vk.DeviceMemory) -> bool {
    var info = vk.BufferCreateInfo.init()
    info.size = SIZE
    info.usage = vk.BUFFER_USAGE_TRANSFER_SRC_BIT | vk.BUFFER_USAGE_TRANSFER_DST_BIT
    info.sharingMode = vk.SharingMode.exclusive
    if vk.createBuffer(commands, device, &info, null, buffer) != vk.Result.success { return false }
    var requirements: vk.MemoryRequirements = undefined
    vk.getBufferMemoryRequirements(commands, device, buffer.*, &requirements)
    var allocation = vk.MemoryAllocateInfo.init()
    allocation.allocationSize = requirements.size
    allocation.memoryTypeIndex = findMemoryType(memory_properties, requirements.memoryTypeBits, vk.MEMORY_PROPERTY_HOST_VISIBLE_BIT | vk.MEMORY_PROPERTY_HOST_COHERENT_BIT)
    if allocation.memoryTypeIndex == 4294967295 { return false }
    if vk.allocateMemory(commands, device, &allocation, null, memory) != vk.Result.success { return false }
    return vk.bindBufferMemory(commands, device, buffer.*, memory.*, 0) == vk.Result.success
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var driver: loader.Driver = undefined
    if loader.openFirstDriver(&driver, arguments, allocator) != loader.Status.ok { return 1 }
    if driver.interfaceVersion < loader.MINIMUM_INTERFACE_VERSION { return 2 }

    var application = vk.ApplicationInfo.init()
    application.apiVersion = vk.API_VERSION_1_1
    var instance_info = vk.InstanceCreateInfo.init()
    instance_info.pApplicationInfo = &application
    var instance: vk.Instance = 0
    if vk.createInstance(driver.global, &instance_info, null, &instance) != vk.Result.success { return 3 }
    var instance_commands: vk.InstanceCommands = undefined
    vk.loadInstanceCommands(&instance_commands, instance, driver.getInstanceProcAddr)
    if instance_commands.vkGetDeviceProcAddr == 0 { return 4 }

    var device_count: u32 = 1
    var physical: vk.PhysicalDevice = 0
    const listed = vk.enumeratePhysicalDevices(&instance_commands, instance, &device_count, &physical)
    if (listed != vk.Result.success && listed != vk.Result.incomplete) || device_count == 0 { return 5 }
    var memory_properties: vk.PhysicalDeviceMemoryProperties = undefined
    vk.getPhysicalDeviceMemoryProperties(&instance_commands, physical, &memory_properties)

    // A queue family with transfer support (every graphics or compute family has it).
    var families: [8]vk.QueueFamilyProperties = undefined
    var family_count: u32 = 8
    unsafe { vk.getPhysicalDeviceQueueFamilyProperties(&instance_commands, physical, &family_count, @ptrCast([*]vk.QueueFamilyProperties, &families)) }
    var family: u32 = 0
    while family < family_count && families[family].queueFlags & (vk.QUEUE_GRAPHICS_BIT | vk.QUEUE_COMPUTE_BIT | vk.QUEUE_TRANSFER_BIT) == 0 { family += 1 }
    if family == family_count { return 6 }

    var queue_info = vk.DeviceQueueCreateInfo.init()
    queue_info.queueFamilyIndex = family
    queue_info.queueCount = 1
    // 1.0 as an f32 bit pattern.
    var priority: u32 = 1065353216
    unsafe { queue_info.pQueuePriorities = @ptrCast([*]const f32, &priority) }
    var device_info = vk.DeviceCreateInfo.init()
    device_info.queueCreateInfoCount = 1
    device_info.pQueueCreateInfos = &queue_info
    var device: vk.Device = 0
    if vk.createDevice(&instance_commands, physical, &device_info, null, &device) != vk.Result.success { return 7 }
    var commands: vk.DeviceCommands = undefined
    vk.loadDeviceCommands(&commands, device, instance_commands.vkGetDeviceProcAddr)
    if commands.vkCmdCopyBuffer == 0 || commands.vkQueueSubmit == 0 { return 8 }
    var queue: vk.Queue = 0
    vk.getDeviceQueue(&commands, device, family, 0, &queue)

    var source: vk.Buffer = 0
    var source_memory: vk.DeviceMemory = 0
    var target: vk.Buffer = 0
    var target_memory: vk.DeviceMemory = 0
    if !createBuffer(device, &commands, &memory_properties, &source, &source_memory) { return 9 }
    if !createBuffer(device, &commands, &memory_properties, &target, &target_memory) { return 10 }

    var pool_info = vk.CommandPoolCreateInfo.init()
    pool_info.queueFamilyIndex = family
    var pool: vk.CommandPool = 0
    if vk.createCommandPool(&commands, device, &pool_info, null, &pool) != vk.Result.success { return 11 }
    var allocate = vk.CommandBufferAllocateInfo.init()
    allocate.commandPool = pool
    allocate.level = vk.CommandBufferLevel.primary
    allocate.commandBufferCount = 1
    var command_buffer: vk.CommandBuffer = 0
    if vk.allocateCommandBuffers(&commands, device, &allocate, &command_buffer) != vk.Result.success { return 12 }

    var begin = vk.CommandBufferBeginInfo.init()
    begin.flags = vk.COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT
    if vk.beginCommandBuffer(&commands, command_buffer, &begin) != vk.Result.success { return 14 }
    vk.cmdFillBuffer(&commands, command_buffer, source, 0, SIZE, 0xC0FFEE11)
    var barrier = vk.MemoryBarrier.init()
    barrier.srcAccessMask = vk.ACCESS_TRANSFER_WRITE_BIT
    barrier.dstAccessMask = vk.ACCESS_TRANSFER_READ_BIT
    vk.cmdPipelineBarrier(&commands, command_buffer, vk.PIPELINE_STAGE_TRANSFER_BIT, vk.PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &barrier, 0, null, 0, null)
    var region: vk.BufferCopy = undefined
    region.srcOffset = 0
    region.dstOffset = 16
    region.size = SIZE - 16
    vk.cmdCopyBuffer(&commands, command_buffer, source, target, 1, &region)
    if vk.endCommandBuffer(&commands, command_buffer) != vk.Result.success { return 15 }

    var fence_info = vk.FenceCreateInfo.init()
    var fence: vk.Fence = 0
    if vk.createFence(&commands, device, &fence_info, null, &fence) != vk.Result.success { return 16 }
    var submit = vk.SubmitInfo.init()
    submit.commandBufferCount = 1
    submit.pCommandBuffers = &command_buffer
    if vk.queueSubmit(&commands, queue, 1, &submit, fence) != vk.Result.success { return 17 }
    if vk.waitForFences(&commands, device, 1, &fence, vk.TRUE, 5000000000) != vk.Result.success { return 18 }
    if vk.getFenceStatus(&commands, device, fence) != vk.Result.success { return 19 }

    var mapped: ?*anyopaque = null
    if vk.mapMemory(&commands, device, target_memory, 0, SIZE, 0, &mapped) != vk.Result.success || mapped == null { return 20 }
    var words: [*]u32 = undefined
    unsafe { words = @ptrCast([*]u32, mapped.?) }
    // Bytes 0..16 were never written (zero-filled by lavapipe's allocation
    // is not guaranteed), so only check the copied range.
    if words[4] != 0xC0FFEE11 || words[1023] != 0xC0FFEE11 { return 21 }
    vk.unmapMemory(&commands, device, target_memory)

    vk.destroyFence(&commands, device, fence, null)
    vk.freeCommandBuffers(&commands, device, pool, 1, &command_buffer)
    vk.destroyCommandPool(&commands, device, pool, null)
    vk.destroyBuffer(&commands, device, source, null)
    vk.destroyBuffer(&commands, device, target, null)
    vk.freeMemory(&commands, device, source_memory, null)
    vk.freeMemory(&commands, device, target_memory, null)
    if vk.deviceWaitIdle(&commands, device) != vk.Result.success { return 22 }
    vk.destroyDevice(&commands, device, null)
    vk.destroyInstance(&instance_commands, instance, null)
    loader.closeDriver(&driver)
    return 13
}
