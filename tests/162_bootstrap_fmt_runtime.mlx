const bootstrap = @import("../std/bootstrap/root.mlx")

pub fn main() -> !void {
    const values = [8]bootstrap.fmt.Argument{
        bootstrap.fmt.string("mlx"),
        bootstrap.fmt.unsigned(42),
        bootstrap.fmt.unsigned(42),
        bootstrap.fmt.unsigned(42),
        bootstrap.fmt.unsigned(42),
        bootstrap.fmt.signed(-17),
        bootstrap.fmt.character(33),
        bootstrap.fmt.boolean(true),
    }
    try bootstrap.fmt.print(
        bootstrap.io.stdout(),
        "{{{s}}} d={d:05} x={x} X={X} b={b} n={d:4} {c} {s}\n",
        values[0..8],
    )
}
