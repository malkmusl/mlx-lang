// @floor, @ceil and @trunc round an f64 or f32 to a whole number in one
// instruction (roundsd/roundss on x86_64, FRINTM/FRINTP/FRINTZ on
// AArch64): halves, negatives, -0.0, values past 2^52 that are whole
// already and 1e300 come out exact. Exits 13 when every check holds, else
// the number of the first check that failed.
fn rounds(x: f64, down: f64, up: f64, zero: f64) -> bool {
    return @floor(x) == down && @ceil(x) == up && @trunc(x) == zero
}

pub fn main() -> u8 {
    if !rounds(2.5, 2.0, 3.0, 2.0) { return 1 }
    if !rounds(-2.5, -3.0, -2.0, -2.0) { return 2 }
    if !rounds(7.0, 7.0, 7.0, 7.0) { return 3 }
    if !rounds(-0.25, -1.0, 0.0, 0.0) { return 4 }
    const big: f64 = 1.0e300
    if !rounds(big, big, big, big) { return 5 }
    const odd: f64 = 4503599627370497.0
    if !rounds(odd, odd, odd, odd) { return 6 }
    // -0.25 rounded up keeps its sign: -0.0.
    if @bitCast(u64, @ceil(-0.25)) != 9223372036854775808 { return 7 }
    const half: f32 = -1.5
    const down: f32 = @floor(half)
    const up: f32 = @ceil(half)
    const zero: f32 = @trunc(half)
    if down != -2.0 || up != -1.0 || zero != -1.0 { return 8 }
    return 13
}
