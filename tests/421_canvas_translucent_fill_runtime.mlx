// A translucent fill mixes each pixel as `over` does: over pixels of many
// colours and over runs of one (where the fill reuses the pixel it mixed
// last), with red and blue swapped and not. Exits 13.
const canvas_module = @import("std.ui.canvas")

const WIDTH: usize = 64
const HEIGHT: usize = 8

fn swapped(color: u32) -> u32 { return (color & 4278255360) | ((color >> 16) & 255) | ((color & 255) << 16) }

// A premultiplied pixel from `seed`; every fourth row one colour.
fn pixelAt(seed: u32, row: usize, column: usize) -> u32 {
    if row % 4 == 3 { return 4282400832 }
    var x = seed ^ @intCast(u32, row * 977 + column * 131)
    x = x *% 2654435761
    x ^= x >> 13
    const alpha = (x >> 24) | 1
    const red = ((x >> 16) & 255) % (alpha + 1)
    const green = ((x >> 8) & 255) % (alpha + 1)
    const blue = (x & 255) % (alpha + 1)
    // (Runs of the same pixel: columns in pairs.)
    if column % 8 < 4 { return 2164260864 }
    return (alpha << 24) | (red << 16) | (green << 8) | blue
}

fn check(swap: bool, color: u32, base: u8) -> u8 {
    var pixels: [WIDTH * HEIGHT]u32 = undefined
    var expected: [WIDTH * HEIGHT]u32 = undefined
    var row: usize = 0
    while row < HEIGHT {
        var column: usize = 0
        while column < WIDTH {
            const under = pixelAt(color, row, column)
            pixels[row * WIDTH + column] = if swap { swapped(under) } else { under }
            const mixed = canvas_module.over(under, color, 255)
            expected[row * WIDTH + column] = if swap { swapped(mixed) } else { mixed }
            column += 1
        }
        row += 1
    }
    var address: [*]u32 = undefined
    unsafe { address = @ptrCast([*]u32, &pixels) }
    var canvas = canvas_module.Canvas.{ .pixels = address, .width = WIDTH, .height = HEIGHT, .stride = WIDTH, .swapRedBlue = swap, .device = 0, .opacity = 255 }
    canvas_module.fillRect(&canvas, 0, 0, @intCast(i32, WIDTH), @intCast(i32, HEIGHT), color)
    var at: usize = 0
    while at < WIDTH * HEIGHT {
        if pixels[at] != expected[at] { return base }
        at += 1
    }
    return 0
}

pub fn main() -> u8 {
    // A sidebar's tint (alpha 214), a faint one and a half one.
    const colors = [3]u32{ 3592822052, 285212689, 2147483648 }
    var index: usize = 0
    while index < 3 {
        const failed = check(false, colors[index], @intCast(u8, 1 + index * 2))
        if failed != 0 { return failed }
        const failedSwapped = check(true, colors[index], @intCast(u8, 2 + index * 2))
        if failedSwapped != 0 { return failedSwapped }
        index += 1
    }
    return 13
}
