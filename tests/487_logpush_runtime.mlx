// logpush (projects/brix/tools/logpush) built for the host, against
// servers of the test's own in child processes on the loopback, one
// without TLS (the settings' test endpoint) and one with (std.tls.server,
// a root and a certificate made here):
//
// - the settings read in every form: no file, an empty one, comments
//   alone, one line, CR LF, blanks around, a line break after the token
//   and none, an editor's mark at the start, the further lines, and what
//   is wrong with a text by its line's number, never by its words;
// - the names: dates from the clock, the boot's directory, the seconds
//   that tell two uploads apart, the ROM named by its bytes;
// - the requests byte for byte as the server got them: the path, every
//   header line, the JSON body with the base64 of a text and of bytes of
//   every value, a branch, a message with a quote in it; the three files
//   of a run in their order, the ROM and the log of the boot before
//   asked for first and left alone when they are there; a run tried
//   again leaves alone what the try before got through (the kernel log
//   is one file, however often the log of the boot before is tried);
// - the repository asked about before anything is uploaded: one that is
//   public, or of which the answer does not say that it is private, gets
//   nothing; one the token is not taken for, may not see or that is not
//   there is said so;
// - the answers: 201, 200, 401, 403, 404, 408, 409, 410 (an API version
//   GitHub no longer serves), 422, 429, 500, 301 (not
//   followed, to an upload or to the question about the repository), a
//   body that is no JSON, an answer cut off in its middle,
//   a connection that says nothing, what is no HTTP, nobody listening,
//   a name that is none;
// - TLS: an upload through it when the chain leads to a root given and
//   the name is the certificate's; nothing sent, and why said, when the
//   root is not trusted, the name is another's, the clock is not set or
//   the machine has no random numbers for a key; a test endpoint
//   without TLS takes a test's token only;
// - the token in no line the program can say: every line of every case
//   above searched for it and for each piece of eight of its bytes, with
//   servers that send it back, settings that have it on the wrong line,
//   and the lines' own filter tried on its own.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const std = @import("std")
const net = @import("std.net")
const x509 = @import("std.x509")
const tls_server = @import("std.tls.server")
const message = @import("std.http.message")
const certs = @import("../tools/http-test-server/certs.mlx")
const settings_module = @import("../projects/brix/tools/logpush/settings.mlx")
const line_module = @import("../projects/brix/tools/logpush/line.mlx")
const names = @import("../projects/brix/tools/logpush/names.mlx")
const request = @import("../projects/brix/tools/logpush/request.mlx")
const answer = @import("../projects/brix/tools/logpush/answer.mlx")
const upload = @import("../projects/brix/tools/logpush/upload.mlx")
const said = @import("../projects/brix/tools/logpush/said.mlx")
const machine = @import("../projects/brix/tools/logpush/machine.mlx")
const process = std.linux.process
const event = std.linux.event

const same = std.text.same
const Settings = settings_module.Settings
const Verdict = settings_module.Verdict
const Line = line_module.Line

// A test's token for the endpoint without TLS, and one that is no
// test's (made up: no token of any service looks like it).
const TEST_TOKEN: []const u8 = "test-0123456789abcdefghijklmnopqrstuvwxyz"
const OTHER_TOKEN: []const u8 = "ghx_NotARealToken-ABCDEFGHIJKLMNOPQRSTUVWXYZ-0123456789"

// The boot of the test's uploads: 2026-11-17T20:41:07Z, and 42.317
// seconds after it.
const BOOT: usize = 1794948067
const UPTIME: usize = 42317
const KLOG: []const u8 = "brixOS: the kernel\ngpu: one line\n"
const KLOG_BASE64: []const u8 = "YnJpeE9TOiB0aGUga2VybmVsCmdwdTogb25lIGxpbmUK"
// The base64 of the bytes 0 to 255, and the first 16 hex digits of their
// SHA-256 (worked out apart from this program).
const EVERY_BASE64: []const u8 = ""
const EVERY_DIGEST: []const u8 = "40aff2e9d2d8922e"

// ---------------------------------------------------------------------------
// A text put together.

const Text = struct {
    bytes: [16384]u8
    length: usize

    fn init(self: *Self) -> void { self.*.length = 0 }
    fn add(self: *Self, value: []const u8) -> void { self.*.length = std.text.append(&self.*.bytes, self.*.length, 16384, value) }
    fn number(self: *Self, value: usize) -> void { self.*.length = std.text.appendUnsigned(&self.*.bytes, self.*.length, 16384, value) }
    fn text(self: *const Self) -> []const u8 { return self.*.bytes[0..self.*.length] }
}

// Whether `text` has the token `token` in it, or any eight bytes of it
// that follow one another.
fn leaks(text: []const u8, token: []const u8) -> bool {
    const piece: usize = if token.length < 8 { token.length } else { 8 }
    if piece == 0 { return false }
    var from: usize = 0
    while from + piece <= token.length {
        if std.text.contains(text, token[from..from + piece]) { return true }
        from += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// The servers: each request written down for the test (into a pipe: its
// length in ten digits, then its bytes), then answered by what the
// repository's name in its path asks for.

var recordPipe: isize = -1 // (per run)

fn writeAll(fd: isize, bytes: []const u8) -> void {
    var done: usize = 0
    while done < bytes.length {
        const from: [*]const u8 = unsafe { bytes.pointer + done }
        const wrote = std.linux.write(fd, from, bytes.length - done)
        if wrote <= 0 { return }
        done += @bitCast(usize, wrote)
    }
}

fn record(bytes: []const u8) -> void {
    var head: [11]u8 = undefined
    var value = bytes.length
    var k: usize = 10
    while k > 0 {
        k -= 1
        head[k] = @intCast(u8, 48 + value % 10)
        value /= 10
    }
    head[10] = 10
    writeAll(recordPipe, head[0..11])
    writeAll(recordPipe, bytes)
}

const Connection = struct {
    fd: isize
    secure: bool
    server: *tls_server.Server
}

fn connectionSend(c: *Connection, bytes: []const u8) -> bool {
    if c.*.secure { return tls_server.send(c.*.server, bytes) }
    return net.send(c.*.fd, bytes)
}

fn connectionReceive(c: *Connection, into: [*]u8, room: usize) -> isize {
    if c.*.secure { return tls_server.receive(c.*.server, into, room) }
    if !net.readable(c.*.fd, 5000) { return -1 }
    return net.receive(c.*.fd, into, room)
}

// The repository's name in "/repos/OWNER/NAME/contents/...".
fn repositoryOf(target: []const u8) -> []const u8 {
    var slashes: usize = 0
    var start: usize = 0
    var k: usize = 0
    while k < target.length {
        if target[k] == 47 {
            slashes += 1
            if slashes == 3 { start = k + 1 }
            if slashes == 4 { return target[start..k] }
        }
        k += 1
    }
    return if slashes == 3 { target[start..target.length] } else { "" }
}

fn headerOf(head: []const u8, name: []const u8, folded: []u8, value: *[]const u8) -> bool {
    var it = message.headerLines(head)
    var n: []const u8 = ""
    var v: []const u8 = ""
    while message.nextHeader(&it, &n, &v, folded) {
        if n.length == name.length {
            var k: usize = 0
            var equal = true
            while k < n.length {
                const a = if n[k] >= 65 && n[k] <= 90 { n[k] + 32 } else { n[k] }
                const b = if name[k] >= 65 && name[k] <= 90 { name[k] + 32 } else { name[k] }
                if a != b { equal = false }
                k += 1
            }
            if equal {
                value.* = v
                return true
            }
        }
    }
    return false
}

var answerText: Text = undefined // (per run)

fn respond(c: *Connection, status: usize, phrase: []const u8, extra: []const u8, body: []const u8) -> bool {
    answerText.init()
    answerText.add("HTTP/1.1 ")
    answerText.number(status)
    answerText.add(" ")
    answerText.add(phrase)
    answerText.add("\r\nContent-Type: application/json; charset=utf-8\r\nContent-Length: ")
    answerText.number(body.length)
    answerText.add("\r\n")
    answerText.add(extra)
    answerText.add("\r\n")
    answerText.add(body)
    return connectionSend(c, answerText.text())
}

var requestBytes: [600000]u8 = undefined // (per run)

// The requests of one connection, each written down and answered.
fn serveConnection(c: *Connection) -> void {
    var folded: [4096]u8 = undefined
    const into: [*]u8 = &requestBytes
    var held: usize = 0
    while true {
        var headEnd: usize = 0
        var whole = false
        while !whole {
            const found = std.text.find(requestBytes[0..held], "\r\n\r\n")
            if found < held {
                headEnd = found + 4
                whole = true
            } else {
                // (A TLS handshake's first bytes where plain HTTP is
                // spoken: answered as an HTTP server answers what it
                // cannot read.)
                if held > 0 && requestBytes[0] == 22 && !c.*.secure {
                    _ = connectionSend(c, "HTTP/1.1 400 Bad Request\r\nConnection: close\r\n\r\n")
                    return
                }
                const more: [*]u8 = unsafe { into + held }
                const got = connectionReceive(c, more, 600000 - held)
                if got <= 0 { return }
                held += @intCast(usize, got)
            }
        }
        const head = requestBytes[0..headEnd]
        var line: message.RequestLine = undefined
        if !message.parseRequestLine(head, &line) { return }
        var bodyLength: usize = 0
        var value: []const u8 = ""
        if headerOf(head, "Content-Length", folded[0..4096], &value) {
            for digit in value { bodyLength = bodyLength * 10 + @intCast(usize, digit - 48) }
        }
        while held < headEnd + bodyLength {
            const more: [*]u8 = unsafe { into + held }
            const got = connectionReceive(c, more, 600000 - held)
            if got <= 0 { return }
            held += @intCast(usize, got)
        }
        record(requestBytes[0..headEnd + bodyLength])
        const repository = repositoryOf(line.target)
        const getting = same(line.method, "GET")
        var keep = true
        if !std.text.contains(line.target, "/contents/") {
            // The repository itself is asked about ("Get a repository").
            if same(repository, "unauthorized") {
                keep = respond(c, 401, "Unauthorized", "", "{\"message\":\"Bad credentials\",\"documentation_url\":\"https://docs.github.com/rest\",\"status\":\"401\"}")
            } else if same(repository, "forbidden") {
                keep = respond(c, 403, "Forbidden", "", "{\"message\":\"Resource not accessible by personal access token\"}")
            } else if same(repository, "missing") {
                keep = respond(c, 404, "Not Found", "", "{\"message\":\"Not Found\"}")
            } else if same(repository, "busy") {
                keep = respond(c, 503, "Service Unavailable", "", "<html>later</html>")
            } else if same(repository, "public") {
                keep = respond(c, 200, "OK", "", "{\"id\":1,\"full_name\":\"o/public\",\"private\":false,\"visibility\":\"public\"}")
            } else if same(repository, "unsaid") {
                // (An owner's record has a "private" of its own: not the
                // repository's.)
                keep = respond(c, 200, "OK", "", "{\"id\":1,\"full_name\":\"o/unsaid\",\"owner\":{\"login\":\"o\",\"private\":true}}")
            } else if same(repository, "movedrepo") {
                // (Where a renamed repository's question is sent on to:
                // a client that followed would take the token there.)
                keep = respond(c, 301, "Moved Permanently", "Location: /repos/o/stolen\r\n", "{\"message\":\"Moved Permanently\",\"url\":\"https://api.github.com/repositories/1\"}")
            } else if same(repository, "echorepo") {
                var sent: []const u8 = ""
                _ = headerOf(head, "Authorization", folded[0..4096], &sent)
                var words: Text = undefined
                words.init()
                words.add("{\"message\":\"no: ")
                words.add(sent)
                words.add("\"}")
                keep = respond(c, 403, "Forbidden", "", words.text())
            } else {
                var record_: Text = undefined
                record_.init()
                record_.add("{\"id\":1,\"owner\":{\"login\":\"o\",\"private\":false},\"full_name\":\"o/")
                record_.add(repository)
                record_.add("\",\"private\":true,\"visibility\":\"private\"}")
                keep = respond(c, 200, "OK", "", record_.text())
            }
        } else if same(repository, "created") || same(repository, "fresh") {
            if !getting {
                keep = respond(c, 201, "Created", "", "{\"content\":{\"name\":\"a file\",\"sha\":\"95b966ae1c166bd92f8ae7d1c313e738c731dfc3\"},\"commit\":{\"message\":\"made\"}}")
            } else if same(repository, "created") && std.text.contains(line.target, "gpu-rom-") {
                keep = respond(c, 200, "OK", "", "{\"name\":\"the rom\",\"sha\":\"0123\"}")
            } else {
                keep = respond(c, 404, "Not Found", "", "{\"message\":\"Not Found\",\"documentation_url\":\"https://docs.github.com/rest\",\"status\":\"404\"}")
            }
        } else if same(repository, "prevbroken") || same(repository, "prevtaken") {
            // The kernel log is taken; the log of the boot before is not
            // there, and its upload fails (GitHub's side) or is refused.
            if getting {
                keep = respond(c, 404, "Not Found", "", "{\"message\":\"Not Found\"}")
            } else if !std.text.contains(line.target, "previous-boot-klog") {
                keep = respond(c, 201, "Created", "", "{\"content\":{}}")
            } else if same(repository, "prevbroken") {
                keep = respond(c, 500, "Internal Server Error", "", "<html>Server Error</html>")
            } else {
                keep = respond(c, 422, "Unprocessable Entity", "", "{\"message\":\"Invalid request.\\n\\n\\\"sha\\\" wasn't supplied.\"}")
            }
        } else if same(repository, "replaced") {
            keep = respond(c, 200, "OK", "", "{\"content\":{}}")
        } else if same(repository, "taken") {
            // The name of the test's own millisecond is taken, as when
            // another upload of the boot got there first.
            if std.text.contains(line.target, "klog-0000042.317s.txt") {
                keep = respond(c, 422, "Unprocessable Entity", "", "{\"message\":\"Invalid request.\\n\\n\\\"sha\\\" wasn't supplied.\"}")
            } else {
                keep = respond(c, 201, "Created", "", "{\"content\":{}}")
            }
        } else if same(repository, "unauthorized") {
            keep = respond(c, 401, "Unauthorized", "", "{\"message\":\"Bad credentials\",\"documentation_url\":\"https://docs.github.com/rest\",\"status\":\"401\"}")
        } else if same(repository, "forbidden") {
            keep = respond(c, 403, "Forbidden", "", "{\"message\":\"Resource not accessible by personal access token\"}")
        } else if same(repository, "missing") {
            keep = respond(c, 404, "Not Found", "", "{\"message\":\"Not Found\"}")
        } else if same(repository, "conflict") {
            keep = respond(c, 409, "Conflict", "", "{\"message\":\"is at 1234 but expected 5678\"}")
        } else if same(repository, "unprocessable") {
            keep = respond(c, 422, "Unprocessable Entity", "", "{\"message\":\"Invalid request.\\n\\n\\\"sha\\\" wasn't supplied.\"}")
        } else if same(repository, "limited") {
            keep = respond(c, 429, "Too Many Requests", "", "{\"message\":\"slow down\"}")
        } else if same(repository, "broken") {
            keep = respond(c, 500, "Internal Server Error", "", "<html>Server Error</html>")
        } else if same(repository, "notjson") {
            keep = respond(c, 201, "Created", "", "made, and this is no JSON")
        } else if same(repository, "halfjson") {
            keep = respond(c, 401, "Unauthorized", "", "{\"message\":\"Bad cred")
        } else if same(repository, "echo") {
            // A server that says the token back, whole and in pieces.
            var authorization: []const u8 = ""
            _ = headerOf(head, "Authorization", folded[0..4096], &authorization)
            var body: Text = undefined
            body.init()
            body.add("{\"message\":\"you sent ")
            body.add(authorization)
            body.add(" and its end is ")
            if authorization.length > 12 { body.add(authorization[authorization.length - 12..authorization.length]) }
            body.add("\"}")
            keep = respond(c, 401, "Unauthorized", "", body.text())
        } else if same(repository, "moved") {
            keep = respond(c, 301, "Moved Permanently", "Location: /repos/o/stolen/contents/elsewhere\r\n", "{\"message\":\"Moved Permanently\",\"url\":\"https://api.github.com/repositories/1\"}")
        } else if same(repository, "cut") {
            _ = connectionSend(c, "HTTP/1.1 201 Created\r\nContent-Length: 500\r\n\r\n{\"content\"")
            return
        } else if same(repository, "silent") {
            return
        } else if same(repository, "garbage") {
            _ = connectionSend(c, "this is not what was asked for\r\n\r\n")
            return
        } else {
            keep = respond(c, 404, "Not Found", "", "{\"message\":\"Not Found\"}")
        }
        if !keep { return }
        const used = headEnd + bodyLength
        var k: usize = 0
        while used + k < held {
            requestBytes[k] = requestBytes[used + k]
            k += 1
        }
        held -= used
    }
}

// The server's loop: `secure`, each connection through a TLS handshake
// with `chain` first (one that fails is written down as "!handshake").
fn serve(listener: isize, secure: bool, chain: [*]const tls_server.Certificate, seed: [*]const u8) -> void {
    while true {
        var peer: net.Address = undefined
        const fd = net.accept(listener, &peer)
        if fd < 0 { return }
        var server: tls_server.Server = undefined
        var c = Connection.{ .fd = fd, .secure = secure, .server = &server }
        if !secure || tls_server.accept(&server, fd, chain, 1, seed) {
            serveConnection(&c)
            if secure { tls_server.close(&server) }
        } else {
            record("!handshake")
        }
        net.close(fd)
    }
}

// ---------------------------------------------------------------------------
// What the test takes from the servers and from logpush.

var readEnd: isize = -1 // (per run)
// How many of a run's first requests the counts and indices below pass
// over: the one about the repository, where a run got that far.
var skip: usize = 0 // (per run)
var recorded: [600000]u8 = undefined // (per run)
var recordedLength: usize = 0 // (per run)

// What the servers wrote down since the last call, `count` requests of
// it (waited for two seconds at most; what comes after them within a
// moment is taken too, so that a request too many shows).
fn takeRecords(uploads: usize) -> void {
    const count = uploads + skip
    recordedLength = 0
    var seen: usize = 0
    var parsed: usize = 0
    var waits: usize = 0
    while true {
        // The whole records there are.
        while parsed + 11 <= recordedLength {
            var length: usize = 0
            var k: usize = 0
            while k < 10 {
                length = length * 10 + @intCast(usize, recorded[parsed + k] - 48)
                k += 1
            }
            if parsed + 11 + length > recordedLength { break }
            parsed += 11 + length
            seen += 1
        }
        const patience: isize = if seen >= count && parsed == recordedLength { 60 } else { 100 }
        if event.waitReady(readEnd, false, patience) <= 0 {
            waits += 1
            if (seen >= count && parsed == recordedLength) || waits > 20 { return }
            continue
        }
        const room: [*]u8 = unsafe { @ptrFromInt([*]u8, @intFromPtr(&recorded) + recordedLength) }
        const got = std.linux.read(readEnd, room, 600000 - recordedLength)
        if got <= 0 { return }
        recordedLength += @bitCast(usize, got)
    }
}

// How many requests were written down after the one about the
// repository, and the `index`th of them.
fn recordCount() -> usize {
    const all = allRecords()
    return if all < skip { 0 } else { all - skip }
}

fn recordAt(index: usize) -> []const u8 { return anyRecord(index + skip) }

fn allRecords() -> usize {
    var at: usize = 0
    var count: usize = 0
    while at + 11 <= recordedLength {
        var length: usize = 0
        var k: usize = 0
        while k < 10 {
            length = length * 10 + @intCast(usize, recorded[at + k] - 48)
            k += 1
        }
        at += 11 + length
        count += 1
    }
    return count
}

fn anyRecord(index: usize) -> []const u8 {
    var at: usize = 0
    var count: usize = 0
    while at + 11 <= recordedLength {
        var length: usize = 0
        var k: usize = 0
        while k < 10 {
            length = length * 10 + @intCast(usize, recorded[at + k] - 48)
            k += 1
        }
        if count == index { return recorded[at + 11..at + 11 + length] }
        at += 11 + length
        count += 1
    }
    return ""
}

// The lines logpush said, one after the other with a line's end each.
var lines: Text = undefined // (per run)
var lineCount: usize = 0 // (per run)

fn takeLine(context: usize, line: []const u8) -> void {
    _ = context
    lines.add(line)
    lines.add("\n")
    lineCount += 1
}

var out: line_module.Out = undefined // (per run)
var settings: Settings = undefined // (per run)
// What the upload under way got through (a case's first run: nothing).
var went: upload.Went = undefined // (per run)
var noTrouble: upload.Trouble = upload.Trouble.none // (per run)

fn trouble() -> upload.Trouble { return noTrouble }

// The settings of a test: the repository o/NAME, `token`, and `more`
// (the line that names the server).
var settingsText: Text = undefined // (per run)

fn configure(name: []const u8, token: []const u8, more: []const u8) -> bool {
    settingsText.init()
    settingsText.add("o/")
    settingsText.add(name)
    settingsText.add("\n")
    settingsText.add(token)
    settingsText.add("\n")
    settingsText.add(more)
    settingsText.add("\n")
    settings_module.parse(settingsText.text(), &settings)
    out.token = settings.tokenText()
    lines.init()
    lineCount = 0
    skip = 1
    went.nothing()
    return settings.verdict == Verdict.ok
}

// One run of logpush with the settings as they are.
fn runWith(klog: []const u8, previous: []const u8, rom: []const u8, now: usize, randomFit: bool, roots: ?*x509.TrustStore) -> upload.Result {
    const r = upload.Run.{ .settings = &settings, .klog = klog, .previous = previous, .previousFrom = "boot.previous.log of disk0", .rom = rom, .now = now, .boot = BOOT, .uptime = UPTIME, .randomFit = randomFit, .trouble = trouble, .out = &out, .timeoutMs = 5000, .roots = roots, .went = &went }
    return upload.run(&r)
}

fn run(klog: []const u8, previous: []const u8, rom: []const u8) -> upload.Result { return runWith(klog, previous, rom, BOOT + 42, true, null) }

// The request logpush is to send: `method` for `path` of the repository
// o/NAME at `host`, with `token`, and `body` when it sends one.
var expected: Text = undefined // (per run)

fn expect(method: []const u8, name: []const u8, path: []const u8, host: []const u8, token: []const u8, body: []const u8) -> []const u8 {
    expected.init()
    expected.add(method)
    expected.add(" /repos/o/")
    expected.add(name)
    if path.length > 0 { expected.add("/contents/") }
    expected.add(path)
    expected.add(" HTTP/1.1\r\nHost: ")
    expected.add(host)
    expected.add("\r\nAccept-Encoding: gzip, deflate\r\nConnection: keep-alive\r\n")
    if body.length > 0 {
        expected.add("Content-Length: ")
        expected.number(body.length)
        expected.add("\r\n")
    }
    expected.add("User-Agent: brix-logpush\r\nAccept: application/vnd.github+json\r\nAuthorization: Bearer ")
    expected.add(token)
    expected.add("\r\nX-GitHub-Api-Version: 2022-11-28\r\n")
    if body.length > 0 { expected.add("Content-Type: application/json\r\n") }
    expected.add("\r\n")
    expected.add(body)
    return expected.text()
}

var endpoint: Text = undefined // (per run)
var host: Text = undefined // (per run)

// "KIND 127.0.0.1:PORT" for a settings line, and the host part alone in
// `host`.
fn endpointLine(kind: []const u8, address: []const u8, port: usize) -> []const u8 {
    host.init()
    host.add(address)
    host.add(":")
    host.number(port)
    endpoint.init()
    endpoint.add(kind)
    endpoint.add(host.text())
    return endpoint.text()
}

// A case that fails with one line: the run's result, that line, the
// requests written down (`requests` after the one about the repository;
// `first`: it is that one which fails), and the token in nothing said.
var wanted: Text = undefined // (per run)

fn fails(name: []const u8, port: usize, result: upload.Result, text: []const u8, requests: usize, first: bool) -> bool {
    if !configure(name, TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", port)) { return false }
    if run(KLOG, "", "") != result { return false }
    takeRecords(requests)
    if !same(anyRecord(0), expect("GET", name, "", host.text(), TEST_TOKEN, "")) { return false }
    wanted.init()
    wanted.add(if first { "logpush: nothing was uploaded: " } else { "logpush: the kernel log was not uploaded: " })
    wanted.add(text)
    wanted.add("\n")
    return lineCount == 1 && same(lines.text(), wanted.text()) && recordCount() == requests && !leaks(lines.text(), TEST_TOKEN)
}

fn parsed(text: []const u8) -> Verdict {
    settings_module.parse(text, &settings)
    return settings.verdict
}

// `text` `count` times at the end of `into`.
fn repeated(into: *Text, text: []const u8, count: usize) -> void {
    var k: usize = 0
    while k < count {
        into.add(text)
        k += 1
    }
}

var scratch: Line = undefined // (per run)

fn stamped(seconds: usize, time: bool, text: []const u8) -> bool {
    scratch.init()
    names.stamp(&scratch, seconds, time)
    return same(scratch.text(), text)
}

var everyByte: [256]u8 = undefined // (per run)
var bigLog: [262144]u8 = undefined // (per run)

pub fn main() -> u8 {
    out.context = 0
    out.write = takeLine
    out.token = ""
    var k: usize = 0
    while k < 256 {
        everyByte[k] = @intCast(u8, k)
        k += 1
    }

    // ---- The settings ----
    // Nothing that says anything: empty, blanks, comments.
    if parsed("") != Verdict.empty || parsed("\n\n") != Verdict.empty || parsed("   \r\n\t\n# nothing here\n") != Verdict.empty { return 1 }
    // The repository alone.
    if parsed("owner/logs") != Verdict.noToken || parsed("owner/logs\n") != Verdict.noToken || parsed("owner/logs\n# the token comes later\n") != Verdict.noToken { return 2 }
    // Two lines: with and without a line break after the token, CR LF,
    // blanks around, empty lines and comments between, an editor's mark.
    if parsed("owner/logs\nabc_DEF-123") != Verdict.ok || !same(settings.repositoryText(), "owner/logs") || !same(settings.tokenText(), "abc_DEF-123") { return 3 }
    if parsed("owner/logs\nabc_DEF-123\n") != Verdict.ok || !same(settings.tokenText(), "abc_DEF-123") { return 4 }
    if parsed("owner/logs\r\nabc_DEF-123\r\n") != Verdict.ok || !same(settings.repositoryText(), "owner/logs") || !same(settings.tokenText(), "abc_DEF-123") { return 5 }
    if parsed("  owner/logs \t\n\tabc_DEF-123  \n\n\n") != Verdict.ok || !same(settings.repositoryText(), "owner/logs") || !same(settings.tokenText(), "abc_DEF-123") { return 6 }
    if parsed("# where the logs go\n\nowner/logs\n\n# its token\nabc_DEF-123\n") != Verdict.ok || !same(settings.tokenText(), "abc_DEF-123") { return 7 }
    if parsed("\xEF\xBB\xBFowner/logs\nabc_DEF-123\n") != Verdict.ok || !same(settings.repositoryText(), "owner/logs") { return 8 }
    // What is left as it is without further lines.
    if settings.again != 120 || !same(settings.machineText(), "brix") || settings.branchLength != 0 || !same(settings.apiText(), "https://api.github.com") || settings.plain || !same(settings.hostText(), "api.github.com") || !same(settings.hostName(), "api.github.com") { return 9 }
    // The further lines.
    if parsed("owner/logs\nabc\nmachine h11-epyc\nbranch boots/2026\napi https://github.example.org:8443/api/v3/\n") != Verdict.ok { return 10 }
    if !same(settings.machineText(), "h11-epyc") || !same(settings.branchText(), "boots/2026") || !same(settings.apiText(), "https://github.example.org:8443/api/v3") || settings.plain || !same(settings.hostText(), "github.example.org:8443") || !same(settings.hostName(), "github.example.org") { return 11 }
    if parsed("owner/logs\ntest-abc\r\ntest-endpoint http://10.0.2.2:8123\r\n") != Verdict.ok || !settings.plain || !same(settings.apiText(), "http://10.0.2.2:8123") || !same(settings.hostText(), "10.0.2.2:8123") { return 12 }
    // A repository that is none, by its line's number.
    if parsed("ownerlogs\nabc\n") != Verdict.badRepository || settings.line != 1 || parsed("\n\nowner/logs/more\nabc\n") != Verdict.badRepository || settings.line != 3 { return 14 }
    if parsed("/logs\nabc") != Verdict.badRepository || parsed("owner/\nabc") != Verdict.badRepository || parsed("owner/..\nabc") != Verdict.badRepository || parsed("own er/logs\nabc") != Verdict.badRepository || parsed("owner/lo?gs\nabc") != Verdict.badRepository || parsed("https://github.com/owner/logs\nabc") != Verdict.badRepository { return 15 }
    // A token that is none: a blank in it, a quote, a backslash, a
    // control character, a byte that is not ASCII, 256 bytes.
    if parsed("owner/logs\nabc def\n") != Verdict.badToken || settings.line != 2 || parsed("owner/logs\nabc\"def") != Verdict.badToken || parsed("owner/logs\nabc\\def") != Verdict.badToken || parsed("owner/logs\nabc\x01def") != Verdict.badToken || parsed("owner/logs\nabc\xC3\xA4") != Verdict.badToken { return 16 }
    var long: Text = undefined
    long.init()
    long.add("owner/logs\n")
    k = 0
    while k < 255 {
        long.add("t")
        k += 1
    }
    if parsed(long.text()) != Verdict.ok || settings.tokenLength != 255 { return 17 }
    long.add("t")
    if parsed(long.text()) != Verdict.badToken { return 18 }
    // Further lines that are none, by their number.
    if parsed("owner/logs\nabc\nmachine\n") != Verdict.badLine || settings.line != 3 || parsed("owner/logs\nabc\n\nmachine a/b\n") != Verdict.badLine || settings.line != 4 { return 19 }
    if parsed("owner/logs\nabc\nmachine ..\n") != Verdict.badLine || parsed("owner/logs\nabc\nbranch a//b\n") != Verdict.badLine || parsed("owner/logs\nabc\nbranch ../x\n") != Verdict.badLine || parsed("owner/logs\nabc\nsomething else\n") != Verdict.badLine { return 20 }
    // When the service uploads a second time: seconds, none, not less
    // than ten nor more than a day, a number alone.
    if parsed("owner/logs\nabc\nagain 15\n") != Verdict.ok || settings.again != 15 || parsed("owner/logs\nabc\nagain 0\n") != Verdict.ok || settings.again != 0 || parsed("owner/logs\nabc\nagain 86400\n") != Verdict.ok || settings.again != 86400 { return 142 }
    if parsed("owner/logs\nabc\nagain 9\n") != Verdict.badLine || parsed("owner/logs\nabc\nagain 86401\n") != Verdict.badLine || parsed("owner/logs\nabc\nagain soon\n") != Verdict.badLine || parsed("owner/logs\nabc\nagain 15 s\n") != Verdict.badLine || parsed("owner/logs\nabc\nagain 999999\n") != Verdict.badLine { return 143 }
    // The API's address: https for `api`, http for a test endpoint, no
    // other scheme, no name and password, no query, a port that is one.
    if parsed("owner/logs\nabc\napi http://github.example.org\n") != Verdict.badLine || parsed("owner/logs\ntest-abc\ntest-endpoint https://10.0.2.2:1\n") != Verdict.badLine || parsed("owner/logs\nabc\napi https://user:secret@host\n") != Verdict.badLine || parsed("owner/logs\nabc\napi https://host/path?x=1\n") != Verdict.badLine { return 21 }
    if parsed("owner/logs\nabc\napi https://host:0\n") != Verdict.badLine || parsed("owner/logs\nabc\napi https://host:65536\n") != Verdict.badLine || parsed("owner/logs\nabc\napi https://\n") != Verdict.badLine || parsed("owner/logs\nabc\napi https://host/../x\n") != Verdict.badLine || parsed("owner/logs\nabc\napi https://host x\n") != Verdict.badLine { return 22 }
    // A test endpoint without TLS takes a test's token only.
    if parsed("owner/logs\nabc\ntest-endpoint http://10.0.2.2:8123\n") != Verdict.testToken || parsed("owner/logs\ngithub_pat_abc\ntest-endpoint http://10.0.2.2:8123\n") != Verdict.testToken || parsed("owner/logs\nTEST-abc\ntest-endpoint http://10.0.2.2:8123\n") != Verdict.testToken { return 23 }
    // (And an `api` line after it is TLS again, with any token.)
    if parsed("owner/logs\nabc\ntest-endpoint http://10.0.2.2:8123\napi https://github.example.org\n") != Verdict.ok || settings.plain { return 24 }
    // GitHub's lengths: an owner of 39 bytes at most, a repository's name
    // of 100.
    long.init()
    repeated(&long, "o", 39)
    long.add("/logs\nabc\n")
    if parsed(long.text()) != Verdict.ok { return 169 }
    long.init()
    repeated(&long, "o", 40)
    long.add("/logs\nabc\n")
    if parsed(long.text()) != Verdict.badRepository { return 169 }
    long.init()
    long.add("owner/")
    repeated(&long, "n", 100)
    long.add("\nabc\n")
    if parsed(long.text()) != Verdict.ok { return 169 }
    long.init()
    long.add("owner/")
    repeated(&long, "n", 101)
    long.add("\nabc\n")
    if parsed(long.text()) != Verdict.badRepository { return 169 }
    // A tab between a further line's word and what it sets, as a blank.
    if parsed("owner/logs\nabc\nmachine\ttower\nagain\t30\n") != Verdict.ok || !same(settings.machineText(), "tower") || settings.again != 30 { return 170 }
    // What each answer means: tried again for GitHub's side, a limit, a
    // change at the same moment and a request that took too long; not for
    // what will not pass by waiting.
    if answer.verdict(201, false) != answer.Verdict.done || answer.verdict(200, true) != answer.Verdict.done || answer.verdict(404, true) != answer.Verdict.absent || answer.verdict(404, false) != answer.Verdict.stop { return 171 }
    if answer.verdict(408, false) != answer.Verdict.again || answer.verdict(409, false) != answer.Verdict.again || answer.verdict(429, false) != answer.Verdict.again || answer.verdict(500, false) != answer.Verdict.again || answer.verdict(503, true) != answer.Verdict.again { return 171 }
    if answer.verdict(401, false) != answer.Verdict.stop || answer.verdict(403, true) != answer.Verdict.stop || answer.verdict(422, false) != answer.Verdict.stop || answer.verdict(301, false) != answer.Verdict.stop { return 171 }
    // A server's words longer than what is said of them end in "...".
    var cut: Line = undefined
    cut.init()
    cut.foreign("abcdef", 3)
    if !same(cut.text(), "abc...") { return 172 }
    cut.init()
    cut.foreign("abc", 3)
    if !same(cut.text(), "abc") { return 172 }
    // What logpush reads of the machine is never cut: the kernel keeps
    // 256 KiB of its log (kernel/console.mlx), and a video BIOS ROM is
    // 255 blocks of 512 bytes at most (kernel/gpu_rom.mlx's ROOM).
    if machine.LOG_CAPACITY < 1 << 18 || machine.ROM_CAPACITY < 255 * 512 { return 173 }
    // GitHub's 410 to an API version it no longer serves (2022-11-28 from
    // 2028-03-10 on): said as that, not tried again.
    cut.init()
    answer.reason(&cut, 410, "{\"message\":\"API version 2022-11-28 is not supported\"}", "owner/logs")
    if !same(cut.text(), "410: GitHub no longer takes the API version this logpush speaks (2022-11-28): an image with a newer logpush is needed; GitHub: \"API version 2022-11-28 is not supported\"") || answer.verdict(410, false) != answer.Verdict.stop { return 174 }

    // The settings' file: none, one, one that is too long.
    var path: Text = undefined
    path.init()
    path.add("/tmp/logpush-487-")
    path.number(std.process.id())
    path.add(".settings\x00")
    const pathPointer: [*]const u8 = &path.bytes
    if settings_module.load(pathPointer, &settings) != settings_module.Read.missing { return 25 }
    const fileText = "owner/logs\r\nabc_DEF-123\r\nmachine tower\r\n"
    if !std.fs.writeFile(pathPointer, fileText.pointer, fileText.length, 0x180) { return 26 }
    if settings_module.load(pathPointer, &settings) != settings_module.Read.ok || settings.verdict != Verdict.ok || !same(settings.tokenText(), "abc_DEF-123") || !same(settings.machineText(), "tower") { return 27 }
    // (A file nobody may read: where this test is not root, who reads
    // everything.)
    if std.process.userId() != 0 {
        if !std.fs.writeFile(pathPointer, fileText.pointer, fileText.length, 0x180) || std.linux.syscall2(90, @intFromPtr(pathPointer), 0) != 0 { return 28 }
        if settings_module.load(pathPointer, &settings) != settings_module.Read.denied { return 28 }
        _ = std.fs.delete(pathPointer)
    }
    k = 0
    while k < 5000 {
        bigLog[k] = 35
        k += 1
    }
    _ = std.fs.delete(pathPointer)
    if !std.fs.writeFile(pathPointer, &bigLog, 5000, 0x180) { return 29 }
    if settings_module.load(pathPointer, &settings) != settings_module.Read.unreadable { return 30 }
    _ = std.fs.delete(pathPointer)
    // The token is forgotten when asked.
    _ = parsed("owner/logs\nabc_DEF-123\n")
    settings.forget()
    if settings.tokenLength != 0 || settings.token[0] != 0 || settings.token[10] != 0 { return 31 }

    // ---- The names ----
    if !stamped(0, true, "1970-01-01T00-00-00Z") || !stamped(BOOT, true, "2026-11-17T20-41-07Z") || !stamped(951868799, true, "2000-02-29T23-59-59Z") || !stamped(1709251200, true, "2024-03-01T00-00-00Z") || !stamped(4102401601, true, "2099-12-31T12-00-01Z") || !stamped(BOOT, false, "2026-11-17") { return 32 }
    if names.clockSet(0) || names.clockSet(951868799) || names.clockSet(1767225599) || !names.clockSet(1767225600) || !names.clockSet(BOOT) { return 33 }
    scratch.init()
    names.klog(&scratch, "brix", BOOT, UPTIME)
    if !same(scratch.text(), "brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt") { return 34 }
    scratch.init()
    names.klog(&scratch, "h11-epyc", BOOT, 12345678009)
    if !same(scratch.text(), "h11-epyc/2026-11-17T20-41-07Z/klog-12345678.009s.txt") { return 35 }
    scratch.init()
    names.previous(&scratch, "brix", BOOT)
    if !same(scratch.text(), "brix/2026-11-17T20-41-07Z/previous-boot-klog.txt") { return 36 }
    scratch.init()
    names.rom(&scratch, "brix", everyByte[0..256])
    if !same(scratch.text(), "brix/gpu-rom-40aff2e9d2d8922e.rom") { return 37 }
    // (Another ROM, another name; the same bytes, the same name.)
    everyByte[7] = 8
    scratch.init()
    names.rom(&scratch, "brix", everyByte[0..256])
    if same(scratch.text(), "brix/gpu-rom-40aff2e9d2d8922e.rom") { return 38 }
    everyByte[7] = 7

    // ---- A request's parts ----
    var url: [request.URL]u8 = undefined
    var n = request.url(&url, "https://api.github.com", "owner/logs", "brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt")
    if !same(url[0..n], "https://api.github.com/repos/owner/logs/contents/brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt") { return 39 }
    var headers: [request.HEADERS]u8 = undefined
    n = request.headers(&headers, "abc_DEF-123", true)
    if !same(headers[0..n], "User-Agent: brix-logpush\r\nAccept: application/vnd.github+json\r\nAuthorization: Bearer abc_DEF-123\r\nX-GitHub-Api-Version: 2022-11-28\r\nContent-Type: application/json\r\n") { return 40 }
    n = request.headers(&headers, "abc_DEF-123", false)
    if !same(headers[0..n], "User-Agent: brix-logpush\r\nAccept: application/vnd.github+json\r\nAuthorization: Bearer abc_DEF-123\r\nX-GitHub-Api-Version: 2022-11-28\r\n") { return 41 }
    var body: request.Body = undefined
    body.init()
    if !body.make("the log", KLOG, "") || !same(body.text(), "{\"message\":\"the log\",\"content\":\"YnJpeE9TOiB0aGUga2VybmVsCmdwdTogb25lIGxpbmUK\"}") { return 42 }
    // Bytes of every value; one, two and three bytes (the padding).
    var whole: Text = undefined
    whole.init()
    whole.add("{\"message\":\"m\",\"content\":\"")
    whole.add(EVERY_BASE64)
    whole.add("\"}")
    if !body.make("m", everyByte[0..256], "") || !same(body.text(), whole.text()) { return 43 }
    if !body.make("m", "a", "") || !same(body.text(), "{\"message\":\"m\",\"content\":\"YQ==\"}") || !body.make("m", "ab", "") || !same(body.text(), "{\"message\":\"m\",\"content\":\"YWI=\"}") || !body.make("m", "abc", "") || !same(body.text(), "{\"message\":\"m\",\"content\":\"YWJj\"}") || !body.make("m", "", "") || !same(body.text(), "{\"message\":\"m\",\"content\":\"\"}") { return 44 }
    // A branch; a message and a branch with what JSON writes otherwise.
    if !body.make("m", "abc", "boots/2026") || !same(body.text(), "{\"message\":\"m\",\"content\":\"YWJj\",\"branch\":\"boots/2026\"}") { return 45 }
    if !body.make("a \"quote\", a \\ and\na line\x01", "abc", "") || !same(body.text(), "{\"message\":\"a \\\"quote\\\", a \\\\ and\\na line\\u0001\",\"content\":\"YWJj\"}") { return 46 }
    body.free()

    // ---- What an answer means ----
    if answer.verdict(201, false) != answer.Verdict.done || answer.verdict(200, false) != answer.Verdict.done || answer.verdict(200, true) != answer.Verdict.done || answer.verdict(404, true) != answer.Verdict.absent || answer.verdict(404, false) != answer.Verdict.stop { return 47 }
    if answer.verdict(401, false) != answer.Verdict.stop || answer.verdict(403, true) != answer.Verdict.stop || answer.verdict(422, false) != answer.Verdict.stop || answer.verdict(301, false) != answer.Verdict.stop || answer.verdict(409, false) != answer.Verdict.again || answer.verdict(429, false) != answer.Verdict.again || answer.verdict(500, false) != answer.Verdict.again || answer.verdict(503, true) != answer.Verdict.again { return 48 }
    var words: [200]u8 = undefined
    n = answer.message("{\"message\":\"Bad credentials\",\"documentation_url\":\"https://docs.github.com/rest\"}", &words)
    if !same(words[0..n], "Bad credentials") { return 49 }
    // (Only the object's own "message"; no JSON, no words.)
    if answer.message("{\"message\":\"whole words\",\"documentation_url\":\"cut of", &words) != 0 { return 160 }
    if answer.message("{\"errors\":[{\"message\":\"inner\"}],\"other\":1}", &words) != 0 || answer.message("<html>", &words) != 0 || answer.message("", &words) != 0 || answer.message("{\"message\":\"cut of", &words) != 0 || answer.message("{\"message\":17}", &words) != 0 || answer.message("[\"message\"]", &words) != 0 { return 50 }

    // What a repository's record says of who reads it: its own
    // "private" alone, and only in JSON that is whole.
    if answer.privacy("{\"id\":1,\"private\":true}") != answer.Privacy.private || answer.privacy("{\"private\":false,\"id\":1}") != answer.Privacy.public || answer.privacy("{\"owner\":{\"private\":true},\"private\":false}") != answer.Privacy.public || answer.privacy("{\"owner\":{\"private\":false},\"private\":true}") != answer.Privacy.private { return 150 }
    if answer.privacy("{\"owner\":{\"private\":true}}") != answer.Privacy.unsaid || answer.privacy("{\"private\":\"true\"}") != answer.Privacy.unsaid || answer.privacy("{\"private\":1}") != answer.Privacy.unsaid || answer.privacy("{\"private\":true") != answer.Privacy.unsaid || answer.privacy("") != answer.Privacy.unsaid || answer.privacy("<html>private: true</html>") != answer.Privacy.unsaid || answer.privacy("[{\"private\":true}]") != answer.Privacy.unsaid { return 151 }

    // ---- The lines' filter ----
    var clean: [line_module.CAPACITY]u8 = undefined
    var found = false
    n = line_module.scrub("the token is ghx_NotARealToken-ABCDEFGHIJKLMNOPQRSTUVWXYZ-0123456789, said twice: ghx_NotARealToken-ABCDEFGHIJKLMNOPQRSTUVWXYZ-0123456789", OTHER_TOKEN, &clean, &found)
    if !found || !same(clean[0..n], "the token is [token], said twice: [token]") { return 51 }
    // (A piece of eight bytes is taken out, one of seven is not; a short
    // token is looked for whole; without a token nothing is.)
    n = line_module.scrub("a piece: QRSTUVWX and a shorter one: QRSTUVW.", OTHER_TOKEN, &clean, &found)
    if !found || !same(clean[0..n], "a piece: [token] and a shorter one: QRSTUVW.") { return 52 }
    n = line_module.scrub("abcde and abcd", "abcde", &clean, &found)
    if !found || !same(clean[0..n], "[token] and abcd") { return 53 }
    n = line_module.scrub("nothing to hide", "", &clean, &found)
    if found || !same(clean[0..n], "nothing to hide") { return 54 }
    n = line_module.scrub("nothing of it here", OTHER_TOKEN, &clean, &found)
    if found || !same(clean[0..n], "nothing of it here") || leaks(clean[0..n], OTHER_TOKEN) { return 55 }

    // ---- What is said of the settings: never their words ----
    // The token on the first line, where the repository belongs; on a
    // third line behind a word that is none; with a blank in it.
    var badText: Text = undefined
    var all: Text = undefined
    all.init()
    var form: usize = 0
    while form < 6 {
        badText.init()
        if form == 0 {
            badText.add(OTHER_TOKEN)
            badText.add("\nowner/logs\n")
        } else if form == 1 {
            badText.add("owner/logs\nabc\ntoken ")
            badText.add(OTHER_TOKEN)
            badText.add("\n")
        } else if form == 2 {
            badText.add("owner/logs\n")
            badText.add(OTHER_TOKEN)
            badText.add(" x\n")
        } else if form == 3 {
            badText.add("owner/logs\n")
            badText.add(OTHER_TOKEN)
            badText.add("\ntest-endpoint http://10.0.2.2:1\n")
        } else if form == 4 {
            badText.add("owner/logs\n")
            badText.add(OTHER_TOKEN)
            badText.add("\napi https://")
            badText.add(OTHER_TOKEN)
            badText.add("@host\n")
        } else {
            badText.add("owner/logs\n")
        }
        settings_module.parse(badText.text(), &settings)
        scratch.init()
        if !said.ofSettings(&scratch, settings_module.Read.ok, &settings, "/system/settings/logpush", form % 2 == 0) { return 56 }
        all.add(scratch.text())
        all.add("\n")
        form += 1
    }
    if !same(all.text(), "logpush: line 1 of the settings is not a repository's name (OWNER/NAME)\nlogpush: line 3 of the settings is none logpush knows (after the repository and the token: machine NAME, branch NAME, again SECONDS, api https://HOST, test-endpoint http://HOST:PORT)\nlogpush: line 2 of the settings is not a token (it has a blank or a character no token has)\nlogpush: the settings name a test endpoint without TLS, which takes a test's token only (one that begins with test-): nothing is sent\nlogpush: line 3 of the settings is none logpush knows (after the repository and the token: machine NAME, branch NAME, again SECONDS, api https://HOST, test-endpoint http://HOST:PORT)\nlogpush: the settings have no token: it is their second line\n") { return 57 }
    // The other lines of the settings and of the service, with settings
    // that hold a token.
    _ = parsed("owner/logs\nghx_NotARealToken-ABCDEFGHIJKLMNOPQRSTUVWXYZ-0123456789\n")
    scratch.init()
    if said.ofSettings(&scratch, settings_module.Read.ok, &settings, "/system/settings/logpush", false) || scratch.length != 0 { return 58 }
    _ = said.ofSettings(&scratch, settings_module.Read.missing, &settings, "/system/settings/logpush", true)
    if !same(scratch.text(), "logpush: no settings (/system/settings/logpush): nothing is uploaded from this machine") { return 59 }
    all.add(scratch.text())
    scratch.init()
    _ = said.ofSettings(&scratch, settings_module.Read.missing, &settings, "/system/settings/logpush", false)
    all.add(scratch.text())
    scratch.init()
    _ = said.ofSettings(&scratch, settings_module.Read.denied, &settings, "/system/settings/logpush", false)
    if !same(scratch.text(), "logpush: the settings (/system/settings/logpush) hold a token and are the system's alone to read: this shell is not the system's (root's)") { return 60 }
    all.add(scratch.text())
    scratch.init()
    _ = said.ofSettings(&scratch, settings_module.Read.unreadable, &settings, "/system/settings/logpush", false)
    all.add(scratch.text())
    _ = parsed("")
    scratch.init()
    _ = said.ofSettings(&scratch, settings_module.Read.ok, &settings, "/system/settings/logpush", false)
    all.add(scratch.text())
    scratch.init()
    said.noLog(&scratch)
    all.add(scratch.text())
    scratch.init()
    said.noAddress(&scratch, 90, upload.Trouble.noDevice)
    if !same(scratch.text(), "logpush: nothing is uploaded: this machine has no network device") { return 61 }
    all.add(scratch.text())
    scratch.init()
    said.noAddress(&scratch, 90, upload.Trouble.linkDown)
    if !same(scratch.text(), "logpush: nothing is uploaded: this machine has no address after 90 s (the network link is down: no cable, or nothing at its other end)") { return 62 }
    all.add(scratch.text())
    scratch.init()
    said.noAddress(&scratch, 90, upload.Trouble.noAddress)
    if !same(scratch.text(), "logpush: nothing is uploaded: this machine has no address after 90 s (no DHCP server answers)") { return 63 }
    all.add(scratch.text())
    scratch.init()
    said.again(&scratch, 10, 2, 5)
    if !same(scratch.text(), "logpush: trying again in 10 s (try 2 of 5)") { return 64 }
    all.add(scratch.text())
    scratch.init()
    said.notGrown(&scratch, 120)
    if !same(scratch.text(), "logpush: the kernel log has not grown in 120 s: nothing more to upload") { return 65 }
    all.add(scratch.text())
    // What an asker is told who comes too soon, and a user for whom
    // nobody is there to ask.
    scratch.init()
    said.tooSoon(&scratch, 2)
    if !same(scratch.text(), "logpush: an upload was made a moment ago: asked again in 2 s, the service uploads again") { return 152 }
    all.add(scratch.text())
    scratch.init()
    said.notAsked(&scratch, "/system/settings/logpush", false)
    if !same(scratch.text(), "logpush: the settings (/system/settings/logpush) hold a token and are the system's alone to read, and the service that uploads for everyone else is not running (it ends at once in an image without settings: /temporary/logs/logpush.log has what it said)") { return 153 }
    all.add(scratch.text())
    scratch.init()
    said.notAsked(&scratch, "/system/settings/logpush", true)
    if !same(scratch.text(), "logpush: the service that uploads did not answer to the end (it is at an upload that takes long, or it is gone): /temporary/logs/logpush.log has what it said") { return 154 }
    all.add(scratch.text())
    all.add(said.USAGE)
    if leaks(all.text(), OTHER_TOKEN) { return 66 }
    // What is wrong with a chain, flag for flag.
    scratch.init()
    upload.chainText(&scratch, x509.UNKNOWN_CA, "api.github.com", BOOT)
    if !same(scratch.text(), "no certificate authority this system trusts has signed it") { return 67 }
    scratch.init()
    upload.chainText(&scratch, x509.BAD_IDENTITY, "api.github.com", BOOT)
    if !same(scratch.text(), "it is not api.github.com's (something stands between this machine and that host: a proxy, a network's login page)") { return 68 }
    scratch.init()
    upload.chainText(&scratch, x509.EXPIRED, "api.github.com", 4102401601)
    if !same(scratch.text(), "it has expired by this machine's clock, which says 2099-12-31") { return 69 }
    scratch.init()
    upload.chainText(&scratch, x509.NOT_ACTIVATED | x509.UNKNOWN_CA, "api.github.com", 1767225600)
    if !same(scratch.text(), "no certificate authority this system trusts has signed it; it is not valid yet by this machine's clock, which says 2026-01-01") { return 70 }
    scratch.init()
    upload.chainText(&scratch, x509.GENERIC_ERROR, "api.github.com", BOOT)
    if !same(scratch.text(), "it is not a certificate a server may show") { return 71 }

    // This boot's own saved log, and another's.
    if !machine.ownLog("boot\n", "boot\nlater\n") || !machine.ownLog("boot\n", "boot\n") || machine.ownLog("boat\n", "boot\nlater\n") || machine.ownLog("boot\nlater\nmore\n", "boot\nlater\n") || machine.ownLog("", "boot\n") { return 72 }

    // ---- The servers ----
    const pipe = std.fs.makePipe()
    if pipe == null { return 73 }
    recordPipe = pipe.?.writeDescriptor
    readEnd = pipe.?.readDescriptor
    // (Room for the largest request, which its server writes down before
    // it answers and the test reads after.)
    if !std.fs.setPipeSize(std.fs.File.{ .descriptor = recordPipe }, 1048576) { return 73 }
    // (Every address of the machine: 127.0.0.2 reaches the TLS server
    // under a name that is not its certificate's.)
    const any = net.ipv4(0, 0, 0, 0, 0)
    const plainListener = net.listen(&any, 8)
    const secureListener = net.listen(&any, 8)
    // (A port where nobody listens: one taken and given back.)
    const closedListener = net.listen(&any, 8)
    var bound: net.Address = undefined
    if plainListener < 0 || secureListener < 0 || closedListener < 0 || !net.localAddress(plainListener, &bound) { return 74 }
    const plainPort = @intCast(usize, bound.port)
    if !net.localAddress(secureListener, &bound) { return 74 }
    const securePort = @intCast(usize, bound.port)
    if !net.localAddress(closedListener, &bound) { return 74 }
    const closedPort = @intCast(usize, bound.port)
    net.close(closedListener)
    // The TLS server's root and certificate (for localhost and
    // 127.0.0.1, 2025 to 2035), and the root as the only one trusted.
    var rootSeed: [32]u8 = undefined
    var serverSeed: [32]u8 = undefined
    k = 0
    while k < 32 {
        rootSeed[k] = @intCast(u8, 17 + k * 3)
        serverSeed[k] = @intCast(u8, 201 - k * 5)
        k += 1
    }
    var rootDer: [certs.ROOM]u8 = undefined
    var serverDer: [certs.ROOM]u8 = undefined
    const rootLength = certs.make("logpush test root", &rootSeed, "logpush test root", &rootSeed, 1, true, &rootDer)
    const serverLength = certs.make("localhost", &serverSeed, "logpush test root", &rootSeed, 2, false, &serverDer)
    if rootLength == 0 || serverLength == 0 { return 75 }
    var chain: [1]tls_server.Certificate = undefined
    chain[0] = tls_server.Certificate.{ .der = &serverDer, .length = serverLength }
    var roots: x509.TrustStore = undefined
    x509.storeInit(&roots, std.heap.allocator())
    if !x509.storeAddDer(&roots, rootDer[0..rootLength]) { return 75 }
    const plainServer = process.fork()
    if plainServer < 0 { return 76 }
    if plainServer == 0 {
        net.close(secureListener)
        serve(plainListener, false, &chain, &serverSeed)
        std.linux.exitGroup(0)
    }
    const secureServer = process.fork()
    if secureServer < 0 {
        _ = process.kill(plainServer, 9)
        return 76
    }
    if secureServer == 0 {
        net.close(plainListener)
        serve(secureListener, true, &chain, &serverSeed)
        std.linux.exitGroup(0)
    }
    net.close(plainListener)
    net.close(secureListener)
    const failed = cases(plainPort, securePort, closedPort, &roots)
    _ = process.kill(plainServer, 9)
    _ = process.kill(secureServer, 9)
    var status: usize = 0
    _ = process.waitProcess(plainServer, &status, 0)
    _ = process.waitProcess(secureServer, &status, 0)
    return failed
}

// The cases against the servers: 13, or the number of the first check
// that failed.
fn cases(plainPort: usize, securePort: usize, closedPort: usize, roots: *x509.TrustStore) -> u8 {
    var k: usize = 0
    // ---- An upload of all three, byte for byte ----
    // The repository has neither the log of the boot before nor the ROM.
    if !configure("fresh", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) { return 77 }
    if run(KLOG, "the boot before\n", everyByte[0..256]) != upload.Result.done { return 78 }
    takeRecords(5)
    if recordCount() != 5 || !same(anyRecord(0), expect("GET", "fresh", "", host.text(), TEST_TOKEN, "")) { return 79 }
    if !same(recordAt(0), expect("PUT", "fresh", "brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt", host.text(), TEST_TOKEN, "{\"message\":\"brix: the kernel log 42 s after the boot of 2026-11-17T20-41-07Z\",\"content\":\"YnJpeE9TOiB0aGUga2VybmVsCmdwdTogb25lIGxpbmUK\"}")) { return 80 }
    if !same(recordAt(1), expect("GET", "fresh", "brix/2026-11-17T20-41-07Z/previous-boot-klog.txt", host.text(), TEST_TOKEN, "")) { return 81 }
    if !same(recordAt(2), expect("PUT", "fresh", "brix/2026-11-17T20-41-07Z/previous-boot-klog.txt", host.text(), TEST_TOKEN, "{\"message\":\"brix: the kernel log of the boot before that of 2026-11-17T20-41-07Z\",\"content\":\"dGhlIGJvb3QgYmVmb3JlCg==\"}")) { return 82 }
    if !same(recordAt(3), expect("GET", "fresh", "brix/gpu-rom-40aff2e9d2d8922e.rom", host.text(), TEST_TOKEN, "")) { return 83 }
    var romBody: Text = undefined
    romBody.init()
    romBody.add("{\"message\":\"brix: the graphics card's ROM as the kernel read it\",\"content\":\"")
    romBody.add(EVERY_BASE64)
    romBody.add("\"}")
    if !same(recordAt(4), expect("PUT", "fresh", "brix/gpu-rom-40aff2e9d2d8922e.rom", host.text(), TEST_TOKEN, romBody.text())) { return 84 }
    wanted.init()
    wanted.add("logpush: uploaded the kernel log (33 bytes) as brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt at the test endpoint http://")
    wanted.add(host.text())
    wanted.add(" (no TLS)\nlogpush: uploaded the log of the boot before (boot.previous.log of disk0, 16 bytes) as brix/2026-11-17T20-41-07Z/previous-boot-klog.txt at the test endpoint http://")
    wanted.add(host.text())
    wanted.add(" (no TLS)\nlogpush: uploaded the graphics card's ROM (256 bytes) as brix/gpu-rom-40aff2e9d2d8922e.rom at the test endpoint http://")
    wanted.add(host.text())
    wanted.add(" (no TLS)\n")
    if lineCount != 3 || !same(lines.text(), wanted.text()) || leaks(lines.text(), TEST_TOKEN) { return 85 }

    // The repository has the ROM already: asked for, not sent again; the
    // machine's name and the branch of the settings.
    var more: Text = undefined
    more.init()
    more.add(endpointLine("test-endpoint http://", "127.0.0.1", plainPort))
    more.add("\nmachine h11-epyc\nbranch boots/2026")
    if !configure("created", TEST_TOKEN, more.text()) { return 86 }
    if run(KLOG, "", everyByte[0..256]) != upload.Result.done { return 87 }
    takeRecords(2)
    if recordCount() != 2 { return 88 }
    if !same(recordAt(0), expect("PUT", "created", "h11-epyc/2026-11-17T20-41-07Z/klog-0000042.317s.txt", host.text(), TEST_TOKEN, "{\"message\":\"h11-epyc: the kernel log 42 s after the boot of 2026-11-17T20-41-07Z\",\"content\":\"YnJpeE9TOiB0aGUga2VybmVsCmdwdTogb25lIGxpbmUK\",\"branch\":\"boots/2026\"}")) { return 89 }
    if !same(recordAt(1), expect("GET", "created", "h11-epyc/gpu-rom-40aff2e9d2d8922e.rom", host.text(), TEST_TOKEN, "")) { return 90 }
    wanted.init()
    wanted.add("logpush: uploaded the kernel log (33 bytes) as h11-epyc/2026-11-17T20-41-07Z/klog-0000042.317s.txt at the test endpoint http://")
    wanted.add(host.text())
    wanted.add(" (no TLS)\nlogpush: the graphics card's ROM is there already (h11-epyc/gpu-rom-40aff2e9d2d8922e.rom)\n")
    if lineCount != 2 || !same(lines.text(), wanted.text()) { return 91 }

    // The log alone (no ROM, no log of the boot before): one request. A
    // whole kernel log of 256 KiB with every byte value in it arrives as
    // it is.
    k = 0
    while k < 262144 {
        bigLog[k] = @intCast(u8, (k * 7 + k / 251) & 255)
        k += 1
    }
    if !configure("created", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) { return 92 }
    if run(bigLog[0..262144], "", "") != upload.Result.done { return 93 }
    takeRecords(1)
    var big: request.Body = undefined
    big.init()
    if !big.make("brix: the kernel log 42 s after the boot of 2026-11-17T20-41-07Z", bigLog[0..262144], "") { return 94 }
    const bigRecord = recordAt(0)
    if recordCount() != 1 || bigRecord.length < big.length || !same(bigRecord[bigRecord.length - big.length..bigRecord.length], big.text()) || std.text.find(bigRecord, "\r\nContent-Length: 349619\r\n") >= bigRecord.length || big.length != 349619 { return 95 }
    big.free()
    if lineCount != 1 || std.text.find(lines.text(), "logpush: uploaded the kernel log (262144 bytes) as brix/") != 0 { return 96 }
    // (A 200 is a file made as well.)
    if !configure("replaced", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || run(KLOG, "", "") != upload.Result.done { return 97 }
    takeRecords(1)
    if lineCount != 1 || recordCount() != 1 { return 97 }
    // A 201 whose body is no JSON is a file made all the same.
    if !configure("notjson", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || run(KLOG, "", "") != upload.Result.done { return 98 }
    takeRecords(1)
    if lineCount != 1 || std.text.find(lines.text(), "logpush: uploaded the kernel log (33 bytes) as ") != 0 { return 98 }

    // ---- The answers that are none of these ----
    if !fails("unauthorized", plainPort, upload.Result.stop, "401: GitHub does not take the token (mistyped, expired or revoked): the settings need a new one; GitHub: \"Bad credentials\"", 0, true) { return 99 }
    if !fails("forbidden", plainPort, upload.Result.stop, "403: the token may not do this (it needs \"Contents: Read and write\" for o/forbidden), or GitHub's limit of requests is reached; GitHub: \"Resource not accessible by personal access token\"", 0, true) { return 100 }
    if !fails("missing", plainPort, upload.Result.stop, "404: no repository o/missing, or the token may not see it; GitHub: \"Not Found\"", 0, true) { return 101 }
    if !fails("busy", plainPort, upload.Result.again, "503: GitHub's side failed", 0, true) { return 146 }
    // A repository everyone reads gets nothing, nor one of which the
    // answer does not say that it is private: the one request, no upload.
    if !fails("public", plainPort, upload.Result.stop, "o/public is a public repository, and a machine's kernel log and its card's ROM are not for everyone to read: make it private, or name a private one in the settings", 0, true) { return 147 }
    if !fails("unsaid", plainPort, upload.Result.stop, "o/unsaid may be a public repository (GitHub's answer does not say that it is private)", 0, true) { return 148 }
    if !fails("echorepo", plainPort, upload.Result.stop, "403: the token may not do this (it needs \"Contents: Read and write\" for o/echorepo), or GitHub's limit of requests is reached; GitHub: \"no: Bearer [token]\"", 0, true) { return 149 }
    if !fails("conflict", plainPort, upload.Result.again, "409: GitHub says the branch changed at the same moment; GitHub: \"is at 1234 but expected 5678\"", 1, false) { return 102 }
    // A 422 is first a name that is taken: the next millisecond's is
    // tried, once, and then it is said.
    if !fails("unprocessable", plainPort, upload.Result.stop, "422: GitHub does not take the file (one of this name is there already, or the branch is not there); GitHub: \"Invalid request.??\"sha\" wasn't supplied.\"", 2, false) { return 103 }
    if !std.text.contains(recordAt(0), "/klog-0000042.317s.txt HTTP/1.1") || !std.text.contains(recordAt(1), "/klog-0000042.318s.txt HTTP/1.1") { return 103 }
    if !configure("taken", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || run(KLOG, "", "") != upload.Result.done { return 144 }
    takeRecords(2)
    if recordCount() != 2 || lineCount != 1 || std.text.find(lines.text(), "logpush: uploaded the kernel log (33 bytes) as brix/2026-11-17T20-41-07Z/klog-0000042.318s.txt at the test endpoint ") != 0 { return 145 }
    if !fails("limited", plainPort, upload.Result.again, "429: too many requests for GitHub at the moment; GitHub: \"slow down\"", 1, false) { return 104 }
    // A body that is no JSON, or JSON cut off: the status is said, the
    // body's words are not.
    if !fails("broken", plainPort, upload.Result.again, "500: GitHub's side failed", 1, false) { return 105 }
    if !fails("halfjson", plainPort, upload.Result.stop, "401: GitHub does not take the token (mistyped, expired or revoked): the settings need a new one", 1, false) { return 106 }
    // A redirect is not followed: one request, none to where it points.
    if !fails("moved", plainPort, upload.Result.stop, "301: GitHub points elsewhere (the repository was renamed or moved: the settings need its name of now); GitHub: \"Moved Permanently\"", 1, false) { return 107 }
    if std.text.contains(recordAt(0), "stolen") { return 107 }
    // An answer cut off in its middle, a connection that says nothing,
    // what is no HTTP.
    if !fails("cut", plainPort, upload.Result.again, "the connection ended before the answer was whole", 1, false) { return 108 }
    if !fails("silent", plainPort, upload.Result.again, "the connection ended before the answer was whole", 1, false) { return 109 }
    if !fails("garbage", plainPort, upload.Result.again, "what answered is not HTTP", 1, false) { return 110 }
    // Nobody listens.
    wanted.init()
    wanted.add("127.0.0.1:")
    wanted.number(closedPort)
    wanted.add(" refused the connection")
    var refused: Text = undefined
    refused.init()
    refused.add(wanted.text())
    if !configure("created", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", closedPort)) || run(KLOG, "", "") != upload.Result.again { return 111 }
    skip = 0
    takeRecords(0)
    wanted.init()
    wanted.add("logpush: nothing was uploaded: ")
    wanted.add(refused.text())
    wanted.add("\n")
    if lineCount != 1 || !same(lines.text(), wanted.text()) || recordCount() != 0 { return 111 }
    // A server that sends the token back, whole and its last twelve
    // bytes: neither is said.
    if !configure("echo", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || run(KLOG, "", "") != upload.Result.stop { return 112 }
    takeRecords(1)
    if lineCount != 1 || leaks(lines.text(), TEST_TOKEN) || !same(lines.text(), "logpush: the kernel log was not uploaded: 401: GitHub does not take the token (mistyped, expired or revoked): the settings need a new one; GitHub: \"you sent Bearer [token] and its end is [token]\"\n") { return 113 }
    // The log of the boot before is not uploaded when the kernel log was
    // not; an error at the ROM is said and the log stays uploaded.
    if !configure("unauthorized", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || run(KLOG, "before\n", everyByte[0..256]) != upload.Result.stop { return 114 }
    takeRecords(0)
    if lineCount != 1 || recordCount() != 0 || allRecords() != 1 { return 114 }
    // The same when the repository takes the question and not the kernel
    // log (both names of it tried): neither the log of the boot before
    // nor the ROM is asked for.
    if !configure("unprocessable", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || run(KLOG, "before\n", everyByte[0..256]) != upload.Result.stop { return 161 }
    takeRecords(2)
    if lineCount != 1 || recordCount() != 2 || went.klog || went.previous || went.rom { return 161 }
    // The question about a repository that was renamed is answered with
    // where it is now: not followed (the token would go there), said.
    if !fails("movedrepo", plainPort, upload.Result.stop, "301: GitHub points elsewhere (the repository was renamed or moved: the settings need its name of now); GitHub: \"Moved Permanently\"", 0, true) { return 162 }
    if allRecords() != 1 || std.text.contains(anyRecord(0), "stolen") { return 162 }

    // ---- A run tried again ----
    // The kernel log goes, the log of the boot before does not (GitHub's
    // side): said, worth another try.
    if !configure("prevbroken", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || run(KLOG, "before\n", "") != upload.Result.again { return 163 }
    takeRecords(3)
    wanted.init()
    wanted.add("logpush: uploaded the kernel log (33 bytes) as brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt at the test endpoint http://")
    wanted.add(host.text())
    wanted.add(" (no TLS)\nlogpush: the log of the boot before was not uploaded: 500: GitHub's side failed\n")
    if recordCount() != 3 || lineCount != 2 || !same(lines.text(), wanted.text()) || !went.klog || went.previous { return 163 }
    // The next try of the same upload (what went is kept): the question,
    // then the log of the boot before alone. No second file of the
    // kernel log, and no line about it.
    lines.init()
    lineCount = 0
    if run(KLOG, "before\n", "") != upload.Result.again { return 164 }
    takeRecords(2)
    if recordCount() != 2 || !same(anyRecord(0), expect("GET", "prevbroken", "", host.text(), TEST_TOKEN, "")) || !same(recordAt(0), expect("GET", "prevbroken", "brix/2026-11-17T20-41-07Z/previous-boot-klog.txt", host.text(), TEST_TOKEN, "")) || std.text.find(recordAt(1), "PUT /repos/o/prevbroken/contents/brix/2026-11-17T20-41-07Z/previous-boot-klog.txt HTTP/1.1\r\n") != 0 { return 164 }
    if lineCount != 1 || !same(lines.text(), "logpush: the log of the boot before was not uploaded: 500: GitHub's side failed\n") || !went.klog || went.previous { return 165 }
    // An upload of all three, then the service's next upload of the same
    // boot (the kernel log anew, what went of the rest kept): the kernel
    // log alone, the log of the boot before and the ROM not asked for.
    if !configure("fresh", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || run(KLOG, "the boot before\n", everyByte[0..256]) != upload.Result.done { return 166 }
    takeRecords(5)
    if recordCount() != 5 || !went.klog || !went.previous || !went.rom { return 166 }
    went.klog = false
    lines.init()
    lineCount = 0
    if run(KLOG, "the boot before\n", everyByte[0..256]) != upload.Result.done { return 167 }
    takeRecords(1)
    if recordCount() != 1 || lineCount != 1 || std.text.find(recordAt(0), "PUT /repos/o/fresh/contents/brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt HTTP/1.1\r\n") != 0 { return 167 }
    // A log of the boot before that GitHub refuses (422) is said: only
    // the kernel log's name is tried under the next one in silence.
    if !configure("prevtaken", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || run(KLOG, "before\n", "") != upload.Result.stop { return 168 }
    takeRecords(3)
    wanted.init()
    wanted.add("logpush: uploaded the kernel log (33 bytes) as brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt at the test endpoint http://")
    wanted.add(host.text())
    wanted.add(" (no TLS)\nlogpush: the log of the boot before was not uploaded: 422: GitHub does not take the file (one of this name is there already, or the branch is not there); GitHub: \"Invalid request.??\"sha\" wasn't supplied.\"\n")
    if recordCount() != 3 || lineCount != 2 || !same(lines.text(), wanted.text()) || !went.klog || went.previous { return 168 }

    // What stands in the way on this machine's side, and a name that is
    // none: said before anything is sent.
    if !configure("created", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) { return 115 }
    noTrouble = upload.Trouble.noDevice
    if run(KLOG, "", "") != upload.Result.stop || !same(lines.text(), "logpush: nothing was uploaded: this machine has no network device\n") { return 116 }
    lines.init()
    noTrouble = upload.Trouble.linkDown
    if run(KLOG, "", "") != upload.Result.again || !same(lines.text(), "logpush: nothing was uploaded: the network link is down (no cable, or nothing at its other end)\n") { return 117 }
    lines.init()
    noTrouble = upload.Trouble.noAddress
    if run(KLOG, "", "") != upload.Result.again || !same(lines.text(), "logpush: nothing was uploaded: this machine has no address yet (DHCP has not answered)\n") { return 118 }
    noTrouble = upload.Trouble.none
    if !configure("created", TEST_TOKEN, "test-endpoint http://no..name:80") || run(KLOG, "", "") != upload.Result.stop || !same(lines.text(), "logpush: nothing was uploaded: the name no..name is no name a host can have\n") { return 119 }
    skip = 0
    takeRecords(0)
    if recordCount() != 0 { return 120 }

    // ---- TLS ----
    // The chain leads to the root given and the name is the
    // certificate's: the upload goes through, the same bytes.
    if !configure("created", OTHER_TOKEN, endpointLine("api https://", "127.0.0.1", securePort)) { return 121 }
    if runWith(KLOG, "", "", BOOT + 42, true, roots) != upload.Result.done { return 122 }
    takeRecords(1)
    if recordCount() != 1 || !same(anyRecord(0), expect("GET", "created", "", host.text(), OTHER_TOKEN, "")) || !same(recordAt(0), expect("PUT", "created", "brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt", host.text(), OTHER_TOKEN, "{\"message\":\"brix: the kernel log 42 s after the boot of 2026-11-17T20-41-07Z\",\"content\":\"YnJpeE9TOiB0aGUga2VybmVsCmdwdTogb25lIGxpbmUK\"}")) { return 123 }
    wanted.init()
    wanted.add("logpush: uploaded the kernel log (33 bytes) as brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt at ")
    wanted.add(host.text())
    wanted.add("\n")
    if lineCount != 1 || !same(lines.text(), wanted.text()) || leaks(lines.text(), OTHER_TOKEN) { return 124 }
    // (By the certificate's other name as well.)
    if !configure("created", OTHER_TOKEN, endpointLine("api https://", "localhost", securePort)) || runWith(KLOG, "", "", BOOT + 42, true, roots) != upload.Result.done { return 125 }
    takeRecords(1)
    if recordCount() != 1 { return 125 }
    // The system's own roots do not have the test's: not trusted, said,
    // and the server got a handshake that ended, no request.
    if !configure("created", OTHER_TOKEN, endpointLine("api https://", "127.0.0.1", securePort)) { return 126 }
    if runWith(KLOG, "", "", BOOT + 42, true, null) != upload.Result.stop { return 127 }
    skip = 0
    takeRecords(1)
    wanted.init()
    wanted.add("logpush: nothing was uploaded: the certificate of ")
    wanted.add(host.text())
    wanted.add(" is not trusted: no certificate authority this system trusts has signed it\n")
    if lineCount != 1 || !same(lines.text(), wanted.text()) || recordCount() != 1 || !same(recordAt(0), "!handshake") { return 128 }
    // The root is trusted and the name is another's.
    if !configure("created", OTHER_TOKEN, endpointLine("api https://", "127.0.0.2", securePort)) { return 129 }
    if runWith(KLOG, "", "", BOOT + 42, true, roots) != upload.Result.stop { return 130 }
    skip = 0
    takeRecords(1)
    wanted.init()
    wanted.add("logpush: nothing was uploaded: the certificate of ")
    wanted.add(host.text())
    wanted.add(" is not trusted: it is not 127.0.0.2's (something stands between this machine and that host: a proxy, a network's login page)\n")
    if lineCount != 1 || !same(lines.text(), wanted.text()) || recordCount() != 1 || !same(recordAt(0), "!handshake") { return 131 }
    // What speaks no TLS where TLS is asked for (the server without it).
    if !configure("created", OTHER_TOKEN, endpointLine("api https://", "127.0.0.1", plainPort)) { return 132 }
    if runWith(KLOG, "", "", BOOT + 42, true, roots) != upload.Result.again { return 133 }
    skip = 0
    takeRecords(0)
    wanted.init()
    wanted.add("logpush: nothing was uploaded: no TLS connection to ")
    wanted.add(host.text())
    wanted.add(": what answers there does not speak TLS as it should (a proxy?)\n")
    if lineCount != 1 || !same(lines.text(), wanted.text()) || recordCount() != 0 || leaks(lines.text(), OTHER_TOKEN) { return 134 }
    // A clock that is not set: nothing is sent, not even a connection
    // made (the server writes down none).
    if !configure("created", OTHER_TOKEN, endpointLine("api https://", "127.0.0.1", securePort)) { return 135 }
    if runWith(KLOG, "", "", 946684800 + 77, true, roots) != upload.Result.stop { return 136 }
    skip = 0
    takeRecords(0)
    wanted.init()
    wanted.add("logpush: nothing was uploaded: this machine's clock is not set (it says 2000-01-01), and without the date the certificate of ")
    wanted.add(host.text())
    wanted.add(" cannot be judged: set the date and the time (UTC) in the firmware's setup\n")
    if lineCount != 1 || !same(lines.text(), wanted.text()) || recordCount() != 0 { return 137 }
    // No random numbers fit for a key: nothing is sent either.
    lines.init()
    lineCount = 0
    if runWith(KLOG, "", "", BOOT + 42, false, roots) != upload.Result.stop { return 138 }
    takeRecords(0)
    if lineCount != 1 || !same(lines.text(), "logpush: nothing was uploaded: this machine's processor has no source of random numbers, and a TLS key made without one could be worked out by someone who listens: the token is not sent\n") || recordCount() != 0 { return 139 }
    // (A test endpoint needs neither: its token is no secret.)
    if !configure("created", TEST_TOKEN, endpointLine("test-endpoint http://", "127.0.0.1", plainPort)) || runWith(KLOG, "", "", 946684800 + 77, false, null) != upload.Result.done { return 140 }
    takeRecords(1)
    if recordCount() != 1 || std.text.find(recordAt(0), "PUT /repos/o/created/contents/brix/2026-11-17T20-41-07Z/klog-0000042.317s.txt HTTP/1.1\r\n") != 0 { return 141 }
    return 13
}
