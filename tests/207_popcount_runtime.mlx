pub fn main() -> usize {
    const empty: u64 = 0
    const sparse: u64 = 9223372036854775809
    const alternating: u64 = 12297829382473034410
    const signed: i8 = -1
    if @popCount(empty) != 0 { return 1 }
    if @popCount(sparse) != 2 { return 2 }
    if @popCount(alternating) != 32 { return 3 }
    if @popCount(signed) != 8 { return 4 }
    return 13
}
