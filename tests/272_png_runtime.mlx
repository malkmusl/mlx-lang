// std.png: tests/support/png holds PNGs of every colour type and bit depth
// (RGBA and RGB at 8 bits, RGBA and greyscale at 16, greyscale at 1 bit,
// greyscale with alpha, a 4-bit palette with transparency), each row
// filtered differently (all five filters), over two IDAT chunks, with
// stored, fixed and dynamic Huffman blocks; make_pngs.py wrote them with
// the pixels they must decode to (premultiplied ARGB, NAME.argb). An
// interlaced PNG and a file that is not a PNG are refused, a truncated one
// is corrupt, and scale() shrinks rgba8 to the expected 5x3. Exits 13; run
// from the repository root.
const std = @import("std")
const png = @import("std.png")

const Allocator = std.allocator.Allocator

fn expected(name: []const u8, allocator: Allocator, words: *[*]const u32) -> usize {
    var path: [128]u8 = undefined
    var length: usize = 0
    for byte in "tests/support/png/" {
        path[length] = byte
        length += 1
    }
    for byte in name {
        path[length] = byte
        length += 1
    }
    for byte in ".argb" {
        path[length] = byte
        length += 1
    }
    path[length] = 0
    var file: std.fs.File = undefined
    unsafe { file = std.fs.open(@ptrCast([*]const u8, &path), 0, 0) }
    if !std.fs.isValid(file) { return 0 }
    const contents = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    unsafe { words.* = @ptrCast([*]const u32, contents.items) }
    return contents.length / 4
}

fn check(name: []const u8, allocator: Allocator) -> bool {
    var path: [128]u8 = undefined
    var length: usize = 0
    for byte in "tests/support/png/" {
        path[length] = byte
        length += 1
    }
    for byte in name {
        path[length] = byte
        length += 1
    }
    for byte in ".png" {
        path[length] = byte
        length += 1
    }
    path[length] = 0
    var image: png.Image = undefined
    var status = png.Status.corrupt
    unsafe { status = png.loadFile(&image, @ptrCast([*]const u8, &path), allocator) }
    if status != png.Status.ok { return false }
    var words: [*]const u32 = undefined
    const count = expected(name, allocator, &words)
    if image.width != 37 || image.height != 23 || count != 37 * 23 { return false }
    var index: usize = 0
    while index < count {
        if image.pixels[index] != words[index] { return false }
        index += 1
    }
    png.deinit(&image)
    return true
}

pub fn main() -> u8 {
    const allocator = std.page_allocator.init()
    if !check("rgba8", allocator) { return 1 }
    if !check("rgb8", allocator) { return 2 }
    if !check("rgba16", allocator) { return 3 }
    if !check("grey1", allocator) { return 4 }
    if !check("grey16", allocator) { return 5 }
    if !check("greyalpha8", allocator) { return 6 }
    if !check("palette4", allocator) { return 7 }

    var image: png.Image = undefined
    unsafe {
        if png.loadFile(&image, @ptrCast([*]const u8, "tests/support/png/interlaced.png"), allocator) != png.Status.unsupported { return 8 }
        if png.loadFile(&image, @ptrCast([*]const u8, "tests/support/png/make_pngs.py"), allocator) != png.Status.notPng { return 9 }
        if png.loadFile(&image, @ptrCast([*]const u8, "tests/support/png/no-such.png"), allocator) != png.Status.unreadable { return 10 }
    }
    // A PNG cut short is corrupt, not a trap.
    var file: std.fs.File = undefined
    unsafe { file = std.fs.open(@ptrCast([*]const u8, "tests/support/png/rgba8.png"), 0, 0) }
    const contents = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    var cut: usize = 40
    while cut < contents.length {
        if png.decode(&image, contents.items, cut, allocator) == png.Status.ok { return 11 }
        cut += 97
    }

    // Area averaging to 5x3.
    unsafe {
        if png.loadFile(&image, @ptrCast([*]const u8, "tests/support/png/rgba8.png"), allocator) != png.Status.ok { return 12 }
    }
    var small: png.Image = undefined
    if png.scale(&small, &image, 5, 3, allocator) != png.Status.ok { return 16 }
    var words: [*]const u32 = undefined
    if expected("scaled", allocator, &words) != 15 { return 14 }
    var index: usize = 0
    while index < 15 {
        if small.pixels[index] != words[index] { return 15 }
        index += 1
    }
    return 13
}
