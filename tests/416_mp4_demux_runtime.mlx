// std.mp4: a plain MP4 (sample tables: an AVC track of three samples
// in two chunks with composition offsets and one sync sample, an AAC
// track of fixed-size samples with an edit list) and a fragmented one
// (trex defaults, a fragment with tfdt and per-sample flags, a second
// fragment without tfdt), both made by tests/support/mp4_corpus.py; the
// codec configuration (avcC's parameter sets, AudioSpecificConfig),
// Annex B conversion, seeking, a fragment cut short (needMore, nothing
// consumed) and damage. Exits 13 when every check holds, else the
// number of the first check that failed.
const std = @import("std")
const mp4 = @import("std.mp4")

fn same(a: [*]const u8, b: [*]const u8, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

var ANNEX_B = [9]u8{0, 0, 0, 1, 0x41, 0x9b, 0, 0, 0}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var movie: mp4.Movie = undefined
    mp4.init(&movie, allocator)
    var samples: mp4.Samples = undefined
    mp4.initSamples(&samples, allocator)
    var used: usize = 0

    // The plain file.
    if mp4.parse(&movie, &plainFile, 1154, &samples, &used) != mp4.Status.ok { return 1 }
    if used != 1154 || movie.trackCount != 2 || movie.fragmented { return 2 }
    const video = mp4.track(&movie, 0)
    const audio = mp4.track(&movie, 1)
    if video.*.id != 1 || video.*.kind != mp4.KIND_VIDEO || video.*.codec != mp4.CODEC_H264 { return 3 }
    if video.*.timescale != 90000 || video.*.width != 64 || video.*.height != 48 || video.*.nalLengthSize != 4 { return 4 }
    if audio.*.id != 2 || audio.*.kind != mp4.KIND_AUDIO || audio.*.codec != mp4.CODEC_AAC { return 5 }
    if audio.*.timescale != 44100 || audio.*.rate != 44100 || audio.*.channels != 2 || audio.*.audioObjectType != 2 { return 6 }
    if audio.*.editMediaTime != 2112 || audio.*.editDelay != 0 { return 7 }
    if audio.*.configLength != 2 || audio.*.config[0] != 0x12 || audio.*.config[1] != 0x10 { return 8 }
    var set: []const u8 = undefined
    if !mp4.parameterSet(video, 0, &set) || set.length != 22 || set[0] != 0x67 { return 9 }
    if !mp4.parameterSet(video, 1, &set) || set.length != 5 || set[0] != 0x68 { return 10 }
    if mp4.parameterSet(video, 2, &set) { return 11 }

    var sample: mp4.Sample = undefined
    if !mp4.nextSample(&movie, 0, &sample) { return 12 }
    if sample.size != 5 || sample.dts != 0 || sample.pts != 0 || !sample.sync || sample.duration != 3000 { return 14 }
    if plainFile[sample.offset + 4] != 0x65 { return 15 }
    if !mp4.nextSample(&movie, 0, &sample) { return 16 }
    if sample.size != 6 || sample.dts != 3000 || sample.pts != 9000 || sample.sync { return 17 }
    if !mp4.nextSample(&movie, 0, &sample) { return 18 }
    if sample.size != 7 || sample.dts != 6000 || sample.pts != 9000 || sample.sync { return 19 }
    if plainFile[sample.offset + 4] != 0x41 || plainFile[sample.offset + 5] != 0x9b { return 20 }
    // Annex B of the third sample.
    var out: [16]u8 = undefined
    if mp4.annexBSize(video, &plainFile[sample.offset], sample.size) != 7 { return 21 }
    if mp4.annexB(video, &plainFile[sample.offset], sample.size, &out, 16) != 7 || !same(&out, &ANNEX_B, 7) { return 22 }
    if mp4.nextSample(&movie, 0, &sample) { return 23 }
    // Audio: fixed sizes, one chunk after the first two video samples.
    if !mp4.nextSample(&movie, 1, &sample) { return 24 }
    if sample.size != 4 || sample.dts != 0 || sample.duration != 1024 || plainFile[sample.offset] != 0x21 || plainFile[sample.offset + 3] != 0x40 { return 25 }
    if !mp4.nextSample(&movie, 1, &sample) { return 26 }
    if sample.dts != 1024 || plainFile[sample.offset + 3] != 0x41 { return 27 }
    if mp4.nextSample(&movie, 1, &sample) { return 28 }
    // Seeking: to time 7000 the sync sample before it is the first.
    mp4.seek(&movie, 0, 7000)
    if !mp4.nextSample(&movie, 0, &sample) || sample.dts != 0 || !sample.sync { return 29 }
    if !mp4.nextSample(&movie, 0, &sample) || sample.dts != 3000 { return 30 }

    // The fragmented one: the initialization segment, then fragments.
    if mp4.parse(&movie, &initSegment, 1020, &samples, &used) != mp4.Status.ok { return 31 }
    if used != 1020 || movie.trackCount != 2 || !movie.fragmented { return 32 }
    if mp4.track(&movie, 0).*.defaultDuration != 3000 || mp4.track(&movie, 1).*.defaultSize != 4 { return 33 }
    if mp4.parse(&movie, &firstFragment, 226, &samples, &used) != mp4.Status.ok { return 34 }
    if used != 226 || samples.count != 5 || movie.sequence != 1 { return 35 }
    const s0 = samples.items[0]
    const s1 = samples.items[1]
    const s2 = samples.items[2]
    const a0 = samples.items[3]
    const a1 = samples.items[4]
    if s0.track != 0 || s0.size != 5 || s0.dts != 0 || s0.pts != 0 || !s0.sync || s0.duration != 3000 { return 36 }
    if s1.size != 6 || s1.dts != 3000 || s1.pts != 9000 || s1.sync { return 37 }
    if s2.size != 7 || s2.dts != 6000 || s2.pts != 9000 || s2.sync || firstFragment[s2.offset + 5] != 0x9b { return 38 }
    if a0.track != 1 || a0.size != 4 || a0.dts != 0 || a0.duration != 1024 || !a0.sync || firstFragment[a0.offset + 3] != 0x40 { return 39 }
    if a1.dts != 1024 || firstFragment[a1.offset + 3] != 0x41 { return 40 }
    // The second fragment has no tfdt: times continue.
    mp4.clearSamples(&samples)
    if mp4.parse(&movie, &secondFragment, 145, &samples, &used) != mp4.Status.ok { return 41 }
    if samples.count != 2 || movie.sequence != 2 { return 42 }
    if samples.items[0].dts != 9000 || samples.items[1].dts != 2048 || secondFragment[samples.items[1].offset + 3] != 0x42 { return 43 }
    // Cut short: nothing consumed, no samples; whole again later.
    mp4.clearSamples(&samples)
    if mp4.parse(&movie, &firstFragment, 200, &samples, &used) != mp4.Status.needMore { return 44 }
    if used != 0 || samples.count != 0 { return 45 }
    if mp4.parse(&movie, &firstFragment, 6, &samples, &used) != mp4.Status.needMore { return 46 }
    // Damage: mvhd larger than moov.
    var copy: [1154]u8 = plainFile
    copy[43] = 255
    if mp4.parse(&movie, &copy, 1154, &samples, &used) != mp4.Status.corrupt { return 47 }
    if mp4.parse(&movie, &plainFile, 1154, &samples, &used) != mp4.Status.ok { return 48 }
    mp4.deinitSamples(&samples)
    mp4.deinit(&movie)
    return 13
}

