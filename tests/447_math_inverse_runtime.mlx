    Known.{ .a = 5.0, .b = 12.0, .want = 0x402A000000000000 },
    Known.{ .a = 1.0, .b = 1.0, .want = 0x3FF6A09E667F3BCD },
    Known.{ .a = 0.1, .b = 0.2, .want = 0x3FCC9F25C5BFEDDA },
    Known.{ .a = 1.0e+200, .b = 1.0e+200, .want = 0x697D8F9811335B57 },
    Known.{ .a = 1.0e-200, .b = 1.0e-200, .want = 0x167151F68876F410 },
