// The furthest a function of one argument is from the `count` rows of
// its table, in doubles. The table comes as a pointer to its first row:
// a slice of it (TABLE[0..]) would copy the whole table into the value
// arena at every call.
fn furthest(table: [*]const Known, count: usize, function: fn(f64) -> f64) -> u64 {
    var most: u64 = 0
    var i: usize = 0
    while i < count {
        const distance = apart(function(table[i].a), table[i].want)
        if distance > most { most = distance }
        i += 1
    }
    return most
}

fn furthestOfTwo(table: [*]const Known, count: usize, function: fn(f64, f64) -> f64) -> u64 {
    var most: u64 = 0
    var i: usize = 0
    while i < count {
        const distance = apart(function(table[i].a, table[i].b), table[i].want)
        if distance > most { most = distance }
        i += 1
    }
    return most
}

// Each function against its table, which holds among others the
// arguments where a comparison with the exact values over 100 000 of
// them found it furthest off: the arc tangent, the angle, the length
// and cosh within 2 units in the last place, asin, acos and sinh within
// 3, tanh within 4 (its quotient of two rounded exponentials). A whole
// power is the nearest double itself, up to the largest ones, among the
// subnormals and for an exponent of 2^41; within 2 at the bottom of the
// normal doubles, where the second half of the pair it is worked out in
// falls among the subnormals, and for an exponent of 52 bits.
fn knownValues() -> u8 {
    if furthest(&ATAN, ATAN.length, math.atan) > 2 { return 170 }
    if furthestOfTwo(&ATAN2, ATAN2.length, math.atan2) > 2 { return 171 }
    if furthest(&ASIN, ASIN.length, math.asin) > 3 { return 172 }
    if furthest(&ACOS, ACOS.length, math.acos) > 3 { return 173 }
    if furthest(&SINH, SINH.length, math.sinh) > 3 { return 174 }
    if furthest(&COSH, COSH.length, math.cosh) > 2 { return 175 }
    if furthest(&TANH, TANH.length, math.tanh) > 4 { return 176 }
    if furthestOfTwo(&HYPOT, HYPOT.length, math.hypot) > 2 { return 177 }
    if furthestOfTwo(&POWR, POWR.length, math.powr) > 0 { return 178 }
    if furthestOfTwo(&POWR_LOW, POWR_LOW.length, math.powr) > 2 { return 179 }
    return 0
}

// 4096 points around the origin, none on an axis, at five sizes from
// 1e-300 to 1e300: the angle lies in the point's quadrant, the length
// between its longer side and the sum of both, and the two give the
// point back through sin and cos to a few roundings of the length
// (3e-15 of it: the angle's 2 units in the last place near pi, the
// length's 2, the sine's and the product's).
fn pointsAround() -> u8 {
    var i: i64 = 0
    while i < 64 {
        var j: i64 = 0
        while j < 64 {
            const pick = (i * 7 + j * 3) % 5
            const size: f64 = if pick == 0 { 1.0 } else if pick == 1 { 1.0e-150 } else if pick == 2 { 1.0e150 } else if pick == 3 { 1.0e-300 } else { 1.0e300 }
            const x = (@floatFromInt(f64, i) - 31.5) * 0.37 * size
            const y = (@floatFromInt(f64, j) - 31.5) * 0.53 * size
            const length = math.hypot(x, y)
            const angle = math.atan2(y, x)
            if (angle > 0.0) != (y > 0.0) || (math.abs(angle) < HALF_PI) != (x > 0.0) || math.abs(angle) >= math.pi { return 180 }
            if length < math.max(math.abs(x), math.abs(y)) || length > math.abs(x) + math.abs(y) { return 181 }
            if math.abs(math.sin(angle) * length - y) > 3.0e-15 * length { return 182 }
            if math.abs(math.cos(angle) * length - x) > 3.0e-15 * length { return 183 }
            // Mirrored at the x axis the angle changes its sign and no bit
            // more; the length does not care about signs or order.
            if !same(math.atan2(-y, x), -angle) { return 184 }
            if !same(math.hypot(-x, y), length) || !same(math.hypot(y, x), length) { return 185 }
            j += 1
        }
        i += 1
    }
    return 0
}

// tan undoes atan. An error e of the angle is (1 + x^2) e in the
// tangent, so what is allowed grows with x: 1.5e-15 |x| (1 + |x|), a
// few units in the last place of x while x is small. From -20 to 20 in
// steps of 0.01, where the angle also has to rise with x, and from 2e-9
// to 2e6 in steps of 1.2 percent, both signs.
fn tangentBack() -> u8 {
    var before: f64 = -HALF_PI
    var n: i64 = 0
    while n <= 4000 {
        const x = @floatFromInt(f64, n - 2000) * 0.01
        const angle = math.atan(x)
        if !(angle > before) || !(math.abs(angle) < HALF_PI) { return 190 }
        if math.abs(math.tan(angle) - x) > 1.5e-15 * math.abs(x) * (1.0 + math.abs(x)) { return 191 }
        if !same(math.atan(-x), -angle) { return 192 }
        // The angle of the point (1, x) and of any point on its ray.
        if !same(math.atan2(x, 1.0), angle) || !same(math.atan2(x * 8.0, 8.0), angle) { return 193 }
        before = angle
        n += 1
    }
    n = 0
    while n < 3000 {
        const x = math.exp(@floatFromInt(f64, n) * 0.0115 - 20.0)
        const allowed = 1.5e-15 * x * (1.0 + x)
        if math.abs(math.tan(math.atan(x)) - x) > allowed || math.abs(math.tan(math.atan(-x)) + x) > allowed { return 194 }
        // atan x and atan(1/x) are the two angles of one right triangle.
        if math.abs(math.atan(x) + math.atan(1.0 / x) - HALF_PI) > 1.0e-15 { return 195 }
        n += 1
    }
    return 0
}

// asin undoes sin on -pi/2..pi/2 and acos undoes cos on 0..pi, as far
// as the sine and cosine hold the angle: near their ends they change by
// cos x (sin x) times the angle's change, so a rounding of theirs is
// 1 / cos x (1 / sin x) roundings of the angle. The other way round
// nothing is lost: sin(asin v) and cos(acos v) are v to a few roundings,
// and the two angles add up to pi/2.
fn sinesBack() -> u8 {
    var n: i64 = 0
    while n <= 4000 {
        const x = math.clamp(@floatFromInt(f64, n - 2000) * (math.pi / 4000.0), -HALF_PI, HALF_PI)
        if math.abs(math.asin(math.sin(x)) - x) > 5.0e-16 * (1.0 + 1.0 / math.abs(math.cos(x))) { return 200 }
        const t = math.clamp(@floatFromInt(f64, n) * (math.pi / 4000.0), 0.0, math.pi)
        if math.abs(math.acos(math.cos(t)) - t) > 6.0e-16 * (1.0 + 1.0 / math.max(math.abs(math.sin(t)), 1.0e-300)) { return 201 }

        const v = @floatFromInt(f64, n - 2000) / 2000.0
        const up = math.asin(v)
        const across = math.acos(v)
        if math.abs(up) > HALF_PI || across < 0.0 || across > math.pi { return 202 }
        if math.abs(math.sin(up) - v) > 6.0e-16 || math.abs(math.cos(across) - v) > 1.2e-15 { return 203 }
        if math.abs(up + across - HALF_PI) > 1.5e-15 { return 204 }
        if !same(math.asin(-v), -up) { return 205 }
        n += 1
    }
    // The ends themselves are exact.
    if !same(math.asin(math.sin(HALF_PI)), HALF_PI) || !same(math.acos(math.cos(0.0)), 0.0) { return 206 }
    return 0
}

// The hyperbolic three from -20 to 20 in steps of 0.01: tanh is sinh
// over cosh, cosh^2 - sinh^2 is 1 (as a product of the difference and
// the sum, measured by cosh^2, which is what the squares' roundings
// are measured by), cosh + sinh is e^|x|; sinh and tanh are odd and
// cosh is even to the bit; tanh stays inside -1..1 and cosh above 1.
fn hyperbolicTogether() -> u8 {
    var n: i64 = 0
    while n <= 4000 {
        const x = @floatFromInt(f64, n - 2000) * 0.01
        const s = math.sinh(x)
        const c = math.cosh(x)
        const t = math.tanh(x)
        if math.abs(t - s / c) > 2.0e-15 * math.abs(t) { return 210 }
        if math.abs((c - s) * (c + s) - 1.0) > 2.0e-15 * c * c { return 211 }
        const grown = math.exp(math.abs(x))
        if math.abs(c + math.abs(s) - grown) > 1.5e-15 * grown { return 212 }
        if !same(math.sinh(-x), -s) || !same(math.cosh(-x), c) || !same(math.tanh(-x), -t) { return 213 }
        if math.abs(t) > 1.0 || c < 1.0 || (s > 0.0) != (x > 0.0) || (t > 0.0) != (x > 0.0) { return 214 }
        n += 1
    }
    return 0
}

// Whether `function` does not fall over the `count` doubles below and
// above `center` (positive): rising functions are made of pieces here,
// and the pieces have to meet without a step back.
fn risesAcross(center: f64, count: u64, function: fn(f64) -> f64) -> bool {
    var at = bits(center) - count
    var before = function(@bitCast(f64, at))
    var i: u64 = 0
    while i < 2 * count {
        at += 1
        const value = function(@bitCast(f64, at))
        if value < before { return false }
        before = value
        i += 1
    }
    return true
}

// The seams of the pieces: atan changes its table entry at the odd
// sixteenths, turns to pi/2 - atan(1/x) at 1 (and so has the seams
// again at 16/k), and ends its series at 2^-27 and its range at 2^66;
// sinh changes its way at 2^-28, 1, 22 and 709.78, cosh at ln 2 / 2,
// 22 and 709.78, tanh at 2^-28 and 22. Each of them rises (cosh on the
// positive side), so the doubles nearest it never fall.
fn seams() -> u8 {
    var k: f64 = 1.0
    while k < 16.0 {
        if !risesAcross(k / 16.0, 1000, math.atan) || !risesAcross(16.0 / k, 1000, math.atan) { return 230 }
        k += 2.0
    }
    if !risesAcross(1.0, 5000, math.atan) || !risesAcross(twoTo(-27), 1000, math.atan) || !risesAcross(twoTo(66), 1000, math.atan) { return 231 }
    if !risesAcross(twoTo(-28), 1000, math.sinh) || !risesAcross(1.0, 1000, math.sinh) || !risesAcross(22.0, 1000, math.sinh) || !risesAcross(709.7822265625, 1000, math.sinh) { return 232 }
    if !risesAcross(0.5 * math.ln2, 1000, math.cosh) || !risesAcross(22.0, 1000, math.cosh) || !risesAcross(709.7822265625, 1000, math.cosh) { return 233 }
    if !risesAcross(twoTo(-28), 1000, math.tanh) || !risesAcross(22.0, 1000, math.tanh) { return 234 }
    return 0
}

// Twenty thousand calls of each leave the value arena's fill where it
// was (a page of slack; a value a call took from it would be megabytes
// by then), so a loop over pixels may call them; and they take nothing
// from the heap.
fn arenaAlone() -> u8 {
    const arena = turns.locate()
    const before = turns.used(arena)
    const held = std.heap.liveBytes()
    var total: f64 = 0.0
    var n: usize = 0
    while n < 20000 {
        // From -9.9995 up: never 0, where the negative power is infinite.
        const x = @floatFromInt(f64, n) * 0.001 - 9.9995
        total += math.atan(x) + math.atan2(x, 3.0) + math.asin(x * 0.09) + math.acos(x * 0.09) + math.hypot(x, 2.0) + math.fmod(x, 0.7)
        total += math.sinh(x) + math.cosh(x) + math.tanh(x) + math.powr(x, 7.0) + math.powr(x, -3.0) + math.sign(x) + math.lerp(x, 1.0, 0.5)
        // fmod's longest way (a thousand halvings), a power of 40 bits,
        // and lerp's ends of opposite signs.
        total += math.fmod(x * 1.0e300, 0.7) + math.powr(1.0 + x * 1.0e-12, 1.0e12) + math.lerp(x, -x, 0.3)
        n += 1
    }
    if !(math.abs(total) < math.infinity()) { return 220 }
    if turns.used(arena) - before > 4096 { return 221 }
    if std.heap.liveBytes() != held { return 222 }
    return 0
}

pub fn main() -> u8 {
    // The largest double, as this file writes it.
    if bits(LARGEST) != 0x7FEFFFFFFFFFFFFF { return 12 }
    var failed = signAndLerp()
    if failed != 0 { return failed }
    failed = lerpExact()
    if failed != 0 { return failed }
    failed = lerpMonotone()
    if failed != 0 { return failed }
    failed = remainder()
    if failed != 0 { return failed }
    failed = lengths()
    if failed != 0 { return failed }
    failed = arcTangent()
    if failed != 0 { return failed }
    failed = angles()
    if failed != 0 { return failed }
    failed = arcSineAndCosine()
    if failed != 0 { return failed }
    failed = hyperbolic()
    if failed != 0 { return failed }
    failed = powers()
    if failed != 0 { return failed }
    failed = knownValues()
    if failed != 0 { return failed }
    failed = pointsAround()
    if failed != 0 { return failed }
    failed = tangentBack()
    if failed != 0 { return failed }
    failed = sinesBack()
    if failed != 0 { return failed }
    failed = hyperbolicTogether()
    if failed != 0 { return failed }
    failed = seams()
    if failed != 0 { return failed }
    failed = arenaAlone()
    if failed != 0 { return failed }
    return 13
}
