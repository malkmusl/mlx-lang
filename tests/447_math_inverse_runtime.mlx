    Known.{ .a = -0.9976184581935973, .b = 257526.0, .want = 0x089178C27E0028D8 },
}

const POWR_LOW: [6]Known = [6]Known{
    Known.{ .a = 1.4516797575543123e-77, .b = 4.0, .want = 0x001FEF3532734708 },
