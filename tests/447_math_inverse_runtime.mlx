// std.math's inverse and hyperbolic functions and the helpers beside
// them: sign, lerp, fmod, hypot, atan, atan2, asin, acos, sinh, cosh,
// tanh and powr.
//
// The cases with one right answer, bit for bit: atan2 in each quadrant,
// on the axes, with either zero and with infinities; asin and acos at
// -1, 0 and 1 and outside; hypot of sizes whose squares leave the
// doubles' range at either end; fmod's signs, its zeros and remainders
// no rounded division finds (across 900 binary places, among the
// subnormals); the powers of whole numbers, to the infinite ones too;
// lerp between ends of opposite signs as far apart as doubles go; NaN
// in and out everywhere. Known values against the correctly rounded
// double (worked out to 110 digits), within the units in the last place
// each function keeps. Identities over sweeps of a few thousand
// arguments each: atan2 and hypot give back the point through sin and
// cos, tan undoes atan, asin undoes sin, the hyperbolic three fit each
// other and e^x, fmod is the integers' remainder, lerp and powr hit
// what integer arithmetic makes of the same numbers, lerp stays between
// its ends and never turns back. The rising functions do not fall
// where their pieces meet. And none of them takes from the value arena
// or the heap, so they can be called for every pixel. Exits 13 when
// every check holds, else the number of the first check that failed.
const std = @import("std")
const math = @import("std.math")
const turns = @import("std.turns")

const HALF_PI: f64 = 1.5707963267948966
const QUARTER_PI: f64 = 0.7853981633974483
const THREE_QUARTER_PI: f64 = 2.356194490192345
// The largest double.
const LARGEST: f64 = 1.7976931348623157e308

inline fn bits(x: f64) -> u64 { return @bitCast(u64, x) }

// The same double: -0.0 is not 0.0 here, as it is not for the caller who
// divides by it or asks atan2 with it.
fn same(got: f64, want: f64) -> bool { return bits(got) == bits(want) }

// 2^k for k from -1022 to 1023.
fn twoTo(k: i64) -> f64 { return @bitCast(f64, @intCast(u64, k + 1023) << 52) }

// The smallest double above 0 (2^-1074), `count` times: exact up to 2^52.
fn tiny(count: u64) -> f64 { return @bitCast(f64, count) }

// How many doubles lie between `got` and the double with the bits `want`
// (0: the same), as far as can be when the signs differ or `got` is NaN.
fn apart(got: f64, want: u64) -> u64 {
    const have = bits(got)
    if got != got || (have ^ want) >> 63 != 0 { return 18446744073709551615 }
    return if have > want { have - want } else { want - have }
}

// A generator of the test's own (a linear congruence, its high 53 bits),
// so the sweeps are the same on every run.
fn next(state: *u64) -> u64 {
    state.* = state.* *% 6364136223846793005 +% 1442695040888963407
    return state.* >> 11
}

// A double in [0, 1).
fn unit(state: *u64) -> f64 { return @floatFromInt(f64, next(state)) * twoTo(-53) }

fn signAndLerp() -> u8 {
    const nan = math.nan()
    if math.sign(3.5) != 1.0 || math.sign(-0.25) != -1.0 { return 1 }
    if math.sign(tiny(1)) != 1.0 || math.sign(-LARGEST) != -1.0 { return 2 }
    if math.sign(math.infinity()) != 1.0 || math.sign(math.negativeInfinity()) != -1.0 { return 3 }
    // Either zero is 0.0, with no sign left to mislead a division.
    if !same(math.sign(0.0), 0.0) || !same(math.sign(-0.0), 0.0) { return 4 }
    if !math.isNan(math.sign(nan)) { return 5 }

    if math.lerp(2.0, 10.0, 0.0) != 2.0 || math.lerp(2.0, 10.0, 1.0) != 10.0 { return 6 }
    if math.lerp(2.0, 10.0, 0.25) != 4.0 || math.lerp(10.0, 2.0, 0.75) != 4.0 { return 7 }
    // Past the ends the line goes on.
    if math.lerp(2.0, 10.0, 1.5) != 14.0 || math.lerp(2.0, 10.0, -0.5) != -2.0 { return 8 }
    // At 1 it is b itself, where a + (b - a) has lost b in a's size.
    const far: f64 = 1.0e16
    const near: f64 = 1.0
    if far + (near - far) == near { return 9 }
    if math.lerp(far, near, 1.0) != 1.0 || math.lerp(near, far, 1.0) != 1.0e16 || math.lerp(far, near, 0.0) != 1.0e16 { return 10 }
    // Between a value and itself there is only that value (the sum of
    // two weighted halves, a (1 - t) + a t, misses 0.9 at 0.2).
    if math.lerp(0.9, 0.9, 0.2) != 0.9 || math.lerp(0.1, 0.1, 0.3) != 0.1 || math.lerp(-3.0e300, -3.0e300, 0.7) != -3.0e300 { return 11 }
    // Ends of opposite signs as far apart as doubles go: b - a would be
    // infinite, and infinity times 0 NaN at the very start.
    if !same(math.lerp(-LARGEST, LARGEST, 0.0), -LARGEST) || !same(math.lerp(-LARGEST, LARGEST, 1.0), LARGEST) { return 14 }
    if math.lerp(-LARGEST, LARGEST, 0.5) != 0.0 || math.lerp(LARGEST, -LARGEST, 0.5) != 0.0 || math.lerp(-twoTo(1023), twoTo(1023), 0.75) != twoTo(1022) { return 15 }
    if math.lerp(-1.0, 3.0, 0.5) != 1.0 || math.lerp(-2.0, 0.0, 0.25) != -1.5 || math.lerp(-1.0, 3.0, 1.5) != 5.0 || math.lerp(-1.0, 3.0, -0.5) != -3.0 { return 16 }
    if !math.isNan(math.lerp(nan, 1.0, 0.5)) || !math.isNan(math.lerp(1.0, nan, 0.5)) || !math.isNan(math.lerp(1.0, 2.0, nan)) || !math.isNan(math.lerp(-1.0, 2.0, nan)) { return 17 }
    return 0
}

// lerp against the integers: for whole a and b below 2^29 and t = k/1024
// the point on the line, (1024 a + k (b - a)) / 1024, is a double, and
// lerp has to hit it (every step of either way of working it out is
// exact there). From t = -1/2 to 3/2, all four sign pairs.
fn lerpExact() -> u8 {
    var state: u64 = 4471
    var round: usize = 0
    while round < 400 {
        const a = @intCast(i64, next(&state) >> 23) - 536870912
        const b = @intCast(i64, next(&state) >> 23) - 536870912
        const left = @floatFromInt(f64, a)
        const right = @floatFromInt(f64, b)
        var k: i64 = -512
        while k <= 1536 {
            const want = @floatFromInt(f64, 1024 * a + k * (b - a)) / 1024.0
            if math.lerp(left, right, @floatFromInt(f64, k) / 1024.0) != want { return 18 }
            k += 7
        }
        round += 1
    }
    return 0
}

// lerp from a to b keeps between them for t in 0..1 and never turns
// back: over the 200 doubles next to 0 and the 200 below 1 (where a
// rounding of a + (b - a) t is the most likely to carry it past b) and
// on through the 199 above 1, for ends of every size and sign pair. And
// it starts at a and ends at b exactly.
fn lerpMonotone() -> u8 {
    var state: u64 = 4472
    var round: usize = 0
    while round < 2000 {
        const scale = twoTo(@intCast(i64, next(&state) % 120) - 60)
        const a = (unit(&state) - 0.5) * scale
        const b = if round % 3 == 0 { (unit(&state) - 0.5) * scale * 1.0e-3 } else { (unit(&state) - 0.5) * scale }
        const low = math.min(a, b)
        const high = math.max(a, b)
        if !same(math.lerp(a, b, 0.0), a) || !same(math.lerp(a, b, 1.0), b) { return 19 }
        var before = math.lerp(a, b, 0.0)
        var step: usize = 0
        while step < 600 {
            // The 200 doubles above 0, then from 200 below 1 to 199 above.
            const t = if step < 200 { tiny(@intCast(u64, step + 1)) } else { @bitCast(f64, bits(1.0) - 200 + @intCast(u64, step - 200)) }
            const value = math.lerp(a, b, t)
            if t <= 1.0 && (value < low || value > high) { return 44 }
            if (b > a && value < before) || (b < a && value > before) { return 45 }
            before = value
            step += 1
        }
        round += 1
    }
    return 0
}

fn remainder() -> u8 {
    const nan = math.nan()
    const infinity = math.infinity()
    // The remainder has the sign of what is divided, whatever divides.
    if math.fmod(10.0, 3.0) != 1.0 || math.fmod(-10.0, 3.0) != -1.0 { return 20 }
    if math.fmod(10.0, -3.0) != 1.0 || math.fmod(-10.0, -3.0) != -1.0 { return 21 }
    if math.fmod(5.5, 2.0) != 1.5 || math.fmod(-5.5, 2.0) != -1.5 || math.fmod(7.25, 0.5) != 0.25 { return 22 }
    // Nothing left over is a zero of that sign too.
    if !same(math.fmod(6.0, 3.0), 0.0) || !same(math.fmod(-6.0, 3.0), -0.0) || !same(math.fmod(6.0, -3.0), 0.0) { return 23 }
    if !same(math.fmod(0.0, 3.0), 0.0) || !same(math.fmod(-0.0, 3.0), -0.0) || !same(math.fmod(-0.0, -3.0), -0.0) { return 24 }
    // What is smaller than the divisor stays as it is.
    if !same(math.fmod(2.0, 3.0), 2.0) || !same(math.fmod(-2.0, 3.0), -2.0) || !same(math.fmod(tiny(1), 1.0), tiny(1)) { return 25 }
    if !same(math.fmod(7.5, infinity), 7.5) || !same(math.fmod(-7.5, -infinity), -7.5) || !same(math.fmod(-0.0, infinity), -0.0) { return 26 }
    // No remainder: of a NaN, of an infinity, by zero.
    if !math.isNan(math.fmod(nan, 1.0)) || !math.isNan(math.fmod(1.0, nan)) || !math.isNan(math.fmod(nan, nan)) { return 27 }
    if !math.isNan(math.fmod(infinity, 1.0)) || !math.isNan(math.fmod(-infinity, 1.0)) || !math.isNan(math.fmod(infinity, infinity)) { return 28 }
    if !math.isNan(math.fmod(1.0, 0.0)) || !math.isNan(math.fmod(1.0, -0.0)) || !math.isNan(math.fmod(0.0, 0.0)) { return 29 }
    // The doubles nearest 0.3 and 0.1: their remainder is this double
    // exactly (0.3 is a little under three times 0.1), not a rounded one.
    if bits(math.fmod(0.3, 0.1)) != 0x3FB9999999999998 { return 30 }
    // 5 2^1000 is 2 more than a multiple of 3 (2^1000 is 1 more, 5 is 2
    // more); the largest double is (2^53 - 1) 2^971, 2 more as well.
    if math.fmod(5.0 * twoTo(1000), 3.0) != 2.0 || math.fmod(-5.0 * twoTo(1000), 3.0) != -2.0 { return 31 }
    if math.fmod(LARGEST, 3.0) != 2.0 { return 32 }
    // Every double is a multiple of the smallest; 1 is 2^1074 of them,
    // which is 1 more than a multiple of 3.
    if !same(math.fmod(LARGEST, tiny(1)), 0.0) || !same(math.fmod(-1.0, tiny(1)), -0.0) { return 33 }
    if !same(math.fmod(1.0, tiny(3)), tiny(1)) || !same(math.fmod(tiny(7), tiny(3)), tiny(1)) { return 34 }
    if !same(math.fmod(twoTo(-1022), tiny(5)), tiny(1)) { return 35 }

    // Against the integers' own remainder: whole numbers up to 2^53 by
    // divisors of every size, the same 30 binary places down, a dividend
    // 900 places up (2^900 a mod m from the remainders of a and of 2^900),
    // and both among the subnormals.
    var state: u64 = 447
    var round: usize = 0
    while round < 3000 {
        const a = next(&state)
        const b = 1 + (next(&state) >> @intCast(u6, round % 53))
        const whole = @floatFromInt(f64, a)
        const divisor = @floatFromInt(f64, b)
        const left = @floatFromInt(f64, a % b)
        if !same(math.fmod(whole, divisor), left) || !same(math.fmod(whole, -divisor), left) { return 36 }
        if !same(math.fmod(-whole, divisor), -left) || !same(math.fmod(-whole, -divisor), -left) { return 37 }
        if !same(math.fmod(whole * twoTo(-30), divisor * twoTo(-30)), left * twoTo(-30)) { return 38 }

        const m = (next(&state) >> 33) | 1
        var power: u64 = 1
        var doubling: usize = 0
        while doubling < 900 {
            power = (power * 2) % m
            doubling += 1
        }
        const high = @floatFromInt(f64, ((a % m) * power) % m)
        if !same(math.fmod(whole * twoTo(900), @floatFromInt(f64, m)), high) { return 39 }

        const small = next(&state) >> 23
        const smaller = 1 + (next(&state) >> 41)
        if !same(math.fmod(tiny(small), tiny(smaller)), tiny(small % smaller)) { return 40 }

        // Any two doubles: less than the divisor is left, with the
        // dividend's sign, and what went is a whole number of divisors
        // (as close as x - r and its quotient round: two roundings), no
        // more of them than x / y holds.
        const x = (unit(&state) - 0.5) * 2097152.0
        const y = (unit(&state) - 0.5) * 2048.0
        const r = math.fmod(x, y)
        if !(math.abs(r) < math.abs(y)) || bits(r) >> 63 != bits(x) >> 63 { return 41 }
        const times = (x - r) / y
        const count = math.round(times)
        if math.abs(times - count) > 4.0e-16 * math.abs(count) || math.abs(count) > math.abs(x / y) { return 42 }
        round += 1
    }
    return 0
}

fn lengths() -> u8 {
    const nan = math.nan()
    const infinity = math.infinity()
    if math.hypot(3.0, 4.0) != 5.0 || math.hypot(-3.0, 4.0) != 5.0 || math.hypot(3.0, -4.0) != 5.0 || math.hypot(-4.0, -3.0) != 5.0 { return 50 }
    if !same(math.hypot(0.0, 0.0), 0.0) || !same(math.hypot(-0.0, -0.0), 0.0) { return 51 }
    if math.hypot(0.0, -7.0) != 7.0 || math.hypot(7.0, -0.0) != 7.0 || math.hypot(tiny(1), 0.0) != tiny(1) { return 52 }
    // Sizes whose squares are no doubles: 9 2^2000 overflows, 9 2^-2000
    // and the subnormals' squares are 0.
    if math.hypot(3.0 * twoTo(1000), 4.0 * twoTo(1000)) != 5.0 * twoTo(1000) { return 53 }
    if math.hypot(3.0 * twoTo(-1000), -4.0 * twoTo(-1000)) != 5.0 * twoTo(-1000) { return 54 }
    if math.hypot(tiny(3), tiny(4)) != tiny(5) || math.hypot(tiny(12), tiny(5)) != tiny(13) { return 55 }
    if math.hypot(LARGEST, 0.0) != LARGEST || math.hypot(1.0, LARGEST) != LARGEST { return 56 }
    // Only a length past the largest double is infinite.
    if math.hypot(LARGEST, LARGEST) != infinity || math.hypot(1.2e308, 1.2e308) == infinity { return 57 }
    // An infinite side makes an infinite length, whatever the other is.
    if math.hypot(infinity, 1.0) != infinity || math.hypot(1.0, -infinity) != infinity || math.hypot(-infinity, infinity) != infinity { return 58 }
    if math.hypot(infinity, nan) != infinity || math.hypot(nan, -infinity) != infinity { return 59 }
    if !math.isNan(math.hypot(nan, 1.0)) || !math.isNan(math.hypot(1.0, nan)) || !math.isNan(math.hypot(nan, nan)) { return 60 }
    return 0
}

fn arcTangent() -> u8 {
    if !same(math.atan(0.0), 0.0) || !same(math.atan(-0.0), -0.0) { return 61 }
    if !same(math.atan(1.0), QUARTER_PI) || !same(math.atan(-1.0), -QUARTER_PI) { return 62 }
    if !same(math.atan(math.infinity()), HALF_PI) || !same(math.atan(math.negativeInfinity()), -HALF_PI) { return 63 }
    if !same(math.atan(LARGEST), HALF_PI) || !same(math.atan(-1.0e30), -HALF_PI) { return 64 }
    // So small that the angle is the tangent, down to the last double.
    if !same(math.atan(1.0e-300), 1.0e-300) || !same(math.atan(-tiny(1)), -tiny(1)) || !same(math.atan(1.0e-9), 1.0e-9) { return 65 }
    if !math.isNan(math.atan(math.nan())) { return 66 }
    // At the eighths, where the series has nothing to add, the angle is
    // the nearest double to atan(k/8) itself, of either sign.
    var k: usize = 1
    while k <= 8 {
        const x = @floatFromInt(f64, k) * 0.125
        if bits(math.atan(x)) != ATAN_EIGHTHS[k] || bits(math.atan(-x)) != ATAN_EIGHTHS[k] | 0x8000000000000000 { return 67 }
        k += 1
    }
    return 0
}

// The doubles nearest atan(k/8), k from 0 to 8.
const ATAN_EIGHTHS: [9]u64 = [9]u64{
    0x0000000000000000, 0x3FBFD5BA9AAC2F6E, 0x3FCF5B75F92C80DD, 0x3FD6F61941E4DEF1, 0x3FDDAC670561BB4F,
    0x3FE1E00BABDEFEB4, 0x3FE4978FA3269EE1, 0x3FE700A7C5784634, 0x3FE921FB54442D18,
}

fn angles() -> u8 {
    const nan = math.nan()
    const infinity = math.infinity()
    // The diagonals of the four quadrants, counted from the positive x
    // axis toward the positive y axis.
    if !same(math.atan2(1.0, 1.0), QUARTER_PI) || !same(math.atan2(-1.0, 1.0), -QUARTER_PI) { return 70 }
    if math.atan2(5.0, -5.0) != THREE_QUARTER_PI || math.atan2(-5.0, -5.0) != -THREE_QUARTER_PI { return 71 }
    if math.atan2(3.0, 3.0) != QUARTER_PI || math.atan2(-0.25, 0.25) != -QUARTER_PI { return 72 }
    // The axes. Right: the zero of y's sign.
    if !same(math.atan2(0.0, 5.0), 0.0) || !same(math.atan2(-0.0, 5.0), -0.0) || !same(math.atan2(0.0, 1.0), 0.0) || !same(math.atan2(-0.0, 1.0), -0.0) { return 73 }
    // Left: pi, from above and from below.
    if !same(math.atan2(0.0, -5.0), math.pi) || !same(math.atan2(-0.0, -5.0), -math.pi) { return 74 }
    // Up and down.
    if !same(math.atan2(3.0, 0.0), HALF_PI) || !same(math.atan2(3.0, -0.0), HALF_PI) { return 75 }
    if !same(math.atan2(-3.0, 0.0), -HALF_PI) || !same(math.atan2(-3.0, -0.0), -HALF_PI) { return 76 }
    if !same(math.atan2(tiny(1), 0.0), HALF_PI) || !same(math.atan2(-LARGEST, -0.0), -HALF_PI) { return 77 }
    // The origin itself: the sign of the x zero says right or left.
    if !same(math.atan2(0.0, 0.0), 0.0) || !same(math.atan2(-0.0, 0.0), -0.0) { return 78 }
    if !same(math.atan2(0.0, -0.0), math.pi) || !same(math.atan2(-0.0, -0.0), -math.pi) { return 79 }
    // An infinite x: right or left, y's sign kept.
    if !same(math.atan2(1.0, infinity), 0.0) || !same(math.atan2(-1.0, infinity), -0.0) || !same(math.atan2(0.0, infinity), 0.0) || !same(math.atan2(-0.0, infinity), -0.0) { return 80 }
    if !same(math.atan2(1.0, -infinity), math.pi) || !same(math.atan2(-1.0, -infinity), -math.pi) || !same(math.atan2(0.0, -infinity), math.pi) || !same(math.atan2(-0.0, -infinity), -math.pi) { return 81 }
    // An infinite y: up or down.
    if !same(math.atan2(infinity, 1.0), HALF_PI) || !same(math.atan2(-infinity, 1.0), -HALF_PI) { return 82 }
    if !same(math.atan2(infinity, -7.0), HALF_PI) || !same(math.atan2(-infinity, 0.0), -HALF_PI) || !same(math.atan2(infinity, -0.0), HALF_PI) { return 83 }
    // Both infinite: the diagonals.
    if !same(math.atan2(infinity, infinity), QUARTER_PI) || !same(math.atan2(-infinity, infinity), -QUARTER_PI) { return 84 }
    if !same(math.atan2(infinity, -infinity), THREE_QUARTER_PI) || !same(math.atan2(-infinity, -infinity), -THREE_QUARTER_PI) { return 85 }
    // A quotient past the doubles' range at either end.
    if !same(math.atan2(1.0e300, 1.0e-300), HALF_PI) || !same(math.atan2(-1.0e300, 1.0e-300), -HALF_PI) { return 86 }
    if !same(math.atan2(1.0e-300, 1.0e300), 0.0) || !same(math.atan2(-1.0e-300, 1.0e300), -0.0) { return 87 }
    if !same(math.atan2(1.0e-300, -1.0e300), math.pi) || !same(math.atan2(-1.0e-300, -1.0e300), -math.pi) { return 88 }
    // NaN from a NaN, beside anything.
    if !math.isNan(math.atan2(nan, 1.0)) || !math.isNan(math.atan2(1.0, nan)) || !math.isNan(math.atan2(nan, nan)) { return 89 }
    if !math.isNan(math.atan2(nan, infinity)) || !math.isNan(math.atan2(infinity, nan)) || !math.isNan(math.atan2(0.0, nan)) || !math.isNan(math.atan2(nan, 0.0)) { return 90 }
    return 0
}

fn arcSineAndCosine() -> u8 {
    const nan = math.nan()
    const infinity = math.infinity()
    // 1 with its last bit set: the first double past the domain.
    const past: f64 = 1.0000000000000002
    if !same(math.asin(0.0), 0.0) || !same(math.asin(-0.0), -0.0) { return 100 }
    if !same(math.asin(1.0), HALF_PI) || !same(math.asin(-1.0), -HALF_PI) { return 101 }
    if !same(math.asin(1.0e-300), 1.0e-300) || !same(math.asin(-tiny(1)), -tiny(1)) { return 102 }
    if !math.isNan(math.asin(past)) || !math.isNan(math.asin(-past)) || !math.isNan(math.asin(-1.5)) { return 103 }
    if !math.isNan(math.asin(infinity)) || !math.isNan(math.asin(-infinity)) || !math.isNan(math.asin(nan)) { return 104 }

    if !same(math.acos(1.0), 0.0) || !same(math.acos(-1.0), math.pi) { return 105 }
    if !same(math.acos(0.0), HALF_PI) || !same(math.acos(-0.0), HALF_PI) { return 106 }
    if !math.isNan(math.acos(past)) || !math.isNan(math.acos(-past)) || !math.isNan(math.acos(-2.0)) { return 107 }
    if !math.isNan(math.acos(infinity)) || !math.isNan(math.acos(-infinity)) || !math.isNan(math.acos(nan)) { return 108 }
    return 0
}

fn hyperbolic() -> u8 {
    const nan = math.nan()
    const infinity = math.infinity()
    if !same(math.sinh(0.0), 0.0) || !same(math.sinh(-0.0), -0.0) { return 120 }
    if !same(math.sinh(1.0e-300), 1.0e-300) || !same(math.sinh(-tiny(1)), -tiny(1)) { return 121 }
    if math.sinh(infinity) != infinity || math.sinh(-infinity) != -infinity || !math.isNan(math.sinh(nan)) { return 122 }
    // The largest double is e^709.78; half of e^710.4 still fits.
    if math.sinh(710.4) == infinity || math.sinh(-710.4) == -infinity { return 123 }
    if math.sinh(711.0) != infinity || math.sinh(-711.0) != -infinity || math.sinh(1.0e300) != infinity { return 124 }

    if math.cosh(0.0) != 1.0 || math.cosh(-0.0) != 1.0 || math.cosh(1.0e-300) != 1.0 || math.cosh(-1.0e-9) != 1.0 { return 125 }
    if math.cosh(infinity) != infinity || math.cosh(-infinity) != infinity || !math.isNan(math.cosh(nan)) { return 126 }
    if math.cosh(710.4) == infinity || math.cosh(711.0) != infinity || math.cosh(-711.0) != infinity { return 127 }

    if !same(math.tanh(0.0), 0.0) || !same(math.tanh(-0.0), -0.0) { return 128 }
    if !same(math.tanh(1.0e-300), 1.0e-300) || !same(math.tanh(-tiny(1)), -tiny(1)) { return 129 }
    if math.tanh(infinity) != 1.0 || math.tanh(-infinity) != -1.0 || !math.isNan(math.tanh(nan)) { return 130 }
    // From 22 on 1 is the nearest double.
    if math.tanh(22.0) != 1.0 || math.tanh(-22.0) != -1.0 || math.tanh(800.0) != 1.0 || math.tanh(-LARGEST) != -1.0 { return 131 }
    // 1 - tanh x is 2 e^-2x to the last digits here: 6.3e-17 at 19, more
    // than the half step (2^-54, 5.55e-17) to the double below 1, which is
    // the nearest; 2.3e-17 at 19.5, where 1 is.
    if !(math.tanh(19.0) < 1.0) || !(math.tanh(-19.0) > -1.0) || math.tanh(19.5) != 1.0 || math.tanh(-19.5) != -1.0 { return 132 }
    return 0
}

fn powers() -> u8 {
    const nan = math.nan()
    const infinity = math.infinity()
    // A negative base with a whole exponent: the sign of an odd power.
    if math.powr(-2.0, 3.0) != -8.0 || math.powr(-2.0, 2.0) != 4.0 || math.powr(-2.0, -3.0) != -0.125 || math.powr(-2.0, -2.0) != 0.25 { return 140 }
    if math.powr(-1.0, 1023.0) != -1.0 || math.powr(-1.0, 1024.0) != 1.0 || math.powr(-1.0, -7.0) != -1.0 { return 141 }
    // Whole exponents come out exact where the power is a double, which
    // e^(y ln x) does not promise.
    if math.powr(2.0, 3.0) != 8.0 || math.powr(1.5, 2.0) != 2.25 || math.powr(-1.5, 3.0) != -3.375 { return 142 }
    if math.powr(2.0, 10.0) != 1024.0 || math.powr(3.0, 20.0) != 3486784401.0 || math.powr(10.0, 22.0) != 1.0e22 { return 143 }
    if math.powr(10.0, -2.0) != 0.01 || math.powr(10.0, -1.0) != 0.1 || math.powr(0.5, 3.0) != 0.125 || math.powr(7.0, 1.0) != 7.0 { return 144 }
    // To the ends of the doubles' range, and past them.
    if math.powr(2.0, 1023.0) != twoTo(1023) || math.powr(2.0, -1022.0) != twoTo(-1022) || math.powr(-2.0, 1023.0) != -twoTo(1023) { return 145 }
    if math.powr(2.0, 1024.0) != infinity || math.powr(-2.0, 1025.0) != -infinity || math.powr(-2.0, 1026.0) != infinity { return 146 }
    if !same(math.powr(-0.5, 2000.0), 0.0) || !same(math.powr(-0.5, 2001.0), -0.0) { return 147 }
    // Powers of two are exact among the subnormals too: 2^-1024 is 2^50
    // of the smallest double.
    if !same(math.powr(0.5, 1024.0), tiny(1125899906842624)) || !same(math.powr(2.0, -1024.0), tiny(1125899906842624)) || !same(math.powr(-2.0, -1023.0), -tiny(2251799813685248)) { return 148 }
    // The power -1 is the reciprocal, also where 2^27 times it is past
    // the largest double, and a power past either end keeps its sign.
    const low: f64 = 4.082689095948134e-301
    if !same(math.powr(low, -1.0), 1.0 / low) || !same(math.powr(-low, -1.0), -1.0 / low) || !same(math.powr(3.0e300, -1.0), 1.0 / 3.0e300) { return 149 }
    if !same(math.powr(-1.0e-300, -3.0), -infinity) || !same(math.powr(-1.0e300, -3.0), -0.0) || !same(math.powr(-3.0, -1023.0), -0.0) || !same(math.powr(-1.0e300, 3.0), -infinity) { return 150 }
    // From 2^53 on a double is an even whole number.
    if math.powr(-1.0, 9007199254740992.0) != 1.0 || math.powr(-1.0, 4503599627370497.0) != -1.0 || math.powr(-3.0, 1.0e300) != infinity { return 151 }
    // Anything to the power 0 is 1, as pow has it.
    if math.powr(0.0, 0.0) != 1.0 || math.powr(-5.0, 0.0) != 1.0 || math.powr(infinity, -0.0) != 1.0 || math.powr(nan, 0.0) != 1.0 { return 152 }
    // No real power: a negative base with a fraction for an exponent.
    if !math.isNan(math.powr(-8.0, 1.0 / 3.0)) || !math.isNan(math.powr(-2.0, 0.5)) || !math.isNan(math.powr(-2.0, -1.5)) { return 153 }
    if !math.isNan(math.powr(nan, 2.0)) || !math.isNan(math.powr(2.0, nan)) || !math.isNan(math.powr(-2.0, nan)) { return 154 }
    // A fraction for an exponent is pow's own answer.
    if !same(math.powr(2.0, 0.5), math.pow(2.0, 0.5)) || !same(math.powr(7.5, -1.25), math.pow(7.5, -1.25)) || !same(math.powr(0.0, 0.5), 0.0) { return 155 }
    // Zero and the infinities as bases, with the sign an odd power keeps.
    if !same(math.powr(0.0, 3.0), 0.0) || !same(math.powr(-0.0, 3.0), -0.0) || !same(math.powr(-0.0, 2.0), 0.0) { return 156 }
    if math.powr(0.0, -2.0) != infinity || math.powr(-0.0, -3.0) != -infinity || math.powr(-0.0, -2.0) != infinity { return 157 }
    if math.powr(infinity, 2.0) != infinity || math.powr(-infinity, 3.0) != -infinity || math.powr(-infinity, 2.0) != infinity { return 158 }
    if !same(math.powr(infinity, -1.0), 0.0) || !same(math.powr(-infinity, -3.0), -0.0) || !same(math.powr(-infinity, -2.0), 0.0) { return 159 }

    // The whole numbers from -9 to 9 to the powers up to 15, all doubles:
    // the product itself, and for the negative power the double nearest
    // one over it, which the division gives.
    var base: f64 = -9.0
    while base <= 9.0 {
        var product: f64 = 1.0
        var exponent: f64 = 0.0
        while exponent <= 15.0 {
            if base != 0.0 {
                if !same(math.powr(base, exponent), product) { return 160 }
                if !same(math.powr(base, -exponent), 1.0 / product) { return 161 }
            }
            product = product * base
            exponent += 1.0
        }
        base += 1.0
    }
    // 1 and -1 to an infinite power are 1, as in C (e^(y ln x) would be
    // e^(infinity times 0)); a size below 1 goes to 0, above 1 to
    // infinity, and the other way for minus infinity.
    if !same(math.powr(1.0, infinity), 1.0) || !same(math.powr(1.0, -infinity), 1.0) || !same(math.powr(-1.0, infinity), 1.0) || !same(math.powr(-1.0, -infinity), 1.0) { return 162 }
    if !same(math.powr(0.5, infinity), 0.0) || !same(math.powr(-0.5, infinity), 0.0) || math.powr(-0.5, -infinity) != infinity || math.powr(-2.0, infinity) != infinity || !same(math.powr(2.0, -infinity), 0.0) { return 163 }

    // The powers of the whole numbers up to 1000 of either sign, as far as
    // they fit an i64: the double nearest the integer (which converting
    // the integer gives), exact below 2^53.
    var whole: i64 = 2
    while whole <= 1000 {
        var signed: i64 = -whole
        while signed <= whole {
            var power: i64 = 1
            var n: i64 = 0
            while n < 63 {
                if !same(math.powr(@floatFromInt(f64, signed), @floatFromInt(f64, n)), @floatFromInt(f64, power)) { return 164 }
                // The next power, while it still fits.
                if power > 9223372036854775807 / whole || power < -9223372036854775807 / whole { break }
                power = power * signed
                n += 1
            }
            signed += 2 * whole
        }
        whole += 1
    }
    return 0
}

