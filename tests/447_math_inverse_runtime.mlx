    Known.{ .a = 2.2514250102303838e+150, .b = -2.0, .want = 0x0180E93AD739B854 },
    Known.{ .a = 4.4145234016352686e-151, .b = -2.0, .want = 0x7E5EA626806EEB13 },
    Known.{ .a = 0.23426535782142338, .b = -489.0, .want = 0x7FED0D81829866C6 },
    Known.{ .a = 2.5400091648084926, .b = -757.0, .want = 0x004F24E40DC676E2 },
    Known.{ .a = 0.39321238229170835, .b = -759.0, .want = 0x7FD0F5CF12425CEA },
    Known.{ .a = 6.114917911201255, .b = 383.0, .want = 0x7E77001CB14066BA },
    Known.{ .a = -1047.0022785683432, .b = 102.0, .want = 0x7FE3478362AE3938 },
    Known.{ .a = -3.238797539426736, .b = -604.0, .want = 0x0003D876D41B3955 },
    Known.{ .a = 6.530498909488291e-156, .b = 2.0, .want = 0x000007D9C74E562C },
