const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const encoder = @import("../compiler/selfhost/backend/x86_64/encoder.mlx")
const target = @import("../compiler/selfhost/backend/x86_64/target.mlx")

fn compactEncodings(allocator: page_allocator.Allocator) -> bool {
    var value = encoder.init(allocator)
    encoder.emitMovRegImm64(&value, target.Register.rax, 0)
    if encoder.pos(&value) != 2 || value.buf.*.items[0] != 0x31 || value.buf.*.items[1] != 0xC0 { return false }
    encoder.emitMovRegImm64(&value, target.Register.r8, -1)
    if encoder.pos(&value) != 9 || value.buf.*.items[2] != 0x49 || value.buf.*.items[3] != 0xC7 { return false }
    encoder.emitMovRegImm64(&value, target.Register.rax, 4607182418800017408)
    if encoder.pos(&value) != 19 || value.buf.*.items[9] != 0x48 || value.buf.*.items[10] != 0xB8 { return false }
    encoder.emitSetcc(&value, target.Register.rax, encoder.Condition.equal)
    if encoder.pos(&value) != 25 || value.buf.*.items[19] != 0x0F || value.buf.*.items[22] != 0x0F { return false }
    encoder.emitSubRspImm32(&value, 8)
    encoder.emitAddRspImm32(&value, 8)
    const compact = encoder.pos(&value) == 33 && value.buf.*.items[26] == 0x83 && value.buf.*.items[30] == 0x83
    encoder.deinit(&value)
    return compact
}

pub fn main() -> u8 {
    const allocator: page_allocator.Allocator = page_allocator.init()
    if !compactEncodings(allocator) { return 1 }
    return 13
}
