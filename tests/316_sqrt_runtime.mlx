// @sqrt: the square root of an f64 or f32 as one instruction (sqrtsd or
// sqrtss on x86_64, FSQRT on AArch64), correctly rounded: exact squares
// come back exact, sqrt(2) is the nearest double (and float) to the root,
// a float literal gives an f64, zero stays zero and a negative gives NaN.
// Exits 13 on success (another number: the step that failed).
const Point = struct { x: f64, y: f64 }

fn length(point: Point) -> f64 { return @sqrt(point.x * point.x + point.y * point.y) }

fn rootOf(value: f64) -> f64 { return @sqrt(value) }

pub fn main() -> usize {
    const two: f64 = 2.0
    if @bitCast(u64, @sqrt(two)) != 4609047870845172685 { return 1 }
    const sixteen: f64 = 16.0
    if @sqrt(sixteen) != 4.0 { return 2 }
    if @sqrt(9.0) != 3.0 { return 3 }
    const small: f32 = 2.0
    const root: f32 = @sqrt(small)
    if @bitCast(u32, root) != 1068827891 { return 4 }
    const zero: f64 = 0.0
    if @sqrt(zero) != 0.0 { return 5 }
    const negative: f64 = -1.0
    const nan = @sqrt(negative)
    if nan == nan { return 6 }
    const side = Point.{ .x = 3.0, .y = 4.0 }
    if length(side) != 5.0 { return 7 }
    if rootOf(rootOf(256.0)) != 4.0 { return 8 }
    var sum: f64 = 0.0
    var index: usize = 1
    while index <= 1000 {
        sum = sum + @sqrt(@floatFromInt(f64, index))
        index += 1
    }
    if sum < 21097.45 || sum > 21097.46 { return 9 }
    return 13
}
