// std.png's decoder (std.png.read and std.png.rows under it): small
// images of the kinds the decoder must take, each with the 8-bit RGBA it
// must give (made by compiler/capi/png/tests/corpus.py's writer from
// known samples): 2-bit grey interlaced with a transparent grey, a 4-bit
// palette interlaced with transparency, 16-bit RGBA (cut to the high
// byte), 8-bit RGB with a transparent colour, 1-bit grey, 8-bit grey with
// alpha interlaced and in four IDAT chunks. Then premultiplied ARGB
// words (decode), and damaged data refused: not a PNG, a bad CRC, a
// truncated file, a bad filter type. Exits 13 when every check holds,
// else the number of the first check that failed.
const std = @import("std")
const png = @import("std.png")

fn same(a: [*]const u8, b: [*]const u8, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// Decodes FILE (LENGTH bytes); true when it is WIDTH x HEIGHT and its
// pixels are EXPECTED.
fn decodes(file: [*]const u8, length: usize, width: usize, height: usize, expected: [*]const u8) -> bool {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var picture: png.Picture = undefined
    if png.decodeRgba(&picture, file, length, allocator) != png.Status.ok { return false }
    const good = picture.width == width && picture.height == height && same(picture.pixels, expected, width * height * 4)
    png.deinitPicture(&picture)
    return good
}

fn status(file: [*]const u8, length: usize) -> png.Status {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var picture: png.Picture = undefined
    const result = png.decodeRgba(&picture, file, length, allocator)
    if result == png.Status.ok { png.deinitPicture(&picture) }
    return result
}

pub fn main() -> u8 {
    if !decodes(&gray2InterlacedFile, 103, 5, 5, &gray2InterlacedPixels) { return 1 }
    if !decodes(&palette4InterlacedFile, 159, 6, 3, &palette4InterlacedPixels) { return 2 }
    if !decodes(&rgba16File, 118, 3, 2, &rgba16Pixels) { return 3 }
    if !decodes(&rgbTransparentFile, 138, 4, 4, &rgbTransparentPixels) { return 4 }
    if !decodes(&gray1File, 71, 9, 2, &gray1Pixels) { return 5 }
    if !decodes(&grayAlphaPiecesFile, 200, 7, 6, &grayAlphaPiecesPixels) { return 6 }

    // Premultiplied words: the transparent colour of rgbTransparent is 0;
    // an opaque pixel keeps its colour.
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var image: png.Image = undefined
    if png.decode(&image, &rgbTransparentFile, 138, allocator) != png.Status.ok { return 7 }
    const first = (@intCast(u32, rgbTransparentPixels[0]) << 16) | (@intCast(u32, rgbTransparentPixels[1]) << 8) | @intCast(u32, rgbTransparentPixels[2])
    if image.pixels[5] != 0 || image.pixels[0] != 4278190080 | first { return 8 }
    png.deinit(&image)

    // Damaged data.
    var copy: [200]u8 = undefined
    var index: usize = 0
    while index < 138 {
        copy[index] = rgbTransparentFile[index]
        index += 1
    }
    const view: [*]const u8 = &copy
    if status(view, 6) != png.Status.notPng { return 9 }
    copy[0] = 71
    if status(view, 138) != png.Status.notPng { return 10 }
    copy[0] = 137
    // The CRC of IHDR.
    copy[29] = copy[29] ^ 1
    if status(view, 138) != png.Status.corrupt { return 11 }
    copy[29] = copy[29] ^ 1
    if status(view, 138) != png.Status.ok { return 12 }
    if status(view, 100) != png.Status.corrupt { return 14 }
    return 13
}

