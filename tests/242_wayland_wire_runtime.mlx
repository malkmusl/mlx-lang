// std.wayland.wire encodes a message exactly per the Wayland wire protocol
// (header word, size/opcode word, 4-byte padded strings with trailing NUL,
// null strings as length 0, out-of-band handles), decodes it back, and
// validates payloads against libwayland-style signatures. Exits 13.
const wire = @import("std.wayland.wire")
pub fn main() -> u8 {
    var writer: wire.Writer = undefined
    wire.begin(&writer, 3, 1)
    wire.putString(&writer, "wl_compositor")
    wire.putUint(&writer, 4)
    wire.putInt(&writer, -2)
    wire.putFixed(&writer, wire.Fixed.fromInt(-3))
    wire.putString(&writer, null)
    wire.putHandle(&writer, 9)
    if !wire.finish(&writer) { return 1 }
    if writer.length != 44 { return 2 }
    var copy: [64]u8 = undefined
    unsafe { wire.copyBytes(&writer, @ptrCast([*]u8, &copy)) }
    unsafe {
        const bytes = @ptrCast([*]const u8, &copy)
        if wire.headerObject(bytes) != 3 || wire.headerOpcode(bytes) != 1 || wire.headerSize(bytes) != 44 { return 3 }
        if wire.load32(bytes, 8) != 14 || copy[12] != 119 || copy[25] != 0 || copy[26] != 0 { return 4 }
        if wire.validate("suifsh", @ptrFromInt([*]const u8, @intFromPtr(bytes) + 8), 36, 1) { return 22 }
        if !wire.validate("suif?sh", @ptrFromInt([*]const u8, @intFromPtr(bytes) + 8), 36, 1) { return 5 }
        if wire.validate("?suifh", @ptrFromInt([*]const u8, @intFromPtr(bytes) + 8), 36, 1) { return 6 }
        var handles: [1]isize = [1]isize{ 9 }
        var reader: wire.Reader = undefined
        wire.initReader(&reader, @ptrFromInt([*]const u8, @intFromPtr(bytes) + 8), 36, @ptrCast([*]const isize, &handles), 1)
        const name = wire.getString(&reader)
        if wire.isNull(name) { return 7 }
        const length = name.length
        if name.pointer[12] != 114 || name.pointer[0] != 119 { return 23 }
        if length != 13 { return 8 }
        if wire.getUint(&reader) != 4 { return 9 }
        if wire.getInt(&reader) != -2 { return 10 }
        if wire.getFixed(&reader).toInt() != -3 { return 11 }
        if !wire.isNull(wire.getString(&reader)) { return 12 }
        if wire.getHandle(&reader) != 9 { return 14 }
        if wire.readerFailed(&reader) { return 15 }
        if wire.getUint(&reader) != 0 || !wire.readerFailed(&reader) { return 16 }
    }
    if wire.signatureSince("3?on") != 3 || wire.signatureArgCount("3?on") != 2 { return 17 }
    if wire.signatureArgType("usun", 2) != 117 || !wire.signatureArgNullable("u?on", 1) { return 18 }
    if wire.signatureHandleCount("hsh") != 2 { return 19 }
    if wire.Fixed.fromInt(-3).raw != -768 || wire.Fixed.fromRaw(-700).toInt() != -2 { return 20 }
    if wire.signedFromWord(4294967294) != -2 || wire.wordFromSigned(-2) != 4294967294 { return 21 }
    return 13
}
