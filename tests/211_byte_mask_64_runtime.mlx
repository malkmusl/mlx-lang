pub fn main() -> usize {
    var bytes: [64]u8 = undefined
    var index: usize = 0
    while index < 64 {
        bytes[index] = if index == 0 || index == 31 || index == 63 { 32 } else { @intCast(u8, index) }
        index += 1
    }
    unsafe {
        const pointer = @ptrCast([*]const u8, &bytes)
        if @byteMask64(pointer, 32) != 9223372043297226753 { return 1 }
        if @byteMask64(pointer, 6) != 64 { return 2 }
    }
    return 13
}
