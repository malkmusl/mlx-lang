// std.xml pull tokenizer: declarations, comments, attributes, self-closing
// elements, text, CDATA, entity decoding and well-formedness errors. Exits 13.
const xml = @import("std.xml")

fn check(tokenizer: *xml.Tokenizer, token: *xml.Token, kind: xml.TokenKind) -> bool {
    const more = xml.next(tokenizer, token)
    return token.*.kind == kind
}

fn lengthOf(value: []const u8) -> usize {
    var length: usize = 0
    for byte in value { length += 1 }
    return length
}

fn rejects(source: []const u8, code: xml.ErrorCode) -> bool {
    const length = lengthOf(source)
    var tokenizer: xml.Tokenizer = undefined
    var token: xml.Token = undefined
    unsafe { xml.initAt(&tokenizer, @ptrCast([*]const u8, source), length) }
    while xml.next(&tokenizer, &token) {}
    return token.kind == xml.TokenKind.invalid && xml.errorCode(&tokenizer) == code
}

pub fn main() -> u8 {
    const document = "<?xml version=\"1.0\"?>\n<!-- note -->\n<protocol name=\"wayland\">\n  <entry value='0x1' summary=\"a &lt;b&gt; &amp; &#x41;&#66;\"/>\n  <text>x &amp; y<![CDATA[<raw>]]></text>\n</protocol>\n"
    var tokenizer: xml.Tokenizer = undefined
    var token: xml.Token = undefined
    unsafe { xml.initAt(&tokenizer, @ptrCast([*]const u8, document), lengthOf(document)) }

    if !check(&tokenizer, &token, xml.TokenKind.declaration) { return 1 }
    if !xml.equals(token.name, "xml") || !xml.equals(token.value, "version=\"1.0\"") { return 2 }
    if !check(&tokenizer, &token, xml.TokenKind.text) { return 3 }
    if !check(&tokenizer, &token, xml.TokenKind.comment) { return 4 }
    if !xml.equals(token.value, " note ") { return 5 }
    if !check(&tokenizer, &token, xml.TokenKind.text) { return 6 }
    if !check(&tokenizer, &token, xml.TokenKind.elementStart) { return 7 }
    if !xml.equals(token.name, "protocol") { return 8 }
    if !check(&tokenizer, &token, xml.TokenKind.attribute) { return 9 }
    if !xml.equals(token.name, "name") || !xml.equals(token.value, "wayland") { return 10 }
    if !check(&tokenizer, &token, xml.TokenKind.text) || !xml.isBlank(token.value) { return 11 }
    if !check(&tokenizer, &token, xml.TokenKind.elementStart) || !xml.equals(token.name, "entry") { return 12 }
    if !check(&tokenizer, &token, xml.TokenKind.attribute) || !xml.equals(token.value, "0x1") { return 14 }
    if !check(&tokenizer, &token, xml.TokenKind.attribute) || !xml.equals(token.name, "summary") { return 15 }
    if xml.isPlain(token.value) { return 16 }
    var decoded: [32]u8 = undefined
    unsafe {
        const length = xml.decode(token.value, @ptrCast([*]u8, &decoded), 32)
        if length != 10 { return 17 }
    }
    if decoded[0] != 97 || decoded[2] != 60 || decoded[4] != 62 || decoded[6] != 38 || decoded[8] != 65 || decoded[9] != 66 { return 18 }
    if !check(&tokenizer, &token, xml.TokenKind.elementEnd) || !token.selfClosing || !xml.equals(token.name, "entry") { return 19 }
    if !check(&tokenizer, &token, xml.TokenKind.text) { return 20 }
    if !check(&tokenizer, &token, xml.TokenKind.elementStart) || xml.depth(&tokenizer) != 2 { return 21 }
    if !check(&tokenizer, &token, xml.TokenKind.text) || !xml.equals(token.value, "x &amp; y") { return 22 }
    if !check(&tokenizer, &token, xml.TokenKind.cdata) || !xml.equals(token.value, "<raw>") { return 23 }
    if !check(&tokenizer, &token, xml.TokenKind.elementEnd) || token.selfClosing { return 24 }
    if !check(&tokenizer, &token, xml.TokenKind.text) { return 25 }
    if !check(&tokenizer, &token, xml.TokenKind.elementEnd) || !xml.equals(token.name, "protocol") { return 26 }
    if !check(&tokenizer, &token, xml.TokenKind.text) { return 27 }
    if xml.next(&tokenizer, &token) || token.kind != xml.TokenKind.endOfDocument { return 28 }
    if xml.failed(&tokenizer) { return 29 }

    if !rejects("<a></b>", xml.ErrorCode.mismatchedEndTag) { return 30 }
    if !rejects("<a x=\"1\" x=\"2\"/>", xml.ErrorCode.duplicateAttribute) { return 31 }
    if !rejects("<a><b></a>", xml.ErrorCode.mismatchedEndTag) { return 32 }
    if !rejects("<a>", xml.ErrorCode.unclosedElement) { return 33 }
    if !rejects("<a/><b/>", xml.ErrorCode.multipleRoots) { return 34 }
    if !rejects("<a x=\"&bogus;\"/>", xml.ErrorCode.invalidReference) { return 35 }
    if !rejects("<a><!-- x -- y --></a>", xml.ErrorCode.invalidComment) { return 36 }
    if !rejects("text<a/>", xml.ErrorCode.contentOutsideRoot) { return 37 }
    if !rejects("   ", xml.ErrorCode.missingRoot) { return 38 }
    if !rejects("<a x=1/>", xml.ErrorCode.expectedQuote) { return 39 }
    if !rejects("<a/>\n<?xml version=\"1.0\"?>", xml.ErrorCode.misplacedDeclaration) { return 40 }
    return 13
}
