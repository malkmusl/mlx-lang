// std.crypto.rsa's sizes: a 64-bit modulus read (WebKit's
// rsa-import-spki-small-key), a 512-bit key made, signing and
// verifying (10000 times with the resident memory the same: an
// operation's work stays in its frame, none of it taken from the
// aggregate arena each time), a key of 4160
// bits (more than 4096: its numbers and work on the heap) made, signing
// with PKCS #1 v1.5 and PSS, OAEP both ways, the same key with d alone,
// a key of three primes used with d alone, and keys out of range
// refused. Exits 13 when every check holds, else the number of the
// first check that failed.
const std = @import("std")
const mpi = @import("std.crypto.mpi")
const rsa = @import("std.crypto.rsa")
const bignum = @import("std.crypto.bignum")
const hash = @import("std.crypto.hash")

const Keys = struct {
    small: rsa.PublicKey
    made: rsa.PrivateKey
    large: rsa.PrivateKey
    plain: rsa.PrivateKey
    three: rsa.PrivateKey
    digest: [32]u8
    out: [2048]u8
    back: [2048]u8
    n: [2048]u8
    d: [2048]u8
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// The resident memory in KiB (/proc/self/statm's second number).
fn residentKiB() -> usize {
    var text: [128]u8 = undefined
    const descriptor = std.linux.syscall3(2, @intFromPtr("/proc/self/statm".pointer), 0, 0)
    if descriptor < 0 { return 0 }
    const got = std.linux.syscall3(0, @bitCast(usize, descriptor), @intFromPtr(&text), 127)
    const closed = std.linux.syscall1(3, @bitCast(usize, descriptor))
    if got <= 0 { return 0 }
    const length = @bitCast(usize, got)
    var at: usize = 0
    while at < length && text[at] != 32 { at += 1 }
    at += 1
    var pages: usize = 0
    while at < length && text[at] >= 48 && text[at] <= 57 {
        pages = pages * 10 + @intCast(usize, text[at] - 48)
        at += 1
    }
    return pages * 4
}

fn check(keys: *Keys, allocator: mpi.Allocator) -> u8 {
    const e: [3]u8 = [3]u8{ 1, 0, 1 }
    const exponent: [*]const u8 = &e
    // 0xA37169CDF7C80ABF, 65537.
    const small: [9]u8 = [9]u8{ 0, 163, 113, 105, 205, 247, 200, 10, 191 }
    const smallBytes: [*]const u8 = &small
    if !rsa.publicKeyInit(&keys.*.small, smallBytes, 9, exponent, 3) || keys.*.small.bits != 64 || keys.*.small.size != 8 { return 1 }
    var out: [*]u8 = &keys.*.out
    if rsa.encryptPkcs1(&keys.*.small, "x", out) { return 2 }
    const tooLarge: [3]u8 = [3]u8{ 0, 0, 4 }
    const two: [1]u8 = [1]u8{ 1 }
    const one: [*]const u8 = &two
    if rsa.publicKeyInit(&keys.*.small, one, 1, exponent, 3) { return 3 }
    hash.digest(hash.Algorithm.sha256, "message", &keys.*.digest)
    const digest: [*]const u8 = &keys.*.digest
    // 512 bits.
    if !rsa.generateKey(&keys.*.made, allocator, 512, 65537) || keys.*.made.public.bits != 512 || !keys.*.made.hasCrt { return 4 }
    if !rsa.signPkcs1(&keys.*.made, hash.Algorithm.sha256, digest, out) { return 5 }
    var round: usize = 0
    while round < 1000 {
        if !rsa.verifyPkcs1(&keys.*.made.public, hash.Algorithm.sha256, digest, out, 64) { return 6 }
        round += 1
    }
    const before = residentKiB()
    while round < 11000 {
        if !rsa.verifyPkcs1(&keys.*.made.public, hash.Algorithm.sha256, digest, out, 64) { return 6 }
        round += 1
    }
    if before == 0 || residentKiB() > before + 2048 { return 23 }
    // 4160 bits.
    if !rsa.generateKey(&keys.*.large, allocator, 4160, 65537) || keys.*.large.public.bits != 4160 || keys.*.large.public.size != 520 || !keys.*.large.hasCrt { return 7 }
    const size: usize = 520
    if !rsa.signPkcs1(&keys.*.large, hash.Algorithm.sha256, digest, out) || !rsa.verifyPkcs1(&keys.*.large.public, hash.Algorithm.sha256, digest, out, size) { return 8 }
    if rsa.verifyPkcs1(&keys.*.large.public, hash.Algorithm.sha384, digest, out, size) { return 9 }
    if !rsa.signPssRandom(&keys.*.large, hash.Algorithm.sha256, digest, 32, out) || !rsa.verifyPss(&keys.*.large.public, hash.Algorithm.sha256, digest, out, size, 32) { return 10 }
    var length: usize = 0
    const back: [*]u8 = &keys.*.back
    if !rsa.encryptOaepRandom(&keys.*.large.public, hash.Algorithm.sha256, "", "a large key's", out) || !rsa.decryptOaep(&keys.*.large, hash.Algorithm.sha256, "", out[0..size], back, &length) || !same(back[0..length], "a large key's") { return 11 }
    // The same key with d alone.
    const nBytes: [*]u8 = &keys.*.n
    bignum.toBytes(keys.*.large.public.modulus.m, keys.*.large.public.modulus.n, nBytes, size)
    const dLength = keys.*.large.dLength
    var index: usize = 0
    while index < dLength {
        keys.*.d[index] = keys.*.large.d[index]
        index += 1
    }
    if !rsa.privateKeyInit(&keys.*.plain, allocator, nBytes[0..size], e[0..3], keys.*.d[0..dLength], "", "") || keys.*.plain.hasCrt { return 12 }
    if !rsa.signPkcs1(&keys.*.plain, hash.Algorithm.sha256, digest, out) || !rsa.verifyPkcs1(&keys.*.large.public, hash.Algorithm.sha256, digest, out, size) { return 14 }
    // Three primes of 256 bits, d = e^-1 mod lcm(p - 1, q - 1, r - 1).
    var p: mpi.Mpi = undefined
    var q: mpi.Mpi = undefined
    var r: mpi.Mpi = undefined
    var n: mpi.Mpi = undefined
    var t: mpi.Mpi = undefined
    var lcm: mpi.Mpi = undefined
    var g: mpi.Mpi = undefined
    var d: mpi.Mpi = undefined
    var big: mpi.Mpi = undefined
    mpi.init(&p, allocator)
    mpi.init(&q, allocator)
    mpi.init(&r, allocator)
    mpi.init(&n, allocator)
    mpi.init(&t, allocator)
    mpi.init(&lcm, allocator)
    mpi.init(&g, allocator)
    mpi.init(&d, allocator)
    mpi.init(&big, allocator)
    if !mpi.setU64(&big, 65537) || !mpi.generatePrime(&p, 256, &big) || !mpi.generatePrime(&q, 256, &big) || !mpi.generatePrime(&r, 256, &big) { return 15 }
    if !mpi.mul(&n, &p, &q) || !mpi.mul(&n, &n, &r) { return 16 }
    // lcm(a, b) = a b / gcd(a, b), twice.
    if !mpi.subU64(&lcm, &p, 1) || !mpi.subU64(&t, &q, 1) || !mpi.gcd(&g, &lcm, &t) || !mpi.mul(&lcm, &lcm, &t) || !mpi.divRem(&lcm, null, &lcm, &g) { return 17 }
    if !mpi.subU64(&t, &r, 1) || !mpi.gcd(&g, &lcm, &t) || !mpi.mul(&lcm, &lcm, &t) || !mpi.divRem(&lcm, null, &lcm, &g) || !mpi.invm(&d, &big, &lcm) { return 18 }
    const threeLength = mpi.byteLength(&n)
    const threeD = mpi.byteLength(&d)
    mpi.toBytes(&n, keys.*.n[0..threeLength])
    mpi.toBytes(&d, keys.*.d[0..threeD])
    if !rsa.privateKeyInit(&keys.*.three, allocator, keys.*.n[0..threeLength], e[0..3], keys.*.d[0..threeD], "", "") || keys.*.three.public.bits < 760 { return 19 }
    if !rsa.encryptOaepRandom(&keys.*.three.public, hash.Algorithm.sha1, "", "three", out) || !rsa.decryptOaep(&keys.*.three, hash.Algorithm.sha1, "", out[0..threeLength], back, &length) || !same(back[0..length], "three") { return 20 }
    mpi.deinit(&p)
    mpi.deinit(&q)
    mpi.deinit(&r)
    mpi.deinit(&n)
    mpi.deinit(&t)
    mpi.deinit(&lcm)
    mpi.deinit(&g)
    mpi.deinit(&d)
    mpi.deinit(&big)
    // Out of range: more than 16384 bits, a key to make of 16385.
    keys.*.n[0] = 1
    if rsa.publicKeyInit(&keys.*.small, nBytes, 2049, exponent, 3) { return 21 }
    if rsa.generateKey(&keys.*.plain, allocator, 16385, 65537) { return 22 }
    const ignored = tooLarge
    rsa.privateKeyDeinit(&keys.*.made)
    rsa.privateKeyDeinit(&keys.*.large)
    rsa.privateKeyDeinit(&keys.*.three)
    rsa.publicKeyDeinit(&keys.*.small)
    return 13
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(Keys), 16)
    if memory == null { return 99 }
    const keys = unsafe { @ptrCast(*Keys, memory.?) }
    return check(keys, allocator)
}
