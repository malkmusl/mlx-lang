// std.passwd over files of the test's own text: an account by name and
// by number with all its fields, a group by name and by number with its
// members; malformed lines (too few or too many fields, a number that is
// not one or is too large) are passed over; a missing name or number is
// not found. Then the system's own: root is uid 0 in /etc/passwd and
// group 0 in /etc/group. Exits 13 when every check holds, else the number
// of the first check that failed.
const std = @import("std")
const passwd = @import("std.passwd")

pub fn main() -> u8 {
    const users = "root:x:0:0:root:/root:/bin/sh\nbroken:x:12\nbad:x:1a:1:Bad:/:/bin/sh\nhuge:x:4294967296:1:Huge:/:/bin/sh\nada:x:1000:100:Ada Lovelace:/home/ada:/bin/mlx-sh\nextra:x:7:7:a:b:c:d\n"
    var user: passwd.User = undefined
    if !passwd.findUserNamed(users, "ada", &user) { return 1 }
    if user.id != 1000 || user.group != 100 { return 2 }
    if !std.text.same(user.gecos, "Ada Lovelace") || !std.text.same(user.home, "/home/ada") || !std.text.same(user.shell, "/bin/mlx-sh") || !std.text.same(user.password, "x") { return 3 }
    if !passwd.findUserById(users, 0, &user) || !std.text.same(user.name, "root") { return 4 }
    if passwd.findUserNamed(users, "broken", &user) || passwd.findUserNamed(users, "bad", &user) { return 5 }
    if passwd.findUserNamed(users, "huge", &user) || passwd.findUserNamed(users, "extra", &user) { return 6 }
    if passwd.findUserById(users, 4242, &user) || passwd.findUserNamed(users, "ad", &user) { return 7 }

    const groups = "root:x:0:\nwheel:x:10:ada,bob\nbroken:x\naudio:x:29:ada"
    var group: passwd.Group = undefined
    if !passwd.findGroupNamed(groups, "wheel", &group) || group.id != 10 || !std.text.same(group.members, "ada,bob") { return 8 }
    if !passwd.findGroupById(groups, 29, &group) || !std.text.same(group.name, "audio") { return 9 }
    if !passwd.findGroupById(groups, 0, &group) || group.members.length != 0 { return 10 }
    if passwd.findGroupNamed(groups, "broken", &group) { return 11 }

    var id: u32 = 0
    if !passwd.parseId("4294967295", &id) || id != 4294967295 { return 12 }
    if passwd.parseId("", &id) || passwd.parseId("+1", &id) { return 14 }

    // The system's files.
    var buffer: [65536]u8 = undefined
    const bytes: [*]u8 = &buffer
    if !passwd.userById(0, bytes, 65536, &user) || !std.text.same(user.name, "root") { return 15 }
    if !passwd.userNamed("root", bytes, 65536, &user) || user.id != 0 { return 16 }
    if !passwd.groupById(0, bytes, 65536, &group) { return 17 }
    return 13
}
