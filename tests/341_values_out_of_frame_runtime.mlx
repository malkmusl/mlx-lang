// Values the x86_64 backend leaves out of their frame slots: constants,
// read as immediates where they are used, and loads of locals kept in
// registers, read from the register. A load whose local is stored to
// before the load's last reader, or whose reader sits in a later block,
// still sees the value it loaded. Exits 13.
fn identity(value: usize) -> usize { return value }

// The old value is read after the local changed.
fn keepsOldValue() -> bool {
    var x: usize = 5
    var y: usize = 0
    var turn: usize = 0
    while turn < 3 {
        const old = x
        x = x + 10
        y = y + old
        turn += 1
    }
    return x == 35 && y == 5 + 15 + 25
}

// Swapping through a temporary, many times.
fn swaps() -> bool {
    var a: usize = 1
    var b: usize = 2
    var count: usize = 0
    while count < 7 {
        const t = a
        a = b
        b = t
        count += 1
    }
    return a == 2 && b == 1
}

// A load read in later blocks, on either path, after the local changed
// on one of them.
fn acrossBlocks(flag: bool) -> usize {
    var x: usize = 40
    var spare: usize = 1
    const seen = x
    if flag {
        x = 99
        spare += 1
    } else {
        spare += 2
    }
    return seen + x + spare
}

// A constant read on both paths and after them.
fn constantsOnPaths(flag: bool) -> usize {
    const c: usize = 7
    var total: usize = 0
    var step: usize = 0
    if flag {
        total = c * 2
    } else {
        total = c + 1
    }
    while step < c {
        total += c
        step += 1
    }
    return total
}

// Calls keep the registers; a negative and a wide constant.
fn throughCalls() -> bool {
    var i: usize = 0
    var sum: usize = 0
    var wide: u64 = 0
    var signed: i64 = 0
    while i < 10 {
        sum = sum + identity(i)
        signed = signed + -3
        i += 1
    }
    wide = 81985529216486895
    wide = wide + 1
    return sum == 45 && signed == -30 && wide == 81985529216486896
}

// Comparisons with the local on either side and constants on either side.
fn comparisons() -> usize {
    var x: usize = 0
    var y: usize = 3
    var hits: usize = 0
    while x < 10 {
        if 5 < x { hits += 1 }
        if x == y { hits += 100 }
        if y >= x { hits += 1000 }
        x += 1
    }
    return hits
}

// A pointer kept in a register, read through.
fn throughPointer() -> bool {
    var values = [4]u8{ 1, 2, 3, 4 }
    var p: [*]u8 = &values
    var index: usize = 0
    var total: usize = 0
    while index < 4 {
        total += @intCast(usize, p[index])
        p[index] = 255
        index += 1
    }
    return total == 10 && values[2] == 255
}

pub fn main() -> u8 {
    if !keepsOldValue() { return 1 }
    if !swaps() { return 2 }
    if acrossBlocks(true) != 40 + 99 + 2 { return 3 }
    if acrossBlocks(false) != 40 + 40 + 3 { return 4 }
    if constantsOnPaths(true) != 14 + 49 { return 5 }
    if constantsOnPaths(false) != 8 + 49 { return 6 }
    if !throughCalls() { return 7 }
    if comparisons() != 4 + 100 + 4000 { return 8 }
    if !throughPointer() { return 9 }
    return 13
}
