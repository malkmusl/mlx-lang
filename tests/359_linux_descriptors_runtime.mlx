// std.linux's descriptors: a pipe written whole and read, a timer and a
// signal taken through an event loop by their tokens, descriptors passed
// over a Unix socket pair (SCM_RIGHTS) and a Unix socket by path, poll
// records, and a child forked, waited for and its exit status. Exits 13
// when every check holds, else the number of the first check that failed.
const std = @import("std")
const linux = std.linux
const event = std.linux.event
const socket = std.linux.socket

pub fn main() -> u8 {
    var read_end: isize = -1
    var write_end: isize = -1
    if !linux.pipe(&read_end, &write_end, linux.O_CLOEXEC) { return 1 }
    if !linux.writeAll(write_end, "hello") { return 2 }
    var buffer: [8]u8 = undefined
    if linux.read(read_end, &buffer, 8) != 5 || buffer[4] != 111 { return 3 }

    // A timer and a signal, each by its token.
    const timer = event.createTimer(linux.CLOCK_MONOTONIC)
    const loop = event.createEventLoop()
    if timer < 0 || loop < 0 { return 4 }
    if !event.watch(loop, timer, 77, false) { return 5 }
    if event.setTimer(timer, 1000000, 0) != 0 { return 6 }
    var events: event.Events = undefined
    if event.waitEvents(loop, &events, 1000) != 1 || event.eventToken(&events, 0) != 77 { return 7 }
    if event.eventFlags(&events, 0) & event.EPOLLIN == 0 || event.readCounter(timer) != 1 { return 8 }
    const signals = event.signalDescriptor(linux.process.signalBit(linux.SIGUSR1))
    if signals < 0 || !event.watch(loop, signals, 4294967298, false) { return 9 }
    if linux.process.kill(linux.getpid(), linux.SIGUSR1) != 0 { return 10 }
    if event.waitEvents(loop, &events, 1000) != 1 || event.eventToken(&events, 0) != 4294967298 { return 11 }
    if event.readSignal(signals) != 10 || event.readSignal(signals) != 0 { return 12 }

    // A counter, and poll records.
    const counter = event.createCounter()
    event.addToCounter(counter, 3)
    var records: [16]u8 = undefined
    const entries: [*]u8 = &records
    event.pollSet(entries, 0, counter, event.POLLIN)
    event.pollSet(entries, 1, read_end, event.POLLIN)
    if event.poll(@intFromPtr(entries), 2, 0) != 1 { return 14 }
    if event.pollResult(entries, 0) & event.POLLIN == 0 || event.pollResult(entries, 1) != 0 { return 15 }
    if event.readCounter(counter) != 3 || event.waitReady(counter, false, 0) != 0 { return 16 }

    // Descriptors passed along.
    var pair: [2]i32 = [2]i32{ -1, -1 }
    if socket.socketPair(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC, 0, &pair) != 0 { return 17 }
    const first = @intCast(isize, pair[0])
    const second = @intCast(isize, pair[1])
    var passing: [2]isize = [2]isize{ write_end, timer }
    const message: []const u8 = "xy"
    if socket.sendWithDescriptors(first, message.pointer, 2, &passing, 2, socket.MSG_NOSIGNAL) != 2 { return 18 }
    var passed: [1]isize = [1]isize{ -1 }
    var count: usize = 0
    if socket.receiveWithDescriptors(second, &buffer, 8, &passed, 1, &count, socket.MSG_CMSG_CLOEXEC) != 2 { return 19 }
    if count != 1 || passed[0] < 0 || buffer[1] != 121 { return 20 }
    // The second came beyond the room and was closed; the first is the
    // write end again.
    if !linux.writeAll(passed[0], "!") || linux.read(read_end, &buffer, 8) != 1 || buffer[0] != 33 { return 21 }

    // A Unix socket by path.
    var path: [64]u8 = undefined
    const path_bytes: [*]u8 = &path
    var length = std.text.append(path_bytes, 0, 40, "/tmp/mlx-359-")
    length = std.text.appendUnsigned(path_bytes, length, 60, @bitCast(usize, linux.getpid()))
    path[length] = 0
    const listener = socket.listenUnix(path[0..length], false, socket.SOCK_CLOEXEC, 4)
    if listener < 0 { return 22 }
    const client = socket.connectUnix(path[0..length], false, socket.SOCK_CLOEXEC)
    const unlinked = linux.unlink(path_bytes)
    if client < 0 || unlinked != 0 { return 23 }
    const served = socket.accept4(listener, 0, 0, socket.SOCK_CLOEXEC)
    var pid: u32 = 0
    var uid: u32 = 0
    var gid: u32 = 0
    if served < 0 || !socket.peerCredentials(served, &pid, &uid, &gid) { return 24 }
    if @intCast(isize, pid) != linux.getpid() || uid != linux.process.effectiveUserId() { return 25 }
    if socket.unixAddress(path_bytes, "x", true) != 4 || path[2] != 0 || path[3] != 120 { return 26 }

    // A child and its exit status.
    const child = linux.process.fork()
    if child == 0 { linux.exitGroup(3) }
    var status: usize = 0
    if linux.process.waitProcess(child, &status, 0) != child || linux.process.exitStatus(status) != 3 { return 27 }
    if linux.process.waitProcess(-1, &status, linux.WNOHANG) != linux.ECHILD { return 28 }
    return 13
}
