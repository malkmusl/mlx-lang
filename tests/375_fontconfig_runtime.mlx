// std.fontconfig (compiler/libc/fontconfig is the C API over it): names
// compared with Fontconfig's case folding; a name parsed, printed and
// given the configuration's and the default substitutions; languages'
// orthographies; then a configuration read from memory (two font
// directories of the tree, aliases, pattern, font and scan rules, a
// rejected file) whose fonts are read twice, the second time from the
// cache, each time listed, matched, sorted and listed by an object set.
// What Fontconfig 2.15 answers for the same is in each check. Exits 13
// when every check holds, else the number of the first check that failed.
const std = @import("std")
const fc = @import("std.fontconfig")
const gpa = std.general_purpose_allocator

const mem = fc.mem
const pattern = fc.pattern
const objects = fc.objects

var heap: gpa.Heap = undefined

const CACHE: []const u8 = "/tmp/mlx-373-fontconfig-cache"

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn c(text: []const u8) -> usize { return mem.dupText(text) }

fn sameC(text: usize, expected: []const u8) -> bool { return mem.same(mem.cText(text), expected) }

// The configuration of the checks, its directories under `cwd`.
fn configText(cwd: []const u8) -> usize {
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = mem.appendText(&b, "<fontconfig>\n  <dir>")
    _ = mem.appendText(&b, cwd)
    _ = mem.appendText(&b, "/compiler/libc/freetype/tests/fonts</dir>\n  <dir>")
    _ = mem.appendText(&b, cwd)
    _ = mem.appendText(&b, "/tests/support/fonts</dir>\n")
    _ = mem.appendText(&b, "  <alias><family>sans-serif</family><prefer><family>DejaVu Sans</family></prefer></alias>\n")
    _ = mem.appendText(&b, "  <alias><family>monospace</family><prefer><family>MlxNamesTest</family></prefer></alias>\n")
    _ = mem.appendText(&b, "  <match target=\"pattern\"><test name=\"family\"><string>Testy</string></test><edit name=\"family\" mode=\"assign\" binding=\"strong\"><string>MlxVarTest</string></edit></match>\n")
    _ = mem.appendText(&b, "  <match target=\"font\"><test name=\"family\"><string>MlxColrTest</string></test><edit name=\"embolden\" mode=\"assign\"><bool>true</bool></edit></match>\n")
    _ = mem.appendText(&b, "  <match target=\"scan\"><test name=\"family\"><string>MlxSbixTest</string></test><edit name=\"weight\" mode=\"assign\"><const>bold</const></edit></match>\n")
    _ = mem.appendText(&b, "  <selectfont><rejectfont><glob>*/colr1.ttf</glob></rejectfont></selectfont>\n</fontconfig>\n")
    return mem.takeBuffer(&b)
}

fn baseName(file: usize) -> usize {
    var result = file
    var at = file
    while mem.get8(at) != 0 {
        if mem.get8(at) == 47 { result = at + 1 }
        at += 1
    }
    return result
}

// A font as "file|index|family|style|weight|width|embolden".
fn describe(b: *mem.Buffer, font: usize) -> void {
    _ = mem.appendC(b, baseName(pattern.firstString(font, objects.FILE)))
    var i: i64 = 0
    _ = pattern.getInteger(font, objects.INDEX, 0, &i)
    _ = mem.appendText(b, "|")
    _ = mem.appendSigned(b, i)
    _ = mem.appendText(b, "|")
    var s: usize = 0
    if pattern.getString(font, objects.FAMILY, 0, &s) == pattern.RESULT_MATCH { _ = mem.appendC(b, s) }
    _ = mem.appendText(b, "|")
    if pattern.getString(font, objects.STYLE, 0, &s) == pattern.RESULT_MATCH { _ = mem.appendC(b, s) }
    var d: f64 = 0.0
    _ = mem.appendText(b, "|")
    if pattern.getDouble(font, objects.WEIGHT, 0, &d) == pattern.RESULT_MATCH { _ = mem.appendDouble(b, d) } else { _ = mem.appendText(b, "-") }
    _ = mem.appendText(b, "|")
    if pattern.getDouble(font, objects.WIDTH, 0, &d) == pattern.RESULT_MATCH { _ = mem.appendDouble(b, d) } else { _ = mem.appendText(b, "-") }
    var e: i64 = 0
    _ = mem.appendText(b, "|")
    if pattern.getBool(font, objects.EMBOLDEN, 0, &e) == pattern.RESULT_MATCH { _ = mem.appendSigned(b, e) } else { _ = mem.appendText(b, "-") }
    _ = mem.appendText(b, "\n")
}

const QUERIES: []const u8 = "sans-serif\nmonospace\nTesty\nMlxVarTest:weight=200\nMlxVarTest:bold\nMlxVarTest:width=75\nMlxCff2Test:weight=210\nMlxColrTest\nMlxColrOneTest\nMlxSbixTest\n:lang=en\nserif\nMlxVarTest:variable=true\nMlxNamesTest:fontformat=CFF\n"

const FONTS: []const u8 = "fonts 15\ncolr.ttf|0|MlxColrTest|Book|80|100|-\nnames.otf|0|MlxNamesTest|Regular|80|100|-\nnames.ttf|0|MlxNamesTest|Regular|80|100|-\nsbix.ttf|0|MlxSbixTest|Book|200|100|-\nvar-cff2.otf|0|MlxCff2Test|Regular|80|100|-\nvar-cff2.otf|131072|MlxCff2Test|Bold|200|100|-\nvar-cff2.otf|196608|MlxCff2Test|Black|210|100|-\nvar-cff2.otf|0|MlxCff2Test||-|100|-\nvar-tt.ttf|0|MlxVarTest|Regular|80|100|-\nvar-tt.ttf|65536|MlxVarTest|Thin|0|100|-\nvar-tt.ttf|196608|MlxVarTest|SemiBold|153.333|100|-\nvar-tt.ttf|262144|MlxVarTest|Black|210|100|-\nvar-tt.ttf|327680|MlxVarTest|Black Condensed|210|75|-\nvar-tt.ttf|0|MlxVarTest||-|-|-\nDejaVuSans-subset.ttf|0|DejaVu Sans|Book|80|100|-\n"

const MATCHES: []const u8 = "match sans-serif -> var-cff2.otf|0|MlxCff2Test|Regular|80|100|-\nsort var-cff2.otf/0 DejaVuSans-subset.ttf/0 names.otf/0\nmatch monospace -> names.otf|0|MlxNamesTest|Regular|80|100|-\nsort names.otf/0 var-cff2.otf/0 DejaVuSans-subset.ttf/0\nmatch Testy -> var-tt.ttf|0|MlxVarTest|Regular|80|100|-\nsort var-tt.ttf/0 DejaVuSans-subset.ttf/0 names.otf/0\nmatch MlxVarTest:weight=200 -> var-tt.ttf|262144|MlxVarTest|Black|210|100|-\nsort var-tt.ttf/262144 DejaVuSans-subset.ttf/0 names.otf/0\nmatch MlxVarTest:bold -> var-tt.ttf|262144|MlxVarTest|Black|210|100|-\nsort var-tt.ttf/262144 DejaVuSans-subset.ttf/0 names.otf/0\nmatch MlxVarTest:width=75 -> var-tt.ttf|0|MlxVarTest|Regular|80|100|-\nsort var-tt.ttf/0 DejaVuSans-subset.ttf/0 names.otf/0\nmatch MlxCff2Test:weight=210 -> var-cff2.otf|196608|MlxCff2Test|Black|210|100|-\nsort var-cff2.otf/196608 DejaVuSans-subset.ttf/0 names.otf/0\nmatch MlxColrTest -> colr.ttf|0|MlxColrTest|Book|80|100|1\nsort colr.ttf/0 DejaVuSans-subset.ttf/0 names.otf/0\nmatch MlxColrOneTest -> var-cff2.otf|0|MlxCff2Test|Regular|80|100|-\nsort var-cff2.otf/0 DejaVuSans-subset.ttf/0 names.otf/0\nmatch MlxSbixTest -> sbix.ttf|0|MlxSbixTest|Book|200|100|-\nsort sbix.ttf/0 DejaVuSans-subset.ttf/0 names.otf/0\nmatch :lang=en -> var-cff2.otf|0|MlxCff2Test|Regular|80|100|-\nsort var-cff2.otf/0 DejaVuSans-subset.ttf/0 names.otf/0\nmatch serif -> var-cff2.otf|0|MlxCff2Test|Regular|80|100|-\nsort var-cff2.otf/0 DejaVuSans-subset.ttf/0 names.otf/0\nmatch MlxVarTest:variable=true -> var-tt.ttf|0|MlxVarTest||80|100|-\nsort var-tt.ttf/0 DejaVuSans-subset.ttf/0 names.otf/0\nmatch MlxNamesTest:fontformat=CFF -> names.otf|0|MlxNamesTest|Regular|80|100|-\nsort names.otf/0 var-cff2.otf/0 DejaVuSans-subset.ttf/0\n"

const LISTS: []const u8 = "list MlxColrTest:style=Book:weight=80 MlxNamesTest:style=Regular:weight=80 MlxVarTest:style=Black Condensed:weight=210 MlxVarTest:style=SemiBold:weight=153.333 MlxCff2Test:style=Bold:weight=200 MlxVarTest:style=Thin:weight=0 MlxCff2Test:weight=[80 210] MlxCff2Test:style=Regular:weight=80 MlxVarTest:style=Regular:weight=80 MlxCff2Test:style=Black:weight=210 MlxVarTest:style=Black:weight=210 DejaVu Sans:style=Book:weight=80 MlxVarTest:weight=[0 210] MlxSbixTest:style=Book:weight=200\nlist MlxVarTest:weight=[0 210]:width=[75 100]:index=0:variable=True\n"

fn objectSet(names: []const u8) -> usize {
    const os = pattern.objectSetCreate()
    var at: usize = 0
    while at < names.length {
        var stop = at
        while stop < names.length && names[stop] != 32 { stop += 1 }
        const name = mem.dupText(names[at..stop])
        _ = pattern.objectSetAdd(os, name)
        mem.free(name)
        at = stop + 1
    }
    return os
}

fn appendList(b: *mem.Buffer, config: usize, query: []const u8, names: []const u8) -> void {
    const p = pattern.parseName(c(query))
    const os = objectSet(names)
    const listed = fc.matching.fontList(config, p, os)
    _ = mem.appendText(b, "list")
    var i: usize = 0
    while i < pattern.fontSetCount(listed) {
        _ = mem.appendText(b, " ")
        const name = pattern.unparseName(pattern.fontSetFont(listed, i), true)
        _ = mem.appendC(b, name)
        mem.free(name)
        i += 1
    }
    _ = mem.appendText(b, "\n")
    pattern.fontSetDestroy(listed)
    pattern.objectSetDestroy(os)
    pattern.destroy(p)
}

// The fonts of the configuration (read anew), its matches and its lists
// checked; 0 when they are Fontconfig's, else the number of the check.
fn checkFonts(text: usize, first: i64) -> i64 {
    const config = fc.config.create()
    if !fc.load.parseAndLoadMemory(config, text, true) { return first }
    if !fc.load.buildFonts(config) { return first }
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    const fonts = fc.config.fonts(config, fc.config.SET_SYSTEM)
    _ = mem.appendText(&b, "fonts ")
    _ = mem.appendUnsigned(&b, pattern.fontSetCount(fonts))
    _ = mem.appendText(&b, "\n")
    var i: usize = 0
    while i < pattern.fontSetCount(fonts) {
        describe(&b, pattern.fontSetFont(fonts, i))
        i += 1
    }
    if !mem.same(mem.bufferText(&b), FONTS) {
        say(mem.bufferText(&b))
        return first + 1
    }
    mem.freeBuffer(&b)
    mem.initBuffer(&b)
    var at: usize = 0
    while at < QUERIES.length {
        var stop = at
        while QUERIES[stop] != 10 { stop += 1 }
        _ = mem.appendText(&b, "match ")
        _ = mem.appendText(&b, QUERIES[at..stop])
        _ = mem.appendText(&b, " -> ")
        const p = pattern.parseName(c(QUERIES[at..stop]))
        at = stop + 1
        _ = fc.config.substitute(config, p, fc.config.MATCH_PATTERN)
        fc.config.defaultSubstitute(p)
        var result: i64 = 0
        const font = fc.matching.fontMatch(config, p, &result)
        if font == 0 { _ = mem.appendText(&b, "none\n") } else { describe(&b, font) }
        const sorted = fc.matching.fontSort(config, p, true, 0, &result)
        _ = mem.appendText(&b, "sort")
        var k: usize = 0
        while k < pattern.fontSetCount(sorted) {
            const f = pattern.fontSetFont(sorted, k)
            _ = mem.appendText(&b, " ")
            _ = mem.appendC(&b, baseName(pattern.firstString(f, objects.FILE)))
            var index: i64 = 0
            _ = pattern.getInteger(f, objects.INDEX, 0, &index)
            _ = mem.appendText(&b, "/")
            _ = mem.appendSigned(&b, index)
            k += 1
        }
        _ = mem.appendText(&b, "\n")
        pattern.fontSetDestroy(sorted)
        pattern.destroy(font)
        pattern.destroy(p)
    }
    if !mem.same(mem.bufferText(&b), MATCHES) {
        say(mem.bufferText(&b))
        return first + 2
    }
    mem.freeBuffer(&b)
    mem.initBuffer(&b)
    appendList(&b, config, ":", "family style weight")
    appendList(&b, config, "MlxVarTest:variable=true", "family weight width variable index")
    if !mem.same(mem.bufferText(&b), LISTS) {
        say(mem.bufferText(&b))
        return first + 3
    }
    mem.freeBuffer(&b)
    fc.config.destroy(config)
    return 0
}

pub fn main() -> u8 {
    heap = gpa.init(std.page_allocator.init())
    mem.use(gpa.interface(&heap))
    fc.env.set("FC_LANG", c("en"))
    fc.env.set("XDG_CACHE_HOME", c(CACHE))

    // Case folded as Fontconfig folds it: Cyrillic, ß as "ss", titlecase.
    if fc.strings.cmpIgnoreCase(c("Курсив"), c("курсив")) != 0 { return 1 }
    if fc.strings.cmpIgnoreCase(c("Straße"), c("STRASSE")) != 0 { return 2 }
    if fc.strings.cmpIgnoreCase(c("ǅ"), c("ǆ")) != 0 { return 3 }
    if fc.strings.cmpIgnoreBlanksAndCase(c("Dejavu SANS"), c("DejaVuSans")) != 0 { return 4 }
    if fc.strings.cmpIgnoreCase(c("Inter"), c("Intel")) <= 0 { return 5 }

    // A name parsed and printed again, then substituted.
    const p = pattern.parseName(c("Inter,DejaVu Sans-12:weight=bold:slant=italic:lang=ja|en:pixelsize=16.5:size=[8 14]"))
    if !sameC(pattern.unparseName(p, true), "Inter,DejaVu Sans-12,[8 14]:slant=100:weight=200:pixelsize=16.5:lang=en|ja") { return 6 }
    const empty = fc.config.create()
    _ = fc.config.substitute(empty, p, fc.config.MATCH_PATTERN)
    fc.config.defaultSubstitute(p)
    _ = pattern.del(p, objects.PRGNAME)
    _ = pattern.del(p, objects.DESKTOP_NAME)
    if !sameC(pattern.unparseName(p, true), "Inter,DejaVu Sans-15.84:familylang=en,en-us:stylelang=en,en-us:fullnamelang=en,en-us:slant=100:weight=200:width=100:pixelsize=16.5:hintstyle=3:hinting=True:verticallayout=False:autohint=False:globaladvance=True:lang=en|ja:fontversion=2147483647:embeddedbitmap=True:decorative=False:namelang=en:symbol=False:variable=False:order=0") { return 7 }
    fc.config.destroy(empty)

    // Languages.
    if !sameC(fc.lang.normalize(c("zh_TW.UTF-8")), "zh-TW") { return 8 }
    if !sameC(fc.lang.normalize(c("sr@latin")), "sr") { return 9 }
    if fc.charset.count(fc.lang.getCharSet(c("ja"))) != 2314 { return 10 }
    if fc.charset.count(fc.lang.getCharSet(c("ru"))) != 66 { return 11 }

    // The fonts: read, then read from the cache.
    var cwd: [4096]u8 = undefined
    const n = std.fs.getWorkingDirectory(&cwd, 4096)
    if n <= 0 { return 12 }
    var length: usize = 0
    while length < 4096 && cwd[length] != 0 { length += 1 }
    _ = std.fs.removeTree(mem.bytes(c(CACHE)))
    const text = configText(cwd[0..length])
    const first = checkFonts(text, 20)
    if first != 0 { return @intCast(u8, first) }
    const second = checkFonts(text, 30)
    _ = std.fs.removeTree(mem.bytes(c(CACHE)))
    if second != 0 { return @intCast(u8, second) }
    return 13
}
