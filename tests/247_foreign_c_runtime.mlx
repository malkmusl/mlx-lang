// Foreign C functions and exported functions on x86_64 Linux: the program
// is written as a dynamically linked executable against libc.so.6.
//
// Covers direct imports, narrow C results (sign/zero extension), a
// variadic import (AL), dlopen/dlsym and calls through the returned
// pointer, a Mlx callback driven by qsort, an export fn running on a
// thread the C library created (aggregate arena registers restored), and
// narrow arguments/results with garbage upper bits from machine code.
// Exits 13 on success.

extern("c") fn getpid() -> i32
extern("c") fn strlen(text: [*]const u8) -> usize
extern("c") fn abs(value: i32) -> i32
extern("c") fn snprintf(buffer: [*]u8, size: usize, format: [*]const u8, value: i64) -> i32
extern("c") fn dlopen(name: [*]const u8, flags: i32) -> usize
extern("c") fn dlsym(handle: usize, name: [*]const u8) -> usize
extern("c") fn qsort(base: usize, count: usize, size: usize, compare: usize) -> void
extern("c") fn pthread_create(thread: *u64, attributes: usize, start: usize, argument: usize) -> i32
extern("c") fn pthread_join(thread: u64, result: *usize) -> i32
extern("c") fn mmap(address: usize, length: usize, protection: i32, flags: i32, descriptor: i32, offset: usize) -> usize

const Strlen = fn([*]const u8) -> usize
const ReturnsU32 = fn() -> u32
const ReturnsI8 = fn() -> i8
const ReturnsI16 = fn() -> i16
const ReturnsBool = fn() -> bool
const Trampoline = fn(usize, usize) -> usize

const Pair = struct {
    left: usize
    right: usize
}

fn text(literal: []const u8) -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, literal) }
}

fn compare(left: *const i64, right: *const i64) -> i32 {
    if left.* < right.* { return -1 }
    if left.* > right.* { return 1 }
    return 0
}

fn makePair(value: usize) -> Pair {
    return Pair.{ .left = value, .right = value * 2 }
}

export fn mlx_foreign_worker(argument: usize) -> usize {
    const pair = makePair(argument)
    return pair.left + pair.right
}

fn takesU32(value: u32) -> usize { return @intCast(usize, value) }

fn takesBool(value: bool) -> usize {
    if value { return 1 }
    return 0
}

fn takesI16(value: i16) -> i64 { return @intCast(i64, value) }

// Writes `mov rax, imm64; ret` at `code`.
fn returnStub(code: [*]u8, value: u64) -> void {
    code[0] = 0x48
    code[1] = 0xB8
    var index: usize = 0
    while index < 8 {
        code[2 + index] = @intCast(u8, (value >> @intCast(u6, index * 8)) & 255)
        index += 1
    }
    code[10] = 0xC3
}

// Writes `mov rdi, imm64; jmp rsi` at `code`: calls its second argument
// with a first argument whose upper bits are garbage.
fn argumentStub(code: [*]u8, value: u64) -> void {
    code[0] = 0x48
    code[1] = 0xBF
    var index: usize = 0
    while index < 8 {
        code[2 + index] = @intCast(u8, (value >> @intCast(u6, index * 8)) & 255)
        index += 1
    }
    code[10] = 0xFF
    code[11] = 0xE6
}

fn stubAt(page: usize, slot: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, page + slot * 16) }
}

fn machineCode() -> u8 {
    const page = mmap(0, 4096, 7, 34, -1, 0)
    if page == 0 || page == 18446744073709551615 { return 40 }
    returnStub(stubAt(page, 0), 0xDEADBEEF00000005)
    returnStub(stubAt(page, 1), 0x123456789ABCDEFF)
    returnStub(stubAt(page, 2), 0xFFFFFFFF00000100) // bool false with garbage above
    argumentStub(stubAt(page, 3), 0xFFFFFFFF00000007)
    argumentStub(stubAt(page, 4), 0x100) // bool false with bit 8 set
    argumentStub(stubAt(page, 5), 0xFFFFFFFF) // i16 -1 with garbage above
    var returns_u32: ReturnsU32 = undefined
    var returns_i8: ReturnsI8 = undefined
    var returns_i16: ReturnsI16 = undefined
    var returns_bool: ReturnsBool = undefined
    var trampoline_u32: Trampoline = undefined
    var trampoline_bool: Trampoline = undefined
    var trampoline_i16: Trampoline = undefined
    unsafe {
        returns_u32 = @ptrFromInt(ReturnsU32, page)
        returns_i8 = @ptrFromInt(ReturnsI8, page + 16)
        returns_i16 = @ptrFromInt(ReturnsI16, page + 16)
        returns_bool = @ptrFromInt(ReturnsBool, page + 32)
        trampoline_u32 = @ptrFromInt(Trampoline, page + 48)
        trampoline_bool = @ptrFromInt(Trampoline, page + 64)
        trampoline_i16 = @ptrFromInt(Trampoline, page + 80)
    }
    const small = returns_u32()
    if @intCast(u64, small) != 5 { return 41 }
    const byte = returns_i8()
    if @intCast(i64, byte) != -1 { return 42 }
    const half = returns_i16()
    if @intCast(i64, half) != -8449 { return 43 }
    if returns_bool() { return 44 }
    if trampoline_u32(0, @intFromPtr(takesU32)) != 7 { return 45 }
    if trampoline_bool(0, @intFromPtr(takesBool)) != 0 { return 46 }
    if @bitCast(i64, trampoline_i16(0, @intFromPtr(takesI16))) != -1 { return 47 }
    return 0
}

pub fn main() -> u8 {
    if getpid() <= 0 { return 1 }
    if strlen(text("hello")) != 5 { return 2 }
    const negative: i32 = -9
    if abs(negative) != 9 { return 3 }

    var buffer: [32]u8 = undefined
    unsafe {
        const written = snprintf(@ptrCast([*]u8, &buffer), 32, text("value=%ld"), -42)
        if written != 9 { return 4 }
    }
    if buffer[6] != 45 || buffer[7] != 52 || buffer[8] != 50 || buffer[9] != 0 { return 5 }

    const handle = dlopen(text("libc.so.6"), 2)
    if handle == 0 { return 6 }
    const address = dlsym(handle, text("strlen"))
    if address == 0 { return 7 }
    var function: Strlen = undefined
    unsafe { function = @ptrFromInt(Strlen, address) }
    if function(text("foreign")) != 7 { return 8 }
    if dlsym(handle, text("mlx_no_such_symbol")) != 0 { return 9 }

    var values: [5]i64 = [5]i64{ 5, -3, 9, 0, 2 }
    qsort(@intFromPtr(&values), 5, 8, @intFromPtr(compare))
    if values[0] != -3 || values[1] != 0 || values[2] != 2 || values[3] != 5 || values[4] != 9 { return 10 }

    var thread: u64 = 0
    if pthread_create(&thread, 0, @intFromPtr(mlx_foreign_worker), 7) != 0 { return 11 }
    var result: usize = 0
    if pthread_join(thread, &result) != 0 { return 12 }
    if result != 21 { return 14 }
    // The export is also visible to the dynamic linker.
    if dlsym(dlopen(@ptrFromInt([*]const u8, 0), 2), text("mlx_foreign_worker")) != @intFromPtr(mlx_foreign_worker) { return 15 }

    const code = machineCode()
    if code != 0 { return code }
    return 13
}
