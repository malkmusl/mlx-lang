// Calls that do not fit what they call, and conditions that do not type:
// each is said at its place before the statement's own error. A call with
// one argument too few or too many names the function and both counts, a
// method changing a constant receiver or taking a value through a pointer
// says so, and an `if` or `while` whose condition fails names it (older
// compilers said only "invalid local declaration" or "expression type
// could not be resolved", or nothing past "semantic analysis failed").
const Counter = struct {
    total: usize

    pub fn add(self: *Self, amount: usize) -> void {
        self.*.total += amount
    }

    pub fn value(self: Self) -> usize {
        return self.total
    }
}

fn scale(value: usize, factor: usize) -> usize { return value * factor }

pub fn main() -> u8 {
    const doubled = scale(2)
    const fixed = Counter.{ .total = 1 }
    fixed.add(1)
    var counter = Counter.{ .total = 2 }
    const pointer = &counter
    const seen = pointer.value()
    if scale(1, 2, 3) != 6 { return 1 }
    while counter.add(1, 2) { return 2 }
    return 0
}
