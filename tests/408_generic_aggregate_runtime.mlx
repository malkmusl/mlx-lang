// A generic aggregate: constants, helper functions and methods using T,
// reflection on T, comptime-if on the parameter, a generic method, both
// call forms, instances as locals, fields, arrays, pointers, optionals,
// parameters and results.
fn Box(comptime T: type) -> type {
    return struct {
        value: T
        count: usize

        const WIDTH: usize = @sizeOf(T)

        fn double(value: T) -> T {
            return value * 2
        }

        pub fn init(value: T) -> Self {
            return Self.{ .value = value, .count = 1 }
        }

        pub fn get(self: Self) -> T {
            return self.value
        }

        pub fn bump(self: *Self) -> void {
            self.*.count += 1
        }

        pub fn doubled(self: *Self) -> T {
            return double(self.*.value)
        }

        pub fn width(self: *Self) -> usize {
            return WIDTH + @alignOf(T) - @alignOf(T)
        }

        pub fn describe(self: *Self) -> u8 {
            if @isInteger(T) {
                return 1
            } else {
                return @compileError("only integers are boxed here")
            }
        }

        pub fn as(self: *Self, comptime U: type) -> U {
            return @intCast(U, self.*.value)
        }
    }
}

const Pair = struct {
    small: Box(u8)
    wide: Box(u32)
}

fn sum(boxes: [2]Box(u8)) -> u8 {
    return boxes[0].get() + boxes[1].get()
}

fn through(box: *Box(u32)) -> *Box(u32) {
    box.bump()
    return box
}

fn maybe(present: bool) -> ?Box(u8) {
    if present { return Box(u8).init(3) }
    return null
}

fn make(comptime T: type, value: T) -> Box(T) {
    return Box(T).init(value)
}

fn main() -> u8 {
    const Wide = Box(u32)
    var a = Wide.init(20)
    a.bump()
    Box(u32).bump(&a)
    if a.count != 3 { return 1 }
    if a.doubled() != 40 { return 2 }
    if a.width() != 4 { return 3 }
    if a.describe() != 1 { return 4 }
    if a.as(u8) != 20 { return 5 }
    var pair = Pair.{ .small = Box(u8).init(1), .wide = Box(u32).init(2) }
    pair.small.bump()
    if pair.small.count != 2 || pair.wide.get() != 2 { return 6 }
    const boxes = [2]Box(u8){ Box(u8).init(4), Box(u8).init(5) }
    if sum(boxes) != 9 { return 7 }
    const pointer = through(&a)
    if pointer.*.count != 4 { return 8 }
    const some = maybe(true)
    if some == null { return 9 }
    if some.?.get() != 3 { return 10 }
    const none = maybe(false)
    if none != null { return 11 }
    const made = make(u16, 300)
    if made.get() != 300 { return 12 }
    const b: Box(u8) = Box(u8).init(13)
    return b.get()
}
