// The compositor's hit-testing with input regions
// (projects/desktop/compositor/scene.mlx, surfaceAtPoint): a surface
// without one takes the pointer everywhere in its buffer; with one, only
// inside it, in its own coordinates, with rectangles added and subtracted
// in order. A subsurface with an empty input region (Firefox's content
// subsurface) is passed over for its parent, and a window with a region
// leaving its shadow margin out (GTK 4) takes nothing there. Exits 13.
const std = @import("std")
const ui = @import("std.ui")
const state = @import("../projects/desktop/compositor/state.mlx")
const scene = @import("../projects/desktop/compositor/scene.mlx")

const Compositor = state.Compositor
const Surface = state.Surface

fn makeSurface(compositor: *Compositor, role: u8, x: i32, y: i32, width: usize, height: usize) -> *Surface {
    var surface: *Surface = undefined
    unsafe { surface = @ptrCast(*Surface, state.allocate(compositor, @sizeOf(Surface))) }
    surface.*.compositor = compositor
    surface.*.role = role
    surface.*.x = x
    surface.*.y = y
    surface.*.hasGeometry = false
    surface.*.pixelWidth = width
    surface.*.pixelHeight = height
    surface.*.pixelCapacity = 0
    surface.*.hasContent = true
    surface.*.mapped = true
    surface.*.parent = 0
    surface.*.titleLength = 0
    surface.*.children = state.newList(compositor.*.allocator)
    surface.*.belowCount = 0
    surface.*.subX = 0
    surface.*.subY = 0
    surface.*.hasInputRegion = false
    surface.*.inputCount = 0
    return surface
}

fn setRegion(surface: *Surface, count: usize) -> void {
    surface.*.hasInputRegion = true
    surface.*.inputCount = count
}

fn op(surface: *Surface, index: usize, subtract: bool, x: i32, y: i32, width: i32, height: i32) -> void {
    surface.*.inputOps[index].subtract = subtract
    surface.*.inputOps[index].x = x
    surface.*.inputOps[index].y = y
    surface.*.inputOps[index].width = width
    surface.*.inputOps[index].height = height
}

pub fn main() -> u8 {
    var compositor: Compositor = undefined
    compositor.allocator = std.page_allocator.init()
    compositor.width = 400
    compositor.height = 300
    compositor.stack = state.newList(compositor.allocator)
    compositor.blurred = state.newList(compositor.allocator)
    compositor.hasText = false
    compositor.keyboardFocus = 0

    // A window at (10, 10), 100x80, with a subsurface at (20, 20) in it,
    // 40x30, above it.
    const window = makeSurface(&compositor, state.ROLE_TOPLEVEL, 10, 10, 100, 80)
    compositor.stack = state.listAppend(compositor.stack, @intFromPtr(window))
    const child = makeSurface(&compositor, state.ROLE_SUBSURFACE, 0, 0, 40, 30)
    child.*.mapped = false
    child.*.parent = @intFromPtr(window)
    child.*.subX = 20
    child.*.subY = 20
    window.*.children = state.listAppend(window.*.children, @intFromPtr(child))

    // No input regions: the subsurface takes the pointer over it, the
    // window elsewhere, nothing outside.
    if scene.surfaceAtPoint(&compositor, 40, 40) != @intFromPtr(child) { return 1 }
    if scene.surfaceAtPoint(&compositor, 15, 15) != @intFromPtr(window) { return 2 }
    if scene.surfaceAtPoint(&compositor, 200, 200) != 0 { return 3 }

    // An empty input region on the subsurface: its parent takes the pointer.
    setRegion(child, 0)
    if scene.surfaceAtPoint(&compositor, 40, 40) != @intFromPtr(window) { return 4 }

    // A region in the subsurface's own coordinates: a rectangle added, a
    // hole subtracted from it, a corner added back.
    op(child, 0, false, 0, 0, 40, 30)
    op(child, 1, true, 10, 10, 10, 10)
    op(child, 2, false, 15, 15, 5, 5)
    setRegion(child, 3)
    if scene.surfaceAtPoint(&compositor, 35, 35) != @intFromPtr(child) { return 5 }
    if scene.surfaceAtPoint(&compositor, 42, 42) != @intFromPtr(window) { return 6 }
    if scene.surfaceAtPoint(&compositor, 47, 47) != @intFromPtr(child) { return 7 }

    // The window leaves a 10-pixel margin out (a shadow): nothing takes
    // the pointer there, the window inside.
    op(window, 0, false, 10, 10, 80, 60)
    setRegion(window, 1)
    if scene.surfaceAtPoint(&compositor, 15, 15) != 0 { return 8 }
    if scene.surfaceAtPoint(&compositor, 25, 25) != @intFromPtr(window) { return 9 }
    if scene.surfaceAtPoint(&compositor, 47, 47) != @intFromPtr(child) { return 10 }
    return 13
}
