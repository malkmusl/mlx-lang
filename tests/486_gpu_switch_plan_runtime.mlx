// The plan that brings the kernel's picture to another output of a
// Radeon (projects/brix/kernel/gpu_mode.mlx's `makeTo`, "THE PICTURE
// BROUGHT TO ANOTHER OUTPUT"), built for the host and made against the
// user's whole card as a table (tests/support/switch_card.mlx: five
// connectors, the firmware's picture out of the HDMI connector 2 on DIG 4
// in DVI mode), held against the study (gpu-autoswitch.verified.md 3.3 to
// 3.5, 4.2, 4.5, 4.6): which controller, front end, back end and PLL the
// new output gets, at the edges (the new back end's own front end taken
// by another back end that is on; every front end taken; another
// controller and the other pair of outputs), every block's bytes that
// carry them, the transmitter made ready only where it was not, the old
// PLL powered down, the way back; every refusal (a DisplayPort
// connector, a back end that is on already, a connector of a kind no
// TMDS signal leaves by, no hot plug line, no PLL, a connector the ROM
// does not hold from both sides, a timing the output cannot carry, the
// picture kept and the monitor of another size); the same-size rule (a
// monitor of the picture's size gets no new picture); the clock the way
// back asks for (as this driver set it, when the frames say the same);
// and a plan for the connector the picture goes out by already, which is
// the plain plan step for step.
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const rom = @import("./support/atom_rom.mlx")
const display = @import("./support/tmds_card.mlx")
const lines = @import("./support/plug_card.mlx")
const card = @import("./support/switch_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0
var name: []const u8 = undefined

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected (")
    say(name)
    say("): ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(display.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !display.has(text) { return }
    say("said, but should not be (")
    say(name)
    say("): ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn named(title: []const u8) -> void {
    name = title
    if show {
        say("-- ")
        say(title)
        say("\n")
    }
}

var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined

fn open() -> void {
    card.makeRom(&builder, card.NEVER, display.Ending.plain)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
}

var readout: scanout.Readout = undefined
var plan: mode.Plan = undefined
var memory: scanout.Memory = undefined

// The user's monitor: 3840x1080 at 270270 kHz (4040 by 1115, porches 48
// and 3, pulses 32 high and 5 low), an HDMI one up to 300 MHz.
fn users() -> edid.Monitor {
    return edid.Monitor.{ .state = edid.State.found, .width = 3840, .height = 1080, .timing = edid.Timing.{ .clock = 270270, .width = 3840, .hTotal = 4040, .hFront = 48, .hSync = 32, .hPositive = true, .height = 1080, .vTotal = 1115, .vFront = 3, .vSync = 5, .vPositive = false, .interlaced = false, .stereo = false }, .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.cta }
}

fn hdmi() -> edid.Offer {
    var o = edid.nothing()
    o.hdmi = true
    o.limit = 300000
    o.extensions = 1
    o.given = 1
    return o
}

// A DVI monitor of 1920x1080 at 148500 kHz (2200 by 1125, porches 88 and
// 4, pulses 44 and 5, both high); one of the firmware's picture's size,
// 1280x960 at 108000 kHz (1800 by 1000).
fn full() -> edid.Monitor {
    return edid.Monitor.{ .state = edid.State.found, .width = 1920, .height = 1080, .timing = edid.Timing.{ .clock = 148500, .width = 1920, .hTotal = 2200, .hFront = 88, .hSync = 44, .hPositive = true, .height = 1080, .vTotal = 1125, .vFront = 4, .vSync = 5, .vPositive = true, .interlaced = false, .stereo = false }, .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.none }
}

fn same() -> edid.Monitor {
    return edid.Monitor.{ .state = edid.State.found, .width = 1280, .height = 960, .timing = edid.Timing.{ .clock = 108000, .width = 1280, .hTotal = 1800, .hFront = 96, .hSync = 112, .hPositive = true, .height = 960, .vTotal = 1000, .vFront = 1, .vSync = 3, .vPositive = true, .interlaced = false, .stereo = false }, .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.none }
}

fn known() -> scanout.Memory {
    return scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
}

fn logWrite(text: []const u8) -> void {
    display.logWrite(text)
    if show { say(text) }
}

fn out() -> scanout.Card { return scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite } }

// The plan for connector `connector` (the ROM's record, or one the test
// changed), said and listed; the picture goes out by connector `from`.
fn makeWith(k: usize, connector: videorom.Connector, from: usize, init: bool, keep: bool, clock: usize, monitor: *const edid.Monitor, offer: *const edid.Offer) -> void {
    const c = out()
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    memory = known()
    scanout.report(&c, &memory, &readout)
    const target = mode.Target.{ .index = k, .connector = connector, .from = from, .init = init, .keep = keep, .clock = clock }
    mode.makeTo(&c, &readout, &memory, &target, monitor, offer, &facts, &plan)
    mode.say(&c, &plan)
    mode.list(&c, &plan)
}

// The plan for connector `k`, as gpu_switch.mlx asks for it.
fn makeTo(k: usize, init: bool, keep: bool, clock: usize, monitor: *const edid.Monitor, offer: *const edid.Offer) -> void { makeWith(k, board.connectors[k], 2, init, keep, clock, monitor, offer) }

// The picture brought from the HDMI connector 2 to the HDMI connector 3:
// the study's 3.5 row "connector 3": controller 0, front end 5, back end
// 5, PLL 5 (ucPpll 25), hot plug line 4 (ucHPDSel 4, DIG_HPD_SELECT 3).
fn toHdmi() -> void {
    named("HDMI 2 to HDMI 3")
    card.users(107962, 1 << 4)
    const monitor = users()
    const offer = hdmi()
    makeTo(3, true, false, 0, &monitor, &offer)
    expect(plan.complete && plan.move.on && plan.move.to == 3 && plan.move.from == 2 && plan.controller == 0, "a move of controller 0")
    expect(plan.tmds.backEnd == 5 && plan.tmds.frontEnd == 5 && plan.tmds.line == 4 && plan.move.backEnd == 4 && plan.move.frontEnd == 4 && plan.move.line == 6, "the two ends")
    expect(plan.runs == 9 && plan.tmds.hdmi && plan.timing.clock == 270270, "nine table runs, HDMI at 270270 kHz")
    line("gpu: plan (move, TMDS): connector 2 (HDMI, DIG 4, PLL 4) to connector 3 (HDMI, DIG 5, front end 5, PLL 5), controller 0 stays: HDMI signalling at 270270 kHz (now DVI at 107960 kHz), a picture of 3840x1080 at 0x500000 of the aperture, the scaler off: 9 table runs and 88 writes would do it\n")
    line("gpu: DIG 5 was not started by the firmware: its transmitter is made ready first; front end 5 sends no audio and no packets of its own, as one that was nobody's should\n")
    // B3 (the study's block for connector 3, byte for byte), its checks,
    // then B1.
    line("gpu: would run UNIPHYTransmitterControl with 05 07 02 04 00 00 00 00 04 00 0c 00 00 00 00 00 (the new output's transmitter made ready)\n")
    line("gpu: would look for 4f48 & 00000001 = 00000000 (the new output's transmitter is still off)\n")
    line("gpu: would look for 4e48 & 00000001 = 00000001 (the output that shows the picture is still on)\n")
    line("gpu: would count the frames (the picture's controller still counts its frames)\n")
    line("gpu: would set 4f47 & 70000000 = 30000000 (the new back end told its hot plug line)\n")
    // D2, D3 on the old ends.
    line("gpu: would set 4e47 & 00001000 = 00000000 (the front end taken off the back end)\n")
    line("gpu: would run UNIPHYTransmitterControl with 04 00 02 00 00 00 00 00 06 00 0c 00 00 00 00 00, only when 4e48 & 00000001 = 00000001 (the transmitter off)\n")
    // X1 with the study's bytes for PLL 4; its words read around it.
    line("gpu: would run SetPixelClock with 00 00 00 00 18 00 0f 01 ff 00 00 00 00 00 00 00 (the old output's PLL powered down)\n")
    line("gpu: would read 9bdf (the old output's PLL before its power-down)\n")
    line("gpu: would read 0164 (the old output's PLL after its power-down)\n")
    // C1 on PLL 25 and the check that controller 0 is on PLL 5; C2 on
    // PLL F's word.
    line("gpu: would run SetPixelClock with 6c 3d 29 00 19 21 03 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set)\n")
    line("gpu: would look for 0143 & 00000017 = 00000005 (it is this back end's PLL's)\n")
    line("gpu: would read 9c7f (the new output's PLL after the clock was set)\n")
    line("gpu: would set 013e & 00000230 = 00000000 (the PLL's clock neither for deep colour nor doubled)\n")
    // U0 to U6 on the new ends.
    line("gpu: would set 4f00 & 00000007 = 00000000 (the front end takes the controller)\n")
    line("gpu: would run DIGxEncoderControl with 05 0f 03 04 93 69 00 00 02 00 00 00 (the front end told the stream)\n")
    line("gpu: would set 4f47 & 00002000 = 00002000 (the front end on the back end, before the transmitter)\n")
    line("gpu: would run UNIPHYTransmitterControl with 05 01 03 04 93 69 00 00 04 00 0c 00 00 00 00 00 (the transmitter on)\n")
    line("gpu: would set 4f47 & 70000000 = 30000000 (the new back end's hot plug line once more)\n")
    // The way back: the new output down, its PLL off, the old one up.
    line("gpu: on the way back would run UNIPHYTransmitterControl with 05 00 03 00 00 00 00 00 04 00 0c 00 00 00 00 00, only when 4f48 & 00000001 = 00000001 (the new output's transmitter off)\n")
    // (The old transmitter told its own line, 6, on the way back too.)
    line("gpu: on the way back would run UNIPHYTransmitterControl with 04 00 02 00 00 00 00 00 06 00 0c 00 00 00 00 00, only when 4e48 & 00000001 = 00000001 (the transmitter off)\n")
    line("gpu: on the way back would run SetPixelClock with 00 00 00 00 19 00 0f 01 ff 00 00 00 00 00 00 00, only when 0143 & 00000017 = 00000005 (the new output's PLL powered down)\n")
    line("gpu: on the way back would run SetPixelClock with 30 79 10 00 18 21 02 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set for the clock of before)\n")
    line("gpu: on the way back would run UNIPHYTransmitterControl with 04 01 02 04 2c 2a 00 00 06 00 0c 00 00 00 00 00 (the transmitter on for the clock of before)\n")
    // The order of the steps (the study's 4.5, row TMDS -> TMDS).
    const order = [_][]const u8{
        "(the new output's transmitter made ready)",
        "(the new back end told its hot plug line)",
        "(the front end taken off the back end)",
        "(the transmitter off)",
        "(the controller stopped)",
        "(the buffers the rows are read through given back)",
        "(the old output's PLL powered down)",
        "(the firmware told that a mode is being set)",
        "(the pixel clock's PLL set)",
        "(the timing set)",
        "(the controller started)",
        "(the front end takes the controller)",
        "(the front end told the stream)",
        "(the transmitter on)",
        "(the controller's picture shown)",
    }
    var at: usize = 0
    for text in order {
        const next = display.after(text, at)
        expect(next != display.NEVER, text)
        if next != display.NEVER { at = next }
    }
    // Nothing of another back end, controller or PLL is in the plan.
    var k: usize = 0
    while k < plan.count {
        const r = plan.steps[k].register
        expect(!(r >= scanout.DIG[0] && r < scanout.DIG[4]) && !(r >= 0x1C00 && r < 0x2C00) && r != 0x100 && r != 0x101 && r != 0x102 && r != 0x103 && r != 0x10C, "a register of the two ends and controller 0 alone")
        k += 1
    }
    expect(display.written == 0, "a plan writes nothing")
}

// The same without the "init": its transmitter was made ready at this
// boot already.
fn noInit() -> void {
    named("HDMI 2 to HDMI 3, the transmitter ready")
    card.users(107962, 1 << 4)
    const monitor = users()
    const offer = hdmi()
    makeTo(3, false, false, 0, &monitor, &offer)
    expect(plan.complete && plan.runs == 8 && !plan.move.init, "eight table runs")
    noLine("(the new output's transmitter made ready)")
    noLine("(the picture's controller still counts its frames)")
    line("gpu: DIG 5 has been made ready at this boot already; front end 5")
    line("gpu: would set 4f47 & 70000000 = 30000000 (the new back end told its hot plug line)\n")
}

// To the DVI-D connector 4 (UNIPHY A: back end 0, front end 0, PLL 0, hot
// plug line 3), a DVI monitor: the study's 3.5 row "connector 4".
fn toDvi() -> void {
    named("HDMI 2 to DVI 4")
    card.users(107962, 1 << 3)
    const monitor = full()
    const offer = edid.nothing()
    makeTo(4, true, false, 0, &monitor, &offer)
    expect(plan.complete && plan.tmds.backEnd == 0 && plan.tmds.frontEnd == 0 && plan.tmds.line == 3 && !plan.tmds.hdmi && plan.runs == 9, "DVI on back end 0, front end 0")
    line("gpu: plan (move, TMDS): connector 2 (HDMI, DIG 4, PLL 4) to connector 4 (DVI-D (dual link), DIG 0, front end 0, PLL 0), controller 0 stays: DVI signalling at 148500 kHz (now DVI at 107960 kHz), a picture of 1920x1080 at ")
    line("gpu: DIG 0 was not started by the firmware: its transmitter is made ready first; front end 0 sends DVI signalling, which has no packets\n")
    line("gpu: would run UNIPHYTransmitterControl with 00 07 02 04 00 00 00 00 03 00 04 00 00 00 00 00 (the new output's transmitter made ready)\n")
    line("gpu: would set 4a47 & 70000000 = 20000000 (the new back end told its hot plug line)\n")
    line("gpu: would run SetPixelClock with c8 a8 16 00 14 1e 02 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set)\n")
    line("gpu: would look for 0143 & 00000017 = 00000000 (it is this back end's PLL's)\n")
    line("gpu: would run DIGxEncoderControl with 00 0f 02 04 02 3a 00 00 00 00 00 00 (the front end told the stream)\n")
    line("gpu: would run UNIPHYTransmitterControl with 00 01 02 04 02 3a 00 00 03 00 04 00 00 00 00 00 (the transmitter on)\n")
    noLine("would set 4a09")
    // The user's monitor needs 270270 kHz: no DVI link carries it (one
    // link is built; the study's 3.4: two links only above 165 MHz).
    named("HDMI 2 to DVI 4, a timing above one link")
    card.users(107962, 1 << 3)
    const wide = users()
    const offer2 = hdmi()
    makeTo(4, true, false, 0, &wide, &offer2)
    expect(!plan.complete && plan.missing == mode.Missing.no_timing_fits, "no timing fits")
    line("gpu: plan (move, TMDS): nothing would be set: ")
}

// The new back end's own front end is sent by another back end that is
// on: the highest one none sends; every one sent: no plan. (The study's
// 3.3 rule 3, Linux's dce110_find_first_free_match_stream_enc_for_link.)
fn frontEnds() -> void {
    const c = out()
    const monitor = users()
    const offer = hdmi()
    // (Back end 1 sends front end 5 with controller 1's picture, which is
    // off: no output of the controller that runs.)
    named("front ends: the back end's own taken")
    card.users(107962, 1 << 4)
    display.store(scanout.DIG[1] + scanout.DIG_BE_EN_CNTL, 0x101)
    display.store(scanout.DIG[1] + scanout.DIG_BE_CNTL, 0x00022000)
    display.store(scanout.DIG[5] + scanout.DIG_FE_CNTL, 1)
    expect(mode.frontEndFor(&c, 5) == 3 && mode.frontEndFor(&c, 0) == 0 && mode.frontEndFor(&c, 4) == 3, "front end 5 taken by DIG 1, 4 by DIG 4: the highest free is 3")
    makeTo(3, true, false, 0, &monitor, &offer)
    expect(plan.complete && plan.tmds.frontEnd == 3, "front end 3")
    line("gpu: plan (move, TMDS): connector 2 (HDMI, DIG 4, PLL 4) to connector 3 (HDMI, DIG 5, front end 3, PLL 5), ")
    line("gpu: would set 4d00 & 00000007 = 00000000 (the front end takes the controller)\n")
    line("gpu: would run DIGxEncoderControl with 03 0f 03 04 93 69 00 00 02 00 00 00 (the front end told the stream)\n")
    line("gpu: would set 4f47 & 00000800 = 00000800 (the front end on the back end, before the transmitter)\n")
    // A back end that is off does not hold its front end.
    named("front ends: a back end that is off names one")
    card.users(107962, 1 << 4)
    display.store(scanout.DIG[1] + scanout.DIG_BE_CNTL, 0x00022000)
    expect(mode.frontEndFor(&c, 5) == 5, "a word of a back end that is off does not count")
    named("front ends: every one taken")
    card.users(107962, 1 << 4)
    var n: usize = 0
    while n < 4 {
        display.store(scanout.DIG[n] + scanout.DIG_BE_EN_CNTL, 0x101)
        display.store(scanout.DIG[n] + scanout.DIG_BE_CNTL, 0x00020000 | (@intCast(usize, 0x100) << @intCast(u6, n)))
        display.store(scanout.DIG[n] + scanout.DIG_FE_CNTL, 1)
        n += 1
    }
    display.store(scanout.DIG[5] + scanout.DIG_FE_CNTL, 1)
    display.store(scanout.DIG[0] + scanout.DIG_BE_CNTL, 0x00022100)
    expect(mode.frontEndFor(&c, 5) == mode.NO_CONNECTOR, "none free")
    makeTo(3, true, false, 0, &monitor, &offer)
    expect(!plan.complete && plan.move.refused == mode.Refused.no_front_end, "refused")
    line("gpu: plan (move, TMDS): nothing would be set: every front end is sent by a back end that is on: there is none for the new output\n")
}

// Every refusal, each said.
fn refusals() -> void {
    const monitor = users()
    const offer = hdmi()
    named("refused: a DisplayPort connector")
    card.users(107962, 1 << 1)
    makeTo(0, true, false, 0, &monitor, &offer)
    expect(!plan.complete && plan.move.refused == mode.Refused.displayport, "DisplayPort")
    line("gpu: plan (move, TMDS): nothing would be set: the connector is a DisplayPort one: bringing the picture to it is its link's path, which this plan is not\n")
    named("refused: its back end is on already")
    card.users(107962, 1 << 4)
    display.store(scanout.DIG[5] + scanout.DIG_BE_EN_CNTL, 0x101)
    makeTo(3, true, false, 0, &monitor, &offer)
    expect(!plan.complete && plan.move.refused == mode.Refused.busy, "busy")
    line("gpu: plan (move, TMDS): nothing would be set: DIG 5 is on already (its word reads 0x101), by nothing this plan knows of\n")
    named("refused: a VGA connector")
    card.users(107962, 1 << 4)
    var vga = board.connectors[3]
    vga.kind = videorom.CONNECTOR_OBJECT_ID_VGA
    makeWith(3, vga, 2, true, false, 0, &monitor, &offer)
    expect(!plan.complete && plan.move.refused == mode.Refused.kind, "kind")
    line("gpu: plan (move, TMDS): nothing would be set: the connector is of the kind \"VGA\": no TMDS signal leaves by that\n")
    named("refused: no hot plug line")
    card.users(107962, 1 << 4)
    var lineless = board.connectors[3]
    lineless.hotPlugLine = videorom.NONE
    makeWith(3, lineless, 2, true, false, 0, &monitor, &offer)
    expect(!plan.complete && plan.missing == mode.Missing.hot_plug_pin, "no line")
    named("refused: UNIPHY G, no PLL")
    card.users(107962, 1 << 4)
    var seventh = board.connectors[3]
    seventh.transmitter = 6
    makeWith(3, seventh, 2, true, false, 0, &monitor, &offer)
    expect(!plan.complete && plan.missing == mode.Missing.no_pll, "no PLL")
    named("refused: the ROM's two sides do not agree")
    card.users(107962, 1 << 4)
    var odd = board.connectors[3]
    odd.agrees = false
    makeWith(3, odd, 2, true, false, 0, &monitor, &offer)
    expect(!plan.complete && plan.missing == mode.Missing.no_connector, "no connector")
    named("refused: the picture kept, the monitor of another size")
    card.users(107962, 1 << 4)
    makeTo(3, true, true, 0, &monitor, &offer)
    expect(!plan.complete && plan.move.refused == mode.Refused.another_size && plan.move.keep, "another size")
    line("gpu: plan (move, TMDS): nothing would be set: the picture stays as it is, and the monitor would be sent 3840x1080, not the picture's 1280x960\n")
    expect(display.written == 0, "a plan writes nothing")
}

// A monitor of the picture's size: the picture stays where it is (no new
// one, nothing cleared), only its way out and timing change; the way back
// asks for the clock this driver set when the frames say the same.
fn sameSize() -> void {
    const monitor = same()
    const offer = edid.nothing()
    named("the same size: the picture kept")
    card.users(107962, 1 << 4)
    makeTo(3, true, false, 0, &monitor, &offer)
    expect(plan.complete && plan.move.keep && plan.offset == 0 && plan.width == 1280 && plan.height == 960, "the picture kept")
    line("the picture of 1280x960 stays where it is: ")
    line("gpu: controller 0 takes its pixel clock from PHY PLL 4; the way back would ask for 107960 kHz (measured) and the timing 1280x960 of 1800x1000")
    named("the clock this driver set")
    card.users(107962, 1 << 4)
    makeTo(3, true, true, 107970, &monitor, &offer)
    expect(plan.complete && plan.move.clockKnown && plan.tmds.clockBack == 107970, "the clock as set")
    line("gpu: controller 0 takes its pixel clock from PHY PLL 4; the way back would ask for 107970 kHz (as this driver set it) and the timing 1280x960 of 1800x1000")
    named("a clock the frames do not say")
    card.users(107962, 1 << 4)
    makeTo(3, true, true, 148500, &monitor, &offer)
    expect(plan.complete && !plan.move.clockKnown && plan.tmds.clockBack == 107960, "the measured clock")
}

// The connector the picture goes out by already: the plain plan, step
// for step.
fn sameConnector() -> void {
    named("the same connector")
    card.users(107962, 1 << 6)
    const monitor = users()
    const offer = hdmi()
    makeWith(2, board.connectors[2], 2, false, false, 0, &monitor, &offer)
    const count = plan.count
    var kinds: [mode.STEPS]mode.Kind = undefined
    var registers: [mode.STEPS]usize = undefined
    var values: [mode.STEPS]usize = undefined
    var masks: [mode.STEPS]usize = undefined
    var k: usize = 0
    while k < count {
        kinds[k] = plan.steps[k].kind
        registers[k] = plan.steps[k].register
        values[k] = plan.steps[k].value
        masks[k] = plan.steps[k].mask
        k += 1
    }
    expect(plan.complete && !plan.move.on && plan.move.asked, "a plan for the same output")
    line("gpu: plan (the same output, TMDS): HDMI signalling at 270270 kHz (now DVI at 107960 kHz), a picture of 3840x1080 at 0x500000 of the aperture, the scaler off: 7 table runs and 86 writes would do it\n")
    const c = out()
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    mode.makeFor(&c, &readout, &memory, &monitor, &offer, &facts, mode.Wish.own, &plan)
    var alike = plan.count == count
    k = 0
    while alike && k < count {
        alike = plan.steps[k].kind == kinds[k] && plan.steps[k].register == registers[k] && plan.steps[k].value == values[k] && plan.steps[k].mask == masks[k]
        k += 1
    }
    expect(alike, "step for step the plain plan")
}

// Another controller (2) and the other pair of outputs: the firmware's
// picture out of the HDMI connector 3 (DIG 5), brought to connector 2
// (DIG 4): nothing is tied to one place.
fn elsewhere() -> void {
    named("controller 2 from HDMI 3 to HDMI 2")
    card.reset()
    var n: usize = 0
    while n < 6 {
        display.store(scanout.DIG[n] + scanout.DIG_BE_CNTL, 0x00010000)
        display.store(scanout.DIG[n] + scanout.DIG_BE_EN_CNTL, 0x100)
        display.store(scanout.DIG[n] + scanout.HDMI_CONTROL, 0x00010001)
        n += 1
    }
    display.firmware(2, 5, 5, false, 4, 107962)
    n = 1
    while n <= 6 {
        lines.line(n, n == 6)
        n += 1
    }
    const monitor = users()
    const offer = hdmi()
    makeWith(2, board.connectors[2], 3, true, false, 0, &monitor, &offer)
    expect(plan.complete && plan.controller == 2 && plan.tmds.backEnd == 4 && plan.tmds.frontEnd == 4 && plan.move.backEnd == 5, "controller 2 to DIG 4")
    line("gpu: plan (move, TMDS): connector 3 (HDMI, DIG 5, PLL 5) to connector 2 (HDMI, DIG 4, front end 4, PLL 4), controller 2 stays: ")
    line("gpu: would run UNIPHYTransmitterControl with 04 07 02 04 00 00 00 00 06 00 0c 00 00 00 00 00 (the new output's transmitter made ready)\n")
    line("gpu: would run SetPixelClock with 00 00 00 00 19 00 0f 01 ff 00 00 00 00 00 00 00 (the old output's PLL powered down)\n")
    line("gpu: would run SetPixelClock with 6c 3d 29 00 18 21 03 00 02 00 00 00 00 00 00 00 (the pixel clock's PLL set)\n")
    line("gpu: would look for 014b & 00000017 = 00000004 (it is this back end's PLL's)\n")
    line("gpu: would set 4e00 & 00000007 = 00000002 (the front end takes the controller)\n")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    name = "the ROM"
    card.reset()
    open()
    expect(board.found && board.count == 5 && board.connectors[3].fastHdmi && !board.connectors[4].fastHdmi, "the user's five connectors")
    toHdmi()
    noInit()
    toDvi()
    frontEnds()
    refusals()
    sameSize()
    sameConnector()
    elsewhere()
    if failed != 0 { return failed }
    return 13
}
