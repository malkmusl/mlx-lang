// A @compileError analysis reaches (here the branch a `comptime`
// condition takes) stops the build with its text, MLX-E5003.
const builtin = @import("builtin")

pub fn main() -> u8 {
    if comptime builtin.pointer_bits == 64 {
        @compileError("this program needs 32-bit pointers")
    }
    return 0
}
