// std.git: names written and read back, a delta applied (copies and
// inserts, a damaged one refused), commits parsed (two parents, a
// signature's lines passed over, the people and their times, the
// message), the repository of the directory the test runs in (when it is
// one) read to its HEAD and counted, a directory without a repository
// told apart.
//
// With an argument, the file it names says more to check, a line each,
// against what git itself answered (tools/check_git_reader.sh writes it
// for repositories it makes: loose objects, packs with OFS_DELTA and
// REF_DELTA, a merge, packed-refs, a worktree, a shallow clone):
//
//     head DIR COMMIT COUNT SHALLOW   HEAD of DIR's repository is COMMIT,
//                                     COUNT commits reachable from it
//                                     (`git rev-list --count HEAD`),
//                                     SHALLOW 1 when the count stopped at
//                                     a shallow clone's boundary
//     build DIR PATH VERSION BUILD COMMIT
//                                     buildNumberOf(DIR, PATH): the
//                                     version VERSION (PATH's first line
//                                     in HEAD's tree), build BUILD, HEAD
//                                     COMMIT
//     none DIR                        no repository there or above
//     objects DIR LIST                each line "NAME KIND SIZE" of LIST
//                                     (`git cat-file --batch-all-objects
//                                     --batch-check`) read: its kind, its
//                                     size, and the SHA-1 of "KIND SIZE\0"
//                                     and its bytes is NAME
//
// Exits 13 when every check holds, else the number of the first check
// that failed (with a line about it on stderr for the file's checks).
const std = @import("std")
const git = @import("std.git")
const pack = @import("std.git.pack")
const sha1 = @import("std.sha1")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stderr(), text) }

fn fail(line: []const u8, why: []const u8) -> u8 {
    say("413_git_runtime: ")
    say(line)
    say(": ")
    say(why)
    say("\n")
    return 40
}

const COMMIT_TEXT = "tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\nparent 1111111111111111111111111111111111111111\nparent 2222222222222222222222222222222222222222\nauthor A U Thor <author@example.com> 1700000000 +0200\ncommitter C O Mitter <committer@example.com> 1700000100 -0130\ngpgsig -----BEGIN PGP SIGNATURE-----\n parent 3333333333333333333333333333333333333333\n -----END PGP SIGNATURE-----\n\nMerge it\n\nbody\n"

fn builtIn() -> u8 {
    // Names.
    var id: git.Id = undefined
    if !git.parseId("9142CE754db8e855ed39143ddd10aef3b93b1829", &id) || id.bytes[0] != 0x91 || id.bytes[19] != 0x29 { return 1 }
    var hex: [40]u8 = undefined
    const digits: [*]u8 = &hex
    git.writeHex(&id, digits)
    if !std.text.same(digits[0..40], "9142ce754db8e855ed39143ddd10aef3b93b1829") { return 2 }
    if git.parseId("9142ce754db8e855ed39143ddd10aef3b93b182", &id) || git.parseId("9142ce754db8e855ed39143ddd10aef3b93b182g", &id) { return 3 }

    // A delta: "hello " copied, "there " inserted, "world" copied.
    const base = "hello world"
    const delta = "\x0b\x11\x90\x06\x06there \x91\x06\x05"
    var out = std.ArrayList(u8).init(std.heap.allocator())
    if !pack.applyDelta(base, delta, &out) || !std.text.same(out.items(), "hello there world") { return 4 }
    // Another base size, a copy past the base's end, a zero instruction.
    if pack.applyDelta("hello", delta, &out) { return 5 }
    if pack.applyDelta(base, "\x0b\x05\x90\x0c", &out) { return 6 }
    if pack.applyDelta(base, "\x0b\x01\x00", &out) { return 7 }

    // A merge commit with a signature.
    var commit: git.Commit = undefined
    if !git.parseCommit(COMMIT_TEXT, &commit) { return 8 }
    if commit.parentCount != 2 { return 9 }
    const second = git.parent(&commit, 1)
    if second.bytes[0] != 0x22 || second.bytes[19] != 0x22 || git.parent(&commit, 0).bytes[7] != 0x11 { return 10 }
    if commit.tree.bytes[0] != 0x4b { return 11 }
    if !std.text.same(commit.author.name, "A U Thor") || !std.text.same(commit.author.email, "author@example.com") || commit.author.time != 1700000000 || !std.text.same(commit.author.zone, "+0200") { return 12 }
    if !std.text.same(commit.committer.name, "C O Mitter") || commit.committer.time != 1700000100 || !std.text.same(commit.committer.zone, "-0130") { return 14 }
    if !std.text.same(commit.message, "Merge it\n\nbody\n") { return 15 }
    // Not a commit: no tree, a parent before the tree.
    if git.parseCommit("author A <a> 1 +0000\n\nx", &commit) { return 16 }
    if git.parseCommit("parent 1111111111111111111111111111111111111111\ntree 4b825dc642cb6eb9a060e54bf8d69288fbee4904\n\n", &commit) { return 17 }

    // The repository the test runs in, when it is one (a tree without
    // .git is a program's "dev").
    var head: git.Id = undefined
    var count: git.Count = undefined
    const status = git.headCount(".", &head, &count)
    if status != git.Status.ok && status != git.Status.noRepository { return 18 }
    if status == git.Status.ok {
        if count.commits == 0 { return 19 }
        var repository = git.Repository.init()
        if git.open(&repository, "std/src") != git.Status.ok { return 20 }
        var again: git.Id = undefined
        if git.headCommit(&repository, &again) != git.Status.ok || !git.same(&again, &head) { return 21 }
        var object = git.Object.init()
        if git.readObject(&repository, head, &object) != git.Status.ok || object.kind != git.Kind.commit { return 22 }
        if !git.parseCommit(object.bytes(), &commit) { return 23 }
        if git.readObject(&repository, commit.tree, &object) != git.Status.ok || object.kind != git.Kind.tree { return 24 }
        var missing: git.Id = undefined
        _ = git.parseId("0000000000000000000000000000000000000001", &missing)
        if git.readObject(&repository, missing, &object) != git.Status.missingObject { return 25 }
        if git.resolveReference(&repository, "refs/heads/no-such-branch-here", &again) != git.Status.noReference { return 26 }
    }
    // The root has no repository.
    var root = git.Repository.init()
    if git.open(&root, "/proc/self") != git.Status.noRepository { return 27 }
    return 13
}

// The words of LINE (split at spaces) into WORDS: how many (at most 7).
fn words(line: []const u8, into: *[7][]const u8) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < line.length && count < 7 {
        while at < line.length && line[at] == 32 { at += 1 }
        const start = at
        while at < line.length && line[at] != 32 { at += 1 }
        if at > start {
            into.*[count] = line[start..at]
            count += 1
        }
    }
    return count
}

fn decimal(text: []const u8) -> usize {
    var value: usize = 0
    for c in text { value = value * 10 + @intCast(usize, c - 48) }
    return value
}

fn kindName(kind: git.Kind) -> []const u8 {
    if kind == git.Kind.commit { return "commit" }
    if kind == git.Kind.tree { return "tree" }
    if kind == git.Kind.blob { return "blob" }
    if kind == git.Kind.tag { return "tag" }
    return "none"
}

// Every object of the list file LIST read from DIRECTORY's repository and
// checked.
fn checkObjects(line: []const u8, directory: []const u8, list: []const u8) -> u8 {
    var repository = git.Repository.init()
    if git.open(&repository, directory) != git.Status.ok { return fail(line, "the repository does not open") }
    var path = std.ArrayList(u8).init(std.heap.allocator())
    _ = path.appendSlice(list)
    _ = path.append(0)
    const loaded = std.fs.readFileAlloc(path.items().pointer, std.heap.allocator())
    if loaded == null { return fail(line, "the list cannot be read") }
    const contents = loaded.?
    const text = contents.items[0..contents.length]
    var object = git.Object.init()
    var header = std.ArrayList(u8).init(std.heap.allocator())
    var checked: usize = 0
    var at: usize = 0
    var result: u8 = 13
    while at < text.length && result == 13 {
        const start = at
        while at < text.length && text[at] != 10 { at += 1 }
        const entry = text[start..at]
        at += 1
        var parts: [7][]const u8 = undefined
        if words(entry, &parts) != 3 { continue }
        var id: git.Id = undefined
        if !git.parseId(parts[0], &id) {
            result = fail(entry, "not a name")
            break
        }
        const status = git.readObject(&repository, id, &object)
        if status != git.Status.ok {
            result = fail(entry, git.describe(status))
            break
        }
        if !std.text.same(kindName(object.kind), parts[1]) {
            result = fail(entry, "another kind")
            break
        }
        if object.bytes().length != decimal(parts[2]) {
            result = fail(entry, "another size")
            break
        }
        header.clearRetainingCapacity()
        _ = header.appendSlice(parts[1])
        _ = header.append(32)
        _ = header.appendSlice(parts[2])
        _ = header.append(0)
        var hashing: sha1.Sha1 = undefined
        sha1.sha1Init(&hashing)
        sha1.sha1Update(&hashing, header.items())
        sha1.sha1Update(&hashing, object.bytes())
        var digest: [20]u8 = undefined
        sha1.sha1Final(&hashing, &digest)
        var index: usize = 0
        while index < 20 {
            if digest[index] != id.bytes[index] { break }
            index += 1
        }
        if index != 20 {
            result = fail(entry, "other bytes (their SHA-1 is not the name)")
            break
        }
        checked += 1
    }
    std.fs.ArrayList.deinit(contents)
    if result == 13 && checked == 0 { return fail(line, "no objects listed") }
    return result
}

fn checkHead(line: []const u8, parts: *[7][]const u8) -> u8 {
    var head: git.Id = undefined
    var count: git.Count = undefined
    const status = git.headCount(parts.*[1], &head, &count)
    if status != git.Status.ok { return fail(line, git.describe(status)) }
    var hex: [40]u8 = undefined
    const digits: [*]u8 = &hex
    git.writeHex(&head, digits)
    if !std.text.same(digits[0..40], parts.*[2]) { return fail(line, "another HEAD") }
    if count.commits != decimal(parts.*[3]) {
        say("413_git_runtime: counted ")
        _ = std.io.writeUnsigned(std.io.stderr(), count.commits)
        say("\n")
        return fail(line, "another count")
    }
    if count.shallow != std.text.same(parts.*[4], "1") { return fail(line, "shallow or not otherwise") }
    return 13
}

fn checkBuild(line: []const u8, parts: *[7][]const u8) -> u8 {
    var number: git.BuildNumber = undefined
    const status = git.buildNumberOf(parts.*[1], parts.*[2], &number)
    if status != git.Status.ok { return fail(line, git.describe(status)) }
    if !std.text.same(number.version(), parts.*[3]) {
        say("413_git_runtime: version ")
        say(number.version())
        say("\n")
        return fail(line, "another version")
    }
    if number.build != decimal(parts.*[4]) {
        say("413_git_runtime: build ")
        _ = std.io.writeUnsigned(std.io.stderr(), number.build)
        say("\n")
        return fail(line, "another build")
    }
    var hex: [40]u8 = undefined
    const digits: [*]u8 = &hex
    git.writeHex(&number.commit, digits)
    if !std.text.same(digits[0..40], parts.*[5]) { return fail(line, "another HEAD") }
    return 13
}

fn checkFile(name: []const u8) -> u8 {
    var path = std.ArrayList(u8).init(std.heap.allocator())
    _ = path.appendSlice(name)
    _ = path.append(0)
    const loaded = std.fs.readFileAlloc(path.items().pointer, std.heap.allocator())
    if loaded == null { return fail(name, "cannot be read") }
    const contents = loaded.?
    const text = contents.items[0..contents.length]
    var at: usize = 0
    var result: u8 = 13
    var checks: usize = 0
    while at < text.length && result == 13 {
        const start = at
        while at < text.length && text[at] != 10 { at += 1 }
        const line = text[start..at]
        at += 1
        var parts: [7][]const u8 = undefined
        const count = words(line, &parts)
        if count == 0 || parts[0][0] == 35 { continue }
        checks += 1
        if count == 5 && std.text.same(parts[0], "head") {
            result = checkHead(line, &parts)
        } else if count == 6 && std.text.same(parts[0], "build") {
            result = checkBuild(line, &parts)
        } else if count == 2 && std.text.same(parts[0], "none") {
            var repository = git.Repository.init()
            const status = git.open(&repository, parts[1])
            if status != git.Status.noRepository { result = fail(line, "a repository is found") }
        } else if count == 3 && std.text.same(parts[0], "objects") {
            result = checkObjects(line, parts[1], parts[2])
        } else {
            result = fail(line, "not a check")
        }
    }
    std.fs.ArrayList.deinit(contents)
    if result == 13 && checks == 0 { return fail(name, "no checks") }
    return result
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const result = builtIn()
    if result != 13 { return result }
    if std.process.count(arguments) > 1 { return checkFile(std.string.asSlice(std.process.argument(arguments, 1))) }
    return 13
}
