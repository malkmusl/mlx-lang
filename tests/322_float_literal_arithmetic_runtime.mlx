// Arithmetic on float literals alone is float arithmetic: `1.0 / 255.0`
// is the f64 nearest to 1/255, in a module constant, a local and an
// argument, as f64 and as f32. (Two literals had no type in lowering, and
// the backend added and divided their bit patterns as integers: 1.0 /
// 255.0 came out 0, 1.5 + 2.25 a NaN.)

const SCALE: f64 = 1.0 / 255.0
const HALF: f32 = 1.0 / 2.0
const PI_HALF: f64 = 3.141592653589793 / 2.0

fn bitsOf(value: f64) -> u64 {
    return @bitCast(u64, value)
}

pub fn main() -> u8 {
    if @bitCast(u64, SCALE) != 4571171282956062736 { return 1 }   // 0x3F70101010101010
    if HALF != 0.5 { return 2 }
    if @bitCast(u64, PI_HALF) != 4609753056924675352 { return 3 }
    const sum: f64 = 1.5 + 2.25
    if sum != 3.75 { return 4 }
    const tenth: f64 = 0.1 + 0.2
    if @bitCast(u64, tenth) != 4599075939470750516 { return 5 }   // 0.30000000000000004
    const quarter: f64 = -1.0 / 4.0
    if quarter != -0.25 { return 6 }
    if bitsOf(10.0 - 0.5) != @bitCast(u64, @floatCast(f64, 9.5)) { return 7 }
    const small: f32 = 1.0 / 3.0
    if @bitCast(u32, small) != 1051372203 { return 8 }             // 0x3EAAAAAB
    var x: f64 = 255.0
    if x * SCALE != 1.0 { return 9 }
    return 13
}
