// Module-level constants the comptime evaluator holds no value for: floats
// (`const HALF: f64 = 0.5`) and structs with slices in them, read in their
// module and from another one. Older compilers had no value to lower them
// to ("unresolved backend symbol") or segfaulted reading the struct's
// fields. A local of the using function named like a name of the
// constant's module does not stand in for it. Exits 13 when every check
// holds, else the number of the first check that failed.
const lib = @import("./modules/310_constants.mlx")

const HALF: f64 = 0.5
const Limits = struct { low: i32, high: i32 }
const LIMITS = Limits.{ .low = -4, .high = 9 }

pub fn main() -> u8 {
    const value: f64 = HALF * 4.0
    if value != 2.0 { return 1 }
    const scaled: f32 = lib.SCALE * 2.0
    if scaled != 5.0 { return 2 }
    if LIMITS.high - LIMITS.low != 13 { return 3 }
    const package = lib.PACKAGE
    if package.count != 3 || package.name.length != 8 || package.name[0] != 109 { return 4 }
    const NAME = "shadow"
    if lib.PACKAGE.name.length != 8 || NAME.length != 6 { return 5 }
    if lib.PACKAGE.version.length != 5 { return 6 }
    return 13
}
