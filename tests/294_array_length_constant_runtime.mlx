// Tests that an array whose length is a named constant gets that many
// elements: this module's constant, another module's, and an expression
// over them. The compiler used to take only a written-out number and
// gave the binding no size at all for anything else, so writing into it
// went over the frame and wrecked whatever stood next to it (a password
// hash's buffer did, in std.crypt). Exits 13 on success.
const room = @import("./support/array_room.mlx")

const LOCAL: usize = 192

// Fills `length` bytes and says how many it could fill before it ran
// into the mark the caller left behind it.
fn fill(bytes: [*]u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        bytes[index] = 7
        index += 1
    }
}

// An array of `LOCAL` bytes, filled to the brim: `text`, which lives in
// the frame as well, has to come back whole.
fn withLocalConstant(text: []const u8) -> usize {
    var block: [LOCAL]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &block) }
    fill(bytes, LOCAL)
    return text.length + @intCast(usize, block[LOCAL - 1])
}

fn withImportedConstant(text: []const u8) -> usize {
    var block: [room.ROOM]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &block) }
    fill(bytes, room.ROOM)
    return text.length + @intCast(usize, block[room.ROOM - 1])
}

fn withExpression(text: []const u8) -> usize {
    var block: [room.ROOM * 2 + 8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &block) }
    fill(bytes, room.ROOM * 2 + 8)
    return text.length + @intCast(usize, block[room.ROOM * 2 + 7])
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if withLocalConstant("abcdef") != 13 { return 1 }
    if withImportedConstant("abcdef") != 13 { return 2 }
    if withExpression("abcdef") != 13 { return 3 }
    // The lengths themselves, as the type carries them.
    var local: [LOCAL]u8 = undefined
    if local.length != 192 { return 4 }
    var imported: [room.ROOM]u8 = undefined
    if imported.length != 256 { return 5 }
    var computed: [room.ROOM * 2 + 8]u8 = undefined
    if computed.length != 520 { return 6 }
    return 13
}
