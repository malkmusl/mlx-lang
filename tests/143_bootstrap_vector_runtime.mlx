const vector_module = @import("../std/bootstrap/vector.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")

const Record = struct {
    kind: u16
    flags: u32
    offset: usize
    delta: i16
    largeDelta: i32
}

pub fn main() -> u8 {
    var records = vector_module.init(page_allocator.init(), 24, 8, 1)
    var index: usize = 0
    while index < 12 {
        const record = Record.{
            .kind = @intCast(u16, 1000 + index),
            .flags = @intCast(u32, 70000 + index),
            .offset = index * 9,
            .delta = -9,
            .largeDelta = -70009,
        }
        unsafe {
            records = vector_module.append(records, @ptrCast([*]const u8, &record))
        }
        index += 1
    }
    if records.length != 12 || records.capacity < 12 { return 1 }
    unsafe {
        const selected = @ptrCast(*Record, vector_module.at(records, 9)).*
        if selected.kind != 1009 { return 2 }
        if selected.flags != 70009 { return 3 }
        if selected.offset != 81 { return 4 }
        if selected.delta != -9 || selected.largeDelta != -70009 { return 7 }
    }
    records = vector_module.pop(records)
    if records.length != 11 { return 5 }
    records = vector_module.clear(records)
    if records.length != 0 { return 6 }
    vector_module.deinit(records)
    return 13
}
