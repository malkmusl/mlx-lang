// A multiplication by a constant power of two is compiled to a shift left
// (the x86_64 backend's emitPowerOfTwoMultiplication; an index scaled by
// an element's size, Memory.emitScale) and must stay the product: for
// every integer type and every factor 2^n the type has, a wrapping product
// (`*%`) of the operands at the edges with the factor written out is the
// one with the same factor read at run time, which the processor
// multiplies by; so is a checked product (`*`) of the narrow unsigned
// types wherever it fits, and one that does not fit still traps (a child
// process makes it and is ended by the trap). Then the forms: the constant
// on the left, a local multiplied in place, 64-bit factors beyond an
// immediate, elements of 2 to 32 bytes reached by an index. Exits 13 when
// every check holds, else the number of the first check that failed.
const linux = @import("../std/bootstrap/os/linux.mlx")
const process = linux.process

// The factors as the program finds them when it runs: 2^n shifted from a
// module-level variable, where the compiler sees no constant.
var one: u64 = 1 // (per run)
var powers: [64]u64 = undefined

fn power(n: usize) -> u64 { return powers[n] }

const EDGES: usize = 12

// Operand `e` for the factor 2^n of a type of `bits` bits, as the bits of
// an unsigned word (a signed type reads them as its own).
fn edge(e: usize, n: usize, bits: usize) -> u64 {
    const top = power(bits - 1)
    const largest = top + (top - 1)
    const fits = largest >> @intCast(u6, n)
    if e == 0 { return 0 }
    if e == 1 { return 1 }
    if e == 2 { return 2 & largest }
    if e == 3 { return 3 & largest }
    if e == 4 { return fits }
    if e == 5 { return (fits +% 1) & largest }
    if e == 6 { return fits >> 1 }
    if e == 7 { return largest }
    if e == 8 { return largest - 1 }
    if e == 9 { return top }
    if e == 10 { return 0x5555555555555555 & largest }
    return 0xAAAAAAAAAAAAAAAA & largest
}

// The wrapping product by 2^n with the factor written out.
fn wrappingU8(x: u8, n: usize) -> u8 {
    if n == 0 { return x *% 1 }
    if n == 1 { return x *% 2 }
    if n == 2 { return x *% 4 }
    if n == 3 { return x *% 8 }
    if n == 4 { return x *% 16 }
    if n == 5 { return x *% 32 }
    if n == 6 { return x *% 64 }
    return x *% 128
}

fn wrappingU16(x: u16, n: usize) -> u16 {
    if n == 0 { return x *% 1 }
    if n == 1 { return x *% 2 }
    if n == 2 { return x *% 4 }
    if n == 3 { return x *% 8 }
    if n == 4 { return x *% 16 }
    if n == 5 { return x *% 32 }
    if n == 6 { return x *% 64 }
    if n == 7 { return x *% 128 }
    if n == 8 { return x *% 256 }
    if n == 9 { return x *% 512 }
    if n == 10 { return x *% 0x400 }
    if n == 11 { return x *% 0x800 }
    if n == 12 { return x *% 0x1000 }
    if n == 13 { return x *% 0x2000 }
    if n == 14 { return x *% 0x4000 }
    return x *% 0x8000
}

fn wrappingU32(x: u32, n: usize) -> u32 {
    if n == 0 { return x *% 1 }
    if n == 1 { return x *% 2 }
    if n == 2 { return x *% 4 }
    if n == 3 { return x *% 8 }
    if n == 4 { return x *% 16 }
