// The checked product of the narrow unsigned types: it traps when it does
// not fit.
fn checkedU8(x: u8, n: usize) -> u8 {
    if n == 0 { return x * 1 }
    if n == 1 { return x * 2 }
    if n == 2 { return x * 4 }
    if n == 3 { return x * 8 }
    if n == 4 { return x * 16 }
    if n == 5 { return x * 32 }
    if n == 6 { return x * 64 }
    return x * 128
}

fn checkedU16(x: u16, n: usize) -> u16 {
    if n == 0 { return x * 1 }
    if n == 1 { return x * 2 }
    if n == 2 { return x * 4 }
    if n == 3 { return x * 8 }
    if n == 4 { return x * 16 }
    if n == 5 { return x * 32 }
    if n == 6 { return x * 64 }
    if n == 7 { return x * 128 }
    if n == 8 { return x * 256 }
    if n == 9 { return x * 512 }
    if n == 10 { return x * 0x400 }
    if n == 11 { return x * 0x800 }
    if n == 12 { return x * 0x1000 }
    if n == 13 { return x * 0x2000 }
    if n == 14 { return x * 0x4000 }
    return x * 0x8000
}

fn checkedU32(x: u32, n: usize) -> u32 {
    if n == 0 { return x * 1 }
    if n == 1 { return x * 2 }
    if n == 2 { return x * 4 }
    if n == 3 { return x * 8 }
    if n == 4 { return x * 16 }
    if n == 5 { return x * 32 }
    if n == 6 { return x * 64 }
    if n == 7 { return x * 128 }
    if n == 8 { return x * 256 }
    if n == 9 { return x * 512 }
    if n == 10 { return x * 0x400 }
    if n == 11 { return x * 0x800 }
    if n == 12 { return x * 0x1000 }
    if n == 13 { return x * 0x2000 }
    if n == 14 { return x * 0x4000 }
    if n == 15 { return x * 0x8000 }
    if n == 16 { return x * 0x10000 }
    if n == 17 { return x * 0x20000 }
    if n == 18 { return x * 0x40000 }
    if n == 19 { return x * 0x80000 }
    if n == 20 { return x * 0x100000 }
    if n == 21 { return x * 0x200000 }
    if n == 22 { return x * 0x400000 }
    if n == 23 { return x * 0x800000 }
    if n == 24 { return x * 0x1000000 }
    if n == 25 { return x * 0x2000000 }
    if n == 26 { return x * 0x4000000 }
    if n == 27 { return x * 0x8000000 }
    if n == 28 { return x * 0x10000000 }
    if n == 29 { return x * 0x20000000 }
    if n == 30 { return x * 0x40000000 }
    return x * 0x80000000
}

// Every factor and operand of a type: the factor written out against the
// factor read at run time.
fn checkU8() -> bool {
    var n: usize = 0
    while n < 8 {
        const f = @intCast(u8, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(u8, edge(e, n, 8))
            if wrappingU8(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkU16() -> bool {
    var n: usize = 0
    while n < 16 {
        const f = @intCast(u16, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(u16, edge(e, n, 16))
            if wrappingU16(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkU32() -> bool {
    var n: usize = 0
    while n < 32 {
        const f = @intCast(u32, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(u32, edge(e, n, 32))
            if wrappingU32(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkU64() -> bool {
    var n: usize = 0
    while n < 64 {
        const f = @intCast(u64, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(u64, edge(e, n, 64))
            if wrappingU64(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkUsize() -> bool {
    var n: usize = 0
    while n < 64 {
        const f = @intCast(usize, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @intCast(usize, edge(e, n, 64))
            if wrappingUsize(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkI8() -> bool {
    var n: usize = 0
    while n < 7 {
        const f = @intCast(i8, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(i8, @intCast(u8, edge(e, n, 8)))
            if wrappingI8(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkI16() -> bool {
    var n: usize = 0
    while n < 15 {
        const f = @intCast(i16, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(i16, @intCast(u16, edge(e, n, 16)))
            if wrappingI16(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkI32() -> bool {
    var n: usize = 0
    while n < 31 {
        const f = @intCast(i32, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(i32, @intCast(u32, edge(e, n, 32)))
            if wrappingI32(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkI64() -> bool {
    var n: usize = 0
    while n < 63 {
        const f = @intCast(i64, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(i64, @intCast(u64, edge(e, n, 64)))
            if wrappingI64(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

fn checkIsize() -> bool {
    var n: usize = 0
    while n < 63 {
        const f = @intCast(isize, power(n))
        var e: usize = 0
        while e < EDGES {
            const x = @bitCast(isize, @intCast(usize, edge(e, n, 64)))
            if wrappingIsize(x, n) != x *% f { return false }
            e += 1
        }
        n += 1
    }
    return true
}

// A checked product that fits (the operand up to the largest that does)
// is the product; the next operand's does not fit and traps: the child
// that makes it is ended by the trap's signal (SIGILL, 128 + 4 as a shell
// reports it), where one that fits exits 0.
fn trapped(status: usize) -> bool { return process.exitStatus(status) == 132 }

fn checkCheckedU8() -> bool {
    var n: usize = 0
    while n < 8 {
        const f = @intCast(u8, power(n))
        const fits = @intCast(u8, edge(4, n, 8))
        if checkedU8(fits, n) != fits * f || checkedU8(fits >> 1, n) != (fits >> 1) * f { return false }
        if checkedU8(1, n) != f || checkedU8(0, n) != 0 { return false }
        if n > 0 {
            const child = process.fork()
            if child == 0 {
                const product = checkedU8(fits + 1, n)
                linux.exitGroup(if product == 0 { 0 } else { 1 })
            }
            var status: usize = 0
            if child < 0 || process.waitProcess(child, &status, 0) != child || !trapped(status) { return false }
        }
        n += 1
    }
    return true
}

fn checkCheckedU16() -> bool {
    var n: usize = 0
    while n < 16 {
        const f = @intCast(u16, power(n))
        const fits = @intCast(u16, edge(4, n, 16))
        if checkedU16(fits, n) != fits * f || checkedU16(fits >> 1, n) != (fits >> 1) * f { return false }
        if checkedU16(1, n) != f || checkedU16(0, n) != 0 { return false }
        if n > 0 {
            const child = process.fork()
            if child == 0 {
                const product = checkedU16(fits + 1, n)
                linux.exitGroup(if product == 0 { 0 } else { 1 })
            }
            var status: usize = 0
            if child < 0 || process.waitProcess(child, &status, 0) != child || !trapped(status) { return false }
        }
        n += 1
    }
    return true
}

fn checkCheckedU32() -> bool {
    var n: usize = 0
    while n < 32 {
        const f = @intCast(u32, power(n))
        const fits = @intCast(u32, edge(4, n, 32))
        if checkedU32(fits, n) != fits * f || checkedU32(fits >> 1, n) != (fits >> 1) * f { return false }
        if checkedU32(1, n) != f || checkedU32(0, n) != 0 { return false }
        if n > 0 {
            const child = process.fork()
            if child == 0 {
                const product = checkedU32(fits + 1, n)
                linux.exitGroup(if product == 0 { 0 } else { 1 })
            }
            var status: usize = 0
            if child < 0 || process.waitProcess(child, &status, 0) != child || !trapped(status) { return false }
        }
        n += 1
    }
    return true
}

// A child that multiplies what fits exits by itself (the trap is not the
// fork's doing).
fn fittingChildExits() -> bool {
    const child = process.fork()
    if child == 0 {
        const product = checkedU32(@intCast(u32, power(28)), 3)
        linux.exitGroup(if product == @intCast(u32, power(31)) { 0 } else { 1 })
    }
    var status: usize = 0
    return child > 0 && process.waitProcess(child, &status, 0) == child && process.succeeded(status)
}

// The forms the multiplications are written in.
const Pair = struct {
    first: u64
    second: u64
}

const Quad = struct {
    a: u64
    b: u64
    c: u64
    d: u64
}

const Triple = struct {
    a: u64
    b: u64
    c: u64
}

const STRIDE: usize = 16

var shorts: [8]u16 = undefined
var words: [8]u32 = undefined
var longs: [8]u64 = undefined
var pairs: [8]Pair = undefined
var quads: [8]Quad = undefined
var triples: [8]Triple = undefined

// A local multiplied where it is kept (a register), on every turn; and
// one multiplied twice a turn, the first product read again.
fn raised(start: usize, turns: usize) -> usize {
    var x = start
    var i: usize = 0
    while i < turns {
        x *= 8
        i += 1
    }
    return x
}

fn raisedTwice(start: usize, turns: usize) -> usize {
    var x = start
    var i: usize = 0
    while i < turns {
        x *= 4
        x = x * 2
        i += 1
    }
    return x
}

fn forms() -> bool {
    const three = @intCast(usize, power(1)) + 1
    // The constant on the left, and a named one.
    if 8 * three != 24 || 1 * three != 3 || three * STRIDE != 48 || STRIDE * three + 1 != 49 { return false }
    if raised(three, 10) != three << 30 || raised(three + 2, 20) != (three + 2) << 60 || raisedTwice(three, 10) != three << 30 { return false }
    var i: usize = 0
    var narrow: u32 = @intCast(u32, three)
    narrow *= 1024
    narrow = narrow *% 0x400000
    if narrow != 0 { return false }
    var signed: i32 = 0 - @intCast(i32, three)
    signed *= 16
    if signed != -48 { return false }
    // Factors beyond a 32-bit immediate: 2^31 to 2^63.
    const wide = @intCast(u64, three)
    if wide * 0x80000000 != wide << 31 || wide * 0x100000000 != wide << 32 || 0x10000000000 * wide != wide << 40 { return false }
    if wide *% 0x8000000000000000 != power(63) || (wide + 1) *% 0x8000000000000000 != 0 { return false }
    const negative: i64 = 0 - @intCast(i64, three)
    if negative * 0x100000000 != -12884901888 || negative * 2 != -6 || 4 * negative != -12 { return false }
    // Elements of 2, 4, 8, 16, 32 and 24 bytes by an index read at run
    // time: written, then read back, and their distances.
    i = 0
    while i < 8 {
        const at = (i + three * 8) % 8
        shorts[at] = @intCast(u16, at * 3 + 1)
        words[at] = @intCast(u32, at * 5 + 2)
        longs[at] = @intCast(u64, at * 7 + 3)
        pairs[at].first = at
        pairs[at].second = at + 100
        quads[at].a = at + 200
        quads[at].d = at + 300
        triples[at].b = at + 400
        triples[at].c = at + 500
        i += 1
    }
    i = 0
    while i < 8 {
        if shorts[i] != @intCast(u16, i * 3 + 1) || words[i] != @intCast(u32, i * 5 + 2) || longs[i] != i * 7 + 3 { return false }
        if pairs[i].first != i || pairs[i].second != i + 100 || quads[i].a != i + 200 || quads[i].d != i + 300 { return false }
        if triples[i].b != i + 400 || triples[i].c != i + 500 { return false }
        i += 1
    }
    const fifth = three + 2
    if @intFromPtr(&pairs[fifth]) - @intFromPtr(&pairs[0]) != 80 || @intFromPtr(&quads[fifth]) - @intFromPtr(&quads[0]) != 160 { return false }
    if @intFromPtr(&triples[fifth]) - @intFromPtr(&triples[0]) != 120 || @intFromPtr(&words[fifth]) - @intFromPtr(&words[0]) != 20 { return false }
    return true
}

pub fn main() -> u8 {
    var n: usize = 0
    while n < 64 {
        powers[n] = one << @intCast(u6, n)
        n += 1
    }

    if !checkU8() { return 1 }
    if !checkU16() { return 2 }
    if !checkU32() { return 3 }
    if !checkU64() { return 4 }
    if !checkUsize() { return 5 }
    if !checkI8() { return 6 }
    if !checkI16() { return 7 }
    if !checkI32() { return 8 }
    if !checkI64() { return 9 }
    if !checkIsize() { return 10 }
    if !checkCheckedU8() { return 11 }
    if !checkCheckedU16() { return 12 }
    if !checkCheckedU32() { return 14 }
    if !fittingChildExits() { return 15 }
    if !forms() { return 16 }
    return 13
}
