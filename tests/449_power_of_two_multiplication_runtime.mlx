// The signed types: a factor up to 2^(bits - 2), the largest power of two
// they hold.
fn wrappingI8(x: i8, n: usize) -> i8 {
    if n == 0 { return x *% 1 }
    if n == 1 { return x *% 2 }
    if n == 2 { return x *% 4 }
    if n == 3 { return x *% 8 }
    if n == 4 { return x *% 16 }
    if n == 5 { return x *% 32 }
    return x *% 64
}

