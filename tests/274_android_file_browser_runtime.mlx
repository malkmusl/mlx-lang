const std = @import("std")
const browser_module = @import("../examples/mlx-files-android/browser.mlx")

const ROOT = "/tmp/mlx-files-android-browser"
const PROJECT_2 = "/tmp/mlx-files-android-browser/Project 2"
const PROJECT_10 = "/tmp/mlx-files-android-browser/Project 10"
const NESTED = "/tmp/mlx-files-android-browser/Project 2/Nested"
const ALPHA = "/tmp/mlx-files-android-browser/alpha.txt"
const BETA = "/tmp/mlx-files-android-browser/Beta.txt"

fn same(first: []const u8, second: []const u8) -> bool {
    var first_length: usize = 0
    for byte in first { first_length += 1 }
    var second_length: usize = 0
    for byte in second { second_length += 1 }
    if first_length != second_length { return false }
    var index: usize = 0
    while index < first_length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn pointer(text: []const u8) -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, text) }
}

fn removeFixture() -> void {
    const alpha_removed = std.fs.delete(pointer(ALPHA))
    const beta_removed = std.fs.delete(pointer(BETA))
    const nested_removed = std.fs.removeDir(pointer(NESTED))
    const project_2_removed = std.fs.removeDir(pointer(PROJECT_2))
    const project_10_removed = std.fs.removeDir(pointer(PROJECT_10))
    const root_removed = std.fs.removeDir(pointer(ROOT))
}

fn makeFile(path: [*]const u8) -> bool {
    const file = std.fs.open(path, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 384)
    if !std.fs.isValid(file) { return false }
    return std.fs.close(file)
}

pub fn main() -> u8 {
    removeFixture()
    if !std.fs.makeDir(pointer(ROOT), 448) { return 1 }
    if !std.fs.makeDir(pointer(PROJECT_10), 448) { return 2 }
    if !std.fs.makeDir(pointer(PROJECT_2), 448) { return 3 }
    if !std.fs.makeDir(pointer(NESTED), 448) { return 4 }
    if !makeFile(pointer(BETA)) || !makeFile(pointer(ALPHA)) { return 5 }

    var browser: browser_module.Browser = undefined
    if !browser_module.init(&browser, pointer(ROOT)) { return 6 }
    if browser.count != 4 || browser.unreadable || browser.truncated { return 7 }
    if !browser_module.entry(&browser, 0).*.directory || !same(browser_module.name(&browser, 0), "Project 2") { return 8 }
    if !browser_module.entry(&browser, 1).*.directory || !same(browser_module.name(&browser, 1), "Project 10") { return 9 }
    if browser_module.entry(&browser, 2).*.directory || !same(browser_module.name(&browser, 2), "alpha.txt") { return 10 }
    if !same(browser_module.name(&browser, 3), "Beta.txt") { return 11 }

    if !browser_module.open(&browser, 0) { return 12 }
    if browser.count != 1 || !same(browser_module.name(&browser, 0), "Nested") { return 14 }
    if !same(browser_module.path(&browser), PROJECT_2) { return 15 }
    if !browser_module.up(&browser) || !same(browser_module.path(&browser), ROOT) || browser.count != 4 { return 16 }
    if browser_module.up(&browser) { return 17 }
    if browser_module.open(&browser, 2) || !same(browser_module.path(&browser), ROOT) { return 18 }

    removeFixture()
    return 13
}
