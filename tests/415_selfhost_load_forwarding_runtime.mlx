// The optimizer makes a load of what the block loaded already (the same
// address, width and signedness, nothing stored or called between) a
// copy of the first load; a store between them keeps the second load.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const lir = @import("../compiler/selfhost/ir/lir.mlx")
const optimize = @import("../compiler/selfhost/ir/optimize.mlx")

fn load(address: usize) -> lir.Inst {
    var inst = lir.initInst(lir.Opcode.load, lir.NONE)
    inst.arg0 = address
    inst.arg1 = lir.NONE
    inst.arg2 = 0
    return inst
}

fn store(address: usize, value: usize) -> lir.Inst {
    var inst = lir.initInst(lir.Opcode.store, lir.NONE)
    inst.arg0 = address
    inst.arg1 = value
    inst.arg2 = lir.NONE
    return inst
}

pub fn main() -> u8 {
    const allocator: page_allocator.Allocator = page_allocator.init()
    var ir = lir.init(allocator)
    var name: [*]const u8 = undefined
    unsafe { name = @ptrCast([*]const u8, "twice") }
    const twice = lir.addSymbol(&ir, name, 5)
    const label = lir.addInst(&ir, lir.labelInst(lir.NONE, twice))
    const pointer = lir.addInst(&ir, lir.initInst(lir.Opcode.param, lir.NONE))
    const first = lir.addInst(&ir, load(pointer))
    const second = lir.addInst(&ir, load(pointer))
    const sum = lir.addInst(&ir, lir.binary(lir.Opcode.add, lir.NONE, first, second))
    const stored = lir.addInst(&ir, store(pointer, sum))
    // After the store the word may differ: loaded again.
    const third = lir.addInst(&ir, load(pointer))
    const returned = lir.addInst(&ir, lir.retInst(lir.NONE, third))

    const result = optimize.run(&ir, allocator)
    if result.loadsForwarded != 1 { return 1 }
    if lir.getInst(&ir, first).opcode != lir.Opcode.load { return 2 }
    if lir.getInst(&ir, second).opcode == lir.Opcode.load { return 3 }
    if lir.getInst(&ir, third).opcode != lir.Opcode.load { return 4 }
    const added = lir.getInst(&ir, sum)
    if added.opcode != lir.Opcode.add || added.arg0 != first || added.arg1 != first { return 5 }
    lir.deinit(&ir)
    return 13
}
