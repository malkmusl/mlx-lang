// std.ui.terminal draws only the cells that changed, without a display: a
// screen is written to, scrolled (lines at the bottom, reverse line feeds,
// a scroll region, lines put in and taken out), cleared, switched to the
// alternate screen, looked back into its history, selected in, given
// another cursor, resized and recoloured at chance, and after each step
// one view updates a canvas that still holds its last frame while another
// draws the same screen whole into a canvas of its own. The two pictures
// are the same pixel for pixel; the cells the update drew are exactly the
// cells whose content, attributes, selection or cursor changed (after the
// move of rows it says it made), with the wide characters' second cells;
// the rectangle it returns is theirs. A line more at the bottom of a full
// screen moves the rows and draws the new line alone; a step that changes
// nothing draws nothing. Dim text is drawn in the mean of its colour and
// its background, on a white background as on any other.
// Exits 13.
const std = @import("std")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const ui_terminal = @import("std.ui.terminal")
const terminal = @import("std.terminal")

const Canvas = canvas_module.Canvas

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var seed: u64 = 1442695040888963407 // (per run)

fn chance() -> u64 {
    seed = seed ^ (seed << 13)
    seed = seed ^ (seed >> 7)
    seed = seed ^ (seed << 17)
    return seed
}

fn below(limit: usize) -> usize { return @intCast(usize, chance() % @intCast(u64, limit)) }

const MAX_COLUMNS: usize = 44
const MAX_ROWS: usize = 18
const CELLS: usize = MAX_COLUMNS * MAX_ROWS
const PADDING: i32 = 5

// A cell's marks as the test works them out (the view's are its own).
const SELECTED: u8 = 1
const COVERED: u8 = 2
const CURSOR: u8 = 4
const UNKNOWN: u8 = 128

// What the test takes each cell to show: before the step and after it.
var before: [CELLS]terminal.Cell = undefined // (per run)
var after: [CELLS]terminal.Cell = undefined // (per run)
var trace: [CELLS]u8 = undefined // (per run)
var wanted: [CELLS]u8 = undefined // (per run)

fn cellAt(cells: *[CELLS]terminal.Cell, row: usize, column: usize) -> *terminal.Cell {
    return &cells.*[row * MAX_COLUMNS + column]
}

fn sameCell(a: *const terminal.Cell, b: *const terminal.Cell) -> bool {
    return a.*.codepoint == b.*.codepoint && a.*.foreground == b.*.foreground && a.*.background == b.*.background && a.*.flags == b.*.flags && a.*.width == b.*.width && a.*.reserved == b.*.reserved
}

// The test's state of one step.
const Step = struct {
    area: ui.Rect
    rows: usize
    columns: usize
    foreground: u32
    background: u32
    selection: u32
    reverse: bool
    cursorColor: u32
    cursorStyle: u8
    focused: bool
}

// How many cells of `size` pixels fit `room` pixels, `count` at most.
fn fit(count: usize, room: i32, size: i32) -> usize {
    if room <= 0 || size <= 0 { return 0 }
    const cells = @intCast(usize, room / size)
    return if cells < count { cells } else { count }
}

fn stepOf(view: *ui_terminal.View, area: ui.Rect, step: *Step) -> void {
    const screen = view.*.screen
    step.*.area = ui.rect(area.x, area.y, area.width, area.height)
    step.*.rows = fit(screen.*.rows, area.y + area.height - (area.y + view.*.padding), view.*.cellHeight)
    step.*.columns = fit(screen.*.columns, area.x + area.width - (area.x + view.*.padding), view.*.cellWidth)
    step.*.foreground = view.*.foreground
    step.*.background = view.*.background
    step.*.selection = view.*.selectionColor
    step.*.reverse = screen.*.reverseVideo
    step.*.cursorColor = view.*.cursorColor
    step.*.cursorStyle = screen.*.cursorStyle
    step.*.focused = view.*.focused
}

fn sameSetting(a: *const Step, b: *const Step) -> bool {
    return a.*.area.x == b.*.area.x && a.*.area.y == b.*.area.y && a.*.area.width == b.*.area.width && a.*.area.height == b.*.area.height && a.*.rows == b.*.rows && a.*.columns == b.*.columns && a.*.foreground == b.*.foreground && a.*.background == b.*.background && a.*.selection == b.*.selection && a.*.reverse == b.*.reverse
}

// What every cell is to show now, into `after`: the screen's cell with the
// marks the test works out for it.
fn look(view: *ui_terminal.View, step: *const Step) -> void {
    const screen = view.*.screen
    var range: ui_terminal.Range = undefined
    const selected = ui_terminal.selectionRange(view, &range)
    const first_line = ui_terminal.topLine(screen)
    var row: usize = 0
    while row < step.*.rows {
        var covered = false
        var column: usize = 0
        while column < step.*.columns {
            const cell = cellAt(&after, row, column)
            const live = terminal.visibleCell(screen, row, column)
            cell.*.codepoint = live.*.codepoint
            cell.*.foreground = live.*.foreground
            cell.*.background = live.*.background
            cell.*.flags = live.*.flags
            cell.*.width = live.*.width
            var marks: u8 = 0
            if selected && ui_terminal.inRange(&range, first_line + row, column) { marks |= SELECTED }
            if covered {
                marks |= COVERED
                covered = false
            } else if live.*.width == 2 {
                covered = true
            }
            cell.*.reserved = marks
            column += 1
        }
        row += 1
    }
    if terminal.cursorShown(screen) && screen.*.cursorRow < step.*.rows && screen.*.cursorColumn < step.*.columns {
        cellAt(&after, screen.*.cursorRow, screen.*.cursorColumn).*.reserved |= CURSOR
        if terminal.visibleCell(screen, screen.*.cursorRow, screen.*.cursorColumn).*.width == 2 && screen.*.cursorColumn + 1 < step.*.columns {
            cellAt(&after, screen.*.cursorRow, screen.*.cursorColumn + 1).*.reserved |= CURSOR
        }
    }
}

// The cells an update is to draw, into `wanted`: all of them when `whole`;
// else the units (a cell, or a wide character with the cell it takes) of
// which a cell is not what the picture showed there after the rows moved
// by `moved` (positive: up; a row nothing moved onto shows what it did).
fn expect(step: *const Step, whole: bool, moved: isize) -> void {
    var index: usize = 0
    while index < CELLS {
        wanted[index] = 0
        index += 1
    }
    var row: usize = 0
    while row < step.*.rows {
        var from = row
        const source = @intCast(isize, row) + moved
        if source >= 0 && source < @intCast(isize, step.*.rows) { from = @intCast(usize, source) }
        var column: usize = 0
        while column < step.*.columns {
            const cells: usize = if cellAt(&after, row, column).*.width == 2 && column + 1 < step.*.columns { 2 } else { 1 }
            var differs = whole
            var k: usize = 0
            while k < cells {
                if !sameCell(cellAt(&after, row, column + k), cellAt(&before, from, column + k)) { differs = true }
                k += 1
            }
            if differs {
                k = 0
                while k < cells {
                    wanted[row * MAX_COLUMNS + column + k] = 1
                    k += 1
                }
            }
            column += cells
        }
        row += 1
    }
}

// ---------------------------------------------------------------------------
// What happens to the screen

fn feed(screen: *terminal.Screen, text: []const u8) -> void { terminal.feed(screen, text) }

fn feedNumber(screen: *terminal.Screen, value: usize) -> void {
    var digits: [8]u8 = undefined
    var at: usize = 8
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    feed(screen, digits[at..8])
}

// ESC [ `a` ; `b` `final` (b 0: left out).
fn csi(screen: *terminal.Screen, a: usize, b: usize, final: []const u8) -> void {
    feed(screen, "\x1b[")
    feedNumber(screen, a)
    if b != 0 {
        feed(screen, ";")
        feedNumber(screen, b)
    }
    feed(screen, final)
}

fn words(screen: *terminal.Screen) -> void {
    const letters = "abcdefghij klmnop qrstuvwxyz ABCDEFG{}[]|_^~#@$ 0123456789"
    var text: [48]u8 = undefined
    const length = 1 + below(40)
    var index: usize = 0
    while index < length {
        text[index] = letters[below(letters.length)]
        index += 1
    }
    const bytes: [*]const u8 = &text
    feed(screen, bytes[0..length])
}

fn attribute(screen: *terminal.Screen) -> void {
    const pick = below(12)
    if pick == 0 { feed(screen, "\x1b[0m") }
    if pick == 1 { csi(screen, 31 + below(6), 0, "m") }
    if pick == 2 { csi(screen, 41 + below(6), 0, "m") }
    if pick == 3 { feed(screen, "\x1b[7m") }
    if pick == 4 { feed(screen, "\x1b[4m") }
    if pick == 5 { feed(screen, "\x1b[9m") }
    if pick == 6 { feed(screen, "\x1b[2m") }
    if pick == 7 { feed(screen, "\x1b[1m") }
    if pick == 8 { feed(screen, "\x1b[8m") }
    if pick >= 9 { feed(screen, "\x1b[0m") }
}

// One thing at chance; true when it leaves the views' sizes to be taken
// again (the screen was resized).
fn happen(screen: *terminal.Screen, one: *ui_terminal.View, other: *ui_terminal.View) -> bool {
    const pick = below(100)
    if pick < 22 {
        words(screen)
    } else if pick < 30 {
        attribute(screen)
        words(screen)
    } else if pick < 42 {
        // Lines at the bottom: the text scrolls.
        var lines = 1 + below(4)
        while lines > 0 {
            words(screen)
            feed(screen, "\r\n")
            lines -= 1
        }
    } else if pick < 46 {
        // A wide character or two, and letters with marks.
        feed(screen, "\xe6\xbc\xa2\xe5\xad\x97 \xc3\x84\xc3\xa9\xe2\x82\xac")
    } else if pick < 52 {
        csi(screen, 1 + below(screen.*.rows), 1 + below(screen.*.columns), "H")
    } else if pick < 55 {
        feed(screen, if below(2) == 0 { "\x1b[2J" } else { "\x1b[K" })
    } else if pick < 58 {
        feed(screen, "\x1bM")
    } else if pick < 61 {
        csi(screen, 1 + below(3), 0, if below(2) == 0 { "L" } else { "M" })
    } else if pick < 64 {
        csi(screen, 1 + below(3), 0, if below(2) == 0 { "S" } else { "T" })
    } else if pick < 66 {
        // A scroll region (or all of the screen again), the cursor in it.
        if below(2) == 0 { csi(screen, 2, screen.*.rows - 1, "r") } else { feed(screen, "\x1b[r") }
    } else if pick < 69 {
        csi(screen, 1 + below(3), 0, if below(2) == 0 { "P" } else { "@" })
    } else if pick < 72 {
        feed(screen, if below(2) == 0 { "\x1b[?25l" } else { "\x1b[?25h" })
    } else if pick < 74 {
        csi(screen, below(7), 0, " q")
    } else if pick < 76 {
        feed(screen, if below(2) == 0 { "\x1b[?5h" } else { "\x1b[?5l" })
    } else if pick < 78 {
        feed(screen, if screen.*.onAlternate { "\x1b[?1049l" } else { "\x1b[?1049h" })
    } else if pick < 83 {
        // A look back into the history, or forward again.
        terminal.scrollView(screen, @intCast(isize, below(7)) - 3)
    } else if pick < 88 {
        // A selection (the same in both views), or none.
        const on = below(3) != 0
        const lines = ui_terminal.lineCount(screen)
        const top = ui_terminal.topLine(screen)
        one.*.hasSelection = on
        one.*.selectionUnit = @intCast(u8, 1 + below(3))
        one.*.anchorLine = top + below(screen.*.rows)
        one.*.anchorColumn = below(screen.*.columns + 1)
        one.*.endLine = top + below(screen.*.rows)
        one.*.endColumn = below(screen.*.columns + 1)
        if one.*.anchorLine >= lines { one.*.anchorLine = lines - 1 }
        if one.*.endLine >= lines { one.*.endLine = lines - 1 }
        other.*.hasSelection = one.*.hasSelection
        other.*.selectionUnit = one.*.selectionUnit
        other.*.anchorLine = one.*.anchorLine
        other.*.anchorColumn = one.*.anchorColumn
        other.*.endLine = one.*.endLine
        other.*.endColumn = one.*.endColumn
    } else if pick < 91 {
        one.*.focused = !one.*.focused
        other.*.focused = one.*.focused
    } else if pick < 92 {
        // The desktop's light or dark look; or one colour alone.
        const which = below(3)
        if which == 0 {
            const lightness = @intCast(i32, below(3)) * 512
            ui_terminal.setLightness(one, lightness)
            ui_terminal.setLightness(other, lightness)
        } else if which == 1 {
            one.*.background = 4278190080 | @intCast(u32, below(4)) * 1052688
            other.*.background = one.*.background
        } else {
            one.*.selectionColor = 4278190080 | @intCast(u32, 1 + below(4)) * 4210752
            other.*.selectionColor = one.*.selectionColor
        }
    } else if pick < 94 {
        // A wide character whose first half is then erased (or its second):
        // the other half is left with nothing of its own to show.
        feed(screen, "\xe6\xbc\xa2")
        feed(screen, if below(2) == 0 { "\x1b[2D\x1b[X" } else { "\x1b[D\x1b[X" })
    } else if pick < 97 {
        // Another size: no selection survives it (as the terminal has it).
        one.*.hasSelection = false
        other.*.hasSelection = false
        _ = terminal.resize(screen, 4 + below(MAX_COLUMNS - 3), 2 + below(MAX_ROWS - 1))
        return true
    }
    // (Else nothing happens: a frame asked for with nothing changed.)
    return false
}

// ---------------------------------------------------------------------------

fn scribble(canvas: *Canvas, area: ui.Rect) -> void {
    var row = area.y
    while row < area.y + area.height {
        var column = area.x
        while column < area.x + area.width {
            canvas.*.pixels[@intCast(usize, row) * canvas.*.stride + @intCast(usize, column)] = @intCast(u32, chance() >> 32)
            column += 1
        }
        row += 1
    }
}

fn samePixels(one: *const Canvas, other: *const Canvas) -> bool {
    var index: usize = 0
    while index < one.*.stride * one.*.height {
        if one.*.pixels[index] != other.*.pixels[index] { return false }
        index += 1
    }
    return true
}

fn makeCanvas(canvas: *Canvas, width: usize, height: usize, allocator: std.allocator.Allocator) -> bool {
    const memory = allocator.alloc(width * height * 4, 16)
    if memory == null { return false }
    unsafe { canvas.*.pixels = @ptrCast([*]u32, memory.?) }
    canvas.*.width = width
    canvas.*.height = height
    canvas.*.stride = width
    canvas.*.swapRedBlue = false
    canvas.*.device = 0
    canvas.*.opacity = 255
    var index: usize = 0
    while index < width * height {
        canvas.*.pixels[index] = 4278190335
        index += 1
    }
    return true
}

pub fn main() -> u8 {
    const allocator = std.heap.allocator()
    var screen: terminal.Screen = undefined
    if !terminal.init(&screen, allocator, 30, 10, 60) { return 1 }
    // (Without a font the cells are still there: their backgrounds, the
    // cursor, the lines under and through them.)
    var mono: text_module.Text = undefined
    if !text_module.loadMonoText(&mono, 13, allocator) { say("(no monospaced font found: the cells are compared without characters)\n") }
    var kept_view: ui_terminal.View = undefined
    var whole_view: ui_terminal.View = undefined
    ui_terminal.init(&kept_view, &screen, &mono, 13, PADDING)
    ui_terminal.init(&whole_view, &screen, &mono, 13, PADDING)
    kept_view.trace = @intFromPtr(&trace)
    const canvas_width = @intCast(usize, ui_terminal.pixelWidth(&kept_view, MAX_COLUMNS))
    const canvas_height = @intCast(usize, ui_terminal.pixelHeight(&kept_view, MAX_ROWS))
    var kept_canvas: Canvas = undefined
    var whole_canvas: Canvas = undefined
    if !makeCanvas(&kept_canvas, canvas_width, canvas_height, allocator) || !makeCanvas(&whole_canvas, canvas_width, canvas_height, allocator) { return 1 }

    var was: Step = undefined
    var now: Step = undefined
    var first = true
    var partial_steps: usize = 0
    var moved_steps: usize = 0
    var still_steps: usize = 0
    var round: usize = 0
    while round < 4000 {
        // A step: one thing or a few, then a frame.
        var things = 1 + below(3)
        while things > 0 {
            _ = happen(&screen, &kept_view, &whole_view)
            things -= 1
        }
        // The area: the cells' own; now and then cut a little short, so
        // that a row and a column do not fit.
        var area = ui.rect(0, 0, ui_terminal.pixelWidth(&kept_view, screen.columns), ui_terminal.pixelHeight(&kept_view, screen.rows))
        if round % 97 > 90 {
            area.width -= 7
            area.height -= 9
        }
        // Mostly the canvas still holds the last frame; now and then it
        // does not (a new buffer: whatever is in it).
        const kept = below(14) != 0
        stepOf(&kept_view, area, &now)
        const whole = first || !kept || !sameSetting(&was, &now)
        if !kept {
            scribble(&kept_canvas, area)
            scribble(&whole_canvas, area)
        }
        var index: usize = 0
        while index < CELLS {
            trace[index] = 0
            index += 1
        }
        const changed = ui_terminal.update(&kept_view, &kept_canvas, area, kept)
        ui_terminal.draw(&whole_view, &whole_canvas, area)
        if !samePixels(&kept_canvas, &whole_canvas) {
            say("FAIL the picture of the cells that changed is not the picture drawn whole\n")
            return 2
        }
        look(&kept_view, &now)
        // The cursor drawn another way: its cells are not what they were.
        if !first && (was.cursorColor != now.cursorColor || was.cursorStyle != now.cursorStyle || was.focused != now.focused) {
            index = 0
            while index < CELLS {
                if before[index].reserved & CURSOR != 0 { before[index].reserved |= UNKNOWN }
                index += 1
            }
        }
        if whole && kept_view.movedRows != 0 {
            say("FAIL a picture drawn whole says it moved rows\n")
            return 3
        }
        expect(&now, whole, kept_view.movedRows)
        var drawn: usize = 0
        var left: i32 = 1000000
        var top: i32 = 1000000
        var right: i32 = 0
        var bottom: i32 = 0
        // (The view's record has the screen's columns to a row.)
        index = 0
        while index < screen.rows * screen.columns {
            const row = index / screen.columns
            const column = index % screen.columns
            if trace[index] != wanted[row * MAX_COLUMNS + column] {
                say(if trace[index] != 0 { "FAIL a cell was drawn that had not changed\n" } else { "FAIL a cell that changed was not drawn\n" })
                return 4
            }
            if trace[index] != 0 {
                drawn += 1
                const x = PADDING + @intCast(i32, column) * kept_view.cellWidth
                const y = PADDING + @intCast(i32, row) * kept_view.cellHeight
                if x < left { left = x }
                if y < top { top = y }
                if x + kept_view.cellWidth > right { right = x + kept_view.cellWidth }
                if y + kept_view.cellHeight > bottom { bottom = y + kept_view.cellHeight }
            }
            index += 1
        }
        if drawn != kept_view.drawnCells {
            say("FAIL the view's count of the cells it drew is not theirs\n")
            return 5
        }
        // The rectangle: the area for a whole picture; the cells drawn
        // for a part (all the cells when rows moved); none for none.
        if whole {
            if changed.x != area.x || changed.y != area.y || changed.width != area.width || changed.height != area.height { return 6 }
        } else if kept_view.movedRows != 0 {
            if changed.x != PADDING || changed.y != PADDING || changed.width != @intCast(i32, now.columns) * kept_view.cellWidth || changed.height != @intCast(i32, now.rows) * kept_view.cellHeight { return 7 }
            moved_steps += 1
        } else if drawn == 0 {
            if changed.width != 0 || changed.height != 0 { return 8 }
            still_steps += 1
        } else {
            if changed.x != left || changed.y != top || changed.width != right - left || changed.height != bottom - top {
                say("FAIL the rectangle an update returns is not that of the cells it drew\n")
                return 9
            }
            partial_steps += 1
        }
        // What the picture shows now.
        index = 0
        while index < CELLS {
            before[index] = after[index]
            index += 1
        }
        was = now
        first = false
        round += 1
    }
    // The steps were of every kind (else the comparison said little).
    if partial_steps < 500 || moved_steps < 100 || still_steps < 20 {
        say("FAIL too few steps drew a part, moved rows or changed nothing\n")
        return 10
    }

    // A line more at the bottom of a full screen: the rows move up by one
    // and the new line alone is drawn.
    _ = terminal.resize(&screen, 40, 12)
    feed(&screen, "\x1b[?1049l\x1b[?5l\x1b[r\x1b[0m\x1b[?25h\x1b[2J\x1b[H")
    kept_view.hasSelection = false
    var line: usize = 0
    while line < 30 {
        feed(&screen, "line ")
        feedNumber(&screen, line * 7919)
        feed(&screen, " of the text\r\n")
        line += 1
    }
    const full = ui.rect(0, 0, ui_terminal.pixelWidth(&kept_view, 40), ui_terminal.pixelHeight(&kept_view, 12))
    _ = ui_terminal.update(&kept_view, &kept_canvas, full, false)
    feed(&screen, "one more line\r\n")
    _ = ui_terminal.update(&kept_view, &kept_canvas, full, true)
    if kept_view.movedRows != 1 || kept_view.drawnCells == 0 || kept_view.drawnCells > 40 {
        say("FAIL a line more at the bottom did not move the rows up by one and draw that line alone\n")
        return 11
    }
    // Three lines at once: moved by three.
    feed(&screen, "a\r\nb\r\nc\r\n")
    _ = ui_terminal.update(&kept_view, &kept_canvas, full, true)
    if kept_view.movedRows != 3 || kept_view.drawnCells > 120 { return 12 }
    // A look back by two lines: the rows move down.
    terminal.scrollView(&screen, 2)
    _ = ui_terminal.update(&kept_view, &kept_canvas, full, true)
    if kept_view.movedRows != -2 { return 14 }
    ui_terminal.draw(&whole_view, &whole_canvas, full)
    if !samePixels(&kept_canvas, &whole_canvas) { return 15 }
    // One character typed: its cell and the cursor's.
    terminal.resetView(&screen)
    _ = ui_terminal.update(&kept_view, &kept_canvas, full, true)
    feed(&screen, "x")
    const typed = ui_terminal.update(&kept_view, &kept_canvas, full, true)
    if kept_view.drawnCells != 2 || kept_view.movedRows != 0 || typed.width != 2 * kept_view.cellWidth || typed.height != kept_view.cellHeight {
        say("FAIL a character typed did not draw its cell and the cursor's alone\n")
        return 16
    }
    // Nothing since: nothing drawn.
    const none = ui_terminal.update(&kept_view, &kept_canvas, full, true)
    if kept_view.drawnCells != 0 || none.width != 0 || none.height != 0 { return 17 }
    // Dim text (SGR 2) is the mean of its colour and its background, on
    // any background: a full block, dim, in the view's own colours and in
    // black on white (where the sum once ran over and ended the program),
    // its middle pixel read back. (A font without the block leaves the
    // background there: nothing to read.)
    kept_view.foreground = 4293322470
    kept_view.background = 4280032284
    feed(&screen, "\x1b[0m\x1b[2J\x1b[H\x1b[2m\xe2\x96\x88\x1b[0m\r\n\x1b[48;2;255;255;255m\x1b[38;2;0;0;0m\x1b[2m\xe2\x96\x88\x1b[0m")
    _ = ui_terminal.update(&kept_view, &kept_canvas, full, true)
    const middle = @intCast(usize, PADDING + kept_view.cellWidth / 2)
    const own = kept_canvas.pixels[@intCast(usize, PADDING + kept_view.cellHeight / 2) * kept_canvas.stride + middle]
    const on_white = kept_canvas.pixels[@intCast(usize, PADDING + kept_view.cellHeight + kept_view.cellHeight / 2) * kept_canvas.stride + middle]
    if (own != 4280032284 && own != 4286677377) || (on_white != 4294967295 && on_white != 4286545791) {
        say("FAIL dim text is not drawn in the mean of its colour and its background\n")
        return 18
    }
    return 13
}
