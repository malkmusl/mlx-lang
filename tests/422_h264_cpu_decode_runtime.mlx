// std.h264.decode: WebKit's test.mp4 (projects/webkit/upstream/Tools/
// TestWebKitAPI/Resources, 320x240 Main profile, CAVLC, B frames, 182
// access units) read through std.mp4, kept in order by std.h264 and
// decoded on the CPU: every picture decodes, comes out in presentation
// order, and the output's planes (Y, Cb, Cr of each picture in turn)
// have the CRC-32 of the reference decoding (a decoder that conforms
// gives these samples bit for bit). The first picture, the second, the
// 91st and the last are checked on their own too. Then again on a Pool
// of four threads (pictures decoded at once, held until decoded): the
// same output.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const std = @import("std")
const mp4 = @import("std.mp4")
const h264 = @import("std.h264")
const decode = @import("std.h264.decode")
const crc = @import("std.crc")
const fs = @import("../std/bootstrap/fs.mlx")

const WIDTH: usize = 320
const HEIGHT: usize = 240

// The CRC-32 of the reference decoding's planes: all 182 pictures, and
// pictures 0, 1, 90 and 181 alone.
const ALL: u32 = 0xa5b78f29
var PICTURE_CRCS = [4]u32{ 0x13457042, 0x13457042, 0xb47cc1b8, 0x5a6c2851 }
var PICTURE_INDICES = [4]usize{ 0, 1, 90, 181 }

var total: u32 = 0
var outputs: usize = 0
var failed: u8 = 0

fn output(planes: decode.Planes) -> void {
    if planes.width != 320 || planes.height != 240 {
        if failed == 0 { failed = 30 }
        return
    }
    const lumaBytes = WIDTH * HEIGHT
    const chromaBytes = lumaBytes / 4
    var own = crc.crc32(0, planes.y, lumaBytes)
    own = crc.crc32(own, planes.cb, chromaBytes)
    own = crc.crc32(own, planes.cr, chromaBytes)
    total = crc.crc32(total, planes.y, lumaBytes)
    total = crc.crc32(total, planes.cb, chromaBytes)
    total = crc.crc32(total, planes.cr, chromaBytes)
    var k: usize = 0
    while k < 4 {
        if PICTURE_INDICES[k] == outputs && PICTURE_CRCS[k] != own && failed == 0 { failed = @intCast(u8, 31 + k) }
        k += 1
    }
    outputs += 1
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const decoder = h264.create(allocator)
    if decoder == null { return 1 }
    const h = decoder.?
    const made = decode.create(allocator)
    if made == null { return 2 }
    const cpu = made.?

    const loaded = fs.readFileAlloc("projects/webkit/upstream/Tools/TestWebKitAPI/Resources/test.mp4\x00".pointer, allocator)
    if loaded == null { return 3 }
    const contents = loaded.?
    const data: [*]const u8 = unsafe { @ptrCast([*]const u8, contents.items) }
    var movie: mp4.Movie = undefined
    mp4.init(&movie, allocator)
    var samples: mp4.Samples = undefined
    mp4.initSamples(&samples, allocator)
    var used: usize = 0
    if mp4.parse(&movie, data, contents.length, &samples, &used) != mp4.Status.ok { return 4 }
    const index = mp4.trackOfKind(&movie, mp4.KIND_VIDEO)
    if index >= mp4.MAX_TRACKS { return 5 }
    const track = mp4.track(&movie, index)
    var set: []const u8 = undefined
    var sets: usize = 0
    while mp4.parameterSet(track, sets, &set) {
        if h264.parameterSet(h, &set[0], set.length) != h264.Status.ok { return 6 }
        sets += 1
    }

    var pictures: usize = 0
    var slot: usize = 0
    var poc: i32 = 0
    var sample: mp4.Sample = undefined
    while mp4.nextSample(&movie, index, &sample) {
        if h264.accessUnit(h, &data[sample.offset], sample.size, 4) != h264.Status.ok { return 7 }
        if decode.decodePicture(cpu, h, &data[sample.offset]) != h264.Status.ok { return 8 }
        pictures += 1
        h264.finishPicture(h)
        while h264.nextOutput(h, &slot, &poc) { output(decode.planes(cpu, slot)) }
    }
    h264.flush(h)
    while h264.nextOutput(h, &slot, &poc) { output(decode.planes(cpu, slot)) }
    if failed != 0 { return failed }
    if pictures != 182 || outputs != 182 { return 9 }
    if total != ALL { return 10 }

    // On threads.
    const second = h264.create(allocator)
    const made2 = decode.createPool(allocator, 4)
    if second == null || made2 == null { return 40 }
    const h2 = second.?
    const pool = made2.?
    sets = 0
    while mp4.parameterSet(track, sets, &set) {
        if h264.parameterSet(h2, &set[0], set.length) != h264.Status.ok { return 41 }
        sets += 1
    }
    mp4.seek(&movie, index, 0)
    total = 0
    outputs = 0
    pictures = 0
    while mp4.nextSample(&movie, index, &sample) {
        if h264.accessUnit(h2, &data[sample.offset], sample.size, 4) != h264.Status.ok { return 42 }
        if decode.submit(pool, h2, &data[sample.offset]) != h264.Status.ok { return 43 }
        pictures += 1
        h264.finishPicture(h2)
        while decode.nextReady(pool, h2, &slot, &poc) { output(decode.poolPlanes(pool, slot)) }
    }
    h264.flush(h2)
    while decode.nextReady(pool, h2, &slot, &poc) { output(decode.poolPlanes(pool, slot)) }
    if failed != 0 { return failed }
    if pictures != 182 || outputs != 182 { return 44 }
    if total != ALL { return 45 }
    decode.destroyPool(pool)
    h264.destroy(h2)
    fs.ArrayList.deinit(contents)
    mp4.deinitSamples(&samples)
    mp4.deinit(&movie)
    decode.destroy(cpu)
    h264.destroy(h)
    return 13
}
