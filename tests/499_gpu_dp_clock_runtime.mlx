// The display clock raised for a DisplayPort plan (projects/brix/kernel/
// gpu_mode.mlx's linkPlan, "The display clock" under ON DISPLAYPORT in its
// head; carried out by gpu_set.mlx) on the host, against a card that is a
// table and a monitor behind its AUX channel that is one too
// (tests/support/dp_monitor.mlx over tmds_card.mlx), whose display
// clock's table does what the user's ROM's does on the host (both
// interpreters alike): the fastest clock at or below the one it is told;
// told the DisplayPort reference clock, that clock at 600 MHz (its
// divider 0x18) and every DTO's modulo 600000000.
//
// The machine is 480's (controller 0, front end 2 on back end 1, a
// DisplayPort connector on hot plug line 2 with AUX channel 1) with the
// user's card's figures: a display clock of 118032 kHz (3600 MHz over
// 30.5, divider number 0x5D), the reference clock at 600 MHz, every DTO's
// modulo 600000000, the ROM's own figure 626100 kHz; and the user's
// monitor: 3840x1080 at 270270 kHz (4040 by 1115).
//
// What is held:
// - 3840x1080 on a link that is too slow: the clock raised to 326350 kHz
//   by two table runs right after the scratch words, what the DTO divides
//   looked at, then everything as the same plan on a card whose clock is
//   enough, event for event and step for step; the way back's last part;
//   the log;
// - smaller modes: 1920x1080 (148.5 MHz: raised to 179313 kHz) likewise;
//   1280x720 (74.25 MHz, on the firmware's link, which has room: kept)
//   with nothing raised, the plan of a card whose clock is enough;
// - a link that has room: trained anyway, at the rate and lanes it has,
//   when the clock has to be raised;
// - another controller: its own DTO's modulo looked at; the display
//   clock's table not in the ROM or of another revision, the clock above
//   the ROM's own figure and at it;
// - the look after the clock's runs failing (the DTO's modulo, the
//   reference clock's divider): nothing of the output touched, the
//   registers and the clock back, event for event; a firmware whose
//   reference clock the table moves for good: the way back says it is not
//   known to be back;
// - a failure after the output was touched: the whole way back, the
//   clock's two runs last, the display clock's divider as the firmware
//   had it (the clock told 10 kHz above what it reads);
// - a ROM whose run for the reference clock writes nothing: no failure,
//   there or back; a modulo other than 600000000 looked for as it is
//   read; a link whose room is the new rows' clock exactly (it has room);
//   the clock said as not raised where the plan is refused;
// - a TMDS plan at the user's figures as before (no look at the DTO, its
//   way back told the clock as before). Tests 474 and 475's verbose step
//   lists are line for line what they were before this change.
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const blocks = @import("../projects/brix/kernel/gpu_blocks.mlx")
const dplink = @import("../projects/brix/kernel/gpu_link.mlx")
const aux = @import("../projects/brix/kernel/gpu_aux.mlx")
const rom = @import("./support/atom_rom.mlx")
const card = @import("./support/tmds_card.mlx")
const sink = @import("./support/dp_monitor.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn logWrite(text: []const u8) -> void {
    card.logWrite(text)
    if show { say(text) }
}

// The display clock's word of the user's card: the reference clock's
// divider 0x18 (600 MHz), the display clock's 0x5D (118032 kHz); and one
// whose display clock (0x18: 600 MHz) is enough for every mode here.
const USERS: usize = 0x1800005D
const ENOUGH: usize = 0x18000018
// The ROM's own figure for the display clock on the user's card.
const FIGURE: usize = 626100

// The ROM and what is read of it.
var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined

var readout: scanout.Readout = undefined
var plan: mode.Plan = undefined
var result: set.Result = undefined
var memory: scanout.Memory = undefined
var heard: dplink.Heard = undefined
var outCard: scanout.Card = undefined
var port: aux.Port = undefined
var channel: aux.Channel = undefined

// The registers as they were before a change.
var before: [card.ROOM]usize = undefined
var beforeMarks: [24]usize = undefined

fn remember() -> void {
    var k: usize = 0
    while k < card.ROOM {
        before[k] = card.registers[k]
        k += 1
    }
    k = 0
    while k < 24 {
        beforeMarks[k] = card.marks[k]
        k += 1
    }
}

// Whether every register of the display holds what it held (as 480 has
// it: not the tables' mail, the card's own answers, the AUX channel's own
// words).
fn asBefore() -> bool {
    var k: usize = 0
    while k < card.ROOM {
        var answers: usize = 0
        if k >= 0x321 && k < 0x327 { answers = 0x10 }
        if k == 0x1A11 || k == 0x1C11 || k == 0x1E11 { answers = 0x4 }
        const mail = k >= card.MAIL && k <= card.ANSWER
        const channels = (k >= 0x5C00 && k < 0x5CA8) || k == 0x483B || k == 0x483C
        if (card.registers[k] ^ before[k]) & ~answers != 0 && !mail && !channels {
            if show {
                const out = scanout.Card.{ .read = sink.read, .now = card.now, .write = say }
                say("differs: ")
                out.hexDigits(k, 4)
                say(" ")
                out.hexDigits(card.registers[k], 8)
                say(" was ")
                out.hexDigits(before[k], 8)
                say("\n")
            }
            return false
        }
        k += 1
    }
    k = 0
    while k < 24 {
        if card.marks[k] != beforeMarks[k] { return false }
        k += 1
    }
    return true
}

// The monitor holds the link `code` on `lanes` lanes, every lane locked,
// awake, no pattern; and the transmitter is on for it.
fn monitorHolds(code: usize, lanes: usize) -> bool {
    var k: usize = 0
    while k < lanes {
        if !sink.clockOf[k] || !sink.lockOf[k] { return false }
        k += 1
    }
    return @intCast(usize, sink.dpcd[0x100]) == code && @intCast(usize, sink.dpcd[0x101]) == (lanes | 0x80) && @intCast(usize, sink.dpcd[0x600]) == 1 && @intCast(usize, sink.dpcd[0x102]) == 0 && sink.txOn && sink.txCode == code && sink.txLanes == lanes
}

// A monitor whose own timing is `t`.
fn monitorOf(t: edid.Timing) -> edid.Monitor {
    return edid.Monitor.{ .state = edid.State.found, .width = t.width, .height = t.height, .timing = t, .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.none }
}

// The user's monitor's own timing as the machine's log gives it:
// 3840x1080 at 270270 kHz, h 3840 4040 (front 48 sync 32 +), v 1080 1115
// (front 3 sync 5 -).
fn users() -> edid.Monitor {
    return monitorOf(edid.Timing.{ .clock = 270270, .width = 3840, .hTotal = 4040, .hFront = 48, .hSync = 32, .hPositive = true, .height = 1080, .vTotal = 1115, .vFront = 3, .vSync = 5, .vPositive = false, .interlaced = false, .stereo = false })
}

// Smaller modes (CTA-861's 1080p and 720p at 60 Hz).
fn full() -> edid.Monitor {
    return monitorOf(edid.Timing.{ .clock = 148500, .width = 1920, .hTotal = 2200, .hFront = 88, .hSync = 44, .hPositive = true, .height = 1080, .vTotal = 1125, .vFront = 4, .vSync = 5, .vPositive = true, .interlaced = false, .stereo = false })
}

fn narrow() -> edid.Monitor {
    return monitorOf(edid.Timing.{ .clock = 74250, .width = 1280, .hTotal = 1650, .hFront = 110, .hSync = 40, .hPositive = true, .height = 720, .vTotal = 750, .vFront = 5, .vSync = 5, .vPositive = true, .interlaced = false, .stereo = false })
}

// What the kernel knows of the firmware's picture: 1280x960 at the start
// of an aperture of 256 MiB.
fn known() -> scanout.Memory {
    return scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
}

// The machine of the file's head made anew: the firmware's link at `code`
// on `lanes` lanes, the display clock's word `word`.
fn machineWith(name: []const u8, code: usize, lanes: usize, word: usize) -> void { machineAt(name, 0, code, lanes, word) }

// The ROM as it is now (after a test changed its bytes) opened and read,
// with the user's figure for the display clock.
fn reopen() -> void {
    builder.resum()
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
    information.engine = FIGURE
}

// The same with the picture on controller `c`.
fn machineAt(name: []const u8, c: usize, code: usize, lanes: usize, word: usize) -> void {
    sink.reset()
    if show {
        say("-- ")
        say(name)
        say("\n")
    }
    sink.makeRom(&builder, 0x02, card.Ending.plain)
    reopen()
    sink.monitor(0x12, 0x14, 4, true)
    sink.firmware(c, 2, code, lanes)
    card.store(0x124, word)
    var k: usize = 0
    while k < 6 {
        card.store(0x142 + 4 * k, 600000000)
        k += 1
    }
    card.clockAtOrBelow = true
    card.referenceAsRom = true
}

// The card read out, the monitor asked, the plan made and said for
// `monitor`, with the ROM that is open.
fn make(monitor: *const edid.Monitor) -> void {
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    const offer = edid.nothing()
    outCard = scanout.Card.{ .read = sink.read, .now = card.now, .write = logWrite }
    port = aux.Port.{ .card = &outCard, .write = sink.auxWrite }
    channel = aux.Channel.open(&port, sink.channel, sink.line)
    memory = known()
    scanout.report(&outCard, &memory, &readout)
    remember()
    dplink.ask(&channel, &heard)
    mode.makeWith(&outCard, &readout, &memory, monitor, &offer, &facts, mode.Wish.own, &heard, &plan)
    mode.say(&outCard, &plan)
    mode.list(&outCard, &plan)
    sink.forget()
}

// The plan carried out, lent the tables and the channel.
fn carry() -> bool {
    const hands = set.Hands.{ .write = sink.write, .clear = card.clear }
    const lent = set.Tables.{ .machine = &machine, .hands = sink.hands(), .aside = card.setAside }
    return set.attemptLink(&outCard, &hands, &lent, &channel, &plan, true, &result)
}

// No plan, for this reason, with this line; and nothing written, run or
// sent when it is told to be carried out.
fn refused(name: []const u8, missing: mode.Missing, text: []const u8) -> void {
    expect(!plan.complete && plan.missing == missing && plan.count == 0 && plan.backCount == 0, name)
    line(text)
    expect(!carry() && card.written == 0 && card.runs == 0 && sink.transactions == 0 && card.cleared == 0 && result.outcome == set.Outcome.untouched, "a plan that is refused: nothing written, run or sent")
}

// An event of the list as two numbers (480's way: a write is its register
// and its word; a transaction of the monitor's W or R and its address,
// then its bytes or its length).
const W: usize = 0x1000000
const R: usize = 0x2000000
const OTHER: usize = 0x4000000

fn eventOf(k: usize, second: bool) -> usize {
    if card.writtenTo[k] != sink.EVENT { return if second { card.writtenWith[k] } else { card.writtenTo[k] } }
    const t = card.writtenWith[k]
    const command = @intCast(usize, sink.headOf[t]) >> 4
    const length = if sink.lengthOf[t] == sink.NEVER { 0 } else { sink.lengthOf[t] }
    if command == 0x9 { return if second { length } else { R + sink.addressOf[t] } }
    if command != 0x8 { return if second { length } else { OTHER + sink.addressOf[t] } }
    if !second { return W + sink.addressOf[t] }
    var bytes: usize = 0
    var j: usize = 0
    while j < length && j < 7 {
        bytes = bytes | (@intCast(usize, sink.dataOf[t * 16 + j]) << @intCast(u6, 8 * j))
        j += 1
    }
    return (length << 56) | bytes
}

fn sayEvent(first: usize, second: usize) -> void {
    const out = scanout.Card.{ .read = sink.read, .now = card.now, .write = say }
    out.hexDigits(first, 8)
    say(" = ")
    out.hexDigits(second >> 32, 8)
    out.hexDigits(second & 0xFFFFFFFF, 8)
}

// The events from number `from` on against a sequence worked out by hand
// (pairs); to the list's end when `whole`. Where the sequence ends.
fn sameEvents(name: []const u8, from: usize, pairs: []const usize, whole: bool) -> usize {
    const out = scanout.Card.{ .read = sink.read, .now = card.now, .write = say }
    var k: usize = 0
    while k * 2 + 1 < pairs.length && from + k < card.written {
        const first = eventOf(from + k, false)
        const second = eventOf(from + k, true)
        if first != pairs[k * 2] || second != pairs[k * 2 + 1] {
            say("not as expected: ")
            say(name)
            out.field(": event ", from + k + 1)
            say(" is ")
            sayEvent(first, second)
            say(", worked out ")
            sayEvent(pairs[k * 2], pairs[k * 2 + 1])
            say("\n")
            if failed == 0 { failed = 3 }
            return from + k
        }
        k += 1
    }
    if k * 2 < pairs.length || (whole && card.written != from + pairs.length / 2) {
        say("not as expected: ")
        say(name)
        out.field(": ", card.written - from)
        out.field(" events, worked out ", pairs.length / 2)
        say("\n")
        if failed == 0 { failed = 3 }
    }
    return from + k
}

// The events and the plan of a change on a card whose display clock is
// enough, kept to hold the same change against where it is raised.
const KEPT: usize = 4096
var keptFirst: [KEPT]usize = undefined
var keptSecond: [KEPT]usize = undefined
var keptCount: usize = 0
var keptPlan: mode.Plan = undefined

fn keepAll() -> void {
    keptCount = 0
    while keptCount < card.written && keptCount < KEPT {
        keptFirst[keptCount] = eventOf(keptCount, false)
        keptSecond[keptCount] = eventOf(keptCount, true)
        keptCount += 1
    }
    keptPlan = plan
}

// The events from `from` on are the kept ones from `keptFrom` on, to both
// lists' ends.
fn sameAsKept(name: []const u8, from: usize, keptFrom: usize) -> void {
    const out = scanout.Card.{ .read = sink.read, .now = card.now, .write = say }
    var k: usize = 0
    while from + k < card.written && keptFrom + k < keptCount {
        const first = eventOf(from + k, false)
        const second = eventOf(from + k, true)
        if first != keptFirst[keptFrom + k] || second != keptSecond[keptFrom + k] {
            say("not as expected: ")
            say(name)
            out.field(": event ", from + k + 1)
            say(" is ")
            sayEvent(first, second)
            say(", without the clock ")
            sayEvent(keptFirst[keptFrom + k], keptSecond[keptFrom + k])
            say("\n")
            if failed == 0 { failed = 4 }
            return
        }
        k += 1
    }
    if card.written - from != keptCount - keptFrom {
        say("not as expected: ")
        say(name)
        out.field(": ", card.written - from)
        out.field(" events after the clock's, without it ", keptCount - keptFrom)
        say("\n")
        if failed == 0 { failed = 4 }
    }
}

// Two steps alike (a table's run by its block's words).
fn sameStep(a: *const mode.Step, aPlan: *const mode.Plan, b: *const mode.Step, bPlan: *const mode.Plan) -> bool {
    if a.*.kind != b.*.kind || a.*.phase != b.*.phase || a.*.transient != b.*.transient || a.*.banked != b.*.banked || a.*.live != b.*.live { return false }
    if a.*.register != b.*.register || a.*.value != b.*.value || a.*.mask != b.*.mask || a.*.time != b.*.time { return false }
    if a.*.gate != b.*.gate || a.*.gateMask != b.*.gateMask || a.*.gateValue != b.*.gateValue { return false }
    if a.*.kind == mode.Kind.table {
        const x = &aPlan.*.blocks[a.*.block]
        const y = &bPlan.*.blocks[b.*.block]
        var k: usize = 0
        while k < blocks.WORDS {
            if x.*.words[k] != y.*.words[k] { return false }
            k += 1
        }
    }
    return true
}

// The plan is the kept one with `inserted` steps put in at `at` of its own
// steps, and its way back the kept one's with `added` steps after it.
fn samePlan(name: []const u8, at: usize, inserted: usize, added: usize) -> void {
    var fine = plan.count == keptPlan.count + inserted && plan.backCount == keptPlan.backCount + added && plan.writes == keptPlan.writes
    var k: usize = 0
    while fine && k < keptPlan.count {
        fine = sameStep(&plan.steps[if k < at { k } else { k + inserted }], &plan, &keptPlan.steps[k], &keptPlan)
        k += 1
    }
    k = 0
    while fine && k < keptPlan.backCount {
        fine = sameStep(&plan.back[k], &plan, &keptPlan.back[k], &keptPlan)
        k += 1
    }
    expect(fine, name)
}

// A table's run step with the block `first`, `second` (the display
// clock's table's two words).
fn isRun(step: *const mode.Step, first: usize, second: usize) -> bool {
    if step.*.kind != mode.Kind.table { return false }
    const block = &plan.blocks[step.*.block]
    return block.*.table == videorom.Command.SetDCEClock && block.*.bytes == 8 && @intCast(usize, block.*.words[0]) == first && @intCast(usize, block.*.words[1]) == second
}

// A look (a wait with no time) at these bits of this register for this
// value.
fn isLook(step: *const mode.Step, register: usize, mask: usize, value: usize) -> bool {
    return step.*.kind == mode.Kind.wait && step.*.time == 0 && step.*.register == register && step.*.mask == mask && step.*.value == value
}

fn isSet(step: *const mode.Step, register: usize, mask: usize, value: usize) -> bool {
    return step.*.kind == mode.Kind.write && step.*.live && step.*.register == register && step.*.mask == mask && step.*.value == value
}

fn isPut(step: *const mode.Step, register: usize, value: usize) -> bool {
    return step.*.kind == mode.Kind.write && !step.*.live && step.*.register == register && step.*.mask == 0xFFFFFFFF && step.*.value == value
}

// The four steps that raise the display clock to `tens` tens of kHz and
// look at what the DTO divides, at `at` of the plan's steps.
fn raisedAt(name: []const u8, at: usize, tens: usize) -> void {
    expect(plan.clockAt == at && plan.outputAt == at + 4 && isRun(&plan.steps[at], tens, 0x800) && isRun(&plan.steps[at + 1], 0, 0x801) && isLook(&plan.steps[at + 2], 0x142, 0xFFFFFFFF, 600000000) && isLook(&plan.steps[at + 3], 0x124, 0x7F000000, 0x18000000), name)
}

// The nine steps of the way back's last part, from `at` of it: the scratch
// words as Linux has them, the clock 118040 kHz (10 kHz above the 118032
// it reads) and the reference clock, the looks at the modulo, the
// reference clock's divider (`reference`) and the display clock's (0x5D),
// the scratch words whole.
fn backAt(name: []const u8, at: usize, reference: usize) -> void {
    expect(plan.backClock == at && plan.backCount == at + 9 && isSet(&plan.back[at], 0x5CF, 0x20000000, 0x20000000) && isSet(&plan.back[at + 1], 0x5CB, 0x20010000, 0) && isRun(&plan.back[at + 2], 0x2E1C, 0x800) && isRun(&plan.back[at + 3], 0, 0x801) && isLook(&plan.back[at + 4], 0x142, 0xFFFFFFFF, 600000000) && isLook(&plan.back[at + 5], 0x124, 0x7F000000, reference) && isLook(&plan.back[at + 6], 0x124, 0x7F, 0x5D) && isPut(&plan.back[at + 7], 0x5CF, 0x00000010) && isPut(&plan.back[at + 8], 0x5CB, 0x20010005), name)
}

// The way there up to the output's first step, 3840x1080 on the user's
// card: the urgency marks at their highest in the four sets, the scratch
// words as Linux has them (480's), then SetDCEClock told 32635 tens of
// kHz (7b 7f 00 00), the display clock (type 0) from the card's own
// divider (source 8), and told the reference clock (type 1), no clock.
const RAISED = [_]usize{
    0x1B32, 0x00010000, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010100, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010200, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010300, 0x1B33, 0xFFFFFFFF,
    0x05CF, 0x20000010, 0x05CB, 0x00000005,
    0x7F00, 0x00007F7B, 0x7F01, 0x00000800, 0x7F10, 46,
    0x7F00, 0x00000000, 0x7F01, 0x00000801, 0x7F10, 46,
}

// The same for 1920x1080: 17931 tens of kHz (0b 46 00 00).
const RAISED_FULL = [_]usize{
    0x1B32, 0x00010000, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010100, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010200, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010300, 0x1B33, 0xFFFFFFFF,
    0x05CF, 0x20000010, 0x05CB, 0x00000005,
    0x7F00, 0x0000460B, 0x7F01, 0x00000800, 0x7F10, 46,
    0x7F00, 0x00000000, 0x7F01, 0x00000801, 0x7F10, 46,
}

// After a look that fails, nothing of the output touched: the way back
// from its marks (each set given what it held: 0x00fa0030, 0x00fa0040 and
// none; the set chosen as it was), the registers held against the
// firmware's (the scratch words), then the clock's two runs for 11804
// tens of kHz (1c 2e 00 00) under the scratch words as Linux has them,
// and the words whole again.
const UNTOUCHED = [_]usize{
    0x1B32, 0x00010000, 0x1B33, 0x00FA0030,
    0x1B32, 0x00010100, 0x1B33, 0x00FA0040,
    0x1B32, 0x00010200, 0x1B33, 0x00000000,
    0x1B32, 0x00010300, 0x1B33, 0x00000000,
    0x1B32, 0x00010100,
    0x05CF, 0x00000010, 0x05CB, 0x20010005,
    0x05CF, 0x20000010, 0x05CB, 0x00000005,
    0x7F00, 0x00002E1C, 0x7F01, 0x00000800, 0x7F10, 46,
    0x7F00, 0x00000000, 0x7F01, 0x00000801, 0x7F10, 46,
    0x05CF, 0x00000010, 0x05CB, 0x20010005,
}

// The last of a whole way back: the clock's part as above, then the
// monitor's lanes read (a byte at its registers' start, then 202h on).
const LAST = [_]usize{
    0x05CF, 0x20000010, 0x05CB, 0x00000005,
    0x7F00, 0x00002E1C, 0x7F01, 0x00000800, 0x7F10, 46,
    0x7F00, 0x00000000, 0x7F01, 0x00000801, 0x7F10, 46,
    0x05CF, 0x00000010, 0x05CB, 0x20010005,
    R + 0x000, 1, R + 0x202, 6,
}

// A change that ends at the look after the clock's runs: why, where, and
// the registers and the clock back with nothing of the output touched.
fn endsAtLook(name: []const u8, step: usize, text: []const u8) -> void {
    const fine = !carry() && result.reason == set.Reason.wait && result.step == step && result.trainings == 0 && result.trainingsBack == 0 && result.runs == 2 && result.runsBack == 2
    if !fine && !show {
        say("in: ")
        say(name)
        say("\n")
    }
    expect(fine, "the look fails: the change ends there, the clock's two runs there and back, no training")
    line(text)
    line("gpu: putting the firmware's state back (nothing of the output was changed yet: the registers alone, and the display clock as it was)\n")
    const turn = sameEvents("the way there to the look", 0, RAISED[0..], false)
    _ = sameEvents("the way back with nothing of the output touched", turn, UNTOUCHED[0..], true)
    expect(sink.transactions == 0 && monitorHolds(0x06, 2) && card.cleared == 1, "the look fails: the monitor not asked anything, its link as it was")
}

// The ROM's display clock's table made one whose run for the reference
// clock writes nothing (as a ROM may that leaves alone what is as it
// should be already): its program put at the ROM's end in the list's
// place, its revision 2.1 again. The program: COMPARE the first byte of
// the second word it was told (the clock's type) with 1 (atom.c's opcode
// 0x3D, a parameter word; the attribute 0x25: its byte at 0 against one
// byte given), JUMP_EQUAL (0x44) to the end; then the file's head's
// program that answers.
var idle: [96]u8 = undefined

fn referenceWritesNothing() -> void {
    const rest = card.program(videorom.Command.SetDCEClock, 2, card.Ending.answer)
    idle[0] = 0x3D
    idle[1] = 0x25
    idle[2] = 0x01
    idle[3] = 0x01
    idle[4] = 0x44
    // (A table's program begins six bytes into the table; the end is the
    // last byte of what follows.)
    const end = 6 + 7 + rest.length - 1
    idle[5] = @intCast(u8, end & 0xFF)
    idle[6] = @intCast(u8, end >> 8)
    var k: usize = 0
    while k < rest.length {
        idle[7 + k] = rest[k]
        k += 1
    }
    _ = builder.command(videorom.Command.SetDCEClock, 0, 8, idle[0..7 + rest.length])
    builder.revise(videorom.Command.SetDCEClock, 2, 1)
    builder.finish()
    reopen()
}

// The TMDS machine of 474 (an HDMI output, DIG 4, hot plug line 2) with
// the user's display clock, and its plan for the user's monitor by HDMI.
fn tmdsMachine() -> void {
    card.reset()
    if show { say("-- a TMDS plan at the user's figures\n") }
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the TMDS ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
    information.engine = FIGURE
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x124, USERS)
    card.clockAtOrBelow = true
    card.referenceAsRom = true
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    var offer = edid.nothing()
    offer.hdmi = true
    offer.extensions = 1
    offer.given = 1
    const monitor = users()
    memory = known()
    scanout.report(&out, &memory, &readout)
    mode.makeFor(&out, &readout, &memory, &monitor, &offer, &facts, mode.Wish.own, &plan)
    mode.say(&out, &plan)
    mode.list(&out, &plan)
    card.forget()
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1

    // ---- 3840x1080 on a link that is too slow (1.62 Gbit/s on 2
    // lanes), first on a card whose clock is enough: the change kept to
    // hold the other against.
    machineWith("3840x1080, a display clock that is enough", 0x06, 2, ENOUGH)
    const own = users()
    make(&own)
    expect(plan.complete && plan.dp.case == mode.LinkCase.retrain && !plan.tmds.engineRaised && plan.runs == 0 && plan.clockAt == mode.STEPS, "enough: nothing raised")
    expect(carry() && result.outcome == set.Outcome.done && monitorHolds(0x0A, 4), "enough: the change comes through")
    keepAll()

    // The user's card: 118032 kHz, raised to 326350 (1.05 and 1.15 times
    // 270270 in Linux's whole numbers), within the ROM's 626100.
    machineWith("3840x1080 on the user's card", 0x06, 2, USERS)
    make(&own)
    expect(plan.complete && plan.situation == mode.Situation.displayport && plan.dp.case == mode.LinkCase.retrain && plan.dp.target.code == 0x0A && plan.dp.target.lanes == 4, "the user's card: trained at 2.70 Gbit/s on 4 lanes")
    expect(plan.tmds.engine == 118032 && plan.tmds.engineNeeded == 326350 && plan.tmds.engineDefault == FIGURE && plan.tmds.engineRaised && plan.tmds.engineAsked == 326350 && plan.runs == 2, "the user's card: the display clock raised to 326350 kHz, two table runs")
    // Right after the marks and the scratch words, and nothing else of the
    // plan otherwise; its way back the other's with the clock's part last.
    raisedAt("the user's card: the clock's runs and the looks after the scratch words", 10, 32635)
    samePlan("the user's card: the plan of a card whose clock is enough, with the clock's steps", 10, 4, 9)
    backAt("the user's card: the way back's last part", keptPlan.backCount, 0x18000000)
    line("gpu: the display clock is 118032 kHz (the ROM's own figure 626100 kHz): 270270 kHz needs 326350, which it is not: it is raised to that\n")
    line("gpu: plan (b, DisplayPort): the link is too slow: it is taken down and trained at 2.70 Gbit/s on 4 lanes (the lowest rate and the fewest lanes that carry 270270 kHz; ")
    line("gpu: plan (b, DisplayPort): the pixel clock from 108000 to 270270 kHz (the DTO's phase from 108000000 to 270270000), the display clock raised to 326350 kHz, the timing, the link trained, a picture of 3840x1080 at 0x500000 of the aperture, the scaler off: 72 writes, 2 table runs for the display clock and the link's own steps (its table's runs, what the monitor is told, the training) would do it\n")
    line("gpu: would set 05cb & 20010000 = 00000000 (two of the firmware's notes cleared, as Linux has them)\ngpu: would run SetDCEClock with 7b 7f 00 00 00 08 00 00 (the display engine's clock raised)\ngpu: would run SetDCEClock with 00 00 00 00 01 08 00 00 (the DisplayPort reference clock set again after it)\ngpu: would look for 0142 & ffffffff = 23c34600 (the controller's DTO divides by the modulo it had)\ngpu: would look for 0124 & 7f000000 = 18000000 (the reference clock it divides is the one it was)\ngpu: would set 4ca4 & 00000300 = 00000200 (the stream to stop at a frame's end)\n")
    line("gpu: on the way back would train the link at 1.62 Gbit/s on 2 lanes (the firmware's own link brought up and trained)\ngpu: on the way back would run SetDCEClock with 1c 2e 00 00 00 08 00 00 (the display engine's clock as it was)\ngpu: on the way back would run SetDCEClock with 00 00 00 00 01 08 00 00 (the DisplayPort reference clock set again after it)\n")
    expect(card.written == 0 && card.runs == 0, "the plan: nothing written for it")
    // Carried out: the two runs right after the scratch words, the looks
    // hold (the table writes the reference clock and the modulos as they
    // were), then the change event for event as on the other card.
    const saidBefore = card.logged
    expect(carry() && result.outcome == set.Outcome.done && result.runs == 12 && result.trainings == 1 && monitorHolds(0x0A, 4), "the user's card: the change comes through, two runs more")
    const there = sameEvents("the user's card: the way there to the output's first step", 0, RAISED[0..], false)
    sameAsKept("the user's card: the rest as without the clock", there, there - 6)
    expect(card.raw(0x124) == 0x1800002D && card.raw(0x142) == 600000000, "the user's card: the display clock at 320000 kHz (divider 0x2D), the reference clock and the modulo as they were")
    const bound = card.after("gpu: setting the monitor's own mode on a link trained for it: carrying out the plan's 72 writes, 2 table runs for the display clock and the link's own steps (said as they run); the screen is dark meanwhile, ", saidBefore)
    expect(bound != card.NEVER && bound < card.after("gpu: table SetDCEClock (the display engine's clock raised)", saidBefore), "the carrying out said before the first run")
    line("gpu: table SetDCEClock (the display engine's clock raised) ran to its end: ")
    line(" writes (3 registers not written before), 0 us waited; it answers 320000 kHz\n")
    line("gpu: 0142 & ffffffff is 23c34600 (the controller's DTO divides by the modulo it had)\ngpu: 0124 & 7f000000 is 18000000 (the reference clock it divides is the one it was)\n")
    line("gpu: controller 0 shows a picture of 3840x1080 as it is, ")
    line(" frames a second: the monitor's own mode is set, on a link trained at 2.70 Gbit/s on 4 lanes (12 table runs, ")

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- 1920x1080 (148.5 MHz): from 1.62 Gbit/s on 2 lanes to 4 lanes
    // at that rate; the clock raised to 179313 kHz.
    const middle = full()
    machineWith("1920x1080, a display clock that is enough", 0x06, 2, ENOUGH)
    make(&middle)
    expect(carry() && result.outcome == set.Outcome.done && monitorHolds(0x06, 4), "1920x1080, enough: the change comes through")
    keepAll()
    machineWith("1920x1080 on the user's card", 0x06, 2, USERS)
    make(&middle)
    expect(plan.complete && plan.dp.case == mode.LinkCase.retrain && plan.dp.target.code == 0x06 && plan.dp.target.lanes == 4 && plan.tmds.engineRaised && plan.tmds.engineAsked == 179313, "1920x1080: 1.62 Gbit/s on 4 lanes, the clock raised to 179313 kHz")
    raisedAt("1920x1080: the clock's runs and the looks", 10, 17931)
    samePlan("1920x1080: the plan of a card whose clock is enough, with the clock's steps", 10, 4, 9)
    backAt("1920x1080: the way back's last part", keptPlan.backCount, 0x18000000)
    line("gpu: the display clock is 118032 kHz (the ROM's own figure 626100 kHz): 148500 kHz needs 179313, which it is not: it is raised to that\n")
    expect(carry() && result.outcome == set.Outcome.done && monitorHolds(0x06, 4), "1920x1080 on the user's card: the change comes through")
    const middleThere = sameEvents("1920x1080: the way there to the output's first step", 0, RAISED_FULL[0..], false)
    sameAsKept("1920x1080: the rest as without the clock", middleThere, middleThere - 6)
    line("it answers 175600 kHz\n")
    expect(card.raw(0x124) == 0x18000049, "1920x1080: the divider the table chose (20.5)")

    // ---- 1280x720 (74.25 MHz needs 89656 kHz): the firmware's link has
    // room and is kept, nothing raised: the plan and the change are a
    // card's whose clock is enough, write for write.
    const small = narrow()
    machineWith("1280x720, a display clock that is enough", 0x06, 2, ENOUGH)
    make(&small)
    expect(carry() && result.outcome == set.Outcome.done, "1280x720, enough: kept and set")
    keepAll()
    machineWith("1280x720 on the user's card", 0x06, 2, USERS)
    make(&small)
    expect(plan.complete && plan.dp.case == mode.LinkCase.keep && !plan.tmds.engineRaised && plan.runs == 0 && plan.clockAt == mode.STEPS && plan.tmds.engineNeeded == 89656, "1280x720: kept, nothing raised")
    samePlan("1280x720: the plan of a card whose clock is enough", 0, 0, 0)
    line("gpu: the display clock is 118032 kHz (the ROM's own figure 626100 kHz): 74250 kHz needs 89656, which it is\n")
    noLine("SetDCEClock")
    expect(carry() && result.outcome == set.Outcome.done && card.runs == 0 && card.raw(0x124) == USERS, "1280x720 on the user's card: set by registers alone")
    sameAsKept("1280x720: event for event", 0, 0)

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- A link that has room (2.7 Gbit/s on 4 lanes carry 360000 kHz):
    // kept on a card whose clock is enough; on the user's card trained
    // again at the same rate and lanes, the clock raised with it.
    machineWith("a link that has room on the user's card", 0x0A, 4, USERS)
    make(&own)
    expect(plan.complete && plan.dp.case == mode.LinkCase.retrain && plan.dp.firmware.code == 0x0A && plan.dp.firmware.lanes == 4 && plan.dp.target.code == 0x0A && plan.dp.target.lanes == 4 && plan.tmds.engineRaised, "room: trained at the same rate and lanes, the clock raised")
    raisedAt("room: the clock's runs and the looks", 10, 32635)
    backAt("room: the way back's last part", plan.backCount - 9, 0x18000000)
    line("gpu: plan (b, DisplayPort): the link has 4 lanes at 2.70 Gbit/s (by M 0x3333 over N 0x8000), room for 360000 kHz at 24 bits: 270270 kHz fits\n")
    line("gpu: plan (b, DisplayPort): the link has room, but the display clock has to be raised, which is done only for a link that is trained: it is taken down and trained at 2.70 Gbit/s on 4 lanes (")
    expect(carry() && result.outcome == set.Outcome.done && result.trainings == 1 && monitorHolds(0x0A, 4), "room: the change comes through")
    _ = sameEvents("room: the way there to the output's first step", 0, RAISED[0..], false)
    machineWith("a link that has room on a card whose clock is enough", 0x0A, 4, ENOUGH)
    make(&own)
    expect(plan.complete && plan.dp.case == mode.LinkCase.keep && !plan.tmds.engineRaised, "room, enough: kept, as before")

    // ---- Another controller (2): its own DTO's modulo looked at (0x14a),
    // there and back.
    machineAt("the picture on controller 2", 2, 0x06, 2, USERS)
    make(&own)
    expect(plan.complete && plan.controller == 2 && plan.tmds.engineRaised && isLook(&plan.steps[plan.clockAt + 2], 0x14A, 0xFFFFFFFF, 600000000) && isLook(&plan.back[plan.backClock + 4], 0x14A, 0xFFFFFFFF, 600000000), "controller 2: its DTO's modulo looked at")
    expect(carry() && result.outcome == set.Outcome.done && monitorHolds(0x0A, 4), "controller 2: the change comes through")
    line("gpu: 014a & ffffffff is 23c34600 (the controller's DTO divides by the modulo it had)\n")

    // ---- The display clock's table not in the ROM, or of a revision no
    // block is filled for: refused where the clock has to be raised, not
    // looked at where it is enough.
    machineWith("SetDCEClock not in the ROM", 0x06, 2, USERS)
    builder.poke16(rom.COMMANDS + 4 + 2 * videorom.Command.SetDCEClock, 0)
    reopen()
    make(&own)
    refused("SetDCEClock not in the ROM", mode.Missing.no_table, "gpu: plan (b, DisplayPort): nothing would be set: table SetDCEClock is not in the card's ROM\n")
    machineWith("SetDCEClock not in the ROM, not needed", 0x06, 2, ENOUGH)
    builder.poke16(rom.COMMANDS + 4 + 2 * videorom.Command.SetDCEClock, 0)
    reopen()
    make(&own)
    expect(plan.complete && !plan.tmds.engineRaised, "SetDCEClock not in the ROM, not needed: the plan is complete")
    machineWith("SetDCEClock of another revision", 0x06, 2, USERS)
    builder.revise(videorom.Command.SetDCEClock, 2, 2)
    reopen()
    make(&own)
    refused("SetDCEClock of another revision", mode.Missing.table_revision, "gpu: plan (b, DisplayPort): nothing would be set: table SetDCEClock is revision 2.2 in this ROM: what it is told is known here for content revision 1 only\n")
    // More than the ROM's own figure.
    machineWith("a display clock above the ROM's figure", 0x06, 2, USERS)
    information.engine = 326349
    make(&own)
    refused("above the ROM's figure", mode.Missing.engine_clock_low, "gpu: plan (b, DisplayPort): nothing would be set: the display clock would have to be 326350 kHz, more than the ROM's own figure of 326349 kHz\n")
    // (Said as not raised.)
    line("gpu: the display clock is 118032 kHz (the ROM's own figure 326349 kHz): 270270 kHz needs 326350, which it is not\n")
    machineWith("a display clock that is the ROM's figure", 0x06, 2, USERS)
    information.engine = 326350
    make(&own)
    expect(plan.complete && plan.tmds.engineRaised && plan.tmds.engineAsked == 326350, "the ROM's figure itself: raised to it")

    // ---- The look after the clock's runs fails: the DTO's modulo reads
    // otherwise (while the two runs are the last tables that ran).
    machineWith("the modulo reads otherwise after the clock's runs", 0x06, 2, USERS)
    make(&own)
    card.heldRegister = 0x142
    card.heldMask = 0xFFFFFFFF
    card.heldValue = 500000000
    card.heldFrom = 2
    card.heldUntil = 3
    endsAtLook("the modulo", 12, "gpu: step 13 of ")
    line(" failed (a state did not come): look for 0142 & ffffffff = 23c34600 (the controller's DTO divides by the modulo it had), read 1dcd6500\n")
    line("gpu: the firmware's state is back (")
    line(" writes, 2 table runs for the display engine's clock as it was); the controller counts frames (")
    expect(result.outcome == set.Outcome.back && asBefore() && card.raw(0x124) == USERS, "the modulo: back, the display clock's divider 0x5D again")
    // The reference clock's divider reads otherwise.
    machineWith("the reference clock's divider reads otherwise", 0x06, 2, USERS)
    make(&own)
    card.heldRegister = 0x124
    card.heldMask = 0x7F000000
    card.heldValue = 0x10000000
    card.heldFrom = 2
    card.heldUntil = 3
    endsAtLook("the reference clock's divider", 13, "gpu: 0124 & 7f000000 is not 18000000 (the reference clock it divides is the one it was): it reads 1000002d\n")
    expect(result.outcome == set.Outcome.back && asBefore(), "the divider: back")
    // A firmware that runs the reference clock at another divider (0x10:
    // 900 MHz): the table sets it to 600 MHz for good, there and on the
    // way back. The change ends at the look; the way back cannot give the
    // firmware's divider back and says so.
    machineWith("a firmware whose reference clock the table moves", 0x06, 2, 0x1000005D)
    make(&own)
    expect(plan.complete && plan.tmds.engineRaised && isLook(&plan.steps[13], 0x124, 0x7F000000, 0x10000000), "another reference clock: looked for as the firmware has it")
    endsAtLook("the reference clock moved", 13, "gpu: 0124 & 7f000000 is not 10000000 (the reference clock it divides is the one it was): it reads 1800002d\n")
    line("gpu: on the way back, not as it should be (the way goes on): look for 0124 & 7f000000 = 10000000 (the reference clock it divides is the one it was)\n")
    line("gpu: the firmware's state is NOT known to be back: the registers this driver wrote have the firmware's values again (")
    line(" writes, 2 table runs for the display engine's clock as it was), but 1 thing on the way back was not as it should be (said in the log)")
    expect(result.outcome == set.Outcome.unsure && result.doubts == 1 && card.raw(0x124) == 0x1800005D, "the reference clock moved: not said to be back, the display clock's own divider as it was")

    // (What follows rests on what came before.)
    if failed != 0 { return failed }

    // ---- A failure after the output was touched (the DTO's phase does
    // not read back while the link is down): the whole way back, the
    // clock's part last of all the tables, the monitor's lanes after it.
    machineWith("a failure after the output was touched", 0x06, 2, USERS)
    make(&own)
    card.heldRegister = 0x141
    card.heldMask = 0xFFFFFFFF
    card.heldValue = 0
    card.heldFrom = 3
    card.heldUntil = 4
    expect(!carry() && result.reason == set.Reason.read_back && result.trainings == 0 && result.trainingsBack == 1, "after the output: the change ends at the DTO's phase, the firmware's link trained again")
    line("gpu: putting the firmware's state back (the link down, the firmware's clock and timing, the link trained at its own 1.62 Gbit/s on 2 lanes, its stream; the display clock as it was)\n")
    line("gpu: table SetDCEClock (the display engine's clock as it was) ran to its end: ")
    line(" 0 us waited; it answers 118030 kHz\n")
    line("gpu: 0124 & 0000007f is 0000005d (the display engine's clock's divider is the one it was)\n")
    expect(card.written >= LAST.length / 2, "after the output: events")
    _ = sameEvents("after the output: the way back's last", card.written - LAST.length / 2, LAST[0..], true)
    expect(result.outcome == set.Outcome.back && asBefore() && monitorHolds(0x06, 2) && card.raw(0x124) == USERS, "after the output: back, the display clock as the firmware had it")
    line("gpu: the firmware's state is back (")

    // ---- The way back told the clock cut down to whole 10 kHz (118030):
    // the user's ROM's table gives the next divider (31: 116129 kHz); told
    // 10 kHz more it gives the firmware's 30.5 (as on the host, both
    // interpreters).
    {
        machineWith("the clock cut down", 0x06, 2, USERS)
        const hands = card.hands()
        var cut = blocks.engineClock(118032)
        var params: [blocks.WORDS]u32 = cut.words
        const limits = atom.Limits.usual()
        var ran: atom.Result = undefined
        expect(machine.run(&hands, videorom.Command.SetDCEClock, params[0..], &limits, &ran) && card.raw(0x124) & 0x7F == 0x5E, "told 118030 kHz: the divider 31")
        cut = blocks.engineClock(118032 + 10)
        params = cut.words
        expect(machine.run(&hands, videorom.Command.SetDCEClock, params[0..], &limits, &ran) && card.raw(0x124) & 0x7F == 0x5D, "told 118040 kHz: the firmware's 30.5")
    }

    // ---- The reference clock's run writes nothing (a ROM that leaves
    // alone what is as it should be already): that is no failure, the
    // looks after it hold and the change comes through; a change that
    // fails later goes back without a doubt, the run writing nothing
    // there too.
    machineWith("the reference clock's run writes nothing", 0x06, 2, USERS)
    referenceWritesNothing()
    make(&own)
    expect(plan.complete && plan.tmds.engineRaised && plan.runs == 2, "the reference clock's run writes nothing: the plan as on the user's card")
    expect(carry() && result.outcome == set.Outcome.done && monitorHolds(0x0A, 4) && card.raw(0x124) == 0x1800002D, "the reference clock's run writes nothing: the change comes through")
    line("gpu: table SetDCEClock (the DisplayPort reference clock set again after it) ran to its end: ")
    line("gpu: 0142 & ffffffff is 23c34600 (the controller's DTO divides by the modulo it had)\n")
    noLine("wrote nothing")
    machineWith("the reference clock's run writes nothing, a failure later", 0x06, 2, USERS)
    referenceWritesNothing()
    make(&own)
    // (The DTO's phase does not read back while the link is down: one
    // table has come to its end by then, the clock's.)
    card.heldRegister = 0x141
    card.heldMask = 0xFFFFFFFF
    card.heldValue = 0
    card.heldFrom = 2
    card.heldUntil = 3
    expect(!carry() && result.reason == set.Reason.read_back && result.outcome == set.Outcome.back && result.doubts == 0 && asBefore() && card.raw(0x124) == USERS, "the reference clock's run writes nothing on the way back too: back, no doubt")

    // ---- A firmware whose controller's DTO divides by another modulo
    // (500000000, its phase for the same 108 MHz), and a reference clock's
    // run that leaves the modulos alone: the look is for the modulo as
    // read, there and back.
    machineWith("a modulo of 500000000", 0x06, 2, USERS)
    card.store(0x141, 90000000)
    card.store(0x142, 500000000)
    card.referenceAsRom = false
    make(&own)
    expect(plan.complete && plan.tmds.engineRaised && isLook(&plan.steps[plan.clockAt + 2], 0x142, 0xFFFFFFFF, 500000000) && isLook(&plan.back[plan.backClock + 4], 0x142, 0xFFFFFFFF, 500000000), "a modulo of 500000000: looked for as read, there and back")
    expect(carry() && result.outcome == set.Outcome.done, "a modulo of 500000000: the change comes through")
    line("gpu: 0142 & ffffffff is 1dcd6500 (the controller's DTO divides by the modulo it had)\n")

    // ---- A link whose room is the new rows' clock exactly (2.7 Gbit/s on
    // 4 lanes carry 360000 kHz): it has room, and is trained for the
    // display clock as one with more.
    {
        const exact = monitorOf(edid.Timing.{ .clock = 360000, .width = 3840, .hTotal = 4400, .hFront = 48, .hSync = 32, .hPositive = true, .height = 1080, .vTotal = 1125, .vFront = 3, .vSync = 5, .vPositive = false, .interlaced = false, .stereo = false })
        machineWith("a link whose room is the clock", 0x0A, 4, USERS)
        make(&exact)
        expect(plan.complete && plan.dp.case == mode.LinkCase.retrain && plan.tmds.engineRaised && plan.tmds.engineAsked == 434700, "room that is the clock: trained, the display clock raised")
        line("room for 360000 kHz at 24 bits: 360000 kHz fits\n")
        line("gpu: plan (b, DisplayPort): the link has room, but the display clock has to be raised, which is done only for a link that is trained: ")
    }

    // ---- A TMDS plan at the user's figures: as before. Its clock's two
    // runs with nothing between them and the output's first step, no look
    // at the DTO, its way back told the clock in whole 10 kHz as before
    // (1b 2e: 11803).
    tmdsMachine()
    expect(plan.complete && plan.situation == mode.Situation.tmds && plan.tmds.engineRaised && plan.tmds.engineAsked == 326350 && plan.outputAt == plan.clockAt + 2 && isRun(&plan.steps[plan.clockAt], 32635, 0x800) && isRun(&plan.steps[plan.clockAt + 1], 0, 0x801), "TMDS: the clock's two runs, nothing after them")
    expect(isRun(&plan.back[plan.backClock + 2], 0x2E1B, 0x800) && plan.backCount == plan.backClock + 6, "TMDS: the way back's clock as before")
    noLine("look for 0142")
    noLine("look for 0124")
    line("gpu: on the way back would run SetDCEClock with 1b 2e 00 00 00 08 00 00 (the display engine's clock as it was)\n")

    if failed != 0 { return failed }
    return 13
}
