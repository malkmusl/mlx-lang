// std.http.hsts: Strict-Transport-Security headers read strictly,
// policies with their expiry, an enforcer's host and session policies,
// which hosts it sends over https (subdomains included), the changes
// told, and the policies' file. Exits 13 when every check holds, else
// the number of the first check that failed.
const std = @import("std")
const hsts = @import("std.http.hsts")
const headers = @import("std.http.headers")

const NOW: i64 = 1800000000

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

const Written = struct {
    bytes: [1024]u8
    length: usize
}

fn append(context: usize, bytes: []const u8) -> void {
    const w: *Written = unsafe { @ptrFromInt(*Written, context) }
    var index: usize = 0
    while index < bytes.length {
        if w.*.length < 1024 {
            w.*.bytes[w.*.length] = bytes[index]
            w.*.length += 1
        }
        index += 1
    }
}

fn sinkOf(w: *Written) -> headers.Sink {
    w.*.length = 0
    return headers.Sink.{ .context = @intFromPtr(w), .write = append }
}

fn written(w: *Written) -> []const u8 { return w.*.bytes[0..w.*.length] }

var notices: Written = undefined

fn noteChange(context: usize, old: ?*const hsts.Policy, new: ?*const hsts.Policy) -> void {
    append(@intFromPtr(&notices), if old != null { old.?.*.domain } else { "(none)" })
    append(@intFromPtr(&notices), " -> ")
    append(@intFromPtr(&notices), if new != null { new.?.*.domain } else { "(none)" })
    append(@intFromPtr(&notices), "\n")
}

pub fn main() -> u8 {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var p: hsts.Policy = undefined

    // Headers, as tests/hsts.c reads them.
    if !hsts.parseHeader("max-age=31536000", "www.example.com", NOW, &p) || p.maxAge != 31536000 || p.includeSubdomains || !p.hasExpires || p.expires != NOW + 31536000 { return 1 }
    if !hsts.parseHeader("max-age=31536000; includeSubDomains", "www.example.com", NOW, &p) || !p.includeSubdomains { return 2 }
    if !hsts.parseHeader("max-age=600; includeSubDomains; preload", "www.example.com", NOW, &p) || p.maxAge != 600 || !p.includeSubdomains { return 3 }
    if hsts.parseHeader("includeSubDomains", "h", NOW, &p) { return 4 }
    if hsts.parseHeader("max-age=abc", "h", NOW, &p) { return 5 }
    if hsts.parseHeader("max-age=10; includeSubDomains=yes", "h", NOW, &p) { return 6 }
    if hsts.parseHeader("max-age=10; max-age=20", "h", NOW, &p) { return 7 }
    if !hsts.parseHeader("max-age=\"30\"", "h", NOW, &p) || p.maxAge != 30 { return 8 }
    if !hsts.parseHeader("max-age=0", "h", NOW, &p) || p.expires != 0 || !hsts.isExpired(&p, NOW) { return 9 }
    if hsts.parseHeader("", "h", NOW, &p) { return 10 }

    // Policies.
    const a = hsts.policy("example.com", 3600, true, NOW)
    var b = a
    if !hsts.equal(&a, &b) { return 11 }
    b.includeSubdomains = false
    if hsts.equal(&a, &b) { return 12 }
    const s = hsts.sessionPolicy("session.example", false)
    if !hsts.isSession(&s) || hsts.isExpired(&s, NOW) || hsts.isSession(&a) { return 14 }
    const full = hsts.policyWithExpiry("full.example", 100, 1000, false)
    if !hsts.isExpired(&full, NOW) { return 15 }
    if !same(hsts.superDomain("www.example.com"), "example.com") || !same(hsts.superDomain("com"), "") || !same(hsts.superDomain("a..b"), "b") { return 16 }

    // The enforcer.
    var enforcer: hsts.Enforcer = undefined
    hsts.init(&enforcer, allocator)
    notices.length = 0
    hsts.onChanged(&enforcer, noteChange, 0)
    hsts.setPolicy(&enforcer, &a, NOW)
    const only = hsts.policy("only.org", 3600, false, NOW)
    hsts.setPolicy(&enforcer, &only, NOW)
    hsts.setPolicy(&enforcer, &only, NOW)
    hsts.setSessionPolicy(&enforcer, "session.net", true, NOW)
    if !same(written(&notices), "(none) -> example.com\n(none) -> only.org\n(none) -> session.net\n") { return 17 }
    if !hsts.hasValidPolicy(&enforcer, "example.com", NOW) || hsts.hasValidPolicy(&enforcer, "www.example.com", NOW) || hsts.hasValidPolicy(&enforcer, "other.com", NOW) { return 18 }
    if !hsts.mustEnforce(&enforcer, "www.example.com", NOW) || !hsts.mustEnforce(&enforcer, "a.b.example.com", NOW) || hsts.mustEnforce(&enforcer, "sub.only.org", NOW) || !hsts.mustEnforce(&enforcer, "x.session.net", NOW) || hsts.mustEnforce(&enforcer, "notexample.com", NOW) { return 19 }
    if !hsts.hasValidPolicy(&enforcer, "EXAMPLE.com", NOW) { return 20 }
    var at: *hsts.Policy = undefined
    var count: usize = 0
    while hsts.policyAt(&enforcer, true, count, &at) { count += 1 }
    if count != 3 { return 21 }
    count = 0
    while hsts.policyAt(&enforcer, false, count, &at) { count += 1 }
    if count != 2 { return 22 }
    // A policy replaced: told when it differs; the same again, not.
    notices.length = 0
    const longer = hsts.policy("only.org", 7200, false, NOW)
    hsts.setPolicy(&enforcer, &longer, NOW)
    hsts.setPolicy(&enforcer, &longer, NOW)
    if !same(written(&notices), "only.org -> only.org\n") { return 23 }
    // An expired policy removes the domain's.
    notices.length = 0
    const gone = hsts.policy("example.com", 0, false, NOW)
    hsts.setPolicy(&enforcer, &gone, NOW)
    if !same(written(&notices), "example.com -> (none)\n") || hsts.mustEnforce(&enforcer, "www.example.com", NOW) { return 24 }
    // One that expires later is dropped once the time is past.
    const brief = hsts.policy("brief.example", 10, false, NOW)
    hsts.setPolicy(&enforcer, &brief, NOW)
    if !hsts.hasValidPolicy(&enforcer, "brief.example", NOW + 5) || hsts.hasValidPolicy(&enforcer, "brief.example", NOW + 20) { return 25 }
    notices.length = 0
    hsts.setPolicy(&enforcer, &longer, NOW + 20)
    if !same(written(&notices), "brief.example -> (none)\n") { return 26 }

    // The file.
    var w: Written = undefined
    hsts.writeText(sinkOf(&w), &enforcer)
    if !same(written(&w), "only.org\t7200\t1800007200\t0\n") { return 27 }
    hsts.deinit(&enforcer)
    hsts.init(&enforcer, allocator)
    hsts.loadText(&enforcer, "kept.example\t3600\t1800003600\t1\nold.example\t10\t1000\t0\nbad line\n", NOW)
    if !hsts.mustEnforce(&enforcer, "x.kept.example", NOW) || hsts.hasValidPolicy(&enforcer, "old.example", NOW) { return 28 }
    count = 0
    while hsts.policyAt(&enforcer, true, count, &at) { count += 1 }
    if count != 1 { return 29 }
    if !hsts.parseTextLine("d\t5\t7\t1", &p) || !same(p.domain, "d") || p.maxAge != 5 || p.expires != 7 || !p.includeSubdomains { return 30 }
    hsts.deinit(&enforcer)
    return 13
}
