// std.http.headers: header lists read as libsoup reads them (quoted
// strings keep their commas, delimiters and spaces skipped), tokens found
// in them, q-values, parameters (plain, quoted, RFC 5987's) decoded, and
// parameters written back as a token, a quoted string or RFC 5987's form;
// the header names libsoup knows. Exits 13 when every check holds, else
// the number of the first check that failed.
const headers = @import("std.http.headers")

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// What a sink wrote: a buffer and how much of it is used.
const Written = struct {
    bytes: [256]u8
    length: usize
}

fn append(context: usize, bytes: []const u8) -> void {
    const w: *Written = unsafe { @ptrFromInt(*Written, context) }
    var index: usize = 0
    while index < bytes.length {
        w.*.bytes[w.*.length] = bytes[index]
        w.*.length += 1
        index += 1
    }
}

fn sinkOf(w: *Written) -> headers.Sink {
    w.*.length = 0
    return headers.Sink.{ .context = @intFromPtr(w), .write = append }
}

fn writtenIs(w: *Written, expected: []const u8) -> bool {
    const all: []const u8 = w.*.bytes[0..w.*.length]
    return same(all, expected)
}

pub fn main() -> u8 {
    // A list with a quoted comma, empty items and spaces.
    var items = headers.list(" , one, \"two, three\" ,,four  ,", 44)
    var item: []const u8 = ""
    if !headers.next(&items, &item) || !same(item, "one") { return 1 }
    if !headers.next(&items, &item) || !same(item, "\"two, three\"") { return 2 }
    if !headers.next(&items, &item) || !same(item, "four") { return 3 }
    if headers.next(&items, &item) { return 4 }

    if !headers.contains("keep-alive, Upgrade", "upgrade") { return 5 }
    if headers.contains("keep-alive, \"Upgrade\"", "upgrade") { return 6 }

    // q-values.
    const q1 = headers.quality("text/html;level=1;q=0.75")
    if q1.thousandths != 750 || q1.length != 17 { return 7 }
    const q2 = headers.quality("gzip")
    if q2.thousandths != 1000 || q2.length != 4 { return 8 }
    const q3 = headers.quality("identity; q=0")
    if q3.thousandths != 0 || q3.length != 8 { return 9 }
    const q4 = headers.quality("x;q=1.5")
    if q4.thousandths != 1000 { return 10 }

    // Parameters.
    var p: headers.Param = undefined
    if !headers.param("charset = utf-8", &p) || !same(p.name, "charset") || !same(p.value, "utf-8") || p.kind != headers.ParamKind.plain { return 11 }
    if !headers.param("filename=\"a \\\"b\\\".txt\"", &p) || p.kind != headers.ParamKind.quoted { return 12 }
    var out: [64]u8 = undefined
    var n = headers.decodeQuoted(p.value, out[0..64])
    if !same(out[0..n], "a \"b\".txt") { return 13 }
    if !headers.param("title*=UTF-8''%e2%82%ac%20rates", &p) || p.kind != headers.ParamKind.extended || !same(p.name, "title") { return 14 }
    var m = headers.decodeExtended(p.value, out[0..64])
    if m != 9 || !same(out[0..9], "\u{20ac} rates") { return 15 }
    m = headers.decodeExtended("iso-8859-1'en'%A3%20rates", out[0..64])
    if m != 8 || !same(out[0..8], "\u{a3} rates") { return 16 }
    if headers.decodeExtended("koi8-r''x", out[0..64]) != -1 { return 17 }
    if headers.decodeExtended("UTF-8''%zz", out[0..64]) != -1 { return 18 }
    if headers.param("=novalue", &p) { return 19 }
    if !headers.param("flag", &p) || p.kind != headers.ParamKind.bare { return 20 }

    // Parameters written back.
    var w: Written = undefined
    headers.writeParam(sinkOf(&w), "a", "token", true)
    if !writtenIs(&w, "a=token") { return 21 }
    headers.writeParam(sinkOf(&w), "a", "two words", true)
    if !writtenIs(&w, "a=\"two words\"") { return 22 }
    headers.writeParam(sinkOf(&w), "a", "q\"b\\", true)
    if !writtenIs(&w, "a=\"q\\\"b\\\\\"") { return 23 }
    headers.writeParam(sinkOf(&w), "f", "\u{e9}t\u{e9} 1", true)
    if !writtenIs(&w, "f*=UTF-8''%C3%A9t%C3%A9%201") { return 24 }
    headers.writeParam(sinkOf(&w), "a", "token", false)
    if !writtenIs(&w, "a=\"token\"") { return 25 }

    // Names.
    if headers.nameIndex("content-type") != headers.CONTENT_TYPE { return 26 }
    if !same(headers.nameOf(headers.CONTENT_TYPE), "Content-Type") { return 27 }
    if headers.nameIndex("X-Unknown") != headers.NAME_COUNT { return 28 }
    if !same(headers.nameOf(headers.NAME_COUNT - 1), "X-Temp-Tablet") { return 29 }
    if headers.nameIndex("www-authenticate") != headers.WWW_AUTHENTICATE { return 30 }
    if headers.nameIndex("transfer-encoding") != headers.TRANSFER_ENCODING || headers.nameIndex("SET-COOKIE") != headers.SET_COOKIE { return 31 }
    return 13
}
