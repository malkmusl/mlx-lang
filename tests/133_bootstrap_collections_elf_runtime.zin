const bootstrap = @import("../std/bootstrap/root.zin")

pub fn main() -> u8 {
    const allocator = bootstrap.page_allocator.init()

    const left = bootstrap.string.fromSlice("alpha")
    const right = bootstrap.string.fromSlice("alpha")
    if !bootstrap.string.eql(left, right) {
        return 1
    }

    var list = bootstrap.array_list.init(allocator, 2)
    list = bootstrap.array_list.append(list, 13)
    list = bootstrap.array_list.append(list, 21)
    list = bootstrap.array_list.append(list, 34)
    if bootstrap.array_list.get(list, 2) != 34 {
        return 2
    }

    var map = bootstrap.hash_map.init(allocator, 16)
    map = bootstrap.hash_map.put(map, left, 77)
    if map.length != 1 {
        return 7
    }
    const expected_hash = bootstrap.string.hash(left)
    const expected_index = expected_hash % map.capacity
    if map.occupied[expected_index] != 1 {
        return 10
    }
    if map.hashes[expected_index] != expected_hash {
        return 11
    }
    if map.keyLengths[expected_index] != left.length {
        return 12
    }
    if map.keyPointers[expected_index][0] != left.pointer[0] {
        return 14
    }
    const lookup = bootstrap.hash_map.get(map, right)
    if !lookup.0 {
        return 8
    }
    if lookup.1 != 77 {
        return 9
    }

    const scratch_allocation = bootstrap.allocator.alloc(allocator, 4096, 8)
    if scratch_allocation == null {
        return 4
    }
    const scratch = scratch_allocation.?
    const decimal_length = bootstrap.fmt.unsignedDecimal(12345, scratch, 32)
    if decimal_length != 5 || scratch[0] != 49 || scratch[4] != 53 {
        return 5
    }

    const header_length = bootstrap.elf.writeExecutableHeaders(scratch, 4194424, 4096)
    if header_length != 120 || scratch[0] != 127 || scratch[18] != 62 {
        return 6
    }

    bootstrap.hash_map.deinit(map)
    bootstrap.array_list.deinit(list)
    bootstrap.allocator.free(allocator, scratch, 4096, 8)
    return 13
}
