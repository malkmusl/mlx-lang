// A local of a method shadows the members of its struct and the module's
// declarations by the same name: `const child = self.child()` then
// `child.twice()` calls the method of what the local holds (the lowering
// once took `child` for the method `child`: an unresolved symbol, or a
// crash for a freestanding program); likewise a local named as a module
// function. Exits 13 when every call goes where it should.
const Item = struct {
    value: usize
    pub fn twice(self: *const Self) -> usize { return self.*.value * 2 }
}

fn first(owner: *Owner) -> *Item { return &owner.*.items[0] }

const Owner = struct {
    items: [2]Item

    pub fn child(self: *Self) -> *Item { return &self.*.items[1] }

    pub fn run(self: *Self) -> usize {
        const child = self.child()
        return child.twice()
    }

    pub fn runFirst(self: *Self) -> usize {
        const first = self.child()
        return first.twice() + 1
    }
}

var owner: Owner = undefined // (per run)

pub fn main() -> u8 {
    owner.items[0].value = 5
    owner.items[1].value = 21
    if owner.run() != 42 { return 1 }
    if owner.runFirst() != 43 { return 2 }
    if first(&owner).twice() != 10 { return 3 }
    return 13
}
