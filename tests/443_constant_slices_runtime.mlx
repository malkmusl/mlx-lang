// The slice of an array is as writable as the array is: a `[]T` of a
// variable, of a field or an element of one and of what a `*T` points to;
// a `[]const T` of a constant (a module's or a local), of a parameter
// taken by value, of a field or an element of one, of what a `*const T`
// points to and of a call's result. A pointer capture (`for *item in
// ...`) follows it: a `*T` over a variable, a `*const T` over a constant.
//
// Before, an array's slice was a `[]T` wherever the array was. An array
// parameter is the caller's own storage (aggregates are passed by
// address), so a callee wrote into its caller's variable through `t[0..4]`;
// and writes through the slice of a constant compiled, into a copy made
// for them. Those programs are in tests/support/constant_slices_invalid
// and no longer compile; tests/run_constant_slices.sh runs them and this.
// Exits 13 when every check holds, else the number of the first check
// that failed.
const lib = @import("./modules/442_tables.mlx")
const outer = @import("./modules/443_outer.mlx")

const BYTES = [6]u8{ 10, 20, 30, 40, 50, 60 }
const GRID = [2][3]u8{ [3]u8{ 1, 2, 3 }, [3]u8{ 4, 5, 6 } }
const Limits = struct { low: i32, high: i32, steps: [3]u8 }
const LIMITS = Limits.{ .low = -4, .high = 9, .steps = [3]u8{ 7, 8, 9 } }

const Record = struct {
    bytes: [4]u8
    count: usize

    // Through a `*Self` the array is writable.
    fn clear(self: *Self) -> void { fill(self.*.bytes[0..], 0) }

    // Through a `*const Self` its slice is a `[]const u8`.
    fn total(self: *const Self) -> usize { return sum(self.*.bytes[0..]) }

    // Taken by value: a `[]const u8` again.
    fn head(self: Self) -> usize { return sum(self.bytes[0..2]) }
}

fn fill(into: []u8, value: u8) -> void {
    var k: usize = 0
    while k < into.length {
        into[k] = value
        k += 1
    }
}

fn sum(values: []const u8) -> usize {
    var total: usize = 0
    for value in values { total += @intCast(usize, value) }
    return total
}

fn whole() -> [6]u8 { return BYTES }

// The slice of a by-value parameter reads the argument.
fn middle(values: [6]u8) -> usize { return sum(values[2..5]) }

// What a callee changes of a by-value array is a copy of its own: the
// copy's slices are writable, the parameter's are not, and the caller's
// array stays as it was.
fn scrubbed(values: [6]u8) -> usize {
    var own = values
    fill(own[0..], 1)
    const part = own[1..3]
    part[0] = 7
    return sum(own[0..]) * 1000 + sum(values[0..])
}

// An element of a by-value parameter, and a pointer capture over one.
fn lastRow(grid: [2][3]u8) -> usize { return sum(grid[1][0..]) }

fn above(values: [6]u8, limit: u8) -> usize {
    var count: usize = 0
    for *item in values {
        if item.* > limit { count += 1 }
    }
    return count
}

fn overPointer(target: *[6]u8) -> void { fill(target.*[1..3], 5) }

fn readPointer(target: *const [6]u8) -> usize { return sum(target.*[1..3]) }

fn overMany(target: [*]u8) -> void { fill(target[4..6], 6) }

pub fn main() -> u8 {
    // A variable's slice is a `[]u8`: written through, handed to a callee
    // that writes, sliced again.
    var mine = BYTES
    const part = mine[0..4]
    part[1] = 9
    if mine[1] != 9 || BYTES[1] != 20 { return 1 }
    fill(mine[4..], 0)
    if mine[4] != 0 || mine[5] != 0 || mine[3] != 40 { return 2 }
    const deeper = part[2..4]
    deeper[0] = 3
    if mine[2] != 3 { return 3 }
    const writable: []u8 = mine[0..1]
    writable[0] = 1
    if mine[0] != 1 { return 4 }
    // A field of a variable, and through a `*Self`.
    var record = Record.{ .bytes = [4]u8{ 1, 2, 3, 4 }, .count = 4 }
    fill(record.bytes[1..3], 8)
    if record.bytes[0] != 1 || record.bytes[1] != 8 || record.bytes[2] != 8 || record.bytes[3] != 4 { return 5 }
    if record.total() != 21 || record.head() != 9 { return 6 }
    record.clear()
    if record.total() != 0 || record.count != 4 { return 7 }
    // An element of a variable.
    var grid = GRID
    fill(grid[1][0..2], 0)
    if grid[1][0] != 0 || grid[1][1] != 0 || grid[1][2] != 6 || GRID[1][0] != 4 { return 8 }
    // What a mutable pointer points to, a many-item pointer.
    mine = BYTES
    overPointer(&mine)
    if mine[0] != 10 || mine[1] != 5 || mine[2] != 5 || mine[3] != 40 { return 9 }
    const pointer = &mine
    pointer.*[0..1][0] = 2
    if mine[0] != 2 { return 10 }
    overMany(mine[0..].pointer)
    if mine[4] != 6 || mine[5] != 6 { return 11 }
    // A pointer capture over a variable writes its elements.
    for *item in mine { item.* += 1 }
    if mine[0] != 3 || mine[5] != 7 { return 12 }

    // A constant's slice is a `[]const u8` that reads the constant: a
    // module's, another module's, an element and a field of one, a local.
    const view = BYTES[1..4]
    if view.length != 3 || view[0] != 20 || view[2] != 40 || sum(view) != 90 { return 14 }
    const fixed: []const u8 = BYTES[4..]
    if fixed.length != 2 || fixed[1] != 60 || sum(BYTES[0..]) != 210 { return 15 }
    const primes = lib.PRIMES[2..5]
    if primes.length != 3 || primes[0] != 5 || primes[2] != 11 { return 16 }
    if sum(GRID[1][1..]) != 11 || sum(LIMITS.steps[0..2]) != 15 { return 17 }
    const local = [6]u8{ 1, 2, 3, 4, 5, 6 }
    if sum(local[1..]) != 20 || local[1..][0] != 2 { return 18 }
    const constant = Record.{ .bytes = [4]u8{ 5, 6, 7, 8 }, .count = 4 }
    if sum(constant.bytes[2..]) != 15 || constant.total() != 26 || constant.head() != 11 { return 19 }
    // A call's result, what a `*const` pointer points to.
    if sum(whole()[1..3]) != 50 { return 20 }
    if readPointer(&local) != 5 || readPointer(&mine) != 12 { return 21 }
    // A pointer capture over a constant reads it.
    var seen: usize = 0
    for *item in BYTES { seen += @intCast(usize, item.*) }
    if seen != 210 { return 22 }

    // A parameter taken by value: its slice reads the argument, and a
    // callee that changes the array changes a copy of its own.
    var kept = BYTES
    if middle(kept) != 120 || middle(BYTES) != 120 || lastRow(GRID) != 15 { return 23 }
    if above(kept, 30) != 3 || above(BYTES, 55) != 1 { return 24 }
    if scrubbed(kept) != 12210 { return 25 }
    if kept[0] != 10 || kept[1] != 20 || kept[2] != 30 || sum(kept[0..]) != 210 { return 26 }
    if scrubbed(BYTES) != 12210 || sum(BYTES[0..]) != 210 { return 27 }

    // A variable of another module reached through a third is a variable:
    // its slice and a pointer capture over it write it, as an assignment
    // does; the constant beside it reads.
    fill(outer.inner.table[0..2], 9)
    if outer.inner.table[0] != 9 || outer.inner.table[1] != 9 || outer.inner.table[2] != 3 { return 28 }
    for *item in outer.inner.table { item.* += 1 }
    outer.inner.table[3] = 40
    if sum(outer.inner.table[0..]) != 64 || sum(outer.inner.FIXED[1..3]) != 13 { return 29 }
    return 13
}
