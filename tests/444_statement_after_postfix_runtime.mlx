// A line that ends in `p.*` or `p.?` ends its statement, as a line that
// ends in a name or `)` does: the next line's `(` or `[` begins a
// statement, it is no call or index of the value before (the translated
// C++ writes `(unsafe { @ptrCast([*]S, p) })[i] = value` after
// `value = source.*`).
// Exits 13.
const S = extern struct {
    a: i32
    b: i32
}

fn copy(source: *S, out: [*]S) -> void {
    var value: S = undefined
    value = source.*
    (unsafe { @ptrCast([*]S, out) })[1] = value
}

fn first(maybe: ?*S, out: [*]i32) -> void {
    var value: *S = undefined
    value = maybe.?
    (unsafe { @ptrCast([*]i32, out) })[1] = value.*.a
}

pub fn main() -> u8 {
    var two: [2]S = undefined
    var s = S.{ .a = 6, .b = 7 }
    copy(&s, &two)
    var n: [2]i32 = undefined
    first(&s, &n)
    if two[1].a != 6 || two[1].b != 7 { return 1 }
    if n[1] != 6 { return 2 }
    return @intCast(u8, two[1].b + n[1])
}
