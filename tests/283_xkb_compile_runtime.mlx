// std.xkb.compile makes keymaps from an XKB data tree
// (tests/support/xkb/data, as /usr/share/X11/xkb) the way libxkbcommon
// does: the rules give the include strings, included files merge
// (augment keeps a key's levels, replace drops them, defaults such as
// key.type apply to the keys after them, a layout `:2` goes to the second
// group); std.xkb.state follows key presses (Shift held, Caps Lock locked,
// a group toggled, the third level latched); std.xkb.write gives text
// std.xkb.parse reads back to the same keyboard. Exits 13.
const std = @import("std")
const xkb = @import("std.xkb")
const keysym = @import("std.xkb.keysym")
const xkb_parse = @import("std.xkb.parse")
const compile = @import("std.xkb.compile")
const xkb_write = @import("std.xkb.write")
const xkb_state = @import("std.xkb.state")

fn types(state: *xkb_state.State, keycode: u32, expected: []const u8) -> bool {
    var out: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &out) }
    const length = xkb_state.keyUtf8(state, keycode, bytes, 16)
    return std.text.same(bytes[0..length], expected)
}

// Presses and lets go of a key.
fn tap(state: *xkb_state.State, keycode: u32) -> void {
    const pressed = xkb_state.updateKey(state, keycode, true)
    const released = xkb_state.updateKey(state, keycode, false)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var names: keysym.Names = undefined
    if !keysym.init(&names, allocator) { return 1 }
    // Only the test data: no ~/.xkb, no /usr/share/X11/xkb.
    var environment: [3][*]const u8 = undefined
    unsafe {
        environment[0] = @ptrCast([*]const u8, "XKB_CONFIG_ROOT=tests/support/xkb/data\0")
        environment[1] = @ptrCast([*]const u8, "HOME=/nonexistent\0")
        environment[2] = @ptrFromInt([*]const u8, 0)
    }
    var compiler: compile.Compiler = undefined
    unsafe { compile.init(&compiler, allocator, &names, @ptrCast([*][*]const u8, &environment)) }
    const keymap = xkb.create(allocator, &names)

    // us(intl): FOUR_LEVEL by key.type; AE02 augmented (2, @ stay, ² added);
    // LSGT replaced; AC12 is an alias of AD02.
    if !compile.fromNames(&compiler, keymap, "", "", "us", "intl", "") { return 2 }
    if keymap.*.groupCount != 1 || !std.text.same(xkb.groupName(keymap, 0), "English (US, intl.)") { return 3 }
    if keymap.*.keyWidth[11 * xkb.MAX_GROUPS] != 3 || !std.text.same(xkb.typeName(keymap, @intCast(usize, keymap.*.keyTypes[11 * xkb.MAX_GROUPS])), "FOUR_LEVEL") { return 4 }
    var state: xkb_state.State = undefined
    xkb_state.init(&state, keymap)
    if !types(&state, 11, "2") || !types(&state, 94, "|") { return 5 }
    var changed = xkb_state.updateKey(&state, 108, true)
    if xkb_state.depressedMods(&state) != xkb.MOD5 { return 6 }
    if !types(&state, 11, "²") || !types(&state, 24, "ä") || !types(&state, 25, "å") { return 7 }
    changed = xkb_state.updateKey(&state, 50, true)
    if !types(&state, 24, "Ä") || xkb_state.depressedMods(&state) != xkb.MOD5 | xkb.SHIFT { return 8 }
    changed = xkb_state.updateKey(&state, 50, false)
    changed = xkb_state.updateKey(&state, 108, false)
    if xkb_state.depressedMods(&state) != 0 { return 9 }

    // de,ru with Caps Lock switching groups (Shift+Caps Lock locks) and a
    // latched third level on LSGT.
    if !compile.fromNames(&compiler, keymap, "", "", "de,ru", "", "grp:caps_toggle,lv3:lsgt_latch") { return 20 }
    if keymap.*.groupCount != 2 || !std.text.same(xkb.groupName(keymap, 1), "Russian") { return 21 }
    xkb_state.init(&state, keymap)
    if !types(&state, 52, "y") { return 22 }
    tap(&state, 66)
    if xkb_state.effectiveGroup(&state) != 1 || !types(&state, 24, "й") { return 23 }
    tap(&state, 66)
    if xkb_state.effectiveGroup(&state) != 0 { return 24 }
    changed = xkb_state.updateKey(&state, 50, true)
    tap(&state, 66)
    changed = xkb_state.updateKey(&state, 50, false)
    // The augmented Caps_Lock interpretation did not replace LockMods.
    if xkb_state.lockedMods(&state) != xkb.LOCK || !types(&state, 38, "A") { return 25 }
    changed = xkb_state.updateKey(&state, 50, true)
    tap(&state, 66)
    changed = xkb_state.updateKey(&state, 50, false)
    if xkb_state.lockedMods(&state) != 0 || xkb_state.effectiveGroup(&state) != 0 { return 26 }
    tap(&state, 94)
    if xkb_state.latchedMods(&state) != xkb.MOD5 || !types(&state, 24, "@") { return 27 }
    tap(&state, 24)
    if xkb_state.latchedMods(&state) != 0 || !types(&state, 24, "q") { return 28 }
    // The indicator map found its name.
    if keymap.*.ledMapCount != 1 || keymap.*.ledMapIndex[0] != 0 { return 29 }

    // Written and read back: the same keys.
    const text = xkb_write.keymap(keymap, allocator)
    const read = xkb.create(allocator, &names)
    if !xkb_parse.parse(read, text.items[0..text.length]) { return 40 }
    var again: xkb_state.State = undefined
    xkb_state.init(&again, read)
    if read.*.groupCount != 2 || xkb.keycodeOf(read, "AC12") != 25 { return 41 }
    tap(&again, 66)
    if !types(&again, 52, "я") { return 42 }
    // A latch lasts over a group switch, to the next key that types.
    tap(&again, 94)
    tap(&again, 66)
    if xkb_state.latchedMods(&again) != xkb.MOD5 || xkb_state.effectiveGroup(&again) != 0 { return 43 }
    tap(&again, 52)
    if xkb_state.latchedMods(&again) != 0 { return 44 }

    // A layout the data does not have.
    if compile.fromNames(&compiler, keymap, "", "", "nope", "", "") { return 50 }
    if !std.text.same(compile.message(&compiler), "no file symbols/nope") { return 51 }
    return 13
}
