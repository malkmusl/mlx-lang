// Error unions whose payload is more than one word, returned, forwarded and
// unwrapped with `try`: a slice of a local array, an optional slice, a
// tuple holding a slice, and an f32 from a float literal. Older compilers
// carried the tag and one payload word (a slice lost its length) and
// returned the literal's f64 bits as the f32. Loops forever when a check
// fails.
fn fill(into: [*]u8) -> void {
    into[1] = 90
}

fn sliced() ![]const u8 {
    var text: [4]u8 = [_]u8{65, 66, 67, 68}
    fill(&text)
    return text[0..3]
}

fn forwarded() ![]const u8 {
    return sliced()
}

fn maybe(give: bool) !?[]const u8 {
    if give { return "xyz" }
    return null
}

fn pair() !(u32, []const u8) {
    return -> (5, "four")
}

fn half() !f32 {
    return 0.5
}

fn check() !u8 {
    const text = try forwarded()
    if text.length != 3 || text[1] != 90 || text[2] != 67 { return 1 }
    const given = try maybe(true)
    if given == null { return 2 }
    if given.?.length != 3 { return 2 }
    const missing = try maybe(false)
    if missing != null { return 3 }
    const both = try pair()
    const word = both.1
    if both.0 != 5 || word.length != 4 || word[3] != 114 { return 4 }
    const value = try half()
    if value != 0.5 { return 5 }
    return 13
}

pub fn main() !void {
    const result = try check()
    while result != 13 {}
}
