// A narrow signed value that an `if` or `match` expression made, or a
// `for` loop took from an array, comes back sign-extended like any other
// load of it: the result slot used to be loaded as an unsigned 32-bit
// word, so a negative i32 a function returned from an `if` was a large
// positive number to the caller's arithmetic (a sum of two samples of
// -100 compared as positive; mixed sound clipped). Exits 13.
const std = @import("std")

fn sample(bytes: [*]const u8, at: usize) -> i32 {
    const value = @intCast(i32, bytes[at]) | (@intCast(i32, bytes[at + 1]) << 8)
    return if value >= 32768 { value - 65536 } else { value }
}

fn signOf(code: u8) -> i32 {
    return match code { 0 => -1, 1 => 0, else => 1 }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var bytes: [4]u8 = [4]u8{ 156, 255, 200, 255 }
    var pointer: [*]const u8 = undefined
    unsafe { pointer = @ptrCast([*]const u8, &bytes) }
    const sum = sample(pointer, 0) + sample(pointer, 2)
    if sum >= 0 { return 1 }
    if sum != -156 { return 2 }
    const wide: i64 = @intCast(i64, sample(pointer, 0))
    if wide != -100 { return 3 }
    if signOf(0) + signOf(0) != -2 { return 4 }
    var values: [3]i32 = [3]i32{ -5, 7, -9 }
    var total: i64 = 0
    for value in values { total += @intCast(i64, value) }
    if total != -7 { return 5 }
    return 13
}
