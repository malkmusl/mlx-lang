// `unsafe { expression }` where a value is wanted: the expression's value,
// with unsafe operations allowed in it, in a binding with and without a
// type, in an inline function, a return, and a compound assignment.
// Before it, a value made by an unsafe operation was declared undefined
// and set in an unsafe block on the next line. Exits 13 when every check
// holds, else the number of the first check that failed.
const Pair = struct { low: u32, high: u32 }

inline fn lowOf(word: *u64) -> u32 { return unsafe { @ptrCast(*Pair, word).*.low } }

fn first(bytes: []const u8) -> u8 {
    const pointer: [*]const u8 = unsafe { @ptrCast([*]const u8, bytes) }
    return pointer[0]
}

pub fn main() -> u8 {
    var word: u64 = 4294967298
    const pair: *Pair = unsafe { @ptrCast(*Pair, &word) }
    if pair.*.low != 2 || pair.*.high != 1 { return 1 }
    if lowOf(&word) != 2 { return 2 }
    if first("xyz") != 120 { return 3 }
    const address = unsafe { @intFromPtr(&word) }
    const back: *u64 = unsafe { @ptrFromInt(*u64, address) }
    if back.* != 4294967298 { return 4 }
    const scaled: f32 = unsafe { 1.5 }
    if scaled != 1.5 { return 5 }
    var total: usize = 0
    total += unsafe { @intCast(usize, pair.*.high) }
    if total != 1 { return 6 }
    return 13
}
