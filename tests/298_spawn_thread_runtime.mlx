// The thread builtins (spec atomics-tls.xml, <Threads>): @threadPointer
// reads the thread pointer (x86_64: the word at fs:0, the thread control
// block's own address as the TLS ABI keeps it; aarch64: TPIDR_EL0), and
// @spawnThread starts a thread with clone on a stack of the program's own:
// the child calls the entry with its argument and exits with the result,
// the parent gets the child's id. A static program (no C library) sets its
// own thread pointer first (arch_prctl), and gives the child one with
// CLONE_SETTLS; CLONE_CHILD_CLEARTID and a futex join it. Exits 13 on
// success.
const bootstrap = @import("../std/bootstrap/root.mlx")
const linux = bootstrap.linux
const thread = linux.thread

const Shared = struct { counter: u32, childPointer: usize, argument: usize, childTid: u32, parentTid: u32 }

const SYS_arch_prctl: usize = 158
const ARCH_SET_FS: usize = 4098
const STACK_SIZE: usize = 65536

var tcb: [8]usize = undefined
var childTcb: [8]usize = undefined
var shared: Shared = undefined

// The child's entry: it sees its own thread pointer and its argument, and
// counts on the shared word.
fn worker(argument: usize) -> usize {
    var state: *Shared = undefined
    unsafe { state = @ptrFromInt(*Shared, argument) }
    state.*.argument = argument
    state.*.childPointer = @threadPointer()
    const before = @atomicRmw(u32, @ptrCast(*u32, &state.*.counter), add, 5, seq_cst)
    return 7
}

// The kernel clears childTid when the child exits and wakes the word's
// waiters as a shared futex, so the wait is a shared one too (a private
// waiter would sleep on).
fn join() -> void {
    while true {
        const seen = @atomicLoad(u32, @ptrCast(*u32, &shared.childTid), acquire)
        if seen == 0 { break }
        const waited = thread.futexWait(@ptrCast(*u32, &shared.childTid), seen, 0, false)
    }
}

fn spawn(top: usize) -> isize {
    const flags = thread.CLONE_VM | thread.CLONE_FS | thread.CLONE_FILES | thread.CLONE_SIGHAND | thread.CLONE_THREAD | thread.CLONE_SYSVSEM | thread.CLONE_SETTLS | thread.CLONE_PARENT_SETTID | thread.CLONE_CHILD_CLEARTID | thread.CLONE_CHILD_SETTID
    // The kernel writes the child's id into childTid before the child
    // runs, and clears it when the child exits: 1 until then.
    shared.childTid = 1
    shared.parentTid = 0
    return @spawnThread(flags, top, @intFromPtr(&shared.parentTid), @intFromPtr(&shared.childTid), @intFromPtr(&childTcb), worker, @intFromPtr(&shared))
}

pub fn main() -> u8 {
    tcb[0] = @intFromPtr(&tcb)
    if linux.syscall2(SYS_arch_prctl, ARCH_SET_FS, @intFromPtr(&tcb)) != 0 { return 1 }
    if @threadPointer() != @intFromPtr(&tcb) { return 2 }
    childTcb[0] = @intFromPtr(&childTcb)
    // The child's stack: 64 KiB, mapped (MAP_PRIVATE | MAP_ANONYMOUS).
    const mapped = linux.syscall6(linux.SYS_mmap, 0, STACK_SIZE, 3, 34, 18446744073709551615, 0)
    if mapped < 0 { return 3 }
    const top = @intCast(usize, mapped) + STACK_SIZE
    shared.counter = 1
    shared.childPointer = 0
    shared.argument = 0
    const tid = spawn(top)
    if tid <= 0 { return 4 }
    join()
    if shared.counter != 6 { return 5 }
    if shared.childPointer != @intFromPtr(&childTcb) { return 6 }
    if shared.argument != @intFromPtr(&shared) { return 7 }
    if @intCast(isize, shared.parentTid) != tid { return 8 }
    // The parent's thread pointer is its own still.
    if @threadPointer() != @intFromPtr(&tcb) { return 9 }
    // The same stack again, now that the first child is gone.
    const second = spawn(top)
    if second <= 0 { return 10 }
    join()
    if shared.counter != 11 { return 11 }
    if second == tid { return 12 }
    const unmapped = linux.syscall2(linux.SYS_munmap, @intCast(usize, mapped), STACK_SIZE)
    return 13
}
