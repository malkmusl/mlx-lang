// A moved by-value parameter owns the automatic deinitialization obligation.
const OwnedCounter = @noncopy(struct) {
    counter: *u8

    fn deinit(self: *Self) -> void {
        self.*.counter.* += 1
    }
}

fn consume(value: OwnedCounter) -> u8 {
    return 7
}

fn main() -> u8 {
    var drops: u8 = 0
    const source = OwnedCounter.{ .counter = &drops }
    const ignored = consume(@move(source))
    return drops
}
