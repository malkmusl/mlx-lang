// A Radeon's TMDS output given another mode while the system runs
// (projects/brix/kernel/gpu_change.mlx, built for the host, with
// gpu_mode.mlx's plan and gpu_set.mlx's carrying out as they are), on a
// card that is a table and a ROM whose tables write down what they were
// told (tests/support/tmds_card.mlx: the fixtures of tests 474 and 475).
//
// The machine is the user's kind after its boot: the firmware's 1280x960
// left by DVI signalling, the monitor's own mode (3840x1080, HDMI) set
// by the boot's mode set, its picture 5 MiB into the aperture. From
// there:
// - the modes judged, nothing written and no table run for it: one the
//   output carries, the one that runs, another rate of the size that
//   runs, one that is more than the output carries (with its most), one
//   that is less than it sends;
// - from the monitor's own mode to another the monitor offers (1920x1080
//   at 60 Hz): write for write and table run for table run what the mode
//   set of a boot does from that state for that timing (the same plan
//   carried out without this file: the two lists of writes, the tables'
//   blocks among them, are the same), the new picture behind the one
//   shown; every other processor held before the first write and let go
//   after the last;
// - and back to the mode before, by the timing the plan read from the
//   controller's words (the way a mode without a timing of its own, the
//   firmware's, comes back): the same writes as a boot's mode set for
//   that timing but for where the picture is, which is the aperture's
//   start now (the picture shown lies beyond it): the picture's two
//   places in turn, however often the mode changes;
// - a mode the output does not carry refused with nothing written, no
//   table run and nobody held; a card whose ROM is not open; an output
//   that is no TMDS one;
// - a failure in the middle, at every table's run in turn and at writes
//   that do not hold: the mode before is back (every register the
//   display has as before the change), said so, and what the driver
//   knows of the picture is unchanged; a failure that is not known to be
//   back said as that;
// - the user's machine as it is today, the monitor's HDMI block not read:
//   the monitor's own mode by HDMI signalling, 1920x1080 by DVI
//   signalling, and back: the signalling changing with the mode;
// - the plan made from what the card runs at the moment of the change:
//   the card made to run something else behind the driver's back after
//   its last change, the next change's mode before is what the card ran
//   then, not what the driver read last;
// - on every path: as often as everything else was held it was let go,
//   and no write lies outside.
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const dm = @import("../projects/brix/kernel/display_modes.mlx")
const changing = @import("../projects/brix/kernel/gpu_change.mlx")
const rom = @import("./support/atom_rom.mlx")
const card = @import("./support/tmds_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn logWrite(text: []const u8) -> void {
    card.logWrite(text)
    if show { say(text) }
}

var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined

// ---- Everything else held and let go: counted, with how many writes the
// card had seen at each.
var holds: usize = 0
var releases: usize = 0
var heldAt: usize = 0
var releasedAt: usize = 0
var deaf: usize = 0
var asides: usize = 0

fn hold() -> usize {
    holds += 1
    heldAt = card.written
    return deaf
}

fn release() -> void {
    releases += 1
    releasedAt = card.written
}

fn aside(on: bool) -> void { asides += 1 }

var seen: changing.Seen = undefined
var lentTables: set.Tables = undefined

fn lend(withRom: bool) -> changing.Lent {
    var facts = mode.Rom.{ .machine = null, .board = null, .firmware = null }
    var tables: ?*const set.Tables = null
    if withRom {
        facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
        lentTables = set.Tables.{ .machine = &machine, .hands = card.hands(), .aside = card.setAside }
        tables = &lentTables
    }
    return changing.Lent.{ .card = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }, .hands = set.Hands.{ .write = card.write, .clear = card.clear }, .tables = tables, .rom = facts, .hold = hold, .release = release, .aside = aside }
}

// ---- The timings.
fn timing(clock: usize, width: usize, hTotal: usize, hFront: usize, hSync: usize, hPositive: bool, height: usize, vTotal: usize, vFront: usize, vSync: usize, vPositive: bool) -> edid.Timing {
    return edid.Timing.{ .clock = clock, .width = width, .hTotal = hTotal, .hFront = hFront, .hSync = hSync, .hPositive = hPositive, .height = height, .vTotal = vTotal, .vFront = vFront, .vSync = vSync, .vPositive = vPositive, .interlaced = false, .stereo = false }
}

// The monitor's own (as in tests/474), 1920x1080 and 1280x720 at 60 Hz
// (the standards' timings), 3840x2160 at 60 Hz (594 MHz), the monitor's
// own size at 120 Hz, and a timing of 20 MHz.
fn own() -> edid.Timing { return timing(266640, 3840, 4000, 48, 32, true, 1080, 1111, 3, 10, false) }
fn fullHd() -> edid.Timing { return timing(148500, 1920, 2200, 88, 44, true, 1080, 1125, 4, 5, true) }
fn hd() -> edid.Timing { return timing(74250, 1280, 1650, 110, 40, true, 720, 750, 5, 5, true) }
fn uhd() -> edid.Timing { return timing(594000, 3840, 4400, 176, 88, true, 2160, 2250, 8, 10, true) }
fn ownFast() -> edid.Timing { return timing(533280, 3840, 4000, 48, 32, true, 1080, 1111, 3, 10, false) }
fn slow() -> edid.Timing { return timing(20000, 640, 800, 16, 96, false, 480, 417, 10, 2, false) }

fn hdmiMonitor() -> edid.Offer {
    var o = edid.nothing()
    o.hdmi = true
    o.extensions = 1
    o.given = 1
    return o
}

// The user's monitor as their firmware passes it on: an extension block
// named and not given, so that its HDMI block is not read.
fn firstBlockAlone() -> edid.Offer {
    var o = edid.nothing()
    o.extensions = 1
    o.given = 0
    return o
}

// What the monitor's EDID says of HDMI on the machine `booted` makes.
var said: edid.Offer = undefined

// ---- The card's state kept and put back (between a change and the same
// change made the boot's way).
var keptRegisters: [card.ROOM]usize = undefined
var keptMarks: [24]usize = undefined
var keptPll: [6]usize = undefined
var keptClock: usize = 0

fn keep() -> void {
    var k: usize = 0
    while k < card.ROOM {
        keptRegisters[k] = card.registers[k]
        k += 1
    }
    k = 0
    while k < 24 {
        keptMarks[k] = card.marks[k]
        k += 1
    }
    k = 0
    while k < 6 {
        keptPll[k] = card.pll[k]
        k += 1
    }
    keptClock = card.clock
}

fn putBack() -> void {
    var k: usize = 0
    while k < card.ROOM {
        card.registers[k] = keptRegisters[k]
        k += 1
    }
    k = 0
    while k < 24 {
        card.marks[k] = keptMarks[k]
        k += 1
    }
    k = 0
    while k < 6 {
        card.pll[k] = keptPll[k]
        k += 1
    }
    card.clock = keptClock
    card.forget()
}

// Whether every register of the display holds what it held when the
// state was kept (not the tables' mail, nor the bits that are the card's
// own answers: tests/474 says which).
fn asKept() -> bool {
    var k: usize = 0
    while k < card.ROOM {
        var answers: usize = 0
        if k >= 0x321 && k < 0x327 { answers = 0x10 }
        if k == 0x1A11 || k == 0x1C11 || k == 0x1E11 { answers = 0x4 }
        if (card.registers[k] ^ keptRegisters[k]) & ~answers != 0 && (k < card.MAIL || k > card.ANSWER) {
            if show {
                const out = scanout.Card.{ .read = card.read, .now = card.now, .write = say }
                say("differs: ")
                out.hexDigits(k, 4)
                say(" ")
                out.hexDigits(card.registers[k], 8)
                say(" was ")
                out.hexDigits(keptRegisters[k], 8)
                say("\n")
            }
            return false
        }
        k += 1
    }
    k = 0
    while k < 24 {
        if card.marks[k] != keptMarks[k] { return false }
        k += 1
    }
    return true
}

// ---- The same change the boot's way: the card read out, the plan made
// for the timing as for a monitor's own, carried out; its writes kept.
var refPlan: mode.Plan = undefined
var refReadout: scanout.Readout = undefined
var refResult: set.Result = undefined
var refTo: [card.WRITES]usize = undefined
var refWith: [card.WRITES]usize = undefined
var refByTable: [card.WRITES]bool = undefined
var refWritten: usize = 0
var refRuns: usize = 0

fn reference(t: *const edid.Timing) -> bool {
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    const hands = set.Hands.{ .write = card.write, .clear = card.clear }
    const lent = set.Tables.{ .machine = &machine, .hands = card.hands(), .aside = card.setAside }
    var memory = seen.memory
    const monitor = edid.Monitor.{ .state = edid.State.found, .width = t.*.width, .height = t.*.height, .timing = t.*, .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.none }
    var offer = seen.offer
    offer.count = 0
    card.forget()
    scanout.report(&out, &memory, &refReadout)
    mode.makeFor(&out, &refReadout, &memory, &monitor, &offer, &facts, mode.Wish.own, &refPlan)
    const done = set.attemptWith(&out, &hands, &lent, &refPlan, true, &refResult)
    refWritten = card.written
    refRuns = card.runs
    var k: usize = 0
    while k < card.written && k < card.WRITES {
        refTo[k] = card.writtenTo[k]
        refWith[k] = card.writtenWith[k]
        refByTable[k] = card.writtenByTable[k]
        k += 1
    }
    return done
}

// Whether the card saw the writes the reference made, one for one; with
// `elsewhere`, but for the surface's address words (controller 0's:
// 0x1A04 and 0x1A05), which hold `address` here.
fn sameWrites(elsewhere: bool, address: usize) -> bool {
    if card.written != refWritten || card.runs != refRuns {
        differs(card.WRITES)
        return false
    }
    var k: usize = 0
    while k < card.written && k < card.WRITES {
        const surface = elsewhere && !refByTable[k] && (refTo[k] == 0x1A04 || refTo[k] == 0x1A05)
        if card.writtenTo[k] != refTo[k] || card.writtenByTable[k] != refByTable[k] || card.writtenWith[k] != (if surface { address } else { refWith[k] }) {
            differs(k)
            return false
        }
        k += 1
    }
    return true
}

// (With an argument: where the two lists part.)
fn differs(at: usize) -> void {
    if !show { return }
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = say }
    out.field("the writes differ: ", card.written)
    out.field(" here, ", refWritten)
    out.field(" the boot's way; table runs ", card.runs)
    out.field(" and ", refRuns)
    if at < card.WRITES {
        out.field("; write ", at)
        out.fieldHex(" is ", card.writtenTo[at])
        out.fieldHex(" = ", card.writtenWith[at])
        out.fieldHex(", the boot's way ", refTo[at])
        out.fieldHex(" = ", refWith[at])
    }
    say("\n")
}

// The user's machine after its boot: the firmware's 1280x960, then the
// monitor's own mode set by the boot's mode set; and what the driver
// knows from then on.
fn booted(name: []const u8) -> void {
    card.reset()
    if show {
        say("-- ")
        say(name)
        say("\n")
    }
    card.firmware(0, 4, 4, false, 2, 107962)
    changing.begin(&seen)
    seen.offer = said
    seen.memory = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
    const t = own()
    expect(reference(&t), "the boot's mode set for the monitor's own mode")
    seen.memory.pictureOffset = refPlan.offset
    seen.memory.pictureBytes = refPlan.bytes
    seen.memory.pictureWidth = refPlan.width
    seen.memory.pictureHeight = refPlan.height
    seen.memory.picturePitch = refPlan.pitch
    card.forget()
    card.logged = 0
    holds = 0
    releases = 0
    deaf = 0
    const lent = lend(true)
    changing.look(&lent, &seen)
}

fn judged(t: *const edid.Timing, withRom: bool) -> dm.Mode {
    var asked = dm.timedMode(t, dm.Source.DETAILED)
    const lent = lend(withRom)
    changing.judge(&lent, &seen, &asked)
    return asked
}

fn judging() -> void {
    booted("the modes judged")
    expect(changing.tmds(&seen) && changing.rate(&seen) >= 59900 && changing.rate(&seen) <= 60100 && seen.memory.pictureOffset == 0x500000, "after the boot: a TMDS output running the monitor's own mode at 60 Hz, its picture 5 MiB into the aperture")
    var t = fullHd()
    expect(judged(&t, true).why == dm.Why.NONE, "1920x1080 at 60 Hz can be set")
    t = hd()
    expect(judged(&t, true).why == dm.Why.NONE, "1280x720 at 60 Hz can be set")
    t = own()
    expect(judged(&t, true).why == dm.Why.NONE, "the mode that runs has nothing against it")
    t = ownFast()
    expect(judged(&t, true).why == dm.Why.SAME_SIZE, "another rate of the size that runs is not this driver's to set")
    t = uhd()
    var m = judged(&t, true)
    expect(m.why == dm.Why.TOO_FAST && m.limit == 299999, "3840x2160 at 60 Hz is more than the output carries, 299999 kHz at most")
    t = slow()
    m = judged(&t, true)
    expect(m.why == dm.Why.TOO_SLOW, "a timing of 20 MHz is less than the output sends")
    t = fullHd()
    expect(judged(&t, false).why == dm.Why.CARD, "without the card's ROM no mode can be set")
    expect(card.written == 0 && card.runs == 0 && card.cleared == 0 && holds == 0 && releases == 0, "judging writes nothing, runs no table and holds nobody")
}

fn thereAndBack() -> void {
    // The reference: the boot's way from the monitor's own mode to
    // 1920x1080, on a card put back afterwards.
    booted("from the monitor's own mode to 1920x1080 and back")
    var t = fullHd()
    keep()
    expect(reference(&t) && refPlan.situation == mode.Situation.tmds && refRuns != 0 && refWritten > refRuns, "the boot's mode set makes that change")
    const there = refWritten
    putBack()
    card.logged = 0
    var asked = dm.timedMode(&t, dm.Source.STANDARD)
    const lent = lend(true)
    var picture = dm.Picture.{ .address = 0, .width = 0, .height = 0, .pitch = 0 }
    expect(changing.change(&lent, &seen, &asked.timing) == dm.Set.done, "the change to 1920x1080 at 60 Hz is made")
    expect(sameWrites(false, 0), "write for write and table run for table run what a boot's mode set does for that timing")
    expect(holds == 1 && releases == 1 && heldAt == 0 && releasedAt == card.written && card.written == there, "everything else held before the first write and let go after the last")
    expect(seen.plan.width == 1920 && seen.plan.height == 1080 && seen.plan.offset == 0x1500000 && seen.plan.pitch == 1920, "the new picture behind the one that was shown")
    expect(card.cleared == 1 && card.clearedAt == 0x1500000 && card.clearedBytes == 1920 * 4 * 1080 && !card.writtenBeforeClear, "its memory cleared before the first write")
    expect(seen.memory.pictureOffset == 0x1500000 && seen.memory.pictureWidth == 1920 && seen.memory.pictureHeight == 1080 && seen.memory.pictureBytes == 1920 * 4 * 1080, "the kernel's picture is the new one")
    const c = &seen.readout.controllers[0]
    expect(seen.readout.on == 1 && c.*.width == 1920 && c.*.height == 1080 && c.*.hTotal == 2200 && c.*.vTotal == 1125 && changing.tmds(&seen), "the card read anew runs 1920x1080 of 2200 by 1125")
    expect(seen.wasThere && seen.was.width == 3840 && seen.was.height == 1080 && seen.was.hTotal == 4000 && seen.was.vTotal == 1111 && seen.was.clock == 266640, "the mode before, as the controller's words had it")
    expect(seen.stood != 0 && seen.deaf == 0, "how long everything stood still is known")
    line("gpu: the display's mode is changed while the system runs: asked for is 1920x1080 at 60.00 Hz: pixel clock 148500 kHz, h 1920 2200 (front 88 sync 44 +), v 1080 1125 (front 4 sync 5 +)\n")
    line("gpu: in the lines that follow, \"the monitor's own mode\" is the mode asked for and \"the firmware's state\" is the mode that runs now\n")
    line("gpu: every other processor stood still for the change, ")
    line("the monitor's own mode is set (")
    _ = picture
    // The mode that runs now judged again, and the one before.
    expect(judged(&t, true).why == dm.Why.NONE, "the mode that runs now has nothing against it")
    t = own()
    expect(judged(&t, true).why == dm.Why.NONE, "the monitor's own mode can be set again")

    // Back, by the timing the plan read from the controller's words (a
    // mode handed over without a timing): the boot's way for that timing
    // is the reference, which would put the picture further up; here it
    // is the aperture's start.
    const before = dm.sizeOnly(3840, 1080, 60000, dm.Source.RUNNING)
    const was = seen.was
    keep()
    expect(reference(&was) && refPlan.offset == 0x1D00000, "the boot's mode set would put the picture further up the aperture")
    putBack()
    card.logged = 0
    expect(changing.back(&lent, &seen, &before) == dm.Set.done, "the mode before put back")
    expect(seen.plan.offset == 0 && seen.plan.width == 3840 && seen.plan.height == 1080, "its picture at the aperture's start: the one shown lies beyond it")
    expect(sameWrites(true, 0), "the same writes and table runs as a boot's mode set for that timing, but for where the picture is")
    expect(card.cleared == 1 && card.clearedAt == 0 && card.clearedBytes == 3840 * 4 * 1080, "the new picture's memory cleared, not the one shown")
    expect(holds == 2 && releases == 2 && heldAt == 0 && releasedAt == card.written, "held and let go again")
    expect(seen.readout.controllers[0].width == 3840 && seen.readout.controllers[0].hTotal == 4000 && seen.memory.pictureOffset == 0 && seen.was.width == 1920, "the monitor's own mode runs again; the mode before is 1920x1080 now")

    // And on: to 1280x720 (behind the picture shown, which is at the
    // start), back by the monitor's own timing (the start is taken: no;
    // the picture shown lies beyond: yes).
    t = hd()
    expect(changing.change(&lent, &seen, &t) == dm.Set.done && seen.plan.offset == 0x1000000, "to 1280x720: behind the picture shown")
    t = own()
    const mine = dm.timedMode(&t, dm.Source.DETAILED)
    expect(changing.back(&lent, &seen, &mine) == dm.Set.done && seen.plan.offset == 0 && seen.readout.controllers[0].width == 3840, "back by the monitor's own timing: at the start again")
    t = fullHd()
    expect(changing.change(&lent, &seen, &t) == dm.Set.done && seen.plan.offset == 0x1000000, "and to 1920x1080: the same second place as before, not further up")
    expect(holds == 5 && releases == 5, "five changes, five times held and let go")
}

fn refused() -> void {
    booted("a mode the output does not carry")
    var t = uhd()
    const lent = lend(true)
    keep()
    expect(changing.change(&lent, &seen, &t) == dm.Set.refused, "3840x2160 at 60 Hz is refused")
    expect(card.written == 0 && card.runs == 0 && card.cleared == 0 && holds == 0 && releases == 0 && asKept(), "nothing written, no table run, nobody held")
    line("gpu: the mode asked for is not set, the mode that runs stays: no timing of the monitor's size fits the link: the monitor's own needs 594000 kHz, this output carries 299999 kHz at most (HDMI below 300 MHz: the card's ROM does not say more for this output)\n")
    expect(seen.memory.pictureOffset == 0x500000 && seen.memory.pictureWidth == 3840, "the kernel's picture is the one that was")

    // A card whose ROM is not open (none of its tables is lent).
    const bare = lend(false)
    t = fullHd()
    card.logged = 0
    expect(changing.change(&bare, &seen, &t) == dm.Set.refused && card.written == 0 && card.runs == 0 && holds == 0, "without the card's ROM nothing is set and nothing written")
    line("gpu: the mode asked for is not set, the mode that runs stays: ")

    // An output that is no TMDS one: the back end's mode made
    // DisplayPort's.
    booted("an output that is not TMDS")
    card.registers[scanout.DIG[4] + 0x47] = card.registers[scanout.DIG[4] + 0x47] & ~@intCast(usize, 0x70000)
    const other = lend(true)
    changing.look(&other, &seen)
    expect(!changing.tmds(&seen), "a DisplayPort output is told from a TMDS one")
    var m = judged(&t, true)
    expect(m.why == dm.Why.OUTPUT, "its modes are judged as another kind of output's")
    card.forget()
    expect(changing.change(&other, &seen, &t) == dm.Set.refused && card.written == 0 && card.runs == 0 && holds == 0 && releases == 0, "a change on it is refused with nothing written")
}

fn failures() -> void {
    // Each table's run of the change stopped by the card in turn: the
    // mode before is back.
    booted("how many tables a change runs")
    var t = fullHd()
    var lent = lend(true)
    expect(changing.change(&lent, &seen, &t) == dm.Set.done, "the change, with nothing wrong")
    const runs = seen.result.runs
    expect(runs >= 5, "a change runs the card's tables")
    var k: usize = 0
    while k < runs {
        booted("a table's run stopped by the card")
        lent = lend(true)
        keep()
        card.refuseRun = k
        const result = changing.change(&lent, &seen, &t)
        card.refuseRun = card.NEVER
        expect(result == dm.Set.back, "a table stopped by the card: the mode before is back")
        expect(asKept(), "every register of the display as before the change")
        expect(holds == 1 && releases == 1 && heldAt == 0 && releasedAt == card.written, "held and let go though it failed")
        expect(seen.memory.pictureOffset == 0x500000 && seen.memory.pictureWidth == 3840 && !seen.wasThere, "what the driver knows of the picture is unchanged")
        line("gpu: the change failed and the mode that ran before it runs again\n")
        // And the card is one a change can be made on again.
        expect(changing.change(&lent, &seen, &t) == dm.Set.done && seen.readout.controllers[0].width == 1920 && holds == 2 && releases == 2, "and the same change made afterwards holds")
        k += 1
    }
    // Writes of the driver's own that do not hold.
    const spoiled = [_]usize{ 0, 3, 11, 20, 33, 47 }
    for at in spoiled {
        booted("a write that does not hold")
        lent = lend(true)
        keep()
        card.spoilAt = at
        card.spoilBit = 0x1
        const result = changing.change(&lent, &seen, &t)
        card.spoilAt = card.NEVER
        expect(result == dm.Set.back || result == dm.Set.done, "a write that does not hold: the mode before is back (or the bit was none the step looks at)")
        if result == dm.Set.back {
            expect(asKept() && seen.memory.pictureOffset == 0x500000, "the registers and the picture as before")
        }
        expect(holds == releases && holds == 1 && releasedAt == card.written, "held and let go")
    }
    // A PLL that takes the new clock and not the old one again: the way
    // back cannot show that the mode before is back.
    booted("a way back that is not known to have come back")
    lent = lend(true)
    card.clockRuns = 0
    card.clockDeafFrom = 1
    card.transmitterDeaf = true
    const result = changing.change(&lent, &seen, &t)
    card.clockDeafFrom = card.NEVER
    card.transmitterDeaf = false
    expect(result == dm.Set.lost, "a change that fails and whose way back fails too is said to be lost")
    expect(holds == 1 && releases == 1 && releasedAt == card.written, "held and let go on that path too")
    line("gpu: the change failed, and the mode that ran before it is not known to be back\n")

    // Processors that did not say they stand still: said, and the change
    // is made.
    booted("processors that did not answer")
    lent = lend(true)
    deaf = 2
    expect(changing.change(&lent, &seen, &t) == dm.Set.done && seen.deaf == 2, "the change is made all the same")
    line(" (2 did not say within a fifth of a second that they stood still)\n")
    deaf = 0
}

// The user's machine as it is today: the monitor's HDMI block is not read
// (its firmware passes on the EDID's first block alone), so the monitor's
// own mode, which a DVI link does not carry, is sent with HDMI signalling
// by the plan's own inference, and a mode a DVI link carries with DVI
// signalling: the signalling changes with the mode, both ways.
fn firstBlock() -> void {
    said = firstBlockAlone()
    booted("the monitor's HDMI block not read: HDMI to DVI and back")
    expect(refPlan.tmds.hdmi && refPlan.tmds.inferred && !refPlan.tmds.hdmiNow, "at boot: taken to be an HDMI monitor, HDMI signalling for its own mode")
    var t = fullHd()
    const lent = lend(true)
    expect(judged(&t, true).why == dm.Why.NONE, "1920x1080 at 60 Hz can be set")
    t = uhd()
    var m = judged(&t, true)
    expect(m.why == dm.Why.TOO_FAST && m.limit == 299999, "3840x2160 at 60 Hz: more than the output carries")
    t = fullHd()
    keep()
    expect(reference(&t), "the boot's mode set makes the change to 1920x1080")
    putBack()
    card.logged = 0
    expect(changing.change(&lent, &seen, &t) == dm.Set.done && sameWrites(false, 0), "the change to 1920x1080, write for write as a boot's mode set")
    expect(seen.plan.tmds.hdmiNow && !seen.plan.tmds.hdmi && !seen.plan.tmds.inferred, "from HDMI signalling to DVI signalling: a DVI link carries 148.5 MHz, and the monitor is not known to be an HDMI one")
    line("gpu: plan (b, TMDS): DVI signalling at 148500 kHz (now HDMI at ")
    expect(seen.readout.controllers[0].encoder.mode == scanout.MODE_DVI && seen.readout.controllers[0].width == 1920, "the card read anew sends DVI signalling, 1920x1080")
    const before = dm.sizeOnly(3840, 1080, 60000, dm.Source.RUNNING)
    card.logged = 0
    expect(changing.back(&lent, &seen, &before) == dm.Set.done && seen.plan.tmds.hdmi && seen.plan.tmds.inferred && !seen.plan.tmds.hdmiNow, "and back: HDMI signalling again for the monitor's own mode")
    expect(seen.readout.controllers[0].encoder.mode == scanout.MODE_HDMI && seen.readout.controllers[0].width == 3840 && seen.plan.offset == 0, "the card read anew sends HDMI signalling, 3840x1080, the picture at the aperture's start")
    expect(holds == 2 && releases == 2, "held and let go twice")
    said = hdmiMonitor()
}

// The card read anew before each plan: after a change to 1920x1080 the
// card is made to run the monitor's own mode again without the driver
// (its state from before the change put back, and the kernel's picture
// with it, as another part of the kernel could leave them); the change
// to 1280x720 that follows takes its mode before from the card, the
// monitor's own, and the way back would lead there.
fn fromTheCard() -> void {
    booted("the plan made from the card as it is at the change")
    keep()
    const picture = seen.memory
    var t = fullHd()
    const lent = lend(true)
    expect(changing.change(&lent, &seen, &t) == dm.Set.done && seen.readout.controllers[0].width == 1920, "to 1920x1080, read afterwards")
    putBack()
    seen.memory = picture
    card.logged = 0
    t = hd()
    expect(changing.change(&lent, &seen, &t) == dm.Set.done && seen.readout.controllers[0].width == 1280, "to 1280x720")
    expect(seen.was.width == 3840 && seen.was.hTotal == 4000 && seen.was.vTotal == 1111 && seen.was.clock == 266640, "its mode before is what the card ran at the change (the monitor's own), not what was read after the last change (1920x1080)")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    said = hdmiMonitor()
    card.makeRom(&builder, card.NEVER, card.Ending.plain)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
    judging()
    thereAndBack()
    refused()
    failures()
    firstBlock()
    fromTheCard()
    if failed != 0 { return failed }
    return 13
}
