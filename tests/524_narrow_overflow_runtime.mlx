// Checked arithmetic on the integer types narrower than 64 bits traps at
// the type's own bounds, and every result is a value of its type: + - *
// of i8, i16, i32, u8, u16 and u32 (the forms and their compound
// assignments), unary -, and / of a signed type. The register holding a
// narrow value is 64 bits wide and the operation is done on all of it, so
// a sum of two i32 used to keep its 33rd bit: add(2147483647, 201) was
// 2147483848 and compared greater than the i32 maximum, no trap; only the
// unsigned types were checked. Also: the wrapping operators wrap at the
// type's width, the saturating ones of a signed type stop at its bounds
// (i8 100 +| 100 was 200), `x op= y` of a negative x reads x
// sign-extended (a field's x /= 2 was wrong), and a product of 40-bit
// factors that leaves the 64-bit word still traps or saturates.
//
// With no argument: the values in range, then each case of `overflow` in
// a child process, which the trap must end (SIGILL, 128 + 4 as a shell
// reports it; a child whose operation fits exits by itself). With the
// argument `values`: the values alone (tools/aarch64_linux_emulator.py has
// no fork). With a case's number: that case, exiting 0 if it did not trap
// and 2 past the last case (tests/run_narrow_overflow.sh runs every case
// on x86_64 and AArch64). Exits 13 when every check holds, else the number
// of the first check that failed (100 + the case for a case that did not
// trap).
const linux = @import("../std/bootstrap/os/linux.mlx")
const process = linux.process
const arguments_module = @import("../std/bootstrap/process.mlx")

// The operands as the program finds them when it runs (module-level
// variables: the compiler sees no constants).
var i8_max: i8 = 127 // (per run)
var i8_min: i8 = -128 // (per run)
var i8_one: i8 = 1 // (per run)
var i8_minus_one: i8 = -1 // (per run)
var i8_hundred: i8 = 100 // (per run)
var i16_max: i16 = 32767 // (per run)
var i16_min: i16 = -32768 // (per run)
var i16_one: i16 = 1 // (per run)
var i16_minus_one: i16 = -1 // (per run)
var i16_two_hundred: i16 = 200 // (per run)
var i32_max: i32 = 2147483647 // (per run)
var i32_min: i32 = -2147483648 // (per run)
var i32_one: i32 = 1 // (per run)
var i32_minus_one: i32 = -1 // (per run)
var i32_bit16: i32 = 65536 // (per run)
var i32_bit15: i32 = 32768 // (per run)
var u8_max: u8 = 255 // (per run)
var u8_zero: u8 = 0 // (per run)
var u8_one: u8 = 1 // (per run)
var u8_sixteen: u8 = 16 // (per run)
var u16_max: u16 = 65535 // (per run)
var u16_zero: u16 = 0 // (per run)
var u16_one: u16 = 1 // (per run)
var u16_bit8: u16 = 256 // (per run)
var u32_max: u32 = 4294967295 // (per run)
var u32_zero: u32 = 0 // (per run)
var u32_one: u32 = 1 // (per run)
var u32_bit16: u32 = 65536 // (per run)
// (The 40-bit operands are made from these where they are used: a
// module-level variable of 5 bytes is read as 8.)
var bit39: i64 = 549755813888 // (per run)
var bit20: i64 = 1048576 // (per run)
var bit19: i64 = 524288 // (per run)

const Holder = struct {
    small: i16
    word: i32
}

fn passed(value: i16) -> i64 { return @intCast(i64, value) }

const CASES: usize = 34

// Case `k`: an operation whose exact result is outside its type, so none
// of them returns (the result widened to i64, as a later widening would).
// 0 is one that fits; past CASES, 2.
fn overflow(k: usize) -> i64 {
    if k == 0 { return @intCast(i64, i32_max - i32_one + i32_one) }
    if k == 1 { return @intCast(i64, i32_max + @intCast(i32, 201)) }
    if k == 2 { return @intCast(i64, (i32_max - @intCast(i32, 60)) + @intCast(i32, 61)) }
    if k == 3 { return @intCast(i64, i32_min - i32_one) }
    if k == 4 { return @intCast(i64, i32_bit16 * i32_bit15) }
    if k == 5 { return @intCast(i64, i32_min * i32_minus_one) }
    if k == 6 { return @intCast(i64, i16_max + i16_one) }
    if k == 7 { return @intCast(i64, i16_min - i16_one) }
    if k == 8 { return @intCast(i64, i16_two_hundred * i16_two_hundred) }
    if k == 9 { return @intCast(i64, i8_max + i8_one) }
    if k == 10 { return @intCast(i64, i8_min - i8_one) }
    if k == 11 { return @intCast(i64, i8_min * i8_minus_one) }
    if k == 12 { return @intCast(i64, u32_max + u32_one) }
    if k == 13 { return @intCast(i64, u32_zero - u32_one) }
    if k == 14 { return @intCast(i64, u32_bit16 * u32_bit16) }
    if k == 15 { return @intCast(i64, u16_max + u16_one) }
    if k == 16 { return @intCast(i64, u16_zero - u16_one) }
    if k == 17 { return @intCast(i64, u16_bit8 * u16_bit8) }
    if k == 18 { return @intCast(i64, u8_max + u8_one) }
    if k == 19 { return @intCast(i64, u8_zero - u8_one) }
    if k == 20 { return @intCast(i64, u8_sixteen * u8_sixteen) }
    if k == 21 {
        var x = i32_max
        x += i32_one
        return @intCast(i64, x)
    }
    if k == 22 {
        var x = i16_min
        x -= i16_one
        return @intCast(i64, x)
    }
    if k == 23 {
        var x = i8_hundred
        x *= i8_hundred
        return @intCast(i64, x)
    }
    if k == 24 {
        var x = u16_zero
        x -= u16_one
        return @intCast(i64, x)
    }
    if k == 25 { return @intCast(i64, -i32_min) }
    if k == 26 { return @intCast(i64, -i16_min) }
    if k == 27 { return @intCast(i64, -i8_min) }
    if k == 28 { return @intCast(i64, -u8_one) }
    if k == 29 { return @intCast(i64, i32_min / i32_minus_one) }
    if k == 30 { return @intCast(i64, i8_min / i8_minus_one) }
    if k == 31 {
        // Stored into a field, then passed to a call.
        var holder = Holder.{ .small = 0, .word = 0 }
        holder.word = i32_max + i32_one
        return passed(holder.small) + @intCast(i64, holder.word)
    }
    if k == 32 { return passed(i16_max + i16_one) }
    // 2^39 * 2^39 = 2^78: the 64-bit word is 0, which fits a u40 (and an
    // i40).
    if k == 33 {
        const top = @intCast(u40, bit39)
        return @intCast(i64, top * top)
    }
    if k == 34 {
        const least = @intCast(i40, -bit39)
        return @intCast(i64, least * least)
    }
    return 2
}

// The values in range: the edges of every type and operator, compound
// assignments, negation, division, the wrapping and the saturating forms.
fn values() -> u8 {
    // The defect's own sums, one short of overflowing.
    if i32_max - @intCast(i32, 201) + @intCast(i32, 201) != i32_max { return 1 }
    if (i32_max - @intCast(i32, 60)) + @intCast(i32, 60) != 2147483647 { return 2 }
    // Signed edges.
    if (i32_max - i32_one) + i32_one != i32_max || (i32_min + i32_one) - i32_one != i32_min { return 3 }
    if i32_max + i32_min != -1 || i32_max + i32_min >= 0 || @intCast(i64, i32_max + i32_min) != -1 { return 4 }
    if i32_max * i32_one != i32_max || i32_min * i32_one != i32_min || i32_max * i32_minus_one != i32_min + i32_one { return 5 }
    if i32_bit16 * (i32_bit15 - i32_one) != 2147418112 || i32_bit16 * -i32_bit15 != i32_min { return 6 }
    if (i16_max - i16_one) + i16_one != i16_max || (i16_min + i16_one) - i16_one != i16_min || i16_max * i16_minus_one != i16_min + i16_one { return 7 }
    if (i8_max - i8_one) + i8_one != i8_max || (i8_min + i8_one) - i8_one != i8_min || i8_max * i8_minus_one != i8_min + i8_one { return 8 }
    if @intCast(i64, i8_min + i8_one) != -127 || @intCast(i64, i16_min + i16_one) != -32767 { return 9 }
    // Unsigned edges.
    if (u32_max - u32_one) + u32_one != u32_max || u32_one - u32_one != 0 || u32_bit16 * (u32_bit16 - u32_one) != 4294901760 { return 10 }
    if (u16_max - u16_one) + u16_one != u16_max || u16_one - u16_one != 0 || @intCast(u16, 255) * @intCast(u16, 257) != u16_max { return 11 }
    if (u8_max - u8_one) + u8_one != u8_max || u8_one - u8_one != 0 || @intCast(u8, 15) * @intCast(u8, 17) != u8_max { return 12 }
    // Compound assignments, a negative value among them.
    var x: i32 = -5
    x += i32_one
    if x != -4 || x >= 0 { return 13 }
    x -= i32_max - @intCast(i32, 4)
    if x != i32_min + i32_one { return 14 }
    x *= i32_one
    x -= i32_one
    if x != i32_min || @intCast(i64, x) != -2147483648 { return 15 }
    var small: i8 = -100
    small += i8_minus_one
    small *= i8_one
    if small != -101 || small > 0 { return 16 }
    var count: u16 = 65534
    count += u16_one
    if count != u16_max { return 17 }
    // Negation and division.
    if -i32_max != i32_min + i32_one || -i8_max != i8_min + i8_one || -i16_max != i16_min + i16_one { return 18 }
    if -u8_zero != 0 || -u32_zero != 0 { return 19 }
    if i32_min / i32_one != i32_min || i32_min / @intCast(i32, -2) != 1073741824 || i8_min / @intCast(i8, 2) != -64 { return 20 }
    if i32_min % i32_minus_one != 0 { return 21 }
    // The wrapping operators wrap at the type's width.
    const w8 = i8_max +% i8_one
    if w8 != i8_min || w8 >= 0 || @intCast(i64, w8) != -128 { return 22 }
    if i16_min -% i16_one != i16_max || i32_max *% @intCast(i32, 2) != -2 || i32_min *% i32_minus_one != i32_min { return 23 }
    if @intCast(i32, 0) -% i32_min != i32_min { return 24 }
    if u8_max +% u8_one != 0 || u16_zero -% u16_one != u16_max || @intCast(u64, u16_zero -% u16_one) != 65535 { return 25 }
    if u32_bit16 *% u32_bit16 != 0 || u32_zero -% u32_one != 4294967295 || u32_zero -% u32_one < u32_one { return 26 }
    var wrapped = i32_max
    wrapped +%= i32_one
    if wrapped != i32_min { return 27 }
    wrapped -%= i32_one
    if wrapped != i32_max { return 28 }
    wrapped *%= @intCast(i32, 2)
    if wrapped != -2 { return 29 }
    // The saturating operators stop at the bounds of a signed type too.
    if i8_hundred +| i8_hundred != 127 || -i8_hundred +| -i8_hundred != -128 { return 30 }
    if -i8_hundred -| i8_hundred != -128 || i8_hundred -| -i8_hundred != 127 || @intCast(i8, -3) +| @intCast(i8, 5) != 2 { return 31 }
    if i16_two_hundred *| i16_two_hundred != 32767 || -i16_two_hundred *| i16_two_hundred != -32768 { return 32 }
    if i32_max +| i32_one != i32_max || i32_min -| i32_one != i32_min || i32_bit16 *| -i32_bit16 != i32_min { return 33 }
    var clamped: i8 = 120
    clamped +|= @intCast(i8, 10)
    if clamped != 127 { return 34 }
    if u8_max +| u8_one != u8_max || u16_zero -| u16_one != 0 || u32_bit16 *| u32_bit16 != u32_max { return 35 }
    // Factors wider than 32 bits: in range, and saturating where the
    // 64-bit word lost the product.
    const u40_top = @intCast(u40, bit39)
    const u40_bit20 = @intCast(u40, bit20)
    const u40_bit19 = @intCast(u40, bit19)
    const i40_min = @intCast(i40, -bit39)
    const i40_max = @intCast(i40, bit39 - 1)
    const i40_bit20 = @intCast(i40, bit20)
    const i40_bit19 = @intCast(i40, bit19)
    if u40_bit20 * u40_bit19 != u40_top || i40_bit20 * -i40_bit19 != i40_min { return 36 }
    if u40_top *| u40_top != @intCast(u40, 1099511627775) || i40_min *| i40_min != i40_max || i40_min *| i40_max != i40_min { return 37 }
    // `x op= y` of a negative field reads it sign-extended (zero-extended,
    // -5 / 2 was 2147483645 and -3 >> 1 was 32766).
    var holder = Holder.{ .small = -3, .word = -5 }
    holder.word /= @intCast(i32, 2)
    holder.small >>= 1
    if holder.word != -2 || holder.small != -2 { return 38 }
    holder.word -= i32_max - i32_one
    if holder.word != i32_min { return 39 }
    return 13
}

fn trapped(status: usize) -> bool { return process.exitStatus(status) == 132 }

// Case `k` in a child process: whether its status is the trap's (or, for
// case 0, which fits, an exit 0).
fn caseInChild(k: usize) -> bool {
    const child = process.fork()
    if child == 0 {
        const result = overflow(k)
        linux.exitGroup(if result == 2147483647 { 0 } else { 1 })
    }
    var status: usize = 0
    if child < 0 || process.waitProcess(child, &status, 0) != child { return false }
    if k == 0 { return process.succeeded(status) }
    return trapped(status)
}

fn decimal(text: arguments_module.String) -> usize {
    var value: usize = 0
    var index: usize = 0
    while index < text.length {
        const digit = text.pointer[index]
        if digit < 48 || digit > 57 { return CASES + 1 }
        value = value * 10 + @intCast(usize, digit - 48)
        index += 1
    }
    return value
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments_module.count(arguments) > 1 {
        const given = arguments_module.argument(arguments, 1)
        if given.length == 6 && given.pointer[0] == 118 { return values() }
        const k = decimal(given)
        if k == 0 || k > CASES { return 2 }
        // (Exits 0 when the case did not trap, whatever it computed.)
        const result = overflow(k)
        if result == 1 { return 0 }
        return 0
    }
    const checked = values()
    if checked != 13 { return checked }
    if !caseInChild(0) { return 99 }
    var k: usize = 1
    while k <= CASES {
        if !caseInChild(k) { return @intCast(u8, 100 + k) }
        k += 1
    }
    return 13
}
