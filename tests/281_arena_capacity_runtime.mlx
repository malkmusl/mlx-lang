// The aggregate arena holds more than 256 MiB (it is 1 GiB of address
// space, reserved without committing it): 80000 locals of 4 KiB, 320 MiB,
// fit. The self-hosted compiler needs this for the largest programs
// (tools/ensure_compiler.sh rebuilds a compiler that lacks it). Exits 13.
fn fill(seed: usize) -> usize {
    var block: [4096]u8 = undefined
    block[0] = @intCast(u8, seed & 255)
    block[4095] = block[0]
    return @intCast(usize, block[4095])
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var total: usize = 0
    var index: usize = 0
    while index < 80000 {
        total += fill(index)
        index += 1
    }
    return if total == 10191808 { 13 } else { 1 }
}
