// ignition's paint.squeezeOut (projects/desktop/splash/paint.mlx): a frame
// drawn for the screen's shape brought to the width of a display whose
// mode is narrower in shape. Each pixel out is the mean of the stretch of
// the row it stands for: by hand where the widths go into each other
// (8 to 4, 6 to 4), against a sum in whole numbers for widths that do not
// (3413 to 1280 is the wide monitor's on a 1280x960 mode), a plain colour
// stays itself, red and blue swap when asked, the byte above them is the
// first pixel's, a part of the frame gives the pixels the whole gives and
// touches no others, rows stay rows.
// The hard cases: columns black and white by turns at widths where a
// stretch cut short falls behind along the row (within one of the mean at
// the row's end as at its start), rows further apart than they are wide,
// a part with no width or beyond the frame, runs changed at random and
// sent one by one (the buffer is the whole frame's after each), and no
// read beyond a row's end (the row lies against a page that is not there).
// Exits 13.
const std = @import("std")
const paint = @import("../projects/desktop/splash/paint.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn fail(what: []const u8, a: usize, b: usize) -> u8 {
    say("FAIL ")
    say(what)
    say(" (")
    number(a)
    say(", ")
    number(b)
    say(")\n")
    return 1
}

const WIDE: usize = 3413
const ROWS: usize = 5
const GUARD: u32 = 0x5A5A5A5A
// The widest row brought together here, and the widest it comes out.
const WIDEST: usize = 7700

var source: [WIDE * ROWS]u32 = undefined
// The buffers out: a guard pixel before and after each row's 1280.
var whole: [1300 * ROWS]u32 = undefined
var parts: [1300 * ROWS]u32 = undefined
// One row out of any width.
var line: [WIDEST + 2]u32 = undefined

fn surface(width: usize, height: usize) -> paint.Surface {
    var made: paint.Surface = undefined
    made.pixels = &source
    made.width = width
    made.height = height
    made.stride = width
    return made
}

fn channel(pixel: u32, shift: u5) -> usize { return @intCast(usize, (pixel >> shift) & 255) }

// The mean of the stretch pixel `column` of `shown` stands for in `row`
// of a source `wide` across, in whole numbers: source pixel i reaches
// from i * shown to (i + 1) * shown, the pixel out from column * wide to
// (column + 1) * wide, and what they share weighs the source's value.
fn mean(row: usize, wide: usize, shown: usize, column: usize, shift: u5) -> usize {
    const from = column * wide
    const to = from + wide
    var sum: usize = 0
    var i = from / shown
    while i < wide && i * shown < to {
        const low = if i * shown > from { i * shown } else { from }
        const high = if (i + 1) * shown < to { (i + 1) * shown } else { to }
        sum += channel(source[row * wide + i], shift) * (high - low)
        i += 1
    }
    return (sum + wide / 2) / wide
}

fn near(a: usize, b: usize) -> bool { return if a > b { a - b <= 1 } else { b - a <= 1 } }

fn fillGuards(buffer: [*]u32, count: usize) -> void {
    var k: usize = 0
    while k < count {
        buffer[k] = GUARD
        k += 1
    }
}

// Numbers that are the same on every run.
var seed: usize = 88172645463325252

fn next() -> usize {
    seed = seed ^ (seed << 13)
    seed = seed ^ (seed >> 7)
    seed = seed ^ (seed << 17)
    return seed
}

// Row 0 of the source, `wide` across, to `shown` pixels: every channel
// within one of its mean, nothing written beside them. 0, or 1 said.
fn meansHold(wide: usize, shown: usize, what: []const u8) -> u8 {
    const from = surface(wide, 1)
    fillGuards(&line, shown + 2)
    paint.squeezeOut(&from, @intFromPtr(&line) + 4, (WIDEST + 2) * 4, 0, 0, wide, 1, false, shown)
    if line[0] != GUARD || line[shown + 1] != GUARD { return fail("a row was written outside its pixels, widths", wide, shown) }
    var column: usize = 0
    while column < shown {
        const got = line[1 + column]
        if !near(channel(got, 0), mean(0, wide, shown, column, 0)) || !near(channel(got, 8), mean(0, wide, shown, column, 8)) || !near(channel(got, 16), mean(0, wide, shown, column, 16)) {
            say("FAIL ")
            say(what)
            say(", ")
            number(wide)
            say(" to ")
            number(shown)
            say(": more than one off the mean at pixel ")
            number(column)
            say("\n")
            return 1
        }
        column += 1
    }
    return 0
}

// The source at `wide` across brought to 1280, runs of it changed and
// sent one by one (`tiles`: runs of whole tiles, as the splash sends
// them): after each the buffer is what the whole frame gives.
fn runsHold(wide: usize, tiles: bool) -> u8 {
    const pitch: usize = 1300 * 4
    const from = surface(wide, ROWS)
    var k: usize = 0
    while k < wide * ROWS {
        source[k] = @intCast(u32, next() & 0xFFFFFFFF)
        k += 1
    }
    fillGuards(&parts, 1300 * ROWS)
    fillGuards(&whole, 1300 * ROWS)
    paint.squeezeOut(&from, @intFromPtr(&parts) + 4, pitch, 0, 0, wide, ROWS, false, 1280)
    var turn: usize = 0
    while turn < 120 {
        var left = next() % wide
        var width = 1 + next() % (if turn % 3 == 0 { 700 } else { 70 })
        if tiles {
            left = left - left % 32
            width = 32 * (1 + next() % 6)
        } else if wide == WIDE && turn < 14 {
            // (First the columns of 3413 a pixel out reaches into by
            // less than a hundredth, 3301 and every eighth after: that
            // pixel changes with them too.)
            left = 3301 + 8 * turn
            width = 1
        }
        if left + width > wide { width = wide - left }
        const top = next() % ROWS
        const height = 1 + next() % (ROWS - top)
        var row = top
        while row < top + height {
            var column = left
            while column < left + width {
                source[row * wide + column] = @intCast(u32, next() & 0xFFFFFFFF)
                column += 1
            }
            row += 1
        }
        paint.squeezeOut(&from, @intFromPtr(&parts) + 4, pitch, left, top, width, height, false, 1280)
        paint.squeezeOut(&from, @intFromPtr(&whole) + 4, pitch, 0, 0, wide, ROWS, false, 1280)
        k = 0
        while k < 1300 * ROWS {
            if parts[k] != whole[k] {
                say("FAIL ")
                number(wide)
                say(" to 1280, turn ")
                number(turn)
                say(", a run of ")
                number(width)
                say(" from column ")
                number(left)
                say(": the buffer is not the whole frame's at (")
                number(k / 1300)
                say(", ")
                number(k % 1300)
                say(")\n")
                return 1
            }
            k += 1
        }
        turn += 1
    }
    return 0
}

pub fn main() -> u8 {
    // By hand, 8 to 4: pairs.
    var k: usize = 0
    const eight = [8]u32{ 0xFF000000, 0xFF0000FF, 0x7F102030, 0x00304050, 0x00FFFFFF, 0x00FFFFFF, 0x00010203, 0x00030405 }
    while k < 8 {
        source[k] = eight[k]
        k += 1
    }
    var from = surface(8, 1)
    fillGuards(&whole, 16)
    paint.squeezeOut(&from, @intFromPtr(&whole) + 4, 64, 0, 0, 8, 1, false, 4)
    // (blue 0 and 255: 128 by rounding up; the byte above is the first's.)
    if whole[1] != 0xFF000080 { return fail("8 to 4, the first pair", @intCast(usize, whole[1]), 0) }
    if whole[2] != 0x7F203040 { return fail("8 to 4, the second pair", @intCast(usize, whole[2]), 0) }
    if whole[3] != 0x00FFFFFF { return fail("8 to 4, white stays white", @intCast(usize, whole[3]), 0) }
    if whole[4] != 0x00020304 { return fail("8 to 4, the last pair", @intCast(usize, whole[4]), 0) }
    if whole[0] != GUARD || whole[5] != GUARD { return fail("8 to 4 wrote outside its four pixels", 0, 0) }

    // By hand, 6 to 4: a pixel out is one and a half of the source's.
    //   0 60 120 180 240 30 (blue) gives (0 + 30) / 1.5, (30 + 120) / 1.5,
    //   (180 + 120) / 1.5, (120 + 30) / 1.5.
    // Green is 0 and 1 by turns: means of a third (0, the nearer) and
    // of two thirds (1), which only rounding at the half tells apart.
    const six = [6]u32{ 0, 60, 120, 180, 240, 30 }
    const thirds: u32 = 0x00000100
    k = 0
    while k < 6 {
        source[k] = six[k] | (six[5 - k] << 16) | (if k % 2 == 1 { thirds } else { 0 })
        k += 1
    }
    from = surface(6, 1)
    fillGuards(&whole, 16)
    paint.squeezeOut(&from, @intFromPtr(&whole) + 4, 64, 0, 0, 6, 1, false, 4)
    const blues = [4]u32{ 20, 100, 200, 100 }
    k = 0
    while k < 4 {
        // (Red runs the other way: the same means from the right.)
        if whole[1 + k] != (blues[k] | (blues[3 - k] << 16) | (if k >= 2 { thirds } else { 0 })) { return fail("6 to 4, pixel", k, @intCast(usize, whole[1 + k])) }
        k += 1
    }
    // Red and blue swapped on the way out.
    paint.squeezeOut(&from, @intFromPtr(&whole) + 4, 64, 0, 0, 6, 1, true, 4)
    k = 0
    while k < 4 {
        if whole[1 + k] != (blues[3 - k] | (blues[k] << 16) | (if k >= 2 { thirds } else { 0 })) { return fail("6 to 4 swapped, pixel", k, @intCast(usize, whole[1 + k])) }
        k += 1
    }

    // Rows further apart than they are wide (a surface's stride): the
    // same six in two rows nine apart, what lies between them not read.
    k = 0
    while k < 18 {
        source[k] = if k % 9 < 6 { six[k % 9] | (six[5 - k % 9] << 16) } else { 0x00FFFFFF }
        k += 1
    }
    from = surface(6, 2)
    from.stride = 9
    fillGuards(&whole, 32)
    paint.squeezeOut(&from, @intFromPtr(&whole) + 4, 64, 0, 0, 6, 2, false, 4)
    k = 0
    while k < 4 {
        if whole[1 + k] != (blues[k] | (blues[3 - k] << 16)) || whole[17 + k] != (blues[k] | (blues[3 - k] << 16)) { return fail("6 to 4 with rows nine apart, pixel", k, @intCast(usize, whole[17 + k])) }
        k += 1
    }
    if whole[0] != GUARD || whole[5] != GUARD || whole[16] != GUARD || whole[21] != GUARD { return fail("6 to 4 with rows nine apart wrote outside its pixels", 0, 0) }

    // The wide monitor's: 3413 across to 1280, five rows of noise.
    k = 0
    while k < WIDE * ROWS {
        source[k] = @intCast(u32, next() & 0xFFFFFFFF)
        k += 1
    }
    from = surface(WIDE, ROWS)
    const pitch: usize = 1300 * 4
    fillGuards(&whole, 1300 * ROWS)
    paint.squeezeOut(&from, @intFromPtr(&whole) + 4, pitch, 0, 0, WIDE, ROWS, false, 1280)
    var row: usize = 0
    while row < ROWS {
        if whole[row * 1300] != GUARD || whole[row * 1300 + 1281] != GUARD { return fail("3413 to 1280 wrote outside the row", row, 0) }
        var column: usize = 0
        while column < 1280 {
            const got = whole[row * 1300 + 1 + column]
            if !near(channel(got, 0), mean(row, WIDE, 1280, column, 0)) { return fail("3413 to 1280, blue at", row, column) }
            if !near(channel(got, 8), mean(row, WIDE, 1280, column, 8)) { return fail("3413 to 1280, green at", row, column) }
            if !near(channel(got, 16), mean(row, WIDE, 1280, column, 16)) { return fail("3413 to 1280, red at", row, column) }
            column += 1
        }
        row += 1
    }

    // Parts of the frame (tiles' runs, as the splash sends them) give
    // the pixels the whole gives, and a part touches only the pixels it
    // reaches: columns 1000 to 1099 of the source reach 375 to 412 out.
    fillGuards(&parts, 1300 * ROWS)
    paint.squeezeOut(&from, @intFromPtr(&parts) + 4, pitch, 1000, 1, 100, 3, false, 1280)
    row = 0
    while row < ROWS {
        var column: usize = 0
        while column < 1280 {
            const got = parts[row * 1300 + 1 + column]
            const inside = row >= 1 && row < 4 && column >= 375 && column <= 412
            if inside && got != whole[row * 1300 + 1 + column] { return fail("a part differs from the whole at", row, column) }
            if !inside && got != GUARD { return fail("a part wrote outside its reach at", row, column) }
            column += 1
        }
        row += 1
    }
    // A part with no width, and one beyond the frame: nothing.
    paint.squeezeOut(&from, @intFromPtr(&parts) + 4, pitch, 0, 0, 0, ROWS, false, 1280)
    paint.squeezeOut(&from, @intFromPtr(&parts) + 4, pitch, 2000, 0, 0, ROWS, false, 1280)
    paint.squeezeOut(&from, @intFromPtr(&parts) + 4, pitch, WIDE, 0, 96, ROWS, false, 1280)
    paint.squeezeOut(&from, @intFromPtr(&parts) + 4, pitch, WIDE + 500, 0, 96, ROWS, false, 1280)
    if parts[1] != GUARD || parts[751] != GUARD || parts[1280] != GUARD || parts[4 * 1300 + 1280] != GUARD { return fail("a part with no width, or beyond the frame, was written", 0, 0) }
    // In runs of three tiles, the last one given whole though the frame
    // ends inside it (it is cut to the frame).
    var left: usize = 0
    while left < WIDE {
        paint.squeezeOut(&from, @intFromPtr(&parts) + 4, pitch, left, 0, 96, ROWS, false, 1280)
        left += 96
    }
    k = 0
    while k < 1300 * ROWS {
        if parts[k] != whole[k] { return fail("the frame in parts differs from the whole at", k / 1300, k % 1300) }
        k += 1
    }
    // And column by column: every pixel out begun from every column it
    // reaches into, as it is begun in the middle of a row.
    fillGuards(&parts, 1300 * ROWS)
    left = 0
    while left < WIDE {
        paint.squeezeOut(&from, @intFromPtr(&parts) + 4, pitch, left, 0, 1, ROWS, false, 1280)
        left += 1
    }
    k = 0
    while k < 1300 * ROWS {
        if parts[k] != whole[k] { return fail("the frame column by column differs from the whole at", k / 1300, k % 1300) }
        k += 1
    }

    // Runs changed at random and sent one by one, as an animation's are:
    // the wide monitor's width, one hardly wider than the display and
    // one nearly four times as wide.
    if runsHold(WIDE, true) != 0 || runsHold(WIDE, false) != 0 || runsHold(1317, false) != 0 || runsHold(1500, true) != 0 || runsHold(3399, false) != 0 { return 1 }

    // The hard patterns, a row each: columns black and white by turns
    // (and three and three), and noise, at widths where a stretch's
    // length cut short adds up along the row (1280 times a 65536th of a
    // pixel and more); the last pixels are within one of their means as
    // the first are.
    const wides = [12]usize{ 1284, 1306, 3413, 2731, 4267, 3414, 5121, 6827, 7681, 7693, 3441, 2390 }
    const shows = [12]usize{ 1280, 1280, 1280, 1024, 1920, 1920, 3840, 3840, 3840, 7680, 1366, 1024 }
    var pair: usize = 0
    while pair < 12 {
        const wide = wides[pair]
        k = 0
        while k < wide {
            source[k] = if k % 2 == 0 { 0x00000000 } else { 0x00FFFFFF }
            k += 1
        }
        if meansHold(wide, shows[pair], "black and white by turns") != 0 { return 1 }
        k = 0
        while k < wide {
            source[k] = if (k / 3) % 2 == 0 { 0x00FF00FF } else { 0x0000FF00 }
            k += 1
        }
        if meansHold(wide, shows[pair], "three and three") != 0 { return 1 }
        k = 0
        while k < wide {
            source[k] = @intCast(u32, next() & 0xFFFFFFFF)
            k += 1
        }
        if meansHold(wide, shows[pair], "noise") != 0 { return 1 }
        pair += 1
    }

    // A plain colour stays itself at any width.
    k = 0
    while k < WIDE {
        source[k] = 0xFF2B6CB0
        k += 1
    }
    from = surface(WIDE, 1)
    var shown: usize = 1
    while shown < WIDE {
        paint.squeezeOut(&from, @intFromPtr(&whole) + 4, pitch, 0, 0, WIDE, 1, false, shown)
        var column: usize = 0
        while column < shown && column < 1280 {
            if whole[1 + column] != 0xFF2B6CB0 { return fail("a plain colour changed at the width", shown, column) }
            column += 1
        }
        shown += if shown < 40 { 1 } else { 97 }
        if shown > 1280 { break }
    }
    // (White, the most a channel holds, from every width up to four
    // times the display's: no channel runs over into the next.)
    var wide: usize = 1281
    while wide <= 5120 {
        k = 0
        while k < wide {
            source[k] = 0x00FFFFFF
            k += 1
        }
        from = surface(wide, 1)
        paint.squeezeOut(&from, @intFromPtr(&whole) + 4, pitch, 0, 0, wide, 1, false, 1280)
        k = 0
        while k < 1280 {
            if whole[1 + k] != 0x00FFFFFF { return fail("white changed from the width", wide, k) }
            k += 1
        }
        wide += if wide < 1320 { 1 } else { 61 }
    }

    // Nothing is read beyond a row's end: the row lies against a page
    // that is not there (a read of it ends this test), at every pair of
    // small widths and at the wide monitor's.
    const page: usize = 4096
    const room = std.linux.mapAnonymous(8 * page)
    if room == 0 || std.linux.syscall3(std.linux.SYS_mprotect, room + 4 * page, 4 * page, std.linux.PROT_NONE) != 0 { return fail("no page to lay a row against", 0, 0) }
    shown = 1
    while shown <= 48 {
        wide = shown + 1
        while wide <= shown * 4 + 3 && wide <= 4096 {
            var edge: paint.Surface = undefined
            unsafe { edge.pixels = @ptrFromInt([*]u32, room + 4 * page - wide * 4) }
            edge.width = wide
            edge.height = 1
            edge.stride = wide
            k = 0
            while k < wide {
                edge.pixels[k] = @intCast(u32, (k * 37) & 255) * 0x00010101
                k += 1
            }
            fillGuards(&line, shown + 2)
            paint.squeezeOut(&edge, @intFromPtr(&line) + 4, (WIDEST + 2) * 4, 0, 0, wide, 1, false, shown)
            if line[0] != GUARD || line[shown + 1] != GUARD || line[shown] == GUARD { return fail("a row against the page's end: not its pixels written", wide, shown) }
            wide += 1
        }
        shown += 1
    }
    var against: paint.Surface = undefined
    unsafe { against.pixels = @ptrFromInt([*]u32, room + 4 * page - WIDE * 4) }
    against.width = WIDE
    against.height = 1
    against.stride = WIDE
    k = 0
    while k < WIDE {
        against.pixels[k] = 0x00406080
        k += 1
    }
    fillGuards(&line, 1282)
    paint.squeezeOut(&against, @intFromPtr(&line) + 4, (WIDEST + 2) * 4, 0, 0, WIDE, 1, false, 1280)
    paint.squeezeOut(&against, @intFromPtr(&line) + 4, (WIDEST + 2) * 4, WIDE - 40, 0, 96, 1, false, 1280)
    if line[0] != GUARD || line[1281] != GUARD || line[1280] != 0x00406080 { return fail("3413 against the page's end: not its pixels written", 0, 0) }

    // Not narrower: nothing is written (the caller copies).
    fillGuards(&whole, 16)
    from = surface(8, 1)
    paint.squeezeOut(&from, @intFromPtr(&whole), 64, 0, 0, 8, 1, false, 8)
    paint.squeezeOut(&from, @intFromPtr(&whole), 64, 0, 0, 8, 1, false, 0)
    if whole[0] != GUARD { return fail("a frame no wider than its display was written", 0, 0) }
    say("squeezed\n")
    return 13
}
