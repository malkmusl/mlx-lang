// String and character literal escapes (spec lexical.xml, StringLiterals
// and CharacterLiterals): \xHH is one byte, \u{H..H} a Unicode scalar as
// UTF-8, the length of a literal counts the bytes they make, and a
// character literal is the number of its one character. Exits 13 when
// every check holds, else the number of the first check that failed.
const std = @import("std")

fn sameBytes(text: []const u8, expected: []const u8) -> bool {
    if text.length != expected.length { return false }
    var index: usize = 0
    while index < text.length {
        if text[index] != expected[index] { return false }
        index += 1
    }
    return true
}

pub fn main() -> u8 {
    // \x: an ESC, a BEL, a byte with the high bit set, a NUL in the middle.
    const escape = "\x1b[0m"
    if escape.length != 4 || escape[0] != 27 || escape[1] != 91 || escape[3] != 109 { return 1 }
    const bell = "\x07"
    if bell.length != 1 || bell[0] != 7 { return 2 }
    const high = "\xff\x80"
    if high.length != 2 || high[0] != 255 || high[1] != 128 { return 3 }
    const nul = "a\x00b"
    if nul.length != 3 || nul[1] != 0 || nul[2] != 98 { return 4 }
    // Upper-case digits too.
    const upper = "\xAB"
    if upper.length != 1 || upper[0] != 171 { return 5 }
    // \u: one, two, three and four UTF-8 bytes.
    if !sameBytes("\u{41}", "A") { return 6 }
    const umlaut = "\u{e4}"
    if umlaut.length != 2 || umlaut[0] != 195 || umlaut[1] != 164 { return 7 }
    const euro = "\u{20AC}"
    if euro.length != 3 || euro[0] != 226 || euro[1] != 130 || euro[2] != 172 { return 8 }
    const smile = "\u{1F600}"
    if smile.length != 4 || smile[0] != 240 || smile[1] != 159 || smile[2] != 152 || smile[3] != 128 { return 9 }
    // The old escapes still, mixed with the new ones.
    const mixed = "\t\x41\n\\\"\u{42}\'"
    if mixed.length != 7 || mixed[0] != 9 || mixed[1] != 65 || mixed[2] != 10 || mixed[3] != 92 || mixed[4] != 34 || mixed[5] != 66 || mixed[6] != 39 { return 10 }
    // A literal passed on keeps its decoded length.
    if !sameBytes("\x68\x69", "hi") { return 11 }
    // Character literals: a plain character, the escapes, a scalar from
    // several UTF-8 bytes, all usable where a number is.
    const letter: u8 = 'A'
    const escape_char: u8 = '\x1b'
    const tab: u8 = '\t'
    const quote: u8 = '\''
    const euro_scalar: u32 = '\u{20AC}'
    const umlaut_scalar: u32 = 'ä'
    if letter != 65 || escape_char != 27 || tab != 9 || quote != 39 { return 12 }
    if euro_scalar != 8364 || umlaut_scalar != 228 { return 14 }
    if escape[0] != '\x1b' { return 15 }
    return 13
}
