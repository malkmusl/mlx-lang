// Regression test for a real x86_64 backend bug: reading field/component 0
// of a single-word value bound through an `anytype` parameter (e.g. a
// one-element tuple literal `.{x}`) returned 0 instead of the real value
// whenever the read was not the literal next LIR instruction after the
// value became available -- specifically when a call intervened (even one
// that never touches the value) or when the read sat on one side of a
// branch whose other side called something.
//
// Root cause: `State.storeRaxResult`'s "retain in rax, skip the stack
// write" peephole (`canRetainNext`, single-word values only) left the
// value's real stack slot unwritten, expecting the very next LIR
// instruction to consume it from rax. `emitTupleElement` (`@field`
// codegen) and the call-argument loaders read component 0 through
// `State.getComponent`, a plain "already materialized?" peek that knows
// nothing about that pending rax/immediate state -- so on any path where
// the retained value wasn't immediately consumed, the read silently fell
// through to a hardcoded 0 instead of the real value. Fixed by routing
// component-0 reads through `State.loadOp`, which already knows how to
// consume the pending value (see `compiler/selfhost/backend/x86_64/codegen
// /values.mlx` and `.../calls.mlx`).
//
// Exercises three shapes of the bug that all independently reproduced it:
//   1. a branch where one arm reads the field and the other calls a
//      function that does not even take the value as an argument;
//   2. passing the value itself to a call and then reading a field of it
//      again afterwards;
//   3. the real-world shape (`std.io.printFmt`'s single-argument case)
//      going through the recursive `anytype`-tuple field lookup.
//
// main returns 0 only if every case recovered the correct value; each
// case's failure sets a distinct nonzero bit so the exit code identifies
// which one broke.

const std = @import("std")

fn helperNoArg() -> usize {
    return 12345
}

fn helperArg(value: anytype) -> usize {
    return 12345
}

fn branchThenCall(value: anytype, wanted: usize) -> usize {
    if wanted == 0 {
        return @field(value, 0)
    }
    return helperNoArg()
}

fn callThenReread(value: anytype) -> usize {
    const ignored = helperArg(value)
    return @field(value, 0)
}

fn fieldAt(values: anytype, wanted: usize, comptime index: usize) -> usize {
    if index < @fieldCount(@typeOf(values)) {
        if wanted == index { return @field(values, index) }
        return fieldAt(values, wanted, index + 1)
    }
    return 0
}

pub fn main() -> u8 {
    var failures: u8 = 0

    if branchThenCall(.{700}, 0) != 700 { failures |= 1 }
    if callThenReread(.{700}) != 700 { failures |= 2 }
    if fieldAt(.{700}, 0, 0) != 700 { failures |= 4 }

    return failures
}
