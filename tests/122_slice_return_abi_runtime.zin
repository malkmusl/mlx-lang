// A plain slice return transports both pointer and length through rax/rdx.
fn tail(values: []const u8) -> []const u8 {
    return values[1..]
}

pub fn main() -> u8 {
    const values = [_]u8{4, 13, 21}
    const result = tail(values[0..])
    var count: u8 = 0
    for item in result {
        count = count + item
    }
    return count
}
