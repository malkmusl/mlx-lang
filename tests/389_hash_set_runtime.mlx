// std.AutoHashSet(K): keys inserted once however often they are given,
// found, removed, counted and walked; a set of strings by content; a set
// grown through its rehashes; cleared with the memory kept and given
// back; dropped where its scope ends; and 100 000 inserts and removes
// under the leak check with every block given back. Exits 13 on success
// (another number: the check that failed).
const std = @import("std")
const leaks = @import("std.leaks")

fn next(seed: *u64) -> u64 {
    seed.* = seed.* *% 6364136223846793005 +% 1442695040888963407
    return seed.* >> 33
}

fn fillAndDrop(allocator: std.allocator.Allocator) -> usize {
    var set = std.AutoHashSet(u32).init(allocator)
    var at: u32 = 0
    while at < 1000 {
        if !set.insert(at) { return 0 }
        at += 1
    }
    return set.count()
}

fn main() -> u8 {
    leaks.watchAlways()
    const allocator = std.heap.allocator()
    const live_before = leaks.liveCount()
    {
        var numbers = std.AutoHashSet(u32).init(allocator)
        if numbers.count() != 0 || numbers.contains(1) { return 1 }
        if !numbers.insert(1) || !numbers.insert(2) || !numbers.insert(1) { return 2 }
        if numbers.count() != 2 || !numbers.contains(1) || !numbers.contains(2) || numbers.contains(3) { return 3 }
        if !numbers.remove(1) || numbers.remove(1) || numbers.contains(1) || numbers.count() != 1 { return 4 }
        if !numbers.insert(3) || !numbers.insert(4) || numbers.count() != 3 { return 5 }
        var keys = numbers.iterator()
        var sum: u32 = 0
        var seen: usize = 0
        while true {
            const key = keys.next()
            if key == null { break }
            sum += key.?.*
            seen += 1
        }
        if seen != 3 || sum != 9 { return 6 }
        const room = numbers.capacity()
        numbers.clearRetainingCapacity()
        if numbers.count() != 0 || numbers.capacity() != room || numbers.contains(2) { return 7 }
        if !numbers.insert(5) || !numbers.contains(5) { return 8 }
        numbers.clearAndFree()
        if numbers.count() != 0 || numbers.capacity() != 0 { return 9 }
        if !numbers.ensureTotalCapacity(100) || numbers.capacity() < 100 { return 10 }
    }
    // Strings by content.
    {
        var words = std.AutoHashSet([]const u8).init(allocator)
        if !words.insert("one") || !words.insert("two") { return 11 }
        var copy: [3]u8 = [3]u8{ 111, 110, 101 }
        const copy_bytes: [*]const u8 = &copy
        const copied: []const u8 = copy_bytes[0..3]
        if !words.contains(copied) || !words.insert(copied) || words.count() != 2 { return 12 }
        if words.contains("three") || !words.remove(copied) || words.contains("one") { return 14 }
    }
    // Grown: 10 000 keys, each in once.
    {
        var many = std.AutoHashSet(u64).init(allocator)
        var at: u64 = 0
        while at < 10000 {
            if !many.insert(at * 3) || !many.insert(at * 3) { return 15 }
            at += 1
        }
        if many.count() != 10000 { return 16 }
        at = 0
        while at < 10000 {
            if !many.contains(at * 3) || many.contains(at * 3 + 1) { return 17 }
            at += 1
        }
    }
    if fillAndDrop(allocator) != 1000 { return 18 }
    if leaks.liveCount() != live_before { return 19 }
    // 100 000 inserts and removes under the leak check.
    {
        var stress = std.AutoHashSet(u64).init(allocator)
        var held: [4096]u64 = undefined
        var count: usize = 0
        var seed: u64 = 5
        var round: usize = 0
        while round < 100000 {
            const choice = next(&seed)
            if count < 4096 && (count == 0 || choice % 3 != 0) {
                const key = next(&seed) % 1000000
                if !stress.contains(key) {
                    if !stress.insert(key) { return 20 }
                    held[count] = key
                    count += 1
                }
            } else {
                const at = @intCast(usize, choice) % count
                if !stress.remove(held[at]) { return 21 }
                count -= 1
                held[at] = held[count]
            }
            round += 1
        }
        if stress.count() != count { return 22 }
        leaks.writeNow()
        stress.deinit()
    }
    if leaks.liveCount() != live_before || leaks.problemCount() != 0 { return 23 }
    return 13
}
