// std.http.auth: challenges told apart in a WWW-Authenticate header,
// their parameters found, Basic tokens (ISO-8859-1 when possible), Digest
// responses (RFC 2617's example, MD5-sess), the Authorization values as
// libsoup writes them, protection spaces, nonce counts. Exits 13 when
// every check holds, else the number of the first check that failed.
const auth = @import("std.http.auth")
const headers = @import("std.http.headers")

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

const Written = struct {
    bytes: [512]u8
    length: usize
}

fn append(context: usize, bytes: []const u8) -> void {
    const w: *Written = unsafe { @ptrFromInt(*Written, context) }
    var index: usize = 0
    while index < bytes.length {
        w.*.bytes[w.*.length] = bytes[index]
        w.*.length += 1
        index += 1
    }
}

fn sinkOf(w: *Written) -> headers.Sink {
    w.*.length = 0
    return headers.Sink.{ .context = @intFromPtr(w), .write = append }
}

fn writtenIs(w: *Written, expected: []const u8) -> bool {
    const all: []const u8 = w.*.bytes[0..w.*.length]
    return same(all, expected)
}

pub fn main() -> u8 {
    // Two challenges in one header, the second with a parameter whose
    // value holds a comma.
    const header = "Basic realm=\"simple\", Digest realm=\"testrealm@host.com\", qop=\"auth,auth-int\", nonce=\"dcd98b7102dd2f0e8b11d0f600bfb0c093\", opaque=\"5ccc069c403ebaf9f0171e9517f40e41\", Negotiate"
    var it = auth.challenges(header)
    var challenge: []const u8 = ""
    if !auth.nextChallenge(&it, &challenge) || !auth.schemeIs(challenge, "basic") || !same(challenge, "Basic realm=\"simple\"") { return 1 }
    if !auth.nextChallenge(&it, &challenge) || !auth.schemeIs(challenge, "Digest") || auth.schemeIs(challenge, "Dig") { return 2 }
    const params = auth.paramsOf(challenge, "Digest")
    if !auth.nextChallenge(&it, &challenge) || !same(challenge, "Negotiate") { return 3 }
    if auth.nextChallenge(&it, &challenge) { return 4 }

    // The parameters.
    var out: [128]u8 = undefined
    var length: usize = 0
    if auth.findParam(params, "REALM", out[0..128], &length) != auth.Found.value || !same(out[0..length], "testrealm@host.com") { return 5 }
    if auth.findParam(params, "qop", out[0..128], &length) != auth.Found.value || !same(out[0..length], "auth,auth-int") { return 6 }
    if auth.findParam(params, "stale", out[0..128], &length) != auth.Found.absent { return 7 }
    if auth.findParam("a=1, flag, a=2", "flag", out[0..128], &length) != auth.Found.bare { return 8 }
    if auth.findParam("a=1, a=2", "a", out[0..128], &length) != auth.Found.value || !same(out[0..length], "1") { return 9 }

    // The Digest challenge read whole.
    var d: auth.DigestChallenge = undefined
    if !auth.digestChallenge(params, &d) { return 10 }
    if !same(d.realm, "testrealm@host.com") || !same(d.nonce, "dcd98b7102dd2f0e8b11d0f600bfb0c093") || !d.hasOpaque || !same(d.opaque, "5ccc069c403ebaf9f0171e9517f40e41") { return 11 }
    if d.hasDomain || d.algorithm != auth.Algorithm.md5 || d.qopOptions != (auth.QOP_AUTH | auth.QOP_AUTH_INT) || d.stale { return 12 }
    if auth.digestChallenge("realm=\"r\"", &d) { return 14 }
    if auth.digestChallenge("realm=\"r\", nonce=\"n\", qop=\"auth-int\"", &d) { return 15 }
    if auth.digestChallenge("realm=\"r\", nonce=\"n\", algorithm=SHA-256", &d) { return 16 }
    if !auth.digestChallenge("realm=\"r\", nonce=\"n\", algorithm=MD5-sess, stale=true", &d) || d.algorithm != auth.Algorithm.md5Sess || !d.stale || d.qopOptions != 0 { return 17 }

    // RFC 2617's example: Mufasa's response.
    var urp: [32]u8 = undefined
    auth.hexUrp("Mufasa", "testrealm@host.com", "Circle Of Life", &urp)
    if !same(urp[0..32], "939e7578ed9e3c518a452acee763bce9") { return 18 }
    var a1: [32]u8 = undefined
    auth.hexA1(auth.Algorithm.md5, &urp, "dcd98b7102dd2f0e8b11d0f600bfb0c093", "0a4f113b", &a1)
    if !same(a1[0..32], urp[0..32]) { return 19 }
    var response: [32]u8 = undefined
    auth.digestResponse("GET", "/dir/index.html", &a1, true, "dcd98b7102dd2f0e8b11d0f600bfb0c093", "0a4f113b", 1, &response)
    if !same(response[0..32], "6629fae49393a05397450978507c4ef1") { return 20 }
    // Without qop (RFC 2069's form).
    auth.digestResponse("GET", "/dir/index.html", &a1, false, "dcd98b7102dd2f0e8b11d0f600bfb0c093", "", 1, &response)
    if !same(response[0..32], "670fd8c2df070c60b045671b8b24ff02") { return 21 }
    // MD5-sess: A1 is hashed again with the nonces.
    var sess: [32]u8 = undefined
    auth.hexA1(auth.Algorithm.md5Sess, &urp, "dcd98b7102dd2f0e8b11d0f600bfb0c093", "0a4f113b", &sess)
    if same(sess[0..32], urp[0..32]) { return 22 }

    // The Authorization value.
    var w: Written = undefined
    const credentials = auth.DigestCredentials.{ .user = "Mufasa", .realm = "testrealm@host.com", .nonce = "dcd98b7102dd2f0e8b11d0f600bfb0c093", .uri = "/dir/index.html", .algorithm = auth.Algorithm.md5, .response = "6629fae49393a05397450978507c4ef1", .opaque = "5ccc069c403ebaf9f0171e9517f40e41", .hasOpaque = true, .qopAuth = true, .cnonce = "0a4f113b", .nc = 1 }
    auth.writeDigest(sinkOf(&w), &credentials)
    if !writtenIs(&w, "Digest username=\"Mufasa\", realm=\"testrealm@host.com\", nonce=\"dcd98b7102dd2f0e8b11d0f600bfb0c093\", uri=\"/dir/index.html\", algorithm=MD5, response=\"6629fae49393a05397450978507c4ef1\", opaque=\"5ccc069c403ebaf9f0171e9517f40e41\", cnonce=\"0a4f113b\", nc=00000001, qop=auth") { return 23 }
    var plain = credentials
    plain.hasOpaque = false
    plain.qopAuth = false
    plain.algorithm = auth.Algorithm.md5Sess
    auth.writeDigest(sinkOf(&w), &plain)
    if !writtenIs(&w, "Digest username=\"Mufasa\", realm=\"testrealm@host.com\", nonce=\"dcd98b7102dd2f0e8b11d0f600bfb0c093\", uri=\"/dir/index.html\", algorithm=MD5-sess, response=\"6629fae49393a05397450978507c4ef1\"") { return 24 }

    // Basic: RFC 7617's example, then a password beyond ASCII that
    // ISO-8859-1 has (é is one byte there) and one it has not (€).
    var token: [64]u8 = undefined
    var n = auth.basicToken("Aladdin", "open sesame", token[0..64])
    if !same(token[0..n], "QWxhZGRpbjpvcGVuIHNlc2FtZQ==") { return 25 }
    n = auth.basicToken("\u{e9}", "x", token[0..64])
    if !same(token[0..n], "6Tp4") { return 26 }
    n = auth.basicToken("a", "\u{20ac}", token[0..64])
    if !same(token[0..n], "YTrigqw=") { return 27 }
    auth.writeBasic(sinkOf(&w), "QWxhZGRpbjpvcGVuIHNlc2FtZQ==")
    if !writtenIs(&w, "Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ==") { return 28 }
    if auth.basicTokenRoom(7, 11) < 28 { return 29 }

    // Protection spaces.
    if !same(auth.basicSpace("/a/b/c"), "/a/b") || !same(auth.basicSpace("/c"), "/") || !same(auth.basicSpace("/a/b/"), "/a/b/") || !same(auth.basicSpace(""), "") { return 30 }
    var at: usize = 0
    var item: []const u8 = ""
    if !auth.nextDomainItem("/one/  http://h/two/", &at, &item) || !same(auth.withoutTrailingSlash(item), "/one") { return 31 }
    if !auth.nextDomainItem("/one/  http://h/two/", &at, &item) || !same(item, "http://h/two/") { return 32 }
    if auth.nextDomainItem("/one/  http://h/two/", &at, &item) { return 33 }

    // Nonce counts and the client nonce.
    var count: [8]u8 = undefined
    auth.nonceCountHex(0x1a, &count)
    if !same(count[0..8], "0000001a") { return 34 }
    if auth.nonceCountOf("0000001a") != 26 || auth.nonceCountOf("zz") != 0 || auth.nonceCountOf("100000000") != 0 { return 35 }
    var cnonce: [64]u8 = undefined
    n = auth.clientNonce(0x7f3a, 1234, 1700000000, &cnonce)
    // The base64 of "0x7f3a:1234:1700000000".
    if !same(cnonce[0..n], "MHg3ZjNhOjEyMzQ6MTcwMDAwMDAwMA==") { return 36 }
    return 13
}
