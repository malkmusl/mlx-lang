// The kernel's reading of the displays in the boot information
// (projects/brix/kernel/displays.mlx, built for the host) against a blob
// written here as the EFI loader writes it (projects/brix/layout.mlx:
// the first display in the boot info's FB_* fields, every further one a
// record in the page for them):
// - none (a Multiboot loader's: the kernel sets the one display up
//   itself), one as a loader that knows of one writes it (the page of
//   records left as it was, whatever is in it), one from a loader that
//   looks at all of them, two, eight (the most), and too many: a count
//   beyond the records there is room for is cut to the room and the rest
//   counted with the displays left out;
// - records that are no picture's (no memory, no size, rows shorter than
//   their pixels, pixels that are not 32 bits in one of the two orders)
//   and one that names an earlier display's memory again are left out and
//   counted, the others keep the firmware's order;
// - the first display absent and further ones there (the console's own
//   output over two cards has no pixels: the cards are the displays);
// - a display's monitor's word, the firmware's mode, whose mode the
//   loader set, a refusal, where its EDID is and how long, which output
//   it is; the screen's shape (the monitor's mode, else for the first the
//   mode the loader looked for, else the picture's size);
// - which is the main one: the only one; the one whose monitor names the
//   largest mode of its own before a larger picture without a monitor's
//   word; the largest picture where no monitor says anything; the
//   firmware's first of those alike; the one settings/display names by
//   number or by its adapter ("main 1", "main 1002:67df", among other
//   lines, after the mode's line), and the rule when it names one that is
//   not there or nothing that can be read.
// Exits 13.
const std = @import("std")
const layout = @import("../projects/brix/layout.mlx")
const displays = @import("../projects/brix/kernel/displays.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn fail(what: []const u8, a: usize, b: usize) -> u8 {
    say("FAIL ")
    say(what)
    say(" (")
    number(a)
    say(", ")
    number(b)
    say(")\n")
    return 1
}

// The blob's first pages, as words.
const WORDS: usize = 0x8000 / 8
var blob: [WORDS]usize = undefined

fn word(offset: usize) -> usize { return blob[offset / 8] }

fn put(offset: usize, value: usize) -> void { blob[offset / 8] = value }

fn info(field: usize, value: usize) -> void { put(layout.Blob.BOOT_INFO + field, value) }

fn empty() -> void {
    var k: usize = 0
    while k < WORDS {
        blob[k] = 0
        k += 1
    }
}

// The first display, as the loader writes it.
fn first(address: usize, width: usize, height: usize) -> void {
    info(layout.Info.FB_ADDRESS, address)
    info(layout.Info.FB_WIDTH, width)
    info(layout.Info.FB_HEIGHT, height)
    info(layout.Info.FB_PITCH, width * 4)
    info(layout.Info.FB_FORMAT, 1)
}

// The further display `k`'s record.
fn more(k: usize, address: usize, width: usize, height: usize, pitch: usize, format: usize) -> void {
    const at = layout.Blob.DISPLAYS + k * layout.Blob.DISPLAY_RECORD
    put(at + layout.More.ADDRESS, address)
    put(at + layout.More.WIDTH, width)
    put(at + layout.More.HEIGHT, height)
    put(at + layout.More.PITCH, pitch)
    put(at + layout.More.FORMAT, format)
    put(at + layout.More.OUTPUT, k + 2)
}

fn field(k: usize, which: usize, value: usize) -> void { put(layout.Blob.DISPLAYS + k * layout.Blob.DISPLAY_RECORD + which, value) }

var list: displays.List = undefined

fn read() -> void { displays.read(word, &list) }

fn main_of(text: []const u8) -> displays.Choice {
    const named = displays.named(text)
    return displays.choose(&list, &named)
}

pub fn main() -> u8 {
    // The layout itself: the records and their EDIDs in their page, clear
    // of the boot info, the first display's EDID and the trampoline.
    if layout.Blob.DISPLAYS + layout.Blob.DISPLAY_ROOM * layout.Blob.DISPLAY_RECORD > layout.Blob.DISPLAY_EDIDS { return fail("the records reach into the EDIDs", 0, 0) }
    if layout.Blob.DISPLAY_EDIDS + layout.Blob.DISPLAY_ROOM * layout.Blob.EDID_ROOM > layout.Blob.DISPLAYS + 0x1000 { return fail("the EDIDs reach beyond their page", 0, 0) }
    if layout.Blob.DISPLAYS < layout.Blob.TSS + layout.Memory.MAX_CPUS * layout.Blob.TSS_SIZE || layout.Blob.DISPLAYS + 0x1000 > layout.Blob.PERCPU { return fail("the displays' page is another's", 0, 0) }
    if layout.Blob.BOOT_INFO + layout.Info.DISPLAYS_BEYOND + 8 > layout.Blob.GDTR32 { return fail("the boot info reaches into what follows it", 0, 0) }
    if layout.More.OUTPUT + 8 > layout.Blob.DISPLAY_RECORD { return fail("a record's fields are more than a record", 0, 0) }
    if displays.MAX != 1 + layout.Blob.DISPLAY_ROOM { return fail("the kernel's most displays are not the first and the records", displays.MAX, 0) }

    // ---- none: a Multiboot loader's boot information ----
    empty()
    read()
    if list.count != 0 || list.outputs != 0 || list.unusable != 0 || list.beyond != 0 || list.dropped != 0 { return fail("an empty boot information has displays", list.count, list.dropped) }
    if main_of("").index != 0 || main_of("").by != displays.By.ONLY { return fail("no display, and a main one", 0, 0) }

    // ---- one, from a loader that knows of one: whatever the page of
    // records holds, the count is 0 and nothing of it is read ----
    empty()
    first(0x80000000, 1280, 800)
    info(layout.Info.DISPLAYS, 2)
    info(layout.Info.MONITOR_WIDTH, 3840)
    info(layout.Info.MONITOR_HEIGHT, 1080)
    info(layout.Info.FIRMWARE_WIDTH, 1024)
    info(layout.Info.FIRMWARE_HEIGHT, 768)
    info(layout.Info.MODE_BY, layout.Info.MODE_NEAR_MONITOR)
    info(layout.Info.EDID_BYTES, 256)
    more(0, 0x90000000, 800, 600, 3200, 1)
    read()
    if list.count != 1 { return fail("one display from an older loader is not one", list.count, 0) }
    const one = &list.items[0]
    if one.*.address != 0x80000000 || one.*.width != 1280 || one.*.height != 800 || one.*.pitch != 5120 || one.*.format != 1 || !one.*.first { return fail("the first display is not the boot info's", one.*.width, one.*.height) }
    if one.*.monitorWidth != 3840 || one.*.monitorHeight != 1080 || one.*.firmwareWidth != 1024 || one.*.firmwareHeight != 768 || one.*.modeBy != layout.Info.MODE_NEAR_MONITOR { return fail("the first display's words are not the boot info's", one.*.monitorWidth, one.*.modeBy) }
    if one.*.edidAt != layout.Blob.EDID || one.*.edidBytes != 256 { return fail("the first display's EDID is not where the loader puts it", one.*.edidAt, one.*.edidBytes) }
    if one.*.shapeWidth != 3840 || one.*.shapeHeight != 1080 { return fail("the first display's shape is not its monitor's mode", one.*.shapeWidth, one.*.shapeHeight) }
    if list.outputs != 2 { return fail("the firmware's outputs are not counted", list.outputs, 0) }
    if main_of("").index != 0 || main_of("").by != displays.By.ONLY { return fail("the only display is not the main one", 0, 0) }
    // (The shape: the mode the loader looked for where the monitor says
    // nothing; one that is no shape leaves the picture's size.)
    info(layout.Info.MONITOR_WIDTH, 0)
    info(layout.Info.MONITOR_HEIGHT, 0)
    info(layout.Info.WANTED_WIDTH, 3840)
    info(layout.Info.WANTED_HEIGHT, 1080)
    read()
    if list.items[0].shapeWidth != 3840 || list.items[0].shapeHeight != 1080 { return fail("the shape is not the mode the loader looked for", list.items[0].shapeWidth, list.items[0].shapeHeight) }
    info(layout.Info.WANTED_WIDTH, 100000)
    read()
    if list.items[0].shapeWidth != 1280 || list.items[0].shapeHeight != 800 { return fail("the shape is not the picture's size", list.items[0].shapeWidth, list.items[0].shapeHeight) }
    // (An EDID longer than its room is cut to it.)
    info(layout.Info.EDID_BYTES, 100000)
    read()
    if list.items[0].edidBytes != layout.Blob.EDID_ROOM { return fail("an EDID's length is not cut to its room", list.items[0].edidBytes, 0) }

    // ---- two ----
    empty()
    first(0x80000000, 800, 600)
    info(layout.Info.DISPLAYS, 3)
    info(layout.Info.OUTPUTS_UNUSABLE, 1)
    info(layout.Info.MORE_DISPLAYS, 1)
    more(0, 0x82000000, 1280, 800, 5120, 2)
    field(0, layout.More.MONITOR_WIDTH, 1920)
    field(0, layout.More.MONITOR_HEIGHT, 1200)
    field(0, layout.More.FIRMWARE_WIDTH, 1024)
    field(0, layout.More.FIRMWARE_HEIGHT, 768)
    field(0, layout.More.MODE_BY, layout.Info.MODE_NEAR_MONITOR)
    field(0, layout.More.MODE_REFUSED, 7)
    field(0, layout.More.EDID_BYTES, 128)
    read()
    if list.count != 2 || list.unusable != 1 || list.outputs != 3 || list.beyond != 0 || list.dropped != 0 { return fail("two displays are not two", list.count, list.dropped) }
    const second = &list.items[1]
    if second.*.address != 0x82000000 || second.*.width != 1280 || second.*.height != 800 || second.*.pitch != 5120 || second.*.format != 2 || second.*.first { return fail("the second display is not its record's", second.*.width, second.*.format) }
    if second.*.monitorWidth != 1920 || second.*.monitorHeight != 1200 || second.*.firmwareWidth != 1024 || second.*.firmwareHeight != 768 || second.*.modeBy != layout.Info.MODE_NEAR_MONITOR || second.*.refused != 7 { return fail("the second display's words are not its record's", second.*.monitorWidth, second.*.refused) }
    if second.*.edidAt != layout.Blob.DISPLAY_EDIDS || second.*.edidBytes != 128 || second.*.output != 2 { return fail("the second display's EDID or output is not its record's", second.*.edidAt, second.*.output) }
    if second.*.shapeWidth != 1920 || second.*.shapeHeight != 1200 { return fail("the second display's shape is not its monitor's mode", second.*.shapeWidth, second.*.shapeHeight) }
    // The main one: the second's monitor says its mode, the first's
    // nothing.
    if main_of("").index != 1 || main_of("").by != displays.By.MONITOR { return fail("the display whose monitor says its mode is not the main one", main_of("").index, main_of("").by) }
    // (Both say one: the larger. The first's larger: the first.)
    info(layout.Info.MONITOR_WIDTH, 3840)
    info(layout.Info.MONITOR_HEIGHT, 1080)
    read()
    if main_of("").index != 0 || main_of("").by != displays.By.MONITOR { return fail("the larger monitor's display is not the main one", main_of("").index, main_of("").by) }
    // (Neither says one: the larger picture.)
    info(layout.Info.MONITOR_WIDTH, 0)
    info(layout.Info.MONITOR_HEIGHT, 0)
    field(0, layout.More.MONITOR_WIDTH, 0)
    field(0, layout.More.MONITOR_HEIGHT, 0)
    read()
    if main_of("").index != 1 || main_of("").by != displays.By.PICTURE { return fail("the larger picture is not the main display", main_of("").index, main_of("").by) }
    if list.items[1].shapeWidth != 1280 || list.items[1].shapeHeight != 800 { return fail("a further display without a monitor's word has another shape than its picture", list.items[1].shapeWidth, 0) }
    // (A small picture whose monitor says its mode before a large one
    // whose monitor says nothing: a monitor is plugged in there.)
    info(layout.Info.MONITOR_WIDTH, 800)
    info(layout.Info.MONITOR_HEIGHT, 600)
    read()
    if main_of("").index != 0 || main_of("").by != displays.By.MONITOR { return fail("a monitor's word does not go before a picture's size", main_of("").index, main_of("").by) }
    // (Alike: the firmware's first.)
    info(layout.Info.MONITOR_WIDTH, 0)
    info(layout.Info.MONITOR_HEIGHT, 0)
    more(0, 0x82000000, 800, 600, 3200, 1)
    read()
    if main_of("").index != 0 || main_of("").by != displays.By.FIRST { return fail("of two alike the firmware's first is not the main one", main_of("").index, main_of("").by) }

    // ---- named in settings/display ----
    more(0, 0x82000000, 1280, 800, 5120, 1)
    read()
    list.items[0].vendor = 0x1a03
    list.items[0].device = 0x2000
    list.items[1].vendor = 0x1002
    list.items[1].device = 0x67df
    var choice = main_of("main 0\n")
    if choice.index != 0 || choice.by != displays.By.NAMED || choice.missing { return fail("\"main 0\" does not name display 0", choice.index, choice.by) }
    choice = main_of("1920x1080\nmain 1\n")
    if choice.index != 1 || choice.by != displays.By.NAMED { return fail("\"main 1\" after the mode's line does not name display 1", choice.index, choice.by) }
    choice = main_of("firmware\r\n  main\t1A03:2000  \r\n")
    if choice.index != 0 || choice.by != displays.By.NAMED { return fail("\"main 1A03:2000\" does not name the adapter's display", choice.index, choice.by) }
    choice = main_of("main 1002:67df")
    if choice.index != 1 || choice.by != displays.By.NAMED { return fail("\"main 1002:67df\" does not name the adapter's display", choice.index, choice.by) }
    // (One that is not there, a word that is none, no line: the rule.)
    choice = main_of("main 5\n")
    if choice.index != 1 || choice.by != displays.By.PICTURE || !choice.missing { return fail("a main display that is not there does not leave the rule", choice.index, choice.by) }
    choice = main_of("main 10de:1234\n")
    if choice.index != 1 || choice.by != displays.By.PICTURE || !choice.missing { return fail("an adapter that is not there does not leave the rule", choice.index, choice.by) }
    if displays.named("main radeon\n").kind != displays.Named.UNREADABLE || displays.named("main\n").kind != displays.Named.UNREADABLE || displays.named("main 12345:1\n").kind != displays.Named.UNREADABLE || displays.named("main 1x\n").kind != displays.Named.UNREADABLE { return fail("a word that names no display is read as one", 0, 0) }
    if displays.named("1920x1080\n").kind != displays.Named.NONE || displays.named("").kind != displays.Named.NONE || displays.named("mainly 1\n").kind != displays.Named.NONE || displays.named("# main 1\n").kind != displays.Named.NONE { return fail("a file without the line names a main display", 0, 0) }
    choice = main_of("main radeon\n")
    if choice.index != 1 || choice.by != displays.By.PICTURE { return fail("a word that names nothing does not leave the rule", choice.index, choice.by) }

    // ---- eight, the most; and a count beyond the room ----
    empty()
    first(0x80000000, 1024, 768)
    info(layout.Info.MORE_DISPLAYS, layout.Blob.DISPLAY_ROOM)
    var k: usize = 0
    while k < layout.Blob.DISPLAY_ROOM {
        more(k, 0x90000000 + k * 0x1000000, 640 + k * 16, 480, (640 + k * 16) * 4, 1)
        k += 1
    }
    read()
    if list.count != displays.MAX || list.beyond != 0 || list.dropped != 0 { return fail("eight displays are not eight", list.count, list.dropped) }
    k = 0
    while k < layout.Blob.DISPLAY_ROOM {
        const d = &list.items[k + 1]
        if d.*.address != 0x90000000 + k * 0x1000000 || d.*.width != 640 + k * 16 || d.*.edidAt != layout.Blob.DISPLAY_EDIDS + k * layout.Blob.EDID_ROOM { return fail("a further display is out of its order", k, d.*.width) }
        k += 1
    }
    // (The loader's own count of those it had no record for.)
    info(layout.Info.DISPLAYS_BEYOND, 2)
    read()
    if list.count != displays.MAX || list.beyond != 2 { return fail("the displays without a record are not counted", list.count, list.beyond) }
    // (A count that no loader writes: cut to the room, the rest counted;
    // nothing beyond the page is read.)
    info(layout.Info.DISPLAYS_BEYOND, 0)
    info(layout.Info.MORE_DISPLAYS, 1000)
    read()
    if list.count != displays.MAX || list.beyond != 1000 - layout.Blob.DISPLAY_ROOM { return fail("too many displays are not cut to the room", list.count, list.beyond) }
    info(layout.Info.MORE_DISPLAYS, 0xFFFFFFFFFFFFFFFF)
    read()
    if list.count != displays.MAX { return fail("a count of all ones is not cut to the room", list.count, 0) }

    // ---- records that are no picture's ----
    empty()
    first(0x80000000, 1024, 768)
    info(layout.Info.MORE_DISPLAYS, 7)
    more(0, 0, 800, 600, 3200, 1) // no memory
    more(1, 0x90000000, 0, 600, 3200, 1) // no width
    more(2, 0x91000000, 800, 600, 3196, 1) // rows shorter than their pixels
    more(3, 0x92000000, 800, 600, 3200, 3) // pixels the kernel cannot use
    more(4, 0x80000000 + 4096, 800, 600, 3200, 1) // inside the first display's memory
    more(5, 0x93000000, 20000, 600, 80000, 1) // no display's size
    more(6, 0x94000000, 800, 600, 3200, 2) // a display
    read()
    if list.count != 2 || list.dropped != 6 { return fail("records that are no picture's are not left out", list.count, list.dropped) }
    if list.items[1].address != 0x94000000 || list.items[1].format != 2 || list.items[1].edidAt != layout.Blob.DISPLAY_EDIDS + 6 * layout.Blob.EDID_ROOM { return fail("the record after those left out is not the second display", list.items[1].address, list.items[1].edidAt) }

    // ---- no first display, two further ones ----
    empty()
    info(layout.Info.DISPLAYS, 3)
    info(layout.Info.OUTPUTS_UNUSABLE, 1)
    info(layout.Info.MORE_DISPLAYS, 2)
    more(0, 0xC0000000, 1024, 768, 4096, 1)
    more(1, 0xE0000000, 1920, 1080, 7680, 1)
    read()
    if list.count != 2 || list.items[0].first || list.items[1].first || list.items[0].address != 0xC0000000 || list.items[1].address != 0xE0000000 { return fail("two cards behind a console's output without pixels are not two displays", list.count, 0) }
    if main_of("").index != 1 || main_of("").by != displays.By.PICTURE { return fail("the larger of the two cards' pictures is not the main display", main_of("").index, 0) }
    // (A first display whose numbers are nothing is none; the further
    // ones stay.)
    info(layout.Info.FB_ADDRESS, 0xA0000000)
    read()
    if list.count != 2 || list.items[0].address != 0xC0000000 { return fail("a first display without a size is one", list.count, 0) }
    return 13
}
