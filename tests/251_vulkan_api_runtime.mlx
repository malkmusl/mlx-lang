// std.vulkan without a driver: struct initialization (zeroed, sType set),
// enumerations, bits, constants, API versions and dispatch-table wrappers
// driven by a fake command. Exits 13.
const vk = @import("std.vulkan")

fn fakeEnumerateInstanceVersion(version: *u32) -> vk.Result {
    version.* = vk.makeApiVersion(0, 1, 3, 275)
    return vk.Result.success
}

fn fakeGetInstanceProcAddr(instance: vk.Instance, name: [*]const u8) -> usize {
    // "vkEnumerateInstanceVersion"
    if name[2] == 69 && name[11] == 73 && name[19] == 86 { return @intFromPtr(fakeEnumerateInstanceVersion) }
    return 0
}

pub fn main() -> u8 {
    var info = vk.InstanceCreateInfo.init()
    if info.sType != vk.StructureType.instanceCreateInfo || info.pNext != null || info.enabledExtensionCount != 0 { return 1 }
    var application = vk.ApplicationInfo.init()
    application.apiVersion = vk.API_VERSION_1_3
    info.pApplicationInfo = &application
    if info.pApplicationInfo.?.*.apiVersion != 4206592 { return 2 }
    const swapchain = vk.SwapchainCreateInfoKHR.init()
    if @intFromEnum(swapchain.sType) != 1000001000 { return 3 }
    if @intFromEnum(vk.Result.errorOutOfDateKhr) != -1000001004 || @intFromEnum(vk.Result.suboptimalKhr) != 1000001003 { return 4 }
    if @intFromEnum(vk.Format.r8g8b8a8Unorm) != 37 || @intFromEnum(vk.ImageType.type2d) != 1 { return 5 }
    if @intFromEnum(vk.Format.undefined_) != 0 || @intFromEnum(vk.PresentModeKHR.fifo) != 2 { return 6 }
    if vk.BUFFER_USAGE_STORAGE_BUFFER_BIT != 32 || vk.MEMORY_PROPERTY_HOST_COHERENT_BIT != 4 { return 7 }
    if vk.WHOLE_SIZE != 18446744073709551615 || vk.QUEUE_FAMILY_IGNORED != 4294967295 { return 8 }
    if vk.MAX_EXTENSION_NAME_SIZE != 256 || vk.UUID_SIZE != 16 { return 9 }
    if vk.KHR_SURFACE_SPEC_VERSION != 25 { return 10 }
    var extension: [*]const u8 = undefined
    unsafe { extension = @ptrCast([*]const u8, vk.KHR_SURFACE_EXTENSION_NAME) }
    if extension[3] != 75 || extension[14] != 0 { return 11 }
    if @sizeOf(vk.PhysicalDeviceProperties) != 824 || @offsetOf(vk.PhysicalDeviceProperties, "limits") != 296 { return 12 }

    var global: vk.GlobalCommands = undefined
    vk.loadGlobalCommands(&global, @intFromPtr(fakeGetInstanceProcAddr))
    if global.vkCreateInstance != 0 || global.vkEnumerateInstanceVersion == 0 { return 14 }
    var version: u32 = 0
    if vk.enumerateInstanceVersion(&global, &version) != vk.Result.success { return 15 }
    if vk.apiVersionMajor(version) != 1 || vk.apiVersionMinor(version) != 3 || vk.apiVersionPatch(version) != 275 { return 16 }
    return 13
}
