// The address of a module-level constant of one word, of this module or
// of an imported one: a constant has no storage, so the address is of a
// copy of its value in the function (`&LIMIT` where a `*const u32` is
// taken, `&kMessage` where C++ takes a `const char *const &`). The
// address named garbage before.
// Exits 13.
const other = @import("./support/constant_address.mlx")

const k: u32 = 7
const text: [*]const u8 = "seven!!".pointer
const maybe: ?[*]const u8 = "seven!!".pointer
const half: f64 = 0.5
const yes: bool = true

fn read(p: *const u32) -> u32 { return p.* }
fn first(p: *const [*]const u8) -> u8 { return p.*[0] }
fn length(list: [*]const ?[*]const u8) -> u32 {
    var n: u32 = 0
    while list[0].?[@intCast(usize, n)] != 0 { n += 1 }
    return n
}
fn twice(p: *const f64) -> f64 { return p.* * 2.0 }
fn flag(p: *const bool) -> bool { return p.* }

pub fn main() -> u8 {
    if read(&k) != 7 { return 1 }
    if first(&text) != 115 { return 2 }
    if length(&maybe) != 7 { return 3 }
    if twice(&half) != 1.0 { return 4 }
    if !flag(&yes) { return 5 }
    if read(&other.LIMIT) != 7 { return 6 }
    if first(&other.TEXT) != 115 { return 7 }
    return @intCast(u8, read(&k) + read(&other.LIMIT)) - 1
}
