const types = @import("../compiler/selfhost/types.zin")
const page_allocator = @import("../std/bootstrap/page_allocator.zin")

pub fn main() -> u8 {
    var store = types.init(page_allocator.init())
    const void_type = types.primitive(&store, types.Kind.void_type)
    const comptime_int = types.primitive(&store, types.Kind.comptime_int_type)
    const u8_type = types.integer(&store, false, 8)
    const u8_again = types.integer(&store, false, 8)
    const i13_type = types.integer(&store, true, 13)
    if u8_type != u8_again { return 1 }
    if types.get(&store, i13_type).*.kind != types.Kind.integer { return 21 }
    if types.get(&store, i13_type).*.bits != 13 { return 22 }
    if types.bitSizeOf(&store, i13_type) != 13 { return 11 }
    if types.sizeOf(&store, i13_type) != 2 { return 12 }
    const mutable_pointer = types.pointer(&store, u8_type, false, false, false)
    const const_pointer = types.pointer(&store, u8_type, true, false, false)
    if !types.isCoercible(&store, mutable_pointer, const_pointer) { return 2 }
    if types.isCoercible(&store, const_pointer, mutable_pointer) { return 3 }
    const byte_slice = types.slice(&store, u8_type, true)
    if types.sizeOf(&store, byte_slice) != 16 || types.alignOf(&store, byte_slice) != 8 { return 4 }
    const bytes = types.array(&store, u8_type, 17)
    if types.sizeOf(&store, bytes) != 17 { return 5 }
    const optional_pointer = types.optional(&store, mutable_pointer)
    if types.sizeOf(&store, optional_pointer) != 8 { return 6 }
    if !types.isCoercible(&store, comptime_int, u8_type) { return 7 }
    const owned_byte = types.noCopy(&store, u8_type)
    const extra_start = types.appendExtra(&store, owned_byte)
    types.appendExtra(&store, u8_type)
    const pair = types.tuple(&store, extra_start, 2)
    if types.get(&store, pair).*.copyability != types.Copyability.contains_nocopy { return 8 }
    const function_type = types.function(&store, void_type, extra_start, 2)
    if types.get(&store, function_type).*.extraLength != 2 { return 9 }
    if types.integer(&store, false, 0) != 0 || types.integer(&store, true, 4097) != 0 { return 10 }
    var width: usize = 1
    while width <= 96 {
        if types.integer(&store, false, width) == 0 { return 14 }
        width += 1
    }
    var extra_count: usize = 0
    var last_extra: usize = 0
    while extra_count < 160 {
        last_extra = types.appendExtra(&store, u8_type)
        if last_extra == types.NONE { return 15 }
        extra_count += 1
    }
    if types.extraAt(&store, last_extra) != u8_type { return 16 }
    types.deinit(&store)
    return 13
}
