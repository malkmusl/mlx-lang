const bootstrap = @import("../std/bootstrap/root.zin")
const source = @import("../compiler/selfhost/source.zin")

pub fn main() -> u8 {
    const allocator = bootstrap.page_allocator.init()
    unsafe {
        const path = @ptrCast([*]const u8, "/tmp/zin-bootstrap-source")
        const output = bootstrap.fs.open(path, bootstrap.fs.WRITE_ONLY | bootstrap.fs.CREATE | bootstrap.fs.TRUNCATE, 384)
        if !bootstrap.fs.isValid(output) || !bootstrap.fs.writeAll(output, "const value = 13\n") || !bootstrap.fs.close(output) {
            return 1
        }
        const loaded = source.load(allocator, path, 25)
        if !loaded.valid || loaded.length != 17 || source.contents(loaded)[0] != 99 || source.contents(loaded)[16] != 10 {
            return 2
        }
        source.deinit(loaded)
        if !bootstrap.fs.delete(path) { return 3 }
    }
    return 13
}
