// std.process.optionValue takes an option's value from the rest of its
// argument ("-n5") or else from the next one ("-n 5", moving the index),
// null after the last argument; std.io.writeUnsignedBase writes numbers
// in bases 8, 10 and 16 (lowercase) and 0. Exits 13.
const std = @import("std")

fn same(value: std.string.String, expected: []const u8) -> bool {
    return std.string.eql(value, std.string.fromSlice(expected))
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var fake: [4][*]const u8 = undefined
    unsafe {
        fake[0] = @ptrCast([*]const u8, "program\0")
        fake[1] = @ptrCast([*]const u8, "-n\0")
        fake[2] = @ptrCast([*]const u8, "5\0")
        fake[3] = @ptrCast([*]const u8, "-x\0")
    }
    const list = fake[0..4]
    var index: usize = 1
    const attached = std.process.optionValue(list, &index, std.string.fromSlice("7"))
    if attached == null || !same(attached.?, "7") || index != 1 { return 1 }
    const next = std.process.optionValue(list, &index, std.string.fromSlice(""))
    if next == null || !same(next.?, "5") || index != 2 { return 2 }
    index = 3
    const missing = std.process.optionValue(list, &index, std.string.fromSlice(""))
    if missing != null { return 3 }

    const pipe = std.fs.makePipe()
    if pipe == null { return 4 }
    const write_end = std.fs.File.{ .descriptor = pipe.?.writeDescriptor }
    const read_end = std.fs.File.{ .descriptor = pipe.?.readDescriptor }
    if !std.io.writeUnsignedBase(write_end, 493, 8) { return 5 }
    if !std.io.writeUnsignedBase(write_end, 0, 10) { return 5 }
    if !std.io.writeUnsignedBase(write_end, 48879, 16) { return 5 }
    if !std.io.writeUnsignedBase(write_end, 1234567890, 10) { return 5 }
    const closed = std.fs.close(write_end)
    var buffer: [64]u8 = undefined
    var length: usize = 0
    while true {
        var amount: isize = 0
        unsafe { amount = std.fs.read(read_end, @ptrFromInt([*]u8, @intFromPtr(&buffer) + length), 64 - length) }
        if amount <= 0 { break }
        length += @bitCast(usize, amount)
    }
    var text: std.string.String = undefined
    unsafe { text = std.string.fromParts(@ptrCast([*]const u8, &buffer), length) }
    if !same(text, "7550beef1234567890") { return 6 }
    return 13
}
