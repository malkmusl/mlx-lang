// What the GPU's driver does with the display at a boot
// (projects/brix/display_choice.mlx: the choice from a key at this
// start, what the machine remembers, the image's settings/gpu and the
// default), on the host, against the rules written out here a second
// time:
// - the keys: of every character a keyboard can give, f n r a and F N R
//   A alone are keys, each the choice it stands for; F and N are
//   remembered by their letter, R and A are not;
// - what the machine remembers: one byte, F or N; no variable, another
//   byte, a small letter, more bytes than one (F first too) and nothing
//   at all are no choice; what the loader writes after a key for every
//   size and first byte a variable can have (only F and N, only when the
//   variable is not just that already);
// - the image's word: the four names alone or before a blank or a line's
//   end; a longer word, a shorter one, capitals and an empty file name
//   none;
// - every combination of key, remembered variable, image word and what
//   the loader says of the firmware (no keyboard, no variable store, a
//   write taken or refused), through the word as the loader hands it
//   over: the key first, then what is remembered, then the image, then
//   native; where the choice came from; whether the key is remembered
//   now. A word of 0 (a loader from before this, or Multiboot) and a
//   word without the loader's mark, whatever else is in it, give the
//   image's word or the default. A key counts only as a letter of ours
//   from a loader with a keyboard, and what is remembered only from one
//   with a variable store;
// - only native and rehearsal let the driver write the display's
//   registers and run the card's tables (tests 460 and 474 hold that
//   firmware and ask then write nothing and run no table);
// - the log's lines, word for word: the default with its key, F
//   remembered from an earlier start, each key at this start (remembered
//   or for the one boot), a write the firmware refused with its status, a
//   machine without a keyboard or a variable store, something remembered
//   that is no choice, an image word that names none, a boot without a
//   loader of ours (no key is named), and without a card of ours; how
//   long the loader looked; what the loader itself says for each key;
// - the word's fields as the loader packs them: the ticks in counts of
//   65536 and no more than 24 bits of them, a size of 255 for more, the
//   status's lowest byte.
// And the EFI loader's own part (projects/brix/image/efi.mlx: the text
// brix-image puts at the application's entry) run here, against a
// firmware that is a table (tests/support/choice_firmware.mlx): entered
// as a firmware enters an application, it has to hand over the word the
// rules give, write the variable when and only when they say so, say the
// key's line, and leave the registers and the stack as it found them:
// - every key list (none, each key in either case, a character that is
//   none, a key that has only a scan code, two keys of which the last
//   counts, a key behind others, one that comes after looks without a
//   key) with every variable (none, F, N, another byte, two bytes, eight,
//   more than the loader has room for, a store that fails) and a write
//   that is taken, refused as write protected, refused for want of room;
// - a key that comes after 0 to 40 looks without one: taken up to the
//   wait's end, with as many waits of the slice's length as that took,
//   and not after it; a boot without a key waits the whole wait, one
//   with a key not at all; a keyboard that never runs out of keys is
//   left after the reads it is given; one that fails is said to, and the
//   boot goes on after the wait;
// - a firmware that lacks something: no system table, no console input,
//   no ReadKeyStroke, no boot services, no Stall (then no waiting), no
//   run-time services, no GetVariable, no SetVariable, no console
//   output, no OutputString, and all of it at once: nothing that is not
//   there is called, and the word says what was missing;
// - every call of a service with its stack aligned and the variable
//   named as it is; what the kernel makes of each word is the choice the
//   rules give.
// Exits 13.
const std = @import("std")
const choice = @import("../projects/brix/display_choice.mlx")
const firmware = @import("./support/choice_firmware.mlx")

const Choice = choice.Choice
const Source = choice.Source
const Kept = choice.Kept
const Word = choice.Word

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

fn fail(what: []const u8, a: usize, b: usize) -> u8 {
    say("FAIL ")
    say(what)
    say(" (")
    number(a)
    say(", ")
    number(b)
    say(")\n")
    return 1
}

// What `say` and `sayWait` wrote.
const ROOM: usize = 4096
var log: [ROOM]u8 = undefined
var logged: usize = 0

fn logWrite(text: []const u8) -> void {
    var k: usize = 0
    while k < text.length && logged < ROOM {
        log[logged] = text[k]
        logged += 1
        k += 1
    }
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var k: usize = 0
    while k < a.length {
        if a[k] != b[k] { return false }
        k += 1
    }
    return true
}

// Whether the lines for the word `word` and the image's `image` (with a
// card or without) are exactly `wanted`.
fn lines(word: usize, image: []const u8, card: bool, wanted: []const u8) -> bool {
    const d = choice.decide(word, image)
    logged = 0
    choice.say(logWrite, &d, card)
    if same(log[0..logged], wanted) { return true }
    say("got:    ")
    say(log[0..logged])
    say("wanted: ")
    say(wanted)
    return false
}

// The rules a second time, as plainly as they can be written. A key's
// choice (0: no key).
fn expectedOfKey(key: u8) -> Choice {
    return match key {
        70 => Choice.firmware,
        78 => Choice.native,
        82 => Choice.rehearsal,
        65 => Choice.ask,
        else => Choice.none
    }
}

// The image words tried and what each names.
const IMAGES = [_][]const u8{ "", "native", "native\n", "firmware", "firmware \n# kept\n", "rehearsal\r\n", "ask\tnow", "ask", "native-off", "nativ", "Native", "FIRMWARE", "firm ware", " native", "\n", "rehearsals", "asks" }
const IMAGE_NAMES = [_]Choice{ Choice.none, Choice.native, Choice.native, Choice.firmware, Choice.firmware, Choice.rehearsal, Choice.ask, Choice.ask, Choice.none, Choice.none, Choice.none, Choice.none, Choice.none, Choice.none, Choice.none, Choice.none, Choice.none }

// The variables tried: how many bytes, the first.
const SIZES = [_]usize{ 0, 1, 1, 1, 1, 1, 1, 2, 2, 8, 255, 300, 1, 1 }
const BYTES = [_]u8{ 0, 70, 78, 82, 65, 102, 0, 70, 78, 70, 78, 70, 255, 110 }

// The keys tried, as the loader's word could hold them: none, the four,
// and bytes that are no key of ours (a small letter is one only on the
// keyboard: the loader hands over the capital).
const KEY_BYTES = [_]u8{ 0, 70, 78, 82, 65, 102, 1, 255, 71 }

// ---- the loader's part, run ----

// The keys of a start, and how many.
var list: [firmware.KEYS]firmware.Key = undefined
var listed: usize = 0

fn key(character: usize) -> void {
    list[listed] = firmware.Key.of(character)
    listed += 1
}

fn noKeyYet() -> void {
    list[listed] = firmware.Key.notYet()
    listed += 1
}

var saidText: [256]u8 = undefined

// One start of the loader's part with the keys listed, held against the
// rules: what the keyboard answers when the list is used up (`idle`),
// the variable (`status`: the store's answer when not 0; else `size`
// bytes, the first eight `data`), a write's answer (`refusal`), and what
// of the firmware is there. 0, or the number of what did not hold.
fn held(idle: usize, status: usize, size: usize, data: usize, refusal: usize, has: *const firmware.Has) -> usize {
    const left = firmware.start(list[0..listed], idle, status, size, data, refusal, has)
    // The rules. The keys: read until the keyboard has none; the last of
    // ours counts; with none of ours, a wait and another look, as often
    // as the wait has slices.
    const keyboard = has.*.table && has.*.input && has.*.read
    var taken: u8 = 0
    var reads: usize = 0
    var stalls: usize = 0
    var flags: usize = 0
    var failing: usize = 0
    if keyboard {
        var slices: usize = if has.*.boot && has.*.stall { choice.WAIT / choice.SLICE } else { 0 }
        var at: usize = 0
        while true {
            const answer = if at < listed { list[at].status } else { idle }
            const character = if at < listed { list[at].character } else { 0 }
            at += 1
            reads += 1
            if answer == 0 {
                if choice.keyOf(character) != 0 { taken = choice.keyOf(character) }
                if reads == choice.READS { break }
                continue
            }
            if answer != firmware.NOT_READY {
                flags |= Word.KEYBOARD_FAILED
                failing = answer
            }
            if taken != 0 || slices == 0 { break }
            slices -= 1
            stalls += 1
        }
    } else {
        flags |= Word.NO_KEYBOARD
    }
    if left.reads != reads { return 1 }
    if left.stalls != stalls || left.stalled != stalls * choice.SLICE * 1000 { return 2 }
    // The variable: as the store has it.
    const store = has.*.table && has.*.runtime && has.*.get && has.*.set
    var size8: usize = 0
    var first: u8 = 0
    var real: usize = 0
    if store {
        if left.gets != 1 || left.getRoom != 8 || left.getAttributes != 0 { return 3 }
        if status != 0 {
            if status != firmware.NOT_FOUND {
                flags |= Word.READ_FAILED
                failing = status
            }
        } else {
            real = size
            size8 = if size > Word.MANY { Word.MANY } else { size }
            // (Of more bytes than its room the loader does not have the
            // first.)
            if size <= 8 { first = @intCast(u8, data & 0xFF) }
        }
    } else {
        flags |= Word.NO_STORE
        if left.gets != 0 { return 4 }
    }
    // What is written: as `toWrite` says, one byte, with the variable's
    // attributes.
    const writing: u8 = if store { choice.toWrite(taken, real, first) } else { 0 }
    if writing != 0 {
        if left.sets != 1 || left.setByte != @intCast(usize, writing) || left.setSize != 1 || left.setAttributes != choice.ATTRIBUTES { return 5 }
        if refusal == 0 {
            flags |= Word.WROTE
        } else {
            flags |= Word.REFUSED
            failing = refusal
        }
    } else if left.sets != 0 {
        return 6
    }
    if !left.named || !left.owned { return 7 }
    // The word (but for how long the loader looked).
    const wanted = Word.of(taken, size8, first, flags, 0, failing)
    const ticks = Word.TICKS_MOST << @intCast(u6, Word.TICKS_SHIFT)
    if left.word & ~ticks != wanted { return 8 }
    if !keyboard && left.word & ticks != 0 { return 9 }
    // The console: the key's line and a line's end, once; nothing
    // without a key or without a console.
    const length = firmware.said(saidText[0..])
    if taken != 0 && has.*.table && has.*.output && has.*.say {
        const line = choice.loaderLine(taken, flags & (Word.REFUSED | Word.NO_STORE) == 0)
        if left.says != 1 || length != line.length + 2 || !same(saidText[0..line.length], line) || saidText[line.length] != 13 || saidText[line.length + 1] != 10 { return 10 }
    } else if left.says != 0 {
        return 11
    }
    // The registers as they were, every call's stack aligned.
    if left.rcx != firmware.HANDLE || left.rdx != left.table || left.rbx != firmware.RBX || left.rsi != firmware.RSI { return 12 }
    if left.crooked != 0 { return 13 }
    // And what the kernel makes of the word.
    const d = choice.decide(left.word, "")
    var chosen = Choice.native
    if taken != 0 {
        chosen = expectedOfKey(taken)
    } else if store && status == 0 && size == 1 && (first == 70 || first == 78) {
        chosen = expectedOfKey(first)
    }
    if d.choice != chosen || d.key != taken { return 14 }
    return 0
}

// The key lists tried with every variable.
fn keysOf(n: usize) -> bool {
    listed = 0
    if n == 0 { return true }
    if n == 1 { key(102) } else if n == 2 { key(70) } else if n == 3 { key(110) } else if n == 4 { key(78) } else if n == 5 { key(114) } else if n == 6 { key(82) } else if n == 7 { key(97) } else if n == 8 { key(65) } else if n == 9 {
        // A character that is none of ours, and a key with a scan code
        // alone (an arrow, a function key).
        key(120)
        key(0)
    } else if n == 10 {
        key(102)
        key(110)
    } else if n == 11 {
        key(110)
        key(13)
        key(70)
    } else if n == 12 {
        key(82)
        key(0x146)
        key(27)
    } else if n == 13 {
        noKeyYet()
        noKeyYet()
        key(110)
    } else if n == 14 {
        key(32)
        noKeyYet()
        key(97)
        key(102)
    } else {
        return false
    }
    return true
}

fn loaderRuns() -> u8 {
    if !firmware.make() {
        say("the loader's part could not be run here: ")
        say(firmware.problem())
        say("\n")
        return 1
    }
    const all = firmware.Has.all()
    // Every key list with every variable and every answer to a write.
    const STATUS = [_]usize{ firmware.NOT_FOUND, 0, 0, 0, 0, 0, 0, 0, 0, firmware.DEVICE_ERROR }
    const SIZE = [_]usize{ 0, 0, 1, 1, 1, 1, 2, 8, 300, 0 }
    const DATA = [_]usize{ 0, 0, 70, 78, 82, 0, 0x4e46, 0x4e4e4e4e4e4e4e46, 70, 0 }
    const REFUSAL = [_]usize{ 0, firmware.WRITE_PROTECTED, firmware.OUT_OF_RESOURCES }
    var n: usize = 0
    var runs: usize = 0
    while keysOf(n) {
        var v: usize = 0
        while v < STATUS.length {
            var r: usize = 0
            while r < REFUSAL.length {
                const wrong = held(firmware.NOT_READY, STATUS[v], SIZE[v], DATA[v], REFUSAL[r], &all)
                if wrong != 0 { return fail("the loader's part, a key list with a variable", n * 100 + v * 10 + r, wrong) }
                runs += 1
                r += 1
            }
            v += 1
        }
        n += 1
    }
    if n != 15 || runs != 15 * 10 * 3 { return fail("every key list with every variable", n, runs) }
    // A key after so many looks without one: taken up to the wait's end.
    var looks: usize = 0
    while looks <= 40 {
        listed = 0
        while listed < looks { noKeyYet() }
        key(102)
        const wrong = held(firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
        if wrong != 0 { return fail("the loader's part, a key after looks without one", looks, wrong) }
        const left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
        const inTime = looks <= choice.WAIT / choice.SLICE
        if (left.word & Word.KEY == 70) != inTime { return fail("a key is taken up to the wait's end and not after it", looks, left.word & Word.KEY) }
        if left.stalls != (if inTime { looks } else { choice.WAIT / choice.SLICE }) { return fail("as many waits as the key took", looks, left.stalls) }
        looks += 1
    }
    // Without a key: the whole wait, in the slice's length; with one at
    // once: none.
    listed = 0
    var left = firmware.start(list[0..0], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    if left.stalled != choice.WAIT * 1000 || left.reads != choice.WAIT / choice.SLICE + 1 || left.says != 0 || left.sets != 0 { return fail("a boot without a key waits the wait, says and writes nothing", left.stalled, left.reads) }
    key(70)
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    if left.stalled != 0 || left.reads != 2 { return fail("a boot with a key does not wait", left.stalled, left.reads) }
    // A keyboard that never runs out of keys: left after the reads it is
    // given, the last of those counting.
    listed = 0
    while listed < 300 { key(102) }
    key(110)
    var wrong = held(firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    if wrong != 0 { return fail("the loader's part, a keyboard that never runs out", 0, wrong) }
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &all)
    if left.reads != choice.READS || left.word & Word.KEY != 70 || left.stalls != 0 { return fail("a keyboard that never runs out is left", left.reads, left.word & Word.KEY) }
    // A keyboard that fails at every look, and one that fails once and
    // then has a key.
    listed = 0
    wrong = held(firmware.DEVICE_ERROR, 0, 1, 70, 0, &all)
    if wrong != 0 { return fail("the loader's part, a keyboard that fails", 0, wrong) }
    left = firmware.start(list[0..0], firmware.DEVICE_ERROR, 0, 1, 70, 0, &all)
    if left.word & Word.KEYBOARD_FAILED == 0 || left.word >> 56 != 7 || left.stalls != choice.WAIT / choice.SLICE { return fail("a keyboard that fails is said to, after the wait", left.word >> 56, left.stalls) }
    list[0] = firmware.Key.failing(firmware.DEVICE_ERROR)
    listed = 1
    key(114)
    wrong = held(firmware.NOT_READY, 0, 1, 70, 0, &all)
    if wrong != 0 { return fail("the loader's part, a keyboard that fails once", 0, wrong) }
    // A firmware that lacks something, one thing at a time and all at
    // once, with F pressed and N remembered (so that everything there
    // is to do would be done).
    var missing: usize = 0
    while missing <= 10 {
        var has = firmware.Has.all()
        if missing == 0 || missing == 10 { has.table = false }
        if missing == 1 || missing == 10 { has.input = false }
        if missing == 2 || missing == 10 { has.read = false }
        if missing == 3 || missing == 10 { has.boot = false }
        if missing == 4 || missing == 10 { has.stall = false }
        if missing == 5 || missing == 10 { has.runtime = false }
        if missing == 6 || missing == 10 { has.get = false }
        if missing == 7 || missing == 10 { has.set = false }
        if missing == 8 || missing == 10 { has.output = false }
        if missing == 9 || missing == 10 { has.say = false }
        listed = 0
        key(70)
        wrong = held(firmware.NOT_READY, 0, 1, 78, 0, &has)
        if wrong != 0 { return fail("the loader's part on a firmware that lacks something, F pressed", missing, wrong) }
        // The same with the key after a look without one (no waiting
        // without a Stall), and without a key.
        listed = 0
        noKeyYet()
        key(110)
        wrong = held(firmware.NOT_READY, 0, 1, 70, firmware.WRITE_PROTECTED, &has)
        if wrong != 0 { return fail("the loader's part on a firmware that lacks something, N after a look", missing, wrong) }
        listed = 0
        wrong = held(firmware.NOT_READY, 0, 1, 70, 0, &has)
        if wrong != 0 { return fail("the loader's part on a firmware that lacks something, no key", missing, wrong) }
        missing += 1
    }
    // What the missing parts come to, in the word.
    var bare = firmware.Has.all()
    bare.table = false
    listed = 0
    key(70)
    left = firmware.start(list[0..listed], firmware.NOT_READY, 0, 1, 78, 0, &bare)
    if left.word != Word.LOOKED | Word.NO_KEYBOARD | Word.NO_STORE || left.reads != 0 || left.gets != 0 || left.sets != 0 || left.says != 0 || left.stalls != 0 { return fail("no system table: nothing is called, and the word says so", left.word, left.reads) }
    var still = firmware.Has.all()
    still.stall = false
    listed = 0
    noKeyYet()
    key(70)
    left = firmware.start(list[0..listed], firmware.NOT_READY, firmware.NOT_FOUND, 0, 0, 0, &still)
    if left.word & Word.KEY != 0 || left.reads != 1 || left.stalls != 0 { return fail("no Stall: no waiting, the keys the firmware kept are all", left.word & Word.KEY, left.reads) }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    // The keys.
    var character: usize = 0
    while character < 0x10000 {
        var wanted: u8 = 0
        if character == 70 || character == 102 { wanted = 70 }
        if character == 78 || character == 110 { wanted = 78 }
        if character == 82 || character == 114 { wanted = 82 }
        if character == 65 || character == 97 { wanted = 65 }
        if choice.keyOf(character) != wanted { return fail("a character's key", character, @intCast(usize, choice.keyOf(character))) }
        character += 1
    }
    var key: usize = 0
    while key < 256 {
        const k = @intCast(u8, key)
        if choice.ofKey(k) != expectedOfKey(k) { return fail("a key's choice", key, 0) }
        const remembered: u8 = if key == 70 || key == 78 { k } else { 0 }
        if choice.kept(k) != remembered { return fail("the byte a key is remembered by", key, @intCast(usize, choice.kept(k))) }
        key += 1
    }
    if choice.KEYS.length != 4 { return fail("four keys", choice.KEYS.length, 4) }

    // What the machine remembers, and what the loader writes: every size
    // and first byte, after every key.
    var size: usize = 0
    while size < 300 {
        var byte: usize = 0
        while byte < 256 {
            const b = @intCast(u8, byte)
            var wanted = Choice.none
            if size == 1 && byte == 70 { wanted = Choice.firmware }
            if size == 1 && byte == 78 { wanted = Choice.native }
            if choice.ofKept(size, b) != wanted { return fail("what a variable remembers", size, byte) }
            var n: usize = 0
            while n < KEY_BYTES.length {
                const pressed = KEY_BYTES[n]
                var written: u8 = 0
                if (pressed == 70 || pressed == 78) && !(size == 1 && b == pressed) { written = pressed }
                if choice.toWrite(pressed, size, b) != written { return fail("what the loader writes", size * 1000 + byte, @intCast(usize, pressed)) }
                n += 1
            }
            byte += 1
        }
        size += 1
    }

    // The image's word.
    var i: usize = 0
    while i < IMAGES.length {
        if choice.ofText(IMAGES[i]) != IMAGE_NAMES[i] { return fail("an image's word", i, 0) }
        i += 1
    }

    // Who may write.
    if !choice.writes(Choice.native) || !choice.writes(Choice.rehearsal) { return fail("native and rehearsal write", 0, 0) }
    if choice.writes(Choice.firmware) || choice.writes(Choice.ask) || choice.writes(Choice.none) { return fail("firmware and ask write nothing", 0, 0) }

    // Every combination, through the loader's word. The flags tried:
    // nothing wrong, no keyboard, no store, a write taken, a write
    // refused, a read that failed, a keyboard that failed.
    const FLAGS = [_]usize{ 0, Word.NO_KEYBOARD, Word.NO_STORE, Word.WROTE, Word.REFUSED, Word.READ_FAILED, Word.KEYBOARD_FAILED, Word.NO_KEYBOARD | Word.NO_STORE }
    var combinations: usize = 0
    var kn: usize = 0
    while kn < KEY_BYTES.length {
        var vn: usize = 0
        while vn < SIZES.length {
            i = 0
            while i < IMAGES.length {
                var fl: usize = 0
                while fl < FLAGS.length {
                    const flags = FLAGS[fl]
                    const word = Word.of(KEY_BYTES[kn], SIZES[vn], BYTES[vn], flags, 0, 0)
                    const d = choice.decide(word, IMAGES[i])
                    // The rules.
                    const keyboard = flags & Word.NO_KEYBOARD == 0
                    const store = flags & Word.NO_STORE == 0
                    const pressed: u8 = if keyboard && expectedOfKey(KEY_BYTES[kn]) != Choice.none { KEY_BYTES[kn] } else { 0 }
                    var held = Choice.none
                    if store && SIZES[vn] == 1 && BYTES[vn] == 70 { held = Choice.firmware }
                    if store && SIZES[vn] == 1 && BYTES[vn] == 78 { held = Choice.native }
                    var wanted = Choice.native
                    var from = Source.by_default
                    if pressed != 0 {
                        wanted = expectedOfKey(pressed)
                        from = Source.key
                    } else if held != Choice.none {
                        wanted = held
                        from = Source.remembered
                    } else if IMAGE_NAMES[i] != Choice.none {
                        wanted = IMAGE_NAMES[i]
                        from = Source.image
                    }
                    const code = kn * 1000000 + vn * 10000 + i * 100 + fl
                    if d.choice != wanted || d.source != from { return fail("a combination's choice", code, @intCast(usize, @intFromEnum(d.choice))) }
                    if d.key != pressed { return fail("a combination's key", code, @intCast(usize, d.key)) }
                    // Whether the key is remembered now.
                    var became = Kept.nothing
                    if pressed == 70 || pressed == 78 {
                        if !store {
                            became = Kept.no_store
                        } else if flags & Word.REFUSED != 0 {
                            became = Kept.refused
                        } else if flags & Word.WROTE != 0 {
                            became = Kept.written
                        } else if held == wanted {
                            became = Kept.held
                        } else {
                            became = Kept.refused
                        }
                    }
                    if d.kept != became { return fail("whether a combination's key is remembered", code, @intCast(usize, @intFromEnum(d.kept))) }
                    const garbage = store && SIZES[vn] != 0 && held == Choice.none
                    if d.garbage != garbage { return fail("something remembered that is no choice", code, 0) }
                    if d.imageUnknown != (IMAGES[i].length != 0 && IMAGE_NAMES[i] == Choice.none) { return fail("an image word that names none", code, 0) }
                    if !d.looked || d.keyboard != keyboard || d.store != store { return fail("what the loader says of the firmware", code, 0) }
                    // Without the loader's mark the same word is nothing:
                    // the image's word, else native.
                    const blind = choice.decide(word & ~Word.LOOKED, IMAGES[i])
                    const plain = if IMAGE_NAMES[i] != Choice.none { IMAGE_NAMES[i] } else { Choice.native }
                    if blind.looked || blind.choice != plain || blind.key != 0 || blind.kept != Kept.nothing || blind.garbage || blind.source == Source.key || blind.source == Source.remembered { return fail("a word without the loader's mark", code, 0) }
                    combinations += 1
                    fl += 1
                }
                i += 1
            }
            vn += 1
        }
        kn += 1
    }
    if combinations != KEY_BYTES.length * SIZES.length * IMAGES.length * FLAGS.length { return fail("every combination", combinations, 0) }
    // A word of 0.
    const none = choice.decide(0, "")
    if none.choice != Choice.native || none.source != Source.by_default || none.looked { return fail("no loader, no image word: native by default", 0, 0) }
    const fixed = choice.decide(0, "firmware\n")
    if fixed.choice != Choice.firmware || fixed.source != Source.image { return fail("no loader, the image says firmware", 0, 0) }

    // The log's lines.
    const looked = Word.of(0, 0, 0, 0, 0, 0)
    if !lines(looked, "", true, "gpu: this boot: the monitor's own mode (the default; F while the machine starts keeps the firmware's picture)\n") { return fail("the default's line", 0, 0) }
    if !lines(Word.of(0, 1, 70, 0, 0, 0), "", true, "gpu: this boot: the firmware's picture is kept (F was pressed at an earlier start and is remembered; N sets the monitor's own mode again)\n") { return fail("F remembered", 0, 0) }
    if !lines(Word.of(0, 1, 78, 0, 0, 0), "firmware", true, "gpu: this boot: the monitor's own mode (N was pressed at an earlier start and is remembered; F while the machine starts keeps the firmware's picture)\n") { return fail("N remembered, before the image's word", 0, 0) }
    if !lines(Word.of(70, 0, 0, Word.WROTE, 0, 0), "", true, "gpu: this boot: the firmware's picture is kept (F was pressed at this start and is remembered; N sets the monitor's own mode again)\n") { return fail("F at this start, written", 0, 0) }
    if !lines(Word.of(70, 1, 70, 0, 0, 0), "", true, "gpu: this boot: the firmware's picture is kept (F was pressed at this start and is remembered; N sets the monitor's own mode again)\n") { return fail("F at this start, held already", 0, 0) }
    if !lines(Word.of(78, 1, 70, Word.WROTE, 0, 0), "", true, "gpu: this boot: the monitor's own mode (N was pressed at this start and is remembered; F while the machine starts keeps the firmware's picture)\n") { return fail("N at this start", 0, 0) }
    if !lines(Word.of(82, 1, 70, 0, 0, 0), "", true, "gpu: this boot: the firmware's own mode set again by the card's tables (R was pressed at this start and holds for this boot only)\n") { return fail("R at this start", 0, 0) }
    if !lines(Word.of(65, 0, 0, 0, 0, 0), "native", true, "gpu: this boot: the monitor only asked, which is not built yet: the firmware's picture is kept (A was pressed at this start and holds for this boot only)\n") { return fail("A at this start", 0, 0) }
    if !lines(looked, "firmware\n", true, "gpu: this boot: the firmware's picture is kept (the image's settings/gpu says so; N while the machine starts sets the monitor's own mode)\n") { return fail("the image's word", 0, 0) }
    if !lines(looked, "rehearsal", true, "gpu: this boot: the firmware's own mode set again by the card's tables (the image's settings/gpu says so)\n") { return fail("the image's rehearsal", 0, 0) }
    // What is not as it should be.
    if !lines(Word.of(70, 1, 78, Word.REFUSED, 0, 0x8000000000000008), "", true, "gpu: this boot: the firmware's picture is kept (F was pressed at this start; the machine does not remember it, so it holds for this boot only; N sets the monitor's own mode again)\ngpu: the firmware's variable store did not take F to remember (status 8: write protected)\n") { return fail("a write refused", 0, 0) }
    if !lines(Word.of(78, 0, 0, Word.REFUSED, 0, 9), "", true, "gpu: this boot: the monitor's own mode (N was pressed at this start; the machine does not remember it, so it holds for this boot only; F while the machine starts keeps the firmware's picture)\ngpu: the firmware's variable store did not take N to remember (status 9: out of resources)\n") { return fail("a store that is full", 0, 0) }
    if !lines(Word.of(70, 0, 0, Word.NO_STORE, 0, 0), "", true, "gpu: this boot: the firmware's picture is kept (F was pressed at this start; the machine does not remember it, so it holds for this boot only; N sets the monitor's own mode again)\ngpu: the firmware gave the loader no variable store: F and N hold for one boot only on this machine\n") { return fail("no variable store", 0, 0) }
    if !lines(Word.of(70, 1, 70, Word.NO_KEYBOARD, 0, 0), "", true, "gpu: this boot: the firmware's picture is kept (F was pressed at an earlier start and is remembered)\ngpu: the firmware gave the loader no keyboard to read: a key while the machine starts is not seen on this machine\n") { return fail("no keyboard: what is remembered counts, a key in the word does not", 0, 0) }
    if !lines(Word.of(0, 0, 0, Word.KEYBOARD_FAILED, 0, 7), "", true, "gpu: this boot: the monitor's own mode (the default; F while the machine starts keeps the firmware's picture)\ngpu: the firmware's keyboard answered the loader with an error (status 7: device error): a key while the machine starts may not be seen\n") { return fail("a keyboard that fails", 0, 0) }
    if !lines(Word.of(0, 0, 0, Word.READ_FAILED, 0, 0x55), "", true, "gpu: this boot: the monitor's own mode (the default; F while the machine starts keeps the firmware's picture)\ngpu: the firmware's variable store did not give the loader what is remembered (status 85): this boot goes on without it\n") { return fail("a variable that cannot be read", 0, 0) }
    if !lines(Word.of(0, 1, 0x5a, 0, 0, 0), "", true, "gpu: this boot: the monitor's own mode (the default; F while the machine starts keeps the firmware's picture)\ngpu: what the machine remembers is no choice of ours (1 byte, 0x5a): it is passed over; F or N while the machine starts writes it anew\n") { return fail("a remembered byte that is no choice", 0, 0) }
    if !lines(Word.of(0, 4, 70, 0, 0, 0), "firmware", true, "gpu: this boot: the firmware's picture is kept (the image's settings/gpu says so; N while the machine starts sets the monitor's own mode)\ngpu: what the machine remembers is no choice of ours (4 bytes): it is passed over; F or N while the machine starts writes it anew\n") { return fail("four remembered bytes", 0, 0) }
    if !lines(Word.of(0, 4000, 70, 0, 0, 0), "", true, "gpu: this boot: the monitor's own mode (the default; F while the machine starts keeps the firmware's picture)\ngpu: what the machine remembers is no choice of ours (255 bytes or more): it is passed over; F or N while the machine starts writes it anew\n") { return fail("many remembered bytes", 0, 0) }
    if !lines(looked, "off\n", true, "gpu: this boot: the monitor's own mode (the default; F while the machine starts keeps the firmware's picture)\ngpu: the image's settings/gpu names none of native, firmware, rehearsal and ask: it is passed over\n") { return fail("an image word that names none", 0, 0) }
    // No loader of ours: no key is named.
    if !lines(0, "", true, "gpu: this boot: the monitor's own mode (the default)\n") { return fail("no loader: the default", 0, 0) }
    if !lines(0, "firmware", true, "gpu: this boot: the firmware's picture is kept (the image's settings/gpu says so)\n") { return fail("no loader: the image's word", 0, 0) }
    // No card of ours.
    if !lines(looked, "", false, "gpu: no card of ours to set a mode on; this boot: the monitor's own mode (the default; F while the machine starts keeps the firmware's picture)\n") { return fail("no card: the default", 0, 0) }
    if !lines(Word.of(82, 0, 0, 0, 0, 0), "", false, "gpu: no card of ours to set a mode on; this boot: the firmware's own mode set again by the card's tables (R was pressed at this start and holds for this boot only)\n") { return fail("no card: R", 0, 0) }

    // How long the loader looked.
    const waited = choice.decide(Word.of(0, 0, 0, 0, 600000000, 0), "")
    if waited.ticks != (600000000 >> 16) << 16 { return fail("the ticks, in counts of 65536", waited.ticks, 600000000) }
    logged = 0
    choice.sayWait(logWrite, &waited, 301)
    if !same(log[0..logged], "gpu: the loader looked for a key for 301 ms and saw none of F, N, R and A\n") { return fail("how long the loader looked", 0, 0) }
    const quick = choice.decide(Word.of(70, 0, 0, Word.WROTE, 70000, 0), "")
    logged = 0
    choice.sayWait(logWrite, &quick, 0)
    if !same(log[0..logged], "gpu: the loader looked for a key for 0 ms and took F (written into the machine now)\n") { return fail("a key found at once", 0, 0) }
    const again = choice.decide(Word.of(78, 1, 78, 0, 0, 0), "")
    logged = 0
    choice.sayWait(logWrite, &again, 12)
    if !same(log[0..logged], "gpu: the loader looked for a key for 12 ms and took N (the machine held it already: nothing was written)\n") { return fail("a key the machine held already", 0, 0) }
    const once = choice.decide(Word.of(82, 1, 78, 0, 0, 0), "")
    logged = 0
    choice.sayWait(logWrite, &once, 7)
    if !same(log[0..logged], "gpu: the loader looked for a key for 7 ms and took R\n") { return fail("a key for the one boot", 0, 0) }
    const lost = choice.decide(Word.of(70, 0, 0, Word.REFUSED, 0, 8), "")
    logged = 0
    choice.sayWait(logWrite, &lost, 7)
    if !same(log[0..logged], "gpu: the loader looked for a key for 7 ms and took F\n") { return fail("a key the firmware did not take", 0, 0) }
    const deaf = choice.decide(Word.of(0, 0, 0, Word.NO_KEYBOARD, 0, 0), "")
    logged = 0
    choice.sayWait(logWrite, &deaf, 0)
    choice.sayWait(logWrite, &none, 0)
    if logged != 0 { return fail("no keyboard, no loader: nothing said of a wait", logged, 0) }

    // The word's fields.
    const long = Word.of(0, 0, 0, 0, 0xFFFFFFFFFFFFFFFF, 0)
    if (long >> 32) & 0xFFFFFF != 0xFFFFFF || long >> 56 != 0 { return fail("the ticks: 24 bits of counts at most", long >> 32, 0) }
    if choice.decide(long, "").ticks != 0xFFFFFF << 16 { return fail("the most ticks", 0, 0) }
    const many = Word.of(70, 100000, 9, Word.REFUSED, 0, 0x8000000000000109)
    if many & 0xFF != 70 || (many >> 8) & 0xFF != 9 || (many >> 16) & 0xFF != 255 || many >> 56 != 9 || many & Word.LOOKED == 0 { return fail("the word's fields", many, 0) }
    if choice.decide(many, "").status != 9 { return fail("the status's lowest byte", 0, 0) }

    // What the loader says.
    if !same(choice.loaderLine(70, true), "brixOS: display: the firmware's picture is kept (F), remembered") { return fail("the loader's line for F", 0, 0) }
    if !same(choice.loaderLine(70, false), "brixOS: display: the firmware's picture is kept (F), for this start only: the firmware does not remember it") { return fail("the loader's line for F not remembered", 0, 0) }
    if !same(choice.loaderLine(78, true), "brixOS: display: the monitor's own mode (N), remembered") { return fail("the loader's line for N", 0, 0) }
    if !same(choice.loaderLine(78, false), "brixOS: display: the monitor's own mode (N), for this start only: the firmware does not remember it") { return fail("the loader's line for N not remembered", 0, 0) }
    if !same(choice.loaderLine(82, true), "brixOS: display: the firmware's own mode set again by the card's tables (R), for this start only") || !same(choice.loaderLine(82, false), choice.loaderLine(82, true)) { return fail("the loader's line for R", 0, 0) }
    if !same(choice.loaderLine(65, true), "brixOS: display: the monitor only asked (A), for this start only") || !same(choice.loaderLine(65, false), choice.loaderLine(65, true)) { return fail("the loader's line for A", 0, 0) }
    if choice.loaderLine(0, true).length != 0 || choice.loaderLine(102, true).length != 0 { return fail("no line without a key", 0, 0) }
    // Each line is plain ASCII (the loader writes it as 16-bit
    // characters, one a byte).
    var n: usize = 0
    while n < choice.KEYS.length {
        var both: usize = 0
        while both < 2 {
            const text = choice.loaderLine(choice.KEYS[n], both == 0)
            if text.length == 0 { return fail("a key without a line", n, both) }
            var c: usize = 0
            while c < text.length {
                if text[c] < 32 || text[c] > 126 { return fail("a loader's line that is not plain", n, c) }
                c += 1
            }
            both += 1
        }
        n += 1
    }
    var c: usize = 0
    while c < choice.NAME.length {
        if choice.NAME[c] < 32 || choice.NAME[c] > 126 { return fail("the variable's name is not plain", c, 0) }
        c += 1
    }
    if choice.GUID.length != 16 || choice.ATTRIBUTES != 7 { return fail("the variable's GUID and attributes", choice.GUID.length, choice.ATTRIBUTES) }
    if choice.WAIT > 500 || choice.SLICE == 0 || choice.WAIT % choice.SLICE != 0 { return fail("the wait: a few tenths of a second at most, in whole slices", choice.WAIT, choice.SLICE) }

    // The loader's part, run.
    const ran = loaderRuns()
    if ran != 0 { return ran }
    return 13
}
