// A non-copyable local with a valid deinitializer is dropped at block exit.
const OwnedCounter = @noncopy(struct) {
    counter: *u8

    fn deinit(self: *Self) -> void {
        self.*.counter.* += 1
    }
}

fn main() -> u8 {
    var drops: u8 = 0
    {
        const owned = OwnedCounter.{ .counter = &drops }
    }
    return drops
}
