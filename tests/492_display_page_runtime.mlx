// The settings program's Display page (projects/desktop/settings/
// display.mlx) and the way it asks the compositor for another mode of the
// display (projects/desktop/compositor/mode_change.mlx), on the host:
//
// - the compositor's file as its brixOS backend writes it: who sets the
//   modes, where to ask, the seconds left to keep a mode, each mode with
//   its rate, the monitor's own, the one that runs and the one the next
//   boots set, and why one cannot be set; what the page takes of it (the
//   modes to choose, those not available with the kernel's reason, a
//   change at once), its rows ("1920 × 1080, 60 Hz (the monitor's own)")
//   and the line it says; a file of another system (modes alone) taken
//   at the next start, its rate rounded, as before;
// - the wire: org.mlx.Display.Ask (width, height, millihertz) on a
//   channel of the compositor's listener (std.ipc's native format, here
//   on a socket of the host): the request as the compositor reads it, and
//   each answer as the asker gets it: set, refused with the kernel's
//   reason, another mode waiting, no such mode, not allowed, failed with
//   the mode before back or not; a call that is no Ask answered as
//   unknown; an asker that went, let go; the page asking with no
//   compositor listening. Exits 13.
const std = @import("std")
const ipc = @import("std.ipc")
const dbus = @import("std.dbus")
const displaymodes = @import("std.displaymodes")
const state = @import("../projects/desktop/compositor/state.mlx")
const mode_change = @import("../projects/desktop/compositor/mode_change.mlx")
const page = @import("../projects/desktop/settings/display.mlx")

const brix = std.os.brix
const Compositor = state.Compositor

const FILE: []const u8 = "# The Mlx compositor's output (control reads this file).\nbackend = drm\noutput = Unknown-1\nmode = 3840x1080@59\nmillihertz = 59999\ngamma = 0\ndriver = Radeon, HDMI or DVI\nask = /temporary/users/1000/wayland-mlx.modes\npending = 12\nunavailable = 5120x1440@60 59977: more than this output carries\navailable = 3840x1080@60 59999 own runs\navailable = 1920x1080@60 60000 kept\navailable = 1280x720@60 60000\nunavailable = 1920x1080@50 50000: another rate of the size that runs, which this driver does not set\n"

const OLD: []const u8 = "backend = drm\noutput = HDMI-A-1\nmode = 2560x1440@144\nmillihertz = 143912\navailable = 2560x1440@144\navailable = 1920x1080@60\ngamma = 256\n"

fn same(bytes: [*]const u8, length: usize, text: []const u8) -> bool { return std.text.same(bytes[0..length], text) }

fn reasonOf(mode: *page.Mode) -> []const u8 {
    const bytes: [*]const u8 = &mode.*.reason
    return bytes[0..mode.*.reasonLength]
}

fn file() -> u8 {
    const memory = std.heap.allocator().alloc(@sizeOf(page.Display), 16)
    const display: *page.Display = unsafe { @ptrCast(*page.Display, memory.?) }
    var empty: [1][*]const u8 = undefined
    unsafe { empty[0] = @ptrFromInt([*]const u8, 0) }
    page.init(display, &empty)
    if !page.take(display, FILE) { return 1 }
    if display.*.width != 3840 || display.*.height != 1080 || display.*.millihertz != 59999 { return 2 }
    if !page.changesAtOnce(display) || display.*.pending != 12 { return 3 }
    const ask: [*]const u8 = &display.*.ask
    if !same(ask, display.*.askLength, "/temporary/users/1000/wayland-mlx.modes") { return 4 }
    const driver: [*]const u8 = &display.*.driver
    if !same(driver, display.*.driverLength, "Radeon, HDMI or DVI") { return 5 }
    if display.*.modeCount != 5 { return 6 }
    // The largest first, as the kernel lists them; each as it was said.
    const too = &display.*.modes[0]
    if too.*.width != 5120 || too.*.can || !std.text.same(reasonOf(too), "more than this output carries") { return 7 }
    const own = &display.*.modes[1]
    if own.*.width != 3840 || own.*.millihertz != 59999 || !own.*.can || !own.*.own || !own.*.runs || own.*.kept || own.*.reasonLength != 0 { return 8 }
    const kept = &display.*.modes[2]
    if kept.*.width != 1920 || kept.*.hertz != 60 || kept.*.millihertz != 60000 || !kept.*.can || kept.*.own || kept.*.runs || !kept.*.kept { return 9 }
    const rate = &display.*.modes[4]
    if rate.*.can || rate.*.hertz != 50 || !std.text.same(reasonOf(rate), "another rate of the size that runs, which this driver does not set") { return 10 }
    // The rows the page shows.
    var text: [256]u8 = undefined
    const bytes: [*]u8 = &text
    var length = page.rowLabel(own, false, bytes)
    if !same(bytes, length, "3840 × 1080, 59.99 Hz (the monitor's own)") { return 11 }
    length = page.rowLabel(own, true, bytes)
    if !same(bytes, length, "3840 × 1080, 59.99 Hz (eigener Modus des Monitors)") { return 12 }
    length = page.rowLabel(kept, false, bytes)
    if !same(bytes, length, "1920 × 1080, 60 Hz") { return 13 }
    length = page.summary(display, bytes)
    if !same(bytes, length, "control: display: 3840x1080 at 59.99 Hz runs (Radeon, HDMI or DVI); 3 modes to choose, 2 not available; set at once; waits to be kept") { return 14 }
    // The mode kept is not the one that runs here; in the next file it is.
    if page.runsKept(display) { return 25 }
    if !page.take(display, "backend = drm\nask = /x.modes\navailable = 1920x1080@60 60000 runs kept\navailable = 1280x720@60 60000 own\n") || !page.runsKept(display) { return 26 }
    // Another system's file: the modes alone, taken at the next start.
    if !page.take(display, OLD) { return 15 }
    if page.changesAtOnce(display) || display.*.modeCount != 2 || display.*.pending != 0 || display.*.driverLength != 0 { return 16 }
    if display.*.modes[0].width != 2560 || display.*.modes[0].hertz != 144 || !display.*.modes[0].can || display.*.modes[1].height != 1080 { return 17 }
    length = page.summary(display, bytes)
    if !same(bytes, length, "control: display: 2560x1440 at 143.91 Hz runs; 2 modes to choose, 0 not available; taken at the next start") { return 18 }
    // Another system's rate rounded as the page always said it (59.997
    // Hz is "60 Hz" there); brixOS's cut as its kernel says it.
    if !page.take(display, "backend = drm\noutput = DP-1\nmode = 3840x2160@60\nmillihertz = 59997\navailable = 3840x2160@60\n") { return 27 }
    length = page.summary(display, bytes)
    if !same(bytes, length, "control: display: 3840x2160 at 60 Hz runs; 1 modes to choose, 0 not available; taken at the next start") { return 28 }
    if !page.take(display, "backend = drm\nask = /x.modes\nmode = 3840x2160@60\nmillihertz = 59997\navailable = 3840x2160@60 59997 runs\n") { return 29 }
    length = page.summary(display, bytes)
    if !same(bytes, length, "control: display: 3840x2160 at 59.99 Hz runs; 1 modes to choose, 0 not available; set at once") { return 30 }
    // brixOS's display with no driver to change it (the firmware's
    // picture: every mode not available) and a compositor that takes no
    // requests: the kernel's modes, nothing written for a next start.
    if !page.take(display, "backend = drm\nmode = 1280x800@75\nmillihertz = 74993\ndriver = the firmware's picture\nunavailable = 1280x800@75 74993 own runs: this display is as the firmware left it, and no driver of this system sets its mode\nunavailable = 1024x768@60 60003: this display is as the firmware left it, and no driver of this system sets its mode\n") { return 31 }
    if page.changesAtOnce(display) || !page.kernelModes(display) || display.*.modeCount != 2 || display.*.modes[1].can { return 32 }
    length = page.summary(display, bytes)
    if !same(bytes, length, "control: display: 1280x800 at 74.99 Hz runs (the firmware's picture); 0 modes to choose, 2 not available; not changed from here") { return 33 }
    // The firmware's picture's mode has no rate: none is said.
    if !page.take(display, "backend = drm\ndriver = the firmware's picture\nunavailable = 800x600@0 0 own runs: this display is as the firmware left it, and no driver of this system sets its mode\n") || display.*.modeCount != 1 { return 36 }
    length = page.rowLabel(&display.*.modes[0], false, bytes)
    if !same(bytes, length, "800 × 600 (the monitor's own)") { return 37 }
    if !page.take(display, OLD) || page.kernelModes(display) { return 35 }
    // A line that is no mode is passed over.
    if !page.take(display, "backend = drm\navailable = x@\navailable = 800x600@60 60316\nunavailable = 640\n") || display.*.modeCount != 1 || display.*.modes[0].millihertz != 60316 { return 19 }
    // Asking with nobody listening: said, nothing set.
    if !page.take(display, "backend = drm\nask = /nonexistent/mlx-492.modes\navailable = 800x600@60 60316\n") { return 20 }
    const mode = display.*.modes[0]
    if page.ask(display, &mode, false, std.heap.allocator()) { return 21 }
    const answer = page.answerOf(display)
    if !std.text.same(answer, "The compositor takes no request now.") { return 22 }
    return 0
}

// The compositor's side listening at /tmp/<socket>.modes (the test's own
// name), its asker connected.
fn wire() -> u8 {
    var compositor: Compositor = undefined
    unsafe { std.mem.set(@ptrCast([*]u8, &compositor), 0, @sizeOf(Compositor)) }
    compositor.allocator = std.heap.allocator()
    compositor.verbose = false
    var environment: [2][*]const u8 = undefined
    unsafe {
        environment[0] = @ptrCast([*]const u8, "XDG_RUNTIME_DIR=/tmp")
        environment[1] = @ptrFromInt([*]const u8, 0)
        compositor.environment = @ptrCast([*][*]const u8, &environment)
    }
    // A name of this run's own: the process's number in it.
    const name = "mlx-492-"
    var length: usize = 0
    while length < name.length {
        compositor.socketName[length] = name[length]
        length += 1
    }
    const socketBytes: [*]u8 = &compositor.socketName
    length = std.text.appendUnsigned(socketBytes, length, length + 12, @bitCast(usize, std.linux.getpid()))
    compositor.socketNameLength = length

    var asking: mode_change.Asking = undefined
    if !mode_change.begin(&asking, &compositor) { return 1 }
    const path = mode_change.pathOf(&asking)
    if path.length < 10 || !std.text.same(path[0..13], "/tmp/mlx-492-") || !std.text.same(path[path.length - 6..path.length], ".modes") { return 2 }
    var list: [4]isize = undefined
    if mode_change.descriptors(&asking, &list, 0, 4) != 1 { return 3 }

    const allocator = std.heap.allocator()
    const descriptor = dbus.connect(path)
    if descriptor < 0 { return 4 }
    var client: ipc.Client = undefined
    if !ipc.attach(&client, allocator, descriptor) { return 5 }

    // Each answer as the asker gets it: the error's name and its text.
    const names = [7][]const u8{ "", mode_change.REFUSED, mode_change.BUSY, mode_change.NOT_FOUND, mode_change.NOT_ALLOWED, mode_change.FAILED, mode_change.FAILED }
    const texts = [7][]const u8{ "", "more than this output carries", "another mode waits to be kept or taken back", "the display has no such mode", "this desktop may not change the display's mode (the login did not give it the display)", "the change failed, and the mode before runs again", "the change failed, and what the display shows is not known" }
    const statuses = [7]isize{ 0, -brix.Status.unsupported, -brix.Status.busy, -brix.Status.not_found, -brix.Status.no_right, -brix.Status.io_error, -brix.Status.io_error }
    const lasts = [7]usize{ displaymodes.Last.CHANGED, displaymodes.Last.REFUSED, displaymodes.Last.BUSY, displaymodes.Last.NOT_LISTED, 0, displaymodes.Last.FAILED_BACK, displaymodes.Last.FAILED_LOST }
    var turn: usize = 0
    while turn < 7 {
        var body: [12]u8 = undefined
        const bytes: [*]u8 = &body
        var writing: ipc.Writer = undefined
        ipc.begin(&writing, bytes, 12)
        ipc.putU32(&writing, 1920)
        ipc.putU32(&writing, 1080)
        ipc.putU32(&writing, @intCast(u32, 60000 + turn))
        const serial = ipc.call(&client, "org.mlx.Display", "/org/mlx/Display", "org.mlx.Display", "Ask", "uuu", bytes, writing.length)
        if serial == 0 { return 10 }
        var request: mode_change.Request = undefined
        var tries: usize = 0
        var taken = false
        while tries < 200 && !taken {
            taken = mode_change.take(&asking, &compositor, &request)
            tries += 1
        }
        if !taken { return 11 }
        if request.width != 1920 || request.height != 1080 || request.millihertz != 60000 + turn { return 12 }
        // Two descriptors to wait on now: the listener and the asker.
        if mode_change.descriptors(&asking, &list, 0, 4) != 2 { return 13 }
        var after: displaymodes.State = undefined
        after.last = lasts[turn]
        after.lastWhy = displaymodes.Why.TOO_FAST
        mode_change.answer(&asking, &request, statuses[turn], &after)
        var reply: ipc.Message = undefined
        if !ipc.waitReply(&client, serial, &reply, 2000) { return 14 }
        if turn == 0 {
            if reply.kind != ipc.REPLY { return 15 }
        } else {
            if reply.kind != ipc.ERROR || !std.text.same(reply.errorName, names[turn]) { return 16 }
            var reading = ipc.reader(ipc.bodyOf(&client, &reply), reply.bodyLength)
            if !std.text.same(ipc.readString(&reading), texts[turn]) { return 17 }
        }
        turn += 1
    }
    // A call that is no Ask: answered as unknown; no request comes of it.
    var nothing: [1]u8 = undefined
    const other = ipc.call(&client, "org.mlx.Display", "/org/mlx/Display", "org.mlx.Display", "Modes", "", &nothing, 0)
    var request: mode_change.Request = undefined
    var tries: usize = 0
    while tries < 50 {
        if mode_change.take(&asking, &compositor, &request) { return 20 }
        tries += 1
    }
    var reply: ipc.Message = undefined
    if !ipc.waitReply(&client, other, &reply, 2000) || reply.kind != ipc.ERROR || !std.text.same(reply.errorName, mode_change.UNKNOWN) { return 21 }
    // The asker goes: let go at the next look.
    ipc.disconnect(&client, allocator)
    tries = 0
    while tries < 200 && mode_change.descriptors(&asking, &list, 0, 4) != 1 {
        _ = mode_change.take(&asking, &compositor, &request)
        tries += 1
    }
    if mode_change.descriptors(&asking, &list, 0, 4) != 1 { return 22 }
    mode_change.end(&asking, &compositor)
    if mode_change.descriptors(&asking, &list, 0, 4) != 0 { return 23 }
    // The listener's node is gone with it.
    if dbus.connect(path) >= 0 { return 24 }
    return 0
}

pub fn main() -> u8 {
    const read = file()
    if read != 0 { return read }
    const asked = wire()
    if asked != 0 { return 100 + asked }
    return 13
}
