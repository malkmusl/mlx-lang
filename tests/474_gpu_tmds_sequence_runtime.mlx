// The kernel's plan for a monitor's own mode on a Radeon's TMDS output
// (HDMI or DVI signalling) and its carrying out through the card's own
// firmware tables (projects/brix/kernel/gpu_mode.mlx, gpu_set.mlx,
// gpu_blocks.mlx and atom.mlx, built for the host), against a card that
// is a table and a ROM made here whose tables write down what they were
// told (tests/support/tmds_card.mlx says how).
//
// The machine this is built for: controller 0's 1280x960 picture leaves
// by DIG 4 in DVI mode at a measured 107962 kHz; the monitor's own timing
// is 3840x1080 at 266640 kHz, and its EDID has the HDMI block. The whole
// change, every write of the driver's and every run of a table with its
// block, in order, is the sequence worked out here by hand from the
// document of the sequence (each group names its step there and Linux's
// function), and afterwards the controller shows the 3840x1080 picture.
// Then: the setting off (no write, and no table run); the way back, word
// for word and run for run, after the frames stand with the new picture;
// a failure at every step in turn (each write that does not hold, each
// state that does not come, each table's run stopped by the card, a
// table that writes nothing, one that does not end, one with an opcode
// that is none, the timing's words not as told, the PLL keeping its
// clock, a card that counts no frames while the transmitter is off), and
// after each of them every register the firmware had is as it was and
// the tables were told the firmware's timing and clock again; a failure
// before any table has written, where nothing of the way back's tables
// is run; a table that fails on the way back (the output is left, and
// said so); the display engine's clock raised and put back; the
// firmware's own mode set again (the rehearsal); an output that sends
// HDMI already; another controller, encoder, PLL and connector (nothing
// is tied to one place); a transmitter's table that rewrites the back
// end's word; a PLL that gives a clock a little below the one asked for;
// and what the last line says after a way back that is not known to have
// brought the firmware's state back: a card that does the same wrong on
// the way back (a transmitter that never comes on, a controller put on
// another PLL, a state that never comes, timing words that are not as
// told, frames that stand at the end) is not said to be back, a register
// that does not take the firmware's value again is said by its number;
// and that the screen's longest dark time is said before the first
// write.
// With an argument, the log of every case is printed.
// Exits 13.
const std = @import("std")
const scanout = @import("../projects/brix/kernel/gpu_display.mlx")
const edid = @import("../projects/brix/kernel/edid.mlx")
const mode = @import("../projects/brix/kernel/gpu_mode.mlx")
const set = @import("../projects/brix/kernel/gpu_set.mlx")
const atom = @import("../projects/brix/kernel/atom.mlx")
const videorom = @import("../projects/brix/kernel/gpu_rom.mlx")
const rom = @import("./support/atom_rom.mlx")
const card = @import("./support/tmds_card.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

var show = false
var failed: u8 = 0

fn expect(holds: bool, what: []const u8) -> void {
    if holds { return }
    say("not as expected: ")
    say(what)
    say("\n")
    if failed == 0 { failed = 1 }
}

fn line(text: []const u8) -> void { expect(card.has(text), text) }

fn noLine(text: []const u8) -> void {
    if !card.has(text) { return }
    say("said, but should not be: ")
    say(text)
    say("\n")
    if failed == 0 { failed = 2 }
}

fn logWrite(text: []const u8) -> void {
    card.logWrite(text)
    if show { say(text) }
}

// The ROM and what is read of it.
var builder: rom.Builder = undefined
var machine: atom.Atom = undefined
var scratch: [16384]u32 = undefined
var board: videorom.Board = undefined
var information: videorom.Firmware = undefined

// The ROM made (the table at `odd` of its list ending as `ending` says)
// and opened.
fn open(odd: usize, ending: card.Ending) -> void {
    card.makeRom(&builder, odd, ending)
    expect(machine.open(builder.image(), scratch[0..]) == atom.Opened.ok, "the ROM made here opens")
    videorom.readFirmware(&machine, &information)
    videorom.readBoard(&machine, &board)
}

var readout: scanout.Readout = undefined
var plan: mode.Plan = undefined
var result: set.Result = undefined
var memory: scanout.Memory = undefined

// The registers as they were before a change.
var before: [card.ROOM]usize = undefined
var beforeMarks: [24]usize = undefined

fn remember() -> void {
    var k: usize = 0
    while k < card.ROOM {
        before[k] = card.registers[k]
        k += 1
    }
    k = 0
    while k < 24 {
        beforeMarks[k] = card.marks[k]
        k += 1
    }
}

// Whether every register of the display holds what it held (the tables'
// mail is not the display's; nor are the bits that are the card's own
// answers and only read: that the buffers are given, that a surface's
// words are still to be taken).
fn asBefore() -> bool {
    var k: usize = 0
    while k < card.ROOM {
        var answers: usize = 0
        if k >= 0x321 && k < 0x327 { answers = 0x10 }
        if k == 0x1A11 || k == 0x1C11 || k == 0x1E11 { answers = 0x4 }
        if (card.registers[k] ^ before[k]) & ~answers != 0 && (k < card.MAIL || k > card.ANSWER) {
            if show {
                const out = scanout.Card.{ .read = card.read, .now = card.now, .write = say }
                say("differs: ")
                out.hexDigits(k, 4)
                say(" ")
                out.hexDigits(card.registers[k], 8)
                say(" was ")
                out.hexDigits(before[k], 8)
                say("\n")
            }
            return false
        }
        k += 1
    }
    k = 0
    while k < 24 {
        if card.marks[k] != beforeMarks[k] { return false }
        k += 1
    }
    return true
}

// The monitor: its own timing 3840x1080 at 60 Hz (266.64 MHz, 4000 by
// 1111, porches 48 and 3, pulses 32 high and 10 low), and an EDID with
// the HDMI block.
fn wide() -> edid.Monitor {
    return edid.Monitor.{ .state = edid.State.found, .width = 3840, .height = 1080, .timing = edid.Timing.{ .clock = 266640, .width = 3840, .hTotal = 4000, .hFront = 48, .hSync = 32, .hPositive = true, .height = 1080, .vTotal = 1111, .vFront = 3, .vSync = 10, .vPositive = false, .interlaced = false, .stereo = false }, .timings = 1, .ofOwnSize = 1, .extension = edid.Extension.cta }
}

fn hdmiMonitor() -> edid.Offer {
    var o = edid.nothing()
    o.hdmi = true
    o.extensions = 1
    o.given = 1
    return o
}

// What the kernel knows of the firmware's picture: 1280x960 at the start
// of an aperture of 256 MiB.
fn known() -> scanout.Memory {
    return scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0, .pictureBytes = 1280 * 960 * 4, .pictureWidth = 1280, .pictureHeight = 960, .picturePitch = 1280 }
}

// The card read out, the plan made and said, with the ROM that is open.
fn make(monitor: *const edid.Monitor, offer: *const edid.Offer, wish: mode.Wish) -> void {
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
    const facts = mode.Rom.{ .machine = &machine, .board = &board, .firmware = &information }
    memory = known()
    scanout.report(&out, &memory, &readout)
    mode.makeFor(&out, &readout, &memory, monitor, offer, &facts, wish, &plan)
    mode.say(&out, &plan)
    mode.list(&out, &plan)
    remember()
    card.forget()
}

// The plan carried out (or not), lent the tables.
fn carry(asked: bool) -> bool {
    const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
    const hands = set.Hands.{ .write = card.write, .clear = card.clear }
    const lent = set.Tables.{ .machine = &machine, .hands = card.hands(), .aside = card.setAside }
    return set.attemptWith(&out, &hands, &lent, &plan, asked, &result)
}

// The user's machine (the file's head), made anew with nothing wrong, and
// the plan for the wide monitor.
fn again(name: []const u8) -> void {
    card.reset()
    if show {
        say("-- ")
        say(name)
        say("\n")
    }
    card.firmware(0, 4, 4, false, 2, 107962)
    const monitor = wide()
    const offer = hdmiMonitor()
    make(&monitor, &offer, mode.Wish.own)
}

// What the plan's listing says of everything that is no write (each
// wait, each look, each table's run with what holds it back, the frames
// and the timing read), in the listing's order and each with the write
// before it where one stands there: the writes themselves are held one
// by one where they are made (THERE), this holds what lies between them.
const BETWEEN = [_][]const u8{
    "gpu: would set 4e47 & 00001000 = 00000000 (the front end taken off the back end)\n",
    "gpu: would run UNIPHYTransmitterControl with 04 00 02 00 00 00 00 00 02 00 0c 00 00 00 00 00, only when 4e48 & 00000001 = 00000001 (the transmitter off)\n",
    "gpu: would wait for 4e48 & 00000001 = 00000000 (until the transmitter is off)\n",
    "gpu: would wait 100000 us (the monitor sees the signal gone)\n",
    "gpu: would write 1b9d = 00000100 (the controller's picture blanked)\n",
    "gpu: would wait for 1b9d & 00000101 = 00000101 (until it is blank)\n",
    "gpu: would run EnableCRTC with 00 00 00 00 (the controller stopped)\n",
    "gpu: would wait for 1b9c & 00010001 = 00000000 (until it has stopped)\n",
    "gpu: would set 0321 & 00000007 = 00000000 (the buffers the rows are read through given back)\n",
    "gpu: would wait for 0321 & 00000010 = 00000010 (until they are given back)\n",
    "gpu: would set 1bed & 00000011 = 00000011 (the formatter's expansion to twelve bits, for HDMI alone)\n",
    "gpu: would run SetPixelClock with a0 af 28 00 18 21 03 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set)\n",
    "gpu: would look for 0140 & 00000010 = 00000000 (the controller's clock is no DTO's)\n",
    "gpu: would look for 0143 & 00000017 = 00000004 (it is this back end's PLL's)\n",
    "gpu: would set 010c & 00000230 = 00000000 (the PLL's clock neither for deep colour nor doubled)\n",
    "gpu: would run SetCRTC_UsingDTDTiming with 00 0f a0 00 38 04 1f 00 30 00 20 00 03 00 0a 00 04 00 00 00 00 00 00 00 (the timing set)\n",
    "gpu: would read the timing's words (the timing's words as the table was told)\n",
    "gpu: would write 1bbd = 00000000 (and not held)\n",
    "gpu: would run EnableCRTC with 00 01 00 00 (the controller started)\n",
    "gpu: would wait for 1b9c & 00010001 = 00010001 (until it runs)\n",
    "gpu: would count the frames (the frames counted with the transmitter still off: the PLL's clock)\n",
    "gpu: would set 4e00 & 00000007 = 00000000 (the front end takes the controller)\n",
    "gpu: would set 4e47 & 00070000 = 00030000 (the back end's mode)\n",
    "gpu: would run DIGxEncoderControl with 04 0f 03 04 28 68 00 00 02 00 00 00 (the front end told the stream)\n",
    "gpu: would set 4e47 & 00001000 = 00001000 (the front end on the back end, before the transmitter)\n",
    "gpu: would run UNIPHYTransmitterControl with 04 01 03 04 28 68 00 00 02 00 0c 00 00 00 00 00 (the transmitter on)\n",
    "gpu: would wait for 4e48 & 00000001 = 00000001 (until the transmitter is on)\n",
    "gpu: would read 4e47 (what the transmitter's table left in the back end's word)\n",
    "gpu: would set 4e47 & 00070000 = 00030000 (the back end's mode once more)\n",
    "gpu: would set 0321 & 00000007 = 00000004 (the buffers the rows are read through)\n",
    "gpu: would wait for 0321 & 00000010 = 00000010 (until they are given)\n",
    "gpu: would set 1a11 & 00010000 = 00000000 (the surface's words let go)\n",
    "gpu: would wait for 1a11 & 00000004 = 00000000 (until the controller has taken them)\n",
    "gpu: would write 1b9d = 00000000 (the controller's picture shown)\n",
    "gpu: would wait for 1b9d & 00000001 = 00000000 (until it is shown)\n",
    "gpu: would set 1b32 & 00000700 = 00000100 (the urgency mark set chosen as it was)\n",
}

// The listing has those lines one after another, and no wait, look, run
// or read beside them (ten waits, two looks, seven runs, two reads, the
// frames once: the plan's 22 steps that are no write).
fn listingHolds() -> void {
    var at: usize = 0
    for text in BETWEEN {
        const next = card.after(text, at)
        if next == card.NEVER {
            expect(false, text)
            return
        }
        at = next
    }
    expect(card.count("gpu: would wait ") == 10 && card.count("gpu: would look for ") == 2 && card.count("gpu: would run ") == 7 && card.count("gpu: would read ") == 2 && card.count("gpu: would count the frames") == 1, "the listing's waits, looks, runs and reads: 22, no other")
}

// The writes from number `from` on against a sequence worked out by hand:
// pairs of a register and the word written.
fn sameWrites(name: []const u8, from: usize, pairs: []const usize) -> void {
    var k: usize = 0
    while k * 2 + 1 < pairs.length && from + k < card.written {
        if card.writtenTo[from + k] != pairs[k * 2] || card.writtenWith[from + k] != pairs[k * 2 + 1] {
            const out = scanout.Card.{ .read = card.read, .now = card.now, .write = say }
            say("not as expected: ")
            say(name)
            out.field(": write ", k + 1)
            say(" is ")
            out.hexDigits(card.writtenTo[from + k], 4)
            say(" = ")
            out.hexDigits(card.writtenWith[from + k], 8)
            say(", worked out ")
            out.hexDigits(pairs[k * 2], 4)
            say(" = ")
            out.hexDigits(pairs[k * 2 + 1], 8)
            say("\n")
            if failed == 0 { failed = 3 }
            return
        }
        k += 1
    }
    if card.written != from + pairs.length / 2 {
        const out = scanout.Card.{ .read = card.read, .now = card.now, .write = say }
        say("not as expected: ")
        say(name)
        out.field(": ", card.written - from)
        out.field(" writes, worked out ", pairs.length / 2)
        say("\n")
        if failed == 0 { failed = 3 }
    }
}

// The whole change on the user's machine, from the document of the
// sequence: controller 0 (its registers at their own numbers), front end
// 4 and back end 4 (the block at 0x4e00), the PHY's PLL 24 (its word
// 0x10c), the connector's kind 0x0c on hot plug line 2. A table's run is
// the words of its block in the mail registers 0x7f00 on, then the
// table's place in the ROM's list in 0x7f10.
const THERE = [_]usize{
    // P1. dce110_set_safe_displaymarks: each set chosen (the field into
    // the word as it stands, 0x00010100), its marks at their highest.
    0x1B32, 0x00010000, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010100, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010200, 0x1B33, 0xFFFFFFFF,
    0x1B32, 0x00010300, 0x1B33, 0xFFFFFFFF,
    // Before the first table: scratch word 6 (0x10) with bit 29 set,
    // word 2 (0x20010005) without bits 29 and 16
    // (amdgpu_atombios_scratch_regs_init).
    0x05CF, 0x20000010, 0x05CB, 0x00000005,
    // D2. Front end 4 off back end 4: bit 12 of DIG_BE_CNTL (0x10021000).
    0x4E47, 0x10020000,
    // D3. UNIPHYTransmitterControl, DISABLE: 04 | 00 | 02 | 00 | 00 00 00
    // 00 | 02 | 00 | 0c | 00 | 00 00 00 00.
    0x7F00, 0x00020004, 0x7F01, 0x00000000, 0x7F02, 0x000C0002, 0x7F03, 0x00000000, 0x7F10, 76,
    // D4. dce110_tg_set_blank(true).
    0x1BB6, 0x00010000, 0x1B9D, 0x00000100,
    // D5. EnableCRTC, DISABLE: 00 | 00 | 00 00.
    0x7F00, 0x00000000, 0x7F10, 35,
    // D6. The buffers given back: DMIF_BUFFERS_ALLOCATED 0 of 0x12.
    0x0321, 0x00000010,
    // C0. The critical state bit into scratch word 6; the formatter's
    // expansion for HDMI (EN and MODE).
    0x05CF, 0x20000110, 0x1BED, 0x00000011,
    // C1. SetPixelClock: a0 af 28 00 | 18 | 21 | 03 | 00 | 00 | 00 | 00
    // 00 | 00 00 00 00 (2666400 hundreds of Hz, PLL 24, encoder object
    // 0x21, HDMI, controller 0).
    0x7F00, 0x0028AFA0, 0x7F01, 0x00032118, 0x7F02, 0x00000000, 0x7F03, 0x00000000, 0x7F10, 12,
    // C2. The PLL's word (0x101): no deep colour, no doubled rate.
    0x010C, 0x00000101,
    // C3. SetCRTC_UsingDTDTiming: 00 0f | a0 00 | 38 04 | 1f 00 | 30 00 |
    // 20 00 | 03 00 | 0a 00 | 04 00 | 00 | 00 | 00 | 00 00 00.
    0x7F00, 0x00A00F00, 0x7F01, 0x001F0438, 0x7F02, 0x00200030, 0x7F03, 0x000A0003, 0x7F04, 0x00000004, 0x7F05, 0x00000000, 0x7F10, 49,
    // C4. No pixel counted twice; the rows asked for 4 lines early with
    // the prefetch (pulse and porch are 13 lines), into 0x3101; the most
    // and the fewest lines 1110.
    0x1BA9, 0x00000000, 0x1BB3, 0x00004007, 0x1B89, 0x00000456, 0x1B88, 0x00000456,
    // C5. The update mode and lock as nothing; EnableCRTC, ENABLE: 00 |
    // 01 | 00 00.
    0x1BBE, 0x00000000, 0x1BBD, 0x00000000,
    0x7F00, 0x00000100, 0x7F10, 35,
    // U0, U1. Front end 4 takes controller 0 (it does: the word as it
    // is); the back end's mode 3.
    0x4E00, 0x01000000, 0x4E47, 0x10030000,
    // U2. DIGxEncoderControl, stream setup: 04 | 0f | 03 | 04 | 28 68 00
    // 00 | 02 | 00 | 00 00; then RGB, a pixel a clock.
    0x7F00, 0x04030F04, 0x7F01, 0x00006828, 0x7F02, 0x00000002, 0x7F10, 4,
    0x4E00, 0x01000000,
    // U3. dce110_stream_encoder_hdmi_set_stream_attribute: HDMI_CONTROL
    // (the packets' version and the keep-out; then no deep colour's
    // depth), the general control and null packets, no audio content
    // packet, not muted.
    0x4E09, 0x00000011, 0x4E09, 0x00000011, 0x4E0D, 0x00000031, 0x4E0D, 0x00000031, 0x4E13, 0x00000000,
    // The AVI info frame: bd 1e 08 80 | 00 00 00 00 | 58 04 00 00 | a1
    // 0f 00 00, its version 2, sent in every frame on line 2; no generic
    // packets.
    0x4E7E, 0x00000001, 0x4E1E, 0x80081EBD, 0x4E1F, 0x00000000, 0x4E20, 0x00000458, 0x4E21, 0x00000FA1, 0x4E21, 0x02000FA1,
    0x4E0E, 0x00000003, 0x4E0F, 0x00000002, 0x4E10, 0x00000000, 0x4E2D, 0x00000000,
    // U4. The front end on the back end before the transmitter.
    0x4E47, 0x10031000,
    // U5. UNIPHYTransmitterControl, ENABLE: 04 | 01 | 03 | 04 | 28 68 00
    // 00 | 02 | 00 | 0c | 00 | 00 00 00 00.
    0x7F00, 0x04030104, 0x7F01, 0x00006828, 0x7F02, 0x000C0002, 0x7F03, 0x00000000, 0x7F10, 76,
    // U6. The mode once more, the front end on; the info frame once
    // more.
    0x4E47, 0x10031000, 0x4E47, 0x10031000,
    0x4E7E, 0x00000001, 0x4E1E, 0x80081EBD, 0x4E1F, 0x00000000, 0x4E20, 0x00000458, 0x4E21, 0x00000FA1, 0x4E21, 0x02000FA1,
    0x4E0E, 0x00000003, 0x4E0F, 0x00000002, 0x4E10, 0x00000000, 0x4E2D, 0x00000000,
    // U7, U8, C0'. No early blanking; unmuted; the critical state bit
    // out of scratch word 6.
    0x1B9C, 0x00010001, 0x4E13, 0x00000000, 0x05CF, 0x20000010,
    // S. dce110_apply_ctx_for_surface, as tests/460 has it for (a): the
    // pixel's duration (10^9 / 266640 = 3750 into 0x1242b), four buffers,
    // the scaler off, the surface under its lock, the picture shown, the
    // mark set chosen as it was.
    0x1B30, 0x00010EA6, 0x0321, 0x00000014,
    0x1AC1, 0x000006B0, 0x1B53, 0x00000000, 0x1B5E, 0x00000000, 0x1B5F, 0x00000000,
    0x1B45, 0x00000000, 0x1B42, 0x00000000, 0x1B5C, 0x00000000, 0x1B5D, 0x0F000438,
    0x1A11, 0x00010000,
    0x1A00, 0x00000001, 0x1A09, 0x00000000, 0x1A0A, 0x00000000, 0x1A0B, 0x00000000, 0x1A0C, 0x00000000,
    0x1A0D, 0x00000F00, 0x1A0E, 0x00000438, 0x1A06, 0x00000F00, 0x1AC3, 0x00000438,
    0x1A12, 0x00000000, 0x1A07, 0x000000F4, 0x1A08, 0x000000F4, 0x1A04, 0x00500000, 0x1A05, 0x00500000,
    0x1A11, 0x00000000,
    0x1BB6, 0x00010000, 0x1B9D, 0x00000000,
    0x1B32, 0x00010100
}

// The way back after all of that was done (the frames stand with the new
// picture), by the document's section on it: the same sequence towards
// the firmware's state.
const BACK = [_]usize{
    // The output sends HDMI just then: muted, its packets stopped
    // (dce110_stream_encoder_set_avmute, stop_hdmi_info_packets,
    // reset_hdmi_stream_attribute); the front end off the back end; the
    // transmitter off, told the mode the back end has just then (HDMI):
    // 04 | 00 | 03 | 00 | 00 00 00 00 | 02 | 00 | 0c | 00 | 00 00 00 00.
    0x4E13, 0x00000001, 0x4E10, 0x00000000, 0x4E2D, 0x00000000, 0x4E09, 0x00000011,
    0x4E47, 0x10030000,
    0x7F00, 0x00030004, 0x7F01, 0x00000000, 0x7F02, 0x000C0002, 0x7F03, 0x00000000, 0x7F10, 76,
    // Blanked, stopped (EnableCRTC, DISABLE), the buffers given back,
    // the critical state bit.
    0x1BB6, 0x00010000, 0x1B9D, 0x00000100,
    0x7F00, 0x00000000, 0x7F10, 35,
    0x0321, 0x00000010,
    0x05CF, 0x20000110,
    // The formatter's expansion as it was (off). SetPixelClock for the
    // firmware's clock as measured, in whole 10 kHz, and its DVI mode:
    // 30 79 10 00 | 18 | 21 | 02 | 00 | 00 | 00 | 00 00 | 00 00 00 00.
    0x1BED, 0x00000000,
    0x7F00, 0x00107930, 0x7F01, 0x00022118, 0x7F02, 0x00000000, 0x7F03, 0x00000000, 0x7F10, 12,
    0x010C, 0x00000101,
    // The firmware's timing: 1280x960 of 1800x1000, a front porch of 96
    // pixels and one line, pulses of 112 and 3, both the high ones: 00 05
    // | 08 02 | c0 03 | 28 00 | 60 00 | 70 00 | 01 00 | 03 00 | 00 00 |
    // 00 | 00 | 00 | 00 00 00.
    0x7F00, 0x02080500, 0x7F01, 0x002803C0, 0x7F02, 0x00700060, 0x7F03, 0x00030001, 0x7F04, 0x00000000, 0x7F05, 0x00000000, 0x7F10, 49,
    // The firmware's words beside the timing; the update mode and lock
    // as planned; EnableCRTC, ENABLE.
    0x1BA9, 0x00000000, 0x1BB3, 0x00003101, 0x1B89, 0x00000000, 0x1B88, 0x00000000,
    0x1BBE, 0x00000000, 0x1BBD, 0x00000000,
    0x7F00, 0x00000100, 0x7F10, 35,
    // The front end takes the controller; the back end's mode as it was
    // (2); the stream in DVI mode at 107960 kHz: 04 | 0f | 02 | 04 | 2c
    // 2a 00 00 | 00 | 00 | 00 00; the pixel encoding as it was.
    0x4E00, 0x01000000, 0x4E47, 0x10020000,
    0x7F00, 0x04020F04, 0x7F01, 0x00002A2C, 0x7F02, 0x00000000, 0x7F10, 4,
    0x4E00, 0x01000000,
    // Every word of the HDMI packets as the firmware had it (nothing),
    // the info frames' block's clock last.
    0x4E1E, 0x00000000, 0x4E1F, 0x00000000, 0x4E20, 0x00000000, 0x4E21, 0x00000000,
    0x4E0E, 0x00000000, 0x4E0F, 0x00000000, 0x4E10, 0x00000000, 0x4E2D, 0x00000000,
    0x4E09, 0x00000000, 0x4E0D, 0x00000000, 0x4E7E, 0x00000000,
    // The transmitter on in DVI mode at the firmware's clock: 04 | 01 |
    // 02 | 04 | 2c 2a 00 00 | 02 | 00 | 0c | 00 | 00 00 00 00.
    0x7F00, 0x04020104, 0x7F01, 0x00002A2C, 0x7F02, 0x000C0002, 0x7F03, 0x00000000, 0x7F10, 76,
    // The mode once more, the front end on the back end as it was; the
    // early blanking as it was; not muted, as it was; the two scratch
    // words whole.
    0x4E47, 0x10020000, 0x4E47, 0x10021000,
    0x1B9C, 0x00010001, 0x4E13, 0x00000000,
    0x05CF, 0x00000010, 0x05CB, 0x20010005,
    // The firmware's picture: its pixel duration, two buffers, the line
    // buffer's setting, the sharpening, the viewport of 1280 above 960;
    // its surface under the lock (taken and let go as planned); shown as
    // it was.
    0x1B30, 0x0001242B, 0x0321, 0x00000012,
    0x1AC1, 0x001006B0, 0x1B53, 0x00000011, 0x1B5E, 0x00000000, 0x1B5F, 0x00000000,
    0x1B45, 0x00000000, 0x1B42, 0x00000000, 0x1B5C, 0x00000000, 0x1B5D, 0x050003C0,
    0x1A11, 0x00010000,
    0x1A00, 0x00000001, 0x1A09, 0x00000000, 0x1A0A, 0x00000000, 0x1A0B, 0x00000000, 0x1A0C, 0x00000000,
    0x1A0D, 0x00000500, 0x1A0E, 0x000003C0, 0x1A06, 0x00000500, 0x1AC3, 0x000003C0,
    0x1A12, 0x00000001, 0x1A07, 0x000000F4, 0x1A08, 0x00000000, 0x1A04, 0x00000000, 0x1A05, 0x00000000,
    0x1A11, 0x00000000,
    0x1BB6, 0x00000100, 0x1B9D, 0x00000000,
    // Each set of marks given what it held, the set chosen as it was.
    0x1B32, 0x00010000, 0x1B33, 0x00FA0030,
    0x1B32, 0x00010100, 0x1B33, 0x00FA0040,
    0x1B32, 0x00010200, 0x1B33, 0x00000000,
    0x1B32, 0x00010300, 0x1B33, 0x00000000,
    0x1B32, 0x00010100,
    // What still differs from the firmware's: the controller's update
    // mode, which was written as nothing.
    0x1BBE, 0x00000002
}

// The way back from a failure before any table of the output's has
// written (the front end's bit did not hold): the registers alone. The
// marks' sets each given what it held; then what differs: the mark set
// is chosen as it was already, the two scratch words get the bits back
// that were written (the back end's word holds what it held: the write
// to it did not hold).
const BACK_REGISTERS = [_]usize{
    0x1B32, 0x00010000, 0x1B33, 0x00FA0030,
    0x1B32, 0x00010100, 0x1B33, 0x00FA0040,
    0x1B32, 0x00010200, 0x1B33, 0x00000000,
    0x1B32, 0x00010300, 0x1B33, 0x00000000,
    0x1B32, 0x00010100,
    0x05CF, 0x00000010, 0x05CB, 0x20010005
}

// A change that must fail and leave every register of the display as the
// firmware had it.
fn mustComeBack(name: []const u8, reason: set.Reason) -> void {
    const done = carry(true)
    expect(!done && result.outcome == set.Outcome.back, name)
    expect(result.reason == reason, name)
    expect(result.astray == 0 && result.doubts == 0 && asBefore(), name)
    line("gpu: putting the firmware's state back")
    line("gpu: the firmware's state is back (")
    noLine("the monitor's own mode is set")
    noLine("NOT all back")
    noLine("NOT known to be back")
    noLine("did not come to its end")
    // (What is said for the log alone was switched off again each time.)
    expect(!card.aside && card.asides % 2 == 0, name)
}

// A change that must fail on a card that does the same wrong on the way
// back (a state it never brings, a table that never does its work): the
// way back goes on to its end and every register of the display is as
// the firmware had it, but what it looked for was not all there, so it
// is not said that the firmware's state is back: it is said that this is
// not known, and how many things were not there.
fn mustComeBackUnsure(name: []const u8, reason: set.Reason) -> void {
    const done = carry(true)
    expect(!done && result.outcome == set.Outcome.unsure, name)
    expect(result.reason == reason, name)
    expect(result.astray == 0 && result.doubts != 0 && asBefore(), name)
    line("gpu: putting the firmware's state back")
    line("gpu: on the way back, not as it should be (the way goes on): ")
    line("gpu: the firmware's state is NOT known to be back: the registers this driver wrote have the firmware's values again (")
    line(if result.doubts == 1 { "), but 1 thing on the way back was not as it should be (said in the log); the controller counts " } else { " things on the way back were not as they should be (said in the log); the controller counts " })
    noLine("gpu: the firmware's state is back (")
    noLine("the monitor's own mode is set")
    noLine("NOT all back")
    noLine("did not come to its end")
    expect(!card.aside && card.asides % 2 == 0, name)
}

// After a way back that ran the tables (`runs` of them: seven, or six
// when the transmitter was off already and its table left out): they
// were told the firmware's clock and timing, the PLL gives the clock
// that was measured (in whole 10 kHz), and the controller counts frames
// as before.
fn wholeWayBack(name: []const u8, runs: usize) -> void {
    expect(result.runsBack == runs && card.pll[4] == 107960, name)
    line(if runs == 7 { "7 table runs told the firmware's 1280x960 at 107960 kHz: the PLL's and the transmitter's own settings are the tables' for that, they cannot be read)" } else { "6 table runs told the firmware's 1280x960 at 107960 kHz: the PLL's and the transmitter's own settings are the tables' for that, they cannot be read)" })
    if runs == 6 { line("gpu: left out, the card being as it is: the transmitter off\n") }
    line("; the controller counts frames (59.9")
    line(" a second, as before)\n")
}

// The last ten writes of a way back that puts the display engine's clock
// back (the firmware's 225000 kHz): the firmware's scratch words as Linux
// has them for every table (bit 29 of word 6 set, bits 29 and 16 of word
// 2 cleared), the clock's table (e4 57 00 00 | 00 | 08 | 00 | 00), the
// reference clock's, and both words whole as the firmware had them.
fn clockLast() -> void {
    const end = card.written
    if end < 10 {
        expect(false, "the clock's tables of the way back")
        return
    }
    expect(card.writtenTo[end - 10] == 0x05CF && card.writtenWith[end - 10] == 0x20000010 && card.writtenTo[end - 9] == 0x05CB && card.writtenWith[end - 9] == 0x00000005, "the scratch words as Linux has them before the clock's tables of the way back")
    expect(card.writtenTo[end - 8] == 0x7F00 && card.writtenWith[end - 8] == 0x000057E4 && card.writtenWith[end - 6] == 46 && card.writtenWith[end - 5] == 0 && card.writtenWith[end - 4] == 0x00000801 && card.writtenTo[end - 3] == 0x7F10, "the clock's tables are the last tables of the way back")
    expect(card.writtenTo[end - 2] == 0x05CF && card.writtenWith[end - 2] == 0x00000010 && card.writtenTo[end - 1] == 0x05CB && card.writtenWith[end - 1] == 0x20010005, "the scratch words given back whole after the last table of all")
}

// The lowest bit of a word that is set.
fn lowest(word: usize) -> usize { return word & (~word + 1) }

// How many of the plan's steps before `at` are table runs, and writes.
fn runsBefore(at: usize) -> usize {
    var count: usize = 0
    var k: usize = 0
    while k < at {
        if plan.steps[k].kind == mode.Kind.table { count += 1 }
        k += 1
    }
    return count
}

fn writesBefore(at: usize) -> usize {
    var count: usize = 0
    var k: usize = 0
    while k < at {
        if plan.steps[k].kind == mode.Kind.write { count += 1 }
        k += 1
    }
    return count
}

// The plan with every write in turn not holding, every state in turn not
// coming, every table's run in turn stopped by the card.
fn everyStep() -> void {
    again("the steps counted")
    const count = plan.count
    var k: usize = 0
    var tried: usize = 0
    var stuck: usize = 0
    while k < count {
        again("a step that fails")
        const step = &plan.steps[k]
        if step.*.kind == mode.Kind.write {
            card.spoilAt = writesBefore(k)
            card.spoilBit = lowest(step.*.mask)
            mustComeBack("a write that does not hold", set.Reason.read_back)
            expect(result.step == k, "the step that did not hold")
            tried += 1
        } else if step.*.kind == mode.Kind.wait {
            // The bits waited for read the other way: from the write
            // that asks for the state on, when the driver's own write to
            // the register stands before the wait and after the last
            // table; else from the table before the wait to the next
            // one.
            var asking: usize = card.NEVER
            var nth: usize = 0
            var j: usize = 0
            while j < k {
                if plan.steps[j].kind == mode.Kind.write && plan.steps[j].register == step.*.register {
                    asking = j
                    nth += 1
                }
                if plan.steps[j].kind == mode.Kind.table { asking = card.NEVER }
                j += 1
            }
            if asking != card.NEVER && step.*.mask & ~plan.steps[asking].mask != 0 {
                card.stuckRegister = step.*.register
                card.stuckMask = step.*.mask & ~plan.steps[asking].mask
                card.stuckValue = (step.*.value ^ step.*.mask) & card.stuckMask
                card.stuckFrom = nth
                // (Such a state does not come on the way back either,
                // where the same is asked of the card again: the way
                // back goes on, and does not say that the firmware's
                // state is back.)
                mustComeBackUnsure("a state that never comes", set.Reason.wait)
                stuck += 1
            } else {
                card.heldRegister = step.*.register
                card.heldMask = lowest(step.*.mask)
                card.heldValue = (step.*.value ^ step.*.mask) & card.heldMask
                card.heldFrom = runsBefore(k)
                card.heldUntil = card.heldFrom + 1
                mustComeBack("a state that does not come", set.Reason.wait)
            }
            expect(result.step == k, "the wait that did not come")
            tried += 1
        } else if step.*.kind == mode.Kind.table {
            card.refuseRun = runsBefore(k)
            mustComeBack("a table's run stopped by the card", set.Reason.table)
            expect(result.step == k && result.runs == runsBefore(k) + 1, "the run that was stopped")
            line(") was stopped at a write at 0x")
            line("failed (a table's run: it was stopped at a write): run ")
            // The table had written what it was told before it was
            // stopped: the way back is the whole one, whichever table it
            // was. (The transmitter is on only when its own first table
            // was the one stopped: after that it is off, and the way
            // back leaves its table out.)
            wholeWayBack("after a table that was stopped", if runsBefore(k) == 0 { 7 } else { 6 })
            tried += 1
        }
        k += 1
    }
    expect(tried == plan.writes + plan.runs + 11, "every write, every state and every run was tried")
    // (The states that follow a write of the driver's own: blanked, the
    // buffers given back and given, the surface taken, shown.)
    expect(stuck == 5, "five of the states are the card's answers to the driver's own writes")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    show = std.process.count(arguments) > 1
    open(card.NEVER, card.Ending.plain)
    expect(board.found && board.count == 3 && board.connectors[0].hotPlugLine == 2 && board.connectors[1].hotPlugLine == 1 && board.connectors[2].hotPlugLine == 6, "the ROM's connectors and their hot plug lines")
    expect(information.found && information.generator == 3600000 && information.engine == 625000, "the ROM's clocks")

    // The plan on the user's machine.
    again("the user's machine: DVI at 107962 kHz to HDMI at 266640 kHz")
    line("gpu: controller 0 goes out by DIG 4 (front end 4): TMDS (DVI)\n")
    line("gpu: plan (b, TMDS): HDMI signalling at 266640 kHz (now DVI at 107960 kHz), the clock's PLL, the timing and the transmitter by the card's own tables, a picture of 3840x1080 at 0x500000 of the aperture, the scaler off: 7 table runs and 86 writes would do it\n")
    line("gpu: DIG 4 is UNIPHY E; the ROM puts a connector of the kind \"HDMI\" behind it, hot plug line 2 (the back end's own word names line 2; the line says a monitor is there)\n")
    line("gpu: controller 0 takes its pixel clock from PHY PLL 4; the way back would ask for 107960 kHz (measured) and the timing 1280x960 of 1800x1000 (front porches 96 and 1, pulses 112 and 3)\n")
    line("gpu: firmware scratch 2 is 0x20010005, 6 is 0x10; front end 4's HDMI control is 0x0, it sends no audio samples\n")
    line("gpu: this output carries 299999 kHz at most (HDMI below 300 MHz: the card's ROM does not say more for this output)\n")
    line("gpu: the display clock is 600000 kHz (the ROM's clock of 3600000 kHz over 6; the ROM's own figure 625000 kHz): enough for 266640 kHz, which needs 321967\n")
    line("gpu: would set 05cf & 20000000 = 20000000 (the firmware's tables told not to switch displays themselves)\n")
    line("gpu: would run UNIPHYTransmitterControl with 04 00 02 00 00 00 00 00 02 00 0c 00 00 00 00 00, only when 4e48 & 00000001 = 00000001 (the transmitter off)\n")
    line("gpu: would wait for 4e48 & 00000001 = 00000000 (until the transmitter is off)\n")
    line("gpu: would wait 100000 us (the monitor sees the signal gone)\n")
    line("gpu: would run EnableCRTC with 00 00 00 00 (the controller stopped)\n")
    line("gpu: would run SetPixelClock with a0 af 28 00 18 21 03 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set)\n")
    line("gpu: would look for 0143 & 00000017 = 00000004 (it is this back end's PLL's)\n")
    line("gpu: would run SetCRTC_UsingDTDTiming with 00 0f a0 00 38 04 1f 00 30 00 20 00 03 00 0a 00 04 00 00 00 00 00 00 00 (the timing set)\n")
    line("gpu: would read the timing's words (the timing's words as the table was told)\n")
    line("gpu: would count the frames (the frames counted with the transmitter still off: the PLL's clock)\n")
    line("gpu: would run DIGxEncoderControl with 04 0f 03 04 28 68 00 00 02 00 00 00 (the front end told the stream)\n")
    line("gpu: would write 4e1e = 80081ebd (the AVI info frame: RGB, the picture as it is)\n")
    line("gpu: would run UNIPHYTransmitterControl with 04 01 03 04 28 68 00 00 02 00 0c 00 00 00 00 00 (the transmitter on)\n")
    line("gpu: would read 4e47 (what the transmitter's table left in the back end's word)\n")
    line("gpu: on the way back would run UNIPHYTransmitterControl with 04 00 02 00 00 00 00 00 02 00 0c 00 00 00 00 00, or with 04 00 03 00 00 00 00 00 02 00 0c 00 00 00 00 00 when 4e47 & 00070000 = 00030000, only when 4e48 & 00000001 = 00000001 (the transmitter off)\n")
    line("gpu: on the way back would run SetPixelClock with 30 79 10 00 18 21 02 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set for the firmware's clock)\n")
    line("gpu: on the way back would run SetCRTC_UsingDTDTiming with 00 05 08 02 c0 03 28 00 60 00 70 00 01 00 03 00 00 00 00 00 00 00 00 00 (the firmware's timing set)\n")
    line("gpu: on the way back would run UNIPHYTransmitterControl with 04 01 02 04 2c 2a 00 00 02 00 0c 00 00 00 00 00 (the transmitter on for the firmware's clock)\n")
    listingHolds()
    expect(plan.situation == mode.Situation.tmds && plan.complete && plan.missing == mode.Missing.nothing && !plan.rehearsal, "the plan is complete")
    expect(plan.writes == 86 && plan.runs == 7 && plan.count == 108 && plan.backRuns == 7, "86 writes, 7 table runs, 15 looks at the card")
    expect(plan.backCount == 96, "the way back: 96 steps")
    expect(plan.tmds.hdmi && !plan.tmds.hdmiNow && plan.tmds.clockBack == 107960 && plan.tmds.line == 2 && plan.tmds.connector == 0x0C && !plan.tmds.another && !plan.tmds.engineRaised, "what the plan found")
    expect(plan.width == 3840 && plan.height == 1080 && plan.offset == 0x500000 && plan.millihertz == 60000 && plan.hTotal == 4000 && plan.vTotal == 1111, "the picture and the rate to hold against")
    expect(card.written == 0 && card.runs == 0, "the plan is made without a write and without a table's run")

    // The setting off: nothing is written, and no table is run.
    expect(!carry(false), "the setting off: not done")
    expect(card.written == 0 && card.runs == 0 && card.cleared == 0 && result.outcome == set.Outcome.untouched && result.runs == 0, "the setting off: no write, no table run, nothing cleared")
    expect(asBefore(), "the setting off: every register as it was")
    line("gpu: nothing is written to the card (the image does not ask for the monitor's own mode: settings/gpu)\n")
    // And a plan with table runs is not carried out without the tables.
    {
        const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
        const hands = set.Hands.{ .write = card.write, .clear = card.clear }
        expect(!set.attempt(&out, &hands, &plan, true, &result) && card.written == 0, "without the tables lent: no write")
        line("but the card's tables are not lent: nothing is written to the card\n")
    }

    // The setting on: the sequence, and the picture.
    expect(carry(true), "the change carried out")
    sameWrites("the change, write for write and run for run", 0, THERE[0..])
    expect(result.outcome == set.Outcome.done && result.writes == 86 && result.runs == 7 && result.writesBack == 0 && result.runsBack == 0, "done in 86 writes and 7 table runs")
    expect(card.cleared == 1 && card.clearedAt == 0x500000 && card.clearedBytes == 16588800 && !card.writtenBeforeClear, "the new picture cleared first")
    expect(card.pll[4] == 266640 && result.rate.frames != 0 && result.rate.millihertz == 60000, "the PLL's clock and the frames counted afterwards")
    expect(card.marks[0] == 0xFFFFFFFF && card.marks[3] == 0xFFFFFFFF && card.raw(0x1B32) == 0x00010100, "all four mark sets, the choice as it was")
    expect(card.raw(0x5CF) == 0x20000010 && card.raw(0x5CB) == 0x00000005, "the scratch words as Linux leaves them")
    // (How long at most, whatever the card does: there, nine states
    // waited for a tenth of a second each and the pause of a tenth, seven
    // tables of 2.255 s each (two seconds and one wait of a table's own),
    // the frames counted twice in 0.35 s each: 17.485 s. The way back has
    // as many of each.)
    line("gpu: the image asks for the monitor's own mode (settings/gpu): carrying out the plan's 7 table runs and 86 writes; the screen is dark meanwhile, 18 s at most (and 18 s more at most if the firmware's state has to be put back)\n")
    expect(result.longest == 17485000000 && result.longestBack == 17485000000, "the longest the change and its way back could take")
    line("gpu: table UNIPHYTransmitterControl (the transmitter off) ran to its end: 6 instructions, 0 reads, 5 writes (5 registers not written before), 0 us waited\n")
    line("gpu: 4e48 & 00000001 is 00000000 after 0 ms (until the transmitter is off)\n")
    line("gpu: table SetPixelClock (the pixel clock's PLL set) ran to its end: 6 instructions, 0 reads, 5 writes (0 registers not written before), 0 us waited\n")
    line("gpu: 0143 & 00000017 is 00000004 (it is this back end's PLL's)\n")
    line("gpu: the timing's table left h 3999 112..3952 pulse 0..32 +, v 1110 28..1108 pulse 0..10 - (as it was told)\n")
    line("gpu: controller 0 counts 60.000 frames a second with the output still off: the PLL gives 266640 kHz (asked for: 266640 kHz)\n")
    line("gpu: 4e47 reads 10031000 (what the transmitter's table left in the back end's word)\n")
    line("gpu: the card's tables wrote 7 registers\n")
    line("gpu: written by the tables: 7f00 7f01 7f02 7f03 7f10 7f04 7f05\n")
    line("gpu: controller 0 shows a picture of 3840x1080 as it is, 60.000 frames a second: the monitor's own mode is set (7 table runs, 86 writes, each read back)\n")
    noLine("putting the firmware's state back")
    expect(!card.aside && card.asides == 2, "what the tables did is for the log alone, the outcome for the screen too")
    // The card read again says so: the new timing, HDMI, the picture.
    {
        const out = scanout.Card.{ .read = card.read, .now = card.now, .write = logWrite }
        const after = scanout.Memory.{ .aperture = 256 * 1024 * 1024, .pictureOffset = 0x500000, .pictureBytes = 16588800, .pictureWidth = 3840, .pictureHeight = 1080, .picturePitch = 3840 }
        scanout.report(&out, &after, &readout)
        expect(readout.plausible && readout.shows[0] == scanout.Shows.as_it_is, "read again: plausible, the picture as it is")
        line("gpu: controller 0 is on (control 0x10001): 3840x1080 of 4000x1111, h blank 3952..112 sync 0..32 +, v blank 1108..28 sync 0..10 -\n")
        line("gpu: controller 0 goes out by DIG 4 (front end 4): TMDS (HDMI)\n")
        line("gpu: controller 0 shows a picture of 3840x1080 as it is: the monitor is sent 3840x1080\n")
    }

    // The way back, word for word: the frames stand with the new
    // viewport.
    again("the frames stand with the new picture")
    card.freezeRegister = 0x1B5D
    card.freezeValue = 0x0F000438
    mustComeBack("frames that stand after the change", set.Reason.frames)
    line("gpu: controller 0 counts no frames after the change\n")
    line("gpu: putting the firmware's state back (the same steps, the card's tables told the firmware's timing and clock)\n")
    sameWrites("the way back, write for write and run for run", 116, BACK[0..])
    expect(result.writes == 86 && result.runs == 7 && result.writesBack == 75 && result.runsBack == 7, "the way back: 75 writes and 7 table runs")
    // (The frames stand on the way back too while the new viewport is
    // there: said, and the way goes on.)
    wholeWayBack("after the frames stood", 7)
    noLine("gpu: left out, the card being as it is: ")
    // The timing's words are held against the firmware's timing there,
    // and the picture's steps are gone through to the last (shown again:
    // once on the way there, once on the way back).
    line("gpu: the timing's table left h 1799 424..1704 pulse 0..112 +, v 999 39..999 pulse 0..3 + (as it was told)\n")
    noLine("gpu: on the way back, not as it should be")
    expect(card.count("gpu: 1b9d & 00000001 is 00000000 after 0 ms (until it is shown)\n") == 2, "shown again at the way back's end")

    // The memory interface runs dry with the new rows.
    again("the memory interface runs dry")
    card.dryAfter = 0x1B5D
    mustComeBack("an underflow", set.Reason.underflow)
    line("gpu: the memory interface ran dry after the change (DMIF_STATUS says an underflow)\n")
    wholeWayBack("after an underflow", 7)

    // A failure at every step in turn.
    everyStep()

    // The timing's table writes a pulse that was not told: said in full,
    // and the way back.
    again("the timing's table writes something else")
    card.timingOdd = true
    expect(!carry(true) && result.reason == set.Reason.timing && result.outcome == set.Outcome.unsure && result.astray == 0 && result.doubts == 1, "timing words that are not as told")
    line("gpu: the timing's table left h 3999 112..3952 pulse 0..33 +, v 1110 28..1108 pulse 0..10 -; it was told h 3999 112..3952 pulse 0..32 +, v 1110 28..1108 pulse 0..10 -\n")
    line("failed (the timing's words are not what their table was told): read the timing's words (the timing's words as the table was told)\n")
    // (On the way back the table does the same to the firmware's timing:
    // said, and the way goes on to its end. The pulse is not one of the
    // plan's own words, so it stays a pixel longer: the tables' doing.
    // The firmware's state is therefore not back, and it is not said to
    // be: the last line says that it is not known to be, though every
    // register the driver wrote has the firmware's value.)
    line("gpu: on the way back, not as it should be (the way goes on): read the timing's words (the timing's words as the firmware had them)\n")
    expect(card.raw(0x1B82) == (113 << 16), "the pulse the table left on the way back")
    line("gpu: the firmware's state is NOT known to be back: the registers this driver wrote have the firmware's values again (")
    line("), but 1 thing on the way back was not as it should be (said in the log); the controller counts frames (59.9")
    noLine("gpu: the firmware's state is back (")

    // The PLL keeps its clock whatever the table is told: found with the
    // transmitter still off, before the monitor is sent anything.
    again("the PLL does not take the clock")
    card.clockDeaf = true
    {
        const done = carry(true)
        expect(!done && result.reason == set.Reason.clock && result.outcome == set.Outcome.back && result.astray == 0, "the PLL keeps its clock: back")
        line("gpu: controller 0 counts 24.293 frames a second with the output still off: the PLL gives 10796")
        line(" kHz (asked for: 266640 kHz)\n")
        line("failed (the frames counted with the output off): count the frames (the frames counted with the transmitter still off: the PLL's clock)\n")
        // The transmitter was never turned on for the wrong clock: on
        // the way there one table of its ran (off), on the way back two.
        var enables: usize = 0
        var k: usize = 0
        while k < card.written {
            if card.writtenTo[k] == 0x7F00 && card.writtenWith[k] & 0xFF00 == 0x0100 && k + 4 < card.written && card.writtenTo[k + 4] == 0x7F10 && card.writtenWith[k + 4] == 76 { enables += 1 }
            k += 1
        }
        expect(enables == 1 && result.runs == 5, "the transmitter turned on once, on the way back")
        expect(card.raw(0x4E48) & 1 == 1 && card.pll[4] == 107962, "the output is on again at the firmware's clock")
        // The back end was still in the firmware's DVI mode and its
        // transmitter off when the way back began: nothing of HDMI is
        // muted or stopped there (the front end's packet words are not
        // touched for an output that does not send HDMI just then), and
        // the transmitter's table is not run to turn off what is off.
        line("gpu: left out, the card being as it is: the HDMI output muted\n")
        line("gpu: left out, the card being as it is: no generic packets\n")
        line("gpu: left out, the card being as it is: the HDMI packets' control as a stopped stream's\n")
        line("gpu: left out, the card being as it is: the transmitter off\n")
        var muted = false
        k = 0
        while k < card.written {
            if card.writtenTo[k] == 0x4E13 && card.writtenWith[k] & 1 == 1 { muted = true }
            k += 1
        }
        expect(!muted, "no mute written for an output in DVI mode")
    }

    // The PLL takes the new clock and then no other: on the way back the
    // controller counts the firmware's timing at the new clock (148
    // frames a second, not 60). The way back ends there: the
    // transmitter is not turned on for a clock that is known to be
    // wrong, and it is said that the output is left.
    again("the PLL takes no clock on the way back")
    card.clockDeafFrom = 1
    card.dryAfter = 0x1B5D
    {
        const done = carry(true)
        expect(!done && result.reason == set.Reason.underflow && result.outcome == set.Outcome.lost, "frames at another rate on the way back: it ends there")
        line("gpu: controller 0 counts 148.1")
        // (The clock is measured by the frames: 266639 or 266640.)
        line(" frames a second with the output still off: the PLL gives 2666")
        line(" kHz (asked for: 107960 kHz)\n")
        line("gpu: the way back ends at its step 32 of 96: count the frames (the frames counted with the transmitter still off: the firmware's rate)\n")
        line("gpu: the way back ends at its step ")
        line(": count the frames (the frames counted with the transmitter still off: the firmware's rate)\n")
        line("gpu: the way back did not come to its end: the output is left as that left it until a restart; the registers this driver wrote have the firmware's values again (")
        noLine("the firmware's state is back")
        expect(card.raw(0x4E48) & 1 == 0 && result.runsBack == 5 && card.pll[4] == 266640, "the transmitter is not turned on for a wrong clock")
    }

    // A monitor whose own timing runs at another rate than the
    // firmware's (50 frames a second: 222200 kHz for 4000 by 1111): the
    // frames of the way back are held against the firmware's rate, not
    // the plan's.
    card.reset()
    if show { say("-- a monitor at 50 Hz\n") }
    card.firmware(0, 4, 4, false, 2, 107962)
    {
        var monitor = wide()
        monitor.timing.clock = 222200
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
    }
    expect(plan.complete && plan.millihertz == 50000 && plan.tmds.hdmi, "a plan for 50 frames a second")
    card.dryAfter = 0x1B5D
    mustComeBack("50 frames a second, an underflow", set.Reason.underflow)
    line("gpu: controller 0 counts 50.000 frames a second with the output still off: the PLL gives 222200 kHz (asked for: 222200 kHz)\n")
    wholeWayBack("after 50 frames a second", 7)

    // A card that counts no frames while the transmitter is off: said as
    // such; the way back counts none either at that place and goes on to
    // its end.
    again("no frames while the transmitter is off")
    card.framesNeedTransmitter = true
    mustComeBack("no frames with the output off", set.Reason.clock)
    line("gpu: controller 0 runs but counts no frames with the output off: the clock is not judged here, nothing is sent\n")
    line("gpu: controller 0 runs but counts no frames with the output off: the clock is not judged here; the firmware's own timing is sent all the same\n")
    wholeWayBack("after no frames with the output off", 6)

    // A failure before any table of the output's has written (the front
    // end's bit, the eleventh write, does not hold): the registers alone,
    // no table is run.
    again("the front end's bit does not hold")
    card.spoilAt = 10
    card.spoilBit = 0x1000
    mustComeBack("a failure before the first table", set.Reason.read_back)
    line("gpu: putting the firmware's state back (nothing of the output was changed by a table yet: the registers alone)\n")
    sameWrites("the way back before the first table", 11, BACK_REGISTERS[0..])
    expect(card.runs == 0 && result.runs == 0 && result.runsBack == 0, "no table was run")
    // The first write of all: nothing but the mark set to choose again.
    again("the first write does not hold")
    card.spoilAt = 0
    card.spoilBit = 0x100
    mustComeBack("the first write", set.Reason.read_back)
    // (Each set is chosen in turn, none of them was written: no marks
    // are written back.)
    expect(card.written == 6 && card.writtenTo[1] == 0x1B32 && card.writtenWith[1] == 0x00010000 && card.writtenTo[4] == 0x1B32 && card.writtenWith[4] == 0x00010300 && card.writtenTo[5] == 0x1B32 && card.writtenWith[5] == 0x00010100, "the way back from the first write: the mark set chosen as it was")

    // Tables that do not do as a table should, each of the five in turn:
    // one that writes nothing, one that meets an opcode that is none
    // after it has written, one that does not end (stopped after two
    // seconds).
    var which: usize = 0
    while which < 5 {
        const table = card.TABLES[which]
        // (The first run of each table: the transmitter's is the first
        // of the output's.)
        open(table, card.Ending.nothing)
        again("a table that writes nothing")
        {
            const done = carry(true)
            expect(!done && result.reason == set.Reason.table && result.run.end == atom.End.done && result.run.writes == 0, "a table that writes nothing ends the change")
            line("failed (a table's run: it ran to its end and wrote nothing): run ")
            // Its runs on the way back write nothing either: said, the
            // way goes on, and where it was the first table of the
            // output's no table is run at all.
            if table == 76 {
                expect(result.outcome == set.Outcome.back && result.runsBack == 0 && result.doubts == 0 && asBefore(), "the first table writes nothing: the registers alone")
            } else {
                // (A table that never does its work has not done it on
                // the way back either: the state is not said to be back.)
                expect(result.runsBack == 6 && result.outcome == set.Outcome.unsure && result.doubts != 0 && result.astray == 0, "another table writes nothing: the whole way back")
                line("gpu: on the way back, not as it should be (the way goes on): run ")
                line("gpu: the firmware's state is NOT known to be back: ")
                noLine("gpu: the firmware's state is back (")
            }
        }
        open(table, card.Ending.broken)
        again("a table with an opcode that is none")
        {
            const done = carry(true)
            expect(!done && result.reason == set.Reason.table && result.outcome == set.Outcome.lost, "a table that cannot be run: the way back ends at it too")
            line(") met an opcode that is none at 0x")
            line("failed (a table's run: it met an opcode that is none): run ")
            line("gpu: the way back ends at its step ")
            line("gpu: the way back did not come to its end: the output is left as that left it until a restart; the registers this driver wrote have the firmware's values again (")
            noLine("the firmware's state is back")
        }
        open(table, card.Ending.loop)
        again("a table that does not end")
        {
            const done = carry(true)
            expect(!done && result.reason == set.Reason.table && result.run.end == atom.End.time && result.outcome == set.Outcome.lost, "a table that does not end is stopped")
            line(") was stopped after too long at 0x")
            expect(result.run.waited >= 2000000 && result.run.waited <= 2400000, "after two seconds")
        }
        which += 1
    }
    open(card.NEVER, card.Ending.plain)

    // A table's run stopped by the card on the way back (the tenth run:
    // the third of the way back, the pixel clock's): nothing more is
    // run, the registers get the firmware's values, and it is said that
    // the output is left.
    again("a table fails on the way back")
    card.freezeRegister = 0x1B5D
    card.freezeValue = 0x0F000438
    card.refuseRun = 9
    {
        const done = carry(true)
        expect(!done && result.reason == set.Reason.frames && result.outcome == set.Outcome.lost, "the way back ends at the table")
        expect(result.runs == 7 && result.runsBack == 3 && card.runs == 10, "three tables on the way back, none after")
        line("gpu: the way back ends at its step ")
        line(": run SetPixelClock with 30 79 10 00 18 21 02 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set for the firmware's clock)\n")
        line("gpu: the way back did not come to its end: the output is left as that left it until a restart; the registers this driver wrote have the firmware's values again (")
        noLine("the firmware's state is back")
        // The plan's own registers are the firmware's again all the
        // same (the controller's and the back end's bits are the
        // tables': the output is off and the controller stopped).
        expect(card.raw(0x1B5D) == 0x050003C0 && card.raw(0x1A04) == 0 && card.raw(0x5CF) == 0x10 && card.raw(0x5CB) == 0x20010005 && card.raw(0x4E48) & 1 == 0, "the registers back, the output off")
    }

    // The same with the firmware's early blanking on (a field of the
    // controller's word, which the plan clears): the way back ends with
    // the controller stopped by its table, and the word is given the
    // firmware's field again without the controller's own bits, which
    // are the tables': a write of the whole word as the firmware had it
    // would start the controller behind the tables' back.
    card.reset()
    if show { say("-- a table fails on the way back, the controller's word\n") }
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x1B9C, card.raw(0x1B9C) | 0x100000)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
    }
    card.freezeRegister = 0x1B5D
    card.freezeValue = 0x0F000438
    card.refuseRun = 9
    {
        const done = carry(true)
        expect(plan.complete && !done && result.outcome == set.Outcome.lost && result.runsBack == 3, "the early blanking on: the way back ends at the table")
        expect(card.raw(0x1B9C) & 0x700001 == 0x100000, "the early blanking as it was, the controller left stopped")
    }

    // The display engine's clock is too low for the new rows (the
    // divider's number 0x40: 3600 MHz over 16, 225 MHz; 266640 kHz needs
    // 321967): raised by its table, the reference clock's after it, both
    // before anything of the output; and put back last on the way back.
    again("")
    card.reset()
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x124, 0x08000040)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
    }
    line("gpu: the display clock is 225000 kHz (the ROM's clock of 3600000 kHz over 16; the ROM's own figure 625000 kHz): raised to 321967 kHz for 266640 kHz\n")
    line("gpu: would run SetDCEClock with c4 7d 00 00 00 08 00 00 (the display engine's clock raised)\n")
    line("gpu: would run SetDCEClock with 00 00 00 00 01 08 00 00 (the DisplayPort reference clock set again after it)\n")
    line("gpu: on the way back would run SetDCEClock with e4 57 00 00 00 08 00 00 (the display engine's clock as it was)\n")
    expect(plan.complete && plan.tmds.engineRaised && plan.tmds.engineAsked == 321967 && plan.runs == 9 && plan.clockAt == 10 && plan.outputAt == 12, "the clock raised: nine table runs")
    expect(carry(true), "the clock raised: carried out")
    // (Two tables more each way: 21.995 s.)
    line("carrying out the plan's 9 table runs and 86 writes; the screen is dark meanwhile, 22 s at most (and 22 s more at most if the firmware's state has to be put back)\n")
    expect(result.longest == 21995000000 && result.longestBack == 21995000000, "the longest with the clock's tables")
    // SetDCEClock: c4 7d 00 00 | 00 | 08 | 00 | 00 (32196 tens of kHz,
    // the display clock, from the card's own divider), then 00 00 00 00
    // | 01 | 08 | 00 | 00 (the DisplayPort reference clock); they stand
    // after the scratch words and before the front end's bit.
    expect(card.writtenTo[10] == 0x7F00 && card.writtenWith[10] == 0x00007DC4 && card.writtenTo[11] == 0x7F01 && card.writtenWith[11] == 0x00000800 && card.writtenTo[12] == 0x7F10 && card.writtenWith[12] == 46, "the display engine's clock's block")
    expect(card.writtenTo[13] == 0x7F00 && card.writtenWith[13] == 0 && card.writtenTo[14] == 0x7F01 && card.writtenWith[14] == 0x00000801 && card.writtenTo[15] == 0x7F10 && card.writtenWith[15] == 46 && card.writtenTo[16] == 0x4E47, "the reference clock's block, then the output")
    // (The divider's number 0x2c gives 3600 MHz over 11: 327272 kHz.)
    expect(card.raw(0x124) & 0x7F == 0x2C, "the divider the table chose")
    line("gpu: table SetDCEClock (the display engine's clock raised) ran to its end: 5 instructions, 1 reads, 3 writes (3 registers not written before), 0 us waited; it answers 327270 kHz\n")
    // The same, and the frames stand: the clock is put back last.
    card.reset()
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x124, 0x08000040)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
    }
    card.freezeRegister = 0x1B5D
    card.freezeValue = 0x0F000438
    mustComeBack("the clock raised, and the frames stand", set.Reason.frames)
    expect(result.runs == 9 && result.runsBack == 9 && card.raw(0x124) == 0x08000040, "the display engine's clock as it was")
    // 22500 tens of kHz: e4 57 00 00 | 00 | 08 | 00 | 00, then the
    // reference clock's block: the last tables of all. They are run as
    // every table is, with the firmware's scratch words as Linux has them
    // (the words were given back whole after the output's last table:
    // bit 29 of word 6 is set once more and bits 29 and 16 of word 2
    // cleared before the two, and both words given back whole after
    // them): the last ten writes of all.
    clockLast()
    // The clock raised and then a failure before the output's first
    // table: the registers and the clock, nothing of the output.
    card.reset()
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x124, 0x08000040)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
    }
    card.spoilAt = 10
    card.spoilBit = 0x1000
    mustComeBack("the clock raised, the front end's bit does not hold", set.Reason.read_back)
    expect(result.runs == 2 && result.runsBack == 2 && card.runs == 4 && card.raw(0x124) == 0x08000040, "the clock's two tables there and back, no other")
    // (Here too the clock's tables of the way back find the scratch
    // words as Linux has them.)
    clockLast()
    // (What ran on the way back is said as what it was: the clock's two
    // tables, none of the output's.)
    line("gpu: the firmware's state is back (15 writes, 2 table runs for the display engine's clock as it was); the controller counts frames (")
    noLine("2 table runs told the firmware's")
    // The same, and the firmware's scratch word 2 takes no write after
    // its third (cleared on the way there, given back, cleared again for
    // the clock's tables): the last write of the way back, which gives it
    // back once more, does not hold. That is found and said: the
    // registers are gone over after the clock's tables too.
    card.reset()
    if show { say("-- the clock raised, a scratch word that stays\n") }
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x124, 0x08000040)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
    }
    card.spoilAt = 10
    card.spoilBit = 0x1000
    card.deafRegister = 0x5CB
    card.deafAfter = 3
    {
        const done = carry(true)
        expect(!done && result.reason == set.Reason.read_back && result.outcome == set.Outcome.astray && result.astray == 1 && result.runsBack == 2, "a scratch word that stays as the clock's tables had it: not all back")
        expect(card.raw(0x5CB) == 0x00000005 && card.raw(0x5CF) == 0x00000010 && card.raw(0x124) == 0x08000040, "word 2 as Linux has it, word 6 and the clock the firmware's")
        line("gpu: 05cb holds 00000005, the firmware had 20010005\n")
        line("gpu: the firmware's state is NOT all back: 1 register differs; the controller counts frames (")
    }

    // The clock raised, and a table stopped by the card on the way back
    // (the twelfth run: the third of the way back): nothing more is run,
    // the clock's tables neither, and the clock stays as raised.
    card.reset()
    if show { say("-- the clock raised, a table fails on the way back\n") }
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x124, 0x08000040)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
    }
    card.freezeRegister = 0x1B5D
    card.freezeValue = 0x0F000438
    card.refuseRun = 11
    {
        const done = carry(true)
        expect(!done && result.outcome == set.Outcome.lost && result.runs == 9 && result.runsBack == 3 && card.runs == 12, "the clock raised, a table fails on the way back: nothing more is run")
        expect(card.raw(0x124) & 0x7F == 0x2C, "the display engine's clock is left as raised")
    }
    // The clock's own table runs to its end and writes nothing: the
    // change ends at it, the first table of all, and no table is run on
    // the way back (there is no clock to put back).
    open(46, card.Ending.nothing)
    card.reset()
    if show { say("-- the clock's table writes nothing\n") }
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x124, 0x08000040)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.own)
    }
    {
        const done = carry(true)
        expect(plan.complete && !done && result.reason == set.Reason.table && result.outcome == set.Outcome.back, "the clock's table writes nothing: the change ends")
        // (One run was made, of a table that wrote nothing: the card saw
        // none.)
        expect(result.runs == 1 && result.runsBack == 0 && card.runs == 0, "the clock's table writes nothing: no table on the way back")
        expect(asBefore(), "the clock's table writes nothing: every register as it was")
    }
    open(card.NEVER, card.Ending.plain)

    // The firmware's own mode set again (the rehearsal): the same steps
    // with the firmware's timing, mode and clock, and the picture left
    // where it is.
    card.reset()
    card.firmware(0, 4, 4, false, 2, 107962)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.rehearsal)
    }
    line("gpu: plan (the firmware's own mode set again): DVI signalling at 107960 kHz, 1280x960 of 1800x1000 as the firmware runs it, the picture where it is: 7 table runs and 34 writes would do it\n")
    line("gpu: the display clock is 600000 kHz (the ROM's clock of 3600000 kHz over 6; the ROM's own figure 625000 kHz): left as it is\n")
    line("gpu: would run SetPixelClock with 30 79 10 00 18 21 02 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set)\n")
    line("gpu: would run SetCRTC_UsingDTDTiming with 00 05 08 02 c0 03 28 00 60 00 70 00 01 00 03 00 00 00 00 00 00 00 00 00 (the timing set)\n")
    line("gpu: would run DIGxEncoderControl with 04 0f 02 04 2c 2a 00 00 00 00 00 00 (the front end told the stream)\n")
    line("gpu: would run UNIPHYTransmitterControl with 04 01 02 04 2c 2a 00 00 02 00 0c 00 00 00 00 00 (the transmitter on)\n")
    // (DVI signalling: the formatter does not expand to twelve bits.)
    line("gpu: would set 1bed & 00000011 = 00000000 (the formatter's expansion to twelve bits, for HDMI alone)\n")
    noLine("the AVI info frame")
    expect(plan.complete && plan.rehearsal && plan.situation == mode.Situation.tmds && !plan.tmds.hdmi && plan.runs == 7 && plan.writes == 34, "the rehearsal's plan")
    expect(!carry(false) && card.written == 0 && card.runs == 0, "the rehearsal, the setting off: nothing")
    expect(carry(true) && result.outcome == set.Outcome.done && result.runs == 7 && card.cleared == 0, "the rehearsal carried out, nothing cleared")
    // (Eight states, the pause, seven tables, the frames twice: 17.385 s.)
    line("gpu: the image asks for the firmware's own mode to be set again by the card's tables (settings/gpu): carrying out the plan's 7 table runs and 34 writes; the screen is dark meanwhile, 18 s at most (and 18 s more at most if the firmware's state has to be put back)\n")
    expect(result.longest == 17385000000 && result.longestBack == 17385000000, "the longest the rehearsal could take")
    line("gpu: controller 0 runs the firmware's own mode again, set by the card's tables, 59.9")
    line(" frames a second: the picture is where it was (7 table runs, 34 writes, each read back)\n")
    // The picture's words were never written, the timing and the
    // surface are the firmware's, the output is on in DVI mode.
    {
        var surface = false
        var k: usize = 0
        while k < card.written {
            if card.writtenTo[k] >= 0x1A00 && card.writtenTo[k] <= 0x1A12 { surface = true }
            if card.writtenTo[k] == 0x1B5D || card.writtenTo[k] == 0x1B30 { surface = true }
            k += 1
        }
        expect(!surface, "the rehearsal writes nothing of the picture")
        expect(card.raw(0x1B32) == 0x00010100 && card.marks[0] == 0xFFFFFFFF && card.marks[3] == 0xFFFFFFFF, "the rehearsal: all four mark sets, the choice as it was")
        expect(card.raw(0x1B80) == 1799 && card.raw(0x1B81) == ((424 << 16) | 1704) && card.raw(0x4E47) == 0x10021000 && card.raw(0x4E48) & 1 == 1 && card.raw(0x321) == 0x12 && card.pll[4] == 107960, "the firmware's timing, mode and buffers again")
    }
    // The rehearsal on a card whose firmware has given the rows no
    // buffers: none are given back and none asked for on the way there
    // (six states waited for), while the way back asks for them to be
    // given back whatever there is (seven): the two times are each said
    // by their own steps.
    card.reset()
    if show { say("-- the rehearsal, no buffers\n") }
    card.firmware(0, 4, 4, false, 2, 107962)
    card.store(0x321, 0x10)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.rehearsal)
    }
    expect(plan.complete && carry(true) && result.outcome == set.Outcome.done, "the rehearsal without buffers: carried out")
    expect(result.longest == 17185000000 && result.longestBack == 17285000000, "the longest there and back, each by its own steps")
    line("the screen is dark meanwhile, 18 s at most (and 18 s more at most if the firmware's state has to be put back)\n")
    // And the rehearsal failing: the same way back.
    card.reset()
    card.firmware(0, 4, 4, false, 2, 107962)
    {
        const monitor = wide()
        const offer = hdmiMonitor()
        make(&monitor, &offer, mode.Wish.rehearsal)
    }
    card.refuseRun = 6
    mustComeBack("the rehearsal's last table is stopped", set.Reason.table)
    wholeWayBack("after the rehearsal failed", 6)

    // An output that sends HDMI already (and audio samples), on a
    // monitor that names 300 MHz as its highest clock: muted and its
    // packets stopped first, the transmitter told HDMI when it is turned
    // off, and on the way back the packets' words as the firmware had
    // them and the front end put on the back end before the transmitter.
    card.reset()
    card.firmware(0, 4, 4, true, 2, 107962)
    card.store(0x4E09, 0x00000011)
    card.store(0x4E0D, 0x00000031)
    card.store(0x4E0E, 0x00000003)
    card.store(0x4E0F, 0x00000002)
    card.store(0x4E1E, 0x12345678)
    card.store(0x4E21, 0x02000000)
    card.store(0x4E7E, 0x00000001)
    card.store(0x4E42, 0x00000001)
    card.store(0x1BED, 0x00000011)
    {
        const monitor = wide()
        var offer = hdmiMonitor()
        offer.limit = 300000
        make(&monitor, &offer, mode.Wish.own)
    }
    line("gpu: plan (b, TMDS): HDMI signalling at 266640 kHz (now HDMI at 107960 kHz), ")
    line("gpu: firmware scratch 2 is 0x20010005, 6 is 0x10; front end 4's HDMI control is 0x11, it sends audio samples\n")
    line("gpu: would set 4e13 & 00000001 = 00000001 (the HDMI output muted)\n")
    line("gpu: would set 4e42 & 00000001 = 00000000 (no audio samples sent)\n")
    line("gpu: would run UNIPHYTransmitterControl with 04 00 03 00 00 00 00 00 02 00 0c 00 00 00 00 00, only when 4e48 & 00000001 = 00000001 (the transmitter off)\n")
    line("gpu: on the way back would run SetPixelClock with 30 79 10 00 18 21 03 00 00 00 00 00 00 00 00 00 (the pixel clock's PLL set for the firmware's clock)\n")
    line("gpu: on the way back would run DIGxEncoderControl with 04 0f 03 04 2c 2a 00 00 02 00 00 00 (the front end told the firmware's stream)\n")
    expect(plan.complete && plan.tmds.hdmiNow && plan.tmds.hdmi && plan.tmds.audio && plan.writes == 91, "an HDMI output's plan: five writes more")
    // (A word of the info frame is written by someone after the plan was
    // made: what the way back gives a register is what it held when the
    // change began, read then, not what the plan saw.)
    card.store(0x4E20, 0x00000777)
    remember()
    card.freezeRegister = 0x1B5D
    card.freezeValue = 0x0F000438
    mustComeBack("an HDMI output's change, the frames stand", set.Reason.frames)
    // Down: AVMUTE, the audio samples off, the generic packets, the
    // packets' control, then the front end's bit.
    expect(card.writtenTo[10] == 0x4E13 && card.writtenWith[10] == 1 && card.writtenTo[11] == 0x4E10 && card.writtenTo[12] == 0x4E2D && card.writtenTo[13] == 0x4E09 && card.writtenWith[13] == 0x11 && card.writtenTo[14] == 0x4E42 && card.writtenWith[14] == 0 && card.writtenTo[15] == 0x4E47 && card.writtenWith[15] == 0x10030000, "an HDMI output taken down")
    expect(card.raw(0x4E1E) == 0x12345678 && card.raw(0x4E42) == 1 && card.raw(0x4E13) == 0 && card.raw(0x1BED) == 0x11, "the firmware's info frame, audio and expansion again")
    {
        // The last table of the way back is the transmitter's, turned on
        // (its block's four words, then its number), and the write
        // before it puts the front end on the back end: an HDMI output's
        // order.
        var last = card.written
        var planned = false
        var k: usize = 0
        while k < card.written {
            if card.writtenTo[k] == 0x7F10 && card.writtenWith[k] == 76 { last = k }
            if card.writtenTo[k] == 0x4E20 && card.writtenWith[k] == 0 { planned = true }
            k += 1
        }
        expect(last >= 5 && last < card.written && card.writtenTo[last - 4] == 0x7F00 && card.writtenWith[last - 4] & 0xFF00 == 0x0100 && card.writtenTo[last - 5] == 0x4E47 && card.writtenWith[last - 5] & 0x1000 == 0x1000, "on the way back the front end is on the back end before the transmitter")
        expect(!planned && card.raw(0x4E20) == 0x777, "a word changed after the plan was made: as it was when the change began")
    }

    // An output that sends HDMI to a monitor whose EDID has no HDMI
    // block, and a timing a DVI link carries: DVI signalling is planned
    // (as Linux would send). The way there never writes the info frame's
    // words; the way back writes them, with what they held when the
    // change began.
    card.reset()
    if show { say("-- an HDMI output, a monitor without the HDMI block\n") }
    card.firmware(0, 4, 4, true, 2, 107962)
    card.store(0x4E09, 0x00000011)
    card.store(0x4E0D, 0x00000031)
    card.store(0x4E0E, 0x00000003)
    card.store(0x4E0F, 0x00000002)
    card.store(0x4E1E, 0x12345678)
    card.store(0x4E21, 0x02000000)
    card.store(0x4E7E, 0x00000001)
    {
        var monitor = wide()
        monitor.timing.clock = 148500
        const offer = edid.nothing()
        make(&monitor, &offer, mode.Wish.own)
    }
    line("gpu: plan (b, TMDS): DVI signalling at 148500 kHz (now HDMI at 107960 kHz), ")
    expect(plan.complete && plan.tmds.hdmiNow && !plan.tmds.hdmi, "an HDMI output, no HDMI block: DVI planned")
    card.freezeRegister = 0x1B5D
    card.freezeValue = 0x0F000438
    mustComeBack("an HDMI output to DVI, the frames stand", set.Reason.frames)
    expect(card.raw(0x4E1E) == 0x12345678 && card.raw(0x4E21) == 0x02000000 && card.raw(0x4E0E) == 3 && card.raw(0x4E0F) == 2 && card.raw(0x4E0D) == 0x31 && card.raw(0x4E7E) == 1 && card.raw(0x4E09) == 0x11, "the info frame and the packets as the firmware had them")
    expect(card.raw(0x4E47) & 0x71000 == 0x31000, "the back end in HDMI mode again, the front end on it")

    // Nothing is tied to one place: controller 2's picture leaves by
    // front end 1 on back end 3 (UNIPHY D, the PHY's PLL 23, its word
    // 0x103; the ROM's DVI-D connector, its pin 6 on hot plug line 6),
    // and the monitor's own timing fits a DVI link (1920x1200 at 154000
    // kHz: 2080 by 1235, porches 48 and 3, pulses 32 high and 6 low): DVI
    // signalling.
    card.reset()
    card.firmware(2, 1, 3, false, 6, 108000)
    card.store(0x18C0, 2)
    card.store(0x1FED, 0x11)
    {
        var monitor = wide()
        monitor.width = 1920
        monitor.height = 1200
        monitor.timing = edid.Timing.{ .clock = 154000, .width = 1920, .hTotal = 2080, .hFront = 48, .hSync = 32, .hPositive = true, .height = 1200, .vTotal = 1235, .vFront = 3, .vSync = 6, .vPositive = false, .interlaced = false, .stereo = false }
        const offer = edid.nothing()
        make(&monitor, &offer, mode.Wish.own)
    }
    line("gpu: controller 2 goes out by DIG 3 (front end 1): TMDS (DVI)\n")
    line("gpu: DIG 3 is UNIPHY D; the ROM puts a connector of the kind \"DVI-D (dual link)\" behind it, hot plug line 6 (the back end's own word names line 6; the line says a monitor is there)\n")
    line("gpu: plan (b, TMDS): DVI signalling at 154000 kHz (now DVI at 108000 kHz), ")
    line("gpu: this output carries 165000 kHz at most (DVI signalling on one link)\n")
    line("gpu: would run UNIPHYTransmitterControl with 03 00 02 00 00 00 00 00 06 00 04 00 00 00 00 00, only when 4d48 & 00000001 = 00000001 (the transmitter off)\n")
    line("gpu: would run EnableCRTC with 02 00 00 00 (the controller stopped)\n")
    line("gpu: would run SetPixelClock with a0 7f 17 00 17 20 02 00 02 00 00 00 00 00 00 00 (the pixel clock's PLL set)\n")
    line("gpu: would look for 014b & 00000017 = 00000003 (it is this back end's PLL's)\n")
    line("gpu: would set 0103 & 00000230 = 00000000 (the PLL's clock neither for deep colour nor doubled)\n")
    line("gpu: would run SetCRTC_UsingDTDTiming with 80 07 a0 00 b0 04 23 00 30 00 20 00 03 00 06 00 04 00 00 00 02 00 00 00 (the timing set)\n")
    line("gpu: would run DIGxEncoderControl with 01 0f 02 04 28 3c 00 00 00 00 00 00 (the front end told the stream)\n")
    line("gpu: would run UNIPHYTransmitterControl with 03 01 02 04 28 3c 00 00 06 00 04 00 00 00 00 00 (the transmitter on)\n")
    line("gpu: would set 4b00 & 00000007 = 00000002 (the front end takes the controller)\n")
    line("gpu: would set 4d47 & 00000200 = 00000000 (the front end taken off the back end)\n")
    line("gpu: would set 0323 & 00000007 = 00000000 (the buffers the rows are read through given back)\n")
    // (DVI signalling: the formatter does not expand to twelve bits. The
    // firmware is taken to have left it expanding here, to see it cleared.)
    line("gpu: would set 1fed & 00000011 = 00000000 (the formatter's expansion to twelve bits, for HDMI alone)\n")
    noLine("the AVI info frame")
    expect(plan.complete && plan.controller == 2 && !plan.tmds.hdmi && plan.tmds.limit == 165000 && plan.runs == 7 && plan.writes == 59, "another place: DVI, no packet word written")
    expect(carry(true) && result.outcome == set.Outcome.done && card.pll[3] == 154000 && card.raw(0x1F80) == 2079 && card.raw(0x4D47) & 0x70000 == 0x20000, "another place: carried out")
    expect(card.raw(0x1FED) & 0x11 == 0, "another place: the formatter's expansion off for DVI")
    line("gpu: controller 2 shows a picture of 1920x1200 as it is, 59.9")

    // A transmitter's table that writes the mode it was told into the
    // back end's word and takes every front end off it: the word is
    // said, and both are written again after the table.
    again("a transmitter's table that rewrites the back end's word")
    card.transmitterRewrites = true
    expect(carry(true) && result.outcome == set.Outcome.done, "a table that rewrites the back end's word: done")
    line("gpu: 4e47 reads 10030000 (what the transmitter's table left in the back end's word)\n")
    expect(card.raw(0x4E47) == 0x10031000, "the mode and the front end written again")

    // A PLL that takes a clock, but one three hundredths below the one
    // asked for (258640 kHz: 58.2 frames a second): the frames counted
    // with the transmitter off say so, a fiftieth being the most they
    // may differ, and nothing is sent. One hundredth below is within
    // that, and the mode is set.
    again("the PLL three hundredths short")
    card.clockShort = 30
    mustComeBack("a PLL three hundredths short", set.Reason.clock)
    line("gpu: controller 0 counts 58.")
    line(" frames a second with the output still off: the PLL gives 2586")
    wholeWayBack("after a PLL that was short", 6)
    again("the PLL one hundredth short")
    card.clockShort = 10
    expect(carry(true) && result.outcome == set.Outcome.done && card.pll[4] == 263973, "a PLL one hundredth short: within a fiftieth")

    // A transmitter's table that runs to its end and never turns the back
    // end on: the change ends at the state that does not come. On the way
    // back the table is as deaf, and at its end the output is off. The
    // way back goes on there (a check of ours may be wrong about a table
    // that did its work), but it does not say that the firmware's state
    // is back: the registers the driver wrote are the firmware's again,
    // one thing it looked for was not there, and the log names it.
    again("a transmitter that never comes on")
    card.transmitterDeaf = true
    {
        const done = carry(true)
        expect(!done && result.reason == set.Reason.wait && result.outcome == set.Outcome.unsure && result.doubts == 1 && result.astray == 0, "a transmitter that never comes on: not said to be back")
        expect(card.raw(0x4E48) & 1 == 0, "the output is in fact off")
        line("gpu: 4e48 & 00000001 is not 00000001 after 100 ms (until the transmitter is on): it reads 00000100\n")
        line("gpu: on the way back, not as it should be (the way goes on): wait for 4e48 & 00000001 = 00000001 (until the transmitter is on)\n")
        line("gpu: the firmware's state is NOT known to be back: the registers this driver wrote have the firmware's values again (75 writes, 6 table runs told the firmware's 1280x960 at 107960 kHz: the PLL's and the transmitter's own settings are the tables' for that, they cannot be read), but 1 thing on the way back was not as it should be (said in the log); the controller counts frames (59.9")
        noLine("gpu: the firmware's state is back (")
    }

    // The pixel clock's table puts the controller on another PLL: found
    // by the look at its two clock words. On the way back the table does
    // the same, the controller counts no frames at the end, and nothing
    // says that the firmware's state is back.
    again("the controller put on another PLL")
    card.wrongSource = true
    {
        const done = carry(true)
        expect(!done && result.reason == set.Reason.wait && result.outcome == set.Outcome.unsure && result.doubts == 1, "a controller on another PLL: not said to be back")
        line("gpu: 0143 & 00000017 is not 00000004 (it is this back end's PLL's): it reads 00000005\n")
        line("failed (a state did not come): look for 0143 & 00000017 = 00000004 (it is this back end's PLL's), read 00000005\n")
        line("gpu: the firmware's state is NOT known to be back: ")
        line("), but 1 thing on the way back was not as it should be (said in the log); the controller counts no frames\n")
        noLine("gpu: the firmware's state is back (")
    }

    // Everything the way back looked for was there, but the controller
    // counts no frames at its end (they stand here while the surface is
    // on, whatever is done): that alone keeps it from saying that the
    // firmware's state is back.
    again("the frames stand whatever is done")
    card.freezeRegister = 0x1A00
    card.freezeValue = 1
    {
        const done = carry(true)
        expect(!done && result.reason == set.Reason.clock && result.outcome == set.Outcome.unsure && result.doubts == 0 && result.astray == 0 && asBefore(), "no frames at the end: not said to be back")
        line("gpu: the firmware's state is NOT known to be back: the registers this driver wrote have the firmware's values again (")
        line(" they cannot be read); the controller counts no frames\n")
        noLine("gpu: the firmware's state is back (")
        noLine("), but ")
    }

    // A register of the plan's that takes no write after its first (the
    // viewport's size): on the way back it keeps the plan's value. Every
    // other register is the firmware's again; this one is said, and so is
    // that the firmware's state is not all back.
    again("a register that does not take the firmware's value again")
    card.deafRegister = 0x1B5D
    card.deafAfter = 1
    card.dryAfter = 0x1B5D
    {
        const done = carry(true)
        expect(!done && result.reason == set.Reason.underflow && result.outcome == set.Outcome.astray && result.astray == 1, "a register that stays: not all back")
        expect(card.raw(0x1B5D) == 0x0F000438 && card.raw(0x1A0D) == 0x500 && card.raw(0x4E48) & 1 == 1, "the viewport's size stays the plan's, the rest is the firmware's")
        line("gpu: 1b5d holds 0f000438, the firmware had 050003c0\n")
        line("gpu: the firmware's state is NOT all back: 1 register differs; the controller counts frames (")
        noLine("gpu: the firmware's state is back (")
        noLine("NOT known to be back")
    }

    if failed != 0 { return failed }
    return 13
}
