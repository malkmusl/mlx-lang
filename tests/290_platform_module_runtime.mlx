// std.X is X.<platform>.mlx for the target when the standard library has
// one: std.platform is platform.linux.mlx here (x86_64-linux). Exits 13.
const platform = @import("std.platform")
const std = @import("std")

pub fn main(arguments: [][*]const u8) -> u8 {
    if platform.ANDROID { return 1 }
    if !std.text.same(platform.NAME, "linux") { return 2 }
    return 13
}
