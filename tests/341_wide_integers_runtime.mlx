// Integers wider than a word (u128, i128, u100) at run time: two words
// carried through locals, parameters, results, struct fields, arrays and
// pointers, with the arithmetic expanded in the lowering
// (compiler/selfhost/ir/lowering/wide.mlx): carries, the high half of a
// product, shifts across the words, division, comparisons, the
// conversions to and from a word. Exits 13 when every check holds, else
// the number of the first check that failed.
const std = @import("std")

const Pair = struct {
    tag: u64
    value: u128
}

fn add(a: u128, b: u128) -> u128 { return a + b }
fn sub(a: u128, b: u128) -> u128 { return a - b }
fn mul(a: u128, b: u128) -> u128 { return a * b }
fn div(a: u128, b: u128) -> u128 { return a / b }
fn rem(a: u128, b: u128) -> u128 { return a % b }
fn shl(a: u128, n: u7) -> u128 { return a << n }
fn shr(a: u128, n: u7) -> u128 { return a >> n }
fn sdiv(a: i128, b: i128) -> i128 { return a / b }
fn srem(a: i128, b: i128) -> i128 { return a % b }
fn sshr(a: i128, n: u7) -> i128 { return a >> n }
fn neg(a: i128) -> i128 { return -a }
fn lowWord(a: u128) -> u64 { return @intCast(u64, a) }
fn highWord(a: u128) -> u64 { return @intCast(u64, a >> 64) }
fn fromWord(w: u64) -> u128 { return @intCast(u128, w) }
fn fromSigned(w: i64) -> i128 { return @intCast(i128, w) }
fn less(a: u128, b: u128) -> bool { return a < b }
fn signedLess(a: i128, b: i128) -> bool { return a < b }
fn same(a: u128, b: u128) -> bool { return a == b }
fn wrap100(a: u100, b: u100) -> u100 { return a + b }
fn twice(p: *u128) -> void { p.* = p.* * 2 }
fn pairValue(p: Pair) -> u128 { return p.value }
fn sum(values: []const u128) -> u128 {
    var total: u128 = 0
    for v in values { total += v }
    return total
}

pub fn main() -> u8 {
    const word_max: u64 = 18446744073709551615
    const two64 = add(fromWord(word_max), 1)
    if highWord(two64) != 1 || lowWord(two64) != 0 { return 1 }
    // Carries and borrows across the words.
    const back = sub(two64, 1)
    if highWord(back) != 0 || lowWord(back) != word_max { return 2 }
    // The high half of a product: 0xfedcba9876543210 * 0x0123456789abcdef.
    const product = mul(fromWord(18364758544493064720), fromWord(81985529216486895))
    if highWord(product) != 0x121fa00ad77d742 || lowWord(product) != 0x2236d88fe5618cf0 { return 3 }
    // Division and remainder of a value above 2^64.
    const big = add(shl(fromWord(0xfedcba9876543210), 64), fromWord(0xfedcba9876543210))
    const divisor = fromWord(0x0123456789abcdef)
    const quotient = div(big, divisor)
    if highWord(quotient) != 0xe0 || lowWord(quotient) != 0xd3d0 { return 4 }
    const remainder = rem(big, divisor)
    if highWord(remainder) != 0 || lowWord(remainder) != 0xe2e0 { return 5 }
    if lowWord(rem(big, 7)) != 6 || lowWord(div(big, two64)) != 0xfedcba9876543210 { return 6 }
    // Shifts across the words.
    if highWord(shl(fromWord(1), 100)) != 68719476736 || lowWord(shl(fromWord(1), 100)) != 0 { return 7 }
    if lowWord(shr(big, 100)) != 0x0fedcba9 || highWord(shr(big, 100)) != 0 { return 8 }
    if lowWord(shl(big, 0)) != 0xfedcba9876543210 || highWord(shr(big, 0)) != 0xfedcba9876543210 { return 9 }
    if highWord(shl(big, 33)) != 0xeca86421fdb97530 || lowWord(shl(big, 33)) != 0xeca8642000000000 { return 10 }
    // Comparisons: the high words decide, the low ones at a tie.
    if !less(1, two64) || less(two64, 1) || !less(back, two64) || less(two64, two64) { return 11 }
    if !same(two64, add(back, 1)) || same(two64, back) || two64 != add(back, 1) || two64 <= back { return 12 }
    if !(two64 > back) || !(two64 >= two64) || back >= two64 { return 14 }
    // Signed values: negation, sign-extension, division toward zero.
    const minus_five = fromSigned(-5)
    if !signedLess(minus_five, 3) || signedLess(3, minus_five) || !(minus_five < 0) { return 16 }
    const negated = neg(minus_five)
    if lowWord(@intCast(u128, negated)) != 5 || highWord(@intCast(u128, negated)) != 0 { return 17 }
    const huge_negative = neg(@intCast(i128, big))
    if highWord(@intCast(u128, huge_negative)) != 0x0123456789abcdef || lowWord(@intCast(u128, huge_negative)) != 0x0123456789abcdf0 { return 18 }
    if @intCast(i64, sdiv(fromSigned(-1000000), 7)) != -142857 || @intCast(i64, sdiv(huge_negative, huge_negative)) != 1 { return 19 }
    // huge_negative is positive as an i128 (big's top bit is set): the
    // quotient by -16 is negative, truncated toward zero.
    const q = sdiv(huge_negative, fromSigned(-16))
    if highWord(@intCast(u128, q)) != 0xffedcba987654321 || lowWord(@intCast(u128, q)) != 0x0fedcba987654321 { return 20 }
    if @intCast(i64, srem(fromSigned(-17), 5)) != -2 || @intCast(i64, srem(17, fromSigned(-5))) != 2 { return 21 }
    if @intCast(i64, sshr(huge_negative, 100)) != 0x0123456 || @intCast(i64, sshr(@intCast(i128, big), 100)) != -1193047 { return 22 }
    if @intCast(i64, sshr(fromSigned(-1), 127)) != -1 || @intCast(i64, sshr(fromSigned(-1), 64)) != -1 { return 23 }
    if @intCast(i64, fromSigned(-1)) != -1 || @intCast(i32, fromSigned(-70000)) != -70000 || @intCast(u8, add(two64, 300)) != 44 { return 24 }
    // Bitwise operators and the complement.
    const masked = big & shl(fromWord(0xffff), 64)
    if highWord(masked) != 0x3210 || lowWord(masked) != 0 { return 25 }
    if highWord(big | 0xff) != 0xfedcba9876543210 || lowWord(big ^ big) != 0 || highWord(~big) != 0x0123456789abcdef { return 26 }
    if !(~big != big) || (!same(big, big)) { return 27 }
    // A narrower wide type wraps at its width.
    const top: u100 = ~@intCast(u100, 0)
    if lowWord(@intCast(u128, wrap100(top, 1))) != 0 || highWord(@intCast(u128, wrap100(top, 1))) != 0 { return 28 }
    if highWord(@intCast(u128, wrap100(top, 2))) != 0 || lowWord(@intCast(u128, wrap100(top, 2))) != 1 { return 29 }
    // Compound assignment, a pointer, a struct field, an array and a slice.
    var counter: u128 = fromWord(word_max)
    counter += 1
    counter *= 3
    counter -= 1
    counter <<= 1
    counter |= 1
    counter >>= 1
    if highWord(counter) != 2 || lowWord(counter) != word_max { return 30 }
    twice(&counter)
    if highWord(counter) != 5 || lowWord(counter) != word_max - 1 { return 31 }
    const pair = Pair.{ .tag = 7, .value = two64 + 9 }
    if pairValue(pair) != two64 + 9 || highWord(pair.value) != 1 || lowWord(pair.value) != 9 { return 32 }
    var table: [3]u128 = [3]u128{ two64, two64 * 2, 5 }
    table[2] = table[0] + table[1]
    if highWord(table[2]) != 3 || lowWord(table[2]) != 0 { return 33 }
    if highWord(sum(table[0..3])) != 6 || lowWord(sum(table[0..3])) != 0 { return 34 }
    // A loop counted in a wide integer, and a condition on one.
    var count: u128 = 0
    var i: u128 = two64
    while i < two64 + 10 {
        count += i - two64
        i += 1
    }
    if lowWord(count) != 45 || highWord(count) != 0 { return 35 }
    if (if big > two64 { 1 } else { 0 }) != 1 { return 36 }
    return 13
}
