const page_allocator = @import("../std/bootstrap/page_allocator.mlx")
const lir = @import("../compiler/selfhost/ir/lir.mlx")
const optimize = @import("../compiler/selfhost/ir/optimize.mlx")

pub fn main() -> u8 {
    const allocator = page_allocator.init()
    var ir = lir.init(allocator)
    const left = lir.addInst(&ir, lir.constI(lir.NONE, 240))
    const right = lir.addInst(&ir, lir.constI(lir.NONE, 15))
    const folded = lir.addInst(&ir, lir.binary(lir.Opcode.bit_or, lir.NONE, left, right))
    const unused = lir.addInst(&ir, lir.constI(lir.NONE, 99))
    const returned = lir.addInst(&ir, lir.retInst(lir.NONE, folded))

    const result = optimize.run(&ir, allocator)
    if result.constantsFolded != 1 { return 1 }
    if result.eliminated != 3 { return 2 }
    if result.instructionsAfter != 2 { return 3 }
    const instruction = lir.getInst(&ir, folded)
    if instruction.opcode != lir.Opcode.const_i || instruction.arg0 != 255 { return 4 }
    if lir.getInst(&ir, unused).opcode != lir.Opcode.dead { return 5 }

    lir.deinit(&ir)
    return 13
}
