// mlx-profile: where a program spends its time. It starts the program
// under ptrace, stops it every few milliseconds, and notes where it is and
// the functions that called it (along the frame pointers every Mlx function
// keeps). The addresses are named from the symbol tables of the files they
// are in, as the compiler writes them (path:line:function), and C
// libraries by their own symbols.
//
//   mlx-profile [-o DIRECTORY] [--every MILLISECONDS] [--after MILLISECONDS] [--wall] [--thread NAME] PROGRAM [ARGUMENT...]
//
// Only samples where the program runs count (not where it waits in the
// kernel); --wall counts all. At the end it prints the functions the most
// time went to and writes the profile to DIRECTORY (default:
// $XDG_STATE_HOME/mlx/profiles, else ~/.local/state/mlx/profiles) as
// PROGRAM-SECONDS.profile (std.diagnostics), which MLX Observatory and
// `mlx-codemap hot` read:
//
//     profile <TAB> program <TAB> seconds since 1970 <TAB> samples <TAB> interval in µs <TAB> processor
//     self <TAB> total <TAB> function
//
// The program's GPU work is profiled too: MLX_GPU_PROFILE in its
// environment has std.gpu write PROGRAM-gpu-SECONDS.profile beside it. And
// MLX_FRAMES has its frames written as a timeline (std.diagnostics), the
// processor's and the GPU's time on each.
//
// The main thread is sampled, or with --thread the thread of that name
// (its /proc comm, as pthread_setname_np gave it: a compositor's, a
// worker's); the program's other threads run on.
const std = @import("std")
const crash = @import("std.crash")
const diagnostics = @import("std.diagnostics")

const PTRACE_CONT: usize = 7
const PTRACE_GETREGS: usize = 12
const PTRACE_SETOPTIONS: usize = 16896
const PTRACE_SEIZE: usize = 16902
const PTRACE_INTERRUPT: usize = 16903
const PTRACE_O_TRACEEXEC: usize = 16
const PTRACE_O_TRACEEXIT: usize = 64
const PTRACE_O_EXITKILL: usize = 1048576
const PTRACE_EVENT_EXEC: usize = 4
const PTRACE_EVENT_EXIT: usize = 6
const PTRACE_EVENT_STOP: usize = 128
// Clock ticks a second in /proc/PID/stat (USER_HZ).
const TICKS: usize = 100
const WALL: usize = 1073741824
// user_regs_struct: rbp is word 4, rip 16, rsp 19.
const REGISTER_WORDS: usize = 27

const MAX_FRAMES: usize = 64
const MAX_FUNCTIONS: usize = 65536
const FUNCTION_SLOTS: usize = 131072
const ADDRESS_SLOTS: usize = 262144
const MAX_FILES: usize = 64
const NAMES_SIZE: usize = 8388608
const MAPS_SIZE: usize = 1048576

// Everything the profiler keeps (big tables, allocated once).
const Profiler = struct {
    child: usize
    // --thread: the thread sampled (its id once found, else 0) and its name.
    thread: usize
    threadName: []const u8
    // The functions: their names (in names), samples in them and with what
    // they called; a hash of names to them.
    names: [*]u8
    namesUsed: usize
    nameStart: [*]u32
    nameLength: [*]u32
    selfSamples: [*]u32
    totalSamples: [*]u32
    marks: [*]u32
    count: usize
    slots: [*]u32
    // Addresses seen: address and its function (hash, open addressing).
    addressKeys: [*]u64
    addressValues: [*]u32
    // /proc/PID/maps, read again when an address is in no mapping known.
    maps: [*]u8
    mapsLength: usize
    // Files mapped in to be read (their path's hash, image, size).
    fileKeys: [64]u64
    fileImages: [64]usize
    fileSizes: [64]usize
    fileCount: usize
    // Each file's functions in address order (indexSymbols), made the first
    // time an address is named in it: where, how many, its names' strings.
    fileFunctions: [64]usize
    fileFunctionCounts: [64]usize
    fileStrings: [64]usize
    fileStringsSizes: [64]usize
    fileIndexed: [64]bool
    // The sample being taken.
    frames: [64]u64
    frameCount: usize
    samples: usize
    round: u32
    text: [*]u8
    // What the program took, read as its main thread ends: its memory at
    // most and at the end (KiB), its processor time in and out of the
    // kernel, every thread's (ticks); whether it was read.
    peakKiB: usize
    endKiB: usize
    userTicks: usize
    systemTicks: usize
    endNoted: bool
}

fn say(text: []const u8) -> void {
    _ = std.io.writeAll(std.io.stdout(), text)
}

fn sayError(text: []const u8) -> void {
    _ = std.io.writeAll(std.io.stderr(), text)
}

fn sayNumber(value: usize) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        say(digits[count..count + 1])
    }
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var at: usize = 0
    while at < first.length {
        if first[at] != second[at] { return false }
        at += 1
    }
    return true
}

fn hashBytes(bytes: [*]const u8, length: usize) -> u64 {
    var value: u64 = 14695981039346656037
    var at: usize = 0
    while at < length {
        value = (value ^ @intCast(u64, bytes[at])) *% 1099511628211
        at += 1
    }
    return value
}

fn allocate(size: usize) -> usize {
    return std.linux.mapAnonymous(size)
}

fn words(count: usize) -> [*]u32 {
    const result: [*]u32 = unsafe { @ptrFromInt([*]u32, allocate(count * 4 + 4)) }
    return result
}

fn bytesAt(address: usize) -> [*]const u8 {
    const result: [*]const u8 = unsafe { @ptrFromInt([*]const u8, address) }
    return result
}

fn read16(image: usize, at: usize) -> usize {
    const bytes = bytesAt(image + at)
    return @intCast(usize, bytes[0]) | (@intCast(usize, bytes[1]) << 8)
}

fn read32(image: usize, at: usize) -> usize { return read16(image, at) | (read16(image, at + 2) << 16) }

fn read64(image: usize, at: usize) -> usize { return read32(image, at) | (read32(image, at + 4) << 32) }

// ---------------------------------------------------------------------------
// Functions

// The function called `name` (made when new).
fn functionOf(profiler: *Profiler, name: [*]const u8, length: usize) -> u32 {
    const hash = hashBytes(name, length)
    var slot = hash % FUNCTION_SLOTS
    while true {
        const held = profiler.*.slots[slot]
        if held == 0 { break }
        const function = @intCast(usize, held - 1)
        const start = @intCast(usize, profiler.*.nameStart[function])
        if @intCast(usize, profiler.*.nameLength[function]) == length && same(profiler.*.names[start..start + length], name[0..length]) { return held - 1 }
        slot = (slot + 1) % FUNCTION_SLOTS
    }
    if profiler.*.count >= MAX_FUNCTIONS || profiler.*.namesUsed + length > NAMES_SIZE { return 4294967295 }
    const function = profiler.*.count
    profiler.*.count += 1
    profiler.*.nameStart[function] = @intCast(u32, profiler.*.namesUsed)
    profiler.*.nameLength[function] = @intCast(u32, length)
    var at: usize = 0
    while at < length {
        profiler.*.names[profiler.*.namesUsed] = name[at]
        profiler.*.namesUsed += 1
        at += 1
    }
    profiler.*.selfSamples[function] = 0
    profiler.*.totalSamples[function] = 0
    profiler.*.marks[function] = 0
    profiler.*.slots[slot] = @intCast(u32, function + 1)
    return @intCast(u32, function)
}

// ---------------------------------------------------------------------------
// Naming addresses

fn hexValue(byte: u8) -> usize { return @intCast(usize, std.text.hexValue(byte)) }

fn readMaps(profiler: *Profiler) -> void {
    var path: [64]u8 = undefined
    const bytes: [*]u8 = &path
    var length: usize = 0
    for byte in "/proc/" {
        bytes[length] = byte
        length += 1
    }
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = profiler.*.child
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest /= 10
        count += 1
    }
    while count > 0 {
        count -= 1
        bytes[length] = digits[count]
        length += 1
    }
    for byte in "/maps" {
        bytes[length] = byte
        length += 1
    }
    bytes[length] = 0
    profiler.*.mapsLength = 0
    const file = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(bytes), 0, 0)
    if file < 0 { return }
    while profiler.*.mapsLength + 4096 < MAPS_SIZE {
        const got = std.linux.syscall3(std.linux.SYS_read, @bitCast(usize, file), @intFromPtr(profiler.*.maps) + profiler.*.mapsLength, MAPS_SIZE - profiler.*.mapsLength)
        if got <= 0 { break }
        profiler.*.mapsLength += @bitCast(usize, got)
    }
    std.linux.close(file)
}

// Names `address` (a return address one byte back) into the profiler's
// text: path:line:function from the file's symbols, else file+0xOFFSET,
// else 0xADDRESS. Its length (0: in no mapping).
fn describe(profiler: *Profiler, address: usize) -> usize {
    const maps = profiler.*.maps
    const length = profiler.*.mapsLength
    var line: usize = 0
    while line < length {
        var at = line
        var start: usize = 0
        while at < length && hexValue(maps[at]) < 16 {
            start = start * 16 + hexValue(maps[at])
            at += 1
        }
        at += 1
        var end: usize = 0
        while at < length && hexValue(maps[at]) < 16 {
            end = end * 16 + hexValue(maps[at])
            at += 1
        }
        var line_end = at
        while line_end < length && maps[line_end] != 10 { line_end += 1 }
        if address >= start && address < end {
            at += 6
            var file_offset: usize = 0
            while at < line_end && hexValue(maps[at]) < 16 {
                file_offset = file_offset * 16 + hexValue(maps[at])
                at += 1
            }
            var fields: usize = 0
            while at < line_end && fields < 2 {
                while at < line_end && maps[at] == 32 { at += 1 }
                while at < line_end && maps[at] != 32 { at += 1 }
                fields += 1
            }
            while at < line_end && maps[at] == 32 { at += 1 }
            const in_file = address - start + file_offset
            if at < line_end && maps[at] == 47 {
                const named = nameInFile(profiler, at, line_end, in_file)
                if named > 0 { return named }
                // The file's name and the offset.
                var base = at
                var scan = at
                while scan < line_end {
                    if maps[scan] == 47 { base = scan + 1 }
                    scan += 1
                }
                var out: usize = 0
                while base < line_end && out < 200 {
                    profiler.*.text[out] = maps[base]
                    out += 1
                    base += 1
                }
                return out
            }
            return writeHex(profiler.*.text, 0, address)
        }
        line = line_end + 1
    }
    return 0
}

fn writeHex(into: [*]u8, at: usize, value: usize) -> usize {
    var length = at
    into[length] = 48
    into[length + 1] = 120
    length += 2
    var shift: usize = 60
    var started = false
    while true {
        const digit = (value >> shift) & 15
        if digit != 0 || started || shift == 0 {
            started = true
            into[length] = if digit < 10 { @intCast(u8, 48 + digit) } else { @intCast(u8, 87 + digit) }
            length += 1
        }
        if shift == 0 { break }
        shift -= 4
    }
    return length
}

// The image of the file at maps[from..to] (mapped in once).
fn imageOf(profiler: *Profiler, from: usize, to: usize, size: *usize) -> usize {
    var path: [4096]u8 = undefined
    const bytes: [*]u8 = &path
    var length: usize = 0
    while from + length < to && length < 4000 {
        bytes[length] = profiler.*.maps[from + length]
        length += 1
    }
    bytes[length] = 0
    const key = hashBytes(bytes, length)
    var file: usize = 0
    while file < profiler.*.fileCount {
        if profiler.*.fileKeys[file] == key {
            size.* = profiler.*.fileSizes[file]
            return profiler.*.fileImages[file]
        }
        file += 1
    }
    if profiler.*.fileCount >= MAX_FILES { return 0 }
    var image: usize = 0
    var image_size: usize = 0
    const handle = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(bytes), 0, 0)
    if handle >= 0 {
        const end = std.linux.syscall3(std.linux.SYS_lseek, @bitCast(usize, handle), 0, 2)
        if end > 64 {
            const mapped = std.linux.syscall6(std.linux.SYS_mmap, 0, @bitCast(usize, end), 1, 2, @bitCast(usize, handle), 0)
            if mapped >= 0 {
                image = @bitCast(usize, mapped)
                image_size = @bitCast(usize, end)
            }
        }
        std.linux.close(handle)
    }
    profiler.*.fileKeys[profiler.*.fileCount] = key
    profiler.*.fileImages[profiler.*.fileCount] = image
    profiler.*.fileSizes[profiler.*.fileCount] = image_size
    profiler.*.fileCount += 1
    size.* = image_size
    return image
}

fn nameInFile(profiler: *Profiler, from: usize, to: usize, in_file: usize) -> usize {
    var size: usize = 0
    const image = imageOf(profiler, from, to, &size)
    if image == 0 || size < 64 { return 0 }
    const magic = bytesAt(image)
    if magic[0] != 127 || magic[1] != 69 || magic[2] != 76 || magic[3] != 70 || magic[4] != 2 { return 0 }
    const program_offset = read64(image, 32)
    const program_count = read16(image, 56)
    if program_offset + program_count * 56 > size { return 0 }
    var address: usize = 0
    var placed = false
    var index: usize = 0
    while index < program_count {
        const header = program_offset + index * 56
        const segment_offset = read64(image, header + 8)
        if read32(image, header) == 1 && in_file >= segment_offset && in_file < segment_offset + read64(image, header + 32) {
            address = in_file - segment_offset + read64(image, header + 16)
            placed = true
            break
        }
        index += 1
    }
    if !placed { return 0 }
    var file: usize = 0
    while file < profiler.*.fileCount && profiler.*.fileImages[file] != image { file += 1 }
    if file == profiler.*.fileCount { return 0 }
    if !profiler.*.fileIndexed[file] { indexFile(profiler, file, image, size) }
    return nameInIndex(profiler, file, image, address)
}

// The functions of the file (its symbol table's, else its dynamic one's),
// indexed once.
fn indexFile(profiler: *Profiler, file: usize, image: usize, size: usize) -> void {
    profiler.*.fileIndexed[file] = true
    profiler.*.fileFunctionCounts[file] = 0
    const section_offset = read64(image, 40)
    const section_count = read16(image, 60)
    if section_offset + section_count * 64 > size { return }
    var kind: usize = 2
    while kind != 0 {
        var index: usize = 0
        while index < section_count {
            const header = section_offset + index * 64
            if read32(image, header + 4) == kind {
                const strings_header = section_offset + read32(image, header + 40) * 64
                const symbols = read64(image, header + 24)
                const symbols_size = read64(image, header + 32)
                const strings = read64(image, strings_header + 24)
                const strings_size = read64(image, strings_header + 32)
                if symbols + symbols_size <= size && strings + strings_size <= size {
                    var count: usize = 0
                    const functions = indexSymbols(image, symbols, symbols_size, &count)
                    if count > 0 {
                        profiler.*.fileFunctions[file] = @intFromPtr(functions)
                        profiler.*.fileFunctionCounts[file] = count
                        profiler.*.fileStrings[file] = strings
                        profiler.*.fileStringsSizes[file] = strings_size
                        return
                    }
                }
            }
            index += 1
        }
        kind = if kind == 2 { 11 } else { 0 }
    }
}

// A symbol table's functions in address order, three words each (address,
// size, name), and how many: an address is then named by a binary search,
// not a walk through every symbol (a program of a few hundred thousand
// functions, as a WebKit one, takes seconds an address that way).
fn indexSymbols(image: usize, symbols: usize, symbols_size: usize, count: *usize) -> [*]usize {
    var functions: usize = 0
    var at = symbols
    while at + 24 <= symbols + symbols_size {
        if bytesAt(image + at + 4)[0] & 15 == 2 && read64(image, at + 8) != 0 { functions += 1 }
        at += 24
    }
    const entries: [*]usize = unsafe { @ptrFromInt([*]usize, allocate(functions * 24 + 24)) }
    var n: usize = 0
    at = symbols
    while at + 24 <= symbols + symbols_size {
        if bytesAt(image + at + 4)[0] & 15 == 2 && read64(image, at + 8) != 0 {
            entries[n * 3] = read64(image, at + 8)
            entries[n * 3 + 1] = read64(image, at + 16)
            entries[n * 3 + 2] = read32(image, at)
            n += 1
        }
        at += 24
    }
    // Heap sort by address.
    var start = n / 2
    while start > 0 {
        start -= 1
        siftDown(entries, start, n)
    }
    var end = n
    while end > 1 {
        end -= 1
        swapEntries(entries, 0, end)
        siftDown(entries, 0, end)
    }
    count.* = n
    return entries
}

fn swapEntries(entries: [*]usize, first: usize, second: usize) -> void {
    var word: usize = 0
    while word < 3 {
        const kept = entries[first * 3 + word]
        entries[first * 3 + word] = entries[second * 3 + word]
        entries[second * 3 + word] = kept
        word += 1
    }
}

fn siftDown(entries: [*]usize, start: usize, end: usize) -> void {
    var root = start
    while root * 2 + 1 < end {
        var child = root * 2 + 1
        if child + 1 < end && entries[(child + 1) * 3] > entries[child * 3] { child += 1 }
        if entries[root * 3] >= entries[child * 3] { return }
        swapEntries(entries, root, child)
        root = child
    }
}

// The function of the file's index that holds `address` (the nearest at or
// below it whose extent holds it, or of no extent), into the profiler's
// text; its name's length (0: none).
fn nameInIndex(profiler: *Profiler, file: usize, image: usize, address: usize) -> usize {
    const entries: [*]usize = unsafe { @ptrFromInt([*]usize, profiler.*.fileFunctions[file]) }
    const strings = profiler.*.fileStrings[file]
    const strings_size = profiler.*.fileStringsSizes[file]
    var low: usize = 0
    var high = profiler.*.fileFunctionCounts[file]
    while low < high {
        const middle = (low + high) / 2
        if entries[middle * 3] <= address { low = middle + 1 } else { high = middle }
    }
    var tries: usize = 0
    while low > 0 && tries < 64 {
        low -= 1
        tries += 1
        const value = entries[low * 3]
        const extent = entries[low * 3 + 1]
        if address < value + extent || extent == 0 {
            const name_at = entries[low * 3 + 2]
            if name_at >= strings_size { return 0 }
            const name = bytesAt(image + strings + name_at)
            var length: usize = 0
            while name_at + length < strings_size && name[length] != 0 && length < 4000 {
                profiler.*.text[length] = name[length]
                length += 1
            }
            return length
        }
    }
    return 0
}

// The function `address` is in (NONE-like 4294967295: unknown), named
// once per address.
fn functionAt(profiler: *Profiler, address: usize) -> u32 {
    const key = address
    var slot = ((key *% 11400714819323198485) >> 46) % ADDRESS_SLOTS
    while true {
        if profiler.*.addressKeys[slot] == 0 { break }
        if profiler.*.addressKeys[slot] == key { return profiler.*.addressValues[slot] }
        slot = (slot + 1) % ADDRESS_SLOTS
    }
    var length = describe(profiler, address)
    if length == 0 {
        // A mapping made since maps was read (a library loaded).
        readMaps(profiler)
        length = describe(profiler, address)
    }
    if length == 0 { length = writeHex(profiler.*.text, 0, address) }
    const text: [*]const u8 = unsafe { @ptrCast([*]const u8, profiler.*.text) }
    const function = functionOf(profiler, text, length)
    profiler.*.addressKeys[slot] = key
    profiler.*.addressValues[slot] = function
    return function
}

// ---------------------------------------------------------------------------
// Sampling

fn readWords(profiler: *Profiler, address: usize, into: [*]u64, count: usize) -> bool {
    var local: [2]usize = [2]usize{ @intFromPtr(into), count * 8 }
    var remote: [2]usize = [2]usize{ address, count * 8 }
    const got = std.linux.syscall6(std.linux.SYS_process_vm_readv, profiler.*.child, @intFromPtr(&local), 1, @intFromPtr(&remote), 1, 0)
    return got == @intCast(isize, count * 8)
}

// Where the stopped program is: rip, then the return addresses along
// rbp (one byte back, into the call), of the main thread or --thread's;
// false when its registers cannot be read.
fn capture(profiler: *Profiler) -> bool {
    var registers: [27]u64 = undefined
    const target = if profiler.*.thread != 0 { profiler.*.thread } else { profiler.*.child }
    const got = std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_GETREGS, target, 0, @intFromPtr(&registers))
    if got != 0 { return false }
    profiler.*.frameCount = 0
    profiler.*.frames[0] = registers[16]
    profiler.*.frameCount = 1
    var frame = registers[4]
    const stack = registers[19]
    var pair: [2]u64 = [2]u64{ 0, 0 }
    const pair_words: [*]u64 = &pair
    while profiler.*.frameCount < MAX_FRAMES && frame >= stack && frame < stack + 67108864 && frame & 7 == 0 {
        if !readWords(profiler, frame, pair_words, 2) { break }
        if pair[1] < 4096 { break }
        profiler.*.frames[profiler.*.frameCount] = pair[1] - 1
        profiler.*.frameCount += 1
        if pair[0] <= frame { break }
        frame = pair[0]
    }
    return true
}

// The frames captured, counted for their functions (named from the
// symbol tables the first time an address is seen, which can take long:
// the program runs on meanwhile).
fn countFrames(profiler: *Profiler) -> void {
    // Self: the first; total: every function once.
    profiler.*.round += 1
    var at: usize = 0
    while at < profiler.*.frameCount {
        const function = functionAt(profiler, profiler.*.frames[at])
        if function != 4294967295 {
            if at == 0 { profiler.*.selfSamples[function] += 1 }
            if profiler.*.marks[function] != profiler.*.round {
                profiler.*.marks[function] = profiler.*.round
                profiler.*.totalSamples[function] += 1
            }
        }
        at += 1
    }
    profiler.*.samples += 1
}

// Whether the program is running (R in /proc/PID/stat), not waiting.
// /proc/PID/`file` of the program into `into` (NUL-ended); its length.
fn procPath(profiler: *Profiler, file: []const u8, into: [*]u8) -> usize {
    var length: usize = 0
    for byte in "/proc/" {
        into[length] = byte
        length += 1
    }
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = profiler.*.child
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest /= 10
        count += 1
    }
    while count > 0 {
        count -= 1
        into[length] = digits[count]
        length += 1
    }
    for byte in file {
        into[length] = byte
        length += 1
    }
    into[length] = 0
    return length
}

// Reads /proc/PID/`file` into the profiler's text buffer; its length.
fn readProc(profiler: *Profiler, file: []const u8) -> usize {
    var path: [64]u8 = undefined
    const bytes: [*]u8 = &path
    _ = procPath(profiler, file, bytes)
    const opened = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(bytes), 0, 0)
    if opened < 0 { return 0 }
    const got = std.linux.read(opened, profiler.*.text, 8191)
    std.linux.close(opened)
    return if got <= 0 { 0 } else { @bitCast(usize, got) }
}

// The number after `label` in /proc/PID/status (in kB for the Vm lines).
fn statusValue(text: [*]const u8, length: usize, label: []const u8) -> usize {
    var at: usize = 0
    while at + label.length < length {
        var same_label = at == 0 || text[at - 1] == 10
        var index: usize = 0
        while same_label && index < label.length {
            if text[at + index] != label[index] { same_label = false }
            index += 1
        }
        if same_label {
            var value: usize = 0
            var digit = at + label.length
            while digit < length && (text[digit] == 32 || text[digit] == 9) { digit += 1 }
            while digit < length && text[digit] >= 48 && text[digit] <= 57 {
                value = value * 10 + @intCast(usize, text[digit] - 48)
                digit += 1
            }
            return value
        }
        at += 1
    }
    return 0
}

// What the program took, read while its main thread ends (its memory is
// still there then, and every thread's times are counted in its stat).
fn noteEnd(profiler: *Profiler) -> void {
    var length = readProc(profiler, "/status")
    profiler.*.peakKiB = statusValue(profiler.*.text, length, "VmHWM:")
    profiler.*.endKiB = statusValue(profiler.*.text, length, "VmRSS:")
    length = readProc(profiler, "/stat")
    // After "pid (name) ": state is field 3; utime and stime are 14 and 15.
    var at = length
    while at > 0 && profiler.*.text[at - 1] != 41 { at -= 1 }
    var field: usize = 2
    var value: usize = 0
    while at < length {
        const byte = profiler.*.text[at]
        if byte == 32 {
            if field == 14 { profiler.*.userTicks = value }
            if field == 15 { profiler.*.systemTicks = value }
            field += 1
            value = 0
        } else if byte >= 48 && byte <= 57 {
            value = value * 10 + @intCast(usize, byte - 48)
        }
        at += 1
    }
    profiler.*.endNoted = true
}

fn running(profiler: *Profiler) -> bool {
    var path: [96]u8 = undefined
    const bytes: [*]u8 = &path
    if profiler.*.thread != 0 {
        _ = threadPath(profiler, profiler.*.thread, "/stat", bytes)
    } else {
        _ = procPath(profiler, "/stat", bytes)
    }
    const file = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(bytes), 0, 0)
    if file < 0 { return false }
    var stat: [512]u8 = undefined
    const got = std.linux.read(file, &stat, 512)
    std.linux.close(file)
    if got <= 0 { return false }
    // After "pid (name) ": the state; the name may hold spaces.
    var at = @bitCast(usize, got)
    while at > 0 && stat[at - 1] != 41 { at -= 1 }
    return at + 1 < @bitCast(usize, got) && stat[at + 1] == 82
}

// --thread: /proc/PID/task/TID`file` into `into` (NUL-ended); its length.
fn threadPath(profiler: *Profiler, thread: usize, file: []const u8, into: [*]u8) -> usize {
    var length = procPath(profiler, "/task/", into)
    length = appendNumber(into, length, thread)
    for byte in file {
        into[length] = byte
        length += 1
    }
    into[length] = 0
    return length
}

// --thread: the id of the program's thread named `threadName` (its comm),
// else 0.
fn findThread(profiler: *Profiler) -> usize {
    var path: [96]u8 = undefined
    const bytes: [*]u8 = &path
    _ = procPath(profiler, "/task", bytes)
    const directory = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(bytes), 65536, 0)
    if directory < 0 { return 0 }
    var entries: [4096]u8 = undefined
    var found: usize = 0
    while found == 0 {
        const got = std.linux.syscall3(std.linux.SYS_getdents64, @bitCast(usize, directory), @intFromPtr(&entries), 4096)
        if got <= 0 { break }
        var at: usize = 0
        while at < @bitCast(usize, got) && found == 0 {
            // linux_dirent64: inode, offset, record length (u16), type, name.
            const record = @intCast(usize, entries[at + 16]) | (@intCast(usize, entries[at + 17]) << 8)
            var thread: usize = 0
            var digit = at + 19
            while entries[digit] >= 48 && entries[digit] <= 57 {
                thread = thread * 10 + @intCast(usize, entries[digit] - 48)
                digit += 1
            }
            if thread != 0 && entries[digit] == 0 {
                _ = threadPath(profiler, thread, "/comm", bytes)
                const file = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(bytes), 0, 0)
                if file >= 0 {
                    var comm: [32]u8 = undefined
                    const read = std.linux.read(file, &comm, 32)
                    std.linux.close(file)
                    var length: usize = if read > 0 { @bitCast(usize, read) } else { 0 }
                    while length > 0 && comm[length - 1] == 10 { length -= 1 }
                    if same(comm[0..length], profiler.*.threadName) { found = thread }
                }
            }
            at += record
        }
    }
    std.linux.close(directory)
    return found
}

// --thread: one stop of the thread, sampled when it was running. The
// thread is interrupted, and its stop waited for while the main thread's
// stops are let go on (a thread may wait on the main one: a signal stop of
// the main thread left waiting would hold it). False when the thread is
// gone (it is looked for again).
fn sampleThread(profiler: *Profiler, counted: bool, wall: bool, skipped: *usize) -> bool {
    const thread = profiler.*.thread
    const was_running = wall || running(profiler)
    if std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_INTERRUPT, thread, 0, 0) != 0 { return false }
    var pause: [2]usize = [2]usize{ 0, 100000 }
    while true {
        var status: [1]u32 = [1]u32{ 0 }
        const waited = std.linux.syscall4(std.linux.SYS_wait4, thread, @intFromPtr(&status), WALL | std.linux.WNOHANG, 0)
        if waited < 0 { return false }
        if waited == 0 {
            if !mainGoesOn(profiler) { return false }
            _ = std.linux.syscall2(std.linux.SYS_nanosleep, @intFromPtr(&pause), 0)
            continue
        }
        const value = @intCast(usize, status[0])
        if value & 127 != 127 { return false }
        const signal = (value >> 8) & 255
        const stop_event = (value >> 16) & 255
        if stop_event == PTRACE_EVENT_STOP && signal == std.linux.SIGTRAP { break }
        // A signal for the thread: on to it; a stop of the whole program: on.
        const passed_signal = if stop_event != 0 { 0 } else { signal }
        if std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_CONT, thread, 0, passed_signal) != 0 { return false }
    }
    const captured = counted && was_running && capture(profiler)
    if counted && !was_running { skipped.* += 1 }
    if std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_CONT, thread, 0, 0) != 0 { return false }
    if captured { countFrames(profiler) }
    return true
}

// --thread: the main thread's stops (signals, its exit) let go on without
// waiting; false once the program has ended.
fn mainGoesOn(profiler: *Profiler) -> bool {
    while true {
        var status: [1]u32 = [1]u32{ 0 }
        const waited = std.linux.syscall4(std.linux.SYS_wait4, profiler.*.child, @intFromPtr(&status), WALL | std.linux.WNOHANG, 0)
        if waited == 0 { return true }
        if waited < 0 { return false }
        const value = @intCast(usize, status[0])
        if value & 127 != 127 { return false }
        const signal = (value >> 8) & 255
        const stop_event = (value >> 16) & 255
        if stop_event == PTRACE_EVENT_EXIT && !profiler.*.endNoted { noteEnd(profiler) }
        const passed_signal = if stop_event != 0 { 0 } else { signal }
        _ = std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_CONT, profiler.*.child, 0, passed_signal)
    }
    return true
}

// Waits for the program's main thread to stop with `event` (a ptrace event:
// PTRACE_EVENT_EXEC, or PTRACE_EVENT_STOP after a PTRACE_INTERRUPT) or end.
// 1: stopped so; 2: ended. Signals are passed on to the program, and its
// other stops let go on.
//
// The program is seized (PTRACE_SEIZE), so an interrupt stops only its
// main thread. SIGSTOP would stop all its threads and PTRACE_CONT start only
// the main one again: a program waiting on a thread of its own (a Vulkan
// driver's) would stand still.
fn waitFor(profiler: *Profiler, event: usize) -> usize {
    while true {
        var status: [1]u32 = [1]u32{ 0 }
        const waited = std.linux.syscall4(std.linux.SYS_wait4, profiler.*.child, @intFromPtr(&status), WALL, 0)
        if waited < 0 { return 2 }
        const value = @intCast(usize, status[0])
        if value & 127 == 0 || (value & 127 != 127) { return 2 }
        const signal = (value >> 8) & 255
        const stop_event = (value >> 16) & 255
        if stop_event == event && (event != PTRACE_EVENT_STOP || signal == std.linux.SIGTRAP) { return 1 }
        if stop_event == PTRACE_EVENT_EXIT && !profiler.*.endNoted { noteEnd(profiler) }
        // A stop of the whole program or another event: on; a signal: on
        // to the program.
        const passed_signal = if stop_event != 0 { 0 } else { signal }
        _ = std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_CONT, profiler.*.child, 0, passed_signal)
    }
    return 2
}

// ---------------------------------------------------------------------------
// The profile

fn append(into: [*]u8, at: usize, text: []const u8) -> usize {
    var length = at
    for byte in text {
        if length < 4000 {
            into[length] = byte
            length += 1
        }
    }
    return length
}

fn appendNumber(into: [*]u8, at: usize, value: usize) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest /= 10
        count += 1
    }
    var length = at
    while count > 0 {
        count -= 1
        into[length] = digits[count]
        length += 1
    }
    return length
}

fn variable(environment: [*][*]const u8, name: []const u8) -> []const u8 {
    var entry: usize = 0
    while @intFromPtr(environment[entry]) != 0 {
        const text = environment[entry]
        var matches = true
        var length: usize = 0
        for byte in name {
            if matches && text[length] != byte { matches = false }
            if matches { length += 1 }
        }
        if matches && text[length] == 61 {
            var end = length + 1
            while text[end] != 0 { end += 1 }
            return text[length + 1..end]
        }
        entry += 1
    }
    return ""
}

// The environment with MLX_GPU_PROFILE=WHERE added (unless it is there):
// the program's GPU work is profiled too, into the same directory
// (std.gpu; 1 is the default one); and MLX_FRAMES=1 (unless set), its
// frame timeline.
fn withGpuProfile(environment: [*][*]const u8, where: [*]const u8) -> [*]const [*]const u8 {
    if variable(environment, "MLX_GPU_PROFILE").length > 0 { return unsafe { @ptrCast([*]const [*]const u8, environment) } }
    var count: usize = 0
    while @intFromPtr(environment[count]) != 0 { count += 1 }
    const entry_memory = allocate(4200)
    const table_memory = allocate((count + 3) * 8)
    if entry_memory == 0 || table_memory == 0 { return unsafe { @ptrCast([*]const [*]const u8, environment) } }
    var entry: [*]u8 = undefined
    var table: [*][*]const u8 = undefined
    unsafe {
        entry = @ptrFromInt([*]u8, entry_memory)
        table = @ptrFromInt([*][*]const u8, table_memory)
    }
    var length = append(entry, 0, "MLX_GPU_PROFILE=")
    length = append(entry, length, std.text.cString(where))
    entry[length] = 0
    var index: usize = 0
    while index < count {
        table[index] = environment[index]
        index += 1
    }
    table[count] = entry
    var end = count + 1
    if variable(environment, "MLX_FRAMES").length == 0 {
        table[end] = "MLX_FRAMES=1".pointer
        end += 1
    }
    unsafe { table[end] = @ptrFromInt([*]const u8, 0) }
    return unsafe { @ptrCast([*]const [*]const u8, table) }
}

// The functions by total samples, most first (indexes into `order`).
fn rank(profiler: *Profiler, order: [*]u32) -> void {
    var at: usize = 0
    while at < profiler.*.count {
        const function = @intCast(u32, at)
        var place = at
        while place > 0 && profiler.*.totalSamples[order[place - 1]] < profiler.*.totalSamples[function] {
            order[place] = order[place - 1]
            place -= 1
        }
        order[place] = function
        at += 1
    }
}

fn writeProfile(profiler: *Profiler, directory: []const u8, program: []const u8, interval: usize, order: [*]u32) -> void {
    var file: diagnostics.ProfileFile = undefined
    if !diagnostics.openProfile(&file, diagnostics.Source.processor, directory, program, diagnostics.now(), profiler.*.samples, interval * 1000) {
        sayError("mlx-profile: cannot write the profile\n")
        return
    }
    var index: usize = 0
    while index < profiler.*.count {
        const function = @intCast(usize, order[index])
        const start = @intCast(usize, profiler.*.nameStart[function])
        diagnostics.profileLine(&file, @intCast(usize, profiler.*.selfSamples[function]), @intCast(usize, profiler.*.totalSamples[function]), profiler.*.names[start..start + @intCast(usize, profiler.*.nameLength[function])])
        index += 1
    }
    diagnostics.closeProfile(&file)
    say("mlx-profile: wrote ")
    say(diagnostics.profilePath(&file))
    say("\n")
    if directory.length > 0 {
        // (mlx-codemap reads its own directory unless told this one.)
        say("mlx-profile: read with MLX_PROFILES=")
        say(directory)
        say(" mlx-codemap hot\n")
    }
}

fn usage() -> void {
    sayError("usage: mlx-profile [-o DIRECTORY] [--every MILLISECONDS] [--after MILLISECONDS] [--wall] [--thread NAME] PROGRAM [ARGUMENT...]\n")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    // The crash report before anything else: a crash names the function it
    // was in and its callers, and is kept for MLX Observatory (std.crash).
    _ = crash.install()
    const environment = std.process.environmentEntries(arguments)
    var first: usize = 1
    var interval: usize = 5
    var after: usize = 0
    var wall = false
    var thread_name: []const u8 = ""
    var directory: [*]const u8 = undefined
    var has_directory = false
    while first < arguments.length {
        const argument = std.text.cString(arguments[first])
        if same(argument, "-o") && first + 1 < arguments.length {
            directory = arguments[first + 1]
            has_directory = true
            first += 2
        } else if same(argument, "--every") && first + 1 < arguments.length {
            interval = 0
            for byte in std.text.cString(arguments[first + 1]) {
                if byte >= 48 && byte <= 57 { interval = interval * 10 + @intCast(usize, byte - 48) }
            }
            if interval == 0 { interval = 1 }
            first += 2
        } else if same(argument, "--after") && first + 1 < arguments.length {
            for byte in std.text.cString(arguments[first + 1]) {
                if byte >= 48 && byte <= 57 { after = after * 10 + @intCast(usize, byte - 48) }
            }
            first += 2
        } else if same(argument, "--wall") {
            wall = true
            first += 1
        } else if same(argument, "--thread") && first + 1 < arguments.length {
            thread_name = std.text.cString(arguments[first + 1])
            first += 2
        } else {
            break
        }
    }
    if first >= arguments.length {
        usage()
        return 2
    }
    const profiler_memory = allocate(@sizeOf(Profiler))
    if profiler_memory == 0 { return 1 }
    const profiler: *Profiler = unsafe { @ptrFromInt(*Profiler, profiler_memory) }
    unsafe {
        profiler.*.names = @ptrFromInt([*]u8, allocate(NAMES_SIZE))
        profiler.*.maps = @ptrFromInt([*]u8, allocate(MAPS_SIZE))
        profiler.*.text = @ptrFromInt([*]u8, allocate(8192))
        profiler.*.addressKeys = @ptrFromInt([*]u64, allocate(ADDRESS_SLOTS * 8))
    }
    profiler.*.nameStart = words(MAX_FUNCTIONS)
    profiler.*.nameLength = words(MAX_FUNCTIONS)
    profiler.*.selfSamples = words(MAX_FUNCTIONS)
    profiler.*.totalSamples = words(MAX_FUNCTIONS)
    profiler.*.marks = words(MAX_FUNCTIONS)
    profiler.*.slots = words(FUNCTION_SLOTS)
    profiler.*.addressValues = words(ADDRESS_SLOTS)
    // The program, traced from its first instruction: it stops itself,
    // is seized, and goes on to its exec.
    const child = std.linux.process.fork()
    if child == 0 {
        const self = std.linux.getpid()
        _ = std.linux.syscall2(std.linux.SYS_kill, @bitCast(usize, self), std.linux.SIGSTOP)
        const program_arguments: [*]const [*]const u8 = unsafe { @ptrFromInt([*]const [*]const u8, @intFromPtr(@ptrCast([*]const [*]const u8, arguments)) + first * 8) }
        _ = std.linux.syscall3(std.linux.SYS_execve, @intFromPtr(arguments[first]), @intFromPtr(program_arguments), @intFromPtr(withGpuProfile(environment, if has_directory { directory } else { "1".pointer })))
        sayError("mlx-profile: cannot run the program\n")
        _ = std.linux.syscall1(std.linux.SYS_exit, 127)
    }
    if child < 0 { return 1 }
    profiler.*.child = @bitCast(usize, child)
    profiler.*.thread = 0
    profiler.*.threadName = thread_name
    var first_status: [1]u32 = [1]u32{ 0 }
    const first_wait = std.linux.syscall4(std.linux.SYS_wait4, profiler.*.child, @intFromPtr(&first_status), std.linux.WUNTRACED, 0)
    profiler.*.endNoted = false
    profiler.*.peakKiB = 0
    profiler.*.endKiB = 0
    profiler.*.userTicks = 0
    profiler.*.systemTicks = 0
    const seized = std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_SEIZE, profiler.*.child, 0, PTRACE_O_EXITKILL | PTRACE_O_TRACEEXEC | PTRACE_O_TRACEEXIT)
    _ = std.linux.syscall2(std.linux.SYS_kill, profiler.*.child, std.linux.SIGCONT)
    // It stops at the exec.
    if first_wait < 0 || seized != 0 || waitFor(profiler, PTRACE_EVENT_EXEC) != 1 {
        sayError("mlx-profile: the program did not start\n")
        return 1
    }
    readMaps(profiler)
    var sleep: [2]usize = [2]usize{ interval / 1000, (interval % 1000) * 1000000 }
    var skipped: usize = 0
    // With --after, the stops before then are not counted (to see a
    // program's frames rather than its start).
    const counted_from = std.time.milliseconds() + after
    if thread_name.length > 0 {
        // --thread: the main thread runs on; the thread named is seized
        // once it is there and stopped each time instead.
        if std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_CONT, profiler.*.child, 0, 0) != 0 { return 1 }
        while mainGoesOn(profiler) {
            _ = std.linux.syscall2(std.linux.SYS_nanosleep, @intFromPtr(&sleep), 0)
            if profiler.*.thread == 0 {
                const found = findThread(profiler)
                if found != 0 && std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_SEIZE, found, 0, 0) == 0 { profiler.*.thread = found }
                continue
            }
            if !sampleThread(profiler, std.time.milliseconds() >= counted_from, wall, &skipped) { profiler.*.thread = 0 }
        }
    }
    // (A stop's frames are captured while the program is stopped and
    // counted once it runs again: naming a new address can take long.)
    var captured = false
    while thread_name.length == 0 {
        const resumed = std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_CONT, profiler.*.child, 0, 0)
        if resumed != 0 { break }
        if captured {
            countFrames(profiler)
            captured = false
        }
        _ = std.linux.syscall2(std.linux.SYS_nanosleep, @intFromPtr(&sleep), 0)
        const was_running = wall || running(profiler)
        const stopped = std.linux.syscall4(std.linux.SYS_ptrace, PTRACE_INTERRUPT, profiler.*.child, 0, 0)
        if stopped != 0 { break }
        if waitFor(profiler, PTRACE_EVENT_STOP) != 1 { break }
        if std.time.milliseconds() < counted_from { continue }
        if was_running { captured = capture(profiler) } else { skipped += 1 }
    }
    // The program's name: its file's.
    const program_path = std.text.cString(arguments[first])
    var base: usize = program_path.length
    while base > 0 && program_path[base - 1] != 47 { base -= 1 }
    const program = program_path[base..program_path.length]
    const order = words(profiler.*.count + 1)
    rank(profiler, order)
    say("mlx-profile: ")
    sayNumber(profiler.*.samples)
    say(" samples")
    if !wall {
        say(" (")
        sayNumber(skipped)
        say(" more while it waited)")
    }
    say("\n")
    var shown: usize = 0
    while shown < profiler.*.count && shown < 20 {
        const function = @intCast(usize, order[shown])
        const total = @intCast(usize, profiler.*.totalSamples[function])
        const self_samples = @intCast(usize, profiler.*.selfSamples[function])
        const all = if profiler.*.samples > 0 { profiler.*.samples } else { 1 }
        say("  ")
        sayNumber(total * 100 / all)
        say("% with calls, ")
        sayNumber(self_samples * 100 / all)
        say("% itself: ")
        const start = @intCast(usize, profiler.*.nameStart[function])
        say(profiler.*.names[start..start + @intCast(usize, profiler.*.nameLength[function])])
        say("\n")
        shown += 1
    }
    if profiler.*.endNoted {
        // Processor time of every thread (the samples see the main one),
        // and memory: at most and at the end.
        const ticks = profiler.*.userTicks + profiler.*.systemTicks
        say("mlx-profile: ")
        sayNumber(ticks * 1000 / TICKS)
        say(" ms of processor time (")
        sayNumber(profiler.*.systemTicks * 1000 / TICKS)
        say(" ms in the kernel), every thread; memory ")
        sayNumber(profiler.*.peakKiB / 1024)
        say(" MiB at most, ")
        sayNumber(profiler.*.endKiB / 1024)
        say(" MiB at the end\n")
    }
    writeProfile(profiler, if has_directory { std.text.cString(directory) } else { "" }, program, interval, order)
    return 0
}
