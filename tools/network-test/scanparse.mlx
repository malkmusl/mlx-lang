// nl80211's scan results as projects/network/nl80211.mlx reads them, for
// tools/check_wifi.sh: FILE holds the messages of a GET_SCAN dump (as the
// check writes them, the kernel's layout); each network is printed as
// "SSID|signal dBm|quality|frequency|security|group cipher|RSN length|
// associated|BSSID".
//
//     scanparse FILE SEQUENCE
const std = @import("std")
const nl80211 = @import("../../projects/network/nl80211.mlx")
const system = @import("../../projects/network/system.mlx")
const wifi = @import("../../projects/network/wifi.mlx")

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

fn print(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: u64) -> void {
    var text: [24]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &text) }
    const length = system.putNumber(bytes, 0, value)
    print(bytes[0..length])
}

pub fn main(arguments: [][*]const u8) -> !void {
    if arguments.length < 3 { return }
    const memory = std.page_allocator.init().alloc(65536 + @sizeOf(nl80211.Networks), 16)
    if memory == null { return }
    var bytes: [*]u8 = undefined
    var networks: *nl80211.Networks = undefined
    unsafe {
        bytes = @ptrCast([*]u8, memory.?)
        networks = @ptrFromInt(*nl80211.Networks, @intFromPtr(memory.?) + 65536)
    }
    const length = system.readFile(cString(arguments[1]), bytes, 65536)
    var sequence: u32 = 0
    for digit in cString(arguments[2]) { sequence = sequence * 10 + @intCast(u32, digit - 48) }
    networks.*.count = 0
    const done = nl80211.takeResults(networks, bytes, length, sequence)
    var index: usize = 0
    while index < networks.*.count {
        const network = nl80211.at(networks, index)
        print(nl80211.ssidOf(network))
        print("|")
        if network.*.signal < 0 {
            print("-")
            number(@intCast(u64, -network.*.signal))
        } else {
            number(@intCast(u64, network.*.signal))
        }
        print("|")
        number(@intCast(u64, nl80211.quality(network.*.signal)))
        print("|")
        number(@intCast(u64, network.*.frequency))
        print("|")
        print(wifi.securityName(network.*.security))
        print("|")
        number(@intCast(u64, network.*.groupCipher))
        print("|")
        number(@intCast(u64, network.*.rsnLength))
        print("|")
        print(if network.*.associated { "joined" } else { "-" })
        print("|")
        number(@intCast(u64, network.*.bssid[5]))
        print("\n")
        index += 1
    }
    print(if done { "done\n" } else { "not done\n" })
}
