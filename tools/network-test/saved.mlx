// The saved Wi-Fi networks of projects/network/wifi.mlx, for
// tools/check_wifi.sh: FOLDER/wifi written, read back and pruned.
//
//     saved FOLDER save SSID PASSPHRASE | save-open SSID | forget SSID | list
//
// "list" prints each network as "SSID PMK-hex" or "SSID open".
const std = @import("std")
const wifi = @import("../../projects/network/wifi.mlx")
const wpa = @import("../../projects/network/wpa.mlx")
const system = @import("../../projects/network/system.mlx")

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

fn print(text: []const u8) -> void { const written = std.io.writeAll(std.io.stdout(), text) }

pub fn main(arguments: [][*]const u8) -> !void {
    if arguments.length < 3 { return }
    const memory = std.page_allocator.init().alloc(@sizeOf(wifi.Saved), 16)
    if memory == null { return }
    const saved: *wifi.Saved = unsafe { @ptrCast(*wifi.Saved, memory.?) }
    wifi.loadSaved(saved, cString(arguments[1]))
    const what = cString(arguments[2])
    var pmk: [32]u8 = undefined
    const pmk_bytes: [*]u8 = unsafe { @ptrCast([*]u8, &pmk) }
    if system.same(what, "save") && arguments.length >= 5 {
        wpa.pmkOf(cString(arguments[4]), cString(arguments[3]), pmk_bytes)
        wifi.remember(saved, cString(arguments[3]), pmk_bytes, false)
    } else if system.same(what, "save-open") && arguments.length >= 4 {
        wifi.remember(saved, cString(arguments[3]), pmk_bytes, true)
    } else if system.same(what, "forget") && arguments.length >= 4 {
        if !wifi.forget(saved, cString(arguments[3])) { print("not saved\n") }
    } else if system.same(what, "list") {
        var slot: usize = 0
        while slot < saved.*.count {
            const known = wifi.knownAt(saved, slot)
            var line: [128]u8 = undefined
            const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &line) }
            var length: usize = 0
            var index: usize = 0
            while index < known.*.ssidLength {
                bytes[length] = known.*.ssid[index]
                length += 1
                index += 1
            }
            length = system.put(bytes, length, " ")
            if known.*.open {
                length = system.put(bytes, length, "open")
            } else {
                const digits = "0123456789abcdef"
                index = 0
                while index < 32 {
                    bytes[length] = digits[@intCast(usize, known.*.pmk[index] >> 4)]
                    bytes[length + 1] = digits[@intCast(usize, known.*.pmk[index] & 15)]
                    length += 2
                    index += 1
                }
            }
            length = system.put(bytes, length, "\n")
            print(bytes[0..length])
            slot += 1
        }
    }
}
