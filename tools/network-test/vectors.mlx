// The Wi-Fi crypto's known answers, for tools/check_wifi.sh: SHA-1,
// HMAC-SHA1, PBKDF2-HMAC-SHA1 (with WPA's PSK), AES-128 and its key
// wrap, and the 802.11 PRF, each printed as hex for the check to compare
// with the published vectors and with python's.
//
//     vectors sha1 TEXT | hmac KEY TEXT | pbkdf2 PASSWORD SALT ROUNDS LENGTH
//             | aes KEYHEX BLOCKHEX | aesdecrypt KEYHEX BLOCKHEX
//             | wrap KEKHEX HEX | unwrap KEKHEX HEX
//             | prf KEYHEX LABEL DATAHEX LENGTH
//             | psk PASSPHRASE SSID
//             | ptk PMKHEX AA SPA ANONCE SNONCE
const std = @import("std")
const sha1 = @import("std.sha1")
const aes = @import("std.aes")
const wpa = @import("../../projects/network/wpa.mlx")

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn print(text: []const u8) -> void { const written = std.io.writeAll(std.io.stdout(), text) }

fn hex(bytes: [*]const u8, length: usize) -> void {
    var line: [1024]u8 = undefined
    const digits = "0123456789abcdef"
    var index: usize = 0
    while index < length && index < 512 {
        line[index * 2] = digits[@intCast(usize, bytes[index] >> 4)]
        line[index * 2 + 1] = digits[@intCast(usize, bytes[index] & 15)]
        index += 1
    }
    var out: [*]const u8 = undefined
    unsafe { out = @ptrCast([*]const u8, &line) }
    print(out[0 .. index * 2])
    print("\n")
}

fn nibble(c: u8) -> u8 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return 0
}

fn unhex(text: []const u8, into: [*]u8) -> usize {
    var index: usize = 0
    while index * 2 + 1 < text.length {
        into[index] = (nibble(text[index * 2]) << 4) | nibble(text[index * 2 + 1])
        index += 1
    }
    return index
}

fn number(text: []const u8) -> usize {
    var value: usize = 0
    var index: usize = 0
    while index < text.length {
        value = value * 10 + @intCast(usize, text[index] - 48)
        index += 1
    }
    return value
}

pub fn main(arguments: [][*]const u8) -> !void {
    if arguments.length < 3 { return }
    const what = cString(arguments[1])
    var a: [512]u8 = undefined
    var b: [512]u8 = undefined
    var c: [512]u8 = undefined
    var aBytes: [*]u8 = undefined
    var bBytes: [*]u8 = undefined
    var cBytes: [*]u8 = undefined
    unsafe {
        aBytes = @ptrCast([*]u8, &a)
        bBytes = @ptrCast([*]u8, &b)
        cBytes = @ptrCast([*]u8, &c)
    }
    if same(what, "sha1") {
        var digest: [20]u8 = undefined
        sha1.sha1(cString(arguments[2]), &digest)
        var out: [*]const u8 = undefined
        unsafe { out = @ptrCast([*]const u8, &digest) }
        hex(out, 20)
    } else if same(what, "hmac") && arguments.length >= 4 {
        var digest: [20]u8 = undefined
        const keyLength = unhex(cString(arguments[2]), aBytes)
        sha1.hmacSha1(aBytes[0..keyLength], cString(arguments[3]), &digest)
        var out: [*]const u8 = undefined
        unsafe { out = @ptrCast([*]const u8, &digest) }
        hex(out, 20)
    } else if same(what, "pbkdf2") && arguments.length >= 6 {
        const length = number(cString(arguments[5]))
        sha1.pbkdf2Sha1(cString(arguments[2]), cString(arguments[3]), @intCast(u64, number(cString(arguments[4]))), cBytes, length)
        hex(cBytes, length)
    } else if (same(what, "aes") || same(what, "aesdecrypt")) && arguments.length >= 4 {
        const keyLength = unhex(cString(arguments[2]), aBytes)
        const blockLength = unhex(cString(arguments[3]), bBytes)
        if keyLength != 16 || blockLength != 16 { return }
        var cipher: aes.Aes128 = undefined
        aes.init(&cipher, aBytes)
        if same(what, "aes") { aes.encrypt(&cipher, bBytes) } else { aes.decrypt(&cipher, bBytes) }
        aes.finish(&cipher)
        hex(bBytes, 16)
    } else if same(what, "wrap") && arguments.length >= 4 {
        const keyLength = unhex(cString(arguments[2]), aBytes)
        const length = unhex(cString(arguments[3]), bBytes)
        if keyLength != 16 { return }
        if aes.wrap(aBytes, bBytes, length, cBytes) { hex(cBytes, length + 8) } else { print("refused\n") }
    } else if same(what, "unwrap") && arguments.length >= 4 {
        const keyLength = unhex(cString(arguments[2]), aBytes)
        const length = unhex(cString(arguments[3]), bBytes)
        if keyLength != 16 { return }
        if aes.unwrap(aBytes, bBytes, length, cBytes) { hex(cBytes, length - 8) } else { print("refused\n") }
    } else if same(what, "prf") && arguments.length >= 6 {
        const keyLength = unhex(cString(arguments[2]), aBytes)
        const dataLength = unhex(cString(arguments[4]), bBytes)
        const length = number(cString(arguments[5]))
        wpa.prf(aBytes[0..keyLength], cString(arguments[3]), bBytes[0..dataLength], cBytes, length)
        hex(cBytes, length)
    } else if same(what, "psk") && arguments.length >= 4 {
        wpa.pmkOf(cString(arguments[2]), cString(arguments[3]), cBytes)
        hex(cBytes, 32)
    } else if same(what, "ptk") && arguments.length >= 7 {
        const pmkLength = unhex(cString(arguments[2]), aBytes)
        var aa: [6]u8 = undefined
        var spa: [6]u8 = undefined
        var anonce: [32]u8 = undefined
        var snonce: [32]u8 = undefined
        var aaBytes: [*]u8 = undefined
        var spaBytes: [*]u8 = undefined
        var anonceBytes: [*]u8 = undefined
        var snonceBytes: [*]u8 = undefined
        unsafe {
            aaBytes = @ptrCast([*]u8, &aa)
            spaBytes = @ptrCast([*]u8, &spa)
            anonceBytes = @ptrCast([*]u8, &anonce)
            snonceBytes = @ptrCast([*]u8, &snonce)
        }
        const aaLength = unhex(cString(arguments[3]), aaBytes)
        const spaLength = unhex(cString(arguments[4]), spaBytes)
        const anonceLength = unhex(cString(arguments[5]), anonceBytes)
        const snonceLength = unhex(cString(arguments[6]), snonceBytes)
        if pmkLength != 32 { return }
        wpa.ptkOf(aBytes, aaBytes, spaBytes, anonceBytes, snonceBytes, cBytes)
        hex(cBytes, wpa.PTK_LENGTH)
    }
}
