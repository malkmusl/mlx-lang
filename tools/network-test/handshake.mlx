// The supplicant side of tools/check_wifi.sh: projects/network/wpa.mlx on
// a link's EAPOL socket, as mlx-netd runs it once nl80211 has associated,
// without the card (the keys it would install are printed instead).
//
//     handshake INDEX OWN AP AP_ELEMENT PASSPHRASE SSID SECONDS
//
// INDEX is the link's index, OWN and AP the addresses (aa:bb:..), the
// element the access point's RSN element in hex (as its beacon would
// carry it). It prints "pairwise TK", "group INDEX GTK", "failure
// element", "failure key-data" and, at the end, "unanswered N" (messages
// 1 answered without a message 3).
const std = @import("std")
const system = @import("../../projects/network/system.mlx")
const wpa = @import("../../projects/network/wpa.mlx")

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

fn print(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn hex(bytes: [*]const u8, length: usize) -> void {
    var line: [128]u8 = undefined
    const digits = "0123456789abcdef"
    var index: usize = 0
    while index < length && index < 64 {
        line[index * 2] = digits[@intCast(usize, bytes[index] >> 4)]
        line[index * 2 + 1] = digits[@intCast(usize, bytes[index] & 15)]
        index += 1
    }
    const out: [*]const u8 = unsafe { @ptrCast([*]const u8, &line) }
    print(out[0 .. index * 2])
}

fn nibble(c: u8) -> u8 {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return 0
}

// Hex digits into bytes, separators (':') skipped; the count.
fn unhex(text: []const u8, into: [*]u8, capacity: usize) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index + 1 < text.length && count < capacity {
        if text[index] == 58 {
            index += 1
            continue
        }
        into[count] = (nibble(text[index]) << 4) | nibble(text[index + 1])
        count += 1
        index += 2
    }
    return count
}

fn number(text: []const u8) -> usize {
    var value: usize = 0
    var index: usize = 0
    while index < text.length {
        value = value * 10 + @intCast(usize, text[index] - 48)
        index += 1
    }
    return value
}

pub fn main(arguments: [][*]const u8) -> !void {
    if arguments.length < 8 {
        system.say("usage: handshake INDEX OWN AP AP_ELEMENT PASSPHRASE SSID SECONDS\n")
        return
    }
    const index = @intCast(u32, number(cString(arguments[1])))
    var own: [6]u8 = undefined
    var ap: [6]u8 = undefined
    var element: [64]u8 = undefined
    var mine: [64]u8 = undefined
    var pmk: [32]u8 = undefined
    var ownBytes: [*]u8 = undefined
    var apBytes: [*]u8 = undefined
    var elementBytes: [*]u8 = undefined
    var mineBytes: [*]u8 = undefined
    var pmkBytes: [*]u8 = undefined
    unsafe {
        ownBytes = @ptrCast([*]u8, &own)
        apBytes = @ptrCast([*]u8, &ap)
        elementBytes = @ptrCast([*]u8, &element)
        mineBytes = @ptrCast([*]u8, &mine)
        pmkBytes = @ptrCast([*]u8, &pmk)
    }
    _ = unhex(cString(arguments[2]), ownBytes, 6)
    _ = unhex(cString(arguments[3]), apBytes, 6)
    const elementLength = unhex(cString(arguments[4]), elementBytes, 64)
    wpa.pmkOf(cString(arguments[5]), cString(arguments[6]), pmkBytes)
    const seconds = number(cString(arguments[7]))
    const mineLength = wpa.ownElement(4, mineBytes)
    const memory = std.page_allocator.init().alloc(@sizeOf(wpa.Supplicant), 16)
    if memory == null { return }
    const supplicant: *wpa.Supplicant = unsafe { @ptrCast(*wpa.Supplicant, memory.?) }
    wpa.start(supplicant, pmkBytes, ownBytes, apBytes, mineBytes, mineLength, elementBytes, elementLength)
    const socket = system.eapolOpen(index)
    if socket < 0 {
        system.say("handshake: no EAPOL socket\n")
        return
    }
    print("ready\n")
    var frame: [600]u8 = undefined
    var answer: [512]u8 = undefined
    var from: [6]u8 = undefined
    var frameBytes: [*]u8 = undefined
    var answerBytes: [*]u8 = undefined
    var fromBytes: [*]u8 = undefined
    unsafe {
        frameBytes = @ptrCast([*]u8, &frame)
        answerBytes = @ptrCast([*]u8, &answer)
        fromBytes = @ptrCast([*]u8, &from)
    }
    const until = std.time.milliseconds() + seconds * 1000
    var poll: system.Poll = undefined
    while std.time.milliseconds() < until {
        system.pollClear(&poll)
        const slot = system.pollAdd(&poll, socket)
        system.pollWait(&poll, 200)
        if !system.pollReady(&poll, slot) { continue }
        while true {
            const count = system.eapolReceive(socket, frameBytes, 600, fromBytes)
            if count <= 0 { break }
            var known = true
            var at: usize = 0
            while at < 6 {
                if from[at] != ap[at] { known = false }
                at += 1
            }
            if !known { continue }
            const length = wpa.receive(supplicant, frameBytes, @intCast(usize, count), answerBytes)
            if length > 0 { _ = system.eapolSend(socket, index, apBytes, answerBytes, length) }
            if supplicant.*.installPairwise {
                supplicant.*.installPairwise = false
                print("pairwise ")
                hex(wpa.temporalKey(supplicant), wpa.TK_LENGTH)
                print("\n")
            }
            if supplicant.*.installGroup {
                supplicant.*.installGroup = false
                var digit: [1]u8 = [1]u8{ @intCast(u8, 48 + supplicant.*.gtkIndex) }
                const digitBytes: [*]const u8 = unsafe { @ptrCast([*]const u8, &digit) }
                print("group ")
                print(digitBytes[0..1])
                print(" ")
                hex(wpa.gtkBytes(supplicant), supplicant.*.gtkLength)
                print("\n")
            }
            if supplicant.*.failure != wpa.FAILURE_NONE {
                print(if supplicant.*.failure == wpa.FAILURE_ELEMENT { "failure element\n" } else { "failure key-data\n" })
                supplicant.*.failure = wpa.FAILURE_NONE
            }
        }
    }
    var digits: [1]u8 = [1]u8{ @intCast(u8, 48 + (supplicant.*.unanswered % 10)) }
    const digitsBytes: [*]const u8 = unsafe { @ptrCast([*]const u8, &digits) }
    print("unanswered ")
    print(digitsBytes[0..1])
    print("\n")
    wpa.stop(supplicant)
    std.linux.close(socket)
}
