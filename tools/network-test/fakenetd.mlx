// A stand-in for mlx-netd on the system bus, for the checks of the
// desktop's network UI (mlx-settings' Network page, the top bar's control
// centre): org.mlx.Network with a cable (eth0, connected) and a Wi-Fi card
// (wlan0) that sees four networks:
//
//   Zuhause      WPA2, 82%, not saved: joined with "correct horse battery"
//                (a second later), any other passphrase is refused
//   Cafe Sonne   open, 61%
//   Buero        WPA3, 70%: not supported
//   Nachbar      WPA2, 35%, saved
//
// Connect, Disconnect, Forget, Scan, Up and Down change what Devices and
// Networks tell, as mlx-netd would, and each one sends Changed. It says
// what it was asked on stdout ("connect Zuhause (21 bytes)", "joined
// Zuhause", "refused Zuhause", ...), never a passphrase.
//
//     fakenetd [--bus PATH] [--as NAME]
//
// The bus is $DBUS_SYSTEM_BUS_ADDRESS's unless --bus names it. With --as
// it only takes NAME and answers nothing: a NetworkManager on the bus
// (--as org.freedesktop.NetworkManager), or an mlx-netd that hangs (--as
// org.mlx.Network), for the Network page's word on why mlx-netd does not
// answer.
const std = @import("std")
const dbus = @import("std.dbus")
const system = @import("../../projects/network/system.mlx")

const NAME: []const u8 = "org.mlx.Network"
const PATH: []const u8 = "/org/mlx/Network"
const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const SIZE: usize = 16384
const NETWORKS: usize = 4
const RIGHT: []const u8 = "correct horse battery"

const Fake = struct {
    client: dbus.Client
    out: [*]u8
    // Per network: saved, the problem (0 none, 1 passphrase).
    saved: [4]bool
    problem: [4]u32
    // The network joined (NETWORKS: none) and the one being joined, when
    // it is due and whether the passphrase was right.
    joined: usize
    joining: usize
    dueAt: usize
    right: bool
    wifiOff: bool
    cableOff: bool
}

fn ssid(index: usize) -> []const u8 { return match index { 0 => "Zuhause", 1 => "Cafe Sonne", 2 => "Buero", else => "Nachbar" } }
fn security(index: usize) -> []const u8 { return match index { 0 => "wpa2", 1 => "open", 2 => "wpa3", else => "wpa2" } }
fn signal(index: usize) -> u32 { return match index { 0 => 82, 1 => 61, 2 => 70, else => 35 } }
fn frequency(index: usize) -> u32 { return match index { 0 => 5180, 1 => 2412, 2 => 5240, else => 2437 } }

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

fn print(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn nothing() -> [*]const isize {
    var none: [1]isize = [1]isize{ 0 }
    unsafe { return @ptrCast([*]const isize, &none) }
}

fn clientOf(fake: *Fake) -> *dbus.Client {
    unsafe { return @ptrCast(*dbus.Client, &fake.*.client) }
}

fn find(name: []const u8) -> usize {
    var index: usize = 0
    while index < NETWORKS {
        if system.same(ssid(index), name) { return index }
        index += 1
    }
    return NETWORKS
}

fn refuse(fake: *Fake, request: *const dbus.Header, error_name: []const u8, message: []const u8) -> void {
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, fake.*.out, SIZE, false)
    dbus.putString(&writing, message)
    var header = dbus.newHeader(dbus.ERROR, 0)
    header.errorName = error_name
    header.replySerial = request.*.serial
    header.hasReplySerial = true
    header.destination = request.*.sender
    header.signature = "s"
    _ = dbus.send(clientOf(fake), &header, fake.*.out, writing.length, nothing(), 0)
}

fn replyEmpty(fake: *Fake, request: *const dbus.Header) -> void {
    _ = dbus.reply(clientOf(fake), request, "", fake.*.out, 0, nothing(), 0)
}

fn changed(fake: *Fake) -> void {
    var header = dbus.newHeader(dbus.SIGNAL, 0)
    header.path = PATH
    header.interface = NAME
    header.member = "Changed"
    header.signature = ""
    _ = dbus.send(clientOf(fake), &header, fake.*.out, 0, nothing(), 0)
}

fn putLink(writing: *dbus.Writer, name: []const u8, kind: []const u8, state: []const u8, address: []const u8, gateway: []const u8, network: []const u8, dns: []const u8) -> void {
    dbus.pad(writing, 8)
    dbus.putString(writing, name)
    dbus.putString(writing, kind)
    dbus.putString(writing, state)
    dbus.putString(writing, address)
    dbus.putString(writing, gateway)
    dbus.putString(writing, network)
    const servers = dbus.beginArray(writing, 4)
    if dns.length > 0 { dbus.putString(writing, dns) }
    dbus.endArray(writing, servers, 4)
}

fn called(fake: *Fake, request: *const dbus.Header) -> void {
    const client = clientOf(fake)
    var reading = dbus.reader(dbus.bodyOf(client, request), request.*.bodyLength, request.*.big)
    const member = request.*.member
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, fake.*.out, SIZE, false)
    if system.same(member, "Devices") {
        const list = dbus.beginArray(&writing, 8)
        if fake.*.cableOff {
            putLink(&writing, "eth0", "ethernet", "off", "", "", "", "")
        } else {
            putLink(&writing, "eth0", "ethernet", "connected", "192.168.1.20/24", "192.168.1.1", "", "192.168.1.1")
        }
        if fake.*.wifiOff {
            putLink(&writing, "wlan0", "wifi", "off", "", "", "", "")
        } else if fake.*.joined < NETWORKS {
            putLink(&writing, "wlan0", "wifi", "connected", "10.0.0.7/24", "10.0.0.1", ssid(fake.*.joined), "10.0.0.1")
        } else if fake.*.joining < NETWORKS {
            putLink(&writing, "wlan0", "wifi", "connecting", "", "", ssid(fake.*.joining), "")
        } else {
            putLink(&writing, "wlan0", "wifi", "no-carrier", "", "", "", "")
        }
        dbus.endArray(&writing, list, 8)
        _ = dbus.reply(client, request, "a(ssssssas)", fake.*.out, writing.length, nothing(), 0)
        return
    }
    if system.same(member, "Networks") {
        const list = dbus.beginArray(&writing, 8)
        var index: usize = 0
        while index < NETWORKS && !fake.*.wifiOff {
            dbus.pad(&writing, 8)
            dbus.putString(&writing, ssid(index))
            dbus.putU32(&writing, signal(index))
            dbus.putU32(&writing, frequency(index))
            dbus.putString(&writing, security(index))
            dbus.putString(&writing, if fake.*.problem[index] == 1 { "passphrase" } else { "" })
            dbus.putBool(&writing, fake.*.saved[index])
            dbus.putBool(&writing, fake.*.joined == index)
            index += 1
        }
        dbus.endArray(&writing, list, 8)
        _ = dbus.reply(client, request, "a(suussbb)", fake.*.out, writing.length, nothing(), 0)
        return
    }
    if system.same(member, "Connect") {
        const name = dbus.readString(&reading)
        const passphrase = dbus.readString(&reading)
        const index = find(name)
        print("connect ")
        print(name)
        var count: [24]u8 = undefined
        const count_bytes: [*]u8 = unsafe { @ptrCast([*]u8, &count) }
        var length = system.put(count_bytes, 0, " (")
        length = system.putNumber(count_bytes, length, @intCast(u64, passphrase.length))
        length = system.put(count_bytes, length, " bytes)\n")
        print(count_bytes[0..length])
        if index == NETWORKS {
            refuse(fake, request, "org.mlx.Network.Error.NotFound", "no such network in sight")
            return
        }
        if system.same(security(index), "wpa3") {
            refuse(fake, request, "org.mlx.Network.Error.Unsupported", "mlx-netd speaks open networks and WPA2-Personal only")
            return
        }
        if system.same(security(index), "wpa2") && passphrase.length == 0 && (!fake.*.saved[index] || fake.*.problem[index] != 0) {
            refuse(fake, request, "org.mlx.Network.Error.NeedsPassphrase", "the network needs a passphrase")
            return
        }
        if passphrase.length > 0 && (passphrase.length < 8 || passphrase.length > 63) {
            refuse(fake, request, "org.mlx.Network.Error.BadPassphrase", "a passphrase has 8 to 63 characters (or 64 hex digits)")
            return
        }
        fake.*.joined = NETWORKS
        fake.*.joining = index
        fake.*.dueAt = system.milliseconds() + 1000
        fake.*.right = passphrase.length == 0 || system.same(passphrase, RIGHT)
        fake.*.problem[index] = 0
        replyEmpty(fake, request)
        changed(fake)
        return
    }
    if system.same(member, "Disconnect") {
        print("disconnect\n")
        fake.*.joined = NETWORKS
        fake.*.joining = NETWORKS
        replyEmpty(fake, request)
        changed(fake)
        return
    }
    if system.same(member, "Forget") {
        const name = dbus.readString(&reading)
        const index = find(name)
        print("forget ")
        print(name)
        print("\n")
        if index == NETWORKS || !fake.*.saved[index] {
            refuse(fake, request, "org.mlx.Network.Error.NotFound", "no such saved network")
            return
        }
        fake.*.saved[index] = false
        if fake.*.joined == index { fake.*.joined = NETWORKS }
        replyEmpty(fake, request)
        changed(fake)
        return
    }
    if system.same(member, "Scan") {
        print("scan\n")
        replyEmpty(fake, request)
        return
    }
    if system.same(member, "Up") || system.same(member, "Down") {
        const name = dbus.readString(&reading)
        const on = system.same(member, "Up")
        print(if on { "up " } else { "down " })
        print(name)
        print("\n")
        if system.same(name, "wlan0") {
            fake.*.wifiOff = !on
            if !on {
                fake.*.joined = NETWORKS
                fake.*.joining = NETWORKS
            }
        } else if system.same(name, "eth0") {
            fake.*.cableOff = !on
        } else {
            refuse(fake, request, "org.mlx.Network.Error.NoSuchLink", "no such managed link")
            return
        }
        replyEmpty(fake, request)
        changed(fake)
        return
    }
    refuse(fake, request, "org.freedesktop.DBus.Error.UnknownMethod", "no such method")
}

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    var path: []const u8 = ""
    var name: []const u8 = NAME
    var answers = true
    var index: usize = 1
    while index + 1 < arguments.length {
        const argument = cString(arguments[index])
        if system.same(argument, "--bus") { path = cString(arguments[index + 1]) }
        if system.same(argument, "--as") {
            name = cString(arguments[index + 1])
            answers = false
        }
        index += 2
    }
    if path.length == 0 {
        const environment = std.process.environmentEntries(arguments)
        const value = std.process.environmentFrom(environment, "DBUS_SYSTEM_BUS_ADDRESS")
        if value != null {
            const address = cString(value.?.pointer)
            if address.length > 10 { path = address[10..address.length] }
        }
    }
    const memory = allocator.alloc(@sizeOf(Fake), 16)
    const out = allocator.alloc(SIZE, 16)
    if memory == null || out == null { return }
    const fake: *Fake = unsafe { @ptrCast(*Fake, memory.?) }
    fake.*.out = out.?
    fake.*.saved = [4]bool{ false, false, false, true }
    fake.*.problem = [4]u32{ 0, 0, 0, 0 }
    fake.*.joined = NETWORKS
    fake.*.joining = NETWORKS
    fake.*.wifiOff = false
    fake.*.cableOff = false
    if !dbus.connectClient(clientOf(fake), allocator, path) {
        system.say("fakenetd: no bus\n")
        return
    }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, fake.*.out, SIZE, false)
    dbus.putString(&writing, name)
    dbus.putU32(&writing, 4)
    const serial = dbus.call(clientOf(fake), BUS, BUS_PATH, BUS, "RequestName", "su", fake.*.out, writing.length)
    var reply: dbus.Header = undefined
    _ = dbus.waitReply(clientOf(fake), serial, &reply, 5000)
    print("fakenetd: ready\n")
    while !clientOf(fake).*.closed {
        var header: dbus.Header = undefined
        while dbus.next(clientOf(fake), &header, 100) {
            if header.kind == dbus.METHOD_CALL && answers { called(fake, &header) }
        }
        if fake.*.joining < NETWORKS && system.milliseconds() >= fake.*.dueAt {
            const index = fake.*.joining
            fake.*.joining = NETWORKS
            if fake.*.right {
                fake.*.joined = index
                fake.*.saved[index] = true
                print("joined ")
            } else {
                fake.*.problem[index] = 1
                print("refused ")
            }
            print(ssid(index))
            print("\n")
            changed(fake)
        }
    }
}
