// The crashes the desktop programs kept (examples/wayland-compositor/
// crash.mlx writes them to $XDG_STATE_HOME/mlx/crashes.log, else
// ~/.local/state/mlx/crashes.log), put on the declarations they went
// through. A line of the log is one crash:
//
//     crash <TAB> seconds <TAB> program <TAB> reason <TAB> frame <TAB> frame ...
//
// where a frame is path:line:function+0xOFFSET (the compiler's symbol
// table names functions so), or a file and an offset, or an address. The
// first frame is where it stopped, the others called it. A frame is put on
// the function declared at that line of that file (relative to the
// index's root); when the file has changed since, on the function of that
// name in it.
//
//     var crashes: crashes_module.Crashes = undefined
//     crashes_module.init(&crashes, allocator)
//     crashes_module.load(&crashes, index, path)
//     crashes_module.stoppedIn(&crashes, symbol) ...
const std = @import("std")
const index_module = @import("./index.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

// The log is read up to this size (its newest crashes, from the end).
pub const MAX_LOG: usize = 4194304
pub const MAX_RECORDS: usize = 4096
pub const MAX_FRAMES: usize = 65536

pub const Crashes = struct {
    allocator: Allocator
    index: *Index
    // The log's text; each crash is a line of it.
    text: [*]u8
    textLength: usize
    count: usize
    recordStart: [*]u32
    recordEnd: [*]u32
    // Every frame: its crash, how deep (0: where it stopped), its text and
    // its declaration (NONE when it names none known here).
    frameCount: usize
    frameRecord: [*]u32
    frameDepth: [*]u32
    frameStart: [*]u32
    frameEnd: [*]u32
    frameSymbol: [*]u32
    // Per symbol: crashes that stopped in it, that went through it (it had
    // called what stopped), and the newest of either (NONE: none).
    stopped: [*]u32
    through: [*]u32
    latest: [*]u32
    symbolCapacity: usize
}

pub fn init(crashes: *Crashes, allocator: Allocator) -> void {
    crashes.*.allocator = allocator
    crashes.*.text = allocator.alloc(MAX_LOG + 1, 16).?
    crashes.*.textLength = 0
    crashes.*.count = 0
    crashes.*.recordStart = allocator.words(MAX_RECORDS)
    crashes.*.recordEnd = allocator.words(MAX_RECORDS)
    crashes.*.frameCount = 0
    crashes.*.frameRecord = allocator.words(MAX_FRAMES)
    crashes.*.frameDepth = allocator.words(MAX_FRAMES)
    crashes.*.frameStart = allocator.words(MAX_FRAMES)
    crashes.*.frameEnd = allocator.words(MAX_FRAMES)
    crashes.*.frameSymbol = allocator.words(MAX_FRAMES)
    crashes.*.symbolCapacity = 0
}

// Where the log is: $XDG_STATE_HOME/mlx/crashes.log, else
// $HOME/.local/state/mlx/crashes.log (written into `into`, 4096 bytes);
// its length, 0 when neither is set.
pub fn logPath(environment: [*][*]const u8, into: [*]u8) -> usize {
    var length: usize = 0
    const state = variable(environment, "XDG_STATE_HOME")
    if state.length > 0 && state[0] == 47 {
        length = append(into, length, state)
    } else {
        const home = variable(environment, "HOME")
        if home.length == 0 { return 0 }
        length = append(into, length, home)
        length = append(into, length, "/.local/state")
    }
    length = append(into, length, "/mlx/crashes.log")
    into[length] = 0
    return length
}

fn append(into: [*]u8, length: usize, text: []const u8) -> usize {
    var at = length
    for byte in text {
        if at < 4000 {
            into[at] = byte
            at += 1
        }
    }
    return at
}

fn variable(environment: [*][*]const u8, name: []const u8) -> []const u8 {
    var entry: usize = 0
    while @intFromPtr(environment[entry]) != 0 {
        const text = environment[entry]
        var matches = true
        var length: usize = 0
        for byte in name {
            if matches && text[length] != byte { matches = false }
            if matches { length += 1 }
        }
        if matches && text[length] == 61 {
            var end = length + 1
            while text[end] != 0 { end += 1 }
            return text[length + 1..end]
        }
        entry += 1
    }
    return ""
}

// Reads the log at `path` (NUL-terminated) and puts its crashes on the
// declarations of `index` (as built). A missing log is no crashes.
pub fn load(crashes: *Crashes, index: *Index, path: [*]const u8) -> void {
    crashes.*.index = index
    crashes.*.count = 0
    crashes.*.frameCount = 0
    crashes.*.textLength = 0
    ensureSymbols(crashes, index.*.symbolCount)
    var at: usize = 0
    while at < index.*.symbolCount {
        crashes.*.stopped[at] = 0
        crashes.*.through[at] = 0
        crashes.*.latest[at] = NONE
        at += 1
    }
    readLog(crashes, path)
    // The lines.
    var start: usize = 0
    while start < crashes.*.textLength && crashes.*.count < MAX_RECORDS {
        var end = start
        while end < crashes.*.textLength && crashes.*.text[end] != 10 { end += 1 }
        if end - start > 6 && index_module.sameBytes(crashes.*.text[start..start + 6], "crash\t") {
            addRecord(crashes, start, end)
        }
        start = end + 1
    }
}

fn ensureSymbols(crashes: *Crashes, count: usize) -> void {
    if count <= crashes.*.symbolCapacity { return }
    const capacity = count + count / 2 + 1024
    crashes.*.stopped = crashes.*.allocator.words(capacity)
    crashes.*.through = crashes.*.allocator.words(capacity)
    crashes.*.latest = crashes.*.allocator.words(capacity)
    crashes.*.symbolCapacity = capacity
}

// The log's last MAX_LOG bytes (from the start of a line).
fn readLog(crashes: *Crashes, path: [*]const u8) -> void {
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return }
    var status: std.fs.Stat = undefined
    if std.fs.fileStatus(file, &status) != 0 || status.size <= 0 {
        const closed = std.fs.close(file)
        return
    }
    const size = @intCast(usize, status.size)
    const from = if size > MAX_LOG { size - MAX_LOG } else { 0 }
    var got: usize = 0
    while got < size - from {
        var chunk: [*]u8 = undefined
        unsafe { chunk = @ptrFromInt([*]u8, @intFromPtr(crashes.*.text) + got) }
        const count = std.fs.pread(file, chunk, size - from - got, from + got)
        if count <= 0 { break }
        got += @intCast(usize, count)
    }
    const closed = std.fs.close(file)
    var skip: usize = 0
    if from > 0 {
        while skip < got && crashes.*.text[skip] != 10 { skip += 1 }
        skip += 1
    }
    if skip > 0 && skip < got {
        var at: usize = 0
        while at + skip < got {
            crashes.*.text[at] = crashes.*.text[at + skip]
            at += 1
        }
    }
    crashes.*.textLength = if skip < got { got - skip } else { 0 }
}

fn addRecord(crashes: *Crashes, start: usize, end: usize) -> void {
    const record = crashes.*.count
    crashes.*.recordStart[record] = @intCast(u32, start)
    crashes.*.recordEnd[record] = @intCast(u32, end)
    crashes.*.count += 1
    // Fields: crash, time, program, reason, then the frames.
    var field: usize = 0
    var field_start = start
    var at = start
    var depth: usize = 0
    while at <= end {
        if at == end || crashes.*.text[at] == 9 {
            if field >= 4 && at > field_start && crashes.*.frameCount < MAX_FRAMES {
                addFrame(crashes, record, depth, field_start, at)
                depth += 1
            }
            field += 1
            field_start = at + 1
        }
        at += 1
    }
}

fn addFrame(crashes: *Crashes, record: usize, depth: usize, start: usize, end: usize) -> void {
    const frame = crashes.*.frameCount
    crashes.*.frameCount += 1
    crashes.*.frameRecord[frame] = @intCast(u32, record)
    crashes.*.frameDepth[frame] = @intCast(u32, depth)
    crashes.*.frameStart[frame] = @intCast(u32, start)
    crashes.*.frameEnd[frame] = @intCast(u32, end)
    const symbol = symbolOfFrame(crashes, crashes.*.text[start..end])
    crashes.*.frameSymbol[frame] = symbol
    if symbol == NONE { return }
    // A recursion lists a function several times; it counts once a crash.
    if crashes.*.latest[symbol] == @intCast(u32, record) { return }
    if depth == 0 {
        crashes.*.stopped[symbol] += 1
    } else {
        crashes.*.through[symbol] += 1
    }
    crashes.*.latest[symbol] = @intCast(u32, record)
}

// The function a frame (path:line:name+0xOFFSET) names, or NONE.
pub fn symbolOfFrame(crashes: *Crashes, frame: []const u8) -> u32 {
    return declarationOf(crashes.*.index, frame)
}

// The function `name` (path:line:function, with or without +0xOFFSET, as
// the compiler's symbol table names it) is, or NONE.
pub fn declarationOf(index: *Index, frame: []const u8) -> u32 {
    var end = frame.length
    var at = frame.length
    while at > 0 {
        at -= 1
        if frame[at] == 43 {
            end = at
            break
        }
    }
    // name, line and path, from the end.
    var name_start = end
    while name_start > 0 && frame[name_start - 1] != 58 { name_start -= 1 }
    if name_start < 2 { return NONE }
    var line_start = name_start - 1
    while line_start > 0 && frame[line_start - 1] != 58 { line_start -= 1 }
    if line_start < 2 { return NONE }
    var line: usize = 0
    at = line_start
    while at < name_start - 1 {
        if frame[at] < 48 || frame[at] > 57 { return NONE }
        line = line * 10 + @intCast(usize, frame[at] - 48)
        at += 1
    }
    const file = fileOfPath(index, frame[0..line_start - 1])
    if file == NONE || line == 0 { return NONE }
    const name = frame[name_start..end]
    const file_symbol = index_module.fileAt(index, file).*.symbol
    const exact = functionIn(index, file_symbol, name, line - 1, 0)
    if exact != NONE { return exact }
    return functionIn(index, file_symbol, name, 18446744073709551615, 0)
}

// The file a frame's path names: relative to the root, or absolute.
fn fileOfPath(index: *Index, path: []const u8) -> u32 {
    if path.length > 0 && path[0] == 47 { return index_module.findFile(index, path) }
    const root = index.*.root[0..index.*.rootLength]
    if root.length + 1 + path.length > 4000 { return NONE }
    var joined: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &joined) }
    var length = append(bytes, 0, root)
    bytes[length] = 47
    length = append(bytes, length + 1, path)
    return index_module.findFile(index, bytes[0..length])
}

// The function called `name` under `container` whose name is on 0-based
// `line` (any line: the first of that name).
fn functionIn(index: *Index, container: u32, name: []const u8, line: usize, depth: usize) -> u32 {
    if container == NONE || depth > 4 { return NONE }
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != NONE {
        const value = index_module.symbolAt(index, child)
        if value.*.kind == index_module.FUNCTION && index_module.sameBytes(index_module.nameOf(index, child), name) {
            if line == 18446744073709551615 || index_module.lineOf(index, value.*.file, @intCast(usize, value.*.nameStart)) == line { return child }
        }
        if value.*.kind == index_module.STRUCT || value.*.kind == index_module.ENUM || value.*.kind == index_module.UNION || value.*.kind == index_module.CONST {
            const inner = functionIn(index, child, name, line, depth + 1)
            if inner != NONE { return inner }
        }
        child = value.*.nextSibling
    }
    return NONE
}

// ---------------------------------------------------------------------------
// Asking

pub fn stoppedIn(crashes: *Crashes, symbol: u32) -> u32 {
    if @intCast(usize, symbol) >= crashes.*.symbolCapacity { return 0 }
    return crashes.*.stopped[symbol]
}

pub fn wentThrough(crashes: *Crashes, symbol: u32) -> u32 {
    if @intCast(usize, symbol) >= crashes.*.symbolCapacity { return 0 }
    return crashes.*.through[symbol]
}

// The newest crash that stopped in or went through `symbol`; NONE: none.
pub fn latestOf(crashes: *Crashes, symbol: u32) -> u32 {
    if @intCast(usize, symbol) >= crashes.*.symbolCapacity { return NONE }
    return crashes.*.latest[symbol]
}

// Field `field` of crash `record` (1: the time, 2: the program, 3: the
// reason, 4 on: the frames).
pub fn field(crashes: *Crashes, record: u32, field_index: usize) -> []const u8 {
    const start = @intCast(usize, crashes.*.recordStart[record])
    const end = @intCast(usize, crashes.*.recordEnd[record])
    var at = start
    var current: usize = 0
    var field_start = start
    while at <= end {
        if at == end || crashes.*.text[at] == 9 {
            if current == field_index { return crashes.*.text[field_start..at] }
            current += 1
            field_start = at + 1
        }
        at += 1
    }
    return ""
}

pub fn timeOf(crashes: *Crashes, record: u32) -> u64 {
    var value: u64 = 0
    for byte in field(crashes, record, 1) {
        if byte >= 48 && byte <= 57 { value = value * 10 + @intCast(u64, byte - 48) }
    }
    return value
}

// The first frame of crash `record` (NONE: none).
pub fn firstFrame(crashes: *Crashes, record: u32) -> usize {
    var frame: usize = 0
    while frame < crashes.*.frameCount {
        if crashes.*.frameRecord[frame] == record { return frame }
        frame += 1
    }
    return 18446744073709551615
}

// Where a frame's address is exactly: the "path:line" after " at " (the
// compiler's line table), or nothing.
pub fn frameWhere(text: []const u8) -> []const u8 {
    var at = text.length
    while at >= 4 {
        at -= 1
        if text[at - 3] == 32 && text[at - 2] == 97 && text[at - 1] == 116 && text[at] == 32 { return text[at + 1..text.length] }
        if at == 3 { break }
    }
    return ""
}

pub fn frameText(crashes: *Crashes, frame: usize) -> []const u8 {
    return crashes.*.text[@intCast(usize, crashes.*.frameStart[frame])..@intCast(usize, crashes.*.frameEnd[frame])]
}

// The declarations crashes stopped in or went through, the most crashes
// first (stopping in counts more), into `into`; how many.
pub fn ranked(crashes: *Crashes, into: [*]u32) -> usize {
    var count: usize = 0
    var symbol: usize = 0
    while symbol < crashes.*.index.*.symbolCount && symbol < crashes.*.symbolCapacity {
        if crashes.*.latest[symbol] != NONE {
            into[count] = @intCast(u32, symbol)
            count += 1
        }
        symbol += 1
    }
    // Insertion sort: few declarations crash.
    var at: usize = 1
    while at < count {
        const value = into[at]
        const weight = score(crashes, value)
        var place = at
        while place > 0 && score(crashes, into[place - 1]) < weight {
            into[place] = into[place - 1]
            place -= 1
        }
        into[place] = value
        at += 1
    }
    return count
}

fn score(crashes: *Crashes, symbol: u32) -> u64 {
    return @intCast(u64, crashes.*.stopped[symbol]) * 1000 + @intCast(u64, crashes.*.through[symbol])
}
