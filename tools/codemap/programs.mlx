// The programs of the code base and what each of them reaches: every file
// with a `main` function is one (outside tests/), and what its main uses,
// and what that uses, and so on, is what the program is made of. Exported
// functions are reached too (C code and signal handlers call them).
//
// Checks are programs of their own kind. They are the files under tests/
// with a main, check_*.mlx files, test blocks, and the programs the check
// scripts (tools/check_*.sh, tests/run_*.sh) build. What no check reaches
// is untested; what no program and no check reaches is unreachable (dead
// code, however often it is used by other dead code).
//
// The reach is worked out on the code index: a use in a declaration
// reaches what it names. Calls the index cannot follow (through function
// pointers stored at run time) are not seen.
//
//     var programs: programs_module.Programs = undefined
//     programs_module.init(&programs, allocator)
//     programs_module.run(&programs, index)
//     programs_module.reaches(&programs, program, symbol) ...
const std = @import("std")
const index_module = @import("./index.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

// Programs, at most (the checks take one more bit): two words of bits per
// symbol.
pub const MAX_PROGRAMS: usize = 127
// The bit of the checks.
pub const CHECKS: usize = 127

pub const Programs = struct {
    index: *Index
    allocator: Allocator
    count: usize
    // Each program's file and main (by symbol), and its name (a path under
    // the root without examples/, tools/ and /main.mlx).
    file: [127]u32
    main: [127]u32
    // Per symbol: a bit per program that reaches it (CHECKS: a check), in
    // two words.
    reached: [*]u64
    capacity: usize
    // What each declaration uses: the targets of `from`, in runs.
    starts: [*]u32
    targets: [*]u32
    queue: [*]u32
    // The files the check scripts build (by file symbol).
    scripted: [*]u32
    scriptedCount: usize
    // How many declarations each program reaches.
    size: [127]usize
}

pub fn init(programs: *Programs, allocator: Allocator) -> void {
    programs.*.allocator = allocator
    programs.*.count = 0
    programs.*.capacity = 0
    programs.*.scripted = allocator.words(1024)
    programs.*.scriptedCount = 0
}

// A function or a declaration that can be reached (not locals).
fn isDeclaration(kind: u8) -> bool {
    return kind == index_module.FUNCTION || kind == index_module.CONST || kind == index_module.VAR || kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.ERROR_SET || kind == index_module.FIELD || kind == index_module.MEMBER || kind == index_module.TEST || kind == index_module.ALIAS
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && index_module.sameBytes(text[0..prefix.length], prefix)
}

fn endsWith(text: []const u8, suffix: []const u8) -> bool {
    return text.length >= suffix.length && index_module.sameBytes(text[text.length - suffix.length..text.length], suffix)
}

fn contains(text: []const u8, part: []const u8) -> bool {
    if part.length > text.length { return false }
    var at: usize = 0
    while at + part.length <= text.length {
        if index_module.sameBytes(text[at..at + part.length], part) { return true }
        at += 1
    }
    return false
}

// A path relative to the index's root.
pub fn relativePath(index: *Index, file: u32) -> []const u8 {
    const path = index_module.pathOf(index, file)
    const root = index.*.root[0..index.*.rootLength]
    if path.length > root.length + 1 && index_module.sameBytes(path[0..root.length], root) && path[root.length] == 47 { return path[root.length + 1..path.length] }
    return path
}

// Whether a file is a check: under tests/, or called check_*.mlx or
// *_test.mlx.
pub fn isCheckFile(index: *Index, file: u32) -> bool {
    const path = relativePath(index, file)
    if startsWith(path, "tests/") || contains(path, "/tests/") { return true }
    var base: usize = path.length
    while base > 0 && path[base - 1] != 47 { base -= 1 }
    const name = path[base..path.length]
    return startsWith(name, "check_") || endsWith(name, "_test.mlx")
}

// The program's name: its path without examples/, tools/ and /main.mlx.
pub fn nameOf(programs: *Programs, program: usize) -> []const u8 {
    const path = relativePath(programs.*.index, programs.*.file[program])
    var start: usize = 0
    if startsWith(path, "examples/") { start = 9 } else if startsWith(path, "tools/") { start = 6 }
    var end = path.length
    if endsWith(path, "/main.mlx") { end = path.length - 9 } else if endsWith(path, ".mlx") { end = path.length - 4 }
    if end <= start { return path }
    return path[start..end]
}

// The program whose main is in `path` (relative to the root); none: the
// count.
pub fn programOfPath(programs: *Programs, path: []const u8) -> usize {
    var program: usize = 0
    while program < programs.*.count {
        if index_module.sameBytes(relativePath(programs.*.index, programs.*.file[program]), path) { return program }
        program += 1
    }
    return programs.*.count
}

pub fn reaches(programs: *Programs, program: usize, symbol: u32) -> bool {
    if symbol == NONE || @intCast(usize, symbol) >= programs.*.capacity { return false }
    return has(programs, @intCast(usize, symbol), program)
}

fn has(programs: *Programs, symbol: usize, bit: usize) -> bool {
    return programs.*.reached[symbol * 2 + bit / 64] & (@intCast(u64, 1) << @intCast(u64, bit % 64)) != 0
}

fn set(programs: *Programs, symbol: usize, bit: usize) -> void {
    programs.*.reached[symbol * 2 + bit / 64] = programs.*.reached[symbol * 2 + bit / 64] | (@intCast(u64, 1) << @intCast(u64, bit % 64))
}

// Whether any program (not a check) reaches `symbol`.
pub fn anyProgram(programs: *Programs, symbol: u32) -> bool {
    if symbol == NONE || @intCast(usize, symbol) >= programs.*.capacity { return false }
    const at = @intCast(usize, symbol) * 2
    return programs.*.reached[at] != 0 || programs.*.reached[at + 1] & 9223372036854775807 != 0
}

// Whether any check reaches `symbol`.
pub fn checked(programs: *Programs, symbol: u32) -> bool { return reaches(programs, CHECKS, symbol) }

// Whether any program or check reaches `symbol`.
pub fn reachedAtAll(programs: *Programs, symbol: u32) -> bool { return anyProgram(programs, symbol) || checked(programs, symbol) }

// A function nothing reaches (in a file that is not generated): dead code.
pub fn isUnreachable(programs: *Programs, symbol: u32) -> bool {
    const index = programs.*.index
    const value = index_module.symbolAt(index, symbol)
    if value.*.kind != index_module.FUNCTION || reachedAtAll(programs, symbol) { return false }
    if contains(index_module.pathOf(index, value.*.file), "/generated/") { return false }
    // Inside a function (a nested one) or a test: its container decides.
    return true
}

// A function a program reaches and no check does.
pub fn isUntested(programs: *Programs, symbol: u32) -> bool {
    const index = programs.*.index
    const value = index_module.symbolAt(index, symbol)
    if value.*.kind != index_module.FUNCTION { return false }
    return anyProgram(programs, symbol) && !checked(programs, symbol)
}

pub fn run(programs: *Programs, index: *Index) -> void {
    programs.*.index = index
    programs.*.count = 0
    const symbol_count = index.*.symbolCount
    if symbol_count + 1 > programs.*.capacity {
        const capacity = symbol_count + symbol_count / 2 + 1024
        unsafe { programs.*.reached = @ptrCast([*]u64, programs.*.allocator.alloc(capacity * 16 + 16, 16).?) }
        programs.*.starts = programs.*.allocator.words(capacity + 1)
        programs.*.queue = programs.*.allocator.words(capacity)
        programs.*.capacity = capacity
    }
    var symbol: usize = 0
    while symbol < symbol_count * 2 {
        programs.*.reached[symbol] = 0
        symbol += 1
    }
    makeEdges(programs)
    findPrograms(programs)
    readScripts(programs)
    // Each program from its main and its exports.
    var program: usize = 0
    while program < programs.*.count {
        const bit = program
        var queued: usize = 0
        queued = push(programs, programs.*.main[program], bit, queued)
        queued = pushExports(programs, programs.*.file[program], bit, queued)
        programs.*.size[program] = spread(programs, bit, queued)
        program += 1
    }
    // The checks.
    const check_bit = CHECKS
    var queued: usize = 0
    symbol = 0
    while symbol < symbol_count {
        const value = index_module.symbolAt(index, @intCast(u32, symbol))
        if value.*.kind == index_module.TEST {
            queued = push(programs, @intCast(u32, symbol), check_bit, queued)
        } else if value.*.kind == index_module.FUNCTION && value.*.parent != NONE && index_module.symbolAt(index, value.*.parent).*.kind == index_module.FILE && index_module.sameBytes(index_module.nameOf(index, @intCast(u32, symbol)), "main") {
            if isCheckFile(index, value.*.file) || isScripted(programs, value.*.file) {
                queued = push(programs, @intCast(u32, symbol), check_bit, queued)
                queued = pushExports(programs, value.*.file, check_bit, queued)
            }
        }
        symbol += 1
    }
    const reached_by_checks = spread(programs, check_bit, queued)
}

// The uses, as edges from the declaration a use is in to what it names
// (counting sort by the user).
fn makeEdges(programs: *Programs) -> void {
    const index = programs.*.index
    const symbol_count = index.*.symbolCount
    var at: usize = 0
    while at <= symbol_count {
        programs.*.starts[at] = 0
        at += 1
    }
    var total: usize = 0
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if edgeOf(index, value) {
            programs.*.starts[@intCast(usize, value.*.from) + 1] += 1
            total += 1
        }
        ref += 1
    }
    at = 0
    while at < symbol_count {
        programs.*.starts[at + 1] += programs.*.starts[at]
        at += 1
    }
    programs.*.targets = programs.*.allocator.words(total + 1)
    // Fill (the starts move on as they fill, and are put back after).
    ref = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if edgeOf(index, value) {
            const from = @intCast(usize, value.*.from)
            programs.*.targets[programs.*.starts[from]] = value.*.symbol
            programs.*.starts[from] += 1
        }
        ref += 1
    }
    at = symbol_count
    while at > 0 {
        programs.*.starts[at] = programs.*.starts[at - 1]
        at -= 1
    }
    programs.*.starts[0] = 0
}

fn edgeOf(index: *Index, ref: *index_module.Ref) -> bool {
    if ref.*.use == index_module.USE_DECLARATION || ref.*.from == NONE || ref.*.symbol == NONE || ref.*.from == ref.*.symbol { return false }
    return isDeclaration(index_module.symbolAt(index, ref.*.symbol).*.kind)
}

fn push(programs: *Programs, symbol: u32, bit: usize, queued: usize) -> usize {
    if symbol == NONE || has(programs, @intCast(usize, symbol), bit) { return queued }
    set(programs, @intCast(usize, symbol), bit)
    programs.*.queue[queued] = symbol
    return queued + 1
}

// The exported functions of `file` (a program's own, and those of the
// files it imports are reached through their uses).
fn pushExports(programs: *Programs, file: u32, bit: usize, queued: usize) -> usize {
    const index = programs.*.index
    var count = queued
    // Every exported function of the index is an entry point for every
    // program that reaches its file; the program's own file first.
    var child = index_module.symbolAt(index, index_module.fileAt(index, file).*.symbol).*.firstChild
    while child != NONE {
        if isExported(index, child) { count = push(programs, child, bit, count) }
        child = index_module.symbolAt(index, child).*.nextSibling
    }
    return count
}

// Whether `export` is among the declaration's modifiers.
pub fn isExported(index: *Index, symbol: u32) -> bool {
    const value = index_module.symbolAt(index, symbol)
    if value.*.kind != index_module.FUNCTION || value.*.firstToken == NONE { return false }
    const start = index_module.tokenAt(index, value.*.file, @intCast(usize, value.*.firstToken)).start
    const source = index_module.sourceOf(index, value.*.file)
    const end = @intCast(usize, value.*.nameStart)
    if end <= start || end > source.length { return false }
    return contains(source[start..end], "export ")
}

// Reaches on from the queued declarations: what they use, the exports of
// the files they are in, and what holds them. How many it reached.
fn spread(programs: *Programs, bit: usize, queued: usize) -> usize {
    const index = programs.*.index
    var count = queued
    var at: usize = 0
    while at < count {
        const symbol = programs.*.queue[at]
        const from = @intCast(usize, symbol)
        var edge = @intCast(usize, programs.*.starts[from])
        const end = @intCast(usize, programs.*.starts[from + 1])
        while edge < end {
            count = push(programs, programs.*.targets[edge], bit, count)
            edge += 1
        }
        // The first time a file is reached, its exports come with it.
        const value = index_module.symbolAt(index, symbol)
        const file_symbol = index_module.fileAt(index, value.*.file).*.symbol
        if file_symbol != NONE && !has(programs, @intCast(usize, file_symbol), bit) {
            set(programs, @intCast(usize, file_symbol), bit)
            count = pushExports(programs, value.*.file, bit, count)
        }
        // What holds a member (a struct for its method or field).
        const parent = value.*.parent
        if parent != NONE && isDeclaration(index_module.symbolAt(index, parent).*.kind) { count = push(programs, parent, bit, count) }
        at += 1
    }
    return count
}

// Every file with a main function, outside the checks.
fn findPrograms(programs: *Programs) -> void {
    const index = programs.*.index
    var file: usize = 0
    while file < index.*.fileCount && programs.*.count < MAX_PROGRAMS {
        const id = @intCast(u32, file)
        const path = index_module.pathOf(index, id)
        if !isCheckFile(index, id) && !contains(path, "/generated/") {
            var child = index_module.symbolAt(index, index_module.fileAt(index, id).*.symbol).*.firstChild
            while child != NONE {
                const value = index_module.symbolAt(index, child)
                if value.*.kind == index_module.FUNCTION && index_module.sameBytes(index_module.nameOf(index, child), "main") {
                    programs.*.file[programs.*.count] = id
                    programs.*.main[programs.*.count] = child
                    programs.*.count += 1
                    break
                }
                child = value.*.nextSibling
            }
        }
        file += 1
    }
}

fn isScripted(programs: *Programs, file: u32) -> bool {
    var at: usize = 0
    while at < programs.*.scriptedCount {
        if programs.*.scripted[at] == file { return true }
        at += 1
    }
    return false
}

// The .mlx files the check scripts name (tools/check_*.sh, tests/run_*.sh).
fn readScripts(programs: *Programs) -> void {
    programs.*.scriptedCount = 0
    readScriptsIn(programs, "tools", "check_")
    readScriptsIn(programs, "tests", "run_")
}

fn readScriptsIn(programs: *Programs, directory: []const u8, prefix: []const u8) -> void {
    const index = programs.*.index
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    const root = index.*.root[0..index.*.rootLength]
    var length: usize = 0
    for byte in root {
        bytes[length] = byte
        length += 1
    }
    bytes[length] = 47
    length += 1
    for byte in directory {
        bytes[length] = byte
        length += 1
    }
    bytes[length] = 0
    const handle = std.linux.syscall3(2, @intFromPtr(bytes), 65536, 0)
    if handle < 0 { return }
    var entries: [8192]u8 = undefined
    var entry_bytes: [*]u8 = undefined
    unsafe { entry_bytes = @ptrCast([*]u8, &entries) }
    while true {
        const got = std.linux.syscall3(217, @bitCast(usize, handle), @intFromPtr(entry_bytes), 8192)
        if got <= 0 { break }
        var at: usize = 0
        while at < @bitCast(usize, got) {
            const record_length = @intCast(usize, entry_bytes[at + 16]) | (@intCast(usize, entry_bytes[at + 17]) << 8)
            var name_end = at + 19
            while entry_bytes[name_end] != 0 { name_end += 1 }
            const name = entry_bytes[at + 19..name_end]
            if startsWith(name, prefix) && endsWith(name, ".sh") {
                var file_path = length
                bytes[file_path] = 47
                file_path += 1
                for byte in name {
                    bytes[file_path] = byte
                    file_path += 1
                }
                bytes[file_path] = 0
                readScript(programs, bytes)
            }
            at += record_length
        }
    }
    const closed = std.linux.syscall1(3, @bitCast(usize, handle))
}

// The .mlx paths in one script (words ending in .mlx, relative to the
// root).
fn readScript(programs: *Programs, path: [*]const u8) -> void {
    const index = programs.*.index
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return }
    var text: [65536]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &text) }
    var got: usize = 0
    while got < 65536 {
        var chunk: [*]u8 = undefined
        unsafe { chunk = @ptrFromInt([*]u8, @intFromPtr(bytes) + got) }
        const count = std.fs.read(file, chunk, 65536 - got)
        if count <= 0 { break }
        got += @intCast(usize, count)
    }
    const closed = std.fs.close(file)
    var at: usize = 0
    while at + 4 <= got {
        if bytes[at] == 46 && bytes[at + 1] == 109 && bytes[at + 2] == 108 && bytes[at + 3] == 120 {
            var start = at
            while start > 0 && isPathByte(bytes[start - 1]) { start -= 1 }
            const found = fileOfRelative(index, bytes[start..at + 4])
            if found != NONE && !isScripted(programs, found) && programs.*.scriptedCount < 1024 {
                programs.*.scripted[programs.*.scriptedCount] = found
                programs.*.scriptedCount += 1
            }
        }
        at += 1
    }
}

fn isPathByte(byte: u8) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95 || byte == 45 || byte == 47 || byte == 46
}

// The file at `path` relative to the root (NONE: not in the index).
pub fn fileOfRelative(index: *Index, path: []const u8) -> u32 {
    const root = index.*.root[0..index.*.rootLength]
    if root.length + 1 + path.length > 4000 { return NONE }
    var joined: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &joined) }
    var length: usize = 0
    for byte in root {
        bytes[length] = byte
        length += 1
    }
    bytes[length] = 47
    length += 1
    for byte in path {
        bytes[length] = byte
        length += 1
    }
    return index_module.findFile(index, bytes[0..length])
}
