// C and C++ in the code index: what mlx-cc resolved while it compiled
// (`mlx-cc --index=DIR`, MLX_CC_INDEX=DIR; compiler/cc/index.mlx says what
// a shard holds), joined to the Mlx graph. Every C or C++ file of the
// shards becomes a file of the index (its text read, not parsed here),
// every declaration a symbol (a function, a variable, a class or union, a
// data member, a macro) and every use a use of it, so the commands answer
// for C, C++ and Mlx alike: find, show (the source of the declaration,
// its definition's body), def, refs, callers, callees, members, outline,
// imports and importers (#include), unused, hot, crashes.
//
// Where the shards are: ROOT/mlx-out/codemap/cpp (tools/codemap_index.sh
// and `mlx build codemap-cpp-index` write there; a whole build does with
// MLX_CC_INDEX=mlx-out/codemap/cpp) and the directories of
// MLX_CODEMAP_CPP (colon-separated). Of a file's shards the one made of
// its text as it is now is taken (else any: its places may be off).
//
// A symbol is known by where its name is declared, and a function also by
// the name the linker knows: the declarations of one function in a header
// and in each unit, and its definition in a source file, are one symbol
// (its place the first declaration, its definition's place and body kept
// beside it). A template's instances are its own (mlx-cc reads them from
// its text). Qualified names come from the linker's name (demangled,
// without parameters or template arguments) or the classes around:
// `WebCore::FontCache::createFontPlatformData` finds it, as do
// `FontCache::createFontPlatformData`, the plain name, the mangled name
// and `path:name`.
//
// Across the languages: a C declaration (mlx-cheaders' headers declare
// what Mlx exports) of a function an Mlx `export fn` defines is that Mlx
// function: the C and C++ calls of it are its callers. An Mlx `extern`
// function a C or C++ file defines is that definition: its Mlx calls are
// the C function's.
//
// A use's function (callers, callees) is the function whose definition
// holds it: its name's line to the end of its body, found by matching the
// braces of the text.
const std = @import("std")
const demangle = @import("std.demangle")
const diagnostics = @import("std.diagnostics")
const index_module = @import("./index.mlx")

const Index = index_module.Index
const NONE = index_module.NONE

// A C or C++ symbol's own: the linker's name, the qualified name, the
// demangled signature (all in the arena), its definition's body and name.
pub const Info = struct {
    link: usize
    linkLength: u32
    qualified: usize
    qualifiedLength: u32
    signature: usize
    signatureLength: u32
    bodyFile: u32
    bodyOffset: u32
    bodyEnd: u32
    defFile: u32
    defOffset: u32
    parentFile: u32
    parentOffset: u32
    regionStart: u32
}

pub const State = struct {
    infoOf: [*]u32
    infos: [*]Info
    infoCount: usize
    // Places (file << 32 | offset) and linker names (their hash) to
    // symbols, open-addressed.
    placeKeys: [*]u64
    placeValues: [*]u32
    placeMask: usize
    linkKeys: [*]u64
    linkValues: [*]u32
    linkMask: usize
    // The Mlx functions C may name (export and extern), by their name.
    mlxKeys: [*]u64
    mlxValues: [*]u32
    mlxMask: usize
    // The functions' extents, sorted: file << 44 | start << 20 | number,
    // and each one's end and symbol.
    regionKeys: [*]u64
    regionEnds: [*]u32
    regionSymbols: [*]u32
    regionCount: usize
    // The first C symbol and use; the shards read; the files.
    firstSymbol: usize
    firstRef: usize
    shardCount: usize
    fileCount: usize
}

const MAX_SHARDS: usize = 262144
const PLACE_SLOTS: usize = 8388608
const LINK_SLOTS: usize = 2097152
const MLX_SLOTS: usize = 65536
const MAX_REGIONS: usize = 1048576

pub fn stateOf(index: *Index) -> *State {
    return unsafe { @ptrFromInt(*State, index.*.cpp) }
}

pub fn isC(index: *Index, symbol: u32) -> bool {
    return index.*.cpp != 0 && @intCast(usize, symbol) >= stateOf(index).*.firstSymbol && symbol != NONE
}

pub fn infoOf(index: *Index, symbol: u32) -> *Info {
    const state = stateOf(index)
    const at = state.*.infoOf[symbol]
    return unsafe { @ptrFromInt(*Info, @intFromPtr(state.*.infos) + @intCast(usize, at) * @sizeOf(Info)) }
}

pub fn hasInfo(index: *Index, symbol: u32) -> bool {
    if !isC(index, symbol) { return false }
    return stateOf(index).*.infoOf[symbol] != NONE
}

fn textAt(address: usize, length: u32) -> []const u8 {
    const bytes: [*]const u8 = unsafe { @ptrFromInt([*]const u8, address) }
    return bytes[0..@intCast(usize, length)]
}

pub fn linkOf(index: *Index, symbol: u32) -> []const u8 {
    if !hasInfo(index, symbol) { return "" }
    const info = infoOf(index, symbol)
    return textAt(info.*.link, info.*.linkLength)
}

pub fn qualifiedOf(index: *Index, symbol: u32) -> []const u8 {
    if !hasInfo(index, symbol) { return index_module.nameOf(index, symbol) }
    const info = infoOf(index, symbol)
    if info.*.qualifiedLength == 0 { return index_module.nameOf(index, symbol) }
    return textAt(info.*.qualified, info.*.qualifiedLength)
}

pub fn signatureOf(index: *Index, symbol: u32) -> []const u8 {
    if !hasInfo(index, symbol) { return "" }
    const info = infoOf(index, symbol)
    return textAt(info.*.signature, info.*.signatureLength)
}

// ---------------------------------------------------------------------------
// Tables

fn hashOf(seed: u64, text: []const u8) -> u64 {
    var value = seed ^ 14695981039346656037
    for byte in text {
        value = (value ^ @intCast(u64, byte)) *% 1099511628211
    }
    return value | 1
}

fn mix(key: u64) -> usize { return @intCast(usize, (key *% 11400714819323198485) >> 20) }

fn put(keys: [*]u64, values: [*]u32, mask: usize, key: u64, value: u32) -> void {
    var slot = mix(key) & mask
    while keys[slot] != 0 && keys[slot] != key { slot = (slot + 1) & mask }
    keys[slot] = key
    values[slot] = value
}

fn get(keys: [*]u64, values: [*]u32, mask: usize, key: u64) -> u32 {
    var slot = mix(key) & mask
    while keys[slot] != 0 {
        if keys[slot] == key { return values[slot] }
        slot = (slot + 1) & mask
    }
    return NONE
}

fn placeKey(file: u32, offset: usize) -> u64 { return ((@intCast(u64, file) + 1) << 32) | @intCast(u64, offset) }

pub fn symbolAtPlace(index: *Index, file: u32, offset: usize) -> u32 {
    if index.*.cpp == 0 { return NONE }
    const state = stateOf(index)
    return get(state.*.placeKeys, state.*.placeValues, state.*.placeMask, placeKey(file, offset))
}

// The C or C++ function or variable whose linker name is `link`, NONE.
pub fn symbolOfLink(index: *Index, link: []const u8) -> u32 {
    if index.*.cpp == 0 || link.length == 0 { return NONE }
    const state = stateOf(index)
    return get(state.*.linkKeys, state.*.linkValues, state.*.linkMask, hashOf(0, link))
}

// ---------------------------------------------------------------------------
// Reading

fn allocate(index: *Index, bytes: usize) -> [*]u8 {
    return index.*.allocator.alloc(bytes, 16).?
}

fn sameBytes(first: []const u8, second: []const u8) -> bool { return index_module.sameBytes(first, second) }

// A file's text, whole (the arena's), and its length; 0 when unreadable.
fn readWhole(index: *Index, path: [*]const u8, length: *usize) -> usize {
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return 0 }
    var status: std.fs.Stat = undefined
    if std.fs.fileStatus(file, &status) != 0 || status.size < 0 {
        _ = std.fs.close(file)
        return 0
    }
    const size = @intCast(usize, status.size)
    const memory = allocate(index, size + 1)
    var got: usize = 0
    while got < size {
        const chunk: [*]u8 = memory + got
        const count = std.fs.read(file, chunk, size - got)
        if count <= 0 { break }
        got += @intCast(usize, count)
    }
    _ = std.fs.close(file)
    memory[got] = 0
    length.* = got
    return @intFromPtr(memory)
}

// A shard read: its file's path and hash (its own words), its text.
const Shard = struct {
    text: usize
    length: usize
    pathStart: usize
    pathLength: usize
    hash: u64
    file: u32
    chosen: bool
}

var shardsAt: usize = 0

fn shardAt(at: usize) -> *Shard {
    return unsafe { @ptrFromInt(*Shard, shardsAt + at * @sizeOf(Shard)) }
}

fn shardText(shard: *Shard) -> []const u8 { return textAt(shard.*.text, @intCast(u32, shard.*.length)) }

// The shards of directory `path` (NUL-ended in `buffer`, `length` long).
fn readDirectory(index: *Index, buffer: [*]u8, length: usize) -> void {
    const state = stateOf(index)
    buffer[length] = 0
    const handle = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(buffer), 65536 | 524288, 0)
    if handle < 0 { return }
    var entries: [16384]u8 = undefined
    const records: [*]u8 = &entries
    var reader = std.fs.entries(std.fs.File.{ .descriptor = handle }, records, 16384)
    var record: std.fs.Entry = undefined
    while std.fs.nextEntry(&reader, &record) {
        const name = record.name.pointer[0..record.name.length]
        if record.kind == 8 && name.length > 4 && sameBytes(name[name.length - 4..name.length], ".cxi") && length + name.length + 2 < 4000 && state.*.shardCount < MAX_SHARDS {
            buffer[length] = 47
            var at: usize = 0
            while at < name.length {
                buffer[length + 1 + at] = name[at]
                at += 1
            }
            buffer[length + 1 + name.length] = 0
            var size: usize = 0
            const text = readWhole(index, buffer, &size)
            if text != 0 && size > 20 {
                const shard = shardAt(state.*.shardCount)
                shard.*.text = text
                shard.*.length = size
                shard.*.file = NONE
                shard.*.chosen = false
                if header(shard) { state.*.shardCount += 1 }
            }
        }
    }
    std.linux.close(handle)
    buffer[length] = 0
}

// "mlx-cc index 1\nfile HASH PATH\n": the path and hash.
fn header(shard: *Shard) -> bool {
    const text = shardText(shard)
    if text.length < 22 || !sameBytes(text[0..15], "mlx-cc index 1\n") || !sameBytes(text[15..20], "file ") { return false }
    var at: usize = 20
    var hash: u64 = 0
    while at < text.length && text[at] != 32 {
        const c = text[at]
        const digit = if c >= 97 { c - 87 } else { c - 48 }
        hash = (hash << 4) | @intCast(u64, digit & 15)
        at += 1
    }
    at += 1
    const start = at
    while at < text.length && text[at] != 10 { at += 1 }
    shard.*.pathStart = start
    shard.*.pathLength = at - start
    shard.*.hash = hash
    return true
}

fn shardPath(shard: *Shard) -> []const u8 {
    return shardText(shard)[shard.*.pathStart..shard.*.pathStart + shard.*.pathLength]
}

fn contentHash(text: []const u8) -> u64 {
    var value: u64 = 14695981039346656037
    for byte in text {
        value = (value ^ @intCast(u64, byte)) *% 1099511628211
    }
    return value
}

// A C or C++ file of the index: its text read (not parsed), its lines.
fn addFile(index: *Index, path: []const u8) -> u32 {
    const known = index_module.findFile(index, path)
    if known != NONE { return known }
    if index.*.fileCount >= index_module.MAX_FILES { return NONE }
    const copy = allocate(index, path.length + 1)
    var at: usize = 0
    while at < path.length {
        copy[at] = path[at]
        at += 1
    }
    copy[path.length] = 0
    var length: usize = 0
    const source = readWhole(index, copy, &length)
    if source == 0 { return NONE }
    return index_module.addSourceOnly(index, path, copy, unsafe { @ptrFromInt([*]u8, source) }, length)
}

// ---------------------------------------------------------------------------
// Lines

// A cursor over a shard's text.
const Reader = struct {
    text: [*]const u8
    length: usize
    at: usize
}

fn number(reader: *Reader) -> usize {
    var value: usize = 0
    while reader.*.at < reader.*.length {
        const c = reader.*.text[reader.*.at]
        if c < 48 || c > 57 { break }
        value = value * 10 + @intCast(usize, c - 48)
        reader.*.at += 1
    }
    return value
}

fn skip(reader: *Reader, byte: u8) -> bool {
    if reader.*.at < reader.*.length && reader.*.text[reader.*.at] == byte {
        reader.*.at += 1
        return true
    }
    return false
}

fn word(reader: *Reader) -> []const u8 {
    const start = reader.*.at
    while reader.*.at < reader.*.length && reader.*.text[reader.*.at] != 32 && reader.*.text[reader.*.at] != 10 { reader.*.at += 1 }
    return reader.*.text[start..reader.*.at]
}

fn rest(reader: *Reader) -> []const u8 {
    const start = reader.*.at
    while reader.*.at < reader.*.length && reader.*.text[reader.*.at] != 10 { reader.*.at += 1 }
    return reader.*.text[start..reader.*.at]
}

fn nextLine(reader: *Reader) -> void {
    while reader.*.at < reader.*.length && reader.*.text[reader.*.at] != 10 { reader.*.at += 1 }
    if reader.*.at < reader.*.length { reader.*.at += 1 }
}

// The shard's files (its F lines): number -> file of the index.
var shardFiles: [*]u32 = undefined
var shardFileCapacity: usize = 0

fn readFiles(index: *Index, shard: *Shard) -> void {
    const text = shardText(shard)
    // The F lines are last.
    var count: usize = 0
    var at = text.length
    var reader = Reader.{ .text = text.pointer, .length = text.length, .at = 0 }
    shardFiles[0] = shard.*.file
    // From the end back to the first line that is not an F line.
    var line_end = text.length
    while line_end > 0 {
        var line_start = line_end - 1
        while line_start > 0 && text[line_start - 1] != 10 { line_start -= 1 }
        if line_start + 2 > text.length || text[line_start] != 70 || text[line_start + 1] != 32 { break }
        reader.at = line_start + 2
        const which = number(&reader)
        _ = skip(&reader, 32)
        const path = rest(&reader)
        if which < shardFileCapacity { shardFiles[which] = index_module.findFile(index, path) }
        if which > count { count = which }
        line_end = line_start
        at = line_start
    }
}

// FI:LINE:COLUMN at the reader: the file and offset; false for `-`.
fn place(index: *Index, reader: *Reader, file: *u32, offset: *usize) -> bool {
    if skip(reader, 45) { return false }
    const which = number(reader)
    if !skip(reader, 58) { return false }
    return lineColumn(index, reader, if which < shardFileCapacity { shardFiles[which] } else { NONE }, file, offset)
}

// LINE:COLUMN of file `given` at the reader.
fn lineColumn(index: *Index, reader: *Reader, given: u32, file: *u32, offset: *usize) -> bool {
    const line = number(reader)
    if !skip(reader, 58) { return false }
    const column = number(reader)
    if given == NONE || line == 0 || column == 0 { return false }
    file.* = given
    offset.* = index_module.offsetOf(index, given, line - 1, column - 1)
    return true
}

// ---------------------------------------------------------------------------
// Declarations

fn kindOf(letter: u8) -> u8 {
    return match letter {
        102 => index_module.FUNCTION,
        118 => index_module.VAR,
        99 => index_module.STRUCT,
        117 => index_module.UNION,
        100 => index_module.FIELD,
        109 => index_module.MACRO,
        else => index_module.CONST
    }
}

fn keep(index: *Index, text: []const u8) -> usize {
    const memory = allocate(index, text.length + 1)
    var at: usize = 0
    while at < text.length {
        memory[at] = text[at]
        at += 1
    }
    memory[text.length] = 0
    return @intFromPtr(memory)
}

fn newInfo(index: *Index, symbol: u32) -> *Info {
    const state = stateOf(index)
    state.*.infoOf[symbol] = @intCast(u32, state.*.infoCount)
    state.*.infoCount += 1
    const info = infoOf(index, symbol)
    info.*.link = 0
    info.*.linkLength = 0
    info.*.qualified = 0
    info.*.qualifiedLength = 0
    info.*.signature = 0
    info.*.signatureLength = 0
    info.*.bodyFile = NONE
    info.*.bodyOffset = 0
    info.*.bodyEnd = NONE
    info.*.defFile = NONE
    info.*.defOffset = 0
    info.*.parentFile = NONE
    info.*.parentOffset = 0
    info.*.regionStart = 0
    return info
}

// The Mlx function C names `name` (export, else extern), NONE.
fn mlxFunction(index: *Index, name: []const u8) -> u32 {
    const state = stateOf(index)
    return get(state.*.mlxKeys, state.*.mlxValues, state.*.mlxMask, hashOf(7, name))
}

fn declarations(index: *Index, shard: *Shard) -> void {
    const state = stateOf(index)
    const text = shardText(shard)
    var reader = Reader.{ .text = text.pointer, .length = text.length, .at = 0 }
    while reader.at < reader.length {
        if reader.text[reader.at] != 68 || reader.at + 2 >= reader.length {
            nextLine(&reader)
            continue
        }
        reader.at += 2
        var file: u32 = NONE
        var offset: usize = 0
        if !lineColumn(index, &reader, shard.*.file, &file, &offset) {
            nextLine(&reader)
            continue
        }
        _ = skip(&reader, 32)
        const length = number(&reader)
        _ = skip(&reader, 32)
        const letter = reader.text[reader.at]
        reader.at += 1
        _ = skip(&reader, 32)
        var parent_file: u32 = NONE
        var parent_offset: usize = 0
        const has_parent = place(index, &reader, &parent_file, &parent_offset)
        _ = skip(&reader, 32)
        const link = word(&reader)
        _ = skip(&reader, 32)
        var body_file: u32 = NONE
        var body_offset: usize = 0
        const has_body = place(index, &reader, &body_file, &body_offset)
        _ = skip(&reader, 32)
        var def_file: u32 = NONE
        var def_offset: usize = 0
        const has_def = place(index, &reader, &def_file, &def_offset)
        _ = skip(&reader, 32)
        const qualified = word(&reader)
        _ = skip(&reader, 32)
        const name = rest(&reader)
        nextLine(&reader)
        const key = placeKey(file, offset)
        if get(state.*.placeKeys, state.*.placeValues, state.*.placeMask, key) != NONE { continue }
        const has_link = link.length > 0 && !(link.length == 1 && link[0] == 45)
        // The same function declared elsewhere (by its linker name), or
        // an Mlx function C declares.
        var symbol = NONE
        if has_link {
            symbol = get(state.*.linkKeys, state.*.linkValues, state.*.linkMask, hashOf(0, link))
            if symbol == NONE && !demangle.isMangled(link) && (letter == 102 || letter == 118) {
                const mlx = mlxFunction(index, link)
                if mlx != NONE {
                    put(state.*.placeKeys, state.*.placeValues, state.*.placeMask, key, mlx)
                    continue
                }
            }
        }
        if symbol != NONE {
            put(state.*.placeKeys, state.*.placeValues, state.*.placeMask, key, symbol)
            if hasInfo(index, symbol) {
                const info = infoOf(index, symbol)
                if info.*.bodyFile == NONE && has_body {
                    info.*.bodyFile = body_file
                    info.*.bodyOffset = @intCast(u32, body_offset)
                    info.*.defFile = if has_def { def_file } else { file }
                    info.*.defOffset = @intCast(u32, if has_def { def_offset } else { offset })
                }
            }
            continue
        }
        symbol = index_module.addCSymbol(index, kindOf(letter), file, offset, length)
        if symbol == NONE { return }
        put(state.*.placeKeys, state.*.placeValues, state.*.placeMask, key, symbol)
        const info = newInfo(index, symbol)
        if has_link {
            info.*.link = keep(index, link)
            info.*.linkLength = @intCast(u32, link.length)
            put(state.*.linkKeys, state.*.linkValues, state.*.linkMask, hashOf(0, link), symbol)
        }
        if qualified.length > 0 && !(qualified.length == 1 && qualified[0] == 45) {
            info.*.qualified = keep(index, qualified)
            info.*.qualifiedLength = @intCast(u32, qualified.length)
        }
        if has_body {
            info.*.bodyFile = body_file
            info.*.bodyOffset = @intCast(u32, body_offset)
        }
        if has_def {
            info.*.defFile = def_file
            info.*.defOffset = @intCast(u32, def_offset)
        } else if has_body {
            info.*.defFile = file
            info.*.defOffset = @intCast(u32, offset)
        }
        if has_parent {
            info.*.parentFile = parent_file
            info.*.parentOffset = @intCast(u32, parent_offset)
        }
        _ = name
    }
}

// The definitions a shard's file holds of what is declared elsewhere (R
// ... d TARGET BODY): the declaration's definition and body, when the
// unit that wrote the declaration's shard did not see them.
fn definitions(index: *Index, shard: *Shard) -> void {
    const state = stateOf(index)
    const text = shardText(shard)
    var reader = Reader.{ .text = text.pointer, .length = text.length, .at = 0 }
    while reader.at < reader.length {
        if reader.text[reader.at] != 82 || reader.at + 2 >= reader.length {
            nextLine(&reader)
            continue
        }
        reader.at += 2
        var file: u32 = NONE
        var offset: usize = 0
        if !lineColumn(index, &reader, shard.*.file, &file, &offset) {
            nextLine(&reader)
            continue
        }
        _ = skip(&reader, 32)
        _ = number(&reader)
        _ = skip(&reader, 32)
        if reader.at >= reader.length || reader.text[reader.at] != 100 {
            nextLine(&reader)
            continue
        }
        reader.at += 1
        _ = skip(&reader, 32)
        var target_file: u32 = NONE
        var target_offset: usize = 0
        var body_file: u32 = NONE
        var body_offset: usize = 0
        if place(index, &reader, &target_file, &target_offset) && skip(&reader, 32) && place(index, &reader, &body_file, &body_offset) {
            const symbol = get(state.*.placeKeys, state.*.placeValues, state.*.placeMask, placeKey(target_file, target_offset))
            if hasInfo(index, symbol) {
                const info = infoOf(index, symbol)
                if info.*.bodyFile == NONE {
                    info.*.bodyFile = body_file
                    info.*.bodyOffset = @intCast(u32, body_offset)
                    info.*.defFile = file
                    info.*.defOffset = @intCast(u32, offset)
                }
            }
        }
        nextLine(&reader)
    }
}

// The qualified name of a function or variable from its linker name
// (demangled: parameters, template arguments and a result type left
// out), else from its class.
fn qualify(index: *Index, symbol: u32, buffer: [*]u8) -> void {
    const info = infoOf(index, symbol)
    if info.*.qualifiedLength > 0 { return }
    const link = textAt(info.*.link, info.*.linkLength)
    if demangle.isMangled(link) {
        const written = demangle.demangle(link, buffer, 4096)
        if written > 0 && written < 4096 {
            info.*.signature = keep(index, buffer[0..written])
            info.*.signatureLength = @intCast(u32, written)
            // Up to the parameters, template arguments out, from the last
            // space (a result type before the name).
            var out: [4096]u8 = undefined
            const bytes: [*]u8 = &out
            var length: usize = 0
            var depth: usize = 0
            var at: usize = 0
            while at < written {
                const c = buffer[at]
                if c == 60 {
                    // `operator<`, `operator<<`: a name, not arguments.
                    const after_operator = at >= 8 && sameBytes(buffer[at - 8..at], "operator")
                    if after_operator || (at >= 9 && sameBytes(buffer[at - 9..at], "operator<")) {
                        bytes[length] = c
                        length += 1
                    } else {
                        depth += 1
                    }
                } else if c == 62 && depth > 0 {
                    depth -= 1
                } else if depth == 0 {
                    if c == 40 && !(length >= 8 && sameBytes(bytes[length - 8..length], "operator")) { break }
                    if c == 32 && !(length >= 8 && sameBytes(bytes[length - 8..length], "operator")) {
                        length = 0
                    } else {
                        bytes[length] = c
                        length += 1
                    }
                }
                at += 1
            }
            if length > 0 {
                info.*.qualified = keep(index, bytes[0..length])
                info.*.qualifiedLength = @intCast(u32, length)
                return
            }
        }
    }
    // The classes around it.
    const record = index_module.symbolAt(index, symbol)
    if record.*.parent != NONE && hasInfo(index, record.*.parent) {
        const outer = qualifiedOf(index, record.*.parent)
        const name = index_module.nameOf(index, symbol)
        if outer.length + name.length + 2 < 4096 {
            var length: usize = 0
            for byte in outer {
                buffer[length] = byte
                length += 1
            }
            buffer[length] = 58
            buffer[length + 1] = 58
            length += 2
            for byte in name {
                buffer[length] = byte
                length += 1
            }
            info.*.qualified = keep(index, buffer[0..length])
            info.*.qualifiedLength = @intCast(u32, length)
        }
    }
}

// ---------------------------------------------------------------------------
// Bodies

// The offset after the `}` that closes the body whose `{` is at `start`
// (comments, strings and character constants passed over).
fn bodyEnd(source: []const u8, start: usize) -> usize {
    var at = start
    while at < source.length && source[at] != 123 { at += 1 }
    var depth: usize = 0
    while at < source.length {
        const c = source[at]
        if c == 47 && at + 1 < source.length && source[at + 1] == 47 {
            while at < source.length && source[at] != 10 { at += 1 }
            continue
        }
        if c == 47 && at + 1 < source.length && source[at + 1] == 42 {
            at += 2
            while at + 1 < source.length && !(source[at] == 42 && source[at + 1] == 47) { at += 1 }
            at += 2
            continue
        }
        if c == 34 || c == 39 {
            at += 1
            while at < source.length && source[at] != c && source[at] != 10 {
                if source[at] == 92 { at += 1 }
                at += 1
            }
            at += 1
            continue
        }
        if c == 123 { depth += 1 }
        if c == 125 {
            depth -= 1
            if depth == 0 { return at + 1 }
        }
        at += 1
    }
    return source.length
}

fn lineStartOf(source: []const u8, offset: usize) -> usize {
    var at = offset
    while at > 0 && source[at - 1] != 10 { at -= 1 }
    return at
}

// The extent of a declaration with a body: from its definition's line to
// the end of its body (start, end; end 0 for none).
pub fn extentOf(index: *Index, symbol: u32, start: *usize, end: *usize) -> u32 {
    end.* = 0
    if !hasInfo(index, symbol) { return NONE }
    const info = infoOf(index, symbol)
    if info.*.bodyFile == NONE { return NONE }
    const source = index_module.sourceOf(index, info.*.bodyFile)
    if info.*.bodyEnd == NONE { info.*.bodyEnd = @intCast(u32, bodyEnd(source, @intCast(usize, info.*.bodyOffset))) }
    var from = @intCast(usize, info.*.bodyOffset)
    if info.*.defFile == info.*.bodyFile && @intCast(usize, info.*.defOffset) <= from { from = @intCast(usize, info.*.defOffset) }
    start.* = lineStartOf(source, from)
    end.* = @intCast(usize, info.*.bodyEnd)
    return info.*.bodyFile
}

fn addRegions(index: *Index) -> void {
    const state = stateOf(index)
    var symbol = state.*.firstSymbol
    while symbol < index.*.symbolCount && state.*.regionCount < MAX_REGIONS {
        const id = @intCast(u32, symbol)
        const kind = index_module.symbolAt(index, id).*.kind
        if kind == index_module.FUNCTION && hasInfo(index, id) {
            var start: usize = 0
            var end: usize = 0
            const file = extentOf(index, id, &start, &end)
            if file != NONE && end > start && start < 16777216 {
                const at = state.*.regionCount
                state.*.regionKeys[at] = (@intCast(u64, file) << 44) | (@intCast(u64, start) << 20) | @intCast(u64, at)
                state.*.regionEnds[at] = @intCast(u32, end)
                state.*.regionSymbols[at] = id
                state.*.regionCount += 1
            }
        }
        symbol += 1
    }
    std.mem.sortU64(state.*.regionKeys, state.*.regionCount)
}

// The function whose definition holds byte `offset` of `file`, NONE.
pub fn functionAt(index: *Index, file: u32, offset: usize) -> u32 {
    const state = stateOf(index)
    const wanted = (@intCast(u64, file) << 44) | (@intCast(u64, offset) << 20) | 1048575
    var low: usize = 0
    var high = state.*.regionCount
    while low < high {
        const middle = (low + high) / 2
        if state.*.regionKeys[middle] <= wanted { low = middle + 1 } else { high = middle }
    }
    // The innermost one around it: the last that starts before it and
    // ends after it (a few back at most).
    var at = low
    var steps: usize = 0
    while at > 0 && steps < 32 {
        at -= 1
        const key = state.*.regionKeys[at]
        if (key >> 44) != @intCast(u64, file) { return NONE }
        const which = @intCast(usize, key & 1048575)
        if @intCast(usize, state.*.regionEnds[which]) >= offset { return state.*.regionSymbols[which] }
        steps += 1
    }
    return NONE
}

// ---------------------------------------------------------------------------
// Uses

fn useOf(letter: u8) -> u8 {
    return match letter {
        99 => index_module.USE_CALL,
        114 => index_module.USE_READ,
        119 => index_module.USE_WRITE,
        116 => index_module.USE_TYPE,
        98 => index_module.USE_BASE,
        111 => index_module.USE_OVERRIDE,
        120 => index_module.USE_EXPANSION,
        100 => index_module.USE_DEFINITION,
        else => index_module.USE_READ
    }
}

var sortKeys: [*]u64 = undefined
var sortCapacity: usize = 0

fn addRef(index: *Index, file: u32, offset: usize, length: usize, symbol: u32, from: u32, use: u8) -> void {
    if index.*.refCount >= index_module.MAX_REFS || symbol == NONE { return }
    const ref = index_module.refAt(index, index.*.refCount)
    ref.*.file = file
    ref.*.start = @intCast(u32, offset)
    ref.*.length = @intCast(u32, length)
    ref.*.symbol = symbol
    ref.*.from = from
    ref.*.use = use
    index.*.refCount += 1
}

fn uses(index: *Index, shard: *Shard) -> void {
    const state = stateOf(index)
    const text = shardText(shard)
    const record = index_module.fileAt(index, shard.*.file)
    const file_symbol = record.*.symbol
    const first = index.*.refCount
    var reader = Reader.{ .text = text.pointer, .length = text.length, .at = 0 }
    while reader.at < reader.length {
        const kind = reader.text[reader.at]
        if (kind != 68 && kind != 82 && kind != 73) || reader.at + 2 >= reader.length || reader.text[reader.at + 1] != 32 {
            nextLine(&reader)
            continue
        }
        reader.at += 2
        var file: u32 = NONE
        var offset: usize = 0
        if !lineColumn(index, &reader, shard.*.file, &file, &offset) {
            nextLine(&reader)
            continue
        }
        _ = skip(&reader, 32)
        const length = number(&reader)
        _ = skip(&reader, 32)
        if kind == 68 {
            // Its declaration (or another declaration of it).
            const symbol = get(state.*.placeKeys, state.*.placeValues, state.*.placeMask, placeKey(file, offset))
            if symbol != NONE {
                const parent = index_module.symbolAt(index, symbol).*.parent
                addRef(index, file, offset, length, symbol, if parent == NONE { symbol } else { parent }, index_module.USE_DECLARATION)
            }
        } else if kind == 82 {
            const letter = reader.text[reader.at]
            reader.at += 1
            _ = skip(&reader, 32)
            var target_file: u32 = NONE
            var target_offset: usize = 0
            if place(index, &reader, &target_file, &target_offset) {
                const symbol = get(state.*.placeKeys, state.*.placeValues, state.*.placeMask, placeKey(target_file, target_offset))
                if symbol != NONE {
                    var from = functionAt(index, file, offset)
                    if from == NONE { from = file_symbol }
                    addRef(index, file, offset, length, symbol, from, useOf(letter))
                } else {
                    index.*.unresolved += 1
                }
            }
        } else {
            const path = rest(&reader)
            const included = index_module.findFile(index, path)
            if included != NONE { addRef(index, file, offset, length, index_module.fileAt(index, included).*.symbol, file_symbol, index_module.USE_IMPORT) }
        }
        nextLine(&reader)
    }
    // In order of place (refAtOffset searches them so).
    const count = index.*.refCount - first
    if count > sortCapacity {
        sortCapacity = count * 2
        sortKeys = unsafe { @ptrCast([*]u64, allocate(index, sortCapacity * 8)) }
    }
    var at: usize = 0
    while at < count {
        sortKeys[at] = (@intCast(u64, index_module.refAt(index, first + at).*.start) << 24) | @intCast(u64, at)
        at += 1
    }
    std.mem.sortU64(sortKeys, count)
    const copies = unsafe { @ptrCast([*]index_module.Ref, allocate(index, count * @sizeOf(index_module.Ref) + 16)) }
    at = 0
    while at < count {
        copies[at] = index_module.refAt(index, first + at).*
        at += 1
    }
    at = 0
    while at < count {
        index_module.refAt(index, first + at).* = copies[@intCast(usize, sortKeys[at] & 16777215)]
        at += 1
    }
    record.*.refStart = first
    record.*.refEnd = index.*.refCount
}

// ---------------------------------------------------------------------------
// Loading

// The shards of the directories into `index` (after its Mlx files).
pub fn load(index: *Index) -> void {
    const memory = allocate(index, @sizeOf(State))
    index.*.cpp = @intFromPtr(memory)
    const state = stateOf(index)
    state.*.infoCount = 0
    state.*.shardCount = 0
    state.*.regionCount = 0
    state.*.firstSymbol = index.*.symbolCount
    state.*.firstRef = index.*.refCount
    var path: [4096]u8 = undefined
    const buffer: [*]u8 = &path
    // The directories: the root's, then MLX_CODEMAP_CPP's.
    shardsAt = @intFromPtr(allocate(index, MAX_SHARDS * @sizeOf(Shard)))
    var length: usize = 0
    while length < index.*.rootLength && length < 3900 {
        buffer[length] = index.*.root[length]
        length += 1
    }
    for byte in "/mlx-out/codemap/cpp" {
        buffer[length] = byte
        length += 1
    }
    readDirectory(index, buffer, length)
    var directories: [8192]u8 = undefined
    const listed: [*]u8 = &directories
    const listed_length = diagnostics.environmentValue("MLX_CODEMAP_CPP", listed, 8192)
    var start: usize = 0
    var at: usize = 0
    while at <= listed_length {
        if at == listed_length || listed[at] == 58 {
            if at > start && at - start < 3900 {
                var copied: usize = 0
                while copied < at - start {
                    buffer[copied] = listed[start + copied]
                    copied += 1
                }
                while copied > 1 && buffer[copied - 1] == 47 { copied -= 1 }
                readDirectory(index, buffer, copied)
            }
            start = at + 1
        }
        at += 1
    }
    if state.*.shardCount == 0 {
        index.*.cpp = 0
        return
    }
    unsafe {
        state.*.infoOf = @ptrCast([*]u32, allocate(index, index_module.MAX_SYMBOLS * 4))
        state.*.infos = @ptrCast([*]Info, allocate(index, index_module.MAX_SYMBOLS / 2 * @sizeOf(Info)))
        state.*.placeKeys = @ptrCast([*]u64, allocate(index, PLACE_SLOTS * 8))
        state.*.placeValues = @ptrCast([*]u32, allocate(index, PLACE_SLOTS * 4))
        state.*.linkKeys = @ptrCast([*]u64, allocate(index, LINK_SLOTS * 8))
        state.*.linkValues = @ptrCast([*]u32, allocate(index, LINK_SLOTS * 4))
        state.*.mlxKeys = @ptrCast([*]u64, allocate(index, MLX_SLOTS * 8))
        state.*.mlxValues = @ptrCast([*]u32, allocate(index, MLX_SLOTS * 4))
        state.*.regionKeys = @ptrCast([*]u64, allocate(index, MAX_REGIONS * 8))
        state.*.regionEnds = @ptrCast([*]u32, allocate(index, MAX_REGIONS * 4))
        state.*.regionSymbols = @ptrCast([*]u32, allocate(index, MAX_REGIONS * 4))
        shardFiles = @ptrCast([*]u32, allocate(index, 1048576 * 4))
    }
    shardFileCapacity = 1048576
    state.*.placeMask = PLACE_SLOTS - 1
    state.*.linkMask = LINK_SLOTS - 1
    state.*.mlxMask = MLX_SLOTS - 1
    clear(state.*.placeKeys, PLACE_SLOTS)
    clear(state.*.linkKeys, LINK_SLOTS)
    clear(state.*.mlxKeys, MLX_SLOTS)
    var symbol: usize = 0
    while symbol < index_module.MAX_SYMBOLS {
        state.*.infoOf[symbol] = NONE
        symbol += 1
    }
    // The Mlx functions C may name: export first, then extern.
    var pass: usize = 0
    while pass < 2 {
        symbol = 0
        while symbol < state.*.firstSymbol {
            const id = @intCast(u32, symbol)
            const record = index_module.symbolAt(index, id)
            const wanted: u32 = if pass == 0 { 2 } else { 16 }
            if record.*.kind == index_module.FUNCTION && record.*.flags & wanted != 0 {
                const key = hashOf(7, index_module.nameOf(index, id))
                if get(state.*.mlxKeys, state.*.mlxValues, state.*.mlxMask, key) == NONE { put(state.*.mlxKeys, state.*.mlxValues, state.*.mlxMask, key, id) }
            }
            symbol += 1
        }
        pass += 1
    }
    // A file's shard: the one of its text now, else the first.
    var shard_index: usize = 0
    while shard_index < state.*.shardCount {
        const shard = shardAt(shard_index)
        const known = index_module.findFile(index, shardPath(shard))
        if known == NONE || !index_module.isCFile(index, known) {
            if known == NONE {
                const file = addFile(index, shardPath(shard))
                if file != NONE {
                    shard.*.file = file
                    shard.*.chosen = true
                    state.*.fileCount += 1
                }
            }
        } else {
            // Another shard of a file already taken: this one when it is
            // of the text now and that one is not.
            var other: usize = 0
            while other < shard_index {
                const held = shardAt(other)
                if held.*.chosen && held.*.file == known {
                    const now = contentHash(index_module.sourceOf(index, known))
                    if held.*.hash != now && shard.*.hash == now {
                        held.*.chosen = false
                        shard.*.chosen = true
                        shard.*.file = known
                    }
                    break
                }
                other += 1
            }
        }
        shard_index += 1
    }
    // Declarations, their classes and names; the bodies; the uses.
    shard_index = 0
    while shard_index < state.*.shardCount {
        const shard = shardAt(shard_index)
        if shard.*.chosen {
            readFiles(index, shard)
            declarations(index, shard)
        }
        shard_index += 1
    }
    shard_index = 0
    while shard_index < state.*.shardCount {
        const shard = shardAt(shard_index)
        if shard.*.chosen {
            readFiles(index, shard)
            definitions(index, shard)
        }
        shard_index += 1
    }
    var qualified: [4096]u8 = undefined
    const qualified_bytes: [*]u8 = &qualified
    symbol = state.*.firstSymbol
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        if hasInfo(index, id) {
            const info = infoOf(index, id)
            const record = index_module.symbolAt(index, id)
            var parent = NONE
            if info.*.parentFile != NONE { parent = get(state.*.placeKeys, state.*.placeValues, state.*.placeMask, placeKey(info.*.parentFile, @intCast(usize, info.*.parentOffset))) }
            if parent == NONE || parent == id { parent = index_module.fileAt(index, record.*.file).*.symbol }
            index_module.adopt(index, parent, id)
        }
        symbol += 1
    }
    symbol = state.*.firstSymbol
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        if hasInfo(index, id) && index_module.symbolAt(index, id).*.kind != index_module.STRUCT && index_module.symbolAt(index, id).*.kind != index_module.UNION { qualify(index, id, qualified_bytes) }
        symbol += 1
    }
    addRegions(index)
    shard_index = 0
    while shard_index < state.*.shardCount {
        const shard = shardAt(shard_index)
        if shard.*.chosen {
            readFiles(index, shard)
            uses(index, shard)
        }
        shard_index += 1
    }
    // An Mlx extern function a C file defines: its Mlx uses are the C
    // function's.
    symbol = 0
    while symbol < state.*.firstSymbol {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        if record.*.kind == index_module.FUNCTION && record.*.flags & 16 != 0 {
            const defined = symbolOfLink(index, index_module.nameOf(index, id))
            if defined != NONE && hasInfo(index, defined) && infoOf(index, defined).*.bodyFile != NONE {
                var ref: usize = 0
                while ref < state.*.firstRef {
                    const value = index_module.refAt(index, ref)
                    if value.*.symbol == id && value.*.use != index_module.USE_DECLARATION { value.*.symbol = defined }
                    ref += 1
                }
            }
        }
        symbol += 1
    }
}

fn clear(keys: [*]u64, count: usize) -> void {
    var at: usize = 0
    while at < count {
        keys[at] = 0
        at += 1
    }
}

// Whether `spec` (`A::B::name`, `A.B.name`, a part of it from a `::`)
// names C symbol `symbol` (its qualified name), or is its linker name.
pub fn matches(index: *Index, symbol: u32, spec: []const u8) -> bool {
    const qualified = qualifiedOf(index, symbol)
    if spec.length > 2 && spec[0] == 95 && spec[1] == 90 { return sameBytes(linkOf(index, symbol), spec) }
    // From the end: the spec's parts against the name's, `.` as `::`.
    var s = spec.length
    var q = qualified.length
    while s > 0 {
        if q == 0 { return false }
        const c = spec[s - 1]
        if c == 46 {
            if q < 2 || qualified[q - 1] != 58 || qualified[q - 2] != 58 { return false }
            s -= 1
            q -= 2
            continue
        }
        if c != qualified[q - 1] { return false }
        s -= 1
        q -= 1
    }
    return q == 0 || (q >= 2 && qualified[q - 1] == 58 && qualified[q - 2] == 58)
}
