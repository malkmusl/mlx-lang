// Asking for declarations by what they are, where, what they use and what
// was found in them: words, all of which must hold (a leading - turns one
// around).
//
//     kind:fn in:std/ uses:Allocator calls:alloc -crashed
//
//   TEXT, name:TEXT     the name contains TEXT (case left aside)
//   kind:KIND           fn, struct, enum, union, error, field, member,
//                       const, var, test
//   in:PATH             the file's path (relative) starts with PATH
//   file:TEXT           the file's path contains TEXT
//   uses:NAME           it uses something named NAME (any way)
//   calls:NAME          it calls something named NAME
//   by:NAME             something named NAME calls it
//   crashed             a kept crash stopped in it or went through it
//   workaround[:KIND]   it works around something (dropped, counted,
//                       pointers, casts, unsafe, arena, floats, math,
//                       comments)
//   unused, unreachable, untested, complex, risky, hot, copy
//                       the findings of the same names
//   changed, added      changed or added since the base (HEAD: what is
//                       not committed yet)
//   since:REV           the base changed and added compare with
//
// Only declarations count (functions, types, fields, constants, variables,
// tests; not files and not locals).
//
//     var query: query_module.Query = undefined
//     query_module.init(&query, allocator)
//     if query_module.parse(&query, "kind:fn crashed") { ... }
//     query_module.prepare(&query, &measures, diff)
//     query_module.matches(&query, symbol)
const std = @import("std")
const index_module = @import("./index.mlx")
const analysis_module = @import("./analysis.mlx")
const workarounds_module = @import("./workarounds.mlx")
const crashes_module = @import("./crashes.mlx")
const programs_module = @import("./programs.mlx")
const complexity_module = @import("./complexity.mlx")
const profiles_module = @import("./profiles.mlx")
const measures_module = @import("./measures.mlx")
const diff_module = @import("./diff.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

const NAME: u8 = 0
const KIND: u8 = 1
const IN: u8 = 2
const FILE: u8 = 3
const USES: u8 = 4
const CALLS: u8 = 5
const BY: u8 = 6
const CRASHED: u8 = 7
const WORKAROUND: u8 = 8
const UNUSED: u8 = 9
const UNREACHABLE: u8 = 10
const UNTESTED: u8 = 11
const COMPLEX: u8 = 12
const RISKY: u8 = 13
const HOT: u8 = 14
const COPY: u8 = 15
const CHANGED: u8 = 16
const ADDED: u8 = 17

pub const MAX_TERMS: usize = 16

pub const Query = struct {
    allocator: Allocator
    // The text asked (a copy) and its words.
    text: [1024]u8
    textLength: usize
    count: usize
    term: [16]u8
    negated: [16]bool
    start: [16]usize
    end: [16]usize
    // A kind of declaration (kind:) or of workaround (workaround:; 255:
    // any).
    value: [16]u8
    // Per term that needs one (uses, calls, by, unused): a bit per
    // symbol.
    bits: [16]usize
    capacity: [16]usize
    measures: *measures_module.Measures
    diff: usize
    // Whether a word was not understood (and which).
    badStart: usize
    badEnd: usize
    // since:REV (in text; empty: none).
    sinceStart: usize
    sinceEnd: usize
}

pub fn init(query: *Query, allocator: Allocator) -> void {
    query.*.allocator = allocator
    query.*.count = 0
    query.*.textLength = 0
    query.*.diff = 0
    query.*.badStart = 0
    query.*.badEnd = 0
    var term: usize = 0
    while term < MAX_TERMS {
        query.*.capacity[term] = 0
        query.*.bits[term] = 0
        term += 1
    }
}

fn textOf(query: *Query) -> [*]u8 {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &query.*.text) }
    return bytes
}

fn wordOf(query: *Query, term: usize) -> []const u8 {
    return textOf(query)[query.*.start[term]..query.*.end[term]]
}

// The word not understood ("" when all were).
pub fn badWord(query: *Query) -> []const u8 {
    return textOf(query)[query.*.badStart..query.*.badEnd]
}

// The base asked for with since: ("HEAD" without).
pub fn since(query: *Query) -> []const u8 {
    if query.*.sinceEnd == query.*.sinceStart { return "HEAD" }
    return textOf(query)[query.*.sinceStart..query.*.sinceEnd]
}

fn lower(byte: u8) -> u8 {
    return if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && index_module.sameBytes(text[0..prefix.length], prefix)
}

// Whether `text` asks with the words above (a word with a colon, or one of
// the findings alone): else it is a plain name to look for.
pub fn isQuery(text: []const u8) -> bool {
    var at: usize = 0
    while at < text.length {
        while at < text.length && text[at] == 32 { at += 1 }
        var end = at
        while end < text.length && text[end] != 32 { end += 1 }
        var start = at
        if end - start > 1 && (text[start] == 45 || text[start] == 33) { start += 1 }
        for byte in text[start..end] {
            if byte == 58 { return true }
        }
        if flagOf(text[start..end]) != 255 { return true }
        at = end
    }
    return false
}

fn flagOf(word: []const u8) -> u8 {
    if index_module.sameBytes(word, "crashed") { return CRASHED }
    if index_module.sameBytes(word, "workaround") || index_module.sameBytes(word, "workarounds") { return WORKAROUND }
    if index_module.sameBytes(word, "unused") { return UNUSED }
    if index_module.sameBytes(word, "unreachable") { return UNREACHABLE }
    if index_module.sameBytes(word, "untested") { return UNTESTED }
    if index_module.sameBytes(word, "complex") { return COMPLEX }
    if index_module.sameBytes(word, "risky") { return RISKY }
    if index_module.sameBytes(word, "hot") { return HOT }
    if index_module.sameBytes(word, "copy") || index_module.sameBytes(word, "copies") { return COPY }
    if index_module.sameBytes(word, "changed") { return CHANGED }
    if index_module.sameBytes(word, "added") { return ADDED }
    return 255
}

fn kindNamed(word: []const u8) -> u8 {
    if index_module.sameBytes(word, "fn") || index_module.sameBytes(word, "function") { return index_module.FUNCTION }
    if index_module.sameBytes(word, "struct") { return index_module.STRUCT }
    if index_module.sameBytes(word, "enum") { return index_module.ENUM }
    if index_module.sameBytes(word, "union") { return index_module.UNION }
    if index_module.sameBytes(word, "error") { return index_module.ERROR_SET }
    if index_module.sameBytes(word, "field") { return index_module.FIELD }
    if index_module.sameBytes(word, "member") { return index_module.MEMBER }
    if index_module.sameBytes(word, "const") { return index_module.CONST }
    if index_module.sameBytes(word, "var") { return index_module.VAR }
    if index_module.sameBytes(word, "test") { return index_module.TEST }
    return 255
}

pub fn patternNamed(word: []const u8) -> u8 {
    if index_module.sameBytes(word, "dropped") { return workarounds_module.DROPPED }
    if index_module.sameBytes(word, "counted") { return workarounds_module.COUNTED }
    if index_module.sameBytes(word, "pointers") { return workarounds_module.POINTER_MATH }
    if index_module.sameBytes(word, "casts") { return workarounds_module.ARRAY_CAST }
    if index_module.sameBytes(word, "unsafe") { return workarounds_module.UNSAFE_SET }
    if index_module.sameBytes(word, "arena") { return workarounds_module.ARENA }
    if index_module.sameBytes(word, "floats") { return workarounds_module.FLOATS }
    if index_module.sameBytes(word, "math") { return workarounds_module.MATH }
    if index_module.sameBytes(word, "comments") { return workarounds_module.COMMENT }
    return 255
}

// Reads the words of `text`; false when one is not understood (badWord
// says which) or there is none.
pub fn parse(query: *Query, text: []const u8) -> bool {
    query.*.count = 0
    query.*.badStart = 0
    query.*.badEnd = 0
    query.*.sinceStart = 0
    query.*.sinceEnd = 0
    const bytes = textOf(query)
    query.*.textLength = 0
    for byte in text {
        if query.*.textLength < 1024 {
            bytes[query.*.textLength] = byte
            query.*.textLength += 1
        }
    }
    const copy = bytes[0..query.*.textLength]
    var at: usize = 0
    while at < copy.length {
        while at < copy.length && copy[at] == 32 { at += 1 }
        if at >= copy.length { break }
        var end = at
        while end < copy.length && copy[end] != 32 { end += 1 }
        if query.*.count >= MAX_TERMS { break }
        const term = query.*.count
        var start = at
        query.*.negated[term] = false
        if end - start > 1 && (copy[start] == 45 || copy[start] == 33) {
            query.*.negated[term] = true
            start += 1
        }
        const word = copy[start..end]
        var colon = start
        while colon < end && copy[colon] != 58 { colon += 1 }
        var kind: u8 = 255
        query.*.value[term] = 255
        if colon == end {
            kind = flagOf(word)
            if kind == 255 { kind = NAME }
            query.*.start[term] = start
            query.*.end[term] = end
        } else {
            const key = copy[start..colon]
            const value = copy[colon + 1..end]
            query.*.start[term] = colon + 1
            query.*.end[term] = end
            if index_module.sameBytes(key, "name") { kind = NAME }
            if index_module.sameBytes(key, "kind") {
                query.*.value[term] = kindNamed(value)
                if query.*.value[term] != 255 { kind = KIND }
            }
            if index_module.sameBytes(key, "in") { kind = IN }
            if index_module.sameBytes(key, "file") { kind = FILE }
            if index_module.sameBytes(key, "uses") { kind = USES }
            if index_module.sameBytes(key, "calls") { kind = CALLS }
            if index_module.sameBytes(key, "by") || index_module.sameBytes(key, "called-by") { kind = BY }
            if index_module.sameBytes(key, "workaround") || index_module.sameBytes(key, "workarounds") {
                query.*.value[term] = patternNamed(value)
                if query.*.value[term] != 255 { kind = WORKAROUND }
            }
            if value.length == 0 { kind = 255 }
            if index_module.sameBytes(key, "since") && value.length > 0 {
                query.*.sinceStart = colon + 1
                query.*.sinceEnd = end
                kind = 254
            }
        }
        if kind == 255 {
            query.*.badStart = at
            query.*.badEnd = end
            return false
        }
        if kind != 254 {
            query.*.term[term] = kind
            query.*.count += 1
        }
        at = end
    }
    return query.*.count > 0
}

fn bitsOf(query: *Query, term: usize) -> [*]u64 {
    unsafe { return @ptrFromInt([*]u64, query.*.bits[term]) }
}

fn setBit(query: *Query, term: usize, symbol: u32) -> void {
    if symbol == NONE { return }
    const bits = bitsOf(query, term)
    const at = @intCast(usize, symbol)
    bits[at / 64] = bits[at / 64] | (@intCast(u64, 1) << @intCast(u64, at % 64))
}

fn hasBit(query: *Query, term: usize, symbol: u32) -> bool {
    const at = @intCast(usize, symbol)
    if at / 64 >= query.*.capacity[term] { return false }
    return (bitsOf(query, term)[at / 64] >> @intCast(u64, at % 64)) & 1 == 1
}

// Works out what the terms need (on the index and findings of
// `measures`; `diff`: a diff_module.Diff's address, 0: none).
pub fn prepare(query: *Query, measures: *measures_module.Measures, diff: usize) -> void {
    query.*.measures = measures
    query.*.diff = diff
    const index = measures.*.index
    const needed = index.*.symbolCount / 64 + 1
    var term: usize = 0
    while term < query.*.count {
        const kind = query.*.term[term]
        if kind == USES || kind == CALLS || kind == BY || kind == UNUSED {
            if query.*.capacity[term] < needed {
                const capacity = needed + needed / 2 + 16
                unsafe { query.*.bits[term] = @intFromPtr(query.*.allocator.alloc(capacity * 8, 16).?) }
                query.*.capacity[term] = capacity
            }
            const bits = bitsOf(query, term)
            var word: usize = 0
            while word < query.*.capacity[term] {
                bits[word] = 0
                word += 1
            }
            if kind == UNUSED {
                if measures.*.analysis != 0 {
                    var analysis: *analysis_module.Analysis = undefined
                    unsafe { analysis = @ptrFromInt(*analysis_module.Analysis, measures.*.analysis) }
                    var at: usize = 0
                    while at < analysis.*.unusedCount {
                        setBit(query, term, analysis.*.unused[at])
                        at += 1
                    }
                }
            } else {
                const name = wordOf(query, term)
                var ref: usize = 0
                while ref < index.*.refCount {
                    const value = index_module.refAt(index, ref)
                    if value.*.symbol != NONE && value.*.from != NONE && value.*.use != index_module.USE_DECLARATION {
                        if kind == BY {
                            if value.*.use == index_module.USE_CALL && index_module.sameBytes(index_module.nameOf(index, value.*.from), name) { setBit(query, term, value.*.symbol) }
                        } else if (kind == USES || value.*.use == index_module.USE_CALL) && index_module.sameBytes(index_module.nameOf(index, value.*.symbol), name) {
                            setBit(query, term, value.*.from)
                        }
                    }
                    ref += 1
                }
            }
        }
        term += 1
    }
}

fn containsFolded(text: []const u8, part: []const u8) -> bool {
    if part.length == 0 { return true }
    if part.length > text.length { return false }
    var start: usize = 0
    while start + part.length <= text.length {
        var same = true
        var at: usize = 0
        while same && at < part.length {
            if lower(text[start + at]) != lower(part[at]) { same = false }
            at += 1
        }
        if same { return true }
        start += 1
    }
    return false
}

// Whether a kind of declaration can match.
pub fn isDeclaration(kind: u8) -> bool { return kind != index_module.IMPORT && diff_module.compared(kind) }

fn holds(query: *Query, term: usize, symbol: u32) -> bool {
    const measures = query.*.measures
    const index = measures.*.index
    const record = index_module.symbolAt(index, symbol)
    const kind = query.*.term[term]
    const word = wordOf(query, term)
    if kind == NAME { return containsFolded(index_module.nameOf(index, symbol), word) }
    if kind == KIND { return record.*.kind == query.*.value[term] }
    if kind == IN { return startsWith(programs_module.relativePath(index, record.*.file), word) }
    if kind == FILE { return containsFolded(programs_module.relativePath(index, record.*.file), word) }
    if kind == USES || kind == CALLS || kind == BY || kind == UNUSED { return hasBit(query, term, symbol) }
    if kind == CRASHED {
        if measures.*.crashes == 0 { return false }
        var crashes: *crashes_module.Crashes = undefined
        unsafe { crashes = @ptrFromInt(*crashes_module.Crashes, measures.*.crashes) }
        return crashes_module.stoppedIn(crashes, symbol) + crashes_module.wentThrough(crashes, symbol) > 0
    }
    if kind == WORKAROUND {
        if measures.*.workarounds == 0 { return false }
        var workarounds: *workarounds_module.Workarounds = undefined
        unsafe { workarounds = @ptrFromInt(*workarounds_module.Workarounds, measures.*.workarounds) }
        const marks = workarounds_module.marksOf(workarounds, symbol)
        if query.*.value[term] == 255 { return marks != 0 }
        return (marks >> @intCast(u16, query.*.value[term])) & 1 == 1
    }
    if kind == UNREACHABLE || kind == UNTESTED {
        if measures.*.programs == 0 || record.*.kind != index_module.FUNCTION { return false }
        var programs: *programs_module.Programs = undefined
        unsafe { programs = @ptrFromInt(*programs_module.Programs, measures.*.programs) }
        return if kind == UNREACHABLE { programs_module.isUnreachable(programs, symbol) } else { programs_module.isUntested(programs, symbol) }
    }
    if kind == COMPLEX {
        if measures.*.complexity == 0 { return false }
        var complexity: *complexity_module.Complexity = undefined
        unsafe { complexity = @ptrFromInt(*complexity_module.Complexity, measures.*.complexity) }
        return complexity_module.isComplex(complexity, symbol)
    }
    if kind == RISKY { return record.*.kind == index_module.FUNCTION && measures_module.isRisky(measures, symbol) }
    if kind == HOT {
        if measures.*.profiles == 0 { return false }
        var profiles: *profiles_module.Profiles = undefined
        unsafe { profiles = @ptrFromInt(*profiles_module.Profiles, measures.*.profiles) }
        return profiles_module.totalOf(profiles, symbol) > 0
    }
    if kind == COPY {
        if measures.*.analysis == 0 { return false }
        var analysis: *analysis_module.Analysis = undefined
        unsafe { analysis = @ptrFromInt(*analysis_module.Analysis, measures.*.analysis) }
        return analysis_module.groupOf(analysis, analysis_module.COPIES, symbol) != NONE || analysis_module.groupOf(analysis, analysis_module.SHAPES, symbol) != NONE
    }
    if kind == CHANGED || kind == ADDED {
        if query.*.diff == 0 { return false }
        var diff: *diff_module.Diff = undefined
        unsafe { diff = @ptrFromInt(*diff_module.Diff, query.*.diff) }
        const state = diff_module.stateOf(diff, symbol)
        return if kind == ADDED { state == diff_module.ADDED } else { state != diff_module.SAME }
    }
    return false
}

// Whether a declaration answers the query.
pub fn matches(query: *Query, symbol: u32) -> bool {
    const index = query.*.measures.*.index
    if symbol == NONE || !isDeclaration(index_module.symbolAt(index, symbol).*.kind) { return false }
    var term: usize = 0
    while term < query.*.count {
        if holds(query, term, symbol) == query.*.negated[term] { return false }
        term += 1
    }
    return true
}

// Whether the query needs the diff (changed, added).
pub fn needsDiff(query: *Query) -> bool {
    var term: usize = 0
    while term < query.*.count {
        if query.*.term[term] == CHANGED || query.*.term[term] == ADDED { return true }
        term += 1
    }
    return false
}
