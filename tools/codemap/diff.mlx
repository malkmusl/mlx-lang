// What changed since a commit: the declarations added, changed and
// removed. The files Git names as changed (git diff --name-only, and new
// files not added yet) are taken out of the base commit (git show) into a
// temporary directory and indexed there; their declarations are matched
// with today's by file, containers, name and kind, and compared by their
// text (blanks left out). With a second commit, that one is taken out the
// same way instead of the work tree.
//
//     var diff: diff_module.Diff = undefined
//     diff_module.init(&diff, allocator)
//     diff_module.run(&diff, index, &git, "HEAD", "")
//     diff_module.stateOf(&diff, symbol)   // ADDED, CHANGED or SAME
const std = @import("std")
const index_module = @import("./index.mlx")
const git_module = @import("./git.mlx")
const programs_module = @import("./programs.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

pub const SAME: u8 = 0
pub const ADDED: u8 = 1
pub const CHANGED: u8 = 2

const MAX_PATHS: usize = 4096
const MAX_ENTRIES: usize = 1048576

pub const Diff = struct {
    allocator: Allocator
    // Whether it ran (Git there, the commits known).
    ran: bool
    // The index compared (today's, or the second commit's) and the base's.
    now: *Index
    before: *Index
    hasBefore: bool
    // The indexes of what was taken out (made once, then emptied for the
    // next run).
    beforeIndex: *Index
    otherIndex: *Index
    made: u8
    // Per symbol of `now`: SAME, ADDED or CHANGED.
    state: [*]u8
    capacity: usize
    // The base's declarations that are gone.
    removed: [*]u32
    removedCount: usize
    added: usize
    changed: usize
    files: usize
    // The changed files (relative paths, a NUL after each).
    paths: [*]u8
    pathsLength: usize
    pathCount: usize
    // Entries to match: key hash, text hash, symbol and side (bit 31).
    keys: [*]u64
    texts: [*]u64
    entrySymbols: [*]u32
    order: [*]u64
    entries: usize
    // The base's name (as given).
    base: [128]u8
    baseLength: usize
    // Directories to clean up.
    temporary: [*]u8
}

fn longs(allocator: Allocator, count: usize) -> [*]u64 {
    unsafe { return @ptrCast([*]u64, allocator.alloc(count * 8 + 8, 16).?) }
}

pub fn init(diff: *Diff, allocator: Allocator) -> void {
    diff.*.allocator = allocator
    diff.*.ran = false
    diff.*.hasBefore = false
    diff.*.made = 0
    diff.*.capacity = 0
    diff.*.removed = allocator.words(MAX_ENTRIES)
    diff.*.removedCount = 0
    diff.*.added = 0
    diff.*.changed = 0
    diff.*.files = 0
    diff.*.paths = allocator.alloc(MAX_PATHS * 256, 16).?
    diff.*.pathsLength = 0
    diff.*.pathCount = 0
    diff.*.keys = longs(allocator, MAX_ENTRIES)
    diff.*.texts = longs(allocator, MAX_ENTRIES)
    diff.*.entrySymbols = allocator.words(MAX_ENTRIES)
    diff.*.order = longs(allocator, MAX_ENTRIES)
    diff.*.entries = 0
    diff.*.baseLength = 0
    diff.*.temporary = allocator.alloc(4096, 16).?
}

pub fn stateOf(diff: *Diff, symbol: u32) -> u8 {
    if !diff.*.ran || symbol == NONE || @intCast(usize, symbol) >= diff.*.capacity { return SAME }
    return diff.*.state[symbol]
}

pub fn baseName(diff: *Diff) -> []const u8 {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &diff.*.base) }
    return bytes[0..diff.*.baseLength]
}

// Whether a kind of declaration is compared.
pub fn compared(kind: u8) -> bool {
    return kind == index_module.ALIAS || kind == index_module.IMPORT || kind == index_module.FUNCTION || kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.ERROR_SET || kind == index_module.FIELD || kind == index_module.MEMBER || kind == index_module.CONST || kind == index_module.VAR || kind == index_module.TEST
}

fn mix(hash: u64, byte: u8) -> u64 {
    return (hash ^ @intCast(u64, byte)) * 1099511628211
}

// The key of a declaration: its file (relative), containers, name, kind.
fn keyOf(index: *Index, symbol: u32) -> u64 {
    const record = index_module.symbolAt(index, symbol)
    var hash: u64 = 14695981039346656037
    if record.*.kind == index_module.FILE {
        for byte in programs_module.relativePath(index, record.*.file) { hash = mix(hash, byte) }
        return hash
    }
    if record.*.parent != NONE { hash = keyOf(index, record.*.parent) }
    hash = mix(hash, 46)
    for byte in index_module.nameOf(index, symbol) { hash = mix(hash, byte) }
    // An alias or import is a constant whose value was followed (in the
    // base, the file it names may not be there to follow).
    const kind = if record.*.kind == index_module.ALIAS || record.*.kind == index_module.IMPORT { index_module.CONST } else { record.*.kind }
    return mix(hash, kind)
}

// Its text, blanks left out.
fn textOf(index: *Index, symbol: u32) -> u64 {
    const source = index_module.sourceOf(index, index_module.symbolAt(index, symbol).*.file)
    var start = index_module.declarationOffset(index, symbol)
    var end = index_module.declarationEnd(index, symbol)
    if end > source.length { end = source.length }
    var hash: u64 = 14695981039346656037
    while start < end {
        const byte = source[start]
        if byte != 32 && byte != 9 && byte != 10 && byte != 13 { hash = mix(hash, byte) }
        start += 1
    }
    return hash
}

fn isChangedPath(diff: *Diff, path: []const u8) -> bool {
    var at: usize = 0
    while at < diff.*.pathsLength {
        var end = at
        while end < diff.*.pathsLength && diff.*.paths[end] != 0 { end += 1 }
        if index_module.sameBytes(diff.*.paths[at..end], path) { return true }
        at = end + 1
    }
    return false
}

// Reads the list of paths Git wrote (a line each) into the changed ones.
fn addPaths(diff: *Diff, text: []const u8) -> void {
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const path = text[at..end]
        if path.length > 4 && index_module.sameBytes(path[path.length - 4..path.length], ".mlx") && !isChangedPath(diff, path) && diff.*.pathCount < MAX_PATHS && diff.*.pathsLength + path.length + 1 < MAX_PATHS * 256 {
            for byte in path {
                diff.*.paths[diff.*.pathsLength] = byte
                diff.*.pathsLength += 1
            }
            diff.*.paths[diff.*.pathsLength] = 0
            diff.*.pathsLength += 1
            diff.*.pathCount += 1
        }
        at = end + 1
    }
}

// Takes the changed files as they were at `revision` into a new
// temporary directory (into diff.temporary); its length (0: failed).
fn takeOut(diff: *Diff, git: *git_module.Git, revision: []const u8) -> usize {
    git_module.beginShell(git)
    git_module.more(git, "d=$(mktemp -d) || exit 1; cd \"$d\" || exit 1; for p in")
    var at: usize = 0
    while at < diff.*.pathsLength {
        var end = at
        while end < diff.*.pathsLength && diff.*.paths[end] != 0 { end += 1 }
        git_module.more(git, " ")
        git_module.addQuoted(git, diff.*.paths[at..end])
        at = end + 1
    }
    git_module.more(git, "; do mkdir -p \"$(dirname \"$p\")\"; git -C ")
    git_module.addQuoted(git, git.*.root[0..git.*.rootLength])
    git_module.more(git, " show ")
    git_module.addQuoted(git, revision)
    git_module.more(git, "\":./$p\" > \"$p\" 2>/dev/null || rm -f \"$p\"; done; printf '%s' \"$d\"")
    const text = git_module.finish(git)
    if text.length == 0 || text[0] != 47 || text.length >= 4000 { return 0 }
    var length: usize = 0
    for byte in text {
        diff.*.temporary[length] = byte
        length += 1
    }
    diff.*.temporary[length] = 0
    return length
}

fn removeTemporary(diff: *Diff, git: *git_module.Git, length: usize) -> void {
    git_module.beginShell(git)
    git_module.more(git, "rm -rf ")
    git_module.addQuoted(git, diff.*.temporary[0..length])
    const output = git_module.finish(git)
}

// An index of the files taken out (its root the directory): the base's
// (which 0) or the other commit's (1).
fn indexOf(diff: *Diff, length: usize, which: u8) -> *Index {
    const root = diff.*.temporary[0..length]
    const bit = @intCast(u8, 1) << which
    if diff.*.made & bit == 0 {
        const made = index_module.create(root)
        if which == 0 { diff.*.beforeIndex = made } else { diff.*.otherIndex = made }
        diff.*.made = diff.*.made | bit
    }
    const index = if which == 0 { diff.*.beforeIndex } else { diff.*.otherIndex }
    index_module.reset(index, root)
    index_module.addTree(index, root)
    index_module.build(index)
    return index
}

fn addEntries(diff: *Diff, index: *Index, side: u32) -> void {
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        if compared(record.*.kind) && diff.*.entries < MAX_ENTRIES && isChangedPath(diff, programs_module.relativePath(index, record.*.file)) {
            const entry = diff.*.entries
            diff.*.keys[entry] = keyOf(index, id)
            diff.*.texts[entry] = textOf(index, id)
            diff.*.entrySymbols[entry] = id | side
            diff.*.order[entry] = @intCast(u64, entry)
            diff.*.entries += 1
        }
        symbol += 1
    }
}

// Entries by key (then side: the base's first).
fn before(diff: *Diff, first: u64, second: u64) -> bool {
    const a = @intCast(usize, first)
    const b = @intCast(usize, second)
    if diff.*.keys[a] != diff.*.keys[b] { return diff.*.keys[a] < diff.*.keys[b] }
    return (diff.*.entrySymbols[a] >> 31) < (diff.*.entrySymbols[b] >> 31) || ((diff.*.entrySymbols[a] >> 31) == (diff.*.entrySymbols[b] >> 31) && a < b)
}

fn sortEntries(diff: *Diff) -> void {
    const count = diff.*.entries
    var gap = count / 2
    while gap > 0 {
        var at = gap
        while at < count {
            const value = diff.*.order[at]
            var place = at
            while place >= gap && before(diff, value, diff.*.order[place - gap]) {
                diff.*.order[place] = diff.*.order[place - gap]
                place -= gap
            }
            diff.*.order[place] = value
            at += 1
        }
        gap /= 2
    }
}

// Compares `index` (today's work tree; `other` empty) or commit `other`
// with commit `base`. False when Git could not tell.
pub fn run(diff: *Diff, index: *Index, git: *git_module.Git, base: []const u8, other: []const u8) -> bool {
    diff.*.ran = false
    diff.*.hasBefore = false
    diff.*.removedCount = 0
    diff.*.added = 0
    diff.*.changed = 0
    diff.*.pathsLength = 0
    diff.*.pathCount = 0
    diff.*.entries = 0
    diff.*.baseLength = 0
    for byte in base {
        if diff.*.baseLength < 128 {
            diff.*.base[diff.*.baseLength] = byte
            diff.*.baseLength += 1
        }
    }
    diff.*.now = index
    if !git_module.usable(git) { return false }
    // Does the base name a commit?
    git_module.begin(git)
    git_module.more(git, "rev-parse --verify --quiet ")
    git_module.addQuoted(git, base)
    git_module.more(git, "^{commit}")
    const known = git_module.finish(git)
    if git.*.status != 0 || known.length == 0 { return false }
    git_module.begin(git)
    git_module.more(git, "diff --name-only --relative ")
    git_module.addQuoted(git, base)
    if other.length > 0 {
        git_module.more(git, " ")
        git_module.addQuoted(git, other)
    }
    git_module.more(git, " -- '*.mlx'")
    addPaths(diff, git_module.finish(git))
    if other.length == 0 { addPaths(diff, git_module.run(git, "ls-files --others --exclude-standard -- '*.mlx'")) }
    diff.*.files = diff.*.pathCount
    if other.length > 0 {
        const length = takeOut(diff, git, other)
        if length == 0 { return false }
        diff.*.now = indexOf(diff, length, 1)
        removeTemporary(diff, git, length)
    }
    const now = diff.*.now
    if now.*.symbolCount > diff.*.capacity {
        diff.*.capacity = now.*.symbolCount + now.*.symbolCount / 2 + 1024
        diff.*.state = diff.*.allocator.alloc(diff.*.capacity, 16).?
    }
    var symbol: usize = 0
    while symbol < now.*.symbolCount {
        diff.*.state[symbol] = SAME
        symbol += 1
    }
    diff.*.ran = true
    if diff.*.pathCount == 0 { return true }
    const length = takeOut(diff, git, base)
    if length == 0 { return false }
    diff.*.before = indexOf(diff, length, 0)
    diff.*.hasBefore = true
    removeTemporary(diff, git, length)
    addEntries(diff, diff.*.before, 0)
    addEntries(diff, now, 2147483648)
    sortEntries(diff)
    // Runs of one key: the base's entries first, then today's, matched in
    // order.
    var at: usize = 0
    while at < diff.*.entries {
        const key = diff.*.keys[@intCast(usize, diff.*.order[at])]
        var end = at
        var old_count: usize = 0
        while end < diff.*.entries && diff.*.keys[@intCast(usize, diff.*.order[end])] == key {
            if diff.*.entrySymbols[@intCast(usize, diff.*.order[end])] >> 31 == 0 { old_count += 1 }
            end += 1
        }
        const new_count = end - at - old_count
        var pair: usize = 0
        while pair < old_count || pair < new_count {
            if pair < new_count {
                const entry = @intCast(usize, diff.*.order[at + old_count + pair])
                const id = diff.*.entrySymbols[entry] & 2147483647
                if pair >= old_count {
                    diff.*.state[id] = ADDED
                    diff.*.added += 1
                } else if diff.*.texts[@intCast(usize, diff.*.order[at + pair])] != diff.*.texts[entry] {
                    diff.*.state[id] = CHANGED
                    diff.*.changed += 1
                }
            } else {
                diff.*.removed[diff.*.removedCount] = diff.*.entrySymbols[@intCast(usize, diff.*.order[at + pair])]
                diff.*.removedCount += 1
            }
            pair += 1
        }
        at = end
    }
    return true
}
