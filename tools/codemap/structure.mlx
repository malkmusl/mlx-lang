// How the files hang together:
//
//   - cycles: files that import each other, round about (a strongly
//     connected part of the import graph with more than one file);
//   - layers: imports a rule forbids. The rules are in codemap.layers at
//     the root, one a line:
//
//         std !-> examples tools compiler experiments tests
//
//     (files under std/ must not import files under those). Without the
//     file: std imports nothing outside std, and compiler nothing under
//     examples/, tools/, experiments/ or tests/. `#` starts a comment.
//
//     var structure: structure_module.Structure = undefined
//     structure_module.init(&structure, allocator)
//     structure_module.run(&structure, index)
const std = @import("std")
const index_module = @import("./index.mlx")
const programs_module = @import("./programs.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

pub const MAX_IMPORTS: usize = 65536
pub const MAX_RULES: usize = 64

pub const Structure = struct {
    index: *Index
    allocator: Allocator
    // The imports, file to file (by file id), sorted by the importer.
    importFrom: [*]u32
    importTo: [*]u32
    importAt: [*]u32
    importCount: usize
    starts: [*]u32
    // Per file: its cycle (NONE: in none); the cycles' files in runs.
    cycleOf: [*]u32
    cycleFiles: [*]u32
    cycleStart: [*]u32
    cycleCount: usize
    // Imports a rule forbids (indexes into the imports) and the rule.
    broken: [*]u32
    brokenRule: [*]u32
    brokenCount: usize
    // The rules: a path prefix and the prefixes it must not import (text
    // in `rules`, offsets in pairs).
    rules: [*]u8
    rulesLength: usize
    ruleFrom: [128]u32
    ruleFromEnd: [128]u32
    ruleTo: [128]u32
    ruleToEnd: [128]u32
    ruleCount: usize
    // Tarjan's walk.
    order: [*]u32
    low: [*]u32
    stack: [*]u32
    onStack: [*]u8
    callFile: [*]u32
    callEdge: [*]u32
}

pub fn init(structure: *Structure, allocator: Allocator) -> void {
    structure.*.allocator = allocator
    structure.*.importFrom = allocator.words(MAX_IMPORTS)
    structure.*.importTo = allocator.words(MAX_IMPORTS)
    structure.*.importAt = allocator.words(MAX_IMPORTS)
    structure.*.broken = allocator.words(MAX_IMPORTS)
    structure.*.brokenRule = allocator.words(MAX_IMPORTS)
    structure.*.starts = allocator.words(index_module.MAX_FILES + 1)
    structure.*.cycleOf = allocator.words(index_module.MAX_FILES)
    structure.*.cycleFiles = allocator.words(index_module.MAX_FILES)
    structure.*.cycleStart = allocator.words(index_module.MAX_FILES + 1)
    structure.*.order = allocator.words(index_module.MAX_FILES)
    structure.*.low = allocator.words(index_module.MAX_FILES)
    structure.*.stack = allocator.words(index_module.MAX_FILES)
    structure.*.onStack = allocator.alloc(index_module.MAX_FILES, 16).?
    structure.*.callFile = allocator.words(index_module.MAX_FILES)
    structure.*.callEdge = allocator.words(index_module.MAX_FILES)
    structure.*.rules = allocator.alloc(16384, 16).?
}

pub fn run(structure: *Structure, index: *Index) -> void {
    structure.*.index = index
    collectImports(structure)
    findCycles(structure)
    readRules(structure)
    checkRules(structure)
}

// The imports: an IMPORT symbol's target is the imported file's symbol.
fn collectImports(structure: *Structure) -> void {
    const index = structure.*.index
    structure.*.importCount = 0
    var file: usize = 0
    while file < index.*.fileCount {
        structure.*.starts[file] = @intCast(u32, structure.*.importCount)
        const id = @intCast(u32, file)
        var child = index_module.symbolAt(index, index_module.fileAt(index, id).*.symbol).*.firstChild
        while child != NONE {
            const value = index_module.symbolAt(index, child)
            if value.*.kind == index_module.IMPORT && value.*.target != NONE && structure.*.importCount < MAX_IMPORTS {
                const target = index_module.symbolAt(index, value.*.target)
                if target.*.kind == index_module.FILE && target.*.file != id {
                    structure.*.importFrom[structure.*.importCount] = id
                    structure.*.importTo[structure.*.importCount] = target.*.file
                    structure.*.importAt[structure.*.importCount] = child
                    structure.*.importCount += 1
                }
            }
            child = value.*.nextSibling
        }
        file += 1
    }
    structure.*.starts[index.*.fileCount] = @intCast(u32, structure.*.importCount)
}

// Tarjan's strongly connected parts, without recursion (an explicit
// stack of the walk: the file and the next import to follow).
fn findCycles(structure: *Structure) -> void {
    const index = structure.*.index
    const count = index.*.fileCount
    var file: usize = 0
    while file < count {
        structure.*.order[file] = NONE
        structure.*.onStack[file] = 0
        structure.*.cycleOf[file] = NONE
        file += 1
    }
    structure.*.cycleCount = 0
    var cycle_files: usize = 0
    var counter: u32 = 0
    var stacked: usize = 0
    var start: usize = 0
    while start < count {
        if structure.*.order[start] == NONE {
            var depth: usize = 0
            structure.*.callFile[0] = @intCast(u32, start)
            structure.*.callEdge[0] = structure.*.starts[start]
            structure.*.order[start] = counter
            structure.*.low[start] = counter
            counter += 1
            structure.*.stack[stacked] = @intCast(u32, start)
            stacked += 1
            structure.*.onStack[start] = 1
            depth = 1
            while depth > 0 {
                const at = @intCast(usize, structure.*.callFile[depth - 1])
                const edge = @intCast(usize, structure.*.callEdge[depth - 1])
                if edge < @intCast(usize, structure.*.starts[at + 1]) {
                    structure.*.callEdge[depth - 1] = @intCast(u32, edge + 1)
                    const next = @intCast(usize, structure.*.importTo[edge])
                    if structure.*.order[next] == NONE {
                        structure.*.order[next] = counter
                        structure.*.low[next] = counter
                        counter += 1
                        structure.*.stack[stacked] = @intCast(u32, next)
                        stacked += 1
                        structure.*.onStack[next] = 1
                        structure.*.callFile[depth] = @intCast(u32, next)
                        structure.*.callEdge[depth] = structure.*.starts[next]
                        depth += 1
                    } else if structure.*.onStack[next] != 0 && structure.*.order[next] < structure.*.low[at] {
                        structure.*.low[at] = structure.*.order[next]
                    }
                } else {
                    // Done with `at`: a root of a part takes it off the stack.
                    if structure.*.low[at] == structure.*.order[at] {
                        var size: usize = 0
                        var top = stacked
                        while top > 0 {
                            top -= 1
                            size += 1
                            if @intCast(usize, structure.*.stack[top]) == at { break }
                        }
                        if size > 1 {
                            structure.*.cycleStart[structure.*.cycleCount] = @intCast(u32, cycle_files)
                            var member = top
                            while member < stacked {
                                const part = structure.*.stack[member]
                                structure.*.cycleFiles[cycle_files] = part
                                structure.*.cycleOf[part] = @intCast(u32, structure.*.cycleCount)
                                cycle_files += 1
                                member += 1
                            }
                            structure.*.cycleCount += 1
                        }
                        var member = top
                        while member < stacked {
                            structure.*.onStack[structure.*.stack[member]] = 0
                            member += 1
                        }
                        stacked = top
                    }
                    depth -= 1
                    if depth > 0 {
                        const parent = @intCast(usize, structure.*.callFile[depth - 1])
                        if structure.*.low[at] < structure.*.low[parent] { structure.*.low[parent] = structure.*.low[at] }
                    }
                }
            }
        }
        start += 1
    }
    structure.*.cycleStart[structure.*.cycleCount] = @intCast(u32, cycle_files)
}

pub fn cycleMembers(structure: *Structure, cycle: usize) -> []const u32 {
    const start = @intCast(usize, structure.*.cycleStart[cycle])
    const end = @intCast(usize, structure.*.cycleStart[cycle + 1])
    return structure.*.cycleFiles[start..end]
}

// The file's cycle, NONE: none.
pub fn cycleOfFile(structure: *Structure, file: u32) -> u32 {
    if file == NONE || @intCast(usize, file) >= structure.*.index.*.fileCount { return NONE }
    return structure.*.cycleOf[file]
}

fn addRule(structure: *Structure, from_start: usize, from_end: usize, to_start: usize, to_end: usize) -> void {
    if structure.*.ruleCount >= 128 { return }
    const at = structure.*.ruleCount
    structure.*.ruleFrom[at] = @intCast(u32, from_start)
    structure.*.ruleFromEnd[at] = @intCast(u32, from_end)
    structure.*.ruleTo[at] = @intCast(u32, to_start)
    structure.*.ruleToEnd[at] = @intCast(u32, to_end)
    structure.*.ruleCount += 1
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 }

// codemap.layers at the root, else the rules above.
fn readRules(structure: *Structure) -> void {
    const index = structure.*.index
    structure.*.ruleCount = 0
    structure.*.rulesLength = 0
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    var length: usize = 0
    for byte in index.*.root[0..index.*.rootLength] {
        if length < 4000 {
            bytes[length] = byte
            length += 1
        }
    }
    for byte in "/codemap.layers" {
        bytes[length] = byte
        length += 1
    }
    bytes[length] = 0
    const file = std.fs.open(bytes, 0, 0)
    if std.fs.isValid(file) {
        while structure.*.rulesLength < 16383 {
            var chunk: [*]u8 = undefined
            unsafe { chunk = @ptrFromInt([*]u8, @intFromPtr(structure.*.rules) + structure.*.rulesLength) }
            const count = std.fs.read(file, chunk, 16383 - structure.*.rulesLength)
            if count <= 0 { break }
            structure.*.rulesLength += @intCast(usize, count)
        }
        const closed = std.fs.close(file)
    } else {
        const defaults = "std !-> examples tools compiler experiments tests\ncompiler !-> examples tools experiments tests\n"
        for byte in defaults {
            structure.*.rules[structure.*.rulesLength] = byte
            structure.*.rulesLength += 1
        }
    }
    parseRules(structure)
}

fn parseRules(structure: *Structure) -> void {
    const text = structure.*.rules[0..structure.*.rulesLength]
    var line: usize = 0
    while line < text.length {
        var end = line
        while end < text.length && text[end] != 10 && text[end] != 35 { end += 1 }
        // The prefix, the arrow, the prefixes.
        var at = line
        while at < end && isSpace(text[at]) { at += 1 }
        const from_start = at
        while at < end && !isSpace(text[at]) { at += 1 }
        const from_end = at
        while at < end && isSpace(text[at]) { at += 1 }
        if at + 3 <= end && text[at] == 33 && text[at + 1] == 45 && text[at + 2] == 62 && from_end > from_start {
            at += 3
            while at < end {
                while at < end && isSpace(text[at]) { at += 1 }
                const to_start = at
                while at < end && !isSpace(text[at]) { at += 1 }
                if at > to_start { addRule(structure, from_start, from_end, to_start, at) }
            }
        }
        while end < text.length && text[end] != 10 { end += 1 }
        line = end + 1
    }
}

// Whether `path` is `prefix` or under it.
fn under(path: []const u8, prefix: []const u8) -> bool {
    if path.length < prefix.length || !index_module.sameBytes(path[0..prefix.length], prefix) { return false }
    return path.length == prefix.length || path[prefix.length] == 47 || prefix[prefix.length - 1] == 47
}

pub fn ruleFrom(structure: *Structure, rule: usize) -> []const u8 { return structure.*.rules[structure.*.ruleFrom[rule]..structure.*.ruleFromEnd[rule]] }

pub fn ruleTo(structure: *Structure, rule: usize) -> []const u8 { return structure.*.rules[structure.*.ruleTo[rule]..structure.*.ruleToEnd[rule]] }

fn checkRules(structure: *Structure) -> void {
    const index = structure.*.index
    structure.*.brokenCount = 0
    var import: usize = 0
    while import < structure.*.importCount {
        const from = programs_module.relativePath(index, structure.*.importFrom[import])
        const to = programs_module.relativePath(index, structure.*.importTo[import])
        var rule: usize = 0
        while rule < structure.*.ruleCount {
            if under(from, ruleFrom(structure, rule)) && under(to, ruleTo(structure, rule)) {
                structure.*.broken[structure.*.brokenCount] = @intCast(u32, import)
                structure.*.brokenRule[structure.*.brokenCount] = @intCast(u32, rule)
                structure.*.brokenCount += 1
                break
            }
            rule += 1
        }
        import += 1
    }
}
