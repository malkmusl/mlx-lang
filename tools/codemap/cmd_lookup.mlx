// mlx-codemap's lookups: stats, files, outline, find, show, refs, callers, callees, members, imports (part of main.mlx, split from it).
const std = @import("std")
const index_module = @import("./index.mlx")
const cpp_module = @import("./cpp.mlx")
const app = @import("./main.mlx")

// ---------------------------------------------------------------------------
// Lookups: stats, files, outline, find, show, refs, callers, callees, members, imports

pub fn stats(context: *app.Context) -> void {
    const index = context.*.index
    app.say(context, "files ")
    app.sayNumber(context, index.*.fileCount)
    app.say(context, ", declarations ")
    app.sayNumber(context, index.*.symbolCount)
    app.say(context, ", uses ")
    app.sayNumber(context, index.*.refCount)
    app.say(context, ", names not followed ")
    app.sayNumber(context, index.*.unresolved)
    app.newline(context)
}

pub fn files(context: *app.Context, filter: []const u8) -> void {
    const index = context.*.index
    var file: usize = 0
    while file < index.*.fileCount {
        const path = app.shortPath(context, index_module.pathOf(index, @intCast(u32, file)))
        if app.contains(path, filter) {
            app.say(context, path)
            app.newline(context)
        }
        file += 1
    }
}

fn outlineOf(context: *app.Context, container: u32, depth: usize) -> void {
    const index = context.*.index
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != app.NONE {
        const record = index_module.symbolAt(index, child)
        const kind = record.*.kind
        const shown = kind != index_module.LOCAL_CONST && kind != index_module.LOCAL_VAR && kind != index_module.CAPTURE && kind != index_module.PARAM
        if shown {
            var indent: usize = 0
            while indent < depth {
                app.say(context, "  ")
                indent += 1
            }
            app.sayNumber(context, index_module.lineOf(index, record.*.file, @intCast(usize, record.*.nameStart)) + 1)
            app.say(context, " ")
            app.say(context, index_module.kindName(kind))
            app.say(context, " ")
            app.say(context, index_module.nameOf(index, child))
            if record.*.flags & index_module.FLAG_PUB != 0 { app.say(context, " (pub)") }
            app.newline(context)
            if kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION { outlineOf(context, child, depth + 1) }
        }
        child = record.*.nextSibling
    }
}

pub fn outline(context: *app.Context, path: []const u8) -> void {
    const file = app.findFileSpec(context, path)
    if file == app.NONE {
        app.noMatch(context, path)
        return
    }
    if index_module.isCFile(context.*.index, file) {
        outlineC(context, file)
        return
    }
    outlineOf(context, index_module.fileAt(context.*.index, file).*.symbol, 0)
}

// A C or C++ file's outline, by line: what it declares (a class's members
// under it), and the definitions of what is declared elsewhere (a member
// function defined out of its class: `definition Class::name`).
fn outlineC(context: *app.Context, file: u32) -> void {
    const index = context.*.index
    const record = index_module.fileAt(index, file)
    // Entries: line << 40 | depth << 32 | symbol; a definition's depth 15.
    var count: usize = 0
    var capacity: usize = 1024
    var entries: [*]u64 = unsafe { @ptrCast([*]u64, std.heap.allocator().alloc(capacity * 8, 16).?) }
    var stack: [16]u32 = undefined
    var depths: [16]u64 = undefined
    var top: usize = 1
    stack[0] = index_module.symbolAt(index, record.*.symbol).*.firstChild
    depths[0] = 0
    while top > 0 {
        const child = stack[top - 1]
        if child == app.NONE {
            top -= 1
            continue
        }
        const value = index_module.symbolAt(index, child)
        stack[top - 1] = value.*.nextSibling
        if count == capacity {
            const larger: [*]u64 = unsafe { @ptrCast([*]u64, std.heap.allocator().alloc(capacity * 16, 16).?) }
            var copied: usize = 0
            while copied < count {
                larger[copied] = entries[copied]
                copied += 1
            }
            entries = larger
            capacity = capacity * 2
        }
        const line = index_module.lineOf(index, file, @intCast(usize, value.*.nameStart))
        entries[count] = (@intCast(u64, line) << 40) | (depths[top - 1] << 32) | @intCast(u64, child)
        count += 1
        if (value.*.kind == index_module.STRUCT || value.*.kind == index_module.UNION) && top < 16 && value.*.file == file {
            stack[top] = value.*.firstChild
            depths[top] = depths[top - 1] + 1
            top += 1
        }
    }
    // The definitions here of what is declared elsewhere.
    var ref = record.*.refStart
    while ref < record.*.refEnd {
        const value = index_module.refAt(index, ref)
        if value.*.use == index_module.USE_DEFINITION && count < capacity {
            const line = index_module.lineOf(index, file, @intCast(usize, value.*.start))
            entries[count] = (@intCast(u64, line) << 40) | (@intCast(u64, 15) << 32) | @intCast(u64, value.*.symbol)
            count += 1
        }
        ref += 1
    }
    std.mem.sortU64(entries, count)
    var at: usize = 0
    while at < count {
        const entry = entries[at]
        const symbol = @intCast(u32, entry & 4294967295)
        const depth = @intCast(usize, (entry >> 32) & 255)
        var indent: usize = 0
        while indent < depth && depth != 15 {
            app.say(context, "  ")
            indent += 1
        }
        app.sayNumber(context, @intCast(usize, entry >> 40) + 1)
        app.say(context, " ")
        if depth == 15 {
            app.say(context, "definition ")
            app.sayQualified(context, symbol)
        } else {
            app.say(context, app.kindName(context, symbol))
            app.say(context, " ")
            app.say(context, if depth == 0 { cpp_module.qualifiedOf(index, symbol) } else { index_module.nameOf(index, symbol) })
        }
        app.newline(context)
        at += 1
    }
}

pub fn find(context: *app.Context, text: []const u8) -> void {
    const index = context.*.index
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const kind = index_module.symbolAt(index, id).*.kind
        if kind != index_module.FILE && kind != index_module.LOCAL_CONST && kind != index_module.LOCAL_VAR && kind != index_module.CAPTURE && kind != index_module.PARAM && app.contains(index_module.nameOf(index, id), text) {
            app.sayDeclaration(context, id)
            app.newline(context)
        }
        symbol += 1
    }
}

// How often a symbol is used, by kind of use.
fn useCounts(context: *app.Context, symbol: u32, counts: [*]usize) -> void {
    const index = context.*.index
    var at: usize = 0
    while at < 16 {
        counts[at] = 0
        at += 1
    }
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol { counts[@intCast(usize, value.*.use)] += 1 }
        ref += 1
    }
}

fn sayRange(context: *app.Context, file: u32, start: usize, length: usize) -> void {
    const source = index_module.sourceOf(context.*.index, file)
    app.say(context, source[start..start + length])
}

fn showOne(context: *app.Context, symbol: u32) -> void {
    const index = context.*.index
    const record = index_module.symbolAt(index, symbol)
    app.sayDeclaration(context, symbol)
    app.newline(context)
    var start: usize = 0
    var length: usize = 0
    index_module.docRange(index, symbol, &start, &length)
    if length > 0 {
        sayRange(context, record.*.file, start, length)
    }
    if record.*.kind != index_module.FILE {
        index_module.signatureRange(index, symbol, &start, &length)
        app.say(context, "    ")
        sayRange(context, record.*.file, start, length)
        app.newline(context)
    }
    if index_module.isCSymbol(index, symbol) { showC(context, symbol) }
    if record.*.parent != app.NONE {
        app.say(context, "  in ")
        app.sayDeclaration(context, record.*.parent)
        app.newline(context)
    }
    var counts: [16]usize = undefined
    const bytes: [*]usize = &counts
    useCounts(context, symbol, bytes)
    app.say(context, "  used: ")
    var use: usize = 1
    var total: usize = 0
    while use < index_module.USE_KINDS {
        if bytes[use] > 0 {
            if total > 0 { app.say(context, ", ") }
            app.sayNumber(context, bytes[use])
            app.say(context, " ")
            app.say(context, index_module.useName(@intCast(u8, use)))
            total += bytes[use]
        }
        use += 1
    }
    if total == 0 { app.say(context, "never") }
    app.newline(context)
    // Its members.
    var child = record.*.firstChild
    var shown: usize = 0
    while child != app.NONE {
        const item = index_module.symbolAt(index, child)
        if item.*.kind != index_module.LOCAL_CONST && item.*.kind != index_module.LOCAL_VAR && item.*.kind != index_module.CAPTURE {
            if shown == 0 {
                app.say(context, "  members:")
                app.newline(context)
            }
            app.say(context, "    ")
            app.say(context, app.kindName(context, child))
            app.say(context, " ")
            app.say(context, index_module.nameOf(index, child))
            app.newline(context)
            shown += 1
        }
        child = item.*.nextSibling
    }
    app.newline(context)
}

// A C or C++ declaration's own: its linker name and signature, where it
// is defined, and its source there (the definition, a class's body).
fn showC(context: *app.Context, symbol: u32) -> void {
    const index = context.*.index
    const signature = cpp_module.signatureOf(index, symbol)
    if signature.length > 0 {
        app.say(context, "  ")
        app.say(context, signature)
        app.newline(context)
    }
    const link = cpp_module.linkOf(index, symbol)
    if link.length > 0 && !index_module.sameBytes(link, index_module.nameOf(index, symbol)) {
        app.say(context, "  linker name ")
        app.say(context, link)
        app.newline(context)
    }
    var start: usize = 0
    var end: usize = 0
    const file = cpp_module.extentOf(index, symbol, &start, &end)
    if file == app.NONE || end <= start { return }
    app.say(context, "  defined at ")
    const info = cpp_module.infoOf(index, symbol)
    if info.*.defFile != app.NONE {
        app.sayPlace(context, info.*.defFile, @intCast(usize, info.*.defOffset))
    } else {
        app.sayPlace(context, file, start)
    }
    app.newline(context)
    // Its text, numbered (at most 400 lines).
    const source = index_module.sourceOf(index, file)
    var line = index_module.lineOf(index, file, start)
    var at = start
    var lines: usize = 0
    while at < end && lines < 400 {
        var stop = at
        while stop < source.length && source[stop] != 10 { stop += 1 }
        app.say(context, "  ")
        app.sayNumber(context, line + 1)
        app.say(context, "  ")
        app.say(context, source[at..stop])
        app.newline(context)
        at = stop + 1
        line += 1
        lines += 1
    }
    if at < end {
        app.say(context, "  ...")
        app.newline(context)
    }
}

pub fn withSymbols(context: *app.Context, spec: []const u8, command: u8) -> void {
    var found: [64]u32 = undefined
    const list: [*]u32 = &found
    const count = app.resolveSpec(context, spec, list, 64)
    if count == 0 {
        app.noMatch(context, spec)
        return
    }
    var at: usize = 0
    while at < count {
        const symbol = list[at]
        if command == 0 { showOne(context, symbol) }
        if command == 1 { refs(context, symbol, count > 1) }
        if command == 2 { callers(context, symbol) }
        if command == 3 { callees(context, symbol) }
        if command == 4 { members(context, symbol) }
        if command == 5 {
            app.sayDeclaration(context, symbol)
            app.newline(context)
        }
        at += 1
    }
}

fn refs(context: *app.Context, symbol: u32, heading: bool) -> void {
    const index = context.*.index
    if heading {
        app.say(context, "== ")
        app.sayDeclaration(context, symbol)
        app.newline(context)
    }
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol {
            app.sayPlace(context, value.*.file, @intCast(usize, value.*.start))
            app.say(context, ": ")
            app.say(context, index_module.useName(value.*.use))
            app.say(context, ": ")
            app.sayLine(context, value.*.file, @intCast(usize, value.*.start))
            app.newline(context)
        }
        ref += 1
    }
}

// The function (or top-level declaration) a use is in.
fn enclosingFunction(context: *app.Context, symbol: u32) -> u32 {
    const index = context.*.index
    var current = symbol
    while current != app.NONE {
        const kind = index_module.symbolAt(index, current).*.kind
        if kind == index_module.FUNCTION || kind == index_module.TEST { return current }
        const parent = index_module.symbolAt(index, current).*.parent
        if parent == app.NONE || index_module.symbolAt(index, parent).*.kind == index_module.FILE { return current }
        current = parent
    }
    return symbol
}

fn callers(context: *app.Context, symbol: u32) -> void {
    const index = context.*.index
    app.say(context, "== callers of ")
    app.sayDeclaration(context, symbol)
    app.newline(context)
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol && value.*.use == index_module.USE_CALL && value.*.from != app.NONE {
            app.sayPlace(context, value.*.file, @intCast(usize, value.*.start))
            app.say(context, ": ")
            app.sayQualified(context, enclosingFunction(context, value.*.from))
            app.newline(context)
        }
        ref += 1
    }
}

fn callees(context: *app.Context, symbol: u32) -> void {
    const index = context.*.index
    app.say(context, "== called by ")
    app.sayDeclaration(context, symbol)
    app.newline(context)
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use == index_module.USE_CALL && value.*.from != app.NONE && enclosingFunction(context, value.*.from) == symbol {
            app.sayPlace(context, value.*.file, @intCast(usize, value.*.start))
            app.say(context, ": ")
            app.sayDeclaration(context, value.*.symbol)
            app.newline(context)
        }
        ref += 1
    }
}

fn members(context: *app.Context, symbol: u32) -> void {
    const index = context.*.index
    var container = symbol
    const kind = index_module.symbolAt(index, symbol).*.kind
    if kind == index_module.IMPORT || kind == index_module.ALIAS { container = index_module.symbolAt(index, symbol).*.target }
    if container == app.NONE { return }
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != app.NONE {
        const record = index_module.symbolAt(index, child)
        if record.*.kind != index_module.LOCAL_CONST && record.*.kind != index_module.LOCAL_VAR && record.*.kind != index_module.CAPTURE && record.*.kind != index_module.PARAM {
            app.sayDeclaration(context, child)
            app.newline(context)
        }
        child = record.*.nextSibling
    }
}

pub fn imports(context: *app.Context, path: []const u8, reverse: bool) -> void {
    const index = context.*.index
    const file = app.findFileSpec(context, path)
    if file == app.NONE {
        app.noMatch(context, path)
        return
    }
    const target = index_module.fileAt(index, file).*.symbol
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use == index_module.USE_IMPORT {
            if !reverse && value.*.file == file {
                app.say(context, app.shortPath(context, index_module.pathOf(index, index_module.symbolAt(index, value.*.symbol).*.file)))
                app.newline(context)
            }
            if reverse && value.*.symbol == target {
                app.sayPlace(context, value.*.file, @intCast(usize, value.*.start))
                app.newline(context)
            }
        }
        ref += 1
    }
}
