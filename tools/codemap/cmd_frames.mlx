// mlx-codemap frames: the programs' frame timelines as std.diagnostics
// writes them while they run with MLX_FRAMES (tools/codemap/frames.mlx):
// without a program the timelines there, one line each; with one its
// newest: how long the start took, the processor's and the GPU's time per
// frame, the frames over a 60 Hz frame's budget and the spikes, and the
// slowest frames (part of main.mlx, split from it).
const std = @import("std")
const frames_module = @import("./frames.mlx")
const app = @import("./main.mlx")

// µs as "0.4 ms" (a tenth) or "12 ms".
fn sayTime(context: *app.Context, microseconds: u64) -> void {
    if microseconds >= 100000 {
        app.sayNumber(context, microseconds / 1000)
    } else {
        app.sayNumber(context, microseconds / 1000)
        app.say(context, ".")
        app.sayNumber(context, microseconds / 100 % 10)
    }
    app.say(context, " ms")
}

fn sayHeadline(context: *app.Context, frames: *frames_module.Frames) -> void {
    const which = frames.*.loaded
    app.say(context, frames_module.nameOf(frames, which))
    app.say(context, " (pid ")
    app.sayNumber(context, frames.*.pid[which])
    app.say(context, if frames.*.running[which] { ", running): " } else { ", ended): " })
    app.sayNumber(context, frames.*.drawn)
    app.say(context, " frames, the first ")
    sayTime(context, frames.*.startup)
    app.say(context, " after the start; work median ")
    sayTime(context, frames.*.medianWork)
    app.say(context, ", 95% ")
    sayTime(context, frames.*.p95Work)
    app.newline(context)
}

pub fn command(context: *app.Context, environment: [*][*]const u8, program: []const u8) -> void {
    const allocator = std.heap.allocator()
    var frames: frames_module.Frames = undefined
    frames_module.init(&frames, allocator)
    frames_module.list(&frames, environment)
    if frames.count == 0 {
        app.say(context, "no frame timelines (run a program with MLX_FRAMES=1)")
        app.newline(context)
        return
    }
    if program.length == 0 {
        var which: usize = 0
        while which < frames.count {
            if frames_module.load(&frames, which) { sayHeadline(context, &frames) }
            which += 1
        }
        return
    }
    const which = frames_module.newestOf(&frames, program)
    if which >= frames.count || !frames_module.load(&frames, which) {
        app.say(context, "no frame timeline of ")
        app.say(context, program)
        app.newline(context)
        return
    }
    sayHeadline(context, &frames)
    app.say(context, "  processor: median ")
    sayTime(context, frames.medianProcessor)
    app.say(context, ", 95% ")
    sayTime(context, frames.p95Processor)
    app.newline(context)
    app.say(context, "  gpu: median ")
    sayTime(context, frames.medianGpu)
    app.say(context, ", 95% ")
    sayTime(context, frames.p95Gpu)
    app.newline(context)
    app.say(context, "  ")
    app.sayNumber(context, frames.frameCount)
    app.say(context, " frames kept: ")
    app.sayNumber(context, frames.overBudget)
    app.say(context, " over 16.7 ms (60 Hz), ")
    app.sayNumber(context, frames.spikes)
    app.say(context, if frames.spikes == 1 { " spike" } else { " spikes" })
    app.newline(context)
    // The slowest frames.
    var order: [10]u32 = undefined
    const order_bytes: [*]u32 = &order
    const count = frames_module.ranked(&frames, order_bytes, 5)
    var at: usize = 0
    while at < count {
        const frame = @intCast(usize, order[at])
        app.say(context, "    frame ")
        app.sayNumber(context, frames.serial[frame])
        app.say(context, " at ")
        sayTime(context, frames.start[frame])
        app.say(context, ": processor ")
        sayTime(context, frames.processor[frame])
        app.say(context, ", gpu ")
        sayTime(context, frames.gpu[frame])
        if frames_module.spike(&frames, frame) { app.say(context, " (spike)") }
        app.newline(context)
        at += 1
    }
}
