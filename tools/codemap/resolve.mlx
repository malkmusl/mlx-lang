// The index's two passes: declarations, types, scopes and uses (part of index.mlx, split from it).
const index_file = @import("./index.mlx")

// ---------------------------------------------------------------------------
// Pass 1: declarations

// The first token of the declaration whose name is token `name` (the
// keyword before it, and modifiers before that).
fn declarationStart(index: *index_file.Index, file: u32, name: usize) -> usize {
    if name == 0 { return 0 }
    var at = name - 1
    while at > 0 {
        const kind = index_file.tokenAt(index, file, at - 1).kind
        if kind == index_file.Kind.keyword_pub || kind == index_file.Kind.keyword_export || kind == index_file.Kind.keyword_inline || kind == index_file.Kind.keyword_noinline || kind == index_file.Kind.keyword_extern || kind == index_file.Kind.keyword_threadlocal {
            at -= 1
        } else if kind == index_file.Kind.right_parenthesis && at >= 4 && index_file.tokenAt(index, file, at - 4).kind == index_file.Kind.keyword_extern {
            // extern("syscall")
            at -= 4
        } else {
            break
        }
    }
    return at
}

fn containerKind(tag: index_file.Tag) -> u8 {
    if tag == index_file.Tag.struct_type { return index_file.STRUCT }
    if tag == index_file.Tag.enum_type { return index_file.ENUM }
    if tag == index_file.Tag.union_type { return index_file.UNION }
    if tag == index_file.Tag.error_set_type { return index_file.ERROR_SET }
    return NONE_KIND
}

const NONE_KIND: u8 = 255

// The aggregate node a declaration's value is (through @noncopy), else
// NODE_NONE.
fn aggregateOf(index: *index_file.Index, file: u32, node: usize) -> usize {
    if node == index_file.NODE_NONE { return index_file.NODE_NONE }
    const value = index_file.nodeAt(index, file, node)
    if containerKind(value.tag) != NONE_KIND { return node }
    if value.tag == index_file.Tag.nocopy_type { return aggregateOf(index, file, value.lhs) }
    return index_file.NODE_NONE
}

fn declareParameters(index: *index_file.Index, file: u32, function: u32, first: usize) -> void {
    var parameter = first
    while parameter != index_file.NODE_NONE {
        const value = index_file.nodeAt(index, file, parameter)
        const symbol = index_file.addNamed(index, index_file.PARAM, file, value.mainToken, parameter, function)
        if symbol != index_file.NONE {
            index_file.symbolAt(index, symbol).*.typeNode = if value.lhs == index_file.NODE_NONE { index_file.NONE } else { @intCast(u32, value.lhs) }
            index_file.symbolAt(index, symbol).*.firstToken = @intCast(u32, value.mainToken)
        }
        parameter = value.next
    }
}

fn declareFunction(index: *index_file.Index, file: u32, node: usize, parent: u32) -> u32 {
    const value = index_file.nodeAt(index, file, node)
    const symbol = index_file.addNamed(index, index_file.FUNCTION, file, value.mainToken, node, parent)
    if symbol == index_file.NONE { return index_file.NONE }
    const record = index_file.symbolAt(index, symbol)
    record.*.flags = @intCast(u32, (value.endToken >> 32) & 255)
    record.*.typeNode = if value.extra == index_file.NODE_NONE { index_file.NONE } else { @intCast(u32, value.extra) }
    record.*.firstToken = @intCast(u32, declarationStart(index, file, value.mainToken))
    index_file.putMember(index, parent, symbol)
    declareParameters(index, file, symbol, value.lhs)
    return symbol
}

// The members of an aggregate (fields, enum members, functions).
fn declareMembers(index: *index_file.Index, file: u32, aggregate: usize, container: u32) -> void {
    const value = index_file.nodeAt(index, file, aggregate)
    var child = value.lhs
    while child != index_file.NODE_NONE {
        const item = index_file.nodeAt(index, file, child)
        if item.tag == index_file.Tag.function_declaration {
            const function = declareFunction(index, file, child, container)
        } else if item.tag == index_file.Tag.field_declaration || item.tag == index_file.Tag.enum_member || item.tag == index_file.Tag.union_member {
            const symbol = index_file.addNamed(index, if item.tag == index_file.Tag.field_declaration { index_file.FIELD } else { index_file.MEMBER }, file, item.mainToken, child, container)
            if symbol != index_file.NONE {
                const record = index_file.symbolAt(index, symbol)
                record.*.typeNode = if item.lhs == index_file.NODE_NONE { index_file.NONE } else { @intCast(u32, item.lhs) }
                record.*.valueNode = if item.rhs == index_file.NODE_NONE { index_file.NONE } else { @intCast(u32, item.rhs) }
                var first = item.mainToken
                if first > 0 && index_file.tokenAt(index, file, first - 1).kind == index_file.Kind.keyword_pub { first -= 1 }
                record.*.firstToken = @intCast(u32, first)
                index_file.putMember(index, container, symbol)
            }
        }
        child = item.next
    }
}

// A binding (const or var) at file level or in a body: a struct, enum,
// union or error set when that is its value, an import, else a constant or
// variable (an alias is found out later).
fn declareBinding(index: *index_file.Index, file: u32, node: usize, parent: u32, local: bool) -> u32 {
    const value = index_file.nodeAt(index, file, node)
    const is_constant = value.tag == index_file.Tag.constant_declaration
    const aggregate = if is_constant { aggregateOf(index, file, value.rhs) } else { index_file.NODE_NONE }
    var kind = if local { if is_constant { index_file.LOCAL_CONST } else { index_file.LOCAL_VAR } } else { if is_constant { index_file.CONST } else { index_file.VAR } }
    if aggregate != index_file.NODE_NONE { kind = containerKind(index_file.nodeAt(index, file, aggregate).tag) }
    const import_token = if is_constant { index_file.importToken(index, file, value.rhs) } else { index_file.NODE_NONE }
    if import_token != index_file.NODE_NONE { kind = index_file.IMPORT }
    const symbol = index_file.addNamed(index, kind, file, value.mainToken, node, parent)
    if symbol == index_file.NONE { return index_file.NONE }
    const record = index_file.symbolAt(index, symbol)
    record.*.flags = @intCast(u32, value.extra & 255)
    record.*.typeNode = if value.lhs == index_file.NODE_NONE { index_file.NONE } else { @intCast(u32, value.lhs) }
    record.*.valueNode = if value.rhs == index_file.NODE_NONE { index_file.NONE } else { @intCast(u32, value.rhs) }
    record.*.firstToken = @intCast(u32, declarationStart(index, file, value.mainToken))
    if !local { index_file.putMember(index, parent, symbol) }
    if aggregate != index_file.NODE_NONE { declareMembers(index, file, aggregate, symbol) }
    if import_token != index_file.NODE_NONE {
        var buffer: [1100]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &buffer) }
        const length = index_file.importPath(index, file, index_file.stringTokenValue(index, file, import_token), bytes)
        if length > 0 {
            const target = index_file.addFile(index, bytes[0..length])
            if target != index_file.NONE { index_file.symbolAt(index, symbol).*.target = index_file.fileAt(index, target).*.symbol }
        }
    }
    return symbol
}

pub fn declareFile(index: *index_file.Index, file: u32) -> void {
    const record = index_file.fileAt(index, file)
    if record.*.loaded { return }
    record.*.loaded = true
    const container = record.*.symbol
    const root = index_file.nodeAt(index, file, record.*.root)
    var child = root.lhs
    while child != index_file.NODE_NONE {
        const item = index_file.nodeAt(index, file, child)
        if item.tag == index_file.Tag.function_declaration {
            const function = declareFunction(index, file, child, container)
        } else if item.tag == index_file.Tag.constant_declaration || item.tag == index_file.Tag.variable_declaration {
            const binding = declareBinding(index, file, child, container, false)
        } else if item.tag == index_file.Tag.test_declaration && item.endToken != index_file.NODE_NONE {
            const test_symbol = index_file.addNamed(index, index_file.TEST, file, item.endToken, child, container)
        }
        child = item.next
    }
}

// ---------------------------------------------------------------------------
// Types

fn unknown() -> index_file.Ty { return index_file.Ty.{ .symbol = index_file.NONE, .wraps = 0, .depth = 0, .flags = 0 } }

fn typeValue(symbol: u32) -> index_file.Ty { return index_file.Ty.{ .symbol = symbol, .wraps = 0, .depth = 0, .flags = index_file.TY_TYPE } }

fn wrap(ty: index_file.Ty, kind: u64) -> index_file.Ty {
    if ty.depth >= 20 { return ty }
    return index_file.Ty.{ .symbol = ty.symbol, .wraps = (ty.wraps << 3) | kind, .depth = ty.depth + 1, .flags = ty.flags & ~index_file.TY_TYPE }
}

fn outer(ty: index_file.Ty) -> u64 { return if ty.depth == 0 { 0 } else { ty.wraps & 7 } }

fn unwrap(ty: index_file.Ty) -> index_file.Ty {
    if ty.depth == 0 { return ty }
    return index_file.Ty.{ .symbol = ty.symbol, .wraps = ty.wraps >> 3, .depth = ty.depth - 1, .flags = ty.flags }
}

// What a value's type is to find members in: pointers followed.
fn stripPointers(ty: index_file.Ty) -> index_file.Ty {
    var result = ty
    while result.depth > 0 && outer(result) == index_file.WRAP_POINTER { result = unwrap(result) }
    return result
}

// An element of an indexed value.
fn elementOf(ty: index_file.Ty) -> index_file.Ty {
    var result = ty
    if outer(result) == index_file.WRAP_POINTER { result = unwrap(result) }
    const kind = outer(result)
    if kind == index_file.WRAP_MANY || kind == index_file.WRAP_SLICE || kind == index_file.WRAP_ARRAY { return unwrap(result) }
    return unknown()
}

// A type alias's (or import's) target: what the name stands for.
fn aliasTarget(index: *index_file.Index, symbol: u32) -> u32 {
    var current = symbol
    var steps: usize = 0
    while current != index_file.NONE && steps < 16 {
        const record = index_file.symbolAt(index, current)
        if record.*.kind == index_file.IMPORT { return record.*.target }
        if record.*.kind == index_file.ALIAS && record.*.target != index_file.NONE {
            current = record.*.target
            steps += 1
            continue
        }
        if record.*.kind != index_file.CONST && record.*.kind != index_file.LOCAL_CONST && record.*.kind != index_file.ALIAS { return current }
        if record.*.typeNode != index_file.NONE || record.*.valueNode == index_file.NONE { return current }
        // const X = a.b.C: what the value names, when it names a type or
        // module.
        const ty = typeOfExpression(index, record.*.file, @intCast(usize, record.*.valueNode), index_file.NONE)
        if ty.flags & index_file.TY_TYPE == 0 || ty.depth != 0 || ty.symbol == index_file.NONE { return current }
        record.*.kind = index_file.ALIAS
        record.*.target = ty.symbol
        current = ty.symbol
        steps += 1
    }
    return current
}

// The type a type expression names, in `file`, with `self_symbol` for Self.
fn typeOfTypeNode(index: *index_file.Index, file: u32, node: usize, self_symbol: u32) -> index_file.Ty {
    if node == index_file.NODE_NONE { return unknown() }
    const value = index_file.nodeAt(index, file, node)
    const tag = value.tag
    if tag == index_file.Tag.named_type || tag == index_file.Tag.identifier {
        const name = index_file.tokenText(index, file, value.mainToken)
        if index_file.sameBytes(name, "Self") && self_symbol != index_file.NONE { return typeValue(self_symbol) }
        var symbol = index_file.nodeSymbol(index, file, node)
        if symbol == index_file.NONE { symbol = lookupScoped(index, file, name, self_symbol) }
        if symbol == index_file.NONE { return unknown() }
        const target = aliasTarget(index, symbol)
        return typeValue(target)
    }
    if tag == index_file.Tag.field_expression {
        if value.lhs == index_file.NODE_NONE { return unknown() }
        const base = typeOfTypeNode(index, file, value.lhs, self_symbol)
        if base.symbol == index_file.NONE || base.depth != 0 { return unknown() }
        const found = index_file.member(index, base.symbol, index_file.tokenText(index, file, value.mainToken))
        if found == index_file.NONE { return unknown() }
        return typeValue(aliasTarget(index, found))
    }
    if tag == index_file.Tag.pointer_type { return wrap(typeOfTypeNode(index, file, value.lhs, self_symbol), index_file.WRAP_POINTER) }
    if tag == index_file.Tag.many_pointer_type { return wrap(typeOfTypeNode(index, file, value.lhs, self_symbol), index_file.WRAP_MANY) }
    if tag == index_file.Tag.slice_type { return wrap(typeOfTypeNode(index, file, value.lhs, self_symbol), index_file.WRAP_SLICE) }
    if tag == index_file.Tag.array_type { return wrap(typeOfTypeNode(index, file, value.rhs, self_symbol), index_file.WRAP_ARRAY) }
    if tag == index_file.Tag.optional_type { return wrap(typeOfTypeNode(index, file, value.lhs, self_symbol), index_file.WRAP_OPTIONAL) }
    if tag == index_file.Tag.error_union_type { return typeOfTypeNode(index, file, value.rhs, self_symbol) }
    if tag == index_file.Tag.nocopy_type { return typeOfTypeNode(index, file, value.lhs, self_symbol) }
    return unknown()
}

// The struct a symbol's type expressions see as Self.
fn selfOf(index: *index_file.Index, symbol: u32) -> u32 {
    var current = index_file.symbolAt(index, symbol).*.parent
    while current != index_file.NONE {
        const kind = index_file.symbolAt(index, current).*.kind
        if kind == index_file.STRUCT || kind == index_file.UNION || kind == index_file.ENUM { return current }
        if kind == index_file.FILE { return index_file.NONE }
        current = index_file.symbolAt(index, current).*.parent
    }
    return index_file.NONE
}

// A value's type from its declaration (worked out once).
pub fn typeOfSymbol(index: *index_file.Index, symbol: u32) -> index_file.Ty {
    if symbol == index_file.NONE { return unknown() }
    const record = index_file.symbolAt(index, symbol)
    const kind = record.*.kind
    if kind == index_file.STRUCT || kind == index_file.ENUM || kind == index_file.UNION || kind == index_file.ERROR_SET || kind == index_file.FILE { return typeValue(symbol) }
    if kind == index_file.IMPORT { return typeValue(record.*.target) }
    if kind == index_file.ALIAS { return typeValue(aliasTarget(index, symbol)) }
    if kind == index_file.FUNCTION { return index_file.Ty.{ .symbol = symbol, .wraps = 0, .depth = 0, .flags = index_file.TY_FUNCTION } }
    if kind == index_file.MEMBER && record.*.typeNode == index_file.NONE { return index_file.Ty.{ .symbol = record.*.parent, .wraps = 0, .depth = 0, .flags = 0 } }
    if record.*.flags & index_file.FLAG_TYPED != 0 { return index_file.Ty.{ .symbol = record.*.typeSymbol, .wraps = record.*.typeWraps, .depth = record.*.typeFlags >> 8, .flags = record.*.typeFlags & 255 } }
    if record.*.flags & index_file.FLAG_TYPING != 0 { return unknown() }
    record.*.flags = record.*.flags | index_file.FLAG_TYPING
    var result = unknown()
    if record.*.typeNode != index_file.NONE {
        result = typeOfTypeNode(index, record.*.file, @intCast(usize, record.*.typeNode), selfOf(index, symbol))
        // A value of the type, not the type.
        result.flags = result.flags & ~index_file.TY_TYPE
        if result.depth == 0 && result.symbol != index_file.NONE && index_file.symbolAt(index, result.symbol).*.kind == index_file.FILE { result = unknown() }
    } else if record.*.valueNode != index_file.NONE {
        const value_type = typeOfExpression(index, record.*.file, @intCast(usize, record.*.valueNode), selfOf(index, symbol))
        result = if kind == index_file.CAPTURE { elementOf(value_type) } else { value_type }
        if kind == index_file.CONST || kind == index_file.LOCAL_CONST {
            // const X = SomeType: an alias.
            if result.flags & index_file.TY_TYPE != 0 && result.depth == 0 && result.symbol != index_file.NONE {
                record.*.kind = index_file.ALIAS
                record.*.target = result.symbol
            }
        }
    }
    record.*.typeSymbol = result.symbol
    record.*.typeWraps = result.wraps
    record.*.typeFlags = (result.depth << 8) | (result.flags & 255)
    record.*.flags = (record.*.flags & ~index_file.FLAG_TYPING) | index_file.FLAG_TYPED
    return result
}

fn isCastBuiltin(name: []const u8) -> bool {
    return index_file.sameBytes(name, "ptrCast") || index_file.sameBytes(name, "ptrFromInt") || index_file.sameBytes(name, "intCast") || index_file.sameBytes(name, "bitCast") || index_file.sameBytes(name, "as") || index_file.sameBytes(name, "truncate") || index_file.sameBytes(name, "floatCast") || index_file.sameBytes(name, "alignCast") || index_file.sameBytes(name, "enumFromInt") || index_file.sameBytes(name, "floatFromInt") || index_file.sameBytes(name, "intFromFloat")
}

// A value's (or type's) type, as far as it can be told.
pub fn typeOfExpression(index: *index_file.Index, file: u32, node: usize, self_symbol: u32) -> index_file.Ty {
    if node == index_file.NODE_NONE { return unknown() }
    const value = index_file.nodeAt(index, file, node)
    const tag = value.tag
    if tag == index_file.Tag.identifier {
        const name = index_file.tokenText(index, file, value.mainToken)
        if index_file.sameBytes(name, "Self") && self_symbol != index_file.NONE { return typeValue(self_symbol) }
        var symbol = index_file.nodeSymbol(index, file, node)
        if symbol == index_file.NONE { symbol = lookupScoped(index, file, name, self_symbol) }
        return typeOfSymbol(index, symbol)
    }
    if tag == index_file.Tag.field_expression {
        if value.lhs == index_file.NODE_NONE { return unknown() }
        var symbol = index_file.nodeSymbol(index, file, node)
        if symbol == index_file.NONE {
            const base = typeOfExpression(index, file, value.lhs, self_symbol)
            symbol = memberOfType(index, base, index_file.tokenText(index, file, value.mainToken))
        }
        return typeOfSymbol(index, symbol)
    }
    if tag == index_file.Tag.call_expression {
        const callee = typeOfExpression(index, file, value.lhs, self_symbol)
        if callee.flags & index_file.TY_FUNCTION != 0 && callee.symbol != index_file.NONE {
            const function = index_file.symbolAt(index, callee.symbol)
            if function.*.typeNode == index_file.NONE { return unknown() }
            var result = typeOfTypeNode(index, function.*.file, @intCast(usize, function.*.typeNode), selfOf(index, callee.symbol))
            result.flags = result.flags & ~index_file.TY_TYPE
            return result
        }
        return unknown()
    }
    if tag == index_file.Tag.builtin_call {
        const name = index_file.tokenText(index, file, value.mainToken)
        if index_file.sameBytes(name, "import") {
            const imported = index_file.importToken(index, file, node)
            if imported == index_file.NODE_NONE { return unknown() }
            var buffer: [1100]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &buffer) }
            const length = index_file.importPath(index, file, index_file.stringTokenValue(index, file, imported), bytes)
            const target = if length > 0 { index_file.findFile(index, bytes[0..length]) } else { index_file.NONE }
            return if target == index_file.NONE { unknown() } else { typeValue(index_file.fileAt(index, target).*.symbol) }
        }
        if index_file.sameBytes(name, "This") { return typeValue(self_symbol) }
        if isCastBuiltin(name) && value.lhs != index_file.NODE_NONE {
            var result = typeOfTypeNode(index, file, value.lhs, self_symbol)
            result.flags = result.flags & ~index_file.TY_TYPE
            return result
        }
        return unknown()
    }
    if tag == index_file.Tag.unary_expression {
        const operator = index_file.tokenAt(index, file, value.mainToken).kind
        const operand = typeOfExpression(index, file, value.lhs, self_symbol)
        if operator == index_file.Kind.dot_asterisk { return if outer(operand) == index_file.WRAP_POINTER { unwrap(operand) } else { operand } }
        if operator == index_file.Kind.dot_question { return if outer(operand) == index_file.WRAP_OPTIONAL { unwrap(operand) } else { operand } }
        if operator == index_file.Kind.ampersand { return wrap(operand, index_file.WRAP_POINTER) }
        if operator == index_file.Kind.keyword_try { return operand }
        return unknown()
    }
    if tag == index_file.Tag.index_expression { return elementOf(typeOfExpression(index, file, value.lhs, self_symbol)) }
    if tag == index_file.Tag.slice_expression { return wrap(elementOf(typeOfExpression(index, file, value.lhs, self_symbol)), index_file.WRAP_SLICE) }
    if tag == index_file.Tag.aggregate_literal {
        var result = typeOfTypeNode(index, file, value.lhs, self_symbol)
        result.flags = result.flags & ~index_file.TY_TYPE
        return result
    }
    if tag == index_file.Tag.if_statement { return typeOfExpression(index, file, value.rhs, self_symbol) }
    if tag == index_file.Tag.named_type || tag == index_file.Tag.pointer_type || tag == index_file.Tag.many_pointer_type || tag == index_file.Tag.slice_type || tag == index_file.Tag.array_type || tag == index_file.Tag.optional_type {
        var result = typeOfTypeNode(index, file, node, self_symbol)
        result.flags = result.flags | index_file.TY_TYPE
        return result
    }
    if tag == index_file.Tag.struct_type || tag == index_file.Tag.enum_type || tag == index_file.Tag.union_type {
        const symbol = index_file.nodeSymbol(index, file, node)
        return if symbol == index_file.NONE { unknown() } else { typeValue(symbol) }
    }
    return unknown()
}

// Member `name` of what `ty` is: a module's declaration, a type's member
// (a static function, an enum member), or a value's field or function.
// What a function returns (a value of its return type).
pub fn returnType(index: *index_file.Index, function: u32) -> index_file.Ty {
    if function == index_file.NONE { return unknown() }
    const record = index_file.symbolAt(index, function)
    if record.*.kind != index_file.FUNCTION || record.*.typeNode == index_file.NONE { return unknown() }
    var result = typeOfTypeNode(index, record.*.file, @intCast(usize, record.*.typeNode), selfOf(index, function))
    result.flags = result.flags & ~index_file.TY_TYPE
    return result
}

// An element of an array, slice or many-pointer type (`x[i]`).
pub fn elementType(ty: index_file.Ty) -> index_file.Ty { return elementOf(ty) }

// Without its outermost wrapper (`x.?`, `x.*`).
pub fn unwrapType(ty: index_file.Ty) -> index_file.Ty { return unwrap(ty) }

// The token after a declaration's last (its end): the first statement end
// (or end of file) outside brackets from its first token on, or the
// bracket that closes what holds it.
pub fn declarationEnd(index: *index_file.Index, symbol: u32) -> usize {
    const record = index_file.symbolAt(index, symbol)
    const file = record.*.file
    if record.*.kind == index_file.FILE { return index_file.sourceOf(index, file).length }
    var token: usize = if record.*.firstToken != index_file.NONE { @intCast(usize, record.*.firstToken) } else { 0 }
    const count = index_file.fileAt(index, file).*.tokens.length
    var depth: isize = 0
    var last = token
    while token < count {
        const value = index_file.tokenAt(index, file, token)
        if value.kind == index_file.Kind.left_brace || value.kind == index_file.Kind.left_parenthesis || value.kind == index_file.Kind.left_bracket {
            depth += 1
        } else if value.kind == index_file.Kind.right_brace || value.kind == index_file.Kind.right_parenthesis || value.kind == index_file.Kind.right_bracket {
            depth -= 1
            if depth < 0 { break }
        } else if (value.kind == index_file.Kind.statement_end || value.kind == index_file.Kind.end_of_file) && depth == 0 && token > last {
            break
        }
        if value.kind != index_file.Kind.statement_end { last = token }
        token += 1
    }
    const end = index_file.tokenAt(index, file, last)
    return end.start + end.length
}

pub fn memberOfType(index: *index_file.Index, ty: index_file.Ty, name: []const u8) -> u32 {
    if ty.symbol == index_file.NONE { return index_file.NONE }
    if ty.flags & index_file.TY_FUNCTION != 0 { return index_file.NONE }
    const stripped = stripPointers(ty)
    if stripped.depth != 0 {
        // An optional or an array has no members (a slice's len etc. are
        // not declarations).
        return index_file.NONE
    }
    const container = aliasTarget(index, stripped.symbol)
    return index_file.member(index, container, name)
}

// ---------------------------------------------------------------------------
// Scopes

fn pushLocal(index: *index_file.Index, symbol: u32) -> void {
    if symbol == index_file.NONE || index.*.localCount >= index_file.LOCALS { return }
    index.*.locals[index.*.localCount] = symbol
    index.*.localCount += 1
}

// A name seen from `file` inside `self_symbol` (no locals): the file's
// declarations, then the enclosing structs' members.
fn lookupScoped(index: *index_file.Index, file: u32, name: []const u8, self_symbol: u32) -> u32 {
    var container = self_symbol
    var steps: usize = 0
    while container != index_file.NONE && steps < 16 {
        const kind = index_file.symbolAt(index, container).*.kind
        if kind == index_file.FILE { break }
        const found = index_file.member(index, container, name)
        if found != index_file.NONE && index_file.symbolAt(index, found).*.kind != index_file.FIELD { return found }
        container = index_file.symbolAt(index, container).*.parent
        steps += 1
    }
    return index_file.member(index, index_file.fileAt(index, file).*.symbol, name)
}

// A name inside a body: the locals (innermost first), then as above.
fn lookup(index: *index_file.Index, file: u32, name: []const u8) -> u32 {
    var at = index.*.localCount
    while at > 0 {
        at -= 1
        const symbol = index.*.locals[at]
        if index_file.sameBytes(index_file.nameOf(index, symbol), name) { return symbol }
    }
    return lookupScoped(index, file, name, index.*.walkSelf)
}

// ---------------------------------------------------------------------------
// Pass 2: uses

fn addRef(index: *index_file.Index, file: u32, token: usize, symbol: u32, use: u8) -> void {
    if symbol == index_file.NONE || index.*.refCount >= index_file.MAX_REFS { return }
    const value = index_file.tokenAt(index, file, token)
    const ref = index_file.refAt(index, index.*.refCount)
    ref.*.file = file
    ref.*.start = @intCast(u32, value.start)
    ref.*.length = @intCast(u32, value.length)
    ref.*.symbol = symbol
    ref.*.from = index.*.walkFrom
    ref.*.use = use
    index.*.refCount += 1
}

fn declarationRef(index: *index_file.Index, symbol: u32) -> void {
    if symbol == index_file.NONE { return }
    const record = index_file.symbolAt(index, symbol)
    const saved = index.*.walkFrom
    index.*.walkFrom = symbol
    const ref_index = index.*.refCount
    if ref_index >= index_file.MAX_REFS { return }
    const ref = index_file.refAt(index, ref_index)
    ref.*.file = record.*.file
    ref.*.start = record.*.nameStart
    ref.*.length = record.*.nameLength
    ref.*.symbol = symbol
    ref.*.from = if record.*.parent == index_file.NONE { symbol } else { record.*.parent }
    ref.*.use = index_file.USE_DECLARATION
    index.*.refCount += 1
    index.*.walkFrom = saved
}

// A type expression's names.
fn walkType(index: *index_file.Index, file: u32, node: usize) -> void {
    if node == index_file.NODE_NONE { return }
    const value = index_file.nodeAt(index, file, node)
    const tag = value.tag
    if tag == index_file.Tag.named_type {
        const name = index_file.tokenText(index, file, value.mainToken)
        var symbol = index_file.NONE
        if index_file.sameBytes(name, "Self") { symbol = index.*.walkSelf } else { symbol = lookup(index, file, name) }
        index_file.setNodeSymbol(index, file, node, symbol)
        addRef(index, file, value.mainToken, symbol, index_file.USE_TYPE)
        return
    }
    if tag == index_file.Tag.field_expression {
        walkType(index, file, value.lhs)
        const base = typeOfTypeNode(index, file, value.lhs, index.*.walkSelf)
        var symbol = index_file.NONE
        if base.symbol != index_file.NONE && base.depth == 0 { symbol = index_file.member(index, aliasTarget(index, base.symbol), index_file.tokenText(index, file, value.mainToken)) }
        index_file.setNodeSymbol(index, file, node, symbol)
        addRef(index, file, value.mainToken, symbol, index_file.USE_TYPE)
        return
    }
    if tag == index_file.Tag.pointer_type || tag == index_file.Tag.many_pointer_type || tag == index_file.Tag.slice_type || tag == index_file.Tag.optional_type || tag == index_file.Tag.nocopy_type {
        walkType(index, file, value.lhs)
        return
    }
    if tag == index_file.Tag.array_type {
        walkExpression(index, file, value.lhs, index_file.USE_READ)
        walkType(index, file, value.rhs)
        return
    }
    if tag == index_file.Tag.error_union_type {
        walkType(index, file, value.lhs)
        walkType(index, file, value.rhs)
        return
    }
    if tag == index_file.Tag.function_type || tag == index_file.Tag.tuple_type {
        var child = value.lhs
        while child != index_file.NODE_NONE {
            walkType(index, file, child)
            child = index_file.nodeAt(index, file, child).next
        }
        if tag == index_file.Tag.function_type { walkType(index, file, value.extra) }
        return
    }
    if tag == index_file.Tag.struct_type || tag == index_file.Tag.enum_type || tag == index_file.Tag.union_type || tag == index_file.Tag.error_set_type {
        walkAggregate(index, file, node, index_file.nodeSymbol(index, file, node))
        return
    }
    walkExpression(index, file, node, index_file.USE_READ)
}

fn walkList(index: *index_file.Index, file: u32, first: usize) -> void {
    var child = first
    while child != index_file.NODE_NONE {
        walkExpression(index, file, child, index_file.USE_READ)
        child = index_file.nodeAt(index, file, child).next
    }
}

// An expression's names; `use` says how the value is used (read, written,
// called).
fn walkExpression(index: *index_file.Index, file: u32, node: usize, use: u8) -> void {
    if node == index_file.NODE_NONE { return }
    const value = index_file.nodeAt(index, file, node)
    const tag = value.tag
    if tag == index_file.Tag.identifier {
        const name = index_file.tokenText(index, file, value.mainToken)
        var symbol = index_file.NONE
        if index_file.sameBytes(name, "Self") { symbol = index.*.walkSelf } else { symbol = lookup(index, file, name) }
        if symbol == index_file.NONE {
            index.*.unresolved += 1
            return
        }
        index_file.setNodeSymbol(index, file, node, symbol)
        addRef(index, file, value.mainToken, symbol, use)
        return
    }
    if tag == index_file.Tag.field_expression {
        if value.lhs == index_file.NODE_NONE { return }
        walkExpression(index, file, value.lhs, index_file.USE_READ)
        const base = typeOfExpression(index, file, value.lhs, index.*.walkSelf)
        const symbol = memberOfType(index, base, index_file.tokenText(index, file, value.mainToken))
        if symbol == index_file.NONE {
            if base.symbol != index_file.NONE { index.*.unresolved += 1 }
            return
        }
        index_file.setNodeSymbol(index, file, node, symbol)
        addRef(index, file, value.mainToken, symbol, use)
        return
    }
    if tag == index_file.Tag.call_expression {
        walkExpression(index, file, value.lhs, index_file.USE_CALL)
        walkList(index, file, value.rhs)
        return
    }
    if tag == index_file.Tag.builtin_call {
        // Type arguments come as type syntax (walked as types), the rest as
        // expressions.
        walkList(index, file, value.lhs)
        return
    }
    if tag == index_file.Tag.binary_expression {
        const operator = index_file.tokenAt(index, file, value.mainToken).kind
        const assigns = operator >= index_file.Kind.equal && operator <= index_file.Kind.asterisk_pipe_shift_right_equal
        walkExpression(index, file, value.lhs, if assigns { index_file.USE_WRITE } else { index_file.USE_READ })
        walkExpression(index, file, value.rhs, index_file.USE_READ)
        return
    }
    if tag == index_file.Tag.range_expression || tag == index_file.Tag.index_expression {
        walkExpression(index, file, value.lhs, if tag == index_file.Tag.index_expression { use } else { index_file.USE_READ })
        walkExpression(index, file, value.rhs, index_file.USE_READ)
        return
    }
    if tag == index_file.Tag.slice_expression {
        walkExpression(index, file, value.lhs, index_file.USE_READ)
        walkExpression(index, file, value.rhs, index_file.USE_READ)
        walkExpression(index, file, value.extra, index_file.USE_READ)
        return
    }
    if tag == index_file.Tag.unary_expression {
        const operator = index_file.tokenAt(index, file, value.mainToken).kind
        walkExpression(index, file, value.lhs, if operator == index_file.Kind.dot_asterisk { use } else { index_file.USE_READ })
        return
    }
    if tag == index_file.Tag.tuple_literal {
        walkList(index, file, value.lhs)
        return
    }
    if tag == index_file.Tag.array_literal {
        walkType(index, file, value.endToken)
        walkList(index, file, value.lhs)
        return
    }
    if tag == index_file.Tag.aggregate_literal {
        walkType(index, file, value.lhs)
        const base = typeOfTypeNode(index, file, value.lhs, index.*.walkSelf)
        var field = value.rhs
        while field != index_file.NODE_NONE {
            const item = index_file.nodeAt(index, file, field)
            if base.symbol != index_file.NONE && base.depth == 0 {
                const symbol = index_file.member(index, aliasTarget(index, base.symbol), index_file.tokenText(index, file, item.mainToken))
                index_file.setNodeSymbol(index, file, field, symbol)
                addRef(index, file, item.mainToken, symbol, index_file.USE_FIELD_INIT)
            }
            walkExpression(index, file, item.rhs, index_file.USE_READ)
            field = item.next
        }
        return
    }
    if tag == index_file.Tag.if_statement || tag == index_file.Tag.match_statement || tag == index_file.Tag.block {
        walkStatement(index, file, node)
        return
    }
    if tag == index_file.Tag.named_type || tag == index_file.Tag.pointer_type || tag == index_file.Tag.many_pointer_type || tag == index_file.Tag.slice_type || tag == index_file.Tag.array_type || tag == index_file.Tag.optional_type || tag == index_file.Tag.error_union_type || tag == index_file.Tag.function_type || tag == index_file.Tag.struct_type || tag == index_file.Tag.enum_type || tag == index_file.Tag.union_type || tag == index_file.Tag.error_set_type || tag == index_file.Tag.nocopy_type {
        walkType(index, file, node)
        return
    }
}

fn walkBlock(index: *index_file.Index, file: u32, node: usize) -> void {
    if node == index_file.NODE_NONE { return }
    const value = index_file.nodeAt(index, file, node)
    if value.tag != index_file.Tag.block {
        walkStatement(index, file, node)
        return
    }
    const saved = index.*.localCount
    var child = value.lhs
    while child != index_file.NODE_NONE {
        walkStatement(index, file, child)
        child = index_file.nodeAt(index, file, child).next
    }
    index.*.localCount = saved
}

fn walkStatement(index: *index_file.Index, file: u32, node: usize) -> void {
    if node == index_file.NODE_NONE { return }
    const value = index_file.nodeAt(index, file, node)
    const tag = value.tag
    if tag == index_file.Tag.block {
        walkBlock(index, file, node)
        return
    }
    if tag == index_file.Tag.constant_declaration || tag == index_file.Tag.variable_declaration {
        // A local: its type and value first, then it is in scope.
        const symbol = declareBinding(index, file, node, index.*.walkFrom, true)
        walkType(index, file, value.lhs)
        const aggregate = if tag == index_file.Tag.constant_declaration { aggregateOf(index, file, value.rhs) } else { index_file.NODE_NONE }
        if aggregate != index_file.NODE_NONE {
            index_file.setNodeSymbol(index, file, aggregate, symbol)
            walkAggregate(index, file, aggregate, symbol)
        } else {
            walkExpression(index, file, value.rhs, index_file.USE_READ)
        }
        declarationRef(index, symbol)
        pushLocal(index, symbol)
        return
    }
    if tag == index_file.Tag.function_declaration {
        const symbol = declareFunction(index, file, node, index.*.walkFrom)
        pushLocal(index, symbol)
        walkFunction(index, file, symbol)
        return
    }
    if tag == index_file.Tag.if_statement {
        walkExpression(index, file, value.lhs, index_file.USE_READ)
        walkBlock(index, file, value.rhs)
        walkBlock(index, file, value.extra)
        return
    }
    if tag == index_file.Tag.while_statement || tag == index_file.Tag.inline_while_statement {
        walkExpression(index, file, value.lhs, index_file.USE_READ)
        walkExpression(index, file, value.extra, index_file.USE_READ)
        walkBlock(index, file, value.rhs)
        return
    }
    if tag == index_file.Tag.for_statement || tag == index_file.Tag.inline_for_statement {
        walkExpression(index, file, value.lhs, index_file.USE_READ)
        const saved = index.*.localCount
        if value.extra != index_file.NODE_NONE {
            const capture = index_file.nodeAt(index, file, value.extra)
            const item = index_file.addNamed(index, index_file.CAPTURE, file, capture.mainToken, value.extra, index.*.walkFrom)
            if item != index_file.NONE {
                index_file.symbolAt(index, item).*.valueNode = if value.lhs == index_file.NODE_NONE { index_file.NONE } else { @intCast(u32, value.lhs) }
                index_file.symbolAt(index, item).*.firstToken = @intCast(u32, capture.mainToken)
            }
            declarationRef(index, item)
            pushLocal(index, item)
            if capture.endToken != index_file.NODE_NONE {
                const position = index_file.addNamed(index, index_file.CAPTURE, file, capture.endToken, value.extra, index.*.walkFrom)
                if position != index_file.NONE { index_file.symbolAt(index, position).*.firstToken = @intCast(u32, capture.endToken) }
                declarationRef(index, position)
                pushLocal(index, position)
            }
        }
        walkBlock(index, file, value.rhs)
        index.*.localCount = saved
        return
    }
    if tag == index_file.Tag.match_statement {
        walkExpression(index, file, value.lhs, index_file.USE_READ)
        var arm = value.rhs
        while arm != index_file.NODE_NONE {
            const item = index_file.nodeAt(index, file, arm)
            walkExpression(index, file, item.lhs, index_file.USE_READ)
            walkBlock(index, file, item.rhs)
            arm = item.next
        }
        return
    }
    if tag == index_file.Tag.return_statement || tag == index_file.Tag.break_statement {
        walkExpression(index, file, value.rhs, index_file.USE_READ)
        return
    }
    if tag == index_file.Tag.defer_statement || tag == index_file.Tag.error_defer_statement || tag == index_file.Tag.unsafe_block || tag == index_file.Tag.comptime_block {
        walkBlock(index, file, value.lhs)
        return
    }
    if tag == index_file.Tag.continue_statement { return }
    walkExpression(index, file, node, index_file.USE_READ)
}

fn walkFunction(index: *index_file.Index, file: u32, function: u32) -> void {
    if function == index_file.NONE { return }
    const record = index_file.symbolAt(index, function)
    const value = index_file.nodeAt(index, file, @intCast(usize, record.*.node))
    const saved_from = index.*.walkFrom
    const saved_locals = index.*.localCount
    index.*.walkFrom = function
    declarationRef(index, function)
    // The parameters: their types, then in scope.
    var child = record.*.firstChild
    while child != index_file.NONE {
        const parameter = index_file.symbolAt(index, child)
        if parameter.*.kind == index_file.PARAM {
            if parameter.*.typeNode != index_file.NONE { walkType(index, file, @intCast(usize, parameter.*.typeNode)) }
            declarationRef(index, child)
            pushLocal(index, child)
        }
        child = parameter.*.nextSibling
    }
    walkType(index, file, value.extra)
    walkBlock(index, file, value.rhs)
    index.*.localCount = saved_locals
    index.*.walkFrom = saved_from
}

// An aggregate's members: fields' types and defaults, functions' bodies.
fn walkAggregate(index: *index_file.Index, file: u32, node: usize, container: u32) -> void {
    const value = index_file.nodeAt(index, file, node)
    const saved_self = index.*.walkSelf
    if container != index_file.NONE && index_file.symbolAt(index, container).*.kind != index_file.ERROR_SET { index.*.walkSelf = container }
    walkType(index, file, value.extra)
    var child = value.lhs
    while child != index_file.NODE_NONE {
        const item = index_file.nodeAt(index, file, child)
        if item.tag == index_file.Tag.function_declaration {
            var function = index_file.nodeSymbol(index, file, child)
            if function == index_file.NONE {
                // Found by name among the container's members.
                function = index_file.member(index, container, index_file.tokenText(index, file, item.mainToken))
            }
            if function != index_file.NONE && index_file.symbolAt(index, function).*.node == @intCast(u32, child) { walkFunction(index, file, function) }
        } else {
            const symbol = index_file.member(index, container, index_file.tokenText(index, file, item.mainToken))
            if symbol != index_file.NONE && index_file.symbolAt(index, symbol).*.node == @intCast(u32, child) { declarationRef(index, symbol) }
            walkType(index, file, item.lhs)
            walkExpression(index, file, item.rhs, index_file.USE_READ)
        }
        child = item.next
    }
    index.*.walkSelf = saved_self
}

pub fn walkFile(index: *index_file.Index, file: u32) -> void {
    const record = index_file.fileAt(index, file)
    index.*.walkFile = file
    index.*.walkSelf = index_file.NONE
    index.*.localCount = 0
    record.*.refStart = index.*.refCount
    const container = record.*.symbol
    var symbol = index_file.symbolAt(index, container).*.firstChild
    while symbol != index_file.NONE {
        const item = index_file.symbolAt(index, symbol)
        index.*.walkFrom = symbol
        if item.*.kind == index_file.FUNCTION {
            walkFunction(index, file, symbol)
        } else if item.*.kind == index_file.TEST {
            declarationRef(index, symbol)
            walkBlock(index, file, index_file.nodeAt(index, file, @intCast(usize, item.*.node)).rhs)
        } else if item.*.node != index_file.NONE {
            const value = index_file.nodeAt(index, file, @intCast(usize, item.*.node))
            declarationRef(index, symbol)
            walkType(index, file, value.lhs)
            const aggregate = aggregateOf(index, file, value.rhs)
            if aggregate != index_file.NODE_NONE {
                index_file.setNodeSymbol(index, file, aggregate, symbol)
                walkAggregate(index, file, aggregate, symbol)
            } else if item.*.kind == index_file.IMPORT {
                const imported = index_file.importToken(index, file, value.rhs)
                if imported != index_file.NODE_NONE && item.*.target != index_file.NONE { addRef(index, file, imported, item.*.target, index_file.USE_IMPORT) }
            } else {
                walkExpression(index, file, value.rhs, index_file.USE_READ)
            }
        }
        symbol = item.*.nextSibling
    }
    record.*.refEnd = index.*.refCount
    sortRefs(index, record.*.refStart, record.*.refEnd)
}

// A file's uses by where they are (insertion sort on nearly sorted runs,
// in place).
fn sortRefs(index: *index_file.Index, from: usize, to: usize) -> void {
    var at = from + 1
    while at < to {
        const held = index_file.refAt(index, at).*
        var place = at
        while place > from && index_file.refAt(index, place - 1).*.start > held.start {
            index_file.refAt(index, place).* = index_file.refAt(index, place - 1).*
            place -= 1
        }
        index_file.refAt(index, place).* = held
        at += 1
    }
}
