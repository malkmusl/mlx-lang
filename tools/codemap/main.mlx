// mlx-codemap: the connections of an Mlx code base, on the command line
// (for people and for agents): where things are declared and documented,
// who uses, calls and imports what. It indexes every .mlx file under the
// root (tools/codemap/index.mlx) and answers one question.
//
//   mlx-codemap [-C ROOT] COMMAND [ARGUMENT]
//
// Commands (SYMBOL is a name, Container.name, path:name, or FILE:LINE:COL;
// paths are relative to the root, lines and columns count from 1):
//   stats                   files, declarations, uses
//   files [TEXT]            the files (whose path contains TEXT)
//   outline FILE            a file's declarations, nested
//   find TEXT               declarations whose name contains TEXT
//   show SYMBOL             what it is: kind, place, signature, doc,
//                           members, how often it is used
//   def FILE:LINE:COL       the declaration a name there means
//   refs SYMBOL             every use (read, write, call, type, ...)
//   callers SYMBOL          the functions that call it
//   callees SYMBOL          what it calls
//   imports FILE            the files it imports
//   importers FILE          the files that import it
//   members SYMBOL          a type's or module's members
//   unused [PATH]           declarations nothing uses (under PATH)
//   copies [PATH]           functions with the same body: exact copies,
//                           then copies but for names and literals (one
//                           generic function could do), most to gain first
//   names [PATH]            functions of the same name in several files
//   workarounds [PATH]      where the code works around what the language
//                           or compiler does not do yet, by what is
//                           missing, the most written first
//   programs                the programs (files with a main), what each
//                           reaches and its binary, if one is built
//   reach PROGRAM [PATH]    what a program reaches, with the machine code
//                           of each function when its binary is found
//   unreachable [PATH]      functions no program and no check reaches
//   untested [PATH]         functions a program reaches and no check does
//   sizes [PROGRAM] [PATH]  functions by the machine code they became,
//                           biggest first (in all binaries, or in one)
//   complex [PATH]          functions hard to follow (many branches, deep
//                           blocks, long), most first
//   cycles                  files that import each other, round about
//   layers                  imports the rules in codemap.layers forbid
//   churn [PATH]            declarations by the commits that wrote their
//                           lines (git blame, cached), most first
//   risky [PATH]            functions most likely to break: crashes,
//                           workarounds, commits, complexity, copies and
//                           checks together (see measures.mlx), most first
//   hot [PATH]              where the programs spend their time (the
//                           profiles of mlx-profile), most first
//   crashes [PATH]          the crashes the desktop programs kept
//                           ($XDG_STATE_HOME/mlx/crashes.log): the
//                           functions they stopped in or went through,
//                           most first, then each crash, newest first
//   rewrite PATTERN [PATH] [--apply]
//                           rewrites a workaround away (dropped: `_ =`,
//                           counted: `.length`): shows each line before
//                           and after, writes them with --apply once the
//                           compiler accepts the result
//   history [N]             the workarounds at each of the last N commits
//                           (20), per pattern, and each pattern's course
//                           as bars (a commit is counted once, from git
//                           archive, and kept in ~/.cache/mlx/codemap)
//   workarounds-count       the places of each pattern on one line
//   query WORDS | @VIEW     the declarations that answer (kind:fn in:std/
//                           uses:NAME calls:NAME by:NAME crashed
//                           workaround[:KIND] unused unreachable untested
//                           complex risky hot copy changed added
//                           since:REV, - before a word turns it around;
//                           see query.mlx), or a view of codemap.views
//   views                   the views in codemap.views
//   diff [BASE] [OTHER]     declarations added (+), changed (~), removed
//                           (-) since commit BASE (HEAD), in the work tree
//                           or in commit OTHER
//   unresolved FILE         names the index could not follow
//   json                    the whole map as JSON (files, declarations,
//                           uses)
const std = @import("std")
const index_module = @import("./index.mlx")
const out_module = @import("./out.mlx")
const analysis_module = @import("./analysis.mlx")
const aggregates = @import("./aggregates.mlx")
const crashes_module = @import("./crashes.mlx")
const workarounds_module = @import("./workarounds.mlx")
const programs_module = @import("./programs.mlx")
const binaries_module = @import("./binaries.mlx")
const complexity_module = @import("./complexity.mlx")
const structure_module = @import("./structure.mlx")
const git_module = @import("./git.mlx")
const history_module = @import("./history.mlx")
const profiles_module = @import("./profiles.mlx")
const measures_module = @import("./measures.mlx")
const rewrite_module = @import("./rewrite.mlx")
const trend_module = @import("./trend.mlx")
const diff_module = @import("./diff.mlx")
const query_module = @import("./query.mlx")
const views_module = @import("./views.mlx")

const Index = index_module.Index
const Out = out_module.Out
const NONE = index_module.NONE

const Context = struct {
    index: *Index
    out: *Out
    root: [*]const u8
    rootLength: usize
}

fn cString(value: [*]const u8) -> []const u8 {
    var length: usize = 0
    while value[length] != 0 { length += 1 }
    return value[0..length]
}

fn say(context: *Context, text: []const u8) -> void { out_module.text(context.*.out, text) }
fn sayNumber(context: *Context, value: usize) -> void { out_module.number(context.*.out, value) }
fn newline(context: *Context) -> void { out_module.line(context.*.out) }

// A path relative to the root.
fn shortPath(context: *Context, path: []const u8) -> []const u8 {
    const root = context.*.root[0..context.*.rootLength]
    if path.length > root.length + 1 && index_module.sameBytes(path[0..root.length], root) && path[root.length] == 47 { return path[root.length + 1..path.length] }
    return path
}

fn endsWith(text: []const u8, suffix: []const u8) -> bool {
    return text.length >= suffix.length && index_module.sameBytes(text[text.length - suffix.length..text.length], suffix)
}

fn contains(text: []const u8, part: []const u8) -> bool {
    if part.length == 0 { return true }
    if part.length > text.length { return false }
    var start: usize = 0
    while start + part.length <= text.length {
        if index_module.sameBytes(text[start..start + part.length], part) { return true }
        start += 1
    }
    return false
}

// "path:line:col" of byte `offset` in `file`.
fn sayPlace(context: *Context, file: u32, offset: usize) -> void {
    const index = context.*.index
    say(context, shortPath(context, index_module.pathOf(index, file)))
    say(context, ":")
    sayNumber(context, index_module.lineOf(index, file, offset) + 1)
    say(context, ":")
    sayNumber(context, index_module.columnOf(index, file, offset) + 1)
}

// A symbol's name with its containers ("Files.scroll").
fn sayQualified(context: *Context, symbol: u32) -> void {
    const index = context.*.index
    const parent = index_module.symbolAt(index, symbol).*.parent
    if parent != NONE && index_module.symbolAt(index, parent).*.kind != index_module.FILE {
        sayQualified(context, parent)
        say(context, ".")
    }
    say(context, index_module.nameOf(index, symbol))
}

// "path:line:col: kind Qualified.name"
fn sayDeclaration(context: *Context, symbol: u32) -> void {
    const index = context.*.index
    const record = index_module.symbolAt(index, symbol)
    if record.*.kind == index_module.FILE {
        say(context, shortPath(context, index_module.pathOf(index, record.*.file)))
        say(context, ":1:1: file")
        return
    }
    sayPlace(context, record.*.file, @intCast(usize, record.*.nameStart))
    say(context, ": ")
    say(context, index_module.kindName(record.*.kind))
    say(context, " ")
    sayQualified(context, symbol)
}

// The source line around byte `offset`, trimmed.
fn sayLine(context: *Context, file: u32, offset: usize) -> void {
    const source = index_module.sourceOf(context.*.index, file)
    var start = offset
    while start > 0 && source[start - 1] != 10 { start -= 1 }
    while start < source.length && (source[start] == 32 || source[start] == 9) { start += 1 }
    var end = offset
    while end < source.length && source[end] != 10 { end += 1 }
    if end - start > 160 { end = start + 160 }
    say(context, source[start..end])
}

// ---------------------------------------------------------------------------
// Finding what an argument names

// Whether `symbol`'s qualified name ends with `spec` (at a dot).
fn qualifiedMatches(index: *Index, symbol: u32, spec: []const u8) -> bool {
    var rest = spec.length
    var current = symbol
    while current != NONE {
        const record = index_module.symbolAt(index, current)
        if record.*.kind == index_module.FILE { return false }
        const name = index_module.nameOf(index, current)
        if name.length > rest { return false }
        if !index_module.sameBytes(spec[rest - name.length..rest], name) { return false }
        rest -= name.length
        if rest == 0 { return true }
        if spec[rest - 1] != 46 { return false }
        rest -= 1
        current = record.*.parent
    }
    return false
}

fn fileMatches(context: *Context, file: u32, path: []const u8) -> bool {
    const full = index_module.pathOf(context.*.index, file)
    return endsWith(full, path) && (full.length == path.length || full[full.length - path.length - 1] == 47)
}

// FILE:LINE:COL, when the argument is one: the file, the byte.
fn positionOf(context: *Context, spec: []const u8, file: *u32, offset: *usize) -> bool {
    // The last two colon-separated parts are numbers.
    var second = spec.length
    while second > 0 && spec[second - 1] != 58 { second -= 1 }
    if second == 0 { return false }
    var first = second - 1
    while first > 0 && spec[first - 1] != 58 { first -= 1 }
    if first == 0 { return false }
    var line: usize = 0
    var column: usize = 0
    var at = first
    while at < second - 1 {
        if spec[at] < 48 || spec[at] > 57 { return false }
        line = line * 10 + @intCast(usize, spec[at] - 48)
        at += 1
    }
    at = second
    if at >= spec.length { return false }
    while at < spec.length {
        if spec[at] < 48 || spec[at] > 57 { return false }
        column = column * 10 + @intCast(usize, spec[at] - 48)
        at += 1
    }
    const path = spec[0..first - 1]
    const index = context.*.index
    var candidate: usize = 0
    while candidate < index.*.fileCount {
        if fileMatches(context, @intCast(u32, candidate), path) {
            file.* = @intCast(u32, candidate)
            offset.* = index_module.offsetOf(index, file.*, if line > 0 { line - 1 } else { 0 }, if column > 0 { column - 1 } else { 0 })
            return true
        }
        candidate += 1
    }
    return false
}

fn findFileSpec(context: *Context, path: []const u8) -> u32 {
    const index = context.*.index
    var candidate: usize = 0
    while candidate < index.*.fileCount {
        if fileMatches(context, @intCast(u32, candidate), path) { return @intCast(u32, candidate) }
        candidate += 1
    }
    return NONE
}

// The symbols an argument names (at most `capacity` into `found`).
fn resolveSpec(context: *Context, spec: []const u8, found: [*]u32, capacity: usize) -> usize {
    const index = context.*.index
    var file: u32 = 0
    var offset: usize = 0
    if positionOf(context, spec, &file, &offset) {
        const symbol = index_module.symbolAtOffset(index, file, offset)
        if symbol == NONE { return 0 }
        found[0] = symbol
        return 1
    }
    // path:name
    var colon = spec.length
    while colon > 0 && spec[colon - 1] != 58 { colon -= 1 }
    var only_file = NONE
    if colon > 0 {
        only_file = findFileSpec(context, spec[0..colon - 1])
        if only_file == NONE { return 0 }
    }
    const name = spec[colon..spec.length]
    // A file itself.
    if colon == 0 && endsWith(spec, ".mlx") {
        const whole = findFileSpec(context, spec)
        if whole != NONE {
            found[0] = index_module.fileAt(index, whole).*.symbol
            return 1
        }
    }
    var count: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount && count < capacity {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        const local = record.*.kind == index_module.LOCAL_CONST || record.*.kind == index_module.LOCAL_VAR || record.*.kind == index_module.CAPTURE || record.*.kind == index_module.PARAM
        if (only_file == NONE || record.*.file == only_file) && (!local || only_file != NONE) && qualifiedMatches(index, id, name) {
            found[count] = id
            count += 1
        }
        symbol += 1
    }
    return count
}

fn noMatch(context: *Context, spec: []const u8) -> void {
    say(context, "mlx-codemap: nothing named ")
    say(context, spec)
    newline(context)
}

// ---------------------------------------------------------------------------
// Commands

fn stats(context: *Context) -> void {
    const index = context.*.index
    say(context, "files ")
    sayNumber(context, index.*.fileCount)
    say(context, ", declarations ")
    sayNumber(context, index.*.symbolCount)
    say(context, ", uses ")
    sayNumber(context, index.*.refCount)
    say(context, ", names not followed ")
    sayNumber(context, index.*.unresolved)
    newline(context)
}

fn files(context: *Context, filter: []const u8) -> void {
    const index = context.*.index
    var file: usize = 0
    while file < index.*.fileCount {
        const path = shortPath(context, index_module.pathOf(index, @intCast(u32, file)))
        if contains(path, filter) {
            say(context, path)
            newline(context)
        }
        file += 1
    }
}

fn outlineOf(context: *Context, container: u32, depth: usize) -> void {
    const index = context.*.index
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != NONE {
        const record = index_module.symbolAt(index, child)
        const kind = record.*.kind
        const shown = kind != index_module.LOCAL_CONST && kind != index_module.LOCAL_VAR && kind != index_module.CAPTURE && kind != index_module.PARAM
        if shown {
            var indent: usize = 0
            while indent < depth {
                say(context, "  ")
                indent += 1
            }
            sayNumber(context, index_module.lineOf(index, record.*.file, @intCast(usize, record.*.nameStart)) + 1)
            say(context, " ")
            say(context, index_module.kindName(kind))
            say(context, " ")
            say(context, index_module.nameOf(index, child))
            if record.*.flags & index_module.FLAG_PUB != 0 { say(context, " (pub)") }
            newline(context)
            if kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION { outlineOf(context, child, depth + 1) }
        }
        child = record.*.nextSibling
    }
}

fn outline(context: *Context, path: []const u8) -> void {
    const file = findFileSpec(context, path)
    if file == NONE {
        noMatch(context, path)
        return
    }
    outlineOf(context, index_module.fileAt(context.*.index, file).*.symbol, 0)
}

fn find(context: *Context, text: []const u8) -> void {
    const index = context.*.index
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const kind = index_module.symbolAt(index, id).*.kind
        if kind != index_module.FILE && kind != index_module.LOCAL_CONST && kind != index_module.LOCAL_VAR && kind != index_module.CAPTURE && kind != index_module.PARAM && contains(index_module.nameOf(index, id), text) {
            sayDeclaration(context, id)
            newline(context)
        }
        symbol += 1
    }
}

// How often a symbol is used, by kind of use.
fn useCounts(context: *Context, symbol: u32, counts: [*]usize) -> void {
    const index = context.*.index
    var at: usize = 0
    while at < 8 {
        counts[at] = 0
        at += 1
    }
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol { counts[@intCast(usize, value.*.use)] += 1 }
        ref += 1
    }
}

fn sayRange(context: *Context, file: u32, start: usize, length: usize) -> void {
    const source = index_module.sourceOf(context.*.index, file)
    say(context, source[start..start + length])
}

fn showOne(context: *Context, symbol: u32) -> void {
    const index = context.*.index
    const record = index_module.symbolAt(index, symbol)
    sayDeclaration(context, symbol)
    newline(context)
    var start: usize = 0
    var length: usize = 0
    index_module.docRange(index, symbol, &start, &length)
    if length > 0 {
        sayRange(context, record.*.file, start, length)
    }
    if record.*.kind != index_module.FILE {
        index_module.signatureRange(index, symbol, &start, &length)
        say(context, "    ")
        sayRange(context, record.*.file, start, length)
        newline(context)
    }
    if record.*.parent != NONE {
        say(context, "  in ")
        sayDeclaration(context, record.*.parent)
        newline(context)
    }
    var counts: [8]usize = undefined
    var bytes: [*]usize = undefined
    unsafe { bytes = @ptrCast([*]usize, &counts) }
    useCounts(context, symbol, bytes)
    say(context, "  used: ")
    var use: usize = 1
    var total: usize = 0
    while use < 7 {
        if bytes[use] > 0 {
            if total > 0 { say(context, ", ") }
            sayNumber(context, bytes[use])
            say(context, " ")
            say(context, index_module.useName(@intCast(u8, use)))
            total += bytes[use]
        }
        use += 1
    }
    if total == 0 { say(context, "never") }
    newline(context)
    // Its members.
    var child = record.*.firstChild
    var shown: usize = 0
    while child != NONE {
        const item = index_module.symbolAt(index, child)
        if item.*.kind != index_module.LOCAL_CONST && item.*.kind != index_module.LOCAL_VAR && item.*.kind != index_module.CAPTURE {
            if shown == 0 {
                say(context, "  members:")
                newline(context)
            }
            say(context, "    ")
            say(context, index_module.kindName(item.*.kind))
            say(context, " ")
            say(context, index_module.nameOf(index, child))
            newline(context)
            shown += 1
        }
        child = item.*.nextSibling
    }
    newline(context)
}

fn withSymbols(context: *Context, spec: []const u8, command: u8) -> void {
    var found: [64]u32 = undefined
    var list: [*]u32 = undefined
    unsafe { list = @ptrCast([*]u32, &found) }
    const count = resolveSpec(context, spec, list, 64)
    if count == 0 {
        noMatch(context, spec)
        return
    }
    var at: usize = 0
    while at < count {
        const symbol = list[at]
        if command == 0 { showOne(context, symbol) }
        if command == 1 { refs(context, symbol, count > 1) }
        if command == 2 { callers(context, symbol) }
        if command == 3 { callees(context, symbol) }
        if command == 4 { members(context, symbol) }
        if command == 5 {
            sayDeclaration(context, symbol)
            newline(context)
        }
        at += 1
    }
}

fn refs(context: *Context, symbol: u32, heading: bool) -> void {
    const index = context.*.index
    if heading {
        say(context, "== ")
        sayDeclaration(context, symbol)
        newline(context)
    }
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol {
            sayPlace(context, value.*.file, @intCast(usize, value.*.start))
            say(context, ": ")
            say(context, index_module.useName(value.*.use))
            say(context, ": ")
            sayLine(context, value.*.file, @intCast(usize, value.*.start))
            newline(context)
        }
        ref += 1
    }
}

// The function (or top-level declaration) a use is in.
fn enclosingFunction(context: *Context, symbol: u32) -> u32 {
    const index = context.*.index
    var current = symbol
    while current != NONE {
        const kind = index_module.symbolAt(index, current).*.kind
        if kind == index_module.FUNCTION || kind == index_module.TEST { return current }
        const parent = index_module.symbolAt(index, current).*.parent
        if parent == NONE || index_module.symbolAt(index, parent).*.kind == index_module.FILE { return current }
        current = parent
    }
    return symbol
}

fn callers(context: *Context, symbol: u32) -> void {
    const index = context.*.index
    say(context, "== callers of ")
    sayDeclaration(context, symbol)
    newline(context)
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol && value.*.use == index_module.USE_CALL && value.*.from != NONE {
            sayPlace(context, value.*.file, @intCast(usize, value.*.start))
            say(context, ": ")
            sayQualified(context, enclosingFunction(context, value.*.from))
            newline(context)
        }
        ref += 1
    }
}

fn callees(context: *Context, symbol: u32) -> void {
    const index = context.*.index
    say(context, "== called by ")
    sayDeclaration(context, symbol)
    newline(context)
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use == index_module.USE_CALL && value.*.from != NONE && enclosingFunction(context, value.*.from) == symbol {
            sayPlace(context, value.*.file, @intCast(usize, value.*.start))
            say(context, ": ")
            sayDeclaration(context, value.*.symbol)
            newline(context)
        }
        ref += 1
    }
}

fn members(context: *Context, symbol: u32) -> void {
    const index = context.*.index
    var container = symbol
    const kind = index_module.symbolAt(index, symbol).*.kind
    if kind == index_module.IMPORT || kind == index_module.ALIAS { container = index_module.symbolAt(index, symbol).*.target }
    if container == NONE { return }
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != NONE {
        const record = index_module.symbolAt(index, child)
        if record.*.kind != index_module.LOCAL_CONST && record.*.kind != index_module.LOCAL_VAR && record.*.kind != index_module.CAPTURE && record.*.kind != index_module.PARAM {
            sayDeclaration(context, child)
            newline(context)
        }
        child = record.*.nextSibling
    }
}

fn imports(context: *Context, path: []const u8, reverse: bool) -> void {
    const index = context.*.index
    const file = findFileSpec(context, path)
    if file == NONE {
        noMatch(context, path)
        return
    }
    const target = index_module.fileAt(index, file).*.symbol
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use == index_module.USE_IMPORT {
            if !reverse && value.*.file == file {
                say(context, shortPath(context, index_module.pathOf(index, index_module.symbolAt(index, value.*.symbol).*.file)))
                newline(context)
            }
            if reverse && value.*.symbol == target {
                sayPlace(context, value.*.file, @intCast(usize, value.*.start))
                newline(context)
            }
        }
        ref += 1
    }
}

fn unused(context: *Context, prefix: []const u8) -> void {
    const index = context.*.index
    // Uses per symbol.
    const pages = std.page_allocator.init()
    const memory = pages.alloc(index.*.symbolCount * 4 + 4, 16)
    var used: [*]u32 = undefined
    unsafe { used = @ptrCast([*]u32, memory.?) }
    var at: usize = 0
    while at < index.*.symbolCount {
        used[at] = 0
        at += 1
    }
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use != index_module.USE_DECLARATION { used[@intCast(usize, value.*.symbol)] += 1 }
        ref += 1
    }
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        const kind = record.*.kind
        const counted = kind == index_module.FUNCTION || kind == index_module.CONST || kind == index_module.VAR || kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.FIELD || kind == index_module.ALIAS || kind == index_module.IMPORT
        const path = shortPath(context, index_module.pathOf(index, record.*.file))
        const is_main = index_module.sameBytes(index_module.nameOf(index, id), "main")
        if counted && used[symbol] == 0 && !is_main && path.length >= prefix.length && index_module.sameBytes(path[0..prefix.length], prefix) {
            sayDeclaration(context, id)
            if record.*.flags & index_module.FLAG_PUB != 0 { say(context, " (pub)") }
            newline(context)
        }
        symbol += 1
    }
}

// Whether any member of a group lies under `prefix`.
fn groupUnder(context: *Context, members: []const u32, prefix: []const u8) -> bool {
    for symbol in members {
        const path = shortPath(context, index_module.pathOf(context.*.index, index_module.symbolAt(context.*.index, symbol).*.file))
        if path.length >= prefix.length && index_module.sameBytes(path[0..prefix.length], prefix) { return true }
    }
    return false
}

fn findings(context: *Context, kinds: [2]u8, prefix: []const u8) -> void {
    const index = context.*.index
    var analysis: analysis_module.Analysis = undefined
    analysis_module.init(&analysis, std.page_allocator.init())
    analysis_module.run(&analysis, index)
    const order = std.page_allocator.init().alloc(index.*.symbolCount * 4 + 4, 16).?
    var ranked: [*]u32 = undefined
    unsafe { ranked = @ptrCast([*]u32, order) }
    for kind in kinds {
        if kind == 255 { continue }
        const count = analysis_module.ranked(&analysis, kind, ranked)
        var at: usize = 0
        while at < count {
            const group = @intCast(usize, ranked[at])
            const members = analysis_module.groupMembers(&analysis, kind, group)
            if groupUnder(context, members, prefix) {
                say(context, "== ")
                sayNumber(context, members.length)
                if kind == analysis_module.COPIES { say(context, " exact copies, ") }
                if kind == analysis_module.SHAPES { say(context, " copies but for names and literals, ") }
                if kind == analysis_module.NAMES {
                    say(context, " functions called ")
                    say(context, index_module.nameOf(index, members[0]))
                } else {
                    sayNumber(context, @intCast(usize, analysis_module.bodySize(&analysis, members[0])))
                    say(context, " tokens each")
                }
                newline(context)
                for symbol in members {
                    say(context, "   ")
                    sayDeclaration(context, symbol)
                    say(context, " (used ")
                    sayNumber(context, @intCast(usize, analysis_module.usesOf(&analysis, symbol)))
                    say(context, "x)")
                    newline(context)
                }
            }
            at += 1
        }
    }
}

fn underPrefix(context: *Context, symbol: u32, prefix: []const u8) -> bool {
    if symbol == NONE { return prefix.length == 0 }
    const path = shortPath(context, index_module.pathOf(context.*.index, index_module.symbolAt(context.*.index, symbol).*.file))
    return path.length >= prefix.length && index_module.sameBytes(path[0..prefix.length], prefix)
}

// The programs and their binaries, worked out once.
fn programsOf(context: *Context, environment: [*][*]const u8, programs: *programs_module.Programs, binaries: *binaries_module.Binaries) -> void {
    const allocator = std.page_allocator.init()
    programs_module.init(programs, allocator)
    programs_module.run(programs, context.*.index)
    binaries_module.init(binaries, allocator)
    var directories: [8192]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &directories) }
    const length = binaries_module.defaultDirectories(context.*.root[0..context.*.rootLength], environment, bytes)
    binaries_module.scan(binaries, context.*.index, programs, bytes[0..length])
}

fn findProgram(context: *Context, programs: *programs_module.Programs, name: []const u8) -> usize {
    var program: usize = 0
    while program < programs.*.count {
        if index_module.sameBytes(programs_module.nameOf(programs, program), name) { return program }
        program += 1
    }
    say(context, "no program called ")
    say(context, name)
    say(context, " (mlx-codemap programs lists them)")
    newline(context)
    return programs.*.count
}

fn sayBytes(context: *Context, bytes: usize) -> void {
    sayNumber(context, bytes)
    say(context, " bytes")
}

fn listPrograms(context: *Context, environment: [*][*]const u8) -> void {
    var programs: programs_module.Programs = undefined
    var binaries: binaries_module.Binaries = undefined
    programsOf(context, environment, &programs, &binaries)
    var program: usize = 0
    while program < programs.count {
        say(context, programs_module.nameOf(&programs, program))
        say(context, ": ")
        say(context, programs_module.relativePath(context.*.index, programs.file[program]))
        say(context, ", reaches ")
        sayNumber(context, programs.size[program])
        say(context, " declarations")
        const binary = binaries_module.binaryOf(&binaries, program)
        if binary < binaries.count {
            say(context, ", built: ")
            say(context, binaries_module.pathOf(&binaries, binary))
            say(context, " (")
            sayBytes(context, binaries.total[binary])
            say(context, " of code)")
        }
        newline(context)
        program += 1
    }
}

// Functions (under `prefix`) for which `keep` says yes, with their size.
fn listFunctions(context: *Context, programs: *programs_module.Programs, binaries: *binaries_module.Binaries, which: u8, program: usize, prefix: []const u8) -> void {
    const index = context.*.index
    var count: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const value = index_module.symbolAt(index, id)
        var keep = false
        if which == 0 { keep = isListed(value.*.kind) && programs_module.reaches(programs, program, id) }
        if which == 1 { keep = programs_module.isUnreachable(programs, id) && binaries_module.bytesOf(binaries, id) == 0 }
        if which == 2 { keep = programs_module.isUntested(programs, id) }
        if keep && underPrefix(context, id, prefix) {
            sayDeclaration(context, id)
            const bytes = binaries_module.bytesOf(binaries, id)
            if bytes > 0 {
                say(context, " (")
                sayBytes(context, @intCast(usize, bytes))
                say(context, ")")
            }
            newline(context)
            count += 1
        }
        symbol += 1
    }
    say(context, "-- ")
    sayNumber(context, count)
    newline(context)
}

fn isListed(kind: u8) -> bool {
    return kind == index_module.FUNCTION || kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.CONST || kind == index_module.VAR
}

fn reachCommand(context: *Context, environment: [*][*]const u8, which: u8, name: []const u8, prefix: []const u8) -> void {
    var programs: programs_module.Programs = undefined
    var binaries: binaries_module.Binaries = undefined
    programsOf(context, environment, &programs, &binaries)
    var program: usize = 0
    if which == 0 {
        program = findProgram(context, &programs, name)
        if program >= programs.count { return }
        const binary = binaries_module.binaryOf(&binaries, program)
        binaries_module.choose(&binaries, if binary < binaries.count { binary } else { binaries_module.ALL })
    }
    listFunctions(context, &programs, &binaries, which, program, prefix)
}

// Functions by their machine code, biggest first.
fn sizes(context: *Context, environment: [*][*]const u8, first: []const u8, second: []const u8) -> void {
    const index = context.*.index
    var programs: programs_module.Programs = undefined
    var binaries: binaries_module.Binaries = undefined
    programsOf(context, environment, &programs, &binaries)
    if binaries.count == 0 {
        say(context, "no binaries with a symbol table found (build the programs with a current mlx4; MLX_CODEMAP_BINARIES names more directories)")
        newline(context)
        return
    }
    // A program's name first, else a path (slices are not assigned again:
    // the compiler keeps the old length).
    var program: usize = programs.count
    var at: usize = 0
    while at < programs.count && first.length > 0 {
        if index_module.sameBytes(programs_module.nameOf(&programs, at), first) { program = at }
        at += 1
    }
    const prefix = if program < programs.count { second } else { first }
    if program < programs.count {
        const binary = binaries_module.binaryOf(&binaries, program)
        if binary >= binaries.count {
            say(context, "no binary of ")
            say(context, first)
            say(context, " found")
            newline(context)
            return
        }
        binaries_module.choose(&binaries, binary)
    }
    const order = std.page_allocator.init().alloc(index.*.symbolCount * 8 + 8, 16).?
    var keys: [*]u64 = undefined
    unsafe { keys = @ptrCast([*]u64, order) }
    var count: usize = 0
    var total: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const bytes = binaries_module.bytesOf(&binaries, @intCast(u32, symbol))
        if bytes > 0 && underPrefix(context, @intCast(u32, symbol), prefix) {
            keys[count] = (@intCast(u64, 4294967295 - bytes) << 32) | @intCast(u64, symbol)
            count += 1
            total += @intCast(usize, bytes)
        }
        symbol += 1
    }
    sortLongs(keys, count)
    at = 0
    while at < count {
        const id = @intCast(u32, keys[at] & 4294967295)
        sayDeclaration(context, id)
        say(context, " ")
        sayBytes(context, @intCast(usize, binaries_module.bytesOf(&binaries, id)))
        newline(context)
        at += 1
    }
    say(context, "-- ")
    sayNumber(context, count)
    say(context, " functions, ")
    sayBytes(context, total)
    newline(context)
}

fn sortLongs(values: [*]u64, count: usize) -> void {
    var gap = count / 2
    while gap > 0 {
        var at = gap
        while at < count {
            const value = values[at]
            var place = at
            while place >= gap && values[place - gap] > value {
                values[place] = values[place - gap]
                place -= gap
            }
            values[place] = value
            at += 1
        }
        gap /= 2
    }
}

fn complex(context: *Context, prefix: []const u8) -> void {
    const index = context.*.index
    var complexity: complexity_module.Complexity = undefined
    complexity_module.init(&complexity, std.page_allocator.init())
    complexity_module.run(&complexity, index)
    const order = std.page_allocator.init().alloc(index.*.symbolCount * 8 + 8, 16).?
    var keys: [*]u64 = undefined
    unsafe { keys = @ptrCast([*]u64, order) }
    var count: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        if complexity_module.isComplex(&complexity, id) && underPrefix(context, id, prefix) {
            keys[count] = (@intCast(u64, 4294967295 - complexity_module.scoreOf(&complexity, id)) << 32) | @intCast(u64, symbol)
            count += 1
        }
        symbol += 1
    }
    sortLongs(keys, count)
    var at: usize = 0
    while at < count {
        const id = @intCast(u32, keys[at] & 4294967295)
        sayDeclaration(context, id)
        say(context, " (")
        sayNumber(context, @intCast(usize, complexity_module.branchesOf(&complexity, id)))
        say(context, " branches, ")
        sayNumber(context, @intCast(usize, complexity_module.depthOf(&complexity, id)))
        say(context, " deep, ")
        sayNumber(context, @intCast(usize, complexity_module.tokensOf(&complexity, id)))
        say(context, " tokens, ")
        sayNumber(context, @intCast(usize, complexity_module.parametersOf(&complexity, id)))
        say(context, " parameters)")
        newline(context)
        at += 1
    }
    say(context, "-- ")
    sayNumber(context, count)
    newline(context)
}

fn structureCommand(context: *Context, layers: bool) -> void {
    const index = context.*.index
    var structure: structure_module.Structure = undefined
    structure_module.init(&structure, std.page_allocator.init())
    structure_module.run(&structure, index)
    if !layers {
        var cycle: usize = 0
        while cycle < structure.cycleCount {
            const members = structure_module.cycleMembers(&structure, cycle)
            say(context, "== ")
            sayNumber(context, members.length)
            say(context, " files import each other")
            newline(context)
            for file in members {
                say(context, "   ")
                say(context, programs_module.relativePath(index, file))
                newline(context)
            }
            cycle += 1
        }
        say(context, "-- ")
        sayNumber(context, structure.cycleCount)
        say(context, " cycles")
        newline(context)
        return
    }
    var at: usize = 0
    while at < structure.brokenCount {
        const import = @intCast(usize, structure.broken[at])
        const rule = @intCast(usize, structure.brokenRule[at])
        const symbol = structure.importAt[import]
        sayPlace(context, structure.importFrom[import], @intCast(usize, index_module.symbolAt(index, symbol).*.nameStart))
        say(context, ": imports ")
        say(context, programs_module.relativePath(index, structure.importTo[import]))
        say(context, " (")
        say(context, structure_module.ruleFrom(&structure, rule))
        say(context, " !-> ")
        say(context, structure_module.ruleTo(&structure, rule))
        say(context, ")")
        newline(context)
        at += 1
    }
    say(context, "-- ")
    sayNumber(context, structure.brokenCount)
    say(context, " imports against the rules")
    newline(context)
}

fn churn(context: *Context, environment: [*][*]const u8, prefix: []const u8) -> void {
    const index = context.*.index
    const allocator = std.page_allocator.init()
    var git: git_module.Git = undefined
    git_module.init(&git, allocator, context.*.root[0..context.*.rootLength], environment)
    if !git_module.usable(&git) {
        say(context, "the root is not in a Git work tree (or git is missing)")
        newline(context)
        return
    }
    var history: history_module.History = undefined
    history_module.init(&history, allocator, &git)
    history_module.start(&history, index)
    while !history_module.step(&history, 1000000) {}
    const order = allocator.alloc(index.*.symbolCount * 8 + 8, 16).?
    var keys: [*]u64 = undefined
    unsafe { keys = @ptrCast([*]u64, order) }
    var count: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const commits = history_module.commitsOf(&history, id)
        if commits > 0 && index_module.symbolAt(index, id).*.kind == index_module.FUNCTION && underPrefix(context, id, prefix) {
            keys[count] = (@intCast(u64, 4294967295 - commits) << 32) | @intCast(u64, symbol)
            count += 1
        }
        symbol += 1
    }
    sortLongs(keys, count)
    var at: usize = 0
    while at < count && at < 200 {
        const id = @intCast(u32, keys[at] & 4294967295)
        sayDeclaration(context, id)
        say(context, " (")
        sayNumber(context, @intCast(usize, history_module.commitsOf(&history, id)))
        say(context, " commits, the file ")
        sayNumber(context, @intCast(usize, history_module.fileCommitsOf(&history, index_module.symbolAt(index, id).*.file)))
        say(context, ")")
        newline(context)
        at += 1
    }
    say(context, "-- ")
    sayNumber(context, count)
    newline(context)
}

// Every measure, for risky: all modules run (the history from its cache
// where it can).
fn measureAll(context: *Context, environment: [*][*]const u8, measures: *measures_module.Measures, with_history: bool) -> void {
    const index = context.*.index
    const allocator = std.page_allocator.init()
    measures.*.index = index
    const analysis = @ptrCast(*analysis_module.Analysis, allocator.alloc(@sizeOf(analysis_module.Analysis), 16).?)
    analysis_module.init(analysis, allocator)
    analysis_module.run(analysis, index)
    measures.*.analysis = @intFromPtr(analysis)
    const found = @ptrCast(*workarounds_module.Workarounds, allocator.alloc(@sizeOf(workarounds_module.Workarounds), 16).?)
    workarounds_module.init(found, allocator)
    workarounds_module.run(found, index)
    measures.*.workarounds = @intFromPtr(found)
    const kept = @ptrCast(*crashes_module.Crashes, allocator.alloc(@sizeOf(crashes_module.Crashes), 16).?)
    crashes_module.init(kept, allocator)
    var path_buffer: [4096]u8 = undefined
    var path: [*]u8 = undefined
    unsafe { path = @ptrCast([*]u8, &path_buffer) }
    if crashes_module.logPath(environment, path) == 0 { path[0] = 0 }
    crashes_module.load(kept, index, path)
    measures.*.crashes = @intFromPtr(kept)
    const programs = @ptrCast(*programs_module.Programs, allocator.alloc(@sizeOf(programs_module.Programs), 16).?)
    const binaries = @ptrCast(*binaries_module.Binaries, allocator.alloc(@sizeOf(binaries_module.Binaries), 16).?)
    programsOf(context, environment, programs, binaries)
    measures.*.programs = @intFromPtr(programs)
    measures.*.binaries = @intFromPtr(binaries)
    const complexity = @ptrCast(*complexity_module.Complexity, allocator.alloc(@sizeOf(complexity_module.Complexity), 16).?)
    complexity_module.init(complexity, allocator)
    complexity_module.run(complexity, index)
    measures.*.complexity = @intFromPtr(complexity)
    measures.*.history = 0
    if with_history {
        const git = @ptrCast(*git_module.Git, allocator.alloc(@sizeOf(git_module.Git), 16).?)
        git_module.init(git, allocator, context.*.root[0..context.*.rootLength], environment)
        if git_module.usable(git) {
            const history = @ptrCast(*history_module.History, allocator.alloc(@sizeOf(history_module.History), 16).?)
            history_module.init(history, allocator, git)
            history_module.start(history, index)
            while !history_module.step(history, 1000000) {}
            measures.*.history = @intFromPtr(history)
        }
    }
    const profiles = @ptrCast(*profiles_module.Profiles, allocator.alloc(@sizeOf(profiles_module.Profiles), 16).?)
    profiles_module.init(profiles, allocator)
    profiles_module.load(profiles, index, environment)
    measures.*.profiles = @intFromPtr(profiles)
}

// Functions by a measure, most first (risky: from RISKY on; hot: with
// samples).
fn ranking(context: *Context, environment: [*][*]const u8, metric: u8, prefix: []const u8) -> void {
    const index = context.*.index
    var measures: measures_module.Measures = undefined
    measureAll(context, environment, &measures, metric == measures_module.RISK)
    const order = std.page_allocator.init().alloc(index.*.symbolCount * 8 + 8, 16).?
    var keys: [*]u64 = undefined
    unsafe { keys = @ptrCast([*]u64, order) }
    var count: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const worth = measures_module.value(&measures, metric, id)
        const listed = if metric == measures_module.RISK { worth >= measures_module.RISKY } else { worth > 0 }
        if listed && index_module.symbolAt(index, id).*.kind == index_module.FUNCTION && underPrefix(context, id, prefix) {
            keys[count] = (@intCast(u64, 4294967295 - (if worth > 4294967295 { 4294967295 } else { worth })) << 32) | @intCast(u64, symbol)
            count += 1
        }
        symbol += 1
    }
    sortLongs(keys, count)
    var at: usize = 0
    while at < count && at < 300 {
        const id = @intCast(u32, keys[at] & 4294967295)
        sayDeclaration(context, id)
        say(context, " (")
        if metric == measures_module.HEAT {
            const profiles = @ptrFromInt(*profiles_module.Profiles, measures.profiles)
            say(context, "self ")
            sayNumber(context, @intCast(usize, profiles_module.selfOf(profiles, id)))
            say(context, ", with what it calls ")
            sayNumber(context, @intCast(usize, profiles_module.totalOf(profiles, id)))
            say(context, " of ")
            sayNumber(context, @intCast(usize, profiles.*.allSamples))
            say(context, " samples")
        } else {
            say(context, "risk ")
            sayNumber(context, @intCast(usize, measures_module.value(&measures, metric, id)))
        }
        say(context, ")")
        newline(context)
        at += 1
    }
    say(context, "-- ")
    sayNumber(context, count)
    newline(context)
}

fn workarounds(context: *Context, prefix: []const u8) -> void {
    const index = context.*.index
    const allocator = std.page_allocator.init()
    var found: workarounds_module.Workarounds = undefined
    workarounds_module.init(&found, allocator)
    workarounds_module.run(&found, index)
    var patterns: [9]u8 = undefined
    var pattern_bytes: [*]u8 = undefined
    unsafe { pattern_bytes = @ptrCast([*]u8, &patterns) }
    const pattern_count = workarounds_module.ranked(&found, pattern_bytes)
    const capacity: usize = 4096
    const symbol_memory = allocator.alloc(capacity * 4, 16).?
    const count_memory = allocator.alloc(capacity * 4, 16).?
    var symbols: [*]u32 = undefined
    var counts: [*]u32 = undefined
    unsafe {
        symbols = @ptrCast([*]u32, symbol_memory)
        counts = @ptrCast([*]u32, count_memory)
    }
    var at: usize = 0
    while at < pattern_count {
        const pattern = patterns[at]
        const count = workarounds_module.declarations(&found, pattern, symbols, counts, capacity)
        var shown: usize = 0
        var places: usize = 0
        var entry: usize = 0
        while entry < count {
            if underPrefix(context, symbols[entry], prefix) { places += @intCast(usize, counts[entry]) }
            entry += 1
        }
        if places > 0 {
            say(context, "== ")
            sayNumber(context, places)
            say(context, "x ")
            say(context, workarounds_module.title(pattern, false))
            say(context, ". ")
            say(context, workarounds_module.missing(pattern, false))
            newline(context)
            entry = 0
            while entry < count {
                if underPrefix(context, symbols[entry], prefix) {
                    say(context, "   ")
                    sayDeclaration(context, symbols[entry])
                    say(context, " (")
                    sayNumber(context, @intCast(usize, counts[entry]))
                    say(context, "x)")
                    newline(context)
                    shown += 1
                    // What the comments say.
                    if pattern == workarounds_module.COMMENT {
                        var offsets: [16]u32 = undefined
                        var offset_words: [*]u32 = undefined
                        unsafe { offset_words = @ptrCast([*]u32, &offsets) }
                        const places = workarounds_module.placesIn(&found, pattern, symbols[entry], offset_words, 16)
                        const file = index_module.symbolAt(index, symbols[entry]).*.file
                        var place: usize = 0
                        while place < places {
                            say(context, "      ")
                            sayPlace(context, file, @intCast(usize, offsets[place]))
                            say(context, ": ")
                            sayLine(context, file, @intCast(usize, offsets[place]))
                            newline(context)
                            place += 1
                        }
                    }
                }
                entry += 1
            }
        }
        at += 1
    }
}

fn crashes(context: *Context, environment: [*][*]const u8, prefix: []const u8) -> void {
    const index = context.*.index
    var kept: crashes_module.Crashes = undefined
    crashes_module.init(&kept, std.page_allocator.init())
    var path_buffer: [4096]u8 = undefined
    var path: [*]u8 = undefined
    unsafe { path = @ptrCast([*]u8, &path_buffer) }
    const path_length = crashes_module.logPath(environment, path)
    if path_length == 0 {
        say(context, "no crash log: neither XDG_STATE_HOME nor HOME is set")
        newline(context)
        return
    }
    crashes_module.load(&kept, index, path)
    if kept.count == 0 {
        say(context, "no crashes kept in ")
        say(context, path[0..path_length])
        newline(context)
        return
    }
    // The declarations, most crashes first.
    const order = std.page_allocator.init().alloc(index.*.symbolCount * 4 + 4, 16).?
    var ranked: [*]u32 = undefined
    unsafe { ranked = @ptrCast([*]u32, order) }
    const count = crashes_module.ranked(&kept, ranked)
    var at: usize = 0
    while at < count {
        const symbol = ranked[at]
        if underPrefix(context, symbol, prefix) {
            sayDeclaration(context, symbol)
            const stopped = crashes_module.stoppedIn(&kept, symbol)
            const through = crashes_module.wentThrough(&kept, symbol)
            say(context, " (")
            if stopped > 0 {
                say(context, "crashed here ")
                sayNumber(context, @intCast(usize, stopped))
                say(context, "x")
                if through > 0 { say(context, ", ") }
            }
            if through > 0 {
                say(context, "on the way ")
                sayNumber(context, @intCast(usize, through))
                say(context, "x")
            }
            say(context, ")")
            newline(context)
        }
        at += 1
    }
    // The crashes, newest first.
    var record = kept.count
    while record > 0 {
        record -= 1
        const first = crashes_module.firstFrame(&kept, @intCast(u32, record))
        var shown = prefix.length == 0
        var frame = first
        while !shown && frame < kept.frameCount && kept.frameRecord[frame] == @intCast(u32, record) {
            if kept.frameSymbol[frame] != NONE && underPrefix(context, kept.frameSymbol[frame], prefix) { shown = true }
            frame += 1
        }
        if !shown { continue }
        say(context, "== ")
        say(context, crashes_module.field(&kept, @intCast(u32, record), 2))
        say(context, ": ")
        say(context, crashes_module.field(&kept, @intCast(u32, record), 3))
        newline(context)
        frame = first
        while frame < kept.frameCount && kept.frameRecord[frame] == @intCast(u32, record) {
            say(context, if kept.frameDepth[frame] == 0 { "   at " } else { "   from " })
            if kept.frameSymbol[frame] != NONE {
                sayDeclaration(context, kept.frameSymbol[frame])
                const where = crashes_module.frameWhere(crashes_module.frameText(&kept, frame))
                if where.length > 0 {
                    say(context, " at ")
                    say(context, where)
                }
            } else {
                say(context, crashes_module.frameText(&kept, frame))
            }
            newline(context)
            frame += 1
        }
    }
}

fn isPrimitive(name: []const u8) -> bool {
    if name.length == 0 { return true }
    if name[0] >= 48 && name[0] <= 57 { return true }
    const primitives = "u8 u16 u32 u64 u128 i8 i16 i32 i64 i128 usize isize u5 u6 u3 u4 u1 u2 u7 bool f32 f64 void type anytype noreturn anyopaque comptime_int length _"
    var start: usize = 0
    while start < primitives.length {
        var end = start
        while end < primitives.length && primitives[end] != 32 { end += 1 }
        if index_module.sameBytes(primitives[start..end], name) { return true }
        start = end + 1
    }
    return false
}

fn unresolvedIn(context: *Context, path: []const u8) -> void {
    const index = context.*.index
    if path.length == 0 {
        var each: usize = 0
        while each < index.*.fileCount {
            unresolvedFile(context, @intCast(u32, each))
            each += 1
        }
        return
    }
    const file = findFileSpec(context, path)
    if file == NONE {
        noMatch(context, path)
        return
    }
    unresolvedFile(context, file)
}

fn unresolvedFile(context: *Context, file: u32) -> void {
    const index = context.*.index
    // Identifiers and fields without a symbol (primitive types and
    // lengths left out).
    const record = index_module.fileAt(index, file)
    var node: usize = 0
    while node < record.*.nodes.length {
        const value = index_module.nodeAt(index, file, node)
        const token = index_module.tokenAt(index, file, value.mainToken)
        const name = index_module.sourceOf(index, file)[token.start..token.start + token.length]
        const dotted = value.tag == index_module.Tag.field_expression && value.lhs != 18446744073709551615
        if (value.tag == index_module.Tag.identifier || dotted) && record.*.nodeSymbols[node] == NONE && !isPrimitive(name) {
            sayPlace(context, file, token.start)
            say(context, ": ")
            say(context, index_module.sourceOf(index, file)[token.start..token.start + token.length])
            newline(context)
        }
        node += 1
    }
}

// The map as JSON: {"files":[paths], "symbols":[[kind, name, file, line,
// column, parent], ...], "uses":[[symbol, file, line, column, use, from],
// ...]}.
fn json(context: *Context) -> void {
    const index = context.*.index
    const out = context.*.out
    say(context, "{\"root\":")
    out_module.json(out, context.*.root[0..context.*.rootLength])
    say(context, ",\"files\":[")
    var file: usize = 0
    while file < index.*.fileCount {
        if file > 0 { say(context, ",") }
        out_module.json(out, shortPath(context, index_module.pathOf(index, @intCast(u32, file))))
        file += 1
    }
    say(context, "],\"symbols\":[")
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        if symbol > 0 { say(context, ",") }
        say(context, "[")
        out_module.json(out, index_module.kindName(record.*.kind))
        say(context, ",")
        out_module.json(out, if record.*.kind == index_module.FILE { "" } else { index_module.nameOf(index, id) })
        say(context, ",")
        sayNumber(context, @intCast(usize, record.*.file))
        say(context, ",")
        sayNumber(context, index_module.lineOf(index, record.*.file, @intCast(usize, record.*.nameStart)) + 1)
        say(context, ",")
        sayNumber(context, index_module.columnOf(index, record.*.file, @intCast(usize, record.*.nameStart)) + 1)
        say(context, ",")
        if record.*.parent == NONE { say(context, "-1") } else { sayNumber(context, @intCast(usize, record.*.parent)) }
        say(context, "]")
        symbol += 1
    }
    say(context, "],\"uses\":[")
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if ref > 0 { say(context, ",") }
        say(context, "[")
        sayNumber(context, @intCast(usize, value.*.symbol))
        say(context, ",")
        sayNumber(context, @intCast(usize, value.*.file))
        say(context, ",")
        sayNumber(context, index_module.lineOf(index, value.*.file, @intCast(usize, value.*.start)) + 1)
        say(context, ",")
        sayNumber(context, index_module.columnOf(index, value.*.file, @intCast(usize, value.*.start)) + 1)
        say(context, ",")
        out_module.json(out, index_module.useName(value.*.use))
        say(context, ",")
        if value.*.from == NONE { say(context, "-1") } else { sayNumber(context, @intCast(usize, value.*.from)) }
        say(context, "]")
        ref += 1
    }
    say(context, "]}")
    newline(context)
}

// The line around bytes start..end of `source`, with `instead` in their
// place (from its first non-blank byte on).
fn sayEditedLine(context: *Context, source: []const u8, start: usize, end: usize, instead: []const u8) -> void {
    var first = start
    while first > 0 && source[first - 1] != 10 { first -= 1 }
    while first < start && (source[first] == 32 || source[first] == 9) { first += 1 }
    var last = end
    while last < source.length && source[last] != 10 { last += 1 }
    say(context, source[first..start])
    say(context, instead)
    say(context, source[end..last])
}

// rewrite PATTERN [PATH] [--apply]: the rewrites of a workaround, shown
// (each line before and after), written with --apply once the compiler
// accepts what they need.
fn rewrite(context: *Context, environment: [*][*]const u8, word: []const u8, prefix: []const u8, applying: bool) -> void {
    const index = context.*.index
    const pattern = rewrite_module.patternNamed(word)
    if pattern == 255 {
        say(context, "usage: mlx-codemap rewrite dropped|counted [PATH] [--apply]")
        newline(context)
        return
    }
    if !rewrite_module.rewritable(pattern) {
        say(context, "no rewrite for ")
        say(context, word)
        say(context, " yet: ")
        say(context, workarounds_module.missing(pattern, false))
        newline(context)
        return
    }
    const allocator = std.page_allocator.init()
    var found: workarounds_module.Workarounds = undefined
    workarounds_module.init(&found, allocator)
    workarounds_module.run(&found, index)
    var edits: rewrite_module.Edits = undefined
    rewrite_module.init(&edits, allocator)
    rewrite_module.plan(&edits, &found, index, pattern, prefix)
    const files = rewrite_module.fileCount(&edits)
    var edit: usize = 0
    while edit < edits.count {
        const file = edits.file[edit]
        const source = index_module.sourceOf(index, file)
        const start = @intCast(usize, edits.start[edit])
        const end = @intCast(usize, edits.end[edit])
        say(context, shortPath(context, index_module.pathOf(index, file)))
        say(context, ":")
        sayNumber(context, index_module.lineOf(index, file, start) + 1)
        say(context, ": ")
        sayEditedLine(context, source, start, end, source[start..end])
        newline(context)
        say(context, "  -> ")
        sayEditedLine(context, source, start, end, rewrite_module.replacement(&edits, edit))
        newline(context)
        edit += 1
    }
    say(context, "-- ")
    sayNumber(context, edits.count)
    say(context, " rewrites in ")
    sayNumber(context, files)
    say(context, " files")
    newline(context)
    if edits.count == 0 { return }
    var git: git_module.Git = undefined
    git_module.init(&git, allocator, context.*.root[0..context.*.rootLength], environment)
    if !rewrite_module.compilerAccepts(&git, pattern) {
        say(context, "the compiler does not accept them yet (")
        say(context, workarounds_module.missing(pattern, false))
        say(context, "): nothing written")
        newline(context)
        return
    }
    if !applying {
        say(context, "the compiler accepts them: --apply writes them")
        newline(context)
        return
    }
    const written = rewrite_module.apply(&edits, index)
    say(context, "written: ")
    sayNumber(context, written)
    say(context, " files")
    newline(context)
}

// workarounds-count: the places of each pattern, on one line (for history).
fn workaroundsCount(context: *Context) -> void {
    const allocator = std.page_allocator.init()
    var found: workarounds_module.Workarounds = undefined
    workarounds_module.init(&found, allocator)
    workarounds_module.run(&found, context.*.index)
    var pattern: u8 = 0
    while @intCast(usize, pattern) < workarounds_module.PATTERNS {
        if pattern > 0 { say(context, " ") }
        sayNumber(context, workarounds_module.countOf(&found, pattern))
        pattern += 1
    }
    newline(context)
}

// "YYYY-MM-DD" of seconds since 1970.
fn sayDate(context: *Context, seconds: u32) -> void {
    // Days to a civil date (Howard Hinnant's algorithm).
    const z = @intCast(i64, seconds / 86400) + 719468
    const era = z / 146097
    const day_of_era = z - era * 146097
    const year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365
    const day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
    const shifted_month = (5 * day_of_year + 2) / 153
    const day = day_of_year - (153 * shifted_month + 2) / 5 + 1
    const month = if shifted_month < 10 { shifted_month + 3 } else { shifted_month - 9 }
    const year = year_of_era + era * 400 + (if month <= 2 { 1 } else { 0 })
    sayNumber(context, @intCast(usize, year))
    say(context, if month < 10 { "-0" } else { "-" })
    sayNumber(context, @intCast(usize, month))
    say(context, if day < 10 { "-0" } else { "-" })
    sayNumber(context, @intCast(usize, day))
}

// A bar of eight heights for `value` between `least` and `most` (the
// middle one when they are the same).
fn sayBar(context: *Context, value: u32, least: u32, most: u32) -> void {
    const bars = "▁▂▃▄▅▆▇█"
    var level: usize = 3
    if most > least { level = @intCast(usize, value - least) * 7 / @intCast(usize, most - least) }
    say(context, bars[level * 3..level * 3 + 3])
}

// history [N]: the workarounds at each of the last N commits (20), each
// pattern's course as a line of bars.
fn workaroundHistory(context: *Context, environment: [*][*]const u8, given: []const u8) -> void {
    var limit: usize = 0
    for byte in given {
        if byte >= 48 && byte <= 57 { limit = limit * 10 + @intCast(usize, byte - 48) }
    }
    if limit == 0 { limit = 20 }
    const allocator = std.page_allocator.init()
    var git: git_module.Git = undefined
    git_module.init(&git, allocator, context.*.root[0..context.*.rootLength], environment)
    if !git_module.usable(&git) {
        say(context, "the root is not in a Git work tree (or git is missing)")
        newline(context)
        return
    }
    var trend: trend_module.Trend = undefined
    trend_module.init(&trend, allocator)
    trend_module.load(&trend, &git, limit)
    const missing = trend_module.missing(&trend)
    if missing > 0 {
        var done: usize = 0
        while trend_module.fillNext(&trend, &git) {
            done += 1
            var line: [64]u8 = undefined
            var bytes: [*]u8 = undefined
            unsafe { bytes = @ptrCast([*]u8, &line) }
            // Progress on stderr: "counting N/M\r".
            var length: usize = 0
            for byte in "counting commits: " {
                bytes[length] = byte
                length += 1
            }
            length = putNumber(bytes, length, done)
            bytes[length] = 47
            length += 1
            length = putNumber(bytes, length, missing)
            bytes[length] = 13
            length += 1
            const wrote = std.linux.syscall3(1, 2, @intFromPtr(bytes), length)
        }
        if done > 0 { unsafe { const ended = std.linux.syscall3(1, 2, @intFromPtr(@ptrCast([*]const u8, "\n")), 1) } }
    }
    var pattern: u8 = 0
    say(context, "date       commit   total")
    while @intCast(usize, pattern) < workarounds_module.PATTERNS {
        say(context, " ")
        say(context, patternWord(pattern))
        pattern += 1
    }
    newline(context)
    var commit: usize = 0
    while commit < trend.count {
        if trend_module.isKnown(&trend, commit) {
            sayDate(context, trend.time[commit])
            say(context, " ")
            say(context, trend_module.hashOf(&trend, commit)[0..7])
            say(context, "  ")
            sayNumber(context, @intCast(usize, trend_module.totalOf(&trend, commit)))
            pattern = 0
            while @intCast(usize, pattern) < workarounds_module.PATTERNS {
                say(context, " ")
                sayNumber(context, @intCast(usize, trend_module.countOf(&trend, commit, pattern)))
                pattern += 1
            }
            newline(context)
        }
        commit += 1
    }
    pattern = 0
    while @intCast(usize, pattern) <= workarounds_module.PATTERNS {
        const all = @intCast(usize, pattern) == workarounds_module.PATTERNS
        const most = trend_module.most(&trend, @intCast(usize, pattern))
        const least = trend_module.least(&trend, @intCast(usize, pattern))
        var last: u32 = 0
        commit = 0
        while commit < trend.count {
            if trend_module.isKnown(&trend, commit) {
                last = if all { trend_module.totalOf(&trend, commit) } else { trend_module.countOf(&trend, commit, pattern) }
                sayBar(context, last, least, most)
            }
            commit += 1
        }
        say(context, " ")
        sayNumber(context, @intCast(usize, last))
        say(context, " ")
        say(context, if all { "all" } else { workarounds_module.shortTitle(pattern, false) })
        newline(context)
        pattern += 1
    }
}

fn putNumber(into: [*]u8, length: usize, value: usize) -> usize {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var left = value
    while true {
        digits[count] = @intCast(u8, 48 + left % 10)
        count += 1
        left /= 10
        if left == 0 { break }
    }
    var at = length
    while count > 0 {
        count -= 1
        into[at] = digits[count]
        at += 1
    }
    return at
}

// The word rewrite takes for a pattern.
fn patternWord(pattern: u8) -> []const u8 {
    if pattern == workarounds_module.DROPPED { return "dropped" }
    if pattern == workarounds_module.COUNTED { return "counted" }
    if pattern == workarounds_module.POINTER_MATH { return "pointers" }
    if pattern == workarounds_module.ARRAY_CAST { return "casts" }
    if pattern == workarounds_module.UNSAFE_SET { return "unsafe" }
    if pattern == workarounds_module.ARENA { return "arena" }
    if pattern == workarounds_module.FLOATS { return "floats" }
    if pattern == workarounds_module.MATH { return "math" }
    return "comments"
}

// The words of the arguments from `first` on, a space between (into
// `into`); their length.
fn joined(arguments: [][*]const u8, first: usize, into: [*]u8, room: usize) -> usize {
    var length: usize = 0
    var at = first
    while at < arguments.length {
        if at > first && length < room {
            into[length] = 32
            length += 1
        }
        for byte in cString(arguments[at]) {
            if length < room {
                into[length] = byte
                length += 1
            }
        }
        at += 1
    }
    return length
}

// query TEXT: the declarations that answer it (tools/codemap/query.mlx),
// or a kept view's (@NAME, from codemap.views).
fn queryCommand(context: *Context, environment: [*][*]const u8, given: []const u8) -> void {
    const index = context.*.index
    const allocator = std.page_allocator.init()
    var text = given
    var views: views_module.Views = undefined
    views_module.load(&views, context.*.root[0..context.*.rootLength])
    var view = views.count
    if given.length > 1 && given[0] == 64 {
        view = views_module.find(&views, given[1..given.length])
        if view == views.count {
            say(context, "no view named ")
            say(context, given[1..given.length])
            say(context, " in codemap.views")
            newline(context)
            return
        }
    }
    var query: query_module.Query = undefined
    query_module.init(&query, allocator)
    const understood = if view < views.count { query_module.parse(&query, views_module.queryOf(&views, view)) } else { query_module.parse(&query, text) }
    if !understood {
        const bad = query_module.badWord(&query)
        if bad.length > 0 {
            say(context, "not understood: ")
            say(context, bad)
        } else {
            say(context, "usage: mlx-codemap query WORDS | @VIEW (kind:fn in:PATH uses:NAME calls:NAME by:NAME crashed workaround[:KIND] unused unreachable untested complex risky hot copy changed added since:REV)")
        }
        newline(context)
        return
    }
    var measures: measures_module.Measures = undefined
    measureAll(context, environment, &measures, true)
    var diff_address: usize = 0
    if query_module.needsDiff(&query) {
        const diff = @ptrCast(*diff_module.Diff, allocator.alloc(@sizeOf(diff_module.Diff), 16).?)
        diff_module.init(diff, allocator)
        var git: git_module.Git = undefined
        git_module.init(&git, allocator, context.*.root[0..context.*.rootLength], environment)
        if !diff_module.run(diff, index, &git, query_module.since(&query), "") {
            say(context, "no diff: not in a Git work tree, or ")
            say(context, query_module.since(&query))
            say(context, " names no commit")
            newline(context)
            return
        }
        diff_address = @intFromPtr(diff)
    }
    query_module.prepare(&query, &measures, diff_address)
    var count: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        if query_module.matches(&query, id) {
            if count < 1000 {
                sayDeclaration(context, id)
                newline(context)
            }
            count += 1
        }
        symbol += 1
    }
    say(context, "-- ")
    sayNumber(context, count)
    newline(context)
}

// views: the views kept in codemap.views.
fn viewsCommand(context: *Context) -> void {
    var views: views_module.Views = undefined
    views_module.load(&views, context.*.root[0..context.*.rootLength])
    var view: usize = 0
    while view < views.count {
        say(context, "@")
        say(context, views_module.nameOf(&views, view))
        say(context, " = ")
        say(context, views_module.queryOf(&views, view))
        newline(context)
        view += 1
    }
    say(context, "-- ")
    sayNumber(context, views.count)
    newline(context)
}

// diff [BASE] [OTHER]: the declarations added (+), changed (~) and
// removed (-) since BASE (HEAD), in the work tree or in commit OTHER.
fn diffCommand(context: *Context, environment: [*][*]const u8, base_given: []const u8, other: []const u8) -> void {
    const allocator = std.page_allocator.init()
    const base = if base_given.length > 0 { base_given } else { "HEAD" }
    const diff = @ptrCast(*diff_module.Diff, allocator.alloc(@sizeOf(diff_module.Diff), 16).?)
    diff_module.init(diff, allocator)
    var git: git_module.Git = undefined
    git_module.init(&git, allocator, context.*.root[0..context.*.rootLength], environment)
    if !diff_module.run(diff, context.*.index, &git, base, other) {
        say(context, "no diff: not in a Git work tree, or a commit is not known")
        newline(context)
        return
    }
    const now = diff.*.now
    var seen = Context.{ .index = now, .out = context.*.out, .root = now.*.root, .rootLength = now.*.rootLength }
    var mark: u8 = diff_module.ADDED
    while mark <= diff_module.CHANGED {
        var symbol: usize = 0
        while symbol < now.*.symbolCount {
            const id = @intCast(u32, symbol)
            if diff_module.stateOf(diff, id) == mark {
                say(context, if mark == diff_module.ADDED { "+ " } else { "~ " })
                sayDeclaration(&seen, id)
                newline(context)
            }
            symbol += 1
        }
        mark += 1
    }
    if diff.*.hasBefore {
        const before = diff.*.before
        var was = Context.{ .index = before, .out = context.*.out, .root = before.*.root, .rootLength = before.*.rootLength }
        var at: usize = 0
        while at < diff.*.removedCount {
            say(context, "- ")
            sayDeclaration(&was, diff.*.removed[at] & 2147483647)
            newline(context)
            at += 1
        }
    }
    say(context, "-- ")
    sayNumber(context, diff.*.added)
    say(context, " added, ")
    sayNumber(context, diff.*.changed)
    say(context, " changed, ")
    sayNumber(context, diff.*.removedCount)
    say(context, " removed in ")
    sayNumber(context, diff.*.files)
    say(context, " files since ")
    say(context, base)
    newline(context)
}

fn usage(context: *Context) -> void {
    say(context, "usage: mlx-codemap [-C ROOT] stats | files [TEXT] | outline FILE | find TEXT | show SYMBOL | def FILE:LINE:COL | refs SYMBOL | callers SYMBOL | callees SYMBOL | imports FILE | importers FILE | members SYMBOL | unused [PATH] | copies [PATH] | names [PATH] | workarounds [PATH] | programs | reach PROGRAM [PATH] | unreachable [PATH] | untested [PATH] | sizes [PROGRAM] [PATH] | complex [PATH] | cycles | layers | churn [PATH] | risky [PATH] | hot [PATH] | crashes [PATH] | rewrite PATTERN [PATH] [--apply] | history [N] | query WORDS|@VIEW | views | diff [BASE] [OTHER] | unresolved FILE | json")
    newline(context)
}

// Whether `word` is one of the commands (the app, mlx-codemap without
// one, opens the 3D view: examples/mlx-codemap).
pub fn isCommand(word: []const u8) -> bool {
    const commands = "-C stats files outline find show def refs callers callees imports importers members unused copies names workarounds programs reach unreachable untested sizes complex cycles layers churn risky hot crashes rewrite history workarounds-count query views diff unresolved json help --help"
    var start: usize = 0
    var at: usize = 0
    while at <= commands.length {
        if at == commands.length || commands[at] == 32 {
            if index_module.sameBytes(commands[start..at], word) { return true }
            start = at + 1
        }
        at += 1
    }
    return false
}

pub fn main(arguments: [][*]const u8) -> !void { try run(arguments) }

pub fn run(arguments: [][*]const u8) -> !void {
    const out = out_module.create(1, 1048576)
    var first: usize = 1
    var root_buffer: [1024]u8 = undefined
    var root: [*]u8 = undefined
    unsafe { root = @ptrCast([*]u8, &root_buffer) }
    var root_length: usize = 0
    if arguments.length > 2 && index_module.sameBytes(cString(arguments[1]), "-C") {
        const given = cString(arguments[2])
        while root_length < given.length && root_length < 1000 {
            root[root_length] = given[root_length]
            root_length += 1
        }
        first = 3
    } else {
        const got = std.fs.getWorkingDirectory(root, 1024)
        while root_length < 1024 && root[root_length] != 0 { root_length += 1 }
    }
    while root_length > 1 && root[root_length - 1] == 47 { root_length -= 1 }
    // A relative root: under the working directory.
    if root_length > 0 && root[0] != 47 {
        var absolute: [2048]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &absolute) }
        const got = std.fs.getWorkingDirectory(bytes, 1024)
        var length: usize = 0
        while length < 1024 && bytes[length] != 0 { length += 1 }
        bytes[length] = 47
        length += 1
        var at: usize = 0
        while at < root_length {
            bytes[length] = root[at]
            length += 1
            at += 1
        }
        at = 0
        while at < length && at < 1000 {
            root[at] = bytes[at]
            at += 1
        }
        root_length = at
    }
    var context = Context.{ .index = index_module.create(root[0..root_length]), .out = out, .root = root, .rootLength = root_length }
    if arguments.length <= first {
        usage(&context)
        out_module.flush(out)
        return
    }
    // The build's temporaries are done with once it is.
    const arena = aggregates.find()
    const where = aggregates.mark(arena)
    index_module.addTree(context.index, root[0..root_length])
    index_module.build(context.index)
    aggregates.reset(arena, where)
    const command = cString(arguments[first])
    const argument = if arguments.length > first + 1 { cString(arguments[first + 1]) } else { "" }
    if index_module.sameBytes(command, "stats") {
        stats(&context)
    } else if index_module.sameBytes(command, "files") {
        files(&context, argument)
    } else if index_module.sameBytes(command, "outline") {
        outline(&context, argument)
    } else if index_module.sameBytes(command, "find") {
        find(&context, argument)
    } else if index_module.sameBytes(command, "show") {
        withSymbols(&context, argument, 0)
    } else if index_module.sameBytes(command, "refs") {
        withSymbols(&context, argument, 1)
    } else if index_module.sameBytes(command, "callers") {
        withSymbols(&context, argument, 2)
    } else if index_module.sameBytes(command, "callees") {
        withSymbols(&context, argument, 3)
    } else if index_module.sameBytes(command, "members") {
        withSymbols(&context, argument, 4)
    } else if index_module.sameBytes(command, "def") {
        withSymbols(&context, argument, 5)
    } else if index_module.sameBytes(command, "imports") {
        imports(&context, argument, false)
    } else if index_module.sameBytes(command, "importers") {
        imports(&context, argument, true)
    } else if index_module.sameBytes(command, "unused") {
        unused(&context, argument)
    } else if index_module.sameBytes(command, "copies") {
        findings(&context, [2]u8{ analysis_module.COPIES, analysis_module.SHAPES }, argument)
    } else if index_module.sameBytes(command, "names") {
        findings(&context, [2]u8{ analysis_module.NAMES, 255 }, argument)
    } else if index_module.sameBytes(command, "workarounds") {
        workarounds(&context, argument)
    } else if index_module.sameBytes(command, "programs") {
        listPrograms(&context, std.process.environmentEntries(arguments))
    } else if index_module.sameBytes(command, "reach") {
        reachCommand(&context, std.process.environmentEntries(arguments), 0, argument, if arguments.length > first + 2 { cString(arguments[first + 2]) } else { "" })
    } else if index_module.sameBytes(command, "unreachable") {
        reachCommand(&context, std.process.environmentEntries(arguments), 1, "", argument)
    } else if index_module.sameBytes(command, "untested") {
        reachCommand(&context, std.process.environmentEntries(arguments), 2, "", argument)
    } else if index_module.sameBytes(command, "sizes") {
        sizes(&context, std.process.environmentEntries(arguments), argument, if arguments.length > first + 2 { cString(arguments[first + 2]) } else { "" })
    } else if index_module.sameBytes(command, "complex") {
        complex(&context, argument)
    } else if index_module.sameBytes(command, "cycles") {
        structureCommand(&context, false)
    } else if index_module.sameBytes(command, "layers") {
        structureCommand(&context, true)
    } else if index_module.sameBytes(command, "churn") {
        churn(&context, std.process.environmentEntries(arguments), argument)
    } else if index_module.sameBytes(command, "risky") {
        ranking(&context, std.process.environmentEntries(arguments), measures_module.RISK, argument)
    } else if index_module.sameBytes(command, "hot") {
        ranking(&context, std.process.environmentEntries(arguments), measures_module.HEAT, argument)
    } else if index_module.sameBytes(command, "crashes") {
        crashes(&context, std.process.environmentEntries(arguments), argument)
    } else if index_module.sameBytes(command, "query") {
        var words: [2048]u8 = undefined
        var word_bytes: [*]u8 = undefined
        unsafe { word_bytes = @ptrCast([*]u8, &words) }
        const length = joined(arguments, first + 1, word_bytes, 2000)
        queryCommand(&context, std.process.environmentEntries(arguments), word_bytes[0..length])
    } else if index_module.sameBytes(command, "views") {
        viewsCommand(&context)
    } else if index_module.sameBytes(command, "diff") {
        diffCommand(&context, std.process.environmentEntries(arguments), argument, if arguments.length > first + 2 { cString(arguments[first + 2]) } else { "" })
    } else if index_module.sameBytes(command, "history") {
        workaroundHistory(&context, std.process.environmentEntries(arguments), argument)
    } else if index_module.sameBytes(command, "workarounds-count") {
        workaroundsCount(&context)
    } else if index_module.sameBytes(command, "rewrite") {
        // The path: the argument that is not --apply (an index, not a
        // slice assigned: the compiler keeps an assigned slice's length).
        var path_at: usize = 0
        var applying = false
        var at = first + 2
        while at < arguments.length {
            if index_module.sameBytes(cString(arguments[at]), "--apply") { applying = true } else { path_at = at }
            at += 1
        }
        rewrite(&context, std.process.environmentEntries(arguments), argument, if path_at > 0 { cString(arguments[path_at]) } else { "" }, applying)
    } else if index_module.sameBytes(command, "unresolved") {
        unresolvedIn(&context, argument)
    } else if index_module.sameBytes(command, "json") {
        json(&context)
    } else {
        usage(&context)
    }
    out_module.flush(out)
}
