// Where the code works around what the language or its compiler does not
// do yet: each pattern below is a missing feature, and every place written
// that way is one more reason to add it. mlx-codemap's `workarounds` and
// MLX Observatory's findings list them, the most written first, and put them
// on the declarations they are in.
//
//   - Pointer arithmetic by integer: @ptrFromInt(... @intFromPtr(...) ...),
//     where `p + n` on a [*]T now does (a struct pointer still goes
//     through integers).
//   - Arrays cast to many-pointers: @ptrCast([*]T, &array), where `&array`
//     now converts to [*]T by itself (a struct's bytes still take the
//     cast).
//   - Declared undefined, set in unsafe: `var x: T = undefined` and then
//     `unsafe { x = ... }`, where `const x: T = unsafe { ... }` does now.
//   - Results bound to be dropped: `const ignored = call(...)` (a local
//     constant nothing reads), where `_ = value` does.
//   - Lengths counted by hand: `for byte in text { length += 1 }`, for want
//     of a slice's length in the bootstrap library.
//   - Temporaries released by hand: aggregates.mark and reset, turns, for
//     want of freeing struct literals and structs returned by value (they
//     live in an arena that is never freed).
//   - Float constants written out: literals with 12 and more decimals,
//     where float arithmetic now folds (1.0 / 255.0) and std.math has pi
//     and the like (std/src/math.mlx, whose coefficients these are, is
//     left out).
//   - Math written out: sqrt, sin, cos, exp, ln, ... as Mlx functions on
//     floats, where std.math and @sqrt, @floor, @ceil and @trunc are now
//     (one that hands its work to those does not count).
//   - Said in a comment: comments naming a workaround (the word, not its
//     plural, which names these findings), a miscompilation,
//     what the compiler does not do yet, TODO, FIXME, HACK.
//   - Pages taken as the program's allocator: `page_allocator.init()`
//     outside the backing sites (BACKING_SITES: the bootstrap, the
//     allocators themselves, the compilers' arenas), where
//     `std.heap.allocator()` is the program's heap now.
//   - Hash tables written by hand: an open-addressing probe,
//     `slot = (slot + 1) & (N - 1)` or `% N`, in a function that speaks
//     of a hash or a slot, where std.HashMap and its kin are now.
//   - Growing arrays written by hand: a struct with a `[*]T` field and a
//     `capacity: usize` next to it, where std.ArrayList(T) is now.
//
// Generated code (/generated/) is left out, and this file. The last three
// leave out the bootstrap library, the containers themselves, the leak
// checker, the self-hosted compiler and the C libraries (CONTAINER_SITES).
const std = @import("std")
const index_module = @import("./index.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

pub const POINTER_MATH: u8 = 0
pub const ARRAY_CAST: u8 = 1
pub const UNSAFE_SET: u8 = 2
pub const DROPPED: u8 = 3
pub const COUNTED: u8 = 4
pub const ARENA: u8 = 5
pub const FLOATS: u8 = 6
pub const MATH: u8 = 7
pub const COMMENT: u8 = 8
pub const PAGES: u8 = 9
pub const TABLE: u8 = 10
pub const ARRAY: u8 = 11
pub const PATTERNS: usize = 12

pub const MAX_PLACES: usize = 262144
const MAX_RANGES: usize = 16384

pub const Workarounds = struct {
    index: *Index
    allocator: Allocator
    // Every place: its file, byte offset, pattern and declaration.
    count: usize
    file: [*]u32
    offset: [*]u32
    pattern: [*]u8
    symbol: [*]u32
    perPattern: [12]usize
    // Per symbol: a bit per pattern found in it, and how many places.
    marks: [*]u16
    places: [*]u32
    markCapacity: usize
    // Per symbol: how many uses (to find locals nothing reads).
    uses: [*]u32
    // The declarations of the file being scanned: where each starts and
    // ends, and which it is (outer ones first).
    rangeStart: [*]u32
    rangeEnd: [*]u32
    rangeSymbol: [*]u32
    rangeCount: usize
    rangeFile: u32
    scratch: [*]u32
}

pub fn init(workarounds: *Workarounds, allocator: Allocator) -> void {
    workarounds.*.allocator = allocator
    workarounds.*.count = 0
    workarounds.*.file = allocator.words(MAX_PLACES)
    workarounds.*.offset = allocator.words(MAX_PLACES)
    workarounds.*.pattern = allocator.alloc(MAX_PLACES, 16).?
    workarounds.*.symbol = allocator.words(MAX_PLACES)
    workarounds.*.scratch = allocator.words(MAX_PLACES * 2)
    workarounds.*.rangeStart = allocator.words(MAX_RANGES)
    workarounds.*.rangeEnd = allocator.words(MAX_RANGES)
    workarounds.*.rangeSymbol = allocator.words(MAX_RANGES)
    workarounds.*.markCapacity = 0
}

// The pattern's name.
pub fn title(pattern: u8, german: bool) -> []const u8 {
    if pattern == POINTER_MATH { return if german { "Zeigerrechnung über Zahlen" } else { "Pointer arithmetic by integer" } }
    if pattern == ARRAY_CAST { return if german { "Arrays zu Vielfachzeigern gecastet" } else { "Arrays cast to many-pointers" } }
    if pattern == UNSAFE_SET { return if german { "Undefiniert deklariert, in unsafe gesetzt" } else { "Declared undefined, set in unsafe" } }
    if pattern == DROPPED { return if german { "Ergebnisse nur zum Verwerfen gebunden" } else { "Results bound to be dropped" } }
    if pattern == COUNTED { return if german { "Längen von Hand gezählt" } else { "Lengths counted by hand" } }
    if pattern == ARENA { return if german { "Temporäres von Hand freigegeben" } else { "Temporaries released by hand" } }
    if pattern == FLOATS { return if german { "Float-Konstanten ausgeschrieben" } else { "Float constants written out" } }
    if pattern == MATH { return if german { "Mathematik ausgeschrieben" } else { "Math written out" } }
    if pattern == PAGES { return if german { "Seiten als Allocator des Programms" } else { "Pages taken as the program's allocator" } }
    if pattern == TABLE { return if german { "Hashtabellen von Hand" } else { "Hash tables written by hand" } }
    if pattern == ARRAY { return if german { "Wachsende Arrays von Hand" } else { "Growing arrays written by hand" } }
    return if german { "Im Kommentar gesagt" } else { "Said in a comment" }
}

// The pattern's name, short (for a list of them).
pub fn shortTitle(pattern: u8, german: bool) -> []const u8 {
    if pattern == POINTER_MATH { return if german { "Zeigerrechnung" } else { "Pointer math" } }
    if pattern == ARRAY_CAST { return if german { "Array-Casts" } else { "Array casts" } }
    if pattern == UNSAFE_SET { return if german { "In unsafe gesetzt" } else { "Set in unsafe" } }
    if pattern == DROPPED { return if german { "Verworfene Ergebnisse" } else { "Dropped results" } }
    if pattern == COUNTED { return if german { "Gezählte Längen" } else { "Counted lengths" } }
    if pattern == ARENA { return if german { "Arena von Hand" } else { "Arena by hand" } }
    if pattern == FLOATS { return if german { "Float-Konstanten" } else { "Float constants" } }
    if pattern == MATH { return if german { "Mathe ausgeschrieben" } else { "Math written out" } }
    if pattern == PAGES { return if german { "Seiten als Allocator" } else { "Pages as the allocator" } }
    if pattern == TABLE { return if german { "Tabellen von Hand" } else { "Tables by hand" } }
    if pattern == ARRAY { return if german { "Arrays von Hand" } else { "Arrays by hand" } }
    return if german { "Kommentare" } else { "Comments" }
}

// What is missing, that the pattern stands in for.
pub fn missing(pattern: u8, german: bool) -> []const u8 {
    if pattern == POINTER_MATH { return if german { "Jetzt: p + n auf einem [*]T" } else { "Now there: p + n on a [*]T" } }
    if pattern == ARRAY_CAST { return if german { "Jetzt: &array wird zu [*]T (Bytes eines Structs: Cast)" } else { "Now there: &array converts to [*]T (a struct's bytes: cast)" } }
    if pattern == UNSAFE_SET { return if german { "Jetzt: unsafe { Ausdruck }" } else { "Now there: unsafe { expression }" } }
    if pattern == DROPPED { return if german { "Jetzt: _ = Wert zum Verwerfen" } else { "Now there: _ = value to drop a result" } }
    if pattern == COUNTED { return if german { "Fehlt: die Länge eines Slices (Bootstrap-Bibliothek)" } else { "Missing: a slice's length (bootstrap library)" } }
    if pattern == ARENA { return if german { "Fehlt: Struct-Literale und Struct-Rückgaben freigeben" } else { "Missing: freeing struct literals and structs returned" } }
    if pattern == FLOATS { return if german { "Jetzt: Float-Literale falten, std.math.pi" } else { "Now there: float literals fold, std.math.pi" } }
    if pattern == MATH { return if german { "Jetzt: std.math, @sqrt, @floor, @ceil, @trunc" } else { "Now there: std.math, @sqrt, @floor, @ceil, @trunc" } }
    if pattern == PAGES { return if german { "Jetzt: std.heap.allocator() (Seiten nur als Rückhalt)" } else { "Now there: std.heap.allocator() (pages for backing only)" } }
    if pattern == TABLE { return if german { "Jetzt: std.HashMap, std.AutoHashMap, std.StringHashMap" } else { "Now there: std.HashMap, std.AutoHashMap, std.StringHashMap" } }
    if pattern == ARRAY { return if german { "Jetzt: std.ArrayList(T)" } else { "Now there: std.ArrayList(T)" } }
    return if german { "Was der Kommentar nennt" } else { "What the comment names" }
}

pub fn countOf(workarounds: *Workarounds, pattern: u8) -> usize { return workarounds.*.perPattern[@intCast(usize, pattern)] }

// How often `symbol` is used (counted by run and runFile, over all files).
pub fn usesOf(workarounds: *Workarounds, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= workarounds.*.markCapacity { return 0 }
    return workarounds.*.uses[symbol]
}

// How many places of any pattern are in `symbol`.
pub fn placesOf(workarounds: *Workarounds, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= workarounds.*.markCapacity { return 0 }
    return workarounds.*.places[symbol]
}

// The patterns found in `symbol`, a bit each.
pub fn marksOf(workarounds: *Workarounds, symbol: u32) -> u16 {
    if symbol == NONE || @intCast(usize, symbol) >= workarounds.*.markCapacity { return 0 }
    return workarounds.*.marks[symbol]
}

fn startsAt(text: []const u8, at: usize, word: []const u8) -> bool {
    if at + word.length > text.length { return false }
    var offset: usize = 0
    while offset < word.length {
        if text[at + offset] != word[offset] { return false }
        offset += 1
    }
    return true
}

fn lower(byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 { return byte + 32 }
    return byte
}

fn isNameByte(byte: u8) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 }

fn isPathLeftOut(path: []const u8) -> bool {
    var at: usize = 0
    while at < path.length {
        const byte = path[at]
        if byte == 47 && startsAt(path, at, "/generated/") { return true }
        if byte == 116 && startsAt(path, at, "tools/codemap/workarounds.mlx") { return true }
        at += 1
    }
    return false
}

// Whether `path` starts with one of the prefixes in `list` (space
// separated).
fn underAny(path: []const u8, list: []const u8) -> bool {
    var start: usize = 0
    var at: usize = 0
    while at <= list.length {
        if at == list.length || list[at] == 32 {
            const prefix = list[start..at]
            if prefix.length > 0 && path.length >= prefix.length && index_module.sameBytes(path[0..prefix.length], prefix) { return true }
            start = at + 1
        }
        at += 1
    }
    return false
}

// Where the page allocator is the right allocator: the bootstrap library
// (the heap stands on it), the heap and the leak checker themselves, the
// self-hosted compiler (the bootstrap compiler builds it), the C
// libraries (C's malloc is theirs), the compilers' arenas (a reservation
// of gigabytes), the code index's arena, and the tests of the allocators.
pub const BACKING_SITES: []const u8 = "std/bootstrap/ std/src/heap.mlx std/src/leaks.mlx compiler/selfhost/ compiler/libc/ compiler/cc/base.mlx compiler/cc/cheaders.mlx tools/codemap/index.mlx tests/"

// Where a table or an array written by hand is what it must be: the
// bootstrap library and the containers themselves, the leak checker (it
// runs inside the allocators' hooks), the self-hosted compiler, the C
// libraries (GHashTable is the C API), the tests.
pub const CONTAINER_SITES: []const u8 = "std/bootstrap/ std/src/containers/ std/src/leaks.mlx compiler/selfhost/ compiler/libc/ tests/"

pub fn isBackingSite(path: []const u8) -> bool { return underAny(path, BACKING_SITES) }

pub fn isContainerSite(path: []const u8) -> bool { return underAny(path, CONTAINER_SITES) }

pub fn run(workarounds: *Workarounds, index: *Index) -> void { runIn(workarounds, index, NONE) }

// Only the places in one file (for an editor: the whole code base takes a
// while).
pub fn runFile(workarounds: *Workarounds, index: *Index, file: u32) -> void { runIn(workarounds, index, file) }

fn runIn(workarounds: *Workarounds, index: *Index, only: u32) -> void {
    workarounds.*.index = index
    workarounds.*.count = 0
    var pattern: usize = 0
    while pattern < PATTERNS {
        workarounds.*.perPattern[pattern] = 0
        pattern += 1
    }
    if index.*.symbolCount > workarounds.*.markCapacity {
        const capacity = index.*.symbolCount + index.*.symbolCount / 2 + 1024
        unsafe { workarounds.*.marks = @ptrCast([*]u16, workarounds.*.allocator.alloc(capacity * 2 + 2, 16).?) }
        workarounds.*.uses = workarounds.*.allocator.words(capacity)
        workarounds.*.places = workarounds.*.allocator.words(capacity)
        workarounds.*.markCapacity = capacity
    }
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        workarounds.*.marks[symbol] = 0
        workarounds.*.uses[symbol] = 0
        workarounds.*.places[symbol] = 0
        symbol += 1
    }
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use != index_module.USE_DECLARATION && value.*.symbol != NONE { workarounds.*.uses[value.*.symbol] += 1 }
        ref += 1
    }
    var file: usize = 0
    while file < index.*.fileCount {
        const id = @intCast(u32, file)
        if (only == NONE || only == id) && !isPathLeftOut(index_module.pathOf(index, id)) { scanFile(workarounds, id) }
        file += 1
    }
    // Locals nothing reads that hold a call's result, and math functions.
    // (A file's symbols come one after another: whether its path is left
    // out is asked once a file.)
    var file_seen = NONE
    var file_left_out = false
    symbol = 0
    while symbol < index.*.symbolCount {
        const value = index_module.symbolAt(index, @intCast(u32, symbol))
        if value.*.file != file_seen {
            file_seen = value.*.file
            file_left_out = isPathLeftOut(index_module.pathOf(index, value.*.file))
        }
        if (only == NONE || only == value.*.file) && !file_left_out {
            if value.*.kind == index_module.LOCAL_CONST && workarounds.*.uses[symbol] == 0 && holdsCall(index, value.*.file, @intCast(usize, value.*.nameStart)) {
                place(workarounds, value.*.file, @intCast(usize, value.*.nameStart), DROPPED, enclosingFunction(index, @intCast(u32, symbol)))
            }
            if value.*.kind == index_module.FUNCTION && isMathName(index_module.nameOf(index, @intCast(u32, symbol))) && writesMathOut(index, value.*.file, @intCast(usize, value.*.nameStart)) {
                place(workarounds, value.*.file, @intCast(usize, value.*.nameStart), MATH, @intCast(u32, symbol))
            }
        }
        symbol += 1
    }
}

// After index_module.refreshFile: the places of that file found again
// (the others' stay), and its symbols' marks and uses counted again.
pub fn refreshFile(workarounds: *Workarounds, index: *Index, file: u32) -> void {
    workarounds.*.index = index
    // Room for the symbols added (what is counted stays).
    if index.*.symbolCount > workarounds.*.markCapacity {
        const capacity = index.*.symbolCount + index.*.symbolCount / 2 + 1024
        var marks: [*]u16 = undefined
        unsafe { marks = @ptrCast([*]u16, workarounds.*.allocator.alloc(capacity * 2 + 2, 16).?) }
        const uses = workarounds.*.allocator.words(capacity)
        const places = workarounds.*.allocator.words(capacity)
        var at: usize = 0
        while at < capacity {
            marks[at] = if at < workarounds.*.markCapacity { workarounds.*.marks[at] } else { 0 }
            uses[at] = if at < workarounds.*.markCapacity { workarounds.*.uses[at] } else { 0 }
            places[at] = if at < workarounds.*.markCapacity { workarounds.*.places[at] } else { 0 }
            at += 1
        }
        workarounds.*.marks = marks
        workarounds.*.uses = uses
        workarounds.*.places = places
        workarounds.*.markCapacity = capacity
    }
    // The file's places out, the others kept in their order.
    var kept: usize = 0
    var at: usize = 0
    while at < workarounds.*.count {
        if workarounds.*.file[at] == file {
            workarounds.*.perPattern[@intCast(usize, workarounds.*.pattern[at])] -= 1
        } else {
            workarounds.*.file[kept] = workarounds.*.file[at]
            workarounds.*.offset[kept] = workarounds.*.offset[at]
            workarounds.*.pattern[kept] = workarounds.*.pattern[at]
            workarounds.*.symbol[kept] = workarounds.*.symbol[at]
            kept += 1
        }
        at += 1
    }
    workarounds.*.count = kept
    // Its symbols from nothing; the uses of them counted again.
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        if index_module.symbolAt(index, @intCast(u32, symbol)).*.file == file {
            workarounds.*.marks[symbol] = 0
            workarounds.*.places[symbol] = 0
            workarounds.*.uses[symbol] = 0
        }
        symbol += 1
    }
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use != index_module.USE_DECLARATION && value.*.symbol != NONE && index_module.symbolAt(index, value.*.symbol).*.file == file { workarounds.*.uses[value.*.symbol] += 1 }
        ref += 1
    }
    if isPathLeftOut(index_module.pathOf(index, file)) { return }
    scanFile(workarounds, file)
    symbol = 0
    while symbol < index.*.symbolCount {
        const value = index_module.symbolAt(index, @intCast(u32, symbol))
        if value.*.file == file {
            if value.*.kind == index_module.LOCAL_CONST && workarounds.*.uses[symbol] == 0 && holdsCall(index, file, @intCast(usize, value.*.nameStart)) {
                place(workarounds, file, @intCast(usize, value.*.nameStart), DROPPED, enclosingFunction(index, @intCast(u32, symbol)))
            }
            if value.*.kind == index_module.FUNCTION && isMathName(index_module.nameOf(index, @intCast(u32, symbol))) && writesMathOut(index, file, @intCast(usize, value.*.nameStart)) {
                place(workarounds, file, @intCast(usize, value.*.nameStart), MATH, @intCast(u32, symbol))
            }
        }
        symbol += 1
    }
}

// The function (or top-level declaration) a local is in.
fn enclosingFunction(index: *Index, symbol: u32) -> u32 {
    var current = index_module.symbolAt(index, symbol).*.parent
    while current != NONE {
        const value = index_module.symbolAt(index, current)
        if value.*.kind == index_module.FUNCTION || value.*.kind == index_module.TEST { return current }
        if value.*.kind == index_module.FILE { return NONE }
        current = value.*.parent
    }
    return NONE
}

// Whether the rest of the line after a local's name is `= name(...)`-like.
fn holdsCall(index: *Index, file: u32, offset: usize) -> bool {
    const source = index_module.sourceOf(index, file)
    var at = offset
    while at < source.length && source[at] != 61 && source[at] != 10 { at += 1 }
    while at < source.length && source[at] != 10 {
        if source[at] == 40 { return true }
        at += 1
    }
    return false
}

// std.math itself: where the constants and the polynomials belong.
fn isMathLibrary(path: []const u8) -> bool {
    const name = "std/src/math.mlx"
    return path.length >= name.length && index_module.sameBytes(path[path.length - name.length..path.length], name)
}

// Whether the function named at `name_start` works on floats (f32 or f64
// in its signature) and does the math itself, instead of handing it to
// std.math or a builtin (a `log` that writes a message, or a `sqrt` that
// guards @sqrt, do not count).
fn writesMathOut(index: *Index, file: u32, name_start: usize) -> bool {
    if isMathLibrary(index_module.pathOf(index, file)) { return false }
    const source = index_module.sourceOf(index, file)
    var at = name_start
    var floats = false
    while at < source.length && source[at] != 123 {
        if startsAt(source, at, "f64") || startsAt(source, at, "f32") { floats = true }
        at += 1
    }
    if !floats || at >= source.length { return false }
    var depth: usize = 0
    while at < source.length {
        const byte = source[at]
        if byte == 123 { depth += 1 }
        if byte == 125 {
            depth -= 1
            if depth == 0 { return true }
        }
        if byte == 64 && (startsAt(source, at, "@sqrt(") || startsAt(source, at, "@floor(") || startsAt(source, at, "@ceil(") || startsAt(source, at, "@trunc(")) { return false }
        if byte == 109 && startsAt(source, at, "math.") && (at == 0 || !isNameByte(source[at - 1])) { return false }
        at += 1
    }
    return true
}

fn isMathName(name: []const u8) -> bool {
    const names = "sqrt sin cos tan atan atan2 exp ln log log2 pow floor ceil fabs hypot"
    var start: usize = 0
    var at: usize = 0
    while at <= names.length {
        if at == names.length || names[at] == 32 {
            if index_module.sameBytes(names[start..at], name) { return true }
            start = at + 1
        }
        at += 1
    }
    return false
}

fn place(workarounds: *Workarounds, file: u32, offset: usize, pattern: u8, symbol: u32) -> void {
    if workarounds.*.count >= MAX_PLACES { return }
    const at = workarounds.*.count
    workarounds.*.file[at] = file
    workarounds.*.offset[at] = @intCast(u32, offset)
    workarounds.*.pattern[at] = pattern
    workarounds.*.symbol[at] = symbol
    workarounds.*.count += 1
    workarounds.*.perPattern[@intCast(usize, pattern)] += 1
    if symbol != NONE && @intCast(usize, symbol) < workarounds.*.markCapacity {
        workarounds.*.marks[symbol] = workarounds.*.marks[symbol] | (@intCast(u16, 1) << @intCast(u16, pattern))
        workarounds.*.places[symbol] += 1
    }
}

// ---------------------------------------------------------------------------
// Scanning a file's text

// The file's path relative to the root.
fn relativePath(index: *Index, file: u32) -> []const u8 {
    const path = index_module.pathOf(index, file)
    const root = index.*.root[0..index.*.rootLength]
    if path.length > root.length + 1 && index_module.sameBytes(path[0..root.length], root) && path[root.length] == 47 { return path[root.length + 1..path.length] }
    return path
}

// `NAME = (NAME + 1) & ...` or `% ...` at `at`: an open-addressing probe.
fn probesTable(source: []const u8, at: usize) -> bool {
    var name_end = at
    while name_end < source.length && isNameByte(source[name_end]) { name_end += 1 }
    if name_end == at { return false }
    const name = source[at..name_end]
    var rest = name_end
    if !startsAt(source, rest, " = (") { return false }
    rest += 4
    if rest + name.length > source.length || !index_module.sameBytes(source[rest..rest + name.length], name) { return false }
    rest += name.length
    if !startsAt(source, rest, " + 1) ") { return false }
    rest += 6
    return rest < source.length && (source[rest] == 38 || source[rest] == 37)
}

// Whether the function around `at` (back to the last `fn ` at a line's
// start) speaks of a hash, a slot or a probe (a ring buffer advances
// the same way and does not).
fn aroundSpeaksOfTable(source: []const u8, at: usize) -> bool {
    var start = at
    var looked: usize = 0
    while start > 0 && looked < 6000 {
        start -= 1
        looked += 1
        if source[start] == 10 {
            var line = start + 1
            while line < source.length && isSpace(source[line]) { line += 1 }
            if startsAt(source, line, "fn ") || startsAt(source, line, "pub fn ") || startsAt(source, line, "inline fn ") { break }
        }
    }
    var scan = start
    while scan + 4 <= at {
        const first = lower(source[scan])
        if first == 104 && foldedAt(source, scan, at, "hash") { return true }
        if first == 115 && foldedAt(source, scan, at, "slot") { return true }
        if first == 112 && foldedAt(source, scan, at, "probe") { return true }
        scan += 1
    }
    return false
}

// `capacity: usize` at `at` (a field), with a `[*]T` field above it in
// the same struct: an array grown by hand.
fn growsArray(source: []const u8, at: usize) -> bool {
    if !startsAt(source, at, "capacity: usize") { return false }
    // The lines above, up the struct: a field `name: [*]T` makes it; a
    // closing brace or a line at the margin (the struct's own, or what
    // is before it) ends the look.
    var start = at
    var lines: usize = 0
    while start > 0 && lines < 24 {
        start -= 1
        if source[start] != 10 { continue }
        lines += 1
        var line = start + 1
        while line < source.length && isSpace(source[line]) { line += 1 }
        if line >= source.length || source[line] == 10 { continue }
        if source[line] == 47 { continue }
        if source[line] == 125 || line == start + 1 { return false }
        var colon = line
        while colon < at && source[colon] != 10 && source[colon] != 58 { colon += 1 }
        if colon < at && source[colon] == 58 && startsAt(source, colon, ": [*]") { return true }
    }
    return false
}

fn scanFile(workarounds: *Workarounds, file: u32) -> void {
    const index = workarounds.*.index
    const source = index_module.sourceOf(index, file)
    workarounds.*.rangeFile = NONE
    const math_library = isMathLibrary(index_module.pathOf(index, file))
    const relative = relativePath(index, file)
    const pages_allowed = isBackingSite(relative)
    const containers_allowed = isContainerSite(relative)
    var at: usize = 0
    var line_start = true
    while at < source.length {
        const byte = source[at]
        if byte == 10 {
            line_start = true
            at += 1
            continue
        }
        // Comments: one place per comment block that names a workaround.
        if byte == 47 && at + 1 < source.length && source[at + 1] == 47 {
            var end = at
            while end < source.length && source[end] != 10 { end += 1 }
            if saysWorkaround(source, at, end) { placeAt(workarounds, file, at, COMMENT) }
            at = end
            continue
        }
        if byte == 34 {
            at += 1
            while at < source.length && source[at] != 34 && source[at] != 10 {
                if source[at] == 92 { at += 1 }
                at += 1
            }
            at += 1
            continue
        }
        if byte == 39 {
            at += 1
            while at < source.length && source[at] != 39 && source[at] != 10 {
                if source[at] == 92 { at += 1 }
                at += 1
            }
            at += 1
            continue
        }
        if byte == 64 && startsAt(source, at, "@ptrFromInt(") {
            if callContains(source, at + 12, "@intFromPtr(") { placeAt(workarounds, file, at, POINTER_MATH) }
        } else if byte == 64 && startsAt(source, at, "@ptrCast([*]") {
            if callContains(source, at + 9, ", &") { placeAt(workarounds, file, at, ARRAY_CAST) }
        } else if (byte == 97 || byte == 116) && (at == 0 || !isNameByte(source[at - 1])) && (startsAt(source, at, "aggregates.mark(") || startsAt(source, at, "aggregates.reset(") || startsAt(source, at, "turns.begin(") || startsAt(source, at, "turns.turn(")) {
            placeAt(workarounds, file, at, ARENA)
        } else if byte == 112 && !pages_allowed && (at == 0 || !isNameByte(source[at - 1])) && startsAt(source, at, "page_allocator.init()") {
            placeAt(workarounds, file, at, PAGES)
        } else if byte >= 48 && byte <= 57 && (at == 0 || !isNameByte(source[at - 1])) {
            // A float literal with 12 decimals or more.
            var end = at
            while end < source.length && source[end] >= 48 && source[end] <= 57 { end += 1 }
            if end + 1 < source.length && source[end] == 46 {
                var decimals = end + 1
                while decimals < source.length && source[decimals] >= 48 && source[decimals] <= 57 { decimals += 1 }
                if decimals - end - 1 >= 12 && !math_library { placeAt(workarounds, file, at, FLOATS) }
                end = decimals
            }
            at = end
            line_start = false
            continue
        } else if line_start && !isSpace(byte) {
            line_start = false
            if startsAt(source, at, "for ") && countsByHand(source, at) { placeAt(workarounds, file, at, COUNTED) }
            if startsAt(source, at, "var ") && setInUnsafe(source, at) { placeAt(workarounds, file, at, UNSAFE_SET) }
            if !containers_allowed && probesTable(source, at) && aroundSpeaksOfTable(source, at) { placeAt(workarounds, file, at, TABLE) }
            if !containers_allowed && growsArray(source, at) { placeAt(workarounds, file, at, ARRAY) }
        }
        if !isSpace(byte) { line_start = false }
        at += 1
    }
}

// Whether the call whose arguments start at `from` has `word` in them.
fn callContains(source: []const u8, from: usize, word: []const u8) -> bool {
    var depth: usize = 1
    var at = from
    while at < source.length && source[at] != 10 {
        if source[at] == 40 { depth += 1 }
        if source[at] == 41 {
            depth -= 1
            if depth == 0 { return false }
        }
        if startsAt(source, at, word) { return true }
        at += 1
    }
    return false
}

// `for X in Y { Z += 1 }` on one line.
fn countsByHand(source: []const u8, at: usize) -> bool {
    var end = at
    while end < source.length && source[end] != 10 { end += 1 }
    var close = end
    while close > at && isSpace(source[close - 1]) { close -= 1 }
    if close < at + 8 || source[close - 1] != 125 { return false }
    var brace = at
    while brace < close && source[brace] != 123 { brace += 1 }
    var body = brace + 1
    while body < close && isSpace(source[body]) { body += 1 }
    var name_end = body
    while name_end < close && isNameByte(source[name_end]) { name_end += 1 }
    if name_end == body { return false }
    return startsAt(source, name_end, " += 1 }")
}

// `var NAME: T = undefined` whose next line is `unsafe { NAME = `.
fn setInUnsafe(source: []const u8, at: usize) -> bool {
    const name_start = at + 4
    var name_end = name_start
    while name_end < source.length && isNameByte(source[name_end]) { name_end += 1 }
    if name_end == name_start { return false }
    var end = name_end
    while end < source.length && source[end] != 10 { end += 1 }
    if end < 10 || !startsAt(source, end - 10, " undefined") { return false }
    var next = end + 1
    while next < source.length && isSpace(source[next]) { next += 1 }
    if !startsAt(source, next, "unsafe { ") { return false }
    next += 9
    var offset: usize = 0
    while name_start + offset < name_end {
        if next + offset >= source.length || source[next + offset] != source[name_start + offset] { return false }
        offset += 1
    }
    return startsAt(source, next + offset, " = ")
}

// `word` (lower case) at text[at..], before `end`, ignoring case.
fn foldedAt(text: []const u8, at: usize, end: usize, word: []const u8) -> bool {
    if at + word.length > end { return false }
    var offset: usize = 0
    while offset < word.length {
        if lower(text[at + offset]) != word[offset] { return false }
        offset += 1
    }
    return true
}

// Comment text naming a workaround or a gap of the compiler. One pass over
// the comment: the phrases are tried only where their first letter is
// (comments are much of the code base, and every one is asked).
fn saysWorkaround(source: []const u8, start: usize, end: usize) -> bool {
    var at = start
    while at < end {
        const byte = source[at]
        const first = lower(byte)
        if first == 119 {
            // "workaround" (the plural names the findings, as in this tool).
            if foldedAt(source, at, end, "workaround") && (at + 10 >= end || lower(source[at + 10]) != 115) { return true }
            if foldedAt(source, at, end, "work around") { return true }
        } else if first == 109 {
            if foldedAt(source, at, end, "miscompil") || foldedAt(source, at, end, "mlx has no") { return true }
        } else if first == 99 {
            if foldedAt(source, at, end, "compiler bug") || foldedAt(source, at, end, "cannot yet") { return true }
        } else if first == 100 {
            if foldedAt(source, at, end, "do not yet") || foldedAt(source, at, end, "does not yet") || foldedAt(source, at, end, "do not expose") { return true }
        } else if first == 116 {
            if foldedAt(source, at, end, "the compiler keeps") || foldedAt(source, at, end, "the compiler does not") || foldedAt(source, at, end, "the compiler cannot") || foldedAt(source, at, end, "there is no libm") { return true }
        }
        // Markers, as words in capitals.
        if (byte == 84 || byte == 70 || byte == 72 || byte == 88) && at + 4 <= end {
            if startsAt(source, at, "TODO") || startsAt(source, at, "FIXME") || startsAt(source, at, "HACK") || startsAt(source, at, "XXX") {
                const before = at == start || !isNameByte(source[at - 1])
                var after = at
                while after < end && isNameByte(source[after]) { after += 1 }
                const word = after - at
                if before && (word == 4 || word == 5 || word == 3) { return true }
            }
        }
        at += 1
    }
    return false
}

// A place in the text: on the innermost declaration around it (a
// comment above one: on the one below).
fn placeAt(workarounds: *Workarounds, file: u32, offset: usize, pattern: u8) -> void {
    if workarounds.*.rangeFile != file { makeRanges(workarounds, file) }
    var found = NONE
    var at: usize = 0
    var next = NONE
    var next_start: u32 = 4294967295
    while at < workarounds.*.rangeCount {
        const start = workarounds.*.rangeStart[at]
        if @intCast(usize, start) <= offset && offset < @intCast(usize, workarounds.*.rangeEnd[at]) { found = workarounds.*.rangeSymbol[at] }
        if pattern == COMMENT && @intCast(usize, start) > offset && start < next_start {
            next_start = start
            next = workarounds.*.rangeSymbol[at]
        }
        at += 1
    }
    if found == NONE && pattern == COMMENT { found = next }
    place(workarounds, file, offset, pattern, found)
}

// The file's declarations and their members, with the text they span.
fn makeRanges(workarounds: *Workarounds, file: u32) -> void {
    workarounds.*.rangeFile = file
    workarounds.*.rangeCount = 0
    const index = workarounds.*.index
    addRanges(workarounds, index_module.fileAt(index, file).*.symbol, 0)
}

fn addRanges(workarounds: *Workarounds, container: u32, depth: usize) -> void {
    if container == NONE || depth > 3 { return }
    const index = workarounds.*.index
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != NONE && workarounds.*.rangeCount < MAX_RANGES {
        const value = index_module.symbolAt(index, child)
        const kind = value.*.kind
        if kind == index_module.FUNCTION || kind == index_module.TEST || kind == index_module.CONST || kind == index_module.VAR || kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION {
            const first = if value.*.firstToken != NONE { index_module.tokenAt(index, value.*.file, @intCast(usize, value.*.firstToken)).start } else { @intCast(usize, value.*.nameStart) }
            const at = workarounds.*.rangeCount
            workarounds.*.rangeStart[at] = @intCast(u32, first)
            workarounds.*.rangeEnd[at] = @intCast(u32, index_module.declarationEnd(index, child))
            workarounds.*.rangeSymbol[at] = child
            workarounds.*.rangeCount += 1
            if kind != index_module.FUNCTION && kind != index_module.TEST { addRanges(workarounds, child, depth + 1) }
        }
        child = value.*.nextSibling
    }
}

// ---------------------------------------------------------------------------
// Asking

// The patterns, the most places first, into `into`; how many have places.
pub fn ranked(workarounds: *Workarounds, into: [*]u8) -> usize {
    var count: usize = 0
    var pattern: usize = 0
    while pattern < PATTERNS {
        if workarounds.*.perPattern[pattern] > 0 {
            var place_at = count
            while place_at > 0 && workarounds.*.perPattern[@intCast(usize, into[place_at - 1])] < workarounds.*.perPattern[pattern] {
                into[place_at] = into[place_at - 1]
                place_at -= 1
            }
            into[place_at] = @intCast(u8, pattern)
            count += 1
        }
        pattern += 1
    }
    return count
}

// The declarations with places of `pattern`, the most first: their
// symbols into `symbols`, how many places each into `counts`; how many.
// Places outside any declaration are left out.
pub fn declarations(workarounds: *Workarounds, pattern: u8, symbols: [*]u32, counts: [*]u32, capacity: usize) -> usize {
    // The places' symbols, sorted, then counted.
    const scratch = workarounds.*.scratch
    var total: usize = 0
    var at: usize = 0
    while at < workarounds.*.count {
        if workarounds.*.pattern[at] == pattern && workarounds.*.symbol[at] != NONE {
            scratch[total] = workarounds.*.symbol[at]
            total += 1
        }
        at += 1
    }
    sortWords(scratch, total)
    var count: usize = 0
    at = 0
    while at < total {
        var end = at
        while end < total && scratch[end] == scratch[at] { end += 1 }
        if count < capacity {
            symbols[count] = scratch[at]
            counts[count] = @intCast(u32, end - at)
            count += 1
        } else {
            // Full: keep the ones with more places.
            var smallest: usize = 0
            var place_at: usize = 1
            while place_at < count {
                if counts[place_at] < counts[smallest] { smallest = place_at }
                place_at += 1
            }
            if @intCast(u32, end - at) > counts[smallest] {
                symbols[smallest] = scratch[at]
                counts[smallest] = @intCast(u32, end - at)
            }
        }
        at = end
    }
    // Most places first.
    at = 1
    while at < count {
        const symbol = symbols[at]
        const places = counts[at]
        var place_at = at
        while place_at > 0 && counts[place_at - 1] < places {
            symbols[place_at] = symbols[place_at - 1]
            counts[place_at] = counts[place_at - 1]
            place_at -= 1
        }
        symbols[place_at] = symbol
        counts[place_at] = places
        at += 1
    }
    return count
}

// The places of `pattern` in `symbol`: their offsets into `into`; how many.
pub fn placesIn(workarounds: *Workarounds, pattern: u8, symbol: u32, into: [*]u32, capacity: usize) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < workarounds.*.count && count < capacity {
        if workarounds.*.pattern[at] == pattern && workarounds.*.symbol[at] == symbol {
            into[count] = workarounds.*.offset[at]
            count += 1
        }
        at += 1
    }
    return count
}

fn sortWords(values: [*]u32, count: usize) -> void {
    var gap = count / 2
    while gap > 0 {
        var at = gap
        while at < count {
            const value = values[at]
            var place_at = at
            while place_at >= gap && values[place_at - gap] > value {
                values[place_at] = values[place_at - gap]
                place_at -= gap
            }
            values[place_at] = value
            at += 1
        }
        gap /= 2
    }
}
