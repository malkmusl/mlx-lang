// Where the code works around what the language or its compiler does not
// do yet: each pattern below is a missing feature, and every place written
// that way is one more reason to add it. mlx-codemap's `workarounds` and
// MLX Codemap's findings list them, the most written first, and put them
// on the declarations they are in.
//
//   - Pointer arithmetic by integer: @ptrFromInt(... @intFromPtr(...) ...),
//     for want of pointer offsets (p + n) and slicing a many-pointer.
//   - Arrays cast to many-pointers: @ptrCast([*]T, &array), for want of
//     *[N]T coercing to [*]T.
//   - Declared undefined, set in unsafe: `var x: T = undefined` and then
//     `unsafe { x = ... }`, for want of unsafe expressions.
//   - Results bound to be dropped: `const ignored = call(...)` (a local
//     constant nothing reads), for want of `_ = value`.
//   - Lengths counted by hand: `for byte in text { length += 1 }`, for want
//     of a slice's length in the bootstrap library.
//   - Temporaries released by hand: aggregates.mark and reset, turns, for
//     want of freeing struct literals and structs returned by value (they
//     live in an arena that is never freed).
//   - Float constants written out: literals with 12 and more decimals, for
//     want of folding float arithmetic right (1.0 / 255.0 folds to 0).
//   - Math written out: sqrt, sin, cos, exp, ln, ... as Mlx functions, for
//     want of math builtins.
//   - Said in a comment: comments naming a workaround (the word, not its
//     plural, which names these findings), a miscompilation,
//     what the compiler does not do yet, TODO, FIXME, HACK.
//
// Generated code (/generated/) is left out, and this file.
const std = @import("std")
const index_module = @import("./index.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

pub const POINTER_MATH: u8 = 0
pub const ARRAY_CAST: u8 = 1
pub const UNSAFE_SET: u8 = 2
pub const DROPPED: u8 = 3
pub const COUNTED: u8 = 4
pub const ARENA: u8 = 5
pub const FLOATS: u8 = 6
pub const MATH: u8 = 7
pub const COMMENT: u8 = 8
pub const PATTERNS: usize = 9

pub const MAX_PLACES: usize = 262144
const MAX_RANGES: usize = 16384

pub const Workarounds = struct {
    index: *Index
    allocator: Allocator
    // Every place: its file, byte offset, pattern and declaration.
    count: usize
    file: [*]u32
    offset: [*]u32
    pattern: [*]u8
    symbol: [*]u32
    perPattern: [9]usize
    // Per symbol: a bit per pattern found in it, and how many places.
    marks: [*]u16
    places: [*]u32
    markCapacity: usize
    // Per symbol: how many uses (to find locals nothing reads).
    uses: [*]u32
    // The declarations of the file being scanned: where each starts and
    // ends, and which it is (outer ones first).
    rangeStart: [*]u32
    rangeEnd: [*]u32
    rangeSymbol: [*]u32
    rangeCount: usize
    rangeFile: u32
    scratch: [*]u32
}

fn words(allocator: Allocator, count: usize) -> [*]u32 {
    unsafe { return @ptrCast([*]u32, allocator.alloc(count * 4 + 4, 16).?) }
}

pub fn init(workarounds: *Workarounds, allocator: Allocator) -> void {
    workarounds.*.allocator = allocator
    workarounds.*.count = 0
    workarounds.*.file = words(allocator, MAX_PLACES)
    workarounds.*.offset = words(allocator, MAX_PLACES)
    workarounds.*.pattern = allocator.alloc(MAX_PLACES, 16).?
    workarounds.*.symbol = words(allocator, MAX_PLACES)
    workarounds.*.scratch = words(allocator, MAX_PLACES * 2)
    workarounds.*.rangeStart = words(allocator, MAX_RANGES)
    workarounds.*.rangeEnd = words(allocator, MAX_RANGES)
    workarounds.*.rangeSymbol = words(allocator, MAX_RANGES)
    workarounds.*.markCapacity = 0
}

// The pattern's name.
pub fn title(pattern: u8, german: bool) -> []const u8 {
    if pattern == POINTER_MATH { return if german { "Zeigerrechnung über Zahlen" } else { "Pointer arithmetic by integer" } }
    if pattern == ARRAY_CAST { return if german { "Arrays zu Vielfachzeigern gecastet" } else { "Arrays cast to many-pointers" } }
    if pattern == UNSAFE_SET { return if german { "Undefiniert deklariert, in unsafe gesetzt" } else { "Declared undefined, set in unsafe" } }
    if pattern == DROPPED { return if german { "Ergebnisse nur zum Verwerfen gebunden" } else { "Results bound to be dropped" } }
    if pattern == COUNTED { return if german { "Längen von Hand gezählt" } else { "Lengths counted by hand" } }
    if pattern == ARENA { return if german { "Temporäres von Hand freigegeben" } else { "Temporaries released by hand" } }
    if pattern == FLOATS { return if german { "Float-Konstanten ausgeschrieben" } else { "Float constants written out" } }
    if pattern == MATH { return if german { "Mathematik ausgeschrieben" } else { "Math written out" } }
    return if german { "Im Kommentar gesagt" } else { "Said in a comment" }
}

// The pattern's name, short (for a list of them).
pub fn shortTitle(pattern: u8, german: bool) -> []const u8 {
    if pattern == POINTER_MATH { return if german { "Zeigerrechnung" } else { "Pointer math" } }
    if pattern == ARRAY_CAST { return if german { "Array-Casts" } else { "Array casts" } }
    if pattern == UNSAFE_SET { return if german { "In unsafe gesetzt" } else { "Set in unsafe" } }
    if pattern == DROPPED { return if german { "Verworfene Ergebnisse" } else { "Dropped results" } }
    if pattern == COUNTED { return if german { "Gezählte Längen" } else { "Counted lengths" } }
    if pattern == ARENA { return if german { "Arena von Hand" } else { "Arena by hand" } }
    if pattern == FLOATS { return if german { "Float-Konstanten" } else { "Float constants" } }
    if pattern == MATH { return if german { "Mathe ausgeschrieben" } else { "Math written out" } }
    return if german { "Kommentare" } else { "Comments" }
}

// What is missing, that the pattern stands in for.
pub fn missing(pattern: u8, german: bool) -> []const u8 {
    if pattern == POINTER_MATH { return if german { "Fehlt: Zeiger plus Versatz (p + n), Vielfachzeiger schneiden" } else { "Missing: pointer offsets (p + n), slicing a many-pointer" } }
    if pattern == ARRAY_CAST { return if german { "Fehlt: *[N]T wird zu [*]T" } else { "Missing: *[N]T coercing to [*]T" } }
    if pattern == UNSAFE_SET { return if german { "Fehlt: unsafe als Ausdruck" } else { "Missing: unsafe expressions" } }
    if pattern == DROPPED { return if german { "Fehlt: _ = Wert zum Verwerfen" } else { "Missing: _ = value to drop a result" } }
    if pattern == COUNTED { return if german { "Fehlt: die Länge eines Slices (Bootstrap-Bibliothek)" } else { "Missing: a slice's length (bootstrap library)" } }
    if pattern == ARENA { return if german { "Fehlt: Struct-Literale und Struct-Rückgaben freigeben" } else { "Missing: freeing struct literals and structs returned" } }
    if pattern == FLOATS { return if german { "Fehlt: Float-Arithmetik richtig falten" } else { "Missing: folding float arithmetic right" } }
    if pattern == MATH { return if german { "Fehlt: Mathe-Builtins (sqrt, sin, ...)" } else { "Missing: math builtins (sqrt, sin, ...)" } }
    return if german { "Was der Kommentar nennt" } else { "What the comment names" }
}

pub fn countOf(workarounds: *Workarounds, pattern: u8) -> usize { return workarounds.*.perPattern[@intCast(usize, pattern)] }

// How often `symbol` is used (counted by run and runFile, over all files).
pub fn usesOf(workarounds: *Workarounds, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= workarounds.*.markCapacity { return 0 }
    return workarounds.*.uses[symbol]
}

// How many places of any pattern are in `symbol`.
pub fn placesOf(workarounds: *Workarounds, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= workarounds.*.markCapacity { return 0 }
    return workarounds.*.places[symbol]
}

// The patterns found in `symbol`, a bit each.
pub fn marksOf(workarounds: *Workarounds, symbol: u32) -> u16 {
    if symbol == NONE || @intCast(usize, symbol) >= workarounds.*.markCapacity { return 0 }
    return workarounds.*.marks[symbol]
}

fn startsAt(text: []const u8, at: usize, word: []const u8) -> bool {
    if at + word.length > text.length { return false }
    var offset: usize = 0
    while offset < word.length {
        if text[at + offset] != word[offset] { return false }
        offset += 1
    }
    return true
}

fn lower(byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 { return byte + 32 }
    return byte
}

// `word` (lower case) in text[start..end], ignoring case.
fn containsFolded(text: []const u8, start: usize, end: usize, word: []const u8) -> bool {
    var at = start
    while at + word.length <= end {
        var offset: usize = 0
        while offset < word.length && lower(text[at + offset]) == word[offset] { offset += 1 }
        if offset == word.length { return true }
        at += 1
    }
    return false
}

// `word` (lower case) in text[start..end], ignoring case, not followed by
// an s.
fn containsSingular(text: []const u8, start: usize, end: usize, word: []const u8) -> bool {
    var at = start
    while at + word.length <= end {
        var offset: usize = 0
        while offset < word.length && lower(text[at + offset]) == word[offset] { offset += 1 }
        if offset == word.length && (at + offset >= end || lower(text[at + offset]) != 115) { return true }
        at += 1
    }
    return false
}

fn isNameByte(byte: u8) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 }

fn isPathLeftOut(path: []const u8) -> bool {
    var at: usize = 0
    while at < path.length {
        if startsAt(path, at, "/generated/") { return true }
        if startsAt(path, at, "tools/codemap/workarounds.mlx") { return true }
        at += 1
    }
    return false
}

pub fn run(workarounds: *Workarounds, index: *Index) -> void { runIn(workarounds, index, NONE) }

// Only the places in one file (for an editor: the whole code base takes a
// while).
pub fn runFile(workarounds: *Workarounds, index: *Index, file: u32) -> void { runIn(workarounds, index, file) }

fn runIn(workarounds: *Workarounds, index: *Index, only: u32) -> void {
    workarounds.*.index = index
    workarounds.*.count = 0
    var pattern: usize = 0
    while pattern < PATTERNS {
        workarounds.*.perPattern[pattern] = 0
        pattern += 1
    }
    if index.*.symbolCount > workarounds.*.markCapacity {
        const capacity = index.*.symbolCount + index.*.symbolCount / 2 + 1024
        unsafe { workarounds.*.marks = @ptrCast([*]u16, workarounds.*.allocator.alloc(capacity * 2 + 2, 16).?) }
        workarounds.*.uses = words(workarounds.*.allocator, capacity)
        workarounds.*.places = words(workarounds.*.allocator, capacity)
        workarounds.*.markCapacity = capacity
    }
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        workarounds.*.marks[symbol] = 0
        workarounds.*.uses[symbol] = 0
        workarounds.*.places[symbol] = 0
        symbol += 1
    }
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use != index_module.USE_DECLARATION && value.*.symbol != NONE { workarounds.*.uses[value.*.symbol] += 1 }
        ref += 1
    }
    var file: usize = 0
    while file < index.*.fileCount {
        const id = @intCast(u32, file)
        if (only == NONE || only == id) && !isPathLeftOut(index_module.pathOf(index, id)) { scanFile(workarounds, id) }
        file += 1
    }
    // Locals nothing reads that hold a call's result, and math functions.
    symbol = 0
    while symbol < index.*.symbolCount {
        const value = index_module.symbolAt(index, @intCast(u32, symbol))
        if (only == NONE || only == value.*.file) && !isPathLeftOut(index_module.pathOf(index, value.*.file)) {
            if value.*.kind == index_module.LOCAL_CONST && workarounds.*.uses[symbol] == 0 && holdsCall(index, value.*.file, @intCast(usize, value.*.nameStart)) {
                place(workarounds, value.*.file, @intCast(usize, value.*.nameStart), DROPPED, enclosingFunction(index, @intCast(u32, symbol)))
            }
            if value.*.kind == index_module.FUNCTION && isMathName(index_module.nameOf(index, @intCast(u32, symbol))) {
                place(workarounds, value.*.file, @intCast(usize, value.*.nameStart), MATH, @intCast(u32, symbol))
            }
        }
        symbol += 1
    }
}

// The function (or top-level declaration) a local is in.
fn enclosingFunction(index: *Index, symbol: u32) -> u32 {
    var current = index_module.symbolAt(index, symbol).*.parent
    while current != NONE {
        const value = index_module.symbolAt(index, current)
        if value.*.kind == index_module.FUNCTION || value.*.kind == index_module.TEST { return current }
        if value.*.kind == index_module.FILE { return NONE }
        current = value.*.parent
    }
    return NONE
}

// Whether the rest of the line after a local's name is `= name(...)`-like.
fn holdsCall(index: *Index, file: u32, offset: usize) -> bool {
    const source = index_module.sourceOf(index, file)
    var at = offset
    while at < source.length && source[at] != 61 && source[at] != 10 { at += 1 }
    while at < source.length && source[at] != 10 {
        if source[at] == 40 { return true }
        at += 1
    }
    return false
}

fn isMathName(name: []const u8) -> bool {
    const names = "sqrt sin cos tan atan atan2 exp ln log log2 pow floor ceil fabs hypot"
    var start: usize = 0
    var at: usize = 0
    while at <= names.length {
        if at == names.length || names[at] == 32 {
            if index_module.sameBytes(names[start..at], name) { return true }
            start = at + 1
        }
        at += 1
    }
    return false
}

fn place(workarounds: *Workarounds, file: u32, offset: usize, pattern: u8, symbol: u32) -> void {
    if workarounds.*.count >= MAX_PLACES { return }
    const at = workarounds.*.count
    workarounds.*.file[at] = file
    workarounds.*.offset[at] = @intCast(u32, offset)
    workarounds.*.pattern[at] = pattern
    workarounds.*.symbol[at] = symbol
    workarounds.*.count += 1
    workarounds.*.perPattern[@intCast(usize, pattern)] += 1
    if symbol != NONE && @intCast(usize, symbol) < workarounds.*.markCapacity {
        workarounds.*.marks[symbol] = workarounds.*.marks[symbol] | (@intCast(u16, 1) << @intCast(u16, pattern))
        workarounds.*.places[symbol] += 1
    }
}

// ---------------------------------------------------------------------------
// Scanning a file's text

fn scanFile(workarounds: *Workarounds, file: u32) -> void {
    const index = workarounds.*.index
    const source = index_module.sourceOf(index, file)
    workarounds.*.rangeFile = NONE
    var at: usize = 0
    var line_start = true
    while at < source.length {
        const byte = source[at]
        if byte == 10 {
            line_start = true
            at += 1
            continue
        }
        // Comments: one place per comment block that names a workaround.
        if byte == 47 && at + 1 < source.length && source[at + 1] == 47 {
            var end = at
            while end < source.length && source[end] != 10 { end += 1 }
            if saysWorkaround(source, at, end) { placeAt(workarounds, file, at, COMMENT) }
            at = end
            continue
        }
        if byte == 34 {
            at += 1
            while at < source.length && source[at] != 34 && source[at] != 10 {
                if source[at] == 92 { at += 1 }
                at += 1
            }
            at += 1
            continue
        }
        if byte == 39 {
            at += 1
            while at < source.length && source[at] != 39 && source[at] != 10 {
                if source[at] == 92 { at += 1 }
                at += 1
            }
            at += 1
            continue
        }
        if byte == 64 && startsAt(source, at, "@ptrFromInt(") {
            if callContains(source, at + 12, "@intFromPtr(") { placeAt(workarounds, file, at, POINTER_MATH) }
        } else if byte == 64 && startsAt(source, at, "@ptrCast([*]") {
            if callContains(source, at + 9, ", &") { placeAt(workarounds, file, at, ARRAY_CAST) }
        } else if (byte == 97 || byte == 116) && (at == 0 || !isNameByte(source[at - 1])) && (startsAt(source, at, "aggregates.mark(") || startsAt(source, at, "aggregates.reset(") || startsAt(source, at, "turns.begin(") || startsAt(source, at, "turns.turn(")) {
            placeAt(workarounds, file, at, ARENA)
        } else if byte >= 48 && byte <= 57 && (at == 0 || !isNameByte(source[at - 1])) {
            // A float literal with 12 decimals or more.
            var end = at
            while end < source.length && source[end] >= 48 && source[end] <= 57 { end += 1 }
            if end + 1 < source.length && source[end] == 46 {
                var decimals = end + 1
                while decimals < source.length && source[decimals] >= 48 && source[decimals] <= 57 { decimals += 1 }
                if decimals - end - 1 >= 12 { placeAt(workarounds, file, at, FLOATS) }
                end = decimals
            }
            at = end
            line_start = false
            continue
        } else if line_start && !isSpace(byte) {
            line_start = false
            if startsAt(source, at, "for ") && countsByHand(source, at) { placeAt(workarounds, file, at, COUNTED) }
            if startsAt(source, at, "var ") && setInUnsafe(source, at) { placeAt(workarounds, file, at, UNSAFE_SET) }
        }
        if !isSpace(byte) { line_start = false }
        at += 1
    }
}

// Whether the call whose arguments start at `from` has `word` in them.
fn callContains(source: []const u8, from: usize, word: []const u8) -> bool {
    var depth: usize = 1
    var at = from
    while at < source.length && source[at] != 10 {
        if source[at] == 40 { depth += 1 }
        if source[at] == 41 {
            depth -= 1
            if depth == 0 { return false }
        }
        if startsAt(source, at, word) { return true }
        at += 1
    }
    return false
}

// `for X in Y { Z += 1 }` on one line.
fn countsByHand(source: []const u8, at: usize) -> bool {
    var end = at
    while end < source.length && source[end] != 10 { end += 1 }
    var close = end
    while close > at && isSpace(source[close - 1]) { close -= 1 }
    if close < at + 8 || source[close - 1] != 125 { return false }
    var brace = at
    while brace < close && source[brace] != 123 { brace += 1 }
    var body = brace + 1
    while body < close && isSpace(source[body]) { body += 1 }
    var name_end = body
    while name_end < close && isNameByte(source[name_end]) { name_end += 1 }
    if name_end == body { return false }
    return startsAt(source, name_end, " += 1 }")
}

// `var NAME: T = undefined` whose next line is `unsafe { NAME = `.
fn setInUnsafe(source: []const u8, at: usize) -> bool {
    const name_start = at + 4
    var name_end = name_start
    while name_end < source.length && isNameByte(source[name_end]) { name_end += 1 }
    if name_end == name_start { return false }
    var end = name_end
    while end < source.length && source[end] != 10 { end += 1 }
    if end < 10 || !startsAt(source, end - 10, " undefined") { return false }
    var next = end + 1
    while next < source.length && isSpace(source[next]) { next += 1 }
    if !startsAt(source, next, "unsafe { ") { return false }
    next += 9
    var offset: usize = 0
    while name_start + offset < name_end {
        if next + offset >= source.length || source[next + offset] != source[name_start + offset] { return false }
        offset += 1
    }
    return startsAt(source, next + offset, " = ")
}

// Comment text naming a workaround or a gap of the compiler.
fn saysWorkaround(source: []const u8, start: usize, end: usize) -> bool {
    // "workaround" (the plural names the findings, as in this tool).
    if containsSingular(source, start, end, "workaround") || containsFolded(source, start, end, "work around") { return true }
    if containsFolded(source, start, end, "miscompil") || containsFolded(source, start, end, "compiler bug") { return true }
    if containsFolded(source, start, end, "do not yet") || containsFolded(source, start, end, "does not yet") || containsFolded(source, start, end, "cannot yet") { return true }
    if containsFolded(source, start, end, "the compiler keeps") || containsFolded(source, start, end, "the compiler does not") || containsFolded(source, start, end, "the compiler cannot") { return true }
    if containsFolded(source, start, end, "mlx has no") || containsFolded(source, start, end, "there is no libm") || containsFolded(source, start, end, "do not expose") { return true }
    // Markers, as words in capitals.
    var at = start
    while at + 4 <= end {
        if startsAt(source, at, "TODO") || startsAt(source, at, "FIXME") || startsAt(source, at, "HACK") || startsAt(source, at, "XXX") {
            const before = at == start || !isNameByte(source[at - 1])
            var after = at
            while after < end && isNameByte(source[after]) { after += 1 }
            const word = after - at
            if before && (word == 4 || word == 5 || word == 3) { return true }
        }
        at += 1
    }
    return false
}

// A place in the text: on the innermost declaration around it (a
// comment above one: on the one below).
fn placeAt(workarounds: *Workarounds, file: u32, offset: usize, pattern: u8) -> void {
    if workarounds.*.rangeFile != file { makeRanges(workarounds, file) }
    var found = NONE
    var at: usize = 0
    var next = NONE
    var next_start: u32 = 4294967295
    while at < workarounds.*.rangeCount {
        const start = workarounds.*.rangeStart[at]
        if @intCast(usize, start) <= offset && offset < @intCast(usize, workarounds.*.rangeEnd[at]) { found = workarounds.*.rangeSymbol[at] }
        if pattern == COMMENT && @intCast(usize, start) > offset && start < next_start {
            next_start = start
            next = workarounds.*.rangeSymbol[at]
        }
        at += 1
    }
    if found == NONE && pattern == COMMENT { found = next }
    place(workarounds, file, offset, pattern, found)
}

// The file's declarations and their members, with the text they span.
fn makeRanges(workarounds: *Workarounds, file: u32) -> void {
    workarounds.*.rangeFile = file
    workarounds.*.rangeCount = 0
    const index = workarounds.*.index
    addRanges(workarounds, index_module.fileAt(index, file).*.symbol, 0)
}

fn addRanges(workarounds: *Workarounds, container: u32, depth: usize) -> void {
    if container == NONE || depth > 3 { return }
    const index = workarounds.*.index
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != NONE && workarounds.*.rangeCount < MAX_RANGES {
        const value = index_module.symbolAt(index, child)
        const kind = value.*.kind
        if kind == index_module.FUNCTION || kind == index_module.TEST || kind == index_module.CONST || kind == index_module.VAR || kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION {
            const first = if value.*.firstToken != NONE { index_module.tokenAt(index, value.*.file, @intCast(usize, value.*.firstToken)).start } else { @intCast(usize, value.*.nameStart) }
            const at = workarounds.*.rangeCount
            workarounds.*.rangeStart[at] = @intCast(u32, first)
            workarounds.*.rangeEnd[at] = @intCast(u32, index_module.declarationEnd(index, child))
            workarounds.*.rangeSymbol[at] = child
            workarounds.*.rangeCount += 1
            if kind != index_module.FUNCTION && kind != index_module.TEST { addRanges(workarounds, child, depth + 1) }
        }
        child = value.*.nextSibling
    }
}

// ---------------------------------------------------------------------------
// Asking

// The patterns, the most places first, into `into`; how many have places.
pub fn ranked(workarounds: *Workarounds, into: [*]u8) -> usize {
    var count: usize = 0
    var pattern: usize = 0
    while pattern < PATTERNS {
        if workarounds.*.perPattern[pattern] > 0 {
            var place_at = count
            while place_at > 0 && workarounds.*.perPattern[@intCast(usize, into[place_at - 1])] < workarounds.*.perPattern[pattern] {
                into[place_at] = into[place_at - 1]
                place_at -= 1
            }
            into[place_at] = @intCast(u8, pattern)
            count += 1
        }
        pattern += 1
    }
    return count
}

// The declarations with places of `pattern`, the most first: their
// symbols into `symbols`, how many places each into `counts`; how many.
// Places outside any declaration are left out.
pub fn declarations(workarounds: *Workarounds, pattern: u8, symbols: [*]u32, counts: [*]u32, capacity: usize) -> usize {
    // The places' symbols, sorted, then counted.
    const scratch = workarounds.*.scratch
    var total: usize = 0
    var at: usize = 0
    while at < workarounds.*.count {
        if workarounds.*.pattern[at] == pattern && workarounds.*.symbol[at] != NONE {
            scratch[total] = workarounds.*.symbol[at]
            total += 1
        }
        at += 1
    }
    sortWords(scratch, total)
    var count: usize = 0
    at = 0
    while at < total {
        var end = at
        while end < total && scratch[end] == scratch[at] { end += 1 }
        if count < capacity {
            symbols[count] = scratch[at]
            counts[count] = @intCast(u32, end - at)
            count += 1
        } else {
            // Full: keep the ones with more places.
            var smallest: usize = 0
            var place_at: usize = 1
            while place_at < count {
                if counts[place_at] < counts[smallest] { smallest = place_at }
                place_at += 1
            }
            if @intCast(u32, end - at) > counts[smallest] {
                symbols[smallest] = scratch[at]
                counts[smallest] = @intCast(u32, end - at)
            }
        }
        at = end
    }
    // Most places first.
    at = 1
    while at < count {
        const symbol = symbols[at]
        const places = counts[at]
        var place_at = at
        while place_at > 0 && counts[place_at - 1] < places {
            symbols[place_at] = symbols[place_at - 1]
            counts[place_at] = counts[place_at - 1]
            place_at -= 1
        }
        symbols[place_at] = symbol
        counts[place_at] = places
        at += 1
    }
    return count
}

// The places of `pattern` in `symbol`: their offsets into `into`; how many.
pub fn placesIn(workarounds: *Workarounds, pattern: u8, symbol: u32, into: [*]u32, capacity: usize) -> usize {
    var count: usize = 0
    var at: usize = 0
    while at < workarounds.*.count && count < capacity {
        if workarounds.*.pattern[at] == pattern && workarounds.*.symbol[at] == symbol {
            into[count] = workarounds.*.offset[at]
            count += 1
        }
        at += 1
    }
    return count
}

fn sortWords(values: [*]u32, count: usize) -> void {
    var gap = count / 2
    while gap > 0 {
        var at = gap
        while at < count {
            const value = values[at]
            var place_at = at
            while place_at >= gap && values[place_at - gap] > value {
                values[place_at] = values[place_at - gap]
                place_at -= gap
            }
            values[place_at] = value
            at += 1
        }
        gap /= 2
    }
}
