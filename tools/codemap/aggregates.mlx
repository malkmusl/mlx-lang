// The compiler's aggregate arena, taken back. Struct literals and structs
// returned by value are put in one arena the program maps at start (256 MB,
// x86_64 backend: emitAggregateArena) and never frees: a program that runs
// long (an editor's language server, an app drawing frames) runs out of it
// and stops on a trap. What is in it is only ever a temporary (a value is
// copied where it is kept), so after a piece of work whose temporaries are
// done with (building the index, a frame, an event), the arena can go back
// to where it was before:
//
//     const arena = aggregates.find()          // once
//     const mark = aggregates.mark(arena)
//     ... work ...
//     aggregates.reset(arena, mark)
//
// Only where nothing made since the mark is still pointed to: not inside a
// function whose own locals were made after it.
//
// The arena is found in /proc/self/maps by its size (268435464 bytes,
// pages rounded up) and its first word, which is where the next allocation
// goes (within it). find() gives 0 when there is none (another backend):
// mark and reset then do nothing.
const std = @import("std")

const ARENA_BYTES: usize = 268439552

fn hexValue(byte: u8) -> usize { return @intCast(usize, std.text.hexValue(byte)) }

fn isArena(base: usize) -> bool {
    var next: usize = 0
    unsafe { next = @ptrFromInt(*usize, base).* }
    return next >= base + 8 && next <= base + ARENA_BYTES
}

pub fn find() -> usize {
    var path: [16]u8 = [16]u8{ 47, 112, 114, 111, 99, 47, 115, 101, 108, 102, 47, 109, 97, 112, 115, 0 }
    var handle: isize = 0
    unsafe { handle = std.linux.syscall3(2, @intFromPtr(&path), 524288, 0) }
    if handle < 0 { return 0 }
    var buffer: [65536]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var found: usize = 0
    // Line by line: "start-end perms ...".
    var line: [512]u8 = undefined
    var line_length: usize = 0
    var done = false
    while !done {
        const count = std.linux.syscall3(0, @bitCast(usize, handle), @intFromPtr(bytes), 65536)
        if count <= 0 { break }
        var at: usize = 0
        while at < @bitCast(usize, count) {
            const byte = bytes[at]
            if byte == 10 {
                var start: usize = 0
                var end: usize = 0
                var cursor: usize = 0
                while cursor < line_length && hexValue(line[cursor]) < 16 {
                    start = start * 16 + hexValue(line[cursor])
                    cursor += 1
                }
                if cursor < line_length && line[cursor] == 45 { cursor += 1 }
                while cursor < line_length && hexValue(line[cursor]) < 16 {
                    end = end * 16 + hexValue(line[cursor])
                    cursor += 1
                }
                // Readable and writable, big enough, and the first word
                // of the arena pointing into it. Mappings made later lie
                // right below it and the kernel joins them: the arena is
                // the end of its mapping (or the start).
                const writable = cursor + 4 < line_length && line[cursor + 1] == 114 && line[cursor + 2] == 119
                if found == 0 && writable && end > start && end - start >= ARENA_BYTES {
                    if isArena(end - ARENA_BYTES) {
                        found = end - ARENA_BYTES
                    } else if isArena(start) {
                        found = start
                    }
                }
                line_length = 0
            } else if line_length < 512 {
                line[line_length] = byte
                line_length += 1
            }
            at += 1
        }
    }
    const closed = std.linux.syscall1(3, @bitCast(usize, handle))
    return found
}

// Where the arena is now.
pub fn mark(arena: usize) -> usize {
    if arena == 0 { return 0 }
    var next: usize = 0
    unsafe { next = @ptrFromInt(*usize, arena).* }
    return next
}

// Back to `where` (from mark): what was made since is free again.
pub fn reset(arena: usize, where: usize) -> void {
    if arena == 0 || where == 0 { return }
    unsafe { @ptrFromInt(*usize, arena).* = where }
}

// How much of it is in use.
pub fn used(arena: usize) -> usize {
    if arena == 0 { return 0 }
    return mark(arena) - arena
}
