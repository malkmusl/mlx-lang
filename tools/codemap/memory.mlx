// The memory of the programs, as std.leaks writes it while they run with
// MLX_LEAK_CHECK ($XDG_RUNTIME_DIR/mlx/memory/PROGRAM-PID.memory, about
// once a second; see std/src/leaks.mlx for the lines): which programs have
// one, and of one of them how its memory is cut up.
//
// Fragmentation here is what the page allocator's blocks waste and how
// they lie: a small block is a run of 64-byte tiny pages
// (std.tinypage_allocator), a larger one whole pages, so what it asks less
// than that is lost (the size classes say where); and between the mappings
// of the blocks there are holes in the address space, many small ones
// where blocks came and went (the fragmentation index: 1 - the largest
// hole / all of them). The tiny line says how full the tiny pages are.
// Snapshots written before the tiny pages give no block its mapped size:
// whole pages are taken for them.
//
// With a GPU context open the snapshot also holds the GPU's memory: the
// device, its heaps, each block of device memory with what was asked and
// what the device took, grouped by the functions that asked. Each buffer
// is an allocation of its own, so what the GPU's memory wastes is what
// the device rounds up, and many small allocations against its limit.
// Places that hold more blocks than when the process was first looked at
// grow while the program runs: what a leak looks like.
//
//     var memory: memory_module.Memory = undefined
//     memory_module.init(&memory, allocator)
//     memory_module.list(&memory, environment)       the snapshots there
//     memory_module.load(&memory, which)             one of them, analyzed
const std = @import("std")
const index_module = @import("./index.mlx")
const crashes_module = @import("./crashes.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

pub const MAX_SNAPSHOTS: usize = 256
pub const MAX_PLACES: usize = 4096
pub const MAX_BLOCKS: usize = 65536
pub const MAX_MAPS: usize = 8192
pub const MAX_GPU_PLACES: usize = 512
pub const MAX_GPU_BLOCKS: usize = 4096
pub const GPU_HEAPS: usize = 16
pub const GPU_TYPES: usize = 32
// The GPU's size classes: below 64 KiB, 1 MiB, 16 MiB, and larger.
pub const GPU_CLASSES: usize = 4
// A heap on the device itself (VK_MEMORY_HEAP_DEVICE_LOCAL_BIT), a memory
// type the processor can map (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT).
pub const HEAP_DEVICE: u64 = 1
pub const TYPE_HOST_VISIBLE: u64 = 2
const MAX_TEXT: usize = 16777216
// The size classes: below 256 bytes, 4 KiB, 64 KiB, 1 MiB, and larger.
pub const CLASSES: usize = 5
pub const PAGE: u64 = 4096

pub const Memory = struct {
    allocator: Allocator
    directory: [*]u8
    directoryLength: usize
    // The snapshots found: name (in names), pid, time, running.
    count: usize
    nameStart: [256]u32
    nameEnd: [256]u32
    pid: [256]u64
    time: [256]u64
    running: [256]bool
    names: [*]u8
    namesUsed: usize
    // The one loaded (count: none), its text and what it says.
    loaded: usize
    text: [*]u8
    textLength: usize
    seconds: u64
    allocations: u64
    frees: u64
    blocks: u64
    bytes: u64
    mapped: u64
    peak: u64
    values: u64
    resident: u64
    // The tiny pages: pages handed out, blocks, the bytes of their tiny
    // pages, empty pages.
    tinyPages: u64
    tinyBlocks: u64
    tinyBytes: u64
    tinyEmpty: u64
    // Places: blocks, bytes, mapped, since the mark, kept, and where their
    // functions are in the text (from the first to the end of the line).
    placeCount: usize
    placeBlocks: [*]u64
    placeBytes: [*]u64
    placeMapped: [*]u64
    placeFresh: [*]u64
    placeKept: [*]u64
    placeStart: [*]u32
    placeEnd: [*]u32
    // How many more blocks than when this process was first read (0: as
    // many or fewer, or read for the first time).
    placeGrowth: [*]u64
    // The blocks (by address, as the debug allocator keeps them), and the
    // mappings in address order.
    blockCount: usize
    blockAddress: [*]u64
    blockLength: [*]u64
    blockMapped: [*]u64
    blockPlace: [*]u32
    blockFlag: [*]u8
    mapCount: usize
    mapStart: [*]u64
    mapEnd: [*]u64
    // What it comes to.
    classBlocks: [5]u64
    classBytes: [5]u64
    classMapped: [5]u64
    holes: u64
    holeBytes: u64
    largestHole: u64
    // The first snapshot read of the process loaded (for growth): its pid,
    // time, and per place a hash of its functions with its blocks.
    beforePid: u64
    beforeTime: u64
    beforeCount: usize
    beforeHash: [*]u64
    beforeBlocks: [*]u64
    // The GPU's memory (gpu: a GPU context was open): the device (its name
    // in the text), how many allocations it allows, blocks live,
    // allocations and frees; its heaps (bytes, flags, and what the blocks
    // take of each); per memory type its heap and flags; places (blocks,
    // bytes asked, allocated, functions in the text); blocks (asked,
    // allocated, type, kind, place); the size classes.
    gpu: bool
    gpuNameStart: u32
    gpuNameEnd: u32
    gpuLimit: u64
    gpuLive: u64
    gpuAllocations: u64
    gpuFrees: u64
    gpuHeapCount: usize
    gpuHeapSize: [16]u64
    gpuHeapFlags: [16]u64
    gpuHeapUsed: [16]u64
    gpuHeapBlocks: [16]u64
    gpuTypeCount: usize
    gpuTypeHeap: [32]u64
    gpuTypeFlags: [32]u64
    gpuPlaceCount: usize
    gpuPlaceBlocks: [*]u64
    gpuPlaceAsked: [*]u64
    gpuPlaceSize: [*]u64
    gpuPlaceStart: [*]u32
    gpuPlaceEnd: [*]u32
    gpuBlockCount: usize
    gpuBlockAsked: [*]u64
    gpuBlockSize: [*]u64
    gpuBlockType: [*]u32
    gpuBlockKind: [*]u8
    gpuBlockPlace: [*]u32
    gpuAsked: u64
    gpuSize: u64
    gpuClassBlocks: [4]u64
    gpuClassAsked: [4]u64
    gpuClassSize: [4]u64
}

pub fn init(memory: *Memory, allocator: Allocator) -> void {
    memory.*.allocator = allocator
    memory.*.directory = allocator.alloc(4096, 16).?
    memory.*.directoryLength = 0
    memory.*.count = 0
    memory.*.names = allocator.alloc(MAX_SNAPSHOTS * 128, 16).?
    memory.*.namesUsed = 0
    memory.*.loaded = 0
    memory.*.text = allocator.alloc(MAX_TEXT + 1, 16).?
    memory.*.textLength = 0
    memory.*.placeCount = 0
    memory.*.placeBlocks = longs(allocator, MAX_PLACES)
    memory.*.placeBytes = longs(allocator, MAX_PLACES)
    memory.*.placeMapped = longs(allocator, MAX_PLACES)
    memory.*.placeFresh = longs(allocator, MAX_PLACES)
    memory.*.placeKept = longs(allocator, MAX_PLACES)
    memory.*.placeGrowth = longs(allocator, MAX_PLACES)
    memory.*.placeStart = allocator.words(MAX_PLACES)
    memory.*.placeEnd = allocator.words(MAX_PLACES)
    memory.*.blockCount = 0
    memory.*.blockAddress = longs(allocator, MAX_BLOCKS)
    memory.*.blockLength = longs(allocator, MAX_BLOCKS)
    memory.*.blockMapped = longs(allocator, MAX_BLOCKS)
    memory.*.blockPlace = allocator.words(MAX_BLOCKS)
    memory.*.blockFlag = allocator.alloc(MAX_BLOCKS, 16).?
    memory.*.mapCount = 0
    memory.*.mapStart = longs(allocator, MAX_MAPS)
    memory.*.mapEnd = longs(allocator, MAX_MAPS)
    memory.*.beforePid = 0
    memory.*.beforeTime = 0
    memory.*.beforeCount = 0
    memory.*.beforeHash = longs(allocator, MAX_PLACES)
    memory.*.beforeBlocks = longs(allocator, MAX_PLACES)
    memory.*.gpu = false
    memory.*.gpuPlaceCount = 0
    memory.*.gpuPlaceBlocks = longs(allocator, MAX_GPU_PLACES)
    memory.*.gpuPlaceAsked = longs(allocator, MAX_GPU_PLACES)
    memory.*.gpuPlaceSize = longs(allocator, MAX_GPU_PLACES)
    memory.*.gpuPlaceStart = allocator.words(MAX_GPU_PLACES)
    memory.*.gpuPlaceEnd = allocator.words(MAX_GPU_PLACES)
    memory.*.gpuBlockCount = 0
    memory.*.gpuBlockAsked = longs(allocator, MAX_GPU_BLOCKS)
    memory.*.gpuBlockSize = longs(allocator, MAX_GPU_BLOCKS)
    memory.*.gpuBlockType = allocator.words(MAX_GPU_BLOCKS)
    memory.*.gpuBlockKind = allocator.alloc(MAX_GPU_BLOCKS, 16).?
    memory.*.gpuBlockPlace = allocator.words(MAX_GPU_BLOCKS)
}

fn longs(allocator: Allocator, count: usize) -> [*]u64 {
    unsafe { return @ptrCast([*]u64, allocator.alloc(count * 8 + 8, 16).?) }
}

pub fn nameOf(memory: *Memory, which: usize) -> []const u8 {
    return memory.*.names[@intCast(usize, memory.*.nameStart[which])..@intCast(usize, memory.*.nameEnd[which])]
}

// The functions of place `place` (TAB-separated, innermost first).
pub fn placeFunctions(memory: *Memory, place: usize) -> []const u8 {
    return memory.*.text[@intCast(usize, memory.*.placeStart[place])..@intCast(usize, memory.*.placeEnd[place])]
}

// The first function of a place (where its blocks were asked for).
pub fn placeFunction(memory: *Memory, place: usize) -> []const u8 {
    const functions = placeFunctions(memory, place)
    var end: usize = 0
    while end < functions.length && functions[end] != 9 { end += 1 }
    return functions[0..end]
}

// The declaration of a place's first function in `index`, or NONE.
pub fn placeDeclaration(memory: *Memory, index: *Index, place: usize) -> u32 {
    const function = placeFunction(memory, place)
    if function.length == 0 { return NONE }
    return crashes_module.declarationOf(index, function)
}

pub fn gpuPlaceDeclaration(memory: *Memory, index: *Index, place: usize) -> u32 {
    const function = gpuPlaceFunction(memory, place)
    if function.length == 0 { return NONE }
    return crashes_module.declarationOf(index, function)
}

fn variable(environment: [*][*]const u8, name: []const u8) -> []const u8 {
    var entry: usize = 0
    while @intFromPtr(environment[entry]) != 0 {
        const text = environment[entry]
        var matches = true
        var length: usize = 0
        for byte in name {
            if matches && text[length] != byte { matches = false }
            if matches { length += 1 }
        }
        if matches && text[length] == 61 {
            var end = length + 1
            while text[end] != 0 { end += 1 }
            return text[length + 1..end]
        }
        entry += 1
    }
    return ""
}

pub fn append(into: [*]u8, length: usize, text: []const u8) -> usize {
    var at = length
    for byte in text {
        if at < 4000 {
            into[at] = byte
            at += 1
        }
    }
    return at
}

// The directory: $XDG_RUNTIME_DIR/mlx/memory, else the state directory's
// (as std.diagnostics picks it).
pub fn directory(environment: [*][*]const u8, into: [*]u8) -> usize {
    return directoryOf(environment, into, "memory")
}

// $XDG_RUNTIME_DIR/mlx/SUBDIRECTORY, else the state directory's; the frame
// timelines' (frames.mlx) too.
pub fn directoryOf(environment: [*][*]const u8, into: [*]u8, subdirectory: []const u8) -> usize {
    var length: usize = 0
    const runtime = variable(environment, "XDG_RUNTIME_DIR")
    if runtime.length > 0 && runtime[0] == 47 {
        length = append(into, 0, runtime)
        length = append(into, length, "/mlx/")
        length = append(into, length, subdirectory)
    } else {
        const state = variable(environment, "XDG_STATE_HOME")
        if state.length > 0 && state[0] == 47 {
            length = append(into, 0, state)
        } else {
            const home = variable(environment, "HOME")
            if home.length == 0 { return 0 }
            length = append(into, 0, home)
            length = append(into, length, "/.local/state")
        }
        length = append(into, length, "/mlx/")
        length = append(into, length, subdirectory)
    }
    into[length] = 0
    return length
}

pub fn parseNumber(text: []const u8, at: *usize) -> u64 {
    var value: u64 = 0
    while at.* < text.length && text[at.*] >= 48 && text[at.*] <= 57 {
        value = value * 10 + @intCast(u64, text[at.*] - 48)
        at.* += 1
    }
    return value
}

fn parseHex(text: []const u8, at: *usize) -> u64 {
    var value: u64 = 0
    while at.* < text.length {
        const byte = text[at.*]
        var digit: u64 = 16
        if byte >= 48 && byte <= 57 { digit = @intCast(u64, byte - 48) }
        if byte >= 97 && byte <= 102 { digit = @intCast(u64, byte - 87) }
        if digit == 16 { break }
        value = value * 16 + digit
        at.* += 1
    }
    return value
}

// Finds the snapshots (NAME-PID.memory): the newest of each program first
// is not sorted for; the caller ranks them.
pub fn list(memory: *Memory, environment: [*][*]const u8) -> void {
    memory.*.count = 0
    memory.*.namesUsed = 0
    memory.*.directoryLength = directory(environment, memory.*.directory)
    if memory.*.directoryLength == 0 { return }
    var context: *anyopaque = undefined
    unsafe { context = @ptrCast(*anyopaque, memory) }
    eachStem(memory.*.directory, ".memory", addStem, context)
}

// For each file in `directory` (zero-terminated) ending in `extension`:
// `each` with its name without it.
pub const StemFn = fn(context: *anyopaque, stem: []const u8) -> void

pub fn eachStem(directory_path: [*]const u8, extension: []const u8, each: StemFn, context: *anyopaque) -> void {
    const handle = std.linux.syscall3(2, @intFromPtr(directory_path), 65536, 0)
    if handle < 0 { return }
    var entries: [8192]u8 = undefined
    const entry_bytes: [*]u8 = &entries
    while true {
        const got = std.linux.syscall3(217, @bitCast(usize, handle), @intFromPtr(entry_bytes), 8192)
        if got <= 0 { break }
        var at: usize = 0
        while at < @bitCast(usize, got) {
            const record_length = @intCast(usize, entry_bytes[at + 16]) | (@intCast(usize, entry_bytes[at + 17]) << 8)
            var name_end = at + 19
            while entry_bytes[name_end] != 0 { name_end += 1 }
            const name = entry_bytes[at + 19..name_end]
            if name.length > extension.length && index_module.sameBytes(name[name.length - extension.length..name.length], extension) { each(context, name[0..name.length - extension.length]) }
            at += record_length
        }
    }
    const closed = std.linux.syscall1(3, @bitCast(usize, handle))
}

// NAME-PID: the pid (0: not such a name), and where the name ends.
pub fn splitStem(stem: []const u8, name_end: *usize) -> u64 {
    var dash = stem.length
    while dash > 0 && stem[dash - 1] != 45 { dash -= 1 }
    if dash < 2 { return 0 }
    var at = dash
    const pid = parseNumber(stem, &at)
    if at != stem.length { return 0 }
    name_end.* = dash - 1
    return pid
}

// Whether process `pid` runs (its /proc entry is there).
pub fn runs(pid: u64) -> bool {
    var path: [32]u8 = undefined
    const path_bytes: [*]u8 = &path
    var length = append(path_bytes, 0, "/proc/")
    length = appendNumber(path_bytes, length, pid)
    path_bytes[length] = 0
    var status: [144]u8 = undefined
    return std.linux.syscall2(4, @intFromPtr(path_bytes), @intFromPtr(&status)) == 0
}

fn addStem(context: *anyopaque, stem: []const u8) -> void {
    var memory: *Memory = undefined
    unsafe { memory = @ptrCast(*Memory, context) }
    addSnapshot(memory, stem)
}

fn addSnapshot(memory: *Memory, stem: []const u8) -> void {
    if memory.*.count >= MAX_SNAPSHOTS || memory.*.namesUsed + stem.length > MAX_SNAPSHOTS * 128 { return }
    var name_end: usize = 0
    const pid = splitStem(stem, &name_end)
    if pid == 0 { return }
    const which = memory.*.count
    memory.*.nameStart[which] = @intCast(u32, memory.*.namesUsed)
    for byte in stem[0..name_end] {
        memory.*.names[memory.*.namesUsed] = byte
        memory.*.namesUsed += 1
    }
    memory.*.nameEnd[which] = @intCast(u32, memory.*.namesUsed)
    memory.*.pid[which] = pid
    memory.*.running[which] = runs(pid)
    memory.*.time[which] = 0
    memory.*.count += 1
    // The time: the header's, read when loaded; the file's age stands in.
    memory.*.time[which] = headerTime(memory, which)
}

pub fn appendNumber(into: [*]u8, at: usize, value: u64) -> usize {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest /= 10
        count += 1
    }
    var length = at
    while count > 0 {
        count -= 1
        into[length] = digits[count]
        length += 1
    }
    return length
}

// The path of snapshot `which` into `into` (4096 bytes); its length.
fn pathOf(memory: *Memory, which: usize, into: [*]u8) -> usize {
    var length: usize = 0
    while length < memory.*.directoryLength {
        into[length] = memory.*.directory[length]
        length += 1
    }
    length = append(into, length, "/")
    length = append(into, length, nameOf(memory, which))
    length = append(into, length, "-")
    length = appendNumber(into, length, memory.*.pid[which])
    length = append(into, length, ".memory")
    into[length] = 0
    return length
}

fn headerTime(memory: *Memory, which: usize) -> u64 {
    var path: [4096]u8 = undefined
    const path_bytes: [*]u8 = &path
    const length = pathOf(memory, which, path_bytes)
    const file = std.fs.open(path_bytes, 0, 0)
    if !std.fs.isValid(file) { return 0 }
    var head: [256]u8 = undefined
    const head_bytes: [*]u8 = &head
    const got = std.fs.read(file, head_bytes, 256)
    const closed = std.fs.close(file)
    if got <= 0 { return 0 }
    const text = head_bytes[0..@intCast(usize, got)]
    // memory, program, pid, then the time.
    var field: usize = 0
    var at: usize = 0
    while at < text.length && field < 3 {
        if text[at] == 9 { field += 1 }
        at += 1
    }
    return parseNumber(text, &at)
}

// The newest snapshot of the program `name` (the count: none).
pub fn newestOf(memory: *Memory, name: []const u8) -> usize {
    var best = memory.*.count
    var which: usize = 0
    while which < memory.*.count {
        if index_module.sameBytes(nameOf(memory, which), name) && (best == memory.*.count || memory.*.time[which] > memory.*.time[best]) { best = which }
        which += 1
    }
    return best
}

// Reads snapshot `which` and works out what it comes to; false when it
// cannot be read.
pub fn load(memory: *Memory, which: usize) -> bool {
    if which >= memory.*.count { return false }
    var path: [4096]u8 = undefined
    const path_bytes: [*]u8 = &path
    const path_length = pathOf(memory, which, path_bytes)
    const file = std.fs.open(path_bytes, 0, 0)
    if !std.fs.isValid(file) { return false }
    var length: usize = 0
    while length + 65536 <= MAX_TEXT {
        const chunk: [*]u8 = memory.*.text + length
        const got = std.fs.read(file, chunk, 65536)
        if got <= 0 { break }
        length += @intCast(usize, got)
    }
    const closed = std.fs.close(file)
    memory.*.loaded = which
    memory.*.textLength = length
    parse(memory)
    analyze(memory)
    analyzeGpu(memory)
    // Another process: what it holds now is what later reads grow from.
    if memory.*.pid[which] != memory.*.beforePid {
        rememberPlaces(memory, memory.*.pid[which])
    } else {
        growth(memory)
    }
    return true
}

fn parse(memory: *Memory) -> void {
    const text = memory.*.text[0..memory.*.textLength]
    memory.*.placeCount = 0
    memory.*.blockCount = 0
    memory.*.mapCount = 0
    memory.*.tinyPages = 0
    memory.*.tinyBlocks = 0
    memory.*.tinyBytes = 0
    memory.*.tinyEmpty = 0
    memory.*.gpu = false
    memory.*.gpuHeapCount = 0
    memory.*.gpuTypeCount = 0
    memory.*.gpuPlaceCount = 0
    memory.*.gpuBlockCount = 0
    var start: usize = 0
    while start < text.length {
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[start..end]
        if line.length > 4 && index_module.sameBytes(line[0..3], "gpu") && (line[3] == 9 || line[3] == 45) {
            parseGpu(memory, line, start, end)
        } else if line.length > 7 && index_module.sameBytes(line[0..7], "memory\t") {
            parseHeader(memory, line)
        } else if line.length > 5 && index_module.sameBytes(line[0..5], "tiny\t") {
            var at: usize = 5
            memory.*.tinyPages = parseNumber(line, &at)
            at += 1
            memory.*.tinyBlocks = parseNumber(line, &at)
            at += 1
            memory.*.tinyBytes = parseNumber(line, &at)
            at += 1
            memory.*.tinyEmpty = parseNumber(line, &at)
        } else if line.length > 6 && index_module.sameBytes(line[0..6], "place\t") && memory.*.placeCount < MAX_PLACES {
            var at: usize = 6
            const place = @intCast(usize, parseNumber(line, &at))
            if place == memory.*.placeCount {
                at += 1
                memory.*.placeBlocks[place] = parseNumber(line, &at)
                at += 1
                memory.*.placeBytes[place] = parseNumber(line, &at)
                at += 1
                memory.*.placeMapped[place] = parseNumber(line, &at)
                at += 1
                memory.*.placeFresh[place] = parseNumber(line, &at)
                at += 1
                memory.*.placeKept[place] = parseNumber(line, &at)
                at += 1
                const functions = if at < line.length { at } else { line.length }
                memory.*.placeStart[place] = @intCast(u32, start + functions)
                memory.*.placeEnd[place] = @intCast(u32, end)
                memory.*.placeGrowth[place] = 0
                memory.*.placeCount += 1
            }
        } else if line.length > 6 && index_module.sameBytes(line[0..6], "block\t") && memory.*.blockCount < MAX_BLOCKS {
            var at: usize = 6
            const block = memory.*.blockCount
            memory.*.blockAddress[block] = parseHex(line, &at)
            at += 1
            memory.*.blockLength[block] = parseNumber(line, &at)
            at += 1
            memory.*.blockPlace[block] = @intCast(u32, parseNumber(line, &at) & 4294967295)
            at += 1
            memory.*.blockFlag[block] = @intCast(u8, parseNumber(line, &at) & 255)
            at += 1
            memory.*.blockMapped[block] = if at < line.length { parseNumber(line, &at) } else { wholePages(memory.*.blockLength[block]) }
            memory.*.blockCount += 1
        } else if line.length > 4 && index_module.sameBytes(line[0..4], "map\t") && memory.*.mapCount < MAX_MAPS {
            var at: usize = 4
            const map = memory.*.mapCount
            memory.*.mapStart[map] = parseHex(line, &at)
            at += 1
            memory.*.mapEnd[map] = parseHex(line, &at)
            memory.*.mapCount += 1
        }
        start = end + 1
    }
}

// The GPU's lines (see std/src/leaks.mlx): gpu, gpu-heap, gpu-type,
// gpu-place, gpu-block; `start` and `end` are the line's in the text.
fn parseGpu(memory: *Memory, line: []const u8, start: usize, end: usize) -> void {
    if line[3] == 9 {
        // gpu, the device's name, then the numbers.
        var at: usize = 4
        while at < line.length && line[at] != 9 { at += 1 }
        memory.*.gpu = true
        memory.*.gpuNameStart = @intCast(u32, start + 4)
        memory.*.gpuNameEnd = @intCast(u32, start + at)
        at += 1
        memory.*.gpuLimit = parseNumber(line, &at)
        at += 1
        memory.*.gpuLive = parseNumber(line, &at)
        at += 1
        memory.*.gpuAllocations = parseNumber(line, &at)
        at += 1
        memory.*.gpuFrees = parseNumber(line, &at)
        return
    }
    if line.length > 9 && index_module.sameBytes(line[0..9], "gpu-heap\t") {
        var at: usize = 9
        const heap = @intCast(usize, parseNumber(line, &at))
        if heap != memory.*.gpuHeapCount || heap >= GPU_HEAPS { return }
        at += 1
        memory.*.gpuHeapSize[heap] = parseNumber(line, &at)
        at += 1
        memory.*.gpuHeapFlags[heap] = parseNumber(line, &at)
        memory.*.gpuHeapCount += 1
    } else if line.length > 9 && index_module.sameBytes(line[0..9], "gpu-type\t") {
        var at: usize = 9
        const kind = @intCast(usize, parseNumber(line, &at))
        if kind != memory.*.gpuTypeCount || kind >= GPU_TYPES { return }
        at += 1
        memory.*.gpuTypeHeap[kind] = parseNumber(line, &at)
        at += 1
        memory.*.gpuTypeFlags[kind] = parseNumber(line, &at)
        memory.*.gpuTypeCount += 1
    } else if line.length > 10 && index_module.sameBytes(line[0..10], "gpu-place\t") {
        var at: usize = 10
        const place = @intCast(usize, parseNumber(line, &at))
        if place != memory.*.gpuPlaceCount || place >= MAX_GPU_PLACES { return }
        at += 1
        memory.*.gpuPlaceBlocks[place] = parseNumber(line, &at)
        at += 1
        memory.*.gpuPlaceAsked[place] = parseNumber(line, &at)
        at += 1
        memory.*.gpuPlaceSize[place] = parseNumber(line, &at)
        at += 1
        const functions = if at < line.length { at } else { line.length }
        memory.*.gpuPlaceStart[place] = @intCast(u32, start + functions)
        memory.*.gpuPlaceEnd[place] = @intCast(u32, end)
        memory.*.gpuPlaceCount += 1
    } else if line.length > 10 && index_module.sameBytes(line[0..10], "gpu-block\t") && memory.*.gpuBlockCount < MAX_GPU_BLOCKS {
        var at: usize = 10
        const block = memory.*.gpuBlockCount
        const handle = parseHex(line, &at)
        at += 1
        memory.*.gpuBlockAsked[block] = parseNumber(line, &at)
        at += 1
        memory.*.gpuBlockSize[block] = parseNumber(line, &at)
        at += 1
        memory.*.gpuBlockType[block] = @intCast(u32, parseNumber(line, &at) & 4294967295)
        at += 1
        memory.*.gpuBlockKind[block] = @intCast(u8, parseNumber(line, &at) & 255)
        at += 1
        memory.*.gpuBlockPlace[block] = @intCast(u32, parseNumber(line, &at) & 4294967295)
        memory.*.gpuBlockCount += 1
    }
}

pub fn gpuName(memory: *const Memory) -> []const u8 {
    if !memory.*.gpu { return "" }
    return memory.*.text[@intCast(usize, memory.*.gpuNameStart)..@intCast(usize, memory.*.gpuNameEnd)]
}

pub fn gpuPlaceFunctions(memory: *Memory, place: usize) -> []const u8 {
    return memory.*.text[@intCast(usize, memory.*.gpuPlaceStart[place])..@intCast(usize, memory.*.gpuPlaceEnd[place])]
}

// The first function of a GPU place (the one that asked).
pub fn gpuPlaceFunction(memory: *Memory, place: usize) -> []const u8 {
    const functions = gpuPlaceFunctions(memory, place)
    var end: usize = 0
    while end < functions.length && functions[end] != 9 { end += 1 }
    return functions[0..end]
}

pub fn gpuClassOf(size: u64) -> usize {
    if size < 65536 { return 0 }
    if size < 1048576 { return 1 }
    if size < 16777216 { return 2 }
    return 3
}

// What the device took beyond what was asked.
pub fn gpuWasted(memory: *const Memory) -> u64 {
    return if memory.*.gpuSize > memory.*.gpuAsked { memory.*.gpuSize - memory.*.gpuAsked } else { 0 }
}

// The GPU's blocks by heap and size class.
fn analyzeGpu(memory: *Memory) -> void {
    var heap: usize = 0
    while heap < GPU_HEAPS {
        memory.*.gpuHeapUsed[heap] = 0
        memory.*.gpuHeapBlocks[heap] = 0
        heap += 1
    }
    var class: usize = 0
    while class < GPU_CLASSES {
        memory.*.gpuClassBlocks[class] = 0
        memory.*.gpuClassAsked[class] = 0
        memory.*.gpuClassSize[class] = 0
        class += 1
    }
    memory.*.gpuAsked = 0
    memory.*.gpuSize = 0
    var block: usize = 0
    while block < memory.*.gpuBlockCount {
        const size = memory.*.gpuBlockSize[block]
        const kind = @intCast(usize, memory.*.gpuBlockType[block])
        if kind < memory.*.gpuTypeCount {
            const on = @intCast(usize, memory.*.gpuTypeHeap[kind])
            if on < GPU_HEAPS {
                memory.*.gpuHeapUsed[on] += size
                memory.*.gpuHeapBlocks[on] += 1
            }
        }
        const at = gpuClassOf(size)
        memory.*.gpuClassBlocks[at] += 1
        memory.*.gpuClassAsked[at] += memory.*.gpuBlockAsked[block]
        memory.*.gpuClassSize[at] += size
        memory.*.gpuAsked += memory.*.gpuBlockAsked[block]
        memory.*.gpuSize += size
        block += 1
    }
}

fn parseHeader(memory: *Memory, line: []const u8) -> void {
    // memory, program, pid, then the numbers.
    var field: usize = 0
    var at: usize = 0
    while at < line.length && field < 3 {
        if line[at] == 9 { field += 1 }
        at += 1
    }
    var numbers: [9]u64 = [9]u64{ 0, 0, 0, 0, 0, 0, 0, 0, 0 }
    var number: usize = 0
    while number < 9 && at <= line.length {
        numbers[number] = parseNumber(line, &at)
        at += 1
        number += 1
    }
    memory.*.seconds = numbers[0]
    memory.*.allocations = numbers[1]
    memory.*.frees = numbers[2]
    memory.*.blocks = numbers[3]
    memory.*.bytes = numbers[4]
    memory.*.mapped = numbers[5]
    memory.*.peak = numbers[6]
    memory.*.values = numbers[7]
    memory.*.resident = numbers[8]
}

pub fn classOf(length: u64) -> usize {
    if length < 256 { return 0 }
    if length < 4096 { return 1 }
    if length < 65536 { return 2 }
    if length < 1048576 { return 3 }
    return 4
}

fn wholePages(length: u64) -> u64 { return (length + PAGE - 1) / PAGE * PAGE }

// A block on the tiny pages: in the region every process keeps for them at
// one address (std.tinypage_allocator), far from where the kernel puts
// mappings; what lies between there and the other blocks is no hole.
pub fn tinyBlock(memory: *const Memory, block: usize) -> bool {
    const address = memory.*.blockAddress[block]
    return address >= @intCast(u64, std.tinypage_allocator.DATA) && address < @intCast(u64, std.tinypage_allocator.END)
}

// The size classes, and the holes between the mappings where the blocks
// of whole pages lie (from the lowest such block to the end of the
// highest; the tiny pages have their line).
fn analyze(memory: *Memory) -> void {
    var class: usize = 0
    while class < CLASSES {
        memory.*.classBlocks[class] = 0
        memory.*.classBytes[class] = 0
        memory.*.classMapped[class] = 0
        class += 1
    }
    var low: u64 = 18446744073709551615
    var high: u64 = 0
    var block: usize = 0
    while block < memory.*.blockCount {
        const length = memory.*.blockLength[block]
        const at = classOf(length)
        memory.*.classBlocks[at] += 1
        memory.*.classBytes[at] += length
        memory.*.classMapped[at] += memory.*.blockMapped[block]
        const address = memory.*.blockAddress[block]
        if !tinyBlock(memory, block) {
            if address < low { low = address }
            if address + memory.*.blockMapped[block] > high { high = address + memory.*.blockMapped[block] }
        }
        block += 1
    }
    memory.*.holes = 0
    memory.*.holeBytes = 0
    memory.*.largestHole = 0
    if high == 0 { return }
    var map: usize = 1
    while map < memory.*.mapCount {
        const gap_start = memory.*.mapEnd[map - 1]
        const gap_end = memory.*.mapStart[map]
        if gap_end > gap_start && gap_start >= low && gap_end <= high {
            const hole = gap_end - gap_start
            memory.*.holes += 1
            memory.*.holeBytes += hole
            if hole > memory.*.largestHole { memory.*.largestHole = hole }
        }
        map += 1
    }
}

// The fragmentation of the address space between the blocks, in
// thousandths: 0 one hole (or none), near 1000 many small ones.
pub fn fragmentation(memory: *const Memory) -> u64 {
    if memory.*.holeBytes == 0 { return 0 }
    return 1000 - memory.*.largestHole * 1000 / memory.*.holeBytes
}

// What the pages waste: mapped - asked, of all blocks.
pub fn wasted(memory: *const Memory) -> u64 {
    return if memory.*.mapped > memory.*.bytes { memory.*.mapped - memory.*.bytes } else { 0 }
}

fn placeHash(memory: *Memory, place: usize) -> u64 {
    var value: u64 = 1469598103934665603
    for byte in placeFunctions(memory, place) { value = (value ^ @intCast(u64, byte)) *% 1099511628211 }
    return value
}

fn rememberPlaces(memory: *Memory, pid: u64) -> void {
    memory.*.beforePid = pid
    memory.*.beforeTime = memory.*.seconds
    memory.*.beforeCount = memory.*.placeCount
    var place: usize = 0
    while place < memory.*.placeCount {
        memory.*.beforeHash[place] = placeHash(memory, place)
        memory.*.beforeBlocks[place] = memory.*.placeBlocks[place]
        place += 1
    }
}

// The places holding more blocks than when the process was first read.
fn growth(memory: *Memory) -> void {
    if memory.*.beforeTime >= memory.*.seconds { return }
    var place: usize = 0
    while place < memory.*.placeCount {
        const hash = placeHash(memory, place)
        var before: u64 = 0
        var at: usize = 0
        while at < memory.*.beforeCount {
            if memory.*.beforeHash[at] == hash { before += memory.*.beforeBlocks[at] }
            at += 1
        }
        memory.*.placeGrowth[place] = if memory.*.placeBlocks[place] > before { memory.*.placeBlocks[place] - before } else { 0 }
        place += 1
    }
}

// The places by what they hold in pages, most first, into `order` (at
// most `capacity`); how many.
pub fn ranked(memory: *Memory, order: [*]u32, capacity: usize) -> usize {
    var count: usize = 0
    var place: usize = 0
    while place < memory.*.placeCount && count < capacity {
        var at = count
        while at > 0 && memory.*.placeMapped[@intCast(usize, order[at - 1])] < memory.*.placeMapped[place] {
            order[at] = order[at - 1]
            at -= 1
        }
        order[at] = @intCast(u32, place)
        count += 1
        place += 1
    }
    return count
}
