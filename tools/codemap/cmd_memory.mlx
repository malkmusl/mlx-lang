// mlx-codemap memory: the programs' memory as std.leaks writes it while
// they run with MLX_LEAK_CHECK (tools/codemap/memory.mlx): without a
// program the snapshots there, one line each; with one its newest, what
// it holds and wastes, how its blocks lie, and the places most memory came
// from (part of main.mlx, split from it).
const std = @import("std")
const index_module = @import("./index.mlx")
const memory_module = @import("./memory.mlx")
const app = @import("./main.mlx")

fn sayBytes(context: *app.Context, bytes: u64) -> void {
    if bytes >= 10485760 {
        app.sayNumber(context, @intCast(usize, bytes / 1048576))
        app.say(context, " MiB")
    } else if bytes >= 10240 {
        app.sayNumber(context, @intCast(usize, bytes / 1024))
        app.say(context, " KiB")
    } else {
        app.sayNumber(context, @intCast(usize, bytes))
        app.say(context, " B")
    }
}

fn sayShare(context: *app.Context, part: u64, whole: u64) -> void {
    app.sayNumber(context, @intCast(usize, if whole > 0 { part * 100 / whole } else { 0 }))
    app.say(context, "%")
}

// One line about the snapshot loaded.
fn sayHeadline(context: *app.Context, memory: *memory_module.Memory) -> void {
    const which = memory.*.loaded
    app.say(context, memory_module.nameOf(memory, which))
    app.say(context, " (pid ")
    app.sayNumber(context, @intCast(usize, memory.*.pid[which]))
    app.say(context, if memory.*.running[which] { ", running): " } else { ", ended): " })
    app.sayNumber(context, @intCast(usize, memory.*.blocks))
    app.say(context, " blocks, ")
    sayBytes(context, memory.*.bytes)
    app.say(context, " asked, ")
    sayBytes(context, memory.*.mapped)
    app.say(context, " in pages (")
    sayShare(context, memory_module.wasted(memory), memory.*.mapped)
    app.say(context, " wasted), values ")
    sayBytes(context, memory.*.values)
    app.say(context, ", resident ")
    sayBytes(context, memory.*.resident * 1024)
    app.newline(context)
}

pub fn command(context: *app.Context, environment: [*][*]const u8, program: []const u8) -> void {
    const allocator = std.page_allocator.init()
    var memory: memory_module.Memory = undefined
    memory_module.init(&memory, allocator)
    memory_module.list(&memory, environment)
    if memory.count == 0 {
        app.say(context, "no memory snapshots (run a program with MLX_LEAK_CHECK=1)")
        app.newline(context)
        return
    }
    if program.length == 0 {
        var which: usize = 0
        while which < memory.count {
            if memory_module.load(&memory, which) { sayHeadline(context, &memory) }
            which += 1
        }
        return
    }
    const which = memory_module.newestOf(&memory, program)
    if which >= memory.count || !memory_module.load(&memory, which) {
        app.say(context, "no memory snapshot of ")
        app.say(context, program)
        app.newline(context)
        return
    }
    sayHeadline(context, &memory)
    // The size classes: where the pages go to waste.
    const labels: [5][]const u8 = [5][]const u8{ "below 256 B", "below 4 KiB", "below 64 KiB", "below 1 MiB", "1 MiB and more" }
    var class: usize = 0
    while class < memory_module.CLASSES {
        if memory.classBlocks[class] > 0 {
            app.say(context, "  ")
            app.say(context, labels[class])
            app.say(context, ": ")
            app.sayNumber(context, @intCast(usize, memory.classBlocks[class]))
            app.say(context, " blocks, ")
            sayBytes(context, memory.classBytes[class])
            app.say(context, " in ")
            sayBytes(context, memory.classMapped[class])
            app.say(context, " of pages (")
            sayShare(context, memory.classMapped[class] - memory.classBytes[class], memory.classMapped[class])
            app.say(context, " wasted)")
            app.newline(context)
        }
        class += 1
    }
    app.say(context, "  address space: ")
    app.sayNumber(context, memory.mapCount)
    app.say(context, " mappings; between the blocks ")
    app.sayNumber(context, @intCast(usize, memory.holes))
    app.say(context, " holes, ")
    sayBytes(context, memory.holeBytes)
    app.say(context, ", the largest ")
    sayBytes(context, memory.largestHole)
    app.say(context, " (fragmentation 0.")
    const fragmentation = memory_module.fragmentation(&memory)
    if fragmentation < 100 { app.say(context, "0") }
    if fragmentation < 10 { app.say(context, "0") }
    app.sayNumber(context, @intCast(usize, fragmentation))
    app.say(context, ")")
    app.newline(context)
    // The places, most memory first.
    var order: [40]u32 = undefined
    var order_bytes: [*]u32 = undefined
    unsafe { order_bytes = @ptrCast([*]u32, &order) }
    const count = memory_module.ranked(&memory, order_bytes, 40)
    app.say(context, "  places, most memory first:")
    app.newline(context)
    var at: usize = 0
    while at < count && at < 20 {
        const place = @intCast(usize, order[at])
        app.say(context, "    ")
        sayBytes(context, memory.placeMapped[place])
        app.say(context, " in ")
        app.sayNumber(context, @intCast(usize, memory.placeBlocks[place]))
        app.say(context, if memory.placeBlocks[place] == 1 { " block " } else { " blocks " })
        const declaration = memory_module.placeDeclaration(&memory, context.*.index, place)
        if declaration != index_module.NONE {
            app.sayDeclaration(context, declaration)
        } else {
            app.say(context, memory_module.placeFunction(&memory, place))
        }
        if memory.placeFresh[place] > 0 {
            app.say(context, " (")
            app.sayNumber(context, @intCast(usize, memory.placeFresh[place]))
            app.say(context, " since the mark)")
        }
        if memory.placeKept[place] > 0 { app.say(context, " (kept)") }
        if memory.placeGrowth[place] > 0 {
            app.say(context, " (growing: ")
            app.sayNumber(context, @intCast(usize, memory.placeGrowth[place]))
            app.say(context, " more)")
        }
        app.newline(context)
        at += 1
    }
}
