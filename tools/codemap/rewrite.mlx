// Rewriting workarounds away, once the compiler can do without them
// (tools/codemap/workarounds.mlx finds them):
//
//   - dropped: `const ignored = call(...)` (a local nothing reads) becomes
//     `_ = call(...)`;
//   - counted: `for byte in text { length += 1 }` becomes
//     `length += text.length`;
//   - unsafe: `var NAME: T = undefined` with `unsafe { NAME = VALUE }` on
//     the next line becomes `const NAME: T = unsafe { VALUE }` (`var` when
//     T is no pointer, or the rest of the block assigns NAME or takes its
//     address).
//
// Pointer offsets (p + n) and *[N]T to [*]T are in the compiler now; the
// places left of those kinds are the ones that do not type that way (a
// struct read as bytes), so they are not rewritten here. Float constants
// and math written out went to std.math and @floor, @ceil, @trunc by
// hand; unsafe expressions still wait for the compiler. Files under
// compiler/ and std/bootstrap/ are left as they are: the bootstrap
// compiler (zig build mlx1) builds them and knows neither. So are the
// ones under tests/ (what they check is how they are written).
//
//     var edits: rewrite_module.Edits = undefined
//     rewrite_module.init(&edits, allocator)
//     rewrite_module.plan(&edits, workarounds, index, pattern, prefix)
//     rewrite_module.apply(&edits, index)
const std = @import("std")
const index_module = @import("./index.mlx")
const workarounds_module = @import("./workarounds.mlx")
const programs_module = @import("./programs.mlx")
const git_module = @import("./git.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

pub const MAX_EDITS: usize = 65536
const TEXT_SIZE: usize = 4194304

pub const Edits = struct {
    allocator: Allocator
    count: usize
    // Each edit: its file, the bytes it replaces, the text instead (in
    // text).
    file: [*]u32
    start: [*]u32
    end: [*]u32
    textStart: [*]u32
    textEnd: [*]u32
    text: [*]u8
    textUsed: usize
}

pub fn init(edits: *Edits, allocator: Allocator) -> void {
    edits.*.allocator = allocator
    edits.*.count = 0
    edits.*.file = allocator.words(MAX_EDITS)
    edits.*.start = allocator.words(MAX_EDITS)
    edits.*.end = allocator.words(MAX_EDITS)
    edits.*.textStart = allocator.words(MAX_EDITS)
    edits.*.textEnd = allocator.words(MAX_EDITS)
    edits.*.text = allocator.alloc(TEXT_SIZE, 16).?
    edits.*.textUsed = 0
}

// Whether the pattern can be rewritten (by this tool; the compiler must
// accept the result too).
pub fn rewritable(pattern: u8) -> bool {
    return pattern == workarounds_module.DROPPED || pattern == workarounds_module.COUNTED || pattern == workarounds_module.UNSAFE_SET
}

// The pattern a word names (dropped, counted, ...); 255: none.
pub fn patternNamed(word: []const u8) -> u8 {
    if index_module.sameBytes(word, "dropped") { return workarounds_module.DROPPED }
    if index_module.sameBytes(word, "counted") { return workarounds_module.COUNTED }
    if index_module.sameBytes(word, "pointers") { return workarounds_module.POINTER_MATH }
    if index_module.sameBytes(word, "casts") { return workarounds_module.ARRAY_CAST }
    if index_module.sameBytes(word, "unsafe") { return workarounds_module.UNSAFE_SET }
    if index_module.sameBytes(word, "arena") { return workarounds_module.ARENA }
    if index_module.sameBytes(word, "floats") { return workarounds_module.FLOATS }
    if index_module.sameBytes(word, "math") { return workarounds_module.MATH }
    if index_module.sameBytes(word, "comments") { return workarounds_module.COMMENT }
    return 255
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && index_module.sameBytes(text[0..prefix.length], prefix)
}

// Files the bootstrap compiler builds, and the tests (left as they are).
fn bootstrapped(path: []const u8) -> bool {
    return startsWith(path, "compiler/") || startsWith(path, "std/bootstrap/") || startsWith(path, "tests/")
}

fn addText(edits: *Edits, text: []const u8) -> void {
    for byte in text {
        if edits.*.textUsed < TEXT_SIZE {
            edits.*.text[edits.*.textUsed] = byte
            edits.*.textUsed += 1
        }
    }
}

fn addEdit(edits: *Edits, file: u32, start: usize, end: usize) -> void {
    if edits.*.count >= MAX_EDITS { return }
    const at = edits.*.count
    edits.*.file[at] = file
    edits.*.start[at] = @intCast(u32, start)
    edits.*.end[at] = @intCast(u32, end)
    edits.*.textStart[at] = @intCast(u32, edits.*.textUsed)
    edits.*.count += 1
}

fn closeEdit(edits: *Edits) -> void {
    edits.*.textEnd[edits.*.count - 1] = @intCast(u32, edits.*.textUsed)
}

pub fn replacement(edits: *Edits, edit: usize) -> []const u8 {
    return edits.*.text[edits.*.textStart[edit]..edits.*.textEnd[edit]]
}

// The edits for every place of `pattern` in files under `prefix` (a path
// relative to the root; empty: all).
pub fn plan(edits: *Edits, workarounds: *workarounds_module.Workarounds, index: *Index, pattern: u8, prefix: []const u8) -> void {
    edits.*.count = 0
    edits.*.textUsed = 0
    var place: usize = 0
    while place < workarounds.*.count {
        if workarounds.*.pattern[place] == pattern {
            const file = workarounds.*.file[place]
            const path = programs_module.relativePath(index, file)
            if startsWith(path, prefix) && !bootstrapped(path) {
                const source = index_module.sourceOf(index, file)
                const offset = @intCast(usize, workarounds.*.offset[place])
                if pattern == workarounds_module.DROPPED { planDropped(edits, file, source, offset) }
                if pattern == workarounds_module.COUNTED { planCounted(edits, file, source, offset) }
                if pattern == workarounds_module.UNSAFE_SET { planUnsafe(edits, file, source, offset) }
            }
        }
        place += 1
    }
}

// `const NAME = VALUE` (the name at `offset`; a type may follow it): the
// part up to and with "=" becomes "_ =".
fn planDropped(edits: *Edits, file: u32, source: []const u8, offset: usize) -> void {
    if offset < 6 || !index_module.sameBytes(source[offset - 6..offset], "const ") { return }
    var at = offset
    while at < source.length && source[at] != 10 && source[at] != 61 { at += 1 }
    if at + 1 >= source.length || source[at] != 61 || source[at + 1] != 32 { return }
    addEdit(edits, file, offset - 6, at + 1)
    addText(edits, "_ =")
    closeEdit(edits)
}

// `for X in Y { Z += 1 }` on one line becomes `Z += Y.length`.
fn planCounted(edits: *Edits, file: u32, source: []const u8, offset: usize) -> void {
    var end = offset
    while end < source.length && source[end] != 10 { end += 1 }
    var close = end
    while close > offset && (source[close - 1] == 32 || source[close - 1] == 9) { close -= 1 }
    const line = source[offset..close]
    // The iterable: after " in ", up to " {".
    var in_at: usize = 0
    while in_at + 4 <= line.length && !index_module.sameBytes(line[in_at..in_at + 4], " in ") { in_at += 1 }
    var brace = in_at + 4
    while brace + 2 <= line.length && !index_module.sameBytes(line[brace..brace + 2], " {") { brace += 1 }
    if in_at + 4 > line.length || brace + 2 > line.length { return }
    const iterable = line[in_at + 4..brace]
    // The counter: before " += 1 }".
    if line.length < 8 || !index_module.sameBytes(line[line.length - 7..line.length], " += 1 }") { return }
    var counter_start = brace + 2
    while counter_start < line.length && line[counter_start] == 32 { counter_start += 1 }
    const counter = line[counter_start..line.length - 7]
    if counter.length == 0 || iterable.length == 0 { return }
    var simple = true
    for byte in iterable {
        if byte == 32 { simple = false }
    }
    addEdit(edits, file, offset, close)
    addText(edits, counter)
    addText(edits, " += ")
    if !simple { addText(edits, "(") }
    addText(edits, iterable)
    if !simple { addText(edits, ")") }
    addText(edits, ".length")
    closeEdit(edits)
}

fn isNameByte(byte: u8) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95
}

fn isBlank(byte: u8) -> bool { return byte == 32 || byte == 9 }

// `var NAME: T = undefined` (at `offset`) and `unsafe { NAME = VALUE }` on
// the next line: one declaration with an unsafe expression.
fn planUnsafe(edits: *Edits, file: u32, source: []const u8, offset: usize) -> void {
    const name_start = offset + 4
    var name_end = name_start
    while name_end < source.length && isNameByte(source[name_end]) { name_end += 1 }
    var line_end = name_end
    while line_end < source.length && source[line_end] != 10 { line_end += 1 }
    if line_end < name_end + 12 || !index_module.sameBytes(source[line_end - 12..line_end], " = undefined") { return }
    const head_end = line_end - 12
    const name = source[name_start..name_end]
    // The next line: `unsafe { NAME = VALUE }` and nothing else.
    var statement = line_end + 1
    while statement < source.length && isBlank(source[statement]) { statement += 1 }
    var statement_end = statement
    while statement_end < source.length && source[statement_end] != 10 { statement_end += 1 }
    var close = statement_end
    while close > statement && isBlank(source[close - 1]) { close -= 1 }
    const value_start = statement + 9 + name.length + 3
    if value_start + 2 > close || !startsWith(source[statement..close], "unsafe { ") { return }
    if !index_module.sameBytes(source[statement + 9..statement + 9 + name.length], name) || !index_module.sameBytes(source[statement + 9 + name.length..value_start], " = ") { return }
    if !index_module.sameBytes(source[close - 2..close], " }") { return }
    const value = source[value_start..close - 2]
    // One expression: its braces balance and it opens no block of its own.
    var depth: isize = 0
    for byte in value {
        if byte == 123 { depth += 1 }
        if byte == 125 {
            depth -= 1
            if depth < 0 { return }
        }
    }
    if depth != 0 { return }
    const keyword = if pointerType(source[name_end..head_end]) && !changedLater(source, statement_end, name) { "const" } else { "var" }
    addEdit(edits, file, offset, statement_end)
    addText(edits, keyword)
    addText(edits, source[offset + 3..head_end])
    addText(edits, " = unsafe { ")
    addText(edits, value)
    addText(edits, " }")
    closeEdit(edits)
}

// Whether the declared type (": T" after the name) is a pointer.
fn pointerType(annotation: []const u8) -> bool {
    if annotation.length < 3 || annotation[0] != 58 { return false }
    const type_text = annotation[2..annotation.length]
    return startsWith(type_text, "*") || startsWith(type_text, "[*]") || startsWith(type_text, "?*") || startsWith(type_text, "?[*]")
}

// Whether the rest of the block from `from` assigns `name` or takes its
// address.
fn changedLater(source: []const u8, from: usize, name: []const u8) -> bool {
    var depth: usize = 0
    var at = from
    while at < source.length {
        const byte = source[at]
        if byte == 123 { depth += 1 }
        if byte == 125 {
            if depth == 0 { return false }
            depth -= 1
        }
        if byte == name[0] && at + name.length <= source.length && index_module.sameBytes(source[at..at + name.length], name) && (at == 0 || (!isNameByte(source[at - 1]) && source[at - 1] != 46)) && (at + name.length >= source.length || !isNameByte(source[at + name.length])) {
            var before = at
            while before > 0 && isBlank(source[before - 1]) { before -= 1 }
            if before > 0 && source[before - 1] == 38 { return true }
            var after = at + name.length
            while after < source.length && isBlank(source[after]) { after += 1 }
            if after + 1 < source.length {
                const next = source[after]
                if next == 61 && source[after + 1] != 61 { return true }
                if (next == 43 || next == 45 || next == 42 || next == 47 || next == 37 || next == 124 || next == 38 || next == 94) && source[after + 1] == 61 { return true }
                if (next == 60 || next == 62) && after + 2 < source.length && source[after + 1] == next && source[after + 2] == 61 { return true }
            }
        }
        at += 1
    }
    return false
}

// Writes the edited files; how many.
pub fn apply(edits: *Edits, index: *Index) -> usize {
    var written: usize = 0
    var edit: usize = 0
    while edit < edits.*.count {
        const file = edits.*.file[edit]
        // This file's edits (they come together, in order).
        var last = edit
        while last < edits.*.count && edits.*.file[last] == file { last += 1 }
        if writeFile(edits, index, file, edit, last) { written += 1 }
        edit = last
    }
    return written
}

fn writeFile(edits: *Edits, index: *Index, file: u32, first: usize, last: usize) -> bool {
    const source = index_module.sourceOf(index, file)
    const path = index_module.pathOf(index, file)
    var z: [4096]u8 = undefined
    const bytes: [*]u8 = &z
    if path.length >= 4000 { return false }
    var length: usize = 0
    for byte in path {
        bytes[length] = byte
        length += 1
    }
    bytes[length] = 0
    const handle = std.fs.open(bytes, 577, 420)
    if !std.fs.isValid(handle) { return false }
    var at: usize = 0
    var edit = first
    var ok = true
    while edit < last {
        const start = @intCast(usize, edits.*.start[edit])
        const end = @intCast(usize, edits.*.end[edit])
        if start >= at && end <= source.length {
            ok = ok && writeBytes(handle, source[at..start])
            ok = ok && writeBytes(handle, replacement(edits, edit))
            at = end
        }
        edit += 1
    }
    ok = ok && writeBytes(handle, source[at..source.length])
    _ = std.fs.close(handle)
    return ok
}

fn writeBytes(handle: std.fs.File, text: []const u8) -> bool {
    if text.length == 0 { return true }
    const pointer: [*]const u8 = text.pointer
    return std.fs.writeAllBytes(handle, pointer, text.length)
}

// What a pattern's rewrite needs the compiler to accept: a small program
// with it (empty: nothing new).
fn probeProgram(pattern: u8) -> []const u8 {
    if pattern == workarounds_module.DROPPED { return "fn three() -> usize { return 3 }\npub fn main() -> u8 {\n    _ = three()\n    return 0\n}\n" }
    if pattern == workarounds_module.UNSAFE_SET { return "pub fn main() -> u8 {\n    var x: u64 = 7\n    const p: *u64 = unsafe { @ptrFromInt(*u64, @intFromPtr(&x)) }\n    return @intCast(u8, p.* - 7)\n}\n" }
    return ""
}

// Whether the compiler ($MLX_COMPILER, else ROOT/mlx-out/bin/compiler/mlx4,
// else mlx4 on the PATH) builds (and runs) what the rewrites of `pattern`
// need.
pub fn compilerAccepts(git: *git_module.Git, pattern: u8) -> bool {
    const program = probeProgram(pattern)
    if program.length == 0 { return true }
    git_module.beginShell(git)
    git_module.more(git, "c=${MLX_COMPILER:-")
    git_module.addQuoted(git, git.*.root[0..git.*.rootLength])
    git_module.more(git, "/mlx-out/bin/compiler/mlx4}; [ -x \"$c\" ] || c=mlx4; d=$(mktemp -d) || exit 1; printf '%s' ")
    git_module.addQuoted(git, program)
    git_module.more(git, " > \"$d/probe.mlx\"; \"$c\" --quiet \"$d/probe.mlx\" -o \"$d/probe\" > /dev/null 2>&1 && \"$d/probe\"; s=$?; rm -rf \"$d\"; exit $s")
    _ = git_module.finish(git)
    return git.*.status == 0
}

// How many files the edits touch.
pub fn fileCount(edits: *Edits) -> usize {
    var files: usize = 0
    var edit: usize = 0
    while edit < edits.*.count {
        if edit == 0 || edits.*.file[edit - 1] != edits.*.file[edit] { files += 1 }
        edit += 1
    }
    return files
}

