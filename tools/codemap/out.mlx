// Buffered output to a descriptor (stdout for the CLI, the LSP's pipe):
// text, numbers, JSON strings.
const std = @import("std")

pub const Out = struct {
    descriptor: usize
    bytes: [*]u8
    length: usize
    capacity: usize
}

pub fn create(descriptor: usize, capacity: usize) -> *Out {
    const pages = std.page_allocator.init()
    const memory = pages.alloc(@sizeOf(Out), 16)
    var out: *Out = undefined
    unsafe { out = @ptrCast(*Out, memory.?) }
    out.*.descriptor = descriptor
    out.*.bytes = pages.alloc(capacity, 16).?
    out.*.length = 0
    out.*.capacity = capacity
    return out
}

pub fn flush(out: *Out) -> void {
    var at: usize = 0
    while at < out.*.length {
        const written = std.linux.syscall3(1, out.*.descriptor, @intFromPtr(out.*.bytes) + at, out.*.length - at)
        if written <= 0 { break }
        at += @intCast(usize, written)
    }
    out.*.length = 0
}

pub fn byte(out: *Out, value: u8) -> void {
    if out.*.length >= out.*.capacity { flush(out) }
    out.*.bytes[out.*.length] = value
    out.*.length += 1
}

pub fn text(out: *Out, value: []const u8) -> void {
    for item in value { byte(out, item) }
}

pub fn number(out: *Out, value: usize) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        byte(out, digits[count])
    }
}

pub fn line(out: *Out) -> void { byte(out, 10) }

// A JSON string (quoted, escaped).
pub fn json(out: *Out, value: []const u8) -> void {
    byte(out, 34)
    const digits = "0123456789abcdef"
    for item in value {
        if item == 34 {
            text(out, "\\\"")
        } else if item == 92 {
            text(out, "\\\\")
        } else if item == 10 {
            text(out, "\\n")
        } else if item == 13 {
            text(out, "\\r")
        } else if item == 9 {
            text(out, "\\t")
        } else if item < 32 {
            text(out, "\\u00")
            byte(out, digits[@intCast(usize, item >> 4)])
            byte(out, digits[@intCast(usize, item & 15)])
        } else {
            byte(out, item)
        }
    }
    byte(out, 34)
}
