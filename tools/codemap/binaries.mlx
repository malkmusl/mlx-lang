// The programs as they were built: how much machine code each function
// became. The compiler's symbol table names every function path:line:name
// with its size in bytes; the functions are put on the declarations of the
// index (tools/codemap/crashes.mlx declarationOf), a generic function's
// instances and a function copied into several binaries adding up.
//
// A binary is any ELF file with such names, in the directories searched
// (the programs' own directory, mlx-out/bin under the root and what
// MLX_CODEMAP_BINARIES names, one level of subdirectories each). Its main
// says which program it is.
//
//     var binaries: binaries_module.Binaries = undefined
//     binaries_module.init(&binaries, allocator)
//     binaries_module.scan(&binaries, index, programs, directories)
//     binaries_module.choose(&binaries, program)   // or ALL
//     binaries_module.bytesOf(&binaries, symbol) ...
const std = @import("std")
const index_module = @import("./index.mlx")
const crashes_module = @import("./crashes.mlx")
const programs_module = @import("./programs.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

pub const MAX_BINARIES: usize = 128
pub const MAX_PAIRS: usize = 524288
// choose: every binary (a declaration's biggest).
pub const ALL: usize = 18446744073709551615

pub const Binaries = struct {
    index: *Index
    allocator: Allocator
    count: usize
    // Each binary: its path (in `paths`), its program (NONE-like: the
    // programs' count), its code's size, where its pairs are.
    pathStart: [128]usize
    pathEnd: [128]usize
    program: [128]usize
    total: [128]usize
    pairStart: [128]usize
    pairEnd: [128]usize
    paths: [*]u8
    pathsUsed: usize
    // (symbol, bytes) of every function in every binary.
    pairSymbol: [*]u32
    pairBytes: [*]u32
    pairCount: usize
    // Per symbol: its bytes in what is chosen (sums: scratch); the binary
    // chosen.
    bytes: [*]u32
    sums: [*]u32
    capacity: usize
    chosen: usize
}

pub fn init(binaries: *Binaries, allocator: Allocator) -> void {
    binaries.*.allocator = allocator
    binaries.*.count = 0
    binaries.*.paths = allocator.alloc(MAX_BINARIES * 512, 16).?
    binaries.*.pathsUsed = 0
    binaries.*.pairSymbol = allocator.words(MAX_PAIRS)
    binaries.*.pairBytes = allocator.words(MAX_PAIRS)
    binaries.*.pairCount = 0
    binaries.*.capacity = 0
    binaries.*.chosen = ALL
}

pub fn pathOf(binaries: *Binaries, binary: usize) -> []const u8 {
    return binaries.*.paths[binaries.*.pathStart[binary]..binaries.*.pathEnd[binary]]
}

// The binary built from `program`, or the count.
pub fn binaryOf(binaries: *Binaries, program: usize) -> usize {
    var binary: usize = 0
    while binary < binaries.*.count {
        if binaries.*.program[binary] == program { return binary }
        binary += 1
    }
    return binaries.*.count
}

pub fn bytesOf(binaries: *Binaries, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= binaries.*.capacity { return 0 }
    return binaries.*.bytes[symbol]
}

// Looks for binaries in `directories` (NUL-separated, NUL-terminated
// paths; empty ones skipped).
pub fn scan(binaries: *Binaries, index: *Index, programs: *programs_module.Programs, directories: []const u8) -> void {
    binaries.*.index = index
    binaries.*.count = 0
    binaries.*.pathsUsed = 0
    binaries.*.pairCount = 0
    if index.*.symbolCount > binaries.*.capacity {
        const capacity = index.*.symbolCount + index.*.symbolCount / 2 + 1024
        binaries.*.bytes = binaries.*.allocator.words(capacity)
        binaries.*.sums = binaries.*.allocator.words(capacity)
        binaries.*.capacity = capacity
    }
    var start: usize = 0
    var at: usize = 0
    while at < directories.length {
        if directories[at] == 0 {
            if at > start { scanDirectory(binaries, programs, directories[start..at], 0) }
            start = at + 1
        }
        at += 1
    }
    if start < directories.length { scanDirectory(binaries, programs, directories[start..directories.length], 0) }
    choose(binaries, binaries.*.chosen)
}

fn scanDirectory(binaries: *Binaries, programs: *programs_module.Programs, directory: []const u8, depth: usize) -> void {
    if directory.length > 3000 { return }
    var path: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    var length: usize = 0
    for byte in directory {
        bytes[length] = byte
        length += 1
    }
    bytes[length] = 0
    const handle = std.linux.syscall3(2, @intFromPtr(bytes), 65536, 0)
    if handle < 0 { return }
    var entries: [8192]u8 = undefined
    var entry_bytes: [*]u8 = undefined
    unsafe { entry_bytes = @ptrCast([*]u8, &entries) }
    while true {
        const got = std.linux.syscall3(217, @bitCast(usize, handle), @intFromPtr(entry_bytes), 8192)
        if got <= 0 { break }
        var at: usize = 0
        while at < @bitCast(usize, got) {
            const record_length = @intCast(usize, entry_bytes[at + 16]) | (@intCast(usize, entry_bytes[at + 17]) << 8)
            const kind = entry_bytes[at + 18]
            var name_end = at + 19
            while entry_bytes[name_end] != 0 { name_end += 1 }
            const name = entry_bytes[at + 19..name_end]
            if name.length > 0 && name[0] != 46 && length + 1 + name.length < 4000 {
                var full = length
                bytes[full] = 47
                full += 1
                for byte in name {
                    bytes[full] = byte
                    full += 1
                }
                bytes[full] = 0
                if kind == 4 {
                    if depth == 0 { scanDirectory(binaries, programs, bytes[0..full], depth + 1) }
                } else if kind == 8 || kind == 10 || kind == 0 {
                    readBinary(binaries, programs, bytes[0..full])
                }
            }
            at += record_length
        }
    }
    const closed = std.linux.syscall1(3, @bitCast(usize, handle))
}

fn read16(image: usize, at: usize) -> usize {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, image + at) }
    return @intCast(usize, bytes[0]) | (@intCast(usize, bytes[1]) << 8)
}

fn read32(image: usize, at: usize) -> usize { return read16(image, at) | (read16(image, at + 2) << 16) }

fn read64(image: usize, at: usize) -> usize { return read32(image, at) | (read32(image, at + 4) << 32) }

fn byteAt(image: usize, at: usize) -> u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, image + at) }
    return bytes[0]
}

// One file: when it is an ELF file whose symbol table names Mlx functions,
// a binary (the same file found twice counts once).
fn readBinary(binaries: *Binaries, programs: *programs_module.Programs, path: []const u8) -> void {
    if binaries.*.count >= MAX_BINARIES || binaries.*.pathsUsed + path.length > MAX_BINARIES * 512 { return }
    var z: [4096]u8 = undefined
    var z_bytes: [*]u8 = undefined
    unsafe { z_bytes = @ptrCast([*]u8, &z) }
    var length: usize = 0
    for byte in path {
        z_bytes[length] = byte
        length += 1
    }
    z_bytes[length] = 0
    const file = std.linux.syscall3(2, @intFromPtr(z_bytes), 0, 0)
    if file < 0 { return }
    const size = std.linux.syscall3(8, @bitCast(usize, file), 0, 2)
    if size < 64 || size > 1073741824 {
        const closed = std.linux.syscall1(3, @bitCast(usize, file))
        return
    }
    const mapped = std.linux.syscall6(9, 0, @bitCast(usize, size), 1, 2, @bitCast(usize, file), 0)
    const closed = std.linux.syscall1(3, @bitCast(usize, file))
    if mapped < 0 { return }
    const image = @bitCast(usize, mapped)
    const image_size = @bitCast(usize, size)
    if byteAt(image, 0) == 127 && byteAt(image, 1) == 69 && byteAt(image, 2) == 76 && byteAt(image, 3) == 70 && byteAt(image, 4) == 2 {
        readSymbols(binaries, programs, image, image_size, path)
    }
    const unmapped = std.linux.syscall2(11, image, image_size)
}

fn readSymbols(binaries: *Binaries, programs: *programs_module.Programs, image: usize, size: usize, path: []const u8) -> void {
    const index = binaries.*.index
    const section_offset = read64(image, 40)
    const section_count = read16(image, 60)
    if section_offset + section_count * 64 > size { return }
    var section: usize = 0
    while section < section_count {
        const header = section_offset + section * 64
        if read32(image, header + 4) == 2 {
            const symbols = read64(image, header + 24)
            const symbols_size = read64(image, header + 32)
            const strings_header = section_offset + read32(image, header + 40) * 64
            const strings = read64(image, strings_header + 24)
            const strings_size = read64(image, strings_header + 32)
            if symbols + symbols_size > size || strings + strings_size > size { return }
            const binary = binaries.*.count
            binaries.*.pairStart[binary] = binaries.*.pairCount
            binaries.*.program[binary] = programs.*.count
            binaries.*.total[binary] = 0
            var named = false
            var at = symbols
            while at + 24 <= symbols + symbols_size && binaries.*.pairCount < MAX_PAIRS {
                const name_at = read32(image, at)
                const bytes = read64(image, at + 16)
                if byteAt(image, at + 4) & 15 == 2 && name_at < strings_size {
                    var name: [*]const u8 = undefined
                    unsafe { name = @ptrFromInt([*]const u8, image + strings + name_at) }
                    var length: usize = 0
                    while name_at + length < strings_size && name[length] != 0 { length += 1 }
                    const text = name[0..length]
                    const symbol = crashes_module.declarationOf(index, text)
                    binaries.*.total[binary] += bytes
                    if symbol != NONE {
                        named = true
                        binaries.*.pairSymbol[binaries.*.pairCount] = symbol
                        binaries.*.pairBytes[binaries.*.pairCount] = @intCast(u32, if bytes > 4294967295 { 4294967295 } else { bytes })
                        binaries.*.pairCount += 1
                        if index_module.sameBytes(index_module.nameOf(index, symbol), "main") {
                            const file = index_module.symbolAt(index, symbol).*.file
                            binaries.*.program[binary] = programs_module.programOfPath(programs, programs_module.relativePath(index, file))
                        }
                    }
                }
                at += 24
            }
            if !named || alreadyFound(binaries, binary) {
                binaries.*.pairCount = binaries.*.pairStart[binary]
                return
            }
            binaries.*.pairEnd[binary] = binaries.*.pairCount
            binaries.*.pathStart[binary] = binaries.*.pathsUsed
            for byte in path {
                binaries.*.paths[binaries.*.pathsUsed] = byte
                binaries.*.pathsUsed += 1
            }
            binaries.*.pathEnd[binary] = binaries.*.pathsUsed
            binaries.*.count += 1
            return
        }
        section += 1
    }
}

// A binary of the same program with the same code size found before.
fn alreadyFound(binaries: *Binaries, binary: usize) -> bool {
    var other: usize = 0
    while other < binary {
        if binaries.*.total[other] == binaries.*.total[binary] && binaries.*.program[other] == binaries.*.program[binary] { return true }
        other += 1
    }
    return false
}

// The sizes of one binary (ALL: each declaration's biggest of all). A
// function's instances in one binary add up.
pub fn choose(binaries: *Binaries, binary: usize) -> void {
    binaries.*.chosen = binary
    var symbol: usize = 0
    while symbol < binaries.*.index.*.symbolCount && symbol < binaries.*.capacity {
        binaries.*.bytes[symbol] = 0
        binaries.*.sums[symbol] = 0
        symbol += 1
    }
    var which: usize = 0
    while which < binaries.*.count {
        if binary == ALL || binary == which {
            var pair = binaries.*.pairStart[which]
            while pair < binaries.*.pairEnd[which] {
                binaries.*.sums[binaries.*.pairSymbol[pair]] += binaries.*.pairBytes[pair]
                pair += 1
            }
            pair = binaries.*.pairStart[which]
            while pair < binaries.*.pairEnd[which] {
                const at = @intCast(usize, binaries.*.pairSymbol[pair])
                if binaries.*.sums[at] > binaries.*.bytes[at] { binaries.*.bytes[at] = binaries.*.sums[at] }
                binaries.*.sums[at] = 0
                pair += 1
            }
        }
        which += 1
    }
}

// Where to look for binaries, NUL-separated into `into` (8192 bytes): the
// directory of the program running (an installed mlx-codemap sits beside
// the others), ROOT/mlx-out/bin, and MLX_CODEMAP_BINARIES (colon-separated).
pub fn defaultDirectories(root: []const u8, environment: [*][*]const u8, into: [*]u8) -> usize {
    var length: usize = 0
    var exe: [4096]u8 = undefined
    var exe_bytes: [*]u8 = undefined
    unsafe { exe_bytes = @ptrCast([*]u8, &exe) }
    const got = std.linux.syscall3(89, @intFromPtr("/proc/self/exe"), @intFromPtr(exe_bytes), 4000)
    if got > 0 {
        var end = @bitCast(usize, got)
        while end > 0 && exe_bytes[end - 1] != 47 { end -= 1 }
        if end > 1 { length = append(into, length, exe_bytes[0..end - 1]) }
        into[length] = 0
        length += 1
    }
    length = append(into, length, root)
    length = append(into, length, "/mlx-out/bin")
    into[length] = 0
    length += 1
    var entry: usize = 0
    while @intFromPtr(environment[entry]) != 0 {
        const text = environment[entry]
        const name = "MLX_CODEMAP_BINARIES="
        var matches = true
        var at: usize = 0
        for byte in name {
            if matches && text[at] != byte { matches = false }
            if matches { at += 1 }
        }
        if matches {
            while text[at] != 0 && length < 8000 {
                into[length] = if text[at] == 58 { 0 } else { text[at] }
                length += 1
                at += 1
            }
            into[length] = 0
            length += 1
        }
        entry += 1
    }
    return length
}

fn append(into: [*]u8, length: usize, text: []const u8) -> usize {
    var at = length
    for byte in text {
        if at < 8000 {
            into[at] = byte
            at += 1
        }
    }
    return at
}
