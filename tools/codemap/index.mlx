// The code index behind mlx-codemap and mlx-lsp: every Mlx file of a tree
// parsed with the canonical compiler's own lexer and parser (so it reads
// exactly the language the compiler does), its declarations (files,
// structs, enums, unions, error sets, fields, members, functions, their
// parameters, constants, variables, locals, imports and type aliases) with
// where they are, their signatures and their doc comments, and every use
// of a name resolved to the declaration it means: plain names through the
// scopes (locals, parameters, the file, Self), `a.b` through what `a` is
// (a module, a type, or a value of a type: its fields and functions, after
// `.*`, `.?`, `[i]`, calls, casts and the like), struct literals' fields
// too. From the uses come the connections: calls (caller, callee),
// imports (file, file), reads and writes.
//
// Build it with build(index, roots); ask with the functions after it.
// Everything lives in one arena: a new build starts from scratch.
const std = @import("std")
const lexer = @import("../../compiler/selfhost/lexer.mlx")
const parser_module = @import("../../compiler/selfhost/parser.mlx")
const token_module = @import("../../compiler/selfhost/lexer/token.mlx")
const arena_allocator = @import("../../std/bootstrap/arena_allocator.mlx")
const resolve_module = @import("./resolve.mlx")

pub const Allocator = std.allocator.Allocator
pub const Node = parser_module.Node
pub const Tag = parser_module.Tag
pub const Kind = token_module.Kind
pub const Token = token_module.Token

pub const NONE: u32 = 4294967295
pub const NODE_NONE: usize = 18446744073709551615

// Capacities (the arrays are mapped lazily: what is not used costs nothing).
pub const MAX_FILES: usize = 8192
pub const MAX_SYMBOLS: usize = 2097152
pub const MAX_REFS: usize = 8388608
const TABLE_SLOTS: usize = 4194304
const FILE_SLOTS: usize = 16384
pub const LOCALS: usize = 65536
const ARENA_BYTES: usize = 3221225472

// Symbol kinds.
pub const FILE: u8 = 0
pub const STRUCT: u8 = 1
pub const ENUM: u8 = 2
pub const UNION: u8 = 3
pub const ERROR_SET: u8 = 4
pub const FIELD: u8 = 5
pub const MEMBER: u8 = 6
pub const FUNCTION: u8 = 7
pub const CONST: u8 = 8
pub const VAR: u8 = 9
pub const PARAM: u8 = 10
pub const LOCAL_CONST: u8 = 11
pub const LOCAL_VAR: u8 = 12
pub const CAPTURE: u8 = 13
pub const TEST: u8 = 14
pub const IMPORT: u8 = 15
pub const ALIAS: u8 = 16
// A declaration a file had and has no longer (refreshFile).
pub const DEAD: u8 = 255

// Symbol flags (the parser's modifier bits, and more).
pub const FLAG_PUB: u32 = 1
pub const FLAG_EXTERN: u32 = 16
pub const FLAG_TYPE_ALIAS_DONE: u32 = 256
pub const FLAG_TYPING: u32 = 512
pub const FLAG_TYPED: u32 = 1024

// How a name is used.
pub const USE_DECLARATION: u8 = 0
pub const USE_READ: u8 = 1
pub const USE_WRITE: u8 = 2
pub const USE_CALL: u8 = 3
pub const USE_TYPE: u8 = 4
pub const USE_FIELD_INIT: u8 = 5
pub const USE_IMPORT: u8 = 6

pub const Symbol = struct {
    kind: u8
    flags: u32
    file: u32
    // The name: bytes in the file's source (a file's: its path).
    nameStart: u32
    nameLength: u32
    // The declaration's node, its type annotation (a function's return
    // type), its value (an initializer, a capture's iterable), and its
    // first token (modifiers included: the doc comment is above it).
    node: u32
    typeNode: u32
    valueNode: u32
    firstToken: u32
    parent: u32
    // Children of a container, in order.
    firstChild: u32
    lastChild: u32
    nextSibling: u32
    // An import's file symbol, an alias's type; the type worked out for a
    // value (typeSymbol and its wrappers, see Ty).
    target: u32
    typeSymbol: u32
    typeWraps: u64
    typeFlags: u32
}

// Where a name is used.
pub const Ref = struct {
    file: u32
    start: u32
    length: u32
    symbol: u32
    // The declaration it is in (a function, or a top-level declaration).
    from: u32
    use: u8
}

pub const FileRecord = struct {
    path: [*]const u8
    pathLength: usize
    source: [*]const u8
    sourceLength: usize
    tokens: lexer.Buffer
    nodes: parser_module.Store
    root: usize
    parseErrors: usize
    symbol: u32
    lineStarts: [*]u32
    lineCount: usize
    // The resolved symbol of each node (identifiers, fields, types).
    nodeSymbols: [*]u32
    refStart: usize
    refEnd: usize
    loaded: bool
}

// A type as far as the index follows it: a symbol (a struct, an enum, a
// union, a file for a module; NONE when unknown or primitive) inside
// wrappers (3 bits each, the outermost lowest), and whether the value is
// the type (or module) itself rather than a value of it.
pub const Ty = struct {
    symbol: u32
    wraps: u64
    depth: u32
    flags: u32
}

pub const WRAP_POINTER: u64 = 1
pub const WRAP_MANY: u64 = 2
pub const WRAP_SLICE: u64 = 3
pub const WRAP_ARRAY: u64 = 4
pub const WRAP_OPTIONAL: u64 = 5
pub const TY_TYPE: u32 = 1
pub const TY_FUNCTION: u32 = 2

pub const Index = struct {
    arena: arena_allocator.Arena
    allocator: Allocator
    files: [*]FileRecord
    fileCount: usize
    symbols: [*]Symbol
    symbolCount: usize
    refs: [*]Ref
    refCount: usize
    table: [*]u32
    fileTable: [*]u32
    // The tree's root (std/src is under it) and the locals in scope while
    // bodies are walked.
    root: [*]u8
    rootLength: usize
    locals: [*]u32
    localCount: usize
    // Walking: the file, the enclosing struct and declaration.
    walkFile: u32
    walkSelf: u32
    walkFrom: u32
    unresolved: usize
    // Texts to read instead of the files (an editor's unsaved ones): the
    // caller's Overlay array (its address; 0: none), kept across reset.
    overlays: usize
    overlayCount: usize
    // refreshFile: the file's symbols before, to be given to its
    // declarations again by (container, name, kind).
    refreshing: bool
    refreshingFile: u32
    reuseCount: usize
    reuseIds: [*]u32
    reuseParents: [*]u32
    reuseKinds: [*]u8
    reuseUsed: [*]u8
    reuseNameStart: [*]u32
    reuseNameLength: [*]u32
    reuseText: [*]u8
    reuseHeads: [*]u32
    reuseNext: [*]u32
    reuseMask: usize
}

// A file's text as an editor has it (setOverlays).
pub const Overlay = struct {
    path: [*]const u8
    pathLength: usize
    source: [*]const u8
    sourceLength: usize
}

// Texts to read instead of the files at their paths, from the next build
// on (the array and the texts stay the caller's; a build copies them).
pub fn setOverlays(index: *Index, overlays: [*]const Overlay, count: usize) -> void {
    index.*.overlays = @intFromPtr(overlays)
    index.*.overlayCount = count
}

fn overlayFor(index: *Index, path: []const u8) -> usize {
    var at: usize = 0
    while at < index.*.overlayCount && index.*.overlays != 0 {
        var overlay: *const Overlay = undefined
        unsafe { overlay = @ptrFromInt(*const Overlay, index.*.overlays + at * @sizeOf(Overlay)) }
        if overlay.*.pathLength == path.length && sameBytes(overlay.*.path[0..overlay.*.pathLength], path) { return at }
        at += 1
    }
    return 18446744073709551615
}

// ---------------------------------------------------------------------------
// Access

pub fn fileAt(index: *Index, file: u32) -> *FileRecord {
    unsafe { return @ptrFromInt(*FileRecord, @intFromPtr(index.*.files) + @intCast(usize, file) * @sizeOf(FileRecord)) }
}

pub fn symbolAt(index: *Index, symbol: u32) -> *Symbol {
    unsafe { return @ptrFromInt(*Symbol, @intFromPtr(index.*.symbols) + @intCast(usize, symbol) * @sizeOf(Symbol)) }
}

pub fn refAt(index: *Index, ref: usize) -> *Ref {
    unsafe { return @ptrFromInt(*Ref, @intFromPtr(index.*.refs) + ref * @sizeOf(Ref)) }
}

pub fn nodeAt(index: *Index, file: u32, node: usize) -> Node {
    const record = fileAt(index, file)
    unsafe { return @ptrFromInt(*Node, @intFromPtr(record.*.nodes.items) + node * @sizeOf(Node)).* }
}

pub fn tokenAt(index: *Index, file: u32, token: usize) -> Token {
    const record = fileAt(index, file)
    return lexer.tokenAt(record.*.tokens, token)
}

pub fn sourceOf(index: *Index, file: u32) -> []const u8 {
    const record = fileAt(index, file)
    return record.*.source[0..record.*.sourceLength]
}

pub fn pathOf(index: *Index, file: u32) -> []const u8 {
    const record = fileAt(index, file)
    return record.*.path[0..record.*.pathLength]
}

pub fn nameOf(index: *Index, symbol: u32) -> []const u8 {
    const value = symbolAt(index, symbol)
    if value.*.kind == FILE { return pathOf(index, value.*.file) }
    const record = fileAt(index, value.*.file)
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(record.*.source) + @intCast(usize, value.*.nameStart)) }
    return bytes[0..@intCast(usize, value.*.nameLength)]
}

pub fn tokenText(index: *Index, file: u32, token: usize) -> []const u8 {
    const value = tokenAt(index, file, token)
    const record = fileAt(index, file)
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(record.*.source) + value.start) }
    return bytes[0..value.length]
}

pub fn nodeSymbol(index: *Index, file: u32, node: usize) -> u32 {
    if node == NODE_NONE { return NONE }
    return fileAt(index, file).*.nodeSymbols[node]
}

pub fn setNodeSymbol(index: *Index, file: u32, node: usize, symbol: u32) -> void {
    if node == NODE_NONE { return }
    fileAt(index, file).*.nodeSymbols[node] = symbol
}

pub fn sameBytes(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var at: usize = 0
    while at < first.length {
        if first[at] != second[at] { return false }
        at += 1
    }
    return true
}

fn hashBytes(seed: u64, text: []const u8) -> u64 {
    var value = seed ^ 14695981039346656037
    for byte in text {
        value = (value ^ @intCast(u64, byte)) *% 1099511628211
    }
    return value
}

// ---------------------------------------------------------------------------
// Symbols

fn addSymbol(index: *Index, kind: u8, file: u32, name_start: usize, name_length: usize, node: usize, parent: u32) -> u32 {
    // Read again (refreshFile): the declaration's symbol before, if any.
    var id = NONE
    if index.*.refreshing && file == index.*.refreshingFile { id = reusable(index, kind, name_start, name_length, parent) }
    if id == NONE {
        if index.*.symbolCount >= MAX_SYMBOLS { return NONE }
        id = @intCast(u32, index.*.symbolCount)
        index.*.symbolCount += 1
    }
    const value = symbolAt(index, id)
    value.*.kind = kind
    value.*.flags = 0
    value.*.file = file
    value.*.nameStart = @intCast(u32, name_start)
    value.*.nameLength = @intCast(u32, name_length)
    value.*.node = if node == NODE_NONE { NONE } else { @intCast(u32, node) }
    value.*.typeNode = NONE
    value.*.valueNode = NONE
    value.*.firstToken = NONE
    value.*.parent = parent
    value.*.firstChild = NONE
    value.*.lastChild = NONE
    value.*.nextSibling = NONE
    value.*.target = NONE
    value.*.typeSymbol = NONE
    value.*.typeWraps = 0
    value.*.typeFlags = 0
    if parent != NONE {
        const container = symbolAt(index, parent)
        if container.*.lastChild == NONE {
            container.*.firstChild = id
        } else {
            symbolAt(index, container.*.lastChild).*.nextSibling = id
        }
        container.*.lastChild = id
    }
    return id
}

fn sameKinds(first: u8, second: u8) -> bool {
    if first == second { return true }
    // A const may have turned out an alias (typeOfSymbol).
    const first_const = first == CONST || first == LOCAL_CONST || first == ALIAS
    const second_const = second == CONST || second == LOCAL_CONST || second == ALIAS
    return first_const && second_const
}

// The symbol the refreshed file had for this declaration (same container,
// name and kind; not given out yet); NONE: a new one.
fn reusable(index: *Index, kind: u8, name_start: usize, name_length: usize, parent: u32) -> u32 {
    if index.*.reuseCount == 0 { return NONE }
    const source = sourceOf(index, index.*.refreshingFile)
    const name = source[name_start..name_start + name_length]
    var at = index.*.reuseHeads[@intCast(usize, hashBytes(@intCast(u64, parent), name)) & index.*.reuseMask]
    while at != NONE {
        const which = @intCast(usize, at)
        if index.*.reuseUsed[which] == 0 && index.*.reuseParents[which] == parent && sameKinds(index.*.reuseKinds[which], kind) {
            const start = @intCast(usize, index.*.reuseNameStart[which])
            if sameBytes(index.*.reuseText[start..start + @intCast(usize, index.*.reuseNameLength[which])], name) {
                index.*.reuseUsed[which] = 1
                return index.*.reuseIds[which]
            }
        }
        at = index.*.reuseNext[which]
    }
    return NONE
}

// A symbol named by token `token` of `file`.
pub fn addNamed(index: *Index, kind: u8, file: u32, token: usize, node: usize, parent: u32) -> u32 {
    const value = tokenAt(index, file, token)
    return addSymbol(index, kind, file, value.start, value.length, node, parent)
}

// The member table: (container, name) -> symbol.
fn slotFor(index: *Index, container: u32, name: []const u8) -> usize {
    return @intCast(usize, hashBytes(@intCast(u64, container) *% 2654435761, name) % @intCast(u64, TABLE_SLOTS))
}

pub fn putMember(index: *Index, container: u32, symbol: u32) -> void {
    if container == NONE || symbol == NONE { return }
    const name = nameOf(index, symbol)
    var slot = slotFor(index, container, name)
    var probes: usize = 0
    while probes < TABLE_SLOTS {
        const held = index.*.table[slot]
        if held == NONE {
            index.*.table[slot] = symbol
            return
        }
        // The first declaration of a name wins.
        if symbolAt(index, held).*.parent == container && sameBytes(nameOf(index, held), name) { return }
        slot = (slot + 1) % TABLE_SLOTS
        probes += 1
    }
}

pub fn member(index: *Index, container: u32, name: []const u8) -> u32 {
    if container == NONE { return NONE }
    var slot = slotFor(index, container, name)
    while true {
        const held = index.*.table[slot]
        if held == NONE { return NONE }
        if symbolAt(index, held).*.parent == container && sameBytes(nameOf(index, held), name) { return held }
        slot = (slot + 1) % TABLE_SLOTS
    }
    return NONE
}

// ---------------------------------------------------------------------------
// Files

fn fileSlot(index: *Index, path: []const u8) -> usize {
    return @intCast(usize, hashBytes(7, path) % @intCast(u64, FILE_SLOTS))
}

pub fn findFile(index: *Index, path: []const u8) -> u32 {
    var slot = fileSlot(index, path)
    while true {
        const held = index.*.fileTable[slot]
        if held == NONE { return NONE }
        if sameBytes(pathOf(index, held), path) { return held }
        slot = (slot + 1) % FILE_SLOTS
    }
    return NONE
}

// A file of the index (read and parsed when first asked for); NONE when
// it cannot be read.
pub fn addFile(index: *Index, path: []const u8) -> u32 {
    const known = findFile(index, path)
    if known != NONE { return known }
    if index.*.fileCount >= MAX_FILES { return NONE }
    // Read it.
    const copy = index.*.allocator.alloc(path.length + 1, 1)
    if copy == null { return NONE }
    const bytes = copy.?
    var at: usize = 0
    while at < path.length {
        bytes[at] = path[at]
        at += 1
    }
    bytes[path.length] = 0
    const overlay = overlayFor(index, path)
    if overlay != 18446744073709551615 {
        var given: *const Overlay = undefined
        unsafe { given = @ptrFromInt(*const Overlay, index.*.overlays + overlay * @sizeOf(Overlay)) }
        const text = index.*.allocator.alloc(given.*.sourceLength + 1, 16)
        if text == null { return NONE }
        var copied: usize = 0
        while copied < given.*.sourceLength {
            text.?[copied] = given.*.source[copied]
            copied += 1
        }
        text.?[given.*.sourceLength] = 0
        return addRead(index, path, bytes, text.?, given.*.sourceLength)
    }
    const file = std.fs.open(bytes, 0, 0)
    if !std.fs.isValid(file) { return NONE }
    var status: std.fs.Stat = undefined
    if std.fs.fileStatus(file, &status) != 0 || status.size < 0 {
        const closed = std.fs.close(file)
        return NONE
    }
    const size = @intCast(usize, status.size)
    const memory = index.*.allocator.alloc(size + 1, 16)
    if memory == null {
        const closed = std.fs.close(file)
        return NONE
    }
    const source = memory.?
    var got: usize = 0
    while got < size {
        var chunk: [*]u8 = undefined
        unsafe { chunk = @ptrFromInt([*]u8, @intFromPtr(source) + got) }
        const count = std.fs.read(file, chunk, size - got)
        if count <= 0 { break }
        got += @intCast(usize, count)
    }
    const closed = std.fs.close(file)
    source[got] = 0
    return addRead(index, path, bytes, source, got)
}

// A file read: into the table, parsed.
fn addRead(index: *Index, path: []const u8, bytes: [*]u8, source: [*]u8, got: usize) -> u32 {
    const id = @intCast(u32, index.*.fileCount)
    index.*.fileCount += 1
    const record = fileAt(index, id)
    record.*.path = bytes
    record.*.pathLength = path.length
    record.*.source = source
    record.*.sourceLength = got
    record.*.loaded = false
    record.*.refStart = 0
    record.*.refEnd = 0
    var slot = fileSlot(index, path)
    while index.*.fileTable[slot] != NONE { slot = (slot + 1) % FILE_SLOTS }
    index.*.fileTable[slot] = id
    parseFile(index, id)
    return id
}

fn tokensOf(record: *FileRecord) -> *lexer.Buffer {
    unsafe { return @ptrFromInt(*lexer.Buffer, @intFromPtr(record) + @offsetOf(FileRecord, "tokens")) }
}

fn nodesOf(record: *FileRecord) -> *parser_module.Store {
    unsafe { return @ptrFromInt(*parser_module.Store, @intFromPtr(record) + @offsetOf(FileRecord, "nodes")) }
}

fn arenaOf(index: *Index) -> *arena_allocator.Arena {
    unsafe { return @ptrFromInt(*arena_allocator.Arena, @intFromPtr(index) + @offsetOf(Index, "arena")) }
}

fn parseFile(index: *Index, file: u32) -> void {
    parseText(index, file)
    const record = fileAt(index, file)
    record.*.symbol = addSymbol(index, FILE, file, 0, 0, record.*.root, NONE)
}

// Lexes and parses a file's text; where its lines start.
fn parseText(index: *Index, file: u32) -> void {
    const record = fileAt(index, file)
    const source = record.*.source[0..record.*.sourceLength]
    lexer.scanAllLengthInto(tokensOf(record), index.*.allocator, source, record.*.sourceLength)
    parser_module.initStoreAt(nodesOf(record), index.*.allocator, record.*.sourceLength / 8 + 64)
    var parser = parser_module.initLength(source, record.*.sourceLength, record.*.tokens, nodesOf(record))
    record.*.root = parser_module.parse(&parser)
    record.*.parseErrors = parser.errorCount
    // Every node unresolved to begin with.
    const count = record.*.nodes.length
    const memory = index.*.allocator.alloc(count * 4 + 4, 16)
    unsafe { record.*.nodeSymbols = @ptrCast([*]u32, memory.?) }
    var at: usize = 0
    while at < count {
        record.*.nodeSymbols[at] = NONE
        at += 1
    }
    // Where the lines start.
    var lines: usize = 1
    for byte in source {
        if byte == 10 { lines += 1 }
    }
    const starts = index.*.allocator.alloc(lines * 4 + 4, 16)
    unsafe { record.*.lineStarts = @ptrCast([*]u32, starts.?) }
    record.*.lineStarts[0] = 0
    var line: usize = 1
    at = 0
    while at < record.*.sourceLength {
        if source[at] == 10 {
            record.*.lineStarts[line] = @intCast(u32, at + 1)
            line += 1
        }
        at += 1
    }
    record.*.lineCount = lines
}

// ---------------------------------------------------------------------------
// Positions

// The 0-based line and byte column of byte `offset` of `file`.
pub fn lineOf(index: *Index, file: u32, offset: usize) -> usize {
    const record = fileAt(index, file)
    var low: usize = 0
    var high = record.*.lineCount
    while low + 1 < high {
        const middle = (low + high) / 2
        if @intCast(usize, record.*.lineStarts[middle]) <= offset { low = middle } else { high = middle }
    }
    return low
}

pub fn columnOf(index: *Index, file: u32, offset: usize) -> usize {
    const record = fileAt(index, file)
    return offset - @intCast(usize, record.*.lineStarts[lineOf(index, file, offset)])
}

// The byte offset of 0-based line and byte column.
pub fn offsetOf(index: *Index, file: u32, line: usize, column: usize) -> usize {
    const record = fileAt(index, file)
    if line >= record.*.lineCount { return record.*.sourceLength }
    const offset = @intCast(usize, record.*.lineStarts[line]) + column
    return if offset > record.*.sourceLength { record.*.sourceLength } else { offset }
}

// ---------------------------------------------------------------------------
// Imports

pub fn stringTokenValue(index: *Index, file: u32, token: usize) -> []const u8 {
    const text = tokenText(index, file, token)
    if text.length < 2 { return text[0..0] }
    return text[1..text.length - 1]
}

// The path an import names, resolved like the compiler: "./x.mlx" next
// to the importer, "std" and "std.png" under std/src.
pub fn importPath(index: *Index, file: u32, requested: []const u8, out: [*]u8) -> usize {
    var length: usize = 0
    if requested.length >= 3 && requested[0] == 115 && requested[1] == 116 && requested[2] == 100 && (requested.length == 3 || requested[3] == 46) {
        var at: usize = 0
        while at < index.*.rootLength {
            out[length] = index.*.root[at]
            length += 1
            at += 1
        }
        for byte in "/std/src/" {
            out[length] = byte
            length += 1
        }
        if requested.length == 3 {
            for byte in "std.mlx" {
                out[length] = byte
                length += 1
            }
            return length
        }
        at = 4
        while at < requested.length && length < 1000 {
            out[length] = if requested[at] == 46 { 47 } else { requested[at] }
            length += 1
            at += 1
        }
        for byte in ".mlx" {
            out[length] = byte
            length += 1
        }
        return length
    }
    if requested.length < 2 || requested[0] != 46 { return 0 }
    // The importer's directory, then the requested path, "." and ".."
    // folded.
    const importer = pathOf(index, file)
    var directory = importer.length
    while directory > 0 && importer[directory - 1] != 47 { directory -= 1 }
    var at: usize = 0
    while at < directory {
        out[length] = importer[at]
        length += 1
        at += 1
    }
    at = 0
    while at < requested.length && length < 1000 {
        var end = at
        while end < requested.length && requested[end] != 47 { end += 1 }
        const part_length = end - at
        if part_length == 1 && requested[at] == 46 {
            // "."
        } else if part_length == 2 && requested[at] == 46 && requested[at + 1] == 46 {
            // "..": back one directory (the trailing slash kept).
            if length > 0 { length -= 1 }
            while length > 0 && out[length - 1] != 47 { length -= 1 }
        } else {
            var copy = at
            while copy < end {
                out[length] = requested[copy]
                length += 1
                copy += 1
            }
            if end < requested.length {
                out[length] = 47
                length += 1
            }
        }
        at = end + 1
    }
    return length
}

// Whether node `node` is @import("...") (its string token, else NONE).
pub fn importToken(index: *Index, file: u32, node: usize) -> usize {
    if node == NODE_NONE { return NODE_NONE }
    const value = nodeAt(index, file, node)
    if value.tag != Tag.builtin_call { return NODE_NONE }
    if !sameBytes(tokenText(index, file, value.mainToken), "import") { return NODE_NONE }
    if value.lhs == NODE_NONE { return NODE_NONE }
    const argument = nodeAt(index, file, value.lhs)
    if argument.tag != Tag.string_literal { return NODE_NONE }
    return argument.mainToken
}

// ---------------------------------------------------------------------------
// Building

fn allocateArray(allocator: Allocator, bytes: usize) -> [*]u8 {
    return allocator.alloc(bytes, 16).?
}

pub fn create(root: []const u8) -> *Index {
    const pages = std.page_allocator.init()
    const memory = pages.alloc(@sizeOf(Index), 16)
    var index: *Index = undefined
    unsafe { index = @ptrCast(*Index, memory.?) }
    index.*.arena = arena_allocator.init(pages, ARENA_BYTES)
    index.*.allocator = arena_allocator.interface(arenaOf(index))
    index.*.overlays = 0
    index.*.overlayCount = 0
    reset(index, root)
    return index
}

// Empties the index (everything is built again).
pub fn reset(index: *Index, root: []const u8) -> void {
    arena_allocator.reset(arenaOf(index))
    const allocator = index.*.allocator
    unsafe {
        index.*.files = @ptrCast([*]FileRecord, allocateArray(allocator, MAX_FILES * @sizeOf(FileRecord)))
        index.*.symbols = @ptrCast([*]Symbol, allocateArray(allocator, MAX_SYMBOLS * @sizeOf(Symbol)))
        index.*.refs = @ptrCast([*]Ref, allocateArray(allocator, MAX_REFS * @sizeOf(Ref)))
        index.*.table = @ptrCast([*]u32, allocateArray(allocator, TABLE_SLOTS * 4))
        index.*.fileTable = @ptrCast([*]u32, allocateArray(allocator, FILE_SLOTS * 4))
        index.*.locals = @ptrCast([*]u32, allocateArray(allocator, LOCALS * 4))
        index.*.root = allocateArray(allocator, root.length + 1)
    }
    var at: usize = 0
    while at < TABLE_SLOTS {
        index.*.table[at] = NONE
        at += 1
    }
    at = 0
    while at < FILE_SLOTS {
        index.*.fileTable[at] = NONE
        at += 1
    }
    at = 0
    while at < root.length {
        index.*.root[at] = root[at]
        at += 1
    }
    index.*.rootLength = root.length
    index.*.fileCount = 0
    index.*.symbolCount = 0
    index.*.refCount = 0
    index.*.localCount = 0
    index.*.unresolved = 0
    index.*.walkSelf = NONE
    index.*.walkFrom = NONE
    index.*.refreshing = false
    index.*.reuseCount = 0
}

// Adds a file to the index (its imports come with it when built).
pub fn addPath(index: *Index, path: []const u8) -> u32 {
    return addFile(index, path)
}

fn isSkippedDirectory(name: []const u8) -> bool {
    return sameBytes(name, ".git") || sameBytes(name, "mlx-out") || sameBytes(name, "zig-out") || sameBytes(name, ".zig-cache") || sameBytes(name, "node_modules") || sameBytes(name, ".claude")
}

// Every .mlx file under directory `path`.
pub fn addTree(index: *Index, path: []const u8) -> void {
    var buffer: [1100]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    if path.length > 1000 { return }
    var at: usize = 0
    while at < path.length {
        bytes[at] = path[at]
        at += 1
    }
    bytes[path.length] = 0
    const handle = std.linux.syscall3(2, @intFromPtr(bytes), 65536 | 524288, 0)
    if handle < 0 { return }
    var entries: [16384]u8 = undefined
    var records: [*]u8 = undefined
    unsafe { records = @ptrCast([*]u8, &entries) }
    while true {
        const count = std.linux.syscall3(217, @bitCast(usize, handle), @intFromPtr(records), 16384)
        if count <= 0 { break }
        var offset: usize = 0
        while offset < @bitCast(usize, count) {
            const record_length = @intCast(usize, records[offset + 16]) | (@intCast(usize, records[offset + 17]) << 8)
            const kind = records[offset + 18]
            var name: [*]const u8 = undefined
            unsafe { name = @ptrFromInt([*]const u8, @intFromPtr(records) + offset + 19) }
            var length: usize = 0
            while name[length] != 0 { length += 1 }
            const entry = name[0..length]
            const dots = sameBytes(entry, ".") || sameBytes(entry, "..")
            if !dots && path.length + length + 2 < 1000 {
                bytes[path.length] = 47
                var copy: usize = 0
                while copy < length {
                    bytes[path.length + 1 + copy] = entry[copy]
                    copy += 1
                }
                const full = bytes[0..path.length + 1 + length]
                if kind == 4 && !isSkippedDirectory(entry) {
                    addTree(index, full)
                } else if kind == 8 && length > 4 && sameBytes(entry[length - 4..length], ".mlx") {
                    const added = addFile(index, full)
                }
            }
            if record_length == 0 { break }
            offset += record_length
        }
    }
    const closed = std.linux.syscall1(3, @bitCast(usize, handle))
}

// Declarations of every file (imports load more files: until none is
// left), then every use.
pub fn build(index: *Index) -> void {
    var file: usize = 0
    while file < index.*.fileCount {
        resolve_module.declareFile(index, @intCast(u32, file))
        file += 1
    }
    file = 0
    while file < index.*.fileCount {
        resolve_module.walkFile(index, @intCast(u32, file))
        file += 1
    }
}

// ---------------------------------------------------------------------------
// Reading one file again

// How much of the index's memory is in use (bytes); refreshFile adds to
// it, a build starts it over.
pub fn memoryUsed(index: *Index) -> usize { return arenaOf(index).*.offset }

// Reads file `file` again from `text` (an editor's, as it is now): parsed,
// declared and its uses resolved again, the rest of the index as it is.
// Its declarations keep their symbols (by container, name and kind), so
// the uses in other files still find them; the ones it has no longer turn
// DEAD, new ones are added. False when it cannot (the index is full).
pub fn refreshFile(index: *Index, file: u32, text: []const u8) -> bool {
    if @intCast(usize, file) >= index.*.fileCount { return false }
    if index.*.refCount + text.length / 2 + 65536 >= MAX_REFS || index.*.symbolCount + text.length / 4 + 4096 >= MAX_SYMBOLS { return false }
    const record = fileAt(index, file)
    const file_symbol = record.*.symbol
    const allocator = index.*.allocator
    // Its symbols now, with their names (the text goes).
    var count: usize = 0
    var names: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const value = symbolAt(index, @intCast(u32, symbol))
        if value.*.file == file && @intCast(u32, symbol) != file_symbol && value.*.kind != DEAD {
            count += 1
            names += @intCast(usize, value.*.nameLength)
        }
        symbol += 1
    }
    var mask: usize = 1
    while mask < count * 2 + 2 { mask = mask * 2 }
    unsafe {
        index.*.reuseIds = @ptrCast([*]u32, allocateArray(allocator, count * 4 + 4))
        index.*.reuseParents = @ptrCast([*]u32, allocateArray(allocator, count * 4 + 4))
        index.*.reuseNameStart = @ptrCast([*]u32, allocateArray(allocator, count * 4 + 4))
        index.*.reuseNameLength = @ptrCast([*]u32, allocateArray(allocator, count * 4 + 4))
        index.*.reuseNext = @ptrCast([*]u32, allocateArray(allocator, count * 4 + 4))
        index.*.reuseHeads = @ptrCast([*]u32, allocateArray(allocator, mask * 4))
    }
    index.*.reuseKinds = allocateArray(allocator, count + 1)
    index.*.reuseUsed = allocateArray(allocator, count + 1)
    index.*.reuseText = allocateArray(allocator, names + 1)
    index.*.reuseMask = mask - 1
    var at: usize = 0
    while at < mask {
        index.*.reuseHeads[at] = NONE
        at += 1
    }
    const old_source = sourceOf(index, file)
    var text_used: usize = 0
    count = 0
    symbol = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const value = symbolAt(index, id)
        if value.*.file == file && id != file_symbol && value.*.kind != DEAD {
            const start = @intCast(usize, value.*.nameStart)
            const length = @intCast(usize, value.*.nameLength)
            const name = old_source[start..start + length]
            index.*.reuseIds[count] = id
            index.*.reuseParents[count] = value.*.parent
            index.*.reuseKinds[count] = value.*.kind
            index.*.reuseUsed[count] = 0
            index.*.reuseNameStart[count] = @intCast(u32, text_used)
            index.*.reuseNameLength[count] = @intCast(u32, length)
            var copied: usize = 0
            while copied < length {
                index.*.reuseText[text_used + copied] = name[copied]
                copied += 1
            }
            text_used += length
            const bucket = @intCast(usize, hashBytes(@intCast(u64, value.*.parent), name)) & index.*.reuseMask
            index.*.reuseNext[count] = index.*.reuseHeads[bucket]
            index.*.reuseHeads[bucket] = @intCast(u32, count)
            // Out of the member table and its container until declared
            // again.
            value.*.parent = NONE
            value.*.firstChild = NONE
            value.*.lastChild = NONE
            value.*.nextSibling = NONE
            count += 1
        }
        symbol += 1
    }
    index.*.reuseCount = count
    // Its uses before are no one's.
    var ref = record.*.refStart
    while ref < record.*.refEnd {
        refAt(index, ref).*.symbol = NONE
        ref += 1
    }
    // The new text, parsed; the file keeps its symbol.
    const copy = allocator.alloc(text.length + 1, 16)
    if copy == null { return false }
    at = 0
    while at < text.length {
        copy.?[at] = text[at]
        at += 1
    }
    copy.?[text.length] = 0
    record.*.source = copy.?
    record.*.sourceLength = text.length
    parseText(index, file)
    const container = symbolAt(index, file_symbol)
    container.*.node = @intCast(u32, record.*.root)
    container.*.firstChild = NONE
    container.*.lastChild = NONE
    record.*.loaded = false
    // Declared and walked again (and files it imports now that were not
    // read yet).
    const files_before = index.*.fileCount
    index.*.refreshing = true
    index.*.refreshingFile = file
    resolve_module.declareFile(index, file)
    var other = files_before
    while other < index.*.fileCount {
        resolve_module.declareFile(index, @intCast(u32, other))
        other += 1
    }
    resolve_module.walkFile(index, file)
    index.*.refreshing = false
    other = files_before
    while other < index.*.fileCount {
        resolve_module.walkFile(index, @intCast(u32, other))
        other += 1
    }
    // What it declares no longer.
    at = 0
    while at < count {
        if index.*.reuseUsed[at] == 0 {
            const value = symbolAt(index, index.*.reuseIds[at])
            value.*.kind = DEAD
            value.*.nameStart = 0
            value.*.nameLength = 0
            value.*.node = NONE
            value.*.typeNode = NONE
            value.*.valueNode = NONE
            value.*.firstToken = NONE
            value.*.flags = 0
        }
        at += 1
    }
    index.*.reuseCount = 0
    return true
}

// ---------------------------------------------------------------------------
// Questions

// The use (or declaration) at byte `offset` of `file`, else NONE.
pub fn refAtOffset(index: *Index, file: u32, offset: usize) -> usize {
    const record = fileAt(index, file)
    var low = record.*.refStart
    var high = record.*.refEnd
    // The last use starting at or before offset.
    while low < high {
        const middle = (low + high) / 2
        if @intCast(usize, refAt(index, middle).*.start) <= offset { low = middle + 1 } else { high = middle }
    }
    var at = low
    while at > record.*.refStart {
        at -= 1
        const ref = refAt(index, at)
        if @intCast(usize, ref.*.start) + @intCast(usize, ref.*.length) >= offset && @intCast(usize, ref.*.start) <= offset { return at }
        if @intCast(usize, ref.*.start) + 200 < offset { break }
    }
    return MAX_REFS
}

pub fn symbolAtOffset(index: *Index, file: u32, offset: usize) -> u32 {
    const ref = refAtOffset(index, file, offset)
    if ref == MAX_REFS { return NONE }
    return refAt(index, ref).*.symbol
}

pub fn kindName(kind: u8) -> []const u8 {
    return match kind {
        0 => "file", 1 => "struct", 2 => "enum", 3 => "union", 4 => "error set", 5 => "field", 6 => "member",
        7 => "function", 8 => "const", 9 => "var", 10 => "parameter", 11 => "local const", 12 => "local var",
        13 => "capture", 14 => "test", 15 => "import", 16 => "alias",
        else => "?"
    }
}

pub fn useName(use: u8) -> []const u8 {
    return match use { 0 => "declaration", 1 => "read", 2 => "write", 3 => "call", 4 => "type", 5 => "field init", 6 => "import", else => "?" }
}

// Where a symbol's declaration starts (its first token, else its name).
pub fn declarationOffset(index: *Index, symbol: u32) -> usize {
    const record = symbolAt(index, symbol)
    if record.*.firstToken == NONE { return @intCast(usize, record.*.nameStart) }
    return tokenAt(index, record.*.file, @intCast(usize, record.*.firstToken)).start
}

// The doc comment above a declaration: the `//` lines right above it (no
// blank line between), as a range of the source (start, length); length 0
// without one.
pub fn docRange(index: *Index, symbol: u32, start: *usize, length: *usize) -> void {
    start.* = 0
    length.* = 0
    const record = symbolAt(index, symbol)
    if record.*.kind == FILE {
        // A file's: the comment block it starts with.
        const source = sourceOf(index, record.*.file)
        var end: usize = 0
        while end < source.length {
            var at = end
            while at < source.length && (source[at] == 32 || source[at] == 9) { at += 1 }
            if at + 1 < source.length && source[at] == 47 && source[at + 1] == 47 {
                while at < source.length && source[at] != 10 { at += 1 }
                end = at + 1
            } else {
                break
            }
        }
        length.* = if end > source.length { source.length } else { end }
        return
    }
    const file = record.*.file
    const source = sourceOf(index, file)
    const declaration = declarationOffset(index, symbol)
    // The start of the declaration's line.
    var line_start = declaration
    while line_start > 0 && source[line_start - 1] != 10 { line_start -= 1 }
    var top = line_start
    while top > 0 {
        // The line above.
        var above = top - 1
        while above > 0 && source[above - 1] != 10 { above -= 1 }
        var at = above
        while at < top && (source[at] == 32 || source[at] == 9) { at += 1 }
        if at + 1 < top && source[at] == 47 && source[at + 1] == 47 {
            top = above
        } else {
            break
        }
    }
    start.* = top
    length.* = line_start - top
}

// The declaration's first line up to its body or value (a function's
// header, `name: Type` for a field), as a range of the source.
pub fn signatureRange(index: *Index, symbol: u32, start: *usize, length: *usize) -> void {
    const record = symbolAt(index, symbol)
    const file = record.*.file
    const source = sourceOf(index, file)
    start.* = declarationOffset(index, symbol)
    var end = start.*
    if record.*.kind == FUNCTION && record.*.node != NONE {
        const body = nodeAt(index, file, @intCast(usize, record.*.node)).rhs
        if body != NODE_NONE {
            end = tokenAt(index, file, nodeAt(index, file, body).mainToken).start
        } else {
            while end < source.length && source[end] != 10 { end += 1 }
        }
    } else {
        while end < source.length && source[end] != 10 { end += 1 }
    }
    while end > start.* && (source[end - 1] == 32 || source[end - 1] == 123) { end -= 1 }
    length.* = end - start.*
}

// The passes' answers the index's users ask for (resolve.mlx).
pub fn typeOfSymbol(index: *Index, symbol: u32) -> Ty { return resolve_module.typeOfSymbol(index, symbol) }
pub fn returnType(index: *Index, function: u32) -> Ty { return resolve_module.returnType(index, function) }
pub fn declarationEnd(index: *Index, symbol: u32) -> usize { return resolve_module.declarationEnd(index, symbol) }
pub fn memberOfType(index: *Index, ty: Ty, name: []const u8) -> u32 { return resolve_module.memberOfType(index, ty, name) }
