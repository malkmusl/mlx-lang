// How the workarounds (tools/codemap/workarounds.mlx) came and went: their
// count per pattern at each of the last commits. A commit is worked out
// once (git archive into a temporary directory, the code map's own binary
// counting there: `mlx-codemap -C DIR workarounds-count`) and kept in
// $XDG_CACHE_HOME/mlx/codemap/workarounds-v1 (~/.cache/mlx/codemap), a
// line per commit: its name and the counts. The app only reads what is
// kept; `mlx-codemap history` fills it.
//
//     var trend: trend_module.Trend = undefined
//     trend_module.init(&trend, allocator)
//     trend_module.load(&trend, &git, 20)
//     while trend_module.fillNext(&trend, &git) {}
const std = @import("std")
const index_module = @import("./index.mlx")
const git_module = @import("./git.mlx")
const history_module = @import("./history.mlx")
const workarounds_module = @import("./workarounds.mlx")

pub const Allocator = std.allocator.Allocator

pub const MAX_COMMITS: usize = 512
const PATTERNS: usize = 9
const HASH: usize = 40
const MAX_KEPT: usize = 4194304

pub const Trend = struct {
    allocator: Allocator
    // The commits, oldest first: name (40 hex digits), time, whether
    // their counts are known, the counts (PATTERNS each).
    count: usize
    hash: [*]u8
    time: [*]u32
    known: [*]u8
    counts: [*]u32
    // The cache file (NUL-terminated) and what it held.
    path: [*]u8
    pathLength: usize
    kept: [*]u8
    keptLength: usize
    // This program (for counting a commit).
    self: [*]u8
    selfLength: usize
}

pub fn init(trend: *Trend, allocator: Allocator) -> void {
    trend.*.allocator = allocator
    trend.*.count = 0
    trend.*.hash = allocator.alloc(MAX_COMMITS * HASH, 16).?
    trend.*.time = allocator.words(MAX_COMMITS)
    trend.*.known = allocator.alloc(MAX_COMMITS, 16).?
    trend.*.counts = allocator.words(MAX_COMMITS * PATTERNS)
    trend.*.path = allocator.alloc(4096, 16).?
    trend.*.pathLength = 0
    trend.*.kept = allocator.alloc(MAX_KEPT, 16).?
    trend.*.keptLength = 0
    trend.*.self = allocator.alloc(4096, 16).?
    // readlink /proc/self/exe
    var got: isize = 0
    unsafe { got = std.linux.syscall3(89, @intFromPtr(@ptrCast([*]const u8, "/proc/self/exe")), @intFromPtr(trend.*.self), 4000) }
    trend.*.selfLength = if got > 0 { @bitCast(usize, got) } else { 0 }
}

pub fn hashOf(trend: *Trend, commit: usize) -> []const u8 {
    return trend.*.hash[commit * HASH..commit * HASH + HASH]
}

pub fn countOf(trend: *Trend, commit: usize, pattern: u8) -> u32 {
    return trend.*.counts[commit * PATTERNS + @intCast(usize, pattern)]
}

pub fn totalOf(trend: *Trend, commit: usize) -> u32 {
    var total: u32 = 0
    var pattern: usize = 0
    while pattern < PATTERNS {
        total += trend.*.counts[commit * PATTERNS + pattern]
        pattern += 1
    }
    return total
}

pub fn isKnown(trend: *Trend, commit: usize) -> bool { return trend.*.known[commit] == 1 }

// How many commits are not worked out yet.
pub fn missing(trend: *Trend) -> usize {
    var count: usize = 0
    var commit: usize = 0
    while commit < trend.*.count {
        if trend.*.known[commit] == 0 { count += 1 }
        commit += 1
    }
    return count
}

// The most of `pattern` (PATTERNS: all together) over the known commits.
pub fn most(trend: *Trend, pattern: usize) -> u32 {
    var best: u32 = 0
    var commit: usize = 0
    while commit < trend.*.count {
        if trend.*.known[commit] == 1 {
            const value = if pattern >= PATTERNS { totalOf(trend, commit) } else { countOf(trend, commit, @intCast(u8, pattern)) }
            if value > best { best = value }
        }
        commit += 1
    }
    return best
}

// The least of `pattern` (PATTERNS: all together) over the known commits.
pub fn least(trend: *Trend, pattern: usize) -> u32 {
    var best: u32 = 4294967295
    var commit: usize = 0
    while commit < trend.*.count {
        if trend.*.known[commit] == 1 {
            const value = if pattern >= PATTERNS { totalOf(trend, commit) } else { countOf(trend, commit, @intCast(u8, pattern)) }
            if value < best { best = value }
        }
        commit += 1
    }
    return if best == 4294967295 { 0 } else { best }
}

fn parseNumber(text: []const u8, at: *usize) -> u64 {
    var value: u64 = 0
    while at.* < text.length && text[at.*] >= 48 && text[at.*] <= 57 {
        value = value * 10 + @intCast(u64, text[at.*] - 48)
        at.* += 1
    }
    return value
}

// Reads the last `limit` commits of HEAD (first parents) and what the cache
// knows of them.
pub fn load(trend: *Trend, git: *git_module.Git, limit: usize) -> void {
    trend.*.count = 0
    if !git_module.usable(git) { return }
    git_module.begin(git)
    git_module.more(git, "log --first-parent --format='%H %ct' -n ")
    var digits: [20]u8 = undefined
    var length: usize = 0
    var value = if limit > MAX_COMMITS { MAX_COMMITS } else { limit }
    while true {
        digits[length] = @intCast(u8, 48 + value % 10)
        length += 1
        value /= 10
        if value == 0 { break }
    }
    var reversed: [20]u8 = undefined
    var at: usize = 0
    while at < length {
        reversed[at] = digits[length - 1 - at]
        at += 1
    }
    var number: [*]const u8 = undefined
    unsafe { number = @ptrCast([*]const u8, &reversed) }
    git_module.more(git, number[0..length])
    const text = git_module.finish(git)
    // Newest first: count them, then put them oldest first.
    var lines: usize = 0
    at = 0
    while at < text.length {
        if text[at] == 10 { lines += 1 }
        at += 1
    }
    at = 0
    var line: usize = 0
    while at < text.length && line < lines && line < MAX_COMMITS {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        if end - at > HASH + 1 {
            const commit = lines - 1 - line
            var digit: usize = 0
            while digit < HASH {
                trend.*.hash[commit * HASH + digit] = text[at + digit]
                digit += 1
            }
            var time_at = at + HASH + 1
            trend.*.time[commit] = @intCast(u32, parseNumber(text[0..end], &time_at) & 4294967295)
            trend.*.known[commit] = 0
        }
        line += 1
        at = end + 1
    }
    trend.*.count = if lines > MAX_COMMITS { MAX_COMMITS } else { lines }
    readKept(trend, git)
}

fn readKept(trend: *Trend, git: *git_module.Git) -> void {
    trend.*.pathLength = history_module.cacheDirectoryOf(git.*.environment, trend.*.path)
    trend.*.keptLength = 0
    if trend.*.pathLength == 0 { return }
    trend.*.pathLength = append(trend.*.path, trend.*.pathLength, "/workarounds-v1")
    trend.*.path[trend.*.pathLength] = 0
    const file = std.fs.open(trend.*.path, 0, 0)
    if std.fs.isValid(file) {
        while trend.*.keptLength + 65536 <= MAX_KEPT {
            var chunk: [*]u8 = undefined
            unsafe { chunk = @ptrFromInt([*]u8, @intFromPtr(trend.*.kept) + trend.*.keptLength) }
            const got = std.fs.read(file, chunk, 65536)
            if got <= 0 { break }
            trend.*.keptLength += @intCast(usize, got)
        }
        const closed = std.fs.close(file)
    }
    const kept = trend.*.kept[0..trend.*.keptLength]
    var at: usize = 0
    while at < kept.length {
        var end = at
        while end < kept.length && kept[end] != 10 { end += 1 }
        if end - at > HASH + 1 {
            const commit = commitNamed(trend, kept[at..at + HASH])
            if commit < trend.*.count { parseCounts(trend, commit, kept[at + HASH + 1..end]) }
        }
        at = end + 1
    }
}

fn commitNamed(trend: *Trend, name: []const u8) -> usize {
    var commit: usize = 0
    while commit < trend.*.count {
        if index_module.sameBytes(hashOf(trend, commit), name) { return commit }
        commit += 1
    }
    return trend.*.count
}

// "c0 c1 ... c8": the counts of `commit` (known when all nine are there).
fn parseCounts(trend: *Trend, commit: usize, text: []const u8) -> bool {
    var at: usize = 0
    var pattern: usize = 0
    while pattern < PATTERNS {
        while at < text.length && text[at] == 32 { at += 1 }
        if at >= text.length || text[at] < 48 || text[at] > 57 { return false }
        trend.*.counts[commit * PATTERNS + pattern] = @intCast(u32, parseNumber(text, &at) & 4294967295)
        pattern += 1
    }
    trend.*.known[commit] = 1
    return true
}

fn append(into: [*]u8, length: usize, text: []const u8) -> usize {
    var at = length
    for byte in text {
        if at < 4000 {
            into[at] = byte
            at += 1
        }
    }
    return at
}

// Works out the newest commit not known yet (and keeps it); false when
// there is none (or it cannot be done).
pub fn fillNext(trend: *Trend, git: *git_module.Git) -> bool {
    if trend.*.selfLength == 0 { return false }
    var commit = trend.*.count
    while commit > 0 {
        commit -= 1
        if trend.*.known[commit] == 0 {
            fill(trend, git, commit)
            return true
        }
    }
    return false
}

fn fill(trend: *Trend, git: *git_module.Git, commit: usize) -> void {
    git_module.beginShell(git)
    git_module.more(git, "d=$(mktemp -d) || exit 1; git -C ")
    git_module.addQuoted(git, git.*.root[0..git.*.rootLength])
    git_module.more(git, " archive ")
    git_module.more(git, hashOf(trend, commit))
    git_module.more(git, " | tar -x -C \"$d\" && ")
    git_module.addQuoted(git, trend.*.self[0..trend.*.selfLength])
    git_module.more(git, " -C \"$d\" workarounds-count; rm -rf \"$d\"")
    const text = git_module.finish(git)
    var end: usize = 0
    while end < text.length && text[end] != 10 { end += 1 }
    // Not worked out: left as it is (2: not again this time).
    if !parseCounts(trend, commit, text[0..end]) {
        trend.*.known[commit] = 2
        return
    }
    if trend.*.pathLength == 0 { return }
    // O_WRONLY | O_CREAT | O_APPEND
    const file = std.fs.open(trend.*.path, 1089, 420)
    if !std.fs.isValid(file) { return }
    var line: [128]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length: usize = 0
    for byte in hashOf(trend, commit) {
        bytes[length] = byte
        length += 1
    }
    bytes[length] = 32
    length += 1
    for byte in text[0..end] {
        if length < 120 {
            bytes[length] = byte
            length += 1
        }
    }
    bytes[length] = 10
    length += 1
    const wrote = std.fs.writeAllBytes(file, bytes, length)
    const closed = std.fs.close(file)
}
