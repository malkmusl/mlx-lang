// Where the programs spend their time: the profiles std.diagnostics writes
// to $XDG_STATE_HOME/mlx/profiles (~/.local/state/mlx/profiles), the
// processor's (mlx-profile) and the GPU's (std.gpu), put on the
// declarations. A profile is
//
//     profile <TAB> program <TAB> seconds since 1970 <TAB> samples <TAB> interval in µs <TAB> processor|gpu
//     self <TAB> total <TAB> path:line:function
//     ...
//
// (samples in the function itself, and with what it called; the function
// named as the compiler's symbol table names it; for the GPU, the
// microseconds of the GPU work the function recorded). Of each program the
// newest profile of each source counts; the samples of several programs
// add up. A profile without the last field is the processor's.
//
//     var profiles: profiles_module.Profiles = undefined
//     profiles_module.init(&profiles, allocator)
//     profiles_module.load(&profiles, index, environment)
const std = @import("std")
const xdg = @import("std.xdg")
const index_module = @import("./index.mlx")
const crashes_module = @import("./crashes.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

pub const MAX_PROFILES: usize = 256
const MAX_TEXT: usize = 16777216

pub const Profiles = struct {
    index: *Index
    allocator: Allocator
    // Per symbol: samples in it, and with what it called.
    self: [*]u32
    total: [*]u32
    capacity: usize
    // The profiles read: program name (in names), time, samples.
    count: usize
    nameStart: [256]usize
    nameEnd: [256]usize
    time: [256]u64
    samples: [256]u64
    names: [*]u8
    namesUsed: usize
    // All samples of the profiles counted (for shares).
    allSamples: u64
    // The GPU's: whether a profile is, per symbol its microseconds (in
    // the work it recorded, and with what it called), and all of them.
    gpu: [256]bool
    gpuSelf: [*]u32
    gpuTotal: [*]u32
    allGpu: u64
    text: [*]u8
    // The directory and the file names in it.
    path: [*]u8
}

pub fn init(profiles: *Profiles, allocator: Allocator) -> void {
    profiles.*.allocator = allocator
    profiles.*.capacity = 0
    profiles.*.count = 0
    profiles.*.names = allocator.alloc(MAX_PROFILES * 128, 16).?
    profiles.*.text = allocator.alloc(MAX_TEXT, 16).?
    profiles.*.path = allocator.alloc(4096, 16).?
}

pub fn selfOf(profiles: *Profiles, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= profiles.*.capacity { return 0 }
    return profiles.*.self[symbol]
}

pub fn totalOf(profiles: *Profiles, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= profiles.*.capacity { return 0 }
    return profiles.*.total[symbol]
}

pub fn gpuSelfOf(profiles: *Profiles, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= profiles.*.capacity { return 0 }
    return profiles.*.gpuSelf[symbol]
}

pub fn gpuTotalOf(profiles: *Profiles, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= profiles.*.capacity { return 0 }
    return profiles.*.gpuTotal[symbol]
}

pub fn programName(profiles: *Profiles, profile: usize) -> []const u8 {
    return profiles.*.names[profiles.*.nameStart[profile]..profiles.*.nameEnd[profile]]
}

// The directory: $XDG_STATE_HOME/mlx/profiles, else
// $HOME/.local/state/mlx/profiles (into `into`); its length (0: none).
pub fn directory(environment: [*][*]const u8, into: [*]u8) -> usize {
    return xdg.path(environment, xdg.STATE, "/mlx/profiles", into, 4001)
}

fn append(into: [*]u8, length: usize, text: []const u8) -> usize {
    var at = length
    for byte in text {
        if at < 4000 {
            into[at] = byte
            at += 1
        }
    }
    return at
}

fn parseNumber(text: []const u8, at: *usize) -> u64 {
    var value: u64 = 0
    while at.* < text.length && text[at.*] >= 48 && text[at.*] <= 57 {
        value = value * 10 + @intCast(u64, text[at.*] - 48)
        at.* += 1
    }
    return value
}

// Reads the profiles (the newest of each program) onto the declarations.
pub fn load(profiles: *Profiles, index: *Index, environment: [*][*]const u8) -> void {
    profiles.*.index = index
    profiles.*.count = 0
    profiles.*.namesUsed = 0
    profiles.*.allSamples = 0
    profiles.*.allGpu = 0
    if index.*.symbolCount > profiles.*.capacity {
        const capacity = index.*.symbolCount + index.*.symbolCount / 2 + 1024
        profiles.*.self = profiles.*.allocator.words(capacity)
        profiles.*.total = profiles.*.allocator.words(capacity)
        profiles.*.gpuSelf = profiles.*.allocator.words(capacity)
        profiles.*.gpuTotal = profiles.*.allocator.words(capacity)
        profiles.*.capacity = capacity
    }
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        profiles.*.self[symbol] = 0
        profiles.*.total[symbol] = 0
        profiles.*.gpuSelf[symbol] = 0
        profiles.*.gpuTotal[symbol] = 0
        symbol += 1
    }
    const length = directory(environment, profiles.*.path)
    if length == 0 { return }
    // Two rounds: find the newest profile of each program, then read those.
    readDirectory(profiles, length, false)
    readDirectory(profiles, length, true)
}

fn readDirectory(profiles: *Profiles, length: usize, reading: bool) -> void {
    profiles.*.path[length] = 0
    const handle = std.linux.syscall3(std.linux.SYS_open, @intFromPtr(profiles.*.path), 65536, 0)
    if handle < 0 { return }
    var entries: [8192]u8 = undefined
    const entry_bytes: [*]u8 = &entries
    while true {
        const got = std.linux.syscall3(std.linux.SYS_getdents64, @bitCast(usize, handle), @intFromPtr(entry_bytes), 8192)
        if got <= 0 { break }
        var at: usize = 0
        while at < @bitCast(usize, got) {
            const record_length = @intCast(usize, entry_bytes[at + 16]) | (@intCast(usize, entry_bytes[at + 17]) << 8)
            var name_end = at + 19
            while entry_bytes[name_end] != 0 { name_end += 1 }
            const name = entry_bytes[at + 19..name_end]
            if name.length > 8 && index_module.sameBytes(name[name.length - 8..name.length], ".profile") && length + 1 + name.length < 4000 {
                var full = length
                profiles.*.path[full] = 47
                full += 1
                for byte in name {
                    profiles.*.path[full] = byte
                    full += 1
                }
                profiles.*.path[full] = 0
                readProfile(profiles, reading)
            }
            at += record_length
        }
    }
    std.linux.close(handle)
    profiles.*.path[length] = 0
}

// The profile of `name` from the processor or the GPU (the count: none).
fn profileOf(profiles: *Profiles, name: []const u8, gpu: bool) -> usize {
    var profile: usize = 0
    while profile < profiles.*.count {
        if profiles.*.gpu[profile] == gpu && index_module.sameBytes(programName(profiles, profile), name) { return profile }
        profile += 1
    }
    return profiles.*.count
}

fn readProfile(profiles: *Profiles, reading: bool) -> void {
    const file = std.fs.open(profiles.*.path, 0, 0)
    if !std.fs.isValid(file) { return }
    var length: usize = 0
    while length + 65536 <= MAX_TEXT {
        const chunk: [*]u8 = profiles.*.text + length
        const got = std.fs.read(file, chunk, 65536)
        if got <= 0 { break }
        length += @intCast(usize, got)
        if !reading { break }
    }
    _ = std.fs.close(file)
    const text = profiles.*.text[0..length]
    // The header.
    if length < 9 || !index_module.sameBytes(text[0..8], "profile\t") { return }
    var at: usize = 8
    const name_start = at
    while at < length && text[at] != 9 && text[at] != 10 { at += 1 }
    const name = text[name_start..at]
    at += 1
    const time = parseNumber(text, &at)
    at += 1
    const samples = parseNumber(text, &at)
    // The interval, then where it is from.
    at += 1
    _ = parseNumber(text, &at)
    const gpu = at + 4 <= length && text[at] == 9 && index_module.sameBytes(text[at + 1..at + 4], "gpu")
    const known = profileOf(profiles, name, gpu)
    if !reading {
        if known < profiles.*.count {
            if time > profiles.*.time[known] {
                profiles.*.time[known] = time
                profiles.*.samples[known] = samples
            }
        } else if profiles.*.count < MAX_PROFILES && profiles.*.namesUsed + name.length <= MAX_PROFILES * 128 {
            const profile = profiles.*.count
            profiles.*.nameStart[profile] = profiles.*.namesUsed
            for byte in name {
                profiles.*.names[profiles.*.namesUsed] = byte
                profiles.*.namesUsed += 1
            }
            profiles.*.nameEnd[profile] = profiles.*.namesUsed
            profiles.*.time[profile] = time
            profiles.*.samples[profile] = samples
            profiles.*.gpu[profile] = gpu
            profiles.*.count += 1
        }
        return
    }
    // Only the newest of its program.
    if known >= profiles.*.count || profiles.*.time[known] != time { return }
    if gpu { profiles.*.allGpu += samples } else { profiles.*.allSamples += samples }
    while at < length && text[at] != 10 { at += 1 }
    at += 1
    while at < length {
        var end = at
        while end < length && text[end] != 10 { end += 1 }
        var number = at
        const self_samples = parseNumber(text, &number)
        number += 1
        const total_samples = parseNumber(text, &number)
        number += 1
        if number < end {
            const symbol = crashes_module.declarationOf(profiles.*.index, text[number..end])
            if symbol != NONE && @intCast(usize, symbol) < profiles.*.capacity {
                if gpu {
                    profiles.*.gpuSelf[symbol] += @intCast(u32, self_samples & 4294967295)
                    profiles.*.gpuTotal[symbol] += @intCast(u32, total_samples & 4294967295)
                } else {
                    profiles.*.self[symbol] += @intCast(u32, self_samples & 4294967295)
                    profiles.*.total[symbol] += @intCast(u32, total_samples & 4294967295)
                }
            }
        }
        at = end + 1
    }
}
