// How hard each function is to follow, from its tokens:
//
//   - branches: 1 + every if, while, for, match, && and || (the
//     cyclomatic complexity: the ways through it);
//   - depth: how deep its blocks nest;
//   - size: its tokens;
//   - parameters.
//
// A function is complex (a finding) with 15 branches or more, blocks 6
// deep or more, or 1500 tokens or more. Its score (for ranking and for
// coloring) is branches + 3 per level of depth over 3 + a branch per 100
// tokens.
//
//     var complexity: complexity_module.Complexity = undefined
//     complexity_module.init(&complexity, allocator)
//     complexity_module.run(&complexity, index)
const std = @import("std")
const index_module = @import("./index.mlx")

const Index = index_module.Index
const Kind = index_module.Kind
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

pub const MOST_BRANCHES: u32 = 15
pub const MOST_DEPTH: u32 = 6
pub const MOST_TOKENS: u32 = 1500

pub const Complexity = struct {
    index: *Index
    allocator: Allocator
    // Per symbol (functions; 0 for the rest).
    branches: [*]u32
    depth: [*]u32
    tokens: [*]u32
    parameters: [*]u32
    capacity: usize
}

pub fn init(complexity: *Complexity, allocator: Allocator) -> void {
    complexity.*.allocator = allocator
    complexity.*.capacity = 0
}

pub fn run(complexity: *Complexity, index: *Index) -> void {
    complexity.*.index = index
    if index.*.symbolCount > complexity.*.capacity {
        const capacity = index.*.symbolCount + index.*.symbolCount / 2 + 1024
        complexity.*.branches = complexity.*.allocator.words(capacity)
        complexity.*.depth = complexity.*.allocator.words(capacity)
        complexity.*.tokens = complexity.*.allocator.words(capacity)
        complexity.*.parameters = complexity.*.allocator.words(capacity)
        complexity.*.capacity = capacity
    }
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        complexity.*.branches[symbol] = 0
        complexity.*.depth[symbol] = 0
        complexity.*.tokens[symbol] = 0
        complexity.*.parameters[symbol] = 0
        const value = index_module.symbolAt(index, @intCast(u32, symbol))
        if value.*.kind == index_module.FUNCTION { measure(complexity, @intCast(u32, symbol)) }
        if value.*.kind == index_module.PARAM && value.*.parent != NONE && @intCast(usize, value.*.parent) < index.*.symbolCount { complexity.*.parameters[value.*.parent] += 1 }
        symbol += 1
    }
}

fn measure(complexity: *Complexity, function: u32) -> void {
    const index = complexity.*.index
    const record = index_module.symbolAt(index, function)
    if record.*.node == NONE { return }
    const file = record.*.file
    const declaration = index_module.nodeAt(index, file, @intCast(usize, record.*.node))
    if declaration.tag != index_module.Tag.function_declaration || declaration.rhs == 18446744073709551615 { return }
    const body = index_module.nodeAt(index, file, declaration.rhs)
    if body.tag != index_module.Tag.block || body.endToken >= index_module.fileAt(index, file).*.tokens.length || body.mainToken >= body.endToken { return }
    var branches: u32 = 1
    var depth: u32 = 0
    var deepest: u32 = 0
    var size: u32 = 0
    var token = body.mainToken + 1
    while token < body.endToken {
        const kind = index_module.tokenAt(index, file, token).kind
        if kind == Kind.keyword_if || kind == Kind.keyword_while || kind == Kind.keyword_for || kind == Kind.keyword_match || kind == Kind.ampersand_ampersand || kind == Kind.pipe_pipe { branches += 1 }
        if kind == Kind.left_brace {
            depth += 1
            if depth > deepest { deepest = depth }
        }
        if kind == Kind.right_brace && depth > 0 { depth -= 1 }
        if kind != Kind.statement_end { size += 1 }
        token += 1
    }
    complexity.*.branches[function] = branches
    complexity.*.depth[function] = deepest
    complexity.*.tokens[function] = size
}

pub fn branchesOf(complexity: *Complexity, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= complexity.*.capacity { return 0 }
    return complexity.*.branches[symbol]
}

pub fn depthOf(complexity: *Complexity, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= complexity.*.capacity { return 0 }
    return complexity.*.depth[symbol]
}

pub fn tokensOf(complexity: *Complexity, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= complexity.*.capacity { return 0 }
    return complexity.*.tokens[symbol]
}

pub fn parametersOf(complexity: *Complexity, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= complexity.*.capacity { return 0 }
    return complexity.*.parameters[symbol]
}

pub fn scoreOf(complexity: *Complexity, symbol: u32) -> u32 {
    const branches = branchesOf(complexity, symbol)
    if branches == 0 { return 0 }
    const depth = depthOf(complexity, symbol)
    return branches + (if depth > 3 { (depth - 3) * 3 } else { 0 }) + tokensOf(complexity, symbol) / 100
}

pub fn isComplex(complexity: *Complexity, symbol: u32) -> bool {
    return branchesOf(complexity, symbol) >= MOST_BRANCHES || depthOf(complexity, symbol) >= MOST_DEPTH || tokensOf(complexity, symbol) >= MOST_TOKENS
}
