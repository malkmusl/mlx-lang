// mlx-codemap's workarounds, crashes, names not followed and JSON (part of main.mlx, split from it).
const std = @import("std")
const index_module = @import("./index.mlx")
const out_module = @import("./out.mlx")
const crashes_module = @import("./crashes.mlx")
const workarounds_module = @import("./workarounds.mlx")
const app = @import("./main.mlx")
const cmd_findings_module = @import("./cmd_findings.mlx")

// ---------------------------------------------------------------------------
// Workarounds, crashes, names not followed, JSON

pub fn workarounds(context: *app.Context, prefix: []const u8) -> void {
    const index = context.*.index
    const allocator = std.page_allocator.init()
    var found: workarounds_module.Workarounds = undefined
    workarounds_module.init(&found, allocator)
    workarounds_module.run(&found, index)
    var patterns: [9]u8 = undefined
    var pattern_bytes: [*]u8 = undefined
    unsafe { pattern_bytes = @ptrCast([*]u8, &patterns) }
    const pattern_count = workarounds_module.ranked(&found, pattern_bytes)
    const capacity: usize = 4096
    const symbol_memory = allocator.alloc(capacity * 4, 16).?
    const count_memory = allocator.alloc(capacity * 4, 16).?
    var symbols: [*]u32 = undefined
    var counts: [*]u32 = undefined
    unsafe {
        symbols = @ptrCast([*]u32, symbol_memory)
        counts = @ptrCast([*]u32, count_memory)
    }
    var at: usize = 0
    while at < pattern_count {
        const pattern = patterns[at]
        const count = workarounds_module.declarations(&found, pattern, symbols, counts, capacity)
        var shown: usize = 0
        var places: usize = 0
        var entry: usize = 0
        while entry < count {
            if cmd_findings_module.underPrefix(context, symbols[entry], prefix) { places += @intCast(usize, counts[entry]) }
            entry += 1
        }
        if places > 0 {
            app.say(context, "== ")
            app.sayNumber(context, places)
            app.say(context, "x ")
            app.say(context, workarounds_module.title(pattern, false))
            app.say(context, ". ")
            app.say(context, workarounds_module.missing(pattern, false))
            app.newline(context)
            entry = 0
            while entry < count {
                if cmd_findings_module.underPrefix(context, symbols[entry], prefix) {
                    app.say(context, "   ")
                    app.sayDeclaration(context, symbols[entry])
                    app.say(context, " (")
                    app.sayNumber(context, @intCast(usize, counts[entry]))
                    app.say(context, "x)")
                    app.newline(context)
                    shown += 1
                    // What the comments say.
                    if pattern == workarounds_module.COMMENT {
                        var offsets: [16]u32 = undefined
                        var offset_words: [*]u32 = undefined
                        unsafe { offset_words = @ptrCast([*]u32, &offsets) }
                        const places = workarounds_module.placesIn(&found, pattern, symbols[entry], offset_words, 16)
                        const file = index_module.symbolAt(index, symbols[entry]).*.file
                        var place: usize = 0
                        while place < places {
                            app.say(context, "      ")
                            app.sayPlace(context, file, @intCast(usize, offsets[place]))
                            app.say(context, ": ")
                            app.sayLine(context, file, @intCast(usize, offsets[place]))
                            app.newline(context)
                            place += 1
                        }
                    }
                }
                entry += 1
            }
        }
        at += 1
    }
}

pub fn crashes(context: *app.Context, environment: [*][*]const u8, prefix: []const u8) -> void {
    const index = context.*.index
    var kept: crashes_module.Crashes = undefined
    crashes_module.init(&kept, std.page_allocator.init())
    var path_buffer: [4096]u8 = undefined
    var path: [*]u8 = undefined
    unsafe { path = @ptrCast([*]u8, &path_buffer) }
    const path_length = crashes_module.logPath(environment, path)
    if path_length == 0 {
        app.say(context, "no crash log: neither XDG_STATE_HOME nor HOME is set")
        app.newline(context)
        return
    }
    crashes_module.load(&kept, index, path)
    if kept.count == 0 {
        app.say(context, "no crashes kept in ")
        app.say(context, path[0..path_length])
        app.newline(context)
        return
    }
    // The declarations, most crashes first.
    const order = std.page_allocator.init().alloc(index.*.symbolCount * 4 + 4, 16).?
    var ranked: [*]u32 = undefined
    unsafe { ranked = @ptrCast([*]u32, order) }
    const count = crashes_module.ranked(&kept, ranked)
    var at: usize = 0
    while at < count {
        const symbol = ranked[at]
        if cmd_findings_module.underPrefix(context, symbol, prefix) {
            app.sayDeclaration(context, symbol)
            const stopped = crashes_module.stoppedIn(&kept, symbol)
            const through = crashes_module.wentThrough(&kept, symbol)
            app.say(context, " (")
            if stopped > 0 {
                app.say(context, "crashed here ")
                app.sayNumber(context, @intCast(usize, stopped))
                app.say(context, "x")
                if through > 0 { app.say(context, ", ") }
            }
            if through > 0 {
                app.say(context, "on the way ")
                app.sayNumber(context, @intCast(usize, through))
                app.say(context, "x")
            }
            app.say(context, ")")
            app.newline(context)
        }
        at += 1
    }
    // The crashes, newest first.
    var record = kept.count
    while record > 0 {
        record -= 1
        const first = crashes_module.firstFrame(&kept, @intCast(u32, record))
        var shown = prefix.length == 0
        var frame = first
        while !shown && frame < kept.frameCount && kept.frameRecord[frame] == @intCast(u32, record) {
            if kept.frameSymbol[frame] != app.NONE && cmd_findings_module.underPrefix(context, kept.frameSymbol[frame], prefix) { shown = true }
            frame += 1
        }
        if !shown { continue }
        app.say(context, "== ")
        app.say(context, crashes_module.field(&kept, @intCast(u32, record), 2))
        app.say(context, ": ")
        app.say(context, crashes_module.field(&kept, @intCast(u32, record), 3))
        app.newline(context)
        frame = first
        while frame < kept.frameCount && kept.frameRecord[frame] == @intCast(u32, record) {
            app.say(context, if kept.frameDepth[frame] == 0 { "   at " } else { "   from " })
            if kept.frameSymbol[frame] != app.NONE {
                app.sayDeclaration(context, kept.frameSymbol[frame])
                const where = crashes_module.frameWhere(crashes_module.frameText(&kept, frame))
                if where.length > 0 {
                    app.say(context, " at ")
                    app.say(context, where)
                }
            } else {
                app.say(context, crashes_module.frameText(&kept, frame))
            }
            app.newline(context)
            frame += 1
        }
    }
}

fn isPrimitive(name: []const u8) -> bool {
    if name.length == 0 { return true }
    if name[0] >= 48 && name[0] <= 57 { return true }
    const primitives = "u8 u16 u32 u64 u128 i8 i16 i32 i64 i128 usize isize u5 u6 u3 u4 u1 u2 u7 bool f32 f64 void type anytype noreturn anyopaque comptime_int length _"
    var start: usize = 0
    while start < primitives.length {
        var end = start
        while end < primitives.length && primitives[end] != 32 { end += 1 }
        if index_module.sameBytes(primitives[start..end], name) { return true }
        start = end + 1
    }
    return false
}

pub fn unresolvedIn(context: *app.Context, path: []const u8) -> void {
    const index = context.*.index
    if path.length == 0 {
        var each: usize = 0
        while each < index.*.fileCount {
            unresolvedFile(context, @intCast(u32, each))
            each += 1
        }
        return
    }
    const file = app.findFileSpec(context, path)
    if file == app.NONE {
        app.noMatch(context, path)
        return
    }
    unresolvedFile(context, file)
}

fn unresolvedFile(context: *app.Context, file: u32) -> void {
    const index = context.*.index
    // Identifiers and fields without a symbol (primitive types and
    // lengths left out).
    const record = index_module.fileAt(index, file)
    var node: usize = 0
    while node < record.*.nodes.length {
        const value = index_module.nodeAt(index, file, node)
        const token = index_module.tokenAt(index, file, value.mainToken)
        const name = index_module.sourceOf(index, file)[token.start..token.start + token.length]
        const dotted = value.tag == index_module.Tag.field_expression && value.lhs != 18446744073709551615
        if (value.tag == index_module.Tag.identifier || dotted) && record.*.nodeSymbols[node] == app.NONE && !isPrimitive(name) {
            app.sayPlace(context, file, token.start)
            app.say(context, ": ")
            app.say(context, index_module.sourceOf(index, file)[token.start..token.start + token.length])
            app.newline(context)
        }
        node += 1
    }
}

// The map as JSON: {"files":[paths], "symbols":[[kind, name, file, line,
// column, parent], ...], "uses":[[symbol, file, line, column, use, from],
// ...]}.
pub fn json(context: *app.Context) -> void {
    const index = context.*.index
    const out = context.*.out
    app.say(context, "{\"root\":")
    out_module.json(out, context.*.root[0..context.*.rootLength])
    app.say(context, ",\"files\":[")
    var file: usize = 0
    while file < index.*.fileCount {
        if file > 0 { app.say(context, ",") }
        out_module.json(out, app.shortPath(context, index_module.pathOf(index, @intCast(u32, file))))
        file += 1
    }
    app.say(context, "],\"symbols\":[")
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        if symbol > 0 { app.say(context, ",") }
        app.say(context, "[")
        out_module.json(out, index_module.kindName(record.*.kind))
        app.say(context, ",")
        out_module.json(out, if record.*.kind == index_module.FILE { "" } else { index_module.nameOf(index, id) })
        app.say(context, ",")
        app.sayNumber(context, @intCast(usize, record.*.file))
        app.say(context, ",")
        app.sayNumber(context, index_module.lineOf(index, record.*.file, @intCast(usize, record.*.nameStart)) + 1)
        app.say(context, ",")
        app.sayNumber(context, index_module.columnOf(index, record.*.file, @intCast(usize, record.*.nameStart)) + 1)
        app.say(context, ",")
        if record.*.parent == app.NONE { app.say(context, "-1") } else { app.sayNumber(context, @intCast(usize, record.*.parent)) }
        app.say(context, "]")
        symbol += 1
    }
    app.say(context, "],\"uses\":[")
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if ref > 0 { app.say(context, ",") }
        app.say(context, "[")
        app.sayNumber(context, @intCast(usize, value.*.symbol))
        app.say(context, ",")
        app.sayNumber(context, @intCast(usize, value.*.file))
        app.say(context, ",")
        app.sayNumber(context, index_module.lineOf(index, value.*.file, @intCast(usize, value.*.start)) + 1)
        app.say(context, ",")
        app.sayNumber(context, index_module.columnOf(index, value.*.file, @intCast(usize, value.*.start)) + 1)
        app.say(context, ",")
        out_module.json(out, index_module.useName(value.*.use))
        app.say(context, ",")
        if value.*.from == app.NONE { app.say(context, "-1") } else { app.sayNumber(context, @intCast(usize, value.*.from)) }
        app.say(context, "]")
        ref += 1
    }
    app.say(context, "]}")
    app.newline(context)
}
