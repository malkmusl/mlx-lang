// How often the code changed (from Git): per file, the commits that
// touched it (git log); per declaration, the commits that wrote its lines
// as they are now and when the newest was (git blame, per file). Blame is
// slow on a big tree, so it runs file by file (step) and is kept in
// $XDG_CACHE_HOME/mlx/codemap (~/.cache/mlx/codemap) by the file's text:
// a file that did not change is not asked about again.
//
// Lines not committed yet count as one change, made now.
//
//     var history: history_module.History = undefined
//     history_module.init(&history, allocator, &git)
//     history_module.start(&history, index)
//     while !history_module.step(&history, 50) {}
const std = @import("std")
const index_module = @import("./index.mlx")
const git_module = @import("./git.mlx")
const programs_module = @import("./programs.mlx")

const Index = index_module.Index
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

const MAX_CHUNKS: usize = 65536
const MAX_COMMITS: usize = 1024

pub const History = struct {
    index: *Index
    allocator: Allocator
    git: *git_module.Git
    // Per file: commits that touched it, the newest one's time, and
    // whether its blame is read (0: not yet, 1: read, 2: left out).
    fileCommits: [*]u32
    fileTime: [*]u32
    fileState: [*]u8
    nextFile: usize
    done: usize
    total: usize
    // Per symbol.
    commits: [*]u32
    time: [*]u32
    capacity: usize
    // One file's blame: chunks (first line from 1, lines, commit) and
    // its commits (a key of their name, their time).
    chunkLine: [*]u32
    chunkCount: [*]u32
    chunkCommit: [*]u32
    chunks: usize
    commitKey: [*]u64
    commitTime: [*]u32
    commitsSeen: usize
    marks: [*]u32
    markRound: u32
    // The cache directory (NUL-terminated), and a path in it.
    cache: [*]u8
    cacheLength: usize
    now: u32
}

pub fn init(history: *History, allocator: Allocator, git: *git_module.Git) -> void {
    history.*.allocator = allocator
    history.*.git = git
    history.*.fileCommits = allocator.words(index_module.MAX_FILES)
    history.*.fileTime = allocator.words(index_module.MAX_FILES)
    history.*.fileState = allocator.alloc(index_module.MAX_FILES, 16).?
    history.*.capacity = 0
    history.*.chunkLine = allocator.words(MAX_CHUNKS)
    history.*.chunkCount = allocator.words(MAX_CHUNKS)
    history.*.chunkCommit = allocator.words(MAX_CHUNKS)
    unsafe { history.*.commitKey = @ptrCast([*]u64, allocator.alloc(MAX_COMMITS * 8, 16).?) }
    history.*.commitTime = allocator.words(MAX_COMMITS)
    history.*.marks = allocator.words(MAX_COMMITS)
    history.*.markRound = 0
    history.*.cache = allocator.alloc(4096, 16).?
    history.*.cacheLength = 0
    history.*.total = 0
    history.*.done = 0
}

pub fn commitsOf(history: *History, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= history.*.capacity { return 0 }
    return history.*.commits[symbol]
}

pub fn timeOf(history: *History, symbol: u32) -> u32 {
    if symbol == NONE || @intCast(usize, symbol) >= history.*.capacity { return 0 }
    return history.*.time[symbol]
}

pub fn fileCommitsOf(history: *History, file: u32) -> u32 {
    if file == NONE || @intCast(usize, file) >= history.*.index.*.fileCount { return 0 }
    return history.*.fileCommits[file]
}

pub fn fileTimeOf(history: *History, file: u32) -> u32 {
    if file == NONE || @intCast(usize, file) >= history.*.index.*.fileCount { return 0 }
    return history.*.fileTime[file]
}

// Whether every file's blame is read.
pub fn finished(history: *History) -> bool { return history.*.done >= history.*.total }

fn parseNumber(text: []const u8, at: *usize) -> usize {
    var value: usize = 0
    while at.* < text.length && text[at.*] >= 48 && text[at.*] <= 57 {
        value = value * 10 + @intCast(usize, text[at.*] - 48)
        at.* += 1
    }
    return value
}

// Starts over on `index`: the files' commits from git log, every file's
// blame still to read.
pub fn start(history: *History, index: *Index) -> void {
    history.*.index = index
    if index.*.symbolCount > history.*.capacity {
        const capacity = index.*.symbolCount + index.*.symbolCount / 2 + 1024
        history.*.commits = history.*.allocator.words(capacity)
        history.*.time = history.*.allocator.words(capacity)
        history.*.capacity = capacity
    }
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        history.*.commits[symbol] = 0
        history.*.time[symbol] = 0
        symbol += 1
    }
    var time: [2]usize = [2]usize{ 0, 0 }
    const clock = std.linux.syscall2(228, 0, @intFromPtr(&time))
    history.*.now = @intCast(u32, time[0] & 4294967295)
    history.*.nextFile = 0
    history.*.done = 0
    history.*.total = 0
    var file: usize = 0
    while file < index.*.fileCount {
        history.*.fileCommits[file] = 0
        history.*.fileTime[file] = 0
        const path = index_module.pathOf(index, @intCast(u32, file))
        history.*.fileState[file] = if contains(path, "/generated/") { 2 } else { 0 }
        if history.*.fileState[file] == 0 { history.*.total += 1 }
        file += 1
    }
    if !git_module.usable(history.*.git) {
        history.*.done = history.*.total
        return
    }
    cacheDirectory(history)
    // Each commit: a line with \x01 and its time, then the paths it touched.
    const log = git_module.run(history.*.git, "log --relative --format=%x01%ct --name-only")
    var at: usize = 0
    var commit_time: u32 = 0
    while at < log.length {
        var end = at
        while end < log.length && log[end] != 10 { end += 1 }
        if end > at && log[at] == 1 {
            var number = at + 1
            commit_time = @intCast(u32, parseNumber(log, &number) & 4294967295)
        } else if end > at {
            const found = programs_module.fileOfRelative(index, log[at..end])
            if found != NONE {
                history.*.fileCommits[found] += 1
                if commit_time > history.*.fileTime[found] { history.*.fileTime[found] = commit_time }
            }
        }
        at = end + 1
    }
}

fn contains(text: []const u8, part: []const u8) -> bool {
    if part.length > text.length { return false }
    var at: usize = 0
    while at + part.length <= text.length {
        if index_module.sameBytes(text[at..at + part.length], part) { return true }
        at += 1
    }
    return false
}

// Reads blames for about `budget` milliseconds; true once all are read.
pub fn step(history: *History, budget: usize) -> bool {
    const index = history.*.index
    const started = std.time.milliseconds()
    while history.*.nextFile < index.*.fileCount {
        const file = history.*.nextFile
        history.*.nextFile += 1
        if history.*.fileState[file] == 0 {
            blameFile(history, @intCast(u32, file))
            history.*.fileState[file] = 1
            history.*.done += 1
            if std.time.milliseconds() >= started + budget { break }
        }
    }
    if history.*.nextFile >= index.*.fileCount { history.*.done = history.*.total }
    return finished(history)
}

// ---------------------------------------------------------------------------
// One file

fn blameFile(history: *History, file: u32) -> void {
    const index = history.*.index
    const source = index_module.sourceOf(index, file)
    var key: u64 = 14695981039346656037
    for byte in source {
        key = (key ^ @intCast(u64, byte)) *% 1099511628211
    }
    key = key ^ @intCast(u64, source.length)
    // (Slices are not assigned again: the compiler keeps the old length.)
    const cached = readCache(history, key)
    if cached.length > 0 {
        parseBlame(history, cached)
    } else {
        git_module.begin(history.*.git)
        git_module.more(history.*.git, "blame --incremental -- ")
        git_module.addQuoted(history.*.git, programs_module.relativePath(index, file))
        const blame = git_module.finish(history.*.git)
        writeCache(history, key, blame)
        parseBlame(history, blame)
    }
    assign(history, file)
}

fn hexValue(byte: u8) -> u64 { return @intCast(u64, std.text.hexValue(byte)) }

// The chunk lines (40 hex digits, then the line it came from, the line it
// is on, and how many) and each commit's author-time.
fn parseBlame(history: *History, text: []const u8) -> void {
    history.*.chunks = 0
    history.*.commitsSeen = 0
    var current: usize = MAX_COMMITS
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        if end - at > 41 && text[at + 40] == 32 && hexValue(text[at]) < 16 && hexValue(text[at + 39]) < 16 {
            var name: u64 = 0
            var digit: usize = 0
            while digit < 16 {
                name = (name << 4) | hexValue(text[at + digit])
                digit += 1
            }
            // Its commit (new ones get the time of now until told).
            current = 0
            while current < history.*.commitsSeen && history.*.commitKey[current] != name { current += 1 }
            if current == history.*.commitsSeen && current < MAX_COMMITS {
                history.*.commitKey[current] = name
                history.*.commitTime[current] = history.*.now
                history.*.commitsSeen += 1
            }
            var number = at + 41
            const original = parseNumber(text, &number)
            number += 1
            const final = parseNumber(text, &number)
            number += 1
            const count = parseNumber(text, &number)
            if history.*.chunks < MAX_CHUNKS && current < MAX_COMMITS {
                history.*.chunkLine[history.*.chunks] = @intCast(u32, final)
                history.*.chunkCount[history.*.chunks] = @intCast(u32, count)
                history.*.chunkCommit[history.*.chunks] = @intCast(u32, current)
                history.*.chunks += 1
            }
        } else if end - at > 12 && index_module.sameBytes(text[at..at + 12], "author-time ") && current < history.*.commitsSeen {
            var number = at + 12
            history.*.commitTime[current] = @intCast(u32, parseNumber(text, &number) & 4294967295)
        }
        at = end + 1
    }
}

// Puts the blame on the file's declarations: the commits among their
// lines, and the newest.
fn assign(history: *History, file: u32) -> void {
    const index = history.*.index
    assignIn(history, index_module.fileAt(index, file).*.symbol, 0)
}

fn assignIn(history: *History, container: u32, depth: usize) -> void {
    if container == NONE || depth > 3 { return }
    const index = history.*.index
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != NONE {
        const value = index_module.symbolAt(index, child)
        const kind = value.*.kind
        if kind == index_module.FUNCTION || kind == index_module.TEST || kind == index_module.CONST || kind == index_module.VAR || kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION {
            const first_offset = if value.*.firstToken != NONE { index_module.tokenAt(index, value.*.file, @intCast(usize, value.*.firstToken)).start } else { @intCast(usize, value.*.nameStart) }
            const first = index_module.lineOf(index, value.*.file, first_offset) + 1
            const last = index_module.lineOf(index, value.*.file, index_module.declarationEnd(index, child)) + 1
            count(history, child, first, last)
            if kind != index_module.FUNCTION && kind != index_module.TEST { assignIn(history, child, depth + 1) }
        }
        child = value.*.nextSibling
    }
}

fn count(history: *History, symbol: u32, first: usize, last: usize) -> void {
    history.*.markRound += 1
    const round = history.*.markRound
    var commits: u32 = 0
    var newest: u32 = 0
    var chunk: usize = 0
    while chunk < history.*.chunks {
        const start = @intCast(usize, history.*.chunkLine[chunk])
        const end = start + @intCast(usize, history.*.chunkCount[chunk])
        if start <= last && end > first {
            const commit = @intCast(usize, history.*.chunkCommit[chunk])
            if history.*.marks[commit] != round {
                history.*.marks[commit] = round
                commits += 1
                if history.*.commitTime[commit] > newest { newest = history.*.commitTime[commit] }
            }
        }
        chunk += 1
    }
    history.*.commits[symbol] = commits
    history.*.time[symbol] = newest
}

// ---------------------------------------------------------------------------
// The cache

fn cacheDirectory(history: *History) -> void {
    history.*.cacheLength = cacheDirectoryOf(history.*.git.*.environment, history.*.cache)
}

// The code map's cache directory, made if it is not there:
// $XDG_CACHE_HOME/mlx/codemap, else $HOME/.cache/mlx/codemap (into `into`,
// NUL-terminated); its length (0: none).
pub fn cacheDirectoryOf(environment: [*][*]const u8, into: [*]u8) -> usize {
    var length: usize = 0
    const cache = variable(environment, "XDG_CACHE_HOME")
    if cache.length > 0 && cache[0] == 47 {
        length = append(into, 0, cache)
    } else {
        const home = variable(environment, "HOME")
        if home.length == 0 { return 0 }
        length = append(into, 0, home)
        length = append(into, length, "/.cache")
    }
    makeDirectory(into, length)
    length = append(into, length, "/mlx")
    makeDirectory(into, length)
    length = append(into, length, "/codemap")
    makeDirectory(into, length)
    into[length] = 0
    return length
}

fn makeDirectory(path: [*]u8, length: usize) -> void {
    path[length] = 0
    const made = std.linux.syscall2(83, @intFromPtr(path), 493)
}

fn append(into: [*]u8, length: usize, text: []const u8) -> usize {
    var at = length
    for byte in text {
        if at < 4000 {
            into[at] = byte
            at += 1
        }
    }
    return at
}

fn variable(environment: [*][*]const u8, name: []const u8) -> []const u8 {
    var entry: usize = 0
    while @intFromPtr(environment[entry]) != 0 {
        const text = environment[entry]
        var matches = true
        var length: usize = 0
        for byte in name {
            if matches && text[length] != byte { matches = false }
            if matches { length += 1 }
        }
        if matches && text[length] == 61 {
            var end = length + 1
            while text[end] != 0 { end += 1 }
            return text[length + 1..end]
        }
        entry += 1
    }
    return ""
}

// The path of the cache entry for `key` into the cache buffer (after the
// directory); its length.
fn entryPath(history: *History, key: u64) -> usize {
    var length = append(history.*.cache, history.*.cacheLength, "/blame-")
    var shift: u64 = 60
    while true {
        const digit = @intCast(u8, (key >> shift) & 15)
        history.*.cache[length] = if digit < 10 { 48 + digit } else { 87 + digit }
        length += 1
        if shift == 0 { break }
        shift -= 4
    }
    history.*.cache[length] = 0
    return length
}

fn readCache(history: *History, key: u64) -> []const u8 {
    if history.*.cacheLength == 0 { return "" }
    const length = entryPath(history, key)
    const file = std.fs.open(history.*.cache, 0, 0)
    if !std.fs.isValid(file) { return "" }
    const git = history.*.git
    git.*.outputLength = 0
    while git.*.outputLength + 65536 <= git.*.capacity {
        var chunk: [*]u8 = undefined
        unsafe { chunk = @ptrFromInt([*]u8, @intFromPtr(git.*.output) + git.*.outputLength) }
        const got = std.fs.read(file, chunk, 65536)
        if got <= 0 { break }
        git.*.outputLength += @intCast(usize, got)
    }
    const closed = std.fs.close(file)
    // An empty entry stands for an empty blame (still a hit).
    if git.*.outputLength == 0 { return "\n" }
    return git.*.output[0..git.*.outputLength]
}

// Keeps only what parseBlame reads: the chunk lines and author-time.
fn writeCache(history: *History, key: u64, text: []const u8) -> void {
    if history.*.cacheLength == 0 { return }
    const length = entryPath(history, key)
    const file = std.fs.open(history.*.cache, 577, 420)
    if !std.fs.isValid(file) { return }
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const keep = (end - at > 41 && text[at + 40] == 32) || (end - at > 12 && index_module.sameBytes(text[at..at + 12], "author-time "))
        if keep {
            var line: [*]const u8 = undefined
            unsafe { line = @ptrFromInt([*]const u8, @intFromPtr(@ptrCast([*]const u8, text)) + at) }
            const wrote = std.fs.writeAllBytes(file, line, if end < text.length { end + 1 - at } else { end - at })
        }
        at = end + 1
    }
    const closed = std.fs.close(file)
}
