// Asking Git (for the history of the code): runs `git -C ROOT ...` through
// /bin/sh and reads what it writes, or runs a command in the background
// (spawn, exited). No libc: std.spawn (vfork, a pipe, execve).
//
//     var git: git_module.Git = undefined
//     git_module.init(&git, allocator, root, environment)
//     const text = git_module.run(&git, "log --format=%ct --name-only")
const std = @import("std")
const spawn_module = @import("std.spawn")

pub const Allocator = std.allocator.Allocator

// The most a command may write (what is more is cut).
pub const MOST_OUTPUT: usize = 268435456

pub const Git = struct {
    allocator: Allocator
    environment: [*][*]const u8
    // The command line being made (NUL-terminated for sh -c).
    command: [*]u8
    commandLength: usize
    root: [*]u8
    rootLength: usize
    // What the last command wrote.
    output: [*]u8
    outputLength: usize
    capacity: usize
    // Whether the root is a Git work tree (asked once).
    checked: bool
    usable: bool
    // How the last command ended (its exit status; 255: it did not start).
    status: u8
}

pub fn init(git: *Git, allocator: Allocator, root: []const u8, environment: [*][*]const u8) -> void {
    git.*.allocator = allocator
    git.*.environment = environment
    git.*.command = allocator.alloc(65536, 16).?
    git.*.root = allocator.alloc(4096, 16).?
    git.*.rootLength = 0
    for byte in root {
        if git.*.rootLength < 4000 {
            git.*.root[git.*.rootLength] = byte
            git.*.rootLength += 1
        }
    }
    git.*.capacity = 1048576
    git.*.output = allocator.alloc(git.*.capacity, 16).?
    git.*.outputLength = 0
    git.*.checked = false
    git.*.usable = false
    git.*.status = 255
}

// Whether Git is there and the root is in a work tree.
pub fn usable(git: *Git) -> bool {
    if !git.*.checked {
        git.*.checked = true
        const answer = run(git, "rev-parse --is-inside-work-tree")
        git.*.usable = answer.length >= 4 && answer[0] == 116
    }
    return git.*.usable
}

fn add(git: *Git, text: []const u8) -> void {
    for byte in text {
        if git.*.commandLength < 65000 {
            git.*.command[git.*.commandLength] = byte
            git.*.commandLength += 1
        }
    }
}

// `text` in single quotes for the shell.
pub fn addQuoted(git: *Git, text: []const u8) -> void {
    add(git, "'")
    for byte in text {
        if byte == 39 { add(git, "'\\''") } else if git.*.commandLength < 65000 {
            git.*.command[git.*.commandLength] = byte
            git.*.commandLength += 1
        }
    }
    add(git, "'")
}

// Starts a command: `git -C ROOT ` (the rest follows with more/quoted).
pub fn begin(git: *Git) -> void {
    git.*.commandLength = 0
    add(git, "exec git -C ")
    addQuoted(git, git.*.root[0..git.*.rootLength])
    add(git, " ")
}

pub fn more(git: *Git, text: []const u8) -> void { add(git, text) }

// Starts a command that is not git's (the rest follows with more/quoted).
pub fn beginShell(git: *Git) -> void {
    git.*.commandLength = 0
}

// Runs `git -C ROOT arguments` (arguments as the shell reads them);
// what it wrote to its output (its errors go nowhere).
pub fn run(git: *Git, arguments: []const u8) -> []const u8 {
    begin(git)
    add(git, arguments)
    return finish(git)
}

// `sh -c` with the command made (NUL-terminated), vforked: the child only
// runs execve, and the parent's memory is big (copying its page tables
// for each git command would cost more than git).
fn shell(git: *Git, arguments: *[4][*]const u8) -> spawn_module.Options {
    unsafe {
        arguments.*[0] = @ptrCast([*]const u8, "/bin/sh")
        arguments.*[1] = @ptrCast([*]const u8, "-c")
        arguments.*[2] = @ptrCast([*]const u8, git.*.command)
        arguments.*[3] = @ptrFromInt([*]const u8, 0)
        var options = spawn_module.options(arguments.*[0], @ptrCast([*][*]const u8, arguments), git.*.environment)
        options.shareMemory = true
        return options
    }
}

// Runs the command made with begin, more and addQuoted.
pub fn finish(git: *Git) -> []const u8 {
    add(git, " 2>/dev/null")
    git.*.command[git.*.commandLength] = 0
    git.*.outputLength = 0
    var arguments: [4][*]const u8 = undefined
    var options = shell(git, &arguments)
    var reading: isize = -1
    const child = spawn_module.startReading(&options, false, false, &reading)
    if child < 0 { return git.*.output[0..0] }
    while true {
        if git.*.outputLength + 65536 > git.*.capacity && git.*.capacity < MOST_OUTPUT {
            const bigger = git.*.capacity * 2
            const memory = git.*.allocator.alloc(bigger, 16)
            if memory == null { break }
            var at: usize = 0
            while at < git.*.outputLength {
                memory.?[at] = git.*.output[at]
                at += 1
            }
            git.*.allocator.free(git.*.output, git.*.capacity, 16)
            git.*.output = memory.?
            git.*.capacity = bigger
        }
        if git.*.outputLength + 65536 > git.*.capacity { break }
        const got = std.linux.read(reading, git.*.output + git.*.outputLength, 65536)
        if got <= 0 { break }
        git.*.outputLength += @bitCast(usize, got)
    }
    std.linux.close(reading)
    var status: usize = 0
    _ = std.linux.process.waitProcess(child, &status, 0)
    // Exited: its code; anything else is 255.
    git.*.status = if status & 127 == 0 { @intCast(u8, (status >> 8) & 255) } else { 255 }
    return git.*.output[0..git.*.outputLength]
}

// Starts the command made with begin, more and addQuoted in the
// background (what it writes goes nowhere); its process (0: not started).
// exited says when it is done.
pub fn spawn(git: *Git) -> isize {
    add(git, " > /dev/null 2>&1 < /dev/null")
    git.*.command[git.*.commandLength] = 0
    var arguments: [4][*]const u8 = undefined
    var options = shell(git, &arguments)
    const child = spawn_module.start(&options)
    return if child > 0 { child } else { 0 }
}

// Whether a process spawn started has ended (it is reaped then).
pub fn exited(process: isize) -> bool {
    if process <= 0 { return true }
    var status: usize = 0
    return std.linux.process.waitProcess(process, &status, std.linux.WNOHANG) != 0
}
