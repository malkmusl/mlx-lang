// What the code index says about the code base as a whole, for making it
// smaller and cleaner (mlx-codemap's findings, MLX Observatory's panel):
//
//   - copies: functions whose bodies are the same, token for token
//     (exact), or the same but for the names of their own parameters and
//     locals and the values of literals (shape: one generic function could
//     serve them all);
//   - names written again: functions of the same name declared in several
//     files (helpers each file has its own of);
//   - unused: declarations nothing uses.
//
// Generated code (a path with /generated/ in it) is left out: it repeats
// by design.
//
//     var analysis: analysis.Analysis = undefined
//     analysis.init(&analysis, allocator)
//     analysis.run(&analysis, index)
//     analysis.groupCount(&analysis, analysis.COPIES) ...
const std = @import("std")
const index_module = @import("./index.mlx")
const aggregates = @import("./aggregates.mlx")

const Index = index_module.Index
const Kind = index_module.Kind
const NONE = index_module.NONE
pub const Allocator = std.allocator.Allocator

// Kinds of groups.
pub const COPIES: u8 = 0
pub const SHAPES: u8 = 1
pub const NAMES: u8 = 2

// A body shorter than this many tokens is not counted as a copy.
pub const SMALLEST_BODY: u32 = 24

pub const Analysis = struct {
    index: *Index
    allocator: Allocator
    // Per symbol: how often it is used, its body's tokens and hashes.
    uses: [*]u32
    bodyTokens: [*]u32
    exact: [*]u64
    shape: [*]u64
    // Groups of each kind: members (symbols) in runs, where each group's
    // run starts, how many groups; per symbol its group of each kind.
    members: [3][*]u32
    memberCount: [3]usize
    starts: [3][*]u32
    groups: [3]usize
    groupOf: [3][*]u32
    // Unused declarations.
    unused: [*]u32
    unusedCount: usize
    keys: [*]u64
    scratch: [*]u64
}

fn allocateLongs(allocator: Allocator, count: usize) -> [*]u64 {
    unsafe { return @ptrCast([*]u64, allocator.alloc(count * 8 + 8, 16).?) }
}

fn isLocal(kind: u8) -> bool { return kind == index_module.PARAM || kind == index_module.LOCAL_CONST || kind == index_module.LOCAL_VAR || kind == index_module.CAPTURE }

pub fn isGenerated(index: *Index, file: u32) -> bool {
    const path = index_module.pathOf(index, file)
    const part = "/generated/"
    var at: usize = 0
    while at + part.length <= path.length {
        if index_module.sameBytes(path[at..at + part.length], part) { return true }
        at += 1
    }
    return false
}

// FNV-1a, a word at a time.
fn mix(hash: u64, value: u64) -> u64 {
    var result = hash
    var rest = value
    var step: usize = 0
    while step < 8 {
        result = (result ^ (rest & 255)) *% 1099511628211
        rest = rest >> 8
        step += 1
    }
    return result
}

fn mixBytes(hash: u64, bytes: []const u8) -> u64 {
    var result = hash
    for byte in bytes { result = (result ^ @intCast(u64, byte)) *% 1099511628211 }
    return result
}

// A function's body: its hashes (exact and by shape) and its size.
fn hashBody(analysis: *Analysis, function: u32) -> void {
    const index = analysis.*.index
    const record = index_module.symbolAt(index, function)
    analysis.*.bodyTokens[@intCast(usize, function)] = 0
    if record.*.node == NONE { return }
    const file = record.*.file
    const declaration = index_module.nodeAt(index, file, @intCast(usize, record.*.node))
    if declaration.tag != index_module.Tag.function_declaration || declaration.rhs == 18446744073709551615 { return }
    const body = index_module.nodeAt(index, file, declaration.rhs)
    if body.tag != index_module.Tag.block || body.endToken >= index_module.fileAt(index, file).*.tokens.length || body.mainToken >= body.endToken { return }
    const source = index_module.sourceOf(index, file)
    var exact: u64 = 14695981039346656037
    var shape: u64 = 14695981039346656037
    // Its own names, numbered as they come.
    var locals: [64]u32 = undefined
    var local_count: usize = 0
    var token = body.mainToken + 1
    var size: u32 = 0
    while token < body.endToken {
        const value = index_module.tokenAt(index, file, token)
        const kind = @intCast(u64, @intFromEnum(value.kind))
        exact = mix(exact, kind)
        shape = mix(shape, kind)
        if value.kind == Kind.identifier || value.kind == Kind.integer || value.kind == Kind.float || value.kind == Kind.string || value.kind == Kind.character || value.kind == Kind.byte_string {
            exact = mixBytes(exact, source[value.start..value.start + value.length])
        }
        if value.kind == Kind.identifier {
            const ref = index_module.refAtOffset(index, file, value.start)
            var symbol = NONE
            if ref != index_module.MAX_REFS && @intCast(usize, index_module.refAt(index, ref).*.start) == value.start { symbol = index_module.refAt(index, ref).*.symbol }
            if symbol != NONE && isLocal(index_module.symbolAt(index, symbol).*.kind) {
                var number: usize = 0
                while number < local_count && locals[number] != symbol { number += 1 }
                if number == local_count && local_count < 64 {
                    locals[local_count] = symbol
                    local_count += 1
                }
                shape = mix(shape, 1000000 + @intCast(u64, number))
            } else if symbol != NONE {
                shape = mix(shape, @intCast(u64, symbol))
            } else {
                shape = mixBytes(shape, source[value.start..value.start + value.length])
            }
        }
        if value.kind != Kind.statement_end { size += 1 }
        token += 1
    }
    analysis.*.bodyTokens[@intCast(usize, function)] = size
    analysis.*.exact[@intCast(usize, function)] = exact
    analysis.*.shape[@intCast(usize, function)] = shape
}

fn sortKeys(analysis: *Analysis, count: usize) -> void {
    var source = analysis.*.keys
    var target = analysis.*.scratch
    var width: usize = 1
    while width < count {
        var low: usize = 0
        while low < count {
            const middle = if low + width < count { low + width } else { count }
            const high = if low + width * 2 < count { low + width * 2 } else { count }
            var left = low
            var right = middle
            var out = low
            while out < high {
                if left < middle && (right >= high || source[left] <= source[right]) {
                    target[out] = source[left]
                    left += 1
                } else {
                    target[out] = source[right]
                    right += 1
                }
                out += 1
            }
            low = high
        }
        const swap = source
        source = target
        target = swap
        width = width * 2
    }
    if @intFromPtr(source) != @intFromPtr(analysis.*.keys) {
        var at: usize = 0
        while at < count {
            analysis.*.keys[at] = source[at]
            at += 1
        }
    }
}

// Groups of `kind` from the keys (key: hash in the upper 43 bits, the
// symbol in the lower 21), sorted: runs of the same hash with at least
// two members (from two files, for names).
fn groupKeys(analysis: *Analysis, group_kind: u8, count: usize) -> void {
    const index = analysis.*.index
    const kind = @intCast(usize, group_kind)
    sortKeys(analysis, count)
    analysis.*.groups[kind] = 0
    analysis.*.memberCount[kind] = 0
    var at: usize = 0
    while at < count {
        var end = at + 1
        while end < count && (analysis.*.keys[end] >> 21) == (analysis.*.keys[at] >> 21) { end += 1 }
        var wanted = end - at >= 2
        if wanted && group_kind == NAMES {
            // Declared in more than one file.
            const first_file = index_module.symbolAt(index, @intCast(u32, analysis.*.keys[at] & 2097151)).*.file
            var other = false
            var look = at + 1
            while look < end {
                if index_module.symbolAt(index, @intCast(u32, analysis.*.keys[look] & 2097151)).*.file != first_file { other = true }
                look += 1
            }
            wanted = other
        }
        if wanted && group_kind == SHAPES {
            // Not a group of exact copies again.
            const first = @intCast(usize, analysis.*.keys[at] & 2097151)
            var all_same = true
            var look = at + 1
            while look < end {
                if analysis.*.exact[@intCast(usize, analysis.*.keys[look] & 2097151)] != analysis.*.exact[first] { all_same = false }
                look += 1
            }
            wanted = !all_same
        }
        if wanted {
            const group = analysis.*.groups[kind]
            analysis.*.starts[kind][group] = @intCast(u32, analysis.*.memberCount[kind])
            var member = at
            while member < end {
                const symbol = @intCast(u32, analysis.*.keys[member] & 2097151)
                analysis.*.members[kind][analysis.*.memberCount[kind]] = symbol
                analysis.*.memberCount[kind] += 1
                analysis.*.groupOf[kind][@intCast(usize, symbol)] = @intCast(u32, group)
                member += 1
            }
            analysis.*.groups[kind] += 1
        }
        at = end
    }
    analysis.*.starts[kind][analysis.*.groups[kind]] = @intCast(u32, analysis.*.memberCount[kind])
}

fn countable(index: *Index, symbol: u32) -> bool {
    const record = index_module.symbolAt(index, symbol)
    const kind = record.*.kind
    return kind == index_module.FUNCTION && record.*.nameLength > 0 && !isGenerated(index, record.*.file)
}

// Room for the largest index (mapped as it is used).
pub fn init(analysis: *Analysis, allocator: Allocator) -> void {
    analysis.*.allocator = allocator
    const symbols = index_module.MAX_SYMBOLS
    analysis.*.uses = allocator.words(symbols)
    analysis.*.bodyTokens = allocator.words(symbols)
    analysis.*.exact = allocateLongs(allocator, symbols)
    analysis.*.shape = allocateLongs(allocator, symbols)
    analysis.*.keys = allocateLongs(allocator, symbols)
    analysis.*.scratch = allocateLongs(allocator, symbols)
    analysis.*.unused = allocator.words(symbols)
    var kind: usize = 0
    while kind < 3 {
        analysis.*.members[kind] = allocator.words(symbols)
        analysis.*.starts[kind] = allocator.words(symbols + 1)
        analysis.*.groupOf[kind] = allocator.words(symbols)
        analysis.*.groups[kind] = 0
        kind += 1
    }
    analysis.*.unusedCount = 0
}

// Works it all out for `index` (built); init first.
pub fn run(analysis: *Analysis, index: *Index) -> void {
    analysis.*.index = index
    const symbols = index.*.symbolCount
    var at: usize = 0
    while at < symbols {
        analysis.*.uses[at] = 0
        analysis.*.bodyTokens[at] = 0
        analysis.*.groupOf[0][at] = NONE
        analysis.*.groupOf[1][at] = NONE
        analysis.*.groupOf[2][at] = NONE
        at += 1
    }
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.use != index_module.USE_DECLARATION && value.*.symbol != NONE { analysis.*.uses[@intCast(usize, value.*.symbol)] += 1 }
        ref += 1
    }
    // Bodies (their tokens and nodes come as temporaries of the
    // compiler's arena: taken back after each).
    const arena = aggregates.find()
    at = 0
    while at < symbols {
        if countable(index, @intCast(u32, at)) {
            const where = aggregates.mark(arena)
            hashBody(analysis, @intCast(u32, at))
            aggregates.reset(arena, where)
        }
        at += 1
    }
    // Copies, then shapes.
    var count: usize = 0
    at = 0
    while at < symbols {
        if analysis.*.bodyTokens[at] >= SMALLEST_BODY {
            analysis.*.keys[count] = ((analysis.*.exact[at] >> 21) << 21) | @intCast(u64, at)
            count += 1
        }
        at += 1
    }
    groupKeys(analysis, COPIES, count)
    count = 0
    at = 0
    while at < symbols {
        if analysis.*.bodyTokens[at] >= SMALLEST_BODY {
            analysis.*.keys[count] = ((analysis.*.shape[at] >> 21) << 21) | @intCast(u64, at)
            count += 1
        }
        at += 1
    }
    groupKeys(analysis, SHAPES, count)
    // Names: functions (not main, not a struct's own) by name.
    count = 0
    at = 0
    while at < symbols {
        const id = @intCast(u32, at)
        if countable(index, id) {
            const record = index_module.symbolAt(index, id)
            const name = index_module.nameOf(index, id)
            const parent_kind = if record.*.parent != NONE { index_module.symbolAt(index, record.*.parent).*.kind } else { index_module.FILE }
            if parent_kind == index_module.FILE && !index_module.sameBytes(name, "main") {
                const hash = mixBytes(14695981039346656037, name)
                analysis.*.keys[count] = ((hash >> 21) << 21) | @intCast(u64, at)
                count += 1
            }
        }
        at += 1
    }
    groupKeys(analysis, NAMES, count)
    // Unused.
    analysis.*.unusedCount = 0
    at = 0
    while at < symbols {
        const id = @intCast(u32, at)
        const record = index_module.symbolAt(index, id)
        const symbol_kind = record.*.kind
        const counted = symbol_kind == index_module.FUNCTION || symbol_kind == index_module.CONST || symbol_kind == index_module.VAR || symbol_kind == index_module.STRUCT || symbol_kind == index_module.ENUM || symbol_kind == index_module.UNION || symbol_kind == index_module.ALIAS || symbol_kind == index_module.IMPORT
        if counted && analysis.*.uses[at] == 0 && record.*.nameLength > 0 && !index_module.sameBytes(index_module.nameOf(index, id), "main") && !isGenerated(index, record.*.file) && record.*.flags & index_module.FLAG_EXTERN == 0 {
            analysis.*.unused[analysis.*.unusedCount] = id
            analysis.*.unusedCount += 1
        }
        at += 1
    }
}

pub fn groupCount(analysis: *Analysis, kind: u8) -> usize { return analysis.*.groups[@intCast(usize, kind)] }

// Group `group` of `kind`: its members.
pub fn groupMembers(analysis: *Analysis, kind: u8, group: usize) -> []const u32 {
    const which = @intCast(usize, kind)
    const start = @intCast(usize, analysis.*.starts[which][group])
    const end = @intCast(usize, analysis.*.starts[which][group + 1])
    return analysis.*.members[which][start..end]
}

// The group of `kind` a symbol is in, NONE when none.
pub fn groupOf(analysis: *Analysis, kind: u8, symbol: u32) -> u32 {
    if symbol == NONE { return NONE }
    return analysis.*.groupOf[@intCast(usize, kind)][@intCast(usize, symbol)]
}

pub fn usesOf(analysis: *Analysis, symbol: u32) -> u32 { return analysis.*.uses[@intCast(usize, symbol)] }

pub fn bodySize(analysis: *Analysis, symbol: u32) -> u32 { return analysis.*.bodyTokens[@intCast(usize, symbol)] }

// How much a group could save: the tokens of all copies but one.
pub fn groupWeight(analysis: *Analysis, kind: u8, group: usize) -> usize {
    const list = groupMembers(analysis, kind, group)
    if list.length < 2 { return 0 }
    return @intCast(usize, analysis.*.bodyTokens[@intCast(usize, list[0])]) * (list.length - 1)
}

// The groups of `kind` by weight, the heaviest first, into order; how
// many.
pub fn ranked(analysis: *Analysis, kind: u8, order: [*]u32) -> usize {
    const count = analysis.*.groups[@intCast(usize, kind)]
    var at: usize = 0
    while at < count {
        const weight = if kind == NAMES { groupMembers(analysis, kind, at).length } else { groupWeight(analysis, kind, at) }
        analysis.*.keys[at] = (@intCast(u64, 4294967295 - weight) << 32) | @intCast(u64, at)
        at += 1
    }
    sortKeys(analysis, count)
    at = 0
    while at < count {
        order[at] = @intCast(u32, analysis.*.keys[at] & 4294967295)
        at += 1
    }
    return count
}
