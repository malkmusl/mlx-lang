// Views kept with the code: codemap.views in the root, a line each,
//
//     # comments and blank lines are left out
//     Crashes in std = in:std/ crashed
//     Changed today = changed
//
// a name, " = ", and a query (tools/codemap/query.mlx). `mlx-codemap query
// @NAME` and the app's search field (@NAME, or the views in the sidebar)
// show one; the app's Ctrl+S keeps the query in the search field as a new
// view; the app's x on a view takes it out again.
//
//     var views: views_module.Views = undefined
//     views_module.load(&views, root)
const std = @import("std")
const index_module = @import("./index.mlx")

pub const MAX_VIEWS: usize = 64
const MAX_TEXT: usize = 65536

pub const Views = struct {
    count: usize
    nameStart: [64]usize
    nameEnd: [64]usize
    queryStart: [64]usize
    queryEnd: [64]usize
    text: [65536]u8
    length: usize
    path: [4096]u8
    pathLength: usize
}

fn bytesOf(views: *Views) -> [*]u8 {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &views.*.text) }
    return bytes
}

fn pathOf(views: *Views) -> [*]u8 {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &views.*.path) }
    return bytes
}

pub fn nameOf(views: *Views, view: usize) -> []const u8 {
    return bytesOf(views)[views.*.nameStart[view]..views.*.nameEnd[view]]
}

pub fn queryOf(views: *Views, view: usize) -> []const u8 {
    return bytesOf(views)[views.*.queryStart[view]..views.*.queryEnd[view]]
}

// The view named `name` (case left aside); count: none.
pub fn find(views: *Views, name: []const u8) -> usize {
    var view: usize = 0
    while view < views.*.count {
        const own = nameOf(views, view)
        if own.length == name.length {
            var same = true
            var at: usize = 0
            while at < own.length {
                if lower(own[at]) != lower(name[at]) { same = false }
                at += 1
            }
            if same { return view }
        }
        view += 1
    }
    return views.*.count
}

fn lower(byte: u8) -> u8 {
    return if byte >= 65 && byte <= 90 { byte + 32 } else { byte }
}

// Reads root/codemap.views (none: no views).
pub fn load(views: *Views, root: []const u8) -> void {
    views.*.count = 0
    views.*.length = 0
    const path = pathOf(views)
    var length: usize = 0
    for byte in root {
        if length < 4000 {
            path[length] = byte
            length += 1
        }
    }
    for byte in "/codemap.views" {
        path[length] = byte
        length += 1
    }
    path[length] = 0
    views.*.pathLength = length
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return }
    const text = bytesOf(views)
    while views.*.length + 4096 <= MAX_TEXT {
        var chunk: [*]u8 = undefined
        unsafe { chunk = @ptrFromInt([*]u8, @intFromPtr(text) + views.*.length) }
        const got = std.fs.read(file, chunk, 4096)
        if got <= 0 { break }
        views.*.length += @intCast(usize, got)
    }
    const closed = std.fs.close(file)
    var at: usize = 0
    while at < views.*.length && views.*.count < MAX_VIEWS {
        var end = at
        while end < views.*.length && text[end] != 10 { end += 1 }
        var start = at
        while start < end && (text[start] == 32 || text[start] == 9) { start += 1 }
        // "NAME = QUERY"
        var equals = start
        while equals + 2 < end && !(text[equals] == 32 && text[equals + 1] == 61 && text[equals + 2] == 32) { equals += 1 }
        if start < end && text[start] != 35 && equals + 3 < end && equals > start {
            var close = end
            while close > equals + 3 && (text[close - 1] == 32 || text[close - 1] == 13) { close -= 1 }
            const view = views.*.count
            views.*.nameStart[view] = start
            views.*.nameEnd[view] = equals
            views.*.queryStart[view] = equals + 3
            views.*.queryEnd[view] = close
            views.*.count += 1
        }
        at = end + 1
    }
}

// Adds a view (to the file too, then reads it again); false when it
// cannot be written.
pub fn add(views: *Views, root: []const u8, name: []const u8, query: []const u8) -> bool {
    load(views, root)
    // O_WRONLY | O_CREAT | O_APPEND
    const file = std.fs.open(pathOf(views), 1089, 420)
    if !std.fs.isValid(file) { return false }
    var line: [2048]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &line) }
    var length: usize = 0
    // A line of its own, also when the file does not end with one.
    if views.*.length > 0 && bytesOf(views)[views.*.length - 1] != 10 {
        bytes[length] = 10
        length += 1
    }
    for byte in name {
        if length < 1000 {
            bytes[length] = byte
            length += 1
        }
    }
    for byte in " = " {
        bytes[length] = byte
        length += 1
    }
    for byte in query {
        if length < 2040 {
            bytes[length] = byte
            length += 1
        }
    }
    bytes[length] = 10
    length += 1
    const ok = std.fs.writeAllBytes(file, bytes, length)
    const closed = std.fs.close(file)
    load(views, root)
    return ok
}

// Takes view `view` out (of the file too: its line; the rest stays as it
// is); false when it cannot be written.
pub fn remove(views: *Views, root: []const u8, view: usize) -> bool {
    load(views, root)
    if view >= views.*.count { return false }
    const text = bytesOf(views)
    var start = views.*.nameStart[view]
    while start > 0 && text[start - 1] != 10 { start -= 1 }
    var end = views.*.queryEnd[view]
    while end < views.*.length && text[end] != 10 { end += 1 }
    if end < views.*.length { end += 1 }
    // O_WRONLY | O_CREAT | O_TRUNC
    const file = std.fs.open(pathOf(views), 577, 420)
    if !std.fs.isValid(file) { return false }
    var ok = std.fs.writeAllBytes(file, text, start)
    if end < views.*.length {
        var rest: [*]u8 = undefined
        unsafe { rest = @ptrFromInt([*]u8, @intFromPtr(text) + end) }
        ok = ok && std.fs.writeAllBytes(file, rest, views.*.length - end)
    }
    const closed = std.fs.close(file)
    load(views, root)
    return ok
}

