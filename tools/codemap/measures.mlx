// What the code map knows of each declaration, measured one way: the
// machine code it became, the commits that wrote it, how hard it is to
// follow, where the time goes, and a risk made of all of them. MLX
// Codemap colors the galaxy by one of these; mlx-codemap and mlx-lsp ask
// for them.
//
// The risk of a function grows with every crash through it (a crash that
// stopped in it counts three times), every workaround in it, every commit
// that wrote it, how complex it is, whether it is a copy, and whether a
// program reaches it that no check does:
//
//     (1 + 3 stopped + through) (1 + workarounds) (1 + commits / 2)
//         (1 + complexity / 10) (1.5 if a copy) (2 if untested) - 1
//
// A function is risky from a risk of 12 on.
const std = @import("std")
const index_module = @import("./index.mlx")
const analysis_module = @import("./analysis.mlx")
const workarounds_module = @import("./workarounds.mlx")
const crashes_module = @import("./crashes.mlx")
const programs_module = @import("./programs.mlx")
const binaries_module = @import("./binaries.mlx")
const complexity_module = @import("./complexity.mlx")
const history_module = @import("./history.mlx")
const profiles_module = @import("./profiles.mlx")

const Index = index_module.Index
const NONE = index_module.NONE

pub const KIND: u8 = 0
pub const SIZE: u8 = 1
pub const CHURN: u8 = 2
pub const COMPLEXITY: u8 = 3
pub const RISK: u8 = 4
pub const HEAT: u8 = 5
pub const METRICS: usize = 6

pub const RISKY: u64 = 12

// The modules measured with (any may be left out: 0).
pub const Measures = struct {
    index: *Index
    analysis: usize
    workarounds: usize
    crashes: usize
    programs: usize
    binaries: usize
    complexity: usize
    history: usize
    profiles: usize
}

pub fn name(metric: u8, german: bool) -> []const u8 {
    if metric == SIZE { return if german { "Maschinencode" } else { "Machine code" } }
    if metric == CHURN { return if german { "Änderungen" } else { "Changes" } }
    if metric == COMPLEXITY { return if german { "Komplexität" } else { "Complexity" } }
    if metric == RISK { return if german { "Risiko" } else { "Risk" } }
    if metric == HEAT { return if german { "Laufzeit" } else { "Run time" } }
    return if german { "Art" } else { "Kind" }
}

// The unit after a value.
pub fn unit(metric: u8, german: bool) -> []const u8 {
    if metric == SIZE { return " B" }
    if metric == CHURN { return if german { " Commits" } else { " commits" } }
    if metric == COMPLEXITY { return "" }
    if metric == HEAT { return if german { " Samples" } else { " samples" } }
    return ""
}

fn analysisOf(measures: *Measures) -> *analysis_module.Analysis {
    unsafe { return @ptrFromInt(*analysis_module.Analysis, measures.*.analysis) }
}

fn workaroundsOf(measures: *Measures) -> *workarounds_module.Workarounds {
    unsafe { return @ptrFromInt(*workarounds_module.Workarounds, measures.*.workarounds) }
}

fn crashesOf(measures: *Measures) -> *crashes_module.Crashes {
    unsafe { return @ptrFromInt(*crashes_module.Crashes, measures.*.crashes) }
}

fn programsOf(measures: *Measures) -> *programs_module.Programs {
    unsafe { return @ptrFromInt(*programs_module.Programs, measures.*.programs) }
}

fn binariesOf(measures: *Measures) -> *binaries_module.Binaries {
    unsafe { return @ptrFromInt(*binaries_module.Binaries, measures.*.binaries) }
}

fn complexityOf(measures: *Measures) -> *complexity_module.Complexity {
    unsafe { return @ptrFromInt(*complexity_module.Complexity, measures.*.complexity) }
}

fn historyOf(measures: *Measures) -> *history_module.History {
    unsafe { return @ptrFromInt(*history_module.History, measures.*.history) }
}

fn profilesOf(measures: *Measures) -> *profiles_module.Profiles {
    unsafe { return @ptrFromInt(*profiles_module.Profiles, measures.*.profiles) }
}

// The value of `metric` for `symbol` (0: none).
pub fn value(measures: *Measures, metric: u8, symbol: u32) -> u64 {
    if symbol == NONE { return 0 }
    if metric == SIZE && measures.*.binaries != 0 { return @intCast(u64, binaries_module.bytesOf(binariesOf(measures), symbol)) }
    if metric == CHURN && measures.*.history != 0 { return @intCast(u64, history_module.commitsOf(historyOf(measures), symbol)) }
    if metric == COMPLEXITY && measures.*.complexity != 0 { return @intCast(u64, complexity_module.scoreOf(complexityOf(measures), symbol)) }
    if metric == RISK { return risk(measures, symbol) }
    if metric == HEAT && measures.*.profiles != 0 { return @intCast(u64, profiles_module.totalOf(profilesOf(measures), symbol)) }
    return 0
}

// The risk of a function (0 for the rest), in tenths above 0 as a whole
// number: see the formula above.
pub fn risk(measures: *Measures, symbol: u32) -> u64 {
    if symbol == NONE || index_module.symbolAt(measures.*.index, symbol).*.kind != index_module.FUNCTION { return 0 }
    // In tenths, multiplied up.
    var tenths: u64 = 10
    if measures.*.crashes != 0 {
        const crashes = crashesOf(measures)
        tenths = tenths * (1 + 3 * @intCast(u64, crashes_module.stoppedIn(crashes, symbol)) + @intCast(u64, crashes_module.wentThrough(crashes, symbol)))
    }
    if measures.*.workarounds != 0 { tenths = tenths * (1 + @intCast(u64, workarounds_module.placesOf(workaroundsOf(measures), symbol))) }
    if measures.*.history != 0 { tenths = tenths * (2 + @intCast(u64, history_module.commitsOf(historyOf(measures), symbol))) / 2 }
    if measures.*.complexity != 0 { tenths = tenths * (10 + @intCast(u64, complexity_module.scoreOf(complexityOf(measures), symbol))) / 10 }
    if measures.*.analysis != 0 {
        const analysis = analysisOf(measures)
        if analysis_module.groupOf(analysis, analysis_module.COPIES, symbol) != NONE || analysis_module.groupOf(analysis, analysis_module.SHAPES, symbol) != NONE { tenths = tenths * 3 / 2 }
    }
    if measures.*.programs != 0 && programs_module.isUntested(programsOf(measures), symbol) { tenths = tenths * 2 }
    if tenths <= 10 { return 0 }
    return (tenths - 10) / 10
}

pub fn isRisky(measures: *Measures, symbol: u32) -> bool { return risk(measures, symbol) >= RISKY }
