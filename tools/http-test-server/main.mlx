// http-test-server: the HTTP/1.1 server of tools/check_webkit_mlx_network.sh,
// on 127.0.0.1 (a port the system picks, written to standard output as a
// line), each connection served by a child process of its own, requests
// on it kept alive. It serves the files of ROOT (Content-Length bodies)
// and these paths of its own:
//
//   /redirect/N        302 to /redirect/N-1, /redirect/0 to /redirected.html
//   /see-other         303 to /echo (a POST then comes back as a GET)
//   /to-scheme         302 to test://page (webcore-dump --scheme test's
//                      internal scheme: the redirect must be refused)
//   /set-cookie        sets "session=abc123; Path=/" and "pref=dark;
//                      Path=/; HttpOnly", then a page
//   /cookies           a plain text body: the request's Cookie header
//   /echo              a page of the request's method, Content-Type and body
//   /json              application/json {"answer": 42, "items": [1, 2, 3]}
//   /user-agent        a page of the request's User-Agent header, and of
//                      navigator.userAgent (its script)
//   /gzip.html         a page sent gzip-compressed
//   /chunked.html      a page sent in chunks
//   /ws                a WebSocket that sends back each message it gets
//                      ("echo: " before a text's), permessage-deflate
//                      when asked for, and answers a close
//   /quit              the server stops
//
//   https: with CA_FILE, a second port (the second line) serves the same
//   over TLS 1.3 (std.tls.server), with a certificate for localhost and
//   127.0.0.1 signed by a test root made at start (certs.mlx), whose PEM
//   goes to CA_FILE.
//
//     http-test-server ROOT [CA_FILE]
const std = @import("std")
const net = @import("std.net")
const message = @import("std.http.message")
const headers = @import("std.http.headers")
const flate = @import("std.flate")
const ws = @import("std.http.websocket")
const deflate = @import("std.http.websocket.deflate")
const tls = @import("std.tls.server")
const certs = @import("./certs.mlx")
const random = @import("std.random")
const process = std.linux.process

// A connection: its socket, and TLS over it when it came to the https
// port.
const Conn = struct {
    fd: isize
    secure: bool
    server: *tls.Server
}

fn connSend(c: *Conn, bytes: []const u8) -> bool {
    if c.*.secure { return tls.send(c.*.server, bytes) }
    return net.send(c.*.fd, bytes)
}

fn connReceive(c: *Conn, into: [*]u8, room: usize) -> isize {
    if c.*.secure { return tls.receive(c.*.server, into, room) }
    return net.receive(c.*.fd, into, room)
}

fn connReadable(c: *Conn, timeoutMs: isize) -> bool {
    if c.*.secure && tls.pending(c.*.server) { return true }
    return net.readable(c.*.fd, timeoutMs)
}

const CAPACITY: usize = 1048576

fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

fn startsWith(a: []const u8, b: []const u8) -> bool { return a.length >= b.length && same(a[0..b.length], b) }

fn endsWith(a: []const u8, b: []const u8) -> bool { return a.length >= b.length && same(a[a.length - b.length..a.length], b) }

const Text = struct {
    bytes: [CAPACITY]u8
    length: usize
}

fn append(context: usize, bytes: []const u8) -> void {
    const t: *Text = unsafe { @ptrFromInt(*Text, context) }
    for byte in bytes {
        if t.*.length < CAPACITY {
            t.*.bytes[t.*.length] = byte
            t.*.length += 1
        }
    }
}

fn sinkOf(t: *Text) -> headers.Sink { return headers.Sink.{ .context = @intFromPtr(t), .write = append } }

fn text(t: *Text) -> []const u8 { return t.*.bytes[0..t.*.length] }

fn putNumber(sink: headers.Sink, value: usize) -> void {
    var digits: [20]u8 = undefined
    var count: usize = 0
    var v = value
    while true {
        digits[19 - count] = @intCast(u8, 48 + v % 10)
        count += 1
        v = v / 10
        if v == 0 { break }
    }
    headers.put(sink, digits[20 - count..20])
}

// A chunk of a chunked body: its length in hex, the bytes.
fn putChunk(sink: headers.Sink, bytes: []const u8) -> void {
    const hex: []const u8 = "0123456789abcdef"
    var digits: [16]u8 = undefined
    var count: usize = 0
    var v = bytes.length
    while true {
        digits[15 - count] = hex[v % 16]
        count += 1
        v = v / 16
        if v == 0 { break }
    }
    headers.put(sink, digits[16 - count..16])
    headers.put(sink, "\r\n")
    headers.put(sink, bytes)
    headers.put(sink, "\r\n")
}

// A response with a Content-Length body.
fn respond(out: *Text, status: u32, phrase: []const u8, extra: []const u8, body: []const u8) -> void {
    out.*.length = 0
    const sink = sinkOf(out)
    message.writeStatusLine(sink, message.Version.http11, status, phrase)
    headers.put(sink, "Content-Length: ")
    putNumber(sink, body.length)
    headers.put(sink, "\r\n")
    headers.put(sink, extra)
    message.writeHeadEnd(sink)
    headers.put(sink, body)
}

fn headerOf(head: []const u8, name: []const u8, folded: []u8, value: *[]const u8) -> bool {
    var it = message.headerLines(head)
    var n: []const u8 = ""
    var v: []const u8 = ""
    while message.nextHeader(&it, &n, &v, folded) {
        if headers.equalsIgnoringCase(n, name) {
            value.* = v
            return true
        }
    }
    return false
}

fn headComplete(data: []const u8, headEnd: usize) -> bool {
    if headEnd < data.length { return true }
    if data.length >= 4 && data[data.length - 4] == 13 && data[data.length - 3] == 10 && data[data.length - 2] == 13 && data[data.length - 1] == 10 { return true }
    return data.length >= 2 && data[data.length - 2] == 10 && data[data.length - 1] == 10
}

fn typeOf(path: []const u8) -> []const u8 {
    if endsWith(path, ".html") { return "text/html; charset=utf-8" }
    if endsWith(path, ".js") { return "text/javascript" }
    if endsWith(path, ".css") { return "text/css" }
    if endsWith(path, ".json") { return "application/json" }
    if endsWith(path, ".png") { return "image/png" }
    return "text/plain"
}

// The file ROOT/PATH into OUT's body; false when there is none.
fn readFile(root: []const u8, path: []const u8, into: *Text) -> bool {
    into.*.length = 0
    if path.length == 0 || path[0] != 47 { return false }
    // (Nothing outside ROOT.)
    var i: usize = 0
    while i + 1 < path.length {
        if path[i] == 46 && path[i + 1] == 46 { return false }
        i += 1
    }
    var name: [4096]u8 = undefined
    var n: usize = 0
    for c in root {
        if n < 4000 {
            name[n] = c
            n += 1
        }
    }
    for c in path {
        if c == 63 { break }
        if n < 4094 {
            name[n] = c
            n += 1
        }
    }
    name[n] = 0
    const file = std.fs.open(unsafe { @ptrCast([*]const u8, &name) }, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(file) { return false }
    while into.*.length < CAPACITY {
        const got = std.fs.read(file, unsafe { @ptrCast([*]u8, &into.*.bytes) + into.*.length }, CAPACITY - into.*.length)
        if got <= 0 { break }
        into.*.length += @intCast(usize, got)
    }
    _ = std.fs.close(file)
    return true
}

const PAGE_HEAD: []const u8 = "<!DOCTYPE html><html><head><title>"

// A frame to the client (unmasked), compressed when the extension is on.
fn sendFrame(c: *Conn, extension: *deflate.Extension, opcode: u8, payload: []const u8) -> bool {
    var first: u8 = 0x80 | opcode
    var compressed: deflate.Bytes = undefined
    if deflate.outgoing(extension, &first, payload, &compressed) != deflate.Error.none { return false }
    const body = if compressed.capacity > 0 { compressed.bytes[0..compressed.length] } else { payload }
    var head: [14]u8 = undefined
    var noMask: [4]u8 = undefined
    const headLength = ws.writeHeader(&head, first, @intCast(u64, body.length), false, noMask)
    const sent = connSend(c, head[0..headLength]) && connSend(c, body)
    if compressed.capacity > 0 { deflate.freeBytes(extension, &compressed) }
    return sent
}

// The WebSocket of /ws once its handshake is answered: messages echoed
// until a close.
fn echoSocket(c: *Conn, extension: *deflate.Extension, held: [*]u8, heldLength: usize) -> void {
    var buffer: [65536]u8 = undefined
    var end: usize = 0
    while end < heldLength {
        buffer[end] = held[end]
        end += 1
    }
    var reply: [65536]u8 = undefined
    var replyLength: usize = 0
    var textMessage = true
    while true {
        var header: ws.Header = undefined
        var parsed = ws.parseHeader(buffer[0..end], &header)
        while parsed == ws.Parse.needMore || (parsed == ws.Parse.ok && end < header.length + @intCast(usize, header.payloadLength)) {
            if end == 65536 { return }
            const got = connReceive(c, unsafe { @ptrCast([*]u8, &buffer) + end }, 65536 - end)
            if got <= 0 { return }
            end += @intCast(usize, got)
            parsed = ws.parseHeader(buffer[0..end], &header)
        }
        if parsed != ws.Parse.ok { return }
        const length = @intCast(usize, header.payloadLength)
        if header.masked { ws.applyMask(header.mask, unsafe { @ptrCast([*]u8, &buffer) + header.length }, length) }
        const payload = buffer[header.length..header.length + length]
        if header.opcode == ws.CLOSE {
            _ = sendFrame(c, extension, ws.CLOSE, payload[0..if length >= 2 { 2 } else { 0 }])
            return
        }
        if header.opcode == ws.PING {
            _ = sendFrame(c, extension, ws.PONG, payload)
        } else if header.opcode != ws.PONG {
            if header.opcode != ws.CONTINUATION {
                textMessage = header.opcode == ws.TEXT
                replyLength = 0
                if textMessage {
                    for c in "echo: " {
                        reply[replyLength] = c
                        replyLength += 1
                    }
                }
            }
            var first: u8 = header.opcode | header.reserved | (if header.fin { 0x80 } else { 0 })
            var inflated: deflate.Bytes = undefined
            if deflate.incoming(extension, &first, payload, &inflated) != deflate.Error.none { return }
            const part = if inflated.capacity > 0 { inflated.bytes[0..inflated.length] } else { payload }
            for c in part {
                if replyLength < 65536 {
                    reply[replyLength] = c
                    replyLength += 1
                }
            }
            if inflated.capacity > 0 { deflate.freeBytes(extension, &inflated) }
            if header.fin && !sendFrame(c, extension, if textMessage { ws.TEXT } else { ws.BINARY }, reply[0..replyLength]) { return }
        }
        // The frame taken.
        const used = header.length + length
        var i: usize = 0
        while used + i < end {
            buffer[i] = buffer[used + i]
            i += 1
        }
        end -= used
    }
}

// Serves the requests of one connection.
fn serve(c: *Conn, root: []const u8, allocator: std.allocator.Allocator) -> void {
    var out: Text = undefined
    var page: Text = undefined
    var folded: [4096]u8 = undefined
    var buffer: [65536]u8 = undefined
    const into: [*]u8 = &buffer
    var held: usize = 0
    while true {
        var headEnd = message.headEnd(buffer[0..held])
        while !headComplete(buffer[0..held], headEnd) {
            if held >= 65536 { return }
            if !connReadable(c, 30000) { return }
            const got = connReceive(c, unsafe { into + held }, 65536 - held)
            if got <= 0 { return }
            held += @intCast(usize, got)
            headEnd = message.headEnd(buffer[0..held])
        }
        const head = buffer[0..headEnd]
        var line: message.RequestLine = undefined
        if !message.parseRequestLine(head, &line) { return }
        var bodyLength: usize = 0
        var value: []const u8 = ""
        if headerOf(head, "Content-Length", folded[0..4096], &value) {
            for c in value { bodyLength = bodyLength * 10 + @intCast(usize, c - 48) }
        }
        if headEnd + bodyLength > 65536 { return }
        while held < headEnd + bodyLength {
            if !connReadable(c, 30000) { return }
            const got = connReceive(c, unsafe { into + held }, 65536 - held)
            if got <= 0 { return }
            held += @intCast(usize, got)
        }
        const body = buffer[headEnd..headEnd + bodyLength]
        const target = line.target
        var close = false
        if startsWith(target, "/redirect/") {
            const rest = target[10..target.length]
            var n: usize = 0
            for c in rest { n = n * 10 + @intCast(usize, c - 48) }
            page.length = 0
            if n == 0 {
                headers.put(sinkOf(&page), "Location: /redirected.html\r\n")
            } else {
                headers.put(sinkOf(&page), "Location: /redirect/")
                putNumber(sinkOf(&page), n - 1)
                headers.put(sinkOf(&page), "\r\n")
            }
            respond(&out, 302, "Found", text(&page), "")
        } else if same(target, "/to-scheme") {
            respond(&out, 302, "Found", "Location: test://page\r\n", "")
        } else if same(target, "/see-other") {
            respond(&out, 303, "See Other", "Location: /echo\r\n", "")
        } else if same(target, "/set-cookie") {
            respond(&out, 200, "OK", "Content-Type: text/html\r\nSet-Cookie: session=abc123; Path=/\r\nSet-Cookie: pref=dark; Path=/; HttpOnly\r\n", "<!DOCTYPE html><title>cookies set</title><p>cookies set</p>")
        } else if same(target, "/cookies") {
            var cookie: []const u8 = "(none)"
            _ = headerOf(head, "Cookie", folded[0..4096], &cookie)
            respond(&out, 200, "OK", "Content-Type: text/plain\r\n", cookie)
        } else if same(target, "/echo") {
            // (A page, its text in a <pre>: what the request was.)
            page.length = 0
            const sink = sinkOf(&page)
            headers.put(sink, "<!DOCTYPE html><title>echo</title><pre>method ")
            headers.put(sink, line.method)
            var kind: []const u8 = "(none)"
            _ = headerOf(head, "Content-Type", folded[0..4096], &kind)
            headers.put(sink, "\ntype ")
            // (A multipart type's boundary changes each time: its kind only.)
            var kindEnd: usize = 0
            while kindEnd < kind.length && kind[kindEnd] != 59 { kindEnd += 1 }
            headers.put(sink, kind[0..kindEnd])
            headers.put(sink, "\nbody ")
            putNumber(sink, body.length)
            headers.put(sink, " bytes\n")
            // (The body's text, escaped; a multipart boundary's line as
            // "--boundary".)
            var at: usize = 0
            while at < body.length {
                const c = body[at]
                if c == 60 {
                    headers.put(sink, "&lt;")
                } else if c == 38 {
                    headers.put(sink, "&amp;")
                } else if c != 13 {
                    headers.put(sink, body[at..at + 1])
                }
                at += 1
            }
            headers.put(sink, "</pre>")
            respond(&out, 200, "OK", "Content-Type: text/html\r\n", text(&page))
        } else if same(target, "/user-agent") {
            page.length = 0
            const sink = sinkOf(&page)
            var agent: []const u8 = "(none)"
            _ = headerOf(head, "User-Agent", folded[0..4096], &agent)
            headers.put(sink, "<!DOCTYPE html><title>user agent</title><p>header ")
            for c in agent {
                if c != 60 && c != 38 { headers.put(sink, ([1]u8{ c })[0..1]) }
            }
            headers.put(sink, "</p><p id=navigator></p><script>document.getElementById('navigator').textContent = 'navigator ' + navigator.userAgent;</script>")
            respond(&out, 200, "OK", "Content-Type: text/html\r\n", text(&page))
        } else if same(target, "/json") {
            respond(&out, 200, "OK", "Content-Type: application/json\r\n", "{\"answer\": 42, \"items\": [1, 2, 3]}")
        } else if same(target, "/gzip.html") {
            const plain: []const u8 = "<!DOCTYPE html><title>gzip</title><p>This page came gzip-compressed, and was undone on the way in.</p>"
            var squeezed: [1024]u8 = undefined
            const n = flate.compress(plain.pointer, plain.length, unsafe { @ptrCast([*]u8, &squeezed) }, 1024, 6, flate.Format.gzip, allocator)
            respond(&out, 200, "OK", "Content-Type: text/html\r\nContent-Encoding: gzip\r\n", squeezed[0..n])
        } else if same(target, "/chunked.html") {
            out.length = 0
            const sink = sinkOf(&out)
            message.writeStatusLine(sink, message.Version.http11, 200, "OK")
            headers.put(sink, "Content-Type: text/html\r\nTransfer-Encoding: chunked\r\n\r\n")
            putChunk(sink, "<!DOCTYPE html><title>chunked</ti")
            putChunk(sink, "tle><p>This page came in three chunks.</")
            putChunk(sink, "p>\n")
            headers.put(sink, "0\r\n\r\n")
        } else if same(target, "/ws") {
            var key: []const u8 = ""
            if !headerOf(head, "Sec-WebSocket-Key", folded[0..4096], &key) { return }
            var accept: [28]u8 = undefined
            ws.acceptKey(key, &accept)
            var extension: deflate.Extension = undefined
            deflate.init(&extension, allocator)
            page.length = 0
            const sink = sinkOf(&page)
            headers.put(sink, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ")
            headers.put(sink, accept[0..28])
            headers.put(sink, "\r\n")
            var offered: []const u8 = ""
            if headerOf(head, "Sec-WebSocket-Extensions", folded[0..4096], &offered) && startsWith(offered, deflate.NAME) {
                var params = offered[deflate.NAME.length..offered.length]
                while params.length > 0 && (params[0] == 59 || params[0] == 32) { params = params[1..params.length] }
                var bad: []const u8 = ""
                if deflate.configure(&extension, false, params, params.length > 0, &bad) == deflate.Error.none && extension.enabled {
                    headers.put(sink, "Sec-WebSocket-Extensions: ")
                    headers.put(sink, deflate.NAME)
                    _ = deflate.writeResponseParams(sink, &extension)
                    headers.put(sink, "\r\n")
                }
            }
            headers.put(sink, "\r\n")
            if !connSend(c, text(&page)) { return }
            const used = headEnd + bodyLength
            echoSocket(c, &extension, unsafe { into + used }, held - used)
            return
        } else if same(target, "/quit") {
            respond(&out, 200, "OK", "", "bye")
            close = true
            _ = connSend(c, text(&out))
            net.close(c.*.fd)
            // (The parent's process group ends with it: the check kills it.)
            std.linux.exitGroup(0)
        } else if readFile(root, target, &page) {
            var path = target
            var q: usize = 0
            while q < path.length && path[q] != 63 { q += 1 }
            path = path[0..q]
            var extra: [256]u8 = undefined
            var e: usize = 0
            for c in "Content-Type: " {
                extra[e] = c
                e += 1
            }
            for c in typeOf(if same(path, "/") { "/index.html" } else { path }) {
                extra[e] = c
                e += 1
            }
            extra[e] = 13
            extra[e + 1] = 10
            respond(&out, 200, "OK", extra[0..e + 2], text(&page))
        } else {
            respond(&out, 404, "Not Found", "Content-Type: text/plain\r\n", "nothing here")
        }
        if same(line.method, "HEAD") { out.length = message.headEnd(text(&out)) }
        if !connSend(c, text(&out)) { return }
        const used = headEnd + bodyLength
        var i: usize = 0
        while used + i < held {
            buffer[i] = buffer[used + i]
            i += 1
        }
        held -= used
        if close { return }
    }
}

// Accepts connections on LISTENER for good, each served by a child
// process; over TLS with CHAIN's certificate when SECURE.
fn acceptLoop(listener: isize, root: []const u8, allocator: std.allocator.Allocator, secure: bool, chain: [*]const tls.Certificate, seed: [*]const u8) -> void {
    while true {
        var peer: net.Address = undefined
        const fd = net.accept(listener, &peer)
        if fd < 0 { continue }
        const pid = process.fork()
        if pid == 0 {
            net.close(listener)
            var server: tls.Server = undefined
            var c = Conn.{ .fd = fd, .secure = secure, .server = &server }
            if !secure || tls.accept(&server, fd, chain, 1, seed) {
                serve(&c, root, allocator)
                if secure { tls.close(&server) }
            }
            net.close(fd)
            std.linux.exitGroup(0)
        }
        net.close(fd)
    }
}

fn listenLoopback(line: *Text) -> isize {
    const loop = net.ipv4(127, 0, 0, 1, 0)
    const listener = net.listen(&loop, 16)
    if listener < 0 { return -1 }
    var bound: net.Address = undefined
    if !net.localAddress(listener, &bound) { return -1 }
    putNumber(sinkOf(line), @intCast(usize, bound.port))
    headers.put(sinkOf(line), "\n")
    return listener
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 2 {
        _ = std.io.eprintln("usage: http-test-server ROOT [CA_FILE]")
        return 2
    }
    const rootPointer = arguments[1]
    var rootLength: usize = 0
    while rootPointer[rootLength] != 0 { rootLength += 1 }
    const root = rootPointer[0..rootLength]
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    var line: Text = undefined
    line.length = 0
    const listener = listenLoopback(&line)
    if listener < 0 { return 1 }
    // https: a root and the server's certificate made now, the root's
    // PEM into CA_FILE, a listener of its own (its port the second line).
    var rootSeed: [32]u8 = undefined
    var serverSeed: [32]u8 = undefined
    var serverDer: [certs.ROOM]u8 = undefined
    var chain: [1]tls.Certificate = undefined
    if arguments.length > 2 {
        if !random.fill(unsafe { @ptrCast([*]u8, &rootSeed) }, 32) || !random.fill(unsafe { @ptrCast([*]u8, &serverSeed) }, 32) { return 1 }
        var rootDer: [certs.ROOM]u8 = undefined
        const rootLength = certs.make("mlx test root", unsafe { @ptrCast([*]const u8, &rootSeed) }, "mlx test root", unsafe { @ptrCast([*]const u8, &rootSeed) }, 1, true, unsafe { @ptrCast([*]u8, &rootDer) })
        const serverLength = certs.make("localhost", unsafe { @ptrCast([*]const u8, &serverSeed) }, "mlx test root", unsafe { @ptrCast([*]const u8, &rootSeed) }, 2, false, unsafe { @ptrCast([*]u8, &serverDer) })
        if rootLength == 0 || serverLength == 0 { return 1 }
        var pemText: [2 * certs.ROOM + 128]u8 = undefined
        const pemLength = certs.pem(rootDer[0..rootLength], unsafe { @ptrCast([*]u8, &pemText) })
        if !std.fs.writeFile(arguments[2], unsafe { @ptrCast([*]const u8, &pemText) }, pemLength, 420) { return 1 }
        chain[0] = tls.Certificate.{ .der = unsafe { @ptrCast([*]const u8, &serverDer) }, .length = serverLength }
        const secureListener = listenLoopback(&line)
        if secureListener < 0 { return 1 }
        if process.fork() == 0 {
            net.close(listener)
            acceptLoop(secureListener, root, allocator, true, unsafe { @ptrCast([*]const tls.Certificate, &chain) }, unsafe { @ptrCast([*]const u8, &serverSeed) })
            std.linux.exitGroup(0)
        }
        net.close(secureListener)
    }
    _ = std.io.print(text(&line))
    acceptLoop(listener, root, allocator, false, unsafe { @ptrCast([*]const tls.Certificate, &chain) }, unsafe { @ptrCast([*]const u8, &serverSeed) })
    return 0
}
