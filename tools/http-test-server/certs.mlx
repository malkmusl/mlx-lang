// The test certificates of http-test-server's https: an Ed25519 root
// ("mlx test root", self-signed, a CA) and the server's certificate it
// signs ("localhost": dNSName localhost and iPAddress 127.0.0.1,
// serverAuth), both valid 2025 to 2035, made with std.asn1's DER writer
// and std.crypto's Ed25519 at each start from fresh keys. The root goes
// to a PEM file the client trusts (MLXWEB_CA_FILE); nothing else does.
const std = @import("std")
const asn1 = @import("std.asn1")
const curve25519 = @import("std.crypto.curve25519")
const base64 = @import("std.base64")

pub const ROOM: usize = 2048

const ED25519: [3]u8 = [3]u8{ 43, 101, 112 }
const COMMON_NAME: [3]u8 = [3]u8{ 85, 4, 3 }
const BASIC_CONSTRAINTS: [3]u8 = [3]u8{ 85, 29, 19 }
const KEY_USAGE: [3]u8 = [3]u8{ 85, 29, 15 }
const EXTENDED_KEY_USAGE: [3]u8 = [3]u8{ 85, 29, 37 }
const ALT_NAME: [3]u8 = [3]u8{ 85, 29, 17 }
const SERVER_AUTH: [8]u8 = [8]u8{ 43, 6, 1, 5, 5, 7, 3, 1 }
const TRUE: [1]u8 = [1]u8{ 255 }
const SIGN_CERTIFICATES: [2]u8 = [2]u8{ 1, 6 }
const SIGN_DATA: [2]u8 = [2]u8{ 7, 128 }
const LOOPBACK: [4]u8 = [4]u8{ 127, 0, 0, 1 }

fn putAlgorithm(w: *asn1.Writer) -> void {
    const sequence = asn1.open(w, asn1.TAG_SEQUENCE)
    asn1.put(w, asn1.TAG_OID, ED25519[0..3])
    asn1.close(w, sequence)
}

fn putName(w: *asn1.Writer, commonName: []const u8) -> void {
    const name = asn1.open(w, asn1.TAG_SEQUENCE)
    const set = asn1.open(w, asn1.TAG_SET)
    const pair = asn1.open(w, asn1.TAG_SEQUENCE)
    asn1.put(w, asn1.TAG_OID, COMMON_NAME[0..3])
    asn1.put(w, asn1.TAG_UTF8_STRING, commonName)
    asn1.close(w, pair)
    asn1.close(w, set)
    asn1.close(w, name)
}

// An extension's start (its OID, critical or not) up to its OCTET
// STRING's contents: the two marks to close.
fn openExtension(w: *asn1.Writer, oid: []const u8, critical: bool, octets: *usize) -> usize {
    const extension = asn1.open(w, asn1.TAG_SEQUENCE)
    asn1.put(w, asn1.TAG_OID, oid)
    if critical { asn1.put(w, asn1.TAG_BOOLEAN, TRUE[0..1]) }
    octets.* = asn1.open(w, asn1.TAG_OCTET_STRING)
    return extension
}

fn closeExtension(w: *asn1.Writer, extension: usize, octets: usize) -> void {
    asn1.close(w, octets)
    asn1.close(w, extension)
}

// A certificate of SUBJECT's key (SUBJECT_SEED) signed by ISSUER's
// (ISSUER_SEED) into OUT (ROOM bytes): its length, 0 when it did not fit.
pub fn make(subject: []const u8, subjectSeed: [*]const u8, issuer: []const u8, issuerSeed: [*]const u8, serial: u64, authority: bool, out: [*]u8) -> usize {
    var w = asn1.writer(out, ROOM)
    const certificate = asn1.open(&w, asn1.TAG_SEQUENCE)
    const tbs = asn1.open(&w, asn1.TAG_SEQUENCE)
    const version = asn1.open(&w, asn1.contextTag(0, true))
    asn1.putSmallInteger(&w, 2)
    asn1.close(&w, version)
    asn1.putSmallInteger(&w, serial)
    putAlgorithm(&w)
    putName(&w, issuer)
    const validity = asn1.open(&w, asn1.TAG_SEQUENCE)
    asn1.put(&w, asn1.TAG_UTC_TIME, "250101000000Z")
    asn1.put(&w, asn1.TAG_UTC_TIME, "350101000000Z")
    asn1.close(&w, validity)
    putName(&w, subject)
    const keyInfo = asn1.open(&w, asn1.TAG_SEQUENCE)
    putAlgorithm(&w)
    var key: [32]u8 = undefined
    curve25519.ed25519Public(subjectSeed, unsafe { @ptrCast([*]u8, &key) })
    asn1.putBitString(&w, key[0..32])
    asn1.close(&w, keyInfo)
    const wrapper = asn1.open(&w, asn1.contextTag(3, true))
    const extensions = asn1.open(&w, asn1.TAG_SEQUENCE)
    var octets: usize = 0
    var extension = openExtension(&w, BASIC_CONSTRAINTS[0..3], true, &octets)
    const constraints = asn1.open(&w, asn1.TAG_SEQUENCE)
    if authority { asn1.put(&w, asn1.TAG_BOOLEAN, TRUE[0..1]) }
    asn1.close(&w, constraints)
    closeExtension(&w, extension, octets)
    extension = openExtension(&w, KEY_USAGE[0..3], true, &octets)
    asn1.put(&w, asn1.TAG_BIT_STRING, if authority { SIGN_CERTIFICATES[0..2] } else { SIGN_DATA[0..2] })
    closeExtension(&w, extension, octets)
    if !authority {
        extension = openExtension(&w, EXTENDED_KEY_USAGE[0..3], false, &octets)
        const purposes = asn1.open(&w, asn1.TAG_SEQUENCE)
        asn1.put(&w, asn1.TAG_OID, SERVER_AUTH[0..8])
        asn1.close(&w, purposes)
        closeExtension(&w, extension, octets)
        extension = openExtension(&w, ALT_NAME[0..3], false, &octets)
        const names = asn1.open(&w, asn1.TAG_SEQUENCE)
        asn1.put(&w, asn1.contextTag(2, false), "localhost")
        asn1.put(&w, asn1.contextTag(7, false), LOOPBACK[0..4])
        asn1.close(&w, names)
        closeExtension(&w, extension, octets)
    }
    asn1.close(&w, extensions)
    asn1.close(&w, wrapper)
    asn1.close(&w, tbs)
    if !w.ok { return 0 }
    // (The TBS, closed, from its mark to here.)
    var signature: [64]u8 = undefined
    curve25519.ed25519Sign(issuerSeed, out[tbs..w.at], unsafe { @ptrCast([*]u8, &signature) })
    putAlgorithm(&w)
    asn1.putBitString(&w, signature[0..64])
    asn1.close(&w, certificate)
    return if w.ok { w.at } else { 0 }
}

// DER as a PEM CERTIFICATE into OUT (room for 2 * ROOM): its length.
pub fn pem(der: []const u8, out: [*]u8) -> usize {
    var encoded: [2 * ROOM]u8 = undefined
    const length = base64.encode(base64.Encoding.base64, der, unsafe { @ptrCast([*]u8, &encoded) }, true)
    var at: usize = 0
    for c in "-----BEGIN CERTIFICATE-----\n" {
        out[at] = c
        at += 1
    }
    var index: usize = 0
    while index < length {
        out[at] = encoded[index]
        at += 1
        index += 1
        if index % 64 == 0 || index == length {
            out[at] = 10
            at += 1
        }
    }
    for c in "-----END CERTIFICATE-----\n" {
        out[at] = c
        at += 1
    }
    return at
}
