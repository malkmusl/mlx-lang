// The toolchain's version as an Mlx module (mlx-out/version.mlx), the
// text of which build.mlx (toolchainVersion) and mlx-build-number
// --module write: VERSION, "MAJOR.MINOR.BUILD" (MAJOR.MINOR.dev without a
// repository), and COMMIT, HEAD's name ("" then). The module is
// self-contained (no import), so the compilers that import it
// (compiler/selfhost, compiler/cc, compiler/ld) keep their closure off
// the std root (tools/check_bootstrap.sh).
const std = @import("std")
const git = @import("std.git")

// Where the module goes, relative to the checkout.
pub const PATH: []const u8 = "mlx-out/version.mlx"

// The version line of NUMBER ("0.1.1211", or "0.1.dev" when STATUS is not
// ok) into INTO.
pub fn versionText(number: *const git.BuildNumber, status: git.Status, into: *std.ArrayList(u8)) -> void {
    into.*.clearRetainingCapacity()
    _ = into.*.appendSlice(number.*.version())
    _ = into.*.append(46)
    if status != git.Status.ok {
        _ = into.*.appendSlice("dev")
        return
    }
    var digits: [24]u8 = undefined
    const bytes: [*]u8 = &digits
    const length = std.text.appendUnsigned(bytes, 0, 24, number.*.build)
    _ = into.*.appendSlice(bytes[0..length])
}

// The module of NUMBER into INTO.
pub fn moduleText(number: *const git.BuildNumber, status: git.Status, into: *std.ArrayList(u8)) -> void {
    var version = std.ArrayList(u8).init(std.heap.allocator())
    versionText(number, status, &version)
    into.*.clearRetainingCapacity()
    _ = into.*.appendSlice("// The toolchain's version: made by ./mlx build (build.mlx) or\n// tools/ensure_compiler.sh with tools/build-number from VERSION and the\n// git history (std.git); not to be edited. MAJOR.MINOR.BUILD, BUILD the\n// commits since VERSION last changed (docs/reference/build-system.md).\npub const VERSION: []const u8 = \"")
    _ = into.*.appendSlice(version.items())
    _ = into.*.appendSlice("\"\npub const COMMIT: []const u8 = \"")
    if status == git.Status.ok {
        var hex: [40]u8 = undefined
        const digits: [*]u8 = &hex
        git.writeHex(&number.*.commit, digits)
        _ = into.*.appendSlice(digits[0..40])
    }
    _ = into.*.appendSlice("\"\n")
}
