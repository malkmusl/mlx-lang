// mlx-build-number: the build number of a checkout, for scripts, read
// with std.git (no git program): VERSION's MAJOR.MINOR and the number of
// commits since that file last changed (docs/reference/build-system.md,
// "Versions and build numbers"), and HEAD's commit:
//
//     $ mlx-out/bin/mlx-build-number
//     0.1.1211 5d1c...e9
//
// Without a repository (a tree without .git) it prints MAJOR.MINOR.dev
// alone. A shallow clone is counted to its boundary, and stderr says so.
//
//   mlx-build-number [DIRECTORY] [--file=PATH] [--module=FILE]
//
//   DIRECTORY      the checkout (the current directory by default; a
//                  directory below its root does too)
//   --file=PATH    the version file, relative to the repository's root
//                  (VERSION)
//   --module=FILE  also write the toolchain's version module there
//                  (tools/build-number/module.mlx), only when it changes
//
// Exits 0, or 1 when the repository cannot be read (it still prints the
// dev version and writes its module, for a build to go on).
const std = @import("std")
const crash = @import("std.crash")
const git = @import("std.git")
const module = @import("./module.mlx")

fn say(file: std.fs.File, text: []const u8) -> void { _ = std.io.writeAll(file, text) }

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    var directory: []const u8 = "."
    var versionFile: []const u8 = "VERSION"
    var modulePath: []const u8 = ""
    var index: usize = 1
    while index < std.process.count(arguments) {
        const argument = std.string.asSlice(std.process.argument(arguments, index))
        if std.text.startsWith(argument, "--file=") {
            versionFile = argument[7..argument.length]
        } else if std.text.startsWith(argument, "--module=") {
            modulePath = argument[9..argument.length]
        } else if argument.length > 0 && argument[0] == 45 {
            say(std.io.stderr(), "usage: mlx-build-number [DIRECTORY] [--file=PATH] [--module=FILE]\n")
            return 2
        } else {
            directory = argument
        }
        index += 1
    }
    var number: git.BuildNumber = undefined
    const status = git.buildNumberOf(directory, versionFile, &number)
    var failed = false
    if status != git.Status.ok && status != git.Status.noRepository {
        say(std.io.stderr(), "mlx-build-number: ")
        say(std.io.stderr(), git.describe(status))
        say(std.io.stderr(), "\n")
        failed = true
    }
    if status == git.Status.ok && number.shallow {
        say(std.io.stderr(), "mlx-build-number: a shallow clone: counted to its boundary (.git/shallow)\n")
    }
    var line = std.ArrayList(u8).init(std.heap.allocator())
    module.versionText(&number, status, &line)
    if status == git.Status.ok {
        _ = line.append(32)
        var hex: [40]u8 = undefined
        const digits: [*]u8 = &hex
        git.writeHex(&number.commit, digits)
        _ = line.appendSlice(digits[0..40])
    }
    _ = line.append(10)
    say(std.io.stdout(), line.items())
    if modulePath.length > 0 {
        var text = std.ArrayList(u8).init(std.heap.allocator())
        module.moduleText(&number, status, &text)
        var path = std.ArrayList(u8).init(std.heap.allocator())
        _ = path.appendSlice(modulePath)
        _ = path.append(0)
        const cPath = path.items().pointer
        var same = false
        const loaded = std.fs.readFileAlloc(cPath, std.heap.allocator())
        if loaded != null {
            const old = loaded.?
            same = std.text.same(old.items[0..old.length], text.items())
            std.fs.ArrayList.deinit(old)
        }
        if !same {
            if !std.fs.makeParents(modulePath, 493) || !std.fs.replaceFile(cPath, text.items().pointer, text.count(), 420) {
                say(std.io.stderr(), "mlx-build-number: cannot write the module\n")
                return 1
            }
        }
    }
    return if failed { 1 } else { 0 }
}
