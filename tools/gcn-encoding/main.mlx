// Prints every instruction our shader compiler (projects/brix/vulkan/)
// emits for std.gpu's nine kernels, and every instruction its selection
// can emit in a few operand patterns besides, one a line: the words in hex
// as little-endian bytes, a tab, the text decode.mlx writes for them. For
// tools/check_gcn_encoding.sh, which holds both against the host's
// llvm-mc (a development check: llvm-mc is not part of what is built).
//
//     mlx4 tools/gcn-encoding/main.mlx -o gcn-encoding
//     ./gcn-encoding > instructions.txt
const std = @import("std")
const shaders = @import("std.gpu.shaders")
const isa = @import("../../projects/brix/vulkan/isa.mlx")
const encode = @import("../../projects/brix/vulkan/encode.mlx")
const decode = @import("../../projects/brix/vulkan/decode.mlx")
const shader = @import("../../projects/brix/vulkan/shader.mlx")

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn hexByte(value: u32) -> void {
    var digits: [4]u8 = [4]u8{ 48, 120, 0, 0 }
    const high = @intCast(u8, (value >> 4) & 15)
    const low = @intCast(u8, value & 15)
    digits[2] = if high < 10 { 48 + high } else { 87 + high }
    digits[3] = if low < 10 { 48 + low } else { 87 + low }
    say(digits[0..4])
}

// One line: the words' bytes, the text.
fn line(words: []const u32) -> void {
    var inst: encode.Inst = undefined
    if decode.decode(words, 0, &inst) != words.length {
        say("# undecodable\n")
        return
    }
    var first = true
    for word in words {
        var k: u32 = 0
        while k < 4 {
            if !first { say(",") }
            hexByte((word >> (8 * k)) & 255)
            first = false
            k += 1
        }
    }
    var text: decode.Text = undefined
    decode.clear(&text)
    decode.text(&inst, &text)
    say("\t")
    say(text.bytes[0..text.length])
    say("\n")
}

// Prints `inst` once per distinct word pattern seen (the kernels repeat
// most instructions many times).
var seen: [8192]u64 = undefined
var seenCount: usize = 0

fn printOnce(words: []const u32) -> void {
    var key = @intCast(u64, words[0])
    if words.length > 1 { key |= @intCast(u64, words[1]) << 32 }
    var k: usize = 0
    while k < seenCount {
        if seen[k] == key { return }
        k += 1
    }
    if seenCount < 8192 {
        seen[seenCount] = key
        seenCount += 1
    }
    line(words)
}

fn put(inst: encode.Inst) -> void {
    var words: [3]u32 = undefined
    const n = encode.encode(&inst, words[0..])
    if n == 0 {
        say("# not encodable\n")
        return
    }
    printOnce(words[0..n])
}

var program: [65536]u32 = undefined

fn kernels() -> void {
    const allocator = std.page_allocator.init()
    var which: u8 = 0
    while which < 9 {
        var spirv: [*]u32 = undefined
        const count = shaders.build(allocator, which, &spirv)
        var words: []const u32 = undefined
        unsafe { words = spirv[0..count] }
        var facts: shader.Facts = undefined
        var failure: shader.Failure = undefined
        if shader.compile(words, allocator, program[0..], &facts, &failure) {
            var at: usize = 0
            while at < facts.words {
                var inst: encode.Inst = undefined
                const n = decode.decode(program[0..facts.words], at, &inst)
                if n == 0 { break }
                printOnce(program[at..at + n])
                at += n
            }
        } else {
            say("# a kernel did not compile\n")
        }
        which += 1
    }
}

fn v(n: u16) -> u16 { return encode.VGPR + n }

// What the selection can emit, each in a few operand patterns.
fn patterns() -> void {
    const scalarOps = [_]isa.Op{ isa.S_ADD_U32, isa.S_SUB_U32, isa.S_MUL_I32, isa.S_LSHL_B32, isa.S_LSHR_B32, isa.S_ASHR_I32, isa.S_AND_B32, isa.S_OR_B32, isa.S_XOR_B32, isa.S_CSELECT_B32 }
    for op in scalarOps {
        var i = encode.blank(op)
        i.dst = 20
        i.src0 = 21
        i.src1 = 22
        put(i)
        i.src1 = encode.constant(7)
        put(i)
        i.src0 = encode.LITERAL
        i.literal = 0x12345678
        put(i)
    }
    const pairOps = [_]isa.Op{ isa.S_AND_B64, isa.S_OR_B64, isa.S_XOR_B64, isa.S_XNOR_B64, isa.S_ANDN2_B64, isa.S_CSELECT_B64 }
    for op in pairOps {
        var i = encode.blank(op)
        i.dst = 20
        i.src0 = 22
        i.src1 = encode.VCC
        put(i)
        i.dst = encode.EXEC
        i.src0 = encode.EXEC
        i.src1 = 24
        put(i)
        i.src0 = encode.constant(0xFFFFFFFF)
        i.src1 = encode.constant(0)
        put(i)
    }
    const oneOps = [_]isa.Op{ isa.S_MOV_B32, isa.S_NOT_B32, isa.S_MOV_B64, isa.S_NOT_B64, isa.S_AND_SAVEEXEC_B64 }
    for op in oneOps {
        var i = encode.blank(op)
        i.dst = 20
        i.src0 = 24
        put(i)
        i.src0 = encode.constant(5)
        put(i)
    }
    var mov = encode.blank(isa.S_MOV_B64)
    mov.dst = encode.EXEC
    mov.src0 = 30
    put(mov)
    const compares = [_]isa.Op{ isa.S_CMP_EQ_U32, isa.S_CMP_LG_U32, isa.S_CMP_LT_U32, isa.S_CMP_LE_U32, isa.S_CMP_GT_U32, isa.S_CMP_GE_U32, isa.S_CMP_LT_I32, isa.S_CMP_LE_I32, isa.S_CMP_GT_I32, isa.S_CMP_GE_I32, isa.S_CMP_LG_U64 }
    for op in compares {
        var i = encode.blank(op)
        i.src0 = 20
        i.src1 = 22
        put(i)
        i.src1 = encode.constant(0)
        put(i)
    }
    var load = encode.blank(isa.S_LOAD_DWORD)
    load.dst = 20
    load.src0 = 4
    load.flags = encode.IMM
    load.imm = 0x34
    put(load)
    load.op = isa.S_LOAD_DWORDX4
    load.dst = 12
    load.src0 = 2
    load.imm = 0x10
    put(load)
    const vectorOps = [_]isa.Op{ isa.V_ADD_CO_U32, isa.V_SUB_CO_U32, isa.V_SUBREV_CO_U32, isa.V_AND_B32, isa.V_OR_B32, isa.V_XOR_B32, isa.V_MAX_I32, isa.V_MUL_F32, isa.V_LSHLREV_B32, isa.V_LSHRREV_B32, isa.V_ASHRREV_I32 }
    for op in vectorOps {
        var i = encode.blank(op)
        i.dst = v(5)
        i.src0 = v(6)
        i.src1 = v(7)
        put(i)
        i.src0 = 20
        put(i)
        i.src0 = encode.constant(3)
        put(i)
        i.src0 = encode.LITERAL
        i.literal = 0xABCDEF01
        put(i)
    }
    const oneVector = [_]isa.Op{ isa.V_MOV_B32, isa.V_NOT_B32, isa.V_CVT_F32_U32, isa.V_CVT_U32_F32, isa.V_RCP_F32 }
    for op in oneVector {
        var i = encode.blank(op)
        i.dst = v(5)
        i.src0 = v(6)
        put(i)
        i.src0 = 20
        put(i)
        i.src0 = encode.LITERAL
        i.literal = 0xFF
        put(i)
    }
    const threeOps = [_]isa.Op{ isa.V_MUL_LO_U32, isa.V_MUL_HI_U32 }
    for op in threeOps {
        var i = encode.blank(op)
        i.dst = v(5)
        i.src0 = v(6)
        i.src1 = v(7)
        put(i)
        i.src1 = 20
        put(i)
        i.src0 = encode.constant(4)
        put(i)
    }
    const vcompares = [_]isa.Op{ isa.V_CMP_EQ_U32, isa.V_CMP_LG_U32, isa.V_CMP_LT_U32, isa.V_CMP_LE_U32, isa.V_CMP_GT_U32, isa.V_CMP_GE_U32, isa.V_CMP_LT_I32, isa.V_CMP_LE_I32, isa.V_CMP_GT_I32, isa.V_CMP_GE_I32 }
    for op in vcompares {
        var i = encode.blank(op)
        i.form = encode.Form.vop3
        i.dst = 20
        i.src0 = v(6)
        i.src1 = 22
        put(i)
        i.src0 = encode.constant(0)
        i.src1 = v(7)
        put(i)
    }
    var select = encode.blank(isa.V_CNDMASK_B32)
    select.form = encode.Form.vop3
    select.dst = v(5)
    select.src0 = v(6)
    select.src1 = encode.constant(1)
    select.src2 = 20
    put(select)
    var buffer = encode.blank(isa.BUFFER_LOAD_DWORD)
    buffer.dst = v(5)
    buffer.src0 = v(6)
    buffer.src1 = 12
    buffer.src2 = encode.constant(0)
    buffer.flags = encode.OFFEN
    put(buffer)
    buffer.op = isa.BUFFER_STORE_DWORD
    buffer.src1 = 16
    put(buffer)
    const branches = [_]isa.Op{ isa.S_BRANCH, isa.S_CBRANCH_SCC0, isa.S_CBRANCH_EXECZ }
    for op in branches {
        var i = encode.blank(op)
        i.imm = 12
        put(i)
        i.imm = 0xFFF0
        put(i)
    }
    var w = encode.blank(isa.S_WAITCNT)
    w.imm = encode.waitWord(0, encode.WAIT_EXP_MASK, encode.WAIT_LGKM_MASK)
    put(w)
    w.imm = encode.waitWord(encode.WAIT_VM_MASK, encode.WAIT_EXP_MASK, 0)
    put(w)
    w.imm = encode.waitWord(0, 0, 0)
    put(w)
    var nop = encode.blank(isa.S_NOP)
    nop.imm = 4
    put(nop)
    put(encode.blank(isa.S_ENDPGM))
}

pub fn main() -> u8 {
    kernels()
    patterns()
    return 0
}
