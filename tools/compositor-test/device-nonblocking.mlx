// tools/check_compositor_device.sh: a device handed over blocking (as a
// session manager may) reads without waiting once device.init has it. A
// pipe stands in for the card: no socket, so the real-device path.
const std = @import("std")
const device = @import("../../projects/desktop/compositor/device.mlx")

const SYS_pipe2: usize = 293
const SYS_fcntl: usize = 72
const F_GETFL: usize = 3

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

pub fn main(arguments: [][*]const u8) -> u8 {
    var ends: [2]i32 = [2]i32{ -1, -1 }
    if std.linux.syscall2(SYS_pipe2, @intFromPtr(&ends), 0) != 0 {
        say("no pipe\n")
        return 2
    }
    const reading = @intCast(isize, ends[0])
    const writing = @intCast(usize, ends[1])
    var opened: device.Device = undefined
    device.init(&opened, reading, std.page_allocator.init())
    const flags = std.linux.syscall2(SYS_fcntl, @bitCast(usize, reading), F_GETFL)
    if flags < 0 || @bitCast(usize, flags) & device.O_NONBLOCK == 0 {
        say("the descriptor is still blocking\n")
        return 1
    }
    var buffer: [16]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &buffer) }
    // Nothing there: EAGAIN at once (a blocking read would hang here, and
    // the check's time limit end it).
    const empty = device.read(&opened, bytes, 16)
    if empty != device.EAGAIN {
        say("an empty device did not give EAGAIN\n")
        return 1
    }
    _ = std.linux.syscall3(device.SYS_write, writing, @intFromPtr("x"), 1)
    const one = device.read(&opened, bytes, 16)
    if one != 1 || buffer[0] != 120 {
        say("the written byte did not come back\n")
        return 1
    }
    say("ok\n")
    return 0
}
