// tools/check_compositor_commit.sh: a client whose frames change in part,
// drawn with std.ui's panel. Its picture is a pattern with rectangles laid
// over it one by one (a text line's size, some translucent, one of them
// all of it), a frame for each.
//
//   commit-damage part|whole window|layer
//
// `whole`: every frame is drawn whole and no damage is named. `part`: a
// frame draws only its new rectangle and names it as the damage (the
// panel's damage, wl_surface.damage); around it the buffer is filled with
// pixels that are not the picture's, as a client's buffer is while it
// draws its next frame. A compositor that takes only the damage shows the
// same picture either way; one that reads more shows the other pixels,
// and one that damages too little of its scene keeps old ones. `window`:
// an xdg_toplevel; `layer`: a layer surface across the top (a panel's
// commit goes through the layer shell's placing).
//
// "commit-damage: done" is written when the last frame was taken.
const std = @import("std")
const crash = @import("std.crash")
const canvas_module = @import("std.ui.canvas")
const panel_module = @import("std.ui.wayland.panel")

const Canvas = canvas_module.Canvas
const Panel = panel_module.Panel

// Frames after the first.
const STEPS: usize = 24

const Client = struct {
    panel: Panel
    part: bool
    // The frame wanted (0: the pattern alone) and the one the compositor
    // was given last, with its size (-1: none yet).
    step: usize
    given: isize
    givenWidth: usize
    givenHeight: usize
    done: bool
}

fn clientOf(context: *anyopaque) -> *Client {
    unsafe { return @ptrCast(*Client, context) }
}

fn panelOf(client: *Client) -> *Panel {
    unsafe { return @ptrCast(*Panel, &client.*.panel) }
}

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

const Box = struct {
    x: usize
    y: usize
    width: usize
    height: usize
    color: u32
}

// The rectangle frame `step` (1 and up) lays over the picture: a line 18
// rows tall somewhere in it, every fifth translucent (premultiplied), the
// twelfth all of the picture.
fn boxOf(step: usize, width: usize, height: usize) -> Box {
    var box: Box = undefined
    box.width = width / 4 + (step * 37) % (width / 2)
    box.height = if height > 18 { 18 } else { height }
    box.x = (step * 53) % (width - box.width + 1)
    box.y = (step * 29) % (height - box.height + 1)
    const shade = @intCast(u32, (step * 40) % 200)
    box.color = 4278190080 | ((40 + shade) << 16) | ((220 - shade) << 8) | (90 + shade / 2)
    if step % 5 == 0 { box.color = 2147483648 | ((shade / 2) << 16) | (60 << 8) | 20 }
    if step == 12 {
        box.x = 0
        box.y = 0
        box.width = width
        box.height = height
    }
    return box
}

// The picture's pixel at (x, y) after `step` frames.
fn pixelAt(x: usize, y: usize, step: usize, width: usize, height: usize) -> u32 {
    var index = step
    while index >= 1 {
        const box = boxOf(index, width, height)
        if x >= box.x && y >= box.y && x < box.x + box.width && y < box.y + box.height { return box.color }
        index -= 1
    }
    return 4278190080 | (@intCast(u32, (x * 255) / width) << 16) | (@intCast(u32, (y * 255) / height) << 8) | 64
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    const client = clientOf(context)
    const panel = panelOf(client)
    const width = canvas.*.width
    const height = canvas.*.height
    const step = client.*.step
    // Only the next frame of the picture the compositor has, at the same
    // size, can be given in part.
    const next = client.*.given >= 0 && @intCast(usize, client.*.given) + 1 == step && client.*.givenWidth == width && client.*.givenHeight == height
    if client.*.part && next {
        const box = boxOf(step, width, height)
        var y: usize = 0
        while y < height {
            var x: usize = 0
            while x < width {
                const inside = x >= box.x && y >= box.y && x < box.x + box.width && y < box.y + box.height
                // (Around it: translucent, and nothing the picture has.)
                canvas.*.pixels[y * canvas.*.stride + x] = if inside { box.color } else { 1090453504 | @intCast(u32, (x * 7 + y * 13) % 64) }
                x += 1
            }
            y += 1
        }
        panel_module.damage(panel, @intCast(i32, box.x), @intCast(i32, box.y), @intCast(i32, box.width), @intCast(i32, box.height))
    } else {
        var y: usize = 0
        while y < height {
            var x: usize = 0
            while x < width {
                canvas.*.pixels[y * canvas.*.stride + x] = pixelAt(x, y, step, width, height)
                x += 1
            }
            y += 1
        }
    }
    client.*.given = @intCast(isize, step)
    client.*.givenWidth = width
    client.*.givenHeight = height
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const client = clientOf(context)
    const panel = panelOf(client)
    if kind == panel_module.EVENT_TICK {
        // The next frame once the one before was taken (drawn, and its
        // frame callback back).
        if panel.*.framePending || panel.*.dirty || client.*.given < 0 || @intCast(usize, client.*.given) != client.*.step { return }
        if client.*.step < STEPS {
            client.*.step += 1
            panel.*.dirty = true
        } else if !client.*.done {
            client.*.done = true
            say("commit-damage: done\n")
        }
    } else if kind == panel_module.EVENT_CLOSED {
        panel.*.running = false
    }
}

fn starts(text: [*]const u8, with: []const u8) -> bool {
    var index: usize = 0
    while index < with.length {
        if text[index] != with[index] { return false }
        index += 1
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> !void {
    _ = crash.install()
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(@sizeOf(Client), 16)
    if memory == null { return }
    var client: *Client = undefined
    unsafe { client = @ptrCast(*Client, memory.?) }
    client.*.part = arguments.length > 1 && starts(arguments[1], "part")
    const layer = arguments.length > 2 && starts(arguments[2], "layer")
    client.*.step = 0
    client.*.given = -1
    client.*.givenWidth = 0
    client.*.givenHeight = 0
    client.*.done = false
    const panel = panelOf(client)
    panel.*.context = client
    panel.*.draw = draw
    panel.*.event = onEvent
    if layer {
        const anchor = panel_module.ANCHOR_TOP | panel_module.ANCHOR_LEFT | panel_module.ANCHOR_RIGHT
        try panel_module.open(panel, allocator, arguments, "commit-damage", panel_module.LAYER_TOP, anchor, 0, 60, 60, 0, panel_module.KEYBOARD_NONE, false)
    } else {
        try panel_module.openWindow(panel, allocator, arguments, "Commit damage", "commit-damage", 420, 260)
    }
    panel.*.tickInterval = 40
    try panel_module.run(panel)
    panel_module.close(panel)
}
