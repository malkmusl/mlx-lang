// Focused model check for aurora: no system account files and no
// real password are involved.
const std = @import("std")
const ipc = @import("std.ipc")
const field = @import("std.ui.field")
const login = @import("../../projects/desktop/greeter/login.mlx")
const secret = @import("../../projects/desktop/greeter/secret.mlx")
const sessions_module = @import("../../projects/desktop/greeter/sessions.mlx")

fn print(value: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), value) }

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.heap.allocator()
    var sessions: sessions_module.Sessions = undefined
    const initialized = sessions_module.init(&sessions, std.process.environmentEntries(arguments), allocator)
    sessions_module.scan(&sessions)
    var index: usize = 0
    while index < sessions.count {
        const item = sessions_module.sessionAt(&sessions, index)
        print("session ")
        print(sessions_module.nameOf(item))
        print(" ")
        print(sessions_module.commandOf(item))
        print("\n")
        index += 1
    }

    var selected = sessions_module.preferredIndex(&sessions)
    var selectedItem = sessions_module.sessionAt(&sessions, selected)
    print("selected ")
    print(sessions_module.nameOf(selectedItem))
    print(" ")
    print(sessions_module.commandOf(selectedItem))
    print("\n")
    selected = sessions_module.cycleIndex(sessions.count, selected, true)
    selectedItem = sessions_module.sessionAt(&sessions, selected)
    print("selected-next ")
    print(sessions_module.nameOf(selectedItem))
    print(" ")
    print(sessions_module.commandOf(selectedItem))
    print("\n")
    selected = sessions_module.cycleIndex(sessions.count, selected, true)
    selectedItem = sessions_module.sessionAt(&sessions, selected)
    print("selected-wrap ")
    print(sessions_module.nameOf(selectedItem))
    print(" ")
    print(sessions_module.commandOf(selectedItem))
    print("\n")

    var body: [256]u8 = undefined
    var writing: ipc.Writer = undefined
    unsafe { ipc.begin(&writing, @ptrCast([*]u8, &body), 256) }
    const array = ipc.beginArray(&writing)
    ipc.putString(&writing, "alice")
    ipc.putString(&writing, "Alice Example")
    ipc.putString(&writing, "/home/alice")
    ipc.putString(&writing, "/bin/flux")
    ipc.endArray(&writing, array, 1)
    var users: login.Users = undefined
    unsafe { login.parseUsers(@ptrCast([*]const u8, &body), writing.length, &users) }
    const user = login.userAt(&users, 0)
    print("users ")
    print(login.nameOf(user))
    print(" ")
    print(login.realNameOf(user))
    print(" ")
    print(login.homeOf(user))
    print(" ")
    print(login.shellOf(user))
    print("\n")

    var password: field.Field = undefined
    field.init(&password)
    field.set(&password, "secret")
    var shown: field.Field = undefined
    field.init(&shown)
    secret.mask(&password, &shown)
    print("secret ")
    print(field.text(&shown))
    print("\n")
    // (The block the password was typed into, read after the wipe.)
    const block = password.bytes
    const room = field.capacity(&password)
    secret.wipe(&password, &shown)
    var clean = password.length == 0 && shown.length == 0 && room > 0
    index = 0
    while index < room {
        if block[index] != 0 { clean = false }
        index += 1
    }
    print(if clean { "wiped yes\n" } else { "wiped no\n" })
}
