// A window for the desktop's tests of the compositor's small protocols
// (projects/desktop/compositor/extras.mlx): it says what xdg-output tells
// of the output, keeps the screen on with an idle inhibitor for a second,
// and hands out or uses an xdg-activation token through a file.
//
//   wayland-extras-test source FILE   asks for a token (as the window that
//                                     has the keyboard) and writes it to FILE
//   wayland-extras-test target FILE   waits for FILE, then brings its window
//                                     forward with the token in it, twice
//                                     (the second time must be refused)
//   wayland-extras-test thief         asks for a token while another window
//                                     has the keyboard and uses it at once
//
// It prints `extras: output WxH NAME`, `extras: token written`, `extras:
// activating` and ends after a few seconds.
const std = @import("std")
const wl = @import("std.wayland")
const canvas_module = @import("std.ui.canvas")
const panel_module = @import("std.ui.wayland.panel")

const Canvas = canvas_module.Canvas
const Panel = panel_module.Panel

const MODE_SOURCE: u8 = 0
const MODE_TARGET: u8 = 1
const MODE_THIEF: u8 = 2

const Test = struct {
    panel: Panel
    mode: u8
    file: [*]const u8
    registry: wl.wl_registry.Proxy
    output: wl.wl_output.Proxy
    hasOutput: bool
    outputManager: wl.zxdg_output_manager_v1.Proxy
    hasOutputManager: bool
    inhibitManager: wl.zwp_idle_inhibit_manager_v1.Proxy
    hasInhibitManager: bool
    inhibitor: wl.zwp_idle_inhibitor_v1.Proxy
    hasInhibitor: bool
    activation: wl.xdg_activation_v1.Proxy
    hasActivation: bool
    token: [64]u8
    tokenLength: usize
    width: i32
    height: i32
    ticks: usize
    activations: usize
}

fn testOf(context: *anyopaque) -> *Test {
    unsafe { return @ptrCast(*Test, context) }
}

fn panelOf(test_state: *Test) -> *Panel {
    unsafe { return @ptrCast(*Panel, &test_state.*.panel) }
}

fn say(text: []const u8) -> void {
    _ = std.io.writeAll(std.io.stdout(), text)
}

fn sayNumber(value: i32) -> void {
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = if value < 0 { 0 - value } else { value }
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var out: [12]u8 = undefined
    var index: usize = 0
    while index < count {
        out[index] = digits[count - 1 - index]
        index += 1
    }
    const bytes: [*]const u8 = &out
    say(bytes[0..count])
}

fn isNamed(value: wl.String, name: []const u8) -> bool {
    return std.string.eql(value, std.string.fromSlice(name))
}

fn onGlobal(context: *anyopaque, event: wl.client.Event) -> void {
    const test_state = testOf(context)
    if event.opcode != wl.wl_registry.EVENT_GLOBAL { return }
    const global = wl.wl_registry.decodeEvent(event).global
    const registry = test_state.*.registry
    if isNamed(global.interface, "wl_output") && !test_state.*.hasOutput {
        test_state.*.output = wl.wl_output.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_output, 1))
        test_state.*.hasOutput = true
    } else if isNamed(global.interface, "zxdg_output_manager_v1") {
        test_state.*.outputManager = wl.zxdg_output_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.zxdg_output_manager_v1, 3))
        test_state.*.hasOutputManager = true
    } else if isNamed(global.interface, "zwp_idle_inhibit_manager_v1") {
        test_state.*.inhibitManager = wl.zwp_idle_inhibit_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.zwp_idle_inhibit_manager_v1, 1))
        test_state.*.hasInhibitManager = true
    } else if isNamed(global.interface, "xdg_activation_v1") {
        test_state.*.activation = wl.xdg_activation_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.xdg_activation_v1, 1))
        test_state.*.hasActivation = true
    }
}

fn onXdgOutput(context: *anyopaque, event: wl.client.Event) -> void {
    const test_state = testOf(context)
    const decoded = wl.zxdg_output_v1.decodeEvent(event)
    if event.opcode == wl.zxdg_output_v1.EVENT_LOGICAL_SIZE {
        test_state.*.width = decoded.logical_size.width
        test_state.*.height = decoded.logical_size.height
    } else if event.opcode == wl.zxdg_output_v1.EVENT_NAME {
        const name = decoded.name.name
        say("extras: output ")
        sayNumber(test_state.*.width)
        say("x")
        sayNumber(test_state.*.height)
        say(" ")
        say(name.pointer[0..name.length])
        say("\n")
    }
}

fn onToken(context: *anyopaque, event: wl.client.Event) -> void {
    const test_state = testOf(context)
    if event.opcode != wl.xdg_activation_token_v1.EVENT_DONE { return }
    const token = wl.xdg_activation_token_v1.decodeEvent(event).done.token
    var length: usize = 0
    while length < token.length && length < 64 {
        test_state.*.token[length] = token.pointer[length]
        length += 1
    }
    test_state.*.tokenLength = length
    wl.xdg_activation_token_v1.Proxy.fromObject(event.object).destroy()
    if test_state.*.mode == MODE_SOURCE {
        const file = std.fs.open(test_state.*.file, 577, 420)
        if std.fs.isValid(file) {
            const bytes: [*]const u8 = &test_state.*.token
            _ = std.fs.write(file, bytes, length)
            _ = std.fs.close(file)
            say("extras: token written\n")
        }
    } else if test_state.*.mode == MODE_THIEF {
        activate(test_state)
    }
}

fn askToken(test_state: *Test) -> void {
    if !test_state.*.hasActivation { return }
    const token = test_state.*.activation.getActivationToken()
    token.setHandler(onToken, test_state)
    token.setSurface(panelOf(test_state).*.surface)
    token.commit()
}

fn activate(test_state: *Test) -> void {
    if !test_state.*.hasActivation || test_state.*.tokenLength == 0 { return }
    const bytes: [*]const u8 = &test_state.*.token
    test_state.*.activation.activate(bytes[0..test_state.*.tokenLength], panelOf(test_state).*.surface)
    test_state.*.activations += 1
    say("extras: activating\n")
}

// The target reads the token once the source wrote it.
fn readToken(test_state: *Test) -> bool {
    const file = std.fs.open(test_state.*.file, 0, 0)
    if !std.fs.isValid(file) { return false }
    var buffer: [64]u8 = undefined
    const got = std.fs.read(file, &buffer, 64)
    _ = std.fs.close(file)
    if got <= 0 { return false }
    var index: usize = 0
    while index < @intCast(usize, got) {
        test_state.*.token[index] = buffer[index]
        index += 1
    }
    test_state.*.tokenLength = @intCast(usize, got)
    return true
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    canvas_module.clear(canvas, canvas_module.color(255, 80, 160, 90))
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const test_state = testOf(context)
    if kind != panel_module.EVENT_TICK { return }
    test_state.*.ticks += 1
    const ticks = test_state.*.ticks
    if ticks == 2 && test_state.*.hasInhibitManager {
        test_state.*.inhibitor = test_state.*.inhibitManager.createInhibitor(panelOf(test_state).*.surface)
        test_state.*.hasInhibitor = true
    } else if ticks == 6 && test_state.*.hasInhibitor {
        test_state.*.inhibitor.destroy()
        test_state.*.hasInhibitor = false
    }
    if test_state.*.mode == MODE_SOURCE && ticks == 4 { askToken(test_state) }
    if test_state.*.mode == MODE_THIEF && ticks == 4 { askToken(test_state) }
    if test_state.*.mode == MODE_TARGET && test_state.*.activations < 2 && ticks % 2 == 0 && readToken(test_state) { activate(test_state) }
    if ticks >= 40 { panelOf(test_state).*.running = false }
}

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Test), 16)
    if memory == null { return }
    const test_state: *Test = unsafe { @ptrCast(*Test, memory.?) }
    test_state.*.mode = MODE_THIEF
    unsafe { test_state.*.file = @ptrCast([*]const u8, "") }
    if arguments.length > 1 && arguments[1][0] == 115 { test_state.*.mode = MODE_SOURCE }
    if arguments.length > 1 && arguments[1][0] == 116 && arguments[1][1] == 97 { test_state.*.mode = MODE_TARGET }
    if arguments.length > 2 { test_state.*.file = arguments[2] }
    test_state.*.hasOutput = false
    test_state.*.hasOutputManager = false
    test_state.*.hasInhibitManager = false
    test_state.*.hasInhibitor = false
    test_state.*.hasActivation = false
    test_state.*.tokenLength = 0
    test_state.*.width = 0
    test_state.*.height = 0
    test_state.*.ticks = 0
    test_state.*.activations = 0
    const panel = panelOf(test_state)
    panel.*.context = test_state
    panel.*.draw = draw
    panel.*.event = onEvent
    const title = if test_state.*.mode == MODE_TARGET { "Extras Target" } else if test_state.*.mode == MODE_SOURCE { "Extras Source" } else { "Extras Thief" }
    try panel_module.openWindow(panel, allocator, arguments, title, "org.mlx.extrastest", 160, 120)
    test_state.*.registry = wl.displayProxy(panel.*.display).getRegistry()
    test_state.*.registry.setHandler(onGlobal, test_state)
    try panel.*.display.roundtrip()
    if test_state.*.hasOutput && test_state.*.hasOutputManager {
        const output = test_state.*.outputManager.getXdgOutput(test_state.*.output)
        output.setHandler(onXdgOutput, test_state)
    }
    panel.*.tickInterval = 250
    try panel_module.run(panel)
    panel_module.close(panel)
}
