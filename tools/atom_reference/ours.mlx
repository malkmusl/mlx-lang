// The kernel's interpreter for a Radeon's firmware tables
// (projects/brix/kernel/atom.mlx) run as a program of the host on a card
// that is a table (tests/support/atom_card.mlx), writing down every
// read, write and wait: what tools/check_atom_reference.sh holds against
// Linux's own interpreter run on the same card (reference.c, which says
// what the two files given are and what is written out, line by line).
//
//   ours ROM RUNS
//
// Where Linux says "stuck" or goes on, this says how the run was
// stopped: "end stopped NAME at TABLE OFFSET OPCODE", and for a write
// that was not taken what it would have written.
const std = @import("std")
const atom = @import("../../projects/brix/kernel/atom.mlx")
const card = @import("../../tests/support/atom_card.mlx")

const ROM_ROOM: usize = 0x100000
const RUNS_ROOM: usize = 0x400000
const SCRATCH_WORDS: usize = 5120

var rom: [ROM_ROOM]u8 = undefined
var runs: [RUNS_ROOM]u8 = undefined
var scratch: [SCRATCH_WORDS]u32 = undefined
var params: [atom.PARAMETERS]u32 = undefined
var machine: atom.Atom = undefined
var result: atom.Result = undefined

// What is written out, gathered and sent on by the 64 KiB.
const OUT: usize = 65536
var out: [OUT]u8 = undefined
var filled: usize = 0

fn flush() -> void {
    _ = std.io.writeAll(std.io.stdout(), out[0..filled])
    filled = 0
}

fn say(text: []const u8) -> void {
    if filled + text.length > OUT { flush() }
    var k: usize = 0
    while k < text.length {
        out[filled + k] = text[k]
        k += 1
    }
    filled += text.length
}

fn decimal(value: usize) -> void {
    var digits: [20]u8 = undefined
    var at: usize = 20
    var rest = value
    while true {
        at -= 1
        digits[at] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        if rest == 0 { break }
    }
    say(digits[at..20])
}

// `digits` hex digits at least (more when the number has more).
fn hex(value: usize, digits: usize) -> void {
    var count = digits
    while count < 16 && (value >> @intCast(u6, count * 4)) != 0 { count += 1 }
    var text: [16]u8 = undefined
    var k: usize = 0
    while k < count {
        const digit = (value >> @intCast(u6, (count - 1 - k) * 4)) & 15
        text[k] = @intCast(u8, if digit < 10 { 48 + digit } else { 87 + digit })
        k += 1
    }
    say(text[0..count])
}

// Each thing the card is asked, as it happens.
fn watch(kind: card.Kind, number: usize, value: usize) -> void {
    if kind == card.Kind.delay {
        say("D ")
        decimal(number)
        say("\n")
        return
    }
    const register = kind == card.Kind.read || kind == card.Kind.write
    say(match kind {
        .read => "R ",
        .write => "W ",
        .pll_read => "PR ",
        .pll_write => "PW ",
        .mc_read => "MR ",
        .mc_write => "MW ",
        .delay => ""
    })
    hex(number, if register { 5 } else { 2 })
    say(" ")
    hex(value, 8)
    say("\n")
}

fn fold(digest: usize, word: usize) -> usize { return (digest ^ word) *% 1099511628211 }

// The next number of the runs' text (decimal), from `at` on; `at` moves
// behind it. Blanks before it are passed over; at a line's end there is
// none.
var runsLength: usize = 0

fn number(at: *usize, found: *bool) -> usize {
    while at.* < runsLength && runs[at.*] == 32 { at.* += 1 }
    found.* = false
    var value: usize = 0
    while at.* < runsLength && runs[at.*] >= 48 && runs[at.*] <= 57 {
        value = value * 10 + @intCast(usize, runs[at.*] - 48)
        found.* = true
        at.* += 1
    }
    return value
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if std.process.count(arguments) < 3 {
        say("usage: ours ROM RUNS\n")
        flush()
        return 2
    }
    const romBytes: [*]u8 = &rom
    const romLength = std.fs.readFile(arguments[1], romBytes, ROM_ROOM)
    const runsBytes: [*]u8 = &runs
    runsLength = std.fs.readFile(arguments[2], runsBytes, RUNS_ROOM)
    card.watcher = watch
    var opened = false
    var run: usize = 0
    var at: usize = 0
    while at < runsLength {
        var found = false
        const table = number(&at, &found)
        if !found {
            // (A line that does not begin with a number is passed over.)
            while at < runsLength && runs[at] != 10 { at += 1 }
            at += 1
            continue
        }
        const seed = number(&at, &found)
        const fresh = number(&at, &found)
        const steps = number(&at, &found)
        const count = number(&at, &found)
        var k: usize = 0
        while k < atom.PARAMETERS {
            params[k] = 0
            k += 1
        }
        k = 0
        while k < count {
            const word = number(&at, &found)
            if k < atom.PARAMETERS { params[k] = @intCast(u32, word & 0xFFFFFFFF) }
            k += 1
        }
        while at < runsLength && runs[at] != 10 { at += 1 }
        at += 1
        if fresh != 0 || !opened {
            if machine.open(rom[0..romLength], scratch[0..]) != atom.Opened.ok {
                say("open failed\n")
                flush()
                return 0
            }
            opened = true
        }
        card.reset(seed)
        say("run ")
        decimal(run)
        say(" table ")
        decimal(table)
        say(" seed ")
        decimal(seed)
        say("\n")
        run += 1
        // (The card's clock goes on only by the waits the tables ask for,
        // which Linux's 20 seconds do not count: no limit of time here.)
        var limits = atom.Limits.usual()
        limits.time = 0x7FFFFFFFFFFFFFFF
        if steps != 0 { limits.steps = steps }
        const hands = card.hands()
        _ = machine.run(&hands, table, params[0..], &limits, &result)
        if result.end == atom.End.done {
            say("end done\n")
        } else if result.end == atom.End.absent {
            say("end absent\n")
        } else {
            say("end stopped ")
            say(match result.end {
                .outside => "outside",
                .unknown_opcode => "unknown_opcode",
                .bad_case => "bad_case",
                .bad_program => "bad_program",
                .depth => "depth",
                .count => "count",
                .time => "time",
                .refused => "refused",
                .unreachable => "unreachable",
                .forbidden => "forbidden",
                .done => "done",
                .absent => "absent"
            })
            say(" at ")
            decimal(result.table)
            say(" ")
            hex(result.offset, 4)
            say(" ")
            hex(result.opcode, 2)
            say("\n")
        }
        say("ps")
        var digest: usize = 0xCBF29CE484222325
        k = 0
        while k < atom.PARAMETERS {
            if k < 16 {
                say(" ")
                hex(@intCast(usize, params[k]), 8)
            }
            digest = fold(digest, @intCast(usize, params[k]))
            k += 1
        }
        say(" ")
        hex(digest, 16)
        say("\nstate ")
        hex(machine.quotient, 8)
        say(" ")
        hex(machine.remainder, 8)
        say(" ")
        hex(machine.shift, 2)
        say(" ")
        hex(machine.attributes, 4)
        say(if machine.equal { " 1" } else { " 0" })
        say(if machine.above { " 1 " } else { " 0 " })
        hex(machine.dataBlock, 4)
        say(" ")
        hex(machine.regBlock, 4)
        say(" ")
        hex(machine.fbBase, 8)
        say(" ")
        hex(machine.port, 1)
        say("\nfb ")
        digest = 0xCBF29CE484222325
        k = 0
        while k < SCRATCH_WORDS {
            digest = fold(digest, @intCast(usize, scratch[k]))
            k += 1
        }
        hex(digest, 16)
        say("\n")
        if result.odd != 0 {
            // (What the run went on after, as Linux does: for the reader,
            // not held against Linux's lines.)
            say("# went on after ")
            decimal(result.odd)
            say(" (first: ")
            say(match result.oddKind {
                .none => "none",
                .division_by_zero => "a division by zero",
                .port => "a register by PCI or an IO port",
                .no_program => "an IO mode without a program",
                .scratch => "the scratch beyond its end",
                .not_built => "REPEAT, SAVEREG or RESTOREREG"
            })
            say(" in table ")
            decimal(result.oddTable)
            say(" at ")
            hex(result.oddOffset, 4)
            say(")\n")
        }
    }
    flush()
    return 0
}
