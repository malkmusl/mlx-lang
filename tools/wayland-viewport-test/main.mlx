// A window for the desktop's tests of the compositor's viewports
// (projects/desktop/compositor/viewport.mlx, buffers.mlx) and named
// cursors (pointer.mlx): its 40 x 30 buffer is a checkerboard of 10 pixel
// squares in eight colours, of which a viewport crops the 20 x 10 at 10,
// 10 (two squares) and scales them to 160 x 80; below that, a subsurface
// shows a one-pixel buffer (single-pixel-buffer) stretched to 160 x 16.
// The window is 160 x 96.
//
//   wayland-viewport-test scale     shows it until it is closed
//   wayland-viewport-test resize    then, after the first frame, sizes
//                                   the window's surface 80 x 40 without
//                                   a new buffer
//   wayland-viewport-test outside   crops beyond the buffer (the
//                                   compositor must end it: out_of_buffer)
//   wayland-viewport-test fraction  crops a fraction of a pixel with no
//                                   size (bad_size)
//   wayland-viewport-test twice     asks for two viewports of one surface
//                                   (viewport_exists)
//   wayland-viewport-test cursor    names the text cursor (cursor-shape)
//                                   when the pointer enters
//   wayland-viewport-test badshape  names a shape there is not
//                                   (invalid_shape)
//
// It prints `viewport-test: preferred scale N` (fractional-scale),
// `viewport-test: shown`, `viewport-test: resized`, `viewport-test: cursor
// N` and, when the compositor ends it, `viewport-test: error N` with the
// error's code.
const std = @import("std")
const wl = @import("std.wayland")
const crash = @import("std.crash")

const BUFFER_WIDTH: i32 = 40
const BUFFER_HEIGHT: i32 = 30
const BUFFER_SIZE: usize = 4800
const SQUARE: usize = 10

const MODE_SCALE: u8 = 0
const MODE_RESIZE: u8 = 1
const MODE_OUTSIDE: u8 = 2
const MODE_FRACTION: u8 = 3
const MODE_TWICE: u8 = 4
const MODE_CURSOR: u8 = 5
const MODE_BAD_SHAPE: u8 = 6
// wp_cursor_shape_device_v1's text shape.
const SHAPE_TEXT: u32 = 9

const Test = struct {
    display: wl.client.Display
    registry: wl.wl_registry.Proxy
    compositor: wl.wl_compositor.Proxy
    hasCompositor: bool
    shm: wl.wl_shm.Proxy
    hasShm: bool
    subcompositor: wl.wl_subcompositor.Proxy
    hasSubcompositor: bool
    wmBase: wl.xdg_wm_base.Proxy
    hasWmBase: bool
    viewporter: wl.wp_viewporter.Proxy
    hasViewporter: bool
    fractional: wl.wp_fractional_scale_manager_v1.Proxy
    hasFractional: bool
    singlePixel: wl.wp_single_pixel_buffer_manager_v1.Proxy
    hasSinglePixel: bool
    seat: wl.wl_seat.Proxy
    hasSeat: bool
    shapes: wl.wp_cursor_shape_manager_v1.Proxy
    hasShapes: bool
    shapeDevice: wl.wp_cursor_shape_device_v1.Proxy
    surface: wl.wl_surface.Proxy
    xdgSurface: wl.xdg_surface.Proxy
    viewport: wl.wp_viewport.Proxy
    mode: u8
    configured: bool
    closed: bool
    frames: u32
}

fn testOf(context: *anyopaque) -> *Test {
    unsafe { return @ptrCast(*Test, context) }
}

fn contextOf(test_state: *Test) -> *anyopaque {
    unsafe { return @ptrCast(*anyopaque, test_state) }
}

fn say(text: []const u8) -> void {
    _ = std.io.writeAll(std.io.stdout(), text)
}

fn sayNumber(value: u32) -> void {
    var digits: [12]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[11 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    _ = std.io.writeAll(std.io.stdout(), digits[12 - count..12])
}

fn named(global: wl.String, name: []const u8) -> bool {
    return std.string.eql(global, std.string.fromSlice(name))
}

fn onRegistry(context: *anyopaque, event: wl.client.Event) -> void {
    const test_state = testOf(context)
    const decoded = wl.wl_registry.decodeEvent(event)
    if @tagOf(decoded) != 0 { return }
    const global = decoded.global
    const registry = test_state.*.registry
    if named(global.interface, "wl_compositor") {
        test_state.*.compositor = wl.wl_compositor.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_compositor, 4))
        test_state.*.hasCompositor = true
    } else if named(global.interface, "wl_shm") {
        test_state.*.shm = wl.wl_shm.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_shm, 1))
        test_state.*.hasShm = true
    } else if named(global.interface, "wl_subcompositor") {
        test_state.*.subcompositor = wl.wl_subcompositor.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_subcompositor, 1))
        test_state.*.hasSubcompositor = true
    } else if named(global.interface, "xdg_wm_base") {
        test_state.*.wmBase = wl.xdg_wm_base.Proxy.fromObject(registry.bind(global.name, wl.Interface.xdg_wm_base, 1))
        test_state.*.hasWmBase = true
    } else if named(global.interface, "wp_viewporter") {
        test_state.*.viewporter = wl.wp_viewporter.Proxy.fromObject(registry.bind(global.name, wl.Interface.wp_viewporter, 1))
        test_state.*.hasViewporter = true
    } else if named(global.interface, "wp_fractional_scale_manager_v1") {
        test_state.*.fractional = wl.wp_fractional_scale_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.wp_fractional_scale_manager_v1, 1))
        test_state.*.hasFractional = true
    } else if named(global.interface, "wl_seat") {
        test_state.*.seat = wl.wl_seat.Proxy.fromObject(registry.bind(global.name, wl.Interface.wl_seat, 1))
        test_state.*.hasSeat = true
    } else if named(global.interface, "wp_cursor_shape_manager_v1") {
        test_state.*.shapes = wl.wp_cursor_shape_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.wp_cursor_shape_manager_v1, 1))
        test_state.*.hasShapes = true
    } else if named(global.interface, "wp_single_pixel_buffer_manager_v1") {
        test_state.*.singlePixel = wl.wp_single_pixel_buffer_manager_v1.Proxy.fromObject(registry.bind(global.name, wl.Interface.wp_single_pixel_buffer_manager_v1, 1))
        test_state.*.hasSinglePixel = true
    }
}

fn onWmBase(context: *anyopaque, event: wl.client.Event) -> void {
    const test_state = testOf(context)
    test_state.*.wmBase.pong(wl.xdg_wm_base.decodeEvent(event).ping.serial)
}

fn onXdgSurface(context: *anyopaque, event: wl.client.Event) -> void {
    const test_state = testOf(context)
    test_state.*.xdgSurface.ackConfigure(wl.xdg_surface.decodeEvent(event).configure.serial)
    if test_state.*.configured { return }
    test_state.*.configured = true
    const callback = test_state.*.surface.frame()
    callback.setHandler(onFrame, context)
    test_state.*.surface.commit()
}

fn onToplevel(context: *anyopaque, event: wl.client.Event) -> void {
    if event.opcode == wl.xdg_toplevel.EVENT_CLOSE { testOf(context).*.closed = true }
}

fn onFrame(context: *anyopaque, event: wl.client.Event) -> void {
    const test_state = testOf(context)
    test_state.*.frames += 1
    if test_state.*.frames == 1 {
        say("viewport-test: shown\n")
        if test_state.*.mode == MODE_RESIZE {
            // The same buffer, another size: only the viewport changes.
            test_state.*.viewport.setDestination(80, 40)
            const callback = test_state.*.surface.frame()
            callback.setHandler(onFrame, context)
            test_state.*.surface.commit()
        }
    } else if test_state.*.frames == 2 {
        say("viewport-test: resized\n")
    }
}

fn onPreferredScale(context: *anyopaque, event: wl.client.Event) -> void {
    say("viewport-test: preferred scale ")
    sayNumber(wl.wp_fractional_scale_v1.decodeEvent(event).preferred_scale.scale)
    say("\n")
}

// The pointer came in: the text cursor (or a shape there is not).
fn onPointer(context: *anyopaque, event: wl.client.Event) -> void {
    const test_state = testOf(context)
    if event.opcode != wl.wl_pointer.EVENT_ENTER { return }
    const serial = wl.wl_pointer.decodeEvent(event).enter.serial
    const shape: u32 = if test_state.*.mode == MODE_BAD_SHAPE { 99 } else { SHAPE_TEXT }
    test_state.*.shapeDevice.setShape(serial, shape)
    say("viewport-test: cursor ")
    sayNumber(shape)
    say("\n")
}

fn ignoreEvent(context: *anyopaque, event: wl.client.Event) -> void {}

// The checkerboard: square (column, row) has colour (column + row * 4) % 8.
fn drawBoard(pixels: [*]u8) -> void {
    const colours = [8]u32{ 4294901760, 4278255360, 4278190335, 4294967040, 4294902015, 4278255615, 4286611584, 4294934528 }
    var y: usize = 0
    while y < 30 {
        var x: usize = 0
        while x < 40 {
            const colour = colours[(x / SQUARE + (y / SQUARE) * 4) % 8]
            const at = (y * 40 + x) * 4
            pixels[at] = @intCast(u8, colour & 255)
            pixels[at + 1] = @intCast(u8, (colour >> 8) & 255)
            pixels[at + 2] = @intCast(u8, (colour >> 16) & 255)
            pixels[at + 3] = 255
            x += 1
        }
        y += 1
    }
}

const Failure = error { MissingGlobals, NoSharedMemory }

fn missingGlobals() -> Failure!void { return Failure.MissingGlobals }
fn noSharedMemory() -> Failure!void { return Failure.NoSharedMemory }

fn serve(test_state: *Test) -> !void {
    while test_state.*.display.running() && !test_state.*.closed {
        try test_state.*.display.dispatch()
    }
}

fn run(test_state: *Test) -> !void {
    const allocator = std.page_allocator.init()
    var display: wl.client.Display = undefined
    try wl.client.Display.connect(&display, allocator)
    test_state.*.display = display
    test_state.*.registry = wl.displayProxy(display).getRegistry()
    test_state.*.registry.setHandler(onRegistry, contextOf(test_state))
    try display.roundtrip()
    if !test_state.*.hasCompositor || !test_state.*.hasShm || !test_state.*.hasSubcompositor || !test_state.*.hasWmBase || !test_state.*.hasViewporter || !test_state.*.hasFractional || !test_state.*.hasSinglePixel { return missingGlobals() }
    test_state.*.wmBase.setHandler(onWmBase, contextOf(test_state))
    if test_state.*.mode == MODE_CURSOR || test_state.*.mode == MODE_BAD_SHAPE {
        if !test_state.*.hasSeat || !test_state.*.hasShapes { return missingGlobals() }
        const pointer = test_state.*.seat.getPointer()
        pointer.setHandler(onPointer, contextOf(test_state))
        test_state.*.shapeDevice = test_state.*.shapes.getPointer(pointer)
    }

    var memory: wl.SharedMemory = undefined
    if !wl.transport.createSharedMemory(&memory, BUFFER_SIZE) { return noSharedMemory() }
    drawBoard(memory.bytes())
    const pool = test_state.*.shm.createPool(memory.handle, @intCast(i32, BUFFER_SIZE))
    const buffer = pool.createBuffer(0, BUFFER_WIDTH, BUFFER_HEIGHT, BUFFER_WIDTH * 4, @intFromEnum(wl.wl_shm.Format.xrgb8888))
    pool.destroy()

    const surface = test_state.*.compositor.createSurface()
    test_state.*.surface = surface
    const scale = test_state.*.fractional.getFractionalScale(surface)
    scale.setHandler(onPreferredScale, contextOf(test_state))
    test_state.*.viewport = test_state.*.viewporter.getViewport(surface)
    if test_state.*.mode == MODE_TWICE {
        _ = test_state.*.viewporter.getViewport(surface)
    }
    if test_state.*.mode == MODE_OUTSIDE {
        test_state.*.viewport.setSource(wl.Fixed.fromInt(30), wl.Fixed.fromInt(20), wl.Fixed.fromInt(20), wl.Fixed.fromInt(20))
    } else if test_state.*.mode == MODE_FRACTION {
        test_state.*.viewport.setSource(wl.Fixed.fromInt(10), wl.Fixed.fromInt(10), wl.Fixed.{ .raw = 2600 }, wl.Fixed.fromInt(10))
    } else {
        test_state.*.viewport.setSource(wl.Fixed.fromInt(10), wl.Fixed.fromInt(10), wl.Fixed.fromInt(20), wl.Fixed.fromInt(10))
        test_state.*.viewport.setDestination(160, 80)
    }
    test_state.*.xdgSurface = test_state.*.wmBase.getXdgSurface(surface)
    test_state.*.xdgSurface.setHandler(onXdgSurface, contextOf(test_state))
    const toplevel = test_state.*.xdgSurface.getToplevel()
    toplevel.setHandler(onToplevel, contextOf(test_state))
    toplevel.setTitle("Viewport Test")
    toplevel.setAppId("org.mlx.ViewportTest")

    // The bar: one orange pixel (premultiplied, opaque) 160 x 16.
    const bar = test_state.*.compositor.createSurface()
    const bar_buffer = test_state.*.singlePixel.createU32RgbaBuffer(4294967295, 2155905152, 0, 4294967295)
    const bar_viewport = test_state.*.viewporter.getViewport(bar)
    bar_viewport.setDestination(160, 16)
    const subsurface = test_state.*.subcompositor.getSubsurface(bar, surface)
    subsurface.setPosition(0, 80)
    bar.attach(&bar_buffer, 0, 0)
    bar.damage(0, 0, 1, 1)
    bar.commit()

    surface.attach(&buffer, 0, 0)
    surface.damage(0, 0, BUFFER_WIDTH, BUFFER_HEIGHT)
    surface.commit()

    // A protocol error ends the connection (and the loop with an error).
    @discardError(serve(test_state))
    if display.errorObjectId() != 0 {
        say("viewport-test: error ")
        sayNumber(display.errorCode())
        say("\n")
    }
    memory.release()
    display.disconnect()
}

pub fn main(arguments: [][*]const u8) -> !void {
    _ = crash.install()
    var test_state: Test = undefined
    test_state.hasCompositor = false
    test_state.hasShm = false
    test_state.hasSubcompositor = false
    test_state.hasWmBase = false
    test_state.hasViewporter = false
    test_state.hasFractional = false
    test_state.hasSinglePixel = false
    test_state.hasSeat = false
    test_state.hasShapes = false
    test_state.configured = false
    test_state.closed = false
    test_state.frames = 0
    test_state.mode = MODE_SCALE
    if std.process.count(arguments) > 1 {
        const mode = std.process.argument(arguments, 1)
        if std.string.eql(mode, std.string.fromSlice("resize")) { test_state.mode = MODE_RESIZE }
        if std.string.eql(mode, std.string.fromSlice("outside")) { test_state.mode = MODE_OUTSIDE }
        if std.string.eql(mode, std.string.fromSlice("fraction")) { test_state.mode = MODE_FRACTION }
        if std.string.eql(mode, std.string.fromSlice("twice")) { test_state.mode = MODE_TWICE }
        if std.string.eql(mode, std.string.fromSlice("cursor")) { test_state.mode = MODE_CURSOR }
        if std.string.eql(mode, std.string.fromSlice("badshape")) { test_state.mode = MODE_BAD_SHAPE }
    }
    try run(&test_state)
}
