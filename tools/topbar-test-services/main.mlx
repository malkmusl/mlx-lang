// A music player and a tray icon on the session bus, for the top bar's
// test (tools/check_desktop_clients.sh): an MPRIS player
// (org.mpris.MediaPlayer2.mlxtest, playing "Testlied" by "Mlx Band") and a
// StatusNotifierItem (org.kde.StatusNotifierItem-PID-1, a red 16x16 and a
// blue 32x32 IconPixmap, a com.canonical.dbusmenu menu at /MenuBar with
// "Öffnen", a separator, "Beenden" and "Aus", which cannot be chosen). It
// registers the item once there is a StatusNotifierWatcher. What is asked
// of it goes into LOG, a line each:
//
//   PlayPause Paused | Next | Previous | Raise | SetPosition N
//   Activate X Y | SecondaryActivate X Y | ContextMenu X Y | Event ID clicked
//   registered
//
//   topbar-test-services LOG
//
// It ends with the bus, or after a minute.
const std = @import("std")
const dbus = @import("std.dbus")

const PLAYER_NAME: []const u8 = "org.mpris.MediaPlayer2.mlxtest"
const PLAYER: []const u8 = "org.mpris.MediaPlayer2.Player"
const ROOT: []const u8 = "org.mpris.MediaPlayer2"
const PLAYER_PATH: []const u8 = "/org/mpris/MediaPlayer2"
const ITEM: []const u8 = "org.kde.StatusNotifierItem"
const ITEM_PATH: []const u8 = "/StatusNotifierItem"
const MENU: []const u8 = "com.canonical.dbusmenu"
const MENU_PATH: []const u8 = "/MenuBar"
const PROPERTIES: []const u8 = "org.freedesktop.DBus.Properties"
const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const WATCHER: []const u8 = "org.kde.StatusNotifierWatcher"
const SIZE: usize = 16384

const Services = struct {
    client: dbus.Client
    log: isize
    playing: bool
    second: bool
    itemName: [64]u8
    itemLength: usize
    registered: bool
    out: [*]u8
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn clientOf(services: *Services) -> *dbus.Client {
    unsafe { return @ptrCast(*dbus.Client, &services.*.client) }
}

fn itemNameOf(services: *Services) -> []const u8 {
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &services.*.itemName) }
    return bytes[0..services.*.itemLength]
}

fn write(services: *Services, text: []const u8) -> void {
    const written = std.io.writeAll(std.fs.File.{ .descriptor = services.*.log }, text)
}

fn writeNumber(services: *Services, value: i64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = if value < 0 { 0 - value } else { value }
    while rest > 0 || count == 0 {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    if value < 0 {
        digits[23 - count] = 45
        count += 1
    }
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrCast([*]const u8, &digits) }
    write(services, bytes[24 - count..24])
}

fn noDescriptors() -> [*]const isize {
    var none: [*]const isize = undefined
    unsafe { none = @ptrFromInt([*]const isize, 8) }
    return none
}

fn putI64(writing: *dbus.Writer, value: i64) -> void {
    dbus.pad(writing, 8)
    const bits = @bitCast(u64, value)
    dbus.putU32(writing, @intCast(u32, bits & 4294967295))
    dbus.putU32(writing, @intCast(u32, bits >> 32))
}

// A dictionary entry {sv} with a string (or object path: `code` "o").
fn entryString(writing: *dbus.Writer, key: []const u8, code: []const u8, value: []const u8) -> void {
    dbus.pad(writing, 8)
    dbus.putString(writing, key)
    dbus.putSignature(writing, code)
    dbus.putString(writing, value)
}

fn entryBool(writing: *dbus.Writer, key: []const u8, value: bool) -> void {
    dbus.pad(writing, 8)
    dbus.putString(writing, key)
    dbus.putSignature(writing, "b")
    dbus.putBool(writing, value)
}

// ---------------------------------------------------------------------------
// The player

fn putMetadata(services: *Services, writing: *dbus.Writer) -> void {
    dbus.putSignature(writing, "a{sv}")
    const at = dbus.beginArray(writing, 8)
    entryString(writing, "mpris:trackid", "o", if services.*.second { "/org/mlx/track/2" } else { "/org/mlx/track/1" })
    entryString(writing, "xesam:title", "s", if services.*.second { "Zweites Lied" } else { "Testlied" })
    dbus.pad(writing, 8)
    dbus.putString(writing, "xesam:artist")
    dbus.putSignature(writing, "as")
    const artists = dbus.beginArray(writing, 4)
    dbus.putString(writing, "Mlx Band")
    dbus.endArray(writing, artists, 4)
    entryString(writing, "xesam:album", "s", "Probe")
    dbus.pad(writing, 8)
    dbus.putString(writing, "mpris:length")
    dbus.putSignature(writing, "x")
    putI64(writing, 180000000)
    dbus.endArray(writing, at, 8)
}

fn putPlayerProperties(services: *Services, writing: *dbus.Writer) -> void {
    const at = dbus.beginArray(writing, 8)
    entryString(writing, "PlaybackStatus", "s", if services.*.playing { "Playing" } else { "Paused" })
    dbus.pad(writing, 8)
    dbus.putString(writing, "Metadata")
    putMetadata(services, writing)
    entryBool(writing, "CanGoNext", true)
    entryBool(writing, "CanGoPrevious", true)
    entryBool(writing, "CanPlay", true)
    entryBool(writing, "CanPause", true)
    dbus.pad(writing, 8)
    dbus.putString(writing, "Position")
    dbus.putSignature(writing, "x")
    putI64(writing, 42000000)
    dbus.endArray(writing, at, 8)
}

// PropertiesChanged(Player, {PlaybackStatus or Metadata}, []).
fn announce(services: *Services, metadata: bool) -> void {
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, services.*.out, SIZE, false)
    dbus.putString(&writing, PLAYER)
    const at = dbus.beginArray(&writing, 8)
    if metadata {
        dbus.pad(&writing, 8)
        dbus.putString(&writing, "Metadata")
        putMetadata(services, &writing)
    } else {
        entryString(&writing, "PlaybackStatus", "s", if services.*.playing { "Playing" } else { "Paused" })
    }
    dbus.endArray(&writing, at, 8)
    const strings = dbus.beginArray(&writing, 4)
    dbus.endArray(&writing, strings, 4)
    var header = dbus.newHeader(dbus.SIGNAL, 0)
    header.path = PLAYER_PATH
    header.interface = PROPERTIES
    header.member = "PropertiesChanged"
    header.signature = "sa{sv}as"
    const serial = dbus.send(clientOf(services), &header, services.*.out, writing.length, noDescriptors(), 0)
}

// ---------------------------------------------------------------------------
// The item

// A square pixmap (ARGB32, network order) of one colour.
fn putPixmap(writing: *dbus.Writer, size: u32, red: u8, green: u8, blue: u8) -> void {
    dbus.pad(writing, 8)
    dbus.putU32(writing, size)
    dbus.putU32(writing, size)
    const at = dbus.beginArray(writing, 1)
    var index: u32 = 0
    while index < size * size {
        dbus.putByte(writing, 255)
        dbus.putByte(writing, red)
        dbus.putByte(writing, green)
        dbus.putByte(writing, blue)
        index += 1
    }
    dbus.endArray(writing, at, 1)
}

fn putItemProperties(writing: *dbus.Writer) -> void {
    const at = dbus.beginArray(writing, 8)
    entryString(writing, "Category", "s", "ApplicationStatus")
    entryString(writing, "Id", "s", "mlxtest")
    entryString(writing, "Title", "s", "Mlx Test")
    entryString(writing, "Status", "s", "Active")
    entryString(writing, "IconName", "s", "")
    entryString(writing, "Menu", "o", MENU_PATH)
    entryBool(writing, "ItemIsMenu", false)
    dbus.pad(writing, 8)
    dbus.putString(writing, "IconPixmap")
    dbus.putSignature(writing, "a(iiay)")
    const pixmaps = dbus.beginArray(writing, 8)
    putPixmap(writing, 16, 230, 40, 40)
    putPixmap(writing, 32, 40, 90, 230)
    dbus.endArray(writing, pixmaps, 8)
    dbus.endArray(writing, at, 8)
}

// A menu entry (ia{sv}av) as a variant.
fn putEntry(writing: *dbus.Writer, id: u32, label: []const u8, separator: bool, enabled: bool) -> void {
    dbus.putSignature(writing, "(ia{sv}av)")
    dbus.pad(writing, 8)
    dbus.putU32(writing, id)
    const at = dbus.beginArray(writing, 8)
    if separator { entryString(writing, "type", "s", "separator") }
    if label.length > 0 { entryString(writing, "label", "s", label) }
    if !enabled { entryBool(writing, "enabled", false) }
    dbus.endArray(writing, at, 8)
    const children = dbus.beginArray(writing, 1)
    dbus.endArray(writing, children, 1)
}

fn putLayout(writing: *dbus.Writer) -> void {
    dbus.putU32(writing, 1)
    dbus.pad(writing, 8)
    dbus.putU32(writing, 0)
    const at = dbus.beginArray(writing, 8)
    entryString(writing, "children-display", "s", "submenu")
    dbus.endArray(writing, at, 8)
    const children = dbus.beginArray(writing, 1)
    putEntry(writing, 1, "_Öffnen", false, true)
    putEntry(writing, 2, "", true, true)
    putEntry(writing, 3, "Beenden", false, true)
    putEntry(writing, 4, "Aus", false, false)
    dbus.endArray(writing, children, 1)
}

// ---------------------------------------------------------------------------
// Calls

fn replyWith(services: *Services, request: *const dbus.Header, signature: []const u8, writing: *dbus.Writer) -> void {
    const serial = dbus.reply(clientOf(services), request, signature, services.*.out, writing.*.length, noDescriptors(), 0)
}

fn failed(services: *Services, request: *const dbus.Header) -> void {
    var header = dbus.newHeader(dbus.ERROR, 0)
    header.replySerial = request.*.serial
    header.hasReplySerial = true
    header.destination = request.*.sender
    header.errorName = "org.freedesktop.DBus.Error.UnknownMethod"
    const serial = dbus.send(clientOf(services), &header, services.*.out, 0, noDescriptors(), 0)
}

fn called(services: *Services, request: *const dbus.Header) -> void {
    const client = clientOf(services)
    var reading = dbus.reader(dbus.bodyOf(client, request), request.*.bodyLength, request.*.big)
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, services.*.out, SIZE, false)
    const interface = request.*.interface
    const member = request.*.member
    if same(interface, PROPERTIES) && same(member, "GetAll") {
        const asked = dbus.readString(&reading)
        if same(asked, PLAYER) {
            putPlayerProperties(services, &writing)
        } else if same(asked, ITEM) {
            putItemProperties(&writing)
        } else {
            const at = dbus.beginArray(&writing, 8)
            dbus.endArray(&writing, at, 8)
        }
        replyWith(services, request, "a{sv}", &writing)
        return
    }
    if same(interface, PROPERTIES) && same(member, "Get") {
        const asked = dbus.readString(&reading)
        const name = dbus.readString(&reading)
        if same(name, "Identity") {
            dbus.putVariantString(&writing, "Mlx Testplayer")
        } else if same(name, "Position") {
            dbus.putSignature(&writing, "x")
            putI64(&writing, 42000000)
        } else {
            failed(services, request)
            return
        }
        replyWith(services, request, "v", &writing)
        return
    }
    if same(interface, PLAYER) || same(interface, ROOT) {
        write(services, member)
        if same(member, "PlayPause") {
            services.*.playing = !services.*.playing
            write(services, if services.*.playing { " Playing" } else { " Paused" })
        }
        if same(member, "Next") || same(member, "Previous") { services.*.second = same(member, "Next") }
        if same(member, "SetPosition") {
            const track = dbus.readString(&reading)
            dbus.alignTo(&reading, 8)
            const low = @intCast(u64, dbus.readU32(&reading))
            const high = @intCast(u64, dbus.readU32(&reading))
            write(services, " ")
            writeNumber(services, @bitCast(i64, (high << 32) | low) / 1000000)
        }
        write(services, "\n")
        replyWith(services, request, "", &writing)
        if same(member, "PlayPause") { announce(services, false) }
        if same(member, "Next") || same(member, "Previous") { announce(services, true) }
        return
    }
    if same(interface, ITEM) {
        const x = @bitCast(i32, dbus.readU32(&reading))
        const y = @bitCast(i32, dbus.readU32(&reading))
        write(services, member)
        write(services, " ")
        writeNumber(services, @intCast(i64, x))
        write(services, " ")
        writeNumber(services, @intCast(i64, y))
        write(services, "\n")
        replyWith(services, request, "", &writing)
        return
    }
    if same(interface, MENU) {
        if same(member, "GetLayout") {
            putLayout(&writing)
            replyWith(services, request, "u(ia{sv}av)", &writing)
            return
        }
        if same(member, "AboutToShow") {
            dbus.putBool(&writing, false)
            replyWith(services, request, "b", &writing)
            return
        }
        if same(member, "Event") {
            const id = dbus.readU32(&reading)
            const event = dbus.readString(&reading)
            write(services, "Event ")
            writeNumber(services, @intCast(i64, id))
            write(services, " ")
            write(services, event)
            write(services, "\n")
            replyWith(services, request, "", &writing)
            return
        }
    }
    failed(services, request)
}

fn requestName(services: *Services, name: []const u8) -> void {
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, services.*.out, SIZE, false)
    dbus.putString(&writing, name)
    dbus.putU32(&writing, 4)
    const serial = dbus.call(clientOf(services), BUS, BUS_PATH, BUS, "RequestName", "su", services.*.out, writing.length)
}

// Asks whether there is a watcher yet (the reply comes with the rest).
fn askWatcher(services: *Services) -> u32 {
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, services.*.out, SIZE, false)
    dbus.putString(&writing, WATCHER)
    return dbus.call(clientOf(services), BUS, BUS_PATH, BUS, "NameHasOwner", "s", services.*.out, writing.length)
}

const Failure = error { Usage, NoMemory, NoLog, NoBus }

fn fail(failure: Failure) -> Failure!void { return failure }

pub fn main(arguments: [][*]const u8) -> !void {
    if arguments.length < 2 { return fail(Failure.Usage) }
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(Services), 16)
    const out = allocator.alloc(SIZE, 16)
    if memory == null || out == null { return fail(Failure.NoMemory) }
    var services: *Services = undefined
    unsafe { services = @ptrCast(*Services, memory.?) }
    services.*.out = out.?
    services.*.playing = true
    services.*.second = false
    services.*.registered = false
    // O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC.
    services.*.log = std.linux.syscall3(2, @intFromPtr(arguments[1]), 1 | 64 | 512 | 524288, 420)
    if services.*.log < 0 { return fail(Failure.NoLog) }
    const client = clientOf(services)
    if !dbus.connectSession(client, allocator, environment) { return fail(Failure.NoBus) }
    // org.kde.StatusNotifierItem-PID-1.
    const prefix = "org.kde.StatusNotifierItem-"
    var length: usize = 0
    for byte in prefix {
        services.*.itemName[length] = byte
        length += 1
    }
    var digits: [12]u8 = undefined
    var count: usize = 0
    var pid = @bitCast(usize, std.linux.syscall0(39))
    while pid > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + pid % 10)
        pid = pid / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        services.*.itemName[length] = digits[count]
        length += 1
    }
    services.*.itemName[length] = 45
    services.*.itemName[length + 1] = 49
    services.*.itemLength = length + 2
    requestName(services, PLAYER_NAME)
    requestName(services, itemNameOf(services))
    var asked = askWatcher(services)
    var askedAt = std.time.milliseconds()
    const started = std.time.milliseconds()
    var header: dbus.Header = undefined
    while std.time.milliseconds() - started < 60000 {
        if dbus.next(client, &header, 200) {
            if header.kind == dbus.METHOD_CALL {
                called(services, &header)
            } else if header.kind == dbus.METHOD_RETURN && header.hasReplySerial && header.replySerial == asked && !services.*.registered {
                var reading = dbus.reader(dbus.bodyOf(client, &header), header.bodyLength, header.big)
                if dbus.readBool(&reading) {
                    var writing: dbus.Writer = undefined
                    dbus.begin(&writing, services.*.out, SIZE, false)
                    dbus.putString(&writing, itemNameOf(services))
                    const serial = dbus.call(client, WATCHER, "/StatusNotifierWatcher", WATCHER, "RegisterStatusNotifierItem", "s", services.*.out, writing.length)
                    services.*.registered = true
                    write(services, "registered\n")
                }
            }
        } else if client.*.closed {
            break
        }
        if !services.*.registered && std.time.milliseconds() - askedAt > 300 {
            asked = askWatcher(services)
            askedAt = std.time.milliseconds()
        }
    }
}
