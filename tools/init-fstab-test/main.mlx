// Drives the fstab checker without becoming PID 1 or mounting anything.
// The shell check supplies a recording fsck front-end and verifies pass
// ordering, escaped fields, and the entries that must be skipped.
const std = @import("std")
const config = @import("../../projects/init/config.mlx")
const mounts = @import("../../projects/init/mounts.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    if std.process.count(arguments) != 3 { return 2 }
    const memory = std.heap.allocator().alloc(@sizeOf(config.State), 16)
    if memory == null { return 2 }
    var state: *config.State = undefined
    unsafe { state = @ptrCast(*config.State, memory.?) }
    state.*.verbose = false
    config.setMountsFile(state, std.string.asSlice(std.process.argument(arguments, 1)))
    return if mounts.checkFileSystems(state, std.string.asSlice(std.process.argument(arguments, 2))) { 0 } else { 1 }
}
