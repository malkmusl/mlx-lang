// A readiness fixture: first a closed socket inode occupies the configured
// path, then it is replaced with an actual listening Unix socket.
const std = @import("std")
const linux = @import("../../projects/init/linux.mlx")

pub fn main(arguments: [][*]const u8) -> u8 {
    if std.process.count(arguments) != 2 { return 2 }
    const path = std.string.asSlice(std.process.argument(arguments, 1))
    const stale = linux.listen(path, 1)
    if stale < 0 { return 1 }
    std.linux.close(stale)
    std.linux.sleepMilliseconds(500)
    const listener = linux.listen(path, 4)
    if listener < 0 { return 1 }
    std.linux.sleepMilliseconds(100000)
    std.linux.close(listener)
    return 0
}
