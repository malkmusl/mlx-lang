// What std.ui's drawing costs, timed on this machine without a display:
// a canvas in memory the size of a screen, the pixel loops one by one
// (fills, a rounded panel, an outline, an icon scaled, a line of text),
// and the terminal (std.ui.terminal) as vector uses it: a window full of
// text drawn whole, one more line at its bottom (cat of a long file), one
// character typed, the cursor moved by one cell.
//
//   mlx4 tools/draw-bench/main.mlx -o draw-bench
//   draw-bench [WIDTHxHEIGHT]            # 1280x960 when not given
//   mlx-profile draw-bench 3840x1080     # then: mlx-codemap hot
//
// Each line says the microseconds one drawing took (the mean of many) and,
// for the terminal, how many pixels the draw said it changed.
const std = @import("std")
const ui = @import("std.ui")
const canvas_module = @import("std.ui.canvas")
const text_module = @import("std.ui.text")
const ui_terminal = @import("std.ui.terminal")
const terminal = @import("std.terminal")
const png = @import("std.png")

const Canvas = canvas_module.Canvas

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn number(value: usize) -> void { _ = std.io.writeUnsigned(std.io.stdout(), value) }

fn nanoseconds() -> usize { return std.time.monotonicNanoseconds() }

// "name: N.N us" (and what follows on the line is the caller's).
fn result(name: []const u8, total: usize, times: usize) -> void {
    const tenths = total / times / 100
    say(name)
    say(": ")
    number(tenths / 10)
    say(".")
    number(tenths % 10)
    say(" us")
}

fn line(name: []const u8, total: usize, times: usize) -> void {
    result(name, total, times)
    say("\n")
}

// A background that is not one colour (a fill over it mixes every pixel).
fn pattern(canvas: *Canvas) -> void {
    var row: usize = 0
    while row < canvas.*.height {
        var column: usize = 0
        while column < canvas.*.width {
            canvas.*.pixels[row * canvas.*.stride + column] = 4278190080 | @intCast(u32, (column * 7 + row * 13) & 255) << 16 | @intCast(u32, (column * 3) & 255) << 8 | @intCast(u32, (row * 5) & 255)
            column += 1
        }
        row += 1
    }
}

// A line of a source file's kind, `columns` wide at most, from `seed`.
fn textLine(into: [*]u8, columns: usize, seed: usize) -> usize {
    const words = "const value = canvas.pixels[row * stride + column] if coverage > 0 { blend(canvas, x, y, color) } while index < count // the rest of a line 0123456789 "
    var length = 4 + (seed * 37) % (columns - 4)
    if seed % 5 == 0 { length = columns - 1 }
    var at: usize = 0
    while at < length {
        into[at] = words[(seed * 11 + at) % words.length]
        at += 1
    }
    return length
}

fn parseSize(text: []const u8, width: *usize, height: *usize) -> bool {
    var split: usize = 0
    while split < text.length && text[split] != 120 { split += 1 }
    if split == 0 || split + 1 >= text.length { return false }
    const wide = std.parse.unsigned(std.string.fromSlice(text[0..split]))
    const high = std.parse.unsigned(std.string.fromSlice(text[split + 1..text.length]))
    if !wide.valid || !high.valid || wide.value < 64 || high.value < 64 || wide.value > 16384 || high.value > 16384 { return false }
    width.* = wide.value
    height.* = high.value
    return true
}

fn primitives(canvas: *Canvas, font: *text_module.Text, has_font: bool, allocator: std.allocator.Allocator) -> void {
    const width = @intCast(i32, canvas.*.width)
    const height = @intCast(i32, canvas.*.height)
    var begun = nanoseconds()
    var round: usize = 0
    while round < 20 {
        canvas_module.clear(canvas, 4280032284)
        round += 1
    }
    line("clear, the whole canvas", nanoseconds() - begun, 20)
    begun = nanoseconds()
    round = 0
    while round < 20 {
        canvas_module.fillRect(canvas, 0, 0, width, height, 4280032284 + @intCast(u32, round))
        round += 1
    }
    line("fillRect opaque, the whole canvas", nanoseconds() - begun, 20)
    pattern(canvas)
    begun = nanoseconds()
    round = 0
    while round < 20 {
        canvas_module.fillRect(canvas, 0, 0, width, 30, canvas_module.color(150, 40, 44, 54))
        round += 1
    }
    line("fillRect translucent, a bar 30 high over a picture", nanoseconds() - begun, 20)
    begun = nanoseconds()
    round = 0
    while round < 20 {
        pattern(canvas)
        round += 1
    }
    const pattern_cost = (nanoseconds() - begun) / 20
    begun = nanoseconds()
    round = 0
    while round < 20 {
        pattern(canvas)
        canvas_module.fillRect(canvas, 0, 0, width, height, canvas_module.color(150, 40, 44, 54))
        round += 1
    }
    line("fillRect translucent, the whole canvas over a picture", nanoseconds() - begun - pattern_cost * 20, 20)
    begun = nanoseconds()
    round = 0
    while round < 200 {
        canvas_module.fillRoundedRect(canvas, 40, 40, 600, 68, 20, canvas_module.color(150, 40, 44, 54))
        round += 1
    }
    line("fillRoundedRect translucent, 600x68 radius 20 (a dock)", nanoseconds() - begun, 200)
    begun = nanoseconds()
    round = 0
    while round < 200 {
        canvas_module.strokeRoundedRect(canvas, 40, 40, 600, 68, 20, 1, canvas_module.color(70, 255, 255, 255))
        round += 1
    }
    line("strokeRoundedRect, 600x68 radius 20, 1 wide", nanoseconds() - begun, 200)
    // An icon: a picture of 128 x 128 drawn 56 across.
    const memory = allocator.alloc(128 * 128 * 4, 16)
    if memory != null {
        var image: png.Image = undefined
        unsafe { image.pixels = @ptrCast([*]u32, memory.?) }
        image.width = 128
        image.height = 128
        var at: usize = 0
        while at < 128 * 128 {
            const alpha: u32 = if (at % 128) < 8 { 0 } else if (at % 128) < 16 { 128 } else { 255 }
            image.pixels[at] = canvas_module.color(alpha, @intCast(u32, at % 251), @intCast(u32, (at / 128) * 2 % 256), 90)
            at += 1
        }
        begun = nanoseconds()
        round = 0
        while round < 200 {
            canvas_module.drawImage(canvas, &image, 100 + @intCast(i32, round % 7), 300, 56, 255)
            round += 1
        }
        line("drawImage, 128x128 drawn 56 across (a dock's icon)", nanoseconds() - begun, 200)
    }
    if has_font {
        const text = "The quick brown fox jumps over the lazy dog 0123456789 (a line of text)"
        begun = nanoseconds()
        round = 0
        while round < 500 {
            text_module.drawText(canvas, font, text, 20, 200 + @intCast(i32, round % 5), 4293322470, 0)
            round += 1
        }
        line("drawText, 71 characters at 15 px", nanoseconds() - begun, 500)
        begun = nanoseconds()
        round = 0
        while round < 2000 {
            _ = text_module.measure(font, text)
            round += 1
        }
        line("measure, the same line (the layout alone)", nanoseconds() - begun, 2000)
    }
}

fn terminalRuns(canvas: *Canvas, font: *text_module.Text, allocator: std.allocator.Allocator) -> void {
    var view: ui_terminal.View = undefined
    const screen_memory = allocator.alloc(@sizeOf(terminal.Screen), 16)
    if screen_memory == null { return }
    const screen: *terminal.Screen = unsafe { @ptrCast(*terminal.Screen, screen_memory.?) }
    // (Sized before there is a screen: init takes the cell from the font.)
    ui_terminal.init(&view, screen, font, 15, 6)
    const area = ui.rect(0, 0, @intCast(i32, canvas.*.width), @intCast(i32, canvas.*.height))
    const columns = ui_terminal.columnsFor(&view, area.width)
    const rows = ui_terminal.rowsFor(&view, area.height)
    if !terminal.init(screen, allocator, columns, rows, 5000) { return }
    say("terminal: ")
    number(columns)
    say(" x ")
    number(rows)
    say(" cells of ")
    number(@intCast(usize, view.cellWidth))
    say(" x ")
    number(@intCast(usize, view.cellHeight))
    say(" pixels\n")
    var bytes: [1024]u8 = undefined
    const text: [*]u8 = &bytes
    // A screen full of text.
    var seed: usize = 0
    while seed < rows + 10 {
        const length = textLine(text, if columns < 1000 { columns } else { 1000 }, seed)
        terminal.feed(screen, text[0..length])
        terminal.feed(screen, "\r\n")
        seed += 1
    }
    var begun = nanoseconds()
    var round: usize = 0
    while round < 20 {
        ui_terminal.draw(&view, canvas, area)
        round += 1
    }
    line("terminal: a window full of text drawn whole", nanoseconds() - begun, 20)
    // The frames after: the canvas still holds the one before, as a
    // window's does (std.ui.host.kept), and only what changed is drawn.
    // cat of a long file: a line more, a frame.
    var cells: usize = 0
    var pixels: usize = 0
    begun = nanoseconds()
    round = 0
    while round < 60 {
        const length = textLine(text, if columns < 1000 { columns } else { 1000 }, seed)
        terminal.feed(screen, text[0..length])
        terminal.feed(screen, "\r\n")
        seed += 1
        const changed = ui_terminal.update(&view, canvas, area, true)
        cells += view.drawnCells
        pixels += @intCast(usize, changed.width * changed.height)
        round += 1
    }
    partLine("terminal: one more line at the bottom (the text scrolls), a frame", nanoseconds() - begun, 60, cells, pixels)
    // One character typed at the prompt.
    terminal.feed(screen, "root@brix:/# ")
    _ = ui_terminal.update(&view, canvas, area, true)
    cells = 0
    pixels = 0
    begun = nanoseconds()
    round = 0
    while round < 60 {
        var one: [1]u8 = [1]u8{ @intCast(u8, 97 + round % 26) }
        terminal.feed(screen, one[0..1])
        const changed = ui_terminal.update(&view, canvas, area, true)
        cells += view.drawnCells
        pixels += @intCast(usize, changed.width * changed.height)
        round += 1
    }
    partLine("terminal: one character typed, a frame", nanoseconds() - begun, 60, cells, pixels)
    // The cursor alone changes (shown, hidden: a blink).
    cells = 0
    pixels = 0
    begun = nanoseconds()
    round = 0
    while round < 60 {
        terminal.feed(screen, if round % 2 == 0 { "\x1b[?25l" } else { "\x1b[?25h" })
        const changed = ui_terminal.update(&view, canvas, area, true)
        cells += view.drawnCells
        pixels += @intCast(usize, changed.width * changed.height)
        round += 1
    }
    partLine("terminal: the cursor hidden or shown again (a blink), a frame", nanoseconds() - begun, 60, cells, pixels)
    // Nothing changed at all: what looking costs.
    begun = nanoseconds()
    round = 0
    while round < 60 {
        _ = ui_terminal.update(&view, canvas, area, true)
        round += 1
    }
    line("terminal: nothing changed, a look at every cell", nanoseconds() - begun, 60)
}

// A line of a drawing that drew a part: the time, and the cells it drew
// and the pixels of the rectangle it drew in, a frame.
fn partLine(name: []const u8, total: usize, times: usize, cells: usize, pixels: usize) -> void {
    result(name, total, times)
    say(" (")
    number(cells / times)
    say(" cells drawn, ")
    number(pixels / times)
    say(" pixels changed)\n")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var width: usize = 1280
    var height: usize = 960
    if std.process.count(arguments) > 1 && !parseSize(std.string.asSlice(std.process.argument(arguments, 1)), &width, &height) {
        say("usage: draw-bench [WIDTHxHEIGHT]\n")
        return 2
    }
    const allocator = std.heap.allocator()
    const memory = allocator.alloc(width * height * 4, 4096)
    if memory == null {
        say("draw-bench: out of memory\n")
        return 1
    }
    const pixels: [*]u32 = unsafe { @ptrCast([*]u32, memory.?) }
    var canvas = Canvas.{ .pixels = pixels, .width = width, .height = height, .stride = width, .swapRedBlue = false, .device = 0, .opacity = 255 }
    say("draw-bench: a canvas of ")
    number(width)
    say("x")
    number(height)
    say("\n")
    var font: text_module.Text = undefined
    const has_font = text_module.loadText(&font, 15, allocator)
    primitives(&canvas, &font, has_font, allocator)
    var mono: text_module.Text = undefined
    if text_module.loadMonoText(&mono, 15, allocator) {
        terminalRuns(&canvas, &mono, allocator)
    } else {
        say("draw-bench: no monospaced font found: the terminal is not timed\n")
    }
    return 0
}
