// smp-spin: COUNT processes that each keep a processor busy for SECONDS,
// for tools/check_brix_smp_many.sh (whether every processor runs
// programs: sysinfo's processor times say where they ran, and whether
// the system answers while every processor is busy). brixOS's own calls
// only. The processes are made as a tree (each one branches off a child
// that makes half of what is left: a process holds a handle or eight,
// not COUNT of them, and brixOS's descriptors are 64 a process), nobody
// waits for another (an orphan ends as any process does), and the clock
// is read once every few million turns (a busy process, not one that
// keeps the kernel busy). The first one ends last but one turn of the
// clock: the shell's wait for it is the wait for all of them, near
// enough.
//
//   smp-spin 64 10
const std = @import("std")
const brix = std.os.brix
const crash = @import("std.crash")

// Turns between two looks at the clock (some 20 ms on a real machine; a
// look is a system call, which takes the kernel).
const TURNS: usize = 0x1FFFFFF

fn number(text: std.string.String) -> usize {
    const parsed = std.parse.unsigned(text)
    return if parsed.valid { parsed.value } else { 0 }
}

// Busy until the monotonic clock reaches `until`.
fn spin(until: usize) -> void {
    var turns: usize = 0
    while true {
        turns += 1
        if turns & TURNS == 0 && brix.clock(brix.Clock.MONOTONIC) >= until { return }
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    _ = crash.install()
    if std.process.count(arguments) < 3 {
        _ = std.io.writeAll(std.io.stderr(), "usage: smp-spin COUNT SECONDS\n")
        return 2
    }
    var left = number(std.process.argument(arguments, 1))
    const seconds = number(std.process.argument(arguments, 2))
    const until = brix.clock(brix.Clock.MONOTONIC) + seconds * 1000000000
    // This process makes `left` spinners, itself one of them: a child
    // makes half of the others, this one the rest.
    while left > 1 {
        const half = left / 2
        const child = brix.branch()
        if child == 0 {
            left = half
        } else if child < 0 {
            _ = std.io.writeAll(std.io.stderr(), "smp-spin: no more processes\n")
            break
        } else {
            _ = brix.close(@intCast(u32, child))
            left -= half
        }
    }
    spin(until)
    return 0
}
