// A memory-side check for umbra's privileged request.  The fake login
// service must accept it, the request must have gone over MLXIPC's native
// wire (the bus is synapse; the service's format is the bus's business),
// and no reusable caller-side buffer may retain any byte after
// login.unlock returns.
const std = @import("std")
const login_module = @import("../../projects/desktop/lock/login.mlx")
const ipc = @import("std.ipc")

const Failure = error { NotAllowed, NotNative, SecretRetained }

fn allZero(bytes: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < length {
        if bytes[index] != 0 { return false }
        index += 1
    }
    return true
}

fn failed(failure: Failure) -> Failure!void { return failure }

pub fn main(arguments: [][*]const u8) -> !void {
    var login: login_module.Login = undefined
    login_module.init(&login, std.process.environmentEntries(arguments))
    var secret: [512]u8 = undefined
    var index: usize = 0
    while index < 512 {
        secret[index] = 0
        index += 1
    }
    const password = "right-pass"
    index = 0
    while index < password.length {
        secret[index] = password[index]
        index += 1
    }
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &secret) }
    const result = login_module.unlock(&login, "tester", bytes, password.length, 512)
    if result != login_module.ALLOWED { try failed(Failure.NotAllowed) }
    var client: *ipc.Client = undefined
    unsafe { client = @ptrCast(*ipc.Client, &login.client) }
    if !ipc.isNative(client) { try failed(Failure.NotNative) }
    if !allZero(bytes, 512) || !allZero(client.*.out, ipc.MAX_MESSAGE) || !allZero(ipc.connectionOf(client).*.output, ipc.MAX_MESSAGE) {
        try failed(Failure.SecretRetained)
    }
    login_module.close(&login)
    const ignored = std.io.writeAll(std.io.stdout(), "lock-login-client: allowed and wiped\n")
}
