// A deliberately small org.mlx.Login for tools/check_lock.sh.  It accepts
// Unlock("tester", "right-pass") and refuses every other request.  The
// password is never printed and the bus message body is overwritten once
// the answer has been decided.
const std = @import("std")
const dbus = @import("std.dbus")

const NAME: []const u8 = "org.mlx.Login"
const PATH: []const u8 = "/org/mlx/Login"
const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn print(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }

fn putNumber(out: [*]u8, value: usize) -> usize {
    var reversed: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count == 0 {
        reversed[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    var length: usize = 0
    while count > 0 {
        count -= 1
        out[length] = reversed[count]
        length += 1
    }
    return length
}

fn noDescriptors() -> [*]const isize {
    var none: [1]isize = [1]isize{ 0 }
    return &none
}

fn busPath(environment: [*][*]const u8) -> []const u8 {
    const value = std.process.environmentFrom(environment, "DBUS_SYSTEM_BUS_ADDRESS")
    if value == null { return "/run/mlx/bus" }
    const address = std.string.asSlice(value.?)
    const prefix = "unix:path="
    if address.length <= prefix.length || !same(address[0..prefix.length], prefix) { return "/run/mlx/bus" }
    var end = prefix.length
    while end < address.length && address[end] != 44 { end += 1 }
    return address[prefix.length..end]
}

fn ownName(client: *dbus.Client) -> bool {
    var body: [64]u8 = undefined
    const bytes: [*]u8 = &body
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 64, false)
    dbus.putString(&writing, NAME)
    dbus.putU32(&writing, 4)
    const serial = dbus.call(client, BUS, BUS_PATH, BUS, "RequestName", "su", bytes, writing.length)
    var reply: dbus.Header = undefined
    if serial == 0 || !dbus.waitReply(client, serial, &reply, 5000) || reply.kind != dbus.METHOD_RETURN { return false }
    var reading = dbus.reader(dbus.bodyOf(client, &reply), reply.bodyLength, reply.big)
    return dbus.readU32(&reading) == 1 && !reading.failed
}

fn wipeBody(client: *dbus.Client, request: *const dbus.Header) -> void {
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, dbus.bodyOf(client, request)) }
    var index: usize = 0
    while index < request.*.bodyLength {
        bytes[index] = 0
        index += 1
    }
}

fn answer(client: *dbus.Client, request: *const dbus.Header) -> void {
    var reading = dbus.reader(dbus.bodyOf(client, request), request.*.bodyLength, request.*.big)
    const user = dbus.readString(&reading)
    const password = dbus.readString(&reading)
    const allowed = !reading.failed && same(user, "tester") && same(password, "right-pass")
    const length = password.length

    var body: [16]u8 = undefined
    const bytes: [*]u8 = &body
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 16, false)
    dbus.putBool(&writing, allowed)
    wipeBody(client, request)
    _ = dbus.reply(client, request, "b", bytes, writing.length, noDescriptors(), 0)

    print("unlock tester ")
    var number: [24]u8 = undefined
    const numberBytes: [*]u8 = &number
    const digits = putNumber(numberBytes, length)
    print(numberBytes[0..digits])
    print(if allowed { " bytes: allowed\n" } else { " bytes: denied\n" })
}

fn refuse(client: *dbus.Client, request: *const dbus.Header) -> void {
    var body: [64]u8 = undefined
    const bytes: [*]u8 = &body
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 64, false)
    dbus.putString(&writing, "no such method")
    var header = dbus.newHeader(dbus.ERROR, 0)
    header.errorName = "org.freedesktop.DBus.Error.UnknownMethod"
    header.replySerial = request.*.serial
    header.hasReplySerial = true
    header.destination = request.*.sender
    header.signature = "s"
    _ = dbus.send(client, &header, bytes, writing.length, noDescriptors(), 0)
}

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    if memory == null { return }
    var client: *dbus.Client = undefined
    unsafe { client = @ptrCast(*dbus.Client, memory.?) }
    const environment = std.process.environmentEntries(arguments)
    if !dbus.connectClient(client, allocator, busPath(environment)) || !ownName(client) {
        print("lock-login-test: no bus\n")
        return
    }
    print("lock-login-test: ready\n")
    while !client.*.closed {
        var request: dbus.Header = undefined
        if !dbus.next(client, &request, -1) { continue }
        if request.kind == dbus.METHOD_CALL && same(request.path, PATH) && same(request.interface, NAME) && same(request.member, "Unlock") && same(request.signature, "ss") {
            answer(client, &request)
        } else if request.kind == dbus.METHOD_CALL {
            refuse(client, &request)
        }
    }
}
