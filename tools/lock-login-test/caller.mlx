// For tools/check_brix_lock.sh: umbra's own request (its login.mlx) made
// as a user of the check's choosing.  It takes the identity UID before it
// opens the bus, so the kernel names that user to the bus, and asks
// org.mlx.Login.Unlock for NAME with the check's right password (held
// here, so no command line or log has it).  The check's image carries it
// under the name "umbra", the program the bus's policy lets use
// login.session: who the caller is then decides alone.
//
//     umbra UID NAME      prints "caller UID: allowed", "denied" or
//                         "unavailable"
const std = @import("std")
const builtin = @import("builtin")
const brix = @import("std").os.brix
const login_module = @import("../../projects/desktop/lock/login.mlx")

const PASSWORD: []const u8 = "kestrel42"

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }

// This process as `user` (its group the same number), for good.
fn become(user: usize) -> bool {
    if comptime builtin.os == builtin.Os.brixos { return brix.setIdentity(user, user) >= 0 }
    if std.linux.syscall1(std.linux.SYS_setgid, user) != 0 { return false }
    return std.linux.syscall1(std.linux.SYS_setuid, user) == 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if std.process.count(arguments) != 3 {
        say("usage: umbra UID NAME\n")
        return 2
    }
    const user = std.parse.unsigned(std.process.argument(arguments, 1))
    if !user.valid || !become(user.value) {
        say("caller: cannot take that identity\n")
        return 2
    }
    var login: login_module.Login = undefined
    login_module.init(&login, std.process.environmentEntries(arguments))
    var secret: [512]u8 = undefined
    var index: usize = 0
    while index < 512 {
        secret[index] = 0
        index += 1
    }
    index = 0
    while index < PASSWORD.length {
        secret[index] = PASSWORD[index]
        index += 1
    }
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &secret) }
    const result = login_module.unlock(&login, std.string.asSlice(std.process.argument(arguments, 2)), bytes, PASSWORD.length, 512)
    login_module.close(&login)
    say("caller ")
    say(std.string.asSlice(std.process.argument(arguments, 1)))
    say(if result == login_module.ALLOWED { ": allowed\n" } else if result == login_module.DENIED { ": denied\n" } else { ": unavailable\n" })
    return 0
}
