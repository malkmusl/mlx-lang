// For tools/check_lock.sh and tools/check_brix_lock.sh: a program on the
// system bus that answers what nobody asked it.  To every connection that
// comes to the bus (the locker's among them: umbra opens the bus when a
// password is first submitted) it sends replies "true" to the first calls
// that connection will make, as the login service's answer to Unlock
// would look.  The bus carries a reply nobody asked for when its rules
// let the sender talk to the receiver, which by default they do: the
// locker itself must tell the login service's answer from another's, or
// any program on the bus opens the lock.
//
//     forger UID APP     takes the identity UID ("-": stays who it is),
//                        says "forger: watching", answers every
//                        connection that comes, and ends with "forger:
//                        answered APP" once one of them was the app APP
//                        (org.mlx.IPC.GetAppId), or after two minutes
const std = @import("std")
const builtin = @import("builtin")
const brix = @import("std").os.brix
const ipc = @import("std.ipc")

const BUS: []const u8 = "org.freedesktop.DBus"
const BUS_PATH: []const u8 = "/org/freedesktop/DBus"
const IPC_PATH: []const u8 = "/org/mlx/IPC"
const IPC_INTERFACE: []const u8 = "org.mlx.IPC"
// The calls of a new connection that get an answer: its Hello is 1.
const FIRST: u32 = 2
const LAST: u32 = 9
// How long it waits for the app (milliseconds).
const PATIENCE: usize = 120000
// The connections whose app the bus has not named yet.
const ASKED_MOST: usize = 8

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }

// This process as `user` (its group the same number), for good.
fn become(user: usize) -> bool {
    if comptime builtin.os == builtin.Os.brixos { return brix.setIdentity(user, user) >= 0 }
    if std.linux.syscall1(std.linux.SYS_setgid, user) != 0 { return false }
    return std.linux.syscall1(std.linux.SYS_setuid, user) == 0
}

// A reply "true" to `receiver`'s call `serial`.
fn answer(client: *ipc.Client, receiver: []const u8, serial: u32) -> bool {
    var body: [8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, bytes, 8)
    ipc.putBool(&writing, true)
    var message = ipc.newMessage(ipc.REPLY, 0)
    message.replySerial = serial
    message.destination = receiver
    message.signature = "b"
    var nothing: [1]isize = [1]isize{ 0 }
    return ipc.send(client, &message, bytes, writing.length, &nothing, 0) != 0
}

// One string as a call's body: the call's serial (0: not sent).
fn ask(client: *ipc.Client, path: []const u8, interface: []const u8, member: []const u8, text: []const u8) -> u32 {
    var body: [256]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: ipc.Writer = undefined
    ipc.begin(&writing, bytes, 256)
    ipc.putString(&writing, text)
    if writing.failed { return 0 }
    return ipc.call(client, BUS, path, interface, member, "s", bytes, writing.length)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if std.process.count(arguments) != 3 {
        say("usage: forger UID APP\n")
        return 2
    }
    const who = std.string.asSlice(std.process.argument(arguments, 1))
    const wanted = std.string.asSlice(std.process.argument(arguments, 2))
    if !std.text.same(who, "-") {
        const user = std.parse.unsigned(std.process.argument(arguments, 1))
        if !user.valid || !become(user.value) {
            say("forger: cannot take that identity\n")
            return 2
        }
    }
    var client: ipc.Client = undefined
    if !ipc.connectClient(&client, std.heap.allocator(), ipc.systemPath(std.process.environmentEntries(arguments), ipc.MLX_SYSTEM_BUS)) {
        say("forger: no bus\n")
        return 2
    }
    var reply: ipc.Message = undefined
    const watching = ask(&client, BUS_PATH, BUS, "AddMatch", "type='signal',sender='org.freedesktop.DBus',interface='org.freedesktop.DBus',member='NameOwnerChanged'")
    if watching == 0 || !ipc.waitReply(&client, watching, &reply, 5000) || reply.kind != ipc.REPLY {
        say("forger: the bus does not tell of new connections\n")
        return 2
    }
    say("forger: watching\n")
    var asked: [ASKED_MOST]u32 = undefined
    var slot: usize = 0
    while slot < ASKED_MOST {
        asked[slot] = 0
        slot += 1
    }
    var came: usize = 0
    const until = std.time.milliseconds() + PATIENCE
    var message: ipc.Message = undefined
    while std.time.milliseconds() < until {
        if !ipc.next(&client, &message, 500) {
            if client.closed { break }
            continue
        }
        if message.kind == ipc.REPLY && std.text.same(message.sender, BUS) && std.text.same(message.signature, "sb") {
            // The bus named a connection's app: was it the one?
            var known = false
            slot = 0
            while slot < ASKED_MOST {
                if asked[slot] != 0 && asked[slot] == message.replySerial {
                    asked[slot] = 0
                    known = true
                }
                slot += 1
            }
            var naming = ipc.reader(ipc.bodyOf(&client, &message), message.bodyLength)
            const app = ipc.readString(&naming)
            if known && !naming.failed && std.text.same(app, wanted) {
                say("forger: answered ")
                say(wanted)
                say("\n")
                ipc.disconnect(&client, std.heap.allocator())
                return 0
            }
            continue
        }
        if message.kind != ipc.SIGNAL || !std.text.same(message.sender, BUS) || !std.text.same(message.member, "NameOwnerChanged") || !std.text.same(message.signature, "sss") { continue }
        var reading = ipc.reader(ipc.bodyOf(&client, &message), message.bodyLength)
        const name = ipc.readString(&reading)
        const old = ipc.readString(&reading)
        const new = ipc.readString(&reading)
        // A connection that came: its unique name, owned by itself.
        if reading.failed || name.length < 2 || name.length > 64 || name[0] != 58 || old.length != 0 || !std.text.same(name, new) { continue }
        // The name is in the message `next` returned: kept here while
        // the sends below go out.
        var receiver: [64]u8 = undefined
        var receiverBytes: [*]u8 = undefined
        unsafe { receiverBytes = @ptrCast([*]u8, &receiver) }
        const length = std.text.append(receiverBytes, 0, 64, name)
        var serial = FIRST
        while serial <= LAST {
            if !answer(&client, receiverBytes[0..length], serial) {
                say("forger: could not send\n")
                return 1
            }
            serial += 1
        }
        asked[came % ASKED_MOST] = ask(&client, IPC_PATH, IPC_INTERFACE, "GetAppId", receiverBytes[0..length])
        came += 1
    }
    say("forger: the app did not come\n")
    return 1
}
