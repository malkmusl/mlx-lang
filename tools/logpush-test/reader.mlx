// For tools/check_brix_logpush.sh: whether a user may read a file. It
// takes the identity UID (identity_set: for good) and then tries to open
// each PATH for reading and to read from it; what it read is never
// printed, only how much.
//
//     reader UID PATH...     a line each: "reader UID: PATH: denied",
//                            "... not there", "... cannot be opened" or
//                            "... read N bytes" (the first 4096 at most)
//     reader UID run PROGRAM [ARGUMENT...]
//                            PROGRAM (one of the system's) run as that
//                            user, on this terminal; its exit code
const std = @import("std")
const builtin = @import("builtin")
const spawn = @import("std.spawn")
const brix = std.os.brix

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

// This process as `user` (its group the same number), for good.
fn become(user: usize) -> bool {
    if comptime builtin.os == builtin.Os.brixos { return brix.setIdentity(user, user) >= 0 }
    if std.linux.syscall1(std.linux.SYS_setgid, user) != 0 { return false }
    return std.linux.syscall1(std.linux.SYS_setuid, user) == 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count < 3 {
        say("usage: reader UID PATH...\n")
        return 2
    }
    const user = std.parse.unsigned(std.process.argument(arguments, 1))
    if !user.valid || !become(user.value) {
        say("reader: cannot take that identity\n")
        return 2
    }
    // A program run as that user (its children are the user's too).
    if count >= 4 && std.text.same(std.string.asSlice(std.process.argument(arguments, 2)), "run") {
        const first: [*][*]const u8 = unsafe { @ptrFromInt([*][*]const u8, @intFromPtr(arguments.pointer) + 3 * 8) }
        var options = spawn.options(first[0], first, std.process.environmentEntries(arguments))
        options.searchPath = true
        const child = spawn.start(&options)
        if !child.started() {
            say("reader: cannot run that program\n")
            return 2
        }
        return @intCast(u8, spawn.wait(child).status() & 255)
    }
    var buffer: [4096]u8 = undefined
    var line: [320]u8 = undefined
    var k: usize = 2
    while k < count {
        const path = std.process.argument(arguments, k)
        var n = std.text.append(&line, 0, 319, "reader ")
        n = std.text.append(&line, n, 319, std.string.asSlice(std.process.argument(arguments, 1)))
        n = std.text.append(&line, n, 319, ": ")
        n = std.text.append(&line, n, 319, std.string.asSlice(path))
        const file = std.fs.open(path.pointer, std.fs.READ_ONLY, 0)
        if !std.fs.isValid(file) {
            n = std.text.append(&line, n, 319, if file.descriptor == -13 { ": denied" } else if file.descriptor == -2 { ": not there" } else { ": cannot be opened" })
        } else {
            const into: [*]u8 = &buffer
            const got = std.fs.read(file, into, 4096)
            _ = std.fs.close(file)
            n = std.text.append(&line, n, 319, ": read ")
            n = std.text.appendUnsigned(&line, n, 319, if got < 0 { 0 } else { @intCast(usize, got) })
            n = std.text.append(&line, n, 319, " bytes")
        }
        line[n] = 10
        say(line[0..n + 1])
        k += 1
    }
    return 0
}
