// A stand-in screen locker for the compositor's checks: it locks the
// session (ext-session-lock-v1, std.ui.wayland.panel.openLock) and covers
// the output in one colour; Enter unlocks. It asks for no password, so it
// is a test of the compositor's side only, never a locker to use. With
// --die it ends two seconds after locking without unlocking (a locker
// that crashed): the session must stay locked.
//
//   session-lock-test [--die]
const std = @import("std")
const crash = @import("std.crash")
const canvas_module = @import("std.ui.canvas")
const panel_module = @import("std.ui.wayland.panel")

const Canvas = canvas_module.Canvas
const Panel = panel_module.Panel

const KEY_ENTER: u32 = 28

const Locker = struct {
    panel: Panel
    die: bool
}

fn lockerOf(context: *anyopaque) -> *Locker {
    unsafe { return @ptrCast(*Locker, context) }
}

fn panelOf(locker: *Locker) -> *Panel {
    unsafe { return @ptrCast(*Panel, &locker.*.panel) }
}

fn say(text: []const u8) -> void {
    const written = std.io.writeAll(std.io.stdout(), text)
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    canvas_module.clear(canvas, canvas_module.color(255, 30, 110, 90))
    const panel = panelOf(lockerOf(context))
    const width = @intCast(i32, panel.*.width)
    const height = @intCast(i32, panel.*.height)
    canvas_module.fillRoundedRect(canvas, width / 2 - 60, height / 2 - 30, 120, 60, 16, canvas_module.color(255, 240, 240, 240))
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const locker = lockerOf(context)
    const panel = panelOf(locker)
    if kind == panel_module.EVENT_LOCKED {
        say("lock-test: locked\n")
        if locker.*.die {
            panel.*.tickInterval = 2000
            panel.*.nextTick = 0
        }
    } else if kind == panel_module.EVENT_LOCK_FINISHED {
        say("lock-test: refused\n")
    } else if kind == panel_module.EVENT_CONFIGURED {
        say("lock-test: configured\n")
    } else if kind == panel_module.EVENT_KEY && a == KEY_ENTER && b == 1 && !locker.*.die {
        panel_module.unlock(panel)
        say("lock-test: unlocked\n")
    } else if kind == panel_module.EVENT_TICK && locker.*.die {
        say("lock-test: going without unlocking\n")
        panel.*.running = false
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    _ = crash.install()
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Locker), 16)
    if memory == null { return }
    var locker: *Locker = undefined
    unsafe { locker = @ptrCast(*Locker, memory.?) }
    locker.*.die = arguments.length > 1 && arguments[1][0] == 45 && arguments[1][2] == 100
    const panel = panelOf(locker)
    panel.*.context = locker
    panel.*.draw = draw
    panel.*.event = onEvent
    try panel_module.openLock(panel, allocator, arguments)
    try panel_module.run(panel)
    panel_module.close(panel)
}
