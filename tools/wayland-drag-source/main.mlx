// A window to drag files from, for the desktop's tests: pressed and moved
// on, it drags a text/uri-list the way a file manager drags files and
// folders: the first argument the first time, the second the next, and
// so on (\n in one separates URIs).
//
//   wayland-drag-source 'file:///home/me/Documents' 'file:///home/me/old.txt'
const std = @import("std")
const canvas_module = @import("../../examples/desktop-shared/canvas.mlx")
const panel_module = @import("../../examples/desktop-shared/panel.mlx")
const panel_drag = @import("../../examples/desktop-shared/panel_drag.mlx")

const Canvas = canvas_module.Canvas
const Panel = panel_module.Panel

const BUTTON_LEFT: u32 = 272

const Source = struct {
    panel: Panel
    list: [1024]u8
    length: usize
    pressed: bool
    // The lists to drag, one after the other (up to four).
    lists: [4096]u8
    lengths: [4]usize
    count: usize
    next: usize
}

// Keeps argument text `list` as list `slot` (\n in it separates URIs;
// each line ends with CR LF).
fn keep(source: *Source, slot: usize, list: [*]const u8) -> void {
    var length: usize = 0
    var index: usize = 0
    while list[index] != 0 && length < 1000 {
        if list[index] == 92 && list[index + 1] == 110 {
            source.*.lists[slot * 1024 + length] = 13
            source.*.lists[slot * 1024 + length + 1] = 10
            length += 2
            index += 2
        } else {
            source.*.lists[slot * 1024 + length] = list[index]
            length += 1
            index += 1
        }
    }
    source.*.lists[slot * 1024 + length] = 13
    source.*.lists[slot * 1024 + length + 1] = 10
    source.*.lengths[slot] = length + 2
}

// The next list as the one to drag.
fn takeNext(source: *Source) -> void {
    source.*.length = 0
    if source.*.next >= source.*.count { return }
    const slot = source.*.next
    source.*.next += 1
    var index: usize = 0
    while index < source.*.lengths[slot] {
        source.*.list[index] = source.*.lists[slot * 1024 + index]
        index += 1
    }
    source.*.length = source.*.lengths[slot]
}

fn sourceOf(context: *anyopaque) -> *Source {
    unsafe { return @ptrCast(*Source, context) }
}

fn draw(context: *anyopaque, canvas: *Canvas) -> void {
    canvas_module.clear(canvas, canvas_module.color(255, 60, 120, 200))
}

fn drawIcon(context: *anyopaque, canvas: *Canvas) -> void {
    canvas_module.fillRoundedRect(canvas, 4, 4, 40, 40, 8, canvas_module.color(255, 240, 200, 60))
}

fn say(text: []const u8) -> void {
    const written = std.io.writeAll(std.io.stdout(), text)
}

fn onEvent(context: *anyopaque, kind: u32, a: u32, b: i32) -> void {
    const source = sourceOf(context)
    var panel: *Panel = undefined
    unsafe { panel = @ptrCast(*Panel, &source.*.panel) }
    if kind == panel_module.EVENT_BUTTON && a == BUTTON_LEFT {
        source.*.pressed = b == 1
    } else if kind == panel_module.EVENT_MOTION && source.*.pressed {
        source.*.pressed = false
        takeNext(source)
        if source.*.length == 0 {
            say("drag-source: nothing left to drag\n")
            return
        }
        var bytes: [*]const u8 = undefined
        unsafe { bytes = @ptrFromInt([*]const u8, @intFromPtr(source) + @offsetOf(Source, "list")) }
        if panel_drag.startDrag(panel, "text/uri-list", bytes[0..source.*.length], 48, drawIcon) { say("drag-source: dragging\n") } else { say("drag-source: no drag\n") }
    } else if kind == panel_module.EVENT_DRAG_END {
        say(if a == 1 { "drag-source: dropped\n" } else { "drag-source: cancelled\n" })
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Source), 16)
    if memory == null { return }
    var source: *Source = undefined
    unsafe { source = @ptrCast(*Source, memory.?) }
    source.*.length = 0
    source.*.pressed = false
    source.*.count = 0
    source.*.next = 0
    var index: usize = 1
    while index < arguments.length && source.*.count < 4 {
        keep(source, source.*.count, arguments[index])
        source.*.count += 1
        index += 1
    }
    var panel: *Panel = undefined
    unsafe { panel = @ptrCast(*Panel, &source.*.panel) }
    panel.*.context = @ptrCast(*anyopaque, source)
    panel.*.draw = draw
    panel.*.event = onEvent
    try panel_module.openWindow(panel, allocator, arguments, "Drag Source", "org.mlx.dragsource", 200, 160)
    try panel_module.run(panel)
    panel_module.close(panel)
}
