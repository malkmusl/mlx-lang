// The desktop's symbols (projects/desktop/shared/symbols.mlx) on a sheet,
// to look at them: each symbol and its variants at 48 and at 18 pixels,
// white on the popups' dark grey, into a PNG.
//
//   symbols-sheet sheet.png
const std = @import("std")
const png = @import("std.png")
const symbols = @import("../../projects/desktop/shared/symbols.mlx")

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    var cache: symbols.Cache = undefined
    symbols.init(&cache, allocator)
    // A sheet: 12 columns of 48 px cells, background dark.
    const cell: usize = 56
    const columns: usize = 12
    const rows: usize = 4
    const width = cell * columns
    const height = cell * rows
    const memory = allocator.alloc(width * height * 4, 16)
    var pixels: [*]u32 = undefined
    unsafe { pixels = @ptrCast([*]u32, memory.?) }
    var i: usize = 0
    while i < width * height {
        pixels[i] = 4280165674
        i += 1
    }
    var list: [40]u32 = undefined
    var variants: [40]u32 = undefined
    var count: usize = 0
    var s: u32 = 1
    while s <= 23 {
        list[count] = s
        variants[count] = 0
        count += 1
        s += 1
    }
    list[count] = 1
    variants[count] = 3
    count += 1
    list[count] = 1
    variants[count] = 100
    count += 1
    list[count] = 2
    variants[count] = 84
    count += 1
    list[count] = 2
    variants[count] = 1060
    count += 1
    list[count] = 2
    variants[count] = 2010
    count += 1
    list[count] = 3
    variants[count] = 4
    count += 1
    list[count] = 3
    variants[count] = 2
    count += 1
    list[count] = 3
    variants[count] = 100
    count += 1
    list[count] = 5
    variants[count] = 1
    count += 1
    var index: usize = 0
    while index < count {
        const size: usize = if index % 2 == 0 { 48 } else { 18 }
        const picture = symbols.image(&cache, list[index], variants[index], size, 4294967295)
        if picture != null {
            const image = picture.?
            const x0 = (index % columns) * cell + 4
            const y0 = (index / columns) * cell + 4
            var y: usize = 0
            while y < size {
                var x: usize = 0
                while x < size {
                    const p = image.*.pixels[y * size + x]
                    const a = (p >> 24) & 255
                    const under = pixels[(y0 + y) * width + x0 + x]
                    const keep = 255 - a
                    const r = ((p >> 16) & 255) + ((under >> 16) & 255) * keep / 255
                    const g = ((p >> 8) & 255) + ((under >> 8) & 255) * keep / 255
                    const b = (p & 255) + (under & 255) * keep / 255
                    pixels[(y0 + y) * width + x0 + x] = 4278190080 | (r << 16) | (g << 8) | b
                    x += 1
                }
                y += 1
            }
        }
        index += 1
    }
    const saved = png.saveFile(arguments[1], pixels, width, height, width, false, allocator)
}
