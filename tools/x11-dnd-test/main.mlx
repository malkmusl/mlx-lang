// An X program for the desktop's checks, on std.x11 and the display in
// $DISPLAY: a window that takes dropped files by XDND (version 5), or one
// that drags them.
//
//   x11-dnd-test target       a 300x200 window titled "X Drop" (XdndAware
//                             5) that takes text/uri-list, prints what was
//                             dropped on stdout and ends
//   x11-dnd-test source URI   a 300x200 window titled "X Drag": pressed
//                             and moved on, it drags URI (text/uri-list)
//                             to the window under the pointer by XDND,
//                             says how the drop ended and ends
//
// It ends after 30 seconds whatever happens; "x11-dnd-test: ..." lines on
// stderr say what it did.
const std = @import("std")
const x11 = @import("std.x11")

const SYS_poll: usize = 7
const SYS_exit_group: usize = 231

// The atoms it asks for.
const A_AWARE: usize = 0
const A_ENTER: usize = 1
const A_POSITION: usize = 2
const A_STATUS: usize = 3
const A_LEAVE: usize = 4
const A_DROP: usize = 5
const A_FINISHED: usize = 6
const A_SELECTION: usize = 7
const A_TYPE_LIST: usize = 8
const A_COPY: usize = 9
const A_URI_LIST: usize = 10
const A_PROPERTY: usize = 11
const A_TARGETS: usize = 12
const ATOMS: usize = 13

const NAMES = [13][]const u8{ "XdndAware", "XdndEnter", "XdndPosition", "XdndStatus", "XdndLeave", "XdndDrop", "XdndFinished", "XdndSelection", "XdndTypeList", "XdndActionCopy", "text/uri-list", "_X11_DND_TEST", "TARGETS" }

const NO_SEQUENCE: u32 = 65536

const Run = struct {
    connection: x11.Connection
    drags: bool
    uri: []const u8
    window: u32
    atoms: [13]u32
    atomSequence: u32
    atomsLeft: usize
    // The drag over the window: its source window, whether it offers
    // text/uri-list, the XdndTypeList read (its sequence), whether a
    // position was said, the property read after the drop.
    source: u32
    uris: bool
    typesSequence: u32
    told: bool
    propertySequence: u32
    offset: u32
    // Dragging (the source): the button held and where it went down,
    // whether the drag began, the window under the pointer (asked for:
    // its sequence; 0: none) and the version it speaks (asked: its
    // XdndAware's sequence; 0: none), whether XdndEnter went, a position
    // awaiting its status (and a newer one waiting), its last status.
    pressed: bool
    pressX: i32
    pressY: i32
    pointerX: i32
    pointerY: i32
    time: u32
    dragging: bool
    underSequence: u32
    target: u32
    awareSequence: u32
    version: u32
    entered: bool
    waiting: bool
    moved: bool
    accepted: bool
    done: bool
    status: u8
}

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stderr(), text) }

fn sayNumber(value: i32) -> void {
    var digits: [12]u8 = undefined
    var length: usize = 0
    var rest: u32 = if value < 0 { @bitCast(u32, -value) } else { @bitCast(u32, value) }
    while length == 0 || rest > 0 {
        digits[11 - length] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        length += 1
    }
    if value < 0 { say("-") }
    say(digits[12 - length..12])
}

fn finish(run: *Run, status: u8, text: []const u8) -> void {
    say("x11-dnd-test: ")
    say(text)
    say("\n")
    run.*.done = true
    run.*.status = status
}

fn sendTo(run: *Run, window: u32, kind: usize, first: u32, second: u32, third: u32, fourth: u32) -> void {
    var values: [5]u32 = [5]u32{ run.*.window, first, second, third, fourth }
    x11.sendClientMessage5(&run.*.connection, window, run.*.atoms[kind], &values)
}

// The atoms are in: the window, titled, taking drops (or its button and
// motion for dragging), shown.
fn atomsIn(run: *Run) -> void {
    const connection = &run.*.connection
    run.*.window = x11.generateId(connection)
    if run.*.drags {
        x11.createWindow(connection, run.*.window, connection.*.root, 0, 0, 300, 200, 10040115, x11.MASK_STRUCTURE_NOTIFY | x11.MASK_BUTTON_PRESS | x11.MASK_BUTTON_RELEASE | x11.MASK_POINTER_MOTION)
        x11.changePropertyBytes(connection, run.*.window, x11.ATOM_WM_NAME, x11.ATOM_STRING, "X Drag", false)
        x11.changePropertyBytes(connection, run.*.window, x11.ATOM_WM_CLASS, x11.ATOM_STRING, "x11-dnd-test\x00X11DndTest\x00", false)
        x11.mapWindow(connection, run.*.window)
        say("x11-dnd-test: ready\n")
        return
    }
    x11.createWindow(connection, run.*.window, connection.*.root, 0, 0, 300, 200, 3368601, x11.MASK_STRUCTURE_NOTIFY)
    x11.changePropertyBytes(connection, run.*.window, x11.ATOM_WM_NAME, x11.ATOM_STRING, "X Drop", false)
    x11.changePropertyBytes(connection, run.*.window, x11.ATOM_WM_CLASS, x11.ATOM_STRING, "x11-dnd-test\x00X11DndTest\x00", false)
    x11.changeProperty32(connection, run.*.window, run.*.atoms[A_AWARE], x11.ATOM_ATOM, 5)
    x11.mapWindow(connection, run.*.window)
    say("x11-dnd-test: ready\n")
}

fn hasUris(run: *Run, atoms: [*]const u8, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if x11.get32(atoms, index * 4) == run.*.atoms[A_URI_LIST] { return true }
        index += 1
    }
    return false
}

fn clientMessage(run: *Run, data: [*]const u8) -> void {
    const connection = &run.*.connection
    const kind = x11.get32(data, 8)
    const source = x11.get32(data, 12)
    if kind == run.*.atoms[A_ENTER] {
        run.*.source = source
        run.*.told = false
        if x11.get32(data, 16) & 1 != 0 {
            run.*.uris = false
            run.*.typesSequence = x11.getProperty(connection, source, run.*.atoms[A_TYPE_LIST], x11.ATOM_ATOM, 64)
        } else {
            run.*.uris = hasUris(run, data + 20, 3)
            say(if run.*.uris { "x11-dnd-test: enter, text/uri-list offered\n" } else { "x11-dnd-test: enter, no text/uri-list\n" })
        }
        say("x11-dnd-test: version ")
        sayNumber(@intCast(i32, x11.get32(data, 16) >> 24))
        say("\n")
    } else if kind == run.*.atoms[A_POSITION] {
        if !run.*.told {
            say("x11-dnd-test: over at ")
            sayNumber(@intCast(i32, x11.get32(data, 20) >> 16))
            say(",")
            sayNumber(@intCast(i32, x11.get32(data, 20) & 65535))
            say("\n")
            run.*.told = true
        }
        sendTo(run, source, A_STATUS, if run.*.uris { 1 } else { 0 }, 0, 0, if run.*.uris { run.*.atoms[A_COPY] } else { x11.NONE })
    } else if kind == run.*.atoms[A_LEAVE] {
        say("x11-dnd-test: leave\n")
        run.*.source = 0
    } else if kind == run.*.atoms[A_DROP] {
        say("x11-dnd-test: drop\n")
        x11.convertSelection(connection, run.*.window, run.*.atoms[A_SELECTION], run.*.atoms[A_URI_LIST], run.*.atoms[A_PROPERTY], x11.get32(data, 20))
    }
}

// ---------------------------------------------------------------------------
// Dragging

fn sendPosition(run: *Run) -> void {
    if !run.*.entered { return }
    if run.*.waiting {
        run.*.moved = true
        return
    }
    sendTo(run, run.*.target, A_POSITION, 0, (@bitCast(u32, run.*.pointerX) << 16) | (@bitCast(u32, run.*.pointerY) & 65535), run.*.time, run.*.atoms[A_COPY])
    run.*.waiting = true
    run.*.moved = false
}

// The pointer is over `window` (a child of the root; 0: none): the old
// target is left, the new one asked whether it takes drops.
fn over(run: *Run, window: u32) -> void {
    const target = if window == run.*.window { 0 } else { window }
    if target == run.*.target {
        sendPosition(run)
        return
    }
    if run.*.entered { sendTo(run, run.*.target, A_LEAVE, 0, 0, 0, 0) }
    say("x11-dnd-test: over window ")
    sayNumber(@bitCast(i32, target))
    say(" at ")
    sayNumber(run.*.pointerX)
    say(",")
    sayNumber(run.*.pointerY)
    say("\n")
    run.*.target = target
    run.*.entered = false
    run.*.waiting = false
    run.*.accepted = false
    run.*.version = 0
    if target != 0 { run.*.awareSequence = x11.getProperty(&run.*.connection, target, run.*.atoms[A_AWARE], x11.ATOM_ANY, 1) }
}

fn motion(run: *Run, event: [*]const u8) -> void {
    run.*.time = x11.get32(event, 4)
    run.*.pointerX = x11.getInt16(event, 20)
    run.*.pointerY = x11.getInt16(event, 22)
    if !run.*.pressed { return }
    const connection = &run.*.connection
    if !run.*.dragging {
        const dx = run.*.pointerX - run.*.pressX
        const dy = run.*.pointerY - run.*.pressY
        if dx * dx + dy * dy < 25 { return }
        run.*.dragging = true
        x11.setSelectionOwnerAt(connection, run.*.window, run.*.atoms[A_SELECTION], run.*.time)
        var types: [1]u32 = [1]u32{ run.*.atoms[A_URI_LIST] }
        unsafe { x11.changeProperty(connection, run.*.window, run.*.atoms[A_TYPE_LIST], x11.ATOM_ATOM, 32, @ptrCast([*]const u8, &types), 1) }
        say("x11-dnd-test: dragging\n")
    }
    run.*.underSequence = x11.translateCoordinates(connection, connection.*.root, connection.*.root, run.*.pointerX, run.*.pointerY)
}

fn released(run: *Run, event: [*]const u8) -> void {
    run.*.pressed = false
    if !run.*.dragging { return }
    if run.*.entered && run.*.accepted {
        sendTo(run, run.*.target, A_DROP, 0, x11.get32(event, 4), 0, 0)
        say("x11-dnd-test: drop\n")
        return
    }
    if run.*.entered { sendTo(run, run.*.target, A_LEAVE, 0, 0, 0, 0) }
    finish(run, 1, "let go where nothing takes it")
}

// Another program converts XdndSelection: the URI (TARGETS lists it).
fn requested(run: *Run, event: [*]const u8) -> void {
    const connection = &run.*.connection
    const time = x11.get32(event, 4)
    const requestor = x11.get32(event, 12)
    const selection = x11.get32(event, 16)
    const target = x11.get32(event, 20)
    const property = x11.get32(event, 24)
    if target == run.*.atoms[A_URI_LIST] {
        x11.changePropertyBytes(connection, requestor, property, target, run.*.uri, false)
        x11.sendSelectionNotify(connection, requestor, selection, target, property, time)
        say("x11-dnd-test: served\n")
    } else if target == run.*.atoms[A_TARGETS] {
        var list: [2]u32 = [2]u32{ run.*.atoms[A_TARGETS], run.*.atoms[A_URI_LIST] }
        unsafe { x11.changeProperty(connection, requestor, property, x11.ATOM_ATOM, 32, @ptrCast([*]const u8, &list), 2) }
        x11.sendSelectionNotify(connection, requestor, selection, target, property, time)
    } else {
        x11.sendSelectionNotify(connection, requestor, selection, target, x11.NONE, time)
    }
}

fn sourceMessage(run: *Run, data: [*]const u8) -> void {
    const kind = x11.get32(data, 8)
    if kind == run.*.atoms[A_STATUS] && x11.get32(data, 12) == run.*.target {
        const accepted = x11.get32(data, 16) & 1 != 0
        if accepted != run.*.accepted { say(if accepted { "x11-dnd-test: the target takes it\n" } else { "x11-dnd-test: the target does not take it\n" }) }
        run.*.accepted = accepted
        run.*.waiting = false
        if run.*.moved { sendPosition(run) }
    } else if kind == run.*.atoms[A_FINISHED] {
        finish(run, if x11.get32(data, 16) & 1 != 0 { 0 } else { 1 }, if x11.get32(data, 16) & 1 != 0 { "finished, taken" } else { "finished, not taken" })
    }
}

fn handle(run: *Run, message: *x11.Message) -> void {
    const connection = &run.*.connection
    const data = message.*.data
    if message.*.kind == x11.KIND_SETUP {
        if connection.*.failed {
            finish(run, 1, "the display refused the connection")
            return
        }
        var index: usize = 0
        while index < ATOMS {
            const sequence = x11.internAtom(connection, NAMES[index])
            if index == 0 { run.*.atomSequence = sequence }
            index += 1
        }
        run.*.atomsLeft = ATOMS
        return
    }
    if message.*.kind == x11.KIND_REPLY {
        const sequence = @intCast(u32, message.*.sequence)
        if run.*.atomsLeft > 0 {
            const index = @intCast(usize, (sequence -% run.*.atomSequence) & 65535)
            if index < ATOMS {
                run.*.atoms[index] = x11.atomOf(data)
                run.*.atomsLeft -= 1
                if run.*.atomsLeft == 0 { atomsIn(run) }
            }
            return
        }
        if sequence == run.*.underSequence {
            run.*.underSequence = NO_SEQUENCE
            if run.*.dragging { over(run, x11.translatedChild(data)) }
            return
        }
        if sequence == run.*.awareSequence {
            run.*.awareSequence = NO_SEQUENCE
            if x11.propertyFormat(data) == 32 && x11.propertyBytes(data) >= 4 && x11.get32(x11.propertyValue(data), 0) >= 3 {
                run.*.version = 5
                var version = x11.get32(x11.propertyValue(data), 0)
                if version > 5 { version = 5 }
                sendTo(run, run.*.target, A_ENTER, version << 24, run.*.atoms[A_URI_LIST], 0, 0)
                run.*.entered = true
                say("x11-dnd-test: entered a window that takes drops\n")
                sendPosition(run)
            }
            return
        }
        if sequence == run.*.typesSequence {
            run.*.typesSequence = NO_SEQUENCE
            run.*.uris = hasUris(run, x11.propertyValue(data), x11.propertyBytes(data) / 4)
            say(if run.*.uris { "x11-dnd-test: enter (type list), text/uri-list offered\n" } else { "x11-dnd-test: enter (type list), no text/uri-list\n" })
            return
        }
        if sequence == run.*.propertySequence {
            const bytes = x11.propertyBytes(data)
            _ = std.io.writeAll(std.io.stdout(), x11.propertyValue(data)[0..bytes])
            if x11.propertyAfter(data) > 0 {
                run.*.offset += @intCast(u32, bytes / 4)
                run.*.propertySequence = x11.getPropertyPart(connection, run.*.window, run.*.atoms[A_PROPERTY], x11.ATOM_ANY, run.*.offset, 15000, true)
                return
            }
            sendTo(run, run.*.source, A_FINISHED, 1, run.*.atoms[A_COPY], 0, 0)
            finish(run, 0, "dropped")
        }
        return
    }
    if message.*.kind == x11.KIND_ERROR { return }
    if run.*.drags {
        if message.*.kind == x11.BUTTON_PRESS && data[1] == 1 {
            run.*.pressed = true
            run.*.pressX = x11.getInt16(data, 20)
            run.*.pressY = x11.getInt16(data, 22)
        } else if message.*.kind == x11.MOTION_NOTIFY {
            motion(run, data)
        } else if message.*.kind == x11.BUTTON_RELEASE && data[1] == 1 {
            released(run, data)
        } else if message.*.kind == x11.SELECTION_REQUEST {
            requested(run, data)
        } else if message.*.kind == x11.CLIENT_MESSAGE {
            sourceMessage(run, data)
        }
        return
    }
    if message.*.kind == x11.CLIENT_MESSAGE {
        clientMessage(run, data)
    } else if message.*.kind == x11.SELECTION_NOTIFY {
        if x11.get32(data, 20) == x11.NONE {
            sendTo(run, run.*.source, A_FINISHED, 0, x11.NONE, 0, 0)
            finish(run, 1, "the conversion was refused")
            return
        }
        run.*.offset = 0
        run.*.propertySequence = x11.getPropertyPart(connection, run.*.window, run.*.atoms[A_PROPERTY], x11.ATOM_ANY, 0, 15000, true)
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    var run: Run = undefined
    run.done = false
    run.status = 1
    run.atomsLeft = 0
    run.source = 0
    run.uris = false
    run.typesSequence = NO_SEQUENCE
    run.propertySequence = NO_SEQUENCE
    run.underSequence = NO_SEQUENCE
    run.awareSequence = NO_SEQUENCE
    run.pressed = false
    run.dragging = false
    run.target = 0
    run.entered = false
    run.waiting = false
    run.accepted = false
    run.time = 0
    run.drags = arguments.length >= 3 && std.text.same(std.text.cString(arguments[1]), "source")
    run.uri = if run.drags { std.text.cString(arguments[2]) } else { "" }
    if !run.drags && (arguments.length < 2 || !std.text.same(std.text.cString(arguments[1]), "target")) {
        say("usage: x11-dnd-test target | source URI\n")
        return
    }
    const display = std.process.environment(arguments, "DISPLAY")
    if display == null {
        say("x11-dnd-test: no DISPLAY\n")
        return
    }
    const socket = x11.connectDisplay(std.string.asSlice(display.?))
    if socket < 0 {
        say("x11-dnd-test: cannot connect to the display\n")
        _ = std.linux.syscall1(SYS_exit_group, 1)
        return
    }
    x11.begin(&run.connection, @bitCast(usize, socket))
    const deadline = std.time.milliseconds() + 30000
    var poll: [2]i32 = [2]i32{ @intCast(i32, socket), 1 }
    while !run.done && std.time.milliseconds() < deadline {
        if std.linux.syscall3(SYS_poll, @intFromPtr(&poll), 1, 200) > 0 {
            if !x11.fill(&run.connection) {
                finish(&run, 1, "the display went")
            } else {
                var message: x11.Message = undefined
                while !run.done && x11.take(&run.connection, &message) { handle(&run, &message) }
            }
        }
    }
    if !run.done { say("x11-dnd-test: time is up\n") }
    _ = std.linux.syscall1(SYS_exit_group, @intCast(usize, run.status))
}
