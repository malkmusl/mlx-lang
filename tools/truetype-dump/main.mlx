// Prints std.truetype metrics and glyph coverage bitmaps (used by
// tools/check_truetype.py to compare against FreeType and a supersampled
// ground truth):
//
//     truetype-dump FONT EM_PIXELS CODEPOINT...
const std = @import("std")
const tt = @import("std.truetype")

fn say(text: []const u8) -> void { const ignored = std.io.writeAll(std.io.stdout(), text) }
fn number(value: usize) -> void { const ignored = std.io.writeUnsigned(std.io.stdout(), value) }
fn signed(value: i32) -> void {
    if value < 0 {
        say("-")
        number(@intCast(usize, 0 - value))
    } else {
        number(@intCast(usize, value))
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var font: tt.Font = undefined
    const status = tt.loadFile(&font, std.process.argument(arguments, 1).pointer, allocator)
    if status != tt.Status.ok {
        say(tt.statusMessage(status))
        say("\n")
        return 1
    }
    const size_text = std.process.argument(arguments, 2)
    var pixel_height: u32 = 0
    var index: usize = 0
    while index < size_text.length {
        pixel_height = pixel_height * 10 + @intCast(u32, size_text.pointer[index] - 48)
        index += 1
    }
    const em: i64 = @intCast(i64, pixel_height)
    const units: i64 = @intCast(i64, font.unitsPerEm)
    const em_f: f64 = @floatFromInt(f64, em)
    const units_f: f64 = @floatFromInt(f64, units)
    const scale = em_f / units_f
    say("units ")
    number(@intCast(usize, font.unitsPerEm))
    say(" glyphs ")
    number(@intCast(usize, font.numGlyphs))
    say(" cmap ")
    number(@intCast(usize, font.cmapFormat))
    say(" kern ")
    number(@intCast(usize, font.kernCount))
    say("\n")
    // Each remaining argument: a code point in decimal.
    var argument: usize = 3
    while argument < std.process.count(arguments) {
        const text = std.process.argument(arguments, argument)
        var codepoint: u32 = 0
        index = 0
        while index < text.length {
            codepoint = codepoint * 10 + @intCast(u32, text.pointer[index] - 48)
            index += 1
        }
        const glyph = tt.glyphIndex(&font, codepoint)
        var bitmap: tt.Bitmap = undefined
        if !tt.rasterize(&font, glyph, scale, allocator, &bitmap) { return 2 }
        say("glyph ")
        number(@intCast(usize, codepoint))
        say(" ")
        number(@intCast(usize, glyph))
        say(" advance ")
        signed(tt.advanceWidth(&font, glyph))
        say(" bitmap ")
        number(bitmap.width)
        say(" ")
        number(bitmap.height)
        say(" ")
        signed(bitmap.left)
        say(" ")
        signed(bitmap.top)
        say("\n")
        var at: usize = 0
        while at < bitmap.width * bitmap.height {
            number(@intCast(usize, bitmap.pixels[at]))
            say(if (at + 1) % bitmap.width == 0 { "\n" } else { " " })
            at += 1
        }
        argument += 1
    }
    return 0
}
