// The client of tools/check_brix_logserve.sh that stops reading, in
// brixOS (its own socket calls): it asks an HTTP server for a path, reads
// nothing for a while, then reads what still comes and says how much that
// was. A server that waits for such a client for good is stuck; logserve
// gives it up after its time limit and the client finds the connection
// ended short of the answer.
//
//     reader ADDRESS PORT PATH SECONDS
//
// ADDRESS is a.b.c.d. A server that does not listen yet is tried again
// for half a minute (the check starts this client first, behind the
// shell). It prints "reader: asked for PATH, reading nothing for SECONDS
// s" once the request has gone, and at the end "reader: N bytes came,
// then the connection's end" (or "... and no end").
const std = @import("std")
const brix = std.os.brix

const SECOND: usize = 1000000000

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stdout(), text) }

fn sayNumber(value: usize) -> void {
    var digits: [24]u8 = undefined
    say(digits[0..std.text.appendUnsigned(&digits, 0, 24, value)])
}

fn numberOf(text: []const u8) -> usize {
    var value: usize = 0
    for digit in text {
        if digit < 48 || digit > 57 { return 0 }
        value = value * 10 + @intCast(usize, digit - 48)
    }
    return value
}

// Waits until `handle` shows one of `want` (none: until the time is
// over), `nanoseconds` at most: what it shows then.
fn until(handle: brix.Handle, want: u32, nanoseconds: usize) -> u32 {
    var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = handle, .want = want, .seen = 0, .reserved = 0 } }
    _ = brix.wait(items[0..1], brix.clock(brix.Clock.MONOTONIC) + nanoseconds)
    return items[0].seen
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 5 {
        say("usage: reader ADDRESS PORT PATH SECONDS\n")
        return 1
    }
    var to = brix.SocketAddress.{ .address = [4]u8{ 0, 0, 0, 0 }, .port = @intCast(u32, numberOf(std.text.cString(arguments[2]))) }
    var part: usize = 0
    for byte in std.text.cString(arguments[1]) {
        if byte == 46 {
            part += 1
        } else if part < 4 && byte >= 48 && byte <= 57 {
            to.address[part] = to.address[part] *% 10 +% (byte - 48)
        }
    }
    const path = std.text.cString(arguments[3])
    const seconds = numberOf(std.text.cString(arguments[4]))
    var socket: brix.Handle = 0
    var tries: usize = 0
    while socket == 0 {
        const opened = brix.socketOpen(brix.SocketKind.STREAM)
        if opened < 0 {
            say("reader: no network\n")
            return 1
        }
        socket = @intCast(brix.Handle, opened)
        // (A connection that failed is writable too, and its peer gone.)
        const made = brix.socketConnect(socket, &to) >= 0 && until(socket, brix.State.WRITABLE, 5 * SECOND) & (brix.State.WRITABLE | brix.State.PEER_GONE) == brix.State.WRITABLE
        if !made {
            // (Nobody listens there yet: once more in half a second.)
            _ = until(socket, 0, SECOND / 2)
            _ = brix.close(socket)
            socket = 0
            tries += 1
            if tries == 60 {
                say("reader: cannot connect\n")
                return 1
            }
        }
    }
    _ = brix.socketSend(socket, "GET ", null)
    _ = brix.socketSend(socket, path, null)
    _ = brix.socketSend(socket, " HTTP/1.0\r\n\r\n", null)
    say("reader: asked for ")
    say(path)
    say(", reading nothing for ")
    sayNumber(seconds)
    say(" s\n")
    _ = until(socket, 0, seconds * SECOND)
    var came: usize = 0
    var ended = false
    var bytes: [4096]u8 = undefined
    while !ended {
        const got = brix.socketReceive(socket, bytes[0..4096], null)
        if got == -brix.Status.would_block {
            if until(socket, brix.State.READABLE, 10 * SECOND) & brix.State.READABLE == 0 { break }
        } else if got <= 0 {
            ended = true
        } else {
            came += @bitCast(usize, got)
        }
    }
    _ = brix.close(socket)
    say("reader: ")
    sayNumber(came)
    say(if ended { " bytes came, then the connection's end\n" } else { " bytes came and no end\n" })
    return 0
}
