// mlx-lsp: the Mlx language server. It knows the code through the code
// index (tools/codemap/index.mlx: every .mlx file of the workspace read
// with the compiler's own lexer and parser, every name resolved), with the
// editor's unsaved texts in place of the files, read again a moment after
// a change. The compiler itself (mlx4, analyzing only) checks a file when
// it is opened or saved, and its errors come back as diagnostics.
//
// It answers: go to definition, find references, hover (signature, type,
// doc comment), document outline, workspace symbols, highlight the uses of
// a name, rename (everywhere), completion (members after a dot, what is in
// scope, keywords, builtins after @), signature help, and semantic tokens
// for highlighting. Over stdio (JSON-RPC with Content-Length headers).
//
// It also tells what MLX Observatory knows (insights.mlx): the crashes the
// desktop programs kept, the workarounds of missing features, complexity,
// and which programs reach a function. Hover shows them. A code lens above
// each function shows its uses and what is notable. The line a crash
// stopped on gets a warning, and every workaround a hint.
//
//   mlx-lsp        the editor starts it (vscode-extension/bin/mlx-lsp)
//
// MLX_COMPILER names the compiler; else the workspace's
// mlx-out/bin/compiler/mlx4, else mlx4 on the PATH.
const std = @import("std")
const index_module = @import("../codemap/index.mlx")
const aggregates = @import("../codemap/aggregates.mlx")
const protocol = @import("./protocol.mlx")
const json = @import("std.json")
const features = @import("./features.mlx")
const check_module = @import("./check.mlx")
const insights_module = @import("./insights.mlx")

const Index = index_module.Index
const Writer = protocol.Writer
const Request = protocol.Request
const NONE = index_module.NONE

const MAX_DOCUMENTS: usize = 128
const MAX_PUBLISHED: usize = 256
// How long after a change the index is read again (milliseconds).
const SETTLE: usize = 300

const Document = struct {
    path: [1024]u8
    pathLength: usize
    text: [*]u8
    textLength: usize
    textCapacity: usize
}

// A file with diagnostics shown, and the file whose check gave them.
const Published = struct {
    path: [512]u8
    pathLength: usize
    owner: [512]u8
    ownerLength: usize
}

const Server = struct {
    allocator: std.allocator.Allocator
    environment: [*][*]const u8
    arena: usize
    reader: protocol.Reader
    response: Writer
    notice: Writer
    root: [1024]u8
    rootLength: usize
    index: *Index
    hasIndex: bool
    built: bool
    dirty: bool
    changedAt: usize
    documents: [*]Document
    documentCount: usize
    overlays: [*]index_module.Overlay
    check: check_module.Check
    published: [*]Published
    publishedCount: usize
    shutdown: bool
    exiting: bool
    // What the code map knows, and how often the index was read (it is
    // worked out again for each reading).
    insights: insights_module.Insights
    builds: usize
}

fn insightsOf(server: *Server) -> *insights_module.Insights {
    unsafe { return @ptrCast(*insights_module.Insights, &server.*.insights) }
}

// ---------------------------------------------------------------------------
// Access

fn responseOf(server: *Server) -> *Writer {
    unsafe { return @ptrFromInt(*Writer, @intFromPtr(server) + @offsetOf(Server, "response")) }
}

fn noticeOf(server: *Server) -> *Writer {
    unsafe { return @ptrFromInt(*Writer, @intFromPtr(server) + @offsetOf(Server, "notice")) }
}

fn readerOf(server: *Server) -> *protocol.Reader {
    unsafe { return @ptrFromInt(*protocol.Reader, @intFromPtr(server) + @offsetOf(Server, "reader")) }
}

fn checkOf(server: *Server) -> *check_module.Check {
    unsafe { return @ptrFromInt(*check_module.Check, @intFromPtr(server) + @offsetOf(Server, "check")) }
}

fn rootText(server: *Server) -> []const u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(server) + @offsetOf(Server, "root"))[0..server.*.rootLength] }
}

fn documentAt(server: *Server, at: usize) -> *Document {
    unsafe { return @ptrFromInt(*Document, @intFromPtr(server.*.documents) + at * @sizeOf(Document)) }
}

fn documentPath(document: *Document) -> []const u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(document) + @offsetOf(Document, "path"))[0..document.*.pathLength] }
}

fn documentText(document: *Document) -> []const u8 { return document.*.text[0..document.*.textLength] }

fn publishedAt(server: *Server, at: usize) -> *Published {
    unsafe { return @ptrFromInt(*Published, @intFromPtr(server.*.published) + at * @sizeOf(Published)) }
}

fn publishedPath(entry: *Published) -> []const u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(entry) + @offsetOf(Published, "path"))[0..entry.*.pathLength] }
}

fn publishedOwner(entry: *Published) -> []const u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(entry) + @offsetOf(Published, "owner"))[0..entry.*.ownerLength] }
}

fn sameBytes(first: []const u8, second: []const u8) -> bool { return index_module.sameBytes(first, second) }

fn milliseconds() -> usize {
    var time: [2]i64 = [2]i64{ 0, 0 }
    unsafe { const got = std.linux.syscall2(228, 1, @intFromPtr(&time)) }
    return @intCast(usize, time[0]) * 1000 + @intCast(usize, time[1]) / 1000000
}

fn cString(value: [*]const u8) -> []const u8 {
    var length: usize = 0
    while value[length] != 0 { length += 1 }
    return value[0..length]
}

fn environmentValue(server: *Server, name: []const u8) -> []const u8 {
    var at: usize = 0
    while @intFromPtr(server.*.environment[at]) != 0 {
        const entry = cString(server.*.environment[at])
        if entry.length > name.length && entry[name.length] == 61 && sameBytes(entry[0..name.length], name) { return entry[name.length + 1..entry.length] }
        at += 1
    }
    return ""
}

// ---------------------------------------------------------------------------
// Documents

fn findDocument(server: *Server, path: []const u8) -> usize {
    var at: usize = 0
    while at < server.*.documentCount {
        if sameBytes(documentPath(documentAt(server, at)), path) { return at }
        at += 1
    }
    return MAX_DOCUMENTS
}

// The path of the request's document into out; its length.
fn requestPath(request: *Request, out: [*]u8) -> usize {
    var decoded: [2048]u8 = undefined
    var length: isize = 0
    unsafe { length = json.decodeString(request.*.uri, @ptrCast([*]u8, &decoded), 2048) }
    if length <= 0 { return 0 }
    unsafe { return protocol.uriPath(@ptrCast([*]u8, &decoded)[0..@bitCast(usize, length)], out, 1024) }
}

fn setText(server: *Server, document: *Document, raw: protocol.String) -> void {
    if document.*.textCapacity > 0 { server.*.allocator.free(document.*.text, document.*.textCapacity, 16) }
    var capacity: usize = 0
    var text: [*]u8 = undefined
    document.*.textLength = protocol.decodeInto(server.*.allocator, raw, &text, &capacity)
    document.*.text = text
    document.*.textCapacity = capacity
}

fn openDocument(server: *Server, path: []const u8, raw: protocol.String) -> void {
    var at = findDocument(server, path)
    if at == MAX_DOCUMENTS {
        if server.*.documentCount >= MAX_DOCUMENTS { return }
        at = server.*.documentCount
        server.*.documentCount += 1
        const document = documentAt(server, at)
        var length: usize = 0
        while length < path.length && length < 1023 {
            document.*.path[length] = path[length]
            length += 1
        }
        document.*.pathLength = length
        document.*.textCapacity = 0
        document.*.textLength = 0
    }
    setText(server, documentAt(server, at), raw)
    changed(server)
}

fn closeDocument(server: *Server, path: []const u8) -> void {
    const at = findDocument(server, path)
    if at == MAX_DOCUMENTS { return }
    const document = documentAt(server, at)
    if document.*.textCapacity > 0 { server.*.allocator.free(document.*.text, document.*.textCapacity, 16) }
    var move = at + 1
    while move < server.*.documentCount {
        const from = documentAt(server, move)
        const to = documentAt(server, move - 1)
        var copy: usize = 0
        while copy < from.*.pathLength {
            to.*.path[copy] = from.*.path[copy]
            copy += 1
        }
        to.*.pathLength = from.*.pathLength
        to.*.text = from.*.text
        to.*.textLength = from.*.textLength
        to.*.textCapacity = from.*.textCapacity
        move += 1
    }
    server.*.documentCount -= 1
    changed(server)
}

fn changed(server: *Server) -> void {
    server.*.dirty = true
    server.*.changedAt = milliseconds()
}

// ---------------------------------------------------------------------------
// The workspace and its index

fn isDirectory(path: []const u8) -> bool {
    var bytes: [1100]u8 = undefined
    var length: usize = 0
    while length < path.length && length < 1090 {
        bytes[length] = path[length]
        length += 1
    }
    bytes[length] = 0
    var handle: isize = 0
    unsafe { handle = std.linux.syscall3(2, @intFromPtr(&bytes), 65536 | 524288, 0) }
    if handle < 0 { return false }
    const closed = std.linux.syscall1(3, @bitCast(usize, handle))
    return true
}

fn hasStandardLibrary(path: []const u8) -> bool {
    var bytes: [1100]u8 = undefined
    var length: usize = 0
    while length < path.length && length < 1000 {
        bytes[length] = path[length]
        length += 1
    }
    for item in "/std/src" {
        bytes[length] = item
        length += 1
    }
    return isDirectory(bytes[0..length])
}

// The workspace: `path`, or the folder above it that has std/src (where
// the compiler finds `@import("std")`).
fn setRoot(server: *Server, path: []const u8) -> void {
    var length: usize = 0
    while length < path.length && length < 1000 {
        server.*.root[length] = path[length]
        length += 1
    }
    while length > 1 && server.*.root[length - 1] == 47 { length -= 1 }
    if !hasStandardLibrary(server.*.root[0..length]) {
        var probe = length
        var levels: usize = 0
        while probe > 1 && levels < 8 {
            probe -= 1
            while probe > 0 && server.*.root[probe] != 47 { probe -= 1 }
            if probe > 0 && hasStandardLibrary(server.*.root[0..probe]) {
                length = probe
                break
            }
            levels += 1
        }
    }
    server.*.root[length] = 0
    server.*.rootLength = length
    check_module.configure(checkOf(server), rootText(server), environmentValue(server, "MLX_COMPILER"), environmentValue(server, "PATH"))
    const compiler = check_module.compilerPath(checkOf(server))
    protocol.log("workspace ", rootText(server))
    if compiler.length > 0 { protocol.log("compiler ", compiler) } else { protocol.log("no compiler found (MLX_COMPILER, mlx-out/bin/compiler/mlx4, PATH): no diagnostics", "") }
    changed(server)
}

// Without a workspace from the editor: the Git work tree around a file.
fn rootFromFile(server: *Server, path: []const u8) -> void {
    if server.*.rootLength > 0 { return }
    var buffer: [1100]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var end = path.length
    while end > 0 && path[end - 1] != 47 { end -= 1 }
    if end > 0 { end -= 1 }
    var probe = end
    while probe > 0 {
        var length: usize = 0
        while length < probe && length < 1000 {
            bytes[length] = path[length]
            length += 1
        }
        for item in "/.git" {
            bytes[length] = item
            length += 1
        }
        if isDirectory(bytes[0..length]) {
            setRoot(server, path[0..probe])
            return
        }
        probe -= 1
        while probe > 0 && path[probe] != 47 { probe -= 1 }
    }
    setRoot(server, path[0..end])
}

fn isUnderRoot(server: *Server, path: []const u8) -> bool {
    const root = rootText(server)
    return path.length > root.length && sameBytes(path[0..root.length], root) && path[root.length] == 47
}

// Reads the workspace again (with the editor's texts), when it changed.
fn ensureIndex(server: *Server) -> void {
    if server.*.rootLength == 0 { return }
    if server.*.built && !server.*.dirty { return }
    const started = milliseconds()
    const where = aggregates.mark(server.*.arena)
    if !server.*.hasIndex {
        server.*.index = index_module.create(rootText(server))
        server.*.hasIndex = true
    }
    var at: usize = 0
    while at < server.*.documentCount {
        const document = documentAt(server, at)
        var record: *index_module.Overlay = undefined
        unsafe { record = @ptrFromInt(*index_module.Overlay, @intFromPtr(server.*.overlays) + at * @sizeOf(index_module.Overlay)) }
        unsafe { record.*.path = @ptrCast([*]const u8, &document.*.path) }
        record.*.pathLength = document.*.pathLength
        record.*.source = document.*.text
        record.*.sourceLength = document.*.textLength
        at += 1
    }
    index_module.setOverlays(server.*.index, server.*.overlays, server.*.documentCount)
    index_module.reset(server.*.index, rootText(server))
    index_module.addTree(server.*.index, rootText(server))
    // Open files outside the workspace too.
    at = 0
    while at < server.*.documentCount {
        const path = documentPath(documentAt(server, at))
        if !isUnderRoot(server, path) { const added = index_module.addPath(server.*.index, path) }
        at += 1
    }
    index_module.build(server.*.index)
    aggregates.reset(server.*.arena, where)
    server.*.builds += 1
    server.*.built = true
    server.*.dirty = false
    var text: [64]u8 = undefined
    var length: usize = 0
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = milliseconds() - started
    while rest > 0 || count == 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        text[length] = digits[count]
        length += 1
    }
    for item in " ms" {
        text[length] = item
        length += 1
    }
    protocol.log("read the workspace in ", text[0..length])
}

// The index's file for a path (NONE: not in it). `fresh`: read the
// workspace again first when it changed (completion and signature help do
// with the last reading, not to keep the typing waiting).
fn indexFile(server: *Server, path: []const u8, fresh: bool) -> u32 {
    if fresh || !server.*.built { ensureIndex(server) }
    if !server.*.built { return NONE }
    return index_module.findFile(server.*.index, path)
}

// ---------------------------------------------------------------------------
// Responses

fn beginResponse(server: *Server, request: *Request) -> *Writer {
    const writer = responseOf(server)
    protocol.clear(writer)
    protocol.text(writer, "{\"jsonrpc\":\"2.0\",\"id\":")
    if request.*.idIsString {
        protocol.byte(writer, 34)
        protocol.text(writer, protocol.slice(request.*.id))
        protocol.byte(writer, 34)
    } else {
        protocol.text(writer, protocol.slice(request.*.id))
    }
    protocol.text(writer, ",\"result\":")
    return writer
}

fn endResponse(server: *Server) -> void {
    const writer = responseOf(server)
    protocol.byte(writer, 125)
    protocol.send(protocol.contents(writer))
}

fn respondNull(server: *Server, request: *Request) -> void {
    const writer = beginResponse(server, request)
    protocol.text(writer, "null")
    endResponse(server)
}

fn respondError(server: *Server, request: *Request, code: []const u8, message: []const u8) -> void {
    const writer = responseOf(server)
    protocol.clear(writer)
    protocol.text(writer, "{\"jsonrpc\":\"2.0\",\"id\":")
    if request.*.idIsString {
        protocol.byte(writer, 34)
        protocol.text(writer, protocol.slice(request.*.id))
        protocol.byte(writer, 34)
    } else {
        protocol.text(writer, protocol.slice(request.*.id))
    }
    protocol.text(writer, ",\"error\":{\"code\":")
    protocol.text(writer, code)
    protocol.text(writer, ",\"message\":")
    protocol.string(writer, message)
    protocol.text(writer, "}}")
    protocol.send(protocol.contents(writer))
}

fn initializeResult(server: *Server, request: *Request) -> void {
    const writer = beginResponse(server, request)
    protocol.text(writer, "{\"capabilities\":{")
    protocol.text(writer, "\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":false}},")
    protocol.text(writer, "\"hoverProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,")
    protocol.text(writer, "\"documentSymbolProvider\":true,\"workspaceSymbolProvider\":true,\"documentHighlightProvider\":true,")
    protocol.text(writer, "\"renameProvider\":{\"prepareProvider\":true},\"codeLensProvider\":{\"resolveProvider\":false},")
    protocol.text(writer, "\"completionProvider\":{\"triggerCharacters\":[\".\",\"@\"]},")
    protocol.text(writer, "\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},")
    protocol.text(writer, "\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":[\"namespace\",\"type\",\"class\",\"enum\",\"interface\",\"struct\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"enumMember\",\"event\",\"function\",\"method\",\"macro\",\"keyword\",\"modifier\",\"comment\",\"string\",\"number\",\"regexp\",\"operator\",\"decorator\"],")
    protocol.text(writer, "\"tokenModifiers\":[\"declaration\",\"definition\",\"readonly\",\"static\",\"deprecated\",\"abstract\",\"async\",\"modification\",\"documentation\",\"defaultLibrary\"]},\"full\":true}")
    protocol.text(writer, "},\"serverInfo\":{\"name\":\"mlx-lsp\",\"version\":\"0.3.0\"}}")
    endResponse(server)
}

// ---------------------------------------------------------------------------
// Diagnostics

fn clearDiagnostics(server: *Server, path: []const u8) -> void {
    const writer = noticeOf(server)
    protocol.clear(writer)
    protocol.text(writer, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
    protocol.uri(writer, path)
    protocol.text(writer, ",\"diagnostics\":[]}}")
    protocol.send(protocol.contents(writer))
}

// The text a diagnostic's line and column are in: the editor's, else the
// index's copy, else none.
fn textFor(server: *Server, path: []const u8) -> []const u8 {
    const at = findDocument(server, path)
    if at != MAX_DOCUMENTS { return documentText(documentAt(server, at)) }
    if server.*.built {
        const file = index_module.findFile(server.*.index, path)
        if file != NONE { return index_module.sourceOf(server.*.index, file) }
    }
    return ""
}

fn isNameByte(value: u8) -> bool { return (value >= 97 && value <= 122) || (value >= 65 && value <= 90) || (value >= 48 && value <= 57) || value == 95 }

// One diagnostic: its range (the name at the column), severity, code and
// message.
fn diagnosticJson(writer: *Writer, source: []const u8, check: *check_module.Check, diagnostic: *check_module.Diagnostic, index: *Index, file: u32) -> void {
    const output = check_module.outputText(check)
    var line = if diagnostic.*.line > 0 { diagnostic.*.line - 1 } else { 0 }
    const column = if diagnostic.*.column > 0 { diagnostic.*.column - 1 } else { 0 }
    var start_units = column
    var end_units = column + 1
    if source.length > 0 {
        var at: usize = 0
        var current: usize = 0
        while current < line && at < source.length {
            if source[at] == 10 { current += 1 }
            at += 1
        }
        var byte = at + column
        if byte > source.length { byte = source.length }
        var end = byte
        while end < source.length && isNameByte(source[end]) { end += 1 }
        if end == byte && end < source.length && source[end] != 10 { end += 1 }
        start_units = protocol.utf16Units(source, at, byte)
        end_units = protocol.utf16Units(source, at, end)
        if end_units == start_units { end_units = start_units + 1 }
    }
    protocol.text(writer, "{\"range\":{\"start\":{\"line\":")
    protocol.number(writer, line)
    protocol.text(writer, ",\"character\":")
    protocol.number(writer, start_units)
    protocol.text(writer, "},\"end\":{\"line\":")
    protocol.number(writer, line)
    protocol.text(writer, ",\"character\":")
    protocol.number(writer, end_units)
    protocol.text(writer, "}},\"severity\":")
    protocol.number(writer, if diagnostic.*.isError { 1 } else { 2 })
    protocol.text(writer, ",\"source\":\"mlx\"")
    if diagnostic.*.codeLength > 0 {
        protocol.text(writer, ",\"code\":")
        protocol.string(writer, output[diagnostic.*.codeStart..diagnostic.*.codeStart + diagnostic.*.codeLength])
    }
    // The compiler's message, and the names on the line nothing declares
    // (the likeliest cause of many of its errors).
    var message: Writer = undefined
    protocol.initWriter(&message, writer.*.allocator, 512)
    protocol.text(&message, output[diagnostic.*.messageStart..diagnostic.*.messageStart + diagnostic.*.messageLength])
    if diagnostic.*.isError && file != NONE {
        const mark = message.length
        protocol.text(&message, " (not declared: ")
        if features.undeclaredOnLine(&message, index, file, line) {
            protocol.byte(&message, 41)
        } else {
            message.length = mark
        }
    }
    protocol.text(writer, ",\"message\":")
    protocol.string(writer, protocol.contents(&message))
    protocol.byte(writer, 125)
    message.allocator.free(message.bytes, message.capacity, 16)
}

// A diagnostic's file: absolute, "." and ".." folded; none: the file
// checked.
fn diagnosticPath(server: *Server, check: *check_module.Check, diagnostic: *check_module.Diagnostic, out: [*]u8) -> usize {
    const output = check_module.outputText(check)
    const given = output[diagnostic.*.pathStart..diagnostic.*.pathStart + diagnostic.*.pathLength]
    var raw: [2100]u8 = undefined
    var length: usize = 0
    if given.length == 0 {
        for item in check_module.filePath(check) {
            raw[length] = item
            length += 1
        }
    } else {
        if given[0] != 47 {
            for item in rootText(server) {
                raw[length] = item
                length += 1
            }
            raw[length] = 47
            length += 1
        }
        for item in given {
            if length < 2090 {
                raw[length] = item
                length += 1
            }
        }
    }
    // Fold the parts.
    var result: usize = 0
    var at: usize = 0
    while at < length {
        var end = at
        while end < length && raw[end] != 47 { end += 1 }
        const part_length = end - at
        if part_length == 0 || (part_length == 1 && raw[at] == 46) {
            // "" or ".": nothing.
        } else if part_length == 2 && raw[at] == 46 && raw[at + 1] == 46 {
            while result > 0 && out[result - 1] != 47 { result -= 1 }
            if result > 0 { result -= 1 }
        } else if result + part_length + 1 < 1024 {
            out[result] = 47
            result += 1
            var copy = at
            while copy < end {
                out[result] = raw[copy]
                result += 1
                copy += 1
            }
        }
        at = end + 1
    }
    return result
}

// After a check: the diagnostics per file, and empty lists for the files
// this file's last check had and this one has not.
fn publishCheck(server: *Server) -> void {
    // The index up to date (the names on the lines come from it).
    ensureIndex(server)
    const check = checkOf(server)
    const owner = check_module.filePath(check)
    var paths: [64][1024]u8 = undefined
    var path_lengths: [64]usize = undefined
    var path_count: usize = 0
    var buffer: [1024]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    // The files, in the order they come.
    var at: usize = 0
    while at < check.*.count {
        const length = diagnosticPath(server, check, check_module.diagnosticAt(check, at), bytes)
        var known = false
        var index: usize = 0
        while index < path_count {
            if path_lengths[index] == length && sameBytes(paths[index][0..length], bytes[0..length]) { known = true }
            index += 1
        }
        if !known && path_count < 64 {
            var copy: usize = 0
            while copy < length {
                paths[path_count][copy] = bytes[copy]
                copy += 1
            }
            path_lengths[path_count] = length
            path_count += 1
        }
        at += 1
    }
    // Each file's list.
    var file: usize = 0
    while file < path_count {
        const path = paths[file][0..path_lengths[file]]
        const source = textFor(server, path)
        // The index's copy, when it has the same text (for the names).
        var indexed = NONE
        if server.*.built {
            indexed = index_module.findFile(server.*.index, path)
            if indexed != NONE && !sameBytes(index_module.sourceOf(server.*.index, indexed), source) { indexed = NONE }
        }
        const writer = noticeOf(server)
        protocol.clear(writer)
        protocol.text(writer, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
        protocol.uri(writer, path)
        protocol.text(writer, ",\"diagnostics\":[")
        var first = true
        at = 0
        while at < check.*.count {
            const diagnostic = check_module.diagnosticAt(check, at)
            const length = diagnosticPath(server, check, diagnostic, bytes)
            if length == path.length && sameBytes(bytes[0..length], path) {
                if !first { protocol.byte(writer, 44) }
                first = false
                diagnosticJson(writer, source, check, diagnostic, server.*.index, indexed)
            }
            at += 1
        }
        if indexed != NONE {
            insights_module.ensure(insightsOf(server), server.*.index, server.*.builds, indexed)
            insights_module.diagnostics(insightsOf(server), writer, indexed, &first)
        }
        protocol.text(writer, "]}}")
        protocol.send(protocol.contents(writer))
        file += 1
    }
    // Clear what this file's checks showed before and no longer do.
    var entry: usize = 0
    while entry < server.*.publishedCount {
        const published = publishedAt(server, entry)
        var still = false
        var index: usize = 0
        while index < path_count {
            if sameBytes(publishedPath(published), paths[index][0..path_lengths[index]]) { still = true }
            index += 1
        }
        if sameBytes(publishedOwner(published), owner) && !still {
            clearDiagnostics(server, publishedPath(published))
            // Removed: the last one takes its place.
            const last = publishedAt(server, server.*.publishedCount - 1)
            var copy: usize = 0
            while copy < last.*.pathLength {
                published.*.path[copy] = last.*.path[copy]
                copy += 1
            }
            published.*.pathLength = last.*.pathLength
            copy = 0
            while copy < last.*.ownerLength {
                published.*.owner[copy] = last.*.owner[copy]
                copy += 1
            }
            published.*.ownerLength = last.*.ownerLength
            server.*.publishedCount -= 1
        } else {
            entry += 1
        }
    }
    // The file checked with nothing to say: an empty list for it.
    var owner_listed = false
    at = 0
    while at < path_count {
        if sameBytes(paths[at][0..path_lengths[at]], owner) { owner_listed = true }
        at += 1
    }
    if !owner_listed { publishInsights(server, owner) }
    // Remember the files now showing some.
    at = 0
    while at < path_count {
        const path = paths[at][0..path_lengths[at]]
        var known = false
        var index: usize = 0
        while index < server.*.publishedCount {
            if sameBytes(publishedPath(publishedAt(server, index)), path) { known = true }
            index += 1
        }
        if !known && server.*.publishedCount < MAX_PUBLISHED && path.length < 512 && owner.length < 512 {
            const published = publishedAt(server, server.*.publishedCount)
            var copy: usize = 0
            while copy < path.length {
                published.*.path[copy] = path[copy]
                copy += 1
            }
            published.*.pathLength = path.length
            copy = 0
            while copy < owner.length {
                published.*.owner[copy] = owner[copy]
                copy += 1
            }
            published.*.ownerLength = owner.length
            server.*.publishedCount += 1
        }
        at += 1
    }
}

// ---------------------------------------------------------------------------
// Handling

// Hover: what features says (signature, type, doc), then what the code map
// knows.
fn hover(server: *Server, writer: *Writer, file: u32, offset: usize) -> void {
    const index = server.*.index
    const symbol = features.symbolAt(index, file, offset)
    if symbol == NONE {
        protocol.text(writer, "null")
        return
    }
    insights_module.ensure(insightsOf(server), index, server.*.builds, index_module.symbolAt(index, symbol).*.file)
    var markdown: Writer = undefined
    protocol.initWriter(&markdown, writer.*.allocator, 4096)
    features.describe(&markdown, index, symbol)
    insights_module.hover(insightsOf(server), &markdown, symbol)
    protocol.text(writer, "{\"contents\":{\"kind\":\"markdown\",\"value\":")
    protocol.string(writer, protocol.contents(&markdown))
    protocol.text(writer, "}")
    const ref = index_module.refAtOffset(index, file, offset)
    if ref != index_module.MAX_REFS {
        const value = index_module.refAt(index, ref)
        protocol.text(writer, ",\"range\":")
        features.range(writer, index, file, @intCast(usize, value.*.start), @intCast(usize, value.*.start + value.*.length))
    }
    protocol.byte(writer, 125)
    markdown.allocator.free(markdown.bytes, markdown.capacity, 16)
}

// A file's diagnostics when the compiler says nothing of it: only the code
// map's (crash lines, workarounds).
fn publishInsights(server: *Server, path: []const u8) -> void {
    const writer = noticeOf(server)
    protocol.clear(writer)
    protocol.text(writer, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":")
    protocol.uri(writer, path)
    protocol.text(writer, ",\"diagnostics\":[")
    var first = true
    if server.*.built {
        const file = index_module.findFile(server.*.index, path)
        if file != NONE && sameBytes(index_module.sourceOf(server.*.index, file), textFor(server, path)) {
            insights_module.ensure(insightsOf(server), server.*.index, server.*.builds, file)
            insights_module.diagnostics(insightsOf(server), writer, file, &first)
        }
    }
    protocol.text(writer, "]}}")
    protocol.send(protocol.contents(writer))
}

fn positionRequest(server: *Server, request: *Request, file: *u32, offset: *usize, fresh: bool) -> bool {
    var path: [1024]u8 = undefined
    var length: usize = 0
    unsafe { length = requestPath(request, @ptrCast([*]u8, &path)) }
    if length == 0 { return false }
    file.* = indexFile(server, path[0..length], fresh)
    if file.* == NONE { return false }
    offset.* = features.offsetIn(server.*.index, file.*, request.*.line, request.*.character)
    return true
}

// The open document of the request (for completion and signature help,
// which read what is typed); MAX_DOCUMENTS when it is not open.
fn editorDocument(server: *Server, request: *Request) -> usize {
    var path: [1024]u8 = undefined
    var length: usize = 0
    unsafe { length = requestPath(request, @ptrCast([*]u8, &path)) }
    return findDocument(server, path[0..length])
}

fn handle(server: *Server, body: []const u8) -> void {
    var request: Request = undefined
    if !protocol.parse(body, &request) {
        protocol.log("a message that is not JSON", "")
        return
    }
    const method = protocol.slice(request.method)
    if sameBytes(method, "initialize") {
        var decoded: [2048]u8 = undefined
        var length: isize = 0
        var raw = request.rootUri
        if raw.length == 0 { raw = request.folderUri }
        if raw.length > 0 {
            unsafe { length = json.decodeString(raw, @ptrCast([*]u8, &decoded), 2048) }
            var path: [1024]u8 = undefined
            var path_length: usize = 0
            unsafe { path_length = protocol.uriPath(@ptrCast([*]u8, &decoded)[0..@bitCast(usize, length)], @ptrCast([*]u8, &path), 1024) }
            if path_length > 0 { setRoot(server, path[0..path_length]) }
        } else if request.rootPath.length > 0 {
            unsafe { length = json.decodeString(request.rootPath, @ptrCast([*]u8, &decoded), 2048) }
            if length > 0 { unsafe { setRoot(server, @ptrCast([*]u8, &decoded)[0..@bitCast(usize, length)]) } }
        }
        initializeResult(server, &request)
        return
    }
    if sameBytes(method, "initialized") {
        ensureIndex(server)
        return
    }
    if sameBytes(method, "shutdown") {
        server.*.shutdown = true
        respondNull(server, &request)
        return
    }
    if sameBytes(method, "exit") {
        server.*.exiting = true
        return
    }
    // Documents.
    if sameBytes(method, "textDocument/didOpen") || sameBytes(method, "textDocument/didChange") || sameBytes(method, "textDocument/didSave") || sameBytes(method, "textDocument/didClose") {
        var path: [1024]u8 = undefined
        var length: usize = 0
        unsafe { length = requestPath(&request, @ptrCast([*]u8, &path)) }
        if length == 0 { return }
        const file_path = path[0..length]
        rootFromFile(server, file_path)
        if sameBytes(method, "textDocument/didClose") {
            closeDocument(server, file_path)
        } else if request.hasText {
            openDocument(server, file_path, request.text)
        }
        if sameBytes(method, "textDocument/didOpen") || sameBytes(method, "textDocument/didSave") { check_module.request(checkOf(server), file_path, milliseconds()) }
        return
    }
    if !request.hasId { return }
    // Questions.
    var file: u32 = NONE
    var offset: usize = 0
    if sameBytes(method, "textDocument/definition") || sameBytes(method, "textDocument/references") || sameBytes(method, "textDocument/hover") || sameBytes(method, "textDocument/documentHighlight") || sameBytes(method, "textDocument/prepareRename") || sameBytes(method, "textDocument/rename") {
        if !positionRequest(server, &request, &file, &offset, true) {
            respondNull(server, &request)
            return
        }
        const index = server.*.index
        if sameBytes(method, "textDocument/rename") {
            var name: [256]u8 = undefined
            var length: isize = 0
            unsafe { length = json.decodeString(request.newName, @ptrCast([*]u8, &name), 256) }
            if length <= 0 {
                respondError(server, &request, "-32602", "no new name")
                return
            }
            const writer = beginResponse(server, &request)
            const mark = writer.*.length
            var renamed = false
            unsafe { renamed = features.rename(writer, index, file, offset, @ptrCast([*]u8, &name)[0..@bitCast(usize, length)]) }
            if !renamed {
                respondError(server, &request, "-32602", "this cannot be renamed (or the new name is not a name)")
                return
            }
            endResponse(server)
            return
        }
        const writer = beginResponse(server, &request)
        if sameBytes(method, "textDocument/definition") { features.definition(writer, index, file, offset) }
        if sameBytes(method, "textDocument/references") { features.references(writer, index, file, offset, request.includeDeclaration) }
        if sameBytes(method, "textDocument/hover") { hover(server, writer, file, offset) }
        if sameBytes(method, "textDocument/documentHighlight") { features.highlights(writer, index, file, offset) }
        if sameBytes(method, "textDocument/prepareRename") { features.prepareRename(writer, index, file, offset) }
        endResponse(server)
        return
    }
    if sameBytes(method, "textDocument/completion") || sameBytes(method, "textDocument/signatureHelp") {
        const open = editorDocument(server, &request)
        if open == MAX_DOCUMENTS || !positionRequest(server, &request, &file, &offset, false) {
            respondNull(server, &request)
            return
        }
        const text = documentText(documentAt(server, open))
        const cursor = protocol.offsetOf(text, request.line, request.character)
        const writer = beginResponse(server, &request)
        if sameBytes(method, "textDocument/completion") {
            features.completion(writer, server.*.index, file, text, cursor, offset)
        } else {
            features.signatureHelp(writer, server.*.index, file, text, cursor, offset)
        }
        endResponse(server)
        return
    }
    if sameBytes(method, "textDocument/codeLens") {
        var path: [1024]u8 = undefined
        var length: usize = 0
        unsafe { length = requestPath(&request, @ptrCast([*]u8, &path)) }
        file = indexFile(server, path[0..length], true)
        if file == NONE {
            respondNull(server, &request)
            return
        }
        insights_module.ensure(insightsOf(server), server.*.index, server.*.builds, file)
        const writer = beginResponse(server, &request)
        insights_module.codeLens(insightsOf(server), writer, file)
        endResponse(server)
        return
    }
    if sameBytes(method, "textDocument/documentSymbol") || sameBytes(method, "textDocument/semanticTokens/full") {
        var path: [1024]u8 = undefined
        var length: usize = 0
        unsafe { length = requestPath(&request, @ptrCast([*]u8, &path)) }
        file = indexFile(server, path[0..length], true)
        if file == NONE {
            respondNull(server, &request)
            return
        }
        const writer = beginResponse(server, &request)
        if sameBytes(method, "textDocument/documentSymbol") { features.documentSymbols(writer, server.*.index, file) } else { features.semanticTokens(writer, server.*.index, file) }
        endResponse(server)
        return
    }
    if sameBytes(method, "workspace/symbol") {
        ensureIndex(server)
        if !server.*.built {
            respondNull(server, &request)
            return
        }
        var query: [256]u8 = undefined
        var length: isize = 0
        unsafe { length = json.decodeString(request.query, @ptrCast([*]u8, &query), 256) }
        if length < 0 { length = 0 }
        const writer = beginResponse(server, &request)
        unsafe { features.workspaceSymbols(writer, server.*.index, @ptrCast([*]u8, &query)[0..@bitCast(usize, length)]) }
        endResponse(server)
        return
    }
    if sameBytes(method, "mlx/ast") {
        respondNull(server, &request)
        return
    }
    respondError(server, &request, "-32601", "not handled by mlx-lsp")
}

// ---------------------------------------------------------------------------
// The loop

// Waits until stdin or the check's pipe is readable, or `timeout`
// milliseconds (-1: no limit); which are.
fn wait(server: *Server, timeout: isize, input: *bool, pipe: *bool) -> void {
    var fds: [4]i32 = [4]i32{ 0, 1, -1, 1 }
    const check = checkOf(server)
    var count: usize = 1
    if check.*.running {
        fds[2] = @intCast(i32, check.*.pipe)
        count = 2
    }
    var ready: isize = 0
    unsafe { ready = std.linux.syscall3(7, @intFromPtr(&fds), count, @bitCast(usize, timeout)) }
    input.* = false
    pipe.* = false
    if ready <= 0 { return }
    // revents: the upper half of each entry's second word.
    input.* = (fds[1] >> 16) != 0
    pipe.* = count == 2 && (fds[3] >> 16) != 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    const memory = allocator.alloc(@sizeOf(Server), 16)
    var server: *Server = undefined
    unsafe { server = @ptrCast(*Server, memory.?) }
    server.*.allocator = allocator
    server.*.environment = std.process.environmentEntries(arguments)
    server.*.arena = aggregates.find()
    protocol.initReader(readerOf(server), allocator)
    protocol.initWriter(responseOf(server), allocator, 1048576)
    protocol.initWriter(noticeOf(server), allocator, 65536)
    server.*.rootLength = 0
    server.*.hasIndex = false
    server.*.built = false
    server.*.dirty = false
    server.*.documentCount = 0
    server.*.publishedCount = 0
    server.*.shutdown = false
    server.*.exiting = false
    unsafe {
        server.*.documents = @ptrCast([*]Document, allocator.alloc(MAX_DOCUMENTS * @sizeOf(Document), 16).?)
        server.*.overlays = @ptrCast([*]index_module.Overlay, allocator.alloc(MAX_DOCUMENTS * @sizeOf(index_module.Overlay), 16).?)
        server.*.published = @ptrCast([*]Published, allocator.alloc(MAX_PUBLISHED * @sizeOf(Published), 16).?)
    }
    check_module.init(checkOf(server), allocator, server.*.environment)
    insights_module.init(insightsOf(server), allocator, server.*.environment, server.*.arena)
    server.*.builds = 0
    const reader = readerOf(server)
    while !server.*.exiting {
        const now = milliseconds()
        var timeout: isize = -1
        if server.*.dirty && server.*.built {
            timeout = if now >= server.*.changedAt + SETTLE { 0 } else { @intCast(isize, server.*.changedAt + SETTLE - now) }
        }
        if checkOf(server).*.running && (timeout < 0 || timeout > 1000) { timeout = 1000 }
        var input = false
        var pipe = false
        wait(server, timeout, &input, &pipe)
        if input && !protocol.fill(reader) { break }
        while protocol.message(reader) && !server.*.exiting {
            const where = aggregates.mark(server.*.arena)
            handle(server, protocol.body(reader))
            aggregates.reset(server.*.arena, where)
            protocol.consume(reader)
        }
        const check = checkOf(server)
        if pipe && check_module.pump(check) {
            const where = aggregates.mark(server.*.arena)
            publishCheck(server)
            aggregates.reset(server.*.arena, where)
            const started = check_module.next(check, milliseconds())
        }
        if check_module.stopIfStuck(check, milliseconds()) {
            protocol.log("the compiler took over a minute; stopped it", "")
            const started = check_module.next(check, milliseconds())
        }
        // A while after the last change: the index again.
        if server.*.dirty && server.*.built && milliseconds() >= server.*.changedAt + SETTLE { ensureIndex(server) }
    }
    return if server.*.shutdown { 0 } else { 1 }
}
