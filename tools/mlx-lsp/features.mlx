// mlx-lsp's answers, from the code index (tools/codemap/index.mlx): where
// a name is declared, where it is used, what it is (its signature, type
// and doc comment), a file's outline, the workspace's declarations, the
// uses of a name in a file, renaming it everywhere, what can come next
// (members after a dot, what is in scope), the parameters of the call at
// the cursor, and the kinds of the names for highlighting. Each writes the
// JSON value of the response's result.
const std = @import("std")
const index_module = @import("../codemap/index.mlx")
const protocol = @import("./protocol.mlx")

const Index = index_module.Index
const Writer = protocol.Writer
const NONE = index_module.NONE
const Kind = index_module.Kind

// ---------------------------------------------------------------------------
// Positions and places

fn sourceOf(index: *Index, file: u32) -> []const u8 { return index_module.sourceOf(index, file) }

// A file's path relative to the workspace.
fn shortPath(index: *Index, file: u32) -> []const u8 {
    const path = index_module.pathOf(index, file)
    const root = index.*.root[0..index.*.rootLength]
    if path.length > root.length + 1 && index_module.sameBytes(path[0..root.length], root) && path[root.length] == 47 { return path[root.length + 1..path.length] }
    return path
}

pub fn offsetIn(index: *Index, file: u32, line: usize, character: usize) -> usize {
    const record = index_module.fileAt(index, file)
    if line >= record.*.lineCount { return record.*.sourceLength }
    return protocol.byteAfterUnits(sourceOf(index, file), @intCast(usize, record.*.lineStarts[line]), character)
}

fn positionIn(writer: *Writer, index: *Index, file: u32, offset: usize) -> void {
    const line = index_module.lineOf(index, file, offset)
    const start = @intCast(usize, index_module.fileAt(index, file).*.lineStarts[line])
    protocol.positionAt(writer, sourceOf(index, file), line, start, offset)
}

pub fn range(writer: *Writer, index: *Index, file: u32, start: usize, end: usize) -> void {
    protocol.text(writer, "{\"start\":")
    positionIn(writer, index, file, start)
    protocol.text(writer, ",\"end\":")
    positionIn(writer, index, file, end)
    protocol.byte(writer, 125)
}

fn location(writer: *Writer, index: *Index, file: u32, start: usize, end: usize) -> void {
    protocol.text(writer, "{\"uri\":")
    protocol.uri(writer, index_module.pathOf(index, file))
    protocol.text(writer, ",\"range\":")
    range(writer, index, file, start, end)
    protocol.byte(writer, 125)
}

fn nameStart(index: *Index, symbol: u32) -> usize { return @intCast(usize, index_module.symbolAt(index, symbol).*.nameStart) }

fn nameEnd(index: *Index, symbol: u32) -> usize {
    const record = index_module.symbolAt(index, symbol)
    if record.*.kind == index_module.FILE { return 0 }
    return @intCast(usize, record.*.nameStart + record.*.nameLength)
}

// Where a symbol is declared: its name (a file: its start).
fn declarationLocation(writer: *Writer, index: *Index, symbol: u32) -> void {
    const record = index_module.symbolAt(index, symbol)
    if record.*.kind == index_module.FILE {
        location(writer, index, record.*.file, 0, 0)
        return
    }
    location(writer, index, record.*.file, nameStart(index, symbol), nameEnd(index, symbol))
}

// The symbol a use at `offset` means; an import's name goes to its file
// when `through` is set.
pub fn symbolAt(index: *Index, file: u32, offset: usize) -> u32 {
    var symbol = index_module.symbolAtOffset(index, file, offset)
    if symbol == NONE && offset > 0 { symbol = index_module.symbolAtOffset(index, file, offset - 1) }
    return symbol
}

fn isLocal(kind: u8) -> bool { return kind == index_module.PARAM || kind == index_module.LOCAL_CONST || kind == index_module.LOCAL_VAR || kind == index_module.CAPTURE }

fn isContainer(kind: u8) -> bool { return kind == index_module.STRUCT || kind == index_module.ENUM || kind == index_module.UNION || kind == index_module.ERROR_SET }

// ---------------------------------------------------------------------------
// Definition, references, highlights

pub fn definition(writer: *Writer, index: *Index, file: u32, offset: usize) -> void {
    const symbol = symbolAt(index, file, offset)
    if symbol == NONE {
        protocol.text(writer, "null")
        return
    }
    const record = index_module.symbolAt(index, symbol)
    // An import's name: its file.
    if record.*.kind == index_module.IMPORT && record.*.target != NONE {
        const ref = index_module.refAtOffset(index, file, offset)
        const at_declaration = ref != index_module.MAX_REFS && index_module.refAt(index, ref).*.use == index_module.USE_DECLARATION
        if at_declaration {
            declarationLocation(writer, index, record.*.target)
            return
        }
    }
    declarationLocation(writer, index, symbol)
}

pub fn references(writer: *Writer, index: *Index, file: u32, offset: usize, with_declaration: bool) -> void {
    const symbol = symbolAt(index, file, offset)
    if symbol == NONE {
        protocol.text(writer, "null")
        return
    }
    protocol.byte(writer, 91)
    var first = true
    var ref: usize = 0
    while ref < index.*.refCount {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol && (with_declaration || value.*.use != index_module.USE_DECLARATION) {
            if !first { protocol.byte(writer, 44) }
            first = false
            location(writer, index, value.*.file, @intCast(usize, value.*.start), @intCast(usize, value.*.start + value.*.length))
        }
        ref += 1
    }
    protocol.byte(writer, 93)
}

pub fn highlights(writer: *Writer, index: *Index, file: u32, offset: usize) -> void {
    const symbol = symbolAt(index, file, offset)
    if symbol == NONE {
        protocol.text(writer, "null")
        return
    }
    const record = index_module.fileAt(index, file)
    protocol.byte(writer, 91)
    var first = true
    var ref = record.*.refStart
    while ref < record.*.refEnd {
        const value = index_module.refAt(index, ref)
        if value.*.symbol == symbol {
            if !first { protocol.byte(writer, 44) }
            first = false
            protocol.text(writer, "{\"range\":")
            range(writer, index, file, @intCast(usize, value.*.start), @intCast(usize, value.*.start + value.*.length))
            protocol.text(writer, ",\"kind\":")
            protocol.number(writer, if value.*.use == index_module.USE_WRITE || value.*.use == index_module.USE_DECLARATION { 3 } else { 2 })
            protocol.byte(writer, 125)
        }
        ref += 1
    }
    protocol.byte(writer, 93)
}

// ---------------------------------------------------------------------------
// What a name is

fn qualified(writer: *Writer, index: *Index, symbol: u32) -> void {
    const parent = index_module.symbolAt(index, symbol).*.parent
    if parent != NONE && index_module.symbolAt(index, parent).*.kind != index_module.FILE && !isLocal(index_module.symbolAt(index, symbol).*.kind) {
        qualified(writer, index, parent)
        protocol.byte(writer, 46)
    }
    protocol.text(writer, index_module.nameOf(index, symbol))
}

// A type in Mlx notation ("*Scene", "?[]u8"; "" when unknown).
fn typeName(writer: *Writer, index: *Index, ty: index_module.Ty) -> bool {
    if ty.symbol == NONE { return false }
    var depth = ty.depth
    var wraps = ty.wraps
    while depth > 0 {
        const wrap = wraps & 7
        if wrap == index_module.WRAP_POINTER { protocol.byte(writer, 42) }
        if wrap == index_module.WRAP_MANY { protocol.text(writer, "[*]") }
        if wrap == index_module.WRAP_SLICE { protocol.text(writer, "[]") }
        if wrap == index_module.WRAP_ARRAY { protocol.text(writer, "[_]") }
        if wrap == index_module.WRAP_OPTIONAL { protocol.byte(writer, 63) }
        wraps = wraps >> 3
        depth -= 1
    }
    const target = index_module.symbolAt(index, ty.symbol)
    if target.*.kind == index_module.FILE {
        protocol.text(writer, "module ")
        protocol.text(writer, shortPath(index, target.*.file))
    } else {
        qualified(writer, index, ty.symbol)
    }
    return true
}

// The doc comment's text, `//` taken off each line.
fn docText(writer: *Writer, index: *Index, symbol: u32) -> bool {
    var start: usize = 0
    var length: usize = 0
    index_module.docRange(index, symbol, &start, &length)
    if length == 0 { return false }
    const source = sourceOf(index, index_module.symbolAt(index, symbol).*.file)
    var at = start
    const end = start + length
    var wrote = false
    while at < end {
        var line_end = at
        while line_end < end && source[line_end] != 10 { line_end += 1 }
        var from = at
        while from < line_end && (source[from] == 32 || source[from] == 9) { from += 1 }
        if from + 1 < line_end + 1 && from < line_end && source[from] == 47 { from += 1 }
        if from < line_end && source[from] == 47 { from += 1 }
        if from < line_end && source[from] == 32 { from += 1 }
        protocol.text(writer, source[from..line_end])
        protocol.byte(writer, 10)
        wrote = true
        at = line_end + 1
    }
    return wrote
}

pub fn signatureText(index: *Index, symbol: u32) -> []const u8 {
    var start: usize = 0
    var length: usize = 0
    index_module.signatureRange(index, symbol, &start, &length)
    const source = sourceOf(index, index_module.symbolAt(index, symbol).*.file)
    return source[start..start + length]
}

// The hover's markdown.
pub fn describe(writer: *Writer, index: *Index, symbol: u32) -> void {
    const record = index_module.symbolAt(index, symbol)
    if record.*.kind == index_module.FILE {
        protocol.text(writer, "**module** `")
        protocol.text(writer, shortPath(index, record.*.file))
        protocol.text(writer, "`\n\n")
        const described = docText(writer, index, symbol)
        return
    }
    // Where it is first (its file and the containers around it), as
    // rust-analyzer shows a path.
    protocol.byte(writer, 96)
    owner(writer, index, symbol)
    protocol.text(writer, "`\n")
    protocol.text(writer, "```mlx\n")
    protocol.text(writer, signatureText(index, symbol))
    protocol.text(writer, "\n```\n")
    // A value's type when it is not written down.
    if !isContainer(record.*.kind) && record.*.kind != index_module.FUNCTION && record.*.kind != index_module.TEST {
        const ty = index_module.typeOfSymbol(index, symbol)
        const mark = writer.*.length
        protocol.text(writer, "Type: `")
        if typeName(writer, index, ty) {
            protocol.text(writer, "`\n\n")
        } else {
            writer.*.length = mark
        }
    }
    const wrote = docText(writer, index, symbol)
    if wrote { protocol.byte(writer, 10) }
    protocol.byte(writer, 42)
    protocol.text(writer, index_module.kindName(record.*.kind))
    protocol.text(writer, " ")
    qualified(writer, index, symbol)
    protocol.text(writer, "* in `")
    protocol.text(writer, shortPath(index, record.*.file))
    protocol.text(writer, ":")
    protocol.number(writer, index_module.lineOf(index, record.*.file, nameStart(index, symbol)) + 1)
    protocol.text(writer, "`")
}

// What a declaration is in, as a path: its file, then the containers
// around it (the struct of a field, the function of a local), outermost
// first.
pub fn owner(writer: *Writer, index: *Index, symbol: u32) -> void {
    const record = index_module.symbolAt(index, symbol)
    protocol.text(writer, shortPath(index, record.*.file))
    var chain: [8]u32 = undefined
    var count: usize = 0
    var parent = record.*.parent
    while parent != NONE && count < 8 && index_module.symbolAt(index, parent).*.kind != index_module.FILE {
        chain[count] = parent
        count += 1
        parent = index_module.symbolAt(index, parent).*.parent
    }
    while count > 0 {
        count -= 1
        protocol.text(writer, " › ")
        protocol.text(writer, index_module.nameOf(index, chain[count]))
    }
}

// Where a declaration belongs, as a line: its kind and name, what holds it
// (a field of a struct, a local in a function), its file and line.
pub fn place(writer: *Writer, index: *Index, symbol: u32) -> void {
    const record = index_module.symbolAt(index, symbol)
    const kind = record.*.kind
    protocol.text(writer, index_module.kindName(kind))
    protocol.byte(writer, 32)
    protocol.text(writer, index_module.nameOf(index, symbol))
    const parent = record.*.parent
    if parent != NONE && index_module.symbolAt(index, parent).*.kind != index_module.FILE {
        const owner = index_module.symbolAt(index, parent)
        protocol.text(writer, if kind == index_module.FIELD || kind == index_module.MEMBER || kind == index_module.PARAM { " of " } else { " in " })
        protocol.text(writer, index_module.kindName(owner.*.kind))
        protocol.byte(writer, 32)
        qualified(writer, index, parent)
    }
    if kind == index_module.FILE {
        protocol.text(writer, " ")
        protocol.text(writer, shortPath(index, record.*.file))
        return
    }
    protocol.text(writer, ", ")
    protocol.text(writer, shortPath(index, record.*.file))
    protocol.byte(writer, 58)
    protocol.number(writer, index_module.lineOf(index, record.*.file, nameStart(index, symbol)) + 1)
}

// A value's type and where that type is declared, as a line; false when
// it is not a value or its type is not known.
pub fn typePlace(writer: *Writer, index: *Index, symbol: u32) -> bool {
    const kind = index_module.symbolAt(index, symbol).*.kind
    if isContainer(kind) || kind == index_module.FUNCTION || kind == index_module.TEST || kind == index_module.FILE || kind == index_module.IMPORT { return false }
    const ty = index_module.typeOfSymbol(index, symbol)
    if ty.symbol == NONE || ty.flags & index_module.TY_FUNCTION != 0 { return false }
    const mark = writer.*.length
    protocol.text(writer, "type ")
    if !typeName(writer, index, ty) {
        writer.*.length = mark
        return false
    }
    const target = index_module.symbolAt(index, ty.symbol)
    if target.*.kind != index_module.FILE {
        protocol.text(writer, ": ")
        protocol.text(writer, index_module.kindName(target.*.kind))
        protocol.text(writer, " in ")
        protocol.text(writer, shortPath(index, target.*.file))
        protocol.byte(writer, 58)
        protocol.number(writer, index_module.lineOf(index, target.*.file, nameStart(index, ty.symbol)) + 1)
    }
    return true
}

pub fn hover(writer: *Writer, index: *Index, file: u32, offset: usize) -> void {
    const symbol = symbolAt(index, file, offset)
    if symbol == NONE {
        protocol.text(writer, "null")
        return
    }
    var markdown: Writer = undefined
    protocol.initWriter(&markdown, writer.*.allocator, 4096)
    describe(&markdown, index, symbol)
    protocol.text(writer, "{\"contents\":{\"kind\":\"markdown\",\"value\":")
    protocol.string(writer, protocol.contents(&markdown))
    protocol.text(writer, "}")
    const ref = index_module.refAtOffset(index, file, offset)
    if ref != index_module.MAX_REFS {
        const value = index_module.refAt(index, ref)
        protocol.text(writer, ",\"range\":")
        range(writer, index, file, @intCast(usize, value.*.start), @intCast(usize, value.*.start + value.*.length))
    }
    protocol.byte(writer, 125)
    markdown.allocator.free(markdown.bytes, markdown.capacity, 16)
}

// ---------------------------------------------------------------------------
// Outlines

// The protocol's SymbolKind of a declaration.
fn symbolKind(index: *Index, symbol: u32) -> usize {
    const record = index_module.symbolAt(index, symbol)
    const kind = record.*.kind
    if kind == index_module.STRUCT || kind == index_module.UNION { return 23 }
    if kind == index_module.ENUM || kind == index_module.ERROR_SET { return 10 }
    if kind == index_module.FIELD { return 8 }
    if kind == index_module.MEMBER { return 22 }
    if kind == index_module.FUNCTION || kind == index_module.TEST {
        if record.*.parent != NONE && isContainer(index_module.symbolAt(index, record.*.parent).*.kind) { return 6 }
        return 12
    }
    if kind == index_module.CONST || kind == index_module.ALIAS { return 14 }
    if kind == index_module.IMPORT { return 2 }
    return 13
}

fn outline(writer: *Writer, index: *Index, container: u32) -> void {
    protocol.byte(writer, 91)
    var first = true
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != NONE {
        const record = index_module.symbolAt(index, child)
        if !isLocal(record.*.kind) && record.*.nameLength > 0 {
            if !first { protocol.byte(writer, 44) }
            first = false
            protocol.text(writer, "{\"name\":")
            protocol.string(writer, index_module.nameOf(index, child))
            protocol.text(writer, ",\"detail\":")
            protocol.string(writer, index_module.kindName(record.*.kind))
            protocol.text(writer, ",\"kind\":")
            protocol.number(writer, symbolKind(index, child))
            protocol.text(writer, ",\"range\":")
            const start = index_module.declarationOffset(index, child)
            var end = index_module.declarationEnd(index, child)
            if end < nameEnd(index, child) { end = nameEnd(index, child) }
            range(writer, index, record.*.file, start, end)
            protocol.text(writer, ",\"selectionRange\":")
            range(writer, index, record.*.file, nameStart(index, child), nameEnd(index, child))
            if isContainer(record.*.kind) {
                protocol.text(writer, ",\"children\":")
                outline(writer, index, child)
            }
            protocol.byte(writer, 125)
        }
        child = record.*.nextSibling
    }
    protocol.byte(writer, 93)
}

pub fn documentSymbols(writer: *Writer, index: *Index, file: u32) -> void {
    outline(writer, index, index_module.fileAt(index, file).*.symbol)
}

fn lower(value: u8) -> u8 { return if value >= 65 && value <= 90 { value + 32 } else { value } }

fn containsFolded(text: []const u8, part: []const u8) -> bool {
    if part.length == 0 { return true }
    if part.length > text.length { return false }
    var start: usize = 0
    while start + part.length <= text.length {
        var same = true
        var at: usize = 0
        while at < part.length && same {
            if lower(text[start + at]) != lower(part[at]) { same = false }
            at += 1
        }
        if same { return true }
        start += 1
    }
    return false
}

pub fn workspaceSymbols(writer: *Writer, index: *Index, query: []const u8) -> void {
    protocol.byte(writer, 91)
    var count: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount && count < 400 {
        const id = @intCast(u32, symbol)
        const record = index_module.symbolAt(index, id)
        const kind = record.*.kind
        const wanted = kind != index_module.FILE && kind != index_module.IMPORT && !isLocal(kind) && record.*.nameLength > 0
        if wanted && containsFolded(index_module.nameOf(index, id), query) {
            if count > 0 { protocol.byte(writer, 44) }
            count += 1
            protocol.text(writer, "{\"name\":")
            protocol.string(writer, index_module.nameOf(index, id))
            protocol.text(writer, ",\"kind\":")
            protocol.number(writer, symbolKind(index, id))
            protocol.text(writer, ",\"location\":")
            declarationLocation(writer, index, id)
            if record.*.parent != NONE {
                const parent = index_module.symbolAt(index, record.*.parent)
                protocol.text(writer, ",\"containerName\":")
                protocol.string(writer, if parent.*.kind == index_module.FILE { shortPath(index, parent.*.file) } else { index_module.nameOf(index, record.*.parent) })
            }
            protocol.byte(writer, 125)
        }
        symbol += 1
    }
    protocol.byte(writer, 93)
}

// ---------------------------------------------------------------------------
// Renaming

fn isIdentifier(name: []const u8) -> bool {
    if name.length == 0 { return false }
    var at: usize = 0
    while at < name.length {
        const value = name[at]
        const letter = (value >= 97 && value <= 122) || (value >= 65 && value <= 90) || value == 95
        const digit = value >= 48 && value <= 57
        if !letter && !(digit && at > 0) { return false }
        at += 1
    }
    return true
}

fn renamable(index: *Index, symbol: u32) -> bool {
    if symbol == NONE { return false }
    return index_module.symbolAt(index, symbol).*.kind != index_module.FILE
}

pub fn prepareRename(writer: *Writer, index: *Index, file: u32, offset: usize) -> void {
    var ref = index_module.refAtOffset(index, file, offset)
    if ref == index_module.MAX_REFS && offset > 0 { ref = index_module.refAtOffset(index, file, offset - 1) }
    if ref == index_module.MAX_REFS || !renamable(index, index_module.refAt(index, ref).*.symbol) {
        protocol.text(writer, "null")
        return
    }
    const value = index_module.refAt(index, ref)
    if value.*.use == index_module.USE_IMPORT {
        protocol.text(writer, "null")
        return
    }
    protocol.text(writer, "{\"range\":")
    range(writer, index, file, @intCast(usize, value.*.start), @intCast(usize, value.*.start + value.*.length))
    protocol.text(writer, ",\"placeholder\":")
    protocol.string(writer, index_module.nameOf(index, value.*.symbol))
    protocol.byte(writer, 125)
}

// Every use and the declaration, file by file. False (nothing written)
// when it cannot be renamed.
pub fn rename(writer: *Writer, index: *Index, file: u32, offset: usize, name: []const u8) -> bool {
    const symbol = symbolAt(index, file, offset)
    if !renamable(index, symbol) || !isIdentifier(name) { return false }
    protocol.text(writer, "{\"changes\":{")
    var first_file = true
    var current: usize = 0
    while current < index.*.fileCount {
        const record = index_module.fileAt(index, @intCast(u32, current))
        var first_edit = true
        var ref = record.*.refStart
        while ref < record.*.refEnd {
            const value = index_module.refAt(index, ref)
            if value.*.symbol == symbol && value.*.use != index_module.USE_IMPORT && value.*.length == index_module.symbolAt(index, symbol).*.nameLength {
                if first_edit {
                    if !first_file { protocol.byte(writer, 44) }
                    first_file = false
                    protocol.uri(writer, index_module.pathOf(index, @intCast(u32, current)))
                    protocol.text(writer, ":[")
                    first_edit = false
                } else {
                    protocol.byte(writer, 44)
                }
                protocol.text(writer, "{\"range\":")
                range(writer, index, @intCast(u32, current), @intCast(usize, value.*.start), @intCast(usize, value.*.start + value.*.length))
                protocol.text(writer, ",\"newText\":")
                protocol.string(writer, name)
                protocol.byte(writer, 125)
            }
            ref += 1
        }
        if !first_edit { protocol.byte(writer, 93) }
        current += 1
    }
    protocol.text(writer, "}}")
    return true
}

// ---------------------------------------------------------------------------
// Completion and signatures

fn isNameByte(value: u8) -> bool { return (value >= 97 && value <= 122) || (value >= 65 && value <= 90) || (value >= 48 && value <= 57) || value == 95 }

// The function or test around `offset` in `file` (its body holds it).
fn enclosingFunction(index: *Index, file: u32, offset: usize) -> u32 {
    var best = NONE
    var best_start: usize = 0
    var symbol: usize = 0
    while symbol < index.*.symbolCount {
        const id = @intCast(u32, symbol)
        const value = index_module.symbolAt(index, id)
        if value.*.file == file && (value.*.kind == index_module.FUNCTION || value.*.kind == index_module.TEST) {
            const start = index_module.declarationOffset(index, id)
            const end = index_module.declarationEnd(index, id)
            if start <= offset && offset <= end && start >= best_start {
                best = id
                best_start = start
            }
        }
        symbol += 1
    }
    return best
}

// A name in scope at `offset`: the function's parameters and locals, the
// file's declarations.
fn lookupScope(index: *Index, file: u32, offset: usize, name: []const u8) -> u32 {
    const function = enclosingFunction(index, file, offset)
    if function != NONE {
        var child = index_module.symbolAt(index, function).*.firstChild
        var found = NONE
        while child != NONE {
            const record = index_module.symbolAt(index, child)
            if isLocal(record.*.kind) && @intCast(usize, record.*.nameStart) < offset && index_module.sameBytes(index_module.nameOf(index, child), name) { found = child }
            child = record.*.nextSibling
        }
        if found != NONE { return found }
        // Self: the struct around the function.
        if index_module.sameBytes(name, "Self") {
            const owner = index_module.symbolAt(index, function).*.parent
            if owner != NONE && isContainer(index_module.symbolAt(index, owner).*.kind) { return owner }
        }
        // A method's struct's members by name (a method body sees them).
        const parent = index_module.symbolAt(index, function).*.parent
        if parent != NONE && isContainer(index_module.symbolAt(index, parent).*.kind) {
            const inner = index_module.member(index, parent, name)
            if inner != NONE { return inner }
        }
    }
    return index_module.member(index, index_module.fileAt(index, file).*.symbol, name)
}

// A chain before the cursor ("a.b.*.c", "x[i].y?"): its parts, back to
// front, as byte ranges of text; how many.
fn chainBefore(text: []const u8, end: usize, starts: [*]usize, ends: [*]usize, most: usize) -> usize {
    var count: usize = 0
    var at = end
    while count < most {
        // One name (or `*`, `?` after a dot, or `[...]` skipped).
        while at > 0 && text[at - 1] == 93 {
            var depth: usize = 0
            while at > 0 {
                at -= 1
                if text[at] == 93 { depth += 1 }
                if text[at] == 91 {
                    depth -= 1
                    if depth == 0 { break }
                }
            }
        }
        var name_end = at
        while at > 0 && isNameByte(text[at - 1]) { at -= 1 }
        if at == name_end {
            if at > 0 && (text[at - 1] == 42 || text[at - 1] == 63) {
                at -= 1
                name_end = at
                // `.*`, `.?`: nothing to look up.
            } else {
                return count
            }
        } else {
            starts[count] = at
            ends[count] = name_end
            count += 1
        }
        if at == 0 || text[at - 1] != 46 { return count }
        at -= 1
    }
    return count
}

// The type the chain before `end` has (its head looked up in scope, then
// member by member); the head's symbol too.
fn chainType(index: *Index, file: u32, text: []const u8, end: usize, offset_in_index: usize) -> index_module.Ty {
    var starts: [16]usize = undefined
    var ends: [16]usize = undefined
    var count: usize = 0
    unsafe { count = chainBefore(text, end, @ptrCast([*]usize, &starts), @ptrCast([*]usize, &ends), 16) }
    var none: index_module.Ty = undefined
    none.symbol = NONE
    none.wraps = 0
    none.depth = 0
    none.flags = 0
    if count == 0 { return none }
    count -= 1
    var symbol = lookupScope(index, file, offset_in_index, text[starts[count]..ends[count]])
    if symbol == NONE { return none }
    var ty = index_module.typeOfSymbol(index, symbol)
    while count > 0 {
        count -= 1
        if ty.flags & index_module.TY_FUNCTION != 0 { ty = index_module.returnType(index, ty.symbol) }
        const inner = index_module.memberOfType(index, ty, text[starts[count]..ends[count]])
        if inner == NONE { return none }
        ty = index_module.typeOfSymbol(index, inner)
    }
    if ty.flags & index_module.TY_FUNCTION != 0 { ty = index_module.returnType(index, ty.symbol) }
    return ty
}

fn completionKind(kind: u8) -> usize {
    if kind == index_module.FUNCTION || kind == index_module.TEST { return 3 }
    if kind == index_module.STRUCT || kind == index_module.UNION { return 22 }
    if kind == index_module.ENUM || kind == index_module.ERROR_SET { return 13 }
    if kind == index_module.FIELD { return 5 }
    if kind == index_module.MEMBER { return 20 }
    if kind == index_module.CONST || kind == index_module.ALIAS { return 21 }
    if kind == index_module.IMPORT || kind == index_module.FILE { return 9 }
    return 6
}

fn completionItem(writer: *Writer, index: *Index, symbol: u32, first: *bool) -> void {
    if !first.* { protocol.byte(writer, 44) }
    first.* = false
    const record = index_module.symbolAt(index, symbol)
    protocol.text(writer, "{\"label\":")
    protocol.string(writer, index_module.nameOf(index, symbol))
    protocol.text(writer, ",\"kind\":")
    protocol.number(writer, completionKind(record.*.kind))
    if record.*.kind != index_module.FILE {
        protocol.text(writer, ",\"detail\":")
        protocol.string(writer, signatureText(index, symbol))
    }
    protocol.byte(writer, 125)
}

fn keywordItem(writer: *Writer, word: []const u8, kind: usize, first: *bool) -> void {
    if !first.* { protocol.byte(writer, 44) }
    first.* = false
    protocol.text(writer, "{\"label\":")
    protocol.string(writer, word)
    protocol.text(writer, ",\"kind\":")
    protocol.number(writer, kind)
    protocol.byte(writer, 125)
}

pub fn keywords() -> []const u8 { return "const var fn pub return if else while for in match break continue defer errdefer unsafe struct enum union error try comptime test true false null undefined inline extern export" }
pub fn builtins() -> []const u8 { return "import intCast ptrCast ptrFromInt intFromPtr bitCast floatCast floatFromInt intFromFloat intFromEnum enumFromInt sizeOf alignOf offsetOf typeOf compileError alignCast atomicLoad atomicStore atomicRmw cmpxchgStrong cmpxchgWeak fence field fieldName hasDecl hasField popCount select splat reduce shuffle tagOf typeInfo move nocopy" }

fn words(writer: *Writer, list: []const u8, kind: usize, first: *bool) -> void {
    var start: usize = 0
    var at: usize = 0
    while at <= list.length {
        if at == list.length || list[at] == 32 {
            if at > start { keywordItem(writer, list[start..at], kind, first) }
            start = at + 1
        }
        at += 1
    }
}

// The completion list at `offset` of `text` (the editor's text of `file`;
// the index may be a little older: `offset_in_index` is about where the
// cursor is in the index's copy).
// What completion offers at `offset` of `text` (the editor's text of
// `file`; the index may be a little older: `offset_in_index` is about where
// the cursor is in the index's copy): the symbols into `out` (at most
// `capacity`; how many), `mode` what goes with them (SCOPE: the keywords,
// and Self in a method; MEMBERS: nothing; BUILTINS: the builtins' names
// only), `name_start` where the name being typed starts.
pub const SCOPE: u8 = 0
pub const MEMBERS: u8 = 1
pub const BUILTINS: u8 = 2

pub fn candidates(index: *Index, file: u32, text: []const u8, offset: usize, offset_in_index: usize, out: [*]u32, capacity: usize, mode: *u8, name_start: *usize, in_method: *bool) -> usize {
    var start = offset
    while start > 0 && isNameByte(text[start - 1]) { start -= 1 }
    name_start.* = start
    in_method.* = false
    var count: usize = 0
    if start > 0 && text[start - 1] == 64 {
        mode.* = BUILTINS
        return 0
    }
    if start > 0 && text[start - 1] == 46 && !(start > 1 && text[start - 2] == 46) {
        // Members of what is before the dot.
        mode.* = MEMBERS
        const ty = chainType(index, file, text, start - 1, offset_in_index)
        const plain = ty.depth == 0 || (ty.depth == 1 && ty.wraps & 7 == index_module.WRAP_POINTER)
        if ty.symbol != NONE && plain {
            var container = ty.symbol
            const record = index_module.symbolAt(index, container)
            if record.*.kind == index_module.IMPORT || record.*.kind == index_module.ALIAS { container = record.*.target }
            if container != NONE {
                const other_file = index_module.symbolAt(index, container).*.kind == index_module.FILE && index_module.symbolAt(index, container).*.file != file
                var child = index_module.symbolAt(index, container).*.firstChild
                while child != NONE && count < capacity {
                    const value = index_module.symbolAt(index, child)
                    const visible = !other_file || value.*.flags & index_module.FLAG_PUB != 0
                    if !isLocal(value.*.kind) && value.*.nameLength > 0 && visible {
                        out[count] = child
                        count += 1
                    }
                    child = value.*.nextSibling
                }
            }
        }
        return count
    }
    // What is in scope: the function's parameters and locals so far, the
    // file's declarations.
    mode.* = SCOPE
    const function = enclosingFunction(index, file, offset_in_index)
    if function != NONE {
        var child = index_module.symbolAt(index, function).*.firstChild
        while child != NONE && count < capacity {
            const value = index_module.symbolAt(index, child)
            if isLocal(value.*.kind) && @intCast(usize, value.*.nameStart) < offset_in_index {
                out[count] = child
                count += 1
            }
            child = value.*.nextSibling
        }
        const parent = index_module.symbolAt(index, function).*.parent
        in_method.* = parent != NONE && isContainer(index_module.symbolAt(index, parent).*.kind)
    }
    var child = index_module.symbolAt(index, index_module.fileAt(index, file).*.symbol).*.firstChild
    while child != NONE && count < capacity {
        const value = index_module.symbolAt(index, child)
        if value.*.nameLength > 0 {
            out[count] = child
            count += 1
        }
        child = value.*.nextSibling
    }
    return count
}

pub fn completion(writer: *Writer, index: *Index, file: u32, text: []const u8, offset: usize, offset_in_index: usize) -> void {
    var found: [4096]u32 = undefined
    var mode: u8 = 0
    var start: usize = 0
    var in_method = false
    var count: usize = 0
    unsafe { count = candidates(index, file, text, offset, offset_in_index, @ptrCast([*]u32, &found), 4096, &mode, &start, &in_method) }
    protocol.text(writer, "{\"isIncomplete\":false,\"items\":[")
    var first = true
    if mode == BUILTINS { words(writer, builtins(), 3, &first) }
    var at: usize = 0
    while at < count {
        completionItem(writer, index, found[at], &first)
        at += 1
    }
    if mode == SCOPE {
        if in_method { keywordItem(writer, "Self", 22, &first) }
        words(writer, keywords(), 14, &first)
    }
    protocol.text(writer, "]}")
}

// The call around `offset`: the callee's signature, its parameters, which
// one the cursor is at.
// The function of the call around `offset` (NONE: none), and which of
// its arguments the cursor is at.
pub fn callAt(index: *Index, file: u32, text: []const u8, offset: usize, offset_in_index: usize, argument: *usize) -> u32 {
    // Back to the unclosed `(`, counting commas at its level.
    var at = offset
    var depth: usize = 0
    var commas: usize = 0
    var found = false
    while at > 0 && !found {
        at -= 1
        const value = text[at]
        if value == 10 && depth == 0 && at + 1 < offset && text[at + 1] == 10 { break }
        if value == 41 || value == 93 || value == 125 {
            depth += 1
        } else if value == 40 || value == 91 || value == 123 {
            if depth == 0 {
                if value == 40 { found = true } else { break }
            } else {
                depth -= 1
            }
        } else if value == 44 && depth == 0 {
            commas += 1
        } else if value == 34 {
            // Back over a string.
            while at > 0 && text[at - 1] != 34 { at -= 1 }
            if at > 0 { at -= 1 }
        }
    }
    if !found { return NONE }
    // The callee: the chain before the `(`; its last part is the function.
    var starts: [16]usize = undefined
    var ends: [16]usize = undefined
    var count: usize = 0
    unsafe { count = chainBefore(text, at, @ptrCast([*]usize, &starts), @ptrCast([*]usize, &ends), 16) }
    if count == 0 { return NONE }
    const name = text[starts[0]..ends[0]]
    var function = NONE
    if count == 1 {
        function = lookupScope(index, file, offset_in_index, name)
    } else {
        const ty = chainType(index, file, text, starts[0] - 1, offset_in_index)
        function = index_module.memberOfType(index, ty, name)
    }
    if function == NONE || index_module.symbolAt(index, function).*.kind != index_module.FUNCTION { return NONE }
    argument.* = commas
    return function
}

pub fn signatureHelp(writer: *Writer, index: *Index, file: u32, text: []const u8, offset: usize, offset_in_index: usize) -> void {
    var commas: usize = 0
    const function = callAt(index, file, text, offset, offset_in_index, &commas)
    if function == NONE {
        protocol.text(writer, "null")
        return
    }
    const label = signatureText(index, function)
    protocol.text(writer, "{\"signatures\":[{\"label\":")
    protocol.string(writer, label)
    var doc: Writer = undefined
    protocol.initWriter(&doc, writer.*.allocator, 1024)
    if docText(&doc, index, function) {
        protocol.text(writer, ",\"documentation\":{\"kind\":\"markdown\",\"value\":")
        protocol.string(writer, protocol.contents(&doc))
        protocol.byte(writer, 125)
    }
    doc.allocator.free(doc.bytes, doc.capacity, 16)
    // Each parameter: where its "name: Type" is in the label (UTF-16).
    protocol.text(writer, ",\"parameters\":[")
    const signature_start = index_module.declarationOffset(index, function)
    var first = true
    var child = index_module.symbolAt(index, function).*.firstChild
    while child != NONE {
        const record = index_module.symbolAt(index, child)
        if record.*.kind == index_module.PARAM {
            const source = sourceOf(index, record.*.file)
            const from = @intCast(usize, record.*.nameStart)
            var to = from
            var level: usize = 0
            while to < source.length && !((source[to] == 44 || source[to] == 41) && level == 0) {
                if source[to] == 40 || source[to] == 91 { level += 1 }
                if (source[to] == 41 || source[to] == 93) && level > 0 { level -= 1 }
                to += 1
            }
            if from >= signature_start && to <= signature_start + label.length {
                if !first { protocol.byte(writer, 44) }
                first = false
                protocol.text(writer, "{\"label\":[")
                protocol.number(writer, protocol.utf16Units(source, signature_start, from))
                protocol.byte(writer, 44)
                protocol.number(writer, protocol.utf16Units(source, signature_start, to))
                protocol.text(writer, "]}")
            }
        }
        child = record.*.nextSibling
    }
    protocol.text(writer, "]}],\"activeSignature\":0,\"activeParameter\":")
    protocol.number(writer, commas)
    protocol.byte(writer, 125)
}

// ---------------------------------------------------------------------------
// Semantic tokens

// The legend's token types (mlx-lsp's initialize lists them in order).
const TYPE_NAMESPACE: usize = 0
const TYPE_TYPE: usize = 1
const TYPE_PARAMETER: usize = 7
const TYPE_VARIABLE: usize = 8
const TYPE_PROPERTY: usize = 9
const TYPE_ENUM_MEMBER: usize = 10
const TYPE_FUNCTION: usize = 12
const TYPE_METHOD: usize = 13
const TYPE_KEYWORD: usize = 15
const TYPE_STRING: usize = 18
const TYPE_NUMBER: usize = 19
const TYPE_OPERATOR: usize = 21
const NO_TYPE: usize = 99

const MODIFIER_DECLARATION: usize = 1
const MODIFIER_READONLY: usize = 4

fn typeOfKind(index: *Index, symbol: u32) -> usize {
    const record = index_module.symbolAt(index, symbol)
    const kind = record.*.kind
    if kind == index_module.FUNCTION || kind == index_module.TEST {
        if record.*.parent != NONE && isContainer(index_module.symbolAt(index, record.*.parent).*.kind) { return TYPE_METHOD }
        return TYPE_FUNCTION
    }
    if isContainer(kind) || kind == index_module.ALIAS { return TYPE_TYPE }
    if kind == index_module.FIELD { return TYPE_PROPERTY }
    if kind == index_module.MEMBER { return TYPE_ENUM_MEMBER }
    if kind == index_module.PARAM { return TYPE_PARAMETER }
    if kind == index_module.IMPORT || kind == index_module.FILE { return TYPE_NAMESPACE }
    return TYPE_VARIABLE
}

pub fn semanticTokens(writer: *Writer, index: *Index, file: u32) -> void {
    const record = index_module.fileAt(index, file)
    const source = sourceOf(index, file)
    protocol.text(writer, "{\"data\":[")
    var first = true
    var previous_line: usize = 0
    var previous_start: usize = 0
    var ref = record.*.refStart
    var line: usize = 0
    var line_start: usize = 0
    var scanned: usize = 0
    var after_at = false
    var token: usize = 0
    const count = record.*.tokens.length
    while token < count {
        const value = index_module.tokenAt(index, file, token)
        const kind = @intFromEnum(value.kind)
        var type_index = NO_TYPE
        var modifiers: usize = 0
        if value.kind == Kind.identifier {
            if after_at {
                type_index = TYPE_FUNCTION
            } else {
                while ref < record.*.refEnd && @intCast(usize, index_module.refAt(index, ref).*.start) < value.start { ref += 1 }
                if ref < record.*.refEnd && @intCast(usize, index_module.refAt(index, ref).*.start) == value.start {
                    const use = index_module.refAt(index, ref)
                    type_index = typeOfKind(index, use.*.symbol)
                    if use.*.use == index_module.USE_DECLARATION { modifiers = modifiers | MODIFIER_DECLARATION }
                    const symbol_kind = index_module.symbolAt(index, use.*.symbol).*.kind
                    if symbol_kind == index_module.CONST || symbol_kind == index_module.LOCAL_CONST { modifiers = modifiers | MODIFIER_READONLY }
                } else {
                    type_index = TYPE_VARIABLE
                }
            }
        } else if kind >= @intFromEnum(Kind.keyword_pub) && kind <= @intFromEnum(Kind.keyword_type) {
            type_index = TYPE_KEYWORD
        } else if value.kind == Kind.string || value.kind == Kind.byte_string || value.kind == Kind.character {
            type_index = TYPE_STRING
        } else if value.kind == Kind.integer || value.kind == Kind.float {
            type_index = TYPE_NUMBER
        } else if value.kind == Kind.at {
            type_index = TYPE_FUNCTION
        } else if kind >= @intFromEnum(Kind.bang) {
            type_index = TYPE_OPERATOR
        }
        after_at = value.kind == Kind.at
        if type_index != NO_TYPE && value.length > 0 {
            // The line it is on (tokens come in order).
            while scanned < value.start && scanned < source.length {
                if source[scanned] == 10 {
                    line += 1
                    line_start = scanned + 1
                }
                scanned += 1
            }
            // Not across lines (a multi-line string).
            var single = true
            var at = value.start
            while at < value.start + value.length && at < source.length {
                if source[at] == 10 { single = false }
                at += 1
            }
            if single {
                const column = protocol.utf16Units(source, line_start, value.start)
                const width = protocol.utf16Units(source, value.start, value.start + value.length)
                if !first { protocol.byte(writer, 44) }
                first = false
                protocol.number(writer, line - previous_line)
                protocol.byte(writer, 44)
                protocol.number(writer, if line == previous_line { column - previous_start } else { column })
                protocol.byte(writer, 44)
                protocol.number(writer, width)
                protocol.byte(writer, 44)
                protocol.number(writer, type_index)
                protocol.byte(writer, 44)
                protocol.number(writer, modifiers)
                previous_line = line
                previous_start = column
            }
        }
        token += 1
    }
    protocol.text(writer, "]}")
}

// ---------------------------------------------------------------------------
// Names nothing declares

fn isPrimitive(name: []const u8) -> bool {
    const list = "u8 u16 u32 u64 u128 usize i8 i16 i32 i64 i128 isize f16 f32 f64 f128 bool void anyopaque noreturn type anyerror anytype comptime_int comptime_float Self _"
    var start: usize = 0
    var at: usize = 0
    while at <= list.length {
        if at == list.length || list[at] == 32 {
            if index_module.sameBytes(list[start..at], name) { return true }
            start = at + 1
        }
        at += 1
    }
    return false
}

// The names on line `line` (0-based) of `file` that nothing declares
// (not after a dot or @, no use found for them), as "`a`, `b`"; whether
// there were any.
pub fn undeclaredOnLine(writer: *Writer, index: *Index, file: u32, line: usize) -> bool {
    const record = index_module.fileAt(index, file)
    if line >= record.*.lineCount { return false }
    const line_start = @intCast(usize, record.*.lineStarts[line])
    const line_end = if line + 1 < record.*.lineCount { @intCast(usize, record.*.lineStarts[line + 1]) } else { record.*.sourceLength }
    var found: usize = 0
    var previous = Kind.statement_end
    var token: usize = 0
    var ref = record.*.refStart
    while token < record.*.tokens.length {
        const value = index_module.tokenAt(index, file, token)
        if value.start >= line_end { break }
        if value.start >= line_start && value.kind == Kind.identifier && previous != Kind.dot && previous != Kind.at {
            while ref < record.*.refEnd && @intCast(usize, index_module.refAt(index, ref).*.start) < value.start { ref += 1 }
            const used = ref < record.*.refEnd && @intCast(usize, index_module.refAt(index, ref).*.start) == value.start
            const name = sourceOf(index, file)[value.start..value.start + value.length]
            if !used && !isPrimitive(name) && found < 3 {
                if found > 0 { protocol.text(writer, ", ") }
                protocol.byte(writer, 96)
                protocol.text(writer, name)
                protocol.byte(writer, 96)
                found += 1
            }
        }
        previous = value.kind
        token += 1
    }
    return found > 0
}
