// What MLX Codemap knows, in the editor: the crashes the desktop programs
// kept, the workarounds of missing features, how complex a function is,
// which programs reach it and whether a check does
// (tools/codemap: crashes, workarounds, complexity, programs).
//
//   - hover: a section after the doc comment;
//   - code lens above each function: its uses and what is notable;
//   - diagnostics: a warning on the line a crash stopped on, a hint on
//     every workaround.
//
// Worked out again after the index is read again, when first asked for;
// the workarounds for one file at a time (all of them take a while).
const std = @import("std")
const index_module = @import("../codemap/index.mlx")
const crashes_module = @import("../codemap/crashes.mlx")
const workarounds_module = @import("../codemap/workarounds.mlx")
const complexity_module = @import("../codemap/complexity.mlx")
const programs_module = @import("../codemap/programs.mlx")
const aggregates = @import("../codemap/aggregates.mlx")
const protocol = @import("./protocol.mlx")
const features = @import("./features.mlx")

const Index = index_module.Index
const Writer = protocol.Writer
const NONE = index_module.NONE

pub const Insights = struct {
    allocator: std.allocator.Allocator
    environment: [*][*]const u8
    // The compiler's arena of temporaries, taken back after each working
    // out.
    arena: usize
    index: *Index
    // The index they were worked out for (its builds counted by the
    // server), and the file the workarounds are of.
    built: usize
    ready: bool
    workaroundFile: u32
    crashes: crashes_module.Crashes
    workarounds: workarounds_module.Workarounds
    complexity: complexity_module.Complexity
    programs: programs_module.Programs
}

fn crashesOf(insights: *Insights) -> *crashes_module.Crashes {
    unsafe { return @ptrCast(*crashes_module.Crashes, &insights.*.crashes) }
}

fn workaroundsOf(insights: *Insights) -> *workarounds_module.Workarounds {
    unsafe { return @ptrCast(*workarounds_module.Workarounds, &insights.*.workarounds) }
}

fn complexityOf(insights: *Insights) -> *complexity_module.Complexity {
    unsafe { return @ptrCast(*complexity_module.Complexity, &insights.*.complexity) }
}

fn programsOf(insights: *Insights) -> *programs_module.Programs {
    unsafe { return @ptrCast(*programs_module.Programs, &insights.*.programs) }
}

pub fn init(insights: *Insights, allocator: std.allocator.Allocator, environment: [*][*]const u8, arena: usize) -> void {
    insights.*.allocator = allocator
    insights.*.arena = arena
    insights.*.environment = environment
    insights.*.built = 0
    insights.*.ready = false
    insights.*.workaroundFile = NONE
    crashes_module.init(crashesOf(insights), allocator)
    workarounds_module.init(workaroundsOf(insights), allocator)
    complexity_module.init(complexityOf(insights), allocator)
    programs_module.init(programsOf(insights), allocator)
}

// Up to date for the index of build `built`, with the workarounds of
// `file`.
pub fn ensure(insights: *Insights, index: *Index, built: usize, file: u32) -> void {
    const where = aggregates.mark(insights.*.arena)
    work(insights, index, built, file)
    aggregates.reset(insights.*.arena, where)
}

fn work(insights: *Insights, index: *Index, built: usize, file: u32) -> void {
    if !insights.*.ready || insights.*.built != built {
        insights.*.index = index
        insights.*.built = built
        insights.*.ready = true
        insights.*.workaroundFile = NONE
        var path: [4096]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &path) }
        if crashes_module.logPath(insights.*.environment, bytes) == 0 { bytes[0] = 0 }
        crashes_module.load(crashesOf(insights), index, bytes)
        complexity_module.run(complexityOf(insights), index)
        programs_module.run(programsOf(insights), index)
    }
    if file != NONE && insights.*.workaroundFile != file {
        workarounds_module.runFile(workaroundsOf(insights), index, file)
        insights.*.workaroundFile = file
    }
}

fn say(writer: *Writer, text: []const u8) -> void { protocol.text(writer, text) }

// The hover's section of `symbol` (markdown; nothing when there is nothing
// to say).
pub fn hover(insights: *Insights, writer: *Writer, symbol: u32) -> void {
    const index = insights.*.index
    const value = index_module.symbolAt(index, symbol)
    if value.*.kind != index_module.FUNCTION { return }
    protocol.text(writer, "\n\n---\n")
    // Crashes.
    const crashes = crashesOf(insights)
    const latest = crashes_module.latestOf(crashes, symbol)
    if latest != NONE {
        say(writer, "**Crashed** ")
        const stopped = crashes_module.stoppedIn(crashes, symbol)
        const through = crashes_module.wentThrough(crashes, symbol)
        if stopped > 0 {
            say(writer, "here ")
            protocol.number(writer, @intCast(usize, stopped))
            say(writer, "x")
            if through > 0 { say(writer, ", ") }
        }
        if through > 0 {
            say(writer, "on the way ")
            protocol.number(writer, @intCast(usize, through))
            say(writer, "x")
        }
        say(writer, ". Last: ")
        say(writer, crashes_module.field(crashes, latest, 2))
        say(writer, ", ")
        say(writer, crashes_module.field(crashes, latest, 3))
        say(writer, "\n\n")
    }
    // Workarounds.
    const workarounds = workaroundsOf(insights)
    const marks = workarounds_module.marksOf(workarounds, symbol)
    var pattern: usize = 0
    while pattern < workarounds_module.PATTERNS {
        if marks & (@intCast(u16, 1) << @intCast(u16, pattern)) != 0 {
            say(writer, "**Workaround:** ")
            say(writer, workarounds_module.title(@intCast(u8, pattern), false))
            say(writer, ". ")
            say(writer, workarounds_module.missing(@intCast(u8, pattern), false))
            say(writer, "\n\n")
        }
        pattern += 1
    }
    // Complexity.
    const complexity = complexityOf(insights)
    const branches = complexity_module.branchesOf(complexity, symbol)
    if branches > 0 {
        say(writer, if complexity_module.isComplex(complexity, symbol) { "**Complex:** " } else { "Complexity: " })
        protocol.number(writer, @intCast(usize, branches))
        say(writer, " branches, ")
        protocol.number(writer, @intCast(usize, complexity_module.depthOf(complexity, symbol)))
        say(writer, " deep, ")
        protocol.number(writer, @intCast(usize, complexity_module.tokensOf(complexity, symbol)))
        say(writer, " tokens\n\n")
    }
    // Programs and checks.
    const programs = programsOf(insights)
    if programs_module.isUnreachable(programs, symbol) {
        say(writer, "**Unreachable:** no program and no check reaches it.\n")
        return
    }
    var reached: usize = 0
    var program: usize = 0
    while program < programs.*.count {
        if programs_module.reaches(programs, program, symbol) {
            if reached == 0 { say(writer, "Reached by ") } else if reached < 5 { say(writer, ", ") }
            if reached < 5 { say(writer, programs_module.nameOf(programs, program)) }
            reached += 1
        }
        program += 1
    }
    if reached > 5 {
        say(writer, " and ")
        protocol.number(writer, reached - 5)
        say(writer, " more")
    }
    if reached > 0 { say(writer, if programs_module.checked(programs, symbol) { "; checked.\n" } else { "; **no check reaches it.**\n" }) } else if programs_module.checked(programs, symbol) { say(writer, "Reached by checks only.\n") }
}

// The code lens of `file`: above each function its uses, and what is
// notable (crashes, workarounds, complexity, unreachable, unchecked).
pub fn codeLens(insights: *Insights, writer: *Writer, file: u32) -> void {
    const index = insights.*.index
    protocol.byte(writer, 91)
    var first = true
    lensIn(insights, writer, index_module.fileAt(index, file).*.symbol, file, &first, 0)
    protocol.byte(writer, 93)
}

fn lensIn(insights: *Insights, writer: *Writer, container: u32, file: u32, first: *bool, depth: usize) -> void {
    const index = insights.*.index
    if container == NONE || depth > 3 { return }
    var child = index_module.symbolAt(index, container).*.firstChild
    while child != NONE {
        const value = index_module.symbolAt(index, child)
        if value.*.kind == index_module.FUNCTION {
            var title: Writer = undefined
            protocol.initWriter(&title, writer.*.allocator, 256)
            lensTitle(insights, &title, child)
            if !first.* { protocol.byte(writer, 44) }
            first.* = false
            protocol.text(writer, "{\"range\":")
            const start = @intCast(usize, value.*.nameStart)
            features.range(writer, index, file, start, start + @intCast(usize, value.*.nameLength))
            protocol.text(writer, ",\"command\":{\"title\":")
            protocol.string(writer, protocol.contents(&title))
            protocol.text(writer, ",\"command\":\"\"}}")
            title.allocator.free(title.bytes, title.capacity, 16)
        } else if value.*.kind == index_module.STRUCT || value.*.kind == index_module.ENUM || value.*.kind == index_module.UNION || value.*.kind == index_module.CONST {
            lensIn(insights, writer, child, file, first, depth + 1)
        }
        child = value.*.nextSibling
    }
}

fn lensTitle(insights: *Insights, writer: *Writer, symbol: u32) -> void {
    const index = insights.*.index
    const uses = @intCast(usize, workarounds_module.usesOf(workaroundsOf(insights), symbol))
    protocol.number(writer, uses)
    say(writer, if uses == 1 { " use" } else { " uses" })
    const crashes = crashesOf(insights)
    const stopped = crashes_module.stoppedIn(crashes, symbol)
    const through = crashes_module.wentThrough(crashes, symbol)
    if stopped + through > 0 {
        say(writer, " · ")
        protocol.number(writer, @intCast(usize, stopped + through))
        say(writer, if stopped + through == 1 { " crash" } else { " crashes" })
    }
    const places = workarounds_module.placesOf(workaroundsOf(insights), symbol)
    if places > 0 {
        say(writer, " · ")
        protocol.number(writer, @intCast(usize, places))
        say(writer, if places == 1 { " workaround" } else { " workarounds" })
    }
    const complexity = complexityOf(insights)
    if complexity_module.isComplex(complexity, symbol) {
        say(writer, " · complex (")
        protocol.number(writer, @intCast(usize, complexity_module.branchesOf(complexity, symbol)))
        say(writer, " branches)")
    }
    const programs = programsOf(insights)
    if programs_module.isUnreachable(programs, symbol) { say(writer, " · unreachable") } else if programs_module.isUntested(programs, symbol) { say(writer, " · no check") }
}

// Diagnostics of `file` (appended after `first`: whether none came
// before): a warning on each line a crash stopped on, a hint on each
// workaround.
pub fn diagnostics(insights: *Insights, writer: *Writer, file: u32, first: *bool) -> void {
    const index = insights.*.index
    const path = programs_module.relativePath(index, file)
    const crashes = crashesOf(insights)
    var frame: usize = 0
    while frame < crashes.*.frameCount {
        const text = crashes_module.frameText(crashes, frame)
        const where = crashes_module.frameWhere(text)
        var colon = where.length
        while colon > 0 && where[colon - 1] != 58 { colon -= 1 }
        if colon > 1 && index_module.sameBytes(where[0..colon - 1], path) {
            var line: usize = 0
            for byte in where[colon..where.length] {
                if byte >= 48 && byte <= 57 { line = line * 10 + @intCast(usize, byte - 48) }
            }
            if line > 0 {
                const start = index_module.offsetOf(index, file, line - 1, 0)
                const source = index_module.sourceOf(index, file)
                var begin = start
                while begin < source.length && (source[begin] == 32 || source[begin] == 9) { begin += 1 }
                var end = begin
                while end < source.length && source[end] != 10 { end += 1 }
                if !first.* { protocol.byte(writer, 44) }
                first.* = false
                protocol.text(writer, "{\"range\":")
                features.range(writer, index, file, begin, end)
                protocol.text(writer, ",\"severity\":2,\"source\":\"mlx-codemap\",\"message\":")
                var message: Writer = undefined
                protocol.initWriter(&message, writer.*.allocator, 256)
                const record = crashes.*.frameRecord[frame]
                say(&message, if crashes.*.frameDepth[frame] == 0 { "Crashed here: " } else { "A crash went through this call: " })
                say(&message, crashes_module.field(crashes, record, 2))
                say(&message, ", ")
                say(&message, crashes_module.field(crashes, record, 3))
                protocol.string(writer, protocol.contents(&message))
                message.allocator.free(message.bytes, message.capacity, 16)
                protocol.byte(writer, 125)
            }
        }
        frame += 1
    }
    const workarounds = workaroundsOf(insights)
    var place: usize = 0
    while place < workarounds.*.count {
        if workarounds.*.file[place] == file {
            const start = @intCast(usize, workarounds.*.offset[place])
            const source = index_module.sourceOf(index, file)
            var end = start
            while end < source.length && source[end] != 10 && end < start + 80 { end += 1 }
            const pattern = workarounds.*.pattern[place]
            if !first.* { protocol.byte(writer, 44) }
            first.* = false
            protocol.text(writer, "{\"range\":")
            features.range(writer, index, file, start, end)
            protocol.text(writer, ",\"severity\":4,\"source\":\"mlx-codemap\",\"message\":")
            var message: Writer = undefined
            protocol.initWriter(&message, writer.*.allocator, 256)
            say(&message, "Workaround: ")
            say(&message, workarounds_module.title(pattern, false))
            say(&message, ". ")
            say(&message, workarounds_module.missing(pattern, false))
            protocol.string(writer, protocol.contents(&message))
            message.allocator.free(message.bytes, message.capacity, 16)
            protocol.byte(writer, 125)
        }
        place += 1
    }
}
