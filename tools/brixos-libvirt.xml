<!--
  brixOS in libvirt / virt-manager, booting the Multiboot kernel image
  directly (no bootloader) with a window you can watch (VNC, shown inside virt-manager) and a serial
  console.

  1. Build the image:   ./mlx build brix
  2. Make a disk once:  truncate -s 64M mlx-out/bin/brix/disk.img
  3. Edit the two absolute paths below (REPLACE /PATH/TO/mlx-lang with the
     real checkout path, e.g. /home/you/antigravity/mlx-lang).
  4. Define and start it on your own (user) session, which can read files in
     your home — no root needed:

        virsh -c qemu:///session define tools/brixos-libvirt.xml
        virt-manager            # open "brixos", click the screen icon
        # or headless:  virsh -c qemu:///session start brixos

  This is the i440fx + virtio machine that works today (same as the QEMU
  command line). For the real-hardware path later, change machine to 'q35'
  and the disk bus to 'sata' once the AHCI driver lands.

  The account is brix, password "brix". Click into the console for keyboard
  and mouse; the compositor reads the PS/2 devices. A rebuilt brix.img is
  picked up on the next start (the kernel file is read each boot).
-->
<domain type='kvm'>
  <name>brixos</name>
  <memory unit='MiB'>1024</memory>
  <vcpu>2</vcpu>
  <os>
    <type arch='x86_64' machine='pc'>hvm</type>
    <kernel>/PATH/TO/mlx-lang/mlx-out/bin/brix/brix.img</kernel>
  </os>
  <cpu mode='host-passthrough'/>
  <features>
    <acpi/>
    <apic/>
  </features>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>destroy</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw'/>
      <source file='/PATH/TO/mlx-lang/mlx-out/bin/brix/disk.img'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <interface type='user'>
      <model type='virtio'/>
    </interface>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>
    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <video>
      <model type='vga' vram='16384'/>
    </video>
    <serial type='pty'>
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
