// Prints local time as desktop-shared/clock.mlx computes it, for the
// desktop's checks (tools/check_desktop_clients.sh compares it with
// python's zoneinfo): for each argument, seconds since 1970, a line
// "YEAR-MM-DD HH:MM:SS OFFSET" in the zone of $TZ or /etc/localtime.
//
//   TZ=Europe/Berlin clock-probe 1711846800 1727445900
const std = @import("std")
const clock = @import("../../projects/desktop/shared/clock.mlx")

fn say(text: []const u8) -> void {
    const written = std.io.writeAll(std.io.stdout(), text)
}

fn sayNumber(value: i64, width: usize) -> void {
    var number: [24]u8 = undefined
    var count: usize = 0
    var rest = if value < 0 { -value } else { value }
    while rest > 0 || count < width {
        number[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    if value < 0 { say("-") }
    while count > 0 {
        count -= 1
        say(number[count..count + 1])
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    const allocator = std.page_allocator.init()
    const environment = std.process.environmentEntries(arguments)
    const memory = allocator.alloc(@sizeOf(clock.Zone), 16)
    if memory == null { return }
    var zone: *clock.Zone = undefined
    unsafe { zone = @ptrCast(*clock.Zone, memory.?) }
    clock.load(zone, environment, allocator)
    var index: usize = 1
    while index < arguments.length {
        const text = arguments[index]
        var value: i64 = 0
        var at: usize = 0
        var negative = false
        if text[0] == 45 {
            negative = true
            at = 1
        }
        while text[at] != 0 {
            value = value * 10 + @intCast(i64, text[at] - 48)
            at += 1
        }
        if negative { value = -value }
        const offset = clock.offsetAt(zone, value)
        const time = clock.civil(value + offset)
        sayNumber(time.year, 4)
        say("-")
        sayNumber(time.month, 2)
        say("-")
        sayNumber(time.day, 2)
        say(" ")
        sayNumber(time.hour, 2)
        say(":")
        sayNumber(time.minute, 2)
        say(":")
        sayNumber(time.second, 2)
        say(" ")
        sayNumber(offset, 1)
        say("\n")
        index += 1
    }
}
