// Exercises the exact login1 client used by the compositor against the
// private mlx-login instance in check_login.sh. Keeping one connection
// open matters: TakeControl binds all later device operations to it.
const std = @import("std")
const logind = @import("../../projects/desktop/compositor/logind.mlx")
const device = @import("../../projects/desktop/compositor/device.mlx")

const Failure = error { Open, Device, Switch, Signals }

fn fail(failure: Failure) -> Failure!void { return failure }

pub fn main(arguments: [][*]const u8) -> !void {
    var session: logind.Session = undefined
    if !logind.open(&session, std.page_allocator.init(), std.process.environmentEntries(arguments)) { try fail(Failure.Open) }
    if std.process.count(arguments) > 1 && std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("abandon")) {
        const said = std.io.writeAll(std.io.stdout(), "controller abandoned\n")
        const exited = std.linux.syscall1(231, 0)
        return
    }
    var inactive = true
    const descriptor = logind.takeDevice(&session, 1, 3, &inactive)
    if descriptor < 0 || inactive {
        logind.close(&session)
        try fail(Failure.Device)
    }
    device.close(descriptor)
    if !logind.switchTo(&session, 2) {
        logind.close(&session)
        try fail(Failure.Switch)
    }
    var event: logind.Event = undefined
    var alive = true
    if !logind.nextEvent(&session, &event, &alive) || event.kind != logind.PAUSE || event.major != 1 || event.minor != 3 {
        logind.close(&session)
        try fail(Failure.Signals)
    }
    logind.pauseComplete(&session, 1, 3)
    if !logind.switchTo(&session, 1) {
        logind.close(&session)
        try fail(Failure.Switch)
    }
    if !logind.nextEvent(&session, &event, &alive) || event.kind != logind.RESUME || event.major != 1 || event.minor != 3 || event.descriptor < 0 {
        logind.close(&session)
        try fail(Failure.Signals)
    }
    device.close(event.descriptor)
    logind.releaseDevice(&session, 1, 3)
    logind.close(&session)
    const said = std.io.writeAll(std.io.stdout(), "login1 client passed\n")
}
