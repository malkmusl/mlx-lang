// Focused executable used by check_init_devices.sh. It exercises the same
// device module mlx-init uses without touching the host's /dev tree.
const std = @import("std")
const devices = @import("../../projects/init/devices.mlx")
const linux = @import("../../projects/init/linux.mlx")

fn arg(arguments: [][*]const u8, index: usize) -> []const u8 {
    return std.string.asSlice(std.process.argument(arguments, index))
}

fn usage() -> u8 {
    const said = std.io.eprintln("usage: init-devices-test coldplug SYS DEV GROUPS | event DEV GROUPS FILE | ignored DEV GROUPS FILE | socket")
    return 2
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const count = std.process.count(arguments)
    if count == 2 && std.text.same(arg(arguments, 1), "socket") {
        var manager: devices.Manager = undefined
        devices.initialize(&manager, "/dev", "/etc/group")
        if !devices.openEvents(&manager) { return 1 }
        devices.close(&manager)
        return 0
    }
    if count != 5 { return usage() }
    var manager: devices.Manager = undefined
    const command = arg(arguments, 1)
    if std.text.same(command, "coldplug") {
        devices.initialize(&manager, arg(arguments, 3), arg(arguments, 4))
        const changed = devices.coldplug(&manager, arg(arguments, 2))
        return if changed > 0 { 0 } else { 1 }
    }
    if !std.text.same(command, "event") && !std.text.same(command, "ignored") { return usage() }
    devices.initialize(&manager, arg(arguments, 2), arg(arguments, 3))
    var storage: [16384]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &storage) }
    const file = linux.open(arg(arguments, 4), linux.O_RDONLY | linux.O_CLOEXEC, 0)
    if file < 0 { return 1 }
    const amount = linux.read(file, bytes, 16384)
    linux.close(file)
    if amount <= 0 { return 1 }
    const applied = devices.applyEvent(&manager, bytes[0..@bitCast(usize, amount)])
    return if (std.text.same(command, "event") && applied) || (std.text.same(command, "ignored") && !applied) { 0 } else { 1 }
}
