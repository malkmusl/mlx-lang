// An X program for the desktop's checks, on std.x11 and the display in
// $DISPLAY: it owns CLIPBOARD with a text, or reads CLIPBOARD.
//
//   x11-clipboard-test own TEXT      owns CLIPBOARD (UTF8_STRING and STRING)
//                                    until another program takes it
//   x11-clipboard-test read TARGET   prints CLIPBOARD converted to TARGET (an
//                                    atom's name: UTF8_STRING, text/uri-list)
//   x11-clipboard-test targets       prints the names of CLIPBOARD's TARGETS
//
// It ends after 20 seconds whatever happens; "x11-clipboard-test: ..."
// lines on stderr say what it did.
const std = @import("std")
const x11 = @import("std.x11")

const SYS_poll: usize = 7
const SYS_exit_group: usize = 231

const MODE_OWN: u8 = 0
const MODE_READ: u8 = 1
const MODE_TARGETS: u8 = 2

// CLIPBOARD, TARGETS, UTF8_STRING, the property conversions go to, and
// the target asked for.
const ATOMS: usize = 5

const Run = struct {
    connection: x11.Connection
    mode: u8
    text: []const u8
    target: []const u8
    window: u32
    atoms: [5]u32
    atomSequence: u32
    atomsLeft: usize
    propertySequence: u32
    // Where the next part of the property starts (32-bit units).
    offset: u32
    names: usize
    nameSequences: [32]u32
    done: bool
    status: u8
}

fn say(text: []const u8) -> void { _ = std.io.writeAll(std.io.stderr(), text) }

fn finish(run: *Run, status: u8, text: []const u8) -> void {
    say("x11-clipboard-test: ")
    say(text)
    say("\n")
    run.*.done = true
    run.*.status = status
}

fn atomsIn(run: *Run) -> void {
    const connection = &run.*.connection
    run.*.window = x11.generateId(connection)
    x11.createInputWindow(connection, run.*.window, connection.*.root)
    if run.*.mode == MODE_OWN {
        x11.setSelectionOwnerAt(connection, run.*.window, run.*.atoms[0], x11.CURRENT_TIME)
        say("x11-clipboard-test: owner\n")
        return
    }
    const target = if run.*.mode == MODE_TARGETS { run.*.atoms[1] } else { run.*.atoms[4] }
    x11.convertSelection(connection, run.*.window, run.*.atoms[0], target, run.*.atoms[3], x11.CURRENT_TIME)
}

// Another program converts our CLIPBOARD.
fn requested(run: *Run, event: [*]const u8) -> void {
    const connection = &run.*.connection
    const time = x11.get32(event, 4)
    const requestor = x11.get32(event, 12)
    const selection = x11.get32(event, 16)
    const target = x11.get32(event, 20)
    const property = x11.get32(event, 24)
    if target == run.*.atoms[1] {
        var list: [3]u32 = [3]u32{ run.*.atoms[1], run.*.atoms[2], x11.ATOM_STRING }
        unsafe { x11.changeProperty(connection, requestor, property, x11.ATOM_ATOM, 32, @ptrCast([*]const u8, &list), 3) }
        x11.sendSelectionNotify(connection, requestor, selection, target, property, time)
    } else if target == run.*.atoms[2] || target == x11.ATOM_STRING {
        x11.changePropertyBytes(connection, requestor, property, target, run.*.text, false)
        x11.sendSelectionNotify(connection, requestor, selection, target, property, time)
        say("x11-clipboard-test: served\n")
    } else {
        x11.sendSelectionNotify(connection, requestor, selection, target, x11.NONE, time)
    }
}

fn handle(run: *Run, message: *x11.Message) -> void {
    const connection = &run.*.connection
    const data = message.*.data
    if message.*.kind == x11.KIND_SETUP {
        if connection.*.failed {
            finish(run, 1, "the display refused the connection")
            return
        }
        const names = [5][]const u8{ "CLIPBOARD", "TARGETS", "UTF8_STRING", "_X11_CLIPBOARD_TEST", run.*.target }
        var index: usize = 0
        while index < ATOMS {
            const sequence = x11.internAtom(connection, names[index])
            if index == 0 { run.*.atomSequence = sequence }
            index += 1
        }
        run.*.atomsLeft = ATOMS
        return
    }
    if message.*.kind == x11.KIND_REPLY {
        const sequence = @intCast(u32, message.*.sequence)
        if run.*.atomsLeft > 0 {
            const index = @intCast(usize, (sequence -% run.*.atomSequence) & 65535)
            if index < ATOMS {
                run.*.atoms[index] = x11.atomOf(data)
                run.*.atomsLeft -= 1
                if run.*.atomsLeft == 0 { atomsIn(run) }
            }
            return
        }
        if sequence == run.*.propertySequence {
            const bytes = x11.propertyBytes(data)
            if run.*.mode == MODE_READ {
                _ = std.io.writeAll(std.io.stdout(), x11.propertyValue(data)[0..bytes])
                // In parts: the next one after this, until none is left.
                if x11.propertyAfter(data) > 0 {
                    run.*.offset += @intCast(u32, bytes / 4)
                    run.*.propertySequence = x11.getPropertyPart(connection, run.*.window, run.*.atoms[3], x11.ATOM_ANY, run.*.offset, 15000, true)
                    return
                }
                finish(run, 0, "read")
                return
            }
            // TARGETS: each one's name.
            const value = x11.propertyValue(data)
            var index: usize = 0
            while index < bytes / 4 && index < 32 {
                run.*.nameSequences[index] = x11.getAtomName(connection, x11.get32(value, index * 4))
                index += 1
            }
            run.*.names = index
            if index == 0 { finish(run, 0, "no targets") }
            return
        }
        var index: usize = 0
        while index < run.*.names {
            if run.*.nameSequences[index] == sequence {
                _ = std.io.writeAll(std.io.stdout(), x11.atomName(data))
                _ = std.io.writeAll(std.io.stdout(), "\n")
                if index + 1 == run.*.names { finish(run, 0, "targets") }
            }
            index += 1
        }
        return
    }
    if message.*.kind == x11.KIND_ERROR { return }
    if message.*.kind == x11.SELECTION_REQUEST {
        requested(run, data)
    } else if message.*.kind == x11.SELECTION_CLEAR {
        finish(run, 0, "another program took CLIPBOARD")
    } else if message.*.kind == x11.SELECTION_NOTIFY {
        const property = x11.get32(data, 20)
        if property == x11.NONE {
            finish(run, 1, "the conversion was refused")
            return
        }
        run.*.propertySequence = x11.getPropertyPart(connection, run.*.window, property, x11.ATOM_ANY, 0, 15000, true)
    }
}

pub fn main(arguments: [][*]const u8) -> !void {
    var run: Run = undefined
    run.done = false
    run.status = 1
    run.names = 0
    run.atomsLeft = 0
    run.propertySequence = 65536
    run.offset = 0
    run.target = "UTF8_STRING"
    run.text = ""
    if arguments.length < 2 {
        say("usage: x11-clipboard-test own TEXT | read TARGET | targets\n")
        return
    }
    const mode = std.text.cString(arguments[1])
    if std.text.same(mode, "own") && arguments.length > 2 {
        run.mode = MODE_OWN
        run.text = std.text.cString(arguments[2])
    } else if std.text.same(mode, "read") {
        run.mode = MODE_READ
        if arguments.length > 2 { run.target = std.text.cString(arguments[2]) }
    } else {
        run.mode = MODE_TARGETS
    }
    const display = std.process.environment(arguments, "DISPLAY")
    if display == null {
        say("x11-clipboard-test: no DISPLAY\n")
        return
    }
    const socket = x11.connectDisplay(std.string.asSlice(display.?))
    if socket < 0 {
        say("x11-clipboard-test: cannot connect to the display\n")
        _ = std.linux.syscall1(SYS_exit_group, 1)
        return
    }
    x11.begin(&run.connection, @bitCast(usize, socket))
    const deadline = std.time.milliseconds() + 20000
    var poll: [2]i32 = [2]i32{ @intCast(i32, socket), 1 }
    while !run.done && std.time.milliseconds() < deadline {
        if std.linux.syscall3(SYS_poll, @intFromPtr(&poll), 1, 200) > 0 {
            if !x11.fill(&run.connection) {
                finish(&run, 1, "the display went")
            } else {
                var message: x11.Message = undefined
                while !run.done && x11.take(&run.connection, &message) { handle(&run, &message) }
            }
        }
    }
    if !run.done { say("x11-clipboard-test: time is up\n") }
    _ = std.linux.syscall1(SYS_exit_group, @intCast(usize, run.status))
}
