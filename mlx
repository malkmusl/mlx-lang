#!/bin/sh
# This checkout's Mlx compiler, made when it is missing or its sources
# changed, then run with the arguments:
#
#   ./mlx build [STEP...]     build what build.mlx declares, only what is
#                             not current (./mlx build --list, --help)
#   ./mlx FILE.mlx -o OUT     compile one program
#
# The compiler is mlx-out/bin/compiler/mlx4 (tools/ensure_compiler.sh
# makes it: from an older mlx4, else from the bootstrap compiler, which
# needs zig once). It is looked at again only when a file of the compiler
# or of std/bootstrap is newer than the last look.
set -eu

root=$(cd "$(dirname "$0")" && pwd)
compiler="$root/mlx-out/bin/compiler/mlx4"
checked="$root/mlx-out/bin/compiler/.checked"

stale=0
if [ ! -x "$compiler" ] || [ ! -f "$checked" ]; then
    stale=1
elif [ -n "$(find "$root/compiler/selfhost" "$root/std/bootstrap" -name '*.mlx' -newer "$checked" 2> /dev/null | head -n 1)" ]; then
    stale=1
fi
if [ "$stale" -eq 1 ]; then
    "$root/tools/ensure_compiler.sh" > /dev/null
    : > "$checked"
fi

# The compiler finds std/ in its working directory, and build.mlx is at
# the root: a build always runs there.
if [ "${1:-}" = build ]; then
    cd "$root"
fi
exec "$compiler" "$@"
