<ZinControlFlow version="1.0" normative="true">
  <If conditionType="bool" expressionForm="true" optionalCapture="true" errorCapture="true"/>
  <While conditionType="bool" continueExpression="supported" labels="supported"/>
  <For iterables="arrays slices ranges" rangeSemantics="start inclusive, end exclusive" enumerationSyntax="for item, idx in items" pointerCapture="for *item in items"/>
  <Match supports="enum tagged-union integer ranges" fallthrough="false" exhaustiveEnums="true" exhaustiveTaggedUnions="true" integerRequiresElseUnlessProvenComplete="true"/>
  <Return supportsMultiple="true"/>
  <Defer order="LIFO" executesOn="normal return,error return,scope-leaving break/continue" capture="by execution-time variable lookup"/>
  <ErrDefer order="LIFO" executesOn="error propagation only"/>
  <Panic recoverable="false" exceptionUnwind="false">Panic is not a cleanup mechanism. Defer execution is not guaranteed during panic termination.</Panic>
</ZinControlFlow>
