(* Zin 1.0 normative grammar. Newline filtering produces STATEMENT_END tokens. *)

source_file      = { STATEMENT_END }, { top_level_decl, { STATEMENT_END } }, EOF ;

top_level_decl   = { decl_modifier }, declaration ;
decl_modifier    = "pub" | "export" | "inline" | "noinline" | extern_modifier ;
extern_modifier  = "extern", [ "(", STRING, ")" ] ;

declaration      = const_decl | var_decl | fn_decl | test_decl ;
const_decl       = "const", IDENT, [ ":", type_expr ], "=", expression ;
var_decl         = [ "threadlocal" ], "var", IDENT, [ ":", type_expr ], "=", expression ;
fn_decl          = "fn", IDENT, "(", [ parameter_list ], ")", return_type, block ;
parameter_list   = parameter, { ",", parameter }, [ "," ] ;
parameter        = [ "comptime" ], IDENT, ":", ( type_expr | "anytype" ) ;
return_type      = type_expr | error_union_type ;
test_decl        = "test", STRING, block ;

block             = "{", { STATEMENT_END }, { statement, { STATEMENT_END } }, "}" ;
statement         = declaration
                  | assignment
                  | expression
                  | if_stmt
                  | while_stmt
                  | for_stmt
                  | inline_for_stmt
                  | inline_while_stmt
                  | match_stmt
                  | return_stmt
                  | break_stmt
                  | continue_stmt
                  | defer_stmt
                  | errdefer_stmt
                  | comptime_block
                  | unsafe_block ;

assignment        = expression, assignment_op, expression ;
assignment_op     = "="
                  | "+=" | "-=" | "*=" | "/=" | "%="
                  | "+%=" | "-%=" | "*%=" | "+|=" | "-|=" | "*|="
                  | "&=" | "|=" | "^="
                  | shift_assignment_op
                  | shift_combine_assignment_op ;

shift_assignment_op = "<<=" | ">>=" | "<<%=" | ">>%=" | "<<|=" | "<<%|=" ;

shift_combine_assignment_op
                  = "&<<=" | "|<<=" | "^<<="
                  | "&>>=" | "|>>=" | "^>>="
                  | "<<&=" | "<<^=" | ">>&=" | ">>|=" | ">>^="
                  | "+<<=" | "-<<=" | "*<<="
                  | "+%<<=" | "-%<<=" | "*%<<="
                  | "+|<<=" | "-|<<=" | "*|<<="
                  | "+>>=" | "->>=" | "*>>="
                  | "+%>>=" | "-%>>=" | "*%>>="
                  | "+|>>=" | "-|>>=" | "*|>>=" ;

if_stmt           = "if", expression, [ capture ], block,
                    [ "else", ( if_stmt | [ error_capture ], block ) ] ;
capture           = "|", capture_item, { ",", capture_item }, "|" ;
error_capture     = "|", IDENT, "|" ;
capture_item      = [ "*" ], IDENT ;

while_stmt        = [ label ], "while", expression, [ ":", "(", expression, ")" ], block ;
inline_while_stmt = "inline", "while", expression, block ;
for_stmt          = [ label ], "for", for_capture, "in", expression, block ;
inline_for_stmt   = "inline", "for", for_capture, "in", expression, block ;
for_capture       = [ "*" ], IDENT, [ ",", IDENT ] ;
label             = IDENT, ":" ;

match_stmt        = "match", expression, "{", { STATEMENT_END },
                    match_arm, { { STATEMENT_END }, match_arm }, { STATEMENT_END }, "}" ;
match_arm         = pattern, "=>", ( expression | block ) ;
pattern           = "else"
                  | ".", IDENT, [ "(", capture_item, { ",", capture_item }, ")" ]
                  | literal
                  | expression, "..", expression ;

return_stmt       = "return", [ expression, { ",", expression } ] ;
break_stmt        = "break", [ ":", IDENT ], [ expression ] ;
continue_stmt     = "continue", [ ":", IDENT ] ;
defer_stmt        = "defer", ( expression | block ) ;
errdefer_stmt     = "errdefer", ( expression | block ) ;
comptime_block    = "comptime", block ;
unsafe_block      = "unsafe", block ;

expression        = assignment_expr ;
assignment_expr   = logical_or ;
logical_or        = logical_and, { "||", logical_and } ;
logical_and       = comparison, { "&&", comparison } ;
comparison        = bit_or, { comparison_op, bit_or } ;
comparison_op     = "==" | "!=" | "<" | "<=" | ">" | ">=" ;
bit_or            = bit_xor, { "|", bit_xor } ;
bit_xor           = bit_and, { "^", bit_and } ;
bit_and           = shift, { "&", shift } ;
shift             = additive, { shift_operator, additive } ;
shift_operator    = basic_shift_operator | shift_combine_operator ;
basic_shift_operator
                  = "<<" | ">>" | "<<%" | ">>%" | "<<|" | "<<%|" ;
shift_combine_operator
                  = "&<<" | "|<<" | "^<<" | "&>>" | "|>>" | "^>>"
                  | "<<&" | "<<^" | ">>&" | ">>|" | ">>^"
                  | "+<<" | "-<<" | "*<<" | "+%<<" | "-%<<" | "*%<<" | "+|<<" | "-|<<" | "*|<<"
                  | "+>>" | "->>" | "*>>" | "+%>>" | "-%>>" | "*%>>" | "+|>>" | "-|>>" | "*|>>" ;
additive          = multiplicative, { ( "+" | "-" | "+%" | "-%" | "+|" | "-|" ), multiplicative } ;
multiplicative    = unary, { ( "*" | "/" | "%" | "*%" | "*|" ), unary } ;
unary             = { "!" | "-" | "~" | "&" | "try" | "comptime" }, postfix ;
postfix           = primary, { postfix_suffix } ;
postfix_suffix    = call_suffix | index_suffix | slice_suffix | field_suffix | deref_suffix | optional_unwrap ;
call_suffix       = "(", [ argument_list ], ")" ;
argument_list     = expression, { ",", expression }, [ "," ] ;
index_suffix      = "[", expression, "]" ;
slice_suffix      = "[", [ expression ], "..", [ expression ], "]" ;
field_suffix      = ".", IDENT ;
deref_suffix      = ".*" ;
optional_unwrap   = ".?" ;

primary           = literal
                  | IDENT
                  | qualified_ident
                  | builtin_call
                  | tuple_literal
                  | array_literal
                  | aggregate_literal
                  | if_expression
                  | match_expression
                  | "(", expression, ")" ;

qualified_ident   = IDENT, { ".", IDENT } ;
builtin_call      = "@", IDENT, "(", [ argument_list ], ")" ;
tuple_literal     = ".", "{", [ argument_list ], "}" ;
array_literal     = type_expr, "{", [ argument_list ], "}"
                  | "[_]", type_expr, "{", [ argument_list ], "}" ;
aggregate_literal = [ type_expr ], ".", "{", [ field_initializer, { field_initializer } ], "}" ;
field_initializer = ".", IDENT, "=", expression, [ "," ], { STATEMENT_END } ;

if_expression     = "if", expression, block, "else", block ;
match_expression  = match_stmt ;

literal           = INTEGER | FLOAT | STRING | BYTE_STRING | CHAR | "true" | "false" | "null" | "undefined" ;

type_expr          = nocopy_simple_type
                   | primitive_type
                   | pointer_type
                   | many_pointer_type
                   | slice_type
                   | array_type
                   | optional_type
                   | tuple_type
                   | fn_type
                   | struct_type
                   | enum_type
                   | union_type
                   | error_set_type
                   | vector_type
                   | qualified_ident
                   | "type" ;
nocopy_simple_type = "@nocopy", "(", ( primitive_type | pointer_type | slice_type | array_type | qualified_ident ), ")" ;

primitive_type     = INTEGER_TYPE | FLOAT_TYPE | "bool" | "void" | "noreturn"
                   | "usize" | "isize" | C_ABI_TYPE ;
pointer_type       = "*", { pointer_qualifier }, type_expr ;
many_pointer_type  = "[*]", [ ":", expression ], { pointer_qualifier }, type_expr ;
pointer_qualifier  = "const" | "volatile" | "align", "(", expression, ")" ;
slice_type         = "[]", [ "const" ], type_expr ;
array_type         = "[", expression, [ ":", expression ], "]", type_expr ;
optional_type      = "?", type_expr ;
error_union_type   = [ qualified_ident ], "!", type_expr ;
tuple_type         = "(", type_expr, ",", type_expr, { ",", type_expr }, [ "," ], ")" ;
fn_type            = "fn", "(", [ type_expr, { ",", type_expr }, [ "," ] ], ")", type_expr ;
vector_type        = "@Vector", "(", expression, ",", type_expr, ")" ;

struct_type        = [ "packed" | "extern" ], "struct", "{", { aggregate_member }, "}"
                   | "@nocopy", "(", [ "packed" | "extern" ], "struct", ")", "{", { aggregate_member }, "}" ;
enum_type          = "enum", "(", integer_type, [ ",", "nonexhaustive" ], ")", "{", { enum_member }, "}"
                   | "@nocopy", "(", "enum", "(", integer_type, [ ",", "nonexhaustive" ], ")", ")", "{", { enum_member }, "}" ;
union_type         = [ "packed" | "extern" ], "union", [ "(", union_tag, ")" ], "{", { union_member }, "}"
                   | "@nocopy", "(", [ "packed" | "extern" ], "union", [ "(", union_tag, ")" ], ")", "{", { union_member }, "}" ;
union_tag          = "enum", "(", integer_type, ")" | type_expr ;
error_set_type     = "error", "{", { IDENT, { STATEMENT_END } }, "}" ;
aggregate_member   = field_decl | fn_decl | const_decl | var_decl ;
field_decl         = [ "pub" ], IDENT, ":", type_expr, [ "=", expression ], { STATEMENT_END } ;
enum_member        = IDENT, [ "=", expression ], { STATEMENT_END } ;
union_member       = IDENT, [ ":", type_expr ], { STATEMENT_END } ;
integer_type       = INTEGER_TYPE | "usize" | "isize" ;
