<ZinCompilerPipeline version="1.0" normative="true">
  <Stage n="1" name="SourceManager"/>
  <Stage n="2" name="Lexer">UTF-8, tokenization, comments, physical newlines</Stage>
  <Stage n="3" name="NewlineFilter">STATEMENT_END emission</Stage>
  <Stage n="4" name="Parser">recursive-declaration parser + Pratt expression parser</Stage>
  <Stage n="5" name="AST"/>
  <Stage n="6" name="Sema">symbols, types, coercions, layouts, exhaustiveness, errors, comptime</Stage>
  <Stage n="7" name="LIRLowering"/>
  <Stage n="8" name="Optimization">minimal mandatory canonicalization; advanced optimization optional for bootstrap</Stage>
  <Stage n="9" name="RegisterAllocation"/>
  <Stage n="10" name="x86_64Encoding"/>
  <Stage n="11" name="ObjectWriter"/>
  <Stage n="12" name="IntegratedLink"/>
</ZinCompilerPipeline>
