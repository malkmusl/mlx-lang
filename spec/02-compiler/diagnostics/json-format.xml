<ZinDiagnosticJson version="1.0" normative="true">
  <RequiredTopLevelFields>severity, code, phase, message, primary</RequiredTopLevelFields>
  <SpanFields>file, byte_start, byte_end, line_start, column_start, line_end, column_end</SpanFields>
  <OptionalTopLevelFields>cause, notes, related, fixes, instantiation_trace, comptime_trace</OptionalTopLevelFields>
  <Example><![CDATA[
{
  "severity": "error",
  "code": "ZIN-E6001",
  "phase": "sema",
  "message": "use of moved value `file`",
  "primary": {
    "file": "src/main.zin",
    "byte_start": 82,
    "byte_end": 86,
    "line_start": 5,
    "column_start": 1,
    "line_end": 5,
    "column_end": 5
  },
  "related": [
    { "message": "value moved here", "file": "src/main.zin", "byte_start": 41, "byte_end": 52 }
  ]
}
  ]]></Example>
</ZinDiagnosticJson>
