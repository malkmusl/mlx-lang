// What this repository is and how it is built: `./mlx build [STEP...]`
// (or `mlx build` with an Mlx compiler on PATH). It takes the place of
// build.zig and build.zig.zon: package() is the project's manifest,
// build() its build graph, run by std.build (std/src/build.mlx), which
// builds only what is not current.
//
//     ./mlx build                 everything below but bootstrap and android
//     ./mlx build desktop         one group (--list names them all)
//     ./mlx build mlx-compositor  one step and what it needs
//     ./mlx build -j 8 --verbose  eight jobs, and say what was current
//
// Programs go to mlx-out/bin, shared objects and plugins to mlx-out/lib,
// the record of what was built from what to mlx-out/build.
const Build = @import("std.build")

pub fn package() -> Build.Package {
    return Build.Package.{
        .name = "mlx-lang",
        .version = "0.1.0",
        .description = "the Mlx language, its compiler and standard library, and MLX/Linux (the desktop, its services and tools)",
    }
}

// An Mlx program in GROUP.
fn program(b: *Build.Builder, group: Build.Step, name: []const u8, root: []const u8) -> Build.Step {
    const step = Build.program(b, name, root)
    Build.add(b, group, step)
    return step
}

// A utility of projects/coreutils, as mlx-out/bin/coreutils/NAME.
fn utility(b: *Build.Builder, group: Build.Step, name: []const u8) -> void {
    const step = program(b, group, Build.concat(b, "coreutils/", name), Build.concat(b, Build.concat(b, "projects/coreutils/", name), "/main.mlx"))
}

// The desktop session (tools/install_compositor_session.sh installs it).
fn desktop(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "desktop", "the MLX desktop: compositor, apps, MLXIPC, MLX Audio, notifications")
    const compositor = program(b, group, "mlx-compositor", "projects/desktop/compositor/main.mlx")
    const terminal = program(b, group, "mlx-terminal", "projects/desktop/terminal/main.mlx")
    const shell = program(b, group, "mlx-sh", "projects/shell/main.mlx")
    const console = program(b, group, "mlx-console", "projects/console/main.mlx")
    const dock = program(b, group, "mlx-dock", "projects/desktop/dock/main.mlx")
    const topbar = program(b, group, "mlx-topbar", "projects/desktop/topbar/main.mlx")
    const launcher = program(b, group, "mlx-launcher", "projects/desktop/launcher/main.mlx")
    const settings = program(b, group, "mlx-settings", "projects/desktop/settings/main.mlx")
    const files = program(b, group, "mlx-files", "projects/desktop/files/main.mlx")
    const observatory = program(b, group, "mlx-observatory", "projects/observatory/main.mlx")
    // The code map's command line under its own name (the same program).
    const codemap = Build.link(b, "mlx-codemap", "mlx-observatory")
    Build.dependOn(b, codemap, observatory)
    Build.add(b, group, codemap)
    const profile = program(b, group, "mlx-profile", "tools/profile/main.mlx")
    const capture = program(b, group, "mlx-capture", "projects/desktop/capture/main.mlx")
    // MLX Capture as an OBS source.
    const obs = Build.plugin(b, "mlx-capture.so", "projects/desktop/capture/obs.mlx")
    Build.add(b, group, obs)
    const ipcd = program(b, group, "mlx-ipcd", "projects/desktop/ipc/main.mlx")
    const ipc = program(b, group, "mlx-ipc", "projects/desktop/ipc/tool.mlx")
    const audiod = program(b, group, "mlx-audiod", "projects/desktop/audio/main.mlx")
    const audio = program(b, group, "mlx-audio", "projects/desktop/audio/tool.mlx")
    const permissions = program(b, group, "mlx-permissions", "projects/desktop/permissions/main.mlx")
    const notifyd = program(b, group, "mlx-notifyd", "projects/desktop/notifications/main.mlx")
    const notify = program(b, group, "mlx-notify", "projects/desktop/notifications/notify.mlx")
    // The session launcher is a shell script.
    const session = Build.copy(b, "mlx-session", "projects/desktop/compositor/session/mlx-session", "mlx-out/bin/mlx-session")
    Build.add(b, group, session)
    // The compositor's shell and renderer, which a running session loads
    // again when they change (tools/build_compositor_modules.sh puts them
    // where it looks).
    const shell_module = Build.sharedObject(b, "libmlx-shell.so", "projects/desktop/compositor/shell_module.mlx")
    const render_module = Build.sharedObject(b, "libmlx-render.so", "projects/desktop/compositor/render_module.mlx")
    Build.add(b, group, shell_module)
    Build.add(b, group, render_module)
    return group
}

// MLX Audio's libpulse and ALSA plugin, MLX Capture's libpipewire
// (tools/build_libpulse.sh and tools/build_libpipewire.sh package them).
fn clientLibraries(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "client-libraries", "libpulse, libpulse-simple, libpulse-mainloop-glib and the ALSA plugin (MLX Audio), libpipewire (MLX Capture)")
    const pulse = Build.plugin(b, "libpulse.so.0", "projects/desktop/libpulse/libpulse.mlx")
    Build.option(b, pulse, "--soname=libpulse.so.0")
    Build.option(b, pulse, "--symbol-version=PULSE_0")
    Build.add(b, group, pulse)
    const simple = Build.plugin(b, "libpulse-simple.so.0", "projects/desktop/libpulse/simple.mlx")
    Build.option(b, simple, "--library")
    Build.option(b, simple, "libpulse.so.0")
    Build.option(b, simple, "--soname=libpulse-simple.so.0")
    Build.option(b, simple, "--symbol-version=PULSE_0")
    Build.add(b, group, simple)
    const glib = Build.plugin(b, "libpulse-mainloop-glib.so.0", "projects/desktop/libpulse/glib.mlx")
    Build.option(b, glib, "--library")
    Build.option(b, glib, "libglib-2.0.so.0")
    Build.option(b, glib, "--soname=libpulse-mainloop-glib.so.0")
    Build.option(b, glib, "--symbol-version=PULSE_0")
    Build.add(b, group, glib)
    const alsa = Build.plugin(b, "libasound_module_pcm_pulse.so", "projects/desktop/libpulse/alsa.mlx")
    Build.option(b, alsa, "--library")
    Build.option(b, alsa, "libasound.so.2")
    Build.add(b, group, alsa)
    // ALSA's control plugin is the same object.
    const control = Build.copy(b, "libasound_module_ctl_pulse.so", "mlx-out/lib/libasound_module_pcm_pulse.so", "mlx-out/lib/libasound_module_ctl_pulse.so")
    Build.dependOn(b, control, alsa)
    Build.add(b, group, control)
    const pipewire = Build.plugin(b, "libpipewire-0.3.so.0", "projects/desktop/libpipewire/libpipewire.mlx")
    Build.option(b, pipewire, "--soname=libpipewire-0.3.so.0")
    Build.add(b, group, pipewire)
    return group
}

// mlxlibc, the C library in Mlx and its own dynamic loader.
fn libc(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "libc", "mlxlibc: the C library and dynamic loader in Mlx")
    const library = Build.plugin(b, "libmlxc.so.1", "projects/libc/libc.mlx")
    Build.option(b, library, "--stack-arena")
    Build.option(b, library, "--no-libc")
    Build.option(b, library, "--soname=libmlxc.so.1")
    Build.option(b, library, "--entry=__mlx_start")
    Build.option(b, library, "--init=__mlx_init")
    Build.add(b, group, library)
    const name = Build.link(b, "libmlxc.so", "libmlxc.so.1")
    Build.output(b, name, "mlx-out/lib/libmlxc.so")
    Build.dependOn(b, name, library)
    Build.add(b, group, name)
    return group
}

fn coreutils(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "coreutils", "the coreutils in Mlx (mlx-out/bin/coreutils)")
    utility(b, group, "true")
    utility(b, group, "false")
    utility(b, group, "echo")
    utility(b, group, "cat")
    utility(b, group, "wc")
    utility(b, group, "pwd")
    utility(b, group, "mkdir")
    utility(b, group, "rmdir")
    utility(b, group, "basename")
    utility(b, group, "dirname")
    utility(b, group, "head")
    utility(b, group, "tail")
    utility(b, group, "tee")
    utility(b, group, "yes")
    utility(b, group, "sleep")
    utility(b, group, "uname")
    utility(b, group, "printenv")
    utility(b, group, "env")
    utility(b, group, "nproc")
    utility(b, group, "link")
    utility(b, group, "unlink")
    utility(b, group, "touch")
    utility(b, group, "truncate")
    utility(b, group, "mkfifo")
    utility(b, group, "sync")
    utility(b, group, "cp")
    utility(b, group, "mv")
    utility(b, group, "rm")
    utility(b, group, "ln")
    utility(b, group, "chmod")
    utility(b, group, "readlink")
    utility(b, group, "realpath")
    utility(b, group, "chown")
    utility(b, group, "chgrp")
    utility(b, group, "stat")
    utility(b, group, "ls")
    utility(b, group, "arch")
    utility(b, group, "logname")
    utility(b, group, "whoami")
    utility(b, group, "seq")
    utility(b, group, "tac")
    utility(b, group, "nl")
    utility(b, group, "fold")
    utility(b, group, "uniq")
    utility(b, group, "cut")
    utility(b, group, "comm")
    utility(b, group, "tr")
    utility(b, group, "expr")
    utility(b, group, "test")
    utility(b, group, "[")
    utility(b, group, "base64")
    utility(b, group, "base32")
    utility(b, group, "basenc")
    utility(b, group, "md5sum")
    utility(b, group, "sha1sum")
    utility(b, group, "sha224sum")
    utility(b, group, "sha256sum")
    utility(b, group, "sha384sum")
    utility(b, group, "sha512sum")
    utility(b, group, "sum")
    utility(b, group, "cksum")
    utility(b, group, "b2sum")
    utility(b, group, "expand")
    utility(b, group, "unexpand")
