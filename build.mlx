}

// The programs the checks run beside the desktop (stand-ins and probes).
fn tools(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "tools", "the language server, the code index, and the checks' helpers")
    const lsp = program(b, group, "mlx-lsp", "tools/mlx-lsp/main.mlx")
    const index = program(b, group, "codemap", "tools/codemap/main.mlx")
    const shaders = program(b, group, "check-shaders", "tools/check-shaders/main.mlx")
    const clock = program(b, group, "clock-probe", "tools/clock-probe/main.mlx")
    const symbols = program(b, group, "symbols-sheet", "tools/symbols-sheet/main.mlx")
    const truetype = program(b, group, "truetype-dump", "tools/truetype-dump/main.mlx")
    const login = program(b, group, "lock-login-test", "tools/lock-login-test/main.mlx")
    const locker = program(b, group, "session-lock-test", "tools/session-lock-test/main.mlx")
    const services = program(b, group, "topbar-test-services", "tools/topbar-test-services/main.mlx")
    const drag = program(b, group, "wayland-drag-source", "tools/wayland-drag-source/main.mlx")
    const host = program(b, group, "wayland-test-host", "tools/wayland-test-host/main.mlx")
    return group
}

fn examples(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "examples", "the examples")
    const hello = program(b, group, "hello", "examples/hello/main.mlx")
    const info = program(b, group, "vulkan-info", "examples/vulkan-info/main.mlx")
    const client = program(b, group, "wayland-client", "examples/wayland-client/main.mlx")
    const server = program(b, group, "wayland-server", "examples/wayland-server/main.mlx")
    const vulkan = program(b, group, "vulkan-wayland-client", "examples/vulkan-wayland-client/main.mlx")
    return group
}

// Android packages (an .apk the compiler signs with its debug key unless
// --android-key says otherwise).
fn android(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "android", "the Android packages (mlx-out/android)")
    const files = Build.program(b, "mlx-files.apk", "projects/android/files/main.mlx")
    Build.output(b, files, "mlx-out/android/mlx-files.apk")
    Build.option(b, files, "--target=aarch64-android")
    Build.option(b, files, "--android-package=org.mlx.files")
    Build.option(b, files, "--android-label=Mlx Files")
    Build.add(b, group, files)
    const vulkan = Build.program(b, "vulkan.apk", "examples/vulkan-android/main.mlx")
    Build.output(b, vulkan, "mlx-out/android/vulkan.apk")
    Build.option(b, vulkan, "--target=aarch64-android")
    Build.option(b, vulkan, "--android-package=dev.mlxlang.vulkan")
    Build.option(b, vulkan, "--android-label=Mlx Vulkan")
    Build.add(b, group, vulkan)
    return group
}

// Stage 0, what build.zig built: the bootstrap compiler mlx0 and the Zig
// language server from compiler/bootstrap (with zig), and mlx1, the
// self-hosted compiler built by mlx0. Only for bootstrapping a machine
// without an Mlx compiler (./mlx does that by itself).
fn bootstrap(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "bootstrap", "stage 0 with zig: mlx0, mlx-lsp (Zig) and mlx1 into zig-out/bin")
    const mlx0 = Build.command(b, "mlx0", "zig-out/bin/mlx0", "zig build-exe compiler/bootstrap/main.zig --name mlx0 -femit-bin=zig-out/bin/mlx0")
    Build.inputTree(b, mlx0, "compiler/bootstrap", ".zig")
    Build.add(b, group, mlx0)
    const lsp = Build.command(b, "mlx-lsp-zig", "zig-out/bin/mlx-lsp", "zig build-exe compiler/bootstrap/lsp.zig --name mlx-lsp -femit-bin=zig-out/bin/mlx-lsp")
    Build.inputTree(b, lsp, "compiler/bootstrap", ".zig")
    Build.add(b, group, lsp)
    const mlx1 = Build.command(b, "mlx1", "zig-out/bin/mlx1", "zig-out/bin/mlx0 compiler/selfhost/main.mlx -o zig-out/bin/mlx1")
    Build.input(b, mlx1, "zig-out/bin/mlx0")
    Build.inputTree(b, mlx1, "compiler/selfhost", ".mlx")
    Build.inputTree(b, mlx1, "std/bootstrap", ".mlx")
    Build.dependOn(b, mlx1, mlx0)
    Build.add(b, group, mlx1)
    const tests = Build.group(b, "bootstrap-test", "the Zig unit tests of mlx0 and its language server")
    const unit = Build.command(b, "zig-test-mlx0", "", "zig test compiler/bootstrap/main.zig")
    Build.inputTree(b, unit, "compiler/bootstrap", ".zig")
    Build.add(b, tests, unit)
    const lsp_unit = Build.command(b, "zig-test-lsp", "", "zig test compiler/bootstrap/lsp.zig")
    Build.inputTree(b, lsp_unit, "compiler/bootstrap", ".zig")
    Build.add(b, tests, lsp_unit)
    return group
}

pub fn build(b: *Build.Builder) -> void {
    const all = Build.group(b, "all", "everything but bootstrap and android")
    Build.add(b, all, desktop(b))
    Build.add(b, all, clientLibraries(b))
    const login = Build.group(b, "login", "the display manager: mlx-login, mlx-greeter, mlx-lock")
    const daemon = program(b, login, "mlx-login", "projects/desktop/login/main.mlx")
    const greeter = program(b, login, "mlx-greeter", "projects/desktop/greeter/main.mlx")
    const lock = program(b, login, "mlx-lock", "projects/desktop/lock/main.mlx")
    Build.add(b, all, login)
    const network = Build.group(b, "network", "the network service: mlx-netd, mlx-net, on MLXIPC's mlx-ipcd")
    const netd = program(b, network, "mlx-netd", "projects/network/main.mlx")
    const net = program(b, network, "mlx-net", "projects/network/tool.mlx")
    Build.add(b, network, Build.step(b, "mlx-ipcd"))
    Build.add(b, all, network)
    const splash = Build.group(b, "splash", "the boot splash: mlx-splash, mlx-splashctl")
    const splash_daemon = program(b, splash, "mlx-splash", "projects/desktop/splash/main.mlx")
    const splash_tool = program(b, splash, "mlx-splashctl", "projects/desktop/splash/tool.mlx")
    Build.add(b, all, splash)
    const init = Build.group(b, "init", "mlx-init (PID 1) and mlx-initctl")
    const pid1 = program(b, init, "mlx-init", "projects/init/main.mlx")
    const control = program(b, init, "mlx-initctl", "projects/init/tool.mlx")
    Build.add(b, all, init)
    Build.add(b, all, libc(b))
    Build.add(b, all, coreutils(b))
    Build.add(b, all, tools(b))
    Build.add(b, all, examples(b))
    const apks = android(b)
    const stage0 = bootstrap(b)
    Build.byDefault(b, all)
}
