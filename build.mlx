// What this repository is and how it is built: `./mlx build [STEP...]`
// (or `mlx build` with an Mlx compiler on PATH). It takes the place of
// build.zig and build.zig.zon: package() is the project's manifest,
// build() its build graph, run by std.build (std/src/build.mlx), which
// builds only what is not current.
//
//     ./mlx build                 everything below but bootstrap and android
//     ./mlx build desktop         one group (--list names them all)
//     ./mlx build mlx-compositor  one step and what it needs
//     ./mlx build -j 8 --verbose  eight jobs, and say what was current
//
// Programs go to mlx-out/bin, shared objects and plugins to mlx-out/lib,
// the record of what was built from what to mlx-out/build.
const Build = @import("std.build")
const webkit = @import("./projects/webkit/build.mlx")

pub fn package() -> Build.Package {
    return Build.Package.{
        .name = "mlx-lang",
        .version = "0.1.0",
        .description = "the Mlx language, its compiler and standard library, and MLX/Linux (the desktop, its services and tools)",
    }
}

// An Mlx program in GROUP.
fn program(b: *Build.Builder, group: Build.Step, name: []const u8, root: []const u8) -> Build.Step {
    const step = Build.program(b, name, root)
    Build.add(b, group, step)
    return step
}

// A utility of projects/coreutils, as mlx-out/bin/coreutils/NAME.
fn utility(b: *Build.Builder, group: Build.Step, name: []const u8) -> void {
    _ = program(b, group, Build.concat(b, "coreutils/", name), Build.concat(b, Build.concat(b, "projects/coreutils/", name), "/main.mlx"))
}

// The desktop session (tools/install_compositor_session.sh installs it).
fn desktop(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "desktop", "the MLX desktop: compositor, apps, MLXIPC, MLX Audio, notifications")
    _ = program(b, group, "mlx-compositor", "projects/desktop/compositor/main.mlx")
    _ = program(b, group, "mlx-terminal", "projects/desktop/terminal/main.mlx")
    _ = program(b, group, "mlx-sh", "projects/shell/main.mlx")
    _ = program(b, group, "mlx-console", "projects/console/main.mlx")
    _ = program(b, group, "mlx-dock", "projects/desktop/dock/main.mlx")
    _ = program(b, group, "mlx-topbar", "projects/desktop/topbar/main.mlx")
    _ = program(b, group, "mlx-launcher", "projects/desktop/launcher/main.mlx")
    _ = program(b, group, "mlx-settings", "projects/desktop/settings/main.mlx")
    _ = program(b, group, "mlx-files", "projects/desktop/files/main.mlx")
    const observatory = program(b, group, "mlx-observatory", "projects/observatory/main.mlx")
    // The code map's command line under its own name (the same program).
    const codemap = Build.link(b, "mlx-codemap", "mlx-observatory")
    Build.dependOn(b, codemap, observatory)
    Build.add(b, group, codemap)
    _ = program(b, group, "mlx-profile", "tools/profile/main.mlx")
    _ = program(b, group, "mlx-capture", "projects/desktop/capture/main.mlx")
    // MLX Capture as an OBS source.
    const obs = Build.plugin(b, "mlx-capture.so", "projects/desktop/capture/obs.mlx")
    Build.add(b, group, obs)
    _ = program(b, group, "mlx-ipcd", "projects/desktop/ipc/main.mlx")
    _ = program(b, group, "mlx-ipc", "projects/desktop/ipc/tool.mlx")
    _ = program(b, group, "mlx-audiod", "projects/desktop/audio/main.mlx")
    _ = program(b, group, "mlx-audio", "projects/desktop/audio/tool.mlx")
    _ = program(b, group, "mlx-permissions", "projects/desktop/permissions/main.mlx")
    _ = program(b, group, "mlx-notifyd", "projects/desktop/notifications/main.mlx")
    _ = program(b, group, "mlx-notify", "projects/desktop/notifications/notify.mlx")
    // The session launcher is a shell script.
    const session = Build.copy(b, "mlx-session", "projects/desktop/compositor/session/mlx-session", "mlx-out/bin/mlx-session")
    Build.add(b, group, session)
    // The compositor's shell and renderer, which a running session loads
    // again when they change (tools/build_compositor_modules.sh puts them
    // where it looks).
    const shell_module = Build.sharedObject(b, "libmlx-shell.so", "projects/desktop/compositor/shell_module.mlx")
    const render_module = Build.sharedObject(b, "libmlx-render.so", "projects/desktop/compositor/render_module.mlx")
    Build.add(b, group, shell_module)
    Build.add(b, group, render_module)
    return group
}

// MLX Audio's libpulse and ALSA plugin, MLX Capture's libpipewire
// (tools/build_libpulse.sh and tools/build_libpipewire.sh package them).
fn clientLibraries(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "client-libraries", "libpulse, libpulse-simple, libpulse-mainloop-glib and the ALSA plugin (MLX Audio), libpipewire (MLX Capture)")
    const pulse = Build.plugin(b, "libpulse.so.0", "compiler/capi/pulse/libpulse.mlx")
    Build.option(b, pulse, "--soname=libpulse.so.0")
    Build.option(b, pulse, "--symbol-version=PULSE_0")
    Build.add(b, group, pulse)
    const simple = Build.plugin(b, "libpulse-simple.so.0", "compiler/capi/pulse/simple.mlx")
    Build.option(b, simple, "--library")
    Build.option(b, simple, "libpulse.so.0")
    Build.option(b, simple, "--soname=libpulse-simple.so.0")
    Build.option(b, simple, "--symbol-version=PULSE_0")
    Build.add(b, group, simple)
    const glib = Build.plugin(b, "libpulse-mainloop-glib.so.0", "compiler/capi/pulse/glib.mlx")
    Build.option(b, glib, "--library")
    Build.option(b, glib, "libglib-2.0.so.0")
    Build.option(b, glib, "--soname=libpulse-mainloop-glib.so.0")
    Build.option(b, glib, "--symbol-version=PULSE_0")
    Build.add(b, group, glib)
    const alsa = Build.plugin(b, "libasound_module_pcm_pulse.so", "compiler/capi/pulse/alsa.mlx")
    Build.option(b, alsa, "--library")
    Build.option(b, alsa, "libasound.so.2")
    Build.add(b, group, alsa)
    // ALSA's control plugin is the same object.
    const control = Build.copy(b, "libasound_module_ctl_pulse.so", "mlx-out/lib/libasound_module_pcm_pulse.so", "mlx-out/lib/libasound_module_ctl_pulse.so")
    Build.dependOn(b, control, alsa)
    Build.add(b, group, control)
    const pipewire = Build.plugin(b, "libpipewire-0.3.so.0", "compiler/capi/pipewire/libpipewire.mlx")
    Build.option(b, pipewire, "--soname=libpipewire-0.3.so.0")
    Build.add(b, group, pipewire)
    return group
}

// mlxlibc, the C library in Mlx and its own dynamic loader.
fn libc(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "libc", "mlxlibc: the C library and dynamic loader in Mlx")
    const library = Build.plugin(b, "libmlxc.so.1", "compiler/libc/libc.mlx")
    Build.option(b, library, "--stack-arena")
    Build.option(b, library, "--no-libc")
    Build.option(b, library, "--soname=libmlxc.so.1")
    Build.option(b, library, "--entry=__mlx_start")
    Build.option(b, library, "--init=__mlx_init")
    Build.add(b, group, library)
    const name = Build.link(b, "libmlxc.so", "libmlxc.so.1")
    Build.output(b, name, "mlx-out/lib/libmlxc.so")
    Build.dependOn(b, name, library)
    Build.add(b, group, name)
    return group
}

// Where the headers of mlx-unicode are made (`-I` this for <unicode/...>).
pub const UNICODE_HEADERS: []const u8 = "mlx-out/include/mlx-unicode"

// mlx-unicode: Unicode for C and C++ programs with ICU's C API
// (compiler/capi/icu), over std.unicode (std/src/unicode) and
// std.timezone.database. What they look up is made of the data in
// std/registry/unicode and std/registry/tz: the tables of the Unicode
// Character Database by unicode-generate, the time zones of the IANA
// database by tz-generate, the locale data of CLDR by cldr-generate and
// collation-generate, all kept in the tree (made again when the data or
// the generator changes); the formatters' data (cldr.dat) by cldr-data.
fn unicode(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "unicode", "libmlxunicode.so: Unicode with ICU's C API, over std.unicode")
    const generator = program(b, group, "unicode-generate", "std/registry/unicode/generate.mlx")
    const tables = Build.command(b, "unicode-tables", "std/src/unicode/tables.mlx", "mlx-out/bin/unicode-generate std/registry/unicode/ucd std/src/unicode/tables.mlx compiler/capi/icu/api/ugenerated.mlx")
    Build.inputTree(b, tables, "std/registry/unicode/ucd", ".txt")
    Build.inputTree(b, tables, "std/registry/unicode/uca", ".txt")
    Build.inputTree(b, tables, "std/registry/unicode/idna", ".txt")
    Build.input(b, tables, "mlx-out/bin/unicode-generate")
    Build.dependOn(b, tables, generator)
    Build.add(b, group, tables)
    // The time zones of std.timezone.database, made of the IANA database
    // (std/registry/tz).
    const tzGenerator = program(b, group, "tz-generate", "std/registry/tz/generate.mlx")
    const timezones = Build.command(b, "unicode-zones", "std/src/timezone/tzdata.mlx", "mlx-out/bin/tz-generate std/registry/tz std/src/timezone/tzdata.mlx")
    Build.input(b, timezones, "std/registry/tz/tzdata.zi")
    Build.input(b, timezones, "std/registry/tz/zone.tab")
    Build.input(b, timezones, "mlx-out/bin/tz-generate")
    Build.dependOn(b, timezones, tzGenerator)
    Build.add(b, group, timezones)
    // The locale data, made of CLDR (std/registry/unicode/cldr).
    const cldrGenerator = program(b, group, "cldr-generate", "std/registry/unicode/cldrgenerate.mlx")
    const locales = Build.command(b, "unicode-locales", "std/src/unicode/locale/data.mlx", "mlx-out/bin/cldr-generate std/registry/unicode/cldr std/src/unicode/locale/data.mlx")
    Build.inputTree(b, locales, "std/registry/unicode/cldr", ".json")
    Build.input(b, locales, "mlx-out/bin/cldr-generate")
    Build.dependOn(b, locales, cldrGenerator)
    Build.add(b, group, locales)
    // The collation tailorings, made of CLDR's collation data
    // (std/registry/unicode/cldr/collation).
    const collationGenerator = program(b, group, "collation-generate", "std/registry/unicode/collationgenerate.mlx")
    var collationLine = Build.concat(b, "mlx-out/bin/collation-generate ", "std/src/unicode/collation/rules.mlx std/registry/unicode/cldr/collation/radicals.txt")
    const collationFiles = Build.filesIn(b, "std/registry/unicode/cldr/collation", ".xml")
    var collationAt: usize = 0
    while collationAt < collationFiles.length {
        const name = Build.nextLine(collationFiles, &collationAt)
        if name.length > 0 { collationLine = Build.concat(b, Build.concat(b, collationLine, " std/registry/unicode/cldr/collation/"), name) }
    }
    const collations = Build.command(b, "unicode-collation", "std/src/unicode/collation/rules.mlx", collationLine)
    Build.inputTree(b, collations, "std/registry/unicode/cldr/collation", ".xml")
    Build.input(b, collations, "std/registry/unicode/cldr/collation/radicals.txt")
    Build.input(b, collations, "mlx-out/bin/collation-generate")
    Build.dependOn(b, collations, collationGenerator)
    Build.add(b, group, collations)
    // The formatters' data (cldr.dat, mapped by std.unicode), made of
    // CLDR's packages (std/registry/unicode/cldr/packages) by cldr-data.
    const dataGenerator = program(b, group, "cldr-data", "std/registry/unicode/cldrdata.mlx")
    const data = Build.command(b, "unicode-cldr-data", "mlx-out/share/mlx-unicode/cldr.dat", "mlx-out/bin/cldr-data std/registry/unicode/cldr/packages mlx-out/share/mlx-unicode/cldr.dat")
    Build.inputTree(b, data, "std/registry/unicode/cldr/packages", ".tgz")
    Build.input(b, data, "mlx-out/bin/cldr-data")
    Build.dependOn(b, data, dataGenerator)
    Build.add(b, group, data)
    // The headers C includes, made of the C API's Mlx modules
    // (compiler/capi/icu/api) by mlx-cheaders.
    const headers_tool = program(b, group, "mlx-cheaders", "compiler/cc/cheaders.mlx")
    var line = Build.concat(b, "mlx-out/bin/mlx-cheaders ", UNICODE_HEADERS)
    const modules = Build.filesIn(b, "compiler/capi/icu/api", ".mlx")
    var at: usize = 0
    while at < modules.length {
        const name = Build.nextLine(modules, &at)
        if name.length > 0 { line = Build.concat(b, Build.concat(b, line, " compiler/capi/icu/api/"), name) }
    }
    const headers = Build.command(b, "unicode-headers", Build.concat(b, UNICODE_HEADERS, "/unicode/uchar.h"), line)
    Build.inputTree(b, headers, "compiler/capi/icu/api", ".mlx")
    Build.input(b, headers, "mlx-out/bin/mlx-cheaders")
    Build.dependOn(b, headers, headers_tool)
    Build.dependOn(b, headers, tables)
    Build.add(b, group, headers)
    const library = Build.plugin(b, "libmlxunicode.so.1", "compiler/capi/icu/icu.mlx")
    Build.option(b, library, "--stack-arena")
    Build.option(b, library, "--soname=libmlxunicode.so.1")
    Build.dependOn(b, library, tables)
    Build.dependOn(b, library, timezones)
    Build.dependOn(b, library, locales)
    Build.dependOn(b, library, collations)
    Build.add(b, group, library)
    const name = Build.link(b, "libmlxunicode.so", "libmlxunicode.so.1")
    Build.output(b, name, "mlx-out/lib/libmlxunicode.so")
    Build.dependOn(b, name, library)
    Build.add(b, group, name)
    return group
}

// Where the headers of mlx-glib are made (`-I` this for <glib.h>,
// <glib-object.h>, <gio/gio.h>).
pub const GLIB_HEADERS: []const u8 = "mlx-out/include/mlx-glib"

// mlx-glib: GLib, GObject and GIO with GLib's C API, in Mlx
// (compiler/capi/glib), first what WebKit's base library uses. Its headers
// are made of the API's Mlx modules (compiler/capi/glib/api) by mlx-cheaders.
fn glib(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "glib", "libmlxglib.so: GLib, GObject and GIO with GLib's C API, in Mlx")
    var line = Build.concat(b, "mlx-out/bin/mlx-cheaders ", GLIB_HEADERS)
    const modules = Build.filesIn(b, "compiler/capi/glib/api", ".mlx")
    var at: usize = 0
    while at < modules.length {
        const name = Build.nextLine(modules, &at)
        if name.length > 0 { line = Build.concat(b, Build.concat(b, line, " compiler/capi/glib/api/"), name) }
    }
    const headers = Build.command(b, "glib-headers", Build.concat(b, GLIB_HEADERS, "/glib.h"), line)
    Build.inputTree(b, headers, "compiler/capi/glib/api", ".mlx")
    Build.input(b, headers, "mlx-out/bin/mlx-cheaders")
    Build.dependOn(b, headers, Build.step(b, "mlx-cheaders"))
    Build.add(b, group, headers)
    const library = Build.plugin(b, "libmlxglib.so.0", "compiler/capi/glib/glib.mlx")
    Build.option(b, library, "--stack-arena")
    Build.option(b, library, "--soname=libmlxglib.so.0")
    Build.add(b, group, library)
    const name = Build.link(b, "libmlxglib.so", "libmlxglib.so.0")
    Build.output(b, name, "mlx-out/lib/libmlxglib.so")
    Build.dependOn(b, name, library)
    Build.add(b, group, name)
    return group
}

// Where the headers of mlx-freetype are made (`-I` this for <ft2build.h>
// and <freetype/...>).
pub const FREETYPE_HEADERS: []const u8 = "mlx-out/include/mlx-freetype"

// mlx-freetype: FreeType's C API in Mlx (compiler/capi/freetype), first what
// WebKit's Skia and WebCore use. Its headers are made of the API's Mlx
// modules (compiler/capi/freetype/api) by mlx-cheaders.
fn freetype(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "freetype", "libmlxfreetype.so: FreeType's C API, in Mlx")
    var line = Build.concat(b, "mlx-out/bin/mlx-cheaders ", FREETYPE_HEADERS)
    const modules = Build.filesIn(b, "compiler/capi/freetype/api", ".mlx")
    var at: usize = 0
    while at < modules.length {
        const name = Build.nextLine(modules, &at)
        if name.length > 0 { line = Build.concat(b, Build.concat(b, line, " compiler/capi/freetype/api/"), name) }
    }
    const headers = Build.command(b, "freetype-headers", Build.concat(b, FREETYPE_HEADERS, "/freetype/freetype.h"), line)
    Build.inputTree(b, headers, "compiler/capi/freetype/api", ".mlx")
    Build.input(b, headers, "mlx-out/bin/mlx-cheaders")
    Build.dependOn(b, headers, Build.step(b, "mlx-cheaders"))
    Build.add(b, group, headers)
    const library = Build.plugin(b, "libmlxfreetype.so.6", "compiler/capi/freetype/freetype.mlx")
    Build.option(b, library, "--stack-arena")
    Build.option(b, library, "--soname=libmlxfreetype.so.6")
    Build.add(b, group, library)
    const name = Build.link(b, "libmlxfreetype.so", "libmlxfreetype.so.6")
    Build.output(b, name, "mlx-out/lib/libmlxfreetype.so")
    Build.dependOn(b, name, library)
    Build.add(b, group, name)
    return group
}

// Where the headers of mlx-zlib are made (`-I` this for <zlib.h>).
pub const ZLIB_HEADERS: []const u8 = "mlx-out/include/mlx-zlib"

// mlx-zlib: zlib's C API (compiler/capi/zlib) over std.flate and std.crc:
// deflate, inflate, the check values and the gzip files. Its headers
// (zlib.h, zconf.h) are made of the API's Mlx modules
// (compiler/capi/zlib/api) by mlx-cheaders.
fn zlib(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "zlib", "libmlxz.so: zlib's C API (deflate, inflate, gzip files), in Mlx")
    var line = Build.concat(b, "mlx-out/bin/mlx-cheaders ", ZLIB_HEADERS)
    const modules = Build.filesIn(b, "compiler/capi/zlib/api", ".mlx")
    var at: usize = 0
    while at < modules.length {
        const name = Build.nextLine(modules, &at)
        if name.length > 0 { line = Build.concat(b, Build.concat(b, line, " compiler/capi/zlib/api/"), name) }
    }
    const headers = Build.command(b, "zlib-headers", Build.concat(b, ZLIB_HEADERS, "/zlib.h"), line)
    Build.inputTree(b, headers, "compiler/capi/zlib/api", ".mlx")
    Build.input(b, headers, "mlx-out/bin/mlx-cheaders")
    Build.dependOn(b, headers, Build.step(b, "mlx-cheaders"))
    Build.add(b, group, headers)
    const library = Build.plugin(b, "libmlxz.so.1", "compiler/capi/zlib/zlib.mlx")
    Build.option(b, library, "--stack-arena")
    Build.option(b, library, "--soname=libmlxz.so.1")
    Build.add(b, group, library)
    const name = Build.link(b, "libmlxz.so", "libmlxz.so.1")
    Build.output(b, name, "mlx-out/lib/libmlxz.so")
    Build.dependOn(b, name, library)
    Build.add(b, group, name)
    return group
}

// mlx-cc, the C and C++ compiler in Mlx, with mlx-ar, its headers
// (mlx-out/include/mlx-cc, where mlx-out/bin/mlx-cc looks for them) and
// mlxlibcpp, the C++ library it links C++ programs with
// (mlx-out/lib/libmlxcpp.a).
pub const CC: []const u8 = "mlx-out/bin/mlx-cc"
pub const AR: []const u8 = "mlx-out/bin/mlx-ar"

fn cc(b: *Build.Builder, tc: *webkit.Toolchain) -> Build.Step {
    const group = Build.group(b, "cc", "mlx-cc and mlx-ar, their headers and mlxlibcpp")
    const compiler = program(b, group, "mlx-cc", "compiler/cc/main.mlx")
    const archiver = program(b, group, "mlx-ar", "compiler/cc/ar.mlx")
    const headers = Build.link(b, "mlx-cc-include", "../../compiler/cc/include")
    Build.output(b, headers, "mlx-out/include/mlx-cc")
    Build.add(b, group, headers)
    const library = Build.command(b, "libmlxcpp.a", "mlx-out/lib/libmlxcpp.a", "")
    var line = Build.concat(b, AR, " rcs mlx-out/lib/libmlxcpp.a")
    const sources = [4][]const u8{ "abi", "iostream", "new", "string" }
    for name in sources {
        const object = Build.concat(b, Build.concat(b, "mlx-out/obj/libcpp/", name), ".o")
        const step = cObject(b, Build.concat(b, "libcpp/", name), Build.concat(b, Build.concat(b, "compiler/libcpp/", name), ".cpp"), object, "")
        Build.dependOn(b, step, compiler)
        Build.dependOn(b, step, headers)
        Build.dependOn(b, library, step)
        Build.input(b, library, object)
        line = Build.concat(b, Build.concat(b, line, " "), object)
    }
    Build.setLine(b, library, line)
    Build.input(b, library, AR)
    Build.dependOn(b, library, archiver)
    Build.add(b, group, library)
    tc.* = webkit.Toolchain.{ .compiler = compiler, .headers = headers, .library = library, .archiver = archiver, .cc = CC, .ar = AR }
    return group
}

// The object OUTPUT compiled by mlx-cc from SOURCE with FLAGS, as the
// step NAME: compiled again when the source, a header it included or
// the compiler changed (its -MD dependency file).
pub fn cObject(b: *Build.Builder, name: []const u8, source: []const u8, output: []const u8, flags: []const u8) -> Build.Step {
    const depfile = Build.concat(b, output, ".d")
    var line = Build.concat(b, CC, " -MD -MF ")
    line = Build.concat(b, Build.concat(b, line, depfile), " ")
    if flags.length > 0 { line = Build.concat(b, Build.concat(b, line, flags), " ") }
    line = Build.concat(b, Build.concat(b, Build.concat(b, line, "-c "), source), Build.concat(b, " -o ", output))
    const step = Build.command(b, name, output, line)
    Build.depfile(b, step, depfile)
    Build.input(b, step, CC)
    return step
}

fn coreutils(b: *Build.Builder) -> Build.Step {
    const group = Build.group(b, "coreutils", "the coreutils in Mlx (mlx-out/bin/coreutils)")
    utility(b, group, "true")
    utility(b, group, "false")
    utility(b, group, "echo")
    utility(b, group, "cat")
    utility(b, group, "wc")
    utility(b, group, "pwd")
    utility(b, group, "mkdir")
    utility(b, group, "rmdir")
    utility(b, group, "basename")
    utility(b, group, "dirname")
    utility(b, group, "head")
    utility(b, group, "tail")
    utility(b, group, "tee")
    utility(b, group, "yes")
    utility(b, group, "sleep")
    utility(b, group, "uname")
    utility(b, group, "printenv")
    utility(b, group, "env")
    utility(b, group, "nproc")
    utility(b, group, "link")
    utility(b, group, "unlink")
    utility(b, group, "touch")
    utility(b, group, "truncate")
