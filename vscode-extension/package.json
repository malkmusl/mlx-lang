{
  "name": "mlx-vscode-extension",
  "displayName": "Mlx Language Support",
  "description": "VS Code extension providing LSP integration, semantic token highlighting, and an interactive AST explorer for Mlx language.",
  "publisher": "mlx-lang",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:mlx"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[mlx]": {
        "editor.bracketPairColorization.enabled": true
      }
    },
    "languages": [
      {
        "id": "mlx",
        "aliases": [
          "Mlx"
        ],
        "extensions": [
          ".mlx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mlx",
        "scopeName": "source.mlx",
        "path": "./syntaxes/mlx.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Mlx Vibrant Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/mlx-vibrant.json"
      }
    ],
    "commands": [
      {
        "command": "mlx.showAst",
        "title": "Mlx: Show AST"
      },
      {
        "command": "mlx.customizeColors",
        "title": "Mlx: Customize Theme Colors",
        "category": "Mlx"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build-lsp": "cd .. && tools/build_vscode_extension.sh"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.70.0",
    "typescript": "^5.0.0"
  }
}
