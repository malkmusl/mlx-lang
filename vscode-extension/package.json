{
  "name": "zin-vscode-extension",
  "displayName": "Zin Language Support",
  "description": "VS Code extension providing LSP integration, semantic token highlighting, and an interactive AST explorer for Zin language.",
  "publisher": "zin-lang",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:zin"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[zin]": {
        "editor.bracketPairColorization.enabled": true
      }
    },
    "languages": [
      {
        "id": "zin",
        "aliases": [
          "Zin"
        ],
        "extensions": [
          ".zin"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zin",
        "scopeName": "source.zin",
        "path": "./syntaxes/zin.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Zin Vibrant Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/zin-vibrant.json"
      }
    ],
    "commands": [
      {
        "command": "zin.showAst",
        "title": "Zin: Show AST"
      },
      {
        "command": "zin.customizeColors",
        "title": "Zin: Customize Theme Colors",
        "category": "Zin"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run build-lsp",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build-lsp": "cd .. && zig build -Dtarget=x86_64-linux-gnu && mkdir -p vscode-extension/bin && cp zig-out/bin/zin-lsp vscode-extension/bin/zin-lsp"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.70.0",
    "typescript": "^5.0.0"
  }
}
