{
  "name": "Mlx Vibrant Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4",
    "activityBarBadge.background": "#007acc",
    "sideBarTitle.foreground": "#bbbbbb"
  },
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": { "foreground": "#FF007F", "fontStyle": "bold" },
    "type": { "foreground": "#00FFFF", "fontStyle": "italic" },
    "function": { "foreground": "#39FF14" },
    "variable": { "foreground": "#FFB6C1" },
    "parameter": { "foreground": "#FFB6C1" },
    "string": { "foreground": "#00FF7F" },
    "number": { "foreground": "#FFEA00" },
    "operator": { "foreground": "#FFD700" }
  },
  "tokenColors": [
    {
      "scope": [
        "keyword.control.mlx"
      ],
      "settings": {
        "foreground": "#FF007F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.type.mlx",
        "storage.modifier.mlx"
      ],
      "settings": {
        "foreground": "#FF8C00",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type.mlx",
        "support.type.mlx"
      ],
      "settings": {
        "foreground": "#00FFFF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function.mlx"
      ],
      "settings": {
        "foreground": "#39FF14"
      }
    },
    {
      "scope": [
        "variable.parameter.mlx"
      ],
      "settings": {
        "foreground": "#FFB6C1"
      }
    },
    {
      "scope": [
        "support.function.builtin.mlx"
      ],
      "settings": {
        "foreground": "#B500FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.numeric.mlx"
      ],
      "settings": {
        "foreground": "#FFEA00"
      }
    },
    {
      "scope": [
        "constant.language.mlx"
      ],
      "settings": {
        "foreground": "#FF3333",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string.quoted.double.mlx"
      ],
      "settings": {
        "foreground": "#00FF7F"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.mlx"
      ],
      "settings": {
        "foreground": "#888888",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator.mlx"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    }
  ]
}
