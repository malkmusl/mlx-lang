{
  "name": "Zin Vibrant Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4",
    "activityBarBadge.background": "#007acc",
    "sideBarTitle.foreground": "#bbbbbb"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword.control.zin"
      ],
      "settings": {
        "foreground": "#FF007F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.type.zin",
        "storage.modifier.zin"
      ],
      "settings": {
        "foreground": "#FF8C00",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type.zin",
        "support.type.zin"
      ],
      "settings": {
        "foreground": "#00FFFF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function.zin"
      ],
      "settings": {
        "foreground": "#39FF14"
      }
    },
    {
      "scope": [
        "variable.parameter.zin"
      ],
      "settings": {
        "foreground": "#FFB6C1"
      }
    },
    {
      "scope": [
        "support.function.builtin.zin"
      ],
      "settings": {
        "foreground": "#B500FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "constant.numeric.zin"
      ],
      "settings": {
        "foreground": "#FFEA00"
      }
    },
    {
      "scope": [
        "constant.language.zin"
      ],
      "settings": {
        "foreground": "#FF3333",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string.quoted.double.zin"
      ],
      "settings": {
        "foreground": "#00FF7F"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.zin"
      ],
      "settings": {
        "foreground": "#888888",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator.zin"
      ],
      "settings": {
        "foreground": "#FFD700"
      }
    }
  ]
}
