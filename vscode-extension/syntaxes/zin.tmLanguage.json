{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zin",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*",
          "name": "comment.line.double-slash.zin"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.zin",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.zin"
            }
          ]
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": {
              "name": "storage.type.zin"
            },
            "2": {
              "name": "entity.name.function.zin"
            }
          }
        },
        {
          "match": "\\b([a-zA-Z_]\\w*)\\s*(?=\\()",
          "name": "entity.name.function.zin"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(const|var|pub|struct|enum|union|error|type)\\b",
          "name": "storage.type.zin"
        },
        {
          "match": "\\b(if|else|switch|while|for|break|continue|return|try|catch|defer|errdefer|unreachable|and|or|inline|unsafe|asm)\\b",
          "name": "keyword.control.zin"
        },
        {
          "match": "\\b(true|false|null|undefined)\\b",
          "name": "constant.language.zin"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "@[a-zA-Z_]\\w*",
          "name": "support.function.builtin.zin"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(bool|void|noreturn|anyerror|anyopaque|u\\d+|i\\d+|f16|f32|f64|f80|f128|usize|isize|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_longdouble|comptime_int|comptime_float)\\b",
          "name": "entity.name.type.zin"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b0x[0-9a-fA-F_]+\\b|\\b0o[0-7_]+\\b|\\b0b[01_]+\\b|\\b\\d[\\d_]*(\\.[\\d_]+)?([eE][+-]?[\\d_]+)?\\b",
          "name": "constant.numeric.zin"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(\\+|-|\\*|/|%|=|==|!=|<|>|<=|>=|\\+=|-=|\\*=|/=|%=|&|\\||\\^|~|<<|>>|<<=|>>=|\\band\\b|\\bor\\b|\\borelse\\b)",
          "name": "keyword.operator.zin"
        }
      ]
    }
  },
  "scopeName": "source.zin"
}
