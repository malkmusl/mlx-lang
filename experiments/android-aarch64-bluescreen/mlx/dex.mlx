// Hand-written minimal, empty `classes.dex`. Straight port of
// experiments/android-aarch64-bluescreen/tool/dex.zig -- see that file for
// the format derivation (dalvik/libdex/DexFile.h). This experiment's
// activity is a pure `android.app.NativeActivity` with no app-specific
// JVM/Dalvik code, so the dex just needs to be a structurally valid, empty
// one: some install-time/package-parsing paths on real devices still
// expect *a* classes.dex to be present even when the manifest already says
// `android:hasCode="false"`.

const std = @import("std")
const hash = @import("./hash.mlx")

pub const Allocator = std.allocator.Allocator
pub const ArrayList = std.array_list.ArrayList

const HEADER_SIZE: u32 = 0x70
const ENDIAN_CONSTANT: u32 = 0x12345678
const TYPE_HEADER_ITEM: u32 = 0x0000
const TYPE_MAP_LIST: u32 = 0x1000

fn w8(buf: ArrayList, offset: u32, value: u32) -> void {
    std.array_list.ArrayList.set(buf, @intCast(usize, offset), @intCast(u8, value & 255))
}
fn w16(buf: ArrayList, offset: u32, value: u32) -> void {
    w8(buf, offset, value)
    w8(buf, offset + 1, value >> 8)
}
fn w32(buf: ArrayList, offset: u32, value: u32) -> void {
    w8(buf, offset, value)
    w8(buf, offset + 1, value >> 8)
    w8(buf, offset + 2, value >> 16)
    w8(buf, offset + 3, value >> 24)
}
fn wBytes(buf: ArrayList, offset: u32, src: []const u8) -> void {
    var i: usize = 0
    while i < src.length {
        w8(buf, offset + @intCast(u32, i), @intCast(u32, src[i]))
        i += 1
    }
}

fn writeMapItem(buf: ArrayList, offset: u32, itemType: u32, size: u32, itemOff: u32) -> void {
    w16(buf, offset, itemType)
    w16(buf, offset + 2, 0) // unused
    w32(buf, offset + 4, size)
    w32(buf, offset + 8, itemOff)
}

pub fn buildEmptyDex(allocator: Allocator) -> ArrayList {
    const mapOff: u32 = HEADER_SIZE
    const mapListSize: u32 = 4 + 2 * 12 // u32 count + 2 * MapItem(12 bytes)
    const fileSize: u32 = HEADER_SIZE + mapListSize

    var buf: ArrayList = std.array_list.ArrayList.init(allocator, @intCast(usize, fileSize))
    buf = std.array_list.ArrayList.resize(buf, @intCast(usize, fileSize), 0)

    wBytes(buf, 0, "dex\n035")
    w8(buf, 7, 0)
    // checksum (bytes[8..12]) and signature (bytes[12..32]) patched at the end.
    w32(buf, 32, fileSize)
    w32(buf, 36, HEADER_SIZE)
    w32(buf, 40, ENDIAN_CONSTANT)
    w32(buf, 44, 0) // link_size
    w32(buf, 48, 0) // link_off
    w32(buf, 52, mapOff) // map_off
    // string/type/proto/field/method/class-def counts+offsets: all zero
    // (bytes 56..103 -- left untouched by the zero-fill above).
    w32(buf, 104, mapListSize) // data_size
    w32(buf, 108, mapOff) // data_off

    var w: u32 = mapOff
    w32(buf, w, 2) // map list: 2 entries
    w += 4
    writeMapItem(buf, w, TYPE_HEADER_ITEM, 1, 0)
    w += 12
    writeMapItem(buf, w, TYPE_MAP_LIST, 1, mapOff)
    w += 12

    // signature = SHA-1(bytes[32..]), checksum = Adler-32(bytes[12..])
    const digest = hash.sha1(buf.items[32..buf.length])
    var i: usize = 0
    while i < 20 {
        std.array_list.ArrayList.set(buf, 12 + i, digest.bytes[i])
        i += 1
    }

    const checksum: u32 = hash.adler32(buf.items[12..buf.length])
    w32(buf, 8, checksum)

    return buf
}
