const std = @import("std")
const asn1 = @import("./asn1.mlx")

fn bytesEqual(list: asn1.ArrayList, want: []const u8) -> bool {
    if list.length != want.length { return false }
    var i: usize = 0
    while i < want.length {
        if list.items[i] != want[i] { return false }
        i += 1
    }
    return true
}

fn report(name: []const u8, ok: bool, failures: *u32, bit: u32) -> void {
    if ok {
        var w: bool = std.io.print(name)
        w = std.io.println(": ok")
    } else {
        var w: bool = std.io.print(name)
        w = std.io.println(": WRONG")
        failures.* = failures.* | bit
    }
}

pub fn main() -> u32 {
    var failures: u32 = 0
    const allocator: std.allocator.Allocator = std.page_allocator.init()

    const rsaEncOid = asn1.oid(allocator, "1.2.840.113549.1.1.1")
    const wantRsaEnc: [11]u8 = [11]u8{0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01}
    report("oid rsaEncryption", bytesEqual(rsaEncOid, wantRsaEnc[0..11]), &failures, 1)

    const sha256WithRsaOid = asn1.oid(allocator, "1.2.840.113549.1.1.11")
    const wantSha256WithRsa: [11]u8 = [11]u8{0x06, 0x09, 0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0b}
    report("oid sha256WithRSAEncryption", bytesEqual(sha256WithRsaOid, wantSha256WithRsa[0..11]), &failures, 2)

    const idSha256Oid = asn1.oid(allocator, "2.16.840.1.101.3.4.2.1")
    const wantIdSha256: [11]u8 = [11]u8{0x06, 0x09, 0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01}
    report("oid id-sha256", bytesEqual(idSha256Oid, wantIdSha256[0..11]), &failures, 4)

    const cnOid = asn1.oid(allocator, "2.5.4.3")
    const wantCn: [5]u8 = [5]u8{0x06, 0x03, 0x55, 0x04, 0x03}
    report("oid commonName", bytesEqual(cnOid, wantCn[0..5]), &failures, 8)

    const padded: [1]u8 = [1]u8{0xff}
    const intPadded = asn1.integerFromUnsignedBE(allocator, padded[0..1])
    const wantPadded: [4]u8 = [4]u8{0x02, 0x02, 0x00, 0xff}
    report("integer DER-pads high-bit-set magnitude", bytesEqual(intPadded, wantPadded[0..4]), &failures, 16)

    var longContent: std.array_list.ArrayList = std.array_list.ArrayList.init(allocator, 200)
    longContent = std.array_list.ArrayList.resize(longContent, 200, 0xab)
    const longTlv = asn1.tlv(allocator, asn1.TAG_OCTET_STRING, longContent.items[0..200])
    var lengthOk: bool = false
    if longTlv.length >= 3 {
        if @intCast(u32, longTlv.items[0]) == asn1.TAG_OCTET_STRING && longTlv.items[1] == 0x81 && longTlv.items[2] == 0xc8 {
            lengthOk = true
        }
    }
    report("long-form length encoding", lengthOk, &failures, 32)

    if failures == 0 {
        var w: bool = std.io.println("ALL ASN1 TESTS PASSED")
    }
    return failures
}
