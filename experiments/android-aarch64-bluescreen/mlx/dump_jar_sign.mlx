const std = @import("std")
const bn = @import("./bignum.mlx")
const js = @import("./jar_sign.mlx")
const zip = @import("./zip.mlx")

fn writeFile(path: []const u8, data: []const u8) -> void {
    const file = std.fs.open(@ptrCast([*]const u8, path), std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
    var ok1: bool = std.fs.writeAllBytes(file, @ptrCast([*]const u8, data), data.length)
    var ok2: bool = std.fs.close(file)
}

pub fn main() -> void {
    const allocator: std.allocator.Allocator = std.page_allocator.init()

    var w0: bool = std.io.println("generating 1024-bit RSA key (512-bit primes)...")
    var n: bn.BigUint = undefined
    var d: bn.BigUint = undefined
    const nBytes: usize = js.generateKeyPair(&n, &d, 1024)
    var w1: bool = std.io.println("key generated")

    const cert = js.buildSelfSignedCert(allocator, &n, &d, nBytes, "mlx-experiment", 1)
    var w2: bool = std.io.println("cert built")
    writeFile("/tmp/mine_cert_mlx.der", cert.items[0..cert.length])

    var entries: zip.EntryList = undefined
    zip.initEntries(&entries)
    zip.addEntry(&entries, "hello.txt", "hello from mlx\n")
    zip.addEntry(&entries, "dir/second.txt", "second entry\n")

    var mf: js.ArrayList = undefined
    var sf: js.ArrayList = undefined
    var rsa: js.ArrayList = undefined
    js.signJar(allocator, &n, &d, nBytes, cert.items[0..cert.length], "mlx-experiment", 1, &entries, &mf, &sf, &rsa)
    var w3: bool = std.io.println("jar signed")

    writeFile("/tmp/mine_MANIFEST_mlx.MF", mf.items[0..mf.length])
    writeFile("/tmp/mine_CERT_mlx.SF", sf.items[0..sf.length])
    writeFile("/tmp/mine_CERT_mlx.RSA", rsa.items[0..rsa.length])

    var fullEntries: zip.EntryList = undefined
    zip.initEntries(&fullEntries)
    zip.addEntry(&fullEntries, "hello.txt", "hello from mlx\n")
    zip.addEntry(&fullEntries, "dir/second.txt", "second entry\n")
    zip.addEntry(&fullEntries, "META-INF/MANIFEST.MF", mf.items[0..mf.length])
    zip.addEntry(&fullEntries, "META-INF/CERT.SF", sf.items[0..sf.length])
    zip.addEntry(&fullEntries, "META-INF/CERT.RSA", rsa.items[0..rsa.length])

    const apk = zip.build(allocator, &fullEntries)
    writeFile("/tmp/mine_signed_mlx.apk", apk.items[0..apk.length])
    var w4: bool = std.io.println("wrote /tmp/mine_signed_mlx.apk")
}
