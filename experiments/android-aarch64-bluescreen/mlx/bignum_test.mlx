const std = @import("std")
const bn = @import("./bignum.mlx")

fn bytesEqual(list: bn.ArrayList, want: []const u8) -> bool {
    if list.length != want.length { return false }
    var i: usize = 0
    while i < want.length {
        if list.items[i] != want[i] { return false }
        i += 1
    }
    return true
}

fn report(name: []const u8, ok: bool, failures: *u32, bit: u32) -> void {
    if ok {
        var w: bool = std.io.print(name)
        w = std.io.println(": ok")
    } else {
        var w: bool = std.io.print(name)
        w = std.io.println(": WRONG")
        failures.* = failures.* | bit
    }
}

pub fn main() -> u32 {
    var failures: u32 = 0
    const allocator: std.allocator.Allocator = std.page_allocator.init()

    const aBytes: [13]u8 = [13]u8{1, 142, 233, 15, 246, 195, 115, 224, 238, 78, 63, 10, 210}
    const bBytes: [13]u8 = [13]u8{12, 119, 72, 129, 157, 255, 182, 36, 56, 209, 198, 126, 234}

    var a: bn.BigUint = undefined
    bn.fromBytesBE(&a, aBytes[0..13])
    var b: bn.BigUint = undefined
    bn.fromBytesBE(&b, bBytes[0..13])

    // round-trip
    const aOut = bn.toBytesBEMinimal(&a, allocator)
    report("fromBytesBE/toBytesBEMinimal round-trip", bytesEqual(aOut, aBytes[0..13]), &failures, 1)

    // A + B
    var sum: bn.BigUint = undefined
    bn.addTo(&sum, &a, &b)
    const sumOut = bn.toBytesBEMinimal(&sum, allocator)
    const wantSum: [13]u8 = [13]u8{14, 6, 49, 145, 148, 195, 42, 5, 39, 32, 5, 137, 188}
    report("A+B", bytesEqual(sumOut, wantSum[0..13]), &failures, 2)

    // B - A
    var diff: bn.BigUint = undefined
    bn.subTo(&diff, &b, &a)
    const diffOut = bn.toBytesBEMinimal(&diff, allocator)
    // B-A = 864197532086419753208641975320
    var wantDiff: bn.BigUint = undefined
    var expectedDiffBytes: [13]u8 = [13]u8{10, 232, 95, 113, 167, 60, 66, 67, 74, 131, 135, 116, 24}
    bn.fromBytesBE(&wantDiff, expectedDiffBytes[0..13])
    report("B-A", bn.cmp(&diff, &wantDiff) == 0, &failures, 4)

    // A * B
    var prod: bn.BigUint = undefined
    bn.mulTo(&prod, &a, &b)
    const prodOut = bn.toBytesBEMinimal(&prod, allocator)
    if prodOut.length == 25 {
        var w: bool = std.io.println("A*B length: ok")
    } else {
        var w: bool = std.io.println("A*B length: WRONG")
        failures = failures | 8
    }

    // divMod: B / A
    var q: bn.BigUint = undefined
    var r: bn.BigUint = undefined
    bn.divMod(&q, &r, &b, &a)
    const wantQBytes: [1]u8 = [1]u8{8}
    const wantRBytes: [10]u8 = [10]u8{1, 231, 228, 23, 28, 198, 95, 206, 40, 90}
    const qOut = bn.toBytesBEMinimal(&q, allocator)
    const rOut = bn.toBytesBEMinimal(&r, allocator)
    report("B/A quotient", bytesEqual(qOut, wantQBytes[0..1]), &failures, 16)
    report("B/A remainder", bytesEqual(rOut, wantRBytes[0..10]), &failures, 32)

    // modPow: 4^13 mod 497 = 445 (textbook RSA example)
    var base: bn.BigUint = undefined
    bn.setU64(&base, 4)
    var exp: bn.BigUint = undefined
    bn.setU64(&exp, 13)
    var modv: bn.BigUint = undefined
    bn.setU64(&modv, 497)
    var powResult: bn.BigUint = undefined
    bn.modPow(&powResult, &base, &exp, &modv)
    var want445: bn.BigUint = undefined
    bn.setU64(&want445, 445)
    report("modPow(4,13,497)==445", bn.cmp(&powResult, &want445) == 0, &failures, 64)

    // modInverse: e=17, phi=3120 -> d such that e*d mod phi == 1 (RSA textbook example)
    var e: bn.BigUint = undefined
    bn.setU64(&e, 17)
    var phi: bn.BigUint = undefined
    bn.setU64(&phi, 3120)
    var d: bn.BigUint = undefined
    bn.modInverse(&d, &e, &phi)
    var ed: bn.BigUint = undefined
    bn.mulTo(&ed, &e, &d)
    var edq: bn.BigUint = undefined
    var edr: bn.BigUint = undefined
    bn.divMod(&edq, &edr, &ed, &phi)
    var one: bn.BigUint = undefined
    bn.setU64(&one, 1)
    report("modInverse: e*d mod phi == 1", bn.cmp(&edr, &one) == 0, &failures, 128)

    // isProbablePrime: known small primes and composites
    const primes: [6]u64 = [6]u64{2, 3, 5, 7, 97, 7919}
    var primesOk: bool = true
    var pi: usize = 0
    while pi < 6 {
        var pn: bn.BigUint = undefined
        bn.setU64(&pn, primes[pi])
        if !bn.isProbablePrime(&pn, 20) { primesOk = false }
        pi += 1
    }
    report("isProbablePrime: known primes", primesOk, &failures, 256)

    const composites: [5]u64 = [5]u64{4, 9, 15, 100, 7921}
    var compositesOk: bool = true
    var ci: usize = 0
    while ci < 5 {
        var cn: bn.BigUint = undefined
        bn.setU64(&cn, composites[ci])
        if bn.isProbablePrime(&cn, 20) { compositesOk = false }
        ci += 1
    }
    report("isProbablePrime: known composites", compositesOk, &failures, 512)

    if failures == 0 {
        var w: bool = std.io.println("ALL BIGNUM TESTS PASSED")
    }
    return failures
}
