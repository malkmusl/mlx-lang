// Minimal hand-written AArch64 (A64) instruction encoder, written in mlx and
// run by the self-hosted compiler (mlx1/mlx2) -- not Zig. Zig is mlx0's
// bootstrap only; everything downstream of that, including this experiment,
// belongs on the self-hosted toolchain.
//
// This is a straight port of experiments/android-aarch64-bluescreen/tool
// (the earlier Zig prototype), which was itself verified instruction-by-
// instruction against `llvm-mc -show-encoding` -- see that tool's own
// comments and the experiment README for the derivation of every bit
// layout below. All that verification carries over unchanged: the bit
// arithmetic here is identical to the already-checked Zig version, only
// the syntax differs. Deliberately uses only plain u32/u64/i64 (never a
// narrower uN/iN, and never anything wider than u64) -- see
// docs/internals/selfhost-compiler.md's "Known gap: uN/iN wider than 64
// bits are not actually multi-word" for why arithmetic above 64 bits
// cannot be trusted yet on the self-hosted backend; nothing here needs it,
// every instruction word fits in 32 bits.

pub const SP: u32 = 31
pub const XZR: u32 = 31
pub const LR: u32 = 30

// ── MOVZ / MOVK -- move (wide immediate) ──────────────────────────────────
//  31   30-29  28-23    22-21  20-5     4-0
//  sf   opc    100101   hw     imm16    Rd
//  opc: 10 = MOVZ, 11 = MOVK. hw: imm16 is shifted left by (hw * 16).
fn movWide(sf: u32, opc: u32, hw: u32, imm16: u32, rd: u32) -> u32 {
    return (sf << 31) | (opc << 29) | (0b100101 << 23) | (hw << 21) | ((imm16 & 0xffff) << 5) | (rd & 0x1f)
}
pub fn movz32(rd: u32, imm16: u32, hw: u32) -> u32 { return movWide(0, 0b10, hw, imm16, rd) }
pub fn movz64(rd: u32, imm16: u32, hw: u32) -> u32 { return movWide(1, 0b10, hw, imm16, rd) }
pub fn movk32(rd: u32, imm16: u32, hw: u32) -> u32 { return movWide(0, 0b11, hw, imm16, rd) }
pub fn movk64(rd: u32, imm16: u32, hw: u32) -> u32 { return movWide(1, 0b11, hw, imm16, rd) }

// ── ADRP -- form a PC-relative page address ───────────────────────────────
//  31  30-29    28-24   23-5     4-0
//  op  immlo    10000   immhi    Rd
//  op = 1. The 21-bit signed immediate (immhi:immlo) counts 4096-byte pages
//  from the page containing this instruction.
pub fn adrp(rd: u32, pc: u64, target: u64) -> u32 {
    const pc_page: u64 = pc & 0xfffffffffffff000
    const target_page: u64 = target & 0xfffffffffffff000
    var rel_pages: i64 = 0
    if target_page >= pc_page {
        rel_pages = @intCast(i64, (target_page - pc_page) / 4096)
    } else {
        rel_pages = 0 - @intCast(i64, (pc_page - target_page) / 4096)
    }
    // 21-bit two's-complement encoding of rel_pages.
    var imm21: u32 = 0
    if rel_pages >= 0 {
        imm21 = @intCast(u32, rel_pages)
    } else {
        imm21 = @intCast(u32, rel_pages + 2097152)
    }
    const immlo: u32 = imm21 & 0b11
    const immhi: u32 = (imm21 >> 2) & 0x7ffff
    return (1 << 31) | (immlo << 29) | (0b10000 << 24) | (immhi << 5) | (rd & 0x1f)
}

// ── ADD / SUB (immediate) ─────────────────────────────────────────────────
//  31  30  29  28-23    22  21-10   9-5   4-0
//  sf  op  S   100010   sh  imm12   Rn    Rd
//  op = 0 ADD, 1 SUB. Rn/Rd = 31 mean SP in this instruction class.
fn addSubImm(op: u32, rd: u32, rn: u32, imm12: u32) -> u32 {
    return (1 << 31) | (op << 30) | (0b100010 << 23) | ((imm12 & 0xfff) << 10) | ((rn & 0x1f) << 5) | (rd & 0x1f)
}
pub fn addImm64(rd: u32, rn: u32, imm12: u32) -> u32 { return addSubImm(0, rd, rn, imm12) }
pub fn subImm64(rd: u32, rn: u32, imm12: u32) -> u32 { return addSubImm(1, rd, rn, imm12) }

// ── LDR / STR (immediate, unsigned offset) ────────────────────────────────
//  31-30  29-27  26  25-24  23-22  21-10   9-5   4-0
//  size   111    V   01     opc    imm12   Rn    Rt
//  size: 10 = 32-bit (W), 11 = 64-bit (X). opc: 00 = STR, 01 = LDR.
//  imm12 is an element count, scaled by the access size (4 or 8 bytes).
fn ldStImm(size: u32, opc: u32, rt: u32, rn: u32, byte_offset: u32) -> u32 {
    var scale: u32 = 4
    if size == 0b11 { scale = 8 }
    const imm12: u32 = byte_offset / scale
    return (size << 30) | (0b111 << 27) | (0b01 << 24) | (opc << 22) | ((imm12 & 0xfff) << 10) | ((rn & 0x1f) << 5) | (rt & 0x1f)
}
pub fn ldrW(rt: u32, rn: u32, byte_offset: u32) -> u32 { return ldStImm(0b10, 0b01, rt, rn, byte_offset) }
pub fn ldrX(rt: u32, rn: u32, byte_offset: u32) -> u32 { return ldStImm(0b11, 0b01, rt, rn, byte_offset) }
pub fn strW(rt: u32, rn: u32, byte_offset: u32) -> u32 { return ldStImm(0b10, 0b00, rt, rn, byte_offset) }
pub fn strX(rt: u32, rn: u32, byte_offset: u32) -> u32 { return ldStImm(0b11, 0b00, rt, rn, byte_offset) }

// ── STR (immediate, post-index) -- "STR Wt, [Xn], #simm" ─────────────────
//  31-30  29-27  26  25-24  23-22  21  20-12   11-10  9-5   4-0
//  size   111    V   00     opc    0   imm9    01     Rn    Rt
pub fn strwPostIndex(rt: u32, rn: u32, simm9: i32) -> u32 {
    var imm9: u32 = 0
    if simm9 >= 0 {
        imm9 = @intCast(u32, simm9)
    } else {
        imm9 = @intCast(u32, simm9 + 512)
    }
    return (0b10 << 30) | (0b111 << 27) | (0b00 << 24) | (0b00 << 22) | ((imm9 & 0x1ff) << 12) | (0b01 << 10) | ((rn & 0x1f) << 5) | (rt & 0x1f)
}

// ── MUL (alias of MADD Xd, Xn, Xm, XZR) ───────────────────────────────────
//  31  30  29  28-24    23-21  20-16  15  14-10  9-5   4-0
//  sf  0   0   11011    000    Rm     0   Ra     Rn    Rd
pub fn mul64(rd: u32, rn: u32, rm: u32) -> u32 {
    return (1 << 31) | (0b11011 << 24) | ((rm & 0x1f) << 16) | (XZR << 10) | ((rn & 0x1f) << 5) | (rd & 0x1f)
}

// ── CBZ / CBNZ -- compare and branch on (non)zero ─────────────────────────
//  31   30-25    24  23-5     4-0
//  sf   011010   op  imm19    Rt
//  imm19 is a signed word (4-byte) offset from this instruction to target.
fn cmpBranch(sf: u32, op: u32, rt: u32, byte_delta: i32) -> u32 {
    const word_delta: i32 = byte_delta / 4
    var imm19: u32 = 0
    if word_delta >= 0 {
        imm19 = @intCast(u32, word_delta)
    } else {
        imm19 = @intCast(u32, word_delta + 524288)
    }
    return (sf << 31) | (0b011010 << 25) | (op << 24) | ((imm19 & 0x7ffff) << 5) | (rt & 0x1f)
}
pub fn cbzX(rt: u32, byte_delta: i32) -> u32 { return cmpBranch(1, 0, rt, byte_delta) }
pub fn cbnzX(rt: u32, byte_delta: i32) -> u32 { return cmpBranch(1, 1, rt, byte_delta) }
pub fn cbzW(rt: u32, byte_delta: i32) -> u32 { return cmpBranch(0, 0, rt, byte_delta) }
pub fn cbnzW(rt: u32, byte_delta: i32) -> u32 { return cmpBranch(0, 1, rt, byte_delta) }

// ── Unconditional branch (register) -- BR / BLR / RET ─────────────────────
// Fixed hex bases (stable, well-known A64 encodings):
//   BR Xn = 0xD61F0000 | (Rn<<5); BLR Xn = 0xD63F0000 | (Rn<<5);
//   RET Xn = 0xD65F0000 | (Rn<<5) (Rn defaults to X30/LR).
pub fn br(rn: u32) -> u32 { return 0xD61F0000 | ((rn & 0x1f) << 5) }
pub fn blr(rn: u32) -> u32 { return 0xD63F0000 | ((rn & 0x1f) << 5) }
pub fn ret(rn: u32) -> u32 { return 0xD65F0000 | ((rn & 0x1f) << 5) }

// ── UDF -- permanently undefined instruction, always raises SIGILL ────────
//  31-16       15-0
//  0000000000000000  imm16
// Used purely as a deliberate, distinctly-located debugging trap (not part
// of the intended program logic): a `udf #0` at a known, unique address
// lets a real-device crash tombstone's faulting PC be matched back to
// exactly which call site failed, when there is no adb/logcat access to
// find that out any other way.
pub fn udf(imm16: u32) -> u32 { return imm16 & 0xffff }

// ── MOV (register) -- alias of ORR Xd, XZR, Xm (Logical, shifted register) ─
//  31  30-29  28-24    23-22  21  20-16  15-10  9-5   4-0
//  sf  opc    01010    shift  N   Rm     imm6   Rn    Rd
//  opc = 01 (ORR), shift = 00, N = 0, Rn = 31 (XZR here, not SP).
pub fn movReg64(rd: u32, rm: u32) -> u32 {
    return (1 << 31) | (0b01 << 29) | (0b01010 << 24) | ((rm & 0x1f) << 16) | (XZR << 5) | (rd & 0x1f)
}
