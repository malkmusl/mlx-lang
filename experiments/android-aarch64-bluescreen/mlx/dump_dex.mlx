const std = @import("std")
const dex = @import("./dex.mlx")

pub fn main() -> void {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const buf = dex.buildEmptyDex(allocator)

    const file = std.fs.open(@ptrCast([*]const u8, "/tmp/mine_classes_mlx.dex"), std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
    if !std.fs.writeAllBytes(file, @ptrCast([*]const u8, buf.items[0..buf.length]), buf.length) { return }
    if !std.fs.close(file) { return }
    if !std.io.println("wrote /tmp/mine_classes_mlx.dex") { return }
}
