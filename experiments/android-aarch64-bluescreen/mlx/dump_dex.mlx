const std = @import("std")
const dex = @import("./dex.mlx")

pub fn main() -> void {
    const allocator: std.allocator.Allocator = std.heap.allocator()
    const buf = dex.buildEmptyDex(allocator)

    const file = std.fs.open("/tmp/mine_classes_mlx.dex".pointer, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
    if !std.fs.writeAllBytes(file, buf.items[0..buf.length].pointer, buf.length) { return }
    if !std.fs.close(file) { return }
    if !std.io.println("wrote /tmp/mine_classes_mlx.dex") { return }
}
