const std = @import("std")
const axml = @import("./axml.mlx")

pub fn main() -> void {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const buf = axml.buildManifest(allocator, "dev.mlxlang.experiments.bluescreen", false, true)

    const file = std.fs.open("/tmp/mine_manifest_mlx.bin".pointer, std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
    if !std.fs.writeAllBytes(file, buf.items[0..buf.length].pointer, buf.length) { return }
    if !std.fs.close(file) { return }
    if !std.io.println("wrote /tmp/mine_manifest_mlx.bin") { return }
}
