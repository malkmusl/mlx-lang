const std = @import("std")
const axml = @import("./axml.mlx")

pub fn main() -> void {
    const allocator: std.allocator.Allocator = std.page_allocator.init()
    const buf = axml.buildManifest(allocator, "dev.mlxlang.experiments.bluescreen", false)

    const file = std.fs.open(@ptrCast([*]const u8, "/tmp/mine_manifest_mlx.bin"), std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
    if !std.fs.writeAllBytes(file, @ptrCast([*]const u8, buf.items[0..buf.length]), buf.length) { return }
    if !std.fs.close(file) { return }
    if !std.io.println("wrote /tmp/mine_manifest_mlx.bin") { return }
}
