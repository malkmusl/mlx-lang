// Hand-written ZIP container writer -- an APK *is* a ZIP file (with an
// optional signing block appended, see jar_sign.mlx once it exists). Every
// entry is stored uncompressed (method = 0): no DEFLATE implementation
// needed, and it happens to match how Android itself prefers native
// libraries to be packed (uncompressed + page-aligned, so they can be
// mmap'd directly instead of extracted). Straight port of
// experiments/android-aarch64-bluescreen/tool/zip.zig -- see that file and
// the experiment README for the full format derivation (PKWARE's
// APPNOTE.TXT local/central/EOCD triad).

const std = @import("std")
const hash = @import("./hash.mlx")

pub const Allocator = std.allocator.Allocator
pub const ArrayList = std.array_list.ArrayList

// Parallel-array entry list -- a fixed array of *slices* is a known backend
// miscompile (see axml.mlx's StringPool comment), so entry names/data are
// passed as parallel arrays of raw `usize` (pointer, length) pairs instead
// of an array of `Entry` structs holding slices directly.
pub const MAX_ENTRIES: usize = 8

pub const EntryList = struct {
    namePtrs: [8]usize
    nameLens: [8]usize
    dataPtrs: [8]usize
    dataLens: [8]usize
    count: usize
}

pub fn initEntries(e: *EntryList) -> void {
    e.*.count = 0
}

pub fn addEntry(e: *EntryList, name: []const u8, data: []const u8) -> void {
    const idx: usize = e.*.count
    unsafe {
        e.*.namePtrs[idx] = @intFromPtr(@ptrCast([*]const u8, name))
        e.*.dataPtrs[idx] = @intFromPtr(@ptrCast([*]const u8, data))
    }
    e.*.nameLens[idx] = name.length
    e.*.dataLens[idx] = data.length
    e.*.count += 1
}

// pub: jar_sign.mlx reuses this same EntryList (and these accessors) for
// the set of files a MANIFEST.MF/CERT.SF gets generated over, rather than
// defining its own equivalent parallel-array type.
pub fn nameAt(e: *EntryList, i: usize) -> []const u8 {
    unsafe {
        return @ptrFromInt([*]const u8, e.*.namePtrs[i])[0..e.*.nameLens[i]]
    }
}

pub fn dataAt(e: *EntryList, i: usize) -> []const u8 {
    unsafe {
        return @ptrFromInt([*]const u8, e.*.dataPtrs[i])[0..e.*.dataLens[i]]
    }
}

const LOCAL_SIG: u32 = 0x04034b50
const CENTRAL_SIG: u32 = 0x02014b50
const EOCD_SIG: u32 = 0x06054b50
const DOS_TIME: u32 = 0x0000
const DOS_DATE: u32 = 0x0021 // 1980-01-01 -- the common fixed default

fn appendU8(list: *ArrayList, v: u32) -> void {
    var ok: bool = std.array_list.ArrayList.appendAt(list, @intCast(u8, v & 255))
}
fn appendU16(list: *ArrayList, v: u32) -> void {
    appendU8(list, v)
    appendU8(list, v >> 8)
}
fn appendU32(list: *ArrayList, v: u32) -> void {
    appendU8(list, v)
    appendU8(list, v >> 8)
    appendU8(list, v >> 16)
    appendU8(list, v >> 24)
}
fn appendSlice(list: *ArrayList, src: []const u8) -> void {
    var i: usize = 0
    while i < src.length {
        var ok: bool = std.array_list.ArrayList.appendAt(list, src[i])
        i += 1
    }
}

pub fn build(allocator: Allocator, entries: *EntryList) -> ArrayList {
    var out: ArrayList = std.array_list.ArrayList.init(allocator, 4096)

    var offsets: [8]u32 = [8]u32{0, 0, 0, 0, 0, 0, 0, 0}
    var crcs: [8]u32 = [8]u32{0, 0, 0, 0, 0, 0, 0, 0}

    var i: usize = 0
    while i < entries.*.count {
        const name = nameAt(entries, i)
        const data = dataAt(entries, i)
        const crc: u32 = hash.crc32(data)
        offsets[i] = @intCast(u32, out.length)
        crcs[i] = crc
        appendU32(&out, LOCAL_SIG)
        appendU16(&out, 20) // version needed
        appendU16(&out, 0) // flags
        appendU16(&out, 0) // method: stored
        appendU16(&out, DOS_TIME)
        appendU16(&out, DOS_DATE)
        appendU32(&out, crc)
        appendU32(&out, @intCast(u32, data.length)) // compressed size
        appendU32(&out, @intCast(u32, data.length)) // uncompressed size
        appendU16(&out, @intCast(u32, name.length))
        appendU16(&out, 0) // extra length
        appendSlice(&out, name)
        appendSlice(&out, data)
        i += 1
    }

    const cdStart: u32 = @intCast(u32, out.length)
    i = 0
    while i < entries.*.count {
        const name = nameAt(entries, i)
        const data = dataAt(entries, i)
        appendU32(&out, CENTRAL_SIG)
        appendU16(&out, 20) // version made by
        appendU16(&out, 20) // version needed
        appendU16(&out, 0) // flags
        appendU16(&out, 0) // method
        appendU16(&out, DOS_TIME)
        appendU16(&out, DOS_DATE)
        appendU32(&out, crcs[i])
        appendU32(&out, @intCast(u32, data.length))
        appendU32(&out, @intCast(u32, data.length))
        appendU16(&out, @intCast(u32, name.length))
        appendU16(&out, 0) // extra length
        appendU16(&out, 0) // comment length
        appendU16(&out, 0) // disk number start
        appendU16(&out, 0) // internal attrs
        appendU32(&out, 0) // external attrs
        appendU32(&out, offsets[i])
        appendSlice(&out, name)
        i += 1
    }
    const cdSize: u32 = @intCast(u32, out.length) - cdStart

    appendU32(&out, EOCD_SIG)
    appendU16(&out, 0) // disk number
    appendU16(&out, 0) // disk with cd
    appendU16(&out, @intCast(u32, entries.*.count))
    appendU16(&out, @intCast(u32, entries.*.count))
    appendU32(&out, cdSize)
    appendU32(&out, cdStart)
    appendU16(&out, 0) // comment length

    return out
}
