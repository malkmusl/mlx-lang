const std = @import("std")
const hash = @import("./hash.mlx")

fn hexDigit(v: u8) -> u8 {
    if v < 10 { return 48 + v }
    return 87 + v
}

fn printHexU32(v: u32) -> void {
    var i: i32 = 7
    while i >= 0 {
        const shift: u32 = @intCast(u32, i) * 4
        const nibble: u8 = @intCast(u8, (v >> shift) & 15)
        const c: u8 = hexDigit(nibble)
        unsafe {
            var buf: [1]u8 = [1]u8{c}
            var ok: bool = std.io.writeAll(std.io.stdout(), buf[0..1])
        }
        i -= 1
    }
}

fn printHexBytes(bytes: []const u8) -> void {
    var i: usize = 0
    while i < bytes.length {
        const b: u8 = bytes[i]
        const hi: u8 = hexDigit(@intCast(u8, (b >> 4) & 15))
        const lo: u8 = hexDigit(@intCast(u8, b & 15))
        unsafe {
            var buf: [2]u8 = [2]u8{hi, lo}
            var ok: bool = std.io.writeAll(std.io.stdout(), buf[0..2])
        }
        i += 1
    }
}

pub fn main() -> u8 {
    var failures: u8 = 0

    const crcEmpty: u32 = hash.crc32("")
    if crcEmpty != 0 { failures |= 1 }
    if !std.io.print("crc32(\"\") = ") { return 255 }
    printHexU32(crcEmpty)
    if !std.io.println("") { return 255 }

    const crcCheck: u32 = hash.crc32("123456789")
    if crcCheck != 3421780262 { failures |= 2 } // 0xCBF43926
    if !std.io.print("crc32(\"123456789\") = ") { return 255 }
    printHexU32(crcCheck)
    if !std.io.println(" (want cbf43926)") { return 255 }

    const adlerEmpty: u32 = hash.adler32("")
    if adlerEmpty != 1 { failures |= 4 }

    const adlerA: u32 = hash.adler32("a")
    if adlerA != 6422626 { failures |= 8 } // 0x00620062
    if !std.io.print("adler32(\"a\") = ") { return 255 }
    printHexU32(adlerA)
    if !std.io.println(" (want 620062)") { return 255 }

    const digest = hash.sha1("abc")
    if !std.io.print("sha1(\"abc\") = ") { return 255 }
    printHexBytes(digest.bytes[0..20])
    if !std.io.println(" (want a9993e364706816aba3e25717850c26c9cd0d89d)") { return 255 }

    const want: [20]u8 = [20]u8{
        0xa9, 0x99, 0x3e, 0x36, 0x47, 0x06, 0x81, 0x6a, 0xba, 0x3e,
        0x25, 0x71, 0x78, 0x50, 0xc2, 0x6c, 0x9c, 0xd0, 0xd8, 0x9d,
    }
    var j: usize = 0
    while j < 20 {
        if digest.bytes[j] != want[j] { failures |= 16 }
        j += 1
    }

    // Second (NIST) vector, long enough to force the two-block padding path.
    const digest2 = hash.sha1("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    if !std.io.print("sha1(long) = ") { return 255 }
    printHexBytes(digest2.bytes[0..20])
    if !std.io.println(" (want 84983e441c3bd26ebaae4aa1f95129e5e54670f1)") { return 255 }
    const want2: [20]u8 = [20]u8{
        0x84, 0x98, 0x3e, 0x44, 0x1c, 0x3b, 0xd2, 0x6e, 0xba, 0xae,
        0x4a, 0xa1, 0xf9, 0x51, 0x29, 0xe5, 0xe5, 0x46, 0x70, 0xf1,
    }
    var k: usize = 0
    while k < 20 {
        if digest2.bytes[k] != want2[k] { failures |= 32 }
        k += 1
    }

    if failures == 0 {
        if !std.io.println("ALL HASH TESTS PASSED") { return 255 }
    }
    return failures
}
