const std = @import("std")
const zip = @import("./zip.mlx")

pub fn main() -> void {
    const allocator: std.allocator.Allocator = std.page_allocator.init()

    var entries: zip.EntryList = undefined
    zip.initEntries(&entries)
    zip.addEntry(&entries, "a.txt", "hello")
    // mlx string literals only support \n \r \t \0 escapes, not \xNN, so
    // arbitrary binary test data is built as a byte array instead.
    const binBytes: [4]u8 = [4]u8{0, 1, 2, 3}
    zip.addEntry(&entries, "dir/b.bin", binBytes[0..4])

    const buf = zip.build(allocator, &entries)

    const file = std.fs.open(@ptrCast([*]const u8, "/tmp/mine_test_mlx.zip"), std.fs.WRITE_ONLY | std.fs.CREATE | std.fs.TRUNCATE, 420)
    if !std.fs.writeAllBytes(file, @ptrCast([*]const u8, buf.items[0..buf.length]), buf.length) { return }
    if !std.fs.close(file) { return }
    if !std.io.println("wrote /tmp/mine_test_mlx.zip") { return }
}
