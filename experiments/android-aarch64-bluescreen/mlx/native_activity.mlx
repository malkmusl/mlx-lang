// Generates the machine code for a minimal Android `ANativeActivity` shared
// library that fills its window with solid blue. Straight port of
// experiments/android-aarch64-bluescreen/tool/native_activity.zig; the ABI
// notes (struct layouts, why they're hand-transcribed instead of taken from
// real NDK headers, and the biggest-risk callout) live there and in the
// experiment README -- unchanged by this port, so not repeated here.
//
// Pixel format: WINDOW_FORMAT_RGBA_8888 stores bytes R,G,B,A per pixel;
// read as a little-endian u32 that is 0xAABBGGRR. Opaque blue is 0xFFFF0000.

const a64 = @import("./aarch64.mlx")

// `struct ANativeActivityCallbacks` (android/native_activity.h): onStart=0,
// onResume=8, onSaveInstanceState=16, onPause=24, onStop=32, onDestroy=40,
// onWindowFocusChanged=48, onNativeWindowCreated=56, onNativeWindowResized
// =64, onNativeWindowRedrawNeeded=72, onNativeWindowDestroyed=80,
// onInputQueueCreated=88, onInputQueueDestroyed=96 -- unchanged from the
// struct layout this whole file's header comment already documents.
pub const CB_OFFSET_ON_SAVE_INSTANCE_STATE: u32 = 16
pub const CB_OFFSET_ON_NATIVE_WINDOW_CREATED: u32 = 56
pub const CB_OFFSET_ON_NATIVE_WINDOW_RESIZED: u32 = 64
pub const CB_OFFSET_ON_NATIVE_WINDOW_REDRAW_NEEDED: u32 = 72
pub const CB_OFFSET_ON_NATIVE_WINDOW_DESTROYED: u32 = 80
pub const CB_OFFSET_ON_INPUT_QUEUE_CREATED: u32 = 88
pub const CB_OFFSET_ON_INPUT_QUEUE_DESTROYED: u32 = 96
pub const ACTIVITY_OFFSET_CALLBACKS: u32 = 0
// `struct ANativeActivity { void* callbacks; JavaVM* vm; JNIEnv* env;
// jobject clazz; ... }` (android/native_activity.h) -- needed now that
// fixDisplayCutoutMode below makes this experiment's first-ever JNI calls.
pub const ACTIVITY_OFFSET_ENV: u32 = 16
pub const ACTIVITY_OFFSET_CLAZZ: u32 = 24

pub const BLUE_RGBA8888_LE: u32 = 0xFFFF0000
pub const RED_RGBA8888_LE: u32 = 0xFF0000FF
pub const GREEN_RGBA8888_LE: u32 = 0xFF00FF00
pub const YELLOW_RGBA8888_LE: u32 = 0xFF00FFFF
pub const MAGENTA_RGBA8888_LE: u32 = 0xFFFF00FF
pub const CYAN_RGBA8888_LE: u32 = 0xFFFFFF00
pub const ORANGE_RGBA8888_LE: u32 = 0xFF0080FF
pub const WINDOW_FORMAT_RGBA_8888: u32 = 1

// What the last completed touch was recognized as. Stored in g_colorIndex
// (kept across rotation via onSaveInstanceState) and mapped to the fill
// color by colorForIndex.
pub const KIND_NONE: u32 = 0 // blue
pub const KIND_TAP: u32 = 1 // green
pub const KIND_LONG_PRESS: u32 = 2 // yellow
pub const KIND_SWIPE_RIGHT: u32 = 3 // red
pub const KIND_SWIPE_LEFT: u32 = 4 // magenta
pub const KIND_SWIPE_DOWN: u32 = 5 // cyan
pub const KIND_SWIPE_UP: u32 = 6 // orange
pub const KIND_MAX: u32 = 6

// A touch that stays within this many pixels of where it went down (on
// both axes) is a tap or long press; beyond it, a swipe. ~8dp at the test
// device's density, matching Android's own default touch slop there; fixed
// in pixels because reading the real density needs AConfiguration.
pub const TOUCH_SLOP_PX: u32 = 24
// Held still this long (500 ms, in ns) = long press.
pub const LONG_PRESS_NS_LO: u32 = 0x6500
pub const LONG_PRESS_NS_HI: u32 = 0x1DCD

// ALooper idents. Irrelevant beyond being >= 0: both registrations supply a
// callback, so the looper calls it instead of returning the ident from
// ALooper_pollOnce.
pub const LOOPER_IDENT_INPUT: u32 = 1
pub const LOOPER_IDENT_TIMER: u32 = 2
pub const ALOOPER_EVENT_INPUT: u32 = 1

// android/log.h priority for __android_log_print; logcat tag is "mlx".
pub const ANDROID_LOG_INFO: u32 = 4

// timerfd_create(CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC). The flag
// values are O_NONBLOCK (0x800) and O_CLOEXEC (0x80000) on arm64 Linux.
pub const CLOCK_MONOTONIC: u32 = 1
pub const TFD_FLAGS_LO: u32 = 0x0800
pub const TFD_FLAGS_HI: u32 = 0x0008

// android/input.h. The action is masked to its low byte
// (AMOTION_EVENT_ACTION_MASK) before comparing, which strips the pointer
// index bits multi-touch actions carry.
pub const AINPUT_EVENT_TYPE_MOTION: u32 = 2
pub const AMOTION_EVENT_ACTION_DOWN: u32 = 0
pub const AMOTION_EVENT_ACTION_UP: u32 = 1
pub const AMOTION_EVENT_ACTION_MOVE: u32 = 2
pub const AMOTION_EVENT_ACTION_CANCEL: u32 = 3
pub const AMOTION_EVENT_ACTION_POINTER_DOWN: u32 = 5

// JNI function-table (`JNINativeInterface`) byte offsets -- ground-truthed
// against the real JNI spec (stable since JNI 1.2, unchanged since; cross-
// checked against both Oracle's own JNI Functions reference and a fetched
// real AOSP jni.h, not trusted from memory alone). Every `JNIEnv*` is a
// `JNINativeInterface**`, so calling any JNI function is
// `functable = *env; fn = functable[INDEX]; fn(env, ...)` -- see
// emitJniCall. Each index below is its position in the table (0-based)
// times 8 (pointer size): FindClass=6, GetMethodID=33,
// CallObjectMethod=34, CallVoidMethod=61, GetFieldID=94, SetIntField=109.
pub const JNI_FIND_CLASS: u32 = 48
pub const JNI_GET_METHOD_ID: u32 = 264
pub const JNI_CALL_OBJECT_METHOD: u32 = 272
pub const JNI_CALL_VOID_METHOD: u32 = 488
pub const JNI_GET_FIELD_ID: u32 = 752
pub const JNI_SET_INT_FIELD: u32 = 872
// ExceptionClear=17 (index*8=136). A NULL result from FindClass/
// GetMethodID/GetFieldID always means an exception is now pending on this
// JNIEnv -- and per the JNI spec, calling almost any other JNI function
// while an exception is pending is undefined behavior; ART's real,
// observed behavior for that is a fatal abort of the whole process, not a
// contained failure. fixDisplayCutoutMode's first version below didn't
// check any of this and likely explains a real-device instant crash: no
// class/method/field name typo needs to exist for a legitimate reason to
// fail (a stricter classloader, a hidden-API policy change on some OS
// build) and the very next JNI call would then abort the app. Every
// handle this function depends on later is now null-checked immediately,
// bailing out to a shared epilogue that clears any pending exception
// before returning, so a failure here degrades to "cutout fix skipped"
// instead of "app doesn't start".
pub const JNI_EXCEPTION_CLEAR: u32 = 136

// WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES,
// ground-truthed against the real Android developer docs (not memorized):
// "the window is always allowed to extend into the DisplayCutout areas on
// the short edges of the screen" -- in every orientation, which is exactly
// what fixDisplayCutoutMode below needs.
pub const LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES: u32 = 1

// Byte offsets within this experiment's own small writable `.data` block
// (see elf_so.mlx's `dataVaddr`) for its mutable app state -- never
// touched by the dynamic linker (unlike `.got`), only read/written by our
// own code below.
// u64 (not u32) purely so `dataVaddr + DATA_OFFSET_*` type-checks without a
// cast at every use site below -- each one is still just a small byte
// offset, added to `dataVaddr: u64`.
pub const DATA_OFFSET_CURRENT_COLOR: u64 = 0 // u32 field: the paint handler's fill color
pub const DATA_OFFSET_COLOR_INDEX: u64 = 4 // u32 field: last recognized KIND_*
pub const DATA_OFFSET_WINDOW: u64 = 8 // u64 field: current ANativeWindow*, NULL once destroyed
pub const DATA_OFFSET_ACTIVITY: u64 = 16 // u64 field: the ANativeActivity* from onCreate
pub const DATA_OFFSET_DOWN_TIME: u64 = 24 // i64 field: ACTION_DOWN event time (ns)
pub const DATA_OFFSET_DOWN_X: u64 = 32 // i32 field: ACTION_DOWN x (px)
pub const DATA_OFFSET_DOWN_Y: u64 = 36 // i32 field: ACTION_DOWN y (px)
pub const DATA_OFFSET_TRACKING: u64 = 40 // u32 bool: a single-finger touch is in progress
pub const DATA_OFFSET_MOVED: u64 = 44 // u32 bool: it has left the touch slop
pub const DATA_OFFSET_LONG_FIRED: u64 = 48 // u32 bool: the long-press timer already recognized it
pub const DATA_OFFSET_TIMER_FD_PLUS_1: u64 = 52 // u32: long-press timerfd + 1, 0 = none
pub const DATA_SIZE: u64 = 56

// Fixed-size instruction/data buffer: the function bodies below are a
// fixed, hand-written sequence, so a plain array avoids needing a
// growable-vector abstraction for this module. Words past `count` are
// never read, so the array needn't be zeroed.
pub const MAX_WORDS: usize = 1024

pub const Builder = struct {
    words: [1024]u32
    count: usize
}

pub const GotLayout = struct {
    setBuffersGeometry: u64
    lock: u64
    unlockAndPost: u64
    looperForThread: u64
    inputQueueAttachLooper: u64
    inputQueueGetEvent: u64
    inputQueueFinishEvent: u64
    inputEventGetType: u64
    motionEventGetAction: u64
    inputQueueDetachLooper: u64
    malloc: u64
    motionEventGetX: u64
    motionEventGetY: u64
    motionEventGetEventTime: u64
    looperAddFd: u64
    timerfdCreate: u64
    timerfdSettime: u64
    read: u64
    logPrint: u64
}

fn newBuilder() -> Builder {
    var b: Builder = undefined
    b.count = 0
    return b
}

fn emit(b: *Builder, word: u32) -> void {
    b.*.words[b.*.count] = word
    b.*.count += 1
}

// ADRP + ADD idiom: put the absolute address of `target` (anywhere in our
// own image) into `reg`, PC-relative, no relocation needed.
fn emitAdrpAdd(b: *Builder, text_vaddr: u64, reg: u32, target: u64) -> void {
    const pc: u64 = text_vaddr + @intCast(u64, b.*.count) * 4
    emit(b, a64.adrp(reg, pc, target))
    emit(b, a64.addImm64(reg, reg, @intCast(u32, target & 4095)))
}

// ADRP + LDR + BLR idiom: call an imported function through its GOT slot
// (filled in by the dynamic linker's R_AARCH64_GLOB_DAT relocations before
// our code ever runs -- see elf_so.mlx).
fn emitGotCall(b: *Builder, text_vaddr: u64, scratch: u32, gotSlotVaddr: u64) -> void {
    const pc: u64 = text_vaddr + @intCast(u64, b.*.count) * 4
    emit(b, a64.adrp(scratch, pc, gotSlotVaddr))
    emit(b, a64.ldrX(scratch, scratch, @intCast(u32, gotSlotVaddr & 4095)))
    emit(b, a64.blr(scratch))
}

// Direct call to one of our own functions whose address is already known.
// x16 (IP0, the AAPCS64 intra-procedure scratch register) holds the
// address, so no argument register is disturbed.
fn emitDirectCall(b: *Builder, text_vaddr: u64, target: u64) -> void {
    emitAdrpAdd(b, text_vaddr, 16, target)
    emit(b, a64.blr(16))
}

// A direct call whose target isn't emitted yet: two placeholder words for
// the ADRP+ADD, then the BLR. Returns the placeholder index for
// patchDirectCall once the target's address is known.
fn emitDirectCallPlaceholder(b: *Builder) -> usize {
    const idx: usize = b.*.count
    emit(b, 0)
    emit(b, 0)
    emit(b, a64.blr(16))
    return idx
}

fn patchDirectCall(b: *Builder, text_vaddr: u64, idx: usize, target: u64) -> void {
    const pc: u64 = text_vaddr + @intCast(u64, idx) * 4
    b.*.words[idx] = a64.adrp(16, pc, target)
    b.*.words[idx + 1] = a64.addImm64(16, 16, @intCast(u32, target & 4095))
}

// __android_log_print(ANDROID_LOG_INFO, tag, fmt, ...): the caller loads the
// format's arguments into x3.. first; this sets x0-x2 and calls through the
// GOT (x9 scratch). Variadic arguments go in registers like any others on
// Android's AArch64 ABI.
fn emitLog(b: *Builder, text_vaddr: u64, logPrintSlot: u64, tagVaddr: u64, fmtVaddr: u64) -> void {
    emit(b, a64.movz32(0, ANDROID_LOG_INFO, 0))
    emitAdrpAdd(b, text_vaddr, 1, tagVaddr)
    emitAdrpAdd(b, text_vaddr, 2, fmtVaddr)
    emitGotCall(b, text_vaddr, 9, logPrintSlot)
}

// Branch-offset helper: byte delta from instruction index `from` to `to`.
fn delta(from: usize, to: usize) -> i32 {
    return (@intCast(i32, to) - @intCast(i32, from)) * 4
}

// A .data field offset as the u32 byte offset LDR/STR take.
fn off(x: u64) -> u32 {
    return @intCast(u32, x)
}

// JNI calling idiom, used only by fixDisplayCutoutMode: given `env`
// (JNIEnv*) already loaded into x0 and any other real arguments already
// loaded into x1.. per the target JNI function's signature, calls through
// the JNI function table. `env` is a `JNINativeInterface**`, so reaching
// any JNI function needs two dereferences: one to get the table, one --
// at `offset`, one of the JNI_* byte offsets above -- to get the actual
// function pointer. Uses x9 as scratch (never x0/x1/x2/x3, which may hold
// live call arguments) so it never clobbers the arguments the caller just
// set up; every JNI function's first parameter is `env` itself, so x0
// must already hold it going in and this helper leaves it untouched.
fn emitJniCall(b: *Builder, offset: u32) -> void {
    emit(b, a64.ldrX(9, 0, 0)) // x9 = *env (the JNINativeInterface* function table)
    emit(b, a64.ldrX(9, 9, offset)) // x9 = functable[offset] (the actual function pointer)
    emit(b, a64.blr(9))
}

// Packs `s` plus a NUL terminator into `b` as raw data words -- never
// executed, just readable bytes living in the same R+X `.text` segment as
// every instruction here (harmless: nothing ever branches into it, and
// AArch64 doesn't care that non-instruction bytes sit in an executable
// page unless something actually tries to run them as code). Returns the
// vaddr the string starts at, for the caller to hand to emitAdrpAdd the
// same way any function address in this file already is.
fn emitCString(b: *Builder, text_vaddr: u64, s: []const u8) -> u64 {
    const startVaddr: u64 = text_vaddr + @intCast(u64, b.*.count) * 4
    var i: usize = 0
    while i < s.length {
        var word: u32 = 0
        var j: u32 = 0
        while j < 4 {
            var byteVal: u32 = 0
            if i + @intCast(usize, j) < s.length {
                byteVal = @intCast(u32, s[i + @intCast(usize, j)])
            }
            word = word | (byteVal << (j * 8))
            j += 1
        }
        emit(b, word)
        i += 4
    }
    // The loop above already zero-pads (hence NUL-terminates) any partial
    // final word, but a length that's an exact multiple of 4 needs one
    // more all-zero word for the terminator.
    if s.length % 4 == 0 {
        emit(b, 0)
    }
    return startVaddr
}

// Build the full .text machine code: `ANativeActivity_onCreate` immediately
// followed by `onNativeWindowCreated`. Call once with all-zero addresses to
// discover the size (`result.count * 4`), then call again with the real,
// final virtual addresses once the surrounding ELF layout is known -- the
// instruction sequence is identical both times, only the embedded address
// immediates differ, so the word count is stable across both calls.
pub fn buildText(textVaddr: u64, got: GotLayout, dataVaddr: u64) -> Builder {
    var b: Builder = newBuilder()

    // -- ANativeActivity_onCreate(x0=activity, x1=savedState, x2=savedStateSize) --
    //
    // Root cause, found after an 8-round real-device diagnostic campaign
    // (crash-address leaks, an AOSP source cross-check of every struct
    // offset used here -- all correct -- and finally fetching the actual
    // JNI glue, frameworks/base/core/jni/android_app_NativeActivity.cpp):
    // `onSurfaceCreated_native` there checks
    // `code->callbacks.onNativeWindowCreated != NULL`, reading through
    // `activity->callbacks` as a pointer the FRAMEWORK already allocated
    // and pre-populated (as part of its own internal NativeCode object)
    // *before* calling our onCreate. The contract is to write INTO the
    // ANativeActivityCallbacks struct the framework already points us at
    // (`activity->callbacks->onNativeWindowCreated = ...`), not to
    // allocate our own separate struct and replace the pointer
    // (`activity->callbacks = &ourOwnStruct`) -- the latter (what this
    // code used to do) leaves the framework's own internal storage
    // untouched and all-NULL, so its guard silently never fires the
    // callback. No crash, no error, no visible effect at all -- which
    // matches everything observed on-device across every earlier round.
    //
    // Now non-leaf (it calls fixDisplayCutoutMode via BLR near the end),
    // so -- per the same LR-preservation rule the paint handler below
    // documents, and got wrong once before there -- it must save its own
    // incoming LR before that call and restore it before its own `ret`,
    // even though nothing before this round ever touched LR here.
    emit(&b, a64.subImm64(a64.SP, a64.SP, 16))
    emit(&b, a64.strX(a64.LR, a64.SP, 0)) // save LR

    // Cache `activity` itself into this experiment's small `.data` block
    // (see elf_so.mlx's `dataVaddr`): g_activity lets fixDisplayCutoutMode
    // (called at the end of this function) and a later touch event
    // (drainInputEvents) reach the JNI env/clazz and repaint without
    // either being threaded through as an extra parameter.
    emitAdrpAdd(&b, textVaddr, 10, dataVaddr + DATA_OFFSET_ACTIVITY)
    emit(&b, a64.strX(0, 10, 0)) // g_activity = activity (x0, untouched so far)

    // Restore g_colorIndex/g_currentColor across a rotation instead of
    // always resetting to blue -- real-device feedback that a rotation
    // (which, per axml.mlx's configChanges comment, now goes through a
    // full destroy-and-recreate of this activity, not an in-place resize)
    // was silently discarding whatever color a touch had already picked.
    // `savedState`/`savedStateSize` (x1/x2, both still exactly as handed
    // to us -- unused until now) are Android's own standard mechanism for
    // this: `onSaveInstanceState` below hands the framework a small
    // malloc'd buffer before the old instance is destroyed, and the
    // framework passes that same buffer straight back here as
    // (savedState, savedStateSize) on the new instance's onCreate. A
    // fresh process launch (no prior instance to have saved anything) has
    // savedStateSize == 0, in which case this still defaults to blue/index
    // 0 exactly as before.
    const cbzNoSavedStateIdx: usize = b.count
    emit(&b, 0) // if savedStateSize(x2) == 0, goto useDefaultIndex (patched below)
    emit(&b, a64.ldrW(4, 1, 0)) // w4 = *savedState (the index onSaveInstanceState wrote)
    const bIndexReadyIdx: usize = b.count
    emit(&b, 0) // branch to indexReady (patched below)

    const useDefaultIndexPos: usize = b.count
    b.words[cbzNoSavedStateIdx] = a64.cbzX(2, (@intCast(i32, useDefaultIndexPos) - @intCast(i32, cbzNoSavedStateIdx)) * 4)
    emit(&b, a64.movz32(4, 0, 0)) // w4 = 0 (default index: blue)

    const indexReady: usize = b.count
    b.words[bIndexReadyIdx] = a64.b((@intCast(i32, indexReady) - @intCast(i32, bIndexReadyIdx)) * 4)

    emitAdrpAdd(&b, textVaddr, 10, dataVaddr + DATA_OFFSET_COLOR_INDEX)
    emit(&b, a64.strW(4, 10, 0)) // g_colorIndex = w4

    // color = colorForIndex(w4) -- its address is only known once this
    // whole function's length is counted, patched in after the fact like
    // every other forward reference in this function.
    emit(&b, a64.movReg64(0, 4)) // x0 = index (colorForIndex's one arg)
    const adrpColorForIndexIdx: usize = b.count
    emit(&b, 0) // placeholder ADRP x3, colorForIndex
    emit(&b, 0) // placeholder ADD  x3, x3, #lo12
    emit(&b, a64.blr(3)) // w0 = color
    emitAdrpAdd(&b, textVaddr, 10, dataVaddr + DATA_OFFSET_CURRENT_COLOR)
    emit(&b, a64.strW(0, 10, 0)) // g_currentColor = color

    // Reload `activity` from g_activity rather than trusting x0: the
    // colorForIndex call above was free to clobber it (colorForIndex
    // itself never touches x0 beyond its own arg/return, but nothing
    // upstream of this point should keep relying on x0 staying live
    // across an intervening call regardless -- the same discipline this
    // file already uses everywhere else).
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr + DATA_OFFSET_ACTIVITY)
    emit(&b, a64.ldrX(9, 9, 0)) // x9 = g_activity (== activity)
    emit(&b, a64.ldrX(9, 9, ACTIVITY_OFFSET_CALLBACKS)) // x9 = activity->callbacks (framework-owned, already valid -- do not overwrite this pointer)

    // Register onSaveInstanceState -- see its own comment below for what
    // it hands the framework and why (the other half of the
    // savedState/savedStateSize restore above).
    const adrpSaveInstanceStateIdx: usize = b.count
    emit(&b, 0) // placeholder ADRP x10, onSaveInstanceState
    emit(&b, 0) // placeholder ADD  x10, x10, #lo12
    emit(&b, a64.strX(10, 9, CB_OFFSET_ON_SAVE_INSTANCE_STATE)) // activity->callbacks->onSaveInstanceState = x10

    // (function 2's address is only known once we've counted this
    // function's own length below -- patched in after the fact)
    const adrpWindowCreatedIdx: usize = b.count
    emit(&b, 0) // placeholder ADRP x10, onNativeWindowCreated
    emit(&b, 0) // placeholder ADD  x10, x10, #lo12
    // Register the handler for onNativeWindowCreated,
    // onNativeWindowResized, and onNativeWindowRedrawNeeded -- all three
    // share the exact same `(activity, window) -> void` signature, and
    // this handler already re-reads the buffer's current
    // width/height/stride from ANativeWindow_lock's own out-param on every
    // call rather than caching them, so the same address serves all three
    // without any change.
    //
    // Both used to be left unregistered (see git history for the fuller
    // original comments): removed as a broad diagnostic step while chasing
    // an ANR ("Mlx Blue Screen reagiert nicht") on the back
    // gesture/home/idle-timeout, on the theory that they might be firing
    // repeatedly during transition animations and each firing's
    // synchronous Binder IPC (ANativeWindow_lock/_unlockAndPost) was enough
    // main-thread blocking to trip the ANR watchdog. That theory was never
    // actually confirmed -- the ANR *persisted* even after removing both,
    // and was eventually root-caused to something entirely unrelated: an
    // unconsumed AInputQueue (see onInputQueueCreated below), now fixed
    // independently. So there's no remaining evidence either callback
    // caused anything.
    //
    // Re-registered after real-device feedback that rotating the device
    // left a black bar on one edge. The primary fix for that turned out to
    // be elsewhere (axml.mlx no longer declares `orientation|screenSize` in
    // `configChanges`, so a rotation now goes through Android's normal,
    // far-better-tested destroy-and-recreate path instead of resizing this
    // window in place -- see that file's comment for why, including a real
    // NDK issue confirming even Google's own reference
    // android_native_app_glue.c never wires up either of these callbacks).
    // Both stay registered anyway as a harmless fallback for any resize
    // Android does dispatch to a still-live window without a restart (e.g.
    // multi-window drag-resize) -- registering costs two extra
    // instructions and this handler is already proven idempotent and safe
    // to call repeatedly.
    emit(&b, a64.strX(10, 9, CB_OFFSET_ON_NATIVE_WINDOW_CREATED)) // activity->callbacks->onNativeWindowCreated = x10
    emit(&b, a64.strX(10, 9, CB_OFFSET_ON_NATIVE_WINDOW_RESIZED)) // activity->callbacks->onNativeWindowResized = x10 (same handler, x10 unchanged since the store above)
    emit(&b, a64.strX(10, 9, CB_OFFSET_ON_NATIVE_WINDOW_REDRAW_NEEDED)) // activity->callbacks->onNativeWindowRedrawNeeded = x10 (same handler, x10 still unchanged)
    // Also register onInputQueueCreated. `android.app.NativeActivity`
    // unconditionally calls `getWindow().takeInputQueue(this)` in its own
    // onCreate, which hands this app an input event queue -- Android then
    // expects native code to actively drain it (this is exactly what
    // android_native_app_glue.c's own internal plumbing does for every app
    // built on it). Found necessary after the callback-registration and
    // ANR-avoidance fixes above still left an ANR ("Mlx Blue Screen
    // reagiert nicht") on the back gesture, home, and idle screen-timeout
    // -- all of which involve input events (the back gesture is
    // fundamentally a touch/drag gesture) -- even with *no* window
    // callback left registered at all, proving the ANR wasn't about the
    // paint path anymore. An unconsumed input event sitting in the queue
    // forever is exactly what trips Android's "Input dispatching timed
    // out" watchdog. onInputQueueCreated below sets up a lightweight
    // drain via the existing main-thread ALooper (no new thread needed).
    //
    // x10 is free to reuse here: its previous value (the paint handler's
    // address) was already stored above, so this placeholder pair
    // overwrites it with onInputQueueCreated's own address instead.
    const adrpInputQueueCreatedIdx: usize = b.count
    emit(&b, 0) // placeholder ADRP x10, onInputQueueCreated
    emit(&b, 0) // placeholder ADD  x10, x10, #lo12
    emit(&b, a64.strX(10, 9, CB_OFFSET_ON_INPUT_QUEUE_CREATED)) // activity->callbacks->onInputQueueCreated = x10

    // Also register onInputQueueDestroyed, its counterpart -- see its own
    // comment below for why: real-device feedback that combining rotation
    // with touch input broke, root-caused to never detaching the old
    // instance's input queue from its looper before that queue (and the
    // instance it belonged to) is torn down.
    const adrpInputQueueDestroyedIdx: usize = b.count
    emit(&b, 0) // placeholder ADRP x10, onInputQueueDestroyed
    emit(&b, 0) // placeholder ADD  x10, x10, #lo12
    emit(&b, a64.strX(10, 9, CB_OFFSET_ON_INPUT_QUEUE_DESTROYED)) // activity->callbacks->onInputQueueDestroyed = x10

    // onNativeWindowDestroyed clears g_window, so a long-press timer that
    // fires after the window is gone doesn't paint into a released window.
    const adrpWindowDestroyedIdx: usize = b.count
    emit(&b, 0) // placeholder ADRP x10, onNativeWindowDestroyed
    emit(&b, 0) // placeholder ADD  x10, x10, #lo12
    emit(&b, a64.strX(10, 9, CB_OFFSET_ON_NATIVE_WINDOW_DESTROYED)) // activity->callbacks->onNativeWindowDestroyed = x10

    // Fix the landscape display-cutout black bar (real-device feedback):
    // see fixDisplayCutoutMode's own comment, at the end of this file, for
    // the full mechanism. Its address is only known once this whole
    // function's length is counted -- patched in after the fact, the same
    // way onNativeWindowCreated's and onInputQueueCreated's addresses are
    // above.
    const adrpFixCutoutIdx: usize = b.count
    emit(&b, 0) // placeholder ADRP x3, fixDisplayCutoutMode
    emit(&b, 0) // placeholder ADD  x3, x3, #lo12
    emit(&b, a64.blr(3))

    emit(&b, a64.ldrX(a64.LR, a64.SP, 0)) // restore LR
    emit(&b, a64.addImm64(a64.SP, a64.SP, 16))
    emit(&b, a64.ret(a64.LR))

    // Logcat tag and format strings: data words, never executed (onCreate's
    // `ret` above is the last instruction before them).
    const strLogTag: u64 = emitCString(&b, textVaddr, "mlx")
    const strLogTouch: u64 = emitCString(&b, textVaddr, "touch action=0x%x x=%d y=%d")
    const strLogKind: u64 = emitCString(&b, textVaddr, "recognized kind=%d (1 tap, 2 long press, 3 right, 4 left, 5 down, 6 up)")
    const strLogTimerSet: u64 = emitCString(&b, textVaddr, "long-press timer set to %lld ns (timer fd+1=%d)")
    const strLogTimerFired: u64 = emitCString(&b, textVaddr, "long-press timer fired: tracking=%d moved=%d longFired=%d")
    const strLogTimerCreate: u64 = emitCString(&b, textVaddr, "timerfd_create -> %d")
    const strLogAddFd: u64 = emitCString(&b, textVaddr, "ALooper_addFd -> %d")

    const onWindowCreatedStart: usize = b.count
    const onWindowCreatedVaddr: u64 = textVaddr + @intCast(u64, onWindowCreatedStart) * 4

    // Patch the two placeholders now that this function's address is known.
    const patchPc: u64 = textVaddr + @intCast(u64, adrpWindowCreatedIdx) * 4
    b.words[adrpWindowCreatedIdx] = a64.adrp(10, patchPc, onWindowCreatedVaddr)
    b.words[adrpWindowCreatedIdx + 1] = a64.addImm64(10, 10, @intCast(u32, onWindowCreatedVaddr & 4095))

    // -- shared handler for onNativeWindowCreated / onNativeWindowResized /
    //    onNativeWindowRedrawNeeded (x0=activity, x1=window) --
    // Stack frame: [0..47] = ANativeWindow_Buffer, [48..55] = saved LR,
    // [56..63] = saved window ptr.
    //
    // This function is NOT a leaf: it calls ANativeWindow_setBuffersGeometry/
    // _lock/_unlockAndPost via BLR, and BLR overwrites LR (x30) with the
    // return address *within this function* on every call. Per AAPCS64, a
    // non-leaf function must save its incoming LR before making any call and
    // restore it before its own `ret` -- otherwise the final `ret` uses
    // whatever the *last* BLR left in LR (pointing back into this function's
    // own body, not to our caller), so control never actually returns to the
    // Android framework.
    //
    // The real reason this handler was never even reached, across many
    // rounds of real-device diagnosis, turned out to be entirely upstream
    // of this function -- see ANativeActivity_onCreate's comment above.
    // The lock/unlockAndPost failure traps below predate that finding
    // (added as a diagnostic while this handler's own invocation was still
    // in question) but are kept as a real, cheap safety net: on this ABI
    // there's no other way to surface a lock/present failure without
    // adb/logcat -- and confirmed real: with the actual bug fixed and a
    // real blue screen finally rendering, the very next real-device test
    // (the Android back gesture) crashed. `ANativeWindow_lock` can and
    // does legitimately fail while a window is mid-teardown (exactly what
    // the back gesture's dismiss animation triggers), and that's supposed
    // to be a normal, silent "skip this frame" case for any well-behaved
    // app, not a crash -- so the diagnostic traps below were downgraded
    // back to a plain skip once they'd done their job of confirming the
    // real bug (see ANativeActivity_onCreate's comment above) was fixed.
    emit(&b, a64.subImm64(a64.SP, a64.SP, 64))
    emit(&b, a64.strX(a64.LR, a64.SP, 48)) // save LR
    emit(&b, a64.strX(1, a64.SP, 56)) // save window

    // Keep g_window fresh across every paint (create/resize/redraw, and
    // now a touch-triggered repaint too), so drainInputEvents always has
    // an up-to-date window to hand back to this same function.
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr + DATA_OFFSET_WINDOW)
    emit(&b, a64.strX(1, 9, 0)) // g_window = window

    // ANativeWindow_setBuffersGeometry(window, 0, 0, RGBA_8888) -- the
    // window's actual default surface format is PixelFormat.RGB_565 (16-bit,
    // per NativeActivity.java's onCreate, which calls
    // getWindow().setFormat(PixelFormat.RGB_565) before ever loading our
    // native code), not RGBA_8888, so this call is required, not optional:
    // without it, ANativeWindow_lock would hand back a 16-bit buffer that
    // the 32-bit fill loop below would misinterpret.
    emit(&b, a64.movReg64(0, 1)) // x0 = window
    emit(&b, a64.movz32(1, 0, 0)) // w1 = 0 (width: keep current)
    emit(&b, a64.movz32(2, 0, 0)) // w2 = 0 (height: keep current)
    emit(&b, a64.movz32(3, WINDOW_FORMAT_RGBA_8888, 0)) // w3 = format
    emitGotCall(&b, textVaddr, 9, got.setBuffersGeometry)

    // ANativeWindow_lock(window, &buffer, NULL)
    emit(&b, a64.ldrX(0, a64.SP, 56)) // x0 = window
    emit(&b, a64.addImm64(1, a64.SP, 0)) // x1 = &buffer
    emit(&b, a64.movReg64(2, a64.XZR)) // x2 = NULL
    emitGotCall(&b, textVaddr, 9, got.lock)

    // if (result != 0) goto epilogue;  (forward branch, patched below)
    const cbnzLockFailedIdx: usize = b.count
    emit(&b, 0)

    // Fill: total_pixels = buffer.height * buffer.stride
    emit(&b, a64.ldrW(9, a64.SP, 4)) // w9 = height (zero-extends x9)
    emit(&b, a64.ldrW(10, a64.SP, 8)) // w10 = stride (zero-extends x10)
    emit(&b, a64.mul64(11, 9, 10)) // x11 = total pixel count
    emit(&b, a64.ldrX(12, a64.SP, 16)) // x12 = buffer.bits
    emitAdrpAdd(&b, textVaddr, 13, dataVaddr + DATA_OFFSET_CURRENT_COLOR)
    emit(&b, a64.ldrW(13, 13, 0)) // w13 = g_currentColor (set by showKind)

    // if (total_pixels == 0) goto skip_fill;  (forward branch, patched below)
    const cbzZeroPixelsIdx: usize = b.count
    emit(&b, 0)

    const loopStart: usize = b.count
    emit(&b, a64.strwPostIndex(13, 12, 4)) // *bits++ = color
    emit(&b, a64.subImm64(11, 11, 1))
    const cbnzLoopIdx: usize = b.count
    emit(&b, a64.cbnzX(11, (@intCast(i32, loopStart) - @intCast(i32, cbnzLoopIdx)) * 4))

    const skipFill: usize = b.count
    b.words[cbzZeroPixelsIdx] = a64.cbzX(11, (@intCast(i32, skipFill) - @intCast(i32, cbzZeroPixelsIdx)) * 4)

    // ANativeWindow_unlockAndPost(window) -- its result isn't checked:
    // it's the last thing this handler does before the shared epilogue
    // either way, so there's nothing left to skip on failure.
    emit(&b, a64.ldrX(0, a64.SP, 56)) // x0 = window
    emitGotCall(&b, textVaddr, 9, got.unlockAndPost)

    const epilogue: usize = b.count
    b.words[cbnzLockFailedIdx] = a64.cbnzW(0, (@intCast(i32, epilogue) - @intCast(i32, cbnzLockFailedIdx)) * 4)
    emit(&b, a64.ldrX(a64.LR, a64.SP, 48)) // restore LR (both the lock-failed and normal paths land here)
    emit(&b, a64.addImm64(a64.SP, a64.SP, 64))
    emit(&b, a64.ret(a64.LR))

    // -- showKind(w0 = KIND_*) --
    // Records the recognized kind in g_colorIndex, looks up its color, and
    // repaints the current window, if there still is one.
    // Stack frame: [0] saved LR, [8] kind.
    const showKindStart: usize = b.count
    const showKindVaddr: u64 = textVaddr + @intCast(u64, showKindStart) * 4
    emit(&b, a64.subImm64(a64.SP, a64.SP, 16))
    emit(&b, a64.strX(a64.LR, a64.SP, 0))
    emit(&b, a64.strW(0, a64.SP, 8)) // save kind across the log call
    emit(&b, a64.ldrW(3, a64.SP, 8))
    emitLog(&b, textVaddr, got.logPrint, strLogTag, strLogKind)
    emit(&b, a64.ldrW(0, a64.SP, 8)) // w0 = kind
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.strW(0, 9, off(DATA_OFFSET_COLOR_INDEX))) // g_colorIndex = kind
    const callColorForIndexIdx: usize = emitDirectCallPlaceholder(&b) // w0 = colorForIndex(kind)
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.strW(0, 9, off(DATA_OFFSET_CURRENT_COLOR))) // g_currentColor = color
    emit(&b, a64.ldrX(1, 9, off(DATA_OFFSET_WINDOW))) // x1 = g_window
    const cbzNoWindowIdx: usize = b.count
    emit(&b, 0) // if (!g_window) skip the repaint (patched below)
    emit(&b, a64.movz32(0, 0, 0)) // x0 = activity (unused by the paint handler)
    emitDirectCall(&b, textVaddr, onWindowCreatedVaddr)
    const showKindDone: usize = b.count
    b.words[cbzNoWindowIdx] = a64.cbzX(1, delta(cbzNoWindowIdx, showKindDone))
    emit(&b, a64.ldrX(a64.LR, a64.SP, 0))
    emit(&b, a64.addImm64(a64.SP, a64.SP, 16))
    emit(&b, a64.ret(a64.LR))

    // -- setLongPressTimer(x0 = delay in ns; 0 disarms) --
    // One-shot, relative timerfd_settime on the long-press timer, if
    // onInputQueueCreated managed to create one.
    // Stack frame: [0..31] struct itimerspec {it_interval, it_value},
    // [32] saved LR.
    const setTimerStart: usize = b.count
    const setTimerVaddr: u64 = textVaddr + @intCast(u64, setTimerStart) * 4
    emit(&b, a64.subImm64(a64.SP, a64.SP, 48))
    emit(&b, a64.strX(a64.LR, a64.SP, 32))
    emit(&b, a64.strX(a64.XZR, a64.SP, 0)) // it_interval.tv_sec = 0 (one-shot)
    emit(&b, a64.strX(a64.XZR, a64.SP, 8)) // it_interval.tv_nsec = 0
    emit(&b, a64.strX(a64.XZR, a64.SP, 16)) // it_value.tv_sec = 0
    emit(&b, a64.strX(0, a64.SP, 24)) // it_value.tv_nsec = delay
    emit(&b, a64.ldrX(3, a64.SP, 24)) // log: delay
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.ldrW(4, 9, off(DATA_OFFSET_TIMER_FD_PLUS_1))) // log: fd + 1
    emitLog(&b, textVaddr, got.logPrint, strLogTag, strLogTimerSet)
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_TIMER_FD_PLUS_1)))
    const cbzNoTimerIdx: usize = b.count
    emit(&b, 0) // if no timer, nothing to do (patched below)
    emit(&b, a64.subImm64(0, 10, 1)) // x0 = fd
    emit(&b, a64.movz32(1, 0, 0)) // w1 = flags: relative
    emit(&b, a64.addImm64(2, a64.SP, 0)) // x2 = &new_value
    emit(&b, a64.movReg64(3, a64.XZR)) // x3 = old_value: NULL
    emitGotCall(&b, textVaddr, 9, got.timerfdSettime)
    const setTimerDone: usize = b.count
    b.words[cbzNoTimerIdx] = a64.cbzW(10, delta(cbzNoTimerIdx, setTimerDone))
    emit(&b, a64.ldrX(a64.LR, a64.SP, 32))
    emit(&b, a64.addImm64(a64.SP, a64.SP, 48))
    emit(&b, a64.ret(a64.LR))

    // -- onLongPressTimer(w0 = fd, w1 = events, x2 = data) --
    // ALooper callback for the long-press timerfd, which fires 500 ms after
    // ACTION_DOWN unless the touch moved or ended first. Reads the expiration
    // count so the fd stops polling readable, then, if that touch is still
    // down and still inside the slop, recognizes the long press right away,
    // while the finger is down. Returns 1 to stay registered.
    // Stack frame: [0] u64 read buffer, [24] saved LR.
    const longPressTimerStart: usize = b.count
    const longPressTimerVaddr: u64 = textVaddr + @intCast(u64, longPressTimerStart) * 4
    emit(&b, a64.subImm64(a64.SP, a64.SP, 32))
    emit(&b, a64.strX(a64.LR, a64.SP, 24))
    emit(&b, a64.addImm64(1, a64.SP, 0)) // x1 = &buffer (x0 = fd, as passed in)
    emit(&b, a64.movz32(2, 8, 0)) // x2 = 8
    emitGotCall(&b, textVaddr, 9, got.read)
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.ldrW(3, 9, off(DATA_OFFSET_TRACKING)))
    emit(&b, a64.ldrW(4, 9, off(DATA_OFFSET_MOVED)))
    emit(&b, a64.ldrW(5, 9, off(DATA_OFFSET_LONG_FIRED)))
    emitLog(&b, textVaddr, got.logPrint, strLogTag, strLogTimerFired)
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_TRACKING)))
    const lpNotTrackingIdx: usize = b.count
    emit(&b, 0) // if (!tracking) done
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_MOVED)))
    const lpMovedIdx: usize = b.count
    emit(&b, 0) // if (moved) done
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_LONG_FIRED)))
    const lpFiredIdx: usize = b.count
    emit(&b, 0) // if (longFired) done
    emit(&b, a64.movz32(10, 1, 0))
    emit(&b, a64.strW(10, 9, off(DATA_OFFSET_LONG_FIRED))) // longFired = 1
    emit(&b, a64.movz32(0, KIND_LONG_PRESS, 0))
    emitDirectCall(&b, textVaddr, showKindVaddr)
    const lpDone: usize = b.count
    b.words[lpNotTrackingIdx] = a64.cbzW(10, delta(lpNotTrackingIdx, lpDone))
    b.words[lpMovedIdx] = a64.cbnzW(10, delta(lpMovedIdx, lpDone))
    b.words[lpFiredIdx] = a64.cbnzW(10, delta(lpFiredIdx, lpDone))
    emit(&b, a64.ldrX(a64.LR, a64.SP, 24))
    emit(&b, a64.addImm64(a64.SP, a64.SP, 32))
    emit(&b, a64.movz32(0, 1, 0)) // w0 = 1 (keep receiving callbacks)
    emit(&b, a64.ret(a64.LR))

    const onInputQueueCreatedStart: usize = b.count
    const onInputQueueCreatedVaddr: u64 = textVaddr + @intCast(u64, onInputQueueCreatedStart) * 4
    const patchPc2: u64 = textVaddr + @intCast(u64, adrpInputQueueCreatedIdx) * 4
    b.words[adrpInputQueueCreatedIdx] = a64.adrp(10, patchPc2, onInputQueueCreatedVaddr)
    b.words[adrpInputQueueCreatedIdx + 1] = a64.addImm64(10, 10, @intCast(u32, onInputQueueCreatedVaddr & 4095))

    // -- onInputQueueCreated(x0=activity, x1=queue) --
    // Attaches `queue` to this thread's already-running ALooper (the main
    // thread's -- onInputQueueCreated runs on it, same as every other
    // ANativeActivityCallbacks callback, so ALooper_forThread() here finds
    // the looper Android's own runtime already prepared for it) with
    // drainInputEvents (below) as the per-event callback. This mirrors
    // exactly what android_native_app_glue.c does, minus its extra thread.
    //
    // The first time (per process) it also creates the long-press timerfd
    // and adds it to the same looper with onLongPressTimer as its callback.
    // If either step fails, long presses are still recognized, just on
    // release instead of while held (see drainInputEvents).
    // Stack frame: [0] timerfd, [8] saved looper, [16] saved queue, [24] saved LR.
    emit(&b, a64.subImm64(a64.SP, a64.SP, 32))
    emit(&b, a64.strX(a64.LR, a64.SP, 24)) // save LR (this is a non-leaf function; see the LR-preservation note above)
    emit(&b, a64.strX(1, a64.SP, 16)) // save queue

    emitGotCall(&b, textVaddr, 9, got.looperForThread) // x0 = ALooper_forThread()
    emit(&b, a64.strX(0, a64.SP, 8)) // save looper
    emit(&b, a64.movReg64(1, 0)) // x1 = looper
    emit(&b, a64.ldrX(0, a64.SP, 16)) // x0 = queue
    emit(&b, a64.movReg64(4, 0)) // x4 = data = queue (threaded through to drainInputEvents's 3rd arg)
    emit(&b, a64.movz32(2, LOOPER_IDENT_INPUT, 0)) // w2 = ident

    const adrpDrainCallbackIdx: usize = b.count
    emit(&b, 0) // placeholder ADRP x3, drainInputEvents
    emit(&b, 0) // placeholder ADD  x3, x3, #lo12

    // AInputQueue_attachLooper(queue=x0, looper=x1, ident=w2, callback=x3, data=x4)
    emitGotCall(&b, textVaddr, 9, got.inputQueueAttachLooper)

    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_TIMER_FD_PLUS_1)))
    const cbnzHaveTimerIdx: usize = b.count
    emit(&b, 0) // if the timer already exists, done (patched below)
    emit(&b, a64.movz32(0, CLOCK_MONOTONIC, 0))
    emit(&b, a64.movz32(1, TFD_FLAGS_LO, 0))
    emit(&b, a64.movk32(1, TFD_FLAGS_HI, 1)) // w1 = TFD_NONBLOCK | TFD_CLOEXEC
    emitGotCall(&b, textVaddr, 9, got.timerfdCreate) // w0 = fd
    emit(&b, a64.strW(0, a64.SP, 0)) // save fd across the log call
    emit(&b, a64.ldrW(3, a64.SP, 0))
    emitLog(&b, textVaddr, got.logPrint, strLogTag, strLogTimerCreate)
    emit(&b, a64.ldrW(0, a64.SP, 0)) // w0 = fd
    const tbnzNoTimerIdx: usize = b.count
    emit(&b, 0) // if (fd < 0) done, no timer (patched below)
    emit(&b, a64.addImm64(10, 0, 1))
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.strW(10, 9, off(DATA_OFFSET_TIMER_FD_PLUS_1))) // g_timerFdPlus1 = fd + 1
    // ALooper_addFd(looper, fd, LOOPER_IDENT_TIMER, ALOOPER_EVENT_INPUT, onLongPressTimer, NULL)
    emit(&b, a64.movReg64(1, 0)) // x1 = fd
    emit(&b, a64.ldrX(0, a64.SP, 8)) // x0 = looper
    emit(&b, a64.movz32(2, LOOPER_IDENT_TIMER, 0))
    emit(&b, a64.movz32(3, ALOOPER_EVENT_INPUT, 0))
    emitAdrpAdd(&b, textVaddr, 4, longPressTimerVaddr)
    emit(&b, a64.movReg64(5, a64.XZR))
    emitGotCall(&b, textVaddr, 9, got.looperAddFd)
    emit(&b, a64.movReg64(3, 0))
    emitLog(&b, textVaddr, got.logPrint, strLogTag, strLogAddFd)
    const timerReady: usize = b.count
    b.words[cbnzHaveTimerIdx] = a64.cbnzW(10, delta(cbnzHaveTimerIdx, timerReady))
    b.words[tbnzNoTimerIdx] = a64.tbnz(0, 31, delta(tbnzNoTimerIdx, timerReady))

    emit(&b, a64.ldrX(a64.LR, a64.SP, 24)) // restore LR
    emit(&b, a64.addImm64(a64.SP, a64.SP, 32))
    emit(&b, a64.ret(a64.LR))

    const drainCallbackStart: usize = b.count
    const drainCallbackVaddr: u64 = textVaddr + @intCast(u64, drainCallbackStart) * 4
    const patchPc3: u64 = textVaddr + @intCast(u64, adrpDrainCallbackIdx) * 4
    b.words[adrpDrainCallbackIdx] = a64.adrp(3, patchPc3, drainCallbackVaddr)
    b.words[adrpDrainCallbackIdx + 1] = a64.addImm64(3, 3, @intCast(u32, drainCallbackVaddr & 4095))

    // -- drainInputEvents(w0=fd, w1=events, x2=data=queue) --
    // The ALooper callback for the input queue. Drains every pending event,
    // classifies single-finger touches, and finishes each event as
    // unhandled (so the system still gets its own gestures). Draining at
    // all is what keeps Android's "Input dispatching timed out" watchdog
    // from firing. Returns 1 to stay registered.
    //
    // DOWN records where and when the finger went down and arms the
    // long-press timer. MOVE marks the touch as moved once it leaves the
    // touch slop, disarming the timer. UP classifies: moved, or released
    // outside the slop, is a swipe in its dominant direction; otherwise a
    // long press if held >= 500 ms (normally the timer recognized it
    // already; this is the fallback), else a tap. CANCEL, or a second
    // finger (POINTER_DOWN), abandons the touch.
    // Stack frame: [0] AInputEvent* out-param, [8] x (i32), [12] y (i32),
    // [16] saved queue, [24] saved LR, [32] masked action, [36] raw action.
    emit(&b, a64.subImm64(a64.SP, a64.SP, 48))
    emit(&b, a64.strX(a64.LR, a64.SP, 24)) // save LR (non-leaf)
    emit(&b, a64.strX(2, a64.SP, 16)) // save queue (arrives in x2, the callback's "data" param)

    const drainLoopTop: usize = b.count
    emit(&b, a64.ldrX(0, a64.SP, 16)) // x0 = queue
    emit(&b, a64.addImm64(1, a64.SP, 0)) // x1 = &outEvent
    emitGotCall(&b, textVaddr, 9, got.inputQueueGetEvent) // w0 = result (negative once the queue is drained)
    const tbnzDrainDoneIdx: usize = b.count
    emit(&b, 0) // if (result < 0) done (patched below)

    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = event
    emitGotCall(&b, textVaddr, 9, got.inputEventGetType)
    emit(&b, a64.cmpImm32(0, AINPUT_EVENT_TYPE_MOTION))
    const bneNotMotionIdx: usize = b.count
    emit(&b, 0) // if not a motion event, just finish it (patched below)

    emit(&b, a64.ldrX(0, a64.SP, 0))
    emitGotCall(&b, textVaddr, 9, got.motionEventGetAction)
    emit(&b, a64.strW(0, a64.SP, 36)) // raw action, for the log
    emit(&b, a64.uxtbW(0, 0)) // action & AMOTION_EVENT_ACTION_MASK
    emit(&b, a64.strW(0, a64.SP, 32))
    emit(&b, a64.ldrX(0, a64.SP, 0))
    emit(&b, a64.movz32(1, 0, 0)) // pointer index 0
    emitGotCall(&b, textVaddr, 9, got.motionEventGetX) // s0 = x
    emit(&b, a64.fcvtzsWS(0, 0))
    emit(&b, a64.strW(0, a64.SP, 8))
    emit(&b, a64.ldrX(0, a64.SP, 0))
    emit(&b, a64.movz32(1, 0, 0))
    emitGotCall(&b, textVaddr, 9, got.motionEventGetY) // s0 = y
    emit(&b, a64.fcvtzsWS(0, 0))
    emit(&b, a64.strW(0, a64.SP, 12))
    emit(&b, a64.ldrW(3, a64.SP, 36))
    emit(&b, a64.ldrW(4, a64.SP, 8))
    emit(&b, a64.ldrW(5, a64.SP, 12))
    emitLog(&b, textVaddr, got.logPrint, strLogTag, strLogTouch)

    emit(&b, a64.ldrW(9, a64.SP, 32)) // w9 = action
    emit(&b, a64.cmpImm32(9, AMOTION_EVENT_ACTION_DOWN))
    const beqDownIdx: usize = b.count
    emit(&b, 0)
    emit(&b, a64.cmpImm32(9, AMOTION_EVENT_ACTION_MOVE))
    const beqMoveIdx: usize = b.count
    emit(&b, 0)
    emit(&b, a64.cmpImm32(9, AMOTION_EVENT_ACTION_UP))
    const beqUpIdx: usize = b.count
    emit(&b, 0)
    emit(&b, a64.cmpImm32(9, AMOTION_EVENT_ACTION_CANCEL))
    const beqCancelIdx: usize = b.count
    emit(&b, 0)
    emit(&b, a64.cmpImm32(9, AMOTION_EVENT_ACTION_POINTER_DOWN))
    const beqPointerDownIdx: usize = b.count
    emit(&b, 0)
    const bOtherActionIdx: usize = b.count
    emit(&b, 0) // any other action: just finish it (patched below)

    // ACTION_DOWN: remember time and position, start tracking, arm the timer.
    const onDown: usize = b.count
    emit(&b, a64.ldrX(0, a64.SP, 0))
    emitGotCall(&b, textVaddr, 9, got.motionEventGetEventTime) // x0 = event time (ns)
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.strX(0, 9, off(DATA_OFFSET_DOWN_TIME)))
    emit(&b, a64.ldrW(10, a64.SP, 8))
    emit(&b, a64.strW(10, 9, off(DATA_OFFSET_DOWN_X)))
    emit(&b, a64.ldrW(10, a64.SP, 12))
    emit(&b, a64.strW(10, 9, off(DATA_OFFSET_DOWN_Y)))
    emit(&b, a64.movz32(10, 1, 0))
    emit(&b, a64.strW(10, 9, off(DATA_OFFSET_TRACKING)))
    emit(&b, a64.strW(a64.XZR, 9, off(DATA_OFFSET_MOVED)))
    emit(&b, a64.strW(a64.XZR, 9, off(DATA_OFFSET_LONG_FIRED)))
    emit(&b, a64.movz32(0, LONG_PRESS_NS_LO, 0))
    emit(&b, a64.movk32(0, LONG_PRESS_NS_HI, 1)) // x0 = 500 ms
    emitDirectCall(&b, textVaddr, setTimerVaddr)
    const bDownDoneIdx: usize = b.count
    emit(&b, 0) // -> finish

    // ACTION_MOVE: once the tracked touch leaves the slop, it's a swipe.
    const onMove: usize = b.count
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_TRACKING)))
    const mvNotTrackingIdx: usize = b.count
    emit(&b, 0) // if (!tracking) finish
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_MOVED)))
    const mvMovedIdx: usize = b.count
    emit(&b, 0) // if (moved) finish
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_LONG_FIRED)))
    const mvFiredIdx: usize = b.count
    emit(&b, 0) // if (longFired) finish
    emit(&b, a64.ldrW(10, a64.SP, 8))
    emit(&b, a64.ldrW(11, 9, off(DATA_OFFSET_DOWN_X)))
    emit(&b, a64.subReg32(10, 10, 11)) // w10 = dx
    emit(&b, a64.ldrW(12, a64.SP, 12))
    emit(&b, a64.ldrW(13, 9, off(DATA_OFFSET_DOWN_Y)))
    emit(&b, a64.subReg32(12, 12, 13)) // w12 = dy
    emit(&b, a64.cmpImm32(10, 0))
    emit(&b, a64.cnegW(10, 10, a64.COND_MI)) // w10 = |dx|
    emit(&b, a64.cmpImm32(12, 0))
    emit(&b, a64.cnegW(12, 12, a64.COND_MI)) // w12 = |dy|
    emit(&b, a64.cmpImm32(10, TOUCH_SLOP_PX))
    const mvOutXIdx: usize = b.count
    emit(&b, 0) // if (|dx| > slop) markMoved
    emit(&b, a64.cmpImm32(12, TOUCH_SLOP_PX))
    const mvOutYIdx: usize = b.count
    emit(&b, 0) // if (|dy| > slop) markMoved
    const bMoveInsideIdx: usize = b.count
    emit(&b, 0) // -> finish
    const markMoved: usize = b.count
    emit(&b, a64.movz32(10, 1, 0))
    emit(&b, a64.strW(10, 9, off(DATA_OFFSET_MOVED)))
    emit(&b, a64.movz32(0, 0, 0))
    emitDirectCall(&b, textVaddr, setTimerVaddr) // disarm
    const bMovedDoneIdx: usize = b.count
    emit(&b, 0) // -> finish

    // ACTION_UP: classify the finished touch.
    const onUp: usize = b.count
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_TRACKING)))
    const upNotTrackingIdx: usize = b.count
    emit(&b, 0) // if (!tracking) finish
    emit(&b, a64.strW(a64.XZR, 9, off(DATA_OFFSET_TRACKING)))
    emit(&b, a64.movz32(0, 0, 0))
    emitDirectCall(&b, textVaddr, setTimerVaddr) // disarm
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.ldrW(10, 9, off(DATA_OFFSET_LONG_FIRED)))
    const upFiredIdx: usize = b.count
    emit(&b, 0) // if (longFired) finish: already shown
    emit(&b, a64.ldrW(10, a64.SP, 8))
    emit(&b, a64.ldrW(11, 9, off(DATA_OFFSET_DOWN_X)))
    emit(&b, a64.subReg32(10, 10, 11)) // w10 = dx
    emit(&b, a64.ldrW(12, a64.SP, 12))
    emit(&b, a64.ldrW(13, 9, off(DATA_OFFSET_DOWN_Y)))
    emit(&b, a64.subReg32(12, 12, 13)) // w12 = dy
    emit(&b, a64.cmpImm32(10, 0))
    emit(&b, a64.cnegW(11, 10, a64.COND_MI)) // w11 = |dx|
    emit(&b, a64.cmpImm32(12, 0))
    emit(&b, a64.cnegW(13, 12, a64.COND_MI)) // w13 = |dy|
    emit(&b, a64.ldrW(14, 9, off(DATA_OFFSET_MOVED)))
    const upMovedIdx: usize = b.count
    emit(&b, 0) // if (moved) swipe
    emit(&b, a64.cmpImm32(11, TOUCH_SLOP_PX))
    const upOutXIdx: usize = b.count
    emit(&b, 0) // if (|dx| > slop) swipe
    emit(&b, a64.cmpImm32(13, TOUCH_SLOP_PX))
    const upOutYIdx: usize = b.count
    emit(&b, 0) // if (|dy| > slop) swipe
    emit(&b, a64.ldrX(0, a64.SP, 0))
    emitGotCall(&b, textVaddr, 9, got.motionEventGetEventTime) // x0 = up time (ns)
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.ldrX(10, 9, off(DATA_OFFSET_DOWN_TIME)))
    emit(&b, a64.subReg64(0, 0, 10)) // x0 = held for (ns)
    emit(&b, a64.movz32(10, LONG_PRESS_NS_LO, 0))
    emit(&b, a64.movk32(10, LONG_PRESS_NS_HI, 1)) // x10 = 500 ms
    emit(&b, a64.cmpReg64(0, 10))
    const upLongIdx: usize = b.count
    emit(&b, 0) // if (held >= 500 ms) long press
    emit(&b, a64.movz32(0, KIND_TAP, 0))
    const bTapShowIdx: usize = b.count
    emit(&b, 0) // -> show
    const upLong: usize = b.count
    emit(&b, a64.movz32(0, KIND_LONG_PRESS, 0))
    const bLongShowIdx: usize = b.count
    emit(&b, 0) // -> show
    const swipe: usize = b.count
    emit(&b, a64.cmpReg32(11, 13))
    const swVerticalIdx: usize = b.count
    emit(&b, 0) // if (|dx| < |dy|) vertical
    emit(&b, a64.cmpImm32(10, 0))
    const swLeftIdx: usize = b.count
    emit(&b, 0) // if (dx < 0) left
    emit(&b, a64.movz32(0, KIND_SWIPE_RIGHT, 0))
    const bRightShowIdx: usize = b.count
    emit(&b, 0) // -> show
    const swLeft: usize = b.count
    emit(&b, a64.movz32(0, KIND_SWIPE_LEFT, 0))
    const bLeftShowIdx: usize = b.count
    emit(&b, 0) // -> show
    const swVertical: usize = b.count
    emit(&b, a64.cmpImm32(12, 0))
    const swUpIdx: usize = b.count
    emit(&b, 0) // if (dy < 0) up (screen y grows downward)
    emit(&b, a64.movz32(0, KIND_SWIPE_DOWN, 0))
    const bDownShowIdx: usize = b.count
    emit(&b, 0) // -> show
    const swUp: usize = b.count
    emit(&b, a64.movz32(0, KIND_SWIPE_UP, 0))
    const show: usize = b.count
    emitDirectCall(&b, textVaddr, showKindVaddr)
    const bShownIdx: usize = b.count
    emit(&b, 0) // -> finish

    // ACTION_CANCEL / ACTION_POINTER_DOWN: abandon the touch.
    const onCancel: usize = b.count
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.strW(a64.XZR, 9, off(DATA_OFFSET_TRACKING)))
    emit(&b, a64.movz32(0, 0, 0))
    emitDirectCall(&b, textVaddr, setTimerVaddr) // disarm
    // falls through to finish

    const finish: usize = b.count
    emit(&b, a64.ldrX(0, a64.SP, 16)) // x0 = queue
    emit(&b, a64.ldrX(1, a64.SP, 0)) // x1 = event
    emit(&b, a64.movz32(2, 0, 0)) // w2 = handled = 0
    emitGotCall(&b, textVaddr, 9, got.inputQueueFinishEvent)
    const branchBackIdx: usize = b.count
    emit(&b, a64.b(delta(branchBackIdx, drainLoopTop)))

    const drainDone: usize = b.count
    emit(&b, a64.ldrX(a64.LR, a64.SP, 24)) // restore LR
    emit(&b, a64.addImm64(a64.SP, a64.SP, 48))
    emit(&b, a64.movz32(0, 1, 0)) // w0 = 1 (keep receiving future callbacks)
    emit(&b, a64.ret(a64.LR))

    b.words[tbnzDrainDoneIdx] = a64.tbnz(0, 31, delta(tbnzDrainDoneIdx, drainDone))
    b.words[bneNotMotionIdx] = a64.bCond(a64.COND_NE, delta(bneNotMotionIdx, finish))
    b.words[beqDownIdx] = a64.bCond(a64.COND_EQ, delta(beqDownIdx, onDown))
    b.words[beqMoveIdx] = a64.bCond(a64.COND_EQ, delta(beqMoveIdx, onMove))
    b.words[beqUpIdx] = a64.bCond(a64.COND_EQ, delta(beqUpIdx, onUp))
    b.words[beqCancelIdx] = a64.bCond(a64.COND_EQ, delta(beqCancelIdx, onCancel))
    b.words[beqPointerDownIdx] = a64.bCond(a64.COND_EQ, delta(beqPointerDownIdx, onCancel))
    b.words[bOtherActionIdx] = a64.b(delta(bOtherActionIdx, finish))
    b.words[bDownDoneIdx] = a64.b(delta(bDownDoneIdx, finish))
    b.words[mvNotTrackingIdx] = a64.cbzW(10, delta(mvNotTrackingIdx, finish))
    b.words[mvMovedIdx] = a64.cbnzW(10, delta(mvMovedIdx, finish))
    b.words[mvFiredIdx] = a64.cbnzW(10, delta(mvFiredIdx, finish))
    b.words[mvOutXIdx] = a64.bCond(a64.COND_GT, delta(mvOutXIdx, markMoved))
    b.words[mvOutYIdx] = a64.bCond(a64.COND_GT, delta(mvOutYIdx, markMoved))
    b.words[bMoveInsideIdx] = a64.b(delta(bMoveInsideIdx, finish))
    b.words[bMovedDoneIdx] = a64.b(delta(bMovedDoneIdx, finish))
    b.words[upNotTrackingIdx] = a64.cbzW(10, delta(upNotTrackingIdx, finish))
    b.words[upFiredIdx] = a64.cbnzW(10, delta(upFiredIdx, finish))
    b.words[upMovedIdx] = a64.cbnzW(14, delta(upMovedIdx, swipe))
    b.words[upOutXIdx] = a64.bCond(a64.COND_GT, delta(upOutXIdx, swipe))
    b.words[upOutYIdx] = a64.bCond(a64.COND_GT, delta(upOutYIdx, swipe))
    b.words[upLongIdx] = a64.bCond(a64.COND_GE, delta(upLongIdx, upLong))
    b.words[bTapShowIdx] = a64.b(delta(bTapShowIdx, show))
    b.words[bLongShowIdx] = a64.b(delta(bLongShowIdx, show))
    b.words[swVerticalIdx] = a64.bCond(a64.COND_LT, delta(swVerticalIdx, swVertical))
    b.words[swLeftIdx] = a64.bCond(a64.COND_LT, delta(swLeftIdx, swLeft))
    b.words[bRightShowIdx] = a64.b(delta(bRightShowIdx, show))
    b.words[bLeftShowIdx] = a64.b(delta(bLeftShowIdx, show))
    b.words[swUpIdx] = a64.bCond(a64.COND_LT, delta(swUpIdx, swUp))
    b.words[bDownShowIdx] = a64.b(delta(bDownShowIdx, show))
    b.words[bShownIdx] = a64.b(delta(bShownIdx, finish))

    const fixCutoutStart: usize = b.count
    const fixCutoutVaddr: u64 = textVaddr + @intCast(u64, fixCutoutStart) * 4
    const patchPcCutout: u64 = textVaddr + @intCast(u64, adrpFixCutoutIdx) * 4
    b.words[adrpFixCutoutIdx] = a64.adrp(3, patchPcCutout, fixCutoutVaddr)
    b.words[adrpFixCutoutIdx + 1] = a64.addImm64(3, 3, @intCast(u32, fixCutoutVaddr & 4095))

    // -- fixDisplayCutoutMode() -- reads g_activity, takes no other args --
    //
    // Real-device feedback: rotating to landscape left a black bar over
    // the area next to the display cutout (the front camera). Confirmed
    // via Android's own documentation rather than guessed at: "The
    // platform default allows a window under the cutout in portrait, but
    // avoids it in landscape, leaving a black bar over the cutout area"
    // -- exactly this symptom. The fix is to set
    // `WindowManager.LayoutParams.layoutInDisplayCutoutMode` to
    // LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES (1, see its own comment
    // above), which lets the window extend into the cutout area on the
    // screen's short edges in every orientation. That field can only be
    // set via a custom theme (a resources.arsc/style writer this
    // experiment doesn't have) or, as here, directly through JNI -- this
    // project's first use of it. Equivalent to the Java:
    //   Window w = activity.getWindow();
    //   WindowManager.LayoutParams lp = w.getAttributes();
    //   lp.layoutInDisplayCutoutMode = LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES;
    //   w.setAttributes(lp);
    // Every class/method/field name below is a real, public Android API
    // (android.app.Activity.getWindow, android.view.Window.
    // getAttributes/setAttributes, android.view.WindowManager.
    // LayoutParams.layoutInDisplayCutoutMode). getAttributes/setAttributes
    // are declared directly on the public abstract Window class, so
    // FindClass on that (rather than the actual hidden PhoneWindow runtime
    // subclass getWindow() returns) is enough -- JNI resolves
    // inherited/overridden methods correctly starting from either the
    // declaring class or a subclass.
    //
    // A real-device crash (SIGILL, ILL_ILLOPC, fault PC landing squarely on
    // the raw bytes of "android/app/NativeActivity" read as an
    // instruction) confirmed the very first version of this function had a
    // real bug: each `emitCString` call site emitted its string's bytes
    // directly in the middle of straight-line code, immediately after a
    // normal instruction and before another one, with nothing to jump
    // over it. Ordinary sequential execution doesn't know those bytes
    // aren't code -- it just fell straight from the last real instruction
    // into the string data and tried to execute it. Fixed by packing every
    // C string this function needs into one block, jumped over with a
    // single unconditional branch before any of it is reached, immediately
    // after this function's own entry point -- every string's address is
    // still just an ordinary ADRP+ADD against an address already known by
    // the time it's used below, same as before.
    const skipStringsIdx: usize = b.count
    emit(&b, 0) // placeholder B realStart (patched below)

    const strNativeActivity: u64 = emitCString(&b, textVaddr, "android/app/NativeActivity")
    const strGetWindow: u64 = emitCString(&b, textVaddr, "getWindow")
    const strGetWindowSig: u64 = emitCString(&b, textVaddr, "()Landroid/view/Window;")
    const strWindow: u64 = emitCString(&b, textVaddr, "android/view/Window")
    const strGetAttrs: u64 = emitCString(&b, textVaddr, "getAttributes")
    const strGetAttrsSig: u64 = emitCString(&b, textVaddr, "()Landroid/view/WindowManager$LayoutParams;")
    const strSetAttrs: u64 = emitCString(&b, textVaddr, "setAttributes")
    const strSetAttrsSig: u64 = emitCString(&b, textVaddr, "(Landroid/view/WindowManager$LayoutParams;)V")
    const strLayoutParams: u64 = emitCString(&b, textVaddr, "android/view/WindowManager$LayoutParams")
    const strCutoutField: u64 = emitCString(&b, textVaddr, "layoutInDisplayCutoutMode")
    const strIntSig: u64 = emitCString(&b, textVaddr, "I")

    const realStart: usize = b.count
    b.words[skipStringsIdx] = a64.b((@intCast(i32, realStart) - @intCast(i32, skipStringsIdx)) * 4)

    // Stack frame (96 bytes, 16-aligned): [0]=env [8]=activityObj
    // [16]=windowClass [24]=layoutParamsClass [32]=windowObj [40]=attrsObj
    // [48]=getWindowMid [56]=getAttrsMid [64]=setAttrsMid
    // [72]=cutoutModeFid [80]=saved LR. Every JNI call below reloads its
    // arguments from this frame rather than trusting a register to still
    // hold an earlier result, since emitJniCall's own ADRP+LDR sequence
    // (and every JNI call itself) is free to clobber any caller-saved
    // register -- the same discipline drainInputEvents already uses
    // around its own GOT calls.
    //
    // Every handle a later call depends on is null-checked immediately
    // after it's produced, bailing out to a shared epilogue (`cutoutBail`)
    // that clears any pending JNI exception before returning, rather than
    // pressing on: a NULL from FindClass/GetMethodID/GetFieldID always
    // means an exception is now pending on this JNIEnv, and calling
    // almost any other JNI function while one is pending is undefined
    // behavior -- ART's real, observed response to that is a fatal abort
    // of the whole process, not a contained failure. This wasn't what
    // caused the crash above (that was the string-data bug), but it's
    // still a real gap this function's first version had, worth closing
    // now rather than leaving as a second latent way to take the app down
    // if any class/method/field lookup ever legitimately fails on some
    // other OS build.
    emit(&b, a64.subImm64(a64.SP, a64.SP, 96))
    emit(&b, a64.strX(a64.LR, a64.SP, 80)) // save LR (non-leaf: many JNI calls via BLR)

    emitAdrpAdd(&b, textVaddr, 9, dataVaddr + DATA_OFFSET_ACTIVITY)
    emit(&b, a64.ldrX(9, 9, 0)) // x9 = g_activity
    emit(&b, a64.ldrX(0, 9, ACTIVITY_OFFSET_ENV)) // x0 = activity->env (JNIEnv*)
    emit(&b, a64.strX(0, a64.SP, 0)) // save env
    emit(&b, a64.ldrX(1, 9, ACTIVITY_OFFSET_CLAZZ)) // x1 = activity->clazz
    emit(&b, a64.strX(1, a64.SP, 8)) // save activityObj

    // activityClass = FindClass(env, "android/app/NativeActivity")
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emitAdrpAdd(&b, textVaddr, 1, strNativeActivity)
    emitJniCall(&b, JNI_FIND_CLASS) // x0 = activityClass
    const bailActivityClassIdx: usize = b.count
    emit(&b, 0) // if activityClass == NULL, bail (patched below)
    emit(&b, a64.movReg64(9, 0)) // x9 = activityClass (kept live for the very next call only)

    // getWindowMid = GetMethodID(env, activityClass, "getWindow", "()Landroid/view/Window;")
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emit(&b, a64.movReg64(1, 9)) // x1 = activityClass
    emitAdrpAdd(&b, textVaddr, 2, strGetWindow)
    emitAdrpAdd(&b, textVaddr, 3, strGetWindowSig)
    emitJniCall(&b, JNI_GET_METHOD_ID) // x0 = getWindowMid
    const bailGetWindowMidIdx: usize = b.count
    emit(&b, 0) // if getWindowMid == NULL, bail (patched below)
    emit(&b, a64.strX(0, a64.SP, 48)) // save getWindowMid

    // windowClass = FindClass(env, "android/view/Window")
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emitAdrpAdd(&b, textVaddr, 1, strWindow)
    emitJniCall(&b, JNI_FIND_CLASS) // x0 = windowClass
    const bailWindowClassIdx: usize = b.count
    emit(&b, 0) // if windowClass == NULL, bail (patched below)
    emit(&b, a64.strX(0, a64.SP, 16)) // save windowClass
    emit(&b, a64.movReg64(9, 0)) // x9 = windowClass (kept live for the next call only)

    // getAttrsMid = GetMethodID(env, windowClass, "getAttributes", "()Landroid/view/WindowManager$LayoutParams;")
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emit(&b, a64.movReg64(1, 9)) // x1 = windowClass
    emitAdrpAdd(&b, textVaddr, 2, strGetAttrs)
    emitAdrpAdd(&b, textVaddr, 3, strGetAttrsSig)
    emitJniCall(&b, JNI_GET_METHOD_ID) // x0 = getAttrsMid
    const bailGetAttrsMidIdx: usize = b.count
    emit(&b, 0) // if getAttrsMid == NULL, bail (patched below)
    emit(&b, a64.strX(0, a64.SP, 56)) // save getAttrsMid

    // setAttrsMid = GetMethodID(env, windowClass, "setAttributes", "(Landroid/view/WindowManager$LayoutParams;)V")
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emit(&b, a64.ldrX(1, a64.SP, 16)) // x1 = windowClass (reload: the previous call clobbered x9)
    emitAdrpAdd(&b, textVaddr, 2, strSetAttrs)
    emitAdrpAdd(&b, textVaddr, 3, strSetAttrsSig)
    emitJniCall(&b, JNI_GET_METHOD_ID) // x0 = setAttrsMid
    const bailSetAttrsMidIdx: usize = b.count
    emit(&b, 0) // if setAttrsMid == NULL, bail (patched below)
    emit(&b, a64.strX(0, a64.SP, 64)) // save setAttrsMid

    // layoutParamsClass = FindClass(env, "android/view/WindowManager$LayoutParams")
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emitAdrpAdd(&b, textVaddr, 1, strLayoutParams)
    emitJniCall(&b, JNI_FIND_CLASS) // x0 = layoutParamsClass
    const bailLayoutParamsClassIdx: usize = b.count
    emit(&b, 0) // if layoutParamsClass == NULL, bail (patched below)
    emit(&b, a64.strX(0, a64.SP, 24)) // save layoutParamsClass
    emit(&b, a64.movReg64(9, 0)) // x9 = layoutParamsClass (kept live for the next call only)

    // cutoutModeFid = GetFieldID(env, layoutParamsClass, "layoutInDisplayCutoutMode", "I")
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emit(&b, a64.movReg64(1, 9)) // x1 = layoutParamsClass
    emitAdrpAdd(&b, textVaddr, 2, strCutoutField)
    emitAdrpAdd(&b, textVaddr, 3, strIntSig)
    emitJniCall(&b, JNI_GET_FIELD_ID) // x0 = cutoutModeFid
    const bailCutoutModeFidIdx: usize = b.count
    emit(&b, 0) // if cutoutModeFid == NULL, bail (patched below)
    emit(&b, a64.strX(0, a64.SP, 72)) // save cutoutModeFid

    // windowObj = CallObjectMethod(env, activityObj, getWindowMid)
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emit(&b, a64.ldrX(1, a64.SP, 8)) // x1 = activityObj
    emit(&b, a64.ldrX(2, a64.SP, 48)) // x2 = getWindowMid
    emitJniCall(&b, JNI_CALL_OBJECT_METHOD) // x0 = windowObj
    const bailWindowObjIdx: usize = b.count
    emit(&b, 0) // if windowObj == NULL, bail (patched below)
    emit(&b, a64.strX(0, a64.SP, 32)) // save windowObj

    // attrsObj = CallObjectMethod(env, windowObj, getAttrsMid)
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emit(&b, a64.ldrX(1, a64.SP, 32)) // x1 = windowObj
    emit(&b, a64.ldrX(2, a64.SP, 56)) // x2 = getAttrsMid
    emitJniCall(&b, JNI_CALL_OBJECT_METHOD) // x0 = attrsObj
    const bailAttrsObjIdx: usize = b.count
    emit(&b, 0) // if attrsObj == NULL, bail (patched below)
    emit(&b, a64.strX(0, a64.SP, 40)) // save attrsObj

    // attrsObj.layoutInDisplayCutoutMode = LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emit(&b, a64.ldrX(1, a64.SP, 40)) // x1 = attrsObj
    emit(&b, a64.ldrX(2, a64.SP, 72)) // x2 = cutoutModeFid
    emit(&b, a64.movz32(3, LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES, 0)) // w3 = 1
    emitJniCall(&b, JNI_SET_INT_FIELD)

    // window.setAttributes(attrsObj)
    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emit(&b, a64.ldrX(1, a64.SP, 32)) // x1 = windowObj
    emit(&b, a64.ldrX(2, a64.SP, 64)) // x2 = setAttrsMid
    emit(&b, a64.ldrX(3, a64.SP, 40)) // x3 = attrsObj
    emitJniCall(&b, JNI_CALL_VOID_METHOD)

    // cutoutBail: every early-out above lands here too. Clearing any
    // pending exception is harmless when none is pending (ExceptionClear
    // is documented as a no-op in that case) and required when one is, so
    // it's unconditional rather than guarded.
    const cutoutBail: usize = b.count
    b.words[bailActivityClassIdx] = a64.cbzX(0, (@intCast(i32, cutoutBail) - @intCast(i32, bailActivityClassIdx)) * 4)
    b.words[bailGetWindowMidIdx] = a64.cbzX(0, (@intCast(i32, cutoutBail) - @intCast(i32, bailGetWindowMidIdx)) * 4)
    b.words[bailWindowClassIdx] = a64.cbzX(0, (@intCast(i32, cutoutBail) - @intCast(i32, bailWindowClassIdx)) * 4)
    b.words[bailGetAttrsMidIdx] = a64.cbzX(0, (@intCast(i32, cutoutBail) - @intCast(i32, bailGetAttrsMidIdx)) * 4)
    b.words[bailSetAttrsMidIdx] = a64.cbzX(0, (@intCast(i32, cutoutBail) - @intCast(i32, bailSetAttrsMidIdx)) * 4)
    b.words[bailLayoutParamsClassIdx] = a64.cbzX(0, (@intCast(i32, cutoutBail) - @intCast(i32, bailLayoutParamsClassIdx)) * 4)
    b.words[bailCutoutModeFidIdx] = a64.cbzX(0, (@intCast(i32, cutoutBail) - @intCast(i32, bailCutoutModeFidIdx)) * 4)
    b.words[bailWindowObjIdx] = a64.cbzX(0, (@intCast(i32, cutoutBail) - @intCast(i32, bailWindowObjIdx)) * 4)
    b.words[bailAttrsObjIdx] = a64.cbzX(0, (@intCast(i32, cutoutBail) - @intCast(i32, bailAttrsObjIdx)) * 4)

    emit(&b, a64.ldrX(0, a64.SP, 0)) // x0 = env
    emitJniCall(&b, JNI_EXCEPTION_CLEAR)

    emit(&b, a64.ldrX(a64.LR, a64.SP, 80)) // restore LR
    emit(&b, a64.addImm64(a64.SP, a64.SP, 96))
    emit(&b, a64.ret(a64.LR))

    const colorForIndexStart: usize = b.count
    const colorForIndexVaddr: u64 = textVaddr + @intCast(u64, colorForIndexStart) * 4
    const patchPcColorForIndex: u64 = textVaddr + @intCast(u64, adrpColorForIndexIdx) * 4
    b.words[adrpColorForIndexIdx] = a64.adrp(3, patchPcColorForIndex, colorForIndexVaddr)
    b.words[adrpColorForIndexIdx + 1] = a64.addImm64(3, 3, @intCast(u32, colorForIndexVaddr & 4095))

    patchDirectCall(&b, textVaddr, callColorForIndexIdx, colorForIndexVaddr)

    // -- colorForIndex(w0 = KIND_*) -> w0 = RGBA color -- leaf.
    // Used by showKind and by onCreate's savedState restore. Any
    // out-of-range value (never written by this code) falls back to blue.
    emit(&b, a64.cmpImm32(0, KIND_MAX))
    const cfiOutOfRangeIdx: usize = b.count
    emit(&b, 0) // if (kind > KIND_MAX, unsigned) default (patched below)
    emit(&b, a64.uxtbW(10, 0)) // x10 = kind, zero-extended
    const cfiTableAdrpIdx: usize = b.count
    emit(&b, 0) // placeholder ADRP x9, table
    emit(&b, 0) // placeholder ADD  x9, x9, #lo12
    emit(&b, a64.addRegLsl64(9, 9, 10, 2)) // x9 = &table[kind]
    emit(&b, a64.ldrW(0, 9, 0))
    emit(&b, a64.ret(a64.LR))
    const cfiDefault: usize = b.count
    b.words[cfiOutOfRangeIdx] = a64.bCond(a64.COND_HI, delta(cfiOutOfRangeIdx, cfiDefault))
    emit(&b, a64.movz32(0, BLUE_RGBA8888_LE & 0xffff, 0))
    emit(&b, a64.movk32(0, (BLUE_RGBA8888_LE >> 16) & 0xffff, 1))
    emit(&b, a64.ret(a64.LR))
    // The color table, indexed by KIND_*: data words, never executed (both
    // paths above return before reaching it).
    const cfiTableVaddr: u64 = textVaddr + @intCast(u64, b.count) * 4
    emit(&b, BLUE_RGBA8888_LE) // KIND_NONE
    emit(&b, GREEN_RGBA8888_LE) // KIND_TAP
    emit(&b, YELLOW_RGBA8888_LE) // KIND_LONG_PRESS
    emit(&b, RED_RGBA8888_LE) // KIND_SWIPE_RIGHT
    emit(&b, MAGENTA_RGBA8888_LE) // KIND_SWIPE_LEFT
    emit(&b, CYAN_RGBA8888_LE) // KIND_SWIPE_DOWN
    emit(&b, ORANGE_RGBA8888_LE) // KIND_SWIPE_UP
    const cfiTablePc: u64 = textVaddr + @intCast(u64, cfiTableAdrpIdx) * 4
    b.words[cfiTableAdrpIdx] = a64.adrp(9, cfiTablePc, cfiTableVaddr)
    b.words[cfiTableAdrpIdx + 1] = a64.addImm64(9, 9, @intCast(u32, cfiTableVaddr & 4095))

    const saveInstanceStateStart: usize = b.count
    const saveInstanceStateVaddr: u64 = textVaddr + @intCast(u64, saveInstanceStateStart) * 4
    const patchPcSaveInstanceState: u64 = textVaddr + @intCast(u64, adrpSaveInstanceStateIdx) * 4
    b.words[adrpSaveInstanceStateIdx] = a64.adrp(10, patchPcSaveInstanceState, saveInstanceStateVaddr)
    b.words[adrpSaveInstanceStateIdx + 1] = a64.addImm64(10, 10, @intCast(u32, saveInstanceStateVaddr & 4095))

    // -- onSaveInstanceState(x0=activity[unused], x1=outLen) -> x0=void* --
    // Called on the OLD activity instance before it's destroyed (e.g. by
    // the destroy-and-recreate a rotation now triggers) -- the other half
    // of onCreate's savedState-restore path above. Per the real NDK
    // contract: "the returned data will be freed by the caller using
    // free(), so this data should be allocated using malloc()" -- this
    // project's first use of libc's allocator (elf_so.mlx's second
    // DT_NEEDED, `libc.so`, added just for this). `*outLen` (a `size_t*`,
    // 8 bytes on this LP64 ABI, not 4) must be filled in with however many
    // bytes were allocated.
    // Stack frame (32 bytes): [0]=allocated ptr, [8]=saved outLen(x1),
    // [16]=saved LR.
    emit(&b, a64.subImm64(a64.SP, a64.SP, 32))
    emit(&b, a64.strX(a64.LR, a64.SP, 16)) // save LR (non-leaf: calls malloc via BLR)
    emit(&b, a64.strX(1, a64.SP, 8)) // save outLen ptr

    emit(&b, a64.movz32(0, 4, 0)) // x0 = 4 (bytes to allocate: one u32 color index)
    emitGotCall(&b, textVaddr, 9, got.malloc) // x0 = malloc(4)
    emit(&b, a64.strX(0, a64.SP, 0)) // save allocated ptr

    emitAdrpAdd(&b, textVaddr, 9, dataVaddr + DATA_OFFSET_COLOR_INDEX)
    emit(&b, a64.ldrW(10, 9, 0)) // w10 = g_colorIndex
    emit(&b, a64.ldrX(0, a64.SP, 0)) // reload allocated ptr
    emit(&b, a64.strW(10, 0, 0)) // *ptr = g_colorIndex

    emit(&b, a64.ldrX(1, a64.SP, 8)) // reload outLen ptr
    emit(&b, a64.movz32(9, 4, 0)) // x9 = 4 (movz32 zero-extends into the full 64-bit x9, so this is a correct 8-byte size_t value, not just the low 32 bits)
    emit(&b, a64.strX(9, 1, 0)) // *outLen = 4

    emit(&b, a64.ldrX(0, a64.SP, 0)) // return value = allocated ptr
    emit(&b, a64.ldrX(a64.LR, a64.SP, 16)) // restore LR
    emit(&b, a64.addImm64(a64.SP, a64.SP, 32))
    emit(&b, a64.ret(a64.LR))

    const inputQueueDestroyedStart: usize = b.count
    const inputQueueDestroyedVaddr: u64 = textVaddr + @intCast(u64, inputQueueDestroyedStart) * 4
    const patchPcInputQueueDestroyed: u64 = textVaddr + @intCast(u64, adrpInputQueueDestroyedIdx) * 4
    b.words[adrpInputQueueDestroyedIdx] = a64.adrp(10, patchPcInputQueueDestroyed, inputQueueDestroyedVaddr)
    b.words[adrpInputQueueDestroyedIdx + 1] = a64.addImm64(10, 10, @intCast(u32, inputQueueDestroyedVaddr & 4095))

    // -- onInputQueueDestroyed(x0=activity[unused], x1=queue) --
    // Real-device feedback: combining rotation with touch input broke.
    // Root cause: this activity's input queue was never detached from its
    // ALooper before being torn down. A rotation now destroys and
    // recreates the whole activity (see axml.mlx's configChanges
    // comment), which destroys the OLD instance's input queue too -- and
    // per the real NDK docs, `AInputQueue_detachLooper` must be called
    // before that happens, exactly what `onInputQueueDestroyed` exists
    // for (android_native_app_glue.c's own internal plumbing does this
    // same call in its own onInputQueueDestroyed handler). Without it, the
    // stale attachment from the old, now-destroyed queue/looper pairing
    // was left dangling right as the new instance's onInputQueueCreated
    // (above) set up a fresh one -- consistent with input only misbehaving
    // specifically around a rotation, not otherwise.
    emit(&b, a64.subImm64(a64.SP, a64.SP, 16))
    emit(&b, a64.strX(a64.LR, a64.SP, 0)) // save LR (non-leaf: calls AInputQueue_detachLooper via BLR)
    // A touch still in progress belonged to this queue; its UP/CANCEL will
    // never arrive, so stop tracking it (the long-press timer checks this).
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.strW(a64.XZR, 9, off(DATA_OFFSET_TRACKING)))
    emit(&b, a64.movReg64(0, 1)) // x0 = queue
    emitGotCall(&b, textVaddr, 9, got.inputQueueDetachLooper)
    emit(&b, a64.ldrX(a64.LR, a64.SP, 0)) // restore LR
    emit(&b, a64.addImm64(a64.SP, a64.SP, 16))
    emit(&b, a64.ret(a64.LR))

    const windowDestroyedStart: usize = b.count
    const windowDestroyedVaddr: u64 = textVaddr + @intCast(u64, windowDestroyedStart) * 4
    const patchPcWindowDestroyed: u64 = textVaddr + @intCast(u64, adrpWindowDestroyedIdx) * 4
    b.words[adrpWindowDestroyedIdx] = a64.adrp(10, patchPcWindowDestroyed, windowDestroyedVaddr)
    b.words[adrpWindowDestroyedIdx + 1] = a64.addImm64(10, 10, @intCast(u32, windowDestroyedVaddr & 4095))

    // -- onNativeWindowDestroyed(x0=activity, x1=window) -- leaf.
    // The window is released once this returns: forget it so showKind
    // skips repainting until onNativeWindowCreated hands over a new one.
    emitAdrpAdd(&b, textVaddr, 9, dataVaddr)
    emit(&b, a64.strX(a64.XZR, 9, off(DATA_OFFSET_WINDOW)))
    emit(&b, a64.ret(a64.LR))

    return b
}
