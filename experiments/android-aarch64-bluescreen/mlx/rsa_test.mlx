// End-to-end integration test for bignum.mlx's RSA-keygen building blocks:
// generates a keypair the same way jar_sign.mlx's generateKeyPair will (two
// random primes, n = p*q, e = 65537, d = modInverse(e, phi)), then confirms
// the RSA identity modPow(modPow(msg, e, n), d, n) == msg for several
// messages. This is the real-world combination bignum_test.mlx's
// individual-operation checks don't exercise together: randomPrime ->
// isProbablePrime -> modPow (via Miller-Rabin) -> modInverse -> modPow (the
// actual RSA operation) -- and, just as importantly, it's what caught the
// severe arena-exhaustion compiler bug documented at the top of bignum.mlx
// and in docs/internals/selfhost-compiler.md: none of bignum_test.mlx's
// individual small-number checks loop enough times to trigger it.
//
// 512-bit primes (1024-bit modulus): see bignum.mlx's header comment for
// why this port's key size is smaller than the Zig prototype's real-build
// default (2048 bits) -- both an O(bits x limbs) division algorithm and,
// more fundamentally, the 256 MiB aggregate-local arena limit the practical
// ceiling here. Runs in roughly a minute.
const std = @import("std")
const bn = @import("./bignum.mlx")

pub fn main() -> u32 {
    var failures: u32 = 0

    var p: bn.BigUint = undefined
    bn.randomPrime(&p, 512)
    var q: bn.BigUint = undefined
    bn.randomPrime(&q, 512)

    var n: bn.BigUint = undefined
    bn.mulTo(&n, &p, &q)

    var one: bn.BigUint = undefined
    bn.setU64(&one, 1)
    var pMinus1: bn.BigUint = undefined
    bn.subTo(&pMinus1, &p, &one)
    var qMinus1: bn.BigUint = undefined
    bn.subTo(&qMinus1, &q, &one)
    var phi: bn.BigUint = undefined
    bn.mulTo(&phi, &pMinus1, &qMinus1)

    var e: bn.BigUint = undefined
    bn.setU64(&e, 65537)
    var d: bn.BigUint = undefined
    bn.modInverse(&d, &e, &phi)

    // e*d mod phi == 1
    var ed: bn.BigUint = undefined
    bn.mulTo(&ed, &e, &d)
    var edq: bn.BigUint = undefined
    var edr: bn.BigUint = undefined
    bn.divMod(&edq, &edr, &ed, &phi)
    if bn.cmp(&edr, &one) == 0 {
        var w: bool = std.io.println("e*d mod phi == 1: ok")
    } else {
        var w: bool = std.io.println("e*d mod phi == 1: WRONG")
        failures = failures | 1
    }

    // Round-trip several messages through encrypt (modPow e) / decrypt
    // (modPow d) and check we get the original back.
    var messages: [4]u64 = [4]u64{1, 2, 12345, 999999}
    var msg: bn.BigUint = undefined
    var cipher: bn.BigUint = undefined
    var decoded: bn.BigUint = undefined
    var mi: usize = 0
    var allRoundTripsOk: bool = true
    while mi < 4 {
        bn.setU64(&msg, messages[mi])
        bn.modPow(&cipher, &msg, &e, &n)
        bn.modPow(&decoded, &cipher, &d, &n)
        if bn.cmp(&decoded, &msg) != 0 { allRoundTripsOk = false }
        mi += 1
    }
    if allRoundTripsOk {
        var w: bool = std.io.println("RSA encrypt/decrypt round-trip: ok")
    } else {
        var w: bool = std.io.println("RSA encrypt/decrypt round-trip: WRONG")
        failures = failures | 2
    }

    if failures == 0 {
        var w: bool = std.io.println("ALL RSA TESTS PASSED")
    }
    return failures
}
