const std = @import("std")
const a64 = @import("./aarch64.mlx")

fn check(f: u8, ok: bool, name: []const u8) -> u8 {
    if ok { return f }
    if !std.io.print("FAIL ") { return f | 1 }
    if !std.io.println(name) { return f | 1 }
    return f | 1
}

pub fn main() -> u8 {
    var f: u8 = 0
    f = check(f, a64.movz64(0, 0x1234, 0) == 0xD2824680, "movz64")
    f = check(f, a64.movk64(0, 1, 1) == 0xF2A00020, "movk64")
    f = check(f, a64.addImm64(0, 0, 0) == 0x91000000, "addImm64")
    f = check(f, a64.subImm64(a64.SP, a64.SP, 16) == 0xD10043FF, "subImm64")
    f = check(f, a64.adrp(0, 0x1000, 0x1000) == 0x90000000, "adrp same page")
    f = check(f, a64.adrp(0, 0x1000, 0x2000) == 0xB0000000, "adrp +1 page")
    f = check(f, a64.adrp(9, 0x1000, 0x0000) == 0xF0FFFFE9, "adrp -1 page")
    f = check(f, a64.ldrX(0, 1, 0) == 0xF9400020, "ldrX")
    f = check(f, a64.strX(0, 1, 8) == 0xF9000420, "strX")
    f = check(f, a64.ldrW(0, 1, 4) == 0xB9400420, "ldrW")
    f = check(f, a64.mul64(0, 1, 2) == 0x9B027C20, "mul64")
    f = check(f, a64.cbnzX(9, -8) == 0xB5FFFFC9, "cbnzX")
    f = check(f, a64.cbzX(0, 8) == 0xB4000040, "cbzX")
    f = check(f, a64.ret(a64.LR) == 0xD65F03C0, "ret")
    f = check(f, a64.blr(9) == 0xD63F0120, "blr")
    f = check(f, a64.movReg64(0, 1) == 0xAA0103E0, "movReg64")
    f = check(f, a64.strwPostIndex(9, 8, 4) == 0xB8004509, "strwPostIndex")
    f = check(f, a64.udf(0) == 0x00000000, "udf")
    f = check(f, a64.b(8) == 0x14000002, "b +8")
    f = check(f, a64.b(-8) == 0x17FFFFFE, "b -8")
    f = check(f, a64.b(1048572) == 0x1403FFFF, "b +1048572")
    f = check(f, a64.tbnz(0, 31, 8) == 0x37F80040, "tbnz w0,#31,+8")
    f = check(f, a64.tbz(0, 31, 8) == 0x36F80040, "tbz w0,#31,+8")
    f = check(f, a64.tbnz(9, 0, 16) == 0x37000089, "tbnz w9,#0,+16")
    f = check(f, a64.tbnz(9, 33, 8) == 0xB7080049, "tbnz x9,#33,+8")

    if f == 0 {
        if !std.io.println("ALL AARCH64 ENCODER TESTS PASSED") { return 1 }
    }
    return f
}
