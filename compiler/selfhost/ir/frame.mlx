// The frame's places packed (compact): after the optimizer, the places
// a function's locals were given (lir.Opcode.frame_local, arg0 the
// depth below the frame pointer, arg1 the place's bytes) are fewer than
// the client laid out, as the regions region_loads folded and dropped
// are gone with their copies. The places still reached are renumbered
// from the top, each at its alignment (16 from 16 bytes on, else 8),
// and the client sizes the frame by what is left. Nothing moves when a
// place's size is unknown (arg1 NONE) or two places overlap (the
// layout is not one of distinct places), or when nothing is saved.

const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const lir = @import("./lir.mlx")

pub const Result = struct {
    // The frame's bytes below the frame pointer after the pass (the
    // client's when nothing moved).
    bytes: usize
    // The places kept, and the places the client laid out that are gone.
    kept: usize
    dropped: usize
    moved: bool
}

// Packs the places and gives the frame's new size: `bytes` is the
// client's frame (the places' bytes, 16-aligned).
pub fn compact(ir: *lir.Lir, allocator: allocator_module.Allocator, bytes: usize) -> Result {
    var result = Result.{ .bytes = bytes, .kept = 0, .dropped = 0, .moved = false }
    const count = lir.instCount(ir)
    var places: usize = 0
    var index: usize = 0
    while index < count {
        const inst = lir.getInst(ir, index)
        if inst.opcode == lir.Opcode.frame_local && @bitCast(i64, @intCast(u64, inst.arg0)) > 0 {
            if inst.arg1 == lir.NONE { return result }
            places += 1
        }
        index += 1
    }
    if places == 0 {
        result.bytes = 0
        result.moved = bytes != 0
        return result
    }
    // The distinct places: depth and size (the largest asked of one
    // depth).
    const depths_memory = allocator.alloc(places * @sizeOf(usize), @alignOf(usize))
    const sizes_memory = allocator.alloc(places * @sizeOf(usize), @alignOf(usize))
    const news_memory = allocator.alloc(places * @sizeOf(usize), @alignOf(usize))
    if depths_memory == null || sizes_memory == null || news_memory == null { return result }
    const depths = unsafe { @ptrCast([*]usize, depths_memory.?) }
    const sizes = unsafe { @ptrCast([*]usize, sizes_memory.?) }
    const news = unsafe { @ptrCast([*]usize, news_memory.?) }
    var distinct: usize = 0
    index = 0
    while index < count {
        const inst = lir.getInst(ir, index)
        if inst.opcode == lir.Opcode.frame_local && @bitCast(i64, @intCast(u64, inst.arg0)) > 0 {
            var found = distinct
            var at: usize = 0
            while at < distinct {
                if depths[at] == inst.arg0 {
                    found = at
                    break
                }
                at += 1
            }
            if found == distinct {
                depths[distinct] = inst.arg0
                sizes[distinct] = inst.arg1
                distinct += 1
            } else if inst.arg1 > sizes[found] {
                sizes[found] = inst.arg1
            }
        }
        index += 1
    }
    // Sorted by depth (an insertion sort: a few hundred at most).
    var i: usize = 1
    while i < distinct {
        const depth = depths[i]
        const size = sizes[i]
        var j = i
        while j > 0 && depths[j - 1] > depth {
            depths[j] = depths[j - 1]
            sizes[j] = sizes[j - 1]
            j -= 1
        }
        depths[j] = depth
        sizes[j] = size
        i += 1
    }
    // A place at depth d holds the bytes (d - size, d] below the frame
    // pointer: the next deeper one must start below it.
    var ok = true
    i = 1
    while i < distinct {
        if depths[i] - sizes[i] < depths[i - 1] { ok = false }
        i += 1
    }
    var depth: usize = 0
    if ok {
        i = 0
        while i < distinct {
            const alignment: usize = if sizes[i] >= 16 { 16 } else { 8 }
            depth = (depth + sizes[i] + alignment - 1) & ~(alignment - 1)
            news[i] = depth
            i += 1
        }
        depth = (depth + 15) & ~@intCast(usize, 15)
    }
    result.kept = distinct
    if ok && depth < bytes {
        index = 0
        while index < count {
            var inst = lir.getInst(ir, index)
            if inst.opcode == lir.Opcode.frame_local && @bitCast(i64, @intCast(u64, inst.arg0)) > 0 {
                i = 0
                while i < distinct {
                    if depths[i] == inst.arg0 {
                        inst.arg0 = news[i]
                        lir.setInst(ir, index, inst)
                        break
                    }
                    i += 1
                }
            }
            index += 1
        }
        result.bytes = depth
        result.moved = true
    }
    allocator.free(depths_memory.?, places * @sizeOf(usize), @alignOf(usize))
    allocator.free(sizes_memory.?, places * @sizeOf(usize), @alignOf(usize))
    allocator.free(news_memory.?, places * @sizeOf(usize), @alignOf(usize))
    return result
}
