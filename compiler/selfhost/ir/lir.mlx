const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const array_list = @import("../../../std/bootstrap/array_list.mlx")
const vector = @import("../../../std/bootstrap/vector.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")

pub const Allocator = allocator_module.Allocator

pub const Opcode = enum(u8) {
    const_i,
    const_f,
    copy,
    cast,
    bitcast,
    aggregate_copy,
    add,
    sub,
    mul,
    div,
    rem,
    udiv,
    urem,
    bit_and,
    bit_or,
    bit_xor,
    shl,
    shr,
    icmp,
    fcmp,
    load,
    store,
    addr,
    alloca,
    gep,
    func_sym,
    label,
    br,
    condbr,
    icmp_br,
    call,
    direct_call,
    syscall,
    ret,
    ret_slice,
    ret_error,
    ret_error_union,
    unreachable_inst,
    param,
    error_test,
    error_payload,
    error_payload_part,
    builtin_sym,
    string_literal,
    tuple_literal,
    tuple_element,
    dead,
}

pub const CmpPredicate = enum(u8) {
    eq,
    ne,
    lt,
    le,
    gt,
    ge,
    ult,
    ule,
    ugt,
    uge,
}

pub const Inst = struct {
    opcode: Opcode
    flags: u8
    typeId: usize
    arg0: usize
    arg1: usize
    arg2: usize
}

pub const NONE: usize = 18446744073709551615
pub const FLAG_RETAIN_NEXT: u8 = 1

pub fn initInst(opcode: Opcode, type_id: usize) -> Inst {
    return Inst.{
        .opcode = opcode,
        .flags = 0,
        .typeId = type_id,
        .arg0 = NONE,
        .arg1 = NONE,
        .arg2 = NONE,
    }
}

pub fn constI(type_id: usize, value: usize) -> Inst {
    var inst = initInst(Opcode.const_i, type_id)
    inst.arg0 = value
    return inst
}

pub fn binary(op: Opcode, type_id: usize, lhs: usize, rhs: usize) -> Inst {
    var inst = initInst(op, type_id)
    inst.arg0 = lhs
    inst.arg1 = rhs
    return inst
}

pub fn branch(dest: usize) -> Inst {
    var inst = initInst(Opcode.br, NONE)
    inst.arg0 = dest
    return inst
}

pub fn condBranch(cond: usize, true_dest: usize, false_dest: usize) -> Inst {
    var inst = initInst(Opcode.condbr, NONE)
    inst.arg0 = cond
    inst.arg1 = true_dest
    inst.arg2 = false_dest
    return inst
}

pub fn callInst(type_id: usize, func: usize, args_start: usize, args_count: usize) -> Inst {
    var inst = initInst(Opcode.call, type_id)
    inst.arg0 = func
    inst.arg1 = args_start
    inst.arg2 = args_count
    return inst
}

pub fn directCallInst(type_id: usize, symbol: usize, args_start: usize, args_count: usize) -> Inst {
    var inst = initInst(Opcode.direct_call, type_id)
    inst.arg0 = symbol
    inst.arg1 = args_start
    inst.arg2 = args_count
    return inst
}

pub fn retInst(type_id: usize, value: usize) -> Inst {
    var inst = initInst(Opcode.ret, type_id)
    inst.arg0 = value
    return inst
}

pub fn labelInst(type_id: usize, symbol_id: usize) -> Inst {
    var inst = initInst(Opcode.label, type_id)
    inst.arg0 = symbol_id
    return inst
}

pub fn blockLabelInst(block_id: usize) -> Inst {
    var inst = initInst(Opcode.label, NONE)
    inst.arg1 = block_id
    return inst
}

pub const Symbol = struct {
    pointer: [*]const u8
    length: usize
}

pub const StringLiteral = struct {
    pointer: [*]const u8
    length: usize
    namePointer: [*]const u8
    nameLength: usize
}

pub const Lir = struct {
    instructions: *vector.Vector
    extraData: *vector.Vector
    symbols: *vector.Vector
    ownedSymbolNames: *vector.Vector
    stringLiterals: *vector.Vector
    allocatorContext: usize
    allocFn: allocator_module.AllocFn
    resizeFn: allocator_module.ResizeFn
    freeFn: allocator_module.FreeFn
}

pub fn initCapacity(allocator: Allocator, instruction_capacity: usize, extra_capacity: usize) -> Lir {
    unsafe {
        const instructions = @ptrCast(*vector.Vector, allocator.allocFn(allocator.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const extra_data = @ptrCast(*vector.Vector, allocator.allocFn(allocator.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const symbols = @ptrCast(*vector.Vector, allocator.allocFn(allocator.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const owned_symbol_names = @ptrCast(*vector.Vector, allocator.allocFn(allocator.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const string_literals = @ptrCast(*vector.Vector, allocator.allocFn(allocator.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        vector.Vector.initAt(instructions, allocator, @sizeOf(Inst), @alignOf(Inst), instruction_capacity)
        vector.Vector.initAt(extra_data, allocator, @sizeOf(usize), @alignOf(usize), extra_capacity)
        vector.Vector.initAt(symbols, allocator, @sizeOf(Symbol), @alignOf(Symbol), 16)
        vector.Vector.initAt(owned_symbol_names, allocator, @sizeOf(array_list.ArrayList), @alignOf(array_list.ArrayList), 32)
        vector.Vector.initAt(string_literals, allocator, @sizeOf(StringLiteral), @alignOf(StringLiteral), 16)
        return Lir.{
            .instructions = instructions,
            .extraData = extra_data,
            .symbols = symbols,
            .ownedSymbolNames = owned_symbol_names,
            .stringLiterals = string_literals,
            .allocatorContext = allocator.context,
            .allocFn = allocator.allocFn,
            .resizeFn = allocator.resizeFn,
            .freeFn = allocator.freeFn,
        }
    }
}

pub fn init(allocator: Allocator) -> Lir {
    return initCapacity(allocator, 64, 64)
}

inline fn instAt(lir: *Lir, index: usize) -> *Inst {
    unsafe { return @ptrFromInt(*Inst, @intFromPtr(lir.*.instructions.*.items) + index * @sizeOf(Inst)) }
}

pub fn addInst(lir: *Lir, inst: Inst) -> usize {
    const instructions = lir.*.instructions
    if instructions.*.length == instructions.*.capacity {
        const capacity = instructions.*.capacity * 2
        instructions.*.items = instructions.*.resizeFn(instructions.*.allocatorContext, instructions.*.items, instructions.*.capacity * @sizeOf(Inst), capacity * @sizeOf(Inst), @alignOf(Inst)).?
        instructions.*.capacity = capacity
    }
    const index = instructions.*.length
    const destination = instAt(lir, index)
    destination.*.opcode = inst.opcode
    destination.*.flags = inst.flags
    destination.*.typeId = inst.typeId
    destination.*.arg0 = inst.arg0
    destination.*.arg1 = inst.arg1
    destination.*.arg2 = inst.arg2
    instructions.*.length += 1
    return index
}

pub inline fn getInst(lir: *Lir, index: usize) -> Inst {
    return instAt(lir, index).*
}

pub fn setInst(lir: *Lir, index: usize, inst: Inst) -> void {
    const destination = instAt(lir, index)
    destination.*.opcode = inst.opcode
    destination.*.flags = inst.flags
    destination.*.typeId = inst.typeId
    destination.*.arg0 = inst.arg0
    destination.*.arg1 = inst.arg1
    destination.*.arg2 = inst.arg2
}

pub inline fn instCount(lir: *Lir) -> usize {
    return lir.*.instructions.*.length
}

pub inline fn symbolCount(lir: *Lir) -> usize { return lir.*.symbols.*.length }

pub inline fn extraDataCount(lir: *Lir) -> usize { return lir.*.extraData.*.length }

pub fn addExtra(lir: *Lir, value: usize) -> usize {
    const extra_data = lir.*.extraData
    if extra_data.*.length == extra_data.*.capacity {
        const capacity = extra_data.*.capacity * 2
        extra_data.*.items = extra_data.*.resizeFn(extra_data.*.allocatorContext, extra_data.*.items, extra_data.*.capacity * @sizeOf(usize), capacity * @sizeOf(usize), @alignOf(usize)).?
        extra_data.*.capacity = capacity
    }
    const index = extra_data.*.length
    unsafe { @ptrFromInt(*usize, @intFromPtr(extra_data.*.items) + index * @sizeOf(usize)).* = value }
    extra_data.*.length += 1
    return index
}

pub inline fn getExtra(lir: *Lir, index: usize) -> usize {
    unsafe {
        return @ptrFromInt(*usize, @intFromPtr(lir.*.extraData.*.items) + index * @sizeOf(usize)).*
    }
}

pub fn setExtra(lir: *Lir, index: usize, value: usize) -> void {
    unsafe {
        @ptrFromInt(*usize, @intFromPtr(lir.*.extraData.*.items) + index * @sizeOf(usize)).* = value
    }
}

pub fn addSymbol(lir: *Lir, pointer: [*]const u8, length: usize) -> usize {
    const symbols = lir.*.symbols
    if symbols.*.length == symbols.*.capacity {
        const capacity = symbols.*.capacity * 2
        symbols.*.items = symbols.*.resizeFn(symbols.*.allocatorContext, symbols.*.items, symbols.*.capacity * @sizeOf(Symbol), capacity * @sizeOf(Symbol), @alignOf(Symbol)).?
        symbols.*.capacity = capacity
    }
    const index = symbols.*.length
    unsafe {
        const destination = @ptrFromInt(*Symbol, @intFromPtr(symbols.*.items) + index * @sizeOf(Symbol))
        destination.*.pointer = pointer
        destination.*.length = length
    }
    symbols.*.length += 1
    return index
}

pub fn addModuleSymbol(lir: *Lir, module_id: usize, pointer: [*]const u8, length: usize, is_entry: bool) -> usize {
    if is_entry { return addSymbol(lir, pointer, length) }
    var allocator = allocator_module.Allocator.{
        .context = lir.*.allocatorContext,
        .allocFn = lir.*.allocFn,
        .resizeFn = lir.*.resizeFn,
        .freeFn = lir.*.freeFn,
    }
    var name = array_list.ArrayList.init(allocator, length + 24)
    name = array_list.ArrayList.append(name, 46)
    name = array_list.ArrayList.append(name, 109)
    if module_id == 0 {
        name = array_list.ArrayList.append(name, 48)
    } else {
        var divisor: usize = 1
        while module_id / divisor >= 10 { divisor = divisor * 10 }
        while divisor > 0 {
            name = array_list.ArrayList.append(name, @intCast(u8, 48 + (module_id / divisor) % 10))
            divisor = divisor / 10
        }
    }
    name = array_list.ArrayList.append(name, 46)
    var byte_index: usize = 0
    while byte_index < length {
        name = array_list.ArrayList.append(name, pointer[byte_index])
        byte_index += 1
    }
    const symbol_id = addSymbol(lir, name.items, name.length)
    unsafe {
        const appended = vector.Vector.appendAt(lir.*.ownedSymbolNames, @ptrCast([*]const u8, &name))
    }
    return symbol_id
}

pub fn addMethodSymbol(lir: *Lir, module_id: usize, owner_type: usize, pointer: [*]const u8, length: usize) -> usize {
    var allocator = allocator_module.Allocator.{
        .context = lir.*.allocatorContext,
        .allocFn = lir.*.allocFn,
        .resizeFn = lir.*.resizeFn,
        .freeFn = lir.*.freeFn,
    }
    var name = array_list.ArrayList.init(allocator, length + 48)
    name = array_list.ArrayList.append(name, 46)
    name = array_list.ArrayList.append(name, 109)
    var module_divisor: usize = 1
    while module_id / module_divisor >= 10 { module_divisor *= 10 }
    while module_divisor > 0 {
        name = array_list.ArrayList.append(name, @intCast(u8, 48 + (module_id / module_divisor) % 10))
        module_divisor /= 10
    }
    name = array_list.ArrayList.append(name, 46)
    name = array_list.ArrayList.append(name, 116)
    var type_divisor: usize = 1
    while owner_type / type_divisor >= 10 { type_divisor *= 10 }
    while type_divisor > 0 {
        name = array_list.ArrayList.append(name, @intCast(u8, 48 + (owner_type / type_divisor) % 10))
        type_divisor /= 10
    }
    name = array_list.ArrayList.append(name, 46)
    var byte_index: usize = 0
    while byte_index < length {
        name = array_list.ArrayList.append(name, pointer[byte_index])
        byte_index += 1
    }
    const symbol_id = addSymbol(lir, name.items, name.length)
    unsafe {
        const appended = vector.Vector.appendAt(lir.*.ownedSymbolNames, @ptrCast([*]const u8, &name))
    }
    return symbol_id
}

pub fn addGenericModuleSymbol(lir: *Lir, module_id: usize, pointer: [*]const u8, length: usize, instance_id: usize) -> usize {
    var allocator = allocator_module.Allocator.{
        .context = lir.*.allocatorContext,
        .allocFn = lir.*.allocFn,
        .resizeFn = lir.*.resizeFn,
        .freeFn = lir.*.freeFn,
    }
    var name = array_list.ArrayList.init(allocator, length + 40)
    name = array_list.ArrayList.append(name, 46)
    name = array_list.ArrayList.append(name, 109)
    var module_divisor: usize = 1
    while module_id / module_divisor >= 10 { module_divisor *= 10 }
    while module_divisor > 0 {
        name = array_list.ArrayList.append(name, @intCast(u8, 48 + (module_id / module_divisor) % 10))
        module_divisor /= 10
    }
    name = array_list.ArrayList.append(name, 46)
    var byte_index: usize = 0
    while byte_index < length {
        name = array_list.ArrayList.append(name, pointer[byte_index])
        byte_index += 1
    }
    name = array_list.ArrayList.append(name, 95)
    name = array_list.ArrayList.append(name, 95)
    name = array_list.ArrayList.append(name, 103)
    var instance_divisor: usize = 1
    while instance_id / instance_divisor >= 10 { instance_divisor *= 10 }
    while instance_divisor > 0 {
        name = array_list.ArrayList.append(name, @intCast(u8, 48 + (instance_id / instance_divisor) % 10))
        instance_divisor /= 10
    }
    const symbol_id = addSymbol(lir, name.items, name.length)
    unsafe {
        const appended = vector.Vector.appendAt(lir.*.ownedSymbolNames, @ptrCast([*]const u8, &name))
    }
    return symbol_id
}

pub inline fn getSymbol(lir: *Lir, index: usize) -> Symbol {
    unsafe {
        return @ptrFromInt(*Symbol, @intFromPtr(lir.*.symbols.*.items) + index * @sizeOf(Symbol)).*
    }
}

pub fn findSymbol(lir: *Lir, pointer: [*]const u8, length: usize) -> (bool, usize) {
    var i: usize = 0
    while i < lir.*.symbols.*.length {
        const sym = getSymbol(lir, i)
        if sym.length == length {
            if mem.eql(sym.pointer, pointer, length) {
                return -> (true, i)
            }
        }
        i += 1
    }
    return -> (false, 0)
}

pub fn addStringLiteral(lir: *Lir, pointer: [*]const u8, length: usize) -> usize {
    const index = lir.*.stringLiterals.*.length
    var allocator = Allocator.{
        .context = lir.*.allocatorContext,
        .allocFn = lir.*.allocFn,
        .resizeFn = lir.*.resizeFn,
        .freeFn = lir.*.freeFn,
    }
    var bytes = array_list.ArrayList.init(allocator, length)
    var source_index: usize = 0
    while source_index < length {
        var byte = pointer[source_index]
        if byte == 92 && source_index + 1 < length {
            source_index += 1
            const escaped = pointer[source_index]
            if escaped == 110 { byte = 10
            } else if escaped == 114 { byte = 13
            } else if escaped == 116 { byte = 9
            } else if escaped == 48 { byte = 0
            } else { byte = escaped }
        }
        bytes = array_list.ArrayList.append(bytes, byte)
        source_index += 1
    }
    const logical_length = bytes.length
    bytes = array_list.ArrayList.append(bytes, 0)
    // Relocations must target a private label rather than the literal bytes.
    // A literal such as "main" or "_start" may otherwise collide with a
    // function symbol of the same name and resolve into executable code.
    var name = array_list.ArrayList.init(allocator, 32)
    name = array_list.ArrayList.append(name, 46) // .
    name = array_list.ArrayList.append(name, 95) // _
    name = array_list.ArrayList.append(name, 109) // m
    name = array_list.ArrayList.append(name, 108) // l
    name = array_list.ArrayList.append(name, 120) // x
    name = array_list.ArrayList.append(name, 95) // _
    name = array_list.ArrayList.append(name, 115) // s
    name = array_list.ArrayList.append(name, 116) // t
    name = array_list.ArrayList.append(name, 114) // r
    name = array_list.ArrayList.append(name, 105) // i
    name = array_list.ArrayList.append(name, 110) // n
    name = array_list.ArrayList.append(name, 103) // g
    name = array_list.ArrayList.append(name, 95) // _
    if index == 0 {
        name = array_list.ArrayList.append(name, 48)
    } else {
        var divisor: usize = 1
        while index / divisor >= 10 { divisor *= 10 }
        while divisor > 0 {
            name = array_list.ArrayList.append(name, @intCast(u8, 48 + (index / divisor) % 10))
            divisor /= 10
        }
    }
    var lit = StringLiteral.{
        .pointer = bytes.items,
        .length = logical_length,
        .namePointer = name.items,
        .nameLength = name.length,
    }
    unsafe {
        const appended = vector.Vector.appendAt(lir.*.stringLiterals, @ptrCast([*]const u8, &lit))
        const retained_bytes = vector.Vector.appendAt(lir.*.ownedSymbolNames, @ptrCast([*]const u8, &bytes))
        const retained_name = vector.Vector.appendAt(lir.*.ownedSymbolNames, @ptrCast([*]const u8, &name))
    }
    return index
}

pub fn getStringLiteral(lir: *Lir, index: usize) -> StringLiteral {
    unsafe {
        const ptr = @ptrCast(*StringLiteral, vector.Vector.at(lir.*.stringLiterals.*, index))
        return ptr.*
    }
}

pub inline fn stringLiteralCount(lir: *Lir) -> usize {
    return lir.*.stringLiterals.*.length
}

pub fn deinit(lir: *Lir) -> void {
    var owned_index: usize = 0
    while owned_index < lir.*.ownedSymbolNames.*.length {
        unsafe {
            const name = @ptrCast(*array_list.ArrayList, vector.Vector.at(lir.*.ownedSymbolNames.*, owned_index))
            array_list.ArrayList.deinit(name.*)
        }
        owned_index += 1
    }
    vector.Vector.deinit(lir.*.instructions.*)
    vector.Vector.deinit(lir.*.extraData.*)
    vector.Vector.deinit(lir.*.symbols.*)
    vector.Vector.deinit(lir.*.ownedSymbolNames.*)
    vector.Vector.deinit(lir.*.stringLiterals.*)
    unsafe {
        lir.*.freeFn(lir.*.allocatorContext, @ptrCast([*]u8, lir.*.instructions), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        lir.*.freeFn(lir.*.allocatorContext, @ptrCast([*]u8, lir.*.extraData), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        lir.*.freeFn(lir.*.allocatorContext, @ptrCast([*]u8, lir.*.symbols), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        lir.*.freeFn(lir.*.allocatorContext, @ptrCast([*]u8, lir.*.ownedSymbolNames), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        lir.*.freeFn(lir.*.allocatorContext, @ptrCast([*]u8, lir.*.stringLiterals), @sizeOf(vector.Vector), @alignOf(vector.Vector))
    }
}
