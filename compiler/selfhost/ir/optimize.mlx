const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const control_flow_dce = @import("./control_flow_dce.mlx")
const escape = @import("./escape.mlx")
const registers = @import("./registers.mlx")
const function_dce = @import("./function_dce.mlx")
const lir = @import("./lir.mlx")
const operands = @import("./operands.mlx")
const single_store = @import("./single_store.mlx")

const Promotion = struct { locals: usize, stores: usize }

pub const Result = struct {
    instructionsBefore: usize
    instructionsAfter: usize
    constantsFolded: usize
    branchesSimplified: usize
    comparisonBranchesFused: usize
    loadsForwarded: usize
    copiesPropagated: usize
    localsPromoted: usize
    storesEliminated: usize
    functionsEliminated: usize
    functionInstructionsEliminated: usize
    postTerminatorInstructionsEliminated: usize
    blocksMerged: usize
    eliminated: usize
    // Aggregates moved from the arena into their function's frame
    // (escape.mlx), and their bytes.
    aggregatesInFrame: usize
    localsInRegisters: usize
    // Loads of locals stored once that became copies (single_store.mlx).
    singleStoreLoads: usize
    aggregateBytesInFrame: usize
    returnSlotMismatches: usize
}

pub fn run(ir: *lir.Lir, allocator: allocator_module.Allocator) -> Result { return runPasses(ir, allocator, true) }

// The passes within each function alone, for an LIR that holds one
// function of a program whose others are elsewhere (mlx-cc's, which
// lowers a C function at a time): no function is dropped for want of a
// caller in the LIR, and no allocation of the arena (it makes none) is
// looked for to move into the frame.
pub fn runLocal(ir: *lir.Lir, allocator: allocator_module.Allocator) -> Result { return runPasses(ir, allocator, false) }

fn runPasses(ir: *lir.Lir, allocator: allocator_module.Allocator, whole: bool) -> Result {
    const count = lir.instCount(ir)
    if count == 0 { return Result.{ .instructionsBefore = 0, .instructionsAfter = 0, .constantsFolded = 0, .branchesSimplified = 0, .comparisonBranchesFused = 0, .loadsForwarded = 0, .copiesPropagated = 0, .localsPromoted = 0, .storesEliminated = 0, .functionsEliminated = 0, .functionInstructionsEliminated = 0, .postTerminatorInstructionsEliminated = 0, .blocksMerged = 0, .eliminated = 0, .aggregatesInFrame = 0, .localsInRegisters = 0, .singleStoreLoads = 0, .aggregateBytesInFrame = 0, .returnSlotMismatches = 0 } }
    const memory = allocator.alloc(count * @sizeOf(usize), @alignOf(usize)).?
    const first_scratch = allocator.alloc(count * @sizeOf(usize), @alignOf(usize)).?
    const second_scratch = allocator.alloc(count * @sizeOf(usize), @alignOf(usize)).?
    unsafe {
        const uses = @ptrCast([*]usize, memory)
        const first = @ptrCast([*]usize, first_scratch)
        const second = @ptrCast([*]usize, second_scratch)
        var functions = function_dce.Result.{ .functionsEliminated = 0, .instructionsEliminated = 0 }
        if whole { functions = function_dce.run(ir, allocator) }
        var simplified: usize = 0
        var post_terminator = control_flow_dce.eliminatePostTerminator(ir)
        var merged = control_flow_dce.mergeFallthroughBlocks(ir, allocator)
        var folded = foldConstants(ir, count, &simplified)
        const forwarded = forwardLocalLoads(ir, first, second, count)
        const single = single_store.run(ir, allocator)
        const propagated = propagateCopies(ir, first, count)
        folded += foldConstants(ir, count, &simplified)
        post_terminator += control_flow_dce.eliminatePostTerminator(ir)
        merged += control_flow_dce.mergeFallthroughBlocks(ir, allocator)
        zero(uses, count)
        recordUses(ir, uses, count)
        const fused = fuseComparisonBranches(ir, uses, count)
        const promoted = promoteLocals(ir, uses, first, second, count)
        const eliminated = eliminateUnused(ir, uses, count)
        markRetentionHints(ir, uses, count)
        var moved = escape.Result.{ .regions = 0, .bytes = 0, .slotMismatches = 0 }
        if whole { moved = escape.run(ir, allocator) }
        const held = registers.run(ir, allocator)
        allocator.free(memory, count * @sizeOf(usize), @alignOf(usize))
        allocator.free(first_scratch, count * @sizeOf(usize), @alignOf(usize))
        allocator.free(second_scratch, count * @sizeOf(usize), @alignOf(usize))
        return Result.{ .instructionsBefore = count, .instructionsAfter = count - functions.instructionsEliminated - post_terminator - 2 * merged - eliminated - promoted.stores - promoted.locals - fused, .blocksMerged = merged, .constantsFolded = folded, .branchesSimplified = simplified, .comparisonBranchesFused = fused, .loadsForwarded = forwarded, .copiesPropagated = propagated, .localsPromoted = promoted.locals, .storesEliminated = promoted.stores, .functionsEliminated = functions.functionsEliminated, .functionInstructionsEliminated = functions.instructionsEliminated, .postTerminatorInstructionsEliminated = post_terminator, .eliminated = eliminated, .aggregatesInFrame = moved.regions, .localsInRegisters = held, .singleStoreLoads = single, .aggregateBytesInFrame = moved.bytes, .returnSlotMismatches = moved.slotMismatches }
    }
}

fn canonicalValue(canonical: [*]usize, count: usize, value: usize) -> usize {
    if value == lir.NONE || value >= count { return value }
    return canonical[value]
}

fn rewriteExtraUses(ir: *lir.Lir, start: usize, length: usize, canonical: [*]usize, count: usize) -> usize {
    var rewritten: usize = 0
    var offset: usize = 0
    while offset < length {
        const index = start + offset
        const previous = lir.getExtra(ir, index)
        const replacement = canonicalValue(canonical, count, previous)
        if replacement != previous {
            lir.setExtra(ir, index, replacement)
            rewritten += 1
        }
        offset += 1
    }
    return rewritten
}

fn rewriteInstruction(ir: *lir.Lir, inst: *lir.Inst, canonical: [*]usize, count: usize) -> usize {
    var rewritten: usize = 0
    if operands.isUnaryValue(inst.*.opcode) {
        const previous = inst.*.arg0
        inst.*.arg0 = canonicalValue(canonical, count, previous)
        return if inst.*.arg0 != previous { 1 } else { 0 }
    }
    if operands.isBinaryValue(inst.*.opcode) {
        const previous0 = inst.*.arg0
        const previous1 = inst.*.arg1
        inst.*.arg0 = canonicalValue(canonical, count, previous0)
        inst.*.arg1 = canonicalValue(canonical, count, previous1)
        if inst.*.arg0 != previous0 { rewritten += 1 }
        if inst.*.arg1 != previous1 { rewritten += 1 }
        return rewritten
    }
    if operands.isTernaryValue(inst.*.opcode) {
        const previous0 = inst.*.arg0
        const previous1 = inst.*.arg1
        const previous2 = inst.*.arg2
        inst.*.arg0 = canonicalValue(canonical, count, previous0)
        inst.*.arg1 = canonicalValue(canonical, count, previous1)
        inst.*.arg2 = canonicalValue(canonical, count, previous2)
        if inst.*.arg0 != previous0 { rewritten += 1 }
        if inst.*.arg1 != previous1 { rewritten += 1 }
        if inst.*.arg2 != previous2 { rewritten += 1 }
        return rewritten
    }
    if inst.*.opcode == lir.Opcode.icmp || inst.*.opcode == lir.Opcode.fcmp {
        const previous1 = inst.*.arg1
        const previous2 = inst.*.arg2
        inst.*.arg1 = canonicalValue(canonical, count, previous1)
        inst.*.arg2 = canonicalValue(canonical, count, previous2)
        if inst.*.arg1 != previous1 { rewritten += 1 }
        if inst.*.arg2 != previous2 { rewritten += 1 }
    } else if inst.*.opcode == lir.Opcode.condbr || inst.*.opcode == lir.Opcode.ret || inst.*.opcode == lir.Opcode.ret_error || inst.*.opcode == lir.Opcode.ret_error_union {
        const previous = inst.*.arg0
        inst.*.arg0 = canonicalValue(canonical, count, previous)
        if inst.*.arg0 != previous { rewritten += 1 }
    } else if inst.*.opcode == lir.Opcode.ret_slice {
        const previous0 = inst.*.arg0
        const previous1 = inst.*.arg1
        inst.*.arg0 = canonicalValue(canonical, count, previous0)
        inst.*.arg1 = canonicalValue(canonical, count, previous1)
        if inst.*.arg0 != previous0 { rewritten += 1 }
        if inst.*.arg1 != previous1 { rewritten += 1 }
    } else if inst.*.opcode == lir.Opcode.call || inst.*.opcode == lir.Opcode.syscall {
        const previous = inst.*.arg0
        inst.*.arg0 = canonicalValue(canonical, count, previous)
        if inst.*.arg0 != previous { rewritten += 1 }
        rewritten += rewriteExtraUses(ir, inst.*.arg1, inst.*.arg2, canonical, count)
    } else if inst.*.opcode == lir.Opcode.direct_call {
        rewritten += rewriteExtraUses(ir, inst.*.arg1, inst.*.arg2, canonical, count)
    } else if inst.*.opcode == lir.Opcode.tuple_literal || inst.*.opcode == lir.Opcode.clone_thread {
        rewritten += rewriteExtraUses(ir, inst.*.arg0, inst.*.arg1, canonical, count)
    } else if inst.*.opcode == lir.Opcode.external || inst.*.opcode == lir.Opcode.external_value {
        rewritten += rewriteExtraUses(ir, inst.*.arg1, inst.*.arg2, canonical, count)
    }
    return rewritten
}

fn propagateCopies(ir: *lir.Lir, canonical: [*]usize, count: usize) -> usize {
    var rewritten: usize = 0
    var index: usize = 0
    while index < count {
        canonical[index] = index
        var inst = lir.getInst(ir, index)
        rewritten += rewriteInstruction(ir, &inst, canonical, count)
        lir.setInst(ir, index, inst)
        if inst.opcode == lir.Opcode.copy && inst.arg0 != lir.NONE && inst.arg0 < count { canonical[index] = canonical[inst.arg0] }
        index += 1
    }
    return rewritten
}

fn zero(values: [*]usize, count: usize) -> void {
    var index: usize = 0
    while index < count {
        values[index] = 0
        index += 1
    }
}

fn zeroPair(first: [*]usize, second: [*]usize, count: usize) -> void {
    var index: usize = 0
    while index < count {
        first[index] = 0
        second[index] = 0
        index += 1
    }
}

fn forwardLocalLoads(ir: *lir.Lir, values: [*]usize, epochs: [*]usize, count: usize) -> usize {
    zeroPair(values, epochs, count)
    var current_epoch: usize = 1
    var forwarded: usize = 0
    var index: usize = 0
    while index < count {
        const inst = lir.getInst(ir, index)
        if isBarrier(inst.opcode) && !copiesIntoFreshStorage(ir, inst, count) { current_epoch += 1 }
        if inst.opcode == lir.Opcode.store {
            if isLocalAlloca(ir, inst.arg0, count) {
                values[inst.arg0] = inst.arg1
                epochs[inst.arg0] = current_epoch
            } else { current_epoch += 1 }
        }
        if inst.opcode == lir.Opcode.load && isLocalAlloca(ir, inst.arg0, count) && epochs[inst.arg0] == current_epoch {
            var replacement = lir.initInst(lir.Opcode.copy, inst.typeId)
            replacement.arg0 = values[inst.arg0]
            lir.setInst(ir, index, replacement)
            forwarded += 1
        }
        index += 1
    }
    return forwarded
}

// A mem_copy into storage an alloca with a byte count just made (a local's
// copy of an aggregate) cannot write a local's 8-byte slot, so the loads
// forwarded across it stay valid; any other mem_copy is a barrier.
fn copiesIntoFreshStorage(ir: *lir.Lir, inst: lir.Inst, count: usize) -> bool {
    if inst.opcode != lir.Opcode.mem_copy || inst.arg0 == lir.NONE || inst.arg0 >= count { return false }
    const destination = lir.getInst(ir, inst.arg0)
    return destination.opcode == lir.Opcode.alloca && destination.arg0 != lir.NONE
}

// Also mem_copy and the atomics that write or order memory: they may
// change what the loads read.
fn isBarrier(opcode: lir.Opcode) -> bool {
    return opcode == lir.Opcode.label || opcode == lir.Opcode.br || opcode == lir.Opcode.condbr || opcode == lir.Opcode.icmp_br || opcode == lir.Opcode.call || opcode == lir.Opcode.direct_call || opcode == lir.Opcode.syscall || opcode == lir.Opcode.mem_copy ||
        opcode == lir.Opcode.atomic_store || opcode == lir.Opcode.atomic_rmw || opcode == lir.Opcode.cmpxchg || opcode == lir.Opcode.fence || opcode == lir.Opcode.clone_thread || opcode == lir.Opcode.external
}

fn fuseComparisonBranches(ir: *lir.Lir, uses: [*]usize, count: usize) -> usize {
    var fused: usize = 0
    var index: usize = 0
    while index + 1 < count {
        var comparison = lir.getInst(ir, index)
        const branch = lir.getInst(ir, index + 1)
        if comparison.opcode == lir.Opcode.icmp && uses[index] == 1 && branch.opcode == lir.Opcode.condbr && branch.arg0 == index {
            comparison.opcode = lir.Opcode.dead
            lir.setInst(ir, index, comparison)
            var replacement = branch
            replacement.opcode = lir.Opcode.icmp_br
            replacement.arg0 = index
            lir.setInst(ir, index + 1, replacement)
            fused += 1
        }
        index += 1
    }
    return fused
}

fn isLocalAlloca(ir: *lir.Lir, index: usize, count: usize) -> bool {
    if index == lir.NONE || index >= count { return false }
    const inst = lir.getInst(ir, index)
    return inst.opcode == lir.Opcode.alloca && inst.arg0 == lir.NONE
}

fn promoteLocals(ir: *lir.Lir, uses: [*]usize, store_counts: [*]usize, promoted: [*]usize, count: usize) -> Promotion {
    zeroPair(store_counts, promoted, count)
    countLocalStores(ir, store_counts, count)
    var result = Promotion.{ .locals = 0, .stores = 0 }
    var index: usize = 0
    while index < count {
        if isLocalAlloca(ir, index, count) && uses[index] == store_counts[index] {
            promoted[index] = 1
            lir.setInst(ir, index, lir.initInst(lir.Opcode.dead, lir.NONE))
            result.locals += 1
        }
        index += 1
    }
    index = 0
    while index < count {
        const inst = lir.getInst(ir, index)
        if inst.opcode == lir.Opcode.store && inst.arg0 < count && promoted[inst.arg0] != 0 {
            removeUse(uses, count, inst.arg0)
            removeUse(uses, count, inst.arg1)
            lir.setInst(ir, index, lir.initInst(lir.Opcode.dead, lir.NONE))
            result.stores += 1
        }
        index += 1
    }
    return result
}

fn countLocalStores(ir: *lir.Lir, store_counts: [*]usize, count: usize) -> void {
    var index: usize = 0
    while index < count {
        const inst = lir.getInst(ir, index)
        if inst.opcode == lir.Opcode.store && isLocalAlloca(ir, inst.arg0, count) { store_counts[inst.arg0] += 1 }
        index += 1
    }
}

fn foldConstants(ir: *lir.Lir, count: usize, simplified: *usize) -> usize {
    var folded: usize = 0
    var index: usize = 0
    while index < count {
        const inst = lir.getInst(ir, index)
        if (inst.opcode == lir.Opcode.copy || inst.opcode == lir.Opcode.bitcast) && isConstant(ir, inst.arg0, count) {
            lir.setInst(ir, index, lir.constI(inst.typeId, constantValue(ir, inst.arg0)))
            folded += 1
        } else if isFoldableBitwise(inst.opcode) && bothConstant(ir, inst, count) {
            lir.setInst(ir, index, lir.constI(inst.typeId, foldBitwise(inst.opcode, constantValue(ir, inst.arg0), constantValue(ir, inst.arg1))))
            folded += 1
        } else if inst.opcode == lir.Opcode.icmp && isConstant(ir, inst.arg1, count) && isConstant(ir, inst.arg2, count) {
            const predicate = @enumFromInt(lir.CmpPredicate, @intCast(u8, inst.arg0))
            lir.setInst(ir, index, lir.constI(inst.typeId, if compare(predicate, constantValue(ir, inst.arg1), constantValue(ir, inst.arg2)) { 1 } else { 0 }))
            folded += 1
        } else if inst.opcode == lir.Opcode.condbr && isConstant(ir, inst.arg0, count) {
            lir.setInst(ir, index, lir.branch(if constantValue(ir, inst.arg0) != 0 { inst.arg1 } else { inst.arg2 }))
            simplified.* += 1
        } else if inst.opcode == lir.Opcode.extend && isConstant(ir, inst.arg0, count) && inst.arg1 > 0 && inst.arg1 < 64 {
            lir.setInst(ir, index, lir.constI(inst.typeId, extendConstant(constantValue(ir, inst.arg0), inst.arg1, inst.arg2 == 1)))
            folded += 1
        } else if inst.opcode == lir.Opcode.extend && extendsAlready(ir, inst, count) {
            var replacement = lir.initInst(lir.Opcode.copy, inst.typeId)
            replacement.arg0 = inst.arg0
            lir.setInst(ir, index, replacement)
            simplified.* += 1
        }
        index += 1
    }
    return folded
}

// Whether an extend's operand is canonical for its width and sign already:
// the same extend, or a load of that width (a narrow load extends).
fn extendsAlready(ir: *lir.Lir, inst: lir.Inst, count: usize) -> bool {
    if inst.arg0 == lir.NONE || inst.arg0 >= count { return false }
    const source = lir.getInst(ir, inst.arg0)
    if source.opcode == lir.Opcode.extend { return source.arg1 == inst.arg1 && source.arg2 == inst.arg2 }
    if source.opcode == lir.Opcode.load && source.arg1 != lir.NONE && source.arg1 * 8 == inst.arg1 {
        const signed_load = source.arg2 == 1
        return signed_load == (inst.arg2 == 1)
    }
    return false
}

// The low `bits` of `value` sign- or zero-extended to 64 (lir.Opcode.extend).
fn extendConstant(value: usize, bits: usize, signed: bool) -> usize {
    const shift = @intCast(u6, 64 - bits)
    if signed { return @bitCast(usize, @bitCast(isize, value << shift) >> shift) }
    return (value << shift) >> shift
}

fn isConstant(ir: *lir.Lir, index: usize, count: usize) -> bool {
    return index != lir.NONE && index < count && lir.getInst(ir, index).opcode == lir.Opcode.const_i
}

fn constantValue(ir: *lir.Lir, index: usize) -> usize { return lir.getInst(ir, index).arg0 }

fn bothConstant(ir: *lir.Lir, inst: lir.Inst, count: usize) -> bool {
    return isConstant(ir, inst.arg0, count) && isConstant(ir, inst.arg1, count)
}

fn isFoldableBitwise(opcode: lir.Opcode) -> bool {
    return opcode == lir.Opcode.bit_and || opcode == lir.Opcode.bit_or || opcode == lir.Opcode.bit_xor
}

fn foldBitwise(opcode: lir.Opcode, left: usize, right: usize) -> usize {
    if opcode == lir.Opcode.bit_and { return left & right }
    if opcode == lir.Opcode.bit_or { return left | right }
    if opcode == lir.Opcode.bit_xor { return left ^ right }
    return 0
}

fn compare(predicate: lir.CmpPredicate, left: usize, right: usize) -> bool {
    if predicate == lir.CmpPredicate.eq { return left == right }
    if predicate == lir.CmpPredicate.ne { return left != right }
    if predicate == lir.CmpPredicate.ult { return left < right }
    if predicate == lir.CmpPredicate.ule { return left <= right }
    if predicate == lir.CmpPredicate.ugt { return left > right }
    if predicate == lir.CmpPredicate.uge { return left >= right }
    const signed_left = @bitCast(isize, left)
    const signed_right = @bitCast(isize, right)
    if predicate == lir.CmpPredicate.lt { return signed_left < signed_right }
    if predicate == lir.CmpPredicate.le { return signed_left <= signed_right }
    if predicate == lir.CmpPredicate.gt { return signed_left > signed_right }
    return signed_left >= signed_right
}

fn recordUses(ir: *lir.Lir, uses: [*]usize, count: usize) -> void {
    var index: usize = 0
    while index < count {
        operands.visit(ir, index, lir.getInst(ir, index), uses, count, operands.COUNT)
        index += 1
    }
}

fn eliminateUnused(ir: *lir.Lir, uses: [*]usize, count: usize) -> usize {
    var eliminated: usize = 0
    var index = count
    while index > 0 {
        index -= 1
        const inst = lir.getInst(ir, index)
        if uses[index] == 0 && isPure(inst.opcode) {
            removeOperandUses(ir, inst, uses, count)
            lir.setInst(ir, index, lir.initInst(lir.Opcode.dead, lir.NONE))
            eliminated += 1
        }
    }
    return eliminated
}

fn removeOperandUses(ir: *lir.Lir, inst: lir.Inst, uses: [*]usize, count: usize) -> void {
    if operands.isUnaryValue(inst.opcode) { removeUse(uses, count, inst.arg0) }
    if operands.isBinaryValue(inst.opcode) {
        removeUse(uses, count, inst.arg0)
        removeUse(uses, count, inst.arg1)
    }
    if operands.isTernaryValue(inst.opcode) {
        removeUse(uses, count, inst.arg0)
        removeUse(uses, count, inst.arg1)
        removeUse(uses, count, inst.arg2)
    }
    if inst.opcode == lir.Opcode.icmp || inst.opcode == lir.Opcode.fcmp {
        removeUse(uses, count, inst.arg1)
        removeUse(uses, count, inst.arg2)
    }
    if inst.opcode == lir.Opcode.tuple_literal { removeExtraUses(ir, inst.arg0, inst.arg1, uses, count) }
    if inst.opcode == lir.Opcode.external_value { removeExtraUses(ir, inst.arg1, inst.arg2, uses, count) }
}

fn removeUse(uses: [*]usize, count: usize, value: usize) -> void {
    if value != lir.NONE && value < count && uses[value] > 0 { uses[value] -= 1 }
}

fn removeExtraUses(ir: *lir.Lir, start: usize, length: usize, uses: [*]usize, count: usize) -> void {
    var index: usize = 0
    while index < length {
        removeUse(uses, count, lir.getExtra(ir, start + index))
        index += 1
    }
}

fn extraUsesValue(ir: *lir.Lir, start: usize, length: usize, value: usize) -> bool {
    var index: usize = 0
    while index < length {
        if lir.getExtra(ir, start + index) == value { return true }
        index += 1
    }
    return false
}

fn instructionUsesValue(ir: *lir.Lir, inst: lir.Inst, value: usize) -> bool {
    if operands.isUnaryValue(inst.opcode) { return inst.arg0 == value }
    if operands.isBinaryValue(inst.opcode) { return inst.arg0 == value || inst.arg1 == value }
    if operands.isTernaryValue(inst.opcode) { return inst.arg0 == value || inst.arg1 == value || inst.arg2 == value }
    if inst.opcode == lir.Opcode.icmp || inst.opcode == lir.Opcode.fcmp { return inst.arg1 == value || inst.arg2 == value }
    if inst.opcode == lir.Opcode.condbr || inst.opcode == lir.Opcode.ret || inst.opcode == lir.Opcode.ret_error || inst.opcode == lir.Opcode.ret_error_union { return inst.arg0 == value }
    if inst.opcode == lir.Opcode.ret_slice { return inst.arg0 == value || inst.arg1 == value }
    if inst.opcode == lir.Opcode.call || inst.opcode == lir.Opcode.syscall {
        if inst.arg0 == value { return true }
        return extraUsesValue(ir, inst.arg1, inst.arg2, value)
    }
    if inst.opcode == lir.Opcode.direct_call { return extraUsesValue(ir, inst.arg1, inst.arg2, value) }
    if inst.opcode == lir.Opcode.tuple_literal || inst.opcode == lir.Opcode.clone_thread { return extraUsesValue(ir, inst.arg0, inst.arg1, value) }
    if inst.opcode == lir.Opcode.external || inst.opcode == lir.Opcode.external_value { return extraUsesValue(ir, inst.arg1, inst.arg2, value) }
    return false
}

fn markRetentionHints(ir: *lir.Lir, uses: [*]usize, count: usize) -> void {
    var index: usize = 0
    while index + 1 < count {
        if uses[index] == 1 && instructionUsesValue(ir, lir.getInst(ir, index + 1), index) {
            var instruction = lir.getInst(ir, index)
            instruction.flags = instruction.flags | lir.FLAG_RETAIN_NEXT
            lir.setInst(ir, index, instruction)
        }
        index += 1
    }
}

fn isPure(opcode: lir.Opcode) -> bool {
    return opcode == lir.Opcode.const_i || opcode == lir.Opcode.const_f || opcode == lir.Opcode.copy ||
        opcode == lir.Opcode.cast || opcode == lir.Opcode.bitcast || opcode == lir.Opcode.add || opcode == lir.Opcode.sub ||
        opcode == lir.Opcode.mul || opcode == lir.Opcode.bit_and || opcode == lir.Opcode.bit_or || opcode == lir.Opcode.bit_xor ||
        opcode == lir.Opcode.shl || opcode == lir.Opcode.shr || opcode == lir.Opcode.popcount || opcode == lir.Opcode.sqrt || opcode == lir.Opcode.round_float || opcode == lir.Opcode.byte_mask_64 || opcode == lir.Opcode.icmp || opcode == lir.Opcode.fcmp ||
        opcode == lir.Opcode.addr || opcode == lir.Opcode.gep || opcode == lir.Opcode.func_sym || opcode == lir.Opcode.error_test ||
        opcode == lir.Opcode.error_payload || opcode == lir.Opcode.error_payload_part || opcode == lir.Opcode.builtin_sym ||
        opcode == lir.Opcode.string_literal || opcode == lir.Opcode.global_address || opcode == lir.Opcode.tuple_literal || opcode == lir.Opcode.tuple_element ||
        opcode == lir.Opcode.extend || opcode == lir.Opcode.frame_local || opcode == lir.Opcode.external_value
}
