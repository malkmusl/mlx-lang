// The blocks of the LIR, their successors and immediate dominators.
//
// A block starts at a label, and after a branch or return that no label
// follows (code nothing reaches). Each function's blocks are numbered
// together, its first block being its entry. Dominators come from the
// iteration of Cooper, Harvey and Kennedy over each function's blocks in
// reverse postorder. A function with a branch to a label it does not have
// is left out (`trusted` is false for its blocks): a missing edge would
// make a block look dominated when it is not.
const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const lir = @import("./lir.mlx")

pub const Dominance = struct {
    blockCount: usize
    instructionCount: usize
    labelCapacity: usize
    // Per instruction: its block.
    blockOf: [*]usize
    // Per block: the immediate dominator (the entry: itself; NONE: no
    // path from the entry reaches it), its function's entry, whether the
    // function's edges are all known, and the work arrays.
    idom: [*]usize
    entry: [*]usize
    trusted: [*]usize
    first: [*]usize
    last: [*]usize
    successors: [*]usize
    order: [*]usize
    rpo: [*]usize
    predecessorStart: [*]usize
    predecessors: [*]usize
    labels: [*]usize
    allocator: allocator_module.Allocator
}

fn words(allocator: allocator_module.Allocator, count: usize) -> [*]usize {
    var result: [*]usize = undefined
    const size = if count == 0 { 8 } else { count * 8 }
    unsafe { result = @ptrCast([*]usize, allocator.alloc(size, 8).?) }
    return result
}

fn release(allocator: allocator_module.Allocator, memory: [*]usize, count: usize) -> void {
    const size = if count == 0 { 8 } else { count * 8 }
    unsafe { allocator.free(@ptrCast([*]u8, memory), size, 8) }
}

fn isTerminator(opcode: lir.Opcode) -> bool {
    return opcode == lir.Opcode.br || opcode == lir.Opcode.condbr || opcode == lir.Opcode.icmp_br || opcode == lir.Opcode.ret ||
        opcode == lir.Opcode.ret_slice || opcode == lir.Opcode.ret_error || opcode == lir.Opcode.ret_error_union || opcode == lir.Opcode.unreachable_inst
}

fn isFunctionLabel(inst: lir.Inst) -> bool {
    return inst.opcode == lir.Opcode.label && inst.arg0 != lir.NONE
}

pub fn compute(ir: *lir.Lir, allocator: allocator_module.Allocator) -> Dominance {
    const count = lir.instCount(ir)
    var d = Dominance.{
        .blockCount = 0,
        .instructionCount = count,
        .labelCapacity = 0,
        .blockOf = words(allocator, count),
        .idom = words(allocator, count),
        .entry = words(allocator, count),
        .trusted = words(allocator, count),
        .first = words(allocator, count),
        .last = words(allocator, count),
        .successors = words(allocator, count * 2),
        .order = words(allocator, count),
        .rpo = words(allocator, count),
        .predecessorStart = words(allocator, count + 1),
        .predecessors = words(allocator, count * 2),
        .labels = words(allocator, 1),
        .allocator = allocator,
    }
    numberBlocks(ir, &d)
    mapLabels(ir, &d)
    linkSuccessors(ir, &d)
    linkPredecessors(&d)
    var block: usize = 0
    while block < d.blockCount {
        if d.entry[block] == block { dominators(&d, block) }
        block += 1
    }
    return d
}

pub fn deinit(d: *Dominance) -> void {
    const count = d.*.instructionCount
    release(d.*.allocator, d.*.blockOf, count)
    release(d.*.allocator, d.*.idom, count)
    release(d.*.allocator, d.*.entry, count)
    release(d.*.allocator, d.*.trusted, count)
    release(d.*.allocator, d.*.first, count)
    release(d.*.allocator, d.*.last, count)
    release(d.*.allocator, d.*.successors, count * 2)
    release(d.*.allocator, d.*.order, count)
    release(d.*.allocator, d.*.rpo, count)
    release(d.*.allocator, d.*.predecessorStart, count + 1)
    release(d.*.allocator, d.*.predecessors, count * 2)
    release(d.*.allocator, d.*.labels, d.*.labelCapacity)
}

// Whether every path from the entry to block `to` passes through `from`
// (false when the function's edges are not all known).
pub fn dominates(d: *Dominance, from: usize, to: usize) -> bool {
    if d.*.trusted[to] == 0 || d.*.idom[to] == lir.NONE || d.*.idom[from] == lir.NONE { return false }
    var at = to
    while at != from {
        const up = d.*.idom[at]
        if up == at { return false }
        at = up
    }
    return true
}

fn numberBlocks(ir: *lir.Lir, d: *Dominance) -> void {
    var blocks: usize = 0
    var ended = true
    var function_entry: usize = 0
    var index: usize = 0
    while index < d.*.instructionCount {
        const inst = lir.getInst(ir, index)
        if inst.opcode == lir.Opcode.dead && blocks > 0 {
            d.*.blockOf[index] = blocks - 1
            index += 1
            continue
        }
        if inst.opcode == lir.Opcode.label || ended {
            if isFunctionLabel(inst) || blocks == 0 { function_entry = blocks }
            d.*.first[blocks] = index
            d.*.last[blocks] = index
            d.*.entry[blocks] = function_entry
            d.*.trusted[blocks] = 1
            d.*.idom[blocks] = lir.NONE
            blocks += 1
        }
        d.*.blockOf[index] = blocks - 1
        if inst.opcode != lir.Opcode.dead { d.*.last[blocks - 1] = index }
        ended = isTerminator(inst.opcode)
        index += 1
    }
    d.*.blockCount = blocks
}

fn mapLabels(ir: *lir.Lir, d: *Dominance) -> void {
    var capacity: usize = 0
    var index: usize = 0
    while index < d.*.instructionCount {
        const inst = lir.getInst(ir, index)
        if inst.opcode == lir.Opcode.label && inst.arg0 == lir.NONE && inst.arg1 != lir.NONE && inst.arg1 + 1 > capacity { capacity = inst.arg1 + 1 }
        index += 1
    }
    release(d.*.allocator, d.*.labels, d.*.labelCapacity)
    d.*.labelCapacity = capacity
    d.*.labels = words(d.*.allocator, capacity)
    var at: usize = 0
    while at < capacity {
        d.*.labels[at] = lir.NONE
        at += 1
    }
    var block: usize = 0
    while block < d.*.blockCount {
        const inst = lir.getInst(ir, d.*.first[block])
        if inst.opcode == lir.Opcode.label && inst.arg0 == lir.NONE && inst.arg1 != lir.NONE { d.*.labels[inst.arg1] = block }
        block += 1
    }
}

// The block a branch to `label` goes to; an unknown label leaves the
// function untrusted.
fn target(d: *Dominance, block: usize, label: usize) -> usize {
    if label >= d.*.labelCapacity || d.*.labels[label] == lir.NONE || d.*.entry[d.*.labels[label]] != d.*.entry[block] {
        d.*.trusted[d.*.entry[block]] = 0
        return lir.NONE
    }
    return d.*.labels[label]
}

fn linkSuccessors(ir: *lir.Lir, d: *Dominance) -> void {
    var block: usize = 0
    while block < d.*.blockCount {
        var one = lir.NONE
        var two = lir.NONE
        const inst = lir.getInst(ir, d.*.last[block])
        if inst.opcode == lir.Opcode.br {
            one = target(d, block, inst.arg0)
        } else if inst.opcode == lir.Opcode.condbr || inst.opcode == lir.Opcode.icmp_br {
            one = target(d, block, inst.arg1)
            two = target(d, block, inst.arg2)
        } else if !isTerminator(inst.opcode) && block + 1 < d.*.blockCount && d.*.entry[block + 1] == d.*.entry[block] {
            one = block + 1
        }
        d.*.successors[block * 2] = one
        d.*.successors[block * 2 + 1] = two
        block += 1
    }
    // A block of an untrusted function is untrusted too.
    block = 0
    while block < d.*.blockCount {
        if d.*.trusted[d.*.entry[block]] == 0 { d.*.trusted[block] = 0 }
        block += 1
    }
}

fn linkPredecessors(d: *Dominance) -> void {
    var block: usize = 0
    while block <= d.*.blockCount {
        d.*.predecessorStart[block] = 0
        block += 1
    }
    block = 0
    while block < d.*.blockCount * 2 {
        const to = d.*.successors[block]
        if to != lir.NONE { d.*.predecessorStart[to + 1] += 1 }
        block += 1
    }
    block = 0
    while block < d.*.blockCount {
        d.*.predecessorStart[block + 1] += d.*.predecessorStart[block]
        d.*.order[block] = d.*.predecessorStart[block]
        block += 1
    }
    block = 0
    while block < d.*.blockCount * 2 {
        const to = d.*.successors[block]
        if to != lir.NONE {
            d.*.predecessors[d.*.order[to]] = block / 2
            d.*.order[to] += 1
        }
        block += 1
    }
}

// Reverse postorder of the blocks reachable from `entry`, then the
// dominator iteration. The function's blocks are entry .. end; during the
// depth-first walk `rpo` counts the successors a block has had tried (NONE:
// not seen), order[entry ..] is the walk's stack and last[entry ..] (no
// longer needed once the successors are linked) collects the blocks as
// they finish. Afterwards order[entry ..] lists the blocks in reverse
// postorder and `rpo` numbers them.
fn dominators(d: *Dominance, entry: usize) -> void {
    if d.*.trusted[entry] == 0 { return }
    var block = entry
    while block < d.*.blockCount && d.*.entry[block] == entry {
        d.*.rpo[block] = lir.NONE
        d.*.idom[block] = lir.NONE
        block += 1
    }
    const end = block
    const base = entry
    var finished: usize = 0
    d.*.order[base] = entry
    d.*.rpo[entry] = 0
    var depth: usize = 1
    while depth > 0 {
        const top = d.*.order[base + depth - 1]
        const tried = d.*.rpo[top]
        if tried < 2 {
            d.*.rpo[top] = tried + 1
            const next = d.*.successors[top * 2 + tried]
            if next != lir.NONE && d.*.rpo[next] == lir.NONE {
                d.*.rpo[next] = 0
                d.*.order[base + depth] = next
                depth += 1
            }
        } else {
            d.*.last[base + finished] = top
            finished += 1
            depth -= 1
        }
    }
    // Reverse postorder numbers: the entry is 0.
    var at: usize = 0
    while at < finished {
        const visited = d.*.last[base + finished - 1 - at]
        d.*.rpo[visited] = at
        d.*.order[base + at] = visited
        at += 1
    }
    d.*.idom[entry] = entry
    var changed = true
    while changed {
        changed = false
        at = 1
        while at < finished {
            const current = d.*.order[base + at]
            var chosen = lir.NONE
            var p = d.*.predecessorStart[current]
            while p < d.*.predecessorStart[current + 1] {
                const predecessor = d.*.predecessors[p]
                if d.*.idom[predecessor] != lir.NONE {
                    if chosen == lir.NONE { chosen = predecessor } else { chosen = intersect(d, predecessor, chosen) }
                }
                p += 1
            }
            if chosen != lir.NONE && d.*.idom[current] != chosen {
                d.*.idom[current] = chosen
                changed = true
            }
            at += 1
        }
    }
    // Blocks no path reaches keep NONE; their rpo marks are cleared.
    block = entry
    while block < end {
        if d.*.idom[block] == lir.NONE { d.*.rpo[block] = lir.NONE }
        block += 1
    }
}

fn intersect(d: *Dominance, left: usize, right: usize) -> usize {
    var a = left
    var b = right
    while a != b {
        while d.*.rpo[a] > d.*.rpo[b] { a = d.*.idom[a] }
        while d.*.rpo[b] > d.*.rpo[a] { b = d.*.idom[b] }
    }
    return a
}
