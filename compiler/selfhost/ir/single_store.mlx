// Locals stored once.
//
// A local's 8-byte slot that one store writes and that nothing but loads
// and that store touches (its address goes nowhere else) holds the stored
// value wherever the store has run: a load the store dominates (in a block
// every path to which passes the store's block, or after the store in its
// own block) reads that value, so it becomes a copy of it. `const`
// bindings are such locals, and a `var` never assigned again. The loads
// left are the ones the store does not dominate (a local read before its
// first assignment in a loop, say); promoteLocals drops a local none are
// left of. forwardLocalLoads does the same within a block for any local;
// this reaches across blocks, through branches and loops.
const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const lir = @import("./lir.mlx")
const operands = @import("./operands.mlx")
const dominance = @import("./dominance.mlx")

// How many loads became copies.
pub fn run(ir: *lir.Lir, allocator: allocator_module.Allocator) -> usize {
    const count = lir.instCount(ir)
    if count == 0 { return 0 }
    const memory = allocator.alloc(count * 32, 8)
    if memory == null { return 0 }
    var uses: [*]usize = undefined
    var stores: [*]usize = undefined
    var loads: [*]usize = undefined
    var stored_at: [*]usize = undefined
    unsafe {
        uses = @ptrCast([*]usize, memory.?)
        stores = @ptrFromInt([*]usize, @intFromPtr(memory.?) + count * 8)
        loads = @ptrFromInt([*]usize, @intFromPtr(memory.?) + count * 16)
        stored_at = @ptrFromInt([*]usize, @intFromPtr(memory.?) + count * 24)
    }
    var index: usize = 0
    while index < count {
        uses[index] = 0
        stores[index] = 0
        loads[index] = 0
        stored_at[index] = lir.NONE
        index += 1
    }
    index = 0
    while index < count {
        const inst = lir.getInst(ir, index)
        operands.visit(ir, index, inst, uses, count, operands.COUNT)
        if inst.opcode == lir.Opcode.store && isSlot(ir, inst.arg0, count) {
            stores[inst.arg0] += 1
            stored_at[inst.arg0] = index
        }
        if inst.opcode == lir.Opcode.load && isSlot(ir, inst.arg0, count) { loads[inst.arg0] += 1 }
        index += 1
    }
    var d = dominance.compute(ir, allocator)
    var replaced: usize = 0
    index = 0
    while index < count {
        const inst = lir.getInst(ir, index)
        if inst.opcode == lir.Opcode.load && isSlot(ir, inst.arg0, count) {
            const slot = inst.arg0
            if stores[slot] == 1 && uses[slot] == stores[slot] + loads[slot] && reads(ir, &d, stored_at[slot], index) {
                var replacement = lir.initInst(lir.Opcode.copy, inst.typeId)
                replacement.arg0 = lir.getInst(ir, stored_at[slot]).arg1
                lir.setInst(ir, index, replacement)
                replaced += 1
            }
        }
        index += 1
    }
    dominance.deinit(&d)
    allocator.free(memory.?, count * 32, 8)
    return replaced
}

fn isSlot(ir: *lir.Lir, value: usize, count: usize) -> bool {
    if value == lir.NONE || value >= count { return false }
    const inst = lir.getInst(ir, value)
    return inst.opcode == lir.Opcode.alloca && inst.arg0 == lir.NONE
}

// Whether the load at `load` reads what the store at `store` wrote: the
// same width, and the store dominates it.
fn reads(ir: *lir.Lir, d: *dominance.Dominance, store: usize, load: usize) -> bool {
    const written = lir.getInst(ir, store)
    const read = lir.getInst(ir, load)
    const stored_width = if written.arg2 == lir.NONE { 8 } else { written.arg2 }
    const loaded_width = if read.arg1 == lir.NONE { 8 } else { read.arg1 }
    if written.arg1 == lir.NONE || stored_width != loaded_width { return false }
    const from = d.*.blockOf[store]
    const to = d.*.blockOf[load]
    if from == to { return store < load && d.*.trusted[to] != 0 }
    return dominance.dominates(d, from, to)
}
