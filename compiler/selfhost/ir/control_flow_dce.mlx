const lir = @import("./lir.mlx")

fn isFunctionLabel(inst: lir.Inst) -> bool {
    return inst.opcode == lir.Opcode.label && inst.arg0 != lir.NONE
}

fn isBlockLabel(inst: lir.Inst) -> bool {
    return inst.opcode == lir.Opcode.label && inst.arg0 == lir.NONE
}

fn isTerminator(opcode: lir.Opcode) -> bool {
    return opcode == lir.Opcode.br || opcode == lir.Opcode.condbr || opcode == lir.Opcode.icmp_br ||
        opcode == lir.Opcode.ret || opcode == lir.Opcode.ret_slice || opcode == lir.Opcode.ret_error ||
        opcode == lir.Opcode.ret_error_union || opcode == lir.Opcode.unreachable_inst
}

pub fn eliminatePostTerminator(ir: *lir.Lir) -> usize {
    var eliminated: usize = 0
    var in_function = false
    var terminated = false
    var index: usize = 0
    while index < lir.instCount(ir) {
        var inst = lir.getInst(ir, index)
        if isFunctionLabel(inst) {
            in_function = true
            terminated = false
        } else if in_function && isBlockLabel(inst) {
            terminated = false
        } else if in_function && inst.opcode != lir.Opcode.dead {
            if terminated {
                lir.setInst(ir, index, lir.initInst(lir.Opcode.dead, lir.NONE))
                eliminated += 1
            } else if isTerminator(inst.opcode) { terminated = true }
        }
        index += 1
    }
    return eliminated
}
