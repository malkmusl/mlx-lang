const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const lir = @import("./lir.mlx")

fn isFunctionLabel(inst: lir.Inst) -> bool {
    return inst.opcode == lir.Opcode.label && inst.arg0 != lir.NONE
}

fn isBlockLabel(inst: lir.Inst) -> bool {
    return inst.opcode == lir.Opcode.label && inst.arg0 == lir.NONE
}

fn isTerminator(opcode: lir.Opcode) -> bool {
    return opcode == lir.Opcode.br || opcode == lir.Opcode.condbr || opcode == lir.Opcode.icmp_br ||
        opcode == lir.Opcode.ret || opcode == lir.Opcode.ret_slice || opcode == lir.Opcode.ret_error ||
        opcode == lir.Opcode.ret_error_union || opcode == lir.Opcode.unreachable_inst
}

pub fn eliminatePostTerminator(ir: *lir.Lir) -> usize {
    var eliminated: usize = 0
    var in_function = false
    var terminated = false
    var index: usize = 0
    while index < lir.instCount(ir) {
        var inst = lir.getInst(ir, index)
        if isFunctionLabel(inst) {
            in_function = true
            terminated = false
        } else if in_function && isBlockLabel(inst) {
            terminated = false
        } else if in_function && inst.opcode != lir.Opcode.dead {
            if terminated {
                lir.setInst(ir, index, lir.initInst(lir.Opcode.dead, lir.NONE))
                eliminated += 1
            } else if isTerminator(inst.opcode) { terminated = true }
        }
        index += 1
    }
    return eliminated
}

// A block entered only by falling through from the branch right before
// its label (br X; label X, X branched to nowhere else) is joined to the
// block before it: the branch and the label go (the inliner and the
// lowerings leave many such pairs, and every pass that works within a
// block, the back end's register cache above all, stops at a label).
// (Block numbers are unique within a LIR: the encoder names labels by
// them.)
pub fn mergeFallthroughBlocks(ir: *lir.Lir, allocator: allocator_module.Allocator) -> usize {
    const count = lir.instCount(ir)
    var highest: usize = 0
    var index: usize = 0
    while index < count {
        const inst = lir.getInst(ir, index)
        if isBlockLabel(inst) && inst.arg1 != lir.NONE && inst.arg1 > highest { highest = inst.arg1 }
        index += 1
    }
    const capacity = highest + 1
    const memory = allocator.alloc(capacity * @sizeOf(usize), @alignOf(usize)).?
    var merged: usize = 0
    unsafe {
        const predecessors = @ptrCast([*]usize, memory)
        var at: usize = 0
        while at < capacity {
            predecessors[at] = 0
            at += 1
        }
        index = 0
        while index < count {
            const inst = lir.getInst(ir, index)
            if inst.opcode == lir.Opcode.br { countTarget(predecessors, capacity, inst.arg0) }
            if inst.opcode == lir.Opcode.condbr || inst.opcode == lir.Opcode.icmp_br {
                countTarget(predecessors, capacity, inst.arg1)
                countTarget(predecessors, capacity, inst.arg2)
            }
            index += 1
        }
        index = 0
        while index < count {
            const inst = lir.getInst(ir, index)
            if inst.opcode == lir.Opcode.br && inst.arg0 != lir.NONE && inst.arg0 < capacity && predecessors[inst.arg0] == 1 {
                var next = index + 1
                while next < count && lir.getInst(ir, next).opcode == lir.Opcode.dead { next += 1 }
                if next < count {
                    const label = lir.getInst(ir, next)
                    if isBlockLabel(label) && label.arg1 == inst.arg0 {
                        lir.setInst(ir, index, lir.initInst(lir.Opcode.dead, lir.NONE))
                        lir.setInst(ir, next, lir.initInst(lir.Opcode.dead, lir.NONE))
                        merged += 1
                    }
                }
            }
            index += 1
        }
    }
    allocator.free(memory, capacity * @sizeOf(usize), @alignOf(usize))
    return merged
}

fn countTarget(predecessors: [*]usize, capacity: usize, block: usize) -> void {
    if block != lir.NONE && block < capacity { predecessors[block] += 1 }
}
