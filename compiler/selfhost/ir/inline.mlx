const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const lexer = @import("../lexer.mlx")
const loader_module = @import("../modules/loader.mlx")
const model = @import("../modules/model.mlx")
const symbol_module = @import("../sema/symbols/symbol.mlx")
const symbols_store = @import("../sema/symbols/store.mlx")

pub const Candidate = struct {
    requested: bool
    eligible: bool
    moduleId: usize
    declaration: usize
    returnExpression: usize
}

fn empty() -> Candidate {
    return Candidate.{ .requested = false, .eligible = false, .moduleId = 0, .declaration = ast.NONE, .returnExpression = ast.NONE }
}

fn isLeaf(tag: ast.Tag) -> bool {
    return tag == ast.Tag.identifier || tag == ast.Tag.named_type || tag == ast.Tag.integer_literal || tag == ast.Tag.float_literal ||
        tag == ast.Tag.string_literal || tag == ast.Tag.byte_string_literal || tag == ast.Tag.character_literal ||
        tag == ast.Tag.boolean_literal || tag == ast.Tag.null_literal
}

fn argumentCost(nodes: *ast_store.Store, tokens: lexer.Buffer, first: usize, expected: usize, depth: usize) -> usize {
    var total: usize = 0
    var argument = first
    var count: usize = 0
    while argument != ast.NONE && count < expected {
        const cost = expressionCost(nodes, tokens, argument, depth + 1)
        if cost == ast.NONE { return ast.NONE }
        total += cost
        argument = ast_store.Store.get(nodes, argument).next
        count += 1
    }
    return if count == expected { total } else { ast.NONE }
}

fn callCost(nodes: *ast_store.Store, tokens: lexer.Buffer, node: ast.Node, depth: usize) -> usize {
    const callee = expressionCost(nodes, tokens, node.lhs, depth + 1)
    const arguments = argumentCost(nodes, tokens, node.rhs, node.extra, depth)
    if callee == ast.NONE || arguments == ast.NONE { return ast.NONE }
    return callee + arguments + 1
}

fn expressionCost(nodes: *ast_store.Store, tokens: lexer.Buffer, node_index: usize, depth: usize) -> usize {
    if node_index == ast.NONE || node_index >= nodes.*.length || depth >= 128 { return ast.NONE }
    const node = ast_store.Store.get(nodes, node_index)
    if isLeaf(node.tag) { return 1 }
    if node.tag == ast.Tag.binary_expression {
        if lexer.tokenAt(tokens, node.mainToken).kind >= lexer.Kind.equal { return ast.NONE }
        const left = expressionCost(nodes, tokens, node.lhs, depth + 1)
        const right = expressionCost(nodes, tokens, node.rhs, depth + 1)
        if left == ast.NONE || right == ast.NONE { return ast.NONE }
        return left + right + 1
    }
    if node.tag == ast.Tag.unary_expression {
        if lexer.tokenAt(tokens, node.mainToken).kind == lexer.Kind.keyword_try { return ast.NONE }
        const operand = expressionCost(nodes, tokens, node.lhs, depth + 1)
        return if operand == ast.NONE { ast.NONE } else { operand + 1 }
    }
    if node.tag == ast.Tag.field_expression && node.lhs != ast.NONE {
        const base = expressionCost(nodes, tokens, node.lhs, depth + 1)
        return if base == ast.NONE { ast.NONE } else { base + 1 }
    }
    if node.tag == ast.Tag.index_expression {
        const base = expressionCost(nodes, tokens, node.lhs, depth + 1)
        const index = expressionCost(nodes, tokens, node.rhs, depth + 1)
        if base == ast.NONE || index == ast.NONE { return ast.NONE }
        return base + index + 1
    }
    if node.tag == ast.Tag.if_statement {
        const condition = expressionCost(nodes, tokens, node.lhs, depth + 1)
        const then_value = expressionCost(nodes, tokens, node.rhs, depth + 1)
        const else_value = expressionCost(nodes, tokens, node.extra, depth + 1)
        if condition == ast.NONE || then_value == ast.NONE || else_value == ast.NONE { return ast.NONE }
        return condition + then_value + else_value + 1
    }
    if node.tag == ast.Tag.tuple_literal {
        const elements = argumentCost(nodes, tokens, node.lhs, node.rhs, depth)
        return if elements == ast.NONE { ast.NONE } else { elements + 1 }
    }
    if node.tag == ast.Tag.call_expression { return callCost(nodes, tokens, node, depth) }
    if node.tag == ast.Tag.builtin_call {
        const arguments = argumentCost(nodes, tokens, node.lhs, node.rhs, depth)
        return if arguments == ast.NONE { ast.NONE } else { arguments + 1 }
    }
    return ast.NONE
}

fn parametersEligible(nodes: *ast_store.Store, declaration: ast.Node, argument_count: usize) -> bool {
    if (declaration.endToken & 4294967295) != argument_count { return false }
    var parameter = declaration.lhs
    var count: usize = 0
    while parameter != ast.NONE {
        const value = ast_store.Store.get(nodes, parameter)
        if value.lhs == ast.NONE || value.extra & 1 != 0 { return false }
        parameter = value.next
        count += 1
    }
    return count == argument_count
}

pub fn inspect(loader: *loader_module.Loader, symbols: *symbols_store.Store, symbol_index: usize, argument_count: usize, automatic_limit: usize) -> Candidate {
    var result = empty()
    if symbol_index >= symbols.*.length { return result }
    const symbol = symbols_store.Store.get(symbols, symbol_index)
    if symbol.*.flags & symbol_module.FLAG_FUNCTION == 0 { return result }
    result.requested = symbol.*.flags & symbol_module.FLAG_INLINE != 0
    if symbol.*.flags & symbol_module.FLAG_NOINLINE != 0 || symbol.*.flags & symbol_module.FLAG_EXTERN != 0 { return result }
    if !result.requested && automatic_limit == 0 { return result }
    if symbol.*.moduleId >= loader_module.Loader.moduleCount(loader) { return result }
    const module = loader_module.Loader.moduleAt(loader, symbol.*.moduleId)
    if module.*.state != model.State.loaded || module.*.nodesAddress == 0 || module.*.tokensAddress == 0 { return result }
    unsafe {
        const nodes = @ptrFromInt(*ast_store.Store, module.*.nodesAddress)
        const tokens = @ptrFromInt(*lexer.Buffer, module.*.tokensAddress)
        if symbol.*.declaration >= nodes.*.length { return result }
        const declaration = ast_store.Store.get(nodes, symbol.*.declaration)
        if declaration.tag != ast.Tag.function_declaration || declaration.rhs == ast.NONE || !parametersEligible(nodes, declaration, argument_count) { return result }
        const body = ast_store.Store.get(nodes, declaration.rhs)
        if body.tag != ast.Tag.block || body.rhs != 1 || body.lhs == ast.NONE { return result }
        const statement = ast_store.Store.get(nodes, body.lhs)
        if statement.tag != ast.Tag.return_statement || statement.rhs == ast.NONE { return result }
        const cost = expressionCost(nodes, tokens.*, statement.rhs, 0)
        if cost == ast.NONE || (!result.requested && cost > automatic_limit) { return result }
        result.eligible = true
        result.moduleId = symbol.*.moduleId
        result.declaration = symbol.*.declaration
        result.returnExpression = statement.rhs
        return result
    }
}
