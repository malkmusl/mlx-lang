const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const lir = @import("./lir.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")

pub const Result = struct {
    functionsEliminated: usize
    instructionsEliminated: usize
}

fn emptyResult() -> Result {
    return Result.{ .functionsEliminated = 0, .instructionsEliminated = 0 }
}

fn initialize(starts: [*]usize, reachable: [*]u8, count: usize) -> void {
    var index: usize = 0
    while index < count {
        starts[index] = lir.NONE
        reachable[index] = 0
        index += 1
    }
}

fn isFunctionLabel(inst: lir.Inst) -> bool {
    return inst.opcode == lir.Opcode.label && inst.arg0 != lir.NONE
}

// Roots: `main` and every exported function (reachable from outside).
fn isEntry(ir: *lir.Lir, symbol_id: usize) -> bool {
    const symbol = lir.getSymbol(ir, symbol_id)
    if symbol.flags & lir.SYMBOL_EXPORT != 0 { return true }
    if symbol.length != 4 { return false }
    unsafe { return mem.eql(symbol.pointer, @ptrCast([*]const u8, "main"), 4) }
}

fn indexFunctions(ir: *lir.Lir, starts: [*]usize, reachable: [*]u8, queue: [*]usize, tail: *usize) -> usize {
    var functions: usize = 0
    var index: usize = 0
    while index < lir.instCount(ir) {
        const inst = lir.getInst(ir, index)
        if isFunctionLabel(inst) && inst.arg0 < lir.symbolCount(ir) {
            if starts[inst.arg0] == lir.NONE { starts[inst.arg0] = index }
            functions += 1
            if isEntry(ir, inst.arg0) {
                reachable[inst.arg0] = 1
                queue[tail.*] = inst.arg0
                tail.* += 1
            }
        }
        index += 1
    }
    return functions
}

fn enqueueTarget(starts: [*]usize, reachable: [*]u8, queue: [*]usize, tail: *usize, symbol_count: usize, target: usize) -> void {
    if target >= symbol_count || starts[target] == lir.NONE || reachable[target] != 0 { return }
    reachable[target] = 1
    queue[tail.*] = target
    tail.* += 1
}

fn scanFunction(ir: *lir.Lir, start: usize, starts: [*]usize, reachable: [*]u8, queue: [*]usize, tail: *usize) -> void {
    var index = start + 1
    const symbol_count = lir.symbolCount(ir)
    while index < lir.instCount(ir) {
        const inst = lir.getInst(ir, index)
        if isFunctionLabel(inst) { return }
        if inst.opcode == lir.Opcode.direct_call || inst.opcode == lir.Opcode.func_sym {
            enqueueTarget(starts, reachable, queue, tail, symbol_count, inst.arg0)
        }
        index += 1
    }
}

fn discoverReachable(ir: *lir.Lir, starts: [*]usize, reachable: [*]u8, queue: [*]usize, tail: usize) -> usize {
    var head: usize = 0
    var end = tail
    while head < end {
        const symbol_id = queue[head]
        scanFunction(ir, starts[symbol_id], starts, reachable, queue, &end)
        head += 1
    }
    return end
}

fn eliminateFunction(ir: *lir.Lir, start: usize) -> usize {
    var eliminated: usize = 0
    var index = start
    while index < lir.instCount(ir) {
        const inst = lir.getInst(ir, index)
        if index != start && isFunctionLabel(inst) { return eliminated }
        if inst.opcode != lir.Opcode.dead {
            lir.setInst(ir, index, lir.initInst(lir.Opcode.dead, lir.NONE))
            eliminated += 1
        }
        index += 1
    }
    return eliminated
}

fn eliminateUnreachable(ir: *lir.Lir, starts: [*]usize, reachable: [*]u8, symbol_count: usize) -> Result {
    var result = emptyResult()
    var index: usize = 0
    while index < lir.instCount(ir) {
        const inst = lir.getInst(ir, index)
        if isFunctionLabel(inst) && inst.arg0 < symbol_count && (reachable[inst.arg0] == 0 || starts[inst.arg0] != index) {
            result.instructionsEliminated += eliminateFunction(ir, index)
            result.functionsEliminated += 1
        }
        index += 1
    }
    return result
}

pub fn run(ir: *lir.Lir, allocator: allocator_module.Allocator) -> Result {
    const symbol_count = lir.symbolCount(ir)
    if symbol_count == 0 { return emptyResult() }
    const starts_memory = allocator.alloc(symbol_count * @sizeOf(usize), @alignOf(usize)).?
    const reachable_memory = allocator.alloc(symbol_count, @alignOf(u8)).?
    const queue_memory = allocator.alloc(symbol_count * @sizeOf(usize), @alignOf(usize)).?
    unsafe {
        const starts = @ptrCast([*]usize, starts_memory)
        const reachable = @ptrCast([*]u8, reachable_memory)
        const queue = @ptrCast([*]usize, queue_memory)
        initialize(starts, reachable, symbol_count)
        var tail: usize = 0
        const function_count = indexFunctions(ir, starts, reachable, queue, &tail)
        if tail != 0 { tail = discoverReachable(ir, starts, reachable, queue, tail) }
        const result = if function_count != 0 && tail != 0 { eliminateUnreachable(ir, starts, reachable, symbol_count) } else { emptyResult() }
        allocator.free(starts_memory, symbol_count * @sizeOf(usize), @alignOf(usize))
        allocator.free(reachable_memory, symbol_count, @alignOf(u8))
        allocator.free(queue_memory, symbol_count * @sizeOf(usize), @alignOf(usize))
        return result
    }
}
