const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const array_list = @import("../../../std/bootstrap/array_list.mlx")
const vector = @import("../../../std/bootstrap/vector.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")
const lir = @import("./lir.mlx")
const inline_module = @import("./inline.mlx")
const aggregate_copy = @import("./lowering/aggregate_copy.mlx")
const wide = @import("./lowering/wide.mlx")
const decimal = @import("./lowering/decimal.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const lexer = @import("../lexer.mlx")
const source_module = @import("../source.mlx")
const types_store = @import("../sema/types/store.mlx")
const type_resolve = @import("../sema/types/resolve.mlx")
const symbols_store = @import("../sema/symbols/store.mlx")
const symbol_module = @import("../sema/symbols/symbol.mlx")
const scope_module = @import("../sema/symbols/scope.mlx")
const comptime_value = @import("../sema/comptime/value.mlx")
const comptime_module = @import("../comptime.mlx")
const declarations = @import("../sema/declarations.mlx")
const type_names = @import("../sema/type_names.mlx")
const builtins = @import("../builtins.mlx")
const atomics = @import("../sema/builtins/atomics.mlx")
const loader_module = @import("../modules/loader.mlx")
const model = @import("../modules/model.mlx")
const store_module = @import("../modules/store.mlx")

pub const Allocator = allocator_module.Allocator

pub const Binding = struct {
    namePointer: [*]const u8
    nameLength: usize
    address: usize
    secondaryAddress: usize
    tertiaryAddress: usize
    typeId: usize
    valueTypeId: usize
    comptimeTag: u8
    comptimeInteger: isize
    componentsStart: usize
    componentCount: usize
    directValue: bool
    dropFlagAddress: usize
    // The aggregate's storage is a region of the frame (a `const` local's
    // copy), gone once the function returns.
    frameStorage: bool
}

const GenericArgument = struct {
    typeId: usize
    valueTypeId: usize
    comptimeTag: u8
    comptimeInteger: isize
}

const GenericInstance = struct {
    moduleId: usize
    declaration: usize
    symbolId: usize
    argumentsStart: usize
    argumentCount: usize
    functionTypeId: usize
    // A method of a generic type instance's aggregate: the instance's
    // scope (its parameters and constants), the aggregate it is a method
    // of, and the instance's salt (types.instanceSalt); 0 otherwise.
    scopeAddress: usize
    ownerTypeId: usize
    salt: usize
}

const LoopTarget = struct {
    labelPointer: [*]const u8
    labelLength: usize
    breakBlock: usize
    continueBlock: usize
    resultAddress: usize
    deferDepth: usize
}

const CleanupKind = enum(u8) {
    explicit,
    auto_drop
}

const Cleanup = struct {
    kind: CleanupKind
    nodeIndex: usize
    address: usize
    initialized: usize
    typeId: usize
    declaration: usize
}

const FieldMetadata = struct {
    found: bool
    typeId: usize
    offset: usize
}

const NodeTypeCache = struct {
    expressionModule: u32
    expressionTypeId: u32
}

const CallArguments = struct {
    start: usize
    count: usize
}

const InlineExpansion = struct {
    expanded: bool
    value: usize
}

// An identifier a module takes the address of: the token after an `&`.
const AddressTakenName = struct {
    module: usize
    token: usize
}

pub const LirBuilder = struct {
    lir: *lir.Lir
    loader: *loader_module.Loader
    typeStore: *types_store.Store
    symbolStore: *symbols_store.Store
    currentModuleId: usize
    // Current module context (cached from module)
    sourcePointer: [*]const u8
    sourceLength: usize
    tokensAddress: usize
    nodesAddress: usize
    // Per-function state
    paramCounter: usize
    currentReturnType: usize
    // How many `const` locals of the function being lowered hold a copy in
    // its frame (only then may `return` have to copy out of the frame).
    frameStorageCount: usize
    // The storage the caller gave for the result (lir.FLAG_RETURN_SLOT),
    // or NONE. A `return` of a call hands that call this storage instead
    // of copying its result over: `forwardCall` is the call's node (in
    // module `forwardModule`) while its value is lowered, `forwardedCall`
    // the node once the call took the storage.
    returnSlot: usize
    forwardCall: usize
    forwardModule: usize
    forwardedCall: usize
    bindings: *vector.Vector
    bindingComponents: *vector.Vector
    loopTargets: *vector.Vector
    deferredNodes: *vector.Vector
    genericArguments: *vector.Vector
    genericInstances: *vector.Vector
    inlineStack: *vector.Vector
    // The identifiers whose address a module takes (`&NAME`): token
    // indices with their module, filled the first time a module asks, and
    // the modules filled so far.
    addressTakenNames: *vector.Vector
    addressTakenModules: *vector.Vector
    lirSymbolIds: [*]usize
    lirSymbolCapacity: usize
    typeCache: [*]NodeTypeCache
    typeCacheCapacity: usize
    expressionTypeQueries: usize
    expressionTypeHits: usize
    resolvedTypeQueries: usize
    resolvedTypeHits: usize
    unsupportedLoweringCount: usize
    // The operator or builtin being lowered (for an unsupported form).
    operatorToken: usize
    firstUnsupportedOffset: usize
    firstUnsupportedLength: usize
    firstUnsupportedModule: usize
    inlinedCallCount: usize
    // `x == A || x == B || ...` chains tested as one bit mask.
    membershipTestCount: usize
    automaticallyInlinedCallCount: usize
    inlineMissCount: usize
    optimizationLevel: u8
    runtimeSafety: bool
    currentGenericInstance: usize
    currentMethodOwner: usize
    // The scope names resolve in instead of the module's: a generic type
    // instance's, while its methods are lowered (0: the module's).
    scopeOverride: usize
    // How many of the generic instances have been generated.
    generatedGenericInstances: usize
    // The owner's name a function symbol made now gets in the executable's
    // symbol table (`Box(u32).get`); none when ownerNameLength is 0.
    ownerNamePointer: [*]const u8
    ownerNameLength: usize
    // The aggregates enclosing the one whose methods are lowered (a nested
    // `pub const Iterator = struct { ... }` names the members of the
    // aggregate it is in), the innermost last.
    enclosingOwners: [8]usize
    enclosingOwnerCount: usize
    blockCounter: usize
    breakTarget: usize
    continueTarget: usize
    allocator: allocator_module.Allocator
}

pub fn init(
    target_lir: *lir.Lir,
    type_store: *types_store.Store,
    symbol_store: *symbols_store.Store,
    loader: *loader_module.Loader,
    allocator: Allocator,
    optimization_level: u8,
    runtime_safety: bool,
) -> LirBuilder {
    unsafe {
        const bindings = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const binding_components = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const loop_targets = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const deferred_nodes = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const generic_arguments = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const generic_instances = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const inline_stack = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const address_taken_names = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const address_taken_modules = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const symbol_capacity = if symbol_store.*.length > 0 { symbol_store.*.length } else { 1 }
        const lir_symbol_ids = @ptrCast([*]usize, allocator.alloc(symbol_capacity * @sizeOf(usize), @alignOf(usize)).?)
        const type_cache = @ptrCast([*]NodeTypeCache, allocator.alloc(@sizeOf(NodeTypeCache), @alignOf(NodeTypeCache)).?)
        vector.Vector.initAt(bindings, allocator, @sizeOf(Binding), @alignOf(Binding), 32)
        vector.Vector.initAt(binding_components, allocator, @sizeOf(usize), @alignOf(usize), 64)
        vector.Vector.initAt(loop_targets, allocator, @sizeOf(LoopTarget), @alignOf(LoopTarget), 16)
        vector.Vector.initAt(deferred_nodes, allocator, @sizeOf(Cleanup), @alignOf(Cleanup), 16)
        vector.Vector.initAt(generic_arguments, allocator, @sizeOf(GenericArgument), @alignOf(GenericArgument), 64)
        vector.Vector.initAt(generic_instances, allocator, @sizeOf(GenericInstance), @alignOf(GenericInstance), 32)
        vector.Vector.initAt(inline_stack, allocator, @sizeOf(usize), @alignOf(usize), 16)
        vector.Vector.initAt(address_taken_names, allocator, @sizeOf(AddressTakenName), @alignOf(AddressTakenName), 64)
        vector.Vector.initAt(address_taken_modules, allocator, @sizeOf(usize), @alignOf(usize), 16)
        var symbol_index: usize = 0
        while symbol_index < symbol_capacity {
            lir_symbol_ids[symbol_index] = lir.NONE
            symbol_index += 1
        }
        type_cache[0].expressionModule = 0
        return LirBuilder.{
            .lir = target_lir,
            .loader = loader,
            .typeStore = type_store,
            .symbolStore = symbol_store,
            .currentModuleId = 0,
            .sourcePointer = @ptrCast([*]const u8, ""),
            .sourceLength = 0,
            .tokensAddress = 0,
            .nodesAddress = 0,
            .paramCounter = 0,
            .currentReturnType = lir.NONE,
            .frameStorageCount = 0,
            .returnSlot = lir.NONE,
            .forwardCall = ast.NONE,
            .forwardModule = 0,
            .forwardedCall = ast.NONE,
            .bindings = bindings,
            .bindingComponents = binding_components,
            .loopTargets = loop_targets,
            .deferredNodes = deferred_nodes,
            .genericArguments = generic_arguments,
            .genericInstances = generic_instances,
            .inlineStack = inline_stack,
            .addressTakenNames = address_taken_names,
            .addressTakenModules = address_taken_modules,
            .lirSymbolIds = lir_symbol_ids,
            .lirSymbolCapacity = symbol_capacity,
            .typeCache = type_cache,
            .typeCacheCapacity = 1,
            .expressionTypeQueries = 0,
            .expressionTypeHits = 0,
            .resolvedTypeQueries = 0,
            .resolvedTypeHits = 0,
            .unsupportedLoweringCount = 0,
            .operatorToken = 0,
            .firstUnsupportedOffset = 0,
            .firstUnsupportedLength = 0,
            .firstUnsupportedModule = 0,
            .inlinedCallCount = 0,
            .membershipTestCount = 0,
            .automaticallyInlinedCallCount = 0,
            .inlineMissCount = 0,
            .optimizationLevel = optimization_level,
            .runtimeSafety = runtime_safety,
            .currentGenericInstance = lir.NONE,
            .currentMethodOwner = lir.NONE,
            .scopeOverride = 0,
            .generatedGenericInstances = 0,
            .ownerNamePointer = @ptrFromInt([*]const u8, 0),
            .ownerNameLength = 0,
            .enclosingOwners = undefined,
            .enclosingOwnerCount = 0,
            .blockCounter = 0,
            .breakTarget = lir.NONE,
            .continueTarget = lir.NONE,
            .allocator = allocator,
        }
    }
}

pub fn deinit(builder: *LirBuilder) -> void {
    vector.Vector.deinit(builder.*.bindings.*)
    vector.Vector.deinit(builder.*.bindingComponents.*)
    vector.Vector.deinit(builder.*.loopTargets.*)
    vector.Vector.deinit(builder.*.deferredNodes.*)
    vector.Vector.deinit(builder.*.genericArguments.*)
    vector.Vector.deinit(builder.*.genericInstances.*)
    vector.Vector.deinit(builder.*.inlineStack.*)
    vector.Vector.deinit(builder.*.addressTakenNames.*)
    vector.Vector.deinit(builder.*.addressTakenModules.*)
    unsafe {
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.bindings), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.bindingComponents), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.loopTargets), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.deferredNodes), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.genericArguments), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.genericInstances), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.inlineStack), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.addressTakenNames), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.addressTakenModules), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.lirSymbolIds), builder.*.lirSymbolCapacity * @sizeOf(usize), @alignOf(usize))
        builder.*.allocator.free(@ptrCast([*]u8, builder.*.typeCache), builder.*.typeCacheCapacity * @sizeOf(NodeTypeCache), @alignOf(NodeTypeCache))
    }
}

fn switchToModule(builder: *LirBuilder, module_id: usize) -> void {
    builder.*.currentModuleId = module_id
    const module = loader_module.Loader.moduleAt(builder.*.loader, module_id)
    if module.*.sourceAddress != 0 {
        unsafe {
            const sf = @ptrFromInt(*source_module.SourceFile, module.*.sourceAddress)
            builder.*.sourcePointer = @ptrCast([*]const u8, sf.*.bytes)
            builder.*.sourceLength = sf.*.length
        }
    }
    builder.*.tokensAddress = module.*.tokensAddress
    builder.*.nodesAddress = module.*.nodesAddress
    if module.*.nodesAddress != 0 {
        unsafe {
            const nodes = @ptrFromInt(*ast_store.Store, module.*.nodesAddress)
            ensureTypeCache(builder, nodes.*.length)
        }
    }
}

fn ensureTypeCache(builder: *LirBuilder, required: usize) -> void {
    if required <= builder.*.typeCacheCapacity { return }
    var capacity = builder.*.typeCacheCapacity
    while capacity < required { capacity *= 2 }
    var cache_memory: [*]u8 = undefined
    unsafe { cache_memory = @ptrCast([*]u8, builder.*.typeCache) }
    const resized = builder.*.allocator.resize(
        cache_memory,
        builder.*.typeCacheCapacity * @sizeOf(NodeTypeCache),
        capacity * @sizeOf(NodeTypeCache),
        @alignOf(NodeTypeCache),
    )
    if resized == null { return }
    const previous = builder.*.typeCacheCapacity
    unsafe { builder.*.typeCache = @ptrCast([*]NodeTypeCache, resized.?) }
    builder.*.typeCacheCapacity = capacity
    var index = previous
    while index < capacity {
        const entry = typeCacheEntry(builder, index)
        entry.*.expressionModule = 0
        index += 1
    }
}

inline fn typeCacheEntry(builder: *LirBuilder, index: usize) -> *NodeTypeCache {
    unsafe { return @ptrFromInt(*NodeTypeCache, @intFromPtr(builder.*.typeCache) + index * @sizeOf(NodeTypeCache)) }
}

inline fn getNodes(builder: *LirBuilder) -> *ast_store.Store {
    unsafe { return @ptrFromInt(*ast_store.Store, builder.*.nodesAddress) }
}

inline fn getTokens(builder: *LirBuilder) -> *lexer.Buffer {
    unsafe { return @ptrFromInt(*lexer.Buffer, builder.*.tokensAddress) }
}

inline fn bindingsPointer(builder: *LirBuilder) -> *vector.Vector {
    return builder.*.bindings
}

inline fn tokenStart(builder: *LirBuilder, token_index: usize) -> usize {
    return lexer.tokenAt(getTokens(builder).*, token_index).start
}

inline fn tokenLength(builder: *LirBuilder, token_index: usize) -> usize {
    return lexer.tokenAt(getTokens(builder).*, token_index).length
}

fn tokenPointer(builder: *LirBuilder, token_index: usize) -> [*]const u8 {
    const start = tokenStart(builder, token_index)
    unsafe {
        return @ptrFromInt([*]const u8, @intFromPtr(builder.*.sourcePointer) + start)
    }
}

inline fn tokenKind(builder: *LirBuilder, token_index: usize) -> lexer.Kind {
    return lexer.tokenAt(getTokens(builder).*, token_index).kind
}

pub fn generateModule(builder: *LirBuilder, module_id: usize) -> void {
    switchToModule(builder, module_id)
    const module = loader_module.Loader.moduleAt(builder.*.loader, module_id)
    if module.*.state != model.State.loaded { return }
    if module.*.nodesAddress == 0 { return }
    generate(builder, module.*.rootNode)
}

pub fn generate(builder: *LirBuilder, root_index: usize) -> void {
    const nodes = getNodes(builder)
    if root_index == ast.NONE || root_index >= nodes.*.length { return }
    const root = ast_store.Store.get(nodes, root_index)
    if root.tag != ast.Tag.root { return }
    var child = root.lhs
    var count: usize = 0
    while child != ast.NONE && count < root.rhs {
        const node = ast_store.Store.get(nodes, child)
        if !isGenericDeclaration(nodes, child) { lowerDeclaration(builder, child) }
        if node.tag == ast.Tag.constant_declaration || node.tag == ast.Tag.variable_declaration { lowerAggregateDeclarations(builder, child) }
        if node.tag == ast.Tag.constant_declaration { lowerDataExport(builder, child) }
        if node.tag == ast.Tag.variable_declaration { lowerGlobalDeclaration(builder, child) }
        child = node.next
        count += 1
    }
}

// A module-level `var` is a global (lir.Global): storage in the image's
// data area, reached RIP-relative, found by its sema symbol. One is made
// the first time it is declared or referred to (a function of an earlier
// module may use a global of a later one). Its initial value is a scalar
// known at compile time (an integer, a bool, null); `undefined` and
// aggregates start zeroed; any other initializer has no lowering yet and
// is reported. `threadlocal` stays unsupported (lowerDeclaration).
fn lowerGlobalDeclaration(builder: *LirBuilder, declaration: usize) -> void {
    const node = ast_store.Store.get(getNodes(builder), declaration)
    if node.extra & 32 != 0 { return }
    const found = scope_module.Scope.lookup(currentScope(builder), tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
    if !found.0 { return }
    if !isGlobalSymbol(symbols_store.Store.get(builder.*.symbolStore, found.1)) { return }
    const index = globalIndexFor(builder, found.1)
}

fn isGlobalSymbol(symbol: *symbol_module.Symbol) -> bool {
    if symbol.*.flags & (symbol_module.FLAG_CONSTANT | symbol_module.FLAG_FUNCTION | symbol_module.FLAG_PARAMETER | symbol_module.FLAG_EXTERN | symbol_module.FLAG_THREADLOCAL) != 0 { return false }
    return symbol.*.declaration != ast.NONE && symbol.*.typeId != 0 && symbol.*.ownerTypeId == 0
}

fn globalIndexFor(builder: *LirBuilder, symbol_index: usize) -> usize {
    const existing = lir.findGlobal(builder.*.lir, symbol_index)
    if existing != lir.NONE { return existing }
    const symbol = symbols_store.Store.get(builder.*.symbolStore, symbol_index)
    const module_id = moduleForSymbol(builder, symbol_index)
    const previous_module = builder.*.currentModuleId
    if module_id != previous_module { switchToModule(builder, module_id) }
    var value: u64 = 0
    var bytes: [*]const u8 = undefined
    unsafe { bytes = @ptrFromInt([*]const u8, 0) }
    var byte_count: usize = 0
    var size = types_store.Store.sizeOf(builder.*.typeStore, symbol.*.typeId)
    if size == 0 { size = 8 }
    const nodes = getNodes(builder)
    if symbol.*.declaration < nodes.*.length {
        const declaration = ast_store.Store.get(nodes, symbol.*.declaration)
        if declaration.tag == ast.Tag.variable_declaration && declaration.rhs != ast.NONE {
            const initializer = ast_store.Store.get(nodes, declaration.rhs)
            // (A tagged optional of a scalar is bytes too: the payload and
            // then its tag, writeInitialBytes.)
            if initializer.tag == ast.Tag.array_literal || initializer.tag == ast.Tag.aggregate_literal || (isTaggedOptional(builder, symbol.*.typeId) && initializer.tag != ast.Tag.undefined_literal && initializer.tag != ast.Tag.null_literal) {
                // An aggregate of compile-time scalars: its bytes.
                const image = builder.*.allocator.alloc(size, 8)
                if image != null {
                    var target = image.?
                    var index: usize = 0
                    while index < size {
                        target[index] = 0
                        index += 1
                    }
                    if writeInitialBytes(builder, declaration.rhs, symbol.*.typeId, target) {
                        bytes = target
                        byte_count = size
                    } else {
                        recordUnsupportedBuiltin(builder, initializer.mainToken)
                    }
                }
            } else if isScalarInitializer(initializer.tag) {
                const initial = lowerComptimeValue(builder, declaration.rhs)
                if initial.kind == comptime_value.Kind.integer || initial.kind == comptime_value.Kind.boolean {
                    value = @bitCast(u64, @intCast(i64, initial.integer))
                } else {
                    recordUnsupportedBuiltin(builder, initializer.mainToken)
                }
            } else if initializer.tag != ast.Tag.undefined_literal && initializer.tag != ast.Tag.null_literal {
                recordUnsupportedBuiltin(builder, initializer.mainToken)
            }
        }
    }
    if module_id != previous_module { switchToModule(builder, previous_module) }
    var alignment = types_store.Store.alignOf(builder.*.typeStore, symbol.*.typeId)
    if alignment == 0 { alignment = 1 }
    if symbol.*.flags & symbol_module.FLAG_EXPORT != 0 {
        return lir.addGlobal(builder.*.lir, symbol.*.namePointer, symbol.*.nameLength, size, alignment, value, bytes, byte_count, true, symbol_index)
    }
    const label = lir.globalLabel(builder.*.lir, lir.globalCount(builder.*.lir))
    return lir.addGlobal(builder.*.lir, label.0, label.1, size, alignment, value, bytes, byte_count, false, symbol_index)
}

// The initializer shapes a compile-time scalar can take (what
// lowerComptimeValue reads without the comptime evaluator).
fn isScalarInitializer(tag: ast.Tag) -> bool {
    return tag == ast.Tag.integer_literal || tag == ast.Tag.character_literal || tag == ast.Tag.boolean_literal || tag == ast.Tag.identifier || tag == ast.Tag.named_type || tag == ast.Tag.unary_expression || tag == ast.Tag.binary_expression || tag == ast.Tag.builtin_call || tag == ast.Tag.field_expression
}

// A global's aggregate initializer written into `target` (zeroed, the
// type's size): array literals element by element, struct literals field
// by field, scalars at their width; false for a value not known at
// compile time.
fn writeInitialBytes(builder: *LirBuilder, node_index: usize, type_id: usize, target: [*]u8) -> bool {
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    const value_type = types_store.Store.get(builder.*.typeStore, type_id)
    if node.tag == ast.Tag.array_literal {
        if value_type.*.kind != types_store.Kind.array { return false }
        const element_type = value_type.*.lhs
        const element_size = types_store.Store.sizeOf(builder.*.typeStore, element_type)
        var child = node.lhs
        var index: usize = 0
        while child != ast.NONE {
            if index >= value_type.*.bits { return false }
            var element: [*]u8 = undefined
            unsafe { element = @ptrFromInt([*]u8, @intFromPtr(target) + index * element_size) }
            if !writeInitialBytes(builder, child, element_type, element) { return false }
            child = ast_store.Store.get(nodes, child).next
            index += 1
        }
        return true
    }
    if node.tag == ast.Tag.aggregate_literal {
        if value_type.*.kind != types_store.Kind.struct_type { return false }
        var initializer_index = node.rhs
        while initializer_index != ast.NONE {
            const initializer = ast_store.Store.get(nodes, initializer_index)
            const metadata = fieldMetadata(builder, type_id, initializer.mainToken)
            if !metadata.found { return false }
            var field: [*]u8 = undefined
            unsafe { field = @ptrFromInt([*]u8, @intFromPtr(target) + metadata.offset) }
            if !writeInitialBytes(builder, initializer.rhs, metadata.typeId, field) { return false }
            initializer_index = initializer.next
        }
        return true
    }
    if node.tag == ast.Tag.undefined_literal || node.tag == ast.Tag.null_literal { return true }
    if !isScalarInitializer(node.tag) { return false }
    const scalar = lowerComptimeValue(builder, node_index)
    if scalar.kind != comptime_value.Kind.integer && scalar.kind != comptime_value.Kind.boolean { return false }
    const tagged = isTaggedOptional(builder, type_id)
    var width = types_store.Store.sizeOf(builder.*.typeStore, if tagged { optionalPayloadType(builder, type_id) } else { type_id })
    if width == 0 || width > 8 { return false }
    const bits = @bitCast(u64, @intCast(i64, scalar.integer))
    var byte: usize = 0
    while byte < width {
        target[byte] = @intCast(u8, (bits >> @intCast(u6, byte * 8)) & 255)
        byte += 1
    }
    if tagged { target[width] = 1 }
    return true
}

fn globalAddress(builder: *LirBuilder, symbol_index: usize) -> usize {
    var inst = lir.initInst(lir.Opcode.global_address, lir.NONE)
    inst.arg0 = globalIndexFor(builder, symbol_index)
    return lir.addInst(builder.*.lir, inst)
}

// The module-level var called `name`, when there is one (the function's
// bindings are looked up first by the callers).
fn globalSymbolNamed(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize) -> (bool, usize) {
    if !hasScope(builder) { return -> (false, 0) }
    unsafe {
        const scope = currentScope(builder)
        const found = scope_module.Scope.lookup(scope, name_ptr, name_len)
        if !found.0 { return -> (false, 0) }
        if !isGlobalSymbol(symbols_store.Store.get(builder.*.symbolStore, found.1)) { return -> (false, 0) }
        return -> (true, found.1)
    }
}

// Whether an assignment's target (or an address taken) is a global: a bare
// name that is no local, or `module.name`.
fn globalTarget(builder: *LirBuilder, node_index: usize) -> (bool, usize) {
    if node_index == ast.NONE { return -> (false, 0) }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.identifier {
        const name_ptr = tokenPointer(builder, node.mainToken)
        const name_len = tokenLength(builder, node.mainToken)
        if @intFromPtr(findBindingRecord(builder, name_ptr, name_len)) != 0 { return -> (false, 0) }
        return globalSymbolNamed(builder, name_ptr, name_len)
    }
    if node.tag == ast.Tag.field_expression {
        const referenced = referencedSymbolIndex(builder, node_index)
        if referenced.0 && isGlobalSymbol(symbols_store.Store.get(builder.*.symbolStore, referenced.1)) { return -> (true, referenced.1) }
    }
    return -> (false, 0)
}

// The value of a global: an aggregate is its address, a value of several
// words (a slice) its words loaded, a scalar loaded at its width.
fn lowerGlobalValue(builder: *LirBuilder, symbol_index: usize, symbol: *symbol_module.Symbol) -> usize {
    return lowerMemoryValue(builder, globalAddress(builder, symbol_index), symbol.*.typeId)
}

// A module-level `export const NAME: T = value` of an integer type is a
// data symbol of the image (lir.DataExport): sema checked the type and the
// value, which the backend lays out in the data area.
fn lowerDataExport(builder: *LirBuilder, declaration: usize) -> void {
    const nodes = getNodes(builder)
    const binding = ast_store.Store.get(nodes, declaration)
    if binding.extra & 2 == 0 { return }
    const found = scope_module.Scope.lookup(currentScope(builder), tokenPointer(builder, binding.mainToken), tokenLength(builder, binding.mainToken))
    if !found.0 { return }
    const symbol = symbols_store.Store.get(builder.*.symbolStore, found.1)
    if symbol.*.flags & symbol_module.FLAG_EXPORT == 0 || symbol.*.flags & symbol_module.FLAG_FUNCTION != 0 { return }
    if symbol.*.comptimeTag != @intCast(u8, @intFromEnum(comptime_module.Kind.integer)) { return }
    if types_store.Store.get(builder.*.typeStore, symbol.*.typeId).*.kind != types_store.Kind.integer { return }
    const size = types_store.Store.sizeOf(builder.*.typeStore, symbol.*.typeId)
    if size == 0 || size > 8 { return }
    lir.addDataExport(builder.*.lir, symbol.*.namePointer, symbol.*.nameLength, @bitCast(u64, @intCast(i64, symbol.*.comptimeInteger)), size)
}

fn lowerAggregateDeclarations(builder: *LirBuilder, declaration: usize) -> void {
    const nodes = getNodes(builder)
    const binding = ast_store.Store.get(nodes, declaration)
    if binding.rhs == ast.NONE { return }
    var aggregate_index = binding.rhs
    var aggregate = ast_store.Store.get(nodes, aggregate_index)
    if aggregate.tag == ast.Tag.nocopy_type {
        aggregate_index = aggregate.lhs
        aggregate = ast_store.Store.get(nodes, aggregate_index)
    }
    if aggregate.tag != ast.Tag.struct_type && aggregate.tag != ast.Tag.enum_type && aggregate.tag != ast.Tag.union_type { return }
    const binding_symbol = scope_module.Scope.lookup(currentScope(builder), tokenPointer(builder, binding.mainToken), tokenLength(builder, binding.mainToken))
    if !binding_symbol.0 { return }
    const owner_type = symbols_store.Store.get(builder.*.symbolStore, binding_symbol.1).*.valueTypeId
    if owner_type == 0 { return }
    lowerAggregateMembers(builder, aggregate_index, owner_type)
}

// The methods of the aggregate at `aggregate_index`, whose type is
// `owner_type`, and of the aggregates its constants declare (`pub const
// Iterator = struct { ... }`), with each as `Self` of its own.
fn lowerAggregateMembers(builder: *LirBuilder, aggregate_index: usize, owner_type: usize) -> void {
    const nodes = getNodes(builder)
    const aggregate = ast_store.Store.get(nodes, aggregate_index)
    const saved_owner = builder.*.currentMethodOwner
    const saved_owner_name = builder.*.ownerNamePointer
    const saved_owner_name_length = builder.*.ownerNameLength
    builder.*.currentMethodOwner = owner_type
    var member = aggregate.lhs
    var visited: usize = 0
    while member != ast.NONE && visited < aggregate.rhs {
        const value = ast_store.Store.get(nodes, member)
        if value.tag == ast.Tag.function_declaration && !isGenericDeclaration(nodes, member) { lowerFunction(builder, member) }
        if value.tag == ast.Tag.constant_declaration && value.rhs != ast.NONE {
            var nested_index = value.rhs
            var nested = ast_store.Store.get(nodes, nested_index)
            if nested.tag == ast.Tag.nocopy_type && nested.lhs != ast.NONE {
                nested_index = nested.lhs
                nested = ast_store.Store.get(nodes, nested_index)
            }
            if nested.tag == ast.Tag.struct_type || nested.tag == ast.Tag.enum_type || nested.tag == ast.Tag.union_type {
                const constant = aggregateMethodIndex(builder, owner_type, tokenPointer(builder, value.mainToken), tokenLength(builder, value.mainToken))
                if constant != lir.NONE {
                    const nested_type = symbols_store.Store.get(builder.*.symbolStore, constant).*.valueTypeId
                    if nested_type != 0 && builder.*.enclosingOwnerCount < 8 {
                        if builder.*.ownerNameLength != 0 { setOwnerName(builder, nested_type) }
                        builder.*.enclosingOwners[builder.*.enclosingOwnerCount] = owner_type
                        builder.*.enclosingOwnerCount += 1
                        lowerAggregateMembers(builder, nested_index, nested_type)
                        builder.*.enclosingOwnerCount -= 1
                        builder.*.ownerNamePointer = saved_owner_name
                        builder.*.ownerNameLength = saved_owner_name_length
                    }
                }
            }
        }
        member = value.next
        visited += 1
    }
    builder.*.currentMethodOwner = saved_owner
}

fn isGenericDeclaration(nodes: *ast_store.Store, declaration: usize) -> bool {
    const node = ast_store.Store.get(nodes, declaration)
    if node.tag != ast.Tag.function_declaration { return false }
    var parameter = node.lhs
    while parameter != ast.NONE {
        const value = ast_store.Store.get(nodes, parameter)
        if value.lhs == ast.NONE || value.extra & 1 != 0 { return true }
        parameter = value.next
    }
    return false
}

fn moduleForSymbol(builder: *LirBuilder, symbol_index: usize) -> usize {
    if symbol_index >= builder.*.symbolStore.*.length { return builder.*.currentModuleId }
    return symbols_store.Store.get(builder.*.symbolStore, symbol_index).*.moduleId
}

inline fn genericArgumentAt(builder: *LirBuilder, index: usize) -> *GenericArgument {
    unsafe { return @ptrCast(*GenericArgument, vector.Vector.at(builder.*.genericArguments.*, index)) }
}

inline fn genericInstanceAt(builder: *LirBuilder, index: usize) -> *GenericInstance {
    unsafe { return @ptrCast(*GenericInstance, vector.Vector.at(builder.*.genericInstances.*, index)) }
}

fn appendGenericArgument(builder: *LirBuilder, argument: *GenericArgument) -> void {
    unsafe { const appended = vector.Vector.appendAt(builder.*.genericArguments, @ptrCast([*]const u8, argument)) }
}

fn appendGenericInstance(builder: *LirBuilder, instance: *GenericInstance) -> void {
    unsafe { const appended = vector.Vector.appendAt(builder.*.genericInstances, @ptrCast([*]const u8, instance)) }
}

fn sameGenericArguments(builder: *LirBuilder, left_start: usize, right_start: usize, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        const left = genericArgumentAt(builder, left_start + index)
        const right = genericArgumentAt(builder, right_start + index)
        if left.*.typeId != right.*.typeId || left.*.valueTypeId != right.*.valueTypeId || left.*.comptimeTag != right.*.comptimeTag || left.*.comptimeInteger != right.*.comptimeInteger { return false }
        index += 1
    }
    return true
}

fn genericParameterIndex(builder: *LirBuilder, declaration: ast.Node, identifier: ast.Node) -> usize {
    if identifier.tag != ast.Tag.identifier && identifier.tag != ast.Tag.named_type { return lir.NONE }
    const identifier_pointer = tokenPointer(builder, identifier.mainToken)
    const identifier_length = tokenLength(builder, identifier.mainToken)
    var parameter = declaration.lhs
    var index: usize = 0
    while parameter != ast.NONE {
        const value = ast_store.Store.get(getNodes(builder), parameter)
        if tokenLength(builder, value.mainToken) == identifier_length && mem.eql(tokenPointer(builder, value.mainToken), identifier_pointer, identifier_length) { return index }
        parameter = value.next
        index += 1
    }
    return lir.NONE
}

fn genericArgumentTypeForNode(builder: *LirBuilder, declaration: ast.Node, arguments_start: usize, argument_count: usize, node_index: usize) -> usize {
    if node_index == ast.NONE { return 0 }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    const parameter_index = genericParameterIndex(builder, declaration, node)
    if parameter_index != lir.NONE && parameter_index < argument_count { return genericArgumentAt(builder, arguments_start + parameter_index).*.typeId }
    return 0
}

fn genericSelectorValue(builder: *LirBuilder, declaration: ast.Node, arguments_start: usize, argument_count: usize, node_index: usize) -> comptime_value.Value {
    if node_index == ast.NONE { return comptime_value.invalid() }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.integer_literal { return comptime_value.integer(@intCast(isize, lowerIntValue(builder, node.mainToken))) }
    const parameter_index = genericParameterIndex(builder, declaration, node)
    if parameter_index != lir.NONE && parameter_index < argument_count {
        const argument = genericArgumentAt(builder, arguments_start + parameter_index)
        if argument.*.comptimeTag != 0 { return comptime_value.integer(argument.*.comptimeInteger) }
    }
    return comptime_value.invalid()
}

fn genericReturnExpressionType(builder: *LirBuilder, declaration: ast.Node, arguments_start: usize, argument_count: usize, node_index: usize) -> usize {
    if node_index == ast.NONE { return 0 }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    const direct_type = genericArgumentTypeForNode(builder, declaration, arguments_start, argument_count, node_index)
    if direct_type != 0 { return direct_type }
    if node.tag == ast.Tag.builtin_call {
        const kind = builtins.lookup(builder.*.sourcePointer[0..builder.*.sourceLength], getTokens(builder).*, node.mainToken)
        if kind == builtins.Kind.field && node.lhs != ast.NONE {
            const base_type_id = genericArgumentTypeForNode(builder, declaration, arguments_start, argument_count, node.lhs)
            const selector_node = ast_store.Store.get(getNodes(builder), node.lhs).next
            const selector = genericSelectorValue(builder, declaration, arguments_start, argument_count, selector_node)
            if base_type_id == 0 || !comptime_module.isValid(selector) || selector.integer < 0 { return 0 }
            const base_type = types_store.Store.get(builder.*.typeStore, base_type_id)
            const index = @intCast(usize, selector.integer)
            if index >= base_type.*.extraLength { return 0 }
            if base_type.*.kind == types_store.Kind.tuple { return types_store.Store.extraAt(builder.*.typeStore, base_type.*.extraStart + index) }
            if base_type.*.kind == types_store.Kind.struct_type || base_type.*.kind == types_store.Kind.union_type { return types_store.Store.fieldAt(builder.*.typeStore, base_type.*.extraStart + index).*.typeId }
        }
    }
    return 0
}

fn genericBodyReturnType(builder: *LirBuilder, declaration: ast.Node, arguments_start: usize, argument_count: usize) -> usize {
    if declaration.rhs == ast.NONE { return 0 }
    const body = ast_store.Store.get(getNodes(builder), declaration.rhs)
    var statement = if body.tag == ast.Tag.block { body.lhs } else { declaration.rhs }
    while statement != ast.NONE {
        const value = ast_store.Store.get(getNodes(builder), statement)
        if value.tag == ast.Tag.return_statement { return genericReturnExpressionType(builder, declaration, arguments_start, argument_count, value.rhs) }
        statement = value.next
    }
    return 0
}

fn genericAnnotatedReturnType(builder: *LirBuilder, declaration: ast.Node, arguments_start: usize, argument_count: usize) -> usize {
    if declaration.extra == ast.NONE { return 0 }
    const return_node = ast_store.Store.get(getNodes(builder), declaration.extra)
    const parameter_index = genericParameterIndex(builder, declaration, return_node)
    if parameter_index == lir.NONE || parameter_index >= argument_count { return 0 }
    const argument = genericArgumentAt(builder, arguments_start + parameter_index)
    if argument.*.valueTypeId != 0 { return argument.*.valueTypeId }
    return argument.*.typeId
}

fn ensureGenericInstance(builder: *LirBuilder, call_index: usize, symbol_index: usize) -> usize {
    const caller_nodes = getNodes(builder)
    const call = ast_store.Store.get(caller_nodes, call_index)
    const symbol = symbols_store.Store.get(builder.*.symbolStore, symbol_index)
    const target_module = moduleForSymbol(builder, symbol_index)
    const target = loader_module.Loader.moduleAt(builder.*.loader, target_module)
    if target.*.nodesAddress == 0 { return lir.NONE }
    unsafe {
        const target_nodes = @ptrFromInt(*ast_store.Store, target.*.nodesAddress)
        if !isGenericDeclaration(target_nodes, symbol.*.declaration) { return lir.NONE }
    }
    // A function returning `type` has no body to generate: its calls are
    // types (instantiateTypeCall).
    if declarations.isTypeFunction(builder.*.typeStore, symbol) { return lir.NONE }

    const arguments_start = builder.*.genericArguments.*.length
    var argument_node = call.rhs
    var argument_count: usize = 0
    while argument_node != ast.NONE && argument_count < call.extra {
        const argument_ast = ast_store.Store.get(caller_nodes, argument_node)
        var argument = GenericArgument.{
            .typeId = expressionType(builder, argument_node),
            .valueTypeId = resolveTypeNode(builder, argument_node),
            .comptimeTag = 0,
            .comptimeInteger = 0,
        }
        if argument_ast.tag == ast.Tag.identifier || argument_ast.tag == ast.Tag.named_type {
            const binding = findBindingRecord(builder, tokenPointer(builder, argument_ast.mainToken), tokenLength(builder, argument_ast.mainToken))
            if @intFromPtr(binding) != 0 {
                argument.valueTypeId = binding.*.valueTypeId
                argument.comptimeTag = binding.*.comptimeTag
                argument.comptimeInteger = binding.*.comptimeInteger
            }
        }
        if argument.comptimeTag == 0 {
            const value = lowerComptimeValue(builder, argument_node)
            if comptime_module.isValid(value) {
                argument.comptimeTag = @intCast(u8, @intFromEnum(value.kind))
                argument.comptimeInteger = value.integer
                if value.kind == comptime_value.Kind.type_value { argument.valueTypeId = value.typeId }
            }
        }
        appendGenericArgument(builder, &argument)
        argument_node = argument_ast.next
        argument_count += 1
    }
    if argument_count != call.extra { return lir.NONE }

    var existing: usize = 0
    while existing < builder.*.genericInstances.*.length {
        const instance = genericInstanceAt(builder, existing)
        if instance.*.moduleId == target_module && instance.*.declaration == symbol.*.declaration && instance.*.argumentCount == argument_count && sameGenericArguments(builder, instance.*.argumentsStart, arguments_start, argument_count) { return existing }
        existing += 1
    }

    const caller_module = builder.*.currentModuleId
    switchToModule(builder, target_module)
    const nodes = getNodes(builder)
    const declaration = ast_store.Store.get(nodes, symbol.*.declaration)
    // The instance's context while its signature is resolved: a method of
    // a generic type instance's aggregate resolves names in that instance's
    // scope, with that aggregate as `Self`.
    var instance_scope: usize = 0
    var instance_salt: usize = 0
    var owner_type: usize = symbol.*.ownerTypeId
    if owner_type != 0 {
        const declaring = types_store.Store.instanceDeclaring(builder.*.typeStore, owner_type)
        if declaring != types_store.NONE {
            instance_scope = types_store.Store.instanceAt(builder.*.typeStore, declaring).*.scopeAddress
            instance_salt = declaring + 1
        }
    }
    const saved_scope = builder.*.scopeOverride
    const saved_owner = builder.*.currentMethodOwner
    const saved_salt = types_store.Store.setInstanceSalt(builder.*.typeStore, instance_salt)
    if instance_scope != 0 { builder.*.scopeOverride = instance_scope }
    if owner_type != 0 { builder.*.currentMethodOwner = owner_type }
    // The comptime parameters bound to their arguments while the parameter
    // and return types are resolved, so that `[*]T`, `?T`, `[]const T` and
    // `Box(T)` are concrete in the instance's function type.
    const bindings_length = builder.*.bindings.*.length
    var bound = declaration.lhs
    var bound_index: usize = 0
    while bound != ast.NONE && bound_index < argument_count {
        const bound_node = ast_store.Store.get(nodes, bound)
        if bound_node.extra & 1 != 0 {
            const argument = genericArgumentAt(builder, arguments_start + bound_index)
            pushComptimeBinding(builder, tokenPointer(builder, bound_node.mainToken), tokenLength(builder, bound_node.mainToken), argument.*.typeId, argument.*.valueTypeId, argument.*.comptimeTag, argument.*.comptimeInteger)
        }
        bound = bound_node.next
        bound_index += 1
    }
    const parameter_start = builder.*.typeStore.*.extraIds.*.length
    var parameter = declaration.lhs
    var parameter_index: usize = 0
    while parameter != ast.NONE && parameter_index < argument_count {
        const parameter_node = ast_store.Store.get(nodes, parameter)
        var parameter_type = genericArgumentAt(builder, arguments_start + parameter_index).*.typeId
        if parameter_node.lhs != ast.NONE {
            const resolved = resolveTypeNode(builder, parameter_node.lhs)
            if resolved != 0 { parameter_type = resolved }
        }
        types_store.Store.appendExtra(builder.*.typeStore, parameter_type)
        parameter = parameter_node.next
        parameter_index += 1
    }
    const generic_function = types_store.Store.get(builder.*.typeStore, symbol.*.typeId)
    var return_type = generic_function.*.lhs
    var annotated_return = genericAnnotatedReturnType(builder, declaration, arguments_start, argument_count)
    if annotated_return == 0 && declaration.extra != ast.NONE && types_store.Store.get(builder.*.typeStore, return_type).*.kind == types_store.Kind.anytype_type {
        annotated_return = resolveTypeNode(builder, declaration.extra)
    }
    if annotated_return != 0 { return_type = annotated_return }
    if types_store.Store.get(builder.*.typeStore, return_type).*.kind == types_store.Kind.anytype_type {
        const inferred_return = genericBodyReturnType(builder, declaration, arguments_start, argument_count)
        if inferred_return != 0 { return_type = inferred_return }
    }
    builder.*.bindings.*.length = bindings_length
    builder.*.scopeOverride = saved_scope
    builder.*.currentMethodOwner = saved_owner
    const restored_salt = types_store.Store.setInstanceSalt(builder.*.typeStore, saved_salt)
    const function_type = types_store.Store.function(builder.*.typeStore, return_type, parameter_start, argument_count)
    const instance_id = builder.*.genericInstances.*.length
    const symbol_id = lir.addGenericModuleSymbol(builder.*.lir, target_module, symbol.*.namePointer, symbol.*.nameLength, instance_id)
    var instance = GenericInstance.{
        .moduleId = target_module,
        .declaration = symbol.*.declaration,
        .symbolId = symbol_id,
        .argumentsStart = arguments_start,
        .argumentCount = argument_count,
        .functionTypeId = function_type,
        .scopeAddress = instance_scope,
        .ownerTypeId = owner_type,
        .salt = instance_salt,
    }
    appendGenericInstance(builder, &instance)
    switchToModule(builder, caller_module)
    return instance_id
}

// The methods of the aggregates the generic type instances declared
// (types.InstanceAggregate), those not generated yet: each in its
// instance's module and scope, with the aggregate as `Self`. Whether any
// was generated.
fn lowerInstanceMethods(builder: *LirBuilder) -> bool {
    var generated = false
    var index: usize = 0
    while index < types_store.Store.instanceAggregateCount(builder.*.typeStore) {
        const record = types_store.Store.instanceAggregateAt(builder.*.typeStore, index)
        index += 1
        if record.*.lowered { continue }
        record.*.lowered = true
        generated = true
        const instance = types_store.Store.instanceAt(builder.*.typeStore, record.*.instance)
        const saved_module = builder.*.currentModuleId
        const saved_scope = builder.*.scopeOverride
        const saved_owner = builder.*.currentMethodOwner
        const saved_generic = builder.*.currentGenericInstance
        const saved_salt = types_store.Store.setInstanceSalt(builder.*.typeStore, record.*.instance + 1)
        const saved_owner_name = builder.*.ownerNamePointer
        const saved_owner_name_length = builder.*.ownerNameLength
        switchToModule(builder, instance.*.moduleId)
        builder.*.scopeOverride = instance.*.scopeAddress
        builder.*.currentMethodOwner = record.*.typeId
        builder.*.currentGenericInstance = lir.NONE
        setOwnerName(builder, record.*.typeId)
        lowerAggregateMembers(builder, record.*.node, record.*.typeId)
        builder.*.ownerNamePointer = saved_owner_name
        builder.*.ownerNameLength = saved_owner_name_length
        builder.*.scopeOverride = saved_scope
        builder.*.currentMethodOwner = saved_owner
        builder.*.currentGenericInstance = saved_generic
        const restored = types_store.Store.setInstanceSalt(builder.*.typeStore, saved_salt)
        switchToModule(builder, saved_module)
    }
    return generated
}

// The name the methods of `type_id` carry in the executable's symbol
// table (`Box(u32).get`): written once, kept for the compilation.
fn setOwnerName(builder: *LirBuilder, type_id: usize) -> void {
    const limit: usize = 120
    const memory = builder.*.allocator.alloc(limit, 1)
    if memory == null {
        builder.*.ownerNameLength = 0
        return
    }
    const text = memory.?
    var length: usize = 0
    type_names.write(builder.*.typeStore, builder.*.symbolStore, type_id, text, &length, limit)
    builder.*.ownerNamePointer = text
    builder.*.ownerNameLength = length
}

pub fn generateGenericInstances(builder: *LirBuilder) -> void {
    const saved_module = builder.*.currentModuleId
    var progress = true
    while progress {
        progress = lowerInstanceMethods(builder)
        while builder.*.generatedGenericInstances < builder.*.genericInstances.*.length {
            const instance_index = builder.*.generatedGenericInstances
            builder.*.generatedGenericInstances += 1
            progress = true
            const instance = genericInstanceAt(builder, instance_index)
            switchToModule(builder, instance.*.moduleId)
            builder.*.currentGenericInstance = instance_index
            const saved_scope = builder.*.scopeOverride
            const saved_owner = builder.*.currentMethodOwner
            const saved_salt = types_store.Store.setInstanceSalt(builder.*.typeStore, instance.*.salt)
            if instance.*.scopeAddress != 0 { builder.*.scopeOverride = instance.*.scopeAddress }
            if instance.*.ownerTypeId != 0 { builder.*.currentMethodOwner = instance.*.ownerTypeId }
            lowerFunction(builder, instance.*.declaration)
            builder.*.scopeOverride = saved_scope
            builder.*.currentMethodOwner = saved_owner
            const restored = types_store.Store.setInstanceSalt(builder.*.typeStore, saved_salt)
        }
    }
    builder.*.currentGenericInstance = lir.NONE
    switchToModule(builder, saved_module)
}

pub fn genericInstanceCount(builder: *LirBuilder) -> usize { return builder.*.genericInstances.*.length }

pub fn expressionTypeQueryCount(builder: *LirBuilder) -> usize { return builder.*.expressionTypeQueries }

pub fn expressionTypeCacheHitCount(builder: *LirBuilder) -> usize { return builder.*.expressionTypeHits }

pub fn resolvedTypeQueryCount(builder: *LirBuilder) -> usize { return builder.*.resolvedTypeQueries }

pub fn resolvedTypeCacheHitCount(builder: *LirBuilder) -> usize { return builder.*.resolvedTypeHits }

pub fn unsupportedInstructionCount(builder: *LirBuilder) -> usize { return builder.*.unsupportedLoweringCount }

pub fn firstUnsupportedInstructionOffset(builder: *LirBuilder) -> usize { return builder.*.firstUnsupportedOffset }

pub fn firstUnsupportedInstructionLength(builder: *LirBuilder) -> usize { return builder.*.firstUnsupportedLength }

// The module the first unsupported construct is in (the offset is into
// its source).
pub fn firstUnsupportedModuleId(builder: *LirBuilder) -> usize { return builder.*.firstUnsupportedModule }

pub fn inlinedCallCount(builder: *LirBuilder) -> usize { return builder.*.inlinedCallCount }
pub fn membershipTestCount(builder: *LirBuilder) -> usize { return builder.*.membershipTestCount }

pub fn automaticallyInlinedCallCount(builder: *LirBuilder) -> usize { return builder.*.automaticallyInlinedCallCount }

pub fn inlineMissCount(builder: *LirBuilder) -> usize { return builder.*.inlineMissCount }

pub fn optimizationLevel(builder: *LirBuilder) -> usize { return @intCast(usize, builder.*.optimizationLevel) }

fn lowerDeclaration(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const n = ast_store.Store.get(nodes, node_index)
    if n.tag == ast.Tag.function_declaration {
        return lowerFunction(builder, node_index)
    }
    if n.tag == ast.Tag.variable_declaration && n.extra & 32 != 0 {
        recordUnsupportedBuiltin(builder, n.mainToken)
        return lir.NONE
    }
    // Skip constant/variable declarations at module level for now
    // (they are type definitions, imports, etc.)
    return lir.NONE
}

fn pushBinding(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize, address: usize, secondary_address: usize, tertiary_address: usize, type_id: usize) -> void {
    const components_start = builder.*.bindingComponents.*.length
    var component_count: usize = 0
    if address != lir.NONE {
        unsafe { const appended = vector.Vector.appendAt(builder.*.bindingComponents, @ptrCast([*]const u8, &address)) }
        component_count += 1
    }
    if secondary_address != lir.NONE {
        unsafe { const appended = vector.Vector.appendAt(builder.*.bindingComponents, @ptrCast([*]const u8, &secondary_address)) }
        component_count += 1
    }
    if tertiary_address != lir.NONE {
        unsafe { const appended = vector.Vector.appendAt(builder.*.bindingComponents, @ptrCast([*]const u8, &tertiary_address)) }
        component_count += 1
    }
    var b = Binding.{
        .namePointer = name_ptr,
        .nameLength = name_len,
        .address = address,
        .secondaryAddress = secondary_address,
        .tertiaryAddress = tertiary_address,
        .typeId = type_id,
        .valueTypeId = 0,
        .comptimeTag = 0,
        .comptimeInteger = 0,
        .componentsStart = components_start,
        .componentCount = component_count,
        .directValue = false,
        .dropFlagAddress = lir.NONE,
        .frameStorage = false,
    }
    unsafe {
        const appended = vector.Vector.appendAt(bindingsPointer(builder), @ptrCast([*]const u8, &b))
    }
}

fn pushBindingComponents(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize, components_start: usize, component_count: usize, type_id: usize) -> void {
    const address = if component_count > 0 { bindingComponentAt(builder, components_start) } else { lir.NONE }
    const secondary_address = if component_count > 1 { bindingComponentAt(builder, components_start + 1) } else { lir.NONE }
    const tertiary_address = if component_count > 2 { bindingComponentAt(builder, components_start + 2) } else { lir.NONE }
    var binding = Binding.{
        .namePointer = name_ptr,
        .nameLength = name_len,
        .address = address,
        .secondaryAddress = secondary_address,
        .tertiaryAddress = tertiary_address,
        .typeId = type_id,
        .valueTypeId = 0,
        .comptimeTag = 0,
        .comptimeInteger = 0,
        .componentsStart = components_start,
        .componentCount = component_count,
        .directValue = false,
        .dropFlagAddress = lir.NONE,
        .frameStorage = false,
    }
    unsafe { const appended = vector.Vector.appendAt(bindingsPointer(builder), @ptrCast([*]const u8, &binding)) }
}

fn bindingComponentAt(builder: *LirBuilder, index: usize) -> usize {
    unsafe { return @ptrCast(*usize, vector.Vector.at(builder.*.bindingComponents.*, index)).* }
}

// Whether the current module takes the address of a binding called
// `name` anywhere (`&name`). The module's tokens are scanned once for the
// identifiers after an `&`; a name shared with another function's local
// only costs that local its registers.
fn addressTakenInModule(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize) -> bool {
    const module_id = builder.*.currentModuleId
    var scanned = false
    var index: usize = 0
    while index < builder.*.addressTakenModules.*.length {
        unsafe { if @ptrCast(*usize, vector.Vector.at(builder.*.addressTakenModules.*, index)).* == module_id { scanned = true } }
        index += 1
    }
    if !scanned {
        const token_count = getTokens(builder).*.length
        var token: usize = 0
        while token + 1 < token_count {
            if tokenKind(builder, token) == lexer.Kind.ampersand && tokenKind(builder, token + 1) == lexer.Kind.identifier {
                var entry = AddressTakenName.{ .module = module_id, .token = token + 1 }
                unsafe { const appended = vector.Vector.appendAt(builder.*.addressTakenNames, @ptrCast([*]const u8, &entry)) }
            }
            token += 1
        }
        var module_entry = module_id
        unsafe { const appended = vector.Vector.appendAt(builder.*.addressTakenModules, @ptrCast([*]const u8, &module_entry)) }
    }
    index = 0
    while index < builder.*.addressTakenNames.*.length {
        var entry: AddressTakenName = undefined
        unsafe { entry = @ptrCast(*AddressTakenName, vector.Vector.at(builder.*.addressTakenNames.*, index)).* }
        if entry.module == module_id && tokenLength(builder, entry.token) == name_len && mem.eql(tokenPointer(builder, entry.token), name_ptr, name_len) { return true }
        index += 1
    }
    return false
}

// The frame storage of a binding of `component_count` words, appended to
// bindingComponents: one alloca per word, which the optimizer forwards
// and promotes to registers; or, when the module takes the binding's
// address somewhere, one block of adjacent words, so that a store through
// that address (`into.* = slice` in a callee) reaches every word the
// binding reads: a slice's length, an optional's payload.
fn appendComponentStorage(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize, component_count: usize) -> void {
    if component_count > 1 && addressTakenInModule(builder, name_ptr, name_len) {
        var block_inst = lir.initInst(lir.Opcode.alloca, lir.NONE)
        block_inst.arg0 = component_count * 8
        block_inst.arg1 = 1
        const block = lir.addInst(builder.*.lir, block_inst)
        unsafe { const appended = vector.Vector.appendAt(builder.*.bindingComponents, @ptrCast([*]const u8, &block)) }
        var component: usize = 1
        while component < component_count {
            const offset = lir.addInst(builder.*.lir, lir.constI(lir.NONE, component * 8))
            var component_gep = lir.initInst(lir.Opcode.gep, lir.NONE)
            component_gep.arg0 = block
            component_gep.arg1 = offset
            component_gep.arg2 = 1
            const component_address = lir.addInst(builder.*.lir, component_gep)
            unsafe { const appended = vector.Vector.appendAt(builder.*.bindingComponents, @ptrCast([*]const u8, &component_address)) }
            component += 1
        }
        return
    }
    var component: usize = 0
    while component < component_count {
        const component_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
        unsafe { const appended = vector.Vector.appendAt(builder.*.bindingComponents, @ptrCast([*]const u8, &component_address)) }
        component += 1
    }
}

fn pushComptimeBinding(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize, type_id: usize, value_type_id: usize, tag: u8, integer: isize) -> void {
    pushBinding(builder, name_ptr, name_len, lir.NONE, lir.NONE, lir.NONE, type_id)
    unsafe {
        const binding = @ptrCast(*Binding, vector.Vector.at(builder.*.bindings.*, builder.*.bindings.*.length - 1))
        binding.*.valueTypeId = value_type_id
        binding.*.comptimeTag = tag
        binding.*.comptimeInteger = integer
    }
}

fn pushLoopTarget(builder: *LirBuilder, label_token: usize, break_block: usize, continue_block: usize, result_address: usize) -> void {
    var label_pointer = builder.*.sourcePointer
    var label_length: usize = 0
    if label_token != ast.NONE {
        label_pointer = tokenPointer(builder, label_token)
        label_length = tokenLength(builder, label_token)
    }
    var target = LoopTarget.{
        .labelPointer = label_pointer,
        .labelLength = label_length,
        .breakBlock = break_block,
        .continueBlock = continue_block,
        .resultAddress = result_address,
        .deferDepth = builder.*.deferredNodes.*.length,
    }
    unsafe {
        const appended = vector.Vector.appendAt(builder.*.loopTargets, @ptrCast([*]const u8, &target))
    }
}

fn popLoopTarget(builder: *LirBuilder) -> void {
    if builder.*.loopTargets.*.length > 0 { builder.*.loopTargets.*.length -= 1 }
}

fn findLoopTarget(builder: *LirBuilder, label_token: usize) -> *LoopTarget {
    var index = builder.*.loopTargets.*.length
    while index > 0 {
        index -= 1
        unsafe {
            const target = @ptrCast(*LoopTarget, vector.Vector.at(builder.*.loopTargets.*, index))
            if label_token == ast.NONE { return target }
            const label_pointer = tokenPointer(builder, label_token)
            const label_length = tokenLength(builder, label_token)
            if target.*.labelLength == label_length && mem.eql(target.*.labelPointer, label_pointer, label_length) { return target }
        }
    }
    unsafe { return @ptrFromInt(*LoopTarget, 0) }
}

fn appendDeferred(builder: *LirBuilder, node_index: usize) -> void {
    var cleanup = Cleanup.{
        .kind = CleanupKind.explicit,
        .nodeIndex = node_index,
        .address = lir.NONE,
        .initialized = lir.NONE,
        .typeId = 0,
        .declaration = ast.NONE,
    }
    unsafe {
        const appended = vector.Vector.appendAt(builder.*.deferredNodes, @ptrCast([*]const u8, &cleanup))
    }
}

fn appendAutoDrop(builder: *LirBuilder, declaration: usize, address: usize, type_id: usize) -> void {
    if type_id == 0 || address == lir.NONE { return }
    if types_store.Store.get(builder.*.typeStore, type_id).*.copyability == types_store.Copyability.copyable { return }
    unsafe {
        if aggregateMethodIndex(builder, type_id, @ptrCast([*]const u8, "deinit"), 6) == lir.NONE { return }
    }
    const initialized = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    const one = lir.addInst(builder.*.lir, lir.constI(types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type), 1))
    var initialize = lir.initInst(lir.Opcode.store, lir.NONE)
    initialize.arg0 = initialized
    initialize.arg1 = one
    lir.addInst(builder.*.lir, initialize)
    if builder.*.bindings.*.length > 0 {
        unsafe { @ptrCast(*Binding, vector.Vector.at(builder.*.bindings.*, builder.*.bindings.*.length - 1)).*.dropFlagAddress = initialized }
    }
    var cleanup = Cleanup.{
        .kind = CleanupKind.auto_drop,
        .nodeIndex = ast.NONE,
        .address = address,
        .initialized = initialized,
        .typeId = type_id,
        .declaration = declaration,
    }
    unsafe {
        const appended = vector.Vector.appendAt(builder.*.deferredNodes, @ptrCast([*]const u8, &cleanup))
    }
}

fn emitAutoDrop(builder: *LirBuilder, cleanup: *Cleanup) -> void {
    var method_index = lir.NONE
    unsafe { method_index = aggregateMethodIndex(builder, cleanup.*.typeId, @ptrCast([*]const u8, "deinit"), 6) }
    if method_index == lir.NONE { return }
    const method = symbols_store.Store.get(builder.*.symbolStore, method_index)
    var flag_load = lir.initInst(lir.Opcode.load, types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type))
    flag_load.arg0 = cleanup.*.initialized
    const condition = lir.addInst(builder.*.lir, flag_load)
    const drop_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const end_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    lir.addInst(builder.*.lir, lir.condBranch(condition, drop_block, end_block))
    lir.addInst(builder.*.lir, lir.blockLabelInst(drop_block))
    var value_load = lir.initInst(lir.Opcode.load, cleanup.*.typeId)
    value_load.arg0 = cleanup.*.address
    const value = lir.addInst(builder.*.lir, value_load)
    const arguments_start = builder.*.lir.*.extraData.*.length
    lir.addExtra(builder.*.lir, value)
    var symbol_id = if method_index < builder.*.lirSymbolCapacity { builder.*.lirSymbolIds[method_index] } else { lir.NONE }
    if symbol_id == lir.NONE {
        symbol_id = lir.addMethodSymbol(builder.*.lir, method.*.moduleId, cleanup.*.typeId, method.*.namePointer, method.*.nameLength)
        if method_index < builder.*.lirSymbolCapacity { builder.*.lirSymbolIds[method_index] = symbol_id }
    }
    const void_type = types_store.Store.primitive(builder.*.typeStore, types_store.Kind.void_type)
    lir.addInst(builder.*.lir, lir.directCallInst(void_type, symbol_id, arguments_start, 1))
    lir.addInst(builder.*.lir, lir.branch(end_block))
    lir.addInst(builder.*.lir, lir.blockLabelInst(end_block))
}

fn setBindingDropFlag(builder: *LirBuilder, node_index: usize, value: usize) -> void {
    if node_index == ast.NONE { return }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag != ast.Tag.identifier { return }
    const binding = findBindingRecord(builder, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
    if @intFromPtr(binding) == 0 || binding.*.dropFlagAddress == lir.NONE { return }
    const flag = lir.addInst(builder.*.lir, lir.constI(types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type), value))
    var store = lir.initInst(lir.Opcode.store, lir.NONE)
    store.arg0 = binding.*.dropFlagAddress
    store.arg1 = flag
    lir.addInst(builder.*.lir, store)
}

fn emitDefersTo(builder: *LirBuilder, depth: usize) -> void {
    var index = builder.*.deferredNodes.*.length
    while index > depth {
        index -= 1
        unsafe {
            const cleanup = @ptrCast(*Cleanup, vector.Vector.at(builder.*.deferredNodes.*, index))
            if cleanup.*.kind == CleanupKind.explicit { lowerNode(builder, cleanup.*.nodeIndex) }
            if cleanup.*.kind == CleanupKind.auto_drop { emitAutoDrop(builder, cleanup) }
        }
    }
}

fn currentScope(builder: *LirBuilder) -> *scope_module.Scope {
    if builder.*.scopeOverride != 0 {
        unsafe { return @ptrFromInt(*scope_module.Scope, builder.*.scopeOverride) }
    }
    const module = loader_module.Loader.moduleAt(builder.*.loader, builder.*.currentModuleId)
    unsafe { return @ptrFromInt(*scope_module.Scope, module.*.scopeAddress) }
}

fn hasScope(builder: *LirBuilder) -> bool {
    if builder.*.scopeOverride != 0 { return true }
    return loader_module.Loader.moduleAt(builder.*.loader, builder.*.currentModuleId).*.scopeAddress != 0
}

fn resolveCurrentMethodType(builder: *LirBuilder, node_index: usize) -> usize {
    if node_index == ast.NONE || builder.*.currentMethodOwner == lir.NONE { return 0 }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.named_type || node.tag == ast.Tag.identifier {
        const pointer = tokenPointer(builder, node.mainToken)
        const length = tokenLength(builder, node.mainToken)
        unsafe {
            if length == 4 && mem.eql(pointer, @ptrCast([*]const u8, "Self"), 4) { return builder.*.currentMethodOwner }
        }
        return 0
    }
    if node.tag == ast.Tag.pointer_type || node.tag == ast.Tag.many_pointer_type {
        const child = resolveCurrentMethodType(builder, node.lhs)
        if child == 0 { return 0 }
        return types_store.Store.pointer(builder.*.typeStore, child, node.extra & 1 != 0, node.extra & 2 != 0, node.tag == ast.Tag.many_pointer_type)
    }
    if node.tag == ast.Tag.slice_type {
        const child = resolveCurrentMethodType(builder, node.lhs)
        if child == 0 { return 0 }
        return types_store.Store.slice(builder.*.typeStore, child, node.extra & 1 != 0)
    }
    if node.tag == ast.Tag.optional_type {
        const child = resolveCurrentMethodType(builder, node.lhs)
        if child == 0 { return 0 }
        return types_store.Store.optional(builder.*.typeStore, child)
    }
    return 0
}

fn resolveTypeNode(builder: *LirBuilder, node_index: usize) -> usize {
    if node_index == ast.NONE { return 0 }
    builder.*.resolvedTypeQueries += 1
    return resolveTypeNodeUncached(builder, node_index)
}

fn resolveTypeNodeUncached(builder: *LirBuilder, node_index: usize) -> usize {
    if node_index == ast.NONE { return 0 }
    const method_type = resolveCurrentMethodType(builder, node_index)
    if method_type != 0 { return method_type }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.identifier || node.tag == ast.Tag.named_type {
        const binding = findBindingRecord(builder, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
        if @intFromPtr(binding) != 0 && binding.*.valueTypeId != 0 { return binding.*.valueTypeId }
    }
    if node.tag == ast.Tag.builtin_call {
        const kind = builtins.lookup(builder.*.sourcePointer[0..builder.*.sourceLength], getTokens(builder).*, node.mainToken)
        if kind == builtins.Kind.typeOf && node.lhs != ast.NONE { return expressionType(builder, node.lhs) }
        if kind == builtins.Kind.childType && node.lhs != ast.NONE {
            const container = resolveTypeNode(builder, node.lhs)
            if container == 0 { return 0 }
            const value = types_store.Store.get(builder.*.typeStore, container)
            if value.*.kind == types_store.Kind.error_union { return value.*.rhs }
            if value.*.kind == types_store.Kind.pointer || value.*.kind == types_store.Kind.many_pointer || value.*.kind == types_store.Kind.slice || value.*.kind == types_store.Kind.array || value.*.kind == types_store.Kind.optional || value.*.kind == types_store.Kind.vector { return value.*.lhs }
            return 0
        }
    }
    // A type written over names bound here (`[*]T`, `?*T`, `[]const T`,
    // `[N]T` with T a comptime type parameter): built from its parts,
    // each resolved the same way.
    if node.tag == ast.Tag.pointer_type || node.tag == ast.Tag.many_pointer_type {
        const child = resolveTypeNode(builder, node.lhs)
        if child == 0 { return 0 }
        return types_store.Store.pointer(builder.*.typeStore, child, node.extra & 1 != 0, node.extra & 2 != 0, node.tag == ast.Tag.many_pointer_type)
    }
    if node.tag == ast.Tag.slice_type {
        const child = resolveTypeNode(builder, node.lhs)
        if child == 0 { return 0 }
        return types_store.Store.slice(builder.*.typeStore, child, node.extra & 1 != 0)
    }
    if node.tag == ast.Tag.optional_type {
        const child = resolveTypeNode(builder, node.lhs)
        if child == 0 { return 0 }
        return types_store.Store.optional(builder.*.typeStore, child)
    }
    if node.tag == ast.Tag.nocopy_type && node.lhs != ast.NONE && ast_store.Store.get(getNodes(builder), node.lhs).tag != ast.Tag.struct_type && ast_store.Store.get(getNodes(builder), node.lhs).tag != ast.Tag.enum_type && ast_store.Store.get(getNodes(builder), node.lhs).tag != ast.Tag.union_type {
        const child = resolveTypeNode(builder, node.lhs)
        if child == 0 { return 0 }
        return types_store.Store.noCopy(builder.*.typeStore, child)
    }
    if node.tag == ast.Tag.array_type && node.lhs != ast.NONE {
        const child = resolveTypeNode(builder, node.rhs)
        if child == 0 { return 0 }
        const length = lowerComptimeValue(builder, node.lhs)
        if length.kind != comptime_value.Kind.integer || length.integer < 0 { return 0 }
        return types_store.Store.array(builder.*.typeStore, child, @intCast(usize, length.integer))
    }
    if node.tag == ast.Tag.error_union_type && node.lhs != ast.NONE {
        const payload = resolveTypeNode(builder, node.rhs)
        const errors = resolveTypeNode(builder, node.lhs)
        if payload == 0 || errors == 0 { return 0 }
        return types_store.Store.errorUnion(builder.*.typeStore, errors, payload)
    }
    if node.tag == ast.Tag.call_expression { return instantiateTypeCall(builder, node_index) }
    unsafe {
        return declarations.resolveType(
            builder.*.sourcePointer[0..builder.*.sourceLength],
            "",
            getTokens(builder).*,
            getNodes(builder),
            builder.*.typeStore,
            builder.*.symbolStore,
            currentScope(builder),
            node_index,
        )
    }
}

// `Box(u32)` where the lowering resolves a type (a generic function's
// body, whose comptime parameters are bindings here, not symbols): the
// arguments evaluated here, the instance made by sema's rules
// (declarations.instantiateType), found again when it exists.
fn instantiateTypeCall(builder: *LirBuilder, node_index: usize) -> usize {
    const node = ast_store.Store.get(getNodes(builder), node_index)
    const referenced = referencedSymbolIndex(builder, node.lhs)
    if !referenced.0 { return 0 }
    const symbol = symbols_store.Store.get(builder.*.symbolStore, referenced.1)
    if !declarations.isTypeFunction(builder.*.typeStore, symbol) { return 0 }
    var arguments: [8]types_store.InstanceArgument = undefined
    var count: usize = 0
    var argument = node.rhs
    while argument != ast.NONE && count < node.extra {
        if count >= 8 { return 0 }
        const type_value = resolveTypeNode(builder, argument)
        if type_value != 0 {
            arguments[count] = types_store.InstanceArgument.{ .kind = @intCast(u8, @intFromEnum(comptime_value.Kind.type_value)), .typeId = type_value, .integer = 0 }
        } else {
            const known = lowerComptimeValue(builder, argument)
            if known.kind == comptime_value.Kind.integer || known.kind == comptime_value.Kind.boolean {
                arguments[count] = types_store.InstanceArgument.{ .kind = @intCast(u8, @intFromEnum(known.kind)), .typeId = 0, .integer = known.integer }
            } else if known.kind == comptime_value.Kind.type_value && known.typeId != 0 {
                arguments[count] = types_store.InstanceArgument.{ .kind = @intCast(u8, @intFromEnum(comptime_value.Kind.type_value)), .typeId = known.typeId, .integer = 0 }
            } else {
                return 0
            }
        }
        argument = ast_store.Store.get(getNodes(builder), argument).next
        count += 1
    }
    if count != node.extra { return 0 }
    unsafe {
        return declarations.instantiateType(
            builder.*.sourcePointer[0..builder.*.sourceLength],
            "",
            getTokens(builder).*,
            getNodes(builder),
            builder.*.typeStore,
            builder.*.symbolStore,
            currentScope(builder),
            referenced.1,
            &arguments,
            count,
            node,
        )
    }
}

fn findSecondaryBinding(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize) -> usize {
    var i = builder.*.bindings.*.length
    while i > 0 {
        i -= 1
        unsafe {
            const ptr = @ptrCast(*Binding, vector.Vector.at(builder.*.bindings.*, i))
            if ptr.*.nameLength == name_len && mem.eql(ptr.*.namePointer, name_ptr, name_len) {
                return ptr.*.secondaryAddress
            }
        }
    }
    return lir.NONE
}

fn findTertiaryBinding(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize) -> usize {
    var i = builder.*.bindings.*.length
    while i > 0 {
        i = i - 1
        unsafe {
            const ptr = @ptrCast(*Binding, vector.Vector.at(builder.*.bindings.*, i))
            if ptr.*.nameLength == name_len && mem.eql(ptr.*.namePointer, name_ptr, name_len) { return ptr.*.tertiaryAddress }
        }
    }
    return lir.NONE
}

fn findBinding(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize) -> usize {
    var i = builder.*.bindings.*.length
    while i > 0 {
        i = i - 1
        unsafe {
            const ptr = @ptrCast(*Binding, vector.Vector.at(builder.*.bindings.*, i))
            if ptr.*.nameLength == name_len {
                if mem.eql(ptr.*.namePointer, name_ptr, name_len) {
                    return ptr.*.address
                }
            }
        }
    }
    // No local: a module-level var's storage.
    const global = globalSymbolNamed(builder, name_ptr, name_len)
    if global.0 { return globalAddress(builder, global.1) }
    return lir.NONE
}

fn findBindingRecord(builder: *LirBuilder, name_ptr: [*]const u8, name_len: usize) -> *Binding {
    var index = builder.*.bindings.*.length
    while index > 0 {
        index -= 1
        unsafe {
            const binding = @ptrCast(*Binding, vector.Vector.at(builder.*.bindings.*, index))
            if binding.*.nameLength == name_len && mem.eql(binding.*.namePointer, name_ptr, name_len) { return binding }
        }
    }
    unsafe { return @ptrFromInt(*Binding, 0) }
}

// Exported functions and foreign (non-syscall extern) functions keep their
// source name as the machine-level symbol, like `main`; everything else is
// mangled with its module (and owner type).
fn hasPlainSymbolName(symbol: *symbol_module.Symbol) -> bool {
    if symbol.*.ownerTypeId != 0 { return false }
    if symbol.*.flags & symbol_module.FLAG_EXPORT != 0 { return true }
    return isForeignFunction(symbol)
}

fn isForeignFunction(symbol: *symbol_module.Symbol) -> bool {
    return symbol.*.flags & symbol_module.FLAG_EXTERN != 0 && symbol.*.flags & symbol_module.FLAG_SYSCALL == 0
}

fn recordLinkage(builder: *LirBuilder, lir_symbol: usize, symbol: *symbol_module.Symbol) -> void {
    if symbol.*.ownerTypeId != 0 { return }
    if isForeignFunction(symbol) { lir.addSymbolFlags(builder.*.lir, lir_symbol, lir.SYMBOL_IMPORT) }
    if symbol.*.flags & symbol_module.FLAG_EXPORT != 0 { lir.addSymbolFlags(builder.*.lir, lir_symbol, lir.SYMBOL_EXPORT) }
}

fn isMainName(pointer: [*]const u8, length: usize) -> bool {
    if length != 4 { return false }
    unsafe { return mem.eql(pointer, @ptrCast([*]const u8, "main"), 4) }
}

fn typeWordCount(builder: *LirBuilder, type_id: usize) -> usize {
    if type_id == 0 { return 1 }
    const value = types_store.Store.get(builder.*.typeStore, type_id)
    if value.*.kind == types_store.Kind.slice { return 2 }
    // An integer wider than a word: its words, the low one first.
    if value.*.kind == types_store.Kind.integer && value.*.bits > 64 { return wide.wordCount(value.*.bits) }
    // An error union is its tag and then the payload's words.
    if value.*.kind == types_store.Kind.error_union { return 1 + typeWordCount(builder, value.*.rhs) }
    // An optional slice is the slice (null: pointer 0, length 0).
    if isOptionalSlice(builder, type_id) { return 2 }
    // A tagged optional is its payload's words and the tag's (one word,
    // the address, when the payload is a memory value).
    if isTaggedOptional(builder, type_id) {
        if aggregate_copy.isMemoryType(builder.*.typeStore, type_id) { return 1 }
        return typeWordCount(builder, value.*.lhs) + 1
    }
    if value.*.kind == types_store.Kind.tuple {
        var words: usize = 0
        var index: usize = 0
        while index < value.*.extraLength {
            words += typeWordCount(builder, types_store.Store.extraAt(builder.*.typeStore, value.*.extraStart + index))
            index += 1
        }
        return words
    }
    return 1
}

fn tupleFieldWordOffset(builder: *LirBuilder, tuple_type: *types_store.Type, field_index: usize) -> usize {
    var offset: usize = 0
    var index: usize = 0
    while index < field_index && index < tuple_type.*.extraLength {
        offset += typeWordCount(builder, types_store.Store.extraAt(builder.*.typeStore, tuple_type.*.extraStart + index))
        index += 1
    }
    return offset
}

fn symbolForDeclaration(builder: *LirBuilder, declaration: usize) -> (bool, usize) {
    var symbol_index: usize = 0
    const declaration_node = ast_store.Store.get(getNodes(builder), declaration)
    const name_pointer = tokenPointer(builder, declaration_node.mainToken)
    const name_length = tokenLength(builder, declaration_node.mainToken)
    while symbol_index < builder.*.symbolStore.*.length {
        const symbol = symbols_store.Store.get(builder.*.symbolStore, symbol_index)
        if symbol.*.declaration == declaration && symbol.*.nameLength == name_length && @intFromPtr(symbol.*.namePointer) == @intFromPtr(name_pointer) { return -> (true, symbol_index) }
        symbol_index += 1
    }
    return -> (false, 0)
}

fn functionSymbolIndex(builder: *LirBuilder, node_index: usize, name_ptr: [*]const u8, name_len: usize) -> usize {
    const scoped_function = scope_module.Scope.lookup(currentScope(builder), name_ptr, name_len)
    var symbol_index = if scoped_function.0 { scoped_function.1 } else { lir.NONE }
    if builder.*.currentMethodOwner != lir.NONE {
        symbol_index = aggregateMethodIndex(builder, builder.*.currentMethodOwner, name_ptr, name_len)
    }
    if symbol_index == lir.NONE {
        const declaration_symbol = symbolForDeclaration(builder, node_index)
        if declaration_symbol.0 { symbol_index = declaration_symbol.1 }
    }
    return symbol_index
}

fn concreteFunctionType(builder: *LirBuilder, symbol_index: usize) -> usize {
    if builder.*.currentGenericInstance != lir.NONE {
        return genericInstanceAt(builder, builder.*.currentGenericInstance).*.functionTypeId
    }
    if symbol_index == lir.NONE { return 0 }
    const type_id = symbols_store.Store.get(builder.*.symbolStore, symbol_index).*.typeId
    if types_store.Store.get(builder.*.typeStore, type_id).*.kind == types_store.Kind.function { return type_id }
    return 0
}

fn functionReturnType(builder: *LirBuilder, function_type: usize) -> usize {
    if function_type == 0 { return types_store.Store.primitive(builder.*.typeStore, types_store.Kind.void_type) }
    return types_store.Store.get(builder.*.typeStore, function_type).*.lhs
}

fn addFunctionSymbol(builder: *LirBuilder, symbol_index: usize, name_ptr: [*]const u8, name_len: usize) -> usize {
    if builder.*.currentGenericInstance != lir.NONE {
        return genericInstanceAt(builder, builder.*.currentGenericInstance).*.symbolId
    }
    if symbol_index != lir.NONE && symbol_index < builder.*.lirSymbolCapacity {
        const cached = builder.*.lirSymbolIds[symbol_index]
        if cached != lir.NONE {
            // (Made by a call before the body: the owner's name comes now.)
            if builder.*.currentMethodOwner != lir.NONE && builder.*.ownerNameLength != 0 { lir.setSymbolOwner(builder.*.lir, cached, builder.*.ownerNamePointer, builder.*.ownerNameLength) }
            return cached
        }
    }
    var is_entry = builder.*.currentModuleId == 0 && isMainName(name_ptr, name_len)
    var owner_type: usize = 0
    if symbol_index != lir.NONE {
        const semantic_symbol = symbols_store.Store.get(builder.*.symbolStore, symbol_index)
        owner_type = semantic_symbol.*.ownerTypeId
        if hasPlainSymbolName(semantic_symbol) { is_entry = true }
    }
    if builder.*.currentMethodOwner != lir.NONE { owner_type = builder.*.currentMethodOwner }
    const lir_symbol = if owner_type == 0 {
        lir.addModuleSymbol(builder.*.lir, builder.*.currentModuleId, name_ptr, name_len, is_entry)
    } else {
        lir.addMethodSymbol(builder.*.lir, builder.*.currentModuleId, owner_type, name_ptr, name_len)
    }
    if owner_type != 0 && builder.*.ownerNameLength != 0 { lir.setSymbolOwner(builder.*.lir, lir_symbol, builder.*.ownerNamePointer, builder.*.ownerNameLength) }
    if symbol_index != lir.NONE { recordLinkage(builder, lir_symbol, symbols_store.Store.get(builder.*.symbolStore, symbol_index)) }
    if symbol_index != lir.NONE && symbol_index < builder.*.lirSymbolCapacity { builder.*.lirSymbolIds[symbol_index] = lir_symbol }
    return lir_symbol
}

fn parameterType(builder: *LirBuilder, parameter: ast.Node, parameter_index: usize, function_type: usize) -> usize {
    if function_type != 0 {
        const concrete_function = types_store.Store.get(builder.*.typeStore, function_type)
        if parameter_index < concrete_function.*.extraLength {
            return types_store.Store.extraAt(builder.*.typeStore, concrete_function.*.extraStart + parameter_index)
        }
    }
    return resolveTypeNode(builder, parameter.lhs)
}

fn genericArgumentForParameter(builder: *LirBuilder, parameter_index: usize, type_id: usize) -> GenericArgument {
    if builder.*.currentGenericInstance != lir.NONE {
        const instance = genericInstanceAt(builder, builder.*.currentGenericInstance)
        if parameter_index < instance.*.argumentCount {
            return genericArgumentAt(builder, instance.*.argumentsStart + parameter_index).*
        }
    }
    return GenericArgument.{ .typeId = type_id, .valueTypeId = 0, .comptimeTag = 0, .comptimeInteger = 0 }
}

fn emitParameterStorage(builder: *LirBuilder, parameter_node: usize, parameter: ast.Node, type_id: usize) -> void {
    const components_start = builder.*.bindingComponents.*.length
    const component_count = typeWordCount(builder, type_id)
    appendComponentStorage(builder, tokenPointer(builder, parameter.mainToken), tokenLength(builder, parameter.mainToken), component_count)
    var component_index: usize = 0
    while component_index < component_count {
        var param_inst = lir.initInst(lir.Opcode.param, if component_index == 0 { type_id } else { lir.NONE })
        param_inst.arg0 = builder.*.paramCounter
        const parameter_value = lir.addInst(builder.*.lir, param_inst)
        var parameter_store = lir.initInst(lir.Opcode.store, lir.NONE)
        parameter_store.arg0 = bindingComponentAt(builder, components_start + component_index)
        parameter_store.arg1 = parameter_value
        lir.addInst(builder.*.lir, parameter_store)
        builder.*.paramCounter += 1
        component_index += 1
    }
    pushBindingComponents(builder, tokenPointer(builder, parameter.mainToken), tokenLength(builder, parameter.mainToken), components_start, component_count, type_id)
    if component_count > 0 { appendAutoDrop(builder, parameter_node, bindingComponentAt(builder, components_start), type_id) }
}

fn bindFunctionParameters(builder: *LirBuilder, first_parameter: usize, function_type: usize) -> void {
    const nodes = getNodes(builder)
    var parameter_node = first_parameter
    var parameter_index: usize = 0
    while parameter_node != ast.NONE {
        const parameter = ast_store.Store.get(nodes, parameter_node)
        const type_id = parameterType(builder, parameter, parameter_index, function_type)
        const generic_argument = genericArgumentForParameter(builder, parameter_index, type_id)
        if parameter.extra & 1 != 0 {
            pushComptimeBinding(builder, tokenPointer(builder, parameter.mainToken), tokenLength(builder, parameter.mainToken), type_id, generic_argument.valueTypeId, generic_argument.comptimeTag, generic_argument.comptimeInteger)
        } else {
            emitParameterStorage(builder, parameter_node, parameter, type_id)
        }
        parameter_node = parameter.next
        parameter_index += 1
    }
}

fn lowerFunction(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const n = ast_store.Store.get(nodes, node_index)
    if n.rhs == ast.NONE || (n.endToken >> 32) & 16 != 0 { return lir.NONE }
    if builder.*.currentGenericInstance == lir.NONE && isGenericDeclaration(nodes, node_index) { return lir.NONE }
    const name_ptr = tokenPointer(builder, n.mainToken)
    const name_len = tokenLength(builder, n.mainToken)
    const symbol_index = functionSymbolIndex(builder, node_index, name_ptr, name_len)
    const function_type = concreteFunctionType(builder, symbol_index)
    const return_type = functionReturnType(builder, function_type)
    // Functions whose result is itself a type only participate in comptime
    // evaluation. Emitting a runtime body would incorrectly treat references
    // to erased type parameters as linker symbols.
    if types_store.Store.get(builder.*.typeStore, return_type).*.kind == types_store.Kind.type_type { return lir.NONE }
    const function_symbol = addFunctionSymbol(builder, symbol_index, name_ptr, name_len)
    lir.setSymbolSource(builder.*.lir, function_symbol, builder.*.currentModuleId, tokenStart(builder, n.mainToken))
    const returns_in_memory = aggregate_copy.isMemoryType(builder.*.typeStore, return_type)
    var label = lir.labelInst(return_type, function_symbol)
    if returns_in_memory { label.flags = lir.FLAG_RETURN_SLOT }
    lir.addInst(builder.*.lir, label)
    const bindings_len = builder.*.bindings.*.length
    const binding_components_len = builder.*.bindingComponents.*.length
    const cleanup_depth = builder.*.deferredNodes.*.length
    const saved_return_type = builder.*.currentReturnType
    const saved_frame_storage = builder.*.frameStorageCount
    const saved_return_slot = builder.*.returnSlot
    builder.*.currentReturnType = return_type
    builder.*.frameStorageCount = 0
    builder.*.paramCounter = 0
    builder.*.returnSlot = lir.NONE
    if returns_in_memory {
        var slot = lir.initInst(lir.Opcode.param, return_type)
        slot.arg0 = 0
        slot.flags = lir.FLAG_RETURN_SLOT
        builder.*.returnSlot = lir.addInst(builder.*.lir, slot)
        builder.*.paramCounter = 1
    }
    bindFunctionParameters(builder, n.lhs, function_type)
    const track_recursion = symbol_index != lir.NONE
    if track_recursion { pushInlineSymbol(builder, symbol_index) }
    lowerNode(builder, n.rhs)
    if track_recursion { builder.*.inlineStack.*.length -= 1 }
    emitDefersTo(builder, cleanup_depth)
    builder.*.deferredNodes.*.length = cleanup_depth
    // A fallthrough return must not leak the value left in the platform return
    // register by the last call in the function. This is observable for void
    // entry points, whose process status is required to be zero.
    const implicit_result = lir.addInst(builder.*.lir, lir.constI(return_type, 0))
    lir.addInst(builder.*.lir, lir.retInst(return_type, implicit_result))
    builder.*.bindings.*.length = bindings_len
    builder.*.bindingComponents.*.length = binding_components_len
    builder.*.currentReturnType = saved_return_type
    builder.*.frameStorageCount = saved_frame_storage
    builder.*.returnSlot = saved_return_slot
    return lir.NONE
}

// Lowers a node; its instructions come from where its main token is (for
// the executable's line table), and what it holds from where theirs are.
fn lowerNode(builder: *LirBuilder, node_index: usize) -> usize {
    if node_index == ast.NONE { return lir.NONE }
    const n = ast_store.Store.get(getNodes(builder), node_index)
    const before = lir.setSource(builder.*.lir, (builder.*.currentModuleId << 32) | tokenStart(builder, n.mainToken))
    const result = lowerNodeHere(builder, node_index)
    const restored = lir.setSource(builder.*.lir, before)
    return result
}

fn lowerNodeHere(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const n = ast_store.Store.get(nodes, node_index)

    if n.tag == ast.Tag.integer_literal {
        return lowerIntLiteral(builder, n.mainToken)
    }
    if n.tag == ast.Tag.character_literal {
        return lir.addInst(builder.*.lir, lir.constI(lir.NONE, characterValue(tokenPointer(builder, n.mainToken), tokenLength(builder, n.mainToken))))
    }
    if n.tag == ast.Tag.float_literal {
        return lowerFloatLiteral(builder, n.mainToken)
    }
    if n.tag == ast.Tag.boolean_literal {
        return lowerBoolLiteral(builder, n.mainToken)
    }
    if n.tag == ast.Tag.null_literal {
        // Typed, so that a tagged optional made from it is absent
        // (coerceToTaggedOptional), where a 0 would be present.
        return lir.addInst(builder.*.lir, lir.constI(types_store.Store.primitive(builder.*.typeStore, types_store.Kind.null_type), 0))
    }
    if n.tag == ast.Tag.undefined_literal {
        return lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
    }
    if n.tag == ast.Tag.string_literal {
        return lowerStringLiteral(builder, n.mainToken)
    }
    if n.tag == ast.Tag.tuple_literal {
        return lowerTupleLiteral(builder, node_index)
    }
    if n.tag == ast.Tag.aggregate_literal {
        return lowerAggregateLiteral(builder, node_index)
    }
    if n.tag == ast.Tag.array_literal {
        return lowerArrayLiteral(builder, node_index)
    }
    if n.tag == ast.Tag.identifier {
        return lowerIdentifier(builder, n.mainToken)
    }
    if n.tag == ast.Tag.binary_expression {
        return lowerBinaryOp(builder, node_index)
    }
    if n.tag == ast.Tag.call_expression {
        return lowerCall(builder, node_index)
    }
    if n.tag == ast.Tag.field_expression {
        return lowerField(builder, node_index)
    }
    if n.tag == ast.Tag.index_expression {
        const address = lowerIndexAddress(builder, node_index)
        if address == lir.NONE { return lir.NONE }
        const type_id = expressionType(builder, node_index)
        return lowerMemoryValue(builder, address, type_id)
    }
    if n.tag == ast.Tag.slice_expression {
        return lowerSlice(builder, node_index)
    }
    if n.tag == ast.Tag.builtin_call {
        return lowerBuiltin(builder, node_index)
    }
    if n.tag == ast.Tag.return_statement && builder.*.returnSlot != lir.NONE && n.rhs != ast.NONE {
        return lowerSlotReturn(builder, n.rhs)
    }
    if n.tag == ast.Tag.return_statement {
        const returned_type = returnValueType(builder, n.rhs)
        const val = returnedValue(builder, n.rhs, widenToType(builder, narrowFloat(builder, lowerNode(builder, n.rhs), returned_type), returned_type))
        emitDefersTo(builder, 0)
        if builder.*.currentReturnType != lir.NONE {
            const return_type = types_store.Store.get(builder.*.typeStore, builder.*.currentReturnType)
            if return_type.*.kind == types_store.Kind.error_union && n.rhs != ast.NONE {
                const value_type_id = expressionType(builder, n.rhs)
                if value_type_id != 0 {
                    const value_type = types_store.Store.get(builder.*.typeStore, value_type_id)
                    if value_type.*.kind == types_store.Kind.error_set {
                        var error_return = lir.initInst(lir.Opcode.ret_error, builder.*.currentReturnType)
                        error_return.arg0 = val
                        return lir.addInst(builder.*.lir, error_return)
                    }
                    if value_type.*.kind == types_store.Kind.error_union {
                        var union_return = lir.initInst(lir.Opcode.ret_error_union, builder.*.currentReturnType)
                        union_return.arg0 = val
                        return lir.addInst(builder.*.lir, union_return)
                    }
                }
                // The union is the tag 0 and then every word of the
                // payload (a slice's length too).
                const payload_words = typeWordCount(builder, return_type.*.rhs)
                const success = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
                var words: [8]usize = undefined
                var word: usize = 1
                while word < payload_words && word < 8 {
                    var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
                    extract.arg0 = val
                    extract.arg1 = word
                    words[word] = lir.addInst(builder.*.lir, extract)
                    word += 1
                }
                const extra_start = builder.*.lir.*.extraData.*.length
                lir.addExtra(builder.*.lir, success)
                lir.addExtra(builder.*.lir, val)
                word = 1
                while word < payload_words && word < 8 {
                    lir.addExtra(builder.*.lir, words[word])
                    word += 1
                }
                var result = lir.initInst(lir.Opcode.tuple_literal, builder.*.currentReturnType)
                result.arg0 = extra_start
                result.arg1 = 1 + word
                const union_value = lir.addInst(builder.*.lir, result)
                var union_return = lir.initInst(lir.Opcode.ret_error_union, builder.*.currentReturnType)
                union_return.arg0 = union_value
                return lir.addInst(builder.*.lir, union_return)
            }
        }
        // A bare `return` leaves nothing in the return register but what the
        // last call put there, which a `!void` caller reads as an error;
        // it returns zero, as falling off the end does.
        var returned = val
        if returned == lir.NONE && n.rhs == ast.NONE { returned = lir.addInst(builder.*.lir, lir.constI(builder.*.currentReturnType, 0)) }
        return lir.addInst(builder.*.lir, lir.retInst(builder.*.currentReturnType, returned))
    }
    if n.tag == ast.Tag.block {
        return lowerBlock(builder, node_index)
    }
    if n.tag == ast.Tag.if_statement {
        return lowerIf(builder, node_index)
    }
    if n.tag == ast.Tag.match_statement {
        return lowerMatch(builder, node_index)
    }
    if n.tag == ast.Tag.while_statement || n.tag == ast.Tag.inline_while_statement {
        return lowerWhile(builder, node_index)
    }
    if n.tag == ast.Tag.for_statement || n.tag == ast.Tag.inline_for_statement {
        return lowerFor(builder, node_index)
    }
    if n.tag == ast.Tag.break_statement {
        const target = findLoopTarget(builder, n.lhs)
        if @intFromPtr(target) != 0 {
            if n.rhs != ast.NONE {
                const value = lowerNode(builder, n.rhs)
                var store = lir.initInst(lir.Opcode.store, lir.NONE)
                store.arg0 = target.*.resultAddress
                store.arg1 = value
                lir.addInst(builder.*.lir, store)
            }
            emitDefersTo(builder, target.*.deferDepth)
            return lir.addInst(builder.*.lir, lir.branch(target.*.breakBlock))
        }
        return lir.NONE
    }
    if n.tag == ast.Tag.continue_statement {
        const target = findLoopTarget(builder, n.lhs)
        if @intFromPtr(target) != 0 {
            emitDefersTo(builder, target.*.deferDepth)
            return lir.addInst(builder.*.lir, lir.branch(target.*.continueBlock))
        }
        return lir.NONE
    }
    if n.tag == ast.Tag.defer_statement {
        appendDeferred(builder, n.lhs)
        return lir.NONE
    }
    if n.tag == ast.Tag.error_defer_statement { return lir.NONE }
    if n.tag == ast.Tag.constant_declaration || n.tag == ast.Tag.variable_declaration {
        if n.tag == ast.Tag.variable_declaration && n.extra & 32 != 0 {
            recordUnsupportedBuiltin(builder, n.mainToken)
            return lir.NONE
        }
        return lowerLocalBinding(builder, node_index)
    }
    if n.tag == ast.Tag.unsafe_block || n.tag == ast.Tag.unsafe_expression {
        return lowerNode(builder, n.lhs)
    }
    if n.tag == ast.Tag.comptime_block {
        return lowerNode(builder, n.lhs)
    }
    if n.tag == ast.Tag.unary_expression {
        return lowerUnary(builder, node_index)
    }
    if n.tag == ast.Tag.function_declaration {
        return lowerFunction(builder, node_index)
    }
    return lir.NONE
}

fn lowerIntLiteral(builder: *LirBuilder, main_token: usize) -> usize {
    unsafe {
        const value = type_resolve.parseUnsigned(
            builder.*.sourcePointer[0..builder.*.sourceLength],
            getTokens(builder).*,
            main_token,
        )
        return lir.addInst(builder.*.lir, lir.constI(lir.NONE, value))
    }
}

fn hexDigit(byte: u8) -> usize {
    if byte >= 48 && byte <= 57 { return @intCast(usize, byte - 48) }
    if byte >= 97 && byte <= 102 { return @intCast(usize, byte - 87) }
    if byte >= 65 && byte <= 70 { return @intCast(usize, byte - 55) }
    return 0
}

// The number a character literal names (spec lexical.xml,
// CharacterLiterals): the one character between its quotes, an escape
// decoded as in a string literal (`'\x1b'` is 27, `'\u{20AC}'` 8364),
// else the character's Unicode scalar read from its UTF-8 bytes. The
// lexer rejected unknown escapes already.
fn characterValue(pointer: [*]const u8, length: usize) -> usize {
    if length < 3 { return 0 }
    const first = pointer[1]
    if first == 92 {
        if length < 4 { return 0 }
        const kind = pointer[2]
        if kind == 110 { return 10 }
        if kind == 114 { return 13 }
        if kind == 116 { return 9 }
        if kind == 48 { return 0 }
        if kind == 120 {
            if length < 6 { return 0 }
            return hexDigit(pointer[3]) * 16 + hexDigit(pointer[4])
        }
        if kind == 117 {
            var scalar: usize = 0
            var index: usize = 4
            while index + 1 < length && pointer[index] != 125 {
                scalar = scalar * 16 + hexDigit(pointer[index])
                index += 1
            }
            return scalar
        }
        return @intCast(usize, kind)
    }
    if first < 128 { return @intCast(usize, first) }
    var scalar: usize = 0
    var continuation: usize = 0
    if first >= 240 {
        scalar = @intCast(usize, first & 7)
        continuation = 3
    } else if first >= 224 {
        scalar = @intCast(usize, first & 15)
        continuation = 2
    } else if first >= 192 {
        scalar = @intCast(usize, first & 31)
        continuation = 1
    }
    var index: usize = 2
    while continuation > 0 && index + 1 < length {
        scalar = (scalar << 6) | @intCast(usize, pointer[index] & 63)
        index += 1
        continuation -= 1
    }
    return scalar
}

fn lowerFloatLiteral(builder: *LirBuilder, main_token: usize) -> usize {
    const bits = decimal.parse(tokenPointer(builder, main_token), tokenLength(builder, main_token))
    return lir.addInst(builder.*.lir, lir.constI(types_store.Store.float(builder.*.typeStore, 64), @intCast(usize, bits)))
}

// Float literals are lowered as f64. Where one meets an f32 (a binding,
// parameter, field, return value or the other operand) it is narrowed like
// `@floatCast`; otherwise the f32 would read the low half of the f64 bits.
// The type a `return` converts its value to: in a function returning an
// error union, a value that is neither an error nor a union is the
// payload (an f64 literal narrows to an `!f32`'s f32).
fn returnValueType(builder: *LirBuilder, value_node: usize) -> usize {
    const return_type = builder.*.currentReturnType
    if return_type == lir.NONE || return_type == 0 || value_node == ast.NONE { return return_type }
    const union_type = types_store.Store.get(builder.*.typeStore, return_type)
    if union_type.*.kind != types_store.Kind.error_union { return return_type }
    const value_type = expressionType(builder, value_node)
    if value_type == 0 { return return_type }
    const value_kind = types_store.Store.get(builder.*.typeStore, value_type).*.kind
    if value_kind == types_store.Kind.error_set || value_kind == types_store.Kind.error_union { return return_type }
    return union_type.*.rhs
}

fn narrowFloat(builder: *LirBuilder, value: usize, type_id: usize) -> usize {
    if value == lir.NONE || !isFloatType(builder, type_id, 32) { return value }
    const source = lir.getInst(builder.*.lir, value).typeId
    // Arithmetic on float literals alone is worked out in f64 (comptime
    // float), so it narrows like an f64.
    const comptime_float = source != 0 && source < builder.*.typeStore.*.types.*.length && types_store.Store.get(builder.*.typeStore, source).*.kind == types_store.Kind.comptime_float_type
    if !isFloatType(builder, source, 64) && !comptime_float { return value }
    var conversion = lir.initInst(lir.Opcode.cast, type_id)
    conversion.arg0 = value
    conversion.arg1 = source
    return lir.addInst(builder.*.lir, conversion)
}

fn isFloatType(builder: *LirBuilder, type_id: usize, bits: usize) -> bool {
    if type_id == 0 || type_id >= builder.*.typeStore.*.types.*.length { return false }
    const value_type = types_store.Store.get(builder.*.typeStore, type_id)
    return value_type.*.kind == types_store.Kind.float && value_type.*.bits == bits
}

fn valueType(builder: *LirBuilder, value: usize) -> usize {
    if value == lir.NONE { return 0 }
    return lir.getInst(builder.*.lir, value).typeId
}

fn lowerBoolLiteral(builder: *LirBuilder, main_token: usize) -> usize {
    const kind = tokenKind(builder, main_token)
    const val: usize = if kind == lexer.Kind.keyword_true { 1 } else { 0 }
    return lir.addInst(builder.*.lir, lir.constI(lir.NONE, val))
}

fn lowerStringLiteral(builder: *LirBuilder, main_token: usize) -> usize {
    const ptr = tokenPointer(builder, main_token)
    const len = tokenLength(builder, main_token)
    // String tokens include quotes, so actual string is ptr[1..len-1]
    if len >= 2 {
        unsafe {
            const str_ptr = @ptrFromInt([*]const u8, @intFromPtr(ptr) + 1)
            const str_len = len - 2
            const lit_id = lir.addStringLiteral(builder.*.lir, str_ptr, str_len)
            var inst = lir.initInst(lir.Opcode.string_literal, lir.NONE)
            inst.arg0 = lit_id
            return lir.addInst(builder.*.lir, inst)
        }
    }
    return lir.NONE
}

fn lowerTupleLiteral(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    var physical_count: usize = 0
    var physical_child = node.lhs
    var physical_child_count: usize = 0
    while physical_child != ast.NONE && physical_child_count < node.rhs {
        physical_count += typeWordCount(builder, expressionType(builder, physical_child))
        physical_child = ast_store.Store.get(nodes, physical_child).next
        physical_child_count += 1
    }
    const start = builder.*.lir.*.extraData.*.length
    var reserved: usize = 0
    while reserved < physical_count {
        lir.addExtra(builder.*.lir, lir.NONE)
        reserved += 1
    }
    var child = node.lhs
    var count: usize = 0
    var logical_count: usize = 0
    while child != ast.NONE && logical_count < node.rhs {
        const child_node = ast_store.Store.get(nodes, child)
        const child_value = lowerNode(builder, child)
        const child_words = typeWordCount(builder, expressionType(builder, child))
        var component: usize = 0
        while component < child_words {
            var component_value = child_value
            if component > 0 {
                var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
                extract.arg0 = child_value
                extract.arg1 = component
                component_value = lir.addInst(builder.*.lir, extract)
            }
            lir.setExtra(builder.*.lir, start + count, component_value)
            count += 1
            component += 1
        }
        child = child_node.next
        logical_count += 1
    }
    var inst = lir.initInst(lir.Opcode.tuple_literal, expressionType(builder, node_index))
    inst.arg0 = start
    inst.arg1 = count
    return lir.addInst(builder.*.lir, inst)
}

fn isOptionalSlice(builder: *LirBuilder, type_id: usize) -> bool {
    if type_id == 0 || type_id == lir.NONE { return false }
    const value = types_store.Store.get(builder.*.typeStore, type_id)
    return value.*.kind == types_store.Kind.optional && types_store.Store.get(builder.*.typeStore, value.*.lhs).*.kind == types_store.Kind.slice
}

// Optionals. Of a pointer, a function or a slice, the optional is the
// payload itself (null: 0, or (0, 0)). Of anything else but a float it
// is "tagged": the payload and then a tag, 1 when a value is present, a
// word after the payload's words in registers and the byte after the
// payload's bytes in memory (the type's size is the payload's plus one),
// so that `?usize` holding 0 is not null. A tagged optional of a struct,
// union or array is a memory value (aggregate_copy.isMemoryType), as its
// payload is: its address, the payload at offset 0.
fn isTaggedOptional(builder: *LirBuilder, type_id: usize) -> bool {
    if type_id == 0 || type_id == lir.NONE { return false }
    const value = types_store.Store.get(builder.*.typeStore, type_id)
    if value.*.kind != types_store.Kind.optional || value.*.lhs == 0 { return false }
    const child = types_store.Store.get(builder.*.typeStore, value.*.lhs)
    return child.*.kind != types_store.Kind.pointer && child.*.kind != types_store.Kind.many_pointer && child.*.kind != types_store.Kind.function && child.*.kind != types_store.Kind.slice && child.*.kind != types_store.Kind.float && child.*.kind != types_store.Kind.comptime_float_type
}

fn optionalPayloadType(builder: *LirBuilder, type_id: usize) -> usize {
    return types_store.Store.get(builder.*.typeStore, type_id).*.lhs
}

// The tag of a tagged optional value: the last word, or the byte after
// the payload of a memory one.
fn optionalTag(builder: *LirBuilder, value: usize, type_id: usize) -> usize {
    const bool_type = types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type)
    if aggregate_copy.isMemoryType(builder.*.typeStore, type_id) {
        const offset = lir.addInst(builder.*.lir, lir.constI(lir.NONE, types_store.Store.sizeOf(builder.*.typeStore, optionalPayloadType(builder, type_id))))
        var tag_address = lir.initInst(lir.Opcode.gep, lir.NONE)
        tag_address.arg0 = value
        tag_address.arg1 = offset
        tag_address.arg2 = 1
        const address = lir.addInst(builder.*.lir, tag_address)
        var load = lir.initInst(lir.Opcode.load, bool_type)
        load.arg0 = address
        load.arg1 = 1
        return lir.addInst(builder.*.lir, load)
    }
    var extract = lir.initInst(lir.Opcode.tuple_element, bool_type)
    extract.arg0 = value
    extract.arg1 = typeWordCount(builder, type_id) - 1
    return lir.addInst(builder.*.lir, extract)
}

// The payload of a tagged optional value (its words, or its address).
fn optionalPayload(builder: *LirBuilder, value: usize, type_id: usize) -> usize {
    if aggregate_copy.isMemoryType(builder.*.typeStore, type_id) { return value }
    const payload_type = optionalPayloadType(builder, type_id)
    const payload_words = typeWordCount(builder, payload_type)
    if payload_words == 1 {
        var extract = lir.initInst(lir.Opcode.tuple_element, payload_type)
        extract.arg0 = value
        extract.arg1 = 0
        return lir.addInst(builder.*.lir, extract)
    }
    const extra_start = builder.*.lir.*.extraData.*.length
    var word: usize = 0
    while word < payload_words {
        var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
        extract.arg0 = value
        extract.arg1 = word
        lir.addExtra(builder.*.lir, lir.addInst(builder.*.lir, extract))
        word += 1
    }
    var payload = lir.initInst(lir.Opcode.tuple_literal, payload_type)
    payload.arg0 = extra_start
    payload.arg1 = payload_words
    return lir.addInst(builder.*.lir, payload)
}

// `value` as the tagged optional `type_id`: a value of the type stays
// one; `null` becomes the absent value; a payload becomes present.
fn coerceToTaggedOptional(builder: *LirBuilder, value: usize, type_id: usize) -> usize {
    const given = valueType(builder, value)
    if given == type_id { return value }
    if given != 0 && given != lir.NONE && types_store.Store.get(builder.*.typeStore, given).*.kind == types_store.Kind.optional { return value }
    const is_null = given == types_store.Store.primitive(builder.*.typeStore, types_store.Kind.null_type)
    const payload_type = optionalPayloadType(builder, type_id)
    if aggregate_copy.isMemoryType(builder.*.typeStore, type_id) {
        var size = types_store.Store.sizeOf(builder.*.typeStore, type_id)
        if size < 8 { size = 8 }
        var allocation = lir.initInst(lir.Opcode.alloca, type_id)
        allocation.arg0 = size
        const block = lir.addInst(builder.*.lir, allocation)
        if !is_null { aggregate_copy.emit(builder.*.lir, builder.*.typeStore, block, value, payload_type) }
        const offset = lir.addInst(builder.*.lir, lir.constI(lir.NONE, types_store.Store.sizeOf(builder.*.typeStore, payload_type)))
        var tag_address = lir.initInst(lir.Opcode.gep, lir.NONE)
        tag_address.arg0 = block
        tag_address.arg1 = offset
        tag_address.arg2 = 1
        const address = lir.addInst(builder.*.lir, tag_address)
        const tag = lir.addInst(builder.*.lir, lir.constI(types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type), if is_null { 0 } else { 1 }))
        var tag_store = lir.initInst(lir.Opcode.store, lir.NONE)
        tag_store.arg0 = address
        tag_store.arg1 = tag
        tag_store.arg2 = 1
        lir.addInst(builder.*.lir, tag_store)
        return block
    }
    const payload_words = typeWordCount(builder, payload_type)
    const extra_start = builder.*.lir.*.extraData.*.length
    var word: usize = 0
    while word < payload_words {
        var component = value
        if is_null {
            component = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
        } else if payload_words > 1 {
            var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
            extract.arg0 = value
            extract.arg1 = word
            component = lir.addInst(builder.*.lir, extract)
        }
        lir.addExtra(builder.*.lir, component)
        word += 1
    }
    lir.addExtra(builder.*.lir, lir.addInst(builder.*.lir, lir.constI(types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type), if is_null { 0 } else { 1 })))
    var result = lir.initInst(lir.Opcode.tuple_literal, type_id)
    result.arg0 = extra_start
    result.arg1 = payload_words + 1
    return lir.addInst(builder.*.lir, result)
}

// Whether a load of `type_id`'s first word sign-extends: an optional's
// payload as the payload's type says.
fn loadsSigned(builder: *LirBuilder, type_id: usize) -> bool {
    if isTaggedOptional(builder, type_id) { return isSignedIntegerType(builder, optionalPayloadType(builder, type_id)) }
    return isSignedIntegerType(builder, type_id)
}

// `value` as a `type_id`: a single-word constant (null, undefined) where
// an optional slice (two words) is wanted becomes the pair (it, 0), so
// the length word is written and arguments after it stay in their
// registers.
fn widenToType(builder: *LirBuilder, value: usize, type_id: usize) -> usize {
    if value == lir.NONE { return value }
    if isWideType(builder, type_id) { return wideOperand(builder, value, valueType(builder, value), type_id) }
    if isTaggedOptional(builder, type_id) { return coerceToTaggedOptional(builder, value, type_id) }
    if !isOptionalSlice(builder, type_id) { return value }
    if lir.getInst(builder.*.lir, value).opcode != lir.Opcode.const_i { return value }
    const zero = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
    const extra_start = builder.*.lir.*.extraData.*.length
    lir.addExtra(builder.*.lir, value)
    lir.addExtra(builder.*.lir, zero)
    var pair = lir.initInst(lir.Opcode.tuple_literal, type_id)
    pair.arg0 = extra_start
    pair.arg1 = 2
    return lir.addInst(builder.*.lir, pair)
}

fn storeAggregateValue(builder: *LirBuilder, address: usize, stored: usize, type_id: usize) -> void {
    const value = widenToType(builder, narrowFloat(builder, stored, type_id), type_id)
    if aggregate_copy.isMemoryType(builder.*.typeStore, type_id) {
        aggregate_copy.emit(builder.*.lir, builder.*.typeStore, address, value, type_id)
        return
    }
    const word_count = typeWordCount(builder, type_id)
    const tagged = isTaggedOptional(builder, type_id)
    var component: usize = 0
    while component < word_count {
        var component_address = address
        var component_value = value
        if component > 0 {
            const byte_offset = if tagged && component == word_count - 1 { types_store.Store.sizeOf(builder.*.typeStore, optionalPayloadType(builder, type_id)) } else { component * 8 }
            const offset = lir.addInst(builder.*.lir, lir.constI(lir.NONE, byte_offset))
            var component_gep = lir.initInst(lir.Opcode.gep, lir.NONE)
            component_gep.arg0 = address
            component_gep.arg1 = offset
            component_gep.arg2 = 1
            component_address = lir.addInst(builder.*.lir, component_gep)
            var component_extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
            component_extract.arg0 = value
            component_extract.arg1 = component
            component_value = lir.addInst(builder.*.lir, component_extract)
        }
        var store = lir.initInst(lir.Opcode.store, type_id)
        store.arg0 = component_address
        store.arg1 = component_value
        store.arg2 = if component == 0 { storageWidth(builder, type_id) } else if tagged && component == word_count - 1 { 1 } else { 8 }
        lir.addInst(builder.*.lir, store)
        component += 1
    }
}

fn lowerAggregateLiteral(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    const type_id = aggregateTypeFromPrefix(builder, node.lhs)
    if type_id == 0 { return lir.NONE }
    var allocation_size = types_store.Store.sizeOf(builder.*.typeStore, type_id)
    if allocation_size < 8 { allocation_size = 8 }
    var allocation = lir.initInst(lir.Opcode.alloca, type_id)
    allocation.arg0 = allocation_size
    const base = lir.addInst(builder.*.lir, allocation)
    const aggregate_type = types_store.Store.get(builder.*.typeStore, type_id)
    var initializer_index = node.rhs
    var count: usize = 0
    while initializer_index != ast.NONE && count < node.extra {
        const initializer = ast_store.Store.get(nodes, initializer_index)
        const metadata = fieldMetadata(builder, type_id, initializer.mainToken)
        if metadata.found {
            if aggregate_type.*.kind == types_store.Kind.union_type && aggregate_type.*.backing != types_store.NONE {
                const field_pointer = tokenPointer(builder, initializer.mainToken)
                const field_length = tokenLength(builder, initializer.mainToken)
                var tag_index: usize = 0
                while tag_index < aggregate_type.*.extraLength {
                    const field = types_store.Store.fieldAt(builder.*.typeStore, aggregate_type.*.extraStart + tag_index)
                    if field.*.nameLength == field_length && mem.eql(field.*.namePointer, field_pointer, field_length) { break }
                    tag_index += 1
                }
                const tag_value = lir.addInst(builder.*.lir, lir.constI(aggregate_type.*.backing, tag_index))
                var tag_store = lir.initInst(lir.Opcode.store, aggregate_type.*.backing)
                tag_store.arg0 = base
                tag_store.arg1 = tag_value
                tag_store.arg2 = storageWidth(builder, aggregate_type.*.backing)
                lir.addInst(builder.*.lir, tag_store)
            }
            const initializer_value_node = ast_store.Store.get(nodes, initializer.rhs)
            const field_is_undefined_memory_type = initializer_value_node.tag == ast.Tag.undefined_literal && aggregate_copy.isMemoryType(builder.*.typeStore, metadata.typeId)
            if !field_is_undefined_memory_type {
                const offset = lir.addInst(builder.*.lir, lir.constI(lir.NONE, metadata.offset))
                var address_inst = lir.initInst(lir.Opcode.gep, lir.NONE)
                address_inst.arg0 = base
                address_inst.arg1 = offset
                address_inst.arg2 = 1
                const address = lir.addInst(builder.*.lir, address_inst)
                const value = lowerNode(builder, initializer.rhs)
                storeAggregateValue(builder, address, value, metadata.typeId)
            }
        }
        initializer_index = initializer.next
        count += 1
    }
    return base
}

fn lowerArrayLiteral(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    const array_type = expressionType(builder, node_index)
    var element_type = resolveTypeNode(builder, node.endToken)
    if element_type == 0 && array_type != 0 { element_type = types_store.Store.get(builder.*.typeStore, array_type).*.lhs }
    var stride = types_store.Store.sizeOf(builder.*.typeStore, element_type)
    if stride == 0 { stride = 1 }
    var allocation = lir.initInst(lir.Opcode.alloca, array_type)
    allocation.arg0 = stride * node.rhs
    const base = lir.addInst(builder.*.lir, allocation)
    var child = node.lhs
    var index: usize = 0
    while child != ast.NONE && index < node.rhs {
        const child_node = ast_store.Store.get(nodes, child)
        const index_value = lir.addInst(builder.*.lir, lir.constI(lir.NONE, index))
        var address_inst = lir.initInst(lir.Opcode.gep, lir.NONE)
        address_inst.arg0 = base
        address_inst.arg1 = index_value
        address_inst.arg2 = stride
        const address = lir.addInst(builder.*.lir, address_inst)
        // An element of struct or array type is held by address and copied
        // into the array; a plain store would keep the address instead.
        storeAggregateValue(builder, address, lowerNode(builder, child), element_type)
        child = child_node.next
        index += 1
    }
    return base
}

fn lowerSlice(builder: *LirBuilder, node_index: usize) -> usize {
    const node = ast_store.Store.get(getNodes(builder), node_index)
    const container_type_id = expressionType(builder, node.lhs)
    if container_type_id == 0 { return lir.NONE }
    const container_type = types_store.Store.get(builder.*.typeStore, container_type_id)
    if (container_type.*.kind != types_store.Kind.array && container_type.*.kind != types_store.Kind.slice && container_type.*.kind != types_store.Kind.many_pointer) { return lir.NONE }

    const base = lowerNode(builder, node.lhs)
    if base == lir.NONE { return lir.NONE }
    const lower_bound = if node.rhs == ast.NONE { lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0)) } else { lowerNode(builder, node.rhs) }
    if lower_bound == lir.NONE { return lir.NONE }

    var container_length = lir.NONE
    if container_type.*.kind == types_store.Kind.array {
        container_length = lir.addInst(builder.*.lir, lir.constI(types_store.Store.sizeInteger(builder.*.typeStore, false), container_type.*.bits))
    } else if container_type.*.kind == types_store.Kind.slice {
        var length_extract = lir.initInst(lir.Opcode.tuple_element, types_store.Store.sizeInteger(builder.*.typeStore, false))
        length_extract.arg0 = base
        length_extract.arg1 = 1
        container_length = lir.addInst(builder.*.lir, length_extract)
    }

    var upper_bound = lir.NONE
    if node.extra != ast.NONE {
        upper_bound = lowerNode(builder, node.extra)
    } else {
        upper_bound = container_length
    }
    if upper_bound == lir.NONE { return lir.NONE }

    if builder.*.runtimeSafety {
        const invalid_order = emitComparison(builder, lir.CmpPredicate.ugt, lower_bound, upper_bound)
        emitTrapIf(builder, invalid_order)
        if container_length != lir.NONE {
            const invalid_upper = emitComparison(builder, lir.CmpPredicate.ugt, upper_bound, container_length)
            emitTrapIf(builder, invalid_upper)
        }
    }

    var stride = types_store.Store.sizeOf(builder.*.typeStore, container_type.*.lhs)
    if stride == 0 { stride = 1 }
    var pointer_inst = lir.initInst(lir.Opcode.gep, lir.NONE)
    pointer_inst.arg0 = base
    pointer_inst.arg1 = lower_bound
    pointer_inst.arg2 = stride
    const pointer = lir.addInst(builder.*.lir, pointer_inst)
    const length = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.sub, lir.NONE, upper_bound, lower_bound))

    const extra_start = builder.*.lir.*.extraData.*.length
    lir.addExtra(builder.*.lir, pointer)
    lir.addExtra(builder.*.lir, length)
    var result = lir.initInst(lir.Opcode.tuple_literal, expressionType(builder, node_index))
    result.arg0 = extra_start
    result.arg1 = 2
    return lir.addInst(builder.*.lir, result)
}

fn lowerIntValue(builder: *LirBuilder, main_token: usize) -> usize {
    unsafe {
        return type_resolve.parseUnsigned(
            builder.*.sourcePointer[0..builder.*.sourceLength],
            getTokens(builder).*,
            main_token,
        )
    }
}

// Offset of the field named by the string literal after `type_node` (the
// arguments of @offsetOf), or lir.NONE. Works for types from any module.
fn fieldOffsetFor(builder: *LirBuilder, type_node: usize, aggregate_type: usize) -> usize {
    const first = ast_store.Store.get(getNodes(builder), type_node)
    if first.next == ast.NONE { return lir.NONE }
    const name_node = ast_store.Store.get(getNodes(builder), first.next)
    if name_node.tag != ast.Tag.string_literal { return lir.NONE }
    const length = tokenLength(builder, name_node.mainToken)
    if length < 2 { return lir.NONE }
    var name: [*]const u8 = undefined
    unsafe { name = @ptrFromInt([*]const u8, @intFromPtr(tokenPointer(builder, name_node.mainToken)) + 1) }
    const aggregate = types_store.Store.get(builder.*.typeStore, aggregate_type)
    var index: usize = 0
    while index < aggregate.*.extraLength {
        const field = types_store.Store.fieldAt(builder.*.typeStore, aggregate.*.extraStart + index)
        if field.*.nameLength == length - 2 && mem.eql(field.*.namePointer, name, length - 2) { return field.*.offset }
        index += 1
    }
    return lir.NONE
}

fn lowerComptimeValue(builder: *LirBuilder, node_index: usize) -> comptime_value.Value {
    if node_index == ast.NONE { return comptime_value.invalid() }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.integer_literal {
        unsafe { return comptime_value.integer(@intCast(isize, type_resolve.parseUnsigned(builder.*.sourcePointer[0..builder.*.sourceLength], getTokens(builder).*, node.mainToken))) }
    }
    if node.tag == ast.Tag.character_literal {
        return comptime_value.integer(@intCast(isize, characterValue(tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))))
    }
    if node.tag == ast.Tag.boolean_literal { return comptime_value.boolean(tokenKind(builder, node.mainToken) == lexer.Kind.keyword_true) }
    if node.tag == ast.Tag.identifier || node.tag == ast.Tag.named_type {
        const binding = findBindingRecord(builder, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
        if @intFromPtr(binding) != 0 {
            if binding.*.comptimeTag == @intCast(u8, @intFromEnum(comptime_value.Kind.integer)) { return comptime_value.integer(binding.*.comptimeInteger) }
            if binding.*.comptimeTag == @intCast(u8, @intFromEnum(comptime_value.Kind.boolean)) { return comptime_value.boolean(binding.*.comptimeInteger != 0) }
            if binding.*.valueTypeId != 0 { return comptime_value.typeValue(binding.*.valueTypeId) }
        }
    }
    if node.tag == ast.Tag.builtin_call {
        const kind = builtins.lookup(builder.*.sourcePointer[0..builder.*.sourceLength], getTokens(builder).*, node.mainToken)
        if kind == builtins.Kind.typeOf || kind == builtins.Kind.childType { return comptime_value.typeValue(resolveTypeNode(builder, node_index)) }
        const reflected_type = if node.lhs != ast.NONE { resolveTypeNode(builder, node.lhs) } else { 0 }
        if reflected_type != 0 {
            const value = types_store.Store.get(builder.*.typeStore, reflected_type)
            if kind == builtins.Kind.sizeOf { return comptime_value.integer(@intCast(isize, types_store.Store.sizeOf(builder.*.typeStore, reflected_type))) }
            if kind == builtins.Kind.alignOf { return comptime_value.integer(@intCast(isize, types_store.Store.alignOf(builder.*.typeStore, reflected_type))) }
            if kind == builtins.Kind.bitSizeOf { return comptime_value.integer(@intCast(isize, types_store.Store.bitSizeOf(builder.*.typeStore, reflected_type))) }
            if kind == builtins.Kind.fieldCount { return comptime_value.integer(@intCast(isize, value.*.extraLength)) }
            if kind == builtins.Kind.offsetOf && (value.*.kind == types_store.Kind.struct_type || value.*.kind == types_store.Kind.union_type) {
                const offset = fieldOffsetFor(builder, node.lhs, reflected_type)
                if offset != lir.NONE { return comptime_value.integer(@intCast(isize, offset)) }
            }
            if kind == builtins.Kind.isInteger { return comptime_value.boolean(value.*.kind == types_store.Kind.integer || value.*.kind == types_store.Kind.comptime_int_type) }
            if kind == builtins.Kind.isFloat { return comptime_value.boolean(value.*.kind == types_store.Kind.float || value.*.kind == types_store.Kind.comptime_float_type) }
            if kind == builtins.Kind.isBool { return comptime_value.boolean(value.*.kind == types_store.Kind.bool_type) }
            if kind == builtins.Kind.isSigned { return comptime_value.boolean(value.*.kind == types_store.Kind.comptime_int_type || value.*.kind == types_store.Kind.integer && value.*.flags & types_store.FLAG_SIGNED != 0) }
            if kind == builtins.Kind.isStruct { return comptime_value.boolean(value.*.kind == types_store.Kind.struct_type) }
            if kind == builtins.Kind.isTuple { return comptime_value.boolean(value.*.kind == types_store.Kind.tuple) }
            if kind == builtins.Kind.isEnum { return comptime_value.boolean(value.*.kind == types_store.Kind.enum_type) }
            if kind == builtins.Kind.isUnion { return comptime_value.boolean(value.*.kind == types_store.Kind.union_type) }
            if kind == builtins.Kind.isPointer { return comptime_value.boolean(value.*.kind == types_store.Kind.pointer || value.*.kind == types_store.Kind.many_pointer) }
            if kind == builtins.Kind.isSlice { return comptime_value.boolean(value.*.kind == types_store.Kind.slice) }
            if kind == builtins.Kind.isArray { return comptime_value.boolean(value.*.kind == types_store.Kind.array) }
            if kind == builtins.Kind.isOptional { return comptime_value.boolean(value.*.kind == types_store.Kind.optional) }
            if kind == builtins.Kind.isErrorUnion { return comptime_value.boolean(value.*.kind == types_store.Kind.error_union) }
            if kind == builtins.Kind.isCopyable { return comptime_value.boolean(value.*.copyability == types_store.Copyability.copyable) }
        }
    }
    if node.tag == ast.Tag.unary_expression {
        const operand = lowerComptimeValue(builder, node.lhs)
        if !comptime_module.isValid(operand) { return operand }
        const kind = tokenKind(builder, node.mainToken)
        if kind == lexer.Kind.bang { return comptime_value.boolean(operand.integer == 0) }
        if kind == lexer.Kind.minus { return comptime_value.integer(-operand.integer) }
    }
    if node.tag == ast.Tag.binary_expression {
        const left = lowerComptimeValue(builder, node.lhs)
        const right = lowerComptimeValue(builder, node.rhs)
        if !comptime_module.isValid(left) || !comptime_module.isValid(right) { return comptime_value.invalid() }
        const kind = tokenKind(builder, node.mainToken)
        if kind == lexer.Kind.plus { return comptime_value.integer(left.integer + right.integer) }
        if kind == lexer.Kind.minus { return comptime_value.integer(left.integer - right.integer) }
        if kind == lexer.Kind.asterisk { return comptime_value.integer(left.integer * right.integer) }
        if kind == lexer.Kind.equal_equal { return comptime_value.boolean(left.integer == right.integer) }
        if kind == lexer.Kind.bang_equal { return comptime_value.boolean(left.integer != right.integer) }
        if kind == lexer.Kind.less { return comptime_value.boolean(left.integer < right.integer) }
        if kind == lexer.Kind.less_equal { return comptime_value.boolean(left.integer <= right.integer) }
        if kind == lexer.Kind.greater { return comptime_value.boolean(left.integer > right.integer) }
        if kind == lexer.Kind.greater_equal { return comptime_value.boolean(left.integer >= right.integer) }
        if kind == lexer.Kind.ampersand_ampersand { return comptime_value.boolean(left.integer != 0 && right.integer != 0) }
        if kind == lexer.Kind.pipe_pipe { return comptime_value.boolean(left.integer != 0 || right.integer != 0) }
    }
    return comptime_module.evaluate(builder.*.sourcePointer[0..builder.*.sourceLength], getTokens(builder).*, getNodes(builder), builder.*.typeStore, builder.*.symbolStore, currentScope(builder), node_index, 1000000)
}

fn lowerFlatTupleField(builder: *LirBuilder, base: usize, field_type: usize, word_offset: usize) -> usize {
    const word_count = typeWordCount(builder, field_type)
    if word_count == 1 {
        var extract = lir.initInst(lir.Opcode.tuple_element, field_type)
        extract.arg0 = base
        extract.arg1 = word_offset
        return lir.addInst(builder.*.lir, extract)
    }
    const extra_start = builder.*.lir.*.extraData.*.length
    var component: usize = 0
    while component < word_count {
        var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
        extract.arg0 = base
        extract.arg1 = word_offset + component
        lir.addExtra(builder.*.lir, lir.addInst(builder.*.lir, extract))
        component += 1
    }
    var result = lir.initInst(lir.Opcode.tuple_literal, field_type)
    result.arg0 = extra_start
    result.arg1 = word_count
    return lir.addInst(builder.*.lir, result)
}

fn lowerMemoryValue(builder: *LirBuilder, address: usize, type_id: usize) -> usize {
    if aggregate_copy.isMemoryType(builder.*.typeStore, type_id) { return address }
    const word_count = typeWordCount(builder, type_id)
    if word_count == 1 {
        var load = lir.initInst(lir.Opcode.load, type_id)
        load.arg0 = address
        load.arg1 = storageWidth(builder, type_id)
        load.arg2 = if isSignedIntegerType(builder, type_id) { 1 } else { 0 }
        return lir.addInst(builder.*.lir, load)
    }
    const tagged = isTaggedOptional(builder, type_id)
    const extra_start = builder.*.lir.*.extraData.*.length
    var component: usize = 0
    while component < word_count {
        var component_address = address
        const is_tag = tagged && component == word_count - 1
        if component > 0 {
            const byte_offset = if is_tag { types_store.Store.sizeOf(builder.*.typeStore, optionalPayloadType(builder, type_id)) } else { component * 8 }
            const component_offset = lir.addInst(builder.*.lir, lir.constI(lir.NONE, byte_offset))
            var component_gep = lir.initInst(lir.Opcode.gep, lir.NONE)
            component_gep.arg0 = address
            component_gep.arg1 = component_offset
            component_gep.arg2 = 1
            component_address = lir.addInst(builder.*.lir, component_gep)
        }
        var load = lir.initInst(lir.Opcode.load, lir.NONE)
        load.arg0 = component_address
        load.arg1 = if is_tag { 1 } else if tagged && component == 0 { storageWidth(builder, type_id) } else { 8 }
        if tagged && component == 0 && loadsSigned(builder, type_id) { load.arg2 = 1 }
        lir.addExtra(builder.*.lir, lir.addInst(builder.*.lir, load))
        component += 1
    }
    var result = lir.initInst(lir.Opcode.tuple_literal, type_id)
    result.arg0 = extra_start
    result.arg1 = word_count
    return lir.addInst(builder.*.lir, result)
}

fn isUnsupportedRuntimeBuiltin(kind: builtins.Kind) -> bool {
    return kind == builtins.Kind.splat || kind == builtins.Kind.shuffle || kind == builtins.Kind.reduce || kind == builtins.Kind.select
}

// The atomic builtins (sema/builtins/atomics.mlx, which checked the
// arguments): T is the first argument, the orders and the operation are
// names in the source and become the codes the backends read.
fn lowerAtomic(builder: *LirBuilder, node_index: usize, kind: builtins.Kind) -> usize {
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    var arguments: [6]usize = [6]usize{ ast.NONE, ast.NONE, ast.NONE, ast.NONE, ast.NONE, ast.NONE }
    var argument = node.lhs
    var count: usize = 0
    while argument != ast.NONE && count < 6 {
        arguments[count] = argument
        argument = ast_store.Store.get(nodes, argument).next
        count += 1
    }
    if count != atomics.arity(kind) { return lir.NONE }
    if kind == builtins.Kind.fence {
        var fence = lir.initInst(lir.Opcode.fence, lir.NONE)
        fence.arg0 = atomicName(builder, arguments[0], false)
        return lir.addInst(builder.*.lir, fence)
    }
    const value_type = resolveTypeNode(builder, arguments[0])
    if value_type == 0 { return lir.NONE }
    const width = types_store.Store.sizeOf(builder.*.typeStore, value_type)
    const signed: usize = if isSignedIntegerType(builder, value_type) { 1 } else { 0 }
    const address = lowerNode(builder, arguments[1])
    if address == lir.NONE { return lir.NONE }
    if kind == builtins.Kind.atomicLoad {
        var load = lir.initInst(lir.Opcode.atomic_load, value_type)
        load.arg0 = address
        load.arg1 = width
        load.arg2 = signed | (atomicName(builder, arguments[2], false) << 4)
        return lir.addInst(builder.*.lir, load)
    }
    if kind == builtins.Kind.atomicStore {
        const value = atomicOperand(builder, arguments[2], value_type)
        if value == lir.NONE { return lir.NONE }
        var store = lir.initInst(lir.Opcode.atomic_store, lir.NONE)
        store.arg0 = address
        store.arg1 = value
        store.arg2 = width | (atomicName(builder, arguments[3], false) << 8)
        return lir.addInst(builder.*.lir, store)
    }
    if kind == builtins.Kind.atomicRmw {
        const value = atomicOperand(builder, arguments[3], value_type)
        if value == lir.NONE { return lir.NONE }
        var rmw = lir.initInst(lir.Opcode.atomic_rmw, value_type)
        rmw.arg0 = address
        rmw.arg1 = value
        rmw.arg2 = width | (atomicName(builder, arguments[2], true) << 8) | (atomicName(builder, arguments[4], false) << 16) | (signed << 24)
        return lir.addInst(builder.*.lir, rmw)
    }
    // A compare-exchange: two words, whether it swapped and the value seen
    // (the expected one when it did), like a call's two result words.
    const expected = atomicOperand(builder, arguments[2], value_type)
    const replacement = atomicOperand(builder, arguments[3], value_type)
    if expected == lir.NONE || replacement == lir.NONE { return lir.NONE }
    var exchange = lir.initInst(lir.Opcode.cmpxchg, expressionType(builder, node_index))
    exchange.arg0 = address
    exchange.arg1 = expected
    exchange.arg2 = replacement
    var width_code: usize = 3
    if width == 1 { width_code = 0 } else if width == 2 { width_code = 1 } else if width == 4 { width_code = 2 }
    const weak: usize = if kind == builtins.Kind.cmpxchgWeak { 16 } else { 0 }
    // Bit 0 of flags is the optimizer's (lir.FLAG_RETAIN_NEXT).
    exchange.flags = @intCast(u8, (width_code << 1) | (signed << 3) | weak | (atomicName(builder, arguments[4], false) << 5))
    return lir.addInst(builder.*.lir, exchange)
}

// An order's or an operation's code from its name (0 when sema let an
// unknown one through, which it does not).
fn atomicName(builder: *LirBuilder, node_index: usize, operation: bool) -> usize {
    const node = ast_store.Store.get(getNodes(builder), node_index)
    const pointer = tokenPointer(builder, node.mainToken)
    const length = tokenLength(builder, node.mainToken)
    const code = if operation { atomics.opOf(pointer, length) } else { atomics.orderOf(pointer, length) }
    return if code == atomics.NONE { 0 } else { code }
}

// A value argument of an atomic, as a T.
// @spawnThread(flags, stack, parent_tid, child_tid, tls, entry, argument):
// the seven operands, the integers widened to usize, in extraData for the
// backends' clone sequence.
fn lowerSpawnThread(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    var arguments: [7]usize = [7]usize{ ast.NONE, ast.NONE, ast.NONE, ast.NONE, ast.NONE, ast.NONE, ast.NONE }
    var argument = node.lhs
    var count: usize = 0
    while argument != ast.NONE && count < 7 {
        arguments[count] = argument
        argument = ast_store.Store.get(nodes, argument).next
        count += 1
    }
    if count != 7 { return lir.NONE }
    const usize_type = types_store.Store.sizeInteger(builder.*.typeStore, false)
    var operands: [7]usize = [7]usize{ lir.NONE, lir.NONE, lir.NONE, lir.NONE, lir.NONE, lir.NONE, lir.NONE }
    var index: usize = 0
    while index < 7 {
        operands[index] = if index == 5 { lowerNode(builder, arguments[index]) } else { atomicOperand(builder, arguments[index], usize_type) }
        if operands[index] == lir.NONE { return lir.NONE }
        index += 1
    }
    const extra_start = lir.addExtra(builder.*.lir, operands[0])
    index = 1
    while index < 7 {
        const added = lir.addExtra(builder.*.lir, operands[index])
        index += 1
    }
    var spawn = lir.initInst(lir.Opcode.clone_thread, types_store.Store.sizeInteger(builder.*.typeStore, true))
    spawn.arg0 = extra_start
    spawn.arg1 = 7
    return lir.addInst(builder.*.lir, spawn)
}

fn atomicOperand(builder: *LirBuilder, node_index: usize, value_type: usize) -> usize {
    const value = lowerNode(builder, node_index)
    if value == lir.NONE { return lir.NONE }
    return widenToType(builder, narrowFloat(builder, value, value_type), value_type)
}

fn wideContext(builder: *LirBuilder) -> wide.Context {
    return wide.Context.{ .ir = builder.*.lir, .types = builder.*.typeStore, .blockCounter = &builder.*.blockCounter }
}

fn isWideType(builder: *LirBuilder, type_id: usize) -> bool {
    return wide.isWideType(builder.*.typeStore, type_id)
}

// A form of wide integer arithmetic the lowering does not expand (a
// width over 128 bits, a saturating or combined shift operator, a
// match on a wide value): reported at the operator.
fn recordUnsupportedWide(builder: *LirBuilder) -> void {
    recordUnsupportedBuiltin(builder, builder.*.operatorToken)
}

// `value` as the wide integer `type_id`, widened from one word by the
// sign of its own type (`source_type`, when known).
fn wideOperand(builder: *LirBuilder, value: usize, source_type: usize, type_id: usize) -> usize {
    var context = wideContext(builder)
    if !wide.isSupported(builder.*.typeStore, type_id) {
        recordUnsupportedWide(builder)
        return value
    }
    return wide.widen(&context, value, source_type, type_id)
}

fn recordUnsupportedBuiltin(builder: *LirBuilder, token_index: usize) -> void {
    if builder.*.unsupportedLoweringCount == 0 {
        builder.*.firstUnsupportedOffset = tokenStart(builder, token_index)
        builder.*.firstUnsupportedLength = tokenLength(builder, token_index)
        builder.*.firstUnsupportedModule = builder.*.currentModuleId
    }
    builder.*.unsupportedLoweringCount += 1
}

fn lowerBuiltin(builder: *LirBuilder, node_index: usize) -> usize {
    const node = ast_store.Store.get(getNodes(builder), node_index)
    const kind = builtins.lookup(builder.*.sourcePointer[0..builder.*.sourceLength], getTokens(builder).*, node.mainToken)
    if isUnsupportedRuntimeBuiltin(kind) {
        recordUnsupportedBuiltin(builder, node.mainToken)
        return lir.NONE
    }
    if atomics.isAtomic(kind) { return lowerAtomic(builder, node_index, kind) }
    if kind == builtins.Kind.threadPointer {
        return lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.thread_pointer, types_store.Store.sizeInteger(builder.*.typeStore, false)))
    }
    if kind == builtins.Kind.frameAddress {
        return lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.frame_address, types_store.Store.sizeInteger(builder.*.typeStore, false)))
    }
    if kind == builtins.Kind.spawnThread { return lowerSpawnThread(builder, node_index) }
    if kind == builtins.Kind.typeOf || kind == builtins.Kind.childType { return lir.NONE }
    if kind == builtins.Kind.sizeOf || kind == builtins.Kind.alignOf || kind == builtins.Kind.bitSizeOf || kind == builtins.Kind.fieldCount || kind == builtins.Kind.offsetOf ||
       kind == builtins.Kind.isArray || kind == builtins.Kind.isBool || kind == builtins.Kind.isCopyable || kind == builtins.Kind.isEnum || kind == builtins.Kind.isErrorUnion || kind == builtins.Kind.isFloat || kind == builtins.Kind.isInteger || kind == builtins.Kind.isOptional || kind == builtins.Kind.isPointer || kind == builtins.Kind.isSigned || kind == builtins.Kind.isSlice || kind == builtins.Kind.isStruct || kind == builtins.Kind.isTuple || kind == builtins.Kind.isUnion {
        const value = lowerComptimeValue(builder, node_index)
        if !comptime_module.isValid(value) { return lir.NONE }
        return lir.addInst(builder.*.lir, lir.constI(lir.NONE, @bitCast(usize, value.integer)))
    }
    if kind == builtins.Kind.languageVersion { return lir.addInst(builder.*.lir, lir.constI(lir.NONE, 10000)) }
    if node.lhs == ast.NONE { return lir.NONE }
    if kind == builtins.Kind.fieldName {
        const reflected_type = resolveTypeNode(builder, node.lhs)
        const selector_node = ast_store.Store.get(getNodes(builder), node.lhs).next
        const selector = lowerComptimeValue(builder, selector_node)
        if reflected_type == 0 || !comptime_module.isValid(selector) || selector.integer < 0 { return lir.NONE }
        const reflected = types_store.Store.get(builder.*.typeStore, reflected_type)
        const index = @intCast(usize, selector.integer)
        if index >= reflected.*.extraLength || (reflected.*.kind != types_store.Kind.struct_type && reflected.*.kind != types_store.Kind.union_type && reflected.*.kind != types_store.Kind.enum_type) { return lir.NONE }
        const field = types_store.Store.fieldAt(builder.*.typeStore, reflected.*.extraStart + index)
        const literal = lir.addStringLiteral(builder.*.lir, field.*.namePointer, field.*.nameLength)
        var result = lir.initInst(lir.Opcode.string_literal, expressionType(builder, node_index))
        result.arg0 = literal
        return lir.addInst(builder.*.lir, result)
    }
    if kind == builtins.Kind.field {
        const base_node_index = node.lhs
        const selector_node_index = ast_store.Store.get(getNodes(builder), base_node_index).next
        if selector_node_index == ast.NONE { return lir.NONE }
        const base_type_id = expressionType(builder, base_node_index)
        if base_type_id == 0 { return lir.NONE }
        const base_type = types_store.Store.get(builder.*.typeStore, base_type_id)
        const selector = lowerComptimeValue(builder, selector_node_index)
        if comptime_module.isValid(selector) && selector.integer >= 0 {
            const index = @intCast(usize, selector.integer)
            if base_type.*.kind == types_store.Kind.tuple {
                if index >= base_type.*.extraLength { return lir.NONE }
                const base = lowerNode(builder, base_node_index)
                const field_type = types_store.Store.extraAt(builder.*.typeStore, base_type.*.extraStart + index)
                return lowerFlatTupleField(builder, base, field_type, tupleFieldWordOffset(builder, base_type, index))
            }
            if index >= base_type.*.extraLength { return lir.NONE }
            const field = types_store.Store.fieldAt(builder.*.typeStore, base_type.*.extraStart + index)
            const base = lowerNode(builder, base_node_index)
            const offset = lir.addInst(builder.*.lir, lir.constI(lir.NONE, field.*.offset))
            var address = lir.initInst(lir.Opcode.gep, lir.NONE)
            address.arg0 = base
            address.arg1 = offset
            address.arg2 = 1
            const field_address = lir.addInst(builder.*.lir, address)
            return lowerMemoryValue(builder, field_address, field.*.typeId)
        }
        const name_node = ast_store.Store.get(getNodes(builder), selector_node_index)
        const name_length = tokenLength(builder, name_node.mainToken)
        if name_node.tag != ast.Tag.string_literal || name_length < 2 { return lir.NONE }
        unsafe {
            const quoted = tokenPointer(builder, name_node.mainToken)
            const name_pointer = @ptrFromInt([*]const u8, @intFromPtr(quoted) + 1)
            const metadata = fieldMetadataByName(builder, base_type_id, name_pointer, name_length - 2)
            if !metadata.found { return lir.NONE }
            const base = lowerNode(builder, base_node_index)
            const offset = lir.addInst(builder.*.lir, lir.constI(lir.NONE, metadata.offset))
            var address = lir.initInst(lir.Opcode.gep, lir.NONE)
            address.arg0 = base
            address.arg1 = offset
            address.arg2 = 1
            const field_address = lir.addInst(builder.*.lir, address)
            return lowerMemoryValue(builder, field_address, metadata.typeId)
        }
    }
    if kind == builtins.Kind.tagOf {
        const value_type_id = expressionType(builder, node.lhs)
        if value_type_id == 0 { return lir.NONE }
        const value_type = types_store.Store.get(builder.*.typeStore, value_type_id)
        if value_type.*.kind != types_store.Kind.union_type || value_type.*.backing == types_store.NONE { return lir.NONE }
        const base = lowerNode(builder, node.lhs)
        var load = lir.initInst(lir.Opcode.load, value_type.*.backing)
        load.arg0 = base
        load.arg1 = storageWidth(builder, value_type.*.backing)
        if isSignedIntegerType(builder, value_type.*.backing) { load.arg2 = 1 }
        return lir.addInst(builder.*.lir, load)
    }
    var argument = node.lhs
    if kind == builtins.Kind.ptrCast || kind == builtins.Kind.ptrFromInt || kind == builtins.Kind.intCast || kind == builtins.Kind.bitCast || kind == builtins.Kind.enumFromInt || kind == builtins.Kind.floatCast || kind == builtins.Kind.floatFromInt || kind == builtins.Kind.intFromFloat || kind == builtins.Kind.alignCast {
        const first = ast_store.Store.get(getNodes(builder), argument)
        if first.next != ast.NONE { argument = first.next }
    }
    if kind == builtins.Kind.intFromPtr || kind == builtins.Kind.intFromEnum || kind == builtins.Kind.move {
        const result = lowerNode(builder, argument)
        if kind == builtins.Kind.move { setBindingDropFlag(builder, argument, 0) }
        return result
    }
    if kind == builtins.Kind.popCount {
        const value = lowerNode(builder, argument)
        if value == lir.NONE { return lir.NONE }
        var instruction = lir.initInst(lir.Opcode.popcount, expressionType(builder, node_index))
        instruction.arg0 = value
        const operand_type = types_store.Store.get(builder.*.typeStore, expressionType(builder, argument))
        instruction.arg1 = operand_type.*.bits
        return lir.addInst(builder.*.lir, instruction)
    }
    if kind == builtins.Kind.sqrt {
        const value = lowerNode(builder, argument)
        if value == lir.NONE { return lir.NONE }
        var instruction = lir.initInst(lir.Opcode.sqrt, expressionType(builder, node_index))
        instruction.arg0 = value
        return lir.addInst(builder.*.lir, instruction)
    }
    if kind == builtins.Kind.floor || kind == builtins.Kind.ceil || kind == builtins.Kind.trunc {
        const value = lowerNode(builder, argument)
        if value == lir.NONE { return lir.NONE }
        var instruction = lir.initInst(lir.Opcode.round_float, expressionType(builder, node_index))
        instruction.arg0 = value
        instruction.arg1 = if kind == builtins.Kind.floor { 1 } else if kind == builtins.Kind.ceil { 2 } else { 3 }
        return lir.addInst(builder.*.lir, instruction)
    }
    if kind == builtins.Kind.byteMask64 {
        const needle_node = ast_store.Store.get(getNodes(builder), argument).next
        if needle_node == ast.NONE { return lir.NONE }
        const value = lowerNode(builder, argument)
        const needle = lowerNode(builder, needle_node)
        if value == lir.NONE || needle == lir.NONE { return lir.NONE }
        var instruction = lir.initInst(lir.Opcode.byte_mask_64, expressionType(builder, node_index))
        instruction.arg0 = value
        instruction.arg1 = needle
        return lir.addInst(builder.*.lir, instruction)
    }
    if kind == builtins.Kind.discardError {
        // Discarding an error changes only how the result is handled; the
        // operand must still execute for its ordinary runtime side effects.
        return lowerNode(builder, argument)
    }
    if kind == builtins.Kind.ptrCast || kind == builtins.Kind.ptrFromInt || kind == builtins.Kind.intCast || kind == builtins.Kind.bitCast || kind == builtins.Kind.enumFromInt || kind == builtins.Kind.floatCast || kind == builtins.Kind.floatFromInt || kind == builtins.Kind.intFromFloat || kind == builtins.Kind.alignCast {
        const value = lowerNode(builder, argument)
        if value == lir.NONE { return lir.NONE }
        const result_type_id = expressionType(builder, node_index)
        if result_type_id != 0 {
            const result_type = types_store.Store.get(builder.*.typeStore, result_type_id)
            if result_type.*.kind == types_store.Kind.slice || result_type.*.kind == types_store.Kind.tuple { return value }
        }
        var context = wideContext(builder)
        const source_type_id = expressionType(builder, argument)
        if (kind == builtins.Kind.intCast || kind == builtins.Kind.bitCast) && (isWideType(builder, result_type_id) || wide.isWideValue(&context, value)) {
            // To a wide integer: widened by the source's sign, then made
            // the result's width; from one: the low bits as the result.
            builder.*.operatorToken = node.mainToken
            if isWideType(builder, result_type_id) {
                const widened = wideOperand(builder, value, source_type_id, result_type_id)
                if !wide.isSupported(builder.*.typeStore, result_type_id) { return widened }
                return wide.convert(&context, widened, result_type_id)
            }
            if !wide.isSupported(builder.*.typeStore, lir.getInst(builder.*.lir, value).typeId) || !isIntegerKind(builder, result_type_id) {
                recordUnsupportedWide(builder)
                return value
            }
            return wide.narrow(&context, value, result_type_id)
        }
        if (kind == builtins.Kind.floatFromInt || kind == builtins.Kind.intFromFloat) && (isWideType(builder, result_type_id) || wide.isWideValue(&context, value)) {
            builder.*.operatorToken = node.mainToken
            recordUnsupportedWide(builder)
            return value
        }
        var conversion = lir.initInst(if kind == builtins.Kind.bitCast || kind == builtins.Kind.ptrCast || kind == builtins.Kind.ptrFromInt || kind == builtins.Kind.enumFromInt || kind == builtins.Kind.alignCast { lir.Opcode.bitcast } else { lir.Opcode.cast }, result_type_id)
        conversion.arg0 = value
        // The semantic type of an untyped literal may already reflect the
        // builtin's destination through contextual coercion.  The emitted LIR
        // value retains the actual source representation used by codegen.
        conversion.arg1 = lir.getInst(builder.*.lir, value).typeId
        const converted = lir.addInst(builder.*.lir, conversion)
        if kind == builtins.Kind.intCast || kind == builtins.Kind.bitCast { return extendAsType(builder, converted, expressionType(builder, argument), result_type_id) }
        return converted
    }
    return lir.NONE
}

// An integer narrower than 64 bits keeps the rest of its register as its
// type extends it: zeros when unsigned, copies of the sign when signed.
// A cast that changes the signedness without widening must extend again,
// or a later widening carries the old rule over (-3 as an i32 bit-cast to
// u32 and widened to u64 would stay 0xFFFF_FFFF_FFFF_FFFD).
fn extendAsType(builder: *LirBuilder, value: usize, source_type_id: usize, result_type_id: usize) -> usize {
    if source_type_id == 0 || result_type_id == 0 { return value }
    const source_type = types_store.Store.get(builder.*.typeStore, source_type_id)
    const result_type = types_store.Store.get(builder.*.typeStore, result_type_id)
    if result_type.*.kind != types_store.Kind.integer { return value }
    const bits = integerBitWidth(builder, result_type_id)
    const result_signed = result_type.*.flags & types_store.FLAG_SIGNED != 0
    // The bits of a float moved to a general register (`@bitCast(u32,
    // f32_value)`) come with whatever the register's high half held: a
    // narrow result is extended as its type says.
    if source_type.*.kind == types_store.Kind.float || source_type.*.kind == types_store.Kind.comptime_float_type {
        if bits >= 64 { return value }
        if !result_signed { return maskInteger(builder, value, result_type_id) }
        const float_shift = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 64 - bits))
        const float_raised = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.shl, result_type_id, value, float_shift))
        return lir.addInst(builder.*.lir, lir.binary(lir.Opcode.shr, result_type_id, float_raised, float_shift))
    }
    if source_type.*.kind != types_store.Kind.integer { return value }
    if bits >= 64 || bits > integerBitWidth(builder, source_type_id) || result_signed == (source_type.*.flags & types_store.FLAG_SIGNED != 0) { return value }
    if !result_signed { return maskInteger(builder, value, result_type_id) }
    const shift = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 64 - bits))
    const raised = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.shl, result_type_id, value, shift))
    return lir.addInst(builder.*.lir, lir.binary(lir.Opcode.shr, result_type_id, raised, shift))
}

fn lowerFieldAddress(builder: *LirBuilder, node_index: usize) -> usize {
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag != ast.Tag.field_expression || node.lhs == ast.NONE { return lir.NONE }
    const base_type = expressionType(builder, node.lhs)
    if base_type == 0 { return lir.NONE }
    const metadata = fieldMetadata(builder, base_type, node.mainToken)
    if !metadata.found { return lir.NONE }
    const base = lowerNode(builder, node.lhs)
    if base == lir.NONE { return lir.NONE }
    const offset = lir.addInst(builder.*.lir, lir.constI(lir.NONE, metadata.offset))
    var address = lir.initInst(lir.Opcode.gep, lir.NONE)
    address.arg0 = base
    address.arg1 = offset
    address.arg2 = 1
    return lir.addInst(builder.*.lir, address)
}

fn lowerIndexAddress(builder: *LirBuilder, node_index: usize) -> usize {
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag != ast.Tag.index_expression { return lir.NONE }
    const container_type_id = expressionType(builder, node.lhs)
    if container_type_id == 0 { return lir.NONE }
    const container_type = types_store.Store.get(builder.*.typeStore, container_type_id)
    var element_type: usize = 0
    if container_type.*.kind == types_store.Kind.array || container_type.*.kind == types_store.Kind.slice || container_type.*.kind == types_store.Kind.many_pointer { element_type = container_type.*.lhs }
    if element_type == 0 { return lir.NONE }
    var stride = types_store.Store.sizeOf(builder.*.typeStore, element_type)
    if stride == 0 { stride = 1 }
    const base = lowerNode(builder, node.lhs)
    const index = lowerNode(builder, node.rhs)
    if builder.*.runtimeSafety {
        var length = lir.NONE
        if container_type.*.kind == types_store.Kind.array {
            length = lir.addInst(builder.*.lir, lir.constI(types_store.Store.sizeInteger(builder.*.typeStore, false), container_type.*.bits))
        } else if container_type.*.kind == types_store.Kind.slice {
            var length_extract = lir.initInst(lir.Opcode.tuple_element, types_store.Store.sizeInteger(builder.*.typeStore, false))
            length_extract.arg0 = base
            length_extract.arg1 = 1
            length = lir.addInst(builder.*.lir, length_extract)
        }
        if length != lir.NONE {
            const invalid = emitComparison(builder, lir.CmpPredicate.uge, index, length)
            emitTrapIf(builder, invalid)
        }
    }
    var address = lir.initInst(lir.Opcode.gep, lir.NONE)
    address.arg0 = base
    address.arg1 = index
    address.arg2 = stride
    return lir.addInst(builder.*.lir, address)
}

fn lowerSymbolValue(builder: *LirBuilder, symbol_index: usize, symbol: *symbol_module.Symbol, module_id: usize) -> usize {
    if symbol.*.comptimeTag == @intCast(u8, @intFromEnum(comptime_value.Kind.integer)) || symbol.*.comptimeTag == @intCast(u8, @intFromEnum(comptime_value.Kind.boolean)) {
        return lir.addInst(builder.*.lir, lir.constI(lir.NONE, @bitCast(usize, symbol.*.comptimeInteger)))
    }
    if symbol.*.flags & symbol_module.FLAG_FUNCTION != 0 {
        var sym_id = if symbol_index < builder.*.lirSymbolCapacity { builder.*.lirSymbolIds[symbol_index] } else { lir.NONE }
        if sym_id == lir.NONE {
            const is_entry = (module_id == 0 && isMainName(symbol.*.namePointer, symbol.*.nameLength)) || hasPlainSymbolName(symbol)
            sym_id = if symbol.*.ownerTypeId == 0 { lir.addModuleSymbol(builder.*.lir, module_id, symbol.*.namePointer, symbol.*.nameLength, is_entry) } else { lir.addMethodSymbol(builder.*.lir, module_id, symbol.*.ownerTypeId, symbol.*.namePointer, symbol.*.nameLength) }
            recordLinkage(builder, sym_id, symbol)
            if symbol_index < builder.*.lirSymbolCapacity { builder.*.lirSymbolIds[symbol_index] = sym_id }
        }
        var function_inst = lir.initInst(lir.Opcode.func_sym, lir.NONE)
        function_inst.arg0 = sym_id
        return lir.addInst(builder.*.lir, function_inst)
    }
    if isGlobalSymbol(symbol) { return lowerGlobalValue(builder, symbol_index, symbol) }
    return lowerConstantInitializer(builder, symbol, module_id)
}

// A module-level constant the comptime evaluator has no value for lowers
// to its initializer, in its own module, where it is used: a string to its
// literal (emitted with the program's other literals), a float to its
// constant, a struct, array or tuple literal (slices in it too) to a value
// built there. The initializer gets bindings of its own while it is
// lowered: a local of the using function must not stand in for a name of
// the constant's module.
fn lowerConstantInitializer(builder: *LirBuilder, symbol: *symbol_module.Symbol, module_id: usize) -> usize {
    if symbol.*.declaration == ast.NONE { return lir.NONE }
    const type_id = symbol.*.typeId
    const previous_module = builder.*.currentModuleId
    if module_id != previous_module { switchToModule(builder, module_id) }
    var result = lir.NONE
    const nodes = getNodes(builder)
    if symbol.*.declaration < nodes.*.length {
        const declaration = ast_store.Store.get(nodes, symbol.*.declaration)
        if declaration.tag == ast.Tag.constant_declaration && declaration.rhs != ast.NONE {
            const initializer = ast_store.Store.get(nodes, declaration.rhs)
            if initializer.tag == ast.Tag.string_literal {
                result = lowerStringLiteral(builder, initializer.mainToken)
            } else if initializer.tag == ast.Tag.float_literal || initializer.tag == ast.Tag.unary_expression || initializer.tag == ast.Tag.binary_expression || initializer.tag == ast.Tag.aggregate_literal || initializer.tag == ast.Tag.array_literal || initializer.tag == ast.Tag.tuple_literal {
                var own_bindings: vector.Vector = undefined
                vector.Vector.initAt(&own_bindings, builder.*.allocator, @sizeOf(Binding), @alignOf(Binding), 4)
                const saved_bindings = builder.*.bindings
                const components_length = builder.*.bindingComponents.*.length
                builder.*.bindings = &own_bindings
                result = widenToType(builder, narrowFloat(builder, lowerNode(builder, declaration.rhs), type_id), type_id)
                builder.*.bindings = saved_bindings
                builder.*.bindingComponents.*.length = components_length
                vector.Vector.deinit(own_bindings)
            }
        }
    }
    if module_id != previous_module { switchToModule(builder, previous_module) }
    return result
}

fn referencedSymbolIndex(builder: *LirBuilder, node_index: usize) -> (bool, usize) {
    if node_index == ast.NONE { return -> (false, 0) }
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    if !hasScope(builder) { return -> (false, 0) }
    unsafe {
        const scope = currentScope(builder)
        if node.tag == ast.Tag.identifier || node.tag == ast.Tag.named_type {
            // In a method, a bare name is first a member of the owner (a
            // helper function, a constant) or of an aggregate enclosing
            // it, as its scope has it.
            const member_index = ownerMemberIndex(builder, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
            if member_index != lir.NONE { return -> (true, member_index) }
            return scope_module.Scope.lookup(scope, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
        }
        if node.tag == ast.Tag.field_expression && node.lhs != ast.NONE {
            const base_node = ast_store.Store.get(nodes, node.lhs)
            if builder.*.currentMethodOwner != lir.NONE && (base_node.tag == ast.Tag.identifier || base_node.tag == ast.Tag.named_type) {
                const base_pointer = tokenPointer(builder, base_node.mainToken)
                const base_length = tokenLength(builder, base_node.mainToken)
                if base_length == 4 && mem.eql(base_pointer, @ptrCast([*]const u8, "Self"), 4) {
                    const method_index = aggregateMethodIndex(builder, builder.*.currentMethodOwner, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
                    return -> (method_index != lir.NONE, method_index)
                }
            }
            // `Box(u32).init(...)`, and `T.init(...)` on a comptime type
            // parameter: a method of the type the base stands for.
            var base_type_value: usize = 0
            if base_node.tag == ast.Tag.call_expression {
                base_type_value = resolveTypeNode(builder, node.lhs)
            } else if base_node.tag == ast.Tag.identifier || base_node.tag == ast.Tag.named_type {
                const base_binding = findBindingRecord(builder, tokenPointer(builder, base_node.mainToken), tokenLength(builder, base_node.mainToken))
                if @intFromPtr(base_binding) != 0 && base_binding.*.valueTypeId != 0 { base_type_value = base_binding.*.valueTypeId }
            }
            if base_type_value != 0 {
                const base_value = types_store.Store.get(builder.*.typeStore, base_type_value)
                if base_value.*.kind == types_store.Kind.struct_type || base_value.*.kind == types_store.Kind.enum_type || base_value.*.kind == types_store.Kind.union_type {
                    const method_index = aggregateMethodIndex(builder, base_type_value, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
                    return -> (method_index != lir.NONE, method_index)
                }
            }
            const base_found = referencedSymbolIndex(builder, node.lhs)
            if !base_found.0 {
                const field_pointer = tokenPointer(builder, node.mainToken)
                const field_length = tokenLength(builder, node.mainToken)
                const base_type_id = expressionType(builder, node.lhs)
                if base_type_id == 0 { return -> (false, 0) }
                const base_type = types_store.Store.get(builder.*.typeStore, base_type_id)
                if base_type.*.kind == types_store.Kind.struct_type || base_type.*.kind == types_store.Kind.enum_type || base_type.*.kind == types_store.Kind.union_type {
                    const method_index = aggregateMethodIndex(builder, base_type_id, field_pointer, field_length)
                    return -> (method_index != lir.NONE, method_index)
                }
                if (base_type.*.kind == types_store.Kind.pointer || base_type.*.kind == types_store.Kind.many_pointer) && base_type.*.lhs != 0 {
                    const method_index = aggregateMethodIndex(builder, base_type.*.lhs, field_pointer, field_length)
                    return -> (method_index != lir.NONE, method_index)
                }
                return -> (false, 0)
            }
            const base_symbol = symbols_store.Store.get(builder.*.symbolStore, base_found.1)
            const base_type = types_store.Store.get(builder.*.typeStore, base_symbol.*.typeId)
            const field_pointer = tokenPointer(builder, node.mainToken)
            const field_length = tokenLength(builder, node.mainToken)
            if base_type.*.kind == types_store.Kind.type_type && base_symbol.*.valueTypeId != 0 {
                const method_index = aggregateMethodIndex(builder, base_symbol.*.valueTypeId, field_pointer, field_length)
                if method_index != lir.NONE { return -> (true, method_index) }
            }
            if base_type.*.kind == types_store.Kind.struct_type || base_type.*.kind == types_store.Kind.enum_type || base_type.*.kind == types_store.Kind.union_type {
                const method_index = aggregateMethodIndex(builder, base_symbol.*.typeId, field_pointer, field_length)
                if method_index != lir.NONE { return -> (true, method_index) }
            }
            if (base_type.*.kind == types_store.Kind.pointer || base_type.*.kind == types_store.Kind.many_pointer) && base_type.*.lhs != 0 {
                const method_index = aggregateMethodIndex(builder, base_type.*.lhs, field_pointer, field_length)
                if method_index != lir.NONE { return -> (true, method_index) }
            }
            if base_type.*.kind != types_store.Kind.module { return -> (false, 0) }
            var declaration_index: usize = 0
            while declaration_index < base_type.*.extraLength {
                const symbol_index = types_store.Store.extraAt(builder.*.typeStore, base_type.*.extraStart + declaration_index)
                const declaration = symbols_store.Store.get(builder.*.symbolStore, symbol_index)
                if declaration.*.nameLength == field_length && mem.eql(declaration.*.namePointer, field_pointer, field_length) { return -> (true, symbol_index) }
                declaration_index += 1
            }
        }
    }
    return -> (false, 0)
}

fn aggregateMethodIndex(builder: *LirBuilder, owner_type: usize, pointer: [*]const u8, length: usize) -> usize {
    const found = symbols_store.Store.aggregateMethod(builder.*.symbolStore, owner_type, pointer, length)
    if found.0 { return found.1 }
    if owner_type == 0 { return lir.NONE }
    // A method of an equal owner with another type id: among the methods
    // of that name (the store's index by name), the first declared.
    const owner = types_store.Store.get(builder.*.typeStore, owner_type)
    const store = builder.*.symbolStore
    var at = symbols_store.Store.firstNamed(store, pointer, length)
    while at != 0 {
        const index = at - 1
        const candidate_owner = types_store.Store.get(builder.*.typeStore, symbols_store.Store.get(store, index).*.ownerTypeId)
        if candidate_owner.*.kind == owner.*.kind && candidate_owner.*.bits == owner.*.bits { return index }
        at = symbols_store.Store.nextNamed(store, index)
    }
    return lir.NONE
}

// A member (a method, a constant) of the aggregate whose method is being
// lowered, or of one enclosing it, by name: its symbol, or NONE.
fn ownerMemberIndex(builder: *LirBuilder, pointer: [*]const u8, length: usize) -> usize {
    if builder.*.currentMethodOwner == lir.NONE { return lir.NONE }
    const direct = aggregateMethodIndex(builder, builder.*.currentMethodOwner, pointer, length)
    if direct != lir.NONE { return direct }
    var level = builder.*.enclosingOwnerCount
    while level > 0 {
        level -= 1
        const enclosing = aggregateMethodIndex(builder, builder.*.enclosingOwners[level], pointer, length)
        if enclosing != lir.NONE { return enclosing }
    }
    return lir.NONE
}

fn aggregateTypeFromPrefix(builder: *LirBuilder, node_index: usize) -> usize {
    if node_index != ast.NONE && builder.*.currentMethodOwner != lir.NONE {
        const node = ast_store.Store.get(getNodes(builder), node_index)
        if node.tag == ast.Tag.identifier || node.tag == ast.Tag.named_type {
            const pointer = tokenPointer(builder, node.mainToken)
            const length = tokenLength(builder, node.mainToken)
            unsafe {
                if length == 4 && mem.eql(pointer, @ptrCast([*]const u8, "Self"), 4) { return builder.*.currentMethodOwner }
            }
        }
    }
    const referenced = referencedSymbolIndex(builder, node_index)
    if !referenced.0 { return resolveTypeNode(builder, node_index) }
    return symbols_store.Store.get(builder.*.symbolStore, referenced.1).*.valueTypeId
}

fn fieldMetadataByName(builder: *LirBuilder, type_id: usize, name_pointer: [*]const u8, name_length: usize) -> FieldMetadata {
    if type_id == 0 { return FieldMetadata.{ .found = false, .typeId = 0, .offset = 0 } }
    var aggregate_id = type_id
    var aggregate = types_store.Store.get(builder.*.typeStore, aggregate_id)
    if aggregate.*.kind == types_store.Kind.pointer || aggregate.*.kind == types_store.Kind.many_pointer {
        aggregate_id = aggregate.*.lhs
        aggregate = types_store.Store.get(builder.*.typeStore, aggregate_id)
    }
    if aggregate.*.kind != types_store.Kind.struct_type && aggregate.*.kind != types_store.Kind.union_type { return FieldMetadata.{ .found = false, .typeId = 0, .offset = 0 } }
    var index: usize = 0
    while index < aggregate.*.extraLength {
        const field = types_store.Store.fieldAt(builder.*.typeStore, aggregate.*.extraStart + index)
        if field.*.nameLength == name_length && mem.eql(field.*.namePointer, name_pointer, name_length) { return FieldMetadata.{ .found = true, .typeId = field.*.typeId, .offset = field.*.offset } }
        index += 1
    }
    return FieldMetadata.{ .found = false, .typeId = 0, .offset = 0 }
}

fn fieldMetadata(builder: *LirBuilder, type_id: usize, field_token: usize) -> FieldMetadata {
    return fieldMetadataByName(builder, type_id, tokenPointer(builder, field_token), tokenLength(builder, field_token))
}

fn expressionType(builder: *LirBuilder, node_index: usize) -> usize {
    if node_index == ast.NONE { return 0 }
    builder.*.expressionTypeQueries += 1
    // A node's type is the same wherever it is lowered, except in a
    // generic function's instances and in a generic type instance's methods
    // (scopeOverride): the same nodes, another T.
    const cacheable = builder.*.currentGenericInstance == lir.NONE && builder.*.scopeOverride == 0 && node_index < builder.*.typeCacheCapacity
    const cache = typeCacheEntry(builder, node_index)
    const module_key = @intCast(u32, builder.*.currentModuleId + 1)
    if cacheable && cache.*.expressionModule == module_key {
        builder.*.expressionTypeHits += 1
        return @intCast(usize, cache.*.expressionTypeId)
    }
    const result = expressionTypeUncached(builder, node_index)
    if cacheable && result != 0 {
        cache.*.expressionModule = module_key
        cache.*.expressionTypeId = @intCast(u32, result)
    }
    return result
}

fn expressionTypeUncached(builder: *LirBuilder, node_index: usize) -> usize {
    if node_index == ast.NONE { return 0 }
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.unsafe_expression { return expressionType(builder, node.lhs) }
    if node.tag == ast.Tag.identifier || node.tag == ast.Tag.named_type {
        const pointer = tokenPointer(builder, node.mainToken)
        const length = tokenLength(builder, node.mainToken)
        const binding = findBindingRecord(builder, pointer, length)
        if @intFromPtr(binding) != 0 && binding.*.typeId != 0 { return binding.*.typeId }
        const referenced = referencedSymbolIndex(builder, node_index)
        if referenced.0 { return symbols_store.Store.get(builder.*.symbolStore, referenced.1).*.typeId }
        return 0
    }
    if node.tag == ast.Tag.tuple_literal {
        const elements_start = builder.*.typeStore.*.extraIds.*.length
        var reserved: usize = 0
        while reserved < node.rhs {
            types_store.Store.appendExtra(builder.*.typeStore, 0)
            reserved += 1
        }
        var child = node.lhs
        var count: usize = 0
        while child != ast.NONE && count < node.rhs {
            const element_type = expressionType(builder, child)
            if element_type == 0 { return 0 }
            types_store.Store.setExtra(builder.*.typeStore, elements_start + count, element_type)
            child = ast_store.Store.get(nodes, child).next
            count += 1
        }
        if count != node.rhs { return 0 }
        return types_store.Store.tuple(builder.*.typeStore, elements_start, count)
    }
    if node.tag == ast.Tag.aggregate_literal { return aggregateTypeFromPrefix(builder, node.lhs) }
    if node.tag == ast.Tag.array_literal {
        const element_type = resolveTypeNode(builder, node.endToken)
        if element_type == 0 { return 0 }
        return types_store.Store.array(builder.*.typeStore, element_type, node.rhs)
    }
    if node.tag == ast.Tag.call_expression {
        const referenced = referencedSymbolIndex(builder, node.lhs)
        var function_type_id: usize = 0
        if referenced.0 && declarations.isTypeFunction(builder.*.typeStore, symbols_store.Store.get(builder.*.symbolStore, referenced.1)) {
            return types_store.Store.primitive(builder.*.typeStore, types_store.Kind.type_type)
        }
        if referenced.0 {
            const instance_id = ensureGenericInstance(builder, node_index, referenced.1)
            if instance_id != lir.NONE {
                function_type_id = genericInstanceAt(builder, instance_id).*.functionTypeId
            } else {
                function_type_id = symbols_store.Store.get(builder.*.symbolStore, referenced.1).*.typeId
            }
        } else {
            function_type_id = expressionType(builder, node.lhs)
        }
        if function_type_id == 0 { return 0 }
        const function_type = types_store.Store.get(builder.*.typeStore, function_type_id)
        if function_type.*.kind == types_store.Kind.function { return function_type.*.lhs }
        return 0
    }
    if node.tag == ast.Tag.builtin_call {
        const kind = builtins.lookup(builder.*.sourcePointer[0..builder.*.sourceLength], getTokens(builder).*, node.mainToken)
        if kind == builtins.Kind.typeOf || kind == builtins.Kind.childType || kind == builtins.Kind.fieldType || kind == builtins.Kind.typeInfo || kind == builtins.Kind.decl {
            return types_store.Store.primitive(builder.*.typeStore, types_store.Kind.type_type)
        }
        if kind == builtins.Kind.sqrt || kind == builtins.Kind.floor || kind == builtins.Kind.ceil || kind == builtins.Kind.trunc {
            const operand_type = expressionType(builder, node.lhs)
            if operand_type == 0 { return 0 }
            if types_store.Store.get(builder.*.typeStore, operand_type).*.kind == types_store.Kind.comptime_float_type { return types_store.Store.float(builder.*.typeStore, 64) }
            return operand_type
        }
        if kind == builtins.Kind.fieldName { return types_store.Store.slice(builder.*.typeStore, types_store.Store.integer(builder.*.typeStore, false, 8), true) }
        if kind == builtins.Kind.ptrCast || kind == builtins.Kind.ptrFromInt || kind == builtins.Kind.intCast || kind == builtins.Kind.bitCast || kind == builtins.Kind.enumFromInt || kind == builtins.Kind.floatCast || kind == builtins.Kind.floatFromInt || kind == builtins.Kind.intFromFloat || kind == builtins.Kind.alignCast {
            return resolveTypeNode(builder, node.lhs)
        }
        if kind == builtins.Kind.intFromPtr || kind == builtins.Kind.intFromEnum || kind == builtins.Kind.popCount || kind == builtins.Kind.byteMask64 || kind == builtins.Kind.sizeOf || kind == builtins.Kind.alignOf || kind == builtins.Kind.bitSizeOf || kind == builtins.Kind.offsetOf || kind == builtins.Kind.fieldCount || kind == builtins.Kind.languageVersion {
            return types_store.Store.sizeInteger(builder.*.typeStore, false)
        }
        if kind == builtins.Kind.isArray || kind == builtins.Kind.isBool || kind == builtins.Kind.isCopyable || kind == builtins.Kind.isEnum || kind == builtins.Kind.isErrorUnion || kind == builtins.Kind.isFloat || kind == builtins.Kind.isInteger || kind == builtins.Kind.isOptional || kind == builtins.Kind.isPointer || kind == builtins.Kind.isSigned || kind == builtins.Kind.isSlice || kind == builtins.Kind.isStruct || kind == builtins.Kind.isTuple || kind == builtins.Kind.isUnion || kind == builtins.Kind.hasDecl || kind == builtins.Kind.hasField {
            return types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type)
        }
        if kind == builtins.Kind.field && node.lhs != ast.NONE {
            const base_type = expressionType(builder, node.lhs)
            if base_type == 0 { return 0 }
            const selector = ast_store.Store.get(nodes, node.lhs).next
            const selector_value = lowerComptimeValue(builder, selector)
            if !comptime_module.isValid(selector_value) { return 0 }
            const base = types_store.Store.get(builder.*.typeStore, base_type)
            if base.*.kind == types_store.Kind.tuple && selector_value.integer >= 0 && @intCast(usize, selector_value.integer) < base.*.extraLength {
                return types_store.Store.extraAt(builder.*.typeStore, base.*.extraStart + @intCast(usize, selector_value.integer))
            }
            if (base.*.kind == types_store.Kind.struct_type || base.*.kind == types_store.Kind.union_type) && selector_value.integer >= 0 && @intCast(usize, selector_value.integer) < base.*.extraLength {
                return types_store.Store.fieldAt(builder.*.typeStore, base.*.extraStart + @intCast(usize, selector_value.integer)).*.typeId
            }
            return 0
        }
        if kind == builtins.Kind.move && node.lhs != ast.NONE { return expressionType(builder, node.lhs) }
        // The atomics: T (the first argument) for a load and a read-modify-
        // write, (bool, T) for a compare-exchange, nothing for the rest.
        if kind == builtins.Kind.atomicLoad || kind == builtins.Kind.atomicRmw { return resolveTypeNode(builder, node.lhs) }
        if atomics.isCompareExchange(kind) {
            const value_type = resolveTypeNode(builder, node.lhs)
            if value_type == 0 { return 0 }
            const elements_start = types_store.Store.appendExtra(builder.*.typeStore, types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type))
            const appended = types_store.Store.appendExtra(builder.*.typeStore, value_type)
            return types_store.Store.tuple(builder.*.typeStore, elements_start, 2)
        }
        if kind == builtins.Kind.atomicStore || kind == builtins.Kind.fence { return types_store.Store.primitive(builder.*.typeStore, types_store.Kind.void_type) }
        if kind == builtins.Kind.threadPointer || kind == builtins.Kind.frameAddress { return types_store.Store.sizeInteger(builder.*.typeStore, false) }
        if kind == builtins.Kind.spawnThread { return types_store.Store.sizeInteger(builder.*.typeStore, true) }
        return 0
    }
    if node.tag == ast.Tag.field_expression && node.lhs != ast.NONE {
        // A member selected from an enum or error-set type has the aggregate
        // type, not the integer backing type. This distinction controls
        // error-union return lowering (tag in rax, payload in rdx).
        const referenced_base = referencedSymbolIndex(builder, node.lhs)
        if referenced_base.0 {
            const base_symbol = symbols_store.Store.get(builder.*.symbolStore, referenced_base.1)
            const base_symbol_type = types_store.Store.get(builder.*.typeStore, base_symbol.*.typeId)
            if base_symbol_type.*.kind == types_store.Kind.type_type && base_symbol.*.valueTypeId != 0 {
                const reflected = types_store.Store.get(builder.*.typeStore, base_symbol.*.valueTypeId)
                if reflected.*.kind == types_store.Kind.enum_type || reflected.*.kind == types_store.Kind.error_set {
                    const field_pointer = tokenPointer(builder, node.mainToken)
                    const field_length = tokenLength(builder, node.mainToken)
                    var field_index: usize = 0
                    while field_index < reflected.*.extraLength {
                        const field = types_store.Store.fieldAt(builder.*.typeStore, reflected.*.extraStart + field_index)
                        if field.*.nameLength == field_length && mem.eql(field.*.namePointer, field_pointer, field_length) { return base_symbol.*.valueTypeId }
                        field_index += 1
                    }
                }
            }
        }
        const referenced = referencedSymbolIndex(builder, node_index)
        if referenced.0 { return symbols_store.Store.get(builder.*.symbolStore, referenced.1).*.typeId }
        const base_type = expressionType(builder, node.lhs)
        const metadata = fieldMetadata(builder, base_type, node.mainToken)
        if metadata.found { return metadata.typeId }
        const base = types_store.Store.get(builder.*.typeStore, base_type)
        // `pair.1`: the tuple's part; a local made from it takes the part's
        // words (a slice its two).
        if base.*.kind == types_store.Kind.tuple && tokenKind(builder, node.mainToken) == lexer.Kind.integer {
            const part = lowerIntValue(builder, node.mainToken)
            if part < base.*.extraLength { return types_store.Store.extraAt(builder.*.typeStore, base.*.extraStart + part) }
        }
        if base.*.kind == types_store.Kind.slice && isSlicePointerField(builder, node.mainToken) {
            const element = base.*.lhs
            const constant = base.*.flags & types_store.FLAG_CONSTANT != 0
            return types_store.Store.pointer(builder.*.typeStore, element, constant, false, true)
        }
        if base.*.kind == types_store.Kind.slice || base.*.kind == types_store.Kind.array { return types_store.Store.sizeInteger(builder.*.typeStore, false) }
        return 0
    }
    if node.tag == ast.Tag.unary_expression {
        const operand_type = expressionType(builder, node.lhs)
        if operand_type == 0 { return 0 }
        const kind = tokenKind(builder, node.mainToken)
        const operand = types_store.Store.get(builder.*.typeStore, operand_type)
        if kind == lexer.Kind.dot_asterisk && (operand.*.kind == types_store.Kind.pointer || operand.*.kind == types_store.Kind.many_pointer) { return operand.*.lhs }
        if kind == lexer.Kind.dot_question && operand.*.kind == types_store.Kind.optional { return operand.*.lhs }
        // `try value` is the payload: a binding made from it (a struct, an
        // array, a slice) has the payload's type and words, not the error
        // union's two.
        if kind == lexer.Kind.keyword_try && operand.*.kind == types_store.Kind.error_union { return operand.*.rhs }
        if kind == lexer.Kind.ampersand { return types_store.Store.pointer(builder.*.typeStore, operand_type, false, false, false) }
        return operand_type
    }
    if node.tag == ast.Tag.index_expression {
        const container_type = expressionType(builder, node.lhs)
        if container_type == 0 { return 0 }
        const container = types_store.Store.get(builder.*.typeStore, container_type)
        if container.*.kind == types_store.Kind.array || container.*.kind == types_store.Kind.slice || container.*.kind == types_store.Kind.many_pointer { return container.*.lhs }
        return 0
    }
    if node.tag == ast.Tag.slice_expression {
        const container_type = expressionType(builder, node.lhs)
        if container_type == 0 { return 0 }
        const container = types_store.Store.get(builder.*.typeStore, container_type)
        if (container.*.kind != types_store.Kind.array && container.*.kind != types_store.Kind.slice && container.*.kind != types_store.Kind.many_pointer) { return 0 }
        return types_store.Store.slice(builder.*.typeStore, container.*.lhs, container.*.flags & types_store.FLAG_CONSTANT != 0)
    }
    if node.tag == ast.Tag.boolean_literal { return types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type) }
    if node.tag == ast.Tag.integer_literal || node.tag == ast.Tag.character_literal { return types_store.Store.primitive(builder.*.typeStore, types_store.Kind.comptime_int_type) }
    // A float literal is a comptime float: arithmetic on two of them is
    // float arithmetic (it was untyped, and the backend added the bit
    // patterns as integers: 1.0 / 255.0 came out 0).
    if node.tag == ast.Tag.float_literal { return types_store.Store.primitive(builder.*.typeStore, types_store.Kind.comptime_float_type) }
    if node.tag == ast.Tag.string_literal || node.tag == ast.Tag.byte_string_literal {
        return types_store.Store.slice(builder.*.typeStore, types_store.Store.integer(builder.*.typeStore, false, 8), true)
    }
    if node.tag == ast.Tag.binary_expression {
        const kind = tokenKind(builder, node.mainToken)
        if kind == lexer.Kind.equal_equal || kind == lexer.Kind.bang_equal || kind == lexer.Kind.less || kind == lexer.Kind.less_equal || kind == lexer.Kind.greater || kind == lexer.Kind.greater_equal || kind == lexer.Kind.ampersand_ampersand || kind == lexer.Kind.pipe_pipe {
            return types_store.Store.primitive(builder.*.typeStore, types_store.Kind.bool_type)
        }
        const left_type = expressionType(builder, node.lhs)
        const right_type = expressionType(builder, node.rhs)
        if left_type == 0 { return right_type }
        if right_type == 0 { return left_type }
        if types_store.Store.isCoercible(builder.*.typeStore, right_type, left_type) { return left_type }
        if types_store.Store.isCoercible(builder.*.typeStore, left_type, right_type) { return right_type }
        return left_type
    }
    if node.tag == ast.Tag.if_statement {
        // `if c { 1 } else { size }` is a usize: a branch that is a bare
        // literal takes the other branch's type.
        const then_type = expressionType(builder, node.rhs)
        if node.extra == ast.NONE || then_type == 0 { return if node.extra == ast.NONE { then_type } else { expressionType(builder, node.extra) } }
        const then_value = types_store.Store.get(builder.*.typeStore, then_type)
        if then_value.*.kind == types_store.Kind.comptime_int_type || then_value.*.kind == types_store.Kind.comptime_float_type {
            const else_type = expressionType(builder, node.extra)
            if else_type != 0 { return else_type }
        }
        return then_type
    }
    if node.tag == ast.Tag.match_statement && node.rhs != ast.NONE {
        const first_arm = ast_store.Store.get(nodes, node.rhs)
        return expressionType(builder, first_arm.rhs)
    }
    return 0
}

fn storageWidth(builder: *LirBuilder, type_id: usize) -> usize {
    if type_id == 0 { return 8 }
    const value = types_store.Store.get(builder.*.typeStore, type_id)
    if value.*.kind == types_store.Kind.struct_type || value.*.kind == types_store.Kind.union_type || value.*.kind == types_store.Kind.tuple || value.*.kind == types_store.Kind.slice || value.*.kind == types_store.Kind.array || value.*.kind == types_store.Kind.vector { return 8 }
    if isTaggedOptional(builder, type_id) {
        if aggregate_copy.isMemoryType(builder.*.typeStore, type_id) { return 8 }
        return storageWidth(builder, value.*.lhs)
    }
    const size = types_store.Store.sizeOf(builder.*.typeStore, type_id)
    if size == 1 || size == 2 || size == 4 { return size }
    return 8
}

fn isIntegerKind(builder: *LirBuilder, type_id: usize) -> bool {
    if type_id == 0 { return false }
    return types_store.Store.get(builder.*.typeStore, type_id).*.kind == types_store.Kind.integer
}

fn isUnsignedIntegerType(builder: *LirBuilder, type_id: usize) -> bool {
    if type_id == 0 { return false }
    const value = types_store.Store.get(builder.*.typeStore, type_id)
    return value.*.kind == types_store.Kind.integer && value.*.flags & types_store.FLAG_SIGNED == 0
}

fn isSignedIntegerType(builder: *LirBuilder, type_id: usize) -> bool {
    if type_id == 0 { return false }
    const value = types_store.Store.get(builder.*.typeStore, type_id)
    // An enum is loaded like its backing integer, so negative members of an
    // enum(i32) read back equal to their constants.
    if value.*.kind == types_store.Kind.enum_type && value.*.backing != types_store.NONE && value.*.backing != type_id { return isSignedIntegerType(builder, value.*.backing) }
    return value.*.kind == types_store.Kind.integer && value.*.flags & types_store.FLAG_SIGNED != 0
}

// Whether the field named at `field_token` is a slice's `pointer` (any
// other field of a slice is its `length`; sema allows those two).
fn isSlicePointerField(builder: *LirBuilder, field_token: usize) -> bool {
    if tokenLength(builder, field_token) != 7 { return false }
    unsafe { return mem.eql(tokenPointer(builder, field_token), @ptrCast([*]const u8, "pointer"), 7) }
}

fn lowerField(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    const base_node = ast_store.Store.get(nodes, node.lhs)
    const referenced_method = referencedSymbolIndex(builder, node_index)
    if referenced_method.0 {
        const method = symbols_store.Store.get(builder.*.symbolStore, referenced_method.1)
        if method.*.ownerTypeId != 0 { return lowerSymbolValue(builder, referenced_method.1, method, moduleForSymbol(builder, referenced_method.1)) }
    }
    if tokenKind(builder, node.mainToken) == lexer.Kind.integer {
        const field_index = lowerIntValue(builder, node.mainToken)
        const base_type_id = expressionType(builder, node.lhs)
        if base_type_id != 0 {
            const base_type = types_store.Store.get(builder.*.typeStore, base_type_id)
            if base_type.*.kind == types_store.Kind.tuple && field_index < base_type.*.extraLength {
                const field_type = types_store.Store.extraAt(builder.*.typeStore, base_type.*.extraStart + field_index)
                return lowerFlatTupleField(builder, lowerNode(builder, node.lhs), field_type, tupleFieldWordOffset(builder, base_type, field_index))
            }
        }
        const base = lowerNode(builder, node.lhs)
        var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
        extract.arg0 = base
        extract.arg1 = field_index
        return lir.addInst(builder.*.lir, extract)
    }

    // Resolve enum and error-set members through either a local type name or a
    // qualified imported type such as `token.Kind.keyword_const`.
    const referenced_base = referencedSymbolIndex(builder, node.lhs)
    if referenced_base.0 {
        const base_symbol = symbols_store.Store.get(builder.*.symbolStore, referenced_base.1)
        const base_symbol_type = types_store.Store.get(builder.*.typeStore, base_symbol.*.typeId)
        if base_symbol_type.*.kind == types_store.Kind.module {
            const field_pointer = tokenPointer(builder, node.mainToken)
            const field_length = tokenLength(builder, node.mainToken)
            var declaration_index: usize = 0
            while declaration_index < base_symbol_type.*.extraLength {
                const symbol_index = types_store.Store.extraAt(builder.*.typeStore, base_symbol_type.*.extraStart + declaration_index)
                const declaration = symbols_store.Store.get(builder.*.symbolStore, symbol_index)
                if declaration.*.nameLength == field_length && mem.eql(declaration.*.namePointer, field_pointer, field_length) {
                    return lowerSymbolValue(builder, symbol_index, declaration, base_symbol_type.*.bits)
                }
                declaration_index += 1
            }
        }
        if base_symbol_type.*.kind == types_store.Kind.type_type && base_symbol.*.valueTypeId != 0 {
            const reflected = types_store.Store.get(builder.*.typeStore, base_symbol.*.valueTypeId)
            if reflected.*.kind == types_store.Kind.enum_type || reflected.*.kind == types_store.Kind.error_set {
                const field_pointer = tokenPointer(builder, node.mainToken)
                const field_length = tokenLength(builder, node.mainToken)
                var reflected_field_index: usize = 0
                while reflected_field_index < reflected.*.extraLength {
                    const field = types_store.Store.fieldAt(builder.*.typeStore, reflected.*.extraStart + reflected_field_index)
                    if field.*.nameLength == field_length && mem.eql(field.*.namePointer, field_pointer, field_length) {
                        return lir.addInst(builder.*.lir, lir.constI(lir.NONE, field.*.offset))
                    }
                    reflected_field_index += 1
                }
            }
        }
    }

    if base_node.tag == ast.Tag.identifier || base_node.tag == ast.Tag.named_type {
        const name_pointer = tokenPointer(builder, base_node.mainToken)
        const name_length = tokenLength(builder, base_node.mainToken)
        if hasScope(builder) {
            unsafe {
                const scope = currentScope(builder)
                const base_found = scope_module.Scope.lookup(scope, name_pointer, name_length)
                if base_found.0 {
                    const base_symbol = symbols_store.Store.get(builder.*.symbolStore, base_found.1)
                    const base_type = types_store.Store.get(builder.*.typeStore, base_symbol.*.typeId)
                    const field_pointer = tokenPointer(builder, node.mainToken)
                    const field_length = tokenLength(builder, node.mainToken)
                    if base_type.*.kind == types_store.Kind.module {
                        var declaration_index: usize = 0
                        while declaration_index < base_type.*.extraLength {
                            const symbol_index = types_store.Store.extraAt(builder.*.typeStore, base_type.*.extraStart + declaration_index)
                            const declaration = symbols_store.Store.get(builder.*.symbolStore, symbol_index)
                            if declaration.*.nameLength == field_length && mem.eql(declaration.*.namePointer, field_pointer, field_length) {
                                return lowerSymbolValue(builder, symbol_index, declaration, base_type.*.bits)
                            }
                            declaration_index += 1
                        }
                    }
                    if base_type.*.kind == types_store.Kind.type_type && base_symbol.*.valueTypeId != 0 {
                        const reflected = types_store.Store.get(builder.*.typeStore, base_symbol.*.valueTypeId)
                        if reflected.*.kind == types_store.Kind.enum_type || reflected.*.kind == types_store.Kind.error_set {
                            var field_index: usize = 0
                            while field_index < reflected.*.extraLength {
                                const field = types_store.Store.fieldAt(builder.*.typeStore, reflected.*.extraStart + field_index)
                                if field.*.nameLength == field_length && mem.eql(field.*.namePointer, field_pointer, field_length) {
                                    return lir.addInst(builder.*.lir, lir.constI(lir.NONE, field.*.offset))
                                }
                                field_index += 1
                            }
                        }
                    }
                }
            }
        }
    }
    const metadata = fieldMetadata(builder, expressionType(builder, node.lhs), node.mainToken)
    if metadata.found {
        const address = lowerFieldAddress(builder, node_index)
        if address == lir.NONE { return lir.NONE }
        return lowerMemoryValue(builder, address, metadata.typeId)
    }
    const base_type_id = expressionType(builder, node.lhs)
    if base_type_id != 0 {
        const base_type = types_store.Store.get(builder.*.typeStore, base_type_id)
        if base_type.*.kind == types_store.Kind.slice && isSlicePointerField(builder, node.mainToken) {
            var pointer = lir.initInst(lir.Opcode.tuple_element, expressionType(builder, node_index))
            pointer.arg0 = lowerNode(builder, node.lhs)
            pointer.arg1 = 0
            return lir.addInst(builder.*.lir, pointer)
        }
        if base_type.*.kind == types_store.Kind.slice || base_type.*.kind == types_store.Kind.array {
            const base_value = lowerNode(builder, node.lhs)
            var length_value: usize = 0
            if base_type.*.kind == types_store.Kind.array {
                length_value = lir.addInst(builder.*.lir, lir.constI(lir.NONE, base_type.*.bits))
            } else {
                var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
                extract.arg0 = base_value
                extract.arg1 = 1
                length_value = lir.addInst(builder.*.lir, extract)
            }
            return length_value
        }
    }
    return lir.NONE
}

fn lowerIdentifier(builder: *LirBuilder, main_token: usize) -> usize {
    const name_ptr = tokenPointer(builder, main_token)
    const name_len = tokenLength(builder, main_token)
    const binding = findBindingRecord(builder, name_ptr, name_len)
    if @intFromPtr(binding) != 0 {
        if binding.*.comptimeTag == @intCast(u8, @intFromEnum(comptime_value.Kind.integer)) || binding.*.comptimeTag == @intCast(u8, @intFromEnum(comptime_value.Kind.boolean)) {
            return lir.addInst(builder.*.lir, lir.constI(binding.*.typeId, @bitCast(usize, binding.*.comptimeInteger)))
        }
        if binding.*.valueTypeId != 0 { return lir.NONE }
        if binding.*.directValue { return binding.*.address }
    }
    const addr = if @intFromPtr(binding) != 0 { binding.*.address } else { lir.NONE }
    if addr != lir.NONE {
        const type_id = binding.*.typeId
        const component_count = if @intFromPtr(binding) != 0 { binding.*.componentCount } else { 1 }
        const extra_start = builder.*.lir.*.extraData.*.length
        var component: usize = 0
        var primary = lir.NONE
        while component < component_count {
            const component_address = if @intFromPtr(binding) != 0 { bindingComponentAt(builder, binding.*.componentsStart + component) } else { addr }
            var load = lir.initInst(lir.Opcode.load, if component == 0 { type_id } else { lir.NONE })
            load.arg0 = component_address
            load.arg1 = if component == 0 { storageWidth(builder, type_id) } else { 8 }
            if component == 0 && loadsSigned(builder, type_id) { load.arg2 = 1 }
            const loaded = lir.addInst(builder.*.lir, load)
            if component == 0 { primary = loaded }
            lir.addExtra(builder.*.lir, loaded)
            component += 1
        }
        if component_count > 1 {
            var tuple = lir.initInst(lir.Opcode.tuple_literal, type_id)
            tuple.arg0 = extra_start
            tuple.arg1 = component_count
            return lir.addInst(builder.*.lir, tuple)
        }
        return primary
    }

    const member_index = ownerMemberIndex(builder, name_ptr, name_len)
    if member_index != lir.NONE {
        const member = symbols_store.Store.get(builder.*.symbolStore, member_index)
        const value = lowerSymbolValue(builder, member_index, member, moduleForSymbol(builder, member_index))
        if value != lir.NONE { return value }
    }
    if hasScope(builder) {
        unsafe {
            const scope = currentScope(builder)
            const found_symbol = scope_module.Scope.lookup(scope, name_ptr, name_len)
            if found_symbol.0 {
                const symbol = symbols_store.Store.get(builder.*.symbolStore, found_symbol.1)
                const value = lowerSymbolValue(builder, found_symbol.1, symbol, moduleForSymbol(builder, found_symbol.1))
                if value != lir.NONE { return value }
            }
        }
    }

    // Keep forward function references linkable until declarations from later
    // modules have been lowered.
    const found = lir.findSymbol(builder.*.lir, name_ptr, name_len)
    if found.0 {
        var inst = lir.initInst(lir.Opcode.func_sym, lir.NONE)
        inst.arg0 = found.1
        return lir.addInst(builder.*.lir, inst)
    }
    // Might be a forward-reference function; add as symbol
    const is_entry = builder.*.currentModuleId == 0 && isMainName(name_ptr, name_len)
    const sym_id = lir.addModuleSymbol(builder.*.lir, builder.*.currentModuleId, name_ptr, name_len, is_entry)
    var inst = lir.initInst(lir.Opcode.func_sym, lir.NONE)
    inst.arg0 = sym_id
    return lir.addInst(builder.*.lir, inst)
}

fn lowerAddress(builder: *LirBuilder, node_index: usize) -> usize {
    if node_index == ast.NONE { return lir.NONE }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.identifier {
        return findBinding(builder, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
    }
    if node.tag == ast.Tag.field_expression {
        const global = globalTarget(builder, node_index)
        if global.0 { return globalAddress(builder, global.1) }
        return lowerFieldAddress(builder, node_index)
    }
    if node.tag == ast.Tag.index_expression { return lowerIndexAddress(builder, node_index) }
    if node.tag == ast.Tag.unary_expression && tokenKind(builder, node.mainToken) == lexer.Kind.dot_asterisk { return lowerNode(builder, node.lhs) }
    return lir.NONE
}

fn assignmentOpcode(kind: lexer.Kind) -> lir.Opcode {
    if kind == lexer.Kind.minus_equal { return lir.Opcode.sub }
    if kind == lexer.Kind.asterisk_equal { return lir.Opcode.mul }
    if kind == lexer.Kind.slash_equal { return lir.Opcode.div }
    if kind == lexer.Kind.percent_equal { return lir.Opcode.rem }
    if kind == lexer.Kind.ampersand_equal { return lir.Opcode.bit_and }
    if kind == lexer.Kind.pipe_equal { return lir.Opcode.bit_or }
    if kind == lexer.Kind.caret_equal { return lir.Opcode.bit_xor }
    if kind == lexer.Kind.shift_left_equal { return lir.Opcode.shl }
    if kind == lexer.Kind.shift_right_equal { return lir.Opcode.shr }
    return lir.Opcode.add
}

fn assignmentOperator(kind: lexer.Kind) -> lexer.Kind {
    if kind == lexer.Kind.plus_equal { return lexer.Kind.plus }
    if kind == lexer.Kind.minus_equal { return lexer.Kind.minus }
    if kind == lexer.Kind.asterisk_equal { return lexer.Kind.asterisk }
    if kind == lexer.Kind.slash_equal { return lexer.Kind.slash }
    if kind == lexer.Kind.percent_equal { return lexer.Kind.percent }
    if kind == lexer.Kind.plus_percent_equal { return lexer.Kind.plus_percent }
    if kind == lexer.Kind.minus_percent_equal { return lexer.Kind.minus_percent }
    if kind == lexer.Kind.asterisk_percent_equal { return lexer.Kind.asterisk_percent }
    if kind == lexer.Kind.plus_pipe_equal { return lexer.Kind.plus_pipe }
    if kind == lexer.Kind.minus_pipe_equal { return lexer.Kind.minus_pipe }
    if kind == lexer.Kind.asterisk_pipe_equal { return lexer.Kind.asterisk_pipe }
    if kind == lexer.Kind.ampersand_equal { return lexer.Kind.ampersand }
    if kind == lexer.Kind.pipe_equal { return lexer.Kind.pipe }
    if kind == lexer.Kind.caret_equal { return lexer.Kind.caret }
    if kind == lexer.Kind.shift_left_equal { return lexer.Kind.shift_left }
    if kind == lexer.Kind.shift_right_equal { return lexer.Kind.shift_right }
    if kind == lexer.Kind.shift_left_percent_equal { return lexer.Kind.shift_left_percent }
    if kind == lexer.Kind.shift_right_percent_equal { return lexer.Kind.shift_right_percent }
    if kind == lexer.Kind.shift_left_pipe_equal { return lexer.Kind.shift_left_pipe }
    if kind == lexer.Kind.shift_left_percent_pipe_equal { return lexer.Kind.shift_left_percent_pipe }
    if kind == lexer.Kind.ampersand_shift_left_equal { return lexer.Kind.ampersand_shift_left }
    if kind == lexer.Kind.pipe_shift_left_equal { return lexer.Kind.pipe_shift_left }
    if kind == lexer.Kind.caret_shift_left_equal { return lexer.Kind.caret_shift_left }
    if kind == lexer.Kind.ampersand_shift_right_equal { return lexer.Kind.ampersand_shift_right }
    if kind == lexer.Kind.pipe_shift_right_equal { return lexer.Kind.pipe_shift_right }
    if kind == lexer.Kind.caret_shift_right_equal { return lexer.Kind.caret_shift_right }
    if kind == lexer.Kind.shift_left_ampersand_equal { return lexer.Kind.shift_left_ampersand }
    if kind == lexer.Kind.shift_left_caret_equal { return lexer.Kind.shift_left_caret }
    if kind == lexer.Kind.shift_right_ampersand_equal { return lexer.Kind.shift_right_ampersand }
    if kind == lexer.Kind.shift_right_pipe_equal { return lexer.Kind.shift_right_pipe }
    if kind == lexer.Kind.shift_right_caret_equal { return lexer.Kind.shift_right_caret }
    if kind == lexer.Kind.plus_shift_left_equal { return lexer.Kind.plus_shift_left }
    if kind == lexer.Kind.minus_shift_left_equal { return lexer.Kind.minus_shift_left }
    if kind == lexer.Kind.asterisk_shift_left_equal { return lexer.Kind.asterisk_shift_left }
    if kind == lexer.Kind.plus_percent_shift_left_equal { return lexer.Kind.plus_percent_shift_left }
    if kind == lexer.Kind.minus_percent_shift_left_equal { return lexer.Kind.minus_percent_shift_left }
    if kind == lexer.Kind.asterisk_percent_shift_left_equal { return lexer.Kind.asterisk_percent_shift_left }
    if kind == lexer.Kind.plus_pipe_shift_left_equal { return lexer.Kind.plus_pipe_shift_left }
    if kind == lexer.Kind.minus_pipe_shift_left_equal { return lexer.Kind.minus_pipe_shift_left }
    if kind == lexer.Kind.asterisk_pipe_shift_left_equal { return lexer.Kind.asterisk_pipe_shift_left }
    if kind == lexer.Kind.plus_shift_right_equal { return lexer.Kind.plus_shift_right }
    if kind == lexer.Kind.minus_shift_right_equal { return lexer.Kind.minus_shift_right }
    if kind == lexer.Kind.asterisk_shift_right_equal { return lexer.Kind.asterisk_shift_right }
    if kind == lexer.Kind.plus_percent_shift_right_equal { return lexer.Kind.plus_percent_shift_right }
    if kind == lexer.Kind.minus_percent_shift_right_equal { return lexer.Kind.minus_percent_shift_right }
    if kind == lexer.Kind.asterisk_percent_shift_right_equal { return lexer.Kind.asterisk_percent_shift_right }
    if kind == lexer.Kind.plus_pipe_shift_right_equal { return lexer.Kind.plus_pipe_shift_right }
    if kind == lexer.Kind.minus_pipe_shift_right_equal { return lexer.Kind.minus_pipe_shift_right }
    return lexer.Kind.asterisk_pipe_shift_right
}

fn integerBitWidth(builder: *LirBuilder, type_id: usize) -> usize {
    if type_id == 0 { return 64 }
    const value = types_store.Store.get(builder.*.typeStore, type_id)
    if value.*.kind == types_store.Kind.integer && value.*.bits != 0 { return value.*.bits }
    return 64
}

fn integerMask(builder: *LirBuilder, type_id: usize) -> usize {
    const bits = integerBitWidth(builder, type_id)
    if bits >= 64 { return 18446744073709551615 }
    return (@intCast(usize, 1) << bits) - 1
}

fn emitComparison(builder: *LirBuilder, predicate: lir.CmpPredicate, lhs: usize, rhs: usize) -> usize {
    var inst = lir.initInst(lir.Opcode.icmp, lir.NONE)
    inst.arg0 = @intCast(usize, @intFromEnum(predicate))
    inst.arg1 = lhs
    inst.arg2 = rhs
    return lir.addInst(builder.*.lir, inst)
}

fn emitTrapIf(builder: *LirBuilder, condition: usize) -> void {
    const trap_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const continue_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    lir.addInst(builder.*.lir, lir.condBranch(condition, trap_block, continue_block))
    lir.addInst(builder.*.lir, lir.blockLabelInst(trap_block))
    lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.unreachable_inst, lir.NONE))
    lir.addInst(builder.*.lir, lir.blockLabelInst(continue_block))
}

fn selectInteger(builder: *LirBuilder, condition: usize, normal: usize, exceptional: usize) -> usize {
    const exceptional_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const merge_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const result_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    var normal_store = lir.initInst(lir.Opcode.store, lir.NONE)
    normal_store.arg0 = result_address
    normal_store.arg1 = normal
    lir.addInst(builder.*.lir, normal_store)
    lir.addInst(builder.*.lir, lir.condBranch(condition, exceptional_block, merge_block))
    lir.addInst(builder.*.lir, lir.blockLabelInst(exceptional_block))
    var exceptional_store = lir.initInst(lir.Opcode.store, lir.NONE)
    exceptional_store.arg0 = result_address
    exceptional_store.arg1 = exceptional
    lir.addInst(builder.*.lir, exceptional_store)
    lir.addInst(builder.*.lir, lir.branch(merge_block))
    lir.addInst(builder.*.lir, lir.blockLabelInst(merge_block))
    var result_load = lir.initInst(lir.Opcode.load, lir.NONE)
    result_load.arg0 = result_address
    return lir.addInst(builder.*.lir, result_load)
}

fn maskInteger(builder: *LirBuilder, value: usize, type_id: usize) -> usize {
    if integerBitWidth(builder, type_id) >= 64 { return value }
    const mask = lir.addInst(builder.*.lir, lir.constI(type_id, integerMask(builder, type_id)))
    return lir.addInst(builder.*.lir, lir.binary(lir.Opcode.bit_and, type_id, value, mask))
}

// The result of a wrapping operation cut to its type's width and extended
// as the type extends it (zeros when unsigned, the sign when signed: a
// mask alone would leave -1 of an i32 as 0xFFFF_FFFF, large and positive
// to a comparison, a division or a widening).
fn wrapInteger(builder: *LirBuilder, value: usize, type_id: usize) -> usize {
    const bits = integerBitWidth(builder, type_id)
    if bits >= 64 || !isSignedIntegerType(builder, type_id) { return maskInteger(builder, value, type_id) }
    const shift = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 64 - bits))
    const raised = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.shl, type_id, value, shift))
    return lir.addInst(builder.*.lir, lir.binary(lir.Opcode.shr, type_id, raised, shift))
}

fn emitArithmeticPolicy(builder: *LirBuilder, kind: lexer.Kind, opcode: lir.Opcode, lhs: usize, rhs: usize, type_id: usize) -> usize {
    const raw = lir.addInst(builder.*.lir, lir.binary(opcode, type_id, lhs, rhs))
    const wrapping = kind == lexer.Kind.plus_percent || kind == lexer.Kind.minus_percent || kind == lexer.Kind.asterisk_percent
    if wrapping { return wrapInteger(builder, raw, type_id) }

    const saturating = kind == lexer.Kind.plus_pipe || kind == lexer.Kind.minus_pipe || kind == lexer.Kind.asterisk_pipe
    const bits = integerBitWidth(builder, type_id)
    if !isUnsignedIntegerType(builder, type_id) || bits >= 64 { return raw }

    const max = lir.addInst(builder.*.lir, lir.constI(type_id, integerMask(builder, type_id)))
    var overflow = lir.NONE
    if opcode == lir.Opcode.sub {
        overflow = emitComparison(builder, lir.CmpPredicate.ult, lhs, rhs)
    } else if opcode == lir.Opcode.add || opcode == lir.Opcode.mul || opcode == lir.Opcode.shl {
        overflow = emitComparison(builder, lir.CmpPredicate.ugt, raw, max)
    }
    if overflow == lir.NONE { return raw }
    if !saturating {
        if builder.*.runtimeSafety { emitTrapIf(builder, overflow) }
        return raw
    }
    const bound = if opcode == lir.Opcode.sub { lir.addInst(builder.*.lir, lir.constI(type_id, 0)) } else { max }
    return selectInteger(builder, overflow, raw, bound)
}

fn isShiftOperator(kind: lexer.Kind) -> bool {
    return kind >= lexer.Kind.shift_left && kind <= lexer.Kind.shift_right_caret
}

fn lowerShiftOperator(builder: *LirBuilder, kind: lexer.Kind, lhs: usize, rhs: usize, type_id: usize) -> usize {
    var count = rhs
    const wrapping_count = kind == lexer.Kind.shift_left_percent || kind == lexer.Kind.shift_right_percent || kind == lexer.Kind.shift_left_percent_pipe
    const width = integerBitWidth(builder, type_id)
    const is_wide = isWideType(builder, type_id)
    var context = wideContext(builder)
    // A wide value's count is one word; the modulus a word-sized value.
    if is_wide && wide.isWideValue(&context, rhs) { count = wide.low(&context, rhs) }
    const width_value = lir.addInst(builder.*.lir, lir.constI(if is_wide { lir.NONE } else { type_id }, width))
    if wrapping_count {
        count = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.urem, if is_wide { lir.NONE } else { type_id }, count, width_value))
    } else if builder.*.runtimeSafety {
        const invalid = emitComparison(builder, lir.CmpPredicate.uge, count, width_value)
        emitTrapIf(builder, invalid)
    }

    const shifts_right = kind == lexer.Kind.shift_right || kind == lexer.Kind.shift_right_percent ||
        kind == lexer.Kind.ampersand_shift_right || kind == lexer.Kind.pipe_shift_right || kind == lexer.Kind.caret_shift_right ||
        kind == lexer.Kind.shift_right_ampersand || kind == lexer.Kind.shift_right_pipe || kind == lexer.Kind.shift_right_caret ||
        kind == lexer.Kind.plus_shift_right || kind == lexer.Kind.minus_shift_right || kind == lexer.Kind.asterisk_shift_right ||
        kind == lexer.Kind.plus_percent_shift_right || kind == lexer.Kind.minus_percent_shift_right || kind == lexer.Kind.asterisk_percent_shift_right ||
        kind == lexer.Kind.plus_pipe_shift_right || kind == lexer.Kind.minus_pipe_shift_right || kind == lexer.Kind.asterisk_pipe_shift_right
    const shift_opcode = if shifts_right { lir.Opcode.shr } else { lir.Opcode.shl }
    if is_wide {
        // The plain and the wrapping-count shifts; the saturating and the
        // combined forms are not expanded.
        const value = wideOperand(builder, lhs, valueType(builder, lhs), type_id)
        const plain = kind == lexer.Kind.shift_left || kind == lexer.Kind.shift_right || kind == lexer.Kind.shift_left_percent || kind == lexer.Kind.shift_right_percent
        if !plain || !wide.isSupported(builder.*.typeStore, type_id) {
            recordUnsupportedWide(builder)
            return value
        }
        return wide.shift(&context, type_id, value, count, !shifts_right)
    }
    var shifted = lir.addInst(builder.*.lir, lir.binary(shift_opcode, type_id, lhs, count))
    if kind == lexer.Kind.shift_left_pipe || kind == lexer.Kind.shift_left_percent_pipe {
        shifted = emitArithmeticPolicy(builder, lexer.Kind.plus_pipe, lir.Opcode.shl, lhs, count, type_id)
    }

    var combine_opcode = lir.Opcode.copy
    if kind == lexer.Kind.ampersand_shift_left || kind == lexer.Kind.ampersand_shift_right || kind == lexer.Kind.shift_left_ampersand || kind == lexer.Kind.shift_right_ampersand { combine_opcode = lir.Opcode.bit_and }
    if kind == lexer.Kind.pipe_shift_left || kind == lexer.Kind.pipe_shift_right || kind == lexer.Kind.shift_right_pipe { combine_opcode = lir.Opcode.bit_or }
    if kind == lexer.Kind.caret_shift_left || kind == lexer.Kind.caret_shift_right || kind == lexer.Kind.shift_left_caret || kind == lexer.Kind.shift_right_caret { combine_opcode = lir.Opcode.bit_xor }
    if combine_opcode != lir.Opcode.copy {
        return lir.addInst(builder.*.lir, lir.binary(combine_opcode, type_id, lhs, shifted))
    }

    var arithmetic_opcode = lir.Opcode.copy
    var arithmetic_kind = lexer.Kind.plus
    if kind == lexer.Kind.plus_shift_left || kind == lexer.Kind.plus_shift_right { arithmetic_opcode = lir.Opcode.add }
    if kind == lexer.Kind.minus_shift_left || kind == lexer.Kind.minus_shift_right { arithmetic_opcode = lir.Opcode.sub }
    if kind == lexer.Kind.asterisk_shift_left || kind == lexer.Kind.asterisk_shift_right { arithmetic_opcode = lir.Opcode.mul }
    if kind == lexer.Kind.plus_percent_shift_left || kind == lexer.Kind.plus_percent_shift_right {
        arithmetic_opcode = lir.Opcode.add
        arithmetic_kind = lexer.Kind.plus_percent
    }
    if kind == lexer.Kind.minus_percent_shift_left || kind == lexer.Kind.minus_percent_shift_right {
        arithmetic_opcode = lir.Opcode.sub
        arithmetic_kind = lexer.Kind.minus_percent
    }
    if kind == lexer.Kind.asterisk_percent_shift_left || kind == lexer.Kind.asterisk_percent_shift_right {
        arithmetic_opcode = lir.Opcode.mul
        arithmetic_kind = lexer.Kind.asterisk_percent
    }
    if kind == lexer.Kind.plus_pipe_shift_left || kind == lexer.Kind.plus_pipe_shift_right {
        arithmetic_opcode = lir.Opcode.add
        arithmetic_kind = lexer.Kind.plus_pipe
    }
    if kind == lexer.Kind.minus_pipe_shift_left || kind == lexer.Kind.minus_pipe_shift_right {
        arithmetic_opcode = lir.Opcode.sub
        arithmetic_kind = lexer.Kind.minus_pipe
    }
    if kind == lexer.Kind.asterisk_pipe_shift_left || kind == lexer.Kind.asterisk_pipe_shift_right {
        arithmetic_opcode = lir.Opcode.mul
        arithmetic_kind = lexer.Kind.asterisk_pipe
    }
    if arithmetic_opcode != lir.Opcode.copy { return emitArithmeticPolicy(builder, arithmetic_kind, arithmetic_opcode, lhs, shifted, type_id) }
    return shifted
}

// An operator on wide integers (lowering/wide.mlx): the plain and the
// wrapping forms; the saturating ones are not expanded.
fn lowerWideOperator(builder: *LirBuilder, kind: lexer.Kind, lhs: usize, rhs: usize, type_id: usize) -> usize {
    const a = wideOperand(builder, lhs, valueType(builder, lhs), type_id)
    const b = wideOperand(builder, rhs, valueType(builder, rhs), type_id)
    if !wide.isSupported(builder.*.typeStore, type_id) { return a }
    var opcode = lir.Opcode.add
    var known = kind == lexer.Kind.plus || kind == lexer.Kind.plus_percent
    if kind == lexer.Kind.minus || kind == lexer.Kind.minus_percent {
        opcode = lir.Opcode.sub
        known = true
    }
    if kind == lexer.Kind.asterisk || kind == lexer.Kind.asterisk_percent {
        opcode = lir.Opcode.mul
        known = true
    }
    if kind == lexer.Kind.slash {
        opcode = if isUnsignedIntegerType(builder, type_id) { lir.Opcode.udiv } else { lir.Opcode.div }
        known = true
    }
    if kind == lexer.Kind.percent {
        opcode = if isUnsignedIntegerType(builder, type_id) { lir.Opcode.urem } else { lir.Opcode.rem }
        known = true
    }
    if kind == lexer.Kind.ampersand {
        opcode = lir.Opcode.bit_and
        known = true
    }
    if kind == lexer.Kind.pipe {
        opcode = lir.Opcode.bit_or
        known = true
    }
    if kind == lexer.Kind.caret {
        opcode = lir.Opcode.bit_xor
        known = true
    }
    if !known {
        recordUnsupportedWide(builder)
        return a
    }
    var context = wideContext(builder)
    return wide.arithmetic(&context, opcode, type_id, a, b)
}

fn lowerValueOperator(builder: *LirBuilder, kind: lexer.Kind, lhs: usize, rhs: usize, type_id: usize) -> usize {
    if isShiftOperator(kind) { return lowerShiftOperator(builder, kind, lhs, rhs, type_id) }
    if isWideType(builder, type_id) { return lowerWideOperator(builder, kind, lhs, rhs, type_id) }
    if (kind == lexer.Kind.plus || kind == lexer.Kind.minus) && type_id != 0 && types_store.Store.get(builder.*.typeStore, type_id).*.kind == types_store.Kind.many_pointer {
        return lowerPointerStep(builder, kind == lexer.Kind.minus, lhs, rhs, type_id)
    }
    var opcode = lir.Opcode.add
    if kind == lexer.Kind.minus || kind == lexer.Kind.minus_percent || kind == lexer.Kind.minus_pipe { opcode = lir.Opcode.sub }
    if kind == lexer.Kind.asterisk || kind == lexer.Kind.asterisk_percent || kind == lexer.Kind.asterisk_pipe { opcode = lir.Opcode.mul }
    if kind == lexer.Kind.slash { opcode = if isUnsignedIntegerType(builder, type_id) { lir.Opcode.udiv } else { lir.Opcode.div } }
    if kind == lexer.Kind.percent { opcode = if isUnsignedIntegerType(builder, type_id) { lir.Opcode.urem } else { lir.Opcode.rem } }
    if kind == lexer.Kind.ampersand { opcode = lir.Opcode.bit_and }
    if kind == lexer.Kind.pipe { opcode = lir.Opcode.bit_or }
    if kind == lexer.Kind.caret { opcode = lir.Opcode.bit_xor }
    return emitArithmeticPolicy(builder, kind, opcode, lhs, rhs, type_id)
}

// A many-item pointer moved by `count` elements: the address of element
// `count` (or `-count`), as indexing works it out.
fn lowerPointerStep(builder: *LirBuilder, backwards: bool, pointer: usize, count: usize, type_id: usize) -> usize {
    var stride = types_store.Store.sizeOf(builder.*.typeStore, types_store.Store.get(builder.*.typeStore, type_id).*.lhs)
    if stride == 0 { stride = 1 }
    var index = count
    if backwards {
        const zero = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
        index = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.sub, lir.NONE, zero, count))
    }
    var address = lir.initInst(lir.Opcode.gep, type_id)
    address.arg0 = pointer
    address.arg1 = index
    address.arg2 = stride
    return lir.addInst(builder.*.lir, address)
}

// Jumps to `true_block` or `false_block` as a condition holds: `&&`, `||`
// and `!` become jumps between blocks (the right side only reached when it
// decides), not a value stored, loaded and tested.
fn lowerBranch(builder: *LirBuilder, node_index: usize, true_block: usize, false_block: usize) -> void {
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.binary_expression {
        const kind = tokenKind(builder, node.mainToken)
        if kind == lexer.Kind.ampersand_ampersand || kind == lexer.Kind.pipe_pipe {
            if kind == lexer.Kind.pipe_pipe {
                const membership = lowerMembership(builder, node_index)
                if membership != lir.NONE {
                    lir.addInst(builder.*.lir, lir.condBranch(membership, true_block, false_block))
                    return
                }
            }
            const middle = builder.*.blockCounter
            builder.*.blockCounter += 1
            if kind == lexer.Kind.ampersand_ampersand {
                lowerBranch(builder, node.lhs, middle, false_block)
            } else {
                lowerBranch(builder, node.lhs, true_block, middle)
            }
            lir.addInst(builder.*.lir, lir.blockLabelInst(middle))
            lowerBranch(builder, node.rhs, true_block, false_block)
            return
        }
    }
    if node.tag == ast.Tag.unary_expression && tokenKind(builder, node.mainToken) == lexer.Kind.bang {
        lowerBranch(builder, node.lhs, false_block, true_block)
        return
    }
    const value = lowerNode(builder, node_index)
    lir.addInst(builder.*.lir, lir.condBranch(value, true_block, false_block))
}

fn lowerLogical(builder: *LirBuilder, lhs_node: usize, rhs_node: usize, is_and: bool) -> usize {
    const result_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    const lhs_value = lowerNode(builder, lhs_node)
    const rhs_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const shortcut_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const end_block = builder.*.blockCounter
    builder.*.blockCounter += 1

    if is_and {
        lir.addInst(builder.*.lir, lir.condBranch(lhs_value, rhs_block, shortcut_block))
    } else {
        lir.addInst(builder.*.lir, lir.condBranch(lhs_value, shortcut_block, rhs_block))
    }

    lir.addInst(builder.*.lir, lir.blockLabelInst(shortcut_block))
    const shortcut_value = lir.addInst(builder.*.lir, lir.constI(lir.NONE, if is_and { 0 } else { 1 }))
    var shortcut_store = lir.initInst(lir.Opcode.store, lir.NONE)
    shortcut_store.arg0 = result_address
    shortcut_store.arg1 = shortcut_value
    lir.addInst(builder.*.lir, shortcut_store)
    lir.addInst(builder.*.lir, lir.branch(end_block))

    lir.addInst(builder.*.lir, lir.blockLabelInst(rhs_block))
    const rhs_value = lowerNode(builder, rhs_node)
    var rhs_store = lir.initInst(lir.Opcode.store, lir.NONE)
    rhs_store.arg0 = result_address
    rhs_store.arg1 = rhs_value
    lir.addInst(builder.*.lir, rhs_store)
    lir.addInst(builder.*.lir, lir.branch(end_block))

    lir.addInst(builder.*.lir, lir.blockLabelInst(end_block))
    var result_load = lir.initInst(lir.Opcode.load, lir.NONE)
    result_load.arg0 = result_address
    return lir.addInst(builder.*.lir, result_load)
}

// The constants an `||` chain compares one value with, as bits (below
// 128: `low` for 0..63, `high` for 64..127).
const Membership = struct {
    subject: usize
    low: usize
    high: usize
    count: usize
}

// `x == A || x == B || ...`, one side-effect-free unsigned or enum value
// against at least three constants below 128 (integers, enum members):
// the bit for x in a mask of the constants, instead of a test, a branch
// and a stored result for each `||`.
fn lowerMembership(builder: *LirBuilder, node_index: usize) -> usize {
    var set = Membership.{ .subject = ast.NONE, .low = 0, .high = 0, .count = 0 }
    if !collectMembers(builder, node_index, &set) || set.count < 3 { return lir.NONE }
    const subject_type_id = expressionType(builder, set.subject)
    if subject_type_id == 0 || isSignedIntegerType(builder, subject_type_id) { return lir.NONE }
    var subject_type = types_store.Store.get(builder.*.typeStore, subject_type_id)
    if subject_type.*.kind == types_store.Kind.enum_type && subject_type.*.backing != types_store.NONE && subject_type.*.backing != subject_type_id {
        subject_type = types_store.Store.get(builder.*.typeStore, subject_type.*.backing)
    }
    if subject_type.*.kind != types_store.Kind.integer { return lir.NONE }
    const word = types_store.Store.sizeInteger(builder.*.typeStore, false)
    var value = lowerNode(builder, set.subject)
    if value == lir.NONE { return lir.NONE }
    if subject_type.*.bits > 0 && subject_type.*.bits < 64 {
        const width_mask = lir.addInst(builder.*.lir, lir.constI(word, (@intCast(usize, 1) << @intCast(u6, subject_type.*.bits)) - 1))
        value = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.bit_and, word, value, width_mask))
    }
    builder.*.membershipTestCount += 1
    const one = lir.addInst(builder.*.lir, lir.constI(word, 1))
    const word_bits = lir.addInst(builder.*.lir, lir.constI(word, 64))
    const shift = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.bit_and, word, value, lir.addInst(builder.*.lir, lir.constI(word, 63))))
    var bit = memberBit(builder, word, set.low, shift, one, emitComparison(builder, lir.CmpPredicate.ult, value, word_bits))
    if set.high != 0 {
        const above = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.sub, word, value, word_bits))
        const in_high = emitComparison(builder, lir.CmpPredicate.ult, above, word_bits)
        bit = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.bit_or, word, bit, memberBit(builder, word, set.high, shift, one, in_high)))
    }
    return emitComparison(builder, lir.CmpPredicate.ne, bit, lir.addInst(builder.*.lir, lir.constI(word, 0)))
}

// (mask >> shift) & 1, kept only where `in_range` holds.
fn memberBit(builder: *LirBuilder, word: usize, mask: usize, shift: usize, one: usize, in_range: usize) -> usize {
    const shifted = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.shr, word, lir.addInst(builder.*.lir, lir.constI(word, mask)), shift))
    const bit = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.bit_and, word, shifted, one))
    return lir.addInst(builder.*.lir, lir.binary(lir.Opcode.bit_and, word, bit, in_range))
}

fn collectMembers(builder: *LirBuilder, node_index: usize, set: *Membership) -> bool {
    if node_index == ast.NONE { return false }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag != ast.Tag.binary_expression { return false }
    const kind = tokenKind(builder, node.mainToken)
    if kind == lexer.Kind.pipe_pipe { return collectMembers(builder, node.lhs, set) && collectMembers(builder, node.rhs, set) }
    if kind != lexer.Kind.equal_equal { return false }
    var other = node.lhs
    var constant = constantMember(builder, node.rhs)
    if !constant.0 {
        other = node.rhs
        constant = constantMember(builder, node.lhs)
    }
    if !constant.0 || constant.1 >= 128 || !isPlainOperand(builder, other) { return false }
    if set.*.subject == ast.NONE {
        set.*.subject = other
    } else if !sameOperand(builder, set.*.subject, other) {
        return false
    }
    if constant.1 < 64 {
        set.*.low = set.*.low | (@intCast(usize, 1) << @intCast(u6, constant.1))
    } else {
        set.*.high = set.*.high | (@intCast(usize, 1) << @intCast(u6, constant.1 - 64))
    }
    set.*.count += 1
    return true
}

// An integer literal or a member of a named enum type, and its value.
fn constantMember(builder: *LirBuilder, node_index: usize) -> (bool, usize) {
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.integer_literal || node.tag == ast.Tag.character_literal {
        const value = lowerComptimeValue(builder, node_index)
        if value.kind == comptime_value.Kind.integer && value.integer >= 0 { return -> (true, @intCast(usize, value.integer)) }
        return -> (false, 0)
    }
    if node.tag != ast.Tag.field_expression || node.lhs == ast.NONE { return -> (false, 0) }
    const referenced = referencedSymbolIndex(builder, node.lhs)
    if !referenced.0 { return -> (false, 0) }
    const base = symbols_store.Store.get(builder.*.symbolStore, referenced.1)
    if types_store.Store.get(builder.*.typeStore, base.*.typeId).*.kind != types_store.Kind.type_type || base.*.valueTypeId == 0 { return -> (false, 0) }
    const reflected = types_store.Store.get(builder.*.typeStore, base.*.valueTypeId)
    if reflected.*.kind != types_store.Kind.enum_type { return -> (false, 0) }
    const field_pointer = tokenPointer(builder, node.mainToken)
    const field_length = tokenLength(builder, node.mainToken)
    var field_index: usize = 0
    while field_index < reflected.*.extraLength {
        const field = types_store.Store.fieldAt(builder.*.typeStore, reflected.*.extraStart + field_index)
        if field.*.nameLength == field_length && mem.eql(field.*.namePointer, field_pointer, field_length) { return -> (true, field.*.offset) }
        field_index += 1
    }
    return -> (false, 0)
}

// A local, a field of one or a value behind a pointer: reading it twice
// or once is the same.
fn isPlainOperand(builder: *LirBuilder, node_index: usize) -> bool {
    if node_index == ast.NONE { return false }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.identifier { return findBinding(builder, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken)) != lir.NONE }
    if node.tag == ast.Tag.field_expression { return isPlainOperand(builder, node.lhs) }
    if node.tag == ast.Tag.unary_expression && tokenKind(builder, node.mainToken) == lexer.Kind.dot_asterisk { return isPlainOperand(builder, node.lhs) }
    return false
}

fn sameOperand(builder: *LirBuilder, left_index: usize, right_index: usize) -> bool {
    const left = ast_store.Store.get(getNodes(builder), left_index)
    const right = ast_store.Store.get(getNodes(builder), right_index)
    if left.tag != right.tag { return false }
    const length = tokenLength(builder, left.mainToken)
    if length != tokenLength(builder, right.mainToken) || !mem.eql(tokenPointer(builder, left.mainToken), tokenPointer(builder, right.mainToken), length) { return false }
    if left.tag == ast.Tag.identifier { return true }
    return sameOperand(builder, left.lhs, right.lhs)
}

fn implicitMethodReceiver(builder: *LirBuilder, callee_node_index: usize, referenced: (bool, usize)) -> usize {
    if !referenced.0 { return ast.NONE }
    const symbol = symbols_store.Store.get(builder.*.symbolStore, referenced.1)
    if symbol.*.ownerTypeId == 0 { return ast.NONE }
    const callee = ast_store.Store.get(getNodes(builder), callee_node_index)
    if callee.tag != ast.Tag.field_expression || callee.lhs == ast.NONE { return ast.NONE }
    const base_type_id = expressionType(builder, callee.lhs)
    if base_type_id == 0 { return ast.NONE }
    const base_type = types_store.Store.get(builder.*.typeStore, base_type_id)
    if base_type.*.kind == types_store.Kind.type_type { return ast.NONE }
    return callee.lhs
}

fn isDiscardTarget(builder: *LirBuilder, node_index: usize) -> bool {
    const node = ast_store.Store.get(getNodes(builder), node_index)
    return node.tag == ast.Tag.identifier && tokenLength(builder, node.mainToken) == 1 && tokenPointer(builder, node.mainToken)[0] == 95
}

fn isMemoryAggregateTarget(builder: *LirBuilder, node_index: usize, type_id: usize) -> bool {
    if globalTarget(builder, node_index).0 { return aggregate_copy.isMemoryType(builder.*.typeStore, type_id) }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    const addresses_inline_storage = node.tag == ast.Tag.field_expression || node.tag == ast.Tag.index_expression || node.tag == ast.Tag.unary_expression && tokenKind(builder, node.mainToken) == lexer.Kind.dot_asterisk
    return addresses_inline_storage && aggregate_copy.isMemoryType(builder.*.typeStore, type_id)
}

fn lowerBinaryOp(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const n = ast_store.Store.get(nodes, node_index)
    const kind = tokenKind(builder, n.mainToken)
    builder.*.operatorToken = n.mainToken
    if kind >= lexer.Kind.equal && kind <= lexer.Kind.asterisk_pipe_shift_right_equal {
        // `_ = value`: the value is worked out and dropped.
        if kind == lexer.Kind.equal && isDiscardTarget(builder, n.lhs) {
            const dropped = lowerNode(builder, n.rhs)
            return lir.NONE
        }
        const address = lowerAddress(builder, n.lhs)
        if address == lir.NONE { return lir.NONE }
        const target_type = expressionType(builder, n.lhs)
        const width = storageWidth(builder, target_type)
        var rhs_value = widenToType(builder, narrowFloat(builder, lowerNode(builder, n.rhs), target_type), target_type)
        // `wide op= value`: the whole wide value read, the result stored
        // word by word as an assignment's.
        const wide_compound = kind != lexer.Kind.equal && isWideType(builder, target_type)
        if wide_compound { rhs_value = lowerValueOperator(builder, assignmentOperator(kind), lowerNode(builder, n.lhs), rhs_value, target_type) }
        if kind == lexer.Kind.equal && isMemoryAggregateTarget(builder, n.lhs, target_type) {
            aggregate_copy.emit(builder.*.lir, builder.*.typeStore, address, rhs_value, target_type)
            setBindingDropFlag(builder, n.lhs, 1)
            return rhs_value
        }
        // A value of several words (a slice: pointer and length; an
        // optional slice; an error union): every word is written. A local
        // keeps each in a component of its own, memory has them 8 bytes
        // apart; storing only the first left the old length behind.
        if (kind == lexer.Kind.equal || wide_compound) && typeWordCount(builder, target_type) > 1 && !aggregate_copy.isMemoryType(builder.*.typeStore, target_type) {
            const target_node = ast_store.Store.get(nodes, n.lhs)
            var binding: *Binding = undefined
            unsafe { binding = @ptrFromInt(*Binding, 0) }
            if target_node.tag == ast.Tag.identifier { binding = findBindingRecord(builder, tokenPointer(builder, target_node.mainToken), tokenLength(builder, target_node.mainToken)) }
            if @intFromPtr(binding) != 0 && binding.*.componentCount > 1 {
                const stored = ownedAggregate(builder, rhs_value, n.rhs, target_type)
                var component: usize = 0
                while component < binding.*.componentCount {
                    var component_value = stored
                    if component > 0 {
                        var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
                        extract.arg0 = stored
                        extract.arg1 = component
                        component_value = lir.addInst(builder.*.lir, extract)
                    }
                    var component_store = lir.initInst(lir.Opcode.store, lir.NONE)
                    component_store.arg0 = bindingComponentAt(builder, binding.*.componentsStart + component)
                    component_store.arg1 = component_value
                    component_store.arg2 = if component == 0 { width } else { 8 }
                    lir.addInst(builder.*.lir, component_store)
                    component += 1
                }
                setBindingDropFlag(builder, n.lhs, 1)
                return stored
            }
            if target_node.tag != ast.Tag.identifier || globalTarget(builder, n.lhs).0 {
                storeAggregateValue(builder, address, rhs_value, target_type)
                setBindingDropFlag(builder, n.lhs, 1)
                return rhs_value
            }
        }
        var result = rhs_value
        if kind == lexer.Kind.equal && ast_store.Store.get(nodes, n.lhs).tag == ast.Tag.identifier { result = ownedAggregate(builder, rhs_value, n.rhs, target_type) }
        if kind != lexer.Kind.equal {
            var load = lir.initInst(lir.Opcode.load, lir.NONE)
            load.arg0 = address
            load.arg1 = width
            const current = lir.addInst(builder.*.lir, load)
            result = lowerValueOperator(builder, assignmentOperator(kind), current, rhs_value, target_type)
        }
        var store = lir.initInst(lir.Opcode.store, lir.NONE)
        store.arg0 = address
        store.arg1 = result
        store.arg2 = width
        lir.addInst(builder.*.lir, store)
        if kind == lexer.Kind.equal { setBindingDropFlag(builder, n.lhs, 1) }
        return result
    }
    if kind == lexer.Kind.ampersand_ampersand { return lowerLogical(builder, n.lhs, n.rhs, true) }
    if kind == lexer.Kind.pipe_pipe {
        const membership = lowerMembership(builder, node_index)
        if membership != lir.NONE { return membership }
        return lowerLogical(builder, n.lhs, n.rhs, false)
    }

    // `optional == null`, `optional != null` of a tagged optional: its tag.
    if kind == lexer.Kind.equal_equal || kind == lexer.Kind.bang_equal {
        const left_null = ast_store.Store.get(nodes, n.lhs).tag == ast.Tag.null_literal
        const right_null = ast_store.Store.get(nodes, n.rhs).tag == ast.Tag.null_literal
        if left_null != right_null {
            const other = if left_null { n.rhs } else { n.lhs }
            const other_type = expressionType(builder, other)
            if isTaggedOptional(builder, other_type) {
                const tag = optionalTag(builder, lowerNode(builder, other), other_type)
                const absent = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
                return emitComparison(builder, if kind == lexer.Kind.equal_equal { lir.CmpPredicate.eq } else { lir.CmpPredicate.ne }, tag, absent)
            }
        }
    }
    const lhs_lowered = lowerNode(builder, n.lhs)
    const rhs_lowered = lowerNode(builder, n.rhs)
    const lhs_val = narrowFloat(builder, lhs_lowered, valueType(builder, rhs_lowered))
    const rhs_val = narrowFloat(builder, rhs_lowered, valueType(builder, lhs_lowered))
    // Comparison operators produce icmp
    if kind == lexer.Kind.equal_equal || kind == lexer.Kind.bang_equal ||
       kind == lexer.Kind.less || kind == lexer.Kind.less_equal ||
       kind == lexer.Kind.greater || kind == lexer.Kind.greater_equal {
        var pred: usize = 0
        if kind == lexer.Kind.equal_equal { pred = @intCast(usize, @intFromEnum(lir.CmpPredicate.eq)) }
        if kind == lexer.Kind.bang_equal { pred = @intCast(usize, @intFromEnum(lir.CmpPredicate.ne)) }
        // Unsigned when either side is an unsigned integer (the other may
        // be a literal, which has no signedness of its own).
        const left_type = expressionType(builder, n.lhs)
        const right_type = expressionType(builder, n.rhs)
        const unsigned = isUnsignedIntegerType(builder, left_type) || (!isSignedIntegerType(builder, left_type) && isUnsignedIntegerType(builder, right_type))
        if kind == lexer.Kind.less { pred = @intCast(usize, @intFromEnum(if unsigned { lir.CmpPredicate.ult } else { lir.CmpPredicate.lt })) }
        if kind == lexer.Kind.less_equal { pred = @intCast(usize, @intFromEnum(if unsigned { lir.CmpPredicate.ule } else { lir.CmpPredicate.le })) }
        if kind == lexer.Kind.greater { pred = @intCast(usize, @intFromEnum(if unsigned { lir.CmpPredicate.ugt } else { lir.CmpPredicate.gt })) }
        if kind == lexer.Kind.greater_equal { pred = @intCast(usize, @intFromEnum(if unsigned { lir.CmpPredicate.uge } else { lir.CmpPredicate.ge })) }
        const operand_type = expressionType(builder, n.lhs)
        if isWideType(builder, left_type) || isWideType(builder, right_type) {
            // Wide integers: both sides as the wide type, compared word by word.
            const wide_type = if isWideType(builder, left_type) { left_type } else { right_type }
            const a = wideOperand(builder, lhs_val, left_type, wide_type)
            const b = wideOperand(builder, rhs_val, right_type, wide_type)
            if !wide.isSupported(builder.*.typeStore, wide_type) { return a }
            var context = wideContext(builder)
            return wide.compare(&context, @enumFromInt(lir.CmpPredicate, @intCast(u8, pred)), a, b)
        }
        const operand = if operand_type != 0 { types_store.Store.get(builder.*.typeStore, operand_type) } else { types_store.Store.get(builder.*.typeStore, types_store.Store.primitive(builder.*.typeStore, types_store.Kind.comptime_int_type)) }
        var inst = lir.initInst(if operand.*.kind == types_store.Kind.float || operand.*.kind == types_store.Kind.comptime_float_type { lir.Opcode.fcmp } else { lir.Opcode.icmp }, operand_type)
        inst.arg0 = pred
        inst.arg1 = lhs_val
        inst.arg2 = rhs_val
        return lir.addInst(builder.*.lir, inst)
    }

    return lowerValueOperator(builder, kind, lhs_val, rhs_val, expressionType(builder, node_index))
}

fn bindInlineParameter(builder: *LirBuilder, parameter: ast.Node, argument: usize, type_id: usize) -> void {
    pushBinding(builder, tokenPointer(builder, parameter.mainToken), tokenLength(builder, parameter.mainToken), argument, lir.NONE, lir.NONE, type_id)
    unsafe {
        const binding = @ptrCast(*Binding, vector.Vector.at(builder.*.bindings.*, builder.*.bindings.*.length - 1))
        binding.*.directValue = true
    }
}

fn inlineSymbolActive(builder: *LirBuilder, symbol_index: usize) -> bool {
    var index: usize = 0
    while index < builder.*.inlineStack.*.length {
        unsafe {
            const active = @ptrCast(*usize, vector.Vector.at(builder.*.inlineStack.*, index))
            if active.* == symbol_index { return true }
        }
        index += 1
    }
    return false
}

fn pushInlineSymbol(builder: *LirBuilder, symbol_index: usize) -> void {
    unsafe { const appended = vector.Vector.appendAt(builder.*.inlineStack, @ptrCast([*]const u8, &symbol_index)) }
}

fn expandInlineCall(builder: *LirBuilder, candidate: inline_module.Candidate, symbol_index: usize, arguments_start: usize, argument_count: usize) -> usize {
    const caller_module = builder.*.currentModuleId
    const saved_bindings = builder.*.bindings.*.length
    const saved_components = builder.*.bindingComponents.*.length
    const saved_owner = builder.*.currentMethodOwner
    const symbol = symbols_store.Store.get(builder.*.symbolStore, symbol_index)
    const function_type = symbol.*.typeId
    switchToModule(builder, candidate.moduleId)
    builder.*.currentMethodOwner = if symbol.*.ownerTypeId != 0 { symbol.*.ownerTypeId } else { lir.NONE }
    // A method of a generic type instance's aggregate expands in that
    // instance's scope, with its salt.
    const saved_scope = builder.*.scopeOverride
    var inline_salt: usize = 0
    if symbol.*.ownerTypeId != 0 {
        const declaring = types_store.Store.instanceDeclaring(builder.*.typeStore, symbol.*.ownerTypeId)
        if declaring != types_store.NONE {
            builder.*.scopeOverride = types_store.Store.instanceAt(builder.*.typeStore, declaring).*.scopeAddress
            inline_salt = declaring + 1
        }
    }
    const saved_salt = types_store.Store.setInstanceSalt(builder.*.typeStore, inline_salt)
    pushInlineSymbol(builder, symbol_index)
    const declaration = ast_store.Store.get(getNodes(builder), candidate.declaration)
    var parameter = declaration.lhs
    var argument_index: usize = 0
    while parameter != ast.NONE && argument_index < argument_count {
        const value = ast_store.Store.get(getNodes(builder), parameter)
        bindInlineParameter(builder, value, lir.getExtra(builder.*.lir, arguments_start + argument_index), parameterType(builder, value, argument_index, function_type))
        parameter = value.next
        argument_index += 1
    }
    const result = lowerNode(builder, candidate.returnExpression)
    builder.*.bindings.*.length = saved_bindings
    builder.*.bindingComponents.*.length = saved_components
    builder.*.inlineStack.*.length -= 1
    builder.*.currentMethodOwner = saved_owner
    builder.*.scopeOverride = saved_scope
    const restored_salt = types_store.Store.setInstanceSalt(builder.*.typeStore, saved_salt)
    switchToModule(builder, caller_module)
    builder.*.inlinedCallCount += 1
    return result
}

fn automaticInlineLimit(level: u8) -> usize {
    if level == 2 { return 3 }
    if level >= 3 { return 12 }
    return 0
}

fn genericArgumentIsRuntime(builder: *LirBuilder, generic_instance: usize, source_index: usize) -> bool {
    if generic_instance == lir.NONE { return true }
    const instance = genericInstanceAt(builder, generic_instance)
    const module = loader_module.Loader.moduleAt(builder.*.loader, instance.*.moduleId)
    unsafe {
        const target_nodes = @ptrFromInt(*ast_store.Store, module.*.nodesAddress)
        const declaration = ast_store.Store.get(target_nodes, instance.*.declaration)
        var parameter = declaration.lhs
        var parameter_index: usize = 0
        while parameter != ast.NONE && parameter_index < source_index {
            parameter = ast_store.Store.get(target_nodes, parameter).next
            parameter_index += 1
        }
        return parameter == ast.NONE || ast_store.Store.get(target_nodes, parameter).extra & 1 == 0
    }
}

fn callArgumentIsRuntime(builder: *LirBuilder, child: usize, generic_instance: usize, source_index: usize) -> bool {
    if !genericArgumentIsRuntime(builder, generic_instance, source_index) { return false }
    const node = ast_store.Store.get(getNodes(builder), child)
    if node.tag == ast.Tag.named_type { return false }
    if node.tag != ast.Tag.identifier { return true }
    const pointer = tokenPointer(builder, node.mainToken)
    const length = tokenLength(builder, node.mainToken)
    return findBinding(builder, pointer, length) != lir.NONE || resolveTypeNode(builder, child) == 0
}

fn lowerCallArguments(builder: *LirBuilder, node: ast.Node, generic_instance: usize, receiver: usize) -> CallArguments {
    const implicit_count: usize = if receiver == ast.NONE { 0 } else { 1 }
    const args_start = builder.*.lir.*.extraData.*.length
    var reserved: usize = 0
    while reserved < node.extra + implicit_count {
        lir.addExtra(builder.*.lir, lir.NONE)
        reserved += 1
    }
    var argument_count: usize = 0
    var callee_type: usize = 0
    if generic_instance == lir.NONE {
        callee_type = expressionType(builder, node.lhs)
        if callee_type == 0 {
            // `pointer.method`, which has no type as a field.
            const referenced = referencedSymbolIndex(builder, node.lhs)
            if referenced.0 { callee_type = symbols_store.Store.get(builder.*.symbolStore, referenced.1).*.typeId }
        }
    } else {
        callee_type = genericInstanceAt(builder, generic_instance).*.functionTypeId
    }
    if receiver != ast.NONE {
        lir.setExtra(builder.*.lir, args_start, lowerReceiver(builder, callee_type, receiver))
        argument_count = 1
    }
    // The callee's parameter types, when its type lists every argument.
    var parameters_start: usize = 0
    var parameters_known = false
    if callee_type != 0 && callee_type < builder.*.typeStore.*.types.*.length {
        const function_type = types_store.Store.get(builder.*.typeStore, callee_type)
        parameters_known = function_type.*.kind == types_store.Kind.function && function_type.*.extraLength == node.extra + implicit_count
        parameters_start = function_type.*.extraStart
    }
    var child = node.rhs
    var source_argument_index: usize = 0
    while child != ast.NONE {
        const child_node = ast_store.Store.get(getNodes(builder), child)
        if callArgumentIsRuntime(builder, child, generic_instance, source_argument_index) {
            var argument = lowerNode(builder, child)
            if parameters_known {
                const parameter_type = types_store.Store.extraAt(builder.*.typeStore, parameters_start + argument_count)
                argument = widenToType(builder, narrowFloat(builder, argument, parameter_type), parameter_type)
            }
            lir.setExtra(builder.*.lir, args_start + argument_count, argument)
            argument_count += 1
        }
        child = child_node.next
        source_argument_index += 1
    }
    return CallArguments.{ .start = args_start, .count = argument_count }
}

// A method's receiver: the value, or its address when the method takes a
// pointer and the value is none (`counter.add(1)` on a local counter).
fn lowerReceiver(builder: *LirBuilder, callee_type: usize, receiver: usize) -> usize {
    const receiver_type = expressionType(builder, receiver)
    if callee_type != 0 && receiver_type != 0 {
        const function_type = types_store.Store.get(builder.*.typeStore, callee_type)
        if function_type.*.kind == types_store.Kind.function && function_type.*.extraLength > 0 {
            const parameter_kind = types_store.Store.get(builder.*.typeStore, types_store.Store.extraAt(builder.*.typeStore, function_type.*.extraStart)).*.kind
            const receiver_kind = types_store.Store.get(builder.*.typeStore, receiver_type).*.kind
            if parameter_kind == types_store.Kind.pointer && receiver_kind != types_store.Kind.pointer { return lowerAddressOf(builder, receiver) }
        }
    }
    return lowerNode(builder, receiver)
}

fn tryExpandCall(builder: *LirBuilder, symbol_index: usize, generic_instance: usize, arguments: CallArguments) -> InlineExpansion {
    if generic_instance != lir.NONE { return InlineExpansion.{ .expanded = false, .value = lir.NONE } }
    const symbol = symbols_store.Store.get(builder.*.symbolStore, symbol_index)
    if symbol.*.flags & symbol_module.FLAG_FUNCTION != 0 {
        const function_type = types_store.Store.get(builder.*.typeStore, symbol.*.typeId)
        if function_type.*.kind == types_store.Kind.function {
            const return_type = types_store.Store.get(builder.*.typeStore, function_type.*.lhs)
            if return_type.*.kind == types_store.Kind.error_union { return InlineExpansion.{ .expanded = false, .value = lir.NONE } }
            if return_type.*.copyability != types_store.Copyability.copyable { return InlineExpansion.{ .expanded = false, .value = lir.NONE } }
            var parameter_index: usize = 0
            while parameter_index < function_type.*.extraLength {
                const parameter_type = types_store.Store.get(builder.*.typeStore, types_store.Store.extraAt(builder.*.typeStore, function_type.*.extraStart + parameter_index))
                if parameter_type.*.copyability != types_store.Copyability.copyable { return InlineExpansion.{ .expanded = false, .value = lir.NONE } }
                parameter_index += 1
            }
        }
    }
    const candidate = inline_module.inspect(builder.*.loader, builder.*.symbolStore, symbol_index, arguments.count, automaticInlineLimit(builder.*.optimizationLevel))
    if candidate.eligible && builder.*.inlineStack.*.length < 32 && !inlineSymbolActive(builder, symbol_index) {
        if !candidate.requested { builder.*.automaticallyInlinedCallCount += 1 }
        return InlineExpansion.{ .expanded = true, .value = expandInlineCall(builder, candidate, symbol_index, arguments.start, arguments.count) }
    }
    if candidate.requested { builder.*.inlineMissCount += 1 }
    return InlineExpansion.{ .expanded = false, .value = lir.NONE }
}

// `return value` from a function given its caller's storage for the
// result: the value is copied there, unless it is a call that wrote it
// there itself, and the storage's address is returned.
fn lowerSlotReturn(builder: *LirBuilder, value_node: usize) -> usize {
    const saved_call = builder.*.forwardCall
    const saved_module = builder.*.forwardModule
    const saved_forwarded = builder.*.forwardedCall
    builder.*.forwardCall = value_node
    builder.*.forwardModule = builder.*.currentModuleId
    builder.*.forwardedCall = ast.NONE
    var value = lowerNode(builder, value_node)
    if value != lir.NONE && isTaggedOptional(builder, builder.*.currentReturnType) { value = widenToType(builder, value, builder.*.currentReturnType) }
    const forwarded = builder.*.forwardedCall == value_node
    builder.*.forwardCall = saved_call
    builder.*.forwardModule = saved_module
    builder.*.forwardedCall = saved_forwarded
    // (`return undefined` leaves the storage as the caller made it.)
    const undefined_value = ast_store.Store.get(getNodes(builder), value_node).tag == ast.Tag.undefined_literal
    if value != lir.NONE && !forwarded && !undefined_value { aggregate_copy.emit(builder.*.lir, builder.*.typeStore, builder.*.returnSlot, value, builder.*.currentReturnType) }
    emitDefersTo(builder, 0)
    var result = lir.retInst(builder.*.currentReturnType, builder.*.returnSlot)
    result.flags = lir.FLAG_RETURN_SLOT
    return lir.addInst(builder.*.lir, result)
}

// A call whose result is a struct, union or array (`slot_type`) hands the
// callee the storage for it as its first argument (lir.FLAG_RETURN_SLOT):
// a new allocation, or the caller's own result storage when the call is
// what the caller returns.
fn callWithReturnSlot(builder: *LirBuilder, node_index: usize, slot_type: usize, arguments: CallArguments) -> CallArguments {
    var slot = lir.NONE
    if builder.*.returnSlot != lir.NONE && builder.*.forwardCall == node_index && builder.*.forwardModule == builder.*.currentModuleId && slot_type == builder.*.currentReturnType {
        slot = builder.*.returnSlot
        builder.*.forwardedCall = node_index
    } else {
        var size = types_store.Store.sizeOf(builder.*.typeStore, slot_type)
        if size < 8 { size = 8 }
        var allocation = lir.initInst(lir.Opcode.alloca, slot_type)
        allocation.arg0 = size
        slot = lir.addInst(builder.*.lir, allocation)
    }
    const start = builder.*.lir.*.extraData.*.length
    lir.addExtra(builder.*.lir, slot)
    var index: usize = 0
    while index < arguments.count {
        lir.addExtra(builder.*.lir, lir.getExtra(builder.*.lir, arguments.start + index))
        index += 1
    }
    return CallArguments.{ .start = start, .count = arguments.count + 1 }
}

// A direct callee's result type as its declaration has it, which is what
// lowerFunction decides by.
fn declaredReturnType(builder: *LirBuilder, symbol_index: usize) -> usize {
    const type_id = symbols_store.Store.get(builder.*.symbolStore, symbol_index).*.typeId
    if type_id == 0 || types_store.Store.get(builder.*.typeStore, type_id).*.kind != types_store.Kind.function { return 0 }
    return types_store.Store.get(builder.*.typeStore, type_id).*.lhs
}

// `slot_type`: the result type that decides whether the callee takes
// storage for it (a direct callee's declared one; else the call's).
fn addCall(builder: *LirBuilder, node_index: usize, return_type: usize, slot_type: usize, function: usize, symbol: usize, arguments: CallArguments) -> usize {
    var passed = arguments
    var flags: u8 = 0
    if aggregate_copy.isMemoryType(builder.*.typeStore, slot_type) {
        passed = callWithReturnSlot(builder, node_index, slot_type, arguments)
        flags = lir.FLAG_RETURN_SLOT
    }
    var call = if function != lir.NONE { lir.callInst(return_type, function, passed.start, passed.count) } else { lir.directCallInst(return_type, symbol, passed.start, passed.count) }
    call.flags = flags
    return lir.addInst(builder.*.lir, call)
}

fn lowerCall(builder: *LirBuilder, node_index: usize) -> usize {
    const n = ast_store.Store.get(getNodes(builder), node_index)
    const referenced = referencedSymbolIndex(builder, n.lhs)
    var generic_instance: usize = lir.NONE
    if referenced.0 { generic_instance = ensureGenericInstance(builder, node_index, referenced.1) }
    const receiver = implicitMethodReceiver(builder, n.lhs, referenced)
    const arguments = lowerCallArguments(builder, n, generic_instance, receiver)

    if referenced.0 {
        const symbol = symbols_store.Store.get(builder.*.symbolStore, referenced.1)
        if symbol.*.flags & symbol_module.FLAG_SYSCALL != 0 && arguments.count > 0 {
            var syscall_inst = lir.initInst(lir.Opcode.syscall, lir.NONE)
            syscall_inst.arg0 = lir.getExtra(builder.*.lir, arguments.start)
            syscall_inst.arg1 = arguments.start + 1
            syscall_inst.arg2 = arguments.count - 1
            return lir.addInst(builder.*.lir, syscall_inst)
        }
        const expansion = tryExpandCall(builder, referenced.1, generic_instance, arguments)
        if expansion.expanded { return expansion.value }
    }

    const return_type_id = if generic_instance != lir.NONE { types_store.Store.get(builder.*.typeStore, genericInstanceAt(builder, generic_instance).*.functionTypeId).*.lhs } else { expressionType(builder, node_index) }
    if generic_instance != lir.NONE {
        return addCall(builder, node_index, return_type_id, return_type_id, lir.NONE, genericInstanceAt(builder, generic_instance).*.symbolId, arguments)
    }
    if referenced.0 {
        const symbol = symbols_store.Store.get(builder.*.symbolStore, referenced.1)
        if symbol.*.flags & symbol_module.FLAG_FUNCTION != 0 {
            var symbol_id = if referenced.1 < builder.*.lirSymbolCapacity { builder.*.lirSymbolIds[referenced.1] } else { lir.NONE }
            if symbol_id == lir.NONE {
                const is_entry = (symbol.*.moduleId == 0 && isMainName(symbol.*.namePointer, symbol.*.nameLength)) || hasPlainSymbolName(symbol)
                symbol_id = if symbol.*.ownerTypeId == 0 { lir.addModuleSymbol(builder.*.lir, symbol.*.moduleId, symbol.*.namePointer, symbol.*.nameLength, is_entry) } else { lir.addMethodSymbol(builder.*.lir, symbol.*.moduleId, symbol.*.ownerTypeId, symbol.*.namePointer, symbol.*.nameLength) }
                recordLinkage(builder, symbol_id, symbol)
                if referenced.1 < builder.*.lirSymbolCapacity { builder.*.lirSymbolIds[referenced.1] = symbol_id }
            }
            // Whether the callee takes storage for its result follows its
            // declaration, as in lowerFunction, not the call's type.
            return addCall(builder, node_index, return_type_id, declaredReturnType(builder, referenced.1), lir.NONE, symbol_id, arguments)
        }
    }
    const func_val = lowerNode(builder, n.lhs)
    return addCall(builder, node_index, return_type_id, return_type_id, func_val, lir.NONE, arguments)
}

fn lowerBlock(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const n = ast_store.Store.get(nodes, node_index)
    var child = n.lhs
    var last_val = lir.NONE
    const defer_depth = builder.*.deferredNodes.*.length
    // The block's names are its own: gone after it, as sema has them,
    // so a name declared before it is seen again after it.
    const bindings_length = builder.*.bindings.*.length
    const components_length = builder.*.bindingComponents.*.length
    while child != ast.NONE {
        const cn = ast_store.Store.get(nodes, child)
        last_val = lowerNode(builder, child)
        child = cn.next
    }
    emitDefersTo(builder, defer_depth)
    builder.*.deferredNodes.*.length = defer_depth
    builder.*.bindings.*.length = bindings_length
    builder.*.bindingComponents.*.length = components_length
    return last_val
}

fn lowerIf(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const n = ast_store.Store.get(nodes, node_index)

    const condition_value = lowerComptimeValue(builder, n.lhs)
    if condition_value.kind == comptime_value.Kind.boolean {
        return lowerNode(builder, if condition_value.integer != 0 { n.rhs } else { n.extra })
    }

    const result_type_id = expressionType(builder, node_index)
    var has_secondary_result = false
    if result_type_id != 0 {
        const result_type = types_store.Store.get(builder.*.typeStore, result_type_id)
        has_secondary_result = result_type.*.kind == types_store.Kind.slice || result_type.*.kind == types_store.Kind.tuple || isOptionalSlice(builder, result_type_id) || (isTaggedOptional(builder, result_type_id) && typeWordCount(builder, result_type_id) == 2)
    }
    const result_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    var secondary_result_address = lir.NONE
    if has_secondary_result {
        secondary_result_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    }
    const then_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const else_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const end_block = builder.*.blockCounter
    builder.*.blockCounter += 1

    lowerBranch(builder, n.lhs, then_block, else_block)

    // Then block
    lir.addInst(builder.*.lir, lir.blockLabelInst(then_block))
    var then_value = widenToType(builder, lowerNode(builder, n.rhs), result_type_id)
    if then_value != lir.NONE && has_secondary_result && typeWordCount(builder, valueType(builder, then_value)) == 1 && valueType(builder, then_value) != result_type_id { then_value = widenToType(builder, then_value, result_type_id) }
    if then_value != lir.NONE {
        var then_store = lir.initInst(lir.Opcode.store, lir.NONE)
        then_store.arg0 = result_address
        then_store.arg1 = then_value
        then_store.arg2 = storageWidth(builder, result_type_id)
        lir.addInst(builder.*.lir, then_store)
        if has_secondary_result {
            var then_extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
            then_extract.arg0 = then_value
            then_extract.arg1 = 1
            const then_secondary = lir.addInst(builder.*.lir, then_extract)
            var then_secondary_store = lir.initInst(lir.Opcode.store, lir.NONE)
            then_secondary_store.arg0 = secondary_result_address
            then_secondary_store.arg1 = then_secondary
            then_secondary_store.arg2 = 8
            lir.addInst(builder.*.lir, then_secondary_store)
        }
    }
    lir.addInst(builder.*.lir, lir.branch(end_block))

    // Else block
    lir.addInst(builder.*.lir, lir.blockLabelInst(else_block))
    var else_value = lir.NONE
    if n.extra != ast.NONE {
        else_value = widenToType(builder, lowerNode(builder, n.extra), result_type_id)
        if else_value != lir.NONE {
            var else_store = lir.initInst(lir.Opcode.store, lir.NONE)
            else_store.arg0 = result_address
            else_store.arg1 = else_value
            else_store.arg2 = storageWidth(builder, result_type_id)
            lir.addInst(builder.*.lir, else_store)
            if has_secondary_result {
                var else_extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
                else_extract.arg0 = else_value
                else_extract.arg1 = 1
                const else_secondary = lir.addInst(builder.*.lir, else_extract)
                var else_secondary_store = lir.initInst(lir.Opcode.store, lir.NONE)
                else_secondary_store.arg0 = secondary_result_address
                else_secondary_store.arg1 = else_secondary
                else_secondary_store.arg2 = 8
                lir.addInst(builder.*.lir, else_secondary_store)
            }
        }
    }
    lir.addInst(builder.*.lir, lir.branch(end_block))

    // End block
    lir.addInst(builder.*.lir, lir.blockLabelInst(end_block))
    if then_value == lir.NONE || else_value == lir.NONE { return lir.NONE }
    var result_load = lir.initInst(lir.Opcode.load, result_type_id)
    result_load.arg0 = result_address
    result_load.arg1 = storageWidth(builder, result_type_id)
    // A narrow signed result comes back sign-extended, as any load of it.
    if isSignedIntegerType(builder, result_type_id) { result_load.arg2 = 1 }
    const primary_result = lir.addInst(builder.*.lir, result_load)
    if !has_secondary_result { return primary_result }

    var secondary_load = lir.initInst(lir.Opcode.load, lir.NONE)
    secondary_load.arg0 = secondary_result_address
    secondary_load.arg1 = 8
    const secondary_result = lir.addInst(builder.*.lir, secondary_load)
    const result_extra_start = builder.*.lir.*.extraData.*.length
    lir.addExtra(builder.*.lir, primary_result)
    lir.addExtra(builder.*.lir, secondary_result)
    var tuple_result = lir.initInst(lir.Opcode.tuple_literal, result_type_id)
    tuple_result.arg0 = result_extra_start
    tuple_result.arg1 = 2
    return lir.addInst(builder.*.lir, tuple_result)
}

fn lowerMatchCondition(builder: *LirBuilder, subject: usize, subject_type_id: usize, pattern_index: usize) -> usize {
    const nodes = getNodes(builder)
    const pattern_node = ast_store.Store.get(nodes, pattern_index)
    if pattern_node.tag == ast.Tag.range_expression {
        const lower_bound = lowerNode(builder, pattern_node.lhs)
        const upper_bound = lowerNode(builder, pattern_node.rhs)
        if lower_bound == lir.NONE || upper_bound == lir.NONE { return lir.NONE }
        var lower_comparison = lir.initInst(lir.Opcode.icmp, lir.NONE)
        lower_comparison.arg0 = @intCast(usize, @intFromEnum(lir.CmpPredicate.ge))
        lower_comparison.arg1 = subject
        lower_comparison.arg2 = lower_bound
        const above_lower = lir.addInst(builder.*.lir, lower_comparison)
        var upper_comparison = lir.initInst(lir.Opcode.icmp, lir.NONE)
        upper_comparison.arg0 = @intCast(usize, @intFromEnum(lir.CmpPredicate.lt))
        upper_comparison.arg1 = subject
        upper_comparison.arg2 = upper_bound
        const below_upper = lir.addInst(builder.*.lir, upper_comparison)
        return lir.addInst(builder.*.lir, lir.binary(lir.Opcode.bit_and, lir.NONE, above_lower, below_upper))
    }
    if pattern_node.tag == ast.Tag.field_expression && pattern_node.lhs == ast.NONE && subject_type_id != 0 {
        const subject_type = types_store.Store.get(builder.*.typeStore, subject_type_id)
        if subject_type.*.kind == types_store.Kind.enum_type || subject_type.*.kind == types_store.Kind.error_set || subject_type.*.kind == types_store.Kind.union_type {
            const field_pointer = tokenPointer(builder, pattern_node.mainToken)
            const field_length = tokenLength(builder, pattern_node.mainToken)
            var field_index: usize = 0
            while field_index < subject_type.*.extraLength {
                const field = types_store.Store.fieldAt(builder.*.typeStore, subject_type.*.extraStart + field_index)
                if field.*.nameLength == field_length && mem.eql(field.*.namePointer, field_pointer, field_length) {
                    const tag_value = if subject_type.*.kind == types_store.Kind.union_type { field_index } else { field.*.offset }
                    const pattern_value = lir.addInst(builder.*.lir, lir.constI(lir.NONE, tag_value))
                    var field_comparison = lir.initInst(lir.Opcode.icmp, lir.NONE)
                    field_comparison.arg0 = @intCast(usize, @intFromEnum(lir.CmpPredicate.eq))
                    field_comparison.arg1 = subject
                    field_comparison.arg2 = pattern_value
                    return lir.addInst(builder.*.lir, field_comparison)
                }
                field_index += 1
            }
        }
        return lir.NONE
    }
    const pattern = lowerNode(builder, pattern_index)
    if pattern == lir.NONE { return lir.NONE }
    var comparison = lir.initInst(lir.Opcode.icmp, lir.NONE)
    comparison.arg0 = @intCast(usize, @intFromEnum(lir.CmpPredicate.eq))
    comparison.arg1 = subject
    comparison.arg2 = pattern
    return lir.addInst(builder.*.lir, comparison)
}

fn lowerMatch(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    var subject = lowerNode(builder, node.lhs)
    if subject == lir.NONE { return lir.NONE }
    const subject_type_id = expressionType(builder, node.lhs)
    if isWideType(builder, subject_type_id) {
        builder.*.operatorToken = node.mainToken
        recordUnsupportedWide(builder)
    }
    if subject_type_id != 0 {
        const subject_type = types_store.Store.get(builder.*.typeStore, subject_type_id)
        if subject_type.*.kind == types_store.Kind.union_type && subject_type.*.backing != types_store.NONE {
            var tag_load = lir.initInst(lir.Opcode.load, subject_type.*.backing)
            tag_load.arg0 = subject
            tag_load.arg1 = storageWidth(builder, subject_type.*.backing)
            subject = lir.addInst(builder.*.lir, tag_load)
        }
    }

    // A slice or tuple result has a second word, kept in its own slot as in
    // lowerIf (the first slot only holds one word).
    const result_type_id = expressionType(builder, node_index)
    var has_secondary_result = false
    if result_type_id != 0 {
        const result_type = types_store.Store.get(builder.*.typeStore, result_type_id)
        has_secondary_result = result_type.*.kind == types_store.Kind.slice || result_type.*.kind == types_store.Kind.tuple || isOptionalSlice(builder, result_type_id) || (isTaggedOptional(builder, result_type_id) && typeWordCount(builder, result_type_id) == 2)
    }
    const result_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    var secondary_result_address = lir.NONE
    if has_secondary_result {
        secondary_result_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    }
    const end_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    var arm_index = node.rhs
    var arm_count: usize = 0
    var has_else = false
    var all_arms_have_values = node.extra > 0

    while arm_index != ast.NONE && arm_count < node.extra {
        const arm = ast_store.Store.get(nodes, arm_index)
        if arm.lhs == ast.NONE {
            has_else = true
            const else_value = lowerNode(builder, arm.rhs)
            if else_value == lir.NONE {
                all_arms_have_values = false
            } else {
                storeMatchResult(builder, result_address, secondary_result_address, else_value, matchStoreWidth(builder, result_type_id, arm.rhs))
            }
            lir.addInst(builder.*.lir, lir.branch(end_block))
            arm_index = arm.next
            arm_count += 1
            break
        }

        const arm_block = builder.*.blockCounter
        builder.*.blockCounter += 1
        const next_block = builder.*.blockCounter
        builder.*.blockCounter += 1
        const condition = lowerMatchCondition(builder, subject, subject_type_id, arm.lhs)
        if condition == lir.NONE { return lir.NONE }
        lir.addInst(builder.*.lir, lir.condBranch(condition, arm_block, next_block))

        lir.addInst(builder.*.lir, lir.blockLabelInst(arm_block))
        const arm_value = lowerNode(builder, arm.rhs)
        if arm_value == lir.NONE {
            all_arms_have_values = false
        } else {
            storeMatchResult(builder, result_address, secondary_result_address, arm_value, matchStoreWidth(builder, result_type_id, arm.rhs))
        }
        lir.addInst(builder.*.lir, lir.branch(end_block))
        lir.addInst(builder.*.lir, lir.blockLabelInst(next_block))

        arm_index = arm.next
        arm_count += 1
    }

    if !has_else { lir.addInst(builder.*.lir, lir.branch(end_block)) }
    lir.addInst(builder.*.lir, lir.blockLabelInst(end_block))
    if !all_arms_have_values { return lir.NONE }
    var result_load = lir.initInst(lir.Opcode.load, result_type_id)
    result_load.arg0 = result_address
    result_load.arg1 = storageWidth(builder, result_type_id)
    // A narrow signed result comes back sign-extended, as any load of it.
    if isSignedIntegerType(builder, result_type_id) { result_load.arg2 = 1 }
    const primary_result = lir.addInst(builder.*.lir, result_load)
    if !has_secondary_result { return primary_result }
    var secondary_load = lir.initInst(lir.Opcode.load, lir.NONE)
    secondary_load.arg0 = secondary_result_address
    secondary_load.arg1 = 8
    const secondary_result = lir.addInst(builder.*.lir, secondary_load)
    const result_extra_start = builder.*.lir.*.extraData.*.length
    lir.addExtra(builder.*.lir, primary_result)
    lir.addExtra(builder.*.lir, secondary_result)
    var tuple_result = lir.initInst(lir.Opcode.tuple_literal, result_type_id)
    tuple_result.arg0 = result_extra_start
    tuple_result.arg1 = 2
    return lir.addInst(builder.*.lir, tuple_result)
}

// How many bytes an arm stores: the match's own width, which the result
// is loaded with (an arm of a narrower type, such as a u32 variable next to
// literal arms, would leave the rest of the slot unset), else the arm's.
fn matchStoreWidth(builder: *LirBuilder, result_type_id: usize, arm_node: usize) -> usize {
    if result_type_id != 0 { return storageWidth(builder, result_type_id) }
    return storageWidth(builder, expressionType(builder, arm_node))
}

// Stores one match arm's value: its first word, and its second word when
// the result is a slice or tuple (`secondary_address` is not NONE).
fn storeMatchResult(builder: *LirBuilder, address: usize, secondary_address: usize, value: usize, width: usize) -> void {
    var result_store = lir.initInst(lir.Opcode.store, lir.NONE)
    result_store.arg0 = address
    result_store.arg1 = value
    result_store.arg2 = width
    lir.addInst(builder.*.lir, result_store)
    if secondary_address == lir.NONE { return }
    var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
    extract.arg0 = value
    extract.arg1 = 1
    const secondary = lir.addInst(builder.*.lir, extract)
    var secondary_store = lir.initInst(lir.Opcode.store, lir.NONE)
    secondary_store.arg0 = secondary_address
    secondary_store.arg1 = secondary
    secondary_store.arg2 = 8
    lir.addInst(builder.*.lir, secondary_store)
}

fn lowerWhile(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const n = ast_store.Store.get(nodes, node_index)

    const header_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const body_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const update_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const end_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const result_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    const initial_result = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
    var initial_store = lir.initInst(lir.Opcode.store, lir.NONE)
    initial_store.arg0 = result_address
    initial_store.arg1 = initial_result
    lir.addInst(builder.*.lir, initial_store)

    lir.addInst(builder.*.lir, lir.branch(header_block))

    // Header
    lir.addInst(builder.*.lir, lir.blockLabelInst(header_block))
    lowerBranch(builder, n.lhs, body_block, end_block)

    // Body
    lir.addInst(builder.*.lir, lir.blockLabelInst(body_block))
    pushLoopTarget(builder, n.endToken, end_block, update_block, result_address)
    lowerNode(builder, n.rhs)
    popLoopTarget(builder)
    lir.addInst(builder.*.lir, lir.branch(update_block))

    // Update
    lir.addInst(builder.*.lir, lir.blockLabelInst(update_block))
    if n.extra != ast.NONE { lowerNode(builder, n.extra) }
    lir.addInst(builder.*.lir, lir.branch(header_block))

    // End
    lir.addInst(builder.*.lir, lir.blockLabelInst(end_block))
    var result_load = lir.initInst(lir.Opcode.load, expressionType(builder, node_index))
    result_load.arg0 = result_address
    return lir.addInst(builder.*.lir, result_load)
}

fn lowerFor(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const n = ast_store.Store.get(nodes, node_index)
    const iterable = ast_store.Store.get(nodes, n.lhs)
    if iterable.tag != ast.Tag.range_expression { return lowerIterableFor(builder, node_index) }

    const bindings_length = builder.*.bindings.*.length
    const binding_components_length = builder.*.bindingComponents.*.length
    const initial_value = lowerNode(builder, iterable.lhs)
    const capture_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    var capture_store = lir.initInst(lir.Opcode.store, lir.NONE)
    capture_store.arg0 = capture_address
    capture_store.arg1 = initial_value
    lir.addInst(builder.*.lir, capture_store)

    const capture = ast_store.Store.get(nodes, n.extra)
    pushBinding(builder, tokenPointer(builder, capture.mainToken), tokenLength(builder, capture.mainToken), capture_address, lir.NONE, lir.NONE, types_store.Store.sizeInteger(builder.*.typeStore, false))

    var index_address = lir.NONE
    if capture.endToken != ast.NONE {
        const zero = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
        index_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
        var index_store = lir.initInst(lir.Opcode.store, lir.NONE)
        index_store.arg0 = index_address
        index_store.arg1 = zero
        lir.addInst(builder.*.lir, index_store)
        pushBinding(builder, tokenPointer(builder, capture.endToken), tokenLength(builder, capture.endToken), index_address, lir.NONE, lir.NONE, types_store.Store.sizeInteger(builder.*.typeStore, false))
    }

    const header_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const body_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const update_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const end_block = builder.*.blockCounter
    builder.*.blockCounter += 1

    lir.addInst(builder.*.lir, lir.branch(header_block))
    lir.addInst(builder.*.lir, lir.blockLabelInst(header_block))
    var capture_load = lir.initInst(lir.Opcode.load, lir.NONE)
    capture_load.arg0 = capture_address
    const capture_value = lir.addInst(builder.*.lir, capture_load)
    const upper_value = lowerNode(builder, iterable.rhs)
    var comparison = lir.initInst(lir.Opcode.icmp, lir.NONE)
    comparison.arg0 = @intCast(usize, @intFromEnum(lir.CmpPredicate.lt))
    comparison.arg1 = capture_value
    comparison.arg2 = upper_value
    const condition = lir.addInst(builder.*.lir, comparison)
    lir.addInst(builder.*.lir, lir.condBranch(condition, body_block, end_block))

    lir.addInst(builder.*.lir, lir.blockLabelInst(body_block))
    const result_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    pushLoopTarget(builder, n.endToken, end_block, update_block, result_address)
    lowerNode(builder, n.rhs)
    popLoopTarget(builder)
    lir.addInst(builder.*.lir, lir.branch(update_block))

    lir.addInst(builder.*.lir, lir.blockLabelInst(update_block))
    capture_load = lir.initInst(lir.Opcode.load, lir.NONE)
    capture_load.arg0 = capture_address
    const current_value = lir.addInst(builder.*.lir, capture_load)
    const one = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 1))
    const next_value = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.add, lir.NONE, current_value, one))
    capture_store = lir.initInst(lir.Opcode.store, lir.NONE)
    capture_store.arg0 = capture_address
    capture_store.arg1 = next_value
    lir.addInst(builder.*.lir, capture_store)
    if index_address != lir.NONE {
        var index_load = lir.initInst(lir.Opcode.load, lir.NONE)
        index_load.arg0 = index_address
        const current_index = lir.addInst(builder.*.lir, index_load)
        const next_index = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.add, lir.NONE, current_index, one))
        var index_store = lir.initInst(lir.Opcode.store, lir.NONE)
        index_store.arg0 = index_address
        index_store.arg1 = next_index
        lir.addInst(builder.*.lir, index_store)
    }
    lir.addInst(builder.*.lir, lir.branch(header_block))

    lir.addInst(builder.*.lir, lir.blockLabelInst(end_block))
    builder.*.bindings.*.length = bindings_length
    builder.*.bindingComponents.*.length = binding_components_length
    return lir.NONE
}

fn lowerIterableFor(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    const iterable_type_id = expressionType(builder, node.lhs)
    if iterable_type_id == 0 { return lir.NONE }
    const iterable_type = types_store.Store.get(builder.*.typeStore, iterable_type_id)
    if iterable_type.*.kind != types_store.Kind.slice && iterable_type.*.kind != types_store.Kind.array { return lir.NONE }
    const element_type = iterable_type.*.lhs
    var stride = types_store.Store.sizeOf(builder.*.typeStore, element_type)
    if stride == 0 { stride = 1 }
    const iterable_value = lowerNode(builder, node.lhs)
    var length_value: usize = 0
    if iterable_type.*.kind == types_store.Kind.slice {
        var length_extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
        length_extract.arg0 = iterable_value
        length_extract.arg1 = 1
        length_value = lir.addInst(builder.*.lir, length_extract)
    } else {
        length_value = lir.addInst(builder.*.lir, lir.constI(lir.NONE, iterable_type.*.bits))
    }

    const bindings_length = builder.*.bindings.*.length
    const binding_components_length = builder.*.bindingComponents.*.length
    const zero = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
    const index_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    var index_store = lir.initInst(lir.Opcode.store, lir.NONE)
    index_store.arg0 = index_address
    index_store.arg1 = zero
    lir.addInst(builder.*.lir, index_store)

    const capture = ast_store.Store.get(nodes, node.extra)
    var capture_type = element_type
    if capture.extra & 1 != 0 { capture_type = types_store.Store.pointer(builder.*.typeStore, element_type, false, false, false) }
    // A slice or another value of several words is stored a word per
    // component, as a local of that type is.
    const capture_name = tokenPointer(builder, capture.mainToken)
    const capture_name_length = tokenLength(builder, capture.mainToken)
    const capture_words = typeWordCount(builder, capture_type)
    const capture_components = builder.*.bindingComponents.*.length
    appendComponentStorage(builder, capture_name, capture_name_length, capture_words)
    pushBindingComponents(builder, capture_name, capture_name_length, capture_components, capture_words, capture_type)
    if capture.endToken != ast.NONE {
        pushBinding(builder, tokenPointer(builder, capture.endToken), tokenLength(builder, capture.endToken), index_address, lir.NONE, lir.NONE, types_store.Store.sizeInteger(builder.*.typeStore, false))
    }

    const header_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const body_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const update_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const end_block = builder.*.blockCounter
    builder.*.blockCounter += 1

    lir.addInst(builder.*.lir, lir.branch(header_block))
    lir.addInst(builder.*.lir, lir.blockLabelInst(header_block))
    var index_load = lir.initInst(lir.Opcode.load, lir.NONE)
    index_load.arg0 = index_address
    const index_value = lir.addInst(builder.*.lir, index_load)
    var comparison = lir.initInst(lir.Opcode.icmp, lir.NONE)
    comparison.arg0 = @intCast(usize, @intFromEnum(lir.CmpPredicate.lt))
    comparison.arg1 = index_value
    comparison.arg2 = length_value
    const condition = lir.addInst(builder.*.lir, comparison)
    lir.addInst(builder.*.lir, lir.condBranch(condition, body_block, end_block))

    lir.addInst(builder.*.lir, lir.blockLabelInst(body_block))
    var element_address_inst = lir.initInst(lir.Opcode.gep, lir.NONE)
    element_address_inst.arg0 = iterable_value
    element_address_inst.arg1 = index_value
    element_address_inst.arg2 = stride
    const element_address = lir.addInst(builder.*.lir, element_address_inst)
    var capture_value = element_address
    if capture.extra & 1 == 0 && aggregate_copy.isMemoryType(builder.*.typeStore, element_type) {
        // A struct, union or array is held by its address, as a `const`
        // local of that type is; loading it would hand the body its first
        // word as that address. The copy keeps the capture a value when the
        // body changes the element through the iterable.
        capture_value = copyAggregate(builder, element_address, element_type, true)
    } else if capture.extra & 1 == 0 {
        capture_value = lowerMemoryValue(builder, element_address, element_type)
    }
    var capture_component: usize = 0
    while capture_component < capture_words {
        var component_value = capture_value
        if capture_component > 0 {
            var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
            extract.arg0 = capture_value
            extract.arg1 = capture_component
            component_value = lir.addInst(builder.*.lir, extract)
        }
        var capture_store = lir.initInst(lir.Opcode.store, if capture_component == 0 { capture_type } else { lir.NONE })
        capture_store.arg0 = bindingComponentAt(builder, capture_components + capture_component)
        capture_store.arg1 = component_value
        capture_store.arg2 = if capture_component == 0 { storageWidth(builder, capture_type) } else { 8 }
        lir.addInst(builder.*.lir, capture_store)
        capture_component += 1
    }

    const result_address = lir.addInst(builder.*.lir, lir.initInst(lir.Opcode.alloca, lir.NONE))
    pushLoopTarget(builder, node.endToken, end_block, update_block, result_address)
    lowerNode(builder, node.rhs)
    popLoopTarget(builder)
    lir.addInst(builder.*.lir, lir.branch(update_block))

    lir.addInst(builder.*.lir, lir.blockLabelInst(update_block))
    index_load = lir.initInst(lir.Opcode.load, lir.NONE)
    index_load.arg0 = index_address
    const current_index = lir.addInst(builder.*.lir, index_load)
    const one = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 1))
    const next_index = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.add, lir.NONE, current_index, one))
    index_store = lir.initInst(lir.Opcode.store, lir.NONE)
    index_store.arg0 = index_address
    index_store.arg1 = next_index
    lir.addInst(builder.*.lir, index_store)
    lir.addInst(builder.*.lir, lir.branch(header_block))

    lir.addInst(builder.*.lir, lir.blockLabelInst(end_block))
    builder.*.bindings.*.length = bindings_length
    builder.*.bindingComponents.*.length = binding_components_length
    return lir.NONE
}

fn lowerBindingInitializer(builder: *LirBuilder, initializer_index: usize, type_id: usize) -> usize {
    const initializer = ast_store.Store.get(getNodes(builder), initializer_index)
    if initializer.tag == ast.Tag.undefined_literal && type_id != 0 {
        const value_type = types_store.Store.get(builder.*.typeStore, type_id)
        if value_type.*.kind == types_store.Kind.struct_type || value_type.*.kind == types_store.Kind.union_type || value_type.*.kind == types_store.Kind.array {
            var size = types_store.Store.sizeOf(builder.*.typeStore, type_id)
            if size < 8 { size = 8 }
            var allocation = lir.initInst(lir.Opcode.alloca, type_id)
            allocation.arg0 = size
            return lir.addInst(builder.*.lir, allocation)
        }
    }
    return lowerNode(builder, initializer_index)
}

// Aggregates are values held by address, so a value that is not freshly
// built (a literal or `undefined`) may be another variable's storage, a
// field or element inside one, or what a call returned from either.
fn isFreshAggregate(builder: *LirBuilder, node_index: usize) -> bool {
    const tag = ast_store.Store.get(getNodes(builder), node_index).tag
    return tag == ast.Tag.aggregate_literal || tag == ast.Tag.array_literal || tag == ast.Tag.tuple_literal || tag == ast.Tag.undefined_literal
}

// A copy of the aggregate at `source` in new storage: a region of the
// frame when `in_frame`, else the aggregate arena, which is never freed.
fn copyAggregate(builder: *LirBuilder, source: usize, type_id: usize, in_frame: bool) -> usize {
    var size = types_store.Store.sizeOf(builder.*.typeStore, type_id)
    if size < 8 { size = 8 }
    var allocation = lir.initInst(lir.Opcode.alloca, type_id)
    allocation.arg0 = size
    if in_frame { allocation.arg1 = 1 }
    const storage = lir.addInst(builder.*.lir, allocation)
    aggregate_copy.emit(builder.*.lir, builder.*.typeStore, storage, source, type_id)
    return storage
}

// A `var` of aggregate type, or an aggregate assigned to a variable, gets
// its own copy unless the value was built just for it: changing the
// variable must not change the value it was made from. The copy is in the
// arena, so the variable's storage can be handed back by `return` as is.
fn ownedAggregate(builder: *LirBuilder, value: usize, value_node: usize, type_id: usize) -> usize {
    if value == lir.NONE || !aggregate_copy.isMemoryType(builder.*.typeStore, type_id) || isFreshAggregate(builder, value_node) { return value }
    return copyAggregate(builder, value, type_id, false)
}

// Whether the value `node_index` produces may be, or point into, a `const`
// local's frame storage: the local itself; a field, element or slice of
// it; what a call given one of those returns (a callee may return its
// parameter's storage); or something not inspected here, such as an `if`
// or `match` expression. Literals and calls without such arguments cannot.
fn mayReferenceFrameStorage(builder: *LirBuilder, node_index: usize) -> bool {
    if node_index == ast.NONE { return false }
    const nodes = getNodes(builder)
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.identifier {
        const binding = findBindingRecord(builder, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
        return @intFromPtr(binding) != 0 && binding.*.frameStorage
    }
    if node.tag == ast.Tag.field_expression || node.tag == ast.Tag.index_expression || node.tag == ast.Tag.slice_expression || node.tag == ast.Tag.unary_expression {
        return mayReferenceFrameStorage(builder, node.lhs)
    }
    if node.tag == ast.Tag.binary_expression {
        return mayReferenceFrameStorage(builder, node.lhs) || mayReferenceFrameStorage(builder, node.rhs)
    }
    if node.tag == ast.Tag.call_expression || node.tag == ast.Tag.builtin_call {
        if node.tag == ast.Tag.call_expression && mayReferenceFrameStorage(builder, node.lhs) { return true }
        var argument = if node.tag == ast.Tag.call_expression { node.rhs } else { node.lhs }
        while argument != ast.NONE {
            if mayReferenceFrameStorage(builder, argument) { return true }
            argument = ast_store.Store.get(nodes, argument).next
        }
        return false
    }
    if isFreshAggregate(builder, node_index) { return false }
    return node.tag != ast.Tag.integer_literal && node.tag != ast.Tag.float_literal && node.tag != ast.Tag.string_literal &&
        node.tag != ast.Tag.byte_string_literal && node.tag != ast.Tag.character_literal && node.tag != ast.Tag.boolean_literal && node.tag != ast.Tag.null_literal
}

// The identifier a field, element or slice path starts from, when it names
// a `const` local held in the frame; else ast.NONE.
fn frameStorageRoot(builder: *LirBuilder, node_index: usize) -> usize {
    var current = node_index
    while current != ast.NONE {
        const node = ast_store.Store.get(getNodes(builder), current)
        if node.tag == ast.Tag.identifier {
            const binding = findBindingRecord(builder, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
            return if @intFromPtr(binding) != 0 && binding.*.frameStorage { current } else { ast.NONE }
        }
        if node.tag != ast.Tag.field_expression && node.tag != ast.Tag.index_expression && node.tag != ast.Tag.slice_expression { return ast.NONE }
        current = node.lhs
    }
    return ast.NONE
}

// The value `return` hands back must outlive the frame. An aggregate that
// may be (part of) a `const` local's frame storage is copied into the
// arena first; a slice into such a local is rebased onto an arena copy of
// the whole local. Only in a function that has such a local; the copy has
// the function's return type (the value's own, as returned).
fn returnedValue(builder: *LirBuilder, value_node: usize, value: usize) -> usize {
    if value == lir.NONE || value_node == ast.NONE || builder.*.frameStorageCount == 0 { return value }
    const value_type = builder.*.currentReturnType
    if value_type == lir.NONE || value_type == 0 { return value }
    if aggregate_copy.isMemoryType(builder.*.typeStore, value_type) {
        if !mayReferenceFrameStorage(builder, value_node) { return value }
        return copyAggregate(builder, value, value_type, false)
    }
    if types_store.Store.get(builder.*.typeStore, value_type).*.kind != types_store.Kind.slice { return value }
    // Only a slice of an array held in the local points into its storage;
    // a slice the local holds (a field of slice type) points elsewhere.
    const sliced = ast_store.Store.get(getNodes(builder), value_node)
    if sliced.tag != ast.Tag.slice_expression { return value }
    const base_type = expressionType(builder, sliced.lhs)
    if base_type == 0 || types_store.Store.get(builder.*.typeStore, base_type).*.kind != types_store.Kind.array { return value }
    const root_node = frameStorageRoot(builder, value_node)
    if root_node == ast.NONE { return value }
    const root = ast_store.Store.get(getNodes(builder), root_node)
    const binding = findBindingRecord(builder, tokenPointer(builder, root.mainToken), tokenLength(builder, root.mainToken))
    const base = lowerNode(builder, root_node)
    const copy = copyAggregate(builder, base, binding.*.typeId, false)
    var pointer_extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
    pointer_extract.arg0 = value
    pointer_extract.arg1 = 0
    const pointer = lir.addInst(builder.*.lir, pointer_extract)
    var length_extract = lir.initInst(lir.Opcode.tuple_element, types_store.Store.sizeInteger(builder.*.typeStore, false))
    length_extract.arg0 = value
    length_extract.arg1 = 1
    const length = lir.addInst(builder.*.lir, length_extract)
    const offset = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.sub, lir.NONE, pointer, base))
    const rebased = lir.addInst(builder.*.lir, lir.binary(lir.Opcode.add, lir.NONE, copy, offset))
    const extra_start = builder.*.lir.*.extraData.*.length
    lir.addExtra(builder.*.lir, rebased)
    lir.addExtra(builder.*.lir, length)
    var result = lir.initInst(lir.Opcode.tuple_literal, value_type)
    result.arg0 = extra_start
    result.arg1 = 2
    return lir.addInst(builder.*.lir, result)
}

fn lowerLocalBinding(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const n = ast_store.Store.get(nodes, node_index)
    if n.rhs == ast.NONE { return lir.NONE }

    const name_ptr = tokenPointer(builder, n.mainToken)
    const name_len = tokenLength(builder, n.mainToken)
    const initializer_type_value = resolveTypeNode(builder, n.rhs)
    if initializer_type_value != 0 {
        pushComptimeBinding(
            builder,
            name_ptr,
            name_len,
            types_store.Store.primitive(builder.*.typeStore, types_store.Kind.type_type),
            initializer_type_value,
            @intCast(u8, @intFromEnum(comptime_value.Kind.type_value)),
            0,
        )
        return lir.NONE
    }

    var local_type = if n.lhs != ast.NONE { resolveTypeNode(builder, n.lhs) } else { expressionType(builder, n.rhs) }
    var init_val = widenToType(builder, narrowFloat(builder, lowerBindingInitializer(builder, n.rhs, local_type), local_type), local_type)
    // A `const` of aggregate type is a value too: a copy in the frame, so
    // that a later store to what it was made from (an array element or a
    // field reached through a pointer, say) does not change what it reads.
    // `return` copies it out of the frame when it hands the local back.
    var frame_storage = false
    if n.tag == ast.Tag.variable_declaration {
        init_val = ownedAggregate(builder, init_val, n.rhs, local_type)
    } else if init_val != lir.NONE && aggregate_copy.isMemoryType(builder.*.typeStore, local_type) && !isFreshAggregate(builder, n.rhs) {
        init_val = copyAggregate(builder, init_val, local_type, true)
        frame_storage = true
    }
    const components_start = builder.*.bindingComponents.*.length
    const component_count = typeWordCount(builder, local_type)
    appendComponentStorage(builder, name_ptr, name_len, component_count)
    var component: usize = 0
    while component < component_count {
        const component_address = bindingComponentAt(builder, components_start + component)
        var component_value = init_val
        if component > 0 {
            var extract = lir.initInst(lir.Opcode.tuple_element, lir.NONE)
            extract.arg0 = init_val
            extract.arg1 = component
            component_value = lir.addInst(builder.*.lir, extract)
        }
        var component_store = lir.initInst(lir.Opcode.store, lir.NONE)
        component_store.arg0 = component_address
        component_store.arg1 = component_value
        component_store.arg2 = if component == 0 { storageWidth(builder, local_type) } else { 8 }
        lir.addInst(builder.*.lir, component_store)
        component += 1
    }
    pushBindingComponents(builder, name_ptr, name_len, components_start, component_count, local_type)
    if frame_storage {
        findBindingRecord(builder, name_ptr, name_len).*.frameStorage = true
        builder.*.frameStorageCount += 1
    }
    // A `const` bool made of literals, of such constants and of the type
    // predicates (`const boxed = @isInteger(T)`) is known at compile time
    // here as sema knows it: an `if` on it takes one branch in both.
    if n.tag == ast.Tag.constant_declaration && component_count == 1 && types_store.Store.get(builder.*.typeStore, local_type).*.kind == types_store.Kind.bool_type && isLocalComptimeExpression(builder, n.rhs) {
        const known = lowerComptimeValue(builder, n.rhs)
        if known.kind == comptime_value.Kind.boolean {
            const record = findBindingRecord(builder, name_ptr, name_len)
            record.*.comptimeTag = @intCast(u8, @intFromEnum(known.kind))
            record.*.comptimeInteger = known.integer
        }
    }
    if component_count > 0 { appendAutoDrop(builder, node_index, bindingComponentAt(builder, components_start), local_type) }

    return lir.NONE
}

// An expression of literals, of locals known at compile time and of the
// type reflection builtins alone: its value is the same here as sema has
// it (a name of the module's scope could be shadowed by a local).
fn isLocalComptimeExpression(builder: *LirBuilder, node_index: usize) -> bool {
    if node_index == ast.NONE { return false }
    const node = ast_store.Store.get(getNodes(builder), node_index)
    if node.tag == ast.Tag.integer_literal || node.tag == ast.Tag.boolean_literal || node.tag == ast.Tag.character_literal { return true }
    if node.tag == ast.Tag.identifier {
        const binding = findBindingRecord(builder, tokenPointer(builder, node.mainToken), tokenLength(builder, node.mainToken))
        return @intFromPtr(binding) != 0 && (binding.*.comptimeTag == @intCast(u8, @intFromEnum(comptime_value.Kind.integer)) || binding.*.comptimeTag == @intCast(u8, @intFromEnum(comptime_value.Kind.boolean)))
    }
    if node.tag == ast.Tag.unary_expression { return isLocalComptimeExpression(builder, node.lhs) }
    if node.tag == ast.Tag.binary_expression { return isLocalComptimeExpression(builder, node.lhs) && isLocalComptimeExpression(builder, node.rhs) }
    if node.tag == ast.Tag.builtin_call {
        const kind = builtins.lookup(builder.*.sourcePointer[0..builder.*.sourceLength], getTokens(builder).*, node.mainToken)
        return kind == builtins.Kind.sizeOf || kind == builtins.Kind.alignOf || kind == builtins.Kind.bitSizeOf || kind == builtins.Kind.fieldCount || kind == builtins.Kind.isInteger || kind == builtins.Kind.isFloat || kind == builtins.Kind.isBool || kind == builtins.Kind.isSigned || kind == builtins.Kind.isStruct || kind == builtins.Kind.isTuple || kind == builtins.Kind.isEnum || kind == builtins.Kind.isUnion || kind == builtins.Kind.isPointer || kind == builtins.Kind.isSlice || kind == builtins.Kind.isArray || kind == builtins.Kind.isOptional || kind == builtins.Kind.isErrorUnion || kind == builtins.Kind.isCopyable
    }
    return false
}

fn lowerAddressOf(builder: *LirBuilder, node_index: usize) -> usize {
    const nodes = getNodes(builder)
    const child = ast_store.Store.get(nodes, node_index)
    if child.tag == ast.Tag.identifier {
        const binding = findBindingRecord(builder, tokenPointer(builder, child.mainToken), tokenLength(builder, child.mainToken))
        const child_type_id = if @intFromPtr(binding) != 0 { binding.*.typeId } else { 0 }
        if child_type_id != 0 {
            const child_type = types_store.Store.get(builder.*.typeStore, child_type_id)
            if child_type.*.kind == types_store.Kind.struct_type || child_type.*.kind == types_store.Kind.union_type || child_type.*.kind == types_store.Kind.array {
                return lowerNode(builder, node_index)
            }
        }
    }
    return lowerAddress(builder, node_index)
}

fn lowerOptionalUnwrap(builder: *LirBuilder, node_index: usize, operand: usize) -> usize {
    const optional_type_id = expressionType(builder, node_index)
    if optional_type_id == 0 { return operand }
    const optional_type = types_store.Store.get(builder.*.typeStore, optional_type_id)
    if optional_type.*.kind != types_store.Kind.optional { return operand }
    const child_type = types_store.Store.get(builder.*.typeStore, optional_type.*.lhs)
    if isTaggedOptional(builder, optional_type_id) {
        if builder.*.runtimeSafety {
            const absent = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
            emitTrapIf(builder, emitComparison(builder, lir.CmpPredicate.eq, optionalTag(builder, operand, optional_type_id), absent))
        }
        return optionalPayload(builder, operand, optional_type_id)
    }
    if builder.*.runtimeSafety && (child_type.*.kind == types_store.Kind.pointer || child_type.*.kind == types_store.Kind.many_pointer) {
        const zero = lir.addInst(builder.*.lir, lir.constI(optional_type_id, 0))
        emitTrapIf(builder, emitComparison(builder, lir.CmpPredicate.eq, operand, zero))
    }
    return operand
}

fn lowerTry(builder: *LirBuilder, node_index: usize, operand: usize) -> usize {
    var error_test_inst = lir.initInst(lir.Opcode.error_test, lir.NONE)
    error_test_inst.arg0 = operand
    const error_value = lir.addInst(builder.*.lir, error_test_inst)
    const error_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    const success_block = builder.*.blockCounter
    builder.*.blockCounter += 1
    lir.addInst(builder.*.lir, lir.condBranch(error_value, error_block, success_block))
    lir.addInst(builder.*.lir, lir.blockLabelInst(error_block))
    emitDefersTo(builder, 0)
    var error_return = lir.initInst(lir.Opcode.ret_error, builder.*.currentReturnType)
    error_return.arg0 = error_value
    lir.addInst(builder.*.lir, error_return)
    lir.addInst(builder.*.lir, lir.blockLabelInst(success_block))
    var payload = lir.initInst(lir.Opcode.error_payload, expressionType(builder, node_index))
    payload.arg0 = operand
    return lir.addInst(builder.*.lir, payload)
}

fn lowerDereference(builder: *LirBuilder, node_index: usize, operand: usize) -> usize {
    const pointer_type_id = expressionType(builder, node_index)
    if pointer_type_id == 0 { return operand }
    const pointer_type = types_store.Store.get(builder.*.typeStore, pointer_type_id)
    if pointer_type.*.kind != types_store.Kind.pointer && pointer_type.*.kind != types_store.Kind.many_pointer { return operand }
    // Aggregate values are represented by their address in the bootstrap
    // ABI; a value of several words (a slice, an optional slice) is loaded
    // word by word, so `pointer.*.length` reads the length and not what
    // happened to follow the first word; a narrow signed value read through
    // a pointer is sign-extended like every other load of its type, so
    // `pointer.* >= 0` holds for -1.
    return lowerMemoryValue(builder, operand, pointer_type.*.lhs)
}

fn lowerUnaryValue(builder: *LirBuilder, kind: lexer.Kind, operand: usize) -> usize {
    var context = wideContext(builder)
    if wide.isWideValue(&context, operand) {
        const operand_type = lir.getInst(builder.*.lir, operand).typeId
        if !wide.isSupported(builder.*.typeStore, operand_type) {
            recordUnsupportedWide(builder)
            return operand
        }
        if kind == lexer.Kind.minus { return wide.negate(&context, operand_type, operand) }
        if kind == lexer.Kind.tilde { return wide.complement(&context, operand_type, operand) }
        if kind == lexer.Kind.bang { return wide.isZero(&context, operand) }
        return operand
    }
    if kind == lexer.Kind.minus {
        // A float operand keeps its type, so the backend subtracts floats:
        // a float literal whose semantic type came from context (the
        // destination of @intFromFloat, or an inlined f64 parameter) would
        // otherwise be negated as an integer bit pattern.
        var result_type = lir.NONE
        if operand != lir.NONE {
            const operand_type = lir.getInst(builder.*.lir, operand).typeId
            if operand_type != lir.NONE && operand_type != 0 && operand_type < types_store.Store.count(builder.*.typeStore) {
                const operand_kind = types_store.Store.get(builder.*.typeStore, operand_type).*.kind
                if operand_kind == types_store.Kind.float || operand_kind == types_store.Kind.comptime_float_type { result_type = operand_type }
            }
        }
        const zero = lir.addInst(builder.*.lir, lir.constI(result_type, 0))
        return lir.addInst(builder.*.lir, lir.binary(lir.Opcode.sub, result_type, zero, operand))
    }
    if kind == lexer.Kind.bang {
        var inst = lir.initInst(lir.Opcode.icmp, lir.NONE)
        inst.arg0 = @intCast(usize, @intFromEnum(lir.CmpPredicate.eq))
        inst.arg1 = operand
        const zero = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 0))
        inst.arg2 = zero
        return lir.addInst(builder.*.lir, inst)
    }
    if kind == lexer.Kind.tilde {
        const all_ones = lir.addInst(builder.*.lir, lir.constI(lir.NONE, 18446744073709551615))
        return lir.addInst(builder.*.lir, lir.binary(lir.Opcode.bit_xor, lir.NONE, operand, all_ones))
    }
    return operand
}

fn lowerUnary(builder: *LirBuilder, node_index: usize) -> usize {
    const n = ast_store.Store.get(getNodes(builder), node_index)
    const kind = tokenKind(builder, n.mainToken)
    builder.*.operatorToken = n.mainToken
    if kind == lexer.Kind.ampersand { return lowerAddressOf(builder, n.lhs) }
    const operand = lowerNode(builder, n.lhs)
    if kind == lexer.Kind.dot_question { return lowerOptionalUnwrap(builder, n.lhs, operand) }
    if kind == lexer.Kind.keyword_try { return lowerTry(builder, node_index, operand) }
    if kind == lexer.Kind.dot_asterisk { return lowerDereference(builder, n.lhs, operand) }
    return lowerUnaryValue(builder, kind, operand)
}
