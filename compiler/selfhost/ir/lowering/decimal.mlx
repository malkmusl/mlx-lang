// Decimal float literals to the nearest f64, ties to even, as strtod does.
// Digits read one by one into an f64 and divided by ten as often as there
// were decimals round at every step: 1.7976931348623157e308 came out six
// units in the last place too small, 1e-300 thirteen. Here a literal whose
// digits and power of ten are both exact in an f64 takes one rounded
// multiplication or division (Clinger's fast path); any other is worked out
// exactly with big integers: the digits over the power of ten scaled to a
// 64-bit quotient, the rest of the division deciding the rounding.

// Limbs of 32 bits: enough for 10^1130 (the smallest literal's divisor)
// shifted by 64 bits, with room.
const LIMBS: usize = 160
// Significant digits kept. Deciding a tie needs at most 768; a digit past
// these that is not zero only says the value is above the kept ones (the
// remainder of the division is then never zero).
const DIGITS: usize = 780
// Past these powers of ten the value is infinite or zero.
const LARGEST_POWER: isize = 310
const SMALLEST_POWER: isize = -330

const INFINITY_BITS: u64 = 9218868437227405312

// The bits of the f64 nearest to the literal text[0..length] (digits,
// at most one point, an optional exponent: e or E, a sign, digits).
pub fn parse(text: [*]const u8, length: usize) -> u64 {
    var digits: [780]u8 = undefined
    var count: usize = 0
    var dropped_nonzero = false
    var fraction_digits: isize = 0
    var dropped_integer_digits: isize = 0
    var in_fraction = false
    var index: usize = 0
    while index < length && text[index] != 101 && text[index] != 69 {
        const byte = text[index]
        if byte == 46 {
            in_fraction = true
        } else if byte >= 48 && byte <= 57 {
            if count == 0 && byte == 48 {
                // A leading zero: only where the point is counts.
                if in_fraction { fraction_digits += 1 }
            } else if count < DIGITS {
                digits[count] = byte - 48
                count += 1
                if in_fraction { fraction_digits += 1 }
            } else {
                if byte != 48 { dropped_nonzero = true }
                if !in_fraction { dropped_integer_digits += 1 }
            }
        }
        index += 1
    }
    var exponent: isize = 0
    if index < length {
        index += 1
        var negative = false
        if index < length && (text[index] == 43 || text[index] == 45) {
            negative = text[index] == 45
            index += 1
        }
        while index < length {
            const byte = text[index]
            if byte >= 48 && byte <= 57 && exponent < 100000 { exponent = exponent * 10 + @intCast(isize, byte - 48) }
            index += 1
        }
        if negative { exponent = 0 - exponent }
    }
    if count == 0 { return 0 }
    // value = digits * 10^power (and a little more when digits were dropped)
    const power = exponent - fraction_digits + dropped_integer_digits
    const magnitude = power + @intCast(isize, count)
    if magnitude > LARGEST_POWER { return INFINITY_BITS }
    if magnitude < SMALLEST_POWER { return 0 }
    if count <= 15 && power >= -22 && power <= 22 { return fast(&digits, count, power) }
    return exact(&digits, count, power, dropped_nonzero)
}

// Up to 15 digits are exact in an f64, and so are the powers of ten up to
// 10^22: one rounded operation gives the nearest f64.
fn fast(digits: *[780]u8, count: usize, power: isize) -> u64 {
    var whole: u64 = 0
    var at: usize = 0
    while at < count {
        whole = whole * 10 + @intCast(u64, digits.*[at])
        at += 1
    }
    const value: f64 = @floatFromInt(f64, @intCast(i64, whole))
    var scale: f64 = 1.0
    var steps: isize = if power < 0 { 0 - power } else { power }
    while steps > 0 {
        scale = scale * 10.0
        steps -= 1
    }
    const result = if power < 0 { value / scale } else { value * scale }
    return @bitCast(u64, result)
}

// ---------------------------------------------------------------------------
// Big integers: limbs of 32 bits, the lowest first; a length in limbs.

fn bigSmall(limbs: [*]u32, value: u32) -> usize {
    limbs[0] = value
    return if value == 0 { 0 } else { 1 }
}

// limbs * factor + addend.
fn bigMultiplyAdd(limbs: [*]u32, length: usize, factor: u32, addend: u32) -> usize {
    var carry: u64 = @intCast(u64, addend)
    var at: usize = 0
    while at < length {
        const product = @intCast(u64, limbs[at]) * @intCast(u64, factor) + carry
        limbs[at] = @intCast(u32, product & 4294967295)
        carry = product >> 32
        at += 1
    }
    var grown = length
    if carry != 0 {
        limbs[grown] = @intCast(u32, carry)
        grown += 1
    }
    return grown
}

fn bigShiftLeft(limbs: [*]u32, length: usize, bits: usize) -> usize {
    if length == 0 { return 0 }
    const whole = bits / 32
    const part = bits % 32
    var grown = length + whole + 1
    var at = grown
    while at > 0 {
        at -= 1
        var value: u64 = 0
        if at >= whole && at - whole < length {
            value = @intCast(u64, limbs[at - whole]) << @intCast(u64, part)
        }
        if part > 0 && at >= whole + 1 && at - whole - 1 < length {
            value = value | (@intCast(u64, limbs[at - whole - 1]) >> @intCast(u64, 32 - part))
        }
        limbs[at] = @intCast(u32, value & 4294967295)
    }
    while grown > 0 && limbs[grown - 1] == 0 { grown -= 1 }
    return grown
}

fn bigShiftRightOne(limbs: [*]u32, length: usize) -> usize {
    var at: usize = 0
    while at < length {
        var value = limbs[at] >> 1
        if at + 1 < length { value = value | ((limbs[at + 1] & 1) << 31) }
        limbs[at] = value
        at += 1
    }
    var shrunk = length
    while shrunk > 0 && limbs[shrunk - 1] == 0 { shrunk -= 1 }
    return shrunk
}

fn bigBits(limbs: [*]u32, length: usize) -> usize {
    if length == 0 { return 0 }
    var top = limbs[length - 1]
    var bits = (length - 1) * 32
    while top != 0 {
        bits += 1
        top = top >> 1
    }
    return bits
}

// -1, 0 or 1 as a is less than, equal to or more than b.
fn bigCompare(a: [*]u32, a_length: usize, b: [*]u32, b_length: usize) -> i32 {
    if a_length != b_length { return if a_length < b_length { -1 } else { 1 } }
    var at = a_length
    while at > 0 {
        at -= 1
        if a[at] != b[at] { return if a[at] < b[at] { -1 } else { 1 } }
    }
    return 0
}

// a - b, with a at least b.
fn bigSubtract(a: [*]u32, a_length: usize, b: [*]u32, b_length: usize) -> usize {
    var borrow: u64 = 0
    var at: usize = 0
    while at < a_length {
        const right: u64 = (if at < b_length { @intCast(u64, b[at]) } else { 0 }) + borrow
        const left = @intCast(u64, a[at])
        if left >= right {
            a[at] = @intCast(u32, left - right)
            borrow = 0
        } else {
            a[at] = @intCast(u32, left + 4294967296 - right)
            borrow = 1
        }
        at += 1
    }
    var shrunk = a_length
    while shrunk > 0 && a[shrunk - 1] == 0 { shrunk -= 1 }
    return shrunk
}

// ---------------------------------------------------------------------------

// digits * 10^power exactly: numerator over denominator, scaled by 2^shift
// so that their quotient has 63 or 64 bits; that quotient, rounded to 53
// bits (fewer below the normal range) with the remainder, or digits
// dropped past the kept ones (`more`), as the sticky bit.
fn exact(digits: *[780]u8, count: usize, power: isize, more: bool) -> u64 {
    var numerator_store: [160]u32 = undefined
    var denominator_store: [160]u32 = undefined
    var numerator: [*]u32 = undefined
    var denominator: [*]u32 = undefined
    unsafe {
        numerator = @ptrCast([*]u32, &numerator_store)
        denominator = @ptrCast([*]u32, &denominator_store)
    }
    var at: usize = 0
    while at < LIMBS {
        numerator[at] = 0
        denominator[at] = 0
        at += 1
    }
    var numerator_length: usize = 0
    at = 0
    while at < count {
        numerator_length = bigMultiplyAdd(numerator, numerator_length, 10, @intCast(u32, digits.*[at]))
        at += 1
    }
    var denominator_length = bigSmall(denominator, 1)
    var steps: isize = if power < 0 { 0 - power } else { power }
    while steps > 0 {
        if power > 0 {
            numerator_length = bigMultiplyAdd(numerator, numerator_length, 10, 0)
        } else {
            denominator_length = bigMultiplyAdd(denominator, denominator_length, 10, 0)
        }
        steps -= 1
    }
    // The quotient numerator * 2^shift / denominator in [2^62, 2^64).
    const numerator_bits = @intCast(isize, bigBits(numerator, numerator_length))
    const denominator_bits = @intCast(isize, bigBits(denominator, denominator_length))
    const shift: isize = 63 - (numerator_bits - denominator_bits)
    if shift > 0 {
        numerator_length = bigShiftLeft(numerator, numerator_length, @intCast(usize, shift))
    } else if shift < 0 {
        denominator_length = bigShiftLeft(denominator, denominator_length, @intCast(usize, 0 - shift))
    }
    // Long division, a bit of the quotient at a time from bit 63.
    denominator_length = bigShiftLeft(denominator, denominator_length, 63)
    var quotient: u64 = 0
    var bit: usize = 64
    while bit > 0 {
        bit -= 1
        if bigCompare(numerator, numerator_length, denominator, denominator_length) >= 0 {
            numerator_length = bigSubtract(numerator, numerator_length, denominator, denominator_length)
            quotient = quotient | (@intCast(u64, 1) << @intCast(u64, bit))
        }
        denominator_length = bigShiftRightOne(denominator, denominator_length)
    }
    return round(quotient, shift, numerator_length != 0 || more)
}

// The f64 nearest to quotient * 2^-shift (quotient of 63 or 64 bits, more
// below when sticky).
fn round(quotient: u64, shift: isize, sticky: bool) -> u64 {
    var bits: isize = 64
    while bits > 0 && (quotient >> @intCast(u64, bits - 1)) & 1 == 0 { bits -= 1 }
    // The exponent of the leading bit, and the bits below the 53 kept.
    var exponent = bits - 1 - shift
    var drop = bits - 53
    if exponent < -1022 { drop += -1022 - exponent }
    if drop >= 65 { return 0 }
    var mantissa: u64 = 0
    var low: u64 = 0
    var half: u64 = 0
    if drop == 64 {
        low = quotient
        half = 9223372036854775808
    } else {
        mantissa = quotient >> @intCast(u64, drop)
        low = quotient & ((@intCast(u64, 1) << @intCast(u64, drop)) - 1)
        half = @intCast(u64, 1) << @intCast(u64, drop - 1)
    }
    if low > half || (low == half && (sticky || mantissa & 1 == 1)) { mantissa += 1 }
    if exponent < -1022 {
        // Below the normal range: the exponent field 0, or 1 when rounding
        // carried into the smallest normal (mantissa 2^52 is just that).
        return mantissa
    }
    if mantissa == 9007199254740992 {
        mantissa = 4503599627370496
        exponent += 1
    }
    if exponent > 1023 { return INFINITY_BITS }
    return (@intCast(u64, exponent + 1023) << 52) | (mantissa - 4503599627370496)
}
