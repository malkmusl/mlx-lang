const lir = @import("../lir.mlx")
const types = @import("../../sema/types/store.mlx")

pub fn isMemoryType(type_store: *types.Store, type_id: usize) -> bool {
    if type_id == 0 || type_id == 18446744073709551615 { return false }
    const value = types.Store.get(type_store, type_id)
    if value.*.kind == types.Kind.struct_type || value.*.kind == types.Kind.union_type || value.*.kind == types.Kind.array { return true }
    // An optional of a struct, union or array is one too: the payload
    // and then its tag byte (ir/lower.mlx, isTaggedOptional).
    if value.*.kind == types.Kind.optional && value.*.lhs != 0 { return isMemoryType(type_store, value.*.lhs) }
    return false
}

// One mem_copy of the whole value: backends turn it into a call to a small
// copy routine (aarch64) or a string move (x86_64), far smaller than a load
// and a store per word.
pub fn emit(ir: *lir.Lir, type_store: *types.Store, destination: usize, source: usize, type_id: usize) -> void {
    const size = types.Store.sizeOf(type_store, type_id)
    if size == 0 { return }
    var copy = lir.initInst(lir.Opcode.mem_copy, lir.NONE)
    copy.arg0 = destination
    copy.arg1 = source
    copy.arg2 = size
    lir.addInst(ir, copy)
}
