const lir = @import("../lir.mlx")
const types = @import("../../sema/types/store.mlx")

pub fn isMemoryType(type_store: *types.Store, type_id: usize) -> bool {
    if type_id == 0 { return false }
    const value = types.Store.get(type_store, type_id)
    return value.*.kind == types.Kind.struct_type || value.*.kind == types.Kind.union_type || value.*.kind == types.Kind.array
}

fn addressAt(ir: *lir.Lir, base: usize, offset: usize) -> usize {
    const offset_value = lir.addInst(ir, lir.constI(lir.NONE, offset))
    var address = lir.initInst(lir.Opcode.gep, lir.NONE)
    address.arg0 = base
    address.arg1 = offset_value
    address.arg2 = 1
    return lir.addInst(ir, address)
}

fn copyWidth(ir: *lir.Lir, destination: usize, source: usize, offset: usize, width: usize) -> void {
    const source_address = addressAt(ir, source, offset)
    const destination_address = addressAt(ir, destination, offset)
    var load = lir.initInst(lir.Opcode.load, lir.NONE)
    load.arg0 = source_address
    load.arg1 = width
    const component = lir.addInst(ir, load)
    var store = lir.initInst(lir.Opcode.store, lir.NONE)
    store.arg0 = destination_address
    store.arg1 = component
    store.arg2 = width
    lir.addInst(ir, store)
}

pub fn emit(ir: *lir.Lir, type_store: *types.Store, destination: usize, source: usize, type_id: usize) -> void {
    const size = types.Store.sizeOf(type_store, type_id)
    var offset: usize = 0
    while offset < size {
        const remaining = size - offset
        const width: usize = if remaining >= 8 { 8 } else if remaining >= 4 { 4 } else if remaining >= 2 { 2 } else { 1 }
        copyWidth(ir, destination, source, offset, width)
        offset += width
    }
}
