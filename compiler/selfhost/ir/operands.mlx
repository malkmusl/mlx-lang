// The values an LIR instruction reads. optimize.mlx counts them (a pure
// value nothing reads is dropped); the x86_64 backend notes the last
// instruction reading each (a value it keeps out of its frame slot has to
// be put there before a later block reads that slot).
const lir = @import("./lir.mlx")

// What `visit` does with each value read: add one to its entry (COUNT),
// or set its entry to the reading instruction's index (LAST).
pub const COUNT: usize = 0
pub const LAST: usize = 1

pub fn visit(ir: *lir.Lir, index: usize, inst: lir.Inst, table: [*]usize, count: usize, mode: usize) -> void {
    if isUnaryValue(inst.opcode) {
        note(table, count, inst.arg0, index, mode)
        return
    }
    if isBinaryValue(inst.opcode) {
        note(table, count, inst.arg0, index, mode)
        note(table, count, inst.arg1, index, mode)
        return
    }
    if isTernaryValue(inst.opcode) {
        note(table, count, inst.arg0, index, mode)
        note(table, count, inst.arg1, index, mode)
        note(table, count, inst.arg2, index, mode)
        return
    }
    if inst.opcode == lir.Opcode.icmp || inst.opcode == lir.Opcode.fcmp {
        note(table, count, inst.arg1, index, mode)
        note(table, count, inst.arg2, index, mode)
        return
    }
    if inst.opcode == lir.Opcode.condbr || inst.opcode == lir.Opcode.ret || inst.opcode == lir.Opcode.ret_error || inst.opcode == lir.Opcode.ret_error_union {
        note(table, count, inst.arg0, index, mode)
        return
    }
    // A fused comparison's operands sit on the comparison it replaced.
    if inst.opcode == lir.Opcode.icmp_br {
        const comparison = lir.getInst(ir, inst.arg0)
        note(table, count, comparison.arg1, index, mode)
        note(table, count, comparison.arg2, index, mode)
        return
    }
    if inst.opcode == lir.Opcode.ret_slice {
        note(table, count, inst.arg0, index, mode)
        note(table, count, inst.arg1, index, mode)
        return
    }
    if inst.opcode == lir.Opcode.call || inst.opcode == lir.Opcode.syscall {
        note(table, count, inst.arg0, index, mode)
        noteExtras(ir, inst.arg1, inst.arg2, table, count, index, mode)
    }
    if inst.opcode == lir.Opcode.direct_call { noteExtras(ir, inst.arg1, inst.arg2, table, count, index, mode) }
    if inst.opcode == lir.Opcode.tuple_literal || inst.opcode == lir.Opcode.clone_thread { noteExtras(ir, inst.arg0, inst.arg1, table, count, index, mode) }
}

fn note(table: [*]usize, count: usize, value: usize, index: usize, mode: usize) -> void {
    if value == lir.NONE || value >= count { return }
    if mode == COUNT { table[value] += 1 } else { table[value] = index }
}

fn noteExtras(ir: *lir.Lir, start: usize, length: usize, table: [*]usize, count: usize, index: usize, mode: usize) -> void {
    var at: usize = 0
    while at < length {
        note(table, count, lir.getExtra(ir, start + at), index, mode)
        at += 1
    }
}

pub fn isUnaryValue(opcode: lir.Opcode) -> bool {
    return opcode == lir.Opcode.copy || opcode == lir.Opcode.cast || opcode == lir.Opcode.bitcast ||
        opcode == lir.Opcode.aggregate_copy || opcode == lir.Opcode.load || opcode == lir.Opcode.popcount || opcode == lir.Opcode.sqrt || opcode == lir.Opcode.round_float || opcode == lir.Opcode.error_test ||
        opcode == lir.Opcode.error_payload || opcode == lir.Opcode.error_payload_part || opcode == lir.Opcode.tuple_element || opcode == lir.Opcode.atomic_load
}

pub fn isBinaryValue(opcode: lir.Opcode) -> bool {
    return opcode == lir.Opcode.add || opcode == lir.Opcode.sub || opcode == lir.Opcode.mul || opcode == lir.Opcode.div ||
        opcode == lir.Opcode.rem || opcode == lir.Opcode.udiv || opcode == lir.Opcode.urem || opcode == lir.Opcode.bit_and ||
        opcode == lir.Opcode.bit_or || opcode == lir.Opcode.bit_xor || opcode == lir.Opcode.shl || opcode == lir.Opcode.shr || opcode == lir.Opcode.byte_mask_64 ||
        opcode == lir.Opcode.store || opcode == lir.Opcode.gep || opcode == lir.Opcode.mem_copy || opcode == lir.Opcode.atomic_store || opcode == lir.Opcode.atomic_rmw
}

// A compare-exchange reads three values: the address, the expected value
// and the new one.
pub fn isTernaryValue(opcode: lir.Opcode) -> bool { return opcode == lir.Opcode.cmpxchg }
