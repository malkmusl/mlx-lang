const model = @import("./modules/model.zin")
const path_module = @import("./modules/path.zin")
const packages = @import("./modules/packages.zin")
const loader_module = @import("./modules/loader.zin")
const analyze = @import("./modules/analyze.zin")

pub const NONE = model.NONE
pub const ImportKind = model.ImportKind
pub const State = model.State
pub const Module = model.Module
pub const OwnedPath = path_module.OwnedPath
pub const PackageMap = packages.Map
pub const Loader = loader_module.Loader
pub const Allocator = loader_module.Allocator
pub const TypeStore = analyze.TypeStore
pub const SymbolStore = analyze.SymbolStore

pub fn classify(pointer: [*]const u8, length: usize) -> ImportKind { return path_module.classify(pointer, length) }
pub fn normalize(allocator: Allocator, pointer: [*]const u8, length: usize) -> OwnedPath { return path_module.normalize(allocator, pointer, length) }
pub fn resolveRelative(allocator: Allocator, importer: [*]const u8, importer_length: usize, requested: [*]const u8, requested_length: usize) -> OwnedPath { return path_module.resolveRelative(allocator, importer, importer_length, requested, requested_length) }
pub fn resolveStandard(allocator: Allocator, std_root: [*]const u8, std_root_length: usize, requested: [*]const u8, requested_length: usize) -> OwnedPath { return path_module.resolveStandard(allocator, std_root, std_root_length, requested, requested_length) }
pub fn deinitPath(value: OwnedPath) -> void { path_module.deinit(value) }

pub fn initPackages(allocator: Allocator, capacity: usize) -> *PackageMap { return packages.create(allocator, capacity) }
pub fn putPackage(map: *PackageMap, name: [*]const u8, name_length: usize, root: [*]const u8, root_length: usize) -> bool { return packages.put(map, name, name_length, root, root_length) }
pub fn deinitPackages(map: *PackageMap) -> void { packages.destroy(map) }

pub fn initLoader(allocator: Allocator, std_root: [*]const u8, std_root_length: usize, package_map: ?*PackageMap) -> *Loader { return loader_module.create(allocator, std_root, std_root_length, package_map) }
pub fn loadRoot(loader: *Loader, pointer: [*]const u8, length: usize) -> usize { return loader_module.loadRoot(loader, pointer, length) }
pub fn moduleAt(loader: *Loader, id: usize) -> *Module { return loader_module.moduleAt(loader, id) }
pub fn moduleCount(loader: *Loader) -> usize { return loader_module.moduleCount(loader) }
pub fn importCount(loader: *Loader) -> usize { return loader_module.importCount(loader) }
pub fn prepare(loader: *Loader, types: *TypeStore, symbols: *SymbolStore) -> usize { return analyze.prepare(loader, types, symbols) }
pub fn analyzeDeclarations(loader: *Loader, types: *TypeStore, symbols: *SymbolStore) -> usize { return analyze.declarations(loader, types, symbols) }
pub fn analyzeFunctionBodies(loader: *Loader, types: *TypeStore, symbols: *SymbolStore) -> usize { return analyze.functionBodies(loader, types, symbols) }
pub fn totalErrors(loader: *Loader) -> usize { return analyze.totalErrors(loader) }
pub fn deinitLoader(loader: *Loader) -> void { loader_module.deinit(loader) }
