const allocator_module = @import("../../std/bootstrap/allocator.mlx")
const kind = @import("./sema/types/kind.mlx")
const type_module = @import("./sema/types/type.mlx")
const store = @import("./sema/types/store.mlx")
const resolve_module = @import("./sema/types/resolve.mlx")

pub const Allocator = allocator_module.Allocator
pub const Kind = kind.Kind
pub const Copyability = kind.Copyability
pub const FLAG_SIGNED = kind.FLAG_SIGNED
pub const FLAG_CONSTANT = kind.FLAG_CONSTANT
pub const FLAG_VOLATILE = kind.FLAG_VOLATILE
pub const FLAG_PLATFORM_SIZE = kind.FLAG_PLATFORM_SIZE
pub const FLAG_LAYOUT_COMPLETE = kind.FLAG_LAYOUT_COMPLETE
pub const Type = type_module.Type
pub const Field = store.Field
pub const Id = type_module.Id
pub const NONE = type_module.NONE
pub const Store = store.Store
pub const Buffer = resolve_module.Buffer
pub const NodeStore = resolve_module.NodeStore

pub fn init(allocator: Allocator) -> Store { return store.Store.init(allocator) }
pub fn get(types: *Store, id: Id) -> *Type { return store.Store.get(types, id) }
pub fn count(types: *Store) -> usize { return store.Store.count(types) }
pub fn internCallCount(types: *Store) -> usize { return store.Store.internCallCount(types) }
pub fn internProbeCount(types: *Store) -> usize { return store.Store.internProbeCount(types) }
pub fn maxInternProbeCount(types: *Store) -> usize { return store.Store.maxInternProbeCount(types) }
pub fn primitiveCacheHitCount(types: *Store) -> usize { return store.Store.primitiveCacheHitCount(types) }
pub fn primitive(types: *Store, type_kind: Kind) -> Id { return store.Store.primitive(types, type_kind) }
pub fn integer(types: *Store, signed: bool, bits: usize) -> Id { return store.Store.integer(types, signed, bits) }
pub fn sizeInteger(types: *Store, signed: bool) -> Id { return store.Store.sizeInteger(types, signed) }
pub fn float(types: *Store, bits: usize) -> Id { return store.Store.float(types, bits) }
pub fn pointer(types: *Store, child: Id, is_const: bool, is_volatile: bool, many: bool) -> Id { return store.Store.pointer(types, child, is_const, is_volatile, many) }
pub fn slice(types: *Store, child: Id, is_const: bool) -> Id { return store.Store.slice(types, child, is_const) }
pub fn array(types: *Store, child: Id, length: usize) -> Id { return store.Store.array(types, child, length) }
pub fn vectorType(types: *Store, child: Id, length: usize) -> Id { return store.Store.vectorType(types, child, length) }
pub fn optional(types: *Store, child: Id) -> Id { return store.Store.optional(types, child) }
pub fn errorUnion(types: *Store, error_set: Id, payload: Id) -> Id { return store.Store.errorUnion(types, error_set, payload) }
pub fn noCopy(types: *Store, base: Id) -> Id { return store.Store.noCopy(types, base) }
pub fn appendExtra(types: *Store, id: Id) -> usize { return store.Store.appendExtra(types, id) }
pub fn extraAt(types: *Store, index: usize) -> Id { return store.Store.extraAt(types, index) }
pub fn setExtra(types: *Store, index: usize, id: Id) -> void { store.Store.setExtra(types, index, id) }
pub fn function(types: *Store, result: Id, start: usize, length: usize) -> Id { return store.Store.function(types, result, start, length) }
pub fn tuple(types: *Store, start: usize, length: usize) -> Id { return store.Store.tuple(types, start, length) }
pub fn aggregate(types: *Store, type_kind: Kind, declaration: usize, copyability: Copyability) -> Id { return store.Store.aggregate(types, type_kind, declaration, copyability) }
pub fn moduleType(types: *Store, module_id: usize, declarations_start: usize, declaration_count: usize) -> Id { return store.Store.moduleType(types, module_id, declarations_start, declaration_count) }
pub fn appendField(types: *Store, field: *Field) -> usize { return store.Store.appendField(types, field) }
pub fn fieldAt(types: *Store, index: usize) -> *Field { return store.Store.fieldAt(types, index) }
pub fn completeAggregate(types: *Store, id: Id, fields_start: usize, field_count: usize, size: usize, alignment: usize, copyability: Copyability) -> bool { return store.Store.completeAggregate(types, id, fields_start, field_count, size, alignment, copyability) }
pub fn resolve(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *Store, node_index: usize) -> Id { return resolve_module.resolve(source, tokens, nodes, types, node_index) }
pub fn resolveName(source: []const u8, tokens: Buffer, token_index: usize, types: *Store) -> Id { return resolve_module.resolveName(source, tokens, token_index, types) }
pub fn parseUnsigned(source: []const u8, tokens: Buffer, token_index: usize) -> usize { return resolve_module.parseUnsigned(source, tokens, token_index) }
pub fn sizeOf(types: *Store, id: Id) -> usize { return store.Store.sizeOf(types, id) }
pub fn bitSizeOf(types: *Store, id: Id) -> usize { return store.Store.bitSizeOf(types, id) }
pub fn alignOf(types: *Store, id: Id) -> usize { return store.Store.alignOf(types, id) }
pub fn isCoercible(types: *Store, from: Id, to: Id) -> bool { return store.Store.isCoercible(types, from, to) }
pub fn deinit(types: *Store) -> void { store.Store.deinit(types) }
