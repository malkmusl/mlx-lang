// A compiler's unit handed to the linker as it is in memory: mlx-cc
// compiles `mlx-cc -o PROGRAM x.c ...` into one relocatable object
// (relocatable.Object) and runs mlx-ld on it; this is the form it goes
// over in, so that mlx-ld links exactly what mlx-cc's own linker linked
// when it was part of mlx-cc (the sections, symbols and relocations in
// their order, the sections' alignments, no section symbols added), and
// the program comes out byte for byte as it did. A `.o` file (ELF ET_REL,
// relocatable.write) is the form for everything else; its reader
// rearranges the symbols (the section symbols first, the locals before
// the globals), which changes where things land.
//
// The bytes, every number a little-endian u64:
//
//     "MLXUNIT1"
//     path length, path bytes
//     section count; each: kind, alignment, length, has bytes (0/1),
//         the bytes when it has them
//     symbol count; each: name length, name bytes, binding, kind,
//         section, value, size
//     relocation count; each: section, offset, kind, symbol, addend
const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")
const elf = @import("../../../std/bootstrap/elf.mlx")
const relocatable = @import("./relocatable.mlx")

pub const Allocator = allocator_module.Allocator

const MAGIC: []const u8 = "MLXUNIT1"

fn pointerAt(base: [*]const u8, offset: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(base) + offset) }
}

// The serialized size of OBJECT.
fn size(object: *relocatable.Object) -> usize {
    var total: usize = MAGIC.length + 8 + object.*.pathLength + 8
    var index: usize = 0
    while index < relocatable.sectionCount(object) {
        const section = relocatable.sectionAt(object, index)
        total += 32
        if @intFromPtr(section.*.bytes) != 0 { total += section.*.length }
        index += 1
    }
    total += 8
    index = 0
    while index < relocatable.symbolCount(object) {
        total += 48 + relocatable.symbolAt(object, index).*.nameLength
        index += 1
    }
    return total + 8 + relocatable.relocationCount(object) * 40
}

fn putWord(buffer: [*]u8, at: *usize, value: usize) -> void {
    elf.writeU64(buffer, at.*, @intCast(u64, value))
    at.* += 8
}

fn putBytes(buffer: [*]u8, at: *usize, bytes: [*]const u8, length: usize) -> void {
    if length > 0 { mem.copy(pointerAt(buffer, at.*), bytes, length) }
    at.* += length
}

// OBJECT's bytes in ALLOCATOR's memory; (null, 0) without memory.
pub fn bytes(object: *relocatable.Object, allocator: Allocator) -> (?[*]u8, usize) {
    const total = size(object)
    const memory = allocator.alloc(total, 8)
    if memory == null { return -> (memory, 0) }
    const buffer = memory.?
    var at: usize = 0
    putBytes(buffer, &at, MAGIC.pointer, MAGIC.length)
    putWord(buffer, &at, object.*.pathLength)
    putBytes(buffer, &at, object.*.pathPointer, object.*.pathLength)
    putWord(buffer, &at, relocatable.sectionCount(object))
    var index: usize = 0
    while index < relocatable.sectionCount(object) {
        const section = relocatable.sectionAt(object, index)
        const has = @intFromPtr(section.*.bytes) != 0
        putWord(buffer, &at, @intCast(usize, section.*.kind))
        putWord(buffer, &at, section.*.alignment)
        putWord(buffer, &at, section.*.length)
        putWord(buffer, &at, if has { 1 } else { 0 })
        if has { putBytes(buffer, &at, section.*.bytes, section.*.length) }
        index += 1
    }
    putWord(buffer, &at, relocatable.symbolCount(object))
    index = 0
    while index < relocatable.symbolCount(object) {
        const symbol = relocatable.symbolAt(object, index)
        putWord(buffer, &at, symbol.*.nameLength)
        putBytes(buffer, &at, symbol.*.namePointer, symbol.*.nameLength)
        putWord(buffer, &at, @intCast(usize, symbol.*.binding))
        putWord(buffer, &at, @intCast(usize, symbol.*.kind))
        putWord(buffer, &at, symbol.*.section)
        putWord(buffer, &at, symbol.*.value)
        putWord(buffer, &at, symbol.*.size)
        index += 1
    }
    putWord(buffer, &at, relocatable.relocationCount(object))
    index = 0
    while index < relocatable.relocationCount(object) {
        const relocation = relocatable.relocationAt(object, index)
        putWord(buffer, &at, relocation.*.section)
        putWord(buffer, &at, relocation.*.offset)
        putWord(buffer, &at, @intCast(usize, relocation.*.kind))
        putWord(buffer, &at, relocation.*.symbol)
        putWord(buffer, &at, @bitCast(usize, relocation.*.addend))
        index += 1
    }
    return -> (memory, total)
}

// Whether BYTES hold a unit.
pub fn isUnit(data: [*]const u8, length: usize) -> bool {
    return length >= MAGIC.length && mem.eql(data, MAGIC.pointer, MAGIC.length)
}

const Reader = struct {
    data: [*]const u8
    length: usize
    at: usize
    ok: bool
}

fn word(reader: *Reader) -> usize {
    if reader.*.at + 8 > reader.*.length {
        reader.*.ok = false
        return 0
    }
    const value = @intCast(usize, mem.readU64Little(reader.*.data, reader.*.at))
    reader.*.at += 8
    return value
}

// The next LENGTH bytes, in place (the file's buffer is kept).
fn take(reader: *Reader, length: usize) -> [*]const u8 {
    if length > reader.*.length || reader.*.at + length > reader.*.length {
        reader.*.ok = false
        return reader.*.data
    }
    const result = pointerAt(reader.*.data, reader.*.at)
    reader.*.at += length
    return result
}

// Reads the unit in DATA (kept: sections and names point into it) into
// RESULT, an empty object (relocatable.initAt); its path is the unit's.
// False when the bytes are not a whole unit.
pub fn read(result: *relocatable.Object, data: [*]const u8, length: usize) -> bool {
    if !isUnit(data, length) { return false }
    var reader = Reader.{ .data = data, .length = length, .at = MAGIC.length, .ok = true }
    const pathLength = word(&reader)
    const path = take(&reader, pathLength)
    if !reader.ok { return false }
    result.*.pathPointer = path
    result.*.pathLength = pathLength
    const sections = word(&reader)
    var index: usize = 0
    while index < sections && reader.ok {
        const kind = word(&reader)
        const alignment = word(&reader)
        const sectionLength = word(&reader)
        const has = word(&reader)
        var contents: usize = 0
        if has != 0 { contents = @intFromPtr(take(&reader, sectionLength)) }
        if !reader.ok { return false }
        unsafe { _ = relocatable.addSection(result, @intCast(u8, kind), @ptrFromInt([*]const u8, contents), sectionLength, alignment) }
        index += 1
    }
    const symbols = word(&reader)
    index = 0
    while index < symbols && reader.ok {
        const nameLength = word(&reader)
        const name = take(&reader, nameLength)
        const binding = word(&reader)
        const kind = word(&reader)
        const section = word(&reader)
        const value = word(&reader)
        const symbolSize = word(&reader)
        if !reader.ok { return false }
        _ = relocatable.addSymbol(result, name, nameLength, @intCast(u8, binding), @intCast(u8, kind), section, value, symbolSize)
        index += 1
    }
    const relocations = word(&reader)
    index = 0
    while index < relocations && reader.ok {
        const section = word(&reader)
        const offset = word(&reader)
        const kind = word(&reader)
        const symbol = word(&reader)
        const addend = word(&reader)
        if !reader.ok || section >= sections || symbol >= symbols { return false }
        relocatable.addRelocation(result, section, offset, @intCast(u8, kind), symbol, @bitCast(i64, addend))
        index += 1
    }
    return reader.ok && reader.at == length
}
