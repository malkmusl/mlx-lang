// Archives of objects (the `ar` format, as GNU ar writes them): a static
// library. The file is "!<arch>\n" and then members, each a 60-byte
// header of text fields (the name ended by a slash, the date, the owner,
// the mode, the size, and "`\n") and the bytes, padded to an even
// length. A name longer than 15 bytes is "/N": an offset into the "//"
// member that lists the long names, each ended by "/\n". The "/" member
// is a symbol index some linkers want; link.mlx reads the members'
// symbols itself and skips it.
const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")
const relocatable = @import("./relocatable.mlx")

pub const Allocator = allocator_module.Allocator

// The address `offset` bytes into `base`.
fn pointerAt(base: [*]const u8, offset: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(base) + offset) }
}

const MAGIC: []const u8 = "!<arch>\n"
const HEADER_SIZE: usize = 60

pub const Member = struct {
    namePointer: [*]const u8
    nameLength: usize
    bytes: [*]const u8
    length: usize
}

// Reads the members one by one: `member` is the next one, false at the
// end (or when the file is not an archive).
pub const Reader = struct {
    bytes: [*]const u8
    length: usize
    at: usize
    // The "//" member's long names.
    longNames: [*]const u8
    longLength: usize
}

pub fn isArchive(bytes: [*]const u8, length: usize) -> bool {
    if length < MAGIC.length { return false }
    var index: usize = 0
    while index < MAGIC.length {
        if bytes[index] != MAGIC[index] { return false }
        index += 1
    }
    return true
}

pub fn reader(bytes: [*]const u8, length: usize) -> Reader {
    unsafe { return Reader.{ .bytes = bytes, .length = length, .at = MAGIC.length, .longNames = @ptrFromInt([*]const u8, 0), .longLength = 0 } }
}

// A decimal field of the header.
fn number(bytes: [*]const u8, at: usize, width: usize) -> usize {
    var value: usize = 0
    var index: usize = 0
    while index < width {
        const c = bytes[at + index]
        if c < 48 || c > 57 { break }
        value = value * 10 + @intCast(usize, c - 48)
        index += 1
    }
    return value
}

// The next member that is an object (the symbol index and the long
// names member are read past).
pub fn next(r: *Reader, member: *Member) -> bool {
    while true {
        if r.*.at + HEADER_SIZE > r.*.length { return false }
        const header = r.*.at
        const bytes = r.*.bytes
        if bytes[header + 58] != 96 || bytes[header + 59] != 10 { return false }
        const size = number(bytes, header + 48, 10)
        const start = header + HEADER_SIZE
        if start + size > r.*.length { return false }
        r.*.at = start + size + (size & 1)
        // The name: "name/", "/N" (a long name), "/" or "//".
        var name_length: usize = 0
        while name_length < 16 && bytes[header + name_length] != 47 && bytes[header + name_length] != 32 { name_length += 1 }
        if name_length == 0 && bytes[header] == 47 {
            if bytes[header + 1] == 47 {
                unsafe { r.*.longNames = @ptrFromInt([*]const u8, @intFromPtr(bytes) + start) }
                r.*.longLength = size
                continue
            }
            if bytes[header + 1] == 32 || bytes[header + 1] == 47 { continue }
            // "/N": the long name at offset N, ended by "/".
            const offset = number(bytes, header + 1, 15)
            if offset >= r.*.longLength { continue }
            var long_length: usize = 0
            while offset + long_length < r.*.longLength && r.*.longNames[offset + long_length] != 47 && r.*.longNames[offset + long_length] != 10 { long_length += 1 }
            unsafe { member.*.namePointer = @ptrFromInt([*]const u8, @intFromPtr(r.*.longNames) + offset) }
            member.*.nameLength = long_length
        } else {
            unsafe { member.*.namePointer = @ptrFromInt([*]const u8, @intFromPtr(bytes) + header) }
            member.*.nameLength = name_length
        }
        unsafe { member.*.bytes = @ptrFromInt([*]const u8, @intFromPtr(bytes) + start) }
        member.*.length = size
        return true
    }
    return false
}

fn putText(buffer: [*]u8, at: usize, text: []const u8) -> void {
    var index: usize = 0
    while index < text.length {
        buffer[at + index] = text[index]
        index += 1
    }
}

fn putDecimal(buffer: [*]u8, at: usize, width: usize, value: usize) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var index: usize = 0
    while index < width {
        buffer[at + index] = 32
        index += 1
    }
    index = 0
    while index < count && index < width {
        buffer[at + index] = digits[count - 1 - index]
        index += 1
    }
}

// The size of the archive holding `members` (count of them): the header,
// the long names member when a name is over 15 bytes, each member padded.
fn archiveSize(members: [*]const Member, count: usize) -> (usize, usize) {
    var long: usize = 0
    var total: usize = MAGIC.length
    var index: usize = 0
    while index < count {
        if members[index].nameLength > 15 { long += members[index].nameLength + 2 }
        total += HEADER_SIZE + members[index].length + (members[index].length & 1)
        index += 1
    }
    if long > 0 { total += HEADER_SIZE + long + (long & 1) }
    return -> (total, long)
}

fn memberHeader(buffer: [*]u8, at: usize, size: usize) -> void {
    var index: usize = 0
    while index < HEADER_SIZE {
        buffer[at + index] = 32
        index += 1
    }
    putDecimal(buffer, at + 16, 12, 0)
    putDecimal(buffer, at + 28, 6, 0)
    putDecimal(buffer, at + 34, 6, 0)
    putText(buffer, at + 40, "644")
    putDecimal(buffer, at + 48, 10, size)
    buffer[at + 58] = 96
    buffer[at + 59] = 10
}

// Writes the archive of `members` to `path` (the members in order, a
// name over 15 bytes through the long names member).
pub fn write(allocator: Allocator, path: [*]const u8, members: [*]const Member, count: usize) -> bool {
    const sizes = archiveSize(members, count)
    const total = sizes.0
    const long = sizes.1
    const memory = allocator.alloc(total, 8)
    if memory == null { return false }
    const buffer = memory.?
    mem.zero(buffer, total)
    putText(buffer, 0, MAGIC)
    var at = MAGIC.length
    var long_at: usize = 0
    if long > 0 {
        memberHeader(buffer, at, long)
        putText(buffer, at, "//")
        long_at = at + HEADER_SIZE
        var index: usize = 0
        var names_at = long_at
        while index < count {
            if members[index].nameLength > 15 {
                mem.copy(pointerAt(buffer, names_at), members[index].namePointer, members[index].nameLength)
                buffer[names_at + members[index].nameLength] = 47
                buffer[names_at + members[index].nameLength + 1] = 10
                names_at += members[index].nameLength + 2
            }
            index += 1
        }
        if long & 1 != 0 { buffer[names_at] = 10 }
        at = long_at + long + (long & 1)
    }
    var index: usize = 0
    var long_offset: usize = 0
    while index < count {
        const member = members[index]
        memberHeader(buffer, at, member.length)
        if member.nameLength > 15 {
            buffer[at] = 47
            putDecimal(buffer, at + 1, 15, long_offset)
            long_offset += member.nameLength + 2
        } else {
            mem.copy(pointerAt(buffer, at), member.namePointer, member.nameLength)
            buffer[at + member.nameLength] = 47
        }
        mem.copy(pointerAt(buffer, at + HEADER_SIZE), member.bytes, member.length)
        if member.length & 1 != 0 { buffer[at + HEADER_SIZE + member.length] = 10 }
        at += HEADER_SIZE + member.length + (member.length & 1)
        index += 1
    }
    const wrote = relocatable.writeFile(path, buffer, total)
    allocator.free(buffer, total, 8)
    return wrote
}
