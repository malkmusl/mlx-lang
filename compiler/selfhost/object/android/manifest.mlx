// Binary AndroidManifest.xml (AXML) for a NativeActivity app. Ported from
// experiments/android-aarch64-bluescreen/mlx/axml.mlx, whose resource IDs
// were checked against aapt; see that file for how each was derived.
//
// The manifest: <manifest package versionCode versionName> <uses-sdk min
// target/> <application label hasCode=false extractNativeLibs>
// <activity android.app.NativeActivity theme label exported
// configChanges=keyboardHidden> <meta-data android.app.lib_name=main/>
// <intent-filter> MAIN / LAUNCHER.
//
// Invariant: an element's android: attributes are written in ascending
// resource-ID order (non-resource attributes such as `package` last). The
// platform finds attributes with a single forward merge walk, so one that
// follows a higher ID is silently never seen (this broke android:exported
// at targetSdk >= 31 in the experiment).
const bytes = @import("./bytes.mlx")
const vector = @import("../../../../std/bootstrap/vector.mlx")

pub const Allocator = bytes.Allocator
pub const ArrayList = bytes.ArrayList
pub const Bytes = bytes.Bytes

pub const Options = struct {
    package: Bytes
    label: Bytes
    versionCode: u32
    versionName: Bytes
    minSdk: u32
    targetSdk: u32
    fullscreen: bool
    // false (the default): the package manager leaves lib/*/libmain.so in
    // the APK (stored and 16 KB-aligned by zip.mlx) and the app loads it
    // from there, so installing takes the APK's size, not the APK plus an
    // extracted copy. true extracts it, as before.
    extractNativeLibs: bool
}

const STRING_POOL_TYPE: u32 = 1
const XML_TYPE: u32 = 3
const START_NAMESPACE_TYPE: u32 = 256
const END_NAMESPACE_TYPE: u32 = 257
const START_ELEMENT_TYPE: u32 = 258
const END_ELEMENT_TYPE: u32 = 259
const RESOURCE_MAP_TYPE: u32 = 384
const VALUE_REFERENCE: u32 = 1
const VALUE_STRING: u32 = 3
const VALUE_INT_DEC: u32 = 16
const VALUE_INT_HEX: u32 = 17
const VALUE_BOOLEAN: u32 = 18
const NO_INDEX: u32 = 4294967295

// Theme.DeviceDefault.NoActionBar.TranslucentDecor keeps the status bar,
// drawn over the app's own content; ...NoActionBar.Fullscreen hides it.
const THEME_WITH_STATUS_BAR: u32 = 16974307 // 0x010301e3
const THEME_FULLSCREEN: u32 = 16974122 // 0x0103012a

// The resource-mapped attribute names, interned first (pool indices 0..11)
// so the resource map lines up with them.
const ATTRIBUTE_COUNT: usize = 12

fn attributeId(index: usize) -> u32 {
    const ids: [12]u32 = [12]u32{
        16843291, 16843292, 16843276, 16843376, // versionCode versionName minSdkVersion targetSdkVersion
        16842753, 16842764, 16842755, 16842783, 16842788, // label hasCode name configChanges value
        16842752, 16842768, 16844010, // theme exported extractNativeLibs
    }
    return ids[index]
}

const Pool = struct {
    strings: *vector.Vector
}

fn createPool(allocator: Allocator) -> Pool {
    unsafe {
        const strings = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        vector.Vector.initAt(strings, allocator, @sizeOf(Bytes), @alignOf(Bytes), 32)
        return Pool.{ .strings = strings }
    }
}

fn poolAt(pool: *Pool, index: usize) -> Bytes {
    unsafe { return @ptrCast(*Bytes, vector.Vector.at(pool.*.strings.*, index)).* }
}

fn intern(pool: *Pool, value: Bytes) -> u32 {
    var index: usize = 0
    while index < pool.*.strings.*.length {
        if bytes.equal(poolAt(pool, index), value) { return @intCast(u32, index) }
        index += 1
    }
    unsafe { const appended = vector.Vector.appendAt(pool.*.strings, @ptrCast([*]const u8, &value)) }
    return @intCast(u32, pool.*.strings.*.length - 1)
}

fn internText(pool: *Pool, text: []const u8) -> u32 { return intern(pool, bytes.ofText(text)) }

fn namespaceUri() -> []const u8 { return "http://schemas.android.com/apk/res/android" }

fn nodeHeader(body: *ArrayList, kind: u32, size: u32, line: u32) -> void {
    bytes.appendU16(body, kind)
    bytes.appendU16(body, 16)
    bytes.appendU32(body, size)
    bytes.appendU32(body, line)
    bytes.appendU32(body, NO_INDEX) // no comment
}

fn startElement(body: *ArrayList, pool: *Pool, name: []const u8, attribute_count: u32, line: u32) -> void {
    const name_index = internText(pool, name)
    nodeHeader(body, START_ELEMENT_TYPE, 36 + attribute_count * 20, line)
    bytes.appendU32(body, NO_INDEX) // namespace
    bytes.appendU32(body, name_index)
    bytes.appendU16(body, 20) // attributeStart
    bytes.appendU16(body, 20) // attributeSize
    bytes.appendU16(body, attribute_count)
    bytes.appendU16(body, 0) // id index
    bytes.appendU16(body, 0) // class index
    bytes.appendU16(body, 0) // style index
}

fn endElement(body: *ArrayList, pool: *Pool, name: []const u8, line: u32) -> void {
    const name_index = internText(pool, name)
    nodeHeader(body, END_ELEMENT_TYPE, 24, line)
    bytes.appendU32(body, NO_INDEX)
    bytes.appendU32(body, name_index)
}

fn namespace(body: *ArrayList, pool: *Pool, start: bool, line: u32) -> void {
    const uri = internText(pool, namespaceUri())
    const prefix = internText(pool, "android")
    nodeHeader(body, if start { START_NAMESPACE_TYPE } else { END_NAMESPACE_TYPE }, 24, line)
    bytes.appendU32(body, prefix)
    bytes.appendU32(body, uri)
}

// One attribute: namespace (android: or none), name, raw string (or none),
// then a typed value.
fn attribute(body: *ArrayList, pool: *Pool, android: bool, name: []const u8, raw: u32, kind: u32, data: u32) -> void {
    bytes.appendU32(body, if android { internText(pool, namespaceUri()) } else { NO_INDEX })
    bytes.appendU32(body, internText(pool, name))
    bytes.appendU32(body, raw)
    bytes.appendU16(body, 8)
    bytes.appendU8(body, 0)
    bytes.appendU8(body, kind)
    bytes.appendU32(body, data)
}

fn stringAttribute(body: *ArrayList, pool: *Pool, android: bool, name: []const u8, value: Bytes) -> void {
    const name_index = internText(pool, name) // name before value: keeps the pool order stable
    const index = intern(pool, value)
    attribute(body, pool, android, name, index, VALUE_STRING, index)
}

fn stringAttributeText(body: *ArrayList, pool: *Pool, name: []const u8, value: []const u8) -> void {
    stringAttribute(body, pool, true, name, bytes.ofText(value))
}

fn booleanAttribute(body: *ArrayList, pool: *Pool, name: []const u8, value: bool) -> void {
    attribute(body, pool, true, name, NO_INDEX, VALUE_BOOLEAN, if value { NO_INDEX } else { 0 })
}

pub fn build(allocator: Allocator, options: Options) -> ArrayList {
    var pool = createPool(allocator)
    const reserved_0 = internText(&pool, "versionCode")
    const reserved_1 = internText(&pool, "versionName")
    const reserved_2 = internText(&pool, "minSdkVersion")
    const reserved_3 = internText(&pool, "targetSdkVersion")
    const reserved_4 = internText(&pool, "label")
    const reserved_5 = internText(&pool, "hasCode")
    const reserved_6 = internText(&pool, "name")
    const reserved_7 = internText(&pool, "configChanges")
    const reserved_8 = internText(&pool, "value")
    const reserved_9 = internText(&pool, "theme")
    const reserved_10 = internText(&pool, "exported")
    const reserved_11 = internText(&pool, "extractNativeLibs")

    var body = bytes.newList(allocator, 2048)
    var line: u32 = 2
    namespace(&body, &pool, true, line)
    line += 1
    startElement(&body, &pool, "manifest", 3, line)
    attribute(&body, &pool, true, "versionCode", NO_INDEX, VALUE_INT_DEC, options.versionCode)
    stringAttribute(&body, &pool, true, "versionName", options.versionName)
    stringAttribute(&body, &pool, false, "package", options.package)
    line += 1
    startElement(&body, &pool, "uses-sdk", 2, line)
    attribute(&body, &pool, true, "minSdkVersion", NO_INDEX, VALUE_INT_DEC, options.minSdk)
    attribute(&body, &pool, true, "targetSdkVersion", NO_INDEX, VALUE_INT_DEC, options.targetSdk)
    line += 1
    endElement(&body, &pool, "uses-sdk", line)
    line += 1
    startElement(&body, &pool, "application", 3, line)
    stringAttribute(&body, &pool, true, "label", options.label)
    booleanAttribute(&body, &pool, "hasCode", false)
    booleanAttribute(&body, &pool, "extractNativeLibs", options.extractNativeLibs)
    line += 1
    // Rotation restarts the activity (configChanges only keyboardHidden):
    // the in-place resize path of NativeActivity is barely exercised.
    startElement(&body, &pool, "activity", 5, line)
    attribute(&body, &pool, true, "theme", NO_INDEX, VALUE_REFERENCE, if options.fullscreen { THEME_FULLSCREEN } else { THEME_WITH_STATUS_BAR })
    stringAttribute(&body, &pool, true, "label", options.label)
    stringAttributeText(&body, &pool, "name", "android.app.NativeActivity")
    booleanAttribute(&body, &pool, "exported", true)
    attribute(&body, &pool, true, "configChanges", NO_INDEX, VALUE_INT_HEX, 32)
    line += 1
    startElement(&body, &pool, "meta-data", 2, line)
    stringAttributeText(&body, &pool, "name", "android.app.lib_name")
    stringAttributeText(&body, &pool, "value", "main")
    line += 1
    endElement(&body, &pool, "meta-data", line)
    line += 1
    startElement(&body, &pool, "intent-filter", 0, line)
    line += 1
    startElement(&body, &pool, "action", 1, line)
    stringAttributeText(&body, &pool, "name", "android.intent.action.MAIN")
    line += 1
    endElement(&body, &pool, "action", line)
    line += 1
    startElement(&body, &pool, "category", 1, line)
    stringAttributeText(&body, &pool, "name", "android.intent.category.LAUNCHER")
    line += 1
    endElement(&body, &pool, "category", line)
    line += 1
    endElement(&body, &pool, "intent-filter", line)
    line += 1
    endElement(&body, &pool, "activity", line)
    line += 1
    endElement(&body, &pool, "application", line)
    line += 1
    endElement(&body, &pool, "manifest", line)
    namespace(&body, &pool, false, line)

    // String pool, UTF-16 (the strings here are ASCII).
    const string_count = pool.strings.*.length
    var offsets = bytes.newList(allocator, string_count * 4)
    var data = bytes.newList(allocator, 1024)
    var index: usize = 0
    while index < string_count {
        bytes.appendU32(&offsets, @intCast(u32, data.length))
        const value = poolAt(&pool, index)
        bytes.appendU16(&data, @intCast(u32, value.length))
        var character: usize = 0
        while character < value.length {
            bytes.appendU16(&data, @intCast(u32, value.pointer[character]))
            character += 1
        }
        bytes.appendU16(&data, 0)
        index += 1
    }
    const strings_start = @intCast(u32, 28 + string_count * 4)
    const unpadded = strings_start + @intCast(u32, data.length)
    const padding = (4 - unpadded % 4) % 4
    const pool_size = unpadded + padding

    var out = bytes.newList(allocator, 4096)
    bytes.appendU16(&out, XML_TYPE)
    bytes.appendU16(&out, 8)
    bytes.appendU32(&out, 0) // total size, patched below
    bytes.appendU16(&out, STRING_POOL_TYPE)
    bytes.appendU16(&out, 28)
    bytes.appendU32(&out, pool_size)
    bytes.appendU32(&out, @intCast(u32, string_count))
    bytes.appendU32(&out, 0) // styles
    bytes.appendU32(&out, 0) // flags: UTF-16
    bytes.appendU32(&out, strings_start)
    bytes.appendU32(&out, 0) // styles start
    bytes.appendList(&out, offsets)
    bytes.appendList(&out, data)
    var pad: u32 = 0
    while pad < padding {
        bytes.appendU8(&out, 0)
        pad += 1
    }
    bytes.appendU16(&out, RESOURCE_MAP_TYPE)
    bytes.appendU16(&out, 8)
    bytes.appendU32(&out, @intCast(u32, 8 + ATTRIBUTE_COUNT * 4))
    index = 0
    while index < ATTRIBUTE_COUNT {
        bytes.appendU32(&out, attributeId(index))
        index += 1
    }
    bytes.appendList(&out, body)
    bytes.setU32(out, 4, @intCast(u32, out.length))
    return out
}
