// A minimal empty classes.dex (header and map list only): the app is a
// pure NativeActivity, but some install paths expect a dex to exist.
// Ported from experiments/android-aarch64-bluescreen/mlx/dex.mlx.
const bytes = @import("./bytes.mlx")
const hash = @import("./hash.mlx")

pub const Allocator = bytes.Allocator
pub const ArrayList = bytes.ArrayList

const HEADER_SIZE: u32 = 112
const ENDIAN_CONSTANT: u32 = 305419896 // 0x12345678
const TYPE_HEADER_ITEM: u32 = 0
const TYPE_MAP_LIST: u32 = 4096

fn writeMapItem(out: ArrayList, offset: usize, kind: u32, size: u32, item_offset: u32) -> void {
    bytes.setU16(out, offset, kind)
    bytes.setU16(out, offset + 2, 0)
    bytes.setU32(out, offset + 4, size)
    bytes.setU32(out, offset + 8, item_offset)
}

pub fn buildEmpty(allocator: Allocator) -> ArrayList {
    const map_offset = HEADER_SIZE
    const map_size: u32 = 4 + 2 * 12
    const file_size = HEADER_SIZE + map_size
    const out = bytes.zeroed(allocator, @intCast(usize, file_size))
    // "dex\n035\0"
    bytes.setU8(out, 0, 100)
    bytes.setU8(out, 1, 101)
    bytes.setU8(out, 2, 120)
    bytes.setU8(out, 3, 10)
    bytes.setU8(out, 4, 48)
    bytes.setU8(out, 5, 51)
    bytes.setU8(out, 6, 53)
    bytes.setU32(out, 32, file_size)
    bytes.setU32(out, 36, HEADER_SIZE)
    bytes.setU32(out, 40, ENDIAN_CONSTANT)
    bytes.setU32(out, 52, map_offset)
    bytes.setU32(out, 104, map_size) // data_size
    bytes.setU32(out, 108, map_offset) // data_off
    bytes.setU32(out, @intCast(usize, map_offset), 2)
    writeMapItem(out, @intCast(usize, map_offset) + 4, TYPE_HEADER_ITEM, 1, 0)
    writeMapItem(out, @intCast(usize, map_offset) + 16, TYPE_MAP_LIST, 1, map_offset)
    // signature = SHA-1(bytes 32..), then checksum = Adler-32(bytes 12..)
    const data = bytes.ofList(out)
    var signature: [*]u8 = undefined
    unsafe { signature = @ptrFromInt([*]u8, @intFromPtr(out.items) + 12) }
    hash.sha1(allocator, bytes.sub(data, 32, data.length), signature)
    bytes.setU32(out, 8, hash.adler32(bytes.sub(data, 12, data.length)))
    return out
}
