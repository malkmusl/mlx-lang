// Prints the Android packaging primitives' results for fixed inputs, one
// "name value" line each; tools/check_android_packaging.py recomputes every
// value with Python's hashlib/zlib/etc. and compares. Built with both mlx0
// and mlx1, since the compiler (and so this code) is compiled by each.
const io = @import("../../../../std/bootstrap/io.mlx")
const page_allocator = @import("../../../../std/bootstrap/page_allocator.mlx")
const bytes = @import("./bytes.mlx")
const hash = @import("./hash.mlx")
const bn = @import("./bignum.mlx")

fn hex(label: []const u8, data: bytes.Bytes) -> void {
    const a = io.print(label)
    const b = io.print(" ")
    var index: usize = 0
    while index < data.length {
        const value = @intCast(usize, data.pointer[index])
        if value < 16 { const z = io.print("0") }
        const c = io.writeHex(io.stdout(), value)
        index += 1
    }
    const d = io.println("")
}

fn number(label: []const u8, value: usize) -> void {
    const a = io.print(label)
    const b = io.print(" ")
    const c = io.writeHex(io.stdout(), value)
    const d = io.println("")
}

// Deterministic test input: byte i = (i * 7 + 3) & 255.
fn pattern(allocator: bytes.Allocator, length: usize) -> bytes.ArrayList {
    const list = bytes.zeroed(allocator, length)
    var index: usize = 0
    while index < length {
        bytes.setU8(list, index, @intCast(u32, (index * 7 + 3) & 255))
        index += 1
    }
    return list
}

pub fn main() -> u8 {
    const allocator = page_allocator.init()
    const lengths: [9]usize = [9]usize{ 0, 1, 55, 56, 63, 64, 65, 1000, 70000 }
    var case: usize = 0
    while case < 9 {
        const input = pattern(allocator, lengths[case])
        const data = bytes.ofList(input)
        number("crc32", @intCast(usize, hash.crc32(data)))
        number("adler32", @intCast(usize, hash.adler32(data)))
        const sha1 = bytes.zeroed(allocator, 20)
        hash.sha1(allocator, data, sha1.items)
        hex("sha1", bytes.ofList(sha1))
        hex("sha256", bytes.ofList(hash.sha256List(allocator, data)))
        // Streaming in uneven pieces must match the one-shot digest.
        var context = hash.sha256Init(allocator)
        var offset: usize = 0
        var step: usize = 1
        while offset < data.length {
            const end = if offset + step < data.length { offset + step } else { data.length }
            hash.sha256Update(&context, bytes.sub(data, offset, end))
            offset = end
            step = step * 3 + 1
        }
        const streamed = bytes.zeroed(allocator, 32)
        hash.sha256Final(&context, streamed.items)
        hex("sha256", bytes.ofList(streamed))
        case += 1
    }
    checkBignum(allocator)
    return 0
}

// Big integers from pattern bytes of a given length and seed offset.
fn bigFrom(allocator: bytes.Allocator, length: usize, seed: usize) -> bn.BigUint {
    const list = bytes.zeroed(allocator, length)
    var index: usize = 0
    while index < length {
        bytes.setU8(list, index, @intCast(u32, (index * 13 + seed * 31 + 7) & 255))
        index += 1
    }
    var value = bn.create(allocator)
    bn.fromBytes(&value, bytes.ofList(list))
    return value
}

fn big(allocator: bytes.Allocator, label: []const u8, value: *bn.BigUint) -> void {
    hex(label, bytes.ofList(bn.toBytesMinimal(allocator, value)))
}

fn checkBignum(allocator: bytes.Allocator) -> void {
    var a = bigFrom(allocator, 128, 1)
    var b = bigFrom(allocator, 96, 2)
    var m = bigFrom(allocator, 128, 3)
    var e = bigFrom(allocator, 3, 4)
    var r = bn.create(allocator)
    var q = bn.create(allocator)
    var accumulator = bn.create(allocator)
    big(allocator, "a", &a)
    bn.mulTo(&r, &a, &b, &accumulator)
    big(allocator, "mul", &r)
    bn.addTo(&r, &a, &b)
    big(allocator, "add", &r)
    bn.subTo(&r, &a, &b)
    big(allocator, "sub", &r)
    bn.divMod(&q, &r, &a, &b)
    big(allocator, "div", &q)
    big(allocator, "mod", &r)
    bn.modPow(allocator, &r, &a, &e, &m)
    big(allocator, "powsmall", &r)
    bn.modPow(allocator, &r, &a, &b, &m)
    big(allocator, "powbig", &r)
    var one = bn.create(allocator)
    bn.setU64(&one, 1)
    var even = bn.create(allocator)
    bn.addTo(&even, &m, &one)
    bn.modPow(allocator, &r, &a, &e, &even)
    big(allocator, "poweven", &r)
    var sixty_five_five_three_seven = bn.create(allocator)
    bn.setU64(&sixty_five_five_three_seven, 65537)
    bn.modInverse(allocator, &r, &sixty_five_five_three_seven, &m)
    big(allocator, "inverse", &r)
    hex("padded", bytes.ofList(bn.toBytesPadded(allocator, &e, 8)))
    number("bits", bn.bitLength(&a))
    var prime = bn.create(allocator)
    bn.setU64(&prime, 2305843009213693951) // 2^61 - 1
    number("prime", if bn.isProbablePrime(allocator, &prime, 8) { 1 } else { 0 })
    bn.setU64(&prime, 2305843009213693953) // composite
    number("prime", if bn.isProbablePrime(allocator, &prime, 8) { 1 } else { 0 })
}
