// Checksums and digests for APK packaging: CRC-32 (ZIP entries), Adler-32
// and SHA-1 (classes.dex header), SHA-256 (JAR and APK v2/v3 signing).
// Ported from experiments/android-aarch64-bluescreen/mlx/hash.mlx; SHA-256
// is streaming here (init/update/final) so the v2/v3 chunk digests can hash
// a prefix and a large chunk without copying the chunk.
const bytes = @import("./bytes.mlx")

pub const Allocator = bytes.Allocator
pub const ArrayList = bytes.ArrayList
pub const Bytes = bytes.Bytes

// CRC-32 (IEEE 802.3, reflected, polynomial 0xEDB88320), bit by bit.
pub fn crc32(data: Bytes) -> u32 {
    var crc: u32 = 4294967295
    var index: usize = 0
    while index < data.length {
        crc = crc ^ @intCast(u32, data.pointer[index])
        var bit: usize = 0
        while bit < 8 {
            if crc & 1 == 1 {
                crc = (crc >> 1) ^ 3988292384
            } else {
                crc = crc >> 1
            }
            bit += 1
        }
        index += 1
    }
    return crc ^ 4294967295
}

// Adler-32 (RFC 1950).
pub fn adler32(data: Bytes) -> u32 {
    var a: u32 = 1
    var b: u32 = 0
    var index: usize = 0
    while index < data.length {
        a = (a + @intCast(u32, data.pointer[index])) % 65521
        b = (b + a) % 65521
        index += 1
    }
    return (b << 16) | a
}

// Rotations mask before shifting left: the bootstrap compiler (mlx0) traps
// when a left shift drops set bits, so no shift here may overflow.
fn rotl32(x: u32, n: u32) -> u32 { return ((x & ((@intCast(u32, 1) << (32 - n)) - 1)) << n) | (x >> (32 - n)) }

fn rotr32(x: u32, n: u32) -> u32 { return (x >> n) | ((x & ((@intCast(u32, 1) << n) - 1)) << (32 - n)) }

fn loadBigEndian32(pointer: [*]const u8, offset: usize) -> u32 {
    return (@intCast(u32, pointer[offset]) << 24) | (@intCast(u32, pointer[offset + 1]) << 16) | (@intCast(u32, pointer[offset + 2]) << 8) | @intCast(u32, pointer[offset + 3])
}

fn storeBigEndian32(pointer: [*]u8, offset: usize, value: u32) -> void {
    pointer[offset] = @intCast(u8, (value >> 24) & 255)
    pointer[offset + 1] = @intCast(u8, (value >> 16) & 255)
    pointer[offset + 2] = @intCast(u8, (value >> 8) & 255)
    pointer[offset + 3] = @intCast(u8, value & 255)
}

// Message padding shared by SHA-1 and SHA-256: 0x80, zeros, then the bit
// length big-endian, ending on a 64-byte boundary. Writes the final one or
// two blocks into `tail` and returns their length (64 or 128).
fn padTail(tail: [*]u8, pending: [*]const u8, pending_length: usize, total_length: u64) -> usize {
    var index: usize = 0
    while index < 128 {
        tail[index] = if index < pending_length { pending[index] } else { 0 }
        index += 1
    }
    tail[pending_length] = 128
    const blocks_length: usize = if pending_length < 56 { 64 } else { 128 }
    const bit_length: u64 = total_length * 8
    var shift: usize = 0
    while shift < 8 {
        tail[blocks_length - 1 - shift] = @intCast(u8, (bit_length >> @intCast(u64, shift * 8)) & 255)
        shift += 1
    }
    return blocks_length
}

// ── SHA-1 (FIPS 180-4), one shot ──────────────────────────────────────────

fn sha1Block(state: [*]u32, schedule: [*]u32, block: [*]const u8) -> void {
    var t: usize = 0
    while t < 16 {
        schedule[t] = loadBigEndian32(block, t * 4)
        t += 1
    }
    while t < 80 {
        schedule[t] = rotl32(schedule[t - 3] ^ schedule[t - 8] ^ schedule[t - 14] ^ schedule[t - 16], 1)
        t += 1
    }
    var a = state[0]
    var b = state[1]
    var c = state[2]
    var d = state[3]
    var e = state[4]
    var round: usize = 0
    while round < 80 {
        var f: u32 = 0
        var k: u32 = 0
        if round < 20 {
            f = (b & c) | ((~b) & d)
            k = 1518500249
        } else if round < 40 {
            f = b ^ c ^ d
            k = 1859775393
        } else if round < 60 {
            f = (b & c) | (b & d) | (c & d)
            k = 2400959708
        } else {
            f = b ^ c ^ d
            k = 3395469782
        }
        const temp: u32 = (((rotl32(a, 5) +% f) +% e) +% k) +% schedule[round]
        e = d
        d = c
        c = rotl32(b, 30)
        b = a
        a = temp
        round += 1
    }
    state[0] = state[0] +% a
    state[1] = state[1] +% b
    state[2] = state[2] +% c
    state[3] = state[3] +% d
    state[4] = state[4] +% e
}

// Writes the 20-byte SHA-1 digest of `data` to `digest`.
pub fn sha1(allocator: Allocator, data: Bytes, digest: [*]u8) -> void {
    var scratch: [*]u8 = undefined
    unsafe { scratch = allocator.alloc(5 * 4 + 80 * 4 + 128, 8).? }
    var state: [*]u32 = undefined
    var schedule: [*]u32 = undefined
    var tail: [*]u8 = undefined
    unsafe {
        state = @ptrCast([*]u32, scratch)
        schedule = @ptrFromInt([*]u32, @intFromPtr(scratch) + 20)
        tail = @ptrFromInt([*]u8, @intFromPtr(scratch) + 340)
    }
    state[0] = 1732584193
    state[1] = 4023233417
    state[2] = 2562383102
    state[3] = 271733878
    state[4] = 3285377520
    var offset: usize = 0
    while offset + 64 <= data.length {
        sha1Block(state, schedule, bytes.sub(data, offset, offset + 64).pointer)
        offset += 64
    }
    const tail_length = padTail(tail, bytes.sub(data, offset, data.length).pointer, data.length - offset, @intCast(u64, data.length))
    unsafe { sha1Block(state, schedule, @ptrCast([*]const u8, tail)) }
    if tail_length == 128 {
        unsafe { sha1Block(state, schedule, @ptrFromInt([*]const u8, @intFromPtr(tail) + 64)) }
    }
    var word: usize = 0
    while word < 5 {
        storeBigEndian32(digest, word * 4, state[word])
        word += 1
    }
    unsafe { allocator.free(scratch, 5 * 4 + 80 * 4 + 128, 8) }
}

// ── SHA-256 (FIPS 180-4), streaming ───────────────────────────────────────

fn sha256Constant(index: usize) -> u32 {
    const k: [64]u32 = [64]u32{
        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298,
    }
    return k[index]
}

pub const Sha256 = struct {
    state: [*]u32
    schedule: [*]u32
    constants: [*]u32
    pending: [*]u8
    pendingLength: usize
    totalLength: u64
    scratch: [*]u8
    allocator: Allocator
}

const SHA256_SCRATCH: usize = 8 * 4 + 64 * 4 + 64 * 4 + 64

// A fresh context; sha256Final releases its scratch memory. (Built as a
// struct literal: the bootstrap compiler mlx0 mishandles the address of a
// struct local declared `= undefined`, so callers write
// `var context = hash.sha256Init(allocator)` and pass `&context`.)
pub fn sha256Init(allocator: Allocator) -> Sha256 {
    var scratch: [*]u8 = undefined
    var state: [*]u32 = undefined
    var schedule: [*]u32 = undefined
    var constants: [*]u32 = undefined
    var pending: [*]u8 = undefined
    unsafe {
        scratch = allocator.alloc(SHA256_SCRATCH, 8).?
        state = @ptrCast([*]u32, scratch)
        schedule = @ptrFromInt([*]u32, @intFromPtr(scratch) + 32)
        constants = @ptrFromInt([*]u32, @intFromPtr(scratch) + 288)
        pending = @ptrFromInt([*]u8, @intFromPtr(scratch) + 544)
    }
    state[0] = 1779033703
    state[1] = 3144134277
    state[2] = 1013904242
    state[3] = 2773480762
    state[4] = 1359893119
    state[5] = 2600822924
    state[6] = 528734635
    state[7] = 1541459225
    var index: usize = 0
    while index < 64 {
        constants[index] = sha256Constant(index)
        index += 1
    }
    return Sha256.{
        .state = state,
        .schedule = schedule,
        .constants = constants,
        .pending = pending,
        .pendingLength = 0,
        .totalLength = 0,
        .scratch = scratch,
        .allocator = allocator,
    }
}

fn sha256Block(context: *Sha256, block: [*]const u8) -> void {
    const w = context.*.schedule
    const k = context.*.constants
    const h = context.*.state
    var t: usize = 0
    while t < 16 {
        w[t] = loadBigEndian32(block, t * 4)
        t += 1
    }
    while t < 64 {
        const s0: u32 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3)
        const s1: u32 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10)
        w[t] = ((w[t - 16] +% s0) +% w[t - 7]) +% s1
        t += 1
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    var round: usize = 0
    while round < 64 {
        const big_s1: u32 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
        const ch: u32 = (e & f) ^ ((~e) & g)
        const temp1: u32 = (((hh +% big_s1) +% ch) +% k[round]) +% w[round]
        const big_s0: u32 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
        const maj: u32 = (a & b) ^ (a & c) ^ (b & c)
        const temp2: u32 = big_s0 +% maj
        hh = g
        g = f
        f = e
        e = d +% temp1
        d = c
        c = b
        b = a
        a = temp1 +% temp2
        round += 1
    }
    h[0] = h[0] +% a
    h[1] = h[1] +% b
    h[2] = h[2] +% c
    h[3] = h[3] +% d
    h[4] = h[4] +% e
    h[5] = h[5] +% f
    h[6] = h[6] +% g
    h[7] = h[7] +% hh
}

pub fn sha256Update(context: *Sha256, data: Bytes) -> void {
    var offset: usize = 0
    context.*.totalLength += @intCast(u64, data.length)
    while offset < data.length && context.*.pendingLength > 0 {
        context.*.pending[context.*.pendingLength] = data.pointer[offset]
        context.*.pendingLength += 1
        offset += 1
        if context.*.pendingLength == 64 {
            unsafe { sha256Block(context, @ptrCast([*]const u8, context.*.pending)) }
            context.*.pendingLength = 0
        }
    }
    while offset + 64 <= data.length {
        sha256Block(context, bytes.sub(data, offset, offset + 64).pointer)
        offset += 64
    }
    while offset < data.length {
        context.*.pending[context.*.pendingLength] = data.pointer[offset]
        context.*.pendingLength += 1
        offset += 1
    }
}

pub fn sha256UpdateByte(context: *Sha256, value: u32) -> void {
    context.*.pending[context.*.pendingLength] = @intCast(u8, value & 255)
    context.*.pendingLength += 1
    context.*.totalLength += 1
    if context.*.pendingLength == 64 {
        unsafe { sha256Block(context, @ptrCast([*]const u8, context.*.pending)) }
        context.*.pendingLength = 0
    }
}

pub fn sha256UpdateU32(context: *Sha256, value: u32) -> void {
    sha256UpdateByte(context, value)
    sha256UpdateByte(context, value >> 8)
    sha256UpdateByte(context, value >> 16)
    sha256UpdateByte(context, value >> 24)
}

// Writes the 32-byte digest to `digest` and releases the context.
pub fn sha256Final(context: *Sha256, digest: [*]u8) -> void {
    var staged: [*]u8 = undefined
    unsafe { staged = context.*.allocator.alloc(128, 8).? }
    var tail_length: usize = 0
    unsafe { tail_length = padTail(staged, @ptrCast([*]const u8, context.*.pending), context.*.pendingLength, context.*.totalLength) }
    unsafe { sha256Block(context, @ptrCast([*]const u8, staged)) }
    if tail_length == 128 {
        unsafe { sha256Block(context, @ptrFromInt([*]const u8, @intFromPtr(staged) + 64)) }
    }
    var word: usize = 0
    while word < 8 {
        storeBigEndian32(digest, word * 4, context.*.state[word])
        word += 1
    }
    unsafe {
        context.*.allocator.free(staged, 128, 8)
        context.*.allocator.free(context.*.scratch, SHA256_SCRATCH, 8)
    }
}

pub fn sha256(allocator: Allocator, data: Bytes, digest: [*]u8) -> void {
    var context = sha256Init(allocator)
    sha256Update(&context, data)
    sha256Final(&context, digest)
}

// The digest as a fresh 32-byte list.
pub fn sha256List(allocator: Allocator, data: Bytes) -> ArrayList {
    const out = bytes.zeroed(allocator, 32)
    sha256(allocator, data, out.items)
    return out
}
