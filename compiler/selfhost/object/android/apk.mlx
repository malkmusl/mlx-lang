// Signed APK assembly for --target=aarch64-android with an output ending
// in .apk: binary manifest, empty classes.dex, the compiled libmain.so,
// v1 (JAR) signature files, then the v2/v3 APK Signing Block. Ported from
// the orchestration in experiments/android-aarch64-bluescreen/mlx/main.mlx.
const bytes = @import("./bytes.mlx")
const manifest = @import("./manifest.mlx")
const dex = @import("./dex.mlx")
const zip = @import("./zip.mlx")
const signing = @import("./signing.mlx")
const apk_signature = @import("./apk_signature.mlx")

pub const Allocator = bytes.Allocator
pub const ArrayList = bytes.ArrayList
pub const Bytes = bytes.Bytes
pub const ManifestOptions = manifest.Options
pub const RsaKey = signing.RsaKey

// The finished APK bytes for `library` (the libmain.so image), signed by
// `key` with a self-signed certificate for CN=`certificate_name`.
pub fn build(allocator: Allocator, library: Bytes, options: manifest.Options, key: *signing.RsaKey, certificate_name: Bytes) -> ArrayList {
    const manifest_bytes = manifest.build(allocator, options)
    const dex_bytes = dex.buildEmpty(allocator)
    const certificate = signing.certificate(allocator, key, certificate_name, 1)

    var contents = zip.createEntries(allocator)
    zip.add(&contents, bytes.ofText("AndroidManifest.xml"), bytes.ofList(manifest_bytes))
    zip.add(&contents, bytes.ofText("classes.dex"), bytes.ofList(dex_bytes))
    zip.add(&contents, bytes.ofText("lib/arm64-v8a/libmain.so"), library)
    var schemes = bytes.ofText("")
    if apk_signature.useV3(options.targetSdk) {
        schemes = bytes.ofText("2, 3")
    } else if apk_signature.useV2(options.targetSdk) {
        schemes = bytes.ofText("2")
    }
    const jar = signing.signJar(allocator, key, bytes.ofList(certificate), certificate_name, 1, &contents, schemes)

    // META-INF first, as jarsigner and apksigner write it (JarInputStream
    // only finds a manifest that leads the archive).
    var entries = zip.createEntries(allocator)
    zip.add(&entries, bytes.ofText("META-INF/MANIFEST.MF"), bytes.ofList(jar.manifest))
    zip.add(&entries, bytes.ofText("META-INF/CERT.SF"), bytes.ofList(jar.signatureFile))
    zip.add(&entries, bytes.ofText("META-INF/CERT.RSA"), bytes.ofList(jar.signatureBlock))
    zip.add(&entries, bytes.ofText("AndroidManifest.xml"), bytes.ofList(manifest_bytes))
    zip.add(&entries, bytes.ofText("classes.dex"), bytes.ofList(dex_bytes))
    zip.add(&entries, bytes.ofText("lib/arm64-v8a/libmain.so"), library)
    const archive = zip.build(allocator, &entries)
    return apk_signature.sign(allocator, key, bytes.ofList(certificate), bytes.ofList(archive), options.minSdk, options.targetSdk)
}

// Loads the signing key at `path`, or generates a new RSA-2048 key there
// when none exists yet (a debug key, like Android Studio's debug.keystore:
// reusing it keeps successive builds installable as updates). Existing
// keys of other sizes (the experiment's RSA-1024 key) load as they are.
pub fn loadOrCreateKey(allocator: Allocator, path: [*]const u8, generated: *bool) -> signing.RsaKey {
    const loaded = signing.loadKey(allocator, path)
    if loaded.valid {
        generated.* = false
        return loaded
    }
    var key = signing.generateKey(allocator, 2048)
    generated.* = true
    if !signing.saveKey(allocator, &key, path) { key.valid = false }
    return key
}
