// ASN.1 DER encoding: the primitives X.509 certificates and PKCS#7
// SignedData need. Ported from experiments/android-aarch64-bluescreen/mlx/
// asn1.mlx; composite values take a fixed number of already-encoded parts
// (sequence2, sequence5, ...) rather than a list of slices.
const bytes = @import("./bytes.mlx")

pub const Allocator = bytes.Allocator
pub const ArrayList = bytes.ArrayList
pub const Bytes = bytes.Bytes

pub const TAG_INTEGER: u32 = 2
pub const TAG_BIT_STRING: u32 = 3
pub const TAG_OCTET_STRING: u32 = 4
pub const TAG_NULL: u32 = 5
pub const TAG_OID: u32 = 6
pub const TAG_UTF8_STRING: u32 = 12
pub const TAG_UTC_TIME: u32 = 23
pub const TAG_SEQUENCE: u32 = 48
pub const TAG_SET: u32 = 49

fn appendLength(out: *ArrayList, length: usize) -> void {
    if length < 128 {
        bytes.appendU8(out, @intCast(u32, length))
        return
    }
    var count: usize = 0
    var value = length
    while value > 0 {
        count += 1
        value = value >> 8
    }
    bytes.appendU8(out, @intCast(u32, 128 | count))
    var index = count
    while index > 0 {
        index -= 1
        bytes.appendU8(out, @intCast(u32, (length >> (index * 8)) & 255))
    }
}

// Tag, DER length, content.
pub fn tlv(allocator: Allocator, tag: u32, content: Bytes) -> ArrayList {
    var out = bytes.newList(allocator, content.length + 8)
    bytes.appendU8(&out, tag)
    appendLength(&out, content.length)
    bytes.appendBytes(&out, content)
    return out
}

fn wrap(allocator: Allocator, tag: u32, content: ArrayList) -> ArrayList {
    const out = tlv(allocator, tag, bytes.ofList(content))
    bytes.free(content)
    return out
}

pub fn joined1(allocator: Allocator, tag: u32, p0: Bytes) -> ArrayList {
    return tlv(allocator, tag, p0)
}

pub fn joined2(allocator: Allocator, tag: u32, p0: Bytes, p1: Bytes) -> ArrayList {
    var content = bytes.newList(allocator, p0.length + p1.length)
    bytes.appendBytes(&content, p0)
    bytes.appendBytes(&content, p1)
    return wrap(allocator, tag, content)
}

pub fn joined3(allocator: Allocator, tag: u32, p0: Bytes, p1: Bytes, p2: Bytes) -> ArrayList {
    var content = bytes.newList(allocator, p0.length + p1.length + p2.length)
    bytes.appendBytes(&content, p0)
    bytes.appendBytes(&content, p1)
    bytes.appendBytes(&content, p2)
    return wrap(allocator, tag, content)
}

pub fn joined5(allocator: Allocator, tag: u32, p0: Bytes, p1: Bytes, p2: Bytes, p3: Bytes, p4: Bytes) -> ArrayList {
    var content = bytes.newList(allocator, p0.length + p1.length + p2.length + p3.length + p4.length)
    bytes.appendBytes(&content, p0)
    bytes.appendBytes(&content, p1)
    bytes.appendBytes(&content, p2)
    bytes.appendBytes(&content, p3)
    bytes.appendBytes(&content, p4)
    return wrap(allocator, tag, content)
}

pub fn joined6(allocator: Allocator, tag: u32, p0: Bytes, p1: Bytes, p2: Bytes, p3: Bytes, p4: Bytes, p5: Bytes) -> ArrayList {
    var content = bytes.newList(allocator, p0.length + p1.length + p2.length + p3.length + p4.length + p5.length)
    bytes.appendBytes(&content, p0)
    bytes.appendBytes(&content, p1)
    bytes.appendBytes(&content, p2)
    bytes.appendBytes(&content, p3)
    bytes.appendBytes(&content, p4)
    bytes.appendBytes(&content, p5)
    return wrap(allocator, tag, content)
}

pub fn sequence1(allocator: Allocator, p0: Bytes) -> ArrayList { return joined1(allocator, TAG_SEQUENCE, p0) }
pub fn sequence2(allocator: Allocator, p0: Bytes, p1: Bytes) -> ArrayList { return joined2(allocator, TAG_SEQUENCE, p0, p1) }
pub fn sequence3(allocator: Allocator, p0: Bytes, p1: Bytes, p2: Bytes) -> ArrayList { return joined3(allocator, TAG_SEQUENCE, p0, p1, p2) }
pub fn sequence5(allocator: Allocator, p0: Bytes, p1: Bytes, p2: Bytes, p3: Bytes, p4: Bytes) -> ArrayList { return joined5(allocator, TAG_SEQUENCE, p0, p1, p2, p3, p4) }
pub fn sequence6(allocator: Allocator, p0: Bytes, p1: Bytes, p2: Bytes, p3: Bytes, p4: Bytes, p5: Bytes) -> ArrayList { return joined6(allocator, TAG_SEQUENCE, p0, p1, p2, p3, p4, p5) }
pub fn set1(allocator: Allocator, p0: Bytes) -> ArrayList { return joined1(allocator, TAG_SET, p0) }

// Context-specific constructed tag [n] (0xA0 | n) around one part.
pub fn contextTag(allocator: Allocator, n: u32, p0: Bytes) -> ArrayList { return joined1(allocator, 160 | n, p0) }

// INTEGER from a big-endian unsigned magnitude; DER needs a leading zero
// byte when the top bit is set.
pub fn integerFromUnsigned(allocator: Allocator, magnitude: Bytes) -> ArrayList {
    var content = bytes.newList(allocator, magnitude.length + 1)
    if magnitude.length == 0 || magnitude.pointer[0] & 128 != 0 { bytes.appendU8(&content, 0) }
    bytes.appendBytes(&content, magnitude)
    return wrap(allocator, TAG_INTEGER, content)
}

pub fn integerFromU64(allocator: Allocator, value: u64) -> ArrayList {
    var content = bytes.newList(allocator, 9)
    var started = false
    var index: usize = 8
    while index > 0 {
        index -= 1
        const byte = @intCast(u32, (value >> @intCast(u64, index * 8)) & 255)
        if byte != 0 || started || index == 0 {
            if !started && byte & 128 != 0 { bytes.appendU8(&content, 0) }
            bytes.appendU8(&content, byte)
            started = true
        }
    }
    return wrap(allocator, TAG_INTEGER, content)
}

pub fn octetString(allocator: Allocator, content: Bytes) -> ArrayList { return tlv(allocator, TAG_OCTET_STRING, content) }

pub fn bitString(allocator: Allocator, content: Bytes) -> ArrayList {
    var body = bytes.newList(allocator, content.length + 1)
    bytes.appendU8(&body, 0) // no unused bits
    bytes.appendBytes(&body, content)
    return wrap(allocator, TAG_BIT_STRING, body)
}

pub fn nullValue(allocator: Allocator) -> ArrayList {
    var out = bytes.newList(allocator, 2)
    bytes.appendU8(&out, TAG_NULL)
    bytes.appendU8(&out, 0)
    return out
}

pub fn utf8String(allocator: Allocator, text: Bytes) -> ArrayList { return tlv(allocator, TAG_UTF8_STRING, text) }

pub fn utcTime(allocator: Allocator, text: Bytes) -> ArrayList { return tlv(allocator, TAG_UTC_TIME, text) }

fn appendBase128(out: *ArrayList, value: u64) -> void {
    var groups: usize = 1
    var rest = value >> 7
    while rest > 0 {
        groups += 1
        rest = rest >> 7
    }
    var index = groups
    while index > 0 {
        index -= 1
        const group = @intCast(u32, (value >> @intCast(u64, index * 7)) & 127)
        bytes.appendU8(out, if index > 0 { group | 128 } else { group })
    }
}

// OBJECT IDENTIFIER from dotted decimal text, e.g. "1.2.840.113549.1.1.1".
pub fn oid(allocator: Allocator, dotted: Bytes) -> ArrayList {
    var content = bytes.newList(allocator, 16)
    var part: u64 = 0
    var part_index: usize = 0
    var first: u64 = 0
    var index: usize = 0
    while index <= dotted.length {
        if index == dotted.length || dotted.pointer[index] == 46 {
            if part_index == 0 {
                first = part
            } else if part_index == 1 {
                bytes.appendU8(&content, @intCast(u32, first * 40 + part))
            } else {
                appendBase128(&content, part)
            }
            part_index += 1
            part = 0
        } else {
            part = part * 10 + @intCast(u64, dotted.pointer[index] - 48)
        }
        index += 1
    }
    return wrap(allocator, TAG_OID, content)
}

// SEQUENCE { OID, NULL }: an AlgorithmIdentifier with absent parameters.
pub fn algorithm(allocator: Allocator, dotted: []const u8) -> ArrayList {
    const identifier = oid(allocator, bytes.ofText(dotted))
    const parameters = nullValue(allocator)
    const out = sequence2(allocator, bytes.ofList(identifier), bytes.ofList(parameters))
    bytes.free(identifier)
    bytes.free(parameters)
    return out
}
