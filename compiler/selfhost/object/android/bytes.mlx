// Byte views and little/big-endian helpers shared by the Android packaging
// modules (manifest, dex, zip, signing). A Bytes value is a borrowed
// (pointer, length) view; output is built in std/bootstrap ArrayLists.
const allocator_module = @import("../../../../std/bootstrap/allocator.mlx")
const array_list = @import("../../../../std/bootstrap/array_list.mlx")

pub const Allocator = allocator_module.Allocator
pub const ArrayList = array_list.ArrayList

pub const Bytes = struct {
    pointer: [*]const u8
    length: usize
}

pub fn of(pointer: [*]const u8, length: usize) -> Bytes {
    return Bytes.{ .pointer = pointer, .length = length }
}

pub fn ofList(list: ArrayList) -> Bytes {
    unsafe { return Bytes.{ .pointer = @ptrCast([*]const u8, list.items), .length = list.length } }
}

// A view of a string literal or other slice.
pub fn ofText(text: []const u8) -> Bytes {
    var length: usize = 0
    for byte in text { length += 1 }
    unsafe { return Bytes.{ .pointer = @ptrCast([*]const u8, text), .length = length } }
}

pub fn sub(value: Bytes, start: usize, end: usize) -> Bytes {
    unsafe { return Bytes.{ .pointer = @ptrFromInt([*]const u8, @intFromPtr(value.pointer) + start), .length = end - start } }
}

pub fn equal(a: Bytes, b: Bytes) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a.pointer[index] != b.pointer[index] { return false }
        index += 1
    }
    return true
}

pub fn newList(allocator: Allocator, capacity: usize) -> ArrayList {
    return array_list.ArrayList.init(allocator, if capacity > 0 { capacity } else { 16 })
}

// A zero-filled list of exactly `length` bytes.
pub fn zeroed(allocator: Allocator, length: usize) -> ArrayList {
    return array_list.ArrayList.resize(newList(allocator, length), length, 0)
}

pub fn appendU8(list: *ArrayList, value: u32) -> void {
    const appended = array_list.ArrayList.appendAt(list, @intCast(u8, value & 255))
}

pub fn appendU16(list: *ArrayList, value: u32) -> void {
    appendU8(list, value)
    appendU8(list, value >> 8)
}

pub fn appendU32(list: *ArrayList, value: u32) -> void {
    appendU8(list, value)
    appendU8(list, value >> 8)
    appendU8(list, value >> 16)
    appendU8(list, value >> 24)
}

pub fn appendU64(list: *ArrayList, value: u64) -> void {
    appendU32(list, @intCast(u32, value & 4294967295))
    appendU32(list, @intCast(u32, (value >> 32) & 4294967295))
}

pub fn appendBytes(list: *ArrayList, value: Bytes) -> void {
    var index: usize = 0
    while index < value.length {
        const appended = array_list.ArrayList.appendAt(list, value.pointer[index])
        index += 1
    }
}

pub fn appendText(list: *ArrayList, text: []const u8) -> void {
    for byte in text { const appended = array_list.ArrayList.appendAt(list, byte) }
}

pub fn appendList(list: *ArrayList, other: ArrayList) -> void {
    appendBytes(list, ofList(other))
}

pub fn setU8(list: ArrayList, offset: usize, value: u32) -> void {
    array_list.ArrayList.set(list, offset, @intCast(u8, value & 255))
}

pub fn setU16(list: ArrayList, offset: usize, value: u32) -> void {
    setU8(list, offset, value)
    setU8(list, offset + 1, value >> 8)
}

pub fn setU32(list: ArrayList, offset: usize, value: u32) -> void {
    setU8(list, offset, value)
    setU8(list, offset + 1, value >> 8)
    setU8(list, offset + 2, value >> 16)
    setU8(list, offset + 3, value >> 24)
}

pub fn readU32(value: Bytes, offset: usize) -> u32 {
    return @intCast(u32, value.pointer[offset]) | (@intCast(u32, value.pointer[offset + 1]) << 8) | (@intCast(u32, value.pointer[offset + 2]) << 16) | (@intCast(u32, value.pointer[offset + 3]) << 24)
}

pub fn free(list: ArrayList) -> void { array_list.ArrayList.deinit(list) }
