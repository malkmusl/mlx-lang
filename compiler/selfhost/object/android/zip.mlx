// ZIP container (an APK is a ZIP): stored (uncompressed) entries with a
// fixed timestamp. Entry data is aligned the way zipalign does it: native
// libraries (*.so) to 16 KiB so Android can map them in place, everything
// else to 4 bytes. Ported from experiments/android-aarch64-bluescreen/mlx/
// zip.mlx (which aligned only the libraries).
const bytes = @import("./bytes.mlx")
const hash = @import("./hash.mlx")
const vector = @import("../../../../std/bootstrap/vector.mlx")

pub const Allocator = bytes.Allocator
pub const ArrayList = bytes.ArrayList
pub const Bytes = bytes.Bytes

pub const Entry = struct {
    name: Bytes
    data: Bytes
}

pub const Entries = struct {
    items: *vector.Vector
    allocator: Allocator
}

pub fn createEntries(allocator: Allocator) -> Entries {
    unsafe {
        const items = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        vector.Vector.initAt(items, allocator, @sizeOf(Entry), @alignOf(Entry), 8)
        return Entries.{ .items = items, .allocator = allocator }
    }
}

pub fn add(entries: *Entries, name: Bytes, data: Bytes) -> void {
    const entry = Entry.{ .name = name, .data = data }
    unsafe { const appended = vector.Vector.appendAt(entries.*.items, @ptrCast([*]const u8, &entry)) }
}

pub fn count(entries: *Entries) -> usize { return entries.*.items.*.length }

pub fn at(entries: *Entries, index: usize) -> Entry {
    unsafe { return @ptrCast(*Entry, vector.Vector.at(entries.*.items.*, index)).* }
}

const LOCAL_SIGNATURE: u32 = 67324752 // 0x04034b50
const CENTRAL_SIGNATURE: u32 = 33639248 // 0x02014b50
const END_SIGNATURE: u32 = 101010256 // 0x06054b50
const DOS_DATE: u32 = 33 // 1980-01-01
const LIBRARY_ALIGNMENT: u32 = 16384

fn isNativeLibrary(name: Bytes) -> bool {
    if name.length < 3 { return false }
    return name.pointer[name.length - 3] == 46 && name.pointer[name.length - 2] == 115 && name.pointer[name.length - 1] == 111
}

pub fn build(allocator: Allocator, entries: *Entries) -> ArrayList {
    var out = bytes.newList(allocator, 65536)
    const total = count(entries)
    var offsets: [*]u32 = undefined
    var crcs: [*]u32 = undefined
    unsafe {
        offsets = @ptrCast([*]u32, allocator.alloc(total * 4 + 4, 4).?)
        crcs = @ptrCast([*]u32, allocator.alloc(total * 4 + 4, 4).?)
    }
    var index: usize = 0
    while index < total {
        const entry = at(entries, index)
        const crc = hash.crc32(entry.data)
        const header_start = @intCast(u32, out.length)
        offsets[index] = header_start
        crcs[index] = crc
        bytes.appendU32(&out, LOCAL_SIGNATURE)
        bytes.appendU16(&out, 20) // version needed
        bytes.appendU16(&out, 0) // flags
        bytes.appendU16(&out, 0) // stored
        bytes.appendU16(&out, 0) // time
        bytes.appendU16(&out, DOS_DATE)
        bytes.appendU32(&out, crc)
        bytes.appendU32(&out, @intCast(u32, entry.data.length))
        bytes.appendU32(&out, @intCast(u32, entry.data.length))
        bytes.appendU16(&out, @intCast(u32, entry.name.length))
        const alignment: u32 = if isNativeLibrary(entry.name) { LIBRARY_ALIGNMENT } else { 4 }
        const data_start = header_start + 30 + @intCast(u32, entry.name.length)
        const remainder = data_start % alignment
        const extra: u32 = if remainder != 0 { alignment - remainder } else { 0 }
        bytes.appendU16(&out, extra)
        bytes.appendBytes(&out, entry.name)
        var pad: u32 = 0
        while pad < extra {
            bytes.appendU8(&out, 0)
            pad += 1
        }
        bytes.appendBytes(&out, entry.data)
        index += 1
    }
    const directory_start = @intCast(u32, out.length)
    index = 0
    while index < total {
        const entry = at(entries, index)
        bytes.appendU32(&out, CENTRAL_SIGNATURE)
        bytes.appendU16(&out, 20) // version made by
        bytes.appendU16(&out, 20) // version needed
        bytes.appendU16(&out, 0) // flags
        bytes.appendU16(&out, 0) // stored
        bytes.appendU16(&out, 0) // time
        bytes.appendU16(&out, DOS_DATE)
        bytes.appendU32(&out, crcs[index])
        bytes.appendU32(&out, @intCast(u32, entry.data.length))
        bytes.appendU32(&out, @intCast(u32, entry.data.length))
        bytes.appendU16(&out, @intCast(u32, entry.name.length))
        bytes.appendU16(&out, 0) // extra
        bytes.appendU16(&out, 0) // comment
        bytes.appendU16(&out, 0) // disk
        bytes.appendU16(&out, 0) // internal attributes
        bytes.appendU32(&out, 0) // external attributes
        bytes.appendU32(&out, offsets[index])
        bytes.appendBytes(&out, entry.name)
        index += 1
    }
    const directory_size = @intCast(u32, out.length) - directory_start
    bytes.appendU32(&out, END_SIGNATURE)
    bytes.appendU16(&out, 0)
    bytes.appendU16(&out, 0)
    bytes.appendU16(&out, @intCast(u32, total))
    bytes.appendU16(&out, @intCast(u32, total))
    bytes.appendU32(&out, directory_size)
    bytes.appendU32(&out, directory_start)
    bytes.appendU16(&out, 0) // comment length
    unsafe {
        allocator.free(@ptrCast([*]u8, offsets), total * 4 + 4, 4)
        allocator.free(@ptrCast([*]u8, crcs), total * 4 + 4, 4)
    }
    return out
}
