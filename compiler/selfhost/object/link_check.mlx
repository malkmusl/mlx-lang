// A linker on its own, for checks of link.mlx: objects and archives
// (an ordinary C compiler's -fPIE ones too) into a program on libc:
//
//     link_check OUTPUT INPUT.o|INPUT.a...
const io = @import("../../../std/src/io.mlx")
const page_allocator = @import("../../../std/bootstrap/page_allocator.mlx")
const source = @import("../source.mlx")
const encoder = @import("../backend/x86_64/encoder.mlx")
const relocatable = @import("./relocatable.mlx")
const archive = @import("./archive.mlx")
const link = @import("./link.mlx")

fn cLength(text: [*]const u8) -> usize {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return length
}

fn say(text: []const u8) -> void { const ignored = io.writeAll(io.stderr(), text) }

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length < 3 {
        say("usage: link_check OUTPUT INPUT...\n")
        return 2
    }
    const allocator = page_allocator.init()
    var enc = encoder.init(allocator)
    var linker: link.Linker = undefined
    link.initAt(&linker, allocator, &enc)
    var index: usize = 2
    while index < arguments.length {
        const path = arguments[index]
        const length = cLength(path)
        const file = source.load(allocator, path, length)
        if !file.valid {
            say("cannot read ")
            say(path[0..length])
            say("\n")
            return 1
        }
        if archive.isArchive(file.bytes, file.length) {
            if !link.addArchive(&linker, file.bytes, file.length, path, length) {
                say(link.errorMessage(&linker))
                say(": ")
                say(link.errorName(&linker))
                say("\n")
                return 1
            }
        } else {
            const memory = allocator.alloc(@sizeOf(relocatable.Object), @alignOf(relocatable.Object))
            var object: *relocatable.Object = undefined
            unsafe { object = @ptrCast(*relocatable.Object, memory.?) }
            relocatable.initAt(object, allocator, path, length)
            if !relocatable.read(object, file.bytes, file.length) {
                say("not a relocatable object: ")
                say(path[0..length])
                say("\n")
                return 1
            }
            link.addObject(&linker, object)
        }
        index += 1
    }
    var needed: [1][*]const u8 = undefined
    unsafe { needed[0] = @ptrCast([*]const u8, "libc.so.6") }
    var needed_list: [*]const [*]const u8 = undefined
    unsafe { needed_list = @ptrCast([*]const [*]const u8, &needed) }
    if !link.writeProgram(&linker, needed_list, 1, arguments[1], 0, arguments[1]) {
        say("link_check: ")
        say(link.errorMessage(&linker))
        say(" ")
        say(link.errorName(&linker))
        say("\n")
        return 1
    }
    return 0
}
