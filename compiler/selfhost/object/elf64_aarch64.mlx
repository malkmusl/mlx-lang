// Static ELF64 executables for Linux on AArch64.
//
// Two PT_LOAD segments: headers plus .text (read + execute) from offset 0,
// then .data (read + write) holding the backend's writable data block. The
// data segment sits one 64 KiB step above the file offset it is stored at,
// so the two segments never share a page for any page size up to 64 KiB
// (arm64 kernels run with 4, 16 or 64 KiB pages).
const mem = @import("../../../std/bootstrap/mem.mlx")
const fs = @import("../../../std/bootstrap/fs.mlx")
const elf = @import("../../../std/bootstrap/elf.mlx")
const allocator_mod = @import("../../../std/bootstrap/allocator.mlx")

pub const Allocator = allocator_mod.Allocator

pub const LOAD_VADDR: usize = 4194304
pub const TEXT_FILE_OFFSET: usize = 4096
pub const TEXT_VADDR: usize = LOAD_VADDR + TEXT_FILE_OFFSET
pub const SEGMENT_ALIGN: usize = 65536
const EM_AARCH64: u16 = 183

pub fn alignUp(value: usize, alignment: usize) -> usize {
    return (value + alignment - 1) & ~(alignment - 1)
}

pub fn dataFileOffset(code_length: usize) -> usize {
    return alignUp(TEXT_FILE_OFFSET + code_length, 16)
}

// Where the writable data block is loaded, given the size of .text.
pub fn dataVaddr(code_length: usize) -> usize {
    return LOAD_VADDR + SEGMENT_ALIGN + dataFileOffset(code_length)
}

fn putName(buffer: [*]u8, offset: usize, name: [*]const u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        buffer[offset + index] = name[index]
        index += 1
    }
    buffer[offset + length] = 0
}

fn writeSegment(buffer: [*]u8, offset: usize, flags: u32, file_offset: usize, vaddr: usize, file_size: usize, memory_size: usize) -> void {
    elf.writeU32(buffer, offset + 0, 1) // PT_LOAD
    elf.writeU32(buffer, offset + 4, flags)
    elf.writeU64(buffer, offset + 8, @intCast(u64, file_offset))
    elf.writeU64(buffer, offset + 16, @intCast(u64, vaddr))
    elf.writeU64(buffer, offset + 24, @intCast(u64, vaddr))
    elf.writeU64(buffer, offset + 32, @intCast(u64, file_size))
    elf.writeU64(buffer, offset + 40, @intCast(u64, memory_size))
    elf.writeU64(buffer, offset + 48, @intCast(u64, SEGMENT_ALIGN))
}

fn writeSection(buffer: [*]u8, offset: usize, name: u32, kind: u32, flags: u64, address: usize, file_offset: usize, size: usize, alignment: u64) -> void {
    elf.writeU32(buffer, offset + 0, name)
    elf.writeU32(buffer, offset + 4, kind)
    elf.writeU64(buffer, offset + 8, flags)
    elf.writeU64(buffer, offset + 16, @intCast(u64, address))
    elf.writeU64(buffer, offset + 24, @intCast(u64, file_offset))
    elf.writeU64(buffer, offset + 32, @intCast(u64, size))
    elf.writeU32(buffer, offset + 40, 0)
    elf.writeU32(buffer, offset + 44, 0)
    elf.writeU64(buffer, offset + 48, alignment)
    elf.writeU64(buffer, offset + 56, 0)
}

// Writes the executable: `code` is loaded at TEXT_VADDR with the entry
// point at `entry_offset`; `data_size` zero bytes are loaded at
// dataVaddr(code_length).
pub fn writeExecutable(allocator: Allocator, code: [*]const u8, code_length: usize, entry_offset: usize, data_size: usize, output_path: [*]const u8) -> bool {
    const data_off = dataFileOffset(code_length)
    const data_length = if data_size > 0 { alignUp(data_size, 8) } else { 8 }
    const shstrtab_off = data_off + data_length
    const shstrtab_size: usize = 23 // "\0.text\0.data\0.shstrtab\0"
    const shdr_off = alignUp(shstrtab_off + shstrtab_size, 8)
    const total_size = shdr_off + 4 * 64

    const buffer_opt = allocator.alloc(total_size, 8)
    if buffer_opt == null { return false }
    const buffer = buffer_opt.?
    mem.zero(buffer, total_size)

    buffer[0] = 127
    buffer[1] = 69
    buffer[2] = 76
    buffer[3] = 70
    buffer[4] = 2 // ELFCLASS64
    buffer[5] = 1 // little endian
    buffer[6] = 1 // EV_CURRENT
    elf.writeU16(buffer, 16, 2) // ET_EXEC
    elf.writeU16(buffer, 18, EM_AARCH64)
    elf.writeU32(buffer, 20, 1)
    elf.writeU64(buffer, 24, @intCast(u64, TEXT_VADDR + entry_offset))
    elf.writeU64(buffer, 32, 64) // e_phoff
    elf.writeU64(buffer, 40, @intCast(u64, shdr_off))
    elf.writeU16(buffer, 52, 64) // e_ehsize
    elf.writeU16(buffer, 54, 56) // e_phentsize
    elf.writeU16(buffer, 56, 2) // e_phnum
    elf.writeU16(buffer, 58, 64) // e_shentsize
    elf.writeU16(buffer, 60, 4) // e_shnum
    elf.writeU16(buffer, 62, 3) // e_shstrndx

    writeSegment(buffer, 64, 5, 0, LOAD_VADDR, TEXT_FILE_OFFSET + code_length, TEXT_FILE_OFFSET + code_length) // R + X
    writeSegment(buffer, 120, 6, data_off, dataVaddr(code_length), data_length, data_length) // R + W

    unsafe { mem.copy(@ptrFromInt([*]u8, @intFromPtr(buffer) + TEXT_FILE_OFFSET), code, code_length) }

    unsafe {
        putName(buffer, shstrtab_off + 1, @ptrCast([*]const u8, ".text"), 5)
        putName(buffer, shstrtab_off + 7, @ptrCast([*]const u8, ".data"), 5)
        putName(buffer, shstrtab_off + 13, @ptrCast([*]const u8, ".shstrtab"), 9)
    }
    writeSection(buffer, shdr_off + 64, 1, 1, 6, TEXT_VADDR, TEXT_FILE_OFFSET, code_length, 16) // SHT_PROGBITS, AX
    writeSection(buffer, shdr_off + 128, 7, 1, 3, dataVaddr(code_length), data_off, data_length, 16) // SHT_PROGBITS, WA
    writeSection(buffer, shdr_off + 192, 13, 3, 0, 0, shstrtab_off, shstrtab_size, 1) // SHT_STRTAB

    const wrote = writeFile(buffer, total_size, output_path)
    allocator.free(buffer, total_size, 8)
    return wrote
}

pub fn writeFile(buffer: [*]const u8, size: usize, output_path: [*]const u8) -> bool {
    return writeFileMode(buffer, size, output_path, 493) // 0o755
}

pub fn writeFileMode(buffer: [*]const u8, size: usize, output_path: [*]const u8, mode: usize) -> bool {
    const file = fs.open(output_path, fs.WRITE_ONLY | fs.CREATE | fs.TRUNCATE, mode)
    if !fs.isValid(file) { return false }
    var written: usize = 0
    var wrote = true
    while written < size {
        unsafe {
            const source = @ptrFromInt([*]const u8, @intFromPtr(buffer) + written)
            const amount = fs.write(file, source, size - written)
            if amount <= 0 {
                wrote = false
                break
            }
            written += @bitCast(usize, amount)
        }
    }
    const closed = fs.close(file)
    const permissions = fs.chmod(output_path, mode)
    return wrote && closed && permissions
}

// ── Shared objects (ET_DYN), for Android ──────────────────────────────────
//
// Layout, every segment at vaddr == file offset and 16 KiB aligned (Android
// requires PT_LOAD alignment >= the device page size, 16 KiB on newer
// devices):
//
//   R    headers, .dynsym, .dynstr, .hash, .rela.dyn
//   R+X  .text (code, runtime helpers, string literals)
//   R+W  .dynamic, .got (one slot per imported function), .data
//
// Each imported function gets an undefined .dynsym entry and an eager
// R_AARCH64_GLOB_DAT relocation filling its GOT slot; code calls through
// the slot (ADRP/LDR/BLR), so there is no PLT and no lazy binding. Bionic
// looks every undefined symbol up across all DT_NEEDED libraries, so an
// import does not name its library. Exported functions get defined .dynsym
// entries. The code is position independent (PC-relative addressing only),
// so the GOT slots are the only relocations.
const encoder = @import("../backend/aarch64/encoder.mlx")
const array_list = @import("../../../std/bootstrap/array_list.mlx")

const SHARED_PAGE: usize = 16384
const SYMBOL_SIZE: usize = 24
const RELA_SIZE: usize = 24
const DYNAMIC_SIZE: usize = 16
const TEXT_SECTION_INDEX: u16 = 6
const R_AARCH64_GLOB_DAT: u64 = 1025

pub const SHARED_OK: u8 = 0
pub const SHARED_UNRESOLVED: u8 = 1
pub const SHARED_WRITE_FAILED: u8 = 2

fn appendString(list: *array_list.ArrayList, pointer: [*]const u8, length: usize) -> u32 {
    const offset = @intCast(u32, list.*.length)
    var index: usize = 0
    while index < length {
        const appended = array_list.ArrayList.appendAt(list, pointer[index])
        index += 1
    }
    const terminated = array_list.ArrayList.appendAt(list, 0)
    return offset
}

fn stringLength(pointer: [*]const u8, limit: usize) -> usize {
    var length: usize = 0
    while length < limit && pointer[length] != 0 { length += 1 }
    return length
}

fn copyBytes(buffer: [*]u8, offset: usize, source: [*]const u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        buffer[offset + index] = source[index]
        index += 1
    }
}

fn writeDynamic(buffer: [*]u8, offset: usize, tag: u64, value: u64) -> usize {
    elf.writeU64(buffer, offset, tag)
    elf.writeU64(buffer, offset + 8, value)
    return offset + DYNAMIC_SIZE
}

fn writeSymbol(buffer: [*]u8, offset: usize, name: u32, section: u16, value: u64) -> void {
    elf.writeU32(buffer, offset, name)
    buffer[offset + 4] = 18 // STB_GLOBAL << 4 | STT_FUNC
    buffer[offset + 5] = 0
    elf.writeU16(buffer, offset + 6, section)
    elf.writeU64(buffer, offset + 8, value)
    elf.writeU64(buffer, offset + 16, 0)
}

fn writeHeader(buffer: [*]u8, offset: usize, kind: u32, flags: u32, address: usize, size: usize, alignment: u64) -> void {
    elf.writeU32(buffer, offset + 0, kind)
    elf.writeU32(buffer, offset + 4, flags)
    elf.writeU64(buffer, offset + 8, @intCast(u64, address))
    elf.writeU64(buffer, offset + 16, @intCast(u64, address))
    elf.writeU64(buffer, offset + 24, @intCast(u64, address))
    elf.writeU64(buffer, offset + 32, @intCast(u64, size))
    elf.writeU64(buffer, offset + 40, @intCast(u64, size))
    elf.writeU64(buffer, offset + 48, alignment)
}

pub const SharedObject = struct {
    status: u8
    buffer: [*]u8
    size: usize
}

// Resolves the encoder's fixups for the shared-object layout and writes
// the file. `needed` holds the DT_NEEDED library names, each terminated by
// a zero byte, `needed_length` bytes in total.
pub fn writeSharedObject(allocator: Allocator, enc: *encoder.Encoder, soname: [*]const u8, soname_length: usize, needed: [*]const u8, needed_length: usize, output_path: [*]const u8) -> u8 {
    const image = buildSharedObject(allocator, enc, soname, soname_length, needed, needed_length)
    if image.status != SHARED_OK { return image.status }
    const wrote = writeFile(image.buffer, image.size, output_path)
    allocator.free(image.buffer, image.size, 8)
    return if wrote { SHARED_OK } else { SHARED_WRITE_FAILED }
}

// The shared object image in memory (status SHARED_OK), for callers that
// package it further (the APK writer).
pub fn buildSharedObject(allocator: Allocator, enc: *encoder.Encoder, soname: [*]const u8, soname_length: usize, needed: [*]const u8, needed_length: usize) -> SharedObject {
    const import_count = encoder.importCount(enc)
    const export_count = encoder.exportCount(enc)
    const symbol_count = 1 + import_count + export_count

    var dynstr = array_list.ArrayList.init(allocator, 256)
    const empty = array_list.ArrayList.appendAt(&dynstr, 0)
    var name_offsets: [*]u32 = undefined
    unsafe { name_offsets = @ptrCast([*]u32, allocator.alloc(symbol_count * 4, 4).?) }
    name_offsets[0] = 0
    var index: usize = 0
    while index < import_count {
        const entry = encoder.importAt(enc, index)
        name_offsets[1 + index] = appendString(&dynstr, entry.namePointer, entry.nameLength)
        index += 1
    }
    index = 0
    while index < export_count {
        const entry = encoder.exportAt(enc, index)
        name_offsets[1 + import_count + index] = appendString(&dynstr, entry.namePointer, entry.nameLength)
        index += 1
    }
    const needed_start = dynstr.length
    var needed_count: usize = 0
    var cursor: usize = 0
    while cursor < needed_length {
        var name: [*]const u8 = undefined
        unsafe { name = @ptrFromInt([*]const u8, @intFromPtr(needed) + cursor) }
        const length = stringLength(name, needed_length - cursor)
        if length > 0 {
            const offset = appendString(&dynstr, name, length)
            needed_count += 1
        }
        cursor += length + 1
    }
    const soname_offset = appendString(&dynstr, soname, soname_length)

    // Read-only segment.
    const phdr_count: usize = 4
    const dynsym_off = alignUp(64 + phdr_count * 56, 8)
    const dynsym_size = symbol_count * SYMBOL_SIZE
    const dynstr_off = dynsym_off + dynsym_size
    const dynstr_size = dynstr.length
    const hash_off = alignUp(dynstr_off + dynstr_size, 8)
    const hash_size = (3 + symbol_count) * 4 // nbucket, nchain, one bucket, chains
    const rela_off = alignUp(hash_off + hash_size, 8)
    const rela_size = import_count * RELA_SIZE
    const ro_end = rela_off + rela_size
    // Code.
    const code_length = encoder.pos(enc)
    const text_vaddr = alignUp(ro_end, SHARED_PAGE)
    // Writable segment.
    const rw_vaddr = alignUp(text_vaddr + code_length, SHARED_PAGE)
    const dynamic_count = needed_count + 10 // SONAME HASH STRTAB SYMTAB STRSZ SYMENT RELA RELASZ RELAENT NULL
    const dynamic_size = dynamic_count * DYNAMIC_SIZE
    const got_vaddr = rw_vaddr + dynamic_size
    const got_size = import_count * 8
    const data_vaddr = alignUp(got_vaddr + got_size, 16)
    const data_size = if enc.*.dataSize > 0 { alignUp(enc.*.dataSize, 8) } else { 8 }
    const rw_end = data_vaddr + data_size

    if !encoder.applyFixups(enc, @intCast(u64, text_vaddr), @intCast(u64, data_vaddr), @intCast(u64, got_vaddr)) {
        unsafe { allocator.free(@ptrCast([*]u8, name_offsets), symbol_count * 4, 4) }
        array_list.ArrayList.deinit(dynstr)
        unsafe { return SharedObject.{ .status = SHARED_UNRESOLVED, .buffer = @ptrFromInt([*]u8, 0), .size = 0 } }
    }

    const shstrtab_off = rw_end
    const shstrtab_size: usize = 69 // "\0.dynsym\0.dynstr\0.hash\0.rela.dyn\0.dynamic\0.text\0.got\0.data\0.shstrtab\0"
    const shdr_off = alignUp(shstrtab_off + shstrtab_size, 8)
    const section_count: usize = 10
    const file_size = shdr_off + section_count * 64

    const buffer = allocator.alloc(file_size, 8).?
    mem.zero(buffer, file_size)

    buffer[0] = 127
    buffer[1] = 69
    buffer[2] = 76
    buffer[3] = 70
    buffer[4] = 2
    buffer[5] = 1
    buffer[6] = 1
    elf.writeU16(buffer, 16, 3) // ET_DYN
    elf.writeU16(buffer, 18, EM_AARCH64)
    elf.writeU32(buffer, 20, 1)
    elf.writeU64(buffer, 32, 64)
    elf.writeU64(buffer, 40, @intCast(u64, shdr_off))
    elf.writeU16(buffer, 52, 64)
    elf.writeU16(buffer, 54, 56)
    elf.writeU16(buffer, 56, @intCast(u16, phdr_count))
    elf.writeU16(buffer, 58, 64)
    elf.writeU16(buffer, 60, @intCast(u16, section_count))
    elf.writeU16(buffer, 62, 9)

    writeHeader(buffer, 64, 1, 4, 0, ro_end, @intCast(u64, SHARED_PAGE)) // PT_LOAD R
    writeHeader(buffer, 120, 1, 5, text_vaddr, code_length, @intCast(u64, SHARED_PAGE)) // PT_LOAD R+X
    writeHeader(buffer, 176, 1, 6, rw_vaddr, rw_end - rw_vaddr, @intCast(u64, SHARED_PAGE)) // PT_LOAD R+W
    writeHeader(buffer, 232, 2, 6, rw_vaddr, dynamic_size, 8) // PT_DYNAMIC

    // .dynsym: [0] null, then imports (undefined), then exports.
    index = 0
    while index < import_count {
        writeSymbol(buffer, dynsym_off + (1 + index) * SYMBOL_SIZE, name_offsets[1 + index], 0, 0)
        index += 1
    }
    index = 0
    while index < export_count {
        const entry = encoder.exportAt(enc, index)
        writeSymbol(buffer, dynsym_off + (1 + import_count + index) * SYMBOL_SIZE, name_offsets[1 + import_count + index], TEXT_SECTION_INDEX, @intCast(u64, text_vaddr + entry.offset))
        index += 1
    }
    copyBytes(buffer, dynstr_off, dynstr.items, dynstr_size)

    // .hash with a single bucket: bucket[0] = 1 and chain[i] = i + 1 visit
    // every symbol for any name, a valid if linear SysV hash table.
    elf.writeU32(buffer, hash_off, 1)
    elf.writeU32(buffer, hash_off + 4, @intCast(u32, symbol_count))
    elf.writeU32(buffer, hash_off + 8, if symbol_count > 1 { 1 } else { 0 })
    index = 1
    while index < symbol_count {
        elf.writeU32(buffer, hash_off + 12 + index * 4, if index + 1 < symbol_count { @intCast(u32, index + 1) } else { 0 })
        index += 1
    }

    // .rela.dyn: GLOB_DAT per GOT slot.
    index = 0
    while index < import_count {
        const rela = rela_off + index * RELA_SIZE
        elf.writeU64(buffer, rela, @intCast(u64, got_vaddr + index * 8))
        elf.writeU64(buffer, rela + 8, (@intCast(u64, 1 + index) << 32) | R_AARCH64_GLOB_DAT)
        elf.writeU64(buffer, rela + 16, 0)
        index += 1
    }

    // .dynamic
    var dynamic = rw_vaddr
    var offset = needed_start
    index = 0
    while index < needed_count {
        dynamic = writeDynamic(buffer, dynamic, 1, @intCast(u64, offset)) // DT_NEEDED
        var name: [*]const u8 = undefined
        unsafe { name = @ptrFromInt([*]const u8, @intFromPtr(dynstr.items) + offset) }
        offset += stringLength(name, dynstr_size - offset) + 1
        index += 1
    }
    dynamic = writeDynamic(buffer, dynamic, 14, @intCast(u64, soname_offset)) // DT_SONAME
    dynamic = writeDynamic(buffer, dynamic, 4, @intCast(u64, hash_off)) // DT_HASH
    dynamic = writeDynamic(buffer, dynamic, 5, @intCast(u64, dynstr_off)) // DT_STRTAB
    dynamic = writeDynamic(buffer, dynamic, 6, @intCast(u64, dynsym_off)) // DT_SYMTAB
    dynamic = writeDynamic(buffer, dynamic, 10, @intCast(u64, dynstr_size)) // DT_STRSZ
    dynamic = writeDynamic(buffer, dynamic, 11, @intCast(u64, SYMBOL_SIZE)) // DT_SYMENT
    dynamic = writeDynamic(buffer, dynamic, 7, @intCast(u64, rela_off)) // DT_RELA
    dynamic = writeDynamic(buffer, dynamic, 8, @intCast(u64, rela_size)) // DT_RELASZ
    dynamic = writeDynamic(buffer, dynamic, 9, @intCast(u64, RELA_SIZE)) // DT_RELAENT
    dynamic = writeDynamic(buffer, dynamic, 0, 0) // DT_NULL

    copyBytes(buffer, text_vaddr, enc.*.buf.*.items, code_length)

    unsafe {
        putName(buffer, shstrtab_off + 1, @ptrCast([*]const u8, ".dynsym"), 7)
        putName(buffer, shstrtab_off + 9, @ptrCast([*]const u8, ".dynstr"), 7)
        putName(buffer, shstrtab_off + 17, @ptrCast([*]const u8, ".hash"), 5)
        putName(buffer, shstrtab_off + 23, @ptrCast([*]const u8, ".rela.dyn"), 9)
        putName(buffer, shstrtab_off + 33, @ptrCast([*]const u8, ".dynamic"), 8)
        putName(buffer, shstrtab_off + 42, @ptrCast([*]const u8, ".text"), 5)
        putName(buffer, shstrtab_off + 48, @ptrCast([*]const u8, ".got"), 4)
        putName(buffer, shstrtab_off + 53, @ptrCast([*]const u8, ".data"), 5)
        putName(buffer, shstrtab_off + 59, @ptrCast([*]const u8, ".shstrtab"), 9)
    }
    const sh = shdr_off
    writeSectionLinked(buffer, sh + 64, 1, 11, 2, dynsym_off, dynsym_off, dynsym_size, 8, 24, 2, 1) // .dynsym
    writeSectionLinked(buffer, sh + 128, 9, 3, 2, dynstr_off, dynstr_off, dynstr_size, 1, 0, 0, 0) // .dynstr
    writeSectionLinked(buffer, sh + 192, 17, 5, 2, hash_off, hash_off, hash_size, 4, 4, 1, 0) // .hash
    writeSectionLinked(buffer, sh + 256, 23, 4, 2, rela_off, rela_off, rela_size, 8, 24, 1, 0) // .rela.dyn
    writeSectionLinked(buffer, sh + 320, 33, 6, 3, rw_vaddr, rw_vaddr, dynamic_size, 8, 16, 2, 0) // .dynamic
    writeSectionLinked(buffer, sh + 384, 42, 1, 6, text_vaddr, text_vaddr, code_length, 16, 0, 0, 0) // .text
    writeSectionLinked(buffer, sh + 448, 48, 1, 3, got_vaddr, got_vaddr, got_size, 8, 8, 0, 0) // .got
    writeSectionLinked(buffer, sh + 512, 53, 1, 3, data_vaddr, data_vaddr, data_size, 16, 0, 0, 0) // .data
    writeSectionLinked(buffer, sh + 576, 59, 3, 0, 0, shstrtab_off, shstrtab_size, 1, 0, 0, 0) // .shstrtab

    unsafe { allocator.free(@ptrCast([*]u8, name_offsets), symbol_count * 4, 4) }
    array_list.ArrayList.deinit(dynstr)
    return SharedObject.{ .status = SHARED_OK, .buffer = buffer, .size = file_size }
}

fn writeSectionLinked(buffer: [*]u8, offset: usize, name: u32, kind: u32, flags: u64, address: usize, file_offset: usize, size: usize, alignment: u64, entry_size: u64, link: u32, info: u32) -> void {
    elf.writeU32(buffer, offset + 0, name)
    elf.writeU32(buffer, offset + 4, kind)
    elf.writeU64(buffer, offset + 8, flags)
    elf.writeU64(buffer, offset + 16, @intCast(u64, address))
    elf.writeU64(buffer, offset + 24, @intCast(u64, file_offset))
    elf.writeU64(buffer, offset + 32, @intCast(u64, size))
    elf.writeU32(buffer, offset + 40, link)
    elf.writeU32(buffer, offset + 44, info)
    elf.writeU64(buffer, offset + 48, alignment)
    elf.writeU64(buffer, offset + 56, entry_size)
}
