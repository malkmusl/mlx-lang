// The linker: relocatable objects (relocatable.mlx) and the members of
// archives (archive.mlx) that define what the others need, placed into
// one encoder and written as a dynamically linked program
// (elf64_dynamic.mlx).
//
// The code of every object goes after a `_start` the linker makes, the
// data and zero data into the data area. A reference from code to a
// function or variable of the program is resolved to its distance; one
// to a name no object defines is an import from the libraries named
// (DT_NEEDED): a call goes through a stub that jumps through the GOT
// slot, the address of one is read from the slot (a `lea` becomes a
// `mov`). A GOT-relative reference to a name of the program reads a
// word of the data area holding its address. Addresses held by data
// (an initialized pointer, a table of functions) and those words are
// written when the program starts, by `__mlxcc_init`, which `_start`
// calls before main(argc, argv, envp) and which runs the functions of
// the objects' .init_array sections (a C unit's own initialization).
const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")
const vector = @import("../../../std/bootstrap/vector.mlx")
const fs = @import("../../../std/bootstrap/fs.mlx")
const elf = @import("../../../std/bootstrap/elf.mlx")
const encoder_module = @import("../backend/x86_64/encoder.mlx")
const x86 = @import("../backend/x86_64/target.mlx")
const elf64 = @import("./elf64.mlx")
const elf64_dynamic = @import("./elf64_dynamic.mlx")
const relocatable = @import("./relocatable.mlx")
const archive = @import("./archive.mlx")

pub const Allocator = allocator_module.Allocator
pub const Object = relocatable.Object

const NONE: usize = relocatable.NONE

// What a symbol stands for once placed.
const IN_CODE: u8 = 1
const IN_DATA: u8 = 2
const IMPORTED: u8 = 3
const ABSOLUTE: u8 = 4
// A thread-local variable: `value` its offset in the TLS image.
const IN_TLS: u8 = 5

const Resolved = struct {
    kind: u8
    value: usize
    namePointer: [*]const u8
    nameLength: usize
}

// An address written into the data area at start: the word at `place`
// holds `target` plus `addend`.
const Absolute = struct {
    place: usize
    target: Resolved
    addend: i64
}

// A stub of an imported function: `jmp [rip + GOT slot]` at `offset`.
const Stub = struct {
    namePointer: [*]const u8
    nameLength: usize
    nameHash: usize
    offset: usize
}

pub const Linker = struct {
    allocator: Allocator
    enc: *encoder_module.Encoder
    // The objects (Object, by address), in the order given.
    objects: *vector.Vector
    // The global symbols' definitions: open addressing by name hash,
    // each slot the object's index and the symbol's (NONE: empty).
    tableObjects: [*]usize
    tableSymbols: [*]usize
    tableCapacity: usize
    absolutes: *vector.Vector
    stubs: *vector.Vector
    // The init functions (code offsets) to call, in order.
    inits: *vector.Vector
    // The first error: a message and the name it is about.
    errorPointer: [*]const u8
    errorLength: usize
    errorNamePointer: [*]const u8
    errorNameLength: usize
    // Whether the program goes without its symbol table (-s,
    // --strip-all), and where _start's code ends.
    stripped: bool
    startEnd: usize
}

fn newVector(allocator: Allocator, element_size: usize, element_alignment: usize, capacity: usize) -> *vector.Vector {
    unsafe {
        const v = @ptrCast(*vector.Vector, allocator.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        vector.Vector.initAt(v, allocator, element_size, element_alignment, capacity)
        return v
    }
}

pub fn initAt(linker: *Linker, allocator: Allocator, enc: *encoder_module.Encoder) -> void {
    linker.*.allocator = allocator
    linker.*.enc = enc
    linker.*.objects = newVector(allocator, 8, 8, 16)
    unsafe {
        linker.*.tableObjects = @ptrFromInt([*]usize, 0)
        linker.*.tableSymbols = @ptrFromInt([*]usize, 0)
        linker.*.errorPointer = @ptrCast([*]const u8, "")
        linker.*.errorNamePointer = @ptrCast([*]const u8, "")
    }
    linker.*.tableCapacity = 0
    linker.*.absolutes = newVector(allocator, @sizeOf(Absolute), @alignOf(Absolute), 64)
    linker.*.stubs = newVector(allocator, @sizeOf(Stub), @alignOf(Stub), 16)
    linker.*.inits = newVector(allocator, 8, 8, 8)
    linker.*.errorLength = 0
    linker.*.errorNameLength = 0
    linker.*.stripped = false
    linker.*.startEnd = 0
}

// -s, --strip-all: the program is written without .symtab, .strtab and
// .mlx_lines.
pub fn setStripped(linker: *Linker, stripped: bool) -> void { linker.*.stripped = stripped }

fn fail(linker: *Linker, message: []const u8, name: [*]const u8, name_length: usize) -> bool {
    if linker.*.errorLength != 0 { return false }
    unsafe { linker.*.errorPointer = @ptrCast([*]const u8, message) }
    linker.*.errorLength = message.length
    linker.*.errorNamePointer = name
    linker.*.errorNameLength = name_length
    return false
}

pub fn errorMessage(linker: *Linker) -> []const u8 { return linker.*.errorPointer[0..linker.*.errorLength] }
pub fn errorName(linker: *Linker) -> []const u8 { return linker.*.errorNamePointer[0..linker.*.errorNameLength] }

pub fn objectCount(linker: *Linker) -> usize { return linker.*.objects.*.length }

pub fn objectAt(linker: *Linker, index: usize) -> *Object {
    unsafe { return @ptrFromInt(*Object, @ptrCast(*usize, vector.Vector.at(linker.*.objects.*, index)).*) }
}

// Adds an object of the program.
pub fn addObject(linker: *Linker, object: *Object) -> void {
    object.*.included = true
    const address = @intFromPtr(object)
    unsafe { const appended = vector.Vector.appendAt(linker.*.objects, @ptrCast([*]const u8, &address)) }
}

// Adds the members of an archive: each becomes part of the program when
// a symbol it defines is needed. False when a member is not an object.
pub fn addArchive(linker: *Linker, bytes: [*]const u8, length: usize, path: [*]const u8, path_length: usize) -> bool {
    var r = archive.reader(bytes, length)
    var member: archive.Member = undefined
    while archive.next(&r, &member) {
        const memory = linker.*.allocator.alloc(@sizeOf(Object), @alignOf(Object))
        if memory == null { return fail(linker, "out of memory", path, path_length) }
        var object: *Object = undefined
        unsafe { object = @ptrCast(*Object, memory.?) }
        relocatable.initAt(object, linker.*.allocator, member.namePointer, member.nameLength)
        if !relocatable.read(object, member.bytes, member.length) { return fail(linker, "not an object in the archive", member.namePointer, member.nameLength) }
        object.*.included = false
        const address = @intFromPtr(object)
        unsafe { const appended = vector.Vector.appendAt(linker.*.objects, @ptrCast([*]const u8, &address)) }
    }
    return true
}

// ---------------------------------------------------------------------------
// Symbols

fn isGlobal(symbol: *relocatable.Symbol) -> bool {
    return symbol.*.binding == relocatable.GLOBAL || symbol.*.binding == relocatable.WEAK
}

fn sameName(symbol: *relocatable.Symbol, name: [*]const u8, length: usize, hash: usize) -> bool {
    return symbol.*.nameHash == hash && symbol.*.nameLength == length && mem.eql(symbol.*.namePointer, name, length)
}

fn tableInsert(linker: *Linker, object_index: usize, symbol_index: usize) -> void {
    const symbol = relocatable.symbolAt(objectAt(linker, object_index), symbol_index)
    var slot = symbol.*.nameHash % linker.*.tableCapacity
    while linker.*.tableObjects[slot] != NONE {
        slot = (slot + 1) % linker.*.tableCapacity
    }
    linker.*.tableObjects[slot] = object_index
    linker.*.tableSymbols[slot] = symbol_index
}

// The definition of the global `name` among the included objects: the
// object's index and the symbol's, or NONE.
fn tableFind(linker: *Linker, name: [*]const u8, length: usize, hash: usize) -> (usize, usize) {
    if linker.*.tableCapacity == 0 { return -> (NONE, NONE) }
    var slot = hash % linker.*.tableCapacity
    var probes: usize = 0
    while linker.*.tableObjects[slot] != NONE && probes < linker.*.tableCapacity {
        const symbol = relocatable.symbolAt(objectAt(linker, linker.*.tableObjects[slot]), linker.*.tableSymbols[slot])
        if sameName(symbol, name, length, hash) { return -> (linker.*.tableObjects[slot], linker.*.tableSymbols[slot]) }
        slot = (slot + 1) % linker.*.tableCapacity
        probes += 1
    }
    return -> (NONE, NONE)
}

// Builds the table of the included objects' defined global symbols: a
// strong definition over a weak one, two strong ones an error.
fn buildTable(linker: *Linker) -> bool {
    var total: usize = 0
    var index: usize = 0
    while index < objectCount(linker) {
        const object = objectAt(linker, index)
        if object.*.included { total += relocatable.symbolCount(object) }
        index += 1
    }
    var capacity: usize = 16
    while capacity < total * 2 + 2 { capacity *= 2 }
    if linker.*.tableCapacity != 0 {
        unsafe {
            linker.*.allocator.free(@ptrCast([*]u8, linker.*.tableObjects), linker.*.tableCapacity * 8, 8)
            linker.*.allocator.free(@ptrCast([*]u8, linker.*.tableSymbols), linker.*.tableCapacity * 8, 8)
        }
    }
    const objects_memory = linker.*.allocator.alloc(capacity * 8, 8)
    const symbols_memory = linker.*.allocator.alloc(capacity * 8, 8)
    if objects_memory == null || symbols_memory == null { return fail(linker, "out of memory", linker.*.errorNamePointer, 0) }
    unsafe {
        linker.*.tableObjects = @ptrCast([*]usize, objects_memory.?)
        linker.*.tableSymbols = @ptrCast([*]usize, symbols_memory.?)
    }
    linker.*.tableCapacity = capacity
    var slot: usize = 0
    while slot < capacity {
        linker.*.tableObjects[slot] = NONE
        slot += 1
    }
    index = 0
    while index < objectCount(linker) {
        const object = objectAt(linker, index)
        if object.*.included {
            var symbol_index: usize = 0
            while symbol_index < relocatable.symbolCount(object) {
                const symbol = relocatable.symbolAt(object, symbol_index)
                if isGlobal(symbol) && relocatable.isDefined(symbol) {
                    const known = tableFind(linker, symbol.*.namePointer, symbol.*.nameLength, symbol.*.nameHash)
                    if known.0 == NONE {
                        tableInsert(linker, index, symbol_index)
                    } else {
                        const previous = relocatable.symbolAt(objectAt(linker, known.0), known.1)
                        if previous.*.binding == relocatable.WEAK && symbol.*.binding == relocatable.GLOBAL {
                            // The strong definition replaces the weak one.
                            var probe = symbol.*.nameHash % capacity
                            while !(linker.*.tableObjects[probe] == known.0 && linker.*.tableSymbols[probe] == known.1) { probe = (probe + 1) % capacity }
                            linker.*.tableObjects[probe] = index
                            linker.*.tableSymbols[probe] = symbol_index
                        } else if previous.*.binding == relocatable.GLOBAL && symbol.*.binding == relocatable.GLOBAL {
                            return fail(linker, "multiple definition of", symbol.*.namePointer, symbol.*.nameLength)
                        }
                    }
                }
                symbol_index += 1
            }
        }
        index += 1
    }
    return true
}

// A table of names (open addressing): each slot an object's index and a
// symbol's, for the first of each name put in.
const NameTable = struct {
    objects: [*]usize
    symbols: [*]usize
    capacity: usize
}

fn nameTable(linker: *Linker, entries: usize, table: *NameTable) -> bool {
    var capacity: usize = 16
    while capacity < entries * 2 + 2 { capacity *= 2 }
    const objects_memory = linker.*.allocator.alloc(capacity * 8, 8)
    const symbols_memory = linker.*.allocator.alloc(capacity * 8, 8)
    if objects_memory == null || symbols_memory == null { return fail(linker, "out of memory", linker.*.errorNamePointer, 0) }
    unsafe {
        table.*.objects = @ptrCast([*]usize, objects_memory.?)
        table.*.symbols = @ptrCast([*]usize, symbols_memory.?)
    }
    table.*.capacity = capacity
    var slot: usize = 0
    while slot < capacity {
        table.*.objects[slot] = NONE
        slot += 1
    }
    return true
}

fn freeNameTable(linker: *Linker, table: *NameTable) -> void {
    unsafe {
        linker.*.allocator.free(@ptrCast([*]u8, table.*.objects), table.*.capacity * 8, 8)
        linker.*.allocator.free(@ptrCast([*]u8, table.*.symbols), table.*.capacity * 8, 8)
    }
}

// Where SYMBOL's name is in TABLE, or the free slot it would take.
fn nameSlot(linker: *Linker, table: *NameTable, symbol: *relocatable.Symbol) -> usize {
    var slot = symbol.*.nameHash % table.*.capacity
    while table.*.objects[slot] != NONE {
        const known = relocatable.symbolAt(objectAt(linker, table.*.objects[slot]), table.*.symbols[slot])
        if sameName(known, symbol.*.namePointer, symbol.*.nameLength, symbol.*.nameHash) { return slot }
        slot = (slot + 1) % table.*.capacity
    }
    return slot
}

// The defined global symbols of OBJECT put in TABLE (the first of a name
// stays).
fn addDefinitions(linker: *Linker, table: *NameTable, object_index: usize) -> void {
    const object = objectAt(linker, object_index)
    var symbol_index: usize = 0
    while symbol_index < relocatable.symbolCount(object) {
        const symbol = relocatable.symbolAt(object, symbol_index)
        if isGlobal(symbol) && relocatable.isDefined(symbol) {
            const slot = nameSlot(linker, table, symbol)
            if table.*.objects[slot] == NONE {
                table.*.objects[slot] = object_index
                table.*.symbols[slot] = symbol_index
            }
        }
        symbol_index += 1
    }
}

// Includes the archive members that define what the included objects
// need, until nothing more is needed: the names the included objects
// define, and those the members define (the first member of a name),
// in two tables; each object included is looked through once.
fn resolve(linker: *Linker) -> bool {
    var total: usize = 0
    var index: usize = 0
    while index < objectCount(linker) {
        total += relocatable.symbolCount(objectAt(linker, index))
        index += 1
    }
    var defined: NameTable = undefined
    var offered: NameTable = undefined
    if !nameTable(linker, total, &defined) || !nameTable(linker, total, &offered) { return false }
    // The objects to look through, in order of their inclusion.
    const queue_memory = linker.*.allocator.alloc(objectCount(linker) * 8 + 8, 8)
    if queue_memory == null { return fail(linker, "out of memory", linker.*.errorNamePointer, 0) }
    var queue: [*]usize = undefined
    unsafe { queue = @ptrCast([*]usize, queue_memory.?) }
    var queued: usize = 0
    index = 0
    while index < objectCount(linker) {
        if objectAt(linker, index).*.included {
            addDefinitions(linker, &defined, index)
            queue[queued] = index
            queued += 1
        } else {
            addDefinitions(linker, &offered, index)
        }
        index += 1
    }
    var next: usize = 0
    while next < queued {
        const object = objectAt(linker, queue[next])
        next += 1
        var symbol_index: usize = 0
        while symbol_index < relocatable.symbolCount(object) {
            const symbol = relocatable.symbolAt(object, symbol_index)
            if isGlobal(symbol) && !relocatable.isDefined(symbol) && symbol.*.binding != relocatable.WEAK {
                if defined.objects[nameSlot(linker, &defined, symbol)] == NONE {
                    const slot = nameSlot(linker, &offered, symbol)
                    const member_index = offered.objects[slot]
                    if member_index != NONE && !objectAt(linker, member_index).*.included {
                        objectAt(linker, member_index).*.included = true
                        addDefinitions(linker, &defined, member_index)
                        queue[queued] = member_index
                        queued += 1
                    }
                }
            }
            symbol_index += 1
        }
    }
    unsafe { linker.*.allocator.free(@ptrCast([*]u8, queue), objectCount(linker) * 8 + 8, 8) }
    freeNameTable(linker, &defined)
    freeNameTable(linker, &offered)
    return buildTable(linker)
}

// What the symbol `symbol_index` of `object` refers to, once the
// sections are placed: a local one in its own object, a global one by
// its definition anywhere, an undefined one an import.
fn resolveSymbol(linker: *Linker, object: *Object, symbol_index: usize) -> Resolved {
    var symbol = relocatable.symbolAt(object, symbol_index)
    var owner = object
    if isGlobal(symbol) {
        const known = tableFind(linker, symbol.*.namePointer, symbol.*.nameLength, symbol.*.nameHash)
        if known.0 != NONE {
            owner = objectAt(linker, known.0)
            symbol = relocatable.symbolAt(owner, known.1)
        }
    }
    var resolved = Resolved.{ .kind = IMPORTED, .value = 0, .namePointer = symbol.*.namePointer, .nameLength = symbol.*.nameLength }
    if symbol.*.section == relocatable.ABSOLUTE {
        resolved.kind = ABSOLUTE
        resolved.value = symbol.*.value
    } else if symbol.*.section != NONE {
        const section = relocatable.sectionAt(owner, symbol.*.section)
        resolved.kind = if section.*.kind == relocatable.TEXT { IN_CODE } else if section.*.kind == relocatable.TDATA { IN_TLS } else { IN_DATA }
        resolved.value = section.*.placed + symbol.*.value
    } else if symbol.*.binding == relocatable.WEAK {
        // An undefined weak symbol is 0.
        resolved.kind = ABSOLUTE
        resolved.value = 0
    }
    return resolved
}

// ---------------------------------------------------------------------------
// Placement and relocation

fn padCode(linker: *Linker, alignment: usize) -> void {
    const enc = linker.*.enc
    var padding = alignment
    if padding < 16 { padding = 16 }
    while encoder_module.pos(enc) % padding != 0 { encoder_module.emit1(enc, 0xCC) }
}

fn emptyName() -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, "") }
}

// Places every included object's sections: the code appended, the data
// and zero data reserved in the data area.
fn place(linker: *Linker) -> void {
    const enc = linker.*.enc
    var index: usize = 0
    while index < objectCount(linker) {
        const object = objectAt(linker, index)
        if object.*.included {
            var section_index: usize = 0
            while section_index < relocatable.sectionCount(object) {
                const section = relocatable.sectionAt(object, section_index)
                if section.*.kind == relocatable.TEXT {
                    padCode(linker, section.*.alignment)
                    section.*.placed = encoder_module.pos(enc)
                    encoder_module.appendBytes(enc, section.*.bytes, section.*.length)
                } else if section.*.kind == relocatable.DATA {
                    section.*.placed = encoder_module.reserveData(enc, emptyName(), 0, if section.*.length == 0 { 1 } else { section.*.length }, section.*.alignment, 0, section.*.bytes, section.*.length, false)
                } else if section.*.kind == relocatable.BSS {
                    section.*.placed = encoder_module.reserveData(enc, emptyName(), 0, if section.*.length == 0 { 1 } else { section.*.length }, section.*.alignment, 0, section.*.bytes, 0, false)
                } else if section.*.kind == relocatable.TDATA {
                    const given = if @intFromPtr(section.*.bytes) == 0 { 0 } else { section.*.length }
                    section.*.placed = encoder_module.reserveTls(enc, section.*.bytes, given, section.*.length, section.*.alignment)
                }
                section_index += 1
            }
        }
        index += 1
    }
}

// The stub of an imported function, made on first use: jmp [rip + GOT].
fn stubOf(linker: *Linker, name: [*]const u8, length: usize) -> usize {
    const hash = relocatable.hashName(name, length)
    var index: usize = 0
    while index < linker.*.stubs.*.length {
        unsafe {
            const stub = @ptrCast(*Stub, vector.Vector.at(linker.*.stubs.*, index))
            if stub.*.nameHash == hash && stub.*.nameLength == length && mem.eql(stub.*.namePointer, name, length) { return stub.*.offset }
        }
        index += 1
    }
    const enc = linker.*.enc
    padCode(linker, 8)
    const offset = encoder_module.pos(enc)
    encoder_module.emit2(enc, 0xFF, 0x25)
    const recorded = encoder_module.importIndex(enc, name, length)
    encoder_module.addFixup(enc, encoder_module.FixupKind.got_rel32, name, length)
    encoder_module.emit2(enc, 0xCC, 0xCC)
    const stub = Stub.{ .namePointer = name, .nameLength = length, .nameHash = hash, .offset = offset }
    unsafe { const appended = vector.Vector.appendAt(linker.*.stubs, @ptrCast([*]const u8, &stub)) }
    return offset
}

fn patch(linker: *Linker, offset: usize, value: i64) -> void {
    encoder_module.patch32(linker.*.enc, offset, @intCast(i32, value))
}

fn dataOffsetOf(value: usize, addend: i64) -> usize {
    return @intCast(usize, @intCast(i64, value) + addend)
}

// A word of the data area that holds the address of `target` at start
// (a GOT-relative reference to a name of the program).
fn localGotWord(linker: *Linker, target: Resolved) -> usize {
    const word = encoder_module.reserveData(linker.*.enc, emptyName(), 0, 8, 8, 0, emptyName(), 0, false)
    const absolute = Absolute.{ .place = word, .target = target, .addend = 0 }
    unsafe { const appended = vector.Vector.appendAt(linker.*.absolutes, @ptrCast([*]const u8, &absolute)) }
    return word
}

fn isRelative(kind: u8) -> bool { return kind == relocatable.R_PC32 || kind == relocatable.R_PLT32 }

fn isGotRelative(kind: u8) -> bool {
    return kind == relocatable.R_GOTPCREL || kind == relocatable.R_GOTPCRELX || kind == relocatable.R_REX_GOTPCRELX
}

// Applies one relocation of a code section placed at `base`.
fn relocateCode(linker: *Linker, object: *Object, relocation: *relocatable.Relocation, base: usize) -> bool {
    const enc = linker.*.enc
    const place = base + relocation.*.offset
    const target = resolveSymbol(linker, object, relocation.*.symbol)
    const addend = relocation.*.addend
    const kind = relocation.*.kind
    if kind == relocatable.R_TPOFF32 {
        // Local exec: the image ends at the thread pointer (variant II,
        // the program's block first).
        if target.kind != IN_TLS { return fail(linker, "a thread-local reference to a name that is not thread-local data of the program", target.namePointer, target.nameLength) }
        const block = relocatable.alignUp(encoder_module.tlsSize(), encoder_module.tlsAlignment())
        patch(linker, place, @intCast(i64, target.value) + addend - @intCast(i64, block))
        return true
    }
    if target.kind == IN_TLS { return fail(linker, "a thread-local variable referred to other than from the thread pointer", target.namePointer, target.nameLength) }
    if isRelative(kind) {
        if target.kind == IN_CODE {
            patch(linker, place, @intCast(i64, target.value) + addend - @intCast(i64, place))
            return true
        }
        if target.kind == IN_DATA {
            encoder_module.addDataFixupAt(enc, place, dataOffsetOf(target.value, addend + 4))
            return true
        }
        if target.kind == ABSOLUTE {
            // Only a value no program needs (an undefined weak symbol).
            if target.value != 0 { return fail(linker, "an absolute symbol cannot be referred to relative to the code", target.namePointer, target.nameLength) }
            patch(linker, place, 0)
            return true
        }
        // An import: a call goes through a stub; `lea r, [rip + name]`
        // (8D) becomes `mov r, [rip + GOT slot]` (8B).
        if addend != -4 { return fail(linker, "an import with an addend", target.namePointer, target.nameLength) }
        const opcode = encoder_module.byteAt(enc, place - 1)
        if opcode == 0xE8 || opcode == 0xE9 {
            const stub = stubOf(linker, target.namePointer, target.nameLength)
            patch(linker, place, @intCast(i64, stub) - @intCast(i64, place + 4))
            return true
        }
        if opcode == 0x8D && place >= 2 && encoder_module.byteAt(enc, place - 2) == 0x05 {
            encoder_module.setByte(enc, place - 2, 0x8B)
        } else if encoder_module.byteAt(enc, place - 2) == 0x8D {
            encoder_module.setByte(enc, place - 2, 0x8B)
        } else {
            return fail(linker, "an import referred to by an instruction other than a call or lea", target.namePointer, target.nameLength)
        }
        const recorded = encoder_module.importIndex(enc, target.namePointer, target.nameLength)
        encoder_module.addFixupAt(enc, encoder_module.FixupKind.got_rel32, place, target.namePointer, target.nameLength)
        return true
    }
    if isGotRelative(kind) {
        if addend != -4 { return fail(linker, "a GOT reference with an addend", target.namePointer, target.nameLength) }
        if target.kind == IMPORTED {
            const recorded = encoder_module.importIndex(enc, target.namePointer, target.nameLength)
            encoder_module.addFixupAt(enc, encoder_module.FixupKind.got_rel32, place, target.namePointer, target.nameLength)
            return true
        }
        const word = localGotWord(linker, target)
        encoder_module.addDataFixupAt(enc, place, word)
        return true
    }
    if kind == relocatable.R_32 || kind == relocatable.R_32S {
        return fail(linker, "an absolute 32-bit address in the code (compile with -fPIE)", target.namePointer, target.nameLength)
    }
    return fail(linker, "a relocation of a kind the linker does not know in the code of", object.*.pathPointer, object.*.pathLength)
}

// Applies one relocation of a data section placed at `base`: an
// address written at start.
fn relocateData(linker: *Linker, object: *Object, relocation: *relocatable.Relocation, base: usize) -> bool {
    if relocation.*.kind != relocatable.R_64 {
        return fail(linker, "a relocation other than an address in the data of", object.*.pathPointer, object.*.pathLength)
    }
    const target = resolveSymbol(linker, object, relocation.*.symbol)
    if target.kind == IN_TLS { return fail(linker, "the address of a thread-local variable in data", target.namePointer, target.nameLength) }
    const absolute = Absolute.{ .place = base + relocation.*.offset, .target = target, .addend = relocation.*.addend }
    unsafe { const appended = vector.Vector.appendAt(linker.*.absolutes, @ptrCast([*]const u8, &absolute)) }
    return true
}

fn relocateInit(linker: *Linker, object: *Object, relocation: *relocatable.Relocation) -> bool {
    if relocation.*.kind != relocatable.R_64 { return fail(linker, "an init_array entry that is not an address in", object.*.pathPointer, object.*.pathLength) }
    const target = resolveSymbol(linker, object, relocation.*.symbol)
    if target.kind != IN_CODE { return fail(linker, "an init_array entry that is not a function of the program in", object.*.pathPointer, object.*.pathLength) }
    const offset = dataOffsetOf(target.value, relocation.*.addend)
    unsafe { const appended = vector.Vector.appendAt(linker.*.inits, @ptrCast([*]const u8, &offset)) }
    return true
}

fn relocate(linker: *Linker) -> bool {
    var index: usize = 0
    while index < objectCount(linker) {
        const object = objectAt(linker, index)
        if object.*.included {
            var relocation_index: usize = 0
            while relocation_index < relocatable.relocationCount(object) {
                const relocation = relocatable.relocationAt(object, relocation_index)
                const section = relocatable.sectionAt(object, relocation.*.section)
                if section.*.kind == relocatable.TEXT {
                    if !relocateCode(linker, object, relocation, section.*.placed) { return false }
                } else if section.*.kind == relocatable.DATA {
                    if !relocateData(linker, object, relocation, section.*.placed) { return false }
                } else if section.*.kind == relocatable.INIT {
                    if !relocateInit(linker, object, relocation) { return false }
                }
                relocation_index += 1
            }
        }
        index += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// The code the linker makes

fn name(text: []const u8) -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, text) }
}

// call rel32 to `code_offset`.
fn callTo(linker: *Linker, code_offset: usize) -> void {
    const enc = linker.*.enc
    encoder_module.emit1(enc, 0xE8)
    const after = encoder_module.pos(enc) + 4
    encoder_module.emitImm32(enc, @intCast(i32, @intCast(i64, code_offset) - @intCast(i64, after)))
}

// rax = the address `target` + `addend` stands for.
fn loadAddress(linker: *Linker, target: Resolved, addend: i64) -> bool {
    const enc = linker.*.enc
    if target.kind == IN_CODE {
        // lea rax, [rip + disp32]
        encoder_module.emit3(enc, 0x48, 0x8D, 0x05)
        const after = encoder_module.pos(enc) + 4
        encoder_module.emitImm32(enc, @intCast(i32, @intCast(i64, target.value) + addend - @intCast(i64, after)))
        return true
    }
    if target.kind == IN_DATA {
        encoder_module.emitLeaData(enc, x86.Register.rax, dataOffsetOf(target.value, addend))
        return true
    }
    if target.kind == ABSOLUTE {
        encoder_module.emitMovRegImm64(enc, x86.Register.rax, @intCast(i64, target.value) + addend)
        return true
    }
    encoder_module.emitImportAddress(enc, x86.Register.rax, target.namePointer, target.nameLength)
    if addend != 0 {
        if addend < -2147483648 || addend > 2147483647 { return fail(linker, "an addend too large", target.namePointer, target.nameLength) }
        encoder_module.emitAluImm(enc, x86.Register.rax, @intCast(i32, addend), 0, 0x05)
    }
    return true
}

// __mlxcc_init: the addresses held by data (and the GOT words of the
// program's own names) written, then the objects' init functions
// called, in order.
fn genInit(linker: *Linker) -> bool {
    const enc = linker.*.enc
    padCode(linker, 16)
    encoder_module.defineSymbol(enc, name("__mlxcc_init"), 12)
    encoder_module.emitPushRbp(enc)
    encoder_module.emitMovRbpRsp(enc)
    var index: usize = 0
    while index < linker.*.absolutes.*.length {
        unsafe {
            const absolute = @ptrCast(*Absolute, vector.Vector.at(linker.*.absolutes.*, index))
            if !loadAddress(linker, absolute.*.target, absolute.*.addend) { return false }
            encoder_module.emitDataStore(enc, absolute.*.place, x86.Register.rax)
        }
        index += 1
    }
    index = 0
    while index < linker.*.inits.*.length {
        unsafe {
            const offset = @ptrCast(*usize, vector.Vector.at(linker.*.inits.*, index)).*
            callTo(linker, offset)
        }
        index += 1
    }
    encoder_module.emitLeave(enc)
    encoder_module.emitRet(enc)
    return true
}

// _start, at the start of the code: the stack aligned, __mlxcc_init,
// main(argc, argv, envp), exit with its result. The initial stack is
// kept in rbx, which the calls preserve.
fn genStart(linker: *Linker) -> void {
    const enc = linker.*.enc
    encoder_module.defineSymbol(enc, name("_start"), 6)
    encoder_module.emitMovRegImm64(enc, x86.Register.rbp, 0)
    encoder_module.emitMovRegReg(enc, x86.Register.rbx, x86.Register.rsp)
    // and rsp, -16
    encoder_module.emit4(enc, 0x48, 0x83, 0xE4, 0xF0)
    encoder_module.emitCallRel(enc, name("__mlxcc_init"), 12)
    // mov rdi, [rbx]; lea rsi, [rbx + 8]; mov rdx, rdi; shl rdx, 3; add rdx, rsi; lea rdx, [rdx + 8]
    encoder_module.emitLoadPointer(enc, x86.Register.rdi, x86.Register.rbx, 8)
    encoder_module.emit4(enc, 0x48, 0x8D, 0x73, 0x08)
    encoder_module.emitMovRegReg(enc, x86.Register.rdx, x86.Register.rdi)
    encoder_module.emit4(enc, 0x48, 0xC1, 0xE2, 0x03)
    encoder_module.emitAdd(enc, x86.Register.rdx, x86.Register.rsi)
    encoder_module.emit4(enc, 0x48, 0x8D, 0x52, 0x08)
    encoder_module.emitMovRegImm64(enc, x86.Register.rax, 0)
    encoder_module.emitCallRel(enc, name("main"), 4)
    encoder_module.emitMovRegReg(enc, x86.Register.rdi, x86.Register.rax)
    encoder_module.emitImportCall(enc, name("exit"), 4, 0)
}

// Links the objects into the encoder: the program's code and data,
// ready for elf64_dynamic. False with the error set.
pub fn link(linker: *Linker) -> bool {
    if !resolve(linker) { return false }
    genStart(linker)
    linker.*.startEnd = encoder_module.pos(linker.*.enc)
    place(linker)
    if !relocate(linker) { return false }
    if !genInit(linker) { return false }
    const main_symbol = tableFind(linker, name("main"), 4, relocatable.hashName(name("main"), 4))
    if main_symbol.0 == NONE { return fail(linker, "the program has no main function", name("main"), 4) }
    const main_resolved = resolveSymbol(linker, objectAt(linker, main_symbol.0), main_symbol.1)
    if main_resolved.kind != IN_CODE { return fail(linker, "main is not a function", name("main"), 4) }
    encoder_module.defineSymbolAt(linker.*.enc, name("main"), 4, main_resolved.value)
    if !encoder_module.applyFixups(linker.*.enc) { return fail(linker, "internal error: a reference of the linker's own code is unresolved", name(""), 0) }
    return true
}

// Links and writes the program to `output`, needing the libraries
// `needed` (NUL-ended names) and starting on `interpreter` (NUL-ended;
// length 0 for the system's).
pub fn writeProgram(linker: *Linker, needed: [*]const [*]const u8, needed_count: usize, interpreter: [*]const u8, interpreter_length: usize, output: [*]const u8) -> bool {
    if !link(linker) { return false }
    var naming = elf64_dynamic.noNaming()
    naming.interpreterPointer = interpreter
    naming.interpreterLength = interpreter_length
    if linker.*.stripped {
        if !elf64_dynamic.writeExecutableNamed(linker.*.allocator, linker.*.enc, needed, needed_count, naming, output) {
            return fail(linker, "cannot write", output, 0)
        }
        return true
    }
    const image = elf64_dynamic.build(linker.*.allocator, linker.*.enc, needed, needed_count, false, naming)
    if !image.valid { return fail(linker, "out of memory writing", output, 0) }
    const shape = elf64_dynamic.layout(linker.*.enc, needed, needed_count, naming)
    var tables: Tables = undefined
    if !buildTables(linker, &tables, elf64.LOAD_VADDR + shape.textOffset, elf64.LOAD_VADDR + shape.mlxDataOffset) { return false }
    const wrote = writeWithTables(linker, image.buffer, image.size, shape.sectionOffset, &tables, output)
    linker.*.allocator.free(image.buffer, image.size, 8)
    freeTables(linker, &tables)
    if !wrote { return fail(linker, "cannot write", output, 0) }
    return true
}

// ---------------------------------------------------------------------------
// The symbol table
//
// The program's .symtab and .strtab, written with it (unless -s): every
// function and variable (STT_FUNC, STT_OBJECT) the objects linked define,
// local and global, with its binding, type and size, at its address in
// the program; a section symbol for .text and one for .data; the linker's
// own code (_start, __mlxcc_init, NAME@plt for each import's stub). The
// locals come first (sh_info is the first global's index). A global is
// the definition the program uses; another object's definition of the
// name (a weak copy of an inline function) is a local of the same name,
// since that object's own calls may still reach its copy. A function its object
// gives no size (mlx-cc's do not) gets the distance to the next function
// of its section. Each name is kept once in .strtab (a table by the
// names' hashes, which the objects' symbols carry already): one pass over
// the objects' symbols, then a sort of the line table.
//
// .mlx_lines, in the form of the Mlx compiler's line table (see
// symbol_table.mlx) but marked MLXFUNCS, comes from the objects' `@at PATH:LINE`
// symbols: mlx-cc marks the start of each function it compiles with one
// (where the function was defined), so the table has an entry at each
// function's start and the crash report (std.crash) says the file and
// line of the function. The hook for a line table of each statement: an
// object would carry more marks (the first instruction of each line),
// and they would come in here the same way.

const STT_OBJECT: u8 = 1
const STT_FUNC: u8 = 2
const STT_SECTION: u8 = 3
const SYMBOL_SIZE: usize = 24
const SECTION_HEADER_SIZE: usize = 64
// elf64_dynamic's sections: .text is the sixth, .data (the data area)
// the ninth.
const TEXT_SECTION: usize = 6
const DATA_SECTION: usize = 9
// A stub: jmp [rip + slot], two int3.
const STUB_SIZE: usize = 8
const MARK_PREFIX_LENGTH: usize = 4
const OFFSET_BITS: usize = 40
const OFFSET_MASK: usize = 1099511627775

pub const Tables = struct {
    // The symbols' records: the null one and the locals from the start,
    // the globals from the end of the room, moved after the locals once
    // all are in.
    symbols: [*]u8
    room: usize
    localCount: usize
    globalCount: usize
    strings: [*]u8
    stringLength: usize
    stringCapacity: usize
    // The names in .strtab: open addressing by hash; a slot holds the
    // hash and the name's offset + 1 (0: free).
    hashes: [*]usize
    offsets: [*]usize
    slots: usize
    // The line table's entries, two words each (the code offset, then
    // file << 32 | line), and the files: their paths (each ended by a
    // NUL), where each starts, and a table by hash (file + 1; 0: free).
    entries: [*]usize
    entryCount: usize
    entryRoom: usize
    paths: [*]u8
    pathLength: usize
    pathCapacity: usize
    fileStarts: [*]usize
    fileCount: usize
    fileHashes: [*]usize
    fileSlots: [*]usize
    fileSlotCount: usize
    // .mlx_lines as written (0 bytes: none).
    lines: [*]u8
    lineLength: usize
    // The starts of the functions of the object being looked through
    // (section << OFFSET_BITS | offset), sorted, for their sizes.
    starts: [*]usize
    startRoom: usize
}

fn words(linker: *Linker, count: usize) -> [*]usize {
    const memory = linker.*.allocator.alloc(count * 8 + 8, 8)
    unsafe {
        if memory == null { return @ptrFromInt([*]usize, 0) }
        return @ptrCast([*]usize, memory.?)
    }
}

fn freeWords(linker: *Linker, memory: [*]usize, count: usize) -> void {
    unsafe { linker.*.allocator.free(@ptrCast([*]u8, memory), count * 8 + 8, 8) }
}

fn powerAbove(count: usize) -> usize {
    var capacity: usize = 16
    while capacity < count * 2 + 2 { capacity *= 2 }
    return capacity
}

// Whether `symbol` is mlx-cc's mark of where a function was defined:
// a local `@at PATH:LINE` (no C or C++ name has a space).
fn isMark(symbol: *relocatable.Symbol) -> bool {
    if symbol.*.binding != relocatable.LOCAL || symbol.*.nameLength <= MARK_PREFIX_LENGTH { return false }
    const text = symbol.*.namePointer
    return text[0] == 64 && text[1] == 97 && text[2] == 116 && text[3] == 32
}

// Heap sort of `count` elements of `stride` words, by their first word.
fn swapElements(list: [*]usize, stride: usize, first: usize, second: usize) -> void {
    var word: usize = 0
    while word < stride {
        const kept = list[first * stride + word]
        list[first * stride + word] = list[second * stride + word]
        list[second * stride + word] = kept
        word += 1
    }
}

fn siftDown(list: [*]usize, stride: usize, start: usize, end: usize) -> void {
    var root = start
    while root * 2 + 1 < end {
        var child = root * 2 + 1
        if child + 1 < end && list[(child + 1) * stride] > list[child * stride] { child += 1 }
        if list[root * stride] >= list[child * stride] { return }
        swapElements(list, stride, root, child)
        root = child
    }
}

fn sortElements(list: [*]usize, count: usize, stride: usize) -> void {
    if count < 2 { return }
    var start = count / 2
    while start > 0 {
        start -= 1
        siftDown(list, stride, start, count)
    }
    var end = count
    while end > 1 {
        end -= 1
        swapElements(list, stride, 0, end)
        siftDown(list, stride, 0, end)
    }
}

fn growStrings(linker: *Linker, t: *Tables, more: usize) -> bool {
    if t.*.stringLength + more <= t.*.stringCapacity { return true }
    var capacity = t.*.stringCapacity * 2
    while capacity < t.*.stringLength + more { capacity *= 2 }
    const memory = linker.*.allocator.alloc(capacity, 8)
    if memory == null { return false }
    mem.copy(memory.?, t.*.strings, t.*.stringLength)
    linker.*.allocator.free(t.*.strings, t.*.stringCapacity, 8)
    t.*.strings = memory.?
    t.*.stringCapacity = capacity
    return true
}

// Appends `length` bytes of `text`, `suffix` and a NUL to .strtab;
// where they start (NONE: out of memory).
fn appendName(linker: *Linker, t: *Tables, text: [*]const u8, length: usize, suffix: []const u8) -> usize {
    if !growStrings(linker, t, length + suffix.length + 1) { return NONE }
    const start = t.*.stringLength
    mem.copy(t.*.strings + start, text, length)
    var index = length
    for byte in suffix {
        t.*.strings[start + index] = byte
        index += 1
    }
    t.*.strings[start + index] = 0
    t.*.stringLength = start + index + 1
    return start
}

// The offset of the name `text` in .strtab, added the first time (NONE:
// out of memory).
fn nameOffset(linker: *Linker, t: *Tables, text: [*]const u8, length: usize, hash: usize) -> usize {
    const mask = t.*.slots - 1
    var slot = hash & mask
    while t.*.offsets[slot] != 0 {
        const known = t.*.offsets[slot] - 1
        if t.*.hashes[slot] == hash && known + length < t.*.stringLength && t.*.strings[known + length] == 0 && mem.eql(t.*.strings + known, text, length) { return known }
        slot = (slot + 1) & mask
    }
    const start = appendName(linker, t, text, length, "")
    if start == NONE { return NONE }
    t.*.hashes[slot] = hash
    t.*.offsets[slot] = start + 1
    return start
}

fn putSymbol(t: *Tables, local: bool, name_offset: usize, info: u8, section: usize, value: usize, size: usize) -> void {
    var index: usize = 0
    if local {
        t.*.localCount += 1
        index = t.*.localCount
    } else {
        t.*.globalCount += 1
        index = t.*.room - t.*.globalCount
    }
    const at = index * SYMBOL_SIZE
    elf.writeU32(t.*.symbols, at, @intCast(u32, name_offset))
    t.*.symbols[at + 4] = info
    t.*.symbols[at + 5] = 0
    elf.writeU16(t.*.symbols, at + 6, @intCast(u16, section))
    elf.writeU64(t.*.symbols, at + 8, @intCast(u64, value))
    elf.writeU64(t.*.symbols, at + 16, @intCast(u64, size))
}

// The line table's entry for a mark `@at PATH:LINE` at `offset` in the
// code. False when out of memory.
fn addMark(linker: *Linker, t: *Tables, symbol: *relocatable.Symbol, offset: usize) -> bool {
    const text = symbol.*.namePointer
    const length = symbol.*.nameLength
    var colon = length
    while colon > MARK_PREFIX_LENGTH && text[colon - 1] != 58 { colon -= 1 }
    if colon <= MARK_PREFIX_LENGTH + 1 { return true }
    var line: usize = 0
    var at = colon
    while at < length {
        if text[at] < 48 || text[at] > 57 { return true }
        line = line * 10 + @intCast(usize, text[at] - 48)
        at += 1
    }
    const path_length = colon - 1 - MARK_PREFIX_LENGTH
    const path = text + MARK_PREFIX_LENGTH
    const hash = relocatable.hashName(path, path_length)
    // The file: known by its path, else added.
    const mask = t.*.fileSlotCount - 1
    var slot = hash & mask
    var file = NONE
    while t.*.fileSlots[slot] != 0 && file == NONE {
        const candidate = t.*.fileSlots[slot] - 1
        const known = t.*.fileStarts[candidate]
        if t.*.fileHashes[slot] == hash && known + path_length < t.*.pathLength && t.*.paths[known + path_length] == 0 && mem.eql(t.*.paths + known, path, path_length) {
            file = candidate
        } else {
            slot = (slot + 1) & mask
        }
    }
    if file == NONE {
        if t.*.pathLength + path_length + 1 > t.*.pathCapacity {
            var capacity = t.*.pathCapacity * 2
            while capacity < t.*.pathLength + path_length + 1 { capacity *= 2 }
            const memory = linker.*.allocator.alloc(capacity, 8)
            if memory == null { return false }
            mem.copy(memory.?, t.*.paths, t.*.pathLength)
            linker.*.allocator.free(t.*.paths, t.*.pathCapacity, 8)
            t.*.paths = memory.?
            t.*.pathCapacity = capacity
        }
        file = t.*.fileCount
        t.*.fileStarts[file] = t.*.pathLength
        mem.copy(t.*.paths + t.*.pathLength, path, path_length)
        t.*.paths[t.*.pathLength + path_length] = 0
        t.*.pathLength += path_length + 1
        t.*.fileCount += 1
        t.*.fileHashes[slot] = hash
        t.*.fileSlots[slot] = file + 1
    }
    t.*.entries[t.*.entryCount * 2] = offset
    t.*.entries[t.*.entryCount * 2 + 1] = (file << 32) | (line & 4294967295)
    t.*.entryCount += 1
    return true
}

// The first function start after `key` (NONE: none) of the `count`
// sorted ones.
fn startAfter(starts: [*]usize, count: usize, key: usize) -> usize {
    var low: usize = 0
    var high = count
    while low < high {
        const middle = (low + high) / 2
        if starts[middle] <= key { low = middle + 1 } else { high = middle }
    }
    return if low < count { starts[low] } else { NONE }
}

fn outOfMemory(linker: *Linker) -> bool { return fail(linker, "out of memory for the symbol table", name(""), 0) }

// Builds the tables of the program the linker made, its code at
// `text_base` and its data area at `data_base`. False with the error set.
fn buildTables(linker: *Linker, t: *Tables, text_base: usize, data_base: usize) -> bool {
    const allocator = linker.*.allocator
    // How many symbols can go in, how many marks, the most symbols of an
    // object.
    var defined: usize = 0
    var marks: usize = 0
    var name_bytes: usize = 0
    var largest: usize = 0
    var index: usize = 0
    while index < objectCount(linker) {
        const object = objectAt(linker, index)
        index += 1
        if !object.*.included { continue }
        const count = relocatable.symbolCount(object)
        if count > largest { largest = count }
        var s: usize = 0
        while s < count {
            const symbol = relocatable.symbolAt(object, s)
            s += 1
            if symbol.*.section == NONE || symbol.*.section == relocatable.ABSOLUTE { continue }
            if isMark(symbol) {
                marks += 1
            } else {
                defined += 1
                name_bytes += symbol.*.nameLength + 1
            }
        }
    }
    const stubs = linker.*.stubs.*.length
    // The null symbol, two section symbols, _start and __mlxcc_init.
    t.*.room = defined + stubs + 5
    t.*.localCount = 0
    t.*.globalCount = 0
    // (Room for every name once: .strtab does not grow but for the
    // stubs' names.)
    t.*.stringCapacity = name_bytes + 65536
    t.*.stringLength = 1
    t.*.slots = powerAbove(defined + 8)
    t.*.entryRoom = marks + 1
    t.*.entryCount = 0
    t.*.pathCapacity = 4096
    t.*.pathLength = 0
    t.*.fileCount = 0
    t.*.fileSlotCount = powerAbove(marks + 1)
    t.*.lineLength = 0
    t.*.startRoom = largest + 1
    const symbols_memory = allocator.alloc(t.*.room * SYMBOL_SIZE, 8)
    const strings_memory = allocator.alloc(t.*.stringCapacity, 8)
    const paths_memory = allocator.alloc(t.*.pathCapacity, 8)
    if symbols_memory == null || strings_memory == null || paths_memory == null { return outOfMemory(linker) }
    t.*.symbols = symbols_memory.?
    t.*.strings = strings_memory.?
    t.*.paths = paths_memory.?
    t.*.hashes = words(linker, t.*.slots)
    t.*.offsets = words(linker, t.*.slots)
    t.*.entries = words(linker, t.*.entryRoom * 2)
    t.*.fileStarts = words(linker, t.*.entryRoom)
    t.*.fileHashes = words(linker, t.*.fileSlotCount)
    t.*.fileSlots = words(linker, t.*.fileSlotCount)
    t.*.starts = words(linker, t.*.startRoom)
    if @intFromPtr(t.*.hashes) == 0 || @intFromPtr(t.*.offsets) == 0 || @intFromPtr(t.*.entries) == 0 || @intFromPtr(t.*.fileStarts) == 0 || @intFromPtr(t.*.fileHashes) == 0 || @intFromPtr(t.*.fileSlots) == 0 || @intFromPtr(t.*.starts) == 0 { return outOfMemory(linker) }
    mem.zero(t.*.symbols, SYMBOL_SIZE)
    t.*.strings[0] = 0
    var slot: usize = 0
    while slot < t.*.slots {
        t.*.offsets[slot] = 0
        slot += 1
    }
    slot = 0
    while slot < t.*.fileSlotCount {
        t.*.fileSlots[slot] = 0
        slot += 1
    }
    // The sections, then the linker's own code.
    putSymbol(t, true, 0, STT_SECTION, TEXT_SECTION, text_base, 0)
    putSymbol(t, true, 0, STT_SECTION, DATA_SECTION, data_base, 0)
    const code_length = encoder_module.pos(linker.*.enc)
    const start_name = nameOffset(linker, t, name("_start"), 6, relocatable.hashName(name("_start"), 6))
    if start_name == NONE { return outOfMemory(linker) }
    putSymbol(t, false, start_name, (relocatable.GLOBAL << 4) | STT_FUNC, TEXT_SECTION, text_base, linker.*.startEnd)
    const init = encoder_module.findSymbol(linker.*.enc, name("__mlxcc_init"), 12)
    if init.0 {
        const init_name = nameOffset(linker, t, name("__mlxcc_init"), 12, relocatable.hashName(name("__mlxcc_init"), 12))
        if init_name == NONE { return outOfMemory(linker) }
        putSymbol(t, true, init_name, STT_FUNC, TEXT_SECTION, text_base + init.1, code_length - init.1)
    }
    index = 0
    while index < stubs {
        unsafe {
            const stub = @ptrCast(*Stub, vector.Vector.at(linker.*.stubs.*, index))
            const stub_name = appendName(linker, t, stub.*.namePointer, stub.*.nameLength, "@plt")
            if stub_name == NONE { return outOfMemory(linker) }
            putSymbol(t, true, stub_name, STT_FUNC, TEXT_SECTION, text_base + stub.*.offset, STUB_SIZE)
        }
        index += 1
    }
    // The objects' functions and variables, and the marks.
    index = 0
    while index < objectCount(linker) {
        const object = objectAt(linker, index)
        const object_index = index
        index += 1
        if !object.*.included { continue }
        const count = relocatable.symbolCount(object)
        // Where its functions start, for the sizes it does not give.
        var starts: usize = 0
        var s: usize = 0
        while s < count {
            const symbol = relocatable.symbolAt(object, s)
            s += 1
            if symbol.*.section == NONE || symbol.*.section == relocatable.ABSOLUTE { continue }
            if symbol.*.kind != STT_FUNC && !isMark(symbol) { continue }
            if relocatable.sectionAt(object, symbol.*.section).*.kind != relocatable.TEXT { continue }
            t.*.starts[starts] = (symbol.*.section << OFFSET_BITS) | symbol.*.value
            starts += 1
        }
        sortElements(t.*.starts, starts, 1)
        s = 0
        while s < count {
            const symbol_index = s
            const symbol = relocatable.symbolAt(object, s)
            s += 1
            if symbol.*.section == NONE || symbol.*.section == relocatable.ABSOLUTE || symbol.*.nameLength == 0 { continue }
            const section = relocatable.sectionAt(object, symbol.*.section)
            if isMark(symbol) {
                if section.*.kind == relocatable.TEXT && !addMark(linker, t, symbol, section.*.placed + symbol.*.value) { return outOfMemory(linker) }
                continue
            }
            if symbol.*.kind != STT_FUNC && symbol.*.kind != STT_OBJECT { continue }
            var shndx: usize = 0
            var address: usize = 0
            if section.*.kind == relocatable.TEXT {
                shndx = TEXT_SECTION
                address = text_base + section.*.placed + symbol.*.value
            } else if section.*.kind == relocatable.DATA || section.*.kind == relocatable.BSS {
                shndx = DATA_SECTION
                address = data_base + section.*.placed + symbol.*.value
            } else {
                continue
            }
            var global = isGlobal(symbol)
            var binding = symbol.*.binding
            if global {
                // The definition the program uses is the global; another
                // object's of the same name (an inline function's copy a
                // weak definition elsewhere replaced) is still called by
                // its own object's code: a local of that name.
                const known = tableFind(linker, symbol.*.namePointer, symbol.*.nameLength, symbol.*.nameHash)
                if known.0 != object_index || known.1 != symbol_index {
                    global = false
                    binding = relocatable.LOCAL
                }
            }
            var size = symbol.*.size
            if size == 0 && symbol.*.kind == STT_FUNC && section.*.kind == relocatable.TEXT {
                const next = startAfter(t.*.starts, starts, (symbol.*.section << OFFSET_BITS) | symbol.*.value)
                if next != NONE && next >> OFFSET_BITS == symbol.*.section {
                    size = (next & OFFSET_MASK) - symbol.*.value
                } else if section.*.length > symbol.*.value {
                    size = section.*.length - symbol.*.value
                }
            }
            const name_offset = nameOffset(linker, t, symbol.*.namePointer, symbol.*.nameLength, symbol.*.nameHash)
            if name_offset == NONE { return outOfMemory(linker) }
            putSymbol(t, !global, name_offset, (binding << 4) | symbol.*.kind, shndx, address, size)
        }
    }
    // The globals after the locals.
    const first_global = t.*.localCount + 1
    if t.*.globalCount > 0 && first_global < t.*.room - t.*.globalCount {
        mem.copy(t.*.symbols + first_global * SYMBOL_SIZE, t.*.symbols + (t.*.room - t.*.globalCount) * SYMBOL_SIZE, t.*.globalCount * SYMBOL_SIZE)
    }
    // The line table: the entries by offset, then the files' paths.
    if t.*.entryCount > 0 {
        sortElements(t.*.entries, t.*.entryCount, 2)
        t.*.lineLength = 16 + t.*.entryCount * 12 + t.*.pathLength
        const memory = allocator.alloc(t.*.lineLength, 8)
        if memory == null { return outOfMemory(linker) }
        t.*.lines = memory.?
        var magic_index: usize = 0
        // (MLXFUNCS: the entries are where functions start and the line
        // each was defined on; the Mlx compiler's MLXLINES has every
        // line's.)
        for byte in "MLXFUNCS" {
            t.*.lines[magic_index] = byte
            magic_index += 1
        }
        elf.writeU32(t.*.lines, 8, @intCast(u32, t.*.entryCount))
        elf.writeU32(t.*.lines, 12, @intCast(u32, t.*.fileCount))
        var entry: usize = 0
        while entry < t.*.entryCount {
            const at = 16 + entry * 12
            elf.writeU32(t.*.lines, at, @intCast(u32, t.*.entries[entry * 2] & 4294967295))
            elf.writeU32(t.*.lines, at + 4, @intCast(u32, t.*.entries[entry * 2 + 1] >> 32))
            elf.writeU32(t.*.lines, at + 8, @intCast(u32, t.*.entries[entry * 2 + 1] & 4294967295))
            entry += 1
        }
        mem.copy(t.*.lines + 16 + t.*.entryCount * 12, t.*.paths, t.*.pathLength)
    }
    return true
}

fn freeTables(linker: *Linker, t: *Tables) -> void {
    const allocator = linker.*.allocator
    allocator.free(t.*.symbols, t.*.room * SYMBOL_SIZE, 8)
    allocator.free(t.*.strings, t.*.stringCapacity, 8)
    allocator.free(t.*.paths, t.*.pathCapacity, 8)
    if t.*.lineLength > 0 { allocator.free(t.*.lines, t.*.lineLength, 8) }
    freeWords(linker, t.*.hashes, t.*.slots)
    freeWords(linker, t.*.offsets, t.*.slots)
    freeWords(linker, t.*.entries, t.*.entryRoom * 2)
    freeWords(linker, t.*.fileStarts, t.*.entryRoom)
    freeWords(linker, t.*.fileHashes, t.*.fileSlotCount)
    freeWords(linker, t.*.fileSlots, t.*.fileSlotCount)
    freeWords(linker, t.*.starts, t.*.startRoom)
}

fn writePadding(file: fs.File, count: usize) -> bool {
    var zeros: [8]u8 = [8]u8{ 0, 0, 0, 0, 0, 0, 0, 0 }
    const zero_bytes: [*]const u8 = &zeros
    return count == 0 || fs.writeAllBytes(file, zero_bytes, count)
}

fn read64(bytes: [*]const u8, at: usize) -> usize {
    var value: usize = 0
    var index: usize = 8
    while index > 0 {
        index -= 1
        value = (value << 8) | @intCast(usize, bytes[at + index])
    }
    return value
}

// Writes the image elf64_dynamic built (its section headers last, from
// `section_offset`) with the tables after it: a .shstrtab that names them
// too, .symtab, .strtab, .mlx_lines (when it has entries), then the
// section headers. The image's own .shstrtab stays where it was, unused.
fn writeWithTables(linker: *Linker, image: [*]u8, size: usize, section_offset: usize, t: *Tables, output: [*]const u8) -> bool {
    const section_count = (size - section_offset) / SECTION_HEADER_SIZE
    const names_index = @intCast(usize, image[62]) | (@intCast(usize, image[63]) << 8)
    const names_header = section_offset + names_index * SECTION_HEADER_SIZE
    const names_offset = read64(image, names_header + 24)
    const names_size = read64(image, names_header + 32)
    const added = ".symtab|.strtab|.mlx_lines|"
    const with_lines = t.*.lineLength > 0
    const new_count = section_count + (if with_lines { 3 } else { 2 })
    const symbol_count = t.*.localCount + t.*.globalCount + 1
    // Where everything goes.
    const names_at = section_offset
    const new_names_size = names_size + added.length
    const symbols_at = elf64.alignUp(names_at + new_names_size, 8)
    const symbols_size = symbol_count * SYMBOL_SIZE
    const strings_at = symbols_at + symbols_size
    const lines_at = elf64.alignUp(strings_at + t.*.stringLength, 8)
    const lines_end = if with_lines { lines_at + t.*.lineLength } else { strings_at + t.*.stringLength }
    const headers_at = elf64.alignUp(lines_end, 8)
    // The new .shstrtab and the section headers.
    const tail_size = new_names_size + new_count * SECTION_HEADER_SIZE
    const memory = linker.*.allocator.alloc(tail_size, 8)
    if memory == null { return false }
    const tail = memory.?
    mem.copy(tail, image + names_offset, names_size)
    var at = names_size
    for byte in added {
        tail[at] = if byte == 124 { 0 } else { byte }
        at += 1
    }
    const headers = tail + new_names_size
    mem.copy(headers, image + section_offset, section_count * SECTION_HEADER_SIZE)
    mem.zero(headers + section_count * SECTION_HEADER_SIZE, (new_count - section_count) * SECTION_HEADER_SIZE)
    elf.writeU64(headers, names_index * SECTION_HEADER_SIZE + 24, @intCast(u64, names_at))
    elf.writeU64(headers, names_index * SECTION_HEADER_SIZE + 32, @intCast(u64, new_names_size))
    // .symtab: linked to .strtab, sh_info the first global.
    var header = section_count * SECTION_HEADER_SIZE
    elf.writeU32(headers, header, @intCast(u32, names_size))
    elf.writeU32(headers, header + 4, 2)
    elf.writeU64(headers, header + 24, @intCast(u64, symbols_at))
    elf.writeU64(headers, header + 32, @intCast(u64, symbols_size))
    elf.writeU32(headers, header + 40, @intCast(u32, section_count + 1))
    elf.writeU32(headers, header + 44, @intCast(u32, t.*.localCount + 1))
    elf.writeU64(headers, header + 48, 8)
    elf.writeU64(headers, header + 56, @intCast(u64, SYMBOL_SIZE))
    header += SECTION_HEADER_SIZE
    elf.writeU32(headers, header, @intCast(u32, names_size + 8))
    elf.writeU32(headers, header + 4, 3)
    elf.writeU64(headers, header + 24, @intCast(u64, strings_at))
    elf.writeU64(headers, header + 32, @intCast(u64, t.*.stringLength))
    elf.writeU64(headers, header + 48, 1)
    if with_lines {
        header += SECTION_HEADER_SIZE
        elf.writeU32(headers, header, @intCast(u32, names_size + 16))
        elf.writeU32(headers, header + 4, 1)
        elf.writeU64(headers, header + 24, @intCast(u64, lines_at))
        elf.writeU64(headers, header + 32, @intCast(u64, t.*.lineLength))
        elf.writeU64(headers, header + 48, 4)
    }
    // The ELF header: where the section headers are now, and how many.
    elf.writeU64(image, 40, @intCast(u64, headers_at))
    elf.writeU16(image, 60, @intCast(u16, new_count))
    const file = fs.open(output, fs.WRITE_ONLY | fs.CREATE | fs.TRUNCATE, 493)
    var wrote = fs.isValid(file)
    if wrote {
        wrote = fs.writeAllBytes(file, image, section_offset)
        wrote = wrote && fs.writeAllBytes(file, tail, new_names_size)
        wrote = wrote && writePadding(file, symbols_at - names_at - new_names_size)
        wrote = wrote && fs.writeAllBytes(file, t.*.symbols, symbols_size)
        wrote = wrote && fs.writeAllBytes(file, t.*.strings, t.*.stringLength)
        if with_lines {
            wrote = wrote && writePadding(file, lines_at - strings_at - t.*.stringLength)
            wrote = wrote && fs.writeAllBytes(file, t.*.lines, t.*.lineLength)
        }
        wrote = wrote && writePadding(file, headers_at - lines_end)
        wrote = wrote && fs.writeAllBytes(file, headers, new_count * SECTION_HEADER_SIZE)
        wrote = fs.close(file) && wrote
        wrote = wrote && fs.chmod(output, 493)
    }
    linker.*.allocator.free(tail, tail_size, 8)
    return wrote
}
