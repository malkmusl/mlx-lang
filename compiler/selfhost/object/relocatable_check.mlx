// A check of relocatable.mlx and archive.mlx (tools/check_link.sh): an
// object with code, data, zero data, symbols and relocations written to
// t.o and read back, an archive of it twice (one member with a long
// name) written to t.a and read back; what was read is printed.
const std = @import("std")
const page_allocator = @import("../../../std/bootstrap/page_allocator.mlx")
const relocatable = @import("./relocatable.mlx")
const archive = @import("./archive.mlx")
const source = @import("../source.mlx")

fn text(s: []const u8) -> [*]const u8 { unsafe { return @ptrCast([*]const u8, s) } }
fn bytesOf(p: anytype) -> [*]const u8 { unsafe { return @ptrCast([*]const u8, p) } }
fn membersOf(p: *[2]archive.Member) -> [*]const archive.Member { unsafe { return @ptrCast([*]const archive.Member, p) } }

pub fn main() -> u8 {
    const allocator = page_allocator.init()
    var object: relocatable.Object = undefined
    relocatable.initAt(&object, allocator, text("t.o"), 3)
    const code: [8]u8 = [8]u8{ 0xe8, 0, 0, 0, 0, 0x48, 0x8d, 0x05 }
    const data: [16]u8 = [16]u8{ 1, 2, 3, 4, 5, 6, 7, 8, 0, 0, 0, 0, 0, 0, 0, 0 }
    const t = relocatable.addSection(&object, relocatable.TEXT, bytesOf(&code), 8, 16)
    const d = relocatable.addSection(&object, relocatable.DATA, bytesOf(&data), 16, 8)
    const b = relocatable.addSection(&object, relocatable.BSS, text(""), 32, 8)
    const f = relocatable.addSymbol(&object, text("f"), 1, relocatable.GLOBAL, relocatable.FUNC, t, 0, 8)
    const g = relocatable.addSymbol(&object, text("counter"), 7, relocatable.LOCAL, relocatable.OBJECT, b, 0, 32)
    const u = relocatable.addSymbol(&object, text("puts"), 4, relocatable.GLOBAL, relocatable.NOTYPE, relocatable.NONE, 0, 0)
    const s = relocatable.addSymbol(&object, text(""), 0, relocatable.LOCAL, relocatable.SECTION, d, 0, 0)
    relocatable.addRelocation(&object, t, 1, relocatable.R_PLT32, u, -4)
    relocatable.addRelocation(&object, d, 8, relocatable.R_64, f, 0)
    relocatable.addRelocation(&object, t, 4, relocatable.R_PC32, s, 4)
    if !relocatable.write(&object, text("t.o")) { return 2 }
    const file = source.load(allocator, text("t.o"), 3)
    if !file.valid { return 3 }
    var back: relocatable.Object = undefined
    relocatable.initAt(&back, allocator, text("t.o"), 3)
    if !relocatable.read(&back, file.bytes, file.length) { return 4 }
    const p1 = std.io.printFmt("sections {} symbols {} relocations {}\n", .{relocatable.sectionCount(&back), relocatable.symbolCount(&back), relocatable.relocationCount(&back)})
    var i: usize = 0
    while i < relocatable.symbolCount(&back) {
        const sym = relocatable.symbolAt(&back, i)
        const p2 = std.io.printFmt("symbol {} bind {} kind {} section {} value {} size {}\n", .{sym.*.namePointer[0..sym.*.nameLength], sym.*.binding, sym.*.kind, sym.*.section, sym.*.value, sym.*.size})
        i += 1
    }
    i = 0
    while i < relocatable.relocationCount(&back) {
        const r = relocatable.relocationAt(&back, i)
        const p3 = std.io.printFmt("reloc section {} offset {} kind {} symbol {} addend {}\n", .{r.*.section, r.*.offset, r.*.kind, r.*.symbol, r.*.addend})
        i += 1
    }
    // An archive of the object twice, read back.
    var members: [2]archive.Member = undefined
    members[0] = archive.Member.{ .namePointer = text("first.o"), .nameLength = 7, .bytes = file.bytes, .length = file.length }
    members[1] = archive.Member.{ .namePointer = text("a_very_long_member_name.o"), .nameLength = 25, .bytes = file.bytes, .length = file.length }
    if !archive.write(allocator, text("t.a"), membersOf(&members), 2) { return 5 }
    const lib = source.load(allocator, text("t.a"), 3)
    if !archive.isArchive(lib.bytes, lib.length) { return 6 }
    var r = archive.reader(lib.bytes, lib.length)
    var m: archive.Member = undefined
    while archive.next(&r, &m) {
        const p4 = std.io.printFmt("member {} {} bytes object {}\n", .{m.namePointer[0..m.nameLength], m.length, relocatable.isObject(m.bytes, m.length)})
    }
    return 0
}
