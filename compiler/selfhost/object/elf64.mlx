const mem = @import("../../../std/bootstrap/mem.mlx")
const fs = @import("../../../std/bootstrap/fs.mlx")
const elf = @import("../../../std/bootstrap/elf.mlx")
const allocator_mod = @import("../../../std/bootstrap/allocator.mlx")

pub const Allocator = allocator_mod.Allocator

pub const LOAD_VADDR: usize = 4194304
pub const TEXT_FILE_OFFSET: usize = 4096
pub const TEXT_VADDR: usize = LOAD_VADDR + TEXT_FILE_OFFSET
pub const PAGE_SIZE: usize = 4096

pub const BuildResult = struct {
    valid: bool
    buffer: [*]u8
    size: usize
}

pub fn alignUp(value: usize, alignment: usize) -> usize {
    return (value + alignment - 1) & ~(alignment - 1)
}

pub fn buildExecutable(
    allocator: Allocator,
    code: [*]const u8,
    code_length: usize,
    entry_offset: usize,
    rodata: [*]const u8,
    rodata_length: usize,
) -> BuildResult {
    const has_rodata = rodata_length > 0
    const text_name_off: u32 = 1
    const rodata_name_off: u32 = 7
    const shstrtab_name_off: u32 = 15
    const shstrtab_size: usize = 25

    const text_off: usize = TEXT_FILE_OFFSET
    const rodata_file_off: usize = alignUp(text_off + code_length, PAGE_SIZE)
    const rodata_file_end: usize = if has_rodata { rodata_file_off + rodata_length } else { text_off + code_length }
    const shstrtab_off: usize = alignUp(rodata_file_end, 8)
    const shdr_off: usize = alignUp(shstrtab_off + shstrtab_size, 8)

    const num_phdrs: u16 = if has_rodata { 2 } else { 1 }
    const num_shdrs: u16 = if has_rodata { 4 } else { 3 }
    const shstrndx: u16 = if has_rodata { 3 } else { 2 }

    const total_size: usize = shdr_off + @intCast(usize, num_shdrs) * 64

    const buffer_opt = allocator_mod.alloc(allocator, total_size, 8)
    if buffer_opt == null {
        unsafe { return BuildResult.{ .valid = false, .buffer = @ptrFromInt([*]u8, 0), .size = 0 } }
    }
    const buffer = buffer_opt.?

    mem.zero(buffer, total_size)

    // Write ELF header
    buffer[0] = 127
    buffer[1] = 69
    buffer[2] = 76
    buffer[3] = 70
    buffer[4] = 2
    buffer[5] = 1
    buffer[6] = 1
    buffer[7] = 0 // OSABI
    buffer[8] = 0 // ABIVersion
    // padding 9..15

    elf.writeU16(buffer, 16, 2) // e_type = ET_EXEC
    elf.writeU16(buffer, 18, 62) // e_machine = EM_X86_64
    elf.writeU32(buffer, 20, 1) // e_version = 1
    elf.writeU64(buffer, 24, @intCast(u64, TEXT_VADDR + entry_offset)) // e_entry
    elf.writeU64(buffer, 32, 64) // e_phoff = 64
    elf.writeU64(buffer, 40, @intCast(u64, shdr_off)) // e_shoff
    elf.writeU32(buffer, 48, 0) // e_flags
    elf.writeU16(buffer, 52, 64) // e_ehsize
    elf.writeU16(buffer, 54, 56) // e_phentsize
    elf.writeU16(buffer, 56, num_phdrs) // e_phnum
    elf.writeU16(buffer, 58, 64) // e_shentsize
    elf.writeU16(buffer, 60, num_shdrs) // e_shnum
    elf.writeU16(buffer, 62, shstrndx) // e_shstrndx

    // Write Program header for .text (RX)
    var phdr_off: usize = 64
    elf.writeU32(buffer, phdr_off + 0, 1) // p_type = PT_LOAD
    elf.writeU32(buffer, phdr_off + 4, 5) // p_flags = PF_R | PF_X
    elf.writeU64(buffer, phdr_off + 8, 0) // p_offset
    elf.writeU64(buffer, phdr_off + 16, @intCast(u64, LOAD_VADDR)) // p_vaddr
    elf.writeU64(buffer, phdr_off + 24, @intCast(u64, LOAD_VADDR)) // p_paddr
    elf.writeU64(buffer, phdr_off + 32, @intCast(u64, text_off + code_length)) // p_filesz
    elf.writeU64(buffer, phdr_off + 40, @intCast(u64, text_off + code_length)) // p_memsz
    elf.writeU64(buffer, phdr_off + 48, @intCast(u64, PAGE_SIZE)) // p_align

    // Write Program header for .rodata (RO)
    if has_rodata {
        phdr_off += 56
        const rodata_vaddr = TEXT_VADDR + (rodata_file_off - text_off)
        elf.writeU32(buffer, phdr_off + 0, 1) // p_type = PT_LOAD
        elf.writeU32(buffer, phdr_off + 4, 4) // p_flags = PF_R
        elf.writeU64(buffer, phdr_off + 8, @intCast(u64, rodata_file_off)) // p_offset
        elf.writeU64(buffer, phdr_off + 16, @intCast(u64, rodata_vaddr)) // p_vaddr
        elf.writeU64(buffer, phdr_off + 24, @intCast(u64, rodata_vaddr)) // p_paddr
        elf.writeU64(buffer, phdr_off + 32, @intCast(u64, rodata_length)) // p_filesz
        elf.writeU64(buffer, phdr_off + 40, @intCast(u64, rodata_length)) // p_memsz
        elf.writeU64(buffer, phdr_off + 48, @intCast(u64, PAGE_SIZE)) // p_align
    }

    // Write .text
    unsafe {
        mem.copy(@ptrFromInt([*]u8, @intFromPtr(buffer) + text_off), code, code_length)
    }

    // Write .rodata
    if has_rodata {
        unsafe {
            mem.copy(@ptrFromInt([*]u8, @intFromPtr(buffer) + rodata_file_off), rodata, rodata_length)
        }
    }

    // Write .shstrtab "\0.text\0.rodata\0.shstrtab\0"
    buffer[shstrtab_off + 0] = 0
    buffer[shstrtab_off + 1] = 46
    buffer[shstrtab_off + 2] = 116
    buffer[shstrtab_off + 3] = 101
    buffer[shstrtab_off + 4] = 120
    buffer[shstrtab_off + 5] = 116
    buffer[shstrtab_off + 6] = 0
    buffer[shstrtab_off + 7] = 46
    buffer[shstrtab_off + 8] = 114
    buffer[shstrtab_off + 9] = 111
    buffer[shstrtab_off + 10] = 100
    buffer[shstrtab_off + 11] = 97
    buffer[shstrtab_off + 12] = 116
    buffer[shstrtab_off + 13] = 97
    buffer[shstrtab_off + 14] = 0
    buffer[shstrtab_off + 15] = 46
    buffer[shstrtab_off + 16] = 115
    buffer[shstrtab_off + 17] = 104
    buffer[shstrtab_off + 18] = 115
    buffer[shstrtab_off + 19] = 116
    buffer[shstrtab_off + 20] = 114
    buffer[shstrtab_off + 21] = 116
    buffer[shstrtab_off + 22] = 97
    buffer[shstrtab_off + 23] = 98
    buffer[shstrtab_off + 24] = 0

    // Write Section headers
    // 0. NULL
    var sh_off = shdr_off
    elf.writeU32(buffer, sh_off + 0, 0)
    elf.writeU32(buffer, sh_off + 4, 0)
    elf.writeU64(buffer, sh_off + 8, 0)
    elf.writeU64(buffer, sh_off + 16, 0)
    elf.writeU64(buffer, sh_off + 24, 0)
    elf.writeU64(buffer, sh_off + 32, 0)
    elf.writeU32(buffer, sh_off + 40, 0)
    elf.writeU32(buffer, sh_off + 44, 0)
    elf.writeU64(buffer, sh_off + 48, 0)
    elf.writeU64(buffer, sh_off + 56, 0)
    sh_off += 64

    // 1. .text
    elf.writeU32(buffer, sh_off + 0, text_name_off) // sh_name
    elf.writeU32(buffer, sh_off + 4, 1) // sh_type = SHT_PROGBITS
    elf.writeU64(buffer, sh_off + 8, 6) // sh_flags = SHF_ALLOC | SHF_EXECINSTR
    elf.writeU64(buffer, sh_off + 16, @intCast(u64, TEXT_VADDR)) // sh_addr
    elf.writeU64(buffer, sh_off + 24, @intCast(u64, text_off)) // sh_offset
    elf.writeU64(buffer, sh_off + 32, @intCast(u64, code_length)) // sh_size
    elf.writeU32(buffer, sh_off + 40, 0) // sh_link
    elf.writeU32(buffer, sh_off + 44, 0) // sh_info
    elf.writeU64(buffer, sh_off + 48, 16) // sh_addralign
    elf.writeU64(buffer, sh_off + 56, 0) // sh_entsize
    sh_off += 64

    // 2. .rodata (if present)
    if has_rodata {
        const rodata_vaddr = TEXT_VADDR + (rodata_file_off - text_off)
        elf.writeU32(buffer, sh_off + 0, rodata_name_off) // sh_name
        elf.writeU32(buffer, sh_off + 4, 1) // sh_type = SHT_PROGBITS
        elf.writeU64(buffer, sh_off + 8, 2) // sh_flags = SHF_ALLOC
        elf.writeU64(buffer, sh_off + 16, @intCast(u64, rodata_vaddr)) // sh_addr
        elf.writeU64(buffer, sh_off + 24, @intCast(u64, rodata_file_off)) // sh_offset
        elf.writeU64(buffer, sh_off + 32, @intCast(u64, rodata_length)) // sh_size
        elf.writeU32(buffer, sh_off + 40, 0) // sh_link
        elf.writeU32(buffer, sh_off + 44, 0) // sh_info
        elf.writeU64(buffer, sh_off + 48, 1) // sh_addralign
        elf.writeU64(buffer, sh_off + 56, 0) // sh_entsize
        sh_off += 64
    }

    // Last: .shstrtab
    elf.writeU32(buffer, sh_off + 0, shstrtab_name_off) // sh_name
    elf.writeU32(buffer, sh_off + 4, 3) // sh_type = SHT_STRTAB
    elf.writeU64(buffer, sh_off + 8, 0) // sh_flags
    elf.writeU64(buffer, sh_off + 16, 0) // sh_addr
    elf.writeU64(buffer, sh_off + 24, @intCast(u64, shstrtab_off)) // sh_offset
    elf.writeU64(buffer, sh_off + 32, @intCast(u64, shstrtab_size)) // sh_size
    elf.writeU32(buffer, sh_off + 40, 0) // sh_link
    elf.writeU32(buffer, sh_off + 44, 0) // sh_info
    elf.writeU64(buffer, sh_off + 48, 1) // sh_addralign
    elf.writeU64(buffer, sh_off + 56, 0) // sh_entsize

    return BuildResult.{ .valid = true, .buffer = buffer, .size = total_size }
}

pub fn writeExecutable(
    allocator: Allocator,
    code: [*]const u8,
    code_length: usize,
    entry_offset: usize,
    rodata: [*]const u8,
    rodata_length: usize,
    output_path: [*]const u8,
) -> bool {
    const build_result = buildExecutable(allocator, code, code_length, entry_offset, rodata, rodata_length)
    if !build_result.valid {
        return false
    }
    const buffer = build_result.buffer
    const size = build_result.size

    const file = fs.open(output_path, fs.WRITE_ONLY | fs.CREATE | fs.TRUNCATE, 493) // 0o755 = 493
    if !fs.isValid(file) {
        allocator_mod.free(allocator, buffer, size, 8)
        return false
    }

    var written: usize = 0
    var wrote = true
    while written < size {
        unsafe {
            const source = @ptrFromInt([*]const u8, @intFromPtr(buffer) + written)
            const amount = fs.write(file, source, size - written)
            if amount <= 0 {
                wrote = false
                break
            }
            written += @bitCast(usize, amount)
        }
    }
    const closed = fs.close(file)
    const executable = fs.chmod(output_path, 493)
    
    allocator_mod.free(allocator, buffer, size, 8)
    
    return wrote && closed && executable
}
