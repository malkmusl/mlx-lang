const allocator_module = @import("../../std/bootstrap/allocator.mlx")
const lexer = @import("./lexer.mlx")
const node = @import("./ast/node.mlx")
const store = @import("./ast/store.mlx")
const state = @import("./parser/state.mlx")
const syntax = @import("./parser/syntax.mlx")

pub const Allocator = allocator_module.Allocator
pub const Buffer = lexer.Buffer
pub const Node = node.Node
pub const Tag = node.Tag
pub const Store = store.Store
pub const Parser = state.Parser
pub const NONE = node.NONE

pub fn initStore(allocator: Allocator, capacity: usize) -> Store {
    return store.Store.init(allocator, capacity)
}

pub fn initStoreAt(result: *Store, allocator: Allocator, capacity: usize) -> void {
    store.Store.initAt(result, allocator, capacity)
}

pub fn init(source: []const u8, tokens: Buffer, nodes: *Store) -> Parser {
    return state.Parser.init(source, tokens, nodes)
}

pub fn parse(parser: *Parser) -> usize {
    return syntax.parseSource(parser)
}

pub fn nodeAt(nodes: *Store, index: usize) -> Node {
    return store.Store.get(nodes, index)
}

pub fn deinitStore(nodes: *Store) -> void {
    store.Store.deinit(nodes)
}
