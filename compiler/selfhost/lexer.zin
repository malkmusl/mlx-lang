const scanner = @import("./lexer/scanner.zin")
const buffer = @import("./lexer/buffer.zin")

pub const Kind = scanner.Kind
pub const Token = scanner.Token
pub const Scanner = scanner.Scanner
pub const Buffer = buffer.Buffer
pub const Allocator = buffer.Allocator

pub fn init(source: []const u8) -> Scanner {
    return scanner.init(source)
}

pub fn scanNext(state: *Scanner) -> Token {
    return scanner.next(state)
}

pub fn next(source: []const u8, start: usize) -> Token {
    return scanner.nextFrom(source, start)
}

pub fn count(source: []const u8) -> usize {
    return scanner.count(source)
}

pub fn scanAll(allocator: Allocator, source: []const u8) -> Buffer {
    return buffer.scanAll(allocator, source)
}

pub fn tokenAt(tokens: Buffer, index: usize) -> Token {
    return buffer.get(tokens, index)
}

pub fn deinit(tokens: Buffer) -> void {
    buffer.deinit(tokens)
}
