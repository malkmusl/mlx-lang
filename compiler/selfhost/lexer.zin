const ascii = @import("../../std/bootstrap/ascii.zin")
const token = @import("./token.zin")

pub const Kind = token.Kind
pub const Token = token.Token

pub fn sourceLength(source: []const u8) -> usize {
    var length: usize = 0
    for byte in source {
        length += 1
    }
    return length
}

fn isIdentifierStart(byte: u8) -> bool {
    return ascii.isLower(byte) || ascii.isUpper(byte) || byte == 95
}

fn isIdentifierContinue(byte: u8) -> bool {
    return isIdentifierStart(byte) || ascii.isDigit(byte)
}

pub fn next(source: []const u8, start: usize) -> Token {
    const source_length = sourceLength(source)
    var cursor = start
    while cursor < source_length && (source[cursor] == 32 || source[cursor] == 9 || source[cursor] == 13) {
        cursor += 1
    }
    if cursor >= source_length {
        return token.init(Kind.end_of_file, cursor, 0)
    }

    const first = source[cursor]
    if first == 10 {
        return token.init(Kind.newline, cursor, 1)
    }
    if isIdentifierStart(first) {
        const token_start = cursor
        cursor += 1
        while cursor < source_length && isIdentifierContinue(source[cursor]) {
            cursor += 1
        }
        return token.init(Kind.identifier, token_start, cursor - token_start)
    }
    if ascii.isDigit(first) {
        const token_start = cursor
        cursor += 1
        while cursor < source_length && ascii.isDigit(source[cursor]) {
            cursor += 1
        }
        return token.init(Kind.integer, token_start, cursor - token_start)
    }
    if first == 61 { return token.init(Kind.equal, cursor, 1) }
    if first == 43 { return token.init(Kind.plus, cursor, 1) }
    if first == 45 { return token.init(Kind.minus, cursor, 1) }
    if first == 42 { return token.init(Kind.asterisk, cursor, 1) }
    if first == 47 { return token.init(Kind.slash, cursor, 1) }
    if first == 40 { return token.init(Kind.left_parenthesis, cursor, 1) }
    if first == 41 { return token.init(Kind.right_parenthesis, cursor, 1) }
    if first == 123 { return token.init(Kind.left_brace, cursor, 1) }
    if first == 125 { return token.init(Kind.right_brace, cursor, 1) }
    if first == 44 { return token.init(Kind.comma, cursor, 1) }
    return token.init(Kind.invalid, cursor, 1)
}

pub fn count(source: []const u8) -> usize {
    var cursor: usize = 0
    var token_count: usize = 0
    while true {
        const current = next(source, cursor)
        if current.kind == Kind.end_of_file {
            return token_count
        }
        token_count += 1
        cursor = current.start + current.length
    }
    return token_count
}
