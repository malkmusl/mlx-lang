const allocator_module = @import("../../std/bootstrap/allocator.zin")
const fs = @import("../../std/bootstrap/fs.zin")

pub const Allocator = allocator_module.Allocator
pub const FreeFn = allocator_module.FreeFn

// Flattened during bootstrap so zin0 never needs a nested-aggregate ABI for
// SourceFile. Zin1 can use the same concrete layout directly.
pub const SourceFile = struct {
    pathPointer: [*]const u8
    pathLength: usize
    bytes: [*]u8
    length: usize
    capacity: usize
    allocatorContext: usize
    freeFn: FreeFn
    valid: bool
}

pub fn load(allocator: Allocator, path: [*]const u8, path_length: usize) -> SourceFile {
    const file = fs.open(path, fs.READ_ONLY, 0)
    if !fs.isValid(file) {
        unsafe {
            return SourceFile.{
                .pathPointer = path,
                .pathLength = path_length,
                .bytes = @ptrFromInt([*]u8, 0),
                .length = 0,
                .capacity = 0,
                .allocatorContext = allocator.context,
                .freeFn = allocator.freeFn,
                .valid = false,
            }
        }
    }
    const buffer = fs.readToEndAlloc(file, allocator)
    const closed = fs.close(file)
    return SourceFile.{
        .pathPointer = path,
        .pathLength = path_length,
        .bytes = buffer.items,
        .length = buffer.length,
        .capacity = buffer.capacity,
        .allocatorContext = buffer.allocatorContext,
        .freeFn = buffer.freeFn,
        .valid = closed,
    }
}

pub fn loadInto(result: *SourceFile, allocator: Allocator, path: [*]const u8, path_length: usize) -> void {
    const file = fs.open(path, fs.READ_ONLY, 0)
    result.*.pathPointer = path
    result.*.pathLength = path_length
    result.*.allocatorContext = allocator.context
    result.*.freeFn = allocator.freeFn
    if !fs.isValid(file) {
        unsafe { result.*.bytes = @ptrFromInt([*]u8, 0) }
        result.*.length = 0
        result.*.capacity = 0
        result.*.valid = false
        return
    }
    const buffer = fs.readToEndAlloc(file, allocator)
    result.*.bytes = buffer.items
    result.*.length = buffer.length
    result.*.capacity = buffer.capacity
    result.*.allocatorContext = buffer.allocatorContext
    result.*.freeFn = buffer.freeFn
    result.*.valid = fs.close(file)
}

pub fn contents(file: SourceFile) -> []const u8 {
    unsafe {
        return @ptrCast([*]const u8, file.bytes)[0..file.length]
    }
}

pub fn deinit(file: SourceFile) -> void {
    if file.capacity > 0 {
        file.freeFn(file.allocatorContext, file.bytes, file.capacity, 1)
    }
}
