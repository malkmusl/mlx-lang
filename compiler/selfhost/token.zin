pub const Kind = enum(u8) {
    invalid,
    end_of_file,
    newline,
    identifier,
    integer,
    equal,
    plus,
    minus,
    asterisk,
    slash,
    left_parenthesis,
    right_parenthesis,
    left_brace,
    right_brace,
    comma
}

pub const Token = struct {
    kind: Kind
    start: usize
    length: usize
}

pub fn init(kind: Kind, start: usize, length: usize) -> Token {
    return Token.{
        .kind = kind,
        .start = start,
        .length = length,
    }
}
