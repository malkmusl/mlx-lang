const page_allocator = @import("../../../std/bootstrap/page_allocator.mlx")
const arena_allocator = @import("../../../std/bootstrap/arena_allocator.mlx")
const process = @import("../../../std/bootstrap/process.mlx")
const modules = @import("../modules.mlx")
const types = @import("../types.mlx")
const symbols = @import("../symbols.mlx")
const diagnostic = @import("../diagnostic.mlx")
const lir = @import("../ir/lir.mlx")
const lower = @import("../ir/lower.mlx")
const optimize = @import("../ir/optimize.mlx")
const encoder_module = @import("../backend/x86_64/encoder.mlx")
const codegen_module = @import("../backend/x86_64/codegen.mlx")
const elf64 = @import("../object/elf64.mlx")
const elf64_dynamic = @import("../object/elf64_dynamic.mlx")
const a64_encoder = @import("../backend/aarch64/encoder.mlx")
const a64_codegen = @import("../backend/aarch64/codegen.mlx")
const elf64_aarch64 = @import("../object/elf64_aarch64.mlx")
const array_list = @import("../../../std/bootstrap/array_list.mlx")
const fs = @import("../../../std/bootstrap/fs.mlx")
const android_bytes = @import("../object/android/bytes.mlx")
const apk = @import("../object/android/apk.mlx")
const options_module = @import("./options.mlx")
const reporter_module = @import("./reporter.mlx")

pub const Pipeline = struct {
    pub fn compile(options: options_module.Options) -> u8 {
        unsafe {
            var reporter = reporter_module.Reporter.init(options.compilerNamePointer, options.compilerNameLength, options.showProgress, options.traceEnabled, options_module.Options.stepCount(options))
            if !options.targetValid {
                reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "unknown --target; expected x86_64-linux, aarch64-linux or aarch64-android")
                reporter_module.Reporter.finish(&reporter)
                return 2
            }
            if !Self.androidOptionsValid(&reporter, options) {
                reporter_module.Reporter.finish(&reporter)
                return 2
            }
            Self.tracePaths(&reporter, options)
            const pages = page_allocator.init()
            var arena = arena_allocator.init(pages, 268435456)
            const allocator: arena_allocator.Allocator = arena_allocator.interface(&arena)
            reporter_module.Reporter.progress(&reporter, 1, "load and parse module graph")
            const loader = modules.initLoader(allocator, @ptrCast([*]const u8, "std/src"), 7, null)
            const root = modules.loadRoot(loader, options.inputPointer, options.inputLength)
            if root == modules.NONE || modules.totalErrors(loader) != 0 {
                Self.reportLoadFailure(&reporter, loader)
                const errors = modules.totalErrors(loader)
                reporter_module.Reporter.failActiveStep(&reporter, if errors > 0 { errors } else { 1 })
                modules.deinitLoader(loader)
                Self.finishArena(&reporter, &arena)
                reporter_module.Reporter.finish(&reporter)
                return 4
            }
            Self.traceGraph(&reporter, loader)
            reporter_module.Reporter.metric(&reporter, "modules loaded", modules.moduleCount(loader))
            reporter_module.Reporter.metric(&reporter, "imports discovered", modules.importCount(loader))
            Self.reportFrontendMetrics(&reporter, loader)
            var type_store = types.init(allocator)
            var symbol_store = symbols.initStore(allocator, modules.moduleCount(loader) * 64 + 64)
            var status = Self.analyze(loader, &type_store, &symbol_store, &reporter)
            if status == 0 && options.hasOutput {
                status = Self.emitExecutable(loader, allocator, &type_store, &symbol_store, options, &reporter)
            }
            symbols.deinitStore(&symbol_store)
            types.deinit(&type_store)
            modules.deinitLoader(loader)
            Self.finishArena(&reporter, &arena)
            reporter_module.Reporter.finish(&reporter)
            return status
        }
    }

    // Sema and declaration-prep failures only surface an aggregate error
    // count, but every module already tracks its own errorCount, so the
    // first one with errors is a reasonable file to name in the summary.
    fn pathForFirstError(loader: *modules.Loader) -> []const u8 {
        const id = modules.firstErroringModule(loader)
        if id == modules.NONE { return "" }
        return modules.modulePath(loader, id)
    }

    fn reportLoadFailure(reporter: *reporter_module.Reporter, loader: *modules.Loader) -> void {
        if !modules.hasSyntaxError(loader) {
            reporter_module.Reporter.failureIn(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "module graph could not be loaded", Self.pathForFirstError(loader))
            return
        }
        const failing_module_id = modules.firstSyntaxModule(loader)
        const module = modules.moduleAt(loader, failing_module_id)
        const failing_source = modules.moduleSource(loader, failing_module_id)
        const failing_path = modules.modulePath(loader, failing_module_id)
        unsafe { reporter_module.Reporter.traceString(reporter, "failing module: ", process.String.{ .pointer = @ptrCast([*]const u8, module.*.pathPointer), .length = module.*.pathLength }) }
        reporter_module.Reporter.traceValue(reporter, "first syntax error byte: ", modules.firstSyntaxByte(loader))
        if modules.firstSyntaxIsLexer(loader) {
            reporter_module.Reporter.failureAt(diagnostic.Code.unexpected_byte, diagnostic.Phase.lexer, modules.firstSyntaxByte(loader), modules.firstSyntaxLength(loader), "unexpected byte while scanning module", failing_path, failing_source)
        } else {
            reporter_module.Reporter.failureAt(diagnostic.Code.unexpected_token, diagnostic.Phase.parser, modules.firstSyntaxByte(loader), modules.firstSyntaxLength(loader), "unexpected token while parsing module", failing_path, failing_source)
        }
    }

    fn finishArena(reporter: *reporter_module.Reporter, arena: *arena_allocator.Arena) -> void {
        reporter_module.Reporter.metric(reporter, "compiler arena bytes", arena.*.offset)
        arena_allocator.deinit(arena)
    }

    fn tracePaths(reporter: *reporter_module.Reporter, options: options_module.Options) -> void {
        reporter_module.Reporter.traceString(reporter, "input: ", process.String.{ .pointer = options.inputPointer, .length = options.inputLength })
        if options.hasOutput {
            const output = process.fromCString(options.outputPointer)
            reporter_module.Reporter.traceString(reporter, "output: ", output)
        }
    }

    fn traceGraph(reporter: *reporter_module.Reporter, loader: *modules.Loader) -> void {
        reporter_module.Reporter.traceValue(reporter, "modules: ", modules.moduleCount(loader))
        reporter_module.Reporter.traceValue(reporter, "imports: ", modules.importCount(loader))
        reporter_module.Reporter.traceModules(reporter, loader)
    }

    fn reportFrontendMetrics(reporter: *reporter_module.Reporter, loader: *modules.Loader) -> void {
        reporter_module.Reporter.metric(reporter, "source bytes", modules.sourceByteCount(loader))
        reporter_module.Reporter.metric(reporter, "tokens scanned", modules.tokenCount(loader))
        reporter_module.Reporter.metric(reporter, "AST nodes parsed", modules.nodeCount(loader))
        reporter_module.Reporter.metric(reporter, "declarations discovered", modules.declarationCount(loader))
        reporter_module.Reporter.metric(reporter, "functions discovered", modules.functionCount(loader))
        reporter_module.Reporter.metricDuration(reporter, "source I/O", modules.sourceLoadTime(loader))
        reporter_module.Reporter.metricDuration(reporter, "lexing", modules.lexerTime(loader))
        reporter_module.Reporter.metricDuration(reporter, "parsing", modules.parserTime(loader))
    }

    fn analyze(loader: *modules.Loader, type_store: *types.Store, symbol_store: *symbols.Store, reporter: *reporter_module.Reporter) -> u8 {
        reporter_module.Reporter.progress(reporter, 2, "resolve modules and declarations")
        const prepare_errors = modules.prepare(loader, type_store, symbol_store)
        if prepare_errors != 0 {
            reporter_module.Reporter.failureIn(diagnostic.Code.duplicate_symbol, diagnostic.Phase.resolve, "duplicate declaration", Self.pathForFirstError(loader))
            reporter_module.Reporter.failActiveStep(reporter, prepare_errors)
            return 5
        }
        reporter_module.Reporter.progress(reporter, 3, "analyze declaration types")
        const declaration_errors = modules.analyzeDeclarations(loader, type_store, symbol_store)
        if declaration_errors != 0 {
            reporter_module.Reporter.failureIn(diagnostic.Code.type_mismatch, diagnostic.Phase.sema, "declaration type could not be resolved", Self.pathForFirstError(loader))
            reporter_module.Reporter.failActiveStep(reporter, declaration_errors)
            return 6
        }
        reporter_module.Reporter.traceValue(reporter, "types after declarations: ", types.count(type_store))
        reporter_module.Reporter.metric(reporter, "types resolved", types.count(type_store))
        reporter_module.Reporter.metric(reporter, "symbols registered", symbol_store.*.length)
        reporter_module.Reporter.progress(reporter, 4, "analyze function bodies")
        const function_errors = modules.analyzeFunctionBodies(loader, type_store, symbol_store)
        if function_errors != 0 {
            reporter_module.Reporter.failureIn(diagnostic.Code.type_mismatch, diagnostic.Phase.sema, "function body could not be resolved", Self.pathForFirstError(loader))
            reporter_module.Reporter.failActiveStep(reporter, function_errors)
            return 7
        }
        Self.traceTypeInterning(reporter, type_store)
        Self.traceMethodLookup(reporter, symbol_store)
        return 0
    }

    fn emitExecutable(loader: *modules.Loader, allocator: arena_allocator.Allocator, type_store: *types.Store, symbol_store: *symbols.Store, options: options_module.Options, reporter: *reporter_module.Reporter) -> u8 {
        reporter_module.Reporter.progress(reporter, 5, "lower typed AST to LIR")
        const node_count = modules.nodeCount(loader)
        var ir = lir.initCapacity(allocator, node_count + node_count / 2 + 64, node_count / 2 + 64)
        var builder = lower.init(&ir, type_store, symbol_store, loader, allocator, options.optimizationLevel, options.runtimeSafety)
        reporter_module.Reporter.metric(reporter, "runtime safety checks", if options.runtimeSafety { 1 } else { 0 })
        Self.lowerModules(loader, &builder)
        Self.traceLir(reporter, &builder, &ir)
        Self.traceTypeInterning(reporter, type_store)
        Self.traceMethodLookup(reporter, symbol_store)
        if lower.unsupportedInstructionCount(&builder) != 0 {
            const unsupported = lower.unsupportedInstructionCount(&builder)
            reporter_module.Reporter.metric(reporter, "unsupported executable lowerings", unsupported)
            reporter_module.Reporter.failureAt(
                diagnostic.Code.unsupported_instruction_lowering,
                diagnostic.Phase.codegen,
                lower.firstUnsupportedInstructionOffset(&builder),
                lower.firstUnsupportedInstructionLength(&builder),
                "construct has no specified executable lowering",
                "",
                "",
            )
            reporter_module.Reporter.failActiveStep(reporter, unsupported)
            lower.deinit(&builder)
            lir.deinit(&ir)
            return 10
        }
        reporter_module.Reporter.progress(reporter, 6, "optimize LIR")
        const optimization = optimize.run(&ir, allocator)
        reporter_module.Reporter.metric(reporter, "LIR instructions before optimization", optimization.instructionsBefore)
        reporter_module.Reporter.metric(reporter, "LIR instructions after optimization", optimization.instructionsAfter)
        reporter_module.Reporter.metric(reporter, "constants folded", optimization.constantsFolded)
        reporter_module.Reporter.metric(reporter, "constant branches simplified", optimization.branchesSimplified)
        reporter_module.Reporter.metric(reporter, "comparison branches fused", optimization.comparisonBranchesFused)
        reporter_module.Reporter.metric(reporter, "local loads forwarded", optimization.loadsForwarded)
        reporter_module.Reporter.metric(reporter, "copy operands propagated", optimization.copiesPropagated)
        reporter_module.Reporter.metric(reporter, "local stack slots promoted", optimization.localsPromoted)
        reporter_module.Reporter.metric(reporter, "local stores eliminated", optimization.storesEliminated)
        reporter_module.Reporter.metric(reporter, "unreachable functions eliminated", optimization.functionsEliminated)
        reporter_module.Reporter.metric(reporter, "unreachable function instructions eliminated", optimization.functionInstructionsEliminated)
        reporter_module.Reporter.metric(reporter, "post-terminator instructions eliminated", optimization.postTerminatorInstructionsEliminated)
        reporter_module.Reporter.metric(reporter, "dead instructions eliminated", optimization.eliminated)
        if options.target != options_module.Target.x86_64_linux {
            const status = Self.emitAarch64(allocator, &ir, type_store, options, reporter)
            lower.deinit(&builder)
            lir.deinit(&ir)
            return status
        }
        reporter_module.Reporter.progress(reporter, 7, "generate x86_64 machine code")
        var encoder = encoder_module.init(allocator)
        var codegen = codegen_module.Codegen.init(allocator, &encoder, &ir, type_store)
        codegen_module.Codegen.generateBinary(&codegen)
        reporter_module.Reporter.traceValue(reporter, "machine-code bytes: ", encoder_module.pos(&encoder))
        reporter_module.Reporter.metric(reporter, "machine-code bytes", encoder_module.pos(&encoder))
        reporter_module.Reporter.metric(reporter, "backend symbols", encoder_module.symbolCount(&encoder))
        reporter_module.Reporter.metric(reporter, "backend fixups", encoder_module.fixupCount(&encoder))
        reporter_module.Reporter.metric(reporter, "backend stack loads forwarded", encoder_module.forwardedLoads(&encoder))
        reporter_module.Reporter.metric(reporter, "backend cached rax loads", encoder_module.cachedRaxLoads(&encoder))
        reporter_module.Reporter.metric(reporter, "backend memory operands", codegen_module.Codegen.memoryOperandCount(&codegen))
        reporter_module.Reporter.metric(reporter, "backend deferred spills", codegen_module.Codegen.deferredSpillCount(&codegen))
        reporter_module.Reporter.metric(reporter, "backend retained rax uses", codegen_module.Codegen.retainedRaxUseCount(&codegen))
        reporter_module.Reporter.metric(reporter, "backend fallthrough branches removed", codegen_module.Codegen.fallthroughBranchCount(&codegen))
        reporter_module.Reporter.metric(reporter, "backend direct calls", codegen_module.Codegen.directCallCount(&codegen))
        reporter_module.Reporter.metric(reporter, "aggregate allocation sites", codegen_module.Codegen.aggregateAllocationCount(&codegen))
        reporter_module.Reporter.metric(reporter, "aggregate allocation bytes (static)", codegen_module.Codegen.aggregateAllocationBytes(&codegen))
        reporter_module.Reporter.progress(reporter, 8, "resolve backend symbols")
        if !encoder_module.applyFixups(&encoder) {
            Self.reportUnresolved(reporter, &encoder)
            Self.deinitBackend(&codegen, &encoder, &builder, &ir)
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.linker, "unresolved backend symbol")
            reporter_module.Reporter.failActiveStep(reporter, 1)
            return 8
        }
        reporter_module.Reporter.metric(reporter, "symbol lookup probes", encoder_module.fixupProbes(&encoder))
        reporter_module.Reporter.metric(reporter, "maximum lookup probes", encoder_module.maxFixupProbes(&encoder))
        reporter_module.Reporter.progress(reporter, 9, "write ELF64 executable")
        var wrote = false
        if encoder_module.hasLinkFixups(&encoder) || encoder_module.exportCount(&encoder) > 0 {
            reporter_module.Reporter.metric(reporter, "imported functions", encoder_module.importCount(&encoder))
            reporter_module.Reporter.metric(reporter, "exported functions", encoder_module.exportCount(&encoder))
            wrote = Self.writeDynamicExecutable(allocator, &encoder, options)
        } else {
            var empty_rodata: [*]const u8 = undefined
            unsafe { empty_rodata = @ptrFromInt([*]const u8, 0) }
            wrote = elf64.writeExecutable(allocator, encoder.buf.*.items, encoder.buf.*.length, 0, empty_rodata, 0, options.outputPointer)
        }
        Self.deinitBackend(&codegen, &encoder, &builder, &ir)
        if !wrote {
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "failed to write output file")
            reporter_module.Reporter.failActiveStep(reporter, 1)
            return 9
        }
        return 0
    }

    // A program that calls C functions is loaded by the system dynamic
    // linker; it always links libc.so.6 (dlopen, dlsym and the rest of the
    // C library), plus every library named with --library.
    fn writeDynamicExecutable(allocator: arena_allocator.Allocator, encoder: *encoder_module.Encoder, options: options_module.Options) -> bool {
        const extra = options_module.Options.libraryCount(options)
        var needed: [*][*]const u8 = undefined
        unsafe {
            needed = @ptrCast([*][*]const u8, allocator.alloc((extra + 1) * 8, 8).?)
            needed[0] = @ptrCast([*]const u8, "libc.so.6")
        }
        var index: usize = 0
        while index < extra {
            needed[index + 1] = options_module.Options.library(options, index)
            index += 1
        }
        unsafe { return elf64_dynamic.writeExecutable(allocator, encoder, @ptrCast([*]const [*]const u8, needed), extra + 1, options.outputPointer) }
    }

    fn emitAarch64(allocator: arena_allocator.Allocator, ir: *lir.Lir, type_store: *types.Store, options: options_module.Options, reporter: *reporter_module.Reporter) -> u8 {
        const shared = options.target == options_module.Target.aarch64_android
        reporter_module.Reporter.progress(reporter, 7, "generate aarch64 machine code")
        var encoder = a64_encoder.init(allocator)
        var codegen = a64_codegen.Codegen.init(allocator, &encoder, ir, type_store)
        a64_codegen.Codegen.generateBinary(&codegen, !shared)
        const code_length = a64_encoder.pos(&encoder)
        reporter_module.Reporter.traceValue(reporter, "machine-code bytes: ", code_length)
        reporter_module.Reporter.metric(reporter, "machine-code bytes", code_length)
        reporter_module.Reporter.metric(reporter, "backend symbols", a64_encoder.symbolCount(&encoder))
        reporter_module.Reporter.metric(reporter, "backend fixups", a64_encoder.fixupCount(&encoder))
        reporter_module.Reporter.metric(reporter, "backend fallthrough branches removed", a64_codegen.Codegen.fallthroughBranchCount(&codegen))
        reporter_module.Reporter.metric(reporter, "backend direct calls", a64_codegen.Codegen.directCallCount(&codegen))
        reporter_module.Reporter.metric(reporter, "aggregate allocation sites", a64_codegen.Codegen.aggregateAllocationCount(&codegen))
        reporter_module.Reporter.metric(reporter, "aggregate allocation bytes (static)", a64_codegen.Codegen.aggregateAllocationBytes(&codegen))
        if a64_codegen.Codegen.invalidOperandCount(&codegen) != 0 {
            reporter_module.Reporter.metric(reporter, "invalid backend operands", a64_codegen.Codegen.invalidOperandCount(&codegen))
            a64_codegen.Codegen.deinit(&codegen)
            a64_encoder.deinit(&encoder)
            reporter_module.Reporter.failure(diagnostic.Code.unsupported_instruction_lowering, diagnostic.Phase.codegen, "an instruction uses a value that was never lowered")
            reporter_module.Reporter.failActiveStep(reporter, 1)
            return 10
        }
        if shared { return Self.emitAndroidLibrary(allocator, &codegen, &encoder, options, reporter) }
        reporter_module.Reporter.progress(reporter, 8, "resolve backend symbols")
        const text_vaddr = @intCast(u64, elf64_aarch64.TEXT_VADDR)
        const data_vaddr = @intCast(u64, elf64_aarch64.dataVaddr(code_length))
        if !a64_encoder.applyFixups(&encoder, text_vaddr, data_vaddr, 0) {
            reporter_module.Reporter.unresolvedSymbol(reporter, a64_encoder.unresolvedFixupPointer(&encoder), a64_encoder.unresolvedFixupLength(&encoder))
            a64_codegen.Codegen.deinit(&codegen)
            a64_encoder.deinit(&encoder)
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.linker, "unresolved backend symbol")
            reporter_module.Reporter.failActiveStep(reporter, 1)
            return 8
        }
        reporter_module.Reporter.progress(reporter, 9, "write ELF64 executable (aarch64)")
        const wrote = elf64_aarch64.writeExecutable(allocator, encoder.buf.*.items, code_length, 0, encoder.dataSize, options.outputPointer)
        a64_codegen.Codegen.deinit(&codegen)
        a64_encoder.deinit(&encoder)
        if !wrote {
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "failed to write output file")
            reporter_module.Reporter.failActiveStep(reporter, 1)
            return 9
        }
        return 0
    }

    // Android: a shared object (libmain.so) whose exported functions the
    // framework calls. It links against the stable NDK system libraries;
    // imported functions resolve from any of them.
    fn emitAndroidLibrary(allocator: arena_allocator.Allocator, codegen: *a64_codegen.Codegen, encoder: *a64_encoder.Encoder, options: options_module.Options, reporter: *reporter_module.Reporter) -> u8 {
        reporter_module.Reporter.metric(reporter, "imported functions", a64_encoder.importCount(encoder))
        reporter_module.Reporter.metric(reporter, "exported functions", a64_encoder.exportCount(encoder))
        reporter_module.Reporter.progress(reporter, 8, "resolve backend symbols")
        var needed = array_list.ArrayList.init(allocator, 64)
        Self.appendNeeded(&needed, "libandroid.so")
        Self.appendNeeded(&needed, "liblog.so")
        Self.appendNeeded(&needed, "libm.so")
        Self.appendNeeded(&needed, "libc.so")
        Self.appendNeeded(&needed, "libdl.so")
        var soname: [*]const u8 = undefined
        unsafe { soname = @ptrCast([*]const u8, "libmain.so") }
        var status = elf64_aarch64.SHARED_OK
        if options_module.Options.outputIsApk(options) {
            reporter_module.Reporter.progress(reporter, 9, "link libmain.so (aarch64)")
            const image = elf64_aarch64.buildSharedObject(allocator, encoder, soname, 10, needed.items, needed.length)
            status = image.status
            if status == elf64_aarch64.SHARED_OK {
                reporter_module.Reporter.metric(reporter, "libmain.so bytes", image.size)
                reporter_module.Reporter.progress(reporter, 10, "package and sign APK")
                if !Self.writeApk(allocator, image, options, reporter) { status = elf64_aarch64.SHARED_WRITE_FAILED }
            }
        } else {
            reporter_module.Reporter.progress(reporter, 9, "write ELF64 shared object (aarch64)")
            status = elf64_aarch64.writeSharedObject(allocator, encoder, soname, 10, needed.items, needed.length, options.outputPointer)
        }
        array_list.ArrayList.deinit(needed)
        if status == elf64_aarch64.SHARED_UNRESOLVED {
            reporter_module.Reporter.unresolvedSymbol(reporter, a64_encoder.unresolvedFixupPointer(encoder), a64_encoder.unresolvedFixupLength(encoder))
        }
        a64_codegen.Codegen.deinit(codegen)
        a64_encoder.deinit(encoder)
        if status == elf64_aarch64.SHARED_UNRESOLVED {
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.linker, "unresolved backend symbol")
            reporter_module.Reporter.failActiveStep(reporter, 1)
            return 8
        }
        if status != elf64_aarch64.SHARED_OK {
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "failed to write output file")
            reporter_module.Reporter.failActiveStep(reporter, 1)
            return 9
        }
        return 0
    }

    fn androidOptionsValid(reporter: *reporter_module.Reporter, options: options_module.Options) -> bool {
        if options.invalidOptionLength != 0 {
            reporter_module.Reporter.unresolvedSymbol(reporter, options.invalidOptionPointer, options.invalidOptionLength)
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "option value is not a decimal number")
            return false
        }
        if options.androidMinSdk < 21 {
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "--android-min-sdk must be at least 21 (the first release with arm64-v8a)")
            return false
        }
        if options.androidTargetSdk < options.androidMinSdk {
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "--android-target-sdk must not be below --android-min-sdk")
            return false
        }
        return true
    }

    // Packages the linked libmain.so into a signed APK at the output path.
    fn writeApk(allocator: arena_allocator.Allocator, image: elf64_aarch64.SharedObject, options: options_module.Options, reporter: *reporter_module.Reporter) -> bool {
        var key_path = options.androidKeyPointer
        if !options.hasAndroidKey {
            if options.homeLength == 0 {
                reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "no signing key: pass --android-key=PATH or set HOME for the default debug key")
                return false
            }
            // Default debug key: $HOME/.mlx/android-debug.key
            var path = array_list.ArrayList.init(allocator, options.homeLength + 32)
            android_bytes.appendBytes(&path, android_bytes.of(options.homePointer, options.homeLength))
            android_bytes.appendText(&path, "/.mlx")
            android_bytes.appendU8(&path, 0)
            const made = fs.makeDir(path.items, 448) // 0700; may already exist
            path.length -= 1
            android_bytes.appendText(&path, "/android-debug.key")
            android_bytes.appendU8(&path, 0)
            key_path = path.items
        }
        var generated = false
        var key = apk.loadOrCreateKey(allocator, key_path, &generated)
        if generated { reporter_module.Reporter.metric(reporter, "new signing key generated (RSA-2048)", 1) }
        if !key.valid {
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "cannot read or create the signing key")
            return false
        }
        const manifest = apk.ManifestOptions.{
            .package = android_bytes.of(options.androidPackagePointer, options.androidPackageLength),
            .label = android_bytes.of(options.androidLabelPointer, options.androidLabelLength),
            .versionCode = options.androidVersionCode,
            .versionName = android_bytes.of(options.androidVersionNamePointer, options.androidVersionNameLength),
            .minSdk = options.androidMinSdk,
            .targetSdk = options.androidTargetSdk,
            .fullscreen = options.androidFullscreen,
        }
        var library: [*]const u8 = undefined
        unsafe { library = @ptrCast([*]const u8, image.buffer) }
        const package = apk.build(allocator, android_bytes.of(library, image.size), manifest, &key, android_bytes.of(options.androidPackagePointer, options.androidPackageLength))
        reporter_module.Reporter.metric(reporter, "APK bytes", package.length)
        return elf64_aarch64.writeFileMode(package.items, package.length, options.outputPointer, 420) // 0644
    }

    fn appendNeeded(list: *array_list.ArrayList, name: []const u8) -> void {
        for byte in name { const appended = array_list.ArrayList.appendAt(list, byte) }
        const terminated = array_list.ArrayList.appendAt(list, 0)
    }

    fn lowerModules(loader: *modules.Loader, builder: *lower.LirBuilder) -> void {
        var module_index: usize = 0
        while module_index < modules.moduleCount(loader) {
            lower.generateModule(builder, module_index)
            module_index += 1
        }
        lower.generateGenericInstances(builder)
    }

    fn traceLir(reporter: *reporter_module.Reporter, builder: *lower.LirBuilder, ir: *lir.Lir) -> void {
        reporter_module.Reporter.traceValue(reporter, "generic instances: ", lower.genericInstanceCount(builder))
        reporter_module.Reporter.traceValue(reporter, "LIR instructions: ", lir.instCount(ir))
        reporter_module.Reporter.metric(reporter, "generic instances", lower.genericInstanceCount(builder))
        reporter_module.Reporter.metric(reporter, "optimization level", lower.optimizationLevel(builder))
        reporter_module.Reporter.metric(reporter, "calls inlined", lower.inlinedCallCount(builder))
        reporter_module.Reporter.metric(reporter, "calls automatically inlined", lower.automaticallyInlinedCallCount(builder))
        reporter_module.Reporter.metric(reporter, "inline requests kept as calls", lower.inlineMissCount(builder))
        reporter_module.Reporter.metric(reporter, "expression type queries", lower.expressionTypeQueryCount(builder))
        reporter_module.Reporter.metric(reporter, "expression type cache hits", lower.expressionTypeCacheHitCount(builder))
        reporter_module.Reporter.metric(reporter, "resolved type queries", lower.resolvedTypeQueryCount(builder))
        reporter_module.Reporter.metric(reporter, "resolved type cache hits", lower.resolvedTypeCacheHitCount(builder))
        reporter_module.Reporter.metric(reporter, "LIR instructions", lir.instCount(ir))
        reporter_module.Reporter.metric(reporter, "LIR extra words", lir.extraDataCount(ir))
        reporter_module.Reporter.metric(reporter, "LIR symbols", lir.symbolCount(ir))
        reporter_module.Reporter.metric(reporter, "string literals", lir.stringLiteralCount(ir))
    }

    fn traceTypeInterning(reporter: *reporter_module.Reporter, type_store: *types.Store) -> void {
        reporter_module.Reporter.metric(reporter, "type intern calls", types.internCallCount(type_store))
        reporter_module.Reporter.metric(reporter, "type intern probes", types.internProbeCount(type_store))
        reporter_module.Reporter.metric(reporter, "maximum type intern probes", types.maxInternProbeCount(type_store))
        reporter_module.Reporter.metric(reporter, "primitive type cache hits", types.primitiveCacheHitCount(type_store))
    }

    fn traceMethodLookup(reporter: *reporter_module.Reporter, symbol_store: *symbols.Store) -> void {
        reporter_module.Reporter.metric(reporter, "aggregate method lookups", symbols.methodQueryCount(symbol_store))
        reporter_module.Reporter.metric(reporter, "aggregate method probes", symbols.methodProbeCount(symbol_store))
        reporter_module.Reporter.metric(reporter, "maximum aggregate method probes", symbols.maxMethodProbeCount(symbol_store))
    }

    fn reportUnresolved(reporter: *reporter_module.Reporter, encoder: *encoder_module.Encoder) -> void {
        reporter_module.Reporter.unresolvedSymbol(reporter, encoder_module.unresolvedFixupPointer(encoder), encoder_module.unresolvedFixupLength(encoder))
    }

    fn deinitBackend(codegen: *codegen_module.Codegen, encoder: *encoder_module.Encoder, builder: *lower.LirBuilder, ir: *lir.Lir) -> void {
        codegen_module.Codegen.deinit(codegen)
        encoder_module.deinit(encoder)
        lower.deinit(builder)
        lir.deinit(ir)
    }
}
