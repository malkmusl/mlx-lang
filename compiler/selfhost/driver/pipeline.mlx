const page_allocator = @import("../../../std/bootstrap/page_allocator.mlx")
const arena_allocator = @import("../../../std/bootstrap/arena_allocator.mlx")
const process = @import("../../../std/bootstrap/process.mlx")
const modules = @import("../modules.mlx")
const types = @import("../types.mlx")
const symbols = @import("../symbols.mlx")
const diagnostic = @import("../diagnostic.mlx")
const lir = @import("../ir/lir.mlx")
const lower = @import("../ir/lower.mlx")
const optimize = @import("../ir/optimize.mlx")
const encoder_module = @import("../backend/x86_64/encoder.mlx")
const codegen_module = @import("../backend/x86_64/codegen.mlx")
const elf64 = @import("../object/elf64.mlx")
const options_module = @import("./options.mlx")
const reporter_module = @import("./reporter.mlx")

pub const Pipeline = struct {
    pub fn compile(options: options_module.Options) -> u8 {
        unsafe {
            var reporter = reporter_module.Reporter.init(options.compilerNamePointer, options.compilerNameLength, options.showProgress, options.traceEnabled, options_module.Options.stepCount(options))
            Self.tracePaths(&reporter, options)
            const pages = page_allocator.init()
            var arena = arena_allocator.init(pages, 268435456)
            const allocator = arena_allocator.interface(&arena)
            reporter_module.Reporter.progress(&reporter, 1, "load and parse module graph")
            const loader = modules.initLoader(allocator, @ptrCast([*]const u8, "std/src"), 7, null)
            const root = modules.loadRoot(loader, options.inputPointer, options.inputLength)
            if root == modules.NONE || modules.totalErrors(loader) != 0 {
                reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "module graph could not be loaded")
                modules.deinitLoader(loader)
                Self.finishArena(&reporter, &arena)
                reporter_module.Reporter.finish(&reporter)
                return 4
            }
            Self.traceGraph(&reporter, loader)
            reporter_module.Reporter.metric(&reporter, "modules loaded", modules.moduleCount(loader))
            reporter_module.Reporter.metric(&reporter, "imports discovered", modules.importCount(loader))
            Self.reportFrontendMetrics(&reporter, loader)
            var type_store = types.init(allocator)
            var symbol_store = symbols.initStore(allocator, modules.moduleCount(loader) * 64 + 64)
            var status = Self.analyze(loader, &type_store, &symbol_store, &reporter)
            if status == 0 && options.hasOutput {
                status = Self.emitExecutable(loader, allocator, &type_store, &symbol_store, options, &reporter)
            }
            symbols.deinitStore(&symbol_store)
            types.deinit(&type_store)
            modules.deinitLoader(loader)
            Self.finishArena(&reporter, &arena)
            reporter_module.Reporter.finish(&reporter)
            return status
        }
    }

    fn finishArena(reporter: *reporter_module.Reporter, arena: *arena_allocator.Arena) -> void {
        reporter_module.Reporter.metric(reporter, "compiler arena bytes", arena.*.offset)
        arena_allocator.deinit(arena)
    }

    fn tracePaths(reporter: *reporter_module.Reporter, options: options_module.Options) -> void {
        reporter_module.Reporter.traceString(reporter, "input: ", process.String.{ .pointer = options.inputPointer, .length = options.inputLength })
        if options.hasOutput {
            const output = process.fromCString(options.outputPointer)
            reporter_module.Reporter.traceString(reporter, "output: ", output)
        }
    }

    fn traceGraph(reporter: *reporter_module.Reporter, loader: *modules.Loader) -> void {
        reporter_module.Reporter.traceValue(reporter, "modules: ", modules.moduleCount(loader))
        reporter_module.Reporter.traceValue(reporter, "imports: ", modules.importCount(loader))
        reporter_module.Reporter.traceModules(reporter, loader)
    }

    fn reportFrontendMetrics(reporter: *reporter_module.Reporter, loader: *modules.Loader) -> void {
        reporter_module.Reporter.metric(reporter, "source bytes", modules.sourceByteCount(loader))
        reporter_module.Reporter.metric(reporter, "tokens scanned", modules.tokenCount(loader))
        reporter_module.Reporter.metric(reporter, "AST nodes parsed", modules.nodeCount(loader))
        reporter_module.Reporter.metric(reporter, "declarations discovered", modules.declarationCount(loader))
        reporter_module.Reporter.metric(reporter, "functions discovered", modules.functionCount(loader))
        reporter_module.Reporter.metricDuration(reporter, "source I/O", modules.sourceLoadTime(loader))
        reporter_module.Reporter.metricDuration(reporter, "lexing", modules.lexerTime(loader))
        reporter_module.Reporter.metricDuration(reporter, "parsing", modules.parserTime(loader))
    }

    fn analyze(loader: *modules.Loader, type_store: *types.Store, symbol_store: *symbols.Store, reporter: *reporter_module.Reporter) -> u8 {
        reporter_module.Reporter.progress(reporter, 2, "resolve modules and declarations")
        if modules.prepare(loader, type_store, symbol_store) != 0 {
            reporter_module.Reporter.failure(diagnostic.Code.duplicate_symbol, diagnostic.Phase.resolve, "duplicate declaration")
            return 5
        }
        reporter_module.Reporter.progress(reporter, 3, "analyze declaration types")
        if modules.analyzeDeclarations(loader, type_store, symbol_store) != 0 {
            reporter_module.Reporter.failure(diagnostic.Code.type_mismatch, diagnostic.Phase.sema, "declaration type could not be resolved")
            return 6
        }
        reporter_module.Reporter.traceValue(reporter, "types after declarations: ", types.count(type_store))
        reporter_module.Reporter.metric(reporter, "types resolved", types.count(type_store))
        reporter_module.Reporter.metric(reporter, "symbols registered", symbol_store.*.length)
        reporter_module.Reporter.progress(reporter, 4, "analyze function bodies")
        if modules.analyzeFunctionBodies(loader, type_store, symbol_store) != 0 {
            reporter_module.Reporter.failure(diagnostic.Code.type_mismatch, diagnostic.Phase.sema, "function body could not be resolved")
            return 7
        }
        Self.traceTypeInterning(reporter, type_store)
        Self.traceMethodLookup(reporter, symbol_store)
        return 0
    }

    fn emitExecutable(loader: *modules.Loader, allocator: arena_allocator.Allocator, type_store: *types.Store, symbol_store: *symbols.Store, options: options_module.Options, reporter: *reporter_module.Reporter) -> u8 {
        reporter_module.Reporter.progress(reporter, 5, "lower typed AST to LIR")
        var ir = lir.init(allocator)
        var builder = lower.init(&ir, type_store, symbol_store, loader, allocator, options.optimizationLevel)
        Self.lowerModules(loader, &builder)
        Self.traceLir(reporter, &builder, &ir)
        Self.traceTypeInterning(reporter, type_store)
        Self.traceMethodLookup(reporter, symbol_store)
        if lower.unsupportedInstructionCount(&builder) != 0 {
            reporter_module.Reporter.metric(reporter, "unsupported executable lowerings", lower.unsupportedInstructionCount(&builder))
            reporter_module.Reporter.failureAt(
                diagnostic.Code.unsupported_instruction_lowering,
                diagnostic.Phase.codegen,
                lower.firstUnsupportedInstructionOffset(&builder),
                lower.firstUnsupportedInstructionLength(&builder),
                "construct has no specified executable lowering",
            )
            lower.deinit(&builder)
            lir.deinit(&ir)
            return 10
        }
        reporter_module.Reporter.progress(reporter, 6, "optimize LIR")
        const optimization = optimize.run(&ir, allocator)
        reporter_module.Reporter.metric(reporter, "LIR instructions before optimization", optimization.instructionsBefore)
        reporter_module.Reporter.metric(reporter, "LIR instructions after optimization", optimization.instructionsAfter)
        reporter_module.Reporter.metric(reporter, "constants folded", optimization.constantsFolded)
        reporter_module.Reporter.metric(reporter, "constant branches simplified", optimization.branchesSimplified)
        reporter_module.Reporter.metric(reporter, "comparison branches fused", optimization.comparisonBranchesFused)
        reporter_module.Reporter.metric(reporter, "local loads forwarded", optimization.loadsForwarded)
        reporter_module.Reporter.metric(reporter, "copy operands propagated", optimization.copiesPropagated)
        reporter_module.Reporter.metric(reporter, "local stack slots promoted", optimization.localsPromoted)
        reporter_module.Reporter.metric(reporter, "local stores eliminated", optimization.storesEliminated)
        reporter_module.Reporter.metric(reporter, "unreachable functions eliminated", optimization.functionsEliminated)
        reporter_module.Reporter.metric(reporter, "unreachable function instructions eliminated", optimization.functionInstructionsEliminated)
        reporter_module.Reporter.metric(reporter, "dead instructions eliminated", optimization.eliminated)
        reporter_module.Reporter.progress(reporter, 7, "generate x86_64 machine code")
        var encoder = encoder_module.init(allocator)
        var codegen = codegen_module.Codegen.init(allocator, &encoder, &ir, type_store)
        codegen_module.Codegen.generateBinary(&codegen)
        reporter_module.Reporter.traceValue(reporter, "machine-code bytes: ", encoder_module.pos(&encoder))
        reporter_module.Reporter.metric(reporter, "machine-code bytes", encoder_module.pos(&encoder))
        reporter_module.Reporter.metric(reporter, "backend symbols", encoder_module.symbolCount(&encoder))
        reporter_module.Reporter.metric(reporter, "backend fixups", encoder_module.fixupCount(&encoder))
        reporter_module.Reporter.metric(reporter, "backend stack loads forwarded", encoder_module.forwardedLoads(&encoder))
        reporter_module.Reporter.metric(reporter, "backend cached rax loads", encoder_module.cachedRaxLoads(&encoder))
        reporter_module.Reporter.metric(reporter, "backend memory operands", codegen_module.Codegen.memoryOperandCount(&codegen))
        reporter_module.Reporter.metric(reporter, "backend deferred spills", codegen_module.Codegen.deferredSpillCount(&codegen))
        reporter_module.Reporter.metric(reporter, "backend retained rax uses", codegen_module.Codegen.retainedRaxUseCount(&codegen))
        reporter_module.Reporter.metric(reporter, "backend fallthrough branches removed", codegen_module.Codegen.fallthroughBranchCount(&codegen))
        reporter_module.Reporter.metric(reporter, "backend direct calls", codegen_module.Codegen.directCallCount(&codegen))
        reporter_module.Reporter.metric(reporter, "aggregate allocation sites", codegen_module.Codegen.aggregateAllocationCount(&codegen))
        reporter_module.Reporter.metric(reporter, "aggregate allocation bytes (static)", codegen_module.Codegen.aggregateAllocationBytes(&codegen))
        reporter_module.Reporter.progress(reporter, 8, "resolve backend symbols")
        if !encoder_module.applyFixups(&encoder) {
            Self.reportUnresolved(reporter, &encoder)
            Self.deinitBackend(&codegen, &encoder, &builder, &ir)
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.linker, "unresolved backend symbol")
            return 8
        }
        reporter_module.Reporter.metric(reporter, "symbol lookup probes", encoder_module.fixupProbes(&encoder))
        reporter_module.Reporter.metric(reporter, "maximum lookup probes", encoder_module.maxFixupProbes(&encoder))
        reporter_module.Reporter.progress(reporter, 9, "write ELF64 executable")
        var empty_rodata: [*]const u8 = undefined
        unsafe { empty_rodata = @ptrFromInt([*]const u8, 0) }
        const wrote = elf64.writeExecutable(allocator, encoder.buf.*.items, encoder.buf.*.length, 0, empty_rodata, 0, options.outputPointer)
        Self.deinitBackend(&codegen, &encoder, &builder, &ir)
        if !wrote {
            reporter_module.Reporter.failure(diagnostic.Code.import_not_found, diagnostic.Phase.resolve, "failed to write output file")
            return 9
        }
        return 0
    }

    fn lowerModules(loader: *modules.Loader, builder: *lower.LirBuilder) -> void {
        var module_index: usize = 0
        while module_index < modules.moduleCount(loader) {
            lower.generateModule(builder, module_index)
            module_index += 1
        }
        lower.generateGenericInstances(builder)
    }

    fn traceLir(reporter: *reporter_module.Reporter, builder: *lower.LirBuilder, ir: *lir.Lir) -> void {
        reporter_module.Reporter.traceValue(reporter, "generic instances: ", lower.genericInstanceCount(builder))
        reporter_module.Reporter.traceValue(reporter, "LIR instructions: ", lir.instCount(ir))
        reporter_module.Reporter.metric(reporter, "generic instances", lower.genericInstanceCount(builder))
        reporter_module.Reporter.metric(reporter, "optimization level", lower.optimizationLevel(builder))
        reporter_module.Reporter.metric(reporter, "calls inlined", lower.inlinedCallCount(builder))
        reporter_module.Reporter.metric(reporter, "calls automatically inlined", lower.automaticallyInlinedCallCount(builder))
        reporter_module.Reporter.metric(reporter, "inline requests kept as calls", lower.inlineMissCount(builder))
        reporter_module.Reporter.metric(reporter, "expression type queries", lower.expressionTypeQueryCount(builder))
        reporter_module.Reporter.metric(reporter, "expression type cache hits", lower.expressionTypeCacheHitCount(builder))
        reporter_module.Reporter.metric(reporter, "resolved type queries", lower.resolvedTypeQueryCount(builder))
        reporter_module.Reporter.metric(reporter, "resolved type cache hits", lower.resolvedTypeCacheHitCount(builder))
        reporter_module.Reporter.metric(reporter, "LIR instructions", lir.instCount(ir))
        reporter_module.Reporter.metric(reporter, "LIR extra words", lir.extraDataCount(ir))
        reporter_module.Reporter.metric(reporter, "LIR symbols", lir.symbolCount(ir))
        reporter_module.Reporter.metric(reporter, "string literals", lir.stringLiteralCount(ir))
    }

    fn traceTypeInterning(reporter: *reporter_module.Reporter, type_store: *types.Store) -> void {
        reporter_module.Reporter.metric(reporter, "type intern calls", types.internCallCount(type_store))
        reporter_module.Reporter.metric(reporter, "type intern probes", types.internProbeCount(type_store))
        reporter_module.Reporter.metric(reporter, "maximum type intern probes", types.maxInternProbeCount(type_store))
        reporter_module.Reporter.metric(reporter, "primitive type cache hits", types.primitiveCacheHitCount(type_store))
    }

    fn traceMethodLookup(reporter: *reporter_module.Reporter, symbol_store: *symbols.Store) -> void {
        reporter_module.Reporter.metric(reporter, "aggregate method lookups", symbols.methodQueryCount(symbol_store))
        reporter_module.Reporter.metric(reporter, "aggregate method probes", symbols.methodProbeCount(symbol_store))
        reporter_module.Reporter.metric(reporter, "maximum aggregate method probes", symbols.maxMethodProbeCount(symbol_store))
    }

    fn reportUnresolved(reporter: *reporter_module.Reporter, encoder: *encoder_module.Encoder) -> void {
        reporter_module.Reporter.unresolvedSymbol(reporter, encoder_module.unresolvedFixupPointer(encoder), encoder_module.unresolvedFixupLength(encoder))
    }

    fn deinitBackend(codegen: *codegen_module.Codegen, encoder: *encoder_module.Encoder, builder: *lower.LirBuilder, ir: *lir.Lir) -> void {
        codegen_module.Codegen.deinit(codegen)
        encoder_module.deinit(encoder)
        lower.deinit(builder)
        lir.deinit(ir)
    }
}
