const process = @import("../../../std/bootstrap/process.mlx")
const strings = @import("../../../std/bootstrap/string.mlx")

// Code generation targets. aarch64-linux produces static Linux executables
// (the test vehicle for the AArch64 backend); aarch64-android is added by
// the Android packaging stages.
pub const Target = enum(u8) { x86_64_linux, aarch64_linux, aarch64_android }

pub const Options = struct {
    compilerNamePointer: [*]const u8
    compilerNameLength: usize
    inputPointer: [*]const u8
    inputLength: usize
    outputPointer: [*]const u8
    hasOutput: bool
    showProgress: bool
    traceEnabled: bool
    optimizationLevel: u8
    runtimeSafety: bool
    target: Target
    targetValid: bool

    pub fn parse(arguments: [][*]const u8) -> Self {
        var result = Self.defaults()
        const count = process.count(arguments)
        if count > 0 { Self.setCompilerName(&result, process.argument(arguments, 0)) }
        var index: usize = 1
        while index < count {
            const argument = process.argument(arguments, index)
            if Self.isOutputFlag(argument) && index + 1 < count {
                index += 1
                result.outputPointer = process.argument(arguments, index).pointer
                result.hasOutput = true
            } else if Self.equals(argument, "--quiet") {
                result.showProgress = false
            } else if Self.equals(argument, "--progress") {
                result.showProgress = true
            } else if Self.equals(argument, "--trace") || Self.equals(argument, "--verbose") {
                result.traceEnabled = true
                result.showProgress = true
            } else if Self.equals(argument, "-O0") {
                result.optimizationLevel = 0
            } else if Self.equals(argument, "-O1") {
                result.optimizationLevel = 1
            } else if Self.equals(argument, "-O2") {
                result.optimizationLevel = 2
            } else if Self.equals(argument, "-O3") {
                result.optimizationLevel = 3
            } else if Self.equals(argument, "--safety=on") {
                result.runtimeSafety = true
            } else if Self.equals(argument, "--safety=off") {
                result.runtimeSafety = false
            } else if Self.equals(argument, "--target=x86_64-linux") {
                result.target = Target.x86_64_linux
            } else if Self.equals(argument, "--target=aarch64-linux") {
                result.target = Target.aarch64_linux
            } else if Self.equals(argument, "--target=aarch64-android") {
                result.target = Target.aarch64_android
            } else if Self.startsWith(argument, "--target=") {
                result.targetValid = false
            } else {
                result.inputPointer = argument.pointer
                result.inputLength = argument.length
            }
            index += 1
        }
        return result
    }

    fn defaults() -> Self {
        unsafe {
            return Self.{
                .compilerNamePointer = @ptrCast([*]const u8, "mlx1"),
                .compilerNameLength = 4,
                .inputPointer = @ptrCast([*]const u8, "compiler/selfhost/main.mlx"),
                .inputLength = 26,
                .outputPointer = @ptrCast([*]const u8, "a.out"),
                .hasOutput = false,
                .showProgress = true,
                .traceEnabled = false,
                .optimizationLevel = 2,
                .runtimeSafety = true,
                .target = Target.x86_64_linux,
                .targetValid = true,
            }
        }
    }

    fn setCompilerName(options: *Self, argument: process.String) -> void {
        var start: usize = 0
        var index: usize = 0
        while index < argument.length {
            if argument.pointer[index] == 47 { start = index + 1 }
            index += 1
        }
        unsafe { options.*.compilerNamePointer = @ptrFromInt([*]const u8, @intFromPtr(argument.pointer) + start) }
        options.*.compilerNameLength = argument.length - start
    }

    fn isOutputFlag(argument: process.String) -> bool {
        return argument.length == 2 && argument.pointer[0] == 45 && argument.pointer[1] == 111
    }

    fn startsWith(argument: process.String, prefix: []const u8) -> bool {
        const expected = strings.fromSlice(prefix)
        if argument.length < expected.length { return false }
        var index: usize = 0
        while index < expected.length {
            if argument.pointer[index] != expected.pointer[index] { return false }
            index += 1
        }
        return true
    }

    fn equals(argument: process.String, expected: []const u8) -> bool {
        return strings.eql(argument, strings.fromSlice(expected))
    }

    pub fn stepCount(options: Self) -> usize { return if options.hasOutput { 9 } else { 4 } }
}
