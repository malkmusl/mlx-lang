const process = @import("../../../std/bootstrap/process.mlx")
const strings = @import("../../../std/bootstrap/string.mlx")

pub const Options = struct {
    inputPointer: [*]const u8
    inputLength: usize
    outputPointer: [*]const u8
    hasOutput: bool
    showProgress: bool
    traceEnabled: bool

    pub fn parse(arguments: [][*]const u8) -> Self {
        var result = Self.defaults()
        const count = process.count(arguments)
        var index: usize = 1
        while index < count {
            const argument = process.argument(arguments, index)
            if Self.isOutputFlag(argument) && index + 1 < count {
                index += 1
                result.outputPointer = process.argument(arguments, index).pointer
                result.hasOutput = true
            } else if Self.equals(argument, "--quiet") {
                result.showProgress = false
            } else if Self.equals(argument, "--progress") {
                result.showProgress = true
            } else if Self.equals(argument, "--trace") || Self.equals(argument, "--verbose") {
                result.traceEnabled = true
                result.showProgress = true
            } else {
                result.inputPointer = argument.pointer
                result.inputLength = argument.length
            }
            index += 1
        }
        return result
    }

    fn defaults() -> Self {
        unsafe {
            return Self.{
                .inputPointer = @ptrCast([*]const u8, "compiler/selfhost/main.mlx"),
                .inputLength = 26,
                .outputPointer = @ptrCast([*]const u8, "a.out"),
                .hasOutput = false,
                .showProgress = true,
                .traceEnabled = false,
            }
        }
    }

    fn isOutputFlag(argument: process.String) -> bool {
        return argument.length == 2 && argument.pointer[0] == 45 && argument.pointer[1] == 111
    }

    fn equals(argument: process.String, expected: []const u8) -> bool {
        return strings.eql(argument, strings.fromSlice(expected))
    }

    pub fn stepCount(options: Self) -> usize { return if options.hasOutput { 8 } else { 4 } }
}
