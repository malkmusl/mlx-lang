const process = @import("../../../std/bootstrap/process.mlx")
const strings = @import("../../../std/bootstrap/string.mlx")

// Code generation targets. aarch64-linux produces static Linux executables
// (the test vehicle for the AArch64 backend); aarch64-android is added by
// the Android packaging stages.
pub const Target = enum(u8) { x86_64_linux, aarch64_linux, aarch64_android }

pub const Options = struct {
    compilerNamePointer: [*]const u8
    compilerNameLength: usize
    inputPointer: [*]const u8
    inputLength: usize
    outputPointer: [*]const u8
    hasOutput: bool
    showProgress: bool
    traceEnabled: bool
    optimizationLevel: u8
    runtimeSafety: bool
    // The command line, for repeated options such as --library.
    argumentPointer: [*]const [*]const u8
    argumentCount: usize
    target: Target
    targetValid: bool
    // Android packaging (--target=aarch64-android with an .apk output).
    androidPackagePointer: [*]const u8
    androidPackageLength: usize
    androidLabelPointer: [*]const u8
    androidLabelLength: usize
    androidVersionNamePointer: [*]const u8
    androidVersionNameLength: usize
    androidVersionCode: u32
    androidMinSdk: u32
    androidTargetSdk: u32
    androidFullscreen: bool
    androidExtractNativeLibs: bool
    androidKeyPointer: [*]const u8
    hasAndroidKey: bool
    homePointer: [*]const u8
    homeLength: usize
    // First malformed option value, reported by the pipeline.
    invalidOptionPointer: [*]const u8
    invalidOptionLength: usize

    pub fn parse(arguments: [][*]const u8) -> Self {
        var result = Self.defaults()
        const count = process.count(arguments)
        if count > 0 { Self.setCompilerName(&result, process.argument(arguments, 0)) }
        unsafe { result.argumentPointer = @ptrCast([*]const [*]const u8, arguments) }
        result.argumentCount = count
        var index: usize = 1
        while index < count {
            const argument = process.argument(arguments, index)
            if Self.isOutputFlag(argument) && index + 1 < count {
                index += 1
                result.outputPointer = process.argument(arguments, index).pointer
                result.hasOutput = true
            } else if Self.equals(argument, "--library") && index + 1 < count {
                index += 1
            } else if Self.equals(argument, "--quiet") {
                result.showProgress = false
            } else if Self.equals(argument, "--progress") {
                result.showProgress = true
            } else if Self.equals(argument, "--trace") || Self.equals(argument, "--verbose") {
                result.traceEnabled = true
                result.showProgress = true
            } else if Self.equals(argument, "-O0") {
                result.optimizationLevel = 0
            } else if Self.equals(argument, "-O1") {
                result.optimizationLevel = 1
            } else if Self.equals(argument, "-O2") {
                result.optimizationLevel = 2
            } else if Self.equals(argument, "-O3") {
                result.optimizationLevel = 3
            } else if Self.equals(argument, "--safety=on") {
                result.runtimeSafety = true
            } else if Self.equals(argument, "--safety=off") {
                result.runtimeSafety = false
            } else if Self.equals(argument, "--target=x86_64-linux") {
                result.target = Target.x86_64_linux
            } else if Self.equals(argument, "--target=aarch64-linux") {
                result.target = Target.aarch64_linux
            } else if Self.equals(argument, "--target=aarch64-android") {
                result.target = Target.aarch64_android
            } else if Self.startsWith(argument, "--target=") {
                result.targetValid = false
            } else if Self.startsWith(argument, "--android-package=") {
                const value = Self.valueAfter(argument, 18)
                result.androidPackagePointer = value.pointer
                result.androidPackageLength = value.length
            } else if Self.startsWith(argument, "--android-label=") {
                const value = Self.valueAfter(argument, 16)
                result.androidLabelPointer = value.pointer
                result.androidLabelLength = value.length
            } else if Self.startsWith(argument, "--android-version-name=") {
                const value = Self.valueAfter(argument, 23)
                result.androidVersionNamePointer = value.pointer
                result.androidVersionNameLength = value.length
            } else if Self.startsWith(argument, "--android-version-code=") {
                result.androidVersionCode = Self.numberAfter(&result, argument, 23)
            } else if Self.startsWith(argument, "--android-min-sdk=") {
                result.androidMinSdk = Self.numberAfter(&result, argument, 18)
            } else if Self.startsWith(argument, "--android-target-sdk=") {
                result.androidTargetSdk = Self.numberAfter(&result, argument, 21)
            } else if Self.equals(argument, "--android-fullscreen") {
                result.androidFullscreen = true
            } else if Self.equals(argument, "--android-extract-native-libs") {
                result.androidExtractNativeLibs = true
            } else if Self.startsWith(argument, "--android-key=") {
                result.androidKeyPointer = Self.valueAfter(argument, 14).pointer
                result.hasAndroidKey = true
            } else {
                result.inputPointer = argument.pointer
                result.inputLength = argument.length
            }
            index += 1
        }
        const home = process.environment(arguments, "HOME")
        if home != null {
            result.homePointer = home.?.pointer
            result.homeLength = home.?.length
        }
        return result
    }

    fn valueAfter(argument: process.String, prefix_length: usize) -> process.String {
        unsafe { return process.String.{ .pointer = @ptrFromInt([*]const u8, @intFromPtr(argument.pointer) + prefix_length), .length = argument.length - prefix_length } }
    }

    // A decimal option value; records the argument as invalid otherwise.
    fn numberAfter(options: *Self, argument: process.String, prefix_length: usize) -> u32 {
        var value: u32 = 0
        var index = prefix_length
        var valid = index < argument.length
        while index < argument.length {
            const digit = argument.pointer[index]
            if digit < 48 || digit > 57 || value > 100000000 { valid = false }
            if valid { value = value * 10 + @intCast(u32, digit - 48) }
            index += 1
        }
        if !valid {
            options.*.invalidOptionPointer = argument.pointer
            options.*.invalidOptionLength = argument.length
        }
        return value
    }

    fn defaults() -> Self {
        unsafe {
            return Self.{
                .compilerNamePointer = @ptrCast([*]const u8, "mlx1"),
                .compilerNameLength = 4,
                .inputPointer = @ptrCast([*]const u8, "compiler/selfhost/main.mlx"),
                .inputLength = 26,
                .outputPointer = @ptrCast([*]const u8, "a.out"),
                .hasOutput = false,
                .showProgress = true,
                .traceEnabled = false,
                .optimizationLevel = 2,
                .runtimeSafety = true,
                .argumentPointer = @ptrFromInt([*]const [*]const u8, 0),
                .argumentCount = 0,
                .target = Target.x86_64_linux,
                .targetValid = true,
                .androidPackagePointer = @ptrCast([*]const u8, "dev.mlxlang.app"),
                .androidPackageLength = 15,
                .androidLabelPointer = @ptrCast([*]const u8, "mlx app"),
                .androidLabelLength = 7,
                .androidVersionNamePointer = @ptrCast([*]const u8, "1.0"),
                .androidVersionNameLength = 3,
                .androidVersionCode = 1,
                .androidMinSdk = 21,
                .androidTargetSdk = 37,
                .androidFullscreen = false,
                .androidExtractNativeLibs = false,
                .androidKeyPointer = @ptrFromInt([*]const u8, 0),
                .hasAndroidKey = false,
                .homePointer = @ptrFromInt([*]const u8, 0),
                .homeLength = 0,
                .invalidOptionPointer = @ptrFromInt([*]const u8, 0),
                .invalidOptionLength = 0,
            }
        }
    }

    fn setCompilerName(options: *Self, argument: process.String) -> void {
        var start: usize = 0
        var index: usize = 0
        while index < argument.length {
            if argument.pointer[index] == 47 { start = index + 1 }
            index += 1
        }
        unsafe { options.*.compilerNamePointer = @ptrFromInt([*]const u8, @intFromPtr(argument.pointer) + start) }
        options.*.compilerNameLength = argument.length - start
    }

    fn isOutputFlag(argument: process.String) -> bool {
        return argument.length == 2 && argument.pointer[0] == 45 && argument.pointer[1] == 111
    }

    fn startsWith(argument: process.String, prefix: []const u8) -> bool {
        const expected = strings.fromSlice(prefix)
        if argument.length < expected.length { return false }
        var index: usize = 0
        while index < expected.length {
            if argument.pointer[index] != expected.pointer[index] { return false }
            index += 1
        }
        return true
    }

    fn equals(argument: process.String, expected: []const u8) -> bool {
        return strings.eql(argument, strings.fromSlice(expected))
    }

    // Shared libraries named with --library, in command-line order.
    pub fn libraryCount(options: Self) -> usize {
        var result: usize = 0
        var index: usize = 1
        while index + 1 < options.argumentCount {
            if Self.isLibraryFlag(options.argumentPointer[index]) {
                result += 1
                index += 1
            }
            index += 1
        }
        return result
    }

    pub fn library(options: Self, wanted: usize) -> [*]const u8 {
        var found: usize = 0
        var index: usize = 1
        while index + 1 < options.argumentCount {
            if Self.isLibraryFlag(options.argumentPointer[index]) {
                if found == wanted { return options.argumentPointer[index + 1] }
                found += 1
                index += 1
            }
            index += 1
        }
        return options.argumentPointer[0]
    }

    fn isLibraryFlag(argument: [*]const u8) -> bool {
        return Self.equals(process.fromCString(argument), "--library")
    }

    // True when the output path ends in ".apk".
    pub fn outputIsApk(options: Self) -> bool {
        var length: usize = 0
        while options.outputPointer[length] != 0 { length += 1 }
        if length < 4 { return false }
        const p = options.outputPointer
        return p[length - 4] == 46 && p[length - 3] == 97 && p[length - 2] == 112 && p[length - 1] == 107
    }

    pub fn stepCount(options: Self) -> usize {
        if !options.hasOutput { return 4 }
        return if options.target == Target.aarch64_android && Self.outputIsApk(options) { 10 } else { 9 }
    }
}
