const process = @import("../../../std/bootstrap/process.mlx")
const io = @import("../../../std/bootstrap/io.mlx")
const time = @import("../../../std/bootstrap/time.mlx")
const modules = @import("../modules.mlx")
const diagnostic = @import("../diagnostic.mlx")

pub const Reporter = struct {
    namePointer: [*]const u8
    nameLength: usize
    showProgress: bool
    traceEnabled: bool
    totalSteps: usize
    activeStep: usize
    stepStarted: usize
    compilationStarted: usize

    pub fn init(name_pointer: [*]const u8, name_length: usize, progress: bool, trace: bool, total: usize) -> Self {
        const now = time.monotonicNanoseconds()
        return Self.{
            .namePointer = name_pointer,
            .nameLength = name_length,
            .showProgress = progress,
            .traceEnabled = trace,
            .totalSteps = total,
            .activeStep = 0,
            .stepStarted = now,
            .compilationStarted = now,
        }
    }

    pub fn progress(reporter: *Self, current: usize, message: []const u8) -> void {
        if !reporter.*.showProgress { return }
        const now = time.monotonicNanoseconds()
        Self.finishActiveStep(reporter, now)
        reporter.*.activeStep = current
        reporter.*.stepStarted = now
        const output = io.stderr()
        Self.writePrefix(reporter)
        io.writeAll(output, " ")
        io.writeUnsigned(output, current)
        io.writeAll(output, "/")
        io.writeUnsigned(output, reporter.*.totalSteps)
        io.writeAll(output, "] ")
        io.writeLine(output, message)
    }

    pub fn finish(reporter: *Self) -> void {
        if !reporter.*.showProgress { return }
        const now = time.monotonicNanoseconds()
        Self.finishActiveStep(reporter, now)
        Self.writePrefix(reporter)
        io.writeAll(io.stderr(), "] total: ")
        Self.writeDuration(time.elapsedNanoseconds(reporter.*.compilationStarted, now))
        io.writeAll(io.stderr(), "\n")
        reporter.*.activeStep = 0
    }

    pub fn failActiveStep(reporter: *Self, error_count: usize) -> void {
        if !reporter.*.showProgress || reporter.*.activeStep == 0 { return }
        const now = time.monotonicNanoseconds()
        Self.writeStepPrefix(reporter)
        io.writeAll(io.stderr(), " failed after ")
        Self.writeDuration(time.elapsedNanoseconds(reporter.*.stepStarted, now))
        io.writeAll(io.stderr(), " (")
        io.writeUnsigned(io.stderr(), error_count)
        if error_count == 1 {
            io.writeAll(io.stderr(), " error)\n")
        } else {
            io.writeAll(io.stderr(), " errors)\n")
        }
        reporter.*.activeStep = 0
    }

    fn finishActiveStep(reporter: *Self, now: usize) -> void {
        if reporter.*.activeStep == 0 { return }
        Self.writeStepPrefix(reporter)
        io.writeAll(io.stderr(), " done in ")
        Self.writeDuration(time.elapsedNanoseconds(reporter.*.stepStarted, now))
        io.writeAll(io.stderr(), "\n")
    }

    fn writeStepPrefix(reporter: *Self) -> void {
        Self.writePrefix(reporter)
        io.writeAll(io.stderr(), " ")
        io.writeUnsigned(io.stderr(), reporter.*.activeStep)
        io.writeAll(io.stderr(), "/")
        io.writeUnsigned(io.stderr(), reporter.*.totalSteps)
        io.writeAll(io.stderr(), "]")
    }

    fn writeDuration(nanoseconds: usize) -> void {
        if nanoseconds >= 1000000000 {
            io.writeUnsigned(io.stderr(), nanoseconds / 1000000000)
            io.writeAll(io.stderr(), ".")
            Self.writeFraction((nanoseconds / 1000000) % 1000)
            io.writeAll(io.stderr(), " s")
            return
        }
        io.writeUnsigned(io.stderr(), nanoseconds / 1000000)
        io.writeAll(io.stderr(), ".")
        Self.writeFraction((nanoseconds / 1000) % 1000)
        io.writeAll(io.stderr(), " ms")
    }

    fn writeFraction(value: usize) -> void {
        if value < 100 { io.writeAll(io.stderr(), "0") }
        if value < 10 { io.writeAll(io.stderr(), "0") }
        io.writeUnsigned(io.stderr(), value)
    }

    fn writePrefix(reporter: *Self) -> void {
        io.writeAll(io.stderr(), "[")
        unsafe { io.writeAll(io.stderr(), reporter.*.namePointer[0..reporter.*.nameLength]) }
    }

    pub fn metric(reporter: *Self, label: []const u8, value: usize) -> void {
        if !reporter.*.showProgress { return }
        Self.writePrefix(reporter)
        io.writeAll(io.stderr(), " info] ")
        io.writeAll(io.stderr(), label)
        io.writeAll(io.stderr(), ": ")
        io.writeUnsigned(io.stderr(), value)
        io.writeAll(io.stderr(), "\n")
    }

    pub fn metricDuration(reporter: *Self, label: []const u8, nanoseconds: usize) -> void {
        if !reporter.*.showProgress { return }
        Self.writePrefix(reporter)
        io.writeAll(io.stderr(), " info] ")
        io.writeAll(io.stderr(), label)
        io.writeAll(io.stderr(), ": ")
        Self.writeDuration(nanoseconds)
        io.writeAll(io.stderr(), "\n")
    }

    pub fn traceValue(reporter: *Self, label: []const u8, value: usize) -> void {
        if !reporter.*.traceEnabled { return }
        const output = io.stderr()
        Self.writePrefix(reporter)
        io.writeAll(output, " trace] ")
        io.writeAll(output, label)
        io.writeUnsigned(output, value)
        io.writeAll(output, "\n")
    }

    pub fn traceString(reporter: *Self, label: []const u8, value: process.String) -> void {
        if !reporter.*.traceEnabled { return }
        const output = io.stderr()
        Self.writePrefix(reporter)
        io.writeAll(output, " trace] ")
        io.writeAll(output, label)
        io.writeString(output, value)
        io.writeAll(output, "\n")
    }

    pub fn traceModules(reporter: *Self, loader: *modules.Loader) -> void {
        if !reporter.*.traceEnabled { return }
        var index: usize = 0
        while index < modules.moduleCount(loader) {
            const value = modules.moduleAt(loader, index)
            Self.writePrefix(reporter)
            io.writeAll(io.stderr(), " trace] module[")
            io.writeUnsigned(io.stderr(), index)
            io.writeAll(io.stderr(), "]: ")
            unsafe { io.writeAll(io.stderr(), value.*.pathPointer[0..value.*.pathLength]) }
            io.writeAll(io.stderr(), "\n")
            index += 1
        }
    }

    pub fn unresolvedSymbol(reporter: *Self, pointer: [*]const u8, length: usize) -> void {
        if !reporter.*.traceEnabled || length == 0 { return }
        Self.writePrefix(reporter)
        io.writeAll(io.stderr(), " trace] unresolved symbol: ")
        unsafe { io.writeAll(io.stderr(), pointer[0..length]) }
        io.writeAll(io.stderr(), "\n")
    }

    pub fn failure(code: diagnostic.Code, phase: diagnostic.Phase, message: []const u8) -> void {
        diagnostic.render(diagnostic.create(code, phase, diagnostic.Severity.failure, 0, 0, 1, message), "", "")
    }

    // Like failure, but for a diagnostic that has no specific byte span
    // (it summarizes an error count across a module) yet can still name
    // the file the caller already identified as responsible.
    pub fn failureIn(code: diagnostic.Code, phase: diagnostic.Phase, message: []const u8, path: []const u8) -> void {
        diagnostic.render(diagnostic.create(code, phase, diagnostic.Severity.failure, 0, 0, 1, message), path, "")
    }

    pub fn failureAt(code: diagnostic.Code, phase: diagnostic.Phase, byte_start: usize, byte_length: usize, message: []const u8, path: []const u8, source: []const u8) -> void {
        const length = if byte_length > 0 { byte_length } else { 1 }
        diagnostic.render(diagnostic.create(code, phase, diagnostic.Severity.failure, 0, byte_start, byte_start + length, message), path, source)
    }
}
