// The `builtin` module (spec/05-build/targets.xml): the target a program
// is compiled for, as Mlx source the loader parses like any module, so
// comptime code asks it (`if comptime builtin.os == builtin.Os.brixos`)
// and the branch for another target is pruned.
const options_module = @import("./options.mlx")

const Options = options_module.Options
const Target = options_module.Target

const CAPACITY: usize = 1024

const HEAD = "// The target the program is compiled for (written by the compiler from\n// --target).\npub const Os = enum(u8) { linux, android, freebsd, windows, brixos, freestanding }\npub const Arch = enum(u8) { x86_64, aarch64 }\npub const Endian = enum(u8) { little, big }\npub const endian: Endian = Endian.little\npub const pointer_bits: usize = 64\n"

// The module's text (per run).
var text: [CAPACITY]u8 = undefined // (per run)
var length: usize = 0 // (per run)

pub const Text = struct {
    pointer: [*]const u8
    length: usize
}

fn append(piece: []const u8) -> void {
    for byte in piece {
        if length < CAPACITY {
            text[length] = byte
            length += 1
        }
    }
}

fn osOf(target: Target) -> []const u8 {
    if target == Target.aarch64_android { return "android" }
    if target == Target.x86_64_brixos { return "brixos" }
    if target == Target.x86_64_freestanding { return "freestanding" }
    return "linux"
}

fn archOf(target: Target) -> []const u8 {
    if target == Target.aarch64_linux || target == Target.aarch64_android { return "aarch64" }
    return "x86_64"
}

// The text for `options`' target.
pub fn write(options: Options) -> Text {
    length = 0
    append(HEAD)
    append("pub const os: Os = Os.")
    append(osOf(options.target))
    append("\npub const arch: Arch = Arch.")
    append(archOf(options.target))
    append("\n// -O0 to -O3.\npub const optimization_level: usize = ")
    const digits = "0123456789"
    append(digits[@intCast(usize, options.optimizationLevel)..@intCast(usize, options.optimizationLevel) + 1])
    append("\npub const runtime_safety: bool = ")
    append(if options.runtimeSafety { "true" } else { "false" })
    append("\n")
    unsafe { return Text.{ .pointer = @ptrCast([*]const u8, &text), .length = length } }
}
