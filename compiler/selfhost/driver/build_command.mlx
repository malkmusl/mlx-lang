// `mlx build [ARGS...]`: runs the build.mlx of the working directory.
//
// build.mlx declares the project (its package() and its build graph in
// build(b)); std.build owns the graph, the cache and the jobs. This command
// only gives that program a main: mlx-out/build/runner.mlx imports
// ../../build.mlx and std.build, is compiled once into mlx-out/build/runner,
// and is then run with --compiler= naming this compiler and the arguments
// after `build`. From then on the runner keeps itself current: it rebuilds
// itself when build.mlx, std.build or the compiler changed (the files this
// compile read are in mlx-out/build/runner.d), so this command compiles
// only when the runner is missing or its source text changed.
const fs = @import("../../../std/bootstrap/fs.mlx")
const linux = @import("../../../std/bootstrap/os/linux.mlx")
const process = @import("../../../std/bootstrap/process.mlx")

const SYS_vfork: usize = 58
const SYS_execve: usize = 59
const SYS_exit: usize = 60
const SYS_wait4: usize = 61
const EEXIST: isize = -17
// Arguments after `build` passed on (the runner's own options and steps).
const MAX_ARGUMENTS: usize = 120

const RUNNER_SOURCE: []const u8 = "// Written by `mlx build`: the build graph of ../../build.mlx, run by std.build.\nconst project = @import(\"../../build.mlx\")\nconst build = @import(\"std.build\")\n\npub fn main(arguments: [][*]const u8) -> u8 { return build.run(arguments, project.package(), project.build) }\n"

fn say(text: []const u8) -> void {
    const ignored = fs.writeAll(fs.File.{ .descriptor = 2 }, text)
}

fn isBuild(argument: process.String) -> bool {
    return argument.length == 5 && argument.pointer[0] == 98 && argument.pointer[1] == 117 && argument.pointer[2] == 105 && argument.pointer[3] == 108 && argument.pointer[4] == 100
}

// Whether the command line asks for `build`.
pub fn requested(arguments: [][*]const u8) -> bool {
    return process.count(arguments) >= 2 && isBuild(process.argument(arguments, 1))
}

fn makeDirectory(path: [*]const u8) -> bool {
    const made = fs.makeDirResult(path, 493)
    return made == 0 || made == EEXIST
}

// Whether the file at `path` holds exactly `text`.
fn holds(path: [*]const u8, text: []const u8) -> bool {
    const file = fs.open(path, fs.READ_ONLY, 0)
    if !fs.isValid(file) { return false }
    var buffer: [4096]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var total: usize = 0
    var same = true
    while same {
        const got = fs.read(file, bytes, 4096)
        if got < 0 { same = false }
        if got <= 0 { break }
        const count = @bitCast(usize, got)
        var index: usize = 0
        while index < count {
            if total + index >= text.length || bytes[index] != text[total + index] { same = false }
            index += 1
        }
        total += count
    }
    const closed = fs.close(file)
    return same && total == text.length
}

fn writeText(path: [*]const u8, text: []const u8) -> bool {
    unsafe { return fs.writeFile(path, @ptrCast([*]const u8, text), text.length, 420) }
}

// Runs `arguments` (a NULL-terminated list whose first entry is the
// program) and waits for it; its exit status, 128 + a signal, or 127 when
// it did not start.
fn runAndWait(arguments: [*][*]const u8, environment: [*][*]const u8) -> u8 {
    const child = linux.syscall0(SYS_vfork)
    if child == 0 {
        const ran = linux.syscall3(SYS_execve, @intFromPtr(arguments[0]), @intFromPtr(arguments), @intFromPtr(environment))
        const exited = linux.syscall1(SYS_exit, 127)
    }
    if child < 0 { return 127 }
    var status: u32 = 0
    while true {
        const waited = linux.syscall4(SYS_wait4, @bitCast(usize, child), @intFromPtr(&status), 0, 0)
        if waited == child { break }
        // Only an interrupted wait (EINTR) waits again.
        if waited != -4 { return 127 }
    }
    if (status & 127) != 0 { return @intCast(u8, 128 + (status & 127)) }
    return @intCast(u8, (status >> 8) & 255)
}

// Appends `text` to buffer at `at` (NUL-terminated after it); the new end.
fn append(buffer: [*]u8, at: usize, capacity: usize, text: []const u8) -> usize {
    var end = at
    var index: usize = 0
    while index < text.length && end + 1 < capacity {
        buffer[end] = text[index]
        end += 1
        index += 1
    }
    buffer[end] = 0
    return end
}

pub fn run(arguments: [][*]const u8) -> u8 {
    unsafe {
        if !fs.exists(@ptrCast([*]const u8, "build.mlx")) {
            say("mlx build: no build.mlx in this directory (run it where build.mlx is)\n")
            return 2
        }
        const count = process.count(arguments)
        if count - 2 > MAX_ARGUMENTS {
            say("mlx build: too many arguments\n")
            return 2
        }
        if !makeDirectory(@ptrCast([*]const u8, "mlx-out")) || !makeDirectory(@ptrCast([*]const u8, "mlx-out/build")) {
            say("mlx build: cannot make mlx-out/build\n")
            return 1
        }
        // This compiler, by an absolute path: the runner compiles with it.
        var self: [4096]u8 = undefined
        var self_bytes: [*]u8 = undefined
        self_bytes = @ptrCast([*]u8, &self)
        const self_length = fs.executablePath(self_bytes, 4096)
        if self_length == 0 {
            say("mlx build: cannot find this compiler (/proc/self/exe)\n")
            return 1
        }
        const environment = process.environmentEntries(arguments)
        const source = @ptrCast([*]const u8, "mlx-out/build/runner.mlx")
        const runner = @ptrCast([*]const u8, "mlx-out/build/runner")
        var fresh = false
        const current = holds(source, RUNNER_SOURCE)
        if !current && !writeText(source, RUNNER_SOURCE) {
            say("mlx build: cannot write mlx-out/build/runner.mlx\n")
            return 1
        }
        if !current || !fs.exists(runner) {
            say("mlx build: compiling build.mlx\n")
            var compile: [8][*]const u8 = undefined
            compile[0] = @ptrCast([*]const u8, &self)
            compile[1] = @ptrCast([*]const u8, "--quiet")
            compile[2] = source
            compile[3] = @ptrCast([*]const u8, "-o")
            compile[4] = runner
            compile[5] = @ptrCast([*]const u8, "--depfile=mlx-out/build/runner.d")
            compile[6] = @ptrFromInt([*]const u8, 0)
            const status = runAndWait(@ptrCast([*][*]const u8, &compile), environment)
            if status != 0 {
                const removed = fs.delete(runner)
                say("mlx build: build.mlx did not compile (above)\n")
                return if status > 1 { status } else { 1 }
            }
            fresh = true
        }
        var compiler_option: [4200]u8 = undefined
        var option_bytes: [*]u8 = undefined
        option_bytes = @ptrCast([*]u8, &compiler_option)
        var end = append(option_bytes, 0, 4200, "--compiler=")
        end = append(option_bytes, end, 4200, self[0..self_length])
        var forwarded: [128][*]const u8 = undefined
        forwarded[0] = runner
        forwarded[1] = @ptrCast([*]const u8, &compiler_option)
        var used: usize = 2
        if fresh {
            forwarded[used] = @ptrCast([*]const u8, "--fresh")
            used += 1
        }
        var index: usize = 2
        while index < count {
            forwarded[used] = arguments[index]
            used += 1
            index += 1
        }
        forwarded[used] = @ptrFromInt([*]const u8, 0)
        const ran = linux.syscall3(SYS_execve, @intFromPtr(runner), @intFromPtr(&forwarded), @intFromPtr(environment))
        say("mlx build: cannot run mlx-out/build/runner\n")
        return 1
    }
}
