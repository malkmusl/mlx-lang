const lexer = @import("../lexer.zin")
const token = @import("../lexer/token.zin")
const store_module = @import("../ast/store.zin")
const node = @import("../ast/node.zin")

pub const Token = token.Token
pub const Kind = token.Kind
pub const Node = node.Node
pub const Tag = node.Tag
pub const Store = store_module.Store
pub const TokenBuffer = lexer.Buffer

pub const Parser = struct {
    source: [*]const u8
    sourceLength: usize
    tokenItems: [*]u8
    tokenLength: usize
    index: usize
    nodes: *Store
    errorCount: usize
    firstErrorToken: usize
}

fn sliceLength(source: []const u8) -> usize {
    var length: usize = 0
    for byte in source { length += 1 }
    return length
}

pub fn init(source: []const u8, tokens: TokenBuffer, nodes: *Store) -> Parser {
    unsafe {
        return Parser.{
            .source = @ptrCast([*]const u8, source),
            .sourceLength = sliceLength(source),
            .tokenItems = tokens.items,
            .tokenLength = tokens.length,
            .index = 0,
            .nodes = nodes,
            .errorCount = 0,
            .firstErrorToken = node.NONE,
        }
    }
}

pub fn tokenAt(parser: *Parser, index: usize) -> Token {
    if index >= parser.*.tokenLength { return token.init(Kind.end_of_file, parser.*.sourceLength, 0) }
    unsafe {
        const address = @intFromPtr(parser.*.tokenItems) + index * @sizeOf(Token)
        return @ptrFromInt(*Token, address).*
    }
}

pub fn current(parser: *Parser) -> Token {
    if parser.*.index >= parser.*.tokenLength { return token.init(Kind.end_of_file, parser.*.sourceLength, 0) }
    return tokenAt(parser, parser.*.index)
}

pub fn previous(parser: *Parser) -> Token {
    if parser.*.index == 0 { return current(parser) }
    return tokenAt(parser, parser.*.index - 1)
}

pub fn isAtEnd(parser: *Parser) -> bool {
    return current(parser).kind == Kind.end_of_file
}

pub fn advance(parser: *Parser) -> usize {
    const token_index = parser.*.index
    if !isAtEnd(parser) { parser.*.index += 1 }
    return token_index
}

pub fn check(parser: *Parser, kind: Kind) -> bool {
    return current(parser).kind == kind
}

pub fn tokenTextEquals(parser: *Parser, index: usize, expected: []const u8) -> bool {
    const value = tokenAt(parser, index)
    var expected_length: usize = 0
    for byte in expected { expected_length += 1 }
    if value.length != expected_length { return false }
    var offset: usize = 0
    while offset < expected_length {
        if parser.*.source[value.start + offset] != expected[offset] { return false }
        offset += 1
    }
    return true
}

pub fn accept(parser: *Parser, kind: Kind) -> bool {
    if !check(parser, kind) { return false }
    advance(parser)
    return true
}

pub fn expect(parser: *Parser, kind: Kind) -> usize {
    if check(parser, kind) { return advance(parser) }
    recordError(parser)
    return node.NONE
}

pub fn recordError(parser: *Parser) -> void {
    if parser.*.errorCount == 0 { parser.*.firstErrorToken = parser.*.index }
    parser.*.errorCount += 1
}

pub fn skipStatementEnds(parser: *Parser) -> void {
    while accept(parser, Kind.statement_end) {}
}

pub fn add(parser: *Parser, value: Node) -> usize {
    return store_module.append(parser.*.nodes, value)
}

pub fn get(parser: *Parser, index: usize) -> Node {
    return store_module.get(parser.*.nodes, index)
}

pub fn set(parser: *Parser, index: usize, value: Node) -> void {
    store_module.set(parser.*.nodes, index, value)
}

pub fn link(parser: *Parser, left: usize, right: usize) -> void {
    store_module.link(parser.*.nodes, left, right)
}

pub fn recoverStatement(parser: *Parser) -> void {
    const start = parser.*.index
    while !isAtEnd(parser) {
        const kind = current(parser).kind
        if kind == Kind.statement_end {
            advance(parser)
            return
        }
        if kind == Kind.right_brace { return }
        advance(parser)
    }
    if parser.*.index == start && !isAtEnd(parser) { advance(parser) }
}
