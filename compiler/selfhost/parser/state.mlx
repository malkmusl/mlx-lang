const lexer = @import("../lexer.mlx")
const token = @import("../lexer/token.mlx")
const store_module = @import("../ast/store.mlx")
const node = @import("../ast/node.mlx")

pub const Token = token.Token
pub const Kind = token.Kind
pub const Node = node.Node
pub const Tag = node.Tag
pub const Store = store_module.Store
pub const TokenBuffer = lexer.Buffer

pub const Parser = struct {
    source: [*]const u8
    sourceLength: usize
    tokenItems: [*]u8
    tokenLength: usize
    index: usize
    nodes: *Store
    errorCount: usize
    firstErrorToken: usize
    parseAggregateDeclaration: fn(parser: *anyopaque) -> usize

    fn rejectAggregateDeclaration(parser: *anyopaque) -> usize {
        return node.NONE
    }

fn sliceLength(source: []const u8) -> usize {
    var length: usize = 0
    for byte in source { length += 1 }
    return length
}

pub fn init(source: []const u8, tokens: TokenBuffer, nodes: *Store) -> Self {
    return Self.initLength(source, Self.sliceLength(source), tokens, nodes)
}

pub fn initLength(source: []const u8, source_length: usize, tokens: TokenBuffer, nodes: *Store) -> Self {
    unsafe {
        return Self.{
            .source = @ptrCast([*]const u8, source),
            .sourceLength = source_length,
            .tokenItems = tokens.items,
            .tokenLength = tokens.length,
            .index = 0,
            .nodes = nodes,
            .errorCount = 0,
            .firstErrorToken = node.NONE,
            .parseAggregateDeclaration = Self.rejectAggregateDeclaration,
        }
    }
}

pub fn tokenAt(parser: *Self, index: usize) -> Token {
    if index >= parser.*.tokenLength { return token.init(Kind.end_of_file, parser.*.sourceLength, 0) }
    unsafe {
        const address = @intFromPtr(parser.*.tokenItems) + index * @sizeOf(Token)
        return @ptrFromInt(*Token, address).*
    }
}

pub fn current(parser: *Self) -> Token {
    if parser.*.index >= parser.*.tokenLength { return token.init(Kind.end_of_file, parser.*.sourceLength, 0) }
    return Self.tokenAt(parser, parser.*.index)
}

pub inline fn kindAt(parser: *Self, index: usize) -> Kind {
    if index >= parser.*.tokenLength { return Kind.end_of_file }
    unsafe {
        const address = @intFromPtr(parser.*.tokenItems) + index * @sizeOf(Token)
        return @ptrFromInt(*Token, address).*.kind
    }
}

pub inline fn currentKind(parser: *Self) -> Kind {
    return Self.kindAt(parser, parser.*.index)
}

pub fn previous(parser: *Self) -> Token {
    if parser.*.index == 0 { return Self.current(parser) }
    return Self.tokenAt(parser, parser.*.index - 1)
}

pub inline fn isAtEnd(parser: *Self) -> bool {
    return Self.currentKind(parser) == Kind.end_of_file
}

pub fn advance(parser: *Self) -> usize {
    const token_index = parser.*.index
    if token_index + 1 < parser.*.tokenLength { parser.*.index += 1 }
    return token_index
}

pub inline fn check(parser: *Self, kind: Kind) -> bool {
    return Self.currentKind(parser) == kind
}

pub fn tokenTextEquals(parser: *Self, index: usize, expected: []const u8) -> bool {
    const value = Self.tokenAt(parser, index)
    var expected_length: usize = 0
    for byte in expected { expected_length += 1 }
    if value.length != expected_length { return false }
    var offset: usize = 0
    while offset < expected_length {
        if parser.*.source[value.start + offset] != expected[offset] { return false }
        offset += 1
    }
    return true
}

pub fn accept(parser: *Self, kind: Kind) -> bool {
    if !Self.check(parser, kind) { return false }
    Self.advance(parser)
    return true
}

pub fn expect(parser: *Self, kind: Kind) -> usize {
    if Self.check(parser, kind) { return Self.advance(parser) }
    Self.recordError(parser)
    return node.NONE
}

pub fn recordError(parser: *Self) -> void {
    if parser.*.errorCount == 0 { parser.*.firstErrorToken = parser.*.index }
    parser.*.errorCount += 1
}

pub fn skipStatementEnds(parser: *Self) -> void {
    while Self.accept(parser, Kind.statement_end) {}
}

pub inline fn add(parser: *Self, value: Node) -> usize {
    return store_module.Store.append(parser.*.nodes, value)
}

pub inline fn get(parser: *Self, index: usize) -> Node {
    return store_module.Store.get(parser.*.nodes, index)
}

pub fn set(parser: *Self, index: usize, value: Node) -> void {
    store_module.Store.set(parser.*.nodes, index, value)
}

pub fn link(parser: *Self, left: usize, right: usize) -> void {
    store_module.Store.link(parser.*.nodes, left, right)
}

pub fn recoverStatement(parser: *Self) -> void {
    const start = parser.*.index
    while !Self.isAtEnd(parser) {
        const kind = Self.currentKind(parser)
        if kind == Kind.statement_end {
            Self.advance(parser)
            return
        }
        if kind == Kind.right_brace { return }
        Self.advance(parser)
    }
    if parser.*.index == start && !Self.isAtEnd(parser) { Self.advance(parser) }
}
}
