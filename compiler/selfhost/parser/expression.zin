const token = @import("../lexer/token.zin")
const node = @import("../ast/node.zin")
const state_module = @import("./state.zin")

pub const Kind = token.Kind
pub const Tag = node.Tag
pub const Node = node.Node
pub const Parser = state_module.Parser

fn leaf(parser: *Parser, tag: Tag) -> usize {
    const token_index = state_module.advance(parser)
    return state_module.add(parser, node.init(tag, token_index))
}

fn appendChild(parser: *Parser, first: usize, last: usize, child: usize) -> (usize, usize) {
    if first == node.NONE { return -> (child, child) }
    state_module.link(parser, last, child)
    return -> (first, child)
}

fn parseList(parser: *Parser, closing: Kind, allow_type_prefixes: bool) -> (usize, usize) {
    var first: usize = node.NONE
    var last: usize = node.NONE
    var count: usize = 0
    while !state_module.check(parser, closing) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        state_module.skipStatementEnds(parser)
        if state_module.check(parser, closing) { break }
        const kind = state_module.current(parser).kind
        const child = if allow_type_prefixes && (kind == Kind.question || kind == Kind.bang) { parseTypeAtom(parser) } else { parse(parser) }
        if child == node.NONE {
            state_module.recoverStatement(parser)
            break
        }
        const linked = appendChild(parser, first, last, child)
        first = linked.0
        last = linked.1
        count += 1
        if !state_module.accept(parser, Kind.comma) {
            state_module.skipStatementEnds(parser)
            break
        }
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    state_module.expect(parser, closing)
    return -> (first, count)
}

fn parseBuiltin(parser: *Parser) -> usize {
    const at_token = state_module.advance(parser)
    const name_token = state_module.expect(parser, Kind.identifier)
    if name_token == node.NONE { return node.NONE }
    var value = node.init(Tag.builtin_call, name_token)
    value.extra = at_token
    if state_module.accept(parser, Kind.left_parenthesis) {
        const arguments = parseList(parser, Kind.right_parenthesis, true)
        value.lhs = arguments.0
        value.rhs = arguments.1
    }
    return state_module.add(parser, value)
}

fn parseTupleOrGroup(parser: *Parser) -> usize {
    const opening = state_module.advance(parser)
    if state_module.accept(parser, Kind.right_parenthesis) {
        return state_module.add(parser, node.init(Tag.tuple_literal, opening))
    }
    const first = parse(parser)
    if first == node.NONE { return node.NONE }
    if !state_module.accept(parser, Kind.comma) {
        state_module.expect(parser, Kind.right_parenthesis)
        return first
    }
    var first_child = first
    var last = first
    var count: usize = 1
    while !state_module.check(parser, Kind.right_parenthesis) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        const child = parse(parser)
        if child == node.NONE { break }
        state_module.link(parser, last, child)
        last = child
        count += 1
        if !state_module.accept(parser, Kind.comma) { break }
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    state_module.expect(parser, Kind.right_parenthesis)
    var value = node.init(Tag.tuple_literal, opening)
    value.lhs = first_child
    value.rhs = count
    return state_module.add(parser, value)
}

fn parseDotLiteral(parser: *Parser) -> usize {
    const dot_token = state_module.advance(parser)
    if state_module.accept(parser, Kind.left_brace) {
        const values = parseList(parser, Kind.right_brace, false)
        var tuple = node.init(Tag.tuple_literal, dot_token)
        tuple.lhs = values.0
        tuple.rhs = values.1
        return state_module.add(parser, tuple)
    }
    const name = state_module.expect(parser, Kind.identifier)
    if name == node.NONE { return node.NONE }
    var value = node.init(Tag.field_expression, name)
    value.extra = dot_token
    return state_module.add(parser, value)
}

fn parseTypeAtom(parser: *Parser) -> usize {
    const kind = state_module.current(parser).kind
    if kind == Kind.identifier || kind == Kind.keyword_type || kind == Kind.keyword_anytype {
        const name_token = state_module.advance(parser)
        var result = state_module.add(parser, node.init(Tag.named_type, name_token))
        while state_module.accept(parser, Kind.dot) {
            const field_token = state_module.expect(parser, Kind.identifier)
            if field_token == node.NONE { return result }
            var field = node.init(Tag.field_expression, field_token)
            field.lhs = result
            result = state_module.add(parser, field)
        }
        return result
    }
    if kind == Kind.asterisk {
        const opening = state_module.advance(parser)
        var flags: usize = 0
        while state_module.check(parser, Kind.keyword_const) || state_module.check(parser, Kind.keyword_volatile) || state_module.check(parser, Kind.keyword_align) {
            if state_module.accept(parser, Kind.keyword_const) { flags = flags | 1 }
            if state_module.accept(parser, Kind.keyword_volatile) { flags = flags | 2 }
            if state_module.accept(parser, Kind.keyword_align) {
                flags = flags | 4
                if state_module.accept(parser, Kind.left_parenthesis) {
                    parse(parser)
                    state_module.expect(parser, Kind.right_parenthesis)
                }
            }
        }
        var value = node.init(Tag.pointer_type, opening)
        value.lhs = parseTypeAtom(parser)
        value.extra = flags
        return state_module.add(parser, value)
    }
    if kind == Kind.question {
        const question_token = state_module.advance(parser)
        var value = node.init(Tag.optional_type, question_token)
        value.lhs = parseTypeAtom(parser)
        return state_module.add(parser, value)
    }
    if kind == Kind.bang {
        const bang_token = state_module.advance(parser)
        var value = node.init(Tag.error_union_type, bang_token)
        value.rhs = parseTypeAtom(parser)
        return state_module.add(parser, value)
    }
    if kind == Kind.left_bracket { return parseArrayLiteral(parser) }
    state_module.recordError(parser)
    return node.NONE
}

fn parseArrayLiteral(parser: *Parser) -> usize {
    const opening = state_module.advance(parser)
    if state_module.accept(parser, Kind.asterisk) {
        state_module.expect(parser, Kind.right_bracket)
        var flags: usize = 0
        if state_module.accept(parser, Kind.colon) {
            parse(parser)
            flags = flags | 4
        }
        if state_module.accept(parser, Kind.keyword_const) { flags = flags | 1 }
        if state_module.accept(parser, Kind.keyword_volatile) { flags = flags | 2 }
        var value = node.init(Tag.many_pointer_type, opening)
        value.lhs = parseTypeAtom(parser)
        value.extra = flags
        return state_module.add(parser, value)
    }
    if state_module.accept(parser, Kind.right_bracket) {
        const is_const = state_module.accept(parser, Kind.keyword_const)
        var value = node.init(Tag.slice_type, opening)
        value.lhs = parseTypeAtom(parser)
        value.extra = if is_const { 1 } else { 0 }
        return state_module.add(parser, value)
    }
    var declared_length: usize = node.NONE
    if !state_module.check(parser, Kind.right_bracket) {
        declared_length = parse(parser)
    }
    state_module.expect(parser, Kind.right_bracket)

    const element_type = parseTypeAtom(parser)
    if !state_module.accept(parser, Kind.left_brace) {
        var value = node.init(Tag.array_type, opening)
        value.lhs = declared_length
        value.rhs = element_type
        return state_module.add(parser, value)
    }
    const values = parseList(parser, Kind.right_brace, false)
    var value = node.init(Tag.array_literal, opening)
    value.lhs = values.0
    value.rhs = values.1
    value.extra = declared_length
    value.endToken = element_type
    return state_module.add(parser, value)
}

fn parseIfExpression(parser: *Parser) -> usize {
    const if_token = state_module.advance(parser)
    const condition = parse(parser)
    state_module.expect(parser, Kind.left_brace)
    state_module.skipStatementEnds(parser)
    const then_value = parse(parser)
    state_module.skipStatementEnds(parser)
    state_module.expect(parser, Kind.right_brace)
    state_module.expect(parser, Kind.keyword_else)
    var else_value: usize = node.NONE
    const nested_if = state_module.check(parser, Kind.keyword_if)
    if nested_if {
        else_value = parseIfExpression(parser)
    }
    if !nested_if {
        state_module.expect(parser, Kind.left_brace)
        state_module.skipStatementEnds(parser)
        else_value = parse(parser)
        state_module.skipStatementEnds(parser)
        state_module.expect(parser, Kind.right_brace)
    }
    var value = node.init(Tag.if_statement, if_token)
    value.lhs = condition
    value.rhs = then_value
    value.extra = else_value
    return state_module.add(parser, value)
}

fn parseMatchExpression(parser: *Parser) -> usize {
    const match_token = state_module.advance(parser)
    const subject = parse(parser)
    state_module.expect(parser, Kind.left_brace)
    state_module.skipStatementEnds(parser)
    var first: usize = node.NONE
    var last: usize = node.NONE
    var count: usize = 0
    while !state_module.check(parser, Kind.right_brace) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        const pattern = if state_module.accept(parser, Kind.keyword_else) { node.NONE } else { parse(parser) }
        const arrow_token = state_module.expect(parser, Kind.arrow)
        const arm_value = parse(parser)
        var arm = node.init(Tag.binary_expression, arrow_token)
        arm.lhs = pattern
        arm.rhs = arm_value
        const arm_node = state_module.add(parser, arm)
        const linked = appendChild(parser, first, last, arm_node)
        first = linked.0
        last = linked.1
        count += 1
        state_module.accept(parser, Kind.comma)
        state_module.skipStatementEnds(parser)
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    state_module.expect(parser, Kind.right_brace)
    var value = node.init(Tag.match_statement, match_token)
    value.lhs = subject
    value.rhs = first
    value.extra = count
    return state_module.add(parser, value)
}

fn parsePrimary(parser: *Parser) -> usize {
    const kind = state_module.current(parser).kind
    if kind == Kind.identifier { return leaf(parser, Tag.identifier) }
    if kind == Kind.integer { return leaf(parser, Tag.integer_literal) }
    if kind == Kind.float { return leaf(parser, Tag.float_literal) }
    if kind == Kind.string { return leaf(parser, Tag.string_literal) }
    if kind == Kind.byte_string { return leaf(parser, Tag.byte_string_literal) }
    if kind == Kind.character { return leaf(parser, Tag.character_literal) }
    if kind == Kind.keyword_true || kind == Kind.keyword_false { return leaf(parser, Tag.boolean_literal) }
    if kind == Kind.keyword_null { return leaf(parser, Tag.null_literal) }
    if kind == Kind.keyword_undefined { return leaf(parser, Tag.undefined_literal) }
    if kind == Kind.at { return parseBuiltin(parser) }
    if kind == Kind.keyword_if { return parseIfExpression(parser) }
    if kind == Kind.keyword_match { return parseMatchExpression(parser) }
    if kind == Kind.left_parenthesis { return parseTupleOrGroup(parser) }
    if kind == Kind.dot { return parseDotLiteral(parser) }
    if kind == Kind.asterisk { return parseTypeAtom(parser) }
    if kind == Kind.left_bracket { return parseArrayLiteral(parser) }
    state_module.recordError(parser)
    return node.NONE
}

fn isPrefix(kind: Kind) -> bool {
    return kind == Kind.bang || kind == Kind.minus || kind == Kind.tilde || kind == Kind.ampersand || kind == Kind.keyword_try || kind == Kind.keyword_comptime
}

fn parsePrefix(parser: *Parser) -> usize {
    if isPrefix(state_module.current(parser).kind) {
        const operator_token = state_module.advance(parser)
        const operand = parsePrefix(parser)
        if operand == node.NONE { return node.NONE }
        var value = node.init(Tag.unary_expression, operator_token)
        value.lhs = operand
        return state_module.add(parser, value)
    }
    return parsePrimary(parser)
}

fn parseAggregateSuffix(parser: *Parser, base: usize, dot_token: usize) -> usize {
    state_module.advance(parser)
    var first: usize = node.NONE
    var last: usize = node.NONE
    var count: usize = 0
    state_module.skipStatementEnds(parser)
    while !state_module.check(parser, Kind.right_brace) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        const field_dot = state_module.expect(parser, Kind.dot)
        const field_name = state_module.expect(parser, Kind.identifier)
        state_module.expect(parser, Kind.equal)
        const field_value = parse(parser)
        if field_dot == node.NONE || field_name == node.NONE || field_value == node.NONE { break }
        var field = node.init(Tag.field_declaration, field_name)
        field.rhs = field_value
        const field_node = state_module.add(parser, field)
        const linked = appendChild(parser, first, last, field_node)
        first = linked.0
        last = linked.1
        count += 1
        state_module.accept(parser, Kind.comma)
        state_module.skipStatementEnds(parser)
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    state_module.expect(parser, Kind.right_brace)
    var value = node.init(Tag.aggregate_literal, dot_token)
    value.lhs = base
    value.rhs = first
    value.extra = count
    return state_module.add(parser, value)
}

fn parsePostfix(parser: *Parser, initial: usize) -> usize {
    var result = initial
    while true {
        if state_module.accept(parser, Kind.left_parenthesis) {
            const opening = parser.*.index - 1
            const arguments = parseList(parser, Kind.right_parenthesis, false)
            var call = node.init(Tag.call_expression, opening)
            call.lhs = result
            call.rhs = arguments.0
            call.extra = arguments.1
            result = state_module.add(parser, call)
            continue
        }
        if state_module.accept(parser, Kind.left_bracket) {
            const opening = parser.*.index - 1
            var start: usize = node.NONE
            var end: usize = node.NONE
            if !state_module.check(parser, Kind.dot_dot) && !state_module.check(parser, Kind.right_bracket) { start = parsePrecedence(parser, 3) }
            if state_module.accept(parser, Kind.dot_dot) {
                if !state_module.check(parser, Kind.right_bracket) { end = parsePrecedence(parser, 3) }
                state_module.expect(parser, Kind.right_bracket)
                var slice = node.init(Tag.slice_expression, opening)
                slice.lhs = result
                slice.rhs = start
                slice.extra = end
                result = state_module.add(parser, slice)
            } else {
                state_module.expect(parser, Kind.right_bracket)
                var access = node.init(Tag.index_expression, opening)
                access.lhs = result
                access.rhs = start
                result = state_module.add(parser, access)
            }
            continue
        }
        if state_module.check(parser, Kind.dot) {
            const dot_token = state_module.advance(parser)
            if state_module.check(parser, Kind.left_brace) {
                result = parseAggregateSuffix(parser, result, dot_token)
                continue
            }
            const field_token = if state_module.check(parser, Kind.identifier) || state_module.check(parser, Kind.integer) { state_module.advance(parser) } else { node.NONE }
            if field_token == node.NONE {
                state_module.recordError(parser)
                return result
            }
            var field = node.init(Tag.field_expression, field_token)
            field.lhs = result
            field.extra = dot_token
            result = state_module.add(parser, field)
            continue
        }
        if state_module.accept(parser, Kind.dot_asterisk) || state_module.accept(parser, Kind.dot_question) {
            const operator_token = parser.*.index - 1
            var suffix = node.init(Tag.unary_expression, operator_token)
            suffix.lhs = result
            result = state_module.add(parser, suffix)
            continue
        }
        break
    }
    return result
}

fn bindingPower(kind: Kind) -> usize {
    if kind >= Kind.equal && kind <= Kind.asterisk_pipe_shift_right_equal { return 1 }
    if kind == Kind.dot_dot { return 2 }
    if kind == Kind.pipe_pipe { return 3 }
    if kind == Kind.ampersand_ampersand { return 4 }
    if kind == Kind.equal_equal || kind == Kind.bang_equal || kind == Kind.less || kind == Kind.less_equal || kind == Kind.greater || kind == Kind.greater_equal { return 5 }
    if kind == Kind.pipe { return 6 }
    if kind == Kind.caret { return 7 }
    if kind == Kind.ampersand { return 8 }
    if kind >= Kind.shift_left && kind <= Kind.shift_right_caret { return 9 }
    if kind == Kind.plus || kind == Kind.minus || kind == Kind.plus_percent || kind == Kind.minus_percent || kind == Kind.plus_pipe || kind == Kind.minus_pipe { return 10 }
    if kind == Kind.asterisk || kind == Kind.slash || kind == Kind.percent || kind == Kind.asterisk_percent || kind == Kind.asterisk_pipe { return 11 }
    return 0
}

fn parsePrecedence(parser: *Parser, minimum: usize) -> usize {
    var left = parsePostfix(parser, parsePrefix(parser))
    if left == node.NONE { return node.NONE }
    while true {
        const kind = state_module.current(parser).kind
        const power = bindingPower(kind)
        if power == 0 || power < minimum { break }
        const operator_token = state_module.advance(parser)
        const right_minimum = if power == 1 { power } else { power + 1 }
        const right = parsePrecedence(parser, right_minimum)
        if right == node.NONE { return node.NONE }
        var value = node.init(if kind == Kind.dot_dot { Tag.range_expression } else { Tag.binary_expression }, operator_token)
        value.lhs = left
        value.rhs = right
        left = state_module.add(parser, value)
    }
    return left
}

pub fn parse(parser: *Parser) -> usize {
    return parsePrecedence(parser, 1)
}
