const token = @import("../lexer/token.zin")
const node = @import("../ast/node.zin")
const state_module = @import("./state.zin")
const expression = @import("./expression.zin")
const type_parser = @import("./type.zin")

pub const Kind = token.Kind
pub const Tag = node.Tag
pub const Parser = state_module.Parser

fn appendNode(parser: *Parser, first: usize, last: usize, child: usize) -> (usize, usize) {
    if first == node.NONE { return -> (child, child) }
    state_module.link(parser, last, child)
    return -> (first, child)
}

fn isModifier(kind: Kind) -> bool {
    return kind == Kind.keyword_pub || kind == Kind.keyword_export || kind == Kind.keyword_inline || kind == Kind.keyword_noinline || kind == Kind.keyword_extern
}

fn skipModifiers(parser: *Parser) -> usize {
    var flags: usize = 0
    while isModifier(state_module.current(parser).kind) {
        const kind = state_module.current(parser).kind
        if kind == Kind.keyword_pub { flags = flags | 1 }
        if kind == Kind.keyword_export { flags = flags | 2 }
        if kind == Kind.keyword_inline { flags = flags | 4 }
        if kind == Kind.keyword_noinline { flags = flags | 8 }
        if kind == Kind.keyword_extern { flags = flags | 16 }
        state_module.advance(parser)
        if kind == Kind.keyword_extern && state_module.accept(parser, Kind.left_parenthesis) {
            if state_module.check(parser, Kind.string) { state_module.advance(parser) }
            state_module.expect(parser, Kind.right_parenthesis)
        }
    }
    return flags
}

fn isTypeValueStart(kind: Kind) -> bool {
    return kind == Kind.keyword_fn || kind == Kind.keyword_struct || kind == Kind.keyword_enum || kind == Kind.keyword_union || kind == Kind.keyword_error || kind == Kind.keyword_packed || kind == Kind.keyword_extern
}

fn isLabeledLoopStart(parser: *Parser) -> bool {
    if !state_module.check(parser, Kind.identifier) { return false }
    if state_module.tokenAt(parser, parser.*.index + 1).kind != Kind.colon { return false }
    const loop_kind = state_module.tokenAt(parser, parser.*.index + 2).kind
    return loop_kind == Kind.keyword_while || loop_kind == Kind.keyword_for
}

fn parseBinding(parser: *Parser, is_constant: bool, flags: usize) -> usize {
    const keyword_token = state_module.advance(parser)
    const name_token = state_module.expect(parser, Kind.identifier)
    if name_token == node.NONE { return node.NONE }
    var annotation: usize = node.NONE
    if state_module.accept(parser, Kind.colon) { annotation = type_parser.parse(parser) }
    state_module.expect(parser, Kind.equal)
    const type_value = isTypeValueStart(state_module.current(parser).kind) || (state_module.check(parser, Kind.at) && state_module.tokenTextEquals(parser, parser.*.index + 1, "nocopy"))
    const labeled_loop = isLabeledLoopStart(parser)
    const while_loop = state_module.check(parser, Kind.keyword_while)
    var initializer: usize = node.NONE
    if type_value { initializer = type_parser.parse(parser) }
    if !type_value && labeled_loop { initializer = parseLabeledLoop(parser) }
    if !type_value && !labeled_loop && while_loop { initializer = parseWhile(parser, node.NONE, false) }
    if initializer == node.NONE { initializer = expression.parse(parser) }
    var value = node.init(if is_constant { Tag.constant_declaration } else { Tag.variable_declaration }, keyword_token)
    value.mainToken = name_token
    value.lhs = annotation
    value.rhs = initializer
    value.extra = flags
    return state_module.add(parser, value)
}

fn parseParameter(parser: *Parser) -> usize {
    const is_comptime = state_module.accept(parser, Kind.keyword_comptime)
    const name_token = state_module.expect(parser, Kind.identifier)
    if name_token == node.NONE { return node.NONE }
    state_module.expect(parser, Kind.colon)
    const parameter_type = if state_module.accept(parser, Kind.keyword_anytype) { node.NONE } else { type_parser.parse(parser) }
    var value = node.init(Tag.parameter_declaration, name_token)
    value.lhs = parameter_type
    value.extra = if is_comptime { 1 } else { 0 }
    return state_module.add(parser, value)
}

fn parseFunction(parser: *Parser, flags: usize) -> usize {
    const function_token = state_module.advance(parser)
    const name_token = state_module.expect(parser, Kind.identifier)
    if name_token == node.NONE { return node.NONE }
    state_module.expect(parser, Kind.left_parenthesis)
    var first_parameter: usize = node.NONE
    var last_parameter: usize = node.NONE
    var parameter_count: usize = 0
    while !state_module.check(parser, Kind.right_parenthesis) && !state_module.isAtEnd(parser) {
        const parameter = parseParameter(parser)
        if parameter == node.NONE { break }
        const linked = appendNode(parser, first_parameter, last_parameter, parameter)
        first_parameter = linked.0
        last_parameter = linked.1
        parameter_count += 1
        if !state_module.accept(parser, Kind.comma) { break }
    }
    state_module.expect(parser, Kind.right_parenthesis)
    // Canonical Zin uses `->`; accept the adjacent Stage-0 spelling while the
    // bootstrap corpus is migrated.
    state_module.accept(parser, Kind.arrow)
    const return_type = type_parser.parse(parser)
    var body: usize = node.NONE
    if state_module.check(parser, Kind.left_brace) { body = parseBlock(parser) }
    var value = node.init(Tag.function_declaration, name_token)
    value.endToken = function_token
    value.lhs = first_parameter
    value.rhs = body
    value.extra = return_type
    // Parameter count and flags share independent bit ranges.
    value.endToken = parameter_count | (flags << 32)
    return state_module.add(parser, value)
}

fn parseTest(parser: *Parser, flags: usize) -> usize {
    const test_token = state_module.advance(parser)
    const name_token = state_module.expect(parser, Kind.string)
    const body = parseBlock(parser)
    var value = node.init(Tag.test_declaration, test_token)
    value.endToken = name_token
    value.rhs = body
    value.extra = flags
    return state_module.add(parser, value)
}

pub fn parseDeclaration(parser: *Parser) -> usize {
    const flags = skipModifiers(parser)
    if state_module.accept(parser, Kind.keyword_threadlocal) {
        return parseBinding(parser, false, flags | 32)
    }
    const kind = state_module.current(parser).kind
    if kind == Kind.keyword_const { return parseBinding(parser, true, flags) }
    if kind == Kind.keyword_var { return parseBinding(parser, false, flags) }
    if kind == Kind.keyword_fn { return parseFunction(parser, flags) }
    if kind == Kind.keyword_test { return parseTest(parser, flags) }
    state_module.recordError(parser)
    return node.NONE
}

fn parseIf(parser: *Parser) -> usize {
    const if_token = state_module.advance(parser)
    const condition = expression.parse(parser)
    if state_module.accept(parser, Kind.pipe) {
        while !state_module.check(parser, Kind.pipe) && !state_module.isAtEnd(parser) { state_module.advance(parser) }
        state_module.expect(parser, Kind.pipe)
    }
    const then_block = parseBlock(parser)
    var else_block: usize = node.NONE
    if state_module.accept(parser, Kind.keyword_else) {
        if state_module.check(parser, Kind.keyword_if) { else_block = parseIf(parser) } else { else_block = parseBlock(parser) }
    }
    var value = node.init(Tag.if_statement, if_token)
    value.lhs = condition
    value.rhs = then_block
    value.extra = else_block
    return state_module.add(parser, value)
}

fn parseWhile(parser: *Parser, label_token: usize, is_inline: bool) -> usize {
    const while_token = state_module.advance(parser)
    const condition = expression.parse(parser)
    var update: usize = node.NONE
    if state_module.accept(parser, Kind.colon) {
        state_module.expect(parser, Kind.left_parenthesis)
        update = expression.parse(parser)
        state_module.expect(parser, Kind.right_parenthesis)
    }
    const body = parseBlock(parser)
    var value = node.init(if is_inline { Tag.inline_while_statement } else { Tag.while_statement }, while_token)
    value.endToken = label_token
    value.lhs = condition
    value.rhs = body
    value.extra = update
    return state_module.add(parser, value)
}

fn parseFor(parser: *Parser, label_token: usize, is_inline: bool) -> usize {
    const for_token = state_module.advance(parser)
    const pointer_capture = state_module.accept(parser, Kind.asterisk)
    const item_token = state_module.expect(parser, Kind.identifier)
    var index_token: usize = node.NONE
    if state_module.accept(parser, Kind.comma) { index_token = state_module.expect(parser, Kind.identifier) }
    state_module.expect(parser, Kind.keyword_in)
    const iterable = expression.parse(parser)
    const body = parseBlock(parser)
    var capture = node.init(Tag.capture, item_token)
    capture.endToken = index_token
    capture.extra = if pointer_capture { 1 } else { 0 }
    const capture_node = state_module.add(parser, capture)
    var value = node.init(if is_inline { Tag.inline_for_statement } else { Tag.for_statement }, for_token)
    value.endToken = label_token
    value.lhs = iterable
    value.rhs = body
    value.extra = capture_node
    return state_module.add(parser, value)
}

fn parseLabeledLoop(parser: *Parser) -> usize {
    const label_token = state_module.advance(parser)
    state_module.expect(parser, Kind.colon)
    if state_module.check(parser, Kind.keyword_while) { return parseWhile(parser, label_token, false) }
    if state_module.check(parser, Kind.keyword_for) { return parseFor(parser, label_token, false) }
    state_module.recordError(parser)
    return node.NONE
}

fn parseMatch(parser: *Parser) -> usize {
    const match_token = state_module.advance(parser)
    const subject = expression.parse(parser)
    state_module.expect(parser, Kind.left_brace)
    state_module.skipStatementEnds(parser)
    var first_arm: usize = node.NONE
    var last_arm: usize = node.NONE
    var count: usize = 0
    while !state_module.check(parser, Kind.right_brace) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        const pattern = if state_module.accept(parser, Kind.keyword_else) { node.NONE } else { expression.parse(parser) }
        const arrow_token = state_module.expect(parser, Kind.arrow)
        const arm_value = if state_module.check(parser, Kind.left_brace) { parseBlock(parser) } else { expression.parse(parser) }
        var arm = node.init(Tag.binary_expression, arrow_token)
        arm.lhs = pattern
        arm.rhs = arm_value
        const arm_node = state_module.add(parser, arm)
        const linked = appendNode(parser, first_arm, last_arm, arm_node)
        first_arm = linked.0
        last_arm = linked.1
        count += 1
        state_module.accept(parser, Kind.comma)
        state_module.skipStatementEnds(parser)
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    state_module.expect(parser, Kind.right_brace)
    var value = node.init(Tag.match_statement, match_token)
    value.lhs = subject
    value.rhs = first_arm
    value.extra = count
    return state_module.add(parser, value)
}

fn parseReturn(parser: *Parser) -> usize {
    const return_token = state_module.advance(parser)
    state_module.accept(parser, Kind.arrow)
    var result: usize = node.NONE
    if !state_module.check(parser, Kind.statement_end) && !state_module.check(parser, Kind.right_brace) && !state_module.isAtEnd(parser) {
        if isLabeledLoopStart(parser) { result = parseLabeledLoop(parser) }
        if result == node.NONE && state_module.check(parser, Kind.keyword_while) { result = parseWhile(parser, node.NONE, false) }
        if result == node.NONE { result = expression.parse(parser) }
    }
    var value = node.init(Tag.return_statement, return_token)
    value.rhs = result
    return state_module.add(parser, value)
}

fn parseBreakOrContinue(parser: *Parser, is_break: bool) -> usize {
    const keyword_token = state_module.advance(parser)
    var label: usize = node.NONE
    if state_module.accept(parser, Kind.colon) { label = state_module.expect(parser, Kind.identifier) }
    var result: usize = node.NONE
    if is_break && !state_module.check(parser, Kind.statement_end) && !state_module.check(parser, Kind.right_brace) {
        result = expression.parse(parser)
    }
    var value = node.init(if is_break { Tag.break_statement } else { Tag.continue_statement }, keyword_token)
    value.lhs = label
    value.rhs = result
    return state_module.add(parser, value)
}

fn parseDeferred(parser: *Parser, is_error: bool) -> usize {
    const keyword_token = state_module.advance(parser)
    const child = if state_module.check(parser, Kind.left_brace) { parseBlock(parser) } else { expression.parse(parser) }
    var value = node.init(if is_error { Tag.error_defer_statement } else { Tag.defer_statement }, keyword_token)
    value.lhs = child
    return state_module.add(parser, value)
}

pub fn parseStatement(parser: *Parser) -> usize {
    const kind = state_module.current(parser).kind
    if isLabeledLoopStart(parser) { return parseLabeledLoop(parser) }
    if kind == Kind.keyword_inline && state_module.tokenAt(parser, parser.*.index + 1).kind == Kind.keyword_while {
        state_module.advance(parser)
        return parseWhile(parser, node.NONE, true)
    }
    if kind == Kind.keyword_inline && state_module.tokenAt(parser, parser.*.index + 1).kind == Kind.keyword_for {
        state_module.advance(parser)
        return parseFor(parser, node.NONE, true)
    }
    if isModifier(kind) || kind == Kind.keyword_const || kind == Kind.keyword_var || kind == Kind.keyword_threadlocal || kind == Kind.keyword_fn { return parseDeclaration(parser) }
    if kind == Kind.keyword_if { return parseIf(parser) }
    if kind == Kind.keyword_while { return parseWhile(parser, node.NONE, false) }
    if kind == Kind.keyword_for { return parseFor(parser, node.NONE, false) }
    if kind == Kind.keyword_match { return parseMatch(parser) }
    if kind == Kind.keyword_return { return parseReturn(parser) }
    if kind == Kind.keyword_break { return parseBreakOrContinue(parser, true) }
    if kind == Kind.keyword_continue { return parseBreakOrContinue(parser, false) }
    if kind == Kind.keyword_defer { return parseDeferred(parser, false) }
    if kind == Kind.keyword_errdefer { return parseDeferred(parser, true) }
    if kind == Kind.keyword_unsafe || (kind == Kind.keyword_comptime && state_module.tokenAt(parser, parser.*.index + 1).kind == Kind.left_brace) {
        const keyword_token = state_module.advance(parser)
        const body = parseBlock(parser)
        var value = node.init(if kind == Kind.keyword_unsafe { Tag.unsafe_block } else { Tag.comptime_block }, keyword_token)
        value.lhs = body
        return state_module.add(parser, value)
    }
    if kind == Kind.left_brace { return parseBlock(parser) }
    return expression.parse(parser)
}

pub fn parseBlock(parser: *Parser) -> usize {
    const opening = state_module.expect(parser, Kind.left_brace)
    if opening == node.NONE { return node.NONE }
    state_module.skipStatementEnds(parser)
    var first: usize = node.NONE
    var last: usize = node.NONE
    var count: usize = 0
    while !state_module.check(parser, Kind.right_brace) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        const statement = parseStatement(parser)
        if statement == node.NONE {
            state_module.recoverStatement(parser)
        } else {
            const linked = appendNode(parser, first, last, statement)
            first = linked.0
            last = linked.1
            count += 1
        }
        state_module.skipStatementEnds(parser)
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    const closing = state_module.expect(parser, Kind.right_brace)
    var value = node.init(Tag.block, opening)
    value.endToken = closing
    value.lhs = first
    value.rhs = count
    return state_module.add(parser, value)
}

pub fn parseSource(parser: *Parser) -> usize {
    state_module.skipStatementEnds(parser)
    var first: usize = node.NONE
    var last: usize = node.NONE
    var count: usize = 0
    while !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        const declaration = parseDeclaration(parser)
        if declaration == node.NONE {
            state_module.recoverStatement(parser)
        } else {
            const linked = appendNode(parser, first, last, declaration)
            first = linked.0
            last = linked.1
            count += 1
        }
        state_module.skipStatementEnds(parser)
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    var root = node.init(Tag.root, 0)
    root.lhs = first
    root.rhs = count
    root.extra = parser.*.errorCount
    return state_module.add(parser, root)
}
