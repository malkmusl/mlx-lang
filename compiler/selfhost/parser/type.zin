const token = @import("../lexer/token.zin")
const node = @import("../ast/node.zin")
const state_module = @import("./state.zin")
const expression = @import("./expression.zin")

pub const Kind = token.Kind
pub const Tag = node.Tag
pub const Parser = state_module.Parser

fn isNamedTypeStart(kind: Kind) -> bool {
    return kind == Kind.identifier || kind == Kind.keyword_type || kind == Kind.keyword_anytype
}

fn parseNamed(parser: *Parser) -> usize {
    const name_token = state_module.advance(parser)
    var result = state_module.add(parser, node.init(Tag.named_type, name_token))
    while state_module.accept(parser, Kind.dot) {
        const field_token = state_module.expect(parser, Kind.identifier)
        if field_token == node.NONE { return result }
        var field = node.init(Tag.field_expression, field_token)
        field.lhs = result
        result = state_module.add(parser, field)
    }
    if state_module.accept(parser, Kind.bang) {
        const operator_token = parser.*.index - 1
        const payload = parse(parser)
        var value = node.init(Tag.error_union_type, operator_token)
        value.lhs = result
        value.rhs = payload
        return state_module.add(parser, value)
    }
    return result
}

fn parsePointer(parser: *Parser) -> usize {
    const opening = state_module.advance(parser)
    var flags: usize = 0
    while state_module.check(parser, Kind.keyword_const) || state_module.check(parser, Kind.keyword_volatile) || state_module.check(parser, Kind.keyword_align) {
        if state_module.accept(parser, Kind.keyword_const) { flags = flags | 1 }
        if state_module.accept(parser, Kind.keyword_volatile) { flags = flags | 2 }
        if state_module.accept(parser, Kind.keyword_align) {
            flags = flags | 4
            if state_module.accept(parser, Kind.left_parenthesis) {
                expression.parse(parser)
                state_module.expect(parser, Kind.right_parenthesis)
            }
        }
    }
    const child = parse(parser)
    var value = node.init(Tag.pointer_type, opening)
    value.lhs = child
    value.extra = flags
    return state_module.add(parser, value)
}

fn parseBracketType(parser: *Parser) -> usize {
    const opening = state_module.advance(parser)
    if state_module.accept(parser, Kind.asterisk) {
        state_module.expect(parser, Kind.right_bracket)
        var flags: usize = 0
        if state_module.accept(parser, Kind.colon) {
            expression.parse(parser)
            flags = flags | 2
        }
        if state_module.accept(parser, Kind.keyword_const) { flags = flags | 1 }
        const child = parse(parser)
        var value = node.init(Tag.many_pointer_type, opening)
        value.lhs = child
        value.extra = flags
        return state_module.add(parser, value)
    }
    if state_module.accept(parser, Kind.right_bracket) {
        const is_const = state_module.accept(parser, Kind.keyword_const)
        const child = parse(parser)
        var value = node.init(Tag.slice_type, opening)
        value.lhs = child
        value.extra = if is_const { 1 } else { 0 }
        return state_module.add(parser, value)
    }
    const length = expression.parse(parser)
    var sentinel: usize = node.NONE
    if state_module.accept(parser, Kind.colon) { sentinel = expression.parse(parser) }
    state_module.expect(parser, Kind.right_bracket)
    const child = parse(parser)
    var value = node.init(Tag.array_type, opening)
    value.lhs = length
    value.rhs = child
    value.extra = sentinel
    return state_module.add(parser, value)
}

fn parseFunctionType(parser: *Parser) -> usize {
    const function_token = state_module.advance(parser)
    state_module.expect(parser, Kind.left_parenthesis)
    var first: usize = node.NONE
    var last: usize = node.NONE
    var count: usize = 0
    while !state_module.check(parser, Kind.right_parenthesis) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        // Function aliases in bootstrap code retain parameter names.
        if state_module.check(parser, Kind.identifier) && state_module.tokenAt(parser, parser.*.index + 1).kind == Kind.colon {
            state_module.advance(parser)
            state_module.advance(parser)
        }
        const parameter_type = parse(parser)
        if parameter_type == node.NONE { break }
        if first == node.NONE { first = parameter_type } else { state_module.link(parser, last, parameter_type) }
        last = parameter_type
        count += 1
        if !state_module.accept(parser, Kind.comma) { break }
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    state_module.expect(parser, Kind.right_parenthesis)
    state_module.accept(parser, Kind.arrow)
    const return_type = parse(parser)
    var value = node.init(Tag.function_type, function_token)
    value.lhs = first
    value.rhs = count
    value.extra = return_type
    return state_module.add(parser, value)
}

fn parseTupleType(parser: *Parser) -> usize {
    const opening = state_module.advance(parser)
    var first: usize = node.NONE
    var last: usize = node.NONE
    var count: usize = 0
    while !state_module.check(parser, Kind.right_parenthesis) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        const child = parse(parser)
        if child == node.NONE { break }
        if first == node.NONE { first = child } else { state_module.link(parser, last, child) }
        last = child
        count += 1
        if !state_module.accept(parser, Kind.comma) { break }
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    state_module.expect(parser, Kind.right_parenthesis)
    var value = node.init(Tag.tuple_type, opening)
    value.lhs = first
    value.rhs = count
    return state_module.add(parser, value)
}

fn parseAggregateHeader(parser: *Parser, aggregate_tag: Tag) -> (usize, usize) {
    const aggregate_token = state_module.advance(parser)
    var backing: usize = node.NONE
    if state_module.accept(parser, Kind.left_parenthesis) {
        if aggregate_tag == Tag.union_type && state_module.check(parser, Kind.keyword_enum) {
            const enum_token = state_module.advance(parser)
            var enum_backing: usize = node.NONE
            if state_module.accept(parser, Kind.left_parenthesis) {
                if !state_module.check(parser, Kind.right_parenthesis) { enum_backing = parse(parser) }
                state_module.expect(parser, Kind.right_parenthesis)
            }
            var enum_value = node.init(Tag.enum_type, enum_token)
            enum_value.extra = enum_backing
            backing = state_module.add(parser, enum_value)
        } else {
            if !state_module.check(parser, Kind.right_parenthesis) { backing = parse(parser) }
        }
        while !state_module.check(parser, Kind.right_parenthesis) && !state_module.isAtEnd(parser) { state_module.advance(parser) }
        state_module.expect(parser, Kind.right_parenthesis)
    }
    return -> (aggregate_token, backing)
}

fn parseAggregateBody(parser: *Parser, aggregate_tag: Tag, aggregate_token: usize, backing: usize) -> usize {
    state_module.expect(parser, Kind.left_brace)
    state_module.skipStatementEnds(parser)
    var first: usize = node.NONE
    var last: usize = node.NONE
    var count: usize = 0
    while !state_module.check(parser, Kind.right_brace) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        state_module.accept(parser, Kind.keyword_pub)
        if state_module.check(parser, Kind.keyword_fn) || state_module.check(parser, Kind.keyword_const) || state_module.check(parser, Kind.keyword_var) {
            // Members with bodies are parsed by the declaration layer later;
            // keep recovery bounded to this aggregate.
            state_module.recoverStatement(parser)
            state_module.skipStatementEnds(parser)
            continue
        }
        const name_token = state_module.expect(parser, Kind.identifier)
        if name_token == node.NONE {
            state_module.recoverStatement(parser)
            state_module.skipStatementEnds(parser)
            continue
        }
        var member_tag = Tag.field_declaration
        if aggregate_tag == Tag.enum_type { member_tag = Tag.enum_member }
        if aggregate_tag == Tag.union_type { member_tag = Tag.union_member }
        var member = node.init(member_tag, name_token)
        if state_module.accept(parser, Kind.colon) { member.lhs = parse(parser) }
        if state_module.accept(parser, Kind.equal) { member.rhs = expression.parse(parser) }
        const member_index = state_module.add(parser, member)
        if first == node.NONE { first = member_index } else { state_module.link(parser, last, member_index) }
        last = member_index
        count += 1
        state_module.accept(parser, Kind.comma)
        state_module.skipStatementEnds(parser)
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    state_module.expect(parser, Kind.right_brace)
    var value = node.init(aggregate_tag, aggregate_token)
    value.lhs = first
    value.rhs = count
    value.extra = backing
    return state_module.add(parser, value)
}

fn parseAggregate(parser: *Parser, aggregate_tag: Tag) -> usize {
    const header = parseAggregateHeader(parser, aggregate_tag)
    return parseAggregateBody(parser, aggregate_tag, header.0, header.1)
}

fn parseNoCopy(parser: *Parser) -> usize {
    const at_token = state_module.advance(parser)
    const name_token = state_module.expect(parser, Kind.identifier)
    state_module.expect(parser, Kind.left_parenthesis)
    while state_module.check(parser, Kind.keyword_packed) || state_module.check(parser, Kind.keyword_extern) { state_module.advance(parser) }
    var child: usize = node.NONE
    const kind = state_module.current(parser).kind
    const is_aggregate = kind == Kind.keyword_struct || kind == Kind.keyword_enum || kind == Kind.keyword_union
    if is_aggregate {
        var aggregate_tag = Tag.struct_type
        if kind == Kind.keyword_enum { aggregate_tag = Tag.enum_type }
        if kind == Kind.keyword_union { aggregate_tag = Tag.union_type }
        const header = parseAggregateHeader(parser, aggregate_tag)
        state_module.expect(parser, Kind.right_parenthesis)
        child = parseAggregateBody(parser, aggregate_tag, header.0, header.1)
    }
    if !is_aggregate {
        child = parse(parser)
        state_module.expect(parser, Kind.right_parenthesis)
    }
    var value = node.init(Tag.nocopy_type, name_token)
    value.lhs = child
    value.extra = at_token
    return state_module.add(parser, value)
}

fn parseErrorSet(parser: *Parser) -> usize {
    const error_token = state_module.advance(parser)
    if !state_module.accept(parser, Kind.left_brace) {
        var inferred = node.init(Tag.error_union_type, error_token)
        inferred.rhs = parse(parser)
        return state_module.add(parser, inferred)
    }
    var first: usize = node.NONE
    var last: usize = node.NONE
    var count: usize = 0
    state_module.skipStatementEnds(parser)
    while !state_module.check(parser, Kind.right_brace) && !state_module.isAtEnd(parser) {
        const start_index = parser.*.index
        const name_token = state_module.expect(parser, Kind.identifier)
        if name_token == node.NONE { break }
        const member = state_module.add(parser, node.init(Tag.enum_member, name_token))
        if first == node.NONE { first = member } else { state_module.link(parser, last, member) }
        last = member
        count += 1
        state_module.accept(parser, Kind.comma)
        state_module.skipStatementEnds(parser)
        if parser.*.index == start_index {
            state_module.recordError(parser)
            state_module.advance(parser)
        }
    }
    state_module.expect(parser, Kind.right_brace)
    var value = node.init(Tag.error_set_type, error_token)
    value.lhs = first
    value.rhs = count
    return state_module.add(parser, value)
}

pub fn parse(parser: *Parser) -> usize {
    const kind = state_module.current(parser).kind
    if isNamedTypeStart(kind) { return parseNamed(parser) }
    if kind == Kind.asterisk { return parsePointer(parser) }
    if kind == Kind.left_bracket { return parseBracketType(parser) }
    if kind == Kind.question {
        const question_token = state_module.advance(parser)
        var value = node.init(Tag.optional_type, question_token)
        value.lhs = parse(parser)
        return state_module.add(parser, value)
    }
    if kind == Kind.bang {
        const bang_token = state_module.advance(parser)
        var value = node.init(Tag.error_union_type, bang_token)
        value.rhs = parse(parser)
        return state_module.add(parser, value)
    }
    if kind == Kind.keyword_fn { return parseFunctionType(parser) }
    if kind == Kind.left_parenthesis { return parseTupleType(parser) }
    if kind == Kind.keyword_struct { return parseAggregate(parser, Tag.struct_type) }
    if kind == Kind.keyword_enum { return parseAggregate(parser, Tag.enum_type) }
    if kind == Kind.keyword_union { return parseAggregate(parser, Tag.union_type) }
    if kind == Kind.keyword_error { return parseErrorSet(parser) }
    if kind == Kind.keyword_packed || kind == Kind.keyword_extern {
        state_module.advance(parser)
        return parse(parser)
    }
    if kind == Kind.at && state_module.tokenTextEquals(parser, parser.*.index + 1, "nocopy") { return parseNoCopy(parser) }
    if kind == Kind.at { return expression.parse(parser) }
    state_module.recordError(parser)
    return node.NONE
}
