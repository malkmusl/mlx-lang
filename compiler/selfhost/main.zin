const lexer = @import("./lexer.zin")
const token = @import("./token.zin")
const types = @import("./types.zin")
const symbols = @import("./symbols.zin")
const modules = @import("./modules.zin")
const diagnostic = @import("./diagnostic.zin")
const page_allocator = @import("../../std/bootstrap/page_allocator.zin")
const process = @import("../../std/bootstrap/process.zin")

pub fn main(arguments: [][*]const u8) -> u8 {
    const source = "const answer = 42\n"
    if lexer.count(source) != 5 {
        return 1
    }
    const first = lexer.next(source, 0)
    if first.kind != token.Kind.keyword_const || first.start != 0 || first.length != 5 {
        return 2
    }
    const state = diagnostic.none()
    if state.code != diagnostic.Code.none {
        return 3
    }
    unsafe {
        var path = @ptrCast([*]const u8, "compiler/selfhost/main.zin")
        var path_length: usize = 26
        if process.count(arguments) > 1 {
            const selected = process.argument(arguments, 1)
            path = selected.pointer
            path_length = selected.length
        }
        const allocator = page_allocator.init()
        const loader = modules.initLoader(allocator, @ptrCast([*]const u8, "std/src"), 7, null)
        const root_module = modules.loadRoot(loader, path, path_length)
        if root_module == modules.NONE || modules.totalErrors(loader) != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.import_not_found,
                diagnostic.Phase.resolve,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "module graph could not be loaded",
            ))
            return 4
        }
        var type_store = types.init(allocator)
        var symbol_store = symbols.initStore(allocator, modules.moduleCount(loader) * 64 + 64)
        const resolve_errors = modules.prepare(loader, &type_store, &symbol_store)
        if resolve_errors != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.duplicate_symbol,
                diagnostic.Phase.resolve,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "duplicate declaration",
            ))
            return 5
        }
        const semantic_errors = modules.analyzeDeclarations(loader, &type_store, &symbol_store)
        if semantic_errors != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.type_mismatch,
                diagnostic.Phase.sema,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "declaration type could not be resolved",
            ))
            return 6
        }
        // Zin1 only passes the bootstrap gate after every loaded function body
        // has completed semantic analysis.
        const body_errors = modules.analyzeFunctionBodies(loader, &type_store, &symbol_store)
        if body_errors != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.type_mismatch,
                diagnostic.Phase.sema,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "function body could not be resolved",
            ))
            return 7
        }
        symbols.deinitStore(&symbol_store)
        types.deinit(&type_store)
        modules.deinitLoader(loader)
    }
    return 13
}
