const lexer = @import("./lexer.zin")
const token = @import("./token.zin")
const parser_module = @import("./parser.zin")
const types = @import("./types.zin")
const symbols = @import("./symbols.zin")
const sema = @import("./sema.zin")
const diagnostic = @import("./diagnostic.zin")
const source_manager = @import("./source.zin")
const page_allocator = @import("../../std/bootstrap/page_allocator.zin")
const process = @import("../../std/bootstrap/process.zin")

pub fn main(arguments: [][*]const u8) -> u8 {
    const source = "const answer = 42\n"
    if lexer.count(source) != 5 {
        return 1
    }
    const first = lexer.next(source, 0)
    if first.kind != token.Kind.keyword_const || first.start != 0 || first.length != 5 {
        return 2
    }
    const state = diagnostic.none()
    if state.code != diagnostic.Code.none {
        return 3
    }
    unsafe {
        var path = @ptrCast([*]const u8, "compiler/selfhost/main.zin")
        var path_length: usize = 26
        if process.count(arguments) > 1 {
            const selected = process.argument(arguments, 1)
            path = selected.pointer
            path_length = selected.length
        }
        const loaded = source_manager.load(page_allocator.init(), path, path_length)
        if !loaded.valid || loaded.length == 0 {
            return 4
        }
        const allocator = page_allocator.init()
        const contents = source_manager.contents(loaded)
        const tokens = lexer.scanAll(allocator, contents)
        if tokens.length == 0 || lexer.tokenAt(tokens, tokens.length - 1).kind != token.Kind.end_of_file {
            return 5
        }
        var token_index: usize = 0
        while token_index < tokens.length {
            if lexer.tokenAt(tokens, token_index).kind == token.Kind.invalid { return 6 }
            token_index += 1
        }
        var nodes = parser_module.initStore(allocator, tokens.length * 2)
        var parser = parser_module.init(contents, tokens, &nodes)
        const root_index = parser_module.parse(&parser)
        if parser.errorCount != 0 || root_index == parser_module.NONE {
            var byte_offset: usize = loaded.length
            if parser.firstErrorToken != parser_module.NONE && parser.firstErrorToken < tokens.length {
                byte_offset = lexer.tokenAt(tokens, parser.firstErrorToken).start
            }
            diagnostic.render(diagnostic.create(
                diagnostic.Code.unexpected_token,
                diagnostic.Phase.parser,
                diagnostic.Severity.failure,
                0,
                byte_offset,
                byte_offset + 1,
                "unexpected token",
            ))
            return 7
        }
        const root = parser_module.nodeAt(&nodes, root_index)
        if root.tag != parser_module.Tag.root { return 8 }
        var type_store = types.init(allocator)
        var symbol_store = symbols.initStore(allocator, root.rhs + 16)
        var root_scope = symbols.initRootScope(allocator, root.rhs + 16)
        const resolve_errors = symbols.collectRoot(contents, tokens, &nodes, root_index, &symbol_store, &root_scope)
        if resolve_errors != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.duplicate_symbol,
                diagnostic.Phase.resolve,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "duplicate declaration",
            ))
            return 9
        }
        const semantic_errors = sema.analyzeDeclarations(contents, tokens, &nodes, root_index, &type_store, &symbol_store, &root_scope)
        if semantic_errors != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.type_mismatch,
                diagnostic.Phase.sema,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "declaration type could not be resolved",
            ))
            return 10
        }
        symbols.deinitScope(&root_scope)
        symbols.deinitStore(&symbol_store)
        types.deinit(&type_store)
        parser_module.deinitStore(&nodes)
        lexer.deinit(tokens)
        source_manager.deinit(loaded)
    }
    return 13
}
