pub const NONE: usize = 18446744073709551615

pub const Tag = enum(u16) {
    root,
    function_declaration,
    parameter_declaration,
    capture,
    variable_declaration,
    constant_declaration,
    test_declaration,
    block,
    if_statement,
    while_statement,
    inline_while_statement,
    for_statement,
    inline_for_statement,
    match_statement,
    return_statement,
    break_statement,
    continue_statement,
    defer_statement,
    error_defer_statement,
    unsafe_block,
    comptime_block,
    binary_expression,
    unary_expression,
    range_expression,
    call_expression,
    field_expression,
    index_expression,
    slice_expression,
    identifier,
    integer_literal,
    float_literal,
    string_literal,
    byte_string_literal,
    character_literal,
    boolean_literal,
    null_literal,
    undefined_literal,
    tuple_literal,
    array_literal,
    aggregate_literal,
    builtin_call,
    pointer_type,
    many_pointer_type,
    slice_type,
    array_type,
    optional_type,
    error_union_type,
    nocopy_type,
    function_type,
    tuple_type,
    named_type,
    struct_type,
    enum_type,
    union_type,
    error_set_type,
    field_declaration,
    enum_member,
    union_member
}

// Generic syntax record. Relationships are indices into Store; linked child
// lists use `next`. The semantic phase interprets lhs/rhs/extra by tag.
pub const Node = struct {
    tag: Tag
    mainToken: usize
    endToken: usize
    lhs: usize
    rhs: usize
    next: usize
    extra: usize
}

pub fn init(tag: Tag, main_token: usize) -> Node {
    return Node.{
        .tag = tag,
        .mainToken = main_token,
        .endToken = main_token,
        .lhs = NONE,
        .rhs = NONE,
        .next = NONE,
        .extra = NONE,
    }
}
