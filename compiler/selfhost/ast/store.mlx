const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")
const node = @import("./node.mlx")

pub const Allocator = allocator_module.Allocator
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn
pub const Node = node.Node

pub const Store = struct {
    items: [*]u8
    length: usize
    capacity: usize
    allocatorContext: usize
    resizeFn: ResizeFn
    freeFn: FreeFn

    pub fn init(allocator: Allocator, initial_capacity: usize) -> Self {
        const capacity = if initial_capacity > 0 { initial_capacity } else { 256 }
        return Self.{
            .items = allocator.alloc(capacity * @sizeOf(Node), @alignOf(Node)).?,
            .length = 0,
            .capacity = capacity,
            .allocatorContext = allocator.context,
            .resizeFn = allocator.resizeFn,
            .freeFn = allocator.freeFn,
        }
    }

    pub fn initAt(store: *Self, allocator: Allocator, initial_capacity: usize) -> void {
        const capacity = if initial_capacity > 0 { initial_capacity } else { 256 }
        store.*.items = allocator.alloc(capacity * @sizeOf(Node), @alignOf(Node)).?
        store.*.length = 0
        store.*.capacity = capacity
        store.*.allocatorContext = allocator.context
        store.*.resizeFn = allocator.resizeFn
        store.*.freeFn = allocator.freeFn
    }

    fn ensureCapacity(store: *Self, minimum: usize) -> void {
        if minimum <= store.*.capacity { return }
        var new_capacity = store.*.capacity * 2
        while new_capacity < minimum { new_capacity *= 2 }
        store.*.items = store.*.resizeFn(store.*.allocatorContext, store.*.items, store.*.capacity * @sizeOf(Node), new_capacity * @sizeOf(Node), @alignOf(Node)).?
        store.*.capacity = new_capacity
    }

    fn pointerAt(store: *Self, index: usize) -> [*]u8 {
        unsafe { return @ptrFromInt([*]u8, @intFromPtr(store.*.items) + index * @sizeOf(Node)) }
    }

    pub fn append(store: *Self, value: Node) -> usize {
        Self.ensureCapacity(store, store.*.length + 1)
        const index = store.*.length
        unsafe { mem.copy(Self.pointerAt(store, index), @ptrCast([*]const u8, &value), @sizeOf(Node)) }
        store.*.length += 1
        return index
    }

    pub fn get(store: *Self, index: usize) -> Node {
        unsafe { return @ptrCast(*Node, Self.pointerAt(store, index)).* }
    }

    pub fn set(store: *Self, index: usize, value: Node) -> void {
        unsafe { mem.copy(Self.pointerAt(store, index), @ptrCast([*]const u8, &value), @sizeOf(Node)) }
    }

    pub fn link(store: *Self, left: usize, right: usize) -> void {
        var value = Self.get(store, left)
        value.next = right
        Self.set(store, left, value)
    }

    pub fn deinit(store: *Self) -> void {
        store.*.freeFn(store.*.allocatorContext, store.*.items, store.*.capacity * @sizeOf(Node), @alignOf(Node))
        store.*.length = 0
    }
}
