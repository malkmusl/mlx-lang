const registry = @import("./sema/builtins/registry.zin")
const analyze = @import("./sema/builtins/analyze.zin")

pub const Buffer = registry.Buffer
pub const Kind = registry.Kind
pub const Store = analyze.Store
pub const UNBOUNDED = registry.UNBOUNDED

pub fn lookup(source: []const u8, tokens: Buffer, token_index: usize) -> Kind { return registry.lookup(source, tokens, token_index) }
pub fn minimumArity(kind: Kind) -> usize { return registry.minimumArity(kind) }
pub fn maximumArity(kind: Kind) -> usize { return registry.maximumArity(kind) }
pub fn acceptsArity(kind: Kind, count: usize) -> bool { return registry.acceptsArity(kind, count) }
pub fn result(kind: Kind, first_type: usize, first_value_type: usize, second_type: usize, second_value_type: usize, types: *Store) -> (usize, usize) { return analyze.result(kind, first_type, first_value_type, second_type, second_value_type, types) }
