const allocator_module = @import("../../std/bootstrap/allocator.mlx")
const symbol_module = @import("./sema/symbols/symbol.mlx")
const store_module = @import("./sema/symbols/store.mlx")
const scope_module = @import("./sema/symbols/scope.mlx")
const collect = @import("./sema/symbols/collect.mlx")

pub const Allocator = allocator_module.Allocator
pub const Symbol = symbol_module.Symbol
pub const State = symbol_module.State
pub const Store = store_module.Store
pub const Scope = scope_module.Scope
pub const Buffer = collect.Buffer
pub const NodeStore = collect.NodeStore
pub const FLAG_CONSTANT = symbol_module.FLAG_CONSTANT
pub const FLAG_FUNCTION = symbol_module.FLAG_FUNCTION
pub const FLAG_PUBLIC = symbol_module.FLAG_PUBLIC
pub const FLAG_EXPORT = symbol_module.FLAG_EXPORT
pub const FLAG_EXTERN = symbol_module.FLAG_EXTERN
pub const FLAG_THREADLOCAL = symbol_module.FLAG_THREADLOCAL
pub const FLAG_PARAMETER = symbol_module.FLAG_PARAMETER
pub const FLAG_INLINE = symbol_module.FLAG_INLINE
pub const FLAG_NOINLINE = symbol_module.FLAG_NOINLINE
pub const GENERIC_RETURN_NONE = symbol_module.GENERIC_RETURN_NONE
pub const GENERIC_RETURN_PARAMETER = symbol_module.GENERIC_RETURN_PARAMETER
pub const GENERIC_RETURN_TYPE_PARAMETER = symbol_module.GENERIC_RETURN_TYPE_PARAMETER
pub const GENERIC_RETURN_FIELD = symbol_module.GENERIC_RETURN_FIELD

pub fn initStore(allocator: Allocator, capacity: usize) -> Store { return store_module.Store.init(allocator, capacity) }
pub fn create(name_pointer: [*]const u8, name_length: usize, declaration: usize, type_id: usize, value_type_id: usize, flags: usize, state: State) -> Symbol { return symbol_module.init(name_pointer, name_length, declaration, type_id, value_type_id, flags, state) }
pub fn append(store: *Store, symbol: *Symbol) -> usize { return store_module.Store.append(store, symbol) }
pub fn symbolAt(store: *Store, index: usize) -> *Symbol { return store_module.Store.get(store, index) }
pub fn aggregateMethod(store: *Store, owner_type: usize, pointer: [*]const u8, length: usize) -> (bool, usize) {
    return store_module.Store.aggregateMethod(store, owner_type, pointer, length)
}
pub fn methodQueryCount(store: *Store) -> usize { return store_module.Store.methodQueryCount(store) }
pub fn methodProbeCount(store: *Store) -> usize { return store_module.Store.methodProbeCount(store) }
pub fn maxMethodProbeCount(store: *Store) -> usize { return store_module.Store.maxMethodProbeCount(store) }
pub fn markMoved(symbol: *Symbol, byte_offset: usize, length: usize) -> bool { return symbol_module.markMoved(symbol, byte_offset, length) }
pub fn deinitStore(store: *Store) -> void { store_module.Store.deinit(store) }
pub fn initRootScope(allocator: Allocator, capacity: usize) -> Scope { return scope_module.Scope.initRoot(allocator, capacity) }
pub fn initRootScopeAt(scope: *Scope, allocator: Allocator, capacity: usize) -> void { scope_module.Scope.initRootAt(scope, allocator, capacity) }
pub fn initChildScope(allocator: Allocator, parent: *Scope, capacity: usize) -> Scope { return scope_module.Scope.initChild(allocator, parent, capacity) }
pub fn initChildScopeFromParent(parent: *Scope, capacity: usize) -> Scope { return scope_module.Scope.initChildFromParent(parent, capacity) }
pub fn define(scope: *Scope, pointer: [*]const u8, length: usize, symbol: usize) -> bool { return scope_module.Scope.define(scope, pointer, length, symbol) }
pub fn lookup(scope: *Scope, pointer: [*]const u8, length: usize) -> (bool, usize) { return scope_module.Scope.lookup(scope, pointer, length) }
pub fn lookupCurrent(scope: *Scope, pointer: [*]const u8, length: usize) -> (bool, usize) { return scope_module.Scope.lookupCurrent(scope, pointer, length) }
pub fn collectRoot(source: []const u8, tokens: Buffer, nodes: *NodeStore, root_index: usize, store: *Store, scope: *Scope) -> usize { return collect.root(source, tokens, nodes, root_index, store, scope) }
pub fn deinitScope(scope: *Scope) -> void { scope_module.Scope.deinit(scope) }
