const value_module = @import("./sema/comptime/value.zin")
const evaluator = @import("./sema/comptime/evaluate.zin")

pub const Kind = value_module.Kind
pub const Value = value_module.Value
pub const Buffer = evaluator.Buffer
pub const NodeStore = evaluator.NodeStore
pub const TypeStore = evaluator.TypeStore
pub const SymbolStore = evaluator.SymbolStore
pub const Scope = evaluator.Scope

pub fn evaluate(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, quota: usize) -> Value { return evaluator.evaluate(source, tokens, nodes, types, symbols, scope, node_index, quota) }
pub fn isValid(value: Value) -> bool { return value_module.isValid(value) }
