const crash = @import("std.crash")
const lexer = @import("./lexer.mlx")
const token = @import("./token.mlx")
const diagnostic = @import("./diagnostic.mlx")
const options = @import("./driver/options.mlx")
const pipeline = @import("./driver/pipeline.mlx")
const build_command = @import("./driver/build_command.mlx")
const fs = @import("../../std/bootstrap/fs.mlx")
const process = @import("../../std/bootstrap/process.mlx")
// The toolchain's version, made when the compiler is built
// (tools/ensure_compiler.sh, ./mlx build: tools/build-number) from VERSION
// and the git history; self-contained, so the closure stays off the std
// root.
const version = @import("../../mlx-out/version.mlx")

// Whether the command line is `mlx4 --version`.
fn versionRequested(arguments: [][*]const u8) -> bool {
    if process.count(arguments) != 2 { return false }
    const argument = process.argument(arguments, 1)
    const wanted = "--version"
    if argument.length != wanted.length { return false }
    var index: usize = 0
    while index < wanted.length {
        if argument.pointer[index] != wanted[index] { return false }
        index += 1
    }
    return true
}

// mlx4 MAJOR.MINOR.BUILD (COMMIT), on stdout.
fn printVersion() -> u8 {
    const out = fs.File.{ .descriptor = 1 }
    var written = fs.writeAll(out, "mlx4 ")
    written = fs.writeAll(out, version.VERSION)
    if version.COMMIT.length > 0 {
        written = fs.writeAll(out, " (")
        written = fs.writeAll(out, version.COMMIT)
        written = fs.writeAll(out, ")")
    }
    written = fs.writeAll(out, "\nthe Mlx compiler (x86_64 and AArch64 Linux, Android)\n")
    return 0
}

fn selfCheck() -> u8 {
    const source = "const answer = 42\n"
    if lexer.count(source) != 5 { return 1 }
    const first = lexer.next(source, 0)
    if first.kind != token.Kind.keyword_const || first.start != 0 || first.length != 5 { return 2 }
    if diagnostic.none().code != diagnostic.Code.none { return 3 }
    return 0
}

pub fn main(arguments: [][*]const u8) -> u8 {
    // The crash report before anything else: a crash of the compiler names
    // the function it was in and its callers, says what it was compiling
    // (crash.contextAt in driver/pipeline.mlx), and is kept for MLX
    // Observatory (std.crash). The handler's memory is its own, apart from
    // the compiler's arena.
    _ = crash.install()
    const check = selfCheck()
    if check != 0 { return check }
    if versionRequested(arguments) { return printVersion() }
    if build_command.requested(arguments) { return build_command.run(arguments) }
    return pipeline.Pipeline.compile(options.Options.parse(arguments))
}
