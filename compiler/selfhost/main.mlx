const lexer = @import("./lexer.mlx")
const token = @import("./token.mlx")
const types = @import("./types.mlx")
const symbols = @import("./symbols.mlx")
const modules = @import("./modules.mlx")
const diagnostic = @import("./diagnostic.mlx")
const page_allocator = @import("../../std/bootstrap/page_allocator.mlx")
const process = @import("../../std/bootstrap/process.mlx")
const io = @import("../../std/bootstrap/io.mlx")
const strings = @import("../../std/bootstrap/string.mlx")
const lir = @import("./ir/lir.mlx")
const lower = @import("./ir/lower.mlx")
const encoder_module = @import("./backend/x86_64/encoder.mlx")
const codegen_module = @import("./backend/x86_64/codegen.mlx")
const elf64 = @import("./object/elf64.mlx")

fn argumentEquals(argument: process.String, expected: []const u8) -> bool {
    return strings.eql(argument, strings.fromSlice(expected))
}

fn progressStep(enabled: bool, current: usize, total: usize, message: []const u8) -> void {
    if !enabled { return }
    const output = io.stderr()
    io.writeAll(output, "[mlx1 ")
    io.writeUnsigned(output, current)
    io.writeAll(output, "/")
    io.writeUnsigned(output, total)
    io.writeAll(output, "] ")
    io.writeLine(output, message)
}

fn traceValue(enabled: bool, label: []const u8, value: usize) -> void {
    if !enabled { return }
    const output = io.stderr()
    io.writeAll(output, "[mlx1 trace] ")
    io.writeAll(output, label)
    io.writeUnsigned(output, value)
    io.writeAll(output, "\n")
}

fn traceString(enabled: bool, label: []const u8, value: process.String) -> void {
    if !enabled { return }
    const output = io.stderr()
    io.writeAll(output, "[mlx1 trace] ")
    io.writeAll(output, label)
    io.writeString(output, value)
    io.writeAll(output, "\n")
}

fn traceModules(enabled: bool, loader: *modules.Loader) -> void {
    if !enabled { return }
    const output = io.stderr()
    var index: usize = 0
    while index < modules.moduleCount(loader) {
        const module = modules.moduleAt(loader, index)
        io.writeAll(output, "[mlx1 trace] module[")
        io.writeUnsigned(output, index)
        io.writeAll(output, "]: ")
        unsafe {
            io.writeAll(output, module.*.pathPointer[0..module.*.pathLength])
        }
        io.writeAll(output, "\n")
        index += 1
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const source = "const answer = 42\n"
    if lexer.count(source) != 5 {
        return 1
    }
    const first = lexer.next(source, 0)
    if first.kind != token.Kind.keyword_const || first.start != 0 || first.length != 5 {
        return 2
    }
    const state = diagnostic.none()
    if state.code != diagnostic.Code.none {
        return 3
    }
    unsafe {
        var path = @ptrCast([*]const u8, "compiler/selfhost/main.mlx")
        var path_length: usize = 26
        var output_path = @ptrCast([*]const u8, "a.out")
        var has_output = false
        var show_progress = true
        var trace_enabled = false

        // Parse CLI arguments
        const argc = process.count(arguments)
        var argi: usize = 1
        while argi < argc {
            const arg = process.argument(arguments, argi)
            if arg.length == 2 && arg.pointer[0] == 45 && arg.pointer[1] == 111 {
                // "-o" flag
                if argi + 1 < argc {
                    argi += 1
                    const out_arg = process.argument(arguments, argi)
                    output_path = out_arg.pointer
                    has_output = true
                }
            } else if argumentEquals(arg, "--quiet") {
                show_progress = false
            } else if argumentEquals(arg, "--progress") {
                show_progress = true
            } else if argumentEquals(arg, "--trace") || argumentEquals(arg, "--verbose") {
                trace_enabled = true
                show_progress = true
            } else {
                path = arg.pointer
                path_length = arg.length
            }
            argi += 1
        }

        const step_count: usize = if has_output { 8 } else { 4 }
        traceString(trace_enabled, "input: ", process.String.{ .pointer = path, .length = path_length })
        if has_output {
            traceString(trace_enabled, "output: ", process.String.{ .pointer = output_path, .length = process.fromCString(output_path).length })
        }

        const allocator = page_allocator.init()
        progressStep(show_progress, 1, step_count, "load and parse module graph")
        const loader = modules.initLoader(allocator, @ptrCast([*]const u8, "std/src"), 7, null)
        const root_module = modules.loadRoot(loader, path, path_length)
        if root_module == modules.NONE || modules.totalErrors(loader) != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.import_not_found,
                diagnostic.Phase.resolve,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "module graph could not be loaded",
            ))
            return 4
        }
        traceValue(trace_enabled, "modules: ", modules.moduleCount(loader))
        traceValue(trace_enabled, "imports: ", modules.importCount(loader))
        traceModules(trace_enabled, loader)
        var type_store = types.init(allocator)
        var symbol_store = symbols.initStore(allocator, modules.moduleCount(loader) * 64 + 64)
        progressStep(show_progress, 2, step_count, "resolve modules and declarations")
        const resolve_errors = modules.prepare(loader, &type_store, &symbol_store)
        if resolve_errors != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.duplicate_symbol,
                diagnostic.Phase.resolve,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "duplicate declaration",
            ))
            return 5
        }
        progressStep(show_progress, 3, step_count, "analyze declaration types")
        const semantic_errors = modules.analyzeDeclarations(loader, &type_store, &symbol_store)
        if semantic_errors != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.type_mismatch,
                diagnostic.Phase.sema,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "declaration type could not be resolved",
            ))
            return 6
        }
        traceValue(trace_enabled, "types after declarations: ", types.count(&type_store))
        progressStep(show_progress, 4, step_count, "analyze function bodies")
        const body_errors = modules.analyzeFunctionBodies(loader, &type_store, &symbol_store)
        if body_errors != 0 {
            diagnostic.render(diagnostic.create(
                diagnostic.Code.type_mismatch,
                diagnostic.Phase.sema,
                diagnostic.Severity.failure,
                0,
                0,
                1,
                "function body could not be resolved",
            ))
            return 7
        }

        // ── Backend Pipeline ──
        if has_output {
            // Phase 1: LIR lowering
            progressStep(show_progress, 5, step_count, "lower typed AST to LIR")
            var ir = lir.init(allocator)
            var builder = lower.init(&ir, &type_store, &symbol_store, loader, allocator)

            // Generate LIR for all modules
            var mod_idx: usize = 0
            while mod_idx < modules.moduleCount(loader) {
                lower.generateModule(&builder, mod_idx)
                mod_idx += 1
            }
            lower.generateGenericInstances(&builder)
            traceValue(trace_enabled, "generic instances: ", lower.genericInstanceCount(&builder))
            if trace_enabled {
                var generic_index: usize = 0
                while generic_index < lower.genericInstanceCount(&builder) {
                    const generic_symbol = lir.getSymbol(&ir, lower.genericInstanceSymbol(&builder, generic_index))
                    io.writeAll(io.stderr(), "[mlx1 trace] generic[")
                    io.writeUnsigned(io.stderr(), generic_index)
                    io.writeAll(io.stderr(), "]: ")
                    unsafe { io.writeAll(io.stderr(), generic_symbol.pointer[0..generic_symbol.length]) }
                    io.writeAll(io.stderr(), "\n")
                    generic_index += 1
                }
            }
            traceValue(trace_enabled, "LIR instructions: ", lir.instCount(&ir))

            // Phase 2: x86_64 code generation
            progressStep(show_progress, 6, step_count, "generate x86_64 machine code")
            var enc = encoder_module.init(allocator)
            var gen = codegen_module.init(allocator, &enc, &ir)
            codegen_module.generateBinary(&gen)
            traceValue(trace_enabled, "machine-code bytes: ", encoder_module.pos(&enc))

            // Phase 3: Apply fixups
            progressStep(show_progress, 7, step_count, "resolve backend symbols")
            const fixups_ok = encoder_module.applyFixups(&enc)

            if !fixups_ok {
                if trace_enabled {
                    const unresolved_pointer = encoder_module.unresolvedFixupPointer(&enc)
                    const unresolved_length = encoder_module.unresolvedFixupLength(&enc)
                    if unresolved_length != 0 {
                        io.writeAll(io.stderr(), "[mlx1 trace] unresolved symbol: ")
                        unsafe { io.writeAll(io.stderr(), unresolved_pointer[0..unresolved_length]) }
                        io.writeAll(io.stderr(), "\n")
                    }
                }
                codegen_module.deinit(&gen)
                encoder_module.deinit(&enc)
                lower.deinit(&builder)
                lir.deinit(&ir)
                diagnostic.render(diagnostic.create(
                    diagnostic.Code.import_not_found,
                    diagnostic.Phase.linker,
                    diagnostic.Severity.failure,
                    0,
                    0,
                    1,
                    "unresolved backend symbol",
                ))
                return 8
            }

            // Phase 4: Write ELF64 executable
            progressStep(show_progress, 8, step_count, "write ELF64 executable")
            const wrote = elf64.writeExecutable(
                allocator,
                enc.buf.*.items,
                enc.buf.*.length,
                0,
                @ptrFromInt([*]const u8, 0),
                0,
                output_path,
            )

            codegen_module.deinit(&gen)
            encoder_module.deinit(&enc)
            lower.deinit(&builder)
            lir.deinit(&ir)

            if !wrote {
                diagnostic.render(diagnostic.create(
                    diagnostic.Code.import_not_found,
                    diagnostic.Phase.resolve,
                    diagnostic.Severity.failure,
                    0,
                    0,
                    1,
                    "failed to write output file",
                ))
                return 9
            }
        }

        symbols.deinitStore(&symbol_store)
        types.deinit(&type_store)
        modules.deinitLoader(loader)
    }
    return 0
}
