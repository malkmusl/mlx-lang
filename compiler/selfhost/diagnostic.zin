pub const Code = enum(u16) {
    none,
    unexpected_byte,
    unexpected_end_of_file
}

pub const Diagnostic = struct {
    code: Code
    byte_offset: usize
}

pub fn none() -> Diagnostic {
    return Diagnostic.{ .code = Code.none, .byte_offset = 0 }
}

pub fn at(code: Code, byte_offset: usize) -> Diagnostic {
    return Diagnostic.{ .code = code, .byte_offset = byte_offset }
}
