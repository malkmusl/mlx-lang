const allocator_module = @import("../../../std/bootstrap/allocator.zin")
const source_module = @import("../source.zin")
const lexer = @import("../lexer.zin")
const parser_module = @import("../parser.zin")
const symbols_module = @import("../symbols.zin")
const ast = @import("../ast/node.zin")
const ast_store = @import("../ast/store.zin")
const model = @import("./model.zin")
const path = @import("./path.zin")
const store_module = @import("./store.zin")
const packages_module = @import("./packages.zin")

pub const Allocator = allocator_module.Allocator
pub const AllocFn = allocator_module.AllocFn
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn
pub const Module = model.Module
pub const Import = model.Import
pub const Store = store_module.Store
pub const PackageMap = packages_module.Map
pub const SourceFile = source_module.SourceFile
pub const Buffer = lexer.Buffer
pub const NodeStore = ast_store.Store
pub const OwnedPath = path.OwnedPath
pub const Scope = symbols_module.Scope

pub const Loader = struct {
    store: *Store
    stdRootPointer: [*]const u8
    stdRootLength: usize
    packagesAddress: usize
    allocatorContext: usize
    allocFn: AllocFn
    resizeFn: ResizeFn
    freeFn: FreeFn
}

pub fn allocatorFor(loader: *Loader) -> Allocator {
    return Allocator.{
        .context = loader.*.allocatorContext,
        .allocFn = loader.*.allocFn,
        .resizeFn = loader.*.resizeFn,
        .freeFn = loader.*.freeFn,
    }
}

pub fn create(allocator: Allocator, std_root: [*]const u8, std_root_length: usize, packages: ?*PackageMap) -> *Loader {
    const loader_memory = allocator.allocFn(allocator.context, @sizeOf(Loader), @alignOf(Loader)).?
    const store_memory = allocator.allocFn(allocator.context, @sizeOf(Store), @alignOf(Store)).?
    unsafe {
        const loader = @ptrCast(*Loader, loader_memory)
        const module_store = @ptrCast(*Store, store_memory)
        store_module.initAt(module_store, allocator, 16)
        loader.*.store = module_store
        loader.*.stdRootPointer = std_root
        loader.*.stdRootLength = std_root_length
        loader.*.packagesAddress = if packages == null { 0 } else { @intFromPtr(packages.?) }
        loader.*.allocatorContext = allocator.context
        loader.*.allocFn = allocator.allocFn
        loader.*.resizeFn = allocator.resizeFn
        loader.*.freeFn = allocator.freeFn
        return loader
    }
}

fn tokenEquals(source: []const u8, tokens: Buffer, token_index: usize, expected: []const u8) -> bool {
    const token = lexer.tokenAt(tokens, token_index)
    var expected_length: usize = 0
    for byte in expected { expected_length += 1 }
    if token.length != expected_length { return false }
    var index: usize = 0
    while index < expected_length {
        if source[token.start + index] != expected[index] { return false }
        index += 1
    }
    return true
}

fn stringContent(source: []const u8, tokens: Buffer, nodes: *NodeStore, node_index: usize) -> (bool, [*]const u8, usize) {
    const node = ast_store.get(nodes, node_index)
    if node.tag != ast.Tag.string_literal { unsafe { return -> (false, @ptrFromInt([*]const u8, 0), 0) } }
    const token = lexer.tokenAt(tokens, node.mainToken)
    if token.length < 2 { unsafe { return -> (false, @ptrFromInt([*]const u8, 0), 0) } }
    var byte: usize = 1
    while byte + 1 < token.length {
        if source[token.start + byte] == 92 { unsafe { return -> (false, @ptrFromInt([*]const u8, 0), 0) } }
        byte += 1
    }
    unsafe {
        const source_pointer = @ptrCast([*]const u8, source)
        return -> (true, @ptrFromInt([*]const u8, @intFromPtr(source_pointer) + token.start + 1), token.length - 2)
    }
}

fn resolveImport(loader: *Loader, importer: *Module, requested: [*]const u8, requested_length: usize) -> OwnedPath {
    const allocator = allocatorFor(loader)
    const kind = path.classify(requested, requested_length)
    if kind == model.ImportKind.relative {
        unsafe { return path.resolveRelative(allocator, @ptrCast([*]const u8, importer.*.pathPointer), importer.*.pathLength, requested, requested_length) }
    }
    if kind == model.ImportKind.standard {
        return path.resolveStandard(allocator, loader.*.stdRootPointer, loader.*.stdRootLength, requested, requested_length)
    }
    if kind == model.ImportKind.builtin { return path.copy(allocator, requested, requested_length) }
    if kind == model.ImportKind.package && loader.*.packagesAddress != 0 {
        unsafe {
            const packages = @ptrFromInt(*PackageMap, loader.*.packagesAddress)
            const found = packages_module.get(packages, requested, requested_length)
            if found.0 { return path.copy(allocator, found.1, found.2) }
        }
    }
    return path.invalid(allocator)
}

fn appendNewModule(loader: *Loader, owned: *OwnedPath) -> usize {
    var value = Module.{
        .id = loader.*.store.*.moduleLength,
        .pathPointer = owned.*.pointer,
        .pathLength = owned.*.length,
        .pathCapacity = owned.*.capacity,
        .state = model.State.discovered,
        .sourceAddress = 0,
        .tokensAddress = 0,
        .nodesAddress = 0,
        .scopeAddress = 0,
        .rootNode = model.NONE,
        .symbolStart = 0,
        .symbolCount = 0,
        .moduleType = 0,
        .errorCount = 0,
    }
    return store_module.appendModule(loader.*.store, &value)
}

fn allocateSource(loader: *Loader) -> *SourceFile {
    unsafe { return @ptrCast(*SourceFile, loader.*.allocFn(loader.*.allocatorContext, @sizeOf(SourceFile), @alignOf(SourceFile)).?) }
}

fn allocateTokens(loader: *Loader) -> *Buffer {
    unsafe { return @ptrCast(*Buffer, loader.*.allocFn(loader.*.allocatorContext, @sizeOf(Buffer), @alignOf(Buffer)).?) }
}

fn allocateNodes(loader: *Loader) -> *NodeStore {
    unsafe { return @ptrCast(*NodeStore, loader.*.allocFn(loader.*.allocatorContext, @sizeOf(NodeStore), @alignOf(NodeStore)).?) }
}

fn loadOwned(loader: *Loader, owned: *OwnedPath) -> usize {
    const existing = store_module.findModule(loader.*.store, owned.*.pointer, owned.*.length)
    if existing.0 {
        path.deinit(owned.*)
        return existing.1
    }
    const module_id = appendNewModule(loader, owned)
    if module_id == model.NONE {
        path.deinit(owned.*)
        return model.NONE
    }
    var module = store_module.moduleAt(loader.*.store, module_id)
    module.*.state = model.State.loading
    if path.classify(module.*.pathPointer, module.*.pathLength) == model.ImportKind.builtin {
        module.*.state = model.State.loaded
        return module_id
    }

    const source_file = allocateSource(loader)
    unsafe { source_module.loadInto(source_file, allocatorFor(loader), @ptrCast([*]const u8, module.*.pathPointer), module.*.pathLength) }
    module = store_module.moduleAt(loader.*.store, module_id)
    module.*.sourceAddress = @intFromPtr(source_file)
    if !source_file.*.valid {
        module.*.state = model.State.failed
        module.*.errorCount += 1
        return module_id
    }
    const source = source_module.contents(source_file.*)
    const token_buffer = allocateTokens(loader)
    lexer.scanAllInto(token_buffer, allocatorFor(loader), source)
    module = store_module.moduleAt(loader.*.store, module_id)
    module.*.tokensAddress = @intFromPtr(token_buffer)
    var token_index: usize = 0
    while token_index < token_buffer.*.length {
        if lexer.tokenAt(token_buffer.*, token_index).kind == lexer.Kind.invalid { module.*.errorCount += 1 }
        token_index += 1
    }
    const nodes = allocateNodes(loader)
    parser_module.initStoreAt(nodes, allocatorFor(loader), token_buffer.*.length * 2)
    var parser = parser_module.init(source, token_buffer.*, nodes)
    const root = parser_module.parse(&parser)
    module = store_module.moduleAt(loader.*.store, module_id)
    module.*.nodesAddress = @intFromPtr(nodes)
    module.*.rootNode = root
    module.*.errorCount += parser.errorCount
    if root == model.NONE || parser.errorCount != 0 {
        module.*.state = model.State.failed
        return module_id
    }

    var node_index: usize = 0
    while node_index < nodes.*.length {
        const node = ast_store.get(nodes, node_index)
        if node.tag == ast.Tag.builtin_call && node.rhs == 1 && tokenEquals(source, token_buffer.*, node.mainToken, "import") {
            const requested = stringContent(source, token_buffer.*, nodes, node.lhs)
            if !requested.0 {
                module = store_module.moduleAt(loader.*.store, module_id)
                module.*.errorCount += 1
            }
            if requested.0 {
                module = store_module.moduleAt(loader.*.store, module_id)
                var resolved = resolveImport(loader, module, requested.1, requested.2)
                if !resolved.valid {
                    module = store_module.moduleAt(loader.*.store, module_id)
                    module.*.errorCount += 1
                }
                if resolved.valid {
                    const target = loadOwned(loader, &resolved)
                    var edge = Import.{ .owner = module_id, .node = node_index, .target = target }
                    if target == model.NONE || !store_module.appendImport(loader.*.store, &edge) {
                        module = store_module.moduleAt(loader.*.store, module_id)
                        module.*.errorCount += 1
                    }
                }
            }
        }
        node_index += 1
    }
    module = store_module.moduleAt(loader.*.store, module_id)
    module.*.state = if module.*.errorCount == 0 { model.State.loaded } else { model.State.failed }
    return module_id
}

pub fn loadRoot(loader: *Loader, pointer: [*]const u8, length: usize) -> usize {
    var owned = path.copy(allocatorFor(loader), pointer, length)
    if !owned.valid { return model.NONE }
    return loadOwned(loader, &owned)
}

pub fn moduleAt(loader: *Loader, id: usize) -> *Module {
    return store_module.moduleAt(loader.*.store, id)
}

pub fn moduleCount(loader: *Loader) -> usize { return loader.*.store.*.moduleLength }
pub fn importCount(loader: *Loader) -> usize { return loader.*.store.*.importLength }

pub fn deinit(loader: *Loader) -> void {
    const loader_address = @intFromPtr(loader)
    var index: usize = 0
    while index < loader.*.store.*.moduleLength {
        const module = store_module.moduleAt(loader.*.store, index)
        if module.*.scopeAddress != 0 {
            unsafe {
                const scope = @ptrFromInt(*Scope, module.*.scopeAddress)
                symbols_module.deinitScope(scope)
                loader.*.freeFn(loader.*.allocatorContext, @ptrCast([*]u8, scope), @sizeOf(Scope), @alignOf(Scope))
            }
        }
        if module.*.nodesAddress != 0 {
            unsafe {
                const nodes = @ptrFromInt(*NodeStore, module.*.nodesAddress)
                parser_module.deinitStore(nodes)
                loader.*.freeFn(loader.*.allocatorContext, @ptrCast([*]u8, nodes), @sizeOf(NodeStore), @alignOf(NodeStore))
            }
        }
        if module.*.tokensAddress != 0 {
            unsafe {
                const tokens = @ptrFromInt(*Buffer, module.*.tokensAddress)
                lexer.deinit(tokens.*)
                loader.*.freeFn(loader.*.allocatorContext, @ptrCast([*]u8, tokens), @sizeOf(Buffer), @alignOf(Buffer))
            }
        }
        if module.*.sourceAddress != 0 {
            unsafe {
                const source = @ptrFromInt(*SourceFile, module.*.sourceAddress)
                source_module.deinit(source.*)
                loader.*.freeFn(loader.*.allocatorContext, @ptrCast([*]u8, source), @sizeOf(SourceFile), @alignOf(SourceFile))
            }
        }
        if module.*.pathCapacity > 0 { loader.*.freeFn(loader.*.allocatorContext, module.*.pathPointer, module.*.pathCapacity, 1) }
        index += 1
    }
    store_module.deinit(loader.*.store)
    unsafe { loader.*.freeFn(loader.*.allocatorContext, @ptrCast([*]u8, loader.*.store), @sizeOf(Store), @alignOf(Store)) }
    unsafe { loader.*.freeFn(loader.*.allocatorContext, @ptrFromInt([*]u8, loader_address), @sizeOf(Loader), @alignOf(Loader)) }
}
