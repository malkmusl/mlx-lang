const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")

pub const Allocator = allocator_module.Allocator

pub const Entry = struct {
    namePointer: [*]const u8
    nameLength: usize
    rootPointer: [*]const u8
    rootLength: usize
}

pub const Map = struct {
    entries: [*]u8
    length: usize
    capacity: usize
    allocator: Allocator
}

pub const GetResult = struct {
    found: bool
    rootPointer: [*]const u8
    rootLength: usize
}

pub fn init(allocator: Allocator, initial_capacity: usize) -> Map {
    const capacity = if initial_capacity > 0 { initial_capacity } else { 8 }
    return Map.{
        .entries = allocator.alloc(capacity * @sizeOf(Entry), @alignOf(Entry)).?,
        .length = 0,
        .capacity = capacity,
        .allocator = allocator,
    }
}

pub fn initAt(map: *Map, allocator: Allocator, initial_capacity: usize) -> void {
    const capacity = if initial_capacity > 0 { initial_capacity } else { 8 }
    map.*.entries = allocator.alloc(capacity * @sizeOf(Entry), @alignOf(Entry)).?
    map.*.length = 0
    map.*.capacity = capacity
    map.*.allocator = allocator
}

pub fn create(allocator: Allocator, initial_capacity: usize) -> *Map {
    unsafe {
        const memory = allocator.alloc(@sizeOf(Map), @alignOf(Map)).?
        const map = @ptrCast(*Map, memory)
        initAt(map, allocator, initial_capacity)
        return map
    }
}

fn entryAt(map: *Map, index: usize) -> *Entry {
    unsafe { return @ptrFromInt(*Entry, @intFromPtr(map.*.entries) + index * @sizeOf(Entry)) }
}

fn same(pointer: [*]const u8, length: usize, other: [*]const u8, other_length: usize) -> bool {
    if length != other_length { return false }
    var index: usize = 0
    while index < length {
        if pointer[index] != other[index] { return false }
        index += 1
    }
    return true
}

fn ensureCapacity(map: *Map, minimum: usize) -> bool {
    if minimum <= map.*.capacity { return true }
    var capacity = map.*.capacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = map.*.allocator.resize(
        map.*.entries,
        map.*.capacity * @sizeOf(Entry),
        capacity * @sizeOf(Entry),
        @alignOf(Entry),
    )
    if resized == null { return false }
    map.*.entries = resized.?
    map.*.capacity = capacity
    return true
}

pub fn put(map: *Map, name: [*]const u8, name_length: usize, root: [*]const u8, root_length: usize) -> bool {
    var index: usize = 0
    while index < map.*.length {
        const entry = entryAt(map, index)
        if same(entry.*.namePointer, entry.*.nameLength, name, name_length) {
            entry.*.rootPointer = root
            entry.*.rootLength = root_length
            return true
        }
        index += 1
    }
    if !ensureCapacity(map, map.*.length + 1) { return false }
    var value = Entry.{ .namePointer = name, .nameLength = name_length, .rootPointer = root, .rootLength = root_length }
    unsafe { mem.copy(@ptrCast([*]u8, entryAt(map, map.*.length)), @ptrCast([*]const u8, &value), @sizeOf(Entry)) }
    map.*.length += 1
    return true
}

pub fn get(map: *Map, name: [*]const u8, name_length: usize) -> GetResult {
    var index: usize = 0
    while index < map.*.length {
        const entry = entryAt(map, index)
        if same(entry.*.namePointer, entry.*.nameLength, name, name_length) {
            return GetResult.{ .found = true, .rootPointer = entry.*.rootPointer, .rootLength = entry.*.rootLength }
        }
        index += 1
    }
    unsafe { return GetResult.{ .found = false, .rootPointer = @ptrFromInt([*]const u8, 0), .rootLength = 0 } }
}

pub fn deinit(map: *Map) -> void {
    map.*.allocator.free(map.*.entries, map.*.capacity * @sizeOf(Entry), @alignOf(Entry))
    map.*.length = 0
}

pub fn destroy(map: *Map) -> void {
    const allocator = map.*.allocator
    deinit(map)
    unsafe { allocator.free(@ptrCast([*]u8, map), @sizeOf(Map), @alignOf(Map)) }
}
