pub const NONE: usize = 18446744073709551615
pub const IMPORT_TYPE_MARKER: usize = 9223372036854775808

pub const ImportKind = enum(u8) {
    invalid,
    relative,
    package,
    standard,
    builtin
}

pub const State = enum(u8) {
    discovered,
    loading,
    loaded,
    failed
}

pub const Module = struct {
    id: usize
    pathPointer: [*]u8
    pathLength: usize
    pathCapacity: usize
    state: State
    sourceAddress: usize
    tokensAddress: usize
    nodesAddress: usize
    scopeAddress: usize
    rootNode: usize
    symbolStart: usize
    symbolCount: usize
    moduleType: usize
    errorCount: usize
}

pub const Import = struct {
    owner: usize
    node: usize
    target: usize
}

pub fn encodeImportType(type_id: usize) -> usize {
    return IMPORT_TYPE_MARKER | type_id
}

pub fn hasImportType(encoded: usize) -> bool {
    return encoded & IMPORT_TYPE_MARKER != 0
}

pub fn decodeImportType(encoded: usize) -> usize {
    return encoded & ~IMPORT_TYPE_MARKER
}
