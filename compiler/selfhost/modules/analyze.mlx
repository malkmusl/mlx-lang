const source_module = @import("../source.mlx")
const lexer = @import("../lexer.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const sema = @import("../sema.mlx")
const model = @import("./model.mlx")
const loader_module = @import("./loader.mlx")
const store_module = @import("./store.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")

pub const Loader = loader_module.Loader
pub const TypeStore = types_module.Store
pub const SymbolStore = symbols_module.Store
pub const Module = model.Module
pub const Buffer = lexer.Buffer
pub const NodeStore = ast_store.Store
pub const Scope = symbols_module.Scope
pub const SourceFile = source_module.SourceFile

fn sourceFor(module: *Module) -> []const u8 {
    unsafe { return source_module.contents(@ptrFromInt(*SourceFile, module.*.sourceAddress).*) }
}

fn tokensFor(module: *Module) -> *Buffer {
    unsafe { return @ptrFromInt(*Buffer, module.*.tokensAddress) }
}

fn nodesFor(module: *Module) -> *NodeStore {
    unsafe { return @ptrFromInt(*NodeStore, module.*.nodesAddress) }
}

fn scopeFor(module: *Module) -> *Scope {
    unsafe { return @ptrFromInt(*Scope, module.*.scopeAddress) }
}

fn allocateScope(loader: *Loader, capacity: usize) -> *Scope {
    unsafe {
        const memory = loader.*.allocator.alloc(@sizeOf(Scope), @alignOf(Scope)).?
        const scope = @ptrCast(*Scope, memory)
        symbols_module.initRootScopeAt(scope, loader_module.Loader.allocatorFor(loader), capacity)
        return scope
    }
}

pub fn prepare(loader: *Loader, types: *TypeStore, symbols: *SymbolStore) -> usize {
    var errors: usize = 0
    var module_index: usize = 0
    while module_index < loader_module.Loader.moduleCount(loader) {
        const module = loader_module.Loader.moduleAt(loader, module_index)
        if module.*.state == model.State.loaded && module.*.sourceAddress != 0 {
            const scope = allocateScope(loader, 32)
            module.*.scopeAddress = @intFromPtr(scope)
            module.*.symbolStart = symbols.*.length
            errors += symbols_module.collectRoot(
                sourceFor(module),
                tokensFor(module).*,
                nodesFor(module),
                module.*.rootNode,
                symbols,
                scope,
            )
            module.*.symbolCount = symbols.*.length - module.*.symbolStart
            var collected_index = module.*.symbolStart
            while collected_index < symbols.*.length {
                symbols_module.symbolAt(symbols, collected_index).*.moduleId = module.*.id
                collected_index += 1
            }
        }
        module_index += 1
    }

    module_index = 0
    while module_index < loader_module.Loader.moduleCount(loader) {
        const module = loader_module.Loader.moduleAt(loader, module_index)
        const namespace_start = types.*.extraIds.*.length
        var declaration_index: usize = 0
        while declaration_index < module.*.symbolCount {
            types_module.appendExtra(types, module.*.symbolStart + declaration_index)
            declaration_index += 1
        }
        module.*.moduleType = types_module.moduleType(types, module.*.id, namespace_start, module.*.symbolCount)
        module_index += 1
    }

    var import_index: usize = 0
    while import_index < loader.*.store.*.importLength {
        const edge = store_module.Store.importAt(loader.*.store, import_index)
        if edge.*.owner < loader_module.Loader.moduleCount(loader) && edge.*.target < loader_module.Loader.moduleCount(loader) {
            const owner = loader_module.Loader.moduleAt(loader, edge.*.owner)
            const target = loader_module.Loader.moduleAt(loader, edge.*.target)
            if owner.*.nodesAddress != 0 {
                const nodes = nodesFor(owner)
                var import_node = ast_store.Store.get(nodes, edge.*.node)
                import_node.extra = model.encodeImportType(target.*.moduleType)
                ast_store.Store.set(nodes, edge.*.node, import_node)
            }
        }
        import_index += 1
    }
    return errors
}

fn dependenciesReady(loader: *Loader, module_id: usize, analyzed: [*]u8) -> bool {
    var import_index: usize = 0
    while import_index < loader.*.store.*.importLength {
        const edge = store_module.Store.importAt(loader.*.store, import_index)
        if edge.*.owner == module_id && edge.*.target < loader_module.Loader.moduleCount(loader) {
            const dependency = loader_module.Loader.moduleAt(loader, edge.*.target)
            if dependency.*.state == model.State.loaded && dependency.*.sourceAddress != 0 && analyzed[edge.*.target] == 0 { return false }
        }
        import_index += 1
    }
    return true
}

fn analyzeOneDeclarationModule(loader: *Loader, module: *Module, types: *TypeStore, symbols: *SymbolStore) -> usize {
    const symbols_before = symbols.*.length
    const module_errors = sema.analyzeDeclarations(
        sourceFor(module),
        tokensFor(module).*,
        nodesFor(module),
        module.*.rootNode,
        types,
        symbols,
        scopeFor(module),
    )
    var symbol_index = symbols_before
    while symbol_index < symbols.*.length {
        symbols_module.symbolAt(symbols, symbol_index).*.moduleId = module.*.id
        symbol_index += 1
    }
    module.*.errorCount += module_errors
    return module_errors
}

pub fn declarations(loader: *Loader, types: *TypeStore, symbols: *SymbolStore) -> usize {
    const count = loader_module.Loader.moduleCount(loader)
    if count == 0 { return 0 }
    const analyzed = loader.*.allocator.alloc(count, 1).?
    mem.zero(analyzed, count)
    var remaining: usize = 0
    var module_index: usize = 0
    while module_index < count {
        const module = loader_module.Loader.moduleAt(loader, module_index)
        if module.*.state != model.State.loaded || module.*.sourceAddress == 0 || module.*.scopeAddress == 0 {
            analyzed[module_index] = 1
        } else {
            remaining += 1
        }
        module_index += 1
    }

    var errors: usize = 0
    while remaining > 0 {
        var made_progress = false
        module_index = 0
        while module_index < count {
            if analyzed[module_index] == 0 && dependenciesReady(loader, module_index, analyzed) {
                errors += analyzeOneDeclarationModule(loader, loader_module.Loader.moduleAt(loader, module_index), types, symbols)
                analyzed[module_index] = 1
                remaining -= 1
                made_progress = true
            }
            module_index += 1
        }
        if !made_progress {
            // A declaration-only import cycle is legal. Break the graph cycle;
            // actual cyclic comptime dependencies still fail during evaluation.
            module_index = 0
            while module_index < count {
                if analyzed[module_index] == 0 {
                    errors += analyzeOneDeclarationModule(loader, loader_module.Loader.moduleAt(loader, module_index), types, symbols)
                    analyzed[module_index] = 1
                    remaining -= 1
                    made_progress = true
                    break
                }
                module_index += 1
            }
        }
    }
    loader.*.allocator.free(analyzed, count, 1)
    return errors
}

pub fn functionBodies(loader: *Loader, types: *TypeStore, symbols: *SymbolStore) -> usize {
    var errors: usize = 0
    var remaining = loader_module.Loader.moduleCount(loader)
    while remaining > 0 {
        remaining -= 1
        const module = loader_module.Loader.moduleAt(loader, remaining)
        if module.*.state == model.State.loaded && module.*.sourceAddress != 0 && module.*.scopeAddress != 0 {
            const module_errors = sema.analyzeFunctionBodies(
                sourceFor(module),
                tokensFor(module).*,
                nodesFor(module),
                module.*.rootNode,
                types,
                symbols,
                scopeFor(module),
            )
            module.*.errorCount += module_errors
            errors += module_errors
        }
    }
    return errors
}

pub fn totalErrors(loader: *Loader) -> usize {
    var errors: usize = 0
    var index: usize = 0
    while index < loader_module.Loader.moduleCount(loader) {
        errors += loader_module.Loader.moduleAt(loader, index).*.errorCount
        index += 1
    }
    return errors
}
