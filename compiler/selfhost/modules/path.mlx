const allocator_module = @import("../../../std/bootstrap/allocator.zin")
const model = @import("./model.zin")

pub const Allocator = allocator_module.Allocator
pub const FreeFn = allocator_module.FreeFn
pub const ImportKind = model.ImportKind

pub const OwnedPath = struct {
    pointer: [*]u8
    length: usize
    capacity: usize
    allocatorContext: usize
    freeFn: FreeFn
    valid: bool
}

pub fn invalid(allocator: Allocator) -> OwnedPath {
    unsafe {
        return OwnedPath.{
            .pointer = @ptrFromInt([*]u8, 0),
            .length = 0,
            .capacity = 0,
            .allocatorContext = allocator.context,
            .freeFn = allocator.freeFn,
            .valid = false,
        }
    }
}

fn equals(pointer: [*]const u8, length: usize, expected: []const u8) -> bool {
    var expected_length: usize = 0
    for byte in expected { expected_length += 1 }
    if length != expected_length { return false }
    var index: usize = 0
    while index < length {
        if pointer[index] != expected[index] { return false }
        index += 1
    }
    return true
}

fn startsWith(pointer: [*]const u8, length: usize, expected: []const u8) -> bool {
    var expected_length: usize = 0
    for byte in expected { expected_length += 1 }
    if expected_length > length { return false }
    var index: usize = 0
    while index < expected_length {
        if pointer[index] != expected[index] { return false }
        index += 1
    }
    return true
}

pub fn classify(pointer: [*]const u8, length: usize) -> ImportKind {
    if length == 0 { return ImportKind.invalid }
    if equals(pointer, length, "builtin") { return ImportKind.builtin }
    if startsWith(pointer, length, "./") || startsWith(pointer, length, "../") { return ImportKind.relative }
    if equals(pointer, length, "std") || startsWith(pointer, length, "std.") { return ImportKind.standard }
    return ImportKind.package
}

fn appendByte(destination: [*]u8, length: usize, value: u8) -> usize {
    destination[length] = value
    return length + 1
}

fn appendSegment(destination: [*]u8, length: usize, source: [*]const u8, start: usize, segment_length: usize, absolute: bool) -> usize {
    var output_length = length
    if output_length > 0 && destination[output_length - 1] != 47 { output_length = appendByte(destination, output_length, 47) }
    if output_length == 0 && absolute { output_length = appendByte(destination, output_length, 47) }
    var index: usize = 0
    while index < segment_length {
        output_length = appendByte(destination, output_length, source[start + index])
        index += 1
    }
    return output_length
}

fn popSegment(destination: [*]u8, length: usize, absolute: bool) -> usize {
    const minimum: usize = if absolute { 1 } else { 0 }
    if length <= minimum { return length }
    var index = length
    while index > minimum && destination[index - 1] != 47 { index -= 1 }
    if index > minimum { index -= 1 }
    return index
}

fn lastSegmentIsParent(destination: [*]u8, length: usize, absolute: bool) -> bool {
    const minimum: usize = if absolute { 1 } else { 0 }
    if length < minimum + 2 { return false }
    var start = length
    while start > minimum && destination[start - 1] != 47 { start -= 1 }
    return length - start == 2 && destination[start] == 46 && destination[start + 1] == 46
}

pub fn normalize(allocator: Allocator, pointer: [*]const u8, length: usize) -> OwnedPath {
    if length == 0 { return invalid(allocator) }
    const capacity = length + 3
    const allocation = allocator.allocFn(allocator.context, capacity, 1)
    if allocation == null { return invalid(allocator) }
    const destination = allocation.?
    const absolute = pointer[0] == 47
    var output_length: usize = if absolute { 1 } else { 0 }
    if absolute { destination[0] = 47 }
    var index: usize = 0
    while index < length {
        while index < length && pointer[index] == 47 { index += 1 }
        const start = index
        while index < length && pointer[index] != 47 { index += 1 }
        const segment_length = index - start
        if segment_length == 0 { continue }
        if segment_length == 1 && pointer[start] == 46 { continue }
        if segment_length == 2 && pointer[start] == 46 && pointer[start + 1] == 46 {
            if !absolute && lastSegmentIsParent(destination, output_length, absolute) {
                output_length = appendSegment(destination, output_length, pointer, start, segment_length, false)
                continue
            }
            const previous = output_length
            output_length = popSegment(destination, output_length, absolute)
            if previous == output_length && !absolute {
                output_length = appendSegment(destination, output_length, pointer, start, segment_length, false)
            }
            continue
        }
        output_length = appendSegment(destination, output_length, pointer, start, segment_length, absolute)
    }
    if output_length == 0 {
        destination[0] = 46
        output_length = 1
    }
    destination[output_length] = 0
    return OwnedPath.{
        .pointer = destination,
        .length = output_length,
        .capacity = capacity,
        .allocatorContext = allocator.context,
        .freeFn = allocator.freeFn,
        .valid = true,
    }
}

fn parentLength(pointer: [*]const u8, length: usize) -> usize {
    var index = length
    while index > 0 {
        if pointer[index - 1] == 47 { return index - 1 }
        index -= 1
    }
    return 0
}

fn combine(allocator: Allocator, left: [*]const u8, left_length: usize, right: [*]const u8, right_length: usize) -> OwnedPath {
    const temporary_capacity = left_length + right_length + 2
    const temporary = allocator.allocFn(allocator.context, temporary_capacity, 1)
    if temporary == null { return invalid(allocator) }
    const bytes = temporary.?
    var length: usize = 0
    var index: usize = 0
    while index < left_length {
        bytes[length] = left[index]
        length += 1
        index += 1
    }
    if length > 0 && bytes[length - 1] != 47 {
        bytes[length] = 47
        length += 1
    }
    index = 0
    while index < right_length {
        bytes[length] = right[index]
        length += 1
        index += 1
    }
    const result = normalize(allocator, bytes, length)
    allocator.freeFn(allocator.context, bytes, temporary_capacity, 1)
    return result
}

pub fn resolveRelative(allocator: Allocator, importer: [*]const u8, importer_length: usize, requested: [*]const u8, requested_length: usize) -> OwnedPath {
    const parent_length = parentLength(importer, importer_length)
    if parent_length == 0 { return normalize(allocator, requested, requested_length) }
    return combine(allocator, importer, parent_length, requested, requested_length)
}

pub fn resolveStandard(allocator: Allocator, std_root: [*]const u8, std_root_length: usize, requested: [*]const u8, requested_length: usize) -> OwnedPath {
    if requested_length < 3 { return invalid(allocator) }
    const suffix_start: usize = if requested_length == 3 { 3 } else { 4 }
    const suffix_length = requested_length - suffix_start
    const relative_capacity = suffix_length + 8
    const relative = allocator.allocFn(allocator.context, relative_capacity, 1)
    if relative == null { return invalid(allocator) }
    const bytes = relative.?
    var length: usize = 0
    if suffix_length == 0 {
        for byte in "std.zin" {
            bytes[length] = byte
            length += 1
        }
    }
    if suffix_length > 0 {
        var index: usize = 0
        while index < suffix_length {
            const value = requested[suffix_start + index]
            bytes[length] = if value == 46 { 47 } else { value }
            length += 1
            index += 1
        }
        for byte in ".zin" {
            bytes[length] = byte
            length += 1
        }
    }
    const result = combine(allocator, std_root, std_root_length, bytes, length)
    allocator.freeFn(allocator.context, bytes, relative_capacity, 1)
    return result
}

pub fn copy(allocator: Allocator, pointer: [*]const u8, length: usize) -> OwnedPath {
    return normalize(allocator, pointer, length)
}

pub fn deinit(value: OwnedPath) -> void {
    if value.capacity > 0 { value.freeFn(value.allocatorContext, value.pointer, value.capacity, 1) }
}
