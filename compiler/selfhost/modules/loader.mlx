const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const source_module = @import("../source.mlx")
const lexer = @import("../lexer.mlx")
const parser_module = @import("../parser.mlx")
const symbols_module = @import("../symbols.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const model = @import("./model.mlx")
const path = @import("./path.mlx")
const store_module = @import("./store.mlx")
const packages_module = @import("./packages.mlx")
const time = @import("../../../std/bootstrap/time.mlx")

pub const Allocator = allocator_module.Allocator
pub const Module = model.Module
pub const Import = model.Import
pub const Store = store_module.Store
pub const PackageMap = packages_module.Map
pub const SourceFile = source_module.SourceFile
pub const Buffer = lexer.Buffer
pub const NodeStore = ast_store.Store
pub const OwnedPath = path.OwnedPath
pub const Scope = symbols_module.Scope

const StringContent = struct {
    valid: bool
    pointer: [*]const u8
    length: usize
}

pub const Loader = struct {
    store: *Store
    stdRootPointer: [*]const u8
    stdRootLength: usize
    packagesAddress: usize
    sourceBytes: usize
    tokenCount: usize
    nodeCount: usize
    declarationCount: usize
    functionCount: usize
    sourceLoadNanoseconds: usize
    lexerNanoseconds: usize
    parserNanoseconds: usize
    firstSyntaxModule: usize
    firstSyntaxByte: usize
    firstSyntaxLength: usize
    firstSyntaxIsLexer: bool
    allocator: Allocator

pub fn allocatorFor(loader: *Self) -> Allocator {
    return loader.*.allocator
}

pub fn create(allocator: Allocator, std_root: [*]const u8, std_root_length: usize, packages: ?*PackageMap) -> *Self {
    const loader_memory = allocator.alloc(@sizeOf(Self), @alignOf(Self)).?
    const store_memory = allocator.alloc(@sizeOf(Store), @alignOf(Store)).?
    unsafe {
        const loader = @ptrCast(*Self, loader_memory)
        const module_store = @ptrCast(*Store, store_memory)
        Store.initAt(module_store, allocator, 16)
        loader.*.store = module_store
        loader.*.stdRootPointer = std_root
        loader.*.stdRootLength = std_root_length
        loader.*.packagesAddress = if packages == null { 0 } else { @intFromPtr(packages.?) }
        loader.*.sourceBytes = 0
        loader.*.tokenCount = 0
        loader.*.nodeCount = 0
        loader.*.declarationCount = 0
        loader.*.functionCount = 0
        loader.*.sourceLoadNanoseconds = 0
        loader.*.lexerNanoseconds = 0
        loader.*.parserNanoseconds = 0
        loader.*.firstSyntaxModule = model.NONE
        loader.*.firstSyntaxByte = 0
        loader.*.firstSyntaxLength = 0
        loader.*.firstSyntaxIsLexer = false
        loader.*.allocator = allocator
        return loader
    }
}

fn tokenEquals(source: []const u8, tokens: Buffer, token_index: usize, expected: []const u8) -> bool {
    const token = lexer.tokenAt(tokens, token_index)
    var expected_length: usize = 0
    for byte in expected { expected_length += 1 }
    if token.length != expected_length { return false }
    var index: usize = 0
    while index < expected_length {
        if source[token.start + index] != expected[index] { return false }
        index += 1
    }
    return true
}

fn stringContent(source: []const u8, tokens: Buffer, nodes: *NodeStore, node_index: usize) -> StringContent {
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag != ast.Tag.string_literal { unsafe { return StringContent.{ .valid = false, .pointer = @ptrFromInt([*]const u8, 0), .length = 0 } } }
    const token = lexer.tokenAt(tokens, node.mainToken)
    if token.length < 2 { unsafe { return StringContent.{ .valid = false, .pointer = @ptrFromInt([*]const u8, 0), .length = 0 } } }
    var byte: usize = 1
    while byte + 1 < token.length {
        if source[token.start + byte] == 92 { unsafe { return StringContent.{ .valid = false, .pointer = @ptrFromInt([*]const u8, 0), .length = 0 } } }
        byte += 1
    }
    unsafe {
        const source_pointer = @ptrCast([*]const u8, source)
        return StringContent.{ .valid = true, .pointer = @ptrFromInt([*]const u8, @intFromPtr(source_pointer) + token.start + 1), .length = token.length - 2 }
    }
}

fn resolveImport(loader: *Self, importer: *Module, requested: [*]const u8, requested_length: usize) -> OwnedPath {
    const allocator = Self.allocatorFor(loader)
    const kind = path.classify(requested, requested_length)
    if kind == model.ImportKind.relative {
        unsafe { return path.resolveRelative(allocator, @ptrCast([*]const u8, importer.*.pathPointer), importer.*.pathLength, requested, requested_length) }
    }
    if kind == model.ImportKind.standard {
        return path.resolveStandard(allocator, loader.*.stdRootPointer, loader.*.stdRootLength, requested, requested_length)
    }
    if kind == model.ImportKind.builtin { return path.copy(allocator, requested, requested_length) }
    if kind == model.ImportKind.package && loader.*.packagesAddress != 0 {
        unsafe {
            const packages = @ptrFromInt(*PackageMap, loader.*.packagesAddress)
            const found = packages_module.get(packages, requested, requested_length)
            if found.found { return path.copy(allocator, found.rootPointer, found.rootLength) }
        }
    }
    return path.invalid(allocator)
}

fn appendNewModule(loader: *Self, owned: *OwnedPath) -> usize {
    var value = Module.{
        .id = loader.*.store.*.moduleLength,
        .pathPointer = owned.*.pointer,
        .pathLength = owned.*.length,
        .pathCapacity = owned.*.capacity,
        .state = model.State.discovered,
        .sourceAddress = 0,
        .tokensAddress = 0,
        .nodesAddress = 0,
        .scopeAddress = 0,
        .rootNode = model.NONE,
        .symbolStart = 0,
        .symbolCount = 0,
        .moduleType = 0,
        .errorCount = 0,
    }
    return store_module.Store.appendModule(loader.*.store, &value)
}

fn allocateSource(loader: *Self) -> *SourceFile {
    unsafe { return @ptrCast(*SourceFile, loader.*.allocator.alloc(@sizeOf(SourceFile), @alignOf(SourceFile)).?) }
}

fn allocateTokens(loader: *Self) -> *Buffer {
    unsafe { return @ptrCast(*Buffer, loader.*.allocator.alloc(@sizeOf(Buffer), @alignOf(Buffer)).?) }
}

fn allocateNodes(loader: *Self) -> *NodeStore {
    unsafe { return @ptrCast(*NodeStore, loader.*.allocator.alloc(@sizeOf(NodeStore), @alignOf(NodeStore)).?) }
}

fn recordSyntaxError(loader: *Self, module_id: usize, byte_start: usize, byte_length: usize, is_lexer: bool) -> void {
    if loader.*.firstSyntaxModule != model.NONE { return }
    loader.*.firstSyntaxModule = module_id
    loader.*.firstSyntaxByte = byte_start
    loader.*.firstSyntaxLength = if byte_length > 0 { byte_length } else { 1 }
    loader.*.firstSyntaxIsLexer = is_lexer
}

fn loadSourceAndSyntax(loader: *Self, module_id: usize) -> bool {
    var module = Store.moduleAt(loader.*.store, module_id)
    const source_file = Self.allocateSource(loader)
    const source_started = time.monotonicNanoseconds()
    unsafe { source_module.loadInto(source_file, Self.allocatorFor(loader), @ptrCast([*]const u8, module.*.pathPointer), module.*.pathLength) }
    loader.*.sourceLoadNanoseconds += time.elapsedNanoseconds(source_started, time.monotonicNanoseconds())
    module = Store.moduleAt(loader.*.store, module_id)
    module.*.sourceAddress = @intFromPtr(source_file)
    if !source_file.*.valid {
        module.*.errorCount += 1
        return false
    }
    const source = source_module.contents(source_file.*)
    loader.*.sourceBytes += source_file.*.length
    const token_buffer = Self.allocateTokens(loader)
    const lexer_started = time.monotonicNanoseconds()
    lexer.scanAllLengthInto(token_buffer, Self.allocatorFor(loader), source, source_file.*.length)
    loader.*.lexerNanoseconds += time.elapsedNanoseconds(lexer_started, time.monotonicNanoseconds())
    loader.*.tokenCount += token_buffer.*.length
    module = Store.moduleAt(loader.*.store, module_id)
    module.*.tokensAddress = @intFromPtr(token_buffer)
    var token_index: usize = 0
    while token_index < token_buffer.*.length {
        const current_token = lexer.tokenAt(token_buffer.*, token_index)
        if current_token.kind == lexer.Kind.invalid {
            module.*.errorCount += 1
            Self.recordSyntaxError(loader, module_id, current_token.start, current_token.length, true)
        }
        token_index += 1
    }
    const nodes = Self.allocateNodes(loader)
    parser_module.initStoreAt(nodes, Self.allocatorFor(loader), token_buffer.*.length * 2 / 3 + 32)
    var parser = parser_module.initLength(source, source_file.*.length, token_buffer.*, nodes)
    const parser_started = time.monotonicNanoseconds()
    const root = parser_module.parse(&parser)
    loader.*.parserNanoseconds += time.elapsedNanoseconds(parser_started, time.monotonicNanoseconds())
    loader.*.nodeCount += nodes.*.length
    module = Store.moduleAt(loader.*.store, module_id)
    module.*.nodesAddress = @intFromPtr(nodes)
    module.*.rootNode = root
    module.*.errorCount += parser.errorCount
    if parser.errorCount > 0 && parser.firstErrorToken < token_buffer.*.length {
        const first_error = lexer.tokenAt(token_buffer.*, parser.firstErrorToken)
        Self.recordSyntaxError(loader, module_id, first_error.start, first_error.length, false)
    }
    return root != model.NONE && parser.errorCount == 0
}

fn loadImportNode(loader: *Self, module_id: usize, node_index: usize, source: []const u8, tokens: Buffer, nodes: *NodeStore) -> void {
    const node = NodeStore.get(nodes, node_index)
    const requested = Self.stringContent(source, tokens, nodes, node.lhs)
    var module = Store.moduleAt(loader.*.store, module_id)
    if !requested.valid {
        module.*.errorCount += 1
        return
    }
    var resolved = Self.resolveImport(loader, module, requested.pointer, requested.length)
    if !resolved.valid {
        module = Store.moduleAt(loader.*.store, module_id)
        module.*.errorCount += 1
        return
    }
    const target = Self.loadOwned(loader, &resolved)
    var edge = Import.{ .owner = module_id, .node = node_index, .target = target }
    if target == model.NONE || !Store.appendImport(loader.*.store, &edge) {
        module = Store.moduleAt(loader.*.store, module_id)
        module.*.errorCount += 1
    }
}

fn discoverImports(loader: *Self, module_id: usize) -> void {
    const module = Store.moduleAt(loader.*.store, module_id)
    unsafe {
        const source_file = @ptrFromInt(*SourceFile, module.*.sourceAddress)
        const tokens = @ptrFromInt(*Buffer, module.*.tokensAddress)
        const nodes = @ptrFromInt(*NodeStore, module.*.nodesAddress)
        const source = source_module.contents(source_file.*)
        var node_index: usize = 0
        while node_index < nodes.*.length {
            const node = NodeStore.get(nodes, node_index)
            if node.tag == ast.Tag.function_declaration {
                loader.*.declarationCount += 1
                loader.*.functionCount += 1
            }
            if node.tag == ast.Tag.constant_declaration || node.tag == ast.Tag.variable_declaration || node.tag == ast.Tag.test_declaration {
                loader.*.declarationCount += 1
            }
            if node.tag == ast.Tag.builtin_call && node.rhs == 1 && Self.tokenEquals(source, tokens.*, node.mainToken, "import") {
                Self.loadImportNode(loader, module_id, node_index, source, tokens.*, nodes)
            }
            node_index += 1
        }
    }
}

fn loadOwned(loader: *Self, owned: *OwnedPath) -> usize {
    const existing = Store.findModule(loader.*.store, owned.*.pointer, owned.*.length)
    if existing.0 {
        path.deinit(owned.*)
        return existing.1
    }
    const module_id = Self.appendNewModule(loader, owned)
    if module_id == model.NONE {
        path.deinit(owned.*)
        return model.NONE
    }
    var module = Store.moduleAt(loader.*.store, module_id)
    module.*.state = model.State.loading
    if path.classify(module.*.pathPointer, module.*.pathLength) == model.ImportKind.builtin {
        module.*.state = model.State.loaded
        return module_id
    }
    if !Self.loadSourceAndSyntax(loader, module_id) {
        module = Store.moduleAt(loader.*.store, module_id)
        module.*.state = model.State.failed
        return module_id
    }
    Self.discoverImports(loader, module_id)
    module = Store.moduleAt(loader.*.store, module_id)
    module.*.state = if module.*.errorCount == 0 { model.State.loaded } else { model.State.failed }
    return module_id
}

pub fn loadRoot(loader: *Self, pointer: [*]const u8, length: usize) -> usize {
    var owned = path.copy(Self.allocatorFor(loader), pointer, length)
    if !owned.valid { return model.NONE }
    return Self.loadOwned(loader, &owned)
}

pub inline fn moduleAt(loader: *Self, id: usize) -> *Module {
    return Store.moduleAt(loader.*.store, id)
}

pub inline fn moduleCount(loader: *Self) -> usize { return loader.*.store.*.moduleLength }
pub inline fn importCount(loader: *Self) -> usize { return loader.*.store.*.importLength }
pub fn sourceByteCount(loader: *Self) -> usize { return loader.*.sourceBytes }
pub fn totalTokenCount(loader: *Self) -> usize { return loader.*.tokenCount }
pub fn totalNodeCount(loader: *Self) -> usize { return loader.*.nodeCount }
pub fn totalDeclarationCount(loader: *Self) -> usize { return loader.*.declarationCount }
pub fn totalFunctionCount(loader: *Self) -> usize { return loader.*.functionCount }
pub fn sourceLoadTime(loader: *Self) -> usize { return loader.*.sourceLoadNanoseconds }
pub fn lexerTime(loader: *Self) -> usize { return loader.*.lexerNanoseconds }
pub fn parserTime(loader: *Self) -> usize { return loader.*.parserNanoseconds }
pub fn hasSyntaxError(loader: *Self) -> bool { return loader.*.firstSyntaxModule != model.NONE }
pub fn syntaxErrorModule(loader: *Self) -> usize { return loader.*.firstSyntaxModule }
pub fn syntaxErrorByte(loader: *Self) -> usize { return loader.*.firstSyntaxByte }
pub fn syntaxErrorLength(loader: *Self) -> usize { return loader.*.firstSyntaxLength }
pub fn syntaxErrorIsLexer(loader: *Self) -> bool { return loader.*.firstSyntaxIsLexer }

// Each module already tracks its own errorCount as declarations/bodies are
// analyzed, so a pipeline-level failure that only has an aggregate error
// count can still point at a real file by picking the first module that
// recorded one.
pub fn firstErroringModule(loader: *Self) -> usize {
    var index: usize = 0
    while index < Self.moduleCount(loader) {
        if Store.moduleAt(loader.*.store, index).*.errorCount > 0 { return index }
        index += 1
    }
    return model.NONE
}

pub fn moduleSource(loader: *Self, id: usize) -> []const u8 {
    const module = Store.moduleAt(loader.*.store, id)
    if module.*.sourceAddress == 0 { return "" }
    unsafe {
        const source_file = @ptrFromInt(*SourceFile, module.*.sourceAddress)
        return source_module.contents(source_file.*)
    }
}

pub fn modulePath(loader: *Self, id: usize) -> []const u8 {
    const module = Store.moduleAt(loader.*.store, id)
    unsafe { return @ptrCast([*]const u8, module.*.pathPointer)[0..module.*.pathLength] }
}

pub fn deinit(loader: *Self) -> void {
    const loader_address = @intFromPtr(loader)
    var index: usize = 0
    while index < loader.*.store.*.moduleLength {
        const module = Store.moduleAt(loader.*.store, index)
        if module.*.scopeAddress != 0 {
            unsafe {
                const scope = @ptrFromInt(*Scope, module.*.scopeAddress)
                symbols_module.deinitScope(scope)
                loader.*.allocator.free(@ptrCast([*]u8, scope), @sizeOf(Scope), @alignOf(Scope))
            }
        }
        if module.*.nodesAddress != 0 {
            unsafe {
                const nodes = @ptrFromInt(*NodeStore, module.*.nodesAddress)
                parser_module.deinitStore(nodes)
                loader.*.allocator.free(@ptrCast([*]u8, nodes), @sizeOf(NodeStore), @alignOf(NodeStore))
            }
        }
        if module.*.tokensAddress != 0 {
            unsafe {
                const tokens = @ptrFromInt(*Buffer, module.*.tokensAddress)
                lexer.deinit(tokens.*)
                loader.*.allocator.free(@ptrCast([*]u8, tokens), @sizeOf(Buffer), @alignOf(Buffer))
            }
        }
        if module.*.sourceAddress != 0 {
            unsafe {
                const source = @ptrFromInt(*SourceFile, module.*.sourceAddress)
                source_module.deinit(source.*)
                loader.*.allocator.free(@ptrCast([*]u8, source), @sizeOf(SourceFile), @alignOf(SourceFile))
            }
        }
        if module.*.pathCapacity > 0 { loader.*.allocator.free(module.*.pathPointer, module.*.pathCapacity, 1) }
        index += 1
    }
    Store.deinit(loader.*.store)
    unsafe { loader.*.allocator.free(@ptrCast([*]u8, loader.*.store), @sizeOf(Store), @alignOf(Store)) }
    unsafe { loader.*.allocator.free(@ptrFromInt([*]u8, loader_address), @sizeOf(Self), @alignOf(Self)) }
}
}
