const allocator_module = @import("../../../std/bootstrap/allocator.zin")
const mem = @import("../../../std/bootstrap/mem.zin")
const model = @import("./model.zin")

pub const Allocator = allocator_module.Allocator
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn
pub const Module = model.Module
pub const Import = model.Import

pub const Store = struct {
    modules: [*]u8
    moduleLength: usize
    moduleCapacity: usize
    imports: [*]u8
    importLength: usize
    importCapacity: usize
    allocatorContext: usize
    resizeFn: ResizeFn
    freeFn: FreeFn
}

pub fn init(allocator: Allocator, capacity: usize) -> Store {
    const initial = if capacity > 0 { capacity } else { 16 }
    return Store.{
        .modules = allocator.allocFn(allocator.context, initial * @sizeOf(Module), @alignOf(Module)).?,
        .moduleLength = 0,
        .moduleCapacity = initial,
        .imports = allocator.allocFn(allocator.context, initial * 2 * @sizeOf(Import), @alignOf(Import)).?,
        .importLength = 0,
        .importCapacity = initial * 2,
        .allocatorContext = allocator.context,
        .resizeFn = allocator.resizeFn,
        .freeFn = allocator.freeFn,
    }
}

pub fn initAt(store: *Store, allocator: Allocator, capacity: usize) -> void {
    const initial = if capacity > 0 { capacity } else { 16 }
    store.*.modules = allocator.allocFn(allocator.context, initial * @sizeOf(Module), @alignOf(Module)).?
    store.*.moduleLength = 0
    store.*.moduleCapacity = initial
    store.*.imports = allocator.allocFn(allocator.context, initial * 2 * @sizeOf(Import), @alignOf(Import)).?
    store.*.importLength = 0
    store.*.importCapacity = initial * 2
    store.*.allocatorContext = allocator.context
    store.*.resizeFn = allocator.resizeFn
    store.*.freeFn = allocator.freeFn
}

fn ensureModules(store: *Store, minimum: usize) -> bool {
    if minimum <= store.*.moduleCapacity { return true }
    var capacity = store.*.moduleCapacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = store.*.resizeFn(
        store.*.allocatorContext,
        store.*.modules,
        store.*.moduleCapacity * @sizeOf(Module),
        capacity * @sizeOf(Module),
        @alignOf(Module),
    )
    if resized == null { return false }
    store.*.modules = resized.?
    store.*.moduleCapacity = capacity
    return true
}

fn ensureImports(store: *Store, minimum: usize) -> bool {
    if minimum <= store.*.importCapacity { return true }
    var capacity = store.*.importCapacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = store.*.resizeFn(
        store.*.allocatorContext,
        store.*.imports,
        store.*.importCapacity * @sizeOf(Import),
        capacity * @sizeOf(Import),
        @alignOf(Import),
    )
    if resized == null { return false }
    store.*.imports = resized.?
    store.*.importCapacity = capacity
    return true
}

pub fn moduleAt(store: *Store, index: usize) -> *Module {
    unsafe { return @ptrFromInt(*Module, @intFromPtr(store.*.modules) + index * @sizeOf(Module)) }
}

pub fn importAt(store: *Store, index: usize) -> *Import {
    unsafe { return @ptrFromInt(*Import, @intFromPtr(store.*.imports) + index * @sizeOf(Import)) }
}

pub fn appendModule(store: *Store, value: *Module) -> usize {
    if !ensureModules(store, store.*.moduleLength + 1) { return model.NONE }
    const index = store.*.moduleLength
    unsafe { mem.copy(@ptrCast([*]u8, moduleAt(store, index)), @ptrCast([*]const u8, value), @sizeOf(Module)) }
    store.*.moduleLength += 1
    return index
}

pub fn appendImport(store: *Store, value: *Import) -> bool {
    if !ensureImports(store, store.*.importLength + 1) { return false }
    unsafe { mem.copy(@ptrCast([*]u8, importAt(store, store.*.importLength)), @ptrCast([*]const u8, value), @sizeOf(Import)) }
    store.*.importLength += 1
    return true
}

fn samePath(module: *Module, pointer: [*]const u8, length: usize) -> bool {
    if module.*.pathLength != length { return false }
    var index: usize = 0
    while index < length {
        if module.*.pathPointer[index] != pointer[index] { return false }
        index += 1
    }
    return true
}

pub fn findModule(store: *Store, pointer: [*]const u8, length: usize) -> (bool, usize) {
    var index: usize = 0
    while index < store.*.moduleLength {
        if samePath(moduleAt(store, index), pointer, length) { return -> (true, index) }
        index += 1
    }
    return -> (false, 0)
}

pub fn findImport(store: *Store, owner: usize, node: usize) -> (bool, usize) {
    var index: usize = 0
    while index < store.*.importLength {
        const edge = importAt(store, index)
        if edge.*.owner == owner && edge.*.node == node { return -> (true, edge.*.target) }
        index += 1
    }
    return -> (false, 0)
}

pub fn deinit(store: *Store) -> void {
    store.*.freeFn(store.*.allocatorContext, store.*.imports, store.*.importCapacity * @sizeOf(Import), @alignOf(Import))
    store.*.freeFn(store.*.allocatorContext, store.*.modules, store.*.moduleCapacity * @sizeOf(Module), @alignOf(Module))
    store.*.moduleLength = 0
    store.*.importLength = 0
}
