const allocator_module = @import("../../../../std/bootstrap/allocator.zin")
const array_list = @import("../../../../std/bootstrap/array_list.zin")
const vector = @import("../../../../std/bootstrap/vector.zin")
const mem = @import("../../../../std/bootstrap/mem.zin")
const encoder = @import("./encoder.zin")
const target = @import("./target.zin")
const lir_module = @import("../../ir/lir.zin")

pub const VregMap = struct {
    key: usize
    value: i32
}

pub const Codegen = struct {
    enc: *encoder.Encoder
    lir: *lir_module.Lir
    nextStackSlot: i32
    vregSlots: *vector.Vector
    secondarySlots: *vector.Vector
    addrSlots: *vector.Vector
    labelNames: *vector.Vector
    frameSize: usize
    rodataOffset: usize
    allocatorContext: usize
    allocFn: allocator_module.AllocFn
    resizeFn: allocator_module.ResizeFn
    freeFn: allocator_module.FreeFn
}

pub fn init(alloc: allocator_module.Allocator, enc: *encoder.Encoder, lir: *lir_module.Lir) -> Codegen {
    unsafe {
        const vreg_slots = @ptrCast(*vector.Vector, alloc.allocFn(alloc.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const secondary_slots = @ptrCast(*vector.Vector, alloc.allocFn(alloc.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const addr_slots = @ptrCast(*vector.Vector, alloc.allocFn(alloc.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const label_names = @ptrCast(*vector.Vector, alloc.allocFn(alloc.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        vector.initAt(vreg_slots, alloc, @sizeOf(VregMap), @alignOf(VregMap), 64)
        vector.initAt(secondary_slots, alloc, @sizeOf(VregMap), @alignOf(VregMap), 32)
        vector.initAt(addr_slots, alloc, @sizeOf(VregMap), @alignOf(VregMap), 64)
        vector.initAt(label_names, alloc, @sizeOf(array_list.ArrayList), @alignOf(array_list.ArrayList), 32)
        return Codegen.{
            .enc = enc,
            .lir = lir,
            .nextStackSlot = 8,
            .vregSlots = vreg_slots,
            .secondarySlots = secondary_slots,
            .addrSlots = addr_slots,
            .labelNames = label_names,
            .frameSize = 0,
            .rodataOffset = 0,
            .allocatorContext = alloc.context,
            .allocFn = alloc.allocFn,
            .resizeFn = alloc.resizeFn,
            .freeFn = alloc.freeFn,
        }
    }
}

pub fn deinit(gen: *Codegen) -> void {
    var index: usize = 0
    while index < gen.*.labelNames.*.length {
        unsafe {
            const label = @ptrCast(*array_list.ArrayList, vector.at(gen.*.labelNames.*, index))
            array_list.deinit(label.*)
        }
        index += 1
    }
    vector.deinit(gen.*.vregSlots.*)
    vector.deinit(gen.*.secondarySlots.*)
    vector.deinit(gen.*.addrSlots.*)
    vector.deinit(gen.*.labelNames.*)
    unsafe {
        gen.*.freeFn(gen.*.allocatorContext, @ptrCast([*]u8, gen.*.vregSlots), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        gen.*.freeFn(gen.*.allocatorContext, @ptrCast([*]u8, gen.*.secondarySlots), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        gen.*.freeFn(gen.*.allocatorContext, @ptrCast([*]u8, gen.*.addrSlots), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        gen.*.freeFn(gen.*.allocatorContext, @ptrCast([*]u8, gen.*.labelNames), @sizeOf(vector.Vector), @alignOf(vector.Vector))
    }
}

fn vregSlotsPointer(gen: *Codegen) -> *vector.Vector {
    return gen.*.vregSlots
}

fn addrSlotsPointer(gen: *Codegen) -> *vector.Vector {
    return gen.*.addrSlots
}

fn secondarySlotsPointer(gen: *Codegen) -> *vector.Vector {
    return gen.*.secondarySlots
}

fn retainLabelName(gen: *Codegen, label: *array_list.ArrayList) -> void {
    unsafe {
        const appended = vector.appendAt(gen.*.labelNames, @ptrCast([*]const u8, label))
    }
}

fn getMap(vec: *vector.Vector, key: usize) -> (bool, i32) {
    var i: usize = 0
    while i < vec.*.length {
        unsafe {
            const entry = @ptrCast(*VregMap, vector.at(vec.*, i))
            if entry.*.key == key {
                return -> (true, entry.*.value)
            }
        }
        i = i + 1
    }
    return -> (false, 0)
}

fn putMap(vec: *vector.Vector, key: usize, value: i32) -> void {
    var entry = VregMap.{ .key = key, .value = value }
    unsafe {
        const appended = vector.appendAt(vec, @ptrCast([*]const u8, &entry))
    }
}

pub fn allocateOp(gen: *Codegen, vreg: usize) -> i32 {
    const found = getMap(gen.*.vregSlots, vreg)
    if found.0 { return found.1 }
    const slot = gen.*.nextStackSlot
    gen.*.nextStackSlot = slot + 8
    putMap(vregSlotsPointer(gen), vreg, slot)
    return slot
}

pub fn getOrAllocSlot(gen: *Codegen, var_id: usize) -> i32 {
    const found = getMap(gen.*.addrSlots, var_id)
    if found.0 { return found.1 }
    const slot = gen.*.nextStackSlot
    gen.*.nextStackSlot = slot + 8
    putMap(addrSlotsPointer(gen), var_id, slot)
    return slot
}

fn allocateSecondaryOp(gen: *Codegen, vreg: usize) -> i32 {
    const found = getMap(gen.*.secondarySlots, vreg)
    if found.0 { return found.1 }
    const slot = gen.*.nextStackSlot
    gen.*.nextStackSlot = slot + 8
    putMap(secondarySlotsPointer(gen), vreg, slot)
    return slot
}

pub fn beginFunction(gen: *Codegen) -> void {
    gen.*.vregSlots.*.length = 0
    gen.*.secondarySlots.*.length = 0
    gen.*.addrSlots.*.length = 0
    gen.*.nextStackSlot = 8
    gen.*.frameSize = 4096 
}

pub fn blockLabelName(gen: *Codegen, index: usize) -> array_list.ArrayList {
    var alloc = allocator_module.Allocator.{
        .context = gen.*.allocatorContext,
        .allocFn = gen.*.allocFn,
        .resizeFn = gen.*.resizeFn,
        .freeFn = gen.*.freeFn,
    }
    var list = array_list.init(alloc, 16)
    list = array_list.append(list, 46) // .
    list = array_list.append(list, 98) // b
    list = array_list.append(list, 108) // l
    list = array_list.append(list, 111) // o
    list = array_list.append(list, 99) // c
    list = array_list.append(list, 107) // k
    list = array_list.append(list, 95) // _
    
    if index == 0 {
        list = array_list.append(list, 48)
    } else {
        var temp: usize = index
        var rev = array_list.init(alloc, 16)
        while temp > 0 {
            const digit = temp % 10
            rev = array_list.append(rev, @intCast(u8, 48 + digit))
            temp = temp / 10
        }
        var i: usize = rev.length
        while i > 0 {
            i = i - 1
            list = array_list.append(list, array_list.get(rev, i))
        }
        array_list.deinit(rev)
    }
    return list
}

pub fn emitStartStub(gen: *Codegen) -> void {
    var start_name: [*]const u8 = undefined
    var main_name: [*]const u8 = undefined
    unsafe {
        start_name = @ptrCast([*]const u8, "_start")
        main_name = @ptrCast([*]const u8, "main")
    }
    encoder.defineSymbol(gen.*.enc, start_name, 6)
    
    encoder.emit1(gen.*.enc, 0x48)
    encoder.emit1(gen.*.enc, 0x8B)
    encoder.emit1(gen.*.enc, 0x34)
    encoder.emit1(gen.*.enc, 0x24)

    encoder.emit1(gen.*.enc, 0x48)
    encoder.emit1(gen.*.enc, 0x8D)
    encoder.emit1(gen.*.enc, 0x7C)
    encoder.emit1(gen.*.enc, 0x24)
    encoder.emit1(gen.*.enc, 0x08)

    encoder.emitCallRel(gen.*.enc, main_name, 4)

    encoder.emitMovRegReg(gen.*.enc, target.Register.rdi, target.Register.rax)
    encoder.emitMovRegImm64(gen.*.enc, target.Register.rax, 60)
    encoder.emitSyscall(gen.*.enc)
}

pub fn generateBinary(gen: *Codegen) -> void {
    emitStartStub(gen)
    
    var inst_idx: usize = 0
    const count = lir_module.instCount(gen.*.lir)
    while inst_idx < count {
        const inst = lir_module.getInst(gen.*.lir, inst_idx)
        
        match inst.opcode {
            lir_module.Opcode.label => {
                if inst.arg0 != lir_module.NONE {
                    beginFunction(gen)
                    const sym = lir_module.getSymbol(gen.*.lir, inst.arg0)
                    encoder.defineSymbol(gen.*.enc, sym.pointer, sym.length)
                    encoder.emitPushRbp(gen.*.enc)
                    encoder.emitMovRbpRsp(gen.*.enc)
                    encoder.emitSubRspImm32(gen.*.enc, @intCast(u32, gen.*.frameSize))
                } else if inst.arg1 != lir_module.NONE {
                    var label_str = blockLabelName(gen, inst.arg1)
                    retainLabelName(gen, &label_str)
                    encoder.defineSymbol(gen.*.enc, label_str.items, label_str.length)
                }
            },
            lir_module.Opcode.param => {
                const param_idx = inst.arg0
                const slot = allocateOp(gen, inst_idx)
                const reg = target.argReg(param_idx)
                encoder.emitMovMemReg(gen.*.enc, slot, reg)
            },
            lir_module.Opcode.const_i => {
                const slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegImm64(gen.*.enc, target.Register.rax, @bitCast(i64, @intCast(u64, inst.arg0)))
                encoder.emitMovMemReg(gen.*.enc, slot, target.Register.rax)
            },
            lir_module.Opcode.addr => {
                const var_id = inst.arg0
                const slot = getOrAllocSlot(gen, var_id)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitLeaRegMem(gen.*.enc, target.Register.rax, slot)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.alloca => {
                const slot = gen.*.nextStackSlot
                gen.*.nextStackSlot = slot + 8
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitLeaRegMem(gen.*.enc, target.Register.rax, slot)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.gep => {
                const base_slot = allocateOp(gen, inst.arg0)
                const index_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, base_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, index_slot)
                const stride: i64 = @bitCast(i64, @intCast(u64, inst.arg2))
                encoder.emitMovRegImm64(gen.*.enc, target.Register.rdx, stride)
                encoder.emitIMul(gen.*.enc, target.Register.rcx, target.Register.rdx)
                encoder.emitAdd(gen.*.enc, target.Register.rax, target.Register.rcx)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.store => {
                const ptr_slot = allocateOp(gen, inst.arg0)
                const val_slot = allocateOp(gen, inst.arg1)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, val_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, ptr_slot)
                encoder.emit1(gen.*.enc, 0x48)
                encoder.emit1(gen.*.enc, 0x89)
                encoder.emit1(gen.*.enc, 0x01)
            },
            lir_module.Opcode.load => {
                const ptr_slot = allocateOp(gen, inst.arg0)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, ptr_slot)
                encoder.emit1(gen.*.enc, 0x48)
                encoder.emit1(gen.*.enc, 0x8B)
                encoder.emit1(gen.*.enc, 0x00)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.add => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitAdd(gen.*.enc, target.Register.rax, target.Register.rcx)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.sub => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitSub(gen.*.enc, target.Register.rax, target.Register.rcx)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.mul => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitIMul(gen.*.enc, target.Register.rax, target.Register.rcx)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.div => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitCqo(gen.*.enc)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitDivide(gen.*.enc, target.Register.rcx, true)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.rem => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitCqo(gen.*.enc)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitDivide(gen.*.enc, target.Register.rcx, true)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rdx)
            },
            lir_module.Opcode.bit_and => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitAnd(gen.*.enc, target.Register.rax, target.Register.rcx)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.bit_or => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitOr(gen.*.enc, target.Register.rax, target.Register.rcx)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.bit_xor => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitXor(gen.*.enc, target.Register.rax, target.Register.rcx)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.shl => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitShiftCl(gen.*.enc, target.Register.rax, true, false)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.shr => {
                const lhs_slot = allocateOp(gen, inst.arg0)
                const rhs_slot = allocateOp(gen, inst.arg1)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitShiftCl(gen.*.enc, target.Register.rax, false, false)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.icmp => {
                const pred = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, inst.arg0))
                const lhs_slot = allocateOp(gen, inst.arg1)
                const rhs_slot = allocateOp(gen, inst.arg2)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, lhs_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rcx, rhs_slot)
                encoder.emitCmp(gen.*.enc, target.Register.rax, target.Register.rcx)
                
                var enc_cond = encoder.Condition.equal
                match pred {
                    lir_module.CmpPredicate.eq => { enc_cond = encoder.Condition.equal },
                    lir_module.CmpPredicate.ne => { enc_cond = encoder.Condition.not_equal },
                    lir_module.CmpPredicate.lt => { enc_cond = encoder.Condition.less },
                    lir_module.CmpPredicate.le => { enc_cond = encoder.Condition.less_equal },
                    lir_module.CmpPredicate.gt => { enc_cond = encoder.Condition.greater },
                    lir_module.CmpPredicate.ge => { enc_cond = encoder.Condition.greater_equal },
                    lir_module.CmpPredicate.ult => { enc_cond = encoder.Condition.below },
                    lir_module.CmpPredicate.ule => { enc_cond = encoder.Condition.below_equal },
                    lir_module.CmpPredicate.ugt => { enc_cond = encoder.Condition.above },
                    lir_module.CmpPredicate.uge => { enc_cond = encoder.Condition.above_equal },
                    else => { enc_cond = encoder.Condition.equal },
                }
                
                encoder.emitSetcc(gen.*.enc, target.Register.rax, enc_cond)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.func_sym => {
                const sym = lir_module.getSymbol(gen.*.lir, inst.arg0)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitLeaRipRel(gen.*.enc, target.Register.rax, sym.pointer, sym.length)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.string_literal => {
                const lit = lir_module.getStringLiteral(gen.*.lir, inst.arg0)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitLeaRipRel(gen.*.enc, target.Register.rax, lit.pointer, lit.length)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.tuple_literal => {
                const primary_slot = allocateOp(gen, inst_idx)
                const secondary_slot = allocateSecondaryOp(gen, inst_idx)
                if inst.arg1 > 0 {
                    const first_slot = allocateOp(gen, lir_module.getExtra(gen.*.lir, inst.arg0))
                    encoder.emitMovRegMem(gen.*.enc, target.Register.rax, first_slot)
                    encoder.emitMovMemReg(gen.*.enc, primary_slot, target.Register.rax)
                } else {
                    encoder.emitMovRegImm64(gen.*.enc, target.Register.rax, 0)
                    encoder.emitMovMemReg(gen.*.enc, primary_slot, target.Register.rax)
                }
                if inst.arg1 > 1 {
                    const second_slot = allocateOp(gen, lir_module.getExtra(gen.*.lir, inst.arg0 + 1))
                    encoder.emitMovRegMem(gen.*.enc, target.Register.rdx, second_slot)
                    encoder.emitMovMemReg(gen.*.enc, secondary_slot, target.Register.rdx)
                } else {
                    encoder.emitMovRegImm64(gen.*.enc, target.Register.rdx, 0)
                    encoder.emitMovMemReg(gen.*.enc, secondary_slot, target.Register.rdx)
                }
            },
            lir_module.Opcode.tuple_element => {
                const destination = allocateOp(gen, inst_idx)
                if inst.arg1 == 0 {
                    const source = allocateOp(gen, inst.arg0)
                    encoder.emitMovRegMem(gen.*.enc, target.Register.rax, source)
                } else {
                    const source = getMap(gen.*.secondarySlots, inst.arg0)
                    if source.0 {
                        encoder.emitMovRegMem(gen.*.enc, target.Register.rax, source.1)
                    } else {
                        encoder.emitMovRegImm64(gen.*.enc, target.Register.rax, 0)
                    }
                }
                encoder.emitMovMemReg(gen.*.enc, destination, target.Register.rax)
            },
            lir_module.Opcode.call => {
                const func_slot = allocateOp(gen, inst.arg0)
                const args_start = inst.arg1
                const args_count = inst.arg2
                var i: usize = 0
                while i < args_count {
                    if i < target.ARG_REGS_COUNT {
                        const arg_slot = allocateOp(gen, lir_module.getExtra(gen.*.lir, args_start + i))
                        encoder.emitMovRegMem(gen.*.enc, target.argReg(i), arg_slot)
                    }
                    i = i + 1
                }
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, func_slot)
                encoder.emitCallReg(gen.*.enc, target.Register.rax)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
                const secondary_slot = allocateSecondaryOp(gen, inst_idx)
                encoder.emitMovMemReg(gen.*.enc, secondary_slot, target.Register.rdx)
            },
            lir_module.Opcode.syscall => {
                const syscall_no = allocateOp(gen, inst.arg0)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, syscall_no)
                const args_start = inst.arg1
                const args_count = inst.arg2
                var i: usize = 0
                while i < args_count {
                    if i < 6 {
                        const arg_slot = allocateOp(gen, lir_module.getExtra(gen.*.lir, args_start + i))
                        encoder.emitMovRegMem(gen.*.enc, target.syscallArgReg(i + 1), arg_slot)
                    }
                    i = i + 1
                }
                encoder.emitSyscall(gen.*.enc)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.copy => {
                const src_slot = allocateOp(gen, inst.arg0)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, src_slot)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.aggregate_copy => {
                const src_slot = allocateOp(gen, inst.arg0)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, src_slot)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.error_payload => {
                const src_slot = allocateOp(gen, inst.arg0)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, src_slot)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.error_payload_part => {
                const src_slot = allocateOp(gen, inst.arg0)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, src_slot)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.error_test => {
                const src_slot = allocateOp(gen, inst.arg0)
                const dst_slot = allocateOp(gen, inst_idx)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, src_slot)
                encoder.emitMovMemReg(gen.*.enc, dst_slot, target.Register.rax)
            },
            lir_module.Opcode.ret => {
                if inst.arg0 != lir_module.NONE {
                    const val_slot = allocateOp(gen, inst.arg0)
                    encoder.emitMovRegMem(gen.*.enc, target.Register.rax, val_slot)
                    const secondary = getMap(gen.*.secondarySlots, inst.arg0)
                    if secondary.0 { encoder.emitMovRegMem(gen.*.enc, target.Register.rdx, secondary.1) }
                }
                encoder.emitMovRspRbp(gen.*.enc)
                encoder.emitPopRbp(gen.*.enc)
                encoder.emitRet(gen.*.enc)
            },
            lir_module.Opcode.ret_slice => {
                const ptr_slot = allocateOp(gen, inst.arg0)
                const len_slot = allocateOp(gen, inst.arg1)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, ptr_slot)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rdx, len_slot)
                encoder.emitMovRspRbp(gen.*.enc)
                encoder.emitPopRbp(gen.*.enc)
                encoder.emitRet(gen.*.enc)
            },
            lir_module.Opcode.br => {
                var label_str = blockLabelName(gen, inst.arg0)
                retainLabelName(gen, &label_str)
                encoder.emitJmpRel(gen.*.enc, label_str.items, label_str.length)
            },
            lir_module.Opcode.condbr => {
                const cond_slot = allocateOp(gen, inst.arg0)
                encoder.emitMovRegMem(gen.*.enc, target.Register.rax, cond_slot)
                encoder.emitTest(gen.*.enc, target.Register.rax)
                
                var true_label = blockLabelName(gen, inst.arg1)
                retainLabelName(gen, &true_label)
                encoder.emitJnzRel(gen.*.enc, true_label.items, true_label.length)
                
                var false_label = blockLabelName(gen, inst.arg2)
                retainLabelName(gen, &false_label)
                encoder.emitJmpRel(gen.*.enc, false_label.items, false_label.length)
            },
            lir_module.Opcode.unreachable_inst => {
                encoder.emitTrap(gen.*.enc)
            },
            else => {}
        }
        inst_idx = inst_idx + 1
    }
}
