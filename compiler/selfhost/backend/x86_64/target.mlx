// x86_64 register and encoding definitions for mlx1

pub const Register = enum(u8) {
    rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi,
    r8, r9, r10, r11, r12, r13, r14, r15
}

pub fn regIndex(reg: Register) -> u8 {
    return @intCast(u8, @intFromEnum(reg))
}

pub fn lo3(reg: Register) -> u8 {
    return regIndex(reg) & 7
}

pub fn needsRex(reg: Register) -> bool {
    return regIndex(reg) >= 8
}

pub fn encodeRex(w: bool, r: bool, x: bool, b: bool) -> u8 {
    var result: u8 = 64  // 0b01000000 base
    if w { result = result | 8 }
    if r { result = result | 4 }
    if x { result = result | 2 }
    if b { result = result | 1 }
    return result
}

pub fn encodeModRm(mod: u8, reg: u8, rm: u8) -> u8 {
    return ((mod & 3) << 6) | ((reg & 7) << 3) | (rm & 7)
}

// System V AMD64 ABI argument registers
pub const ARG_REGS_COUNT: usize = 6
pub fn argReg(index: usize) -> Register {
    if index == 0 { return Register.rdi }
    if index == 1 { return Register.rsi }
    if index == 2 { return Register.rdx }
    if index == 3 { return Register.rcx }
    if index == 4 { return Register.r8 }
    if index == 5 { return Register.r9 }
    return Register.rax  // should not be reached
}

// Syscall argument registers (rdi, rsi, rdx, r10, r8, r9)
pub fn syscallArgReg(index: usize) -> Register {
    if index == 0 { return Register.rax }  // syscall number
    if index == 1 { return Register.rdi }
    if index == 2 { return Register.rsi }
    if index == 3 { return Register.rdx }
    if index == 4 { return Register.r10 }
    if index == 5 { return Register.r8 }
    if index == 6 { return Register.r9 }
    return Register.rax
}
