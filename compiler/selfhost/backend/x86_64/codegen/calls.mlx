const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")

const AbiLocation = struct {
    isFloat: bool
    inRegister: bool
    registerIndex: usize
    stackIndex: usize
}

pub const Calls = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        if instruction.opcode == lir_module.Opcode.call {
            Self.emitCall(state, index, instruction)
            return true
        }
        if instruction.opcode == lir_module.Opcode.direct_call {
            Self.emitDirectCall(state, index, instruction)
            return true
        }
        if instruction.opcode == lir_module.Opcode.syscall {
            Self.emitSyscall(state, index, instruction)
            return true
        }
        return false
    }

    fn emitCall(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const function = state_module.State.allocateOp(state, instruction.arg0)
        const cleanup = Self.prepareCall(state, instruction.arg1, instruction.arg2)
        encoder.emitMovRegMem(state.*.enc, target.Register.rax, function)
        encoder.emitCallReg(state.*.enc, target.Register.rax)
        Self.finishCall(state, index, instruction.typeId, cleanup, true)
    }

    fn emitDirectCall(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const cleanup = Self.prepareCall(state, instruction.arg1, instruction.arg2)
        const symbol = lir_module.getSymbol(state.*.lir, instruction.arg0)
        const foreign = symbol.flags & lir_module.SYMBOL_IMPORT != 0
        if foreign {
            const vector_arguments = Self.vectorArgumentCount(state, instruction.arg1, instruction.arg2)
            encoder.emitImportCall(state.*.enc, symbol.pointer, symbol.length, vector_arguments)
        } else {
            encoder.emitCallRel(state.*.enc, symbol.pointer, symbol.length)
        }
        state.*.directCallCount += 1
        Self.finishCall(state, index, instruction.typeId, cleanup, foreign)
    }

    fn vectorArgumentCount(state: *state_module.State, start: usize, count: usize) -> usize {
        var result: usize = 0
        var argument_index: usize = 0
        while argument_index < count {
            const location = Self.argumentLocation(state, start, argument_index, 0)
            if location.isFloat && location.inRegister { result += 1 }
            argument_index += 1
        }
        return result
    }

    fn prepareCall(state: *state_module.State, start: usize, count: usize) -> usize {
        const stack_count = Self.stackArgumentCount(state, start, count)
        const padding: usize = if stack_count & 1 != 0 { 1 } else { 0 }
        if padding != 0 { encoder.emitSubRspImm32(state.*.enc, 8) }
        Self.pushStackArguments(state, start, count)
        Self.loadRegisterArguments(state, start, count)
        return stack_count + padding
    }

    // `may_be_foreign`: the callee may be C code (an import, or any function
    // pointer), whose narrow integer results have unspecified upper bits.
    fn finishCall(state: *state_module.State, index: usize, type_id: usize, cleanup: usize, may_be_foreign: bool) -> void {
        if cleanup > 0 { encoder.emitAddRspImm32(state.*.enc, @intCast(u32, cleanup * 8)) }
        if may_be_foreign {
            const narrow = state_module.State.narrowInteger(state, type_id)
            encoder.emitExtend(state.*.enc, target.Register.rax, narrow.0, narrow.1)
        }
        Self.storeReturnValue(state, index, type_id)
    }

    fn argumentLocation(state: *state_module.State, start: usize, target_argument: usize, target_component: usize) -> AbiLocation {
        var integer_index: usize = 0
        var float_index: usize = 0
        var stack_index: usize = 0
        var argument_index: usize = 0
        while argument_index <= target_argument {
            const argument = lir_module.getExtra(state.*.lir, start + argument_index)
            const count = state_module.State.componentCount(state, argument)
            var component: usize = 0
            while component < count {
                const value = lir_module.getInst(state.*.lir, argument)
                const is_float = count == 1 && state_module.State.isFloatType(state, value.typeId)
                const register_index = if is_float { float_index } else { integer_index }
                const capacity: usize = if is_float { 8 } else { target.ARG_REGS_COUNT }
                const in_register = register_index < capacity
                if argument_index == target_argument && component == target_component {
                    return AbiLocation.{ .isFloat = is_float, .inRegister = in_register, .registerIndex = register_index, .stackIndex = stack_index }
                }
                if in_register {
                    if is_float { float_index += 1 } else { integer_index += 1 }
                } else { stack_index += 1 }
                component += 1
            }
            argument_index += 1
        }
        return AbiLocation.{ .isFloat = false, .inRegister = false, .registerIndex = 0, .stackIndex = stack_index }
    }

    fn stackArgumentCount(state: *state_module.State, start: usize, count: usize) -> usize {
        var result: usize = 0
        var argument_index: usize = 0
        while argument_index < count {
            const argument = lir_module.getExtra(state.*.lir, start + argument_index)
            var component: usize = 0
            while component < state_module.State.componentCount(state, argument) {
                if !Self.argumentLocation(state, start, argument_index, component).inRegister { result += 1 }
                component += 1
            }
            argument_index += 1
        }
        return result
    }

    fn pushStackArguments(state: *state_module.State, start: usize, count: usize) -> void {
        var argument_index = count
        while argument_index > 0 {
            argument_index -= 1
            const argument = lir_module.getExtra(state.*.lir, start + argument_index)
            var component = state_module.State.componentCount(state, argument)
            while component > 0 {
                component -= 1
                const location = Self.argumentLocation(state, start, argument_index, component)
                if !location.inRegister { Self.pushComponent(state, argument, component) }
            }
        }
    }

    // Component 0 of an argument may still be sitting in a *deferred* location
    // (state.pendingRaxVreg / pendingImmediateVreg): the "retain in RAX, skip
    // the stack write" peephole (see State.storeRaxResult/canRetainNext) only
    // ever assumed the immediately-following LIR instruction would be the
    // sole consumer. A call site reads its arguments here, which is not
    // necessarily that instruction (e.g. when the defining value is also
    // read again later, or the retained value's real consumer turned out to
    // be behind a branch) — reading via State.getComponent (a plain "has
    // this vreg already been materialized to memory?" peek) then silently
    // finds nothing and drops the argument, loading a stale/garbage
    // register or pushing whatever was last in rax. State.loadOp is the
    // accessor that already knows how to consume a still-pending value (or
    // fall back to allocating+loading its real stack slot), exactly like
    // every other consumer of a component-0 value does — so argument
    // loading needs to go through it too instead of peeking directly.
    fn pushComponent(state: *state_module.State, argument: usize, component: usize) -> void {
        if component == 0 {
            state_module.State.loadOp(state, target.Register.rax, argument)
        } else {
            const slot = state_module.State.getComponent(state, argument, component)
            if slot.0 { encoder.emitMovRegMem(state.*.enc, target.Register.rax, slot.1) }
        }
        encoder.emitPushReg(state.*.enc, target.Register.rax)
    }

    fn loadRegisterArguments(state: *state_module.State, start: usize, count: usize) -> void {
        var argument_index: usize = 0
        while argument_index < count {
            const argument = lir_module.getExtra(state.*.lir, start + argument_index)
            var component: usize = 0
            const component_count = state_module.State.componentCount(state, argument)
            while component < component_count {
                const location = Self.argumentLocation(state, start, argument_index, component)
                if component == 0 && location.inRegister && !location.isFloat {
                    state_module.State.loadOp(state, target.argReg(location.registerIndex), argument)
                    component += 1
                    continue
                }
                const slot = state_module.State.getComponent(state, argument, component)
                if slot.0 && location.inRegister && location.isFloat {
                    const value = lir_module.getInst(state.*.lir, argument)
                    encoder.emitMovXmmMem(state.*.enc, location.registerIndex, slot.1, state_module.State.floatBits(state, value.typeId))
                }
                if slot.0 && location.inRegister && !location.isFloat { encoder.emitMovRegMem(state.*.enc, target.argReg(location.registerIndex), slot.1) }
                component += 1
            }
            argument_index += 1
        }
    }

    fn storeReturnValue(state: *state_module.State, index: usize, type_id: usize) -> void {
        const word_count = state_module.State.typeWordCount(state, type_id)
        if state_module.State.isFloatType(state, type_id) {
            encoder.emitMovMemXmm(state.*.enc, state_module.State.allocateOp(state, index), 0, state_module.State.floatBits(state, type_id))
            return
        }
        encoder.emitMovMemReg(state.*.enc, state_module.State.allocateOp(state, index), target.Register.rax)
        if word_count >= 2 {
            if state_module.State.isFloatErrorUnion(state, type_id) {
                const payload_type = state_module.State.errorUnionPayloadType(state, type_id)
                encoder.emitMovMemXmm(state.*.enc, state_module.State.allocateSecondaryOp(state, index), 0, state_module.State.floatBits(state, payload_type))
            } else { encoder.emitMovMemReg(state.*.enc, state_module.State.allocateSecondaryOp(state, index), target.Register.rdx) }
        }
        if word_count >= 3 {
            encoder.emitMovMemReg(state.*.enc, state_module.State.allocateTertiaryOp(state, index), target.Register.rcx)
        }
    }

    fn emitSyscall(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        encoder.emitMovRegMem(state.*.enc, target.Register.rax, state_module.State.allocateOp(state, instruction.arg0))
        var argument: usize = 0
        while argument < instruction.arg2 {
            if argument < 6 {
                const value = lir_module.getExtra(state.*.lir, instruction.arg1 + argument)
                encoder.emitMovRegMem(state.*.enc, target.syscallArgReg(argument + 1), state_module.State.allocateOp(state, value))
            }
            argument += 1
        }
        encoder.emitSyscall(state.*.enc)
        encoder.emitMovMemReg(state.*.enc, state_module.State.allocateOp(state, index), target.Register.rax)
    }
}
