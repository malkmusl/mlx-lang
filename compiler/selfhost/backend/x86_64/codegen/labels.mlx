const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")

const AbiLocation = struct {
    isFloat: bool
    inRegister: bool
    registerIndex: usize
    stackIndex: usize
}

pub const Labels = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        if instruction.opcode == lir_module.Opcode.label {
            Self.emitLabel(state, index, instruction)
            return true
        }
        if instruction.opcode == lir_module.Opcode.param {
            return true
        }
        return false
    }

    fn emitLabel(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if instruction.arg0 != lir_module.NONE {
            const symbol = lir_module.getSymbol(state.*.lir, instruction.arg0)
            const exported = symbol.flags & lir_module.SYMBOL_EXPORT != 0
            const frame_size = state_module.State.functionFrameSize(state, index)
            state_module.State.beginFunction(state, if exported { frame_size + 16 } else { frame_size })
            state.*.currentExport = exported
            encoder.defineSymbol(state.*.enc, symbol.pointer, symbol.length)
            if exported { encoder.exportSymbol(state.*.enc, symbol.pointer, symbol.length, encoder.pos(state.*.enc)) }
            encoder.emitPushRbp(state.*.enc)
            encoder.emitMovRbpRsp(state.*.enc)
            encoder.emitSubRspImm32(state.*.enc, @intCast(u32, state.*.frameSize))
            if exported { Self.enterFromForeignCode(state) }
            state.*.currentReturnType = instruction.typeId
            Self.emitParameters(state, index)
            return
        }
        if instruction.arg1 != lir_module.NONE {
            const label = state_module.State.blockLabelName(state, instruction.arg1)
            encoder.defineSymbol(state.*.enc, label.0, label.1)
        }
    }

    // An exported function may be called from C code on any thread, where the
    // aggregate arena registers (r14, r15) hold the caller's values: they are
    // saved in the two words at the bottom of the frame and reloaded from the
    // data area _start filled in. The epilogue restores them.
    fn enterFromForeignCode(state: *state_module.State) -> void {
        encoder.emitMovMemReg(state.*.enc, Self.savedArenaSlot(state), target.Register.r14)
        encoder.emitMovMemReg(state.*.enc, Self.savedArenaSlot(state) - 8, target.Register.r15)
        encoder.emitDataLoad(state.*.enc, target.Register.r14, encoder.DATA_ARENA)
        encoder.emitDataLoad(state.*.enc, target.Register.r15, encoder.DATA_ARENA_END)
    }

    pub fn savedArenaSlot(state: *state_module.State) -> i32 { return @intCast(i32, state.*.frameSize) }

    fn emitParameters(state: *state_module.State, label_index: usize) -> void {
        var index = label_index + 1
        const total = lir_module.instCount(state.*.lir)
        while index < total {
            const instruction = lir_module.getInst(state.*.lir, index)
            if instruction.opcode == lir_module.Opcode.label && instruction.arg0 != lir_module.NONE { return }
            if instruction.opcode == lir_module.Opcode.param { Self.emitParameter(state, index, instruction) }
            index += 1
        }
    }

    fn emitParameter(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const destination = state_module.State.allocateOp(state, index)
        const location = Self.parameterLocation(state, index)
        if location.inRegister && location.isFloat {
            encoder.emitMovMemXmm(state.*.enc, destination, location.registerIndex, state_module.State.floatBits(state, instruction.typeId))
            return
        }
        // Narrow integers are extended on entry: a C caller (an exported
        // function, or a callback handed to C) leaves the upper bits unset.
        const narrow = state_module.State.narrowInteger(state, instruction.typeId)
        if location.inRegister {
            const register = target.argReg(location.registerIndex)
            encoder.emitExtend(state.*.enc, register, narrow.0, narrow.1)
            encoder.emitMovMemReg(state.*.enc, destination, register)
            return
        }
        const caller_offset = @intCast(i32, 16 + location.stackIndex * 8)
        encoder.emitMovRegMem(state.*.enc, target.Register.rax, 0 - caller_offset)
        encoder.emitExtend(state.*.enc, target.Register.rax, narrow.0, narrow.1)
        encoder.emitMovMemReg(state.*.enc, destination, target.Register.rax)
    }

    fn parameterLocation(state: *state_module.State, target_index: usize) -> AbiLocation {
        var function_start = target_index
        while function_start > 0 {
            function_start -= 1
            const instruction = lir_module.getInst(state.*.lir, function_start)
            if instruction.opcode == lir_module.Opcode.label && instruction.arg0 != lir_module.NONE { break }
        }
        var integer_index: usize = 0
        var float_index: usize = 0
        var stack_index: usize = 0
        var index = function_start + 1
        while index <= target_index {
            const parameter = lir_module.getInst(state.*.lir, index)
            if parameter.opcode == lir_module.Opcode.param {
                const is_float = state_module.State.isFloatType(state, parameter.typeId)
                const register_index = if is_float { float_index } else { integer_index }
                const capacity: usize = if is_float { 8 } else { target.ARG_REGS_COUNT }
                const in_register = register_index < capacity
                if index == target_index { return AbiLocation.{ .isFloat = is_float, .inRegister = in_register, .registerIndex = register_index, .stackIndex = stack_index } }
                if in_register {
                    if is_float { float_index += 1 } else { integer_index += 1 }
                } else { stack_index += 1 }
            }
            index += 1
        }
        return AbiLocation.{ .isFloat = false, .inRegister = false, .registerIndex = 0, .stackIndex = stack_index }
    }
}
