const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")

pub const Arithmetic = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        match instruction.opcode {
            lir_module.Opcode.add => { Self.emitNumeric(state, index, instruction, 0x58) },
            lir_module.Opcode.sub => { Self.emitNumeric(state, index, instruction, 0x5C) },
            lir_module.Opcode.mul => { Self.emitNumeric(state, index, instruction, 0x59) },
            lir_module.Opcode.bit_and => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.bit_or => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.bit_xor => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.div => {
                if state_module.State.isFloatType(state, instruction.typeId) { Self.emitFloat(state, index, instruction, 0x5E) } else { Self.emitDivision(state, index, instruction, true, false) }
            },
            lir_module.Opcode.rem => { Self.emitDivision(state, index, instruction, true, true) },
            lir_module.Opcode.udiv => { Self.emitDivision(state, index, instruction, false, false) },
            lir_module.Opcode.urem => { Self.emitDivision(state, index, instruction, false, true) },
            lir_module.Opcode.shl => { Self.emitShift(state, index, instruction, true) },
            lir_module.Opcode.shr => { Self.emitShift(state, index, instruction, false) },
            lir_module.Opcode.icmp => { Self.emitComparison(state, index, instruction) },
            lir_module.Opcode.fcmp => { Self.emitFloatComparison(state, index, instruction) },
            else => { return false },
        }
        return true
    }

    fn emitNumeric(state: *state_module.State, index: usize, instruction: lir_module.Inst, float_opcode: u8) -> void {
        if state_module.State.isFloatType(state, instruction.typeId) {
            Self.emitFloat(state, index, instruction, float_opcode)
        } else {
            Self.emitSimple(state, index, instruction)
        }
    }

    fn emitFloat(state: *state_module.State, index: usize, instruction: lir_module.Inst, opcode: u8) -> void {
        const bits = state_module.State.floatBits(state, instruction.typeId)
        encoder.emitMovXmmMem(state.*.enc, 0, state_module.State.allocateOp(state, instruction.arg0), bits)
        encoder.emitMovXmmMem(state.*.enc, 1, state_module.State.allocateOp(state, instruction.arg1), bits)
        encoder.emitFloatBinary(state.*.enc, opcode, 0, 1, bits)
        encoder.emitMovMemXmm(state.*.enc, state_module.State.allocateOp(state, index), 0, bits)
    }

    fn emitSimple(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const immediate = state_module.State.takeImmediate32(state, instruction.arg1)
        if immediate.0 {
            state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
            Self.emitImmediate(state, instruction.opcode, immediate.1)
            state_module.State.storeRaxResult(state, index)
            return
        }
        const right_retained = state_module.State.pendingRaxIs(state, instruction.arg1)
        var right: i32 = 0
        if right_retained {
            state_module.State.loadOp(state, target.Register.rcx, instruction.arg1)
            state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        } else {
            right = state_module.State.allocateOp(state, instruction.arg1)
            state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        }
        match instruction.opcode {
            lir_module.Opcode.add => { if right_retained { encoder.emitAdd(state.*.enc, target.Register.rax, target.Register.rcx) } else { encoder.emitAddMem(state.*.enc, target.Register.rax, right) } },
            lir_module.Opcode.sub => { if right_retained { encoder.emitSub(state.*.enc, target.Register.rax, target.Register.rcx) } else { encoder.emitSubMem(state.*.enc, target.Register.rax, right) } },
            lir_module.Opcode.mul => { if right_retained { encoder.emitIMul(state.*.enc, target.Register.rax, target.Register.rcx) } else { encoder.emitIMulMem(state.*.enc, target.Register.rax, right) } },
            lir_module.Opcode.bit_and => { if right_retained { encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx) } else { encoder.emitAndMem(state.*.enc, target.Register.rax, right) } },
            lir_module.Opcode.bit_or => { if right_retained { encoder.emitOr(state.*.enc, target.Register.rax, target.Register.rcx) } else { encoder.emitOrMem(state.*.enc, target.Register.rax, right) } },
            lir_module.Opcode.bit_xor => { if right_retained { encoder.emitXor(state.*.enc, target.Register.rax, target.Register.rcx) } else { encoder.emitXorMem(state.*.enc, target.Register.rax, right) } },
            else => {},
        }
        state_module.State.storeRaxResult(state, index)
    }

    fn emitImmediate(state: *state_module.State, opcode: lir_module.Opcode, immediate: i32) -> void {
        if opcode == lir_module.Opcode.mul {
            encoder.emitIMulImm(state.*.enc, target.Register.rax, target.Register.rax, immediate)
            return
        }
        var extension: u8 = 0
        var accumulator_opcode: u8 = 0x05
        if opcode == lir_module.Opcode.sub {
            extension = 5
            accumulator_opcode = 0x2D
        }
        if opcode == lir_module.Opcode.bit_and {
            extension = 4
            accumulator_opcode = 0x25
        }
        if opcode == lir_module.Opcode.bit_or {
            extension = 1
            accumulator_opcode = 0x0D
        }
        if opcode == lir_module.Opcode.bit_xor {
            extension = 6
            accumulator_opcode = 0x35
        }
        encoder.emitAluImm(state.*.enc, target.Register.rax, immediate, extension, accumulator_opcode)
    }

    fn emitDivision(state: *state_module.State, index: usize, instruction: lir_module.Inst, signed: bool, remainder: bool) -> void {
        const destination = state_module.State.allocateOp(state, index)
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg1)
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        if signed { encoder.emitCqo(state.*.enc) } else { encoder.emitMovRegImm64(state.*.enc, target.Register.rdx, 0) }
        encoder.emitDivide(state.*.enc, target.Register.rcx, signed)
        encoder.emitMovMemReg(state.*.enc, destination, if remainder { target.Register.rdx } else { target.Register.rax })
    }

    fn emitShift(state: *state_module.State, index: usize, instruction: lir_module.Inst, left: bool) -> void {
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg1)
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        encoder.emitShiftCl(state.*.enc, target.Register.rax, left, !left && state_module.State.isSignedType(state, instruction.typeId))
        state_module.State.storeRaxResult(state, index)
    }

    fn emitComparison(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const predicate = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, instruction.arg0))
        const immediate = state_module.State.takeImmediate32(state, instruction.arg2)
        if immediate.0 {
            state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
            encoder.emitAluImm(state.*.enc, target.Register.rax, immediate.1, 7, 0x3D)
            encoder.emitSetcc(state.*.enc, target.Register.rax, Self.condition(predicate))
            state_module.State.storeRaxResult(state, index)
            return
        }
        const right_retained = state_module.State.pendingRaxIs(state, instruction.arg2)
        var right: i32 = 0
        if right_retained {
            state_module.State.loadOp(state, target.Register.rcx, instruction.arg2)
            state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
            encoder.emitCmp(state.*.enc, target.Register.rax, target.Register.rcx)
        } else {
            right = state_module.State.allocateOp(state, instruction.arg2)
            state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
            encoder.emitCmpMem(state.*.enc, target.Register.rax, right)
        }
        encoder.emitSetcc(state.*.enc, target.Register.rax, Self.condition(predicate))
        state_module.State.storeRaxResult(state, index)
    }

    fn emitFloatComparison(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const predicate = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, instruction.arg0))
        const bits = state_module.State.floatBits(state, instruction.typeId)
        encoder.emitMovXmmMem(state.*.enc, 0, state_module.State.allocateOp(state, instruction.arg1), bits)
        encoder.emitMovXmmMem(state.*.enc, 1, state_module.State.allocateOp(state, instruction.arg2), bits)
        encoder.emitFloatCompare(state.*.enc, 0, 1, bits)
        Self.emitFloatPredicate(state, predicate)
        encoder.emitMovMemReg(state.*.enc, state_module.State.allocateOp(state, index), target.Register.rax)
    }

    fn emitFloatPredicate(state: *state_module.State, predicate: lir_module.CmpPredicate) -> void {
        match predicate {
            lir_module.CmpPredicate.eq => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.equal)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.ne => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.not_equal)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.parity)
                encoder.emitOr(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.lt => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.below)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.ult => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.below)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.le => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.below_equal)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.ule => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.below_equal)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.gt => { encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.above) },
            lir_module.CmpPredicate.ugt => { encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.above) },
            lir_module.CmpPredicate.ge => { encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.above_equal) },
            lir_module.CmpPredicate.uge => { encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.above_equal) },
            else => { encoder.emitMovRegImm64(state.*.enc, target.Register.rax, 0) },
        }
    }

    fn condition(predicate: lir_module.CmpPredicate) -> encoder.Condition {
        match predicate {
            lir_module.CmpPredicate.eq => { return encoder.Condition.equal },
            lir_module.CmpPredicate.ne => { return encoder.Condition.not_equal },
            lir_module.CmpPredicate.lt => { return encoder.Condition.less },
            lir_module.CmpPredicate.le => { return encoder.Condition.less_equal },
            lir_module.CmpPredicate.gt => { return encoder.Condition.greater },
            lir_module.CmpPredicate.ge => { return encoder.Condition.greater_equal },
            lir_module.CmpPredicate.ult => { return encoder.Condition.below },
            lir_module.CmpPredicate.ule => { return encoder.Condition.below_equal },
            lir_module.CmpPredicate.ugt => { return encoder.Condition.above },
            lir_module.CmpPredicate.uge => { return encoder.Condition.above_equal },
            else => { return encoder.Condition.equal },
        }
        return encoder.Condition.equal
    }
}
