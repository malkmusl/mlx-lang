const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")

pub const Arithmetic = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        match instruction.opcode {
            lir_module.Opcode.add => { Self.emitNumeric(state, index, instruction, 0x58) },
            lir_module.Opcode.sub => { Self.emitNumeric(state, index, instruction, 0x5C) },
            lir_module.Opcode.mul => { Self.emitNumeric(state, index, instruction, 0x59) },
            lir_module.Opcode.bit_and => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.bit_or => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.bit_xor => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.div => {
                if state_module.State.isFloatType(state, instruction.typeId) { Self.emitFloat(state, index, instruction, 0x5E) } else { Self.emitDivision(state, index, instruction, true, false) }
            },
            lir_module.Opcode.rem => { Self.emitDivision(state, index, instruction, true, true) },
            lir_module.Opcode.udiv => { Self.emitDivision(state, index, instruction, false, false) },
            lir_module.Opcode.urem => { Self.emitDivision(state, index, instruction, false, true) },
            lir_module.Opcode.shl => { Self.emitShift(state, index, instruction, true) },
            lir_module.Opcode.shr => { Self.emitShift(state, index, instruction, false) },
            lir_module.Opcode.popcount => { Self.emitPopCount(state, index, instruction) },
            lir_module.Opcode.sqrt => { Self.emitSquareRoot(state, index, instruction) },
            lir_module.Opcode.round_float => { Self.emitRoundFloat(state, index, instruction) },
            lir_module.Opcode.byte_mask_64 => { Self.emitByteMask64(state, index, instruction) },
            lir_module.Opcode.icmp => { Self.emitComparison(state, index, instruction) },
            lir_module.Opcode.fcmp => { Self.emitFloatComparison(state, index, instruction) },
            else => { return false },
        }
        return true
    }

    fn emitNumeric(state: *state_module.State, index: usize, instruction: lir_module.Inst, float_opcode: u8) -> void {
        if state_module.State.isFloatType(state, instruction.typeId) {
            Self.emitFloat(state, index, instruction, float_opcode)
        } else {
            Self.emitSimple(state, index, instruction)
        }
    }

    // xmm0 = arg0 <op> arg1.
    fn emitFloat(state: *state_module.State, index: usize, instruction: lir_module.Inst, opcode: u8) -> void {
        const bits = state_module.State.floatBits(state, instruction.typeId)
        encoder.emitMovXmmMem(state.*.enc, 0, state_module.State.allocateOp(state, instruction.arg0), bits)
        encoder.emitFloatBinary(state.*.enc, opcode, 0, Self.floatOperand(state, instruction.arg1, bits), bits)
        encoder.emitMovMemXmm(state.*.enc, state_module.State.allocateOp(state, index), 0, bits)
    }

    // The register an instruction's right float operand is read from: the
    // one of xmm8..xmm15 holding it, else xmm1 with it loaded. (Asked after
    // the left one is in xmm0: loading that may have taken a register.)
    fn floatOperand(state: *state_module.State, vreg: usize, bits: usize) -> usize {
        const slot = state_module.State.allocateOp(state, vreg)
        const held = encoder.heldXmm(state.*.enc, slot, bits)
        if held < 16 { return held }
        encoder.emitMovXmmMem(state.*.enc, 1, slot, bits)
        return 1
    }

    // The result's register (State.resultRegister) = left <op> right. An
    // operand in a cache register that this instruction reads last is
    // operated on in place, and the result takes its register (the right
    // one of a commutative operation too).
    fn emitSimple(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if Self.emitInPlace(state, index, instruction) { return }
        const immediate = state_module.State.takeImmediate32(state, instruction.arg1)
        var left = instruction.arg0
        var right = instruction.arg1
        var taken = state_module.State.takeOperandRegister(state, index, left)
        if !taken.0 && !immediate.0 && left != right && Self.commutes(instruction.opcode) {
            taken = state_module.State.takeOperandRegister(state, index, right)
            if taken.0 {
                right = instruction.arg0
                left = instruction.arg1
            }
        }
        if immediate.0 {
            var destination = taken.1
            if !taken.0 {
                destination = state_module.State.resultRegister(state, index)
                state_module.State.loadOp(state, destination, left)
            }
            Self.emitImmediate(state, instruction.opcode, immediate.1, destination)
            state_module.State.storeResult(state, index, destination)
            return
        }
        // The right operand: a register (a local's, a cached value's, rcx
        // with what the previous instruction left in rax), else its slot.
        var destination = taken.1
        if !taken.0 { destination = state_module.State.resultRegister(state, index) }
        const held = state_module.State.lazyRegister(state, right)
        var right_held = held.0
        var source = held.1
        // (x <op> x on x's own register.)
        if taken.0 && right == left {
            right_held = true
            source = taken.1
        }
        const right_retained = right_held || state_module.State.pendingRaxIs(state, right)
        var right_slot: i32 = 0
        if right_held {
        } else if right_retained {
            // Left in rax by the previous instruction: read from there,
            // unless the result is computed in rax.
            source = if destination == target.Register.rax { target.Register.rcx } else { target.Register.rax }
            state_module.State.loadOp(state, source, right)
        } else {
            right_slot = state_module.State.allocateOp(state, right)
        }
        if !taken.0 { state_module.State.loadOp(state, destination, left) }
        match instruction.opcode {
            lir_module.Opcode.add => { if right_retained { encoder.emitAdd(state.*.enc, destination, source) } else { encoder.emitAddMem(state.*.enc, destination, right_slot) } },
            lir_module.Opcode.sub => { if right_retained { encoder.emitSub(state.*.enc, destination, source) } else { encoder.emitSubMem(state.*.enc, destination, right_slot) } },
            lir_module.Opcode.mul => { if right_retained { encoder.emitIMul(state.*.enc, destination, source) } else { encoder.emitIMulMem(state.*.enc, destination, right_slot) } },
            lir_module.Opcode.bit_and => { if right_retained { encoder.emitAnd(state.*.enc, destination, source) } else { encoder.emitAndMem(state.*.enc, destination, right_slot) } },
            lir_module.Opcode.bit_or => { if right_retained { encoder.emitOr(state.*.enc, destination, source) } else { encoder.emitOrMem(state.*.enc, destination, right_slot) } },
            lir_module.Opcode.bit_xor => { if right_retained { encoder.emitXor(state.*.enc, destination, source) } else { encoder.emitXorMem(state.*.enc, destination, right_slot) } },
            else => {},
        }
        state_module.State.storeResult(state, index, destination)
    }

    fn commutes(opcode: lir_module.Opcode) -> bool {
        return opcode == lir_module.Opcode.add || opcode == lir_module.Opcode.mul || opcode == lir_module.Opcode.bit_and || opcode == lir_module.Opcode.bit_or || opcode == lir_module.Opcode.bit_xor
    }

    // `x = x <op> y` with x kept in a register: the operation is done on
    // that register (add rbx, 1) and the store after it is left out. The
    // left operand is a lazy load of x, and the store right after is the
    // only reader of the result. Loads of the old x read later go to their
    // slots first, as before any store into x.
    // The store may come after an extend of the result (a C int's): the
    // extend is done on the register too.
    fn emitInPlace(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        if !state_module.State.isLazy(state, instruction.arg0) || index + 2 >= lir_module.instCount(state.*.lir) { return false }
        var next = lir_module.getInst(state.*.lir, index + 1)
        var store_index = index + 1
        var extended = false
        if next.opcode == lir_module.Opcode.extend && next.arg0 == index && state.*.lastUse[index] == index + 1 && state.*.lastUse[index + 1] == index + 2 {
            const after = lir_module.getInst(state.*.lir, index + 2)
            if after.opcode != lir_module.Opcode.store || after.arg1 != index + 1 { return false }
            if next.arg1 != 8 && next.arg1 != 16 && next.arg1 != 32 { return false }
            extended = true
            store_index = index + 2
            next = after
        }
        if next.opcode != lir_module.Opcode.store || next.arg1 != store_index - 1 || state.*.lastUse[store_index - 1] != store_index { return false }
        const home = lir_module.registerHome(state.*.lir, next.arg0)
        const left = state_module.State.lazyRegister(state, instruction.arg0)
        if home == 0 || !left.0 || left.1 != state_module.State.homeRegister(home) { return false }
        state_module.State.spillLazy(state, index, home)
        if !state_module.State.isLazy(state, instruction.arg0) { return false }
        const register = left.1
        const immediate = state_module.State.takeImmediate32(state, instruction.arg1)
        if immediate.0 {
            if instruction.opcode == lir_module.Opcode.mul {
                encoder.emitIMulImm(state.*.enc, register, register, immediate.1)
            } else {
                encoder.emitAluImm(state.*.enc, register, immediate.1, Self.immediateExtension(instruction.opcode), 0x05)
            }
        } else {
            var source = target.Register.rcx
            const held = state_module.State.lazyRegister(state, instruction.arg1)
            if held.0 { source = held.1 } else { state_module.State.loadOp(state, target.Register.rcx, instruction.arg1) }
            match instruction.opcode {
                lir_module.Opcode.add => { encoder.emitAdd(state.*.enc, register, source) },
                lir_module.Opcode.sub => { encoder.emitSub(state.*.enc, register, source) },
                lir_module.Opcode.mul => { encoder.emitIMul(state.*.enc, register, source) },
                lir_module.Opcode.bit_and => { encoder.emitAnd(state.*.enc, register, source) },
                lir_module.Opcode.bit_or => { encoder.emitOr(state.*.enc, register, source) },
                lir_module.Opcode.bit_xor => { encoder.emitXor(state.*.enc, register, source) },
                else => {},
            }
        }
        if extended {
            const extend = lir_module.getInst(state.*.lir, index + 1)
            const code = lir_module.registerWidth(state.*.lir, next.arg0)
            // (The local's own extension covers the same one.)
            if code == lir_module.WIDTH_WORD || lir_module.widthBits(code) != extend.arg1 || lir_module.widthSigned(code) != (extend.arg2 == 1) {
                encoder.emitExtend(state.*.enc, register, extend.arg1, extend.arg2 == 1)
            }
            state.*.extendDone = index + 1
        }
        state_module.State.extendHome(state, next.arg0)
        state.*.storeDone = store_index
        state.*.inPlaceCount += 1
        return true
    }

    // The /digit of the 0x81/0x83 group for an operation with an immediate.
    fn immediateExtension(opcode: lir_module.Opcode) -> u8 {
        if opcode == lir_module.Opcode.sub { return 5 }
        if opcode == lir_module.Opcode.bit_and { return 4 }
        if opcode == lir_module.Opcode.bit_or { return 1 }
        if opcode == lir_module.Opcode.bit_xor { return 6 }
        return 0
    }

    fn emitImmediate(state: *state_module.State, opcode: lir_module.Opcode, immediate: i32, register: target.Register) -> void {
        if opcode == lir_module.Opcode.mul {
            encoder.emitIMulImm(state.*.enc, register, register, immediate)
            return
        }
        var extension: u8 = 0
        var accumulator_opcode: u8 = 0x05
        if opcode == lir_module.Opcode.sub {
            extension = 5
            accumulator_opcode = 0x2D
        }
        if opcode == lir_module.Opcode.bit_and {
            extension = 4
            accumulator_opcode = 0x25
        }
        if opcode == lir_module.Opcode.bit_or {
            extension = 1
            accumulator_opcode = 0x0D
        }
        if opcode == lir_module.Opcode.bit_xor {
            extension = 6
            accumulator_opcode = 0x35
        }
        encoder.emitAluImm(state.*.enc, register, immediate, extension, accumulator_opcode)
    }

    fn emitDivision(state: *state_module.State, index: usize, instruction: lir_module.Inst, signed: bool, remainder: bool) -> void {
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg1)
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        if signed { encoder.emitCqo(state.*.enc) } else { encoder.emitMovRegImm64(state.*.enc, target.Register.rdx, 0) }
        encoder.emitDivide(state.*.enc, target.Register.rcx, signed)
        if remainder { encoder.emitMovRegReg(state.*.enc, target.Register.rax, target.Register.rdx) }
        state_module.State.storeRaxResult(state, index)
    }

    fn emitShift(state: *state_module.State, index: usize, instruction: lir_module.Inst, left: bool) -> void {
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg1)
        const taken = state_module.State.takeOperandRegister(state, index, instruction.arg0)
        var destination = taken.1
        if !taken.0 {
            destination = state_module.State.resultRegister(state, index)
            state_module.State.loadOp(state, destination, instruction.arg0)
        }
        encoder.emitShiftCl(state.*.enc, destination, left, !left && state_module.State.isSignedType(state, instruction.typeId))
        state_module.State.storeResult(state, index, destination)
    }

    // sqrtsd (sqrtss for an f32) of arg0's slot into the result's slot.
    fn emitSquareRoot(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const bits = state_module.State.floatBits(state, instruction.typeId)
        encoder.emitFloatBinary(state.*.enc, 0x51, 0, Self.floatOperand(state, instruction.arg0, bits), bits)
        encoder.emitMovMemXmm(state.*.enc, state_module.State.allocateOp(state, index), 0, bits)
    }

    // roundsd (roundss for an f32) of arg0's slot into the result's slot.
    fn emitRoundFloat(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const bits = state_module.State.floatBits(state, instruction.typeId)
        encoder.emitRoundFloat(state.*.enc, 0, Self.floatOperand(state, instruction.arg0, bits), bits, instruction.arg1)
        encoder.emitMovMemXmm(state.*.enc, state_module.State.allocateOp(state, index), 0, bits)
    }

    fn emitPopCount(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        if instruction.arg1 < 64 {
            const mask = (@intCast(usize, 1) << instruction.arg1) - 1
            if instruction.arg1 < 32 {
                encoder.emitAluImm(state.*.enc, target.Register.rax, @intCast(i32, mask), 4, 0x25)
            } else {
                encoder.emitMovRegImm64(state.*.enc, target.Register.rcx, @intCast(i64, mask))
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            }
        }
        encoder.emitPopCount(state.*.enc, target.Register.rax, target.Register.rax)
        state_module.State.storeRaxResult(state, index)
    }

    fn emitByteMask64(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg1)
        encoder.emitByteMask64(state.*.enc)
        state_module.State.storeRaxResult(state, index)
    }

    fn emitComparison(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const predicate = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, instruction.arg0))
        const immediate = state_module.State.takeImmediate32(state, instruction.arg2)
        if immediate.0 {
            state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
            encoder.emitAluImm(state.*.enc, target.Register.rax, immediate.1, 7, 0x3D)
            encoder.emitSetcc(state.*.enc, target.Register.rax, Self.condition(predicate))
            state_module.State.storeRaxResult(state, index)
            return
        }
        const held = state_module.State.lazyRegister(state, instruction.arg2)
        const right_retained = state_module.State.pendingRaxIs(state, instruction.arg2)
        var right: i32 = 0
        if held.0 {
            state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
            encoder.emitCmp(state.*.enc, target.Register.rax, held.1)
        } else if right_retained {
            state_module.State.loadOp(state, target.Register.rcx, instruction.arg2)
            state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
            encoder.emitCmp(state.*.enc, target.Register.rax, target.Register.rcx)
        } else {
            right = state_module.State.allocateOp(state, instruction.arg2)
            state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
            encoder.emitCmpMem(state.*.enc, target.Register.rax, right)
        }
        encoder.emitSetcc(state.*.enc, target.Register.rax, Self.condition(predicate))
        state_module.State.storeRaxResult(state, index)
    }

    // (The operands' width from the left operand's type when it has one:
    // a client's fcmp may carry its integer result's type.)
    fn emitFloatComparison(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const predicate = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, instruction.arg0))
        var bits = state_module.State.floatBits(state, instruction.typeId)
        if instruction.arg1 != lir_module.NONE && instruction.arg1 < lir_module.instCount(state.*.lir) {
            const left = lir_module.getInst(state.*.lir, instruction.arg1)
            if state_module.State.isFloatType(state, left.typeId) { bits = state_module.State.floatBits(state, left.typeId) }
        }
        encoder.emitMovXmmMem(state.*.enc, 0, state_module.State.allocateOp(state, instruction.arg1), bits)
        encoder.emitFloatCompare(state.*.enc, 0, Self.floatOperand(state, instruction.arg2, bits), bits)
        Self.emitFloatPredicate(state, predicate)
        encoder.emitMovMemReg(state.*.enc, state_module.State.allocateOp(state, index), target.Register.rax)
    }

    fn emitFloatPredicate(state: *state_module.State, predicate: lir_module.CmpPredicate) -> void {
        match predicate {
            lir_module.CmpPredicate.eq => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.equal)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.ne => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.not_equal)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.parity)
                encoder.emitOr(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.lt => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.below)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.ult => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.below)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.le => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.below_equal)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.ule => {
                encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.below_equal)
                encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.not_parity)
                encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx)
            },
            lir_module.CmpPredicate.gt => { encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.above) },
            lir_module.CmpPredicate.ugt => { encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.above) },
            lir_module.CmpPredicate.ge => { encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.above_equal) },
            lir_module.CmpPredicate.uge => { encoder.emitSetcc(state.*.enc, target.Register.rax, encoder.Condition.above_equal) },
            else => { encoder.emitMovRegImm64(state.*.enc, target.Register.rax, 0) },
        }
    }

    fn condition(predicate: lir_module.CmpPredicate) -> encoder.Condition {
        match predicate {
            lir_module.CmpPredicate.eq => { return encoder.Condition.equal },
            lir_module.CmpPredicate.ne => { return encoder.Condition.not_equal },
            lir_module.CmpPredicate.lt => { return encoder.Condition.less },
            lir_module.CmpPredicate.le => { return encoder.Condition.less_equal },
            lir_module.CmpPredicate.gt => { return encoder.Condition.greater },
            lir_module.CmpPredicate.ge => { return encoder.Condition.greater_equal },
            lir_module.CmpPredicate.ult => { return encoder.Condition.below },
            lir_module.CmpPredicate.ule => { return encoder.Condition.below_equal },
            lir_module.CmpPredicate.ugt => { return encoder.Condition.above },
            lir_module.CmpPredicate.uge => { return encoder.Condition.above_equal },
            else => { return encoder.Condition.equal },
        }
        return encoder.Condition.equal
    }
}
