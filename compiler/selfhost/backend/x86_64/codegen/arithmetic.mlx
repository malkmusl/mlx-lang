const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")

pub const Arithmetic = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        match instruction.opcode {
            lir_module.Opcode.add => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.sub => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.mul => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.bit_and => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.bit_or => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.bit_xor => { Self.emitSimple(state, index, instruction) },
            lir_module.Opcode.div => { Self.emitDivision(state, index, instruction, true, false) },
            lir_module.Opcode.rem => { Self.emitDivision(state, index, instruction, true, true) },
            lir_module.Opcode.udiv => { Self.emitDivision(state, index, instruction, false, false) },
            lir_module.Opcode.urem => { Self.emitDivision(state, index, instruction, false, true) },
            lir_module.Opcode.shl => { Self.emitShift(state, index, instruction, true) },
            lir_module.Opcode.shr => { Self.emitShift(state, index, instruction, false) },
            lir_module.Opcode.icmp => { Self.emitComparison(state, index, instruction) },
            else => { return false },
        }
        return true
    }

    fn emitSimple(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const left = state_module.State.allocateOp(state, instruction.arg0)
        const right = state_module.State.allocateOp(state, instruction.arg1)
        const destination = state_module.State.allocateOp(state, index)
        encoder.emitMovRegMem(state.*.enc, target.Register.rax, left)
        encoder.emitMovRegMem(state.*.enc, target.Register.rcx, right)
        match instruction.opcode {
            lir_module.Opcode.add => { encoder.emitAdd(state.*.enc, target.Register.rax, target.Register.rcx) },
            lir_module.Opcode.sub => { encoder.emitSub(state.*.enc, target.Register.rax, target.Register.rcx) },
            lir_module.Opcode.mul => { encoder.emitIMul(state.*.enc, target.Register.rax, target.Register.rcx) },
            lir_module.Opcode.bit_and => { encoder.emitAnd(state.*.enc, target.Register.rax, target.Register.rcx) },
            lir_module.Opcode.bit_or => { encoder.emitOr(state.*.enc, target.Register.rax, target.Register.rcx) },
            lir_module.Opcode.bit_xor => { encoder.emitXor(state.*.enc, target.Register.rax, target.Register.rcx) },
            else => {},
        }
        encoder.emitMovMemReg(state.*.enc, destination, target.Register.rax)
    }

    fn emitDivision(state: *state_module.State, index: usize, instruction: lir_module.Inst, signed: bool, remainder: bool) -> void {
        const left = state_module.State.allocateOp(state, instruction.arg0)
        const right = state_module.State.allocateOp(state, instruction.arg1)
        const destination = state_module.State.allocateOp(state, index)
        encoder.emitMovRegMem(state.*.enc, target.Register.rax, left)
        if signed { encoder.emitCqo(state.*.enc) } else { encoder.emitMovRegImm64(state.*.enc, target.Register.rdx, 0) }
        encoder.emitMovRegMem(state.*.enc, target.Register.rcx, right)
        encoder.emitDivide(state.*.enc, target.Register.rcx, signed)
        encoder.emitMovMemReg(state.*.enc, destination, if remainder { target.Register.rdx } else { target.Register.rax })
    }

    fn emitShift(state: *state_module.State, index: usize, instruction: lir_module.Inst, left: bool) -> void {
        const value = state_module.State.allocateOp(state, instruction.arg0)
        const amount = state_module.State.allocateOp(state, instruction.arg1)
        const destination = state_module.State.allocateOp(state, index)
        encoder.emitMovRegMem(state.*.enc, target.Register.rax, value)
        encoder.emitMovRegMem(state.*.enc, target.Register.rcx, amount)
        encoder.emitShiftCl(state.*.enc, target.Register.rax, left, false)
        encoder.emitMovMemReg(state.*.enc, destination, target.Register.rax)
    }

    fn emitComparison(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const predicate = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, instruction.arg0))
        const left = state_module.State.allocateOp(state, instruction.arg1)
        const right = state_module.State.allocateOp(state, instruction.arg2)
        const destination = state_module.State.allocateOp(state, index)
        encoder.emitMovRegMem(state.*.enc, target.Register.rax, left)
        encoder.emitMovRegMem(state.*.enc, target.Register.rcx, right)
        encoder.emitCmp(state.*.enc, target.Register.rax, target.Register.rcx)
        encoder.emitSetcc(state.*.enc, target.Register.rax, Self.condition(predicate))
        encoder.emitMovMemReg(state.*.enc, destination, target.Register.rax)
    }

    fn condition(predicate: lir_module.CmpPredicate) -> encoder.Condition {
        match predicate {
            lir_module.CmpPredicate.eq => { return encoder.Condition.equal },
            lir_module.CmpPredicate.ne => { return encoder.Condition.not_equal },
            lir_module.CmpPredicate.lt => { return encoder.Condition.less },
            lir_module.CmpPredicate.le => { return encoder.Condition.less_equal },
            lir_module.CmpPredicate.gt => { return encoder.Condition.greater },
            lir_module.CmpPredicate.ge => { return encoder.Condition.greater_equal },
            lir_module.CmpPredicate.ult => { return encoder.Condition.below },
            lir_module.CmpPredicate.ule => { return encoder.Condition.below_equal },
            lir_module.CmpPredicate.ugt => { return encoder.Condition.above },
            lir_module.CmpPredicate.uge => { return encoder.Condition.above_equal },
            else => { return encoder.Condition.equal },
        }
        return encoder.Condition.equal
    }
}
