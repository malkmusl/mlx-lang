const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")
const labels = @import("./labels.mlx")
const memory = @import("./memory.mlx")
const arithmetic = @import("./arithmetic.mlx")
const values = @import("./values.mlx")
const calls = @import("./calls.mlx")
const control = @import("./control.mlx")

pub const Emitter = struct {
    pub fn generateBinary(state: *state_module.State) -> void {
        Self.reserveGlobals(state)
        if !state.*.shared { Self.emitStartStub(state) }
        var index: usize = 0
        const count = lir_module.instCount(state.*.lir)
        while index < count {
            const instruction = lir_module.getInst(state.*.lir, index)
            state_module.State.settleLazy(state, index, instruction)
            lir_module.setCodeOffset(state.*.lir, index, encoder.pos(state.*.enc))
            Self.emitInstruction(state, index, instruction)
            index += 1
        }
        Self.emitStringLiterals(state)
    }

    // The globals (lir.Global: module-level vars and exported constants)
    // get their places in the data area first, in their order, so a
    // global_address instruction finds its entry by the global's index;
    // the image writers put the initial values there and name the
    // exported ones.
    fn reserveGlobals(state: *state_module.State) -> void {
        var index: usize = 0
        while index < lir_module.globalCount(state.*.lir) {
            const entry = lir_module.getGlobal(state.*.lir, index)
            const offset = encoder.reserveData(state.*.enc, entry.pointer, entry.length, entry.size, entry.alignment, entry.value, entry.bytes, entry.byteCount, entry.exported)
            index += 1
        }
    }

    // (Public for a client that runs the loop itself: mlx-cc, which emits
    // its own lir.Opcode.external instructions between.)
    pub fn emitInstruction(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if labels.Labels.emit(state, index, instruction) { return }
        if memory.Memory.emit(state, index, instruction) { return }
        if arithmetic.Arithmetic.emit(state, index, instruction) { return }
        if values.Values.emit(state, index, instruction) { return }
        if calls.Calls.emit(state, index, instruction) { return }
        const handled = control.Control.emit(state, index, instruction)
    }

    fn emitStartStub(state: *state_module.State) -> void {
        var start_name: [*]const u8 = undefined
        var main_name: [*]const u8 = undefined
        unsafe {
            start_name = @ptrCast([*]const u8, "_start")
            main_name = @ptrCast([*]const u8, "main")
        }
        encoder.defineSymbol(state.*.enc, start_name, 6)
        if state.*.freestanding {
            Self.emitFreestandingStart(state, main_name)
            return
        }
        Self.emitAggregateArena(state)
        if state.*.linked {
            encoder.emitDataStore(state.*.enc, encoder.DATA_ARENA, target.Register.r14)
            encoder.emitDataStore(state.*.enc, encoder.DATA_ARENA_END, target.Register.r15)
        }
        Self.emitGlobalInitCall(state)
        encoder.emit1(state.*.enc, 0x48)
        encoder.emit1(state.*.enc, 0x8B)
        encoder.emit1(state.*.enc, 0x34)
        encoder.emit1(state.*.enc, 0x24)
        encoder.emit1(state.*.enc, 0x48)
        encoder.emit1(state.*.enc, 0x8D)
        encoder.emit1(state.*.enc, 0x7C)
        encoder.emit1(state.*.enc, 0x24)
        encoder.emit1(state.*.enc, 0x08)
        encoder.emitCallRel(state.*.enc, main_name, 4)
        encoder.emitMovRegReg(state.*.enc, target.Register.rdi, target.Register.rax)
        // A linked program leaves through the C library's exit, which flushes
        // stdio and runs atexit handlers and library destructors.
        if state.*.linked {
            var exit_name: [*]const u8 = undefined
            unsafe { exit_name = @ptrCast([*]const u8, "exit") }
            encoder.emitImportCall(state.*.enc, exit_name, 4, 0)
        }
        // brixOS's process_exit (NATIVE_BASE + 23, spec/04-stdlib/os/brix.xml)
        // or Linux's exit.
        var exit_number: i64 = 60
        if state.*.brixos { exit_number = 0x4017 }
        encoder.emitMovRegImm64(state.*.enc, target.Register.rax, exit_number)
        encoder.emitSyscall(state.*.enc)
    }

    // The call of `__mlx_init_globals` (the lowering's function that
    // writes the addresses the globals' initializers name), when the
    // program has one: before main, the arena's registers set.
    fn emitGlobalInitCall(state: *state_module.State) -> void {
        var init_name: [*]const u8 = undefined
        unsafe { init_name = @ptrCast([*]const u8, "__mlx_init_globals") }
        if !lir_module.findSymbol(state.*.lir, init_name, 18).0 { return }
        encoder.emitCallRel(state.*.enc, init_name, 18)
    }

    // A freestanding program's start: the loader gives the arena's start in
    // rdi and its end in rsi (the stack is its too); the bump-pointer word
    // is the arena's first. main gets no arguments; when it returns the
    // processor halts (interrupts off).
    fn emitFreestandingStart(state: *state_module.State, main_name: [*]const u8) -> void {
        encoder.emitMovRegReg(state.*.enc, target.Register.r14, target.Register.rdi)
        encoder.emitMovRegReg(state.*.enc, target.Register.r15, target.Register.rsi)
        encoder.emitMovRegReg(state.*.enc, target.Register.rax, target.Register.rdi)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rcx, 8)
        encoder.emitAdd(state.*.enc, target.Register.rax, target.Register.rcx)
        encoder.emitStorePointer(state.*.enc, target.Register.r14, target.Register.rax, 8)
        Self.emitGlobalInitCall(state)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rdi, 0)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rsi, 0)
        encoder.emitCallRel(state.*.enc, main_name, 4)
        // cli; hlt; jmp back to the hlt.
        encoder.emit1(state.*.enc, 0xFA)
        encoder.emit1(state.*.enc, 0xF4)
        encoder.emit1(state.*.enc, 0xEB)
        encoder.emit1(state.*.enc, 0xFD)
    }

    // 1 GiB of address space plus the bump-pointer word, reserved without
    // committing it (MAP_NORESERVE): only the pages a program touches count.
    // (The self-hosted compiler needs more than 256 MiB for the largest
    // programs.)
    fn emitAggregateArena(state: *state_module.State) -> void {
        const capacity: i64 = 1073741832
        encoder.emitMovRegImm64(state.*.enc, target.Register.rax, 9)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rdi, 0)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rsi, capacity)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rdx, 3)
        encoder.emitMovRegImm64(state.*.enc, target.Register.r10, 16418)
        encoder.emitMovRegImm64(state.*.enc, target.Register.r8, -1)
        encoder.emitMovRegImm64(state.*.enc, target.Register.r9, 0)
        encoder.emitSyscall(state.*.enc)
        encoder.emitMovRegReg(state.*.enc, target.Register.r14, target.Register.rax)
        encoder.emitMovRegReg(state.*.enc, target.Register.r15, target.Register.rax)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rcx, capacity)
        encoder.emitAdd(state.*.enc, target.Register.r15, target.Register.rcx)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rcx, 8)
        encoder.emitAdd(state.*.enc, target.Register.rax, target.Register.rcx)
        encoder.emitStorePointer(state.*.enc, target.Register.r14, target.Register.rax, 8)
    }

    fn emitStringLiterals(state: *state_module.State) -> void {
        var literal_index: usize = 0
        while literal_index < lir_module.stringLiteralCount(state.*.lir) {
            const literal = lir_module.getStringLiteral(state.*.lir, literal_index)
            encoder.defineSymbol(state.*.enc, literal.namePointer, literal.nameLength)
            var byte_index: usize = 0
            while byte_index <= literal.length {
                encoder.emit1(state.*.enc, literal.pointer[byte_index])
                byte_index += 1
            }
            literal_index += 1
        }
    }
}
