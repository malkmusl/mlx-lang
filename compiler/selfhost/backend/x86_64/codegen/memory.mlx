const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")

// The atomics' codes, sema/builtins/atomics.mlx's.
const ORDER_SEQ_CST: usize = 5
const OP_XCHG: usize = 0
const OP_ADD: usize = 1
const OP_SUB: usize = 2
const OP_AND: usize = 3
const OP_NAND: usize = 4
const OP_OR: usize = 5
const OP_XOR: usize = 6
const OP_MAX: usize = 7
const OP_MIN: usize = 8

pub const Memory = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        match instruction.opcode {
            lir_module.Opcode.const_i => { Self.emitConstant(state, index, instruction) },
            lir_module.Opcode.addr => { Self.emitAddress(state, index, instruction) },
            lir_module.Opcode.alloca => { Self.emitAlloca(state, index, instruction) },
            lir_module.Opcode.gep => { Self.emitGep(state, index, instruction) },
            lir_module.Opcode.store => { Self.emitStore(state, instruction) },
            lir_module.Opcode.load => { Self.emitLoad(state, index, instruction) },
            lir_module.Opcode.copy => { Self.emitCopy(state, index, instruction) },
            lir_module.Opcode.cast => { Self.emitCast(state, index, instruction) },
            lir_module.Opcode.bitcast => { Self.emitCopy(state, index, instruction) },
            lir_module.Opcode.aggregate_copy => { Self.emitCopy(state, index, instruction) },
            lir_module.Opcode.mem_copy => { Self.emitMemCopy(state, instruction) },
            lir_module.Opcode.atomic_load => { Self.emitAtomicLoad(state, index, instruction) },
            lir_module.Opcode.atomic_store => { Self.emitAtomicStore(state, instruction) },
            lir_module.Opcode.atomic_rmw => { Self.emitAtomicRmw(state, index, instruction) },
            lir_module.Opcode.cmpxchg => { Self.emitCompareExchange(state, index, instruction) },
            lir_module.Opcode.fence => { Self.emitFence(state, instruction) },
            lir_module.Opcode.thread_pointer => { Self.emitThreadPointer(state, index) },
            lir_module.Opcode.frame_address => { Self.emitFrameAddress(state, index) },
            lir_module.Opcode.clone_thread => { Self.emitCloneThread(state, index, instruction) },
            else => { return false },
        }
        return true
    }

    fn emitConstant(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.storeImmediateResult(state, index, @bitCast(i64, @intCast(u64, instruction.arg0)))
    }

    fn emitAddress(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const source = state_module.State.getOrAllocSlot(state, instruction.arg0)
        encoder.emitLeaRegMem(state.*.enc, target.Register.rax, source)
        state_module.State.storeRaxResult(state, index)
    }

    fn emitAlloca(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if instruction.arg0 != lir_module.NONE && instruction.arg1 == 1 {
            // A region of the frame; functionFrameSize counted its bytes.
            const aligned = (instruction.arg0 + 7) & ~@intCast(usize, 7)
            const slot = state.*.nextStackSlot + @intCast(i32, aligned) - 8
            state.*.nextStackSlot = slot + 8
            encoder.emitLeaRegMem(state.*.enc, target.Register.rax, slot)
        } else if instruction.arg0 != lir_module.NONE {
            Self.emitArenaAllocation(state, instruction.arg0)
        } else {
            const slot = state.*.nextStackSlot
            state.*.nextStackSlot = slot + 8
            encoder.emitLeaRegMem(state.*.enc, target.Register.rax, slot)
        }
        state_module.State.storeRaxResult(state, index)
    }

    fn emitArenaAllocation(state: *state_module.State, length: usize) -> void {
        const aligned = (length + 7) & ~@intCast(usize, 7)
        state.*.aggregateAllocationCount += 1
        state.*.aggregateAllocationBytes += aligned
        encoder.emitMovRegImm64(state.*.enc, target.Register.rcx, @intCast(i64, aligned))
        encoder.emitMovRegReg(state.*.enc, target.Register.rax, target.Register.rcx)
        encoder.emitAtomicXaddPointer(state.*.enc, target.Register.r14, target.Register.rax)
        encoder.emitMovRegReg(state.*.enc, target.Register.rdx, target.Register.rax)
        encoder.emitAdd(state.*.enc, target.Register.rdx, target.Register.rcx)
        encoder.emitCmp(state.*.enc, target.Register.rdx, target.Register.r15)
        encoder.emit2(state.*.enc, 0x76, 2)
        encoder.emitTrap(state.*.enc)
    }

    // The thread pointer: the word at fs:0, where the x86_64 TLS ABI keeps
    // the thread control block's own address (mov rax, fs:[0]).
    // mov rax, rbp: the frame pointer every function here keeps.
    fn emitFrameAddress(state: *state_module.State, index: usize) -> void {
        encoder.emit3(state.*.enc, 0x48, 0x89, 0xE8)
        state.*.enc.*.raxStackSlot = 0
        state_module.State.storeRaxResult(state, index)
    }

    fn emitThreadPointer(state: *state_module.State, index: usize) -> void {
        encoder.emit4(state.*.enc, 0x64, 0x48, 0x8B, 0x04)
        encoder.emit1(state.*.enc, 0x25)
        encoder.emitImm32(state.*.enc, 0)
        state.*.enc.*.raxStackSlot = 0
        state_module.State.storeRaxResult(state, index)
    }

    // clone(flags, stack, parent_tid, child_tid, tls) with entry and
    // argument pushed on the new stack first: the child, which returns from
    // the system call on that stack, pops them, calls entry(argument) and
    // exits the thread with the result; the parent keeps the child's id (or
    // -errno). The stack top is 16-byte aligned, so the child enters entry
    // as a call does.
    fn emitCloneThread(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const operands = instruction.arg0
        state_module.State.loadOp(state, target.Register.rdi, lir_module.getExtra(state.*.lir, operands))
        state_module.State.loadOp(state, target.Register.rsi, lir_module.getExtra(state.*.lir, operands + 1))
        state_module.State.loadOp(state, target.Register.rdx, lir_module.getExtra(state.*.lir, operands + 2))
        state_module.State.loadOp(state, target.Register.r10, lir_module.getExtra(state.*.lir, operands + 3))
        state_module.State.loadOp(state, target.Register.r8, lir_module.getExtra(state.*.lir, operands + 4))
        state_module.State.loadOp(state, target.Register.r9, lir_module.getExtra(state.*.lir, operands + 6))
        state_module.State.loadOp(state, target.Register.rax, lir_module.getExtra(state.*.lir, operands + 5))
        // [stack - 16] = argument, [stack - 8] = entry; rsi = stack - 16.
        encoder.emitMovRegImm64(state.*.enc, target.Register.rcx, 16)
        encoder.emitSub(state.*.enc, target.Register.rsi, target.Register.rcx)
        encoder.emitStorePointer(state.*.enc, target.Register.rsi, target.Register.r9, 8)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rcx, 8)
        encoder.emitAdd(state.*.enc, target.Register.rsi, target.Register.rcx)
        encoder.emitStorePointer(state.*.enc, target.Register.rsi, target.Register.rax, 8)
        encoder.emitSub(state.*.enc, target.Register.rsi, target.Register.rcx)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rax, 56)
        encoder.emitSyscall(state.*.enc)
        encoder.emitTest(state.*.enc, target.Register.rax)
        const branch = encoder.pos(state.*.enc) + 1
        encoder.emit2(state.*.enc, 0x75, 0)
        // The child: pop rdi (argument), pop rax (entry), call rax, then
        // exit(result).
        encoder.emit2(state.*.enc, 0x5F, 0x58)
        encoder.emitCallReg(state.*.enc, target.Register.rax)
        encoder.emitMovRegReg(state.*.enc, target.Register.rdi, target.Register.rax)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rax, 60)
        encoder.emitSyscall(state.*.enc)
        state.*.enc.*.buf.*.items[branch] = @intCast(u8, encoder.pos(state.*.enc) - (branch + 1))
        state_module.State.storeRaxResult(state, index)
    }

    fn emitGep(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg1)
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        if instruction.arg2 == 0 {
            encoder.emitMovRegImm64(state.*.enc, target.Register.rcx, 0)
        } else if instruction.arg2 > 1 && instruction.arg2 <= 2147483647 {
            encoder.emitIMulImm(state.*.enc, target.Register.rcx, target.Register.rcx, @intCast(i32, instruction.arg2))
        } else if instruction.arg2 > 2147483647 {
            encoder.emitMovRegImm64(state.*.enc, target.Register.rdx, @bitCast(i64, @intCast(u64, instruction.arg2)))
            encoder.emitIMul(state.*.enc, target.Register.rcx, target.Register.rdx)
        }
        encoder.emitAdd(state.*.enc, target.Register.rax, target.Register.rcx)
        state_module.State.storeRaxResult(state, index)
    }

    fn emitStore(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg0)
        state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
        encoder.emitStorePointer(state.*.enc, target.Register.rcx, target.Register.rax, if instruction.arg2 == lir_module.NONE { 8 } else { instruction.arg2 })
    }

    fn emitLoad(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        const width = if instruction.arg1 == lir_module.NONE { 8 } else { instruction.arg1 }
        if instruction.arg2 == 1 {
            encoder.emitLoadPointerSigned(state.*.enc, target.Register.rax, target.Register.rax, width)
        } else {
            encoder.emitLoadPointer(state.*.enc, target.Register.rax, target.Register.rax, width)
        }
        state_module.State.storeRaxResult(state, index)
    }

    // The atomics (lir.mlx; the codes are sema/builtins/atomics.mlx's). An
    // aligned load or store of x86_64 is atomic and ordered on its own: a
    // load needs nothing more, a seq_cst store is an xchg (locked by the
    // processor); the read-modify-writes are xchg and lock xadd where there
    // is one, else a lock cmpxchg loop; a seq_cst fence is mfence, the
    // others order the compiler alone, which the LIR already does.
    fn emitAtomicLoad(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        if instruction.arg2 & 1 != 0 {
            encoder.emitLoadPointerSigned(state.*.enc, target.Register.rax, target.Register.rax, instruction.arg1)
        } else {
            encoder.emitLoadPointer(state.*.enc, target.Register.rax, target.Register.rax, instruction.arg1)
        }
        state_module.State.storeRaxResult(state, index)
    }

    fn emitAtomicStore(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg0)
        state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
        const width = instruction.arg2 & 255
        if instruction.arg2 >> 8 == ORDER_SEQ_CST {
            encoder.emitXchgPointer(state.*.enc, target.Register.rcx, target.Register.rax, width)
        } else {
            encoder.emitStorePointer(state.*.enc, target.Register.rcx, target.Register.rax, width)
        }
    }

    // rcx the address, rdx the operand; rax ends with the old value.
    fn emitAtomicRmw(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg0)
        state_module.State.loadOp(state, target.Register.rdx, instruction.arg1)
        const width = instruction.arg2 & 255
        const op = (instruction.arg2 >> 8) & 255
        const signed = (instruction.arg2 >> 24) & 1 != 0
        if op == OP_XCHG || op == OP_ADD || op == OP_SUB {
            encoder.emitMovRegReg(state.*.enc, target.Register.rax, target.Register.rdx)
            if op == OP_SUB { encoder.emitNeg(state.*.enc, target.Register.rax) }
            if op == OP_XCHG {
                encoder.emitXchgPointer(state.*.enc, target.Register.rcx, target.Register.rax, width)
            } else {
                encoder.emitLockXaddPointer(state.*.enc, target.Register.rcx, target.Register.rax, width)
            }
        } else {
            // rax = the value seen; rsi = op(rax, rdx); until the memory
            // still holds rax when rsi goes in.
            if signed {
                encoder.emitLoadPointerSigned(state.*.enc, target.Register.rax, target.Register.rcx, width)
            } else {
                encoder.emitLoadPointer(state.*.enc, target.Register.rax, target.Register.rcx, width)
            }
            const loop = encoder.pos(state.*.enc)
            encoder.emitMovRegReg(state.*.enc, target.Register.rsi, target.Register.rax)
            if op == OP_AND || op == OP_NAND { encoder.emitAnd(state.*.enc, target.Register.rsi, target.Register.rdx) }
            if op == OP_NAND { encoder.emitNot(state.*.enc, target.Register.rsi) }
            if op == OP_OR { encoder.emitOr(state.*.enc, target.Register.rsi, target.Register.rdx) }
            if op == OP_XOR { encoder.emitXor(state.*.enc, target.Register.rsi, target.Register.rdx) }
            if op == OP_MAX || op == OP_MIN {
                encoder.emitCmp(state.*.enc, target.Register.rsi, target.Register.rdx)
                var condition = if signed { encoder.Condition.less } else { encoder.Condition.below }
                if op == OP_MIN { condition = if signed { encoder.Condition.greater } else { encoder.Condition.above } }
                encoder.emitCmovcc(state.*.enc, condition, target.Register.rsi, target.Register.rdx)
            }
            encoder.emitLockCmpxchgPointer(state.*.enc, target.Register.rcx, target.Register.rsi, width)
            encoder.emitJneShort(state.*.enc, loop)
        }
        if width < 8 { encoder.emitExtend(state.*.enc, target.Register.rax, width * 8, signed) }
        state_module.State.storeRaxResult(state, index)
    }

    // rcx the address, rax the expected value, rdx the new one; rax ends
    // with the value seen and ZF says whether it swapped (weak and strong
    // are the same instruction). The two result words, like a call's: the
    // flag, then the value. rax is loaded last: the operand the previous
    // instruction left in it (State.pendingRaxVreg) has to be read out
    // before it is overwritten.
    fn emitCompareExchange(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rcx, instruction.arg0)
        state_module.State.loadOp(state, target.Register.rdx, instruction.arg2)
        state_module.State.loadOp(state, target.Register.rax, instruction.arg1)
        const width: usize = @intCast(usize, 1) << @intCast(u6, (instruction.flags >> 1) & 3)
        encoder.emitLockCmpxchgPointer(state.*.enc, target.Register.rcx, target.Register.rdx, width)
        encoder.emitSetcc(state.*.enc, target.Register.rcx, encoder.Condition.equal)
        encoder.emitExtend(state.*.enc, target.Register.rcx, 8, false)
        if width < 8 { encoder.emitExtend(state.*.enc, target.Register.rax, width * 8, instruction.flags & 8 != 0) }
        const swapped = state_module.State.allocateOp(state, index)
        const seen = state_module.State.allocateSecondaryOp(state, index)
        encoder.emitMovMemReg(state.*.enc, swapped, target.Register.rcx)
        encoder.emitMovMemReg(state.*.enc, seen, target.Register.rax)
    }

    fn emitFence(state: *state_module.State, instruction: lir_module.Inst) -> void {
        if instruction.arg0 == ORDER_SEQ_CST { encoder.emitMfence(state.*.enc) }
    }

    // rep movsb: rdi = destination, rsi = source, rcx = byte count. No value
    // stays in these registers between instructions (r14/r15 hold the arena).
    fn emitMemCopy(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rdi, instruction.arg0)
        state_module.State.loadOp(state, target.Register.rsi, instruction.arg1)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rcx, @intCast(i64, instruction.arg2))
        encoder.emit1(state.*.enc, 0xF3)
        encoder.emit1(state.*.enc, 0xA4)
    }

    fn emitCopy(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        state_module.State.storeRaxResult(state, index)
    }

    fn emitCast(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const source = state_module.State.allocateOp(state, instruction.arg0)
        const destination = state_module.State.allocateOp(state, index)
        const source_float = state_module.State.isFloatType(state, instruction.arg1)
        const target_float = state_module.State.isFloatType(state, instruction.typeId)
        if source_float && target_float {
            const source_bits = state_module.State.floatBits(state, instruction.arg1)
            const target_bits = state_module.State.floatBits(state, instruction.typeId)
            encoder.emitMovXmmMem(state.*.enc, 0, source, source_bits)
            if source_bits != target_bits { encoder.emitFloatConvert(state.*.enc, 0, 0, source_bits) }
            encoder.emitMovMemXmm(state.*.enc, destination, 0, target_bits)
            return
        }
        if !source_float && target_float {
            state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
            encoder.emitIntToFloat(state.*.enc, 0, target.Register.rax, state_module.State.floatBits(state, instruction.typeId))
            encoder.emitMovMemXmm(state.*.enc, destination, 0, state_module.State.floatBits(state, instruction.typeId))
            return
        }
        if source_float && !target_float {
            encoder.emitMovXmmMem(state.*.enc, 0, source, state_module.State.floatBits(state, instruction.arg1))
            encoder.emitFloatToInt(state.*.enc, target.Register.rax, 0, state_module.State.floatBits(state, instruction.arg1))
            state_module.State.storeRaxResult(state, index)
            return
        }
        Self.emitCopy(state, index, instruction)
    }
}
