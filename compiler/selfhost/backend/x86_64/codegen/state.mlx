const allocator_module = @import("../../../../../std/bootstrap/allocator.mlx")
const vector = @import("../../../../../std/bootstrap/vector.mlx")
const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const operands = @import("../../../ir/operands.mlx")
const type_store = @import("../../../sema/types/store.mlx")

const BLOCK_LABEL_STRIDE: usize = 32
// How many lazy loads a block may hold at once; a further one takes its
// slot at once.
const LAZY_PENDING: usize = 32

// Between Mlx functions a value of several words (a slice, an error union,
// a tuple) comes back in these registers, a word each; the caller stores
// them before anything else runs. Foreign code sees rax and rdx only.
pub const RETURN_WORDS: usize = 9

pub fn returnRegister(word: usize) -> target.Register {
    if word == 0 { return target.Register.rax }
    if word == 1 { return target.Register.rdx }
    if word == 2 { return target.Register.rcx }
    if word == 3 { return target.Register.r8 }
    if word == 4 { return target.Register.r9 }
    if word == 5 { return target.Register.r10 }
    if word == 6 { return target.Register.r11 }
    if word == 7 { return target.Register.rsi }
    return target.Register.rdi
}

pub const VregMap = struct {
    key: usize
    value: i32
}

pub const ComponentMap = struct {
    key: usize
    component: usize
    value: i32
}

pub const State = struct {
    enc: *encoder.Encoder
    lir: *lir_module.Lir
    typeStore: *type_store.Store
    nextStackSlot: i32
    vregSlots: [*]i32
    slotEpochs: [*]usize
    componentSlots: [*]i32
    componentCounts: [*]usize
    // A word slot of the frame a value is the address of (an alloca
    // without a byte count), by its offset from rbp: a load or a store
    // through it addresses the slot itself instead of loading the address
    // first. Valid in the function whose epoch it carries.
    frameAddressEpochs: [*]usize
    frameAddressOffsets: [*]i32
    slotCapacity: usize
    componentStride: usize
    // Values left out of their frame slot (lazy, while lazyEpochs holds
    // the function's epoch): an integer constant that fits in 32 bits,
    // rebuilt as an immediate wherever it is read, and a whole-word load
    // of a local kept in a register (lir.registerHome), read from that
    // register. A lazy load has to reach its slot before the register is
    // stored to or its block ends while an instruction after that still
    // reads it (lastUse, the index of its last reader); lazyPending lists
    // the current block's lazy loads.
    lastUse: [*]usize
    lazyEpochs: [*]usize
    lazyPending: [*]usize
    lazyPendingCount: usize
    lazyValueCount: usize
    // The store an arithmetic instruction already did by updating the
    // local's register in place (Arithmetic.emitInPlace).
    storeDone: usize
    inPlaceCount: usize
    // A gep with a constant offset left to the load or store right after
    // it, which reads [base + fusedOffset] (Memory.emitGep).
    fusedGep: usize
    fusedOffset: i32
    fusedAddressCount: usize
    slotEpoch: usize
    addrSlots: *vector.Vector
    blockLabelLengths: [*]usize
    blockLabelStorage: [*]u8
    blockLabelCapacity: usize
    aggregateAllocationCount: usize
    aggregateAllocationBytes: usize
    directCallCount: usize
    deferredSpillCount: usize
    retainedRaxUseCount: usize
    fallthroughBranchCount: usize
    pendingRaxVreg: usize
    pendingImmediateVreg: usize
    pendingImmediateValue: i64
    frameSize: usize
    // The callee-saved registers this function keeps locals in (bit r for
    // lir.registerHome's r), saved in the prologue at registerSave + 8 * r
    // below rbp and restored on return (ir/registers.mlx).
    registerMask: usize
    registerSave: i32
    currentReturnType: usize
    // Whether the program calls C functions (a dynamically linked
    // executable; a program that only exports some, for the kernel's
    // signal handlers, stays static), and whether the current function is
    // exported.
    linked: bool
    currentExport: bool
    // A shared object (--shared): no _start, and exported functions keep
    // the caller's aggregate arena (r14, r15) instead of reloading one.
    shared: bool
    // A plugin (--plugin, a shared object): exported functions make an
    // arena of their own on entry and unmap it on return; with stackArena
    // (--stack-arena, bytes) they reserve it below their frame instead.
    plugin: bool
    stackArena: usize
    rodataOffset: usize
    allocator: allocator_module.Allocator

    pub fn create(alloc: allocator_module.Allocator, enc: *encoder.Encoder, lir: *lir_module.Lir, types: *type_store.Store) -> *Self {
        unsafe {
            const state = @ptrCast(*Self, alloc.alloc(@sizeOf(Self), @alignOf(Self)).?)
            state.*.enc = enc
            state.*.lir = lir
            state.*.typeStore = types
            state.*.nextStackSlot = 8
            state.*.slotCapacity = if lir_module.instCount(lir) > 0 { lir_module.instCount(lir) } else { 1 }
            state.*.componentStride = Self.maximumComponentCount(lir, types)
            state.*.vregSlots = @ptrCast([*]i32, alloc.alloc(state.*.slotCapacity * @sizeOf(i32), @alignOf(i32)).?)
            state.*.slotEpochs = @ptrCast([*]usize, alloc.alloc(state.*.slotCapacity * @sizeOf(usize), @alignOf(usize)).?)
            state.*.componentSlots = @ptrCast([*]i32, alloc.alloc(state.*.slotCapacity * state.*.componentStride * @sizeOf(i32), @alignOf(i32)).?)
            state.*.componentCounts = @ptrCast([*]usize, alloc.alloc(state.*.slotCapacity * @sizeOf(usize), @alignOf(usize)).?)
            state.*.frameAddressEpochs = @ptrCast([*]usize, alloc.alloc(state.*.slotCapacity * @sizeOf(usize), @alignOf(usize)).?)
            state.*.frameAddressOffsets = @ptrCast([*]i32, alloc.alloc(state.*.slotCapacity * @sizeOf(i32), @alignOf(i32)).?)
            state.*.lastUse = @ptrCast([*]usize, alloc.alloc(state.*.slotCapacity * @sizeOf(usize), @alignOf(usize)).?)
            state.*.lazyEpochs = @ptrCast([*]usize, alloc.alloc(state.*.slotCapacity * @sizeOf(usize), @alignOf(usize)).?)
            state.*.lazyPending = @ptrCast([*]usize, alloc.alloc(LAZY_PENDING * @sizeOf(usize), @alignOf(usize)).?)
            state.*.lazyPendingCount = 0
            state.*.lazyValueCount = 0
            state.*.storeDone = lir_module.NONE
            state.*.inPlaceCount = 0
            state.*.fusedGep = lir_module.NONE
            state.*.fusedOffset = 0
            state.*.fusedAddressCount = 0
            state.*.slotEpoch = 0
            state.*.addrSlots = Self.createVector(alloc, @sizeOf(VregMap), @alignOf(VregMap), 64)
            state.*.blockLabelCapacity = Self.maximumBlockLabel(lir) + 1
            state.*.blockLabelLengths = @ptrCast([*]usize, alloc.alloc(state.*.blockLabelCapacity * @sizeOf(usize), @alignOf(usize)).?)
            state.*.blockLabelStorage = alloc.alloc(state.*.blockLabelCapacity * BLOCK_LABEL_STRIDE, 1).?
            state.*.aggregateAllocationCount = 0
            state.*.aggregateAllocationBytes = 0
            state.*.directCallCount = 0
            state.*.deferredSpillCount = 0
            state.*.retainedRaxUseCount = 0
            state.*.fallthroughBranchCount = 0
            state.*.pendingRaxVreg = lir_module.NONE
            state.*.pendingImmediateVreg = lir_module.NONE
            state.*.pendingImmediateValue = 0
            state.*.frameSize = 0
            state.*.registerMask = 0
            state.*.registerSave = 0
            state.*.currentReturnType = lir_module.NONE
            state.*.linked = Self.hasImports(lir)
            state.*.currentExport = false
            state.*.shared = false
            state.*.plugin = false
            state.*.stackArena = 0
            state.*.rodataOffset = 0
            state.*.allocator = alloc
            Self.initializeEpochs(state)
            Self.initializeLastUses(state)
            Self.initializeBlockLabels(state)
            return state
        }
    }

    fn hasImports(lir: *lir_module.Lir) -> bool {
        var index: usize = 0
        while index < lir_module.symbolCount(lir) {
            if lir_module.symbolFlags(lir, index) & lir_module.SYMBOL_IMPORT != 0 { return true }
            index += 1
        }
        return false
    }

    // The most words a value of the program has: a tuple built here, or
    // what a call returns (a callee elsewhere builds it).
    fn maximumComponentCount(lir: *lir_module.Lir, types: *type_store.Store) -> usize {
        var result: usize = 3
        var index: usize = 0
        while index < lir_module.instCount(lir) {
            const instruction = lir_module.getInst(lir, index)
            const words = Self.instructionWords(types, instruction)
            if words > result { result = words }
            index += 1
        }
        return result
    }

    fn instructionWords(types: *type_store.Store, instruction: lir_module.Inst) -> usize {
        if instruction.opcode == lir_module.Opcode.tuple_literal { return instruction.arg1 }
        return Self.wordsOf(types, instruction.typeId)
    }

    fn maximumBlockLabel(lir: *lir_module.Lir) -> usize {
        var result: usize = 0
        var index: usize = 0
        while index < lir_module.instCount(lir) {
            const instruction = lir_module.getInst(lir, index)
            if instruction.opcode == lir_module.Opcode.label && instruction.arg0 == lir_module.NONE && instruction.arg1 != lir_module.NONE && instruction.arg1 > result {
                result = instruction.arg1
            }
            if instruction.opcode == lir_module.Opcode.br && instruction.arg0 != lir_module.NONE && instruction.arg0 > result {
                result = instruction.arg0
            }
            if instruction.opcode == lir_module.Opcode.condbr {
                if instruction.arg1 != lir_module.NONE && instruction.arg1 > result { result = instruction.arg1 }
                if instruction.arg2 != lir_module.NONE && instruction.arg2 > result { result = instruction.arg2 }
            }
            index += 1
        }
        return result
    }

    fn initializeEpochs(state: *Self) -> void {
        var index: usize = 0
        while index < state.*.slotCapacity {
            state.*.slotEpochs[index] = 0
            state.*.componentCounts[index] = 0
            state.*.frameAddressEpochs[index] = 0
            state.*.lazyEpochs[index] = lir_module.NONE
            index += 1
        }
    }

    fn initializeLastUses(state: *Self) -> void {
        const count = lir_module.instCount(state.*.lir)
        var index: usize = 0
        while index < state.*.slotCapacity {
            state.*.lastUse[index] = lir_module.NONE
            index += 1
        }
        index = 0
        while index < count {
            operands.visit(state.*.lir, index, lir_module.getInst(state.*.lir, index), state.*.lastUse, count, operands.LAST)
            index += 1
        }
    }

    fn initializeBlockLabels(state: *Self) -> void {
        var index: usize = 0
        while index < state.*.blockLabelCapacity {
            state.*.blockLabelLengths[index] = 0
            index += 1
        }
    }

    fn isUnaryValue(opcode: lir_module.Opcode) -> bool {
        return opcode == lir_module.Opcode.copy || opcode == lir_module.Opcode.cast || opcode == lir_module.Opcode.bitcast || opcode == lir_module.Opcode.aggregate_copy || opcode == lir_module.Opcode.load || opcode == lir_module.Opcode.popcount || opcode == lir_module.Opcode.error_test || opcode == lir_module.Opcode.error_payload || opcode == lir_module.Opcode.error_payload_part || opcode == lir_module.Opcode.tuple_element
    }

    fn isBinaryValue(opcode: lir_module.Opcode) -> bool {
        return opcode == lir_module.Opcode.add || opcode == lir_module.Opcode.sub || opcode == lir_module.Opcode.mul || opcode == lir_module.Opcode.div || opcode == lir_module.Opcode.rem || opcode == lir_module.Opcode.udiv || opcode == lir_module.Opcode.urem || opcode == lir_module.Opcode.bit_and || opcode == lir_module.Opcode.bit_or || opcode == lir_module.Opcode.bit_xor || opcode == lir_module.Opcode.shl || opcode == lir_module.Opcode.shr || opcode == lir_module.Opcode.byte_mask_64 || opcode == lir_module.Opcode.store || opcode == lir_module.Opcode.gep
    }

    fn supportedConsumer(state: *Self, instruction: lir_module.Inst) -> bool {
        const opcode = instruction.opcode
        if Self.isFloatType(state, instruction.typeId) && (opcode == lir_module.Opcode.add || opcode == lir_module.Opcode.sub || opcode == lir_module.Opcode.mul || opcode == lir_module.Opcode.div) { return false }
        return Self.isUnaryValue(opcode) || Self.isBinaryValue(opcode) || opcode == lir_module.Opcode.icmp || opcode == lir_module.Opcode.condbr || opcode == lir_module.Opcode.ret || opcode == lir_module.Opcode.ret_slice || opcode == lir_module.Opcode.ret_error || opcode == lir_module.Opcode.ret_error_union
    }

    fn instructionUses(inst: lir_module.Inst, value: usize) -> bool {
        if Self.isUnaryValue(inst.opcode) { return inst.arg0 == value }
        if Self.isBinaryValue(inst.opcode) { return inst.arg0 == value || inst.arg1 == value }
        if inst.opcode == lir_module.Opcode.icmp { return inst.arg1 == value || inst.arg2 == value }
        if inst.opcode == lir_module.Opcode.condbr || inst.opcode == lir_module.Opcode.ret || inst.opcode == lir_module.Opcode.ret_error || inst.opcode == lir_module.Opcode.ret_error_union { return inst.arg0 == value }
        if inst.opcode == lir_module.Opcode.ret_slice { return inst.arg0 == value || inst.arg1 == value }
        return false
    }

    fn createVector(alloc: allocator_module.Allocator, element_size: usize, element_alignment: usize, capacity: usize) -> *vector.Vector {
        unsafe {
            const result = @ptrCast(*vector.Vector, alloc.alloc(@sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
            vector.Vector.initAt(result, alloc, element_size, element_alignment, capacity)
            return result
        }
    }

    pub fn destroy(state: *Self) -> void {
        unsafe {
            state.*.allocator.free(@ptrCast([*]u8, state.*.vregSlots), state.*.slotCapacity * @sizeOf(i32), @alignOf(i32))
            state.*.allocator.free(@ptrCast([*]u8, state.*.slotEpochs), state.*.slotCapacity * @sizeOf(usize), @alignOf(usize))
            state.*.allocator.free(@ptrCast([*]u8, state.*.componentSlots), state.*.slotCapacity * state.*.componentStride * @sizeOf(i32), @alignOf(i32))
            state.*.allocator.free(@ptrCast([*]u8, state.*.componentCounts), state.*.slotCapacity * @sizeOf(usize), @alignOf(usize))
            state.*.allocator.free(@ptrCast([*]u8, state.*.frameAddressEpochs), state.*.slotCapacity * @sizeOf(usize), @alignOf(usize))
            state.*.allocator.free(@ptrCast([*]u8, state.*.frameAddressOffsets), state.*.slotCapacity * @sizeOf(i32), @alignOf(i32))
            state.*.allocator.free(@ptrCast([*]u8, state.*.lastUse), state.*.slotCapacity * @sizeOf(usize), @alignOf(usize))
            state.*.allocator.free(@ptrCast([*]u8, state.*.lazyEpochs), state.*.slotCapacity * @sizeOf(usize), @alignOf(usize))
            state.*.allocator.free(@ptrCast([*]u8, state.*.lazyPending), LAZY_PENDING * @sizeOf(usize), @alignOf(usize))
            state.*.allocator.free(@ptrCast([*]u8, state.*.blockLabelLengths), state.*.blockLabelCapacity * @sizeOf(usize), @alignOf(usize))
            state.*.allocator.free(state.*.blockLabelStorage, state.*.blockLabelCapacity * BLOCK_LABEL_STRIDE, 1)
        }
        Self.destroyVector(state, state.*.addrSlots)
        unsafe { state.*.allocator.free(@ptrCast([*]u8, state), @sizeOf(Self), @alignOf(Self)) }
    }

    fn destroyVector(state: *Self, value: *vector.Vector) -> void {
        vector.Vector.deinit(value.*)
        unsafe { state.*.allocator.free(@ptrCast([*]u8, value), @sizeOf(vector.Vector), @alignOf(vector.Vector)) }
    }

    fn getMap(values: *vector.Vector, key: usize) -> (bool, i32) {
        var index: usize = 0
        while index < values.*.length {
            unsafe {
                const entry = @ptrCast(*VregMap, vector.Vector.at(values.*, index))
                if entry.*.key == key { return -> (true, entry.*.value) }
            }
            index += 1
        }
        return -> (false, 0)
    }

    fn putMap(values: *vector.Vector, key: usize, value: i32) -> void {
        var entry = VregMap.{ .key = key, .value = value }
        unsafe { const appended = vector.Vector.appendAt(values, @ptrCast([*]const u8, &entry)) }
    }

    // The slot a value is read from or written to; a lazy value read
    // through it is put there first.
    pub fn allocateOp(state: *Self, vreg: usize) -> i32 {
        if Self.isLazy(state, vreg) { return Self.materialize(state, vreg) }
        return Self.allocateSlot(state, vreg)
    }

    fn allocateSlot(state: *Self, vreg: usize) -> i32 {
        if state.*.slotEpochs[vreg] == state.*.slotEpoch { return state.*.vregSlots[vreg] }
        const slot = state.*.nextStackSlot
        state.*.nextStackSlot = slot + 8
        state.*.slotEpochs[vreg] = state.*.slotEpoch
        state.*.vregSlots[vreg] = slot
        state.*.componentCounts[vreg] = 1
        return slot
    }

    pub fn isLazy(state: *Self, vreg: usize) -> bool {
        return vreg < state.*.slotCapacity && state.*.lazyEpochs[vreg] == state.*.slotEpoch
    }

    // The register a lazy load reads (0 for a lazy constant).
    fn lazyHome(state: *Self, vreg: usize) -> usize {
        const instruction = lir_module.getInst(state.*.lir, vreg)
        if instruction.opcode != lir_module.Opcode.load { return 0 }
        return lir_module.registerHome(state.*.lir, instruction.arg0)
    }

    // A lazy constant's value.
    pub fn constantValue(state: *Self, vreg: usize) -> (bool, i64) {
        if !Self.isLazy(state, vreg) || Self.lazyHome(state, vreg) != 0 { return -> (false, 0) }
        return -> (true, Self.lazyConstant(state, vreg))
    }

    fn lazyConstant(state: *Self, vreg: usize) -> i64 {
        return @bitCast(i64, @intCast(u64, lir_module.getInst(state.*.lir, vreg).arg0))
    }

    // The register a lazy load can be read from where it is used.
    pub fn lazyRegister(state: *Self, vreg: usize) -> (bool, target.Register) {
        if !Self.isLazy(state, vreg) { return -> (false, target.Register.rax) }
        const home = Self.lazyHome(state, vreg)
        if home == 0 { return -> (false, target.Register.rax) }
        return -> (true, Self.homeRegister(home))
    }

    fn deferrable(state: *Self, index: usize) -> bool {
        const instruction = lir_module.getInst(state.*.lir, index)
        return !Self.isFloatType(state, instruction.typeId) && Self.typeWordCount(state, instruction.typeId) == 1
    }

    // A const_i: true when it is left lazy (no code here).
    pub fn deferConstant(state: *Self, index: usize, value: i64) -> bool {
        if value < -2147483648 || value > 2147483647 || !Self.deferrable(state, index) { return false }
        state.*.lazyEpochs[index] = state.*.slotEpoch
        state.*.lazyValueCount += 1
        return true
    }

    // A whole-word load of a local kept in a register: true when it is
    // left lazy.
    pub fn deferRegisterLoad(state: *Self, index: usize) -> bool {
        if state.*.lazyPendingCount >= LAZY_PENDING || !Self.deferrable(state, index) { return false }
        state.*.lazyEpochs[index] = state.*.slotEpoch
        state.*.lazyPending[state.*.lazyPendingCount] = index
        state.*.lazyPendingCount += 1
        state.*.lazyValueCount += 1
        return true
    }

    // Writes a lazy value into its slot. A constant stays lazy (each read
    // through the slot writes it again, so every path to a read has it);
    // a load does not, its register may change after this.
    fn materialize(state: *Self, vreg: usize) -> i32 {
        const slot = Self.allocateSlot(state, vreg)
        const home = Self.lazyHome(state, vreg)
        if home == 0 {
            encoder.emitMovMemImm32(state.*.enc, slot, @intCast(i32, Self.lazyConstant(state, vreg)))
            return slot
        }
        encoder.emitMovMemReg(state.*.enc, slot, Self.homeRegister(home))
        state.*.lazyEpochs[vreg] = lir_module.NONE
        return slot
    }

    // Before the instruction at `index`: a block ends at a label or a
    // branch or return, and its lazy loads that a later instruction reads
    // go to their slots (a later block may be reached on another path, or
    // after the register changed). A function's label starts afresh.
    pub fn settleLazy(state: *Self, index: usize, instruction: lir_module.Inst) -> void {
        if state.*.lazyPendingCount == 0 { return }
        const opcode = instruction.opcode
        if opcode == lir_module.Opcode.label && instruction.arg0 != lir_module.NONE {
            state.*.lazyPendingCount = 0
            return
        }
        if opcode == lir_module.Opcode.label || opcode == lir_module.Opcode.br || opcode == lir_module.Opcode.condbr || opcode == lir_module.Opcode.icmp_br ||
            opcode == lir_module.Opcode.ret || opcode == lir_module.Opcode.ret_slice || opcode == lir_module.Opcode.ret_error || opcode == lir_module.Opcode.ret_error_union ||
            opcode == lir_module.Opcode.unreachable_inst {
            Self.spillLazy(state, index, 0)
        }
    }

    // Before a store into register `home` (0: before a block ends): the
    // lazy loads of it that an instruction after `index` reads go to their
    // slots; the rest are no longer pending (only `index` itself may still
    // read them, before the register changes).
    pub fn spillLazy(state: *Self, index: usize, home: usize) -> void {
        var kept: usize = 0
        var at: usize = 0
        while at < state.*.lazyPendingCount {
            const vreg = state.*.lazyPending[at]
            const affected = home == 0 || Self.lazyHome(state, vreg) == home
            if affected && Self.isLazy(state, vreg) && state.*.lastUse[vreg] != lir_module.NONE && state.*.lastUse[vreg] > index {
                const slot = Self.materialize(state, vreg)
            }
            if !affected {
                state.*.lazyPending[kept] = vreg
                kept += 1
            }
            at += 1
        }
        state.*.lazyPendingCount = kept
    }

    pub fn pendingRaxIs(state: *Self, vreg: usize) -> bool {
        return state.*.pendingRaxVreg == vreg || state.*.pendingImmediateVreg == vreg
    }

    pub fn takeImmediate32(state: *Self, vreg: usize) -> (bool, i32) {
        if Self.isLazy(state, vreg) && Self.lazyHome(state, vreg) == 0 { return -> (true, @intCast(i32, Self.lazyConstant(state, vreg))) }
        if state.*.pendingImmediateVreg != vreg { return -> (false, 0) }
        const value = state.*.pendingImmediateValue
        if value < -2147483648 || value > 2147483647 { return -> (false, 0) }
        state.*.pendingImmediateVreg = lir_module.NONE
        state.*.retainedRaxUseCount += 1
        return -> (true, @intCast(i32, value))
    }

    pub fn noteFrameAddress(state: *Self, vreg: usize, rbp_offset: i32) -> void {
        state.*.frameAddressEpochs[vreg] = state.*.slotEpoch
        state.*.frameAddressOffsets[vreg] = rbp_offset
    }

    // The frame slot `vreg` is the address of, if it is one.
    pub fn frameAddress(state: *Self, vreg: usize) -> (bool, i32) {
        if vreg >= state.*.slotCapacity || state.*.frameAddressEpochs[vreg] != state.*.slotEpoch { return -> (false, 0) }
        return -> (true, state.*.frameAddressOffsets[vreg])
    }

    // A value used without being loaded: if it was kept in rax for this
    // use (not spilled), that use is over.
    pub fn dropPending(state: *Self, vreg: usize) -> void {
        if state.*.pendingRaxVreg == vreg {
            state.*.pendingRaxVreg = lir_module.NONE
            state.*.retainedRaxUseCount += 1
        }
    }

    pub fn loadOp(state: *Self, destination: target.Register, vreg: usize) -> void {
        if Self.isLazy(state, vreg) {
            const home = Self.lazyHome(state, vreg)
            if home == 0 {
                encoder.emitMovRegImm64(state.*.enc, destination, Self.lazyConstant(state, vreg))
            } else {
                encoder.emitMovRegReg(state.*.enc, destination, Self.homeRegister(home))
            }
            return
        }
        if state.*.pendingImmediateVreg == vreg {
            state.*.pendingImmediateVreg = lir_module.NONE
            state.*.retainedRaxUseCount += 1
            encoder.emitMovRegImm64(state.*.enc, destination, state.*.pendingImmediateValue)
            return
        }
        if state.*.pendingRaxVreg == vreg {
            state.*.pendingRaxVreg = lir_module.NONE
            state.*.retainedRaxUseCount += 1
            if destination != target.Register.rax { encoder.emitMovRegReg(state.*.enc, destination, target.Register.rax) }
            return
        }
        encoder.emitMovRegMem(state.*.enc, destination, Self.allocateOp(state, vreg))
    }

    fn canRetainNext(state: *Self, index: usize) -> bool {
        const next_index = index + 1
        const result = lir_module.getInst(state.*.lir, index)
        if Self.isFloatType(state, result.typeId) || Self.typeWordCount(state, result.typeId) != 1 { return false }
        if result.flags & lir_module.FLAG_RETAIN_NEXT == 0 || next_index >= state.*.slotCapacity { return false }
        const next = lir_module.getInst(state.*.lir, next_index)
        return Self.supportedConsumer(state, next) && Self.instructionUses(next, index)
    }

    pub fn storeImmediateResult(state: *Self, index: usize, value: i64) -> void {
        if Self.canRetainNext(state, index) {
            state.*.pendingImmediateVreg = index
            state.*.pendingImmediateValue = value
            state.*.deferredSpillCount += 1
            return
        }
        encoder.emitMovRegImm64(state.*.enc, target.Register.rax, value)
        encoder.emitMovMemReg(state.*.enc, Self.allocateOp(state, index), target.Register.rax)
    }

    pub fn storeRaxResult(state: *Self, index: usize) -> void {
        if Self.canRetainNext(state, index) {
            state.*.pendingRaxVreg = index
            state.*.deferredSpillCount += 1
            return
        }
        encoder.emitMovMemReg(state.*.enc, Self.allocateOp(state, index), target.Register.rax)
    }

    pub fn getOrAllocSlot(state: *Self, variable: usize) -> i32 {
        const found = Self.getMap(state.*.addrSlots, variable)
        if found.0 { return found.1 }
        const slot = state.*.nextStackSlot
        state.*.nextStackSlot = slot + 8
        Self.putMap(state.*.addrSlots, variable, slot)
        return slot
    }

    pub fn getComponent(state: *Self, vreg: usize, component: usize) -> (bool, i32) {
        if state.*.slotEpochs[vreg] != state.*.slotEpoch { return -> (false, 0) }
        if component == 0 { return -> (true, state.*.vregSlots[vreg]) }
        if component >= state.*.componentCounts[vreg] { return -> (false, 0) }
        return -> (true, state.*.componentSlots[vreg * state.*.componentStride + component])
    }

    pub fn allocateComponentOp(state: *Self, vreg: usize, component: usize) -> i32 {
        if component == 0 { return Self.allocateOp(state, vreg) }
        const found = Self.getComponent(state, vreg, component)
        if found.0 { return found.1 }
        if state.*.slotEpochs[vreg] != state.*.slotEpoch { const primary = Self.allocateOp(state, vreg) }
        const slot = state.*.nextStackSlot
        state.*.nextStackSlot = slot + 8
        state.*.componentSlots[vreg * state.*.componentStride + component] = slot
        if component + 1 > state.*.componentCounts[vreg] { state.*.componentCounts[vreg] = component + 1 }
        return slot
    }

    pub fn allocateSecondaryOp(state: *Self, vreg: usize) -> i32 { return Self.allocateComponentOp(state, vreg, 1) }

    pub fn allocateTertiaryOp(state: *Self, vreg: usize) -> i32 { return Self.allocateComponentOp(state, vreg, 2) }

    pub fn componentCount(state: *Self, vreg: usize) -> usize {
        if state.*.slotEpochs[vreg] != state.*.slotEpoch { return 1 }
        return state.*.componentCounts[vreg]
    }

    pub fn isFloatType(state: *Self, type_id: usize) -> bool {
        if type_id == lir_module.NONE || type_id >= type_store.Store.count(state.*.typeStore) { return false }
        const value = type_store.Store.get(state.*.typeStore, type_id)
        return value.*.kind == type_store.Kind.float || value.*.kind == type_store.Kind.comptime_float_type
    }

    pub fn floatBits(state: *Self, type_id: usize) -> usize {
        if !Self.isFloatType(state, type_id) { return 64 }
        const value = type_store.Store.get(state.*.typeStore, type_id)
        if value.*.kind == type_store.Kind.float && value.*.bits == 32 { return 32 }
        return 64
    }

    // A 64-bit unsigned integer (u64, usize): its values from 2^63 on are
    // not an i64's, which the processor's conversions take.
    pub fn isUnsigned64(state: *Self, type_id: usize) -> bool {
        if type_id == lir_module.NONE || type_id >= type_store.Store.count(state.*.typeStore) { return false }
        const value = type_store.Store.get(state.*.typeStore, type_id)
        return value.*.kind == type_store.Kind.integer && value.*.bits == 64 && value.*.flags & type_store.FLAG_SIGNED == 0
    }

    pub fn isSignedType(state: *Self, type_id: usize) -> bool {
        if type_id == lir_module.NONE || type_id >= type_store.Store.count(state.*.typeStore) { return false }
        const value = type_store.Store.get(state.*.typeStore, type_id)
        return value.*.kind == type_store.Kind.integer && value.*.flags & type_store.FLAG_SIGNED != 0
    }

    // Width in bits of an integer (or bool) type narrower than 64 bits and
    // whether it is signed; (0, false) for everything else.
    pub fn narrowInteger(state: *Self, type_id: usize) -> (usize, bool) {
        if type_id == lir_module.NONE || type_id >= type_store.Store.count(state.*.typeStore) { return -> (0, false) }
        const value = type_store.Store.get(state.*.typeStore, type_id)
        if value.*.kind == type_store.Kind.bool_type { return -> (8, false) }
        // An enum crosses the C ABI as its backing integer (VkResult is an i32).
        if value.*.kind == type_store.Kind.enum_type && value.*.backing != type_store.NONE && value.*.backing != type_id { return Self.narrowInteger(state, value.*.backing) }
        if value.*.kind == type_store.Kind.integer && value.*.bits > 0 && value.*.bits < 64 {
            return -> (value.*.bits, value.*.flags & type_store.FLAG_SIGNED != 0)
        }
        return -> (0, false)
    }

    pub fn isErrorUnion(state: *Self, type_id: usize) -> bool {
        return type_id != lir_module.NONE && type_id < type_store.Store.count(state.*.typeStore) && type_store.Store.get(state.*.typeStore, type_id).*.kind == type_store.Kind.error_union
    }

    pub fn isFloatErrorUnion(state: *Self, type_id: usize) -> bool {
        if !Self.isErrorUnion(state, type_id) { return false }
        return Self.isFloatType(state, type_store.Store.get(state.*.typeStore, type_id).*.rhs)
    }

    pub fn errorUnionPayloadType(state: *Self, type_id: usize) -> usize {
        if !Self.isErrorUnion(state, type_id) { return lir_module.NONE }
        return type_store.Store.get(state.*.typeStore, type_id).*.rhs
    }

    pub fn typeWordCount(state: *Self, type_id: usize) -> usize { return Self.wordsOf(state.*.typeStore, type_id) }

    fn wordsOf(types: *type_store.Store, type_id: usize) -> usize {
        if type_id == lir_module.NONE || type_id >= type_store.Store.count(types) { return 1 }
        const value = type_store.Store.get(types, type_id)
        if value.*.kind == type_store.Kind.slice { return 2 }
        // An integer wider than a word: its words (ir/lowering/wide.mlx).
        if value.*.kind == type_store.Kind.integer && value.*.bits > 64 { return (value.*.bits + 63) / 64 }
        // An error union is its tag and then the payload's words.
        if value.*.kind == type_store.Kind.error_union {
            const words = 1 + Self.wordsOf(types, value.*.rhs)
            if words > RETURN_WORDS { return RETURN_WORDS }
            return words
        }
        // An optional slice is the slice (null: pointer 0).
        if value.*.kind == type_store.Kind.optional && type_store.Store.get(types, value.*.lhs).*.kind == type_store.Kind.slice { return 2 }
        if value.*.kind == type_store.Kind.tuple {
            var result: usize = 0
            var index: usize = 0
            while index < value.*.extraLength {
                result += Self.wordsOf(types, type_store.Store.extraAt(types, value.*.extraStart + index))
                index += 1
            }
            if result > RETURN_WORDS { return RETURN_WORDS }
            return result
        }
        return 1
    }

    pub fn incomingArgumentSlot(index: usize) -> i32 { return @intCast(i32, (index + 1) * 8) }

    // The register a local lives in (ir/registers.mlx: 1 rbx, 2 r12, 3 r13).
    pub fn homeRegister(home: usize) -> target.Register {
        if home == 1 { return target.Register.rbx }
        if home == 2 { return target.Register.r12 }
        return target.Register.r13
    }

    pub fn homeBit(home: usize) -> usize {
        if home == 1 { return 2 }
        if home == 2 { return 4 }
        return 8
    }

    // Which of them the function from `label_index` keeps locals in.
    pub fn functionRegisters(state: *Self, label_index: usize) -> usize {
        var mask: usize = 0
        var index = label_index + 1
        const total = lir_module.instCount(state.*.lir)
        while index < total {
            const instruction = lir_module.getInst(state.*.lir, index)
            if instruction.opcode == lir_module.Opcode.label && instruction.arg0 != lir_module.NONE { break }
            const home = lir_module.registerHome(state.*.lir, index)
            if home != 0 { mask = mask | Self.homeBit(home) }
            index += 1
        }
        return mask
    }

    pub fn beginFunction(state: *Self, frame_size: usize) -> void {
        state.*.addrSlots.*.length = 0
        state.*.pendingRaxVreg = lir_module.NONE
        state.*.pendingImmediateVreg = lir_module.NONE
        state.*.slotEpoch += 1
        state.*.lazyPendingCount = 0
        state.*.fusedGep = lir_module.NONE
        state.*.nextStackSlot = 8
        state.*.frameSize = frame_size
    }

    pub fn functionFrameSize(state: *Self, label_index: usize) -> usize {
        var index = label_index + 1
        var count: usize = 0
        const total = lir_module.instCount(state.*.lir)
        // Aggregates copied into the frame (alloca with arg1 == 1, or 2
        // for one zeroed where it is made) take
        // their own bytes on top of the per-instruction slot budget.
        var regions: usize = 0
        while index < total {
            const instruction = lir_module.getInst(state.*.lir, index)
            if instruction.opcode == lir_module.Opcode.label && instruction.arg0 != lir_module.NONE { break }
            if instruction.opcode != lir_module.Opcode.dead {
                count += 1
                // Three words each are in the budget; a tuple of more takes
                // a slot for every further one.
                const words = Self.instructionWords(state.*.typeStore, instruction)
                if words > 3 { regions += (words - 3) * 8 }
            }
            if instruction.opcode == lir_module.Opcode.alloca && instruction.arg0 != lir_module.NONE && (instruction.arg1 == 1 || instruction.arg1 == 2) { regions += (instruction.arg0 + 7) & ~@intCast(usize, 7) }
            index += 1
        }
        return (count * 24 + regions + 271) & ~@intCast(usize, 15)
    }

    pub fn blockLabelName(state: *Self, index: usize) -> ([*]const u8, usize) {
        var result: [*]u8 = undefined
        unsafe { result = @ptrFromInt([*]u8, @intFromPtr(state.*.blockLabelStorage) + index * BLOCK_LABEL_STRIDE) }
        if state.*.blockLabelLengths[index] != 0 {
            return -> (result, state.*.blockLabelLengths[index])
        }
        result[0] = 46
        result[1] = 98
        result[2] = 108
        result[3] = 111
        result[4] = 99
        result[5] = 107
        result[6] = 95
        var length: usize = 7
        if index == 0 {
            result[length] = 48
            length += 1
        } else {
            var divisor: usize = 1
            while index / divisor >= 10 { divisor *= 10 }
            while divisor > 0 {
                result[length] = @intCast(u8, 48 + (index / divisor) % 10)
                length += 1
                divisor /= 10
            }
        }
        state.*.blockLabelLengths[index] = length
        return -> (result, length)
    }
}
