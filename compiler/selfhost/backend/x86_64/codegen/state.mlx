const allocator_module = @import("../../../../../std/bootstrap/allocator.mlx")
const array_list = @import("../../../../../std/bootstrap/array_list.mlx")
const vector = @import("../../../../../std/bootstrap/vector.mlx")
const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")

pub const VregMap = struct {
    key: usize
    value: i32
}

pub const ComponentMap = struct {
    key: usize
    component: usize
    value: i32
}

pub const State = struct {
    enc: *encoder.Encoder
    lir: *lir_module.Lir
    nextStackSlot: i32
    vregSlots: *vector.Vector
    componentSlots: *vector.Vector
    addrSlots: *vector.Vector
    labelNames: *vector.Vector
    frameSize: usize
    rodataOffset: usize
    allocatorContext: usize
    allocFn: allocator_module.AllocFn
    resizeFn: allocator_module.ResizeFn
    freeFn: allocator_module.FreeFn

    pub fn create(alloc: allocator_module.Allocator, enc: *encoder.Encoder, lir: *lir_module.Lir) -> *Self {
        unsafe {
            const state = @ptrCast(*Self, alloc.allocFn(alloc.context, @sizeOf(Self), @alignOf(Self)).?)
            state.*.enc = enc
            state.*.lir = lir
            state.*.nextStackSlot = 8
            state.*.vregSlots = Self.createVector(alloc, @sizeOf(VregMap), @alignOf(VregMap), 64)
            state.*.componentSlots = Self.createVector(alloc, @sizeOf(ComponentMap), @alignOf(ComponentMap), 64)
            state.*.addrSlots = Self.createVector(alloc, @sizeOf(VregMap), @alignOf(VregMap), 64)
            state.*.labelNames = Self.createVector(alloc, @sizeOf(array_list.ArrayList), @alignOf(array_list.ArrayList), 32)
            state.*.frameSize = 0
            state.*.rodataOffset = 0
            state.*.allocatorContext = alloc.context
            state.*.allocFn = alloc.allocFn
            state.*.resizeFn = alloc.resizeFn
            state.*.freeFn = alloc.freeFn
            return state
        }
    }

    fn createVector(alloc: allocator_module.Allocator, element_size: usize, element_alignment: usize, capacity: usize) -> *vector.Vector {
        unsafe {
            const result = @ptrCast(*vector.Vector, alloc.allocFn(alloc.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
            vector.Vector.initAt(result, alloc, element_size, element_alignment, capacity)
            return result
        }
    }

    pub fn destroy(state: *Self) -> void {
        var index: usize = 0
        while index < state.*.labelNames.*.length {
            unsafe { array_list.ArrayList.deinit(@ptrCast(*array_list.ArrayList, vector.Vector.at(state.*.labelNames.*, index)).*) }
            index += 1
        }
        Self.destroyVector(state, state.*.vregSlots)
        Self.destroyVector(state, state.*.componentSlots)
        Self.destroyVector(state, state.*.addrSlots)
        Self.destroyVector(state, state.*.labelNames)
        unsafe { state.*.freeFn(state.*.allocatorContext, @ptrCast([*]u8, state), @sizeOf(Self), @alignOf(Self)) }
    }

    fn destroyVector(state: *Self, value: *vector.Vector) -> void {
        vector.Vector.deinit(value.*)
        unsafe { state.*.freeFn(state.*.allocatorContext, @ptrCast([*]u8, value), @sizeOf(vector.Vector), @alignOf(vector.Vector)) }
    }

    pub fn retainLabelName(state: *Self, label: *array_list.ArrayList) -> void {
        unsafe { const appended = vector.Vector.appendAt(state.*.labelNames, @ptrCast([*]const u8, label)) }
    }

    fn getMap(values: *vector.Vector, key: usize) -> (bool, i32) {
        var index: usize = 0
        while index < values.*.length {
            unsafe {
                const entry = @ptrCast(*VregMap, vector.Vector.at(values.*, index))
                if entry.*.key == key { return -> (true, entry.*.value) }
            }
            index += 1
        }
        return -> (false, 0)
    }

    fn putMap(values: *vector.Vector, key: usize, value: i32) -> void {
        var entry = VregMap.{ .key = key, .value = value }
        unsafe { const appended = vector.Vector.appendAt(values, @ptrCast([*]const u8, &entry)) }
    }

    pub fn allocateOp(state: *Self, vreg: usize) -> i32 {
        const found = Self.getMap(state.*.vregSlots, vreg)
        if found.0 { return found.1 }
        const slot = state.*.nextStackSlot
        state.*.nextStackSlot = slot + 8
        Self.putMap(state.*.vregSlots, vreg, slot)
        return slot
    }

    pub fn getOrAllocSlot(state: *Self, variable: usize) -> i32 {
        const found = Self.getMap(state.*.addrSlots, variable)
        if found.0 { return found.1 }
        const slot = state.*.nextStackSlot
        state.*.nextStackSlot = slot + 8
        Self.putMap(state.*.addrSlots, variable, slot)
        return slot
    }

    pub fn getComponent(state: *Self, vreg: usize, component: usize) -> (bool, i32) {
        if component == 0 { return Self.getMap(state.*.vregSlots, vreg) }
        var index: usize = 0
        while index < state.*.componentSlots.*.length {
            unsafe {
                const entry = @ptrCast(*ComponentMap, vector.Vector.at(state.*.componentSlots.*, index))
                if entry.*.key == vreg && entry.*.component == component { return -> (true, entry.*.value) }
            }
            index += 1
        }
        return -> (false, 0)
    }

    pub fn allocateComponentOp(state: *Self, vreg: usize, component: usize) -> i32 {
        if component == 0 { return Self.allocateOp(state, vreg) }
        const found = Self.getComponent(state, vreg, component)
        if found.0 { return found.1 }
        const slot = state.*.nextStackSlot
        state.*.nextStackSlot = slot + 8
        var entry = ComponentMap.{ .key = vreg, .component = component, .value = slot }
        unsafe { const appended = vector.Vector.appendAt(state.*.componentSlots, @ptrCast([*]const u8, &entry)) }
        return slot
    }

    pub fn allocateSecondaryOp(state: *Self, vreg: usize) -> i32 { return Self.allocateComponentOp(state, vreg, 1) }

    pub fn allocateTertiaryOp(state: *Self, vreg: usize) -> i32 { return Self.allocateComponentOp(state, vreg, 2) }

    pub fn componentCount(state: *Self, vreg: usize) -> usize {
        var count: usize = 1
        var index: usize = 0
        while index < state.*.componentSlots.*.length {
            unsafe {
                const entry = @ptrCast(*ComponentMap, vector.Vector.at(state.*.componentSlots.*, index))
                if entry.*.key == vreg && entry.*.component + 1 > count { count = entry.*.component + 1 }
            }
            index += 1
        }
        return count
    }

    pub fn incomingArgumentSlot(index: usize) -> i32 { return @intCast(i32, (index + 1) * 8) }

    pub fn beginFunction(state: *Self, frame_size: usize) -> void {
        state.*.vregSlots.*.length = 0
        state.*.componentSlots.*.length = 0
        state.*.addrSlots.*.length = 0
        state.*.nextStackSlot = @intCast(i32, (target.ARG_REGS_COUNT + 1) * 8)
        state.*.frameSize = frame_size
    }

    pub fn functionFrameSize(state: *Self, label_index: usize) -> usize {
        var index = label_index + 1
        var count: usize = 0
        const total = lir_module.instCount(state.*.lir)
        while index < total {
            const instruction = lir_module.getInst(state.*.lir, index)
            if instruction.opcode == lir_module.Opcode.label && instruction.arg0 != lir_module.NONE { break }
            count += 1
            index += 1
        }
        return (count * 24 + 271) & ~@intCast(usize, 15)
    }

    pub fn blockLabelName(state: *Self, index: usize) -> array_list.ArrayList {
        const alloc = allocator_module.Allocator.{ .context = state.*.allocatorContext, .allocFn = state.*.allocFn, .resizeFn = state.*.resizeFn, .freeFn = state.*.freeFn }
        var result = array_list.ArrayList.init(alloc, 16)
        result = Self.appendLabelPrefix(result)
        if index == 0 { return array_list.ArrayList.append(result, 48) }
        var reverse = array_list.ArrayList.init(alloc, 16)
        var remaining = index
        while remaining > 0 {
            reverse = array_list.ArrayList.append(reverse, @intCast(u8, 48 + remaining % 10))
            remaining /= 10
        }
        var digit = reverse.length
        while digit > 0 {
            digit -= 1
            result = array_list.ArrayList.append(result, array_list.ArrayList.get(reverse, digit))
        }
        array_list.ArrayList.deinit(reverse)
        return result
    }

    fn appendLabelPrefix(value: array_list.ArrayList) -> array_list.ArrayList {
        var result = value
        result = array_list.ArrayList.append(result, 46)
        result = array_list.ArrayList.append(result, 98)
        result = array_list.ArrayList.append(result, 108)
        result = array_list.ArrayList.append(result, 111)
        result = array_list.ArrayList.append(result, 99)
        result = array_list.ArrayList.append(result, 107)
        return array_list.ArrayList.append(result, 95)
    }
}
