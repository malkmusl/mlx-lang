const encoder = @import("../encoder.mlx")
const target = @import("../target.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")

pub const Control = struct {
    pub fn emit(state: *state_module.State, instruction: lir_module.Inst) -> bool {
        match instruction.opcode {
            lir_module.Opcode.ret_error => { Self.emitErrorReturn(state, instruction) },
            lir_module.Opcode.ret_error_union => { Self.emitErrorUnionReturn(state, instruction) },
            lir_module.Opcode.ret => { Self.emitReturn(state, instruction) },
            lir_module.Opcode.ret_slice => { Self.emitSliceReturn(state, instruction) },
            lir_module.Opcode.br => { Self.emitBranch(state, instruction.arg0) },
            lir_module.Opcode.condbr => { Self.emitConditionalBranch(state, instruction) },
            lir_module.Opcode.icmp_br => { Self.emitIntegerComparisonBranch(state, instruction) },
            lir_module.Opcode.unreachable_inst => { encoder.emitTrap(state.*.enc) },
            else => { return false },
        }
        return true
    }

    fn emitErrorReturn(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        encoder.emitMovRegImm64(state.*.enc, target.Register.rdx, 0)
        Self.emitEpilogue(state)
    }

    fn emitErrorUnionReturn(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        const payload = state_module.State.getComponent(state, instruction.arg0, 1)
        if payload.0 && state_module.State.isFloatErrorUnion(state, instruction.typeId) {
            const payload_type = state_module.State.errorUnionPayloadType(state, instruction.typeId)
            encoder.emitMovXmmMem(state.*.enc, 0, payload.1, state_module.State.floatBits(state, payload_type))
        } else if payload.0 {
            encoder.emitMovRegMem(state.*.enc, target.Register.rdx, payload.1)
        } else {
            encoder.emitMovRegImm64(state.*.enc, target.Register.rdx, 0)
        }
        Self.emitEpilogue(state)
    }

    fn emitReturn(state: *state_module.State, instruction: lir_module.Inst) -> void {
        if instruction.arg0 != lir_module.NONE {
            if state_module.State.isFloatType(state, instruction.typeId) {
                encoder.emitMovXmmMem(state.*.enc, 0, state_module.State.allocateOp(state, instruction.arg0), state_module.State.floatBits(state, instruction.typeId))
                Self.emitEpilogue(state)
                return
            }
            state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
            const secondary = state_module.State.getComponent(state, instruction.arg0, 1)
            if secondary.0 { encoder.emitMovRegMem(state.*.enc, target.Register.rdx, secondary.1) }
            const tertiary = state_module.State.getComponent(state, instruction.arg0, 2)
            if tertiary.0 { encoder.emitMovRegMem(state.*.enc, target.Register.rcx, tertiary.1) }
        }
        Self.emitEpilogue(state)
    }

    fn emitSliceReturn(state: *state_module.State, instruction: lir_module.Inst) -> void {
        if state_module.State.pendingRaxIs(state, instruction.arg1) {
            state_module.State.loadOp(state, target.Register.rdx, instruction.arg1)
            state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        } else {
            state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
            state_module.State.loadOp(state, target.Register.rdx, instruction.arg1)
        }
        Self.emitEpilogue(state)
    }

    fn emitEpilogue(state: *state_module.State) -> void {
        encoder.emitMovRspRbp(state.*.enc)
        encoder.emitPopRbp(state.*.enc)
        encoder.emitRet(state.*.enc)
    }

    fn emitBranch(state: *state_module.State, target_index: usize) -> void {
        const label = state_module.State.blockLabelName(state, target_index)
        encoder.emitJmpRel(state.*.enc, label.0, label.1)
    }

    fn emitConditionalBranch(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, target.Register.rax, instruction.arg0)
        encoder.emitTest(state.*.enc, target.Register.rax)
        const true_label = state_module.State.blockLabelName(state, instruction.arg1)
        encoder.emitJnzRel(state.*.enc, true_label.0, true_label.1)
        const false_label = state_module.State.blockLabelName(state, instruction.arg2)
        encoder.emitJmpRel(state.*.enc, false_label.0, false_label.1)
    }

    fn emitIntegerComparisonBranch(state: *state_module.State, instruction: lir_module.Inst) -> void {
        const comparison = lir_module.getInst(state.*.lir, instruction.arg0)
        encoder.emitMovRegMem(state.*.enc, target.Register.rax, state_module.State.allocateOp(state, comparison.arg1))
        encoder.emitCmpMem(state.*.enc, target.Register.rax, state_module.State.allocateOp(state, comparison.arg2))
        const true_label = state_module.State.blockLabelName(state, instruction.arg1)
        const predicate = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, comparison.arg0))
        encoder.emitJccRel(state.*.enc, Self.condition(predicate), true_label.0, true_label.1)
        const false_label = state_module.State.blockLabelName(state, instruction.arg2)
        encoder.emitJmpRel(state.*.enc, false_label.0, false_label.1)
    }

    fn condition(predicate: lir_module.CmpPredicate) -> encoder.Condition {
        match predicate {
            lir_module.CmpPredicate.eq => { return encoder.Condition.equal },
            lir_module.CmpPredicate.ne => { return encoder.Condition.not_equal },
            lir_module.CmpPredicate.lt => { return encoder.Condition.less },
            lir_module.CmpPredicate.le => { return encoder.Condition.less_equal },
            lir_module.CmpPredicate.gt => { return encoder.Condition.greater },
            lir_module.CmpPredicate.ge => { return encoder.Condition.greater_equal },
            lir_module.CmpPredicate.ult => { return encoder.Condition.below },
            lir_module.CmpPredicate.ule => { return encoder.Condition.below_equal },
            lir_module.CmpPredicate.ugt => { return encoder.Condition.above },
            lir_module.CmpPredicate.uge => { return encoder.Condition.above_equal },
            else => { return encoder.Condition.equal },
        }
        return encoder.Condition.equal
    }
}
