const allocator_module = @import("../../../../std/bootstrap/allocator.mlx")
const encoder = @import("./encoder.mlx")
const lir_module = @import("../../ir/lir.mlx")
const type_store = @import("../../sema/types/store.mlx")
const state_module = @import("./codegen/state.mlx")
const emitter = @import("./codegen/emitter.mlx")

pub const VregMap = state_module.VregMap
pub const ComponentMap = state_module.ComponentMap

// Public backend facade. The mutable implementation state and instruction
// families live in focused modules under codegen/.
pub const Codegen = struct {
    state: *state_module.State

    pub fn init(allocator: allocator_module.Allocator, target_encoder: *encoder.Encoder, lir: *lir_module.Lir, types: *type_store.Store) -> Self {
        const reserved = encoder.reserve(target_encoder, lir_module.instCount(lir) * 20 + 4096)
        return Self.{ .state = state_module.State.create(allocator, target_encoder, lir, types) }
    }

    pub fn deinit(codegen: *Self) -> void {
        state_module.State.destroy(codegen.*.state)
    }

    pub fn generateBinary(codegen: *Self) -> void {
        emitter.Emitter.generateBinary(codegen.*.state)
    }

    pub fn aggregateAllocationCount(codegen: *Self) -> usize { return codegen.*.state.*.aggregateAllocationCount }

    pub fn aggregateAllocationBytes(codegen: *Self) -> usize { return codegen.*.state.*.aggregateAllocationBytes }

    pub fn directCallCount(codegen: *Self) -> usize { return codegen.*.state.*.directCallCount }

    pub fn memoryOperandCount(codegen: *Self) -> usize { return encoder.memoryOperands(codegen.*.state.*.enc) }

    pub fn deferredSpillCount(codegen: *Self) -> usize { return codegen.*.state.*.deferredSpillCount }

    pub fn retainedRaxUseCount(codegen: *Self) -> usize { return codegen.*.state.*.retainedRaxUseCount }

    pub fn fallthroughBranchCount(codegen: *Self) -> usize { return codegen.*.state.*.fallthroughBranchCount }

}
