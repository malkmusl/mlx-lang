const allocator_module = @import("../../../../std/bootstrap/allocator.mlx")
const array_list = @import("../../../../std/bootstrap/array_list.mlx")
const vector = @import("../../../../std/bootstrap/vector.mlx")
const mem = @import("../../../../std/bootstrap/mem.mlx")
const target = @import("./target.mlx")

pub const Condition = enum(u8) {
    equal = 4,
    not_equal = 5,
    below = 2,
    above_equal = 3,
    below_equal = 6,
    above = 7,
    parity = 10,
    not_parity = 11,
    less = 12,
    greater_equal = 13,
    less_equal = 14,
    greater = 15
}

pub const FixupKind = enum(u8) { call_rel32, jmp_rel32, lea_rip_rel32 }

pub const Fixup = struct {
    kind: FixupKind
    patchOffset: usize
    targetPointer: [*]const u8
    targetLength: usize
    targetHash: usize
}

pub const SymbolEntry = struct {
    namePointer: [*]const u8
    nameLength: usize
    offset: usize
    nameHash: usize
}

pub const Encoder = struct {
    buf: *array_list.ArrayList
    symbols: *vector.Vector
    fixups: *vector.Vector
    symbolBuckets: [*]usize
    symbolIndexCapacity: usize
    fixupProbeCount: usize
    maxFixupProbeCount: usize
    forwardedLoadCount: usize
    cachedRaxLoadCount: usize
    memoryOperandCount: usize
    raxStackSlot: i32
    allocatorContext: usize
    allocFn: allocator_module.AllocFn
    resizeFn: allocator_module.ResizeFn
    freeFn: allocator_module.FreeFn
}

pub fn init(allocator: allocator_module.Allocator) -> Encoder {
    unsafe {
        const buf = @ptrCast(*array_list.ArrayList, allocator.allocFn(allocator.context, @sizeOf(array_list.ArrayList), @alignOf(array_list.ArrayList)).?)
        const symbols = @ptrCast(*vector.Vector, allocator.allocFn(allocator.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        const fixups = @ptrCast(*vector.Vector, allocator.allocFn(allocator.context, @sizeOf(vector.Vector), @alignOf(vector.Vector)).?)
        array_list.ArrayList.initAt(buf, allocator, 1024)
        vector.Vector.initAt(symbols, allocator, @sizeOf(SymbolEntry), @alignOf(SymbolEntry), 16)
        vector.Vector.initAt(fixups, allocator, @sizeOf(Fixup), @alignOf(Fixup), 16)
        const empty_buckets = @ptrFromInt([*]usize, 0)
        return Encoder.{
            .buf = buf,
            .symbols = symbols,
            .fixups = fixups,
            .symbolBuckets = empty_buckets,
            .symbolIndexCapacity = 0,
            .fixupProbeCount = 0,
            .maxFixupProbeCount = 0,
            .forwardedLoadCount = 0,
            .cachedRaxLoadCount = 0,
            .memoryOperandCount = 0,
            .raxStackSlot = 0,
            .allocatorContext = allocator.context,
            .allocFn = allocator.allocFn,
            .resizeFn = allocator.resizeFn,
            .freeFn = allocator.freeFn,
        }
    }
}

pub fn deinit(enc: *Encoder) -> void {
    releaseSymbolIndex(enc)
    array_list.ArrayList.deinit(enc.*.buf.*)
    vector.Vector.deinit(enc.*.symbols.*)
    vector.Vector.deinit(enc.*.fixups.*)
    unsafe {
        enc.*.freeFn(enc.*.allocatorContext, @ptrCast([*]u8, enc.*.buf), @sizeOf(array_list.ArrayList), @alignOf(array_list.ArrayList))
        enc.*.freeFn(enc.*.allocatorContext, @ptrCast([*]u8, enc.*.symbols), @sizeOf(vector.Vector), @alignOf(vector.Vector))
        enc.*.freeFn(enc.*.allocatorContext, @ptrCast([*]u8, enc.*.fixups), @sizeOf(vector.Vector), @alignOf(vector.Vector))
    }
}

pub fn pos(enc: *Encoder) -> usize {
    return enc.*.buf.*.length
}

fn ensureWritable(enc: *Encoder, additional: usize) -> bool {
    const buf = enc.*.buf
    const required = buf.*.length + additional
    if required <= buf.*.capacity { return true }
    var capacity = buf.*.capacity * 2
    while capacity < required { capacity *= 2 }
    const resized = buf.*.resizeFn(buf.*.allocatorContext, buf.*.items, buf.*.capacity, capacity, 1)
    if resized == null { return false }
    buf.*.items = resized.?
    buf.*.capacity = capacity
    return true
}

pub fn reserve(enc: *Encoder, minimum: usize) -> bool {
    if minimum <= enc.*.buf.*.capacity { return true }
    return ensureWritable(enc, minimum - enc.*.buf.*.length)
}

pub fn emit1(enc: *Encoder, b: u8) -> void {
    if !ensureWritable(enc, 1) { return }
    const length = enc.*.buf.*.length
    enc.*.buf.*.items[length] = b
    enc.*.buf.*.length = length + 1
}

pub fn emit2(enc: *Encoder, b0: u8, b1: u8) -> void {
    if !ensureWritable(enc, 2) { return }
    const length = enc.*.buf.*.length
    enc.*.buf.*.items[length] = b0
    enc.*.buf.*.items[length + 1] = b1
    enc.*.buf.*.length = length + 2
}

pub fn emit3(enc: *Encoder, b0: u8, b1: u8, b2: u8) -> void {
    if !ensureWritable(enc, 3) { return }
    const length = enc.*.buf.*.length
    enc.*.buf.*.items[length] = b0
    enc.*.buf.*.items[length + 1] = b1
    enc.*.buf.*.items[length + 2] = b2
    enc.*.buf.*.length = length + 3
}

pub fn emit4(enc: *Encoder, b0: u8, b1: u8, b2: u8, b3: u8) -> void {
    if !ensureWritable(enc, 4) { return }
    const length = enc.*.buf.*.length
    enc.*.buf.*.items[length] = b0
    enc.*.buf.*.items[length + 1] = b1
    enc.*.buf.*.items[length + 2] = b2
    enc.*.buf.*.items[length + 3] = b3
    enc.*.buf.*.length = length + 4
}

pub fn emitImm32(enc: *Encoder, value: i32) -> void {
    if !ensureWritable(enc, 4) { return }
    const u = @bitCast(u32, value)
    const length = enc.*.buf.*.length
    enc.*.buf.*.items[length] = @intCast(u8, u & 0xFF)
    enc.*.buf.*.items[length + 1] = @intCast(u8, (u >> 8) & 0xFF)
    enc.*.buf.*.items[length + 2] = @intCast(u8, (u >> 16) & 0xFF)
    enc.*.buf.*.items[length + 3] = @intCast(u8, (u >> 24) & 0xFF)
    enc.*.buf.*.length = length + 4
}

pub fn emitImm64(enc: *Encoder, value: i64) -> void {
    if !ensureWritable(enc, 8) { return }
    const u = @bitCast(u64, value)
    const length = enc.*.buf.*.length
    enc.*.buf.*.items[length] = @intCast(u8, u & 0xFF)
    enc.*.buf.*.items[length + 1] = @intCast(u8, (u >> 8) & 0xFF)
    enc.*.buf.*.items[length + 2] = @intCast(u8, (u >> 16) & 0xFF)
    enc.*.buf.*.items[length + 3] = @intCast(u8, (u >> 24) & 0xFF)
    enc.*.buf.*.items[length + 4] = @intCast(u8, (u >> 32) & 0xFF)
    enc.*.buf.*.items[length + 5] = @intCast(u8, (u >> 40) & 0xFF)
    enc.*.buf.*.items[length + 6] = @intCast(u8, (u >> 48) & 0xFF)
    enc.*.buf.*.items[length + 7] = @intCast(u8, (u >> 56) & 0xFF)
    enc.*.buf.*.length = length + 8
}

pub fn patch32(enc: *Encoder, offset: usize, value: i32) -> void {
    const u = @bitCast(u32, value)
    array_list.ArrayList.set(enc.*.buf.*, offset, @intCast(u8, u & 0xFF))
    array_list.ArrayList.set(enc.*.buf.*, offset + 1, @intCast(u8, (u >> 8) & 0xFF))
    array_list.ArrayList.set(enc.*.buf.*, offset + 2, @intCast(u8, (u >> 16) & 0xFF))
    array_list.ArrayList.set(enc.*.buf.*, offset + 3, @intCast(u8, (u >> 24) & 0xFF))
}

pub fn defineSymbol(enc: *Encoder, name_ptr: [*]const u8, name_len: usize) -> void {
    enc.*.raxStackSlot = 0
    const entry = SymbolEntry.{
        .namePointer = name_ptr,
        .nameLength = name_len,
        .offset = pos(enc),
        .nameHash = hashName(name_ptr, name_len),
    }
    unsafe {
        const appended = vector.Vector.appendAt(enc.*.symbols, @ptrCast([*]const u8, &entry))
    }
}

pub fn findSymbol(enc: *Encoder, name_ptr: [*]const u8, name_len: usize) -> (bool, usize) {
    const name_hash = hashName(name_ptr, name_len)
    if enc.*.symbolIndexCapacity != 0 {
        const indexed = findIndexedSymbol(enc, name_ptr, name_len, name_hash)
        return -> (indexed.0, indexed.1)
    }
    var i: usize = 0
    while i < enc.*.symbols.*.length {
        unsafe {
            const entry_ptr = @ptrCast(*SymbolEntry, vector.Vector.at(enc.*.symbols.*, i))
            if entry_ptr.*.nameHash == name_hash && entry_ptr.*.nameLength == name_len {
                if mem.eql(entry_ptr.*.namePointer, name_ptr, name_len) {
                    return -> (true, entry_ptr.*.offset)
                }
            }
        }
        i = i + 1
    }
    return -> (false, 0)
}

pub fn addFixup(enc: *Encoder, kind: FixupKind, target_ptr: [*]const u8, target_len: usize) -> void {
    const offset = pos(enc)
    const fixup = Fixup.{
        .kind = kind,
        .patchOffset = offset,
        .targetPointer = target_ptr,
        .targetLength = target_len,
        .targetHash = hashName(target_ptr, target_len),
    }
    unsafe {
        const appended = vector.Vector.appendAt(enc.*.fixups, @ptrCast([*]const u8, &fixup))
    }
    emitImm32(enc, 0)
}

pub fn applyFixups(enc: *Encoder) -> bool {
    if !buildSymbolIndex(enc) { return false }
    enc.*.fixupProbeCount = 0
    enc.*.maxFixupProbeCount = 0
    var i: usize = 0
    while i < enc.*.fixups.*.length {
        unsafe {
            const fixup_ptr = @ptrCast(*Fixup, vector.Vector.at(enc.*.fixups.*, i))
            const found = findIndexedSymbol(enc, fixup_ptr.*.targetPointer, fixup_ptr.*.targetLength, fixup_ptr.*.targetHash)
            enc.*.fixupProbeCount += found.2
            if found.2 > enc.*.maxFixupProbeCount { enc.*.maxFixupProbeCount = found.2 }
            if !found.0 {
                return false
            }
            const target_pos = found.1
            const after_fixup = fixup_ptr.*.patchOffset + 4
            const rel32 = @intCast(i32, @intCast(i64, target_pos) - @intCast(i64, after_fixup))
            patch32(enc, fixup_ptr.*.patchOffset, rel32)
        }
        i = i + 1
    }
    return true
}

fn hashName(pointer: [*]const u8, length: usize) -> usize {
    var result: usize = 14695981039346656037
    var index: usize = 0
    while index < length {
        result = (result ^ @intCast(usize, pointer[index])) *% 1099511628211
        index += 1
    }
    return result
}

fn buildSymbolIndex(enc: *Encoder) -> bool {
    if enc.*.symbolIndexCapacity != 0 { return true }
    var capacity: usize = 8
    while capacity < enc.*.symbols.*.length * 2 { capacity *= 2 }
    const memory = enc.*.allocFn(enc.*.allocatorContext, capacity * @sizeOf(usize), @alignOf(usize))
    if memory == null { return false }
    unsafe { enc.*.symbolBuckets = @ptrCast([*]usize, memory.?) }
    enc.*.symbolIndexCapacity = capacity
    var bucket: usize = 0
    while bucket < capacity {
        enc.*.symbolBuckets[bucket] = 0
        bucket += 1
    }
    var symbol_index: usize = 0
    while symbol_index < enc.*.symbols.*.length {
        if !insertSymbol(enc, symbol_index) { return false }
        symbol_index += 1
    }
    return true
}

fn insertSymbol(enc: *Encoder, symbol_index: usize) -> bool {
    unsafe {
        const entry = @ptrCast(*SymbolEntry, vector.Vector.at(enc.*.symbols.*, symbol_index))
        var bucket = entry.*.nameHash % enc.*.symbolIndexCapacity
        var probes: usize = 0
        while probes < enc.*.symbolIndexCapacity {
            const stored = enc.*.symbolBuckets[bucket]
            if stored == 0 {
                enc.*.symbolBuckets[bucket] = symbol_index + 1
                return true
            }
            const previous = @ptrCast(*SymbolEntry, vector.Vector.at(enc.*.symbols.*, stored - 1))
            if namesEqual(previous, entry.*.namePointer, entry.*.nameLength, entry.*.nameHash) { return true }
            bucket = (bucket + 1) % enc.*.symbolIndexCapacity
            probes += 1
        }
    }
    return false
}

fn findIndexedSymbol(enc: *Encoder, pointer: [*]const u8, length: usize, hash: usize) -> (bool, usize, usize) {
    var bucket = hash % enc.*.symbolIndexCapacity
    var probes: usize = 1
    while probes <= enc.*.symbolIndexCapacity {
        const stored = enc.*.symbolBuckets[bucket]
        if stored == 0 { return -> (false, 0, probes) }
        unsafe {
            const entry = @ptrCast(*SymbolEntry, vector.Vector.at(enc.*.symbols.*, stored - 1))
            if namesEqual(entry, pointer, length, hash) { return -> (true, entry.*.offset, probes) }
        }
        bucket = (bucket + 1) % enc.*.symbolIndexCapacity
        probes += 1
    }
    return -> (false, 0, probes)
}

fn namesEqual(entry: *SymbolEntry, pointer: [*]const u8, length: usize, hash: usize) -> bool {
    return entry.*.nameHash == hash && entry.*.nameLength == length && mem.eql(entry.*.namePointer, pointer, length)
}

fn releaseSymbolIndex(enc: *Encoder) -> void {
    if enc.*.symbolIndexCapacity == 0 { return }
    unsafe {
        enc.*.freeFn(enc.*.allocatorContext, @ptrCast([*]u8, enc.*.symbolBuckets), enc.*.symbolIndexCapacity * @sizeOf(usize), @alignOf(usize))
        enc.*.symbolBuckets = @ptrFromInt([*]usize, 0)
    }
    enc.*.symbolIndexCapacity = 0
}

pub fn symbolCount(enc: *Encoder) -> usize { return enc.*.symbols.*.length }

pub fn fixupCount(enc: *Encoder) -> usize { return enc.*.fixups.*.length }

pub fn fixupProbes(enc: *Encoder) -> usize { return enc.*.fixupProbeCount }

pub fn maxFixupProbes(enc: *Encoder) -> usize { return enc.*.maxFixupProbeCount }

pub fn forwardedLoads(enc: *Encoder) -> usize { return enc.*.forwardedLoadCount }

pub fn cachedRaxLoads(enc: *Encoder) -> usize { return enc.*.cachedRaxLoadCount }

pub fn memoryOperands(enc: *Encoder) -> usize { return enc.*.memoryOperandCount }

pub fn unresolvedFixupPointer(enc: *Encoder) -> [*]const u8 {
    var index: usize = 0
    while index < enc.*.fixups.*.length {
        unsafe {
            const fixup = @ptrCast(*Fixup, vector.Vector.at(enc.*.fixups.*, index))
            if !findSymbol(enc, fixup.*.targetPointer, fixup.*.targetLength).0 { return fixup.*.targetPointer }
        }
        index += 1
    }
    unsafe { return @ptrFromInt([*]const u8, 0) }
}

pub fn unresolvedFixupLength(enc: *Encoder) -> usize {
    var index: usize = 0
    while index < enc.*.fixups.*.length {
        unsafe {
            const fixup = @ptrCast(*Fixup, vector.Vector.at(enc.*.fixups.*, index))
            if !findSymbol(enc, fixup.*.targetPointer, fixup.*.targetLength).0 { return fixup.*.targetLength }
        }
        index += 1
    }
    return 0
}

pub fn emitMovRegImm64(enc: *Encoder, dst: target.Register, imm: i64) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    if imm == 0 {
        if target.needsRex(dst) {
            emit3(enc, target.encodeRex(false, true, false, true), 0x31, target.encodeModRm(3, target.lo3(dst), target.lo3(dst)))
        } else { emit2(enc, 0x31, target.encodeModRm(3, target.lo3(dst), target.lo3(dst))) }
        return
    }
    if imm >= 0 && imm <= 4294967295 {
        if target.needsRex(dst) { emit1(enc, target.encodeRex(false, false, false, true)) }
        emit1(enc, 0xB8 | target.lo3(dst))
        emitImm32(enc, @bitCast(i32, @intCast(u32, imm)))
        return
    }
    if imm >= -2147483648 && imm < 0 {
        emit3(enc, target.encodeRex(true, false, false, target.needsRex(dst)), 0xC7, target.encodeModRm(3, 0, target.lo3(dst)))
        emitImm32(enc, @intCast(i32, imm))
        return
    }
    emit2(enc, target.encodeRex(true, false, false, target.needsRex(dst)), 0xB8 | target.lo3(dst))
    emitImm64(enc, imm)
}

pub fn emitMovRegReg(enc: *Encoder, dst: target.Register, src: target.Register) -> void {
    if @intFromEnum(dst) == @intFromEnum(src) { return }
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit3(enc, target.encodeRex(true, target.needsRex(src), false, target.needsRex(dst)), 0x89, target.encodeModRm(3, target.lo3(src), target.lo3(dst)))
}

fn previousStoreRegister(enc: *Encoder, rbp_offset: i32) -> usize {
    const disp = 0 - rbp_offset
    const is_short = disp >= -128 && disp <= 127
    const size: usize = if is_short { 4 } else { 7 }
    const length = enc.*.buf.*.length
    if length < size { return 16 }
    const start = length - size
    const bytes = enc.*.buf.*.items
    if bytes[start + 1] != 0x89 { return 16 }
    const prefix = bytes[start]
    if prefix != 0x48 && prefix != 0x4C { return 16 }
    const mod: u8 = if is_short { 1 } else { 2 }
    if bytes[start + 2] & 0xC7 != target.encodeModRm(mod, 0, target.lo3(target.Register.rbp)) { return 16 }
    if is_short {
        if bytes[start + 3] != @bitCast(u8, @intCast(i8, disp)) { return 16 }
    } else {
        const value = @bitCast(u32, disp)
        if bytes[start + 3] != @intCast(u8, value & 0xFF) || bytes[start + 4] != @intCast(u8, (value >> 8) & 0xFF) { return 16 }
        if bytes[start + 5] != @intCast(u8, (value >> 16) & 0xFF) || bytes[start + 6] != @intCast(u8, (value >> 24) & 0xFF) { return 16 }
    }
    return @intCast(usize, (bytes[start + 2] >> 3) & 7) + if prefix == 0x4C { 8 } else { 0 }
}

pub fn emitMovRegMem(enc: *Encoder, dst: target.Register, rbp_offset: i32) -> void {
    if dst == target.Register.rax && enc.*.raxStackSlot == rbp_offset {
        enc.*.cachedRaxLoadCount += 1
        return
    }
    const previous = previousStoreRegister(enc, rbp_offset)
    if previous < 16 {
        enc.*.forwardedLoadCount += 1
        emitMovRegReg(enc, dst, @enumFromInt(target.Register, @intCast(u8, previous)))
        if dst == target.Register.rax { enc.*.raxStackSlot = rbp_offset }
        return
    }
    const disp = 0 - rbp_offset
    const is_short = disp >= -128 && disp <= 127
    const mod: u8 = if is_short { 1 } else { 2 }
    if is_short {
        emit4(enc, target.encodeRex(true, target.needsRex(dst), false, false), 0x8B, target.encodeModRm(mod, target.lo3(dst), target.lo3(target.Register.rbp)), @bitCast(u8, @intCast(i8, disp)))
    } else {
        emit3(enc, target.encodeRex(true, target.needsRex(dst), false, false), 0x8B, target.encodeModRm(mod, target.lo3(dst), target.lo3(target.Register.rbp)))
        emitImm32(enc, disp)
    }
    if dst == target.Register.rax { enc.*.raxStackSlot = rbp_offset }
}

pub fn emitMovMemReg(enc: *Encoder, rbp_offset: i32, src: target.Register) -> void {
    const disp = 0 - rbp_offset
    const is_short = disp >= -128 && disp <= 127
    const mod: u8 = if is_short { 1 } else { 2 }
    if is_short {
        emit4(enc, target.encodeRex(true, target.needsRex(src), false, false), 0x89, target.encodeModRm(mod, target.lo3(src), target.lo3(target.Register.rbp)), @bitCast(u8, @intCast(i8, disp)))
    } else {
        emit3(enc, target.encodeRex(true, target.needsRex(src), false, false), 0x89, target.encodeModRm(mod, target.lo3(src), target.lo3(target.Register.rbp)))
        emitImm32(enc, disp)
    }
    if enc.*.raxStackSlot == rbp_offset && src != target.Register.rax { enc.*.raxStackSlot = 0 }
    if src == target.Register.rax { enc.*.raxStackSlot = rbp_offset }
}

pub fn emitMovXmmGp(enc: *Encoder, xmm: usize, src: target.Register, bits: usize) -> void {
    emit1(enc, 0x66)
    if bits == 64 || xmm >= 8 || target.needsRex(src) {
        emit1(enc, target.encodeRex(bits == 64, xmm >= 8, false, target.needsRex(src)))
    }
    emit2(enc, 0x0F, 0x6E)
    emit1(enc, target.encodeModRm(3, @intCast(u8, xmm & 7), target.lo3(src)))
}

pub fn emitMovGpXmm(enc: *Encoder, dst: target.Register, xmm: usize, bits: usize) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit1(enc, 0x66)
    if bits == 64 || xmm >= 8 || target.needsRex(dst) {
        emit1(enc, target.encodeRex(bits == 64, xmm >= 8, false, target.needsRex(dst)))
    }
    emit2(enc, 0x0F, 0x7E)
    emit1(enc, target.encodeModRm(3, @intCast(u8, xmm & 7), target.lo3(dst)))
}

pub fn emitMovXmmMem(enc: *Encoder, xmm: usize, rbp_offset: i32, bits: usize) -> void {
    emit1(enc, if bits == 32 { 0xF3 } else { 0xF2 })
    if xmm >= 8 { emit1(enc, target.encodeRex(false, true, false, false)) }
    const disp = 0 - rbp_offset
    const is_short = disp >= -128 && disp <= 127
    const mod: u8 = if is_short { 1 } else { 2 }
    emit2(enc, 0x0F, 0x10)
    emit1(enc, target.encodeModRm(mod, @intCast(u8, xmm & 7), target.lo3(target.Register.rbp)))
    if is_short { emit1(enc, @bitCast(u8, @intCast(i8, disp))) } else { emitImm32(enc, disp) }
}

pub fn emitMovMemXmm(enc: *Encoder, rbp_offset: i32, xmm: usize, bits: usize) -> void {
    if enc.*.raxStackSlot == rbp_offset { enc.*.raxStackSlot = 0 }
    emit1(enc, if bits == 32 { 0xF3 } else { 0xF2 })
    if xmm >= 8 { emit1(enc, target.encodeRex(false, true, false, false)) }
    const disp = 0 - rbp_offset
    const is_short = disp >= -128 && disp <= 127
    const mod: u8 = if is_short { 1 } else { 2 }
    emit2(enc, 0x0F, 0x11)
    emit1(enc, target.encodeModRm(mod, @intCast(u8, xmm & 7), target.lo3(target.Register.rbp)))
    if is_short { emit1(enc, @bitCast(u8, @intCast(i8, disp))) } else { emitImm32(enc, disp) }
}

pub fn emitFloatBinary(enc: *Encoder, opcode: u8, dst_xmm: usize, src_xmm: usize, bits: usize) -> void {
    emit1(enc, if bits == 32 { 0xF3 } else { 0xF2 })
    if dst_xmm >= 8 || src_xmm >= 8 { emit1(enc, target.encodeRex(false, dst_xmm >= 8, false, src_xmm >= 8)) }
    emit2(enc, 0x0F, opcode)
    emit1(enc, target.encodeModRm(3, @intCast(u8, dst_xmm & 7), @intCast(u8, src_xmm & 7)))
}

pub fn emitFloatCompare(enc: *Encoder, lhs_xmm: usize, rhs_xmm: usize, bits: usize) -> void {
    if bits == 64 { emit1(enc, 0x66) }
    if lhs_xmm >= 8 || rhs_xmm >= 8 { emit1(enc, target.encodeRex(false, lhs_xmm >= 8, false, rhs_xmm >= 8)) }
    emit2(enc, 0x0F, 0x2E)
    emit1(enc, target.encodeModRm(3, @intCast(u8, lhs_xmm & 7), @intCast(u8, rhs_xmm & 7)))
}

pub fn emitIntToFloat(enc: *Encoder, dst_xmm: usize, src: target.Register, float_bits: usize) -> void {
    emit1(enc, if float_bits == 32 { 0xF3 } else { 0xF2 })
    emit1(enc, target.encodeRex(true, dst_xmm >= 8, false, target.needsRex(src)))
    emit2(enc, 0x0F, 0x2A)
    emit1(enc, target.encodeModRm(3, @intCast(u8, dst_xmm & 7), target.lo3(src)))
}

pub fn emitFloatToInt(enc: *Encoder, dst: target.Register, src_xmm: usize, float_bits: usize) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit1(enc, if float_bits == 32 { 0xF3 } else { 0xF2 })
    emit1(enc, target.encodeRex(true, target.needsRex(dst), false, src_xmm >= 8))
    emit2(enc, 0x0F, 0x2C)
    emit1(enc, target.encodeModRm(3, target.lo3(dst), @intCast(u8, src_xmm & 7)))
}

pub fn emitFloatConvert(enc: *Encoder, dst_xmm: usize, src_xmm: usize, source_bits: usize) -> void {
    emit1(enc, if source_bits == 32 { 0xF3 } else { 0xF2 })
    if dst_xmm >= 8 || src_xmm >= 8 { emit1(enc, target.encodeRex(false, dst_xmm >= 8, false, src_xmm >= 8)) }
    emit2(enc, 0x0F, 0x5A)
    emit1(enc, target.encodeModRm(3, @intCast(u8, dst_xmm & 7), @intCast(u8, src_xmm & 7)))
}

pub fn emitLoadPointer(enc: *Encoder, dst: target.Register, pointer: target.Register, width: usize) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    if width == 1 || width == 2 {
        emit4(enc, target.encodeRex(true, target.needsRex(dst), false, target.needsRex(pointer)), 0x0F, if width == 1 { 0xB6 } else { 0xB7 }, target.encodeModRm(0, target.lo3(dst), target.lo3(pointer)))
        return
    }
    emit3(enc, target.encodeRex(width >= 8, target.needsRex(dst), false, target.needsRex(pointer)), 0x8B, target.encodeModRm(0, target.lo3(dst), target.lo3(pointer)))
}

pub fn emitLoadPointerSigned(enc: *Encoder, dst: target.Register, pointer: target.Register, width: usize) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    if width == 1 || width == 2 {
        emit4(enc, target.encodeRex(true, target.needsRex(dst), false, target.needsRex(pointer)), 0x0F, if width == 1 { 0xBE } else { 0xBF }, target.encodeModRm(0, target.lo3(dst), target.lo3(pointer)))
        return
    }
    if width == 4 {
        emit3(enc, target.encodeRex(true, target.needsRex(dst), false, target.needsRex(pointer)), 0x63, target.encodeModRm(0, target.lo3(dst), target.lo3(pointer)))
        return
    }
    emitLoadPointer(enc, dst, pointer, width)
}

pub fn emitStorePointer(enc: *Encoder, pointer: target.Register, src: target.Register, width: usize) -> void {
    enc.*.raxStackSlot = 0
    const rex = target.encodeRex(width >= 8, target.needsRex(src), false, target.needsRex(pointer))
    const opcode: u8 = if width == 1 { 0x88 } else { 0x89 }
    const mod_rm = target.encodeModRm(0, target.lo3(src), target.lo3(pointer))
    if width == 2 { emit4(enc, 0x66, rex, opcode, mod_rm) } else { emit3(enc, rex, opcode, mod_rm) }
}

pub fn emitLeaRegMem(enc: *Encoder, dst: target.Register, rbp_offset: i32) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    const disp = 0 - rbp_offset
    const is_short = disp >= -128 && disp <= 127
    const mod: u8 = if is_short { 1 } else { 2 }
    if is_short {
        emit4(enc, target.encodeRex(true, target.needsRex(dst), false, false), 0x8D, target.encodeModRm(mod, target.lo3(dst), target.lo3(target.Register.rbp)), @bitCast(u8, @intCast(i8, disp)))
    } else {
        emit3(enc, target.encodeRex(true, target.needsRex(dst), false, false), 0x8D, target.encodeModRm(mod, target.lo3(dst), target.lo3(target.Register.rbp)))
        emitImm32(enc, disp)
    }
}

pub fn emitLeaRipRel(enc: *Encoder, dst: target.Register, target_ptr: [*]const u8, target_len: usize) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit3(enc, target.encodeRex(true, target.needsRex(dst), false, false), 0x8D, target.encodeModRm(0, target.lo3(dst), 5))
    addFixup(enc, FixupKind.lea_rip_rel32, target_ptr, target_len)
}

pub fn emitAdd(enc: *Encoder, dst: target.Register, src: target.Register) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit3(enc, target.encodeRex(true, target.needsRex(src), false, target.needsRex(dst)), 0x01, target.encodeModRm(3, target.lo3(src), target.lo3(dst)))
}

pub fn emitAluImm(enc: *Encoder, dst: target.Register, imm: i32, extension: u8, accumulator_opcode: u8) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    const rex = target.encodeRex(true, false, false, target.needsRex(dst))
    if imm >= -128 && imm <= 127 {
        emit4(enc, rex, 0x83, target.encodeModRm(3, extension, target.lo3(dst)), @bitCast(u8, @intCast(i8, imm)))
        return
    }
    if dst == target.Register.rax {
        emit2(enc, rex, accumulator_opcode)
    } else { emit3(enc, rex, 0x81, target.encodeModRm(3, extension, target.lo3(dst))) }
    emitImm32(enc, imm)
}

fn emitRbpRegOperand(enc: *Encoder, dst: target.Register, rbp_offset: i32, opcode: u8, extended: bool, clobbers_dst: bool) -> void {
    if clobbers_dst && dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    enc.*.memoryOperandCount += 1
    const disp = 0 - rbp_offset
    const is_short = disp >= -128 && disp <= 127
    const mod: u8 = if is_short { 1 } else { 2 }
    emit1(enc, target.encodeRex(true, target.needsRex(dst), false, false))
    if extended { emit1(enc, 0x0F) }
    emit2(enc, opcode, target.encodeModRm(mod, target.lo3(dst), target.lo3(target.Register.rbp)))
    if is_short { emit1(enc, @bitCast(u8, @intCast(i8, disp))) } else { emitImm32(enc, disp) }
}

pub fn emitAddMem(enc: *Encoder, dst: target.Register, rbp_offset: i32) -> void {
    emitRbpRegOperand(enc, dst, rbp_offset, 0x03, false, true)
}

pub fn emitSub(enc: *Encoder, dst: target.Register, src: target.Register) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit3(enc, target.encodeRex(true, target.needsRex(src), false, target.needsRex(dst)), 0x29, target.encodeModRm(3, target.lo3(src), target.lo3(dst)))
}

pub fn emitSubMem(enc: *Encoder, dst: target.Register, rbp_offset: i32) -> void {
    emitRbpRegOperand(enc, dst, rbp_offset, 0x2B, false, true)
}

pub fn emitIMul(enc: *Encoder, dst: target.Register, src: target.Register) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit4(enc, target.encodeRex(true, target.needsRex(dst), false, target.needsRex(src)), 0x0F, 0xAF, target.encodeModRm(3, target.lo3(dst), target.lo3(src)))
}

pub fn emitIMulImm(enc: *Encoder, dst: target.Register, src: target.Register, imm: i32) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    const rex = target.encodeRex(true, target.needsRex(dst), false, target.needsRex(src))
    if imm >= -128 && imm <= 127 {
        emit4(enc, rex, 0x6B, target.encodeModRm(3, target.lo3(dst), target.lo3(src)), @bitCast(u8, @intCast(i8, imm)))
        return
    }
    emit3(enc, rex, 0x69, target.encodeModRm(3, target.lo3(dst), target.lo3(src)))
    emitImm32(enc, imm)
}

pub fn emitIMulMem(enc: *Encoder, dst: target.Register, rbp_offset: i32) -> void {
    emitRbpRegOperand(enc, dst, rbp_offset, 0xAF, true, true)
}

pub fn emitPopCount(enc: *Encoder, dst: target.Register, src: target.Register) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit1(enc, 0xF3)
    emit1(enc, target.encodeRex(true, target.needsRex(dst), false, target.needsRex(src)))
    emit2(enc, 0x0F, 0xB8)
    emit1(enc, target.encodeModRm(3, target.lo3(dst), target.lo3(src)))
}

pub fn emitByteMask64(enc: *Encoder) -> void {
    enc.*.raxStackSlot = 0
    emit1(enc, 0xF3)
    emit3(enc, 0x0F, 0x6F, 0x00)
    emit1(enc, 0xF3)
    emit4(enc, 0x0F, 0x6F, 0x50, 0x10)
    emit1(enc, 0xF3)
    emit4(enc, 0x0F, 0x6F, 0x58, 0x20)
    emit1(enc, 0xF3)
    emit4(enc, 0x0F, 0x6F, 0x60, 0x30)
    emitMovXmmGp(enc, 1, target.Register.rcx, 32)
    emit1(enc, 0x66)
    emit3(enc, 0x0F, 0x60, 0xC9)
    emit1(enc, 0xF2)
    emit3(enc, 0x0F, 0x70, 0xC9)
    emit1(enc, 0)
    emit1(enc, 0x66)
    emit3(enc, 0x0F, 0x6C, 0xC9)
    emit1(enc, 0x66)
    emit3(enc, 0x0F, 0x74, 0xC1)
    emit1(enc, 0x66)
    emit3(enc, 0x0F, 0x74, 0xD1)
    emit1(enc, 0x66)
    emit3(enc, 0x0F, 0x74, 0xD9)
    emit1(enc, 0x66)
    emit3(enc, 0x0F, 0x74, 0xE1)
    emit1(enc, 0x66)
    emit3(enc, 0x0F, 0xD7, 0xC0)
    emit1(enc, 0x66)
    emit3(enc, 0x0F, 0xD7, 0xD2)
    emit1(enc, 0x66)
    emit4(enc, 0x44, 0x0F, 0xD7, 0xC3)
    emit1(enc, 0x66)
    emit4(enc, 0x44, 0x0F, 0xD7, 0xCC)
    emit4(enc, 0x48, 0xC1, 0xE2, 0x10)
    emit4(enc, 0x49, 0xC1, 0xE0, 0x20)
    emit4(enc, 0x49, 0xC1, 0xE1, 0x30)
    emitOr(enc, target.Register.rax, target.Register.rdx)
    emitOr(enc, target.Register.rax, target.Register.r8)
    emitOr(enc, target.Register.rax, target.Register.r9)
}

pub fn emitAnd(enc: *Encoder, dst: target.Register, src: target.Register) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit3(enc, target.encodeRex(true, target.needsRex(src), false, target.needsRex(dst)), 0x21, target.encodeModRm(3, target.lo3(src), target.lo3(dst)))
}

pub fn emitAndMem(enc: *Encoder, dst: target.Register, rbp_offset: i32) -> void {
    emitRbpRegOperand(enc, dst, rbp_offset, 0x23, false, true)
}

pub fn emitOr(enc: *Encoder, dst: target.Register, src: target.Register) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit3(enc, target.encodeRex(true, target.needsRex(src), false, target.needsRex(dst)), 0x09, target.encodeModRm(3, target.lo3(src), target.lo3(dst)))
}

pub fn emitOrMem(enc: *Encoder, dst: target.Register, rbp_offset: i32) -> void {
    emitRbpRegOperand(enc, dst, rbp_offset, 0x0B, false, true)
}

pub fn emitXor(enc: *Encoder, dst: target.Register, src: target.Register) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit3(enc, target.encodeRex(true, target.needsRex(src), false, target.needsRex(dst)), 0x31, target.encodeModRm(3, target.lo3(src), target.lo3(dst)))
}

pub fn emitXorMem(enc: *Encoder, dst: target.Register, rbp_offset: i32) -> void {
    emitRbpRegOperand(enc, dst, rbp_offset, 0x33, false, true)
}

pub fn emitAtomicXaddPointer(enc: *Encoder, pointer: target.Register, value: target.Register) -> void {
    if value == target.Register.rax { enc.*.raxStackSlot = 0 }
    emit1(enc, 0xF0)
    emit1(enc, target.encodeRex(true, target.needsRex(value), false, target.needsRex(pointer)))
    emit2(enc, 0x0F, 0xC1)
    emit1(enc, target.encodeModRm(0, target.lo3(value), target.lo3(pointer)))
}

pub fn emitShiftCl(enc: *Encoder, dst: target.Register, left: bool, arithmetic_right: bool) -> void {
    if dst == target.Register.rax { enc.*.raxStackSlot = 0 }
    const extension: u8 = if left { 4 } else { if arithmetic_right { 7 } else { 5 } }
    emit3(enc, target.encodeRex(true, false, false, target.needsRex(dst)), 0xD3, target.encodeModRm(3, extension, target.lo3(dst)))
}

pub fn emitCqo(enc: *Encoder) -> void {
    emit2(enc, 0x48, 0x99)
}

pub fn emitDivide(enc: *Encoder, divisor: target.Register, signed: bool) -> void {
    enc.*.raxStackSlot = 0
    emit3(enc, target.encodeRex(true, false, false, target.needsRex(divisor)), 0xF7, target.encodeModRm(3, if signed { 7 } else { 6 }, target.lo3(divisor)))
}

pub fn emitSubRspImm32(enc: *Encoder, imm: u32) -> void {
    if imm <= 127 {
        emit4(enc, target.encodeRex(true, false, false, false), 0x83, 0xEC, @intCast(u8, imm))
        return
    }
    emit3(enc, target.encodeRex(true, false, false, false), 0x81, 0xEC)
    emitImm32(enc, @bitCast(i32, imm))
}

pub fn emitAddRspImm32(enc: *Encoder, imm: u32) -> void {
    if imm <= 127 {
        emit4(enc, target.encodeRex(true, false, false, false), 0x83, 0xC4, @intCast(u8, imm))
        return
    }
    emit3(enc, target.encodeRex(true, false, false, false), 0x81, 0xC4)
    emitImm32(enc, @bitCast(i32, imm))
}

pub fn emitCmp(enc: *Encoder, lhs: target.Register, rhs: target.Register) -> void {
    emit3(enc, target.encodeRex(true, target.needsRex(rhs), false, target.needsRex(lhs)), 0x39, target.encodeModRm(3, target.lo3(rhs), target.lo3(lhs)))
}

pub fn emitCmpMem(enc: *Encoder, lhs: target.Register, rbp_offset: i32) -> void {
    emitRbpRegOperand(enc, lhs, rbp_offset, 0x3B, false, false)
}

pub fn emitTest(enc: *Encoder, reg: target.Register) -> void {
    emit3(enc, target.encodeRex(true, target.needsRex(reg), false, target.needsRex(reg)), 0x85, target.encodeModRm(3, target.lo3(reg), target.lo3(reg)))
}

pub fn emitSetcc(enc: *Encoder, dst: target.Register, condition: Condition) -> void {
    const byte_register_needs_rex = target.needsRex(dst) || target.lo3(dst) >= 4
    if byte_register_needs_rex { emit1(enc, target.encodeRex(false, false, false, target.needsRex(dst))) }
    emit3(enc, 0x0F, @intCast(u8, 0x90 + @intFromEnum(condition)), target.encodeModRm(3, 0, target.lo3(dst)))
    if byte_register_needs_rex {
        emit1(enc, target.encodeRex(false, target.needsRex(dst), false, target.needsRex(dst)))
    }
    emit3(enc, 0x0F, 0xB6, target.encodeModRm(3, target.lo3(dst), target.lo3(dst)))
}

pub fn emitJmpRel(enc: *Encoder, target_ptr: [*]const u8, target_len: usize) -> void {
    emit1(enc, 0xE9)
    addFixup(enc, FixupKind.jmp_rel32, target_ptr, target_len)
}

pub fn emitJnzRel(enc: *Encoder, target_ptr: [*]const u8, target_len: usize) -> void {
    emit2(enc, 0x0F, 0x85)
    addFixup(enc, FixupKind.jmp_rel32, target_ptr, target_len)
}

pub fn emitJzRel(enc: *Encoder, target_ptr: [*]const u8, target_len: usize) -> void {
    emit2(enc, 0x0F, 0x84)
    addFixup(enc, FixupKind.jmp_rel32, target_ptr, target_len)
}

pub fn emitJccRel(enc: *Encoder, condition: Condition, target_ptr: [*]const u8, target_len: usize) -> void {
    emit2(enc, 0x0F, @intCast(u8, 0x80 + @intFromEnum(condition)))
    addFixup(enc, FixupKind.jmp_rel32, target_ptr, target_len)
}

pub fn emitCallRel(enc: *Encoder, target_ptr: [*]const u8, target_len: usize) -> void {
    emit1(enc, 0xE8)
    addFixup(enc, FixupKind.call_rel32, target_ptr, target_len)
    enc.*.raxStackSlot = 0
}

pub fn emitCallReg(enc: *Encoder, reg: target.Register) -> void {
    if target.needsRex(reg) {
        emit3(enc, target.encodeRex(false, false, false, true), 0xFF, target.encodeModRm(3, 2, target.lo3(reg)))
    } else {
        emit2(enc, 0xFF, target.encodeModRm(3, 2, target.lo3(reg)))
    }
    enc.*.raxStackSlot = 0
}

pub fn emitRet(enc: *Encoder) -> void {
    emit1(enc, 0xC3)
}

pub fn emitPushRbp(enc: *Encoder) -> void {
    emit1(enc, 0x55)
}

pub fn emitPushReg(enc: *Encoder, reg: target.Register) -> void {
    if target.needsRex(reg) {
        emit2(enc, target.encodeRex(false, false, false, true), 0x50 | target.lo3(reg))
    } else {
        emit1(enc, 0x50 | target.lo3(reg))
    }
}

pub fn emitMovRbpRsp(enc: *Encoder) -> void {
    emit3(enc, target.encodeRex(true, false, false, false), 0x89, 0xE5)
}

pub fn emitLeave(enc: *Encoder) -> void {
    emit1(enc, 0xC9)
}

pub fn emitSyscall(enc: *Encoder) -> void {
    emit2(enc, 0x0F, 0x05)
    enc.*.raxStackSlot = 0
}

pub fn emitTrap(enc: *Encoder) -> void {
    emit2(enc, 0x0F, 0x0B)
}
