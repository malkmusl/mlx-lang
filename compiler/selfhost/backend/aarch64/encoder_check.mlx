// Prints "<hex word> <assembly>" for a spread of encoder.mlx instruction
// words. tools/check_aarch64_encoder.py assembles every line with llvm-mc
// and fails on any mismatch, so each encoding here has an independent
// ground truth. Register numbers vary per case so a field landing in the
// wrong bits cannot hide behind a zero.
const io = @import("../../../../std/bootstrap/io.mlx")
const a = @import("./encoder.mlx")

fn c(word: u32, text: []const u8) -> void {
    const hex = io.writeHex(io.stdout(), @intCast(usize, word))
    const space = io.print(" ")
    const line = io.println(text)
}

pub fn main() -> u8 {
    c(a.movz(3, 0x1234, 0), "movz x3, #0x1234")
    c(a.movz(3, 0x1234, 16), "movz x3, #0x1234, lsl #16")
    c(a.movk(5, 0xBEEF, 48), "movk x5, #0xbeef, lsl #48")
    c(a.movk(9, 0x7, 32), "movk x9, #0x7, lsl #32")
    c(a.movn(7, 5, 0), "movn x7, #5")
    c(a.movReg(1, 2), "mov x1, x2")
    c(a.addImm(1, 2, 4095), "add x1, x2, #4095")
    c(a.addImm(0, a.SP, 0), "add x0, sp, #0")
    c(a.addImm(a.SP, a.SP, 32), "add sp, sp, #32")
    c(a.subImm(3, 4, 1), "sub x3, x4, #1")
    c(a.subImm(a.SP, a.SP, 272), "sub sp, sp, #272")
    c(a.subImm(17, a.FP, 264), "sub x17, x29, #264")
    c(a.subImmShifted(5, 6, 1), "sub x5, x6, #1, lsl #12")
    c(a.addReg(1, 2, 3), "add x1, x2, x3")
    c(a.addReg(0, a.FP, 17), "add x0, x29, x17")
    c(a.subReg(4, 5, 6), "sub x4, x5, x6")
    c(a.mul(7, 8, 9), "mul x7, x8, x9")
    c(a.msub(1, 2, 3, 4), "msub x1, x2, x3, x4")
    c(a.sdiv(5, 6, 7), "sdiv x5, x6, x7")
    c(a.udiv(8, 9, 10), "udiv x8, x9, x10")
    c(a.andReg(1, 2, 3), "and x1, x2, x3")
    c(a.orrReg(4, 5, 6), "orr x4, x5, x6")
    c(a.eorReg(7, 8, 9), "eor x7, x8, x9")
    c(a.lslv(1, 2, 3), "lsl x1, x2, x3")
    c(a.lsrv(4, 5, 6), "lsr x4, x5, x6")
    c(a.asrv(7, 8, 9), "asr x7, x8, x9")
    c(a.lslImm(1, 2, 2), "lsl x1, x2, #2")
    c(a.lslImm(3, 4, 63), "lsl x3, x4, #63")
    c(a.lsrImm(3, 4, 14), "lsr x3, x4, #14")
    c(a.lsrImm(5, 6, 1), "lsr x5, x6, #1")
    c(a.cmpReg(1, 2), "cmp x1, x2")
    c(a.cmpImm(3, 4095), "cmp x3, #4095")
    c(a.cmpImm(8, 435), "cmp x8, #435")
    c(a.cmpRegW(4, 5), "cmp w4, w5")
    c(a.cset(0, a.COND_EQ), "cset x0, eq")
    c(a.cset(1, a.COND_NE), "cset x1, ne")
    c(a.cset(2, a.COND_LT), "cset x2, lt")
    c(a.cset(3, a.COND_LE), "cset x3, le")
    c(a.cset(4, a.COND_GT), "cset x4, gt")
    c(a.cset(5, a.COND_GE), "cset x5, ge")
    c(a.cset(6, a.COND_LO), "cset x6, lo")
    c(a.cset(7, a.COND_LS), "cset x7, ls")
    c(a.cset(8, a.COND_HI), "cset x8, hi")
    c(a.cset(9, a.COND_HS), "cset x9, hs")
    c(a.cset(10, a.COND_MI), "cset x10, mi")
    c(a.uxtb(3, 4), "uxtb w3, w4")
    c(a.ldrX(1, 2, 8), "ldr x1, [x2, #8]")
    c(a.strX(3, 4, 32760), "str x3, [x4, #32760]")
    c(a.strX(16, a.SP, 24), "str x16, [sp, #24]")
    c(a.ldrW(5, 6, 4), "ldr w5, [x6, #4]")
    c(a.strW(7, 8, 16), "str w7, [x8, #16]")
    c(a.ldrH(1, 2), "ldrh w1, [x2]")
    c(a.strH(3, 4), "strh w3, [x4]")
    c(a.ldrB(5, 6), "ldrb w5, [x6]")
    c(a.strB(7, 8), "strb w7, [x8]")
    c(a.ldrsw(1, 2), "ldrsw x1, [x2]")
    c(a.ldrsh(3, 4), "ldrsh x3, [x4]")
    c(a.ldrsb(5, 6), "ldrsb x5, [x6]")
    c(a.ldrbReg(1, 2, 3), "ldrb w1, [x2, x3]")
    c(a.ldrhReg(8, 16, 8), "ldrh w8, [x16, x8, lsl #1]")
    c(a.ldurX(1, a.FP, -8), "ldur x1, [x29, #-8]")
    c(a.sturX(2, a.FP, -256), "stur x2, [x29, #-256]")
    c(a.ldurX(3, 4, 255), "ldur x3, [x4, #255]")
    c(a.ldurD(3, a.FP, -16), "ldur d3, [x29, #-16]")
    c(a.sturD(4, a.FP, -24), "stur d4, [x29, #-24]")
    c(a.ldurS(5, a.FP, -32), "ldur s5, [x29, #-32]")
    c(a.sturS(6, a.FP, -40), "stur s6, [x29, #-40]")
    c(a.ldrD(1, 2), "ldr d1, [x2]")
    c(a.strD(3, 4), "str d3, [x4]")
    c(a.ldrS(5, 6), "ldr s5, [x6]")
    c(a.strS(7, 8), "str s7, [x8]")
    c(a.STP_FP_LR_PRE, "stp x29, x30, [sp, #-16]!")
    c(a.LDP_FP_LR_POST, "ldp x29, x30, [sp], #16")
    c(a.MOV_FP_SP, "mov x29, sp")
    c(a.MOV_SP_FP, "mov sp, x29")
    c(a.SUB_SP_SP_X16, "sub sp, sp, x16")
    c(a.ADD_SP_SP_X16, "add sp, sp, x16")
    c(a.RET, "ret")
    c(a.SVC0, "svc #0")
    c(a.BRK0, "brk #0")
    c(a.blr(16), "blr x16")
    c(a.br(16), "br x16")
    c(a.cbzX(1, 8), "cbz x1, #8")
    c(a.cbnzX(2, -8), "cbnz x2, #-8")
    c(a.cbnzW(3, 12), "cbnz w3, #12")
    c(a.bCond(a.COND_EQ, 8), "b.eq #8")
    c(a.bCond(a.COND_NE, -4), "b.ne #-4")
    c(a.bCond(a.COND_LO, 1048572), "b.lo #1048572")
    c(a.b(8), "b #8")
    c(a.b(-8), "b #-8")
    c(a.tbz(1, 33, 8), "tbz x1, #33, #8")
    c(a.tbnz(2, 31, -4), "tbnz w2, #31, #-4")
    c(a.tbnz(9, 0, 16), "tbnz w9, #0, #16")
    c(a.fadd(0, 1, 2, 64), "fadd d0, d1, d2")
    c(a.fadd(3, 4, 5, 32), "fadd s3, s4, s5")
    c(a.fsub(6, 7, 1, 64), "fsub d6, d7, d1")
    c(a.fsub(2, 3, 4, 32), "fsub s2, s3, s4")
    c(a.fmul(5, 6, 7, 64), "fmul d5, d6, d7")
    c(a.fmul(1, 2, 3, 32), "fmul s1, s2, s3")
    c(a.fdiv(4, 5, 6, 64), "fdiv d4, d5, d6")
    c(a.fdiv(7, 1, 2, 32), "fdiv s7, s1, s2")
    c(a.fcmp(0, 1, 64), "fcmp d0, d1")
    c(a.fcmp(2, 3, 32), "fcmp s2, s3")
    c(a.fcvt(0, 1, 32), "fcvt d0, s1")
    c(a.fcvt(2, 3, 64), "fcvt s2, d3")
    c(a.scvtf(0, 1, 64), "scvtf d0, x1")
    c(a.scvtf(2, 3, 32), "scvtf s2, x3")
    c(a.fcvtzs(0, 1, 64), "fcvtzs x0, d1")
    c(a.fcvtzs(2, 3, 32), "fcvtzs x2, s3")
    c(a.fmovToFp(0, 1), "fmov d0, x1")
    c(a.fmovFromFp(2, 3), "fmov x2, d3")
    c(a.cnt8b(0, 1), "cnt v0.8b, v1.8b")
    c(a.addv8b(2, 3), "addv b2, v3.8b")
    c(a.umovB0(4, 5), "umov w4, v5.b[0]")
    c(a.ldxr(1, 2), "ldxr x1, [x2]")
    c(a.stxr(3, 4, 5), "stxr w3, x4, [x5]")
    c(a.ldar(6, 7), "ldar x6, [x7]")
    c(a.stlxr(8, 9, 10), "stlxr w8, x9, [x10]")
    c(a.adrp(16), "adrp x16, #0")
    return 0
}
