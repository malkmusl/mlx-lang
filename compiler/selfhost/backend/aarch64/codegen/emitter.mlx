const encoder = @import("../encoder.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")
const labels = @import("./labels.mlx")
const memory = @import("./memory.mlx")
const arithmetic = @import("./arithmetic.mlx")
const values = @import("./values.mlx")
const calls = @import("./calls.mlx")
const control = @import("./control.mlx")
const runtime = @import("./runtime.mlx")

// Text layout: _start (executables only), the compiled functions, the
// runtime helpers with their syscall table, the constant tables' images,
// then the string literals.
pub const Emitter = struct {
    pub fn generateBinary(state: *state_module.State, with_start: bool) -> void {
        Self.defineGlobals(state)
        if with_start { Self.emitStartStub(state) }
        var index: usize = 0
        const count = lir_module.instCount(state.*.lir)
        while index < count {
            Self.emitInstruction(state, index, lir_module.getInst(state.*.lir, index))
            index += 1
        }
        runtime.emitHelpers(state.*.enc)
        Self.emitReadOnlyGlobals(state)
        Self.emitStringLiterals(state)
    }

    fn emitInstruction(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if labels.Labels.emit(state, index, instruction) { return }
        if memory.Memory.emit(state, index, instruction) { return }
        if arithmetic.Arithmetic.emit(state, index, instruction) { return }
        if values.Values.emit(state, index, instruction) { return }
        if calls.Calls.emit(state, index, instruction) { return }
        const handled = control.Control.emit(state, index, instruction)
    }

    // Linux process entry: [sp] = argc, sp + 8 = argv. Calls main(argv,
    // argc) like the x86_64 stub, then exits with main's result.
    fn emitStartStub(state: *state_module.State) -> void {
        const enc = state.*.enc
        unsafe { encoder.defineSymbol(enc, @ptrCast([*]const u8, "_start"), 6) }
        // (`__mlx_init_globals`, the addresses the globals' initializers
        // name, when the program has one: before main.)
        var init_name: [*]const u8 = undefined
        unsafe { init_name = @ptrCast([*]const u8, "__mlx_init_globals") }
        if lir_module.findSymbol(state.*.lir, init_name, 18).0 { encoder.emitCallTo(enc, init_name, 18) }
        encoder.emit32(enc, encoder.ldrX(encoder.X1, encoder.SP, 0))
        encoder.emit32(enc, encoder.addImm(encoder.X0, encoder.SP, 8))
        unsafe { encoder.emitCallTo(enc, @ptrCast([*]const u8, "main"), 4) }
        encoder.emitLoadImm(enc, encoder.X8, 93) // exit
        encoder.emit32(enc, encoder.SVC0)
    }

    // The globals (lir.Global) as data symbols of the writable block, with
    // their initial values; code reaches them by name (emitAddressOf). Not
    // a read-only one (a constant table's image): its bytes are code
    // (emitReadOnlyGlobals), reached by name as well.
    fn defineGlobals(state: *state_module.State) -> void {
        var index: usize = 0
        while index < lir_module.globalCount(state.*.lir) {
            const entry = lir_module.getGlobal(state.*.lir, index)
            if !entry.readOnly {
                encoder.defineGlobal(state.*.enc, entry.pointer, entry.length, entry.size, if entry.alignment > 16 { 16 } else { entry.alignment }, entry.value, entry.bytes, entry.byteCount)
            }
            index += 1
        }
    }

    // The read-only globals (constant tables' images) after the functions,
    // each at its alignment under its label; nothing writes there (the
    // code is not writable). The words of them that hold addresses
    // (lir.GlobalAddress: a string literal, a function, another image) are
    // noted for the image writer (encoder.fillCodeAddresses).
    fn emitReadOnlyGlobals(state: *state_module.State) -> void {
        const count = lir_module.globalCount(state.*.lir)
        if count == 0 { return }
        var places = state.*.allocator.alloc(count * @sizeOf(usize), @alignOf(usize)).?
        var placed: [*]usize = undefined
        unsafe { placed = @ptrCast([*]usize, places) }
        var index: usize = 0
        while index < count {
            const entry = lir_module.getGlobal(state.*.lir, index)
            placed[index] = 0
            if entry.readOnly {
                if entry.alignment > 1 { encoder.alignTo(state.*.enc, entry.alignment) }
                placed[index] = encoder.pos(state.*.enc)
                encoder.defineSymbol(state.*.enc, entry.pointer, entry.length)
                var byte: usize = 0
                while byte < entry.size {
                    encoder.emit1(state.*.enc, entry.bytes[byte])
                    byte += 1
                }
            }
            index += 1
        }
        index = 0
        while index < lir_module.globalAddressCount(state.*.lir) {
            const address = lir_module.getGlobalAddress(state.*.lir, index)
            const place = placed[address.global] + address.offset
            if address.kind == lir_module.ADDRESS_GLOBAL {
                const target_global = lir_module.getGlobal(state.*.lir, address.target)
                encoder.addCodeAddress(state.*.enc, place, target_global.pointer, target_global.length, address.addend)
            } else if address.kind == lir_module.ADDRESS_STRING {
                const literal = lir_module.getStringLiteral(state.*.lir, address.target)
                encoder.addCodeAddress(state.*.enc, place, literal.namePointer, literal.nameLength, address.addend)
            } else {
                const symbol = lir_module.getSymbol(state.*.lir, address.target)
                encoder.addCodeAddress(state.*.enc, place, symbol.pointer, symbol.length, address.addend)
            }
            index += 1
        }
        state.*.allocator.free(places, count * @sizeOf(usize), @alignOf(usize))
    }

    fn emitStringLiterals(state: *state_module.State) -> void {
        var literal_index: usize = 0
        while literal_index < lir_module.stringLiteralCount(state.*.lir) {
            const literal = lir_module.getStringLiteral(state.*.lir, literal_index)
            encoder.defineSymbol(state.*.enc, literal.namePointer, literal.nameLength)
            var byte_index: usize = 0
            while byte_index <= literal.length {
                encoder.emit1(state.*.enc, literal.pointer[byte_index])
                byte_index += 1
            }
            literal_index += 1
        }
    }
}
