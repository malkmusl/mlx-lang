const encoder = @import("../encoder.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")
const runtime = @import("./runtime.mlx")

const X0: u32 = 0
const X1: u32 = 1
const X2: u32 = 2

pub const Arithmetic = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        match instruction.opcode {
            lir_module.Opcode.add => { Self.emitNumeric(state, index, instruction) },
            lir_module.Opcode.sub => { Self.emitNumeric(state, index, instruction) },
            lir_module.Opcode.mul => { Self.emitNumeric(state, index, instruction) },
            lir_module.Opcode.bit_and => { Self.emitInteger(state, index, instruction) },
            lir_module.Opcode.bit_or => { Self.emitInteger(state, index, instruction) },
            lir_module.Opcode.bit_xor => { Self.emitInteger(state, index, instruction) },
            lir_module.Opcode.div => { Self.emitNumeric(state, index, instruction) },
            lir_module.Opcode.rem => { Self.emitInteger(state, index, instruction) },
            lir_module.Opcode.udiv => { Self.emitInteger(state, index, instruction) },
            lir_module.Opcode.urem => { Self.emitInteger(state, index, instruction) },
            lir_module.Opcode.shl => { Self.emitInteger(state, index, instruction) },
            lir_module.Opcode.shr => { Self.emitInteger(state, index, instruction) },
            lir_module.Opcode.popcount => { Self.emitPopCount(state, index, instruction) },
            lir_module.Opcode.byte_mask_64 => { Self.emitByteMask64(state, index, instruction) },
            lir_module.Opcode.icmp => { Self.emitComparison(state, index, instruction) },
            lir_module.Opcode.fcmp => { Self.emitFloatComparison(state, index, instruction) },
            else => { return false },
        }
        return true
    }

    fn emitNumeric(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if state_module.State.isFloatType(state, instruction.typeId) {
            Self.emitFloat(state, index, instruction)
        } else {
            Self.emitInteger(state, index, instruction)
        }
    }

    fn emitFloat(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const bits = state_module.State.floatBits(state, instruction.typeId)
        encoder.emitLoadSlotFp(state.*.enc, 0, state_module.State.allocateOp(state, instruction.arg0), bits)
        encoder.emitLoadSlotFp(state.*.enc, 1, state_module.State.allocateOp(state, instruction.arg1), bits)
        match instruction.opcode {
            lir_module.Opcode.add => { encoder.emit32(state.*.enc, encoder.fadd(0, 0, 1, bits)) },
            lir_module.Opcode.sub => { encoder.emit32(state.*.enc, encoder.fsub(0, 0, 1, bits)) },
            lir_module.Opcode.mul => { encoder.emit32(state.*.enc, encoder.fmul(0, 0, 1, bits)) },
            else => { encoder.emit32(state.*.enc, encoder.fdiv(0, 0, 1, bits)) },
        }
        encoder.emitStoreSlotFp(state.*.enc, state_module.State.allocateOp(state, index), 0, bits)
    }

    // x0 = arg0 <op> arg1. Division by zero yields 0 here where x86_64 traps.
    fn emitInteger(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, X1, instruction.arg1)
        state_module.State.loadOp(state, X0, instruction.arg0)
        const enc = state.*.enc
        match instruction.opcode {
            lir_module.Opcode.add => { encoder.emit32(enc, encoder.addReg(X0, X0, X1)) },
            lir_module.Opcode.sub => { encoder.emit32(enc, encoder.subReg(X0, X0, X1)) },
            lir_module.Opcode.mul => { encoder.emit32(enc, encoder.mul(X0, X0, X1)) },
            lir_module.Opcode.bit_and => { encoder.emit32(enc, encoder.andReg(X0, X0, X1)) },
            lir_module.Opcode.bit_or => { encoder.emit32(enc, encoder.orrReg(X0, X0, X1)) },
            lir_module.Opcode.bit_xor => { encoder.emit32(enc, encoder.eorReg(X0, X0, X1)) },
            lir_module.Opcode.div => { encoder.emit32(enc, encoder.sdiv(X0, X0, X1)) },
            lir_module.Opcode.udiv => { encoder.emit32(enc, encoder.udiv(X0, X0, X1)) },
            lir_module.Opcode.rem => {
                encoder.emit32(enc, encoder.sdiv(X2, X0, X1))
                encoder.emit32(enc, encoder.msub(X0, X2, X1, X0))
            },
            lir_module.Opcode.urem => {
                encoder.emit32(enc, encoder.udiv(X2, X0, X1))
                encoder.emit32(enc, encoder.msub(X0, X2, X1, X0))
            },
            lir_module.Opcode.shl => { encoder.emit32(enc, encoder.lslv(X0, X0, X1)) },
            lir_module.Opcode.shr => {
                if state_module.State.isSignedType(state, instruction.typeId) {
                    encoder.emit32(enc, encoder.asrv(X0, X0, X1))
                } else {
                    encoder.emit32(enc, encoder.lsrv(X0, X0, X1))
                }
            },
            else => {},
        }
        state_module.State.storeResult(state, index, X0)
    }

    // Counts the set bits among the low `arg1` bits with the SIMD byte
    // counter: CNT per byte, then ADDV across the eight bytes.
    fn emitPopCount(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, X0, instruction.arg0)
        if instruction.arg1 < 64 {
            const mask = (@intCast(usize, 1) << instruction.arg1) - 1
            encoder.emitLoadImm(state.*.enc, X1, @intCast(u64, mask))
            encoder.emit32(state.*.enc, encoder.andReg(X0, X0, X1))
        }
        encoder.emit32(state.*.enc, encoder.fmovToFp(0, X0))
        encoder.emit32(state.*.enc, encoder.cnt8b(0, 0))
        encoder.emit32(state.*.enc, encoder.addv8b(0, 0))
        encoder.emit32(state.*.enc, encoder.umovB0(X0, 0))
        state_module.State.storeResult(state, index, X0)
    }

    fn emitByteMask64(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, X0, instruction.arg0)
        state_module.State.loadOp(state, X1, instruction.arg1)
        runtime.emitCall(state.*.enc, runtime.Helper.byte_mask_64)
        state_module.State.storeResult(state, index, X0)
    }

    fn emitComparison(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const predicate = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, instruction.arg0))
        state_module.State.loadOp(state, X1, instruction.arg2)
        state_module.State.loadOp(state, X0, instruction.arg1)
        encoder.emit32(state.*.enc, encoder.cmpReg(X0, X1))
        encoder.emit32(state.*.enc, encoder.cset(X0, condition(predicate)))
        state_module.State.storeResult(state, index, X0)
    }

    // Ordered comparisons, except `ne`, which is also true for NaN operands
    // (the same results the x86_64 backend's ucomis/setcc sequences give).
    fn emitFloatComparison(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const predicate = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, instruction.arg0))
        const bits = state_module.State.floatBits(state, instruction.typeId)
        encoder.emitLoadSlotFp(state.*.enc, 0, state_module.State.allocateOp(state, instruction.arg1), bits)
        encoder.emitLoadSlotFp(state.*.enc, 1, state_module.State.allocateOp(state, instruction.arg2), bits)
        encoder.emit32(state.*.enc, encoder.fcmp(0, 1, bits))
        match predicate {
            lir_module.CmpPredicate.eq => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_EQ)) },
            lir_module.CmpPredicate.ne => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_NE)) },
            lir_module.CmpPredicate.lt => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_MI)) },
            lir_module.CmpPredicate.ult => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_MI)) },
            lir_module.CmpPredicate.le => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_LS)) },
            lir_module.CmpPredicate.ule => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_LS)) },
            lir_module.CmpPredicate.gt => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_GT)) },
            lir_module.CmpPredicate.ugt => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_GT)) },
            lir_module.CmpPredicate.ge => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_GE)) },
            lir_module.CmpPredicate.uge => { encoder.emit32(state.*.enc, encoder.cset(X0, encoder.COND_GE)) },
            else => { encoder.emitLoadImm(state.*.enc, X0, 0) },
        }
        encoder.emitStoreSlot(state.*.enc, state_module.State.allocateOp(state, index), X0)
    }
}

// Integer comparison predicate to condition code (flags from CMP).
pub fn condition(predicate: lir_module.CmpPredicate) -> u32 {
    match predicate {
        lir_module.CmpPredicate.eq => { return encoder.COND_EQ },
        lir_module.CmpPredicate.ne => { return encoder.COND_NE },
        lir_module.CmpPredicate.lt => { return encoder.COND_LT },
        lir_module.CmpPredicate.le => { return encoder.COND_LE },
        lir_module.CmpPredicate.gt => { return encoder.COND_GT },
        lir_module.CmpPredicate.ge => { return encoder.COND_GE },
        lir_module.CmpPredicate.ult => { return encoder.COND_LO },
        lir_module.CmpPredicate.ule => { return encoder.COND_LS },
        lir_module.CmpPredicate.ugt => { return encoder.COND_HI },
        lir_module.CmpPredicate.uge => { return encoder.COND_HS },
        else => { return encoder.COND_EQ },
    }
    return encoder.COND_EQ
}
