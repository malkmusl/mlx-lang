const encoder = @import("../encoder.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")

const X0: u32 = 0
const X1: u32 = 1

pub const Values = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        match instruction.opcode {
            lir_module.Opcode.func_sym => { Self.emitFunctionSymbol(state, index, instruction) },
            lir_module.Opcode.string_literal => { Self.emitStringLiteral(state, index, instruction) },
            lir_module.Opcode.tuple_literal => { Self.emitTupleLiteral(state, index, instruction) },
            lir_module.Opcode.tuple_element => { Self.emitTupleElement(state, index, instruction) },
            lir_module.Opcode.error_payload => { Self.emitErrorPayload(state, index, instruction) },
            lir_module.Opcode.error_payload_part => { Self.emitPrimaryCopy(state, index, instruction) },
            lir_module.Opcode.error_test => { Self.emitPrimaryCopy(state, index, instruction) },
            else => { return false },
        }
        return true
    }

    fn emitFunctionSymbol(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const symbol = lir_module.getSymbol(state.*.lir, instruction.arg0)
        const destination = state_module.State.allocateOp(state, index)
        if symbol.flags & lir_module.SYMBOL_IMPORT != 0 {
            encoder.emitImportAddress(state.*.enc, X0, symbol.pointer, symbol.length)
        } else {
            encoder.emitAddressOf(state.*.enc, X0, symbol.pointer, symbol.length)
        }
        encoder.emitStoreSlot(state.*.enc, destination, X0)
    }

    fn emitStringLiteral(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const literal = lir_module.getStringLiteral(state.*.lir, instruction.arg0)
        const destination = state_module.State.allocateOp(state, index)
        encoder.emitAddressOf(state.*.enc, X0, literal.namePointer, literal.nameLength)
        encoder.emitStoreSlot(state.*.enc, destination, X0)
        const length = state_module.State.allocateSecondaryOp(state, index)
        encoder.emitLoadImm(state.*.enc, X1, @intCast(u64, literal.length))
        encoder.emitStoreSlot(state.*.enc, length, X1)
    }

    fn emitTupleLiteral(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if instruction.arg1 == 0 {
            encoder.emitLoadImm(state.*.enc, X0, 0)
            encoder.emitStoreSlot(state.*.enc, state_module.State.allocateOp(state, index), X0)
        }
        var component: usize = 0
        while component < instruction.arg1 {
            const source = state_module.State.allocateOp(state, lir_module.getExtra(state.*.lir, instruction.arg0 + component))
            const destination = state_module.State.allocateComponentOp(state, index, component)
            encoder.emitLoadSlot(state.*.enc, X0, source)
            encoder.emitStoreSlot(state.*.enc, destination, X0)
            component += 1
        }
    }

    fn emitTupleElement(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const destination = state_module.State.allocateOp(state, index)
        if instruction.arg1 == 0 {
            state_module.State.loadOp(state, X0, instruction.arg0)
        } else {
            const source = state_module.State.getComponent(state, instruction.arg0, instruction.arg1)
            if source.0 {
                encoder.emitLoadSlot(state.*.enc, X0, source.1)
            } else {
                encoder.emitLoadImm(state.*.enc, X0, 0)
            }
        }
        encoder.emitStoreSlot(state.*.enc, destination, X0)
    }

    fn emitErrorPayload(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const destination = state_module.State.allocateOp(state, index)
        const source = state_module.State.getComponent(state, instruction.arg0, 1)
        if source.0 {
            encoder.emitLoadSlot(state.*.enc, X0, source.1)
        } else {
            encoder.emitLoadImm(state.*.enc, X0, 0)
        }
        encoder.emitStoreSlot(state.*.enc, destination, X0)
    }

    fn emitPrimaryCopy(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const source = state_module.State.allocateOp(state, instruction.arg0)
        const destination = state_module.State.allocateOp(state, index)
        encoder.emitLoadSlot(state.*.enc, X0, source)
        encoder.emitStoreSlot(state.*.enc, destination, X0)
    }
}
