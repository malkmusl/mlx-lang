const encoder = @import("../encoder.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")
const runtime = @import("./runtime.mlx")

pub const Memory = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        match instruction.opcode {
            lir_module.Opcode.const_i => { Self.emitConstant(state, index, instruction) },
            lir_module.Opcode.addr => { Self.emitAddress(state, index, instruction) },
            lir_module.Opcode.alloca => { Self.emitAlloca(state, index, instruction) },
            lir_module.Opcode.gep => { Self.emitGep(state, index, instruction) },
            lir_module.Opcode.store => { Self.emitStore(state, instruction) },
            lir_module.Opcode.load => { Self.emitLoad(state, index, instruction) },
            lir_module.Opcode.copy => { Self.emitCopy(state, index, instruction) },
            lir_module.Opcode.cast => { Self.emitCast(state, index, instruction) },
            lir_module.Opcode.bitcast => { Self.emitCopy(state, index, instruction) },
            lir_module.Opcode.aggregate_copy => { Self.emitCopy(state, index, instruction) },
            else => { return false },
        }
        return true
    }

    fn emitConstant(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.storeImmediateResult(state, index, @intCast(u64, instruction.arg0))
    }

    fn emitAddress(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const source = state_module.State.getOrAllocSlot(state, instruction.arg0)
        encoder.emitSlotAddress(state.*.enc, encoder.X0, source)
        state_module.State.storeResult(state, index, encoder.X0)
    }

    fn emitAlloca(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if instruction.arg0 != lir_module.NONE {
            const aligned = (instruction.arg0 + 7) & ~@intCast(usize, 7)
            state.*.aggregateAllocationCount += 1
            state.*.aggregateAllocationBytes += aligned
            encoder.emitLoadImm(state.*.enc, encoder.X0, @intCast(u64, aligned))
            runtime.emitCall(state.*.enc, runtime.Helper.arena_alloc)
        } else {
            const slot = state.*.nextStackSlot
            state.*.nextStackSlot = slot + 8
            encoder.emitSlotAddress(state.*.enc, encoder.X0, slot)
        }
        state_module.State.storeResult(state, index, encoder.X0)
    }

    fn emitGep(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, encoder.X1, instruction.arg1)
        state_module.State.loadOp(state, encoder.X0, instruction.arg0)
        if instruction.arg2 > 1 {
            encoder.emitLoadImm(state.*.enc, encoder.X2, @intCast(u64, instruction.arg2))
            encoder.emit32(state.*.enc, encoder.mul(encoder.X1, encoder.X1, encoder.X2))
        }
        if instruction.arg2 != 0 { encoder.emit32(state.*.enc, encoder.addReg(encoder.X0, encoder.X0, encoder.X1)) }
        state_module.State.storeResult(state, index, encoder.X0)
    }

    fn emitStore(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, encoder.X1, instruction.arg0)
        state_module.State.loadOp(state, encoder.X0, instruction.arg1)
        encoder.emitStorePointer(state.*.enc, encoder.X1, encoder.X0, if instruction.arg2 == lir_module.NONE { 8 } else { instruction.arg2 })
    }

    fn emitLoad(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, encoder.X0, instruction.arg0)
        const width = if instruction.arg1 == lir_module.NONE { 8 } else { instruction.arg1 }
        encoder.emitLoadPointer(state.*.enc, encoder.X0, encoder.X0, width, instruction.arg2 == 1)
        state_module.State.storeResult(state, index, encoder.X0)
    }

    fn emitCopy(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, encoder.X0, instruction.arg0)
        state_module.State.storeResult(state, index, encoder.X0)
    }

    fn emitCast(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        const source = state_module.State.allocateOp(state, instruction.arg0)
        const destination = state_module.State.allocateOp(state, index)
        const source_float = state_module.State.isFloatType(state, instruction.arg1)
        const target_float = state_module.State.isFloatType(state, instruction.typeId)
        if source_float && target_float {
            const source_bits = state_module.State.floatBits(state, instruction.arg1)
            const target_bits = state_module.State.floatBits(state, instruction.typeId)
            encoder.emitLoadSlotFp(state.*.enc, 0, source, source_bits)
            if source_bits != target_bits { encoder.emit32(state.*.enc, encoder.fcvt(0, 0, source_bits)) }
            encoder.emitStoreSlotFp(state.*.enc, destination, 0, target_bits)
            return
        }
        if !source_float && target_float {
            const target_bits = state_module.State.floatBits(state, instruction.typeId)
            state_module.State.loadOp(state, encoder.X0, instruction.arg0)
            encoder.emit32(state.*.enc, encoder.scvtf(0, encoder.X0, target_bits))
            encoder.emitStoreSlotFp(state.*.enc, destination, 0, target_bits)
            return
        }
        if source_float && !target_float {
            const source_bits = state_module.State.floatBits(state, instruction.arg1)
            encoder.emitLoadSlotFp(state.*.enc, 0, source, source_bits)
            encoder.emit32(state.*.enc, encoder.fcvtzs(encoder.X0, 0, source_bits))
            state_module.State.storeResult(state, index, encoder.X0)
            return
        }
        Self.emitCopy(state, index, instruction)
    }
}
