const encoder = @import("../encoder.mlx")
const lir_module = @import("../../../ir/lir.mlx")
const state_module = @import("./state.mlx")
const arithmetic = @import("./arithmetic.mlx")

const X0: u32 = 0
const X1: u32 = 1
const X2: u32 = 2

pub const Control = struct {
    pub fn emit(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> bool {
        match instruction.opcode {
            lir_module.Opcode.ret_error => { Self.emitErrorReturn(state, instruction) },
            lir_module.Opcode.ret_error_union => { Self.emitErrorUnionReturn(state, instruction) },
            lir_module.Opcode.ret => { Self.emitReturn(state, instruction) },
            lir_module.Opcode.ret_slice => { Self.emitSliceReturn(state, instruction) },
            lir_module.Opcode.br => { Self.emitBranch(state, index, instruction.arg0) },
            lir_module.Opcode.condbr => { Self.emitConditionalBranch(state, index, instruction) },
            lir_module.Opcode.icmp_br => { Self.emitIntegerComparisonBranch(state, index, instruction) },
            lir_module.Opcode.unreachable_inst => { encoder.emit32(state.*.enc, encoder.UDF0) },
            else => { return false },
        }
        return true
    }

    fn emitErrorReturn(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, X0, instruction.arg0)
        encoder.emitLoadImm(state.*.enc, X1, 0)
        encoder.emitEpilogue(state.*.enc)
    }

    fn emitErrorUnionReturn(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, X0, instruction.arg0)
        const payload = state_module.State.getComponent(state, instruction.arg0, 1)
        if payload.0 && state_module.State.isFloatErrorUnion(state, instruction.typeId) {
            const payload_type = state_module.State.errorUnionPayloadType(state, instruction.typeId)
            encoder.emitLoadSlotFp(state.*.enc, 0, payload.1, state_module.State.floatBits(state, payload_type))
        } else if payload.0 {
            encoder.emitLoadSlot(state.*.enc, X1, payload.1)
        } else {
            encoder.emitLoadImm(state.*.enc, X1, 0)
        }
        encoder.emitEpilogue(state.*.enc)
    }

    fn emitReturn(state: *state_module.State, instruction: lir_module.Inst) -> void {
        if instruction.arg0 != lir_module.NONE {
            if state_module.State.isFloatType(state, instruction.typeId) {
                encoder.emitLoadSlotFp(state.*.enc, 0, state_module.State.allocateOp(state, instruction.arg0), state_module.State.floatBits(state, instruction.typeId))
                encoder.emitEpilogue(state.*.enc)
                return
            }
            state_module.State.loadOp(state, X0, instruction.arg0)
            const secondary = state_module.State.getComponent(state, instruction.arg0, 1)
            if secondary.0 { encoder.emitLoadSlot(state.*.enc, X1, secondary.1) }
            const tertiary = state_module.State.getComponent(state, instruction.arg0, 2)
            if tertiary.0 { encoder.emitLoadSlot(state.*.enc, X2, tertiary.1) }
        }
        encoder.emitEpilogue(state.*.enc)
    }

    fn emitSliceReturn(state: *state_module.State, instruction: lir_module.Inst) -> void {
        state_module.State.loadOp(state, X0, instruction.arg0)
        state_module.State.loadOp(state, X1, instruction.arg1)
        encoder.emitEpilogue(state.*.enc)
    }

    fn emitBranch(state: *state_module.State, index: usize, target_index: usize) -> void {
        if Self.nextBlockIs(state, index, target_index) {
            state.*.fallthroughBranchCount += 1
            return
        }
        const label = state_module.State.blockLabelName(state, target_index)
        encoder.emitBranchTo(state.*.enc, label.0, label.1)
    }

    // CBZ/CBNZ reach only +-1 MiB, so they skip over an unconditional B
    // (+-128 MiB) instead of targeting the block directly.
    fn emitConditionalBranch(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if instruction.arg1 == instruction.arg2 {
            Self.emitBranch(state, index, instruction.arg1)
            return
        }
        const true_fallthrough = Self.nextBlockIs(state, index, instruction.arg1)
        const false_fallthrough = Self.nextBlockIs(state, index, instruction.arg2)
        state_module.State.loadOp(state, X0, instruction.arg0)
        if true_fallthrough {
            const false_label = state_module.State.blockLabelName(state, instruction.arg2)
            encoder.emit32(state.*.enc, encoder.cbnzX(X0, 8))
            encoder.emitBranchTo(state.*.enc, false_label.0, false_label.1)
            state.*.fallthroughBranchCount += 1
            return
        }
        const true_label = state_module.State.blockLabelName(state, instruction.arg1)
        encoder.emit32(state.*.enc, encoder.cbzX(X0, 8))
        encoder.emitBranchTo(state.*.enc, true_label.0, true_label.1)
        if !false_fallthrough {
            const false_label = state_module.State.blockLabelName(state, instruction.arg2)
            encoder.emitBranchTo(state.*.enc, false_label.0, false_label.1)
        } else { state.*.fallthroughBranchCount += 1 }
    }

    fn emitIntegerComparisonBranch(state: *state_module.State, index: usize, instruction: lir_module.Inst) -> void {
        if instruction.arg1 == instruction.arg2 {
            Self.emitBranch(state, index, instruction.arg1)
            return
        }
        const comparison = lir_module.getInst(state.*.lir, instruction.arg0)
        encoder.emitLoadSlot(state.*.enc, X0, state_module.State.allocateOp(state, comparison.arg1))
        encoder.emitLoadSlot(state.*.enc, X1, state_module.State.allocateOp(state, comparison.arg2))
        encoder.emit32(state.*.enc, encoder.cmpReg(X0, X1))
        const predicate = @enumFromInt(lir_module.CmpPredicate, @intCast(u8, comparison.arg0))
        const condition = arithmetic.condition(predicate)
        if Self.nextBlockIs(state, index, instruction.arg1) {
            const false_label = state_module.State.blockLabelName(state, instruction.arg2)
            encoder.emitBranchCondTo(state.*.enc, condition ^ 1, false_label.0, false_label.1)
            state.*.fallthroughBranchCount += 1
            return
        }
        const true_label = state_module.State.blockLabelName(state, instruction.arg1)
        encoder.emitBranchCondTo(state.*.enc, condition, true_label.0, true_label.1)
        if !Self.nextBlockIs(state, index, instruction.arg2) {
            const false_label = state_module.State.blockLabelName(state, instruction.arg2)
            encoder.emitBranchTo(state.*.enc, false_label.0, false_label.1)
        } else { state.*.fallthroughBranchCount += 1 }
    }

    fn nextBlockIs(state: *state_module.State, index: usize, block: usize) -> bool {
        var cursor = index + 1
        const count = lir_module.instCount(state.*.lir)
        while cursor < count {
            const next = lir_module.getInst(state.*.lir, cursor)
            if next.opcode != lir_module.Opcode.dead {
                return next.opcode == lir_module.Opcode.label && next.arg0 == lir_module.NONE && next.arg1 == block
            }
            cursor += 1
        }
        return false
    }
}
