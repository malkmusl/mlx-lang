const fmt = @import("../../std/bootstrap/fmt.mlx")
const io = @import("../../std/bootstrap/io.mlx")

pub const Code = enum(u16) {
    none = 0,
    unexpected_byte = 1001,
    unexpected_end_of_file = 1002,
    unexpected_token = 2001,
    unknown_identifier = 3001,
    duplicate_symbol = 3002,
    private_declaration = 3003,
    import_not_found = 3004,
    cyclic_comptime_import = 3005,
    type_mismatch = 4001,
    comptime_runtime_dependency = 5001,
    comptime_branch_quota_exceeded = 5002,
    compile_error_builtin = 5003,
    comptime_cycle = 5004,
    invalid_type_reflection = 5005,
    use_after_move = 6001,
    copy_noncopy = 6002,
    invalid_automatic_deinitializer = 6006,
    unsupported_instruction_lowering = 9001
}

pub const Phase = enum(u8) {
    source,
    lexer,
    parser,
    resolve,
    sema,
    compile_time,
    lowering,
    codegen,
    linker,
    stdlib
}

pub const Severity = enum(u8) {
    failure,
    warning,
    note,
    help
}

// Required diagnostic fields are flattened for mlx0's bootstrap aggregate
// representation. The logical model still matches spec/02-compiler.
pub const Diagnostic = struct {
    code: Code
    phase: Phase
    severity: Severity
    fileId: usize
    byteStart: usize
    byteEnd: usize
    messagePointer: [*]const u8
    messageLength: usize
    cause: Code
}

pub fn none() -> Diagnostic {
    unsafe {
        return Diagnostic.{
            .code = Code.none,
            .phase = Phase.source,
            .severity = Severity.note,
            .fileId = 0,
            .byteStart = 0,
            .byteEnd = 0,
            .messagePointer = @ptrFromInt([*]const u8, 0),
            .messageLength = 0,
            .cause = Code.none,
        }
    }
}

pub fn create(code: Code, phase: Phase, severity: Severity, file_id: usize, byte_start: usize, byte_end: usize, message: []const u8) -> Diagnostic {
    unsafe {
        return Diagnostic.{
            .code = code,
            .phase = phase,
            .severity = severity,
            .fileId = file_id,
            .byteStart = byte_start,
            .byteEnd = byte_end,
            .messagePointer = @ptrCast([*]const u8, message),
            .messageLength = messageLength(message),
            .cause = Code.none,
        }
    }
}

fn messageLength(message: []const u8) -> usize {
    var length: usize = 0
    for byte in message { length += 1 }
    return length
}

// A note/related-span diagnostic typically has no stable code of its own
// (code stays Code.none) but still needs to say which primary diagnostic it
// explains, so a JSON/`mlx explain` consumer can group them.
pub fn withCause(value: Diagnostic, cause: Code) -> Diagnostic {
    var updated = value
    updated.cause = cause
    return updated
}

pub fn at(code: Code, byte_offset: usize) -> Diagnostic {
    return create(code, Phase.lexer, Severity.failure, 0, byte_offset, byte_offset + 1, "")
}

// A static "help:" hint alongside a primary error, e.g. suggesting @move
// where a copy was written. Like a note, it carries no stable code of its
// own (see the Code.none handling in render()).
pub fn help(phase: Phase, byte_start: usize, byte_end: usize, message: []const u8) -> Diagnostic {
    return create(Code.none, phase, Severity.help, 0, byte_start, byte_end, message)
}

// Scans only the prefix up to `byte_offset`, so it needs no source length.
pub fn locate(source: []const u8, byte_offset: usize) -> (usize, usize) {
    var line: usize = 1
    var column: usize = 1
    var index: usize = 0
    while index < byte_offset {
        if source[index] == 10 {
            line += 1
            column = 1
        } else {
            column += 1
        }
        index += 1
    }
    return -> (line, column)
}

pub fn render(value: Diagnostic, path: []const u8, source: []const u8) -> bool {
    // Code.none marks an empty placeholder (see none()) only when there is
    // also no message; a note/related-span diagnostic legitimately carries
    // Code.none alongside a real message and must still be printed.
    if value.code == Code.none && value.messageLength == 0 { return true }
    const position = locate(source, value.byteStart)
    var digits: [8]u8 = [8]u8{ 0, 0, 0, 0, 0, 0, 0, 0 }
    unsafe {
        const digit_pointer = @ptrCast([*]u8, digits[0..8])
        const output = io.stderr()
        var path_length: usize = 0
        for byte in path { path_length += 1 }
        if path_length > 0 {
            if !io.writeAll(output, path) { return false }
            if !io.writeAll(output, ":") { return false }
        }
        const line_length = fmt.unsignedDecimal(position.0, digit_pointer, 8)
        if !io.writeAll(output, digits[0..line_length]) { return false }
        if !io.writeAll(output, ":") { return false }
        const column_length = fmt.unsignedDecimal(position.1, digit_pointer, 8)
        if !io.writeAll(output, digits[0..column_length]) { return false }
        if !io.writeAll(output, ": ") { return false }
        var show_code = true
        if value.severity == Severity.warning {
            if !io.writeAll(output, "warning: MLX-W") { return false }
        } else if value.severity == Severity.note {
            if !io.writeAll(output, "note: ") { return false }
            show_code = false
        } else if value.severity == Severity.help {
            if !io.writeAll(output, "help: ") { return false }
            show_code = false
        } else {
            if !io.writeAll(output, "error: MLX-E") { return false }
        }
        if show_code {
            const digit_length = fmt.unsignedDecimal(@intCast(usize, @intFromEnum(value.code)), digit_pointer, 8)
            if !io.writeAll(output, digits[0..digit_length]) { return false }
            if !io.writeAll(output, ": ") { return false }
        }
        if value.messageLength > 0 && !io.writeAll(output, value.messagePointer[0..value.messageLength]) { return false }
        return io.writeAll(output, "\n")
    }
}

// A "did you mean `name`?" suggestion needs a name only known at runtime
// (the closest in-scope identifier), so it is printed directly rather than
// built into a single Diagnostic message slice.
pub fn renderSuggestion(path: []const u8, source: []const u8, byte_start: usize, name_pointer: [*]const u8, name_length: usize) -> bool {
    const position = locate(source, byte_start)
    var digits: [8]u8 = [8]u8{ 0, 0, 0, 0, 0, 0, 0, 0 }
    unsafe {
        const digit_pointer = @ptrCast([*]u8, digits[0..8])
        const output = io.stderr()
        var path_length: usize = 0
        for byte in path { path_length += 1 }
        if path_length > 0 {
            if !io.writeAll(output, path) { return false }
            if !io.writeAll(output, ":") { return false }
        }
        const line_length = fmt.unsignedDecimal(position.0, digit_pointer, 8)
        if !io.writeAll(output, digits[0..line_length]) { return false }
        if !io.writeAll(output, ":") { return false }
        const column_length = fmt.unsignedDecimal(position.1, digit_pointer, 8)
        if !io.writeAll(output, digits[0..column_length]) { return false }
        if !io.writeAll(output, ": help: did you mean `") { return false }
        if !io.writeAll(output, name_pointer[0..name_length]) { return false }
        return io.writeAll(output, "`?\n")
    }
}
