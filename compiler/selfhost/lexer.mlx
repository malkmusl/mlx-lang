const scanner = @import("./lexer/scanner.mlx")
const buffer = @import("./lexer/buffer.mlx")

pub const Kind = scanner.Kind
pub const Token = scanner.Token
pub const Scanner = scanner.Scanner
pub const Buffer = buffer.Buffer
pub const Allocator = buffer.Allocator

pub fn init(source: []const u8) -> Scanner {
    return scanner.Scanner.init(source)
}

pub fn scanNext(state: *Scanner) -> Token {
    return scanner.Scanner.next(state)
}

pub fn next(source: []const u8, start: usize) -> Token {
    return scanner.Scanner.nextFrom(source, start)
}

pub fn count(source: []const u8) -> usize {
    return scanner.Scanner.count(source)
}

pub fn scanAll(allocator: Allocator, source: []const u8) -> Buffer {
    return buffer.scanAll(allocator, source)
}

pub fn scanAllInto(result: *Buffer, allocator: Allocator, source: []const u8) -> void {
    buffer.scanAllInto(result, allocator, source)
}

pub fn scanAllLengthInto(result: *Buffer, allocator: Allocator, source: []const u8, length: usize) -> void {
    buffer.scanAllLengthInto(result, allocator, source, length)
}

pub inline fn tokenAt(tokens: Buffer, index: usize) -> Token {
    return buffer.get(tokens, index)
}

pub fn deinit(tokens: Buffer) -> void {
    buffer.deinit(tokens)
}
