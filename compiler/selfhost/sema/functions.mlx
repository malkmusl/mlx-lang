const lexer = @import("../lexer.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const declarations = @import("./declarations.mlx")
const flow = @import("./control_flow.mlx")
const diagnostic = @import("../diagnostic.mlx")

pub const Buffer = lexer.Buffer
pub const NodeStore = ast_store.Store
pub const TypeStore = types_module.Store
pub const SymbolStore = symbols_module.Store
pub const Scope = symbols_module.Scope

fn isGeneric(nodes: *NodeStore, declaration: usize) -> bool {
    const node = ast_store.Store.get(nodes, declaration)
    var parameter = node.lhs
    while parameter != ast.NONE {
        const value = ast_store.Store.get(nodes, parameter)
        if value.lhs == ast.NONE || value.extra & 1 != 0 { return true }
        parameter = value.next
    }
    return false
}

fn sameName(pointer: [*]const u8, length: usize, expected: []const u8) -> bool {
    const expected_length = expected.length
    if length != expected_length { return false }
    var index: usize = 0
    while index < length {
        if pointer[index] != expected[index] { return false }
        index += 1
    }
    return true
}

fn validDeinitializer(types: *TypeStore, symbols: *SymbolStore, method_index: usize, owner_type: usize, nodes: *NodeStore) -> bool {
    const method = symbols_module.symbolAt(symbols, method_index)
    if isGeneric(nodes, method.*.declaration) { return false }
    const function_type = types_module.get(types, method.*.typeId)
    if function_type.*.kind != types_module.Kind.function || function_type.*.extraLength != 1 { return false }
    if types_module.get(types, function_type.*.lhs).*.kind != types_module.Kind.void_type { return false }
    const receiver = types_module.get(types, types_module.extraAt(types, function_type.*.extraStart))
    if receiver.*.kind != types_module.Kind.pointer || receiver.*.flags & types_module.FLAG_CONSTANT != 0 { return false }
    const child = types_module.get(types, receiver.*.lhs)
    const owner = types_module.get(types, owner_type)
    return child.*.kind == owner.*.kind && child.*.bits == owner.*.bits
}

fn reportInvalidDeinitializer(source: []const u8, path: []const u8, tokens: Buffer, member: ast.Node) -> void {
    const token = lexer.tokenAt(tokens, member.mainToken)
    const rendered = diagnostic.render(diagnostic.create(
        diagnostic.Code.invalid_automatic_deinitializer,
        diagnostic.Phase.sema,
        diagnostic.Severity.failure,
        0,
        token.start,
        token.start + token.length,
        "automatic deinitializer must be fn deinit(self: *Self) -> void",
    ), path, source)
}

fn analyzeFunction(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, root_scope: *Scope, declaration: usize) -> usize {
    const node = ast_store.Store.get(nodes, declaration)
    const name_token = lexer.tokenAt(tokens, node.mainToken)
    const found = symbols_module.lookup(root_scope, declarations.tokenPointer(source, tokens, node.mainToken), name_token.length)
    if !found.0 { return 1 }
    const function_symbol = symbols_module.symbolAt(symbols, found.1)
    const function_type = types_module.get(types, function_symbol.*.typeId)
    if function_type.*.kind != types_module.Kind.function { return 1 }
    var function_scope = symbols_module.initChildScopeFromParent(root_scope, function_type.*.extraLength + 8)
    var errors: usize = 0
    var parameter = node.lhs
    var index: usize = 0
    while parameter != ast.NONE && index < function_type.*.extraLength {
        const parameter_node = ast_store.Store.get(nodes, parameter)
        const token = lexer.tokenAt(tokens, parameter_node.mainToken)
        const pointer = declarations.tokenPointer(source, tokens, parameter_node.mainToken)
        const parameter_type = types_module.extraAt(types, function_type.*.extraStart + index)
        var value = symbols_module.create(pointer, token.length, parameter, parameter_type, 0, symbols_module.FLAG_CONSTANT | symbols_module.FLAG_PARAMETER, symbols_module.State.initialized)
        const symbol_id = symbols_module.append(symbols, &value)
        if !symbols_module.define(&function_scope, pointer, token.length, symbol_id) { errors += 1 }
        parameter = parameter_node.next
        index += 1
    }
    const body_flow = flow.block(source, path, tokens, nodes, types, symbols, &function_scope, node.rhs, function_type.*.lhs, 0)
    errors += body_flow.0
    if !body_flow.1 && !flow.allowsFallthrough(types, function_type.*.lhs) { errors += 1 }
    if errors > 0 {
        const rendered = diagnostic.render(diagnostic.create(
            diagnostic.Code.type_mismatch,
            diagnostic.Phase.sema,
            diagnostic.Severity.failure,
            0,
            name_token.start,
            name_token.start + name_token.length,
            "semantic analysis failed in function",
        ), path, source)
    }
    symbols_module.deinitScope(&function_scope)
    return errors
}

fn analyzeAggregateFunctions(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, root_scope: *Scope, declaration: usize) -> usize {
    const binding = ast_store.Store.get(nodes, declaration)
    if binding.rhs == ast.NONE { return 0 }
    var aggregate_node_index = binding.rhs
    var aggregate_node = ast_store.Store.get(nodes, aggregate_node_index)
    if aggregate_node.tag == ast.Tag.nocopy_type {
        aggregate_node_index = aggregate_node.lhs
        aggregate_node = ast_store.Store.get(nodes, aggregate_node_index)
    }
    if aggregate_node.tag != ast.Tag.struct_type && aggregate_node.tag != ast.Tag.enum_type && aggregate_node.tag != ast.Tag.union_type { return 0 }
    const binding_token = lexer.tokenAt(tokens, binding.mainToken)
    const binding_symbol = symbols_module.lookup(root_scope, declarations.tokenPointer(source, tokens, binding.mainToken), binding_token.length)
    if !binding_symbol.0 { return 1 }
    const aggregate_id = symbols_module.symbolAt(symbols, binding_symbol.1).*.valueTypeId
    if aggregate_id == 0 { return 1 }
    return analyzeAggregateMethods(source, path, tokens, nodes, types, symbols, root_scope, aggregate_node_index, aggregate_id)
}

// The bodies of the methods of the aggregate `aggregate_id` declared at
// `aggregate_node_index`, in a scope under `parent_scope` where `Self`
// and the methods are named.
fn analyzeAggregateMethods(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, parent_scope: *Scope, aggregate_node_index: usize, aggregate_id: usize) -> usize {
    const aggregate_node = ast_store.Store.get(nodes, aggregate_node_index)
    var aggregate_scope = symbols_module.initChildScopeFromParent(parent_scope, aggregate_node.rhs + 4)
    unsafe {
        var self_symbol = symbols_module.create(@ptrCast([*]const u8, "Self"), 4, ast.NONE, types_module.primitive(types, types_module.Kind.type_type), aggregate_id, symbols_module.FLAG_CONSTANT, symbols_module.State.initialized)
        const self_index = symbols_module.append(symbols, &self_symbol)
        if !symbols_module.define(&aggregate_scope, @ptrCast([*]const u8, "Self"), 4, self_index) {
            symbols_module.deinitScope(&aggregate_scope)
            return 1
        }
    }

    var member_index = aggregate_node.lhs
    var visited: usize = 0
    while member_index != ast.NONE && visited < aggregate_node.rhs {
        const member = ast_store.Store.get(nodes, member_index)
        if member.tag == ast.Tag.function_declaration || member.tag == ast.Tag.constant_declaration {
            const method_token = lexer.tokenAt(tokens, member.mainToken)
            const method_pointer = declarations.tokenPointer(source, tokens, member.mainToken)
            const method = declarations.aggregateMethodCompatible(types, symbols, aggregate_id, method_pointer, method_token.length)
            if !method.0 || !symbols_module.define(&aggregate_scope, method_pointer, method_token.length, method.1) {
                symbols_module.deinitScope(&aggregate_scope)
                return 1
            }
        }
        member_index = member.next
        visited += 1
    }

    var errors: usize = 0
    member_index = aggregate_node.lhs
    visited = 0
    while member_index != ast.NONE && visited < aggregate_node.rhs {
        const member = ast_store.Store.get(nodes, member_index)
        const declaration_flags = member.endToken >> 32
        if member.tag == ast.Tag.function_declaration {
            const method_token = lexer.tokenAt(tokens, member.mainToken)
            const method_pointer = declarations.tokenPointer(source, tokens, member.mainToken)
            const method = declarations.aggregateMethodCompatible(types, symbols, aggregate_id, method_pointer, method_token.length)
            if sameName(method_pointer, method_token.length, "deinit") && types_module.get(types, aggregate_id).*.copyability != types_module.Copyability.copyable && (!method.0 || !validDeinitializer(types, symbols, method.1, aggregate_id, nodes)) {
                reportInvalidDeinitializer(source, path, tokens, member)
                errors += 1
            }
            if member.rhs != ast.NONE && declaration_flags & 16 == 0 && !isGeneric(nodes, member_index) {
                errors += analyzeFunction(source, path, tokens, nodes, types, symbols, &aggregate_scope, member_index)
            }
        }
        member_index = member.next
        visited += 1
    }
    symbols_module.deinitScope(&aggregate_scope)
    return errors
}

// The method bodies of the generic type instances made so far (and of
// those that analyzing them makes), each in its instance's scope.
pub fn analyzeInstanceBodies(types: *TypeStore, symbols: *SymbolStore) -> usize {
    var errors: usize = 0
    var index: usize = 0
    while index < types_module.instanceCount(types) {
        const instance = types_module.instanceAt(types, index)
        if instance.*.state != types_module.INSTANCE_MADE || instance.*.resultType == 0 {
            index += 1
            continue
        }
        instance.*.state = types_module.INSTANCE_BODIES_ANALYZED
        const context = symbols_module.moduleContext(symbols, instance.*.moduleId)
        if context.nodesAddress == 0 || context.tokensAddress == 0 {
            index += 1
            continue
        }
        var nodes: *NodeStore = undefined
        var tokens: Buffer = undefined
        var scope: *Scope = undefined
        unsafe {
            nodes = @ptrFromInt(*NodeStore, context.nodesAddress)
            tokens = @ptrFromInt(*Buffer, context.tokensAddress).*
            scope = @ptrFromInt(*Scope, instance.*.scopeAddress)
        }
        const source = context.sourcePointer[0..context.sourceLength]
        const path = context.pathPointer[0..context.pathLength]
        const salt = types_module.setInstanceSalt(types, index + 1)
        var record_index: usize = 0
        while record_index < types_module.instanceAggregateCount(types) {
            const record = types_module.instanceAggregateAt(types, record_index)
            if record.*.instance == index {
                errors += analyzeAggregateMethods(source, path, tokens, nodes, types, symbols, scope, record.*.node, record.*.typeId)
            }
            record_index += 1
        }
        const restored = types_module.setInstanceSalt(types, salt)
        index += 1
    }
    return errors
}

pub fn root(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, root_index: usize, types: *TypeStore, symbols: *SymbolStore, root_scope: *Scope) -> usize {
    const root_node = ast_store.Store.get(nodes, root_index)
    var errors: usize = 0
    var declaration = root_node.lhs
    var count: usize = 0
    while declaration != ast.NONE && count < root_node.rhs {
        const node = ast_store.Store.get(nodes, declaration)
        const declaration_flags = node.endToken >> 32
        if node.tag == ast.Tag.function_declaration && node.rhs != ast.NONE && declaration_flags & 16 == 0 && !isGeneric(nodes, declaration) {
            errors += analyzeFunction(source, path, tokens, nodes, types, symbols, root_scope, declaration)
        }
        if node.tag == ast.Tag.constant_declaration || node.tag == ast.Tag.variable_declaration {
            errors += analyzeAggregateFunctions(source, path, tokens, nodes, types, symbols, root_scope, declaration)
        }
        declaration = node.next
        count += 1
    }
    return errors
}
