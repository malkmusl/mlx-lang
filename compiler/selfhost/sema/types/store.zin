const allocator_module = @import("../../../../std/bootstrap/allocator.zin")
const vector = @import("../../../../std/bootstrap/vector.zin")
const type_module = @import("./type.zin")
const field_module = @import("./field.zin")

pub const Allocator = allocator_module.Allocator
pub const FreeFn = allocator_module.FreeFn
pub const Type = type_module.Type
pub const Field = field_module.Field
pub const Kind = type_module.Kind
pub const Copyability = type_module.Copyability
pub const Vector = vector.Vector
pub const FLAG_SIGNED = type_module.FLAG_SIGNED
pub const FLAG_CONSTANT = type_module.FLAG_CONSTANT
pub const FLAG_VOLATILE = type_module.FLAG_VOLATILE
pub const FLAG_PLATFORM_SIZE = type_module.FLAG_PLATFORM_SIZE
pub const FLAG_LAYOUT_COMPLETE = type_module.FLAG_LAYOUT_COMPLETE
pub const Id = type_module.Id
pub const NONE = type_module.NONE

pub const Store = struct {
    types: *Vector
    extraIds: *Vector
    fields: *Vector
    allocatorContext: usize
    freeFn: FreeFn
}

pub fn init(allocator: Allocator) -> Store {
    const types_memory = allocator.allocFn(allocator.context, @sizeOf(Vector), @alignOf(Vector)).?
    const extra_memory = allocator.allocFn(allocator.context, @sizeOf(Vector), @alignOf(Vector)).?
    const fields_memory = allocator.allocFn(allocator.context, @sizeOf(Vector), @alignOf(Vector)).?
    unsafe {
        const types_pointer = @ptrCast(*Vector, types_memory)
        const extra_pointer = @ptrCast(*Vector, extra_memory)
        const fields_pointer = @ptrCast(*Vector, fields_memory)
        const types_allocation = allocator.allocFn(allocator.context, 64 * @sizeOf(Type), @alignOf(Type))
        const extra_allocation = allocator.allocFn(allocator.context, 128 * @sizeOf(Id), @alignOf(Id))
        const fields_allocation = allocator.allocFn(allocator.context, 128 * @sizeOf(Field), @alignOf(Field))
        types_pointer.*.items = types_allocation.?
        types_pointer.*.length = 0
        types_pointer.*.capacity = 64
        types_pointer.*.elementSize = @sizeOf(Type)
        types_pointer.*.elementAlignment = @alignOf(Type)
        types_pointer.*.allocatorContext = allocator.context
        types_pointer.*.allocFn = allocator.allocFn
        types_pointer.*.resizeFn = allocator.resizeFn
        types_pointer.*.freeFn = allocator.freeFn
        extra_pointer.*.items = extra_allocation.?
        extra_pointer.*.length = 0
        extra_pointer.*.capacity = 128
        extra_pointer.*.elementSize = @sizeOf(Id)
        extra_pointer.*.elementAlignment = @alignOf(Id)
        extra_pointer.*.allocatorContext = allocator.context
        extra_pointer.*.allocFn = allocator.allocFn
        extra_pointer.*.resizeFn = allocator.resizeFn
        extra_pointer.*.freeFn = allocator.freeFn
        fields_pointer.*.items = fields_allocation.?
        fields_pointer.*.length = 0
        fields_pointer.*.capacity = 128
        fields_pointer.*.elementSize = @sizeOf(Field)
        fields_pointer.*.elementAlignment = @alignOf(Field)
        fields_pointer.*.allocatorContext = allocator.context
        fields_pointer.*.allocFn = allocator.allocFn
        fields_pointer.*.resizeFn = allocator.resizeFn
        fields_pointer.*.freeFn = allocator.freeFn
        var result = Store.{
            .types = types_pointer,
            .extraIds = extra_pointer,
            .fields = fields_pointer,
            .allocatorContext = allocator.context,
            .freeFn = allocator.freeFn,
        }
        var invalid = type_module.init(Kind.invalid)
        appendType(&result, &invalid)
        return result
    }
}

// Keep collection mutation pointer-based. Stage0 can pass Vector values to
// read-only helpers, but forwarding a returned Vector through an indirect
// aggregate assignment is not yet a stable bootstrap ABI operation.
fn ensureTypeCapacity(store: *Store, minimum: usize) -> bool {
    if minimum <= store.*.types.*.capacity { return true }
    var capacity = store.*.types.*.capacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = store.*.types.*.resizeFn(
        store.*.types.*.allocatorContext,
        store.*.types.*.items,
        store.*.types.*.capacity * @sizeOf(Type),
        capacity * @sizeOf(Type),
        @alignOf(Type),
    )
    if resized == null { return false }
    const items = resized.?
    store.*.types.*.items = items
    store.*.types.*.capacity = capacity
    return true
}

fn ensureExtraCapacity(store: *Store, minimum: usize) -> bool {
    if minimum <= store.*.extraIds.*.capacity { return true }
    var capacity = store.*.extraIds.*.capacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = store.*.extraIds.*.resizeFn(
        store.*.extraIds.*.allocatorContext,
        store.*.extraIds.*.items,
        store.*.extraIds.*.capacity * @sizeOf(Id),
        capacity * @sizeOf(Id),
        @alignOf(Id),
    )
    if resized == null { return false }
    const items = resized.?
    store.*.extraIds.*.items = items
    store.*.extraIds.*.capacity = capacity
    return true
}

fn ensureFieldCapacity(store: *Store, minimum: usize) -> bool {
    if minimum <= store.*.fields.*.capacity { return true }
    var capacity = store.*.fields.*.capacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = store.*.fields.*.resizeFn(
        store.*.fields.*.allocatorContext,
        store.*.fields.*.items,
        store.*.fields.*.capacity * @sizeOf(Field),
        capacity * @sizeOf(Field),
        @alignOf(Field),
    )
    if resized == null { return false }
    const items = resized.?
    store.*.fields.*.items = items
    store.*.fields.*.capacity = capacity
    return true
}

fn appendType(store: *Store, value: *Type) -> bool {
    if !ensureTypeCapacity(store, store.*.types.*.length + 1) { return false }
    const items = store.*.types.*.items
    const offset = store.*.types.*.length * @sizeOf(Type)
    unsafe {
        const destination = @ptrFromInt([*]u8, @intFromPtr(items) + offset)
        const source = @ptrCast([*]const u8, value)
        var byte: usize = 0
        while byte < @sizeOf(Type) {
            destination[byte] = source[byte]
            byte += 1
        }
    }
    store.*.types.*.length += 1
    return true
}

fn appendId(store: *Store, value: Id) -> bool {
    if !ensureExtraCapacity(store, store.*.extraIds.*.length + 1) { return false }
    const items = store.*.extraIds.*.items
    const offset = store.*.extraIds.*.length * @sizeOf(Id)
    unsafe {
        const destination = @ptrFromInt(*Id, @intFromPtr(items) + offset)
        destination.* = value
    }
    store.*.extraIds.*.length += 1
    return true
}

pub fn appendField(store: *Store, value: *Field) -> usize {
    if !ensureFieldCapacity(store, store.*.fields.*.length + 1) { return NONE }
    const index = store.*.fields.*.length
    unsafe {
        const address = @intFromPtr(store.*.fields.*.items) + index * @sizeOf(Field)
        const destination = @ptrFromInt([*]u8, address)
        const source = @ptrCast([*]const u8, value)
        var byte: usize = 0
        while byte < @sizeOf(Field) {
            destination[byte] = source[byte]
            byte += 1
        }
    }
    store.*.fields.*.length += 1
    return index
}

pub fn fieldAt(store: *Store, index: usize) -> *Field {
    unsafe {
        const address = @intFromPtr(store.*.fields.*.items) + index * @sizeOf(Field)
        return @ptrFromInt(*Field, address)
    }
}

pub fn completeAggregate(store: *Store, id: Id, fields_start: usize, field_count: usize, size: usize, alignment: usize, copyability: Copyability) -> bool {
    const value = get(store, id)
    if value.*.kind != Kind.struct_type && value.*.kind != Kind.enum_type && value.*.kind != Kind.union_type && value.*.kind != Kind.error_set { return false }
    value.*.extraStart = fields_start
    value.*.extraLength = field_count
    value.*.lhs = size
    value.*.rhs = alignment
    value.*.copyability = copyability
    value.*.flags = value.*.flags | FLAG_LAYOUT_COMPLETE
    return true
}

pub fn get(store: *Store, id: Id) -> *Type {
    unsafe {
        const address = @intFromPtr(store.*.types.*.items) + id * @sizeOf(Type)
        return @ptrFromInt(*Type, address)
    }
}

pub fn count(store: *Store) -> usize {
    return store.*.types.*.length
}

pub fn intern(store: *Store, value: *Type) -> Id {
    var index: usize = 0
    while index < store.*.types.*.length {
        if type_module.same(get(store, index), value) { return index }
        index += 1
    }
    const id = store.*.types.*.length
    if !appendType(store, value) { return 0 }
    return id
}

pub fn primitive(store: *Store, kind: Kind) -> Id {
    var value = type_module.init(kind)
    return intern(store, &value)
}

pub fn integer(store: *Store, signed: bool, bits: usize) -> Id {
    if bits == 0 || bits > 4096 { return 0 }
    var value = type_module.init(Kind.integer)
    value.bits = bits
    if signed { value.flags = value.flags | FLAG_SIGNED }
    return intern(store, &value)
}

pub fn sizeInteger(store: *Store, signed: bool) -> Id {
    var value = type_module.init(Kind.integer)
    value.bits = 64
    value.flags = value.flags | FLAG_PLATFORM_SIZE
    if signed { value.flags = value.flags | FLAG_SIGNED }
    return intern(store, &value)
}

pub fn float(store: *Store, bits: usize) -> Id {
    if bits != 32 && bits != 64 { return 0 }
    var value = type_module.init(Kind.float)
    value.bits = bits
    return intern(store, &value)
}

pub fn aggregate(store: *Store, kind: Kind, declaration: usize, copyability: Copyability) -> Id {
    if kind != Kind.struct_type && kind != Kind.enum_type && kind != Kind.union_type && kind != Kind.error_set { return 0 }
    var existing: usize = 0
    while existing < store.*.types.*.length {
        const value = get(store, existing)
        if value.*.kind == kind && value.*.bits == declaration { return existing }
        existing += 1
    }
    var value = type_module.init(kind)
    value.bits = declaration
    value.copyability = copyability
    return intern(store, &value)
}

pub fn pointer(store: *Store, child: Id, is_const: bool, is_volatile: bool, many: bool) -> Id {
    var value = type_module.init(if many { Kind.many_pointer } else { Kind.pointer })
    value.lhs = child
    if is_const { value.flags = value.flags | FLAG_CONSTANT }
    if is_volatile { value.flags = value.flags | FLAG_VOLATILE }
    return intern(store, &value)
}

pub fn slice(store: *Store, child: Id, is_const: bool) -> Id {
    var value = type_module.init(Kind.slice)
    value.lhs = child
    if is_const { value.flags = value.flags | FLAG_CONSTANT }
    return intern(store, &value)
}

pub fn array(store: *Store, child: Id, length: usize) -> Id {
    var value = type_module.init(Kind.array)
    value.lhs = child
    value.bits = length
    return intern(store, &value)
}

pub fn vectorType(store: *Store, child: Id, length: usize) -> Id {
    if length == 0 { return 0 }
    var value = type_module.init(Kind.vector)
    value.lhs = child
    value.bits = length
    return intern(store, &value)
}

pub fn optional(store: *Store, child: Id) -> Id {
    var value = type_module.init(Kind.optional)
    value.lhs = child
    return intern(store, &value)
}

pub fn errorUnion(store: *Store, error_set: Id, payload: Id) -> Id {
    var value = type_module.init(Kind.error_union)
    value.lhs = error_set
    value.rhs = payload
    return intern(store, &value)
}

pub fn noCopy(store: *Store, base: Id) -> Id {
    var value = get(store, base).*
    value.copyability = Copyability.explicit_nocopy
    return intern(store, &value)
}

pub fn appendExtra(store: *Store, id: Id) -> usize {
    const index = store.*.extraIds.*.length
    if !appendId(store, id) { return NONE }
    return index
}

pub fn extraAt(store: *Store, index: usize) -> Id {
    unsafe { return @ptrCast(*Id, vector.at(store.*.extraIds.*, index)).* }
}

pub fn function(store: *Store, return_type: Id, parameters_start: usize, parameter_count: usize) -> Id {
    var existing_index: usize = 0
    while existing_index < store.*.types.*.length {
        const existing = get(store, existing_index)
        if existing.*.kind == Kind.function && existing.*.lhs == return_type && existing.*.extraLength == parameter_count {
            var parameter_index: usize = 0
            var matches = true
            while parameter_index < parameter_count {
                if extraAt(store, existing.*.extraStart + parameter_index) != extraAt(store, parameters_start + parameter_index) { matches = false }
                parameter_index += 1
            }
            if matches { return existing_index }
        }
        existing_index += 1
    }
    var value = type_module.init(Kind.function)
    value.lhs = return_type
    value.extraStart = parameters_start
    value.extraLength = parameter_count
    return intern(store, &value)
}

pub fn tuple(store: *Store, elements_start: usize, element_count: usize) -> Id {
    var copyability = Copyability.copyable
    var index: usize = 0
    while index < element_count {
        if !type_module.isCopyable(get(store, extraAt(store, elements_start + index))) { copyability = Copyability.contains_nocopy }
        index += 1
    }
    var existing_index: usize = 0
    while existing_index < store.*.types.*.length {
        const existing = get(store, existing_index)
        if existing.*.kind == Kind.tuple && existing.*.extraLength == element_count && existing.*.copyability == copyability {
            var element_index: usize = 0
            var matches = true
            while element_index < element_count {
                if extraAt(store, existing.*.extraStart + element_index) != extraAt(store, elements_start + element_index) { matches = false }
                element_index += 1
            }
            if matches { return existing_index }
        }
        existing_index += 1
    }
    var value = type_module.init(Kind.tuple)
    value.extraStart = elements_start
    value.extraLength = element_count
    value.copyability = copyability
    var size: usize = 0
    var alignment: usize = 1
    index = 0
    while index < element_count {
        const element_type = extraAt(store, elements_start + index)
        const element_alignment = alignOf(store, element_type)
        if element_alignment > alignment { alignment = element_alignment }
        size = alignForward(size, element_alignment) + sizeOf(store, element_type)
        index += 1
    }
    value.lhs = alignForward(size, alignment)
    value.rhs = alignment
    value.flags = value.flags | FLAG_LAYOUT_COMPLETE
    return intern(store, &value)
}

fn alignForward(value: usize, alignment: usize) -> usize {
    if alignment <= 1 { return value }
    return (value + alignment - 1) & ~(alignment - 1)
}

fn roundedBytes(bits: usize) -> usize {
    return (bits + 7) / 8
}

pub fn bitSizeOf(store: *Store, id: Id) -> usize {
    const value = get(store, id)
    if value.*.kind == Kind.integer || value.*.kind == Kind.float { return value.*.bits }
    if value.*.kind == Kind.bool_type { return 8 }
    if value.*.kind == Kind.pointer || value.*.kind == Kind.many_pointer { return 64 }
    if value.*.kind == Kind.function { return 64 }
    if value.*.kind == Kind.slice { return 128 }
    if value.*.kind == Kind.optional {
        const child = get(store, value.*.lhs)
        if type_module.isPointer(child) { return 64 }
        return bitSizeOf(store, value.*.lhs) + 8
    }
    if value.*.kind == Kind.array { return value.*.bits * bitSizeOf(store, value.*.lhs) }
    if value.*.kind == Kind.vector { return value.*.bits * bitSizeOf(store, value.*.lhs) }
    if value.*.kind == Kind.tuple || value.*.kind == Kind.struct_type || value.*.kind == Kind.enum_type || value.*.kind == Kind.union_type || value.*.kind == Kind.error_set {
        if value.*.flags & FLAG_LAYOUT_COMPLETE == 0 { return 0 }
        return value.*.lhs * 8
    }
    if value.*.kind == Kind.void_type || value.*.kind == Kind.noreturn_type { return 0 }
    return 0
}

pub fn sizeOf(store: *Store, id: Id) -> usize {
    return roundedBytes(bitSizeOf(store, id))
}

pub fn alignOf(store: *Store, id: Id) -> usize {
    const value = get(store, id)
    if value.*.kind == Kind.void_type || value.*.kind == Kind.noreturn_type { return 1 }
    if value.*.kind == Kind.pointer || value.*.kind == Kind.many_pointer || value.*.kind == Kind.slice { return 8 }
    if value.*.kind == Kind.function { return 8 }
    if value.*.kind == Kind.tuple || value.*.kind == Kind.struct_type || value.*.kind == Kind.enum_type || value.*.kind == Kind.union_type || value.*.kind == Kind.error_set {
        if value.*.flags & FLAG_LAYOUT_COMPLETE == 0 { return 1 }
        return value.*.rhs
    }
    if value.*.kind == Kind.array || value.*.kind == Kind.optional { return alignOf(store, value.*.lhs) }
    if value.*.kind == Kind.vector {
        const size = sizeOf(store, id)
        if size > 16 { return 16 }
        return size
    }
    const size = sizeOf(store, id)
    if size >= 8 { return 8 }
    if size >= 4 { return 4 }
    if size >= 2 { return 2 }
    return 1
}

pub fn isCoercible(store: *Store, from: Id, to: Id) -> bool {
    if from == to { return true }
    const source = get(store, from)
    const target = get(store, to)
    if source.*.kind == Kind.undefined_type { return true }
    if source.*.kind == Kind.null_type && target.*.kind == Kind.optional { return true }
    if target.*.kind == Kind.anytype_type { return true }
    if source.*.kind == Kind.comptime_int_type && (target.*.kind == Kind.integer || target.*.kind == Kind.float) { return true }
    if source.*.kind == Kind.comptime_float_type && target.*.kind == Kind.float { return true }
    if target.*.kind == Kind.optional {
        if source.*.kind == Kind.optional { return source.*.lhs == target.*.lhs }
        return from == target.*.lhs
    }
    if target.*.kind == Kind.error_union {
        if source.*.kind == Kind.error_union { return source.*.lhs == target.*.lhs && source.*.rhs == target.*.rhs }
        return from == target.*.rhs
    }
    if type_module.isPointer(source) && type_module.isPointer(target) {
        const source_const = source.*.flags & FLAG_CONSTANT != 0
        const target_const = target.*.flags & FLAG_CONSTANT != 0
        return source.*.lhs == target.*.lhs && (!source_const || target_const)
    }
    return false
}

pub fn deinit(store: *Store) -> void {
    vector.deinit(store.*.fields.*)
    vector.deinit(store.*.extraIds.*)
    vector.deinit(store.*.types.*)
    unsafe {
        store.*.freeFn(store.*.allocatorContext, @ptrCast([*]u8, store.*.extraIds), @sizeOf(Vector), @alignOf(Vector))
        store.*.freeFn(store.*.allocatorContext, @ptrCast([*]u8, store.*.types), @sizeOf(Vector), @alignOf(Vector))
        store.*.freeFn(store.*.allocatorContext, @ptrCast([*]u8, store.*.fields), @sizeOf(Vector), @alignOf(Vector))
    }
}
