const allocator_module = @import("../../../../std/bootstrap/allocator.mlx")
const vector = @import("../../../../std/bootstrap/vector.mlx")
const type_module = @import("./type.mlx")
const field_module = @import("./field.mlx")

pub const Allocator = allocator_module.Allocator
pub const FreeFn = allocator_module.FreeFn
pub const Type = type_module.Type
pub const Field = field_module.Field
pub const Kind = type_module.Kind
pub const Copyability = type_module.Copyability
pub const Vector = vector.Vector
pub const FLAG_SIGNED = type_module.FLAG_SIGNED
pub const FLAG_CONSTANT = type_module.FLAG_CONSTANT
pub const FLAG_VOLATILE = type_module.FLAG_VOLATILE
pub const FLAG_PLATFORM_SIZE = type_module.FLAG_PLATFORM_SIZE
pub const FLAG_LAYOUT_COMPLETE = type_module.FLAG_LAYOUT_COMPLETE
pub const Id = type_module.Id
pub const NONE = type_module.NONE

pub const Store = struct {
    types: *Vector
    extraIds: *Vector
    fields: *Vector
    primitiveIds: [*]usize
    primitiveCount: usize
    internBuckets: [*]usize
    internCapacity: usize
    internCalls: usize
    internProbes: usize
    maximumInternProbes: usize
    primitiveCacheHits: usize
    allocatorContext: usize
    allocFn: allocator_module.AllocFn
    freeFn: FreeFn

pub fn init(allocator: Allocator) -> Self {
    const types_memory = allocator.alloc(@sizeOf(Vector), @alignOf(Vector)).?
    const extra_memory = allocator.alloc(@sizeOf(Vector), @alignOf(Vector)).?
    const fields_memory = allocator.alloc(@sizeOf(Vector), @alignOf(Vector)).?
    const primitive_count: usize = 27
    var primitive_ids: [*]usize = undefined
    unsafe { primitive_ids = @ptrCast([*]usize, allocator.alloc(primitive_count * @sizeOf(usize), @alignOf(usize)).?) }
    const intern_capacity: usize = 2048
    var intern_buckets: [*]usize = undefined
    unsafe { intern_buckets = @ptrCast([*]usize, allocator.alloc(intern_capacity * @sizeOf(usize), @alignOf(usize)).?) }
    var primitive_index: usize = 0
    while primitive_index < primitive_count {
        primitive_ids[primitive_index] = NONE
        primitive_index += 1
    }
    var bucket_index: usize = 0
    while bucket_index < intern_capacity {
        intern_buckets[bucket_index] = 0
        bucket_index += 1
    }
    unsafe {
        const types_pointer = @ptrCast(*Vector, types_memory)
        const extra_pointer = @ptrCast(*Vector, extra_memory)
        const fields_pointer = @ptrCast(*Vector, fields_memory)
        Vector.initAt(types_pointer, allocator, @sizeOf(Type), @alignOf(Type), 64)
        Vector.initAt(extra_pointer, allocator, @sizeOf(Id), @alignOf(Id), 128)
        Vector.initAt(fields_pointer, allocator, @sizeOf(Field), @alignOf(Field), 128)
        var result = Self.{
            .types = types_pointer,
            .extraIds = extra_pointer,
            .fields = fields_pointer,
            .primitiveIds = primitive_ids,
            .primitiveCount = primitive_count,
            .internBuckets = intern_buckets,
            .internCapacity = intern_capacity,
            .internCalls = 0,
            .internProbes = 0,
            .maximumInternProbes = 0,
            .primitiveCacheHits = 0,
            .allocatorContext = allocator.context,
            .allocFn = allocator.allocFn,
            .freeFn = allocator.freeFn,
        }
        var invalid = type_module.init(Kind.invalid)
        Self.appendType(&result, &invalid)
        Self.indexType(&result, 0)
        result.primitiveIds[0] = 0
        return result
    }
}

// Keep collection mutation pointer-based. Stage0 can pass Vector values to
// read-only helpers, but forwarding a returned Vector through an indirect
// aggregate assignment is not yet a stable bootstrap ABI operation.
fn ensureTypeCapacity(store: *Self, minimum: usize) -> bool {
    if minimum <= store.*.types.*.capacity { return true }
    var capacity = store.*.types.*.capacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = store.*.types.*.resizeFn(
        store.*.types.*.allocatorContext,
        store.*.types.*.items,
        store.*.types.*.capacity * @sizeOf(Type),
        capacity * @sizeOf(Type),
        @alignOf(Type),
    )
    if resized == null { return false }
    const items = resized.?
    store.*.types.*.items = items
    store.*.types.*.capacity = capacity
    return true
}

fn ensureExtraCapacity(store: *Self, minimum: usize) -> bool {
    if minimum <= store.*.extraIds.*.capacity { return true }
    var capacity = store.*.extraIds.*.capacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = store.*.extraIds.*.resizeFn(
        store.*.extraIds.*.allocatorContext,
        store.*.extraIds.*.items,
        store.*.extraIds.*.capacity * @sizeOf(Id),
        capacity * @sizeOf(Id),
        @alignOf(Id),
    )
    if resized == null { return false }
    const items = resized.?
    store.*.extraIds.*.items = items
    store.*.extraIds.*.capacity = capacity
    return true
}

fn ensureFieldCapacity(store: *Self, minimum: usize) -> bool {
    if minimum <= store.*.fields.*.capacity { return true }
    var capacity = store.*.fields.*.capacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = store.*.fields.*.resizeFn(
        store.*.fields.*.allocatorContext,
        store.*.fields.*.items,
        store.*.fields.*.capacity * @sizeOf(Field),
        capacity * @sizeOf(Field),
        @alignOf(Field),
    )
    if resized == null { return false }
    const items = resized.?
    store.*.fields.*.items = items
    store.*.fields.*.capacity = capacity
    return true
}

fn appendType(store: *Self, value: *Type) -> bool {
    if !Self.ensureTypeCapacity(store, store.*.types.*.length + 1) { return false }
    const items = store.*.types.*.items
    const offset = store.*.types.*.length * @sizeOf(Type)
    unsafe {
        const destination = @ptrFromInt([*]u8, @intFromPtr(items) + offset)
        const source = @ptrCast([*]const u8, value)
        var byte: usize = 0
        while byte < @sizeOf(Type) {
            destination[byte] = source[byte]
            byte += 1
        }
    }
    store.*.types.*.length += 1
    return true
}

fn appendId(store: *Self, value: Id) -> bool {
    if !Self.ensureExtraCapacity(store, store.*.extraIds.*.length + 1) { return false }
    const items = store.*.extraIds.*.items
    const offset = store.*.extraIds.*.length * @sizeOf(Id)
    unsafe {
        const destination = @ptrFromInt(*Id, @intFromPtr(items) + offset)
        destination.* = value
    }
    store.*.extraIds.*.length += 1
    return true
}

pub fn appendField(store: *Self, value: *Field) -> usize {
    if !Self.ensureFieldCapacity(store, store.*.fields.*.length + 1) { return NONE }
    const index = store.*.fields.*.length
    unsafe {
        const address = @intFromPtr(store.*.fields.*.items) + index * @sizeOf(Field)
        const destination = @ptrFromInt([*]u8, address)
        const source = @ptrCast([*]const u8, value)
        var byte: usize = 0
        while byte < @sizeOf(Field) {
            destination[byte] = source[byte]
            byte += 1
        }
    }
    store.*.fields.*.length += 1
    return index
}

pub fn fieldAt(store: *Self, index: usize) -> *Field {
    unsafe {
        const address = @intFromPtr(store.*.fields.*.items) + index * @sizeOf(Field)
        return @ptrFromInt(*Field, address)
    }
}

pub fn completeAggregate(store: *Self, id: Id, fields_start: usize, field_count: usize, size: usize, alignment: usize, copyability: Copyability) -> bool {
    const value = Self.get(store, id)
    if value.*.kind != Kind.struct_type && value.*.kind != Kind.enum_type && value.*.kind != Kind.union_type && value.*.kind != Kind.error_set { return false }
    value.*.extraStart = fields_start
    value.*.extraLength = field_count
    value.*.lhs = size
    value.*.rhs = alignment
    value.*.copyability = copyability
    value.*.flags = value.*.flags | FLAG_LAYOUT_COMPLETE
    return true
}

pub inline fn get(store: *Self, id: Id) -> *Type {
    unsafe {
        const address = @intFromPtr(store.*.types.*.items) + id * @sizeOf(Type)
        return @ptrFromInt(*Type, address)
    }
}

pub inline fn count(store: *Self) -> usize {
    return store.*.types.*.length
}

fn mixHash(hash: usize, value: usize) -> usize {
    return (hash ^ value) *% 1099511628211
}

fn typeHash(value: *Type) -> usize {
    var result: usize = 1469598103934665603
    result = Self.mixHash(result, @intCast(usize, @intFromEnum(value.*.kind)))
    result = Self.mixHash(result, value.*.flags)
    result = Self.mixHash(result, value.*.bits)
    result = Self.mixHash(result, value.*.lhs)
    result = Self.mixHash(result, value.*.rhs)
    result = Self.mixHash(result, value.*.backing)
    result = Self.mixHash(result, value.*.extraStart)
    result = Self.mixHash(result, value.*.extraLength)
    return Self.mixHash(result, @intCast(usize, @intFromEnum(value.*.copyability)))
}

fn indexType(store: *Self, id: Id) -> void {
    var slot = Self.typeHash(Self.get(store, id)) & (store.*.internCapacity - 1)
    while store.*.internBuckets[slot] != 0 { slot = (slot + 1) & (store.*.internCapacity - 1) }
    store.*.internBuckets[slot] = id + 1
}

fn ensureInternCapacity(store: *Self) -> void {
    if (store.*.types.*.length + 1) * 10 < store.*.internCapacity * 7 { return }
    const old_buckets = store.*.internBuckets
    const old_capacity = store.*.internCapacity
    store.*.internCapacity *= 2
    unsafe {
        store.*.internBuckets = @ptrCast([*]usize, store.*.allocFn(store.*.allocatorContext, store.*.internCapacity * @sizeOf(usize), @alignOf(usize)).?)
    }
    var index: usize = 0
    while index < store.*.internCapacity {
        store.*.internBuckets[index] = 0
        index += 1
    }
    index = 0
    while index < store.*.types.*.length {
        Self.indexType(store, index)
        index += 1
    }
    unsafe { store.*.freeFn(store.*.allocatorContext, @ptrCast([*]u8, old_buckets), old_capacity * @sizeOf(usize), @alignOf(usize)) }
}

pub fn intern(store: *Self, value: *Type) -> Id {
    store.*.internCalls += 1
    Self.ensureInternCapacity(store)
    var slot = Self.typeHash(value) & (store.*.internCapacity - 1)
    var probes: usize = 0
    while store.*.internBuckets[slot] != 0 {
        probes += 1
        const existing = store.*.internBuckets[slot] - 1
        if type_module.same(Self.get(store, existing), value) {
            store.*.internProbes += probes
            if probes > store.*.maximumInternProbes { store.*.maximumInternProbes = probes }
            return existing
        }
        slot = (slot + 1) & (store.*.internCapacity - 1)
    }
    store.*.internProbes += probes
    if probes > store.*.maximumInternProbes { store.*.maximumInternProbes = probes }
    const id = store.*.types.*.length
    if !Self.appendType(store, value) { return 0 }
    store.*.internBuckets[slot] = id + 1
    return id
}

pub fn primitive(store: *Self, kind: Kind) -> Id {
    const cache_index = @intCast(usize, @intFromEnum(kind))
    if cache_index < store.*.primitiveCount && store.*.primitiveIds[cache_index] != NONE {
        store.*.primitiveCacheHits += 1
        return store.*.primitiveIds[cache_index]
    }
    var value = type_module.init(kind)
    const result = Self.intern(store, &value)
    if cache_index < store.*.primitiveCount { store.*.primitiveIds[cache_index] = result }
    return result
}

pub fn internCallCount(store: *Self) -> usize { return store.*.internCalls }
pub fn internProbeCount(store: *Self) -> usize { return store.*.internProbes }
pub fn maxInternProbeCount(store: *Self) -> usize { return store.*.maximumInternProbes }
pub fn primitiveCacheHitCount(store: *Self) -> usize { return store.*.primitiveCacheHits }

pub fn integer(store: *Self, signed: bool, bits: usize) -> Id {
    if bits == 0 || bits > 4096 { return 0 }
    var value = type_module.init(Kind.integer)
    value.bits = bits
    if signed { value.flags = value.flags | FLAG_SIGNED }
    return Self.intern(store, &value)
}

pub fn sizeInteger(store: *Self, signed: bool) -> Id {
    var value = type_module.init(Kind.integer)
    value.bits = 64
    value.flags = value.flags | FLAG_PLATFORM_SIZE
    if signed { value.flags = value.flags | FLAG_SIGNED }
    return Self.intern(store, &value)
}

pub fn float(store: *Self, bits: usize) -> Id {
    if bits != 32 && bits != 64 { return 0 }
    var value = type_module.init(Kind.float)
    value.bits = bits
    return Self.intern(store, &value)
}

pub fn aggregate(store: *Self, kind: Kind, declaration: usize, copyability: Copyability) -> Id {
    if kind != Kind.struct_type && kind != Kind.enum_type && kind != Kind.union_type && kind != Kind.error_set { return 0 }
    var existing: usize = 0
    while existing < store.*.types.*.length {
        const value = Self.get(store, existing)
        if value.*.kind == kind && value.*.bits == declaration { return existing }
        existing += 1
    }
    var value = type_module.init(kind)
    value.bits = declaration
    value.copyability = copyability
    return Self.intern(store, &value)
}

pub fn moduleType(store: *Self, module_id: usize, declarations_start: usize, declaration_count: usize) -> Id {
    var existing_index: usize = 0
    while existing_index < store.*.types.*.length {
        const existing = Self.get(store, existing_index)
        if existing.*.kind == Kind.module && existing.*.bits == module_id { return existing_index }
        existing_index += 1
    }
    var value = type_module.init(Kind.module)
    value.bits = module_id
    value.extraStart = declarations_start
    value.extraLength = declaration_count
    return Self.intern(store, &value)
}

pub fn pointer(store: *Self, child: Id, is_const: bool, is_volatile: bool, many: bool) -> Id {
    var value = type_module.init(if many { Kind.many_pointer } else { Kind.pointer })
    value.lhs = child
    if is_const { value.flags = value.flags | FLAG_CONSTANT }
    if is_volatile { value.flags = value.flags | FLAG_VOLATILE }
    return Self.intern(store, &value)
}

pub fn slice(store: *Self, child: Id, is_const: bool) -> Id {
    var value = type_module.init(Kind.slice)
    value.lhs = child
    if is_const { value.flags = value.flags | FLAG_CONSTANT }
    return Self.intern(store, &value)
}

pub fn array(store: *Self, child: Id, length: usize) -> Id {
    var value = type_module.init(Kind.array)
    value.lhs = child
    value.bits = length
    return Self.intern(store, &value)
}

pub fn vectorType(store: *Self, child: Id, length: usize) -> Id {
    if length == 0 { return 0 }
    var value = type_module.init(Kind.vector)
    value.lhs = child
    value.bits = length
    return Self.intern(store, &value)
}

pub fn optional(store: *Self, child: Id) -> Id {
    var value = type_module.init(Kind.optional)
    value.lhs = child
    return Self.intern(store, &value)
}

pub fn errorUnion(store: *Self, error_set: Id, payload: Id) -> Id {
    var value = type_module.init(Kind.error_union)
    value.lhs = error_set
    value.rhs = payload
    return Self.intern(store, &value)
}

pub fn noCopy(store: *Self, base: Id) -> Id {
    var value = Self.get(store, base).*
    value.copyability = Copyability.explicit_nocopy
    return Self.intern(store, &value)
}

pub fn appendExtra(store: *Self, id: Id) -> usize {
    const index = store.*.extraIds.*.length
    if !Self.appendId(store, id) { return NONE }
    return index
}

pub inline fn extraAt(store: *Self, index: usize) -> Id {
    unsafe { return @ptrCast(*Id, vector.Vector.at(store.*.extraIds.*, index)).* }
}

pub fn setExtra(store: *Self, index: usize, id: Id) -> void {
    unsafe { @ptrCast(*Id, vector.Vector.at(store.*.extraIds.*, index)).* = id }
}

pub fn function(store: *Self, return_type: Id, parameters_start: usize, parameter_count: usize) -> Id {
    var existing_index: usize = 0
    while existing_index < store.*.types.*.length {
        const existing = Self.get(store, existing_index)
        if existing.*.kind == Kind.function && existing.*.lhs == return_type && existing.*.extraLength == parameter_count {
            var parameter_index: usize = 0
            var matches = true
            while parameter_index < parameter_count {
                if Self.extraAt(store, existing.*.extraStart + parameter_index) != Self.extraAt(store, parameters_start + parameter_index) { matches = false }
                parameter_index += 1
            }
            if matches { return existing_index }
        }
        existing_index += 1
    }
    var value = type_module.init(Kind.function)
    value.lhs = return_type
    value.extraStart = parameters_start
    value.extraLength = parameter_count
    return Self.intern(store, &value)
}

pub fn tuple(store: *Self, elements_start: usize, element_count: usize) -> Id {
    var copyability = Copyability.copyable
    var index: usize = 0
    while index < element_count {
        if !type_module.isCopyable(Self.get(store, Self.extraAt(store, elements_start + index))) { copyability = Copyability.contains_nocopy }
        index += 1
    }
    var existing_index: usize = 0
    while existing_index < store.*.types.*.length {
        const existing = Self.get(store, existing_index)
        if existing.*.kind == Kind.tuple && existing.*.extraLength == element_count && existing.*.copyability == copyability {
            var element_index: usize = 0
            var matches = true
            while element_index < element_count {
                if Self.extraAt(store, existing.*.extraStart + element_index) != Self.extraAt(store, elements_start + element_index) { matches = false }
                element_index += 1
            }
            if matches { return existing_index }
        }
        existing_index += 1
    }
    var value = type_module.init(Kind.tuple)
    value.extraStart = elements_start
    value.extraLength = element_count
    value.copyability = copyability
    var size: usize = 0
    var alignment: usize = 1
    index = 0
    while index < element_count {
        const element_type = Self.extraAt(store, elements_start + index)
        const element_alignment = Self.alignOf(store, element_type)
        if element_alignment > alignment { alignment = element_alignment }
        size = Self.alignForward(size, element_alignment) + Self.sizeOf(store, element_type)
        index += 1
    }
    value.lhs = Self.alignForward(size, alignment)
    value.rhs = alignment
    value.flags = value.flags | FLAG_LAYOUT_COMPLETE
    return Self.intern(store, &value)
}

fn alignForward(value: usize, alignment: usize) -> usize {
    if alignment <= 1 { return value }
    return (value + alignment - 1) & ~(alignment - 1)
}

fn roundedBytes(bits: usize) -> usize {
    return (bits + 7) / 8
}

pub fn bitSizeOf(store: *Self, id: Id) -> usize {
    const value = Self.get(store, id)
    if value.*.kind == Kind.integer || value.*.kind == Kind.float { return value.*.bits }
    if value.*.kind == Kind.bool_type { return 8 }
    if value.*.kind == Kind.pointer || value.*.kind == Kind.many_pointer { return 64 }
    if value.*.kind == Kind.function { return 64 }
    if value.*.kind == Kind.slice { return 128 }
    if value.*.kind == Kind.optional {
        const child = Self.get(store, value.*.lhs)
        if type_module.isPointer(child) { return 64 }
        return Self.bitSizeOf(store, value.*.lhs) + 8
    }
    if value.*.kind == Kind.array { return value.*.bits * Self.bitSizeOf(store, value.*.lhs) }
    if value.*.kind == Kind.vector { return value.*.bits * Self.bitSizeOf(store, value.*.lhs) }
    if value.*.kind == Kind.tuple || value.*.kind == Kind.struct_type || value.*.kind == Kind.enum_type || value.*.kind == Kind.union_type || value.*.kind == Kind.error_set {
        if value.*.flags & FLAG_LAYOUT_COMPLETE == 0 { return 0 }
        return value.*.lhs * 8
    }
    if value.*.kind == Kind.void_type || value.*.kind == Kind.noreturn_type { return 0 }
    return 0
}

pub inline fn sizeOf(store: *Self, id: Id) -> usize {
    return Self.roundedBytes(Self.bitSizeOf(store, id))
}

pub fn alignOf(store: *Self, id: Id) -> usize {
    const value = Self.get(store, id)
    if value.*.kind == Kind.void_type || value.*.kind == Kind.noreturn_type { return 1 }
    if value.*.kind == Kind.pointer || value.*.kind == Kind.many_pointer || value.*.kind == Kind.slice { return 8 }
    if value.*.kind == Kind.function { return 8 }
    if value.*.kind == Kind.tuple || value.*.kind == Kind.struct_type || value.*.kind == Kind.enum_type || value.*.kind == Kind.union_type || value.*.kind == Kind.error_set {
        if value.*.flags & FLAG_LAYOUT_COMPLETE == 0 { return 1 }
        return value.*.rhs
    }
    if value.*.kind == Kind.array || value.*.kind == Kind.optional { return Self.alignOf(store, value.*.lhs) }
    if value.*.kind == Kind.vector {
        const size = Self.sizeOf(store, id)
        if size > 16 { return 16 }
        return size
    }
    const size = Self.sizeOf(store, id)
    if size >= 8 { return 8 }
    if size >= 4 { return 4 }
    if size >= 2 { return 2 }
    return 1
}

pub fn isCoercible(store: *Self, from: Id, to: Id) -> bool {
    if from == to { return true }
    const source = Self.get(store, from)
    const target = Self.get(store, to)
    if source.*.kind == Kind.undefined_type { return true }
    if source.*.kind == Kind.null_type && target.*.kind == Kind.optional { return true }
    if target.*.kind == Kind.anytype_type { return true }
    if source.*.kind == Kind.comptime_int_type && (target.*.kind == Kind.integer || target.*.kind == Kind.float) { return true }
    if source.*.kind == Kind.comptime_float_type && target.*.kind == Kind.float { return true }
    if target.*.kind == Kind.optional {
        if source.*.kind == Kind.optional { return Self.isCoercible(store, source.*.lhs, target.*.lhs) }
        return Self.isCoercible(store, from, target.*.lhs)
    }
    if target.*.kind == Kind.error_union {
        if source.*.kind == Kind.error_union { return Self.isCoercible(store, source.*.rhs, target.*.rhs) }
        if source.*.kind == Kind.error_set { return from == target.*.lhs }
        return Self.isCoercible(store, from, target.*.rhs)
    }
    if source.*.kind == Kind.tuple && target.*.kind == Kind.tuple {
        if source.*.extraLength != target.*.extraLength { return false }
        var element_index: usize = 0
        while element_index < source.*.extraLength {
            const source_element = Self.extraAt(store, source.*.extraStart + element_index)
            const target_element = Self.extraAt(store, target.*.extraStart + element_index)
            if !Self.isCoercible(store, source_element, target_element) { return false }
            element_index += 1
        }
        return true
    }
    if source.*.kind == Kind.slice && target.*.kind == Kind.slice {
        const source_const = source.*.flags & FLAG_CONSTANT != 0
        const target_const = target.*.flags & FLAG_CONSTANT != 0
        return source.*.lhs == target.*.lhs && (!source_const || target_const)
    }
    if type_module.isPointer(source) && type_module.isPointer(target) {
        const source_const = source.*.flags & FLAG_CONSTANT != 0
        const target_const = target.*.flags & FLAG_CONSTANT != 0
        return source.*.lhs == target.*.lhs && (!source_const || target_const)
    }
    return false
}

pub fn deinit(store: *Self) -> void {
    vector.Vector.deinit(store.*.fields.*)
    vector.Vector.deinit(store.*.extraIds.*)
    vector.Vector.deinit(store.*.types.*)
    unsafe {
        store.*.freeFn(store.*.allocatorContext, @ptrCast([*]u8, store.*.extraIds), @sizeOf(Vector), @alignOf(Vector))
        store.*.freeFn(store.*.allocatorContext, @ptrCast([*]u8, store.*.types), @sizeOf(Vector), @alignOf(Vector))
        store.*.freeFn(store.*.allocatorContext, @ptrCast([*]u8, store.*.fields), @sizeOf(Vector), @alignOf(Vector))
        store.*.freeFn(store.*.allocatorContext, @ptrCast([*]u8, store.*.primitiveIds), store.*.primitiveCount * @sizeOf(usize), @alignOf(usize))
        store.*.freeFn(store.*.allocatorContext, @ptrCast([*]u8, store.*.internBuckets), store.*.internCapacity * @sizeOf(usize), @alignOf(usize))
    }
}
}
