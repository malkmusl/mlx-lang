const lexer = @import("../../lexer.zin")
const node_module = @import("../../ast/node.zin")
const node_store = @import("../../ast/store.zin")
const type_store = @import("./store.zin")

pub const Buffer = lexer.Buffer
pub const Node = node_module.Node
pub const Tag = node_module.Tag
pub const NodeStore = node_store.Store
pub const Store = type_store.Store
pub const Id = type_store.Id
pub const TypeKind = type_store.Kind
pub const NONE = node_module.NONE

fn textEquals(source: []const u8, tokens: Buffer, token_index: usize, expected: []const u8) -> bool {
    const current = lexer.tokenAt(tokens, token_index)
    var expected_length: usize = 0
    for byte in expected { expected_length += 1 }
    if current.length != expected_length { return false }
    var index: usize = 0
    while index < current.length {
        if source[current.start + index] != expected[index] { return false }
        index += 1
    }
    return true
}

fn parseIntegerName(source: []const u8, tokens: Buffer, token_index: usize) -> (bool, bool, usize) {
    const current = lexer.tokenAt(tokens, token_index)
    if current.length < 2 || current.length > 5 { return -> (false, false, 0) }
    const prefix = source[current.start]
    if prefix != 117 && prefix != 105 { return -> (false, false, 0) }
    var bits: usize = 0
    var index: usize = 1
    while index < current.length {
        const digit = source[current.start + index]
        if digit < 48 || digit > 57 { return -> (false, false, 0) }
        bits = bits * 10 + @intCast(usize, digit) - 48
        index += 1
    }
    if bits == 0 || bits > 4096 { return -> (false, false, 0) }
    return -> (true, prefix == 105, bits)
}

fn digitValue(byte: u8) -> usize {
    if byte >= 48 && byte <= 57 { return @intCast(usize, byte) - 48 }
    if byte >= 97 && byte <= 102 { return @intCast(usize, byte) - 97 + 10 }
    if byte >= 65 && byte <= 70 { return @intCast(usize, byte) - 65 + 10 }
    return 255
}

fn alignForward(value: usize, alignment: usize) -> usize {
    if alignment <= 1 { return value }
    return (value + alignment - 1) & ~(alignment - 1)
}

fn layoutAggregate(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *Store, node_index: usize, kind: TypeKind) -> Id {
    const node = node_store.get(nodes, node_index)
    const aggregate_id = type_store.aggregate(types, kind, node_index, type_store.Copyability.copyable)
    const aggregate_value = type_store.get(types, aggregate_id)
    if aggregate_value.*.flags & type_store.FLAG_LAYOUT_COMPLETE != 0 { return aggregate_id }
    const fields_start = types.*.fields.*.length
    var field_node = node.lhs
    var count: usize = 0
    var size: usize = 0
    var alignment: usize = 1
    var copyability = type_store.Copyability.copyable

    if kind == type_store.Kind.enum_type || kind == type_store.Kind.error_set {
        var backing = type_store.integer(types, false, 16)
        if kind == type_store.Kind.enum_type {
            if node.extra == NONE { return 0 }
            backing = resolve(source, tokens, nodes, types, node.extra)
            if backing == 0 { return 0 }
        }
        size = type_store.sizeOf(types, backing)
        alignment = type_store.alignOf(types, backing)
        while field_node != NONE && count < node.rhs {
            const member = node_store.get(nodes, field_node)
            var field = type_store.Field.{ .nameToken = member.mainToken, .typeId = backing, .offset = 0 }
            if type_store.appendField(types, &field) == NONE { return 0 }
            field_node = member.next
            count += 1
        }
        if count != node.rhs { return 0 }
        type_store.completeAggregate(types, aggregate_id, fields_start, count, size, alignment, copyability)
        return aggregate_id
    }

    while field_node != NONE && count < node.rhs {
        const member = node_store.get(nodes, field_node)
        var field_type = type_store.primitive(types, type_store.Kind.void_type)
        if member.lhs != NONE { field_type = resolve(source, tokens, nodes, types, member.lhs) }
        if field_type == 0 { return 0 }
        const field_alignment = type_store.alignOf(types, field_type)
        const field_size = type_store.sizeOf(types, field_type)
        if field_alignment > alignment { alignment = field_alignment }
        var offset: usize = 0
        if kind == type_store.Kind.struct_type {
            size = alignForward(size, field_alignment)
            offset = size
            size += field_size
        }
        if kind == type_store.Kind.union_type && field_size > size { size = field_size }
        if type_store.get(types, field_type).*.copyability != type_store.Copyability.copyable { copyability = type_store.Copyability.contains_nocopy }
        var field = type_store.Field.{ .nameToken = member.mainToken, .typeId = field_type, .offset = offset }
        if type_store.appendField(types, &field) == NONE { return 0 }
        field_node = member.next
        count += 1
    }
    if count != node.rhs { return 0 }

    if kind == type_store.Kind.union_type && node.extra != NONE {
        const backing = resolve(source, tokens, nodes, types, node.extra)
        if backing == 0 { return 0 }
        const tag_size = type_store.sizeOf(types, backing)
        const tag_alignment = type_store.alignOf(types, backing)
        const payload_offset = alignForward(tag_size, alignment)
        var index: usize = 0
        while index < count {
            type_store.fieldAt(types, fields_start + index).*.offset = payload_offset
            index += 1
        }
        size = payload_offset + size
        if tag_alignment > alignment { alignment = tag_alignment }
    }
    size = alignForward(size, alignment)
    type_store.completeAggregate(types, aggregate_id, fields_start, count, size, alignment, copyability)
    return aggregate_id
}

pub fn parseUnsigned(source: []const u8, tokens: Buffer, token_index: usize) -> usize {
    const current = lexer.tokenAt(tokens, token_index)
    var base: usize = 10
    var index: usize = 0
    if current.length >= 2 && source[current.start] == 48 {
        const prefix = source[current.start + 1]
        if prefix == 120 || prefix == 88 {
            base = 16
            index = 2
        }
        if prefix == 98 || prefix == 66 {
            base = 2
            index = 2
        }
        if prefix == 111 || prefix == 79 {
            base = 8
            index = 2
        }
    }
    var result: usize = 0
    while index < current.length {
        const byte = source[current.start + index]
        if byte != 95 {
            const digit = digitValue(byte)
            if digit >= base { return 0 }
            result = result * base + digit
        }
        index += 1
    }
    return result
}

pub fn resolveName(source: []const u8, tokens: Buffer, token_index: usize, types: *Store) -> Id {
    if textEquals(source, tokens, token_index, "void") { return type_store.primitive(types, type_store.Kind.void_type) }
    if textEquals(source, tokens, token_index, "noreturn") { return type_store.primitive(types, type_store.Kind.noreturn_type) }
    if textEquals(source, tokens, token_index, "bool") { return type_store.primitive(types, type_store.Kind.bool_type) }
    if textEquals(source, tokens, token_index, "type") { return type_store.primitive(types, type_store.Kind.type_type) }
    if textEquals(source, tokens, token_index, "anytype") { return type_store.primitive(types, type_store.Kind.anytype_type) }
    if textEquals(source, tokens, token_index, "anyopaque") { return type_store.primitive(types, type_store.Kind.anyopaque_type) }
    if textEquals(source, tokens, token_index, "comptime_int") { return type_store.primitive(types, type_store.Kind.comptime_int_type) }
    if textEquals(source, tokens, token_index, "comptime_float") { return type_store.primitive(types, type_store.Kind.comptime_float_type) }
    if textEquals(source, tokens, token_index, "usize") { return type_store.sizeInteger(types, false) }
    if textEquals(source, tokens, token_index, "isize") { return type_store.sizeInteger(types, true) }
    if textEquals(source, tokens, token_index, "f32") { return type_store.float(types, 32) }
    if textEquals(source, tokens, token_index, "f64") { return type_store.float(types, 64) }
    const integer = parseIntegerName(source, tokens, token_index)
    if integer.0 { return type_store.integer(types, integer.1, integer.2) }
    return 0
}

pub fn resolve(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *Store, node_index: usize) -> Id {
    if node_index == NONE { return 0 }
    const node = node_store.get(nodes, node_index)
    if node.tag == Tag.named_type { return resolveName(source, tokens, node.mainToken, types) }
    if node.tag == Tag.pointer_type || node.tag == Tag.many_pointer_type {
        const child = resolve(source, tokens, nodes, types, node.lhs)
        if child == 0 { return 0 }
        return type_store.pointer(types, child, node.extra & 1 != 0, node.extra & 2 != 0, node.tag == Tag.many_pointer_type)
    }
    if node.tag == Tag.slice_type {
        const child = resolve(source, tokens, nodes, types, node.lhs)
        if child == 0 { return 0 }
        return type_store.slice(types, child, node.extra & 1 != 0)
    }
    if node.tag == Tag.array_type {
        const child = resolve(source, tokens, nodes, types, node.rhs)
        if child == 0 || node.lhs == NONE { return 0 }
        const length_node = node_store.get(nodes, node.lhs)
        if length_node.tag != Tag.integer_literal { return 0 }
        return type_store.array(types, child, parseUnsigned(source, tokens, length_node.mainToken))
    }
    if node.tag == Tag.optional_type {
        const child = resolve(source, tokens, nodes, types, node.lhs)
        if child == 0 { return 0 }
        return type_store.optional(types, child)
    }
    if node.tag == Tag.error_union_type {
        const payload = resolve(source, tokens, nodes, types, node.rhs)
        if payload == 0 { return 0 }
        var errors = type_store.aggregate(types, type_store.Kind.error_set, node_index, type_store.Copyability.copyable)
        if node.lhs != NONE { errors = resolve(source, tokens, nodes, types, node.lhs) }
        if errors == 0 { return 0 }
        return type_store.errorUnion(types, errors, payload)
    }
    if node.tag == Tag.function_type {
        var parameter = node.lhs
        var count: usize = 0
        const extra_start = types.*.extraIds.*.length
        while parameter != NONE && count < node.rhs {
            const parameter_type = resolve(source, tokens, nodes, types, parameter)
            if parameter_type == 0 { return 0 }
            type_store.appendExtra(types, parameter_type)
            parameter = node_store.get(nodes, parameter).next
            count += 1
        }
        const return_type = resolve(source, tokens, nodes, types, node.extra)
        if return_type == 0 || count != node.rhs { return 0 }
        return type_store.function(types, return_type, extra_start, count)
    }
    if node.tag == Tag.tuple_type {
        var child = node.lhs
        var count: usize = 0
        const extra_start = types.*.extraIds.*.length
        while child != NONE && count < node.rhs {
            const child_type = resolve(source, tokens, nodes, types, child)
            if child_type == 0 { return 0 }
            type_store.appendExtra(types, child_type)
            child = node_store.get(nodes, child).next
            count += 1
        }
        if count != node.rhs { return 0 }
        return type_store.tuple(types, extra_start, count)
    }
    if node.tag == Tag.nocopy_type {
        const base = resolve(source, tokens, nodes, types, node.lhs)
        if base == 0 { return 0 }
        return type_store.noCopy(types, base)
    }
    if node.tag == Tag.struct_type { return layoutAggregate(source, tokens, nodes, types, node_index, type_store.Kind.struct_type) }
    if node.tag == Tag.enum_type { return layoutAggregate(source, tokens, nodes, types, node_index, type_store.Kind.enum_type) }
    if node.tag == Tag.union_type { return layoutAggregate(source, tokens, nodes, types, node_index, type_store.Kind.union_type) }
    if node.tag == Tag.error_set_type { return layoutAggregate(source, tokens, nodes, types, node_index, type_store.Kind.error_set) }
    return 0
}
