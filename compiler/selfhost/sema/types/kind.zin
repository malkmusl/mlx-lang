pub const Kind = enum(u8) {
    invalid,
    void_type,
    noreturn_type,
    bool_type,
    null_type,
    undefined_type,
    comptime_int_type,
    comptime_float_type,
    type_type,
    anytype_type,
    anyopaque_type,
    integer,
    float,
    pointer,
    many_pointer,
    slice,
    array,
    optional,
    error_union,
    function,
    tuple,
    struct_type,
    enum_type,
    union_type,
    error_set,
    vector,
    module
}

pub const Copyability = enum(u8) {
    copyable,
    explicit_nocopy,
    contains_nocopy
}

pub const FLAG_SIGNED: usize = 1
pub const FLAG_CONSTANT: usize = 2
pub const FLAG_VOLATILE: usize = 4
pub const FLAG_OPTIONAL_POINTER: usize = 8
pub const FLAG_PACKED: usize = 16
pub const FLAG_NONEXHAUSTIVE: usize = 32
pub const FLAG_PLATFORM_SIZE: usize = 64
