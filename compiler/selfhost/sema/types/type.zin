const kind_module = @import("./kind.zin")

pub const Kind = kind_module.Kind
pub const Copyability = kind_module.Copyability
pub const FLAG_SIGNED = kind_module.FLAG_SIGNED
pub const FLAG_CONSTANT = kind_module.FLAG_CONSTANT
pub const FLAG_VOLATILE = kind_module.FLAG_VOLATILE
pub const FLAG_PLATFORM_SIZE = kind_module.FLAG_PLATFORM_SIZE
pub const FLAG_LAYOUT_COMPLETE = kind_module.FLAG_LAYOUT_COMPLETE
pub const Id = usize
pub const NONE: Id = 18446744073709551615

// Canonical compact type record. Composite type lists are ranges in the
// TypeStore's extra ID vector; aggregates receive layout records later.
pub const Type = struct {
    kind: Kind
    flags: usize
    bits: usize
    lhs: Id
    rhs: Id
    extraStart: usize
    extraLength: usize
    copyability: Copyability
}

pub fn init(kind: Kind) -> Type {
    return Type.{
        .kind = kind,
        .flags = 0,
        .bits = 0,
        .lhs = NONE,
        .rhs = NONE,
        .extraStart = 0,
        .extraLength = 0,
        .copyability = Copyability.copyable,
    }
}

pub fn same(left: *Type, right: *Type) -> bool {
    return left.*.kind == right.*.kind && left.*.flags == right.*.flags && left.*.bits == right.*.bits && left.*.lhs == right.*.lhs && left.*.rhs == right.*.rhs && left.*.extraStart == right.*.extraStart && left.*.extraLength == right.*.extraLength && left.*.copyability == right.*.copyability
}

pub fn isInteger(value: *Type) -> bool {
    return value.*.kind == Kind.integer || value.*.kind == Kind.comptime_int_type
}

pub fn isFloat(value: *Type) -> bool {
    return value.*.kind == Kind.float || value.*.kind == Kind.comptime_float_type
}

pub fn isPointer(value: *Type) -> bool {
    return value.*.kind == Kind.pointer || value.*.kind == Kind.many_pointer
}

pub fn isComptime(value: *Type) -> bool {
    return value.*.kind == Kind.comptime_int_type || value.*.kind == Kind.comptime_float_type || value.*.kind == Kind.type_type
}

pub fn isCopyable(value: *Type) -> bool {
    return value.*.copyability == Copyability.copyable
}
