pub const Kind = enum(u8) {
    invalid,
    integer,
    boolean,
    type_value,
    null_value
}

pub const Value = struct {
    kind: Kind
    integer: isize
    typeId: usize
}

pub fn invalid() -> Value { return Value.{ .kind = Kind.invalid, .integer = 0, .typeId = 0 } }
pub fn integer(value: isize) -> Value { return Value.{ .kind = Kind.integer, .integer = value, .typeId = 0 } }
pub fn boolean(value: bool) -> Value { return Value.{ .kind = Kind.boolean, .integer = if value { 1 } else { 0 }, .typeId = 0 } }
pub fn typeValue(type_id: usize) -> Value { return Value.{ .kind = Kind.type_value, .integer = 0, .typeId = type_id } }
pub fn nullValue() -> Value { return Value.{ .kind = Kind.null_value, .integer = 0, .typeId = 0 } }
pub fn isValid(value: Value) -> bool { return value.kind != Kind.invalid }
pub fn asBool(value: Value) -> bool { return value.kind == Kind.boolean && value.integer != 0 }
