pub const Kind = enum(u8) {
    invalid,
    integer,
    boolean,
    type_value,
    null_value
}

// Only meaningful when kind == Kind.invalid. Lets a caller that requires a
// comptime-known value (e.g. an explicit enum/error-set discriminant) report
// a diagnostic that names the real cause instead of a generic failure.
pub const Reason = enum(u8) {
    unsupported,
    quota_exceeded
}

pub const Value = struct {
    kind: Kind
    integer: isize
    typeId: usize
    reason: Reason
}

pub fn invalid() -> Value { return Value.{ .kind = Kind.invalid, .integer = 0, .typeId = 0, .reason = Reason.unsupported } }
pub fn quotaExceeded() -> Value { return Value.{ .kind = Kind.invalid, .integer = 0, .typeId = 0, .reason = Reason.quota_exceeded } }
pub fn integer(value: isize) -> Value { return Value.{ .kind = Kind.integer, .integer = value, .typeId = 0, .reason = Reason.unsupported } }
pub fn boolean(value: bool) -> Value { return Value.{ .kind = Kind.boolean, .integer = if value { 1 } else { 0 }, .typeId = 0, .reason = Reason.unsupported } }
pub fn typeValue(type_id: usize) -> Value { return Value.{ .kind = Kind.type_value, .integer = 0, .typeId = type_id, .reason = Reason.unsupported } }
pub fn nullValue() -> Value { return Value.{ .kind = Kind.null_value, .integer = 0, .typeId = 0, .reason = Reason.unsupported } }
pub fn isValid(value: Value) -> bool { return value.kind != Kind.invalid }
pub fn asBool(value: Value) -> bool { return value.kind == Kind.boolean && value.integer != 0 }
