const lexer = @import("../../lexer.zin")
const ast = @import("../../ast/node.zin")
const ast_store = @import("../../ast/store.zin")
const types_module = @import("../../types.zin")
const symbols_module = @import("../../symbols.zin")
const builtins = @import("../../builtins.zin")
const value_module = @import("./value.zin")

pub const Buffer = lexer.Buffer
pub const Node = ast.Node
pub const TokenKind = lexer.Kind
pub const NodeStore = ast_store.Store
pub const TypeStore = types_module.Store
pub const SymbolStore = symbols_module.Store
pub const Scope = symbols_module.Scope
pub const Value = value_module.Value
pub const Kind = value_module.Kind

pub const State = struct {
    branches: usize
    quota: usize
}

fn tokenPointer(source: []const u8, tokens: Buffer, token_index: usize) -> [*]const u8 {
    const token = lexer.tokenAt(tokens, token_index)
    unsafe {
        const source_pointer = @ptrCast([*]const u8, source)
        return @ptrFromInt([*]const u8, @intFromPtr(source_pointer) + token.start)
    }
}

fn typeFromNode(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> usize {
    const direct = types_module.resolve(source, tokens, nodes, types, node_index)
    if direct != 0 { return direct }
    const node = ast_store.get(nodes, node_index)
    if node.tag != ast.Tag.identifier && node.tag != ast.Tag.named_type { return 0 }
    const builtin_type = types_module.resolveName(source, tokens, node.mainToken, types)
    if builtin_type != 0 { return builtin_type }
    const token = lexer.tokenAt(tokens, node.mainToken)
    const found = symbols_module.lookup(scope, tokenPointer(source, tokens, node.mainToken), token.length)
    if !found.0 { return 0 }
    return symbols_module.symbolAt(symbols, found.1).*.valueTypeId
}

fn findField(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, type_id: usize, name_node_index: usize) -> usize {
    const name_node = ast_store.get(nodes, name_node_index)
    if name_node.tag != ast.Tag.string_literal { return types_module.NONE }
    const name_token = lexer.tokenAt(tokens, name_node.mainToken)
    if name_token.length < 2 { return types_module.NONE }
    const expected_length = name_token.length - 2
    const aggregate = types_module.get(types, type_id)
    var index: usize = 0
    while index < aggregate.*.extraLength {
        const field_index = aggregate.*.extraStart + index
        const field = types_module.fieldAt(types, field_index)
        if field.*.nameLength == expected_length {
            var byte: usize = 0
            var matches = true
            while byte < expected_length {
                if field.*.namePointer[byte] != source[name_token.start + 1 + byte] { matches = false }
                byte += 1
            }
            if matches { return field_index }
        }
        index += 1
    }
    return types_module.NONE
}

fn evaluateBuiltin(state: *State, source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node: Node) -> Value {
    const builtin_kind = builtins.lookup(source, tokens, node.mainToken)
    if !builtins.acceptsArity(builtin_kind, node.rhs) { return value_module.invalid() }
    if builtin_kind == builtins.Kind.languageVersion { return value_module.integer(10000) }
    if node.lhs == ast.NONE { return value_module.invalid() }
    const argument_type = typeFromNode(source, tokens, nodes, types, symbols, scope, node.lhs)
    if builtin_kind == builtins.Kind.sizeOf && argument_type != 0 { return value_module.integer(@intCast(isize, types_module.sizeOf(types, argument_type))) }
    if builtin_kind == builtins.Kind.alignOf && argument_type != 0 { return value_module.integer(@intCast(isize, types_module.alignOf(types, argument_type))) }
    if builtin_kind == builtins.Kind.bitSizeOf && argument_type != 0 { return value_module.integer(@intCast(isize, types_module.bitSizeOf(types, argument_type))) }
    if builtin_kind == builtins.Kind.fieldCount && argument_type != 0 { return value_module.integer(@intCast(isize, types_module.get(types, argument_type).*.extraLength)) }
    if (builtin_kind == builtins.Kind.offsetOf || builtin_kind == builtins.Kind.fieldType || builtin_kind == builtins.Kind.hasField) && argument_type != 0 && node.rhs == 2 {
        const second_argument = ast_store.get(nodes, node.lhs).next
        const field_index = findField(source, tokens, nodes, types, argument_type, second_argument)
        if builtin_kind == builtins.Kind.hasField { return value_module.boolean(field_index != types_module.NONE) }
        if field_index == types_module.NONE { return value_module.invalid() }
        const field = types_module.fieldAt(types, field_index)
        if builtin_kind == builtins.Kind.offsetOf { return value_module.integer(@intCast(isize, field.*.offset)) }
        return value_module.typeValue(field.*.typeId)
    }
    if builtin_kind == builtins.Kind.nocopy && argument_type != 0 { return value_module.typeValue(types_module.noCopy(types, argument_type)) }
    if builtin_kind == builtins.Kind.typeInfo && argument_type != 0 { return value_module.typeValue(argument_type) }
    if builtin_kind == builtins.Kind.isInteger || builtin_kind == builtins.Kind.isFloat || builtin_kind == builtins.Kind.isStruct || builtin_kind == builtins.Kind.isEnum || builtin_kind == builtins.Kind.isUnion || builtin_kind == builtins.Kind.isPointer || builtin_kind == builtins.Kind.isSlice || builtin_kind == builtins.Kind.isArray || builtin_kind == builtins.Kind.isOptional || builtin_kind == builtins.Kind.isErrorUnion || builtin_kind == builtins.Kind.isCopyable {
        if argument_type == 0 { return value_module.invalid() }
        const value = types_module.get(types, argument_type)
        var result = false
        if builtin_kind == builtins.Kind.isInteger { result = value.*.kind == types_module.Kind.integer || value.*.kind == types_module.Kind.comptime_int_type }
        if builtin_kind == builtins.Kind.isFloat { result = value.*.kind == types_module.Kind.float || value.*.kind == types_module.Kind.comptime_float_type }
        if builtin_kind == builtins.Kind.isStruct { result = value.*.kind == types_module.Kind.struct_type }
        if builtin_kind == builtins.Kind.isEnum { result = value.*.kind == types_module.Kind.enum_type }
        if builtin_kind == builtins.Kind.isUnion { result = value.*.kind == types_module.Kind.union_type }
        if builtin_kind == builtins.Kind.isPointer { result = value.*.kind == types_module.Kind.pointer || value.*.kind == types_module.Kind.many_pointer }
        if builtin_kind == builtins.Kind.isSlice { result = value.*.kind == types_module.Kind.slice }
        if builtin_kind == builtins.Kind.isArray { result = value.*.kind == types_module.Kind.array }
        if builtin_kind == builtins.Kind.isOptional { result = value.*.kind == types_module.Kind.optional }
        if builtin_kind == builtins.Kind.isErrorUnion { result = value.*.kind == types_module.Kind.error_union }
        if builtin_kind == builtins.Kind.isCopyable { result = value.*.copyability == types_module.Copyability.copyable }
        return value_module.boolean(result)
    }
    return value_module.invalid()
}

fn binary(operator: TokenKind, left: Value, right: Value) -> Value {
    if left.kind == Kind.boolean && right.kind == Kind.boolean {
        if operator == lexer.Kind.ampersand_ampersand { return value_module.boolean(value_module.asBool(left) && value_module.asBool(right)) }
        if operator == lexer.Kind.pipe_pipe { return value_module.boolean(value_module.asBool(left) || value_module.asBool(right)) }
        if operator == lexer.Kind.equal_equal { return value_module.boolean(left.integer == right.integer) }
        if operator == lexer.Kind.bang_equal { return value_module.boolean(left.integer != right.integer) }
    }
    if left.kind != Kind.integer || right.kind != Kind.integer { return value_module.invalid() }
    if operator == lexer.Kind.plus { return value_module.integer(left.integer + right.integer) }
    if operator == lexer.Kind.minus { return value_module.integer(left.integer - right.integer) }
    if operator == lexer.Kind.asterisk { return value_module.integer(left.integer * right.integer) }
    if operator == lexer.Kind.slash {
        if right.integer == 0 { return value_module.invalid() }
        return value_module.integer(left.integer / right.integer)
    }
    if operator == lexer.Kind.percent {
        if right.integer == 0 { return value_module.invalid() }
        return value_module.integer(left.integer % right.integer)
    }
    if operator == lexer.Kind.ampersand { return value_module.integer(left.integer & right.integer) }
    if operator == lexer.Kind.pipe { return value_module.integer(left.integer | right.integer) }
    if operator == lexer.Kind.caret { return value_module.integer(left.integer ^ right.integer) }
    if operator == lexer.Kind.shift_left { return value_module.integer(left.integer << @intCast(usize, right.integer)) }
    if operator == lexer.Kind.shift_right { return value_module.integer(left.integer >> @intCast(usize, right.integer)) }
    if operator == lexer.Kind.equal_equal { return value_module.boolean(left.integer == right.integer) }
    if operator == lexer.Kind.bang_equal { return value_module.boolean(left.integer != right.integer) }
    if operator == lexer.Kind.less { return value_module.boolean(left.integer < right.integer) }
    if operator == lexer.Kind.less_equal { return value_module.boolean(left.integer <= right.integer) }
    if operator == lexer.Kind.greater { return value_module.boolean(left.integer > right.integer) }
    if operator == lexer.Kind.greater_equal { return value_module.boolean(left.integer >= right.integer) }
    return value_module.invalid()
}

fn evaluateNode(state: *State, source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> Value {
    if node_index == ast.NONE || state.*.branches >= state.*.quota { return value_module.invalid() }
    state.*.branches += 1
    const node = ast_store.get(nodes, node_index)
    if node.tag == ast.Tag.integer_literal {
        const value = types_module.parseUnsigned(source, tokens, node.mainToken)
        return value_module.integer(@intCast(isize, value))
    }
    if node.tag == ast.Tag.boolean_literal {
        return value_module.boolean(lexer.tokenAt(tokens, node.mainToken).kind == lexer.Kind.keyword_true)
    }
    if node.tag == ast.Tag.null_literal { return value_module.nullValue() }
    if node.tag == ast.Tag.identifier {
        const token = lexer.tokenAt(tokens, node.mainToken)
        const found = symbols_module.lookup(scope, tokenPointer(source, tokens, node.mainToken), token.length)
        if !found.0 { return value_module.invalid() }
        const symbol = symbols_module.symbolAt(symbols, found.1)
        if symbol.*.comptimeTag == @intCast(u8, @intFromEnum(Kind.integer)) { return value_module.integer(symbol.*.comptimeInteger) }
        if symbol.*.comptimeTag == @intCast(u8, @intFromEnum(Kind.boolean)) { return value_module.boolean(symbol.*.comptimeInteger != 0) }
        if symbol.*.valueTypeId != 0 { return value_module.typeValue(symbol.*.valueTypeId) }
        return value_module.invalid()
    }
    if node.tag == ast.Tag.builtin_call { return evaluateBuiltin(state, source, tokens, nodes, types, symbols, scope, node) }
    if node.tag == ast.Tag.unary_expression {
        const operand = evaluateNode(state, source, tokens, nodes, types, symbols, scope, node.lhs)
        const operator = lexer.tokenAt(tokens, node.mainToken).kind
        if operator == lexer.Kind.minus && operand.kind == Kind.integer { return value_module.integer(0 - operand.integer) }
        if operator == lexer.Kind.tilde && operand.kind == Kind.integer { return value_module.integer(~operand.integer) }
        if operator == lexer.Kind.bang && operand.kind == Kind.boolean { return value_module.boolean(!value_module.asBool(operand)) }
        return value_module.invalid()
    }
    if node.tag == ast.Tag.binary_expression {
        const left = evaluateNode(state, source, tokens, nodes, types, symbols, scope, node.lhs)
        if !value_module.isValid(left) { return left }
        const right = evaluateNode(state, source, tokens, nodes, types, symbols, scope, node.rhs)
        if !value_module.isValid(right) { return right }
        return binary(lexer.tokenAt(tokens, node.mainToken).kind, left, right)
    }
    if node.tag == ast.Tag.if_statement {
        const condition = evaluateNode(state, source, tokens, nodes, types, symbols, scope, node.lhs)
        if condition.kind != Kind.boolean { return value_module.invalid() }
        if value_module.asBool(condition) { return evaluateNode(state, source, tokens, nodes, types, symbols, scope, node.rhs) }
        return evaluateNode(state, source, tokens, nodes, types, symbols, scope, node.extra)
    }
    const type_value = typeFromNode(source, tokens, nodes, types, symbols, scope, node_index)
    if type_value != 0 { return value_module.typeValue(type_value) }
    return value_module.invalid()
}

pub fn evaluate(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, quota: usize) -> Value {
    var state = State.{ .branches = 0, .quota = quota }
    return evaluateNode(&state, source, tokens, nodes, types, symbols, scope, node_index)
}
