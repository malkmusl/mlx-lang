// What is wrong with the calls in a statement that failed: an argument
// count other than the function takes ("`add` takes 3 arguments, 2
// given"), a receiver its method cannot take (a constant for a method
// that changes it, a pointer for one taking the value), a value that does
// not fit where it goes (an argument, the right side of an assignment, a
// field or element of a literal: sema/mismatch.mlx) and operands that do
// not mix. Typing stays quiet about all of them (generic call inference
// probes calls that need not fit), so a failing statement asks here, as it
// asks sema/unknown_names.mlx for unknown names, before its own message
// (MLX-E4001).
const lexer = @import("../lexer.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const declarations = @import("./declarations.mlx")
const diagnostic = @import("../diagnostic.mlx")
const mismatch = @import("./mismatch.mlx")
const predicates = @import("./predicates.mlx")

const Buffer = lexer.Buffer
const NodeStore = ast_store.Store
const TypeStore = types_module.Store
const SymbolStore = symbols_module.Store
const Scope = symbols_module.Scope

// How many calls under `node_index` it reported.
pub fn report(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, return_type: usize) -> usize {
    return walk(source, path, tokens, nodes, types, symbols, scope, node_index, return_type, 0)
}

fn walk(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, return_type: usize, depth: usize) -> usize {
    if node_index == ast.NONE || node_index >= nodes.*.length || depth > 64 { return 0 }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.binary_expression || node.tag == ast.Tag.index_expression {
        var inside = walk(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, depth + 1) + walk(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type, depth + 1)
        if node.tag == ast.Tag.binary_expression && inside == 0 && operands(source, path, tokens, nodes, types, symbols, scope, node_index, return_type) { inside += 1 }
        return inside
    }
    if node.tag == ast.Tag.array_literal || node.tag == ast.Tag.aggregate_literal {
        return members(source, path, tokens, nodes, types, symbols, scope, node_index, return_type, depth)
    }
    if node.tag == ast.Tag.unary_expression || node.tag == ast.Tag.field_expression || node.tag == ast.Tag.unsafe_expression {
        return walk(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, depth + 1)
    }
    if node.tag == ast.Tag.if_statement {
        return walk(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, depth + 1) + walk(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type, depth + 1) + walk(source, path, tokens, nodes, types, symbols, scope, node.extra, return_type, depth + 1)
    }
    if node.tag == ast.Tag.tuple_literal || node.tag == ast.Tag.builtin_call {
        return list(source, path, tokens, nodes, types, symbols, scope, node.lhs, node.rhs, return_type, depth)
    }
    if node.tag != ast.Tag.call_expression { return 0 }
    var found = walk(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, depth + 1) + list(source, path, tokens, nodes, types, symbols, scope, node.rhs, node.extra, return_type, depth)
    const callee = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
    if callee.0 == 0 || types_module.get(types, callee.0).*.kind != types_module.Kind.function { return found }
    const taken = types_module.get(types, callee.0).*.extraLength
    const implicit = receiverCount(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
    if taken < implicit { return found }
    if taken != node.extra + implicit {
        say(source, path, tokens, nodes, node.lhs, taken - implicit, node.extra)
        return found + 1
    }
    if implicit == 1 && receiverMismatch(source, path, tokens, nodes, types, symbols, scope, node.lhs, callee.0, return_type) { found += 1 }
    var argument = node.rhs
    var index: usize = 0
    while argument != ast.NONE && argument < nodes.*.length && index < node.extra {
        const parameter = types_module.extraAt(types, types_module.get(types, callee.0).*.extraStart + implicit + index)
        if given(source, path, tokens, nodes, types, symbols, scope, argument, parameter, return_type) { found += 1 }
        argument = ast_store.Store.get(nodes, argument).next
        index += 1
    }
    return found
}

// A binary expression whose sides do not go together, said: the value on
// the right of an assignment that does not fit the place on its left, or
// operands of types neither of which takes the other.
fn operands(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, return_type: usize) -> bool {
    const node = ast_store.Store.get(nodes, node_index)
    const operator = lexer.tokenAt(tokens, node.mainToken).kind
    const left = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
    const right = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
    if left.0 == 0 || right.0 == 0 || predicates.isPointerStep(types, operator, left.0, right.0) { return false }
    if predicates.isSingleStep(types, operator, left.0, right.0) { return mismatch.unstepped(source, path, tokens, nodes, types, symbols, node_index, left.0) }
    if predicates.isAssignment(operator) { return mismatch.say(source, path, tokens, nodes, types, symbols, node.rhs, right.0, left.0) }
    if predicates.isShift(operator) || predicates.isLogical(operator) { return false }
    return mismatch.mixed(source, path, tokens, nodes, types, symbols, node_index, left.0, right.0)
}

// The value at `value_index` given where `expected` is wanted (an
// argument, a field, an element), said when it does not fit; a generic
// parameter (`anytype`, a type) takes what it is given.
fn given(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, value_index: usize, expected: usize, return_type: usize) -> bool {
    if expected == 0 { return false }
    const expected_kind = types_module.get(types, expected).*.kind
    if expected_kind == types_module.Kind.anytype_type || expected_kind == types_module.Kind.type_type { return false }
    const actual = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, value_index, return_type)
    return mismatch.say(source, path, tokens, nodes, types, symbols, value_index, actual.0, expected)
}

// The elements of an array literal and the fields of a struct literal:
// what is wrong inside them, and integers written out that do not fit
// their element or field.
fn members(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, return_type: usize, depth: usize) -> usize {
    const node = ast_store.Store.get(nodes, node_index)
    var found: usize = 0
    var member = node.lhs
    var count = node.rhs
    var target: usize = 0
    if node.tag == ast.Tag.aggregate_literal {
        member = node.rhs
        count = node.extra
        const prefix = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if prefix.0 == types_module.primitive(types, types_module.Kind.type_type) { target = prefix.1 }
    } else {
        target = declarations.resolveType(source, path, tokens, nodes, types, symbols, scope, node.endToken)
        if target != 0 && node.extra != ast.NONE && ast_store.Store.get(nodes, node.extra).tag == ast.Tag.integer_literal {
            const declared = types_module.parseUnsigned(source, tokens, ast_store.Store.get(nodes, node.extra).mainToken)
            if declared != node.rhs && mismatch.counted(source, path, tokens, nodes, types, symbols, node_index, types_module.array(types, target, declared), node.rhs) { found += 1 }
        }
    }
    var seen: usize = 0
    while member != ast.NONE && member < nodes.*.length && seen < count {
        const value = ast_store.Store.get(nodes, member)
        if node.tag == ast.Tag.aggregate_literal {
            if value.tag == ast.Tag.field_declaration && value.rhs != ast.NONE {
                found += walk(source, path, tokens, nodes, types, symbols, scope, value.rhs, return_type, depth + 1)
                const field = declarations.fieldTypeNamed(source, tokens, types, target, value.mainToken)
                if given(source, path, tokens, nodes, types, symbols, scope, value.rhs, field, return_type) { found += 1 }
            }
        } else {
            found += walk(source, path, tokens, nodes, types, symbols, scope, member, return_type, depth + 1)
            if given(source, path, tokens, nodes, types, symbols, scope, member, target, return_type) { found += 1 }
        }
        member = value.next
        seen += 1
    }
    return found
}

// A receiver its method cannot take, said: a constant (or what a const
// pointer points to) for a method taking a mutable pointer, or a pointer
// for a method taking the value.
fn receiverMismatch(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, callee_index: usize, function_type: usize, return_type: usize) -> bool {
    const callee = ast_store.Store.get(nodes, callee_index)
    const actual = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, callee.lhs, return_type)
    const expected = types_module.extraAt(types, types_module.get(types, function_type).*.extraStart)
    if actual.0 == 0 || types_module.isCoercible(types, actual.0, expected) { return false }
    const expected_kind = types_module.get(types, expected).*.kind
    const actual_kind = types_module.get(types, actual.0).*.kind
    if expected_kind == types_module.Kind.pointer && actual_kind != types_module.Kind.pointer && declarations.isAddressable(nodes, callee.lhs) && !declarations.isMutable(source, path, tokens, nodes, types, symbols, scope, callee.lhs) {
        explain(source, path, tokens, nodes, callee_index, "` changes its receiver, which is a constant here")
        return true
    }
    if actual_kind == types_module.Kind.pointer && expected_kind != types_module.Kind.pointer {
        explain(source, path, tokens, nodes, callee_index, "` takes its receiver by value: call it on what the pointer points to (`.*`)")
        return true
    }
    return false
}

// The first `count` nodes of a chain (call arguments, tuple parts).
fn list(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, first: usize, count: usize, return_type: usize, depth: usize) -> usize {
    var found: usize = 0
    var at = first
    var seen: usize = 0
    while at != ast.NONE && at < nodes.*.length && seen < count {
        found += walk(source, path, tokens, nodes, types, symbols, scope, at, return_type, depth + 1)
        at = ast_store.Store.get(nodes, at).next
        seen += 1
    }
    return found
}

// 1 when the callee is a method called on a value (`list.append(x)`
// passes `list` first), as typing the call decides it.
fn receiverCount(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, callee_index: usize, return_type: usize) -> usize {
    const referenced = declarations.referencedFunctionSymbol(source, path, tokens, nodes, types, symbols, scope, callee_index)
    if !referenced.0 { return 0 }
    const callee = ast_store.Store.get(nodes, callee_index)
    if symbols_module.symbolAt(symbols, referenced.1).*.ownerTypeId == 0 || callee.tag != ast.Tag.field_expression || callee.lhs == ast.NONE { return 0 }
    const base = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, callee.lhs, return_type)
    if base.0 == types_module.primitive(types, types_module.Kind.type_type) { return 0 }
    return 1
}

// "`<name>` takes <taken> argument(s), <given> given" at the callee's name.
fn say(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, callee_index: usize, taken: usize, given: usize) -> void {
    const callee = ast_store.Store.get(nodes, callee_index)
    if callee.mainToken == ast.NONE { return }
    const token = lexer.tokenAt(tokens, callee.mainToken)
    var bytes: [192]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length: usize = 0
    put(text, &length, "`")
    var at = token.start
    while at < token.start + token.length && at < source.length && length < 120 {
        text[length] = source[at]
        length += 1
        at += 1
    }
    put(text, &length, "` takes ")
    putNumber(text, &length, taken)
    if taken == 1 {
        put(text, &length, " argument, ")
    } else {
        put(text, &length, " arguments, ")
    }
    putNumber(text, &length, given)
    put(text, &length, " given")
    const rendered = diagnostic.render(diagnostic.create(diagnostic.Code.type_mismatch, diagnostic.Phase.sema, diagnostic.Severity.failure, 0, token.start, token.start + token.length, bytes[0..length]), path, source)
}

// "`<name><what>" at the callee's name.
fn explain(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, callee_index: usize, what: []const u8) -> void {
    const callee = ast_store.Store.get(nodes, callee_index)
    if callee.mainToken == ast.NONE { return }
    const token = lexer.tokenAt(tokens, callee.mainToken)
    var bytes: [192]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length: usize = 0
    put(text, &length, "`")
    var at = token.start
    while at < token.start + token.length && at < source.length && length < 100 {
        text[length] = source[at]
        length += 1
        at += 1
    }
    put(text, &length, what)
    const rendered = diagnostic.render(diagnostic.create(diagnostic.Code.type_mismatch, diagnostic.Phase.sema, diagnostic.Severity.failure, 0, token.start, token.start + token.length, bytes[0..length]), path, source)
}

fn put(text: [*]u8, length: *usize, what: []const u8) -> void {
    for byte in what {
        text[length.*] = byte
        length.* += 1
    }
}

fn putNumber(text: [*]u8, length: *usize, value: usize) -> void {
    if value >= 10 { putNumber(text, length, value / 10) }
    text[length.*] = @intCast(u8, 48 + value % 10)
    length.* += 1
}
