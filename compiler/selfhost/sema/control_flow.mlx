const lexer = @import("../lexer.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const declarations = @import("./declarations.mlx")
const comptime_module = @import("../comptime.mlx")
const diagnostic = @import("../diagnostic.mlx")
const unknown_names = @import("./unknown_names.mlx")
const call_errors = @import("./call_errors.mlx")
const mismatch = @import("./mismatch.mlx")
const builtins = @import("../builtins.mlx")

pub const Buffer = lexer.Buffer
pub const Node = ast.Node
pub const NodeStore = ast_store.Store
pub const TypeStore = types_module.Store
pub const SymbolStore = symbols_module.Store
pub const Scope = symbols_module.Scope

fn reportCodeAt(source: []const u8, path: []const u8, tokens: Buffer, node: Node, code: diagnostic.Code, message: []const u8) -> void {
    if node.mainToken == ast.NONE { return }
    const token = lexer.tokenAt(tokens, node.mainToken)
    const rendered = diagnostic.render(diagnostic.create(
        code,
        diagnostic.Phase.sema,
        diagnostic.Severity.failure,
        0,
        token.start,
        token.start + token.length,
        message,
    ), path, source)
}

fn reportAt(source: []const u8, path: []const u8, tokens: Buffer, node: Node, message: []const u8) -> void {
    reportCodeAt(source, path, tokens, node, diagnostic.Code.type_mismatch, message)
}

// A part of a statement that did not type (a condition, what a loop goes
// over): the unknown names and the mistaken calls in it, then `message` at
// the part, where the statement alone would say nothing.
fn reportPart(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, return_type: usize, message: []const u8) -> void {
    const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, node_index)
    const miscalled = call_errors.report(source, path, tokens, nodes, types, symbols, scope, node_index, return_type)
    reportAt(source, path, tokens, ast_store.Store.get(nodes, node_index), message)
}

fn conditionMessage(found: usize) -> []const u8 {
    if found == 0 { return "condition type could not be resolved" }
    return "condition is not a bool"
}

fn isVoid(types: *TypeStore, type_id: usize) -> bool {
    return types_module.get(types, type_id).*.kind == types_module.Kind.void_type
}

pub fn allowsFallthrough(types: *TypeStore, return_type: usize) -> bool {
    const value = types_module.get(types, return_type)
    if value.*.kind == types_module.Kind.void_type { return true }
    if value.*.kind == types_module.Kind.error_union { return isVoid(types, value.*.rhs) }
    return false
}

fn bindLocal(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, declaration: usize, return_type: usize) -> usize {
    const node = ast_store.Store.get(nodes, declaration)
    const token = lexer.tokenAt(tokens, node.mainToken)
    const pointer = declarations.tokenPointer(source, tokens, node.mainToken)
    if symbols_module.lookupCurrent(scope, pointer, token.length).0 {
        reportAt(source, path, tokens, node, "this name is declared already in this scope")
        return 1
    }
    var declared_type: usize = 0
    if node.lhs != ast.NONE { declared_type = declarations.resolveType(source, path, tokens, nodes, types, symbols, scope, node.lhs) }
    const inferred = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
    if declared_type == 0 { declared_type = inferred.0 }
    if declared_type == 0 { return 1 }
    var errors: usize = 0
    var ownership_error = false
    if inferred.0 != 0 && types_module.get(types, inferred.0).*.copyability != types_module.Copyability.copyable {
        const initializer = ast_store.Store.get(nodes, node.rhs)
        if initializer.tag == ast.Tag.identifier || initializer.tag == ast.Tag.field_expression {
            reportCodeAt(source, path, tokens, initializer, diagnostic.Code.copy_noncopy, "non-copyable value requires @move")
            const initializer_token = lexer.tokenAt(tokens, initializer.mainToken)
            const copy_help = diagnostic.render(diagnostic.help(diagnostic.Phase.sema, initializer_token.start, initializer_token.start + initializer_token.length, "wrap the value in @move(...) to transfer ownership instead of copying"), path, source)
            errors += 1
            ownership_error = true
        }
    }
    if !ownership_error && mismatch.say(source, path, tokens, nodes, types, symbols, node.rhs, inferred.0, declared_type) { errors += 1 }
    // An initializer that does not type fails the declaration even when its
    // type is written out (it used to pass and end at the backend as
    // "unresolved backend symbol" with no place).
    if node.rhs != ast.NONE && inferred.0 == 0 { errors += 1 }
    var flags: usize = 0
    if node.tag == ast.Tag.constant_declaration { flags = symbols_module.FLAG_CONSTANT }
    var value = symbols_module.create(pointer, token.length, declaration, declared_type, inferred.1, flags, symbols_module.State.initialized)
    if node.tag == ast.Tag.constant_declaration {
        const comptime_value = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, node.rhs, 1000000)
        if comptime_module.isValid(comptime_value) {
            value.comptimeTag = @intCast(u8, @intFromEnum(comptime_value.kind))
            value.comptimeInteger = comptime_value.integer
            if comptime_value.kind == comptime_module.Kind.type_value && value.valueTypeId == 0 { value.valueTypeId = comptime_value.typeId }
        }
    }
    const symbol_index = symbols_module.append(symbols, &value)
    if !symbols_module.define(scope, pointer, token.length, symbol_index) { return 1 }
    return errors
}

fn bindCapture(source: []const u8, path: []const u8, tokens: Buffer, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, capture_node: Node, capture_type: usize) -> usize {
    const token = lexer.tokenAt(tokens, capture_node.mainToken)
    const pointer = declarations.tokenPointer(source, tokens, capture_node.mainToken)
    var value = symbols_module.create(pointer, token.length, capture_node.mainToken, capture_type, 0, symbols_module.FLAG_CONSTANT | symbols_module.FLAG_PARAMETER, symbols_module.State.initialized)
    const symbol_index = symbols_module.append(symbols, &value)
    if !symbols_module.define(scope, pointer, token.length, symbol_index) { return 1 }
    return 0
}

fn analyzeReturn(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node: Node, return_type: usize) -> usize {
    var target = return_type
    const return_value = types_module.get(types, return_type)
    if return_value.*.kind == types_module.Kind.error_union { target = return_value.*.rhs }
    if node.rhs == ast.NONE {
        if isVoid(types, target) { return 0 }
        return 1
    }
    const actual = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
    if actual.0 == 0 { return 1 }
    if types_module.get(types, actual.0).*.copyability != types_module.Copyability.copyable {
        const result_node = ast_store.Store.get(nodes, node.rhs)
        if result_node.tag == ast.Tag.identifier || result_node.tag == ast.Tag.field_expression {
            reportCodeAt(source, path, tokens, result_node, diagnostic.Code.copy_noncopy, "non-copyable return value requires @move")
            const result_token = lexer.tokenAt(tokens, result_node.mainToken)
            const copy_help = diagnostic.render(diagnostic.help(diagnostic.Phase.sema, result_token.start, result_token.start + result_token.length, "wrap the value in @move(...) to transfer ownership instead of copying"), path, source)
            return 1
        }
    }
    if mismatch.say(source, path, tokens, nodes, types, symbols, node.rhs, actual.0, return_type) { return 1 }
    return 0
}

// A condition made of the type predicates (`@isInteger(K)`), of `true`
// and `false`, of bool constants known at compile time and of `!`, `&&`
// and `||` over them: decided here as the lowering decides it. (An
// integer comparison is not: the evaluator knows no unsigned integers.)
fn isPredicateCondition(source: []const u8, tokens: Buffer, nodes: *NodeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> bool {
    if node_index == ast.NONE { return false }
    if isComptimeMarked(tokens, nodes, node_index) { return true }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.boolean_literal || node.tag == ast.Tag.builtin_call { return true }
    if node.tag == ast.Tag.identifier {
        const token = lexer.tokenAt(tokens, node.mainToken)
        const found = symbols_module.lookup(scope, declarations.tokenPointer(source, tokens, node.mainToken), token.length)
        if !found.0 { return false }
        return symbols_module.symbolAt(symbols, found.1).*.comptimeTag == @intCast(u8, @intFromEnum(comptime_module.Kind.boolean))
    }
    if node.tag == ast.Tag.unary_expression { return lexer.tokenAt(tokens, node.mainToken).kind == lexer.Kind.bang && isPredicateCondition(source, tokens, nodes, symbols, scope, node.lhs) }
    if node.tag == ast.Tag.binary_expression {
        const operator = lexer.tokenAt(tokens, node.mainToken).kind
        if operator == lexer.Kind.ampersand_ampersand || operator == lexer.Kind.pipe_pipe {
            return isPredicateCondition(source, tokens, nodes, symbols, scope, node.lhs) && isPredicateCondition(source, tokens, nodes, symbols, scope, node.rhs)
        }
        // `@fieldCount(Context) == 0`, `@sizeOf(T) <= 8`: a comparison of
        // the layout builtins and integer literals (never negative, so
        // the evaluator's signed arithmetic is right).
        if operator == lexer.Kind.equal_equal || operator == lexer.Kind.bang_equal || operator == lexer.Kind.less || operator == lexer.Kind.less_equal || operator == lexer.Kind.greater || operator == lexer.Kind.greater_equal {
            return isLayoutOperand(nodes, node.lhs) && isLayoutOperand(nodes, node.rhs)
        }
    }
    return false
}

// Whether the condition starts with `comptime` (`comptime X`, or
// `comptime builtin.os == builtin.Os.brixos`, where the prefix binds to
// the left operand).
fn isComptimeMarked(tokens: Buffer, nodes: *NodeStore, node_index: usize) -> bool {
    var at = node_index
    while at != ast.NONE {
        const node = ast_store.Store.get(nodes, at)
        if node.tag == ast.Tag.unary_expression { return lexer.tokenAt(tokens, node.mainToken).kind == lexer.Kind.keyword_comptime }
        if node.tag != ast.Tag.binary_expression { return false }
        at = node.lhs
    }
    return false
}

fn isLayoutOperand(nodes: *NodeStore, node_index: usize) -> bool {
    if node_index == ast.NONE { return false }
    const tag = ast_store.Store.get(nodes, node_index).tag
    return tag == ast.Tag.builtin_call || tag == ast.Tag.integer_literal
}

// The loops around the statement being analyzed, by their depth: each
// one's label (its token, NONE without one) and whether a `break` that
// ends it was met. A `while true` no `break` ends never completes: what
// follows it is not reached, and a function may end with it instead of a
// `return` (a dispatcher loop that only ever returns from inside).
const MAX_LOOPS: usize = 64
var loop_labels: [MAX_LOOPS]usize = undefined
var loop_ended: [MAX_LOOPS]bool = undefined
// (The `break` statements analyzed: compared with the `break` words of a
// loop's text, so that one in a place this analysis does not walk keeps
// the loop an ordinary one.)
var breaks_analyzed: usize = 0

fn enterLoop(loop_depth: usize, label_token: usize) -> void {
    if loop_depth < MAX_LOOPS {
        loop_labels[loop_depth] = label_token
        loop_ended[loop_depth] = false
    }
}

fn sameTokenText(source: []const u8, tokens: Buffer, first: usize, second: usize) -> bool {
    const a = lexer.tokenAt(tokens, first)
    const b = lexer.tokenAt(tokens, second)
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if source[a.start + index] != source[b.start + index] { return false }
        index += 1
    }
    return true
}

// A `break` met at `loop_depth`: the loop it ends.
fn noteBreak(source: []const u8, tokens: Buffer, label_token: usize, loop_depth: usize) -> void {
    breaks_analyzed += 1
    var depth = loop_depth
    while depth > 0 {
        depth -= 1
        if depth >= MAX_LOOPS { continue }
        if label_token == ast.NONE || (loop_labels[depth] != ast.NONE && sameTokenText(source, tokens, label_token, loop_labels[depth])) {
            loop_ended[depth] = true
            return
        }
    }
}

fn isTrueLiteral(source: []const u8, tokens: Buffer, nodes: *NodeStore, node_index: usize) -> bool {
    if node_index == ast.NONE { return false }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag != ast.Tag.boolean_literal { return false }
    const token = lexer.tokenAt(tokens, node.mainToken)
    return token.length == 4 && source[token.start] == 116
}

// The `break` words between a block's braces.
fn breakWords(tokens: Buffer, nodes: *NodeStore, block_index: usize) -> usize {
    const block_node = ast_store.Store.get(nodes, block_index)
    if block_node.tag != ast.Tag.block || block_node.endToken == ast.NONE { return 18446744073709551615 }
    var count: usize = 0
    var index = block_node.mainToken
    while index < block_node.endToken {
        if lexer.tokenAt(tokens, index).kind == lexer.Kind.keyword_break { count += 1 }
        index += 1
    }
    return count
}

fn analyzeStatement(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, return_type: usize, loop_depth: usize) -> (usize, bool) {
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.constant_declaration || node.tag == ast.Tag.variable_declaration {
        const errors = bindLocal(source, path, tokens, nodes, types, symbols, scope, node_index, return_type)
        if errors > 0 {
            const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, node.rhs)
            const miscalled = call_errors.report(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
            reportAt(source, path, tokens, node, "invalid local declaration")
        }
        return -> (errors, false)
    }
    if node.tag == ast.Tag.return_statement {
        const errors = analyzeReturn(source, path, tokens, nodes, types, symbols, scope, node, return_type)
        if errors > 0 {
            const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, node.rhs)
            const miscalled = call_errors.report(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
            reportAt(source, path, tokens, node, "return value does not match function type")
        }
        return -> (errors, true)
    }
    if node.tag == ast.Tag.break_statement || node.tag == ast.Tag.continue_statement {
        var errors: usize = 0
        if loop_depth == 0 {
            reportAt(source, path, tokens, node, "`break` and `continue` belong in a loop")
            errors += 1
        }
        if node.tag == ast.Tag.break_statement { noteBreak(source, tokens, node.lhs, loop_depth) }
        if node.tag == ast.Tag.break_statement && node.rhs != ast.NONE && declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type).0 == 0 {
            reportPart(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type, "the value `break` gives could not be resolved")
            errors += 1
        }
        return -> (errors, false)
    }
    if node.tag == ast.Tag.if_statement {
        var errors: usize = 0
        const condition = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        const bool_type = types_module.primitive(types, types_module.Kind.bool_type)
        if condition.0 != bool_type {
            reportPart(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, conditionMessage(condition.0))
            errors += 1
        }
        // A condition known at compile time (`@isInteger(K)` in a generic
        // type's method): only the branch taken is analyzed, as the lowering
        // generates only it (the guide, "Comptime-if pruning").
        const known = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, node.lhs, 1000000)
        if errors == 0 && known.kind != comptime_module.Kind.boolean && isComptimeMarked(tokens, nodes, node.lhs) {
            reportCodeAt(source, path, tokens, ast_store.Store.get(nodes, node.lhs), diagnostic.Code.comptime_runtime_dependency, "the condition marked `comptime` is not known at compile time")
            return -> (1, false)
        }
        if errors == 0 && known.kind == comptime_module.Kind.boolean && isPredicateCondition(source, tokens, nodes, symbols, scope, node.lhs) {
            const chosen = if known.integer != 0 { node.rhs } else { node.extra }
            if chosen == ast.NONE { return -> (0, false) }
            var chosen_scope = symbols_module.initChildScopeFromParent(scope, 8)
            const chosen_node = ast_store.Store.get(nodes, chosen)
            const chosen_flow = if chosen_node.tag == ast.Tag.block { block(source, path, tokens, nodes, types, symbols, &chosen_scope, chosen, return_type, loop_depth) } else { analyzeStatement(source, path, tokens, nodes, types, symbols, &chosen_scope, chosen, return_type, loop_depth) }
            symbols_module.deinitScope(&chosen_scope)
            return chosen_flow
        }
        var then_scope = symbols_module.initChildScopeFromParent(scope, 8)
        const then_flow = block(source, path, tokens, nodes, types, symbols, &then_scope, node.rhs, return_type, loop_depth)
        symbols_module.deinitScope(&then_scope)
        errors += then_flow.0
        var else_returns = false
        if node.extra != ast.NONE {
            var else_scope = symbols_module.initChildScopeFromParent(scope, 8)
            const else_node = ast_store.Store.get(nodes, node.extra)
            var else_flow = if else_node.tag == ast.Tag.block { block(source, path, tokens, nodes, types, symbols, &else_scope, node.extra, return_type, loop_depth) } else { analyzeStatement(source, path, tokens, nodes, types, symbols, &else_scope, node.extra, return_type, loop_depth) }
            errors += else_flow.0
            else_returns = else_flow.1
            symbols_module.deinitScope(&else_scope)
        }
        return -> (errors, node.extra != ast.NONE && then_flow.1 && else_returns)
    }
    if node.tag == ast.Tag.while_statement || node.tag == ast.Tag.inline_while_statement {
        var errors: usize = 0
        const condition = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if condition.0 != types_module.primitive(types, types_module.Kind.bool_type) {
            reportPart(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, conditionMessage(condition.0))
            errors += 1
        }
        var loop_scope = symbols_module.initChildScopeFromParent(scope, 8)
        enterLoop(loop_depth, node.endToken)
        const breaks_before = breaks_analyzed
        const body_flow = block(source, path, tokens, nodes, types, symbols, &loop_scope, node.rhs, return_type, loop_depth + 1)
        errors += body_flow.0
        if node.extra != ast.NONE && declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, &loop_scope, node.extra, return_type).0 == 0 {
            reportPart(source, path, tokens, nodes, types, symbols, &loop_scope, node.extra, return_type, "the loop's continue expression could not be resolved")
            errors += 1
        }
        symbols_module.deinitScope(&loop_scope)
        // (`while true` that no `break` ends: never completes.)
        const endless = errors == 0 && node.tag == ast.Tag.while_statement && loop_depth < MAX_LOOPS && !loop_ended[loop_depth] && isTrueLiteral(source, tokens, nodes, node.lhs) && breaks_analyzed - breaks_before == breakWords(tokens, nodes, node.rhs)
        return -> (errors, endless)
    }
    if node.tag == ast.Tag.for_statement || node.tag == ast.Tag.inline_for_statement {
        var errors: usize = 0
        const iterable = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if iterable.0 == 0 {
            reportPart(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, "what the loop goes over could not be resolved")
            return -> (1, false)
        }
        const iterable_type = types_module.get(types, iterable.0)
        var item_type: usize = 0
        const iterable_node = ast_store.Store.get(nodes, node.lhs)
        if iterable_node.tag == ast.Tag.range_expression { item_type = iterable.0 }
        if iterable_type.*.kind == types_module.Kind.array || iterable_type.*.kind == types_module.Kind.slice { item_type = iterable_type.*.lhs }
        if item_type == 0 {
            reportPart(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, "a for loop goes over an array, a slice or a range")
            errors += 1
        }
        var loop_scope = symbols_module.initChildScopeFromParent(scope, 8)
        const capture = ast_store.Store.get(nodes, node.extra)
        if capture.extra & 1 != 0 {
            if iterable_node.tag == ast.Tag.range_expression { errors += 1 }
            if item_type != 0 { item_type = types_module.pointer(types, item_type, iterable_type.*.flags & types_module.FLAG_CONSTANT != 0, false, false) }
        }
        if item_type != 0 { errors += bindCapture(source, path, tokens, types, symbols, &loop_scope, capture, item_type) }
        if capture.endToken != ast.NONE {
            const index_token = lexer.tokenAt(tokens, capture.endToken)
            const index_pointer = declarations.tokenPointer(source, tokens, capture.endToken)
            var index_symbol = symbols_module.create(index_pointer, index_token.length, node.extra, types_module.sizeInteger(types, false), 0, symbols_module.FLAG_CONSTANT | symbols_module.FLAG_PARAMETER, symbols_module.State.initialized)
            const index_symbol_id = symbols_module.append(symbols, &index_symbol)
            if !symbols_module.define(&loop_scope, index_pointer, index_token.length, index_symbol_id) { errors += 1 }
        }
        enterLoop(loop_depth, node.endToken)
        const body_flow = block(source, path, tokens, nodes, types, symbols, &loop_scope, node.rhs, return_type, loop_depth + 1)
        errors += body_flow.0
        symbols_module.deinitScope(&loop_scope)
        return -> (errors, false)
    }
    if node.tag == ast.Tag.match_statement {
        const subject = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if subject.0 == 0 {
            reportPart(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, "the matched value's type could not be resolved")
            return -> (1, false)
        }
        var errors: usize = 0
        var all_return = node.extra > 0
        var arm_index = node.rhs
        var arm_count: usize = 0
        while arm_index != ast.NONE && arm_count < node.extra {
            const arm = ast_store.Store.get(nodes, arm_index)
            if !declarations.matchPattern(source, path, tokens, nodes, types, symbols, scope, subject.0, arm.lhs, return_type) {
                reportPart(source, path, tokens, nodes, types, symbols, scope, arm.lhs, return_type, "this pattern does not fit the value the match looks at")
                errors += 1
            }
            var arm_scope = symbols_module.initChildScopeFromParent(scope, 8)
            const value = ast_store.Store.get(nodes, arm.rhs)
            const flow = if value.tag == ast.Tag.block { block(source, path, tokens, nodes, types, symbols, &arm_scope, arm.rhs, return_type, loop_depth) } else { analyzeStatement(source, path, tokens, nodes, types, symbols, &arm_scope, arm.rhs, return_type, loop_depth) }
            errors += flow.0
            if !flow.1 { all_return = false }
            symbols_module.deinitScope(&arm_scope)
            arm_index = arm.next
            arm_count += 1
        }
        if arm_count != node.extra { errors += 1 }
        return -> (errors, all_return)
    }
    // A block of its own (`{ ... }`, `unsafe { ... }`, `comptime { ... }`)
    // is a scope of its own: a name declared in it is gone after it, as
    // the lowering has it (a later block may declare the name again).
    if node.tag == ast.Tag.block || node.tag == ast.Tag.unsafe_block || node.tag == ast.Tag.comptime_block {
        var block_scope = symbols_module.initChildScopeFromParent(scope, 8)
        const flow = block(source, path, tokens, nodes, types, symbols, &block_scope, if node.tag == ast.Tag.block { node_index } else { node.lhs }, return_type, loop_depth)
        symbols_module.deinitScope(&block_scope)
        return flow
    }
    // A deferred expression that does not type, and an `errdefer` in a
    // function returning no error union, failed the function with no
    // message of their own.
    if node.tag == ast.Tag.defer_statement || node.tag == ast.Tag.error_defer_statement {
        if node.tag == ast.Tag.error_defer_statement && types_module.get(types, return_type).*.kind != types_module.Kind.error_union {
            reportAt(source, path, tokens, node, "`errdefer` in a function that returns no error union")
            return -> (1, false)
        }
        const child = ast_store.Store.get(nodes, node.lhs)
        if child.tag == ast.Tag.block { return -> (block(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, loop_depth).0, false) }
        if declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type).0 != 0 { return -> (0, false) }
        const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, node.lhs)
        const miscalled = call_errors.report(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        reportAt(source, path, tokens, node, "deferred expression could not be resolved")
        return -> (1, false)
    }
    // @compileError("...") where analysis reaches it (a branch a comptime
    // condition took, or no condition at all): its text is the error.
    if node.tag == ast.Tag.builtin_call && builtins.lookup(source, tokens, node.mainToken) == builtins.Kind.compileError {
        var message: []const u8 = "@compileError"
        if node.lhs != ast.NONE {
            const argument = ast_store.Store.get(nodes, node.lhs)
            const text = lexer.tokenAt(tokens, argument.mainToken)
            if argument.tag == ast.Tag.string_literal && text.length >= 2 { message = source[text.start + 1..text.start + text.length - 1] }
        }
        reportCodeAt(source, path, tokens, node, diagnostic.Code.compile_error_builtin, message)
        return -> (1, true)
    }
    const result = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node_index, return_type)
    if result.0 == 0 {
        const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, node_index)
        const miscalled = call_errors.report(source, path, tokens, nodes, types, symbols, scope, node_index, return_type)
        reportAt(source, path, tokens, node, "expression type could not be resolved")
        return -> (1, false)
    }
    if types_module.get(types, result.0).*.kind == types_module.Kind.error_union {
        reportAt(source, path, tokens, node, "error union value must be handled")
        return -> (1, false)
    }
    return -> (0, false)
}

pub fn block(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, block_index: usize, return_type: usize, loop_depth: usize) -> (usize, bool) {
    const block_node = ast_store.Store.get(nodes, block_index)
    if block_node.tag != ast.Tag.block { return -> (1, false) }
    var errors: usize = 0
    var definitely_returns = false
    var statement = block_node.lhs
    var count: usize = 0
    while statement != ast.NONE && count < block_node.rhs {
        const flow = analyzeStatement(source, path, tokens, nodes, types, symbols, scope, statement, return_type, loop_depth)
        errors += flow.0
        if flow.1 { definitely_returns = true }
        statement = ast_store.Store.get(nodes, statement).next
        count += 1
    }
    return -> (errors, definitely_returns)
}
