const lexer = @import("../lexer.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const declarations = @import("./declarations.mlx")
const comptime_module = @import("../comptime.mlx")
const diagnostic = @import("../diagnostic.mlx")

pub const Buffer = lexer.Buffer
pub const Node = ast.Node
pub const NodeStore = ast_store.Store
pub const TypeStore = types_module.Store
pub const SymbolStore = symbols_module.Store
pub const Scope = symbols_module.Scope

fn reportCodeAt(source: []const u8, path: []const u8, tokens: Buffer, node: Node, code: diagnostic.Code, message: []const u8) -> void {
    if node.mainToken == ast.NONE { return }
    const token = lexer.tokenAt(tokens, node.mainToken)
    const rendered = diagnostic.render(diagnostic.create(
        code,
        diagnostic.Phase.sema,
        diagnostic.Severity.failure,
        0,
        token.start,
        token.start + token.length,
        message,
    ), path, source)
}

fn reportAt(source: []const u8, path: []const u8, tokens: Buffer, node: Node, message: []const u8) -> void {
    reportCodeAt(source, path, tokens, node, diagnostic.Code.type_mismatch, message)
}

fn isVoid(types: *TypeStore, type_id: usize) -> bool {
    return types_module.get(types, type_id).*.kind == types_module.Kind.void_type
}

pub fn allowsFallthrough(types: *TypeStore, return_type: usize) -> bool {
    const value = types_module.get(types, return_type)
    if value.*.kind == types_module.Kind.void_type { return true }
    if value.*.kind == types_module.Kind.error_union { return isVoid(types, value.*.rhs) }
    return false
}

fn bindLocal(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, declaration: usize, return_type: usize) -> usize {
    const node = ast_store.Store.get(nodes, declaration)
    const token = lexer.tokenAt(tokens, node.mainToken)
    const pointer = declarations.tokenPointer(source, tokens, node.mainToken)
    if symbols_module.lookupCurrent(scope, pointer, token.length).0 { return 1 }
    var declared_type: usize = 0
    if node.lhs != ast.NONE { declared_type = declarations.resolveType(source, path, tokens, nodes, types, symbols, scope, node.lhs) }
    const inferred = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
    if declared_type == 0 { declared_type = inferred.0 }
    if declared_type == 0 { return 1 }
    var errors: usize = 0
    var ownership_error = false
    if inferred.0 != 0 && types_module.get(types, inferred.0).*.copyability != types_module.Copyability.copyable {
        const initializer = ast_store.Store.get(nodes, node.rhs)
        if initializer.tag == ast.Tag.identifier || initializer.tag == ast.Tag.field_expression {
            reportCodeAt(source, path, tokens, initializer, diagnostic.Code.copy_noncopy, "non-copyable value requires @move")
            const initializer_token = lexer.tokenAt(tokens, initializer.mainToken)
            const copy_help = diagnostic.render(diagnostic.help(diagnostic.Phase.sema, initializer_token.start, initializer_token.start + initializer_token.length, "wrap the value in @move(...) to transfer ownership instead of copying"), path, source)
            errors += 1
            ownership_error = true
        }
    }
    if !ownership_error && inferred.0 != 0 && !types_module.isCoercible(types, inferred.0, declared_type) { errors += 1 }
    var flags: usize = 0
    if node.tag == ast.Tag.constant_declaration { flags = symbols_module.FLAG_CONSTANT }
    var value = symbols_module.create(pointer, token.length, declaration, declared_type, inferred.1, flags, symbols_module.State.initialized)
    if node.tag == ast.Tag.constant_declaration {
        const comptime_value = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, node.rhs, 1000000)
        if comptime_module.isValid(comptime_value) {
            value.comptimeTag = @intCast(u8, @intFromEnum(comptime_value.kind))
            value.comptimeInteger = comptime_value.integer
            if comptime_value.kind == comptime_module.Kind.type_value && value.valueTypeId == 0 { value.valueTypeId = comptime_value.typeId }
        }
    }
    const symbol_index = symbols_module.append(symbols, &value)
    if !symbols_module.define(scope, pointer, token.length, symbol_index) { return 1 }
    return errors
}

fn bindCapture(source: []const u8, path: []const u8, tokens: Buffer, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, capture_node: Node, capture_type: usize) -> usize {
    const token = lexer.tokenAt(tokens, capture_node.mainToken)
    const pointer = declarations.tokenPointer(source, tokens, capture_node.mainToken)
    var value = symbols_module.create(pointer, token.length, capture_node.mainToken, capture_type, 0, symbols_module.FLAG_CONSTANT | symbols_module.FLAG_PARAMETER, symbols_module.State.initialized)
    const symbol_index = symbols_module.append(symbols, &value)
    if !symbols_module.define(scope, pointer, token.length, symbol_index) { return 1 }
    return 0
}

fn analyzeReturn(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node: Node, return_type: usize) -> usize {
    var target = return_type
    const return_value = types_module.get(types, return_type)
    if return_value.*.kind == types_module.Kind.error_union { target = return_value.*.rhs }
    if node.rhs == ast.NONE {
        if isVoid(types, target) { return 0 }
        return 1
    }
    const actual = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
    if actual.0 == 0 { return 1 }
    if types_module.get(types, actual.0).*.copyability != types_module.Copyability.copyable {
        const result_node = ast_store.Store.get(nodes, node.rhs)
        if result_node.tag == ast.Tag.identifier || result_node.tag == ast.Tag.field_expression {
            reportCodeAt(source, path, tokens, result_node, diagnostic.Code.copy_noncopy, "non-copyable return value requires @move")
            const result_token = lexer.tokenAt(tokens, result_node.mainToken)
            const copy_help = diagnostic.render(diagnostic.help(diagnostic.Phase.sema, result_token.start, result_token.start + result_token.length, "wrap the value in @move(...) to transfer ownership instead of copying"), path, source)
            return 1
        }
    }
    if !types_module.isCoercible(types, actual.0, return_type) { return 1 }
    return 0
}

fn analyzeStatement(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, return_type: usize, loop_depth: usize) -> (usize, bool) {
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.constant_declaration || node.tag == ast.Tag.variable_declaration {
        const errors = bindLocal(source, path, tokens, nodes, types, symbols, scope, node_index, return_type)
        if errors > 0 { reportAt(source, path, tokens, node, "invalid local declaration") }
        return -> (errors, false)
    }
    if node.tag == ast.Tag.return_statement {
        const errors = analyzeReturn(source, path, tokens, nodes, types, symbols, scope, node, return_type)
        if errors > 0 { reportAt(source, path, tokens, node, "return value does not match function type") }
        return -> (errors, true)
    }
    if node.tag == ast.Tag.break_statement || node.tag == ast.Tag.continue_statement {
        var errors = if loop_depth == 0 { 1 } else { 0 }
        if node.tag == ast.Tag.break_statement && node.rhs != ast.NONE && declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type).0 == 0 { errors += 1 }
        return -> (errors, false)
    }
    if node.tag == ast.Tag.if_statement {
        var errors: usize = 0
        const condition = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        const bool_type = types_module.primitive(types, types_module.Kind.bool_type)
        if condition.0 != bool_type { errors += 1 }
        var then_scope = symbols_module.initChildScopeFromParent(scope, 8)
        const then_flow = block(source, path, tokens, nodes, types, symbols, &then_scope, node.rhs, return_type, loop_depth)
        symbols_module.deinitScope(&then_scope)
        errors += then_flow.0
        var else_returns = false
        if node.extra != ast.NONE {
            var else_scope = symbols_module.initChildScopeFromParent(scope, 8)
            const else_node = ast_store.Store.get(nodes, node.extra)
            var else_flow = if else_node.tag == ast.Tag.block { block(source, path, tokens, nodes, types, symbols, &else_scope, node.extra, return_type, loop_depth) } else { analyzeStatement(source, path, tokens, nodes, types, symbols, &else_scope, node.extra, return_type, loop_depth) }
            errors += else_flow.0
            else_returns = else_flow.1
            symbols_module.deinitScope(&else_scope)
        }
        return -> (errors, node.extra != ast.NONE && then_flow.1 && else_returns)
    }
    if node.tag == ast.Tag.while_statement || node.tag == ast.Tag.inline_while_statement {
        var errors: usize = 0
        const condition = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if condition.0 != types_module.primitive(types, types_module.Kind.bool_type) { errors += 1 }
        var loop_scope = symbols_module.initChildScopeFromParent(scope, 8)
        const body_flow = block(source, path, tokens, nodes, types, symbols, &loop_scope, node.rhs, return_type, loop_depth + 1)
        errors += body_flow.0
        if node.extra != ast.NONE && declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, &loop_scope, node.extra, return_type).0 == 0 { errors += 1 }
        symbols_module.deinitScope(&loop_scope)
        return -> (errors, false)
    }
    if node.tag == ast.Tag.for_statement || node.tag == ast.Tag.inline_for_statement {
        var errors: usize = 0
        const iterable = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if iterable.0 == 0 { return -> (1, false) }
        const iterable_type = types_module.get(types, iterable.0)
        var item_type: usize = 0
        const iterable_node = ast_store.Store.get(nodes, node.lhs)
        if iterable_node.tag == ast.Tag.range_expression { item_type = iterable.0 }
        if iterable_type.*.kind == types_module.Kind.array || iterable_type.*.kind == types_module.Kind.slice { item_type = iterable_type.*.lhs }
        if item_type == 0 { errors += 1 }
        var loop_scope = symbols_module.initChildScopeFromParent(scope, 8)
        const capture = ast_store.Store.get(nodes, node.extra)
        if capture.extra & 1 != 0 {
            if iterable_node.tag == ast.Tag.range_expression { errors += 1 }
            if item_type != 0 { item_type = types_module.pointer(types, item_type, iterable_type.*.flags & types_module.FLAG_CONSTANT != 0, false, false) }
        }
        if item_type != 0 { errors += bindCapture(source, path, tokens, types, symbols, &loop_scope, capture, item_type) }
        if capture.endToken != ast.NONE {
            const index_token = lexer.tokenAt(tokens, capture.endToken)
            const index_pointer = declarations.tokenPointer(source, tokens, capture.endToken)
            var index_symbol = symbols_module.create(index_pointer, index_token.length, node.extra, types_module.sizeInteger(types, false), 0, symbols_module.FLAG_CONSTANT | symbols_module.FLAG_PARAMETER, symbols_module.State.initialized)
            const index_symbol_id = symbols_module.append(symbols, &index_symbol)
            if !symbols_module.define(&loop_scope, index_pointer, index_token.length, index_symbol_id) { errors += 1 }
        }
        const body_flow = block(source, path, tokens, nodes, types, symbols, &loop_scope, node.rhs, return_type, loop_depth + 1)
        errors += body_flow.0
        symbols_module.deinitScope(&loop_scope)
        return -> (errors, false)
    }
    if node.tag == ast.Tag.match_statement {
        const subject = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if subject.0 == 0 { return -> (1, false) }
        var errors: usize = 0
        var all_return = node.extra > 0
        var arm_index = node.rhs
        var arm_count: usize = 0
        while arm_index != ast.NONE && arm_count < node.extra {
            const arm = ast_store.Store.get(nodes, arm_index)
            if !declarations.matchPattern(source, path, tokens, nodes, types, symbols, scope, subject.0, arm.lhs, return_type) { errors += 1 }
            var arm_scope = symbols_module.initChildScopeFromParent(scope, 8)
            const value = ast_store.Store.get(nodes, arm.rhs)
            const flow = if value.tag == ast.Tag.block { block(source, path, tokens, nodes, types, symbols, &arm_scope, arm.rhs, return_type, loop_depth) } else { analyzeStatement(source, path, tokens, nodes, types, symbols, &arm_scope, arm.rhs, return_type, loop_depth) }
            errors += flow.0
            if !flow.1 { all_return = false }
            symbols_module.deinitScope(&arm_scope)
            arm_index = arm.next
            arm_count += 1
        }
        if arm_count != node.extra { errors += 1 }
        return -> (errors, all_return)
    }
    if node.tag == ast.Tag.block { return block(source, path, tokens, nodes, types, symbols, scope, node_index, return_type, loop_depth) }
    if node.tag == ast.Tag.unsafe_block || node.tag == ast.Tag.comptime_block {
        return block(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, loop_depth)
    }
    if node.tag == ast.Tag.defer_statement || node.tag == ast.Tag.error_defer_statement {
        if node.tag == ast.Tag.error_defer_statement && types_module.get(types, return_type).*.kind != types_module.Kind.error_union { return -> (1, false) }
        const child = ast_store.Store.get(nodes, node.lhs)
        if child.tag == ast.Tag.block { return -> (block(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type, loop_depth).0, false) }
        return -> (if declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type).0 == 0 { 1 } else { 0 }, false)
    }
    const result = declarations.expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node_index, return_type)
    if result.0 == 0 {
        reportAt(source, path, tokens, node, "expression type could not be resolved")
        return -> (1, false)
    }
    if types_module.get(types, result.0).*.kind == types_module.Kind.error_union {
        reportAt(source, path, tokens, node, "error union value must be handled")
        return -> (1, false)
    }
    return -> (0, false)
}

pub fn block(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, block_index: usize, return_type: usize, loop_depth: usize) -> (usize, bool) {
    const block_node = ast_store.Store.get(nodes, block_index)
    if block_node.tag != ast.Tag.block { return -> (1, false) }
    var errors: usize = 0
    var definitely_returns = false
    var statement = block_node.lhs
    var count: usize = 0
    while statement != ast.NONE && count < block_node.rhs {
        const flow = analyzeStatement(source, path, tokens, nodes, types, symbols, scope, statement, return_type, loop_depth)
        errors += flow.0
        if flow.1 { definitely_returns = true }
        statement = ast_store.Store.get(nodes, statement).next
        count += 1
    }
    return -> (errors, definitely_returns)
}
