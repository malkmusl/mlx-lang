// What was expected and what was given, said where a value does not fit
// its place: "expected `u64`, found `usize`" (MLX-E4001) at an initializer,
// a return value, an argument, the right side of an assignment, a field or
// an element of a literal, "`u8` and `usize` do not mix" at an operator
// between values of types neither of which takes the other, an offset on a
// single-item pointer and an array literal with another number of elements
// than its type. Typing stays quiet about these (sema/call_errors.mlx), so
// statements that fail ask here before their own message, which alone said
// "invalid local declaration" or "expression type could not be resolved".
const lexer = @import("../lexer.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const diagnostic = @import("../diagnostic.mlx")
const literal_fit = @import("./literal_fit.mlx")
const type_names = @import("./type_names.mlx")

const Buffer = lexer.Buffer
const NodeStore = ast_store.Store
const TypeStore = types_module.Store
const SymbolStore = symbols_module.Store

// Whether the value at `node_index`, of type `found`, does not fit
// `expected`; when so, said there (an integer written out that does not
// fit says its range instead).
pub fn say(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, node_index: usize, found: usize, expected: usize) -> bool {
    if found == 0 || expected == 0 || node_index == ast.NONE || node_index >= nodes.*.length { return false }
    if literal_fit.say(source, path, tokens, nodes, types, node_index, expected) { return true }
    if types_module.isCoercible(types, found, expected) { return false }
    var bytes: [256]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length: usize = 0
    literal_fit.put(text, &length, "expected `")
    type_names.write(types, symbols, expected, text, &length, 120)
    literal_fit.put(text, &length, "`, found `")
    type_names.write(types, symbols, found, text, &length, 240)
    literal_fit.put(text, &length, "`")
    report(source, path, tokens, firstToken(tokens, nodes, node_index), bytes[0..length])
    return true
}

// "`<left>` and `<right>` do not mix" at the operator at `node_index`.
pub fn mixed(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, node_index: usize, left: usize, right: usize) -> bool {
    if left == 0 || right == 0 || types_module.isCoercible(types, left, right) || types_module.isCoercible(types, right, left) { return false }
    var bytes: [256]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length: usize = 0
    literal_fit.put(text, &length, "`")
    type_names.write(types, symbols, left, text, &length, 110)
    literal_fit.put(text, &length, "` and `")
    type_names.write(types, symbols, right, text, &length, 230)
    literal_fit.put(text, &length, "` do not mix")
    report(source, path, tokens, ast_store.Store.get(nodes, node_index).mainToken, bytes[0..length])
    return true
}

// "`+` and `-` step only a `[*]T`, not `<pointer>` ..." at the operator at
// `node_index`.
pub fn unstepped(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, node_index: usize, pointer: usize) -> bool {
    var bytes: [256]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length: usize = 0
    literal_fit.put(text, &length, "`+` and `-` step only a `[*]T`, not `")
    type_names.write(types, symbols, pointer, text, &length, 180)
    literal_fit.put(text, &length, "` (@ptrCast it to `[*]u8` to step by bytes)")
    report(source, path, tokens, ast_store.Store.get(nodes, node_index).mainToken, bytes[0..length])
    return true
}

// "`[<length>]<element>` takes <length> elements, <given> given" at the
// array literal at `node_index`.
pub fn counted(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, node_index: usize, array_type: usize, given: usize) -> bool {
    var bytes: [256]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length: usize = 0
    literal_fit.put(text, &length, "`")
    type_names.write(types, symbols, array_type, text, &length, 180)
    literal_fit.put(text, &length, "` takes ")
    literal_fit.putNumber(text, &length, types_module.get(types, array_type).*.bits)
    literal_fit.put(text, &length, " elements, ")
    literal_fit.putNumber(text, &length, given)
    literal_fit.put(text, &length, " given")
    report(source, path, tokens, firstToken(tokens, nodes, node_index), bytes[0..length])
    return true
}

fn report(source: []const u8, path: []const u8, tokens: Buffer, token_index: usize, message: []const u8) -> void {
    if token_index == ast.NONE { return }
    const token = lexer.tokenAt(tokens, token_index)
    const rendered = diagnostic.render(diagnostic.create(diagnostic.Code.type_mismatch, diagnostic.Phase.sema, diagnostic.Severity.failure, 0, token.start, token.start + token.length, message), path, source)
}

// The first token of an expression (a binary expression, a call, a field
// or an element starts where its left side does).
fn firstToken(tokens: Buffer, nodes: *NodeStore, node_index: usize) -> usize {
    var at = node_index
    var steps: usize = 0
    while steps < 64 {
        const node = ast_store.Store.get(nodes, at)
        var left = node.tag == ast.Tag.binary_expression || node.tag == ast.Tag.call_expression || node.tag == ast.Tag.field_expression || node.tag == ast.Tag.index_expression || node.tag == ast.Tag.slice_expression
        if node.tag == ast.Tag.unary_expression {
            const operator = lexer.tokenAt(tokens, node.mainToken).kind
            left = operator == lexer.Kind.dot_asterisk || operator == lexer.Kind.dot_question
        }
        if !left || node.lhs == ast.NONE || node.lhs >= nodes.*.length { return node.mainToken }
        at = node.lhs
        steps += 1
    }
    return ast_store.Store.get(nodes, at).mainToken
}
