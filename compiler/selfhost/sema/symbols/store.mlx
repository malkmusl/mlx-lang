const allocator_module = @import("../../../../std/bootstrap/allocator.mlx")
const mem = @import("../../../../std/bootstrap/mem.mlx")
const symbol_module = @import("./symbol.mlx")

pub const Allocator = allocator_module.Allocator
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn
pub const Symbol = symbol_module.Symbol

pub const Store = struct {
    items: [*]u8
    length: usize
    capacity: usize
    allocatorContext: usize
    resizeFn: ResizeFn
    freeFn: FreeFn

    pub fn init(allocator: Allocator, initial_capacity: usize) -> Self {
        const capacity = if initial_capacity > 0 { initial_capacity } else { 128 }
        return Self.{
            .items = allocator.alloc(capacity * @sizeOf(Symbol), @alignOf(Symbol)).?,
            .length = 0,
            .capacity = capacity,
            .allocatorContext = allocator.context,
            .resizeFn = allocator.resizeFn,
            .freeFn = allocator.freeFn,
        }
    }

    fn ensureCapacity(store: *Self, minimum: usize) -> void {
        if minimum <= store.*.capacity { return }
        var capacity = store.*.capacity * 2
        while capacity < minimum { capacity *= 2 }
        store.*.items = store.*.resizeFn(store.*.allocatorContext, store.*.items, store.*.capacity * @sizeOf(Symbol), capacity * @sizeOf(Symbol), @alignOf(Symbol)).?
        store.*.capacity = capacity
    }

    pub fn get(store: *Self, index: usize) -> *Symbol {
        unsafe { return @ptrFromInt(*Symbol, @intFromPtr(store.*.items) + index * @sizeOf(Symbol)) }
    }

    pub fn append(store: *Self, symbol: *Symbol) -> usize {
        Self.ensureCapacity(store, store.*.length + 1)
        const index = store.*.length
        unsafe { mem.copy(@ptrCast([*]u8, Self.get(store, index)), @ptrCast([*]const u8, symbol), @sizeOf(Symbol)) }
        store.*.length += 1
        return index
    }

    pub fn deinit(store: *Self) -> void {
        store.*.freeFn(store.*.allocatorContext, store.*.items, store.*.capacity * @sizeOf(Symbol), @alignOf(Symbol))
        store.*.length = 0
    }
}
