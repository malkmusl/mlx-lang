const allocator_module = @import("../../../../std/bootstrap/allocator.zin")
const mem = @import("../../../../std/bootstrap/mem.zin")
const symbol_module = @import("./symbol.zin")

pub const Allocator = allocator_module.Allocator
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn
pub const Symbol = symbol_module.Symbol

pub const Store = struct {
    items: [*]u8
    length: usize
    capacity: usize
    allocatorContext: usize
    resizeFn: ResizeFn
    freeFn: FreeFn
}

pub fn init(allocator: Allocator, initial_capacity: usize) -> Store {
    const capacity = if initial_capacity > 0 { initial_capacity } else { 128 }
    return Store.{
        .items = allocator.allocFn(allocator.context, capacity * @sizeOf(Symbol), @alignOf(Symbol)).?,
        .length = 0,
        .capacity = capacity,
        .allocatorContext = allocator.context,
        .resizeFn = allocator.resizeFn,
        .freeFn = allocator.freeFn,
    }
}

fn ensureCapacity(store: *Store, minimum: usize) -> void {
    if minimum <= store.*.capacity { return }
    var capacity = store.*.capacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = store.*.resizeFn(
        store.*.allocatorContext,
        store.*.items,
        store.*.capacity * @sizeOf(Symbol),
        capacity * @sizeOf(Symbol),
        @alignOf(Symbol),
    )
    store.*.items = resized.?
    store.*.capacity = capacity
}

pub fn get(store: *Store, index: usize) -> *Symbol {
    unsafe {
        const address = @intFromPtr(store.*.items) + index * @sizeOf(Symbol)
        return @ptrFromInt(*Symbol, address)
    }
}

pub fn append(store: *Store, symbol: *Symbol) -> usize {
    ensureCapacity(store, store.*.length + 1)
    const index = store.*.length
    unsafe { mem.copy(@ptrCast([*]u8, get(store, index)), @ptrCast([*]const u8, symbol), @sizeOf(Symbol)) }
    store.*.length += 1
    return index
}

pub fn deinit(store: *Store) -> void {
    store.*.freeFn(store.*.allocatorContext, store.*.items, store.*.capacity * @sizeOf(Symbol), @alignOf(Symbol))
    store.*.length = 0
}
