const lexer = @import("../../lexer.zin")
const ast = @import("../../ast/node.zin")
const ast_store = @import("../../ast/store.zin")
const symbol_module = @import("./symbol.zin")
const symbol_store = @import("./store.zin")
const scope_module = @import("./scope.zin")

pub const Buffer = lexer.Buffer
pub const Node = ast.Node
pub const NodeStore = ast_store.Store
pub const SymbolStore = symbol_store.Store
pub const Scope = scope_module.Scope

fn declarationFlags(node: Node) -> usize {
    var flags: usize = 0
    if node.tag == ast.Tag.constant_declaration { flags = flags | symbol_module.FLAG_CONSTANT }
    if node.tag == ast.Tag.function_declaration { flags = flags | symbol_module.FLAG_CONSTANT | symbol_module.FLAG_FUNCTION }
    var syntax_flags = node.extra
    if node.tag == ast.Tag.function_declaration { syntax_flags = node.endToken >> 32 }
    if syntax_flags & 1 != 0 { flags = flags | symbol_module.FLAG_PUBLIC }
    if syntax_flags & 2 != 0 { flags = flags | symbol_module.FLAG_EXPORT }
    if syntax_flags & 16 != 0 { flags = flags | symbol_module.FLAG_EXTERN }
    if syntax_flags & 32 != 0 { flags = flags | symbol_module.FLAG_THREADLOCAL }
    return flags
}

pub fn root(source: []const u8, tokens: Buffer, nodes: *NodeStore, root_index: usize, symbols: *SymbolStore, scope: *Scope) -> usize {
    const root_node = ast_store.get(nodes, root_index)
    if root_node.tag != ast.Tag.root { return 1 }
    var errors: usize = 0
    var declaration = root_node.lhs
    var visited: usize = 0
    while declaration != ast.NONE && visited < root_node.rhs {
        const node = ast_store.get(nodes, declaration)
        if node.tag == ast.Tag.constant_declaration || node.tag == ast.Tag.variable_declaration || node.tag == ast.Tag.function_declaration {
            const name_token = lexer.tokenAt(tokens, node.mainToken)
            unsafe {
                const source_pointer = @ptrCast([*]const u8, source)
                const pointer = @ptrFromInt([*]const u8, @intFromPtr(source_pointer) + name_token.start)
                const duplicate = scope_module.lookupCurrent(scope, pointer, name_token.length).0
                if duplicate { errors += 1 }
                if !duplicate {
                    var value = symbol_module.init(pointer, name_token.length, declaration, 0, 0, declarationFlags(node), symbol_module.State.declared)
                    const symbol_index = symbol_store.append(symbols, &value)
                    if !scope_module.define(scope, pointer, name_token.length, symbol_index) { errors += 1 }
                }
            }
        }
        declaration = node.next
        visited += 1
    }
    return errors
}
