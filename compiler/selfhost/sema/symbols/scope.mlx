const allocator_module = @import("../../../../std/bootstrap/allocator.mlx")
const mem = @import("../../../../std/bootstrap/mem.mlx")

pub const Allocator = allocator_module.Allocator

pub const Entry = struct {
    namePointer: [*]const u8
    nameLength: usize
    nameHash: usize
    symbol: usize
}

// Small lexical scopes stay linear. Larger scopes lazily add an open-addressed
// name index without changing scope ownership, parent traversal, or symbol IDs.
pub const Scope = struct {
    items: [*]u8
    length: usize
    capacity: usize
    buckets: [*]usize
    bucketCapacity: usize
    parentAddress: usize
    depth: usize
    allocator: Allocator

    pub fn initRoot(allocator: Allocator, initial_capacity: usize) -> Self {
        const capacity = if initial_capacity > 0 { initial_capacity } else { 64 }
        unsafe {
            return Self.{
                .items = allocator.alloc(capacity * @sizeOf(Entry), @alignOf(Entry)).?,
                .length = 0,
                .capacity = capacity,
                .buckets = @ptrFromInt([*]usize, 0),
                .bucketCapacity = 0,
                .parentAddress = 0,
                .depth = 0,
                .allocator = allocator,
            }
        }
    }

    pub fn initRootAt(scope: *Self, allocator: Allocator, initial_capacity: usize) -> void {
        const capacity = if initial_capacity > 0 { initial_capacity } else { 64 }
        scope.*.items = allocator.alloc(capacity * @sizeOf(Entry), @alignOf(Entry)).?
        scope.*.length = 0
        scope.*.capacity = capacity
        unsafe { scope.*.buckets = @ptrFromInt([*]usize, 0) }
        scope.*.bucketCapacity = 0
        scope.*.parentAddress = 0
        scope.*.depth = 0
        scope.*.allocator = allocator
    }

    pub fn initChildFromParent(parent: *Self, initial_capacity: usize) -> Self {
        return Self.initChild(parent.*.allocator, parent, initial_capacity)
    }

    pub fn initChild(allocator: Allocator, parent: *Self, initial_capacity: usize) -> Self {
        var result = Self.initRoot(allocator, initial_capacity)
        result.parentAddress = @intFromPtr(parent)
        result.depth = parent.*.depth + 1
        return result
    }

    fn entryAt(scope: *Self, index: usize) -> *Entry {
        unsafe { return @ptrFromInt(*Entry, @intFromPtr(scope.*.items) + index * @sizeOf(Entry)) }
    }

    fn hashName(pointer: [*]const u8, length: usize) -> usize {
        var result: usize = 14695981039346656037
        var index: usize = 0
        while index < length {
            result = (result ^ @intCast(usize, pointer[index])) *% 1099511628211
            index += 1
        }
        return result
    }

    fn sameName(entry: *Entry, pointer: [*]const u8, length: usize, hash: usize) -> bool {
        if entry.*.nameHash != hash || entry.*.nameLength != length { return false }
        var index: usize = 0
        while index < length {
            if entry.*.namePointer[index] != pointer[index] { return false }
            index += 1
        }
        return true
    }

    fn insertIndexed(scope: *Self, index: usize) -> void {
        const entry = Self.entryAt(scope, index)
        var bucket = entry.*.nameHash & (scope.*.bucketCapacity - 1)
        while scope.*.buckets[bucket] != 0 { bucket = (bucket + 1) & (scope.*.bucketCapacity - 1) }
        scope.*.buckets[bucket] = index + 1
    }

    fn rebuildIndex(scope: *Self, capacity: usize) -> bool {
        const memory = scope.*.allocator.alloc(capacity * @sizeOf(usize), @alignOf(usize))
        if memory == null { return false }
        const old_buckets = scope.*.buckets
        const old_capacity = scope.*.bucketCapacity
        unsafe { scope.*.buckets = @ptrCast([*]usize, memory.?) }
        scope.*.bucketCapacity = capacity
        unsafe { mem.zero(@ptrCast([*]u8, scope.*.buckets), capacity * @sizeOf(usize)) }
        var index: usize = 0
        while index < scope.*.length {
            Self.insertIndexed(scope, index)
            index += 1
        }
        if old_capacity != 0 { unsafe { scope.*.allocator.free(@ptrCast([*]u8, old_buckets), old_capacity * @sizeOf(usize), @alignOf(usize)) } }
        return true
    }

    fn indexNewEntry(scope: *Self) -> void {
        if scope.*.bucketCapacity == 0 {
            if scope.*.length >= 8 { const indexed = Self.rebuildIndex(scope, 16) }
            return
        }
        if scope.*.length * 10 >= scope.*.bucketCapacity * 7 {
            if Self.rebuildIndex(scope, scope.*.bucketCapacity * 2) { return }
        }
        Self.insertIndexed(scope, scope.*.length - 1)
    }

    fn ensureCapacity(scope: *Self, minimum: usize) -> void {
        if minimum <= scope.*.capacity { return }
        var capacity = scope.*.capacity * 2
        while capacity < minimum { capacity *= 2 }
        scope.*.items = scope.*.allocator.resize(scope.*.items, scope.*.capacity * @sizeOf(Entry), capacity * @sizeOf(Entry), @alignOf(Entry)).?
        scope.*.capacity = capacity
    }

    pub fn lookupCurrent(scope: *Self, pointer: [*]const u8, length: usize) -> (bool, usize) {
        const hash = Self.hashName(pointer, length)
        if scope.*.bucketCapacity != 0 {
            var bucket = hash & (scope.*.bucketCapacity - 1)
            while scope.*.buckets[bucket] != 0 {
                const entry = Self.entryAt(scope, scope.*.buckets[bucket] - 1)
                if Self.sameName(entry, pointer, length, hash) { return -> (true, entry.*.symbol) }
                bucket = (bucket + 1) & (scope.*.bucketCapacity - 1)
            }
            return -> (false, 0)
        }
        var index: usize = 0
        while index < scope.*.length {
            const entry = Self.entryAt(scope, index)
            if Self.sameName(entry, pointer, length, hash) { return -> (true, entry.*.symbol) }
            index += 1
        }
        return -> (false, 0)
    }

    pub fn define(scope: *Self, pointer: [*]const u8, length: usize, symbol: usize) -> bool {
        if Self.lookupCurrent(scope, pointer, length).0 { return false }
        Self.ensureCapacity(scope, scope.*.length + 1)
        var value = Entry.{ .namePointer = pointer, .nameLength = length, .nameHash = Self.hashName(pointer, length), .symbol = symbol }
        unsafe { mem.copy(@ptrCast([*]u8, Self.entryAt(scope, scope.*.length)), @ptrCast([*]const u8, &value), @sizeOf(Entry)) }
        scope.*.length += 1
        Self.indexNewEntry(scope)
        return true
    }

    pub fn lookup(scope: *Self, pointer: [*]const u8, length: usize) -> (bool, usize) {
        var current = scope
        while true {
            const local = Self.lookupCurrent(current, pointer, length)
            if local.0 { return local }
            if current.*.parentAddress == 0 { return -> (false, 0) }
            unsafe { current = @ptrFromInt(*Self, current.*.parentAddress) }
        }
        return -> (false, 0)
    }

    // Both names differ at exactly one byte position (a single-character typo).
    fn oneSubstitutionAway(a: [*]const u8, a_length: usize, b: [*]const u8, b_length: usize) -> bool {
        if a_length != b_length { return false }
        var differences: usize = 0
        var index: usize = 0
        while index < a_length {
            if a[index] != b[index] { differences += 1 }
            index += 1
        }
        return differences == 1
    }

    // `longer` is `shorter` with exactly one extra byte inserted somewhere
    // (a missing/extra-character typo). Requires longer_length == shorter_length + 1.
    fn oneInsertionAway(shorter: [*]const u8, shorter_length: usize, longer: [*]const u8, longer_length: usize) -> bool {
        var i: usize = 0
        var j: usize = 0
        var skipped = false
        while i < shorter_length {
            if shorter[i] == longer[j] {
                i += 1
                j += 1
            } else if !skipped {
                skipped = true
                j += 1
            } else {
                return false
            }
        }
        return true
    }

    // Cheap "edit distance <= 1" check (substitution, insertion, or
    // deletion) without a Levenshtein matrix, so it needs no allocation.
    fn isCloseMatch(a: [*]const u8, a_length: usize, b: [*]const u8, b_length: usize) -> bool {
        if a_length == b_length { return Self.oneSubstitutionAway(a, a_length, b, b_length) }
        if a_length + 1 == b_length { return Self.oneInsertionAway(a, a_length, b, b_length) }
        if b_length + 1 == a_length { return Self.oneInsertionAway(b, b_length, a, a_length) }
        return false
    }

    // Walks this scope and its parents for a declared name that is a
    // plausible typo of `pointer`/`length`, so an unresolved identifier can
    // suggest the closest in-scope name instead of a bare failure.
    pub fn closestName(scope: *Self, pointer: [*]const u8, length: usize) -> (bool, [*]const u8, usize) {
        var current = scope
        while true {
            var index: usize = 0
            while index < current.*.length {
                const entry = Self.entryAt(current, index)
                if Self.isCloseMatch(pointer, length, entry.*.namePointer, entry.*.nameLength) {
                    return -> (true, entry.*.namePointer, entry.*.nameLength)
                }
                index += 1
            }
            if current.*.parentAddress == 0 { return -> (false, pointer, 0) }
            unsafe { current = @ptrFromInt(*Self, current.*.parentAddress) }
        }
        return -> (false, pointer, 0)
    }

    pub fn deinit(scope: *Self) -> void {
        if scope.*.bucketCapacity != 0 { unsafe { scope.*.allocator.free(@ptrCast([*]u8, scope.*.buckets), scope.*.bucketCapacity * @sizeOf(usize), @alignOf(usize)) } }
        scope.*.allocator.free(scope.*.items, scope.*.capacity * @sizeOf(Entry), @alignOf(Entry))
        scope.*.length = 0
        scope.*.bucketCapacity = 0
    }
}
