const type_module = @import("../types/type.zin")

pub const TypeId = type_module.Id

pub const State = enum(u8) {
    declared,
    initializing,
    initialized,
    moved,
    partially_moved
}

pub const FLAG_CONSTANT: usize = 1
pub const FLAG_FUNCTION: usize = 2
pub const FLAG_PUBLIC: usize = 4
pub const FLAG_EXPORT: usize = 8
pub const FLAG_EXTERN: usize = 16
pub const FLAG_THREADLOCAL: usize = 32
pub const FLAG_PARAMETER: usize = 64

pub const Symbol = struct {
    namePointer: [*]const u8
    nameLength: usize
    declaration: usize
    typeId: TypeId
    valueTypeId: TypeId
    flags: usize
    state: State
}

pub fn init(name_pointer: [*]const u8, name_length: usize, declaration: usize, type_id: TypeId, value_type_id: TypeId, flags: usize, state: State) -> Symbol {
    return Symbol.{
        .namePointer = name_pointer,
        .nameLength = name_length,
        .declaration = declaration,
        .typeId = type_id,
        .valueTypeId = value_type_id,
        .flags = flags,
        .state = state,
    }
}

pub fn isConstant(symbol: *Symbol) -> bool { return symbol.*.flags & FLAG_CONSTANT != 0 }
pub fn isFunction(symbol: *Symbol) -> bool { return symbol.*.flags & FLAG_FUNCTION != 0 }
pub fn isInitialized(symbol: *Symbol) -> bool { return symbol.*.state == State.initialized }
pub fn markMoved(symbol: *Symbol) -> bool {
    if symbol.*.state != State.initialized { return false }
    symbol.*.state = State.moved
    return true
}
