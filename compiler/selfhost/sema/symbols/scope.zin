const allocator_module = @import("../../../../std/bootstrap/allocator.zin")
const mem = @import("../../../../std/bootstrap/mem.zin")

pub const Allocator = allocator_module.Allocator
pub const AllocFn = allocator_module.AllocFn
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn

pub const Entry = struct {
    namePointer: [*]const u8
    nameLength: usize
    symbol: usize
}

// A bootstrap scope deliberately uses a compact linear table. It keeps scope
// ownership and parent traversal simple; Zin1 can replace the lookup policy
// without changing symbol IDs or semantic callers.
pub const Scope = struct {
    items: [*]u8
    length: usize
    capacity: usize
    parentAddress: usize
    depth: usize
    allocatorContext: usize
    allocFn: AllocFn
    resizeFn: ResizeFn
    freeFn: FreeFn
}

pub fn initRoot(allocator: Allocator, initial_capacity: usize) -> Scope {
    const capacity = if initial_capacity > 0 { initial_capacity } else { 64 }
    return Scope.{
        .items = allocator.allocFn(allocator.context, capacity * @sizeOf(Entry), @alignOf(Entry)).?,
        .length = 0,
        .capacity = capacity,
        .parentAddress = 0,
        .depth = 0,
        .allocatorContext = allocator.context,
        .allocFn = allocator.allocFn,
        .resizeFn = allocator.resizeFn,
        .freeFn = allocator.freeFn,
    }
}

pub fn initChildFromParent(parent: *Scope, initial_capacity: usize) -> Scope {
    return initChild(Allocator.{
        .context = parent.*.allocatorContext,
        .allocFn = parent.*.allocFn,
        .resizeFn = parent.*.resizeFn,
        .freeFn = parent.*.freeFn,
    }, parent, initial_capacity)
}

pub fn initChild(allocator: Allocator, parent: *Scope, initial_capacity: usize) -> Scope {
    var result = initRoot(allocator, initial_capacity)
    result.parentAddress = @intFromPtr(parent)
    result.depth = parent.*.depth + 1
    return result
}

fn entryAt(scope: *Scope, index: usize) -> *Entry {
    unsafe {
        const address = @intFromPtr(scope.*.items) + index * @sizeOf(Entry)
        return @ptrFromInt(*Entry, address)
    }
}

fn sameName(entry: *Entry, pointer: [*]const u8, length: usize) -> bool {
    if entry.*.nameLength != length { return false }
    var index: usize = 0
    while index < length {
        if entry.*.namePointer[index] != pointer[index] { return false }
        index += 1
    }
    return true
}

fn ensureCapacity(scope: *Scope, minimum: usize) -> void {
    if minimum <= scope.*.capacity { return }
    var capacity = scope.*.capacity * 2
    while capacity < minimum { capacity *= 2 }
    const resized = scope.*.resizeFn(
        scope.*.allocatorContext,
        scope.*.items,
        scope.*.capacity * @sizeOf(Entry),
        capacity * @sizeOf(Entry),
        @alignOf(Entry),
    )
    scope.*.items = resized.?
    scope.*.capacity = capacity
}

pub fn lookupCurrent(scope: *Scope, pointer: [*]const u8, length: usize) -> (bool, usize) {
    var index: usize = 0
    while index < scope.*.length {
        const entry = entryAt(scope, index)
        if sameName(entry, pointer, length) { return -> (true, entry.*.symbol) }
        index += 1
    }
    return -> (false, 0)
}

pub fn define(scope: *Scope, pointer: [*]const u8, length: usize, symbol: usize) -> bool {
    if lookupCurrent(scope, pointer, length).0 { return false }
    ensureCapacity(scope, scope.*.length + 1)
    var value = Entry.{ .namePointer = pointer, .nameLength = length, .symbol = symbol }
    unsafe { mem.copy(@ptrCast([*]u8, entryAt(scope, scope.*.length)), @ptrCast([*]const u8, &value), @sizeOf(Entry)) }
    scope.*.length += 1
    return true
}

pub fn lookup(scope: *Scope, pointer: [*]const u8, length: usize) -> (bool, usize) {
    var current = scope
    while true {
        const local = lookupCurrent(current, pointer, length)
        if local.0 { return local }
        if current.*.parentAddress == 0 { return -> (false, 0) }
        unsafe { current = @ptrFromInt(*Scope, current.*.parentAddress) }
    }
    return -> (false, 0)
}

pub fn deinit(scope: *Scope) -> void {
    scope.*.freeFn(scope.*.allocatorContext, scope.*.items, scope.*.capacity * @sizeOf(Entry), @alignOf(Entry))
    scope.*.length = 0
}
