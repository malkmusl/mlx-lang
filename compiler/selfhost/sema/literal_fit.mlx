// Whether an integer written out fits the integer type it is given to. A
// comptime integer coerces only when the type can hold it exactly
// (spec/00-language/types.xml, Conversions), but typing took any literal
// for any integer type, so `var small: u8 = 300` compiled, kept the low
// bits and trapped on the next overflow check, and `return -1` from a
// `-> u32` function wrapped. Declarations, assignments, call arguments,
// returns and the fields and elements of literals ask `misfit`; the
// statement that fails says why with `say` ("`300` does not fit in `u8`
// (0 to 255)", MLX-E4001).
const lexer = @import("../lexer.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const diagnostic = @import("../diagnostic.mlx")

const Buffer = lexer.Buffer
const NodeStore = ast_store.Store
const TypeStore = types_module.Store

// The integer written at `node_index`, a literal or a negated one:
// (written, negative, magnitude).
fn written(source: []const u8, tokens: Buffer, nodes: *NodeStore, node_index: usize) -> (bool, bool, usize) {
    if node_index == ast.NONE || node_index >= nodes.*.length { return -> (false, false, 0) }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.integer_literal { return -> (true, false, types_module.parseUnsigned(source, tokens, node.mainToken)) }
    if node.tag != ast.Tag.unary_expression || lexer.tokenAt(tokens, node.mainToken).kind != lexer.Kind.minus { return -> (false, false, 0) }
    if node.lhs == ast.NONE || node.lhs >= nodes.*.length { return -> (false, false, 0) }
    const operand = ast_store.Store.get(nodes, node.lhs)
    if operand.tag != ast.Tag.integer_literal { return -> (false, false, 0) }
    return -> (true, true, types_module.parseUnsigned(source, tokens, operand.mainToken))
}

// The integer type a value given to `target` must fit: `target` itself, or
// what an optional or an error union holds (0: none, or wider than 64
// bits).
fn integerTarget(types: *TypeStore, target: usize) -> usize {
    if target == 0 { return 0 }
    var value = types_module.get(types, target)
    var id = target
    if value.*.kind == types_module.Kind.optional {
        id = value.*.lhs
        value = types_module.get(types, id)
    } else if value.*.kind == types_module.Kind.error_union {
        id = value.*.rhs
        value = types_module.get(types, id)
    }
    if value.*.kind != types_module.Kind.integer || value.*.bits > 64 || value.*.bits == 0 { return 0 }
    return id
}

// 2 to the power `bits` less one, for `bits` up to 64.
fn largest(bits: usize) -> usize {
    var value: usize = 0
    var at: usize = 0
    while at < bits {
        value = value * 2 + 1
        at += 1
    }
    return value
}

// Whether the integer written at `node_index` does not fit `target`.
pub fn misfit(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, node_index: usize, target: usize) -> bool {
    const value = written(source, tokens, nodes, node_index)
    if !value.0 { return false }
    const integer = integerTarget(types, target)
    if integer == 0 { return false }
    const bits = types_module.get(types, integer).*.bits
    if types_module.get(types, integer).*.flags & types_module.FLAG_SIGNED == 0 {
        if value.1 { return value.2 != 0 }
        return value.2 > largest(bits)
    }
    // A signed type holds 2^(bits-1) below zero and one less above it.
    const half = largest(bits - 1)
    if value.1 { return value.2 > half + 1 }
    return value.2 > half
}

// "`<written>` does not fit in `<type>` (<least> to <most>)" at the
// integer written at `node_index`, when it does not fit `target`.
pub fn say(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, node_index: usize, target: usize) -> bool {
    if !misfit(source, tokens, nodes, types, node_index, target) { return false }
    const node = ast_store.Store.get(nodes, node_index)
    const first = lexer.tokenAt(tokens, node.mainToken)
    var last = first
    if node.tag == ast.Tag.unary_expression { last = lexer.tokenAt(tokens, ast_store.Store.get(nodes, node.lhs).mainToken) }
    const integer = types_module.get(types, integerTarget(types, target))
    const signed = integer.*.flags & types_module.FLAG_SIGNED != 0
    var bytes: [192]u8 = undefined
    var text: [*]u8 = undefined
    unsafe { text = @ptrCast([*]u8, &bytes) }
    var length: usize = 0
    put(text, &length, "`")
    var at = first.start
    while at < last.start + last.length && at < source.length && length < 80 {
        text[length] = source[at]
        length += 1
        at += 1
    }
    put(text, &length, "` does not fit in `")
    if signed {
        put(text, &length, "i")
    } else {
        put(text, &length, "u")
    }
    if integer.*.flags & types_module.FLAG_PLATFORM_SIZE != 0 {
        put(text, &length, "size")
    } else {
        putNumber(text, &length, integer.*.bits)
    }
    put(text, &length, "` (")
    if signed {
        put(text, &length, "-")
        putNumber(text, &length, largest(integer.*.bits - 1) + 1)
        put(text, &length, " to ")
        putNumber(text, &length, largest(integer.*.bits - 1))
    } else {
        put(text, &length, "0 to ")
        putNumber(text, &length, largest(integer.*.bits))
    }
    put(text, &length, ")")
    const rendered = diagnostic.render(diagnostic.create(diagnostic.Code.type_mismatch, diagnostic.Phase.sema, diagnostic.Severity.failure, 0, first.start, last.start + last.length, bytes[0..length]), path, source)
    return true
}

pub fn put(text: [*]u8, length: *usize, what: []const u8) -> void {
    for byte in what {
        text[length.*] = byte
        length.* += 1
    }
}

pub fn putNumber(text: [*]u8, length: *usize, value: usize) -> void {
    if value >= 10 { putNumber(text, length, value / 10) }
    text[length.*] = @intCast(u8, 48 + value % 10)
    length.* += 1
}
