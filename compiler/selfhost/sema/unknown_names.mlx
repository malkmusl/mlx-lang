// The names in an expression that did not type and that nothing declares.
// Typing an expression stays quiet about a name it cannot find (generic
// call inference probes names that need not exist), so a statement that
// fails asks here which of its names are unknown and reports each one
// (MLX-E3001, with the closest name in scope as help), before the
// statement's own message.
const lexer = @import("../lexer.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const builtins = @import("../builtins.mlx")
const diagnostic = @import("../diagnostic.mlx")

const Buffer = lexer.Buffer
const NodeStore = ast_store.Store
const TypeStore = types_module.Store
const Scope = symbols_module.Scope

// How many unknown names (and builtins) under `node_index` it reported.
pub fn report(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, scope: *Scope, node_index: usize) -> usize {
    return walk(source, path, tokens, nodes, types, scope, node_index, 0)
}

fn walk(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, scope: *Scope, node_index: usize, depth: usize) -> usize {
    if node_index == ast.NONE || node_index >= nodes.*.length || depth > 64 { return 0 }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.identifier { return identifier(source, path, tokens, types, scope, node) }
    if node.tag == ast.Tag.binary_expression || node.tag == ast.Tag.index_expression {
        return walk(source, path, tokens, nodes, types, scope, node.lhs, depth + 1) + walk(source, path, tokens, nodes, types, scope, node.rhs, depth + 1)
    }
    if node.tag == ast.Tag.unary_expression || node.tag == ast.Tag.field_expression {
        return walk(source, path, tokens, nodes, types, scope, node.lhs, depth + 1)
    }
    if node.tag == ast.Tag.if_statement {
        return walk(source, path, tokens, nodes, types, scope, node.lhs, depth + 1) + walk(source, path, tokens, nodes, types, scope, node.rhs, depth + 1) + walk(source, path, tokens, nodes, types, scope, node.extra, depth + 1)
    }
    if node.tag == ast.Tag.call_expression {
        return walk(source, path, tokens, nodes, types, scope, node.lhs, depth + 1) + list(source, path, tokens, nodes, types, scope, node.rhs, node.extra, depth)
    }
    if node.tag == ast.Tag.tuple_literal { return list(source, path, tokens, nodes, types, scope, node.lhs, node.rhs, depth) }
    if node.tag == ast.Tag.builtin_call {
        var found: usize = 0
        if builtins.lookup(source, tokens, node.mainToken) == builtins.Kind.invalid {
            say(source, path, tokens, node.mainToken, "unknown builtin ")
            found = 1
        }
        return found + list(source, path, tokens, nodes, types, scope, node.lhs, node.rhs, depth)
    }
    return 0
}

// The first `count` nodes of a chain (call arguments, tuple parts).
fn list(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, scope: *Scope, first: usize, count: usize, depth: usize) -> usize {
    var found: usize = 0
    var at = first
    var seen: usize = 0
    while at != ast.NONE && at < nodes.*.length && seen < count {
        found += walk(source, path, tokens, nodes, types, scope, at, depth + 1)
        at = ast_store.Store.get(nodes, at).next
        seen += 1
    }
    return found
}

fn identifier(source: []const u8, path: []const u8, tokens: Buffer, types: *TypeStore, scope: *Scope, node: ast.Node) -> usize {
    if node.mainToken == ast.NONE { return 0 }
    const token = lexer.tokenAt(tokens, node.mainToken)
    if token.length == 0 || token.start + token.length > source.length { return 0 }
    if token.length == 1 && source[token.start] == 95 { return 0 }
    const name = namePointer(source, token.start)
    if symbols_module.lookup(scope, name, token.length).0 { return 0 }
    if types_module.resolveName(source, tokens, node.mainToken, types) != 0 { return 0 }
    if declaredBefore(source, token.start, token.length) { return 0 }
    say(source, path, tokens, node.mainToken, "unknown name ")
    const suggestion = symbols_module.closestName(scope, name, token.length)
    if suggestion.0 {
        const rendered = diagnostic.renderSuggestion(path, source, token.start, suggestion.1, suggestion.2)
    }
    return 1
}

// Whether a `const` or `var` above names it: a local whose declaration
// failed (and was reported) is not in scope, but it is not unknown.
fn declaredBefore(source: []const u8, start: usize, length: usize) -> bool {
    var at: usize = 0
    while at + 4 + length <= start {
        var keyword: usize = 0
        if source[at] == 99 && at + 6 + length <= start && sameText(source, at, "const ") { keyword = 6 }
        if source[at] == 118 && sameText(source, at, "var ") { keyword = 4 }
        if keyword != 0 && (at == 0 || !isNameByte(source[at - 1])) {
            var same = true
            var index: usize = 0
            while index < length {
                if source[at + keyword + index] != source[start + index] { same = false }
                index += 1
            }
            const after = at + keyword + length
            if same && (after >= source.length || !isNameByte(source[after])) { return true }
        }
        at += 1
    }
    return false
}

fn sameText(source: []const u8, at: usize, text: []const u8) -> bool {
    if at + text.length > source.length { return false }
    var index: usize = 0
    while index < text.length {
        if source[at + index] != text[index] { return false }
        index += 1
    }
    return true
}

fn isNameByte(byte: u8) -> bool {
    return (byte >= 97 && byte <= 122) || (byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57) || byte == 95
}

fn namePointer(source: []const u8, start: usize) -> [*]const u8 {
    unsafe {
        const source_pointer = @ptrCast([*]const u8, source)
        return @ptrFromInt([*]const u8, @intFromPtr(source_pointer) + start)
    }
}

// "<what>`<the token>`" at the token.
fn say(source: []const u8, path: []const u8, tokens: Buffer, token_index: usize, what: []const u8) -> void {
    const token = lexer.tokenAt(tokens, token_index)
    var text: [160]u8 = undefined
    var length: usize = 0
    for byte in what {
        text[length] = byte
        length += 1
    }
    text[length] = 96
    length += 1
    var at = token.start
    while at < token.start + token.length && at < source.length && length < 150 {
        text[length] = source[at]
        length += 1
        at += 1
    }
    text[length] = 96
    length += 1
    const rendered = diagnostic.render(diagnostic.create(diagnostic.Code.unknown_identifier, diagnostic.Phase.sema, diagnostic.Severity.failure, 0, token.start, token.start + token.length, text[0..length]), path, source)
}
