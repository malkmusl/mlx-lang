const lexer = @import("../lexer.zin")
const ast = @import("../ast/node.zin")
const ast_store = @import("../ast/store.zin")
const types_module = @import("../types.zin")
const symbols_module = @import("../symbols.zin")
const declarations = @import("./declarations.zin")
const flow = @import("./control_flow.zin")

pub const Buffer = lexer.Buffer
pub const NodeStore = ast_store.Store
pub const TypeStore = types_module.Store
pub const SymbolStore = symbols_module.Store
pub const Scope = symbols_module.Scope

fn analyzeFunction(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, root_scope: *Scope, declaration: usize) -> usize {
    const node = ast_store.get(nodes, declaration)
    const name_token = lexer.tokenAt(tokens, node.mainToken)
    const found = symbols_module.lookup(root_scope, declarations.tokenPointer(source, tokens, node.mainToken), name_token.length)
    if !found.0 { return 1 }
    const function_symbol = symbols_module.symbolAt(symbols, found.1)
    const function_type = types_module.get(types, function_symbol.*.typeId)
    if function_type.*.kind != types_module.Kind.function { return 1 }
    var function_scope = symbols_module.initChildScopeFromParent(root_scope, function_type.*.extraLength + 8)
    var errors: usize = 0
    var parameter = node.lhs
    var index: usize = 0
    while parameter != ast.NONE && index < function_type.*.extraLength {
        const parameter_node = ast_store.get(nodes, parameter)
        const token = lexer.tokenAt(tokens, parameter_node.mainToken)
        const pointer = declarations.tokenPointer(source, tokens, parameter_node.mainToken)
        const parameter_type = types_module.extraAt(types, function_type.*.extraStart + index)
        var value = symbols_module.create(pointer, token.length, parameter, parameter_type, 0, symbols_module.FLAG_CONSTANT | symbols_module.FLAG_PARAMETER, symbols_module.State.initialized)
        const symbol_id = symbols_module.append(symbols, &value)
        if !symbols_module.define(&function_scope, pointer, token.length, symbol_id) { errors += 1 }
        parameter = parameter_node.next
        index += 1
    }
    const body_flow = flow.block(source, tokens, nodes, types, symbols, &function_scope, node.rhs, function_type.*.lhs, 0)
    errors += body_flow.0
    if !body_flow.1 && !flow.allowsFallthrough(types, function_type.*.lhs) { errors += 1 }
    symbols_module.deinitScope(&function_scope)
    return errors
}

pub fn root(source: []const u8, tokens: Buffer, nodes: *NodeStore, root_index: usize, types: *TypeStore, symbols: *SymbolStore, root_scope: *Scope) -> usize {
    const root_node = ast_store.get(nodes, root_index)
    var errors: usize = 0
    var declaration = root_node.lhs
    var count: usize = 0
    while declaration != ast.NONE && count < root_node.rhs {
        const node = ast_store.get(nodes, declaration)
        if node.tag == ast.Tag.function_declaration && node.rhs != ast.NONE {
            errors += analyzeFunction(source, tokens, nodes, types, symbols, root_scope, declaration)
        }
        declaration = node.next
        count += 1
    }
    return errors
}
