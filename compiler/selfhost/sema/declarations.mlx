const lexer = @import("../lexer.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const builtins = @import("../builtins.mlx")
const atomics = @import("./builtins/atomics.mlx")
const atomic_arguments = @import("./builtins/atomic_arguments.mlx")
const comptime_module = @import("../comptime.mlx")
const module_model = @import("../modules/model.mlx")
const diagnostic = @import("../diagnostic.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")
const predicates = @import("./predicates.mlx")
const aggregate_names = @import("./aggregate_names.mlx")
const literal_fit = @import("./literal_fit.mlx")
const mismatch = @import("./mismatch.mlx")
const unknown_names = @import("./unknown_names.mlx")

pub const Buffer = lexer.Buffer
pub const Node = ast.Node
pub const NodeStore = ast_store.Store
pub const TypeStore = types_module.Store
pub const SymbolStore = symbols_module.Store
pub const Scope = symbols_module.Scope
pub const TypeId = types_module.Id
pub const TypeKind = types_module.Kind

pub fn tokenPointer(source: []const u8, tokens: Buffer, token_index: usize) -> [*]const u8 {
    const token = lexer.tokenAt(tokens, token_index)
    unsafe {
        const source_pointer = @ptrCast([*]const u8, source)
        return @ptrFromInt([*]const u8, @intFromPtr(source_pointer) + token.start)
    }
}

fn reportOwnership(source: []const u8, path: []const u8, tokens: Buffer, node: Node, code: diagnostic.Code, message: []const u8) -> void {
    if node.mainToken == ast.NONE { return }
    const token = lexer.tokenAt(tokens, node.mainToken)
    const rendered = diagnostic.render(diagnostic.create(
        code,
        diagnostic.Phase.sema,
        diagnostic.Severity.failure,
        0,
        token.start,
        token.start + token.length,
        message,
    ), path, source)
}

// Rust/Zig-style suggestion: names an unresolved identifier and, if a
// plausible in-scope typo exists, points at it as a separate help line.
fn reportUnknownIdentifier(source: []const u8, path: []const u8, tokens: Buffer, node: Node, scope: *Scope) -> void {
    if node.mainToken == ast.NONE { return }
    const token = lexer.tokenAt(tokens, node.mainToken)
    const name_pointer = tokenPointer(source, tokens, node.mainToken)
    reportOwnership(source, path, tokens, node, diagnostic.Code.unknown_identifier, "unknown identifier")
    const suggestion = symbols_module.closestName(scope, name_pointer, token.length)
    if suggestion.0 {
        const rendered = diagnostic.renderSuggestion(path, source, token.start, suggestion.1, suggestion.2)
    }
}

fn reportMovedHere(source: []const u8, path: []const u8, byte_start: usize, byte_length: usize) -> void {
    if byte_length == 0 { return }
    const rendered = diagnostic.render(diagnostic.withCause(diagnostic.create(
        diagnostic.Code.none,
        diagnostic.Phase.sema,
        diagnostic.Severity.note,
        0,
        byte_start,
        byte_start + byte_length,
        "value moved here",
    ), diagnostic.Code.use_after_move), path, source)
}

fn symbolFor(source: []const u8, path: []const u8, tokens: Buffer, scope: *Scope, node: Node) -> (bool, usize) {
    const token = lexer.tokenAt(tokens, node.mainToken)
    return symbols_module.lookup(scope, tokenPointer(source, tokens, node.mainToken), token.length)
}

fn alignForward(value: usize, alignment: usize) -> usize {
    if alignment <= 1 { return value }
    return (value + alignment - 1) & ~(alignment - 1)
}

fn sameName(left: [*]const u8, left_length: usize, right: [*]const u8, right_length: usize) -> bool {
    return left_length == right_length && mem.eql(left, right, left_length)
}

fn fieldIndex(types: *TypeStore, type_id: TypeId, name: [*]const u8, name_length: usize) -> usize {
    const value = types_module.get(types, type_id)
    if value.*.kind != types_module.Kind.struct_type && value.*.kind != types_module.Kind.enum_type && value.*.kind != types_module.Kind.union_type && value.*.kind != types_module.Kind.error_set { return types_module.NONE }
    var index: usize = 0
    while index < value.*.extraLength {
        const candidate = types_module.fieldAt(types, value.*.extraStart + index)
        if sameName(candidate.*.namePointer, candidate.*.nameLength, name, name_length) { return value.*.extraStart + index }
        index += 1
    }
    return types_module.NONE
}

// The type of the field a struct or union literal names at `token_index`
// (0: none).
pub fn fieldTypeNamed(source: []const u8, tokens: Buffer, types: *TypeStore, type_id: TypeId, token_index: usize) -> usize {
    if type_id == 0 { return 0 }
    const token = lexer.tokenAt(tokens, token_index)
    const field_index = fieldIndex(types, type_id, tokenPointer(source, tokens, token_index), token.length)
    if field_index == types_module.NONE { return 0 }
    return types_module.fieldAt(types, field_index).*.typeId
}

// Whether `node` is the identifier `_` (a value assigned to it is
// dropped).
pub fn isDiscard(source: []const u8, tokens: Buffer, nodes: *NodeStore, node_index: usize) -> bool {
    if node_index == ast.NONE { return false }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag != ast.Tag.identifier { return false }
    const token = lexer.tokenAt(tokens, node.mainToken)
    return token.length == 1 && source[token.start] == 95
}

pub fn matchPattern(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, subject_type: TypeId, pattern_index: usize, return_type: TypeId) -> bool {
    if pattern_index == ast.NONE { return true }
    const pattern = ast_store.Store.get(nodes, pattern_index)
    const subject = types_module.get(types, subject_type)
    if pattern.tag == ast.Tag.field_expression && pattern.lhs == ast.NONE {
        if subject.*.kind != types_module.Kind.enum_type && subject.*.kind != types_module.Kind.union_type && subject.*.kind != types_module.Kind.error_set { return false }
        const token = lexer.tokenAt(tokens, pattern.mainToken)
        return fieldIndex(types, subject_type, tokenPointer(source, tokens, pattern.mainToken), token.length) != types_module.NONE
    }
    if pattern.tag == ast.Tag.range_expression {
        const lower = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, pattern.lhs, return_type)
        const upper = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, pattern.rhs, return_type)
        if lower.0 == 0 || upper.0 == 0 { return false }
        return types_module.isCoercible(types, lower.0, subject_type) && types_module.isCoercible(types, upper.0, subject_type)
    }
    const value = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, pattern_index, return_type)
    if value.0 == 0 { return false }
    return types_module.isCoercible(types, value.0, subject_type) || types_module.isCoercible(types, subject_type, value.0)
}

pub fn isAddressable(nodes: *NodeStore, node_index: usize) -> bool {
    if node_index == ast.NONE { return false }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.identifier || node.tag == ast.Tag.field_expression || node.tag == ast.Tag.index_expression { return true }
    if node.tag == ast.Tag.unary_expression { return true }
    return false
}

pub fn isMutable(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> bool {
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.identifier {
        const token = lexer.tokenAt(tokens, node.mainToken)
        const found = symbols_module.lookup(scope, tokenPointer(source, tokens, node.mainToken), token.length)
        if !found.0 { return false }
        return symbols_module.symbolAt(symbols, found.1).*.flags & symbols_module.FLAG_CONSTANT == 0
    }
    if node.tag == ast.Tag.field_expression {
        if node.lhs == ast.NONE { return false }
        // `module.name`: the member's own declaration decides (a `pub var` is
        // writable although the module binding itself is a constant).
        const member = moduleMemberSymbol(source, path, tokens, nodes, types, symbols, scope, node)
        if member.0 { return symbols_module.symbolAt(symbols, member.1).*.flags & symbols_module.FLAG_CONSTANT == 0 }
        return isMutable(source, path, tokens, nodes, types, symbols, scope, node.lhs)
    }
    if node.tag == ast.Tag.index_expression {
        const container = expression(source, path, tokens, nodes, types, symbols, scope, node.lhs)
        if container.0 == 0 { return false }
        const container_type = types_module.get(types, container.0)
        if container_type.*.kind == types_module.Kind.slice || container_type.*.kind == types_module.Kind.many_pointer { return container_type.*.flags & types_module.FLAG_CONSTANT == 0 }
        return isMutable(source, path, tokens, nodes, types, symbols, scope, node.lhs)
    }
    if node.tag == ast.Tag.unary_expression {
        const operator = lexer.tokenAt(tokens, node.mainToken).kind
        if operator != lexer.Kind.dot_asterisk { return false }
        const pointer = expression(source, path, tokens, nodes, types, symbols, scope, node.lhs)
        if pointer.0 == 0 { return false }
        const pointer_type = types_module.get(types, pointer.0)
        return (pointer_type.*.kind == types_module.Kind.pointer || pointer_type.*.kind == types_module.Kind.many_pointer) && pointer_type.*.flags & types_module.FLAG_CONSTANT == 0
    }
    return false
}

// The declaration a `module.name` field expression refers to, when its base is
// a module binding: (true, symbol index), else (false, 0).
fn moduleMemberSymbol(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node: Node) -> (bool, usize) {
    const base_node = ast_store.Store.get(nodes, node.lhs)
    if base_node.tag != ast.Tag.identifier { return -> (false, 0) }
    const base = expression(source, path, tokens, nodes, types, symbols, scope, node.lhs)
    if base.0 == 0 { return -> (false, 0) }
    const base_type = types_module.get(types, base.0)
    if base_type.*.kind != types_module.Kind.module { return -> (false, 0) }
    const field_token = lexer.tokenAt(tokens, node.mainToken)
    const field_pointer = tokenPointer(source, tokens, node.mainToken)
    var declaration_index: usize = 0
    while declaration_index < base_type.*.extraLength {
        const symbol_index = types_module.extraAt(types, base_type.*.extraStart + declaration_index)
        const declaration = symbols_module.symbolAt(symbols, symbol_index)
        if declaration.*.nameLength == field_token.length && sameName(declaration.*.namePointer, declaration.*.nameLength, field_pointer, field_token.length) { return -> (true, symbol_index) }
        declaration_index += 1
    }
    return -> (false, 0)
}

fn reinitializationTarget(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> (TypeId, TypeId) {
    const target = ast_store.Store.get(nodes, node_index)
    if target.tag != ast.Tag.identifier { return -> (0, 0) }
    const token = lexer.tokenAt(tokens, target.mainToken)
    const found = symbols_module.lookup(scope, tokenPointer(source, tokens, target.mainToken), token.length)
    if !found.0 { return -> (0, 0) }
    return -> (symbols_module.symbolAt(symbols, found.1).*.typeId, 0)
}

fn aggregateFunctionFlags(node: Node) -> usize {
    var flags = symbols_module.FLAG_CONSTANT | symbols_module.FLAG_FUNCTION
    const syntax_flags = node.endToken >> 32
    if syntax_flags & 1 != 0 { flags = flags | symbols_module.FLAG_PUBLIC }
    if syntax_flags & 2 != 0 { flags = flags | symbols_module.FLAG_EXPORT }
    if syntax_flags & 16 != 0 { flags = flags | symbols_module.FLAG_EXTERN }
    if syntax_flags & 64 != 0 { flags = flags | symbols_module.FLAG_SYSCALL }
    if syntax_flags & 4 != 0 { flags = flags | symbols_module.FLAG_INLINE }
    if syntax_flags & 8 != 0 { flags = flags | symbols_module.FLAG_NOINLINE }
    return flags
}

fn defineAggregateNamespace(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, aggregate_scope: *Scope, aggregate_id: TypeId, aggregate_node: Node) -> bool {
    const type_type = types_module.primitive(types, types_module.Kind.type_type)
    unsafe {
        var self_symbol = symbols_module.create(@ptrCast([*]const u8, "Self"), 4, ast.NONE, type_type, aggregate_id, symbols_module.FLAG_CONSTANT, symbols_module.State.initialized)
        const self_index = symbols_module.append(symbols, &self_symbol)
        if !symbols_module.define(aggregate_scope, @ptrCast([*]const u8, "Self"), 4, self_index) { return false }
    }

    var member_index = aggregate_node.lhs
    var visited: usize = 0
    while member_index != ast.NONE && visited < aggregate_node.rhs {
        const member = ast_store.Store.get(nodes, member_index)
        if member.tag == ast.Tag.function_declaration {
            const name_token = lexer.tokenAt(tokens, member.mainToken)
            const name_pointer = tokenPointer(source, tokens, member.mainToken)
            if symbols_module.lookupCurrent(aggregate_scope, name_pointer, name_token.length).0 { return false }
            var method = symbols_module.create(name_pointer, name_token.length, member_index, 0, 0, aggregateFunctionFlags(member), symbols_module.State.declared)
            method.ownerTypeId = aggregate_id
            const symbol_index = symbols_module.append(symbols, &method)
            if !symbols_module.define(aggregate_scope, name_pointer, name_token.length, symbol_index) { return false }
        }
        // `const LIMIT = ...` among the members: a constant of the
        // aggregate's namespace (`Self.LIMIT`, `Stack.LIMIT`, `LIMIT` in
        // its methods), typed once the layout is complete
        // (analyzeAggregateConstants).
        if member.tag == ast.Tag.constant_declaration {
            const name_token = lexer.tokenAt(tokens, member.mainToken)
            const name_pointer = tokenPointer(source, tokens, member.mainToken)
            if symbols_module.lookupCurrent(aggregate_scope, name_pointer, name_token.length).0 { return false }
            var constant = symbols_module.create(name_pointer, name_token.length, member_index, 0, 0, symbols_module.FLAG_CONSTANT | symbols_module.FLAG_PUBLIC, symbols_module.State.declared)
            constant.ownerTypeId = aggregate_id
            const symbol_index = symbols_module.append(symbols, &constant)
            if !symbols_module.define(aggregate_scope, name_pointer, name_token.length, symbol_index) { return false }
        }
        member_index = member.next
        visited += 1
    }
    return true
}

// The constants among an aggregate's members typed and evaluated, in the
// aggregate's scope (where `Self`, the methods and a generic type's
// parameters are named).
fn analyzeAggregateConstants(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, aggregate_scope: *Scope, aggregate_node: Node) -> bool {
    var member_index = aggregate_node.lhs
    var visited: usize = 0
    while member_index != ast.NONE && visited < aggregate_node.rhs {
        const member = ast_store.Store.get(nodes, member_index)
        if member.tag == ast.Tag.constant_declaration {
            const name_token = lexer.tokenAt(tokens, member.mainToken)
            const found = symbols_module.lookupCurrent(aggregate_scope, tokenPointer(source, tokens, member.mainToken), name_token.length)
            if !found.0 { return false }
            symbols_module.symbolAt(symbols, found.1).*.state = symbols_module.State.initializing
            var declared_type: TypeId = 0
            if member.lhs != ast.NONE {
                declared_type = resolveType(source, path, tokens, nodes, types, symbols, aggregate_scope, member.lhs)
                if declared_type == 0 {
                    reportOwnership(source, path, tokens, ast_store.Store.get(nodes, member.lhs), diagnostic.Code.type_mismatch, "this type could not be resolved")
                    return false
                }
            }
            const inferred = expression(source, path, tokens, nodes, types, symbols, aggregate_scope, member.rhs)
            if inferred.0 == 0 {
                const unknown = unknown_names.report(source, path, tokens, nodes, types, aggregate_scope, member.rhs)
                reportOwnership(source, path, tokens, member, diagnostic.Code.type_mismatch, "this constant of the aggregate could not be resolved")
                return false
            }
            if declared_type == 0 { declared_type = inferred.0 }
            if mismatch.say(source, path, tokens, nodes, types, symbols, member.rhs, inferred.0, declared_type) { return false }
            const known = comptime_module.evaluate(source, tokens, nodes, types, symbols, aggregate_scope, member.rhs, 1000000)
            const symbol = symbols_module.symbolAt(symbols, found.1)
            symbol.*.typeId = declared_type
            symbol.*.valueTypeId = inferred.1
            if comptime_module.isValid(known) {
                symbol.*.comptimeTag = @intCast(u8, @intFromEnum(known.kind))
                symbol.*.comptimeInteger = known.integer
                if known.kind == comptime_module.Kind.type_value && symbol.*.valueTypeId == 0 { symbol.*.valueTypeId = known.typeId }
            }
            symbol.*.state = symbols_module.State.initialized
        }
        member_index = member.next
        visited += 1
    }
    return true
}

fn analyzeAggregateFunctionTypes(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, aggregate_scope: *Scope, aggregate_node: Node) -> bool {
    var member_index = aggregate_node.lhs
    var visited: usize = 0
    while member_index != ast.NONE && visited < aggregate_node.rhs {
        const member = ast_store.Store.get(nodes, member_index)
        if member.tag == ast.Tag.function_declaration && analyzeFunction(source, path, tokens, nodes, types, symbols, aggregate_scope, member_index) != 0 { return false }
        member_index = member.next
        visited += 1
    }
    return true
}

// What tells one aggregate declaration from another: where its node is,
// and in a generic type instance (types.instanceSalt) which instance, so
// that `struct { value: T }` written once is another aggregate for every
// T.
fn aggregateIdentity(nodes: *NodeStore, types: *TypeStore, node_index: usize) -> usize {
    return aggregate_names.identity(nodes, node_index) ^ (types.*.instanceSalt << 48)
}

// `copyability`: explicit_nocopy for the aggregate of `@noncopy(struct)
// { ... }`, which is then that one type (its `Self`, its methods' owner,
// and the binding's value are all the non-copyable aggregate).
fn resolveAggregate(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, kind: TypeKind, declared_copyability: types_module.Copyability) -> TypeId {
    const node = ast_store.Store.get(nodes, node_index)
    var identity = aggregateIdentity(nodes, types, node_index)
    var aggregate_id = types_module.aggregate(types, kind, identity, declared_copyability)
    var aggregate = types_module.get(types, aggregate_id)
    while aggregate.*.flags & types_module.FLAG_LAYOUT_COMPLETE != 0 {
        if aggregate_names.fieldsMatch(source, tokens, nodes, types, node, aggregate_id) { return aggregate_id }
        identity += 1
        aggregate_id = types_module.aggregate(types, kind, identity, declared_copyability)
        aggregate = types_module.get(types, aggregate_id)
    }
    var aggregate_scope = symbols_module.initChildScopeFromParent(scope, node.rhs + 4)
    if !defineAggregateNamespace(source, path, tokens, nodes, types, symbols, &aggregate_scope, aggregate_id, node) {
        symbols_module.deinitScope(&aggregate_scope)
        return 0
    }
    // Inside its body the aggregate also goes by the name its binding gives
    // it: that name stands for the `Self` symbol (a member of that name
    // wins).
    const binding = aggregate_names.bindingOf(nodes, symbols, scope, node_index)
    if binding.0 {
        const named = symbols_module.symbolAt(symbols, binding.1)
        var self_name: [*]const u8 = undefined
        unsafe { self_name = @ptrCast([*]const u8, "Self") }
        const self_symbol = symbols_module.lookupCurrent(&aggregate_scope, self_name, 4)
        if self_symbol.0 && !symbols_module.lookupCurrent(&aggregate_scope, named.*.namePointer, named.*.nameLength).0 {
            const defined = symbols_module.define(&aggregate_scope, named.*.namePointer, named.*.nameLength, self_symbol.1)
        }
    }
    var ahead = node.lhs
    var ahead_visited: usize = 0
    while ahead != ast.NONE && ahead_visited < node.rhs {
        const member = ast_store.Store.get(nodes, ahead)
        if member.tag != ast.Tag.function_declaration && member.tag != ast.Tag.constant_declaration && kind != types_module.Kind.enum_type && kind != types_module.Kind.error_set { analyzeTypeAhead(source, path, tokens, nodes, types, symbols, &aggregate_scope, member.lhs) }
        ahead = member.next
        ahead_visited += 1
    }
    const fields_start = types.*.fields.*.length
    var field_node = node.lhs
    var count: usize = 0
    var visited: usize = 0
    var size: usize = 0
    var alignment: usize = 1
    var copyability = declared_copyability

    if kind == types_module.Kind.enum_type || kind == types_module.Kind.error_set {
        var backing = types_module.integer(types, false, 16)
        if kind == types_module.Kind.enum_type {
            if node.extra == ast.NONE {
                reportOwnership(source, path, tokens, node, diagnostic.Code.type_mismatch, "an enum names its backing integer type: `enum(u8) { ... }`")
                symbols_module.deinitScope(&aggregate_scope)
                return 0
            }
            backing = resolveType(source, path, tokens, nodes, types, symbols, &aggregate_scope, node.extra)
            if backing == 0 {
                symbols_module.deinitScope(&aggregate_scope)
                return 0
            }
        }
        size = types_module.sizeOf(types, backing)
        alignment = types_module.alignOf(types, backing)
        types_module.get(types, aggregate_id).*.backing = backing
        var next_value: usize = if kind == types_module.Kind.error_set { 1 } else { 0 }
        while field_node != ast.NONE && visited < node.rhs {
            const member = ast_store.Store.get(nodes, field_node)
            if member.tag == ast.Tag.function_declaration || member.tag == ast.Tag.constant_declaration {
                field_node = member.next
                visited += 1
                continue
            }
            const member_token = lexer.tokenAt(tokens, member.mainToken)
            const clash = symbols_module.lookupCurrent(&aggregate_scope, tokenPointer(source, tokens, member.mainToken), member_token.length).0
            if clash || types_module.hasField(types, fields_start, count, tokenPointer(source, tokens, member.mainToken), member_token.length) {
                if !clash { reportOwnership(source, path, tokens, member, diagnostic.Code.duplicate_symbol, "duplicate field name") }
                symbols_module.deinitScope(&aggregate_scope)
                return 0
            }
            var member_value = next_value
            if member.rhs != ast.NONE {
                const explicit = comptime_module.evaluate(source, tokens, nodes, types, symbols, &aggregate_scope, member.rhs, 1000000)
                if explicit.kind != comptime_module.Kind.integer {
                    const explicit_node = ast_store.Store.get(nodes, member.rhs)
                    if explicit.reason == comptime_module.Reason.quota_exceeded {
                        reportOwnership(source, path, tokens, explicit_node, diagnostic.Code.comptime_branch_quota_exceeded, "comptime evaluation of this value exceeded the branch quota")
                    } else {
                        reportOwnership(source, path, tokens, explicit_node, diagnostic.Code.comptime_runtime_dependency, "explicit enum/error-set value must be a compile-time-known integer")
                    }
                    symbols_module.deinitScope(&aggregate_scope)
                    return 0
                }
                member_value = @bitCast(usize, explicit.integer)
            }
            var field = types_module.Field.{ .nameToken = member.mainToken, .namePointer = tokenPointer(source, tokens, member.mainToken), .nameLength = member_token.length, .typeId = backing, .offset = member_value }
            if types_module.appendField(types, &field) == types_module.NONE {
                symbols_module.deinitScope(&aggregate_scope)
                return 0
            }
            next_value = member_value + 1
            field_node = member.next
            count += 1
            visited += 1
        }
        if field_node != ast.NONE || visited != node.rhs {
            symbols_module.deinitScope(&aggregate_scope)
            return 0
        }
        types_module.completeAggregate(types, aggregate_id, fields_start, count, size, alignment, copyability)
        const members_valid = analyzeAggregateConstants(source, path, tokens, nodes, types, symbols, &aggregate_scope, node) && analyzeAggregateFunctionTypes(source, path, tokens, nodes, types, symbols, &aggregate_scope, node)
        symbols_module.deinitScope(&aggregate_scope)
        if !members_valid { return 0 }
        return aggregate_id
    }

    while field_node != ast.NONE && visited < node.rhs {
        const member = ast_store.Store.get(nodes, field_node)
        if member.tag == ast.Tag.function_declaration || member.tag == ast.Tag.constant_declaration {
            field_node = member.next
            visited += 1
            continue
        }
        const member_token = lexer.tokenAt(tokens, member.mainToken)
        const clash = symbols_module.lookupCurrent(&aggregate_scope, tokenPointer(source, tokens, member.mainToken), member_token.length).0
        if clash || types_module.hasField(types, fields_start, count, tokenPointer(source, tokens, member.mainToken), member_token.length) {
            if !clash { reportOwnership(source, path, tokens, member, diagnostic.Code.duplicate_symbol, "duplicate field name") }
            symbols_module.deinitScope(&aggregate_scope)
            return 0
        }
        var field_type = types_module.primitive(types, types_module.Kind.void_type)
        if member.lhs != ast.NONE { field_type = resolveType(source, path, tokens, nodes, types, symbols, &aggregate_scope, member.lhs) }
        if field_type == 0 {
            if member.lhs != ast.NONE {
                const unknown = unknown_names.report(source, path, tokens, nodes, types, &aggregate_scope, member.lhs)
                reportOwnership(source, path, tokens, ast_store.Store.get(nodes, member.lhs), diagnostic.Code.type_mismatch, "the type of this field could not be resolved")
            }
            symbols_module.deinitScope(&aggregate_scope)
            return 0
        }
        const field_alignment = types_module.alignOf(types, field_type)
        const field_size = types_module.sizeOf(types, field_type)
        if field_alignment > alignment { alignment = field_alignment }
        var offset: usize = 0
        if kind == types_module.Kind.struct_type {
            size = alignForward(size, field_alignment)
            offset = size
            size += field_size
        }
        if kind == types_module.Kind.union_type && field_size > size { size = field_size }
        if copyability == types_module.Copyability.copyable && types_module.get(types, field_type).*.copyability != types_module.Copyability.copyable { copyability = types_module.Copyability.contains_nocopy }
        var field = types_module.Field.{ .nameToken = member.mainToken, .namePointer = tokenPointer(source, tokens, member.mainToken), .nameLength = member_token.length, .typeId = field_type, .offset = offset }
        if types_module.appendField(types, &field) == types_module.NONE {
            symbols_module.deinitScope(&aggregate_scope)
            return 0
        }
        field_node = member.next
        count += 1
        visited += 1
    }
    if field_node != ast.NONE || visited != node.rhs {
        symbols_module.deinitScope(&aggregate_scope)
        return 0
    }
    if kind == types_module.Kind.union_type && node.extra != ast.NONE {
        const backing = resolveType(source, path, tokens, nodes, types, symbols, &aggregate_scope, node.extra)
        if backing == 0 {
            symbols_module.deinitScope(&aggregate_scope)
            return 0
        }
        types_module.get(types, aggregate_id).*.backing = backing
        const tag_size = types_module.sizeOf(types, backing)
        const tag_alignment = types_module.alignOf(types, backing)
        const payload_offset = alignForward(tag_size, alignment)
        var index: usize = 0
        while index < count {
            types_module.fieldAt(types, fields_start + index).*.offset = payload_offset
            index += 1
        }
        size = payload_offset + size
        if tag_alignment > alignment { alignment = tag_alignment }
    }
    size = alignForward(size, alignment)
    types_module.completeAggregate(types, aggregate_id, fields_start, count, size, alignment, copyability)
    const members_valid = analyzeAggregateConstants(source, path, tokens, nodes, types, symbols, &aggregate_scope, node) && analyzeAggregateFunctionTypes(source, path, tokens, nodes, types, symbols, &aggregate_scope, node)
    symbols_module.deinitScope(&aggregate_scope)
    if !members_valid { return 0 }
    return aggregate_id
}

// The aggregate a binding `const A = struct { ... }` is making, while its
// layout is not complete yet (0 when the binding is no such one).
fn pendingAggregate(nodes: *NodeStore, types: *TypeStore, declaration: usize) -> TypeId {
    if declaration == ast.NONE { return 0 }
    const binding = ast_store.Store.get(nodes, declaration)
    if binding.tag != ast.Tag.constant_declaration || binding.rhs == ast.NONE { return 0 }
    var aggregate_node = binding.rhs
    var copyability = types_module.Copyability.copyable
    if ast_store.Store.get(nodes, aggregate_node).tag == ast.Tag.nocopy_type {
        aggregate_node = ast_store.Store.get(nodes, aggregate_node).lhs
        copyability = types_module.Copyability.explicit_nocopy
        if aggregate_node == ast.NONE { return 0 }
    }
    const tag = ast_store.Store.get(nodes, aggregate_node).tag
    var kind = types_module.Kind.struct_type
    if tag == ast.Tag.enum_type {
        kind = types_module.Kind.enum_type
    } else if tag == ast.Tag.union_type {
        kind = types_module.Kind.union_type
    } else if tag != ast.Tag.struct_type {
        return 0
    }
    // (As resolveAggregate chose it: the first of its identities whose
    // layout is not complete.)
    var identity = aggregateIdentity(nodes, types, aggregate_node)
    var aggregate_id = types_module.aggregate(types, kind, identity, copyability)
    while types_module.get(types, aggregate_id).*.flags & types_module.FLAG_LAYOUT_COMPLETE != 0 {
        identity += 1
        aggregate_id = types_module.aggregate(types, kind, identity, copyability)
    }
    return aggregate_id
}

pub fn resolveType(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> TypeId {
    if node_index == ast.NONE { return 0 }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.struct_type { return resolveAggregate(source, path, tokens, nodes, types, symbols, scope, node_index, types_module.Kind.struct_type, types_module.Copyability.copyable) }
    if node.tag == ast.Tag.enum_type { return resolveAggregate(source, path, tokens, nodes, types, symbols, scope, node_index, types_module.Kind.enum_type, types_module.Copyability.copyable) }
    if node.tag == ast.Tag.union_type { return resolveAggregate(source, path, tokens, nodes, types, symbols, scope, node_index, types_module.Kind.union_type, types_module.Copyability.copyable) }
    if node.tag == ast.Tag.error_set_type { return resolveAggregate(source, path, tokens, nodes, types, symbols, scope, node_index, types_module.Kind.error_set, types_module.Copyability.copyable) }
    // `@noncopy(struct) { ... }`: the aggregate is made non-copyable, not
    // wrapped, so that `Self` and the methods' owner are the type the
    // binding gets.
    if node.tag == ast.Tag.nocopy_type && node.lhs != ast.NONE {
        const child_tag = ast_store.Store.get(nodes, node.lhs).tag
        if child_tag == ast.Tag.struct_type { return resolveAggregate(source, path, tokens, nodes, types, symbols, scope, node.lhs, types_module.Kind.struct_type, types_module.Copyability.explicit_nocopy) }
        if child_tag == ast.Tag.enum_type { return resolveAggregate(source, path, tokens, nodes, types, symbols, scope, node.lhs, types_module.Kind.enum_type, types_module.Copyability.explicit_nocopy) }
        if child_tag == ast.Tag.union_type { return resolveAggregate(source, path, tokens, nodes, types, symbols, scope, node.lhs, types_module.Kind.union_type, types_module.Copyability.explicit_nocopy) }
    }
    const direct = types_module.resolve(source, tokens, nodes, types, node_index)
    if direct != 0 { return direct }
    if node.tag == ast.Tag.field_expression {
        const field_value = expression(source, path, tokens, nodes, types, symbols, scope, node_index)
        if field_value.0 != types_module.primitive(types, types_module.Kind.type_type) { return 0 }
        return field_value.1
    }
    // Builtins such as `@sizeOf(Module)` parse their argument through the
    // expression grammar, so a user-defined type name arrives as an
    // identifier rather than a named_type node.
    if node.tag == ast.Tag.named_type || node.tag == ast.Tag.identifier {
        if node.tag == ast.Tag.identifier {
            const builtin_type = types_module.resolveName(source, tokens, node.mainToken, types)
            if builtin_type != 0 { return builtin_type }
        }
        const token = lexer.tokenAt(tokens, node.mainToken)
        const found = symbols_module.lookup(scope, tokenPointer(source, tokens, node.mainToken), token.length)
        if !found.0 { return 0 }
        analyzeAhead(source, path, tokens, nodes, types, symbols, scope, found.1)
        const symbol = symbols_module.symbolAt(symbols, found.1)
        if symbol.*.typeId == 0 && symbol.*.state == symbols_module.State.initializing {
            // A struct, union or enum still being worked out, named again
            // inside itself or inside a type it names (`A { b: ?*B }` and
            // `B { a: ?*A }`, a function type taking `*A` in a field of A):
            // the aggregate it is, its layout to come. Behind a pointer
            // that is all that is needed.
            const pending = pendingAggregate(nodes, types, symbol.*.declaration)
            if pending != 0 { return pending }
        }
        if symbol.*.typeId != types_module.primitive(types, types_module.Kind.type_type) { return 0 }
        return symbol.*.valueTypeId
    }
    if node.tag == ast.Tag.pointer_type || node.tag == ast.Tag.many_pointer_type {
        const child = resolveType(source, path, tokens, nodes, types, symbols, scope, node.lhs)
        if child == 0 { return 0 }
        return types_module.pointer(types, child, node.extra & 1 != 0, node.extra & 2 != 0, node.tag == ast.Tag.many_pointer_type)
    }
    if node.tag == ast.Tag.slice_type {
        const child = resolveType(source, path, tokens, nodes, types, symbols, scope, node.lhs)
        if child == 0 { return 0 }
        return types_module.slice(types, child, node.extra & 1 != 0)
    }
    if node.tag == ast.Tag.array_type {
        const child = resolveType(source, path, tokens, nodes, types, symbols, scope, node.rhs)
        if child == 0 || node.lhs == ast.NONE { return 0 }
        const length_node = ast_store.Store.get(nodes, node.lhs)
        if length_node.tag == ast.Tag.integer_literal {
            return types_module.array(types, child, types_module.parseUnsigned(source, tokens, length_node.mainToken))
        }
        // A length that is not written out as a number: a named constant,
        // another module's constant, an expression over them.
        const length = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, node.lhs, 1000000)
        if length.kind != comptime_module.Kind.integer || length.integer < 0 { return 0 }
        return types_module.array(types, child, @bitCast(usize, length.integer))
    }
    if node.tag == ast.Tag.optional_type {
        const child = resolveType(source, path, tokens, nodes, types, symbols, scope, node.lhs)
        if child == 0 { return 0 }
        return types_module.optional(types, child)
    }
    if node.tag == ast.Tag.error_union_type {
        const payload = resolveType(source, path, tokens, nodes, types, symbols, scope, node.rhs)
        if payload == 0 { return 0 }
        var errors = types_module.aggregate(types, types_module.Kind.error_set, node_index, types_module.Copyability.copyable)
        if node.lhs != ast.NONE { errors = resolveType(source, path, tokens, nodes, types, symbols, scope, node.lhs) }
        if errors == 0 { return 0 }
        return types_module.errorUnion(types, errors, payload)
    }
    if node.tag == ast.Tag.function_type || node.tag == ast.Tag.tuple_type {
        analyzeTypeAhead(source, path, tokens, nodes, types, symbols, scope, node_index)
        const extra_start = types.*.extraIds.*.length
        var child = node.lhs
        var count: usize = 0
        while child != ast.NONE && count < node.rhs {
            const child_type = resolveType(source, path, tokens, nodes, types, symbols, scope, child)
            if child_type == 0 { return 0 }
            types_module.appendExtra(types, child_type)
            child = ast_store.Store.get(nodes, child).next
            count += 1
        }
        if count != node.rhs { return 0 }
        if node.tag == ast.Tag.tuple_type { return types_module.tuple(types, extra_start, count) }
        const return_type = resolveType(source, path, tokens, nodes, types, symbols, scope, node.extra)
        if return_type == 0 { return 0 }
        return types_module.function(types, return_type, extra_start, count)
    }
    if node.tag == ast.Tag.nocopy_type {
        const child = resolveType(source, path, tokens, nodes, types, symbols, scope, node.lhs)
        if child == 0 { return 0 }
        return types_module.noCopy(types, child)
    }
    // `Box(u32)`: a generic type function applied (typeFunctionCall).
    if node.tag == ast.Tag.call_expression {
        const made = expression(source, path, tokens, nodes, types, symbols, scope, node_index)
        if made.0 != types_module.primitive(types, types_module.Kind.type_type) { return 0 }
        return made.1
    }
    return 0
}

pub fn expression(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> (TypeId, TypeId) {
    return expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node_index, 0)
}

fn breakTargetsLabel(source: []const u8, path: []const u8, tokens: Buffer, break_label: usize, loop_label: usize) -> bool {
    if break_label == ast.NONE || loop_label == ast.NONE { return break_label == loop_label }
    const break_token = lexer.tokenAt(tokens, break_label)
    const loop_token = lexer.tokenAt(tokens, loop_label)
    return sameName(tokenPointer(source, tokens, break_label), break_token.length, tokenPointer(source, tokens, loop_label), loop_token.length)
}

fn loopBreakValueType(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, label_token: usize, return_type: TypeId) -> (TypeId, TypeId) {
    if node_index == ast.NONE { return -> (0, 0) }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.break_statement {
        if node.rhs != ast.NONE && breakTargetsLabel(source, path, tokens, node.lhs, label_token) {
            return expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
        }
        return -> (0, 0)
    }
    if node.tag == ast.Tag.block {
        var child = node.lhs
        var count: usize = 0
        while child != ast.NONE && count < node.rhs {
            const result = loopBreakValueType(source, path, tokens, nodes, types, symbols, scope, child, label_token, return_type)
            if result.0 != 0 { return result }
            child = ast_store.Store.get(nodes, child).next
            count += 1
        }
        return -> (0, 0)
    }
    if node.tag == ast.Tag.if_statement {
        const then_result = loopBreakValueType(source, path, tokens, nodes, types, symbols, scope, node.rhs, label_token, return_type)
        if then_result.0 != 0 { return then_result }
        return loopBreakValueType(source, path, tokens, nodes, types, symbols, scope, node.extra, label_token, return_type)
    }
    if node.tag == ast.Tag.while_statement || node.tag == ast.Tag.inline_while_statement || node.tag == ast.Tag.for_statement || node.tag == ast.Tag.inline_for_statement {
        if label_token == ast.NONE { return -> (0, 0) }
        return loopBreakValueType(source, path, tokens, nodes, types, symbols, scope, node.rhs, label_token, return_type)
    }
    if node.tag == ast.Tag.match_statement {
        var arm_index = node.rhs
        var arm_count: usize = 0
        while arm_index != ast.NONE && arm_count < node.extra {
            const arm = ast_store.Store.get(nodes, arm_index)
            const result = loopBreakValueType(source, path, tokens, nodes, types, symbols, scope, arm.rhs, label_token, return_type)
            if result.0 != 0 { return result }
            arm_index = arm.next
            arm_count += 1
        }
    }
    return -> (0, 0)
}

pub fn aggregateMethodCompatible(types: *TypeStore, symbols: *SymbolStore, owner_type: usize, pointer: [*]const u8, length: usize) -> (bool, usize) {
    const exact = symbols_module.aggregateMethod(symbols, owner_type, pointer, length)
    if exact.0 { return exact }
    if owner_type == 0 { return -> (false, 0) }
    // An equal owner with another type id: the first declared method of
    // that name (through the store's index by name).
    const owner = types_module.get(types, owner_type)
    var best: usize = 18446744073709551615
    var slot = symbols_module.firstNamed(symbols, pointer, length)
    while symbols_module.namedAt(symbols, slot) != 0 {
        const index = symbols_module.namedAt(symbols, slot) - 1
        const candidate = symbols_module.symbolAt(symbols, index)
        if index < best && sameName(candidate.*.namePointer, candidate.*.nameLength, pointer, length) {
            const candidate_owner = types_module.get(types, candidate.*.ownerTypeId)
            if candidate_owner.*.kind == owner.*.kind && candidate_owner.*.bits == owner.*.bits { best = index }
        }
        slot = symbols_module.nextNamed(symbols, slot)
    }
    if best == 18446744073709551615 { return -> (false, 0) }
    return -> (true, best)
}

pub fn referencedFunctionSymbol(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> (bool, usize) {
    if node_index == ast.NONE { return -> (false, 0) }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.identifier || node.tag == ast.Tag.named_type {
        const token = lexer.tokenAt(tokens, node.mainToken)
        return symbols_module.lookup(scope, tokenPointer(source, tokens, node.mainToken), token.length)
    }
    if node.tag != ast.Tag.field_expression || node.lhs == ast.NONE { return -> (false, 0) }
    const base = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, 0)
    if base.0 == 0 { return -> (false, 0) }
    const base_type = types_module.get(types, base.0)
    const field_token = lexer.tokenAt(tokens, node.mainToken)
    const field_pointer = tokenPointer(source, tokens, node.mainToken)
    if base_type.*.kind == types_module.Kind.type_type && base.1 != 0 {
        const reflected = types_module.get(types, base.1)
        if reflected.*.kind == types_module.Kind.struct_type || reflected.*.kind == types_module.Kind.enum_type || reflected.*.kind == types_module.Kind.union_type {
            return aggregateMethodCompatible(types, symbols, base.1, field_pointer, field_token.length)
        }
    }
    if base_type.*.kind == types_module.Kind.struct_type || base_type.*.kind == types_module.Kind.enum_type || base_type.*.kind == types_module.Kind.union_type {
        return aggregateMethodCompatible(types, symbols, base.0, field_pointer, field_token.length)
    }
    if (base_type.*.kind == types_module.Kind.pointer || base_type.*.kind == types_module.Kind.many_pointer) && base_type.*.lhs != 0 {
        const child = types_module.get(types, base_type.*.lhs)
        if child.*.kind == types_module.Kind.struct_type || child.*.kind == types_module.Kind.enum_type || child.*.kind == types_module.Kind.union_type {
            return aggregateMethodCompatible(types, symbols, base_type.*.lhs, field_pointer, field_token.length)
        }
    }
    if base_type.*.kind != types_module.Kind.module { return -> (false, 0) }
    var declaration_index: usize = 0
    while declaration_index < base_type.*.extraLength {
        const symbol_index = types_module.extraAt(types, base_type.*.extraStart + declaration_index)
        const declaration = symbols_module.symbolAt(symbols, symbol_index)
        if declaration.*.nameLength == field_token.length && sameName(declaration.*.namePointer, declaration.*.nameLength, field_pointer, field_token.length) { return -> (true, symbol_index) }
        declaration_index += 1
    }
    return -> (false, 0)
}

fn callArgumentAt(nodes: *NodeStore, first_argument: usize, wanted: usize) -> usize {
    var argument = first_argument
    var index: usize = 0
    while argument != ast.NONE && index < wanted {
        argument = ast_store.Store.get(nodes, argument).next
        index += 1
    }
    return argument
}

// The annotated return type of a generic function (`-> ?T`, `-> []const
// T`, `-> Box(T)`) resolved for one call, in a scope where the comptime
// parameters are what the call gives them; 0 when it cannot be.
fn derivedCallReturnType(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, call: Node, symbol: *symbols_module.Symbol, return_type: TypeId) -> usize {
    if symbol.*.declaration == ast.NONE { return 0 }
    const context = symbols_module.moduleContext(symbols, symbol.*.moduleId)
    if context.nodesAddress == 0 || context.tokensAddress == 0 || context.scopeAddress == 0 { return 0 }
    var function_nodes: *NodeStore = undefined
    var function_tokens: Buffer = undefined
    var module_scope: *Scope = undefined
    unsafe {
        function_nodes = @ptrFromInt(*NodeStore, context.nodesAddress)
        function_tokens = @ptrFromInt(*Buffer, context.tokensAddress).*
        module_scope = @ptrFromInt(*Scope, context.scopeAddress)
    }
    const function_source = context.sourcePointer[0..context.sourceLength]
    const function_path = context.pathPointer[0..context.pathLength]
    const function_node = ast_store.Store.get(function_nodes, symbol.*.declaration)
    if function_node.extra == ast.NONE { return 0 }
    if !isComptimeTypeParameterName(function_source, function_path, function_tokens, function_nodes, function_node, ast.NONE, function_node.extra) { return 0 }
    var call_scope = symbols_module.initChildScopeFromParent(module_scope, 8)
    const type_type = types_module.primitive(types, types_module.Kind.type_type)
    var parameter = function_node.lhs
    var index: usize = 0
    var bound = true
    while parameter != ast.NONE && bound {
        const parameter_node = ast_store.Store.get(function_nodes, parameter)
        if parameter_node.extra & 1 != 0 {
            const argument = callArgumentAt(nodes, call.rhs, index)
            if argument == ast.NONE {
                bound = false
            } else {
                const name_token = lexer.tokenAt(function_tokens, parameter_node.mainToken)
                const name_pointer = tokenPointer(function_source, function_tokens, parameter_node.mainToken)
                const value = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, argument, return_type)
                if value.0 == type_type && value.1 != 0 {
                    var type_symbol = symbols_module.create(name_pointer, name_token.length, ast.NONE, type_type, value.1, symbols_module.FLAG_CONSTANT, symbols_module.State.initialized)
                    type_symbol.comptimeTag = @intCast(u8, @intFromEnum(comptime_module.Kind.type_value))
                    const defined = symbols_module.define(&call_scope, name_pointer, name_token.length, symbols_module.append(symbols, &type_symbol))
                } else {
                    const known = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, argument, 1000000)
                    if known.kind == comptime_module.Kind.integer || known.kind == comptime_module.Kind.boolean {
                        var value_symbol = symbols_module.create(name_pointer, name_token.length, ast.NONE, if value.0 != 0 { value.0 } else { types_module.primitive(types, types_module.Kind.comptime_int_type) }, 0, symbols_module.FLAG_CONSTANT, symbols_module.State.initialized)
                        value_symbol.comptimeTag = @intCast(u8, @intFromEnum(known.kind))
                        value_symbol.comptimeInteger = known.integer
                        const defined = symbols_module.define(&call_scope, name_pointer, name_token.length, symbols_module.append(symbols, &value_symbol))
                    } else {
                        bound = false
                    }
                }
            }
        }
        parameter = parameter_node.next
        index += 1
    }
    var result: usize = 0
    if bound { result = resolveType(function_source, function_path, function_tokens, function_nodes, types, symbols, &call_scope, function_node.extra) }
    symbols_module.deinitScope(&call_scope)
    return result
}

fn genericCallReturnType(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, call: Node, symbol: *symbols_module.Symbol, return_type: TypeId) -> usize {
    const derived = derivedCallReturnType(source, path, tokens, nodes, types, symbols, scope, call, symbol, return_type)
    if derived != 0 { return derived }
    if symbol.*.genericReturnKind == symbols_module.GENERIC_RETURN_NONE { return 0 }
    const primary_index = symbol.*.genericReturnParameter
    const primary_node = callArgumentAt(nodes, call.rhs, primary_index)
    if primary_node == ast.NONE { return 0 }
    const primary = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, primary_node, return_type)
    if symbol.*.genericReturnKind == symbols_module.GENERIC_RETURN_PARAMETER { return primary.0 }
    if symbol.*.genericReturnKind == symbols_module.GENERIC_RETURN_TYPE_PARAMETER { return primary.1 }
    if symbol.*.genericReturnKind == symbols_module.GENERIC_RETURN_FIELD {
        const selector_index = symbol.*.genericReturnSelector
        const selector_node = callArgumentAt(nodes, call.rhs, selector_index)
        if primary.0 == 0 || selector_node == ast.NONE { return 0 }
        const selector = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, selector_node, 1000000)
        if selector.kind != comptime_module.Kind.integer {
            const selector_ast_node = ast_store.Store.get(nodes, selector_node)
            if selector.reason == comptime_module.Reason.quota_exceeded {
                reportOwnership(source, path, tokens, selector_ast_node, diagnostic.Code.comptime_branch_quota_exceeded, "comptime evaluation of this generic return selector exceeded the branch quota")
            } else {
                reportOwnership(source, path, tokens, selector_ast_node, diagnostic.Code.comptime_runtime_dependency, "generic return field selector must be a compile-time-known integer")
            }
            return 0
        }
        if selector.integer < 0 { return 0 }
        const aggregate = types_module.get(types, primary.0)
        const field_index = @intCast(usize, selector.integer)
        if field_index >= aggregate.*.extraLength { return 0 }
        if aggregate.*.kind == types_module.Kind.tuple { return types_module.extraAt(types, aggregate.*.extraStart + field_index) }
        if aggregate.*.kind == types_module.Kind.struct_type || aggregate.*.kind == types_module.Kind.union_type { return types_module.fieldAt(types, aggregate.*.extraStart + field_index).*.typeId }
    }
    return 0
}

// Generic type functions: `fn Box(comptime T: type) -> type { return
// struct { value: T ... } }`. A call `Box(u32)` is an instance of the
// function (types.Instance), one per distinct argument list: the body is
// evaluated once, in a scope of its own holding the parameters and the
// constants it declares, with the aggregates it declares told from every
// other instance's (aggregateIdentity), and the type it returns is the
// call's value. The lowering generates the methods of those aggregates
// from the instance's scope (ir/lower.mlx, lowerInstanceMethods).

// A function returning `type`.
pub fn isTypeFunction(types: *TypeStore, symbol: *symbols_module.Symbol) -> bool {
    if symbol.*.flags & symbols_module.FLAG_FUNCTION == 0 || symbol.*.declaration == ast.NONE || symbol.*.typeId == 0 { return false }
    const function_type = types_module.get(types, symbol.*.typeId)
    if function_type.*.kind != types_module.Kind.function { return false }
    return types_module.get(types, function_type.*.lhs).*.kind == types_module.Kind.type_type
}

const TYPE_FUNCTION_ARGUMENT_LIMIT: usize = 8

// `Box(u32)` typed: (type, the instance's type).
fn typeFunctionCall(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, call: Node, symbol_index: usize, return_type: TypeId) -> (TypeId, TypeId) {
    var arguments: [8]types_module.InstanceArgument = undefined
    var count: usize = 0
    var argument = call.rhs
    while argument != ast.NONE && count < call.extra {
        const argument_node = ast_store.Store.get(nodes, argument)
        if count >= TYPE_FUNCTION_ARGUMENT_LIMIT {
            reportOwnership(source, path, tokens, argument_node, diagnostic.Code.type_mismatch, "a generic type takes at most 8 arguments")
            return -> (0, 0)
        }
        const value = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, argument, return_type)
        if value.0 == types_module.primitive(types, types_module.Kind.type_type) && value.1 != 0 {
            arguments[count] = types_module.InstanceArgument.{ .kind = @intCast(u8, @intFromEnum(comptime_module.Kind.type_value)), .typeId = value.1, .integer = 0 }
        } else {
            const known = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, argument, 1000000)
            if known.kind == comptime_module.Kind.integer || known.kind == comptime_module.Kind.boolean {
                arguments[count] = types_module.InstanceArgument.{ .kind = @intCast(u8, @intFromEnum(known.kind)), .typeId = 0, .integer = known.integer }
            } else if known.kind == comptime_module.Kind.type_value && known.typeId != 0 {
                arguments[count] = types_module.InstanceArgument.{ .kind = @intCast(u8, @intFromEnum(comptime_module.Kind.type_value)), .typeId = known.typeId, .integer = 0 }
            } else {
                const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, argument)
                reportOwnership(source, path, tokens, argument_node, diagnostic.Code.comptime_runtime_dependency, "an argument of a generic type is a type, or an integer or bool known at compile time")
                return -> (0, 0)
            }
        }
        argument = argument_node.next
        count += 1
    }
    if count != call.extra { return -> (0, 0) }
    const made = instantiateType(source, path, tokens, nodes, types, symbols, scope, symbol_index, &arguments, count, call)
    if made == 0 { return -> (0, 0) }
    return -> (types_module.primitive(types, types_module.Kind.type_type), made)
}

// The instance of the type function `symbol_index` applied to
// `arguments`, made now when it is new: its type, or 0 (reported at `at`,
// in the caller's source; what went wrong in the body is reported in
// the function's).
pub fn instantiateType(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, symbol_index: usize, arguments: [*]types_module.InstanceArgument, argument_count: usize, at: Node) -> TypeId {
    const symbol = symbols_module.symbolAt(symbols, symbol_index)
    if !isTypeFunction(types, symbol) { return 0 }
    const module_id = symbol.*.moduleId
    const declaration = symbol.*.declaration
    const existing = types_module.findInstance(types, module_id, declaration, arguments, argument_count)
    if existing != types_module.NONE {
        const instance = types_module.instanceAt(types, existing)
        if instance.*.state == types_module.INSTANCE_FAILED { return 0 }
        if instance.*.resultType == 0 {
            reportOwnership(source, path, tokens, at, diagnostic.Code.comptime_cycle, "this generic type is named inside its own body while it is being made; name it `Self` there")
            return 0
        }
        return instance.*.resultType
    }
    const context = symbols_module.moduleContext(symbols, module_id)
    if context.nodesAddress == 0 || context.scopeAddress == 0 || context.tokensAddress == 0 { return 0 }
    var generic_nodes: *NodeStore = undefined
    var generic_tokens: Buffer = undefined
    var generic_scope: *Scope = undefined
    unsafe {
        generic_nodes = @ptrFromInt(*NodeStore, context.nodesAddress)
        generic_tokens = @ptrFromInt(*Buffer, context.tokensAddress).*
        generic_scope = @ptrFromInt(*Scope, context.scopeAddress)
    }
    const generic_source = context.sourcePointer[0..context.sourceLength]
    const generic_path = context.pathPointer[0..context.pathLength]
    const function_node = ast_store.Store.get(generic_nodes, declaration)
    var parameter = function_node.lhs
    var parameter_count: usize = 0
    while parameter != ast.NONE {
        parameter_count += 1
        parameter = ast_store.Store.get(generic_nodes, parameter).next
    }
    if parameter_count != argument_count {
        reportOwnership(source, path, tokens, at, diagnostic.Code.type_mismatch, "this generic type is given another number of arguments than it has parameters")
        return 0
    }
    // The instance's scope, kept for the compilation: the parameters, then
    // the body's constants.
    const scope_memory = types.*.allocator.alloc(@sizeOf(Scope), @alignOf(Scope))
    if scope_memory == null { return 0 }
    var instance_scope: *Scope = undefined
    unsafe { instance_scope = @ptrCast(*Scope, scope_memory.?) }
    symbols_module.initRootScopeAt(instance_scope, types.*.allocator, parameter_count + 8)
    instance_scope.*.parentAddress = @intFromPtr(generic_scope)
    instance_scope.*.depth = generic_scope.*.depth + 1
    var record = types_module.Instance.{
        .moduleId = module_id,
        .declaration = declaration,
        .symbolId = symbol_index,
        .argumentsStart = 0,
        .argumentCount = 0,
        .resultType = 0,
        .scopeAddress = @intFromPtr(instance_scope),
        .state = types_module.INSTANCE_MADE,
    }
    const index = types_module.addInstance(types, &record, arguments, argument_count)
    const arguments_start = types_module.instanceAt(types, index).*.argumentsStart
    const symbols_before = symbols.*.length
    const type_type = types_module.primitive(types, types_module.Kind.type_type)
    parameter = function_node.lhs
    var position: usize = 0
    while parameter != ast.NONE && position < argument_count {
        const parameter_node = ast_store.Store.get(generic_nodes, parameter)
        const name_token = lexer.tokenAt(generic_tokens, parameter_node.mainToken)
        const name_pointer = tokenPointer(generic_source, generic_tokens, parameter_node.mainToken)
        const argument = types_module.instanceArgumentAt(types, arguments_start + position)
        var bound = symbols_module.create(name_pointer, name_token.length, parameter, type_type, argument.*.typeId, symbols_module.FLAG_CONSTANT, symbols_module.State.initialized)
        if argument.*.kind != @intCast(u8, @intFromEnum(comptime_module.Kind.type_value)) {
            var declared: TypeId = 0
            if parameter_node.lhs != ast.NONE { declared = resolveType(generic_source, generic_path, generic_tokens, generic_nodes, types, symbols, instance_scope, parameter_node.lhs) }
            if declared == 0 { declared = types_module.primitive(types, if argument.*.kind == @intCast(u8, @intFromEnum(comptime_module.Kind.boolean)) { types_module.Kind.bool_type } else { types_module.Kind.comptime_int_type }) }
            bound = symbols_module.create(name_pointer, name_token.length, parameter, declared, 0, symbols_module.FLAG_CONSTANT, symbols_module.State.initialized)
        }
        bound.comptimeTag = argument.*.kind
        bound.comptimeInteger = argument.*.integer
        const bound_index = symbols_module.append(symbols, &bound)
        const defined = symbols_module.define(instance_scope, name_pointer, name_token.length, bound_index)
        parameter = parameter_node.next
        position += 1
    }
    const salt = types_module.setInstanceSalt(types, index + 1)
    const result = evaluateTypeBody(generic_source, generic_path, generic_tokens, generic_nodes, types, symbols, instance_scope, function_node.rhs, index)
    const restored = types_module.setInstanceSalt(types, salt)
    // The symbols made for the instance (its parameters and constants, the
    // aggregates' Self and methods) belong to the function's module, where
    // their declarations are.
    var made_index = symbols_before
    while made_index < symbols.*.length {
        const made = symbols_module.symbolAt(symbols, made_index)
        if made.*.flags & symbols_module.FLAG_MODULE_ASSIGNED == 0 {
            made.*.moduleId = module_id
            made.*.flags = made.*.flags | symbols_module.FLAG_MODULE_ASSIGNED
        }
        made_index += 1
    }
    const instance = types_module.instanceAt(types, index)
    if result == 0 {
        instance.*.state = types_module.INSTANCE_FAILED
        reportOwnership(source, path, tokens, at, diagnostic.Code.type_mismatch, "this generic type could not be made")
        return 0
    }
    instance.*.resultType = result
    return result
}

// The body of a type function evaluated for one instance: its constants
// bound in `scope`, its comptime `if`s decided, the type its `return`
// gives (0 when none is reached, or something in it failed).
fn evaluateTypeBody(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, body: usize, instance: usize) -> TypeId {
    const result = evaluateTypeBlock(source, path, tokens, nodes, types, symbols, scope, body, instance)
    if !result.0 {
        if body != ast.NONE { reportOwnership(source, path, tokens, ast_store.Store.get(nodes, body), diagnostic.Code.type_mismatch, "a function returning `type` returns a type on every path") }
        return 0
    }
    return result.1
}

// (reached a `return`, its type)
fn evaluateTypeBlock(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, block_index: usize, instance: usize) -> (bool, TypeId) {
    if block_index == ast.NONE { return -> (false, 0) }
    const block = ast_store.Store.get(nodes, block_index)
    if block.tag != ast.Tag.block { return evaluateTypeStatement(source, path, tokens, nodes, types, symbols, scope, block_index, instance) }
    var statement = block.lhs
    var count: usize = 0
    while statement != ast.NONE && count < block.rhs {
        const result = evaluateTypeStatement(source, path, tokens, nodes, types, symbols, scope, statement, instance)
        if result.0 { return result }
        statement = ast_store.Store.get(nodes, statement).next
        count += 1
    }
    return -> (false, 0)
}

fn evaluateTypeStatement(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, statement_index: usize, instance: usize) -> (bool, TypeId) {
    const node = ast_store.Store.get(nodes, statement_index)
    if node.tag == ast.Tag.constant_declaration || node.tag == ast.Tag.variable_declaration {
        if !bindInstanceConstant(source, path, tokens, nodes, types, symbols, scope, statement_index, instance) { return -> (true, 0) }
        return -> (false, 0)
    }
    if node.tag == ast.Tag.return_statement {
        if node.rhs == ast.NONE {
            reportOwnership(source, path, tokens, node, diagnostic.Code.type_mismatch, "a function returning `type` returns a type")
            return -> (true, 0)
        }
        const value = expression(source, path, tokens, nodes, types, symbols, scope, node.rhs)
        if value.0 != types_module.primitive(types, types_module.Kind.type_type) || value.1 == 0 {
            const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, node.rhs)
            reportOwnership(source, path, tokens, ast_store.Store.get(nodes, node.rhs), diagnostic.Code.type_mismatch, "a function returning `type` returns a type")
            return -> (true, 0)
        }
        recordInstanceAggregate(nodes, types, node.rhs, value.1, instance)
        return -> (true, value.1)
    }
    if node.tag == ast.Tag.if_statement {
        const condition = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, node.lhs, 1000000)
        if condition.kind != comptime_module.Kind.boolean {
            const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, node.lhs)
            reportOwnership(source, path, tokens, ast_store.Store.get(nodes, node.lhs), diagnostic.Code.comptime_runtime_dependency, "the condition of an `if` in a function returning `type` is known at compile time")
            return -> (true, 0)
        }
        const chosen = if condition.integer != 0 { node.rhs } else { node.extra }
        if chosen == ast.NONE { return -> (false, 0) }
        return evaluateTypeBlock(source, path, tokens, nodes, types, symbols, scope, chosen, instance)
    }
    if node.tag == ast.Tag.block { return evaluateTypeBlock(source, path, tokens, nodes, types, symbols, scope, statement_index, instance) }
    if node.tag == ast.Tag.comptime_block { return evaluateTypeBlock(source, path, tokens, nodes, types, symbols, scope, node.lhs, instance) }
    // Anything else (`@compileError("...")`, a value dropped) is typed, and
    // fails the instance when it does not type.
    const typed = expression(source, path, tokens, nodes, types, symbols, scope, statement_index)
    if typed.0 == 0 {
        const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, statement_index)
        reportOwnership(source, path, tokens, node, diagnostic.Code.type_mismatch, "a function returning `type` is constants, comptime `if`s and a `return` of a type")
        return -> (true, 0)
    }
    return -> (false, 0)
}

// `const Entry = struct { ... }` (or any constant) in a type function's
// body, bound in the instance's scope.
fn bindInstanceConstant(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, declaration: usize, instance: usize) -> bool {
    const node = ast_store.Store.get(nodes, declaration)
    const token = lexer.tokenAt(tokens, node.mainToken)
    const pointer = tokenPointer(source, tokens, node.mainToken)
    if symbols_module.lookupCurrent(scope, pointer, token.length).0 {
        reportOwnership(source, path, tokens, node, diagnostic.Code.duplicate_symbol, "this name is declared already in this function")
        return false
    }
    var declared_type: TypeId = 0
    if node.lhs != ast.NONE {
        declared_type = resolveType(source, path, tokens, nodes, types, symbols, scope, node.lhs)
        if declared_type == 0 {
            reportOwnership(source, path, tokens, ast_store.Store.get(nodes, node.lhs), diagnostic.Code.type_mismatch, "this type could not be resolved")
            return false
        }
    }
    const inferred = expression(source, path, tokens, nodes, types, symbols, scope, node.rhs)
    if inferred.0 == 0 {
        const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, node.rhs)
        reportOwnership(source, path, tokens, node, diagnostic.Code.type_mismatch, "this constant of the function returning `type` could not be resolved")
        return false
    }
    if declared_type == 0 { declared_type = inferred.0 }
    var value = symbols_module.create(pointer, token.length, declaration, declared_type, inferred.1, symbols_module.FLAG_CONSTANT, symbols_module.State.initialized)
    const known = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, node.rhs, 1000000)
    if comptime_module.isValid(known) {
        value.comptimeTag = @intCast(u8, @intFromEnum(known.kind))
        value.comptimeInteger = known.integer
        if known.kind == comptime_module.Kind.type_value && value.valueTypeId == 0 { value.valueTypeId = known.typeId }
    }
    const symbol_index = symbols_module.append(symbols, &value)
    if !symbols_module.define(scope, pointer, token.length, symbol_index) { return false }
    if inferred.1 != 0 { recordInstanceAggregate(nodes, types, node.rhs, inferred.1, instance) }
    return true
}

// An aggregate an instance's body declares (returned, or a constant's):
// noted for the lowering to generate its methods.
fn recordInstanceAggregate(nodes: *NodeStore, types: *TypeStore, node_index: usize, type_id: TypeId, instance: usize) -> void {
    if node_index == ast.NONE || type_id == 0 { return }
    var aggregate_index = node_index
    var aggregate = ast_store.Store.get(nodes, aggregate_index)
    if aggregate.tag == ast.Tag.nocopy_type {
        if aggregate.lhs == ast.NONE { return }
        aggregate_index = aggregate.lhs
        aggregate = ast_store.Store.get(nodes, aggregate_index)
    }
    if aggregate.tag != ast.Tag.struct_type && aggregate.tag != ast.Tag.enum_type && aggregate.tag != ast.Tag.union_type { return }
    var record = types_module.InstanceAggregate.{ .instance = instance, .node = aggregate_index, .typeId = type_id, .lowered = false }
    types_module.addInstanceAggregate(types, &record)
}

pub fn expressionWithReturn(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize, return_type: TypeId) -> (TypeId, TypeId) {
    if node_index == ast.NONE { return -> (0, 0) }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.integer_literal || node.tag == ast.Tag.character_literal {
        return -> (types_module.primitive(types, types_module.Kind.comptime_int_type), 0)
    }
    if node.tag == ast.Tag.float_literal { return -> (types_module.primitive(types, types_module.Kind.comptime_float_type), 0) }
    if node.tag == ast.Tag.boolean_literal { return -> (types_module.primitive(types, types_module.Kind.bool_type), 0) }
    if node.tag == ast.Tag.unsafe_expression { return expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type) }
    if node.tag == ast.Tag.null_literal { return -> (types_module.primitive(types, types_module.Kind.null_type), 0) }
    if node.tag == ast.Tag.undefined_literal { return -> (types_module.primitive(types, types_module.Kind.undefined_type), 0) }
    if node.tag == ast.Tag.string_literal || node.tag == ast.Tag.byte_string_literal {
        const byte_type = types_module.integer(types, false, 8)
        return -> (types_module.slice(types, byte_type, true), 0)
    }
    if node.tag == ast.Tag.builtin_call {
        const builtin_kind = builtins.lookup(source, tokens, node.mainToken)
        if !builtins.acceptsArity(builtin_kind, node.rhs) { return -> (0, 0) }
        var first_type: usize = 0
        var first_value_type: usize = 0
        var second_type: usize = 0
        var second_value_type: usize = 0
        var argument = node.lhs
        var argument_index: usize = 0
        // The atomics take memory orders and an operation as bare names
        // (atomics.mlx), which are checked here rather than typed.
        const atomic = atomics.isAtomic(builtin_kind)
        var atomic_order: usize = atomics.NONE
        var atomic_second_order: usize = atomics.NONE
        while argument != ast.NONE && argument_index < node.rhs {
            if atomic && atomics.isNameArgument(builtin_kind, argument_index) {
                const name_node = ast_store.Store.get(nodes, argument)
                const name_token = lexer.tokenAt(tokens, name_node.mainToken)
                const name_pointer = tokenPointer(source, tokens, name_node.mainToken)
                const is_operation = builtin_kind == builtins.Kind.atomicRmw && argument_index == 2
                const code = if name_node.tag != ast.Tag.identifier { atomics.NONE } else if is_operation { atomics.opOf(name_pointer, name_token.length) } else { atomics.orderOf(name_pointer, name_token.length) }
                if code == atomics.NONE {
                    reportOwnership(source, path, tokens, name_node, diagnostic.Code.type_mismatch, if is_operation { "the operation of @atomicRmw is one of xchg, add, sub, and, nand, or, xor, max, min" } else { "a memory order is one of unordered, monotonic, acquire, release, acq_rel, seq_cst" })
                    return -> (0, 0)
                }
                if !is_operation {
                    if atomic_order == atomics.NONE { atomic_order = code } else { atomic_second_order = code }
                }
                argument = ast_store.Store.get(nodes, argument).next
                argument_index += 1
                continue
            }
            const argument_value = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, argument, return_type)
            if builtin_kind == builtins.Kind.spawnThread && argument_value.0 != 0 && !atomic_arguments.spawnArgumentValid(types, argument_index, argument_value.0) {
                reportOwnership(source, path, tokens, ast_store.Store.get(nodes, argument), diagnostic.Code.type_mismatch, "@spawnThread takes flags, stack, parent_tid, child_tid, tls and argument as integers and entry as a function or an address")
                return -> (0, 0)
            }
            if argument_index == 0 {
                first_type = argument_value.0
                first_value_type = argument_value.1
            }
            if argument_index == 1 {
                second_type = argument_value.0
                second_value_type = argument_value.1
            }
            if argument_value.0 == 0 { return -> (0, 0) }
            argument = ast_store.Store.get(nodes, argument).next
            argument_index += 1
        }
        if argument_index != node.rhs { return -> (0, 0) }
        if atomic {
            const problem = atomic_arguments.problem(types, builtin_kind, first_value_type, second_type, atomic_order, atomic_second_order)
            if problem.length > 0 {
                reportOwnership(source, path, tokens, node, diagnostic.Code.type_mismatch, problem)
                return -> (0, 0)
            }
        }
        if builtin_kind == builtins.Kind.import {
            if !module_model.hasImportType(node.extra) { return -> (0, 0) }
            return -> (module_model.decodeImportType(node.extra), 0)
        }
        if builtin_kind == builtins.Kind.move && node.lhs != ast.NONE {
            const source_node = ast_store.Store.get(nodes, node.lhs)
            if source_node.tag != ast.Tag.identifier { return -> (0, 0) }
            const source_token = lexer.tokenAt(tokens, source_node.mainToken)
            const source_symbol = symbols_module.lookup(scope, tokenPointer(source, tokens, source_node.mainToken), source_token.length)
            const move_token = lexer.tokenAt(tokens, node.mainToken)
            if !source_symbol.0 || !symbols_module.markMoved(symbols_module.symbolAt(symbols, source_symbol.1), move_token.start, move_token.length) { return -> (0, 0) }
        }
        if builtin_kind == builtins.Kind.Vector && node.lhs != ast.NONE && second_value_type != 0 {
            const length_node = ast_store.Store.get(nodes, node.lhs)
            if length_node.tag != ast.Tag.integer_literal { return -> (0, 0) }
            const length = types_module.parseUnsigned(source, tokens, length_node.mainToken)
            const vector_type = types_module.vectorType(types, second_value_type, length)
            if vector_type == 0 { return -> (0, 0) }
            return -> (types_module.primitive(types, types_module.Kind.type_type), vector_type)
        }
        if builtin_kind == builtins.Kind.field && node.lhs != ast.NONE {
            const name_index = ast_store.Store.get(nodes, node.lhs).next
            if name_index == ast.NONE { return -> (0, 0) }
            const name_node = ast_store.Store.get(nodes, name_index)
            const name_token = lexer.tokenAt(tokens, name_node.mainToken)
            if name_node.tag != ast.Tag.string_literal || name_token.length < 2 { return -> (0, 0) }
            unsafe {
                const quoted = tokenPointer(source, tokens, name_node.mainToken)
                const name_pointer = @ptrFromInt([*]const u8, @intFromPtr(quoted) + 1)
                const field_index = fieldIndex(types, first_type, name_pointer, name_token.length - 2)
                if field_index == types_module.NONE { return -> (0, 0) }
                return -> (types_module.fieldAt(types, field_index).*.typeId, 0)
            }
        }
        if builtin_kind == builtins.Kind.intFromEnum {
            const enum_type = types_module.get(types, first_type)
            if enum_type.*.kind != types_module.Kind.enum_type || enum_type.*.backing == types_module.NONE { return -> (0, 0) }
            return -> (enum_type.*.backing, 0)
        }
        if builtin_kind == builtins.Kind.tagOf {
            const union_type = types_module.get(types, first_type)
            if union_type.*.kind != types_module.Kind.union_type || union_type.*.backing == types_module.NONE { return -> (0, 0) }
            return -> (union_type.*.backing, 0)
        }
        return builtins.result(builtin_kind, first_type, first_value_type, second_type, second_value_type, types)
    }
    // A name the type parser wrote (`generic` in `generic.Wrapper(T)` of a
    // type position) is whatever symbol it names, as an identifier is.
    if node.tag == ast.Tag.named_type {
        const name_token = lexer.tokenAt(tokens, node.mainToken)
        const named = symbols_module.lookup(scope, tokenPointer(source, tokens, node.mainToken), name_token.length)
        if named.0 {
            analyzeAhead(source, path, tokens, nodes, types, symbols, scope, named.1)
            const named_symbol = symbols_module.symbolAt(symbols, named.1)
            if named_symbol.*.typeId != 0 && named_symbol.*.typeId != types_module.primitive(types, types_module.Kind.type_type) { return -> (named_symbol.*.typeId, named_symbol.*.valueTypeId) }
        }
    }
    if node.tag == ast.Tag.named_type || node.tag == ast.Tag.pointer_type || node.tag == ast.Tag.many_pointer_type || node.tag == ast.Tag.slice_type || node.tag == ast.Tag.array_type || node.tag == ast.Tag.optional_type || node.tag == ast.Tag.error_union_type || node.tag == ast.Tag.nocopy_type || node.tag == ast.Tag.function_type || node.tag == ast.Tag.tuple_type || node.tag == ast.Tag.struct_type || node.tag == ast.Tag.enum_type || node.tag == ast.Tag.union_type || node.tag == ast.Tag.error_set_type {
        const value_type = resolveType(source, path, tokens, nodes, types, symbols, scope, node_index)
        if value_type == 0 { return -> (0, 0) }
        return -> (types_module.primitive(types, types_module.Kind.type_type), value_type)
    }
    if node.tag == ast.Tag.identifier {
        const token = lexer.tokenAt(tokens, node.mainToken)
        const found = symbols_module.lookup(scope, tokenPointer(source, tokens, node.mainToken), token.length)
        if !found.0 {
            const builtin_type = types_module.resolveName(source, tokens, node.mainToken, types)
            if builtin_type != 0 { return -> (types_module.primitive(types, types_module.Kind.type_type), builtin_type) }
            // Not reported here: expressionWithReturn is also used to probe
            // type-name arguments in generic-call return inference (see
            // genericCallReturnType), where an unresolved identifier is a
            // normal, silently-tolerated "try something else" signal rather
            // than a real error. Reporting unconditionally here produced
            // hundreds of false positives when self-hosting compiled its own
            // sources (e.g. `Node`, `Store`, `Parser` used as generic type
            // arguments) even though those programs compile successfully.
            // A statement that fails asks sema/unknown_names.mlx instead.
            return -> (0, 0)
        }
        analyzeAhead(source, path, tokens, nodes, types, symbols, scope, found.1)
        const symbol = symbols_module.symbolAt(symbols, found.1)
        if symbol.*.state == symbols_module.State.moved || symbol.*.state == symbols_module.State.partially_moved {
            reportOwnership(source, path, tokens, node, diagnostic.Code.use_after_move, "use of moved value")
            reportMovedHere(source, path, symbol.*.movedAtByte, symbol.*.movedAtLength)
            const moved_help = diagnostic.render(diagnostic.help(diagnostic.Phase.sema, token.start, token.start + token.length, "reinitialize the value before using it again, or avoid moving it more than once"), path, source)
            return -> (0, 0)
        }
        return -> (symbol.*.typeId, symbol.*.valueTypeId)
    }
    if node.tag == ast.Tag.field_expression && node.lhs != ast.NONE {
        var base_type: TypeId = 0
        var base_value_type: TypeId = 0
        const base_node = ast_store.Store.get(nodes, node.lhs)
        if base_node.tag == ast.Tag.named_type {
            const base_token = lexer.tokenAt(tokens, base_node.mainToken)
            const base_symbol = symbols_module.lookup(scope, tokenPointer(source, tokens, base_node.mainToken), base_token.length)
            if base_symbol.0 {
                const symbol = symbols_module.symbolAt(symbols, base_symbol.1)
                base_type = symbol.*.typeId
                base_value_type = symbol.*.valueTypeId
            }
        } else {
            const base = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
            base_type = base.0
            base_value_type = base.1
        }
        if base_type == 0 { return -> (0, 0) }
        const base_type_value = types_module.get(types, base_type)
        const field_token = lexer.tokenAt(tokens, node.mainToken)
        const field_pointer = tokenPointer(source, tokens, node.mainToken)
        if base_type_value.*.kind == types_module.Kind.module {
            var declaration_index: usize = 0
            while declaration_index < base_type_value.*.extraLength {
                const symbol_index = types_module.extraAt(types, base_type_value.*.extraStart + declaration_index)
                const declaration = symbols_module.symbolAt(symbols, symbol_index)
                if sameName(declaration.*.namePointer, declaration.*.nameLength, field_pointer, field_token.length) {
                    if declaration.*.flags & symbols_module.FLAG_PUBLIC == 0 { return -> (0, 0) }
                    return -> (declaration.*.typeId, declaration.*.valueTypeId)
                }
                declaration_index += 1
            }
            return -> (0, 0)
        }
        if base_type == types_module.primitive(types, types_module.Kind.type_type) && base_value_type != 0 {
            const reflected = types_module.get(types, base_value_type)
            if reflected.*.kind == types_module.Kind.enum_type || reflected.*.kind == types_module.Kind.error_set {
                if fieldIndex(types, base_value_type, field_pointer, field_token.length) != types_module.NONE { return -> (base_value_type, 0) }
            }
            const method = aggregateMethodCompatible(types, symbols, base_value_type, field_pointer, field_token.length)
            if method.0 { return -> (symbols_module.symbolAt(symbols, method.1).*.typeId, 0) }
            return -> (0, 0)
        }
        // `pointer.method`: a method of what the pointer points to (its
        // fields are `pointer.*.field`).
        var owner_type = base_type
        if base_type_value.*.kind == types_module.Kind.pointer && base_type_value.*.lhs != 0 { owner_type = base_type_value.*.lhs }
        const owner_kind = types_module.get(types, owner_type).*.kind
        if owner_kind == types_module.Kind.struct_type || owner_kind == types_module.Kind.union_type || owner_kind == types_module.Kind.enum_type {
            const method = aggregateMethodCompatible(types, symbols, owner_type, field_pointer, field_token.length)
            if method.0 { return -> (symbols_module.symbolAt(symbols, method.1).*.typeId, 0) }
        }
        if base_type_value.*.kind == types_module.Kind.struct_type || base_type_value.*.kind == types_module.Kind.union_type {
            const field_index = fieldIndex(types, base_type, field_pointer, field_token.length)
            if field_index == types_module.NONE { return -> (0, 0) }
            return -> (types_module.fieldAt(types, field_index).*.typeId, 0)
        }
        if base_type_value.*.kind == types_module.Kind.tuple && field_token.kind == lexer.Kind.integer {
            const tuple_index = types_module.parseUnsigned(source, tokens, node.mainToken)
            if tuple_index >= base_type_value.*.extraLength { return -> (0, 0) }
            return -> (types_module.extraAt(types, base_type_value.*.extraStart + tuple_index), 0)
        }
        if base_type_value.*.kind == types_module.Kind.slice || base_type_value.*.kind == types_module.Kind.array {
            unsafe {
                if sameName(field_pointer, field_token.length, @ptrCast([*]const u8, "length"), 6) { return -> (types_module.sizeInteger(types, false), 0) }
                // A slice's first word: a many-item pointer to its elements,
                // const when the slice is.
                if base_type_value.*.kind == types_module.Kind.slice && sameName(field_pointer, field_token.length, @ptrCast([*]const u8, "pointer"), 7) {
                    const element = base_type_value.*.lhs
                    const constant = base_type_value.*.flags & types_module.FLAG_CONSTANT != 0
                    return -> (types_module.pointer(types, element, constant, false, true), 0)
                }
            }
        }
        return -> (0, 0)
    }
    if node.tag == ast.Tag.tuple_literal {
        const extra_start = types.*.extraIds.*.length
        var child = node.lhs
        var count: usize = 0
        while child != ast.NONE && count < node.rhs {
            const value = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, child, return_type)
            if value.0 == 0 { return -> (0, 0) }
            types_module.appendExtra(types, value.0)
            child = ast_store.Store.get(nodes, child).next
            count += 1
        }
        if count != node.rhs { return -> (0, 0) }
        return -> (types_module.tuple(types, extra_start, count), 0)
    }
    if node.tag == ast.Tag.array_literal {
        const child_type = resolveType(source, path, tokens, nodes, types, symbols, scope, node.endToken)
        if child_type == 0 { return -> (0, 0) }
        var declared_length = node.rhs
        if node.extra != ast.NONE {
            const length_node = ast_store.Store.get(nodes, node.extra)
            if length_node.tag != ast.Tag.integer_literal { return -> (0, 0) }
            declared_length = types_module.parseUnsigned(source, tokens, length_node.mainToken)
        }
        if declared_length != node.rhs { return -> (0, 0) }
        var child = node.lhs
        var count: usize = 0
        while child != ast.NONE && count < node.rhs {
            const value = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, child, return_type)
            if value.0 == 0 || !types_module.isCoercible(types, value.0, child_type) || literal_fit.misfit(source, tokens, nodes, types, child, child_type) { return -> (0, 0) }
            child = ast_store.Store.get(nodes, child).next
            count += 1
        }
        if count != node.rhs { return -> (0, 0) }
        return -> (types_module.array(types, child_type, declared_length), 0)
    }
    if node.tag == ast.Tag.aggregate_literal {
        const prefix = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if prefix.0 != types_module.primitive(types, types_module.Kind.type_type) || prefix.1 == 0 { return -> (0, 0) }
        const aggregate = types_module.get(types, prefix.1)
        if aggregate.*.kind != types_module.Kind.struct_type && aggregate.*.kind != types_module.Kind.union_type { return -> (0, 0) }
        if aggregate.*.kind == types_module.Kind.union_type && node.extra != 1 { return -> (0, 0) }
        var field_node = node.rhs
        var field_count: usize = 0
        while field_node != ast.NONE && field_count < node.extra {
            const initializer = ast_store.Store.get(nodes, field_node)
            if initializer.tag != ast.Tag.field_declaration || initializer.rhs == ast.NONE { return -> (0, 0) }
            const name_token = lexer.tokenAt(tokens, initializer.mainToken)
            const name_pointer = tokenPointer(source, tokens, initializer.mainToken)
            const field_index = fieldIndex(types, prefix.1, name_pointer, name_token.length)
            if field_index == types_module.NONE { return -> (0, 0) }
            const actual = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, initializer.rhs, return_type)
            const field_type = types_module.fieldAt(types, field_index).*.typeId
            if actual.0 == 0 || !types_module.isCoercible(types, actual.0, field_type) || literal_fit.misfit(source, tokens, nodes, types, initializer.rhs, field_type) { return -> (0, 0) }
            var previous = node.rhs
            var previous_count: usize = 0
            while previous != field_node && previous != ast.NONE && previous_count < field_count {
                const previous_node = ast_store.Store.get(nodes, previous)
                const previous_token = lexer.tokenAt(tokens, previous_node.mainToken)
                if sameName(tokenPointer(source, tokens, previous_node.mainToken), previous_token.length, name_pointer, name_token.length) { return -> (0, 0) }
                previous = previous_node.next
                previous_count += 1
            }
            field_node = initializer.next
            field_count += 1
        }
        if field_count != node.extra { return -> (0, 0) }
        if aggregate.*.kind == types_module.Kind.struct_type {
            var expected_index: usize = 0
            while expected_index < aggregate.*.extraLength {
                const expected = types_module.fieldAt(types, aggregate.*.extraStart + expected_index)
                var found = false
                var initialized = node.rhs
                var initialized_count: usize = 0
                while initialized != ast.NONE && initialized_count < node.extra {
                    const initialized_node = ast_store.Store.get(nodes, initialized)
                    const initialized_token = lexer.tokenAt(tokens, initialized_node.mainToken)
                    if sameName(expected.*.namePointer, expected.*.nameLength, tokenPointer(source, tokens, initialized_node.mainToken), initialized_token.length) { found = true }
                    initialized = initialized_node.next
                    initialized_count += 1
                }
                if !found { return -> (0, 0) }
                expected_index += 1
            }
        }
        return -> (prefix.1, 0)
    }
    if node.tag == ast.Tag.index_expression {
        const container = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        const index = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
        if container.0 == 0 || !predicates.isInteger(types, index.0) { return -> (0, 0) }
        const child_type = predicates.elementType(types, container.0)
        if child_type == 0 { return -> (0, 0) }
        return -> (child_type, 0)
    }
    if node.tag == ast.Tag.slice_expression {
        const container = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if container.0 == 0 { return -> (0, 0) }
        if node.rhs != ast.NONE {
            const lower = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
            if !predicates.isInteger(types, lower.0) { return -> (0, 0) }
        }
        if node.extra != ast.NONE {
            const upper = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.extra, return_type)
            if !predicates.isInteger(types, upper.0) { return -> (0, 0) }
        }
        const child_type = predicates.elementType(types, container.0)
        if child_type == 0 { return -> (0, 0) }
        const container_type = types_module.get(types, container.0)
        return -> (types_module.slice(types, child_type, container_type.*.flags & types_module.FLAG_CONSTANT != 0), 0)
    }
    if node.tag == ast.Tag.range_expression {
        const lower = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        const upper = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
        if !predicates.isInteger(types, lower.0) || !predicates.isInteger(types, upper.0) { return -> (0, 0) }
        if types_module.isCoercible(types, upper.0, lower.0) { return lower }
        if types_module.isCoercible(types, lower.0, upper.0) { return upper }
        return -> (0, 0)
    }
    if node.tag == ast.Tag.unary_expression {
        const operand = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if operand.0 == 0 { return -> (0, 0) }
        const operator = lexer.tokenAt(tokens, node.mainToken).kind
        const operand_type = types_module.get(types, operand.0)
        if operator == lexer.Kind.keyword_try {
            if operand_type.*.kind != types_module.Kind.error_union || return_type == 0 || types_module.get(types, return_type).*.kind != types_module.Kind.error_union { return -> (0, 0) }
            return -> (operand_type.*.rhs, 0)
        }
        if operator == lexer.Kind.keyword_comptime { return operand }
        if operator == lexer.Kind.dot_asterisk {
            if operand_type.*.kind != types_module.Kind.pointer && operand_type.*.kind != types_module.Kind.many_pointer { return -> (0, 0) }
            return -> (operand_type.*.lhs, 0)
        }
        if operator == lexer.Kind.dot_question {
            if operand_type.*.kind != types_module.Kind.optional { return -> (0, 0) }
            return -> (operand_type.*.lhs, 0)
        }
        if operator == lexer.Kind.ampersand {
            if !isAddressable(nodes, node.lhs) { return -> (0, 0) }
            // A field or element is as writable as the place it is in (a
            // variable, or what a mutable pointer points to).
            const is_const = !isMutable(source, path, tokens, nodes, types, symbols, scope, node.lhs)
            return -> (types_module.pointer(types, operand.0, is_const, false, false), 0)
        }
        if operator == lexer.Kind.bang {
            if operand_type.*.kind != types_module.Kind.bool_type { return -> (0, 0) }
            return -> (types_module.primitive(types, types_module.Kind.bool_type), 0)
        }
        if operator == lexer.Kind.minus {
            if !predicates.isNumeric(types, operand.0) { return -> (0, 0) }
            return operand
        }
        if operator == lexer.Kind.tilde {
            if !predicates.isInteger(types, operand.0) { return -> (0, 0) }
            return operand
        }
        return -> (0, 0)
    }
    if node.tag == ast.Tag.binary_expression {
        const operator = lexer.tokenAt(tokens, node.mainToken).kind
        // `_ = value`: the value, dropped.
        if operator == lexer.Kind.equal && isDiscard(source, tokens, nodes, node.lhs) {
            const dropped = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
            if dropped.0 == 0 { return -> (0, 0) }
            // An error union stays one: it must still be handled.
            if types_module.get(types, dropped.0).*.kind == types_module.Kind.error_union { return -> (dropped.0, 0) }
            return -> (types_module.primitive(types, types_module.Kind.void_type), 0)
        }
        var left = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if operator == lexer.Kind.equal {
            const reinitialized = reinitializationTarget(source, path, tokens, nodes, symbols, scope, node.lhs)
            if reinitialized.0 != 0 { left = reinitialized }
        }
        const right = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
        if left.0 == 0 || right.0 == 0 { return -> (0, 0) }
        if predicates.isAssignment(operator) {
            const stepping = predicates.isPointerStep(types, operator, left.0, right.0)
            if !isAddressable(nodes, node.lhs) || !isMutable(source, path, tokens, nodes, types, symbols, scope, node.lhs) || (!stepping && (!types_module.isCoercible(types, right.0, left.0) || literal_fit.misfit(source, tokens, nodes, types, node.rhs, left.0))) { return -> (0, 0) }
            if operator != lexer.Kind.equal && !stepping && !predicates.isNumeric(types, left.0) && !predicates.isInteger(types, left.0) { return -> (0, 0) }
            if operator == lexer.Kind.equal {
                const target = ast_store.Store.get(nodes, node.lhs)
                if target.tag == ast.Tag.identifier {
                    const target_token = lexer.tokenAt(tokens, target.mainToken)
                    const target_symbol = symbols_module.lookup(scope, tokenPointer(source, tokens, target.mainToken), target_token.length)
                    if target_symbol.0 { symbols_module.symbolAt(symbols, target_symbol.1).*.state = symbols_module.State.initialized }
                }
            }
            return -> (types_module.primitive(types, types_module.Kind.void_type), 0)
        }
        if predicates.isComparison(operator) {
            if !types_module.isCoercible(types, right.0, left.0) && !types_module.isCoercible(types, left.0, right.0) { return -> (0, 0) }
            return -> (types_module.primitive(types, types_module.Kind.bool_type), 0)
        }
        if predicates.isLogical(operator) {
            const bool_type = types_module.primitive(types, types_module.Kind.bool_type)
            if left.0 != bool_type || right.0 != bool_type { return -> (0, 0) }
            return -> (bool_type, 0)
        }
        if predicates.isPointerStep(types, operator, left.0, right.0) { return -> (left.0, 0) }
        if predicates.isShift(operator) {
            if !predicates.isInteger(types, left.0) || !predicates.isInteger(types, right.0) { return -> (0, 0) }
            return left
        } else if predicates.isBitwise(operator) {
            if !predicates.isInteger(types, left.0) || !predicates.isInteger(types, right.0) { return -> (0, 0) }
        } else if predicates.isArithmetic(operator) {
            if !predicates.isNumeric(types, left.0) || !predicates.isNumeric(types, right.0) { return -> (0, 0) }
        } else {
            return -> (0, 0)
        }
        if types_module.isCoercible(types, right.0, left.0) { return left }
        if types_module.isCoercible(types, left.0, right.0) { return right }
        return -> (0, 0)
    }
    if node.tag == ast.Tag.call_expression {
        const callee_symbol = referencedFunctionSymbol(source, path, tokens, nodes, types, symbols, scope, node.lhs)
        if callee_symbol.0 && isTypeFunction(types, symbols_module.symbolAt(symbols, callee_symbol.1)) {
            return typeFunctionCall(source, path, tokens, nodes, types, symbols, scope, node, callee_symbol.1, return_type)
        }
        const callee = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if callee.0 == 0 { return -> (0, 0) }
        const function_type = types_module.get(types, callee.0)
        if function_type.*.kind != types_module.Kind.function { return -> (0, 0) }
        var receiver: usize = ast.NONE
        if callee_symbol.0 {
            const referenced_symbol = symbols_module.symbolAt(symbols, callee_symbol.1)
            const callee_node = ast_store.Store.get(nodes, node.lhs)
            if referenced_symbol.*.ownerTypeId != 0 && callee_node.tag == ast.Tag.field_expression && callee_node.lhs != ast.NONE {
                const base = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, callee_node.lhs, return_type)
                if base.0 != types_module.primitive(types, types_module.Kind.type_type) { receiver = callee_node.lhs }
            }
        }
        const implicit_count: usize = if receiver == ast.NONE { 0 } else { 1 }
        if function_type.*.extraLength != node.extra + implicit_count { return -> (0, 0) }
        if receiver != ast.NONE {
            const actual_receiver = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, receiver, return_type)
            const current_function_type = types_module.get(types, callee.0)
            const expected_receiver = types_module.extraAt(types, current_function_type.*.extraStart)
            if actual_receiver.0 == 0 { return -> (0, 0) }
            // A value the method takes by pointer goes by its address, when
            // it has one (as `&value` would be typed).
            if !types_module.isCoercible(types, actual_receiver.0, expected_receiver) {
                if !isAddressable(nodes, receiver) { return -> (0, 0) }
                const address = types_module.pointer(types, actual_receiver.0, !isMutable(source, path, tokens, nodes, types, symbols, scope, receiver), false, false)
                if !types_module.isCoercible(types, address, expected_receiver) { return -> (0, 0) }
            }
        }
        var argument = node.rhs
        var index: usize = 0
        var inferred_result: usize = 0
        while argument != ast.NONE && index < node.extra {
            const actual = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, argument, return_type)
            // Recursive argument analysis may intern types and reallocate the
            // type vector, so reacquire the function record before reading it.
            const current_function_type = types_module.get(types, callee.0)
            const expected = types_module.extraAt(types, current_function_type.*.extraStart + index + implicit_count)
            if actual.0 == 0 || !types_module.isCoercible(types, actual.0, expected) || literal_fit.misfit(source, tokens, nodes, types, argument, expected) { return -> (0, 0) }
            if types_module.get(types, expected).*.kind == types_module.Kind.anytype_type { inferred_result = actual.0 }
            argument = ast_store.Store.get(nodes, argument).next
            index += 1
        }
        if index != node.extra { return -> (0, 0) }
        const current_function_type = types_module.get(types, callee.0)
        if types_module.get(types, current_function_type.*.lhs).*.kind == types_module.Kind.anytype_type {
            if callee_symbol.0 {
                const specialized_return = genericCallReturnType(source, path, tokens, nodes, types, symbols, scope, node, symbols_module.symbolAt(symbols, callee_symbol.1), return_type)
                if specialized_return != 0 { return -> (specialized_return, 0) }
            }
            if inferred_result != 0 { return -> (inferred_result, 0) }
        }
        return -> (current_function_type.*.lhs, 0)
    }
    if node.tag == ast.Tag.if_statement {
        const condition = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if condition.0 != types_module.primitive(types, types_module.Kind.bool_type) { return -> (0, 0) }
        const condition_value = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, node.lhs, 1000000)
        if condition_value.kind == comptime_module.Kind.boolean {
            return expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, if condition_value.integer != 0 { node.rhs } else { node.extra }, return_type)
        }
        const then_value = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.rhs, return_type)
        const else_value = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.extra, return_type)
        if then_value.0 == else_value.0 { return then_value }
        if types_module.isCoercible(types, else_value.0, then_value.0) { return then_value }
        if types_module.isCoercible(types, then_value.0, else_value.0) { return else_value }
        return -> (0, 0)
    }
    if node.tag == ast.Tag.match_statement {
        const subject = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if subject.0 == 0 { return -> (0, 0) }
        var arm_index = node.rhs
        var arm_count: usize = 0
        var result_type: TypeId = 0
        while arm_index != ast.NONE && arm_count < node.extra {
            const arm = ast_store.Store.get(nodes, arm_index)
            if !matchPattern(source, path, tokens, nodes, types, symbols, scope, subject.0, arm.lhs, return_type) { return -> (0, 0) }
            const arm_value = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, arm.rhs, return_type)
            if arm_value.0 == 0 { return -> (0, 0) }
            if result_type == 0 {
                result_type = arm_value.0
            } else if types_module.isCoercible(types, arm_value.0, result_type) {
            } else if types_module.isCoercible(types, result_type, arm_value.0) {
                result_type = arm_value.0
            } else {
                return -> (0, 0)
            }
            arm_index = arm.next
            arm_count += 1
        }
        if arm_count != node.extra || result_type == 0 { return -> (0, 0) }
        return -> (result_type, 0)
    }
    if node.tag == ast.Tag.while_statement || node.tag == ast.Tag.inline_while_statement {
        const condition = expressionWithReturn(source, path, tokens, nodes, types, symbols, scope, node.lhs, return_type)
        if condition.0 != types_module.primitive(types, types_module.Kind.bool_type) { return -> (0, 0) }
        const break_type = loopBreakValueType(source, path, tokens, nodes, types, symbols, scope, node.rhs, node.endToken, return_type)
        if break_type.0 != 0 { return break_type }
        return -> (types_module.primitive(types, types_module.Kind.void_type), 0)
    }
    return -> (0, 0)
}

// Module-level declarations resolve in any order: one used before `root`
// reached it (a type declared further down) is analyzed then, in the
// module's scope, and `root` skips it later. One being analyzed already is
// part of a cycle and stays unresolved.
fn analyzeAhead(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, symbol_index: usize) -> void {
    const symbol = symbols_module.symbolAt(symbols, symbol_index)
    if symbol.*.typeId != 0 || symbol.*.state != symbols_module.State.declared || symbol.*.flags & (symbols_module.FLAG_FUNCTION | symbols_module.FLAG_PARAMETER) != 0 { return }
    var module_scope = scope
    while module_scope.*.parentAddress != 0 {
        unsafe { module_scope = @ptrFromInt(*Scope, module_scope.*.parentAddress) }
    }
    const own = symbols_module.lookupCurrent(module_scope, symbol.*.namePointer, symbol.*.nameLength)
    if !own.0 || own.1 != symbol_index || symbol.*.declaration == ast.NONE { return }
    const node = ast_store.Store.get(nodes, symbol.*.declaration)
    if node.tag != ast.Tag.constant_declaration && node.tag != ast.Tag.variable_declaration { return }
    // A failure stays `initializing`, for `root` to count.
    if analyzeBinding(source, path, tokens, nodes, types, symbols, module_scope, symbol.*.declaration) != 0 {
        symbols_module.symbolAt(symbols, symbol_index).*.state = symbols_module.State.initializing
    }
}

// What the type written at `node_index` names, analyzed ahead before an
// aggregate or a tuple starts appending its fields or parts: one analyzed
// in the middle would append its own in between.
fn analyzeTypeAhead(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> void {
    if node_index == ast.NONE { return }
    const node = ast_store.Store.get(nodes, node_index)
    if node.tag == ast.Tag.named_type || node.tag == ast.Tag.identifier {
        const found = symbolFor(source, path, tokens, scope, node)
        if found.0 { analyzeAhead(source, path, tokens, nodes, types, symbols, scope, found.1) }
    } else if node.tag == ast.Tag.array_type || node.tag == ast.Tag.error_union_type {
        analyzeTypeAhead(source, path, tokens, nodes, types, symbols, scope, node.rhs)
    } else if node.tag == ast.Tag.function_type || node.tag == ast.Tag.tuple_type {
        var child = node.lhs
        var count: usize = 0
        while child != ast.NONE && count < node.rhs {
            analyzeTypeAhead(source, path, tokens, nodes, types, symbols, scope, child)
            child = ast_store.Store.get(nodes, child).next
            count += 1
        }
        if node.tag == ast.Tag.function_type { analyzeTypeAhead(source, path, tokens, nodes, types, symbols, scope, node.extra) }
    } else if node.tag == ast.Tag.pointer_type || node.tag == ast.Tag.many_pointer_type || node.tag == ast.Tag.slice_type || node.tag == ast.Tag.optional_type || node.tag == ast.Tag.nocopy_type {
        analyzeTypeAhead(source, path, tokens, nodes, types, symbols, scope, node.lhs)
    } else if node.tag == ast.Tag.call_expression || node.tag == ast.Tag.struct_type || node.tag == ast.Tag.union_type || node.tag == ast.Tag.enum_type {
        // A generic type applied (`List(V)`, made now when it is new) or
        // an aggregate written in place: resolved ahead, as either appends
        // the fields of an aggregate of its own.
        const resolved = resolveType(source, path, tokens, nodes, types, symbols, scope, node_index)
    }
}

// A module-level binding typed; when it fails, its unknown names and
// "declaration type could not be resolved" are said at it (they used to be
// said only for the whole file, at its first line).
fn analyzeBinding(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, declaration: usize) -> usize {
    const errors = bindingErrors(source, path, tokens, nodes, types, symbols, scope, declaration)
    if errors > 0 {
        const node = ast_store.Store.get(nodes, declaration)
        const unknown = unknown_names.report(source, path, tokens, nodes, types, scope, node.rhs)
        reportOwnership(source, path, tokens, node, diagnostic.Code.type_mismatch, "declaration type could not be resolved")
    }
    return errors
}

fn bindingErrors(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, declaration: usize) -> usize {
    const node = ast_store.Store.get(nodes, declaration)
    const found = symbolFor(source, path, tokens, scope, node)
    if !found.0 { return 1 }
    const symbol = symbols_module.symbolAt(symbols, found.1)
    symbol.*.state = symbols_module.State.initializing
    var declared_type: TypeId = 0
    if node.lhs != ast.NONE {
        declared_type = resolveType(source, path, tokens, nodes, types, symbols, scope, node.lhs)
        // A written-out type that does not resolve is an error of its
        // own: taking the initializer's type instead would give the
        // binding a size the annotation never asked for, and `undefined`
        // has none to give (an array of a length nobody worked out used
        // to leave a binding too small for what was written into it).
        if declared_type == 0 {
            reportOwnership(source, path, tokens, ast_store.Store.get(nodes, node.lhs), diagnostic.Code.type_mismatch, "this type could not be resolved")
            return 1
        }
    }
    const inferred = expression(source, path, tokens, nodes, types, symbols, scope, node.rhs)
    if declared_type == 0 { declared_type = inferred.0 }
    if declared_type == 0 { return 1 }
    var errors: usize = 0
    var ownership_error = false
    if inferred.0 != 0 && types_module.get(types, inferred.0).*.copyability != types_module.Copyability.copyable {
        const initializer = ast_store.Store.get(nodes, node.rhs)
        if initializer.tag == ast.Tag.identifier || initializer.tag == ast.Tag.field_expression {
            reportOwnership(source, path, tokens, initializer, diagnostic.Code.copy_noncopy, "non-copyable value requires @move")
            const initializer_token = lexer.tokenAt(tokens, initializer.mainToken)
            const copy_help = diagnostic.render(diagnostic.help(diagnostic.Phase.sema, initializer_token.start, initializer_token.start + initializer_token.length, "wrap the value in @move(...) to transfer ownership instead of copying"), path, source)
            errors += 1
            ownership_error = true
        }
    }
    if !ownership_error && mismatch.say(source, path, tokens, nodes, types, symbols, node.rhs, inferred.0, declared_type) { errors += 1 }
    if node.rhs != ast.NONE && inferred.0 == 0 { errors += 1 }
    // Resolving the initializer can append symbols (an aggregate's Self and
    // methods) and move the store, so the symbol is looked up again.
    const resolved = symbols_module.symbolAt(symbols, found.1)
    resolved.*.typeId = declared_type
    resolved.*.valueTypeId = inferred.1
    if node.tag == ast.Tag.constant_declaration {
        const comptime_value = comptime_module.evaluate(source, tokens, nodes, types, symbols, scope, node.rhs, 1000000)
        const evaluated = symbols_module.symbolAt(symbols, found.1)
        if comptime_module.isValid(comptime_value) {
            evaluated.*.comptimeTag = @intCast(u8, @intFromEnum(comptime_value.kind))
            evaluated.*.comptimeInteger = comptime_value.integer
            if comptime_value.kind == comptime_module.Kind.type_value && evaluated.*.valueTypeId == 0 { evaluated.*.valueTypeId = comptime_value.typeId }
        }
        // `export const` is a data symbol for C code (lir.DataExport): a
        // word of an integer type with a value known here.
        if evaluated.*.flags & symbols_module.FLAG_EXPORT != 0 && (comptime_value.kind != comptime_module.Kind.integer || types_module.get(types, declared_type).*.kind != types_module.Kind.integer) {
            reportOwnership(source, path, tokens, node, diagnostic.Code.type_mismatch, "an exported constant needs an integer type (u8 to u64, i8 to i64, usize) and a compile-time value")
            errors += 1
        }
    }
    symbols_module.symbolAt(symbols, found.1).*.state = symbols_module.State.initialized
    return errors
}

// Whether the type written at `type_node_index` names a comptime type
// parameter of the function anywhere in it: `T`, `[*]T`, `?*T`,
// `[]const T`, `[4]T`, `Box(T)`. Such a type is concrete per instance
// (the lowering resolves it with the instance's arguments bound,
// ir/lower.mlx resolveTypeNode; sema types the call's result with them,
// genericCallReturnType) and `anytype` in the function's own type.
fn isComptimeTypeParameterName(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, function_node: Node, stop_parameter: usize, type_node_index: usize) -> bool {
    if type_node_index == ast.NONE { return false }
    const type_node = ast_store.Store.get(nodes, type_node_index)
    if type_node.tag == ast.Tag.pointer_type || type_node.tag == ast.Tag.many_pointer_type || type_node.tag == ast.Tag.slice_type || type_node.tag == ast.Tag.optional_type || type_node.tag == ast.Tag.nocopy_type {
        return isComptimeTypeParameterName(source, path, tokens, nodes, function_node, stop_parameter, type_node.lhs)
    }
    if type_node.tag == ast.Tag.array_type || type_node.tag == ast.Tag.error_union_type {
        return isComptimeTypeParameterName(source, path, tokens, nodes, function_node, stop_parameter, type_node.rhs) || isComptimeTypeParameterName(source, path, tokens, nodes, function_node, stop_parameter, type_node.lhs)
    }
    if type_node.tag == ast.Tag.function_type || type_node.tag == ast.Tag.tuple_type || type_node.tag == ast.Tag.call_expression {
        var child = if type_node.tag == ast.Tag.call_expression { type_node.rhs } else { type_node.lhs }
        while child != ast.NONE {
            if isComptimeTypeParameterName(source, path, tokens, nodes, function_node, stop_parameter, child) { return true }
            child = ast_store.Store.get(nodes, child).next
        }
        if type_node.tag == ast.Tag.function_type { return isComptimeTypeParameterName(source, path, tokens, nodes, function_node, stop_parameter, type_node.extra) }
        return false
    }
    if type_node.tag != ast.Tag.named_type && type_node.tag != ast.Tag.identifier { return false }
    const type_token = lexer.tokenAt(tokens, type_node.mainToken)
    var parameter = function_node.lhs
    while parameter != ast.NONE && parameter != stop_parameter {
        const parameter_node = ast_store.Store.get(nodes, parameter)
        if parameter_node.extra & 1 != 0 {
            const parameter_token = lexer.tokenAt(tokens, parameter_node.mainToken)
            if sameName(tokenPointer(source, tokens, parameter_node.mainToken), parameter_token.length, tokenPointer(source, tokens, type_node.mainToken), type_token.length) { return true }
        }
        parameter = parameter_node.next
    }
    return false
}

fn genericParameterIndexForNode(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, function_node: Node, node_index: usize) -> usize {
    if node_index == ast.NONE { return types_module.NONE }
    const identifier = ast_store.Store.get(nodes, node_index)
    if identifier.tag != ast.Tag.identifier && identifier.tag != ast.Tag.named_type { return types_module.NONE }
    const identifier_token = lexer.tokenAt(tokens, identifier.mainToken)
    const identifier_pointer = tokenPointer(source, tokens, identifier.mainToken)
    var parameter = function_node.lhs
    var index: usize = 0
    while parameter != ast.NONE {
        const value = ast_store.Store.get(nodes, parameter)
        const value_token = lexer.tokenAt(tokens, value.mainToken)
        if sameName(tokenPointer(source, tokens, value.mainToken), value_token.length, identifier_pointer, identifier_token.length) { return index }
        parameter = value.next
        index += 1
    }
    return types_module.NONE
}

fn directReturnExpression(nodes: *NodeStore, function_node: Node) -> usize {
    if function_node.rhs == ast.NONE { return ast.NONE }
    const body = ast_store.Store.get(nodes, function_node.rhs)
    var statement = if body.tag == ast.Tag.block { body.lhs } else { function_node.rhs }
    while statement != ast.NONE {
        const value = ast_store.Store.get(nodes, statement)
        if value.tag == ast.Tag.return_statement { return value.rhs }
        statement = value.next
    }
    return ast.NONE
}

fn recordGenericReturnMetadata(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, function_node: Node, symbol: *symbols_module.Symbol) -> void {
    const annotated_parameter = genericParameterIndexForNode(source, path, tokens, nodes, function_node, function_node.extra)
    if annotated_parameter != types_module.NONE {
        symbol.*.genericReturnKind = symbols_module.GENERIC_RETURN_TYPE_PARAMETER
        symbol.*.genericReturnParameter = annotated_parameter
        return
    }
    const return_expression = directReturnExpression(nodes, function_node)
    if return_expression == ast.NONE { return }
    const direct_parameter = genericParameterIndexForNode(source, path, tokens, nodes, function_node, return_expression)
    if direct_parameter != types_module.NONE {
        symbol.*.genericReturnKind = symbols_module.GENERIC_RETURN_PARAMETER
        symbol.*.genericReturnParameter = direct_parameter
        return
    }
    const expression_node = ast_store.Store.get(nodes, return_expression)
    if expression_node.tag != ast.Tag.builtin_call || builtins.lookup(source, tokens, expression_node.mainToken) != builtins.Kind.field || expression_node.lhs == ast.NONE { return }
    const base_parameter = genericParameterIndexForNode(source, path, tokens, nodes, function_node, expression_node.lhs)
    const selector_node = ast_store.Store.get(nodes, expression_node.lhs).next
    const selector_parameter = genericParameterIndexForNode(source, path, tokens, nodes, function_node, selector_node)
    if base_parameter == types_module.NONE || selector_parameter == types_module.NONE { return }
    symbol.*.genericReturnKind = symbols_module.GENERIC_RETURN_FIELD
    symbol.*.genericReturnParameter = base_parameter
    symbol.*.genericReturnSelector = selector_parameter
}

fn analyzeFunction(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, symbols: *SymbolStore, scope: *Scope, declaration: usize) -> usize {
    const node = ast_store.Store.get(nodes, declaration)
    const found = symbolFor(source, path, tokens, scope, node)
    if !found.0 { return 1 }
    const symbol = symbols_module.symbolAt(symbols, found.1)
    symbol.*.state = symbols_module.State.initializing
    const expected_count = node.endToken & 4294967295
    const extra_start = types.*.extraIds.*.length
    var reserved_parameters: usize = 0
    while reserved_parameters < expected_count {
        types_module.appendExtra(types, 0)
        reserved_parameters += 1
    }
    var parameter = node.lhs
    var count: usize = 0
    while parameter != ast.NONE && count < expected_count {
        const parameter_node = ast_store.Store.get(nodes, parameter)
        // A type over a comptime type parameter (`T`, `[*]T`, `Box(T)`) is
        // concrete per instance: `anytype` here, and not tried (the
        // parameter is no name of this scope).
        var parameter_type = types_module.primitive(types, types_module.Kind.anytype_type)
        if parameter_node.lhs != ast.NONE && !isComptimeTypeParameterName(source, path, tokens, nodes, node, parameter, parameter_node.lhs) { parameter_type = resolveType(source, path, tokens, nodes, types, symbols, scope, parameter_node.lhs) }
        if parameter_type == 0 {
            if parameter_node.lhs != ast.NONE { reportOwnership(source, path, tokens, ast_store.Store.get(nodes, parameter_node.lhs), diagnostic.Code.type_mismatch, "this type could not be resolved") }
            return 1
        }
        types_module.setExtra(types, extra_start + count, parameter_type)
        parameter = parameter_node.next
        count += 1
    }
    var return_type: TypeId = 0
    if isComptimeTypeParameterName(source, path, tokens, nodes, node, ast.NONE, node.extra) {
        return_type = types_module.primitive(types, types_module.Kind.anytype_type)
    } else {
        return_type = resolveType(source, path, tokens, nodes, types, symbols, scope, node.extra)
    }
    if return_type == 0 && node.extra != ast.NONE { reportOwnership(source, path, tokens, ast_store.Store.get(nodes, node.extra), diagnostic.Code.type_mismatch, "this type could not be resolved") }
    if return_type == 0 || count != expected_count { return 1 }
    symbol.*.typeId = types_module.function(types, return_type, extra_start, count)
    if types_module.get(types, return_type).*.kind == types_module.Kind.anytype_type {
        recordGenericReturnMetadata(source, path, tokens, nodes, node, symbol)
    }
    symbol.*.state = symbols_module.State.initialized
    return 0
}

pub fn root(source: []const u8, path: []const u8, tokens: Buffer, nodes: *NodeStore, root_index: usize, types: *TypeStore, symbols: *SymbolStore, scope: *Scope) -> usize {
    const root_node = ast_store.Store.get(nodes, root_index)
    if root_node.tag != ast.Tag.root { return 1 }
    var errors: usize = 0
    var declaration = root_node.lhs
    var count: usize = 0
    while declaration != ast.NONE && count < root_node.rhs {
        const node = ast_store.Store.get(nodes, declaration)
        if node.tag == ast.Tag.constant_declaration || node.tag == ast.Tag.variable_declaration {
            const found = symbolFor(source, path, tokens, scope, node)
            const state = if found.0 { symbols_module.symbolAt(symbols, found.1).*.state } else { symbols_module.State.declared }
            if state == symbols_module.State.declared {
                errors += analyzeBinding(source, path, tokens, nodes, types, symbols, scope, declaration)
            } else if state == symbols_module.State.initializing {
                errors += 1
            }
        }
        if node.tag == ast.Tag.function_declaration {
            errors += analyzeFunction(source, path, tokens, nodes, types, symbols, scope, declaration)
        }
        declaration = node.next
        count += 1
    }
    return errors
}
