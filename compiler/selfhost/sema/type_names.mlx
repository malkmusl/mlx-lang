// A type written as source writes it, for messages that name what was
// expected and what was given (sema/call_errors.mlx, sema/control_flow.mlx):
// `u8`, `usize`, `*const Node`, `[]u8`, `?*Node`, `[4]u32`, `!u32`, and a
// struct, enum or union by the name its declaration gives it.
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const literal_fit = @import("./literal_fit.mlx")

const TypeStore = types_module.Store
const SymbolStore = symbols_module.Store
const Kind = types_module.Kind

// The name of `type_id` after `length.*` bytes of `text`, up to `limit`
// bytes (a name cut short ends in "...").
pub fn write(types: *TypeStore, symbols: *SymbolStore, type_id: usize, text: [*]u8, length: *usize, limit: usize) -> void {
    part(types, symbols, type_id, text, length, limit, 0)
}

fn part(types: *TypeStore, symbols: *SymbolStore, type_id: usize, text: [*]u8, length: *usize, limit: usize, depth: usize) -> void {
    if length.* + 24 > limit || depth > 8 {
        add(text, length, limit, "...")
        return
    }
    const value = types_module.get(types, type_id)
    const kind = value.*.kind
    if kind == Kind.integer {
        if value.*.flags & types_module.FLAG_SIGNED != 0 {
            add(text, length, limit, "i")
        } else {
            add(text, length, limit, "u")
        }
        if value.*.flags & types_module.FLAG_PLATFORM_SIZE != 0 {
            add(text, length, limit, "size")
        } else {
            literal_fit.putNumber(text, length, value.*.bits)
        }
        return
    }
    if kind == Kind.float {
        add(text, length, limit, "f")
        literal_fit.putNumber(text, length, value.*.bits)
        return
    }
    if kind == Kind.pointer || kind == Kind.many_pointer || kind == Kind.slice {
        if kind == Kind.pointer { add(text, length, limit, "*") }
        if kind == Kind.many_pointer { add(text, length, limit, "[*]") }
        if kind == Kind.slice { add(text, length, limit, "[]") }
        if value.*.flags & types_module.FLAG_CONSTANT != 0 { add(text, length, limit, "const ") }
        part(types, symbols, value.*.lhs, text, length, limit, depth + 1)
        return
    }
    if kind == Kind.array {
        add(text, length, limit, "[")
        literal_fit.putNumber(text, length, value.*.bits)
        add(text, length, limit, "]")
        part(types, symbols, value.*.lhs, text, length, limit, depth + 1)
        return
    }
    if kind == Kind.optional {
        add(text, length, limit, "?")
        part(types, symbols, value.*.lhs, text, length, limit, depth + 1)
        return
    }
    if kind == Kind.error_union {
        add(text, length, limit, "!")
        part(types, symbols, value.*.rhs, text, length, limit, depth + 1)
        return
    }
    if kind == Kind.tuple {
        add(text, length, limit, "(")
        var index: usize = 0
        while index < value.*.extraLength {
            if index > 0 { add(text, length, limit, ", ") }
            part(types, symbols, types_module.extraAt(types, types_module.get(types, type_id).*.extraStart + index), text, length, limit, depth + 1)
            index += 1
        }
        add(text, length, limit, ")")
        return
    }
    if kind == Kind.struct_type || kind == Kind.enum_type || kind == Kind.union_type || kind == Kind.error_set {
        if named(types, symbols, type_id, text, length, limit) { return }
    }
    add(text, length, limit, kindName(kind))
}

// The name of the constant a struct, enum, union or error set is declared
// as (the first one found that is not `Self`).
fn named(types: *TypeStore, symbols: *SymbolStore, type_id: usize, text: [*]u8, length: *usize, limit: usize) -> bool {
    const type_type = types_module.primitive(types, Kind.type_type)
    var index: usize = 0
    while index < symbols.*.length {
        const symbol = symbols_module.symbolAt(symbols, index)
        if symbol.*.valueTypeId == type_id && symbol.*.typeId == type_type && !isSelf(symbol.*.namePointer, symbol.*.nameLength) && symbol.*.nameLength < 48 {
            var at: usize = 0
            while at < symbol.*.nameLength && length.* < limit {
                text[length.*] = symbol.*.namePointer[at]
                length.* += 1
                at += 1
            }
            return true
        }
        index += 1
    }
    return false
}

fn isSelf(name: [*]const u8, name_length: usize) -> bool {
    return name_length == 4 && name[0] == 83 && name[1] == 101 && name[2] == 108 && name[3] == 102
}

fn kindName(kind: Kind) -> []const u8 {
    if kind == Kind.void_type { return "void" }
    if kind == Kind.noreturn_type { return "noreturn" }
    if kind == Kind.bool_type { return "bool" }
    if kind == Kind.null_type { return "null" }
    if kind == Kind.undefined_type { return "undefined" }
    if kind == Kind.comptime_int_type { return "comptime_int" }
    if kind == Kind.comptime_float_type { return "comptime_float" }
    if kind == Kind.type_type { return "type" }
    if kind == Kind.anytype_type { return "anytype" }
    if kind == Kind.anyopaque_type { return "anyopaque" }
    if kind == Kind.function { return "fn" }
    if kind == Kind.struct_type { return "struct" }
    if kind == Kind.enum_type { return "enum" }
    if kind == Kind.union_type { return "union" }
    if kind == Kind.error_set { return "error" }
    if kind == Kind.vector { return "@Vector" }
    if kind == Kind.module { return "module" }
    return "?"
}

fn add(text: [*]u8, length: *usize, limit: usize, what: []const u8) -> void {
    for byte in what {
        if length.* < limit {
            text[length.*] = byte
            length.* += 1
        }
    }
}
