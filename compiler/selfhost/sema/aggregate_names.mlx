// How sema tells one struct, union or enum declaration from another, and
// the name a binding gives one.
const lexer = @import("../lexer.mlx")
const ast = @import("../ast/node.mlx")
const ast_store = @import("../ast/store.mlx")
const types_module = @import("../types.mlx")
const symbols_module = @import("../symbols.mlx")
const mem = @import("../../../std/bootstrap/mem.mlx")

const Buffer = lexer.Buffer
const Node = ast.Node
const NodeStore = ast_store.Store
const TypeStore = types_module.Store
const SymbolStore = symbols_module.Store
const Scope = symbols_module.Scope

// A declaration's identity: where its node is (a module's node store and
// the index in it).
pub fn identity(nodes: *NodeStore, node_index: usize) -> usize {
    return @intFromPtr(nodes) + node_index * @sizeOf(Node)
}

// Whether the aggregate type `type_id` has exactly the fields `node`
// declares, by name and in order.
pub fn fieldsMatch(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *TypeStore, node: Node, type_id: usize) -> bool {
    const value = types_module.get(types, type_id)
    var field_count: usize = 0
    var candidate = node.lhs
    var visited: usize = 0
    while candidate != ast.NONE && visited < node.rhs {
        const candidate_tag = ast_store.Store.get(nodes, candidate).tag
        if candidate_tag != ast.Tag.function_declaration && candidate_tag != ast.Tag.constant_declaration { field_count += 1 }
        candidate = ast_store.Store.get(nodes, candidate).next
        visited += 1
    }
    if value.*.extraLength != field_count { return false }
    var member_index = node.lhs
    var index: usize = 0
    visited = 0
    while member_index != ast.NONE && visited < node.rhs {
        const member = ast_store.Store.get(nodes, member_index)
        if member.tag != ast.Tag.function_declaration && member.tag != ast.Tag.constant_declaration {
            const member_token = lexer.tokenAt(tokens, member.mainToken)
            const field = types_module.fieldAt(types, value.*.extraStart + index)
            if field.*.nameLength != member_token.length || !mem.eql(field.*.namePointer, namePointer(source, member_token.start), member_token.length) { return false }
            index += 1
        }
        member_index = member.next
        visited += 1
    }
    return member_index == ast.NONE && index == field_count
}

// The binding `const NAME = struct {...}` (or union, or enum) makes of the
// aggregate at `node_index`, looked for in `scope` and the scopes around
// it: (true, its symbol), or (false, 0) for one no binding names (a type a
// function returns).
pub fn bindingOf(nodes: *NodeStore, symbols: *SymbolStore, scope: *Scope, node_index: usize) -> (bool, usize) {
    var current = scope
    var depth: usize = 0
    while depth < 64 {
        var at: usize = 0
        while at < current.*.length {
            const symbol_index = symbols_module.scopeEntrySymbol(current, at)
            const declaration = symbols_module.symbolAt(symbols, symbol_index).*.declaration
            if declaration != ast.NONE && declaration < nodes.*.length {
                const node = ast_store.Store.get(nodes, declaration)
                if node.tag == ast.Tag.constant_declaration && node.rhs == node_index { return -> (true, symbol_index) }
            }
            at += 1
        }
        if current.*.parentAddress == 0 { return -> (false, 0) }
        unsafe { current = @ptrFromInt(*Scope, current.*.parentAddress) }
        depth += 1
    }
    return -> (false, 0)
}

fn namePointer(source: []const u8, start: usize) -> [*]const u8 {
    unsafe {
        const source_pointer = @ptrCast([*]const u8, source)
        return @ptrFromInt([*]const u8, @intFromPtr(source_pointer) + start)
    }
}
