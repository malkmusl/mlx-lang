const kind_module = @import("./kind.zin")
const types_module = @import("../../types.zin")

pub const Kind = kind_module.Kind
pub const Store = types_module.Store

fn isPredicate(kind: Kind) -> bool {
    return kind == Kind.isArray || kind == Kind.isCopyable || kind == Kind.isEnum || kind == Kind.isErrorUnion || kind == Kind.isFloat || kind == Kind.isInteger || kind == Kind.isOptional || kind == Kind.isPointer || kind == Kind.isSlice || kind == Kind.isStruct || kind == Kind.isUnion || kind == Kind.hasDecl || kind == Kind.hasField
}

fn isLayout(kind: Kind) -> bool {
    return kind == Kind.alignOf || kind == Kind.bitSizeOf || kind == Kind.sizeOf || kind == Kind.offsetOf || kind == Kind.fieldCount || kind == Kind.languageVersion
}

fn isCast(kind: Kind) -> bool {
    return kind == Kind.alignCast || kind == Kind.bitCast || kind == Kind.enumFromInt || kind == Kind.floatCast || kind == Kind.floatFromInt || kind == Kind.intCast || kind == Kind.intFromFloat || kind == Kind.ptrCast || kind == Kind.ptrFromInt
}

pub fn result(kind: Kind, first_type: usize, first_value_type: usize, second_type: usize, second_value_type: usize, types: *Store) -> (usize, usize) {
    if kind == Kind.invalid { return -> (0, 0) }
    if kind == Kind.import { return -> (types_module.primitive(types, types_module.Kind.module), 0) }
    if kind == Kind.typeOf { return -> (types_module.primitive(types, types_module.Kind.type_type), first_type) }
    if kind == Kind.nocopy {
        if first_value_type == 0 { return -> (0, 0) }
        return -> (types_module.primitive(types, types_module.Kind.type_type), types_module.noCopy(types, first_value_type))
    }
    if kind == Kind.move { return -> (first_type, first_value_type) }
    if isLayout(kind) { return -> (types_module.primitive(types, types_module.Kind.comptime_int_type), 0) }
    if isPredicate(kind) { return -> (types_module.primitive(types, types_module.Kind.bool_type), 0) }
    if isCast(kind) {
        if first_value_type == 0 { return -> (0, 0) }
        return -> (first_value_type, 0)
    }
    if kind == Kind.intFromPtr || kind == Kind.intFromEnum { return -> (types_module.sizeInteger(types, false), 0) }
    if kind == Kind.discardError || kind == Kind.setEvalBranchQuota || kind == Kind.atomicStore || kind == Kind.fence { return -> (types_module.primitive(types, types_module.Kind.void_type), 0) }
    if kind == Kind.compileError { return -> (types_module.primitive(types, types_module.Kind.noreturn_type), 0) }
    if kind == Kind.fieldType || kind == Kind.typeInfo || kind == Kind.decl { return -> (types_module.primitive(types, types_module.Kind.type_type), 0) }
    if kind == Kind.field || kind == Kind.tagOf || kind == Kind.atomicLoad || kind == Kind.atomicRmw || kind == Kind.cmpxchgStrong || kind == Kind.cmpxchgWeak || kind == Kind.splat || kind == Kind.shuffle || kind == Kind.reduce || kind == Kind.select { return -> (first_type, first_value_type) }
    if kind == Kind.Vector {
        if second_value_type == 0 { return -> (types_module.primitive(types, types_module.Kind.type_type), 0) }
        return -> (types_module.primitive(types, types_module.Kind.type_type), 0)
    }
    return -> (0, 0)
}
