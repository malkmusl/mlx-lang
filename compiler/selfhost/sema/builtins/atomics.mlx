// The atomic builtins' names and rules (spec/00-language/atomics-tls.xml):
// the memory orders and read-modify-write operations are written as bare
// names (`seq_cst`, `add`), not as values, so sema and the lowering read
// them from the source and share the codes here.
//
//   @atomicLoad(T, pointer, order) -> T
//   @atomicStore(T, pointer, value, order) -> void
//   @atomicRmw(T, pointer, op, value, order) -> T          (the old value)
//   @cmpxchgStrong(T, pointer, expected, new, success, failure) -> (bool, T)
//   @cmpxchgWeak(T, pointer, expected, new, success, failure) -> (bool, T)
//   @fence(order) -> void
//
// T is an integer of 1, 2, 4 or 8 bytes, a bool, an enum, or a pointer;
// `pointer` points to a T. A compare-exchange answers whether it swapped
// and the value it saw (the old one when it did).
const kind_module = @import("./kind.mlx")

pub const Kind = kind_module.Kind
pub const NONE: usize = 18446744073709551615

// The orders, weakest first.
pub const ORDER_UNORDERED: usize = 0
pub const ORDER_MONOTONIC: usize = 1
pub const ORDER_ACQUIRE: usize = 2
pub const ORDER_RELEASE: usize = 3
pub const ORDER_ACQ_REL: usize = 4
pub const ORDER_SEQ_CST: usize = 5

// The read-modify-write operations; max and min follow T's signedness.
pub const OP_XCHG: usize = 0
pub const OP_ADD: usize = 1
pub const OP_SUB: usize = 2
pub const OP_AND: usize = 3
pub const OP_NAND: usize = 4
pub const OP_OR: usize = 5
pub const OP_XOR: usize = 6
pub const OP_MAX: usize = 7
pub const OP_MIN: usize = 8

pub fn isAtomic(kind: Kind) -> bool {
    return kind == Kind.atomicLoad || kind == Kind.atomicStore || kind == Kind.atomicRmw || kind == Kind.cmpxchgStrong || kind == Kind.cmpxchgWeak || kind == Kind.fence
}

pub fn isCompareExchange(kind: Kind) -> bool { return kind == Kind.cmpxchgStrong || kind == Kind.cmpxchgWeak }

// How many arguments each takes.
pub fn arity(kind: Kind) -> usize {
    if kind == Kind.atomicLoad { return 3 }
    if kind == Kind.atomicStore { return 4 }
    if kind == Kind.atomicRmw { return 5 }
    if isCompareExchange(kind) { return 6 }
    return 1
}

// Whether argument `index` is a name (an order, or atomicRmw's operation)
// rather than a value.
pub fn isNameArgument(kind: Kind, index: usize) -> bool {
    if kind == Kind.atomicLoad { return index == 2 }
    if kind == Kind.atomicStore { return index == 3 }
    if kind == Kind.atomicRmw { return index == 2 || index == 4 }
    if isCompareExchange(kind) { return index == 4 || index == 5 }
    return kind == Kind.fence && index == 0
}

fn same(name: [*]const u8, length: usize, expected: []const u8) -> bool {
    if length != expected.length { return false }
    var index: usize = 0
    while index < length {
        if name[index] != expected[index] { return false }
        index += 1
    }
    return true
}

// The order a name stands for, NONE when it is none of the six.
pub fn orderOf(name: [*]const u8, length: usize) -> usize {
    if same(name, length, "unordered") { return ORDER_UNORDERED }
    if same(name, length, "monotonic") { return ORDER_MONOTONIC }
    if same(name, length, "acquire") { return ORDER_ACQUIRE }
    if same(name, length, "release") { return ORDER_RELEASE }
    if same(name, length, "acq_rel") { return ORDER_ACQ_REL }
    if same(name, length, "seq_cst") { return ORDER_SEQ_CST }
    return NONE
}

// The operation a name stands for, NONE when it is none of the nine.
pub fn opOf(name: [*]const u8, length: usize) -> usize {
    if same(name, length, "xchg") { return OP_XCHG }
    if same(name, length, "add") { return OP_ADD }
    if same(name, length, "sub") { return OP_SUB }
    if same(name, length, "and") { return OP_AND }
    if same(name, length, "nand") { return OP_NAND }
    if same(name, length, "or") { return OP_OR }
    if same(name, length, "xor") { return OP_XOR }
    if same(name, length, "max") { return OP_MAX }
    if same(name, length, "min") { return OP_MIN }
    return NONE
}

// A load does not release, a store does not acquire, a fence orders
// something, a read-modify-write is at least monotonic, and a
// compare-exchange's failure order neither releases nor exceeds its
// success order (the C11 rules).
pub fn loadOrderValid(order: usize) -> bool { return order != ORDER_RELEASE && order != ORDER_ACQ_REL }
pub fn storeOrderValid(order: usize) -> bool { return order != ORDER_ACQUIRE && order != ORDER_ACQ_REL }
pub fn rmwOrderValid(order: usize) -> bool { return order != ORDER_UNORDERED }
pub fn fenceOrderValid(order: usize) -> bool { return order >= ORDER_ACQUIRE }
pub fn compareExchangeOrdersValid(success: usize, failure: usize) -> bool {
    if success == ORDER_UNORDERED { return false }
    if failure == ORDER_UNORDERED || failure == ORDER_RELEASE || failure == ORDER_ACQ_REL { return false }
    return failure <= success
}
