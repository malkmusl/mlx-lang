// The atomics' and threads' rules for a call's arguments (spec
// atomics-tls.xml): for an atomic, T an integer of 1, 2, 4 or 8 bytes, a
// bool, an enum or a pointer; the pointer argument points to a T; the
// orders fit the operation. `problem` answers what is wrong, for sema to
// report, or "" when nothing is.
const types_module = @import("../../types.mlx")
const atomics = @import("./atomics.mlx")

const TypeStore = types_module.Store
const TypeId = types_module.Id

pub fn problem(types: *TypeStore, kind: atomics.Kind, value_type: TypeId, pointer_type: TypeId, order: usize, second_order: usize) -> []const u8 {
    if kind == atomics.Kind.fence {
        if !atomics.fenceOrderValid(order) { return "@fence orders acquire, release, acq_rel or seq_cst" }
        return ""
    }
    if value_type == 0 || !isAtomicType(types, value_type) { return "an atomic works on an integer of 1, 2, 4 or 8 bytes, a bool, an enum or a pointer" }
    var points_to_value = false
    if pointer_type != 0 {
        const pointer = types_module.get(types, pointer_type)
        if pointer.*.kind == types_module.Kind.pointer || pointer.*.kind == types_module.Kind.many_pointer {
            points_to_value = pointer.*.lhs == value_type || types_module.isCoercible(types, pointer.*.lhs, value_type)
        }
    }
    if !points_to_value { return "the second argument of an atomic is a pointer to its type" }
    if kind == atomics.Kind.atomicLoad && !atomics.loadOrderValid(order) { return "an atomic load does not release: its order is unordered, monotonic, acquire or seq_cst" }
    if kind == atomics.Kind.atomicStore && !atomics.storeOrderValid(order) { return "an atomic store does not acquire: its order is unordered, monotonic, release or seq_cst" }
    if kind == atomics.Kind.atomicRmw && !atomics.rmwOrderValid(order) { return "@atomicRmw is at least monotonic" }
    if atomics.isCompareExchange(kind) && !atomics.compareExchangeOrdersValid(order, second_order) { return "a compare-exchange's success order is at least monotonic, and its failure order neither releases nor exceeds it" }
    return ""
}

fn isAtomicType(types: *TypeStore, type_id: TypeId) -> bool {
    const value = types_module.get(types, type_id)
    if value.*.kind == types_module.Kind.integer { return value.*.bits == 8 || value.*.bits == 16 || value.*.bits == 32 || value.*.bits == 64 }
    if value.*.kind == types_module.Kind.bool_type || value.*.kind == types_module.Kind.pointer || value.*.kind == types_module.Kind.many_pointer { return true }
    if value.*.kind == types_module.Kind.enum_type {
        const size = types_module.sizeOf(types, type_id)
        return size == 1 || size == 2 || size == 4 || size == 8
    }
    return false
}

// @spawnThread's arguments (spec atomics-tls.xml, <Threads>): integers
// (an address as a usize) but for `entry`, a function or its address.
pub fn spawnArgumentValid(types: *TypeStore, index: usize, type_id: TypeId) -> bool {
    const value = types_module.get(types, type_id)
    if value.*.kind == types_module.Kind.integer || value.*.kind == types_module.Kind.comptime_int_type { return true }
    return index == 5 && value.*.kind == types_module.Kind.function
}
