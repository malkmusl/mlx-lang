const lexer = @import("../../lexer.mlx")
const kind_module = @import("./kind.mlx")

pub const Buffer = lexer.Buffer
pub const Kind = kind_module.Kind
pub const UNBOUNDED: usize = 18446744073709551615

fn equals(source: []const u8, start: usize, length: usize, expected: []const u8) -> bool {
    var index: usize = 0
    while index < length {
        if source[start + index] != expected[index] { return false }
        index += 1
    }
    return true
}

pub fn lookup(source: []const u8, tokens: Buffer, token_index: usize) -> Kind {
    const current = lexer.tokenAt(tokens, token_index)
    const start = current.start
    const length = current.length
    if length == 4 {
        if equals(source, start, length, "decl") { return Kind.decl }
        if equals(source, start, length, "move") { return Kind.move }
    }
    if length == 5 {
        if equals(source, start, length, "fence") { return Kind.fence }
        if equals(source, start, length, "field") { return Kind.field }
        if equals(source, start, length, "splat") { return Kind.splat }
        if equals(source, start, length, "tagOf") { return Kind.tagOf }
    }
    if length == 6 {
        if equals(source, start, length, "Vector") { return Kind.Vector }
        if equals(source, start, length, "import") { return Kind.import }
        if equals(source, start, length, "isBool") { return Kind.isBool }
        if equals(source, start, length, "isEnum") { return Kind.isEnum }
        if equals(source, start, length, "nocopy") { return Kind.nocopy }
        if equals(source, start, length, "reduce") { return Kind.reduce }
        if equals(source, start, length, "select") { return Kind.select }
        if equals(source, start, length, "sizeOf") { return Kind.sizeOf }
        if equals(source, start, length, "typeOf") { return Kind.typeOf }
    }
    if length == 7 {
        if equals(source, start, length, "alignOf") { return Kind.alignOf }
        if equals(source, start, length, "bitCast") { return Kind.bitCast }
        if equals(source, start, length, "hasDecl") { return Kind.hasDecl }
        if equals(source, start, length, "intCast") { return Kind.intCast }
        if equals(source, start, length, "isArray") { return Kind.isArray }
        if equals(source, start, length, "isFloat") { return Kind.isFloat }
        if equals(source, start, length, "isSlice") { return Kind.isSlice }
        if equals(source, start, length, "isTuple") { return Kind.isTuple }
        if equals(source, start, length, "isUnion") { return Kind.isUnion }
        if equals(source, start, length, "noncopy") { return Kind.nocopy }
        if equals(source, start, length, "ptrCast") { return Kind.ptrCast }
        if equals(source, start, length, "shuffle") { return Kind.shuffle }
    }
    if length == 8 {
        if equals(source, start, length, "hasField") { return Kind.hasField }
        if equals(source, start, length, "isSigned") { return Kind.isSigned }
        if equals(source, start, length, "isStruct") { return Kind.isStruct }
        if equals(source, start, length, "offsetOf") { return Kind.offsetOf }
        if equals(source, start, length, "popCount") { return Kind.popCount }
        if equals(source, start, length, "typeInfo") { return Kind.typeInfo }
    }
    if length == 9 {
        if equals(source, start, length, "alignCast") { return Kind.alignCast }
        if equals(source, start, length, "atomicRmw") { return Kind.atomicRmw }
        if equals(source, start, length, "bitSizeOf") { return Kind.bitSizeOf }
        if equals(source, start, length, "childType") { return Kind.childType }
        if equals(source, start, length, "fieldName") { return Kind.fieldName }
        if equals(source, start, length, "fieldType") { return Kind.fieldType }
        if equals(source, start, length, "floatCast") { return Kind.floatCast }
        if equals(source, start, length, "isInteger") { return Kind.isInteger }
        if equals(source, start, length, "isPointer") { return Kind.isPointer }
    }
    if length == 10 {
        if equals(source, start, length, "atomicLoad") { return Kind.atomicLoad }
        if equals(source, start, length, "byteMask64") { return Kind.byteMask64 }
        if equals(source, start, length, "fieldCount") { return Kind.fieldCount }
        if equals(source, start, length, "intFromPtr") { return Kind.intFromPtr }
        if equals(source, start, length, "isCopyable") { return Kind.isCopyable }
        if equals(source, start, length, "isOptional") { return Kind.isOptional }
        if equals(source, start, length, "ptrFromInt") { return Kind.ptrFromInt }
    }
    if length == 11 {
        if equals(source, start, length, "atomicStore") { return Kind.atomicStore }
        if equals(source, start, length, "cmpxchgWeak") { return Kind.cmpxchgWeak }
        if equals(source, start, length, "enumFromInt") { return Kind.enumFromInt }
        if equals(source, start, length, "intFromEnum") { return Kind.intFromEnum }
    }
    if length == 12 {
        if equals(source, start, length, "compileError") { return Kind.compileError }
        if equals(source, start, length, "discardError") { return Kind.discardError }
        if equals(source, start, length, "floatFromInt") { return Kind.floatFromInt }
        if equals(source, start, length, "intFromFloat") { return Kind.intFromFloat }
        if equals(source, start, length, "isErrorUnion") { return Kind.isErrorUnion }
    }
    if length == 13 && equals(source, start, length, "cmpxchgStrong") { return Kind.cmpxchgStrong }
    if length == 15 && equals(source, start, length, "languageVersion") { return Kind.languageVersion }
    if length == 18 && equals(source, start, length, "setEvalBranchQuota") { return Kind.setEvalBranchQuota }
    return Kind.invalid
}

pub fn minimumArity(kind: Kind) -> usize {
    if kind == Kind.languageVersion { return 0 }
    if kind == Kind.Vector || kind == Kind.byteMask64 || kind == Kind.offsetOf || kind == Kind.field || kind == Kind.fieldName || kind == Kind.fieldType || kind == Kind.hasField || kind == Kind.hasDecl || kind == Kind.decl || kind == Kind.intCast || kind == Kind.floatCast || kind == Kind.floatFromInt || kind == Kind.ptrCast || kind == Kind.alignCast || kind == Kind.bitCast || kind == Kind.ptrFromInt || kind == Kind.enumFromInt { return 2 }
    if kind == Kind.atomicLoad || kind == Kind.atomicRmw || kind == Kind.atomicStore || kind == Kind.cmpxchgStrong || kind == Kind.cmpxchgWeak || kind == Kind.fence || kind == Kind.splat || kind == Kind.shuffle || kind == Kind.reduce || kind == Kind.select { return 0 }
    return 1
}

pub fn maximumArity(kind: Kind) -> usize {
    if kind == Kind.atomicLoad || kind == Kind.atomicRmw || kind == Kind.atomicStore || kind == Kind.cmpxchgStrong || kind == Kind.cmpxchgWeak || kind == Kind.fence || kind == Kind.splat || kind == Kind.shuffle || kind == Kind.reduce || kind == Kind.select { return UNBOUNDED }
    return minimumArity(kind)
}

pub fn acceptsArity(kind: Kind, count: usize) -> bool {
    if kind == Kind.invalid { return false }
    return count >= minimumArity(kind) && count <= maximumArity(kind)
}
