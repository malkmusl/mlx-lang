const lexer = @import("../../lexer.zin")
const kind_module = @import("./kind.zin")

pub const Buffer = lexer.Buffer
pub const Kind = kind_module.Kind
pub const UNBOUNDED: usize = 18446744073709551615

fn equals(source: []const u8, tokens: Buffer, token_index: usize, expected: []const u8) -> bool {
    const token = lexer.tokenAt(tokens, token_index)
    var length: usize = 0
    for byte in expected { length += 1 }
    if token.length != length { return false }
    var index: usize = 0
    while index < length {
        if source[token.start + index] != expected[index] { return false }
        index += 1
    }
    return true
}

pub fn lookup(source: []const u8, tokens: Buffer, token_index: usize) -> Kind {
    if equals(source, tokens, token_index, "Vector") { return Kind.Vector }
    if equals(source, tokens, token_index, "alignCast") { return Kind.alignCast }
    if equals(source, tokens, token_index, "alignOf") { return Kind.alignOf }
    if equals(source, tokens, token_index, "atomicLoad") { return Kind.atomicLoad }
    if equals(source, tokens, token_index, "atomicRmw") { return Kind.atomicRmw }
    if equals(source, tokens, token_index, "atomicStore") { return Kind.atomicStore }
    if equals(source, tokens, token_index, "bitCast") { return Kind.bitCast }
    if equals(source, tokens, token_index, "bitSizeOf") { return Kind.bitSizeOf }
    if equals(source, tokens, token_index, "cmpxchgStrong") { return Kind.cmpxchgStrong }
    if equals(source, tokens, token_index, "cmpxchgWeak") { return Kind.cmpxchgWeak }
    if equals(source, tokens, token_index, "compileError") { return Kind.compileError }
    if equals(source, tokens, token_index, "decl") { return Kind.decl }
    if equals(source, tokens, token_index, "discardError") { return Kind.discardError }
    if equals(source, tokens, token_index, "enumFromInt") { return Kind.enumFromInt }
    if equals(source, tokens, token_index, "fence") { return Kind.fence }
    if equals(source, tokens, token_index, "field") { return Kind.field }
    if equals(source, tokens, token_index, "fieldCount") { return Kind.fieldCount }
    if equals(source, tokens, token_index, "fieldType") { return Kind.fieldType }
    if equals(source, tokens, token_index, "floatCast") { return Kind.floatCast }
    if equals(source, tokens, token_index, "floatFromInt") { return Kind.floatFromInt }
    if equals(source, tokens, token_index, "hasDecl") { return Kind.hasDecl }
    if equals(source, tokens, token_index, "hasField") { return Kind.hasField }
    if equals(source, tokens, token_index, "import") { return Kind.import }
    if equals(source, tokens, token_index, "intCast") { return Kind.intCast }
    if equals(source, tokens, token_index, "intFromEnum") { return Kind.intFromEnum }
    if equals(source, tokens, token_index, "intFromFloat") { return Kind.intFromFloat }
    if equals(source, tokens, token_index, "intFromPtr") { return Kind.intFromPtr }
    if equals(source, tokens, token_index, "isArray") { return Kind.isArray }
    if equals(source, tokens, token_index, "isCopyable") { return Kind.isCopyable }
    if equals(source, tokens, token_index, "isEnum") { return Kind.isEnum }
    if equals(source, tokens, token_index, "isErrorUnion") { return Kind.isErrorUnion }
    if equals(source, tokens, token_index, "isFloat") { return Kind.isFloat }
    if equals(source, tokens, token_index, "isInteger") { return Kind.isInteger }
    if equals(source, tokens, token_index, "isOptional") { return Kind.isOptional }
    if equals(source, tokens, token_index, "isPointer") { return Kind.isPointer }
    if equals(source, tokens, token_index, "isSlice") { return Kind.isSlice }
    if equals(source, tokens, token_index, "isStruct") { return Kind.isStruct }
    if equals(source, tokens, token_index, "isUnion") { return Kind.isUnion }
    if equals(source, tokens, token_index, "languageVersion") { return Kind.languageVersion }
    if equals(source, tokens, token_index, "move") { return Kind.move }
    if equals(source, tokens, token_index, "nocopy") { return Kind.nocopy }
    if equals(source, tokens, token_index, "offsetOf") { return Kind.offsetOf }
    if equals(source, tokens, token_index, "ptrCast") { return Kind.ptrCast }
    if equals(source, tokens, token_index, "ptrFromInt") { return Kind.ptrFromInt }
    if equals(source, tokens, token_index, "reduce") { return Kind.reduce }
    if equals(source, tokens, token_index, "select") { return Kind.select }
    if equals(source, tokens, token_index, "setEvalBranchQuota") { return Kind.setEvalBranchQuota }
    if equals(source, tokens, token_index, "shuffle") { return Kind.shuffle }
    if equals(source, tokens, token_index, "sizeOf") { return Kind.sizeOf }
    if equals(source, tokens, token_index, "splat") { return Kind.splat }
    if equals(source, tokens, token_index, "tagOf") { return Kind.tagOf }
    if equals(source, tokens, token_index, "typeInfo") { return Kind.typeInfo }
    if equals(source, tokens, token_index, "typeOf") { return Kind.typeOf }
    return Kind.invalid
}

pub fn minimumArity(kind: Kind) -> usize {
    if kind == Kind.languageVersion { return 0 }
    if kind == Kind.Vector || kind == Kind.offsetOf || kind == Kind.field || kind == Kind.fieldType || kind == Kind.hasField || kind == Kind.hasDecl || kind == Kind.decl || kind == Kind.intCast || kind == Kind.floatCast || kind == Kind.floatFromInt || kind == Kind.intFromFloat || kind == Kind.ptrCast || kind == Kind.alignCast || kind == Kind.bitCast || kind == Kind.ptrFromInt || kind == Kind.enumFromInt { return 2 }
    if kind == Kind.atomicLoad || kind == Kind.atomicRmw || kind == Kind.atomicStore || kind == Kind.cmpxchgStrong || kind == Kind.cmpxchgWeak || kind == Kind.fence || kind == Kind.splat || kind == Kind.shuffle || kind == Kind.reduce || kind == Kind.select { return 0 }
    return 1
}

pub fn maximumArity(kind: Kind) -> usize {
    if kind == Kind.atomicLoad || kind == Kind.atomicRmw || kind == Kind.atomicStore || kind == Kind.cmpxchgStrong || kind == Kind.cmpxchgWeak || kind == Kind.fence || kind == Kind.splat || kind == Kind.shuffle || kind == Kind.reduce || kind == Kind.select { return UNBOUNDED }
    return minimumArity(kind)
}

pub fn acceptsArity(kind: Kind, count: usize) -> bool {
    if kind == Kind.invalid { return false }
    return count >= minimumArity(kind) && count <= maximumArity(kind)
}
