// The pointer casts that need `unsafe` (spec/00-language/unsafe.xml):
// @ptrFromInt and @ptrCast outside an unsafe block or an
// `unsafe { expression }` are reported as MLX-E7004. Unsafe is a lexical
// permission boundary, so the check reads the tokens rather than the
// tree: an `unsafe` followed by a brace covers everything up to the
// matching brace, and each cast is seen exactly once (typing visits some
// expressions more than once).
const lexer = @import("../lexer.mlx")
const diagnostic = @import("../diagnostic.mlx")

const Buffer = lexer.Buffer
const Kind = lexer.Kind

// How many casts outside unsafe the module's tokens hold (each reported).
pub fn report(source: []const u8, path: []const u8, tokens: Buffer) -> usize {
    var found: usize = 0
    var depth: usize = 0
    var inside = false
    var inside_depth: usize = 0
    var index: usize = 0
    while index < tokens.length {
        const current = lexer.tokenAt(tokens, index)
        if current.kind == Kind.left_brace {
            depth += 1
        } else if current.kind == Kind.right_brace {
            if depth > 0 { depth -= 1 }
            if inside && depth == inside_depth { inside = false }
        } else if current.kind == Kind.keyword_unsafe {
            if !inside && index + 1 < tokens.length && lexer.tokenAt(tokens, index + 1).kind == Kind.left_brace {
                inside = true
                inside_depth = depth
            }
        } else if current.kind == Kind.at && !inside && index + 1 < tokens.length {
            const name = lexer.tokenAt(tokens, index + 1)
            if name.kind == Kind.identifier {
                if equals(source, name.start, name.length, "ptrCast") {
                    say(source, path, current.start, name.start + name.length, "`@ptrCast` outside unsafe: a pointer cast can break provenance and type validity, so it needs an unsafe block or `unsafe { expression }`")
                    found += 1
                } else if equals(source, name.start, name.length, "ptrFromInt") {
                    say(source, path, current.start, name.start + name.length, "`@ptrFromInt` outside unsafe: an address made from an integer has no provenance, so it needs an unsafe block or `unsafe { expression }`")
                    found += 1
                }
            }
        }
        index += 1
    }
    return found
}

fn equals(source: []const u8, start: usize, length: usize, expected: []const u8) -> bool {
    if length != expected.length { return false }
    var offset: usize = 0
    while offset < length {
        if source[start + offset] != expected[offset] { return false }
        offset += 1
    }
    return true
}

fn say(source: []const u8, path: []const u8, start: usize, end: usize, message: []const u8) -> void {
    const rendered = diagnostic.render(diagnostic.create(diagnostic.Code.unsafe_operation_outside_unsafe_block, diagnostic.Phase.sema, diagnostic.Severity.failure, 0, start, end, message), path, source)
}
