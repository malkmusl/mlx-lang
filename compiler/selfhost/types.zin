const allocator_module = @import("../../std/bootstrap/allocator.zin")
const kind = @import("./sema/types/kind.zin")
const type_module = @import("./sema/types/type.zin")
const store = @import("./sema/types/store.zin")
const resolve_module = @import("./sema/types/resolve.zin")

pub const Allocator = allocator_module.Allocator
pub const Kind = kind.Kind
pub const Copyability = kind.Copyability
pub const FLAG_SIGNED = kind.FLAG_SIGNED
pub const FLAG_CONSTANT = kind.FLAG_CONSTANT
pub const FLAG_VOLATILE = kind.FLAG_VOLATILE
pub const FLAG_PLATFORM_SIZE = kind.FLAG_PLATFORM_SIZE
pub const Type = type_module.Type
pub const Field = store.Field
pub const Id = type_module.Id
pub const NONE = type_module.NONE
pub const Store = store.Store
pub const Buffer = resolve_module.Buffer
pub const NodeStore = resolve_module.NodeStore

pub fn init(allocator: Allocator) -> Store { return store.init(allocator) }
pub fn get(types: *Store, id: Id) -> *Type { return store.get(types, id) }
pub fn count(types: *Store) -> usize { return store.count(types) }
pub fn primitive(types: *Store, type_kind: Kind) -> Id { return store.primitive(types, type_kind) }
pub fn integer(types: *Store, signed: bool, bits: usize) -> Id { return store.integer(types, signed, bits) }
pub fn sizeInteger(types: *Store, signed: bool) -> Id { return store.sizeInteger(types, signed) }
pub fn float(types: *Store, bits: usize) -> Id { return store.float(types, bits) }
pub fn pointer(types: *Store, child: Id, is_const: bool, is_volatile: bool, many: bool) -> Id { return store.pointer(types, child, is_const, is_volatile, many) }
pub fn slice(types: *Store, child: Id, is_const: bool) -> Id { return store.slice(types, child, is_const) }
pub fn array(types: *Store, child: Id, length: usize) -> Id { return store.array(types, child, length) }
pub fn vectorType(types: *Store, child: Id, length: usize) -> Id { return store.vectorType(types, child, length) }
pub fn optional(types: *Store, child: Id) -> Id { return store.optional(types, child) }
pub fn errorUnion(types: *Store, error_set: Id, payload: Id) -> Id { return store.errorUnion(types, error_set, payload) }
pub fn noCopy(types: *Store, base: Id) -> Id { return store.noCopy(types, base) }
pub fn appendExtra(types: *Store, id: Id) -> usize { return store.appendExtra(types, id) }
pub fn extraAt(types: *Store, index: usize) -> Id { return store.extraAt(types, index) }
pub fn function(types: *Store, result: Id, start: usize, length: usize) -> Id { return store.function(types, result, start, length) }
pub fn tuple(types: *Store, start: usize, length: usize) -> Id { return store.tuple(types, start, length) }
pub fn aggregate(types: *Store, type_kind: Kind, declaration: usize, copyability: Copyability) -> Id { return store.aggregate(types, type_kind, declaration, copyability) }
pub fn appendField(types: *Store, field: *Field) -> usize { return store.appendField(types, field) }
pub fn fieldAt(types: *Store, index: usize) -> *Field { return store.fieldAt(types, index) }
pub fn completeAggregate(types: *Store, id: Id, fields_start: usize, field_count: usize, size: usize, alignment: usize, copyability: Copyability) -> bool { return store.completeAggregate(types, id, fields_start, field_count, size, alignment, copyability) }
pub fn resolve(source: []const u8, tokens: Buffer, nodes: *NodeStore, types: *Store, node_index: usize) -> Id { return resolve_module.resolve(source, tokens, nodes, types, node_index) }
pub fn resolveName(source: []const u8, tokens: Buffer, token_index: usize, types: *Store) -> Id { return resolve_module.resolveName(source, tokens, token_index, types) }
pub fn parseUnsigned(source: []const u8, tokens: Buffer, token_index: usize) -> usize { return resolve_module.parseUnsigned(source, tokens, token_index) }
pub fn sizeOf(types: *Store, id: Id) -> usize { return store.sizeOf(types, id) }
pub fn bitSizeOf(types: *Store, id: Id) -> usize { return store.bitSizeOf(types, id) }
pub fn alignOf(types: *Store, id: Id) -> usize { return store.alignOf(types, id) }
pub fn isCoercible(types: *Store, from: Id, to: Id) -> bool { return store.isCoercible(types, from, to) }
pub fn deinit(types: *Store) -> void { store.deinit(types) }
