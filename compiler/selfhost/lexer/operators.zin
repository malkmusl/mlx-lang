const token = @import("./token.zin")

pub const Kind = token.Kind

fn textLength(text: []const u8) -> usize {
    var length: usize = 0
    for byte in text { length += 1 }
    return length
}

fn matches(source: [*]const u8, source_length: usize, start: usize, text: []const u8) -> bool {
    const length = textLength(text)
    if start + length > source_length { return false }
    var index: usize = 0
    while index < length {
        if source[start + index] != text[index] { return false }
        index += 1
    }
    return true
}

pub fn scan(source: [*]const u8, source_length: usize, start: usize) -> (Kind, usize) {
    // Five-byte arithmetic shift-combine assignments.
    if matches(source, source_length, start, "+%<<=") { return -> (Kind.plus_percent_shift_left_equal, 5) }
    if matches(source, source_length, start, "-%<<=") { return -> (Kind.minus_percent_shift_left_equal, 5) }
    if matches(source, source_length, start, "*%<<=") { return -> (Kind.asterisk_percent_shift_left_equal, 5) }
    if matches(source, source_length, start, "+|<<=") { return -> (Kind.plus_pipe_shift_left_equal, 5) }
    if matches(source, source_length, start, "-|<<=") { return -> (Kind.minus_pipe_shift_left_equal, 5) }
    if matches(source, source_length, start, "*|<<=") { return -> (Kind.asterisk_pipe_shift_left_equal, 5) }
    if matches(source, source_length, start, "+%>>=") { return -> (Kind.plus_percent_shift_right_equal, 5) }
    if matches(source, source_length, start, "-%>>=") { return -> (Kind.minus_percent_shift_right_equal, 5) }
    if matches(source, source_length, start, "*%>>=") { return -> (Kind.asterisk_percent_shift_right_equal, 5) }
    if matches(source, source_length, start, "+|>>=") { return -> (Kind.plus_pipe_shift_right_equal, 5) }
    if matches(source, source_length, start, "-|>>=") { return -> (Kind.minus_pipe_shift_right_equal, 5) }
    if matches(source, source_length, start, "*|>>=") { return -> (Kind.asterisk_pipe_shift_right_equal, 5) }
    if matches(source, source_length, start, "<<%|=") { return -> (Kind.shift_left_percent_pipe_equal, 5) }

    // Four-byte operators and assignments.
    if matches(source, source_length, start, "+%<<") { return -> (Kind.plus_percent_shift_left, 4) }
    if matches(source, source_length, start, "-%<<") { return -> (Kind.minus_percent_shift_left, 4) }
    if matches(source, source_length, start, "*%<<") { return -> (Kind.asterisk_percent_shift_left, 4) }
    if matches(source, source_length, start, "+|<<") { return -> (Kind.plus_pipe_shift_left, 4) }
    if matches(source, source_length, start, "-|<<") { return -> (Kind.minus_pipe_shift_left, 4) }
    if matches(source, source_length, start, "*|<<") { return -> (Kind.asterisk_pipe_shift_left, 4) }
    if matches(source, source_length, start, "+%>>") { return -> (Kind.plus_percent_shift_right, 4) }
    if matches(source, source_length, start, "-%>>") { return -> (Kind.minus_percent_shift_right, 4) }
    if matches(source, source_length, start, "*%>>") { return -> (Kind.asterisk_percent_shift_right, 4) }
    if matches(source, source_length, start, "+|>>") { return -> (Kind.plus_pipe_shift_right, 4) }
    if matches(source, source_length, start, "-|>>") { return -> (Kind.minus_pipe_shift_right, 4) }
    if matches(source, source_length, start, "*|>>") { return -> (Kind.asterisk_pipe_shift_right, 4) }
    if matches(source, source_length, start, "<<%|") { return -> (Kind.shift_left_percent_pipe, 4) }
    if matches(source, source_length, start, "&<<=") { return -> (Kind.ampersand_shift_left_equal, 4) }
    if matches(source, source_length, start, "|<<=") { return -> (Kind.pipe_shift_left_equal, 4) }
    if matches(source, source_length, start, "^<<=") { return -> (Kind.caret_shift_left_equal, 4) }
    if matches(source, source_length, start, "&>>=") { return -> (Kind.ampersand_shift_right_equal, 4) }
    if matches(source, source_length, start, "|>>=") { return -> (Kind.pipe_shift_right_equal, 4) }
    if matches(source, source_length, start, "^>>=") { return -> (Kind.caret_shift_right_equal, 4) }
    if matches(source, source_length, start, "<<&=") { return -> (Kind.shift_left_ampersand_equal, 4) }
    if matches(source, source_length, start, "<<^=") { return -> (Kind.shift_left_caret_equal, 4) }
    if matches(source, source_length, start, ">>&=") { return -> (Kind.shift_right_ampersand_equal, 4) }
    if matches(source, source_length, start, ">>|=") { return -> (Kind.shift_right_pipe_equal, 4) }
    if matches(source, source_length, start, ">>^=") { return -> (Kind.shift_right_caret_equal, 4) }
    if matches(source, source_length, start, "+<<=") { return -> (Kind.plus_shift_left_equal, 4) }
    if matches(source, source_length, start, "-<<=") { return -> (Kind.minus_shift_left_equal, 4) }
    if matches(source, source_length, start, "*<<=") { return -> (Kind.asterisk_shift_left_equal, 4) }
    if matches(source, source_length, start, "+>>=") { return -> (Kind.plus_shift_right_equal, 4) }
    if matches(source, source_length, start, "->>=") { return -> (Kind.minus_shift_right_equal, 4) }
    if matches(source, source_length, start, "*>>=") { return -> (Kind.asterisk_shift_right_equal, 4) }
    if matches(source, source_length, start, "<<%=") { return -> (Kind.shift_left_percent_equal, 4) }
    if matches(source, source_length, start, ">>%=") { return -> (Kind.shift_right_percent_equal, 4) }
    if matches(source, source_length, start, "<<|=") { return -> (Kind.shift_left_pipe_equal, 4) }

    // Three-byte shifts, combines, and arithmetic assignments.
    if matches(source, source_length, start, "&<<") { return -> (Kind.ampersand_shift_left, 3) }
    if matches(source, source_length, start, "|<<") { return -> (Kind.pipe_shift_left, 3) }
    if matches(source, source_length, start, "^<<") { return -> (Kind.caret_shift_left, 3) }
    if matches(source, source_length, start, "&>>") { return -> (Kind.ampersand_shift_right, 3) }
    if matches(source, source_length, start, "|>>") { return -> (Kind.pipe_shift_right, 3) }
    if matches(source, source_length, start, "^>>") { return -> (Kind.caret_shift_right, 3) }
    if matches(source, source_length, start, "<<&") { return -> (Kind.shift_left_ampersand, 3) }
    if matches(source, source_length, start, "<<^") { return -> (Kind.shift_left_caret, 3) }
    if matches(source, source_length, start, ">>&") { return -> (Kind.shift_right_ampersand, 3) }
    if matches(source, source_length, start, ">>|") { return -> (Kind.shift_right_pipe, 3) }
    if matches(source, source_length, start, ">>^") { return -> (Kind.shift_right_caret, 3) }
    if matches(source, source_length, start, "+<<") { return -> (Kind.plus_shift_left, 3) }
    if matches(source, source_length, start, "-<<") { return -> (Kind.minus_shift_left, 3) }
    if matches(source, source_length, start, "*<<") { return -> (Kind.asterisk_shift_left, 3) }
    if matches(source, source_length, start, "+>>") { return -> (Kind.plus_shift_right, 3) }
    if matches(source, source_length, start, "->>") { return -> (Kind.minus_shift_right, 3) }
    if matches(source, source_length, start, "*>>") { return -> (Kind.asterisk_shift_right, 3) }
    if matches(source, source_length, start, "<<%") { return -> (Kind.shift_left_percent, 3) }
    if matches(source, source_length, start, ">>%") { return -> (Kind.shift_right_percent, 3) }
    if matches(source, source_length, start, "<<|") { return -> (Kind.shift_left_pipe, 3) }
    if matches(source, source_length, start, "+%=") { return -> (Kind.plus_percent_equal, 3) }
    if matches(source, source_length, start, "-%=") { return -> (Kind.minus_percent_equal, 3) }
    if matches(source, source_length, start, "*%=") { return -> (Kind.asterisk_percent_equal, 3) }
    if matches(source, source_length, start, "+|=") { return -> (Kind.plus_pipe_equal, 3) }
    if matches(source, source_length, start, "-|=") { return -> (Kind.minus_pipe_equal, 3) }
    if matches(source, source_length, start, "*|=") { return -> (Kind.asterisk_pipe_equal, 3) }

    // Two-byte operators.
    if matches(source, source_length, start, "->") { return -> (Kind.arrow, 2) }
    if matches(source, source_length, start, "=>") { return -> (Kind.arrow, 2) }
    if matches(source, source_length, start, "..") { return -> (Kind.dot_dot, 2) }
    if matches(source, source_length, start, ".*") { return -> (Kind.dot_asterisk, 2) }
    if matches(source, source_length, start, ".?") { return -> (Kind.dot_question, 2) }
    if matches(source, source_length, start, "==") { return -> (Kind.equal_equal, 2) }
    if matches(source, source_length, start, "!=") { return -> (Kind.bang_equal, 2) }
    if matches(source, source_length, start, "<=") { return -> (Kind.less_equal, 2) }
    if matches(source, source_length, start, ">=") { return -> (Kind.greater_equal, 2) }
    if matches(source, source_length, start, "&&") { return -> (Kind.ampersand_ampersand, 2) }
    if matches(source, source_length, start, "||") { return -> (Kind.pipe_pipe, 2) }
    if matches(source, source_length, start, "<<=") { return -> (Kind.shift_left_equal, 3) }
    if matches(source, source_length, start, ">>=") { return -> (Kind.shift_right_equal, 3) }
    if matches(source, source_length, start, "<<") { return -> (Kind.shift_left, 2) }
    if matches(source, source_length, start, ">>") { return -> (Kind.shift_right, 2) }
    if matches(source, source_length, start, "+%") { return -> (Kind.plus_percent, 2) }
    if matches(source, source_length, start, "-%") { return -> (Kind.minus_percent, 2) }
    if matches(source, source_length, start, "*%") { return -> (Kind.asterisk_percent, 2) }
    if matches(source, source_length, start, "+|") { return -> (Kind.plus_pipe, 2) }
    if matches(source, source_length, start, "-|") { return -> (Kind.minus_pipe, 2) }
    if matches(source, source_length, start, "*|") { return -> (Kind.asterisk_pipe, 2) }
    if matches(source, source_length, start, "+=") { return -> (Kind.plus_equal, 2) }
    if matches(source, source_length, start, "-=") { return -> (Kind.minus_equal, 2) }
    if matches(source, source_length, start, "*=") { return -> (Kind.asterisk_equal, 2) }
    if matches(source, source_length, start, "/=") { return -> (Kind.slash_equal, 2) }
    if matches(source, source_length, start, "%=") { return -> (Kind.percent_equal, 2) }
    if matches(source, source_length, start, "&=") { return -> (Kind.ampersand_equal, 2) }
    if matches(source, source_length, start, "|=") { return -> (Kind.pipe_equal, 2) }
    if matches(source, source_length, start, "^=") { return -> (Kind.caret_equal, 2) }

    // One-byte punctuation and operators.
    if matches(source, source_length, start, ",") { return -> (Kind.comma, 1) }
    if matches(source, source_length, start, ":") { return -> (Kind.colon, 1) }
    if matches(source, source_length, start, "(") { return -> (Kind.left_parenthesis, 1) }
    if matches(source, source_length, start, ")") { return -> (Kind.right_parenthesis, 1) }
    if matches(source, source_length, start, "{") { return -> (Kind.left_brace, 1) }
    if matches(source, source_length, start, "}") { return -> (Kind.right_brace, 1) }
    if matches(source, source_length, start, "[") { return -> (Kind.left_bracket, 1) }
    if matches(source, source_length, start, "]") { return -> (Kind.right_bracket, 1) }
    if matches(source, source_length, start, ".") { return -> (Kind.dot, 1) }
    if matches(source, source_length, start, "@") { return -> (Kind.at, 1) }
    if matches(source, source_length, start, "!") { return -> (Kind.bang, 1) }
    if matches(source, source_length, start, "?") { return -> (Kind.question, 1) }
    if matches(source, source_length, start, "+") { return -> (Kind.plus, 1) }
    if matches(source, source_length, start, "-") { return -> (Kind.minus, 1) }
    if matches(source, source_length, start, "*") { return -> (Kind.asterisk, 1) }
    if matches(source, source_length, start, "/") { return -> (Kind.slash, 1) }
    if matches(source, source_length, start, "%") { return -> (Kind.percent, 1) }
    if matches(source, source_length, start, "&") { return -> (Kind.ampersand, 1) }
    if matches(source, source_length, start, "|") { return -> (Kind.pipe, 1) }
    if matches(source, source_length, start, "^") { return -> (Kind.caret, 1) }
    if matches(source, source_length, start, "~") { return -> (Kind.tilde, 1) }
    if matches(source, source_length, start, "<") { return -> (Kind.less, 1) }
    if matches(source, source_length, start, ">") { return -> (Kind.greater, 1) }
    if matches(source, source_length, start, "=") { return -> (Kind.equal, 1) }
    return -> (Kind.invalid, 1)
}
