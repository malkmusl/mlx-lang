pub const Kind = enum(u16) {
    invalid,
    end_of_file,
    statement_end,

    identifier,
    integer,
    float,
    string,
    byte_string,
    character,

    keyword_pub,
    keyword_export,
    keyword_inline,
    keyword_noinline,
    keyword_extern,
    keyword_const,
    keyword_var,
    keyword_threadlocal,
    keyword_fn,
    keyword_comptime,
    keyword_try,
    keyword_anytype,
    keyword_test,
    keyword_if,
    keyword_else,
    keyword_while,
    keyword_for,
    keyword_in,
    keyword_match,
    keyword_return,
    keyword_break,
    keyword_continue,
    keyword_defer,
    keyword_errdefer,
    keyword_unsafe,
    keyword_volatile,
    keyword_align,
    keyword_struct,
    keyword_enum,
    keyword_union,
    keyword_error,
    keyword_packed,
    keyword_nonexhaustive,
    keyword_true,
    keyword_false,
    keyword_null,
    keyword_undefined,
    keyword_type,

    comma,
    colon,
    left_parenthesis,
    right_parenthesis,
    left_brace,
    right_brace,
    left_bracket,
    right_bracket,
    dot,
    dot_dot,
    dot_asterisk,
    dot_question,
    arrow,
    at,
    bang,
    question,

    plus,
    minus,
    asterisk,
    slash,
    percent,
    plus_percent,
    minus_percent,
    asterisk_percent,
    plus_pipe,
    minus_pipe,
    asterisk_pipe,

    ampersand,
    pipe,
    caret,
    tilde,

    equal_equal,
    bang_equal,
    less,
    less_equal,
    greater,
    greater_equal,
    ampersand_ampersand,
    pipe_pipe,

    shift_left,
    shift_right,
    shift_left_percent,
    shift_right_percent,
    shift_left_pipe,
    shift_left_percent_pipe,

    ampersand_shift_left,
    pipe_shift_left,
    caret_shift_left,
    ampersand_shift_right,
    pipe_shift_right,
    caret_shift_right,
    plus_shift_left,
    minus_shift_left,
    asterisk_shift_left,
    plus_percent_shift_left,
    minus_percent_shift_left,
    asterisk_percent_shift_left,
    plus_pipe_shift_left,
    minus_pipe_shift_left,
    asterisk_pipe_shift_left,
    plus_shift_right,
    minus_shift_right,
    asterisk_shift_right,
    plus_percent_shift_right,
    minus_percent_shift_right,
    asterisk_percent_shift_right,
    plus_pipe_shift_right,
    minus_pipe_shift_right,
    asterisk_pipe_shift_right,

    shift_left_ampersand,
    shift_left_caret,
    shift_right_ampersand,
    shift_right_pipe,
    shift_right_caret,

    equal,
    plus_equal,
    minus_equal,
    asterisk_equal,
    slash_equal,
    percent_equal,
    plus_percent_equal,
    minus_percent_equal,
    asterisk_percent_equal,
    plus_pipe_equal,
    minus_pipe_equal,
    asterisk_pipe_equal,
    ampersand_equal,
    pipe_equal,
    caret_equal,
    shift_left_equal,
    shift_right_equal,
    shift_left_percent_equal,
    shift_right_percent_equal,
    shift_left_pipe_equal,
    shift_left_percent_pipe_equal,

    ampersand_shift_left_equal,
    pipe_shift_left_equal,
    caret_shift_left_equal,
    ampersand_shift_right_equal,
    pipe_shift_right_equal,
    caret_shift_right_equal,
    shift_left_ampersand_equal,
    shift_left_caret_equal,
    shift_right_ampersand_equal,
    shift_right_pipe_equal,
    shift_right_caret_equal,
    plus_shift_left_equal,
    minus_shift_left_equal,
    asterisk_shift_left_equal,
    plus_percent_shift_left_equal,
    minus_percent_shift_left_equal,
    asterisk_percent_shift_left_equal,
    plus_pipe_shift_left_equal,
    minus_pipe_shift_left_equal,
    asterisk_pipe_shift_left_equal,
    plus_shift_right_equal,
    minus_shift_right_equal,
    asterisk_shift_right_equal,
    plus_percent_shift_right_equal,
    minus_percent_shift_right_equal,
    asterisk_percent_shift_right_equal,
    plus_pipe_shift_right_equal,
    minus_pipe_shift_right_equal,
    asterisk_pipe_shift_right_equal
}

pub const Token = struct {
    kind: Kind
    start: usize
    length: usize
}

pub fn init(kind: Kind, start: usize, length: usize) -> Token {
    return Token.{ .kind = kind, .start = start, .length = length }
}

pub fn requiresContinuation(kind: Kind) -> bool {
    if kind == Kind.plus || kind == Kind.minus || kind == Kind.asterisk || kind == Kind.slash || kind == Kind.percent { return true }
    if kind == Kind.plus_percent || kind == Kind.minus_percent || kind == Kind.asterisk_percent { return true }
    if kind == Kind.plus_pipe || kind == Kind.minus_pipe || kind == Kind.asterisk_pipe { return true }
    if kind == Kind.equal_equal || kind == Kind.bang_equal || kind == Kind.less || kind == Kind.less_equal || kind == Kind.greater || kind == Kind.greater_equal { return true }
    if kind == Kind.ampersand_ampersand || kind == Kind.pipe_pipe || kind == Kind.ampersand || kind == Kind.pipe || kind == Kind.caret { return true }
    if kind >= Kind.shift_left && kind <= Kind.shift_right_caret { return true }
    if kind >= Kind.equal && kind <= Kind.asterisk_pipe_shift_right_equal { return true }
    if kind == Kind.comma || kind == Kind.dot || kind == Kind.dot_dot || kind == Kind.arrow || kind == Kind.colon { return true }
    return false
}

pub fn canTerminate(kind: Kind) -> bool {
    if kind == Kind.identifier || kind == Kind.integer || kind == Kind.float || kind == Kind.string || kind == Kind.byte_string || kind == Kind.character { return true }
    if kind == Kind.keyword_true || kind == Kind.keyword_false || kind == Kind.keyword_null || kind == Kind.keyword_undefined { return true }
    if kind == Kind.right_parenthesis || kind == Kind.right_bracket || kind == Kind.right_brace { return true }
    if kind == Kind.keyword_return || kind == Kind.keyword_break || kind == Kind.keyword_continue { return true }
    return false
}
