const ascii = @import("../../../std/bootstrap/ascii.mlx")
const token = @import("./token.mlx")
const keywords = @import("./keywords.mlx")
const operators = @import("./operators.mlx")

pub const Kind = token.Kind
pub const Token = token.Token

pub const Scanner = struct {
    source: [*]const u8
    length: usize
    index: usize
    parenthesisDepth: usize
    bracketDepth: usize
    lastKind: Kind
    hasLastKind: bool

fn sliceLength(source: []const u8) -> usize {
    var length: usize = 0
    for byte in source { length += 1 }
    return length
}

pub fn init(source: []const u8) -> Self {
    unsafe {
        return Self.{
            .source = @ptrCast([*]const u8, source),
            .length = Self.sliceLength(source),
            .index = 0,
            .parenthesisDepth = 0,
            .bracketDepth = 0,
            .lastKind = Kind.invalid,
            .hasLastKind = false,
        }
    }
}

fn peek(scanner: *Self, offset: usize) -> u8 {
    if scanner.*.index + offset >= scanner.*.length { return 0 }
    return scanner.*.source[scanner.*.index + offset]
}

fn finish(scanner: *Self, kind: Kind, start: usize, length: usize) -> Token {
    if kind == Kind.left_parenthesis { scanner.*.parenthesisDepth += 1 }
    if kind == Kind.right_parenthesis && scanner.*.parenthesisDepth > 0 { scanner.*.parenthesisDepth -= 1 }
    if kind == Kind.left_bracket { scanner.*.bracketDepth += 1 }
    if kind == Kind.right_bracket && scanner.*.bracketDepth > 0 { scanner.*.bracketDepth -= 1 }
    if kind != Kind.invalid && kind != Kind.end_of_file {
        scanner.*.lastKind = kind
        scanner.*.hasLastKind = true
    }
    return token.init(kind, start, length)
}

fn shouldEmitStatementEnd(scanner: *Self) -> bool {
    if scanner.*.parenthesisDepth > 0 || scanner.*.bracketDepth > 0 || !scanner.*.hasLastKind { return false }
    if token.requiresContinuation(scanner.*.lastKind) { return false }
    return token.canTerminate(scanner.*.lastKind)
}

fn isIdentifierStart(byte: u8) -> bool {
    return ascii.isAlphabetic(byte) || byte == 95
}

fn isIdentifierContinue(byte: u8) -> bool {
    return ascii.isAlphanumeric(byte) || byte == 95
}

fn numberIsHex(scanner: *Self, start: usize) -> bool {
    if start + 1 >= scanner.*.length || scanner.*.source[start] != 48 { return false }
    return scanner.*.source[start + 1] == 120 || scanner.*.source[start + 1] == 88
}

fn classifyNumber(scanner: *Self, start: usize, end: usize) -> Kind {
    const hexadecimal = Self.numberIsHex(scanner, start)
    var index = start
    while index < end {
        const byte = scanner.*.source[index]
        if byte == 46 { return Kind.float }
        if hexadecimal && (byte == 112 || byte == 80) { return Kind.float }
        if !hexadecimal && (byte == 101 || byte == 69) { return Kind.float }
        index += 1
    }
    return Kind.integer
}

fn scanQuoted(scanner: *Self, start: usize, delimiter: u8, kind: Kind) -> Token {
    while scanner.*.index < scanner.*.length {
        const byte = Self.peek(scanner, 0)
        if byte == delimiter {
            scanner.*.index += 1
            return Self.finish(scanner, kind, start, scanner.*.index - start)
        }
        if byte == 92 {
            scanner.*.index += 1
            if scanner.*.index < scanner.*.length { scanner.*.index += 1 }
        } else {
            scanner.*.index += 1
        }
    }
    return Self.finish(scanner, Kind.invalid, start, scanner.*.index - start)
}

fn skipBlockComment(scanner: *Self, start: usize) -> Token {
    var depth: usize = 1
    scanner.*.index += 2
    while scanner.*.index < scanner.*.length {
        if Self.peek(scanner, 0) == 47 && Self.peek(scanner, 1) == 42 {
            depth += 1
            scanner.*.index += 2
        } else if Self.peek(scanner, 0) == 42 && Self.peek(scanner, 1) == 47 {
            depth -= 1
            scanner.*.index += 2
            if depth == 0 { return token.init(Kind.end_of_file, 0, 0) }
        } else {
            scanner.*.index += 1
        }
    }
    return Self.finish(scanner, Kind.invalid, start, scanner.*.index - start)
}

fn scanIdentifier(scanner: *Self, start: usize) -> Token {
    scanner.*.index += 1
    while scanner.*.index < scanner.*.length && Self.isIdentifierContinue(Self.peek(scanner, 0)) { scanner.*.index += 1 }
    unsafe {
        const pointer = @ptrFromInt([*]const u8, @intFromPtr(scanner.*.source) + start)
        const kind = keywords.classify(pointer, scanner.*.index - start)
        return Self.finish(scanner, kind, start, scanner.*.index - start)
    }
}

fn scanNumber(scanner: *Self, start: usize) -> Token {
    scanner.*.index += 1
    while scanner.*.index < scanner.*.length {
        const current = Self.peek(scanner, 0)
        if current == 46 && Self.peek(scanner, 1) == 46 { break }
        if Self.isIdentifierContinue(current) || current == 46 {
            scanner.*.index += 1
            continue
        }
        if (current == 43 || current == 45) && scanner.*.index > start {
            const previous = scanner.*.source[scanner.*.index - 1]
            if previous == 101 || previous == 69 || previous == 112 || previous == 80 {
                scanner.*.index += 1
                continue
            }
        }
        break
    }
    return Self.finish(scanner, Self.classifyNumber(scanner, start, scanner.*.index), start, scanner.*.index - start)
}

pub fn next(scanner: *Self) -> Token {
    while true {
        if scanner.*.index >= scanner.*.length {
            return token.init(Kind.end_of_file, scanner.*.index, 0)
        }

        const byte = Self.peek(scanner, 0)
        if byte == 32 || byte == 9 || byte == 13 {
            scanner.*.index += 1
            continue
        }
        if byte == 10 {
            const start = scanner.*.index
            scanner.*.index += 1
            if Self.shouldEmitStatementEnd(scanner) { return Self.finish(scanner, Kind.statement_end, start, 1) }
            continue
        }
        if byte == 47 && Self.peek(scanner, 1) == 47 {
            scanner.*.index += 2
            while scanner.*.index < scanner.*.length && Self.peek(scanner, 0) != 10 { scanner.*.index += 1 }
            continue
        }
        if byte == 47 && Self.peek(scanner, 1) == 42 {
            const comment_start = scanner.*.index
            const comment_result = Self.skipBlockComment(scanner, comment_start)
            if comment_result.kind == Kind.invalid { return comment_result }
            continue
        }

        const start = scanner.*.index
        if byte == 98 && Self.peek(scanner, 1) == 34 {
            scanner.*.index += 2
            return Self.scanQuoted(scanner, start, 34, Kind.byte_string)
        }
        if Self.isIdentifierStart(byte) { return Self.scanIdentifier(scanner, start) }
        if ascii.isDigit(byte) { return Self.scanNumber(scanner, start) }
        if byte == 34 {
            scanner.*.index += 1
            return Self.scanQuoted(scanner, start, 34, Kind.string)
        }
        if byte == 39 {
            scanner.*.index += 1
            return Self.scanQuoted(scanner, start, 39, Kind.character)
        }

        const operator = operators.scan(scanner.*.source, scanner.*.length, start)
        scanner.*.index += operator.1
        return Self.finish(scanner, operator.0, start, operator.1)
    }
    return token.init(Kind.end_of_file, scanner.*.index, 0)
}

pub fn nextFrom(source: []const u8, start: usize) -> Token {
    var scanner = Self.init(source)
    scanner.index = start
    return Self.next(&scanner)
}

pub fn count(source: []const u8) -> usize {
    var scanner = Self.init(source)
    var result: usize = 0
    while true {
        const current = Self.next(&scanner)
        if current.kind == Kind.end_of_file { return result }
        result += 1
    }
    return result
}
}
