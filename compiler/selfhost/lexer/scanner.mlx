const token = @import("./token.mlx")
const keywords = @import("./keywords.mlx")
const operators = @import("./operators.mlx")

pub const Kind = token.Kind
pub const Token = token.Token

pub const Scanner = struct {
    source: [*]const u8
    length: usize
    index: usize
    parenthesisDepth: usize
    bracketDepth: usize
    lastKind: Kind
    hasLastKind: bool

fn sliceLength(source: []const u8) -> usize {
    var length: usize = 0
    for byte in source { length += 1 }
    return length
}

pub fn init(source: []const u8) -> Self {
    return Self.initLength(source, Self.sliceLength(source))
}

pub fn initLength(source: []const u8, length: usize) -> Self {
    unsafe {
        return Self.{
            .source = @ptrCast([*]const u8, source),
            .length = length,
            .index = 0,
            .parenthesisDepth = 0,
            .bracketDepth = 0,
            .lastKind = Kind.invalid,
            .hasLastKind = false,
        }
    }
}

fn peek(scanner: *Self, offset: usize) -> u8 {
    if scanner.*.index + offset >= scanner.*.length { return 0 }
    return scanner.*.source[scanner.*.index + offset]
}

fn finishInto(scanner: *Self, result: *Token, kind: Kind, start: usize, length: usize) -> void {
    if kind == Kind.left_parenthesis { scanner.*.parenthesisDepth += 1 }
    if kind == Kind.right_parenthesis && scanner.*.parenthesisDepth > 0 { scanner.*.parenthesisDepth -= 1 }
    if kind == Kind.left_bracket { scanner.*.bracketDepth += 1 }
    if kind == Kind.right_bracket && scanner.*.bracketDepth > 0 { scanner.*.bracketDepth -= 1 }
    if kind != Kind.invalid && kind != Kind.end_of_file {
        scanner.*.lastKind = kind
        scanner.*.hasLastKind = true
    }
    result.*.kind = kind
    result.*.start = start
    result.*.length = length
}

fn shouldEmitStatementEnd(scanner: *Self) -> bool {
    if scanner.*.parenthesisDepth > 0 || scanner.*.bracketDepth > 0 || !scanner.*.hasLastKind { return false }
    if token.requiresContinuation(scanner.*.lastKind) { return false }
    return token.canTerminate(scanner.*.lastKind)
}

fn numberIsHex(scanner: *Self, start: usize) -> bool {
    if start + 1 >= scanner.*.length || scanner.*.source[start] != 48 { return false }
    return scanner.*.source[start + 1] == 120 || scanner.*.source[start + 1] == 88
}

fn classifyNumber(scanner: *Self, start: usize, end: usize) -> Kind {
    const hexadecimal = Self.numberIsHex(scanner, start)
    var index = start
    while index < end {
        const byte = scanner.*.source[index]
        if byte == 46 { return Kind.float }
        if hexadecimal && (byte == 112 || byte == 80) { return Kind.float }
        if !hexadecimal && (byte == 101 || byte == 69) { return Kind.float }
        index += 1
    }
    return Kind.integer
}

fn scanQuotedInto(scanner: *Self, result: *Token, start: usize, delimiter: u8, kind: Kind) -> void {
    while scanner.*.index < scanner.*.length {
        const byte = scanner.*.source[scanner.*.index]
        if byte == delimiter {
            scanner.*.index += 1
            Self.finishInto(scanner, result, kind, start, scanner.*.index - start)
            return
        }
        if byte == 92 {
            scanner.*.index += 1
            if scanner.*.index < scanner.*.length { scanner.*.index += 1 }
        } else {
            scanner.*.index += 1
        }
    }
    Self.finishInto(scanner, result, Kind.invalid, start, scanner.*.index - start)
}

fn skipBlockComment(scanner: *Self, result: *Token, start: usize) -> bool {
    var depth: usize = 1
    scanner.*.index += 2
    while scanner.*.index < scanner.*.length {
        const current = scanner.*.source[scanner.*.index]
        if current == 47 && Self.peek(scanner, 1) == 42 {
            depth += 1
            scanner.*.index += 2
        } else if current == 42 && Self.peek(scanner, 1) == 47 {
            depth -= 1
            scanner.*.index += 2
            if depth == 0 { return false }
        } else {
            scanner.*.index += 1
        }
    }
    Self.finishInto(scanner, result, Kind.invalid, start, scanner.*.index - start)
    return true
}

fn scanIdentifierInto(scanner: *Self, result: *Token, start: usize) -> void {
    scanner.*.index += 1
    while scanner.*.index < scanner.*.length {
        const byte = scanner.*.source[scanner.*.index]
        const lowercase = byte | 32
        const continues = (byte >= 48 && byte <= 57) || (lowercase >= 97 && lowercase <= 122) || byte == 95
        if !continues { break }
        scanner.*.index += 1
    }
    unsafe {
        const pointer = @ptrFromInt([*]const u8, @intFromPtr(scanner.*.source) + start)
        const kind = keywords.classify(pointer, scanner.*.index - start)
        Self.finishInto(scanner, result, kind, start, scanner.*.index - start)
    }
}

fn scanNumberInto(scanner: *Self, result: *Token, start: usize) -> void {
    scanner.*.index += 1
    while scanner.*.index < scanner.*.length {
        const current = scanner.*.source[scanner.*.index]
        if current == 46 && Self.peek(scanner, 1) == 46 { break }
        const lowercase = current | 32
        const continues = (current >= 48 && current <= 57) || (lowercase >= 97 && lowercase <= 122) || current == 95
        if continues || current == 46 {
            scanner.*.index += 1
            continue
        }
        if (current == 43 || current == 45) && scanner.*.index > start {
            const previous = scanner.*.source[scanner.*.index - 1]
            if previous == 101 || previous == 69 || previous == 112 || previous == 80 {
                scanner.*.index += 1
                continue
            }
        }
        break
    }
    Self.finishInto(scanner, result, Self.classifyNumber(scanner, start, scanner.*.index), start, scanner.*.index - start)
}

pub fn nextInto(scanner: *Self, result: *Token) -> void {
    while true {
        if scanner.*.index >= scanner.*.length {
            result.*.kind = Kind.end_of_file
            result.*.start = scanner.*.index
            result.*.length = 0
            return
        }

        const byte = scanner.*.source[scanner.*.index]
        if byte == 32 || byte == 9 || byte == 13 {
            scanner.*.index += 1
            continue
        }
        if byte == 10 {
            const start = scanner.*.index
            scanner.*.index += 1
            if Self.shouldEmitStatementEnd(scanner) {
                Self.finishInto(scanner, result, Kind.statement_end, start, 1)
                return
            }
            continue
        }
        if byte == 47 && Self.peek(scanner, 1) == 47 {
            scanner.*.index += 2
            while scanner.*.index < scanner.*.length && scanner.*.source[scanner.*.index] != 10 { scanner.*.index += 1 }
            continue
        }
        if byte == 47 && Self.peek(scanner, 1) == 42 {
            const comment_start = scanner.*.index
            if Self.skipBlockComment(scanner, result, comment_start) { return }
            continue
        }

        const start = scanner.*.index
        if byte == 98 && Self.peek(scanner, 1) == 34 {
            scanner.*.index += 2
            Self.scanQuotedInto(scanner, result, start, 34, Kind.byte_string)
            return
        }
        const lowercase = byte | 32
        const identifier_start = (lowercase >= 97 && lowercase <= 122) || byte == 95
        if identifier_start {
            Self.scanIdentifierInto(scanner, result, start)
            return
        }
        if byte >= 48 && byte <= 57 {
            Self.scanNumberInto(scanner, result, start)
            return
        }
        if byte == 34 {
            scanner.*.index += 1
            Self.scanQuotedInto(scanner, result, start, 34, Kind.string)
            return
        }
        if byte == 39 {
            scanner.*.index += 1
            Self.scanQuotedInto(scanner, result, start, 39, Kind.character)
            return
        }

        const operator = operators.scan(scanner.*.source, scanner.*.length, start)
        scanner.*.index += operator.1
        Self.finishInto(scanner, result, operator.0, start, operator.1)
        return
    }
}

pub fn next(scanner: *Self) -> Token {
    var result = token.init(Kind.invalid, 0, 0)
    Self.nextInto(scanner, &result)
    return result
}

pub fn nextFrom(source: []const u8, start: usize) -> Token {
    var scanner = Self.init(source)
    scanner.index = start
    return Self.next(&scanner)
}

pub fn count(source: []const u8) -> usize {
    var scanner = Self.init(source)
    var current = token.init(Kind.invalid, 0, 0)
    var result: usize = 0
    while true {
        Self.nextInto(&scanner, &current)
        if current.kind == Kind.end_of_file { return result }
        result += 1
    }
    return result
}
}
