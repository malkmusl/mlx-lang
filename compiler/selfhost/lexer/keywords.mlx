const token = @import("./token.mlx")

pub const Kind = token.Kind

fn equals(source: [*]const u8, length: usize, expected: []const u8) -> bool {
    var index: usize = 0
    while index < length {
        if source[index] != expected[index] { return false }
        index += 1
    }
    return true
}

pub fn classify(source: [*]const u8, length: usize) -> Kind {
    if length == 2 {
        if equals(source, length, "fn") { return Kind.keyword_fn }
        if equals(source, length, "if") { return Kind.keyword_if }
        if equals(source, length, "in") { return Kind.keyword_in }
    }
    if length == 3 {
        if equals(source, length, "pub") { return Kind.keyword_pub }
        if equals(source, length, "var") { return Kind.keyword_var }
        if equals(source, length, "try") { return Kind.keyword_try }
        if equals(source, length, "for") { return Kind.keyword_for }
    }
    if length == 4 {
        if equals(source, length, "test") { return Kind.keyword_test }
        if equals(source, length, "else") { return Kind.keyword_else }
        if equals(source, length, "enum") { return Kind.keyword_enum }
        if equals(source, length, "true") { return Kind.keyword_true }
        if equals(source, length, "null") { return Kind.keyword_null }
        if equals(source, length, "type") { return Kind.keyword_type }
    }
    if length == 5 {
        if equals(source, length, "const") { return Kind.keyword_const }
        if equals(source, length, "while") { return Kind.keyword_while }
        if equals(source, length, "match") { return Kind.keyword_match }
        if equals(source, length, "break") { return Kind.keyword_break }
        if equals(source, length, "defer") { return Kind.keyword_defer }
        if equals(source, length, "align") { return Kind.keyword_align }
        if equals(source, length, "union") { return Kind.keyword_union }
        if equals(source, length, "error") { return Kind.keyword_error }
        if equals(source, length, "false") { return Kind.keyword_false }
    }
    if length == 6 {
        if equals(source, length, "export") { return Kind.keyword_export }
        if equals(source, length, "inline") { return Kind.keyword_inline }
        if equals(source, length, "extern") { return Kind.keyword_extern }
        if equals(source, length, "return") { return Kind.keyword_return }
        if equals(source, length, "unsafe") { return Kind.keyword_unsafe }
        if equals(source, length, "struct") { return Kind.keyword_struct }
        if equals(source, length, "packed") { return Kind.keyword_packed }
    }
    if length == 7 && equals(source, length, "anytype") { return Kind.keyword_anytype }
    if length == 8 {
        if equals(source, length, "noinline") { return Kind.keyword_noinline }
        if equals(source, length, "comptime") { return Kind.keyword_comptime }
        if equals(source, length, "continue") { return Kind.keyword_continue }
        if equals(source, length, "errdefer") { return Kind.keyword_errdefer }
        if equals(source, length, "volatile") { return Kind.keyword_volatile }
    }
    if length == 9 && equals(source, length, "undefined") { return Kind.keyword_undefined }
    if length == 11 && equals(source, length, "threadlocal") { return Kind.keyword_threadlocal }
    if length == 13 && equals(source, length, "nonexhaustive") { return Kind.keyword_nonexhaustive }
    return Kind.identifier
}
