const token = @import("./token.mlx")

pub const Kind = token.Kind

fn equals(source: [*]const u8, length: usize, expected: []const u8) -> bool {
    var index: usize = 0
    while index < length {
        if source[index] != expected[index] { return false }
        index += 1
    }
    return true
}

fn classify2(source: [*]const u8) -> Kind {
    if source[0] == 102 && equals(source, 2, "fn") { return Kind.keyword_fn }
    if source[0] == 105 && source[1] == 102 { return Kind.keyword_if }
    if source[0] == 105 && source[1] == 110 { return Kind.keyword_in }
    return Kind.identifier
}

fn classify3(source: [*]const u8) -> Kind {
    if source[0] == 112 && equals(source, 3, "pub") { return Kind.keyword_pub }
    if source[0] == 118 && equals(source, 3, "var") { return Kind.keyword_var }
    if source[0] == 116 && equals(source, 3, "try") { return Kind.keyword_try }
    if source[0] == 102 && equals(source, 3, "for") { return Kind.keyword_for }
    return Kind.identifier
}

fn classify4(source: [*]const u8) -> Kind {
    if source[0] == 116 && source[1] == 101 && equals(source, 4, "test") { return Kind.keyword_test }
    if source[0] == 116 && source[1] == 114 && equals(source, 4, "true") { return Kind.keyword_true }
    if source[0] == 116 && source[1] == 121 && equals(source, 4, "type") { return Kind.keyword_type }
    if source[0] == 101 && source[1] == 108 && equals(source, 4, "else") { return Kind.keyword_else }
    if source[0] == 101 && source[1] == 110 && equals(source, 4, "enum") { return Kind.keyword_enum }
    if source[0] == 110 && equals(source, 4, "null") { return Kind.keyword_null }
    return Kind.identifier
}

fn classify5(source: [*]const u8) -> Kind {
    if source[0] == 99 && equals(source, 5, "const") { return Kind.keyword_const }
    if source[0] == 119 && equals(source, 5, "while") { return Kind.keyword_while }
    if source[0] == 109 && equals(source, 5, "match") { return Kind.keyword_match }
    if source[0] == 98 && equals(source, 5, "break") { return Kind.keyword_break }
    if source[0] == 100 && equals(source, 5, "defer") { return Kind.keyword_defer }
    if source[0] == 97 && equals(source, 5, "align") { return Kind.keyword_align }
    if source[0] == 117 && equals(source, 5, "union") { return Kind.keyword_union }
    if source[0] == 101 && equals(source, 5, "error") { return Kind.keyword_error }
    if source[0] == 102 && equals(source, 5, "false") { return Kind.keyword_false }
    return Kind.identifier
}

fn classify6(source: [*]const u8) -> Kind {
    if source[0] == 101 && source[2] == 112 && equals(source, 6, "export") { return Kind.keyword_export }
    if source[0] == 101 && source[2] == 116 && equals(source, 6, "extern") { return Kind.keyword_extern }
    if source[0] == 105 && equals(source, 6, "inline") { return Kind.keyword_inline }
    if source[0] == 114 && equals(source, 6, "return") { return Kind.keyword_return }
    if source[0] == 117 && equals(source, 6, "unsafe") { return Kind.keyword_unsafe }
    if source[0] == 115 && equals(source, 6, "struct") { return Kind.keyword_struct }
    if source[0] == 112 && equals(source, 6, "packed") { return Kind.keyword_packed }
    return Kind.identifier
}

fn classify8(source: [*]const u8) -> Kind {
    if source[0] == 110 && equals(source, 8, "noinline") { return Kind.keyword_noinline }
    if source[0] == 99 && source[2] == 109 && equals(source, 8, "comptime") { return Kind.keyword_comptime }
    if source[0] == 99 && source[2] == 110 && equals(source, 8, "continue") { return Kind.keyword_continue }
    if source[0] == 101 && equals(source, 8, "errdefer") { return Kind.keyword_errdefer }
    if source[0] == 118 && equals(source, 8, "volatile") { return Kind.keyword_volatile }
    return Kind.identifier
}

pub fn classify(source: [*]const u8, length: usize) -> Kind {
    if length == 2 { return classify2(source) }
    if length == 3 { return classify3(source) }
    if length == 4 { return classify4(source) }
    if length == 5 { return classify5(source) }
    if length == 6 { return classify6(source) }
    if length == 7 && equals(source, length, "anytype") { return Kind.keyword_anytype }
    if length == 8 { return classify8(source) }
    if length == 9 && equals(source, length, "undefined") { return Kind.keyword_undefined }
    if length == 11 && equals(source, length, "threadlocal") { return Kind.keyword_threadlocal }
    if length == 13 && equals(source, length, "nonexhaustive") { return Kind.keyword_nonexhaustive }
    return Kind.identifier
}
