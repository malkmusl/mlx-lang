const token = @import("./token.mlx")

pub const Kind = token.Kind

fn has2(source: [*]const u8, length: usize, start: usize, a: u8, b: u8) -> bool {
    return start + 2 <= length && source[start] == a && source[start + 1] == b
}

fn has3(source: [*]const u8, length: usize, start: usize, a: u8, b: u8, c: u8) -> bool {
    return start + 3 <= length && source[start] == a && source[start + 1] == b && source[start + 2] == c
}

fn has4(source: [*]const u8, length: usize, start: usize, a: u8, b: u8, c: u8, d: u8) -> bool {
    return start + 4 <= length && source[start] == a && source[start + 1] == b && source[start + 2] == c && source[start + 3] == d
}

fn has5(source: [*]const u8, length: usize, start: usize, a: u8, b: u8, c: u8, d: u8, e: u8) -> bool {
    return start + 5 <= length && source[start] == a && source[start + 1] == b && source[start + 2] == c && source[start + 3] == d && source[start + 4] == e
}

fn arithmeticKind(prefix: u8, plus: Kind, minus: Kind, multiply: Kind) -> Kind {
    if prefix == 43 { return plus }
    if prefix == 45 { return minus }
    return multiply
}

fn scanArithmetic(source: [*]const u8, length: usize, start: usize) -> (Kind, usize) {
    const prefix = source[start]
    if has5(source, length, start, prefix, 37, 60, 60, 61) { return -> (arithmeticKind(prefix, Kind.plus_percent_shift_left_equal, Kind.minus_percent_shift_left_equal, Kind.asterisk_percent_shift_left_equal), 5) }
    if has5(source, length, start, prefix, 124, 60, 60, 61) { return -> (arithmeticKind(prefix, Kind.plus_pipe_shift_left_equal, Kind.minus_pipe_shift_left_equal, Kind.asterisk_pipe_shift_left_equal), 5) }
    if has5(source, length, start, prefix, 37, 62, 62, 61) { return -> (arithmeticKind(prefix, Kind.plus_percent_shift_right_equal, Kind.minus_percent_shift_right_equal, Kind.asterisk_percent_shift_right_equal), 5) }
    if has5(source, length, start, prefix, 124, 62, 62, 61) { return -> (arithmeticKind(prefix, Kind.plus_pipe_shift_right_equal, Kind.minus_pipe_shift_right_equal, Kind.asterisk_pipe_shift_right_equal), 5) }
    if has4(source, length, start, prefix, 37, 60, 60) { return -> (arithmeticKind(prefix, Kind.plus_percent_shift_left, Kind.minus_percent_shift_left, Kind.asterisk_percent_shift_left), 4) }
    if has4(source, length, start, prefix, 124, 60, 60) { return -> (arithmeticKind(prefix, Kind.plus_pipe_shift_left, Kind.minus_pipe_shift_left, Kind.asterisk_pipe_shift_left), 4) }
    if has4(source, length, start, prefix, 37, 62, 62) { return -> (arithmeticKind(prefix, Kind.plus_percent_shift_right, Kind.minus_percent_shift_right, Kind.asterisk_percent_shift_right), 4) }
    if has4(source, length, start, prefix, 124, 62, 62) { return -> (arithmeticKind(prefix, Kind.plus_pipe_shift_right, Kind.minus_pipe_shift_right, Kind.asterisk_pipe_shift_right), 4) }
    if has4(source, length, start, prefix, 60, 60, 61) { return -> (arithmeticKind(prefix, Kind.plus_shift_left_equal, Kind.minus_shift_left_equal, Kind.asterisk_shift_left_equal), 4) }
    if has4(source, length, start, prefix, 62, 62, 61) { return -> (arithmeticKind(prefix, Kind.plus_shift_right_equal, Kind.minus_shift_right_equal, Kind.asterisk_shift_right_equal), 4) }
    if has3(source, length, start, prefix, 60, 60) { return -> (arithmeticKind(prefix, Kind.plus_shift_left, Kind.minus_shift_left, Kind.asterisk_shift_left), 3) }
    if has3(source, length, start, prefix, 62, 62) { return -> (arithmeticKind(prefix, Kind.plus_shift_right, Kind.minus_shift_right, Kind.asterisk_shift_right), 3) }
    if has3(source, length, start, prefix, 37, 61) { return -> (arithmeticKind(prefix, Kind.plus_percent_equal, Kind.minus_percent_equal, Kind.asterisk_percent_equal), 3) }
    if has3(source, length, start, prefix, 124, 61) { return -> (arithmeticKind(prefix, Kind.plus_pipe_equal, Kind.minus_pipe_equal, Kind.asterisk_pipe_equal), 3) }
    if has2(source, length, start, prefix, 37) { return -> (arithmeticKind(prefix, Kind.plus_percent, Kind.minus_percent, Kind.asterisk_percent), 2) }
    if has2(source, length, start, prefix, 124) { return -> (arithmeticKind(prefix, Kind.plus_pipe, Kind.minus_pipe, Kind.asterisk_pipe), 2) }
    if has2(source, length, start, prefix, 61) { return -> (arithmeticKind(prefix, Kind.plus_equal, Kind.minus_equal, Kind.asterisk_equal), 2) }
    if prefix == 45 && has2(source, length, start, 45, 62) { return -> (Kind.arrow, 2) }
    if prefix == 43 { return -> (Kind.plus, 1) }
    if prefix == 45 { return -> (Kind.minus, 1) }
    return -> (Kind.asterisk, 1)
}

fn scanLeft(source: [*]const u8, length: usize, start: usize) -> (Kind, usize) {
    if has5(source, length, start, 60, 60, 37, 124, 61) { return -> (Kind.shift_left_percent_pipe_equal, 5) }
    if has4(source, length, start, 60, 60, 37, 124) { return -> (Kind.shift_left_percent_pipe, 4) }
    if has4(source, length, start, 60, 60, 38, 61) { return -> (Kind.shift_left_ampersand_equal, 4) }
    if has4(source, length, start, 60, 60, 94, 61) { return -> (Kind.shift_left_caret_equal, 4) }
    if has4(source, length, start, 60, 60, 37, 61) { return -> (Kind.shift_left_percent_equal, 4) }
    if has4(source, length, start, 60, 60, 124, 61) { return -> (Kind.shift_left_pipe_equal, 4) }
    if has3(source, length, start, 60, 60, 61) { return -> (Kind.shift_left_equal, 3) }
    if has3(source, length, start, 60, 60, 38) { return -> (Kind.shift_left_ampersand, 3) }
    if has3(source, length, start, 60, 60, 94) { return -> (Kind.shift_left_caret, 3) }
    if has3(source, length, start, 60, 60, 37) { return -> (Kind.shift_left_percent, 3) }
    if has3(source, length, start, 60, 60, 124) { return -> (Kind.shift_left_pipe, 3) }
    if has2(source, length, start, 60, 60) { return -> (Kind.shift_left, 2) }
    if has2(source, length, start, 60, 61) { return -> (Kind.less_equal, 2) }
    return -> (Kind.less, 1)
}

fn scanRight(source: [*]const u8, length: usize, start: usize) -> (Kind, usize) {
    if has4(source, length, start, 62, 62, 38, 61) { return -> (Kind.shift_right_ampersand_equal, 4) }
    if has4(source, length, start, 62, 62, 124, 61) { return -> (Kind.shift_right_pipe_equal, 4) }
    if has4(source, length, start, 62, 62, 94, 61) { return -> (Kind.shift_right_caret_equal, 4) }
    if has4(source, length, start, 62, 62, 37, 61) { return -> (Kind.shift_right_percent_equal, 4) }
    if has3(source, length, start, 62, 62, 61) { return -> (Kind.shift_right_equal, 3) }
    if has3(source, length, start, 62, 62, 38) { return -> (Kind.shift_right_ampersand, 3) }
    if has3(source, length, start, 62, 62, 124) { return -> (Kind.shift_right_pipe, 3) }
    if has3(source, length, start, 62, 62, 94) { return -> (Kind.shift_right_caret, 3) }
    if has3(source, length, start, 62, 62, 37) { return -> (Kind.shift_right_percent, 3) }
    if has2(source, length, start, 62, 62) { return -> (Kind.shift_right, 2) }
    if has2(source, length, start, 62, 61) { return -> (Kind.greater_equal, 2) }
    return -> (Kind.greater, 1)
}

fn combineKind(prefix: u8, ampersand: Kind, pipe: Kind, caret: Kind) -> Kind {
    if prefix == 38 { return ampersand }
    if prefix == 124 { return pipe }
    return caret
}

fn scanCombine(source: [*]const u8, length: usize, start: usize) -> (Kind, usize) {
    const prefix = source[start]
    if has4(source, length, start, prefix, 60, 60, 61) { return -> (combineKind(prefix, Kind.ampersand_shift_left_equal, Kind.pipe_shift_left_equal, Kind.caret_shift_left_equal), 4) }
    if has4(source, length, start, prefix, 62, 62, 61) { return -> (combineKind(prefix, Kind.ampersand_shift_right_equal, Kind.pipe_shift_right_equal, Kind.caret_shift_right_equal), 4) }
    if has3(source, length, start, prefix, 60, 60) { return -> (combineKind(prefix, Kind.ampersand_shift_left, Kind.pipe_shift_left, Kind.caret_shift_left), 3) }
    if has3(source, length, start, prefix, 62, 62) { return -> (combineKind(prefix, Kind.ampersand_shift_right, Kind.pipe_shift_right, Kind.caret_shift_right), 3) }
    if prefix == 38 && has2(source, length, start, 38, 38) { return -> (Kind.ampersand_ampersand, 2) }
    if prefix == 124 && has2(source, length, start, 124, 124) { return -> (Kind.pipe_pipe, 2) }
    if has2(source, length, start, prefix, 61) { return -> (combineKind(prefix, Kind.ampersand_equal, Kind.pipe_equal, Kind.caret_equal), 2) }
    if prefix == 38 { return -> (Kind.ampersand, 1) }
    if prefix == 124 { return -> (Kind.pipe, 1) }
    return -> (Kind.caret, 1)
}

pub fn scan(source: [*]const u8, source_length: usize, start: usize) -> (Kind, usize) {
    const first = source[start]
    if first == 43 || first == 45 || first == 42 { return scanArithmetic(source, source_length, start) }
    if first == 60 { return scanLeft(source, source_length, start) }
    if first == 62 { return scanRight(source, source_length, start) }
    if first == 38 || first == 124 || first == 94 { return scanCombine(source, source_length, start) }
    if first == 46 && has2(source, source_length, start, 46, 46) { return -> (Kind.dot_dot, 2) }
    if first == 46 && has2(source, source_length, start, 46, 42) { return -> (Kind.dot_asterisk, 2) }
    if first == 46 && has2(source, source_length, start, 46, 63) { return -> (Kind.dot_question, 2) }
    if first == 61 && has2(source, source_length, start, 61, 62) { return -> (Kind.arrow, 2) }
    if first == 61 && has2(source, source_length, start, 61, 61) { return -> (Kind.equal_equal, 2) }
    if first == 33 && has2(source, source_length, start, 33, 61) { return -> (Kind.bang_equal, 2) }
    if first == 47 && has2(source, source_length, start, 47, 61) { return -> (Kind.slash_equal, 2) }
    if first == 37 && has2(source, source_length, start, 37, 61) { return -> (Kind.percent_equal, 2) }
    if first == 44 { return -> (Kind.comma, 1) }
    if first == 58 { return -> (Kind.colon, 1) }
    if first == 40 { return -> (Kind.left_parenthesis, 1) }
    if first == 41 { return -> (Kind.right_parenthesis, 1) }
    if first == 123 { return -> (Kind.left_brace, 1) }
    if first == 125 { return -> (Kind.right_brace, 1) }
    if first == 91 { return -> (Kind.left_bracket, 1) }
    if first == 93 { return -> (Kind.right_bracket, 1) }
    if first == 46 { return -> (Kind.dot, 1) }
    if first == 64 { return -> (Kind.at, 1) }
    if first == 33 { return -> (Kind.bang, 1) }
    if first == 63 { return -> (Kind.question, 1) }
    if first == 47 { return -> (Kind.slash, 1) }
    if first == 37 { return -> (Kind.percent, 1) }
    if first == 126 { return -> (Kind.tilde, 1) }
    if first == 61 { return -> (Kind.equal, 1) }
    return -> (Kind.invalid, 1)
}
