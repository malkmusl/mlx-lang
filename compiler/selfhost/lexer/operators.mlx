const token = @import("./token.mlx")

pub const Kind = token.Kind

fn arithmeticKind(prefix: u8, plus: Kind, minus: Kind, multiply: Kind) -> Kind {
    if prefix == 43 { return plus }
    if prefix == 45 { return minus }
    return multiply
}

fn scanArithmetic(source: [*]const u8, length: usize, start: usize) -> (Kind, usize) {
    const prefix = source[start]
    if start + 1 >= length { return -> (arithmeticKind(prefix, Kind.plus, Kind.minus, Kind.asterisk), 1) }
    const second = source[start + 1]
    var modifier: u8 = 0
    var shift_offset: usize = 1
    if second == 37 {
        modifier = 1
        shift_offset = 2
    } else if second == 124 {
        modifier = 2
        shift_offset = 2
    }
    if start + shift_offset + 1 < length {
        const shift = source[start + shift_offset]
        if shift == source[start + shift_offset + 1] && (shift == 60 || shift == 62) {
            const consumed = shift_offset + 2
            const assigned = start + consumed < length && source[start + consumed] == 61
            if shift == 60 && modifier == 1 && assigned { return -> (arithmeticKind(prefix, Kind.plus_percent_shift_left_equal, Kind.minus_percent_shift_left_equal, Kind.asterisk_percent_shift_left_equal), consumed + 1) }
            if shift == 60 && modifier == 2 && assigned { return -> (arithmeticKind(prefix, Kind.plus_pipe_shift_left_equal, Kind.minus_pipe_shift_left_equal, Kind.asterisk_pipe_shift_left_equal), consumed + 1) }
            if shift == 62 && modifier == 1 && assigned { return -> (arithmeticKind(prefix, Kind.plus_percent_shift_right_equal, Kind.minus_percent_shift_right_equal, Kind.asterisk_percent_shift_right_equal), consumed + 1) }
            if shift == 62 && modifier == 2 && assigned { return -> (arithmeticKind(prefix, Kind.plus_pipe_shift_right_equal, Kind.minus_pipe_shift_right_equal, Kind.asterisk_pipe_shift_right_equal), consumed + 1) }
            if shift == 60 && modifier == 1 { return -> (arithmeticKind(prefix, Kind.plus_percent_shift_left, Kind.minus_percent_shift_left, Kind.asterisk_percent_shift_left), consumed) }
            if shift == 60 && modifier == 2 { return -> (arithmeticKind(prefix, Kind.plus_pipe_shift_left, Kind.minus_pipe_shift_left, Kind.asterisk_pipe_shift_left), consumed) }
            if shift == 62 && modifier == 1 { return -> (arithmeticKind(prefix, Kind.plus_percent_shift_right, Kind.minus_percent_shift_right, Kind.asterisk_percent_shift_right), consumed) }
            if shift == 62 && modifier == 2 { return -> (arithmeticKind(prefix, Kind.plus_pipe_shift_right, Kind.minus_pipe_shift_right, Kind.asterisk_pipe_shift_right), consumed) }
            if shift == 60 && assigned { return -> (arithmeticKind(prefix, Kind.plus_shift_left_equal, Kind.minus_shift_left_equal, Kind.asterisk_shift_left_equal), consumed + 1) }
            if shift == 62 && assigned { return -> (arithmeticKind(prefix, Kind.plus_shift_right_equal, Kind.minus_shift_right_equal, Kind.asterisk_shift_right_equal), consumed + 1) }
            if shift == 60 { return -> (arithmeticKind(prefix, Kind.plus_shift_left, Kind.minus_shift_left, Kind.asterisk_shift_left), consumed) }
            return -> (arithmeticKind(prefix, Kind.plus_shift_right, Kind.minus_shift_right, Kind.asterisk_shift_right), consumed)
        }
    }
    if modifier == 1 && start + 2 < length && source[start + 2] == 61 { return -> (arithmeticKind(prefix, Kind.plus_percent_equal, Kind.minus_percent_equal, Kind.asterisk_percent_equal), 3) }
    if modifier == 2 && start + 2 < length && source[start + 2] == 61 { return -> (arithmeticKind(prefix, Kind.plus_pipe_equal, Kind.minus_pipe_equal, Kind.asterisk_pipe_equal), 3) }
    if modifier == 1 { return -> (arithmeticKind(prefix, Kind.plus_percent, Kind.minus_percent, Kind.asterisk_percent), 2) }
    if modifier == 2 { return -> (arithmeticKind(prefix, Kind.plus_pipe, Kind.minus_pipe, Kind.asterisk_pipe), 2) }
    if second == 61 { return -> (arithmeticKind(prefix, Kind.plus_equal, Kind.minus_equal, Kind.asterisk_equal), 2) }
    if prefix == 45 && second == 62 { return -> (Kind.arrow, 2) }
    return -> (arithmeticKind(prefix, Kind.plus, Kind.minus, Kind.asterisk), 1)
}

fn scanLeft(source: [*]const u8, length: usize, start: usize) -> (Kind, usize) {
    if start + 1 >= length { return -> (Kind.less, 1) }
    const second = source[start + 1]
    if second == 61 { return -> (Kind.less_equal, 2) }
    if second != 60 { return -> (Kind.less, 1) }
    if start + 2 >= length { return -> (Kind.shift_left, 2) }
    const third = source[start + 2]
    if third == 61 { return -> (Kind.shift_left_equal, 3) }
    if third == 37 && start + 3 < length && source[start + 3] == 124 {
        if start + 4 < length && source[start + 4] == 61 { return -> (Kind.shift_left_percent_pipe_equal, 5) }
        return -> (Kind.shift_left_percent_pipe, 4)
    }
    const assigned = start + 3 < length && source[start + 3] == 61
    if third == 38 { return -> (if assigned { Kind.shift_left_ampersand_equal } else { Kind.shift_left_ampersand }, if assigned { 4 } else { 3 }) }
    if third == 94 { return -> (if assigned { Kind.shift_left_caret_equal } else { Kind.shift_left_caret }, if assigned { 4 } else { 3 }) }
    if third == 37 { return -> (if assigned { Kind.shift_left_percent_equal } else { Kind.shift_left_percent }, if assigned { 4 } else { 3 }) }
    if third == 124 { return -> (if assigned { Kind.shift_left_pipe_equal } else { Kind.shift_left_pipe }, if assigned { 4 } else { 3 }) }
    return -> (Kind.shift_left, 2)
}

fn scanRight(source: [*]const u8, length: usize, start: usize) -> (Kind, usize) {
    if start + 1 >= length { return -> (Kind.greater, 1) }
    const second = source[start + 1]
    if second == 61 { return -> (Kind.greater_equal, 2) }
    if second != 62 { return -> (Kind.greater, 1) }
    if start + 2 >= length { return -> (Kind.shift_right, 2) }
    const third = source[start + 2]
    if third == 61 { return -> (Kind.shift_right_equal, 3) }
    const assigned = start + 3 < length && source[start + 3] == 61
    if third == 38 { return -> (if assigned { Kind.shift_right_ampersand_equal } else { Kind.shift_right_ampersand }, if assigned { 4 } else { 3 }) }
    if third == 124 { return -> (if assigned { Kind.shift_right_pipe_equal } else { Kind.shift_right_pipe }, if assigned { 4 } else { 3 }) }
    if third == 94 { return -> (if assigned { Kind.shift_right_caret_equal } else { Kind.shift_right_caret }, if assigned { 4 } else { 3 }) }
    if third == 37 { return -> (if assigned { Kind.shift_right_percent_equal } else { Kind.shift_right_percent }, if assigned { 4 } else { 3 }) }
    return -> (Kind.shift_right, 2)
}

fn combineKind(prefix: u8, ampersand: Kind, pipe: Kind, caret: Kind) -> Kind {
    if prefix == 38 { return ampersand }
    if prefix == 124 { return pipe }
    return caret
}

fn scanCombine(source: [*]const u8, length: usize, start: usize) -> (Kind, usize) {
    const prefix = source[start]
    const single = combineKind(prefix, Kind.ampersand, Kind.pipe, Kind.caret)
    if start + 1 >= length { return -> (single, 1) }
    const second = source[start + 1]
    if prefix == 38 && second == 38 { return -> (Kind.ampersand_ampersand, 2) }
    if prefix == 124 && second == 124 { return -> (Kind.pipe_pipe, 2) }
    if second == 61 { return -> (combineKind(prefix, Kind.ampersand_equal, Kind.pipe_equal, Kind.caret_equal), 2) }
    if (second != 60 && second != 62) || start + 2 >= length || source[start + 2] != second { return -> (single, 1) }
    const assigned = start + 3 < length && source[start + 3] == 61
    if second == 60 {
        return -> (if assigned { combineKind(prefix, Kind.ampersand_shift_left_equal, Kind.pipe_shift_left_equal, Kind.caret_shift_left_equal) } else { combineKind(prefix, Kind.ampersand_shift_left, Kind.pipe_shift_left, Kind.caret_shift_left) }, if assigned { 4 } else { 3 })
    }
    return -> (if assigned { combineKind(prefix, Kind.ampersand_shift_right_equal, Kind.pipe_shift_right_equal, Kind.caret_shift_right_equal) } else { combineKind(prefix, Kind.ampersand_shift_right, Kind.pipe_shift_right, Kind.caret_shift_right) }, if assigned { 4 } else { 3 })
}

pub fn scan(source: [*]const u8, source_length: usize, start: usize) -> (Kind, usize) {
    const first = source[start]
    if first == 46 {
        if start + 1 < source_length {
            const second = source[start + 1]
            if second == 46 { return -> (Kind.dot_dot, 2) }
            if second == 42 { return -> (Kind.dot_asterisk, 2) }
            if second == 63 { return -> (Kind.dot_question, 2) }
        }
        return -> (Kind.dot, 1)
    }
    if first == 40 { return -> (Kind.left_parenthesis, 1) }
    if first == 41 { return -> (Kind.right_parenthesis, 1) }
    if first == 123 { return -> (Kind.left_brace, 1) }
    if first == 125 { return -> (Kind.right_brace, 1) }
    if first == 44 { return -> (Kind.comma, 1) }
    if first == 58 { return -> (Kind.colon, 1) }
    if first == 91 { return -> (Kind.left_bracket, 1) }
    if first == 93 { return -> (Kind.right_bracket, 1) }
    if first == 64 { return -> (Kind.at, 1) }
    if first == 43 || first == 45 || first == 42 { return scanArithmetic(source, source_length, start) }
    if first == 60 { return scanLeft(source, source_length, start) }
    if first == 62 { return scanRight(source, source_length, start) }
    if first == 38 || first == 124 || first == 94 { return scanCombine(source, source_length, start) }
    if first == 61 {
        if start + 1 < source_length && source[start + 1] == 62 { return -> (Kind.arrow, 2) }
        if start + 1 < source_length && source[start + 1] == 61 { return -> (Kind.equal_equal, 2) }
        return -> (Kind.equal, 1)
    }
    if first == 33 {
        if start + 1 < source_length && source[start + 1] == 61 { return -> (Kind.bang_equal, 2) }
        return -> (Kind.bang, 1)
    }
    if first == 47 {
        if start + 1 < source_length && source[start + 1] == 61 { return -> (Kind.slash_equal, 2) }
        return -> (Kind.slash, 1)
    }
    if first == 37 {
        if start + 1 < source_length && source[start + 1] == 61 { return -> (Kind.percent_equal, 2) }
        return -> (Kind.percent, 1)
    }
    if first == 63 { return -> (Kind.question, 1) }
    if first == 126 { return -> (Kind.tilde, 1) }
    return -> (Kind.invalid, 1)
}
