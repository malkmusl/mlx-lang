const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const vector = @import("../../../std/bootstrap/vector.mlx")
const token = @import("./token.mlx")
const scanner = @import("./scanner.mlx")

pub const Allocator = allocator_module.Allocator
pub const Buffer = vector.Vector
pub const Token = token.Token

pub fn init(allocator: Allocator, initial_capacity: usize) -> Buffer {
    return vector.Vector.init(allocator, @sizeOf(Token), @alignOf(Token), initial_capacity)
}

pub fn append(buffer: Buffer, value: Token) -> Buffer {
    unsafe {
        return vector.Vector.append(buffer, @ptrCast([*]const u8, &value))
    }
}

pub inline fn get(buffer: Buffer, index: usize) -> Token {
    unsafe {
        return @ptrFromInt(*Token, @intFromPtr(buffer.items) + index * @sizeOf(Token)).*
    }
}

fn scanIntoInitialized(result: *Buffer, source: []const u8) -> void {
    var state = scanner.Scanner.init(source)
    scanStateInto(result, &state)
}

fn scanLengthIntoInitialized(result: *Buffer, source: []const u8, length: usize) -> void {
    var state = scanner.Scanner.initLength(source, length)
    scanStateInto(result, &state)
}

fn scanStateInto(result: *Buffer, state: *scanner.Scanner) -> void {
    while true {
        if result.*.length == result.*.capacity {
            const capacity = result.*.capacity * 2
            result.*.items = result.*.resizeFn(result.*.allocatorContext, result.*.items, result.*.capacity * @sizeOf(Token), capacity * @sizeOf(Token), @alignOf(Token)).?
            result.*.capacity = capacity
        }
        var destination: *Token = undefined
        unsafe { destination = @ptrFromInt(*Token, @intFromPtr(result.*.items) + result.*.length * @sizeOf(Token)) }
        scanner.Scanner.nextInto(state, destination)
        result.*.length += 1
        if destination.*.kind == token.Kind.end_of_file { return }
    }
}

pub fn scanAll(allocator: Allocator, source: []const u8) -> Buffer {
    var result = init(allocator, 128)
    scanIntoInitialized(&result, source)
    return result
}

pub fn scanAllInto(result: *Buffer, allocator: Allocator, source: []const u8) -> void {
    vector.Vector.initAt(result, allocator, @sizeOf(Token), @alignOf(Token), 128)
    scanIntoInitialized(result, source)
}

pub fn scanAllLengthInto(result: *Buffer, allocator: Allocator, source: []const u8, length: usize) -> void {
    vector.Vector.initAt(result, allocator, @sizeOf(Token), @alignOf(Token), 128)
    scanLengthIntoInitialized(result, source, length)
}

pub fn deinit(buffer: Buffer) -> void {
    vector.Vector.deinit(buffer)
}
