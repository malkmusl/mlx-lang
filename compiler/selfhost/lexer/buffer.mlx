const allocator_module = @import("../../../std/bootstrap/allocator.mlx")
const vector = @import("../../../std/bootstrap/vector.mlx")
const token = @import("./token.mlx")
const scanner = @import("./scanner.mlx")

pub const Allocator = allocator_module.Allocator
pub const Buffer = vector.Vector
pub const Token = token.Token

pub fn init(allocator: Allocator, initial_capacity: usize) -> Buffer {
    return vector.Vector.init(allocator, @sizeOf(Token), @alignOf(Token), initial_capacity)
}

pub fn append(buffer: Buffer, value: Token) -> Buffer {
    unsafe {
        return vector.Vector.append(buffer, @ptrCast([*]const u8, &value))
    }
}

pub fn get(buffer: Buffer, index: usize) -> Token {
    unsafe {
        return @ptrFromInt(*Token, @intFromPtr(buffer.items) + index * @sizeOf(Token)).*
    }
}

fn appendAt(buffer: *Buffer, value: Token) -> void {
    if buffer.*.length == buffer.*.capacity {
        const capacity = buffer.*.capacity * 2
        buffer.*.items = buffer.*.resizeFn(buffer.*.allocatorContext, buffer.*.items, buffer.*.capacity * @sizeOf(Token), capacity * @sizeOf(Token), @alignOf(Token)).?
        buffer.*.capacity = capacity
    }
    unsafe {
        const destination = @ptrFromInt(*Token, @intFromPtr(buffer.*.items) + buffer.*.length * @sizeOf(Token))
        destination.*.kind = value.kind
        destination.*.start = value.start
        destination.*.length = value.length
    }
    buffer.*.length += 1
}

pub fn scanAll(allocator: Allocator, source: []const u8) -> Buffer {
    var result = init(allocator, 128)
    var state = scanner.Scanner.init(source)
    while true {
        const current = scanner.Scanner.next(&state)
        result = append(result, current)
        if current.kind == token.Kind.end_of_file { return result }
    }
    return result
}

pub fn scanAllInto(result: *Buffer, allocator: Allocator, source: []const u8) -> void {
    vector.Vector.initAt(result, allocator, @sizeOf(Token), @alignOf(Token), 128)
    var state = scanner.Scanner.init(source)
    while true {
        const current = scanner.Scanner.next(&state)
        appendAt(result, current)
        if current.kind == token.Kind.end_of_file { return }
    }
}

pub fn deinit(buffer: Buffer) -> void {
    vector.Vector.deinit(buffer)
}
