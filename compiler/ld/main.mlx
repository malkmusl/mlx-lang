// mlx-ld: the linker of mlx-cc's programs, a program of its own. It
// joins relocatable objects (ELF .o files, compiler/selfhost/object/
// relocatable.mlx), the members of archives that define what they need
// (archive.mlx) and a compiler's unit handed over as it is in memory
// (unit.mlx) into a dynamically linked x86_64 program
// (compiler/selfhost/object/link.mlx, elf64_dynamic.mlx), with its
// symbol table and line table unless -s.
//
//     mlx-ld [-o OUTPUT] [--dynamic-linker PATH] [-s] [-Map FILE]
//            [-L DIR] [-lNAME] [-l:FILE] FILE.o... LIB.a... LIB.so...
//
// mlx-cc runs it for every link (`mlx-cc -o PROGRAM ...`), as cc runs
// ld: it compiles the .c files into a unit, resolves -l itself and
// passes the objects and archives in order and each library the program
// needs as -l:SONAME; `mlx-cc -c` never runs it. Built beside mlx-cc
// (mlx-out/bin/mlx-ld), so that a change to the linker relinks programs
// and compiles nothing, and a change to the compiler compiles objects
// without involving the linker's bytes (docs/internals/build-time-notes.md,
// "mlx-ld").
//
// -lNAME takes libNAME.a from a -L directory given before it when there
// is one, else the program needs the shared libNAME.so (libm as
// libm.so.6; libc, libpthread, libdl, librt and libatomic are libc's);
// -lmlxcpp is mlxlibcpp's libmlxcpp.a wherever mlx-cc would find it;
// -l:FILE and a path ending in .so (or holding .so.) name a library by
// its file name. libc.so.6 is always needed, first. -Wl,A,B... is A B...
// (the options as cc passes them). -s (--strip-all) leaves the symbol
// table and line table out; -Map FILE (-Map=FILE) writes the program's
// functions by place, a line each.
const std = @import("std")
const crash = @import("std.crash")
const heap = @import("std.heap")
// The toolchain's version (made when mlx-ld is built: build.mlx).
const version = @import("../../mlx-out/version.mlx")
const source = @import("../../compiler/selfhost/source.mlx")
const relocatable = @import("../../compiler/selfhost/object/relocatable.mlx")
const archive = @import("../../compiler/selfhost/object/archive.mlx")
const unit = @import("../../compiler/selfhost/object/unit.mlx")
const link = @import("../../compiler/selfhost/object/link.mlx")
const encoder = @import("../../compiler/selfhost/backend/x86_64/encoder.mlx")

const SYS_readlink: usize = 89
const MAX_NEEDED: usize = 64

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn fatal(message: []const u8, name: []const u8) -> u8 {
    say("mlx-ld: ")
    say(message)
    if name.length > 0 {
        say(" ")
        say(name)
    }
    say("\n")
    return 1
}

fn cString(text: [*]const u8) -> []const u8 {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return text[0..length]
}

fn same(left: []const u8, right: []const u8) -> bool { return std.text.same(left, right) }

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && same(text[0..prefix.length], prefix)
}

// Text kept for the run (NUL after it: a C string too).
fn keep(text: []const u8) -> []const u8 {
    const memory = heap.allocator().alloc(text.length + 1, 1)
    if memory == null { return "" }
    const bytes = memory.?
    var index: usize = 0
    while index < text.length {
        bytes[index] = text[index]
        index += 1
    }
    bytes[text.length] = 0
    return bytes[0..text.length]
}

fn join(left: []const u8, right: []const u8) -> []const u8 {
    const memory = heap.allocator().alloc(left.length + right.length + 1, 1)
    if memory == null { return "" }
    const bytes = memory.?
    var length = std.text.append(bytes, 0, left.length + right.length + 1, left)
    length = std.text.append(bytes, length, left.length + right.length + 1, right)
    bytes[length] = 0
    return bytes[0..length]
}

fn exists(path: []const u8) -> bool {
    return std.fs.access(join(path, "").pointer, std.fs.ACCESS_EXISTS)
}

fn directoryOf(path: []const u8) -> []const u8 {
    var end = path.length
    while end > 0 && path[end - 1] != 47 { end -= 1 }
    if end <= 1 { return if end == 1 { "/" } else { "." } }
    return path[0..end - 1]
}

fn joinPath(directory: []const u8, name: []const u8) -> []const u8 {
    return join(join(directory, "/"), name)
}

// The libraries the program needs (DT_NEEDED), by file name, in order.
var needed: [64][*]const u8 = undefined
var neededCount: usize = 0

fn addNeeded(soname: []const u8) -> bool {
    var index: usize = 0
    while index < neededCount {
        if same(cString(needed[index]), soname) { return true }
        index += 1
    }
    if neededCount >= MAX_NEEDED { return false }
    needed[neededCount] = keep(soname).pointer
    neededCount += 1
    return true
}

// -lNAME of a library that is not an archive: the shared library.
fn addLibrary(name: []const u8) -> bool {
    if name.length > 1 && name[0] == 58 { return addNeeded(name[1..name.length]) }
    if same(name, "atomic") || same(name, "c") || same(name, "pthread") || same(name, "dl") || same(name, "rt") { return true }
    if same(name, "m") { return addNeeded("libm.so.6") }
    return addNeeded(join(join("lib", name), ".so"))
}

// mlxlibcpp's archive where mlx-cc finds it: $MLX_CC_LIB, lib/ next to
// the program or beside its directory, /usr/local/lib/mlx-cc/lib.
fn cppLibrary(environment: [*][*]const u8) -> []const u8 {
    const name: []const u8 = "libmlxcpp.a"
    const variable = std.process.environmentFrom(environment, "MLX_CC_LIB")
    if variable != null {
        const candidate = joinPath(std.string.asSlice(variable.?), name)
        if exists(candidate) { return candidate }
    }
    var buffer: [4096]u8 = undefined
    const length = std.linux.syscall3(SYS_readlink, @intFromPtr("/proc/self/exe"), @intFromPtr(&buffer), 4095)
    if length > 0 {
        var view: [*]const u8 = undefined
        unsafe { view = @ptrCast([*]const u8, &buffer) }
        const exe = keep(view[0..@intCast(usize, length)])
        const nextTo = joinPath(joinPath(directoryOf(exe), "lib"), name)
        if exists(nextTo) { return nextTo }
        const beside = joinPath(joinPath(directoryOf(directoryOf(exe)), "lib"), name)
        if exists(beside) { return beside }
    }
    const installed: []const u8 = "/usr/local/lib/mlx-cc/lib/libmlxcpp.a"
    if exists(installed) { return installed }
    return ""
}

fn isSharedName(path: []const u8) -> bool {
    if path.length > 3 && same(path[path.length - 3..path.length], ".so") { return true }
    var index: usize = 0
    while index + 4 <= path.length {
        if same(path[index..index + 4], ".so.") { return true }
        index += 1
    }
    return false
}

fn baseName(path: []const u8) -> []const u8 {
    var start: usize = 0
    var index: usize = 0
    while index < path.length {
        if path[index] == 47 { start = index + 1 }
        index += 1
    }
    return path[start..path.length]
}

// The arguments with -Wl,A,B... spread out (A, B...).
var words: [*][]const u8 = undefined
var wordCount: usize = 0

fn spread(arguments: [][*]const u8) -> bool {
    var total: usize = 0
    var index: usize = 1
    while index < arguments.length {
        const argument = cString(arguments[index])
        total += 1
        for byte in argument {
            if byte == 44 { total += 1 }
        }
        index += 1
    }
    const memory = heap.allocator().alloc((total + 1) * @sizeOf([]const u8), 8)
    if memory == null { return false }
    unsafe { words = @ptrCast([*][]const u8, memory.?) }
    index = 1
    while index < arguments.length {
        const argument = cString(arguments[index])
        if startsWith(argument, "-Wl,") {
            var start: usize = 4
            var at: usize = 4
            while at <= argument.length {
                if at == argument.length || argument[at] == 44 {
                    if at > start {
                        words[wordCount] = argument[start..at]
                        wordCount += 1
                    }
                    start = at + 1
                }
                at += 1
            }
        } else {
            words[wordCount] = argument
            wordCount += 1
        }
        index += 1
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    // The crash report before anything else: a crash names the function it
    // was in and its callers, and is kept for MLX Observatory (std.crash).
    _ = crash.install()
    const allocator = heap.allocator()
    const environment = std.process.environmentEntries(arguments)
    if !spread(arguments) { return fatal("out of memory", "") }
    var output: []const u8 = "a.out"
    var interpreter: []const u8 = ""
    var mapPath: []const u8 = ""
    var stripped = false
    // -L directories, and the objects and archives in order.
    const directories = allocator.alloc((wordCount + 1) * @sizeOf([]const u8), 8)
    const inputs = allocator.alloc((wordCount + 1) * @sizeOf([]const u8), 8)
    if directories == null || inputs == null { return fatal("out of memory", "") }
    var directoryList: [*][]const u8 = undefined
    var inputList: [*][]const u8 = undefined
    unsafe {
        directoryList = @ptrCast([*][]const u8, directories.?)
        inputList = @ptrCast([*][]const u8, inputs.?)
    }
    var directoryCount: usize = 0
    var inputCount: usize = 0
    _ = addNeeded("libc.so.6")
    var index: usize = 0
    while index < wordCount {
        const word = words[index]
        const hasNext = index + 1 < wordCount
        if same(word, "-o") && hasNext {
            index += 1
            output = words[index]
        } else if (same(word, "--dynamic-linker") || same(word, "-dynamic-linker") || same(word, "-I")) && hasNext {
            index += 1
            interpreter = words[index]
        } else if startsWith(word, "--dynamic-linker=") {
            interpreter = word[17..word.length]
        } else if same(word, "-s") || same(word, "--strip-all") {
            stripped = true
        } else if (same(word, "-Map") || same(word, "--Map")) && hasNext {
            index += 1
            mapPath = words[index]
        } else if startsWith(word, "-Map=") {
            mapPath = word[5..word.length]
        } else if startsWith(word, "--Map=") {
            mapPath = word[6..word.length]
        } else if startsWith(word, "-L") {
            var directory = word[2..word.length]
            if directory.length == 0 && hasNext {
                index += 1
                directory = words[index]
            }
            directoryList[directoryCount] = directory
            directoryCount += 1
        } else if startsWith(word, "-l") {
            var name = word[2..word.length]
            if name.length == 0 && hasNext {
                index += 1
                name = words[index]
            }
            var found = false
            var at: usize = 0
            while at < directoryCount && !found && (name.length == 0 || name[0] != 58) {
                const candidate = joinPath(directoryList[at], join(join("lib", name), ".a"))
                if exists(candidate) {
                    inputList[inputCount] = candidate
                    inputCount += 1
                    found = true
                }
                at += 1
            }
            if !found && same(name, "mlxcpp") {
                const library = cppLibrary(environment)
                if library.length == 0 { return fatal("libmlxcpp.a is nowhere (MLX_CC_LIB, tools/build_mlxlibcpp.sh)", "") }
                inputList[inputCount] = library
                inputCount += 1
                found = true
            }
            if !found && !addLibrary(name) { return fatal("too many libraries", "") }
        } else if same(word, "--version") || same(word, "-v") {
            // NAME MAJOR.MINOR.BUILD (COMMIT), on stdout.
            const out = std.io.stdout()
            _ = std.io.writeAll(out, "mlx-ld ")
            _ = std.io.writeAll(out, version.VERSION)
            if version.COMMIT.length > 0 {
                _ = std.io.writeAll(out, " (")
                _ = std.io.writeAll(out, version.COMMIT)
                _ = std.io.writeAll(out, ")")
            }
            _ = std.io.writeAll(out, "\nthe linker of mlx-cc's programs (x86_64 Linux, ELF)\n")
            return 0
        } else if word.length > 0 && word[0] == 45 {
            // Options of other linkers that change nothing here.
            const quiet = same(word, "--as-needed") || same(word, "--no-as-needed") || same(word, "--gc-sections") || same(word, "-O1") || same(word, "--eh-frame-hdr") || startsWith(word, "-z") || startsWith(word, "--hash-style") || startsWith(word, "--build-id")
            if !quiet {
                say("mlx-ld: ignoring ")
                say(word)
                say("\n")
            }
        } else if isSharedName(word) {
            if !addNeeded(baseName(word)) { return fatal("too many libraries", "") }
        } else {
            inputList[inputCount] = word
            inputCount += 1
        }
        index += 1
    }
    if inputCount == 0 { return fatal("no input files", "") }
    var programEncoder: *encoder.Encoder = undefined
    var linker: *link.Linker = undefined
    const encoderMemory = allocator.alloc(@sizeOf(encoder.Encoder), 16)
    const linkerMemory = allocator.alloc(@sizeOf(link.Linker), 16)
    if encoderMemory == null || linkerMemory == null { return fatal("out of memory", "") }
    unsafe {
        programEncoder = @ptrCast(*encoder.Encoder, encoderMemory.?)
        linker = @ptrCast(*link.Linker, linkerMemory.?)
    }
    programEncoder.* = encoder.init(allocator)
    link.initAt(linker, allocator, programEncoder)
    link.setStripped(linker, stripped)
    index = 0
    while index < inputCount {
        const path = inputList[index]
        const kept = keep(path)
        crash.contextAt("reading", kept, 0)
        const file = source.load(allocator, kept.pointer, kept.length)
        if !file.valid { return fatal("cannot read", path) }
        if archive.isArchive(file.bytes, file.length) {
            if !link.addArchive(linker, file.bytes, file.length, kept.pointer, kept.length) { return linkFailed(linker) }
        } else {
            const memory = allocator.alloc(@sizeOf(relocatable.Object), 16)
            if memory == null { return fatal("out of memory", "") }
            var object: *relocatable.Object = undefined
            unsafe { object = @ptrCast(*relocatable.Object, memory.?) }
            relocatable.initAt(object, allocator, kept.pointer, kept.length)
            if unit.isUnit(file.bytes, file.length) {
                if !unit.read(object, file.bytes, file.length) { return fatal("a compiler's unit cut short:", path) }
            } else if !relocatable.read(object, file.bytes, file.length) {
                return fatal("not a relocatable object or an archive:", path)
            }
            link.addObject(linker, object)
        }
        index += 1
    }
    crash.contextAt("linking", output, 0)
    const out = keep(output)
    var neededList: [*]const [*]const u8 = undefined
    unsafe { neededList = @ptrCast([*]const [*]const u8, &needed) }
    const interpreterText = keep(interpreter)
    if !link.writeProgram(linker, neededList, neededCount, interpreterText.pointer, interpreterText.length, out.pointer) { return linkFailed(linker) }
    if mapPath.length > 0 && !writeLinkMap(linker, mapPath) { return fatal("cannot write the link map", mapPath) }
    return 0
}

fn linkFailed(linker: *link.Linker) -> u8 {
    say("mlx-ld: ")
    say(link.errorMessage(linker))
    say(" ")
    say(link.errorName(linker))
    say("\n")
    return 1
}

// The line-table symbols (`@at PATH:LINE`, compiler/cc/program.mlx):
// left out of the map.
const LOCATION_PREFIX: []const u8 = "@at "

fn isLocation(symbol: *relocatable.Symbol) -> bool {
    if symbol.*.nameLength <= LOCATION_PREFIX.length { return false }
    var index: usize = 0
    while index < LOCATION_PREFIX.length {
        if symbol.*.namePointer[index] != LOCATION_PREFIX[index] { return false }
        index += 1
    }
    return true
}

// `OFFSET TEXT\n` at AT (the offset in 16 hex digits); where the next
// line begins.
fn mapLine(buffer: [*]u8, start: usize, value: usize, text: [*]const u8, length: usize) -> usize {
    var at = start
    var shift: i64 = 60
    while shift >= 0 {
        const digit = @intCast(u8, (value >> @intCast(u6, shift)) & 15)
        buffer[at] = if digit < 10 { 48 + digit } else { 87 + digit }
        at += 1
        shift -= 4
    }
    buffer[at] = 32
    at += 1
    var c: usize = 0
    while c < length {
        buffer[at] = text[c]
        at += 1
        c += 1
    }
    buffer[at] = 10
    return at + 1
}

// -Map FILE: the program's functions by where they are, a line each (the
// offset in the code in hex, which _start, the entry point, begins; the
// name), each object's code after `OFFSET @object PATH`.
fn writeLinkMap(linker: *link.Linker, path: []const u8) -> bool {
    var size: usize = 0
    var index: usize = 0
    while index < link.objectCount(linker) {
        const object = link.objectAt(linker, index)
        if object.*.included {
            size += object.*.pathLength + 26
            var s: usize = 0
            while s < relocatable.symbolCount(object) {
                size += relocatable.symbolAt(object, s).*.nameLength + 18
                s += 1
            }
        }
        index += 1
    }
    const memory = heap.allocator().alloc(size + 16, 8)
    if memory == null { return false }
    const buffer = memory.?
    const objectWord: []const u8 = "@object "
    var at: usize = 0
    index = 0
    while index < link.objectCount(linker) {
        const object = link.objectAt(linker, index)
        if object.*.included {
            const text = relocatable.sectionOfKind(object, relocatable.TEXT)
            if text != relocatable.NONE {
                at = mapLine(buffer, at, relocatable.sectionAt(object, text).*.placed, objectWord.pointer, objectWord.length)
                var c: usize = 0
                while c < object.*.pathLength {
                    buffer[at - 1 + c] = object.*.pathPointer[c]
                    c += 1
                }
                buffer[at - 1 + c] = 10
                at += c
            }
            var s: usize = 0
            while s < relocatable.symbolCount(object) {
                const symbol = relocatable.symbolAt(object, s)
                s += 1
                if symbol.*.section == relocatable.NONE || symbol.*.section == relocatable.ABSOLUTE || symbol.*.nameLength == 0 || isLocation(symbol) { continue }
                const section = relocatable.sectionAt(object, symbol.*.section)
                if section.*.kind != relocatable.TEXT { continue }
                at = mapLine(buffer, at, section.*.placed + symbol.*.value, symbol.*.namePointer, symbol.*.nameLength)
            }
        }
        index += 1
    }
    return relocatable.writeFile(keep(path).pointer, buffer, at)
}
