// libpng's progressive reader over std.png: png_create_read_struct and
// its destruction, png_process_data (std.png.read takes the data; this
// calls the application's info, row, end and unknown chunk functions as
// libpng's pngpread.c does, in the same order and with the same row
// numbers and passes), png_read_update_info (pngrtran.c's
// png_init_read_transformations, png_read_transform_info and
// pngrutil.c's png_read_start_row) and the row transformations
// (png_do_read_transformations, over std.png.rows), the transformation
// setters, png_progressive_combine_row, and the settings of the reader.
const c = @import("./common.mlx")
const read = @import("std.png.read")
const rows = @import("std.png.rows")

const Png = c.Png

// ---------------------------------------------------------------------------
// Creating and destroying

// png_user_version_check: the application's libpng must match this one
// to the second '.'.
fn versionMatches(png: *Png, version: usize) -> bool {
    const ours = "1.6.43"
    var mismatch = version == 0
    if version != 0 {
        var index: usize = 0
        var dots: usize = 0
        while true {
            const theirs = c.get8(version + index)
            const mine = if index < ours.length { @intCast(usize, ours[index]) } else { 0 }
            if theirs != mine { mismatch = true }
            if theirs == 46 { dots += 1 }
            if dots >= 2 || theirs == 0 || mine == 0 { break }
            index += 1
        }
    }
    if !mismatch { return true }
    var text: [128]u8 = undefined
    var at: usize = 0
    at = appendText(&text, at, "Application built with libpng-")
    if version != 0 {
        var index: usize = 0
        while at < 127 && c.get8(version + index) != 0 {
            text[at] = @intCast(u8, c.get8(version + index))
            at += 1
            index += 1
        }
    }
    at = appendText(&text, at, " but running with ")
    at = appendText(&text, at, ours)
    text[at] = 0
    c.pngWarning(png, @intFromPtr(&text))
    return false
}

fn appendText(text: *[128]u8, at: usize, piece: []const u8) -> usize {
    var position = at
    var index: usize = 0
    while index < piece.length && position < 127 {
        text.*[position] = piece[index]
        position += 1
        index += 1
    }
    return position
}

// png_create_png_struct: the structure, its memory and error functions,
// libpng's limits; null when the version does not match or there is no
// memory.
pub fn createStruct(version: usize, errorPtr: usize, errorFn: usize, warnFn: usize, memPtr: usize, mallocFn: usize, freeFn: usize, magic: usize) -> usize {
    var address: usize = 0
    if mallocFn != 0 {
        // (The application's malloc is called with a png_ptr: a stand-in
        // that has its memory functions.)
        var stand: Png = undefined
        stand.memPtr = memPtr
        stand.mallocFn = mallocFn
        stand.freeFn = freeFn
        address = c.rawAlloc(&stand, @sizeOf(Png))
    } else {
        address = c.systemAlloc(@sizeOf(Png))
    }
    if address == 0 { return 0 }
    c.zero(address, @sizeOf(Png))
    const png = c.pngOf(address)
    png.*.magic = magic
    png.*.memPtr = memPtr
    png.*.mallocFn = mallocFn
    png.*.freeFn = freeFn
    png.*.errorPtr = errorPtr
    png.*.errorFn = errorFn
    png.*.warningFn = warnFn
    png.*.userWidthMax = 1000000
    png.*.userHeightMax = 1000000
    png.*.chunkCacheMax = 1000
    read.init(&png.*.reader, &png.*.file, c.allocatorOf(png))
    if magic == c.READ_MAGIC { png.*.flags = c.F_BENIGN_ERRORS_WARN | c.F_APP_WARNINGS_WARN } else { png.*.flags = c.F_APP_WARNINGS_WARN }
    if !versionMatches(png, version) {
        read.deinit(&png.*.reader)
        c.rawFree(png, address)
        return 0
    }
    return address
}

pub fn createInfo(pngAddress: usize) -> usize {
    if !c.isAny(pngAddress) { return 0 }
    const png = c.pngOf(pngAddress)
    const address = c.rawAlloc(png, @sizeOf(c.PngInfo))
    if address == 0 { return 0 }
    c.zero(address, @sizeOf(c.PngInfo))
    const info = c.infoOf(address)
    info.*.magic = c.INFO_MAGIC
    info.*.owner = pngAddress
    info.*.data.allocator = c.allocatorOf(png)
    return address
}

// An info's own memory (a writer's texts, unknown chunks, profile).
pub fn freeInfoData(png: *Png, info: *c.PngInfo) -> void {
    var index: usize = 0
    while index < info.*.textCount {
        const entry = info.*.texts + index * 2 * 8
        c.rawFree(png, c.getWord(entry))
        index += 1
    }
    c.rawFree(png, info.*.texts)
    info.*.texts = 0
    info.*.textCount = 0
    index = 0
    while index < info.*.unknownCount {
        c.rawFree(png, c.getWord(info.*.unknowns + index * 32 + 8))
        index += 1
    }
    c.rawFree(png, info.*.unknowns)
    info.*.unknowns = 0
    info.*.unknownCount = 0
    read.freeProfile(&info.*.data)
}

pub fn destroyInfo(pngAddress: usize, infoPointer: usize) -> void {
    if !c.isAny(pngAddress) || infoPointer == 0 { return }
    const address = c.getWord(infoPointer)
    if address == 0 { return }
    const png = c.pngOf(pngAddress)
    freeInfoData(png, c.infoOf(address))
    c.infoOf(address).*.magic = 0
    c.rawFree(png, address)
    c.putWord(infoPointer, 0)
}

// png_read_destroy: everything the reader holds.
pub fn freeReader(png: *Png) -> void {
    read.deinit(&png.*.reader)
    freeGammaTables(png)
    c.rawFree(png, png.*.bigRowBuf)
    c.rawFree(png, png.*.bigPrevRow)
    png.*.bigRowBuf = 0
    png.*.bigPrevRow = 0
    if png.*.jmpBufSize != 0 { c.rawFree(png, png.*.jmpBufPtr) }
    png.*.jmpBufPtr = 0
}

pub fn destroyRead(pngPointer: usize, infoPointer: usize, endInfoPointer: usize) -> void {
    if pngPointer == 0 { return }
    const address = c.getWord(pngPointer)
    if !c.isPng(address) { return }
    destroyInfo(address, endInfoPointer)
    destroyInfo(address, infoPointer)
    c.putWord(pngPointer, 0)
    const png = c.pngOf(address)
    freeReader(png)
    png.*.magic = 0
    c.rawFree(png, address)
}

// png_set_longjmp_fn: where png_jmpbuf's jmp_buf is (a buffer of the
// structure's, or one of SIZE bytes allocated once).
pub fn setLongjmp(png: *Png, function: usize, size: usize) -> usize {
    if png.*.jmpBufPtr == 0 {
        png.*.jmpBufSize = 0
        if size <= @sizeOf([64]u64) {
            png.*.jmpBufPtr = @intFromPtr(&png.*.jmpBufLocal)
        } else {
            const address = c.rawAlloc(png, size)
            if address == 0 { return 0 }
            png.*.jmpBufPtr = address
            png.*.jmpBufSize = size
        }
    } else {
        var have = png.*.jmpBufSize
        if have == 0 { have = @sizeOf([64]u64) }
        if have != size && !(png.*.jmpBufSize == 0 && size <= @sizeOf([64]u64)) {
            c.pngWarning(png, c.literal("Application jmp_buf size changed"))
            return 0
        }
    }
    png.*.longjmpFn = function
    return png.*.jmpBufPtr
}

// ---------------------------------------------------------------------------
// Settings

// png_rtran_ok: transformations are set before the rows start (and,
// for some, after the header).
fn rtranOk(png: *Png, needHeader: bool) -> bool {
    if png.*.flags & c.F_ROW_INIT != 0 {
        c.appError(png, c.literal("invalid after png_start_read_image or png_read_update_info"))
        return false
    }
    if needHeader && png.*.reader.mode & read.HAVE_IHDR == 0 {
        c.appError(png, c.literal("invalid before the PNG header has been read"))
        return false
    }
    return true
}

pub fn setTransformation(png: *Png, bits: usize, checked: bool) -> void {
    if checked && !rtranOk(png, false) { return }
    png.*.transformations |= bits
}

pub fn setCrcAction(png: *Png, critical: i32, ancillary: i32) -> void {
    var flags = png.*.reader.crcFlags
    if critical == 3 {
        flags = (flags & ~read.CRC_CRITICAL_MASK) | read.CRC_CRITICAL_USE
    } else if critical == 4 {
        flags = (flags & ~read.CRC_CRITICAL_MASK) | read.CRC_CRITICAL_USE | read.CRC_CRITICAL_IGNORE
    } else if critical != 5 {
        if critical == 2 { c.pngWarning(png, c.literal("Can't discard critical data on CRC error")) }
        flags = flags & ~read.CRC_CRITICAL_MASK
    }
    if ancillary == 3 {
        flags = (flags & ~read.CRC_ANCILLARY_MASK) | read.CRC_ANCILLARY_USE
    } else if ancillary == 4 {
        flags = (flags & ~read.CRC_ANCILLARY_MASK) | read.CRC_ANCILLARY_USE | read.CRC_ANCILLARY_NOWARN
    } else if ancillary == 1 {
        flags = (flags & ~read.CRC_ANCILLARY_MASK) | read.CRC_ANCILLARY_NOWARN
    } else if ancillary != 5 {
        flags = flags & ~read.CRC_ANCILLARY_MASK
    }
    png.*.reader.crcFlags = flags
}

// png_set_option: each option two bits of `options`; the old setting.
pub fn setOption(png: *Png, option: i32, onoff: i32) -> i32 {
    if option < 0 || option >= 12 || option & 1 != 0 { return 1 }
    const shift = @intCast(usize, option)
    const mask = @intCast(usize, 3) << shift
    const setting = @intCast(usize, 2 + (if onoff != 0 { 1 } else { 0 })) << shift
    const current = (png.*.options & mask) >> shift
    png.*.options = (png.*.options & ~mask) | setting
    png.*.reader.maximumWindow = (png.*.options >> 2) & 3 == 3
    return @intCast(i32, current)
}

// png_set_keep_unknown_chunks.
pub fn setKeepUnknown(png: *Png, keep: i32, list: usize, count: i32) -> void {
    if keep < 0 || keep >= 4 {
        c.appError(png, c.literal("png_set_keep_unknown_chunks: invalid keep"))
        return
    }
    const value = @intCast(u32, keep)
    if count <= 0 {
        png.*.reader.unknownDefault = value
        if count == 0 { return }
    }
    if list == 0 || count <= 0 {
        // Every known chunk but the critical ones libpng needs.
        const names = [18]usize{ read.bKGD, read.cHRM, read.eXIf, read.gAMA, read.hIST, read.iCCP, read.iTXt, read.oFFs, read.pCAL, read.pHYs, read.sBIT, read.sCAL, read.sPLT, read.sRGB, read.tEXt, read.tIME, read.tRNS, read.zTXt }
        for name in names { read.setKeep(&png.*.reader, name, value) }
        return
    }
    var index: usize = 0
    while index < @intCast(usize, count) {
        const at = list + index * 5
        const name = read.read32(at)
        if name == read.IHDR || name == read.IEND || name == read.IDAT || name == read.PLTE {
            // (libpng refuses to treat these as unknown.)
        } else {
            read.setKeep(&png.*.reader, name, value)
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Gamma (pngrtran.c, png.c)

pub fn freeGammaTables(png: *Png) -> void {
    c.rawFree(png, png.*.gammaTable)
    c.rawFree(png, png.*.gamma16Table)
    png.*.gammaTable = 0
    png.*.gamma16Table = 0
}

// png_build_gamma_table.
fn buildGammaTables(png: *Png, bitDepth: usize) -> void {
    if png.*.gammaTable != 0 || png.*.gamma16Table != 0 {
        c.pngWarning(png, c.literal("gamma table being rebuilt"))
        freeGammaTables(png)
    }
    if bitDepth <= 8 {
        png.*.gammaTable = c.allocate(png, 256)
        const g = if png.*.screenGamma > 0 { rows.reciprocal2(png.*.gamma, png.*.screenGamma) } else { read.FP_1 }
        rows.build8(png.*.gammaTable, g)
        return
    }
    const file = &png.*.file
    var sigBit: usize = 0
    if file.*.valid & read.INFO_sBIT != 0 {
        if png.*.file.colorType & 2 != 0 {
            sigBit = @intCast(usize, file.*.sigBit[0])
            if @intCast(usize, file.*.sigBit[1]) > sigBit { sigBit = @intCast(usize, file.*.sigBit[1]) }
            if @intCast(usize, file.*.sigBit[2]) > sigBit { sigBit = @intCast(usize, file.*.sigBit[2]) }
        } else {
            sigBit = @intCast(usize, file.*.sigBit[3])
        }
    }
    var shift: usize = 0
    if sigBit > 0 && sigBit < 16 { shift = 16 - sigBit }
    const cut = png.*.transformations & (c.T_16_TO_8 | c.T_SCALE_16_TO_8) != 0
    if cut && shift < 5 { shift = 5 }
    if shift > 8 { shift = 8 }
    png.*.gammaShift = shift
    png.*.gamma16Bytes = (@intCast(usize, 256) >> shift) * 512
    png.*.gamma16Table = c.allocate(png, png.*.gamma16Bytes)
    if cut {
        const g = if png.*.screenGamma > 0 { rows.product2(png.*.gamma, png.*.screenGamma) } else { read.FP_1 }
        rows.build16to8(png.*.gamma16Table, shift, g)
    } else {
        const g = if png.*.screenGamma > 0 { rows.reciprocal2(png.*.gamma, png.*.screenGamma) } else { read.FP_1 }
        rows.build16(png.*.gamma16Table, shift, g)
    }
}

// png_set_gamma_fixed.
pub fn setGamma(png: *Png, screen: i64, fileGamma: i64) -> void {
    if !rtranOk(png, false) { return }
    var s = screen
    var f = fileGamma
    // translate_gamma_flags: the sRGB and Mac flags.
    if s == -1 || s == -100000 { s = 220000 } else if s == -2 || s == -200000 { s = 151724 }
    if f == -1 || f == -100000 { f = read.GAMMA_sRGB_INVERSE } else if f == -2 || f == -200000 { f = 65909 }
    if f <= 0 { c.pngError(png, c.literal("invalid file gamma in png_set_gamma")) }
    if s <= 0 { c.pngError(png, c.literal("invalid screen gamma in png_set_gamma")) }
    png.*.gamma = f
    png.*.screenGamma = s
}

// convert_gamma_value: a double as fixed point (below 128 taken as a
// value, else as already scaled).
pub fn gammaFromDouble(png: *Png, value: f64) -> i64 {
    var scaled = value
    if scaled > 0.0 && scaled < 128.0 { scaled = scaled * 100000.0 }
    scaled = @floor(scaled + 0.5)
    if scaled > 2147483647.0 || scaled < -2147483647.0 { c.pngError(png, c.literal("gamma value: fixed point overflow")) }
    return @intFromFloat(i64, scaled)
}

// ---------------------------------------------------------------------------
// Starting the rows (png_read_start_row with png_init_read_transformations)

fn initTransformations(png: *Png) -> void {
    const file = &png.*.file
    // The gamma of the file (png_set_gamma's, else the file's own).
    if png.*.gamma == 0 && file.*.colorspace & read.CS_HAVE_GAMMA != 0 { png.*.gamma = file.*.gamma }
    var correction = false
    if png.*.gamma != 0 {
        if png.*.screenGamma != 0 {
            var ratio: i64 = 0
            correction = !read.mulDiv(png.*.screenGamma, png.*.gamma, read.FP_1, &ratio) || read.gammaSignificant(ratio)
        } else {
            png.*.screenGamma = rows.reciprocal(png.*.gamma)
        }
    } else if png.*.screenGamma != 0 {
        png.*.gamma = rows.reciprocal(png.*.screenGamma)
    } else {
        png.*.screenGamma = read.FP_1
        png.*.gamma = read.FP_1
    }
    if correction { png.*.transformations |= c.T_GAMMA } else { png.*.transformations &= ~c.T_GAMMA }
    png.*.numTrans = file.*.numTrans
    if png.*.transformations & c.T_STRIP_ALPHA != 0 {
        png.*.transformations &= ~c.T_EXPAND_tRNS
        png.*.numTrans = 0
    }
    if png.*.transformations & c.T_GAMMA != 0 {
        buildGammaTables(png, file.*.bitDepth)
        if file.*.colorType == 3 {
            // The palette is corrected once, here.
            var index: usize = 0
            while index < file.*.numPalette * 3 {
                file.*.palette[index] = @intCast(u8, c.get8(png.*.gammaTable + @intCast(usize, file.*.palette[index])))
                index += 1
            }
            png.*.transformations &= ~c.T_GAMMA
        }
    }
}

// png_read_start_row.
pub fn startRow(png: *Png) -> void {
    const file = &png.*.file
    initTransformations(png)
    png.*.pass = 0
    if file.*.interlace != 0 {
        if png.*.transformations & c.T_INTERLACE == 0 {
            png.*.numRows = (file.*.height + 7) / 8
        } else {
            png.*.numRows = file.*.height
        }
        png.*.iwidth = rows.passWidth(0, file.*.width)
    } else {
        png.*.numRows = file.*.height
        png.*.iwidth = file.*.width
    }
    var depth = file.*.pixelDepth
    const t = png.*.transformations
    if t & c.T_PACK != 0 && file.*.bitDepth < 8 { depth = 8 }
    if t & c.T_EXPAND != 0 {
        if file.*.colorType == 3 {
            depth = if png.*.numTrans != 0 { 32 } else { 24 }
        } else if file.*.colorType == 0 {
            if depth < 8 { depth = 8 }
            if png.*.numTrans != 0 { depth = depth * 2 }
        } else if file.*.colorType == 2 {
            if png.*.numTrans != 0 { depth = depth * 4 / 3 }
        }
    }
    if t & c.T_EXPAND_16 != 0 {
        if t & c.T_EXPAND != 0 {
            if file.*.bitDepth < 16 { depth = depth * 2 }
        } else {
            png.*.transformations &= ~c.T_EXPAND_16
        }
    }
    if t & c.T_FILLER != 0 {
        if file.*.colorType == 0 {
            depth = if depth <= 8 { 16 } else { 32 }
        } else if file.*.colorType == 2 || file.*.colorType == 3 {
            depth = if depth <= 32 { 32 } else { 64 }
        }
    }
    if t & c.T_GRAY_TO_RGB != 0 {
        if (png.*.numTrans != 0 && t & c.T_EXPAND != 0) || t & c.T_FILLER != 0 || file.*.colorType == 4 {
            depth = if depth <= 16 { 32 } else { 64 }
        } else {
            if depth <= 8 {
                depth = if file.*.colorType == 6 { 32 } else { 24 }
            } else {
                depth = if file.*.colorType == 6 { 64 } else { 48 }
            }
        }
    }
    png.*.maximumPixelDepth = depth
    png.*.transformedPixelDepth = 0
    var size = rows.rowBytes(depth, (file.*.width + 7) & ~@intCast(usize, 7)) + 1 + ((depth + 7) >> 3)
    // (Room for std.png.rows' widest form of a row, whatever the
    // transformations: 8 bytes a pixel.)
    const widest = ((file.*.width + 7) & ~@intCast(usize, 7)) * 8 + 16
    if size < widest { size = widest }
    if size + 48 > png.*.bigRowBufSize {
        c.rawFree(png, png.*.bigRowBuf)
        c.rawFree(png, png.*.bigPrevRow)
        png.*.bigRowBuf = 0
        png.*.bigPrevRow = 0
        png.*.bigRowBuf = c.allocate(png, size + 48)
        png.*.bigPrevRow = c.allocate(png, size + 48)
        c.zero(png.*.bigRowBuf, size + 48)
        png.*.rowBuf = png.*.bigRowBuf + 31
        png.*.prevRow = png.*.bigPrevRow + 31
        png.*.bigRowBufSize = size + 48
    }
    c.zero(png.*.prevRow, file.*.rowBytes + 1)
    png.*.flags |= c.F_ROW_INIT
    png.*.reader.rowBuffer = png.*.rowBuf
    png.*.reader.rowSize = rows.rowBytes(file.*.pixelDepth, png.*.iwidth) + 1
}

// png_read_transform_info: the header as the rows will be.
pub fn transformInfo(png: *Png, info: *c.PngInfo) -> void {
    const file = &png.*.file
    const t = png.*.transformations
    var colorType = file.*.colorType
    var bitDepth = file.*.bitDepth
    var numTrans = file.*.numTrans
    if t & c.T_EXPAND != 0 {
        if colorType == 3 {
            colorType = if png.*.numTrans > 0 { 6 } else { 2 }
            bitDepth = 8
            numTrans = 0
        } else {
            if png.*.numTrans != 0 && t & c.T_EXPAND_tRNS != 0 { colorType |= 4 }
            if bitDepth < 8 { bitDepth = 8 }
            numTrans = 0
        }
    }
    if bitDepth == 16 && t & (c.T_SCALE_16_TO_8 | c.T_16_TO_8) != 0 { bitDepth = 8 }
    if t & c.T_GRAY_TO_RGB != 0 { colorType |= 2 }
    if t & c.T_EXPAND_16 != 0 && bitDepth == 8 && colorType != 3 { bitDepth = 16 }
    if t & c.T_PACK != 0 && bitDepth < 8 { bitDepth = 8 }
    var channels: usize = 1
    if colorType != 3 && colorType & 2 != 0 { channels = 3 }
    if t & c.T_STRIP_ALPHA != 0 {
        colorType &= ~@intCast(usize, 4)
        numTrans = 0
    }
    if colorType & 4 != 0 { channels += 1 }
    if t & c.T_FILLER != 0 && (colorType == 2 || colorType == 0) {
        channels += 1
        if t & c.T_ADD_ALPHA != 0 { colorType |= 4 }
    }
    info.*.updated = true
    info.*.colorType = colorType
    info.*.bitDepth = bitDepth
    info.*.channels = channels
    info.*.pixelDepth = channels * bitDepth
    info.*.rowBytes = rows.rowBytes(info.*.pixelDepth, file.*.width)
    info.*.numTrans = numTrans
    png.*.infoRowbytes = info.*.rowBytes
}

// png_do_read_transformations over the row at png.rowBuf + 1.
fn transformRow(png: *Png, row: *rows.RowInfo) -> void {
    const file = &png.*.file
    const t = png.*.transformations
    const line = png.*.rowBuf + 1
    if t & c.T_EXPAND != 0 {
        if row.*.colorType == 3 {
            rows.expandPalette(row, line, @intFromPtr(&file.*.palette), @intFromPtr(&file.*.transAlpha), png.*.numTrans)
        } else {
            const withTrans = png.*.numTrans != 0 && t & c.T_EXPAND_tRNS != 0
            rows.expand(row, line, withTrans, file.*.transGray, file.*.transRed, file.*.transGreen, file.*.transBlue)
        }
    }
    if t & c.T_STRIP_ALPHA != 0 && (row.*.colorType == 6 || row.*.colorType == 4) { rows.stripChannel(row, line, false) }
    if t & c.T_GRAY_TO_RGB != 0 { rows.grayToRgb(row, line) }
    if t & c.T_GAMMA != 0 && file.*.colorType != 3 { rows.gamma(row, line, png.*.gammaTable, png.*.gamma16Table, png.*.gammaShift) }
    if t & c.T_SCALE_16_TO_8 != 0 { rows.scale16(row, line) }
    if t & c.T_16_TO_8 != 0 { rows.chop16(row, line) }
    if t & c.T_EXPAND_16 != 0 { rows.expand16(row, line) }
    if t & c.T_INVERT_MONO != 0 { rows.invertMono(row, line) }
    if t & c.T_INVERT_ALPHA != 0 { rows.invertAlpha(row, line) }
    if t & c.T_PACK != 0 { rows.unpack(row, line) }
    if t & c.T_BGR != 0 { rows.bgr(row, line) }
    if t & c.T_PACKSWAP != 0 { rows.packswap(row, line) }
    if t & c.T_FILLER != 0 { rows.filler(row, line, png.*.filler, png.*.flags & c.F_FILLER_AFTER != 0) }
    if t & c.T_SWAP_ALPHA != 0 { rows.swapAlpha(row, line) }
    if t & c.T_SWAP_BYTES != 0 { rows.swapBytes(row, line) }
}

// ---------------------------------------------------------------------------
// The rows (png_push_process_row, png_read_push_finish_row)

fn haveRow(png: *Png, row: usize) -> void {
    if png.*.rowFn == 0 { return }
    const call: c.RowFn = unsafe { @ptrFromInt(c.RowFn, png.*.rowFn) }
    call(@intFromPtr(png), row, @intCast(u32, png.*.rowNumber & 0xffffffff), @intCast(i32, png.*.pass))
}

fn finishRow(png: *Png) -> void {
    const file = &png.*.file
    png.*.rowNumber += 1
    if png.*.rowNumber < png.*.numRows { return }
    if file.*.interlace == 0 { return }
    png.*.rowNumber = 0
    c.zero(png.*.prevRow, file.*.rowBytes + 1)
    while true {
        png.*.pass += 1
        if (png.*.pass == 1 && file.*.width < 5) || (png.*.pass == 3 && file.*.width < 3) || (png.*.pass == 5 && file.*.width < 2) { png.*.pass += 1 }
        if png.*.pass > 7 { png.*.pass -= 1 }
        if png.*.pass >= 7 { break }
        png.*.iwidth = rows.passWidth(png.*.pass, file.*.width)
        if png.*.transformations & c.T_INTERLACE != 0 { break }
        png.*.numRows = rows.passHeight(png.*.pass, file.*.height)
        if png.*.iwidth != 0 && png.*.numRows != 0 { break }
    }
}

// The row callbacks of a pass's row, and of the rows of the image it
// stands for (libpng's 'blocky' display), as png_push_process_row makes
// them.
fn deliverInterlaced(png: *Png, line: usize) -> void {
    const height = png.*.file.height
    const pass = png.*.pass
    if pass == 0 {
        var i: usize = 0
        while i < 8 && png.*.pass == 0 {
            haveRow(png, line)
            finishRow(png)
            i += 1
        }
        if png.*.pass == 2 { blank(png, 4, 2) }
        if png.*.pass == 4 && height <= 4 { blank(png, 2, 4) }
        if png.*.pass == 6 && height <= 4 {
            haveRow(png, 0)
            finishRow(png)
        }
    } else if pass == 1 {
        var i: usize = 0
        while i < 8 && png.*.pass == 1 {
            haveRow(png, line)
            finishRow(png)
            i += 1
        }
        if png.*.pass == 2 { blank(png, 4, 2) }
    } else if pass == 2 {
        var i: usize = 0
        while i < 4 && png.*.pass == 2 {
            haveRow(png, line)
            finishRow(png)
            i += 1
        }
        blank(png, 4, 2)
        if png.*.pass == 4 { blank(png, 2, 4) }
    } else if pass == 3 {
        var i: usize = 0
        while i < 4 && png.*.pass == 3 {
            haveRow(png, line)
            finishRow(png)
            i += 1
        }
        if png.*.pass == 4 { blank(png, 2, 4) }
    } else if pass == 4 {
        var i: usize = 0
        while i < 2 && png.*.pass == 4 {
            haveRow(png, line)
            finishRow(png)
            i += 1
        }
        blank(png, 2, 4)
        if png.*.pass == 6 { blank(png, 1, 6) }
    } else if pass == 5 {
        var i: usize = 0
        while i < 2 && png.*.pass == 5 {
            haveRow(png, line)
            finishRow(png)
            i += 1
        }
        if png.*.pass == 6 { blank(png, 1, 6) }
    } else {
        haveRow(png, line)
        finishRow(png)
        if png.*.pass == 6 {
            haveRow(png, 0)
            finishRow(png)
        }
    }
}

// Up to COUNT rows without data while the pass is still PASS.
fn blank(png: *Png, count: usize, pass: usize) -> void {
    var i: usize = 0
    while i < count && png.*.pass == pass {
        haveRow(png, 0)
        finishRow(png)
        i += 1
    }
}

pub fn processRow(png: *Png) -> void {
    const file = &png.*.file
    var row: rows.RowInfo = undefined
    row.width = png.*.iwidth
    row.colorType = file.*.colorType
    row.bitDepth = file.*.bitDepth
    row.channels = file.*.channels
    row.pixelDepth = file.*.pixelDepth
    row.rowBytes = rows.rowBytes(row.pixelDepth, row.width)
    const filter = c.get8(png.*.rowBuf)
    if filter > 0 {
        if filter < 5 {
            var pixel = (row.pixelDepth + 7) >> 3
            if pixel == 0 { pixel = 1 }
            rows.unfilter(filter, png.*.rowBuf + 1, png.*.prevRow + 1, row.rowBytes, pixel)
        } else {
            c.pngError(png, c.literal("bad adaptive filter value"))
        }
    }
    c.copy(png.*.prevRow, png.*.rowBuf, row.rowBytes + 1)
    if png.*.transformations != 0 { transformRow(png, &row) }
    if png.*.transformedPixelDepth == 0 {
        png.*.transformedPixelDepth = row.pixelDepth
        if row.pixelDepth > png.*.maximumPixelDepth { c.pngError(png, c.literal("progressive row overflow")) }
    } else if png.*.transformedPixelDepth != row.pixelDepth {
        c.pngError(png, c.literal("internal progressive row size calculation error"))
    }
    const line = png.*.rowBuf + 1
    if file.*.interlace != 0 && png.*.transformations & c.T_INTERLACE != 0 {
        if png.*.pass < 6 { rows.expandInterlaced(&row, line, png.*.pass, png.*.transformations & c.T_PACKSWAP != 0) }
        deliverInterlaced(png, line)
    } else {
        haveRow(png, line)
        finishRow(png)
    }
}

// png_progressive_combine_row.
pub fn combineRow(png: *Png, oldRow: usize, newRow: usize) -> void {
    if newRow == 0 || oldRow == 0 { return }
    const file = &png.*.file
    const depth = png.*.transformedPixelDepth
    if depth == 0 { c.pngError(png, c.literal("internal row logic error")) }
    if png.*.infoRowbytes != 0 && png.*.infoRowbytes != rows.rowBytes(depth, file.*.width) { c.pngError(png, c.literal("internal row size calculation error")) }
    const interlacing = file.*.interlace != 0 && png.*.transformations & c.T_INTERLACE != 0
    rows.combineRow(oldRow, png.*.rowBuf + 1, file.*.width, depth, png.*.pass, interlacing, 1, png.*.transformations & c.T_PACKSWAP != 0)
}

// ---------------------------------------------------------------------------
// Unknown chunks (png_handle_unknown)

fn handleUnknown(png: *Png) -> void {
    const r = &png.*.reader
    var keep = r.*.chunkKeep
    var handled = false
    const ancillary = (r.*.chunkName >> 29) & 1 != 0
    if keep == read.HANDLE_CHUNK_NEVER && r.*.chunkLength > r.*.chunkMallocMax && r.*.chunkMallocMax > 0 {
        // (Too large to be held: dropped.)
    } else if png.*.userChunkFn != 0 {
        // The chunk as C sees a png_unknown_chunk.
        const nameAt = @intFromPtr(&png.*.unknownName)
        c.put8(nameAt, (r.*.chunkName >> 24) & 255)
        c.put8(nameAt + 1, (r.*.chunkName >> 16) & 255)
        c.put8(nameAt + 2, (r.*.chunkName >> 8) & 255)
        c.put8(nameAt + 3, r.*.chunkName & 255)
        c.put8(nameAt + 4, 0)
        png.*.unknownData = if r.*.chunkLength == 0 { 0 } else { r.*.chunkData }
        png.*.unknownSize = r.*.chunkLength
        png.*.unknownLocation = r.*.mode & 255
        const call: c.UserChunkFn = unsafe { @ptrFromInt(c.UserChunkFn, png.*.userChunkFn) }
        const result = @intCast(i64, call(@intFromPtr(png), nameAt))
        if result < 0 {
            c.chunkError(png, c.literal("error in user chunk"))
        } else if result == 0 {
            if keep < read.HANDLE_CHUNK_IF_SAFE {
                if r.*.unknownDefault < read.HANDLE_CHUNK_IF_SAFE {
                    c.chunkWarning(png, c.literal("Saving unknown chunk:"))
                    c.appWarning(png, c.literal("forcing save of an unhandled chunk; please call png_set_keep_unknown_chunks"))
                }
                keep = read.HANDLE_CHUNK_IF_SAFE
            }
        } else {
            handled = true
            keep = read.HANDLE_CHUNK_NEVER
        }
    } else if keep == read.HANDLE_CHUNK_AS_DEFAULT {
        keep = r.*.unknownDefault
    }
    // (Kept chunks are counted as stored: nothing here reads them back.)
    if keep == read.HANDLE_CHUNK_ALWAYS || (keep == read.HANDLE_CHUNK_IF_SAFE && ancillary) { handled = true }
    if !handled && !ancillary { c.chunkError(png, c.literal("unhandled critical chunk")) }
}

// ---------------------------------------------------------------------------
// png_process_data

pub fn processData(png: *Png, infoAddress: usize, buffer: usize, length: usize) -> void {
    png.*.currentInfo = infoAddress
    png.*.paused = false
    read.give(&png.*.reader, buffer, length)
    while !png.*.paused {
        const event = read.next(&png.*.reader)
        if event == read.Event.more { break }
        if event == read.Event.warning {
            c.pngWarning(png, read.messageText(&png.*.reader))
        } else if event == read.Event.failed {
            c.pngError(png, read.messageText(&png.*.reader))
        } else if event == read.Event.info {
            if png.*.infoFn != 0 {
                const call: c.InfoFn = unsafe { @ptrFromInt(c.InfoFn, png.*.infoFn) }
                call(@intFromPtr(png), infoAddress)
            }
            // (libpng needs png_read_update_info or png_start_read_image in
            // the info function; without it the rows start as they are.)
            if png.*.flags & c.F_ROW_INIT == 0 { startRow(png) }
            png.*.reader.rowSize = rows.rowBytes(png.*.file.pixelDepth, png.*.iwidth) + 1
        } else if event == read.Event.row {
            processRow(png)
            png.*.reader.rowSize = rows.rowBytes(png.*.file.pixelDepth, png.*.iwidth) + 1
            png.*.reader.imageComplete = png.*.rowNumber >= png.*.numRows || png.*.pass > 6
        } else if event == read.Event.unknown {
            handleUnknown(png)
        } else if event == read.Event.end {
            if png.*.endFn != 0 {
                const call: c.InfoFn = unsafe { @ptrFromInt(c.InfoFn, png.*.endFn) }
                call(@intFromPtr(png), infoAddress)
            }
        }
    }
}

// png_process_data_pause: the bytes of the last png_process_data not
// taken (save 0); with save the reader keeps them itself.
pub fn pause(png: *Png, save: i32) -> usize {
    png.*.paused = true
    if save != 0 {
        // libpng's saved bytes: the reader copies what is left.
        return 0
    }
    return read.remaining(&png.*.reader)
}
