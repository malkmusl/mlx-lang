pub extern("c") fn png_process_data_pause(png_ptr: png_structrp, save: c_int) -> png_size_t
pub extern("c") fn png_process_data_skip(png_ptr: png_structrp) -> png_uint_32
pub extern("c") fn png_progressive_combine_row(png_ptr: png_const_structrp, old_row: png_bytep, new_row: png_const_bytep) -> void
pub extern("c") fn png_read_update_info(png_ptr: png_structrp, info_ptr: png_inforp) -> void
pub extern("c") fn png_start_read_image(png_ptr: png_structrp) -> void
pub extern("c") fn png_get_io_ptr(png_ptr: png_const_structrp) -> png_voidp

// Unknown chunks: the user function sees each (1: handled, 0: not, below
// 0: an error); png_set_keep_unknown_chunks says which to keep.
