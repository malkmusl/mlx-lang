// png.h
// mlx-libpng: libpng's C API (1.6.43), implemented in Mlx by
// libmlxpng16.so (compiler/libc/png, over std.png): the progressive
// reader WebKit's and Skia's PNG decoders drive (png_process_data and its
// callbacks) with libpng's transformations and gamma correction, unknown
// chunks (APNG's acTL, fcTL and fdAT among them), the info getters and
// setters, setjmp-based errors (png_jmpbuf), and the writer Skia's PNG
// encoder uses.
const c_function_pointers = true
const c_macros = "#define png_jmpbuf(png_ptr) (*png_set_longjmp_fn((png_ptr), longjmp, (sizeof (jmp_buf))))\n#define png_composite(composite, fg, alpha, bg) { png_uint_16 temp = (png_uint_16)((png_uint_16)(fg) * (png_uint_16)(alpha) + (png_uint_16)(bg)*(png_uint_16)(255 - (png_uint_16)(alpha)) + 128); (composite) = (png_byte)(((temp + (temp >> 8)) >> 8) & 0xff); }\n#define png_check_sig(sig, n) !png_sig_cmp((sig), 0, (n))\n#define png_libpng_ver png_get_header_ver(NULL)"
const conf = @import("./pngconf.mlx")
const libconf = @import("./pnglibconf.mlx")

const c_char = conf.c_char
const c_int = conf.c_int
const c_uint = conf.c_uint
const c_long = conf.c_long
const c_double = conf.c_double
const c_tokens = conf.c_tokens
const png_byte = conf.png_byte
const png_uint_16 = conf.png_uint_16
const png_int_32 = conf.png_int_32
const png_uint_32 = conf.png_uint_32
const png_size_t = conf.png_size_t
const png_alloc_size_t = conf.png_alloc_size_t
const png_fixed_point = conf.png_fixed_point
const png_voidp = conf.png_voidp
const png_const_voidp = conf.png_const_voidp
const png_bytep = conf.png_bytep
const png_const_bytep = conf.png_const_bytep
const png_charp = conf.png_charp
const png_const_charp = conf.png_const_charp
const png_bytepp = conf.png_bytepp
const png_charpp = conf.png_charpp
const png_uint_32p = conf.png_uint_32p
const png_fixed_point_p = conf.png_fixed_point_p
const png_doublep = conf.png_doublep

pub const PNG_H: c_tokens = ""

pub const PNG_LIBPNG_VER_STRING: []const u8 = "1.6.43"
pub const PNG_LIBPNG_VER_SONUM: c_int = 16
pub const PNG_LIBPNG_VER_DLLNUM: c_int = 16
pub const PNG_LIBPNG_VER_SHAREDLIB: c_int = 16
pub const PNG_LIBPNG_VER_MAJOR: c_int = 1
pub const PNG_LIBPNG_VER_MINOR: c_int = 6
pub const PNG_LIBPNG_VER_RELEASE: c_int = 43
pub const PNG_LIBPNG_VER_BUILD: c_int = 0
pub const PNG_LIBPNG_VER: c_int = 10643
pub const PNG_LIBPNG_BUILD_STABLE: c_int = 4
pub const PNG_LIBPNG_BUILD_TYPE: c_int = 4

// The structures of a reader or writer and of the information read or to
// be written: the library's own.
pub const png_struct_def = struct {}
pub const png_struct = png_struct_def
pub const png_const_structp = *const png_struct
pub const png_structp = *png_struct
pub const png_structpp = *png_structp
pub const png_structrp = *png_struct
pub const png_const_structrp = *const png_struct

pub const png_info_def = struct {}
pub const png_info = png_info_def
pub const png_infop = *png_info
pub const png_const_infop = *const png_info
pub const png_infopp = *png_infop
pub const png_inforp = *png_info
pub const png_const_inforp = *const png_info

// A palette entry.
pub const png_color_struct = struct {
    red: png_byte
    green: png_byte
    blue: png_byte
}
pub const png_color = png_color_struct
pub const png_colorp = *png_color
pub const png_const_colorp = *const png_color
pub const png_colorpp = *png_colorp

// A colour of up to 16 bits a sample (tRNS's, bKGD's), or a palette index.
pub const png_color_16_struct = struct {
    index: png_byte
    red: png_uint_16
    green: png_uint_16
    blue: png_uint_16
    gray: png_uint_16
}
pub const png_color_16 = png_color_16_struct
pub const png_color_16p = *png_color_16
pub const png_const_color_16p = *const png_color_16
pub const png_color_16pp = *png_color_16p

// The significant bits of each sample (sBIT).
pub const png_color_8_struct = struct {
    red: png_byte
    green: png_byte
    blue: png_byte
    gray: png_byte
    alpha: png_byte
}
pub const png_color_8 = png_color_8_struct
pub const png_color_8p = *png_color_8
pub const png_const_color_8p = *const png_color_8
pub const png_color_8pp = *png_color_8p

// A text chunk (tEXt, zTXt, iTXt) to be written.
pub const png_text_struct = struct {
    compression: c_int
    key: png_charp
    text: png_charp
    text_length: png_size_t
    itxt_length: png_size_t
    lang: png_charp
    lang_key: png_charp
}
pub const png_text = png_text_struct
pub const png_textp = *png_text
pub const png_const_textp = *const png_text
pub const png_textpp = *png_textp

// A chunk libpng does not know: its name, data, size, and where it was
// (or is to be written): PNG_HAVE_IHDR, PNG_HAVE_PLTE or PNG_AFTER_IDAT.
pub const png_unknown_chunk_t = struct {
    name: [5]png_byte
    data: *png_byte
    size: png_size_t
    location: png_byte
}
pub const png_unknown_chunk = png_unknown_chunk_t
pub const png_unknown_chunkp = *png_unknown_chunk
pub const png_const_unknown_chunkp = *const png_unknown_chunk
pub const png_unknown_chunkpp = *png_unknown_chunkp

// What a row holds (for the user transforms libpng offers).
pub const png_row_info_struct = struct {
    width: png_uint_32
    rowbytes: png_size_t
    color_type: png_byte
    bit_depth: png_byte
    channels: png_byte
    pixel_depth: png_byte
}
pub const png_row_info = png_row_info_struct
pub const png_row_infop = *png_row_info
pub const png_row_infopp = *png_row_infop

// The callbacks: errors and warnings, the reading and writing of data, the
// progressive reader's info, rows and end, unknown chunks, memory.
pub const png_error_ptr = fn(png_ptr: png_structp, message: png_const_charp) -> void
pub const png_rw_ptr = fn(png_ptr: png_structp, data: png_bytep, length: png_size_t) -> void
pub const png_flush_ptr = fn(png_ptr: png_structp) -> void
pub const png_read_status_ptr = fn(png_ptr: png_structp, row: png_uint_32, pass: c_int) -> void
pub const png_write_status_ptr = fn(png_ptr: png_structp, row: png_uint_32, pass: c_int) -> void
pub const png_progressive_info_ptr = fn(png_ptr: png_structp, info_ptr: png_infop) -> void
pub const png_progressive_end_ptr = fn(png_ptr: png_structp, info_ptr: png_infop) -> void
pub const png_progressive_row_ptr = fn(png_ptr: png_structp, new_row: png_bytep, row_num: png_uint_32, pass: c_int) -> void
pub const png_user_chunk_ptr = fn(png_ptr: png_structp, chunk: png_unknown_chunkp) -> c_int
pub const png_longjmp_ptr = fn(env: jmp_buf, val: c_int) -> void
pub const png_malloc_ptr = fn(png_ptr: png_structp, size: png_alloc_size_t) -> png_voidp
pub const png_free_ptr = fn(png_ptr: png_structp, ptr: png_voidp) -> void

