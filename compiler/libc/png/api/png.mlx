// ---------------------------------------------------------------------------
// The library

pub extern("c") fn png_access_version_number() -> png_uint_32
pub extern("c") fn png_get_libpng_ver(png_ptr: png_const_structrp) -> png_const_charp
pub extern("c") fn png_get_header_ver(png_ptr: png_const_structrp) -> png_const_charp
pub extern("c") fn png_get_header_version(png_ptr: png_const_structrp) -> png_const_charp
pub extern("c") fn png_get_copyright(png_ptr: png_const_structrp) -> png_const_charp

// Whether NUM_TO_CHECK bytes of SIG from START on are the PNG signature's
// (0 when they are).
pub extern("c") fn png_sig_cmp(sig: png_const_bytep, start: png_size_t, num_to_check: png_size_t) -> c_int
// How many signature bytes the application read before giving the rest.
pub extern("c") fn png_set_sig_bytes(png_ptr: png_structrp, num_bytes: c_int) -> void

// Readers, writers and info structures.
pub extern("c") fn png_create_read_struct(user_png_ver: png_const_charp, error_ptr: png_voidp, error_fn: png_error_ptr, warn_fn: png_error_ptr) -> png_structp
pub extern("c") fn png_create_read_struct_2(user_png_ver: png_const_charp, error_ptr: png_voidp, error_fn: png_error_ptr, warn_fn: png_error_ptr, mem_ptr: png_voidp, malloc_fn: png_malloc_ptr, free_fn: png_free_ptr) -> png_structp
pub extern("c") fn png_create_write_struct(user_png_ver: png_const_charp, error_ptr: png_voidp, error_fn: png_error_ptr, warn_fn: png_error_ptr) -> png_structp
pub extern("c") fn png_create_write_struct_2(user_png_ver: png_const_charp, error_ptr: png_voidp, error_fn: png_error_ptr, warn_fn: png_error_ptr, mem_ptr: png_voidp, malloc_fn: png_malloc_ptr, free_fn: png_free_ptr) -> png_structp
pub extern("c") fn png_create_info_struct(png_ptr: png_const_structrp) -> png_infop
pub extern("c") fn png_destroy_info_struct(png_ptr: png_const_structrp, info_ptr_ptr: png_infopp) -> void
pub extern("c") fn png_destroy_read_struct(png_ptr_ptr: png_structpp, info_ptr_ptr: png_infopp, end_info_ptr_ptr: png_infopp) -> void
pub extern("c") fn png_destroy_write_struct(png_ptr_ptr: png_structpp, info_ptr_ptr: png_infopp) -> void
pub extern("c") fn png_free_data(png_ptr: png_const_structrp, info_ptr: png_inforp, free_me: png_uint_32, num: c_int) -> void

// Memory, through the structure's allocator.
pub extern("c") fn png_malloc(png_ptr: png_const_structrp, size: png_alloc_size_t) -> png_voidp
pub extern("c") fn png_calloc(png_ptr: png_const_structrp, size: png_alloc_size_t) -> png_voidp
pub extern("c") fn png_malloc_warn(png_ptr: png_const_structrp, size: png_alloc_size_t) -> png_voidp
pub extern("c") fn png_free(png_ptr: png_const_structrp, ptr: png_voidp) -> void
pub extern("c") fn png_get_mem_ptr(png_ptr: png_const_structrp) -> png_voidp
pub extern("c") fn png_set_mem_fn(png_ptr: png_structrp, mem_ptr: png_voidp, malloc_fn: png_malloc_ptr, free_fn: png_free_ptr) -> void

// Errors: png_error calls the error function, then longjmps to the
// png_jmpbuf of the structure; warnings call the warning function.
pub extern("c") fn png_set_longjmp_fn(png_ptr: png_structrp, longjmp_fn: png_longjmp_ptr, jmp_buf_size: png_size_t) -> *jmp_buf
pub extern("c") fn png_longjmp(png_ptr: png_const_structrp, val: c_int) -> void
pub extern("c") fn png_error(png_ptr: png_const_structrp, error_message: png_const_charp) -> void
pub extern("c") fn png_chunk_error(png_ptr: png_const_structrp, error_message: png_const_charp) -> void
pub extern("c") fn png_warning(png_ptr: png_const_structrp, warning_message: png_const_charp) -> void
pub extern("c") fn png_chunk_warning(png_ptr: png_const_structrp, warning_message: png_const_charp) -> void
pub extern("c") fn png_benign_error(png_ptr: png_const_structrp, warning_message: png_const_charp) -> void
pub extern("c") fn png_chunk_benign_error(png_ptr: png_const_structrp, warning_message: png_const_charp) -> void
pub extern("c") fn png_set_benign_errors(png_ptr: png_structrp, allowed: c_int) -> void
pub extern("c") fn png_set_error_fn(png_ptr: png_structrp, error_ptr: png_voidp, error_fn: png_error_ptr, warning_fn: png_error_ptr) -> void
pub extern("c") fn png_get_error_ptr(png_ptr: png_const_structrp) -> png_voidp

// The reader's settings.
pub extern("c") fn png_set_crc_action(png_ptr: png_structrp, crit_action: c_int, ancil_action: c_int) -> void
pub extern("c") fn png_set_option(png_ptr: png_structrp, option: c_int, onoff: c_int) -> c_int
pub extern("c") fn png_set_user_limits(png_ptr: png_structrp, user_width_max: png_uint_32, user_height_max: png_uint_32) -> void
pub extern("c") fn png_get_user_width_max(png_ptr: png_const_structrp) -> png_uint_32
pub extern("c") fn png_get_user_height_max(png_ptr: png_const_structrp) -> png_uint_32
