// pngconf.h
// mlx-libpng: libpng's basic types for x86_64 Linux (png_byte,
// png_uint_32, png_fixed_point and their pointers) and the declaration
// macros libpng's own headers and old programs use (PNGAPI, PNGARG...),
// empty or plain here. <setjmp.h> comes with it, as libpng's brings it
// for png_jmpbuf.
const c_function_pointers = true
const c_system_headers = "limits.h stddef.h stdio.h setjmp.h time.h"

// (Mlx names of C types: C has them as they are.)
pub const c_char = u8
pub const c_uchar = u8
pub const c_int = i32
pub const c_uint = u32
pub const c_long = i64
pub const c_ulong = u64
pub const c_double = f64
// C tokens a macro takes or stands for.
pub const c_tokens = usize

pub const PNGCONF_H: c_tokens = ""

// (Linkage and calling conventions: none of them here.)
pub const PNGCAPI: c_tokens = ""
pub const PNGCBAPI: c_tokens = ""
pub const PNGAPI: c_tokens = ""
pub const PNG_IMPEXP: c_tokens = ""
pub const PNG_RESTRICT: c_tokens = "__restrict"
pub const PNG_CONST: c_tokens = "const"
pub const PNG_DEPRECATED: c_tokens = ""
pub const PNG_PRIVATE: c_tokens = ""
pub const PNG_ALLOCATED: c_tokens = ""
pub const PNG_NORETURN: c_tokens = "__attribute__((__noreturn__))"
pub inline fn PNGARG(arglist: c_tokens) -> c_tokens { return arglist }

pub const png_byte = c_uchar
pub const png_int_16 = i16
pub const png_uint_16 = u16
pub const png_int_32 = i32
pub const png_uint_32 = u32
pub const png_size_t = usize
pub const png_ptrdiff_t = isize
pub const png_alloc_size_t = usize
// A number times 100000 (gamma, chromaticities).
pub const png_fixed_point = png_int_32

pub const png_voidp = *anyopaque
pub const png_const_voidp = *const anyopaque
pub const png_bytep = *png_byte
pub const png_const_bytep = *const png_byte
pub const png_uint_32p = *png_uint_32
pub const png_const_uint_32p = *const png_uint_32
pub const png_int_32p = *png_int_32
pub const png_const_int_32p = *const png_int_32
pub const png_uint_16p = *png_uint_16
pub const png_const_uint_16p = *const png_uint_16
pub const png_int_16p = *png_int_16
pub const png_const_int_16p = *const png_int_16
pub const png_charp = *c_char
pub const png_const_charp = *const c_char
pub const png_fixed_point_p = *png_fixed_point
pub const png_const_fixed_point_p = *const png_fixed_point
pub const png_size_tp = *usize
pub const png_const_size_tp = *const usize
pub const png_doublep = *c_double
pub const png_const_doublep = *const c_double
pub const png_FILE_p = *FILE

pub const png_bytepp = *png_bytep
pub const png_uint_32pp = *png_uint_32p
pub const png_int_32pp = *png_int_32p
pub const png_uint_16pp = *png_uint_16p
pub const png_int_16pp = *png_int_16p
pub const png_const_charpp = *png_const_charp
pub const png_charpp = *png_charp
pub const png_fixed_point_pp = *png_fixed_point_p
pub const png_doublepp = *png_doublep
pub const png_charppp = *png_charpp
