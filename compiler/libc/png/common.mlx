// What the parts of mlx-libpng share: the structure behind a png_structp
// (a reader or a writer: std.png's reader and libpng's state around it)
// and behind a png_infop, the memory functions, the errors (png_error:
// the error function, then a longjmp to the application's png_jmpbuf)
// and warnings, and byte access by address.
//
// png_error leaves this library by the application's longjmp: the frames
// of Mlx between are dropped (the library is built with --stack-arena,
// so their arenas are on the stack the longjmp gives back), and nothing
// a later call needs is kept in them: whatever is allocated hangs off
// the structure, which png_destroy_read_struct frees.
//
// Arithmetic is done in 64-bit words and narrowed values are masked first.
const zs = @import("std.flate.stream")
const read = @import("std.png.read")

pub const Allocator = zs.Allocator

extern("c") fn malloc(size: usize) -> usize
extern("c") fn free(address: usize) -> void
extern("c") fn memcpy(target: usize, source: usize, count: usize) -> usize
extern("c") fn memmove(target: usize, source: usize, count: usize) -> usize
extern("c") fn memset(target: usize, value: i32, count: usize) -> usize
extern("c") fn write(descriptor: i32, buffer: usize, count: usize) -> isize
extern("c") fn abort() -> void

// The C functions the application gives.
pub const ErrorFn = fn(usize, usize) -> void
pub const LongjmpFn = fn(usize, i32) -> void
pub const InfoFn = fn(usize, usize) -> void
pub const RowFn = fn(usize, usize, u32, i32) -> void
pub const UserChunkFn = fn(usize, usize) -> i32
pub const MallocFn = fn(usize, usize) -> usize
pub const FreeFn = fn(usize, usize) -> void
pub const WriteFn = fn(usize, usize, usize) -> void
pub const FlushFn = fn(usize) -> void

pub const READ_MAGIC: usize = 0x50474e4452454144
pub const WRITE_MAGIC: usize = 0x50474e4457524954
pub const INFO_MAGIC: usize = 0x50474e44494e464f

// libpng's transformations (png_ptr->transformations).
pub const T_BGR: usize = 0x0001
pub const T_INTERLACE: usize = 0x0002
pub const T_PACK: usize = 0x0004
pub const T_SHIFT: usize = 0x0008
pub const T_SWAP_BYTES: usize = 0x0010
pub const T_INVERT_MONO: usize = 0x0020
pub const T_EXPAND_16: usize = 0x0200
pub const T_16_TO_8: usize = 0x0400
pub const T_EXPAND: usize = 0x1000
pub const T_GAMMA: usize = 0x2000
pub const T_GRAY_TO_RGB: usize = 0x4000
pub const T_FILLER: usize = 0x8000
pub const T_PACKSWAP: usize = 0x10000
pub const T_SWAP_ALPHA: usize = 0x20000
pub const T_STRIP_ALPHA: usize = 0x40000
pub const T_INVERT_ALPHA: usize = 0x80000
pub const T_ADD_ALPHA: usize = 0x1000000
pub const T_EXPAND_tRNS: usize = 0x2000000
pub const T_SCALE_16_TO_8: usize = 0x4000000

// libpng's flags (png_ptr->flags) the library keeps itself; the CRC ones
// are the reader's.
pub const F_FILLER_AFTER: usize = 0x0080
pub const F_ROW_INIT: usize = 0x0040
pub const F_BENIGN_ERRORS_WARN: usize = 0x100000
pub const F_APP_WARNINGS_WARN: usize = 0x200000
pub const F_APP_ERRORS_WARN: usize = 0x400000

// A reader or a writer (png_struct).
pub const Png = struct {
    magic: usize
    reader: read.Reader
    file: read.Info
    // Memory: the application's functions, or the C library's.
    memPtr: usize
    mallocFn: usize
    freeFn: usize
    // Errors.
    errorPtr: usize
    errorFn: usize
    warningFn: usize
    longjmpFn: usize
    jmpBufPtr: usize
    jmpBufSize: usize
    jmpBufLocal: [64]u64
    flags: usize
    transformations: usize
    userWidthMax: usize
    userHeightMax: usize
    chunkCacheMax: usize
    options: usize
    // The progressive reader's functions (and the writer's io pointer).
    ioPtr: usize
    infoFn: usize
    rowFn: usize
    endFn: usize
    userChunkPtr: usize
    userChunkFn: usize
    writeFn: usize
    flushFn: usize
    // The image (libpng's png_ptr->width and the rest, from IHDR).
    width: usize
    height: usize
    bitDepth: usize
    colorType: usize
    channels: usize
    pixelDepth: usize
    rowbytes: usize
    interlaced: usize
    // Transformations' state.
    filler: usize
    gamma: i64
    screenGamma: i64
    gammaTable: usize
    gamma16Table: usize
    gamma16Bytes: usize
    gammaShift: usize
    numTrans: usize
    // The rows: buffers (the filter byte first), the pass, the row.
    bigRowBuf: usize
    bigPrevRow: usize
    bigRowBufSize: usize
    rowBuf: usize
    prevRow: usize
    iwidth: usize
    numRows: usize
    rowNumber: usize
    pass: usize
    maximumPixelDepth: usize
    transformedPixelDepth: usize
    infoRowbytes: usize
    // The unknown chunk given to the user chunk function, as C lays out a
    // png_unknown_chunk.
    unknownName: [8]u8
    unknownData: usize
    unknownSize: usize
    unknownLocation: usize
    // Set by png_process_data_pause.
    paused: bool
    // The info png_process_data was given (for the callbacks).
    currentInfo: usize
    // A message formatted for png_chunk_error and png_chunk_warning.
    message: [256]u8
    // The writer's state.
    writer: usize
}

// The info (png_info): the reader keeps what the file says in its Png;
// after png_read_update_info, the header as the transformations make it.
pub const PngInfo = struct {
    magic: usize
    updated: bool
    colorType: usize
    bitDepth: usize
    channels: usize
    pixelDepth: usize
    rowBytes: usize
    numTrans: usize
    // C views given out: png_color_16 (tRNS, bKGD).
    transColor: [10]u8
    background: [10]u8
    // What a writer is to write.
    data: read.Info
    texts: usize
    textCount: usize
    unknowns: usize
    unknownCount: usize
    // An owner, for png_destroy_info_struct's frees.
    owner: usize
}

pub inline fn pngOf(address: usize) -> *Png { return unsafe { @ptrFromInt(*Png, address) } }
pub inline fn infoOf(address: usize) -> *PngInfo { return unsafe { @ptrFromInt(*PngInfo, address) } }

pub inline fn get8(address: usize) -> usize { return @intCast(usize, zs.get8(address)) }
pub inline fn put8(address: usize, value: usize) -> void { zs.put8(address, value) }
pub fn put16(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*u16, address).* = @intCast(u16, value & 0xffff) } }
pub fn put32(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*u32, address).* = @intCast(u32, value & 0xffffffff) } }
pub fn putI32(address: usize, value: i64) -> void { unsafe { @ptrFromInt(*i32, address).* = @intCast(i32, value) } }
pub fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }
pub fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub fn putDouble(address: usize, value: f64) -> void { unsafe { @ptrFromInt(*f64, address).* = value } }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if count != 0 { _ = memcpy(target, source, count) }
}

pub fn zero(target: usize, count: usize) -> void {
    if count != 0 { _ = memset(target, 0, count) }
}

// The address of a literal's bytes (a NUL follows them), for C.
pub fn literal(text: []const u8) -> usize { return @intFromPtr(text.pointer) }

pub fn cLength(text: usize) -> usize {
    var count: usize = 0
    while get8(text + count) != 0 { count += 1 }
    return count
}

// Whether ADDRESS is a structure of this library (of MAGIC).
pub fn isPng(address: usize) -> bool { return address != 0 && pngOf(address).*.magic == READ_MAGIC }
pub fn isWriter(address: usize) -> bool { return address != 0 && pngOf(address).*.magic == WRITE_MAGIC }
pub fn isAny(address: usize) -> bool { return address != 0 && (pngOf(address).*.magic == READ_MAGIC || pngOf(address).*.magic == WRITE_MAGIC) }

// ---------------------------------------------------------------------------
// Memory: png_malloc and png_free, through the application's functions
// when it gave them.

pub fn rawAlloc(png: *Png, size: usize) -> usize {
    const count = if size == 0 { 1 } else { size }
    if png.*.mallocFn != 0 {
        const call: MallocFn = unsafe { @ptrFromInt(MallocFn, png.*.mallocFn) }
        return call(@intFromPtr(png), count)
    }
    return malloc(count)
}

// The C library's memory (the structure itself, when the application
// gives no memory functions).
pub fn systemAlloc(size: usize) -> usize { return malloc(size) }

pub fn rawFree(png: *Png, address: usize) -> void {
    if address == 0 { return }
    if png.*.freeFn != 0 {
        const call: FreeFn = unsafe { @ptrFromInt(FreeFn, png.*.freeFn) }
        call(@intFromPtr(png), address)
        return
    }
    free(address)
}

// Memory the caller frees with rawFree; png_error when there is none.
pub fn allocate(png: *Png, size: usize) -> usize {
    const address = rawAlloc(png, size)
    if address == 0 { pngError(png, literal("Out of memory")) }
    return address
}

// The structure's memory as std's Allocator (for std.png's reader).
fn allocatorAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const address = rawAlloc(pngOf(@intFromPtr(context)), length)
    if address == 0 { return null }
    return zs.bytes(address)
}

fn allocatorResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> bool { return false }

fn allocatorRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> ?[*]u8 {
    const png = pngOf(@intFromPtr(context))
    const address = rawAlloc(png, newLength)
    if address == 0 { return null }
    copy(address, @intFromPtr(memory), if length < newLength { length } else { newLength })
    rawFree(png, @intFromPtr(memory))
    return zs.bytes(address)
}

fn allocatorFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    rawFree(pngOf(@intFromPtr(context)), @intFromPtr(memory))
}

pub fn allocatorOf(png: *Png) -> Allocator {
    unsafe {
        return Allocator.{
            .context = @ptrFromInt(*anyopaque, @intFromPtr(png)),
            .allocFn = allocatorAlloc,
            .resizeFn = allocatorResize,
            .remapFn = allocatorRemap,
            .freeFn = allocatorFree
        }
    }
}

// ---------------------------------------------------------------------------
// Errors and warnings (pngerror.c)

fn say(text: []const u8) -> void { _ = write(2, literal(text), text.length) }

// png_longjmp: to the application's png_jmpbuf; abort() when there is
// none (libpng's PNG_ABORT).
pub fn pngLongjmp(png: *Png, value: i32) -> void {
    if png.*.longjmpFn != 0 && png.*.jmpBufPtr != 0 {
        const call: LongjmpFn = unsafe { @ptrFromInt(LongjmpFn, png.*.longjmpFn) }
        call(png.*.jmpBufPtr, value)
    }
    abort()
}

// png_error: the error function (which may longjmp itself), then
// libpng's default: the message on stderr and the longjmp.
pub fn pngError(png: *Png, message: usize) -> void {
    if png.*.errorFn != 0 {
        const call: ErrorFn = unsafe { @ptrFromInt(ErrorFn, png.*.errorFn) }
        call(@intFromPtr(png), message)
    }
    say("libpng error: ")
    _ = write(2, message, cLength(message))
    say("\n")
    pngLongjmp(png, 1)
}

pub fn pngWarning(png: *Png, message: usize) -> void {
    if png.*.warningFn != 0 {
        const call: ErrorFn = unsafe { @ptrFromInt(ErrorFn, png.*.warningFn) }
        call(@intFromPtr(png), message)
        return
    }
    say("libpng warning: ")
    _ = write(2, message, cLength(message))
    say("\n")
}

// png_format_buffer: "NAME: message" for the chunk being read, a byte
// that is not a letter as [XX].
fn formatChunk(png: *Png, message: usize) -> usize {
    const target = @intFromPtr(&png.*.message)
    const name = png.*.reader.chunkName
    var at: usize = 0
    var shift: usize = 24
    while true {
        const c = (name >> shift) & 255
        if c < 65 || c > 122 || (c > 90 && c < 97) {
            const digits = "0123456789ABCDEF"
            put8(target + at, 91)
            put8(target + at + 1, @intCast(usize, digits[c >> 4]))
            put8(target + at + 2, @intCast(usize, digits[c & 15]))
            put8(target + at + 3, 93)
            at += 4
        } else {
            put8(target + at, c)
            at += 1
        }
        if shift == 0 { break }
        shift -= 8
    }
    put8(target + at, 58)
    put8(target + at + 1, 32)
    at += 2
    var index: usize = 0
    while at < 255 && index < 195 && get8(message + index) != 0 {
        put8(target + at, get8(message + index))
        at += 1
        index += 1
    }
    put8(target + at, 0)
    return target
}

pub fn chunkError(png: *Png, message: usize) -> void {
    if png.*.magic == READ_MAGIC { pngError(png, formatChunk(png, message)) }
    pngError(png, message)
}

pub fn chunkWarning(png: *Png, message: usize) -> void {
    if png.*.magic == READ_MAGIC {
        pngWarning(png, formatChunk(png, message))
        return
    }
    pngWarning(png, message)
}

pub fn benignError(png: *Png, message: usize) -> void {
    if png.*.flags & F_BENIGN_ERRORS_WARN != 0 {
        if png.*.magic == READ_MAGIC && png.*.reader.chunkName != 0 { chunkWarning(png, message) } else { pngWarning(png, message) }
        return
    }
    if png.*.magic == READ_MAGIC && png.*.reader.chunkName != 0 { chunkError(png, message) }
    pngError(png, message)
}

pub fn appError(png: *Png, message: usize) -> void {
    if png.*.flags & F_APP_ERRORS_WARN != 0 {
        pngWarning(png, message)
        return
    }
    pngError(png, message)
}

pub fn appWarning(png: *Png, message: usize) -> void {
    if png.*.flags & F_APP_WARNINGS_WARN != 0 {
        pngWarning(png, message)
        return
    }
    pngError(png, message)
}
