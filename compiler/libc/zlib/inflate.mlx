// zlib.h's inflate functions over std.flate's decompressor
// (std/src/flate/inflate.mlx): each maps the caller's z_stream onto a
// std.flate Stream for the call (common.enter, common.leave). The
// functions taking a z_stream's address are also what uncompress,
// inflateBack and the gzip files use.
const c = @import("./common.mlx")
const zs = @import("std.flate.stream")
const engine = @import("std.flate.inflate")

pub fn init2(strmAddress: usize, windowBits: i32, version: usize, streamSize: i32) -> i32 {
    if !c.versionMatches(version, streamSize) { return c.Z_VERSION_ERROR }
    if strmAddress == 0 { return c.Z_STREAM_ERROR }
    const strm = c.stream(strmAddress)
    strm.*.msg = 0
    c.defaultAllocators(strm)
    var s: zs.Stream = undefined
    _ = c.enter(&s, strmAddress)
    const result = engine.init2(&s, windowBits)
    c.leave(&s, strmAddress)
    return result
}

pub fn run(strmAddress: usize, flush: i32) -> i32 {
    var s: zs.Stream = undefined
    const usable = c.enter(&s, strmAddress)
    const result = engine.run(&s, flush)
    if usable { c.leave(&s, strmAddress) }
    return result
}

pub fn end(strmAddress: usize) -> i32 {
    var s: zs.Stream = undefined
    const usable = c.enter(&s, strmAddress)
    const result = engine.end(&s)
    if usable { c.leave(&s, strmAddress) }
    return result
}

pub fn reset(strmAddress: usize) -> i32 {
    var s: zs.Stream = undefined
    const usable = c.enter(&s, strmAddress)
    const result = engine.reset(&s)
    if usable { c.leave(&s, strmAddress) }
    return result
}

pub fn resetKeep(strmAddress: usize) -> i32 {
    var s: zs.Stream = undefined
    const usable = c.enter(&s, strmAddress)
    const result = engine.resetKeep(&s)
    if usable { c.leave(&s, strmAddress) }
    return result
}

pub fn reset2(strmAddress: usize, windowBits: i32) -> i32 {
    var s: zs.Stream = undefined
    const usable = c.enter(&s, strmAddress)
    const result = engine.reset2(&s, windowBits)
    if usable { c.leave(&s, strmAddress) }
    return result
}

pub fn prime(strmAddress: usize, bits: i32, value: i32) -> i32 {
    var s: zs.Stream = undefined
    _ = c.enter(&s, strmAddress)
    return engine.prime(&s, bits, value)
}

pub fn setDictionary(strmAddress: usize, dictionary: usize, dictLength: usize) -> i32 {
    var s: zs.Stream = undefined
    const usable = c.enter(&s, strmAddress)
    const result = engine.setDictionary(&s, dictionary, dictLength)
    if usable { c.leave(&s, strmAddress) }
    return result
}

pub fn getDictionary(strmAddress: usize, dictionary: usize, dictLength: usize) -> i32 {
    var s: zs.Stream = undefined
    _ = c.enter(&s, strmAddress)
    return engine.getDictionary(&s, dictionary, dictLength)
}

pub fn getHeader(strmAddress: usize, head: usize) -> i32 {
    var s: zs.Stream = undefined
    _ = c.enter(&s, strmAddress)
    return engine.getHeader(&s, head)
}

pub fn sync(strmAddress: usize) -> i32 {
    var s: zs.Stream = undefined
    const usable = c.enter(&s, strmAddress)
    const result = engine.sync(&s)
    if usable { c.leave(&s, strmAddress) }
    return result
}

pub fn syncPoint(strmAddress: usize) -> i32 {
    var s: zs.Stream = undefined
    _ = c.enter(&s, strmAddress)
    return engine.syncPoint(&s)
}

// inflateCopy: DEST becomes SOURCE's z_stream as it is (as zlib's memcpy
// makes it), with a state (and window) of its own.
pub fn copyStream(destAddress: usize, sourceAddress: usize) -> i32 {
    var source: zs.Stream = undefined
    if !c.enter(&source, sourceAddress) || destAddress == 0 { return c.Z_STREAM_ERROR }
    var dest: zs.Stream = undefined
    _ = c.enter(&dest, 0)
    dest.owner = destAddress
    const result = engine.copyStream(&dest, &source)
    if result != c.Z_OK { return result }
    c.copy(destAddress, sourceAddress, @sizeOf(c.ZStream))
    c.leave(&dest, destAddress)
    return result
}

pub fn undermine(strmAddress: usize, subvert: i32) -> i32 {
    var s: zs.Stream = undefined
    _ = c.enter(&s, strmAddress)
    return engine.undermine(&s, subvert)
}

pub fn validate(strmAddress: usize, check: i32) -> i32 {
    var s: zs.Stream = undefined
    _ = c.enter(&s, strmAddress)
    return engine.validate(&s, check)
}

pub fn mark(strmAddress: usize) -> i64 {
    var s: zs.Stream = undefined
    _ = c.enter(&s, strmAddress)
    return engine.mark(&s)
}

pub fn codesUsed(strmAddress: usize) -> u64 {
    var s: zs.Stream = undefined
    _ = c.enter(&s, strmAddress)
    return engine.codesUsed(&s)
}

// The word of the state of the z_stream at STRM kept for this layer
// (inflateBack's window); the stream has a state.
pub fn client(strmAddress: usize) -> *usize {
    const state: *engine.InflateState = unsafe { @ptrFromInt(*engine.InflateState, c.stream(strmAddress).*.state) }
    return &state.*.client
}

// The window size of the stream's state, in bytes.
pub fn windowSize(strmAddress: usize) -> usize {
    const state: *engine.InflateState = unsafe { @ptrFromInt(*engine.InflateState, c.stream(strmAddress).*.state) }
    return @intCast(usize, 1) << @intCast(u6, state.*.wbits)
}

// ---------------------------------------------------------------------------

export fn inflateInit_(strm: usize, version: usize, stream_size: i32) -> i32 { return init2(strm, c.MAX_WBITS, version, stream_size) }
export fn inflateInit2_(strm: usize, windowBits: i32, version: usize, stream_size: i32) -> i32 { return init2(strm, windowBits, version, stream_size) }
export fn inflate(strm: usize, flush: i32) -> i32 { return run(strm, flush) }
export fn inflateEnd(strm: usize) -> i32 { return end(strm) }
export fn inflateReset(strm: usize) -> i32 { return reset(strm) }
export fn inflateResetKeep(strm: usize) -> i32 { return resetKeep(strm) }
export fn inflateReset2(strm: usize, windowBits: i32) -> i32 { return reset2(strm, windowBits) }
export fn inflatePrime(strm: usize, bits: i32, value: i32) -> i32 { return prime(strm, bits, value) }
export fn inflateSetDictionary(strm: usize, dictionary: usize, dictLength: u32) -> i32 { return setDictionary(strm, dictionary, @intCast(usize, dictLength)) }
export fn inflateGetDictionary(strm: usize, dictionary: usize, dictLength: usize) -> i32 { return getDictionary(strm, dictionary, dictLength) }
export fn inflateGetHeader(strm: usize, head: usize) -> i32 { return getHeader(strm, head) }
export fn inflateSync(strm: usize) -> i32 { return sync(strm) }
export fn inflateSyncPoint(strm: usize) -> i32 { return syncPoint(strm) }
export fn inflateCopy(dest: usize, source: usize) -> i32 { return copyStream(dest, source) }
export fn inflateUndermine(strm: usize, subvert: i32) -> i32 { return undermine(strm, subvert) }
export fn inflateValidate(strm: usize, check: i32) -> i32 { return validate(strm, check) }
export fn inflateMark(strm: usize) -> i64 { return mark(strm) }
export fn inflateCodesUsed(strm: usize) -> u64 { return codesUsed(strm) }
