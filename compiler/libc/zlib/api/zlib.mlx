// zlib.h
// mlx-zlib: zlib's C API (1.3.1), implemented in Mlx by libmlxz.so
// (compiler/libc/zlib, over std.flate): deflate and inflate streams in
// the zlib, gzip and raw deflate formats, the one-call compress and
// uncompress, the Adler-32 and CRC-32 check values, and the gzip file
// functions.
const c_function_pointers = true
const zconf = @import("./zconf.mlx")

const c_char = zconf.c_char
const c_uchar = zconf.c_uchar
const c_int = zconf.c_int
const c_uint = zconf.c_uint
const c_long = zconf.c_long
const c_ulong = zconf.c_ulong
const c_va_list = zconf.c_va_list
const c_varargs = zconf.c_varargs
const c_tokens = zconf.c_tokens
const Byte = zconf.Byte
const Bytef = zconf.Bytef
const uInt = zconf.uInt
const uLong = zconf.uLong
const uLongf = zconf.uLongf
const voidpf = zconf.voidpf
const voidp = zconf.voidp
const voidpc = zconf.voidpc
const z_crc_t = zconf.z_crc_t
const z_size_t = zconf.z_size_t
const z_off_t = zconf.z_off_t
const z_off64_t = zconf.z_off64_t

pub const ZLIB_H: c_tokens = ""

pub const ZLIB_VERSION: []const u8 = "1.3.1"
pub const ZLIB_VERNUM: c_int = 0x1310
pub const ZLIB_VER_MAJOR: c_int = 1
pub const ZLIB_VER_MINOR: c_int = 3
pub const ZLIB_VER_REVISION: c_int = 1
pub const ZLIB_VER_SUBREVISION: c_int = 0

// The allocator of a stream: zalloc(opaque, items, size) gives items *
// size bytes (or Z_NULL), zfree(opaque, address) frees them; Z_NULL for
// both takes the C library's malloc and free.
pub const alloc_func = fn(opaque: voidpf, items: uInt, size: uInt) -> voidpf
pub const free_func = fn(opaque: voidpf, address: voidpf) -> void

// (The library's state of a stream.)
pub const internal_state = struct {}

// A compression or decompression stream: the input at next_in
// (avail_in bytes), the output at next_out (avail_out bytes), the totals,
// the message of the last error, the allocator, the data type deflate
// found (or inflate's state), and the check value of the data so far.
pub const z_stream_s = struct {
    next_in: ?[*]Bytef
    avail_in: uInt
    total_in: uLong
    next_out: ?[*]Bytef
    avail_out: uInt
    total_out: uLong
    msg: ?[*]c_char
    state: ?*internal_state
    zalloc: ?alloc_func
    zfree: ?free_func
    opaque: voidpf
    data_type: c_int
    adler: uLong
    reserved: uLong
}
pub const z_stream = z_stream_s
pub const z_streamp = *z_stream

// A gzip header: written by deflate (deflateSetHeader) or filled in by
// inflate (inflateGetHeader).
pub const gz_header_s = struct {
    text: c_int
    time: uLong
    xflags: c_int
    os: c_int
    extra: ?[*]Bytef
    extra_len: uInt
    extra_max: uInt
    name: ?[*]Bytef
    name_max: uInt
    comment: ?[*]Bytef
    comm_max: uInt
    hcrc: c_int
    done: c_int
}
pub const gz_header = gz_header_s
pub const gz_headerp = *gz_header

// The flush values of deflate() and inflate().
pub const Z_NO_FLUSH: c_int = 0
pub const Z_PARTIAL_FLUSH: c_int = 1
pub const Z_SYNC_FLUSH: c_int = 2
pub const Z_FULL_FLUSH: c_int = 3
pub const Z_FINISH: c_int = 4
pub const Z_BLOCK: c_int = 5
pub const Z_TREES: c_int = 6

// Return codes: positive for special events, negative for errors.
pub const Z_OK: c_int = 0
pub const Z_STREAM_END: c_int = 1
pub const Z_NEED_DICT: c_int = 2
pub const Z_ERRNO: c_int = -1
pub const Z_STREAM_ERROR: c_int = -2
pub const Z_DATA_ERROR: c_int = -3
pub const Z_MEM_ERROR: c_int = -4
pub const Z_BUF_ERROR: c_int = -5
pub const Z_VERSION_ERROR: c_int = -6

// Compression levels.
pub const Z_NO_COMPRESSION: c_int = 0
pub const Z_BEST_SPEED: c_int = 1
pub const Z_BEST_COMPRESSION: c_int = 9
pub const Z_DEFAULT_COMPRESSION: c_int = -1

// Compression strategies.
pub const Z_FILTERED: c_int = 1
pub const Z_HUFFMAN_ONLY: c_int = 2
pub const Z_RLE: c_int = 3
pub const Z_FIXED: c_int = 4
pub const Z_DEFAULT_STRATEGY: c_int = 0

// The values of data_type.
pub const Z_BINARY: c_int = 0
pub const Z_TEXT: c_int = 1
pub const Z_ASCII: c_int = Z_TEXT
pub const Z_UNKNOWN: c_int = 2

// The deflate method, the only one.
pub const Z_DEFLATED: c_int = 8

pub const Z_NULL: c_int = 0

pub const zlib_version: c_tokens = "zlibVersion()"

pub extern("c") fn zlibVersion() -> [*]const c_char

pub extern("c") fn deflate(strm: z_streamp, flush: c_int) -> c_int
pub extern("c") fn deflateEnd(strm: z_streamp) -> c_int
pub extern("c") fn inflate(strm: z_streamp, flush: c_int) -> c_int
pub extern("c") fn inflateEnd(strm: z_streamp) -> c_int

pub extern("c") fn deflateSetDictionary(strm: z_streamp, dictionary: ?[*]const Bytef, dictLength: uInt) -> c_int
pub extern("c") fn deflateGetDictionary(strm: z_streamp, dictionary: ?[*]Bytef, dictLength: ?*uInt) -> c_int
pub extern("c") fn deflateCopy(dest: z_streamp, source: z_streamp) -> c_int
pub extern("c") fn deflateReset(strm: z_streamp) -> c_int
pub extern("c") fn deflateParams(strm: z_streamp, level: c_int, strategy: c_int) -> c_int
pub extern("c") fn deflateTune(strm: z_streamp, good_length: c_int, max_lazy: c_int, nice_length: c_int, max_chain: c_int) -> c_int
pub extern("c") fn deflateBound(strm: z_streamp, sourceLen: uLong) -> uLong
pub extern("c") fn deflatePending(strm: z_streamp, pending: ?*c_uint, bits: ?*c_int) -> c_int
pub extern("c") fn deflatePrime(strm: z_streamp, bits: c_int, value: c_int) -> c_int
pub extern("c") fn deflateSetHeader(strm: z_streamp, head: gz_headerp) -> c_int

pub extern("c") fn inflateSetDictionary(strm: z_streamp, dictionary: ?[*]const Bytef, dictLength: uInt) -> c_int
pub extern("c") fn inflateGetDictionary(strm: z_streamp, dictionary: ?[*]Bytef, dictLength: ?*uInt) -> c_int
pub extern("c") fn inflateSync(strm: z_streamp) -> c_int
pub extern("c") fn inflateCopy(dest: z_streamp, source: z_streamp) -> c_int
pub extern("c") fn inflateReset(strm: z_streamp) -> c_int
pub extern("c") fn inflateReset2(strm: z_streamp, windowBits: c_int) -> c_int
pub extern("c") fn inflatePrime(strm: z_streamp, bits: c_int, value: c_int) -> c_int
pub extern("c") fn inflateMark(strm: z_streamp) -> c_long
pub extern("c") fn inflateGetHeader(strm: z_streamp, head: gz_headerp) -> c_int

// inflateBack: raw deflate data read by `in` and written by `out`
// through the caller's window.
pub const in_func = fn(desc: ?*anyopaque, buf: *[*]c_uchar) -> c_uint
pub const out_func = fn(desc: ?*anyopaque, buf: [*]c_uchar, len: c_uint) -> c_int

pub extern("c") fn inflateBack(strm: z_streamp, in_: in_func, in_desc: ?*anyopaque, out: out_func, out_desc: ?*anyopaque) -> c_int
pub extern("c") fn inflateBackEnd(strm: z_streamp) -> c_int

pub extern("c") fn zlibCompileFlags() -> uLong

pub extern("c") fn compress(dest: [*]Bytef, destLen: *uLongf, source: [*]const Bytef, sourceLen: uLong) -> c_int
pub extern("c") fn compress2(dest: [*]Bytef, destLen: *uLongf, source: [*]const Bytef, sourceLen: uLong, level: c_int) -> c_int
pub extern("c") fn compressBound(sourceLen: uLong) -> uLong
pub extern("c") fn uncompress(dest: [*]Bytef, destLen: *uLongf, source: [*]const Bytef, sourceLen: uLong) -> c_int
pub extern("c") fn uncompress2(dest: [*]Bytef, destLen: *uLongf, source: [*]const Bytef, sourceLen: *uLong) -> c_int

// A gzip file: the bytes read ahead for gzgetc first, the rest the
// library's.
pub const gzFile_s = struct {
    have: c_uint
    next: ?[*]c_uchar
    pos: z_off64_t
}
pub const gzFile = *gzFile_s

pub extern("c") fn gzopen(path: [*]const c_char, mode: [*]const c_char) -> ?gzFile
pub extern("c") fn gzopen64(path: [*]const c_char, mode: [*]const c_char) -> ?gzFile
pub extern("c") fn gzdopen(fd: c_int, mode: [*]const c_char) -> ?gzFile
pub extern("c") fn gzbuffer(file: gzFile, size: c_uint) -> c_int
pub extern("c") fn gzsetparams(file: gzFile, level: c_int, strategy: c_int) -> c_int
pub extern("c") fn gzread(file: gzFile, buf: voidp, len: c_uint) -> c_int
pub extern("c") fn gzfread(buf: voidp, size: z_size_t, nitems: z_size_t, file: gzFile) -> z_size_t
pub extern("c") fn gzwrite(file: gzFile, buf: voidpc, len: c_uint) -> c_int
pub extern("c") fn gzfwrite(buf: voidpc, size: z_size_t, nitems: z_size_t, file: gzFile) -> z_size_t
pub extern("c") fn gzprintf(file: gzFile, format: [*]const c_char, args: c_varargs) -> c_int
pub extern("c") fn gzvprintf(file: gzFile, format: [*]const c_char, va: c_va_list) -> c_int
pub extern("c") fn gzputs(file: gzFile, s: [*]const c_char) -> c_int
pub extern("c") fn gzgets(file: gzFile, buf: [*]c_char, len: c_int) -> ?[*]c_char
pub extern("c") fn gzputc(file: gzFile, c: c_int) -> c_int
pub extern("c") fn gzgetc(file: gzFile) -> c_int
pub extern("c") fn gzgetc_(file: gzFile) -> c_int
pub extern("c") fn gzungetc(c: c_int, file: gzFile) -> c_int
pub extern("c") fn gzflush(file: gzFile, flush: c_int) -> c_int
pub extern("c") fn gzseek(file: gzFile, offset: z_off_t, whence: c_int) -> z_off_t
pub extern("c") fn gzseek64(file: gzFile, offset: z_off64_t, whence: c_int) -> z_off64_t
pub extern("c") fn gzrewind(file: gzFile) -> c_int
pub extern("c") fn gztell(file: gzFile) -> z_off_t
pub extern("c") fn gztell64(file: gzFile) -> z_off64_t
pub extern("c") fn gzoffset(file: gzFile) -> z_off_t
pub extern("c") fn gzoffset64(file: gzFile) -> z_off64_t
pub extern("c") fn gzeof(file: gzFile) -> c_int
pub extern("c") fn gzdirect(file: gzFile) -> c_int
pub extern("c") fn gzclose(file: gzFile) -> c_int
pub extern("c") fn gzclose_r(file: gzFile) -> c_int
pub extern("c") fn gzclose_w(file: gzFile) -> c_int
pub extern("c") fn gzerror(file: gzFile, errnum: ?*c_int) -> ?[*]const c_char
pub extern("c") fn gzclearerr(file: gzFile) -> void

// Check values: Adler-32 starts at 1, CRC-32 at 0 (or the value of a
// call with a null buffer); the combinations are the check value of the
// two pieces put together, from each one's and the second one's length.
pub extern("c") fn adler32(adler: uLong, buf: ?[*]const Bytef, len: uInt) -> uLong
pub extern("c") fn adler32_z(adler: uLong, buf: ?[*]const Bytef, len: z_size_t) -> uLong
pub extern("c") fn adler32_combine(adler1: uLong, adler2: uLong, len2: z_off_t) -> uLong
pub extern("c") fn adler32_combine64(adler1: uLong, adler2: uLong, len2: z_off64_t) -> uLong
pub extern("c") fn crc32(crc: uLong, buf: ?[*]const Bytef, len: uInt) -> uLong
pub extern("c") fn crc32_z(crc: uLong, buf: ?[*]const Bytef, len: z_size_t) -> uLong
pub extern("c") fn crc32_combine(crc1: uLong, crc2: uLong, len2: z_off_t) -> uLong
pub extern("c") fn crc32_combine64(crc1: uLong, crc2: uLong, len2: z_off64_t) -> uLong
pub extern("c") fn crc32_combine_gen(len2: z_off_t) -> uLong
pub extern("c") fn crc32_combine_gen64(len2: z_off64_t) -> uLong
pub extern("c") fn crc32_combine_op(crc1: uLong, crc2: uLong, op: uLong) -> uLong

// The initializations with the caller's version and z_stream size, which
// the macros below pass.
pub extern("c") fn deflateInit_(strm: z_streamp, level: c_int, version: [*]const c_char, stream_size: c_int) -> c_int
pub extern("c") fn inflateInit_(strm: z_streamp, version: [*]const c_char, stream_size: c_int) -> c_int
pub extern("c") fn deflateInit2_(strm: z_streamp, level: c_int, method: c_int, windowBits: c_int, memLevel: c_int, strategy: c_int, version: [*]const c_char, stream_size: c_int) -> c_int
pub extern("c") fn inflateInit2_(strm: z_streamp, windowBits: c_int, version: [*]const c_char, stream_size: c_int) -> c_int
pub extern("c") fn inflateBackInit_(strm: z_streamp, windowBits: c_int, window: [*]c_uchar, version: [*]const c_char, stream_size: c_int) -> c_int

pub inline fn deflateInit(strm: z_streamp, level: c_int) -> c_int {
    return deflateInit_(strm, level, ZLIB_VERSION, @intCast(c_int, @sizeOf(z_stream)))
}

pub inline fn inflateInit(strm: z_streamp) -> c_int {
    return inflateInit_(strm, ZLIB_VERSION, @intCast(c_int, @sizeOf(z_stream)))
}

pub inline fn deflateInit2(strm: z_streamp, level: c_int, method: c_int, windowBits: c_int, memLevel: c_int, strategy: c_int) -> c_int {
    return deflateInit2_(strm, level, method, windowBits, memLevel, strategy, ZLIB_VERSION, @intCast(c_int, @sizeOf(z_stream)))
}

pub inline fn inflateInit2(strm: z_streamp, windowBits: c_int) -> c_int {
    return inflateInit2_(strm, windowBits, ZLIB_VERSION, @intCast(c_int, @sizeOf(z_stream)))
}

pub inline fn inflateBackInit(strm: z_streamp, windowBits: c_int, window: [*]c_uchar) -> c_int {
    return inflateBackInit_(strm, windowBits, window, ZLIB_VERSION, @intCast(c_int, @sizeOf(z_stream)))
}

// The message of a return code.
pub extern("c") fn zError(err: c_int) -> [*]const c_char
pub extern("c") fn inflateSyncPoint(strm: z_streamp) -> c_int
// The table of the CRCs of the 256 bytes.
pub extern("c") fn get_crc_table() -> [*]const z_crc_t
pub extern("c") fn inflateUndermine(strm: z_streamp, subvert: c_int) -> c_int
pub extern("c") fn inflateValidate(strm: z_streamp, check: c_int) -> c_int
pub extern("c") fn inflateCodesUsed(strm: z_streamp) -> c_ulong
pub extern("c") fn inflateResetKeep(strm: z_streamp) -> c_int
pub extern("c") fn deflateResetKeep(strm: z_streamp) -> c_int
