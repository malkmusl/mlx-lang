// libmlxz.so: zlib for C and C++ programs, with zlib's C API (1.3.1,
// declared by the modules of api/, whose C headers mlx-cheaders makes),
// over std.flate (the compressor and decompressor) and std.crc (the
// check values): deflate and inflate streams, compress and uncompress,
// the check values, the gzip files.
//
//     ./mlx build zlib
//
// The parts: common.mlx (z_stream, gz_header, the codes and messages,
// the allocator, a z_stream as std.flate's Stream), checksum.mlx
// (adler32, crc32...), deflate.mlx and inflate.mlx (the stream
// functions), utility.mlx (compress, uncompress, inflateBack, zError),
// gzip.mlx and varargs.mlx (the gzip files).
const common = @import("./common.mlx")
const checksum = @import("./checksum.mlx")
const deflate = @import("./deflate.mlx")
const inflate = @import("./inflate.mlx")
const utility = @import("./utility.mlx")
const gzip = @import("./gzip.mlx")
