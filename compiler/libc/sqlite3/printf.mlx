// SQLite's printf (sqlite3_mprintf, sqlite3_vmprintf, sqlite3_snprintf,
// sqlite3_vsnprintf): C's conversions (%d %i %u %x %X %o %c %s %f %e %E %g
// %G %p %%, flags, width and precision, `*`, the l, ll, h and z length
// modifiers) and SQLite's own: %q (a text with its quotes doubled), %Q
// (that in quotes, or NULL for a null pointer), %w (double quotes
// doubled), %z (a %s whose text is freed after).
const c = @import("./common.mlx")
const functions = @import("std.sql").functions
const numbers = @import("std.sql").numbers

const mem = c.mem

fn appendSigned(b: *mem.Buffer, v: i64) -> void { _ = mem.appendDecimal(b, v) }

fn appendUnsigned(b: *mem.Buffer, v: u64, base: u64, upper: bool) -> void {
    const start = b.*.length
    var rest = v
    while true {
        const d = rest % base
        _ = mem.appendByte(b, if d < 10 { 48 + d } else if upper { 55 + d } else { 87 + d })
        rest = rest / base
        if rest == 0 { break }
    }
    functions.reverse(b, start)
}

// Formats `format` with the arguments of the va_list `list` into `out`.
pub fn render(out: *mem.Buffer, pattern: usize, list: usize) -> void {
    var i: usize = 0
    const length = c.cLength(pattern)
    while i < length {
        const ch = mem.get8(pattern + i)
        if ch != 37 {
            _ = mem.appendByte(out, ch)
            i += 1
            continue
        }
        i += 1
        if i >= length { break }
        var left = false
        var plus = false
        var space = false
        var zero = false
        var alternate = false
        var bang = false
        while i < length {
            const flag = mem.get8(pattern + i)
            if flag == 45 {
                left = true
            } else if flag == 43 {
                plus = true
            } else if flag == 32 {
                space = true
            } else if flag == 48 {
                zero = true
            } else if flag == 35 {
                alternate = true
            } else if flag == 33 {
                bang = true
            } else if flag != 44 {
                break
            }
            i += 1
        }
        var width: usize = 0
        if i < length && mem.get8(pattern + i) == 42 {
            const w = c.nextInt(list)
            if w < 0 {
                left = true
                width = @intCast(usize, 0 - @intCast(i64, w))
            } else {
                width = @intCast(usize, w)
            }
            i += 1
        } else {
            while i < length && numbers.isDigit(mem.get8(pattern + i)) {
                width = width * 10 + @intCast(usize, mem.get8(pattern + i) - 48)
                i += 1
            }
        }
        var precision: i64 = -1
        if i < length && mem.get8(pattern + i) == 46 {
            i += 1
            precision = 0
            if i < length && mem.get8(pattern + i) == 42 {
                precision = @intCast(i64, c.nextInt(list))
                i += 1
            } else {
                while i < length && numbers.isDigit(mem.get8(pattern + i)) {
                    precision = precision * 10 + @intCast(i64, mem.get8(pattern + i) - 48)
                    i += 1
                }
            }
        }
        var long = false
        while i < length {
            const m = mem.get8(pattern + i)
            if m == 108 || m == 122 || m == 106 || m == 116 {
                long = true
            } else if m != 104 {
                break
            }
            i += 1
        }
        if i >= length { break }
        const conversion = mem.get8(pattern + i)
        i += 1
        const start = out.*.length
        if conversion == 37 {
            _ = mem.appendByte(out, 37)
            continue
        }
        if conversion == 100 || conversion == 105 {
            const v: i64 = if long { @bitCast(i64, c.nextWord(list)) } else { @intCast(i64, c.nextInt(list)) }
            if v >= 0 && plus { _ = mem.appendByte(out, 43) }
            if v >= 0 && space && !plus { _ = mem.appendByte(out, 32) }
            const digits = out.*.length
            appendSigned(out, v)
            if precision > 0 {
                const neg: usize = if v < 0 { 1 } else { 0 }
                if out.*.length - digits - neg < @intCast(usize, precision) { functions.pad(out, digits + neg, @intCast(usize, precision), false, true) }
            }
        } else if conversion == 117 || conversion == 120 || conversion == 88 || conversion == 111 {
            var v = c.nextWord(list)
            if !long { v = v & 0xffffffff }
            const base: u64 = if conversion == 117 { 10 } else if conversion == 111 { 8 } else { 16 }
            if alternate && v != 0 && base != 10 { _ = mem.appendText(out, if base == 8 { "0" } else if conversion == 120 { "0x" } else { "0X" }) }
            appendUnsigned(out, v, base, conversion == 88)
        } else if conversion == 112 {
            const v = c.nextWord(list)
            _ = mem.appendText(out, "0x")
            appendUnsigned(out, v, 16, false)
        } else if conversion == 99 {
            const v = c.nextInt(list)
            _ = mem.appendByte(out, @intCast(u64, v & 255))
        } else if conversion == 102 || conversion == 101 || conversion == 69 || conversion == 103 || conversion == 71 {
            const r = c.nextDouble(list)
            if r >= 0.0 && plus { _ = mem.appendByte(out, 43) }
            const p = if precision < 0 { 6 } else { @intCast(usize, precision) }
            if conversion == 102 {
                functions.formatFixed(out, r, p)
            } else if conversion == 103 || conversion == 71 {
                functions.formatGeneric(out, r, if p == 0 { 1 } else { p }, bang)
            } else {
                functions.formatExponent(out, r, p, conversion == 69)
            }
        } else if conversion == 115 || conversion == 122 {
            const text = @intCast(usize, c.nextWord(list))
            if text != 0 {
                var n = c.cLength(text)
                if precision >= 0 && @intCast(usize, precision) < n { n = @intCast(usize, precision) }
                _ = mem.append(out, text, n)
                if conversion == 122 { c.free(text) }
            }
        } else if conversion == 113 || conversion == 81 || conversion == 119 {
            const text = @intCast(usize, c.nextWord(list))
            if text == 0 {
                _ = mem.appendText(out, if conversion == 81 { "NULL" } else { "(NULL)" })
            } else {
                const quote: u64 = if conversion == 119 { 34 } else { 39 }
                if conversion == 81 { _ = mem.appendByte(out, 39) }
                var n = c.cLength(text)
                if precision >= 0 && @intCast(usize, precision) < n { n = @intCast(usize, precision) }
                var k: usize = 0
                while k < n {
                    const byte = mem.get8(text + k)
                    if byte == quote { _ = mem.appendByte(out, byte) }
                    _ = mem.appendByte(out, byte)
                    k += 1
                }
                if conversion == 81 { _ = mem.appendByte(out, 39) }
            }
        } else {
            continue
        }
        functions.pad(out, start, width, left, zero && !left && conversion != 115)
    }
}

// The formatted text in a block from malloc (0 when there is no memory).
pub fn mprintf(pattern: usize, list: usize) -> usize {
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    render(&b, pattern, list)
    const text = c.cCopy(b.data, b.length)
    mem.freeBuffer(&b)
    return text
}

// At most size - 1 bytes of the formatted text into `buffer`, and a 0.
pub fn snprintf(size: i32, buffer: usize, pattern: usize, list: usize) -> usize {
    if size <= 0 { return buffer }
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    render(&b, pattern, list)
    var n = b.length
    if n > @intCast(usize, size) - 1 { n = @intCast(usize, size) - 1 }
    mem.copy(buffer, b.data, n)
    mem.put8(buffer + n, 0)
    mem.freeBuffer(&b)
    return buffer
}

export fn sqlite3_mprintf(format: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    c.ready()
    var call: c.CallList = undefined
    var words: [6]usize = [6]usize{ format, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = c.varStart(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    return mprintf(format, list)
}

export fn sqlite3_vmprintf(format: usize, list: usize) -> usize {
    c.ready()
    return mprintf(format, list)
}

export fn sqlite3_snprintf(size: i32, buffer: usize, format: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    c.ready()
    var call: c.CallList = undefined
    var words: [6]usize = [6]usize{ @intCast(usize, @bitCast(u32, size)), buffer, format, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = c.varStart(&call, 3, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    return snprintf(size, buffer, format, list)
}

export fn sqlite3_vsnprintf(size: i32, buffer: usize, format: usize, list: usize) -> usize {
    c.ready()
    return snprintf(size, buffer, format, list)
}
