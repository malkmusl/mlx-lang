// What the parts of mlx-sqlite3 share: the C library's memory (what the
// library hands out, C frees with sqlite3_free; std.sql's own blocks come
// from it too), C strings, UTF-16 conversions, C's variable arguments
// (sqlite3_config's, the printf family's), and the result codes as the
// connection reports them (extended codes or not).
const sql = @import("std.sql")

pub const mem = sql.mem
pub const value = sql.value
pub const core = sql.core
pub const engine = sql.engine

pub extern("c") fn malloc(size: usize) -> usize
pub extern("c") fn calloc(count: usize, size: usize) -> usize
pub extern("c") fn realloc(address: usize, size: usize) -> usize
pub extern("c") fn free(address: usize) -> void
pub extern("c") fn malloc_usable_size(address: usize) -> usize

fn allocatorAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const address = malloc(if length == 0 { 1 } else { length })
    if address == 0 { return null }
    return mem.bytes(address)
}

fn allocatorResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> bool { return false }

fn allocatorRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> ?[*]u8 {
    const address = realloc(@intFromPtr(memory), if newLength == 0 { 1 } else { newLength })
    if address == 0 { return null }
    return mem.bytes(address)
}

fn allocatorFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    free(@intFromPtr(memory))
}

// std.sql takes its memory from the C library's malloc (safe from every
// thread). Called by the entry points a program may call first.
pub fn ready() -> void {
    if mem.ready() { return }
    unsafe {
        mem.use(mem.Allocator.{
            .context = @ptrFromInt(*anyopaque, 16),
            .allocFn = allocatorAlloc,
            .resizeFn = allocatorResize,
            .remapFn = allocatorRemap,
            .freeFn = allocatorFree
        })
    }
}

// ---------------------------------------------------------------------------
// C strings.

pub fn cLength(text: usize) -> usize { return mem.cLength(text) }

// A copy of `length` bytes from malloc, with a 0 after them.
pub fn cCopy(address: usize, length: usize) -> usize {
    const copy = malloc(length + 1)
    if copy == 0 { return 0 }
    if length > 0 { mem.copy(copy, address, length) }
    mem.put8(copy + length, 0)
    return copy
}

// The length of a text given to an API with `bytes` (negative: up to its
// 0; else at most `bytes`, and up to a 0 within them).
pub fn textLength(text: usize, bytes: i64) -> usize {
    if text == 0 { return 0 }
    if bytes < 0 { return cLength(text) }
    var n: usize = 0
    const limit = @intCast(usize, bytes)
    while n < limit && mem.get8(text + n) != 0 { n += 1 }
    return n
}

// ---------------------------------------------------------------------------
// UTF-16 (native byte order) and UTF-8.

// UTF-16 at `text` (`units` code units) as UTF-8 appended to `out`.
pub fn utf16ToUtf8(text: usize, units: usize, out: *mem.Buffer) -> void {
    var i: usize = 0
    while i < units {
        var c = @intCast(u64, mem.get8(text + i * 2)) | (@intCast(u64, mem.get8(text + i * 2 + 1)) << 8)
        i += 1
        if c >= 0xd800 && c < 0xdc00 && i < units {
            const low = @intCast(u64, mem.get8(text + i * 2)) | (@intCast(u64, mem.get8(text + i * 2 + 1)) << 8)
            if low >= 0xdc00 && low < 0xe000 {
                c = 0x10000 + ((c - 0xd800) << 10) + (low - 0xdc00)
                i += 1
            }
        }
        sql.functions.appendUtf8(out, c)
    }
}

// UTF-8 as UTF-16 (with a 0 unit after) appended to `out`; the number of
// UTF-16 units.
pub fn utf8ToUtf16(text: usize, length: usize, out: *mem.Buffer) -> usize {
    var at: usize = 0
    var units: usize = 0
    while at < length {
        const c = sql.functions.readUtf8(text, length, &at)
        if c >= 0x10000 {
            const v = c - 0x10000
            putUnit(out, 0xd800 + (v >> 10))
            putUnit(out, 0xdc00 + (v & 0x3ff))
            units += 2
        } else {
            putUnit(out, c)
            units += 1
        }
    }
    putUnit(out, 0)
    return units
}

fn putUnit(out: *mem.Buffer, unit: u64) -> void {
    _ = mem.appendByte(out, unit & 255)
    _ = mem.appendByte(out, (unit >> 8) & 255)
}

// The number of 16-bit units of a UTF-16 text (`bytes` negative: up to
// its 0 unit).
pub fn utf16Units(text: usize, bytes: i64) -> usize {
    var n: usize = 0
    if bytes < 0 {
        while mem.get8(text + n * 2) != 0 || mem.get8(text + n * 2 + 1) != 0 { n += 1 }
        return n
    }
    const limit = @intCast(usize, bytes) / 2
    while n < limit && (mem.get8(text + n * 2) != 0 || mem.get8(text + n * 2 + 1) != 0) { n += 1 }
    return n
}

// The UTF-16 units that `bytes` bytes of UTF-8 make (to map a tail back).
pub fn utf16UnitsOf(text: usize, bytes: usize) -> usize {
    var at: usize = 0
    var units: usize = 0
    while at < bytes {
        const c = sql.functions.readUtf8(text, bytes, &at)
        units += if c >= 0x10000 { 2 } else { 1 }
    }
    return units
}

// ---------------------------------------------------------------------------
// Result codes.

// A connection's result code as it reports it: the primary code unless
// extended codes were asked for.
pub fn reported(db: *core.Database, rc: i32) -> i32 {
    if db.*.extendedErrors { return rc }
    return rc & 255
}

// ---------------------------------------------------------------------------
// C's variable arguments. A variadic export takes the six integer
// registers and the eight vector registers as its parameters (its fixed
// parameters first) and makes them, with the caller's stack words above
// its frame, a System V va_list: the gp_offset and fp_offset words, the
// overflow area, the register save area.

pub const CallList = struct {
    header: [4]u64
    save: [22]u64
}

pub fn varStart(call: *CallList, fixed: usize, frame: usize, words: usize, doubles: usize) -> usize {
    const save = @intFromPtr(&call.*.save)
    mem.copy(save, words, 48)
    var index: usize = 0
    while index < 8 {
        mem.put64(save + 48 + index * 16, mem.get64(doubles + index * 8))
        mem.put64(save + 56 + index * 16, 0)
        index += 1
    }
    const header = @intFromPtr(&call.*.header)
    mem.put32(header, @intCast(u64, fixed * 8))
    mem.put32(header + 4, 48)
    mem.put64(header + 8, @intCast(u64, frame + 16))
    mem.put64(header + 16, @intCast(u64, save))
    return header
}

// The next integer-class argument (an integer or a pointer).
pub fn nextWord(list: usize) -> u64 {
    const offset = mem.get32(list)
    if offset < 48 {
        mem.put32(list, offset + 8)
        return mem.get64(@intCast(usize, mem.get64(list + 16)) + @intCast(usize, offset))
    }
    const overflow = @intCast(usize, mem.get64(list + 8))
    mem.put64(list + 8, @intCast(u64, overflow + 8))
    return mem.get64(overflow)
}

// The next double argument.
pub fn nextDouble(list: usize) -> f64 {
    const offset = mem.get32(list + 4)
    if offset < 176 {
        mem.put32(list + 4, offset + 16)
        return @bitCast(f64, mem.get64(@intCast(usize, mem.get64(list + 16)) + @intCast(usize, offset)))
    }
    const overflow = @intCast(usize, mem.get64(list + 8))
    mem.put64(list + 8, @intCast(u64, overflow + 8))
    return @bitCast(f64, mem.get64(overflow))
}

pub fn nextInt(list: usize) -> i32 { return @bitCast(i32, @intCast(u32, nextWord(list) & 4294967295)) }
