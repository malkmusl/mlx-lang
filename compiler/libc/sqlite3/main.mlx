// Connections: the library's version and setup (sqlite3_initialize,
// sqlite3_config), opening and closing, errors and their messages,
// sqlite3_exec and sqlite3_get_table, the busy handler and timeout, the
// authorizer and the hooks, memory, and the small utilities (complete,
// stricmp, strglob, strlike, keywords, limits, status).
const c = @import("./common.mlx")
const sql = @import("std.sql")

const mem = c.mem
const value = c.value
const core = c.core
const engine = c.engine
const lexer = @import("std.sql.lexer")
const functions = sql.functions
const pg = sql.pager
const values = @import("./values.mlx")
const schema = @import("std.sql.schema")

fn databaseOf(db: usize) -> *core.Database { return core.database(db) }

export fn sqlite3_libversion() -> usize { return @intFromPtr("3.45.1".pointer) }
export fn sqlite3_sourceid() -> usize { return @intFromPtr("2024-01-30 16:01:20 e876e51a0ed5c5b3126f52e532044363a014bc594cfefa87ffb5b82257ccalt1".pointer) }
export fn sqlite3_libversion_number() -> i32 { return 3045001 }
export fn sqlite3_compileoption_used(name: usize) -> i32 { return 0 }
export fn sqlite3_compileoption_get(n: i32) -> usize { return 0 }
// Serialized: every connection's calls are taken one at a time.
export fn sqlite3_threadsafe() -> i32 { return 1 }

export fn sqlite3_initialize() -> i32 {
    c.ready()
    return core.OK
}

export fn sqlite3_shutdown() -> i32 { return core.OK }
export fn sqlite3_os_init() -> i32 { return core.OK }
export fn sqlite3_os_end() -> i32 { return core.OK }

// sqlite3_config: the options are taken (the memory, mutex and cache
// ones change nothing: the library's memory is malloc's, its locks its
// own).
export fn sqlite3_config(op: i32, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> i32 {
    c.ready()
    if op < 1 || op > 30 { return core.ERROR }
    if op == 5 && a1 != 0 {
        // SQLITE_CONFIG_GETMALLOC: a zeroed sqlite3_mem_methods.
        mem.zero(a1, 64)
    }
    return core.OK
}

// sqlite3_db_config: foreign keys switch the connection's PRAGMA
// foreign_keys; the others report their usual values.
export fn sqlite3_db_config(db: usize, op: i32, a1: usize, a2: usize, a3: usize, a4: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> i32 {
    if db == 0 { return core.MISUSE }
    const d = databaseOf(db)
    if op == 1000 { return core.OK }
    if op == 1001 { return core.OK }
    if op < 1002 || op > 1019 { return core.ERROR }
    var on = @bitCast(i32, @intCast(u32, a1 & 0xffffffff))
    var current: i32 = 0
    if op == 1002 {
        if on >= 0 { d.*.foreignKeys = on > 0 }
        current = if d.*.foreignKeys { 1 } else { 0 }
    } else if op == 1003 || op == 1015 || op == 1013 || op == 1014 || op == 1017 {
        current = 1
    }
    if a2 != 0 { mem.put32(a2, @intCast(u64, @bitCast(u32, current))) }
    return core.OK
}

export fn sqlite3_extended_result_codes(db: usize, on: i32) -> i32 {
    if db == 0 { return core.MISUSE }
    databaseOf(db).*.extendedErrors = on != 0
    return core.OK
}

// ---------------------------------------------------------------------------
// Opening and closing.

fn openWith(filename: usize, length: usize, out: usize, flags: i32) -> i32 {
    c.ready()
    if out == 0 { return core.MISUSE }
    mem.put64(out, 0)
    var path = mem.view(filename, length)
    // A file: URI's path (its query is not read).
    if path.length >= 5 && mem.same(path[0..5], "file:") {
        var p = path[5..]
        var end: usize = 0
        while end < p.length && p[end] != 63 && p[end] != 35 { end += 1 }
        p = p[0..end]
        if p.length >= 2 && p[0] == 47 && p[1] == 47 {
            // file://host/path: the authority is skipped.
            var k: usize = 2
            while k < p.length && p[k] != 47 { k += 1 }
            p = p[k..]
        }
        path = p
    }
    if (flags & 0x80) != 0 { path = ":memory:" }
    var db: usize = 0
    const rc = engine.open(path, flags & 7, &db)
    mem.put64(out, @intCast(u64, db))
    if db == 0 { return core.NOMEM }
    if (flags & 0x02000000) != 0 { databaseOf(db).*.extendedErrors = true }
    return rc
}

export fn sqlite3_open(filename: usize, out: usize) -> i32 {
    return openWith(filename, c.cLength(filename), out, engine.OPEN_READWRITE | engine.OPEN_CREATE)
}

export fn sqlite3_open_v2(filename: usize, out: usize, flags: i32, vfs: usize) -> i32 {
    if (flags & 7) != 1 && (flags & 7) != 2 && (flags & 7) != 6 {
        if out != 0 { mem.put64(out, 0) }
        return core.MISUSE
    }
    return openWith(filename, c.cLength(filename), out, flags)
}

export fn sqlite3_open16(filename: usize, out: usize) -> i32 {
    c.ready()
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    c.utf16ToUtf8(filename, c.utf16Units(filename, -1), &b)
    const rc = openWith(b.data, b.length, out, engine.OPEN_READWRITE | engine.OPEN_CREATE)
    mem.freeBuffer(&b)
    return rc
}

export fn sqlite3_close(db: usize) -> i32 {
    if db == 0 { return core.OK }
    return engine.close(db, false)
}

export fn sqlite3_close_v2(db: usize) -> i32 {
    if db == 0 { return core.OK }
    return engine.close(db, true)
}

export fn sqlite3_uri_parameter(filename: usize, name: usize) -> usize { return 0 }
export fn sqlite3_uri_boolean(filename: usize, name: usize, fallback: i32) -> i32 { return if fallback != 0 { 1 } else { 0 } }
export fn sqlite3_uri_int64(filename: usize, name: usize, fallback: i64) -> i64 { return fallback }

// ---------------------------------------------------------------------------
// Errors.

export fn sqlite3_errcode(db: usize) -> i32 {
    if db == 0 { return core.NOMEM }
    const d = databaseOf(db)
    return d.*.errorCode & 255
}

export fn sqlite3_extended_errcode(db: usize) -> i32 {
    if db == 0 { return core.NOMEM }
    return databaseOf(db).*.errorCode
}

export fn sqlite3_errmsg(db: usize) -> usize {
    if db == 0 { return @intFromPtr("out of memory".pointer) }
    const d = databaseOf(db)
    if d.*.errorCode == core.OK || d.*.message.length == 0 {
        return @intFromPtr(core.errorText(d.*.errorCode).pointer)
    }
    return d.*.message.data
}

var messages16: mem.Buffer = undefined
var messages16Ready: bool = false

export fn sqlite3_errmsg16(db: usize) -> usize {
    c.ready()
    const text = sqlite3_errmsg(db)
    // (A buffer per connection would be SQLite's; one is kept here.)
    if !messages16Ready {
        mem.initBuffer(&messages16)
        messages16Ready = true
    }
    messages16.length = 0
    _ = c.utf8ToUtf16(text, c.cLength(text), &messages16)
    return messages16.data
}

export fn sqlite3_errstr(code: i32) -> usize {
    return @intFromPtr(core.errorText(code).pointer)
}

export fn sqlite3_error_offset(db: usize) -> i32 { return -1 }

// ---------------------------------------------------------------------------
// Changes, interrupts.

export fn sqlite3_last_insert_rowid(db: usize) -> i64 {
    if db == 0 { return 0 }
    return databaseOf(db).*.lastInsertRowid
}

export fn sqlite3_set_last_insert_rowid(db: usize, rowid: i64) -> void {
    if db != 0 { databaseOf(db).*.lastInsertRowid = rowid }
}

export fn sqlite3_changes(db: usize) -> i32 {
    if db == 0 { return 0 }
    return @intCast(i32, databaseOf(db).*.changes & 0x7fffffff)
}

export fn sqlite3_changes64(db: usize) -> i64 {
    if db == 0 { return 0 }
    return databaseOf(db).*.changes
}

export fn sqlite3_total_changes(db: usize) -> i32 {
    if db == 0 { return 0 }
    return @intCast(i32, databaseOf(db).*.totalChanges & 0x7fffffff)
}

export fn sqlite3_total_changes64(db: usize) -> i64 {
    if db == 0 { return 0 }
    return databaseOf(db).*.totalChanges
}

export fn sqlite3_interrupt(db: usize) -> void {
    if db != 0 { databaseOf(db).*.interrupted = true }
}

export fn sqlite3_is_interrupted(db: usize) -> i32 {
    if db == 0 { return 0 }
    return if databaseOf(db).*.interrupted { 1 } else { 0 }
}

// Whether the text ends a statement: its last token (outside strings and
// comments) is a semicolon.
fn complete(text: usize, length: usize) -> i32 {
    var l: lexer.Lexer = undefined
    lexer.init(&l, text, length)
    var t: lexer.Token = undefined
    var last: u8 = 0
    while true {
        lexer.next(&l, &t)
        if t.kind == lexer.END { break }
        if t.kind == lexer.ILLEGAL {
            // An unterminated string or comment: not complete.
            const first = mem.get8(text + t.start)
            if first == 39 || first == 34 || first == 91 || first == 96 { return 0 }
        }
        last = t.kind
    }
    return if last == lexer.SEMICOLON { 1 } else { 0 }
}

export fn sqlite3_complete(text: usize) -> i32 {
    if text == 0 { return 0 }
    return complete(text, c.cLength(text))
}

export fn sqlite3_complete16(text: usize) -> i32 {
    c.ready()
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    c.utf16ToUtf8(text, c.utf16Units(text, -1), &b)
    const result = complete(b.data, b.length)
    mem.freeBuffer(&b)
    return result
}

// ---------------------------------------------------------------------------
// Busy handling, the authorizer, hooks.

export fn sqlite3_busy_handler(db: usize, handler: usize, arg: usize) -> i32 {
    if db == 0 { return core.MISUSE }
    const d = databaseOf(db)
    d.*.busyHandler = handler
    d.*.busyArgument = arg
    d.*.busyTimeout = 0
    return core.OK
}

export fn sqlite3_busy_timeout(db: usize, ms: i32) -> i32 {
    if db == 0 { return core.MISUSE }
    const d = databaseOf(db)
    d.*.busyHandler = 0
    d.*.busyTimeout = if ms > 0 { @intCast(i64, ms) } else { 0 }
    return core.OK
}

export fn sqlite3_set_authorizer(db: usize, authorizer: usize, arg: usize) -> i32 {
    if db == 0 { return core.MISUSE }
    const d = databaseOf(db)
    d.*.authorizer = authorizer
    d.*.authorizerArgument = arg
    return core.OK
}

export fn sqlite3_progress_handler(db: usize, instructions: i32, handler: usize, arg: usize) -> void {}
export fn sqlite3_trace_v2(db: usize, mask: u32, callback: usize, context: usize) -> i32 { return core.OK }

var commitHook: usize = 0
var commitArgument: usize = 0
var rollbackHook: usize = 0
var rollbackArgument: usize = 0
var updateHook: usize = 0
var updateArgument: usize = 0

// The hooks are kept (and handed back) but not called.
export fn sqlite3_commit_hook(db: usize, callback: usize, arg: usize) -> usize {
    const previous = commitArgument
    commitHook = callback
    commitArgument = arg
    return previous
}

export fn sqlite3_rollback_hook(db: usize, callback: usize, arg: usize) -> usize {
    const previous = rollbackArgument
    rollbackHook = callback
    rollbackArgument = arg
    return previous
}

export fn sqlite3_update_hook(db: usize, callback: usize, arg: usize) -> usize {
    const previous = updateArgument
    updateHook = callback
    updateArgument = arg
    return previous
}

export fn sqlite3_wal_hook(db: usize, callback: usize, arg: usize) -> usize {
    if db == 0 { return 0 }
    const d = databaseOf(db)
    const previous = d.*.walHookArgument
    d.*.walHook = callback
    d.*.walHookArgument = arg
    return previous
}

export fn sqlite3_wal_autocheckpoint(db: usize, pages: i32) -> i32 { return core.OK }

export fn sqlite3_wal_checkpoint(db: usize, database: usize) -> i32 { return sqlite3_wal_checkpoint_v2(db, database, 0, 0, 0) }

// A checkpoint has nothing to copy (the file has no write-ahead log): the
// log is empty (0, 0) for a connection in journal_mode=WAL, else -1.
export fn sqlite3_wal_checkpoint_v2(db: usize, database: usize, mode: i32, log: usize, checkpointed: usize) -> i32 {
    if db == 0 { return core.MISUSE }
    if mode < 0 || mode > 3 { return core.MISUSE }
    const d = databaseOf(db)
    const wal = d.*.journalMode == pg.JOURNAL_WAL
    if log != 0 { mem.put32(log, if wal { 0 } else { 0xffffffff }) }
    if checkpointed != 0 { mem.put32(checkpointed, if wal { 0 } else { 0xffffffff }) }
    return core.OK
}

// ---------------------------------------------------------------------------
// Memory.

export fn sqlite3_malloc(n: i32) -> usize {
    if n <= 0 { return 0 }
    return c.malloc(@intCast(usize, n))
}

export fn sqlite3_malloc64(n: u64) -> usize {
    if n == 0 { return 0 }
    return c.malloc(@intCast(usize, n))
}

export fn sqlite3_realloc(p: usize, n: i32) -> usize {
    if n <= 0 {
        c.free(p)
        return 0
    }
    return c.realloc(p, @intCast(usize, n))
}

export fn sqlite3_realloc64(p: usize, n: u64) -> usize {
    if n == 0 {
        c.free(p)
        return 0
    }
    return c.realloc(p, @intCast(usize, n))
}

export fn sqlite3_free(p: usize) -> void { c.free(p) }

export fn sqlite3_msize(p: usize) -> u64 {
    if p == 0 { return 0 }
    return @intCast(u64, c.malloc_usable_size(p))
}

export fn sqlite3_memory_used() -> i64 { return 0 }
export fn sqlite3_memory_highwater(resetFlag: i32) -> i64 { return 0 }

export fn sqlite3_randomness(n: i32, p: usize) -> void {
    if n > 0 && p != 0 { sql.os.randomBytes(p, @intCast(usize, n)) }
}

export fn sqlite3_release_memory(bytes: i32) -> i32 { return 0 }

export fn sqlite3_db_release_memory(db: usize) -> i32 {
    if db == 0 { return core.MISUSE }
    const d = databaseOf(db)
    sql.os.enter(&d.*.mutex)
    pg.shrink(&d.*.pager)
    sql.os.leave(&d.*.mutex)
    return core.OK
}

export fn sqlite3_soft_heap_limit64(bytes: i64) -> i64 { return 0 }
export fn sqlite3_hard_heap_limit64(bytes: i64) -> i64 { return 0 }
export fn sqlite3_enable_shared_cache(on: i32) -> i32 { return core.OK }

export fn sqlite3_sleep(ms: i32) -> i32 {
    if ms > 0 { sql.os.sleepMilliseconds(@intCast(i64, ms)) }
    return ms
}

// ---------------------------------------------------------------------------
// About a connection.

export fn sqlite3_get_autocommit(db: usize) -> i32 {
    if db == 0 { return 0 }
    return if databaseOf(db).*.autocommit { 1 } else { 0 }
}

export fn sqlite3_db_name(db: usize, n: i32) -> usize {
    if db == 0 || n != 0 { return 0 }
    return @intFromPtr("main".pointer)
}

export fn sqlite3_db_filename(db: usize, name: usize) -> usize {
    if db == 0 { return 0 }
    const d = databaseOf(db)
    if d.*.pager.memory { return @intFromPtr("".pointer) }
    return d.*.path
}

export fn sqlite3_db_readonly(db: usize, name: usize) -> i32 {
    if db == 0 { return -1 }
    if name != 0 && !mem.same(mem.cText(name), "main") { return -1 }
    return if databaseOf(db).*.readOnly { 1 } else { 0 }
}

export fn sqlite3_txn_state(db: usize, schema: usize) -> i32 {
    if db == 0 { return -1 }
    return @intCast(i32, databaseOf(db).*.pager.transaction)
}

export fn sqlite3_next_stmt(db: usize, statement: usize) -> usize {
    if db == 0 { return 0 }
    return engine.nextStatement(databaseOf(db), statement)
}

const defaultLimits = [_]i32{ 1000000000, 1000000000, 2000, 1000, 500, 250000000, 127, 10, 50000, 32766, 1000, 0 }

export fn sqlite3_limit(db: usize, id: i32, newValue: i32) -> i32 {
    if id < 0 || id > 11 { return -1 }
    return defaultLimits[@intCast(usize, id)]
}

export fn sqlite3_file_control(db: usize, database: usize, op: i32, arg: usize) -> i32 {
    if db == 0 { return core.MISUSE }
    const d = databaseOf(db)
    if op == 1 {
        if arg != 0 { mem.put32(arg, @intCast(u64, d.*.pager.lockLevel)) }
        return core.OK
    }
    if op == 4 {
        if arg != 0 { mem.put32(arg, 0) }
        return core.OK
    }
    if op == 5 || op == 6 || op == 8 || op == 10 || op == 13 { return core.OK }
    if op == 20 {
        if arg != 0 { mem.put32(arg, 0) }
        return core.OK
    }
    if op == 35 {
        if arg != 0 { mem.put32(arg, d.*.pager.changeCounter & 0xffffffff) }
        return core.OK
    }
    return core.NOTFOUND
}

export fn sqlite3_status(op: i32, current: usize, highwater: usize, resetFlag: i32) -> i32 {
    if current != 0 { mem.put32(current, 0) }
    if highwater != 0 { mem.put32(highwater, 0) }
    return core.OK
}

export fn sqlite3_status64(op: i32, current: usize, highwater: usize, resetFlag: i32) -> i32 {
    if current != 0 { mem.put64(current, 0) }
    if highwater != 0 { mem.put64(highwater, 0) }
    return core.OK
}

export fn sqlite3_db_status(db: usize, op: i32, current: usize, highwater: usize, resetFlag: i32) -> i32 {
    if db == 0 { return core.MISUSE }
    if current != 0 { mem.put32(current, 0) }
    if highwater != 0 { mem.put32(highwater, 0) }
    return core.OK
}

// The declared type, collation and constraints of a table's column.
export fn sqlite3_table_column_metadata(db: usize, database: usize, table: usize, column: usize, declaredType: usize, collation: usize, notNull: usize, primaryKey: usize, autoincrement: usize) -> i32 {
    if db == 0 || table == 0 { return core.MISUSE }
    const d = databaseOf(db)
    sql.os.enter(&d.*.mutex)
    // The schema must be read.
    var probe: usize = 0
    var tail: usize = 0
    _ = engine.prepare(d, @intFromPtr("SELECT 1".pointer), 8, &probe, &tail)
    _ = engine.finalize(probe)
    const t = schema.findTable(&d.*.schema, mem.cText(table))
    if t == 0 {
        const rc = core.setError2(d, core.ERROR, "no such table: ", mem.cText(table))
        sql.os.leave(&d.*.mutex)
        return rc
    }
    const tt = schema.table(t)
    var typeName: usize = 0
    var collationName: usize = @intFromPtr("BINARY".pointer)
    var isNotNull = false
    var isKey = false
    var isAuto = false
    if column != 0 {
        const name = mem.cText(column)
        const index = schema.findColumn(tt, name)
        if index < 0 {
            if !schema.isRowidName(name) || tt.*.rowidColumn >= 0 {
                const rc = core.setError2(d, core.ERROR, "no such table column: ", name)
                sql.os.leave(&d.*.mutex)
                return rc
            }
            typeName = @intFromPtr("INTEGER".pointer)
            isKey = true
        } else {
            const col = schema.column(tt, @intCast(usize, index))
            typeName = if col.*.typeLength > 0 { col.*.typeName } else { 0 }
            if col.*.collationLength > 0 { collationName = col.*.collation }
            isNotNull = col.*.notNull
            isKey = col.*.primaryKey
            isAuto = isKey && tt.*.autoincrement && index == tt.*.rowidColumn
        }
    }
    if declaredType != 0 { mem.put64(declaredType, @intCast(u64, typeName)) }
    if collation != 0 { mem.put64(collation, @intCast(u64, collationName)) }
    if notNull != 0 { mem.put32(notNull, if isNotNull { 1 } else { 0 }) }
    if primaryKey != 0 { mem.put32(primaryKey, if isKey { 1 } else { 0 }) }
    if autoincrement != 0 { mem.put32(autoincrement, if isAuto { 1 } else { 0 }) }
    sql.os.leave(&d.*.mutex)
    return core.OK
}

// ---------------------------------------------------------------------------
// sqlite3_exec and sqlite3_get_table.

pub const ExecCallback = fn(usize, i32, usize, usize) -> i32

export fn sqlite3_exec(db: usize, text: usize, callback: usize, arg: usize, errmsg: usize) -> i32 {
    if errmsg != 0 { mem.put64(errmsg, 0) }
    if db == 0 { return core.MISUSE }
    const d = databaseOf(db)
    if text == 0 { return core.OK }
    const length = c.cLength(text)
    var at: usize = 0
    var rc = core.OK
    while at < length {
        var st: usize = 0
        var tail: usize = 0
        rc = engine.prepare(d, text + at, length - at, &st, &tail)
        if rc != core.OK { break }
        at += tail
        if st == 0 { continue }
        const columns = engine.columnCount(st)
        // Column texts and names for the callback: two arrays of
        // pointers, the names after the values.
        const pointers = c.malloc((columns * 2 + 1) * 8)
        var namesGiven = false
        while true {
            rc = engine.step(st)
            if rc == core.ROW {
                if callback != 0 {
                    if !namesGiven {
                        var i: usize = 0
                        while i < columns {
                            const name = engine.columnName(st, i)
                            mem.put64(pointers + (columns + i) * 8, @intCast(u64, c.cCopy(@intFromPtr(name.pointer), name.length)))
                            i += 1
                        }
                        namesGiven = true
                    }
                    var i: usize = 0
                    while i < columns {
                        const v = engine.column(st, i)
                        mem.put64(pointers + i * 8, @intCast(u64, values.textOf(v)))
                        i += 1
                    }
                    const call: ExecCallback = unsafe { @ptrFromInt(ExecCallback, callback) }
                    if call(arg, @intCast(i32, columns), pointers, pointers + columns * 8) != 0 {
                        rc = core.setError(d, core.ABORT, "query aborted")
                        break
                    }
                }
                continue
            }
            if rc == core.DONE { rc = core.OK }
            break
        }
        if namesGiven {
            var i: usize = 0
            while i < columns {
                c.free(@intCast(usize, mem.get64(pointers + (columns + i) * 8)))
                i += 1
            }
        }
        c.free(pointers)
        const code = d.*.errorCode
        const finalized = engine.finalize(st)
        if rc != core.OK {
            if rc != core.ABORT { d.*.errorCode = code }
            if rc == core.ABORT { _ = core.setError(d, core.ABORT, "query aborted") }
            break
        }
        _ = finalized
    }
    if rc != core.OK && errmsg != 0 {
        const message = sqlite3_errmsg(db)
        mem.put64(errmsg, @intCast(u64, c.cCopy(message, c.cLength(message))))
    }
    if rc == core.OK { core.clearError(d) }
    return c.reported(d, rc)
}

// sqlite3_get_table: every row's texts, the names first, in one array.
export fn sqlite3_get_table(db: usize, text: usize, result: usize, rows: usize, columns: usize, errmsg: usize) -> i32 {
    if result != 0 { mem.put64(result, 0) }
    if rows != 0 { mem.put32(rows, 0) }
    if columns != 0 { mem.put32(columns, 0) }
    if errmsg != 0 { mem.put64(errmsg, 0) }
    if db == 0 { return core.MISUSE }
    const d = databaseOf(db)
    var cells: mem.Words = undefined
    mem.initWords(&cells)
    var width: usize = 0
    var count: usize = 0
    const length = c.cLength(text)
    var at: usize = 0
    var rc = core.OK
    while at < length && rc == core.OK {
        var st: usize = 0
        var tail: usize = 0
        rc = engine.prepare(d, text + at, length - at, &st, &tail)
        if rc != core.OK { break }
        at += tail
        if st == 0 { continue }
        const n = engine.columnCount(st)
        while true {
            const s = engine.step(st)
            if s == core.ROW {
                if width == 0 {
                    width = n
                    var i: usize = 0
                    while i < n {
                        const name = engine.columnName(st, i)
                        _ = mem.push(&cells, @intCast(u64, c.cCopy(@intFromPtr(name.pointer), name.length)))
                        i += 1
                    }
                }
                var i: usize = 0
                while i < n {
                    const v = engine.column(st, i)
                    const t = values.textOf(v)
                    _ = mem.push(&cells, @intCast(u64, if t == 0 { 0 } else { c.cCopy(t, c.cLength(t)) }))
                    i += 1
                }
                count += 1
                continue
            }
            if s != core.DONE { rc = s }
            break
        }
        _ = engine.finalize(st)
    }
    if rc != core.OK {
        var i: usize = 0
        while i < cells.length {
            c.free(@intCast(usize, mem.at(&cells, i)))
            i += 1
        }
        mem.freeWords(&cells)
        if errmsg != 0 {
            const message = sqlite3_errmsg(db)
            mem.put64(errmsg, @intCast(u64, c.cCopy(message, c.cLength(message))))
        }
        return c.reported(d, rc)
    }
    // The array: a word before it holds its length (sqlite3_free_table).
    const array = c.malloc((cells.length + 1) * 8)
    mem.put64(array, @intCast(u64, cells.length))
    var i: usize = 0
    while i < cells.length {
        mem.put64(array + 8 + i * 8, mem.at(&cells, i))
        i += 1
    }
    mem.freeWords(&cells)
    if result != 0 { mem.put64(result, @intCast(u64, array + 8)) }
    if rows != 0 { mem.put32(rows, @intCast(u64, count)) }
    if columns != 0 { mem.put32(columns, @intCast(u64, width)) }
    return core.OK
}

export fn sqlite3_free_table(result: usize) -> void {
    if result == 0 { return }
    const array = result - 8
    const n = @intCast(usize, mem.get64(array))
    var i: usize = 0
    while i < n {
        c.free(@intCast(usize, mem.get64(result + i * 8)))
        i += 1
    }
    c.free(array)
}

// ---------------------------------------------------------------------------
// Strings.

export fn sqlite3_stricmp(a: usize, b: usize) -> i32 {
    if a == 0 { return if b == 0 { 0 } else { -1 } }
    if b == 0 { return 1 }
    var i: usize = 0
    while true {
        const x = mem.lower(mem.get8(a + i))
        const y = mem.lower(mem.get8(b + i))
        if x != y { return @intCast(i32, @bitCast(i64, x) - @bitCast(i64, y)) }
        if x == 0 { return 0 }
        i += 1
    }
    return 0
}

export fn sqlite3_strnicmp(a: usize, b: usize, n: i32) -> i32 {
    if a == 0 { return if b == 0 { 0 } else { -1 } }
    if b == 0 { return 1 }
    var i: usize = 0
    while @intCast(i32, i) < n {
        const x = mem.lower(mem.get8(a + i))
        const y = mem.lower(mem.get8(b + i))
        if x != y { return @intCast(i32, @bitCast(i64, x) - @bitCast(i64, y)) }
        if x == 0 { return 0 }
        i += 1
    }
    return 0
}

export fn sqlite3_strglob(pattern: usize, text: usize) -> i32 {
    if pattern == 0 || text == 0 { return 1 }
    return if functions.glob(pattern, c.cLength(pattern), text, c.cLength(text)) { 0 } else { 1 }
}

export fn sqlite3_strlike(pattern: usize, text: usize, escape: u32) -> i32 {
    if pattern == 0 || text == 0 { return 1 }
    const e: i64 = if escape == 0 { -1 } else { @intCast(i64, escape) }
    return if functions.like(pattern, c.cLength(pattern), text, c.cLength(text), e, true) { 0 } else { 1 }
}

export fn sqlite3_keyword_count() -> i32 { return 147 }

export fn sqlite3_keyword_check(word: usize, length: i32) -> i32 {
    if word == 0 || length <= 0 { return 0 }
    return if lexer.isReserved(mem.view(word, @intCast(usize, length))) { 1 } else { 0 }
}
