// Values, functions and collations: sqlite3_value_* (an sqlite3_value is
// a std.sql Value; a number asked for as text keeps its type and its text
// beside it, as SQLite's registers do), sqlite3_value_dup and _free, the
// sqlite3_result_* of an application's function (its sqlite3_context is
// std.sql's Context), sqlite3_create_function and _v2,
// sqlite3_create_collation and _v2, sqlite3_user_data and the aggregate
// and auxiliary data.
const c = @import("./common.mlx")
const sql = @import("std.sql")

const mem = c.mem
const value = c.value
const core = c.core
const engine = c.engine
const numbers = sql.numbers

const Value = value.Value

fn valueOf(address: usize) -> *Value { unsafe { return @ptrFromInt(*Value, address) } }

// A value's text (a number's rendered beside it): NUL-terminated, 0 for
// NULL.
pub fn textOf(v: *Value) -> usize {
    if v.*.kind == value.NULL { return 0 }
    // A blob asked for as text is text from then on (as SQLite's value
    // becomes; a number keeps its type).
    if v.*.kind == value.BLOB { v.*.kind = value.TEXT }
    if v.*.kind == value.TEXT {
        if v.*.data == 0 {
            if !value.room(v, 0) { return 0 }
            mem.put8(v.*.data, 0)
        }
        return v.*.data
    }
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = value.appendNumber(&b, v)
    if !value.room(v, b.length) {
        mem.freeBuffer(&b)
        return 0
    }
    mem.copy(v.*.data, b.data, b.length)
    mem.put8(v.*.data + b.length, 0)
    v.*.length = b.length
    mem.freeBuffer(&b)
    return v.*.data
}

pub fn bytesOf(v: *Value) -> i32 {
    if v.*.kind == value.NULL { return 0 }
    if v.*.kind == value.INTEGER || v.*.kind == value.REAL { _ = textOf(v) }
    return @intCast(i32, v.*.length & 0x7fffffff)
}

pub fn blobOf(v: *Value) -> usize {
    if v.*.kind == value.NULL { return 0 }
    if v.*.kind == value.TEXT || v.*.kind == value.BLOB {
        if v.*.length == 0 { return 0 }
        return v.*.data
    }
    const text = textOf(v)
    if v.*.length == 0 { return 0 }
    return text
}

// UTF-16 of a value's text, kept until the next call (per thread is
// SQLite's; one buffer here, under a lock).
var text16: mem.Buffer = undefined
var text16Ready: bool = false
var text16Word: u32 = 0

pub fn text16Of(v: *Value, units: *usize) -> usize {
    units.* = 0
    const text = textOf(v)
    if text == 0 { return 0 }
    sql.os.lock(&text16Word)
    if !text16Ready {
        mem.initBuffer(&text16)
        text16Ready = true
    }
    text16.length = 0
    units.* = c.utf8ToUtf16(text, v.*.length, &text16)
    const result = text16.data
    sql.os.unlock(&text16Word)
    return result
}

export fn sqlite3_value_blob(v: usize) -> usize {
    if v == 0 { return 0 }
    return blobOf(valueOf(v))
}

export fn sqlite3_value_bytes(v: usize) -> i32 {
    if v == 0 { return 0 }
    return bytesOf(valueOf(v))
}

export fn sqlite3_value_bytes16(v: usize) -> i32 {
    if v == 0 { return 0 }
    var units: usize = 0
    _ = text16Of(valueOf(v), &units)
    return @intCast(i32, units * 2)
}

export fn sqlite3_value_double(v: usize) -> f64 {
    if v == 0 { return 0.0 }
    return value.toReal(valueOf(v))
}

export fn sqlite3_value_int(v: usize) -> i32 {
    if v == 0 { return 0 }
    return @bitCast(i32, @intCast(u32, @bitCast(u64, value.toInt(valueOf(v))) & 0xffffffff))
}

export fn sqlite3_value_int64(v: usize) -> i64 {
    if v == 0 { return 0 }
    return value.toInt(valueOf(v))
}

export fn sqlite3_value_pointer(v: usize, kind: usize) -> usize { return 0 }

export fn sqlite3_value_text(v: usize) -> usize {
    if v == 0 { return 0 }
    return textOf(valueOf(v))
}

export fn sqlite3_value_text16(v: usize) -> usize {
    if v == 0 { return 0 }
    var units: usize = 0
    return text16Of(valueOf(v), &units)
}

export fn sqlite3_value_type(v: usize) -> i32 {
    if v == 0 { return 5 }
    return @intCast(i32, valueOf(v).*.kind)
}

// The type after a TEXT that looks like a number is made one.
export fn sqlite3_value_numeric_type(v: usize) -> i32 {
    if v == 0 { return 5 }
    const x = valueOf(v)
    if x.*.kind == value.TEXT {
        var p: numbers.Parsed = undefined
        numbers.parse(x.*.data, x.*.length, &p)
        if p.kind != numbers.NOT_NUMBER && p.whole {
            if p.kind == numbers.INTEGER && p.fits {
                value.setInt(x, p.integer)
            } else {
                value.setReal(x, p.real)
            }
        }
    }
    return @intCast(i32, x.*.kind)
}

export fn sqlite3_value_nochange(v: usize) -> i32 { return 0 }
export fn sqlite3_value_frombind(v: usize) -> i32 { return 0 }
export fn sqlite3_value_encoding(v: usize) -> i32 { return 1 }

export fn sqlite3_value_subtype(v: usize) -> u32 {
    if v == 0 { return 0 }
    return @intCast(u32, valueOf(v).*.subtype)
}

export fn sqlite3_value_dup(v: usize) -> usize {
    if v == 0 { return 0 }
    c.ready()
    const copy = mem.alloc(@sizeOf(Value))
    if copy == 0 { return 0 }
    value.init(valueOf(copy))
    _ = value.copy(valueOf(copy), valueOf(v))
    return copy
}

export fn sqlite3_value_free(v: usize) -> void {
    if v == 0 { return }
    value.release(valueOf(v))
    mem.free(v)
}

// ---------------------------------------------------------------------------
// Results.

fn contextOf(address: usize) -> *core.Context { return core.contextOf(address) }

fn outOf(context: usize) -> *Value { return valueOf(contextOf(context).*.out) }

pub const Destructor = fn(usize) -> void

// Copies a text or blob given with a destructor, then lets the
// destructor have it (SQLITE_STATIC is 0, SQLITE_TRANSIENT -1: neither).
fn release(address: usize, destructor: usize) -> void {
    if destructor == 0 || destructor == 18446744073709551615 || address == 0 { return }
    const call: Destructor = unsafe { @ptrFromInt(Destructor, destructor) }
    call(address)
}

export fn sqlite3_result_blob(context: usize, data: usize, bytes: i32, destructor: usize) -> void {
    if context == 0 { return }
    const n: usize = if bytes < 0 { 0 } else { @intCast(usize, bytes) }
    if data == 0 {
        _ = value.setZeroBlob(outOf(context), 0)
        if n > 0 { _ = value.setZeroBlob(outOf(context), n) }
    } else {
        _ = value.setBlob(outOf(context), data, n)
    }
    release(data, destructor)
}

export fn sqlite3_result_blob64(context: usize, data: usize, bytes: u64, destructor: usize) -> void {
    if context == 0 { return }
    if bytes > 0x7fffffff {
        sqlite3_result_error_toobig(context)
        release(data, destructor)
        return
    }
    sqlite3_result_blob(context, data, @intCast(i32, bytes), destructor)
}

export fn sqlite3_result_double(context: usize, r: f64) -> void {
    if context != 0 { value.setReal(outOf(context), r) }
}

export fn sqlite3_result_error(context: usize, message: usize, bytes: i32) -> void {
    if context == 0 { return }
    const x = contextOf(context)
    x.*.errorCode = core.ERROR
    x.*.message.length = 0
    if message != 0 { _ = mem.append(&x.*.message, message, c.textLength(message, @intCast(i64, bytes))) }
}

export fn sqlite3_result_error16(context: usize, message: usize, bytes: i32) -> void {
    if context == 0 { return }
    const x = contextOf(context)
    x.*.errorCode = core.ERROR
    x.*.message.length = 0
    if message != 0 { c.utf16ToUtf8(message, c.utf16Units(message, @intCast(i64, bytes)), &x.*.message) }
}

export fn sqlite3_result_error_toobig(context: usize) -> void {
    if context == 0 { return }
    const x = contextOf(context)
    x.*.errorCode = core.TOOBIG
    x.*.message.length = 0
    _ = mem.appendText(&x.*.message, "string or blob too big")
}

export fn sqlite3_result_error_nomem(context: usize) -> void {
    if context == 0 { return }
    const x = contextOf(context)
    x.*.errorCode = core.NOMEM
    x.*.message.length = 0
    _ = mem.appendText(&x.*.message, "out of memory")
}

export fn sqlite3_result_error_code(context: usize, code: i32) -> void {
    if context == 0 { return }
    const x = contextOf(context)
    x.*.errorCode = if code == 0 { core.ERROR } else { code }
    if x.*.message.length == 0 { _ = mem.appendText(&x.*.message, core.errorText(code)) }
}

export fn sqlite3_result_int(context: usize, v: i32) -> void {
    if context != 0 { value.setInt(outOf(context), @intCast(i64, v)) }
}

export fn sqlite3_result_int64(context: usize, v: i64) -> void {
    if context != 0 { value.setInt(outOf(context), v) }
}

export fn sqlite3_result_null(context: usize) -> void {
    if context != 0 { value.setNull(outOf(context)) }
}

export fn sqlite3_result_text(context: usize, text: usize, bytes: i32, destructor: usize) -> void {
    if context == 0 { return }
    if text == 0 {
        value.setNull(outOf(context))
        return
    }
    _ = value.setText(outOf(context), text, c.textLength(text, @intCast(i64, bytes)))
    release(text, destructor)
}

export fn sqlite3_result_text64(context: usize, text: usize, bytes: u64, destructor: usize, encoding: u8) -> void {
    if context == 0 { return }
    if encoding == 2 || encoding == 4 {
        sqlite3_result_text16(context, text, @intCast(i32, bytes & 0x7fffffff), destructor)
        return
    }
    sqlite3_result_text(context, text, @intCast(i32, bytes & 0x7fffffff), destructor)
}

export fn sqlite3_result_text16(context: usize, text: usize, bytes: i32, destructor: usize) -> void {
    if context == 0 { return }
    if text == 0 {
        value.setNull(outOf(context))
        return
    }
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    c.utf16ToUtf8(text, c.utf16Units(text, @intCast(i64, bytes)), &b)
    _ = value.setText(outOf(context), b.data, b.length)
    mem.freeBuffer(&b)
    release(text, destructor)
}

export fn sqlite3_result_value(context: usize, v: usize) -> void {
    if context == 0 { return }
    if v == 0 {
        value.setNull(outOf(context))
        return
    }
    _ = value.copy(outOf(context), valueOf(v))
}

export fn sqlite3_result_zeroblob(context: usize, bytes: i32) -> void {
    if context != 0 { _ = value.setZeroBlob(outOf(context), if bytes < 0 { 0 } else { @intCast(usize, bytes) }) }
}

export fn sqlite3_result_zeroblob64(context: usize, bytes: u64) -> i32 {
    if context == 0 { return core.MISUSE }
    if bytes > 1000000000 {
        sqlite3_result_error_toobig(context)
        return core.TOOBIG
    }
    _ = value.setZeroBlob(outOf(context), @intCast(usize, bytes))
    return core.OK
}

export fn sqlite3_result_subtype(context: usize, subtype: u32) -> void {
    if context != 0 { outOf(context).*.subtype = @intCast(u8, subtype & 255) }
}

export fn sqlite3_user_data(context: usize) -> usize {
    if context == 0 { return 0 }
    const x = contextOf(context)
    if x.*.function == 0 { return 0 }
    return core.functionOf(x.*.function).*.userData
}

export fn sqlite3_context_db_handle(context: usize) -> usize {
    if context == 0 { return 0 }
    return contextOf(context).*.db
}

export fn sqlite3_aggregate_context(context: usize, bytes: i32) -> usize {
    if context == 0 { return 0 }
    const x = contextOf(context)
    if x.*.aggregate == 0 && bytes > 0 {
        x.*.aggregate = mem.alloc(@intCast(usize, bytes))
        x.*.aggregateSize = @intCast(usize, bytes)
    }
    return x.*.aggregate
}

export fn sqlite3_get_auxdata(context: usize, n: i32) -> usize { return 0 }

// Auxiliary data is not kept: it is let go at once.
export fn sqlite3_set_auxdata(context: usize, n: i32, data: usize, destructor: usize) -> void {
    if destructor != 0 && data != 0 {
        const call: Destructor = unsafe { @ptrFromInt(Destructor, destructor) }
        call(data)
    }
}

// ---------------------------------------------------------------------------
// Functions and collations.

fn createFunction(db: usize, name: []const u8, arguments: i32, flags: i32, data: usize, call: usize, step: usize, final: usize, destroy: usize) -> i32 {
    if db == 0 { return core.MISUSE }
    if arguments < -1 || arguments > 127 || name.length == 0 || name.length > 255 { return core.MISUSE }
    if (call != 0 && (step != 0 || final != 0)) || (call == 0 && ((step == 0) != (final == 0))) { return core.MISUSE }
    const d = core.database(db)
    sql.os.enter(&d.*.mutex)
    if d.*.active > 0 {
        const rc = core.setError(d, core.BUSY, "unable to delete/modify user-function due to active statements")
        sql.os.leave(&d.*.mutex)
        return rc
    }
    sql.functions.register(d, name, arguments, call, step, final, data, destroy, (flags & 0x800) != 0)
    sql.os.leave(&d.*.mutex)
    return core.OK
}

export fn sqlite3_create_function(db: usize, name: usize, arguments: i32, flags: i32, data: usize, xFunc: usize, xStep: usize, xFinal: usize) -> i32 {
    if name == 0 { return core.MISUSE }
    return createFunction(db, mem.cText(name), arguments, flags, data, xFunc, xStep, xFinal, 0)
}

export fn sqlite3_create_function_v2(db: usize, name: usize, arguments: i32, flags: i32, data: usize, xFunc: usize, xStep: usize, xFinal: usize, xDestroy: usize) -> i32 {
    if name == 0 { return core.MISUSE }
    return createFunction(db, mem.cText(name), arguments, flags, data, xFunc, xStep, xFinal, xDestroy)
}

export fn sqlite3_create_function16(db: usize, name: usize, arguments: i32, flags: i32, data: usize, xFunc: usize, xStep: usize, xFinal: usize) -> i32 {
    if name == 0 { return core.MISUSE }
    c.ready()
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    c.utf16ToUtf8(name, c.utf16Units(name, -1), &b)
    const rc = createFunction(db, mem.bufferText(&b), arguments, flags, data, xFunc, xStep, xFinal, 0)
    mem.freeBuffer(&b)
    return rc
}

fn createCollation(db: usize, name: usize, encoding: i32, data: usize, compare: usize, destroy: usize) -> i32 {
    if db == 0 || name == 0 { return core.MISUSE }
    const e = encoding & 0xf7
    if e < 1 || e > 5 { return core.MISUSE }
    const d = core.database(db)
    sql.os.enter(&d.*.mutex)
    const rc = engine.createCollation(d, mem.cText(name), data, compare, destroy)
    sql.os.leave(&d.*.mutex)
    return rc
}

export fn sqlite3_create_collation(db: usize, name: usize, encoding: i32, data: usize, compare: usize) -> i32 {
    return createCollation(db, name, encoding, data, compare, 0)
}

export fn sqlite3_create_collation_v2(db: usize, name: usize, encoding: i32, data: usize, compare: usize, destroy: usize) -> i32 {
    return createCollation(db, name, encoding, data, compare, destroy)
}
