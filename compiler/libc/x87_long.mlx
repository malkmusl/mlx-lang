    if index == 18 { return "exp2l" }
    if index == 19 { return "expl" }
    if index == 20 { return "logl" }
    if index == 21 { return "log2l" }
    if index == 22 { return "log10l" }
    if index == 23 { return "powl" }
    if index == 24 { return "sinl" }
    if index == 25 { return "cosl" }
    if index == 26 { return "tanl" }
    if index == 27 { return "atanl" }
    if index == 28 { return "atan2l" }
    if index == 29 { return "asinl" }
    if index == 30 { return "acosl" }
    if index == 31 { return "sinhl" }
    if index == 32 { return "coshl" }
    if index == 33 { return "tanhl" }
    if index == 34 { return "fmodl" }
    if index == 35 { return "remainderl" }
    if index == 36 { return "ldexpl" }
    if index == 37 { return "scalbnl" }
    if index == 38 { return "scalblnl" }
    if index == 39 { return "frexpl" }
    if index == 40 { return "modfl" }
    return ""
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}
