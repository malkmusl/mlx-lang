}

// The functions' names in order, for the symbol entries: the n-th.
pub fn nameAt(index: usize) -> []const u8 {
    if index == 0 { return "floorl" }
    if index == 1 { return "ceill" }
    if index == 2 { return "truncl" }
    if index == 3 { return "rintl" }
    if index == 4 { return "nearbyintl" }
    if index == 5 { return "roundl" }
    if index == 6 { return "lrintl" }
    if index == 7 { return "llrintl" }
    if index == 8 { return "lroundl" }
