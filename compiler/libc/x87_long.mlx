// The offset and size of the function `name`, (0, 0) for none.
pub fn find(name: []const u8) -> (usize, usize) {
    if same(name, "floorl") { return -> (33, 10) }
    if same(name, "ceill") { return -> (43, 10) }
    if same(name, "truncl") { return -> (53, 10) }
    if same(name, "rintl") { return -> (63, 7) }
    if same(name, "nearbyintl") { return -> (70, 7) }
    if same(name, "roundl") { return -> (77, 43) }
    if same(name, "lrintl") { return -> (125, 14) }
    if same(name, "llrintl") { return -> (139, 2) }
    if same(name, "lroundl") { return -> (141, 15) }
    if same(name, "llroundl") { return -> (156, 2) }
    if same(name, "fabsl") { return -> (206, 7) }
    if same(name, "copysignl") { return -> (213, 24) }
    if same(name, "fminl") { return -> (237, 15) }
    if same(name, "fmaxl") { return -> (252, 15) }
    if same(name, "fdiml") { return -> (267, 15) }
    if same(name, "sqrtl") { return -> (289, 7) }
    if same(name, "hypotl") { return -> (296, 17) }
    if same(name, "cbrtl") { return -> (313, 65) }
    if same(name, "exp2l") { return -> (445, 6) }
    if same(name, "expl") { return -> (451, 10) }
    if same(name, "logl") { return -> (461, 9) }
    if same(name, "log2l") { return -> (470, 9) }
    if same(name, "log10l") { return -> (479, 9) }
    if same(name, "powl") { return -> (488, 17) }
    if same(name, "sinl") { return -> (615, 7) }
    if same(name, "cosl") { return -> (622, 7) }
    if same(name, "tanl") { return -> (629, 9) }
    if same(name, "atanl") { return -> (638, 9) }
    if same(name, "atan2l") { return -> (647, 11) }
    if same(name, "asinl") { return -> (658, 17) }
    if same(name, "acosl") { return -> (675, 19) }
    if same(name, "sinhl") { return -> (703, 22) }
    if same(name, "coshl") { return -> (725, 22) }
    if same(name, "tanhl") { return -> (747, 24) }
    if same(name, "fmodl") { return -> (771, 8) }
    if same(name, "remainderl") { return -> (791, 8) }
