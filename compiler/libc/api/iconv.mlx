// iconv.h
// mlxlibc: converting text from one charset to another (compiler/libc/
// iconv.mlx): the Unicode forms, ISO-8859-1, US-ASCII and the single-byte
// charsets of std.unicode.charmaps, by glibc's names and the others';
// `//TRANSLIT` and `//IGNORE` after the target's name as in glibc.
const c_system_headers = "stddef.h"

// (Mlx names of C types: C has them as they are.)
pub const c_char = u8
pub const c_int = i32

// A conversion's descriptor, (iconv_t) -1 when iconv_open fails.
pub const iconv_t = *anyopaque

pub extern("c") fn iconv_open(tocode: [*]const c_char, fromcode: [*]const c_char) -> iconv_t
pub extern("c") fn iconv(cd: iconv_t, inbuf: ?*?[*]c_char, inbytesleft: ?*usize, outbuf: ?*?[*]c_char, outbytesleft: ?*usize) -> usize
pub extern("c") fn iconv_close(cd: iconv_t) -> c_int
