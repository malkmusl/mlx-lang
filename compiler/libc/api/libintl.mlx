// libintl.h
// mlxlibc: messages in the user's language (gettext). There are no
// message catalogs: each function returns the message it is given (the
// singular or the plural by the count), as GNU gettext does when no
// catalog has the message; the text domain and its directory and
// codeset are kept and answered, but nothing is read from them.
const c_system_headers = "locale.h"

// (Mlx names of C types: C has them as they are.)
pub const c_char = u8
pub const c_int = i32
pub const c_ulong = u64

pub extern("c") fn gettext(msgid: [*]const c_char) -> [*]c_char
pub extern("c") fn dgettext(domainname: ?[*]const c_char, msgid: [*]const c_char) -> [*]c_char
pub extern("c") fn dcgettext(domainname: ?[*]const c_char, msgid: [*]const c_char, category: c_int) -> [*]c_char
pub extern("c") fn ngettext(msgid1: [*]const c_char, msgid2: [*]const c_char, n: c_ulong) -> [*]c_char
pub extern("c") fn dngettext(domainname: ?[*]const c_char, msgid1: [*]const c_char, msgid2: [*]const c_char, n: c_ulong) -> [*]c_char
pub extern("c") fn dcngettext(domainname: ?[*]const c_char, msgid1: [*]const c_char, msgid2: [*]const c_char, n: c_ulong, category: c_int) -> [*]c_char
pub extern("c") fn textdomain(domainname: ?[*]const c_char) -> ?[*]c_char
pub extern("c") fn bindtextdomain(domainname: [*]const c_char, dirname: ?[*]const c_char) -> ?[*]c_char
pub extern("c") fn bind_textdomain_codeset(domainname: [*]const c_char, codeset: ?[*]const c_char) -> ?[*]c_char
