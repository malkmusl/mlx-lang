// webp/demux.h: the demuxer and the animation decoder, over
// std.webp.demux and std.webp.anim (demux/demux.c and
// demux/anim_decode.c of libwebp 1.3.2). WebPIterator and
// WebPChunkIterator are std.webp.demux's Iterator and ChunkIterator,
// laid out alike.
const io = @import("std.webp.io")
const demux = @import("std.webp.demux")
const anim = @import("std.webp.anim")
const c = @import("./common.mlx")

const DEMUX_ABI_VERSION: i32 = 0x0107

inline fn truth(value: bool) -> i32 {
    if value { return 1 }
    return 0
}

inline fn iteratorAt(address: usize) -> *demux.Iterator { return unsafe { @ptrFromInt(*demux.Iterator, address) } }
inline fn chunkIteratorAt(address: usize) -> *demux.ChunkIterator { return unsafe { @ptrFromInt(*demux.ChunkIterator, address) } }

export fn WebPGetDemuxVersion() -> i32 { return (1 << 16) | (3 << 8) | 2 }

// WebPDemuxInternal: DATA a WebPData (the bytes and their size).
export fn WebPDemuxInternal(data: usize, allowPartial: i32, state: usize, version: i32) -> usize {
    if state != 0 { io.putI32(state, @intCast(i64, demux.PARSE_ERROR_STATE)) }
    if c.incompatible(version, DEMUX_ABI_VERSION) { return 0 }
    if data == 0 { return 0 }
    const bytes = @intCast(usize, io.get64(data))
    const size = @intCast(usize, io.get64(data + 8))
    if bytes == 0 || size == 0 { return 0 }
    var result: i32 = 0
    const d = demux.create(bytes, size, allowPartial != 0, &result, c.allocator())
    if state != 0 { io.putI32(state, @intCast(i64, result)) }
    return d
}

export fn WebPDemuxDelete(dmux: usize) -> void { demux.delete(dmux) }

export fn WebPDemuxGetI(dmux: usize, feature: i32) -> u32 {
    if dmux == 0 { return 0 }
    return @intCast(u32, demux.getI(demux.demuxerAt(dmux), feature) & 0xffffffff)
}

export fn WebPDemuxGetFrame(dmux: usize, frame: i32, iter: usize) -> i32 {
    if iter == 0 { return 0 }
    return truth(demux.getFrame(dmux, @intCast(i64, frame), iteratorAt(iter)))
}

export fn WebPDemuxNextFrame(iter: usize) -> i32 {
    if iter == 0 { return 0 }
    return truth(demux.nextFrame(iteratorAt(iter)))
}

export fn WebPDemuxPrevFrame(iter: usize) -> i32 {
    if iter == 0 { return 0 }
    return truth(demux.prevFrame(iteratorAt(iter)))
}

export fn WebPDemuxReleaseIterator(iter: usize) -> void {}

export fn WebPDemuxGetChunk(dmux: usize, fourcc: usize, chunk: i32, iter: usize) -> i32 {
    if iter == 0 { return 0 }
    return truth(demux.getChunk(dmux, fourcc, @intCast(i64, chunk), chunkIteratorAt(iter)))
}

export fn WebPDemuxNextChunk(iter: usize) -> i32 {
    if iter == 0 { return 0 }
    return truth(demux.nextChunk(chunkIteratorAt(iter)))
}

export fn WebPDemuxPrevChunk(iter: usize) -> i32 {
    if iter == 0 { return 0 }
    return truth(demux.prevChunk(chunkIteratorAt(iter)))
}

export fn WebPDemuxReleaseChunkIterator(iter: usize) -> void {}

// ---------------------------------------------------------------------------
// The animation decoder

// WebPAnimDecoderOptions: the colour mode, threads, padding.
export fn WebPAnimDecoderOptionsInitInternal(options: usize, version: i32) -> i32 {
    if options == 0 || c.incompatible(version, DEMUX_ABI_VERSION) { return 0 }
    io.putI32(options, @intCast(i64, io.MODE_RGBA))
    io.putI32(options + 4, 0)
    return 1
}

export fn WebPAnimDecoderNewInternal(data: usize, options: usize, version: i32) -> usize {
    if data == 0 || c.incompatible(version, DEMUX_ABI_VERSION) { return 0 }
    var mode = io.MODE_RGBA
    if options != 0 { mode = @intCast(i32, io.getI32(options)) }
    return anim.create(@intCast(usize, io.get64(data)), @intCast(usize, io.get64(data + 8)), mode, c.allocator())
}

// WebPAnimInfo: the canvas's size, the loop count, the background, the
// number of frames.
export fn WebPAnimDecoderGetInfo(dec: usize, info: usize) -> i32 {
    if dec == 0 || info == 0 { return 0 }
    const d = anim.decoderAt(dec)
    io.zero(info, 36)
    io.put32(info, d.*.canvasWidth)
    io.put32(info + 4, d.*.canvasHeight)
    io.put32(info + 8, d.*.loopCount)
    io.put32(info + 12, d.*.bgcolor)
    io.put32(info + 16, d.*.frameCount)
    return 1
}

export fn WebPAnimDecoderGetNext(dec: usize, buf: usize, timestamp: usize) -> i32 {
    if dec == 0 || buf == 0 || timestamp == 0 { return 0 }
    var canvas: usize = 0
    var time: i64 = 0
    if !anim.getNext(anim.decoderAt(dec), &canvas, &time) { return 0 }
    io.put64(buf, @intCast(u64, canvas))
    io.putI32(timestamp, time)
    return 1
}

export fn WebPAnimDecoderHasMoreFrames(dec: usize) -> i32 {
    if dec == 0 { return 0 }
    return truth(anim.hasMoreFrames(anim.decoderAt(dec)))
}

export fn WebPAnimDecoderReset(dec: usize) -> void {
    if dec != 0 { anim.reset(anim.decoderAt(dec)) }
}

export fn WebPAnimDecoderGetDemuxer(dec: usize) -> usize {
    if dec == 0 { return 0 }
    return anim.decoderAt(dec).*.demuxer
}

export fn WebPAnimDecoderDelete(dec: usize) -> void { anim.delete(dec) }
