// webp/encode.h
// mlx-libwebp: libwebp's encoding API (libwebp 1.3.2, encoder ABI
// 0x020f): the configuration and its presets, the picture (imported from
// RGB(A), BGR(A), RGBX, BGRX, or planes of the caller's), the memory
// writer, WebPEncode and the one-call encoders. The encoder is lossless
// whatever the configuration asks (std.webp.encode: the exact pixels in
// a VP8L file); the lossy settings are checked and kept, not used.
const c_function_pointers = true
const types = @import("./types.mlx")

const c_int = types.c_int
const c_tokens = types.c_tokens

pub const WEBP_WEBP_ENCODE_H_: c_tokens = ""
pub const WEBP_ENCODER_ABI_VERSION: c_int = 0x020f

// The encoder's version: 1.3.2.
pub extern("c") fn WebPGetEncoderVersion() -> c_int

// The picture encoded into memory of the library's (*OUTPUT, freed by
// WebPFree); its size, 0 on error.
pub extern("c") fn WebPEncodeRGB(rgb: *const u8, width: c_int, height: c_int, stride: c_int, quality_factor: f32, output: **u8) -> usize
pub extern("c") fn WebPEncodeBGR(bgr: *const u8, width: c_int, height: c_int, stride: c_int, quality_factor: f32, output: **u8) -> usize
pub extern("c") fn WebPEncodeRGBA(rgba: *const u8, width: c_int, height: c_int, stride: c_int, quality_factor: f32, output: **u8) -> usize
pub extern("c") fn WebPEncodeBGRA(bgra: *const u8, width: c_int, height: c_int, stride: c_int, quality_factor: f32, output: **u8) -> usize
pub extern("c") fn WebPEncodeLosslessRGB(rgb: *const u8, width: c_int, height: c_int, stride: c_int, output: **u8) -> usize
pub extern("c") fn WebPEncodeLosslessBGR(bgr: *const u8, width: c_int, height: c_int, stride: c_int, output: **u8) -> usize
pub extern("c") fn WebPEncodeLosslessRGBA(rgba: *const u8, width: c_int, height: c_int, stride: c_int, output: **u8) -> usize
pub extern("c") fn WebPEncodeLosslessBGRA(bgra: *const u8, width: c_int, height: c_int, stride: c_int, output: **u8) -> usize

pub const WebPImageHint = enum(c_int) {
    WEBP_HINT_DEFAULT = 0,
    WEBP_HINT_PICTURE = 1,
    WEBP_HINT_PHOTO = 2,
    WEBP_HINT_GRAPH = 3,
    WEBP_HINT_LAST = 4,
}

pub const WebPConfig = struct {
    lossless: c_int
    quality: f32
    method: c_int
    image_hint: WebPImageHint
    target_size: c_int
    target_PSNR: f32
    segments: c_int
    sns_strength: c_int
    filter_strength: c_int
    filter_sharpness: c_int
    filter_type: c_int
    autofilter: c_int
    alpha_compression: c_int
    alpha_filtering: c_int
    alpha_quality: c_int
    pass: c_int
    show_compressed: c_int
    preprocessing: c_int
    partitions: c_int
    partition_limit: c_int
    emulate_jpeg_size: c_int
    thread_level: c_int
    low_memory: c_int
    near_lossless: c_int
    exact: c_int
    use_delta_palette: c_int
    use_sharp_yuv: c_int
    qmin: c_int
    qmax: c_int
}

pub const WebPPreset = enum(c_int) {
    WEBP_PRESET_DEFAULT = 0,
    WEBP_PRESET_PICTURE = 1,
    WEBP_PRESET_PHOTO = 2,
    WEBP_PRESET_DRAWING = 3,
    WEBP_PRESET_ICON = 4,
    WEBP_PRESET_TEXT = 5,
}

pub extern("c") fn WebPConfigInitInternal(config: *WebPConfig, preset: WebPPreset, quality: f32, version: c_int) -> c_int

pub fn WebPConfigInit(config: *WebPConfig) -> c_int {
    return WebPConfigInitInternal(config, WEBP_PRESET_DEFAULT, 75.0, WEBP_ENCODER_ABI_VERSION)
}

pub fn WebPConfigPreset(config: *WebPConfig, preset: WebPPreset, quality: f32) -> c_int {
    return WebPConfigInitInternal(config, preset, quality, WEBP_ENCODER_ABI_VERSION)
}

pub extern("c") fn WebPConfigLosslessPreset(config: *WebPConfig, level: c_int) -> c_int
pub extern("c") fn WebPValidateConfig(config: *const WebPConfig) -> c_int

pub const WebPAuxStats = struct {
    coded_size: c_int
    PSNR: [5]f32
    block_count: [3]c_int
    header_bytes: [2]c_int
    residual_bytes: [3][4]c_int
    segment_size: [4]c_int
    segment_quant: [4]c_int
    segment_level: [4]c_int
    alpha_data_size: c_int
    layer_data_size: c_int
    lossless_features: u32
    histogram_bits: c_int
    transform_bits: c_int
    cache_bits: c_int
    palette_size: c_int
    lossless_size: c_int
    lossless_hdr_size: c_int
    lossless_data_size: c_int
    pad: [2]u32
}

// Where the encoded bytes go, as they come.
pub const WebPWriterFunction = fn(data: *const u8, data_size: usize, picture: *const WebPPicture) -> c_int

// The writer of encoded bytes into growing memory.
pub const WebPMemoryWriter = struct {
    mem: *u8
    size: usize
    max_size: usize
    pad: [1]u32
}

pub extern("c") fn WebPMemoryWriterInit(writer: *WebPMemoryWriter) -> void
pub extern("c") fn WebPMemoryWriterClear(writer: *WebPMemoryWriter) -> void
pub extern("c") fn WebPMemoryWrite(data: *const u8, data_size: usize, picture: *const WebPPicture) -> c_int

pub const WebPProgressHook = fn(percent: c_int, picture: *const WebPPicture) -> c_int

pub const WebPEncCSP = enum(c_int) {
    WEBP_YUV420 = 0,
    WEBP_YUV420A = 4,
    WEBP_CSP_UV_MASK = 3,
    WEBP_CSP_ALPHA_BIT = 4,
}

pub const WebPEncodingError = enum(c_int) {
    VP8_ENC_OK = 0,
    VP8_ENC_ERROR_OUT_OF_MEMORY = 1,
    VP8_ENC_ERROR_BITSTREAM_OUT_OF_MEMORY = 2,
    VP8_ENC_ERROR_NULL_PARAMETER = 3,
    VP8_ENC_ERROR_INVALID_CONFIGURATION = 4,
    VP8_ENC_ERROR_BAD_DIMENSION = 5,
    VP8_ENC_ERROR_PARTITION0_OVERFLOW = 6,
    VP8_ENC_ERROR_PARTITION_OVERFLOW = 7,
    VP8_ENC_ERROR_BAD_WRITE = 8,
    VP8_ENC_ERROR_FILE_TOO_BIG = 9,
    VP8_ENC_ERROR_USER_ABORT = 10,
    VP8_ENC_ERROR_LAST = 11,
}

pub const WEBP_MAX_DIMENSION: c_int = 16383

// The picture: ARGB words (use_argb) or YUV(A) planes, where the encoded
// bytes go, the encoder's report.
pub const WebPPicture = struct {
    use_argb: c_int
    colorspace: WebPEncCSP
    width: c_int
    height: c_int
    y: *u8
    u: *u8
    v: *u8
    y_stride: c_int
    uv_stride: c_int
    a: *u8
    a_stride: c_int
    pad1: [2]u32
    argb: *u32
    argb_stride: c_int
    pad2: [3]u32
    writer: WebPWriterFunction
    custom_ptr: *anyopaque
    extra_info_type: c_int
    extra_info: *u8
    stats: *WebPAuxStats
    error_code: WebPEncodingError
    progress_hook: WebPProgressHook
    user_data: *anyopaque
    pad3: [3]u32
    pad4: *u8
    pad5: *u8
    pad6: [8]u32
    memory_: *anyopaque
    memory_argb_: *anyopaque
    pad7: [2]*anyopaque
}

pub extern("c") fn WebPPictureInitInternal(picture: *WebPPicture, version: c_int) -> c_int

pub fn WebPPictureInit(picture: *WebPPicture) -> c_int {
    return WebPPictureInitInternal(picture, WEBP_ENCODER_ABI_VERSION)
}

pub extern("c") fn WebPPictureAlloc(picture: *WebPPicture) -> c_int
pub extern("c") fn WebPPictureFree(picture: *WebPPicture) -> void
pub extern("c") fn WebPPictureCopy(src: *const WebPPicture, dst: *WebPPicture) -> c_int
pub extern("c") fn WebPPlaneDistortion(src: *const u8, src_stride: usize, reference: *const u8, ref_stride: usize, width: c_int, height: c_int, x_step: usize, metric: c_int, distortion: *f32, result: *f32) -> c_int
pub extern("c") fn WebPPictureDistortion(src: *const WebPPicture, reference: *const WebPPicture, metric_type: c_int, result: *f32) -> c_int
pub extern("c") fn WebPPictureCrop(picture: *WebPPicture, left: c_int, top: c_int, width: c_int, height: c_int) -> c_int
pub extern("c") fn WebPPictureView(src: *const WebPPicture, left: c_int, top: c_int, width: c_int, height: c_int, dst: *WebPPicture) -> c_int
pub extern("c") fn WebPPictureIsView(picture: *const WebPPicture) -> c_int
pub extern("c") fn WebPPictureRescale(picture: *WebPPicture, width: c_int, height: c_int) -> c_int
pub extern("c") fn WebPPictureImportRGB(picture: *WebPPicture, rgb: *const u8, rgb_stride: c_int) -> c_int
pub extern("c") fn WebPPictureImportRGBA(picture: *WebPPicture, rgba: *const u8, rgba_stride: c_int) -> c_int
pub extern("c") fn WebPPictureImportRGBX(picture: *WebPPicture, rgbx: *const u8, rgbx_stride: c_int) -> c_int
pub extern("c") fn WebPPictureImportBGR(picture: *WebPPicture, bgr: *const u8, bgr_stride: c_int) -> c_int
pub extern("c") fn WebPPictureImportBGRA(picture: *WebPPicture, bgra: *const u8, bgra_stride: c_int) -> c_int
pub extern("c") fn WebPPictureImportBGRX(picture: *WebPPicture, bgrx: *const u8, bgrx_stride: c_int) -> c_int
pub extern("c") fn WebPPictureARGBToYUVA(picture: *WebPPicture, colorspace: WebPEncCSP) -> c_int
pub extern("c") fn WebPPictureARGBToYUVADithered(picture: *WebPPicture, colorspace: WebPEncCSP, dithering: f32) -> c_int
pub extern("c") fn WebPPictureSharpARGBToYUVA(picture: *WebPPicture) -> c_int
pub extern("c") fn WebPPictureSmartARGBToYUVA(picture: *WebPPicture) -> c_int
pub extern("c") fn WebPPictureYUVAToARGB(picture: *WebPPicture) -> c_int
pub extern("c") fn WebPCleanupTransparentArea(picture: *WebPPicture) -> void
pub extern("c") fn WebPPictureHasTransparency(picture: *const WebPPicture) -> c_int
pub extern("c") fn WebPBlendAlpha(picture: *WebPPicture, background_rgb: u32) -> void

// The picture encoded as CONFIG asks, its bytes to the picture's writer;
// 0 on error (picture->error_code says which).
pub extern("c") fn WebPEncode(config: *const WebPConfig, picture: *WebPPicture) -> c_int
