// webp/decode.h
// mlx-libwebp: libwebp's decoding API (libwebp 1.3.2, decoder ABI
// 0x0209), implemented in Mlx by libmlxwebp.so (compiler/libc/webp, over
// std.webp): the simple decoders (WebPDecodeRGBA and its kin, into memory
// of the library's or the caller's), the advanced one (WebPDecode with a
// WebPDecoderConfig: cropping, flipping, the plain upsampler, no loop
// filter), and the incremental decoder WebKit drives (WebPINewDecoder,
// WebPIUpdate, WebPIDecGetRGB). Scaling (use_scaling) answers
// VP8_STATUS_INVALID_PARAM; dithering is not done.
const types = @import("./types.mlx")

const c_int = types.c_int
const c_tokens = types.c_tokens

pub const WEBP_WEBP_DECODE_H_: c_tokens = ""
pub const WEBP_DECODER_ABI_VERSION: c_int = 0x0209

// The decoder's version: 1.3.2 as (1 << 16) | (3 << 8) | 2.
pub extern("c") fn WebPGetDecoderVersion() -> c_int
// The picture's size, without decoding it; 0 when DATA is no WebP.
pub extern("c") fn WebPGetInfo(data: *const u8, data_size: usize, width: *c_int, height: *c_int) -> c_int

// The picture decoded into memory of the library's (freed by WebPFree),
// its size into WIDTH and HEIGHT; NULL on error.
pub extern("c") fn WebPDecodeRGBA(data: *const u8, data_size: usize, width: *c_int, height: *c_int) -> *u8
pub extern("c") fn WebPDecodeARGB(data: *const u8, data_size: usize, width: *c_int, height: *c_int) -> *u8
pub extern("c") fn WebPDecodeBGRA(data: *const u8, data_size: usize, width: *c_int, height: *c_int) -> *u8
pub extern("c") fn WebPDecodeRGB(data: *const u8, data_size: usize, width: *c_int, height: *c_int) -> *u8
pub extern("c") fn WebPDecodeBGR(data: *const u8, data_size: usize, width: *c_int, height: *c_int) -> *u8
// Y, then U and V (half the size both ways) in the same block.
pub extern("c") fn WebPDecodeYUV(data: *const u8, data_size: usize, width: *c_int, height: *c_int, u: **u8, v: **u8, stride: *c_int, uv_stride: *c_int) -> *u8

// The picture decoded into the caller's memory; OUTPUT_BUFFER, or NULL
// on error (the memory too small among them).
pub extern("c") fn WebPDecodeRGBAInto(data: *const u8, data_size: usize, output_buffer: *u8, output_buffer_size: usize, output_stride: c_int) -> *u8
pub extern("c") fn WebPDecodeARGBInto(data: *const u8, data_size: usize, output_buffer: *u8, output_buffer_size: usize, output_stride: c_int) -> *u8
pub extern("c") fn WebPDecodeBGRAInto(data: *const u8, data_size: usize, output_buffer: *u8, output_buffer_size: usize, output_stride: c_int) -> *u8
pub extern("c") fn WebPDecodeRGBInto(data: *const u8, data_size: usize, output_buffer: *u8, output_buffer_size: usize, output_stride: c_int) -> *u8
pub extern("c") fn WebPDecodeBGRInto(data: *const u8, data_size: usize, output_buffer: *u8, output_buffer_size: usize, output_stride: c_int) -> *u8
pub extern("c") fn WebPDecodeYUVInto(data: *const u8, data_size: usize, luma: *u8, luma_size: usize, luma_stride: c_int, u: *u8, u_size: usize, u_stride: c_int, v: *u8, v_size: usize, v_stride: c_int) -> *u8

// The output colour spaces: RGB orders with and without alpha
// (premultiplied: rgbA, bgrA, Argb, rgbA_4444), 16-bit ones, YUV 4:2:0.
pub const WEBP_CSP_MODE = enum(c_int) {
    MODE_RGB = 0,
    MODE_RGBA = 1,
    MODE_BGR = 2,
    MODE_BGRA = 3,
    MODE_ARGB = 4,
    MODE_RGBA_4444 = 5,
    MODE_RGB_565 = 6,
    MODE_rgbA = 7,
    MODE_bgrA = 8,
    MODE_Argb = 9,
    MODE_rgbA_4444 = 10,
    MODE_YUV = 11,
    MODE_YUVA = 12,
    MODE_LAST = 13,
}

pub fn WebPIsPremultipliedMode(mode: WEBP_CSP_MODE) -> c_int {
    return @intFromBool(mode == MODE_rgbA || mode == MODE_bgrA || mode == MODE_Argb || mode == MODE_rgbA_4444)
}

pub fn WebPIsAlphaMode(mode: WEBP_CSP_MODE) -> c_int {
    return @intFromBool(mode == MODE_RGBA || mode == MODE_BGRA || mode == MODE_ARGB || mode == MODE_RGBA_4444 || mode == MODE_YUVA || WebPIsPremultipliedMode(mode) != 0)
}

pub fn WebPIsRGBMode(mode: WEBP_CSP_MODE) -> c_int {
    return @intFromBool(mode < MODE_YUV)
}

// An RGB output: the rows, their stride, the memory's size.
pub const WebPRGBABuffer = struct {
    rgba: *u8
    stride: c_int
    size: usize
}

// A YUV output: the planes (U and V half the size both ways), their
// strides and sizes.
pub const WebPYUVABuffer = struct {
    y: *u8
    u: *u8
    v: *u8
    a: *u8
    y_stride: c_int
    u_stride: c_int
    v_stride: c_int
    a_stride: c_int
    y_size: usize
    u_size: usize
    v_size: usize
    a_size: usize
}

// The output: its colour space and size, whether its memory is the
// caller's, and where the pixels go.
pub const WebPDecBuffer = struct {
    colorspace: WEBP_CSP_MODE
    width: c_int
    height: c_int
    is_external_memory: c_int
    u: union {
        RGBA: WebPRGBABuffer
        YUVA: WebPYUVABuffer
    }
    pad: [4]u32
    private_memory: *u8
}

pub extern("c") fn WebPInitDecBufferInternal(buffer: *WebPDecBuffer, version: c_int) -> c_int

pub fn WebPInitDecBuffer(buffer: *WebPDecBuffer) -> c_int {
    return WebPInitDecBufferInternal(buffer, WEBP_DECODER_ABI_VERSION)
}

// Frees the memory the library allocated for BUFFER.
pub extern("c") fn WebPFreeDecBuffer(buffer: *WebPDecBuffer) -> void

pub const VP8StatusCode = enum(c_int) {
    VP8_STATUS_OK = 0,
    VP8_STATUS_OUT_OF_MEMORY = 1,
    VP8_STATUS_INVALID_PARAM = 2,
    VP8_STATUS_BITSTREAM_ERROR = 3,
    VP8_STATUS_UNSUPPORTED_FEATURE = 4,
    VP8_STATUS_SUSPENDED = 5,
    VP8_STATUS_USER_ABORT = 6,
    VP8_STATUS_NOT_ENOUGH_DATA = 7,
}

// The incremental decoder.
pub const WebPIDecoder = struct {}

// A decoder into OUTPUT_BUFFER (NULL: memory of its own, RGB).
pub extern("c") fn WebPINewDecoder(output_buffer: *WebPDecBuffer) -> *WebPIDecoder
pub extern("c") fn WebPINewRGB(csp: WEBP_CSP_MODE, output_buffer: *u8, output_buffer_size: usize, output_stride: c_int) -> *WebPIDecoder
pub extern("c") fn WebPINewYUVA(luma: *u8, luma_size: usize, luma_stride: c_int, u: *u8, u_size: usize, u_stride: c_int, v: *u8, v_size: usize, v_stride: c_int, a: *u8, a_size: usize, a_stride: c_int) -> *WebPIDecoder
pub extern("c") fn WebPINewYUV(luma: *u8, luma_size: usize, luma_stride: c_int, u: *u8, u_size: usize, u_stride: c_int, v: *u8, v_size: usize, v_stride: c_int) -> *WebPIDecoder
pub extern("c") fn WebPIDelete(idec: *WebPIDecoder) -> void
// DATA added to what the decoder keeps (a copy).
pub extern("c") fn WebPIAppend(idec: *WebPIDecoder, data: *const u8, data_size: usize) -> VP8StatusCode
// DATA all the data so far (the caller's, used in place).
pub extern("c") fn WebPIUpdate(idec: *WebPIDecoder, data: *const u8, data_size: usize) -> VP8StatusCode
// The RGB output so far: LAST_Y rows done.
pub extern("c") fn WebPIDecGetRGB(idec: *const WebPIDecoder, last_y: *c_int, width: *c_int, height: *c_int, stride: *c_int) -> *u8
pub extern("c") fn WebPIDecGetYUVA(idec: *const WebPIDecoder, last_y: *c_int, u: **u8, v: **u8, a: **u8, width: *c_int, height: *c_int, stride: *c_int, uv_stride: *c_int, a_stride: *c_int) -> *u8

pub fn WebPIDecGetYUV(idec: *const WebPIDecoder, last_y: *c_int, u: **u8, v: **u8, width: *c_int, height: *c_int, stride: *c_int, uv_stride: *c_int) -> *u8 {
    return WebPIDecGetYUVA(idec, last_y, u, v, null, width, height, stride, uv_stride, null)
}

pub extern("c") fn WebPIDecodedArea(idec: *const WebPIDecoder, left: *c_int, top: *c_int, width: *c_int, height: *c_int) -> *const WebPDecBuffer

// What a file holds: the size, alpha, animation, the format (0 mixed,
// 1 lossy, 2 lossless).
pub const WebPBitstreamFeatures = struct {
    width: c_int
    height: c_int
    has_alpha: c_int
    has_animation: c_int
    format: c_int
    pad: [5]u32
}

pub extern("c") fn WebPGetFeaturesInternal(data: *const u8, data_size: usize, features: *WebPBitstreamFeatures, version: c_int) -> VP8StatusCode

pub fn WebPGetFeatures(data: *const u8, data_size: usize, features: *WebPBitstreamFeatures) -> VP8StatusCode {
    return WebPGetFeaturesInternal(data, data_size, features, WEBP_DECODER_ABI_VERSION)
}

pub const WebPDecoderOptions = struct {
    bypass_filtering: c_int
    no_fancy_upsampling: c_int
    use_cropping: c_int
    crop_left: c_int
    crop_top: c_int
    crop_width: c_int
    crop_height: c_int
    use_scaling: c_int
    scaled_width: c_int
    scaled_height: c_int
    use_threads: c_int
    dithering_strength: c_int
    flip: c_int
    alpha_dithering_strength: c_int
    pad: [5]u32
}

pub const WebPDecoderConfig = struct {
    input: WebPBitstreamFeatures
    output: WebPDecBuffer
    options: WebPDecoderOptions
}

pub extern("c") fn WebPInitDecoderConfigInternal(config: *WebPDecoderConfig, version: c_int) -> c_int

pub fn WebPInitDecoderConfig(config: *WebPDecoderConfig) -> c_int {
    return WebPInitDecoderConfigInternal(config, WEBP_DECODER_ABI_VERSION)
}

// An incremental decoder with CONFIG's options and output (CONFIG may be
// NULL), checking DATA (when given) first.
pub extern("c") fn WebPIDecode(data: *const u8, data_size: usize, config: *WebPDecoderConfig) -> *WebPIDecoder
pub extern("c") fn WebPDecode(data: *const u8, data_size: usize, config: *WebPDecoderConfig) -> VP8StatusCode
