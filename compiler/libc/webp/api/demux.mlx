// webp/demux.h
// mlx-libwebp: libwebp's demuxing API (libwebp 1.3.2, demux ABI 0x0107):
// the chunks of a WebP file, complete or partial, as a canvas and its
// frames (WebPDemuxPartial, WebPDemuxGetI, WebPDemuxGetFrame, as WebKit's
// decoder uses them), the metadata chunks, and the animation decoder
// that composes the frames onto the canvas (WebPAnimDecoder).
const decode = @import("./decode.mlx")
const mux_types = @import("./mux_types.mlx")
const types = @import("./types.mlx")

const c_char = types.c_char
const c_int = types.c_int
const c_tokens = types.c_tokens
const WebPData = mux_types.WebPData
const WebPMuxAnimDispose = mux_types.WebPMuxAnimDispose
const WebPMuxAnimBlend = mux_types.WebPMuxAnimBlend
const WEBP_CSP_MODE = decode.WEBP_CSP_MODE

pub const WEBP_WEBP_DEMUX_H_: c_tokens = ""
pub const WEBP_DEMUX_ABI_VERSION: c_int = 0x0107

pub const WebPDemuxer = struct {}

// The demuxer's version: 1.3.2.
pub extern("c") fn WebPGetDemuxVersion() -> c_int

pub const WebPDemuxState = enum(c_int) {
    WEBP_DEMUX_PARSE_ERROR = -1,
    WEBP_DEMUX_PARSING_HEADER = 0,
    WEBP_DEMUX_PARSED_HEADER = 1,
    WEBP_DEMUX_DONE = 2,
}

pub extern("c") fn WebPDemuxInternal(data: *const WebPData, allow_partial: c_int, state: *WebPDemuxState, version: c_int) -> *WebPDemuxer

// A demuxer of a whole file (DATA stays the caller's, in place).
pub fn WebPDemux(data: *const WebPData) -> *WebPDemuxer {
    return WebPDemuxInternal(data, 0, null, WEBP_DEMUX_ABI_VERSION)
}

// A demuxer of a file that may be cut short.
pub fn WebPDemuxPartial(data: *const WebPData, state: *WebPDemuxState) -> *WebPDemuxer {
    return WebPDemuxInternal(data, 1, state, WEBP_DEMUX_ABI_VERSION)
}

pub extern("c") fn WebPDemuxDelete(dmux: *WebPDemuxer) -> void

pub const WebPFormatFeature = enum(c_int) {
    WEBP_FF_FORMAT_FLAGS = 0,
    WEBP_FF_CANVAS_WIDTH = 1,
    WEBP_FF_CANVAS_HEIGHT = 2,
    WEBP_FF_LOOP_COUNT = 3,
    WEBP_FF_BACKGROUND_COLOR = 4,
    WEBP_FF_FRAME_COUNT = 5,
}

pub extern("c") fn WebPDemuxGetI(dmux: *const WebPDemuxer, feature: WebPFormatFeature) -> u32

// A frame: its number, place and size on the canvas, duration, disposal
// and blending, and its bytes (ALPH and image chunks).
pub const WebPIterator = struct {
    frame_num: c_int
    num_frames: c_int
    x_offset: c_int
    y_offset: c_int
    width: c_int
    height: c_int
    duration: c_int
    dispose_method: WebPMuxAnimDispose
    complete: c_int
    fragment: WebPData
    has_alpha: c_int
    blend_method: WebPMuxAnimBlend
    pad: [2]u32
    private_: *anyopaque
}

// Frame FRAME_NUMBER (1 the first, 0 the last) into ITER.
pub extern("c") fn WebPDemuxGetFrame(dmux: *const WebPDemuxer, frame_number: c_int, iter: *WebPIterator) -> c_int
pub extern("c") fn WebPDemuxNextFrame(iter: *WebPIterator) -> c_int
pub extern("c") fn WebPDemuxPrevFrame(iter: *WebPIterator) -> c_int
pub extern("c") fn WebPDemuxReleaseIterator(iter: *WebPIterator) -> void

pub const WebPChunkIterator = struct {
    chunk_num: c_int
    num_chunks: c_int
    chunk: WebPData
    pad: [6]u32
    private_: *anyopaque
}

// Chunk CHUNK_NUMBER (1 the first, 0 the last) of those tagged FOURCC
// ("ICCP", "EXIF", "XMP ").
pub extern("c") fn WebPDemuxGetChunk(dmux: *const WebPDemuxer, fourcc: *const c_char, chunk_number: c_int, iter: *WebPChunkIterator) -> c_int
pub extern("c") fn WebPDemuxNextChunk(iter: *WebPChunkIterator) -> c_int
pub extern("c") fn WebPDemuxPrevChunk(iter: *WebPChunkIterator) -> c_int
pub extern("c") fn WebPDemuxReleaseChunkIterator(iter: *WebPChunkIterator) -> void

// The animation decoder: each frame composed onto the canvas.
pub const WebPAnimDecoder = struct {}

pub const WebPAnimDecoderOptions = struct {
    color_mode: WEBP_CSP_MODE
    use_threads: c_int
    padding: [7]u32
}

pub extern("c") fn WebPAnimDecoderOptionsInitInternal(dec_options: *WebPAnimDecoderOptions, version: c_int) -> c_int

pub fn WebPAnimDecoderOptionsInit(dec_options: *WebPAnimDecoderOptions) -> c_int {
    return WebPAnimDecoderOptionsInitInternal(dec_options, WEBP_DEMUX_ABI_VERSION)
}

pub extern("c") fn WebPAnimDecoderNewInternal(webp_data: *const WebPData, dec_options: *const WebPAnimDecoderOptions, version: c_int) -> *WebPAnimDecoder

pub fn WebPAnimDecoderNew(webp_data: *const WebPData, dec_options: *const WebPAnimDecoderOptions) -> *WebPAnimDecoder {
    return WebPAnimDecoderNewInternal(webp_data, dec_options, WEBP_DEMUX_ABI_VERSION)
}

pub const WebPAnimInfo = struct {
    canvas_width: u32
    canvas_height: u32
    loop_count: u32
    bgcolor: u32
    frame_count: u32
    pad: [4]u32
}

pub extern("c") fn WebPAnimDecoderGetInfo(dec: *const WebPAnimDecoder, info: *WebPAnimInfo) -> c_int
// The next frame composed: the canvas into BUF (the decoder's memory),
// the frame's end time into TIMESTAMP.
pub extern("c") fn WebPAnimDecoderGetNext(dec: *WebPAnimDecoder, buf: **u8, timestamp: *c_int) -> c_int
pub extern("c") fn WebPAnimDecoderHasMoreFrames(dec: *const WebPAnimDecoder) -> c_int
pub extern("c") fn WebPAnimDecoderReset(dec: *WebPAnimDecoder) -> void
pub extern("c") fn WebPAnimDecoderGetDemuxer(dec: *const WebPAnimDecoder) -> *const WebPDemuxer
pub extern("c") fn WebPAnimDecoderDelete(dec: *WebPAnimDecoder) -> void
