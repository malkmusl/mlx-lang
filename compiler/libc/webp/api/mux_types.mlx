// webp/mux_types.h
// mlx-libwebp: the types the demuxer and the muxer share (libwebp
// 1.3.2): the VP8X feature flags, an animation frame's disposal and
// blending, and WebPData, a block of bytes.
const c_system_headers = "string.h"
const types = @import("./types.mlx")

const c_int = types.c_int
const c_tokens = types.c_tokens

pub const WEBP_WEBP_MUX_TYPES_H_: c_tokens = ""

pub const WebPFeatureFlags = enum(c_int) {
    ANIMATION_FLAG = 0x00000002,
    XMP_FLAG = 0x00000004,
    EXIF_FLAG = 0x00000008,
    ALPHA_FLAG = 0x00000010,
    ICCP_FLAG = 0x00000020,
    ALL_VALID_FLAGS = 0x0000003e,
}

// What becomes of a frame's rectangle before the next frame.
pub const WebPMuxAnimDispose = enum(c_int) {
    WEBP_MUX_DISPOSE_NONE = 0,
    WEBP_MUX_DISPOSE_BACKGROUND = 1,
}

// Whether a frame is blended over the canvas or replaces its rectangle.
pub const WebPMuxAnimBlend = enum(c_int) {
    WEBP_MUX_BLEND = 0,
    WEBP_MUX_NO_BLEND = 1,
}

pub const WebPData = struct {
    bytes: *const u8
    size: usize
}

pub fn WebPDataInit(webp_data: *WebPData) -> void {
    if webp_data != null {
        webp_data.*.bytes = null
        webp_data.*.size = 0
    }
}

// Frees the bytes (WebPFree) and empties WEBP_DATA.
pub fn WebPDataClear(webp_data: *WebPData) -> void {
    if webp_data != null {
        types.WebPFree(@ptrCast(*anyopaque, webp_data.*.bytes))
        WebPDataInit(webp_data)
    }
}

// DST a copy of SRC's bytes (WebPMalloc's); 0 on error.
pub fn WebPDataCopy(src: *const WebPData, dst: *WebPData) -> c_int {
    if src == null || dst == null { return 0 }
    WebPDataInit(dst)
    if src.*.bytes != null && src.*.size != 0 {
        dst.*.bytes = @ptrCast(*u8, types.WebPMalloc(src.*.size))
        if dst.*.bytes == null { return 0 }
        memcpy(@ptrCast(*anyopaque, dst.*.bytes), src.*.bytes, src.*.size)
        dst.*.size = src.*.size
    }
    return 1
}
