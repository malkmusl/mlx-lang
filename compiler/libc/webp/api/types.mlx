// webp/types.h
// mlx-libwebp: the basic declarations of libwebp's headers (libwebp
// 1.3.2): the integer types, WEBP_EXTERN and WEBP_INLINE, and the memory
// functions whose blocks the API hands out and takes back.
const c_system_headers = "stddef.h inttypes.h"
const c_macros = "#define WEBP_ABI_IS_INCOMPATIBLE(a, b) (((a) >> 8) != ((b) >> 8))"

// (Mlx names of C types: C has them as they are.)
pub const c_char = u8
pub const c_int = i32
pub const c_tokens = usize

pub const WEBP_WEBP_TYPES_H_: c_tokens = ""
pub const WEBP_INLINE: c_tokens = "inline"
pub const WEBP_EXTERN: c_tokens = "extern"

// SIZE bytes (malloc's), for what the API takes back with WebPFree.
pub extern("c") fn WebPMalloc(size: usize) -> *anyopaque
// Frees what the API allocated (WebPDecodeRGBA's pixels, WebPData).
pub extern("c") fn WebPFree(ptr: *anyopaque) -> void
