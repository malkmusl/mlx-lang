// webp/encode.h over std.webp.encode: the configuration (config_enc.c's
// defaults, presets and checks), the picture and its memory, the
// importers, the memory writer, WebPEncode and the one-call encoders.
// Whatever the configuration asks, the picture is coded losslessly (a
// VP8L file of the exact pixels); a picture given as YUV(A) planes is
// made ARGB first.
const io = @import("std.webp.io")
const encode = @import("std.webp.encode")
const c = @import("./common.mlx")

const ENCODER_ABI_VERSION: i32 = 0x020f
const MAX_DIMENSION: i32 = 16383

// WebPEncodingError.
const ENC_OK: i32 = 0
const ENC_ERROR_OUT_OF_MEMORY: i32 = 1
const ENC_ERROR_NULL_PARAMETER: i32 = 3
const ENC_ERROR_INVALID_CONFIGURATION: i32 = 4
const ENC_ERROR_BAD_DIMENSION: i32 = 5
const ENC_ERROR_BAD_WRITE: i32 = 8
const ENC_ERROR_USER_ABORT: i32 = 10

// WebPConfig.
pub const Config = struct {
    lossless: i32
    quality: f32
    method: i32
    imageHint: i32
    targetSize: i32
    targetPSNR: f32
    segments: i32
    snsStrength: i32
    filterStrength: i32
    filterSharpness: i32
    filterType: i32
    autofilter: i32
    alphaCompression: i32
    alphaFiltering: i32
    alphaQuality: i32
    pass: i32
    showCompressed: i32
    preprocessing: i32
    partitions: i32
    partitionLimit: i32
    emulateJpegSize: i32
    threadLevel: i32
    lowMemory: i32
    nearLossless: i32
    exact: i32
    useDeltaPalette: i32
    useSharpYuv: i32
    qmin: i32
    qmax: i32
}

// WebPPicture.
pub const Picture = struct {
    useArgb: i32
    colorspace: i32
    width: i32
    height: i32
    y: usize
    u: usize
    v: usize
    yStride: i32
    uvStride: i32
    a: usize
    aStride: i32
    pad1: [2]u32
    argb: usize
    argbStride: i32
    pad2: [3]u32
    writer: usize
    customPtr: usize
    extraInfoType: i32
    extraInfo: usize
    stats: usize
    errorCode: i32
    progressHook: usize
    userData: usize
    pad3: [3]u32
    pad4: usize
    pad5: usize
    pad6: [8]u32
    memory: usize
    memoryArgb: usize
    pad7: [2]usize
}

const WriterFn = fn(usize, usize, usize) -> i32
const ProgressFn = fn(i32, usize) -> i32

pub inline fn pictureAt(address: usize) -> *Picture { return unsafe { @ptrFromInt(*Picture, address) } }
inline fn configAt(address: usize) -> *Config { return unsafe { @ptrFromInt(*Config, address) } }

export fn WebPGetEncoderVersion() -> i32 { return (1 << 16) | (3 << 8) | 2 }

// ---------------------------------------------------------------------------
// The configuration (enc/config_enc.c)

pub fn validateConfig(config: usize) -> i32 {
    if config == 0 { return 0 }
    const k = configAt(config)
    if k.*.quality < 0.0 || k.*.quality > 100.0 { return 0 }
    if k.*.targetSize < 0 { return 0 }
    if k.*.targetPSNR < 0.0 { return 0 }
    if k.*.method < 0 || k.*.method > 6 { return 0 }
    if k.*.segments < 1 || k.*.segments > 4 { return 0 }
    if k.*.snsStrength < 0 || k.*.snsStrength > 100 { return 0 }
    if k.*.filterStrength < 0 || k.*.filterStrength > 100 { return 0 }
    if k.*.filterSharpness < 0 || k.*.filterSharpness > 7 { return 0 }
    if k.*.filterType < 0 || k.*.filterType > 1 { return 0 }
    if k.*.autofilter < 0 || k.*.autofilter > 1 { return 0 }
    if k.*.pass < 1 || k.*.pass > 10 { return 0 }
    if k.*.qmin < 0 || k.*.qmax > 100 || k.*.qmin > k.*.qmax { return 0 }
    if k.*.showCompressed < 0 || k.*.showCompressed > 1 { return 0 }
    if k.*.preprocessing < 0 || k.*.preprocessing > 7 { return 0 }
    if k.*.partitions < 0 || k.*.partitions > 3 { return 0 }
    if k.*.partitionLimit < 0 || k.*.partitionLimit > 100 { return 0 }
    if k.*.alphaCompression < 0 { return 0 }
    if k.*.alphaFiltering < 0 { return 0 }
    if k.*.alphaQuality < 0 || k.*.alphaQuality > 100 { return 0 }
    if k.*.lossless < 0 || k.*.lossless > 1 { return 0 }
    if k.*.nearLossless < 0 || k.*.nearLossless > 100 { return 0 }
    if k.*.imageHint >= 4 { return 0 }
    if k.*.emulateJpegSize < 0 || k.*.emulateJpegSize > 1 { return 0 }
    if k.*.threadLevel < 0 || k.*.threadLevel > 1 { return 0 }
    if k.*.lowMemory < 0 || k.*.lowMemory > 1 { return 0 }
    if k.*.exact < 0 || k.*.exact > 1 { return 0 }
    if k.*.useDeltaPalette < 0 || k.*.useDeltaPalette > 1 { return 0 }
    if k.*.useSharpYuv < 0 || k.*.useSharpYuv > 1 { return 0 }
    return 1
}

pub fn configInit(config: usize, preset: i32, quality: f32, version: i32) -> i32 {
    if c.incompatible(version, ENCODER_ABI_VERSION) { return 0 }
    if config == 0 { return 0 }
    const k = configAt(config)
    k.*.quality = quality
    k.*.targetSize = 0
    k.*.targetPSNR = 0.0
    k.*.method = 4
    k.*.snsStrength = 50
    k.*.filterStrength = 60
    k.*.filterSharpness = 0
    k.*.filterType = 1
    k.*.partitions = 0
    k.*.segments = 4
    k.*.pass = 1
    k.*.qmin = 0
    k.*.qmax = 100
    k.*.showCompressed = 0
    k.*.preprocessing = 0
    k.*.autofilter = 0
    k.*.partitionLimit = 0
    k.*.alphaCompression = 1
    k.*.alphaFiltering = 1
    k.*.alphaQuality = 100
    k.*.lossless = 0
    k.*.exact = 0
    k.*.imageHint = 0
    k.*.emulateJpegSize = 0
    k.*.threadLevel = 0
    k.*.lowMemory = 0
    k.*.nearLossless = 100
    k.*.useDeltaPalette = 0
    k.*.useSharpYuv = 0
    if preset == 1 {
        k.*.snsStrength = 80
        k.*.filterSharpness = 4
        k.*.filterStrength = 35
        k.*.preprocessing = k.*.preprocessing & 5
    } else if preset == 2 {
        k.*.snsStrength = 80
        k.*.filterSharpness = 3
        k.*.filterStrength = 30
        k.*.preprocessing = k.*.preprocessing | 2
    } else if preset == 3 {
        k.*.snsStrength = 25
        k.*.filterSharpness = 6
        k.*.filterStrength = 10
    } else if preset == 4 {
        k.*.snsStrength = 0
        k.*.filterStrength = 0
        k.*.preprocessing = k.*.preprocessing & 5
    } else if preset == 5 {
        k.*.snsStrength = 0
        k.*.filterStrength = 0
        k.*.preprocessing = k.*.preprocessing & 5
        k.*.segments = 2
    }
    return validateConfig(config)
}

export fn WebPConfigLosslessPreset(config: usize, level: i32) -> i32 {
    if config == 0 || level < 0 || level > 9 { return 0 }
    var methods: [10]u8 = [10]u8{ 0, 1, 2, 3, 3, 4, 4, 4, 5, 6 }
    var qualities: [10]u8 = [10]u8{ 0, 20, 25, 30, 50, 50, 75, 90, 90, 100 }
    const k = configAt(config)
    k.*.lossless = 1
    k.*.method = @intCast(i32, methods[@intCast(usize, level)])
    k.*.quality = @floatFromInt(f32, qualities[@intCast(usize, level)])
    return 1
}

// ---------------------------------------------------------------------------
// The picture's memory

export fn WebPPictureInitInternal(picture: usize, version: i32) -> i32 {
    if c.incompatible(version, ENCODER_ABI_VERSION) { return 0 }
    if picture != 0 { io.zero(picture, @sizeOf(Picture)) }
    return 1
}

fn freeArgb(p: *Picture) -> void {
    c.free(p.*.memoryArgb)
    p.*.memoryArgb = 0
    p.*.argb = 0
}

fn freeYuva(p: *Picture) -> void {
    c.free(p.*.memory)
    p.*.memory = 0
    p.*.y = 0
    p.*.u = 0
    p.*.v = 0
    p.*.a = 0
}

pub fn pictureFree(picture: usize) -> void {
    if picture == 0 { return }
    const p = pictureAt(picture)
    freeArgb(p)
    freeYuva(p)
    p.*.yStride = 0
    p.*.uvStride = 0
    p.*.aStride = 0
    p.*.argbStride = 0
}

fn validSize(p: *Picture) -> bool {
    return p.*.width > 0 && p.*.height > 0 && p.*.width <= MAX_DIMENSION && p.*.height <= MAX_DIMENSION
}

// The ARGB plane, the picture's size (what was there goes).
fn allocateArgb(p: *Picture) -> bool {
    if !validSize(p) { return false }
    freeArgb(p)
    const count = @intCast(usize, p.*.width) * @intCast(usize, p.*.height)
    const memory = c.malloc(4 * count + 31)
    if memory == 0 { return false }
    p.*.memoryArgb = memory
    p.*.argb = (memory + 31) / 32 * 32
    p.*.argbStride = p.*.width
    return true
}

// The YUV 4:2:0 planes (and alpha when the colour space has it).
fn allocateYuva(p: *Picture) -> bool {
    if !validSize(p) { return false }
    freeYuva(p)
    const w = @intCast(usize, p.*.width)
    const h = @intCast(usize, p.*.height)
    const uvW = (w + 1) / 2
    const uvH = (h + 1) / 2
    const hasAlpha = (p.*.colorspace & 4) != 0
    var size = w * h + 2 * uvW * uvH
    if hasAlpha { size += w * h }
    const memory = c.malloc(size)
    if memory == 0 { return false }
    p.*.memory = memory
    p.*.y = memory
    p.*.yStride = @intCast(i32, w)
    p.*.u = memory + w * h
    p.*.v = p.*.u + uvW * uvH
    p.*.uvStride = @intCast(i32, uvW)
    if hasAlpha {
        p.*.a = p.*.v + uvW * uvH
        p.*.aStride = @intCast(i32, w)
    } else {
        p.*.a = 0
        p.*.aStride = 0
    }
    return true
}

export fn WebPPictureAlloc(picture: usize) -> i32 {
    if picture == 0 { return 0 }
    const p = pictureAt(picture)
    pictureFree(picture)
    if p.*.useArgb != 0 {
        if allocateArgb(p) { return 1 }
    } else {
        if allocateYuva(p) { return 1 }
    }
    p.*.errorCode = ENC_ERROR_BAD_DIMENSION
    return 0
}

export fn WebPPictureIsView(picture: usize) -> i32 {
    if picture == 0 { return 0 }
    const p = pictureAt(picture)
    if p.*.useArgb != 0 {
        if p.*.memoryArgb == 0 { return 1 }
        return 0
    }
    if p.*.memory == 0 { return 1 }
    return 0
}

fn copyRows(source: usize, sourceStride: usize, target: usize, targetStride: usize, rowBytes: usize, rows: usize) -> void {
    var j: usize = 0
    while j < rows {
        io.copy(target + j * targetStride, source + j * sourceStride, rowBytes)
        j += 1
    }
}

pub fn pictureCopy(source: usize, target: usize) -> i32 {
    if source == 0 || target == 0 { return 0 }
    if source == target { return 1 }
    const s = pictureAt(source)
    const t = pictureAt(target)
    t.* = s.*
    t.*.memory = 0
    t.*.memoryArgb = 0
    if s.*.useArgb != 0 || s.*.argb != 0 {
        if !allocateArgb(t) { return 0 }
        copyRows(s.*.argb, 4 * @intCast(usize, s.*.argbStride), t.*.argb, 4 * @intCast(usize, t.*.argbStride), 4 * @intCast(usize, s.*.width), @intCast(usize, s.*.height))
    }
    if s.*.y != 0 {
        if !allocateYuva(t) { return 0 }
        const w = @intCast(usize, s.*.width)
        const h = @intCast(usize, s.*.height)
        copyRows(s.*.y, @intCast(usize, s.*.yStride), t.*.y, @intCast(usize, t.*.yStride), w, h)
        copyRows(s.*.u, @intCast(usize, s.*.uvStride), t.*.u, @intCast(usize, t.*.uvStride), (w + 1) / 2, (h + 1) / 2)
        copyRows(s.*.v, @intCast(usize, s.*.uvStride), t.*.v, @intCast(usize, t.*.uvStride), (w + 1) / 2, (h + 1) / 2)
        if s.*.a != 0 && t.*.a != 0 { copyRows(s.*.a, @intCast(usize, s.*.aStride), t.*.a, @intCast(usize, t.*.aStride), w, h) }
    }
    return 1
}

fn rectangleOk(p: *Picture, left: i32, top: i32, width: i32, height: i32) -> bool {
    return left >= 0 && top >= 0 && width > 0 && height > 0 && left + width <= p.*.width && top + height <= p.*.height
}

// WebPPictureView: TARGET a view of SOURCE's rectangle (no memory of its
// own).
pub fn pictureView(source: usize, left: i32, top: i32, width: i32, height: i32, target: usize) -> i32 {
    if source == 0 || target == 0 { return 0 }
    const s = pictureAt(source)
    if !rectangleOk(s, left, top, width, height) { return 0 }
    const t = pictureAt(target)
    if source != target { t.* = s.* }
    t.*.memory = 0
    t.*.memoryArgb = 0
    t.*.width = width
    t.*.height = height
    if s.*.argb != 0 { t.*.argb = s.*.argb + 4 * (@intCast(usize, top) * @intCast(usize, s.*.argbStride) + @intCast(usize, left)) }
    if s.*.y != 0 {
        const evenLeft = @intCast(usize, left) / 2 * 2
        const evenTop = @intCast(usize, top) / 2 * 2
        t.*.y = s.*.y + evenTop * @intCast(usize, s.*.yStride) + evenLeft
        t.*.u = s.*.u + (evenTop / 2) * @intCast(usize, s.*.uvStride) + evenLeft / 2
        t.*.v = s.*.v + (evenTop / 2) * @intCast(usize, s.*.uvStride) + evenLeft / 2
        if s.*.a != 0 { t.*.a = s.*.a + evenTop * @intCast(usize, s.*.aStride) + evenLeft }
    }
    return 1
}

export fn WebPPictureCrop(picture: usize, left: i32, top: i32, width: i32, height: i32) -> i32 {
    if picture == 0 { return 0 }
    const p = pictureAt(picture)
    if !rectangleOk(p, left, top, width, height) { return 0 }
    var view: Picture = undefined
    if pictureView(picture, left, top, width, height, @intFromPtr(&view)) == 0 { return 0 }
    var copy: Picture = undefined
    if pictureCopy(@intFromPtr(&view), @intFromPtr(&copy)) == 0 { return 0 }
    pictureFree(picture)
    p.* = copy
    return 1
}

export fn WebPPictureRescale(picture: usize, width: i32, height: i32) -> i32 { return 0 }

export fn WebPPlaneDistortion(source: usize, sourceStride: usize, reference: usize, referenceStride: usize, width: i32, height: i32, xStep: usize, metric: i32, distortion: usize, result: usize) -> i32 { return 0 }

export fn WebPPictureDistortion(source: usize, reference: usize, metric: i32, result: usize) -> i32 { return 0 }

// ---------------------------------------------------------------------------
// Importing pixels

// The picture's ARGB plane from rows of STEP bytes a pixel, STRIDE bytes a
// row: red, green, blue and alpha at R, G, B, A (A < 0: opaque).
fn importPixels(picture: usize, pixels: usize, stride: i32, step: usize, r: usize, g: usize, b: usize, a: i64) -> i32 {
    if picture == 0 || pixels == 0 { return 0 }
    const p = pictureAt(picture)
    if !validSize(p) { return setError(p, ENC_ERROR_BAD_DIMENSION) }
    if !allocateArgb(p) { return setError(p, ENC_ERROR_OUT_OF_MEMORY) }
    const w = @intCast(usize, p.*.width)
    const h = @intCast(usize, p.*.height)
    var j: usize = 0
    while j < h {
        const row = io.offset(pixels, @intCast(i64, j) * @intCast(i64, stride))
        var i: usize = 0
        while i < w {
            const px = row + i * step
            var alpha: u64 = 0xff
            if a >= 0 { alpha = io.get8(px + @intCast(usize, a)) }
            io.put32(p.*.argb + 4 * (j * w + i), (alpha << 24) | (io.get8(px + r) << 16) | (io.get8(px + g) << 8) | io.get8(px + b))
            i += 1
        }
        j += 1
    }
    return 1
}

export fn WebPPictureImportRGB(picture: usize, rgb: usize, stride: i32) -> i32 { return importPixels(picture, rgb, stride, 3, 0, 1, 2, 0 - 1) }
export fn WebPPictureImportRGBA(picture: usize, rgba: usize, stride: i32) -> i32 { return importPixels(picture, rgba, stride, 4, 0, 1, 2, 3) }
export fn WebPPictureImportRGBX(picture: usize, rgbx: usize, stride: i32) -> i32 { return importPixels(picture, rgbx, stride, 4, 0, 1, 2, 0 - 1) }
export fn WebPPictureImportBGR(picture: usize, bgr: usize, stride: i32) -> i32 { return importPixels(picture, bgr, stride, 3, 2, 1, 0, 0 - 1) }
export fn WebPPictureImportBGRA(picture: usize, bgra: usize, stride: i32) -> i32 { return importPixels(picture, bgra, stride, 4, 2, 1, 0, 3) }
export fn WebPPictureImportBGRX(picture: usize, bgrx: usize, stride: i32) -> i32 { return importPixels(picture, bgrx, stride, 4, 2, 1, 0, 0 - 1) }

// WebPPictureYUVAToARGB: the planes made ARGB (each chroma sample for
// its four pixels).
pub fn yuvaToArgb(picture: usize) -> i32 {
    if picture == 0 { return 0 }
    const p = pictureAt(picture)
    if p.*.y == 0 || p.*.u == 0 || p.*.v == 0 { return 0 }
    if !allocateArgb(p) { return 0 }
    const w = @intCast(usize, p.*.width)
    const h = @intCast(usize, p.*.height)
    var j: usize = 0
    while j < h {
        var i: usize = 0
        while i < w {
            const Y = @intCast(i64, io.get8(p.*.y + j * @intCast(usize, p.*.yStride) + i))
            const U = @intCast(i64, io.get8(p.*.u + (j / 2) * @intCast(usize, p.*.uvStride) + i / 2))
            const V = @intCast(i64, io.get8(p.*.v + (j / 2) * @intCast(usize, p.*.uvStride) + i / 2))
            var alpha: u64 = 0xff
            if p.*.a != 0 { alpha = io.get8(p.*.a + j * @intCast(usize, p.*.aStride) + i) }
            io.put32(p.*.argb + 4 * (j * w + i), (alpha << 24) | (io.yuvToR(Y, V) << 16) | (io.yuvToG(Y, U, V) << 8) | io.yuvToB(Y, U))
            i += 1
        }
        j += 1
    }
    p.*.useArgb = 1
    return 1
}

// WebPPictureARGBToYUVA: the ARGB plane made YUV 4:2:0 (and alpha), as
// the lossless decoder's YUV output converts.
pub fn argbToYuva(picture: usize, colorspace: i32) -> i32 {
    if picture == 0 { return 0 }
    const p = pictureAt(picture)
    if p.*.argb == 0 { return 0 }
    var hasAlpha = false
    var j: usize = 0
    while j < @intCast(usize, p.*.height) {
        var i: usize = 0
        while i < @intCast(usize, p.*.width) {
            if (io.get32(p.*.argb + 4 * (j * @intCast(usize, p.*.argbStride) + i)) >> 24) != 0xff { hasAlpha = true }
            i += 1
        }
        j += 1
    }
    p.*.colorspace = colorspace & 3
    if hasAlpha { p.*.colorspace = p.*.colorspace | 4 }
    if !allocateYuva(p) { return 0 }
    var b: io.Buffer = undefined
    io.zero(@intFromPtr(&b), @sizeOf(io.Buffer))
    b.y = p.*.y
    b.u = p.*.u
    b.v = p.*.v
    b.a = p.*.a
    b.yStride = p.*.yStride
    b.uStride = p.*.uvStride
    b.vStride = p.*.uvStride
    b.aStride = p.*.aStride
    j = 0
    while j < @intCast(usize, p.*.height) {
        io.convertToYUVA(p.*.argb + 4 * j * @intCast(usize, p.*.argbStride), @intCast(usize, p.*.width), @intCast(i64, j), &b)
        j += 1
    }
    freeArgb(p)
    p.*.useArgb = 0
    return 1
}

export fn WebPPictureARGBToYUVADithered(picture: usize, colorspace: i32, dithering: f32) -> i32 { return argbToYuva(picture, colorspace) }
export fn WebPPictureSharpARGBToYUVA(picture: usize) -> i32 { return argbToYuva(picture, 0) }
export fn WebPPictureSmartARGBToYUVA(picture: usize) -> i32 { return argbToYuva(picture, 0) }

export fn WebPCleanupTransparentArea(picture: usize) -> void {}

export fn WebPPictureHasTransparency(picture: usize) -> i32 {
    if picture == 0 { return 0 }
    const p = pictureAt(picture)
    var j: usize = 0
    while j < @intCast(usize, p.*.height) {
        var i: usize = 0
        while i < @intCast(usize, p.*.width) {
            if p.*.argb != 0 {
                if (io.get32(p.*.argb + 4 * (j * @intCast(usize, p.*.argbStride) + i)) >> 24) != 0xff { return 1 }
            } else if p.*.a != 0 {
                if io.get8(p.*.a + j * @intCast(usize, p.*.aStride) + i) != 0xff { return 1 }
            }
            i += 1
        }
        j += 1
    }
    return 0
}

// WebPBlendAlpha: the pixels laid over BACKGROUND (0xRRGGBB), opaque.
export fn WebPBlendAlpha(picture: usize, background: u32) -> void {
    if picture == 0 { return }
    const p = pictureAt(picture)
    if p.*.argb == 0 { return }
    const bg = @intCast(u64, background)
    var j: usize = 0
    while j < @intCast(usize, p.*.height) {
        var i: usize = 0
        while i < @intCast(usize, p.*.width) {
            const at = p.*.argb + 4 * (j * @intCast(usize, p.*.argbStride) + i)
            const px = io.get32(at)
            const alpha = px >> 24
            var out: u64 = 0xff000000
            var shift: u64 = 0
            while shift < 24 {
                const fg = (px >> shift) & 0xff
                const back = (bg >> shift) & 0xff
                out = out | (((fg * alpha + back * (255 - alpha) + 127) / 255) << shift)
                shift += 8
            }
            io.put32(at, out)
            i += 1
        }
        j += 1
    }
}

// ---------------------------------------------------------------------------
// Writing

export fn WebPMemoryWriterInit(writer: usize) -> void {
    if writer != 0 { io.zero(writer, 32) }
}

export fn WebPMemoryWriterClear(writer: usize) -> void {
    if writer == 0 { return }
    c.free(@intCast(usize, io.get64(writer)))
    io.zero(writer, 32)
}

// WebPMemoryWrite: DATA appended to the WebPMemoryWriter at the
// picture's custom_ptr.
export fn WebPMemoryWrite(data: usize, size: usize, picture: usize) -> i32 {
    if picture == 0 { return 0 }
    const w = pictureAt(picture).*.customPtr
    if w == 0 { return 1 }
    const mem = @intCast(usize, io.get64(w))
    const used = @intCast(usize, io.get64(w + 8))
    const capacity = @intCast(usize, io.get64(w + 16))
    if used + size > capacity {
        var grown = capacity * 2
        if grown < 8192 { grown = 8192 }
        while grown < used + size { grown = grown * 2 }
        const fresh = c.malloc(grown)
        if fresh == 0 { return 0 }
        io.copy(fresh, mem, used)
        c.free(mem)
        io.put64(w, @intCast(u64, fresh))
        io.put64(w + 16, @intCast(u64, grown))
    }
    if size > 0 { io.copy(@intCast(usize, io.get64(w)) + used, data, size) }
    io.put64(w + 8, @intCast(u64, used + size))
    return 1
}

fn setError(p: *Picture, failure: i32) -> i32 {
    if p.*.errorCode == ENC_OK { p.*.errorCode = failure }
    return 0
}

// The ARGB plane the encoder takes: the picture's, or made of its planes
// (a temporary copy).
fn argbOf(picture: usize, temporary: *Picture) -> usize {
    const p = pictureAt(picture)
    if p.*.argb != 0 { return picture }
    if p.*.y == 0 { return 0 }
    temporary.* = p.*
    temporary.*.memory = 0
    temporary.*.memoryArgb = 0
    if yuvaToArgb(@intFromPtr(temporary)) == 0 { return 0 }
    return @intFromPtr(temporary)
}

// WebPEncode: the picture coded and written (losslessly, whatever CONFIG
// asks).
pub fn encodePicture(config: usize, picture: usize) -> i32 {
    if picture == 0 { return 0 }
    const p = pictureAt(picture)
    p.*.errorCode = ENC_OK
    if config == 0 { return setError(p, ENC_ERROR_NULL_PARAMETER) }
    if validateConfig(config) == 0 { return setError(p, ENC_ERROR_INVALID_CONFIGURATION) }
    if !validSize(p) { return setError(p, ENC_ERROR_BAD_DIMENSION) }
    var temporary: Picture = undefined
    const source = argbOf(picture, &temporary)
    if source == 0 { return setError(p, ENC_ERROR_NULL_PARAMETER) }
    const s = pictureAt(source)
    var out: encode.Bytes = undefined
    encode.initBytes(&out, c.allocator())
    const ok = encode.encodeFile(&out, s.*.argb, @intCast(usize, s.*.width), @intCast(usize, s.*.height), @intCast(usize, s.*.argbStride))
    if source != picture { freeArgb(s) }
    if !ok {
        encode.freeBytes(&out)
        return setError(p, ENC_ERROR_OUT_OF_MEMORY)
    }
    if p.*.stats != 0 {
        io.zero(p.*.stats, 188)
        io.putI32(p.*.stats, @intCast(i64, out.size))
        io.putI32(p.*.stats + 168, @intCast(i64, out.size - 20))
    }
    var written = true
    if p.*.writer != 0 {
        const call: WriterFn = unsafe { @ptrFromInt(WriterFn, p.*.writer) }
        written = call(out.data, out.size, picture) != 0
    }
    encode.freeBytes(&out)
    if !written { return setError(p, ENC_ERROR_BAD_WRITE) }
    if p.*.progressHook != 0 {
        const hook: ProgressFn = unsafe { @ptrFromInt(ProgressFn, p.*.progressHook) }
        if hook(100, picture) == 0 { return setError(p, ENC_ERROR_USER_ABORT) }
    }
    return 1
}

// The one-call encoders: the picture imported, coded into memory of the
// library's (*OUTPUT, freed by WebPFree); the size, 0 on error.
fn encodeSimple(pixels: usize, width: i32, height: i32, stride: i32, step: usize, bgr: bool, alpha: bool, output: usize) -> usize {
    if output == 0 { return 0 }
    io.put64(output, 0)
    var picture: Picture = undefined
    io.zero(@intFromPtr(&picture), @sizeOf(Picture))
    picture.width = width
    picture.height = height
    picture.useArgb = 1
    var r: usize = 0
    var b: usize = 2
    if bgr {
        r = 2
        b = 0
    }
    var a: i64 = 0 - 1
    if alpha { a = 3 }
    if importPixels(@intFromPtr(&picture), pixels, stride, step, r, 1, b, a) == 0 { return 0 }
    var writer: [4]u64 = [4]u64{ 0, 0, 0, 0 }
    picture.writer = @intFromPtr(WebPMemoryWrite)
    picture.customPtr = @intFromPtr(&writer)
    var config: Config = undefined
    configInit(@intFromPtr(&config), 0, 75.0, ENCODER_ABI_VERSION)
    config.lossless = 1
    const ok = encodePicture(@intFromPtr(&config), @intFromPtr(&picture))
    pictureFree(@intFromPtr(&picture))
    if ok == 0 {
        c.free(@intCast(usize, writer[0]))
        return 0
    }
    io.put64(output, writer[0])
    return @intCast(usize, writer[1])
}

export fn WebPEncodeRGB(rgb: usize, width: i32, height: i32, stride: i32, quality: f32, output: usize) -> usize { return encodeSimple(rgb, width, height, stride, 3, false, false, output) }
export fn WebPEncodeBGR(bgr: usize, width: i32, height: i32, stride: i32, quality: f32, output: usize) -> usize { return encodeSimple(bgr, width, height, stride, 3, true, false, output) }
export fn WebPEncodeRGBA(rgba: usize, width: i32, height: i32, stride: i32, quality: f32, output: usize) -> usize { return encodeSimple(rgba, width, height, stride, 4, false, true, output) }
export fn WebPEncodeBGRA(bgra: usize, width: i32, height: i32, stride: i32, quality: f32, output: usize) -> usize { return encodeSimple(bgra, width, height, stride, 4, true, true, output) }
export fn WebPEncodeLosslessRGB(rgb: usize, width: i32, height: i32, stride: i32, output: usize) -> usize { return encodeSimple(rgb, width, height, stride, 3, false, false, output) }
export fn WebPEncodeLosslessBGR(bgr: usize, width: i32, height: i32, stride: i32, output: usize) -> usize { return encodeSimple(bgr, width, height, stride, 3, true, false, output) }
export fn WebPEncodeLosslessRGBA(rgba: usize, width: i32, height: i32, stride: i32, output: usize) -> usize { return encodeSimple(rgba, width, height, stride, 4, false, true, output) }
export fn WebPEncodeLosslessBGRA(bgra: usize, width: i32, height: i32, stride: i32, output: usize) -> usize { return encodeSimple(bgra, width, height, stride, 4, true, true, output) }

// The exported functions the parts above call too.
export fn WebPValidateConfig(config: usize) -> i32 { return validateConfig(config) }
export fn WebPConfigInitInternal(config: usize, preset: i32, quality: f32, version: i32) -> i32 { return configInit(config, preset, quality, version) }
export fn WebPPictureFree(picture: usize) -> void { pictureFree(picture) }
export fn WebPPictureCopy(source: usize, target: usize) -> i32 { return pictureCopy(source, target) }
export fn WebPPictureView(source: usize, left: i32, top: i32, width: i32, height: i32, target: usize) -> i32 { return pictureView(source, left, top, width, height, target) }
export fn WebPPictureYUVAToARGB(picture: usize) -> i32 { return yuvaToArgb(picture) }
export fn WebPPictureARGBToYUVA(picture: usize, colorspace: i32) -> i32 { return argbToYuva(picture, colorspace) }
export fn WebPEncode(config: usize, picture: usize) -> i32 { return encodePicture(config, picture) }
