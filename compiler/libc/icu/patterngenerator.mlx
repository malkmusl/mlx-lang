// udatpg.h for C: the functions of std.unicode.format.date.generator
// (std/src/unicode/format/date/generator.mlx), each calling the pub
// function of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.date.generator")

export fn udatpg_open(localeId: usize, pErrorCode: usize) -> usize { return implementation.udatpg_open(localeId, pErrorCode) }
export fn udatpg_openEmpty(pErrorCode: usize) -> usize { return implementation.udatpg_openEmpty(pErrorCode) }
export fn udatpg_close(dtpg: usize) -> void { implementation.udatpg_close(dtpg) }
export fn udatpg_clone(dtpg: usize, pErrorCode: usize) -> usize { return implementation.udatpg_clone(dtpg, pErrorCode) }
export fn udatpg_getBestPatternWithOptions(dtpg: usize, skeleton: usize, length: i32, options: i32, bestPattern_: usize, capacity: i32, pErrorCode: usize) -> i32 { return implementation.udatpg_getBestPatternWithOptions(dtpg, skeleton, length, options, bestPattern_, capacity, pErrorCode) }
export fn udatpg_getBestPattern(dtpg: usize, skeleton: usize, length: i32, bestPattern_: usize, capacity: i32, pErrorCode: usize) -> i32 { return implementation.udatpg_getBestPattern(dtpg, skeleton, length, bestPattern_, capacity, pErrorCode) }
export fn udatpg_getSkeleton(unusedDtpg: usize, pattern: usize, length: i32, skeleton: usize, capacity: i32, pErrorCode: usize) -> i32 { return implementation.udatpg_getSkeleton(unusedDtpg, pattern, length, skeleton, capacity, pErrorCode) }
export fn udatpg_getBaseSkeleton(unusedDtpg: usize, pattern: usize, length: i32, baseSkeleton: usize, capacity: i32, pErrorCode: usize) -> i32 { return implementation.udatpg_getBaseSkeleton(unusedDtpg, pattern, length, baseSkeleton, capacity, pErrorCode) }
export fn udatpg_addPattern(dtpg: usize, pattern: usize, patternLength: i32, override: u8, conflictingPattern: usize, capacity: i32, pLength: usize, pErrorCode: usize) -> i32 { return implementation.udatpg_addPattern(dtpg, pattern, patternLength, override, conflictingPattern, capacity, pLength, pErrorCode) }
export fn udatpg_setAppendItemFormat(dtpg: usize, field: i32, value: usize, length: i32) -> void { implementation.udatpg_setAppendItemFormat(dtpg, field, value, length) }
export fn udatpg_getAppendItemFormat(dtpg: usize, field: i32, pLength: usize) -> usize { return implementation.udatpg_getAppendItemFormat(dtpg, field, pLength) }
export fn udatpg_setAppendItemName(dtpg: usize, field: i32, value: usize, length: i32) -> void { implementation.udatpg_setAppendItemName(dtpg, field, value, length) }
export fn udatpg_getAppendItemName(dtpg: usize, field: i32, pLength: usize) -> usize { return implementation.udatpg_getAppendItemName(dtpg, field, pLength) }
export fn udatpg_getFieldDisplayName(dtpg: usize, field: i32, width: i32, fieldName: usize, capacity: i32, pErrorCode: usize) -> i32 { return implementation.udatpg_getFieldDisplayName(dtpg, field, width, fieldName, capacity, pErrorCode) }
export fn udatpg_setDateTimeFormat(dtpg: usize, dtFormat: usize, length: i32) -> void { implementation.udatpg_setDateTimeFormat(dtpg, dtFormat, length) }
export fn udatpg_getDateTimeFormat(dtpg: usize, pLength: usize) -> usize { return implementation.udatpg_getDateTimeFormat(dtpg, pLength) }
export fn udatpg_setDateTimeFormatForStyle(udtpg: usize, style: i32, dateTimeFormat: usize, length: i32, pErrorCode: usize) -> void { implementation.udatpg_setDateTimeFormatForStyle(udtpg, style, dateTimeFormat, length, pErrorCode) }
export fn udatpg_getDateTimeFormatForStyle(udtpg: usize, style: i32, pLength: usize, pErrorCode: usize) -> usize { return implementation.udatpg_getDateTimeFormatForStyle(udtpg, style, pLength, pErrorCode) }
export fn udatpg_setDecimal(dtpg: usize, decimal: usize, length: i32) -> void { implementation.udatpg_setDecimal(dtpg, decimal, length) }
export fn udatpg_getDecimal(dtpg: usize, pLength: usize) -> usize { return implementation.udatpg_getDecimal(dtpg, pLength) }
export fn udatpg_replaceFieldTypesWithOptions(dtpg: usize, pattern: usize, patternLength: i32, skeleton: usize, skeletonLength: i32, options: i32, dest: usize, destCapacity: i32, pErrorCode: usize) -> i32 { return implementation.udatpg_replaceFieldTypesWithOptions(dtpg, pattern, patternLength, skeleton, skeletonLength, options, dest, destCapacity, pErrorCode) }
export fn udatpg_replaceFieldTypes(dtpg: usize, pattern: usize, patternLength: i32, skeleton: usize, skeletonLength: i32, dest: usize, destCapacity: i32, pErrorCode: usize) -> i32 { return implementation.udatpg_replaceFieldTypes(dtpg, pattern, patternLength, skeleton, skeletonLength, dest, destCapacity, pErrorCode) }
export fn udatpg_openSkeletons(dtpg: usize, pErrorCode: usize) -> usize { return implementation.udatpg_openSkeletons(dtpg, pErrorCode) }
export fn udatpg_openBaseSkeletons(dtpg: usize, pErrorCode: usize) -> usize { return implementation.udatpg_openBaseSkeletons(dtpg, pErrorCode) }
export fn udatpg_getPatternForSkeleton(dtpg: usize, skeleton: usize, skeletonLength: i32, pLength: usize) -> usize { return implementation.udatpg_getPatternForSkeleton(dtpg, skeleton, skeletonLength, pLength) }
export fn udatpg_getDefaultHourCycle(dtpg: usize, pErrorCode: usize) -> i32 { return implementation.udatpg_getDefaultHourCycle(dtpg, pErrorCode) }
