// uenum.h for C: the functions of std.unicode.enumeration
// (std/src/unicode/enumeration.mlx), each calling the pub function of the
// same name there, with the same C types and error codes.
const implementation = @import("std.unicode.enumeration")

export fn uenum_close(en: usize) -> void { implementation.uenum_close(en) }
export fn uenum_count(en: usize, status: usize) -> i32 { return implementation.uenum_count(en, status) }
export fn uenum_next(en: usize, resultLength: usize, status: usize) -> usize { return implementation.uenum_next(en, resultLength, status) }
export fn uenum_unext(en: usize, resultLength: usize, status: usize) -> usize { return implementation.uenum_unext(en, resultLength, status) }
export fn uenum_reset(en: usize, status: usize) -> void { implementation.uenum_reset(en, status) }
export fn uenum_openCharStringsEnumeration(strings: usize, count: i32, status: usize) -> usize { return implementation.uenum_openCharStringsEnumeration(strings, count, status) }
export fn uenum_openUCharStringsEnumeration(strings: usize, count: i32, status: usize) -> usize { return implementation.uenum_openUCharStringsEnumeration(strings, count, status) }
