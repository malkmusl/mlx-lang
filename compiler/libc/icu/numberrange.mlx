// unumberrangeformatter.h for C: the functions of
// std.unicode.format.number.range
// (std/src/unicode/format/number/range.mlx), each calling the pub function
// of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.number.range")

export fn unumrf_openForSkeletonWithCollapseAndIdentityFallback(skeleton: usize, skeletonLen: i32, collapse: i32, identityFallback: i32, localeId: usize, perror: usize, ec: usize) -> usize { return implementation.unumrf_openForSkeletonWithCollapseAndIdentityFallback(skeleton, skeletonLen, collapse, identityFallback, localeId, perror, ec) }
export fn unumrf_close(uformatter: usize) -> void { implementation.unumrf_close(uformatter) }
export fn unumrf_openResult(ec: usize) -> usize { return implementation.unumrf_openResult(ec) }
export fn unumrf_closeResult(uresult: usize) -> void { implementation.unumrf_closeResult(uresult) }
export fn unumrf_formatDoubleRange(uformatter: usize, first: f64, second: f64, uresult: usize, ec: usize) -> void { implementation.unumrf_formatDoubleRange(uformatter, first, second, uresult, ec) }
export fn unumrf_formatDecimalRange(uformatter: usize, first: usize, firstLen: i32, second: usize, secondLen: i32, uresult: usize, ec: usize) -> void { implementation.unumrf_formatDecimalRange(uformatter, first, firstLen, second, secondLen, uresult, ec) }
export fn unumrf_resultAsValue(uresult: usize, ec: usize) -> usize { return implementation.unumrf_resultAsValue(uresult, ec) }
export fn unumrf_resultGetIdentityResult(uresult: usize, ec: usize) -> i32 { return implementation.unumrf_resultGetIdentityResult(uresult, ec) }
export fn unumrf_resultGetFirstDecimalNumber(uresult: usize, dest: usize, destCapacity: i32, ec: usize) -> i32 { return implementation.unumrf_resultGetFirstDecimalNumber(uresult, dest, destCapacity, ec) }
export fn unumrf_resultGetSecondDecimalNumber(uresult: usize, dest: usize, destCapacity: i32, ec: usize) -> i32 { return implementation.unumrf_resultGetSecondDecimalNumber(uresult, dest, destCapacity, ec) }
