// unum.h, uformattable.h for C: the functions of
// std.unicode.format.number.decimalformat
// (std/src/unicode/format/number/decimalformat.mlx), each calling the pub
// function of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.number.decimalformat")

export fn unum_format(fmt: usize, number: i32, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 { return implementation.unum_format(fmt, number, result, resultLength, pos, status) }
export fn unum_formatInt64(fmt: usize, number: i64, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 { return implementation.unum_formatInt64(fmt, number, result, resultLength, pos, status) }
export fn unum_formatDouble(fmt: usize, number: f64, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 { return implementation.unum_formatDouble(fmt, number, result, resultLength, pos, status) }
export fn unum_formatDoubleForFields(format: usize, number: f64, result: usize, resultLength: i32, fpositer: usize, status: usize) -> i32 { return implementation.unum_formatDoubleForFields(format, number, result, resultLength, fpositer, status) }
export fn unum_formatDecimal(fmt: usize, number: usize, length: i32, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 { return implementation.unum_formatDecimal(fmt, number, length, result, resultLength, pos, status) }
export fn unum_formatDoubleCurrency(fmt: usize, number: f64, currencyCode: usize, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 { return implementation.unum_formatDoubleCurrency(fmt, number, currencyCode, result, resultLength, pos, status) }
export fn unum_formatUFormattable(fmt: usize, number: usize, result: usize, resultLength: i32, pos: usize, status: usize) -> i32 { return implementation.unum_formatUFormattable(fmt, number, result, resultLength, pos, status) }
export fn unum_parse(fmt: usize, text: usize, textLength: i32, parsePos: usize, status: usize) -> i32 { return implementation.unum_parse(fmt, text, textLength, parsePos, status) }
export fn unum_parseInt64(fmt: usize, text: usize, textLength: i32, parsePos: usize, status: usize) -> i64 { return implementation.unum_parseInt64(fmt, text, textLength, parsePos, status) }
export fn unum_parseDouble(fmt: usize, text: usize, textLength: i32, parsePos: usize, status: usize) -> f64 { return implementation.unum_parseDouble(fmt, text, textLength, parsePos, status) }
export fn unum_parseDecimal(fmt: usize, text: usize, textLength: i32, parsePos: usize, outBuf: usize, outBufLength: i32, status: usize) -> i32 { return implementation.unum_parseDecimal(fmt, text, textLength, parsePos, outBuf, outBufLength, status) }
export fn unum_parseDoubleCurrency(fmt: usize, text: usize, textLength: i32, parsePos: usize, currencyOut: usize, status: usize) -> f64 { return implementation.unum_parseDoubleCurrency(fmt, text, textLength, parsePos, currencyOut, status) }
export fn unum_parseToUFormattable(fmt: usize, result: usize, text: usize, textLength: i32, parsePos: usize, status: usize) -> usize { return implementation.unum_parseToUFormattable(fmt, result, text, textLength, parsePos, status) }
export fn ufmt_open(status: usize) -> usize { return implementation.ufmt_open(status) }
export fn ufmt_close(fmt: usize) -> void { implementation.ufmt_close(fmt) }
export fn ufmt_getType(fmt: usize, status: usize) -> i32 { return implementation.ufmt_getType(fmt, status) }
export fn ufmt_isNumeric(fmt: usize) -> bool { return implementation.ufmt_isNumeric(fmt) }
export fn ufmt_getDate(fmt: usize, status: usize) -> f64 { return implementation.ufmt_getDate(fmt, status) }
export fn ufmt_getDouble(fmt: usize, status: usize) -> f64 { return implementation.ufmt_getDouble(fmt, status) }
export fn ufmt_getLong(fmt: usize, status: usize) -> i32 { return implementation.ufmt_getLong(fmt, status) }
export fn ufmt_getInt64(fmt: usize, status: usize) -> i64 { return implementation.ufmt_getInt64(fmt, status) }
export fn ufmt_getObject(fmt: usize, status: usize) -> usize { return implementation.ufmt_getObject(fmt, status) }
export fn ufmt_getUChars(fmt: usize, len: usize, status: usize) -> usize { return implementation.ufmt_getUChars(fmt, len, status) }
export fn ufmt_getArrayLength(fmt: usize, status: usize) -> i32 { return implementation.ufmt_getArrayLength(fmt, status) }
export fn ufmt_getArrayItemByIndex(fmt: usize, n: i32, status: usize) -> usize { return implementation.ufmt_getArrayItemByIndex(fmt, n, status) }
export fn ufmt_getDecNumChars(fmt: usize, len: usize, status: usize) -> usize { return implementation.ufmt_getDecNumChars(fmt, len, status) }
export fn unum_open(style: i32, pattern: usize, patternLength: i32, localeId: usize, parseErr: usize, status: usize) -> usize { return implementation.unum_open(style, pattern, patternLength, localeId, parseErr, status) }
export fn unum_close(fmt: usize) -> void { implementation.unum_close(fmt) }
export fn unum_clone(fmt: usize, status: usize) -> usize { return implementation.unum_clone(fmt, status) }
export fn unum_applyPattern(format: usize, localized: bool, pattern: usize, patternLength: i32, parseError: usize, status: usize) -> void { implementation.unum_applyPattern(format, localized, pattern, patternLength, parseError, status) }
export fn unum_toPattern(fmt: usize, isPatternLocalized: bool, result: usize, resultLength: i32, status: usize) -> i32 { return implementation.unum_toPattern(fmt, isPatternLocalized, result, resultLength, status) }
export fn unum_getAvailable(localeIndex: i32) -> usize { return implementation.unum_getAvailable(localeIndex) }
export fn unum_countAvailable() -> i32 { return implementation.unum_countAvailable() }
export fn unum_hasAttribute(fmt: usize, attr: i32) -> bool { return implementation.unum_hasAttribute(fmt, attr) }
export fn unum_getAttribute(fmt: usize, attr: i32) -> i32 { return implementation.unum_getAttribute(fmt, attr) }
export fn unum_setAttribute(fmt: usize, attr: i32, newValue: i32) -> void { implementation.unum_setAttribute(fmt, attr, newValue) }
export fn unum_getDoubleAttribute(fmt: usize, attr: i32) -> f64 { return implementation.unum_getDoubleAttribute(fmt, attr) }
export fn unum_setDoubleAttribute(fmt: usize, attr: i32, newValue: f64) -> void { implementation.unum_setDoubleAttribute(fmt, attr, newValue) }
export fn unum_getTextAttribute(fmt: usize, tag: i32, result: usize, resultLength: i32, status: usize) -> i32 { return implementation.unum_getTextAttribute(fmt, tag, result, resultLength, status) }
export fn unum_setTextAttribute(fmt: usize, tag: i32, newValue: usize, newValueLength: i32, status: usize) -> void { implementation.unum_setTextAttribute(fmt, tag, newValue, newValueLength, status) }
export fn unum_getSymbol(fmt: usize, symbol: i32, buffer: usize, size: i32, status: usize) -> i32 { return implementation.unum_getSymbol(fmt, symbol, buffer, size, status) }
export fn unum_setSymbol(fmt: usize, symbol: i32, value: usize, length: i32, status: usize) -> void { implementation.unum_setSymbol(fmt, symbol, value, length, status) }
export fn unum_getLocaleByType(fmt: usize, type_: i32, status: usize) -> usize { return implementation.unum_getLocaleByType(fmt, type_, status) }
export fn unum_setContext(fmt: usize, value: i32, status: usize) -> void { implementation.unum_setContext(fmt, value, status) }
export fn unum_getContext(fmt: usize, type_: i32, status: usize) -> i32 { return implementation.unum_getContext(fmt, type_, status) }
