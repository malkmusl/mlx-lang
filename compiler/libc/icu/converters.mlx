// ucnv.h, ucnv_err.h and ucnv_cb.h for C: the functions of
// std.unicode.converters (std/src/unicode/converters.mlx), each calling
// the pub function of the same name there, with the same C types and
// error codes; the callbacks of ucnv_err.h call its toU* and fromU*
// functions. A converter opens with UCNV_TO_U_CALLBACK_SUBSTITUTE and
// UCNV_FROM_U_CALLBACK_SUBSTITUTE as its callbacks, as ICU's does (so that
// ucnv_getToUCallBack answers with them, and a program can tell them
// apart): their addresses are given to the implementation first.
const implementation = @import("std.unicode.converters")

fn defaults() -> void { implementation.setDefaultCallbacks(@intFromPtr(UCNV_TO_U_CALLBACK_SUBSTITUTE), @intFromPtr(UCNV_FROM_U_CALLBACK_SUBSTITUTE)) }

export fn ucnv_open(converterName: usize, err: usize) -> usize {
    defaults()
    return implementation.ucnv_open(converterName, err)
}
export fn ucnv_openU(name: usize, err: usize) -> usize {
    defaults()
    return implementation.ucnv_openU(name, err)
}
export fn ucnv_openCCSID(codepage: i32, platform: i32, err: usize) -> usize {
    defaults()
    return implementation.ucnv_openCCSID(codepage, platform, err)
}
export fn ucnv_openPackage(packageName: usize, converterName: usize, err: usize) -> usize { return implementation.ucnv_openPackage(packageName, converterName, err) }
export fn ucnv_convert(toConverterName: usize, fromConverterName: usize, target: usize, targetCapacity: i32, source: usize, sourceLength: i32, pErrorCode: usize) -> i32 {
    defaults()
    return implementation.ucnv_convert(toConverterName, fromConverterName, target, targetCapacity, source, sourceLength, pErrorCode)
}
export fn ucnv_compareNames(name1: usize, name2: usize) -> i32 { return implementation.ucnv_compareNames(name1, name2) }
export fn ucnv_clone(cnv: usize, status: usize) -> usize { return implementation.ucnv_clone(cnv, status) }
export fn ucnv_safeClone(cnv: usize, stackBuffer: usize, pBufferSize: usize, status: usize) -> usize { return implementation.ucnv_safeClone(cnv, stackBuffer, pBufferSize, status) }
export fn ucnv_close(converter: usize) -> void { implementation.ucnv_close(converter) }
export fn ucnv_getSubstChars(converter: usize, subChars: usize, len: usize, err: usize) -> void { implementation.ucnv_getSubstChars(converter, subChars, len, err) }
export fn ucnv_setSubstChars(converter: usize, subChars: usize, len: i8, err: usize) -> void { implementation.ucnv_setSubstChars(converter, subChars, len, err) }
export fn ucnv_setSubstString(cnv: usize, s: usize, length: i32, err: usize) -> void { implementation.ucnv_setSubstString(cnv, s, length, err) }
export fn ucnv_getInvalidChars(converter: usize, errBytes: usize, len: usize, err: usize) -> void { implementation.ucnv_getInvalidChars(converter, errBytes, len, err) }
export fn ucnv_getInvalidUChars(converter: usize, errUChars: usize, len: usize, err: usize) -> void { implementation.ucnv_getInvalidUChars(converter, errUChars, len, err) }
export fn ucnv_reset(converter: usize) -> void { implementation.ucnv_reset(converter) }
export fn ucnv_resetToUnicode(converter: usize) -> void { implementation.ucnv_resetToUnicode(converter) }
export fn ucnv_resetFromUnicode(converter: usize) -> void { implementation.ucnv_resetFromUnicode(converter) }
export fn ucnv_getMaxCharSize(converter: usize) -> i8 { return implementation.ucnv_getMaxCharSize(converter) }
export fn ucnv_getMinCharSize(converter: usize) -> i8 { return implementation.ucnv_getMinCharSize(converter) }
export fn ucnv_getName(converter: usize, err: usize) -> usize { return implementation.ucnv_getName(converter, err) }
export fn ucnv_getCCSID(converter: usize, err: usize) -> i32 { return implementation.ucnv_getCCSID(converter, err) }
export fn ucnv_getPlatform(converter: usize, err: usize) -> i32 { return implementation.ucnv_getPlatform(converter, err) }
export fn ucnv_getType(converter: usize) -> i32 { return implementation.ucnv_getType(converter) }
export fn ucnv_getToUCallBack(converter: usize, action: usize, context: usize) -> void { implementation.ucnv_getToUCallBack(converter, action, context) }
export fn ucnv_getFromUCallBack(converter: usize, action: usize, context: usize) -> void { implementation.ucnv_getFromUCallBack(converter, action, context) }
export fn ucnv_setToUCallBack(converter: usize, newAction: usize, newContext: usize, oldAction: usize, oldContext: usize, err: usize) -> void { implementation.ucnv_setToUCallBack(converter, newAction, newContext, oldAction, oldContext, err) }
export fn ucnv_setFromUCallBack(converter: usize, newAction: usize, newContext: usize, oldAction: usize, oldContext: usize, err: usize) -> void { implementation.ucnv_setFromUCallBack(converter, newAction, newContext, oldAction, oldContext, err) }
export fn ucnv_fromUnicode(converter: usize, target: usize, targetLimit: usize, source: usize, sourceLimit: usize, offsets: usize, flush: u8, err: usize) -> void { implementation.ucnv_fromUnicode(converter, target, targetLimit, source, sourceLimit, offsets, flush, err) }
export fn ucnv_toUnicode(converter: usize, target: usize, targetLimit: usize, source: usize, sourceLimit: usize, offsets: usize, flush: u8, err: usize) -> void { implementation.ucnv_toUnicode(converter, target, targetLimit, source, sourceLimit, offsets, flush, err) }
export fn ucnv_fromUChars(cnv: usize, dest: usize, destCapacity: i32, src: usize, srcLength: i32, pErrorCode: usize) -> i32 { return implementation.ucnv_fromUChars(cnv, dest, destCapacity, src, srcLength, pErrorCode) }
export fn ucnv_toUChars(cnv: usize, dest: usize, destCapacity: i32, src: usize, srcLength: i32, pErrorCode: usize) -> i32 { return implementation.ucnv_toUChars(cnv, dest, destCapacity, src, srcLength, pErrorCode) }
export fn ucnv_getNextUChar(converter: usize, source: usize, sourceLimit: usize, err: usize) -> i32 { return implementation.ucnv_getNextUChar(converter, source, sourceLimit, err) }
export fn ucnv_convertEx(targetCnv: usize, sourceCnv: usize, target: usize, targetLimit: usize, source: usize, sourceLimit: usize, pivotStart: usize, pivotSource: usize, pivotTarget: usize, pivotLimit: usize, reset: u8, flush: u8, pErrorCode: usize) -> void { implementation.ucnv_convertEx(targetCnv, sourceCnv, target, targetLimit, source, sourceLimit, pivotStart, pivotSource, pivotTarget, pivotLimit, reset, flush, pErrorCode) }
export fn ucnv_flushCache() -> i32 { return implementation.ucnv_flushCache() }
export fn ucnv_countAvailable() -> i32 { return implementation.ucnv_countAvailable() }
export fn ucnv_getAvailableName(n: i32) -> usize { return implementation.ucnv_getAvailableName(n) }
export fn ucnv_countAliases(alias: usize, pErrorCode: usize) -> u16 { return implementation.ucnv_countAliases(alias, pErrorCode) }
export fn ucnv_getAlias(alias: usize, n: u16, pErrorCode: usize) -> usize { return implementation.ucnv_getAlias(alias, n, pErrorCode) }
export fn ucnv_getAliases(alias: usize, aliases: usize, pErrorCode: usize) -> void { implementation.ucnv_getAliases(alias, aliases, pErrorCode) }
export fn ucnv_getStandardName(name: usize, standard: usize, pErrorCode: usize) -> usize { return implementation.ucnv_getStandardName(name, standard, pErrorCode) }
export fn ucnv_getCanonicalName(alias: usize, standard: usize, pErrorCode: usize) -> usize { return implementation.ucnv_getCanonicalName(alias, standard, pErrorCode) }
export fn ucnv_getDefaultName() -> usize { return implementation.ucnv_getDefaultName() }
export fn ucnv_setDefaultName(name: usize) -> void { implementation.ucnv_setDefaultName(name) }
export fn ucnv_fixFileSeparator(cnv: usize, source: usize, sourceLen: i32) -> void { implementation.ucnv_fixFileSeparator(cnv, source, sourceLen) }
export fn ucnv_isAmbiguous(cnv: usize) -> u8 { return implementation.ucnv_isAmbiguous(cnv) }
export fn ucnv_setFallback(cnv: usize, usesFallback: u8) -> void { implementation.ucnv_setFallback(cnv, usesFallback) }
export fn ucnv_usesFallback(cnv: usize) -> u8 { return implementation.ucnv_usesFallback(cnv) }
export fn ucnv_detectUnicodeSignature(source: usize, sourceLength: i32, signatureLength: usize, pErrorCode: usize) -> usize { return implementation.ucnv_detectUnicodeSignature(source, sourceLength, signatureLength, pErrorCode) }
export fn ucnv_fromUCountPending(cnv: usize, status: usize) -> i32 { return implementation.ucnv_fromUCountPending(cnv, status) }
export fn ucnv_toUCountPending(cnv: usize, status: usize) -> i32 { return implementation.ucnv_toUCountPending(cnv, status) }
export fn ucnv_isFixedWidth(cnv: usize, status: usize) -> u8 { return implementation.ucnv_isFixedWidth(cnv, status) }

export fn ucnv_cbFromUWriteBytes(args: usize, source: usize, length: i32, offsetIndex: i32, err: usize) -> void { implementation.ucnv_cbFromUWriteBytes(args, source, length, offsetIndex, err) }
export fn ucnv_cbFromUWriteSub(args: usize, offsetIndex: i32, err: usize) -> void { implementation.ucnv_cbFromUWriteSub(args, offsetIndex, err) }
export fn ucnv_cbFromUWriteUChars(args: usize, source: usize, sourceLimit: usize, offsetIndex: i32, err: usize) -> void { implementation.ucnv_cbFromUWriteUChars(args, source, sourceLimit, offsetIndex, err) }
export fn ucnv_cbToUWriteUChars(args: usize, source: usize, length: i32, offsetIndex: i32, err: usize) -> void { implementation.ucnv_cbToUWriteUChars(args, source, length, offsetIndex, err) }
export fn ucnv_cbToUWriteSub(args: usize, offsetIndex: i32, err: usize) -> void { implementation.ucnv_cbToUWriteSub(args, offsetIndex, err) }

export fn UCNV_FROM_U_CALLBACK_STOP(context: usize, fromUArgs: usize, codeUnits: usize, length: i32, codePoint: i32, reason: i32, err: usize) -> void { implementation.fromUStop(context, fromUArgs, codeUnits, length, codePoint, reason, err) }
export fn UCNV_FROM_U_CALLBACK_SKIP(context: usize, fromUArgs: usize, codeUnits: usize, length: i32, codePoint: i32, reason: i32, err: usize) -> void { implementation.fromUSkip(context, fromUArgs, codeUnits, length, codePoint, reason, err) }
export fn UCNV_FROM_U_CALLBACK_SUBSTITUTE(context: usize, fromUArgs: usize, codeUnits: usize, length: i32, codePoint: i32, reason: i32, err: usize) -> void { implementation.fromUSubstitute(context, fromUArgs, codeUnits, length, codePoint, reason, err) }
export fn UCNV_FROM_U_CALLBACK_ESCAPE(context: usize, fromUArgs: usize, codeUnits: usize, length: i32, codePoint: i32, reason: i32, err: usize) -> void { implementation.fromUEscape(context, fromUArgs, codeUnits, length, codePoint, reason, err) }
export fn UCNV_TO_U_CALLBACK_STOP(context: usize, toUArgs: usize, codeUnits: usize, length: i32, reason: i32, err: usize) -> void { implementation.toUStop(context, toUArgs, codeUnits, length, reason, err) }
export fn UCNV_TO_U_CALLBACK_SKIP(context: usize, toUArgs: usize, codeUnits: usize, length: i32, reason: i32, err: usize) -> void { implementation.toUSkip(context, toUArgs, codeUnits, length, reason, err) }
export fn UCNV_TO_U_CALLBACK_SUBSTITUTE(context: usize, toUArgs: usize, codeUnits: usize, length: i32, reason: i32, err: usize) -> void { implementation.toUSubstitute(context, toUArgs, codeUnits, length, reason, err) }
export fn UCNV_TO_U_CALLBACK_ESCAPE(context: usize, toUArgs: usize, codeUnits: usize, length: i32, reason: i32, err: usize) -> void { implementation.toUEscape(context, toUArgs, codeUnits, length, reason, err) }
