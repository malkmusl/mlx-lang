// upluralrules.h for C: the functions of std.unicode.format.plural
// (std/src/unicode/format/plural.mlx), each calling the pub function of the
// same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.plural")

export fn uplrules_openForType(localeId: usize, type_: i32, status: usize) -> usize { return implementation.uplrules_openForType(localeId, type_, status) }
export fn uplrules_open(localeId: usize, status: usize) -> usize { return implementation.uplrules_open(localeId, status) }
export fn uplrules_close(uplrules: usize) -> void { implementation.uplrules_close(uplrules) }
export fn uplrules_select(uplrules: usize, number: f64, keyword: usize, capacity: i32, status: usize) -> i32 { return implementation.uplrules_select(uplrules, number, keyword, capacity, status) }
export fn uplrules_selectFormatted(uplrules: usize, number: usize, keyword: usize, capacity: i32, status: usize) -> i32 { return implementation.uplrules_selectFormatted(uplrules, number, keyword, capacity, status) }
export fn uplrules_selectForRange(uplrules: usize, urange: usize, keyword: usize, capacity: i32, status: usize) -> i32 { return implementation.uplrules_selectForRange(uplrules, urange, keyword, capacity, status) }
export fn uplrules_getKeywords(uplrules: usize, status: usize) -> usize { return implementation.uplrules_getKeywords(uplrules, status) }
