// libmlxunicode.so: Unicode for C and C++ programs, with the C API of
// ICU (declared by the modules of api/, whose C headers mlx-cheaders
// makes), for WebKit and what else is built here. The implementation is
// std.unicode (std/src/unicode.mlx and std/src/unicode/), with the time
// zones of std.timezone.database; each module here exports one part's C
// functions, each calling the pub function of the same name there.
//
//     ./mlx build unicode
//
// The parts: properties.mlx (uchar.h, uscript.h), casing.mlx and
// strings.mlx (ustring.h), normalize.mlx (unorm2.h), breaks.mlx (ubrk.h,
// utext.h), collation.mlx (ucol.h, uiter.h), calendar.mlx (ucal.h),
// idna.mlx (uidna.h), charsets.mlx (ucsdet.h), localeid.mlx (uloc.h),
// displaynames.mlx (uldnames.h), bundles.mlx (ures.h), enumeration.mlx
// (uenum.h), formatted.mlx (uformattedvalue.h), numberformat.mlx
// (unumberformatter.h), numberrange.mlx (unumberrangeformatter.h),
// decimalformat.mlx (unum.h), numbersystems.mlx (unumsys.h),
// currency.mlx (ucurr.h), pluralrules.mlx (upluralrules.h),
// listformat.mlx (ulistformatter.h), reltime.mlx (ureldatefmt.h),
// simpledateformat.mlx (udat.h), patterngenerator.mlx (udatpg.h),
// dateintervals.mlx (udateintervalformat.h), timezonenames.mlx,
// bidi.mlx (ubidi.h), search.mlx (usearch.h), converters.mlx (ucnv.h,
// ucnv_err.h, ucnv_cb.h), sets.mlx (uset.h).
const properties = @import("./properties.mlx")
const casing = @import("./casing.mlx")
const strings = @import("./strings.mlx")
const normalize = @import("./normalize.mlx")
const breaks = @import("./breaks.mlx")
const enumeration = @import("./enumeration.mlx")
const collation = @import("./collation.mlx")
const calendar = @import("./calendar.mlx")
const idna = @import("./idna.mlx")
const charsets = @import("./charsets.mlx")
const localeid = @import("./localeid.mlx")
const displaynames = @import("./displaynames.mlx")
const bundles = @import("./bundles.mlx")
const formatted = @import("./formatted.mlx")
const numberformat = @import("./numberformat.mlx")
const numberrange = @import("./numberrange.mlx")
const decimalformat = @import("./decimalformat.mlx")
const numbersystems = @import("./numbersystems.mlx")
const currency = @import("./currency.mlx")
const pluralrules = @import("./pluralrules.mlx")
const listformat = @import("./listformat.mlx")
const reltime = @import("./reltime.mlx")
const simpledateformat = @import("./simpledateformat.mlx")
const patterngenerator = @import("./patterngenerator.mlx")
const dateintervals = @import("./dateintervals.mlx")
const timezonenames = @import("./timezonenames.mlx")
const bidi = @import("./bidi.mlx")
const search = @import("./search.mlx")
const converters = @import("./converters.mlx")
const sets = @import("./sets.mlx")
