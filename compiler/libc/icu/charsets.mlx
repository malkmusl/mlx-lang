// ucsdet.h for C: the functions of std.unicode.charsets
// (std/src/unicode/charsets.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.charsets")

export fn ucsdet_open(status: usize) -> usize { return implementation.ucsdet_open(status) }
export fn ucsdet_close(ucsd: usize) -> void { implementation.ucsdet_close(ucsd) }
export fn ucsdet_setText(ucsd: usize, textIn: usize, len: i32, status: usize) -> void { implementation.ucsdet_setText(ucsd, textIn, len, status) }
export fn ucsdet_setDeclaredEncoding(ucsd: usize, encoding: usize, length: i32, status: usize) -> void { implementation.ucsdet_setDeclaredEncoding(ucsd, encoding, length, status) }
export fn ucsdet_detectAll(ucsd: usize, matchesFound: usize, status: usize) -> usize { return implementation.ucsdet_detectAll(ucsd, matchesFound, status) }
export fn ucsdet_detect(ucsd: usize, status: usize) -> usize { return implementation.ucsdet_detect(ucsd, status) }
export fn ucsdet_getName(ucsm: usize, status: usize) -> usize { return implementation.ucsdet_getName(ucsm, status) }
export fn ucsdet_getConfidence(ucsm: usize, status: usize) -> i32 { return implementation.ucsdet_getConfidence(ucsm, status) }
export fn ucsdet_getLanguage(ucsm: usize, status: usize) -> usize { return implementation.ucsdet_getLanguage(ucsm, status) }
export fn ucsdet_getUChars(ucsm: usize, buf: usize, cap: i32, status: usize) -> i32 { return implementation.ucsdet_getUChars(ucsm, buf, cap, status) }
export fn ucsdet_getAllDetectableCharsets(ucsd: usize, status: usize) -> usize { return implementation.ucsdet_getAllDetectableCharsets(ucsd, status) }
export fn ucsdet_getDetectableCharsets(ucsd: usize, status: usize) -> usize { return implementation.ucsdet_getDetectableCharsets(ucsd, status) }
export fn ucsdet_setDetectableCharset(ucsd: usize, encoding: usize, enabled: u8, status: usize) -> void { implementation.ucsdet_setDetectableCharset(ucsd, encoding, enabled, status) }
export fn ucsdet_isInputFilterEnabled(ucsd: usize) -> u8 { return implementation.ucsdet_isInputFilterEnabled(ucsd) }
export fn ucsdet_enableInputFilter(ucsd: usize, filter: u8) -> u8 { return implementation.ucsdet_enableInputFilter(ucsd, filter) }
