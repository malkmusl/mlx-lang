// unumsys.h for C: the functions of std.unicode.format.number.systems
// (std/src/unicode/format/number/systems.mlx), each calling the pub
// function of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.number.systems")

export fn unumsys_open(localeId: usize, status: usize) -> usize { return implementation.unumsys_open(localeId, status) }
export fn unumsys_openByName(name: usize, status: usize) -> usize { return implementation.unumsys_openByName(name, status) }
export fn unumsys_close(unumsys: usize) -> void { implementation.unumsys_close(unumsys) }
export fn unumsys_openAvailableNames(status: usize) -> usize { return implementation.unumsys_openAvailableNames(status) }
export fn unumsys_getName(unumsys: usize) -> usize { return implementation.unumsys_getName(unumsys) }
export fn unumsys_isAlgorithmic(unumsys: usize) -> bool { return implementation.unumsys_isAlgorithmic(unumsys) }
export fn unumsys_getRadix(unumsys: usize) -> i32 { return implementation.unumsys_getRadix(unumsys) }
export fn unumsys_getDescription(unumsys: usize, result: usize, resultLength: i32, status: usize) -> i32 { return implementation.unumsys_getDescription(unumsys, result, resultLength, status) }
