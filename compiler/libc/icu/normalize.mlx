// unorm2.h for C: the functions of std.unicode.normalize
// (std/src/unicode/normalize.mlx), each calling the pub function of the
// same name there, with the same C types and error codes.
const implementation = @import("std.unicode.normalize")

export fn unorm2_getNFCInstance(status: usize) -> usize { return implementation.unorm2_getNFCInstance(status) }
export fn unorm2_getNFDInstance(status: usize) -> usize { return implementation.unorm2_getNFDInstance(status) }
export fn unorm2_getNFKCInstance(status: usize) -> usize { return implementation.unorm2_getNFKCInstance(status) }
export fn unorm2_getNFKDInstance(status: usize) -> usize { return implementation.unorm2_getNFKDInstance(status) }
export fn unorm2_getNFKCCasefoldInstance(status: usize) -> usize { return implementation.unorm2_getNFKCCasefoldInstance(status) }
export fn unorm2_getInstance(package: usize, name: usize, mode: i32, status: usize) -> usize { return implementation.unorm2_getInstance(package, name, mode, status) }
export fn unorm2_close(norm: usize) -> void { implementation.unorm2_close(norm) }
export fn unorm2_normalize(norm: usize, src: usize, length: i32, dest: usize, capacity: i32, status: usize) -> i32 { return implementation.unorm2_normalize(norm, src, length, dest, capacity, status) }
export fn unorm2_normalizeSecondAndAppend(norm: usize, first: usize, firstLength: i32, capacity: i32, second: usize, secondLength: i32, status: usize) -> i32 { return implementation.unorm2_normalizeSecondAndAppend(norm, first, firstLength, capacity, second, secondLength, status) }
export fn unorm2_append(norm: usize, first: usize, firstLength: i32, capacity: i32, second: usize, secondLength: i32, status: usize) -> i32 { return implementation.unorm2_append(norm, first, firstLength, capacity, second, secondLength, status) }
export fn unorm2_isNormalized(norm: usize, s: usize, length: i32, status: usize) -> u8 { return implementation.unorm2_isNormalized(norm, s, length, status) }
export fn unorm2_quickCheck(norm: usize, s: usize, length: i32, status: usize) -> i32 { return implementation.unorm2_quickCheck(norm, s, length, status) }
export fn unorm2_spanQuickCheckYes(norm: usize, s: usize, length: i32, status: usize) -> i32 { return implementation.unorm2_spanQuickCheckYes(norm, s, length, status) }
export fn unorm2_getDecomposition(norm: usize, c: i32, dest: usize, capacity: i32, status: usize) -> i32 { return implementation.unorm2_getDecomposition(norm, c, dest, capacity, status) }
export fn unorm2_getRawDecomposition(norm: usize, c: i32, dest: usize, capacity: i32, status: usize) -> i32 { return implementation.unorm2_getRawDecomposition(norm, c, dest, capacity, status) }
export fn unorm2_composePair(norm: usize, a: i32, b: i32) -> i32 { return implementation.unorm2_composePair(norm, a, b) }
export fn unorm2_getCombiningClass(norm: usize, c: i32) -> u8 { return implementation.unorm2_getCombiningClass(norm, c) }
export fn unorm2_hasBoundaryBefore(norm: usize, c: i32) -> u8 { return implementation.unorm2_hasBoundaryBefore(norm, c) }
export fn unorm2_hasBoundaryAfter(norm: usize, c: i32) -> u8 { return implementation.unorm2_hasBoundaryAfter(norm, c) }
export fn unorm2_isInert(norm: usize, c: i32) -> u8 { return implementation.unorm2_isInert(norm, c) }
