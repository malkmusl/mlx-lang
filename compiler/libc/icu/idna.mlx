// uidna.h for C: the functions of std.unicode.idna
// (std/src/unicode/idna.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.idna")

export fn uidna_openUTS46(options: u32, status: usize) -> usize { return implementation.uidna_openUTS46(options, status) }
export fn uidna_close(idna: usize) -> void { implementation.uidna_close(idna) }
export fn uidna_labelToASCII(idna: usize, label: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return implementation.uidna_labelToASCII(idna, label, length, dest, capacity, pInfo, status) }
export fn uidna_labelToUnicode(idna: usize, label: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return implementation.uidna_labelToUnicode(idna, label, length, dest, capacity, pInfo, status) }
export fn uidna_nameToASCII(idna: usize, name: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return implementation.uidna_nameToASCII(idna, name, length, dest, capacity, pInfo, status) }
export fn uidna_nameToUnicode(idna: usize, name: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return implementation.uidna_nameToUnicode(idna, name, length, dest, capacity, pInfo, status) }
export fn uidna_nameToASCII_UTF8(idna: usize, name: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return implementation.uidna_nameToASCII_UTF8(idna, name, length, dest, capacity, pInfo, status) }
export fn uidna_nameToUnicodeUTF8(idna: usize, name: usize, length: i32, dest: usize, capacity: i32, pInfo: usize, status: usize) -> i32 { return implementation.uidna_nameToUnicodeUTF8(idna, name, length, dest, capacity, pInfo, status) }
