// ucol.h, uiter.h for C: the functions of std.unicode.collation
// (std/src/unicode/collation.mlx), each calling the pub function of the
// same name there, with the same C types and error codes.
const implementation = @import("std.unicode.collation")

export fn ucol_open(locale: usize, status: usize) -> usize { return implementation.ucol_open(locale, status) }
export fn ucol_openRules(rules: usize, length: i32, normalizationMode: i32, strength: i32, parseError: usize, status: usize) -> usize { return implementation.ucol_openRules(rules, length, normalizationMode, strength, parseError, status) }
export fn ucol_close(coll: usize) -> void { implementation.ucol_close(coll) }
export fn ucol_clone(coll: usize, status: usize) -> usize { return implementation.ucol_clone(coll, status) }
export fn ucol_safeClone(coll: usize, stackBuffer: usize, bufferSize: usize, status: usize) -> usize { return implementation.ucol_safeClone(coll, stackBuffer, bufferSize, status) }
export fn ucol_setAttribute(coll: usize, which: i32, value: i32, status: usize) -> void { implementation.ucol_setAttribute(coll, which, value, status) }
export fn ucol_getAttribute(coll: usize, which: i32, status: usize) -> i32 { return implementation.ucol_getAttribute(coll, which, status) }
export fn ucol_setStrength(coll: usize, strength: i32) -> void { implementation.ucol_setStrength(coll, strength) }
export fn ucol_getStrength(coll: usize) -> i32 { return implementation.ucol_getStrength(coll) }
export fn ucol_strcoll(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32) -> i32 { return implementation.ucol_strcoll(coll, source, sourceLength, target, targetLength) }
export fn ucol_equal(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32) -> u8 { return implementation.ucol_equal(coll, source, sourceLength, target, targetLength) }
export fn ucol_greater(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32) -> u8 { return implementation.ucol_greater(coll, source, sourceLength, target, targetLength) }
export fn ucol_greaterOrEqual(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32) -> u8 { return implementation.ucol_greaterOrEqual(coll, source, sourceLength, target, targetLength) }
export fn ucol_strcollUTF8(coll: usize, source: usize, sourceLength: i32, target: usize, targetLength: i32, status: usize) -> i32 { return implementation.ucol_strcollUTF8(coll, source, sourceLength, target, targetLength, status) }
export fn uiter_setString(it: usize, s: usize, length: i32) -> void { implementation.uiter_setString(it, s, length) }
export fn uiter_setUTF8(it: usize, s: usize, length: i32) -> void { implementation.uiter_setUTF8(it, s, length) }
export fn uiter_current32(it: usize) -> i32 { return implementation.uiter_current32(it) }
export fn uiter_next32(it: usize) -> i32 { return implementation.uiter_next32(it) }
export fn uiter_previous32(it: usize) -> i32 { return implementation.uiter_previous32(it) }
export fn uiter_getState(it: usize) -> u32 { return implementation.uiter_getState(it) }
export fn uiter_setState(it: usize, state: u32, status: usize) -> void { implementation.uiter_setState(it, state, status) }
export fn ucol_strcollIter(coll: usize, first: usize, second: usize, status: usize) -> i32 { return implementation.ucol_strcollIter(coll, first, second, status) }
export fn ucol_getSortKey(coll: usize, source: usize, length: i32, result: usize, capacity: i32) -> i32 { return implementation.ucol_getSortKey(coll, source, length, result, capacity) }
export fn ucol_countAvailable() -> i32 { return implementation.ucol_countAvailable() }
export fn ucol_getAvailable(index: i32) -> usize { return implementation.ucol_getAvailable(index) }
export fn ucol_openAvailableLocales(status: usize) -> usize { return implementation.ucol_openAvailableLocales(status) }
export fn ucol_getKeywords(status: usize) -> usize { return implementation.ucol_getKeywords(status) }
export fn ucol_getKeywordValues(keyword: usize, status: usize) -> usize { return implementation.ucol_getKeywordValues(keyword, status) }
export fn ucol_getKeywordValuesForLocale(key: usize, locale: usize, commonlyUsed: i8, status: usize) -> usize { return implementation.ucol_getKeywordValuesForLocale(key, locale, commonlyUsed, status) }
export fn ucol_getLocaleByType(coll: usize, kind: i32, status: usize) -> usize { return implementation.ucol_getLocaleByType(coll, kind, status) }
export fn ucol_getReorderCodes(coll: usize, dest: usize, capacity: i32, status: usize) -> i32 { return implementation.ucol_getReorderCodes(coll, dest, capacity, status) }
export fn ucol_setReorderCodes(coll: usize, codes: usize, length: i32, status: usize) -> void { implementation.ucol_setReorderCodes(coll, codes, length, status) }
export fn ucol_getRules(coll: usize, length: usize) -> usize { return implementation.ucol_getRules(coll, length) }
export fn ucol_getVersion(coll: usize, version: usize) -> void { implementation.ucol_getVersion(coll, version) }
export fn ucol_getUCAVersion(coll: usize, version: usize) -> void { implementation.ucol_getUCAVersion(coll, version) }
export fn ucol_getMaxVariable(coll: usize) -> i32 { return implementation.ucol_getMaxVariable(coll) }
export fn ucol_setMaxVariable(coll: usize, group: i32, status: usize) -> void { implementation.ucol_setMaxVariable(coll, group, status) }
export fn ucol_getVariableTop(coll: usize, status: usize) -> u32 { return implementation.ucol_getVariableTop(coll, status) }
export fn ucol_setVariableTop(coll: usize, varTop: usize, length: i32, status: usize) -> u32 { return implementation.ucol_setVariableTop(coll, varTop, length, status) }
export fn ucol_restoreVariableTop(coll: usize, varTop: u32, status: usize) -> void { implementation.ucol_restoreVariableTop(coll, varTop, status) }
