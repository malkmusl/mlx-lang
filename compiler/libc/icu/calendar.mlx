// ucal.h for C: the functions of std.unicode.calendar
// (std/src/unicode/calendar.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.calendar")

export fn ucal_getNow() -> f64 { return implementation.ucal_getNow() }
export fn ucal_open(zoneID: usize, len: i32, localeId: usize, kind: i32, status: usize) -> usize { return implementation.ucal_open(zoneID, len, localeId, kind, status) }
export fn ucal_close(cal: usize) -> void { implementation.ucal_close(cal) }
export fn ucal_clone(cal: usize, status: usize) -> usize { return implementation.ucal_clone(cal, status) }
export fn ucal_setTimeZone(cal: usize, zoneID: usize, len: i32, status: usize) -> void { implementation.ucal_setTimeZone(cal, zoneID, len, status) }
export fn ucal_getTimeZoneID(cal: usize, result: usize, resultLength: i32, status: usize) -> i32 { return implementation.ucal_getTimeZoneID(cal, result, resultLength, status) }
export fn ucal_getDefaultTimeZone(result: usize, resultCapacity: i32, status: usize) -> i32 { return implementation.ucal_getDefaultTimeZone(result, resultCapacity, status) }
export fn ucal_setDefaultTimeZone(zoneID: usize, status: usize) -> void { implementation.ucal_setDefaultTimeZone(zoneID, status) }
export fn ucal_getHostTimeZone(result: usize, resultCapacity: i32, status: usize) -> i32 { return implementation.ucal_getHostTimeZone(result, resultCapacity, status) }
export fn ucal_getTZDataVersion(status: usize) -> usize { return implementation.ucal_getTZDataVersion(status) }
export fn ucal_getCanonicalTimeZoneID(id: usize, len: i32, result: usize, resultCapacity: i32, isSystemID: usize, status: usize) -> i32 { return implementation.ucal_getCanonicalTimeZoneID(id, len, result, resultCapacity, isSystemID, status) }
export fn ucal_getIanaTimeZoneID(id: usize, len: i32, result: usize, resultCapacity: i32, status: usize) -> i32 { return implementation.ucal_getIanaTimeZoneID(id, len, result, resultCapacity, status) }
export fn ucal_getWindowsTimeZoneID(id: usize, len: i32, winid: usize, winidCapacity: i32, status: usize) -> i32 { return implementation.ucal_getWindowsTimeZoneID(id, len, winid, winidCapacity, status) }
export fn ucal_getTimeZoneIDForWindowsID(winid: usize, len: i32, region: usize, id: usize, idCapacity: i32, status: usize) -> i32 { return implementation.ucal_getTimeZoneIDForWindowsID(winid, len, region, id, idCapacity, status) }
export fn ucal_openTimeZoneIDEnumeration(zoneType: i32, region: usize, rawOffset: usize, ec: usize) -> usize { return implementation.ucal_openTimeZoneIDEnumeration(zoneType, region, rawOffset, ec) }
export fn ucal_openTimeZones(ec: usize) -> usize { return implementation.ucal_openTimeZones(ec) }
export fn ucal_openCountryTimeZones(country: usize, ec: usize) -> usize { return implementation.ucal_openCountryTimeZones(country, ec) }
export fn ucal_getDSTSavings(zoneID: usize, ec: usize) -> i32 { return implementation.ucal_getDSTSavings(zoneID, ec) }
export fn ucal_inDaylightTime(cal: usize, status: usize) -> u8 { return implementation.ucal_inDaylightTime(cal, status) }
export fn ucal_setGregorianChange(cal: usize, date: f64, status: usize) -> void { implementation.ucal_setGregorianChange(cal, date, status) }
export fn ucal_getGregorianChange(cal: usize, status: usize) -> f64 { return implementation.ucal_getGregorianChange(cal, status) }
export fn ucal_getAttribute(cal: usize, attr: i32) -> i32 { return implementation.ucal_getAttribute(cal, attr) }
export fn ucal_setAttribute(cal: usize, attr: i32, newValue: i32) -> void { implementation.ucal_setAttribute(cal, attr, newValue) }
export fn ucal_getAvailable(localeIndex: i32) -> usize { return implementation.ucal_getAvailable(localeIndex) }
export fn ucal_countAvailable() -> i32 { return implementation.ucal_countAvailable() }
export fn ucal_getMillis(cal: usize, status: usize) -> f64 { return implementation.ucal_getMillis(cal, status) }
export fn ucal_setMillis(cal: usize, dateTime: f64, status: usize) -> void { implementation.ucal_setMillis(cal, dateTime, status) }
export fn ucal_setDate(cal: usize, year: i32, month: i32, date: i32, status: usize) -> void { implementation.ucal_setDate(cal, year, month, date, status) }
export fn ucal_setDateTime(cal: usize, year: i32, month: i32, date: i32, hour: i32, minute: i32, second: i32, status: usize) -> void { implementation.ucal_setDateTime(cal, year, month, date, hour, minute, second, status) }
export fn ucal_equivalentTo(cal1: usize, cal2: usize) -> u8 { return implementation.ucal_equivalentTo(cal1, cal2) }
export fn ucal_add(cal: usize, field: i32, amount: i32, status: usize) -> void { implementation.ucal_add(cal, field, amount, status) }
export fn ucal_roll(cal: usize, field: i32, amount: i32, status: usize) -> void { implementation.ucal_roll(cal, field, amount, status) }
export fn ucal_get(cal: usize, field: i32, status: usize) -> i32 { return implementation.ucal_get(cal, field, status) }
export fn ucal_set(cal: usize, field: i32, value: i32) -> void { implementation.ucal_set(cal, field, value) }
export fn ucal_isSet(cal: usize, field: i32) -> u8 { return implementation.ucal_isSet(cal, field) }
export fn ucal_clearField(cal: usize, field: i32) -> void { implementation.ucal_clearField(cal, field) }
export fn ucal_clear(calendar_: usize) -> void { implementation.ucal_clear(calendar_) }
export fn ucal_getLimit(cal: usize, field: i32, kind: i32, status: usize) -> i32 { return implementation.ucal_getLimit(cal, field, kind, status) }
export fn ucal_getLocaleByType(cal: usize, kind: i32, status: usize) -> usize { return implementation.ucal_getLocaleByType(cal, kind, status) }
export fn ucal_getType(cal: usize, status: usize) -> usize { return implementation.ucal_getType(cal, status) }
export fn ucal_getKeywordValuesForLocale(key: usize, localeId: usize, commonlyUsed: u8, status: usize) -> usize { return implementation.ucal_getKeywordValuesForLocale(key, localeId, commonlyUsed, status) }
export fn ucal_getDayOfWeekType(cal: usize, dayOfWeek: i32, status: usize) -> i32 { return implementation.ucal_getDayOfWeekType(cal, dayOfWeek, status) }
export fn ucal_getWeekendTransition(cal: usize, dayOfWeek: i32, status: usize) -> i32 { return implementation.ucal_getWeekendTransition(cal, dayOfWeek, status) }
export fn ucal_isWeekend(cal: usize, date: f64, status: usize) -> u8 { return implementation.ucal_isWeekend(cal, date, status) }
export fn ucal_getFieldDifference(cal: usize, target: f64, field: i32, status: usize) -> i32 { return implementation.ucal_getFieldDifference(cal, target, field, status) }
export fn ucal_getTimeZoneTransitionDate(cal: usize, kind: i32, transition: usize, status: usize) -> u8 { return implementation.ucal_getTimeZoneTransitionDate(cal, kind, transition, status) }
export fn ucal_getTimeZoneOffsetFromLocal(cal: usize, nonExistingTimeOpt: i32, duplicatedTimeOpt: i32, rawOffset: usize, dstOffset: usize, status: usize) -> void { implementation.ucal_getTimeZoneOffsetFromLocal(cal, nonExistingTimeOpt, duplicatedTimeOpt, rawOffset, dstOffset, status) }
