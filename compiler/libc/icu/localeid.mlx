// uloc.h for C: the functions of std.unicode.locale
// (std/src/unicode/locale.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.locale")

export fn uloc_getDefault() -> usize { return implementation.uloc_getDefault() }
export fn uloc_setDefault(localeID: usize, status: usize) -> void { implementation.uloc_setDefault(localeID, status) }
export fn uloc_getLanguage(localeID: usize, language: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_getLanguage(localeID, language, capacity, err) }
export fn uloc_getScript(localeID: usize, script: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_getScript(localeID, script, capacity, err) }
export fn uloc_getCountry(localeID: usize, country: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_getCountry(localeID, country, capacity, err) }
export fn uloc_getVariant(localeID: usize, variant: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_getVariant(localeID, variant, capacity, err) }
export fn uloc_getName(localeID: usize, name: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_getName(localeID, name, capacity, err) }
export fn uloc_canonicalize(localeID: usize, name: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_canonicalize(localeID, name, capacity, err) }
export fn uloc_getBaseName(localeID: usize, name: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_getBaseName(localeID, name, capacity, err) }
export fn uloc_getParent(localeID: usize, parent: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_getParent(localeID, parent, capacity, err) }
export fn uloc_openKeywords(localeID: usize, status: usize) -> usize { return implementation.uloc_openKeywords(localeID, status) }
export fn uloc_getKeywordValue(localeID: usize, keywordName: usize, buffer: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_getKeywordValue(localeID, keywordName, buffer, capacity, status) }
export fn uloc_setKeywordValue(keywordName: usize, keywordValue: usize, buffer: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_setKeywordValue(keywordName, keywordValue, buffer, capacity, status) }
export fn uloc_forLanguageTag(langtag: usize, localeID: usize, capacity: i32, parsedLength: usize, err: usize) -> i32 { return implementation.uloc_forLanguageTag(langtag, localeID, capacity, parsedLength, err) }
export fn uloc_toLanguageTag(localeID: usize, langtag: usize, capacity: i32, strict: u8, err: usize) -> i32 { return implementation.uloc_toLanguageTag(localeID, langtag, capacity, strict, err) }
export fn uloc_addLikelySubtags(localeID: usize, maximized: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_addLikelySubtags(localeID, maximized, capacity, err) }
export fn uloc_minimizeSubtags(localeID: usize, minimized: usize, capacity: i32, err: usize) -> i32 { return implementation.uloc_minimizeSubtags(localeID, minimized, capacity, err) }
export fn uloc_isRightToLeft(localeID: usize) -> u8 { return implementation.uloc_isRightToLeft(localeID) }
export fn uloc_getCharacterOrientation(localeID: usize, status: usize) -> i32 { return implementation.uloc_getCharacterOrientation(localeID, status) }
export fn uloc_getLineOrientation(localeID: usize, status: usize) -> i32 { return implementation.uloc_getLineOrientation(localeID, status) }
export fn uloc_countAvailable() -> i32 { return implementation.uloc_countAvailable() }
export fn uloc_getAvailable(n: i32) -> usize { return implementation.uloc_getAvailable(n) }
export fn uloc_openAvailableByType(kind: i32, status: usize) -> usize { return implementation.uloc_openAvailableByType(kind, status) }
export fn uloc_toUnicodeLocaleKey(keyword: usize) -> usize { return implementation.uloc_toUnicodeLocaleKey(keyword) }
export fn uloc_toLegacyKey(keyword: usize) -> usize { return implementation.uloc_toLegacyKey(keyword) }
export fn uloc_toUnicodeLocaleType(keyword: usize, value: usize) -> usize { return implementation.uloc_toUnicodeLocaleType(keyword, value) }
export fn uloc_toLegacyType(keyword: usize, value: usize) -> usize { return implementation.uloc_toLegacyType(keyword, value) }
export fn uloc_getISO3Language(localeID: usize) -> usize { return implementation.uloc_getISO3Language(localeID) }
export fn uloc_getISO3Country(localeID: usize) -> usize { return implementation.uloc_getISO3Country(localeID) }
export fn uloc_getDisplayLanguage(locale_: usize, displayLocale: usize, language: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_getDisplayLanguage(locale_, displayLocale, language, capacity, status) }
export fn uloc_getDisplayScript(locale_: usize, displayLocale: usize, script: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_getDisplayScript(locale_, displayLocale, script, capacity, status) }
export fn uloc_getDisplayCountry(locale_: usize, displayLocale: usize, country: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_getDisplayCountry(locale_, displayLocale, country, capacity, status) }
export fn uloc_getDisplayVariant(locale_: usize, displayLocale: usize, variant: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_getDisplayVariant(locale_, displayLocale, variant, capacity, status) }
export fn uloc_getDisplayName(localeID: usize, inLocaleID: usize, result: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_getDisplayName(localeID, inLocaleID, result, capacity, status) }
export fn uloc_getDisplayKeyword(keyword: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_getDisplayKeyword(keyword, displayLocale, dest, capacity, status) }
export fn uloc_getDisplayKeywordValue(localeID: usize, keyword: usize, displayLocale: usize, dest: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_getDisplayKeywordValue(localeID, keyword, displayLocale, dest, capacity, status) }
export fn uloc_getISOLanguages() -> usize { return implementation.uloc_getISOLanguages() }
export fn uloc_getISOCountries() -> usize { return implementation.uloc_getISOCountries() }
export fn uloc_getLCID(localeID: usize) -> u32 { return implementation.uloc_getLCID(localeID) }
export fn uloc_getLocaleForLCID(hostID: u32, locale_: usize, capacity: i32, status: usize) -> i32 { return implementation.uloc_getLocaleForLCID(hostID, locale_, capacity, status) }
export fn uloc_acceptLanguage(result: usize, capacity: i32, outResult: usize, acceptList: usize, acceptListCount: i32, availableLocales: usize, status: usize) -> i32 { return implementation.uloc_acceptLanguage(result, capacity, outResult, acceptList, acceptListCount, availableLocales, status) }
