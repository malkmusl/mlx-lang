// ucurr.h for C: the functions of std.unicode.format.number.currency
// (std/src/unicode/format/number/currency.mlx), each calling the pub
// function of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.number.currency")

export fn ucurr_getName(currency: usize, localeId: usize, nameStyle: i32, isChoiceFormat: usize, len: usize, ec: usize) -> usize { return implementation.ucurr_getName(currency, localeId, nameStyle, isChoiceFormat, len, ec) }
export fn ucurr_getPluralName(currency: usize, localeId: usize, isChoiceFormat: usize, pluralCount: usize, len: usize, ec: usize) -> usize { return implementation.ucurr_getPluralName(currency, localeId, isChoiceFormat, pluralCount, len, ec) }
export fn ucurr_getDefaultFractionDigitsForUsage(currency: usize, usage: i32, ec: usize) -> i32 { return implementation.ucurr_getDefaultFractionDigitsForUsage(currency, usage, ec) }
export fn ucurr_getDefaultFractionDigits(currency: usize, ec: usize) -> i32 { return implementation.ucurr_getDefaultFractionDigits(currency, ec) }
export fn ucurr_getRoundingIncrementForUsage(currency: usize, usage: i32, ec: usize) -> f64 { return implementation.ucurr_getRoundingIncrementForUsage(currency, usage, ec) }
export fn ucurr_getRoundingIncrement(currency: usize, ec: usize) -> f64 { return implementation.ucurr_getRoundingIncrement(currency, ec) }
export fn ucurr_forLocale(localeId: usize, buff: usize, buffCapacity: i32, ec: usize) -> i32 { return implementation.ucurr_forLocale(localeId, buff, buffCapacity, ec) }
export fn ucurr_countCurrencies(localeId: usize, date: f64, ec: usize) -> i32 { return implementation.ucurr_countCurrencies(localeId, date, ec) }
export fn ucurr_forLocaleAndDate(localeId: usize, date: f64, index: i32, buff: usize, buffCapacity: i32, ec: usize) -> i32 { return implementation.ucurr_forLocaleAndDate(localeId, date, index, buff, buffCapacity, ec) }
export fn ucurr_isAvailable(isoCode: usize, from: f64, to: f64, errorCode: usize) -> bool { return implementation.ucurr_isAvailable(isoCode, from, to, errorCode) }
export fn ucurr_openISOCurrencies(currType: u32, pErrorCode: usize) -> usize { return implementation.ucurr_openISOCurrencies(currType, pErrorCode) }
export fn ucurr_getKeywordValuesForLocale(key: usize, localeId: usize, commonlyUsed: bool, status: usize) -> usize { return implementation.ucurr_getKeywordValuesForLocale(key, localeId, commonlyUsed, status) }
export fn ucurr_getNumericCode(currency: usize) -> i32 { return implementation.ucurr_getNumericCode(currency) }
