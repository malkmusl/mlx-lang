// udateintervalformat.h for C: the functions of
// std.unicode.format.date.intervals
// (std/src/unicode/format/date/intervals.mlx), each calling the pub
// function of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.date.intervals")

export fn udtitvfmt_open(localeId: usize, skeleton: usize, skeletonLength: i32, tzID: usize, tzIDLength: i32, status: usize) -> usize { return implementation.udtitvfmt_open(localeId, skeleton, skeletonLength, tzID, tzIDLength, status) }
export fn udtitvfmt_close(formatter: usize) -> void { implementation.udtitvfmt_close(formatter) }
export fn udtitvfmt_openResult(ec: usize) -> usize { return implementation.udtitvfmt_openResult(ec) }
export fn udtitvfmt_resultAsValue(uresult: usize, ec: usize) -> usize { return implementation.udtitvfmt_resultAsValue(uresult, ec) }
export fn udtitvfmt_closeResult(uresult: usize) -> void { implementation.udtitvfmt_closeResult(uresult) }
export fn udtitvfmt_format(formatter: usize, fromDate: f64, toDate: f64, result: usize, resultCapacity: i32, position: usize, status: usize) -> i32 { return implementation.udtitvfmt_format(formatter, fromDate, toDate, result, resultCapacity, position, status) }
export fn udtitvfmt_formatToResult(formatter: usize, fromDate: f64, toDate: f64, result: usize, status: usize) -> void { implementation.udtitvfmt_formatToResult(formatter, fromDate, toDate, result, status) }
export fn udtitvfmt_formatCalendarToResult(formatter: usize, fromCalendar: usize, toCalendar: usize, result: usize, status: usize) -> void { implementation.udtitvfmt_formatCalendarToResult(formatter, fromCalendar, toCalendar, result, status) }
export fn udtitvfmt_setContext(formatter: usize, value: i32, status: usize) -> void { implementation.udtitvfmt_setContext(formatter, value, status) }
export fn udtitvfmt_getContext(formatter: usize, kind: i32, status: usize) -> i32 { return implementation.udtitvfmt_getContext(formatter, kind, status) }
