// uldnames.h, uloc.h's display names for C: the functions of
// std.unicode.locale.displaynames
// (std/src/unicode/locale/displaynames.mlx), each calling the pub function
// of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.locale.displaynames")

export fn uldn_open(localeID: usize, dialectHandling: i32, status: usize) -> usize { return implementation.uldn_open(localeID, dialectHandling, status) }
export fn uldn_openForContext(localeID: usize, contexts: usize, length: i32, status: usize) -> usize { return implementation.uldn_openForContext(localeID, contexts, length, status) }
export fn uldn_close(ldn: usize) -> void { implementation.uldn_close(ldn) }
export fn uldn_getLocale(ldn: usize) -> usize { return implementation.uldn_getLocale(ldn) }
export fn uldn_getDialectHandling(ldn: usize) -> i32 { return implementation.uldn_getDialectHandling(ldn) }
export fn uldn_getContext(ldn: usize, kind: i32, status: usize) -> i32 { return implementation.uldn_getContext(ldn, kind, status) }
export fn uldn_localeDisplayName(ldn: usize, localeID: usize, result: usize, capacity: i32, status: usize) -> i32 { return implementation.uldn_localeDisplayName(ldn, localeID, result, capacity, status) }
export fn uldn_languageDisplayName(ldn: usize, lang: usize, result: usize, capacity: i32, status: usize) -> i32 { return implementation.uldn_languageDisplayName(ldn, lang, result, capacity, status) }
export fn uldn_scriptDisplayName(ldn: usize, script: usize, result: usize, capacity: i32, status: usize) -> i32 { return implementation.uldn_scriptDisplayName(ldn, script, result, capacity, status) }
export fn uldn_scriptCodeDisplayName(ldn: usize, scriptCode: i32, result: usize, capacity: i32, status: usize) -> i32 { return implementation.uldn_scriptCodeDisplayName(ldn, scriptCode, result, capacity, status) }
export fn uldn_regionDisplayName(ldn: usize, region: usize, result: usize, capacity: i32, status: usize) -> i32 { return implementation.uldn_regionDisplayName(ldn, region, result, capacity, status) }
export fn uldn_variantDisplayName(ldn: usize, variant: usize, result: usize, capacity: i32, status: usize) -> i32 { return implementation.uldn_variantDisplayName(ldn, variant, result, capacity, status) }
export fn uldn_keyDisplayName(ldn: usize, key: usize, result: usize, capacity: i32, status: usize) -> i32 { return implementation.uldn_keyDisplayName(ldn, key, result, capacity, status) }
export fn uldn_keyValueDisplayName(ldn: usize, key: usize, value: usize, result: usize, capacity: i32, status: usize) -> i32 { return implementation.uldn_keyValueDisplayName(ldn, key, value, result, capacity, status) }
