// uset.h for C: the functions of std.unicode.sets
// (std/src/unicode/sets.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.sets")

export fn uset_openEmpty() -> usize { return implementation.uset_openEmpty() }
export fn uset_open(start: i32, end: i32) -> usize { return implementation.uset_open(start, end) }
export fn uset_openPattern(pattern: usize, patternLength: i32, ec: usize) -> usize { return implementation.uset_openPattern(pattern, patternLength, ec) }
export fn uset_close(set: usize) -> void { implementation.uset_close(set) }
export fn uset_clear(set: usize) -> void { implementation.uset_clear(set) }
export fn uset_add(set: usize, c: i32) -> void { implementation.uset_add(set, c) }
export fn uset_addRange(set: usize, start: i32, end: i32) -> void { implementation.uset_addRange(set, start, end) }
export fn uset_addAll(set: usize, additionalSet: usize) -> void { implementation.uset_addAll(set, additionalSet) }
export fn uset_complement(set: usize) -> void { implementation.uset_complement(set) }
export fn uset_contains(set: usize, c: i32) -> u8 { return implementation.uset_contains(set, c) }
export fn uset_isEmpty(set: usize) -> u8 { return implementation.uset_isEmpty(set) }
export fn uset_size(set: usize) -> i32 { return implementation.uset_size(set) }
export fn uset_getRangeCount(set: usize) -> i32 { return implementation.uset_getRangeCount(set) }
