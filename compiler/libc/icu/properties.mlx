// uchar.h, uscript.h for C: the functions of std.unicode.properties
// (std/src/unicode/properties.mlx), each calling the pub function of the
// same name there, with the same C types and error codes.
const implementation = @import("std.unicode.properties")

export fn u_hasBinaryProperty(c: i32, which: i32) -> u8 { return implementation.u_hasBinaryProperty(c, which) }
export fn u_stringHasBinaryProperty(s: usize, length: i32, which: i32) -> u8 { return implementation.u_stringHasBinaryProperty(s, length, which) }
export fn u_getIntPropertyValue(c: i32, which: i32) -> i32 { return implementation.u_getIntPropertyValue(c, which) }
export fn u_getIntPropertyMinValue(which: i32) -> i32 { return implementation.u_getIntPropertyMinValue(which) }
export fn u_getIntPropertyMaxValue(which: i32) -> i32 { return implementation.u_getIntPropertyMaxValue(which) }
export fn u_getNumericValue(c: i32) -> f64 { return implementation.u_getNumericValue(c) }
export fn u_getPropertyEnum(alias: usize) -> i32 { return implementation.u_getPropertyEnum(alias) }
export fn u_getPropertyName(property: i32, choice: i32) -> usize { return implementation.u_getPropertyName(property, choice) }
export fn u_getPropertyValueEnum(property: i32, alias: usize) -> i32 { return implementation.u_getPropertyValueEnum(property, alias) }
export fn u_getPropertyValueName(property: i32, value: i32, choice: i32) -> usize { return implementation.u_getPropertyValueName(property, value, choice) }
export fn u_charType(c: i32) -> i8 { return implementation.u_charType(c) }
export fn u_charDirection(c: i32) -> i32 { return implementation.u_charDirection(c) }
export fn u_isMirrored(c: i32) -> u8 { return implementation.u_isMirrored(c) }
export fn u_charMirror(c: i32) -> i32 { return implementation.u_charMirror(c) }
export fn u_getBidiPairedBracket(c: i32) -> i32 { return implementation.u_getBidiPairedBracket(c) }
export fn u_getCombiningClass(c: i32) -> u8 { return implementation.u_getCombiningClass(c) }
export fn u_charDigitValue(c: i32) -> i32 { return implementation.u_charDigitValue(c) }
export fn u_digit(ch: i32, radix: i8) -> i32 { return implementation.u_digit(ch, radix) }
export fn u_forDigit(digit: i32, radix: i8) -> i32 { return implementation.u_forDigit(digit, radix) }
export fn u_getUnicodeVersion(version: usize) -> void { implementation.u_getUnicodeVersion(version) }
export fn u_getVersion(version: usize) -> void { implementation.u_getVersion(version) }
export fn u_charAge(c: i32, version: usize) -> void { implementation.u_charAge(c, version) }
export fn u_islower(c: i32) -> u8 { return implementation.u_islower(c) }
export fn u_isupper(c: i32) -> u8 { return implementation.u_isupper(c) }
export fn u_istitle(c: i32) -> u8 { return implementation.u_istitle(c) }
export fn u_isdigit(c: i32) -> u8 { return implementation.u_isdigit(c) }
export fn u_isalpha(c: i32) -> u8 { return implementation.u_isalpha(c) }
export fn u_isalnum(c: i32) -> u8 { return implementation.u_isalnum(c) }
export fn u_isxdigit(c: i32) -> u8 { return implementation.u_isxdigit(c) }
export fn u_ispunct(c: i32) -> u8 { return implementation.u_ispunct(c) }
export fn u_isgraph(c: i32) -> u8 { return implementation.u_isgraph(c) }
export fn u_isblank(c: i32) -> u8 { return implementation.u_isblank(c) }
export fn u_isdefined(c: i32) -> u8 { return implementation.u_isdefined(c) }
export fn u_isspace(c: i32) -> u8 { return implementation.u_isspace(c) }
export fn u_isJavaSpaceChar(c: i32) -> u8 { return implementation.u_isJavaSpaceChar(c) }
export fn u_isWhitespace(c: i32) -> u8 { return implementation.u_isWhitespace(c) }
export fn u_iscntrl(c: i32) -> u8 { return implementation.u_iscntrl(c) }
export fn u_isISOControl(c: i32) -> u8 { return implementation.u_isISOControl(c) }
export fn u_isprint(c: i32) -> u8 { return implementation.u_isprint(c) }
export fn u_isbase(c: i32) -> u8 { return implementation.u_isbase(c) }
export fn u_isIDStart(c: i32) -> u8 { return implementation.u_isIDStart(c) }
export fn u_isIDIgnorable(c: i32) -> u8 { return implementation.u_isIDIgnorable(c) }
export fn u_isIDPart(c: i32) -> u8 { return implementation.u_isIDPart(c) }
export fn u_isJavaIDStart(c: i32) -> u8 { return implementation.u_isJavaIDStart(c) }
export fn u_isJavaIDPart(c: i32) -> u8 { return implementation.u_isJavaIDPart(c) }
export fn u_isUAlphabetic(c: i32) -> u8 { return implementation.u_isUAlphabetic(c) }
export fn u_isULowercase(c: i32) -> u8 { return implementation.u_isULowercase(c) }
export fn u_isUUppercase(c: i32) -> u8 { return implementation.u_isUUppercase(c) }
export fn u_isUWhiteSpace(c: i32) -> u8 { return implementation.u_isUWhiteSpace(c) }
export fn u_tolower(c: i32) -> i32 { return implementation.u_tolower(c) }
export fn u_toupper(c: i32) -> i32 { return implementation.u_toupper(c) }
export fn u_totitle(c: i32) -> i32 { return implementation.u_totitle(c) }
export fn u_foldCase(c: i32, options: u32) -> i32 { return implementation.u_foldCase(c, options) }
export fn ublock_getCode(c: i32) -> i32 { return implementation.ublock_getCode(c) }
export fn u_enumCharTypes(callback: usize, context: usize) -> void { implementation.u_enumCharTypes(callback, context) }
export fn uscript_getScript(c: i32, err: usize) -> i32 { return implementation.uscript_getScript(c, err) }
export fn uscript_hasScript(c: i32, sc: i32) -> u8 { return implementation.uscript_hasScript(c, sc) }
export fn uscript_getScriptExtensions(c: i32, scripts: usize, capacity: i32, err: usize) -> i32 { return implementation.uscript_getScriptExtensions(c, scripts, capacity, err) }
export fn uscript_getName(code: i32) -> usize { return implementation.uscript_getName(code) }
export fn uscript_getShortName(code: i32) -> usize { return implementation.uscript_getShortName(code) }
export fn uscript_getCode(name: usize, fillIn: usize, capacity: i32, err: usize) -> i32 { return implementation.uscript_getCode(name, fillIn, capacity, err) }
export fn uscript_getUsage(code: i32) -> i32 { return implementation.uscript_getUsage(code) }
export fn uscript_isRightToLeft(code: i32) -> u8 { return implementation.uscript_isRightToLeft(code) }
export fn uscript_breaksBetweenLetters(code: i32) -> u8 { return implementation.uscript_breaksBetweenLetters(code) }
export fn uscript_isCased(code: i32) -> u8 { return implementation.uscript_isCased(code) }
export fn u_errorName(code: i32) -> usize { return implementation.u_errorName(code) }
export fn u_versionToString(version: usize, text: usize) -> void { implementation.u_versionToString(version, text) }
export fn u_versionFromString(version: usize, text: usize) -> void { implementation.u_versionFromString(version, text) }
export fn u_versionFromUString(version: usize, text: usize) -> void { implementation.u_versionFromUString(version, text) }
