// ubrk.h, utext.h for C: the functions of std.unicode.breaks
// (std/src/unicode/breaks.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.breaks")

export fn ubrk_open(kind: i32, locale: usize, text: usize, length: i32, status: usize) -> usize { return implementation.ubrk_open(kind, locale, text, length, status) }
export fn ubrk_openRules(rules: usize, rulesLength: i32, text: usize, textLength: i32, parseError: usize, status: usize) -> usize { return implementation.ubrk_openRules(rules, rulesLength, text, textLength, parseError, status) }
export fn ubrk_clone(bi: usize, status: usize) -> usize { return implementation.ubrk_clone(bi, status) }
export fn ubrk_safeClone(bi: usize, stackBuffer: usize, bufferSize: usize, status: usize) -> usize { return implementation.ubrk_safeClone(bi, stackBuffer, bufferSize, status) }
export fn ubrk_close(bi: usize) -> void { implementation.ubrk_close(bi) }
export fn ubrk_setText(bi: usize, text: usize, length: i32, status: usize) -> void { implementation.ubrk_setText(bi, text, length, status) }
export fn ubrk_setUText(bi: usize, ut: usize, status: usize) -> void { implementation.ubrk_setUText(bi, ut, status) }
export fn ubrk_refreshUText(bi: usize, ut: usize, status: usize) -> void { implementation.ubrk_refreshUText(bi, ut, status) }
export fn ubrk_current(bi: usize) -> i32 { return implementation.ubrk_current(bi) }
export fn ubrk_first(bi: usize) -> i32 { return implementation.ubrk_first(bi) }
export fn ubrk_last(bi: usize) -> i32 { return implementation.ubrk_last(bi) }
export fn ubrk_next(bi: usize) -> i32 { return implementation.ubrk_next(bi) }
export fn ubrk_previous(bi: usize) -> i32 { return implementation.ubrk_previous(bi) }
export fn ubrk_following(bi: usize, offset: i32) -> i32 { return implementation.ubrk_following(bi, offset) }
export fn ubrk_preceding(bi: usize, offset: i32) -> i32 { return implementation.ubrk_preceding(bi, offset) }
export fn ubrk_isBoundary(bi: usize, offset: i32) -> u8 { return implementation.ubrk_isBoundary(bi, offset) }
export fn ubrk_getRuleStatus(bi: usize) -> i32 { return implementation.ubrk_getRuleStatus(bi) }
export fn ubrk_getRuleStatusVec(bi: usize, fillIn: usize, capacity: i32, status: usize) -> i32 { return implementation.ubrk_getRuleStatusVec(bi, fillIn, capacity, status) }
export fn ubrk_countAvailable() -> i32 { return implementation.ubrk_countAvailable() }
export fn ubrk_getAvailable(index: i32) -> usize { return implementation.ubrk_getAvailable(index) }
export fn ubrk_getLocaleByType(bi: usize, kind: i32, status: usize) -> usize { return implementation.ubrk_getLocaleByType(bi, kind, status) }
export fn utext_setup(ut: usize, extraSpace: i32, status: usize) -> usize { return implementation.utext_setup(ut, extraSpace, status) }
export fn utext_close(ut: usize) -> usize { return implementation.utext_close(ut) }
export fn utext_openUChars(ut: usize, s: usize, length: i64, status: usize) -> usize { return implementation.utext_openUChars(ut, s, length, status) }
export fn utext_nativeLength(ut: usize) -> i64 { return implementation.utext_nativeLength(ut) }
