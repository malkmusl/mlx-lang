// unumberformatter.h for C: the functions of std.unicode.format.number
// (std/src/unicode/format/number.mlx), each calling the pub function of the
// same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.number")

export fn unumf_openForSkeletonAndLocale(skeleton: usize, skeletonLen: i32, localeId: usize, ec: usize) -> usize { return implementation.unumf_openForSkeletonAndLocale(skeleton, skeletonLen, localeId, ec) }
export fn unumf_openForSkeletonAndLocaleWithError(skeleton: usize, skeletonLen: i32, localeId: usize, perror: usize, ec: usize) -> usize { return implementation.unumf_openForSkeletonAndLocaleWithError(skeleton, skeletonLen, localeId, perror, ec) }
export fn unumf_close(uformatter: usize) -> void { implementation.unumf_close(uformatter) }
export fn unumf_openResult(ec: usize) -> usize { return implementation.unumf_openResult(ec) }
export fn unumf_closeResult(uresult: usize) -> void { implementation.unumf_closeResult(uresult) }
export fn unumf_formatInt(uformatter: usize, value: i64, uresult: usize, ec: usize) -> void { implementation.unumf_formatInt(uformatter, value, uresult, ec) }
export fn unumf_formatDouble(uformatter: usize, value: f64, uresult: usize, ec: usize) -> void { implementation.unumf_formatDouble(uformatter, value, uresult, ec) }
export fn unumf_formatDecimal(uformatter: usize, value: usize, valueLen: i32, uresult: usize, ec: usize) -> void { implementation.unumf_formatDecimal(uformatter, value, valueLen, uresult, ec) }
export fn unumf_resultAsValue(uresult: usize, ec: usize) -> usize { return implementation.unumf_resultAsValue(uresult, ec) }
export fn unumf_resultToString(uresult: usize, buffer: usize, bufferCapacity: i32, ec: usize) -> i32 { return implementation.unumf_resultToString(uresult, buffer, bufferCapacity, ec) }
export fn unumf_resultNextFieldPosition(uresult: usize, ufpos: usize, ec: usize) -> bool { return implementation.unumf_resultNextFieldPosition(uresult, ufpos, ec) }
export fn unumf_resultGetAllFieldPositions(uresult: usize, ufpositer: usize, ec: usize) -> void { implementation.unumf_resultGetAllFieldPositions(uresult, ufpositer, ec) }
export fn unumf_resultToDecimalNumber(uresult: usize, dest: usize, destCapacity: i32, ec: usize) -> i32 { return implementation.unumf_resultToDecimalNumber(uresult, dest, destCapacity, ec) }
