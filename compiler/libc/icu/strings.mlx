// ustring.h for C: the functions of std.unicode.strings
// (std/src/unicode/strings.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.strings")

export fn u_strlen(s: usize) -> i32 { return implementation.u_strlen(s) }
export fn u_countChar32(s: usize, length: i32) -> i32 { return implementation.u_countChar32(s, length) }
export fn u_strcpy(dst: usize, src: usize) -> usize { return implementation.u_strcpy(dst, src) }
export fn u_strncpy(dst: usize, src: usize, n: i32) -> usize { return implementation.u_strncpy(dst, src, n) }
export fn u_strcat(dst: usize, src: usize) -> usize { return implementation.u_strcat(dst, src) }
export fn u_strncat(dst: usize, src: usize, n: i32) -> usize { return implementation.u_strncat(dst, src, n) }
export fn u_uastrcpy(dst: usize, src: usize) -> usize { return implementation.u_uastrcpy(dst, src) }
export fn u_uastrncpy(dst: usize, src: usize, n: i32) -> usize { return implementation.u_uastrncpy(dst, src, n) }
export fn u_austrcpy(dst: usize, src: usize) -> usize { return implementation.u_austrcpy(dst, src) }
export fn u_austrncpy(dst: usize, src: usize, n: i32) -> usize { return implementation.u_austrncpy(dst, src, n) }
export fn u_memcpy(dest: usize, src: usize, count: i32) -> usize { return implementation.u_memcpy(dest, src, count) }
export fn u_memmove(dest: usize, src: usize, count: i32) -> usize { return implementation.u_memmove(dest, src, count) }
export fn u_memset(dest: usize, c: u16, count: i32) -> usize { return implementation.u_memset(dest, c, count) }
export fn u_strcmp(s1: usize, s2: usize) -> i32 { return implementation.u_strcmp(s1, s2) }
export fn u_strcmpCodePointOrder(s1: usize, s2: usize) -> i32 { return implementation.u_strcmpCodePointOrder(s1, s2) }
export fn u_strncmp(s1: usize, s2: usize, n: i32) -> i32 { return implementation.u_strncmp(s1, s2, n) }
export fn u_strCompare(s1: usize, length1: i32, s2: usize, length2: i32, codePointOrder: i8) -> i32 { return implementation.u_strCompare(s1, length1, s2, length2, codePointOrder) }
export fn u_memcmp(b1: usize, b2: usize, count: i32) -> i32 { return implementation.u_memcmp(b1, b2, count) }
export fn u_memcmpCodePointOrder(s1: usize, s2: usize, count: i32) -> i32 { return implementation.u_memcmpCodePointOrder(s1, s2, count) }
export fn u_strCaseCompare(s1: usize, length1: i32, s2: usize, length2: i32, options: u32, status: usize) -> i32 { return implementation.u_strCaseCompare(s1, length1, s2, length2, options, status) }
export fn u_strcasecmp(s1: usize, s2: usize, options: u32) -> i32 { return implementation.u_strcasecmp(s1, s2, options) }
export fn u_strncasecmp(s1: usize, s2: usize, n: i32, options: u32) -> i32 { return implementation.u_strncasecmp(s1, s2, n, options) }
export fn u_memcasecmp(s1: usize, s2: usize, length: i32, options: u32) -> i32 { return implementation.u_memcasecmp(s1, s2, length, options) }
export fn u_strchr(s: usize, c: u16) -> usize { return implementation.u_strchr(s, c) }
export fn u_strchr32(s: usize, c: i32) -> usize { return implementation.u_strchr32(s, c) }
export fn u_strrchr(s: usize, c: u16) -> usize { return implementation.u_strrchr(s, c) }
export fn u_memchr(s: usize, c: u16, count: i32) -> usize { return implementation.u_memchr(s, c, count) }
export fn u_strstr(s: usize, substring: usize) -> usize { return implementation.u_strstr(s, substring) }
export fn u_unescape(src: usize, dest: usize, capacity: i32) -> i32 { return implementation.u_unescape(src, dest, capacity) }
export fn u_strFromUTF8(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize { return implementation.u_strFromUTF8(dest, capacity, destLength, src, length, status) }
export fn u_strFromUTF8WithSub(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, sub: i32, substitutions: usize, status: usize) -> usize { return implementation.u_strFromUTF8WithSub(dest, capacity, destLength, src, length, sub, substitutions, status) }
export fn u_strFromUTF8Lenient(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize { return implementation.u_strFromUTF8Lenient(dest, capacity, destLength, src, length, status) }
export fn u_strToUTF8(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize { return implementation.u_strToUTF8(dest, capacity, destLength, src, length, status) }
export fn u_strToUTF8WithSub(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, sub: i32, substitutions: usize, status: usize) -> usize { return implementation.u_strToUTF8WithSub(dest, capacity, destLength, src, length, sub, substitutions, status) }
export fn u_strToUTF32(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize { return implementation.u_strToUTF32(dest, capacity, destLength, src, length, status) }
export fn u_strFromUTF32(dest: usize, capacity: i32, destLength: usize, src: usize, length: i32, status: usize) -> usize { return implementation.u_strFromUTF32(dest, capacity, destLength, src, length, status) }
