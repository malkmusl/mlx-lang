// usearch.h for C: the functions of std.unicode.search
// (std/src/unicode/search.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.search")

export fn usearch_open(pattern: usize, patternlength: i32, text: usize, textlength: i32, locale: usize, breakiter: usize, status: usize) -> usize { return implementation.usearch_open(pattern, patternlength, text, textlength, locale, breakiter, status) }
export fn usearch_openFromCollator(pattern: usize, patternlength: i32, text: usize, textlength: i32, collator: usize, breakiter: usize, status: usize) -> usize { return implementation.usearch_openFromCollator(pattern, patternlength, text, textlength, collator, breakiter, status) }
export fn usearch_close(strsrch: usize) -> void { implementation.usearch_close(strsrch) }
export fn usearch_setOffset(strsrch: usize, position: i32, status: usize) -> void { implementation.usearch_setOffset(strsrch, position, status) }
export fn usearch_getOffset(strsrch: usize) -> i32 { return implementation.usearch_getOffset(strsrch) }
export fn usearch_setAttribute(strsrch: usize, attribute: i32, value: i32, status: usize) -> void { implementation.usearch_setAttribute(strsrch, attribute, value, status) }
export fn usearch_getAttribute(strsrch: usize, attribute: i32) -> i32 { return implementation.usearch_getAttribute(strsrch, attribute) }
export fn usearch_getMatchedStart(strsrch: usize) -> i32 { return implementation.usearch_getMatchedStart(strsrch) }
export fn usearch_getMatchedLength(strsrch: usize) -> i32 { return implementation.usearch_getMatchedLength(strsrch) }
export fn usearch_getMatchedText(strsrch: usize, result: usize, resultCapacity: i32, status: usize) -> i32 { return implementation.usearch_getMatchedText(strsrch, result, resultCapacity, status) }
export fn usearch_setBreakIterator(strsrch: usize, breakiter: usize, status: usize) -> void { implementation.usearch_setBreakIterator(strsrch, breakiter, status) }
export fn usearch_getBreakIterator(strsrch: usize) -> usize { return implementation.usearch_getBreakIterator(strsrch) }
export fn usearch_setText(strsrch: usize, text: usize, textlength: i32, status: usize) -> void { implementation.usearch_setText(strsrch, text, textlength, status) }
export fn usearch_getText(strsrch: usize, length: usize) -> usize { return implementation.usearch_getText(strsrch, length) }
export fn usearch_getCollator(strsrch: usize) -> usize { return implementation.usearch_getCollator(strsrch) }
export fn usearch_setCollator(strsrch: usize, collator: usize, status: usize) -> void { implementation.usearch_setCollator(strsrch, collator, status) }
export fn usearch_setPattern(strsrch: usize, pattern: usize, patternlength: i32, status: usize) -> void { implementation.usearch_setPattern(strsrch, pattern, patternlength, status) }
export fn usearch_getPattern(strsrch: usize, length: usize) -> usize { return implementation.usearch_getPattern(strsrch, length) }
export fn usearch_first(strsrch: usize, status: usize) -> i32 { return implementation.usearch_first(strsrch, status) }
export fn usearch_following(strsrch: usize, position: i32, status: usize) -> i32 { return implementation.usearch_following(strsrch, position, status) }
export fn usearch_last(strsrch: usize, status: usize) -> i32 { return implementation.usearch_last(strsrch, status) }
export fn usearch_preceding(strsrch: usize, position: i32, status: usize) -> i32 { return implementation.usearch_preceding(strsrch, position, status) }
export fn usearch_next(strsrch: usize, status: usize) -> i32 { return implementation.usearch_next(strsrch, status) }
export fn usearch_previous(strsrch: usize, status: usize) -> i32 { return implementation.usearch_previous(strsrch, status) }
export fn usearch_reset(strsrch: usize) -> void { implementation.usearch_reset(strsrch) }
export fn usearch_search(strsrch: usize, startIdx: i32, matchStart: usize, matchLimit: usize, status: usize) -> u8 { return implementation.usearch_search(strsrch, startIdx, matchStart, matchLimit, status) }
export fn usearch_searchBackwards(strsrch: usize, startIdx: i32, matchStart: usize, matchLimit: usize, status: usize) -> u8 { return implementation.usearch_searchBackwards(strsrch, startIdx, matchStart, matchLimit, status) }
