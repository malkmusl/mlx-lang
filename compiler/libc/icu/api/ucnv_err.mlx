// unicode/ucnv_err.h
// mlx-unicode: what a converter does with bytes that are not a character
// of its charset, or a character its charset has not (std.unicode.converters):
// the callbacks it calls then (stop, skip, substitute, escape), the
// contexts that tell them how, and the records they are given.
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UConverter = struct {}

// The contexts of the callbacks: substitute or skip only characters the
// charset has not, stopping at illegal sequences ("i"); the escapes' forms
// (%UXXXX for none, \uXXXX, C's \uXXXX and \UXXXXXXXX, XML's &#DDDD; and
// &#xXXXX;, {U+XXXX}, CSS's \XXXX followed by a space).
pub const UCNV_SUB_STOP_ON_ILLEGAL: []const u8 = "i"
pub const UCNV_SKIP_STOP_ON_ILLEGAL: []const u8 = "i"
pub const UCNV_ESCAPE_ICU: ?*const umachine.c_char = null
pub const UCNV_ESCAPE_JAVA: []const u8 = "J"
pub const UCNV_ESCAPE_C: []const u8 = "C"
pub const UCNV_ESCAPE_XML_DEC: []const u8 = "D"
pub const UCNV_ESCAPE_XML_HEX: []const u8 = "X"
pub const UCNV_ESCAPE_UNICODE: []const u8 = "U"
pub const UCNV_ESCAPE_CSS2: []const u8 = "S"

pub const UConverterCallbackReason = enum(i32, nonexhaustive) {
    UCNV_UNASSIGNED = 0,
    UCNV_ILLEGAL = 1,
    UCNV_IRREGULAR = 2,
    UCNV_RESET = 3,
    UCNV_CLOSE = 4,
    UCNV_CLONE = 5,
}

// What a callback is given while converting from UTF-16: the converter,
// the input left, and the output, which it may write to.
pub const UConverterFromUnicodeArgs = struct {
    size: u16,
    flush: umachine.UBool,
    converter: ?*UConverter,
    source: ?[*]const umachine.UChar,
    sourceLimit: ?[*]const umachine.UChar,
    target: ?[*]umachine.c_char,
    targetLimit: ?[*]const umachine.c_char,
    offsets: ?[*]i32,
}

// The same while converting to UTF-16.
pub const UConverterToUnicodeArgs = struct {
    size: u16,
    flush: umachine.UBool,
    converter: ?*UConverter,
    source: ?[*]const umachine.c_char,
    sourceLimit: ?[*]const umachine.c_char,
    target: ?[*]umachine.UChar,
    targetLimit: ?[*]const umachine.UChar,
    offsets: ?[*]i32,
}

pub extern("c") fn UCNV_FROM_U_CALLBACK_STOP(context: ?*const anyopaque, fromUArgs: *UConverterFromUnicodeArgs, codeUnits: ?[*]const umachine.UChar, length: i32, codePoint: umachine.UChar32, reason: UConverterCallbackReason, err: *utypes.UErrorCode) -> void
pub extern("c") fn UCNV_TO_U_CALLBACK_STOP(context: ?*const anyopaque, toUArgs: *UConverterToUnicodeArgs, codeUnits: ?[*]const umachine.c_char, length: i32, reason: UConverterCallbackReason, err: *utypes.UErrorCode) -> void
pub extern("c") fn UCNV_FROM_U_CALLBACK_SKIP(context: ?*const anyopaque, fromUArgs: *UConverterFromUnicodeArgs, codeUnits: ?[*]const umachine.UChar, length: i32, codePoint: umachine.UChar32, reason: UConverterCallbackReason, err: *utypes.UErrorCode) -> void
pub extern("c") fn UCNV_FROM_U_CALLBACK_SUBSTITUTE(context: ?*const anyopaque, fromUArgs: *UConverterFromUnicodeArgs, codeUnits: ?[*]const umachine.UChar, length: i32, codePoint: umachine.UChar32, reason: UConverterCallbackReason, err: *utypes.UErrorCode) -> void
pub extern("c") fn UCNV_FROM_U_CALLBACK_ESCAPE(context: ?*const anyopaque, fromUArgs: *UConverterFromUnicodeArgs, codeUnits: ?[*]const umachine.UChar, length: i32, codePoint: umachine.UChar32, reason: UConverterCallbackReason, err: *utypes.UErrorCode) -> void
pub extern("c") fn UCNV_TO_U_CALLBACK_SKIP(context: ?*const anyopaque, toUArgs: *UConverterToUnicodeArgs, codeUnits: ?[*]const umachine.c_char, length: i32, reason: UConverterCallbackReason, err: *utypes.UErrorCode) -> void
pub extern("c") fn UCNV_TO_U_CALLBACK_SUBSTITUTE(context: ?*const anyopaque, toUArgs: *UConverterToUnicodeArgs, codeUnits: ?[*]const umachine.c_char, length: i32, reason: UConverterCallbackReason, err: *utypes.UErrorCode) -> void
pub extern("c") fn UCNV_TO_U_CALLBACK_ESCAPE(context: ?*const anyopaque, toUArgs: *UConverterToUnicodeArgs, codeUnits: ?[*]const umachine.c_char, length: i32, reason: UConverterCallbackReason, err: *utypes.UErrorCode) -> void
