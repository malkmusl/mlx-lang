// unicode/ubrk.h
// mlx-unicode: break iterators: grapheme clusters (UAX #29), words
// (UAX #29), lines (UAX #14) and sentences (UAX #29).
const parseerr = @import("./parseerr.mlx")
const uloc = @import("./uloc.mlx")
const umachine = @import("./umachine.mlx")
const utext = @import("./utext.mlx")
const utypes = @import("./utypes.mlx")

pub const UBreakIterator = struct {}
pub const UBreakIteratorType = enum(i32, nonexhaustive) {
    UBRK_CHARACTER = 0,
    UBRK_WORD = 1,
    UBRK_LINE = 2,
    UBRK_SENTENCE = 3,
    UBRK_TITLE = 4,
    UBRK_COUNT = 5,
}

pub const UBRK_DONE: i32 = -1
pub const UWordBreak = enum(i32, nonexhaustive) {
    UBRK_WORD_NONE = 0,
    UBRK_WORD_NONE_LIMIT = 100,
    UBRK_WORD_NUMBER_LIMIT = 200,
    UBRK_WORD_LETTER_LIMIT = 300,
    UBRK_WORD_KANA_LIMIT = 400,
    UBRK_WORD_IDEO_LIMIT = 500,
}
pub const UBRK_WORD_NUMBER: UWordBreak = UWordBreak.UBRK_WORD_NONE_LIMIT
pub const UBRK_WORD_LETTER: UWordBreak = UWordBreak.UBRK_WORD_NUMBER_LIMIT
pub const UBRK_WORD_KANA: UWordBreak = UWordBreak.UBRK_WORD_LETTER_LIMIT
pub const UBRK_WORD_IDEO: UWordBreak = UWordBreak.UBRK_WORD_KANA_LIMIT

pub const ULineBreakTag = enum(i32, nonexhaustive) {
    UBRK_LINE_SOFT = 0,
    UBRK_LINE_SOFT_LIMIT = 100,
    UBRK_LINE_HARD_LIMIT = 200,
}
pub const UBRK_LINE_HARD: ULineBreakTag = ULineBreakTag.UBRK_LINE_SOFT_LIMIT

pub const USentenceBreakTag = enum(i32, nonexhaustive) {
    UBRK_SENTENCE_TERM = 0,
    UBRK_SENTENCE_TERM_LIMIT = 100,
    UBRK_SENTENCE_SEP_LIMIT = 200,
}
pub const UBRK_SENTENCE_SEP: USentenceBreakTag = USentenceBreakTag.UBRK_SENTENCE_TERM_LIMIT

pub extern("c") fn ubrk_open(kind: UBreakIteratorType, locale: [*]const umachine.c_char, text: [*]const umachine.UChar, textLength: i32, status: *utypes.UErrorCode) -> *UBreakIterator
pub extern("c") fn ubrk_openRules(rules: [*]const umachine.UChar, rulesLength: i32, text: [*]const umachine.UChar, textLength: i32, parseErr: *parseerr.UParseError, status: *utypes.UErrorCode) -> *UBreakIterator
pub extern("c") fn ubrk_clone(bi: *const UBreakIterator, status: *utypes.UErrorCode) -> *UBreakIterator
pub extern("c") fn ubrk_safeClone(bi: *const UBreakIterator, stackBuffer: ?*anyopaque, pBufferSize: [*]i32, status: *utypes.UErrorCode) -> *UBreakIterator
pub extern("c") fn ubrk_close(bi: *UBreakIterator) -> void
pub extern("c") fn ubrk_setText(bi: *UBreakIterator, text: [*]const umachine.UChar, textLength: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn ubrk_setUText(bi: *UBreakIterator, text: *utext.UText, status: *utypes.UErrorCode) -> void
pub extern("c") fn ubrk_current(bi: *const UBreakIterator) -> i32
pub extern("c") fn ubrk_next(bi: *UBreakIterator) -> i32
pub extern("c") fn ubrk_previous(bi: *UBreakIterator) -> i32
pub extern("c") fn ubrk_first(bi: *UBreakIterator) -> i32
pub extern("c") fn ubrk_last(bi: *UBreakIterator) -> i32
pub extern("c") fn ubrk_preceding(bi: *UBreakIterator, offset: i32) -> i32
pub extern("c") fn ubrk_following(bi: *UBreakIterator, offset: i32) -> i32
pub extern("c") fn ubrk_isBoundary(bi: *UBreakIterator, offset: i32) -> umachine.UBool
pub extern("c") fn ubrk_getRuleStatus(bi: *UBreakIterator) -> i32
pub extern("c") fn ubrk_getRuleStatusVec(bi: *UBreakIterator, fillInVec: [*]i32, capacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ubrk_getAvailable(index: i32) -> [*]const umachine.c_char
pub extern("c") fn ubrk_countAvailable() -> i32
pub extern("c") fn ubrk_getLocaleByType(bi: *const UBreakIterator, kind: uloc.ULocDataLocaleType, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ubrk_refreshUText(bi: *UBreakIterator, text: *utext.UText, status: *utypes.UErrorCode) -> void
