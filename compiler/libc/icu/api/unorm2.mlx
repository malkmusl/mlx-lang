// unicode/unorm2.h
// mlx-unicode: normalization (UAX #15): NFC, NFD, NFKC, NFKD and NFKC
// with case folding.
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UNormalization2Mode = enum(i32, nonexhaustive) {
    UNORM2_COMPOSE,
    UNORM2_DECOMPOSE,
    UNORM2_FCD,
    UNORM2_COMPOSE_CONTIGUOUS,
}

pub const UNormalizationCheckResult = enum(i32, nonexhaustive) {
    UNORM_NO,
    UNORM_YES,
    UNORM_MAYBE,
}

pub const UNormalizer2 = struct {}
pub extern("c") fn unorm2_getNFCInstance(pErrorCode: *utypes.UErrorCode) -> *const UNormalizer2
pub extern("c") fn unorm2_getNFDInstance(pErrorCode: *utypes.UErrorCode) -> *const UNormalizer2
pub extern("c") fn unorm2_getNFKCInstance(pErrorCode: *utypes.UErrorCode) -> *const UNormalizer2
pub extern("c") fn unorm2_getNFKDInstance(pErrorCode: *utypes.UErrorCode) -> *const UNormalizer2
pub extern("c") fn unorm2_getNFKCCasefoldInstance(pErrorCode: *utypes.UErrorCode) -> *const UNormalizer2
pub extern("c") fn unorm2_getInstance(packageName: [*]const umachine.c_char, name: [*]const umachine.c_char, mode: UNormalization2Mode, pErrorCode: *utypes.UErrorCode) -> *const UNormalizer2
pub extern("c") fn unorm2_close(norm2: *UNormalizer2) -> void
pub extern("c") fn unorm2_normalize(norm2: *const UNormalizer2, src: [*]const umachine.UChar, length: i32, dest: [*]umachine.UChar, capacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn unorm2_normalizeSecondAndAppend(norm2: *const UNormalizer2, first: [*]umachine.UChar, firstLength: i32, firstCapacity: i32, second: [*]const umachine.UChar, secondLength: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn unorm2_append(norm2: *const UNormalizer2, first: [*]umachine.UChar, firstLength: i32, firstCapacity: i32, second: [*]const umachine.UChar, secondLength: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn unorm2_getDecomposition(norm2: *const UNormalizer2, c: umachine.UChar32, decomposition: [*]umachine.UChar, capacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn unorm2_getRawDecomposition(norm2: *const UNormalizer2, c: umachine.UChar32, decomposition: [*]umachine.UChar, capacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn unorm2_composePair(norm2: *const UNormalizer2, a: umachine.UChar32, b: umachine.UChar32) -> umachine.UChar32
pub extern("c") fn unorm2_getCombiningClass(norm2: *const UNormalizer2, c: umachine.UChar32) -> u8
pub extern("c") fn unorm2_isNormalized(norm2: *const UNormalizer2, s: [*]const umachine.UChar, length: i32, pErrorCode: *utypes.UErrorCode) -> umachine.UBool
pub extern("c") fn unorm2_quickCheck(norm2: *const UNormalizer2, s: [*]const umachine.UChar, length: i32, pErrorCode: *utypes.UErrorCode) -> UNormalizationCheckResult
pub extern("c") fn unorm2_spanQuickCheckYes(norm2: *const UNormalizer2, s: [*]const umachine.UChar, length: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn unorm2_hasBoundaryBefore(norm2: *const UNormalizer2, c: umachine.UChar32) -> umachine.UBool
pub extern("c") fn unorm2_hasBoundaryAfter(norm2: *const UNormalizer2, c: umachine.UChar32) -> umachine.UBool
pub extern("c") fn unorm2_isInert(norm2: *const UNormalizer2, c: umachine.UChar32) -> umachine.UBool
