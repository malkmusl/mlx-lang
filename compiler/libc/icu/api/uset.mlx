// unicode/uset.h
// mlx-unicode: sets of code points (and of strings), from ranges, from
// properties and from patterns (`[a-zà]`, `[:Han:]`, `\p{L}`).
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")
const uchar = @import("./uchar.mlx")

const UChar = umachine.UChar
const UChar32 = umachine.UChar32
const UBool = umachine.UBool
const UErrorCode = utypes.UErrorCode

pub const USet = struct {}

pub const USET_IGNORE_SPACE: i32 = 1
pub const USET_CASE_INSENSITIVE: i32 = 2
pub const USET_ADD_CASE_MAPPINGS: i32 = 4
pub const USET_SERIALIZED_STATIC_ARRAY_CAPACITY: i32 = 8

pub const USetSpanCondition = enum(i32, nonexhaustive) {
    USET_SPAN_NOT_CONTAINED = 0,
    USET_SPAN_CONTAINED = 1,
    USET_SPAN_SIMPLE = 2,
    USET_SPAN_CONDITION_COUNT,
}

pub extern("c") fn uset_openEmpty() -> ?*USet
pub extern("c") fn uset_open(start: UChar32, end: UChar32) -> ?*USet
pub extern("c") fn uset_openPattern(pattern: [*]const UChar, patternLength: i32, ec: *UErrorCode) -> ?*USet
pub extern("c") fn uset_openPatternOptions(pattern: [*]const UChar, patternLength: i32, options: u32, ec: *UErrorCode) -> ?*USet
pub extern("c") fn uset_close(set: ?*USet) -> void
pub extern("c") fn uset_clone(set: *const USet) -> ?*USet
pub extern("c") fn uset_isFrozen(set: *const USet) -> UBool
pub extern("c") fn uset_freeze(set: *USet) -> void
pub extern("c") fn uset_cloneAsThawed(set: *const USet) -> ?*USet
pub extern("c") fn uset_set(set: *USet, start: UChar32, end: UChar32) -> void
pub extern("c") fn uset_applyPattern(set: *USet, pattern: [*]const UChar, patternLength: i32, options: u32, status: *UErrorCode) -> i32
pub extern("c") fn uset_applyIntPropertyValue(set: *USet, prop: uchar.UProperty, value: i32, ec: *UErrorCode) -> void
pub extern("c") fn uset_add(set: *USet, c: UChar32) -> void
pub extern("c") fn uset_addAll(set: *USet, additionalSet: *const USet) -> void
pub extern("c") fn uset_addRange(set: *USet, start: UChar32, end: UChar32) -> void
pub extern("c") fn uset_addString(set: *USet, str: [*]const UChar, strLen: i32) -> void
pub extern("c") fn uset_remove(set: *USet, c: UChar32) -> void
pub extern("c") fn uset_removeRange(set: *USet, start: UChar32, end: UChar32) -> void
pub extern("c") fn uset_removeAll(set: *USet, removeSet: *const USet) -> void
pub extern("c") fn uset_retainAll(set: *USet, retain: *const USet) -> void
pub extern("c") fn uset_complement(set: *USet) -> void
pub extern("c") fn uset_clear(set: *USet) -> void
pub extern("c") fn uset_isEmpty(set: *const USet) -> UBool
pub extern("c") fn uset_contains(set: *const USet, c: UChar32) -> UBool
pub extern("c") fn uset_containsRange(set: *const USet, start: UChar32, end: UChar32) -> UBool
pub extern("c") fn uset_containsString(set: *const USet, str: [*]const UChar, strLen: i32) -> UBool
pub extern("c") fn uset_size(set: *const USet) -> i32
pub extern("c") fn uset_getItemCount(set: *const USet) -> i32
pub extern("c") fn uset_getItem(set: *const USet, itemIndex: i32, start: *UChar32, end: *UChar32, str: ?[*]UChar, strCapacity: i32, ec: *UErrorCode) -> i32
pub extern("c") fn uset_getRangeCount(set: *const USet) -> i32
pub extern("c") fn uset_span(set: *const USet, s: [*]const UChar, length: i32, spanCondition: USetSpanCondition) -> i32
pub extern("c") fn uset_spanBack(set: *const USet, s: [*]const UChar, length: i32, spanCondition: USetSpanCondition) -> i32
pub extern("c") fn uset_equals(set1: *const USet, set2: *const USet) -> UBool
