// unicode/unumberoptions.h
// mlx-unicode: options of number formatting (rounding modes, grouping).
const utypes = @import("./utypes.mlx")

pub const UNumberFormatRoundingMode = enum(i32, nonexhaustive) {
    UNUM_ROUND_CEILING,
    UNUM_ROUND_FLOOR,
    UNUM_ROUND_DOWN,
    UNUM_ROUND_UP,
    UNUM_ROUND_HALFEVEN,
    UNUM_ROUND_HALFDOWN = 5,
    UNUM_ROUND_HALFUP,
    UNUM_ROUND_UNNECESSARY,
    UNUM_ROUND_HALF_ODD,
    UNUM_ROUND_HALF_CEILING,
    UNUM_ROUND_HALF_FLOOR,
}

pub const UNumberGroupingStrategy = enum(i32, nonexhaustive) {
    UNUM_GROUPING_OFF,
    UNUM_GROUPING_MIN2,
    UNUM_GROUPING_AUTO,
    UNUM_GROUPING_ON_ALIGNED,
    UNUM_GROUPING_THOUSANDS,
    UNUM_GROUPING_COUNT,
}
