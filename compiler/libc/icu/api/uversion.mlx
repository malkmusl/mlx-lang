// unicode/uversion.h
// mlx-unicode: versions as four bytes and as text.
const umachine = @import("./umachine.mlx")
const uvernum = @import("./uvernum.mlx")

// ICU's namespace for C++ (uversion.h): icu_74, and icu naming it. Its C++
// API is none of mlx-unicode's, but C++ that includes the C headers says
// `using namespace icu;` (WebKit's LocaleICU) and U_NAMESPACE_BEGIN/END.
const c_macros = "#ifdef __cplusplus\n#define U_ICU_NAMESPACE icu_74\nnamespace icu_74 {}\nnamespace icu = icu_74;\n#define U_NAMESPACE_BEGIN namespace icu_74 {\n#define U_NAMESPACE_END }\n#define U_NAMESPACE_USE using namespace icu_74;\n#define U_NAMESPACE_QUALIFIER icu_74::\n#endif\n"

pub extern("c") fn u_versionFromString(versionArray: *u8, versionString: ?[*]const umachine.c_char) -> void
pub extern("c") fn u_versionFromUString(versionArray: *u8, versionString: ?[*]const umachine.UChar) -> void
pub extern("c") fn u_versionToString(versionArray: [*]const u8, versionString: [*]umachine.c_char) -> void
pub extern("c") fn u_getVersion(versionArray: *u8) -> void
