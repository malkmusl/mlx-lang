// unicode/uformattable.h
// mlx-unicode: UFormattable, a value a number format formats or parses.
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UFormattableType = enum(i32, nonexhaustive) {
    UFMT_DATE = 0,
    UFMT_DOUBLE,
    UFMT_LONG,
    UFMT_STRING,
    UFMT_ARRAY,
    UFMT_INT64,
    UFMT_OBJECT,
    UFMT_COUNT,
}

pub const UFormattable = *anyopaque

pub extern("c") fn ufmt_open(status: *utypes.UErrorCode) -> *UFormattable
pub extern("c") fn ufmt_close(fmt: *UFormattable) -> void
pub extern("c") fn ufmt_getType(fmt: *const UFormattable, status: *utypes.UErrorCode) -> UFormattableType
pub extern("c") fn ufmt_isNumeric(fmt: *const UFormattable) -> umachine.UBool
pub extern("c") fn ufmt_getDate(fmt: *const UFormattable, status: *utypes.UErrorCode) -> umachine.UDate
pub extern("c") fn ufmt_getDouble(fmt: *UFormattable, status: *utypes.UErrorCode) -> f64
pub extern("c") fn ufmt_getLong(fmt: *UFormattable, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ufmt_getInt64(fmt: *UFormattable, status: *utypes.UErrorCode) -> i64
pub extern("c") fn ufmt_getObject(fmt: *const UFormattable, status: *utypes.UErrorCode) -> *const anyopaque
pub extern("c") fn ufmt_getUChars(fmt: *UFormattable, len: *i32, status: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn ufmt_getArrayLength(fmt: *const UFormattable, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ufmt_getArrayItemByIndex(fmt: *UFormattable, n: i32, status: *utypes.UErrorCode) -> *UFormattable
pub extern("c") fn ufmt_getDecNumChars(fmt: *UFormattable, len: *i32, status: *utypes.UErrorCode) -> [*]const umachine.c_char
