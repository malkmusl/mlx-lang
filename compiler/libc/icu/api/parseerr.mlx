// unicode/parseerr.h
// mlx-unicode: where a pattern or rule failed to parse.
const umachine = @import("./umachine.mlx")

pub const U_PARSE_CONTEXT_LEN: i32 = 16

pub const UParseError = struct {
    line: i32,
    offset: i32,
    preContext: [16]umachine.UChar,
    postContext: [16]umachine.UChar,
}
