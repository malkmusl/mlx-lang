// unicode/ubidi.h
// mlx-unicode: the Unicode Bidirectional Algorithm (UAX #9): the levels
// of a paragraph's text and of its lines, their runs, the maps between
// logical and visual order, and the text written in visual order
// (std.unicode.bidi). Only the default reordering mode runs (the others
// and the inverse algorithm are kept but not applied), and the options
// that insert marks are not done.
const uchar = @import("./uchar.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UBiDiLevel = u8

pub const UBIDI_DEFAULT_LTR: UBiDiLevel = 254
pub const UBIDI_DEFAULT_RTL: UBiDiLevel = 255
pub const UBIDI_MAX_EXPLICIT_LEVEL: UBiDiLevel = 125
pub const UBIDI_LEVEL_OVERRIDE: UBiDiLevel = 128
pub const UBIDI_MAP_NOWHERE: i32 = -1

pub const UBiDiDirection = enum(i32, nonexhaustive) {
    UBIDI_LTR,
    UBIDI_RTL,
    UBIDI_MIXED,
    UBIDI_NEUTRAL,
}

pub const UBiDi = struct {}

pub const UBiDiReorderingMode = enum(i32, nonexhaustive) {
    UBIDI_REORDER_DEFAULT = 0,
    UBIDI_REORDER_NUMBERS_SPECIAL,
    UBIDI_REORDER_GROUP_NUMBERS_WITH_R,
    UBIDI_REORDER_RUNS_ONLY,
    UBIDI_REORDER_INVERSE_NUMBERS_AS_L,
    UBIDI_REORDER_INVERSE_LIKE_DIRECT,
    UBIDI_REORDER_INVERSE_FOR_NUMBERS_SPECIAL,
    UBIDI_REORDER_COUNT,
}

pub const UBiDiReorderingOption = enum(i32, nonexhaustive) {
    UBIDI_OPTION_DEFAULT = 0,
    UBIDI_OPTION_INSERT_MARKS = 1,
    UBIDI_OPTION_REMOVE_CONTROLS = 2,
    UBIDI_OPTION_STREAMING = 4,
}

// The options of ubidi_writeReordered and ubidi_writeReverse.
pub const UBIDI_KEEP_BASE_COMBINING: u16 = 1
pub const UBIDI_DO_MIRRORING: u16 = 2
pub const UBIDI_INSERT_LRM_FOR_NUMERIC: u16 = 4
pub const UBIDI_REMOVE_BIDI_CONTROLS: u16 = 8
pub const UBIDI_OUTPUT_REVERSE: u16 = 16

// What a class callback answers to leave a code point's class as it is.
pub const U_BIDI_CLASS_DEFAULT: i32 = 23

// A program's own classes for code points (ubidi_setClassCallback).
pub const UBiDiClassCallback = fn(context: ?*const anyopaque, c: umachine.UChar32) -> uchar.UCharDirection

pub extern("c") fn ubidi_open() -> ?*UBiDi
pub extern("c") fn ubidi_openSized(maxLength: i32, maxRunCount: i32, pErrorCode: *utypes.UErrorCode) -> ?*UBiDi
pub extern("c") fn ubidi_close(pBiDi: ?*UBiDi) -> void
pub extern("c") fn ubidi_setInverse(pBiDi: *UBiDi, isInverse: umachine.UBool) -> void
pub extern("c") fn ubidi_isInverse(pBiDi: *UBiDi) -> umachine.UBool
pub extern("c") fn ubidi_orderParagraphsLTR(pBiDi: *UBiDi, orderParagraphsLTR: umachine.UBool) -> void
pub extern("c") fn ubidi_isOrderParagraphsLTR(pBiDi: *UBiDi) -> umachine.UBool
pub extern("c") fn ubidi_setReorderingMode(pBiDi: *UBiDi, reorderingMode: UBiDiReorderingMode) -> void
pub extern("c") fn ubidi_getReorderingMode(pBiDi: *UBiDi) -> UBiDiReorderingMode
pub extern("c") fn ubidi_setReorderingOptions(pBiDi: *UBiDi, reorderingOptions: u32) -> void
pub extern("c") fn ubidi_getReorderingOptions(pBiDi: *UBiDi) -> u32
pub extern("c") fn ubidi_setContext(pBiDi: *UBiDi, prologue: ?[*]const umachine.UChar, proLength: i32, epilogue: ?[*]const umachine.UChar, epiLength: i32, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ubidi_setPara(pBiDi: *UBiDi, text: [*]const umachine.UChar, length: i32, paraLevel: UBiDiLevel, embeddingLevels: ?[*]UBiDiLevel, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ubidi_setLine(pParaBiDi: *const UBiDi, start: i32, limit: i32, pLineBiDi: *UBiDi, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ubidi_getDirection(pBiDi: *const UBiDi) -> UBiDiDirection
pub extern("c") fn ubidi_getBaseDirection(text: [*]const umachine.UChar, length: i32) -> UBiDiDirection
pub extern("c") fn ubidi_getText(pBiDi: *const UBiDi) -> ?[*]const umachine.UChar
pub extern("c") fn ubidi_getLength(pBiDi: *const UBiDi) -> i32
pub extern("c") fn ubidi_getParaLevel(pBiDi: *const UBiDi) -> UBiDiLevel
pub extern("c") fn ubidi_countParagraphs(pBiDi: *UBiDi) -> i32
pub extern("c") fn ubidi_getParagraph(pBiDi: *const UBiDi, charIndex: i32, pParaStart: ?*i32, pParaLimit: ?*i32, pParaLevel: ?*UBiDiLevel, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ubidi_getParagraphByIndex(pBiDi: *const UBiDi, paraIndex: i32, pParaStart: ?*i32, pParaLimit: ?*i32, pParaLevel: ?*UBiDiLevel, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ubidi_getLevelAt(pBiDi: *const UBiDi, charIndex: i32) -> UBiDiLevel
pub extern("c") fn ubidi_getLevels(pBiDi: *UBiDi, pErrorCode: *utypes.UErrorCode) -> ?[*]const UBiDiLevel
pub extern("c") fn ubidi_getLogicalRun(pBiDi: *const UBiDi, logicalPosition: i32, pLogicalLimit: ?*i32, pLevel: ?*UBiDiLevel) -> void
pub extern("c") fn ubidi_countRuns(pBiDi: *UBiDi, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ubidi_getVisualRun(pBiDi: *UBiDi, runIndex: i32, pLogicalStart: ?*i32, pLength: ?*i32) -> UBiDiDirection
pub extern("c") fn ubidi_getVisualIndex(pBiDi: *UBiDi, logicalIndex: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ubidi_getLogicalIndex(pBiDi: *UBiDi, visualIndex: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ubidi_getLogicalMap(pBiDi: *UBiDi, indexMap: [*]i32, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ubidi_getVisualMap(pBiDi: *UBiDi, indexMap: [*]i32, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ubidi_reorderLogical(levels: [*]const UBiDiLevel, length: i32, indexMap: [*]i32) -> void
pub extern("c") fn ubidi_reorderVisual(levels: [*]const UBiDiLevel, length: i32, indexMap: [*]i32) -> void
pub extern("c") fn ubidi_invertMap(srcMap: [*]const i32, destMap: [*]i32, length: i32) -> void
pub extern("c") fn ubidi_getProcessedLength(pBiDi: *const UBiDi) -> i32
pub extern("c") fn ubidi_getResultLength(pBiDi: *const UBiDi, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ubidi_getCustomizedClass(pBiDi: *UBiDi, c: umachine.UChar32) -> uchar.UCharDirection
pub extern("c") fn ubidi_setClassCallback(pBiDi: *UBiDi, newFn: ?UBiDiClassCallback, newContext: ?*const anyopaque, oldFn: ?*UBiDiClassCallback, oldContext: ?**const anyopaque, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ubidi_getClassCallback(pBiDi: *UBiDi, callback: ?*UBiDiClassCallback, context: ?**const anyopaque) -> void
pub extern("c") fn ubidi_writeReordered(pBiDi: *UBiDi, dest: ?[*]umachine.UChar, destSize: i32, options: u16, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ubidi_writeReverse(src: [*]const umachine.UChar, srcLength: i32, dest: ?[*]umachine.UChar, destSize: i32, options: u16, pErrorCode: *utypes.UErrorCode) -> i32
