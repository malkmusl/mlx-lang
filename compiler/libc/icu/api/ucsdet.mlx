// unicode/ucsdet.h
// mlx-unicode: guessing the charset of bytes (the Unicode forms by their
// byte order marks and validity, ISO-2022 by its escapes, the East Asian
// multi-byte charsets by their structure, Latin-1 and windows-1252 else).
const uenum = @import("./uenum.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UCharsetDetector = struct {}
pub const UCharsetMatch = struct {}

pub extern("c") fn ucsdet_open(status: *utypes.UErrorCode) -> *UCharsetDetector
pub extern("c") fn ucsdet_close(ucsd: *UCharsetDetector) -> void
pub extern("c") fn ucsdet_setText(ucsd: *UCharsetDetector, textIn: [*]const umachine.c_char, len: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucsdet_setDeclaredEncoding(ucsd: *UCharsetDetector, encoding: [*]const umachine.c_char, length: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucsdet_detect(ucsd: *UCharsetDetector, status: *utypes.UErrorCode) -> *const UCharsetMatch
pub extern("c") fn ucsdet_detectAll(ucsd: *UCharsetDetector, matchesFound: *i32, status: *utypes.UErrorCode) -> [*]*const UCharsetMatch
pub extern("c") fn ucsdet_getName(ucsm: *const UCharsetMatch, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ucsdet_getConfidence(ucsm: *const UCharsetMatch, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucsdet_getLanguage(ucsm: *const UCharsetMatch, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ucsdet_getUChars(ucsm: *const UCharsetMatch, buf: [*]umachine.UChar, cap: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucsdet_getAllDetectableCharsets(ucsd: *const UCharsetDetector, status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucsdet_isInputFilterEnabled(ucsd: *const UCharsetDetector) -> umachine.UBool
pub extern("c") fn ucsdet_enableInputFilter(ucsd: *UCharsetDetector, filter: umachine.UBool) -> umachine.UBool
pub extern("c") fn ucsdet_getDetectableCharsets(ucsd: *const UCharsetDetector, status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucsdet_setDetectableCharset(ucsd: *UCharsetDetector, encoding: [*]const umachine.c_char, enabled: umachine.UBool, status: *utypes.UErrorCode) -> void
