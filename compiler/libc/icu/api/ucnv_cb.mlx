// unicode/ucnv_cb.h
// mlx-unicode: what a converter's callback writes with: bytes, the
// substitution or UTF-16 text in the charset (converting from UTF-16),
// UTF-16 or U+FFFD (converting to it), at the args' target, what does not
// fit kept for the converter's next call.
const ucnv = @import("./ucnv.mlx")
const ucnv_err = @import("./ucnv_err.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub extern("c") fn ucnv_cbFromUWriteBytes(args: *ucnv_err.UConverterFromUnicodeArgs, source: [*]const umachine.c_char, length: i32, offsetIndex: i32, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_cbFromUWriteSub(args: *ucnv_err.UConverterFromUnicodeArgs, offsetIndex: i32, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_cbFromUWriteUChars(args: *ucnv_err.UConverterFromUnicodeArgs, source: *[*]const umachine.UChar, sourceLimit: [*]const umachine.UChar, offsetIndex: i32, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_cbToUWriteUChars(args: *ucnv_err.UConverterToUnicodeArgs, source: [*]const umachine.UChar, length: i32, offsetIndex: i32, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_cbToUWriteSub(args: *ucnv_err.UConverterToUnicodeArgs, offsetIndex: i32, err: *utypes.UErrorCode) -> void
