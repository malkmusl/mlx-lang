// libxml2's memory and strings (xmlmemory.h, globals.h, xmlstring.h):
// the allocation functions the library calls through (C's until
// xmlMemSetup), and xmlChar strings made with them.
const text = @import("std.xml.text")

pub extern("c") fn malloc(size: usize) -> usize
pub extern("c") fn realloc(address: usize, size: usize) -> usize
pub extern("c") fn free(address: usize) -> void
pub extern("c") fn strdup(s: usize) -> usize

pub const Allocator = text.Allocator

// The library's allocator for its own memory (the parsers' tables and
// buffers): C's malloc.
fn allocatorAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const address = malloc(if length == 0 { 1 } else { length })
    if address == 0 { return null }
    return text.bytes(address)
}

fn allocatorResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> bool { return false }

fn allocatorRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> ?[*]u8 {
    const address = realloc(@intFromPtr(memory), if newLength == 0 { 1 } else { newLength })
    if address == 0 { return null }
    return text.bytes(address)
}

fn allocatorFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    free(@intFromPtr(memory))
}

pub fn allocator() -> Allocator {
    unsafe {
        return Allocator.{
            .context = @ptrFromInt(*anyopaque, 16),
            .allocFn = allocatorAlloc,
            .resizeFn = allocatorResize,
            .remapFn = allocatorRemap,
            .freeFn = allocatorFree
        }
    }
}

// The variables xmlMalloc, xmlMallocAtomic, xmlRealloc, xmlFree and
// xmlMemStrdup (the addresses of functions; 0 until first used, then
// C's).
var mallocFunction: usize = 0
var mallocAtomicFunction: usize = 0
var reallocFunction: usize = 0
var freeFunction: usize = 0
var strdupFunction: usize = 0

fn defaults() -> void {
    if mallocFunction == 0 { mallocFunction = @intFromPtr(malloc) }
    if mallocAtomicFunction == 0 { mallocAtomicFunction = @intFromPtr(malloc) }
    if reallocFunction == 0 { reallocFunction = @intFromPtr(realloc) }
    if freeFunction == 0 { freeFunction = @intFromPtr(free) }
    if strdupFunction == 0 { strdupFunction = @intFromPtr(strdup) }
}

const MallocFn = fn(usize) -> usize
const ReallocFn = fn(usize, usize) -> usize
const FreeFn = fn(usize) -> void

// Memory from xmlMalloc (as libxml2's strings are, which the program
// frees with xmlFree).
pub fn xmalloc(size: usize) -> usize {
    defaults()
    const call: MallocFn = unsafe { @ptrFromInt(MallocFn, mallocFunction) }
    return call(size)
}

pub fn xrealloc(address: usize, size: usize) -> usize {
    defaults()
    const call: ReallocFn = unsafe { @ptrFromInt(ReallocFn, reallocFunction) }
    return call(address, size)
}

pub fn xfree(address: usize) -> void {
    if address == 0 { return }
    defaults()
    const call: FreeFn = unsafe { @ptrFromInt(FreeFn, freeFunction) }
    call(address)
}

// A copy of the COUNT bytes at S and a 0 (xmlStrndup).
pub fn strndup(s: usize, count: usize) -> usize {
    if s == 0 { return 0 }
    const block = xmalloc(count + 1)
    if block == 0 { return 0 }
    text.copy(block, s, count)
    text.put8(block + count, 0)
    return block
}

pub fn dup(s: usize) -> usize {
    if s == 0 { return 0 }
    return strndup(s, text.length(s))
}

pub fn dupText(t: []const u8) -> usize {
    const block = xmalloc(t.length + 1)
    if block == 0 { return 0 }
    var index: usize = 0
    while index < t.length {
        text.put8(block + index, @intCast(u64, t[index]))
        index += 1
    }
    text.put8(block + t.length, 0)
    return block
}

// Zeroed memory of the library's own (C's calloc semantics).
pub fn zalloc(size: usize) -> usize {
    const block = malloc(size)
    if block != 0 { text.zero(block, size) }
    return block
}

export fn xmlMemSetup(freeFunc: usize, mallocFunc: usize, reallocFunc: usize, strdupFunc: usize) -> i32 {
    if freeFunc == 0 || mallocFunc == 0 || reallocFunc == 0 || strdupFunc == 0 { return -1 }
    freeFunction = freeFunc
    mallocFunction = mallocFunc
    mallocAtomicFunction = mallocFunc
    reallocFunction = reallocFunc
    strdupFunction = strdupFunc
    return 0
}

export fn xmlGcMemSetup(freeFunc: usize, mallocFunc: usize, mallocAtomicFunc: usize, reallocFunc: usize, strdupFunc: usize) -> i32 {
    if freeFunc == 0 || mallocFunc == 0 || mallocAtomicFunc == 0 || reallocFunc == 0 || strdupFunc == 0 { return -1 }
    freeFunction = freeFunc
    mallocFunction = mallocFunc
    mallocAtomicFunction = mallocAtomicFunc
    reallocFunction = reallocFunc
    strdupFunction = strdupFunc
    return 0
}

export fn xmlMemGet(freeFunc: usize, mallocFunc: usize, reallocFunc: usize, strdupFunc: usize) -> i32 {
    defaults()
    if freeFunc != 0 { text.putWord(freeFunc, freeFunction) }
    if mallocFunc != 0 { text.putWord(mallocFunc, mallocFunction) }
    if reallocFunc != 0 { text.putWord(reallocFunc, reallocFunction) }
    if strdupFunc != 0 { text.putWord(strdupFunc, strdupFunction) }
    return 0
}

export fn xmlInitMemory() -> i32 {
    defaults()
    return 0
}

export fn xmlCleanupMemory() -> void {}
export fn xmlMemUsed() -> i32 { return 0 }
export fn xmlMemBlocks() -> i32 { return 0 }
export fn xmlMemMalloc(size: usize) -> usize { return malloc(size) }
export fn xmlMemRealloc(address: usize, size: usize) -> usize { return realloc(address, size) }
export fn xmlMemFree(address: usize) -> void { free(address) }
export fn xmlMemoryStrdup(s: usize) -> usize { return strdup(s) }

export fn __xmlMalloc() -> usize {
    defaults()
    return @intFromPtr(&mallocFunction)
}

export fn __xmlMallocAtomic() -> usize {
    defaults()
    return @intFromPtr(&mallocAtomicFunction)
}

export fn __xmlRealloc() -> usize {
    defaults()
    return @intFromPtr(&reallocFunction)
}

export fn __xmlFree() -> usize {
    defaults()
    return @intFromPtr(&freeFunction)
}

export fn __xmlMemStrdup() -> usize {
    defaults()
    return @intFromPtr(&strdupFunction)
}

// ---------------------------------------------------------------------------
// Strings (xmlstring.h)

inline fn lower(c: u64) -> u64 { return if c >= 65 && c <= 90 { c + 32 } else { c } }

export fn xmlStrdup(cur: usize) -> usize { return dup(cur) }

export fn xmlStrndup(cur: usize, len: i32) -> usize {
    if cur == 0 || len < 0 { return 0 }
    return strndup(cur, @intCast(usize, len))
}

export fn xmlCharStrndup(cur: usize, len: i32) -> usize {
    if cur == 0 || len < 0 { return 0 }
    return strndup(cur, @intCast(usize, len))
}

export fn xmlCharStrdup(cur: usize) -> usize { return dup(cur) }

export fn xmlStrsub(str: usize, start: i32, len: i32) -> usize {
    if str == 0 || start < 0 || len < 0 { return 0 }
    var at = str
    var i: i32 = 0
    while i < start {
        if text.get8(at) == 0 { return 0 }
        at += 1
        i += 1
    }
    if text.get8(at) == 0 { return 0 }
    return strndup(at, @intCast(usize, len))
}

export fn xmlStrchr(str: usize, val: u8) -> usize {
    if str == 0 { return 0 }
    var at = str
    while text.get8(at) != 0 {
        if text.get8(at) == @intCast(u64, val) { return at }
        at += 1
    }
    return 0
}

export fn xmlStrstr(str: usize, val: usize) -> usize {
    if str == 0 || val == 0 { return 0 }
    const n = text.length(val)
    if n == 0 { return 0 }
    var at = str
    while text.get8(at) != 0 {
        if text.get8(at) == text.get8(val) && text.same(at, val, n) { return at }
        at += 1
    }
    return 0
}

export fn xmlStrcasestr(str: usize, val: usize) -> usize {
    if str == 0 || val == 0 { return 0 }
    const n = text.length(val)
    if n == 0 { return str }
    var at = str
    while text.get8(at) != 0 {
        var k: usize = 0
        while k < n && lower(text.get8(at + k)) == lower(text.get8(val + k)) { k += 1 }
        if k == n { return at }
        at += 1
    }
    return 0
}

export fn xmlStrcmp(str1: usize, str2: usize) -> i32 {
    if str1 == str2 { return 0 }
    if str1 == 0 { return -1 }
    if str2 == 0 { return 1 }
    var i: usize = 0
    while true {
        const a = text.get8(str1 + i)
        const b = text.get8(str2 + i)
        if a != b { return @intCast(i32, @intCast(i64, a) - @intCast(i64, b)) }
        if a == 0 { return 0 }
        i += 1
    }
    return 0
}

export fn xmlStrncmp(str1: usize, str2: usize, len: i32) -> i32 {
    if len <= 0 { return 0 }
    if str1 == str2 { return 0 }
    if str1 == 0 { return -1 }
    if str2 == 0 { return 1 }
    var i: usize = 0
    while i < @intCast(usize, len) {
        const a = text.get8(str1 + i)
        const b = text.get8(str2 + i)
        if a != b { return @intCast(i32, @intCast(i64, a) - @intCast(i64, b)) }
        if a == 0 { return 0 }
        i += 1
    }
    return 0
}

export fn xmlStrcasecmp(str1: usize, str2: usize) -> i32 {
    if str1 == str2 { return 0 }
    if str1 == 0 { return -1 }
    if str2 == 0 { return 1 }
    var i: usize = 0
    while true {
        const a = lower(text.get8(str1 + i))
        const b = lower(text.get8(str2 + i))
        if a != b { return @intCast(i32, @intCast(i64, a) - @intCast(i64, b)) }
        if a == 0 { return 0 }
        i += 1
    }
    return 0
}

export fn xmlStrncasecmp(str1: usize, str2: usize, len: i32) -> i32 {
    if len <= 0 { return 0 }
    if str1 == str2 { return 0 }
    if str1 == 0 { return -1 }
    if str2 == 0 { return 1 }
    var i: usize = 0
    while i < @intCast(usize, len) {
        const a = lower(text.get8(str1 + i))
        const b = lower(text.get8(str2 + i))
        if a != b { return @intCast(i32, @intCast(i64, a) - @intCast(i64, b)) }
        if a == 0 { return 0 }
        i += 1
    }
    return 0
}

export fn xmlStrEqual(str1: usize, str2: usize) -> i32 { return if text.equal(str1, str2) { 1 } else { 0 } }

export fn xmlStrQEqual(pref: usize, name: usize, str: usize) -> i32 {
    if pref == 0 { return xmlStrEqual(name, str) }
    if name == 0 || str == 0 { return 0 }
    var at = str
    var p = pref
    while text.get8(p) != 0 {
        if text.get8(at) != text.get8(p) { return 0 }
        at += 1
        p += 1
    }
    if text.get8(at) != 58 { return 0 }
    return xmlStrEqual(name, at + 1)
}

export fn xmlStrlen(str: usize) -> i32 { return @intCast(i32, text.length(str) & 0x7fffffff) }

export fn xmlStrncat(cur: usize, add: usize, len: i32) -> usize {
    if add == 0 || len == 0 { return cur }
    if len < 0 { return 0 }
    if cur == 0 { return strndup(add, @intCast(usize, len)) }
    const size = text.length(cur)
    const ret = xrealloc(cur, size + @intCast(usize, len) + 1)
    if ret == 0 { return cur }
    text.copy(ret + size, add, @intCast(usize, len))
    text.put8(ret + size + @intCast(usize, len), 0)
    return ret
}

export fn xmlStrcat(cur: usize, add: usize) -> usize {
    if add == 0 { return cur }
    if cur == 0 { return dup(add) }
    return xmlStrncat(cur, add, @intCast(i32, text.length(add)))
}

export fn xmlStrncatNew(str1: usize, str2: usize, len: i32) -> usize {
    var n = len
    if n < 0 {
        if str2 == 0 { return 0 }
        n = @intCast(i32, text.length(str2))
    }
    if str2 == 0 || n == 0 { return dup(str1) }
    if str1 == 0 { return strndup(str2, @intCast(usize, n)) }
    const size = text.length(str1)
    const ret = xmalloc(size + @intCast(usize, n) + 1)
    if ret == 0 { return 0 }
    text.copy(ret, str1, size)
    text.copy(ret + size, str2, @intCast(usize, n))
    text.put8(ret + size + @intCast(usize, n), 0)
    return ret
}

// The length of the UTF-8 sequence at UTF (0 where it is not one).
fn utf8Length(utf: usize) -> usize {
    const c = text.get8(utf)
    if (c & 0x80) == 0 { return 1 }
    if (c & 0x40) == 0 { return 0 }
    var n: usize = 0
    if (c & 0x20) == 0 {
        n = 2
    } else if (c & 0x10) == 0 {
        n = 3
    } else if (c & 0x08) == 0 {
        n = 4
    } else {
        return 0
    }
    var k: usize = 1
    while k < n {
        if (text.get8(utf + k) & 0xC0) != 0x80 { return 0 }
        k += 1
    }
    return n
}

export fn xmlGetUTF8Char(utf: usize, len: usize) -> i32 {
    if utf == 0 || len == 0 { return -1 }
    const avail = text.getInt(len)
    if avail < 1 {
        text.putInt(len, 0)
        return -1
    }
    const c = text.get8(utf)
    var n: i64 = 0
    var val: u64 = 0
    if (c & 0x80) == 0 {
        text.putInt(len, 1)
        return @intCast(i32, c)
    } else if (c & 0xE0) == 0xC0 {
        n = 2
        val = c & 0x1F
    } else if (c & 0xF0) == 0xE0 {
        n = 3
        val = c & 0x0F
    } else if (c & 0xF8) == 0xF0 {
        n = 4
        val = c & 0x07
    } else {
        text.putInt(len, 0)
        return -1
    }
    if avail < n {
        text.putInt(len, 0)
        return -1
    }
    var k: i64 = 1
    while k < n {
        const d = text.get8(utf + @intCast(usize, k))
        if (d & 0xC0) != 0x80 {
            text.putInt(len, 0)
            return -1
        }
        val = (val << 6) | (d & 0x3F)
        k += 1
    }
    if (n == 2 && val < 0x80) || (n == 3 && val < 0x800) || (n == 4 && (val < 0x10000 || val >= 0x110000)) {
        text.putInt(len, 0)
        return -1
    }
    text.putInt(len, n)
    return @intCast(i32, val)
}

export fn xmlCheckUTF8(utf: usize) -> i32 {
    if utf == 0 { return 0 }
    var at = utf
    while text.get8(at) != 0 {
        const n = utf8Length(at)
        if n == 0 { return 0 }
        at += n
    }
    return 1
}

export fn xmlUTF8Strsize(utf: usize, len: i32) -> i32 {
    if utf == 0 || len <= 0 { return 0 }
    var at = utf
    var k: i32 = 0
    while k < len && text.get8(at) != 0 {
        const n = utf8Length(at)
        if n == 0 { break }
        at += n
        k += 1
    }
    return @intCast(i32, at - utf)
}

export fn xmlUTF8Strndup(utf: usize, len: i32) -> usize {
    if utf == 0 || len < 0 { return 0 }
    return strndup(utf, @intCast(usize, xmlUTF8Strsize(utf, len)))
}

export fn xmlUTF8Strpos(utf: usize, pos: i32) -> usize {
    if utf == 0 || pos < 0 { return 0 }
    var at = utf
    var k: i32 = 0
    while k < pos {
        if text.get8(at) == 0 { return 0 }
        const n = utf8Length(at)
        if n == 0 { return 0 }
        at += n
        k += 1
    }
    return at
}

export fn xmlUTF8Strloc(utf: usize, utfchar: usize) -> i32 {
    if utf == 0 || utfchar == 0 { return -1 }
    const size = utf8Length(utfchar)
    if size == 0 { return -1 }
    var at = utf
    var i: i32 = 0
    while text.get8(at) != 0 {
        if text.same(at, utfchar, size) { return i }
        const n = utf8Length(at)
        if n == 0 { return -1 }
        at += n
        i += 1
    }
    return -1
}

export fn xmlUTF8Strsub(utf: usize, start: i32, len: i32) -> usize {
    if utf == 0 || start < 0 || len < 0 { return 0 }
    const at = xmlUTF8Strpos(utf, start)
    if at == 0 { return 0 }
    return xmlUTF8Strndup(at, len)
}

export fn xmlUTF8Strlen(utf: usize) -> i32 {
    if utf == 0 { return -1 }
    var at = utf
    var count: i32 = 0
    while text.get8(at) != 0 {
        const n = utf8Length(at)
        if n == 0 { return -1 }
        at += n
        count += 1
    }
    return count
}

export fn xmlUTF8Size(utf: usize) -> i32 {
    if utf == 0 { return -1 }
    const c = text.get8(utf)
    if (c & 0x80) == 0 { return 1 }
    if (c & 0x40) == 0 { return -1 }
    var len: i32 = 2
    var mask: u64 = 0x20
    while (c & mask) != 0 {
        len += 1
        mask = mask >> 1
        if mask == 0 { return -1 }
    }
    return len
}

export fn xmlUTF8Charcmp(utf1: usize, utf2: usize) -> i32 {
    if utf1 == 0 {
        if utf2 == 0 { return 0 }
        return -1
    }
    return xmlStrncmp(utf1, utf2, xmlUTF8Size(utf1))
}
