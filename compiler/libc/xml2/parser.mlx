// libxml2's parser (parser.h, parserInternals.h): the push parser
// (xmlCreatePushParserCtxt, xmlParseChunk) and the parser of content in
// memory (xmlCreateMemoryParserCtxt, xmlParseContent) over std.xml.sax.
// The std parser calls this module's callbacks (the forwarders below),
// which show the parser's state in the C context and call the
// program's SAX handler with its userData, as libxml2's parser calls it,
// and do for the parser what libxml2 does around the callbacks: its
// fallbacks to SAX2's own entities when the handler finds none, its
// "SAX compatibility mode" document of entities for handlers that keep
// none, its routing of errors (errors.mlx), the context of an entity's
// content parsed apart (xmlParseBalancedChunkMemoryInternal's, sharing
// the handler, the dictionary and the document).
const text = @import("std.xml.text")
const sax = @import("std.xml.sax")
const encoding = @import("std.xml.encoding")
const m = @import("./memory.mlx")
const layout = @import("./layout.mlx")
const errors = @import("./errors.mlx")
const globals = @import("./globals.mlx")
const tree = @import("./tree.mlx")
const context = @import("./context.mlx")
const sax2 = @import("./sax2.mlx")
const charsets = @import("./encoding.mlx")

// Exports of the library's other modules (called as C calls them).
extern("c") fn xmlSAX2GetPublicId(ctx: usize) -> usize
extern("c") fn xmlSAX2GetSystemId(ctx: usize) -> usize
extern("c") fn xmlSAX2GetLineNumber(ctx: usize) -> i32
extern("c") fn xmlSAX2GetColumnNumber(ctx: usize) -> i32
extern("c") fn xmlSAX2GetEntity(ctx: usize, name: usize) -> usize
extern("c") fn xmlNewDoc(version: usize) -> usize
extern("c") fn xmlNewDtd(doc: usize, name: usize, externalId: usize, systemId: usize) -> usize
extern("c") fn xmlSAX2EntityDecl(ctx: usize, name: usize, etype: i32, publicId: usize, systemId: usize, content: usize) -> void
extern("c") fn xmlFreeDoc(doc: usize) -> void
extern("c") fn xmlSAXVersion(hdlr: usize, version: i32) -> i32
extern("c") fn xmlSAX2IgnorableWhitespace(ctx: usize, ch: usize, len: i32) -> void
extern("c") fn xmlSAX2StartElement(ctx: usize, fullname: usize, atts: usize) -> void
extern("c") fn xmlSAX2EndElement(ctx: usize, name: usize) -> void

const Ctxt = layout.Ctxt
const SAXHandler = layout.SAXHandler

inline fn ctxtAt(address: usize) -> *Ctxt { return context.ctxtAt(address) }
inline fn saxAt(address: usize) -> *SAXHandler { return context.saxAt(address) }

// The C callbacks' types.
const CCall1 = fn(usize) -> void
const CCall2 = fn(usize, usize) -> void
const CCall3 = fn(usize, usize, usize) -> void
const CCall4 = fn(usize, usize, usize, usize) -> void
const CCall5 = fn(usize, usize, usize, usize, usize) -> void
const CEntityDecl = fn(usize, usize, i32, usize, usize, usize) -> void
const CText = fn(usize, usize, i32) -> void
const CStartElementNs = fn(usize, usize, usize, usize, i32, usize, i32, i32, usize) -> void
const CGetEntity = fn(usize, usize) -> usize

// The SAX handler of the context CTXT.
fn handlerOf(ctxt: usize) -> *SAXHandler { return saxAt(ctxtAt(ctxt).*.sax) }

fn userOf(ctxt: usize) -> usize { return ctxtAt(ctxt).*.userData }

// ---------------------------------------------------------------------------
// The forwarders: the std parser's callbacks, with the C context as the
// handler's user.

// xmlDefaultSAXLocator: the locator setDocumentLocator is handed.
var locatorStorage: [4]u64 = [4]u64{ 0, 0, 0, 0 }

fn locator() -> usize {
    const l = unsafe { @ptrFromInt(*layout.Locator, @intFromPtr(&locatorStorage)) }
    if l.*.getPublicId == 0 {
        l.*.getPublicId = @intFromPtr(xmlSAX2GetPublicId)
        l.*.getSystemId = @intFromPtr(xmlSAX2GetSystemId)
        l.*.getLineNumber = @intFromPtr(xmlSAX2GetLineNumber)
        l.*.getColumnNumber = @intFromPtr(xmlSAX2GetColumnNumber)
    }
    return @intFromPtr(&locatorStorage)
}

fn onSetDocumentLocator(ctxt: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.setDocumentLocator
    if f == 0 { return }
    const call: CCall2 = unsafe { @ptrFromInt(CCall2, f) }
    call(userOf(ctxt), locator())
}

fn onStartDocument(ctxt: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.startDocument
    if f == 0 { return }
    const call: CCall1 = unsafe { @ptrFromInt(CCall1, f) }
    call(userOf(ctxt))
}

fn onEndDocument(ctxt: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.endDocument
    if f == 0 { return }
    const call: CCall1 = unsafe { @ptrFromInt(CCall1, f) }
    call(userOf(ctxt))
}

fn onInternalSubset(ctxt: usize, name: usize, externalId: usize, systemId: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.internalSubset
    if f == 0 { return }
    const call: CCall4 = unsafe { @ptrFromInt(CCall4, f) }
    call(userOf(ctxt), name, externalId, systemId)
}

fn onExternalSubset(ctxt: usize, name: usize, externalId: usize, systemId: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.externalSubset
    if f == 0 { return }
    const call: CCall4 = unsafe { @ptrFromInt(CCall4, f) }
    call(userOf(ctxt), name, externalId, systemId)
}

fn onEntityDecl(ctxt: usize, name: usize, etype: i64, publicId: usize, systemId: usize, content: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.entityDecl
    if f == 0 { return }
    const call: CEntityDecl = unsafe { @ptrFromInt(CEntityDecl, f) }
    call(userOf(ctxt), name, @intCast(i32, etype), publicId, systemId, content)
}

fn onNotationDecl(ctxt: usize, name: usize, publicId: usize, systemId: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.notationDecl
    if f == 0 { return }
    const call: CCall4 = unsafe { @ptrFromInt(CCall4, f) }
    call(userOf(ctxt), name, publicId, systemId)
}

fn onUnparsedEntityDecl(ctxt: usize, name: usize, publicId: usize, systemId: usize, notation: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.unparsedEntityDecl
    if f == 0 { return }
    const call: CCall5 = unsafe { @ptrFromInt(CCall5, f) }
    call(userOf(ctxt), name, publicId, systemId, notation)
}

fn onStartElementNs(ctxt: usize, localname: usize, prefix: usize, uriValue: usize, nbNamespaces: i64, namespaces: usize, nbAttributes: i64, nbDefaulted: i64, attributes: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.startElementNs
    if f == 0 { return }
    const call: CStartElementNs = unsafe { @ptrFromInt(CStartElementNs, f) }
    call(userOf(ctxt), localname, prefix, uriValue, @intCast(i32, nbNamespaces), namespaces, @intCast(i32, nbAttributes), @intCast(i32, nbDefaulted), attributes)
}

fn onEndElementNs(ctxt: usize, localname: usize, prefix: usize, uriValue: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.endElementNs
    if f == 0 { return }
    const call: CCall4 = unsafe { @ptrFromInt(CCall4, f) }
    call(userOf(ctxt), localname, prefix, uriValue)
}

fn callText(ctxt: usize, f: usize, s: usize, len: i64) -> void {
    if f == 0 { return }
    const call: CText = unsafe { @ptrFromInt(CText, f) }
    call(userOf(ctxt), s, @intCast(i32, len))
}

fn onCharacters(ctxt: usize, s: usize, len: i64) -> void {
    context.show(ctxt)
    callText(ctxt, handlerOf(ctxt).*.characters, s, len)
}

fn onIgnorableWhitespace(ctxt: usize, s: usize, len: i64) -> void {
    context.show(ctxt)
    callText(ctxt, handlerOf(ctxt).*.ignorableWhitespace, s, len)
}

fn onCdataBlock(ctxt: usize, s: usize, len: i64) -> void {
    context.show(ctxt)
    callText(ctxt, handlerOf(ctxt).*.cdataBlock, s, len)
}

fn onWhitespaceDiffers(ctxt: usize) -> bool {
    const h = handlerOf(ctxt)
    return h.*.ignorableWhitespace != h.*.characters
}

fn onComment(ctxt: usize, value: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.comment
    if f == 0 { return }
    const call: CCall2 = unsafe { @ptrFromInt(CCall2, f) }
    call(userOf(ctxt), value)
}

fn onProcessingInstruction(ctxt: usize, target: usize, data: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.processingInstruction
    if f == 0 { return }
    const call: CCall3 = unsafe { @ptrFromInt(CCall3, f) }
    call(userOf(ctxt), target, data)
}

fn onReference(ctxt: usize, name: usize) -> void {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.reference
    if f == 0 { return }
    const call: CCall2 = unsafe { @ptrFromInt(CCall2, f) }
    call(userOf(ctxt), name)
}

// The entity ENT shown to the parser.
fn viewOf(ent: usize, view: *sax.EntityView) -> void {
    const e = tree.entityAt(ent)
    view.*.address = ent
    view.*.etype = @intCast(i64, e.*.etype)
    view.*.name = e.*.name
    view.*.content = e.*.content
    view.*.length = @intCast(i64, e.*.length)
    view.*.checked = ent + @offsetOf(tree.Entity, "checked")
    view.*.children = e.*.children
    view.*.uri = e.*.URI
    view.*.externalId = e.*.ExternalID
    view.*.orig = ent + @offsetOf(tree.Entity, "orig")
    view.*.expandedSize = ent + @offsetOf(tree.Entity, "expandedSize")
}

// The handler's getEntity, then libxml2's fallback to SAX2's own when it
// finds none and the handler's user is the context: in a reference of
// content or an attribute (MODE 0) only while the document is
// well-formed.
fn onGetEntity(ctxt: usize, name: usize, view: *sax.EntityView, mode: i64) -> bool {
    context.show(ctxt)
    const c = ctxtAt(ctxt)
    var ent: usize = 0
    const f = handlerOf(ctxt).*.getEntity
    if f != 0 {
        const call: CGetEntity = unsafe { @ptrFromInt(CGetEntity, f) }
        ent = call(c.*.userData, name)
    }
    if ent == 0 && c.*.userData == ctxt {
        context.show(ctxt)
        if mode != 0 || c.*.wellFormed == 1 { ent = xmlSAX2GetEntity(ctxt, name) }
    }
    if ent == 0 { return false }
    viewOf(ent, view)
    return true
}

fn onGetParameterEntity(ctxt: usize, name: usize, view: *sax.EntityView) -> bool {
    context.show(ctxt)
    const f = handlerOf(ctxt).*.getParameterEntity
    if f == 0 { return false }
    const call: CGetEntity = unsafe { @ptrFromInt(CGetEntity, f) }
    const ent = call(userOf(ctxt), name)
    if ent == 0 { return false }
    viewOf(ent, view)
    return true
}

// After a general entity's declaration, "for expat compatibility in SAX
// mode": the declaration kept in a document of the parser's own when the
// handler made none.
fn onEntityDeclared(ctxt: usize, name: usize, etype: i64, publicId: usize, systemId: usize, content: usize) -> void {
    context.show(ctxt)
    const c = ctxtAt(ctxt)
    if c.*.myDoc != 0 && !text.equalText(tree.docAt(c.*.myDoc).*.version, "SAX compatibility mode document") { return }
    if c.*.myDoc == 0 {
        c.*.myDoc = xmlNewDoc(@intFromPtr("SAX compatibility mode document".pointer))
        if c.*.myDoc == 0 {
            context.errMemory(ctxt, "New Doc failed")
            return
        }
        tree.docAt(c.*.myDoc).*.properties = tree.DOC_INTERNAL
    }
    const doc = tree.docAt(c.*.myDoc)
    if doc.*.intSubset == 0 { doc.*.intSubset = xmlNewDtd(c.*.myDoc, @intFromPtr("fake".pointer), 0, 0) }
    xmlSAX2EntityDecl(ctxt, name, @intCast(i32, etype), publicId, systemId, content)
}

// The value of an entity as written (its orig) kept in a string of
// xmlMalloc's, which xmlFreeDoc frees.
fn onKeepString(ctxt: usize, place: usize, string: usize) -> void { text.putWord(place, m.dup(string)) }

// An error of the parser: routed as __xmlRaiseError routes it.
fn onError(ctxt: usize, record: *sax.ErrorRecord) -> void {
    context.show(ctxt)
    const domain = @intCast(i32, record.*.domain)
    const code = @intCast(i32, record.*.code)
    const level = @intCast(i32, record.*.level)
    const message = m.dup(record.*.message)
    if record.*.noContext {
        if domain == 0 && code == 0 {
            // A message libxml2 writes with xmlGenericError itself.
            errors.genericMessage(message)
            m.xfree(message)
            return
        }
        // (The loader's warning comes from the context libxml2 makes for
        // the entity, whose handler is the default one: its report, made
        // as for no context.)
        errors.raise(0, 0, 0, 0, domain, code, level, 0, 0, record.*.str1, record.*.str2, record.*.str3, @intCast(i32, record.*.int1), 0, message)
        return
    }
    var schannel: usize = 0
    var channel: usize = 0
    const c = ctxtAt(ctxt)
    var data = c.*.userData
    const h = handlerOf(ctxt)
    if h.*.initialized == errors.XML_SAX2_MAGIC { schannel = h.*.serror }
    if record.*.channel == 2 {
        // A validity error: the validity context's handler.
        channel = c.*.vctxt.error_
        data = c.*.vctxt.userData
    } else if level == errors.LEVEL_WARNING {
        channel = h.*.warning
    }
    errors.raise(schannel, channel, data, ctxt, domain, code, level, record.*.file, @intCast(i32, record.*.line), record.*.str1, record.*.str2, record.*.str3, @intCast(i32, record.*.int1), @intCast(i32, record.*.col), message)
}

// The context of an entity's content parsed by a parser of its own (the
// std parser NESTED): the handler, dictionary and document of CTXT's,
// and its user the context itself unless CTXT's user is another.
fn onNestedBegin(ctxt: usize, nested: usize) -> usize {
    context.show(ctxt)
    const parent = ctxtAt(ctxt)
    const n = context.allocate()
    if n == 0 { return ctxt }
    const t = context.trailerOf(n)
    t.*.parser = nested
    t.*.nested = true
    const c = ctxtAt(n)
    c.*.userData = if parent.*.userData == ctxt { n } else { parent.*.userData }
    c.*.sax = parent.*.sax
    c.*._private = parent.*._private
    c.*.options = parent.*.options
    c.*.replaceEntities = parent.*.replaceEntities
    c.*.loadsubset = parent.*.loadsubset
    c.*.dictNames = parent.*.dictNames
    c.*.vctxt.error_ = parent.*.vctxt.error_
    c.*.vctxt.warning = parent.*.vctxt.warning
    if parent.*.myDoc == 0 {
        const doc = xmlNewDoc(@intFromPtr("1.0".pointer))
        if doc != 0 {
            tree.docAt(doc).*.properties = tree.DOC_INTERNAL
            tree.docAt(doc).*.dict = parent.*.dict
            text.dictReference(parent.*.dict)
        }
        c.*.myDoc = doc
        t.*.newDoc = doc
    } else {
        c.*.myDoc = parent.*.myDoc
    }
    sax.parserAt(nested).*.handler.user = n
    context.show(n)
    return n
}

fn onNestedEnd(ctxt: usize, n: usize) -> void {
    if n == ctxt || n == 0 { return }
    const t = context.trailerOf(n)
    const doc = t.*.newDoc
    freeContext(n)
    if doc != 0 { xmlFreeDoc(doc) }
    context.show(ctxt)
}

// The std handler of the context: a forwarder for each callback the C
// handler has.
fn handlerFor(ctxt: usize) -> sax.Handler {
    var h = sax.emptyHandler()
    h.user = ctxt
    if ctxtAt(ctxt).*.sax == 0 { return h }
    const s = handlerOf(ctxt)
    if s.*.setDocumentLocator != 0 { h.setDocumentLocator = @intFromPtr(onSetDocumentLocator) }
    if s.*.startDocument != 0 { h.startDocument = @intFromPtr(onStartDocument) }
    if s.*.endDocument != 0 { h.endDocument = @intFromPtr(onEndDocument) }
    if s.*.internalSubset != 0 { h.internalSubset = @intFromPtr(onInternalSubset) }
    if s.*.externalSubset != 0 { h.externalSubset = @intFromPtr(onExternalSubset) }
    if s.*.entityDecl != 0 { h.entityDecl = @intFromPtr(onEntityDecl) }
    if s.*.notationDecl != 0 { h.notationDecl = @intFromPtr(onNotationDecl) }
    if s.*.unparsedEntityDecl != 0 { h.unparsedEntityDecl = @intFromPtr(onUnparsedEntityDecl) }
    h.getEntity = @intFromPtr(onGetEntity)
    if s.*.getParameterEntity != 0 { h.getParameterEntity = @intFromPtr(onGetParameterEntity) }
    if s.*.startElementNs != 0 { h.startElementNs = @intFromPtr(onStartElementNs) }
    if s.*.endElementNs != 0 { h.endElementNs = @intFromPtr(onEndElementNs) }
    if s.*.characters != 0 { h.characters = @intFromPtr(onCharacters) }
    if s.*.ignorableWhitespace != 0 { h.ignorableWhitespace = @intFromPtr(onIgnorableWhitespace) }
    h.whitespaceDiffers = @intFromPtr(onWhitespaceDiffers)
    if s.*.cdataBlock != 0 { h.cdataBlock = @intFromPtr(onCdataBlock) }
    if s.*.comment != 0 { h.comment = @intFromPtr(onComment) }
    if s.*.processingInstruction != 0 { h.processingInstruction = @intFromPtr(onProcessingInstruction) }
    if s.*.reference != 0 { h.reference = @intFromPtr(onReference) }
    h.reportError = @intFromPtr(onError)
    h.nestedBegin = @intFromPtr(onNestedBegin)
    h.nestedEnd = @intFromPtr(onNestedEnd)
    h.entityDeclared = @intFromPtr(onEntityDeclared)
    h.keepString = @intFromPtr(onKeepString)
    return h
}

// What the program may have changed taken by the parser: the fields and
// the handler.
fn enter(ctxt: usize) -> void {
    context.take(ctxt)
    const p = context.parserOf(ctxt)
    const user = p.*.handler.user
    p.*.handler = handlerFor(ctxt)
    p.*.handler.user = user
}

// ---------------------------------------------------------------------------
// Contexts

// A context of the std parser at PARSER (0 when there is none).
fn contextOf(parser: usize) -> usize {
    if parser == 0 { return 0 }
    const ctxt = context.allocate()
    if ctxt == 0 {
        sax.free(parser)
        return 0
    }
    context.trailerOf(ctxt).*.parser = parser
    sax.parserAt(parser).*.handler.user = ctxt
    return ctxt
}

// The handler a context starts with: SAX2's defaults.
fn defaultHandler(ctxt: usize) -> bool {
    const s = m.xmalloc(@sizeOf(SAXHandler))
    if s == 0 { return false }
    text.zero(s, @sizeOf(SAXHandler))
    const ignored = xmlSAXVersion(s, 2)
    if globals.keepBlanksDefault == 0 { saxAt(s).*.ignorableWhitespace = @intFromPtr(xmlSAX2IgnorableWhitespace) }
    ctxtAt(ctxt).*.sax = s
    return true
}

// The options of libxml2's defaults (xmlKeepBlanksDefault and its kin)
// the parser takes.
fn takeDefaults(ctxt: usize) -> void {
    const p = context.parserOf(ctxt)
    var options: u64 = 0
    if globals.substituteEntitiesDefault != 0 { options = options | sax.PARSE_NOENT }
    if globals.keepBlanksDefault == 0 { options = options | sax.PARSE_NOBLANKS }
    if globals.pedanticParserDefault != 0 { options = options | sax.PARSE_PEDANTIC }
    if globals.doValidityCheckingDefault != 0 { options = options | sax.PARSE_DTDVALID }
    if globals.loadExtDtdDefault != 0 { options = options | sax.PARSE_DTDLOAD }
    const ignored = sax.useOptions(p, options)
}

fn freeContext(ctxt: usize) -> void {
    const c = ctxtAt(ctxt)
    const t = context.trailerOf(ctxt)
    if !t.*.nested {
        if t.*.parser != 0 { sax.free(t.*.parser) }
        m.xfree(c.*.sax)
    }
    m.free(t.*.inputs)
    m.free(c.*.inputTab)
    m.xfree(c.*.directory)
    m.xfree(c.*.lastError.message)
    m.xfree(c.*.lastError.file)
    m.xfree(c.*.lastError.str1)
    m.xfree(c.*.lastError.str2)
    m.xfree(c.*.lastError.str3)
    t.*.magic = 0
    m.free(ctxt)
}

export fn xmlFreeParserCtxt(ctxt: usize) -> void {
    if ctxt == 0 || !context.isContext(ctxt) { return }
    freeContext(ctxt)
}

// The handler SAX (when not NULL) copied as the context's, USER its user.
fn useHandler(ctxt: usize, s: usize, user: usize) -> void {
    if s == 0 { return }
    const c = ctxtAt(ctxt)
    text.zero(c.*.sax, @sizeOf(SAXHandler))
    if saxAt(s).*.initialized == errors.XML_SAX2_MAGIC {
        text.copy(c.*.sax, s, @sizeOf(SAXHandler))
    } else {
        text.copy(c.*.sax, s, @offsetOf(SAXHandler, "initialized") + 4)
    }
    if user != 0 { c.*.userData = user }
}

export fn xmlCreatePushParserCtxt(s: usize, user: usize, chunk: usize, size: i32, filename: usize) -> usize {
    const count = if size > 0 && chunk != 0 { @intCast(usize, size) } else { 0 }
    const ctxt = contextOf(sax.createPush(m.allocator(), sax.emptyHandler(), chunk, count))
    if ctxt == 0 { return 0 }
    if !defaultHandler(ctxt) {
        freeContext(ctxt)
        return 0
    }
    useHandler(ctxt, s, user)
    const p = context.parserOf(ctxt)
    takeDefaults(ctxt)
    if filename != 0 {
        sax.inputAt(p.*.input).*.filename = text.duplicateString(p.*.allocator, filename)
        ctxtAt(ctxt).*.directory = directoryOf(filename)
    }
    p.*.handler = handlerFor(ctxt)
    context.show(ctxt)
    return ctxt
}

export fn xmlCreateMemoryParserCtxt(buffer: usize, size: i32) -> usize {
    if buffer == 0 || size <= 0 { return 0 }
    const ctxt = contextOf(sax.createMemory(m.allocator(), sax.emptyHandler(), buffer, @intCast(usize, size)))
    if ctxt == 0 { return 0 }
    if !defaultHandler(ctxt) {
        freeContext(ctxt)
        return 0
    }
    takeDefaults(ctxt)
    const p = context.parserOf(ctxt)
    p.*.handler = handlerFor(ctxt)
    context.show(ctxt)
    return ctxt
}

export fn xmlCreateDocParserCtxt(cur: usize) -> usize {
    if cur == 0 { return 0 }
    return xmlCreateMemoryParserCtxt(cur, @intCast(i32, text.length(cur) & 0x7fffffff))
}

// xmlNewParserCtxt: a context without a document (a push parser's,
// until xmlCtxtResetPush gives it one).
export fn xmlNewParserCtxt() -> usize { return xmlCreatePushParserCtxt(0, 0, 0, 0, 0) }

// A context is made by this library only (it holds the parser after
// libxml2's structure): one a program allocated itself is not one.
export fn xmlInitParserCtxt(ctxt: usize) -> i32 {
    if ctxt == 0 || !context.isContext(ctxt) {
        errors.raise(0, 0, 0, 0, errors.FROM_PARSER, 1, errors.LEVEL_FATAL, 0, 0, 0, 0, 0, 0, 0, m.dupText("Got NULL parser context\n"))
        return -1
    }
    return 0
}

// xmlParserGetDirectory: FILENAME's directory, from xmlMalloc.
pub fn directoryOf(filename: usize) -> usize {
    if filename == 0 { return 0 }
    var cut = text.length(filename)
    while cut > 0 && text.get8(filename + cut - 1) != 47 { cut -= 1 }
    if cut == 0 { return m.dupText(".") }
    if cut > 1 { cut -= 1 }
    return m.strndup(filename, cut)
}

export fn xmlParserGetDirectory(filename: usize) -> usize { return directoryOf(filename) }

// xmlCtxtReset: the context made again for a new document, the
// handler, its user and _private kept (and the document left to the
// program, as libxml2 frees it: here too).
export fn xmlCtxtReset(ctxt: usize) -> void {
    if ctxt == 0 || !context.hasParser(ctxt) { return }
    resetWith(ctxt, 0, 0)
}

fn resetWith(ctxt: usize, chunk: usize, count: usize) -> bool {
    const c = ctxtAt(ctxt)
    const t = context.trailerOf(ctxt)
    const parser = sax.createPush(m.allocator(), sax.emptyHandler(), chunk, count)
    if parser == 0 { return false }
    if !t.*.nested && t.*.parser != 0 { sax.free(t.*.parser) }
    t.*.parser = parser
    t.*.nested = false
    if c.*.myDoc != 0 {
        xmlFreeDoc(c.*.myDoc)
        c.*.myDoc = 0
    }
    m.xfree(c.*.directory)
    c.*.directory = 0
    errors.ctxtResetLastError(ctxt)
    c.*.wellFormed = 1
    c.*.nsWellFormed = 1
    c.*.valid = 1
    c.*.options = 0
    takeDefaults(ctxt)
    sax.parserAt(parser).*.handler = handlerFor(ctxt)
    context.show(ctxt)
    return true
}

export fn xmlCtxtResetPush(ctxt: usize, chunk: usize, size: i32, filename: usize, encodingName: usize) -> i32 {
    if ctxt == 0 || !context.hasParser(ctxt) { return 1 }
    const count = if size > 0 && chunk != 0 { @intCast(usize, size) } else { 0 }
    if !resetWith(ctxt, chunk, count) { return 1 }
    const p = context.parserOf(ctxt)
    if filename != 0 {
        sax.inputAt(p.*.input).*.filename = text.duplicateString(p.*.allocator, filename)
        ctxtAt(ctxt).*.directory = directoryOf(filename)
    }
    if encodingName != 0 {
        var h: encoding.Handler = undefined
        if encoding.handlerForName(encodingName, &h) {
            const ignored = sax.switchToHandler(p, h)
        } else {
            context.raise(ctxt, errors.FROM_PARSER, 32, errors.LEVEL_FATAL, encodingName, 0, context.message("Unsupported encoding %s\n", encodingName, 0))
        }
    }
    context.show(ctxt)
    return 0
}

export fn xmlClearParserCtxt(ctxt: usize) -> void { xmlCtxtReset(ctxt) }

// xmlCtxtUseOptions: the parser's options, and libxml2's changes of the
// handler they make.
export fn xmlCtxtUseOptions(ctxt: usize, optionsIn: i32) -> i32 {
    if ctxt == 0 || !context.hasParser(ctxt) { return -1 }
    const options = @intCast(u64, @bitCast(u32, optionsIn))
    const c = ctxtAt(ctxt)
    const s = handlerOf(ctxt)
    const p = context.parserOf(ctxt)
    const rest = sax.useOptions(p, options)
    c.*.loadsubset = 0
    if (options & sax.PARSE_DTDLOAD) != 0 { c.*.loadsubset = 2 }
    if (options & sax.PARSE_DTDATTR) != 0 { c.*.loadsubset = c.*.loadsubset | 4 }
    if (options & sax.PARSE_NOBLANKS) != 0 { s.*.ignorableWhitespace = @intFromPtr(xmlSAX2IgnorableWhitespace) }
    if (options & sax.PARSE_DTDVALID) != 0 {
        if (options & sax.PARSE_NOWARNING) != 0 { c.*.vctxt.warning = 0 }
        if (options & sax.PARSE_NOERROR) != 0 { c.*.vctxt.error_ = 0 }
    }
    if (options & sax.PARSE_NOWARNING) != 0 { s.*.warning = 0 }
    if (options & sax.PARSE_NOERROR) != 0 {
        s.*.error_ = 0
        s.*.fatalError = 0
    }
    if (options & sax.PARSE_SAX1) != 0 {
        s.*.startElement = @intFromPtr(xmlSAX2StartElement)
        s.*.endElement = @intFromPtr(xmlSAX2EndElement)
        s.*.startElementNs = 0
        s.*.endElementNs = 0
        s.*.initialized = 1
    }
    c.*.dictNames = if (options & sax.PARSE_NODICT) != 0 { 0 } else { 1 }
    if (options & sax.PARSE_NOCDATA) != 0 { s.*.cdataBlock = 0 }
    c.*.linenumbers = 1
    const user = p.*.handler.user
    p.*.handler = handlerFor(ctxt)
    p.*.handler.user = user
    context.show(ctxt)
    return @intCast(i32, rest & 0x7fffffff)
}

export fn xmlParseChunk(ctxt: usize, chunk: usize, size: i32, terminate: i32) -> i32 {
    if ctxt == 0 || !context.hasParser(ctxt) { return 1 }
    enter(ctxt)
    const count = if size > 0 && chunk != 0 { @intCast(usize, size) } else { 0 }
    const result = sax.parseChunk(context.parserOf(ctxt), chunk, count, terminate != 0)
    context.show(ctxt)
    return @intCast(i32, result)
}

export fn xmlParseContent(ctxt: usize) -> void {
    if ctxt == 0 || !context.hasParser(ctxt) { return }
    enter(ctxt)
    sax.parseContent(context.parserOf(ctxt))
    context.show(ctxt)
}

export fn xmlStopParser(ctxt: usize) -> void {
    if ctxt == 0 || !context.hasParser(ctxt) { return }
    sax.stop(context.parserOf(ctxt))
    context.show(ctxt)
}

export fn xmlByteConsumed(ctxt: usize) -> i64 {
    if ctxt == 0 || !context.hasParser(ctxt) { return -1 }
    return sax.byteConsumed(context.parserOf(ctxt))
}

export fn xmlCtxtResetLastError(ctx: usize) -> void {
    if ctx == 0 { return }
    if context.hasParser(ctx) { sax.resetErrNo(context.parserOf(ctx)) }
    errors.ctxtResetLastError(ctx)
}

export fn xmlSwitchEncoding(ctxt: usize, enc: i32) -> i32 {
    if ctxt == 0 || !context.hasParser(ctxt) { return -1 }
    const result = sax.switchEncoding(context.parserOf(ctxt), @intCast(i64, enc))
    context.show(ctxt)
    return @intCast(i32, result)
}

export fn xmlSwitchToEncoding(ctxt: usize, handler: usize) -> i32 {
    if ctxt == 0 || !context.hasParser(ctxt) { return -1 }
    if handler == 0 { return -1 }
    const result = sax.switchToHandler(context.parserOf(ctxt), charsets.stdHandler(handler))
    context.show(ctxt)
    return @intCast(i32, result)
}

// Only the context's current input is switched (the document's: the
// others are parameter entities' text, already UTF-8).
export fn xmlSwitchInputEncoding(ctxt: usize, input: usize, handler: usize) -> i32 {
    if input == 0 { return -1 }
    return xmlSwitchToEncoding(ctxt, handler)
}

export fn xmlCurrentChar(ctxt: usize, len: usize) -> i32 {
    if ctxt == 0 || len == 0 || !context.hasParser(ctxt) { return 0 }
    var length: usize = 0
    const c = sax.current(context.parserOf(ctxt), &length)
    text.putInt(len, @intCast(i64, length))
    context.show(ctxt)
    return @intCast(i32, c & 0x7fffffff)
}

export fn xmlStringCurrentChar(ctxt: usize, cur: usize, len: usize) -> i32 {
    if cur == 0 || len == 0 { return 0 }
    if ctxt == 0 || !context.hasParser(ctxt) {
        // (Without a parser: the UTF-8 character there.)
        var length: usize = 0
        const c = tree.utf8At(cur, &length)
        text.putInt(len, @intCast(i64, length))
        return @intCast(i32, c & 0x7fffffff)
    }
    var length: usize = 0
    const c = sax.stringCurrent(context.parserOf(ctxt), cur, &length)
    text.putInt(len, @intCast(i64, length))
    context.show(ctxt)
    return @intCast(i32, c & 0x7fffffff)
}

export fn xmlNextChar(ctxt: usize) -> void {
    if ctxt == 0 || !context.hasParser(ctxt) { return }
    sax.next(context.parserOf(ctxt))
    context.show(ctxt)
}

fn decode(ctxt: usize, str: usize, len: usize, what: i32) -> usize {
    if ctxt == 0 || str == 0 || !context.hasParser(ctxt) { return 0 }
    enter(ctxt)
    const p = context.parserOf(ctxt)
    const s = sax.decodeEntities(p, str, len, @intCast(u64, @bitCast(u32, what) & 3))
    context.show(ctxt)
    if s == 0 { return 0 }
    const result = m.dup(s)
    text.release(p.*.allocator, s)
    return result
}

export fn xmlStringDecodeEntities(ctxt: usize, str: usize, what: i32, end: u8, end2: u8, end3: u8) -> usize {
    if str == 0 { return 0 }
    return decode(ctxt, str, text.length(str), what)
}

export fn xmlStringLenDecodeEntities(ctxt: usize, str: usize, len: i32, what: i32, end: u8, end2: u8, end3: u8) -> usize {
    if str == 0 || len < 0 { return 0 }
    return decode(ctxt, str, @intCast(usize, len), what)
}

// The context's inputs are its parser's: xmlFreeInputStream frees only
// one a program made (none can be made here).
export fn xmlFreeInputStream(input: usize) -> void {}

export fn xmlParserInputRead(input: usize, len: i32) -> i32 { return -1 }

// The inputs hold all their bytes: there is never more to read.
export fn xmlParserInputGrow(input: usize, len: i32) -> i32 {
    if input == 0 || len < 0 { return -1 }
    return 0
}

// ---------------------------------------------------------------------------
// The library

export fn xmlInitParser() -> void {}
export fn xmlCleanupParser() -> void {}

export fn xmlSetExternalEntityLoader(f: usize) -> void { sax2.setLoader(f) }
export fn xmlGetExternalEntityLoader() -> usize { return sax2.currentLoader() }
export fn xmlLoadExternalEntity(url: usize, id: usize, ctxt: usize) -> usize { return sax2.loadExternalEntity(url, id, ctxt) }

// The features of the header's LIBXML_*_ENABLED.
export fn xmlHasFeature(feature: i32) -> i32 {
    if feature == 1 || feature == 2 || feature == 4 || feature == 8 || feature == 22 { return 1 }
    return 0
}
