// The parser's C context (xmlParserCtxt) over std.xml.sax's parser. The
// context is libxml2's structure, followed in the same block by what the
// library keeps of its own (the trailer): the std parser it is the
// context of, and the input structures it shows. The std parser is
// what parses and holds the parse's state; the context's fields are a
// copy of that state (`show`), made again whenever the program can look
// at them: before each callback and when a function of the API returns.
// The fields a program sets (the SAX handler, userData, the parse
// options' fields, xmlParseContent's instate and depth) are read back
// (`take`) when it calls the API again.
const text = @import("std.xml.text")
const sax = @import("std.xml.sax")
const m = @import("./memory.mlx")
const layout = @import("./layout.mlx")
const errors = @import("./errors.mlx")
const globals = @import("./globals.mlx")

// Exports of the library's other modules (called as C calls them).
extern("c") fn xmlParserValidityError(ctx: usize, msg: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void
extern("c") fn xmlParserValidityWarning(ctx: usize, msg: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void

pub const Ctxt = layout.Ctxt
pub const Input = layout.Input
pub const SAXHandler = layout.SAXHandler

const MAGIC: u64 = 0x32786d6c786c6d00

pub const Trailer = struct {
    magic: u64
    // The std parser (its address).
    parser: usize
    // The C inputs shown (INPUT_SIZE bytes each) and inputTab's room.
    inputs: usize
    inputCap: usize
    // A context of an entity's content (xmlParseBalancedChunkMemory-
    // Internal's): its handler, dictionary and document are its parent's.
    nested: bool
    // The document made for a nested context (0 for none).
    newDoc: usize
}

const INPUT_SIZE: usize = 120

pub inline fn ctxtAt(address: usize) -> *Ctxt { return unsafe { @ptrFromInt(*Ctxt, address) } }
pub inline fn inputAt(address: usize) -> *Input { return unsafe { @ptrFromInt(*Input, address) } }
pub inline fn saxAt(address: usize) -> *SAXHandler { return unsafe { @ptrFromInt(*SAXHandler, address) } }
pub inline fn trailerOf(ctxt: usize) -> *Trailer { return unsafe { @ptrFromInt(*Trailer, ctxt + @sizeOf(Ctxt)) } }

// Whether CTXT is a context of this library's making (not one a program
// allocated itself).
pub fn isContext(ctxt: usize) -> bool { return ctxt != 0 && trailerOf(ctxt).*.magic == MAGIC }

// The std parser of a context.
pub fn parserOf(ctxt: usize) -> *sax.Parser { return sax.parserAt(trailerOf(ctxt).*.parser) }

pub fn hasParser(ctxt: usize) -> bool { return isContext(ctxt) && trailerOf(ctxt).*.parser != 0 }

// A new context (zeroed, with libxml2's defaults of xmlInitParserCtxt
// that are not the parser's); 0 when there is no memory.
pub fn allocate() -> usize {
    const ctxt = m.zalloc(@sizeOf(Ctxt) + @sizeOf(Trailer))
    if ctxt == 0 { return 0 }
    const t = trailerOf(ctxt)
    t.*.magic = MAGIC
    const c = ctxtAt(ctxt)
    c.*.userData = ctxt
    c.*.standalone = -1
    c.*.wellFormed = 1
    c.*.nsWellFormed = 1
    c.*.valid = 1
    c.*.sax2 = 1
    c.*.dictNames = 1
    c.*.input_id = 1
    c.*.charset = 1
    c.*.loadsubset = globals.loadExtDtdDefault
    c.*.validate = globals.doValidityCheckingDefault
    c.*.pedantic = globals.pedanticParserDefault
    c.*.linenumbers = globals.lineNumbersDefault
    c.*.keepBlanks = globals.keepBlanksDefault
    c.*.replaceEntities = globals.substituteEntitiesDefault
    c.*.vctxt.userData = ctxt
    c.*.vctxt.error_ = @intFromPtr(xmlParserValidityError)
    c.*.vctxt.warning = @intFromPtr(xmlParserValidityWarning)
    var options: i32 = 0
    if c.*.loadsubset != 0 { options = options | 4 }
    if c.*.pedantic != 0 { options = options | 128 }
    if c.*.keepBlanks == 0 { options = options | 256 }
    if c.*.validate != 0 { options = options | 16 }
    if c.*.replaceEntities != 0 { options = options | 2 }
    c.*.options = options
    return ctxt
}

// The parser's state shown in the context's fields.
pub fn show(ctxt: usize) -> void {
    if !hasParser(ctxt) { return }
    const c = ctxtAt(ctxt)
    const p = parserOf(ctxt)
    const t = trailerOf(ctxt)
    c.*.wellFormed = if p.*.wellFormed { 1 } else { 0 }
    c.*.nsWellFormed = if p.*.nsWellFormed { 1 } else { 0 }
    c.*.valid = if p.*.valid { 1 } else { 0 }
    c.*.replaceEntities = if p.*.replaceEntities { 1 } else { 0 }
    c.*.recovery = if p.*.recovery { 1 } else { 0 }
    c.*.pedantic = if p.*.pedantic { 1 } else { 0 }
    c.*.keepBlanks = if p.*.keepBlanks { 1 } else { 0 }
    c.*.validate = if p.*.validate { 1 } else { 0 }
    c.*.version = p.*.version
    c.*.encoding = p.*.encodingName
    c.*.standalone = @intCast(i32, p.*.standalone)
    c.*.errNo = @intCast(i32, p.*.errNo)
    c.*.hasExternalSubset = if p.*.hasExternalSubset { 1 } else { 0 }
    c.*.hasPErefs = if p.*.hasPErefs { 1 } else { 0 }
    c.*.instate = @intCast(i32, p.*.instate)
    c.*.disableSAX = @intCast(i32, p.*.disableSAX)
    c.*.inSubset = @intCast(i32, p.*.inSubset)
    c.*.intSubName = p.*.intSubName
    c.*.extSubURI = p.*.extSubURI
    c.*.extSubSystem = p.*.extSubSystem
    c.*.depth = @intCast(i32, p.*.depth)
    c.*.charset = @intCast(i32, p.*.charset)
    c.*.progressive = @intCast(i32, p.*.progressive)
    c.*.checkIndex = p.*.checkIndex
    c.*.options = @intCast(i32, p.*.options & 0x7fffffff)
    c.*.dict = p.*.dict
    c.*.str_xml = p.*.strXml
    c.*.str_xmlns = p.*.strXmlns
    c.*.str_xml_ns = p.*.strXmlNs
    c.*.nameNr = @intCast(i32, p.*.nameNr)
    c.*.name = p.*.name
    c.*.nsNr = @intCast(i32, p.*.nsNr)
    c.*.nbentities = p.*.nbentities
    c.*.sizeentities = p.*.sizeentities
    c.*.sizeentcopy = p.*.sizeentcopy
    c.*.input_id = @intCast(i32, p.*.inputId)
    c.*.html = 0
    c.*.sax2 = 1
    showInputs(ctxt, p, t)
}

fn showInputs(ctxt: usize, p: *sax.Parser, t: *Trailer) -> void {
    const c = ctxtAt(ctxt)
    const count = @intCast(usize, p.*.inputNr)
    if count > t.*.inputCap {
        var cap = if t.*.inputCap == 0 { 5 } else { t.*.inputCap * 2 }
        while cap < count { cap = cap * 2 }
        const inputs = m.realloc(t.*.inputs, cap * INPUT_SIZE)
        const tab = m.realloc(c.*.inputTab, cap * 8)
        if inputs != 0 { t.*.inputs = inputs }
        if tab != 0 { c.*.inputTab = tab }
        if inputs == 0 || tab == 0 { return }
        t.*.inputCap = cap
        c.*.inputMax = @intCast(i32, cap)
    }
    var index: usize = 0
    while index < count {
        const from = sax.inputAt(text.getWord(p.*.inputs + index * 8))
        const at = t.*.inputs + index * INPUT_SIZE
        const i = inputAt(at)
        i.*.buf = 0
        i.*.filename = from.*.filename
        i.*.directory = 0
        i.*.base = from.*.base
        i.*.cur = from.*.cur
        i.*.end = from.*.end
        i.*.length = @intCast(i32, from.*.length & 0x7fffffff)
        i.*.line = @intCast(i32, from.*.line & 0x7fffffff)
        i.*.col = @intCast(i32, from.*.col & 0x7fffffff)
        i.*.consumed = from.*.consumed
        i.*.free = 0
        i.*.encoding = from.*.encoding
        i.*.version = from.*.version
        i.*.standalone = @intCast(i32, from.*.standalone)
        i.*.id = @intCast(i32, from.*.id)
        i.*.parentConsumed = from.*.parentConsumed
        i.*.entity = 0
        text.putWord(c.*.inputTab + index * 8, at)
        index += 1
    }
    c.*.inputNr = @intCast(i32, count)
    c.*.input = if count == 0 { 0 } else { t.*.inputs + (count - 1) * INPUT_SIZE }
}

// The fields a program may have set, taken by the parser (at the start
// of xmlParseChunk and xmlParseContent).
pub fn take(ctxt: usize) -> void {
    if !hasParser(ctxt) { return }
    const c = ctxtAt(ctxt)
    const p = parserOf(ctxt)
    p.*.replaceEntities = c.*.replaceEntities != 0
    p.*.recovery = c.*.recovery != 0
    p.*.pedantic = c.*.pedantic != 0
    p.*.keepBlanks = c.*.keepBlanks != 0
    p.*.validate = c.*.validate != 0
    p.*.instate = @intCast(i64, c.*.instate)
    p.*.depth = @intCast(i64, c.*.depth)
}

// ---------------------------------------------------------------------------
// Errors raised by the library's C side for a context (SAX2.c's)

// __xmlRaiseError for the context CTXT: MESSAGE (from xmlMalloc) at its
// input's position.
pub fn raise(ctxt: usize, domain: i32, code: i32, level: i32, str1: usize, str2: usize, message: usize) -> void {
    show(ctxt)
    var file: usize = 0
    var line: i32 = 0
    var col: i32 = 0
    if ctxt != 0 {
        const c = ctxtAt(ctxt)
        var input = c.*.input
        if input != 0 && inputAt(input).*.filename == 0 && c.*.inputNr > 1 {
            input = text.getWord(c.*.inputTab + @intCast(usize, c.*.inputNr - 2) * 8)
        }
        if input != 0 {
            file = inputAt(input).*.filename
            line = inputAt(input).*.line
            col = inputAt(input).*.col
        }
    }
    errors.raise(0, 0, 0, ctxt, domain, code, level, file, line, str1, str2, 0, 0, col, message)
}

// A message of FMT with the C strings A and B.
pub fn message(fmt: []const u8, a: usize, b: usize) -> usize {
    var buffer: text.Buffer = undefined
    if !text.bufferInit(&buffer, m.allocator(), 128) { return 0 }
    text.format(&buffer, fmt, a, b, 0)
    const result = m.strndup(buffer.address, buffer.length)
    text.bufferFree(&buffer)
    return result
}

// Whether the context takes no more errors (stopped, its SAX disabled).
pub fn stopped(ctxt: usize) -> bool {
    if hasParser(ctxt) { return sax.isStopped(parserOf(ctxt)) }
    if ctxt == 0 { return false }
    return ctxtAt(ctxt).*.disableSAX != 0 && ctxtAt(ctxt).*.instate == -1
}

// SAX2's xmlFatalErrMsg.
pub fn fatalErrMsg(ctxt: usize, code: i32, fmt: []const u8, str1: usize, str2: usize) -> void {
    if stopped(ctxt) { return }
    if hasParser(ctxt) { parserOf(ctxt).*.errNo = @intCast(i64, code) }
    raise(ctxt, errors.FROM_PARSER, code, errors.LEVEL_FATAL, str1, str2, message(fmt, str1, str2))
    if hasParser(ctxt) { sax.noteFatal(parserOf(ctxt), @intCast(i64, code)) }
    if ctxt != 0 && !hasParser(ctxt) {
        const c = ctxtAt(ctxt)
        c.*.errNo = code
        c.*.wellFormed = 0
        c.*.valid = 0
        if c.*.recovery == 0 { c.*.disableSAX = 1 }
    }
    show(ctxt)
}

// SAX2's xmlWarnMsg.
pub fn warnMsg(ctxt: usize, code: i32, fmt: []const u8, str1: usize) -> void {
    if stopped(ctxt) { return }
    if hasParser(ctxt) { parserOf(ctxt).*.errNo = @intCast(i64, code) }
    if ctxt != 0 { ctxtAt(ctxt).*.errNo = code }
    raise(ctxt, errors.FROM_PARSER, code, errors.LEVEL_WARNING, str1, 0, message(fmt, str1, 0))
}

// xmlErrMemory and SAX2's xmlSAX2ErrMemory.
pub fn errMemory(ctxt: usize, extra: []const u8) -> void {
    if ctxt != 0 && hasParser(ctxt) {
        const p = parserOf(ctxt)
        p.*.errNo = 2
        p.*.instate = -1
        p.*.disableSAX = 1
    }
    raise(ctxt, errors.FROM_PARSER, 2, errors.LEVEL_FATAL, 0, 0, message("Memory allocation failed : %s\n", @intFromPtr(extra.pointer), 0))
}
