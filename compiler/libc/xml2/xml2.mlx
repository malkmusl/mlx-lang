// libmlxxml2.so: libxml2's C API (2.9.14, as Ubuntu 24.04 has it) for C
// and C++ programs, in Mlx: the SAX2 push parser and the parser of
// content in memory WebKit's XML document parser drives
// (XMLDocumentParserLibxml2.cpp), over std.xml.sax. The API is declared
// by the modules of api/, whose C headers (<libxml/parser.h> and the
// others WebKit includes) mlx-cheaders makes.
//
//     ./mlx build xml2
//
// The parts: memory.mlx (xmlmemory.h, xmlstring.h: xmlMalloc and xmlFree,
// the strings), globals.mlx (globals.h's defaults), errors.mlx
// (xmlerror.h and __xmlRaiseError's routing of errors), tree.mlx
// (tree.h, entities.h: documents, their DTDs and entities, names),
// encoding.mlx (encoding.h), misc.mlx (dict.h, xmlIO.h, the character
// classes, xmlCheckVersion), context.mlx (the parser context over
// std.xml.sax's parser), sax2.mlx (SAX2.h), parser.mlx (parser.h,
// parserInternals.h: the parsers and the callbacks of the std parser),
// varargs.mlx (C's variable arguments). layout.mlx is the API's
// structures as the library reads them.
//
// Not here: libxml2's tree (the SAX2 callbacks that build it build
// nothing; xmlReadMemory and its kin are not declared), XPath, XSLT's
// needs, HTML, validation, the reader and writer, the loading of external
// entities and DTDs (none is ever loaded: as when libxml2 cannot load
// them), SAX1's callbacks.
const memory = @import("./memory.mlx")
const globals = @import("./globals.mlx")
const errors = @import("./errors.mlx")
const tree = @import("./tree.mlx")
const encoding = @import("./encoding.mlx")
const misc = @import("./misc.mlx")
const context = @import("./context.mlx")
const sax2 = @import("./sax2.mlx")
const parser = @import("./parser.mlx")
const layout = @import("./layout.mlx")

// The sizes and some offsets of the API's structures as the library
// lays them out, for tools/check_xml2.sh to compare with the header's:
// xmlParserCtxt, xmlSAXHandler, xmlDoc, xmlDtd, xmlEntity,
// xmlParserInput, xmlError, xmlValidCtxt, and the offsets of the
// context's lastError, input, _private, myDoc, sax2 and of the entity's
// expandedSize.
export fn __mlx_xml2_layout(index: i32) -> i64 {
    if index == 0 { return @intCast(i64, @sizeOf(layout.Ctxt)) }
    if index == 1 { return @intCast(i64, @sizeOf(layout.SAXHandler)) }
    if index == 2 { return @intCast(i64, @sizeOf(layout.Doc)) }
    if index == 3 { return @intCast(i64, @sizeOf(layout.Dtd)) }
    if index == 4 { return @intCast(i64, @sizeOf(layout.Entity)) }
    if index == 5 { return @intCast(i64, @sizeOf(layout.Input)) }
    if index == 6 { return @intCast(i64, @sizeOf(layout.Error)) }
    if index == 7 { return @intCast(i64, @sizeOf(layout.ValidCtxt)) }
    if index == 8 { return @intCast(i64, @offsetOf(layout.Ctxt, "lastError")) }
    if index == 9 { return @intCast(i64, @offsetOf(layout.Ctxt, "input")) }
    if index == 10 { return @intCast(i64, @offsetOf(layout.Ctxt, "_private")) }
    if index == 11 { return @intCast(i64, @offsetOf(layout.Ctxt, "myDoc")) }
    if index == 12 { return @intCast(i64, @offsetOf(layout.Ctxt, "sax2")) }
    if index == 13 { return @intCast(i64, @offsetOf(layout.Entity, "expandedSize")) }
    if index == 14 { return @intCast(i64, @offsetOf(layout.Input, "col")) }
    if index == 15 { return @intCast(i64, @offsetOf(layout.SAXHandler, "serror")) }
    if index == 16 { return @intCast(i64, @offsetOf(layout.Ctxt, "sizeentcopy")) }
    return -1
}
