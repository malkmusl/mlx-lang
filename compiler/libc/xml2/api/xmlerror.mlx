// libxml/xmlerror.h
// libxml2's errors: where they go (the generic handler, which prints
// them on stderr unless xmlSetGenericErrorFunc sets another, and the
// structured one of xmlSetStructuredErrorFunc), the last one of the
// library and of a parser, the handlers SAX parsers have by default
// (xmlParserError... print the error with its place in the input). Their
// types, xmlError and the codes, are tree.h's.
const v = @import("./xmlversion.mlx")
const t = @import("./tree.mlx")

pub extern("c") fn xmlSetGenericErrorFunc(ctx: ?*anyopaque, handler: ?t.xmlGenericErrorFunc) -> void
pub extern("c") fn initGenericErrorDefaultFunc(handler: ?*?t.xmlGenericErrorFunc) -> void
pub extern("c") fn xmlSetStructuredErrorFunc(ctx: ?*anyopaque, handler: ?t.xmlStructuredErrorFunc) -> void
pub extern("c") fn xmlParserError(ctx: ?*anyopaque, msg: ?[*]const v.c_char, args: v.c_varargs) -> void
pub extern("c") fn xmlParserWarning(ctx: ?*anyopaque, msg: ?[*]const v.c_char, args: v.c_varargs) -> void
pub extern("c") fn xmlParserValidityError(ctx: ?*anyopaque, msg: ?[*]const v.c_char, args: v.c_varargs) -> void
pub extern("c") fn xmlParserValidityWarning(ctx: ?*anyopaque, msg: ?[*]const v.c_char, args: v.c_varargs) -> void
pub extern("c") fn xmlParserPrintFileInfo(input: ?*t.xmlParserInput) -> void
pub extern("c") fn xmlParserPrintFileContext(input: ?*t.xmlParserInput) -> void
pub extern("c") fn xmlGetLastError() -> ?*t.xmlError
pub extern("c") fn xmlResetLastError() -> void
pub extern("c") fn xmlCtxtGetLastError(ctx: ?*anyopaque) -> ?*t.xmlError
pub extern("c") fn xmlCtxtResetLastError(ctx: ?*anyopaque) -> void
pub extern("c") fn xmlResetError(err: ?*t.xmlError) -> void
pub extern("c") fn xmlCopyError(from: ?*t.xmlError, to: ?*t.xmlError) -> v.c_int
