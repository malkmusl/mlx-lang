// libxml/xmlversion.h
// mlx-xml2: libxml2's C API (2.9.14, LIBXML_VERSION 20914), implemented
// in Mlx by libmlxxml2.so (compiler/libc/xml2, over std.xml.sax): the
// SAX2 push parser and the parser of a document's content in memory,
// with libxml2's callbacks, errors, encodings, entities and namespaces,
// and the parts of libxml2's tree, dictionary, strings, memory and
// error handling that its SAX2 users (WebKit's XMLDocumentParser) take.
//
// Not here: building trees (the SAX2 tree builders are there but build
// none), XPath, XSLT's needs, validation, HTML, catalogs, writing.
const c_macros = "#define XMLPUBFUN\n#define XMLPUBVAR extern\n#define XMLCALL\n#define XMLCDECL\n#define LIBXML_DLL_IMPORT\n#define LIBXML_ATTR_FORMAT(fmt,args)\n#define LIBXML_ATTR_ALLOC_SIZE(x)\n#define ATTRIBUTE_UNUSED\n#define XML_DEPRECATED\n#define LIBXML_TEST_VERSION xmlCheckVersion(20914);\n#define LIBXML_DOTTED_VERSION \"2.9.14\"\n#define LIBXML_VERSION_STRING \"20914\"\n#define LIBXML_VERSION_EXTRA \"\""

// (Mlx names of C types: C has them as they are.)
pub const c_char = u8
pub const c_int = i32
pub const c_uint = u32
pub const c_long = i64
pub const c_ulong = u64
pub const c_ushort = u16
pub const c_uchar = u8
pub const c_varargs = usize
pub const c_va_list = usize

pub const LIBXML_VERSION: c_int = 20914

// What this libxml2 has (of what libxml2's own build may leave out).
pub const LIBXML_THREAD_ENABLED: c_int = 1
pub const LIBXML_TREE_ENABLED: c_int = 1
pub const LIBXML_PUSH_ENABLED: c_int = 1
pub const LIBXML_SAX1_ENABLED: c_int = 1
pub const LIBXML_REGEXP_ENABLED: c_int = 1

// xmlCheckVersion: that the library is of the version the program was
// made for (it says so on stderr when not).
pub extern("c") fn xmlCheckVersion(version: c_int) -> void
