// libxml/encoding.h
// libxml2's character encodings: those its first bytes show, those of
// names (UTF-8, UTF-16, ISO-8859-1, ASCII, and, as iconv's in libxml2,
// UCS-4 and the single-byte charsets of std.unicode.charmaps), their
// handlers (the structure is tree.h's xmlCharEncodingHandler).
const v = @import("./xmlversion.mlx")
const s = @import("./xmlstring.mlx")
const t = @import("./tree.mlx")

pub extern("c") fn xmlInitCharEncodingHandlers() -> void
pub extern("c") fn xmlCleanupCharEncodingHandlers() -> void
pub extern("c") fn xmlRegisterCharEncodingHandler(handler: ?*t.xmlCharEncodingHandler) -> void
pub extern("c") fn xmlGetCharEncodingHandler(enc: t.xmlCharEncoding) -> ?*t.xmlCharEncodingHandler
pub extern("c") fn xmlFindCharEncodingHandler(name: ?[*]const v.c_char) -> ?*t.xmlCharEncodingHandler
pub extern("c") fn xmlNewCharEncodingHandler(name: ?[*]const v.c_char, input: ?t.xmlCharEncodingInputFunc, output: ?t.xmlCharEncodingOutputFunc) -> ?*t.xmlCharEncodingHandler
pub extern("c") fn xmlCharEncCloseFunc(handler: ?*t.xmlCharEncodingHandler) -> v.c_int
pub extern("c") fn xmlAddEncodingAlias(name: ?[*]const v.c_char, alias: ?[*]const v.c_char) -> v.c_int
pub extern("c") fn xmlDelEncodingAlias(alias: ?[*]const v.c_char) -> v.c_int
pub extern("c") fn xmlGetEncodingAlias(alias: ?[*]const v.c_char) -> ?[*]const v.c_char
pub extern("c") fn xmlCleanupEncodingAliases() -> void
pub extern("c") fn xmlParseCharEncoding(name: ?[*]const v.c_char) -> t.xmlCharEncoding
pub extern("c") fn xmlGetCharEncodingName(enc: t.xmlCharEncoding) -> ?[*]const v.c_char
pub extern("c") fn xmlDetectCharEncoding(in_: ?[*]const v.c_uchar, len: v.c_int) -> t.xmlCharEncoding
pub extern("c") fn isolat1ToUTF8(out: ?[*]v.c_uchar, outlen: ?*v.c_int, in_: ?[*]const v.c_uchar, inlen: ?*v.c_int) -> v.c_int
pub extern("c") fn UTF8Toisolat1(out: ?[*]v.c_uchar, outlen: ?*v.c_int, in_: ?[*]const v.c_uchar, inlen: ?*v.c_int) -> v.c_int
