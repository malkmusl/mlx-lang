// libxml/xmlIO.h
// libxml2's I/O: the input and output callbacks a program registers
// (kept, and asked for the external entities a parser loads; this
// library loads none), the parser's input buffers (the structure is
// tree.h's xmlParserInputBuffer).
const v = @import("./xmlversion.mlx")
const t = @import("./tree.mlx")
const e = @import("./encoding.mlx")

pub extern("c") fn xmlCleanupInputCallbacks() -> void
pub extern("c") fn xmlPopInputCallbacks() -> v.c_int
pub extern("c") fn xmlRegisterDefaultInputCallbacks() -> void
pub extern("c") fn xmlRegisterInputCallbacks(matchFunc: ?t.xmlInputMatchCallback, openFunc: ?t.xmlInputOpenCallback, readFunc: ?t.xmlInputReadCallback, closeFunc: ?t.xmlInputCloseCallback) -> v.c_int
pub extern("c") fn xmlCleanupOutputCallbacks() -> void
pub extern("c") fn xmlPopOutputCallbacks() -> v.c_int
pub extern("c") fn xmlRegisterDefaultOutputCallbacks() -> void
pub extern("c") fn xmlRegisterOutputCallbacks(matchFunc: ?t.xmlOutputMatchCallback, openFunc: ?t.xmlOutputOpenCallback, writeFunc: ?t.xmlOutputWriteCallback, closeFunc: ?t.xmlOutputCloseCallback) -> v.c_int
pub extern("c") fn xmlAllocParserInputBuffer(enc: t.xmlCharEncoding) -> ?*t.xmlParserInputBuffer
pub extern("c") fn xmlFreeParserInputBuffer(in_: ?*t.xmlParserInputBuffer) -> void
pub extern("c") fn xmlParserGetDirectory(filename: ?[*]const v.c_char) -> ?[*]v.c_char
pub extern("c") fn xmlCheckFilename(path: ?[*]const v.c_char) -> v.c_int
pub extern("c") fn xmlNoNetExternalEntityLoader(URL: ?[*]const v.c_char, ID: ?[*]const v.c_char, ctxt: ?*t.xmlParserCtxt) -> ?*t.xmlParserInput
