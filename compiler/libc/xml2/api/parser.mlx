// libxml/parser.h
// libxml2's parser: the push parser (xmlCreatePushParserCtxt, then
// xmlParseChunk with the document's bytes as they come and once more to
// end it), the parser's options and contexts, the loader of external
// entities. The SAX2 callbacks a context calls are the handler's it was
// made with (tree.h's xmlSAXHandler and its callbacks' types); a parser
// made without one has SAX2's defaults (SAX2.h), which build no tree
// here. The context's structure is tree.h's xmlParserCtxt.
const v = @import("./xmlversion.mlx")
const s = @import("./xmlstring.mlx")
const t = @import("./tree.mlx")
const d = @import("./dict.mlx")
const h = @import("./hash.mlx")
const va = @import("./valid.mlx")
const e = @import("./entities.mlx")
const er = @import("./xmlerror.mlx")
const enc = @import("./encoding.mlx")
const io = @import("./xmlIO.mlx")
const g = @import("./globals.mlx")
const mem = @import("./xmlmemory.mlx")

pub extern("c") fn xmlInitParser() -> void
pub extern("c") fn xmlCleanupParser() -> void
pub extern("c") fn xmlParserInputRead(in_: ?*t.xmlParserInput, len: v.c_int) -> v.c_int
pub extern("c") fn xmlParserInputGrow(in_: ?*t.xmlParserInput, len: v.c_int) -> v.c_int
pub extern("c") fn xmlSubstituteEntitiesDefault(val: v.c_int) -> v.c_int
pub extern("c") fn xmlKeepBlanksDefault(val: v.c_int) -> v.c_int
pub extern("c") fn xmlStopParser(ctxt: ?*t.xmlParserCtxt) -> void
pub extern("c") fn xmlPedanticParserDefault(val: v.c_int) -> v.c_int
pub extern("c") fn xmlLineNumbersDefault(val: v.c_int) -> v.c_int
pub extern("c") fn xmlNewParserCtxt() -> ?*t.xmlParserCtxt
pub extern("c") fn xmlInitParserCtxt(ctxt: ?*t.xmlParserCtxt) -> v.c_int
pub extern("c") fn xmlClearParserCtxt(ctxt: ?*t.xmlParserCtxt) -> void
pub extern("c") fn xmlFreeParserCtxt(ctxt: ?*t.xmlParserCtxt) -> void
pub extern("c") fn xmlCreateDocParserCtxt(cur: ?[*]const s.xmlChar) -> ?*t.xmlParserCtxt
pub extern("c") fn xmlCreatePushParserCtxt(sax: ?*t.xmlSAXHandler, user_data: ?*anyopaque, chunk: ?[*]const v.c_char, size: v.c_int, filename: ?[*]const v.c_char) -> ?*t.xmlParserCtxt
pub extern("c") fn xmlParseChunk(ctxt: ?*t.xmlParserCtxt, chunk: ?[*]const v.c_char, size: v.c_int, terminate: v.c_int) -> v.c_int
pub extern("c") fn xmlCtxtReset(ctxt: ?*t.xmlParserCtxt) -> void
pub extern("c") fn xmlCtxtResetPush(ctxt: ?*t.xmlParserCtxt, chunk: ?[*]const v.c_char, size: v.c_int, filename: ?[*]const v.c_char, encoding: ?[*]const v.c_char) -> v.c_int
pub extern("c") fn xmlCtxtUseOptions(ctxt: ?*t.xmlParserCtxt, options: v.c_int) -> v.c_int
pub extern("c") fn xmlSetExternalEntityLoader(f: ?t.xmlExternalEntityLoader) -> void
pub extern("c") fn xmlGetExternalEntityLoader() -> ?t.xmlExternalEntityLoader
pub extern("c") fn xmlLoadExternalEntity(URL: ?[*]const v.c_char, ID: ?[*]const v.c_char, ctxt: ?*t.xmlParserCtxt) -> ?*t.xmlParserInput
pub extern("c") fn xmlByteConsumed(ctxt: ?*t.xmlParserCtxt) -> v.c_long
pub extern("c") fn xmlHasFeature(feature: t.xmlFeature) -> v.c_int
