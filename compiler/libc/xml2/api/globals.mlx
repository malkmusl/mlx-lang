// libxml/globals.h
// libxml2's global variables, as its threaded builds have them: macros
// of the functions that give each one's address (`xmlFree(p)` calls the
// free function there; `xmlGenericError = f` sets the generic error
// handler). The memory functions are C's until xmlMemSetup; the generic
// error handler prints on stderr.
const v = @import("./xmlversion.mlx")
const t = @import("./tree.mlx")
const m = @import("./xmlmemory.mlx")
// (libxml2's globals.h has SAX2.h's callbacks with it, as its parser.h
// has globals.h.)
const sax2 = @import("./SAX2.mlx")
const c_macros = "#define xmlMalloc (*(__xmlMalloc()))\n#define xmlMallocAtomic (*(__xmlMallocAtomic()))\n#define xmlRealloc (*(__xmlRealloc()))\n#define xmlFree (*(__xmlFree()))\n#define xmlMemStrdup (*(__xmlMemStrdup()))\n#define xmlGenericError (*(__xmlGenericError()))\n#define xmlGenericErrorContext (*(__xmlGenericErrorContext()))\n#define xmlStructuredError (*(__xmlStructuredError()))\n#define xmlStructuredErrorContext (*(__xmlStructuredErrorContext()))\n#define xmlLastError (*(__xmlLastError()))\n#define xmlParserVersion (*(__xmlParserVersion()))\n#define xmlKeepBlanksDefaultValue (*(__xmlKeepBlanksDefaultValue()))\n#define xmlSubstituteEntitiesDefaultValue (*(__xmlSubstituteEntitiesDefaultValue()))\n#define xmlLineNumbersDefaultValue (*(__xmlLineNumbersDefaultValue()))\n#define xmlGetWarningsDefaultValue (*(__xmlGetWarningsDefaultValue()))\n#define xmlPedanticParserDefaultValue (*(__xmlPedanticParserDefaultValue()))\n#define xmlLoadExtDtdDefaultValue (*(__xmlLoadExtDtdDefaultValue()))\n#define xmlDoValidityCheckingDefaultValue (*(__xmlDoValidityCheckingDefaultValue()))"

pub extern("c") fn xmlInitGlobals() -> void
pub extern("c") fn xmlCleanupGlobals() -> void
pub extern("c") fn __xmlMalloc() -> ?*m.xmlMallocFunc
pub extern("c") fn __xmlMallocAtomic() -> ?*m.xmlMallocFunc
pub extern("c") fn __xmlRealloc() -> ?*m.xmlReallocFunc
pub extern("c") fn __xmlFree() -> ?*m.xmlFreeFunc
pub extern("c") fn __xmlMemStrdup() -> ?*m.xmlStrdupFunc
pub extern("c") fn __xmlGenericError() -> ?*t.xmlGenericErrorFunc
pub extern("c") fn __xmlGenericErrorContext() -> ?*?*anyopaque
pub extern("c") fn __xmlStructuredError() -> ?*t.xmlStructuredErrorFunc
pub extern("c") fn __xmlStructuredErrorContext() -> ?*?*anyopaque
pub extern("c") fn __xmlLastError() -> ?*t.xmlError
pub extern("c") fn __xmlParserVersion() -> ?*?[*]const v.c_char
pub extern("c") fn __xmlKeepBlanksDefaultValue() -> ?*v.c_int
pub extern("c") fn __xmlSubstituteEntitiesDefaultValue() -> ?*v.c_int
pub extern("c") fn __xmlLineNumbersDefaultValue() -> ?*v.c_int
pub extern("c") fn __xmlGetWarningsDefaultValue() -> ?*v.c_int
pub extern("c") fn __xmlPedanticParserDefaultValue() -> ?*v.c_int
pub extern("c") fn __xmlLoadExtDtdDefaultValue() -> ?*v.c_int
pub extern("c") fn __xmlDoValidityCheckingDefaultValue() -> ?*v.c_int

// The generic error handler's default: the message on stderr.
pub extern("c") fn xmlGenericErrorDefaultFunc(ctx: ?*anyopaque, msg: ?[*]const v.c_char, args: v.c_varargs) -> void
