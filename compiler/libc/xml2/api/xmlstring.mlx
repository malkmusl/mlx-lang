// libxml/xmlstring.h
// libxml2's strings: xmlChar, UTF-8 bytes; copies made with xmlMalloc
// (and freed with xmlFree), comparisons, UTF-8 lengths and positions.
const v = @import("./xmlversion.mlx")
const c_macros = "#define BAD_CAST (xmlChar *)"

pub const xmlChar = u8

pub extern("c") fn xmlStrdup(cur: ?[*]const xmlChar) -> ?[*]xmlChar
pub extern("c") fn xmlStrndup(cur: ?[*]const xmlChar, len: v.c_int) -> ?[*]xmlChar
pub extern("c") fn xmlCharStrndup(cur: ?[*]const v.c_char, len: v.c_int) -> ?[*]xmlChar
pub extern("c") fn xmlCharStrdup(cur: ?[*]const v.c_char) -> ?[*]xmlChar
pub extern("c") fn xmlStrsub(str: ?[*]const xmlChar, start: v.c_int, len: v.c_int) -> ?[*]xmlChar
pub extern("c") fn xmlStrchr(str: ?[*]const xmlChar, val: xmlChar) -> ?[*]const xmlChar
pub extern("c") fn xmlStrstr(str: ?[*]const xmlChar, val: ?[*]const xmlChar) -> ?[*]const xmlChar
pub extern("c") fn xmlStrcasestr(str: ?[*]const xmlChar, val: ?[*]const xmlChar) -> ?[*]const xmlChar
pub extern("c") fn xmlStrcmp(str1: ?[*]const xmlChar, str2: ?[*]const xmlChar) -> v.c_int
pub extern("c") fn xmlStrncmp(str1: ?[*]const xmlChar, str2: ?[*]const xmlChar, len: v.c_int) -> v.c_int
pub extern("c") fn xmlStrcasecmp(str1: ?[*]const xmlChar, str2: ?[*]const xmlChar) -> v.c_int
pub extern("c") fn xmlStrncasecmp(str1: ?[*]const xmlChar, str2: ?[*]const xmlChar, len: v.c_int) -> v.c_int
pub extern("c") fn xmlStrEqual(str1: ?[*]const xmlChar, str2: ?[*]const xmlChar) -> v.c_int
pub extern("c") fn xmlStrQEqual(pref: ?[*]const xmlChar, name: ?[*]const xmlChar, str: ?[*]const xmlChar) -> v.c_int
pub extern("c") fn xmlStrlen(str: ?[*]const xmlChar) -> v.c_int
pub extern("c") fn xmlStrcat(cur: ?[*]xmlChar, add: ?[*]const xmlChar) -> ?[*]xmlChar
pub extern("c") fn xmlStrncat(cur: ?[*]xmlChar, add: ?[*]const xmlChar, len: v.c_int) -> ?[*]xmlChar
pub extern("c") fn xmlStrncatNew(str1: ?[*]const xmlChar, str2: ?[*]const xmlChar, len: v.c_int) -> ?[*]xmlChar
pub extern("c") fn xmlGetUTF8Char(utf: ?[*]const u8, len: ?*v.c_int) -> v.c_int
pub extern("c") fn xmlCheckUTF8(utf: ?[*]const u8) -> v.c_int
pub extern("c") fn xmlUTF8Strsize(utf: ?[*]const xmlChar, len: v.c_int) -> v.c_int
pub extern("c") fn xmlUTF8Strndup(utf: ?[*]const xmlChar, len: v.c_int) -> ?[*]xmlChar
pub extern("c") fn xmlUTF8Strpos(utf: ?[*]const xmlChar, pos: v.c_int) -> ?[*]const xmlChar
pub extern("c") fn xmlUTF8Strloc(utf: ?[*]const xmlChar, utfchar: ?[*]const xmlChar) -> v.c_int
pub extern("c") fn xmlUTF8Strsub(utf: ?[*]const xmlChar, start: v.c_int, len: v.c_int) -> ?[*]xmlChar
pub extern("c") fn xmlUTF8Strlen(utf: ?[*]const xmlChar) -> v.c_int
pub extern("c") fn xmlUTF8Size(utf: ?[*]const xmlChar) -> v.c_int
pub extern("c") fn xmlUTF8Charcmp(utf1: ?[*]const xmlChar, utf2: ?[*]const xmlChar) -> v.c_int
