// libxml/parserInternals.h
// What libxml2 gives parsers of its own and its subtler users: a parser
// of a document's content in memory (xmlCreateMemoryParserCtxt, then
// xmlParseContent: an XML fragment's elements, text and references, as
// WebKit parses a fragment), the switch of a parser's encoding, its
// input's characters, the character classes of XML.
const v = @import("./xmlversion.mlx")
const s = @import("./xmlstring.mlx")
const t = @import("./tree.mlx")
const p = @import("./parser.mlx")
const c_macros = "#define IS_BYTE_CHAR(c) (((c) >= 0x20) || ((c) == 0x09) || ((c) == 0x0A) || ((c) == 0x0D))\n#define IS_BLANK_CH(c) (((c) == 0x20) || ((0x9 <= (c)) && ((c) <= 0xa)) || ((c) == 0xd))\n#define IS_BLANK(c) IS_BLANK_CH(c)\n#define IS_CHAR(c) xmlIsChar(c)\n#define IS_CHAR_CH(c) (((0x9 <= (c)) && ((c) <= 0xa)) || ((c) == 0xd) || (0x20 <= (c)))\n#define IS_ASCII_LETTER(c) (((0x41 <= (c)) && ((c) <= 0x5a)) || ((0x61 <= (c)) && ((c) <= 0x7a)))\n#define IS_ASCII_DIGIT(c) ((0x30 <= (c)) && ((c) <= 0x39))\n#define IS_DIGIT_CH(c) ((0x30 <= (c)) && ((c) <= 0x39))\n#define IS_LETTER(c) xmlIsLetter(c)\n#define IS_PUBIDCHAR_CH(c) xmlIsPubidChar(c)\n#define IS_PUBIDCHAR(c) xmlIsPubidChar(c)\n#define SKIP_EOL(p) if (*(p) == 0x13) { p++ ; if (*(p) == 0x10) p++; } if (*(p) == 0x10) { p++ ; if (*(p) == 0x13) p++; }\n#define MOVETO_ENDTAG(p) while ((*p) && (*(p) != '>')) (p)++\n#define MOVETO_STARTTAG(p) while ((*p) && (*(p) != '<')) (p)++"

pub const XML_MAX_HUGE_LENGTH: v.c_int = 1000000000

pub extern("c") fn xmlIsLetter(c: v.c_int) -> v.c_int
pub extern("c") fn xmlIsChar(c: v.c_uint) -> v.c_int
pub extern("c") fn xmlIsPubidChar(c: v.c_uint) -> v.c_int
pub extern("c") fn xmlCreateMemoryParserCtxt(buffer: ?[*]const v.c_char, size: v.c_int) -> ?*t.xmlParserCtxt
pub extern("c") fn xmlParseContent(ctxt: ?*t.xmlParserCtxt) -> void
pub extern("c") fn xmlSwitchEncoding(ctxt: ?*t.xmlParserCtxt, enc: t.xmlCharEncoding) -> v.c_int
pub extern("c") fn xmlSwitchToEncoding(ctxt: ?*t.xmlParserCtxt, handler: ?*t.xmlCharEncodingHandler) -> v.c_int
pub extern("c") fn xmlSwitchInputEncoding(ctxt: ?*t.xmlParserCtxt, input: ?*t.xmlParserInput, handler: ?*t.xmlCharEncodingHandler) -> v.c_int
pub extern("c") fn xmlCurrentChar(ctxt: ?*t.xmlParserCtxt, len: ?*v.c_int) -> v.c_int
pub extern("c") fn xmlStringCurrentChar(ctxt: ?*t.xmlParserCtxt, cur: ?[*]const s.xmlChar, len: ?*v.c_int) -> v.c_int
pub extern("c") fn xmlNextChar(ctxt: ?*t.xmlParserCtxt) -> void
pub extern("c") fn xmlCopyChar(len: v.c_int, out: ?[*]s.xmlChar, val: v.c_int) -> v.c_int
pub extern("c") fn xmlCopyCharMultiByte(out: ?[*]s.xmlChar, val: v.c_int) -> v.c_int
pub extern("c") fn xmlFreeInputStream(input: ?*t.xmlParserInput) -> void
pub extern("c") fn xmlStringDecodeEntities(ctxt: ?*t.xmlParserCtxt, str: ?[*]const s.xmlChar, what: v.c_int, end: s.xmlChar, end2: s.xmlChar, end3: s.xmlChar) -> ?[*]s.xmlChar
pub extern("c") fn xmlStringLenDecodeEntities(ctxt: ?*t.xmlParserCtxt, str: ?[*]const s.xmlChar, len: v.c_int, what: v.c_int, end: s.xmlChar, end2: s.xmlChar, end3: s.xmlChar) -> ?[*]s.xmlChar
