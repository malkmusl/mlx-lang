// libxml/xmlmemory.h
// libxml2's memory: the allocator its functions use (C's malloc, realloc
// and free unless xmlMemSetup sets others) and the functions to set it.
// xmlMalloc, xmlRealloc, xmlFree and xmlMemStrdup are its variables
// (globals.h), what xmlMemSetup sets.
const v = @import("./xmlversion.mlx")
const c_function_pointers = true

pub const xmlFreeFunc = fn(mem: ?*anyopaque) -> void
pub const xmlMallocFunc = fn(size: usize) -> ?*anyopaque
pub const xmlReallocFunc = fn(mem: ?*anyopaque, size: usize) -> ?*anyopaque
pub const xmlStrdupFunc = fn(str: ?[*]const v.c_char) -> ?[*]v.c_char

pub extern("c") fn xmlMemSetup(freeFunc: ?xmlFreeFunc, mallocFunc: ?xmlMallocFunc, reallocFunc: ?xmlReallocFunc, strdupFunc: ?xmlStrdupFunc) -> v.c_int
pub extern("c") fn xmlMemGet(freeFunc: ?*?xmlFreeFunc, mallocFunc: ?*?xmlMallocFunc, reallocFunc: ?*?xmlReallocFunc, strdupFunc: ?*?xmlStrdupFunc) -> v.c_int
pub extern("c") fn xmlGcMemSetup(freeFunc: ?xmlFreeFunc, mallocFunc: ?xmlMallocFunc, mallocAtomicFunc: ?xmlMallocFunc, reallocFunc: ?xmlReallocFunc, strdupFunc: ?xmlStrdupFunc) -> v.c_int
pub extern("c") fn xmlInitMemory() -> v.c_int
pub extern("c") fn xmlCleanupMemory() -> void
pub extern("c") fn xmlMemUsed() -> v.c_int
pub extern("c") fn xmlMemBlocks() -> v.c_int
pub extern("c") fn xmlMemMalloc(size: usize) -> ?*anyopaque
pub extern("c") fn xmlMemRealloc(ptr: ?*anyopaque, size: usize) -> ?*anyopaque
pub extern("c") fn xmlMemFree(ptr: ?*anyopaque) -> void
pub extern("c") fn xmlMemoryStrdup(str: ?[*]const v.c_char) -> ?[*]v.c_char
