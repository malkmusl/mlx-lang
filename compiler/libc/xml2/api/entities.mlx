// libxml/entities.h
// libxml2's entities: the five predefined ones, those a document's DTD
// declares (its internal subset's `entities` and `pentities` tables), and
// how to add and find them. The structure is tree.h's xmlEntity.
const v = @import("./xmlversion.mlx")
const s = @import("./xmlstring.mlx")
const t = @import("./tree.mlx")

// An entity's flags (Ubuntu's libxml2 2.9.14, from libxml2 2.11).
pub const XML_ENT_PARSED: v.c_uint = 1
pub const XML_ENT_CHECKED: v.c_uint = 2
pub const XML_ENT_EXPANDING: v.c_uint = 8

pub extern("c") fn xmlInitializePredefinedEntities() -> void
pub extern("c") fn xmlCleanupPredefinedEntities() -> void
pub extern("c") fn xmlNewEntity(doc: ?*t.xmlDoc, name: ?[*]const s.xmlChar, type_: v.c_int, ExternalID: ?[*]const s.xmlChar, SystemID: ?[*]const s.xmlChar, content: ?[*]const s.xmlChar) -> ?*t.xmlEntity
pub extern("c") fn xmlAddDocEntity(doc: ?*t.xmlDoc, name: ?[*]const s.xmlChar, type_: v.c_int, ExternalID: ?[*]const s.xmlChar, SystemID: ?[*]const s.xmlChar, content: ?[*]const s.xmlChar) -> ?*t.xmlEntity
pub extern("c") fn xmlAddDtdEntity(doc: ?*t.xmlDoc, name: ?[*]const s.xmlChar, type_: v.c_int, ExternalID: ?[*]const s.xmlChar, SystemID: ?[*]const s.xmlChar, content: ?[*]const s.xmlChar) -> ?*t.xmlEntity
pub extern("c") fn xmlGetPredefinedEntity(name: ?[*]const s.xmlChar) -> ?*t.xmlEntity
pub extern("c") fn xmlGetDocEntity(doc: ?*const t.xmlDoc, name: ?[*]const s.xmlChar) -> ?*t.xmlEntity
pub extern("c") fn xmlGetDtdEntity(doc: ?*t.xmlDoc, name: ?[*]const s.xmlChar) -> ?*t.xmlEntity
pub extern("c") fn xmlGetParameterEntity(doc: ?*t.xmlDoc, name: ?[*]const s.xmlChar) -> ?*t.xmlEntity
pub extern("c") fn xmlEncodeSpecialChars(doc: ?*const t.xmlDoc, input: ?[*]const s.xmlChar) -> ?[*]s.xmlChar
pub extern("c") fn xmlEncodeEntitiesReentrant(doc: ?*t.xmlDoc, input: ?[*]const s.xmlChar) -> ?[*]s.xmlChar
pub extern("c") fn xmlCreateEntitiesTable() -> ?*t.xmlEntitiesTable
pub extern("c") fn xmlFreeEntitiesTable(table: ?*t.xmlEntitiesTable) -> void
