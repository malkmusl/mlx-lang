// C's variable arguments, as compiler/libc/glib/varargs.mlx makes them:
// a variadic export takes the six integer registers and the eight vector
// registers as its parameters (its fixed ones first) and makes them, with
// the caller's stack words above its frame, a System V va_list for the C
// library's vprintf family.
const text = @import("std.xml.text")

pub const CallList = struct {
    header: [4]u64
    save: [22]u64
}

// The va_list of a variadic export's call: `fixed` of its integer
// registers are its own parameters, `frame` its frame address, `words`
// the six integer registers, `doubles` the eight vector registers.
pub fn start(call: *CallList, fixed: usize, frame: usize, words: usize, doubles: usize) -> usize {
    const save = @intFromPtr(&call.*.save)
    text.copy(save, words, 48)
    var index: usize = 0
    while index < 8 {
        text.put64(save + 48 + index * 16, text.get64(doubles + index * 8))
        text.put64(save + 56 + index * 16, 0)
        index += 1
    }
    const header = @intFromPtr(&call.*.header)
    text.put32(header, @intCast(u64, fixed * 8))
    text.put32(header + 4, 48)
    text.putWord(header + 8, frame + 16)
    text.putWord(header + 16, save)
    return header
}
