// The structures of libxml2's C API (api/tree.mlx, the header's) as the
// library uses them: each field a word of its C size (pointers and
// callbacks usize, int i32, long i64, unsigned long u64), in the same
// order, so the same layout (tools/check_xml2.sh compares the offsets
// with those of the header as mlx-cc lays it out). Made of api/tree.mlx's
// structures and kept in step with them.

pub const Error = struct {
    domain: i32
    code: i32
    message: usize
    level: i32
    file: usize
    line: i32
    str1: usize
    str2: usize
    str3: usize
    int1: i32
    int2: i32
    ctxt: usize
    node: usize
}

pub const Dtd = struct {
    _private: usize
    type_: i32
    name: usize
    children: usize
    last: usize
    parent: usize
    next: usize
    prev: usize
    doc: usize
    notations: usize
    elements: usize
    attributes: usize
    entities: usize
    ExternalID: usize
    SystemID: usize
    pentities: usize
}

pub const Doc = struct {
    _private: usize
    type_: i32
    name: usize
    children: usize
    last: usize
    parent: usize
    next: usize
    prev: usize
    doc: usize
    compression: i32
    standalone: i32
    intSubset: usize
    extSubset: usize
    oldNs: usize
    version: usize
    encoding: usize
    ids: usize
    refs: usize
    URL: usize
    charset: i32
    dict: usize
    psvi: usize
    parseFlags: i32
    properties: i32
}

pub const Entity = struct {
    _private: usize
    type_: i32
    name: usize
    children: usize
    last: usize
    parent: usize
    next: usize
    prev: usize
    doc: usize
    orig: usize
    content: usize
    length: i32
    etype: i32
    ExternalID: usize
    SystemID: usize
    nexte: usize
    URI: usize
    owner: i32
    checked: i32
    flags: i32
    expandedSize: u64
}

pub const EncodingHandler = struct {
    name: usize
    input: usize
    output: usize
}

pub const InputBuffer = struct {
    context: usize
    readcallback: usize
    closecallback: usize
    encoder: usize
    buffer: usize
    raw: usize
    compressed: i32
    error_: i32
    rawconsumed: u64
}

pub const ValidCtxt = struct {
    userData: usize
    error_: usize
    warning: usize
    node: usize
    nodeNr: i32
    nodeMax: i32
    nodeTab: usize
    finishDtd: u32
    doc: usize
    valid: i32
    vstate: usize
    vstateNr: i32
    vstateMax: i32
    vstateTab: usize
    am: usize
    state: usize
}

pub const Input = struct {
    buf: usize
    filename: usize
    directory: usize
    base: usize
    cur: usize
    end: usize
    length: i32
    line: i32
    col: i32
    consumed: u64
    free: usize
    encoding: usize
    version: usize
    standalone: i32
    id: i32
    parentConsumed: u64
    entity: usize
}

pub const NodeInfoSeq = struct {
    maximum: u64
    length: u64
    buffer: usize
}

pub const Locator = struct {
    getPublicId: usize
    getSystemId: usize
    getLineNumber: usize
    getColumnNumber: usize
}

pub const SAXHandler = struct {
    internalSubset: usize
    isStandalone: usize
    hasInternalSubset: usize
    hasExternalSubset: usize
    resolveEntity: usize
    getEntity: usize
    entityDecl: usize
    notationDecl: usize
    attributeDecl: usize
    elementDecl: usize
    unparsedEntityDecl: usize
    setDocumentLocator: usize
    startDocument: usize
    endDocument: usize
    startElement: usize
    endElement: usize
    reference: usize
    characters: usize
    ignorableWhitespace: usize
    processingInstruction: usize
    comment: usize
    warning: usize
    error_: usize
    fatalError: usize
    getParameterEntity: usize
    cdataBlock: usize
    externalSubset: usize
    initialized: u32
    _private: usize
    startElementNs: usize
    endElementNs: usize
    serror: usize
}

pub const Ctxt = struct {
    sax: usize
    userData: usize
    myDoc: usize
    wellFormed: i32
    replaceEntities: i32
    version: usize
    encoding: usize
    standalone: i32
    html: i32
    input: usize
    inputNr: i32
    inputMax: i32
    inputTab: usize
    node: usize
    nodeNr: i32
    nodeMax: i32
    nodeTab: usize
    record_info: i32
    node_seq: NodeInfoSeq
    errNo: i32
    hasExternalSubset: i32
    hasPErefs: i32
    external: i32
    valid: i32
    validate: i32
    vctxt: ValidCtxt
    instate: i32
    token: i32
    directory: usize
    name: usize
    nameNr: i32
    nameMax: i32
    nameTab: usize
    nbChars: i64
    checkIndex: i64
    keepBlanks: i32
    disableSAX: i32
    inSubset: i32
    intSubName: usize
    extSubURI: usize
    extSubSystem: usize
    space: usize
    spaceNr: i32
    spaceMax: i32
    spaceTab: usize
    depth: i32
    entity: usize
    charset: i32
    nodelen: i32
    nodemem: i32
    pedantic: i32
    _private: usize
    loadsubset: i32
    linenumbers: i32
    catalogs: usize
    recovery: i32
    progressive: i32
    dict: usize
    atts: usize
    maxatts: i32
    docdict: i32
    str_xml: usize
    str_xmlns: usize
    str_xml_ns: usize
    sax2: i32
    nsNr: i32
    nsMax: i32
    nsTab: usize
    attallocs: usize
    pushTab: usize
    attsDefault: usize
    attsSpecial: usize
    nsWellFormed: i32
    options: i32
    dictNames: i32
    freeElemsNr: i32
    freeElems: usize
    freeAttrsNr: i32
    freeAttrs: usize
    lastError: Error
    parseMode: i32
    nbentities: u64
    sizeentities: u64
    nodeInfo: usize
    nodeInfoNr: i32
    nodeInfoMax: i32
    nodeInfoTab: usize
    input_id: i32
    sizeentcopy: u64
}
