# The runs of sax.c that tools/check_xml2.sh compares: its options, then
# after ':' the documents (globs under tests/). sax.expected is what the
# system's libxml2 (Ubuntu's 2.9.14) makes of them, run by run.
#
# Not here: billion.xml, deep.xml and long-text.xml but summarized
# (billion.xml's expansion is 225 579 events);
# entity-loop.xml where entities expand without bound (WebKit's handler,
# XML_PARSE_HUGE): libxml2 reports the loop 512 entities deep, this
# library when the recursion has taken 3 MB of stack (some 300 entities);
# -nosax (SAX2's own handler builds a tree in libxml2, none here).
: corpus/[a-ac-ce-km-z]*.xml corpus/b[a-hj-z]*.xml corpus/d[a-df-z]*.xml corpus/decl*.xml corpus/l[a-np-z]*.xml corpus/long-name.xml
-summary: corpus/billion.xml
-summary -noent: corpus/[a-ac-z]*.xml corpus/b[a-hj-z]*.xml
-summary -c 1: corpus/*.xml
-summary -c 3 -noent: corpus/*.xml
-summary -c 64 -recover: corpus/*.xml
-summary -noblanks -nocdata -pedantic: corpus/*.xml
-summary -serror: corpus/*.xml
-summary -gserror -noent: corpus/*.xml
-summary -generic: corpus/[a-ac-z]*.xml corpus/b[a-hj-z]*.xml
-summary -stop 2: corpus/*.xml
-summary -webkit: corpus/[a-ac-df-z]*.xml corpus/b[a-hj-z]*.xml corpus/e[a-mo-z]*.xml corpus/entity-[a-km-z]*.xml corpus/entities.xml corpus/end*.xml
-webkit: corpus/entities.xml corpus/entity-markup.xml corpus/namespaces.xml corpus/xhtml-entities.xml corpus/doctype-ext.xml corpus/svg.xml corpus/utf8.xml corpus/bad-utf8.xml corpus/mismatch.xml
-summary -webkit -c 2: corpus/[a-ac-df-z]*.xml corpus/b[a-hj-z]*.xml corpus/e[a-mo-z]*.xml corpus/entity-[a-km-z]*.xml corpus/entities.xml corpus/end*.xml
-summary -webkit -c 1000 -generic: corpus/[a-ac-df-z]*.xml corpus/b[a-hj-z]*.xml corpus/e[a-mo-z]*.xml corpus/entity-[a-km-z]*.xml corpus/entities.xml corpus/end*.xml
-fragment: fragments/*.frag corpus/basic.xml corpus/entities.xml
-fragment -webkit: fragments/*.frag corpus/basic.xml corpus/entities.xml
