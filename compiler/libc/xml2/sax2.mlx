// libxml2's SAX2 callbacks (SAX2.h), the default handler's and those a
// program's handler calls itself (as WebKit's calls xmlSAX2StartDocument,
// xmlSAX2InternalSubset and xmlSAX2EntityDecl): the document made at the
// start, its internal subset, the entities it declares and their lookup,
// as libxml2's. The callbacks of the tree (elements, attributes, text,
// comments, processing instructions, references, element, attribute and
// notation declarations) build no tree here: they do nothing.
const text = @import("std.xml.text")
const uri = @import("std.xml.uri")
const m = @import("./memory.mlx")
const layout = @import("./layout.mlx")
const errors = @import("./errors.mlx")
const tree = @import("./tree.mlx")
const context = @import("./context.mlx")

// Exports of the library's other modules (called as C calls them).
extern("c") fn xmlGetIntSubset(doc: usize) -> usize
extern("c") fn xmlUnlinkNode(cur: usize) -> void
extern("c") fn xmlFreeDtd(dtd: usize) -> void
extern("c") fn xmlCreateIntSubset(doc: usize, name: usize, externalId: usize, systemId: usize) -> usize
extern("c") fn xmlGetPredefinedEntity(name: usize) -> usize
extern("c") fn xmlGetDocEntity(doc: usize, name: usize) -> usize
extern("c") fn xmlGetParameterEntity(doc: usize, name: usize) -> usize
extern("c") fn xmlAddDocEntity(doc: usize, name: usize, etype: i32, externalId: usize, systemId: usize, content: usize) -> usize
extern("c") fn xmlAddDtdEntity(doc: usize, name: usize, etype: i32, externalId: usize, systemId: usize, content: usize) -> usize
extern("c") fn xmlNewDoc(version: usize) -> usize
extern("c") fn xmlParserWarning(ctx: usize, msg: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void
extern("c") fn xmlParserError(ctx: usize, msg: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void

const Ctxt = layout.Ctxt

inline fn ctxtAt(address: usize) -> *Ctxt { return context.ctxtAt(address) }

// The parser's state shown before the context is read.
fn current(ctx: usize) -> *Ctxt {
    context.show(ctx)
    return ctxtAt(ctx)
}

export fn xmlSAX2GetPublicId(ctx: usize) -> usize { return 0 }

export fn xmlSAX2GetSystemId(ctx: usize) -> usize {
    if ctx == 0 { return 0 }
    const c = current(ctx)
    if c.*.input == 0 { return 0 }
    return context.inputAt(c.*.input).*.filename
}

export fn xmlSAX2GetLineNumber(ctx: usize) -> i32 {
    if ctx == 0 { return 0 }
    const c = current(ctx)
    if c.*.input == 0 { return 0 }
    return context.inputAt(c.*.input).*.line
}

export fn xmlSAX2GetColumnNumber(ctx: usize) -> i32 {
    if ctx == 0 { return 0 }
    const c = current(ctx)
    if c.*.input == 0 { return 0 }
    return context.inputAt(c.*.input).*.col
}

export fn xmlSAX2IsStandalone(ctx: usize) -> i32 {
    if ctx == 0 || ctxtAt(ctx).*.myDoc == 0 { return 0 }
    return if tree.docAt(ctxtAt(ctx).*.myDoc).*.standalone == 1 { 1 } else { 0 }
}

export fn xmlSAX2HasInternalSubset(ctx: usize) -> i32 {
    if ctx == 0 || ctxtAt(ctx).*.myDoc == 0 { return 0 }
    return if tree.docAt(ctxtAt(ctx).*.myDoc).*.intSubset != 0 { 1 } else { 0 }
}

export fn xmlSAX2HasExternalSubset(ctx: usize) -> i32 {
    if ctx == 0 || ctxtAt(ctx).*.myDoc == 0 { return 0 }
    return if tree.docAt(ctxtAt(ctx).*.myDoc).*.extSubset != 0 { 1 } else { 0 }
}

export fn xmlSAX2InternalSubset(ctx: usize, name: usize, externalId: usize, systemId: usize) -> void {
    if ctx == 0 { return }
    const c = current(ctx)
    if c.*.myDoc == 0 { return }
    const dtd = xmlGetIntSubset(c.*.myDoc)
    if dtd != 0 {
        if c.*.html != 0 { return }
        xmlUnlinkNode(dtd)
        xmlFreeDtd(dtd)
        tree.docAt(c.*.myDoc).*.intSubset = 0
    }
    tree.docAt(c.*.myDoc).*.intSubset = xmlCreateIntSubset(c.*.myDoc, name, externalId, systemId)
    if tree.docAt(c.*.myDoc).*.intSubset == 0 { context.errMemory(ctx, "xmlSAX2InternalSubset") }
}

// The external subset is loaded only to validate or when asked for
// (XML_PARSE_DTDLOAD), through the handler's resolveEntity: this library
// loads no external subset (and its resolveEntity finds none).
export fn xmlSAX2ExternalSubset(ctx: usize, name: usize, externalId: usize, systemId: usize) -> void {
    if ctx == 0 { return }
    const c = current(ctx)
    if (externalId != 0 || systemId != 0) && (c.*.validate != 0 || c.*.loadsubset != 0) && c.*.wellFormed != 0 && c.*.myDoc != 0 {
        if c.*.sax != 0 && context.saxAt(c.*.sax).*.resolveEntity != 0 {
            const call: ResolveFn = unsafe { @ptrFromInt(ResolveFn, context.saxAt(c.*.sax).*.resolveEntity) }
            const input = call(c.*.userData, externalId, systemId)
            // (An input a program's resolveEntity makes is not read.)
            if input != 0 { m.xfree(input) }
        }
    }
}

const ResolveFn = fn(usize, usize, usize) -> usize
const LoaderFn = fn(usize, usize, usize) -> usize

// xmlBuildURI as SAX2 uses it: SYSTEMID against BASE (the input's file;
// 0 for none): itself when it is an absolute URI or there is no base,
// the base's directory and it otherwise; 0 when it is no URI reference.
pub fn buildURI(systemId: usize, base: usize) -> usize {
    if systemId == 0 { return 0 }
    if text.get8(systemId) != 0 {
        const parsed = uri.parse(systemId)
        if !parsed.valid { return 0 }
        if parsed.hasScheme || base == 0 { return m.dup(systemId) }
    } else if base == 0 {
        return 0
    }
    var cut = text.length(base)
    while cut > 0 && text.get8(base + cut - 1) != 47 { cut -= 1 }
    const length = text.length(systemId)
    const result = m.xmalloc(cut + length + 1)
    if result == 0 { return 0 }
    text.copy(result, base, cut)
    text.copy(result + cut, systemId, length + 1)
    return result
}

fn baseOf(c: *Ctxt) -> usize {
    var base: usize = 0
    if c.*.input != 0 { base = context.inputAt(c.*.input).*.filename }
    if base == 0 { base = c.*.directory }
    return base
}

export fn xmlSAX2ResolveEntity(ctx: usize, publicId: usize, systemId: usize) -> usize {
    if ctx == 0 { return 0 }
    const c = current(ctx)
    const url = buildURI(systemId, baseOf(c))
    const ret = loadExternalEntity(url, publicId, ctx)
    m.xfree(url)
    return ret
}

// xmlLoadExternalEntity through the loader the program set (by default
// xmlNoNetExternalEntityLoader, which loads nothing).
var loader: usize = 0

pub fn currentLoader() -> usize {
    if loader == 0 { loader = @intFromPtr(xmlNoNetExternalEntityLoader) }
    return loader
}

pub fn setLoader(f: usize) -> void { loader = f }

pub fn loadExternalEntity(url: usize, id: usize, ctxt: usize) -> usize {
    const call: LoaderFn = unsafe { @ptrFromInt(LoaderFn, currentLoader()) }
    return call(url, id, ctxt)
}

// __xmlLoaderErr.
pub fn loaderErr(ctxt: usize, fmt: []const u8, filename: usize) -> void {
    if context.stopped(ctxt) { return }
    var schannel: usize = 0
    var channel: usize = 0
    var data: usize = 0
    var level = errors.LEVEL_ERROR
    if ctxt != 0 && ctxtAt(ctxt).*.sax != 0 {
        const s = context.saxAt(ctxtAt(ctxt).*.sax)
        if ctxtAt(ctxt).*.validate != 0 {
            channel = s.*.error_
        } else {
            channel = s.*.warning
            level = errors.LEVEL_WARNING
        }
        if s.*.initialized == errors.XML_SAX2_MAGIC { schannel = s.*.serror }
        data = ctxtAt(ctxt).*.userData
    }
    context.show(ctxt)
    var file: usize = 0
    var line: i32 = 0
    var col: i32 = 0
    if ctxt != 0 && ctxtAt(ctxt).*.input != 0 {
        const i = context.inputAt(ctxtAt(ctxt).*.input)
        file = i.*.filename
        line = i.*.line
        col = i.*.col
    }
    errors.raise(schannel, channel, data, ctxt, errors.FROM_IO, 1549, level, file, line, filename, 0, 0, 0, col, context.message(fmt, filename, 0))
}

export fn xmlNoNetExternalEntityLoader(url: usize, id: usize, ctxt: usize) -> usize {
    if url == 0 {
        loaderErr(ctxt, "failed to load external entity \"%s\"\n", if id != 0 { id } else { @intFromPtr("NULL".pointer) })
    } else {
        loaderErr(ctxt, "failed to load external entity \"%s\"\n", url)
    }
    return 0
}

export fn xmlSAX2GetEntity(ctx: usize, name: usize) -> usize {
    if ctx == 0 { return 0 }
    const c = current(ctx)
    if c.*.inSubset == 0 {
        const ret = xmlGetPredefinedEntity(name)
        if ret != 0 { return ret }
    }
    if c.*.myDoc != 0 && tree.docAt(c.*.myDoc).*.standalone == 1 {
        const doc = tree.docAt(c.*.myDoc)
        if c.*.inSubset == 2 {
            doc.*.standalone = 0
            const ret = xmlGetDocEntity(c.*.myDoc, name)
            doc.*.standalone = 1
            return ret
        }
        var ret = xmlGetDocEntity(c.*.myDoc, name)
        if ret == 0 {
            doc.*.standalone = 0
            ret = xmlGetDocEntity(c.*.myDoc, name)
            if ret != 0 {
                context.fatalErrMsg(ctx, 103, "Entity(%s) document marked standalone but requires external subset\n", name, 0)
            }
            doc.*.standalone = 1
        }
        return ret
    }
    // (libxml2 parses an external parsed entity found here when it
    // substitutes entities or validates; this library loads none.)
    return xmlGetDocEntity(c.*.myDoc, name)
}

export fn xmlSAX2GetParameterEntity(ctx: usize, name: usize) -> usize {
    if ctx == 0 { return 0 }
    return xmlGetParameterEntity(ctxtAt(ctx).*.myDoc, name)
}

export fn xmlSAX2EntityDecl(ctx: usize, name: usize, etype: i32, publicId: usize, systemId: usize, content: usize) -> void {
    if ctx == 0 { return }
    const c = current(ctx)
    if c.*.inSubset == 1 {
        const ent = xmlAddDocEntity(c.*.myDoc, name, etype, publicId, systemId, content)
        if ent == 0 && c.*.pedantic != 0 {
            context.warnMsg(ctx, 107, "Entity(%s) already defined in the internal subset\n", name)
        }
        if ent != 0 && tree.entityAt(ent).*.URI == 0 && systemId != 0 {
            tree.entityAt(ent).*.URI = buildURI(systemId, baseOf(c))
        }
    } else if c.*.inSubset == 2 {
        const ent = xmlAddDtdEntity(c.*.myDoc, name, etype, publicId, systemId, content)
        if ent != 0 && tree.entityAt(ent).*.URI == 0 && systemId != 0 {
            tree.entityAt(ent).*.URI = buildURI(systemId, baseOf(c))
        }
    } else {
        context.fatalErrMsg(ctx, 104, "SAX.xmlSAX2EntityDecl(%s) called while not in subset\n", name, 0)
    }
}

export fn xmlSAX2UnparsedEntityDecl(ctx: usize, name: usize, publicId: usize, systemId: usize, notationName: usize) -> void {
    if ctx == 0 { return }
    const c = current(ctx)
    if c.*.inSubset == 1 {
        const ent = xmlAddDocEntity(c.*.myDoc, name, tree.EXTERNAL_GENERAL_UNPARSED_ENTITY, publicId, systemId, notationName)
        if ent == 0 && c.*.pedantic != 0 {
            context.warnMsg(ctx, 107, "Entity(%s) already defined in the internal subset\n", name)
        }
        if ent != 0 && tree.entityAt(ent).*.URI == 0 && systemId != 0 {
            tree.entityAt(ent).*.URI = buildURI(systemId, baseOf(c))
        }
    } else if c.*.inSubset == 2 {
        const ent = xmlAddDtdEntity(c.*.myDoc, name, tree.EXTERNAL_GENERAL_UNPARSED_ENTITY, publicId, systemId, notationName)
        if ent != 0 && tree.entityAt(ent).*.URI == 0 && systemId != 0 {
            tree.entityAt(ent).*.URI = buildURI(systemId, baseOf(c))
        }
    } else {
        context.fatalErrMsg(ctx, 1, "SAX.xmlSAX2UnparsedEntityDecl(%s) called while not in subset\n", name, 0)
    }
}

export fn xmlSAX2StartDocument(ctx: usize) -> void {
    if ctx == 0 { return }
    const c = current(ctx)
    const doc = xmlNewDoc(c.*.version)
    c.*.myDoc = doc
    if doc == 0 {
        context.errMemory(ctx, "xmlSAX2StartDocument")
        return
    }
    const d = tree.docAt(doc)
    d.*.properties = if (c.*.options & 131072) != 0 { 4 } else { 0 }
    d.*.parseFlags = c.*.options
    d.*.encoding = m.dup(c.*.encoding)
    d.*.standalone = c.*.standalone
    if c.*.dictNames != 0 {
        d.*.dict = c.*.dict
        text.dictReference(d.*.dict)
    }
    if d.*.URL == 0 && c.*.input != 0 && context.inputAt(c.*.input).*.filename != 0 {
        d.*.URL = m.dup(context.inputAt(c.*.input).*.filename)
    }
}

export fn xmlSAX2EndDocument(ctx: usize) -> void {
    if ctx == 0 { return }
    const c = current(ctx)
    if c.*.myDoc == 0 { return }
    const d = tree.docAt(c.*.myDoc)
    if c.*.encoding != 0 && d.*.encoding == 0 { d.*.encoding = m.dup(c.*.encoding) }
    if c.*.inputTab != 0 && c.*.inputNr > 0 && text.getWord(c.*.inputTab) != 0 && d.*.encoding == 0 {
        const first = context.inputAt(text.getWord(c.*.inputTab))
        if first.*.encoding != 0 { d.*.encoding = m.dup(first.*.encoding) }
    }
    if c.*.charset != 0 && d.*.charset == 0 { d.*.charset = c.*.charset }
}

// The callbacks of the tree: nothing is built.
export fn xmlSAX2SetDocumentLocator(ctx: usize, loc: usize) -> void {}
export fn xmlSAX2AttributeDecl(ctx: usize, elem: usize, fullname: usize, atype: i32, def: i32, defaultValue: usize, enumeration: usize) -> void {
    // (libxml2 frees the enumeration it is handed, once it is in the DTD.)
    var e = enumeration
    while e != 0 {
        const next = text.getWord(e)
        m.xfree(text.getWord(e + 8))
        m.xfree(e)
        e = next
    }
}
export fn xmlSAX2ElementDecl(ctx: usize, name: usize, etype: i32, content: usize) -> void {}
export fn xmlSAX2NotationDecl(ctx: usize, name: usize, publicId: usize, systemId: usize) -> void {}
export fn xmlSAX2StartElement(ctx: usize, fullname: usize, atts: usize) -> void {}
export fn xmlSAX2EndElement(ctx: usize, name: usize) -> void {}
export fn xmlSAX2StartElementNs(ctx: usize, localname: usize, prefix: usize, uriValue: usize, nbNamespaces: i32, namespaces: usize, nbAttributes: i32, nbDefaulted: i32, attributes: usize) -> void {}
export fn xmlSAX2EndElementNs(ctx: usize, localname: usize, prefix: usize, uriValue: usize) -> void {}
export fn xmlSAX2Reference(ctx: usize, name: usize) -> void {}
export fn xmlSAX2Characters(ctx: usize, ch: usize, len: i32) -> void {}
export fn xmlSAX2IgnorableWhitespace(ctx: usize, ch: usize, len: i32) -> void {}
export fn xmlSAX2ProcessingInstruction(ctx: usize, target: usize, data: usize) -> void {}
export fn xmlSAX2Comment(ctx: usize, value: usize) -> void {}
export fn xmlSAX2CDataBlock(ctx: usize, value: usize, len: i32) -> void {}

// ---------------------------------------------------------------------------
// The default handlers

var defaultVersion: i32 = 2

export fn xmlSAXDefaultVersion(version: i32) -> i32 {
    if version != 1 && version != 2 { return -1 }
    const old = defaultVersion
    defaultVersion = version
    return old
}

export fn xmlSAXVersion(hdlr: usize, version: i32) -> i32 {
    if hdlr == 0 { return -1 }
    const h = context.saxAt(hdlr)
    if version == 2 {
        h.*.startElement = 0
        h.*.endElement = 0
        h.*.startElementNs = @intFromPtr(xmlSAX2StartElementNs)
        h.*.endElementNs = @intFromPtr(xmlSAX2EndElementNs)
        h.*.serror = 0
        h.*.initialized = errors.XML_SAX2_MAGIC
    } else if version == 1 {
        h.*.startElement = @intFromPtr(xmlSAX2StartElement)
        h.*.endElement = @intFromPtr(xmlSAX2EndElement)
        h.*.initialized = 1
    } else {
        return -1
    }
    h.*.internalSubset = @intFromPtr(xmlSAX2InternalSubset)
    h.*.externalSubset = @intFromPtr(xmlSAX2ExternalSubset)
    h.*.isStandalone = @intFromPtr(xmlSAX2IsStandalone)
    h.*.hasInternalSubset = @intFromPtr(xmlSAX2HasInternalSubset)
    h.*.hasExternalSubset = @intFromPtr(xmlSAX2HasExternalSubset)
    h.*.resolveEntity = @intFromPtr(xmlSAX2ResolveEntity)
    h.*.getEntity = @intFromPtr(xmlSAX2GetEntity)
    h.*.getParameterEntity = @intFromPtr(xmlSAX2GetParameterEntity)
    h.*.entityDecl = @intFromPtr(xmlSAX2EntityDecl)
    h.*.attributeDecl = @intFromPtr(xmlSAX2AttributeDecl)
    h.*.elementDecl = @intFromPtr(xmlSAX2ElementDecl)
    h.*.notationDecl = @intFromPtr(xmlSAX2NotationDecl)
    h.*.unparsedEntityDecl = @intFromPtr(xmlSAX2UnparsedEntityDecl)
    h.*.setDocumentLocator = @intFromPtr(xmlSAX2SetDocumentLocator)
    h.*.startDocument = @intFromPtr(xmlSAX2StartDocument)
    h.*.endDocument = @intFromPtr(xmlSAX2EndDocument)
    h.*.reference = @intFromPtr(xmlSAX2Reference)
    h.*.characters = @intFromPtr(xmlSAX2Characters)
    h.*.cdataBlock = @intFromPtr(xmlSAX2CDataBlock)
    h.*.ignorableWhitespace = @intFromPtr(xmlSAX2Characters)
    h.*.processingInstruction = @intFromPtr(xmlSAX2ProcessingInstruction)
    h.*.comment = @intFromPtr(xmlSAX2Comment)
    h.*.warning = @intFromPtr(xmlParserWarning)
    h.*.error_ = @intFromPtr(xmlParserError)
    h.*.fatalError = @intFromPtr(xmlParserError)
    return 0
}

export fn xmlSAX2InitDefaultSAXHandler(hdlr: usize, warning: i32) -> void {
    if hdlr == 0 || context.saxAt(hdlr).*.initialized != 0 { return }
    const ignored = xmlSAXVersion(hdlr, defaultVersion)
    context.saxAt(hdlr).*.warning = if warning == 0 { 0 } else { @intFromPtr(xmlParserWarning) }
}

export fn xmlSAX2InitHtmlDefaultSAXHandler(hdlr: usize) -> void {
    if hdlr == 0 || context.saxAt(hdlr).*.initialized != 0 { return }
    const h = context.saxAt(hdlr)
    h.*.internalSubset = @intFromPtr(xmlSAX2InternalSubset)
    h.*.externalSubset = 0
    h.*.isStandalone = 0
    h.*.hasInternalSubset = 0
    h.*.hasExternalSubset = 0
    h.*.resolveEntity = 0
    h.*.getEntity = @intFromPtr(xmlSAX2GetEntity)
    h.*.getParameterEntity = 0
    h.*.entityDecl = 0
    h.*.attributeDecl = 0
    h.*.elementDecl = 0
    h.*.notationDecl = 0
    h.*.unparsedEntityDecl = 0
    h.*.setDocumentLocator = @intFromPtr(xmlSAX2SetDocumentLocator)
    h.*.startDocument = @intFromPtr(xmlSAX2StartDocument)
    h.*.endDocument = @intFromPtr(xmlSAX2EndDocument)
    h.*.startElement = @intFromPtr(xmlSAX2StartElement)
    h.*.endElement = @intFromPtr(xmlSAX2EndElement)
    h.*.reference = 0
    h.*.characters = @intFromPtr(xmlSAX2Characters)
    h.*.cdataBlock = @intFromPtr(xmlSAX2CDataBlock)
    h.*.ignorableWhitespace = @intFromPtr(xmlSAX2IgnorableWhitespace)
    h.*.processingInstruction = 0
    h.*.comment = @intFromPtr(xmlSAX2Comment)
    h.*.warning = @intFromPtr(xmlParserWarning)
    h.*.error_ = @intFromPtr(xmlParserError)
    h.*.fatalError = @intFromPtr(xmlParserError)
    h.*.initialized = 1
}

export fn xmlDefaultSAXHandlerInit() -> void {}
