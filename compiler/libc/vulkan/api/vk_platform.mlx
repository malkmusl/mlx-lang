// vulkan/vk_platform.h
// mlx-vulkan: the platform part of Vulkan's C API: the calling convention
// and attributes of its functions and function pointers, none on x86-64
// and AArch64 Linux.
const c_tokens = usize

pub const VKAPI_ATTR: c_tokens = ""
pub const VKAPI_CALL: c_tokens = ""
pub const VKAPI_PTR: c_tokens = ""
