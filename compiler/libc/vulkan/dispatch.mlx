// The dispatch tables of libmlxvulkan.so. A dispatchable object (an
// instance, a physical device, a device, a queue, a command buffer) is
// the driver's, unwrapped; its first word, which the loader/driver
// interface leaves to the loader, points to the table of its instance or
// device: commands.COUNT words, each command's address in the driver at
// its position (0 when the driver has none).
//
// With MLX_VULKAN_TRACE set, each command called through a table is said
// on the standard error with its first argument (what a crash in the
// driver came after).
const commands = @import("./commands.mlx")

extern("c") fn abort() -> void
extern("c") fn write(descriptor: i32, buffer: usize, count: usize) -> isize
extern("c") fn getenv(name: [*]const u8) -> usize

pub fn word(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub fn setWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }

// 0 not asked yet, 1 tracing, 2 not.
var tracing: u32 = 0

pub fn isTracing() -> bool { return traced() }

fn traced() -> bool {
    var state = @atomicLoad(u32, &tracing, acquire)
    if state == 0 {
        state = if getenv("MLX_VULKAN_TRACE".pointer) != 0 { 1 } else { 2 }
        @atomicStore(u32, &tracing, state, release)
    }
    return state == 1
}

fn say(text: []const u8) -> void { _ = write(2, @intFromPtr(text.pointer), text.length) }

fn sayHex(value: usize) -> void {
    var digits: [18]u8 = undefined
    digits[0] = 48
    digits[1] = 120
    var index: usize = 0
    while index < 16 {
        const nibble = @intCast(u8, (value >> @intCast(u6, 60 - index * 4)) & 15)
        digits[2 + index] = if nibble < 10 { 48 + nibble } else { 87 + nibble }
        index += 1
    }
    _ = write(2, @intFromPtr(&digits), 18)
}

// Says the command at `index` and the handle it was called on.
pub fn trace(index: usize, handle: usize) -> void {
    var offset: usize = 0
    var position: usize = 0
    while position < index {
        while commands.NAMES[offset] != 0 { offset += 1 }
        offset += 1
        while commands.NAMES[offset] != 0 { offset += 1 }
        offset += 1
        position += 1
    }
    var end = offset
    while commands.NAMES[end] != 0 { end += 1 }
    say("vulkan: ")
    say(commands.NAMES[offset..end])
    say(" ")
    sayHex(handle)
    say("\n")
}

// The driver's function at `index` for the object `handle`.
pub fn entry(handle: usize, index: usize) -> usize {
    if traced() { trace(index, handle) }
    const function = word(word(handle) + index * 8)
    if function == 0 { missing() }
    return function
}

fn missing() -> void {
    say("libmlxvulkan: a Vulkan command the driver does not have was called (its extension not enabled?)\n")
    abort()
}
