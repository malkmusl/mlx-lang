// The dispatch tables of libmlxvulkan.so. A dispatchable object (an
// instance, a physical device, a device, a queue, a command buffer) is
// the driver's, unwrapped; its first word, which the loader/driver
// interface leaves to the loader, points to the table of its instance or
// device: commands.COUNT words, each command's address in the driver at
// its position (0 when the driver has none).

extern("c") fn abort() -> void
extern("c") fn write(descriptor: i32, buffer: usize, count: usize) -> isize

pub fn word(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub fn setWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }

// The driver's function at `index` for the object `handle`.
pub fn entry(handle: usize, index: usize) -> usize {
    const function = word(word(handle) + index * 8)
    if function == 0 { missing() }
    return function
}

fn missing() -> void {
    const message = "libmlxvulkan: a Vulkan command the driver does not have was called (its extension not enabled?)\n"
    _ = write(2, @intFromPtr(message.pointer), message.length)
    abort()
}
