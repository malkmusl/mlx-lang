// The generator of mlx-vulkan's API and dispatch (compiler/libc/vulkan),
// from the Vulkan API registry std.vulkan is made of
// (std/registry/vulkan/vk.xml, read by std.vulkan.registry):
//
//   generate            (re)writes api/vulkan_core.mlx and commands.mlx
//   generate --check    fails when either is not what it would write
//
// Run from the repository root (generate.sh). The selection is
// vulkan_core.h's: Vulkan 1.4 and every extension of no window system,
// not provisional, not of video coding.
//
// api/vulkan_core.mlx declares C's names as Vulkan's header has them, for
// mlx-cheaders to make vulkan/vulkan_core.h of: the API constants, the
// handles (`VkInstance` a pointer to the incomplete VkInstance_T), the
// enumerations (with their _MAX_ENUM), the flags (64-bit flag bits as
// constants), the function pointer types, the structures and unions in
// dependency order (a bit-field's run as one uint32_t named after its
// fields), the PFN_ type and the prototype of every command.
//
// commands.mlx is the dispatch of libmlxvulkan.so: each command's
// position in the tables, its name, its level and, for an alias, its
// target's name; and for every command the loader (vulkan.mlx) does not
// implement itself an exported function of the C name that calls the
// driver's through the dispatch table the instance's or the device's
// object points to (its first word, the loader's as in Khronos's
// loader/driver interface).
const std = @import("std")
const registry = @import("std.vulkan.registry")

const ArrayList = std.array_list.ArrayList
const String = std.string.String

const SOURCE = "std/registry/vulkan/vk.xml"
const API_OUTPUT = "compiler/libc/vulkan/api/vulkan_core.mlx"
const COMMANDS_OUTPUT = "compiler/libc/vulkan/commands.mlx"

const NONE: usize = 18446744073709551615

// The commands vulkan.mlx implements (they make, find or end dispatchable
// objects, or answer what only a loader answers).
const SPECIAL = "vkGetInstanceProcAddr vkGetDeviceProcAddr vkCreateInstance vkDestroyInstance vkEnumeratePhysicalDevices vkEnumeratePhysicalDeviceGroups vkEnumeratePhysicalDeviceGroupsKHR vkCreateDevice vkDestroyDevice vkGetDeviceQueue vkGetDeviceQueue2 vkAllocateCommandBuffers vkEnumerateInstanceLayerProperties vkEnumerateDeviceLayerProperties vkEnumerateInstanceExtensionProperties vkEnumerateInstanceVersion"

const LEVEL_GLOBAL: u8 = 0
const LEVEL_INSTANCE: u8 = 1
const LEVEL_DEVICE: u8 = 2

var reg: registry.Registry = undefined
var marks: [*]u8 = undefined

// ---------------------------------------------------------------------------
// Output

fn put(out: *ArrayList, text: []const u8) -> void {
    for byte in text { _ = ArrayList.appendAt(out, byte) }
}

fn putByte(out: *ArrayList, byte: u8) -> void { _ = ArrayList.appendAt(out, byte) }

fn putString(out: *ArrayList, value: String) -> void {
    var index: usize = 0
    while index < value.length {
        putByte(out, value.pointer[index])
        index += 1
    }
}

fn putUnsigned(out: *ArrayList, value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    if rest == 0 {
        putByte(out, 48)
        return
    }
    while rest > 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        putByte(out, digits[count])
    }
}

fn putSigned(out: *ArrayList, value: i64) -> void {
    if value < 0 {
        putByte(out, 45)
        putUnsigned(out, @intCast(u64, 0 - value))
        return
    }
    putUnsigned(out, @intCast(u64, value))
}

fn putHex(out: *ArrayList, value: u64) -> void {
    put(out, "0x")
    var shift: u64 = 60
    var started = false
    while true {
        const digit = @intCast(u8, (value >> @intCast(u6, shift)) & 15)
        if digit != 0 || started || shift == 0 {
            started = true
            putByte(out, if digit < 10 { 48 + digit } else { 55 + digit })
        }
        if shift == 0 { break }
        shift -= 4
    }
}

fn equals(value: String, text: []const u8) -> bool { return registry.equals(value, text) }

// Mlx's keywords: a field or parameter of such a name is written `name_`
// (`const c_keyword_names = true` has mlx-cheaders write it as it was).
const KEYWORDS = "fn pub var try for test true type else enum null const while match break defer align union error false export extern inline return unsafe struct packed default noinline comptime continue errdefer volatile anytype undefined threadlocal nonexhaustive"

fn isKeyword(name: String) -> bool {
    var start: usize = 0
    var at: usize = 0
    while at <= KEYWORDS.length {
        if at == KEYWORDS.length || KEYWORDS[at] == 32 {
            if name.length == at - start && equals(name, KEYWORDS[start..at]) { return true }
            start = at + 1
        }
        at += 1
    }
    return false
}

fn putIdentifier(out: *ArrayList, name: String) -> void {
    putString(out, name)
    if isKeyword(name) { putByte(out, 95) }
}

// ---------------------------------------------------------------------------
// Types

fn scalarName(name: String) -> []const u8 {
    if equals(name, "uint8_t") { return "u8" }
    if equals(name, "int8_t") { return "i8" }
    if equals(name, "uint16_t") { return "u16" }
    if equals(name, "int16_t") { return "i16" }
    if equals(name, "uint32_t") { return "u32" }
    if equals(name, "int32_t") { return "i32" }
    if equals(name, "uint64_t") { return "u64" }
    if equals(name, "int64_t") { return "i64" }
    if equals(name, "size_t") { return "usize" }
    if equals(name, "float") { return "f32" }
    if equals(name, "double") { return "f64" }
    if equals(name, "char") { return "c_char" }
    if equals(name, "int") { return "c_int" }
    if equals(name, "void") { return "anyopaque" }
    return ""
}

fn typeIndex(name: String) -> usize { return registry.findType(&reg, name) }

// Through aliases, the type that defines `name`.
fn resolvedType(name: String) -> usize {
    var index = typeIndex(name)
    var steps: usize = 0
    while index != NONE && registry.typeAt(&reg, index).*.alias.length > 0 && steps < 8 {
        index = typeIndex(registry.typeAt(&reg, index).*.alias)
        steps += 1
    }
    return index
}

fn aggregateOf(name: String) -> usize {
    const index = resolvedType(name)
    if index == NONE { return NONE }
    const category = registry.typeAt(&reg, index).*.category
    if category == registry.CATEGORY_STRUCT || category == registry.CATEGORY_UNION { return index }
    return NONE
}

var failed = false

fn fail(message: []const u8, name: String) -> void {
    _ = std.io.writeAll(std.io.stderr(), "generate: ")
    _ = std.io.writeAll(std.io.stderr(), message)
    _ = std.io.writeString(std.io.stderr(), name)
    _ = std.io.writeAll(std.io.stderr(), "\n")
    failed = true
}

fn putBaseType(out: *ArrayList, name: String) -> void {
    const scalar = scalarName(name)
    if scalar.length > 0 {
        put(out, scalar)
        return
    }
    const index = typeIndex(name)
    if index == NONE || (registry.typeAt(&reg, index).*.category == registry.CATEGORY_OPAQUE && registry.typeAt(&reg, index).*.alias.length == 0) {
        fail("a type of no definition: ", name)
        put(out, "anyopaque")
        return
    }
    putString(out, name)
}

// An array dimension: a number, or an API constant's value.
fn putDimension(out: *ArrayList, text: String) -> void {
    if text.length > 0 && text.pointer[0] >= 48 && text.pointer[0] <= 57 {
        putString(out, text)
        return
    }
    var index = registry.findEnumerant(&reg, text)
    if index != NONE && registry.enumerantAt(&reg, index).*.alias.length > 0 { index = registry.findEnumerant(&reg, registry.enumerantAt(&reg, index).*.alias) }
    if index == NONE {
        fail("an array of an unknown length: ", text)
        return
    }
    const value = registry.enumerantAt(&reg, index).*.text
    var end: usize = 0
    while end < value.length && value.pointer[end] >= 48 && value.pointer[end] <= 57 { end += 1 }
    putString(out, std.string.fromParts(value.pointer, end))
}

// The C declaration of a member or parameter, as Mlx for mlx-cheaders.
fn putMemberType(out: *ArrayList, member: *const registry.Member, parameter: bool) -> void {
    const isConst = member.*.constMask & 1 != 0
    if member.*.pointers == 0 {
        if member.*.arrayLength.length > 0 {
            if parameter {
                // (An array parameter is a pointer to its first element.)
                put(out, if isConst { "*const " } else { "*" })
            } else {
                putByte(out, 91)
                putDimension(out, member.*.arrayLength)
                putByte(out, 93)
                if member.*.arrayLength2.length > 0 {
                    putByte(out, 91)
                    putDimension(out, member.*.arrayLength2)
                    putByte(out, 93)
                }
            }
        }
        putBaseType(out, member.*.typeName)
        return
    }
    if member.*.pointers >= 2 {
        put(out, if member.*.constMask & 2 != 0 { "*const " } else { "*" })
    }
    put(out, if isConst { "*const " } else { "*" })
    putBaseType(out, member.*.typeName)
}

// The type a value of `name` is passed as in the dispatch functions:
// its width, of no meaning (handles and pointers are words).
fn abiType(member: *const registry.Member) -> []const u8 {
    if member.*.pointers > 0 || member.*.arrayLength.length > 0 { return "usize" }
    const scalar = scalarName(member.*.typeName)
    if scalar.length > 0 {
        if std.text.same(scalar, "c_int") { return "i32" }
        if std.text.same(scalar, "c_char") { return "u8" }
        return scalar
    }
    return abiOfType(member.*.typeName)
}

fn abiOfType(name: String) -> []const u8 {
    const index = resolvedType(name)
    if index == NONE {
        fail("a parameter of an unknown type: ", name)
        return "usize"
    }
    const value = registry.typeAt(&reg, index)
    if value.*.category == registry.CATEGORY_HANDLE || value.*.category == registry.CATEGORY_FUNCPOINTER { return "usize" }
    if value.*.category == registry.CATEGORY_ENUM {
        if value.*.block != NONE && registry.blockAt(&reg, value.*.block).*.bitwidth == 64 { return "u64" }
        return "i32"
    }
    if value.*.category == registry.CATEGORY_BITMASK { return if equals(value.*.base, "VkFlags64") { "u64" } else { "u32" } }
    if value.*.category == registry.CATEGORY_BASETYPE {
        const scalar = scalarName(value.*.base)
        if scalar.length > 0 && !std.text.same(scalar, "anyopaque") { return scalar }
        return "usize"
    }
    fail("a structure passed by value: ", name)
    return "usize"
}

fn resultAbi(command: *const registry.Command) -> []const u8 {
    if equals(command.*.returnType, "void") { return "void" }
    if equals(command.*.returnType, "void*") { return "usize" }
    const scalar = scalarName(command.*.returnType)
    if scalar.length > 0 { return scalar }
    return abiOfType(command.*.returnType)
}

// ---------------------------------------------------------------------------
// The C API

// `VkSampleCountFlagBits` as its _MAX_ENUM's prefix and tag
// (VK_SAMPLE_COUNT_FLAG_BITS, ""), `VkDebugReportObjectTypeEXT` as
// (VK_DEBUG_REPORT_OBJECT_TYPE, "_EXT"): Khronos's generator's
// `([0-9]+|[a-z_])([A-Z0-9])` to `\1_\2`, upper case, with the vendor's
// trailing capitals apart.
fn putMaxEnum(out: *ArrayList, name: String) -> void {
    var tagStart = name.length
    while tagStart > 0 && name.pointer[tagStart - 1] >= 65 && name.pointer[tagStart - 1] <= 90 { tagStart -= 1 }
    if name.length - tagStart < 2 { tagStart = name.length }
    var expanded: [200]u8 = undefined
    var length: usize = 0
    var at: usize = 0
    while at < tagStart {
        const c = name.pointer[at]
        const isDigit = c >= 48 && c <= 57
        const isLower = (c >= 97 && c <= 122) || c == 95
        if isDigit {
            var end = at
            while end < tagStart && name.pointer[end] >= 48 && name.pointer[end] <= 57 { end += 1 }
            while at < end {
                expanded[length] = name.pointer[at]
                length += 1
                at += 1
            }
            if at < tagStart && name.pointer[at] >= 65 && name.pointer[at] <= 90 {
                expanded[length] = 95
                length += 1
            }
            continue
        }
        expanded[length] = if isLower && c != 95 { c - 32 } else { c }
        length += 1
        if isLower && at + 1 < tagStart {
            const next = name.pointer[at + 1]
            if (next >= 65 && next <= 90) || (next >= 48 && next <= 57) {
                expanded[length] = 95
                length += 1
            }
        }
        at += 1
    }
    putString(out, std.string.fromParts(&expanded, length))
    put(out, "_MAX_ENUM")
    if tagStart < name.length {
        putByte(out, 95)
        putString(out, std.string.fromParts(name.pointer + tagStart, name.length - tagStart))
    }
}

// An enumerant's value, through its aliases.
fn enumerantValue(index: usize) -> i64 {
    var at = index
    var steps: usize = 0
    while at != NONE && registry.enumerantAt(&reg, at).*.alias.length > 0 && steps < 8 {
        at = registry.findEnumerant(&reg, registry.enumerantAt(&reg, at).*.alias)
        steps += 1
    }
    if at == NONE { return 0 }
    return registry.enumerantAt(&reg, at).*.value
}

fn putEnumeration(out: *ArrayList, value: *const registry.Type) -> void {
    const block = value.*.block
    const wide = block != NONE && registry.blockAt(&reg, block).*.bitwidth == 64
    const bitmask = block != NONE && registry.blockAt(&reg, block).*.kind == registry.BLOCK_BITMASK
    if wide {
        put(out, "pub const ")
        putString(out, value.*.name)
        put(out, " = VkFlags64\n")
        var index: usize = 0
        while index < registry.enumerantCount(&reg) {
            const enumerant = registry.enumerantAt(&reg, index)
            if enumerant.*.block == block {
                put(out, "pub const ")
                putString(out, enumerant.*.name)
                put(out, ": c_tokens = \"")
                putHex(out, @bitCast(u64, enumerantValue(index)))
                put(out, "ULL\"\n")
            }
            index += 1
        }
        return
    }
    put(out, "pub const ")
    putString(out, value.*.name)
    put(out, " = enum(i32) {\n")
    if block != NONE {
        var index: usize = 0
        while index < registry.enumerantCount(&reg) {
            const enumerant = registry.enumerantAt(&reg, index)
            if enumerant.*.block == block {
                put(out, "    ")
                putString(out, enumerant.*.name)
                put(out, " = ")
                const number = enumerantValue(index)
                if bitmask { putHex(out, @bitCast(u64, number) & 4294967295) } else { putSigned(out, number) }
                put(out, ",\n")
            }
            index += 1
        }
    }
    put(out, "    ")
    putMaxEnum(out, value.*.name)
    put(out, " = 0x7FFFFFFF,\n}\n")
}

fn putAggregate(out: *ArrayList, index: usize) -> void {
    if marks[index] != 0 { return }
    marks[index] = 1
    const value = registry.typeAt(&reg, index)
    var member: usize = 0
    while member < value.*.memberCount {
        const field = registry.memberAt(&reg, value.*.memberStart + member)
        if field.*.pointers == 0 {
            const dependency = aggregateOf(field.*.typeName)
            if dependency != NONE && dependency != index { putAggregate(out, dependency) }
        }
        member += 1
    }
    put(out, "pub const ")
    putString(out, value.*.name)
    put(out, if value.*.category == registry.CATEGORY_UNION { " = union {\n" } else { " = struct {\n" })
    member = 0
    while member < value.*.memberCount {
        const field = registry.memberAt(&reg, value.*.memberStart + member)
        put(out, "    ")
        if field.*.bitfield {
            // (C's bit-fields: the run as one word, named after them all.)
            putString(out, field.*.name)
            var bits: u32 = @intCast(u32, field.*.bits)
            while member + 1 < value.*.memberCount && registry.memberAt(&reg, value.*.memberStart + member + 1).*.bitfield && bits + @intCast(u32, registry.memberAt(&reg, value.*.memberStart + member + 1).*.bits) <= 32 {
                member += 1
                bits += @intCast(u32, registry.memberAt(&reg, value.*.memberStart + member).*.bits)
                putByte(out, 95)
                putString(out, registry.memberAt(&reg, value.*.memberStart + member).*.name)
            }
            put(out, ": u32\n")
        } else {
            putIdentifier(out, field.*.name)
            put(out, ": ")
            putMemberType(out, field, false)
            put(out, "\n")
        }
        member += 1
    }
    put(out, "}\n")
    marks[index] = 2
}

fn putParameters(out: *ArrayList, start: usize, count: usize, named: bool) -> void {
    var index: usize = 0
    while index < count {
        const parameter = registry.memberAt(&reg, start + index)
        if index > 0 { put(out, ", ") }
        if named {
            putIdentifier(out, parameter.*.name)
            put(out, ": ")
        }
        putMemberType(out, parameter, true)
        index += 1
    }
}

fn putResult(out: *ArrayList, name: String, pointer: bool) -> void {
    if pointer {
        put(out, "*")
        putBaseType(out, name)
    } else if equals(name, "void") {
        put(out, "void")
    } else {
        putBaseType(out, name)
    }
}

// The command whose parameters `command` has (itself, or its alias's).
fn definingCommand(command: *const registry.Command) -> *registry.Command {
    var index = registry.findCommand(&reg, command.*.name)
    var steps: usize = 0
    while registry.commandAt(&reg, index).*.alias.length > 0 && steps < 8 {
        index = registry.findCommand(&reg, registry.commandAt(&reg, index).*.alias)
        steps += 1
    }
    return registry.commandAt(&reg, index)
}

fn emitApi(out: *ArrayList) -> void {
    put(out, "// vulkan/vulkan_core.h\n")
    put(out, "// mlx-vulkan: Vulkan's C API, the platform-neutral part (Vulkan-Headers ")
    putUnsigned(out, @intCast(u64, reg.headerVersion))
    put(out, "'s\n// vulkan_core.h: Vulkan 1.4 and every extension of no window system, not\n")
    put(out, "// provisional, not of video coding), implemented by libmlxvulkan.so\n")
    put(out, "// (compiler/libc/vulkan) over std.vulkan.loader's drivers.\n")
    put(out, "//\n// GENERATED by compiler/libc/vulkan/generate.sh from std/registry/vulkan/vk.xml\n// -- do not edit.\n")
    put(out, "const c_function_pointers = true\nconst c_keyword_names = true\nconst vk_platform = @import(\"./vk_platform.mlx\")\n\n")
    put(out, "const c_char = u8\nconst c_int = i32\nconst c_tokens = usize\n\n")
    put(out, "pub const VK_VERSION_1_0: c_tokens = \"1\"\npub const VK_VERSION_1_1: c_tokens = \"1\"\npub const VK_VERSION_1_2: c_tokens = \"1\"\npub const VK_VERSION_1_3: c_tokens = \"1\"\npub const VK_VERSION_1_4: c_tokens = \"1\"\n")
    var index: usize = 0
    while index < reg.eligibleNames.length {
        put(out, "pub const ")
        putString(out, registry.nameAt(&reg.eligibleNames, index))
        put(out, ": c_tokens = \"1\"\n")
        index += 1
    }
    put(out, "pub const VK_HEADER_VERSION: c_tokens = \"")
    putUnsigned(out, @intCast(u64, reg.headerVersion))
    put(out, "\"\npub const VK_HEADER_VERSION_COMPLETE: c_tokens = \"VK_MAKE_API_VERSION(0, 1, 4, VK_HEADER_VERSION)\"\n")

    put(out, "\n// The API's and the extensions' constants.\n")
    const constants = registry.findBlock(&reg, std.string.fromSlice("API Constants"))
    index = 0
    while index < registry.enumerantCount(&reg) {
        const value = registry.enumerantAt(&reg, index)
        const constant = constants != NONE && value.*.block == constants
        if constant || (value.*.block == NONE && value.*.required) {
            if value.*.alias.length > 0 {
                put(out, "pub const ")
                putString(out, value.*.name)
                put(out, ": c_tokens = \"")
                putString(out, value.*.alias)
                put(out, "\"\n")
            } else if value.*.text.length > 12 && registry.contains(value.*.text, "&quot;") {
                put(out, "pub const ")
                putString(out, value.*.name)
                put(out, ": [*]const c_char = \"")
                putString(out, std.string.fromParts(value.*.text.pointer + 6, value.*.text.length - 12))
                put(out, "\"\n")
            } else if value.*.text.length > 0 {
                put(out, "pub const ")
                putString(out, value.*.name)
                put(out, ": c_tokens = \"")
                putString(out, value.*.text)
                put(out, "\"\n")
            }
        }
        index += 1
    }

    put(out, "\n// Base types, handles, enumerations, flags.\n")
    index = 0
    while index < registry.typeCount(&reg) {
        const value = registry.typeAt(&reg, index)
        if value.*.required {
            if value.*.alias.length > 0 && value.*.category != registry.CATEGORY_STRUCT && value.*.category != registry.CATEGORY_UNION {
                put(out, "pub const ")
                putString(out, value.*.name)
                put(out, " = ")
                putString(out, value.*.alias)
                put(out, "\n")
            } else if value.*.alias.length > 0 {
                // (Structure aliases follow the structures.)
            } else if value.*.category == registry.CATEGORY_BASETYPE {
                if equals(value.*.name, "VkRemoteAddressNV") {
                    put(out, "pub const VkRemoteAddressNV = *anyopaque\n")
                } else if value.*.base.length > 0 {
                    put(out, "pub const ")
                    putString(out, value.*.name)
                    put(out, " = ")
                    putBaseType(out, value.*.base)
                    put(out, "\n")
                } else {
                    fail("an opaque base type required: ", value.*.name)
                }
            } else if value.*.category == registry.CATEGORY_HANDLE {
                put(out, "pub const ")
                putString(out, value.*.name)
                put(out, "_T = struct {}\npub const ")
                putString(out, value.*.name)
                put(out, " = *")
                putString(out, value.*.name)
                put(out, "_T\n")
            } else if value.*.category == registry.CATEGORY_ENUM {
                putEnumeration(out, value)
            } else if value.*.category == registry.CATEGORY_BITMASK {
                put(out, "pub const ")
                putString(out, value.*.name)
                put(out, " = ")
                putString(out, if value.*.base.length > 0 { value.*.base } else { std.string.fromSlice("VkFlags") })
                put(out, "\n")
            } else if value.*.category == registry.CATEGORY_OPAQUE && scalarName(value.*.name).length == 0 {
                fail("a type of no definition required: ", value.*.name)
            }
        }
        index += 1
    }

    put(out, "\n// Function pointers.\n")
    index = 0
    while index < registry.typeCount(&reg) {
        const value = registry.typeAt(&reg, index)
        if value.*.required && value.*.alias.length == 0 && value.*.category == registry.CATEGORY_FUNCPOINTER {
            if value.*.memberCount == 0 {
                fail("a function pointer of no prototype: ", value.*.name)
            } else {
                const prototype = registry.memberAt(&reg, value.*.memberStart)
                put(out, "pub const ")
                putString(out, value.*.name)
                put(out, " = fn(")
                putParameters(out, value.*.memberStart + 1, value.*.memberCount - 1, false)
                put(out, ") -> ")
                putResult(out, prototype.*.typeName, prototype.*.pointers > 0)
                put(out, "\n")
            }
        }
        index += 1
    }

    put(out, "\n// Structures and unions.\n")
    index = 0
    while index < registry.typeCount(&reg) {
        const value = registry.typeAt(&reg, index)
        if value.*.required && value.*.alias.length == 0 && (value.*.category == registry.CATEGORY_STRUCT || value.*.category == registry.CATEGORY_UNION) { putAggregate(out, index) }
        index += 1
    }
    index = 0
    while index < registry.typeCount(&reg) {
        const value = registry.typeAt(&reg, index)
        if value.*.required && value.*.alias.length > 0 && (value.*.category == registry.CATEGORY_STRUCT || value.*.category == registry.CATEGORY_UNION) {
            put(out, "pub const ")
            putString(out, value.*.name)
            put(out, " = ")
            putString(out, value.*.alias)
            put(out, "\n")
        }
        index += 1
    }

    put(out, "\n// Commands: the types of pointers to them, and the functions.\n")
    index = 0
    while index < registry.commandCount(&reg) {
        const command = registry.commandAt(&reg, index)
        if command.*.required {
            put(out, "pub const PFN_")
            putString(out, command.*.name)
            if command.*.alias.length > 0 {
                put(out, " = PFN_")
                putString(out, command.*.alias)
                put(out, "\n")
            } else {
                put(out, " = fn(")
                putParameters(out, command.*.paramStart, command.*.paramCount, false)
                put(out, ") -> ")
                putResult(out, command.*.returnType, false)
                put(out, "\n")
            }
        }
        index += 1
    }
    index = 0
    while index < registry.commandCount(&reg) {
        const command = registry.commandAt(&reg, index)
        if command.*.required {
            const defining = definingCommand(command)
            put(out, "pub extern(\"c\") fn ")
            putString(out, command.*.name)
            putByte(out, 40)
            putParameters(out, defining.*.paramStart, defining.*.paramCount, true)
            put(out, ") -> ")
            putResult(out, defining.*.returnType, false)
            put(out, "\n")
        }
        index += 1
    }

    put(out, "\n// What Mlx cannot say: handles defined by name, the null handle, the\n// version numbers.\nconst c_macros = \"")
    put(out, "#define VK_DEFINE_HANDLE(object) typedef struct object##_T* object;\\n")
    put(out, "#ifndef VK_USE_64_BIT_PTR_DEFINES\\n#define VK_USE_64_BIT_PTR_DEFINES 1\\n#endif\\n")
    put(out, "#ifndef VK_DEFINE_NON_DISPATCHABLE_HANDLE\\n#define VK_DEFINE_NON_DISPATCHABLE_HANDLE(object) typedef struct object##_T *object;\\n#endif\\n")
    put(out, "#ifndef VK_NULL_HANDLE\\n#if defined(__cplusplus) && (__cplusplus >= 201103L)\\n#define VK_NULL_HANDLE nullptr\\n#else\\n#define VK_NULL_HANDLE ((void*)0)\\n#endif\\n#endif\\n")
    put(out, "#define VK_MAKE_API_VERSION(variant, major, minor, patch) ((((uint32_t)(variant)) << 29U) | (((uint32_t)(major)) << 22U) | (((uint32_t)(minor)) << 12U) | ((uint32_t)(patch)))\\n")
    put(out, "#define VK_API_VERSION_VARIANT(version) ((uint32_t)(version) >> 29U)\\n")
    put(out, "#define VK_API_VERSION_MAJOR(version) (((uint32_t)(version) >> 22U) & 0x7FU)\\n")
    put(out, "#define VK_API_VERSION_MINOR(version) (((uint32_t)(version) >> 12U) & 0x3FFU)\\n")
    put(out, "#define VK_API_VERSION_PATCH(version) ((uint32_t)(version) & 0xFFFU)\\n")
    put(out, "#define VK_MAKE_VERSION(major, minor, patch) ((((uint32_t)(major)) << 22U) | (((uint32_t)(minor)) << 12U) | ((uint32_t)(patch)))\\n")
    put(out, "#define VK_VERSION_MAJOR(version) ((uint32_t)(version) >> 22U)\\n")
    put(out, "#define VK_VERSION_MINOR(version) (((uint32_t)(version) >> 12U) & 0x3FFU)\\n")
    put(out, "#define VK_VERSION_PATCH(version) ((uint32_t)(version) & 0xFFFU)\\n")
    put(out, "#define VK_API_VERSION_1_0 VK_MAKE_API_VERSION(0, 1, 0, 0)\\n#define VK_API_VERSION_1_1 VK_MAKE_API_VERSION(0, 1, 1, 0)\\n")
    put(out, "#define VK_API_VERSION_1_2 VK_MAKE_API_VERSION(0, 1, 2, 0)\\n#define VK_API_VERSION_1_3 VK_MAKE_API_VERSION(0, 1, 3, 0)\\n")
    put(out, "#define VK_API_VERSION_1_4 VK_MAKE_API_VERSION(0, 1, 4, 0)\\n")
    put(out, "\"\n")
}

// ---------------------------------------------------------------------------
// The dispatch

fn commandLevel(command: *const registry.Command) -> u8 {
    if equals(command.*.name, "vkGetInstanceProcAddr") { return LEVEL_GLOBAL }
    if equals(command.*.name, "vkGetDeviceProcAddr") { return LEVEL_INSTANCE }
    const defining = definingCommand(command)
    if defining.*.paramCount == 0 { return LEVEL_GLOBAL }
    const first = registry.memberAt(&reg, defining.*.paramStart).*.typeName
    if equals(first, "VkInstance") || equals(first, "VkPhysicalDevice") { return LEVEL_INSTANCE }
    if equals(first, "VkDevice") || equals(first, "VkQueue") || equals(first, "VkCommandBuffer") || equals(first, "VkExternalComputeQueueNV") { return LEVEL_DEVICE }
    return LEVEL_GLOBAL
}

fn isSpecial(name: String) -> bool {
    var start: usize = 0
    var at: usize = 0
    while at <= SPECIAL.length {
        if at == SPECIAL.length || SPECIAL[at] == 32 {
            if name.length == at - start && equals(name, SPECIAL[start..at]) { return true }
            start = at + 1
        }
        at += 1
    }
    return false
}

fn emitCommands(out: *ArrayList) -> void {
    put(out, "// libmlxvulkan.so's dispatch: the commands' tables and the functions of\n// their C names that call the driver's (see vulkan.mlx).\n")
    put(out, "//\n// GENERATED by compiler/libc/vulkan/generate.sh from std/registry/vulkan/vk.xml\n// -- do not edit.\n")
    put(out, "const dispatch = @import(\"./dispatch.mlx\")\n\n")
    var count: usize = 0
    var index: usize = 0
    while index < registry.commandCount(&reg) {
        if registry.commandAt(&reg, index).*.required { count += 1 }
        index += 1
    }
    put(out, "pub const COUNT: usize = ")
    putUnsigned(out, @intCast(u64, count))
    put(out, "\n\n// Each command's name, then its alias's target's (\"\" for none), NUL-terminated.\npub const NAMES = \"")
    index = 0
    while index < registry.commandCount(&reg) {
        const command = registry.commandAt(&reg, index)
        if command.*.required {
            putString(out, command.*.name)
            put(out, "\\x00")
            putString(out, command.*.alias)
            put(out, "\\x00")
        }
        index += 1
    }
    put(out, "\"\n\n// Each command's level: 0 global, 1 instance, 2 device.\npub const LEVELS = \"")
    index = 0
    while index < registry.commandCount(&reg) {
        const command = registry.commandAt(&reg, index)
        if command.*.required {
            put(out, "\\x0")
            putByte(out, 48 + commandLevel(command))
        }
        index += 1
    }
    put(out, "\"\n")
    var position: usize = 0
    index = 0
    while index < registry.commandCount(&reg) {
        const command = registry.commandAt(&reg, index)
        if command.*.required {
            const level = commandLevel(command)
            if !isSpecial(command.*.name) && level != LEVEL_GLOBAL {
                const defining = definingCommand(command)
                const result = resultAbi(defining)
                put(out, "\nconst F_")
                putString(out, command.*.name)
                put(out, " = fn(")
                var parameter: usize = 0
                while parameter < defining.*.paramCount {
                    if parameter > 0 { put(out, ", ") }
                    put(out, abiType(registry.memberAt(&reg, defining.*.paramStart + parameter)))
                    parameter += 1
                }
                put(out, ") -> ")
                put(out, result)
                put(out, "\nexport fn ")
                putString(out, command.*.name)
                putByte(out, 40)
                parameter = 0
                while parameter < defining.*.paramCount {
                    if parameter > 0 { put(out, ", ") }
                    put(out, "a")
                    putUnsigned(out, @intCast(u64, parameter))
                    put(out, ": ")
                    put(out, abiType(registry.memberAt(&reg, defining.*.paramStart + parameter)))
                    parameter += 1
                }
                put(out, ") -> ")
                put(out, result)
                put(out, " {\n    const f = unsafe { @ptrFromInt(F_")
                putString(out, command.*.name)
                put(out, ", dispatch.entry(a0, ")
                putUnsigned(out, @intCast(u64, position))
                put(out, ")) }\n    ")
                if !std.text.same(result, "void") { put(out, "return ") }
                put(out, "f(")
                parameter = 0
                while parameter < defining.*.paramCount {
                    if parameter > 0 { put(out, ", ") }
                    put(out, "a")
                    putUnsigned(out, @intCast(u64, parameter))
                    parameter += 1
                }
                put(out, ")\n}\n")
            }
            position += 1
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------

fn readFile(path: []const u8, allocator: std.allocator.Allocator, result: *ArrayList) -> bool {
    var loaded: ?ArrayList = null
    unsafe { loaded = std.fs.readFileAlloc(@ptrCast([*]const u8, path), allocator) }
    if loaded == null { return false }
    result.* = loaded.?
    return true
}

fn sameContents(left: *const ArrayList, right: *const ArrayList) -> bool {
    if left.*.length != right.*.length { return false }
    var index: usize = 0
    while index < left.*.length {
        if left.*.items[index] != right.*.items[index] { return false }
        index += 1
    }
    return true
}

// Writes (or with `check` compares) one output; false on a difference or
// a failure.
fn finish(path: []const u8, out: *ArrayList, check: bool, allocator: std.allocator.Allocator) -> bool {
    if check {
        var existing: ArrayList = undefined
        if !readFile(path, allocator, &existing) || !sameContents(&existing, out) {
            _ = std.io.writeAll(std.io.stderr(), "stale generated file: ")
            _ = std.io.writeAll(std.io.stderr(), path)
            _ = std.io.writeAll(std.io.stderr(), "\n")
            return false
        }
        return true
    }
    var file = std.fs.open(unsafe { @ptrFromInt([*]const u8, 0) }, 0, 0)
    unsafe { file = std.fs.open(@ptrCast([*]const u8, path), 577, 420) }
    if !std.fs.isValid(file) { return false }
    const written = std.fs.writeAllBytes(file, out.*.items, out.*.length)
    _ = std.fs.close(file)
    return written
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.heap.allocator()
    var check = false
    if std.process.count(arguments) > 1 {
        check = std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("--check"))
        if !check {
            _ = std.io.writeAll(std.io.stderr(), "usage: generate [--check]\n")
            return 2
        }
    }
    var source: ArrayList = undefined
    if !readFile(SOURCE, allocator, &source) {
        _ = std.io.writeAll(std.io.stderr(), "generate: cannot read std/registry/vulkan/vk.xml\n")
        return 1
    }
    var selection: registry.Selection = undefined
    selection.maxMinor = 4
    selection.extensionCount = 0
    selection.everyExtension = true
    registry.initAt(&reg, allocator, source.items, source.length, selection)
    if !registry.parse(&reg) {
        fail("vk.xml does not parse: ", reg.failure)
        return 1
    }
    if !registry.resolve(&reg) {
        fail("required definition missing from the registry: ", reg.failure)
        return 1
    }
    const memory = allocator.alloc(registry.typeCount(&reg), 1)
    if memory == null { return 1 }
    marks = memory.?
    var index: usize = 0
    while index < registry.typeCount(&reg) {
        marks[index] = 0
        index += 1
    }
    var api = ArrayList.init(allocator, 1 << 23)
    emitApi(&api)
    var commands = ArrayList.init(allocator, 1 << 22)
    emitCommands(&commands)
    if failed { return 1 }
    if !finish(API_OUTPUT, &api, check, allocator) { return 1 }
    if !finish(COMMANDS_OUTPUT, &commands, check, allocator) { return 1 }
    if !check { _ = std.io.writeAll(std.io.stderr(), "generated compiler/libc/vulkan/api/vulkan_core.mlx and commands.mlx\n") }
    return 0
}
