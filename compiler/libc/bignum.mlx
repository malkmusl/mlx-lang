// Unsigned big integers (little-endian u32 limbs, 1536 bits) for the exact
// conversions between decimal text and doubles that strtod and printf
// need: a double's value is m * 2^e, a decimal's d * 10^k, and only whole
// numbers of this size turn one into the other without rounding twice.
pub const LIMBS: usize = 48

pub const Big = struct {
    limbs: [48]u32
    count: usize
}

pub fn setZero(big: *Big) -> void {
    var index: usize = 0
    while index < LIMBS {
        big.*.limbs[index] = 0
        index += 1
    }
    big.*.count = 0
}

pub fn setU64(big: *Big, value: u64) -> void {
    setZero(big)
    big.*.limbs[0] = @intCast(u32, value & 4294967295)
    big.*.limbs[1] = @intCast(u32, value >> 32)
    big.*.count = if big.*.limbs[1] != 0 { 2 } else { if big.*.limbs[0] != 0 { 1 } else { 0 } }
}

pub fn zero() -> Big {
    var result: Big = undefined
    setZero(&result)
    return result
}

pub fn fromU64(value: u64) -> Big {
    var result: Big = undefined
    setU64(&result, value)
    return result
}

fn trim(big: *Big) -> void {
    while big.*.count > 0 && big.*.limbs[big.*.count - 1] == 0 { big.*.count -= 1 }
}

pub fn isZero(big: *const Big) -> bool { return big.*.count == 0 }

pub fn mulSmall(big: *Big, factor: u32) -> void {
    var carry: u64 = 0
    var index: usize = 0
    while index < big.*.count {
        const product = @intCast(u64, big.*.limbs[index]) * @intCast(u64, factor) + carry
        big.*.limbs[index] = @intCast(u32, product & 4294967295)
        carry = product >> 32
        index += 1
    }
    if carry != 0 && big.*.count < LIMBS {
        big.*.limbs[big.*.count] = @intCast(u32, carry)
        big.*.count += 1
    }
}

pub fn addSmall(big: *Big, value: u32) -> void {
    var carry: u64 = @intCast(u64, value)
    var index: usize = 0
    while carry != 0 && index < LIMBS {
        const sum = @intCast(u64, if index < big.*.count { big.*.limbs[index] } else { 0 }) + carry
        big.*.limbs[index] = @intCast(u32, sum & 4294967295)
        carry = sum >> 32
        if index >= big.*.count { big.*.count = index + 1 }
        index += 1
    }
}

// big / divisor, the remainder returned.
pub fn divSmall(big: *Big, divisor: u32) -> u32 {
    var remainder: u64 = 0
    var index = big.*.count
    while index > 0 {
        index -= 1
        const current = (remainder << 32) | @intCast(u64, big.*.limbs[index])
        big.*.limbs[index] = @intCast(u32, current / @intCast(u64, divisor))
        remainder = current % @intCast(u64, divisor)
    }
    trim(big)
    return @intCast(u32, remainder)
}

pub fn mulPow10(big: *Big, exponent: usize) -> void {
    var left = exponent
    while left >= 9 {
        mulSmall(big, 1000000000)
        left -= 9
    }
    while left > 0 {
        mulSmall(big, 10)
        left -= 1
    }
}

pub fn pow10(exponent: usize) -> Big {
    var result = fromU64(1)
    mulPow10(&result, exponent)
    return result
}

pub fn shiftLeft(big: *Big, bits: usize) -> void {
    if big.*.count == 0 || bits == 0 { return }
    const limb_shift = bits / 32
    const bit_shift = @intCast(u32, bits % 32)
    var index = big.*.count + limb_shift + 1
    if index > LIMBS { index = LIMBS }
    var at = index
    while at > 0 {
        at -= 1
        var value: u32 = 0
        if at >= limb_shift {
            const source = at - limb_shift
            if source < big.*.count { value = big.*.limbs[source] << @intCast(u5, bit_shift) }
            if bit_shift != 0 && source >= 1 && source - 1 < big.*.count { value |= big.*.limbs[source - 1] >> @intCast(u5, 32 - bit_shift) }
        }
        big.*.limbs[at] = value
    }
    big.*.count = index
    trim(big)
}

pub fn shiftLeftOne(big: *Big) -> void {
    var carry: u32 = 0
    var index: usize = 0
    while index < big.*.count {
        const value = big.*.limbs[index]
        big.*.limbs[index] = (value << 1) | carry
        carry = value >> 31
        index += 1
    }
    if carry != 0 && big.*.count < LIMBS {
        big.*.limbs[big.*.count] = carry
        big.*.count += 1
    }
}

pub fn bitLength(big: *const Big) -> usize {
    if big.*.count == 0 { return 0 }
    var top = big.*.limbs[big.*.count - 1]
    var bits: usize = 0
    while top != 0 {
        top >>= 1
        bits += 1
    }
    return (big.*.count - 1) * 32 + bits
}

pub fn bit(big: *const Big, index: usize) -> u32 {
    const limb = index / 32
    if limb >= big.*.count { return 0 }
    return (big.*.limbs[limb] >> @intCast(u5, index % 32)) & 1
}

pub fn compare(first: *const Big, second: *const Big) -> i32 {
    if first.*.count != second.*.count { return if first.*.count > second.*.count { 1 } else { -1 } }
    var index = first.*.count
    while index > 0 {
        index -= 1
        if first.*.limbs[index] != second.*.limbs[index] { return if first.*.limbs[index] > second.*.limbs[index] { 1 } else { -1 } }
    }
    return 0
}

// first -= second (first >= second).
pub fn sub(first: *Big, second: *const Big) -> void {
    var borrow: u64 = 0
    var index: usize = 0
    while index < first.*.count {
        const taken = @intCast(u64, if index < second.*.count { second.*.limbs[index] } else { 0 }) + borrow
        const have = @intCast(u64, first.*.limbs[index])
        if have >= taken {
            first.*.limbs[index] = @intCast(u32, have - taken)
            borrow = 0
        } else {
            first.*.limbs[index] = @intCast(u32, have + 4294967296 - taken)
            borrow = 1
        }
        index += 1
    }
    trim(first)
}

// The top 64 bits of a number wider than that, and whether anything
// nonzero was below them.
pub fn topBits(big: *const Big, shift: usize) -> (u64, bool) {
    var value: u64 = 0
    var index: usize = 0
    while index < 64 {
        value |= @intCast(u64, bit(big, shift + index)) << @intCast(u6, index)
        index += 1
    }
    var sticky = false
    index = 0
    while index < shift && !sticky {
        if bit(big, index) != 0 { sticky = true }
        index += 1
    }
    return -> (value, sticky)
}

// floor(numerator / denominator) as a u64 (the quotient is known to fit) and
// whether the division left a remainder: restoring division bit by bit.
pub fn divide(numerator: *const Big, denominator: *const Big) -> (u64, bool) {
    var remainder = zero()
    var quotient: u64 = 0
    var index = bitLength(numerator)
    while index > 0 {
        index -= 1
        shiftLeftOne(&remainder)
        if bit(numerator, index) != 0 {
            if remainder.count == 0 { remainder.count = 1 }
            remainder.limbs[0] |= 1
        }
        quotient <<= 1
        if compare(&remainder, denominator) >= 0 {
            sub(&remainder, denominator)
            quotient |= 1
        }
    }
    return -> (quotient, remainder.count != 0)
}

// A double from m * 2^exponent (m up to 64 bits) with `sticky` saying the
// exact value lies above it by less than one unit, rounded to nearest with
// ties to even, infinities and subnormals included; `range` is set when
// the result overflowed or lost precision below the normal range.
pub fn makeDouble(mantissa: u64, exponent: i64, sticky: bool, negative: bool, range: *bool) -> f64 {
    const sign: u64 = if negative { 9223372036854775808 } else { 0 }
    if mantissa == 0 { return @bitCast(f64, sign) }
    var length: i64 = 0
    var probe = mantissa
    while probe != 0 {
        probe >>= 1
        length += 1
    }
    const leading = exponent + length - 1
    if leading > 1023 {
        range.* = true
        return @bitCast(f64, sign | 9218868437227405312)
    }
    var keep: i64 = 53
    if leading < -1022 { keep = 53 - (-1022 - leading) }
    if keep <= 0 {
        // Below half the smallest subnormal rounds to zero; the smallest
        // subnormal above that.
        range.* = true
        if keep == 0 && (mantissa > (@intCast(u64, 1) << @intCast(u6, length - 1)) || sticky) { return @bitCast(f64, sign | 1) }
        return @bitCast(f64, sign)
    }
    var value = mantissa
    var value_exponent = exponent
    const shift = length - keep
    if shift > 0 {
        const dropped = value & ((@intCast(u64, 1) << @intCast(u6, shift)) - 1)
        const half = @intCast(u64, 1) << @intCast(u6, shift - 1)
        value = value >> @intCast(u6, shift)
        value_exponent += shift
        if dropped > half || (dropped == half && (sticky || value & 1 == 1)) { value += 1 }
        if dropped != 0 && leading < -1022 { range.* = true }
    } else if shift < 0 {
        value = value << @intCast(u6, 0 - shift)
        value_exponent += shift
    }
    // value * 2^value_exponent, value with `keep` (or one more) bits.
    length = 0
    probe = value
    while probe != 0 {
        probe >>= 1
        length += 1
    }
    const top = value_exponent + length - 1
    if top > 1023 {
        range.* = true
        return @bitCast(f64, sign | 9218868437227405312)
    }
    if top >= -1022 {
        var fraction = value
        if length > 53 { fraction = fraction >> @intCast(u6, length - 53) } else { fraction = fraction << @intCast(u6, 53 - length) }
        return @bitCast(f64, sign | (@intCast(u64, top + 1023) << 52) | (fraction & 4503599627370495))
    }
    // Subnormal: the field is value scaled to units of 2^-1074.
    const field = value << @intCast(u6, value_exponent + 1074)
    return @bitCast(f64, sign | field)
}
