// libmlxlcms2.so.2: Little CMS's C API (2.14: lcms2.h, declared by
// api/lcms2.mlx, whose C header mlx-cheaders makes) over
// std.colorprofile: profiles read and built, tone curves, colour
// transforms of 8- and 16-bit pixels.
//
//     ./mlx build lcms2
//
// The handles C holds are std.colorprofile's blocks: a cmsHPROFILE is a
// Profile, a cmsHTRANSFORM a Transform, a cmsToneCurve* a Curve. A
// cmsCIEXYZ is three doubles, as the profile's XYZ tags hold them, so
// cmsReadTag hands those out as they are. The memory is the C library's.
const cp = @import("std.colorprofile")
const zs = @import("std.flate.stream")

const mem = cp.mem
const curve = cp.curve
const profile = cp.profile
const link = cp.link
const transform = cp.transform
const matrix = cp.matrix
const format = cp.format

pub const Allocator = mem.Allocator

pub extern("c") fn malloc(size: usize) -> usize
pub extern("c") fn free(address: usize) -> void
pub extern("c") fn fopen(path: usize, mode: usize) -> usize
pub extern("c") fn fread(buffer: usize, size: usize, count: usize, file: usize) -> usize
pub extern("c") fn fclose(file: usize) -> i32

fn allocatorAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const address = malloc(if length == 0 { 1 } else { length })
    if address == 0 { return null }
    return zs.bytes(address)
}

fn allocatorResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> bool { return false }

fn allocatorRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> ?[*]u8 {
    const address = malloc(if newLength == 0 { 1 } else { newLength })
    if address == 0 { return null }
    zs.copy(address, @intFromPtr(memory), if length < newLength { length } else { newLength })
    free(@intFromPtr(memory))
    return zs.bytes(address)
}

fn allocatorFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    free(@intFromPtr(memory))
}

fn allocator() -> Allocator {
    unsafe {
        return Allocator.{
            .context = @ptrFromInt(*anyopaque, 16),
            .allocFn = allocatorAlloc,
            .resizeFn = allocatorResize,
            .remapFn = allocatorRemap,
            .freeFn = allocatorFree
        }
    }
}

inline fn profileOf(address: usize) -> *profile.Profile { return profile.profileAt(address) }

// The library's state: the error handler (kept, not called), the
// adaptation state, D50 (cmsD50_XYZ's and cmsD50_xyY's).
var errorHandler: usize = 0
// (The state as the bits of a double: a module holds no float.)
var adaptationBits: u64 = 0x3FF0000000000000
var d50: usize = 0

fn d50Block() -> usize {
    if d50 == 0 {
        const block = malloc(48)
        if block == 0 { return 0 }
        mem.doubles(block)[0] = mem.D50X
        mem.doubles(block)[1] = mem.D50Y
        mem.doubles(block)[2] = mem.D50Z
        var xyY: [3]f64 = undefined
        matrix.xyzToxyY(mem.D50X, mem.D50Y, mem.D50Z, &xyY)
        mem.doubles(block)[3] = xyY[0]
        mem.doubles(block)[4] = xyY[1]
        mem.doubles(block)[5] = xyY[2]
        d50 = block
    }
    return d50
}

inline fn cbool(value: bool) -> i32 { return if value { 1 } else { 0 } }

// ---------------------------------------------------------------------------
// The library, contexts, colorimetry

export fn cmsGetEncodedCMMversion() -> i32 { return 2140 }

export fn cmsSetLogErrorHandler(handler: usize) -> void { errorHandler = handler }
export fn cmsSetLogErrorHandlerTHR(context: usize, handler: usize) -> void { errorHandler = handler }

// Every context is the global one; a context made is a token for it.
export fn cmsCreateContext(plugin: usize, userData: usize) -> usize {
    const block = malloc(16)
    if block != 0 { mem.put64(block, @intCast(u64, userData)) }
    return block
}

export fn cmsDeleteContext(context: usize) -> void { if context != 0 { free(context) } }

export fn cmsGetContextUserData(context: usize) -> usize {
    if context == 0 { return 0 }
    return @intCast(usize, mem.get64(context))
}

export fn cmsSetAdaptationState(d: f64) -> f64 {
    const previous = @bitCast(f64, adaptationBits)
    if d >= 0.0 { adaptationBits = @bitCast(u64, d) }
    return previous
}

export fn cmsD50_XYZ() -> usize { return d50Block() }

export fn cmsD50_xyY() -> usize {
    const block = d50Block()
    if block == 0 { return 0 }
    return block + 24
}

export fn cmsXYZ2xyY(dest: usize, source: usize) -> void {
    var out: [3]f64 = undefined
    const s = mem.doubles(source)
    matrix.xyzToxyY(s[0], s[1], s[2], &out)
    mem.doubles(dest)[0] = out[0]
    mem.doubles(dest)[1] = out[1]
    mem.doubles(dest)[2] = out[2]
}

export fn cmsxyY2XYZ(dest: usize, source: usize) -> void {
    var out: [3]f64 = undefined
    const s = mem.doubles(source)
    matrix.xyYToXYZ(s[0], s[1], s[2], &out)
    mem.doubles(dest)[0] = out[0]
    mem.doubles(dest)[1] = out[1]
    mem.doubles(dest)[2] = out[2]
}

fn whiteOrD50(white: usize, out: *[3]f64) -> void {
    if white == 0 {
        out.*[0] = mem.D50X
        out.*[1] = mem.D50Y
        out.*[2] = mem.D50Z
    } else {
        out.*[0] = mem.doubles(white)[0]
        out.*[1] = mem.doubles(white)[1]
        out.*[2] = mem.doubles(white)[2]
    }
}

export fn cmsXYZ2Lab(white: usize, lab: usize, xyz: usize) -> void {
    var w: [3]f64 = undefined
    whiteOrD50(white, &w)
    var out: [3]f64 = undefined
    const v = mem.doubles(xyz)
    cp.pipeline.xyzToLab(v[0], v[1], v[2], w[0], w[1], w[2], &out)
    mem.doubles(lab)[0] = out[0]
    mem.doubles(lab)[1] = out[1]
    mem.doubles(lab)[2] = out[2]
}

export fn cmsLab2XYZ(white: usize, xyz: usize, lab: usize) -> void {
    var w: [3]f64 = undefined
    whiteOrD50(white, &w)
    var out: [3]f64 = undefined
    const v = mem.doubles(lab)
    cp.pipeline.labToXyz(v[0], v[1], v[2], w[0], w[1], w[2], &out)
    mem.doubles(xyz)[0] = out[0]
    mem.doubles(xyz)[1] = out[1]
    mem.doubles(xyz)[2] = out[2]
}

export fn cmsDeltaE(lab1: usize, lab2: usize) -> f64 {
    const a = mem.doubles(lab1)
    const b = mem.doubles(lab2)
    const dl = mem.fabs(a[0] - b[0])
    const da = mem.fabs(a[1] - b[1])
    const db = mem.fabs(a[2] - b[2])
    return @sqrt(dl * dl + da * da + db * db)
}

export fn cmsWhitePointFromTemp(white: usize, tempK: f64) -> i32 {
    const t = tempK
    const t2 = t * t
    const t3 = t2 * t
    var x: f64 = 0.0
    if t >= 4000.0 && t <= 7000.0 {
        x = -4.6070 * (1000000000.0 / t3) + 2.9678 * (1000000.0 / t2) + 0.09911 * (1000.0 / t) + 0.244063
    } else if t > 7000.0 && t <= 25000.0 {
        x = -2.0064 * (1000000000.0 / t3) + 1.9018 * (1000000.0 / t2) + 0.24748 * (1000.0 / t) + 0.237040
    } else {
        return 0
    }
    const y = -3.000 * (x * x) + 2.870 * x - 0.275
    mem.doubles(white)[0] = x
    mem.doubles(white)[1] = y
    mem.doubles(white)[2] = 1.0
    return 1
}

export fn cmsAdaptToIlluminant(result: usize, source: usize, illuminant: usize, value: usize) -> i32 {
    var from: [3]f64 = undefined
    var to: [3]f64 = undefined
    whiteOrD50(source, &from)
    whiteOrD50(illuminant, &to)
    var bradford: [9]f64 = undefined
    if !matrix.adaptationMatrix(&bradford, &from, &to) { return 0 }
    var v: [3]f64 = undefined
    whiteOrD50(value, &v)
    var out: [3]f64 = undefined
    matrix.apply(&out, &bradford, &v)
    mem.doubles(result)[0] = out[0]
    mem.doubles(result)[1] = out[1]
    mem.doubles(result)[2] = out[2]
    return 1
}

// ---------------------------------------------------------------------------
// Tone curves

// cmsCurveSegment (C): x0, x1 floats, Type an int, Params ten doubles at
// 16, nGridPoints at 96, SampledPoints at 104; 112 bytes.
export fn cmsBuildSegmentedToneCurve(context: usize, count: u32, segments: usize) -> usize {
    const n = @intCast(usize, count)
    if n == 0 || segments == 0 { return 0 }
    const ours = malloc(n * @sizeOf(curve.Segment))
    if ours == 0 { return 0 }
    mem.zero(ours, n * @sizeOf(curve.Segment))
    var index: usize = 0
    while index < n {
        const c = segments + index * 112
        const s = unsafe { @ptrFromInt(*curve.Segment, ours + index * @sizeOf(curve.Segment)) }
        s.*.x0 = mem.getF32(c)
        s.*.x1 = mem.getF32(c + 4)
        var kind = @intCast(i64, mem.get32(c + 8))
        if kind >= 0x80000000 { kind = kind - 4294967296 }
        s.*.kind = kind
        var p: usize = 0
        while p < 10 {
            s.*.params[p] = mem.getF64(c + 16 + p * 8)
            p += 1
        }
        s.*.gridPoints = @intCast(usize, mem.get32(c + 96))
        s.*.sampled = @intCast(usize, mem.get64(c + 104))
        index += 1
    }
    const result = curve.buildSegmented(allocator(), n, ours)
    free(ours)
    return result
}

export fn cmsBuildParametricToneCurve(context: usize, kind: i32, params: usize) -> usize {
    if params == 0 { return 0 }
    return curve.buildParametric(allocator(), @intCast(i64, kind), mem.doubles(params))
}

export fn cmsBuildGamma(context: usize, gamma: f64) -> usize { return curve.buildGamma(allocator(), gamma) }

export fn cmsBuildTabulatedToneCurve16(context: usize, entries: u32, values: usize) -> usize {
    return curve.buildTabulated16(allocator(), @intCast(usize, entries), values)
}

export fn cmsBuildTabulatedToneCurveFloat(context: usize, entries: u32, values: usize) -> usize {
    if values == 0 { return 0 }
    return curve.buildTabulatedFloat(allocator(), @intCast(usize, entries), values)
}

export fn cmsFreeToneCurve(c: usize) -> void { curve.freeCurve(c) }

export fn cmsFreeToneCurveTriple(curves: usize) -> void {
    const list = mem.words(curves)
    if list[0] != 0 { curve.freeCurve(list[0]) }
    if list[1] != 0 { curve.freeCurve(list[1]) }
    if list[2] != 0 { curve.freeCurve(list[2]) }
    list[0] = 0
    list[1] = 0
    list[2] = 0
}

export fn cmsDupToneCurve(c: usize) -> usize { return curve.duplicateCurve(c) }
export fn cmsReverseToneCurve(c: usize) -> usize { return curve.reverse(c, 4096) }
export fn cmsReverseToneCurveEx(samples: u32, c: usize) -> usize { return curve.reverse(c, @intCast(usize, samples)) }
export fn cmsIsToneCurveLinear(c: usize) -> i32 { return cbool(curve.isLinear(curve.curveAt(c))) }
export fn cmsIsToneCurveMonotonic(c: usize) -> i32 { return cbool(curve.isMonotonic(curve.curveAt(c))) }
export fn cmsIsToneCurveDescending(c: usize) -> i32 { return cbool(curve.isDescending(curve.curveAt(c))) }
export fn cmsIsToneCurveMultisegment(c: usize) -> i32 { return cbool(curve.curveAt(c).*.segmentCount > 1) }
export fn cmsGetToneCurveParametricType(c: usize) -> i32 { return @intCast(i32, curve.parametricType(curve.curveAt(c))) }
export fn cmsEstimateGamma(c: usize, precision: f64) -> f64 { return curve.estimateGamma(curve.curveAt(c), precision) }

export fn cmsGetToneCurveParams(c: usize) -> usize {
    const t = curve.curveAt(c)
    if t.*.segmentCount != 1 { return 0 }
    return @intFromPtr(&curve.segmentAt(t, 0).*.params)
}

export fn cmsGetToneCurveEstimatedTableEntries(c: usize) -> u32 { return @intCast(u32, curve.curveAt(c).*.entries) }
export fn cmsGetToneCurveEstimatedTable(c: usize) -> usize { return curve.curveAt(c).*.table }
export fn cmsEvalToneCurveFloat(c: usize, v: f32) -> f32 { return curve.evalFloat(curve.curveAt(c), v) }
export fn cmsEvalToneCurve16(c: usize, v: u16) -> u16 { return @intCast(u16, curve.eval16(curve.curveAt(c), @intCast(u64, v))) }

// ---------------------------------------------------------------------------
// Profiles

export fn cmsOpenProfileFromMem(data: usize, size: u32) -> usize { return profile.open(allocator(), data, @intCast(usize, size)) }
export fn cmsOpenProfileFromMemTHR(context: usize, data: usize, size: u32) -> usize { return profile.open(allocator(), data, @intCast(usize, size)) }

// The whole file read, then opened from memory.
fn openFile(path: usize, access: usize) -> usize {
    if path == 0 { return 0 }
    if access != 0 && mem.get8(access) != 0x72 && mem.get8(access) != 0x52 { return 0 }
    var mode: [4]u8 = undefined
    mode[0] = 114
    mode[1] = 98
    mode[2] = 0
    mode[3] = 0
    const file = fopen(path, @intFromPtr(&mode))
    if file == 0 { return 0 }
    var size: usize = 0
    var capacity: usize = 65536
    var data = malloc(capacity)
    while data != 0 {
        const got = fread(data + size, 1, capacity - size, file)
        size += got
        if size < capacity { break }
        const bigger = malloc(capacity * 2)
        if bigger != 0 { mem.copy(bigger, data, size) }
        free(data)
        data = bigger
        capacity = capacity * 2
    }
    const ignored = fclose(file)
    if data == 0 { return 0 }
    const result = profile.open(allocator(), data, size)
    free(data)
    return result
}

export fn cmsOpenProfileFromFile(path: usize, access: usize) -> usize { return openFile(path, access) }
export fn cmsOpenProfileFromFileTHR(context: usize, path: usize, access: usize) -> usize { return openFile(path, access) }

export fn cmsCloseProfile(p: usize) -> i32 {
    if p == 0 { return 0 }
    profile.close(p)
    return 1
}

export fn cmsCreate_sRGBProfile() -> usize { return profile.createSRGB(allocator()) }
export fn cmsCreate_sRGBProfileTHR(context: usize) -> usize { return profile.createSRGB(allocator()) }

// cmsCIExyY and cmsCIExyYTRIPLE are the doubles std.colorprofile takes.
export fn cmsCreateRGBProfile(white: usize, primaries: usize, curves: usize) -> usize { return profile.createRGB(allocator(), white, primaries, curves) }
export fn cmsCreateRGBProfileTHR(context: usize, white: usize, primaries: usize, curves: usize) -> usize { return profile.createRGB(allocator(), white, primaries, curves) }
export fn cmsCreateGrayProfile(white: usize, c: usize) -> usize { return profile.createGray(allocator(), white, c) }
export fn cmsCreateGrayProfileTHR(context: usize, white: usize, c: usize) -> usize { return profile.createGray(allocator(), white, c) }
export fn cmsCreateXYZProfile() -> usize { return profile.createXYZ(allocator()) }
export fn cmsCreateXYZProfileTHR(context: usize) -> usize { return profile.createXYZ(allocator()) }
export fn cmsGetProfileContextID(p: usize) -> usize { return 0 }

export fn cmsGetColorSpace(p: usize) -> u32 { return @intCast(u32, profileOf(p).*.colorSpace & 0xffffffff) }
export fn cmsSetColorSpace(p: usize, sig: u32) -> void { profileOf(p).*.colorSpace = @intCast(u64, sig) }
export fn cmsGetPCS(p: usize) -> u32 { return @intCast(u32, profileOf(p).*.pcs & 0xffffffff) }
export fn cmsSetPCS(p: usize, sig: u32) -> void { profileOf(p).*.pcs = @intCast(u64, sig) }
export fn cmsGetDeviceClass(p: usize) -> u32 { return @intCast(u32, profileOf(p).*.deviceClass & 0xffffffff) }
export fn cmsSetDeviceClass(p: usize, sig: u32) -> void { profileOf(p).*.deviceClass = @intCast(u64, sig) }
export fn cmsGetEncodedICCversion(p: usize) -> u32 { return @intCast(u32, profileOf(p).*.version & 0xffffffff) }
export fn cmsSetEncodedICCversion(p: usize, version: u32) -> void { profileOf(p).*.version = @intCast(u64, version) }
export fn cmsGetProfileVersion(p: usize) -> f64 { return profile.getVersion(profileOf(p)) }
export fn cmsSetProfileVersion(p: usize, version: f64) -> void { profile.setVersion(profileOf(p), version) }
export fn cmsGetHeaderRenderingIntent(p: usize) -> u32 { return @intCast(u32, profileOf(p).*.renderingIntent & 0xffffffff) }
export fn cmsSetHeaderRenderingIntent(p: usize, intent: u32) -> void { profileOf(p).*.renderingIntent = @intCast(u64, intent) }
export fn cmsGetHeaderFlags(p: usize) -> u32 { return @intCast(u32, profileOf(p).*.flags & 0xffffffff) }
export fn cmsGetHeaderManufacturer(p: usize) -> u32 { return @intCast(u32, profileOf(p).*.manufacturer & 0xffffffff) }
export fn cmsGetHeaderModel(p: usize) -> u32 { return @intCast(u32, profileOf(p).*.model & 0xffffffff) }
export fn cmsGetHeaderCreator(p: usize) -> u32 { return @intCast(u32, profileOf(p).*.creator & 0xffffffff) }
export fn cmsGetHeaderAttributes(p: usize, flags: usize) -> void { mem.put64(flags, profileOf(p).*.attributes) }

export fn cmsGetHeaderProfileID(p: usize, id: usize) -> void {
    var index: usize = 0
    while index < 16 {
        mem.put8(id + index, @intCast(u64, profileOf(p).*.profileID[index]))
        index += 1
    }
}

export fn cmsGetTagCount(p: usize) -> i32 {
    if p == 0 { return -1 }
    return @intCast(i32, profileOf(p).*.tagCount)
}

export fn cmsGetTagSignature(p: usize, n: u32) -> u32 {
    const index = @intCast(usize, n)
    if index >= profileOf(p).*.tagCount { return 0 }
    return @intCast(u32, profileOf(p).*.tagNames[index] & 0xffffffff)
}

export fn cmsIsTag(p: usize, sig: u32) -> i32 { return cbool(profile.isTag(profileOf(p), @intCast(u64, sig))) }

export fn cmsReadTag(p: usize, sig: u32) -> usize {
    var kind: u64 = 0
    return profile.readTag(profileOf(p), @intCast(u64, sig), &kind)
}

export fn cmsTagLinkedTo(p: usize, sig: u32) -> u32 {
    const n = profile.search(profileOf(p), @intCast(u64, sig), false)
    if n < 0 { return 0 }
    return @intCast(u32, profileOf(p).*.tagLinked[@intCast(usize, n)] & 0xffffffff)
}

export fn cmsIsMatrixShaper(p: usize) -> i32 { return cbool(link.isMatrixShaper(profileOf(p))) }
export fn cmsIsCLUT(p: usize, intent: u32, direction: u32) -> i32 { return cbool(link.isCLUT(profileOf(p), @intCast(u64, intent), @intCast(u64, direction))) }
export fn cmsIsIntentSupported(p: usize, intent: u32, direction: u32) -> i32 { return cbool(link.isIntentSupported(profileOf(p), @intCast(u64, intent), @intCast(u64, direction))) }
export fn cmsDetectRGBProfileGamma(p: usize, threshold: f64) -> f64 { return transform.detectRGBGamma(p, threshold) }
export fn cmsChannelsOf(space: u32) -> u32 { return @intCast(u32, profile.channelsOf(@intCast(u64, space))) }
export fn cmsChannelsOfColorSpace(space: u32) -> i32 { return @intCast(i32, profile.channelsOfSpace(@intCast(u64, space))) }
export fn _cmsICCcolorSpace(notation: i32) -> u32 {
    if notation < 0 { return 0 }
    return @intCast(u32, format.iccColorSpace(@intCast(u64, notation)))
}
export fn _cmsLCMScolorSpace(space: u32) -> i32 { return @intCast(i32, format.lcmsColorSpace(@intCast(u64, space))) }

fn formatterFor(space: u64, bytes: u32, isFloat: i32) -> u32 {
    const channels = profile.channelsOfSpace(space)
    if channels < 0 { return 0 }
    const floatBit: u64 = if isFloat != 0 { 1 } else { 0 }
    const word = (floatBit << 22) | (format.lcmsColorSpace(space) << 16) | @intCast(u64, bytes) | (@intCast(u64, channels) << 3)
    return @intCast(u32, word & 0xffffffff)
}

export fn cmsFormatterForColorspaceOfProfile(p: usize, bytes: u32, isFloat: i32) -> u32 { return formatterFor(profileOf(p).*.colorSpace, bytes, isFloat) }
export fn cmsFormatterForPCSOfProfile(p: usize, bytes: u32, isFloat: i32) -> u32 { return formatterFor(profileOf(p).*.pcs, bytes, isFloat) }

// ---------------------------------------------------------------------------
// Transforms

// cmsCreateExtendedTransform: the C arrays (BPC ints, intents, states)
// read into std.colorprofile's.
fn createExtended(count: usize, profiles: usize, bpc: usize, intents: usize, states: usize, inputFormat: u32, outputFormat: u32, flags: u32) -> usize {
    if count == 0 || count > 255 || profiles == 0 { return 0 }
    const block = malloc(count * 32)
    if block == 0 { return 0 }
    const ourProfiles = mem.words(block)
    const ourIntents = unsafe { @ptrFromInt([*]u64, block + count * 8) }
    const ourStates = mem.doubles(block + count * 16)
    const ourBpc = unsafe { @ptrFromInt([*]bool, block + count * 24) }
    var index: usize = 0
    while index < count {
        ourProfiles[index] = mem.words(profiles)[index]
        ourIntents[index] = mem.get32(intents + index * 4)
        ourStates[index] = mem.doubles(states)[index]
        ourBpc[index] = mem.get32(bpc + index * 4) != 0
        index += 1
    }
    const result = transform.createExtended(allocator(), count, ourProfiles, ourBpc, ourIntents, ourStates, @intCast(u64, inputFormat), @intCast(u64, outputFormat), @intCast(u64, flags))
    free(block)
    return result
}

// cmsCreateMultiprofileTransformTHR: one intent and the flags' black
// point compensation for all, the adaptation state set.
fn createMultiprofile(profiles: usize, count: usize, inputFormat: u32, outputFormat: u32, intent: u32, flags: u32) -> usize {
    if count == 0 || count > 255 { return 0 }
    const block = malloc(count * 16)
    if block == 0 { return 0 }
    var index: usize = 0
    while index < count {
        mem.put32(block + index * 4, if (flags & 0x2000) != 0 { 1 } else { 0 })
        mem.put32(block + count * 4 + index * 4, @intCast(u64, intent))
        mem.doubles(block + count * 8)[index] = @bitCast(f64, adaptationBits)
        index += 1
    }
    const result = createExtended(count, profiles, block, block + count * 4, block + count * 8, inputFormat, outputFormat, flags)
    free(block)
    return result
}

fn createPair(input: usize, inputFormat: u32, output: usize, outputFormat: u32, intent: u32, flags: u32) -> usize {
    const block = malloc(16)
    if block == 0 { return 0 }
    mem.words(block)[0] = input
    mem.words(block)[1] = output
    const result = createMultiprofile(block, if output == 0 { 1 } else { 2 }, inputFormat, outputFormat, intent, flags)
    free(block)
    return result
}

export fn cmsCreateTransform(input: usize, inputFormat: u32, output: usize, outputFormat: u32, intent: u32, flags: u32) -> usize {
    return createPair(input, inputFormat, output, outputFormat, intent, flags)
}

export fn cmsCreateTransformTHR(context: usize, input: usize, inputFormat: u32, output: usize, outputFormat: u32, intent: u32, flags: u32) -> usize {
    return createPair(input, inputFormat, output, outputFormat, intent, flags)
}

export fn cmsCreateMultiprofileTransform(profiles: usize, count: u32, inputFormat: u32, outputFormat: u32, intent: u32, flags: u32) -> usize {
    return createMultiprofile(profiles, @intCast(usize, count), inputFormat, outputFormat, intent, flags)
}

export fn cmsCreateMultiprofileTransformTHR(context: usize, profiles: usize, count: u32, inputFormat: u32, outputFormat: u32, intent: u32, flags: u32) -> usize {
    return createMultiprofile(profiles, @intCast(usize, count), inputFormat, outputFormat, intent, flags)
}

export fn cmsCreateExtendedTransform(context: usize, count: u32, profiles: usize, bpc: usize, intents: usize, states: usize, gamut: usize, gamutPosition: u32, inputFormat: u32, outputFormat: u32, flags: u32) -> usize {
    return createExtended(@intCast(usize, count), profiles, bpc, intents, states, inputFormat, outputFormat, flags)
}

export fn cmsDeleteTransform(t: usize) -> void { transform.delete(t) }

export fn cmsDoTransform(t: usize, input: usize, output: usize, size: u32) -> void {
    if t == 0 { return }
    transform.transform(t, input, output, @intCast(usize, size))
}

export fn cmsDoTransformStride(t: usize, input: usize, output: usize, size: u32, stride: u32) -> void {
    if t == 0 { return }
    transform.transformLines(t, input, output, @intCast(usize, size), 1, 0, 0, @intCast(usize, stride), @intCast(usize, stride))
}

export fn cmsDoTransformLineStride(t: usize, input: usize, output: usize, pixels: u32, lines: u32, lineIn: u32, lineOut: u32, planeIn: u32, planeOut: u32) -> void {
    if t == 0 { return }
    transform.transformLines(t, input, output, @intCast(usize, pixels), @intCast(usize, lines), @intCast(usize, lineIn), @intCast(usize, lineOut), @intCast(usize, planeIn), @intCast(usize, planeOut))
}

export fn cmsGetTransformInputFormat(t: usize) -> u32 {
    if t == 0 { return 0 }
    return @intCast(u32, transform.transformAt(t).*.inputFormat & 0xffffffff)
}

export fn cmsGetTransformOutputFormat(t: usize) -> u32 {
    if t == 0 { return 0 }
    return @intCast(u32, transform.transformAt(t).*.outputFormat & 0xffffffff)
}

export fn cmsGetTransformContextID(t: usize) -> usize { return 0 }
