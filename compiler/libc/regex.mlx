// regex.h: POSIX regular expressions, basic and extended, as glibc's
// regcomp, regexec, regerror and regfree take and answer them, in the C
// locale (a character is a byte).
//
// A pattern is parsed into a tree, and the tree compiled into a program
// for a backtracking machine: characters, sets (a bitmap of the 256 bytes
// each), splits, group boundaries, assertions, back-references. regexec
// looks for the leftmost match and, among the matches that start there,
// the longest, as POSIX asks (a Perl-style engine would take the first
// alternative instead): the search goes on after a match until every path
// is tried, and remembers which (instruction, position) states it has
// been in, so each is tried once and a search costs the program's length
// times the text's at most. Among matches of the same length the groups
// are taken leftmost, then longest, in order (POSIX's rule for
// subexpressions, close to what glibc reports). A pattern with
// back-references cannot share states (what follows depends on what a
// group matched): it is searched without that memory.
//
// What glibc's regcomp takes in its POSIX syntaxes is taken: in extended
// expressions `( ) | * + ? {m,n}`, anchors anywhere, `)` alone an ordinary
// character, a repetition operator with nothing before it an error; in
// basic ones `\( \) \{m,n\}`, `*` ordinary at the start, `^` an anchor at
// the start (of the expression, a group or an alternative), `$` at the
// end, and GNU's `\| \+ \?`; in both bracket expressions with character
// classes, equivalence classes and collating symbols of one character,
// back-references `\1` to `\9`, GNU's `\w \W \s \S \b \B \< \> \`` and
// `\'`; REG_ICASE, REG_NEWLINE, REG_NOSUB, and REG_NOTBOL, REG_NOTEOL and
// REG_STARTEND at execution.
//
// regex_t is glibc's (64 bytes, `re_nsub` at offset 48): the compiled
// program's address is kept in its first word (glibc's `buffer`);
// regmatch_t is glibc's too, two ints.
const sys = @import("./sys.mlx")
const heap = @import("./heap.mlx")

// regcomp's flags, regexec's flags, the error codes (glibc's values).
const REG_EXTENDED: i32 = 1
const REG_ICASE: i32 = 2
const REG_NEWLINE: i32 = 4
const REG_NOSUB: i32 = 8
const REG_NOTBOL: i32 = 1
const REG_NOTEOL: i32 = 2
const REG_STARTEND: i32 = 4
const REG_NOMATCH: i32 = 1
const REG_BADPAT: i32 = 2
const REG_ECOLLATE: i32 = 3
const REG_ECTYPE: i32 = 4
const REG_EESCAPE: i32 = 5
const REG_ESUBREG: i32 = 6
const REG_EBRACK: i32 = 7
const REG_EPAREN: i32 = 8
const REG_EBRACE: i32 = 9
const REG_BADBR: i32 = 10
const REG_ERANGE: i32 = 11
const REG_ESPACE: i32 = 12
const REG_BADRPT: i32 = 13
const REG_ESIZE: i32 = 15

// RE_DUP_MAX, the largest count of a bound.
const DUP_MAX: usize = 32767
// The most instructions a program may have (a bound repeats what it
// bounds), and the most bytes of the memory of states a search keeps.
const MAX_CODE: usize = 1048576
const MAX_MEMO: usize = 67108864

// The end of the pattern, for the parser's look at the next character.
const END: usize = 256
// No node: an empty branch so far.
const NONE: usize = 18446744073709551615
// A bound without a maximum; a group boundary not set.
const INFINITE: usize = 18446744073709551615
const UNSET: usize = 18446744073709551615

// The tree's nodes (four words each: kind, a, b, c).
const N_EMPTY: usize = 0
const N_CHAR: usize = 1      // a: the byte (folded under REG_ICASE)
const N_ANY: usize = 2
const N_SET: usize = 3       // a: the set
const N_CAT: usize = 4       // a, b
const N_ALT: usize = 5       // a, b
const N_REPEAT: usize = 6    // a: the node, b: at least, c: at most
const N_GROUP: usize = 7     // a: the node, b: the group's number
const N_ASSERT: usize = 8    // a: what is asserted (A_*)
const N_BACKREF: usize = 9   // a: the group's number

// The program's instructions (three words each: operation, a, b).
const I_CHAR: usize = 0      // a: the byte
const I_ANY: usize = 1
const I_SET: usize = 2       // a: the set
const I_SPLIT: usize = 3     // a first, then b
const I_JMP: usize = 4       // a
const I_SAVE: usize = 5      // a: the group boundary's slot
const I_ASSERT: usize = 6    // a: A_*
const I_BACKREF: usize = 7   // a: the group
const I_MARK: usize = 8      // a: the loop: where this pass began
const I_CHECK: usize = 9     // a: the loop, b: its end (0: none): after a pass
const I_MATCH: usize = 10
const I_ENTER: usize = 11    // a: the loop: no pass yet

// Assertions: the start and end of a line (or of the text), the edges
// of words, the start and end of the text alone.
const A_BOL: usize = 0
const A_EOL: usize = 1
const A_WORDB: usize = 2
const A_NWORDB: usize = 3
const A_WBEG: usize = 4
const A_WEND: usize = 5
const A_BUFBEG: usize = 6
const A_BUFEND: usize = 7

// A growing array of words on the heap.
const Words = struct {
    base: usize
    count: usize
    capacity: usize
}

fn emptyWords() -> Words { return Words.{ .base = 0, .count = 0, .capacity = 0 } }

fn push(w: *Words, value: usize) -> bool {
    if w.*.count == w.*.capacity {
        const capacity = if w.*.capacity == 0 { 64 } else { w.*.capacity * 2 }
        const grown = heap.allocate(capacity * 8, 16)
        if grown == 0 { return false }
        if w.*.count > 0 { sys.copy(grown, w.*.base, w.*.count * 8) }
        heap.release(w.*.base)
        w.*.base = grown
        w.*.capacity = capacity
    }
    sys.putPointer(w.*.base + w.*.count * 8, value)
    w.*.count += 1
    return true
}

fn wordAt(w: *Words, index: usize) -> usize { return sys.getPointer(w.*.base + index * 8) }
fn setWord(w: *Words, index: usize, value: usize) -> void { sys.putPointer(w.*.base + index * 8, value) }

const Parser = struct {
    pattern: usize
    length: usize
    at: usize
    extended: bool
    icase: bool
    newline: bool
    nodes: Words
    sets: Words
    // The groups opened so far, and those closed (bit n for group n), as
    // a back-reference may only name a group that has ended.
    groups: usize
    closed: u64
    backrefs: bool
    status: i32
}

fn peekAt(p: *Parser, k: usize) -> usize {
    if p.*.at + k >= p.*.length { return END }
    return @intCast(usize, sys.get8(p.*.pattern + p.*.at + k))
}

fn fold(c: usize) -> usize {
    if c >= 65 && c <= 90 { return c + 32 }
    return c
}

fn node(p: *Parser, kind: usize, a: usize, b: usize, c: usize) -> usize {
    const index = p.*.nodes.count / 4
    if !push(&p.*.nodes, kind) || !push(&p.*.nodes, a) || !push(&p.*.nodes, b) || !push(&p.*.nodes, c) {
        p.*.status = REG_ESPACE
        return 0
    }
    return index
}

fn kindOf(p: *Parser, n: usize) -> usize { return wordAt(&p.*.nodes, n * 4) }
fn fieldOf(p: *Parser, n: usize, field: usize) -> usize { return wordAt(&p.*.nodes, n * 4 + field) }

fn concatenate(p: *Parser, left: usize, right: usize) -> usize {
    if left == NONE { return right }
    return node(p, N_CAT, left, right, 0)
}

// --- Sets ------------------------------------------------------------------------

// A new empty set (32 bytes: four words of bits); its number.
fn newSet(p: *Parser) -> usize {
    const index = p.*.sets.count / 4
    var k: usize = 0
    while k < 4 {
        if !push(&p.*.sets, 0) {
            p.*.status = REG_ESPACE
            return 0
        }
        k += 1
    }
    return index
}

fn addToSet(p: *Parser, set: usize, c: usize) -> void {
    const slot = set * 4 + (c >> 6)
    const one: u64 = 1
    const bits = @intCast(u64, wordAt(&p.*.sets, slot)) | (one << @intCast(u6, c & 63))
    setWord(&p.*.sets, slot, @intCast(usize, bits))
}

fn inSet(sets: usize, set: usize, c: usize) -> bool {
    const bits = sys.get64(sets + (set * 4 + (c >> 6)) * 8)
    const one: u64 = 1
    return (bits & (one << @intCast(u6, c & 63))) != 0
}

fn isWordByte(c: usize) -> bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn isSpaceByte(c: usize) -> bool { return c == 32 || (c >= 9 && c <= 13) }

// The C locale's character classes: whether byte C is in the class whose
// name is at NAME (LENGTH bytes); CLASS answers 0 for no such class.
fn classNumber(name: usize, length: usize) -> usize {
    const text = sys.constBytes(name)[0..length]
    if sys.same(text, "alpha") { return 1 }
    if sys.same(text, "digit") { return 2 }
    if sys.same(text, "alnum") { return 3 }
    if sys.same(text, "upper") { return 4 }
    if sys.same(text, "lower") { return 5 }
    if sys.same(text, "space") { return 6 }
    if sys.same(text, "blank") { return 7 }
    if sys.same(text, "punct") { return 8 }
    if sys.same(text, "print") { return 9 }
    if sys.same(text, "graph") { return 10 }
    if sys.same(text, "cntrl") { return 11 }
    if sys.same(text, "xdigit") { return 12 }
    return 0
}

fn inClass(class: usize, c: usize) -> bool {
    const upper = c >= 65 && c <= 90
    const lower = c >= 97 && c <= 122
    const digit = c >= 48 && c <= 57
    if class == 1 { return upper || lower }
    if class == 2 { return digit }
    if class == 3 { return upper || lower || digit }
    if class == 4 { return upper }
    if class == 5 { return lower }
    if class == 6 { return isSpaceByte(c) }
    if class == 7 { return c == 32 || c == 9 }
    if class == 8 { return c > 32 && c < 127 && !(upper || lower || digit) }
    if class == 9 { return c >= 32 && c < 127 }
    if class == 10 { return c > 32 && c < 127 }
    if class == 11 { return c < 32 || c == 127 }
    if class == 12 { return digit || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) }
    return false
}

// What a set holds once its bracket expression is read: both cases of a
// letter under REG_ICASE, the complement for `[^`, never a newline in a
// complement under REG_NEWLINE.
fn finishSet(p: *Parser, set: usize, negate: bool) -> void {
    if p.*.icase {
        var c: usize = 65
        while c <= 90 {
            if inSet(p.*.sets.base, set, c) || inSet(p.*.sets.base, set, c + 32) {
                addToSet(p, set, c)
                addToSet(p, set, c + 32)
            }
            c += 1
        }
    }
    if negate {
        var k: usize = 0
        while k < 4 {
            setWord(&p.*.sets, set * 4 + k, ~wordAt(&p.*.sets, set * 4 + k))
            k += 1
        }
        if p.*.newline {
            const slot = set * 4
            const one: u64 = 1
            const bits = @intCast(u64, wordAt(&p.*.sets, slot)) & ~(one << 10)
            setWord(&p.*.sets, slot, @intCast(usize, bits))
        }
    }
}

// `[:name:]`, `[=c=]` or `[.c.]` after the `[` and the kind (at the
// name): the name's start and length, the parser past the closing `:]`;
// false (REG_EBRACK) when it is not closed.
fn bracketName(p: *Parser, kind: usize, start: *usize, length: *usize) -> bool {
    start.* = p.*.at
    while p.*.at + 1 < p.*.length {
        if peekAt(p, 0) == kind && peekAt(p, 1) == 93 {
            length.* = p.*.at - start.*
            p.*.at += 2
            return true
        }
        p.*.at += 1
    }
    p.*.status = REG_EBRACK
    return false
}

// One character of a bracket expression that may start or end a range:
// an ordinary byte or a collating symbol `[.c.]`; END (with the error
// set) for anything else.
fn rangePoint(p: *Parser) -> usize {
    const c = peekAt(p, 0)
    if c == END {
        p.*.status = REG_EBRACK
        return END
    }
    if c == 91 && peekAt(p, 1) == 46 {
        p.*.at += 2
        var start: usize = 0
        var length: usize = 0
        if !bracketName(p, 46, &start, &length) { return END }
        if length != 1 {
            p.*.status = REG_ECOLLATE
            return END
        }
        return @intCast(usize, sys.get8(p.*.pattern + start))
    }
    if c == 91 && (peekAt(p, 1) == 58 || peekAt(p, 1) == 61) {
        p.*.status = REG_ERANGE
        return END
    }
    p.*.at += 1
    return c
}

// A bracket expression, after its `[`.
fn bracket(p: *Parser) -> usize {
    const set = newSet(p)
    if p.*.status != 0 { return 0 }
    var negate = false
    if peekAt(p, 0) == 94 {
        negate = true
        p.*.at += 1
    }
    var first = true
    while true {
        const c = peekAt(p, 0)
        if c == END {
            p.*.status = REG_EBRACK
            return 0
        }
        if c == 93 && !first {
            p.*.at += 1
            break
        }
        first = false
        if c == 91 && (peekAt(p, 1) == 58 || peekAt(p, 1) == 61) {
            const kind = peekAt(p, 1)
            p.*.at += 2
            var start: usize = 0
            var length: usize = 0
            if !bracketName(p, kind, &start, &length) { return 0 }
            if kind == 58 {
                const class = classNumber(p.*.pattern + start, length)
                if class == 0 {
                    p.*.status = REG_ECTYPE
                    return 0
                }
                // Under REG_ICASE the cases are one class.
                const folded = if p.*.icase && (class == 4 || class == 5) { 1 } else { class }
                var b: usize = 0
                while b < 256 {
                    if inClass(folded, b) { addToSet(p, set, b) }
                    b += 1
                }
                if peekAt(p, 0) == 45 && peekAt(p, 1) != 93 && peekAt(p, 1) != END {
                    p.*.status = REG_ERANGE
                    return 0
                }
            } else {
                // An equivalence class: in the C locale, its one character.
                if length != 1 {
                    p.*.status = REG_ECOLLATE
                    return 0
                }
                addToSet(p, set, @intCast(usize, sys.get8(p.*.pattern + start)))
            }
            continue
        }
        const low = rangePoint(p)
        if p.*.status != 0 { return 0 }
        if peekAt(p, 0) == 45 && peekAt(p, 1) != 93 && peekAt(p, 1) != END {
            p.*.at += 1
            const high = rangePoint(p)
            if p.*.status != 0 { return 0 }
            if high < low {
                p.*.status = REG_ERANGE
                return 0
            }
            var b = low
            while b <= high {
                addToSet(p, set, b)
                b += 1
            }
            // A range cannot start where one ended (`[a-c-e]`).
            if peekAt(p, 0) == 45 && peekAt(p, 1) != 93 {
                p.*.status = REG_ERANGE
                return 0
            }
        } else {
            addToSet(p, set, low)
        }
    }
    finishSet(p, set, negate)
    return node(p, N_SET, set, 0, 0)
}

// The set of GNU's `\w` (`\W` negated) or `\s` (`\S`).
fn namedSet(p: *Parser, word: bool, negate: bool) -> usize {
    const set = newSet(p)
    if p.*.status != 0 { return 0 }
    var b: usize = 0
    while b < 256 {
        if (word && isWordByte(b)) || (!word && isSpaceByte(b)) { addToSet(p, set, b) }
        b += 1
    }
    finishSet(p, set, negate)
    return node(p, N_SET, set, 0, 0)
}

// --- The parser ------------------------------------------------------------------

fn isAlternation(p: *Parser) -> bool {
    if p.*.extended { return peekAt(p, 0) == 124 }
    return peekAt(p, 0) == 92 && peekAt(p, 1) == 124
}

fn isGroupEnd(p: *Parser) -> bool {
    if p.*.extended { return peekAt(p, 0) == 41 }
    return peekAt(p, 0) == 92 && peekAt(p, 1) == 41
}

// An escaped character after its backslash (both syntaxes): a
// back-reference, one of GNU's operators, or the character itself.
fn escaped(p: *Parser) -> usize {
    const c = peekAt(p, 0)
    if c == END {
        p.*.status = REG_EESCAPE
        return 0
    }
    p.*.at += 1
    if c >= 49 && c <= 57 {
        const group = c - 48
        const one: u64 = 1
        if group > p.*.groups || (p.*.closed & (one << @intCast(u6, group))) == 0 {
            p.*.status = REG_ESUBREG
            return 0
        }
        p.*.backrefs = true
        return node(p, N_BACKREF, group, 0, 0)
    }
    if c == 119 { return namedSet(p, true, false) }
    if c == 87 { return namedSet(p, true, true) }
    if c == 115 { return namedSet(p, false, false) }
    if c == 83 { return namedSet(p, false, true) }
    if c == 98 { return node(p, N_ASSERT, A_WORDB, 0, 0) }
    if c == 66 { return node(p, N_ASSERT, A_NWORDB, 0, 0) }
    if c == 60 { return node(p, N_ASSERT, A_WBEG, 0, 0) }
    if c == 62 { return node(p, N_ASSERT, A_WEND, 0, 0) }
    if c == 96 { return node(p, N_ASSERT, A_BUFBEG, 0, 0) }
    if c == 39 { return node(p, N_ASSERT, A_BUFEND, 0, 0) }
    return node(p, N_CHAR, if p.*.icase { fold(c) } else { c }, 0, 0)
}

// A group's inside and its end, after the opening `(` or `\(`.
fn group(p: *Parser, depth: usize) -> usize {
    p.*.groups += 1
    const number = p.*.groups
    const inside = alternation(p, depth + 1)
    if p.*.status != 0 { return 0 }
    if !isGroupEnd(p) {
        p.*.status = REG_EPAREN
        return 0
    }
    p.*.at += if p.*.extended { 1 } else { 2 }
    if number < 64 {
        const one: u64 = 1
        p.*.closed = p.*.closed | (one << @intCast(u6, number))
    }
    return node(p, N_GROUP, inside, number, 0)
}

// One atom: AT_START when it begins an expression, a group or an
// alternative (where basic expressions take `*` and `^` otherwise).
fn atom(p: *Parser, atStart: bool, depth: usize) -> usize {
    const c = peekAt(p, 0)
    p.*.at += 1
    if c == 46 { return node(p, N_ANY, 0, 0, 0) }
    if c == 91 { return bracket(p) }
    if p.*.extended {
        if c == 40 { return group(p, depth) }
        if c == 42 || c == 43 || c == 63 || c == 123 {
            p.*.status = REG_BADRPT
            return 0
        }
        if c == 94 { return node(p, N_ASSERT, A_BOL, 0, 0) }
        if c == 36 { return node(p, N_ASSERT, A_EOL, 0, 0) }
        if c == 92 { return escaped(p) }
        return node(p, N_CHAR, if p.*.icase { fold(c) } else { c }, 0, 0)
    }
    if c == 92 {
        const next = peekAt(p, 0)
        if next == 40 {
            p.*.at += 1
            return group(p, depth)
        }
        if next == 41 {
            p.*.status = REG_EPAREN
            return 0
        }
        if next == 123 {
            p.*.status = REG_BADRPT
            return 0
        }
        return escaped(p)
    }
    if c == 94 && atStart { return node(p, N_ASSERT, A_BOL, 0, 0) }
    if c == 36 {
        // An anchor at the end of the expression, a group or an alternative.
        const next = peekAt(p, 0)
        if next == END || (next == 92 && (peekAt(p, 1) == 41 || peekAt(p, 1) == 124)) { return node(p, N_ASSERT, A_EOL, 0, 0) }
    }
    return node(p, N_CHAR, if p.*.icase { fold(c) } else { c }, 0, 0)
}

fn decimal(p: *Parser, value: *usize) -> bool {
    var any = false
    var result: usize = 0
    while peekAt(p, 0) >= 48 && peekAt(p, 0) <= 57 {
        if result <= DUP_MAX { result = result * 10 + (peekAt(p, 0) - 48) }
        p.*.at += 1
        any = true
    }
    value.* = result
    return any
}

// A bound's `m`, `m,`, `m,n` or `,n` and its end, after the `{` or `\{`.
fn bound(p: *Parser, least: *usize, most: *usize) -> bool {
    var low: usize = 0
    var high: usize = 0
    const hasLow = decimal(p, &low)
    var hasHigh = false
    var comma = false
    if peekAt(p, 0) == 44 {
        comma = true
        p.*.at += 1
        hasHigh = decimal(p, &high)
    }
    const closes = if p.*.extended { peekAt(p, 0) == 125 } else { peekAt(p, 0) == 92 && peekAt(p, 1) == 125 }
    if !closes {
        p.*.status = if p.*.at >= p.*.length { REG_EBRACE } else { REG_BADBR }
        return false
    }
    p.*.at += if p.*.extended { 1 } else { 2 }
    if !hasLow && !comma {
        p.*.status = REG_BADBR
        return false
    }
    least.* = low
    most.* = if !comma { low } else if hasHigh { high } else { INFINITE }
    if low > DUP_MAX || (most.* != INFINITE && (most.* > DUP_MAX || most.* < low)) {
        p.*.status = REG_BADBR
        return false
    }
    return true
}

// An atom and the repetitions after it.
fn piece(p: *Parser, atStart: bool, depth: usize) -> usize {
    var result = atom(p, atStart, depth)
    // (In a basic expression a `*` after a leading `^` is the next atom,
    // an ordinary character.)
    if !p.*.extended && p.*.status == 0 && kindOf(p, result) == N_ASSERT && fieldOf(p, result, 1) == A_BOL { return result }
    while p.*.status == 0 {
        const c = peekAt(p, 0)
        var least: usize = 0
        var most: usize = INFINITE
        if c == 42 {
            p.*.at += 1
        } else if p.*.extended && c == 43 {
            p.*.at += 1
            least = 1
        } else if p.*.extended && c == 63 {
            p.*.at += 1
            most = 1
        } else if p.*.extended && c == 123 {
            p.*.at += 1
            if !bound(p, &least, &most) { return 0 }
        } else if !p.*.extended && c == 92 && peekAt(p, 1) == 43 {
            p.*.at += 2
            least = 1
        } else if !p.*.extended && c == 92 && peekAt(p, 1) == 63 {
            p.*.at += 2
            most = 1
        } else if !p.*.extended && c == 92 && peekAt(p, 1) == 123 {
            p.*.at += 2
            if !bound(p, &least, &most) { return 0 }
        } else {
            break
        }
        result = node(p, N_REPEAT, result, least, most)
    }
    return result
}

// A sequence of pieces, up to an alternative's or a group's end.
fn branch(p: *Parser, depth: usize) -> usize {
    var result = NONE
    // Whether only an anchor `^` came before (a basic expression's `*`
    // after it is an ordinary character).
    var afterAnchor = false
    while p.*.status == 0 && peekAt(p, 0) != END && !isAlternation(p) {
        if depth > 0 && isGroupEnd(p) { break }
        const atStart = result == NONE || afterAnchor
        const next = piece(p, atStart, depth)
        if p.*.status != 0 { return 0 }
        afterAnchor = result == NONE && kindOf(p, next) == N_ASSERT && fieldOf(p, next, 1) == A_BOL
        result = concatenate(p, result, next)
    }
    if result == NONE { return node(p, N_EMPTY, 0, 0, 0) }
    return result
}

// Alternatives. A back-reference may not name a group of an alternative
// before its own (glibc's rule: each alternative starts with the groups
// closed before the first; all are closed after the last).
fn alternation(p: *Parser, depth: usize) -> usize {
    const initial = p.*.closed
    var left = branch(p, depth)
    while p.*.status == 0 && isAlternation(p) {
        p.*.at += if p.*.extended { 1 } else { 2 }
        const accumulated = p.*.closed
        p.*.closed = initial
        const right = branch(p, depth)
        if p.*.status != 0 { return 0 }
        p.*.closed = p.*.closed | accumulated
        left = node(p, N_ALT, left, right, 0)
    }
    return left
}

// --- The compiler ----------------------------------------------------------------

const Compiler = struct {
    code: Words
    loops: usize
    status: i32
}

fn emit(c: *Compiler, operation: usize, a: usize, b: usize) -> usize {
    const index = c.*.code.count / 3
    if index >= MAX_CODE {
        if c.*.status == 0 { c.*.status = REG_ESIZE }
        return 0
    }
    if !push(&c.*.code, operation) || !push(&c.*.code, a) || !push(&c.*.code, b) {
        c.*.status = REG_ESPACE
        return 0
    }
    return index
}

fn here(c: *Compiler) -> usize { return c.*.code.count / 3 }
fn patch(c: *Compiler, instruction: usize, field: usize, value: usize) -> void {
    if c.*.status == 0 { setWord(&c.*.code, instruction * 3 + field, value) }
}

fn compileNode(p: *Parser, c: *Compiler, n: usize) -> void {
    if c.*.status != 0 { return }
    const kind = kindOf(p, n)
    const a = fieldOf(p, n, 1)
    const b = fieldOf(p, n, 2)
    if kind == N_CHAR {
        _ = emit(c, I_CHAR, a, 0)
    } else if kind == N_ANY {
        _ = emit(c, I_ANY, 0, 0)
    } else if kind == N_SET {
        _ = emit(c, I_SET, a, 0)
    } else if kind == N_CAT {
        compileNode(p, c, a)
        compileNode(p, c, b)
    } else if kind == N_ALT {
        const split = emit(c, I_SPLIT, 0, 0)
        patch(c, split, 1, split + 1)
        compileNode(p, c, a)
        const jump = emit(c, I_JMP, 0, 0)
        patch(c, split, 2, here(c))
        compileNode(p, c, b)
        patch(c, jump, 1, here(c))
    } else if kind == N_GROUP {
        _ = emit(c, I_SAVE, b * 2, 0)
        compileNode(p, c, a)
        _ = emit(c, I_SAVE, b * 2 + 1, 0)
    } else if kind == N_ASSERT {
        _ = emit(c, I_ASSERT, a, 0)
    } else if kind == N_BACKREF {
        _ = emit(c, I_BACKREF, a, 0)
    } else if kind == N_REPEAT {
        const most = fieldOf(p, n, 3)
        var k: usize = 0
        while k < b && c.*.status == 0 {
            compileNode(p, c, a)
            k += 1
        }
        if most == INFINITE {
            // Again and again while each pass matches something: a pass
            // that matched nothing would only come back to here. When it
            // is the first of all (no copy before the loop), it ends the
            // loop with what its groups matched, as glibc keeps them
            // (`(a*)*` on "b" has its group at 0..0); after a pass that
            // matched something it is not taken (`(a*)+` on "aab" keeps
            // its group at 0..2).
            const loop = c.*.loops
            c.*.loops += 1
            _ = emit(c, I_ENTER, loop, 0)
            const split = emit(c, I_SPLIT, 0, 0)
            patch(c, split, 1, split + 1)
            _ = emit(c, I_MARK, loop, 0)
            compileNode(p, c, a)
            const check = emit(c, I_CHECK, loop, 0)
            _ = emit(c, I_JMP, split, 0)
            patch(c, split, 2, here(c))
            if b == 0 { patch(c, check, 2, here(c)) }
        } else {
            // Each optional pass may be left for the end.
            var splits = emptyWords()
            while k < most && c.*.status == 0 {
                const split = emit(c, I_SPLIT, 0, 0)
                patch(c, split, 1, split + 1)
                if !push(&splits, split) { c.*.status = REG_ESPACE }
                compileNode(p, c, a)
                k += 1
            }
            const end = here(c)
            var s: usize = 0
            while s < splits.count {
                patch(c, wordAt(&splits, s), 2, end)
                s += 1
            }
            heap.release(splits.base)
        }
    }
}

// The compiled expression, at regex_t's first word: its program, its sets,
// what regexec needs to know.
const P_CODE: usize = 0
const P_COUNT: usize = 8
const P_SETS: usize = 16
const P_GROUPS: usize = 24
const P_FLAGS: usize = 32
const P_LOOPS: usize = 40
const P_BACKREFS: usize = 48
const P_SIZE: usize = 56

const RE_NSUB: usize = 48

pub export fn regcomp(preg: usize, pattern: usize, flags: i32) -> i32 {
    sys.fill(preg, 0, 64)
    var p = Parser.{
        .pattern = pattern,
        .length = sys.length(pattern),
        .at = 0,
        .extended = (flags & REG_EXTENDED) != 0,
        .icase = (flags & REG_ICASE) != 0,
        .newline = (flags & REG_NEWLINE) != 0,
        .nodes = emptyWords(),
        .sets = emptyWords(),
        .groups = 0,
        .closed = 0,
        .backrefs = false,
        .status = 0,
    }
    const root = alternation(&p, 0)
    if p.status == 0 && p.at < p.length { p.status = if p.extended { REG_BADPAT } else { REG_EPAREN } }
    var c = Compiler.{ .code = emptyWords(), .loops = 0, .status = 0 }
    if p.status == 0 {
        compileNode(&p, &c, root)
        _ = emit(&c, I_MATCH, 0, 0)
    }
    heap.release(p.nodes.base)
    var status = p.status
    if status == 0 { status = c.status }
    const program = if status == 0 { heap.allocate(P_SIZE, 16) } else { 0 }
    if status == 0 && program == 0 { status = REG_ESPACE }
    if status != 0 {
        heap.release(c.code.base)
        heap.release(p.sets.base)
        return status
    }
    sys.putPointer(program + P_CODE, c.code.base)
    sys.putPointer(program + P_COUNT, c.code.count / 3)
    sys.putPointer(program + P_SETS, p.sets.base)
    sys.putPointer(program + P_GROUPS, p.groups)
    sys.putPointer(program + P_FLAGS, @intCast(usize, flags))
    sys.putPointer(program + P_LOOPS, c.loops)
    sys.putPointer(program + P_BACKREFS, if p.backrefs { 1 } else { 0 })
    sys.putPointer(preg, program)
    sys.putPointer(preg + RE_NSUB, p.groups)
    return 0
}

pub export fn regfree(preg: usize) -> void {
    const program = sys.getPointer(preg)
    if program == 0 { return }
    heap.release(sys.getPointer(program + P_CODE))
    heap.release(sys.getPointer(program + P_SETS))
    heap.release(program)
    sys.putPointer(preg, 0)
}

// --- The machine -----------------------------------------------------------------

// What the backtracking stack holds (three words each): a path to try
// (instruction, position), or a group boundary or a loop's start to put
// back as it was.
const S_BRANCH: usize = 0
const S_SLOT: usize = 1
const S_MARK: usize = 2

const Machine = struct {
    code: usize
    count: usize
    sets: usize
    text: usize
    begin: usize
    end: usize
    icase: bool
    newline: bool
    notbol: bool
    noteol: bool
    // The group boundaries of this path, and of the best match so far
    // (2 per group, the whole match first); for each loop, where its pass
    // began and how many passes it made.
    slots: usize
    best: usize
    slotCount: usize
    marks: usize
    stack: Words
    // The states tried (a bit per instruction and position), 0 for none.
    memo: usize
    found: bool
    firstOnly: bool
    failed: bool
}

fn textAt(m: *Machine, position: usize) -> usize { return @intCast(usize, sys.get8(m.*.text + position)) }

fn isWordAt(m: *Machine, position: usize) -> bool {
    return position >= m.*.begin && position < m.*.end && isWordByte(textAt(m, position))
}

fn holds(m: *Machine, assertion: usize, position: usize) -> bool {
    if assertion == A_BOL {
        if position == m.*.begin && !m.*.notbol { return true }
        return m.*.newline && position > m.*.begin && textAt(m, position - 1) == 10
    }
    if assertion == A_EOL {
        if position == m.*.end && !m.*.noteol { return true }
        return m.*.newline && position < m.*.end && textAt(m, position) == 10
    }
    const before = position > m.*.begin && isWordAt(m, position - 1)
    const after = isWordAt(m, position)
    if assertion == A_WORDB { return before != after }
    if assertion == A_NWORDB { return before == after }
    if assertion == A_WBEG { return !before && after }
    if assertion == A_WEND { return before && !after }
    if assertion == A_BUFBEG { return position == m.*.begin }
    return position == m.*.end
}

fn signed(value: usize) -> isize { return @bitCast(isize, value) }

// Whether this path's groups are better than the best match's of the same
// length: leftmost, then longest, group by group.
fn betterGroups(m: *Machine) -> bool {
    var slot: usize = 2
    while slot < m.*.slotCount {
        const start = signed(sys.getPointer(m.*.slots + slot * 8))
        const bestStart = signed(sys.getPointer(m.*.best + slot * 8))
        if start != bestStart {
            if start < 0 { return false }
            return bestStart < 0 || start < bestStart
        }
        const end = signed(sys.getPointer(m.*.slots + slot * 8 + 8))
        const bestEnd = signed(sys.getPointer(m.*.best + slot * 8 + 8))
        if end != bestEnd { return end > bestEnd }
        slot += 2
    }
    return false
}

fn save(m: *Machine, kind: usize, a: usize, b: usize) -> bool {
    if !push(&m.*.stack, kind) || !push(&m.*.stack, a) || !push(&m.*.stack, b) {
        m.*.failed = true
        return false
    }
    return true
}

// Every path from START: the best match among them kept in `best`.
fn run(m: *Machine, start: usize) -> void {
    var slot: usize = 0
    while slot < m.*.slotCount {
        sys.putPointer(m.*.slots + slot * 8, UNSET)
        slot += 1
    }
    sys.putPointer(m.*.slots, start)
    m.*.stack.count = 0
    const width = m.*.end - m.*.begin + 1
    var pc: usize = 0
    var position = start
    while true {
        var ok = true
        if m.*.memo != 0 {
            const bit = pc * width + (position - m.*.begin)
            const address = m.*.memo + (bit >> 3)
            const one: usize = 1
            const mask = one << @intCast(u6, bit & 7)
            const byte = @intCast(usize, sys.get8(address))
            if (byte & mask) != 0 {
                ok = false
            } else {
                sys.put8(address, @intCast(u8, (byte | mask) & 255))
            }
        }
        if ok {
            const at = m.*.code + pc * 24
            const operation = sys.getPointer(at)
            const a = sys.getPointer(at + 8)
            if operation == I_CHAR {
                if position < m.*.end && (if m.*.icase { fold(textAt(m, position)) } else { textAt(m, position) }) == a {
                    pc += 1
                    position += 1
                    continue
                }
            } else if operation == I_ANY {
                if position < m.*.end && !(m.*.newline && textAt(m, position) == 10) {
                    pc += 1
                    position += 1
                    continue
                }
            } else if operation == I_SET {
                if position < m.*.end && inSet(m.*.sets, a, textAt(m, position)) {
                    pc += 1
                    position += 1
                    continue
                }
            } else if operation == I_SPLIT {
                if !save(m, S_BRANCH, sys.getPointer(at + 16), position) { return }
                pc = a
                continue
            } else if operation == I_JMP {
                pc = a
                continue
            } else if operation == I_SAVE {
                if !save(m, S_SLOT, a, sys.getPointer(m.*.slots + a * 8)) { return }
                sys.putPointer(m.*.slots + a * 8, position)
                pc += 1
                continue
            } else if operation == I_ENTER {
                if !save(m, S_MARK, a * 2 + 1, sys.getPointer(m.*.marks + a * 16 + 8)) { return }
                sys.putPointer(m.*.marks + a * 16 + 8, 0)
                pc += 1
                continue
            } else if operation == I_MARK {
                if !save(m, S_MARK, a * 2, sys.getPointer(m.*.marks + a * 16)) { return }
                sys.putPointer(m.*.marks + a * 16, position)
                pc += 1
                continue
            } else if operation == I_CHECK {
                const passes = sys.getPointer(m.*.marks + a * 16 + 8)
                if position != sys.getPointer(m.*.marks + a * 16) {
                    if !save(m, S_MARK, a * 2 + 1, passes) { return }
                    sys.putPointer(m.*.marks + a * 16 + 8, passes + 1)
                    pc += 1
                    continue
                }
                const exit = sys.getPointer(at + 16)
                if exit != 0 && passes == 0 {
                    pc = exit
                    continue
                }
            } else if operation == I_ASSERT {
                if holds(m, a, position) {
                    pc += 1
                    continue
                }
            } else if operation == I_BACKREF {
                const from = sys.getPointer(m.*.slots + a * 16)
                const to = sys.getPointer(m.*.slots + a * 16 + 8)
                if from != UNSET && to != UNSET && to >= from && position + (to - from) <= m.*.end {
                    var k: usize = 0
                    var same = true
                    while k < to - from && same {
                        const x = textAt(m, from + k)
                        const y = textAt(m, position + k)
                        same = if m.*.icase { fold(x) == fold(y) } else { x == y }
                        k += 1
                    }
                    if same {
                        pc += 1
                        position += to - from
                        continue
                    }
                }
            } else if operation == I_MATCH {
                const bestEnd = sys.getPointer(m.*.best + 8)
                if !m.*.found || position > bestEnd || (position == bestEnd && betterGroups(m)) {
                    sys.putPointer(m.*.slots + 8, position)
                    sys.copy(m.*.best, m.*.slots, m.*.slotCount * 8)
                }
                m.*.found = true
                if m.*.firstOnly { return }
            }
        }
        // This path ends here: the next one from the stack, the boundaries
        // put back as they were where it begins.
        var resumed = false
        while m.*.stack.count > 0 && !resumed {
            m.*.stack.count -= 3
            const entry = m.*.stack.base + m.*.stack.count * 8
            const kind = sys.getPointer(entry)
            const a = sys.getPointer(entry + 8)
            const b = sys.getPointer(entry + 16)
            if kind == S_BRANCH {
                pc = a
                position = b
                resumed = true
            } else if kind == S_SLOT {
                sys.putPointer(m.*.slots + a * 8, b)
            } else {
                sys.putPointer(m.*.marks + a * 8, b)
            }
        }
        if !resumed { return }
    }
}

pub export fn regexec(preg: usize, string: usize, nmatch: usize, pmatch: usize, flags: i32) -> i32 {
    const program = sys.getPointer(preg)
    if program == 0 { return REG_BADPAT }
    const compiled = @intCast(i32, sys.getPointer(program + P_FLAGS))
    const groups = sys.getPointer(program + P_GROUPS)
    var begin: usize = 0
    var end: usize = 0
    if (flags & REG_STARTEND) != 0 && pmatch != 0 {
        begin = sys.int(sys.getI32(pmatch))
        end = sys.int(sys.getI32(pmatch + 4))
        if begin > end { return REG_NOMATCH }
    } else {
        end = sys.length(string)
    }
    const nosub = (compiled & REG_NOSUB) != 0 || nmatch == 0
    var m = Machine.{
        .code = sys.getPointer(program + P_CODE),
        .count = sys.getPointer(program + P_COUNT),
        .sets = sys.getPointer(program + P_SETS),
        .text = string,
        .begin = begin,
        .end = end,
        .icase = (compiled & REG_ICASE) != 0,
        .newline = (compiled & REG_NEWLINE) != 0,
        .notbol = (flags & REG_NOTBOL) != 0,
        .noteol = (flags & REG_NOTEOL) != 0,
        .slots = 0,
        .best = 0,
        .slotCount = (groups + 1) * 2,
        .marks = 0,
        .stack = emptyWords(),
        .memo = 0,
        .found = false,
        .firstOnly = nosub,
        .failed = false,
    }
    const loops = sys.getPointer(program + P_LOOPS)
    m.slots = heap.allocate(m.slotCount * 16 + loops * 16 + 8, 16)
    if m.slots == 0 { return REG_ESPACE }
    m.best = m.slots + m.slotCount * 8
    m.marks = m.best + m.slotCount * 8
    sys.putPointer(m.best + 8, 0)
    if sys.getPointer(program + P_BACKREFS) == 0 {
        // (Without the memory a search can take exponential time: so a
        // text too long for it is searched anyway, more slowly.)
        const bytes = (m.count * (end - begin + 1)) / 8 + 1
        if bytes <= MAX_MEMO {
            m.memo = heap.allocate(bytes, 16)
            if m.memo != 0 { sys.fill(m.memo, 0, bytes) }
        }
    }
    // The leftmost start with a match; a pattern anchored at the text's
    // start (without REG_NEWLINE) can only match there.
    const first = m.code + 0
    const anchored = sys.getPointer(first) == I_ASSERT && sys.getPointer(first + 8) == A_BOL && !m.newline
    var start = begin
    while start <= end && !m.found && !m.failed {
        run(&m, start)
        if anchored { break }
        start += 1
    }
    var status: i32 = REG_NOMATCH
    if m.failed {
        status = REG_ESPACE
    } else if m.found {
        status = 0
        if !((compiled & REG_NOSUB) != 0) {
            var index: usize = 0
            while index < nmatch {
                var from = UNSET
                var to = UNSET
                if index <= groups {
                    from = sys.getPointer(m.best + index * 16)
                    to = sys.getPointer(m.best + index * 16 + 8)
                }
                if from == UNSET || to == UNSET {
                    sys.putI32(pmatch + index * 8, -1)
                    sys.putI32(pmatch + index * 8 + 4, -1)
                } else {
                    sys.putI32(pmatch + index * 8, @intCast(i32, from))
                    sys.putI32(pmatch + index * 8 + 4, @intCast(i32, to))
                }
                index += 1
            }
        }
    }
    heap.release(m.memo)
    heap.release(m.stack.base)
    heap.release(m.slots)
    return status
}

// glibc's messages for the error codes.
fn message(code: i32) -> []const u8 {
    if code == 0 { return "Success" }
    if code == 1 { return "No match" }
    if code == 2 { return "Invalid regular expression" }
    if code == 3 { return "Invalid collation character" }
    if code == 4 { return "Invalid character class name" }
    if code == 5 { return "Trailing backslash" }
    if code == 6 { return "Invalid back reference" }
    if code == 7 { return "Unmatched [, [^, [:, [., or [=" }
    if code == 8 { return "Unmatched ( or \\(" }
    if code == 9 { return "Unmatched \\{" }
    if code == 10 { return "Invalid content of \\{\\}" }
    if code == 11 { return "Invalid range end" }
    if code == 12 { return "Memory exhausted" }
    if code == 13 { return "Invalid preceding regular expression" }
    if code == 14 { return "Premature end of regular expression" }
    if code == 15 { return "Regular expression too big" }
    if code == 16 { return "Unmatched ) or \\)" }
    return "Success"
}

pub export fn regerror(code: i32, preg: usize, buffer: usize, size: usize) -> usize {
    const text = message(code)
    if size > 0 {
        const count = if text.length < size { text.length } else { size - 1 }
        sys.copy(buffer, sys.literal(text), count)
        sys.put8(buffer + count, 0)
    }
    return text.length + 1
}
