// jmorecfg.h
// mlx-libjpeg: libjpeg's basic types for x86_64 Linux (JSAMPLE, JCOEF,
// JOCTET, JDIMENSION, boolean...), its limits, the declaration macros
// its own sources and old programs use, and the byte order of the
// extended RGB colour spaces.
const c_function_pointers = true
const c_macros = "#ifndef FALSE\n#define FALSE 0\n#endif\n#ifndef TRUE\n#define TRUE 1\n#endif\n#ifndef FAR\n#define FAR\n#endif\n#define METHODDEF(type) static type\n#define LOCAL(type) static type\n#define GLOBAL(type) type\n#define EXTERN(type) extern type\n#define JMETHOD(type, methodname, arglist) type (*methodname) arglist\n#define GETJSAMPLE(value) ((int)(value))\n#define GETJOCTET(value) (value)"
const conf = @import("./jconfig.mlx")

// (Mlx names of C types: C has them as they are.)
pub const c_char = u8
pub const c_uchar = u8
pub const c_int = i32
pub const c_uint = u32
pub const c_long = i64
pub const c_ulong = u64
pub const c_double = f64
// C tokens a macro takes or stands for.
pub const c_tokens = usize

pub const JMORECFG_H: c_tokens = ""

pub const JSAMPLE = c_uchar
pub const MAXJSAMPLE: c_int = 255
pub const CENTERJSAMPLE: c_int = 128
pub const JCOEF = i16
pub const JOCTET = c_uchar
pub const UINT8 = c_uchar
pub const UINT16 = u16
pub const INT16 = i16
pub const INT32 = c_long
pub const JDIMENSION = c_uint
pub const JPEG_MAX_DIMENSION: c_long = 65500
pub const boolean = c_int

// The most components a frame may have.
pub const MAX_COMPONENTS: c_int = 10

// Where each colour is in a pixel of each extended RGB space
// (JCS_EXT_RGB ...), and of JCS_RGB.
pub const RGB_RED: c_int = 0
pub const RGB_GREEN: c_int = 1
pub const RGB_BLUE: c_int = 2
pub const RGB_PIXELSIZE: c_int = 3
pub const JPEG_NUMCS: c_int = 17
pub const EXT_RGB_RED: c_int = 0
pub const EXT_RGB_GREEN: c_int = 1
pub const EXT_RGB_BLUE: c_int = 2
pub const EXT_RGB_PIXELSIZE: c_int = 3
pub const EXT_RGBX_RED: c_int = 0
pub const EXT_RGBX_GREEN: c_int = 1
pub const EXT_RGBX_BLUE: c_int = 2
pub const EXT_RGBX_PIXELSIZE: c_int = 4
pub const EXT_BGR_RED: c_int = 2
pub const EXT_BGR_GREEN: c_int = 1
pub const EXT_BGR_BLUE: c_int = 0
pub const EXT_BGR_PIXELSIZE: c_int = 3
pub const EXT_BGRX_RED: c_int = 2
pub const EXT_BGRX_GREEN: c_int = 1
pub const EXT_BGRX_BLUE: c_int = 0
pub const EXT_BGRX_PIXELSIZE: c_int = 4
pub const EXT_XBGR_RED: c_int = 3
pub const EXT_XBGR_GREEN: c_int = 2
pub const EXT_XBGR_BLUE: c_int = 1
pub const EXT_XBGR_PIXELSIZE: c_int = 4
pub const EXT_XRGB_RED: c_int = 1
pub const EXT_XRGB_GREEN: c_int = 2
pub const EXT_XRGB_BLUE: c_int = 3
pub const EXT_XRGB_PIXELSIZE: c_int = 4
