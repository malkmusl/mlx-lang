// jpeglib.h
// mlx-libjpeg: libjpeg's C API (the libjpeg 8 API of libjpeg-turbo
// 2.1.5, with its extensions: the extended RGB colour spaces,
// jpeg_skip_scanlines, jpeg_crop_scanline, the memory source and
// destination), implemented in Mlx by libmlxjpeg.so (compiler/libc/jpeg,
// over std.jpeg): the decompressor WebKit's JPEG decoder drives with a
// suspending data source, buffered-image output of progressive files,
// saved markers (EXIF, ICC), setjmp-based errors through the error
// manager, and the compressor Skia's JPEG encoder uses.
const c_function_pointers = true
const c_system_headers = "stdio.h stddef.h"
const c_macros = "#define jpeg_create_compress(cinfo) jpeg_CreateCompress((cinfo), JPEG_LIB_VERSION, (size_t)sizeof(struct jpeg_compress_struct))\n#define jpeg_create_decompress(cinfo) jpeg_CreateDecompress((cinfo), JPEG_LIB_VERSION, (size_t)sizeof(struct jpeg_decompress_struct))"
const conf = @import("./jconfig.mlx")
const more = @import("./jmorecfg.mlx")

const c_char = more.c_char
const c_uchar = more.c_uchar
const c_int = more.c_int
const c_uint = more.c_uint
const c_long = more.c_long
const c_ulong = more.c_ulong
const c_double = more.c_double
const c_tokens = more.c_tokens
const JSAMPLE = more.JSAMPLE
const JCOEF = more.JCOEF
const JOCTET = more.JOCTET
const UINT8 = more.UINT8
const UINT16 = more.UINT16
const JDIMENSION = more.JDIMENSION
const boolean = more.boolean

pub const JPEGLIB_H: c_tokens = ""

// The extended RGB colour spaces (JCS_EXT_*), with alpha ones.
pub const JCS_EXTENSIONS: c_int = 1
pub const JCS_ALPHA_EXTENSIONS: c_int = 1

pub const DCTSIZE: c_int = 8
pub const DCTSIZE2: c_int = 64
pub const NUM_QUANT_TBLS: c_int = 4
pub const NUM_HUFF_TBLS: c_int = 4
pub const NUM_ARITH_TBLS: c_int = 16
pub const MAX_COMPS_IN_SCAN: c_int = 4
pub const MAX_SAMP_FACTOR: c_int = 4
pub const C_MAX_BLOCKS_IN_MCU: c_int = 10
pub const D_MAX_BLOCKS_IN_MCU: c_int = 10

// Rows of samples, images of rows, and blocks of coefficients.
pub const JSAMPROW = *JSAMPLE
pub const JSAMPARRAY = *JSAMPROW
pub const JSAMPIMAGE = *JSAMPARRAY
pub const JBLOCK = [64]JCOEF
pub const JBLOCKROW = *JBLOCK
pub const JBLOCKARRAY = *JBLOCKROW
pub const JBLOCKIMAGE = *JBLOCKARRAY
pub const JCOEFPTR = *JCOEF

// A quantization table, in natural order.
pub const JQUANT_TBL = struct {
    quantval: [64]UINT16
    sent_table: boolean
}

// A Huffman table: the number of codes of each length, the symbols.
pub const JHUFF_TBL = struct {
    bits: [17]UINT8
    huffval: [256]UINT8
    sent_table: boolean
}

// A component of the image.
pub const jpeg_component_info = struct {
    component_id: c_int
    component_index: c_int
    h_samp_factor: c_int
    v_samp_factor: c_int
    quant_tbl_no: c_int
    dc_tbl_no: c_int
    ac_tbl_no: c_int
    width_in_blocks: JDIMENSION
    height_in_blocks: JDIMENSION
    DCT_h_scaled_size: c_int
    DCT_v_scaled_size: c_int
    downsampled_width: JDIMENSION
    downsampled_height: JDIMENSION
    component_needed: boolean
    MCU_width: c_int
    MCU_height: c_int
    MCU_blocks: c_int
    MCU_sample_width: c_int
    last_col_width: c_int
    last_row_height: c_int
    quant_table: ?*JQUANT_TBL
    dct_table: ?*anyopaque
}

// One scan of a compressor's script.
pub const jpeg_scan_info = struct {
    comps_in_scan: c_int
    component_index: [4]c_int
    Ss: c_int
    Se: c_int
    Ah: c_int
    Al: c_int
}

// A saved marker (jpeg_save_markers): the list's next, the marker, its
// length, how much of it is kept, the bytes kept.
pub const jpeg_marker_struct = struct {
    next: ?*jpeg_marker_struct
    marker: UINT8
    original_length: c_uint
    data_length: c_uint
    data: *JOCTET
}
pub const jpeg_saved_marker_ptr = *jpeg_marker_struct

pub const J_COLOR_SPACE = enum(c_int) {
    JCS_UNKNOWN = 0,
    JCS_GRAYSCALE = 1,
    JCS_RGB = 2,
    JCS_YCbCr = 3,
    JCS_CMYK = 4,
    JCS_YCCK = 5,
    JCS_EXT_RGB = 6,
    JCS_EXT_RGBX = 7,
    JCS_EXT_BGR = 8,
    JCS_EXT_BGRX = 9,
    JCS_EXT_XBGR = 10,
    JCS_EXT_XRGB = 11,
    JCS_EXT_RGBA = 12,
    JCS_EXT_BGRA = 13,
    JCS_EXT_ABGR = 14,
    JCS_EXT_ARGB = 15,
    JCS_RGB565 = 16,
}

pub const J_DCT_METHOD = enum(c_int) {
    JDCT_ISLOW = 0,
    JDCT_IFAST = 1,
    JDCT_FLOAT = 2,
}
pub const JDCT_DEFAULT: c_tokens = "JDCT_ISLOW"
pub const JDCT_FASTEST: c_tokens = "JDCT_IFAST"

pub const J_DITHER_MODE = enum(c_int) {
    JDITHER_NONE = 0,
    JDITHER_ORDERED = 1,
    JDITHER_FS = 2,
}

// The library's own parts of a compressor and decompressor.
pub const jpeg_comp_master = struct {}
pub const jpeg_c_main_controller = struct {}
pub const jpeg_c_prep_controller = struct {}
pub const jpeg_c_coef_controller = struct {}
pub const jpeg_marker_writer = struct {}
pub const jpeg_color_converter = struct {}
pub const jpeg_downsampler = struct {}
pub const jpeg_forward_dct = struct {}
pub const jpeg_entropy_encoder = struct {}
pub const jpeg_decomp_master = struct {}
pub const jpeg_d_main_controller = struct {}
pub const jpeg_d_coef_controller = struct {}
pub const jpeg_d_post_controller = struct {}
pub const jpeg_input_controller = struct {}
pub const jpeg_marker_reader = struct {}
pub const jpeg_entropy_decoder = struct {}
pub const jpeg_inverse_dct = struct {}
pub const jpeg_upsampler = struct {}
pub const jpeg_color_deconverter = struct {}
pub const jpeg_color_quantizer = struct {}
pub const jvirt_sarray_control = struct {}
pub const jvirt_barray_control = struct {}
pub const jvirt_sarray_ptr = *jvirt_sarray_control
pub const jvirt_barray_ptr = *jvirt_barray_control

// What a compressor and a decompressor begin with.
pub const jpeg_common_struct = struct {
    err: ?*jpeg_error_mgr
    mem: ?*jpeg_memory_mgr
    progress: ?*jpeg_progress_mgr
    client_data: ?*anyopaque
    is_decompressor: boolean
    global_state: c_int
}
pub const j_common_ptr = *jpeg_common_struct
pub const j_compress_ptr = *jpeg_compress_struct
pub const j_decompress_ptr = *jpeg_decompress_struct

pub const jpeg_compress_struct = struct {
    err: ?*jpeg_error_mgr
    mem: ?*jpeg_memory_mgr
    progress: ?*jpeg_progress_mgr
    client_data: ?*anyopaque
    is_decompressor: boolean
    global_state: c_int
    dest: ?*jpeg_destination_mgr
    image_width: JDIMENSION
    image_height: JDIMENSION
    input_components: c_int
    in_color_space: J_COLOR_SPACE
    input_gamma: c_double
    scale_num: c_uint
    scale_denom: c_uint
    jpeg_width: JDIMENSION
    jpeg_height: JDIMENSION
    data_precision: c_int
    num_components: c_int
    jpeg_color_space: J_COLOR_SPACE
    comp_info: ?*jpeg_component_info
    quant_tbl_ptrs: [4]?*JQUANT_TBL
    q_scale_factor: [4]c_int
    dc_huff_tbl_ptrs: [4]?*JHUFF_TBL
    ac_huff_tbl_ptrs: [4]?*JHUFF_TBL
    arith_dc_L: [16]UINT8
    arith_dc_U: [16]UINT8
    arith_ac_K: [16]UINT8
    num_scans: c_int
    scan_info: ?*const jpeg_scan_info
    raw_data_in: boolean
    arith_code: boolean
    optimize_coding: boolean
    CCIR601_sampling: boolean
    do_fancy_downsampling: boolean
    smoothing_factor: c_int
    dct_method: J_DCT_METHOD
    restart_interval: c_uint
    restart_in_rows: c_int
    write_JFIF_header: boolean
    JFIF_major_version: UINT8
    JFIF_minor_version: UINT8
    density_unit: UINT8
    X_density: UINT16
    Y_density: UINT16
    write_Adobe_marker: boolean
    next_scanline: JDIMENSION
    progressive_mode: boolean
    max_h_samp_factor: c_int
    max_v_samp_factor: c_int
    min_DCT_h_scaled_size: c_int
    min_DCT_v_scaled_size: c_int
    total_iMCU_rows: JDIMENSION
    comps_in_scan: c_int
    cur_comp_info: [4]?*jpeg_component_info
    MCUs_per_row: JDIMENSION
    MCU_rows_in_scan: JDIMENSION
    blocks_in_MCU: c_int
    MCU_membership: [10]c_int
    Ss: c_int
    Se: c_int
    Ah: c_int
    Al: c_int
    block_size: c_int
    natural_order: ?*const c_int
    lim_Se: c_int
    master: ?*jpeg_comp_master
    main: ?*jpeg_c_main_controller
    prep: ?*jpeg_c_prep_controller
    coef: ?*jpeg_c_coef_controller
    marker: ?*jpeg_marker_writer
    cconvert: ?*jpeg_color_converter
    downsample: ?*jpeg_downsampler
    fdct: ?*jpeg_forward_dct
    entropy: ?*jpeg_entropy_encoder
    script_space: ?*jpeg_scan_info
    script_space_size: c_int
}

pub const jpeg_decompress_struct = struct {
    err: ?*jpeg_error_mgr
    mem: ?*jpeg_memory_mgr
    progress: ?*jpeg_progress_mgr
    client_data: ?*anyopaque
    is_decompressor: boolean
