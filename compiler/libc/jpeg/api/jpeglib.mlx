    do_block_smoothing: boolean
    quantize_colors: boolean
    dither_mode: J_DITHER_MODE
    two_pass_quantize: boolean
    desired_number_of_colors: c_int
    enable_1pass_quant: boolean
    enable_external_quant: boolean
    enable_2pass_quant: boolean
    output_width: JDIMENSION
    output_height: JDIMENSION
    out_color_components: c_int
    output_components: c_int
    rec_outbuf_height: c_int
    actual_number_of_colors: c_int
    colormap: JSAMPARRAY
    output_scanline: JDIMENSION
    input_scan_number: c_int
    input_iMCU_row: JDIMENSION
    output_scan_number: c_int
    output_iMCU_row: JDIMENSION
    coef_bits: ?*[64]c_int
    quant_tbl_ptrs: [4]?*JQUANT_TBL
    dc_huff_tbl_ptrs: [4]?*JHUFF_TBL
    ac_huff_tbl_ptrs: [4]?*JHUFF_TBL
    data_precision: c_int
    comp_info: ?*jpeg_component_info
    is_baseline: boolean
    progressive_mode: boolean
    arith_code: boolean
    arith_dc_L: [16]UINT8
    arith_dc_U: [16]UINT8
    arith_ac_K: [16]UINT8
    restart_interval: c_uint
    saw_JFIF_marker: boolean
    JFIF_major_version: UINT8
    JFIF_minor_version: UINT8
    density_unit: UINT8
    X_density: UINT16
    Y_density: UINT16
    saw_Adobe_marker: boolean
    Adobe_transform: UINT8
    CCIR601_sampling: boolean
    marker_list: jpeg_saved_marker_ptr
    max_h_samp_factor: c_int
    max_v_samp_factor: c_int
    min_DCT_h_scaled_size: c_int
    min_DCT_v_scaled_size: c_int
    total_iMCU_rows: JDIMENSION
    sample_range_limit: ?*JSAMPLE
    comps_in_scan: c_int
    cur_comp_info: [4]?*jpeg_component_info
    MCUs_per_row: JDIMENSION
    MCU_rows_in_scan: JDIMENSION
    blocks_in_MCU: c_int
    MCU_membership: [10]c_int
    Ss: c_int
    Se: c_int
    Ah: c_int
    Al: c_int
    block_size: c_int
    natural_order: ?*const c_int
    lim_Se: c_int
    unread_marker: c_int
    master: ?*jpeg_decomp_master
    main: ?*jpeg_d_main_controller
    coef: ?*jpeg_d_coef_controller
    post: ?*jpeg_d_post_controller
    inputctl: ?*jpeg_input_controller
    marker: ?*jpeg_marker_reader
    entropy: ?*jpeg_entropy_decoder
    idct: ?*jpeg_inverse_dct
    upsample: ?*jpeg_upsampler
    cconvert: ?*jpeg_color_deconverter
    cquantize: ?*jpeg_color_quantizer
}

// The error manager: the error exit (which must not return: a longjmp),
// the message functions, the message's code and parameters.
pub const jpeg_error_mgr = struct {
    error_exit: ?fn(cinfo: j_common_ptr) -> void
    emit_message: ?fn(cinfo: j_common_ptr, msg_level: c_int) -> void
    output_message: ?fn(cinfo: j_common_ptr) -> void
    format_message: ?fn(cinfo: j_common_ptr, buffer: *c_char) -> void
    reset_error_mgr: ?fn(cinfo: j_common_ptr) -> void
    msg_code: c_int
    msg_parm: union {
        i: [8]c_int
        s: [80]c_char
    }
    trace_level: c_int
    num_warnings: c_long
    jpeg_message_table: ?*const *const c_char
    last_jpeg_message: c_int
    addon_message_table: ?*const *const c_char
    first_addon_message: c_int
    last_addon_message: c_int
}

pub const jpeg_progress_mgr = struct {
    progress_monitor: ?fn(cinfo: j_common_ptr) -> void
    pass_counter: c_long
    pass_limit: c_long
    completed_passes: c_int
    total_passes: c_int
}

// Where a compressor's bytes go.
pub const jpeg_destination_mgr = struct {
    next_output_byte: ?*JOCTET
    free_in_buffer: usize
    init_destination: ?fn(cinfo: j_compress_ptr) -> void
    empty_output_buffer: ?fn(cinfo: j_compress_ptr) -> boolean
    term_destination: ?fn(cinfo: j_compress_ptr) -> void
}

// Where a decompressor's bytes come from: fill_input_buffer answers
// FALSE to suspend (no more data yet).
pub const jpeg_source_mgr = struct {
    next_input_byte: ?*const JOCTET
    bytes_in_buffer: usize
    init_source: ?fn(cinfo: j_decompress_ptr) -> void
    fill_input_buffer: ?fn(cinfo: j_decompress_ptr) -> boolean
    skip_input_data: ?fn(cinfo: j_decompress_ptr, num_bytes: c_long) -> void
    resync_to_restart: ?fn(cinfo: j_decompress_ptr, desired: c_int) -> boolean
    term_source: ?fn(cinfo: j_decompress_ptr) -> void
}

pub const JPOOL_PERMANENT: c_int = 0
pub const JPOOL_IMAGE: c_int = 1
pub const JPOOL_NUMPOOLS: c_int = 2

// The memory manager: memory that lives as long as the object or the
// image.
pub const jpeg_memory_mgr = struct {
    alloc_small: ?fn(cinfo: j_common_ptr, pool_id: c_int, sizeofobject: usize) -> ?*anyopaque
    alloc_large: ?fn(cinfo: j_common_ptr, pool_id: c_int, sizeofobject: usize) -> ?*anyopaque
    alloc_sarray: ?fn(cinfo: j_common_ptr, pool_id: c_int, samplesperrow: JDIMENSION, numrows: JDIMENSION) -> JSAMPARRAY
    alloc_barray: ?fn(cinfo: j_common_ptr, pool_id: c_int, blocksperrow: JDIMENSION, numrows: JDIMENSION) -> JBLOCKARRAY
    request_virt_sarray: ?fn(cinfo: j_common_ptr, pool_id: c_int, pre_zero: boolean, samplesperrow: JDIMENSION, numrows: JDIMENSION, maxaccess: JDIMENSION) -> jvirt_sarray_ptr
    request_virt_barray: ?fn(cinfo: j_common_ptr, pool_id: c_int, pre_zero: boolean, blocksperrow: JDIMENSION, numrows: JDIMENSION, maxaccess: JDIMENSION) -> jvirt_barray_ptr
    realize_virt_arrays: ?fn(cinfo: j_common_ptr) -> void
    access_virt_sarray: ?fn(cinfo: j_common_ptr, ptr: jvirt_sarray_ptr, start_row: JDIMENSION, num_rows: JDIMENSION, writable: boolean) -> JSAMPARRAY
    access_virt_barray: ?fn(cinfo: j_common_ptr, ptr: jvirt_barray_ptr, start_row: JDIMENSION, num_rows: JDIMENSION, writable: boolean) -> JBLOCKARRAY
    free_pool: ?fn(cinfo: j_common_ptr, pool_id: c_int) -> void
    self_destruct: ?fn(cinfo: j_common_ptr) -> void
    max_memory_to_use: c_long
    max_alloc_chunk: c_long
}

pub const jpeg_marker_parser_method = fn(cinfo: j_decompress_ptr) -> boolean

// What jpeg_read_header and jpeg_consume_input answer.
pub const JPEG_SUSPENDED: c_int = 0
pub const JPEG_HEADER_OK: c_int = 1
pub const JPEG_HEADER_TABLES_ONLY: c_int = 2
pub const JPEG_REACHED_SOS: c_int = 1
pub const JPEG_REACHED_EOI: c_int = 2
pub const JPEG_ROW_COMPLETED: c_int = 3
pub const JPEG_SCAN_COMPLETED: c_int = 4

// Markers.
pub const JPEG_RST0: c_int = 0xd0
pub const JPEG_EOI: c_int = 0xd9
pub const JPEG_APP0: c_int = 0xe0
pub const JPEG_COM: c_int = 0xfe

// The longest message format_message makes, and a string parameter.
pub const JMSG_LENGTH_MAX: c_int = 200
pub const JMSG_STR_PARM_MAX: c_int = 80

// The error manager with libjpeg's own functions.
pub extern("c") fn jpeg_std_error(err: *jpeg_error_mgr) -> *jpeg_error_mgr

// Creating and destroying (jpeg_create_compress and
// jpeg_create_decompress give the version and the structure's size).
pub extern("c") fn jpeg_CreateCompress(cinfo: j_compress_ptr, version: c_int, structsize: usize) -> void
pub extern("c") fn jpeg_CreateDecompress(cinfo: j_decompress_ptr, version: c_int, structsize: usize) -> void
pub extern("c") fn jpeg_destroy_compress(cinfo: j_compress_ptr) -> void
pub extern("c") fn jpeg_destroy_decompress(cinfo: j_decompress_ptr) -> void

// Standard data sources and destinations.
pub extern("c") fn jpeg_stdio_dest(cinfo: j_compress_ptr, outfile: *FILE) -> void
pub extern("c") fn jpeg_stdio_src(cinfo: j_decompress_ptr, infile: *FILE) -> void
pub extern("c") fn jpeg_mem_dest(cinfo: j_compress_ptr, outbuffer: **c_uchar, outsize: *c_ulong) -> void
pub extern("c") fn jpeg_mem_src(cinfo: j_decompress_ptr, inbuffer: *const c_uchar, insize: c_ulong) -> void

// The compressor's parameters.
pub extern("c") fn jpeg_set_defaults(cinfo: j_compress_ptr) -> void
pub extern("c") fn jpeg_set_colorspace(cinfo: j_compress_ptr, colorspace: J_COLOR_SPACE) -> void
pub extern("c") fn jpeg_default_colorspace(cinfo: j_compress_ptr) -> void
pub extern("c") fn jpeg_set_quality(cinfo: j_compress_ptr, quality: c_int, force_baseline: boolean) -> void
pub extern("c") fn jpeg_set_linear_quality(cinfo: j_compress_ptr, scale_factor: c_int, force_baseline: boolean) -> void
pub extern("c") fn jpeg_default_qtables(cinfo: j_compress_ptr, force_baseline: boolean) -> void
pub extern("c") fn jpeg_add_quant_table(cinfo: j_compress_ptr, which_tbl: c_int, basic_table: *const c_uint, scale_factor: c_int, force_baseline: boolean) -> void
pub extern("c") fn jpeg_quality_scaling(quality: c_int) -> c_int
pub extern("c") fn jpeg_simple_progression(cinfo: j_compress_ptr) -> void
pub extern("c") fn jpeg_suppress_tables(cinfo: j_compress_ptr, suppress: boolean) -> void
pub extern("c") fn jpeg_alloc_quant_table(cinfo: j_common_ptr) -> *JQUANT_TBL
pub extern("c") fn jpeg_alloc_huff_table(cinfo: j_common_ptr) -> *JHUFF_TBL

// Compressing.
pub extern("c") fn jpeg_start_compress(cinfo: j_compress_ptr, write_all_tables: boolean) -> void
pub extern("c") fn jpeg_write_scanlines(cinfo: j_compress_ptr, scanlines: JSAMPARRAY, num_lines: JDIMENSION) -> JDIMENSION
pub extern("c") fn jpeg_finish_compress(cinfo: j_compress_ptr) -> void
pub extern("c") fn jpeg_calc_jpeg_dimensions(cinfo: j_compress_ptr) -> void
pub extern("c") fn jpeg_write_raw_data(cinfo: j_compress_ptr, data: JSAMPIMAGE, num_lines: JDIMENSION) -> JDIMENSION
pub extern("c") fn jpeg_write_marker(cinfo: j_compress_ptr, marker: c_int, dataptr: *const JOCTET, datalen: c_uint) -> void
pub extern("c") fn jpeg_write_m_header(cinfo: j_compress_ptr, marker: c_int, datalen: c_uint) -> void
pub extern("c") fn jpeg_write_m_byte(cinfo: j_compress_ptr, val: c_int) -> void
pub extern("c") fn jpeg_write_tables(cinfo: j_compress_ptr) -> void
pub extern("c") fn jpeg_write_icc_profile(cinfo: j_compress_ptr, icc_data_ptr: *const JOCTET, icc_data_len: c_uint) -> void

// Decompressing.
pub extern("c") fn jpeg_read_header(cinfo: j_decompress_ptr, require_image: boolean) -> c_int
pub extern("c") fn jpeg_start_decompress(cinfo: j_decompress_ptr) -> boolean
pub extern("c") fn jpeg_read_scanlines(cinfo: j_decompress_ptr, scanlines: JSAMPARRAY, max_lines: JDIMENSION) -> JDIMENSION
pub extern("c") fn jpeg_skip_scanlines(cinfo: j_decompress_ptr, num_lines: JDIMENSION) -> JDIMENSION
pub extern("c") fn jpeg_crop_scanline(cinfo: j_decompress_ptr, xoffset: *JDIMENSION, width: *JDIMENSION) -> void
pub extern("c") fn jpeg_finish_decompress(cinfo: j_decompress_ptr) -> boolean
pub extern("c") fn jpeg_read_raw_data(cinfo: j_decompress_ptr, data: JSAMPIMAGE, max_lines: JDIMENSION) -> JDIMENSION

// Buffered-image mode: output passes while the input is still read.
pub extern("c") fn jpeg_has_multiple_scans(cinfo: j_decompress_ptr) -> boolean
pub extern("c") fn jpeg_start_output(cinfo: j_decompress_ptr, scan_number: c_int) -> boolean
pub extern("c") fn jpeg_finish_output(cinfo: j_decompress_ptr) -> boolean
pub extern("c") fn jpeg_input_complete(cinfo: j_decompress_ptr) -> boolean
pub extern("c") fn jpeg_new_colormap(cinfo: j_decompress_ptr) -> void
pub extern("c") fn jpeg_consume_input(cinfo: j_decompress_ptr) -> c_int

pub extern("c") fn jpeg_core_output_dimensions(cinfo: j_decompress_ptr) -> void
pub extern("c") fn jpeg_calc_output_dimensions(cinfo: j_decompress_ptr) -> void

// Markers kept (APPn, COM) and read by the application.
pub extern("c") fn jpeg_save_markers(cinfo: j_decompress_ptr, marker_code: c_int, length_limit: c_uint) -> void
pub extern("c") fn jpeg_set_marker_processor(cinfo: j_decompress_ptr, marker_code: c_int, routine: jpeg_marker_parser_method) -> void

// Coefficients (transcoding): not supported.
pub extern("c") fn jpeg_read_coefficients(cinfo: j_decompress_ptr) -> ?*jvirt_barray_ptr
pub extern("c") fn jpeg_write_coefficients(cinfo: j_compress_ptr, coef_arrays: *jvirt_barray_ptr) -> void
pub extern("c") fn jpeg_copy_critical_parameters(srcinfo: j_decompress_ptr, dstinfo: j_compress_ptr) -> void

pub extern("c") fn jpeg_abort_compress(cinfo: j_compress_ptr) -> void
pub extern("c") fn jpeg_abort_decompress(cinfo: j_decompress_ptr) -> void
pub extern("c") fn jpeg_abort(cinfo: j_common_ptr) -> void
pub extern("c") fn jpeg_destroy(cinfo: j_common_ptr) -> void

// The default resynchronization after a missing restart marker.
pub extern("c") fn jpeg_resync_to_restart(cinfo: j_decompress_ptr, desired: c_int) -> boolean

// The ICC profile of the APP2 markers saved (jpeg_save_markers(cinfo,
// JPEG_APP0 + 2, 0xFFFF) before jpeg_read_header).
pub extern("c") fn jpeg_read_icc_profile(cinfo: j_decompress_ptr, icc_data_ptr: **JOCTET, icc_data_len: *c_uint) -> boolean
