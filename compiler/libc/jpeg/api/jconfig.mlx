// jconfig.h
// mlx-libjpeg: how the library is built, as libjpeg-turbo's jconfig.h
// says it: the libjpeg 8 API (JPEG_LIB_VERSION 80) of libjpeg-turbo
// 2.1.5, 8-bit samples, no arithmetic coding.
const c_int = i32
const c_tokens = usize

pub const JPEG_LIB_VERSION: c_int = 80
pub const LIBJPEG_TURBO_VERSION: c_tokens = "2.1.5"
pub const LIBJPEG_TURBO_VERSION_NUMBER: c_int = 2001005
pub const BITS_IN_JSAMPLE: c_int = 8
pub const MEM_SRCDST_SUPPORTED: c_int = 1
