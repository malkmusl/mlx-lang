// libjpeg's messages (jerror.h's texts, libjpeg-turbo 2.1.5's libjpeg 8
// API): the table an error manager's jpeg_message_table points to, by
// message code.
const zs = @import("std.flate.stream")

pub const LAST_MESSAGE: usize = 127

// The text (NUL-terminated) of message CODE.
pub fn text(code: usize) -> usize {
    if code == 0 { return zs.literal("Bogus message code %d") }
    if code == 1 { return zs.literal("ALIGN_TYPE is wrong, please fix") }
    if code == 2 { return zs.literal("MAX_ALLOC_CHUNK is wrong, please fix") }
    if code == 3 { return zs.literal("Bogus buffer control mode") }
    if code == 4 { return zs.literal("Invalid component ID %d in SOS") }
    if code == 5 { return zs.literal("Invalid crop request") }
    if code == 6 { return zs.literal("DCT coefficient out of range") }
    if code == 7 { return zs.literal("IDCT output block size %d not supported") }
    if code == 8 { return zs.literal("Component index %d: mismatching sampling ratio %d:%d, %d:%d, %c") }
    if code == 9 { return zs.literal("Bogus Huffman table definition") }
    if code == 10 { return zs.literal("Bogus input colorspace") }
    if code == 11 { return zs.literal("Bogus JPEG colorspace") }
    if code == 12 { return zs.literal("Bogus marker length") }
    if code == 13 { return zs.literal("Wrong JPEG library version: library is %d, caller expects %d") }
    if code == 14 { return zs.literal("Sampling factors too large for interleaved scan") }
    if code == 15 { return zs.literal("Invalid memory pool code %d") }
    if code == 16 { return zs.literal("Unsupported JPEG data precision %d") }
    if code == 17 { return zs.literal("Invalid progressive parameters Ss=%d Se=%d Ah=%d Al=%d") }
    if code == 18 { return zs.literal("Invalid progressive parameters at scan script entry %d") }
    if code == 19 { return zs.literal("Bogus sampling factors") }
    if code == 20 { return zs.literal("Invalid scan script at entry %d") }
    if code == 21 { return zs.literal("Improper call to JPEG library in state %d") }
    if code == 22 { return zs.literal("JPEG parameter struct mismatch: library thinks size is %u, caller expects %u") }
    if code == 23 { return zs.literal("Bogus virtual array access") }
    if code == 24 { return zs.literal("Buffer passed to JPEG library is too small") }
    if code == 25 { return zs.literal("Suspension not allowed here") }
    if code == 26 { return zs.literal("CCIR601 sampling not implemented yet") }
    if code == 27 { return zs.literal("Too many color components: %d, max %d") }
    if code == 28 { return zs.literal("Unsupported color conversion request") }
    if code == 29 { return zs.literal("Bogus DAC index %d") }
    if code == 30 { return zs.literal("Bogus DAC value 0x%x") }
    if code == 31 { return zs.literal("Bogus DHT index %d") }
    if code == 32 { return zs.literal("Bogus DQT index %d") }
    if code == 33 { return zs.literal("Empty JPEG image (DNL not supported)") }
    if code == 34 { return zs.literal("Read from EMS failed") }
    if code == 35 { return zs.literal("Write to EMS failed") }
    if code == 36 { return zs.literal("Didn't expect more than one scan") }
    if code == 37 { return zs.literal("Input file read error") }
    if code == 38 { return zs.literal("Output file write error --- out of disk space?") }
    if code == 39 { return zs.literal("Fractional sampling not implemented yet") }
    if code == 40 { return zs.literal("Huffman code size table overflow") }
    if code == 41 { return zs.literal("Missing Huffman code table entry") }
    if code == 42 { return zs.literal("Maximum supported image dimension is %u pixels") }
    if code == 43 { return zs.literal("Empty input file") }
    if code == 44 { return zs.literal("Premature end of input file") }
    if code == 45 { return zs.literal("Cannot transcode due to multiple use of quantization table %d") }
    if code == 46 { return zs.literal("Scan script does not transmit all data") }
    if code == 47 { return zs.literal("Invalid color quantization mode change") }
    if code == 48 { return zs.literal("Requested features are incompatible") }
    if code == 49 { return zs.literal("Requested feature was omitted at compile time") }
    if code == 50 { return zs.literal("Arithmetic table 0x%02x was not defined") }
    if code == 51 { return zs.literal("Backing store not supported") }
    if code == 52 { return zs.literal("Huffman table 0x%02x was not defined") }
    if code == 53 { return zs.literal("JPEG datastream contains no image") }
    if code == 54 { return zs.literal("Quantization table 0x%02x was not defined") }
    if code == 55 { return zs.literal("Not a JPEG file: starts with 0x%02x 0x%02x") }
    if code == 56 { return zs.literal("Insufficient memory (case %d)") }
    if code == 57 { return zs.literal("Cannot quantize more than %d color components") }
    if code == 58 { return zs.literal("Cannot quantize to fewer than %d colors") }
    if code == 59 { return zs.literal("Cannot quantize to more than %d colors") }
    if code == 60 { return zs.literal("Invalid JPEG file structure: two SOF markers") }
    if code == 61 { return zs.literal("Invalid JPEG file structure: missing SOS marker") }
    if code == 62 { return zs.literal("Unsupported JPEG process: SOF type 0x%02x") }
    if code == 63 { return zs.literal("Invalid JPEG file structure: two SOI markers") }
    if code == 64 { return zs.literal("Invalid JPEG file structure: SOS before SOF") }
    if code == 65 { return zs.literal("Failed to create temporary file %s") }
    if code == 66 { return zs.literal("Read failed on temporary file") }
    if code == 67 { return zs.literal("Seek failed on temporary file") }
    if code == 68 { return zs.literal("Write failed on temporary file --- out of disk space?") }
    if code == 69 { return zs.literal("Application transferred too few scanlines") }
    if code == 70 { return zs.literal("Unsupported marker type 0x%02x") }
    if code == 71 { return zs.literal("Virtual array controller messed up") }
    if code == 72 { return zs.literal("Image too wide for this implementation") }
    if code == 73 { return zs.literal("Read from XMS failed") }
    if code == 74 { return zs.literal("Write to XMS failed") }
    if code == 75 { return zs.literal("Copyright (C) 1991-2023 The libjpeg-turbo Project and many others") }
    if code == 76 { return zs.literal("8d  15-Jan-2012") }
    if code == 77 { return zs.literal("Caution: quantization tables are too coarse for baseline JPEG") }
    if code == 78 { return zs.literal("Adobe APP14 marker: version %d, flags 0x%04x 0x%04x, transform %d") }
    if code == 79 { return zs.literal("Unknown APP0 marker (not JFIF), length %u") }
    if code == 80 { return zs.literal("Unknown APP14 marker (not Adobe), length %u") }
    if code == 81 { return zs.literal("Define Arithmetic Table 0x%02x: 0x%02x") }
    if code == 82 { return zs.literal("Define Huffman Table 0x%02x") }
    if code == 83 { return zs.literal("Define Quantization Table %d  precision %d") }
    if code == 84 { return zs.literal("Define Restart Interval %u") }
    if code == 85 { return zs.literal("Freed EMS handle %u") }
    if code == 86 { return zs.literal("Obtained EMS handle %u") }
    if code == 87 { return zs.literal("End Of Image") }
    if code == 88 { return zs.literal("        %3d %3d %3d %3d %3d %3d %3d %3d") }
    if code == 89 { return zs.literal("JFIF APP0 marker: version %d.%02d, density %dx%d  %d") }
    if code == 90 { return zs.literal("Warning: thumbnail image size does not match data length %u") }
    if code == 91 { return zs.literal("JFIF extension marker: type 0x%02x, length %u") }
    if code == 92 { return zs.literal("    with %d x %d thumbnail image") }
    if code == 93 { return zs.literal("Miscellaneous marker 0x%02x, length %u") }
    if code == 94 { return zs.literal("Unexpected marker 0x%02x") }
    if code == 95 { return zs.literal("        %4u %4u %4u %4u %4u %4u %4u %4u") }
    if code == 96 { return zs.literal("Quantizing to %d = %d*%d*%d colors") }
    if code == 97 { return zs.literal("Quantizing to %d colors") }
    if code == 98 { return zs.literal("Selected %d colors for quantization") }
    if code == 99 { return zs.literal("At marker 0x%02x, recovery action %d") }
    if code == 100 { return zs.literal("RST%d") }
    if code == 101 { return zs.literal("Smoothing not supported with nonstandard sampling ratios") }
    if code == 102 { return zs.literal("Start Of Frame 0x%02x: width=%u, height=%u, components=%d") }
    if code == 103 { return zs.literal("    Component %d: %dhx%dv q=%d") }
    if code == 104 { return zs.literal("Start of Image") }
    if code == 105 { return zs.literal("Start Of Scan: %d components") }
    if code == 106 { return zs.literal("    Component %d: dc=%d ac=%d") }
    if code == 107 { return zs.literal("  Ss=%d, Se=%d, Ah=%d, Al=%d") }
    if code == 108 { return zs.literal("Closed temporary file %s") }
    if code == 109 { return zs.literal("Opened temporary file %s") }
    if code == 110 { return zs.literal("JFIF extension marker: JPEG-compressed thumbnail image, length %u") }
    if code == 111 { return zs.literal("JFIF extension marker: palette thumbnail image, length %u") }
    if code == 112 { return zs.literal("JFIF extension marker: RGB thumbnail image, length %u") }
    if code == 113 { return zs.literal("Unrecognized component IDs %d %d %d, assuming YCbCr") }
    if code == 114 { return zs.literal("Freed XMS handle %u") }
    if code == 115 { return zs.literal("Obtained XMS handle %u") }
    if code == 116 { return zs.literal("Unknown Adobe color transform code %d") }
    if code == 117 { return zs.literal("Corrupt JPEG data: bad arithmetic code") }
    if code == 118 { return zs.literal("Inconsistent progression sequence for component %d coefficient %d") }
    if code == 119 { return zs.literal("Corrupt JPEG data: %u extraneous bytes before marker 0x%02x") }
    if code == 120 { return zs.literal("Corrupt JPEG data: premature end of data segment") }
    if code == 121 { return zs.literal("Corrupt JPEG data: bad Huffman code") }
    if code == 122 { return zs.literal("Warning: unknown JFIF revision number %d.%02d") }
    if code == 123 { return zs.literal("Premature end of JPEG file") }
    if code == 124 { return zs.literal("Corrupt JPEG data: found marker 0x%02x instead of RST%d") }
    if code == 125 { return zs.literal("Invalid SOS parameters for sequential JPEG") }
    if code == 126 { return zs.literal("Application transferred too many scanlines") }
    if code == 127 { return zs.literal("Corrupt JPEG data: bad ICC marker") }
    return 0
}
