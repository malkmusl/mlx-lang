// libjpeg's public structures as the C API (api/jpeglib.mlx, jpeglib.h)
// lays them out, with addresses as words (Mlx lays a structure out as C
// does): the decompressor and compressor objects, the error, source,
// destination and memory managers, a component's information. The
// application reads and writes their fields; the library keeps them as
// libjpeg keeps them.

// struct jpeg_common_struct
pub const Common = struct {
    err: usize
    mem: usize
    progress: usize
    client_data: usize
    is_decompressor: i32
    global_state: i32
}

// struct jpeg_decompress_struct
pub const Decompress = struct {
    err: usize
    mem: usize
    progress: usize
    client_data: usize
    is_decompressor: i32
    global_state: i32
    src: usize
    image_width: u32
    image_height: u32
    num_components: i32
    jpeg_color_space: i32
    out_color_space: i32
    scale_num: u32
    scale_denom: u32
    output_gamma: f64
    buffered_image: i32
    raw_data_out: i32
    dct_method: i32
    do_fancy_upsampling: i32
    do_block_smoothing: i32
    quantize_colors: i32
    dither_mode: i32
    two_pass_quantize: i32
    desired_number_of_colors: i32
    enable_1pass_quant: i32
    enable_external_quant: i32
    enable_2pass_quant: i32
    output_width: u32
    output_height: u32
    out_color_components: i32
    output_components: i32
    rec_outbuf_height: i32
    actual_number_of_colors: i32
    colormap: usize
    output_scanline: u32
    input_scan_number: i32
    input_iMCU_row: u32
    output_scan_number: i32
    output_iMCU_row: u32
    coef_bits: usize
    quant_tbl_ptrs: [4]usize
    dc_huff_tbl_ptrs: [4]usize
    ac_huff_tbl_ptrs: [4]usize
    data_precision: i32
    comp_info: usize
    is_baseline: i32
    progressive_mode: i32
    arith_code: i32
    arith_dc_L: [16]u8
    arith_dc_U: [16]u8
    arith_ac_K: [16]u8
    restart_interval: u32
    saw_JFIF_marker: i32
    JFIF_major_version: u8
    JFIF_minor_version: u8
    density_unit: u8
    X_density: u16
    Y_density: u16
    saw_Adobe_marker: i32
    Adobe_transform: u8
    CCIR601_sampling: i32
    marker_list: usize
    max_h_samp_factor: i32
    max_v_samp_factor: i32
    min_DCT_h_scaled_size: i32
    min_DCT_v_scaled_size: i32
    total_iMCU_rows: u32
    sample_range_limit: usize
    comps_in_scan: i32
    cur_comp_info: [4]usize
    MCUs_per_row: u32
    MCU_rows_in_scan: u32
    blocks_in_MCU: i32
    MCU_membership: [10]i32
    Ss: i32
    Se: i32
    Ah: i32
    Al: i32
    block_size: i32
    natural_order: usize
    lim_Se: i32
    unread_marker: i32
    master: usize
    main: usize
    coef: usize
    post: usize
    inputctl: usize
    marker: usize
    entropy: usize
    idct: usize
    upsample: usize
    cconvert: usize
    cquantize: usize
}

// struct jpeg_compress_struct
pub const Compress = struct {
    err: usize
    mem: usize
    progress: usize
    client_data: usize
    is_decompressor: i32
    global_state: i32
    dest: usize
    image_width: u32
    image_height: u32
    input_components: i32
    in_color_space: i32
    input_gamma: f64
    scale_num: u32
    scale_denom: u32
    jpeg_width: u32
    jpeg_height: u32
    data_precision: i32
    num_components: i32
    jpeg_color_space: i32
    comp_info: usize
    quant_tbl_ptrs: [4]usize
    q_scale_factor: [4]i32
    dc_huff_tbl_ptrs: [4]usize
    ac_huff_tbl_ptrs: [4]usize
    arith_dc_L: [16]u8
    arith_dc_U: [16]u8
    arith_ac_K: [16]u8
    num_scans: i32
    scan_info: usize
    raw_data_in: i32
    arith_code: i32
    optimize_coding: i32
    CCIR601_sampling: i32
    do_fancy_downsampling: i32
    smoothing_factor: i32
    dct_method: i32
    restart_interval: u32
    restart_in_rows: i32
    write_JFIF_header: i32
    JFIF_major_version: u8
    JFIF_minor_version: u8
    density_unit: u8
    X_density: u16
    Y_density: u16
    write_Adobe_marker: i32
    next_scanline: u32
    progressive_mode: i32
    max_h_samp_factor: i32
    max_v_samp_factor: i32
    min_DCT_h_scaled_size: i32
    min_DCT_v_scaled_size: i32
    total_iMCU_rows: u32
    comps_in_scan: i32
    cur_comp_info: [4]usize
    MCUs_per_row: u32
    MCU_rows_in_scan: u32
    blocks_in_MCU: i32
    MCU_membership: [10]i32
    Ss: i32
    Se: i32
    Ah: i32
    Al: i32
    block_size: i32
    natural_order: usize
    lim_Se: i32
    master: usize
    main: usize
    prep: usize
    coef: usize
    marker: usize
    cconvert: usize
    downsample: usize
    fdct: usize
    entropy: usize
    script_space: usize
    script_space_size: i32
}

// jpeg_component_info
pub const ComponentInfo = struct {
    component_id: i32
    component_index: i32
    h_samp_factor: i32
    v_samp_factor: i32
    quant_tbl_no: i32
    dc_tbl_no: i32
    ac_tbl_no: i32
    width_in_blocks: u32
    height_in_blocks: u32
    DCT_h_scaled_size: i32
    DCT_v_scaled_size: i32
    downsampled_width: u32
    downsampled_height: u32
    component_needed: i32
    MCU_width: i32
    MCU_height: i32
    MCU_blocks: i32
    MCU_sample_width: i32
    last_col_width: i32
    last_row_height: i32
    quant_table: usize
    dct_table: usize
}

// struct jpeg_error_mgr (msg_parm: the union of int i[8] and char s[80]).
pub const ErrorMgr = struct {
    error_exit: usize
    emit_message: usize
    output_message: usize
    format_message: usize
    reset_error_mgr: usize
    msg_code: i32
    msg_parm: [20]i32
    trace_level: i32
    num_warnings: i64
    jpeg_message_table: usize
    last_jpeg_message: i32
    addon_message_table: usize
    first_addon_message: i32
    last_addon_message: i32
}

// struct jpeg_source_mgr
pub const SourceMgr = struct {
    next_input_byte: usize
    bytes_in_buffer: usize
    init_source: usize
    fill_input_buffer: usize
    skip_input_data: usize
    resync_to_restart: usize
    term_source: usize
}

// struct jpeg_destination_mgr
pub const DestinationMgr = struct {
    next_output_byte: usize
    free_in_buffer: usize
    init_destination: usize
    empty_output_buffer: usize
    term_destination: usize
}

// struct jpeg_memory_mgr
pub const MemoryMgr = struct {
    alloc_small: usize
    alloc_large: usize
    alloc_sarray: usize
    alloc_barray: usize
    request_virt_sarray: usize
    request_virt_barray: usize
    realize_virt_arrays: usize
    access_virt_sarray: usize
    access_virt_barray: usize
    free_pool: usize
    self_destruct: usize
    max_memory_to_use: i64
    max_alloc_chunk: i64
}

// struct jpeg_progress_mgr
pub const ProgressMgr = struct {
    progress_monitor: usize
    pass_counter: i64
    pass_limit: i64
    completed_passes: i32
    total_passes: i32
}

pub fn decompress(address: usize) -> *Decompress { unsafe { return @ptrFromInt(*Decompress, address) } }
pub fn compress(address: usize) -> *Compress { unsafe { return @ptrFromInt(*Compress, address) } }
pub fn common(address: usize) -> *Common { unsafe { return @ptrFromInt(*Common, address) } }
pub fn component(address: usize) -> *ComponentInfo { unsafe { return @ptrFromInt(*ComponentInfo, address) } }
pub fn errorMgr(address: usize) -> *ErrorMgr { unsafe { return @ptrFromInt(*ErrorMgr, address) } }
pub fn source(address: usize) -> *SourceMgr { unsafe { return @ptrFromInt(*SourceMgr, address) } }
pub fn destination(address: usize) -> *DestinationMgr { unsafe { return @ptrFromInt(*DestinationMgr, address) } }
pub fn progress(address: usize) -> *ProgressMgr { unsafe { return @ptrFromInt(*ProgressMgr, address) } }
