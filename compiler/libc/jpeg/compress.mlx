// The compressor's objects (jcapimin.c): created and destroyed as
// libjpeg creates them. Compressing itself is not written yet: each
// function that would compress raises JERR_NOT_COMPILED through the
// error manager, as a libjpeg built without the compressor would.
const zs = @import("std.flate.stream")
const rec = @import("./records.mlx")
const c = @import("./common.mlx")

pub const COMPRESS_SIZE: usize = 584

export fn jpeg_CreateCompress(cinfo: usize, version: i32, structsize: usize) -> void {
    const info = rec.compress(cinfo)
    info.*.mem = 0
    if version != 80 {
        c.raise(cinfo, c.JERR_BAD_LIB_VERSION, 80, version, 0, 0)
        return
    }
    if structsize != COMPRESS_SIZE {
        c.raise(cinfo, c.JERR_BAD_STRUCT_SIZE, @intCast(i32, COMPRESS_SIZE), @intCast(i32, structsize & 0x7fffffff), 0, 0)
        return
    }
    const err = info.*.err
    const clientData = info.*.client_data
    zs.zero(cinfo, COMPRESS_SIZE)
    info.*.err = err
    info.*.client_data = clientData
    info.*.is_decompressor = 0
    if !c.createState(cinfo, 16) {
        c.raise1(cinfo, c.JERR_OUT_OF_MEMORY, 0)
        return
    }
    info.*.input_gamma = 1.0
    info.*.global_state = c.CSTATE_START
}

export fn jpeg_destroy_compress(cinfo: usize) -> void { c.destroy(cinfo) }

export fn jpeg_abort_compress(cinfo: usize) -> void { c.abort(cinfo) }

// jpeg_quality_scaling: a quality of 1 to 100 as a percentage scale of
// the standard tables.
export fn jpeg_quality_scaling(quality: i32) -> i32 {
    var q = quality
    if q <= 0 { q = 1 }
    if q > 100 { q = 100 }
    if q < 50 { return 5000 / q }
    return 200 - q * 2
}

fn notCompiled(cinfo: usize) -> void { c.raise0(cinfo, c.JERR_NOT_COMPILED) }

export fn jpeg_stdio_dest(cinfo: usize, outfile: usize) -> void { notCompiled(cinfo) }
export fn jpeg_mem_dest(cinfo: usize, outbuffer: usize, outsize: usize) -> void { notCompiled(cinfo) }
export fn jpeg_set_defaults(cinfo: usize) -> void { notCompiled(cinfo) }
export fn jpeg_set_colorspace(cinfo: usize, colorspace: i32) -> void { notCompiled(cinfo) }
export fn jpeg_default_colorspace(cinfo: usize) -> void { notCompiled(cinfo) }
export fn jpeg_set_quality(cinfo: usize, quality: i32, force_baseline: i32) -> void { notCompiled(cinfo) }
export fn jpeg_set_linear_quality(cinfo: usize, scale_factor: i32, force_baseline: i32) -> void { notCompiled(cinfo) }
export fn jpeg_default_qtables(cinfo: usize, force_baseline: i32) -> void { notCompiled(cinfo) }
export fn jpeg_add_quant_table(cinfo: usize, which_tbl: i32, basic_table: usize, scale_factor: i32, force_baseline: i32) -> void { notCompiled(cinfo) }
export fn jpeg_simple_progression(cinfo: usize) -> void { notCompiled(cinfo) }
export fn jpeg_suppress_tables(cinfo: usize, suppress: i32) -> void { notCompiled(cinfo) }
export fn jpeg_start_compress(cinfo: usize, write_all_tables: i32) -> void { notCompiled(cinfo) }
export fn jpeg_write_scanlines(cinfo: usize, scanlines: usize, num_lines: u32) -> u32 {
    notCompiled(cinfo)
    return 0
}
export fn jpeg_finish_compress(cinfo: usize) -> void { notCompiled(cinfo) }
export fn jpeg_calc_jpeg_dimensions(cinfo: usize) -> void { notCompiled(cinfo) }
export fn jpeg_write_raw_data(cinfo: usize, data: usize, num_lines: u32) -> u32 {
    notCompiled(cinfo)
    return 0
}
export fn jpeg_write_marker(cinfo: usize, marker: i32, dataptr: usize, datalen: u32) -> void { notCompiled(cinfo) }
export fn jpeg_write_m_header(cinfo: usize, marker: i32, datalen: u32) -> void { notCompiled(cinfo) }
export fn jpeg_write_m_byte(cinfo: usize, val: i32) -> void { notCompiled(cinfo) }
export fn jpeg_write_tables(cinfo: usize) -> void { notCompiled(cinfo) }
export fn jpeg_write_icc_profile(cinfo: usize, icc_data_ptr: usize, icc_data_len: u32) -> void { notCompiled(cinfo) }
export fn jpeg_write_coefficients(cinfo: usize, coef_arrays: usize) -> void { notCompiled(cinfo) }
export fn jpeg_copy_critical_parameters(srcinfo: usize, dstinfo: usize) -> void { notCompiled(dstinfo) }
