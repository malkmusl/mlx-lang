// PulseAudio's native protocol on the wire, as the library keeps it:
// packets (a descriptor of five big-endian u32: payload length, channel
// (CONTROL for commands), the offset's two halves, flags; then the
// payload) and tagstructs, the commands' bodies. The tagstructs are
// std.pulse.tagstruct's, as the server's (projects/desktop/audio) are;
// what is here moves the library's C structures (sample specs, channel
// maps, volumes, property lists, formats, timevals) in and out of them,
// in packets built in C memory that grows as they fill.
const std = @import("std")
const c = @import("./c.mlx")
const proplist = @import("./proplist.mlx")
const format = @import("./format.mlx")
const sample = @import("./sample.mlx")
const channels = @import("./channels.mlx")
const volume = @import("./volume.mlx")
const util = @import("./util.mlx")
const pa = @import("std.pulse")

const ts = pa.tagstruct

// ---------------------------------------------------------------------------
// Writing a packet: room for the descriptor first, the payload after it.

pub const Writer = ts.Writer

pub fn writer() -> Writer {
    var writing: Writer = undefined
    if ts.beginGrowing(&writing, c.allocator(), 256) { ts.reserve(&writing, pa.DESCRIPTOR) }
    return writing
}

// The packet's address (its descriptor first); 0 when it could not be
// built (no memory).
pub fn packet(writing: *const Writer) -> usize {
    if writing.*.failed { return 0 }
    return @intFromPtr(writing.*.bytes)
}

pub fn release(writing: *Writer) -> void { ts.release(writing) }

pub fn store32(data: usize, at: usize, value: u32) -> void { std.mem.writeU32Big(c.bytes(data), at, value) }

pub fn load32(data: usize, at: usize) -> u32 { return std.mem.readU32Big(c.bytes(data), at) }

pub fn putU32(writing: *Writer, value: u32) -> void { ts.putU32(writing, value) }

pub fn putU8(writing: *Writer, value: u8) -> void { ts.putU8(writing, value) }

pub fn putU64(writing: *Writer, value: u64) -> void { ts.putU64(writing, value) }

pub fn putS64(writing: *Writer, value: i64) -> void { ts.putS64(writing, value) }

pub fn putBool(writing: *Writer, value: bool) -> void { ts.putBool(writing, value) }

pub fn putString(writing: *Writer, text: []const u8) -> void { ts.putString(writing, text) }

// A C string, or the null string for 0.
pub fn putCString(writing: *Writer, text: usize) -> void {
    if text == 0 {
        ts.putNullString(writing)
        return
    }
    ts.putString(writing, c.slice(text))
}

pub fn putArbitrary(writing: *Writer, data: usize, count: usize) -> void { ts.putArbitrary(writing, c.bytes(data), count) }

pub fn putSampleSpec(writing: *Writer, spec: sample.Spec) -> void {
    ts.putSampleSpec(writing, @intCast(u8, spec.format & 255), @intCast(u8, spec.channels & 255), spec.rate)
}

// The pa_channel_map at `map`.
pub fn putChannelMap(writing: *Writer, map: usize) -> void {
    var positions: [256]u8 = undefined
    const count = channels.channels(map)
    var index: u32 = 0
    while index < count && index < 256 {
        positions[@intCast(usize, index)] = @intCast(u8, channels.position(map, index) & 255)
        index += 1
    }
    const bytes: [*]const u8 = &positions
    ts.putChannelMap(writing, bytes, @intCast(usize, index))
}

// The pa_cvolume at `levels`.
pub fn putCvolume(writing: *Writer, levels: usize) -> void {
    var values: [256]u32 = undefined
    const count = volume.count(levels)
    var index: u32 = 0
    while index < count && index < 256 {
        values[@intCast(usize, index)] = volume.value(levels, index)
        index += 1
    }
    const words: [*]const u32 = &values
    ts.putVolumes(writing, words, @intCast(usize, index))
}

pub fn putVolume(writing: *Writer, value: u32) -> void { ts.putVolume(writing, value) }

pub fn putUsec(writing: *Writer, value: u64) -> void { ts.putUsec(writing, value) }

// The struct timeval at `time`.
pub fn putTimeval(writing: *Writer, time: usize) -> void {
    ts.putTimeval(writing, @intCast(u32, util.seconds(time) & 4294967295), @intCast(u32, util.micro(time) & 4294967295))
}

// The pa_proplist at `list` (0: an empty one).
pub fn putProplist(writing: *Writer, list: usize) -> void {
    ts.beginProplist(writing)
    var index: usize = 0
    while list != 0 && index < proplist.count(list) {
        ts.putString(writing, c.slice(proplist.keyAt(list, index)))
        ts.putU32(writing, @intCast(u32, proplist.sizeAt(list, index)))
        ts.putArbitrary(writing, c.bytes(proplist.valueAt(list, index)), proplist.sizeAt(list, index))
        index += 1
    }
    ts.endProplist(writing)
}

// The pa_format_info at `info`.
pub fn putFormat(writing: *Writer, info: usize) -> void {
    ts.raw8(writing, ts.TAG_FORMAT_INFO)
    ts.putU8(writing, @intCast(u8, @bitCast(u32, format.encoding(info)) & 255))
    putProplist(writing, format.properties(info))
}

// The packet: descriptor filled in (`channel`, offset, flags).
pub fn finish(writing: *Writer, channel: u32, offset: u64, flags: u32) -> void {
    if writing.*.failed { return }
    std.mem.writeU32Big(writing.*.bytes, 0, @intCast(u32, writing.*.length - pa.DESCRIPTOR))
    std.mem.writeU32Big(writing.*.bytes, 4, channel)
    std.mem.writeU32Big(writing.*.bytes, 8, @intCast(u32, offset >> 32))
    std.mem.writeU32Big(writing.*.bytes, 12, @intCast(u32, offset & 4294967295))
    std.mem.writeU32Big(writing.*.bytes, 16, flags)
}

pub fn command(code: u32, tag: u32) -> Writer {
    var writing = writer()
    ts.putU32(&writing, code)
    ts.putU32(&writing, tag)
    return writing
}

// ---------------------------------------------------------------------------
// Reading a payload (in C memory at `data`)

pub const Reader = ts.Reader

pub fn reader(data: usize, length: usize) -> Reader { return ts.reader(c.bytes(data), length) }

pub fn atEnd(reading: *Reader) -> bool { return ts.atEnd(reading) }

pub fn readU32(reading: *Reader) -> u32 { return ts.readU32(reading) }

pub fn readU8(reading: *Reader) -> u8 { return ts.readU8(reading) }

pub fn readU64(reading: *Reader) -> u64 { return ts.readU64(reading) }

pub fn readS64(reading: *Reader) -> i64 { return ts.readS64(reading) }

pub fn readUsec(reading: *Reader) -> u64 { return ts.readUsec(reading) }

pub fn readVolume(reading: *Reader) -> u32 { return ts.readVolume(reading) }

pub fn readBool(reading: *Reader) -> bool { return ts.readBool(reading) }

// A string in place (an address into the payload; 0 for the null
// string). It lives as long as the payload.
pub fn readString(reading: *Reader) -> usize {
    var none = false
    const text = ts.readStringOrNull(reading, &none)
    if none || reading.*.failed { return 0 }
    return @intFromPtr(text.pointer)
}

// Arbitrary bytes: their address (in the payload) and count.
pub fn readArbitrary(reading: *Reader, count: *usize) -> usize {
    const start = ts.readArbitrary(reading, count)
    if reading.*.failed { return 0 }
    return @intFromPtr(start)
}

// Into a pa_sample_spec at `spec`.
pub fn readSampleSpec(reading: *Reader, spec: usize) -> void {
    var read: ts.SampleSpec = undefined
    ts.readSampleSpec(reading, &read)
    if reading.*.failed { return }
    sample.write(spec, sample.Spec.{ .format = @intCast(u32, read.format), .rate = read.rate, .channels = @intCast(u32, read.channels) })
}

// Into a pa_channel_map at `map`.
pub fn readChannelMap(reading: *Reader, map: usize) -> void {
    var positions: [32]u8 = undefined
    const bytes: [*]u8 = &positions
    const count = ts.readChannelMap(reading, bytes)
    if reading.*.failed { return }
    channels.init(map)
    channels.setChannels(map, @intCast(u32, count))
    var index: usize = 0
    while index < count {
        channels.setPosition(map, @intCast(u32, index), @intCast(u32, positions[index]))
        index += 1
    }
}

// Into a pa_cvolume at `levels`.
pub fn readCvolume(reading: *Reader, levels: usize) -> void {
    var values: [32]u32 = undefined
    const words: [*]u32 = &values
    const count = ts.readVolumes(reading, words)
    if reading.*.failed { return }
    volume.init(levels)
    volume.setCount(levels, @intCast(u32, count))
    var index: usize = 0
    while index < count {
        volume.setValue(levels, @intCast(u32, index), values[index])
        index += 1
    }
}

// Into a struct timeval at `time`.
pub fn readTimeval(reading: *Reader, time: usize) -> void {
    var seconds: u32 = 0
    var microseconds: u32 = 0
    ts.readTimeval(reading, &seconds, &microseconds)
    if reading.*.failed { return }
    c.put64(time, 0, @intCast(u64, seconds))
    c.put64(time, 8, @intCast(u64, microseconds))
}

// Into the property list `list` (added to it).
pub fn readProplist(reading: *Reader, list: usize) -> void {
    if !ts.expect(reading, ts.TAG_PROPLIST, 0) { return }
    while true {
        const key = readString(reading)
        if reading.*.failed { return }
        if key == 0 { return }
        const size = ts.readU32(reading)
        var count: usize = 0
        const value = readArbitrary(reading, &count)
        if reading.*.failed || count != @intCast(usize, size) {
            reading.*.failed = true
            return
        }
        if list != 0 { _ = proplist.set(list, c.slice(key), value, count) }
    }
}

// Into a pa_format_info made with format.new.
pub fn readFormat(reading: *Reader, info: usize) -> void {
    if !ts.expect(reading, ts.TAG_FORMAT_INFO, 0) { return }
    const encoding = ts.readU8(reading)
    format.setEncoding(info, @intCast(i32, encoding))
    readProplist(reading, format.properties(info))
}
