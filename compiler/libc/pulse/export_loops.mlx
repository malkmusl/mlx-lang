// libpulse's main loops for C: pa_mainloop, pa_threaded_mainloop,
// pa_mainloop_api_once and the signal events.
const c = @import("./c.mlx")
const mainloop = @import("./mainloop.mlx")
const threaded = @import("./threaded.mlx")

export fn pa_mainloop_new() -> usize { return mainloop.new() }

export fn pa_mainloop_free(loop: usize) -> void { mainloop.free(loop) }

export fn pa_mainloop_prepare(loop: usize, timeout: i32) -> i32 { return mainloop.prepare(loop, timeout) }

export fn pa_mainloop_poll(loop: usize) -> i32 { return mainloop.poll(loop) }

export fn pa_mainloop_dispatch(loop: usize) -> i32 { return mainloop.dispatch(loop) }

export fn pa_mainloop_get_retval(loop: usize) -> i32 { return mainloop.retval(loop) }

export fn pa_mainloop_iterate(loop: usize, block: i32, result: usize) -> i32 { return mainloop.iterate(loop, block != 0, result) }

export fn pa_mainloop_run(loop: usize, result: usize) -> i32 { return mainloop.run(loop, result) }

// The table is the loop's first field.
export fn pa_mainloop_get_api(loop: usize) -> usize { return loop }

export fn pa_mainloop_quit(loop: usize, retval: i32) -> void { mainloop.quit(loop, retval) }

export fn pa_mainloop_wakeup(loop: usize) -> void { mainloop.wakeup(loop) }

export fn pa_mainloop_set_poll_func(loop: usize, function: usize, userdata: usize) -> void { mainloop.setPollFunction(loop, function, userdata) }

export fn pa_mainloop_api_once(api: usize, callback: usize, userdata: usize) -> void { mainloop.once(api, callback, userdata) }

export fn pa_signal_init(api: usize) -> i32 { return mainloop.signalInit(api) }

export fn pa_signal_done() -> void { mainloop.signalDone() }

export fn pa_signal_new(number: i32, callback: usize, userdata: usize) -> usize { return mainloop.signalNew(number, callback, userdata) }

export fn pa_signal_free(event: usize) -> void { mainloop.signalFree(event) }

export fn pa_signal_set_destroy(event: usize, callback: usize) -> void { mainloop.signalSetDestroy(event, callback) }

export fn pa_threaded_mainloop_new() -> usize { return threaded.new() }

export fn pa_threaded_mainloop_free(loop: usize) -> void { threaded.free(loop) }

export fn pa_threaded_mainloop_start(loop: usize) -> i32 { return threaded.start(loop) }

export fn pa_threaded_mainloop_stop(loop: usize) -> void { threaded.stop(loop) }

export fn pa_threaded_mainloop_lock(loop: usize) -> void { threaded.lock(loop) }

export fn pa_threaded_mainloop_unlock(loop: usize) -> void { threaded.unlock(loop) }

export fn pa_threaded_mainloop_wait(loop: usize) -> void { threaded.wait(loop) }

export fn pa_threaded_mainloop_signal(loop: usize, waitForAccept: i32) -> void { threaded.signal(loop, waitForAccept != 0) }

export fn pa_threaded_mainloop_accept(loop: usize) -> void { threaded.accept(loop) }

export fn pa_threaded_mainloop_get_retval(loop: usize) -> i32 { return mainloop.retval(threaded.loopOf(loop)) }

export fn pa_threaded_mainloop_get_api(loop: usize) -> usize { return threaded.loopOf(loop) }

export fn pa_threaded_mainloop_in_thread(loop: usize) -> i32 { return if threaded.inThread(loop) { 1 } else { 0 } }

export fn pa_threaded_mainloop_set_name(loop: usize, name: usize) -> void { threaded.setName(loop, name) }

export fn pa_threaded_mainloop_once_unlocked(loop: usize, callback: usize, userdata: usize) -> void { threaded.onceUnlocked(loop, callback, userdata) }
