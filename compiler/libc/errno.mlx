// errno: a word per thread, in the thread's control block (tcb.mlx), and
// the helpers that turn a system call's -errno into C's -1 with errno set.
const sys = @import("./sys.mlx")
const tcb = @import("./tcb.mlx")

var fallback: i32 = 0

pub fn location() -> usize {
    const block = tcb.current()
    if block == 0 { return @intFromPtr(&fallback) }
    return block + tcb.ERRNO
}

pub fn set(code: i32) -> void { sys.putI32(location(), code) }

pub fn get() -> i32 { return sys.getI32(location()) }

// A system call's result as C returns it: -1 with errno on failure.
pub fn check(value: isize) -> isize {
    if sys.failed(value) {
        set(@intCast(i32, 0 - value))
        return -1
    }
    return value
}

pub fn checkInt(value: isize) -> i32 { return @intCast(i32, check(value)) }

// A result that is 0 on success and -1 with errno otherwise.
pub fn checkStatus(value: isize) -> i32 {
    if sys.failed(value) {
        set(@intCast(i32, 0 - value))
        return -1
    }
    return 0
}

// For the functions that return the error number itself (pthread_*).
pub fn code(value: isize) -> i32 {
    if sys.failed(value) { return @intCast(i32, 0 - value) }
    return 0
}

pub fn failWith(error_code: i32) -> i32 {
    set(error_code)
    return -1
}

pub export fn __errno_location() -> usize { return location() }
