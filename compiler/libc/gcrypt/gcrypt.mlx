// libmlxgcrypt.so: libgcrypt's C API (1.10, declared by the modules of
// api/, whose C headers mlx-cheaders makes), the part WebKit's WebCrypto
// and PAL's digests call, in Mlx over std.crypto:
//
//     ./mlx build gcrypt
//
// The parts: common.mlx (memory, errors, the version, gcry_control,
// random numbers, C's variable arguments), md.mlx (digests, HMAC,
// PBKDF2), cipher.mlx (AES in ECB, CBC, CTR, GCM and key wrap), mpi.mlx
// (multi-precision integers), sexp.mlx (S-expressions), ec.mlx (curves,
// points and contexts), pk.mlx (RSA, ECDSA, ECDH, EdDSA).
const common = @import("./common.mlx")
const md = @import("./md.mlx")
const cipher = @import("./cipher.mlx")
const mpi = @import("./mpi.mlx")
const sexp = @import("./sexp.mlx")
const ec = @import("./ec.mlx")
const pk = @import("./pk.mlx")
