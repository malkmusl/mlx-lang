// Message digests (gcry_md_*), MACs (gcry_mac_*: HMAC) and key
// derivation (gcry_kdf_derive: PBKDF2), on std.crypto.hash: SHA-1,
// SHA-224, SHA-256, SHA-384 and SHA-512, libgcrypt's numbers for them.
//
// A digest handle hashes until it is finalized (gcry_md_final, or the
// first gcry_md_read), and then holds its digest; one opened with
// GCRY_MD_FLAG_HMAC is an HMAC keyed by gcry_md_setkey. A MAC handle
// keeps its keyed state, so gcry_mac_reset starts a new MAC with the
// same key, as HKDF's expansion does.
const c = @import("./common.mlx")
const hash = @import("std.crypto.hash")

// libgcrypt's numbers of the hashes and HMACs.
pub const MD_SHA1: i32 = 2
pub const MD_SHA256: i32 = 8
pub const MD_SHA384: i32 = 9
pub const MD_SHA512: i32 = 10
pub const MD_SHA224: i32 = 11

const MD_FLAG_HMAC: u32 = 2

// The hash of a libgcrypt number; false for one that is not here.
pub fn algorithmOf(algo: i32, out: *hash.Algorithm) -> bool {
    if algo == MD_SHA1 {
        out.* = hash.Algorithm.sha1
        return true
    }
    if algo == MD_SHA256 {
        out.* = hash.Algorithm.sha256
        return true
    }
    if algo == MD_SHA384 {
        out.* = hash.Algorithm.sha384
        return true
    }
    if algo == MD_SHA512 {
        out.* = hash.Algorithm.sha512
        return true
    }
    if algo == MD_SHA224 {
        out.* = hash.Algorithm.sha224
        return true
    }
    return false
}

// Whether `name` is `lower` (lowercase letters and digits), case aside.
fn sameFolded(name: []const u8, lower: []const u8) -> bool {
    if name.length != lower.length { return false }
    var index: usize = 0
    while index < name.length {
        var byte = name[index]
        if byte >= 65 && byte <= 90 { byte += 32 }
        if byte != lower[index] { return false }
        index += 1
    }
    return true
}

// A hash's name as libgcrypt spells it ("SHA256"; S-expressions write
// "sha256"), case aside: its libgcrypt number, 0 for none. libgcrypt
// knows no "SHA-256" spelling, so neither does this.
pub fn numberOfName(name: []const u8) -> i32 {
    if sameFolded(name, "sha1") { return MD_SHA1 }
    if sameFolded(name, "sha256") { return MD_SHA256 }
    if sameFolded(name, "sha384") { return MD_SHA384 }
    if sameFolded(name, "sha512") { return MD_SHA512 }
    if sameFolded(name, "sha224") { return MD_SHA224 }
    return 0
}

const MdHandle = struct {
    algo: i32
    algorithm: hash.Algorithm
    hmac: bool
    keyed: bool
    finished: bool
    state: hash.Hash
    keyedState: hash.Hmac
    initial: hash.Hmac
    digest: [64]u8
}

fn mdOf(handle: usize) -> *MdHandle { unsafe { return @ptrFromInt(*MdHandle, handle) } }

fn mdStart(md: *MdHandle) -> void {
    md.*.finished = false
    if md.*.hmac {
        if md.*.keyed { md.*.keyedState = md.*.initial }
    } else {
        hash.init(&md.*.state, md.*.algorithm)
    }
}

export fn gcry_md_open(out: usize, algo: i32, flags: u32) -> u32 {
    c.putWord(out, 0)
    var algorithm = hash.Algorithm.sha256
    if !algorithmOf(algo, &algorithm) { return c.failure(c.DIGEST_ALGO) }
    if (flags & 4294967292) != 0 && (flags & 256) == 0 { return c.failure(c.INV_ARG) }
    const handle = c.alloc(@sizeOf(MdHandle))
    if handle == 0 { return c.failure(c.ENOMEM) }
    const md = mdOf(handle)
    md.*.algo = algo
    md.*.algorithm = algorithm
    md.*.hmac = (flags & MD_FLAG_HMAC) != 0
    md.*.keyed = false
    mdStart(md)
    c.putWord(out, handle)
    return 0
}

export fn gcry_md_close(handle: usize) -> void { c.wipeRelease(handle, @sizeOf(MdHandle)) }

// One hash a handle: the one it was opened with is the only one.
export fn gcry_md_enable(handle: usize, algo: i32) -> u32 {
    if handle == 0 { return c.failure(c.INV_ARG) }
    if algo == mdOf(handle).*.algo { return 0 }
    return c.failure(c.NOT_SUPPORTED)
}

export fn gcry_md_copy(out: usize, handle: usize) -> u32 {
    c.putWord(out, 0)
    const copied = c.alloc(@sizeOf(MdHandle))
    if copied == 0 { return c.failure(c.ENOMEM) }
    mdOf(copied).* = mdOf(handle).*
    c.putWord(out, copied)
    return 0
}

export fn gcry_md_reset(handle: usize) -> void { mdStart(mdOf(handle)) }

export fn gcry_md_setkey(handle: usize, key: usize, length: usize) -> u32 {
    const md = mdOf(handle)
    if !md.*.hmac { return c.failure(c.CONFLICT) }
    hash.hmacInit(&md.*.initial, md.*.algorithm, c.slice(key, length))
    md.*.keyed = true
    mdStart(md)
    return 0
}

export fn gcry_md_write(handle: usize, buffer: usize, length: usize) -> void {
    const md = mdOf(handle)
    if md.*.finished || length == 0 { return }
    if md.*.hmac {
        if md.*.keyed { hash.hmacUpdate(&md.*.keyedState, c.slice(buffer, length)) }
    } else {
        hash.update(&md.*.state, c.slice(buffer, length))
    }
}

fn mdFinish(md: *MdHandle) -> void {
    if md.*.finished { return }
    md.*.finished = true
    const out: [*]u8 = &md.*.digest
    if md.*.hmac {
        hash.hmacFinish(&md.*.keyedState, out)
    } else {
        hash.finish(&md.*.state, out)
    }
}

// GCRYCTL_FINALIZE (5) and GCRYCTL_RESET (4).
export fn gcry_md_ctl(handle: usize, cmd: i32, buffer: usize, length: usize) -> u32 {
    if handle == 0 { return c.failure(c.INV_ARG) }
    const md = mdOf(handle)
    if cmd == 5 {
        mdFinish(md)
        return 0
    }
    if cmd == 4 {
        mdStart(md)
        return 0
    }
    return c.failure(c.INV_OP)
}

export fn gcry_md_read(handle: usize, algo: i32) -> usize {
    if handle == 0 { return 0 }
    const md = mdOf(handle)
    if algo != 0 && algo != md.*.algo { return 0 }
    mdFinish(md)
    return @intFromPtr(&md.*.digest)
}

export fn gcry_md_get_algo_dlen(algo: i32) -> u32 {
    var algorithm = hash.Algorithm.sha256
    if !algorithmOf(algo, &algorithm) { return 0 }
    return @intCast(u32, hash.digestLength(algorithm))
}

export fn gcry_md_hash_buffer(algo: i32, digest: usize, buffer: usize, length: usize) -> void {
    var algorithm = hash.Algorithm.sha256
    if !algorithmOf(algo, &algorithm) { return }
    hash.digest(algorithm, c.slice(buffer, length), c.bytes(digest))
}

export fn gcry_md_map_name(name: usize) -> i32 {
    if name == 0 { return 0 }
    return numberOfName(c.cSlice(name))
}

export fn gcry_md_algo_name(algo: i32) -> usize {
    const name = match algo {
        2 => "SHA1\x00",
        8 => "SHA256\x00",
        9 => "SHA384\x00",
        10 => "SHA512\x00",
        11 => "SHA224\x00",
        else => "?\x00",
    }
    return @intFromPtr(name.pointer)
}

// ---------------------------------------------------------------------------
// MACs: HMAC with the SHA hashes (GCRY_MAC_HMAC_SHA256 = 101, SHA224 102,
// SHA512 103, SHA384 104, SHA1 105).

fn macAlgorithm(algo: i32, out: *hash.Algorithm) -> bool {
    if algo == 101 { return algorithmOf(MD_SHA256, out) }
    if algo == 102 { return algorithmOf(MD_SHA224, out) }
    if algo == 103 { return algorithmOf(MD_SHA512, out) }
    if algo == 104 { return algorithmOf(MD_SHA384, out) }
    if algo == 105 { return algorithmOf(MD_SHA1, out) }
    return false
}

const MacHandle = struct {
    algorithm: hash.Algorithm
    keyed: bool
    finished: bool
    state: hash.Hmac
    initial: hash.Hmac
    mac: [64]u8
}

fn macOf(handle: usize) -> *MacHandle { unsafe { return @ptrFromInt(*MacHandle, handle) } }

export fn gcry_mac_open(out: usize, algo: i32, flags: u32, ctx: usize) -> u32 {
    c.putWord(out, 0)
    var algorithm = hash.Algorithm.sha256
    if !macAlgorithm(algo, &algorithm) { return c.failure(c.MAC_ALGO) }
    const handle = c.alloc(@sizeOf(MacHandle))
    if handle == 0 { return c.failure(c.ENOMEM) }
    macOf(handle).*.algorithm = algorithm
    c.putWord(out, handle)
    return 0
}

export fn gcry_mac_close(handle: usize) -> void { c.wipeRelease(handle, @sizeOf(MacHandle)) }

export fn gcry_mac_setkey(handle: usize, key: usize, length: usize) -> u32 {
    const mac = macOf(handle)
    hash.hmacInit(&mac.*.initial, mac.*.algorithm, c.slice(key, length))
    mac.*.state = mac.*.initial
    mac.*.keyed = true
    mac.*.finished = false
    return 0
}

export fn gcry_mac_write(handle: usize, buffer: usize, length: usize) -> u32 {
    const mac = macOf(handle)
    if !mac.*.keyed { return c.failure(c.MISSING_KEY) }
    if mac.*.finished { return c.failure(c.INV_STATE) }
    if length > 0 { hash.hmacUpdate(&mac.*.state, c.slice(buffer, length)) }
    return 0
}

fn macFinish(mac: *MacHandle) -> void {
    if mac.*.finished { return }
    mac.*.finished = true
    const out: [*]u8 = &mac.*.mac
    hash.hmacFinish(&mac.*.state, out)
}

// The MAC into `buffer`, `length` (in and out) bytes of it at most.
export fn gcry_mac_read(handle: usize, buffer: usize, length: usize) -> u32 {
    const mac = macOf(handle)
    if !mac.*.keyed { return c.failure(c.MISSING_KEY) }
    macFinish(mac)
    var count = c.getWord(length)
    const size = hash.digestLength(mac.*.algorithm)
    if count > size { count = size }
    c.copy(buffer, @intFromPtr(&mac.*.mac), count)
    c.putWord(length, count)
    return 0
}

export fn gcry_mac_verify(handle: usize, buffer: usize, length: usize) -> u32 {
    const mac = macOf(handle)
    if !mac.*.keyed { return c.failure(c.MISSING_KEY) }
    macFinish(mac)
    const size = hash.digestLength(mac.*.algorithm)
    if length == 0 || length > size { return c.failure(c.INV_LENGTH) }
    if !hash.equal(&mac.*.mac, c.bytes(buffer), length) { return c.failure(c.CHECKSUM) }
    return 0
}

// GCRYCTL_RESET (4): a new MAC with the same key.
export fn gcry_mac_ctl(handle: usize, cmd: i32, buffer: usize, length: usize) -> u32 {
    const mac = macOf(handle)
    if cmd == 4 {
        if mac.*.keyed { mac.*.state = mac.*.initial }
        mac.*.finished = false
        return 0
    }
    return c.failure(c.INV_OP)
}

export fn gcry_mac_get_algo_maclen(algo: i32) -> u32 {
    var algorithm = hash.Algorithm.sha256
    if !macAlgorithm(algo, &algorithm) { return 0 }
    return @intCast(u32, hash.digestLength(algorithm))
}

export fn gcry_mac_get_algo_keylen(algo: i32) -> u32 {
    var algorithm = hash.Algorithm.sha256
    if !macAlgorithm(algo, &algorithm) { return 0 }
    return @intCast(u32, hash.digestLength(algorithm))
}

// ---------------------------------------------------------------------------
// PBKDF2 (RFC 8018, 5.2) with HMAC of the hash `subalgo` (GCRY_KDF_PBKDF2,
// 34): T_i = U_1 ^ ... ^ U_c, U_1 = PRF(P, S | INT(i)), U_j = PRF(P, U_j-1).

export fn gcry_kdf_derive(passphrase: usize, length: usize, algo: i32, subalgo: i32, salt: usize, saltLength: usize, iterations: u64, keySize: usize, key: usize) -> u32 {
    if algo != 34 { return c.failure(c.UNKNOWN_ALGORITHM) }
    var algorithm = hash.Algorithm.sha256
    if !algorithmOf(subalgo, &algorithm) { return c.failure(c.DIGEST_ALGO) }
    // libgcrypt refuses an empty salt as well as no iterations.
    if iterations == 0 || keySize == 0 || salt == 0 || saltLength == 0 { return c.failure(c.INV_VALUE) }
    const state = c.alloc(2 * @sizeOf(hash.Hmac))
    if state == 0 { return c.failure(c.ENOMEM) }
    const keyed: *hash.Hmac = unsafe { @ptrFromInt(*hash.Hmac, state) }
    const running: *hash.Hmac = unsafe { @ptrFromInt(*hash.Hmac, state + @sizeOf(hash.Hmac)) }
    hash.hmacKey(keyed, algorithm, c.bytes(passphrase), length)
    const size = hash.digestLength(algorithm)
    var u: [64]u8 = undefined
    var t: [64]u8 = undefined
    const up: [*]u8 = &u
    var counter: [4]u8 = undefined
    const count: [*]const u8 = &counter
    var block: u64 = 1
    var made: usize = 0
    while made < keySize {
        counter[0] = @intCast(u8, (block >> 24) & 255)
        counter[1] = @intCast(u8, (block >> 16) & 255)
        counter[2] = @intCast(u8, (block >> 8) & 255)
        counter[3] = @intCast(u8, block & 255)
        running.* = keyed.*
        if saltLength > 0 { hash.hmacAbsorb(running, c.bytes(salt), saltLength) }
        hash.hmacAbsorb(running, count, 4)
        hash.hmacFinish(running, up)
        var index: usize = 0
        while index < size {
            t[index] = u[index]
            index += 1
        }
        var round: u64 = 1
        while round < iterations {
            running.* = keyed.*
            hash.hmacAbsorb(running, up, size)
            hash.hmacFinish(running, up)
            index = 0
            while index < size {
                t[index] = t[index] ^ u[index]
                index += 1
            }
            round += 1
        }
        index = 0
        while index < size && made < keySize {
            c.put8(key + made, t[index])
            made += 1
            index += 1
        }
        block += 1
    }
    c.wipeRelease(state, 2 * @sizeOf(hash.Hmac))
    hash.wipe(up, 64)
    return 0
}
