// The generator of mlx-spirv's API modules (compiler/libc/spirv/api), from
// the SPIR-V grammars std.spirv is made of (std/registry/spirv, read by
// std.spirv.materialize):
//
//   generate            (re)writes api/spirv.mlx and api/glsl_std_450.mlx
//   generate --check    fails when either is not what it would write
//
// Run from the repository root (generate.sh). mlx-cheaders makes of them
// what SPIRV-Headers' generator makes of the grammars:
// spirv/unified1/spirv.hpp (C++, namespace spv: Id, MagicNumber and the
// version words, each value enumeration as `KindName = value`, each bit
// enumeration as KindShift and KindMask with its operators, Op; every
// alias the grammar has) and spirv/unified1/GLSL.std.450.h (the
// GLSLstd450 enumeration of the extended instructions).
const std = @import("std")
const spirv = @import("std.spirv.materialize")

const ArrayList = std.array_list.ArrayList
const String = std.string.String

const CORE = "std/registry/spirv/spirv.core.grammar.json"
const GLSL = "std/registry/spirv/extinst.glsl.std.450.grammar.json"
const SPIRV_OUTPUT = "compiler/libc/spirv/api/spirv.mlx"
const GLSL_OUTPUT = "compiler/libc/spirv/api/glsl_std_450.mlx"

fn put(out: *ArrayList, text: []const u8) -> void {
    for byte in text { _ = ArrayList.appendAt(out, byte) }
}

fn putByte(out: *ArrayList, byte: u8) -> void { _ = ArrayList.appendAt(out, byte) }

fn putString(out: *ArrayList, value: String) -> void {
    var index: usize = 0
    while index < value.length {
        putByte(out, value.pointer[index])
        index += 1
    }
}

fn putUnsigned(out: *ArrayList, value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    if rest == 0 {
        putByte(out, 48)
        return
    }
    while rest > 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest = rest / 10
        count += 1
    }
    while count > 0 {
        count -= 1
        putByte(out, digits[count])
    }
}

fn putHex(out: *ArrayList, value: u64) -> void {
    put(out, "0x")
    var shift: u64 = 28
    while true {
        const digit = @intCast(u8, (value >> @intCast(u6, shift)) & 15)
        putByte(out, if digit < 10 { 48 + digit } else { 87 + digit })
        if shift == 0 { break }
        shift -= 4
    }
}

fn equals(value: String, text: []const u8) -> bool { return std.string.eql(value, std.string.fromSlice(text)) }

// One member `PrefixName = value,` and one for each of the enumerant's
// aliases.
fn putMembers(out: *ArrayList, grammar: *const spirv.Grammar, prefix: String, name: String, suffix: []const u8, aliasStart: usize, aliasCount: usize, value: u64, hex: bool) -> void {
    var index: usize = 0
    while index <= aliasCount {
        put(out, "    ")
        putString(out, prefix)
        putString(out, if index == 0 { name } else { spirv.aliasAt(grammar, aliasStart + index - 1) })
        put(out, suffix)
        put(out, " = ")
        if hex { putHex(out, value) } else { putUnsigned(out, value) }
        put(out, ",\n")
        index += 1
    }
}

fn bitIndex(value: u64) -> u64 {
    var index: u64 = 0
    while index < 63 && (value >> @intCast(u6, index)) != 1 { index += 1 }
    return index
}

fn emitSpirv(out: *ArrayList, grammar: *const spirv.Grammar) -> void {
    put(out, "// spirv/unified1/spirv.hpp\n")
    put(out, "// mlx-spirv: SPIR-V's enumerations for C++, in namespace spv, as\n")
    put(out, "// SPIRV-Headers' spirv.hpp has them (SPIR-V ")
    putUnsigned(out, grammar.*.major)
    putByte(out, 46)
    putUnsigned(out, grammar.*.minor)
    put(out, " revision ")
    putUnsigned(out, grammar.*.revision)
    put(out, "): the value enumerations\n// (`StorageClassInput`), the bit enumerations as Shift and Mask with their\n")
    put(out, "// operators, the opcodes (`OpTypeVoid`), every alias the grammar names.\n")
    put(out, "//\n// GENERATED by compiler/libc/spirv/generate.sh from\n// std/registry/spirv/spirv.core.grammar.json -- do not edit.\n")
    put(out, "const c_namespace = \"spv\"\nconst c_tokens = usize\nconst c_uint = u32\n\n")
    put(out, "pub const SPV_VERSION: c_tokens = \"")
    putHex(out, (grammar.*.major << 16) | (grammar.*.minor << 8))
    put(out, "\"\npub const SPV_REVISION: c_tokens = \"")
    putUnsigned(out, grammar.*.revision)
    put(out, "\"\n\npub const Id = c_uint\n\npub const MagicNumber: c_uint = ")
    putHex(out, grammar.*.magic)
    put(out, "\npub const Version: c_uint = ")
    putHex(out, (grammar.*.major << 16) | (grammar.*.minor << 8))
    put(out, "\npub const Revision: c_uint = ")
    putUnsigned(out, grammar.*.revision)
    put(out, "\npub const OpCodeMask: c_uint = 0xffff\npub const WordCountShift: c_uint = 16\n")
    var masks = ArrayList.init(std.heap.allocator(), 1 << 14)
    var kind: usize = 0
    while kind < grammar.*.kinds.length {
        const k = spirv.kindAt(grammar, kind)
        if k.*.category == spirv.CATEGORY_VALUE_ENUM {
            put(out, "\npub const ")
            putString(out, k.*.name)
            put(out, " = enum(u32) {\n")
            var e: usize = 0
            while e < k.*.enumerantCount {
                const enumerant = spirv.enumerantAt(grammar, k.*.enumerantStart + e)
                putMembers(out, grammar, k.*.name, enumerant.*.name, "", enumerant.*.aliasStart, enumerant.*.aliasCount, enumerant.*.value, false)
                e += 1
            }
            put(out, "    ")
            putString(out, k.*.name)
            put(out, "Max = 0x7fffffff,\n}\n")
        } else if k.*.category == spirv.CATEGORY_BIT_ENUM {
            put(out, "\npub const ")
            putString(out, k.*.name)
            put(out, "Shift = enum(u32) {\n")
            var e: usize = 0
            while e < k.*.enumerantCount {
                const enumerant = spirv.enumerantAt(grammar, k.*.enumerantStart + e)
                if enumerant.*.value != 0 { putMembers(out, grammar, k.*.name, enumerant.*.name, "Shift", enumerant.*.aliasStart, enumerant.*.aliasCount, bitIndex(enumerant.*.value), false) }
                e += 1
            }
            put(out, "    ")
            putString(out, k.*.name)
            put(out, "Max = 0x7fffffff,\n}\n\npub const ")
            putString(out, k.*.name)
            put(out, "Mask = enum(u32) {\n    ")
            putString(out, k.*.name)
            put(out, "MaskNone = 0,\n")
            e = 0
            while e < k.*.enumerantCount {
                const enumerant = spirv.enumerantAt(grammar, k.*.enumerantStart + e)
                if enumerant.*.value != 0 { putMembers(out, grammar, k.*.name, enumerant.*.name, "Mask", enumerant.*.aliasStart, enumerant.*.aliasCount, enumerant.*.value, true) }
                e += 1
            }
            put(out, "}\n")
            // (C++'s operators of a mask, in the namespace: c_macros.)
            const operators = [3][]const u8{ "|", "&", "^" }
            for operator in operators {
                put(&masks, "constexpr ")
                putString(&masks, k.*.name)
                put(&masks, "Mask operator")
                put(&masks, operator)
                putByte(&masks, 40)
                putString(&masks, k.*.name)
                put(&masks, "Mask a, ")
                putString(&masks, k.*.name)
                put(&masks, "Mask b) { return ")
                putString(&masks, k.*.name)
                put(&masks, "Mask(unsigned(a) ")
                put(&masks, operator)
                put(&masks, " unsigned(b)); }\\n")
            }
            put(&masks, "constexpr ")
            putString(&masks, k.*.name)
            put(&masks, "Mask operator~(")
            putString(&masks, k.*.name)
            put(&masks, "Mask a) { return ")
            putString(&masks, k.*.name)
            put(&masks, "Mask(~unsigned(a)); }\\n")
        }
        kind += 1
    }
    put(out, "\npub const Op = enum(u32) {\n")
    var index: usize = 0
    while index < grammar.*.instructions.length {
        const instruction = spirv.instructionAt(grammar, index)
        putMembers(out, grammar, std.string.fromSlice(""), instruction.*.name, "", instruction.*.aliasStart, instruction.*.aliasCount, @intCast(u64, instruction.*.opcode), false)
        index += 1
    }
    put(out, "    OpMax = 0x7fffffff,\n}\n\n// The masks' operators.\nconst c_macros = \"")
    var at: usize = 0
    while at < masks.length {
        putByte(out, masks.items[at])
        at += 1
    }
    put(out, "\"\n")
}

fn emitGlsl(out: *ArrayList, grammar: *const spirv.Grammar) -> void {
    put(out, "// spirv/unified1/GLSL.std.450.h\n")
    put(out, "// mlx-spirv: the GLSL.std.450 extended instruction set's instructions, as\n")
    put(out, "// SPIRV-Headers' GLSL.std.450.h has them (GLSLstd450Round...).\n")
    put(out, "//\n// GENERATED by compiler/libc/spirv/generate.sh from\n// std/registry/spirv/extinst.glsl.std.450.grammar.json -- do not edit.\n")
    put(out, "const c_int = i32\n\npub const GLSLstd450Version: c_int = 100\npub const GLSLstd450Revision: c_int = ")
    putUnsigned(out, grammar.*.revision)
    put(out, "\n\npub const GLSLstd450 = enum(i32) {\n    GLSLstd450Bad = 0,\n")
    var highest: u64 = 0
    var index: usize = 0
    while index < grammar.*.instructions.length {
        const instruction = spirv.instructionAt(grammar, index)
        putMembers(out, grammar, std.string.fromSlice("GLSLstd450"), instruction.*.name, "", instruction.*.aliasStart, instruction.*.aliasCount, @intCast(u64, instruction.*.opcode), false)
        if @intCast(u64, instruction.*.opcode) > highest { highest = @intCast(u64, instruction.*.opcode) }
        index += 1
    }
    put(out, "    GLSLstd450Count = ")
    putUnsigned(out, highest + 1)
    put(out, ",\n}\n")
}

fn readFile(path: []const u8, allocator: std.allocator.Allocator, result: *ArrayList) -> bool {
    var loaded: ?ArrayList = null
    unsafe { loaded = std.fs.readFileAlloc(@ptrCast([*]const u8, path), allocator) }
    if loaded == null { return false }
    result.* = loaded.?
    return true
}

fn sameContents(left: *const ArrayList, right: *const ArrayList) -> bool {
    if left.*.length != right.*.length { return false }
    var index: usize = 0
    while index < left.*.length {
        if left.*.items[index] != right.*.items[index] { return false }
        index += 1
    }
    return true
}

fn finish(path: []const u8, out: *ArrayList, check: bool, allocator: std.allocator.Allocator) -> bool {
    if check {
        var existing: ArrayList = undefined
        if !readFile(path, allocator, &existing) || !sameContents(&existing, out) {
            _ = std.io.writeAll(std.io.stderr(), "stale generated file: ")
            _ = std.io.writeAll(std.io.stderr(), path)
            _ = std.io.writeAll(std.io.stderr(), "\n")
            return false
        }
        return true
    }
    var file = std.fs.open(unsafe { @ptrFromInt([*]const u8, 0) }, 0, 0)
    unsafe { file = std.fs.open(@ptrCast([*]const u8, path), 577, 420) }
    if !std.fs.isValid(file) { return false }
    const written = std.fs.writeAllBytes(file, out.*.items, out.*.length)
    _ = std.fs.close(file)
    return written
}

fn load(path: []const u8, core: bool, grammar: *spirv.Grammar, allocator: std.allocator.Allocator) -> bool {
    var source: ArrayList = undefined
    if !readFile(path, allocator, &source) {
        _ = std.io.writeAll(std.io.stderr(), "generate: cannot read ")
        _ = std.io.writeAll(std.io.stderr(), path)
        _ = std.io.writeAll(std.io.stderr(), "\n")
        return false
    }
    const parsed = if core { spirv.parse(grammar, allocator, source.items, source.length) } else { spirv.parseInstructionSet(grammar, allocator, source.items, source.length) }
    if !parsed {
        _ = std.io.writeAll(std.io.stderr(), "generate: ")
        _ = std.io.writeAll(std.io.stderr(), path)
        _ = std.io.writeAll(std.io.stderr(), " does not parse: ")
        _ = std.io.writeString(std.io.stderr(), grammar.*.failure)
        _ = std.io.writeAll(std.io.stderr(), "\n")
        return false
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.heap.allocator()
    var check = false
    if std.process.count(arguments) > 1 {
        check = std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("--check"))
        if !check {
            _ = std.io.writeAll(std.io.stderr(), "usage: generate [--check]\n")
            return 2
        }
    }
    var core: spirv.Grammar = undefined
    var glsl: spirv.Grammar = undefined
    if !load(CORE, true, &core, allocator) || !load(GLSL, false, &glsl, allocator) { return 1 }
    var spirvOut = ArrayList.init(allocator, 1 << 21)
    emitSpirv(&spirvOut, &core)
    var glslOut = ArrayList.init(allocator, 1 << 14)
    emitGlsl(&glslOut, &glsl)
    if !finish(SPIRV_OUTPUT, &spirvOut, check, allocator) { return 1 }
    if !finish(GLSL_OUTPUT, &glslOut, check, allocator) { return 1 }
    if !check { _ = std.io.writeAll(std.io.stderr(), "generated compiler/libc/spirv/api/spirv.mlx and glsl_std_450.mlx\n") }
    return 0
}
