// A library (FT_Library): std.truetype's library (its memory, LCD filter
// and the properties of its CFF driver: the first part of the record,
// so that an FT_Library is the engine's library too), its modules, the
// TrueType driver's property, and the faces it has open
// (FT_Done_Library closes those still open).
//
// The modules are the library's own: "truetype" (TrueType outlines),
// "cff" (CFF and CFF2), "sfnt" (the SFNT container), "smooth" and
// "raster" (the anti-aliasing and the monochrome rasterizer), "psaux"
// and "psnames". FT_New_Library makes a library without them, as
// FreeType's does; FT_Add_Default_Modules adds them.
const m = @import("std.truetype.memory")
const r = @import("std.truetype.records")
const engine = @import("std.truetype.library")

pub const Library = struct {
    engine: engine.Library
    // The FT_MemoryRec FT_Init_FreeType made, freed with the library.
    ownMemory: usize
    refcount: i64
    // The modules, in a block of pointers.
    modules: usize
    numModules: i64
    // The faces open (their records' `nextFace`).
    faces: usize
    // The TrueType driver's property (the library has no bytecode
    // interpreter: it is only kept) and the CFF driver's hinting engine.
    interpreterVersion: i64
    hintingEngine: i64
}

pub fn lib(address: usize) -> *Library { unsafe { return @ptrFromInt(*Library, address) } }

// The memory of an FT_Library (its first word, the engine's memory).
pub fn memoryOf(library: usize) -> usize { return m.getWord(library) }

// ---------------------------------------------------------------------------
// Modules: [class, library, memory], the class an FT_Module_Class.

const MODULE_FONT_DRIVER: u64 = 1
const MODULE_RENDERER: u64 = 2
const MODULE_DRIVER_SCALABLE: u64 = 0x100
const MODULE_DRIVER_HAS_HINTER: u64 = 0x400
const MODULE_DRIVER_HINTS_LIGHTLY: u64 = 0x800

fn moduleName(index: i64) -> []const u8 {
    return match index {
        0 => "truetype"
        1 => "cff"
        2 => "sfnt"
        3 => "smooth"
        4 => "raster"
        5 => "psaux"
        else => "psnames"
    }
}

fn moduleFlags(index: i64) -> u64 {
    if index == 0 { return MODULE_FONT_DRIVER | MODULE_DRIVER_SCALABLE }
    if index == 1 { return MODULE_FONT_DRIVER | MODULE_DRIVER_SCALABLE | MODULE_DRIVER_HAS_HINTER | MODULE_DRIVER_HINTS_LIGHTLY }
    if index == 3 || index == 4 { return MODULE_RENDERER }
    return 0
}

pub const NUM_MODULES: i64 = 7
pub const TRUETYPE: i64 = engine.TRUETYPE
pub const CFF: i64 = engine.CFF

fn addModules(library: usize) -> void {
    const l = lib(library)
    if l.*.numModules != 0 { return }
    const memory = memoryOf(library)
    const block = m.alloc(memory, @intCast(usize, NUM_MODULES) * 8)
    if block == 0 { return }
    var i: i64 = 0
    while i < NUM_MODULES {
        const clazz = m.alloc(memory, 72 + 24)
        if clazz == 0 { break }
        const module = clazz + 72
        m.put64(clazz, moduleFlags(i))
        m.putI64(clazz + 8, 24)
        m.putWord(clazz + 16, m.literal(moduleName(i)))
        m.putI64(clazz + 24, 0x10000)
        m.putI64(clazz + 32, 0x20000)
        m.putWord(module, clazz)
        m.putWord(module + 8, library)
        m.putWord(module + 16, memory)
        m.putWord(block + @intCast(usize, i) * 8, module)
        i += 1
    }
    l.*.modules = block
    l.*.numModules = i
    // (The anti-aliasing renderer's start: FreeType's default LCD filter.)
    _ = engine.setLcdFilter(&l.*.engine, 1)
}

// The module `index` of the library (0 when it has not been added).
pub fn module(library: usize, index: i64) -> usize {
    const l = lib(library)
    if index >= l.*.numModules { return 0 }
    return m.getWord(l.*.modules + @intCast(usize, index) * 8)
}

pub fn findModule(library: usize, name: usize) -> i64 {
    const l = lib(library)
    var i: i64 = 0
    while i < l.*.numModules {
        const mod = m.getWord(l.*.modules + @intCast(usize, i) * 8)
        if m.cEqual(m.getWord(m.getWord(mod) + 16), name) { return i }
        i += 1
    }
    return -1
}

fn removeModules(library: usize) -> void {
    const l = lib(library)
    var i: i64 = 0
    while i < l.*.numModules {
        // (The class and the module are one block.)
        m.release(memoryOf(library), m.getWord(m.getWord(l.*.modules + @intCast(usize, i) * 8)))
        i += 1
    }
    m.release(memoryOf(library), l.*.modules)
    l.*.modules = 0
    l.*.numModules = 0
}

// ---------------------------------------------------------------------------
// The C library's allocator as an FT_Memory (FT_Init_FreeType's).

extern("c") fn malloc(size: usize) -> usize
extern("c") fn calloc(count: usize, size: usize) -> usize
extern("c") fn realloc(address: usize, size: usize) -> usize
extern("c") fn free(address: usize) -> void
extern("c") fn getenv(name: usize) -> usize

export fn __mlx_freetype_alloc(memory: usize, size: i64) -> usize { return malloc(if size <= 0 { 1 } else { @intCast(usize, size) }) }
export fn __mlx_freetype_free(memory: usize, block: usize) -> void { if block != 0 { free(block) } }
export fn __mlx_freetype_realloc(memory: usize, current: i64, size: i64, block: usize) -> usize { return realloc(block, if size <= 0 { 1 } else { @intCast(usize, size) }) }

fn newMemory() -> usize {
    const memory = calloc(1, 32)
    if memory == 0 { return 0 }
    m.putWord(memory + 8, @intFromPtr(__mlx_freetype_alloc))
    m.putWord(memory + 16, @intFromPtr(__mlx_freetype_free))
    m.putWord(memory + 24, @intFromPtr(__mlx_freetype_realloc))
    return memory
}

pub fn newLibrary(memory: usize) -> usize {
    const library = m.alloc(memory, @sizeOf(Library))
    if library == 0 { return 0 }
    const l = lib(library)
    engine.init(&l.*.engine, memory)
    l.*.refcount = 1
    l.*.interpreterVersion = 40
    l.*.hintingEngine = 1
    return library
}

// Closes a face of the library (the face module's: it imports this one).
pub const DoneFace = fn(usize) -> void
pub var doneFace: usize = 0

fn doneLibrary(library: usize) -> void {
    const l = lib(library)
    l.*.refcount -= 1
    if l.*.refcount > 0 { return }
    // (Each face, until none is left: closing one takes it off the list.)
    while l.*.faces != 0 && doneFace != 0 {
        const call: DoneFace = unsafe { @ptrFromInt(DoneFace, doneFace) }
        call(l.*.faces)
    }
    removeModules(library)
    const own = l.*.ownMemory
    m.release(memoryOf(library), library)
    if own != 0 { free(own) }
}

// ---------------------------------------------------------------------------
// Properties.

const PROPERTY_SET: i64 = 1
const PROPERTY_STRING: i64 = 2

// A decimal number of a C string (as strtol reads it: leading spaces, a
// sign, digits); the address after it in `end`.
fn decimal(text: usize, end: usize) -> i64 {
    var p = text
    while m.get8(p) == 32 || m.get8(p) == 9 { p += 1 }
    var negative = false
    if m.get8(p) == 45 {
        negative = true
        p += 1
    } else if m.get8(p) == 43 {
        p += 1
    }
    var value: i64 = 0
    const start = p
    while m.get8(p) >= 48 && m.get8(p) <= 57 {
        value = value *% 10 +% @intCast(i64, m.get8(p) - 48)
        p += 1
    }
    if end != 0 { m.putWord(end, if p == start { text } else { p }) }
    return if negative { 0 - value } else { value }
}

fn property(library: usize, module_name: usize, property_name: usize, value: usize, mode: i64) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if module_name == 0 || property_name == 0 || value == 0 { return r.ERR_INVALID_ARGUMENT }
    const index = findModule(library, module_name)
    if index < 0 { return r.ERR_MISSING_MODULE }
    const l = lib(library)
    const set = (mode & PROPERTY_SET) != 0
    const string = (mode & PROPERTY_STRING) != 0
    if index == TRUETYPE {
        if !m.cIs(property_name, "interpreter-version") { return r.ERR_MISSING_PROPERTY }
        if !set {
            m.put32(value, @intCast(u32, l.*.interpreterVersion))
            return r.OK
        }
        const version = if string { decimal(value, 0) } else { @intCast(i64, m.get32(value)) }
        if version == 35 {
            l.*.interpreterVersion = 35
        } else if version == 38 || version == 40 {
            l.*.interpreterVersion = 40
        } else {
            return r.ERR_UNIMPLEMENTED_FEATURE
        }
        return r.OK
    }
    if index != CFF { return r.ERR_UNIMPLEMENTED_FEATURE }
    if m.cIs(property_name, "darkening-parameters") {
        if !set {
            var i: usize = 0
            while i < 8 {
                m.putI32(value + i * 4, @intCast(i32, engine.darken(&l.*.engine, @intCast(i64, i))))
                i += 1
            }
            return r.OK
        }
        var dp = m.alloc(memoryOf(library), 64)
        if dp == 0 { return r.ERR_OUT_OF_MEMORY }
        if string {
            const endAt = dp + 56
            var s = value
            var i: usize = 0
            while i < 8 {
                m.putI64(dp + i * 8, decimal(s, endAt))
                const end = m.getWord(endAt)
                const c = m.get8(end)
                if end == s || (i < 7 && c != 44) || (i == 7 && !(c == 0 || c == 32)) {
                    m.release(memoryOf(library), dp)
                    return r.ERR_INVALID_ARGUMENT
                }
                s = end + 1
                i += 1
            }
        } else {
            var i: usize = 0
            while i < 8 {
                m.putI64(dp + i * 8, @intCast(i64, m.getI32(value + i * 4)))
                i += 1
            }
        }
        const valid = engine.setDarkening(&l.*.engine, dp)
        m.release(memoryOf(library), dp)
        if !valid { return r.ERR_INVALID_ARGUMENT }
        return r.OK
    }
    if m.cIs(property_name, "hinting-engine") {
        if !set {
            m.put32(value, @intCast(u32, l.*.hintingEngine))
            return r.OK
        }
        if string {
            if !m.cIs(value, "adobe") { return r.ERR_INVALID_ARGUMENT }
            l.*.hintingEngine = 1
            return r.OK
        }
        if m.get32(value) != 1 { return r.ERR_UNIMPLEMENTED_FEATURE }
        l.*.hintingEngine = 1
        return r.OK
    }
    if m.cIs(property_name, "no-stem-darkening") {
        if !set {
            m.put8(value, if l.*.engine.noStemDarkening { 1 } else { 0 })
            return r.OK
        }
        if string {
            l.*.engine.noStemDarkening = decimal(value, 0) != 0
        } else {
            l.*.engine.noStemDarkening = m.get8(value) != 0
        }
        return r.OK
    }
    if m.cIs(property_name, "random-seed") && set {
        var seed = if string { @intCast(i64, @bitCast(i32, @intCast(u32, @bitCast(u64, decimal(value, 0)) & 0xFFFFFFFF))) } else { @intCast(i64, m.getI32(value)) }
        if seed < 0 { seed = 0 }
        l.*.engine.randomSeed = seed
        return r.OK
    }
    return r.ERR_MISSING_PROPERTY
}

// FREETYPE_PROPERTIES: "module:property=value" separated by spaces.
fn defaultProperties(library: usize) -> void {
    const env = getenv(m.literal("FREETYPE_PROPERTIES"))
    if env == 0 { return }
    const memory = memoryOf(library)
    const names = m.alloc(memory, 3 * 129)
    if names == 0 { return }
    const moduleName_ = names
    const propertyName = names + 129
    const propertyValue = names + 258
    var p = env
    while m.get8(p) != 0 {
        if m.get8(p) == 32 || m.get8(p) == 9 {
            p += 1
            continue
        }
        var q = p
        var i: usize = 0
        while i < 128 && m.get8(p) != 0 && m.get8(p) != 58 {
            m.put8(moduleName_ + i, m.get8(p))
            p += 1
            i += 1
        }
        m.put8(moduleName_ + i, 0)
        if m.get8(p) != 58 || p == q { break }
        p += 1
        q = p
        i = 0
        while i < 128 && m.get8(p) != 0 && m.get8(p) != 61 {
            m.put8(propertyName + i, m.get8(p))
            p += 1
            i += 1
        }
        m.put8(propertyName + i, 0)
        if m.get8(p) != 61 || p == q { break }
        p += 1
        q = p
        i = 0
        while i < 128 && m.get8(p) != 0 && m.get8(p) != 32 && m.get8(p) != 9 {
            m.put8(propertyValue + i, m.get8(p))
            p += 1
            i += 1
        }
        m.put8(propertyValue + i, 0)
        if !(m.get8(p) == 0 || m.get8(p) == 32 || m.get8(p) == 9) || p == q { break }
        _ = property(library, moduleName_, propertyName, propertyValue, PROPERTY_SET | PROPERTY_STRING)
        if m.get8(p) == 0 { break }
    }
    m.release(memory, names)
}

// ---------------------------------------------------------------------------
// The exported functions of freetype.h, ftmodapi.h and ftlcdfil.h.

export fn FT_Init_FreeType(alibrary: usize) -> i32 {
    if alibrary == 0 { return r.ERR_INVALID_ARGUMENT }
    const memory = newMemory()
    if memory == 0 { return r.ERR_UNIMPLEMENTED_FEATURE }
    const library = newLibrary(memory)
    if library == 0 {
        free(memory)
        return r.ERR_OUT_OF_MEMORY
    }
    lib(library).*.ownMemory = memory
    addModules(library)
    defaultProperties(library)
    m.putWord(alibrary, library)
    return r.OK
}

export fn FT_Done_FreeType(library: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    doneLibrary(library)
    return r.OK
}

export fn FT_New_Library(memory: usize, alibrary: usize) -> i32 {
    if memory == 0 || alibrary == 0 { return r.ERR_INVALID_ARGUMENT }
    const library = newLibrary(memory)
    if library == 0 { return r.ERR_OUT_OF_MEMORY }
    m.putWord(alibrary, library)
    return r.OK
}

export fn FT_Done_Library(library: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    doneLibrary(library)
    return r.OK
}

export fn FT_Reference_Library(library: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    lib(library).*.refcount += 1
    return r.OK
}

export fn FT_Add_Default_Modules(library: usize) -> void {
    if library == 0 { return }
    addModules(library)
}

export fn FT_Set_Default_Properties(library: usize) -> void {
    if library == 0 { return }
    defaultProperties(library)
}

export fn FT_Library_Version(library: usize, amajor: usize, aminor: usize, apatch: usize) -> void {
    const known = library != 0
    if amajor != 0 { m.putI32(amajor, if known { 2 } else { 0 }) }
    if aminor != 0 { m.putI32(aminor, if known { 13 } else { 0 }) }
    if apatch != 0 { m.putI32(apatch, if known { 2 } else { 0 }) }
}

export fn FT_Get_Module(library: usize, module_name: usize) -> usize {
    if library == 0 || module_name == 0 { return 0 }
    const index = findModule(library, module_name)
    if index < 0 { return 0 }
    return module(library, index)
}

// The library's modules are its own: one of a program's own cannot be
// added (FreeType's answer to a module it cannot use).
export fn FT_Add_Module(library: usize, clazz: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if clazz == 0 { return r.ERR_INVALID_ARGUMENT }
    return r.ERR_UNIMPLEMENTED_FEATURE
}

export fn FT_Remove_Module(library: usize, mod: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    return r.ERR_INVALID_DRIVER_HANDLE
}

export fn FT_Property_Set(library: usize, module_name: usize, property_name: usize, value: usize) -> i32 {
    return property(library, module_name, property_name, value, PROPERTY_SET)
}

export fn FT_Property_Get(library: usize, module_name: usize, property_name: usize, value: usize) -> i32 {
    return property(library, module_name, property_name, value, 0)
}

export fn FT_Set_Debug_Hook(library: usize, hook_index: u32, debug_hook: usize) -> void {}

// No bytecode interpreter: the engine FreeType reports without one.
export fn FT_Get_TrueType_Engine_Type(library: usize) -> i32 { return 0 }

export fn FT_Library_SetLcdFilterWeights(library: usize, weights: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if weights == 0 { return r.ERR_INVALID_ARGUMENT }
    engine.setLcdWeights(&lib(library).*.engine, weights)
    return r.OK
}

export fn FT_Library_SetLcdFilter(library: usize, filter: i32) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if !engine.setLcdFilter(&lib(library).*.engine, @intCast(i64, filter)) { return r.ERR_INVALID_ARGUMENT }
    return r.OK
}

export fn FT_Library_SetLcdGeometry(library: usize, sub: usize) -> i32 { return r.ERR_UNIMPLEMENTED_FEATURE }
