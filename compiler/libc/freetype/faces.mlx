// FreeType's records of faces, sizes, glyph slots and charmaps over
// std.truetype's: made when a face is opened or a size added, showing
// the engine's values (pushed into them after each call that may change
// those), and a slot's read back before the engine works on it (a
// program may change a slot: its outline, its bitmap). Opening and
// closing faces (FT_Open_Face and the functions made of it), their sizes
// (FT_New_Size, FT_Request_Size and the functions made of it), their
// transform and properties.
const m = @import("std.truetype.memory")
const r = @import("std.truetype.records")
const o = @import("std.truetype.objects")
const tt = @import("std.truetype.face")
const lib = @import("./library.mlx")
const rec = @import("./records.mlx")

// What the C API keeps of a face after its FT_FaceRec: the library, the
// next face it has open, the stream it was opened with (closed with it),
// the charmaps' records.
pub const FaceExtra = struct {
    library: usize
    nextFace: usize
    stream: usize
    charmapRecords: usize
}

fn extraOf(face: usize) -> *FaceExtra { unsafe { return @ptrFromInt(*FaceExtra, face + rec.FACE_REC_SIZE) } }

// The engine's records of the C API's (0 for none).
pub fn face(address: usize) -> usize { return if address == 0 { 0 } else { rec.faceRec(address).*.internal } }
pub fn size(address: usize) -> usize { return if address == 0 { 0 } else { rec.sizeRec(address).*.internal } }
pub fn slot(address: usize) -> usize { return if address == 0 { 0 } else { rec.slotRec(address).*.internal } }
pub fn charmap(address: usize) -> usize { return if address == 0 { 0 } else { rec.charMapRec(address).*.engine } }

// The C API's record of an engine's face's charmap (0 for none).
fn charmapRecord(face_: usize, engine: usize) -> usize {
    if engine == 0 { return 0 }
    const f = o.faceRecord(face(face_))
    var i: i32 = 0
    while i < f.*.numCharmaps {
        if m.getWord(f.*.charmaps + @intCast(usize, i) * 8) == engine { return m.getWord(rec.faceRec(face_).*.charmaps + @intCast(usize, i) * 8) }
        i += 1
    }
    return 0
}

fn userOf(slot_: usize) -> usize { return if slot_ == 0 { 0 } else { o.slotRecord(slot_).*.user } }
fn sizeUser(size_: usize) -> usize { return if size_ == 0 { 0 } else { o.sizeRecord(size_).*.user } }

// ---------------------------------------------------------------------------
// Pushing the engine's values into the records, reading a slot back.

pub fn pushFace(address: usize) -> void {
    const c = rec.faceRec(address)
    const f = o.faceRecord(c.*.internal)
    c.*.num_faces = f.*.numFaces
    c.*.face_index = f.*.faceIndex
    c.*.face_flags = f.*.faceFlags
    if extraOf(address).*.stream != 0 { c.*.face_flags |= r.FACE_EXTERNAL_STREAM }
    c.*.style_flags = f.*.styleFlags
    c.*.num_glyphs = f.*.numGlyphs
    c.*.family_name = f.*.familyName
    c.*.style_name = f.*.styleName
    c.*.num_fixed_sizes = f.*.numFixedSizes
    c.*.available_sizes = f.*.availableSizes
    c.*.bbox.xMin = f.*.bbox.xMin
    c.*.bbox.yMin = f.*.bbox.yMin
    c.*.bbox.xMax = f.*.bbox.xMax
    c.*.bbox.yMax = f.*.bbox.yMax
    c.*.units_per_EM = f.*.unitsPerEm
    c.*.ascender = f.*.ascender
    c.*.descender = f.*.descender
    c.*.height = f.*.height
    c.*.max_advance_width = f.*.maxAdvanceWidth
    c.*.max_advance_height = f.*.maxAdvanceHeight
    c.*.underline_position = f.*.underlinePosition
    c.*.underline_thickness = f.*.underlineThickness
    c.*.glyph = userOf(f.*.glyph)
    c.*.size = sizeUser(f.*.activeSize)
    c.*.charmap = charmapRecord(address, f.*.charmap)
    c.*.memory = f.*.memory
    c.*.stream = extraOf(address).*.stream
}

pub fn pushSize(address: usize) -> void {
    if address == 0 { return }
    const c = rec.sizeRec(address)
    const s = o.sizeRecord(c.*.internal)
    c.*.x_ppem = s.*.xPpem
    c.*.y_ppem = s.*.yPpem
    c.*.x_scale = s.*.xScale
    c.*.y_scale = s.*.yScale
    c.*.ascender = s.*.ascender
    c.*.descender = s.*.descender
    c.*.height = s.*.height
    c.*.max_advance = s.*.maxAdvance
}

// Pushes the face's sizes (after variations change their metrics).
pub fn pushSizes(address: usize) -> void {
    var node = rec.faceRec(address).*.sizes_head
    while node != 0 {
        pushSize(m.getWord(node + 16))
        node = m.getWord(node + 8)
    }
}

pub fn pushSlot(address: usize) -> void {
    if address == 0 { return }
    const c = rec.slotRec(address)
    const s = o.slotRecord(c.*.internal)
    c.*.glyph_index = s.*.glyphIndex
    m.copy(@intFromPtr(&c.*.metrics), @intFromPtr(&s.*.metrics), @sizeOf(r.GlyphMetrics))
    c.*.linearHoriAdvance = s.*.linearHoriAdvance
    c.*.linearVertAdvance = s.*.linearVertAdvance
    c.*.advance.x = s.*.advance.x
    c.*.advance.y = s.*.advance.y
    c.*.format = s.*.format
    m.copy(@intFromPtr(&c.*.bitmap), @intFromPtr(&s.*.bitmap), @sizeOf(r.Bitmap))
    c.*.bitmap_left = s.*.bitmapLeft
    c.*.bitmap_top = s.*.bitmapTop
    m.copy(@intFromPtr(&c.*.outline), @intFromPtr(&s.*.outline), @sizeOf(r.Outline))
    c.*.num_subglyphs = s.*.numSubglyphs
    c.*.subglyphs = s.*.subglyphs
    c.*.control_data = 0
    c.*.control_len = 0
    c.*.lsb_delta = s.*.lsbDelta
    c.*.rsb_delta = s.*.rsbDelta
    c.*.other = 0
}

// The engine's slot of a slot record, with what a program may have
// changed in the record read back.
pub fn pullSlot(address: usize) -> usize {
    const c = rec.slotRec(address)
    const s = o.slotRecord(c.*.internal)
    s.*.glyphIndex = c.*.glyph_index
    m.copy(@intFromPtr(&s.*.metrics), @intFromPtr(&c.*.metrics), @sizeOf(r.GlyphMetrics))
    s.*.linearHoriAdvance = c.*.linearHoriAdvance
    s.*.linearVertAdvance = c.*.linearVertAdvance
    s.*.advance.x = c.*.advance.x
    s.*.advance.y = c.*.advance.y
    s.*.format = c.*.format
    m.copy(@intFromPtr(&s.*.bitmap), @intFromPtr(&c.*.bitmap), @sizeOf(r.Bitmap))
    s.*.bitmapLeft = c.*.bitmap_left
    s.*.bitmapTop = c.*.bitmap_top
    m.copy(@intFromPtr(&s.*.outline), @intFromPtr(&c.*.outline), @sizeOf(r.Outline))
    s.*.numSubglyphs = c.*.num_subglyphs
    s.*.subglyphs = c.*.subglyphs
    s.*.lsbDelta = c.*.lsb_delta
    s.*.rsbDelta = c.*.rsb_delta
    return c.*.internal
}

// The glyph slot of a face, read back (0 for none).
pub fn pullGlyph(face_: usize) -> usize {
    const glyph = rec.faceRec(face_).*.glyph
    if glyph == 0 { return 0 }
    return pullSlot(glyph)
}

pub fn pushGlyph(face_: usize) -> void { pushSlot(rec.faceRec(face_).*.glyph) }

// ---------------------------------------------------------------------------
// Making and freeing the records.

// The record of an engine's size, appended to the face's list of sizes
// (FT_ListNodeRec: prev, next, data); 0 when out of memory.
fn newSizeRecord(face_: usize, engine: usize) -> usize {
    const memory = rec.faceRec(face_).*.memory
    const address = m.alloc(memory, rec.SIZE_REC_SIZE)
    if address == 0 { return 0 }
    const node = m.alloc(memory, 24)
    if node == 0 {
        m.release(memory, address)
        return 0
    }
    rec.sizeRec(address).*.face = face_
    rec.sizeRec(address).*.internal = engine
    o.sizeRecord(engine).*.user = address
    const root = rec.faceRec(face_)
    m.putWord(node + 16, address)
    m.putWord(node, root.*.sizes_tail)
    if root.*.sizes_tail != 0 {
        m.putWord(root.*.sizes_tail + 8, node)
    } else {
        root.*.sizes_head = node
    }
    root.*.sizes_tail = node
    pushSize(address)
    return address
}

// Takes a size's record off the face's list; false when it is not there.
fn unlinkSize(face_: usize, address: usize) -> bool {
    const root = rec.faceRec(face_)
    var node = root.*.sizes_head
    while node != 0 && m.getWord(node + 16) != address { node = m.getWord(node + 8) }
    if node == 0 { return false }
    const prev = m.getWord(node)
    const next = m.getWord(node + 8)
    if prev != 0 { m.putWord(prev + 8, next) } else { root.*.sizes_head = next }
    if next != 0 { m.putWord(next, prev) } else { root.*.sizes_tail = prev }
    m.release(root.*.memory, node)
    return true
}

pub const Finalizer = fn(usize) -> void

fn finalize(finalizer: usize, object: usize) -> void {
    if finalizer == 0 { return }
    const call: Finalizer = unsafe { @ptrFromInt(Finalizer, finalizer) }
    call(object)
}

pub const StreamIo = fn(usize, u64, usize, u64) -> u64

fn closeStream(stream: usize) -> void {
    if stream == 0 { return }
    finalize(m.getWord(stream + 48), stream)
}

// The face's design changed: FreeType's autohinter's data of it is given
// back (the hook of the engine's face).
fn designChanged(engine: usize) -> void {
    const root = rec.faceRec(o.faceRecord(engine).*.user)
    if root.*.autohint_finalizer != 0 {
        finalize(root.*.autohint_finalizer, root.*.autohint_data)
        root.*.autohint_data = 0
    }
}

// The records of a face the engine opened: the face's, its charmaps',
// its slot's and its size's.
fn newFaceRecord(library: usize, engine: usize, stream: usize) -> usize {
    const memory = lib.memoryOf(library)
    const f = o.faceRecord(engine)
    const address = m.alloc(memory, rec.FACE_REC_SIZE + @sizeOf(FaceExtra))
    if address == 0 { return 0 }
    const c = rec.faceRec(address)
    c.*.internal = engine
    c.*.memory = memory
    c.*.driver = lib.module(library, f.*.driver)
    f.*.user = address
    f.*.changeHook = @intFromPtr(designChanged)
    const extra = extraOf(address)
    extra.*.library = library
    extra.*.stream = stream
    const count = @intCast(usize, if f.*.numCharmaps > 0 { f.*.numCharmaps } else { 0 })
    if count > 0 {
        const records = m.alloc(memory, count * rec.CHARMAP_REC_SIZE)
        const pointers = m.alloc(memory, count * 8)
        if records == 0 || pointers == 0 {
            m.release(memory, records)
            m.release(memory, pointers)
            m.release(memory, address)
            return 0
        }
        var i: usize = 0
        while i < count {
            const engineMap = o.charMap(m.getWord(f.*.charmaps + i * 8))
            const cm = rec.charMapRec(records + i * rec.CHARMAP_REC_SIZE)
            cm.*.face = address
            cm.*.encoding = engineMap.*.encoding
            cm.*.platform_id = engineMap.*.platformId
            cm.*.encoding_id = engineMap.*.encodingId
            cm.*.engine = m.getWord(f.*.charmaps + i * 8)
            m.putWord(pointers + i * 8, records + i * rec.CHARMAP_REC_SIZE)
            i += 1
        }
        extra.*.charmapRecords = records
        c.*.charmaps = pointers
        c.*.num_charmaps = @intCast(i32, count)
    }
    if f.*.glyph != 0 {
        const slotAddress = m.alloc(memory, rec.SLOT_REC_SIZE)
        if slotAddress == 0 {
            freeRecords(address)
            return 0
        }
        rec.slotRec(slotAddress).*.library = library
        rec.slotRec(slotAddress).*.face = address
        rec.slotRec(slotAddress).*.internal = f.*.glyph
        o.slotRecord(f.*.glyph).*.user = slotAddress
        pushSlot(slotAddress)
    }
    if f.*.activeSize != 0 {
        if newSizeRecord(address, f.*.activeSize) == 0 {
            freeRecords(address)
            return 0
        }
    }
    pushFace(address)
    return address
}

// Frees the records of a face (the engine's face freed before).
fn freeRecords(address: usize) -> void {
    const c = rec.faceRec(address)
    const memory = c.*.memory
    if c.*.glyph != 0 { m.release(memory, c.*.glyph) }
    while c.*.sizes_head != 0 {
        const size_ = m.getWord(c.*.sizes_head + 16)
        _ = unlinkSize(address, size_)
        m.release(memory, size_)
    }
    m.release(memory, c.*.charmaps)
    m.release(memory, extraOf(address).*.charmapRecords)
    m.release(memory, address)
}

// Takes the face off its library's list of open faces.
fn unlink(address: usize) -> void {
    const l = lib.lib(extraOf(address).*.library)
    if l.*.faces == address {
        l.*.faces = extraOf(address).*.nextFace
        return
    }
    var cur = l.*.faces
    while cur != 0 {
        const next = extraOf(cur).*.nextFace
        if next == address {
            extraOf(cur).*.nextFace = extraOf(address).*.nextFace
            return
        }
        cur = next
    }
}

// Frees a face (FreeType's destroy_face): the finalizers of its records
// called, the engine's face freed, its stream closed, its records freed.
fn destroyFace(address: usize) -> void {
    const c = rec.faceRec(address)
    finalize(c.*.autohint_finalizer, c.*.autohint_data)
    if c.*.glyph != 0 {
        _ = pullSlot(c.*.glyph)
        finalize(rec.slotRec(c.*.glyph).*.generic_finalizer, c.*.glyph)
    }
    var node = c.*.sizes_head
    while node != 0 {
        const size_ = m.getWord(node + 16)
        node = m.getWord(node + 8)
        finalize(rec.sizeRec(size_).*.generic_finalizer, size_)
    }
    finalize(c.*.generic_finalizer, address)
    tt.doneFace(c.*.internal)
    closeStream(extraOf(address).*.stream)
    freeRecords(address)
}

export fn __mlx_freetype_done_face(address: usize) -> void {
    unlink(address)
    destroyFace(address)
}

// The parameters of FT_Open_Face the SFNT driver reads.
fn hasParameter(args: usize, tag: u64) -> bool {
    if (m.get32(args) & 16) == 0 { return false }
    const count = m.getI32(args + 48)
    const params = m.getWord(args + 56)
    if params == 0 { return false }
    var i: i32 = 0
    while i < count {
        if m.get64(params + @intCast(usize, i) * 16) == tag { return true }
        i += 1
    }
    return false
}

const PARAM_IGNORE_TYPOGRAPHIC_FAMILY: u64 = 0x69677066
const PARAM_IGNORE_TYPOGRAPHIC_SUBFAMILY: u64 = 0x69677073
const PARAM_IGNORE_SBIX: u64 = 0x69736278

// FT_Open_Face: the bytes FT_Open_Args name (memory, a path, or a
// program's stream, read into memory), the engine's face of them, its
// records.
pub fn openFace(library: usize, args: usize, faceIndex: i64, aface: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if args == 0 { return r.ERR_INVALID_ARGUMENT }
    const memory = lib.memoryOf(library)
    const flags = m.get32(args) & 7
    var kind: i64 = 0
    var data: usize = 0
    var dataSize: u64 = 0
    var path: usize = 0
    var stream: usize = 0
    if flags == 1 {
        kind = tt.SOURCE_MEMORY
        data = m.getWord(args + 8)
        dataSize = m.get64(args + 16)
    } else if flags == 4 {
        kind = tt.SOURCE_PATH
        path = m.getWord(args + 24)
    } else if flags == 2 && m.getWord(args + 32) != 0 {
        stream = m.getWord(args + 32)
        // (The stream's memory is the library's, as FreeType sets it.)
        m.putWord(stream + 56, memory)
        const read = m.getWord(stream + 40)
        const streamSize = m.get64(stream + 8)
        if read == 0 {
            kind = tt.SOURCE_MEMORY
            data = m.getWord(stream)
            dataSize = streamSize
        } else {
            const block = m.alloc(memory, @intCast(usize, streamSize) + 1)
            if block == 0 { return r.ERR_OUT_OF_MEMORY }
            const call: StreamIo = unsafe { @ptrFromInt(StreamIo, read) }
            var done: u64 = 0
            while done < streamSize {
                var chunk = streamSize - done
                if chunk > 1048576 { chunk = 1048576 }
                const got = call(stream, done, block + done, chunk)
                if got == 0 { break }
                done += if got > chunk { chunk } else { got }
            }
            m.putWord(stream + 16, done)
            kind = tt.SOURCE_OWNED
            data = block
            dataSize = done
        }
    } else {
        if (m.get32(args) & 2) != 0 && m.getWord(args + 32) != 0 { closeStream(m.getWord(args + 32)) }
        return r.ERR_INVALID_ARGUMENT
    }
    const opened = tt.newFace(library, kind, data, dataSize, path)
    if opened.0 != r.OK {
        if kind == tt.SOURCE_OWNED { m.release(memory, data) }
        return opened.0
    }
    const engine = opened.1
    if aface == 0 && faceIndex >= 0 {
        tt.discardFace(engine)
        closeStream(stream)
        return r.ERR_INVALID_ARGUMENT
    }
    var options: i64 = 0
    if hasParameter(args, PARAM_IGNORE_TYPOGRAPHIC_FAMILY) { options |= tt.OPEN_IGNORE_TYPOGRAPHIC_FAMILY }
    if hasParameter(args, PARAM_IGNORE_TYPOGRAPHIC_SUBFAMILY) { options |= tt.OPEN_IGNORE_TYPOGRAPHIC_SUBFAMILY }
    if hasParameter(args, PARAM_IGNORE_SBIX) { options |= tt.OPEN_IGNORE_SBIX }
    var drivers = lib.lib(library).*.numModules
    if drivers > 2 { drivers = 2 }
    const err = tt.openFace(engine, faceIndex, options, drivers)
    if err != r.OK {
        closeStream(stream)
        return err
    }
    const address = newFaceRecord(library, engine, stream)
    if address == 0 {
        tt.doneFace(engine)
        closeStream(stream)
        return r.ERR_OUT_OF_MEMORY
    }
    const l = lib.lib(library)
    extraOf(address).*.nextFace = l.*.faces
    l.*.faces = address
    lib.doneFace = @intFromPtr(__mlx_freetype_done_face)
    if aface != 0 {
        m.putWord(aface, address)
    } else {
        __mlx_freetype_done_face(address)
    }
    return r.OK
}

// ---------------------------------------------------------------------------
// The exported functions.

extern("c") fn calloc(count: usize, size: usize) -> usize
extern("c") fn free(address: usize) -> void

export fn FT_New_Face(library: usize, path: usize, face_index: i64, aface: usize) -> i32 {
    if path == 0 { return r.ERR_INVALID_ARGUMENT }
    const args = calloc(1, 64)
    m.put32(args, 4)
    m.putWord(args + 24, path)
    const err = openFace(library, args, face_index, aface)
    free(args)
    return err
}

export fn FT_New_Memory_Face(library: usize, file_base: usize, file_size: i64, face_index: i64, aface: usize) -> i32 {
    if file_base == 0 { return r.ERR_INVALID_ARGUMENT }
    const args = calloc(1, 64)
    m.put32(args, 1)
    m.putWord(args + 8, file_base)
    m.putI64(args + 16, file_size)
    const err = openFace(library, args, face_index, aface)
    free(args)
    return err
}

export fn FT_Open_Face(library: usize, args: usize, face_index: i64, aface: usize) -> i32 { return openFace(library, args, face_index, aface) }

export fn FT_Attach_File(face_: usize, path: usize) -> i32 {
    if path == 0 { return r.ERR_INVALID_ARGUMENT }
    if face_ == 0 { return r.ERR_INVALID_FACE_HANDLE }
    return r.ERR_UNIMPLEMENTED_FEATURE
}

export fn FT_Attach_Stream(face_: usize, parameters: usize) -> i32 {
    if face_ == 0 { return r.ERR_INVALID_FACE_HANDLE }
    return r.ERR_UNIMPLEMENTED_FEATURE
}

export fn FT_Reference_Face(face_: usize) -> i32 {
    if face_ == 0 { return r.ERR_INVALID_FACE_HANDLE }
    o.faceRecord(face(face_)).*.refcount += 1
    return r.OK
}

export fn FT_Done_Face(face_: usize) -> i32 {
    if face_ == 0 || rec.faceRec(face_).*.driver == 0 { return r.ERR_INVALID_FACE_HANDLE }
    const f = o.faceRecord(face(face_))
    f.*.refcount -= 1
    if f.*.refcount > 0 { return r.OK }
    unlink(face_)
    destroyFace(face_)
    return r.OK
}

export fn FT_New_Size(face_: usize, asize: usize) -> i32 {
    if face_ == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if asize == 0 { return r.ERR_INVALID_ARGUMENT }
    if rec.faceRec(face_).*.driver == 0 { return r.ERR_INVALID_DRIVER_HANDLE }
    const engine = tt.newSize(face(face_))
    if engine == 0 { return r.ERR_OUT_OF_MEMORY }
    const address = newSizeRecord(face_, engine)
    if address == 0 {
        _ = tt.doneSize(engine)
        return r.ERR_OUT_OF_MEMORY
    }
    m.putWord(asize, address)
    return r.OK
}

export fn FT_Done_Size(size_: usize) -> i32 {
    if size_ == 0 { return r.ERR_INVALID_SIZE_HANDLE }
    const face_ = rec.sizeRec(size_).*.face
    if face_ == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if !unlinkSize(face_, size_) { return r.ERR_INVALID_SIZE_HANDLE }
    _ = tt.doneSize(size(size_))
    rec.faceRec(face_).*.size = sizeUser(o.faceRecord(face(face_)).*.activeSize)
    finalize(rec.sizeRec(size_).*.generic_finalizer, size_)
    m.release(rec.faceRec(face_).*.memory, size_)
    return r.OK
}

export fn FT_Activate_Size(size_: usize) -> i32 {
    if size_ == 0 { return r.ERR_INVALID_SIZE_HANDLE }
    const face_ = rec.sizeRec(size_).*.face
    if face_ == 0 || rec.faceRec(face_).*.driver == 0 { return r.ERR_INVALID_FACE_HANDLE }
    tt.activateSize(face(face_), size(size_))
    rec.faceRec(face_).*.size = size_
    return r.OK
}

export fn FT_Request_Size(face_: usize, req: usize) -> i32 {
    if face_ == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if rec.faceRec(face_).*.size == 0 { return r.ERR_INVALID_SIZE_HANDLE }
    if req == 0 { return r.ERR_INVALID_ARGUMENT }
    const err = tt.requestSize(face(face_), unsafe { @ptrFromInt(*r.SizeRequest, req) })
    pushSize(rec.faceRec(face_).*.size)
    return err
}

export fn FT_Select_Size(face_: usize, strike_index: i32) -> i32 {
    const err = tt.selectSize(face(face_), strike_index)
    if face_ != 0 { pushSize(rec.faceRec(face_).*.size) }
    return err
}

export fn FT_Set_Char_Size(face_: usize, char_width: i64, char_height: i64, horz_resolution: u32, vert_resolution: u32) -> i32 {
    const err = tt.setCharSize(face(face_), char_width, char_height, horz_resolution, vert_resolution)
    if face_ != 0 { pushSize(rec.faceRec(face_).*.size) }
    return err
}

export fn FT_Set_Pixel_Sizes(face_: usize, pixel_width: u32, pixel_height: u32) -> i32 {
    const err = tt.setPixelSizes(face(face_), pixel_width, pixel_height)
    if face_ != 0 { pushSize(rec.faceRec(face_).*.size) }
    return err
}

export fn FT_Set_Transform(face_: usize, matrix: usize, delta: usize) -> void { tt.setTransform(face(face_), matrix, delta) }

export fn FT_Get_Transform(face_: usize, matrix: usize, delta: usize) -> void { tt.getTransform(face(face_), matrix, delta) }

export fn FT_Face_Properties(face_: usize, num_properties: u32, properties: usize) -> i32 { return tt.setProperties(face(face_), num_properties, properties) }
