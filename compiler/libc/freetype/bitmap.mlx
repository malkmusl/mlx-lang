// FreeType's bitmaps (ftbitmap.h) and synthetic styles (ftsynth.h):
// std.truetype's, on FT_Bitmap records (the engine's Bitmap: the same
// layout) and glyph slots.
const r = @import("std.truetype.records")
const bitmap = @import("std.truetype.bitmap")
const lib = @import("./library.mlx")
const faces = @import("./faces.mlx")

export fn FT_Bitmap_Init(abitmap: usize) -> void { bitmap.init(abitmap) }
export fn FT_Bitmap_New(abitmap: usize) -> void { bitmap.init(abitmap) }

export fn FT_Bitmap_Done(library: usize, target: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    return bitmap.done(lib.memoryOf(library), target)
}

export fn FT_Bitmap_Copy(library: usize, source: usize, target: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    return bitmap.copy(lib.memoryOf(library), source, target)
}

export fn FT_Bitmap_Embolden(library: usize, target: usize, xStrength: i64, yStrength: i64) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    return bitmap.embolden(lib.memoryOf(library), target, xStrength, yStrength)
}

export fn FT_Bitmap_Convert(library: usize, source: usize, target: usize, alignment: i32) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    return bitmap.convert(lib.memoryOf(library), source, target, @intCast(i64, alignment))
}

// The source's offset (an FT_Vector) and the color (an FT_Color) are
// passed by value: two words, then a word on the stack.
export fn FT_Bitmap_Blend(library: usize, source: usize, offsetX: i64, offsetY: i64, target: usize, atarget_offset: usize, color: u64) -> i32 {
    if library == 0 { return r.ERR_INVALID_ARGUMENT }
    return bitmap.blend(lib.memoryOf(library), source, offsetX, offsetY, target, atarget_offset, color)
}

export fn FT_GlyphSlot_Own_Bitmap(slot: usize) -> i32 {
    if slot == 0 { return r.OK }
    const engine = faces.pullSlot(slot)
    const err = bitmap.ownBitmap(engine)
    faces.pushSlot(slot)
    return err
}

export fn FT_GlyphSlot_Oblique(slot: usize) -> void { FT_GlyphSlot_Slant(slot, 0x0366A, 0) }

export fn FT_GlyphSlot_Slant(slot: usize, xslant: i64, yslant: i64) -> void {
    if slot == 0 { return }
    bitmap.slant(faces.pullSlot(slot), xslant, yslant)
    faces.pushSlot(slot)
}

export fn FT_GlyphSlot_Embolden(slot: usize) -> void { FT_GlyphSlot_AdjustWeight(slot, 0x0AAA, 0x0AAA) }

export fn FT_GlyphSlot_AdjustWeight(slot: usize, xdelta: i64, ydelta: i64) -> void {
    if slot == 0 { return }
    bitmap.adjustWeight(faces.pullSlot(slot), xdelta, ydelta)
    faces.pushSlot(slot)
}
