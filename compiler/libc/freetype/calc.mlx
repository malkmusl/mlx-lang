// FreeType's arithmetic and trigonometry (freetype.h and fttrigon.h):
// std.truetype's, which computes them as FreeType does.
const m = @import("std.truetype.memory")
const calc = @import("std.truetype.calc")

export fn FT_MulDiv(a: i64, b: i64, c: i64) -> i64 { return calc.mulDiv(a, b, c) }
export fn FT_MulFix(a: i64, b: i64) -> i64 { return calc.mulFix(a, b) }
export fn FT_DivFix(a: i64, b: i64) -> i64 { return calc.divFix(a, b) }
export fn FT_RoundFix(a: i64) -> i64 { return calc.roundFix(a) }
export fn FT_CeilFix(a: i64) -> i64 { return calc.ceilFix(a) }
export fn FT_FloorFix(a: i64) -> i64 { return calc.floorFix(a) }
export fn FT_Vector_Transform(vector: usize, matrix: usize) -> void { calc.vectorTransform(vector, matrix) }
export fn FT_Matrix_Multiply(a: usize, b: usize) -> void { calc.matrixMultiply(a, b) }
export fn FT_Matrix_Invert(matrix: usize) -> i32 { return if calc.matrixInvert(matrix) { 0 } else { 6 } }

export fn FT_Sin(angle: i64) -> i64 { return calc.sin(angle) }
export fn FT_Cos(angle: i64) -> i64 { return calc.cos(angle) }
export fn FT_Tan(angle: i64) -> i64 { return calc.tan(angle) }
export fn FT_Atan2(x: i64, y: i64) -> i64 { return calc.atan2(x, y) }
export fn FT_Angle_Diff(angle1: i64, angle2: i64) -> i64 { return calc.angleDiff(angle1, angle2) }

export fn FT_Vector_Unit(vec: usize, angle: i64) -> void {
    if vec == 0 { return }
    const v = calc.vectorUnit(angle)
    m.putI64(vec, v.0)
    m.putI64(vec + 8, v.1)
}

export fn FT_Vector_Rotate(vec: usize, angle: i64) -> void {
    if vec == 0 || angle == 0 { return }
    const v = calc.vectorRotate(m.getI64(vec), m.getI64(vec + 8), angle)
    m.putI64(vec, v.0)
    m.putI64(vec + 8, v.1)
}

export fn FT_Vector_Length(vec: usize) -> i64 {
    if vec == 0 { return 0 }
    return calc.vectorLength(m.getI64(vec), m.getI64(vec + 8))
}

export fn FT_Vector_Polarize(vec: usize, length: usize, angle: usize) -> void {
    if vec == 0 || length == 0 || angle == 0 { return }
    const p = calc.vectorPolarize(m.getI64(vec), m.getI64(vec + 8))
    if !p.2 { return }
    m.putI64(length, p.0)
    m.putI64(angle, p.1)
}

export fn FT_Vector_From_Polar(vec: usize, length: i64, angle: i64) -> void {
    if vec == 0 { return }
    const v = calc.vectorRotate(length, 0, angle)
    m.putI64(vec, v.0)
    m.putI64(vec + 8, v.1)
}
