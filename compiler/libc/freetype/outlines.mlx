// FreeType's outline functions (ftoutln.h, ftbbox.h): std.truetype's,
// on FT_Outline records (the engine's Outline: the same layout).
const m = @import("std.truetype.memory")
const r = @import("std.truetype.records")
const outlines = @import("std.truetype.outlines")
const render = @import("std.truetype.render")
const lib = @import("./library.mlx")

pub const MoveFunc = fn(usize, usize) -> i32
pub const ConicFunc = fn(usize, usize, usize) -> i32
pub const CubicFunc = fn(usize, usize, usize, usize) -> i32

// The context of a walk calling C: the FT_Outline_Funcs, the user data,
// three FT_Vectors to pass.
const CallContext = struct {
    funcs: usize
    user: usize
    v1x: i64
    v1y: i64
    v2x: i64
    v2y: i64
    v3x: i64
    v3y: i64
}

fn callSink(context: usize, kind: i64, x1: i64, y1: i64, x2: i64, y2: i64, x3: i64, y3: i64) -> i32 {
    const c: *CallContext = unsafe { @ptrFromInt(*CallContext, context) }
    c.*.v1x = x1
    c.*.v1y = y1
    c.*.v2x = x2
    c.*.v2y = y2
    c.*.v3x = x3
    c.*.v3y = y3
    const v1 = context + 16
    const v2 = context + 32
    const v3 = context + 48
    if kind == outlines.MOVE || kind == outlines.LINE {
        const f = m.getWord(c.*.funcs + (if kind == outlines.MOVE { 0 } else { 8 }))
        const call: MoveFunc = unsafe { @ptrFromInt(MoveFunc, f) }
        return call(v1, c.*.user)
    }
    if kind == outlines.CONIC {
        const call: ConicFunc = unsafe { @ptrFromInt(ConicFunc, m.getWord(c.*.funcs + 16)) }
        return call(v1, v2, c.*.user)
    }
    const call: CubicFunc = unsafe { @ptrFromInt(CubicFunc, m.getWord(c.*.funcs + 24)) }
    return call(v1, v2, v3, c.*.user)
}

export fn FT_Outline_Decompose(outline: usize, funcs: usize, user: usize) -> i32 {
    if outline == 0 { return r.ERR_INVALID_OUTLINE }
    if funcs == 0 { return r.ERR_INVALID_ARGUMENT }
    var record: CallContext = undefined
    const c: *CallContext = &record
    c.*.funcs = funcs
    c.*.user = user
    return outlines.decompose(outline, @intCast(i64, m.getI32(funcs + 32)), m.getI64(funcs + 40), callSink, @intFromPtr(c))
}

export fn FT_Outline_Check(outline: usize) -> i32 { return outlines.check(outline) }

export fn FT_Outline_New(library: usize, numPoints: u32, numContours: i32, anoutline: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    return outlines.newOutline(lib.memoryOf(library), numPoints, numContours, anoutline)
}

export fn FT_Outline_Done(library: usize, outline: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    return outlines.doneOutline(lib.memoryOf(library), outline)
}

export fn FT_Outline_Copy(source: usize, target: usize) -> i32 { return outlines.copyOutline(source, target) }

export fn FT_Outline_Get_CBox(outline: usize, acbox: usize) -> void {
    if outline == 0 || acbox == 0 { return }
    const box = outlines.outlineCbox(outline)
    m.putI64(acbox, box.0)
    m.putI64(acbox + 8, box.1)
    m.putI64(acbox + 16, box.2)
    m.putI64(acbox + 24, box.3)
}

export fn FT_Outline_Get_BBox(outline: usize, abbox: usize) -> i32 {
    if abbox == 0 { return r.ERR_INVALID_ARGUMENT }
    if outline == 0 { return r.ERR_INVALID_OUTLINE }
    return outlines.bbox(outline, abbox)
}

export fn FT_Outline_Translate(outline: usize, xOffset: i64, yOffset: i64) -> void {
    if outline == 0 { return }
    const rec = r.outline(outline)
    outlines.translate(rec.*.points, @intCast(i64, @bitCast(u16, rec.*.nPoints)), xOffset, yOffset)
}

export fn FT_Outline_Transform(outline: usize, matrix: usize) -> void {
    if outline == 0 || matrix == 0 { return }
    const rec = r.outline(outline)
    if rec.*.points == 0 { return }
    outlines.transform(rec.*.points, @intCast(i64, rec.*.nPoints), m.getI64(matrix), m.getI64(matrix + 8), m.getI64(matrix + 16), m.getI64(matrix + 24))
}

export fn FT_Outline_Reverse(outline: usize) -> void {
    if outline == 0 { return }
    outlines.reverse(outline)
}

export fn FT_Outline_Embolden(outline: usize, strength: i64) -> i32 { return outlines.embolden(outline, strength, strength) }
export fn FT_Outline_EmboldenXY(outline: usize, xstrength: i64, ystrength: i64) -> i32 { return outlines.embolden(outline, xstrength, ystrength) }
export fn FT_Outline_Get_Orientation(outline: usize) -> i32 { return outlines.orientation(outline) }

// ---------------------------------------------------------------------------
// FT_Outline_Render and FT_Outline_Get_Bitmap. FT_Raster_Params: target,
// source, flags, gray_spans, black_spans, bit_test, bit_set, user,
// clip_box.

fn outlineRender(library: usize, outline: usize, params: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    if outline == 0 { return r.ERR_INVALID_OUTLINE }
    if params == 0 { return r.ERR_INVALID_ARGUMENT }
    m.putWord(params + 8, outline)
    return render.outlineRender(lib.memoryOf(library), outline, @intCast(i64, m.getI32(params + 16)), m.getWord(params), m.getWord(params + 24), m.getWord(params + 56), params + 64)
}

export fn FT_Outline_Render(library: usize, outline: usize, params: usize) -> i32 { return outlineRender(library, outline, params) }

export fn FT_Outline_Get_Bitmap(library: usize, outline: usize, abitmap: usize) -> i32 {
    if abitmap == 0 { return r.ERR_INVALID_ARGUMENT }
    // FT_Raster_Params on the stack of this call: 96 bytes.
    var params: [12]u64 = undefined
    var i: usize = 0
    while i < 12 {
        params[i] = 0
        i += 1
    }
    const p = @intFromPtr(&params[0])
    m.putWord(p, abitmap)
    const mode = r.bitmap(abitmap).*.pixelMode
    if mode == r.PIXEL_GRAY || mode == r.PIXEL_LCD || mode == r.PIXEL_LCD_V { m.putI32(p + 16, @intCast(i32, render.RASTER_FLAG_AA)) }
    return outlineRender(library, outline, p)
}
