// Loading and rendering glyphs (FT_Load_Glyph, FT_Load_Char,
// FT_Render_Glyph), advances and kerning: std.truetype's, the face's
// glyph slot read back before and pushed after.
const m = @import("std.truetype.memory")
const r = @import("std.truetype.records")
const calc = @import("std.truetype.calc")
const load = @import("std.truetype.load")
const render = @import("std.truetype.render")
const faces = @import("./faces.mlx")
const rec = @import("./records.mlx")

export fn FT_Load_Glyph(face: usize, glyph_index: u32, load_flags: i32) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    _ = faces.pullGlyph(face)
    const err = load.loadGlyph(faces.face(face), @intCast(i64, glyph_index), @intCast(i64, load_flags))
    faces.pushGlyph(face)
    return err
}

export fn FT_Load_Char(face: usize, char_code: u64, load_flags: i32) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    _ = faces.pullGlyph(face)
    const err = load.loadChar(faces.face(face), char_code, @intCast(i64, load_flags))
    faces.pushGlyph(face)
    return err
}

export fn FT_Get_Char_Index(face: usize, charcode: u64) -> u32 { return @intCast(u32, load.charIndex(faces.face(face), charcode)) }

export fn FT_Render_Glyph(slot: usize, render_mode: i32) -> i32 {
    if slot == 0 || rec.slotRec(slot).*.face == 0 { return r.ERR_INVALID_ARGUMENT }
    const err = render.renderGlyph(faces.pullSlot(slot), @intCast(i64, render_mode))
    faces.pushSlot(slot)
    return err
}

// ---------------------------------------------------------------------------
// Advances (ftadvanc.h); glyphs are loaded into the slot when the
// metrics tables do not tell them.

export fn FT_Get_Advance(face: usize, gindex: u32, load_flags: i32, padvance: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if padvance == 0 { return r.ERR_INVALID_ARGUMENT }
    if @intCast(i64, gindex) >= rec.faceRec(face).*.num_glyphs { return r.ERR_INVALID_GLYPH_INDEX }
    _ = faces.pullGlyph(face)
    const err = load.getAdvances(faces.face(face), @intCast(i64, gindex), 1, @intCast(i64, load_flags), padvance)
    faces.pushGlyph(face)
    return err
}

export fn FT_Get_Advances(face: usize, start: u32, count: u32, load_flags: i32, padvances: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    _ = faces.pullGlyph(face)
    const err = load.getAdvances(faces.face(face), @intCast(i64, start), @intCast(i64, count), @intCast(i64, load_flags), padvances)
    faces.pushGlyph(face)
    return err
}

// ---------------------------------------------------------------------------
// Kerning.

export fn FT_Get_Kerning(face: usize, left_glyph: u32, right_glyph: u32, kern_mode: u32, akerning: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if akerning == 0 { return r.ERR_INVALID_ARGUMENT }
    const kerning = load.kerning(faces.face(face), left_glyph, right_glyph, kern_mode)
    m.putI64(akerning, kerning.0)
    m.putI64(akerning + 8, kerning.1)
    return r.OK
}

// Track kerning is a Type 1 (AFM) feature: no SFNT driver has it.
export fn FT_Get_Track_Kerning(face: usize, point_size: i64, degree: i32, akerning: usize) -> i32 {
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    if akerning == 0 { return r.ERR_INVALID_ARGUMENT }
    return r.ERR_UNIMPLEMENTED_FEATURE
}

// A composite glyph's component loaded with FT_LOAD_NO_RECURSE: FT_Int
// index, FT_UInt flags, FT_Int arg1 and arg2, FT_Matrix transform (the
// engine's subglyphs: eight words each).
export fn FT_Get_SubGlyph_Info(glyph: usize, sub_index: u32, p_index: usize, p_flags: usize, p_arg1: usize, p_arg2: usize, p_transform: usize) -> i32 {
    if glyph == 0 { return r.ERR_INVALID_ARGUMENT }
    const s = rec.slotRec(glyph)
    if s.*.subglyphs == 0 || s.*.format != r.FORMAT_COMPOSITE || sub_index >= s.*.num_subglyphs { return r.ERR_INVALID_ARGUMENT }
    const at = s.*.subglyphs + @intCast(usize, sub_index) * 64
    m.putI32(p_index, @intCast(i32, calc.low32(m.getI64(at))))
    m.put32(p_flags, @intCast(u32, m.getI64(at + 8) & 0xFFFF))
    m.putI32(p_arg1, @intCast(i32, calc.low32(m.getI64(at + 16))))
    m.putI32(p_arg2, @intCast(i32, calc.low32(m.getI64(at + 24))))
    m.putI64(p_transform, m.getI64(at + 32))
    m.putI64(p_transform + 8, m.getI64(at + 40))
    m.putI64(p_transform + 16, m.getI64(at + 48))
    m.putI64(p_transform + 24, m.getI64(at + 56))
    return r.OK
}
