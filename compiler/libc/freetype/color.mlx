// FreeType's color functions (ftcolor.h): std.truetype's palettes,
// `COLR` layers and version 1 paints, on FreeType's records of them
// (FT_LayerIterator, FT_OpaquePaint, FT_COLR_Paint, FT_ClipBox,
// FT_ColorStop, FT_Palette_Data: the engine's, laid out as FreeType's).
const r = @import("std.truetype.records")
const color = @import("std.truetype.color")
const faces = @import("./faces.mlx")

fn byte(value: bool) -> u8 { return if value { 1 } else { 0 } }

export fn FT_Get_Color_Glyph_Layer(face: usize, base_glyph: u32, aglyph_index: usize, acolor_index: usize, iterator: usize) -> u8 { return byte(color.colorGlyphLayer(faces.face(face), base_glyph, aglyph_index, acolor_index, iterator)) }

export fn FT_Get_Color_Glyph_Paint(face: usize, base_glyph: u32, root_transform: i32, paint: usize) -> u8 { return byte(color.colorGlyphPaint(faces.face(face), base_glyph, root_transform, paint)) }

export fn FT_Get_Color_Glyph_ClipBox(face: usize, base_glyph: u32, clip_box: usize) -> u8 { return byte(color.colorGlyphClipBox(faces.face(face), base_glyph, clip_box)) }

export fn FT_Get_Paint_Layers(face: usize, iterator: usize, paint: usize) -> u8 { return byte(color.paintLayers(faces.face(face), iterator, paint)) }

export fn FT_Get_Colorline_Stops(face: usize, color_stop: usize, iterator: usize) -> u8 { return byte(color.colorlineStops(faces.face(face), color_stop, iterator)) }

// FT_OpaquePaint comes by value (its pointer and its flag).
export fn FT_Get_Paint(face: usize, paint_p: usize, insert_root_transform: u64, paint: usize) -> u8 { return byte(color.getPaint(faces.face(face), paint_p, insert_root_transform, paint)) }

export fn FT_Palette_Data_Get(face: usize, apalette_data: usize) -> i32 { return color.paletteDataGet(faces.face(face), apalette_data) }

export fn FT_Palette_Select(face: usize, palette_index: u16, apalette: usize) -> i32 { return color.paletteSelect(faces.face(face), palette_index, apalette) }

// FT_Color comes by value: blue, green, red, alpha in its four bytes.
export fn FT_Palette_Set_Foreground_Color(face: usize, foreground_color: u32) -> i32 { return color.setForegroundColor(faces.face(face), foreground_color) }
