// The rest of FreeType's API: charmaps, the SFNT tables and names,
// glyph names, the PostScript name and information, `gasp`, the font's
// format and CID information (std.truetype's), and the functions of
// drivers the library does not have (BDF, the patents of old) as
// FreeType answers them for an SFNT face.
const m = @import("std.truetype.memory")
const r = @import("std.truetype.records")
const info = @import("std.truetype.info")
const faces = @import("./faces.mlx")
const rec = @import("./records.mlx")

// ---------------------------------------------------------------------------
// Charmaps.

fn charmapChanged(face: usize, err: i32) -> i32 {
    if face != 0 { faces.pushFace(face) }
    return err
}

export fn FT_Select_Charmap(face: usize, encoding: u32) -> i32 { return charmapChanged(face, info.selectCharmap(faces.face(face), encoding)) }

export fn FT_Set_Charmap(face: usize, charmap: usize) -> i32 { return charmapChanged(face, info.setCharmap(faces.face(face), faces.charmap(charmap))) }

export fn FT_Get_Charmap_Index(charmap: usize) -> i32 {
    if charmap == 0 || rec.charMapRec(charmap).*.face == 0 { return -1 }
    return info.charmapIndex(faces.charmap(charmap))
}

export fn FT_Get_First_Char(face: usize, agindex: usize) -> u64 { return info.firstChar(faces.face(face), agindex) }

export fn FT_Get_Next_Char(face: usize, char_code: u64, agindex: usize) -> u64 { return info.nextChar(faces.face(face), char_code, agindex) }

export fn FT_Face_GetCharVariantIndex(face: usize, charcode: u64, variantSelector: u64) -> u32 { return info.charVariantIndex(faces.face(face), charcode, variantSelector) }

export fn FT_Face_GetCharVariantIsDefault(face: usize, charcode: u64, variantSelector: u64) -> i32 { return info.charVariantIsDefault(faces.face(face), charcode, variantSelector) }

export fn FT_Face_GetVariantSelectors(face: usize) -> usize { return info.variantSelectors(faces.face(face)) }

export fn FT_Face_GetVariantsOfChar(face: usize, charcode: u64) -> usize { return info.variantsOfChar(faces.face(face), charcode) }

export fn FT_Face_GetCharsOfVariant(face: usize, variantSelector: u64) -> usize { return info.charsOfVariant(faces.face(face), variantSelector) }

export fn FT_Get_CMap_Format(charmap: usize) -> i64 {
    if charmap == 0 || rec.charMapRec(charmap).*.face == 0 { return -1 }
    return info.charmapFormat(faces.charmap(charmap))
}

export fn FT_Get_CMap_Language_ID(charmap: usize) -> u64 {
    if charmap == 0 || rec.charMapRec(charmap).*.face == 0 { return 0 }
    return info.charmapLanguage(faces.charmap(charmap))
}

// ---------------------------------------------------------------------------
// SFNT tables and names.

export fn FT_Get_Sfnt_Table(face: usize, tag: i32) -> usize { return info.sfntTable(faces.face(face), tag) }

export fn FT_Load_Sfnt_Table(face: usize, tag: u64, offset: i64, buffer: usize, length: usize) -> i32 { return info.loadSfntTable(faces.face(face), tag, offset, buffer, length) }

export fn FT_Sfnt_Table_Info(face: usize, table_index: u32, tag: usize, length: usize) -> i32 { return info.sfntTableInfo(faces.face(face), table_index, tag, length) }

export fn FT_Get_Sfnt_Name_Count(face: usize) -> u32 { return info.sfntNameCount(faces.face(face)) }

// FT_SfntName: platform, encoding, language, name ID (16-bit), the
// string and its length (the bytes of the font, not copied).
export fn FT_Get_Sfnt_Name(face: usize, idx: u32, aname: usize) -> i32 { return info.sfntName(faces.face(face), idx, aname) }

export fn FT_Get_Sfnt_LangTag(face: usize, langID: u32, alangTag: usize) -> i32 { return info.sfntLangTag(faces.face(face), langID, alangTag) }

// ---------------------------------------------------------------------------
// Glyph names, the PostScript name and information.

export fn FT_Get_Glyph_Name(face: usize, glyph_index: u32, buffer: usize, buffer_max: u32) -> i32 { return info.glyphNameCopy(faces.face(face), glyph_index, buffer, buffer_max) }

export fn FT_Get_Name_Index(face: usize, glyph_name: usize) -> u32 { return info.nameIndex(faces.face(face), glyph_name) }

export fn FT_Get_Postscript_Name(face: usize) -> usize { return info.postscriptName(faces.face(face)) }

export fn FT_Has_PS_Glyph_Names(face: usize) -> i32 { return info.hasPsGlyphNames(faces.face(face)) }

export fn FT_Get_PS_Font_Info(face: usize, afont_info: usize) -> i32 { return info.psFontInfo(faces.face(face), afont_info) }

export fn FT_Get_PS_Font_Private(face: usize, afont_private: usize) -> i32 { return info.psFontPrivate(faces.face(face), afont_private) }

export fn FT_Get_PS_Font_Value(face: usize, key: i32, idx: u32, value: usize, value_len: i64) -> i64 { return info.psFontValue(faces.face(face), key, idx, value, value_len) }

export fn FT_Get_FSType_Flags(face: usize) -> u16 { return info.fsTypeFlags(faces.face(face)) }

export fn FT_Get_Gasp(face: usize, ppem: u32) -> i32 { return info.gasp(faces.face(face), ppem) }

export fn FT_Get_Font_Format(face: usize) -> usize { return info.fontFormat(faces.face(face)) }

export fn FT_Get_X11_Font_Format(face: usize) -> usize { return info.fontFormat(faces.face(face)) }

// ---------------------------------------------------------------------------
// BDF and CID.

// The `BDF ` table of an SFNT: none of the fonts this library opens has
// one that it reads, as FreeType finds none in a font without it.
export fn FT_Get_BDF_Charset_ID(face: usize, acharset_encoding: usize, acharset_registry: usize) -> i32 {
    var err = r.ERR_INVALID_ARGUMENT
    if face != 0 { err = r.ERR_TABLE_MISSING }
    if acharset_encoding != 0 { m.putWord(acharset_encoding, 0) }
    if acharset_registry != 0 { m.putWord(acharset_registry, 0) }
    return err
}

export fn FT_Get_BDF_Property(face: usize, prop_name: usize, aproperty: usize) -> i32 {
    if aproperty != 0 { m.putI32(aproperty, 0) }
    if face == 0 { return r.ERR_INVALID_ARGUMENT }
    return r.ERR_TABLE_MISSING
}

export fn FT_Get_CID_Registry_Ordering_Supplement(face: usize, registry: usize, ordering: usize, supplement: usize) -> i32 { return info.cidRegistryOrderingSupplement(faces.face(face), registry, ordering, supplement) }

export fn FT_Get_CID_Is_Internally_CID_Keyed(face: usize, is_cid: usize) -> i32 { return info.cidIsInternallyCidKeyed(faces.face(face), is_cid) }

export fn FT_Get_CID_From_Glyph_Index(face: usize, glyph_index: u32, cid: usize) -> i32 { return info.cidFromGlyphIndex(faces.face(face), glyph_index, cid) }

// ---------------------------------------------------------------------------
// Functions FreeType keeps for compatibility.

export fn FT_Face_CheckTrueTypePatents(face: usize) -> u8 { return 0 }
export fn FT_Face_SetUnpatentedHinting(face: usize, value: u8) -> u8 { return 0 }

// FreeType's error strings are an option it is built without.
export fn FT_Error_String(error_code: i32) -> usize { return 0 }
