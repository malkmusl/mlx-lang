// FreeType's public records of objects as the C API makes them: a face
// (FT_FaceRec), a size (FT_SizeRec), a glyph slot (FT_GlyphSlotRec) and a
// charmap (FT_CharMapRec), laid out as the C headers lay them out (Mlx
// lays a structure out as C does). Each points to the engine's record of
// the object (`internal`; a charmap's follows it), whose values it
// shows; those values are std.truetype's records (Vector, Bitmap,
// Outline...), which have FreeType's layout.
const r = @import("std.truetype.records")

// FT_FaceRec
pub const FaceRec = struct {
    num_faces: i64
    face_index: i64
    face_flags: i64
    style_flags: i64
    num_glyphs: i64
    family_name: usize
    style_name: usize
    num_fixed_sizes: i32
    available_sizes: usize
    num_charmaps: i32
    charmaps: usize
    generic_data: usize
    generic_finalizer: usize
    bbox: r.BBox
    units_per_EM: u16
    ascender: i16
    descender: i16
    height: i16
    max_advance_width: i16
    max_advance_height: i16
    underline_position: i16
    underline_thickness: i16
    glyph: usize
    size: usize
    charmap: usize
    driver: usize
    memory: usize
    stream: usize
    sizes_head: usize
    sizes_tail: usize
    autohint_data: usize
    autohint_finalizer: usize
    extensions: usize
    internal: usize
}

// FT_SizeRec
pub const SizeRec = struct {
    face: usize
    generic_data: usize
    generic_finalizer: usize
    x_ppem: u16
    y_ppem: u16
    x_scale: i64
    y_scale: i64
    ascender: i64
    descender: i64
    height: i64
    max_advance: i64
    internal: usize
}

// FT_GlyphSlotRec
pub const SlotRec = struct {
    library: usize
    face: usize
    next: usize
    glyph_index: u32
    generic_data: usize
    generic_finalizer: usize
    metrics: r.GlyphMetrics
    linearHoriAdvance: i64
    linearVertAdvance: i64
    advance: r.Vector
    format: u32
    bitmap: r.Bitmap
    bitmap_left: i32
    bitmap_top: i32
    outline: r.Outline
    num_subglyphs: u32
    subglyphs: usize
    control_data: usize
    control_len: i64
    lsb_delta: i64
    rsb_delta: i64
    other: usize
    internal: usize
}

// FT_CharMapRec, then the engine's charmap it is.
pub const CharMapRec = struct {
    face: usize
    encoding: u32
    platform_id: u16
    encoding_id: u16
    engine: usize
}

pub fn faceRec(address: usize) -> *FaceRec { unsafe { return @ptrFromInt(*FaceRec, address) } }
pub fn sizeRec(address: usize) -> *SizeRec { unsafe { return @ptrFromInt(*SizeRec, address) } }
pub fn slotRec(address: usize) -> *SlotRec { unsafe { return @ptrFromInt(*SlotRec, address) } }
pub fn charMapRec(address: usize) -> *CharMapRec { unsafe { return @ptrFromInt(*CharMapRec, address) } }

pub const FACE_REC_SIZE: usize = 248
pub const SIZE_REC_SIZE: usize = 88
pub const SLOT_REC_SIZE: usize = 304
pub const CHARMAP_REC_SIZE: usize = 24
