// freetype/ftcid.h
// mlx-freetype: CID-keyed fonts (CFF fonts with a ROS in their Top DICT):
// their registry, ordering and supplement, and the CIDs of their glyphs.
const freetype = @import("./freetype.mlx")

pub extern("c") fn FT_Get_CID_Registry_Ordering_Supplement(face: freetype.FT_Face, registry: **const c_char, ordering: **const c_char, supplement: *fttypes.FT_Int) -> fttypes.FT_Error
pub extern("c") fn FT_Get_CID_Is_Internally_CID_Keyed(face: freetype.FT_Face, is_cid: *fttypes.FT_Bool) -> fttypes.FT_Error
pub extern("c") fn FT_Get_CID_From_Glyph_Index(face: freetype.FT_Face, glyph_index: fttypes.FT_UInt, cid: *fttypes.FT_UInt) -> fttypes.FT_Error
