// freetype/ftadvanc.h
// mlx-freetype: the advances of glyphs without loading them: in 16.16
// pixels (or font units with FT_LOAD_NO_SCALE), from the font's metrics
// tables and its variations.
const freetype = @import("./freetype.mlx")

pub const FT_ADVANCE_FLAG_FAST_ONLY: c_long = 0x20000000

// The advance of glyph `gindex` (horizontal, or vertical with
// FT_LOAD_VERTICAL_LAYOUT).
pub extern("c") fn FT_Get_Advance(face: freetype.FT_Face, gindex: fttypes.FT_UInt, load_flags: integertypes.FT_Int32, padvance: *fttypes.FT_Fixed) -> fttypes.FT_Error
pub extern("c") fn FT_Get_Advances(face: freetype.FT_Face, start: fttypes.FT_UInt, count: fttypes.FT_UInt, load_flags: integertypes.FT_Int32, padvances: *fttypes.FT_Fixed) -> fttypes.FT_Error
