// freetype/ftmm.h
// mlx-freetype: variable fonts (OpenType font variations: `fvar` and the
// tables that vary with it). A face of one has axes, named instances and
// the coordinates it is set to, in design units (16.16) or normalized
// (-1 to 1, 16.16), which its outlines, advances and metrics follow.
const freetype = @import("./freetype.mlx")
const t1tables = @import("./t1tables.mlx")

const FT_String = fttypes.FT_String
const FT_Long = fttypes.FT_Long
const FT_ULong = fttypes.FT_ULong
const FT_UInt = fttypes.FT_UInt
const FT_Fixed = fttypes.FT_Fixed
const FT_Error = fttypes.FT_Error
const FT_Face = freetype.FT_Face

pub const FT_MM_Axis_ = struct {
    name: *FT_String
    minimum: FT_Long
    maximum: FT_Long
}
pub const FT_MM_Axis = FT_MM_Axis_

pub const FT_Multi_Master_ = struct {
    num_axis: FT_UInt
    num_designs: FT_UInt
    axis: [4]FT_MM_Axis
}
pub const FT_Multi_Master = FT_Multi_Master_

// An axis: its name (of the `name` table, `strid`), its range and
// default (16.16) and its tag.
pub const FT_Var_Axis_ = struct {
    name: *FT_String
    minimum: FT_Fixed
    def: FT_Fixed
    maximum: FT_Fixed
    tag: FT_ULong
    strid: FT_UInt
}
pub const FT_Var_Axis = FT_Var_Axis_

pub const FT_Var_Named_Style_ = struct {
    coords: *FT_Fixed
    strid: FT_UInt
    psid: FT_UInt
}
pub const FT_Var_Named_Style = FT_Var_Named_Style_

// The axes and named instances of a variable font, in one block the
// library's memory allocated (FT_Done_MM_Var frees it).
pub const FT_MM_Var_ = struct {
    num_axis: FT_UInt
    num_designs: FT_UInt
    num_namedstyles: FT_UInt
    axis: *FT_Var_Axis
    namedstyle: *FT_Var_Named_Style
}
pub const FT_MM_Var = FT_MM_Var_

pub extern("c") fn FT_Get_Multi_Master(face: FT_Face, amaster: *FT_Multi_Master) -> FT_Error
pub extern("c") fn FT_Get_MM_Var(face: FT_Face, amaster: **FT_MM_Var) -> FT_Error
pub extern("c") fn FT_Done_MM_Var(library: freetype.FT_Library, amaster: *FT_MM_Var) -> FT_Error
pub extern("c") fn FT_Set_MM_Design_Coordinates(face: FT_Face, num_coords: FT_UInt, coords: *FT_Long) -> FT_Error
// The coordinates of the first `num_coords` axes (the others their
// defaults); NULL coordinates set the default instance.
pub extern("c") fn FT_Set_Var_Design_Coordinates(face: FT_Face, num_coords: FT_UInt, coords: *FT_Fixed) -> FT_Error
pub extern("c") fn FT_Get_Var_Design_Coordinates(face: FT_Face, num_coords: FT_UInt, coords: *FT_Fixed) -> FT_Error
pub extern("c") fn FT_Set_MM_Blend_Coordinates(face: FT_Face, num_coords: FT_UInt, coords: *FT_Fixed) -> FT_Error
pub extern("c") fn FT_Get_MM_Blend_Coordinates(face: FT_Face, num_coords: FT_UInt, coords: *FT_Fixed) -> FT_Error
pub extern("c") fn FT_Set_Var_Blend_Coordinates(face: FT_Face, num_coords: FT_UInt, coords: *FT_Fixed) -> FT_Error
pub extern("c") fn FT_Get_Var_Blend_Coordinates(face: FT_Face, num_coords: FT_UInt, coords: *FT_Fixed) -> FT_Error
pub extern("c") fn FT_Set_MM_WeightVector(face: FT_Face, len: FT_UInt, weightvector: *FT_Fixed) -> FT_Error
pub extern("c") fn FT_Get_MM_WeightVector(face: FT_Face, len: *FT_UInt, weightvector: *FT_Fixed) -> FT_Error

pub const FT_VAR_AXIS_FLAG_HIDDEN: c_int = 1

pub extern("c") fn FT_Get_Var_Axis_Flags(master: *FT_MM_Var, axis_index: FT_UInt, flags: *FT_UInt) -> FT_Error
pub extern("c") fn FT_Set_Named_Instance(face: FT_Face, instance_index: FT_UInt) -> FT_Error
pub extern("c") fn FT_Get_Default_Named_Instance(face: FT_Face, instance_index: *FT_UInt) -> FT_Error
