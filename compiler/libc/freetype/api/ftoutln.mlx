// freetype/ftoutln.h
// mlx-freetype: outlines: walking their segments, transforming,
// translating, emboldening and reversing them, their control box and
// orientation, rendering them into a bitmap.
const freetype = @import("./freetype.mlx")

const FT_Outline = ftimage.FT_Outline
const FT_Error = fttypes.FT_Error
const FT_Pos = ftimage.FT_Pos

// Calls `func_interface`'s functions for each contour of the outline:
// move_to its start, then line_to, conic_to and cubic_to along it (a
// contour is closed by a line or curve back to its start).
pub extern("c") fn FT_Outline_Decompose(outline: *FT_Outline, func_interface: *const ftimage.FT_Outline_Funcs, user: *anyopaque) -> FT_Error
pub extern("c") fn FT_Outline_New(library: freetype.FT_Library, numPoints: fttypes.FT_UInt, numContours: fttypes.FT_Int, anoutline: *FT_Outline) -> FT_Error
pub extern("c") fn FT_Outline_Done(library: freetype.FT_Library, outline: *FT_Outline) -> FT_Error
pub extern("c") fn FT_Outline_Check(outline: *FT_Outline) -> FT_Error
// The box of all points of the outline, control points too.
pub extern("c") fn FT_Outline_Get_CBox(outline: *const FT_Outline, acbox: *ftimage.FT_BBox) -> void
pub extern("c") fn FT_Outline_Translate(outline: *const FT_Outline, xOffset: FT_Pos, yOffset: FT_Pos) -> void
pub extern("c") fn FT_Outline_Copy(source: *const FT_Outline, target: *FT_Outline) -> FT_Error
pub extern("c") fn FT_Outline_Transform(outline: *const FT_Outline, matrix: *const fttypes.FT_Matrix) -> void
// The outline made `strength` (26.6) wider and higher, its contours
// moved out by half of it each side.
pub extern("c") fn FT_Outline_Embolden(outline: *FT_Outline, strength: FT_Pos) -> FT_Error
pub extern("c") fn FT_Outline_EmboldenXY(outline: *FT_Outline, xstrength: FT_Pos, ystrength: FT_Pos) -> FT_Error
pub extern("c") fn FT_Outline_Reverse(outline: *FT_Outline) -> void
pub extern("c") fn FT_Outline_Get_Bitmap(library: freetype.FT_Library, outline: *FT_Outline, abitmap: *const ftimage.FT_Bitmap) -> FT_Error
pub extern("c") fn FT_Outline_Render(library: freetype.FT_Library, outline: *FT_Outline, params: *ftimage.FT_Raster_Params) -> FT_Error

pub const FT_Orientation_ = enum(c_int) {
    FT_ORIENTATION_TRUETYPE = 0,
    FT_ORIENTATION_POSTSCRIPT = 1,
    FT_ORIENTATION_FILL_RIGHT = 0,
    FT_ORIENTATION_FILL_LEFT = 1,
    FT_ORIENTATION_NONE = 2,
}
pub const FT_Orientation = FT_Orientation_

pub extern("c") fn FT_Outline_Get_Orientation(outline: *FT_Outline) -> FT_Orientation
