// freetype/ftsystem.h
// mlx-freetype: memory and streams. A library allocates through its
// memory object (FT_New_Library takes one; FT_Init_FreeType makes one on
// the C library's allocator); a face reads its font through a stream,
// which is the font's bytes in memory or a function reading them.
const c_function_pointers = true

pub const FT_MemoryRec_ = struct {
    user: *anyopaque
    alloc: FT_Alloc_Func
    free: FT_Free_Func
    realloc: FT_Realloc_Func
}
pub const FT_Memory = *FT_MemoryRec_

pub const FT_Alloc_Func = fn(memory: FT_Memory, size: c_long) -> *anyopaque
pub const FT_Free_Func = fn(memory: FT_Memory, block: *anyopaque) -> void
pub const FT_Realloc_Func = fn(memory: FT_Memory, cur_size: c_long, new_size: c_long, block: *anyopaque) -> *anyopaque

pub const FT_StreamDesc_ = union {
    value: c_long
    pointer: *anyopaque
}
pub const FT_StreamDesc = FT_StreamDesc_

pub const FT_Stream = *FT_StreamRec_

pub const FT_Stream_IoFunc = fn(stream: FT_Stream, offset: c_ulong, buffer: *c_uchar, count: c_ulong) -> c_ulong
pub const FT_Stream_CloseFunc = fn(stream: FT_Stream) -> void

// A stream: `base` and `size` for one in memory (`read` NULL), or `read`
// called for each part wanted; `close` when the face is done with it.
pub const FT_StreamRec_ = struct {
    base: *c_uchar
    size: c_ulong
    pos: c_ulong
    descriptor: FT_StreamDesc
    pathname: FT_StreamDesc
    read: FT_Stream_IoFunc
    close: FT_Stream_CloseFunc
    memory: FT_Memory
    cursor: *c_uchar
    limit: *c_uchar
}
pub const FT_StreamRec = FT_StreamRec_
