// freetype/ftcolor.h
// mlx-freetype: color fonts. The palettes of a font's `CPAL` table, the
// layers of a color glyph of its `COLR` table (version 0): glyphs drawn
// one over the other, each in a color of the palette; and the paints of
// version 1, a graph of gradients, transforms and compositions that the
// program walks (FT_Get_Color_Glyph_Paint, FT_Get_Paint) and draws.
const c_keyword_names = true
const freetype = @import("./freetype.mlx")

const FT_Byte = fttypes.FT_Byte
const FT_UShort = fttypes.FT_UShort
const FT_UInt = fttypes.FT_UInt
const FT_Fixed = fttypes.FT_Fixed
const FT_Bool = fttypes.FT_Bool
const FT_Face = freetype.FT_Face
const FT_Vector = ftimage.FT_Vector

// A color of a palette, alpha not premultiplied.
pub const FT_Color_ = struct {
    blue: FT_Byte
    green: FT_Byte
    red: FT_Byte
    alpha: FT_Byte
}
pub const FT_Color = FT_Color_

pub const FT_PALETTE_FOR_LIGHT_BACKGROUND: c_int = 0x01
pub const FT_PALETTE_FOR_DARK_BACKGROUND: c_int = 0x02

// What the font's `CPAL` has: its palettes (their names and flags, NULL
// when it gives none) and the number of colors of each.
pub const FT_Palette_Data_ = struct {
    num_palettes: FT_UShort
    palette_name_ids: *const FT_UShort
    palette_flags: *const FT_UShort
    num_palette_entries: FT_UShort
    palette_entry_name_ids: *const FT_UShort
}
pub const FT_Palette_Data = FT_Palette_Data_

pub extern("c") fn FT_Palette_Data_Get(face: FT_Face, apalette: *FT_Palette_Data) -> fttypes.FT_Error
// Makes palette `palette_index` the face's own, a copy whose colors the
// program may change; `*apalette` is it (NULL to not have it).
pub extern("c") fn FT_Palette_Select(face: FT_Face, palette_index: FT_UShort, apalette: **FT_Color) -> fttypes.FT_Error
pub extern("c") fn FT_Palette_Set_Foreground_Color(face: FT_Face, foreground_color: FT_Color) -> fttypes.FT_Error

// Where FT_Get_Color_Glyph_Layer is among a glyph's layers (`p` NULL
// before the first).
pub const FT_LayerIterator_ = struct {
    num_layers: FT_UInt
    layer: FT_UInt
    p: *FT_Byte
}
pub const FT_LayerIterator = FT_LayerIterator_

// The next layer of the color glyph `base_glyph`: its glyph and its
// color (0xFFFF for the foreground color); false after the last, or
// when the glyph has no layers.
pub extern("c") fn FT_Get_Color_Glyph_Layer(face: FT_Face, base_glyph: FT_UInt, aglyph_index: *FT_UInt, acolor_index: *FT_UInt, iterator: *FT_LayerIterator) -> FT_Bool

pub const FT_PaintFormat_ = enum(c_int) {
    FT_COLR_PAINTFORMAT_COLR_LAYERS = 1,
    FT_COLR_PAINTFORMAT_SOLID = 2,
    FT_COLR_PAINTFORMAT_LINEAR_GRADIENT = 4,
    FT_COLR_PAINTFORMAT_RADIAL_GRADIENT = 6,
    FT_COLR_PAINTFORMAT_SWEEP_GRADIENT = 8,
    FT_COLR_PAINTFORMAT_GLYPH = 10,
    FT_COLR_PAINTFORMAT_COLR_GLYPH = 11,
    FT_COLR_PAINTFORMAT_TRANSFORM = 12,
    FT_COLR_PAINTFORMAT_TRANSLATE = 14,
    FT_COLR_PAINTFORMAT_SCALE = 16,
    FT_COLR_PAINTFORMAT_ROTATE = 24,
    FT_COLR_PAINTFORMAT_SKEW = 28,
    FT_COLR_PAINTFORMAT_COMPOSITE = 32,
    FT_COLR_PAINT_FORMAT_MAX = 33,
    FT_COLR_PAINTFORMAT_UNSUPPORTED = 255,
}
pub const FT_PaintFormat = FT_PaintFormat_

pub const FT_ColorStopIterator_ = struct {
    num_color_stops: FT_UInt
    current_color_stop: FT_UInt
    p: *FT_Byte
    read_variable: FT_Bool
}
pub const FT_ColorStopIterator = FT_ColorStopIterator_

pub const FT_ColorIndex_ = struct {
    palette_index: integertypes.FT_UInt16
    alpha: fttypes.FT_F2Dot14
}
pub const FT_ColorIndex = FT_ColorIndex_

pub const FT_ColorStop_ = struct {
    stop_offset: FT_Fixed
    color: FT_ColorIndex
}
pub const FT_ColorStop = FT_ColorStop_

pub const FT_PaintExtend_ = enum(c_int) {
    FT_COLR_PAINT_EXTEND_PAD = 0,
    FT_COLR_PAINT_EXTEND_REPEAT = 1,
    FT_COLR_PAINT_EXTEND_REFLECT = 2,
}
pub const FT_PaintExtend = FT_PaintExtend_

pub const FT_ColorLine_ = struct {
    extend: FT_PaintExtend
    color_stop_iterator: FT_ColorStopIterator
}
pub const FT_ColorLine = FT_ColorLine_

pub const FT_Affine_23_ = struct {
    xx: FT_Fixed
    xy: FT_Fixed
    dx: FT_Fixed
    yx: FT_Fixed
    yy: FT_Fixed
    dy: FT_Fixed
}
pub const FT_Affine23 = FT_Affine_23_

pub const FT_Composite_Mode_ = enum(c_int) {
    FT_COLR_COMPOSITE_CLEAR = 0,
    FT_COLR_COMPOSITE_SRC = 1,
    FT_COLR_COMPOSITE_DEST = 2,
    FT_COLR_COMPOSITE_SRC_OVER = 3,
    FT_COLR_COMPOSITE_DEST_OVER = 4,
    FT_COLR_COMPOSITE_SRC_IN = 5,
    FT_COLR_COMPOSITE_DEST_IN = 6,
    FT_COLR_COMPOSITE_SRC_OUT = 7,
    FT_COLR_COMPOSITE_DEST_OUT = 8,
    FT_COLR_COMPOSITE_SRC_ATOP = 9,
    FT_COLR_COMPOSITE_DEST_ATOP = 10,
    FT_COLR_COMPOSITE_XOR = 11,
    FT_COLR_COMPOSITE_PLUS = 12,
    FT_COLR_COMPOSITE_SCREEN = 13,
    FT_COLR_COMPOSITE_OVERLAY = 14,
    FT_COLR_COMPOSITE_DARKEN = 15,
    FT_COLR_COMPOSITE_LIGHTEN = 16,
    FT_COLR_COMPOSITE_COLOR_DODGE = 17,
    FT_COLR_COMPOSITE_COLOR_BURN = 18,
    FT_COLR_COMPOSITE_HARD_LIGHT = 19,
    FT_COLR_COMPOSITE_SOFT_LIGHT = 20,
    FT_COLR_COMPOSITE_DIFFERENCE = 21,
    FT_COLR_COMPOSITE_EXCLUSION = 22,
    FT_COLR_COMPOSITE_MULTIPLY = 23,
    FT_COLR_COMPOSITE_HSL_HUE = 24,
    FT_COLR_COMPOSITE_HSL_SATURATION = 25,
    FT_COLR_COMPOSITE_HSL_COLOR = 26,
    FT_COLR_COMPOSITE_HSL_LUMINOSITY = 27,
    FT_COLR_COMPOSITE_MAX = 28,
}
pub const FT_Composite_Mode = FT_Composite_Mode_

pub const FT_Opaque_Paint_ = struct {
    p: *FT_Byte
    insert_root_transform: FT_Bool
}
pub const FT_OpaquePaint = FT_Opaque_Paint_

pub const FT_PaintColrLayers_ = struct {
    layer_iterator: FT_LayerIterator
}
pub const FT_PaintColrLayers = FT_PaintColrLayers_

pub const FT_PaintSolid_ = struct {
    color: FT_ColorIndex
}
pub const FT_PaintSolid = FT_PaintSolid_

pub const FT_PaintLinearGradient_ = struct {
    colorline: FT_ColorLine
    p0: FT_Vector
    p1: FT_Vector
    p2: FT_Vector
}
pub const FT_PaintLinearGradient = FT_PaintLinearGradient_

pub const FT_PaintRadialGradient_ = struct {
    colorline: FT_ColorLine
    c0: FT_Vector
    r0: ftimage.FT_Pos
    c1: FT_Vector
    r1: ftimage.FT_Pos
}
pub const FT_PaintRadialGradient = FT_PaintRadialGradient_

pub const FT_PaintSweepGradient_ = struct {
    colorline: FT_ColorLine
    center: FT_Vector
    start_angle: FT_Fixed
    end_angle: FT_Fixed
}
pub const FT_PaintSweepGradient = FT_PaintSweepGradient_

pub const FT_PaintGlyph_ = struct {
    paint: FT_OpaquePaint
    glyphID: FT_UInt
}
pub const FT_PaintGlyph = FT_PaintGlyph_

pub const FT_PaintColrGlyph_ = struct {
    glyphID: FT_UInt
}
pub const FT_PaintColrGlyph = FT_PaintColrGlyph_

pub const FT_PaintTransform_ = struct {
    paint: FT_OpaquePaint
    affine: FT_Affine23
}
pub const FT_PaintTransform = FT_PaintTransform_

pub const FT_PaintTranslate_ = struct {
    paint: FT_OpaquePaint
    dx: FT_Fixed
    dy: FT_Fixed
}
pub const FT_PaintTranslate = FT_PaintTranslate_

pub const FT_PaintScale_ = struct {
    paint: FT_OpaquePaint
    scale_x: FT_Fixed
    scale_y: FT_Fixed
    center_x: FT_Fixed
    center_y: FT_Fixed
}
pub const FT_PaintScale = FT_PaintScale_

pub const FT_PaintRotate_ = struct {
    paint: FT_OpaquePaint
    angle: FT_Fixed
    center_x: FT_Fixed
    center_y: FT_Fixed
}
pub const FT_PaintRotate = FT_PaintRotate_

pub const FT_PaintSkew_ = struct {
    paint: FT_OpaquePaint
    x_skew_angle: FT_Fixed
    y_skew_angle: FT_Fixed
    center_x: FT_Fixed
    center_y: FT_Fixed
}
pub const FT_PaintSkew = FT_PaintSkew_

pub const FT_PaintComposite_ = struct {
    source_paint: FT_OpaquePaint
    composite_mode: FT_Composite_Mode
    backdrop_paint: FT_OpaquePaint
}
pub const FT_PaintComposite = FT_PaintComposite_

pub const FT_COLR_Paint_ = struct {
    format: FT_PaintFormat
    u: union {
        colr_layers: FT_PaintColrLayers
        glyph: FT_PaintGlyph
        solid: FT_PaintSolid
        linear_gradient: FT_PaintLinearGradient
        radial_gradient: FT_PaintRadialGradient
        sweep_gradient: FT_PaintSweepGradient
        transform: FT_PaintTransform
        translate: FT_PaintTranslate
        scale: FT_PaintScale
        rotate: FT_PaintRotate
        skew: FT_PaintSkew
        composite: FT_PaintComposite
        colr_glyph: FT_PaintColrGlyph
    }
}
pub const FT_COLR_Paint = FT_COLR_Paint_

pub const FT_Color_Root_Transform_ = enum(c_int) {
    FT_COLOR_INCLUDE_ROOT_TRANSFORM = 0,
    FT_COLOR_NO_ROOT_TRANSFORM = 1,
    FT_COLOR_ROOT_TRANSFORM_MAX = 2,
}
pub const FT_Color_Root_Transform = FT_Color_Root_Transform_

pub const FT_ClipBox_ = struct {
    bottom_left: FT_Vector
    top_left: FT_Vector
    top_right: FT_Vector
    bottom_right: FT_Vector
}
pub const FT_ClipBox = FT_ClipBox_

pub extern("c") fn FT_Get_Color_Glyph_Paint(face: FT_Face, base_glyph: FT_UInt, root_transform: FT_Color_Root_Transform, paint: *FT_OpaquePaint) -> FT_Bool
pub extern("c") fn FT_Get_Color_Glyph_ClipBox(face: FT_Face, base_glyph: FT_UInt, clip_box: *FT_ClipBox) -> FT_Bool
pub extern("c") fn FT_Get_Paint_Layers(face: FT_Face, iterator: *FT_LayerIterator, paint: *FT_OpaquePaint) -> FT_Bool
pub extern("c") fn FT_Get_Colorline_Stops(face: FT_Face, color_stop: *FT_ColorStop, iterator: *FT_ColorStopIterator) -> FT_Bool
pub extern("c") fn FT_Get_Paint(face: FT_Face, opaque_paint: FT_OpaquePaint, paint: *FT_COLR_Paint) -> FT_Bool
