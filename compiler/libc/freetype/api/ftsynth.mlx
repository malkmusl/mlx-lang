// freetype/ftsynth.h
// mlx-freetype: bold and oblique made of a regular glyph in the slot.
const freetype = @import("./freetype.mlx")

pub extern("c") fn FT_GlyphSlot_Embolden(slot: freetype.FT_GlyphSlot) -> void
pub extern("c") fn FT_GlyphSlot_AdjustWeight(slot: freetype.FT_GlyphSlot, xdelta: fttypes.FT_Fixed, ydelta: fttypes.FT_Fixed) -> void
pub extern("c") fn FT_GlyphSlot_Oblique(slot: freetype.FT_GlyphSlot) -> void
pub extern("c") fn FT_GlyphSlot_Slant(slot: freetype.FT_GlyphSlot, xslant: fttypes.FT_Fixed, yslant: fttypes.FT_Fixed) -> void
