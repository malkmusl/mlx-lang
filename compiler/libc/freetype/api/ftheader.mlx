// freetype/config/ftheader.h
// mlx-freetype: the names of the library's headers, as FreeType 2.13
// gives them (`#include FT_FREETYPE_H` after <ft2build.h>). The library
// is this repository's own, in Mlx (compiler/libc/freetype); these modules
// declare what C and C++ programs written for FreeType name, and
// mlx-cheaders makes the headers of them.

pub const FT_CONFIG_CONFIG_H: []const u8 = "freetype/config/ftconfig.h"
pub const FT_CONFIG_STANDARD_LIBRARY_H: []const u8 = "freetype/config/ftstdlib.h"
pub const FT_CONFIG_OPTIONS_H: []const u8 = "freetype/config/ftoption.h"
pub const FT_FREETYPE_H: []const u8 = "freetype/freetype.h"
pub const FT_ERRORS_H: []const u8 = "freetype/fterrors.h"
pub const FT_MODULE_ERRORS_H: []const u8 = "freetype/ftmoderr.h"
pub const FT_SYSTEM_H: []const u8 = "freetype/ftsystem.h"
pub const FT_IMAGE_H: []const u8 = "freetype/ftimage.h"
pub const FT_TYPES_H: []const u8 = "freetype/fttypes.h"
pub const FT_OUTLINE_H: []const u8 = "freetype/ftoutln.h"
pub const FT_SIZES_H: []const u8 = "freetype/ftsizes.h"
pub const FT_MODULE_H: []const u8 = "freetype/ftmodapi.h"
pub const FT_DRIVER_H: []const u8 = "freetype/ftdriver.h"
