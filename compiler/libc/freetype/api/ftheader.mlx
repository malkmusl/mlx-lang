pub const FT_PCF_DRIVER_H: []const u8 = "freetype/ftdriver.h"
pub const FT_TYPE1_TABLES_H: []const u8 = "freetype/t1tables.h"
pub const FT_TRUETYPE_IDS_H: []const u8 = "freetype/ttnameid.h"
pub const FT_TRUETYPE_TABLES_H: []const u8 = "freetype/tttables.h"
pub const FT_TRUETYPE_TAGS_H: []const u8 = "freetype/tttags.h"
pub const FT_BDF_H: []const u8 = "freetype/ftbdf.h"
pub const FT_CID_H: []const u8 = "freetype/ftcid.h"
pub const FT_GLYPH_H: []const u8 = "freetype/ftglyph.h"
