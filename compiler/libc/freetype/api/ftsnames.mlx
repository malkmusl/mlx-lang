// freetype/ftsnames.h
// mlx-freetype: the records of a font's `name` table, as they are (each
// string in its encoding: UTF-16BE for the Unicode and Microsoft
// platforms).
const freetype = @import("./freetype.mlx")
const ftparams = @import("./ftparams.mlx")

const FT_UShort = fttypes.FT_UShort

pub const FT_SfntName_ = struct {
    platform_id: FT_UShort
    encoding_id: FT_UShort
    language_id: FT_UShort
    name_id: FT_UShort
    string: *fttypes.FT_Byte
    string_len: fttypes.FT_UInt
}
pub const FT_SfntName = FT_SfntName_

pub extern("c") fn FT_Get_Sfnt_Name_Count(face: freetype.FT_Face) -> fttypes.FT_UInt
pub extern("c") fn FT_Get_Sfnt_Name(face: freetype.FT_Face, idx: fttypes.FT_UInt, aname: *FT_SfntName) -> fttypes.FT_Error

pub const FT_SfntLangTag_ = struct {
    string: *fttypes.FT_Byte
    string_len: fttypes.FT_UInt
}
pub const FT_SfntLangTag = FT_SfntLangTag_

pub extern("c") fn FT_Get_Sfnt_LangTag(face: freetype.FT_Face, langID: fttypes.FT_UInt, alangTag: *FT_SfntLangTag) -> fttypes.FT_Error
