// freetype/config/ftstdlib.h
// mlx-freetype: the C library's limits and functions under FreeType's
// names (`ft_smalloc` for malloc and the like), as a program that gives
// FreeType its own memory functions uses them.
const c_system_headers = "stddef.h limits.h string.h stdio.h stdlib.h"

pub const FT_CHAR_BIT: c_int = 8
pub const FT_USHORT_MAX: c_int = 65535
pub const FT_INT_MAX: c_int = 2147483647
pub const FT_INT_MIN: c_int = -2147483647 - 1
pub const FT_UINT_MAX: c_uint = @intCast(c_uint, 0xffffffff)
pub const FT_LONG_MIN: c_long = @intCast(c_long, -9223372036854775807 - 1)
pub const FT_LONG_MAX: c_long = @intCast(c_long, 9223372036854775807)
pub const FT_ULONG_MAX: c_ulong = @intCast(c_ulong, 0xffffffffffffffff)
pub const FT_LLONG_MAX: c_longlong = @intCast(c_longlong, 9223372036854775807)
pub const FT_LLONG_MIN: c_longlong = @intCast(c_longlong, -9223372036854775807 - 1)
pub const FT_ULLONG_MAX: c_ulonglong = @intCast(c_ulonglong, 0xffffffffffffffff)

pub const ft_ptrdiff_t: c_int = ptrdiff_t
pub const ft_memchr: c_int = memchr
pub const ft_memcmp: c_int = memcmp
pub const ft_memcpy: c_int = memcpy
pub const ft_memmove: c_int = memmove
pub const ft_memset: c_int = memset
pub const ft_strcat: c_int = strcat
pub const ft_strcmp: c_int = strcmp
pub const ft_strcpy: c_int = strcpy
pub const ft_strlen: c_int = strlen
pub const ft_strncmp: c_int = strncmp
pub const ft_strncpy: c_int = strncpy
pub const ft_strrchr: c_int = strrchr
pub const ft_strstr: c_int = strstr
pub const FT_FILE: c_int = FILE
pub const ft_fclose: c_int = fclose
pub const ft_fopen: c_int = fopen
pub const ft_fread: c_int = fread
pub const ft_fseek: c_int = fseek
pub const ft_ftell: c_int = ftell
pub const ft_snprintf: c_int = snprintf
pub const ft_qsort: c_int = qsort
pub const ft_scalloc: c_int = calloc
pub const ft_sfree: c_int = free
pub const ft_smalloc: c_int = malloc
pub const ft_srealloc: c_int = realloc
pub const ft_strtol: c_int = strtol
pub const ft_getenv: c_int = getenv
