// freetype/fttrigon.h
// mlx-freetype: angles (16.16 degrees) and the trigonometry of vectors,
// worked out by CORDIC in fixed point as FreeType does it.
const freetype = @import("./freetype.mlx")

const FT_Fixed = fttypes.FT_Fixed
const FT_Vector = ftimage.FT_Vector

pub const FT_Angle = FT_Fixed

pub const FT_ANGLE_PI: c_long = 180 << 16
pub const FT_ANGLE_2PI: c_long = 360 << 16
pub const FT_ANGLE_PI2: c_long = 90 << 16
pub const FT_ANGLE_PI4: c_long = 45 << 16

pub extern("c") fn FT_Sin(angle: FT_Angle) -> FT_Fixed
pub extern("c") fn FT_Cos(angle: FT_Angle) -> FT_Fixed
pub extern("c") fn FT_Tan(angle: FT_Angle) -> FT_Fixed
pub extern("c") fn FT_Atan2(x: FT_Fixed, y: FT_Fixed) -> FT_Angle
pub extern("c") fn FT_Angle_Diff(angle1: FT_Angle, angle2: FT_Angle) -> FT_Angle
pub extern("c") fn FT_Vector_Unit(vec: *FT_Vector, angle: FT_Angle) -> void
pub extern("c") fn FT_Vector_Rotate(vec: *FT_Vector, angle: FT_Angle) -> void
pub extern("c") fn FT_Vector_Length(vec: *FT_Vector) -> FT_Fixed
pub extern("c") fn FT_Vector_Polarize(vec: *FT_Vector, length: *FT_Fixed, angle: *FT_Angle) -> void
pub extern("c") fn FT_Vector_From_Polar(vec: *FT_Vector, length: FT_Fixed, angle: FT_Angle) -> void
