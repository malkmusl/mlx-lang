// freetype/fttypes.h
// mlx-freetype: FreeType's basic types: integers by their use (font
// units, 16.16 and 26.6 fixed point, 2.14 for unit vectors), tags, the
// matrix, client data with a finalizer, lists.
const c_function_pointers = true
const c_system_headers = "stddef.h"
const ft2build = @import("./ft2build.mlx")
const ftconfig = @import("./ftconfig.mlx")
const ftsystem = @import("./ftsystem.mlx")
const ftimage = @import("./ftimage.mlx")

// (Mlx names of C types: C has them as they are.)
pub const c_char = u8
pub const c_schar = i8
pub const c_uchar = u8
pub const c_short = i16
pub const c_ushort = u16
pub const c_int = i32
pub const c_uint = u32
pub const c_long = i64
pub const c_ulong = u64

pub const FT_Bool = c_uchar
pub const FT_FWord = c_short
pub const FT_UFWord = c_ushort
pub const FT_Char = c_schar
pub const FT_Byte = c_uchar
pub const FT_Bytes = *const FT_Byte
pub const FT_Tag = c_uint
pub const FT_String = c_char
pub const FT_Short = c_short
pub const FT_UShort = c_ushort
pub const FT_Int = c_int
pub const FT_UInt = c_uint
pub const FT_Long = c_long
pub const FT_ULong = c_ulong
// 2.14 fixed point (unit vectors, variation coordinates of a font).
pub const FT_F2Dot14 = c_short
// 26.6 fixed point (pixel coordinates).
pub const FT_F26Dot6 = c_long
// 16.16 fixed point (scales, the matrix).
pub const FT_Fixed = c_long
pub const FT_Error = c_int
pub const FT_Pointer = *anyopaque
pub const FT_Offset = usize
pub const FT_PtrDist = isize

pub const FT_UnitVector_ = struct {
    x: FT_F2Dot14
    y: FT_F2Dot14
}
pub const FT_UnitVector = FT_UnitVector_

// The 2x2 matrix of 16.16 values: x' = xx * x + xy * y, y' = yx * x + yy * y.
pub const FT_Matrix_ = struct {
    xx: FT_Fixed
    xy: FT_Fixed
    yx: FT_Fixed
    yy: FT_Fixed
}
pub const FT_Matrix = FT_Matrix_

pub const FT_Data_ = struct {
    pointer: *const FT_Byte
    length: FT_UInt
}
pub const FT_Data = FT_Data_

pub const FT_Generic_Finalizer = fn(object: *anyopaque) -> void

// Data a client attaches to an object, finalized with it.
pub const FT_Generic_ = struct {
    data: *anyopaque
    finalizer: FT_Generic_Finalizer
}
pub const FT_Generic = FT_Generic_

pub fn FT_MAKE_TAG(_x1: anytype, _x2: anytype, _x3: anytype, _x4: anytype) -> FT_Tag {
    return (@intCast(FT_Tag, @intCast(c_uchar, _x1)) << 24) | (@intCast(FT_Tag, @intCast(c_uchar, _x2)) << 16) | (@intCast(FT_Tag, @intCast(c_uchar, _x3)) << 8) | @intCast(FT_Tag, @intCast(c_uchar, _x4))
}

pub const FT_ListNode = *FT_ListNodeRec_
pub const FT_List = *FT_ListRec_

pub const FT_ListNodeRec_ = struct {
    prev: FT_ListNode
    next: FT_ListNode
    data: *anyopaque
}
pub const FT_ListNodeRec = FT_ListNodeRec_

pub const FT_ListRec_ = struct {
    head: FT_ListNode
    tail: FT_ListNode
}
pub const FT_ListRec = FT_ListRec_

pub fn FT_IS_EMPTY(list: anytype) -> bool { return list.head == null }
pub fn FT_BOOL(x: anytype) -> FT_Bool { return @intCast(FT_Bool, x != 0) }
pub fn FT_ERROR_BASE(x: anytype) -> c_int { return x & 0xFF }
pub fn FT_ERROR_MODULE(x: anytype) -> c_int { return x & 0xFF00 }
