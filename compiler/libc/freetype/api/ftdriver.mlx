// freetype/ftdriver.h
// mlx-freetype: the values of the drivers' properties (FT_Property_Set),
// as FreeType names them.
const freetype = @import("./freetype.mlx")
const ftparams = @import("./ftparams.mlx")

pub const FT_HINTING_FREETYPE: c_int = 0
pub const FT_HINTING_ADOBE: c_int = 1
pub const FT_CFF_HINTING_FREETYPE: c_int = 0
pub const FT_CFF_HINTING_ADOBE: c_int = 1
pub const TT_INTERPRETER_VERSION_35: c_int = 35
pub const TT_INTERPRETER_VERSION_38: c_int = 38
pub const TT_INTERPRETER_VERSION_40: c_int = 40
pub const FT_AUTOHINTER_SCRIPT_NONE: c_int = 0
pub const FT_AUTOHINTER_SCRIPT_LATIN: c_int = 1
pub const FT_AUTOHINTER_SCRIPT_CJK: c_int = 2
pub const FT_AUTOHINTER_SCRIPT_INDIC: c_int = 3

pub const FT_Prop_GlyphToScriptMap_ = struct {
    face: freetype.FT_Face
    map: *fttypes.FT_UShort
}
pub const FT_Prop_GlyphToScriptMap = FT_Prop_GlyphToScriptMap_

pub const FT_Prop_IncreaseXHeight_ = struct {
    face: freetype.FT_Face
    limit: fttypes.FT_UInt
}
pub const FT_Prop_IncreaseXHeight = FT_Prop_IncreaseXHeight_
