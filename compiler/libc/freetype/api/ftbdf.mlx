// freetype/ftbdf.h
// mlx-freetype: the properties of BDF and PCF fonts. The library opens
// neither, so these functions fail with FT_Err_Invalid_Argument for its
// faces, as FreeType's do for fonts of other formats.
const c_keyword_names = true
const freetype = @import("./freetype.mlx")

pub const BDF_PropertyType_ = enum(c_int) {
    BDF_PROPERTY_TYPE_NONE = 0,
    BDF_PROPERTY_TYPE_ATOM = 1,
    BDF_PROPERTY_TYPE_INTEGER = 2,
    BDF_PROPERTY_TYPE_CARDINAL = 3,
}
pub const BDF_PropertyType = BDF_PropertyType_

pub const BDF_PropertyRec_ = struct {
    type_: BDF_PropertyType
    u: union {
        atom: *const c_char
        integer: integertypes.FT_Int32
        cardinal: integertypes.FT_UInt32
    }
}
pub const BDF_PropertyRec = BDF_PropertyRec_
pub const BDF_Property = *BDF_PropertyRec_

pub extern("c") fn FT_Get_BDF_Charset_ID(face: freetype.FT_Face, acharset_encoding: **const c_char, acharset_registry: **const c_char) -> fttypes.FT_Error
pub extern("c") fn FT_Get_BDF_Property(face: freetype.FT_Face, prop_name: *const c_char, aproperty: *BDF_PropertyRec) -> fttypes.FT_Error
