// freetype/ftgasp.h
// mlx-freetype: what a font's `gasp` table asks for at a size.
const freetype = @import("./freetype.mlx")

pub const FT_GASP_NO_TABLE: c_int = -1
pub const FT_GASP_DO_GRIDFIT: c_int = 0x01
pub const FT_GASP_DO_GRAY: c_int = 0x02
pub const FT_GASP_SYMMETRIC_GRIDFIT: c_int = 0x04
pub const FT_GASP_SYMMETRIC_SMOOTHING: c_int = 0x08

pub extern("c") fn FT_Get_Gasp(face: freetype.FT_Face, ppem: fttypes.FT_UInt) -> fttypes.FT_Int
