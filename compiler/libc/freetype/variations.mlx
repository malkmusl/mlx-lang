// FreeType's multiple masters API (ftmm.h) for variable fonts:
// std.truetype's variations; the face's records pushed after a change of
// coordinates (its flags, index and global metrics change with them).
// The functions of Type 1 multiple masters fail as FreeType's do for a
// face that has none.
const m = @import("std.truetype.memory")
const r = @import("std.truetype.records")
const variations = @import("std.truetype.variations")
const faces = @import("./faces.mlx")

fn changed(face: usize, err: i32) -> i32 {
    if face != 0 {
        faces.pushFace(face)
        faces.pushSizes(face)
    }
    return err
}

export fn FT_Get_Multi_Master(face: usize, amaster: usize) -> i32 {
    if amaster == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    return r.ERR_INVALID_ARGUMENT
}

export fn FT_Get_MM_Var(face: usize, amaster: usize) -> i32 { return variations.getMMVarRecord(faces.face(face), amaster) }

export fn FT_Done_MM_Var(library: usize, amaster: usize) -> i32 {
    if library == 0 { return r.ERR_INVALID_LIBRARY_HANDLE }
    m.release(m.getWord(library), amaster)
    return r.OK
}

export fn FT_Set_MM_Design_Coordinates(face: usize, num_coords: u32, coords: usize) -> i32 {
    if num_coords != 0 && coords == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    return r.ERR_INVALID_ARGUMENT
}

export fn FT_Set_MM_WeightVector(face: usize, len: u32, weightvector: usize) -> i32 {
    if len != 0 && weightvector == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    return r.ERR_INVALID_ARGUMENT
}

export fn FT_Get_MM_WeightVector(face: usize, len: usize, weightvector: usize) -> i32 {
    if len != 0 && weightvector == 0 { return r.ERR_INVALID_ARGUMENT }
    if face == 0 { return r.ERR_INVALID_FACE_HANDLE }
    return r.ERR_INVALID_ARGUMENT
}

export fn FT_Set_Var_Design_Coordinates(face: usize, num_coords: u32, coords: usize) -> i32 { return changed(face, variations.setDesignCoordinates(faces.face(face), num_coords, coords)) }

export fn FT_Get_Var_Design_Coordinates(face: usize, num_coords: u32, coords: usize) -> i32 { return variations.getDesignCoordinates(faces.face(face), num_coords, coords) }

export fn FT_Set_MM_Blend_Coordinates(face: usize, num_coords: u32, coords: usize) -> i32 { return changed(face, variations.setBlendCoordinates(faces.face(face), num_coords, coords)) }

export fn FT_Set_Var_Blend_Coordinates(face: usize, num_coords: u32, coords: usize) -> i32 { return changed(face, variations.setBlendCoordinates(faces.face(face), num_coords, coords)) }

export fn FT_Get_MM_Blend_Coordinates(face: usize, num_coords: u32, coords: usize) -> i32 { return variations.getBlendCoordinates(faces.face(face), num_coords, coords) }

export fn FT_Get_Var_Blend_Coordinates(face: usize, num_coords: u32, coords: usize) -> i32 { return variations.getBlendCoordinates(faces.face(face), num_coords, coords) }

export fn FT_Get_Var_Axis_Flags(master: usize, axis_index: u32, flags: usize) -> i32 { return variations.axisFlags(master, axis_index, flags) }

export fn FT_Set_Named_Instance(face: usize, instance_index: u32) -> i32 { return changed(face, variations.setNamedInstance(faces.face(face), @intCast(i64, instance_index))) }

export fn FT_Get_Default_Named_Instance(face: usize, instance_index: usize) -> i32 { return variations.defaultNamedInstance(faces.face(face), instance_index) }
