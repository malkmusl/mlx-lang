// The names of glibc's own that libraries built for it call besides the C
// library's: libstdc++'s "gnu" locale model (__newlocale and the `_l`
// functions, which read the locale's ctype tables from glibc's struct),
// the checked variants _FORTIFY_SOURCE compiles calls into (`__*_chk`),
// and what LLVM and Mesa (lavapipe, the Vulkan driver WebGL runs on) name
// from <termios.h>, <mntent.h>, <sys/shm.h> and the like. There is one
// locale, C; a function of glibc's not here is bound lazily in a library
// dlopen'ed with RTLD_LAZY (loader.mlx: a stub that says it was called).
const sys = @import("./sys.mlx")
const errno = @import("./errno.mlx")
const heap = @import("./heap.mlx")
const string = @import("./string.mlx")
const ctype = @import("./ctype.mlx")
const stdlib = @import("./stdlib.mlx")
const unistd = @import("./unistd.mlx")
const stdio = @import("./stdio.mlx")
const time = @import("./time.mlx")
const pthread = @import("./pthread.mlx")
const misc = @import("./misc.mlx")

fn u(value: i32) -> usize { return @bitCast(usize, @intCast(i64, value)) }

// --- the C locale as glibc's struct __locale_struct -----------------------------------
// __locales[13] (8 bytes each), __ctype_b, __ctype_tolower,
// __ctype_toupper, __names[13]: libstdc++'s ctype<char> reads the three
// tables from it.
var cLocale: [232]u8 = undefined
var cLocaleReady: u32 = 0
var cLocaleLock: u32 = 0

fn theCLocale() -> usize {
    if @atomicLoad(u32, &cLocaleReady, acquire) == 1 { return @intFromPtr(&cLocale) }
    sys.lock(&cLocaleLock)
    if cLocaleReady == 0 {
        const record = @intFromPtr(&cLocale)
        sys.fill(record, 0, 232)
        sys.putPointer(record + 104, sys.getPointer(ctype.__ctype_b_loc()))
        sys.putPointer(record + 112, sys.getPointer(ctype.__ctype_tolower_loc()))
        sys.putPointer(record + 120, sys.getPointer(ctype.__ctype_toupper_loc()))
        var index: usize = 0
        while index < 13 {
            sys.putPointer(record + 128 + index * 8, sys.literal("C"))
            index += 1
        }
        @atomicStore(u32, &cLocaleReady, 1, release)
    }
    sys.unlock(&cLocaleLock)
    return @intFromPtr(&cLocale)
}

// Whether `name` is a name of the C locale ("", "C", "POSIX", "C.UTF-8").
fn namesC(name: usize) -> bool {
    if name == 0 || sys.get8(name) == 0 { return true }
    return string.strcmp(name, sys.literal("C")) == 0 || string.strcmp(name, sys.literal("POSIX")) == 0 || string.strcmp(name, sys.literal("C.UTF-8")) == 0 || string.strcmp(name, sys.literal("C.utf8")) == 0
}

pub export fn __newlocale(mask: i32, name: usize, base: usize) -> usize {
    if !namesC(name) {
        errno.set(sys.ENOENT)
        return 0
    }
    return theCLocale()
}

pub export fn __duplocale(locale: usize) -> usize { return if locale == 0 { 0 } else { theCLocale() } }
pub export fn __freelocale(locale: usize) -> void {}
pub export fn __uselocale(locale: usize) -> usize { return theCLocale() }
pub export fn __nl_langinfo_l(item: i32, locale: usize) -> usize { return misc.nl_langinfo(item) }
pub export fn __strcoll_l(first: usize, second: usize, locale: usize) -> i32 { return string.strcmp(first, second) }
pub export fn __strxfrm_l(target: usize, source: usize, count: usize, locale: usize) -> usize { return string.strxfrm(target, source, count) }
pub export fn __strftime_l(buffer: usize, size: usize, pattern: usize, tm: usize, locale: usize) -> usize { return time.strftime(buffer, size, pattern, tm) }
pub export fn __strtod_l(text: usize, end: usize, locale: usize) -> f64 { return stdlib.strtod(text, end) }
pub export fn strtod_l(text: usize, end: usize, locale: usize) -> f64 { return stdlib.strtod(text, end) }
pub export fn __strtof_l(text: usize, end: usize, locale: usize) -> f32 { return @floatCast(f32, stdlib.strtod(text, end)) }
pub export fn strtof_l(text: usize, end: usize, locale: usize) -> f32 { return @floatCast(f32, stdlib.strtod(text, end)) }
pub export fn __towlower_l(code: u32, locale: usize) -> u32 { return misc.towlower(code) }
pub export fn __towupper_l(code: u32, locale: usize) -> u32 { return misc.towupper(code) }
pub export fn __wcscoll_l(first: usize, second: usize, locale: usize) -> i32 { return misc.wcscmp(first, second) }
pub export fn wcscoll(first: usize, second: usize) -> i32 { return misc.wcscmp(first, second) }

// wcsxfrm: in the C locale the codes as they are.
pub export fn wcsxfrm(target: usize, source: usize, count: usize) -> usize {
    const length = misc.wcslen(source)
    if length < count { sys.copy(target, source, (length + 1) * 4) }
    return length
}
pub export fn __wcsxfrm_l(target: usize, source: usize, count: usize, locale: usize) -> usize { return wcsxfrm(target, source, count) }

// wcsftime: strftime's text, widened (the C locale's is ASCII).
pub export fn wcsftime(buffer: usize, size: usize, pattern: usize, tm: usize) -> usize {
    const narrowPattern = heap.allocate(misc.wcslen(pattern) * 4 + 1, 16)
    if narrowPattern == 0 { return 0 }
    _ = misc.wcstombs(narrowPattern, pattern, misc.wcslen(pattern) * 4 + 1)
    const narrow = heap.allocate(size * 4 + 1, 16)
    if narrow == 0 {
        heap.release(narrowPattern)
        return 0
    }
    const length = time.strftime(narrow, size * 4 + 1, narrowPattern, tm)
    var count: usize = 0
    if length > 0 { count = misc.mbstowcs(buffer, narrow, size) }
    heap.release(narrow)
    heap.release(narrowPattern)
    if count >= size { return 0 }
    return count
}
pub export fn __wcsftime_l(buffer: usize, size: usize, pattern: usize, tm: usize, locale: usize) -> usize { return wcsftime(buffer, size, pattern, tm) }

// wctype's classes, by number.
const CLASSES = "alnum\x00alpha\x00blank\x00cntrl\x00digit\x00graph\x00lower\x00print\x00punct\x00space\x00upper\x00xdigit\x00"

pub export fn wctype(name: usize) -> usize {
    if name == 0 { return 0 }
    const wanted = sys.slice(name)
    var start: usize = 0
    var at: usize = 0
    var number: usize = 1
    while at < CLASSES.length {
        if CLASSES[at] == 0 {
            if sys.same(CLASSES[start..at], wanted) { return number }
            number += 1
            start = at + 1
        }
        at += 1
    }
    return 0
}
pub export fn __wctype_l(name: usize, locale: usize) -> usize { return wctype(name) }

pub export fn iswgraph(code: u32) -> i32 { return if misc.iswprint(code) != 0 && code != 32 { 1 } else { 0 } }

pub export fn iswctype(code: u32, class: usize) -> i32 {
    return match class {
        1 => misc.iswalnum(code),
        2 => misc.iswalpha(code),
        3 => misc.iswblank(code),
        4 => misc.iswcntrl(code),
        5 => misc.iswdigit(code),
        6 => iswgraph(code),
        7 => misc.iswlower(code),
        8 => misc.iswprint(code),
        9 => misc.iswpunct(code),
        10 => misc.iswspace(code),
        11 => misc.iswupper(code),
        12 => misc.iswxdigit(code),
        else => 0,
    }
}
pub export fn __iswctype_l(code: u32, class: usize, locale: usize) -> i32 { return iswctype(code, class) }

// --- wide characters --------------------------------------------------------------------

pub export fn wcscspn(codes: usize, rejected: usize) -> usize {
    var count: usize = 0
    while true {
        const code = sys.get32(codes + count * 4)
        if code == 0 { return count }
        var other: usize = 0
        while sys.get32(rejected + other * 4) != 0 {
            if sys.get32(rejected + other * 4) == code { return count }
            other += 1
        }
        count += 1
    }
    return count
}

// wcstol in base 0 to 36, as strtol reads its digits.
pub export fn wcstol(codes: usize, end: usize, base: i32) -> i64 {
    var index: usize = 0
    while misc.iswspace(sys.get32(codes + index * 4)) != 0 { index += 1 }
    var negative = false
    const sign = sys.get32(codes + index * 4)
    if sign == 45 || sign == 43 {
        negative = sign == 45
        index += 1
    }
    var radix = base
    if (radix == 0 || radix == 16) && sys.get32(codes + index * 4) == 48 && (sys.get32(codes + index * 4 + 4) | 32) == 120 {
        radix = 16
        index += 2
    } else if radix == 0 && sys.get32(codes + index * 4) == 48 {
        radix = 8
    } else if radix == 0 {
        radix = 10
    }
    var value: u64 = 0
    var digits: usize = 0
    while true {
        const code = sys.get32(codes + index * 4)
        var digit: i32 = 99
        if code >= 48 && code <= 57 { digit = @intCast(i32, code) - 48 }
        if (code | 32) >= 97 && (code | 32) <= 122 { digit = @intCast(i32, code | 32) - 87 }
        if digit >= radix { break }
        value = value *% @intCast(u64, radix) +% @intCast(u64, digit)
        digits += 1
        index += 1
    }
    if end != 0 { sys.putPointer(end, if digits > 0 { codes + index * 4 } else { codes }) }
    const result = @bitCast(i64, value)
    return if negative { 0 - result } else { result }
}
pub export fn __isoc23_wcstol(codes: usize, end: usize, base: i32) -> i64 { return wcstol(codes, end, base) }

// mbsnrtowcs and wcsnrtombs: of at most `count` source bytes (codes).
pub export fn mbsnrtowcs(target: usize, source: usize, count: usize, limit: usize, state: usize) -> usize {
    const text = sys.getPointer(source)
    var length: usize = 0
    while length < count && sys.get8(text + length) != 0 { length += 1 }
    const copy = heap.allocate(length + 1, 16)
    if copy == 0 { return 18446744073709551615 }
    sys.copy(copy, text, length)
    sys.put8(copy + length, 0)
    var held = copy
    const result = misc.mbsrtowcs(target, @intFromPtr(&held), limit, state)
    if target != 0 && result != 18446744073709551615 { sys.putPointer(source, if held == 0 { if length < count { 0 } else { text + length } } else { text + (held - copy) }) }
    heap.release(copy)
    return result
}

pub export fn wcsnrtombs(target: usize, source: usize, count: usize, limit: usize, state: usize) -> usize {
    const codes = sys.getPointer(source)
    var length: usize = 0
    while length < count && sys.get32(codes + length * 4) != 0 { length += 1 }
    const copy = heap.allocate((length + 1) * 4, 16)
    if copy == 0 { return 18446744073709551615 }
    sys.copy(copy, codes, length * 4)
    sys.put32(copy + length * 4, 0)
    const result = misc.wcstombs(target, copy, limit)
    if target != 0 && result != 18446744073709551615 && result < limit { sys.putPointer(source, if length < count { 0 } else { codes + length * 4 }) }
    heap.release(copy)
    return result
}

// The wide stream functions: UTF-8 bytes on the byte stream.
pub export fn fgetwc(handle: usize) -> u32 {
    const first = stdio.fgetc(handle)
    if first < 0 { return 4294967295 }
    const lead = @intCast(u32, first)
    if lead < 128 { return lead }
    var more: usize = 0
    var code: u32 = 0
    if lead & 224 == 192 {
        more = 1
        code = lead & 31
    } else if lead & 240 == 224 {
        more = 2
        code = lead & 15
    } else if lead & 248 == 240 {
        more = 3
        code = lead & 7
    } else {
        errno.set(sys.EILSEQ)
        return 4294967295
    }
    while more > 0 {
        const next = stdio.fgetc(handle)
        if next < 0 || @intCast(u32, next) & 192 != 128 {
            errno.set(sys.EILSEQ)
            return 4294967295
        }
        code = (code << 6) | (@intCast(u32, next) & 63)
        more -= 1
    }
    return code
}
pub export fn getwc(handle: usize) -> u32 { return fgetwc(handle) }

pub export fn fputwc(code: u32, handle: usize) -> u32 {
    var bytes: [4]u8 = undefined
    const length = misc.wcrtomb(@intFromPtr(&bytes), code, 0)
    if length == 18446744073709551615 { return 4294967295 }
    var index: usize = 0
    while index < length {
        if stdio.fputc(@intCast(i32, bytes[index]), handle) < 0 { return 4294967295 }
        index += 1
    }
    return code
}
pub export fn putwc(code: u32, handle: usize) -> u32 { return fputwc(code, handle) }

// (Only a code below 128 goes back, as one byte.)
pub export fn ungetwc(code: u32, handle: usize) -> u32 {
    if code >= 128 { return 4294967295 }
    if stdio.ungetc(@intCast(i32, code), handle) < 0 { return 4294967295 }
    return code
}

// --- _FORTIFY_SOURCE's checked calls ---------------------------------------------------------

fn overflow() -> void {
    _ = sys.syscall3(sys.SYS_write, 2, sys.literal("*** buffer overflow detected ***: terminated\n"), 45)
    stdlib.abort()
}

pub export fn __fdelt_chk(descriptor: i64) -> i64 {
    if descriptor < 0 || descriptor >= 1024 { overflow() }
    return descriptor / 64
}

pub export fn __recv_chk(descriptor: i32, buffer: usize, length: usize, size: usize, flags: i32) -> isize {
    if length > size { overflow() }
    return unistd.recv(descriptor, buffer, length, flags)
}

pub export fn __strlcpy_chk(target: usize, source: usize, count: usize, size: usize) -> usize {
    if count > size { overflow() }
    return string.strlcpy(target, source, count)
}

pub export fn __wcsncpy_chk(target: usize, source: usize, count: usize, size: usize) -> usize {
    if count > size { overflow() }
    return misc.wcsncpy(target, source, count)
}

pub export fn __wmemcpy_chk(target: usize, source: usize, count: usize, size: usize) -> usize {
    if count > size { overflow() }
    return misc.wmemcpy(target, source, count)
}

pub export fn __wmemset_chk(target: usize, code: u32, count: usize, size: usize) -> usize {
    if count > size { overflow() }
    return misc.wmemset(target, code, count)
}

pub export fn __mbstowcs_chk(target: usize, text: usize, limit: usize, size: usize) -> usize {
    if target != 0 && limit > size { overflow() }
    return misc.mbstowcs(target, text, limit)
}

pub export fn __mbsrtowcs_chk(target: usize, source: usize, limit: usize, state: usize, size: usize) -> usize {
    if target != 0 && limit > size { overflow() }
    return misc.mbsrtowcs(target, source, limit, state)
}

pub export fn __mbsnrtowcs_chk(target: usize, source: usize, count: usize, limit: usize, state: usize, size: usize) -> usize {
    if target != 0 && limit > size { overflow() }
    return mbsnrtowcs(target, source, count, limit, state)
}

// --- threads and processes ------------------------------------------------------------------

// C++'s thread_local destructors (__cxa_thread_atexit_impl): a list per
// thread, run by a key's destructor when the thread ends, the last
// registered first; the main thread's are left at exit, as the objects
// are.
var exitKey: u32 = 0
var exitKeyMade: u32 = 0
var exitKeyLock: u32 = 0

fn runThreadDestructors(list: usize) -> void {
    var node = list
    while node != 0 {
        const next = sys.getPointer(node + 16)
        sys.call1(sys.getPointer(node), sys.getPointer(node + 8))
        heap.release(node)
        node = next
    }
}

pub export fn __cxa_thread_atexit_impl(destructor: usize, object: usize, dso: usize) -> i32 {
    if @atomicLoad(u32, &exitKeyMade, acquire) == 0 {
        sys.lock(&exitKeyLock)
        if exitKeyMade == 0 {
            if pthread.pthread_key_create(@intFromPtr(&exitKey), @intFromPtr(runThreadDestructors)) != 0 {
                sys.unlock(&exitKeyLock)
                return -1
            }
            @atomicStore(u32, &exitKeyMade, 1, release)
        }
        sys.unlock(&exitKeyLock)
    }
    const node = heap.allocate(24, 16)
    if node == 0 { return -1 }
    sys.putPointer(node, destructor)
    sys.putPointer(node + 8, object)
    sys.putPointer(node + 16, pthread.pthread_getspecific(exitKey))
    _ = pthread.pthread_setspecific(exitKey, node)
    return 0
}

pub export fn __register_atfork(prepare: usize, parent: usize, child: usize, dso: usize) -> i32 { return pthread.pthread_atfork(prepare, parent, child) }

var hostError: i32 = 0
pub export fn __h_errno_location() -> usize { return @intFromPtr(&hostError) }

pub export fn __sched_cpucount(size: usize, set: usize) -> i32 {
    var count: i32 = 0
    var index: usize = 0
    while index < size {
        var byte = sys.get8(set + index)
        while byte != 0 {
            count += @intCast(i32, byte & 1)
            byte >>= 1
        }
        index += 1
    }
    return count
}

pub export fn get_nprocs() -> i32 {
    var set: [128]u8 = undefined
    const got = sys.syscall3(sys.SYS_sched_getaffinity, 0, 128, @intFromPtr(&set))
    if sys.failed(got) { return 1 }
    const count = __sched_cpucount(@bitCast(usize, got), @intFromPtr(&set))
    return if count > 0 { count } else { 1 }
}
pub export fn get_nprocs_conf() -> i32 { return get_nprocs() }

// (libgcc's unwinder asks first, then walks dl_iterate_phdr.)
pub export fn _dl_find_object(address: usize, result: usize) -> i32 { return -1 }

pub export fn backtrace(buffer: usize, size: i32) -> i32 { return 0 }

pub export fn arc4random_buf(buffer: usize, length: usize) -> void {
    var done: usize = 0
    while done < length {
        const got = sys.syscall3(sys.SYS_getrandom, buffer + done, length - done, 0)
        if sys.failed(got) { continue }
        done += @bitCast(usize, got)
    }
}

pub export fn arc4random() -> u32 {
    var value: u32 = 0
    arc4random_buf(@intFromPtr(&value), 4)
    return value
}

pub export fn arc4random_uniform(bound: u32) -> u32 {
    if bound < 2 { return 0 }
    const floor = (0 -% bound) % bound
    while true {
        const value = arc4random()
        if value >= floor { return value % bound }
    }
    return 0
}

// --- files -------------------------------------------------------------------------------------

pub export fn posix_fallocate64(descriptor: i32, offset: i64, length: i64) -> i32 {
    const result = sys.syscall4(sys.SYS_fallocate, u(descriptor), 0, @bitCast(usize, offset), @bitCast(usize, length))
    return if sys.failed(result) { @intCast(i32, 0 - result) } else { 0 }
}

// utime: utimensat with whole seconds (NULL: now).
pub export fn utime(path: usize, times: usize) -> i32 {
    var spec: [4]u64 = undefined
    var pointer: usize = 0
    if times != 0 {
        spec[0] = sys.get64(times)
        spec[1] = 0
        spec[2] = sys.get64(times + 8)
        spec[3] = 0
        pointer = @intFromPtr(&spec)
    }
    return errno.checkInt(sys.syscall4(sys.SYS_utimensat, sys.AT_FDCWD, path, pointer, 0))
}

// --- System V shared memory, file system ids ------------------------------------------------

pub export fn shmget(key: i32, size: usize, flags: i32) -> i32 { return errno.checkInt(sys.syscall3(29, u(key), size, u(flags))) }
pub export fn shmat(id: i32, address: usize, flags: i32) -> usize {
    const result = sys.syscall3(30, u(id), address, u(flags))
    if sys.failed(result) {
        errno.set(@intCast(i32, 0 - result))
        return 18446744073709551615
    }
    return @bitCast(usize, result)
}
pub export fn shmdt(address: usize) -> i32 { return errno.checkInt(sys.syscall1(67, address)) }
pub export fn shmctl(id: i32, command: i32, buffer: usize) -> i32 { return errno.checkInt(sys.syscall3(31, u(id), u(command), buffer)) }
pub export fn setfsuid(id: u32) -> i32 { return @intCast(i32, sys.syscall1(122, @intCast(usize, id))) }
pub export fn setfsgid(id: u32) -> i32 { return @intCast(i32, sys.syscall1(123, @intCast(usize, id))) }

// --- terminals ----------------------------------------------------------------------------------
// struct termios: c_iflag, c_oflag, c_cflag, c_lflag (4 bytes each),
// c_line, c_cc[32], then c_ispeed and c_ospeed at 52 and 56; the kernel's
// is the same up to c_cc[19].

const TCGETS: u64 = 21505
const TCSETS: u64 = 21506
const TCFLSH: u64 = 21515
const CBAUD: u32 = 4111

pub export fn tcgetattr(descriptor: i32, termios: usize) -> i32 {
    const result = unistd.ioctl(descriptor, TCGETS, termios)
    if result == 0 {
        const speed = sys.get32(termios + 8) & CBAUD
        sys.put32(termios + 52, speed)
        sys.put32(termios + 56, speed)
    }
    return result
}

pub export fn tcsetattr(descriptor: i32, action: i32, termios: usize) -> i32 {
    if action < 0 || action > 2 {
        errno.set(sys.EINVAL)
        return -1
    }
    return unistd.ioctl(descriptor, TCSETS + @intCast(u64, action), termios)
}

pub export fn tcflush(descriptor: i32, queue: i32) -> i32 { return unistd.ioctl(descriptor, TCFLSH, u(queue)) }
pub export fn cfgetospeed(termios: usize) -> u32 { return sys.get32(termios + 8) & CBAUD }
pub export fn cfgetispeed(termios: usize) -> u32 { return cfgetospeed(termios) }

pub export fn cfsetospeed(termios: usize, speed: u32) -> i32 {
    if speed & ~CBAUD != 0 {
        errno.set(sys.EINVAL)
        return -1
    }
    sys.put32(termios + 8, (sys.get32(termios + 8) & ~CBAUD) | speed)
    sys.put32(termios + 56, speed)
    return 0
}

pub export fn cfsetispeed(termios: usize, speed: u32) -> i32 {
    if speed != 0 { return cfsetospeed(termios, speed) }
    return 0
}

// --- <mntent.h> ------------------------------------------------------------------------------
// struct mntent: mnt_fsname, mnt_dir, mnt_type, mnt_opts (pointers), then
// mnt_freq and mnt_passno.

pub export fn setmntent(path: usize, mode: usize) -> usize { return stdio.fopen(path, mode) }
pub export fn endmntent(handle: usize) -> i32 {
    if handle != 0 { _ = stdio.fclose(handle) }
    return 1
}

// The fields of the next line (comments and blank lines passed over),
// split in place in `buffer`.
pub export fn getmntent_r(handle: usize, entry: usize, buffer: usize, size: i32) -> usize {
    while true {
        if stdio.fgets(buffer, size, handle) == 0 { return 0 }
        var fields: [6]usize = undefined
        var count: usize = 0
        var at = buffer
        while count < 6 {
            while sys.get8(at) == 32 || sys.get8(at) == 9 { at += 1 }
            const c = sys.get8(at)
            if c == 0 || c == 10 || c == 35 { break }
            fields[count] = at
            count += 1
            while sys.get8(at) != 0 && sys.get8(at) != 32 && sys.get8(at) != 9 && sys.get8(at) != 10 { at += 1 }
            if sys.get8(at) == 0 { break }
            sys.put8(at, 0)
            at += 1
        }
        if count < 4 { continue }
        sys.putPointer(entry, fields[0])
        sys.putPointer(entry + 8, fields[1])
        sys.putPointer(entry + 16, fields[2])
        sys.putPointer(entry + 24, fields[3])
        sys.put32(entry + 32, if count > 4 { @intCast(u32, stdlib.atoi(fields[4])) } else { 0 })
        sys.put32(entry + 36, if count > 5 { @intCast(u32, stdlib.atoi(fields[5])) } else { 0 })
        return entry
    }
    return 0
}

var mountEntry: [40]u8 = undefined
var mountLine: [4096]u8 = undefined

pub export fn getmntent(handle: usize) -> usize { return getmntent_r(handle, @intFromPtr(&mountEntry), @intFromPtr(&mountLine), 4096) }

// The option `name` in the entry's comma-separated options (alone or as
// `name=value`): where it starts, or 0.
pub export fn hasmntopt(entry: usize, name: usize) -> usize {
    const options = sys.getPointer(entry + 24)
    const length = string.strlen(name)
    var at = options
    while sys.get8(at) != 0 {
        if string.strncmp(at, name, length) == 0 {
            const after = sys.get8(at + length)
            if after == 0 || after == 44 || after == 61 { return at }
        }
        while sys.get8(at) != 0 && sys.get8(at) != 44 { at += 1 }
        if sys.get8(at) == 44 { at += 1 }
    }
    return 0
}

// --- the password database's iteration: none ----------------------------------------------------

pub export fn setpwent() -> void {}
pub export fn endpwent() -> void {}
pub export fn getpwent() -> usize { return 0 }
