// soup-session-feature.h: SoupSessionFeature, what a session is given to
// act on its messages. Its vtable is libsoup's private one with the
// content processor's folded in (libsoup keeps that a second interface):
//
//   16 attach(feature, session)        24 detach(feature, session)
//   32 request_queued(feature, msg)    40 request_unqueued(feature, msg)
//   48 add_feature(feature, type)      56 remove_feature(feature, type)
//   64 has_feature(feature, type)
//   72 wrap_input(feature, stream, msg): a stream over a response's body
//      (0: none), for the features that process it
//   80 the processing stage (SoupProcessingStage): the order wrappers go on
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const message = @import("./message.mlx")

pub const IFACE_SIZE: usize = 88
pub const ATTACH: usize = 16
pub const DETACH: usize = 24
pub const REQUEST_QUEUED: usize = 32
pub const REQUEST_UNQUEUED: usize = 40
pub const ADD_FEATURE: usize = 48
pub const REMOVE_FEATURE: usize = 56
pub const HAS_FEATURE: usize = 64
pub const WRAP_INPUT: usize = 72
pub const STAGE: usize = 80

// SoupProcessingStage.
pub const STAGE_CONTENT_ENCODING: usize = 4
pub const STAGE_BODY_DATA: usize = 5

pub const PairFn = fn(usize, usize) -> void
pub const TypeFn = fn(usize, usize) -> i32
pub const WrapFn = fn(usize, usize, usize) -> usize

var featureType: usize = 0

pub fn featureTypeGet() -> usize {
    if c.onceEnter(&featureType) {
        c.onceLeave(&featureType, c.defineInterface("SoupSessionFeature", IFACE_SIZE, 0))
    }
    return featureType
}

export fn soup_session_feature_get_type() -> usize { return featureTypeGet() }

pub fn isFeature(object: usize) -> bool { return object != 0 && g.g_type_check_instance_is_a(object, featureTypeGet()) != 0 }

pub fn vtable(feature: usize) -> usize { return g.g_type_interface_peek(m.getWord(feature), featureTypeGet()) }

fn slot(feature: usize, offset: usize) -> usize {
    const v = vtable(feature)
    if v == 0 { return 0 }
    return m.getWord(v + offset)
}

pub fn attach(feature: usize, session: usize) -> void {
    const f = slot(feature, ATTACH)
    if f == 0 { return }
    const call: PairFn = unsafe { @ptrFromInt(PairFn, f) }
    call(feature, session)
}

pub fn detach(feature: usize, session: usize) -> void {
    const f = slot(feature, DETACH)
    if f == 0 { return }
    const call: PairFn = unsafe { @ptrFromInt(PairFn, f) }
    call(feature, session)
}

pub fn requestQueued(feature: usize, msg: usize) -> void {
    if message.disablesFeature(msg, feature) { return }
    const f = slot(feature, REQUEST_QUEUED)
    if f == 0 { return }
    const call: PairFn = unsafe { @ptrFromInt(PairFn, f) }
    call(feature, msg)
}

pub fn requestUnqueued(feature: usize, msg: usize) -> void {
    if message.disablesFeature(msg, feature) { return }
    const f = slot(feature, REQUEST_UNQUEUED)
    if f == 0 { return }
    const call: PairFn = unsafe { @ptrFromInt(PairFn, f) }
    call(feature, msg)
}

fn typeCall(feature: usize, offset: usize, t: usize) -> bool {
    const f = slot(feature, offset)
    if f == 0 { return false }
    const call: TypeFn = unsafe { @ptrFromInt(TypeFn, f) }
    return call(feature, t) != 0
}

pub fn addFeature(feature: usize, t: usize) -> bool { return typeCall(feature, ADD_FEATURE, t) }
pub fn removeFeature(feature: usize, t: usize) -> bool { return typeCall(feature, REMOVE_FEATURE, t) }
pub fn hasFeature(feature: usize, t: usize) -> bool { return typeCall(feature, HAS_FEATURE, t) }

pub fn isProcessor(feature: usize) -> bool { return slot(feature, WRAP_INPUT) != 0 }
pub fn stage(feature: usize) -> usize { return slot(feature, STAGE) }

pub fn wrapInput(feature: usize, stream: usize, msg: usize) -> usize {
    const f = slot(feature, WRAP_INPUT)
    if f == 0 { return 0 }
    const call: WrapFn = unsafe { @ptrFromInt(WrapFn, f) }
    return call(feature, stream, msg)
}

// Makes `t` a feature with the vtable `init` fills.
pub fn implementFeature(t: usize, init: usize) -> void { c.implement(t, featureTypeGet(), init) }
