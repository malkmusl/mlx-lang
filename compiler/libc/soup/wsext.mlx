// soup-websocket-extension.h, soup-websocket-extension-deflate.h,
// soup-websocket-extension-manager.h: WebSocket extensions as libsoup
// has them.
//
// SoupWebsocketExtension is an abstract class (SoupWebsocketExtensionClass:
// the extension's name (136), configure (144), get_request_params (152),
// get_response_params (160), process_outgoing_message (168),
// process_incoming_message (176)). SoupWebsocketExtensionDeflate is
// "permessage-deflate" (RFC 7692) on std.flate: each message compressed
// with a sync flush and its last four bytes (00 00 ff ff) taken off, and
// put back before a received message is inflated. Its private data is a
// pointer to a record: the parameters given (0, ParamFlags), the server's
// and the client's window bits (4, 8), whether it is enabled (12), the
// deflater (16), whether it starts over for each message (24), the
// inflater (32), whether a fragmented message is being inflated (40).
//
// SoupWebsocketExtensionManager is the session feature that keeps the
// extension classes a session offers (permessage-deflate from the start):
// its private data, a GPtrArray of class references.
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const feature = @import("./feature.mlx")
const pmd = @import("std.http.websocket.deflate")

extern("c") fn g_ptr_array_new_with_free_func(free: usize) -> usize
extern("c") fn g_ptr_array_add(array: usize, data: usize) -> void
extern("c") fn g_ptr_array_free(array: usize, segment: i32) -> usize
extern("c") fn g_ptr_array_remove_index(array: usize, index: u32) -> usize
extern("c") fn g_type_class_ref(t: usize) -> usize
extern("c") fn g_type_class_unref(class: usize) -> void
extern("c") fn g_type_class_peek(t: usize) -> usize
extern("c") fn g_type_is_a(t: usize, parent: usize) -> i32
extern("c") fn g_bytes_new(data: usize, size: usize) -> usize
extern("c") fn g_bytes_new_take(data: usize, size: usize) -> usize
extern("c") fn g_bytes_unref(bytes: usize) -> void
extern("c") fn g_bytes_get_data(bytes: usize, size: usize) -> usize
extern("c") fn g_strdup(text: usize) -> usize
extern("c") fn soup_websocket_error_quark() -> u32

// SoupWebsocketExtensionClass.
pub const C_NAME: usize = 136
pub const C_CONFIGURE: usize = 144
pub const C_REQUEST_PARAMS: usize = 152
pub const C_RESPONSE_PARAMS: usize = 160
pub const C_OUTGOING: usize = 168
pub const C_INCOMING: usize = 176
const CLASS_SIZE: usize = 232

// SoupWebsocketConnectionType.
pub const CONNECTION_CLIENT: i32 = 1
pub const CONNECTION_SERVER: i32 = 2

// SoupWebsocketError, and the close code given a protocol error.
const ERROR_BAD_HANDSHAKE: i32 = 2
const CLOSE_PROTOCOL_ERROR: i32 = 1002

pub const ConfigureFn = fn(usize, i32, usize, usize) -> i32
pub const ParamsFn = fn(usize) -> usize
pub const ProcessFn = fn(usize, usize, usize, usize) -> usize

// ---------------------------------------------------------------------------
// SoupWebsocketExtension

var extensionType: usize = 0

pub fn extensionTypeGet() -> usize {
    if c.onceEnter(&extensionType) {
        c.onceLeave(&extensionType, c.defineType(c.T_OBJECT, "SoupWebsocketExtension", CLASS_SIZE, 0, 24, 0, c.ABSTRACT))
    }
    return extensionType
}

export fn soup_websocket_extension_get_type() -> usize { return extensionTypeGet() }

fn classOf(extension: usize) -> usize { return m.getWord(extension) }

pub fn nameOf(class: usize) -> []const u8 { return m.cSlice(m.getWord(class + C_NAME)) }

export fn soup_websocket_extension_configure(extension: usize, connectionType: i32, params: usize, err: usize) -> i32 {
    const f = m.getWord(classOf(extension) + C_CONFIGURE)
    if f == 0 { return 1 }
    const call: ConfigureFn = unsafe { @ptrFromInt(ConfigureFn, f) }
    return call(extension, connectionType, params, err)
}

fn params(extension: usize, slot: usize) -> usize {
    const f = m.getWord(classOf(extension) + slot)
    if f == 0 { return 0 }
    const call: ParamsFn = unsafe { @ptrFromInt(ParamsFn, f) }
    return call(extension)
}

export fn soup_websocket_extension_get_request_params(extension: usize) -> usize { return params(extension, C_REQUEST_PARAMS) }
export fn soup_websocket_extension_get_response_params(extension: usize) -> usize { return params(extension, C_RESPONSE_PARAMS) }

fn process(extension: usize, slot: usize, header: usize, payload: usize, err: usize) -> usize {
    const f = m.getWord(classOf(extension) + slot)
    if f == 0 { return payload }
    const call: ProcessFn = unsafe { @ptrFromInt(ProcessFn, f) }
    return call(extension, header, payload, err)
}

export fn soup_websocket_extension_process_outgoing_message(extension: usize, header: usize, payload: usize, err: usize) -> usize { return process(extension, C_OUTGOING, header, payload, err) }
export fn soup_websocket_extension_process_incoming_message(extension: usize, header: usize, payload: usize, err: usize) -> usize { return process(extension, C_INCOMING, header, payload, err) }

// ---------------------------------------------------------------------------
// SoupWebsocketExtensionDeflate: the GObject around a
// std.http.websocket.deflate Extension (its private data a pointer to one
// in C memory).

var deflateType: usize = 0
var deflatePrivate: i32 = 0

export fn soup_websocket_extension_deflate_get_type() -> usize {
    if c.onceEnter(&deflateType) {
        const t = c.defineType(extensionTypeGet(), "SoupWebsocketExtensionDeflate", CLASS_SIZE, @intFromPtr(__mlx_soup_ws_deflate_class_init), 24, @intFromPtr(__mlx_soup_ws_deflate_init), c.FINAL)
        deflatePrivate = c.addPrivate(t, 8)
        c.onceLeave(&deflateType, t)
    }
    return deflateType
}

fn stdDeflate(extension: usize) -> *pmd.Extension { return unsafe { @ptrFromInt(*pmd.Extension, m.getWord(c.privateAt(extension, deflatePrivate))) } }

export fn __mlx_soup_ws_deflate_init(extension: usize, class: usize) -> void {
    const std = m.alloc(@sizeOf(pmd.Extension))
    m.putWord(c.privateAt(extension, deflatePrivate), std)
    pmd.init(stdDeflate(extension), m.stdAllocator())
}

export fn __mlx_soup_ws_deflate_finalize(extension: usize) -> void {
    pmd.deinit(stdDeflate(extension))
    m.release(m.getWord(c.privateAt(extension, deflatePrivate)))
    c.chainUp(g.g_type_class_ref(soup_websocket_extension_deflate_get_type()), 48, extension)
}

fn invalidParam(err: usize, name: []const u8, value: bool) -> i32 {
    var t = m.text()
    m.pushText(&t, if value { "Invalid value of parameter '" } else { "Invalid parameter '" })
    m.pushText(&t, name)
    m.pushText(&t, "' in permessage-deflate extension header")
    const text = m.finish(&t)
    c.setError(err, soup_websocket_error_quark(), ERROR_BAD_HANDSHAKE, m.cSlice(text))
    m.release(text)
    return 0
}

// The parameters, as the caller parsed them into a table (a bare name's
// value is NULL), given to std.http.websocket.deflate as text again.
fn paramsText(table: usize) -> usize {
    var t = m.text()
    const iter = m.alloc(48)
    const cells = m.alloc(16)
    g.g_hash_table_iter_init(iter, table)
    while g.g_hash_table_iter_next(iter, cells, cells + 8) != 0 {
        if t.length > 0 { m.pushText(&t, "; ") }
        m.pushC(&t, m.getWord(cells))
        if m.getWord(cells + 8) != 0 {
            m.pushByte(&t, 61)
            m.pushC(&t, m.getWord(cells + 8))
        }
    }
    m.release(cells)
    m.release(iter)
    return m.finish(&t)
}

export fn __mlx_soup_ws_deflate_configure(extension: usize, connectionType: i32, table: usize, err: usize) -> i32 {
    var text: usize = 0
    if table != 0 { text = paramsText(table) }
    var bad: []const u8 = ""
    const result = pmd.configure(stdDeflate(extension), connectionType == CONNECTION_CLIENT, m.cSlice(text), table != 0, &bad)
    var code: i32 = 1
    if result == pmd.Error.invalidParameter {
        code = invalidParam(err, bad, false)
    } else if result == pmd.Error.invalidValue {
        code = invalidParam(err, bad, true)
    }
    if text != 0 { m.release(text) }
    return code
}

export fn __mlx_soup_ws_deflate_request_params(extension: usize) -> usize { return g_strdup(m.literal(pmd.REQUEST_PARAMS)) }

export fn __mlx_soup_ws_deflate_response_params(extension: usize) -> usize {
    var t = m.text()
    if !pmd.writeResponseParams(c.sinkOf(&t), stdDeflate(extension)) {
        m.dispose(&t)
        return 0
    }
    const text = m.finish(&t)
    const result = g_strdup(text)
    m.release(text)
    return result
}

fn failed(err: usize, text: []const u8) -> usize {
    c.setError(err, soup_websocket_error_quark(), CLOSE_PROTOCOL_ERROR, text)
    return 0
}

// The payload's bytes as a slice.
fn payloadOf(payload: usize) -> []const u8 {
    const sizeCell = m.alloc(8)
    const data = g_bytes_get_data(payload, sizeCell)
    const length = m.getWord(sizeCell)
    m.release(sizeCell)
    return m.bytes(data, length)
}

export fn __mlx_soup_ws_deflate_outgoing(extension: usize, header: usize, payload: usize, err: usize) -> usize {
    const first: *u8 = unsafe { @ptrFromInt(*u8, header) }
    var out: pmd.Bytes = undefined
    const result = pmd.outgoing(stdDeflate(extension), first, payloadOf(payload), &out)
    if result != pmd.Error.none {
        g_bytes_unref(payload)
        return failed(err, "Failed to compress outgoing frame")
    }
    if out.capacity == 0 { return payload }
    g_bytes_unref(payload)
    // (The bytes are the C allocator's: GBytes frees them with g_free.)
    return g_bytes_new_take(@intFromPtr(out.bytes), out.length)
}

export fn __mlx_soup_ws_deflate_incoming(extension: usize, header: usize, payload: usize, err: usize) -> usize {
    const first: *u8 = unsafe { @ptrFromInt(*u8, header) }
    var out: pmd.Bytes = undefined
    const result = pmd.incoming(stdDeflate(extension), first, payloadOf(payload), &out)
    if result == pmd.Error.nonFirstCompressed {
        g_bytes_unref(payload)
        return failed(err, "Received a non-first frame with RSV1 flag set")
    }
    if result != pmd.Error.none {
        g_bytes_unref(payload)
        return failed(err, "Failed to uncompress incoming frame")
    }
    if out.capacity == 0 { return payload }
    g_bytes_unref(payload)
    return g_bytes_new_take(@intFromPtr(out.bytes), out.length)
}

export fn __mlx_soup_ws_deflate_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &deflatePrivate)
    m.putWord(class + 48, @intFromPtr(__mlx_soup_ws_deflate_finalize))
    m.putWord(class + C_NAME, m.literal(pmd.NAME))
    m.putWord(class + C_CONFIGURE, @intFromPtr(__mlx_soup_ws_deflate_configure))
    m.putWord(class + C_REQUEST_PARAMS, @intFromPtr(__mlx_soup_ws_deflate_request_params))
    m.putWord(class + C_RESPONSE_PARAMS, @intFromPtr(__mlx_soup_ws_deflate_response_params))
    m.putWord(class + C_OUTGOING, @intFromPtr(__mlx_soup_ws_deflate_outgoing))
    m.putWord(class + C_INCOMING, @intFromPtr(__mlx_soup_ws_deflate_incoming))
}

// ---------------------------------------------------------------------------
// SoupWebsocketExtensionManager

var managerType: usize = 0
var managerPrivate: i32 = 0

pub fn managerTypeGet() -> usize {
    if c.onceEnter(&managerType) {
        const t = c.defineType(c.T_OBJECT, "SoupWebsocketExtensionManager", 136, @intFromPtr(__mlx_soup_ws_manager_class_init), 24, @intFromPtr(__mlx_soup_ws_manager_init), c.FINAL)
        managerPrivate = c.addPrivate(t, 8)
        feature.implementFeature(t, @intFromPtr(__mlx_soup_ws_manager_feature_init))
        c.onceLeave(&managerType, t)
    }
    return managerType
}

export fn soup_websocket_extension_manager_get_type() -> usize { return managerTypeGet() }

// The extension classes the manager offers (a GPtrArray).
pub fn supported(manager: usize) -> usize { return m.getWord(c.privateAt(manager, managerPrivate)) }

export fn __mlx_soup_ws_manager_init(manager: usize, class: usize) -> void {
    m.putWord(c.privateAt(manager, managerPrivate), g_ptr_array_new_with_free_func(@intFromPtr(g_type_class_unref)))
    _ = __mlx_soup_ws_manager_add(manager, soup_websocket_extension_deflate_get_type())
}

export fn __mlx_soup_ws_manager_finalize(manager: usize) -> void {
    _ = g_ptr_array_free(supported(manager), 1)
    c.chainUp(g.g_type_class_ref(managerTypeGet()), 48, manager)
}

export fn __mlx_soup_ws_manager_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &managerPrivate)
    m.putWord(class + 48, @intFromPtr(__mlx_soup_ws_manager_finalize))
}

export fn __mlx_soup_ws_manager_add(manager: usize, t: usize) -> i32 {
    if g_type_is_a(t, extensionTypeGet()) == 0 { return 0 }
    g_ptr_array_add(supported(manager), g_type_class_ref(t))
    return 1
}

fn indexOf(manager: usize, t: usize) -> i64 {
    const class = g_type_class_peek(t)
    const array = supported(manager)
    var index: usize = 0
    while index < @intCast(usize, m.get32(array + 8)) {
        if m.getWord(m.getWord(array) + index * 8) == class { return @intCast(i64, index) }
        index += 1
    }
    return -1
}

export fn __mlx_soup_ws_manager_remove(manager: usize, t: usize) -> i32 {
    if g_type_is_a(t, extensionTypeGet()) == 0 { return 0 }
    const index = indexOf(manager, t)
    if index < 0 { return 0 }
    _ = g_ptr_array_remove_index(supported(manager), @intCast(u32, index))
    return 1
}

export fn __mlx_soup_ws_manager_has(manager: usize, t: usize) -> i32 {
    if g_type_is_a(t, extensionTypeGet()) == 0 { return 0 }
    return if indexOf(manager, t) >= 0 { 1 } else { 0 }
}

export fn __mlx_soup_ws_manager_feature_init(iface: usize, data: usize) -> void {
    m.putWord(iface + feature.ADD_FEATURE, @intFromPtr(__mlx_soup_ws_manager_add))
    m.putWord(iface + feature.REMOVE_FEATURE, @intFromPtr(__mlx_soup_ws_manager_remove))
    m.putWord(iface + feature.HAS_FEATURE, @intFromPtr(__mlx_soup_ws_manager_has))
}
