// soup-message-headers.h and soup-headers.h: SoupMessageHeaders as libsoup
// keeps them, and the parsing of message heads and header values
// (std.http.headers does the reading; this layer makes GLib's lists and
// tables of what it reads).
//
// libsoup keeps the headers whose names it knows (std.http.headers'
// names) apart from the others: each in the order they came, the known
// ones first when the headers are walked (soup_message_headers_iter,
// foreach), with libsoup's spelling of their names. The few headers it
// gives meaning to (Content-Length, Content-Type, Transfer-Encoding,
// Expect) are read as they are set, as libsoup does.
//
// A SoupMessageHeaders: its reference count (0), type (4), the known
// headers (8: entries of a name number and a value, their count 16 and
// room 24), the others (32: entries of a name and a value, 40, 48), the
// joined values of known names (56: a word per name, made when first
// asked for) and of the others (64: entries of a name and the joined
// value, 72, 80), the encoding (88, -1 until known), the content length
// (96), the expectations (104), the content type (112).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const http = @import("std.http.headers")
const msgm = @import("std.http.message")

const H_REFS: usize = 0
const H_TYPE: usize = 4
const H_KNOWN: usize = 8
const H_KNOWN_COUNT: usize = 16
const H_KNOWN_ROOM: usize = 24
const H_OTHER: usize = 32
const H_OTHER_COUNT: usize = 40
const H_OTHER_ROOM: usize = 48
const H_KNOWN_JOINED: usize = 56
const H_OTHER_JOINED: usize = 64
const H_OTHER_JOINED_COUNT: usize = 72
const H_OTHER_JOINED_ROOM: usize = 80
const H_ENCODING: usize = 88
const H_LENGTH: usize = 96
const H_EXPECT: usize = 104
const H_CONTENT_TYPE: usize = 112
const H_SIZE: usize = 120

pub const TYPE_REQUEST: i32 = 0
pub const TYPE_RESPONSE: i32 = 1
pub const TYPE_MULTIPART: i32 = 2

pub const ENCODING_UNRECOGNIZED: i32 = 0
pub const ENCODING_NONE: i32 = 1
pub const ENCODING_CONTENT_LENGTH: i32 = 2
pub const ENCODING_EOF: i32 = 3
pub const ENCODING_CHUNKED: i32 = 4
pub const ENCODING_BYTERANGES: i32 = 5

const EXPECTATION_UNRECOGNIZED: i32 = 1
const EXPECTATION_CONTINUE: i32 = 2

pub const UNKNOWN: usize = http.NAME_COUNT

var headersType: usize = 0

export fn __mlx_soup_headers_copy(hdrs: usize) -> usize { return soup_message_headers_ref(hdrs) }
export fn __mlx_soup_headers_free(hdrs: usize) -> void { soup_message_headers_unref(hdrs) }

export fn soup_message_headers_get_type() -> usize {
    if c.onceEnter(&headersType) {
        c.onceLeave(&headersType, g.g_boxed_type_register_static(m.literal("SoupMessageHeaders"), @intFromPtr(__mlx_soup_headers_copy), @intFromPtr(__mlx_soup_headers_free)))
    }
    return headersType
}

pub fn newHeaders(t: i32) -> usize {
    const h = m.alloc(H_SIZE)
    m.put32(h + H_REFS, 1)
    m.putI32(h + H_TYPE, t)
    m.putI32(h + H_ENCODING, -1)
    return h
}

export fn soup_message_headers_new(t: i32) -> usize { return newHeaders(t) }

export fn soup_message_headers_ref(hdrs: usize) -> usize {
    _ = @atomicRmw(u32, m.word32(hdrs + H_REFS), add, 1, acq_rel)
    return hdrs
}

export fn soup_message_headers_unref(hdrs: usize) -> void {
    if hdrs == 0 { return }
    if @atomicRmw(u32, m.word32(hdrs + H_REFS), sub, 1, acq_rel) != 1 { return }
    clear(hdrs)
    m.release(m.getWord(hdrs + H_KNOWN))
    m.release(m.getWord(hdrs + H_OTHER))
    m.release(m.getWord(hdrs + H_KNOWN_JOINED))
    m.release(m.getWord(hdrs + H_OTHER_JOINED))
    m.release(hdrs)
}

export fn soup_message_headers_get_headers_type(hdrs: usize) -> i32 { return m.getI32(hdrs + H_TYPE) }

// ---------------------------------------------------------------------------
// The entries: arrays of two words, grown by doubling.

fn entry(hdrs: usize, field: usize, index: usize) -> usize { return m.getWord(hdrs + field) + index * 16 }

fn pushEntry(hdrs: usize, field: usize, first: usize, second: usize) -> void {
    const count = m.getWord(hdrs + field + 8)
    if count == m.getWord(hdrs + field + 16) {
        const larger = if count == 0 { 6 } else { count * 2 }
        m.putWord(hdrs + field, m.grow(m.getWord(hdrs + field), larger * 16))
        m.putWord(hdrs + field + 16, larger)
    }
    m.putWord(entry(hdrs, field, count), first)
    m.putWord(entry(hdrs, field, count) + 8, second)
    m.putWord(hdrs + field + 8, count + 1)
}

fn removeEntry(hdrs: usize, field: usize, index: usize) -> void {
    const count = m.getWord(hdrs + field + 8)
    m.copy(entry(hdrs, field, index), entry(hdrs, field, index + 1), (count - index - 1) * 16)
    m.putWord(hdrs + field + 8, count - 1)
}

fn forgetKnownJoined(hdrs: usize, name: usize) -> void {
    const joined = m.getWord(hdrs + H_KNOWN_JOINED)
    if joined == 0 { return }
    m.release(m.getWord(joined + name * 8))
    m.putWord(joined + name * 8, 0)
}

fn forgetOtherJoined(hdrs: usize, name: usize) -> void {
    var index: usize = 0
    while index < m.getWord(hdrs + H_OTHER_JOINED_COUNT) {
        const e = entry(hdrs, H_OTHER_JOINED, index)
        if m.getWord(e) != 0 && c.equalsIgnoringCase(m.cSlice(m.getWord(e)), m.cSlice(name)) {
            m.release(m.getWord(e))
            m.release(m.getWord(e + 8))
            removeEntry(hdrs, H_OTHER_JOINED, index)
            continue
        }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// What libsoup reads as headers are set (soup_message_headers_set).

fn parseContentLength(hdrs: usize, value: usize) -> void {
    // g_ascii_strtoull: spaces and a sign allowed; anything after the
    // digits makes the encoding unrecognized.
    const text = m.cSlice(value)
    var at: usize = 0
    while at < text.length && http.isSpace(text[at]) { at += 1 }
    var negative = false
    if at < text.length && (text[at] == 43 || text[at] == 45) {
        negative = text[at] == 45
        at += 1
    }
    var number: u64 = 0
    var digits: usize = 0
    while at < text.length && http.isDigit(text[at]) {
        number = number *% 10 +% @intCast(u64, text[at] - 48)
        digits += 1
        at += 1
    }
    if digits == 0 { at = 0 }
    if negative { number = 0 -% number }
    m.putI64(hdrs + H_LENGTH, @bitCast(i64, number))
    m.putI32(hdrs + H_ENCODING, if at < text.length { ENCODING_UNRECOGNIZED } else { ENCODING_CONTENT_LENGTH })
}

fn setSpecial(hdrs: usize, name: usize, value: usize) -> void {
    if name == http.CONTENT_LENGTH {
        if m.getI32(hdrs + H_ENCODING) == ENCODING_CHUNKED { return }
        if value != 0 { parseContentLength(hdrs, value) } else { m.putI32(hdrs + H_ENCODING, -1) }
    } else if name == http.CONTENT_TYPE {
        m.release(m.getWord(hdrs + H_CONTENT_TYPE))
        m.putWord(hdrs + H_CONTENT_TYPE, 0)
        if value != 0 {
            // The type: what comes before a `;`, kept when it is
            // "type/subtype" with no space and one slash.
            const ct = contentFoo(hdrs, http.CONTENT_TYPE)
            const text = m.cSlice(ct)
            var first: usize = 0
            while first < text.length && text[first] != 32 && text[first] != 47 { first += 1 }
            var good = first < text.length && text[first] == 47
            if good {
                var rest = first + 1
                while rest < text.length {
                    if text[rest] == 32 || text[rest] == 47 { good = false }
                    rest += 1
                }
            }
            if good { m.putWord(hdrs + H_CONTENT_TYPE, ct) } else { m.release(ct) }
        }
    } else if name == http.EXPECT {
        if value != 0 {
            m.putI32(hdrs + H_EXPECT, if http.equalsIgnoringCase(m.cSlice(value), "100-continue") { EXPECTATION_CONTINUE } else { EXPECTATION_UNRECOGNIZED })
        } else {
            m.putI32(hdrs + H_EXPECT, 0)
        }
    } else if name == http.TRANSFER_ENCODING {
        if value != 0 {
            if http.equalsIgnoringCase(m.cSlice(value), "chunked") {
                m.putI32(hdrs + H_ENCODING, ENCODING_CHUNKED)
            } else if !http.equalsIgnoringCase(m.cSlice(value), "identity") {
                m.putI32(hdrs + H_ENCODING, ENCODING_UNRECOGNIZED)
            }
        } else {
            m.putI32(hdrs + H_ENCODING, -1)
        }
    }
}

fn clear(hdrs: usize) -> void {
    var index: usize = 0
    while index < m.getWord(hdrs + H_KNOWN_COUNT) {
        const e = entry(hdrs, H_KNOWN, index)
        m.release(m.getWord(e + 8))
        setSpecial(hdrs, m.getWord(e), 0)
        index += 1
    }
    m.putWord(hdrs + H_KNOWN_COUNT, 0)
    const joined = m.getWord(hdrs + H_KNOWN_JOINED)
    if joined != 0 {
        index = 0
        while index < UNKNOWN {
            m.release(m.getWord(joined + index * 8))
            m.putWord(joined + index * 8, 0)
            index += 1
        }
    }
    index = 0
    while index < m.getWord(hdrs + H_OTHER_COUNT) {
        const e = entry(hdrs, H_OTHER, index)
        m.release(m.getWord(e))
        m.release(m.getWord(e + 8))
        index += 1
    }
    m.putWord(hdrs + H_OTHER_COUNT, 0)
    index = 0
    while index < m.getWord(hdrs + H_OTHER_JOINED_COUNT) {
        const e = entry(hdrs, H_OTHER_JOINED, index)
        m.release(m.getWord(e))
        m.release(m.getWord(e + 8))
        index += 1
    }
    m.putWord(hdrs + H_OTHER_JOINED_COUNT, 0)
}

export fn soup_message_headers_clear(hdrs: usize) -> void { clear(hdrs) }

// ---------------------------------------------------------------------------
// Appending, removing, replacing

// A known header appended: a second Host is refused, and a value with a
// line end when it is not the library's own (as the patched libsoup of
// the system does); false when refused.
pub fn appendKnownChecked(hdrs: usize, name: usize, value: usize, trusted: bool) -> bool {
    if name == http.HOST && getOneKnown(hdrs, http.HOST) != 0 {
        c.warning("soup_message_headers_append_common: Rejecting duplicate Host header")
        return false
    }
    if !trusted && !validValue(value) {
        badValue(value)
        return false
    }
    pushEntry(hdrs, H_KNOWN, name, m.dup(value))
    forgetKnownJoined(hdrs, name)
    setSpecial(hdrs, name, value)
    return true
}

pub fn appendKnown(hdrs: usize, name: usize, value: usize) -> void { _ = appendKnownChecked(hdrs, name, value, true) }

fn validName(name: usize) -> bool {
    const text = m.cSlice(name)
    if text.length == 0 { return false }
    for ch in text {
        if ch == 32 || ch == 9 || ch == 13 || ch == 10 || ch == 58 { return false }
    }
    return true
}

fn validValue(value: usize) -> bool {
    for ch in m.cSlice(value) {
        if ch == 13 || ch == 10 { return false }
    }
    return true
}

fn badValue(value: usize) -> void {
    var t = m.text()
    m.pushText(&t, "soup_message_headers_append: Rejecting bad value '")
    m.pushC(&t, value)
    m.pushText(&t, "'")
    c.warning(m.cSlice(t.address))
    m.dispose(&t)
}

// libsoup's soup_message_headers_append_internal: false when the name or
// the value is refused (with a warning, as the patched libsoup gives).
pub fn appendChecked(hdrs: usize, name: usize, value: usize) -> bool {
    if name == 0 || value == 0 { return false }
    if !validName(name) {
        var t = m.text()
        m.pushText(&t, "soup_message_headers_append: Rejecting bad name '")
        m.pushC(&t, name)
        m.pushText(&t, "'")
        c.warning(m.cSlice(t.address))
        m.dispose(&t)
        return false
    }
    const known = http.nameIndex(m.cSlice(name))
    if known != UNKNOWN { return appendKnownChecked(hdrs, known, value, false) }
    if !validValue(value) {
        badValue(value)
        return false
    }
    pushEntry(hdrs, H_OTHER, m.dup(name), m.dup(value))
    forgetOtherJoined(hdrs, name)
    return true
}

pub fn append(hdrs: usize, name: usize, value: usize) -> void { _ = appendChecked(hdrs, name, value) }

export fn soup_message_headers_append(hdrs: usize, name: usize, value: usize) -> void { append(hdrs, name, value) }

// The untrusted bytes of a parsed message made valid UTF-8 first.
fn appendUntrusted(hdrs: usize, name: []const u8, value: []const u8) -> bool {
    const safeName = g.g_utf8_make_valid(@intFromPtr(name.pointer), @intCast(i64, name.length))
    const safeValue = g.g_utf8_make_valid(@intFromPtr(value.pointer), @intCast(i64, value.length))
    const good = appendChecked(hdrs, safeName, safeValue)
    g.g_free(safeName)
    g.g_free(safeValue)
    return good
}

pub fn removeKnown(hdrs: usize, name: usize) -> void {
    var index: usize = 0
    while index < m.getWord(hdrs + H_KNOWN_COUNT) {
        const e = entry(hdrs, H_KNOWN, index)
        if m.getWord(e) == name {
            m.release(m.getWord(e + 8))
            removeEntry(hdrs, H_KNOWN, index)
            continue
        }
        index += 1
    }
    forgetKnownJoined(hdrs, name)
    setSpecial(hdrs, name, 0)
}

pub fn remove(hdrs: usize, name: usize) -> void {
    if name == 0 { return }
    const known = http.nameIndex(m.cSlice(name))
    if known != UNKNOWN {
        removeKnown(hdrs, known)
        return
    }
    var index: usize = 0
    while index < m.getWord(hdrs + H_OTHER_COUNT) {
        const e = entry(hdrs, H_OTHER, index)
        if c.equalsIgnoringCase(m.cSlice(m.getWord(e)), m.cSlice(name)) {
            m.release(m.getWord(e))
            m.release(m.getWord(e + 8))
            removeEntry(hdrs, H_OTHER, index)
            continue
        }
        index += 1
    }
    forgetOtherJoined(hdrs, name)
}

export fn soup_message_headers_remove(hdrs: usize, name: usize) -> void { remove(hdrs, name) }

pub fn replaceKnown(hdrs: usize, name: usize, value: usize) -> void {
    removeKnown(hdrs, name)
    appendKnown(hdrs, name, value)
}

pub fn replace(hdrs: usize, name: usize, value: usize) -> void {
    remove(hdrs, name)
    append(hdrs, name, value)
}

export fn soup_message_headers_replace(hdrs: usize, name: usize, value: usize) -> void { replace(hdrs, name, value) }

// ---------------------------------------------------------------------------
// Reading

pub fn getOneKnown(hdrs: usize, name: usize) -> usize {
    var index = m.getWord(hdrs + H_KNOWN_COUNT)
    while index > 0 {
        index -= 1
        const e = entry(hdrs, H_KNOWN, index)
        if m.getWord(e) == name { return m.getWord(e + 8) }
    }
    return 0
}

pub fn getOne(hdrs: usize, name: usize) -> usize {
    if name == 0 { return 0 }
    const known = http.nameIndex(m.cSlice(name))
    if known != UNKNOWN { return getOneKnown(hdrs, known) }
    var index = m.getWord(hdrs + H_OTHER_COUNT)
    while index > 0 {
        index -= 1
        const e = entry(hdrs, H_OTHER, index)
        if c.equalsIgnoringCase(m.cSlice(m.getWord(e)), m.cSlice(name)) { return m.getWord(e + 8) }
    }
    return 0
}

export fn soup_message_headers_get_one(hdrs: usize, name: usize) -> usize { return getOne(hdrs, name) }

// The values of a known name joined with ", " (the one value as it is
// when there is one), kept until the name's headers change.
pub fn getListKnown(hdrs: usize, name: usize) -> usize {
    var joined = m.getWord(hdrs + H_KNOWN_JOINED)
    if joined != 0 && m.getWord(joined + name * 8) != 0 { return m.getWord(joined + name * 8) }
    var first: usize = 0
    var count: usize = 0
    var t = m.text()
    var index: usize = 0
    while index < m.getWord(hdrs + H_KNOWN_COUNT) {
        const e = entry(hdrs, H_KNOWN, index)
        if m.getWord(e) == name {
            if count == 0 { first = m.getWord(e + 8) } else { m.pushText(&t, ", ") }
            m.pushC(&t, m.getWord(e + 8))
            count += 1
        }
        index += 1
    }
    if count < 2 {
        m.dispose(&t)
        return first
    }
    if joined == 0 {
        joined = m.alloc(UNKNOWN * 8)
        m.putWord(hdrs + H_KNOWN_JOINED, joined)
    }
    const value = m.finish(&t)
    m.putWord(joined + name * 8, value)
    return value
}

pub fn getList(hdrs: usize, name: usize) -> usize {
    if name == 0 { return 0 }
    const known = http.nameIndex(m.cSlice(name))
    if known != UNKNOWN { return getListKnown(hdrs, known) }
    var index: usize = 0
    while index < m.getWord(hdrs + H_OTHER_JOINED_COUNT) {
        const e = entry(hdrs, H_OTHER_JOINED, index)
        if c.equalsIgnoringCase(m.cSlice(m.getWord(e)), m.cSlice(name)) { return m.getWord(e + 8) }
        index += 1
    }
    var first: usize = 0
    var count: usize = 0
    var t = m.text()
    index = 0
    while index < m.getWord(hdrs + H_OTHER_COUNT) {
        const e = entry(hdrs, H_OTHER, index)
        if c.equalsIgnoringCase(m.cSlice(m.getWord(e)), m.cSlice(name)) {
            if count == 0 { first = m.getWord(e + 8) } else { m.pushText(&t, ", ") }
            m.pushC(&t, m.getWord(e + 8))
            count += 1
        }
        index += 1
    }
    if count < 2 {
        m.dispose(&t)
        return first
    }
    const value = m.finish(&t)
    pushEntry(hdrs, H_OTHER_JOINED, m.dup(name), value)
    return value
}

export fn soup_message_headers_get_list(hdrs: usize, name: usize) -> usize { return getList(hdrs, name) }

export fn soup_message_headers_header_contains(hdrs: usize, name: usize, token: usize) -> i32 {
    const value = getList(hdrs, name)
    if value == 0 { return 0 }
    return if http.contains(m.cSlice(value), m.cSlice(token)) { 1 } else { 0 }
}

pub fn knownContains(hdrs: usize, name: usize, token: []const u8) -> bool {
    const value = getListKnown(hdrs, name)
    return value != 0 && http.contains(m.cSlice(value), token)
}

export fn soup_message_headers_header_equals(hdrs: usize, name: usize, value: usize) -> i32 {
    const internal = getList(hdrs, name)
    if internal == 0 { return 0 }
    return if http.equalsIgnoringCase(m.cSlice(internal), m.cSlice(value)) { 1 } else { 0 }
}

pub const ForeachFunc = fn(usize, usize, usize) -> void

export fn soup_message_headers_foreach(hdrs: usize, func: usize, data: usize) -> void {
    const call: ForeachFunc = unsafe { @ptrFromInt(ForeachFunc, func) }
    var index: usize = 0
    while index < m.getWord(hdrs + H_KNOWN_COUNT) {
        const e = entry(hdrs, H_KNOWN, index)
        call(nameString(m.getWord(e)), m.getWord(e + 8), data)
        index += 1
    }
    index = 0
    while index < m.getWord(hdrs + H_OTHER_COUNT) {
        const e = entry(hdrs, H_OTHER, index)
        call(m.getWord(e), m.getWord(e + 8), data)
        index += 1
    }
}

// libsoup's spelling of a known name, as a C string kept for the
// program's life.
var nameStrings: usize = 0

pub fn nameString(name: usize) -> usize {
    if c.onceEnter(&nameStrings) {
        const table = m.alloc(UNKNOWN * 8)
        var index: usize = 0
        while index < UNKNOWN {
            m.putWord(table + index * 8, m.dupSlice(http.nameOf(index)))
            index += 1
        }
        c.onceLeave(&nameStrings, table)
    }
    return m.getWord(nameStrings + name * 8)
}

// SoupMessageHeadersIter: the headers (0), where it is among the known
// headers (8) and the others (16).
export fn soup_message_headers_iter_init(iter: usize, hdrs: usize) -> void { iterInit(iter, hdrs) }

pub fn iterInit(iter: usize, hdrs: usize) -> void {
    m.putWord(iter, hdrs)
    m.putWord(iter + 8, 0)
    m.putWord(iter + 16, 0)
}

export fn soup_message_headers_iter_next(iter: usize, name: usize, value: usize) -> i32 { return if iterNext(iter, name, value) { 1 } else { 0 } }

pub fn iterNext(iter: usize, name: usize, value: usize) -> bool {
    const hdrs = m.getWord(iter)
    const known = m.getWord(iter + 8)
    if known < m.getWord(hdrs + H_KNOWN_COUNT) {
        const e = entry(hdrs, H_KNOWN, known)
        m.putWord(name, nameString(m.getWord(e)))
        m.putWord(value, m.getWord(e + 8))
        m.putWord(iter + 8, known + 1)
        return true
    }
    const other = m.getWord(iter + 16)
    if other < m.getWord(hdrs + H_OTHER_COUNT) {
        const e = entry(hdrs, H_OTHER, other)
        m.putWord(name, m.getWord(e))
        m.putWord(value, m.getWord(e + 8))
        m.putWord(iter + 16, other + 1)
        return true
    }
    return false
}

// The headers named in Connection taken out (RFC 2616 14.10).
pub fn cleanConnectionHeaders(hdrs: usize) -> void {
    const connection = getListKnown(hdrs, http.CONNECTION)
    if connection == 0 { return }
    const copy = m.dup(connection)
    var items = http.list(m.cSlice(copy), 44)
    var item: []const u8 = ""
    while http.next(&items, &item) {
        const name = c.dup(item)
        remove(hdrs, name)
        m.release(name)
    }
    m.release(copy)
}

export fn soup_message_headers_clean_connection_headers(hdrs: usize) -> void { cleanConnectionHeaders(hdrs) }

// ---------------------------------------------------------------------------
// Encoding, length, expectations

pub fn getEncoding(hdrs: usize) -> i32 {
    const encoding = m.getI32(hdrs + H_ENCODING)
    if encoding != -1 { return encoding }
    const length = getOneKnown(hdrs, http.CONTENT_LENGTH)
    if length != 0 {
        setSpecial(hdrs, http.CONTENT_LENGTH, length)
        if m.getI32(hdrs + H_ENCODING) != -1 { return m.getI32(hdrs + H_ENCODING) }
    }
    // A response that says nothing of its length runs to the connection's
    // end; a request has no body.
    const result = if m.getI32(hdrs + H_TYPE) == TYPE_RESPONSE { ENCODING_EOF } else { ENCODING_NONE }
    m.putI32(hdrs + H_ENCODING, result)
    return result
}

export fn soup_message_headers_get_encoding(hdrs: usize) -> i32 { return getEncoding(hdrs) }

export fn soup_message_headers_set_encoding(hdrs: usize, encoding: i32) -> void {
    if encoding == m.getI32(hdrs + H_ENCODING) { return }
    if encoding == ENCODING_NONE || encoding == ENCODING_EOF {
        removeKnown(hdrs, http.TRANSFER_ENCODING)
        removeKnown(hdrs, http.CONTENT_LENGTH)
    } else if encoding == ENCODING_CONTENT_LENGTH {
        removeKnown(hdrs, http.TRANSFER_ENCODING)
    } else if encoding == ENCODING_CHUNKED {
        removeKnown(hdrs, http.CONTENT_LENGTH)
        replaceKnown(hdrs, http.TRANSFER_ENCODING, m.literal("chunked"))
    } else {
        c.critical("soup_message_headers_set_encoding: code should not be reached")
        return
    }
    m.putI32(hdrs + H_ENCODING, encoding)
}

export fn soup_message_headers_get_content_length(hdrs: usize) -> i64 {
    if getEncoding(hdrs) == ENCODING_CONTENT_LENGTH { return m.getI64(hdrs + H_LENGTH) }
    return 0
}

fn decimal(t: *m.Text, value: i64) -> void { m.pushSigned(t, value) }

export fn soup_message_headers_set_content_length(hdrs: usize, length: i64) -> void {
    var t = m.text()
    m.pushDecimal(&t, @bitCast(u64, length))
    const text = m.finish(&t)
    removeKnown(hdrs, http.TRANSFER_ENCODING)
    replaceKnown(hdrs, http.CONTENT_LENGTH, text)
    m.release(text)
}

export fn soup_message_headers_get_expectations(hdrs: usize) -> i32 { return m.getI32(hdrs + H_EXPECT) }

export fn soup_message_headers_set_expectations(hdrs: usize, expectations: i32) -> void {
    if (expectations & ~EXPECTATION_CONTINUE) != 0 {
        c.critical("soup_message_headers_set_expectations: assertion '(expectations & ~SOUP_EXPECTATION_CONTINUE) == 0' failed")
        return
    }
    if (expectations & EXPECTATION_CONTINUE) != 0 {
        replaceKnown(hdrs, http.EXPECT, m.literal("100-continue"))
    } else {
        removeKnown(hdrs, http.EXPECT)
    }
}

// ---------------------------------------------------------------------------
// Ranges

// g_ascii_strtoull/strtoll of `text` from `at`: the number and where it
// stopped (spaces and a sign allowed first).
const Number = struct {
    value: i64
    end: usize
}

fn strtonum(text: []const u8, at: usize) -> Number {
    var i = at
    while i < text.length && http.isSpace(text[i]) { i += 1 }
    var negative = false
    if i < text.length && (text[i] == 43 || text[i] == 45) {
        negative = text[i] == 45
        i += 1
    }
    const start = i
    var value: u64 = 0
    while i < text.length && http.isDigit(text[i]) {
        value = value *% 10 +% @intCast(u64, text[i] - 48)
        i += 1
    }
    if i == start { return Number.{ .value = 0, .end = at } }
    if negative { value = 0 -% value }
    return Number.{ .value = @bitCast(i64, value), .end = i }
}

// g_ascii_strtoull's ERANGE: more digits than a u64 holds.
fn overflows(text: []const u8, at: usize) -> bool {
    var i = at
    while i < text.length && http.isSpace(text[i]) { i += 1 }
    if i < text.length && (text[i] == 43 || text[i] == 45) { i += 1 }
    var value: u64 = 0
    while i < text.length && http.isDigit(text[i]) {
        const digit = @intCast(u64, text[i] - 48)
        if value > (18446744073709551615 - digit) / 10 { return true }
        value = value * 10 + digit
        i += 1
    }
    return false
}

fn tooLargeOffset(text: []const u8, at: usize, value: i64) -> bool { return overflows(text, at) || value < 0 }

pub const MAX_RANGES: usize = 200

// libsoup's soup_message_headers_get_ranges_internal (as patched): the
// status (200, 206 or 416) and the ranges (C memory, `count` of them) for
// 206.
pub fn rangesInternal(hdrs: usize, total: i64, checkSatisfiable: bool, ranges: usize, count: usize) -> u32 {
    const header = getOneKnown(hdrs, http.RANGE)
    if header == 0 { return 200 }
    const text = m.cSlice(header)
    if text.length < 5 || !m.same(text[0..5], "bytes") { return 200 }
    var at: usize = 5
    while at < text.length && http.isSpace(text[at]) { at += 1 }
    if at >= text.length || text[at] != 61 { return 200 }
    at += 1
    while at < text.length && http.isSpace(text[at]) { at += 1 }
    const spec = text[at..text.length]
    var items = http.list(spec, 44)
    var item: []const u8 = ""
    var listed: usize = 0
    while http.next(&items, &item) { listed += 1 }
    if listed == 0 { return 200 }
    // A client asking for this many ranges is refused outright.
    if listed > MAX_RANGES { return if checkSatisfiable { 416 } else { 200 } }
    items = http.list(spec, 44)
    var array = m.words()
    var status: u32 = 200
    while http.next(&items, &item) {
        var start: i64 = 0
        var end: i64 = 0
        var stop: usize = 0
        if item.length > 0 && item[0] == 45 {
            // A suffix: the last bytes, all of the body when it is shorter.
            const n = strtonum(item, 0)
            if overflows(item, 0) || n.value <= 0 - total { start = 0 } else { start = total + n.value }
            end = total - 1
            stop = n.end
        } else {
            const n = strtonum(item, 0)
            if tooLargeOffset(item, 0, n.value) {
                status = 200
                break
            }
            start = n.value
            stop = n.end
            if stop < item.length && item[stop] == 45 { stop += 1 }
            if stop < item.length {
                const e = strtonum(item, stop)
                if tooLargeOffset(item, stop, e.value) {
                    status = 200
                    break
                }
                end = e.value
                stop = e.end
                if end < start {
                    status = 200
                    break
                }
            } else {
                end = total - 1
            }
        }
        if stop < item.length {
            status = 200
            break
        } else if checkSatisfiable && start >= total {
            if status == 200 { status = 416 }
            continue
        }
        m.pushWord(&array, @bitCast(usize, start))
        m.pushWord(&array, @bitCast(usize, end))
        status = 206
    }
    if status != 206 {
        m.disposeWords(&array)
        return status
    }
    var n = array.length / 2
    if total != 0 {
        // Sorted by start (stable), then each run of overlapping ranges
        // made one.
        var i: usize = 1
        while i < n {
            var j = i
            while j > 0 && @bitCast(i64, m.wordAt(&array, (j - 1) * 2)) > @bitCast(i64, m.wordAt(&array, j * 2)) {
                const s = m.wordAt(&array, j * 2)
                const e = m.wordAt(&array, j * 2 + 1)
                m.putWord(array.address + j * 16, m.wordAt(&array, (j - 1) * 2))
                m.putWord(array.address + j * 16 + 8, m.wordAt(&array, (j - 1) * 2 + 1))
                m.putWord(array.address + (j - 1) * 16, s)
                m.putWord(array.address + (j - 1) * 16 + 8, e)
                j -= 1
            }
            i += 1
        }
        var last: usize = 0
        i = 1
        while i < n {
            const curStart = @bitCast(i64, m.wordAt(&array, i * 2))
            const curEnd = @bitCast(i64, m.wordAt(&array, i * 2 + 1))
            const lastEnd = @bitCast(i64, m.wordAt(&array, last * 2 + 1))
            if curStart <= lastEnd {
                if curEnd > lastEnd { m.putWord(array.address + last * 16 + 8, @bitCast(usize, curEnd)) }
            } else {
                last += 1
                m.putWord(array.address + last * 16, @bitCast(usize, curStart))
                m.putWord(array.address + last * 16 + 8, @bitCast(usize, curEnd))
            }
            i += 1
        }
        n = last + 1
    }
    if ranges != 0 {
        const out = m.alloc(n * 16 + 16)
        m.copy(out, array.address, n * 16)
        m.putWord(ranges, out)
    }
    if count != 0 { m.putI32(count, @intCast(i32, n)) }
    m.disposeWords(&array)
    return 206
}

export fn soup_message_headers_get_ranges(hdrs: usize, total_length: i64, ranges: usize, length: usize) -> i32 {
    return if rangesInternal(hdrs, total_length, false, ranges, length) == 206 { 1 } else { 0 }
}

export fn soup_message_headers_free_ranges(hdrs: usize, ranges: usize) -> void { m.release(ranges) }

export fn soup_message_headers_set_ranges(hdrs: usize, ranges: usize, length: i32) -> void {
    var t = m.text()
    m.pushText(&t, "bytes=")
    var index: usize = 0
    while index < @intCast(usize, length) {
        if index > 0 { m.pushByte(&t, 44) }
        const start = m.getI64(ranges + index * 16)
        const end = m.getI64(ranges + index * 16 + 8)
        if end >= 0 {
            m.pushSigned(&t, start)
            m.pushByte(&t, 45)
            m.pushSigned(&t, end)
        } else if start >= 0 {
            m.pushSigned(&t, start)
            m.pushByte(&t, 45)
        } else {
            m.pushSigned(&t, start)
        }
        index += 1
    }
    const text = m.finish(&t)
    replaceKnown(hdrs, http.RANGE, text)
    m.release(text)
}

export fn soup_message_headers_set_range(hdrs: usize, start: i64, end: i64) -> void {
    const range = m.alloc(16)
    m.putI64(range, start)
    m.putI64(range + 8, end)
    soup_message_headers_set_ranges(hdrs, range, 1)
    m.release(range)
}

export fn soup_message_headers_get_content_range(hdrs: usize, start: usize, end: usize, total_length: usize) -> i32 {
    const header = getOneKnown(hdrs, http.CONTENT_RANGE)
    if header == 0 { return 0 }
    const text = m.cSlice(header)
    if text.length < 6 || !m.same(text[0..6], "bytes ") { return 0 }
    var at: usize = 6
    while at < text.length && http.isSpace(text[at]) { at += 1 }
    if at >= text.length || !http.isDigit(text[at]) { return 0 }
    const s = strtonum(text, at)
    m.putI64(start, s.value)
    if s.end >= text.length || text[s.end] != 45 { return 0 }
    const e = strtonum(text, s.end + 1)
    m.putI64(end, e.value)
    if e.end >= text.length || text[e.end] != 47 { return 0 }
    at = e.end + 1
    var length: i64 = 0
    if at < text.length && text[at] == 42 {
        length = -1
        at += 1
    } else {
        const l = strtonum(text, at)
        length = l.value
        at = l.end
    }
    if total_length != 0 { m.putI64(total_length, length) }
    return if at == text.length { 1 } else { 0 }
}

export fn soup_message_headers_set_content_range(hdrs: usize, start: i64, end: i64, total_length: i64) -> void {
    var t = m.text()
    m.pushText(&t, "bytes ")
    m.pushSigned(&t, start)
    m.pushByte(&t, 45)
    m.pushSigned(&t, end)
    m.pushByte(&t, 47)
    if total_length >= 0 { m.pushSigned(&t, total_length) } else { m.pushByte(&t, 42) }
    const text = m.finish(&t)
    replaceKnown(hdrs, http.CONTENT_RANGE, text)
    m.release(text)
}

// ---------------------------------------------------------------------------
// Content-Type and Content-Disposition

// The "foo" of Content-Foo: the value up to its `;`, spaces before the
// `;` taken off (a new C string; 0 when there is no such header).
fn contentFoo(hdrs: usize, name: usize) -> usize {
    const header = getOneKnown(hdrs, name)
    if header == 0 { return 0 }
    const text = m.cSlice(header)
    const semi = http.indexOf(text, 59, 0)
    if semi >= text.length { return m.dup(header) }
    var end = semi
    while end > 1 && http.isSpace(text[end - 1]) { end -= 1 }
    return m.dupBytes(header, end)
}

// The parameters after the type's `;` (a table, empty when there are
// none).
fn contentParams(hdrs: usize, name: usize) -> usize {
    const header = getOneKnown(hdrs, name)
    const text = m.cSlice(header)
    const equal = http.indexOf(text, 61, 0)
    const semi = http.indexOf(text, 59, 0)
    // Some sites send a disposition of parameters alone: all of it is
    // parameters then.
    if name == http.CONTENT_DISPOSITION && equal < text.length && (semi >= text.length || equal < semi) {
        return paramList(text, 59, false)
    }
    if semi >= text.length { return paramList("", 59, false) }
    return paramList(text[semi + 1..text.length], 59, false)
}

export fn soup_message_headers_get_content_type(hdrs: usize, params: usize) -> usize {
    const ct = m.getWord(hdrs + H_CONTENT_TYPE)
    if ct == 0 { return 0 }
    if params != 0 { m.putWord(params, contentParams(hdrs, http.CONTENT_TYPE)) }
    return ct
}

fn setContentFoo(hdrs: usize, name: usize, foo: usize, params: usize) -> void {
    const s = g.g_string_new(foo)
    if params != 0 {
        const iter = m.alloc(64)
        g.g_hash_table_iter_init(iter, params)
        const key = m.alloc(16)
        while g.g_hash_table_iter_next(iter, key, key + 8) != 0 {
            _ = g.g_string_append(s, m.literal("; "))
            appendParam(s, m.getWord(key), m.getWord(key + 8))
        }
        m.release(key)
        m.release(iter)
    }
    const text = g.g_string_free(s, 0)
    replaceKnown(hdrs, name, text)
    g.g_free(text)
}

export fn soup_message_headers_set_content_type(hdrs: usize, content_type: usize, params: usize) -> void { setContentFoo(hdrs, http.CONTENT_TYPE, content_type, params) }

export fn soup_message_headers_get_content_disposition(hdrs: usize, disposition: usize, params: usize) -> i32 {
    const header = getOneKnown(hdrs, http.CONTENT_DISPOSITION)
    if header == 0 { return 0 }
    const text = m.cSlice(header)
    const equal = http.indexOf(text, 61, 0)
    const semi = http.indexOf(text, 59, 0)
    if disposition != 0 {
        if equal < text.length && (semi >= text.length || equal < semi) {
            m.putWord(disposition, 0)
        } else {
            m.putWord(disposition, contentFoo(hdrs, http.CONTENT_DISPOSITION))
        }
    }
    if params == 0 { return 1 }
    const table = contentParams(hdrs, http.CONTENT_DISPOSITION)
    m.putWord(params, table)
    // A filename keeps only what follows its last `/`; one with no value
    // is no filename.
    const cell = m.alloc(16)
    if g.g_hash_table_lookup_extended(table, m.literal("filename"), cell, cell + 8) != 0 {
        const value = m.getWord(cell + 8)
        if value == 0 {
            _ = g.g_hash_table_remove(table, m.literal("filename"))
        } else {
            const valueText = m.cSlice(value)
            var slash = valueText.length
            var i = valueText.length
            while i > 0 {
                i -= 1
                if valueText[i] == 47 {
                    slash = i
                    break
                }
            }
            if slash < valueText.length { _ = g.g_hash_table_insert(table, g.g_strdup(m.getWord(cell)), m.dup(value + slash + 1)) }
        }
    }
    m.release(cell)
    return 1
}

export fn soup_message_headers_set_content_disposition(hdrs: usize, disposition: usize, params: usize) -> void { setContentFoo(hdrs, http.CONTENT_DISPOSITION, disposition, params) }

// ---------------------------------------------------------------------------
// soup-headers.h: message heads

// libsoup's soup_headers_parse: the lines after the first of `str` as
// headers of `dest` (continuation lines folded, bad lines skipped, as
// std.http.message reads them); false when there is no line end, a NUL
// anywhere, or a header line with no end.
pub fn parseHeaders(str: usize, len: usize, dest: usize) -> bool {
    const all = m.bytes(str, len)
    // (No NUL anywhere, as the patched libsoup has it.)
    if http.indexOf(all, 0, 0) < len { return false }
    const first = http.indexOf(all, 10, 0)
    if first >= len { return false }
    var it = msgm.headerLinesFrom(all, first + 1)
    // (A folded value is no longer than its lines.)
    const folded = m.raw(len + 1)
    const buffer: [*]u8 = unsafe { @ptrFromInt([*]u8, folded) }
    var name: []const u8 = ""
    var value: []const u8 = ""
    var good = true
    while msgm.nextHeader(&it, &name, &value, buffer[0..len]) {
        if !appendUntrusted(dest, name, value) {
            good = false
            break
        }
    }
    if it.truncated { good = false }
    m.release(folded)
    return good
}

export fn soup_headers_parse(str: usize, len: i32, dest: usize) -> i32 {
    if str == 0 || dest == 0 { return 0 }
    return if parseHeaders(str, @intCast(usize, len), dest) { 1 } else { 0 }
}

fn versionNumber(version: msgm.Version) -> i32 { return if version == msgm.Version.http10 { 0 } else { 1 } }

// libsoup's soup_headers_parse_request (std.http.message's request line,
// then the headers): 200, or the status the request deserves.
export fn soup_headers_parse_request(str: usize, len: i32, req_headers: usize, req_method: usize, req_path: usize, ver: usize) -> u32 {
    if str == 0 { return 400 }
    var start = str
    var length = @intCast(usize, len)
    while length > 0 && (m.get8(start) == 13 || m.get8(start) == 10) {
        start += 1
        length -= 1
    }
    if length == 0 { return 400 }
    var line: msgm.RequestLine = undefined
    if !msgm.parseRequestLine(m.bytes(start, length), &line) { return line.status }
    if !parseHeaders(start, length, req_headers) { return 400 }
    if (m.getI32(req_headers + H_EXPECT) & EXPECTATION_UNRECOGNIZED) != 0 { return 417 }
    if line.version == msgm.Version.http10 { cleanConnectionHeaders(req_headers) }
    if req_method != 0 { m.putWord(req_method, c.dup(line.method)) }
    if req_path != 0 { m.putWord(req_path, c.dup(line.target)) }
    if ver != 0 { m.putI32(ver, versionNumber(line.version)) }
    return 200
}

// libsoup's soup_headers_parse_status_line (std.http.message's; the line
// ends at a NUL or a newline, and the version is given before the code
// is read, as libsoup does).
pub fn parseStatusLine(line: usize, ver: usize, status_code: usize, reason_phrase: usize) -> bool {
    var parsed: msgm.StatusLine = undefined
    const good = msgm.parseStatusLine(m.cSlice(line), &parsed)
    if ver != 0 {
        if parsed.hasVersion { m.putI32(ver, versionNumber(parsed.version)) }
    }
    if !good { return false }
    if status_code != 0 { m.put32(status_code, parsed.code) }
    if reason_phrase != 0 { m.putWord(reason_phrase, c.dup(parsed.phrase)) }
    return true
}

export fn soup_headers_parse_status_line(status_line: usize, ver: usize, status_code: usize, reason_phrase: usize) -> i32 {
    if status_line == 0 { return 0 }
    return if parseStatusLine(status_line, ver, status_code, reason_phrase) { 1 } else { 0 }
}

pub fn parseResponse(str: usize, len: usize, hdrs: usize, ver: usize, status_code: usize, reason_phrase: usize) -> bool {
    var start = str
    var length = len
    while length > 0 && (m.get8(start) == 13 || m.get8(start) == 10) {
        start += 1
        length -= 1
    }
    if length == 0 { return false }
    if !parseHeaders(start, length, hdrs) { return false }
    // (The status line is read from the head itself, up to its newline.)
    const line = m.dupBytes(start, http.indexOf(m.bytes(start, length), 10, 0))
    const cell = m.alloc(8)
    const good = parseStatusLine(line, cell, status_code, reason_phrase)
    m.release(line)
    if good {
        if ver != 0 { m.putI32(ver, m.getI32(cell)) }
        if m.getI32(cell) == 0 { cleanConnectionHeaders(hdrs) }
    }
    m.release(cell)
    return good
}

export fn soup_headers_parse_response(str: usize, len: i32, hdrs: usize, ver: usize, status_code: usize, reason_phrase: usize) -> i32 {
    if str == 0 { return 0 }
    return if parseResponse(str, @intCast(usize, len), hdrs, ver, status_code, reason_phrase) { 1 } else { 0 }
}

// ---------------------------------------------------------------------------
// soup-headers.h: header values

export fn soup_header_parse_list(header: usize) -> usize {
    if header == 0 { return 0 }
    var list: usize = 0
    var items = http.list(m.cSlice(header), 44)
    var item: []const u8 = ""
    while http.next(&items, &item) { list = g.g_slist_prepend(list, c.dup(item)) }
    return g.g_slist_reverse(list)
}

export fn soup_header_parse_quality_list(header: usize, unacceptable: usize) -> usize {
    if header == 0 { return 0 }
    if unacceptable != 0 { m.putWord(unacceptable, 0) }
    // The acceptable items with their q-values, sorted by them (highest
    // first; equal ones keep their order).
    var items = http.list(m.cSlice(header), 44)
    var item: []const u8 = ""
    var accepted = m.words()
    var values = m.words()
    var refused: usize = 0
    while http.next(&items, &item) {
        const q = http.quality(item)
        if q.thousandths == 0 {
            if unacceptable != 0 { refused = g.g_slist_prepend(refused, c.dup(item[0..q.length])) }
            continue
        }
        m.pushWord(&accepted, c.dup(item[0..q.length]))
        m.pushWord(&values, @intCast(usize, q.thousandths))
    }
    var i: usize = 1
    while i < accepted.length {
        var j = i
        while j > 0 && m.wordAt(&values, j - 1) < m.wordAt(&values, j) {
            const a = m.wordAt(&accepted, j)
            const v = m.wordAt(&values, j)
            m.putWord(accepted.address + j * 8, m.wordAt(&accepted, j - 1))
            m.putWord(values.address + j * 8, m.wordAt(&values, j - 1))
            m.putWord(accepted.address + (j - 1) * 8, a)
            m.putWord(values.address + (j - 1) * 8, v)
            j -= 1
        }
        i += 1
    }
    var sorted: usize = 0
    var n = accepted.length
    while n > 0 {
        n -= 1
        sorted = g.g_slist_prepend(sorted, m.wordAt(&accepted, n))
    }
    m.disposeWords(&accepted)
    m.disposeWords(&values)
    if unacceptable != 0 { m.putWord(unacceptable, refused) }
    return sorted
}

export fn soup_header_free_list(list: usize) -> void { g.g_slist_free_full(list, @intFromPtr(g.g_free)) }

export fn soup_header_contains(header: usize, token: usize) -> i32 {
    if header == 0 || token == 0 { return 0 }
    return if http.contains(m.cSlice(header), m.cSlice(token)) { 1 } else { 0 }
}

// libsoup's soup_str_case_hash and soup_str_case_equal: names compared
// without case.
export fn __mlx_soup_case_hash(key: usize) -> u32 {
    var h: u32 = 0
    for ch in m.cSlice(key) {
        h = (h << 5) -% h +% @intCast(u32, http.lower(ch))
    }
    return h
}

export fn __mlx_soup_case_equal(a: usize, b: usize) -> i32 { return if http.equalsIgnoringCase(m.cSlice(a), m.cSlice(b)) { 1 } else { 0 } }

pub fn caseTable(valueDestroy: usize) -> usize { return g.g_hash_table_new_full(@intFromPtr(__mlx_soup_case_hash), @intFromPtr(__mlx_soup_case_equal), @intFromPtr(g.g_free), valueDestroy) }

// libsoup's parse_param_list: a table of the parameters (names without
// case, a value NULL for a bare name), or 0 when `strict` and a name
// repeats.
pub fn paramList(header: []const u8, delim: u8, strict: bool) -> usize {
    const table = caseTable(@intFromPtr(g.g_free))
    var items = http.list(header, delim)
    var item: []const u8 = ""
    var p: http.Param = undefined
    while http.next(&items, &item) {
        if !http.param(item, &p) { continue }
        const key = c.dup(p.name)
        var value: usize = 0
        var override = false
        if p.kind != http.ParamKind.bare {
            const room = item.length * 2 + 2
            value = m.raw(room + 1)
            const out: [*]u8 = unsafe { @ptrFromInt([*]u8, value) }
            var length: usize = 0
            if p.kind == http.ParamKind.extended {
                const decoded = http.decodeExtended(p.value, out[0..room])
                if decoded < 0 {
                    m.release(value)
                    m.release(key)
                    continue
                }
                length = @intCast(usize, decoded)
                override = true
            } else if p.kind == http.ParamKind.quoted {
                length = http.decodeQuoted(p.value, out[0..room])
            } else {
                m.copy(value, @intFromPtr(p.value.pointer), p.value.length)
                length = p.value.length
            }
            m.put8(value + length, 0)
        }
        const duplicated = g.g_hash_table_lookup_extended(table, key, 0, 0) != 0
        if strict && duplicated {
            m.release(value)
            m.release(key)
            g.g_hash_table_destroy(table)
            return 0
        }
        if override || !duplicated {
            _ = g.g_hash_table_replace(table, key, value)
        } else {
            m.release(value)
            m.release(key)
        }
    }
    return table
}

export fn soup_header_parse_param_list(header: usize) -> usize {
    if header == 0 { return 0 }
    return paramList(m.cSlice(header), 44, false)
}

export fn soup_header_parse_semi_param_list(header: usize) -> usize {
    if header == 0 { return 0 }
    return paramList(m.cSlice(header), 59, false)
}

export fn soup_header_parse_param_list_strict(header: usize) -> usize {
    if header == 0 { return 0 }
    return paramList(m.cSlice(header), 44, true)
}

export fn soup_header_parse_semi_param_list_strict(header: usize) -> usize {
    if header == 0 { return 0 }
    return paramList(m.cSlice(header), 59, true)
}

export fn soup_header_free_param_list(param_list: usize) -> void {
    if param_list == 0 { return }
    g.g_hash_table_destroy(param_list)
}

pub fn appendParam(s: usize, name: usize, value: usize) -> void {
    if value == 0 {
        _ = g.g_string_append(s, name)
        return
    }
    http.writeParam(c.gstringSink(s), m.cSlice(name), m.cSlice(value), true)
}

export fn soup_header_g_string_append_param(string: usize, name: usize, value: usize) -> void {
    if string == 0 || name == 0 { return }
    appendParam(string, name, value)
}

export fn soup_header_g_string_append_param_quoted(string: usize, name: usize, value: usize) -> void {
    if string == 0 || name == 0 || value == 0 { return }
    http.writeParam(c.gstringSink(string), m.cSlice(name), m.cSlice(value), false)
}
