// soup-cookie-jar.h, soup-cookie-jar-text.h, soup-cookie-jar-db.h:
// SoupCookieJar, the session feature that keeps cookies (by domain, in the
// order they came) and gives each request those that apply (RFC 6265:
// longest paths first, then the oldest; SameSite as libsoup applies it),
// taking the ones a response sets by its accept policy and libsoup's
// rules (no public suffixes, no secure cookies from http, the __Secure-
// and __Host- prefixes, no control characters, at most 4096 bytes).
// SoupCookieJarText keeps them in a Mozilla cookies.txt file;
// SoupCookieJarDB here keeps them in the same text form in its file (this
// library has no SQLite): persistent, but not readable by libsoup's
// SQLite jar.
//
// A SoupCookieJar's private data is a pointer to a record of the domains
// (0: a GHashTable of domain to a GSList of cookies), the serials (8: a
// GHashTable of cookie to the order it came in), the last serial (16),
// the accept policy (20), whether read-only (24), whether constructed
// (28) and a mutex (32). A text or DB jar adds (24) a record of its file
// name (0).
//
// The class (SoupCookieJarClass): save (136), is_persistent (144),
// changed (152).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const misc = @import("./misc.mlx")
const message = @import("./message.mlx")
const feature = @import("./feature.mlx")
const cookie = @import("./cookie.mlx")
const enums = @import("./enumtypes.mlx")
const tld = @import("./tld.mlx")
const http = @import("std.http.headers")
const cookies = @import("std.http.cookie")

extern("c") fn soup_cookie_copy(cookie: usize) -> usize
extern("c") fn soup_cookie_free(cookie: usize) -> void
extern("c") fn soup_cookie_get_type() -> usize
extern("c") fn soup_cookie_parse(header: usize, origin: usize) -> usize
extern("c") fn soup_cookie_new(name: usize, value: usize, domain: usize, path: usize, max_age: i32) -> usize
extern("c") fn soup_cookie_set_secure(cookie: usize, b: i32) -> void
extern("c") fn soup_cookie_set_http_only(cookie: usize, b: i32) -> void
extern("c") fn soup_cookie_set_same_site_policy(cookie: usize, policy: i32) -> void
extern("c") fn soup_cookie_applies_to_uri(cookie: usize, uri: usize) -> i32
extern("c") fn soup_cookie_equal(a: usize, b: usize) -> i32
extern("c") fn soup_cookies_from_response(msg: usize) -> usize
extern("c") fn soup_cookies_to_cookie_header(list: usize) -> usize
extern("c") fn soup_message_headers_replace(h: usize, name: usize, value: usize) -> void
extern("c") fn soup_message_headers_remove(h: usize, name: usize) -> void
extern("c") fn soup_message_add_header_handler(msg: usize, signal: usize, header: usize, callback: usize, data: usize) -> u32
extern("c") fn soup_message_add_status_code_handler(msg: usize, signal: usize, code: u32, callback: usize, data: usize) -> u32
extern("c") fn g_slist_delete_link(list: usize, link: usize) -> usize
extern("c") fn g_slist_sort_with_data(list: usize, compare: usize, data: usize) -> usize
extern("c") fn g_hash_table_add(table: usize, key: usize) -> i32
extern("c") fn g_signal_handlers_disconnect_matched(instance: usize, mask: i32, id: u32, detail: u32, closure: usize, func: usize, data: usize) -> u32
extern("c") fn g_free(address: usize) -> void
extern("c") fn time(t: usize) -> i64
extern("c") fn __mlx_soup_case_hash(key: usize) -> u32
extern("c") fn __mlx_soup_case_equal(a: usize, b: usize) -> i32

const P_DOMAINS: usize = 0
const P_SERIALS: usize = 8
const P_SERIAL: usize = 16
const P_POLICY: usize = 20
const P_READ_ONLY: usize = 24
const P_CONSTRUCTED: usize = 28
const P_MUTEX: usize = 32
const P_SIZE: usize = 40

const C_SAVE: usize = 136
const C_IS_PERSISTENT: usize = 144
const C_CHANGED: usize = 152
const CLASS_SIZE: usize = 208

// SoupCookieJarAcceptPolicy.
const ACCEPT_ALWAYS: i32 = 0
const ACCEPT_NEVER: i32 = 1
const ACCEPT_NO_THIRD_PARTY: i32 = 2
const ACCEPT_GRANDFATHERED_THIRD_PARTY: i32 = 3

const PROP_READ_ONLY: u32 = 1
const PROP_ACCEPT_POLICY: u32 = 2
const PROP_FILENAME: u32 = 1

pub const ChangedFn = fn(usize, usize, usize) -> void
pub const BoolFn = fn(usize) -> i32

var jarType: usize = 0
var textType: usize = 0
var dbType: usize = 0
var privateOffset: i32 = 0
var specs: [3]usize = undefined
var sigChanged: u32 = 0

pub fn jarTypeGet() -> usize {
    if c.onceEnter(&jarType) {
        const t = c.defineType(c.T_OBJECT, "SoupCookieJar", CLASS_SIZE, @intFromPtr(__mlx_soup_cookie_jar_class_init), 24, @intFromPtr(__mlx_soup_cookie_jar_init), 0)
        privateOffset = c.addPrivate(t, 8)
        feature.implementFeature(t, @intFromPtr(__mlx_soup_cookie_jar_feature_init))
        c.onceLeave(&jarType, t)
    }
    return jarType
}

export fn soup_cookie_jar_get_type() -> usize { return jarTypeGet() }

fn priv(jar: usize) -> usize { return m.getWord(c.privateAt(jar, privateOffset)) }

export fn __mlx_soup_cookie_jar_init(jar: usize, class: usize) -> void {
    const p = m.alloc(P_SIZE)
    m.putWord(c.privateAt(jar, privateOffset), p)
    m.putWord(p + P_DOMAINS, g.g_hash_table_new_full(@intFromPtr(__mlx_soup_case_hash), @intFromPtr(__mlx_soup_case_equal), @intFromPtr(g_free), 0))
    m.putWord(p + P_SERIALS, g.g_hash_table_new_full(0, 0, 0, 0))
    m.putI32(p + P_POLICY, ACCEPT_ALWAYS)
}

export fn __mlx_soup_cookie_jar_constructed(jar: usize) -> void {
    m.putI32(priv(jar) + P_CONSTRUCTED, 1)
    c.chainUp(g.g_type_class_ref(jarTypeGet()), 72, jar)
}

export fn __mlx_soup_cookie_jar_finalize(jar: usize) -> void {
    const p = priv(jar)
    const iter = m.alloc(48)
    const cells = m.alloc(16)
    g.g_hash_table_iter_init(iter, m.getWord(p + P_DOMAINS))
    while g.g_hash_table_iter_next(iter, cells, cells + 8) != 0 { g.g_slist_free_full(m.getWord(cells + 8), @intFromPtr(soup_cookie_free)) }
    m.release(cells)
    m.release(iter)
    g.g_hash_table_destroy(m.getWord(p + P_DOMAINS))
    g.g_hash_table_destroy(m.getWord(p + P_SERIALS))
    m.release(p)
    c.chainUp(g.g_type_class_ref(jarTypeGet()), 48, jar)
}

export fn __mlx_soup_cookie_jar_set_property(jar: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_READ_ONLY { m.putI32(priv(jar) + P_READ_ONLY, g.g_value_get_boolean(value)) }
    if id == PROP_ACCEPT_POLICY { m.putI32(priv(jar) + P_POLICY, g.g_value_get_enum(value)) }
}

export fn __mlx_soup_cookie_jar_get_property(jar: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_READ_ONLY { g.g_value_set_boolean(value, m.getI32(priv(jar) + P_READ_ONLY)) }
    if id == PROP_ACCEPT_POLICY { g.g_value_set_enum(value, m.getI32(priv(jar) + P_POLICY)) }
}

export fn __mlx_soup_cookie_jar_real_is_persistent(jar: usize) -> i32 { return 0 }

export fn __mlx_soup_cookie_jar_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &privateOffset)
    m.putWord(class + 24, @intFromPtr(__mlx_soup_cookie_jar_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_cookie_jar_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_cookie_jar_finalize))
    m.putWord(class + 72, @intFromPtr(__mlx_soup_cookie_jar_constructed))
    m.putWord(class + C_IS_PERSISTENT, @intFromPtr(__mlx_soup_cookie_jar_real_is_persistent))
    sigChanged = c.signal(class, "changed", c.RUN_FIRST, @intCast(u32, C_CHANGED), 0, c.T_NONE, 2, soup_cookie_get_type(), soup_cookie_get_type(), 0, 0)
    specs[PROP_READ_ONLY] = c.booleanProperty(class, PROP_READ_ONLY, "read-only", false, c.READWRITE | c.CONSTRUCT_ONLY)
    specs[PROP_ACCEPT_POLICY] = c.enumProperty(class, PROP_ACCEPT_POLICY, "accept-policy", enums.cookieJarAcceptPolicyTypeGet(), ACCEPT_ALWAYS, c.READWRITE)
}

export fn soup_cookie_jar_new() -> usize { return g.g_object_new(jarTypeGet(), 0) }

fn changed(jar: usize, old: usize, new: usize) -> void {
    const p = priv(jar)
    if old != 0 && old != new { _ = g.g_hash_table_remove(m.getWord(p + P_SERIALS), old) }
    if new != 0 {
        m.put32(p + P_SERIAL, m.get32(p + P_SERIAL) + 1)
        _ = g.g_hash_table_insert(m.getWord(p + P_SERIALS), new, @intCast(usize, m.get32(p + P_SERIAL)))
    }
    if m.getI32(p + P_READ_ONLY) != 0 || m.getI32(p + P_CONSTRUCTED) == 0 { return }
    c.emitTwo(jar, sigChanged, soup_cookie_get_type(), old, soup_cookie_get_type(), new)
}

// RFC 6265 5.4: longer paths first, then the cookies that came first.
export fn __mlx_soup_cookie_jar_compare(a: usize, b: usize, jar: usize) -> i32 {
    const alen = if cookie.path(a) != 0 { m.cLength(cookie.path(a)) } else { 0 }
    const blen = if cookie.path(b) != 0 { m.cLength(cookie.path(b)) } else { 0 }
    if alen != blen { return @intCast(i32, @intCast(i64, blen) - @intCast(i64, alen)) }
    const serials = m.getWord(priv(jar) + P_SERIALS)
    const aserial = @intCast(i64, g.g_hash_table_lookup(serials, a))
    const bserial = @intCast(i64, g.g_hash_table_lookup(serials, b))
    return @intCast(i32, aserial - bserial)
}

fn validForSameSite(ck: usize, safeMethod: bool, uri: usize, topLevel: usize, cookieUri: usize, topLevelNavigation: bool, forHttp: bool) -> bool {
    const policy = cookie.sameSite(ck)
    if policy == cookie.SAME_SITE_NONE { return true }
    if topLevel == 0 { return true }
    if policy == cookie.SAME_SITE_LAX && topLevelNavigation && (safeMethod || !forHttp) { return true }
    if topLevelNavigation && cookieUri == 0 { return false }
    const other = if cookieUri != 0 { cookieUri } else { topLevel }
    return cookies.hostMatches(m.cSlice(g.g_uri_get_host(other)), m.cSlice(g.g_uri_get_host(uri)))
}

fn getCookies(jar: usize, uri: usize, topLevel: usize, siteForCookies: usize, safeMethod: bool, forHttp: bool, topLevelNavigation: bool, copy: bool) -> usize {
    const p = priv(jar)
    const host = g.g_uri_get_host(uri)
    if host == 0 { return 0 }
    var result: usize = 0
    var remove: usize = 0
    // ".host", then each parent domain with its dot and without.
    var t = m.text()
    if m.get8(host) != 0 { m.pushByte(&t, 46) }
    m.pushC(&t, host)
    const domain = m.finish(&t)
    const domainLength = m.cLength(domain)
    var cur: usize = domain
    var hasNext = m.get8(host) != 0
    var next: usize = domain + 1
    c.lock(m.word64(p + P_MUTEX))
    while true {
        const domains = m.getWord(p + P_DOMAINS)
        var head = g.g_hash_table_lookup(domains, cur)
        var at = head
        while at != 0 {
            const following = m.getWord(at + 8)
            const ck = m.getWord(at)
            const expires = cookie.expires(ck)
            if expires != 0 && misc.isPast(expires) {
                remove = g.g_slist_append(remove, ck)
                head = g_slist_delete_link(head, at)
                _ = g.g_hash_table_insert(domains, m.dup(cur), head)
            } else if soup_cookie_applies_to_uri(ck, uri) != 0 && validForSameSite(ck, safeMethod, uri, topLevel, siteForCookies, topLevelNavigation, forHttp) && (forHttp || !cookie.httpOnly(ck)) {
                result = g.g_slist_append(result, if copy { soup_cookie_copy(ck) } else { ck })
            }
            at = following
        }
        if !hasNext { break }
        cur = next
        // The next parent: from the next dot on.
        var scan = cur + 1
        hasNext = false
        while scan < domain + domainLength {
            if m.get8(scan) == 46 {
                next = scan
                hasNext = true
                break
            }
            scan += 1
        }
    }
    m.release(domain)
    var r = remove
    while r != 0 {
        const ck = m.getWord(r)
        changed(jar, ck, 0)
        soup_cookie_free(ck)
        r = m.getWord(r + 8)
    }
    g.g_slist_free(remove)
    c.unlock(m.word64(p + P_MUTEX))
    return g_slist_sort_with_data(result, @intFromPtr(__mlx_soup_cookie_jar_compare), jar)
}

export fn soup_cookie_jar_get_cookies(jar: usize, uri: usize, for_http: i32) -> usize {
    const list = getCookies(jar, uri, 0, 0, true, for_http != 0, false, false)
    if list == 0 { return 0 }
    const header = soup_cookies_to_cookie_header(list)
    g.g_slist_free(list)
    if m.get8(header) == 0 {
        g.g_free(header)
        return 0
    }
    return header
}

export fn soup_cookie_jar_get_cookie_list(jar: usize, uri: usize, for_http: i32) -> usize { return getCookies(jar, uri, 0, 0, true, for_http != 0, false, true) }

export fn soup_cookie_jar_get_cookie_list_with_same_site_info(jar: usize, uri: usize, top_level: usize, site_for_cookies: usize, for_http: i32, is_safe_method: i32, is_top_level_navigation: i32) -> usize {
    return getCookies(jar, uri, top_level, site_for_cookies, is_safe_method != 0, for_http != 0, is_top_level_navigation != 0, true)
}

fn normalizeDomain(domain: usize) -> usize {
    if domain != 0 && m.get8(domain) == 46 { return domain + 1 }
    return domain
}

fn isThirdParty(jar: usize, ck: usize, firstParty: usize, policy: i32) -> bool {
    if policy != ACCEPT_NO_THIRD_PARTY && policy != ACCEPT_GRANDFATHERED_THIRD_PARTY { return false }
    if firstParty == 0 { return true }
    const firstHost = g.g_uri_get_host(firstParty)
    if firstHost == 0 { return true }
    var cookieBase = tld.baseDomain(normalizeDomain(cookie.domain(ck)), 0)
    if cookieBase == 0 { cookieBase = cookie.domain(ck) }
    var firstBase = tld.baseDomain(firstHost, 0)
    if firstBase == 0 { firstBase = firstHost }
    if cookies.hostMatches(m.cSlice(cookieBase), m.cSlice(firstBase)) { return false }
    if policy == ACCEPT_NO_THIRD_PARTY { return true }
    const p = priv(jar)
    c.lock(m.word64(p + P_MUTEX))
    const known = g.g_hash_table_lookup(m.getWord(p + P_DOMAINS), cookie.domain(ck)) != 0
    c.unlock(m.word64(p + P_MUTEX))
    return !known
}

fn hasControl(text: usize) -> bool {
    for ch in m.cSlice(text) {
        if (ch < 32 && ch != 9) || ch == 127 { return true }
    }
    return false
}

fn hasPrefixIgnoringCase(text: usize, prefix: []const u8) -> bool {
    const t = m.cSlice(text)
    if t.length < prefix.length { return false }
    return http.equalsIgnoringCase(t[0..prefix.length], prefix)
}

pub fn addCookieFull(jar: usize, ck: usize, uri: usize, firstParty: usize) -> void {
    const p = priv(jar)
    const domain = cookie.domain(ck)
    if g.g_hostname_is_ip_address(domain) == 0 && tld.isPublicSuffix(domain) {
        soup_cookie_free(ck)
        return
    }
    if firstParty != 0 {
        const policy = m.getI32(p + P_POLICY)
        if policy == ACCEPT_NEVER || isThirdParty(jar, ck, firstParty, policy) {
            soup_cookie_free(ck)
            return
        }
    }
    if uri != 0 && !misc.isHttps(uri) && cookie.secure(ck) {
        soup_cookie_free(ck)
        return
    }
    if cookie.sameSite(ck) == cookie.SAME_SITE_NONE && !cookie.secure(ck) {
        soup_cookie_free(ck)
        return
    }
    if hasPrefixIgnoringCase(cookie.name(ck), "__Secure-") && !cookie.secure(ck) {
        soup_cookie_free(ck)
        return
    }
    if hasPrefixIgnoringCase(cookie.name(ck), "__Host-") {
        if !cookie.secure(ck) || !m.same(m.cSlice(cookie.path(ck)), "/") || m.get8(domain) == 46 {
            soup_cookie_free(ck)
            return
        }
    }
    if hasControl(cookie.name(ck)) || hasControl(cookie.value(ck)) || m.cLength(cookie.name(ck)) > 4096 || m.cLength(cookie.value(ck)) > 4096 {
        soup_cookie_free(ck)
        return
    }
    c.lock(m.word64(p + P_MUTEX))
    const domains = m.getWord(p + P_DOMAINS)
    var list = g.g_hash_table_lookup(domains, domain)
    var at = list
    var last: usize = 0
    while at != 0 {
        const old = m.getWord(at)
        if m.cEqual(cookie.name(ck), cookie.name(old)) && c.cEquals(cookie.path(ck), cookie.path(old)) {
            const expires = cookie.expires(ck)
            if cookie.secure(old) && uri != 0 && !misc.isHttps(uri) {
                soup_cookie_free(ck)
            } else if expires != 0 && misc.isPast(expires) {
                list = g_slist_delete_link(list, at)
                _ = g.g_hash_table_insert(domains, m.dup(domain), list)
                changed(jar, old, 0)
                soup_cookie_free(old)
                soup_cookie_free(ck)
            } else {
                m.putWord(at, ck)
                changed(jar, old, ck)
                soup_cookie_free(old)
            }
            c.unlock(m.word64(p + P_MUTEX))
            return
        }
        last = at
        at = m.getWord(at + 8)
    }
    const expires = cookie.expires(ck)
    if expires != 0 && misc.isPast(expires) {
        soup_cookie_free(ck)
        c.unlock(m.word64(p + P_MUTEX))
        return
    }
    if last != 0 {
        m.putWord(last + 8, g.g_slist_append(0, ck))
    } else {
        _ = g.g_hash_table_insert(domains, m.dup(domain), g.g_slist_append(0, ck))
    }
    changed(jar, 0, ck)
    c.unlock(m.word64(p + P_MUTEX))
}

export fn soup_cookie_jar_add_cookie_full(jar: usize, ck: usize, uri: usize, first_party: usize) -> void { addCookieFull(jar, ck, uri, first_party) }
export fn soup_cookie_jar_add_cookie(jar: usize, ck: usize) -> void { addCookieFull(jar, ck, 0, 0) }
export fn soup_cookie_jar_add_cookie_with_first_party(jar: usize, first_party: usize, ck: usize) -> void { addCookieFull(jar, ck, 0, first_party) }

export fn soup_cookie_jar_set_cookie(jar: usize, uri: usize, text: usize) -> void {
    if g.g_uri_get_host(uri) == 0 { return }
    const policy = m.getI32(priv(jar) + P_POLICY)
    if policy == ACCEPT_NEVER { return }
    if policy == ACCEPT_NO_THIRD_PARTY || policy == ACCEPT_GRANDFATHERED_THIRD_PARTY {
        c.critical("soup_cookie_jar_set_cookie: assertion 'priv->accept_policy != SOUP_COOKIE_JAR_ACCEPT_NO_THIRD_PARTY && priv->accept_policy != SOUP_COOKIE_JAR_ACCEPT_GRANDFATHERED_THIRD_PARTY' failed")
        return
    }
    const ck = soup_cookie_parse(text, uri)
    if ck != 0 { addCookieFull(jar, ck, uri, 0) }
}

export fn soup_cookie_jar_set_cookie_with_first_party(jar: usize, uri: usize, first_party: usize, text: usize) -> void {
    if g.g_uri_get_host(uri) == 0 { return }
    const ck = soup_cookie_parse(text, uri)
    if ck != 0 { addCookieFull(jar, ck, uri, first_party) }
}

export fn __mlx_soup_cookie_jar_set_cookie_header(msg: usize, jar: usize) -> void {
    if m.getI32(priv(jar) + P_POLICY) == ACCEPT_NEVER { return }
    const list = soup_cookies_from_response(msg)
    const firstParty = message.firstParty(msg)
    const uri = message.uri(msg)
    var at = list
    while at != 0 {
        addCookieFull(jar, m.getWord(at), uri, firstParty)
        at = m.getWord(at + 8)
    }
    g.g_slist_free(list)
}

export fn __mlx_soup_cookie_jar_starting(msg: usize, jar: usize) -> void {
    const safe = message.methodIs(msg, "GET") || message.methodIs(msg, "HEAD") || message.methodIs(msg, "OPTIONS") || message.methodIs(msg, "PROPFIND") || message.methodIs(msg, "TRACE")
    const list = getCookies(jar, message.uri(msg), message.firstParty(msg), message.siteForCookies(msg), safe, true, message.isTopLevelNavigation(msg), true)
    if list != 0 {
        const header = soup_cookies_to_cookie_header(list)
        soup_message_headers_replace(message.requestHeaders(msg), m.literal("Cookie"), header)
        g.g_free(header)
        g.g_slist_free_full(list, @intFromPtr(soup_cookie_free))
    } else {
        soup_message_headers_remove(message.requestHeaders(msg), m.literal("Cookie"))
    }
}

export fn __mlx_soup_cookie_jar_request_queued(jar: usize, msg: usize) -> void {
    _ = g.g_signal_connect_data(msg, m.literal("starting"), @intFromPtr(__mlx_soup_cookie_jar_starting), jar, 0, 0)
    _ = soup_message_add_header_handler(msg, m.literal("got-headers"), m.literal("Set-Cookie"), @intFromPtr(__mlx_soup_cookie_jar_set_cookie_header), jar)
    _ = soup_message_add_status_code_handler(msg, m.literal("got-informational"), 101, @intFromPtr(__mlx_soup_cookie_jar_set_cookie_header), jar)
}

export fn __mlx_soup_cookie_jar_request_unqueued(jar: usize, msg: usize) -> void { _ = g_signal_handlers_disconnect_matched(msg, 16, 0, 0, 0, 0, jar) }

export fn __mlx_soup_cookie_jar_feature_init(iface: usize, data: usize) -> void {
    m.putWord(iface + feature.REQUEST_QUEUED, @intFromPtr(__mlx_soup_cookie_jar_request_queued))
    m.putWord(iface + feature.REQUEST_UNQUEUED, @intFromPtr(__mlx_soup_cookie_jar_request_unqueued))
}

export fn soup_cookie_jar_all_cookies(jar: usize) -> usize {
    const p = priv(jar)
    var result: usize = 0
    c.lock(m.word64(p + P_MUTEX))
    const iter = m.alloc(48)
    const cells = m.alloc(16)
    g.g_hash_table_iter_init(iter, m.getWord(p + P_DOMAINS))
    while g.g_hash_table_iter_next(iter, cells, cells + 8) != 0 {
        var at = m.getWord(cells + 8)
        while at != 0 {
            result = g.g_slist_prepend(result, soup_cookie_copy(m.getWord(at)))
            at = m.getWord(at + 8)
        }
    }
    m.release(cells)
    m.release(iter)
    c.unlock(m.word64(p + P_MUTEX))
    return result
}

export fn soup_cookie_jar_delete_cookie(jar: usize, ck: usize) -> void {
    const p = priv(jar)
    c.lock(m.word64(p + P_MUTEX))
    const domains = m.getWord(p + P_DOMAINS)
    var list = g.g_hash_table_lookup(domains, cookie.domain(ck))
    var at = list
    while at != 0 {
        const old = m.getWord(at)
        if soup_cookie_equal(ck, old) != 0 {
            list = g_slist_delete_link(list, at)
            _ = g.g_hash_table_insert(domains, m.dup(cookie.domain(ck)), list)
            changed(jar, old, 0)
            soup_cookie_free(old)
            c.unlock(m.word64(p + P_MUTEX))
            return
        }
        at = m.getWord(at + 8)
    }
    c.unlock(m.word64(p + P_MUTEX))
}

export fn soup_cookie_jar_get_accept_policy(jar: usize) -> i32 { return m.getI32(priv(jar) + P_POLICY) }

export fn soup_cookie_jar_set_accept_policy(jar: usize, policy: i32) -> void {
    const p = priv(jar)
    if m.getI32(p + P_POLICY) == policy { return }
    m.putI32(p + P_POLICY, policy)
    g.g_object_notify_by_pspec(jar, specs[PROP_ACCEPT_POLICY])
}

export fn soup_cookie_jar_is_persistent(jar: usize) -> i32 {
    const f = m.getWord(m.getWord(jar) + C_IS_PERSISTENT)
    if f == 0 { return 0 }
    const call: BoolFn = unsafe { @ptrFromInt(BoolFn, f) }
    return call(jar)
}

// ---------------------------------------------------------------------------
// The text jar (Mozilla's cookies.txt) and the DB jar (the same form here)

fn fileName(jar: usize) -> usize { return m.getWord(m.getWord(jar + 24)) }

fn sameSiteOf(text: []const u8) -> i32 {
    if m.same(text, "Lax") { return cookie.SAME_SITE_LAX }
    if m.same(text, "Strict") { return cookie.SAME_SITE_STRICT }
    return cookie.SAME_SITE_NONE
}

fn sameSiteName(policy: i32) -> []const u8 {
    if policy == cookie.SAME_SITE_STRICT { return "Strict" }
    if policy == cookie.SAME_SITE_LAX { return "Lax" }
    return "None"
}

fn field(line: []const u8, index: usize) -> []const u8 {
    var at: usize = 0
    var count: usize = 0
    while count < index {
        while at < line.length && line[at] != 9 { at += 1 }
        if at >= line.length { return line[line.length..line.length] }
        at += 1
        count += 1
    }
    var end = at
    while end < line.length && line[end] != 9 { end += 1 }
    return line[at..end]
}

fn fieldCount(line: []const u8) -> usize {
    var count: usize = 1
    for ch in line {
        if ch == 9 { count += 1 }
    }
    return count
}

// A cookie of a cookies.txt line (0: a comment, or not one, or expired).
fn parseLine(lineIn: []const u8, now: i64) -> usize {
    var line = lineIn
    var httpOnly = false
    if line.length >= 10 && m.same(line[0..10], "#HttpOnly_") {
        httpOnly = true
        line = line[10..line.length]
    } else if line.length == 0 || line[0] == 35 || http.isSpace(line[0]) {
        return 0
    }
    const count = fieldCount(line)
    if count < 7 { return 0 }
    const expiresText = field(line, 4)
    var expire: i64 = 0
    for ch in expiresText {
        if ch < 48 || ch > 57 { break }
        expire = expire * 10 + @intCast(i64, ch - 48)
    }
    if now >= expire { return 0 }
    const maxAge: i32 = if expire - now <= 2147483647 { @intCast(i32, expire - now) } else { 2147483647 }
    const host = m.dupSlice(field(line, 0))
    const path = m.dupSlice(field(line, 2))
    const name = m.dupSlice(field(line, 5))
    const value = m.dupSlice(field(line, 6))
    const ck = soup_cookie_new(name, value, host, path, maxAge)
    m.release(host)
    m.release(path)
    m.release(name)
    m.release(value)
    if count == 8 { soup_cookie_set_same_site_policy(ck, sameSiteOf(field(line, 7))) }
    if !m.same(field(line, 3), "FALSE") { soup_cookie_set_secure(ck, 1) }
    if httpOnly { soup_cookie_set_http_only(ck, 1) }
    return ck
}

fn eachLine(contents: []const u8, now: i64, jar: usize, skip: usize, out: *m.Text) -> void {
    var at: usize = 0
    while at <= contents.length {
        var end = at
        while end < contents.length && contents[end] != 10 && contents[end] != 13 { end += 1 }
        const ck = parseLine(contents[at..end], now)
        if ck != 0 {
            if jar != 0 {
                addCookieFull(jar, ck, 0, 0)
            } else {
                if soup_cookie_equal(skip, ck) == 0 { writeCookie(out, ck) }
                soup_cookie_free(ck)
            }
        }
        at = end + 1
    }
}

fn load(jar: usize) -> void {
    const cells = m.alloc(16)
    if g.g_file_get_contents(fileName(jar), cells, cells + 8, 0) != 0 {
        var unused = m.text()
        eachLine(m.bytes(m.getWord(cells), m.getWord(cells + 8)), time(0), jar, 0, &unused)
        g.g_free(m.getWord(cells))
    }
    m.release(cells)
}

fn writeCookie(t: *m.Text, ck: usize) -> void {
    if cookie.httpOnly(ck) { m.pushText(t, "#HttpOnly_") }
    m.pushC(t, cookie.domain(ck))
    m.pushText(t, if m.get8(cookie.domain(ck)) == 46 { "\tTRUE\t" } else { "\tFALSE\t" })
    m.pushC(t, cookie.path(ck))
    m.pushText(t, if cookie.secure(ck) { "\tTRUE\t" } else { "\tFALSE\t" })
    m.pushDecimal(t, @bitCast(u64, g.g_date_time_to_unix(cookie.expires(ck))))
    m.pushByte(t, 9)
    m.pushC(t, cookie.name(ck))
    m.pushByte(t, 9)
    m.pushC(t, cookie.value(ck))
    m.pushByte(t, 9)
    m.pushText(t, sameSiteName(cookie.sameSite(ck)))
    m.pushByte(t, 10)
}

export fn __mlx_soup_cookie_jar_text_changed(jar: usize, old: usize, new: usize) -> void {
    const name = fileName(jar)
    const cells = m.alloc(16)
    const exists = g.g_file_get_contents(name, cells, cells + 8, 0) != 0
    var t = m.text()
    if exists {
        const contents = m.bytes(m.getWord(cells), m.getWord(cells + 8))
        if old != 0 {
            eachLine(contents, time(0), 0, old, &t)
        } else {
            m.pushBytes(&t, m.getWord(cells), m.getWord(cells + 8))
        }
        g.g_free(m.getWord(cells))
    } else {
        m.pushText(&t, "# HTTP Cookie File\n# http://www.netscape.com/newsref/std/cookie_spec.html\n# This is a generated file!  Do not edit.\n# To delete cookies, use the Cookie Manager.\n\n")
    }
    if new != 0 && cookie.expires(new) != 0 { writeCookie(&t, new) }
    _ = g.g_file_set_contents(name, t.address, @intCast(i64, t.length), 0)
    m.dispose(&t)
    m.release(cells)
}

export fn __mlx_soup_cookie_jar_text_is_persistent(jar: usize) -> i32 { return 1 }

export fn __mlx_soup_cookie_jar_text_init(jar: usize, class: usize) -> void { m.putWord(jar + 24, m.alloc(8)) }

export fn __mlx_soup_cookie_jar_text_finalize(jar: usize) -> void {
    m.release(fileName(jar))
    m.release(m.getWord(jar + 24))
    c.chainUp(g.g_type_class_ref(m.getWord(m.getWord(jar))), 48, jar)
}

export fn __mlx_soup_cookie_jar_text_set_property(jar: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_FILENAME {
        c.replaceString(m.getWord(jar + 24), g.g_value_get_string(value))
        load(jar)
    }
}

export fn __mlx_soup_cookie_jar_text_get_property(jar: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_FILENAME { g.g_value_set_string(value, fileName(jar)) }
}

export fn __mlx_soup_cookie_jar_text_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_soup_cookie_jar_text_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_cookie_jar_text_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_cookie_jar_text_finalize))
    m.putWord(class + C_IS_PERSISTENT, @intFromPtr(__mlx_soup_cookie_jar_text_is_persistent))
    m.putWord(class + C_CHANGED, @intFromPtr(__mlx_soup_cookie_jar_text_changed))
    _ = c.stringProperty(class, PROP_FILENAME, "filename", c.READWRITE | c.CONSTRUCT_ONLY)
}

fn fileJarTypes() -> void {
    if c.onceEnter(&textType) {
        c.onceLeave(&textType, c.defineType(jarTypeGet(), "SoupCookieJarText", CLASS_SIZE, @intFromPtr(__mlx_soup_cookie_jar_text_class_init), 32, @intFromPtr(__mlx_soup_cookie_jar_text_init), c.FINAL))
    }
    if c.onceEnter(&dbType) {
        c.onceLeave(&dbType, c.defineType(jarTypeGet(), "SoupCookieJarDB", CLASS_SIZE, @intFromPtr(__mlx_soup_cookie_jar_text_class_init), 32, @intFromPtr(__mlx_soup_cookie_jar_text_init), c.FINAL))
    }
}

export fn soup_cookie_jar_text_get_type() -> usize {
    fileJarTypes()
    return textType
}

export fn soup_cookie_jar_db_get_type() -> usize {
    fileJarTypes()
    return dbType
}

// Made as g_object_new with "filename" and "read-only" would make it:
// the file loaded while the jar is being constructed (no "changed").
fn newFileJar(t: usize, filename: usize, read_only: i32) -> usize {
    const jar = g.g_object_new(t, 0)
    const p = priv(jar)
    m.putI32(p + P_CONSTRUCTED, 0)
    m.putI32(p + P_READ_ONLY, if read_only != 0 { 1 } else { 0 })
    c.replaceString(m.getWord(jar + 24), filename)
    load(jar)
    m.putI32(p + P_CONSTRUCTED, 1)
    return jar
}

export fn soup_cookie_jar_text_new(filename: usize, read_only: i32) -> usize {
    fileJarTypes()
    return newFileJar(textType, filename, read_only)
}

export fn soup_cookie_jar_db_new(filename: usize, read_only: i32) -> usize {
    fileJarTypes()
    return newFileJar(dbType, filename, read_only)
}
