// soup-hsts-policy.h, soup-hsts-enforcer.h, soup-hsts-enforcer-db.h: HTTP
// Strict Transport Security (RFC 6797) over std.http.hsts, which keeps the
// policies and decides which hosts go over https. A SoupHSTSPolicy is a
// domain, its max-age and expiry and whether it covers subdomains, in
// libsoup's C layout (a std view is made of it for each call); the
// enforcer (a session feature) is the GObject around a std enforcer,
// learning policies from https responses' Strict-Transport-Security
// headers and sending http:// messages to known hosts over https://
// instead ("hsts-enforced"), as libsoup does. SoupHSTSEnforcerDB keeps
// its policies in its file (this library has no SQLite: std.http.hsts's
// text form, a line per policy).
//
// A policy: the domain (0), max-age (8), expiry (16, a GDateTime; 0 for a
// session policy), whether it covers subdomains (24). An enforcer's
// private data is a pointer to a record of the session (0), the std
// enforcer (8, a pointer to a std.http.hsts.Enforcer in C memory) and a
// mutex (16); a DB enforcer adds (24) a record of its file name (0).
//
// The class (SoupHSTSEnforcerClass): is_persistent (136),
// has_valid_policy (144), changed (152).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const misc = @import("./misc.mlx")
const message = @import("./message.mlx")
const feature = @import("./feature.mlx")
const headers = @import("./headers.mlx")
const cookie = @import("./cookie.mlx")
const http = @import("std.http.headers")
const hsts = @import("std.http.hsts")

extern("c") fn soup_message_add_header_handler(msg: usize, signal: usize, header: usize, callback: usize, data: usize) -> u32
extern("c") fn soup_uri_copy(uri: usize, first: i32, a: usize, b: i32, c_: usize, end: i32) -> usize
extern("c") fn g_signal_handlers_disconnect_matched(instance: usize, mask: i32, id: u32, detail: u32, closure: usize, func: usize, data: usize) -> u32
extern("c") fn g_list_prepend(list: usize, data: usize) -> usize
extern("c") fn __mlx_soup_session_cancel_message(session: usize, msg: usize) -> void

const P_DOMAIN: usize = 0
const P_MAX_AGE: usize = 8
const P_EXPIRES: usize = 16
const P_SUBDOMAINS: usize = 24
const P_SIZE: usize = 32

const E_SESSION: usize = 0
const E_STD: usize = 8
const E_MUTEX: usize = 16
const E_SIZE: usize = 24

const C_IS_PERSISTENT: usize = 136
const C_HAS_VALID_POLICY: usize = 144
const C_CHANGED: usize = 152
const CLASS_SIZE: usize = 192

pub const BoolFn = fn(usize) -> i32
pub const ValidFn = fn(usize, usize) -> i32

var policyType: usize = 0
var enforcerType: usize = 0
var dbType: usize = 0
var privateOffset: i32 = 0
var sigChanged: u32 = 0

// ---------------------------------------------------------------------------
// Policies

export fn soup_hsts_policy_get_type() -> usize {
    if c.onceEnter(&policyType) {
        c.onceLeave(&policyType, g.g_boxed_type_register_static(m.literal("SoupHSTSPolicy"), @intFromPtr(soup_hsts_policy_copy), @intFromPtr(soup_hsts_policy_free)))
    }
    return policyType
}

// A std view of a policy record (its domain borrowed).
fn viewOf(policy: usize) -> hsts.Policy {
    const domain = m.cSlice(m.getWord(policy + P_DOMAIN))
    const expires = m.getWord(policy + P_EXPIRES)
    if expires == 0 { return hsts.sessionPolicy(domain, m.getI32(policy + P_SUBDOMAINS) != 0) }
    return hsts.policyWithExpiry(domain, m.getWord(policy + P_MAX_AGE), g.g_date_time_to_unix(expires), m.getI32(policy + P_SUBDOMAINS) != 0)
}

// A policy record of a std policy (the caller's to free).
fn fromStd(p: *const hsts.Policy) -> usize {
    const policy = m.alloc(P_SIZE)
    m.putWord(policy + P_DOMAIN, c.dup(p.*.domain))
    m.putWord(policy + P_MAX_AGE, p.*.maxAge)
    if p.*.hasExpires { m.putWord(policy + P_EXPIRES, g.g_date_time_new_from_unix_utc(p.*.expires)) }
    m.putI32(policy + P_SUBDOMAINS, if p.*.includeSubdomains { 1 } else { 0 })
    return policy
}

export fn soup_hsts_policy_copy(policy: usize) -> usize {
    const copy = m.alloc(P_SIZE)
    m.putWord(copy + P_DOMAIN, m.dup(m.getWord(policy + P_DOMAIN)))
    m.putWord(copy + P_MAX_AGE, m.getWord(policy + P_MAX_AGE))
    if m.getWord(policy + P_EXPIRES) != 0 { m.putWord(copy + P_EXPIRES, g.g_date_time_ref(m.getWord(policy + P_EXPIRES))) }
    m.putI32(copy + P_SUBDOMAINS, m.getI32(policy + P_SUBDOMAINS))
    return copy
}

export fn soup_hsts_policy_free(policy: usize) -> void {
    if policy == 0 { return }
    m.release(m.getWord(policy + P_DOMAIN))
    if m.getWord(policy + P_EXPIRES) != 0 { g.g_date_time_unref(m.getWord(policy + P_EXPIRES)) }
    m.release(policy)
}

export fn soup_hsts_policy_equal(a: usize, b: usize) -> i32 {
    const one = viewOf(a)
    const two = viewOf(b)
    return if hsts.equal(&one, &two) { 1 } else { 0 }
}

export fn soup_hsts_policy_new_full(domain: usize, max_age: u64, expires: usize, include_subdomains: i32) -> usize {
    const policy = m.alloc(P_SIZE)
    m.putWord(policy + P_DOMAIN, m.dup(domain))
    m.putWord(policy + P_MAX_AGE, max_age)
    if expires != 0 { m.putWord(policy + P_EXPIRES, g.g_date_time_ref(expires)) }
    m.putI32(policy + P_SUBDOMAINS, if include_subdomains != 0 { 1 } else { 0 })
    return policy
}

// SOUP_HSTS_POLICY_MAX_AGE_PAST (0) expires at 1970, else max-age from now.
export fn soup_hsts_policy_new(domain: usize, max_age: u64, include_subdomains: i32) -> usize {
    const p = hsts.policy(m.cSlice(domain), max_age, include_subdomains != 0, time(0))
    return fromStd(&p)
}

extern("c") fn time(t: usize) -> i64

export fn soup_hsts_policy_new_session_policy(domain: usize, include_subdomains: i32) -> usize { return soup_hsts_policy_new_full(domain, 0, 0, include_subdomains) }

// The first Strict-Transport-Security header of the response, read
// strictly (std.http.hsts).
export fn soup_hsts_policy_new_from_response(msg: usize) -> usize {
    const iter = m.alloc(24)
    const cells = m.alloc(16)
    headers.iterInit(iter, message.responseHeaders(msg))
    var policy: usize = 0
    while headers.iterNext(iter, cells, cells + 8) {
        if !http.equalsIgnoringCase(m.cSlice(m.getWord(cells)), "Strict-Transport-Security") { continue }
        var p: hsts.Policy = undefined
        if hsts.parseHeader(m.cSlice(m.getWord(cells + 8)), m.cSlice(g.g_uri_get_host(message.uri(msg))), time(0), &p) { policy = fromStd(&p) }
        break
    }
    m.release(cells)
    m.release(iter)
    return policy
}

export fn soup_hsts_policy_get_domain(policy: usize) -> usize { return m.getWord(policy + P_DOMAIN) }
export fn soup_hsts_policy_is_expired(policy: usize) -> i32 { return if isExpired(policy) { 1 } else { 0 } }
export fn soup_hsts_policy_includes_subdomains(policy: usize) -> i32 { return m.getI32(policy + P_SUBDOMAINS) }
export fn soup_hsts_policy_is_session_policy(policy: usize) -> i32 { return if m.getWord(policy + P_EXPIRES) == 0 { 1 } else { 0 } }
export fn soup_hsts_policy_get_expires(policy: usize) -> usize { return m.getWord(policy + P_EXPIRES) }
export fn soup_hsts_policy_get_max_age(policy: usize) -> u64 { return m.getWord(policy + P_MAX_AGE) }

fn isExpired(policy: usize) -> bool {
    const p = viewOf(policy)
    return hsts.isExpired(&p, cookie.nowForExpiry())
}

fn isSession(policy: usize) -> bool { return m.getWord(policy + P_EXPIRES) == 0 }

// ---------------------------------------------------------------------------
// The enforcer

pub fn enforcerTypeGet() -> usize {
    if c.onceEnter(&enforcerType) {
        const t = c.defineType(c.T_OBJECT, "SoupHSTSEnforcer", CLASS_SIZE, @intFromPtr(__mlx_soup_hsts_class_init), 24, @intFromPtr(__mlx_soup_hsts_init), 0)
        privateOffset = c.addPrivate(t, 8)
        feature.implementFeature(t, @intFromPtr(__mlx_soup_hsts_feature_init))
        c.onceLeave(&enforcerType, t)
    }
    return enforcerType
}

export fn soup_hsts_enforcer_get_type() -> usize { return enforcerTypeGet() }

fn priv(enforcer: usize) -> usize { return m.getWord(c.privateAt(enforcer, privateOffset)) }

fn stdEnforcer(enforcer: usize) -> *hsts.Enforcer { return unsafe { @ptrFromInt(*hsts.Enforcer, m.getWord(priv(enforcer) + E_STD)) } }

// The std enforcer tells of each change with its own policies; the
// signal carries policy records made of them for the emission.
fn stdChanged(context: usize, old: ?*const hsts.Policy, new: ?*const hsts.Policy) -> void {
    const oldRecord = if old != null { fromStd(old.?) } else { 0 }
    const newRecord = if new != null { fromStd(new.?) } else { 0 }
    c.emitTwo(context, sigChanged, soup_hsts_policy_get_type(), oldRecord, soup_hsts_policy_get_type(), newRecord)
    soup_hsts_policy_free(oldRecord)
    soup_hsts_policy_free(newRecord)
}

export fn __mlx_soup_hsts_init(enforcer: usize, class: usize) -> void {
    const p = m.alloc(E_SIZE)
    m.putWord(c.privateAt(enforcer, privateOffset), p)
    const std = m.alloc(@sizeOf(hsts.Enforcer))
    m.putWord(p + E_STD, std)
    const e: *hsts.Enforcer = unsafe { @ptrFromInt(*hsts.Enforcer, std) }
    hsts.init(e, m.stdAllocator())
    hsts.onChanged(e, stdChanged, enforcer)
}

export fn __mlx_soup_hsts_finalize(enforcer: usize) -> void {
    const p = priv(enforcer)
    hsts.deinit(stdEnforcer(enforcer))
    m.release(m.getWord(p + E_STD))
    m.release(p)
    c.chainUp(g.g_type_class_ref(enforcerTypeGet()), 48, enforcer)
}

export fn __mlx_soup_hsts_real_is_persistent(enforcer: usize) -> i32 { return 0 }

export fn __mlx_soup_hsts_real_has_valid_policy(enforcer: usize, domain: usize) -> i32 {
    return if hsts.hasValidPolicy(stdEnforcer(enforcer), m.cSlice(domain), cookie.nowForExpiry()) { 1 } else { 0 }
}

export fn __mlx_soup_hsts_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &privateOffset)
    m.putWord(class + 48, @intFromPtr(__mlx_soup_hsts_finalize))
    m.putWord(class + C_IS_PERSISTENT, @intFromPtr(__mlx_soup_hsts_real_is_persistent))
    m.putWord(class + C_HAS_VALID_POLICY, @intFromPtr(__mlx_soup_hsts_real_has_valid_policy))
    sigChanged = c.signal(class, "changed", c.RUN_FIRST, @intCast(u32, C_CHANGED), 0, c.T_NONE, 2, soup_hsts_policy_get_type(), soup_hsts_policy_get_type(), 0, 0)
}

export fn soup_hsts_enforcer_new() -> usize { return g.g_object_new(enforcerTypeGet(), 0) }

pub fn setPolicy(enforcer: usize, policy: usize) -> void {
    const p = priv(enforcer)
    c.lock(m.word64(p + E_MUTEX))
    const view = viewOf(policy)
    hsts.setPolicy(stdEnforcer(enforcer), &view, cookie.nowForExpiry())
    c.unlock(m.word64(p + E_MUTEX))
}

export fn soup_hsts_enforcer_set_policy(enforcer: usize, policy: usize) -> void { setPolicy(enforcer, policy) }

export fn soup_hsts_enforcer_set_session_policy(enforcer: usize, domain: usize, include_subdomains: i32) -> void {
    const policy = soup_hsts_policy_new_session_policy(domain, include_subdomains)
    setPolicy(enforcer, policy)
    soup_hsts_policy_free(policy)
}

// A subclass (WebKit's) may override has_valid_policy: asked through the
// class.
fn hasValidPolicy(enforcer: usize, domain: usize) -> bool {
    const f = m.getWord(m.getWord(enforcer) + C_HAS_VALID_POLICY)
    if f == 0 { return false }
    const call: ValidFn = unsafe { @ptrFromInt(ValidFn, f) }
    return call(enforcer, domain) != 0
}

export fn soup_hsts_enforcer_has_valid_policy(enforcer: usize, domain: usize) -> i32 { return if hasValidPolicy(enforcer, domain) { 1 } else { 0 } }

export fn soup_hsts_enforcer_is_persistent(enforcer: usize) -> i32 {
    const f = m.getWord(m.getWord(enforcer) + C_IS_PERSISTENT)
    if f == 0 { return 0 }
    const call: BoolFn = unsafe { @ptrFromInt(BoolFn, f) }
    return call(enforcer)
}

// std.http.hsts's mustEnforce, but asking the class for each domain's
// validity.
fn mustEnforce(enforcer: usize, domain: usize) -> bool {
    const p = priv(enforcer)
    c.lock(m.word64(p + E_MUTEX))
    var result = hasValidPolicy(enforcer, domain)
    var parent = hsts.superDomain(m.cSlice(domain))
    while !result && parent.length > 0 {
        if hsts.includesSubdomains(stdEnforcer(enforcer), parent) && hasValidPolicy(enforcer, @intFromPtr(parent.pointer)) { result = true }
        parent = hsts.superDomain(parent)
    }
    c.unlock(m.word64(p + E_MUTEX))
    return result
}

export fn __mlx_soup_hsts_got_sts_header(msg: usize, enforcer: usize) -> void {
    const policy = soup_hsts_policy_new_from_response(msg)
    if policy != 0 {
        setPolicy(enforcer, policy)
        soup_hsts_policy_free(policy)
    }
}

// A known host's message whose TLS certificate has errors is cancelled.
export fn __mlx_soup_hsts_known_host_starting(msg: usize, enforcer: usize) -> void {
    if message.tlsErrors(msg) != 0 { __mlx_soup_session_cancel_message(m.getWord(priv(enforcer) + E_SESSION), msg) }
}

fn preprocess(enforcer: usize, msg: usize) -> void {
    const uri = message.uri(msg)
    const host = g.g_uri_get_host(uri)
    if host == 0 || g.g_hostname_is_ip_address(host) != 0 { return }
    if misc.isHttp(uri) {
        if mustEnforce(enforcer, host) {
            var port = g.g_uri_get_port(uri)
            if port == 80 { port = 443 }
            // SOUP_URI_SCHEME 1, SOUP_URI_PORT 6, SOUP_URI_NONE 0.
            const secure = soup_uri_copy(uri, 1, m.literal("https"), 6, @intCast(usize, @bitCast(u32, port)), 0)
            message.setUri(msg, secure)
            g.g_uri_unref(secure)
            _ = g.g_signal_connect_data(msg, m.literal("starting"), @intFromPtr(__mlx_soup_hsts_known_host_starting), enforcer, 0, 0)
            message.hstsEnforced(msg)
        }
    } else if misc.isHttps(uri) {
        _ = soup_message_add_header_handler(msg, m.literal("got-headers"), m.literal("Strict-Transport-Security"), @intFromPtr(__mlx_soup_hsts_got_sts_header), enforcer)
    }
}

export fn __mlx_soup_hsts_restarted(msg: usize, enforcer: usize) -> void { preprocess(enforcer, msg) }

export fn __mlx_soup_hsts_attach(enforcer: usize, session: usize) -> void { m.putWord(priv(enforcer) + E_SESSION, session) }

export fn __mlx_soup_hsts_request_queued(enforcer: usize, msg: usize) -> void {
    _ = g.g_signal_connect_data(msg, m.literal("restarted"), @intFromPtr(__mlx_soup_hsts_restarted), enforcer, 0, 0)
    preprocess(enforcer, msg)
}

export fn __mlx_soup_hsts_request_unqueued(enforcer: usize, msg: usize) -> void { _ = g_signal_handlers_disconnect_matched(msg, 16, 0, 0, 0, 0, enforcer) }

export fn __mlx_soup_hsts_feature_init(iface: usize, data: usize) -> void {
    m.putWord(iface + feature.ATTACH, @intFromPtr(__mlx_soup_hsts_attach))
    m.putWord(iface + feature.REQUEST_QUEUED, @intFromPtr(__mlx_soup_hsts_request_queued))
    m.putWord(iface + feature.REQUEST_UNQUEUED, @intFromPtr(__mlx_soup_hsts_request_unqueued))
}

fn listOf(enforcer: usize, sessionPolicies: bool, domains: bool) -> usize {
    var list: usize = 0
    var index: usize = 0
    var p: *hsts.Policy = undefined
    while hsts.policyAt(stdEnforcer(enforcer), sessionPolicies, index, &p) {
        list = g_list_prepend(list, if domains { c.dup(p.*.domain) } else { fromStd(p) })
        index += 1
    }
    return list
}

export fn soup_hsts_enforcer_get_domains(enforcer: usize, session_policies: i32) -> usize { return listOf(enforcer, session_policies != 0, true) }

export fn soup_hsts_enforcer_get_policies(enforcer: usize, session_policies: i32) -> usize { return listOf(enforcer, session_policies != 0, false) }

// ---------------------------------------------------------------------------
// The DB enforcer: its policies in a file

fn dbFile(enforcer: usize) -> usize { return m.getWord(m.getWord(enforcer + 24)) }

fn save(enforcer: usize) -> void {
    var t = m.text()
    hsts.writeText(c.sinkOf(&t), stdEnforcer(enforcer))
    _ = g.g_file_set_contents(dbFile(enforcer), t.address, @intCast(i64, t.length), 0)
    m.dispose(&t)
}

fn load(enforcer: usize) -> void {
    const cells = m.alloc(16)
    if g.g_file_get_contents(dbFile(enforcer), cells, cells + 8, 0) != 0 {
        hsts.loadText(stdEnforcer(enforcer), m.bytes(m.getWord(cells), m.getWord(cells + 8)), cookie.nowForExpiry())
        g.g_free(m.getWord(cells))
    }
    m.release(cells)
}

export fn __mlx_soup_hsts_db_changed(enforcer: usize, old: usize, new: usize) -> void {
    if new != 0 && isSession(new) { return }
    if old != 0 && isSession(old) && new == 0 { return }
    save(enforcer)
}

export fn __mlx_soup_hsts_db_is_persistent(enforcer: usize) -> i32 { return 1 }

export fn __mlx_soup_hsts_db_init(enforcer: usize, class: usize) -> void { m.putWord(enforcer + 24, m.alloc(8)) }

export fn __mlx_soup_hsts_db_finalize(enforcer: usize) -> void {
    m.release(dbFile(enforcer))
    m.release(m.getWord(enforcer + 24))
    c.chainUp(g.g_type_class_ref(dbType), 48, enforcer)
}

export fn __mlx_soup_hsts_db_set_property(enforcer: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == 1 {
        c.replaceString(m.getWord(enforcer + 24), g.g_value_get_string(value))
        load(enforcer)
    }
}

export fn __mlx_soup_hsts_db_get_property(enforcer: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == 1 { g.g_value_set_string(value, dbFile(enforcer)) }
}

export fn __mlx_soup_hsts_db_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_soup_hsts_db_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_hsts_db_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_hsts_db_finalize))
    m.putWord(class + C_IS_PERSISTENT, @intFromPtr(__mlx_soup_hsts_db_is_persistent))
    m.putWord(class + C_CHANGED, @intFromPtr(__mlx_soup_hsts_db_changed))
    _ = c.stringProperty(class, 1, "filename", c.READWRITE | c.CONSTRUCT_ONLY)
}

export fn soup_hsts_enforcer_db_get_type() -> usize {
    if c.onceEnter(&dbType) {
        c.onceLeave(&dbType, c.defineType(enforcerTypeGet(), "SoupHSTSEnforcerDB", CLASS_SIZE, @intFromPtr(__mlx_soup_hsts_db_class_init), 32, @intFromPtr(__mlx_soup_hsts_db_init), c.FINAL))
    }
    return dbType
}

export fn soup_hsts_enforcer_db_new(filename: usize) -> usize {
    const enforcer = g.g_object_new(soup_hsts_enforcer_db_get_type(), 0)
    c.replaceString(m.getWord(enforcer + 24), filename)
    load(enforcer)
    return enforcer
}
