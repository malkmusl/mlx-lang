// soup-message-body.h: SoupMessageBody, as libsoup keeps one: the chunks
// it came in (GBytes, an empty one when it is complete), joined into
// `data` (with a NUL after it) when flattened; a body that does not
// accumulate drops each chunk once it is written.
//
// The structure: data (0) and length (8), as C sees them; the chunks (16:
// an array of GBytes, their count 24, room 32), the flattened GBytes
// (40), whether it accumulates (48), the offset of the first chunk kept
// (56), the reference count (64).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")

const B_DATA: usize = 0
const B_LENGTH: usize = 8
const B_CHUNKS: usize = 16
const B_COUNT: usize = 24
const B_ROOM: usize = 32
const B_FLAT: usize = 40
const B_ACCUMULATE: usize = 48
const B_BASE: usize = 56
const B_REFS: usize = 64
const B_SIZE: usize = 72

const MEMORY_STATIC: i32 = 0
const MEMORY_TAKE: i32 = 1

var bodyType: usize = 0

export fn __mlx_soup_body_copy(body: usize) -> usize { return soup_message_body_ref(body) }
export fn __mlx_soup_body_free(body: usize) -> void { soup_message_body_unref(body) }

export fn soup_message_body_get_type() -> usize {
    if c.onceEnter(&bodyType) {
        c.onceLeave(&bodyType, g.g_boxed_type_register_static(m.literal("SoupMessageBody"), @intFromPtr(__mlx_soup_body_copy), @intFromPtr(__mlx_soup_body_free)))
    }
    return bodyType
}

pub fn newBody() -> usize {
    const body = m.alloc(B_SIZE)
    m.put32(body + B_ACCUMULATE, 1)
    m.put32(body + B_REFS, 1)
    return body
}

export fn soup_message_body_new() -> usize { return newBody() }

export fn soup_message_body_ref(body: usize) -> usize {
    _ = @atomicRmw(u32, m.word32(body + B_REFS), add, 1, acq_rel)
    return body
}

export fn soup_message_body_unref(body: usize) -> void {
    if body == 0 { return }
    if @atomicRmw(u32, m.word32(body + B_REFS), sub, 1, acq_rel) != 1 { return }
    truncate(body)
    m.release(m.getWord(body + B_CHUNKS))
    m.release(body)
}

export fn soup_message_body_set_accumulate(body: usize, accumulate: i32) -> void { m.put32(body + B_ACCUMULATE, if accumulate != 0 { 1 } else { 0 }) }
export fn soup_message_body_get_accumulate(body: usize) -> i32 { return @bitCast(i32, m.get32(body + B_ACCUMULATE)) }

fn forgetFlattened(body: usize) -> void {
    const flat = m.getWord(body + B_FLAT)
    if flat != 0 { g.g_bytes_unref(flat) }
    m.putWord(body + B_FLAT, 0)
    m.putWord(body + B_DATA, 0)
}

// Takes `bytes` as the last chunk.
pub fn appendBuffer(body: usize, bytes: usize) -> void {
    const count = m.getWord(body + B_COUNT)
    if count == m.getWord(body + B_ROOM) {
        const larger = if count == 0 { 4 } else { count * 2 }
        m.putWord(body + B_CHUNKS, m.grow(m.getWord(body + B_CHUNKS), larger * 8))
        m.putWord(body + B_ROOM, larger)
    }
    m.putWord(m.getWord(body + B_CHUNKS) + count * 8, bytes)
    m.putWord(body + B_COUNT, count + 1)
    forgetFlattened(body)
    m.putI64(body + B_LENGTH, m.getI64(body + B_LENGTH) + @intCast(i64, g.g_bytes_get_size(bytes)))
}

export fn soup_message_body_append(body: usize, use: i32, data: usize, length: usize) -> void {
    if length > 0 {
        var bytes: usize = 0
        if use == MEMORY_TAKE {
            bytes = g.g_bytes_new_take(data, length)
        } else if use == MEMORY_STATIC {
            bytes = g.g_bytes_new_static(data, length)
        } else {
            bytes = g.g_bytes_new(data, length)
        }
        appendBuffer(body, bytes)
    } else if use == MEMORY_TAKE {
        g.g_free(data)
    }
}

export fn soup_message_body_append_take(body: usize, data: usize, length: usize) -> void { soup_message_body_append(body, MEMORY_TAKE, data, length) }

export fn soup_message_body_append_bytes(body: usize, buffer: usize) -> void {
    if g.g_bytes_get_size(buffer) == 0 {
        c.critical("soup_message_body_append_bytes: assertion 'g_bytes_get_size (buffer) > 0' failed")
        return
    }
    appendBuffer(body, g.g_bytes_ref(buffer))
}

pub fn truncate(body: usize) -> void {
    var index: usize = 0
    while index < m.getWord(body + B_COUNT) {
        g.g_bytes_unref(m.getWord(m.getWord(body + B_CHUNKS) + index * 8))
        index += 1
    }
    m.putWord(body + B_COUNT, 0)
    m.putI64(body + B_BASE, 0)
    forgetFlattened(body)
    m.putI64(body + B_LENGTH, 0)
}

export fn soup_message_body_truncate(body: usize) -> void { truncate(body) }
export fn soup_message_body_complete(body: usize) -> void { appendBuffer(body, g.g_bytes_new_static(0, 0)) }

pub fn flatten(body: usize) -> usize {
    if m.get32(body + B_ACCUMULATE) == 0 {
        c.critical("soup_message_body_flatten: assertion 'priv->accumulate == TRUE' failed")
        return 0
    }
    if m.getWord(body + B_FLAT) == 0 {
        const length = @intCast(usize, m.getI64(body + B_LENGTH))
        const buffer = m.raw(length + 1)
        var at: usize = 0
        var index: usize = 0
        while index < m.getWord(body + B_COUNT) {
            const chunk = m.getWord(m.getWord(body + B_CHUNKS) + index * 8)
            const size = g.g_bytes_get_size(chunk)
            m.copy(buffer + at, g.g_bytes_get_data(chunk, 0), size)
            at += size
            index += 1
        }
        m.put8(buffer + at, 0)
        const flat = g.g_bytes_new_take(buffer, at)
        m.putWord(body + B_FLAT, flat)
        m.putWord(body + B_DATA, buffer)
    }
    return g.g_bytes_ref(m.getWord(body + B_FLAT))
}

export fn soup_message_body_flatten(body: usize) -> usize { return flatten(body) }

export fn soup_message_body_get_chunk(body: usize, offset: i64) -> usize {
    var rest = offset - m.getI64(body + B_BASE)
    var index: usize = 0
    while index < m.getWord(body + B_COUNT) {
        const chunk = m.getWord(m.getWord(body + B_CHUNKS) + index * 8)
        const size = @intCast(i64, g.g_bytes_get_size(chunk))
        if rest < size || rest == 0 {
            return g.g_bytes_new_from_bytes(chunk, @intCast(usize, rest), @intCast(usize, size - rest))
        }
        rest -= size
        index += 1
    }
    return 0
}

export fn soup_message_body_got_chunk(body: usize, chunk: usize) -> void {
    if m.get32(body + B_ACCUMULATE) == 0 { return }
    soup_message_body_append_bytes(body, chunk)
}

export fn soup_message_body_wrote_chunk(body: usize, chunk: usize) -> void {
    if m.get32(body + B_ACCUMULATE) != 0 { return }
    if m.getWord(body + B_COUNT) == 0 { return }
    const chunks = m.getWord(body + B_CHUNKS)
    const first = m.getWord(chunks)
    if g.g_bytes_get_size(chunk) != g.g_bytes_get_size(first) {
        c.critical("soup_message_body_wrote_chunk: assertion 'g_bytes_get_size (chunk) == g_bytes_get_size (chunk2)' failed")
        return
    }
    if chunk != first {
        c.critical("soup_message_body_wrote_chunk: assertion 'chunk == chunk2' failed")
        return
    }
    const count = m.getWord(body + B_COUNT)
    m.copy(chunks, chunks + 8, (count - 1) * 8)
    m.putWord(body + B_COUNT, count - 1)
    m.putI64(body + B_BASE, m.getI64(body + B_BASE) + @intCast(i64, g.g_bytes_get_size(first)))
    g.g_bytes_unref(first)
}
