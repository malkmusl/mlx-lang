// libsoup's SoupPathMap: data kept by path, looked up by the longest path
// that starts the one asked for (a plain prefix, up to its "?"), as the
// authentication manager and the server's handlers use it.
//
// A map: the mappings (0), their count (8), room (16) and the data's
// destroy function (24); a mapping is the path (C heap), its length and
// the data, longest paths first.
const m = @import("../glib/memory.mlx")

pub const DestroyFn = fn(usize) -> void

const SIZE: usize = 24

pub fn new(destroy: usize) -> usize {
    const map = m.alloc(32)
    m.putWord(map + 24, destroy)
    return map
}

fn at(map: usize, index: usize) -> usize { return m.getWord(map) + index * SIZE }
pub fn count(map: usize) -> usize { return m.getWord(map + 8) }
pub fn pathAt(map: usize, index: usize) -> usize { return m.getWord(at(map, index)) }
pub fn dataAt(map: usize, index: usize) -> usize { return m.getWord(at(map, index) + 16) }

fn destroyData(map: usize, data: usize) -> void {
    const f = m.getWord(map + 24)
    if f == 0 { return }
    const call: DestroyFn = unsafe { @ptrFromInt(DestroyFn, f) }
    call(data)
}

pub fn free(map: usize) -> void {
    if map == 0 { return }
    var index: usize = 0
    while index < count(map) {
        m.release(pathAt(map, index))
        destroyData(map, dataAt(map, index))
        index += 1
    }
    m.release(m.getWord(map))
    m.release(map)
}

fn pathLength(path: usize) -> usize {
    const text = m.cSlice(path)
    var length: usize = 0
    while length < text.length && text[length] != 63 { length += 1 }
    return length
}

fn prefix(mapping: usize, path: usize) -> bool {
    const length = m.getWord(mapping + 8)
    var index: usize = 0
    while index < length {
        if m.get8(m.getWord(mapping) + index) != m.get8(path + index) { return false }
        index += 1
    }
    return true
}

// The mapping for `path` or its nearest ancestor (`exact` whether it is
// the path itself), or the count; `insert` where a new one would go.
fn lookupIndex(map: usize, path: usize, exact: *bool, insert: *usize) -> usize {
    const length = pathLength(path)
    exact.* = false
    insert.* = count(map)
    var insertSet = false
    var index: usize = 0
    while index < count(map) {
        const mapping = at(map, index)
        const mlen = m.getWord(mapping + 8)
        if mlen > length {
            index += 1
            continue
        }
        if !insertSet {
            insert.* = index
            insertSet = true
        }
        if prefix(mapping, path) {
            exact.* = mlen == length
            return index
        }
        index += 1
    }
    return count(map)
}

pub fn add(map: usize, path: usize, data: usize) -> void {
    var exact = false
    var insert: usize = 0
    const found = lookupIndex(map, path, &exact, &insert)
    if found < count(map) && exact {
        const mapping = at(map, found)
        destroyData(map, m.getWord(mapping + 16))
        m.putWord(mapping + 16, data)
        return
    }
    // Before the first mapping no longer than it.
    const length = m.cLength(path)
    var position = count(map)
    var index: usize = 0
    while index < count(map) {
        if m.getWord(at(map, index) + 8) <= length {
            position = index
            break
        }
        index += 1
    }
    const n = count(map)
    if n == m.getWord(map + 16) {
        const room = if n == 0 { 4 } else { n * 2 }
        m.putWord(map, m.grow(m.getWord(map), room * SIZE))
        m.putWord(map + 16, room)
    }
    var move = n
    while move > position {
        m.copy(at(map, move), at(map, move - 1), SIZE)
        move -= 1
    }
    const mapping = at(map, position)
    m.putWord(mapping, m.dup(path))
    m.putWord(mapping + 8, length)
    m.putWord(mapping + 16, data)
    m.putWord(map + 8, n + 1)
}

pub fn remove(map: usize, path: usize) -> void {
    var exact = false
    var insert: usize = 0
    const found = lookupIndex(map, path, &exact, &insert)
    if found == count(map) || !exact { return }
    const mapping = at(map, found)
    destroyData(map, m.getWord(mapping + 16))
    m.release(m.getWord(mapping))
    var move = found
    while move + 1 < count(map) {
        m.copy(at(map, move), at(map, move + 1), SIZE)
        move += 1
    }
    m.putWord(map + 8, count(map) - 1)
}

pub fn lookup(map: usize, path: usize) -> usize {
    var exact = false
    var insert: usize = 0
    const found = lookupIndex(map, path, &exact, &insert)
    if found == count(map) { return 0 }
    return dataAt(map, found)
}
