base www.example.com: example.com (public suffix 0)
base example.com: example.com (public suffix 0)
base com: error 2 Not enough domains (public suffix 1)
base www.example.co.uk: example.co.uk (public suffix 0)
base co.uk: error 2 Not enough domains (public suffix 1)
base a.b.c.kawasaki.jp: b.c.kawasaki.jp (public suffix 0)
base city.kawasaki.jp: city.kawasaki.jp (public suffix 0)
base www.city.kawasaki.jp: city.kawasaki.jp (public suffix 0)
base foo.bar.ck: foo.bar.ck (public suffix 0)
base www.ck: www.ck (public suffix 0)
base example.invalidtld: error 3 Hostname has no base domain (public suffix 0)
base invalidtld: error 3 Hostname has no base domain (public suffix 0)
base .example.com: error 0 Invalid hostname (public suffix 0)
base 192.168.1.1: error 1 Hostname is an IP address (public suffix 0)
base foo.github.io: foo.github.io (public suffix 0)
base github.io: error 2 Not enough domains (public suffix 1)
base EXAMPLE.COM: error 3 Hostname has no base domain (public suffix 0)
policy 0, persistent 0
set http://www.example.com/a/b: one=1
  changed: (none) -> one
set http://www.example.com/a/b: two=2; Path=/
  changed: (none) -> two
set http://www.example.com/a/b: three=3; Path=/a/b/c
  changed: (none) -> three
set http://www.example.com/: dom=d; Domain=example.com
  changed: (none) -> dom
set http://www.example.com/: http=h; HttpOnly
  changed: (none) -> http
set http://www.example.com/: sec=s; Secure
set https://www.example.com/: sec=s; Secure; Path=/
  changed: (none) -> sec
set https://www.example.com/: __Secure-a=1
set https://www.example.com/: __Secure-b=1; Secure
  changed: (none) -> __Secure-b
set https://www.example.com/: __Host-a=1; Secure; Path=/; Domain=example.com
set https://www.example.com/: __Host-b=1; Secure; Path=/
  changed: (none) -> __Host-b
set http://www.example.com/: none=n; SameSite=None
set https://www.example.com/: lax=l; SameSite=Lax; Secure
  changed: (none) -> lax
set http://www.example.com/: public=p; Domain=com
set http://www.example.com/: other=o; Domain=other.com
set http://www.example.com/: gone=g; Max-Age=0
set http://www.example.com/: two=22; Path=/
  changed: two -> two
set http://www.example.com/: ctl=a
get http://www.example.com/a/b/c: three=3; one=1; dom=d; http=h; two=22
get http://www.example.com/a/b: one=1; dom=d; http=h; two=22
get https://www.example.com/: dom=d; http=h; sec=s; __Secure-b=1; __Host-b=1; lax=l; two=22
get https://www.example.com/ (script): dom=d; sec=s; __Secure-b=1; __Host-b=1; lax=l; two=22
get http://example.com/: dom=d
get http://sub.www.example.com/: dom=d
get http://other.org/: (none)
all: __Host-b=1[www.example.com/ secure] __Secure-b=1[www.example.com/ secure] dom=d[.example.com/] http=h[www.example.com/ httponly] lax=l[www.example.com/ secure] one=1[www.example.com/a] sec=s[www.example.com/ secure] three=3[www.example.com/a/b/c] two=22[www.example.com/]
set http://www.example.com/a/b: one=x; Expires=Thu, 01 Jan 1970 00:00:00 GMT
  changed: one -> (none)
get http://www.example.com/a/b: dom=d; http=h; two=22
  changed: dom -> (none)
get http://www.example.com/: http=h; two=22
  changed: (none) -> img
get http://tracker.net/: (none)
get http://img.example.com/: img=1
  changed: (none) -> grand
get http://img.example.com/: img=1; grand=1
policy now 3
text jar persistent 1
set http://www.example.com/: keep=1; Max-Age=3600
set http://www.example.com/: session=1
set https://www.example.com/: secure=1; Max-Age=3600; Secure; HttpOnly; SameSite=Strict
set http://www.example.com/: keep=2; Max-Age=3600
all: keep=2[www.example.com/ expires] secure=1[www.example.com/ secure httponly expires]
file: #HttpOnly_www.example.com FALSE / TRUE secure 1 Strict
file: www.example.com FALSE / FALSE keep 2 Lax
exit 0
