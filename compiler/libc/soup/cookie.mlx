// soup-cookie.h: SoupCookie, read from Set-Cookie values as libsoup reads
// them (std.http.cookie), written back as Set-Cookie and Cookie headers,
// and matched against hosts and URIs.
//
// A SoupCookie: its name (0), value (8), domain (16), path (24), expiry
// (32, a GDateTime or NULL), secure (40), HttpOnly (44) and same-site
// policy (48).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const headers = @import("./headers.mlx")
const misc = @import("./misc.mlx")
const http = @import("std.http.headers")
const cookies = @import("std.http.cookie")

extern("c") fn soup_message_get_uri(msg: usize) -> usize
extern("c") fn soup_message_get_request_headers(msg: usize) -> usize
extern("c") fn soup_message_get_response_headers(msg: usize) -> usize

const K_NAME: usize = 0
const K_VALUE: usize = 8
const K_DOMAIN: usize = 16
const K_PATH: usize = 24
const K_EXPIRES: usize = 32
const K_SECURE: usize = 40
const K_HTTP_ONLY: usize = 44
const K_SAME_SITE: usize = 48
const K_SIZE: usize = 56

pub const SAME_SITE_NONE: i32 = 0
pub const SAME_SITE_LAX: i32 = 1
pub const SAME_SITE_STRICT: i32 = 2

var cookieType: usize = 0

export fn soup_cookie_get_type() -> usize {
    if c.onceEnter(&cookieType) {
        c.onceLeave(&cookieType, g.g_boxed_type_register_static(m.literal("SoupCookie"), @intFromPtr(soup_cookie_copy), @intFromPtr(soup_cookie_free)))
    }
    return cookieType
}

pub fn name(cookie: usize) -> usize { return m.getWord(cookie + K_NAME) }
pub fn value(cookie: usize) -> usize { return m.getWord(cookie + K_VALUE) }
pub fn domain(cookie: usize) -> usize { return m.getWord(cookie + K_DOMAIN) }
pub fn path(cookie: usize) -> usize { return m.getWord(cookie + K_PATH) }
pub fn expires(cookie: usize) -> usize { return m.getWord(cookie + K_EXPIRES) }
pub fn secure(cookie: usize) -> bool { return m.getI32(cookie + K_SECURE) != 0 }
pub fn httpOnly(cookie: usize) -> bool { return m.getI32(cookie + K_HTTP_ONLY) != 0 }
pub fn sameSite(cookie: usize) -> i32 { return m.getI32(cookie + K_SAME_SITE) }

export fn soup_cookie_copy(cookie: usize) -> usize {
    const copy = m.alloc(K_SIZE)
    m.putWord(copy + K_NAME, m.dup(name(cookie)))
    m.putWord(copy + K_VALUE, m.dup(value(cookie)))
    m.putWord(copy + K_DOMAIN, m.dup(domain(cookie)))
    m.putWord(copy + K_PATH, m.dup(path(cookie)))
    if expires(cookie) != 0 { m.putWord(copy + K_EXPIRES, g.g_date_time_ref(expires(cookie))) }
    m.putI32(copy + K_SECURE, m.getI32(cookie + K_SECURE))
    m.putI32(copy + K_HTTP_ONLY, m.getI32(cookie + K_HTTP_ONLY))
    m.putI32(copy + K_SAME_SITE, m.getI32(cookie + K_SAME_SITE))
    return copy
}

export fn soup_cookie_free(cookie: usize) -> void {
    if cookie == 0 {
        c.critical("soup_cookie_free: assertion 'cookie != NULL' failed")
        return
    }
    m.release(name(cookie))
    m.release(value(cookie))
    m.release(domain(cookie))
    m.release(path(cookie))
    if expires(cookie) != 0 { g.g_date_time_unref(expires(cookie)) }
    m.release(cookie)
}

export fn __mlx_soup_cookie_free(cookie: usize) -> void { soup_cookie_free(cookie) }

pub fn hostMatches(cookieDomain: usize, host: usize) -> bool { return cookies.hostMatches(m.cSlice(cookieDomain), m.cSlice(host)) }

export fn soup_cookie_domain_matches(cookie: usize, host: usize) -> i32 {
    if cookie == 0 || host == 0 { return 0 }
    return if hostMatches(domain(cookie), host) { 1 } else { 0 }
}

pub fn setMaxAge(cookie: usize, maxAge: i32) -> void {
    if expires(cookie) != 0 { g.g_date_time_unref(expires(cookie)) }
    if maxAge == -1 {
        m.putWord(cookie + K_EXPIRES, 0)
    } else if maxAge == 0 {
        // A date long past, so the cookie is gone at once.
        m.putWord(cookie + K_EXPIRES, g.g_date_time_new_from_unix_utc(0))
    } else {
        const now = g.g_date_time_new_now_utc()
        m.putWord(cookie + K_EXPIRES, g.g_date_time_add_seconds(now, @floatFromInt(f64, maxAge)))
        g.g_date_time_unref(now)
    }
}

export fn soup_cookie_set_max_age(cookie: usize, max_age: i32) -> void { setMaxAge(cookie, max_age) }

// libsoup's parse_one_cookie: the cookie of a Set-Cookie value, against
// the URI it came from (0 when it is refused).
pub fn parse(header: usize, origin: usize) -> usize {
    const text = m.cSlice(header)
    const cookie = m.alloc(K_SIZE)
    m.putI32(cookie + K_SAME_SITE, SAME_SITE_LAX)
    var cookieName: []const u8 = ""
    var cookieValue: []const u8 = ""
    var at = cookies.nameAndValue(text, &cookieName, &cookieValue)
    m.putWord(cookie + K_NAME, c.dup(cookieName))
    m.putWord(cookie + K_VALUE, c.dup(cookieValue))
    var attribute: cookies.Attribute = undefined
    while cookies.nextAttribute(text, &at, &attribute) {
        const n = attribute.name
        if http.equalsIgnoringCase(n, "domain") && attribute.hasValue {
            m.release(domain(cookie))
            m.putWord(cookie + K_DOMAIN, if attribute.value.length > 0 { c.dup(attribute.value) } else { 0 })
        } else if http.equalsIgnoringCase(n, "expires") && attribute.hasValue {
            // (Each Expires replaces the expiry, even one that cannot be
            // read: the cookie has none then.)
            const was = expires(cookie)
            m.putWord(cookie + K_EXPIRES, misc.parseHttpDate(attribute.value))
            if was != 0 { g.g_date_time_unref(was) }
        } else if http.equalsIgnoringCase(n, "httponly") {
            m.putI32(cookie + K_HTTP_ONLY, 1)
        } else if http.equalsIgnoringCase(n, "max-age") && attribute.hasValue {
            var maxAge: i64 = 0
            if parseLong(attribute.value, &maxAge) {
                if maxAge < 0 { maxAge = 0 }
                // (An int, as libsoup's soup_cookie_set_max_age takes.)
                setMaxAge(cookie, @bitCast(i32, @intCast(u32, @bitCast(u64, maxAge) & 0xffffffff)))
            }
        } else if http.equalsIgnoringCase(n, "path") && attribute.hasValue {
            m.release(path(cookie))
            m.putWord(cookie + K_PATH, if attribute.value.length > 0 && attribute.value[0] == 47 { c.dup(attribute.value) } else { 0 })
        } else if http.equalsIgnoringCase(n, "secure") {
            m.putI32(cookie + K_SECURE, 1)
        } else if http.equalsIgnoringCase(n, "samesite") {
            if attribute.hasValue {
                if http.equalsIgnoringCase(attribute.value, "None") {
                    m.putI32(cookie + K_SAME_SITE, SAME_SITE_NONE)
                } else if http.equalsIgnoringCase(attribute.value, "Strict") {
                    m.putI32(cookie + K_SAME_SITE, SAME_SITE_STRICT)
                }
            }
        }
    }
    if domain(cookie) != 0 {
        // A domain needs a dot past its first character; one that is not an
        // address gets a dot first.
        const d = m.cSlice(domain(cookie))
        if d.length < 2 || http.indexOf(d, 46, 1) >= d.length {
            soup_cookie_free(cookie)
            return 0
        }
        if g.g_hostname_is_ip_address(domain(cookie)) == 0 && d[0] != 46 {
            var t = m.text()
            m.pushByte(&t, 46)
            m.pushC(&t, domain(cookie))
            m.release(domain(cookie))
            m.putWord(cookie + K_DOMAIN, m.finish(&t))
        }
    }
    if origin != 0 {
        const host = g.g_uri_get_host(origin)
        if domain(cookie) != 0 {
            if !hostMatches(domain(cookie), host) {
                soup_cookie_free(cookie)
                return 0
            }
        } else {
            m.putWord(cookie + K_DOMAIN, m.dup(host))
        }
        if path(cookie) == 0 {
            const normalizedOrigin = misc.normalized(origin)
            m.putWord(cookie + K_PATH, c.dup(cookies.defaultPath(m.cSlice(g.g_uri_get_path(normalizedOrigin)))))
            g.g_uri_unref(normalizedOrigin)
        }
    } else if path(cookie) == 0 {
        m.putWord(cookie + K_PATH, m.dupSlice("/"))
    }
    return cookie
}

// C's strtol of all of `text` (spaces and a sign allowed first; nothing
// after the digits).
fn parseLong(text: []const u8, result: *i64) -> bool {
    var i: usize = 0
    while i < text.length && http.isSpace(text[i]) { i += 1 }
    var negative = false
    if i < text.length && (text[i] == 43 || text[i] == 45) {
        negative = text[i] == 45
        i += 1
    }
    const start = i
    var v: i64 = 0
    while i < text.length && http.isDigit(text[i]) {
        if v < 922337203685477580 { v = v * 10 + @intCast(i64, text[i] - 48) } else { v = 9223372036854775807 }
        i += 1
    }
    // (No digits: strtol leaves nothing read, and the whole text is left.)
    if i == start { return text.length == 0 }
    if i != text.length { return false }
    result.* = if negative { 0 - v } else { v }
    return true
}

export fn soup_cookie_parse(header: usize, origin: usize) -> usize {
    if header == 0 {
        c.critical("soup_cookie_parse: assertion 'cookie != NULL' failed")
        return 0
    }
    if origin != 0 && g.g_uri_get_host(origin) == 0 {
        c.critical("soup_cookie_parse: assertion 'origin == NULL || g_uri_get_host (origin) != NULL' failed")
        return 0
    }
    return parse(header, origin)
}

pub fn newCookie(cookieName: usize, cookieValue: usize, cookieDomain: usize, cookiePath: usize, maxAge: i32) -> usize {
    const cookie = m.alloc(K_SIZE)
    m.putWord(cookie + K_NAME, m.dup(cookieName))
    m.putWord(cookie + K_VALUE, m.dup(cookieValue))
    m.putWord(cookie + K_DOMAIN, m.dup(cookieDomain))
    m.putWord(cookie + K_PATH, m.dup(cookiePath))
    setMaxAge(cookie, maxAge)
    m.putI32(cookie + K_SAME_SITE, SAME_SITE_LAX)
    return cookie
}

export fn soup_cookie_new(cookie_name: usize, cookie_value: usize, cookie_domain: usize, cookie_path: usize, max_age: i32) -> usize {
    if cookie_name == 0 {
        c.critical("soup_cookie_new: assertion 'name != NULL' failed")
        return 0
    }
    if cookie_value == 0 {
        c.critical("soup_cookie_new: assertion 'value != NULL' failed")
        return 0
    }
    return newCookie(cookie_name, cookie_value, cookie_domain, cookie_path, max_age)
}

export fn soup_cookie_get_name(cookie: usize) -> usize { return name(cookie) }
export fn soup_cookie_set_name(cookie: usize, text: usize) -> void { c.replaceString(cookie + K_NAME, text) }
export fn soup_cookie_get_value(cookie: usize) -> usize { return value(cookie) }
export fn soup_cookie_set_value(cookie: usize, text: usize) -> void { c.replaceString(cookie + K_VALUE, text) }
export fn soup_cookie_get_domain(cookie: usize) -> usize { return domain(cookie) }
export fn soup_cookie_set_domain(cookie: usize, text: usize) -> void { c.replaceString(cookie + K_DOMAIN, text) }
export fn soup_cookie_get_path(cookie: usize) -> usize { return path(cookie) }
export fn soup_cookie_set_path(cookie: usize, text: usize) -> void { c.replaceString(cookie + K_PATH, text) }
export fn soup_cookie_get_expires(cookie: usize) -> usize { return expires(cookie) }

export fn soup_cookie_set_expires(cookie: usize, d: usize) -> void {
    if expires(cookie) != 0 { g.g_date_time_unref(expires(cookie)) }
    m.putWord(cookie + K_EXPIRES, if d != 0 { g.g_date_time_ref(d) } else { 0 })
}

export fn soup_cookie_get_secure(cookie: usize) -> i32 { return m.getI32(cookie + K_SECURE) }
export fn soup_cookie_set_secure(cookie: usize, b: i32) -> void { m.putI32(cookie + K_SECURE, b) }
export fn soup_cookie_get_http_only(cookie: usize) -> i32 { return m.getI32(cookie + K_HTTP_ONLY) }
export fn soup_cookie_set_http_only(cookie: usize, b: i32) -> void { m.putI32(cookie + K_HTTP_ONLY, b) }

export fn soup_cookie_set_same_site_policy(cookie: usize, policy: i32) -> void {
    if policy < 0 || policy > 2 {
        c.critical("soup_cookie_set_same_site_policy: code should not be reached")
        return
    }
    m.putI32(cookie + K_SAME_SITE, policy)
}

export fn soup_cookie_get_same_site_policy(cookie: usize) -> i32 { return sameSite(cookie) }

// libsoup's serialize_cookie: appended to `t` (", " or "; " between
// cookies), as a Set-Cookie or a Cookie value; a cookie with neither name
// nor value is left out.
pub fn serialize(cookie: usize, t: *m.Text, setCookie: bool) -> void {
    if m.get8(name(cookie)) == 0 && m.get8(value(cookie)) == 0 { return }
    if t.*.length > 0 { m.pushText(t, if setCookie { ", " } else { "; " }) }
    if setCookie || m.get8(name(cookie)) != 0 {
        m.pushC(t, name(cookie))
        m.pushByte(t, 61)
    }
    m.pushC(t, value(cookie))
    if !setCookie { return }
    if expires(cookie) != 0 {
        m.pushText(t, "; expires=")
        const stamp = misc.dateString(expires(cookie), 2)
        m.pushC(t, stamp)
        m.release(stamp)
    }
    if path(cookie) != 0 {
        m.pushText(t, "; path=")
        m.pushC(t, path(cookie))
    }
    if domain(cookie) != 0 {
        m.pushText(t, "; domain=")
        m.pushC(t, domain(cookie))
    }
    const policy = sameSite(cookie)
    if policy != SAME_SITE_NONE {
        m.pushText(t, "; SameSite=")
        m.pushText(t, if policy == SAME_SITE_LAX { "Lax" } else { "Strict" })
    }
    if secure(cookie) { m.pushText(t, "; secure") }
    if httpOnly(cookie) { m.pushText(t, "; HttpOnly") }
}

export fn soup_cookie_to_set_cookie_header(cookie: usize) -> usize {
    var t = m.text()
    serialize(cookie, &t, true)
    return m.finish(&t)
}

export fn soup_cookie_to_cookie_header(cookie: usize) -> usize {
    var t = m.text()
    serialize(cookie, &t, false)
    return m.finish(&t)
}

export fn soup_cookies_from_response(msg: usize) -> usize {
    const origin = soup_message_get_uri(msg)
    var list: usize = 0
    const iter = m.alloc(24)
    const cells = m.alloc(16)
    headers.iterInit(iter, soup_message_get_response_headers(msg))
    while headers.iterNext(iter, cells, cells + 8) {
        if g.g_ascii_strcasecmp(m.getWord(cells), m.literal("Set-Cookie")) != 0 { continue }
        const cookie = parse(m.getWord(cells + 8), origin)
        if cookie != 0 { list = g.g_slist_prepend(list, cookie) }
    }
    m.release(cells)
    m.release(iter)
    return g.g_slist_reverse(list)
}

export fn soup_cookies_from_request(msg: usize) -> usize {
    const header = headers.getOneKnown(soup_message_get_request_headers(msg), http.COOKIE)
    if header == 0 { return 0 }
    const params = headers.paramList(m.cSlice(header), 59, false)
    var list: usize = 0
    const iter = m.alloc(64)
    const kv = m.alloc(16)
    g.g_hash_table_iter_init(iter, params)
    while g.g_hash_table_iter_next(iter, kv, kv + 8) != 0 {
        if m.getWord(kv) != 0 && m.getWord(kv + 8) != 0 { list = g.g_slist_prepend(list, newCookie(m.getWord(kv), m.getWord(kv + 8), 0, 0, 0)) }
    }
    m.release(kv)
    m.release(iter)
    g.g_hash_table_destroy(params)
    return g.g_slist_reverse(list)
}

export fn soup_cookies_to_response(list: usize, msg: usize) -> void {
    var l = list
    while l != 0 {
        var t = m.text()
        serialize(m.getWord(l), &t, true)
        const text = m.finish(&t)
        headers.appendKnown(soup_message_get_response_headers(msg), http.SET_COOKIE, text)
        m.release(text)
        l = m.getWord(l + 8)
    }
}

export fn soup_cookies_to_request(list: usize, msg: usize) -> void {
    const hdrs = soup_message_get_request_headers(msg)
    var t = m.text()
    m.pushC(&t, headers.getOneKnown(hdrs, http.COOKIE))
    var l = list
    while l != 0 {
        serialize(m.getWord(l), &t, false)
        l = m.getWord(l + 8)
    }
    const text = m.finish(&t)
    headers.replaceKnown(hdrs, http.COOKIE, text)
    m.release(text)
}

export fn soup_cookies_free(list: usize) -> void { g.g_slist_free_full(list, @intFromPtr(__mlx_soup_cookie_free)) }

export fn soup_cookies_to_cookie_header(list: usize) -> usize {
    if list == 0 {
        c.critical("soup_cookies_to_cookie_header: assertion 'cookies != NULL' failed")
        return 0
    }
    var t = m.text()
    var l = list
    while l != 0 {
        serialize(m.getWord(l), &t, false)
        l = m.getWord(l + 8)
    }
    return m.finish(&t)
}

pub fn appliesToUri(cookie: usize, uri: usize) -> bool {
    if secure(cookie) && !misc.isHttps(uri) { return false }
    if expires(cookie) != 0 && misc.isPast(expires(cookie)) { return false }
    const p = m.cSlice(path(cookie))
    if p.length == 0 { return true }
    const normalizedUri = misc.normalized(uri)
    const good = cookies.pathMatches(p, m.cSlice(g.g_uri_get_path(normalizedUri)))
    g.g_uri_unref(normalizedUri)
    return good
}

export fn soup_cookie_applies_to_uri(cookie: usize, uri: usize) -> i32 {
    if cookie == 0 || uri == 0 { return 0 }
    return if appliesToUri(cookie, uri) { 1 } else { 0 }
}

pub fn equal(one: usize, two: usize) -> bool { return m.cEqual(name(one), name(two)) && m.cEqual(value(one), value(two)) && c.cEquals(path(one), path(two)) }

export fn soup_cookie_equal(cookie1: usize, cookie2: usize) -> i32 {
    if cookie1 == 0 || cookie2 == 0 { return 0 }
    return if equal(cookie1, cookie2) { 1 } else { 0 }
}
