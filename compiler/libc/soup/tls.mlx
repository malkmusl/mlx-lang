// What mlx-soup asks of GIO's TLS, looked up when first needed rather
// than linked: a libmlxglib without a TLS backend lacks the client
// connection and the types of its flags, and https:// then fails with
// G_TLS_ERROR_UNAVAILABLE as libsoup fails without glib-networking. The
// types fall back to ones registered here under GIO's names and values,
// so that SoupMessage's properties exist either way.
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")

pub const GetTypeFn = fn() -> usize
pub const NewFn = fn(usize, usize, usize) -> usize
pub const HandshakeAsyncFn = fn(usize, i32, usize, usize, usize) -> void
pub const FinishFn = fn(usize, usize, usize) -> i32
pub const GetFn = fn(usize) -> usize
pub const GetIntFn = fn(usize) -> i32
pub const SetFn = fn(usize, usize) -> void
pub const SetIntFn = fn(usize, i32) -> void

// G_TLS_ERROR_UNAVAILABLE, G_TLS_ERROR_BAD_CERTIFICATE.
pub const ERROR_UNAVAILABLE: i32 = 0
pub const ERROR_BAD_CERTIFICATE: i32 = 2

pub fn lookup(name: []const u8) -> usize {
    const text = m.dupSlice(name)
    const address = g.dlsym(0, text)
    m.release(text)
    return address
}

var flagsType: usize = 0
var versionType: usize = 0

// GTlsCertificateFlags.
pub fn certificateFlagsType() -> usize {
    if c.onceEnter(&flagsType) {
        const f = lookup("g_tls_certificate_flags_get_type")
        var t: usize = 0
        if f != 0 {
            const call: GetTypeFn = unsafe { @ptrFromInt(GetTypeFn, f) }
            t = call()
        } else {
            const values = [8]i64{ 1, 2, 4, 8, 16, 32, 64, 127 }
            t = c.enumType("GTlsCertificateFlags", true, values[0..8], "G_TLS_CERTIFICATE_UNKNOWN_CA G_TLS_CERTIFICATE_BAD_IDENTITY G_TLS_CERTIFICATE_NOT_ACTIVATED G_TLS_CERTIFICATE_EXPIRED G_TLS_CERTIFICATE_REVOKED G_TLS_CERTIFICATE_INSECURE G_TLS_CERTIFICATE_GENERIC_ERROR G_TLS_CERTIFICATE_VALIDATE_ALL", "unknown-ca bad-identity not-activated expired revoked insecure generic-error validate-all")
        }
        c.onceLeave(&flagsType, t)
    }
    return flagsType
}

// GTlsProtocolVersion.
pub fn protocolVersionType() -> usize {
    if c.onceEnter(&versionType) {
        const f = lookup("g_tls_protocol_version_get_type")
        var t: usize = 0
        if f != 0 {
            const call: GetTypeFn = unsafe { @ptrFromInt(GetTypeFn, f) }
            t = call()
        } else {
            const values = [8]i64{ 0, 1, 2, 3, 4, 5, 201, 202 }
            t = c.enumType("GTlsProtocolVersion", false, values[0..8], "G_TLS_PROTOCOL_VERSION_UNKNOWN G_TLS_PROTOCOL_VERSION_SSL_3_0 G_TLS_PROTOCOL_VERSION_TLS_1_0 G_TLS_PROTOCOL_VERSION_TLS_1_1 G_TLS_PROTOCOL_VERSION_TLS_1_2 G_TLS_PROTOCOL_VERSION_TLS_1_3 G_TLS_PROTOCOL_VERSION_DTLS_1_0 G_TLS_PROTOCOL_VERSION_DTLS_1_2", "unknown ssl-3-0 tls-1-0 tls-1-1 tls-1-2 tls-1-3 dtls-1-0 dtls-1-2")
        }
        c.onceLeave(&versionType, t)
    }
    return versionType
}

// Whether TLS can be had: the backend says so and the client connection
// is there.
pub fn available() -> bool {
    if lookup("g_tls_client_connection_new") == 0 { return false }
    const backend = g.g_tls_backend_get_default()
    return backend != 0 && g.g_tls_backend_supports_tls(backend) != 0
}

// A TLS client connection over `base` for the server `identity` (a
// GNetworkAddress), or 0 with `err` set.
pub fn clientConnection(base: usize, identity: usize, err: usize) -> usize {
    const f = lookup("g_tls_client_connection_new")
    if f == 0 || !available() {
        c.setError(err, g.g_tls_error_quark(), ERROR_UNAVAILABLE, "TLS/SSL support not available; install glib-networking")
        return 0
    }
    const call: NewFn = unsafe { @ptrFromInt(NewFn, f) }
    return call(base, identity, err)
}

pub fn handshakeAsync(connection: usize, priority: i32, cancellable: usize, callback: usize, data: usize) -> void {
    const call: HandshakeAsyncFn = unsafe { @ptrFromInt(HandshakeAsyncFn, lookup("g_tls_connection_handshake_async")) }
    call(connection, priority, cancellable, callback, data)
}

pub fn handshakeFinish(connection: usize, result: usize, err: usize) -> bool {
    const call: FinishFn = unsafe { @ptrFromInt(FinishFn, lookup("g_tls_connection_handshake_finish")) }
    return call(connection, result, err) != 0
}

fn getWord(name: []const u8, connection: usize) -> usize {
    const f = lookup(name)
    if f == 0 || connection == 0 { return 0 }
    const call: GetFn = unsafe { @ptrFromInt(GetFn, f) }
    return call(connection)
}

fn getInt(name: []const u8, connection: usize) -> i32 {
    const f = lookup(name)
    if f == 0 || connection == 0 { return 0 }
    const call: GetIntFn = unsafe { @ptrFromInt(GetIntFn, f) }
    return call(connection)
}

fn setWord(name: []const u8, connection: usize, value: usize) -> void {
    const f = lookup(name)
    if f == 0 { return }
    const call: SetFn = unsafe { @ptrFromInt(SetFn, f) }
    call(connection, value)
}

pub fn peerCertificate(connection: usize) -> usize { return getWord("g_tls_connection_get_peer_certificate", connection) }
pub fn peerErrors(connection: usize) -> u32 { return @bitCast(u32, getInt("g_tls_connection_get_peer_certificate_errors", connection)) }
pub fn protocolVersion(connection: usize) -> i32 { return getInt("g_tls_connection_get_protocol_version", connection) }
pub fn ciphersuiteName(connection: usize) -> usize { return getWord("g_tls_connection_get_ciphersuite_name", connection) }
pub fn setDatabase(connection: usize, database: usize) -> void { setWord("g_tls_connection_set_database", connection, database) }
pub fn setInteraction(connection: usize, interaction: usize) -> void { setWord("g_tls_connection_set_interaction", connection, interaction) }
pub fn setCertificate(connection: usize, certificate: usize) -> void { setWord("g_tls_connection_set_certificate", connection, certificate) }

pub fn setRequireCloseNotify(connection: usize, require: bool) -> void {
    const f = lookup("g_tls_connection_set_require_close_notify")
    if f == 0 { return }
    const call: SetIntFn = unsafe { @ptrFromInt(SetIntFn, f) }
    call(connection, if require { 1 } else { 0 })
}

pub fn isTlsConnection(stream: usize) -> bool {
    const f = lookup("g_tls_connection_get_type")
    if f == 0 || stream == 0 { return false }
    const call: GetTypeFn = unsafe { @ptrFromInt(GetTypeFn, f) }
    return g.g_type_check_instance_is_a(stream, call()) != 0
}
