// soup-websocket.h, soup-websocket-connection.h and the session's
// WebSocket connections: the opening handshake as libsoup does it (the
// client's request and its check of the response, the server's check of
// a request and its response, extensions negotiated), and
// SoupWebsocketConnection, the protocol (RFC 6455) over a GIOStream, its
// frames read and written without blocking on the main context:
// messages (fragmented or not, text checked as UTF-8), pings answered,
// the closing handshake, keepalive pings, the payload limit. The frame
// pieces are std.http.websocket's.
//
// A connection's private data is a pointer to a record:
//   0 the GIOStream            8 the connection type (client, server)
//  16 the URI                 24 the origin           32 the protocol
//  40 max-incoming-payload-size                       48 keepalive-interval
//  52 the peer's close code   56 the peer's close reason
//  64 whether a close was sent, 68 received, 72 whether the close is dirty
//  76 whether the stream is closing, 80 closed
//  88 the close timeout (a GSource)
//  96 the input stream       104 its source
// 112 the bytes read and not taken (a buffer), 120 their length, 128 room
// 136 the output stream      144 its source
// 152 the frames to send (an array of records), 160 how many, 168 room
// 176 the opcode of the message being put together
// 184 its data (a buffer), 192 its length, 200 room, 208 whether there is one
// 216 the keepalive timer (a GSource)
// 224 the extensions (a GList)
//
// A frame to send: its bytes (0), length (8), how much went (16), how much
// counts as buffered (24), its flags (32: urgent 1, last 2) and whether a
// write of it would have blocked (36).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const message = @import("./message.mlx")
const session = @import("./session.mlx")
const item = @import("./item.mlx")
const io = @import("./io.mlx")
const misc = @import("./misc.mlx")
const enumtypes = @import("./enumtypes.mlx")
const wsext = @import("./wsext.mlx")
const ws = @import("std.http.websocket")

