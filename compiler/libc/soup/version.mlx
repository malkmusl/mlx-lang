// soup-version.h: the version of libsoup's API this library has.
export fn soup_get_major_version() -> u32 { return 3 }
export fn soup_get_minor_version() -> u32 { return 4 }
export fn soup_get_micro_version() -> u32 { return 4 }

export fn soup_check_version(major: u32, minor: u32, micro: u32) -> i32 {
    if 3 > major || (3 == major && 4 > minor) || (3 == major && 4 == minor && 4 >= micro) { return 1 }
    return 0
}
