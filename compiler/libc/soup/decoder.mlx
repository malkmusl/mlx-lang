// soup-content-decoder.h: SoupContentDecoder, the session feature that
// asks for compressed responses ("Accept-Encoding: gzip, deflate") and
// undoes their Content-Encoding as the body is read (bodystream.mlx's
// converter, std.flate). Brotli ("br") is not asked for: std has no
// Brotli decoder; a response that uses a coding not known here is given
// as it came, as libsoup gives it.
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const message = @import("./message.mlx")
const feature = @import("./feature.mlx")
const bodystream = @import("./bodystream.mlx")
const http = @import("std.http.headers")

extern("c") fn soup_message_headers_get_one(h: usize, name: usize) -> usize
extern("c") fn soup_message_headers_get_list(h: usize, name: usize) -> usize
extern("c") fn soup_message_headers_append(h: usize, name: usize, value: usize) -> void
extern("c") fn soup_message_headers_get_content_type(h: usize, params: usize) -> usize
extern("c") fn soup_header_parse_list(header: usize) -> usize
extern("c") fn soup_header_free_list(list: usize) -> void

var decoderType: usize = 0

pub fn decoderTypeGet() -> usize {
    if c.onceEnter(&decoderType) {
        const t = c.defineType(c.T_OBJECT, "SoupContentDecoder", 136, 0, 24, 0, c.FINAL)
        feature.implementFeature(t, @intFromPtr(__mlx_soup_content_decoder_feature_init))
        c.onceLeave(&decoderType, t)
    }
    return decoderType
}

export fn soup_content_decoder_get_type() -> usize { return decoderTypeGet() }

export fn __mlx_soup_content_decoder_request_queued(decoder: usize, msg: usize) -> void {
    const hdrs = message.requestHeaders(msg)
    if soup_message_headers_get_one(hdrs, m.literal("Accept-Encoding")) == 0 {
        soup_message_headers_append(hdrs, m.literal("Accept-Encoding"), m.literal("gzip, deflate"))
    }
}

// 0: not known; 1: gzip; 2: deflate.
fn codingOf(name: []const u8) -> i32 {
    if m.same(name, "gzip") || m.same(name, "x-gzip") { return 1 }
    if m.same(name, "deflate") { return 2 }
    return 0
}

export fn __mlx_soup_content_decoder_wrap_input(decoder: usize, base: usize, msg: usize) -> usize {
    const hdrs = message.responseHeaders(msg)
    const header = soup_message_headers_get_list(hdrs, m.literal("Content-Encoding"))
    if header == 0 { return 0 }
    // Apache's gzip files sent as "Content-Encoding: gzip" are left alone.
    const text = m.cSlice(header)
    if http.equalsIgnoringCase(text, "gzip") || http.equalsIgnoringCase(text, "x-gzip") {
        const contentType = soup_message_headers_get_content_type(hdrs, 0)
        if contentType != 0 && (http.equalsIgnoringCase(m.cSlice(contentType), "application/gzip") || http.equalsIgnoringCase(m.cSlice(contentType), "application/x-gzip")) { return 0 }
    }
    const list = soup_header_parse_list(header)
    if list == 0 { return 0 }
    var at = list
    while at != 0 {
        if codingOf(m.cSlice(m.getWord(at))) == 0 {
            soup_header_free_list(list)
            return 0
        }
        at = m.getWord(at + 8)
    }
    // The codings were applied in the order listed: undone last first.
    const reversed = g.g_slist_reverse(list)
    var stream = g.g_object_ref(base)
    at = reversed
    while at != 0 {
        const wrapped = bodystream.newConverter(stream, codingOf(m.cSlice(m.getWord(at))) == 1)
        g.g_object_unref(stream)
        stream = wrapped
        at = m.getWord(at + 8)
    }
    soup_header_free_list(reversed)
    return stream
}

export fn __mlx_soup_content_decoder_feature_init(iface: usize, data: usize) -> void {
    m.putWord(iface + feature.REQUEST_QUEUED, @intFromPtr(__mlx_soup_content_decoder_request_queued))
    m.putWord(iface + feature.WRAP_INPUT, @intFromPtr(__mlx_soup_content_decoder_wrap_input))
    m.putWord(iface + feature.STAGE, feature.STAGE_CONTENT_ENCODING)
}
