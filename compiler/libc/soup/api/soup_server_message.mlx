// libsoup/soup-server-message.h
// mlx-soup: SoupServerMessage, a request a SoupServer received and the
// response its handler gives: the request's method, URI, headers and
// body, the response's status, headers and body, and the connection it
// came on.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const guri = @import("../../glib/api/guri.mlx")
const giotypes = @import("../../glib/api/giotypes.mlx")
const gioenums = @import("../../glib/api/gioenums.mlx")
const types = @import("./soup_types.mlx")
const status = @import("./soup_status.mlx")
const body = @import("./soup_message_body.mlx")
const headers = @import("./soup_message_headers.mlx")
const method = @import("./soup_method.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const gsize = gtypes.gsize
const SoupServerMessage = types.SoupServerMessage
const SoupMessageHeaders = headers.SoupMessageHeaders
const SoupMessageBody = body.SoupMessageBody

pub const SOUP_TYPE_SERVER_MESSAGE: gtype.GType = soup_server_message_get_type()

pub extern("c") fn soup_server_message_get_type() -> gtype.GType
pub extern("c") fn soup_server_message_get_request_headers(msg: *SoupServerMessage) -> *SoupMessageHeaders
pub extern("c") fn soup_server_message_get_response_headers(msg: *SoupServerMessage) -> *SoupMessageHeaders
pub extern("c") fn soup_server_message_get_request_body(msg: *SoupServerMessage) -> *SoupMessageBody
pub extern("c") fn soup_server_message_get_response_body(msg: *SoupServerMessage) -> *SoupMessageBody
pub extern("c") fn soup_server_message_get_method(msg: *SoupServerMessage) -> [*]const gchar
pub extern("c") fn soup_server_message_get_http_version(msg: *SoupServerMessage) -> status.SoupHTTPVersion
pub extern("c") fn soup_server_message_set_http_version(msg: *SoupServerMessage, version: status.SoupHTTPVersion) -> void
pub extern("c") fn soup_server_message_get_reason_phrase(msg: *SoupServerMessage) -> ?[*]const gchar
pub extern("c") fn soup_server_message_get_status(msg: *SoupServerMessage) -> guint
pub extern("c") fn soup_server_message_set_status(msg: *SoupServerMessage, status_code: guint, reason_phrase: ?[*]const gchar) -> void
pub extern("c") fn soup_server_message_get_uri(msg: *SoupServerMessage) -> *guri.GUri
pub extern("c") fn soup_server_message_set_response(msg: *SoupServerMessage, content_type: ?[*]const gchar, resp_use: body.SoupMemoryUse, resp_body: ?[*]const gchar, resp_length: gsize) -> void
pub extern("c") fn soup_server_message_set_redirect(msg: *SoupServerMessage, status_code: guint, redirect_uri: [*]const gchar) -> void
pub extern("c") fn soup_server_message_get_socket(msg: *SoupServerMessage) -> ?*giotypes.GSocket
pub extern("c") fn soup_server_message_get_local_address(msg: *SoupServerMessage) -> ?*giotypes.GSocketAddress
pub extern("c") fn soup_server_message_get_remote_address(msg: *SoupServerMessage) -> ?*giotypes.GSocketAddress
pub extern("c") fn soup_server_message_get_remote_host(msg: *SoupServerMessage) -> ?[*]const gchar
pub extern("c") fn soup_server_message_steal_connection(msg: *SoupServerMessage) -> *giotypes.GIOStream
pub extern("c") fn soup_server_message_is_options_ping(msg: *SoupServerMessage) -> gboolean
pub extern("c") fn soup_server_message_pause(msg: *SoupServerMessage) -> void
pub extern("c") fn soup_server_message_unpause(msg: *SoupServerMessage) -> void
pub extern("c") fn soup_server_message_get_tls_peer_certificate(msg: *SoupServerMessage) -> ?*giotypes.GTlsCertificate
pub extern("c") fn soup_server_message_get_tls_peer_certificate_errors(msg: *SoupServerMessage) -> gioenums.GTlsCertificateFlags

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupServerMessage, soup_server_message, SOUP, SERVER_MESSAGE, GObject)\nG_END_DECLS"
