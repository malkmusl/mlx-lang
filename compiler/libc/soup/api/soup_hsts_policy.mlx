// libsoup/soup-hsts-policy.h
// mlx-soup: SoupHSTSPolicy, an HTTP Strict Transport Security policy (RFC
// 6797) of a domain: from a response's Strict-Transport-Security header
// or made by hand, with its expiry (or none: a session policy) and
// whether it covers the domain's subdomains.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gdatetime = @import("../../glib/api/gdatetime.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gulong = gtypes.gulong
const GDateTime = gdatetime.GDateTime
const SoupHSTSPolicy = types.SoupHSTSPolicy

pub extern("c") fn soup_hsts_policy_get_type() -> gtype.GType
pub const SOUP_TYPE_HSTS_POLICY: gtype.GType = soup_hsts_policy_get_type()
pub const SOUP_HSTS_POLICY_MAX_AGE_PAST: c_int = 0

pub extern("c") fn soup_hsts_policy_new(domain: [*]const gchar, max_age: c_ulong, include_subdomains: gboolean) -> *SoupHSTSPolicy
pub extern("c") fn soup_hsts_policy_new_full(domain: [*]const gchar, max_age: c_ulong, expires: ?*GDateTime, include_subdomains: gboolean) -> *SoupHSTSPolicy
pub extern("c") fn soup_hsts_policy_new_session_policy(domain: [*]const gchar, include_subdomains: gboolean) -> *SoupHSTSPolicy
pub extern("c") fn soup_hsts_policy_new_from_response(msg: *types.SoupMessage) -> ?*SoupHSTSPolicy
pub extern("c") fn soup_hsts_policy_copy(policy: *SoupHSTSPolicy) -> *SoupHSTSPolicy
pub extern("c") fn soup_hsts_policy_equal(policy1: *SoupHSTSPolicy, policy2: *SoupHSTSPolicy) -> gboolean
pub extern("c") fn soup_hsts_policy_get_domain(policy: *SoupHSTSPolicy) -> [*]const gchar
pub extern("c") fn soup_hsts_policy_is_expired(policy: *SoupHSTSPolicy) -> gboolean
pub extern("c") fn soup_hsts_policy_includes_subdomains(policy: *SoupHSTSPolicy) -> gboolean
pub extern("c") fn soup_hsts_policy_is_session_policy(policy: *SoupHSTSPolicy) -> gboolean
pub extern("c") fn soup_hsts_policy_free(policy: *SoupHSTSPolicy) -> void
pub extern("c") fn soup_hsts_policy_get_expires(policy: *SoupHSTSPolicy) -> ?*GDateTime
pub extern("c") fn soup_hsts_policy_get_max_age(policy: *SoupHSTSPolicy) -> gulong

const c_macros = "G_BEGIN_DECLS\nG_DEFINE_AUTOPTR_CLEANUP_FUNC (SoupHSTSPolicy, soup_hsts_policy_free)\nG_END_DECLS"
