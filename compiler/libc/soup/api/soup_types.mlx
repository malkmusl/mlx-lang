// libsoup/soup-types.h
// mlx-soup: the object types every part of libsoup's API names (their
// structures are each header's own), over GLib, GObject and GIO
// (mlx-glib).
const c_function_pointers = true
const gio = @import("../../glib/api/gio.mlx")
const version = @import("./soup_version.mlx")
const status = @import("./soup_status.mlx")

pub const _SoupAuth = struct {}
pub const SoupAuth = _SoupAuth
pub const _SoupAuthDomain = struct {}
pub const SoupAuthDomain = _SoupAuthDomain
pub const _SoupCookie = struct {}
pub const SoupCookie = _SoupCookie
pub const _SoupCookieJar = struct {}
pub const SoupCookieJar = _SoupCookieJar
pub const _SoupHSTSEnforcer = struct {}
pub const SoupHSTSEnforcer = _SoupHSTSEnforcer
pub const _SoupHSTSPolicy = struct {}
pub const SoupHSTSPolicy = _SoupHSTSPolicy
pub const _SoupMessage = struct {}
pub const SoupMessage = _SoupMessage
pub const _SoupMessageMetrics = struct {}
pub const SoupMessageMetrics = _SoupMessageMetrics
pub const _SoupServer = struct {}
pub const SoupServer = _SoupServer
pub const _SoupServerMessage = struct {}
pub const SoupServerMessage = _SoupServerMessage
pub const _SoupSession = struct {}
pub const SoupSession = _SoupSession
pub const _SoupSessionFeature = struct {}
pub const SoupSessionFeature = _SoupSessionFeature
pub const _SoupWebsocketConnection = struct {}
pub const SoupWebsocketConnection = _SoupWebsocketConnection
pub const _SoupWebsocketExtension = struct {}
pub const SoupWebsocketExtension = _SoupWebsocketExtension
