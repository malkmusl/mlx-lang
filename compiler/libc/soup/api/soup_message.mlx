// libsoup/soup-message.h
// mlx-soup: SoupMessage, an HTTP request and its response: the method
// and URI, the request's headers and body (a stream or bytes), the
// response's status, reason phrase and headers, the flags and priority
// of its load, what TLS said of the connection, its metrics; its signals
// (wrote-headers, got-headers, got-body, finished, restarted,
// authenticate, accept-certificate, content-sniffed...) follow the load.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gclosure = @import("../../glib/api/gclosure.mlx")
const gbytes = @import("../../glib/api/gbytes.mlx")
const guri = @import("../../glib/api/guri.mlx")
const giotypes = @import("../../glib/api/giotypes.mlx")
const gioenums = @import("../../glib/api/gioenums.mlx")
const types = @import("./soup_types.mlx")
const status = @import("./soup_status.mlx")
const body = @import("./soup_message_body.mlx")
const headers = @import("./soup_message_headers.mlx")
const method = @import("./soup_method.mlx")
const multipart = @import("./soup_multipart.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gssize = gtypes.gssize
const guint = gtypes.guint
const guint64 = gtypes.guint64
const GType = gtype.GType
const GUri = guri.GUri
const GBytes = gbytes.GBytes
const GInputStream = giotypes.GInputStream
const GTlsCertificate = giotypes.GTlsCertificate
const GSocketAddress = giotypes.GSocketAddress
const SoupMessage = types.SoupMessage
const SoupMessageHeaders = headers.SoupMessageHeaders
const SoupMultipart = multipart.SoupMultipart
const SoupHTTPVersion = status.SoupHTTPVersion
const SoupStatus = status.SoupStatus

pub const SOUP_TYPE_MESSAGE: GType = soup_message_get_type()

pub extern("c") fn soup_message_get_type() -> GType
pub extern("c") fn soup_message_new(method_: [*]const gchar, uri_string: [*]const gchar) -> ?*SoupMessage
pub extern("c") fn soup_message_new_from_uri(method_: [*]const gchar, uri: *GUri) -> *SoupMessage
pub extern("c") fn soup_message_new_options_ping(base_uri: *GUri) -> *SoupMessage
pub extern("c") fn soup_message_new_from_encoded_form(method_: [*]const gchar, uri_string: [*]const gchar, encoded_form: [*]gchar) -> ?*SoupMessage
pub extern("c") fn soup_message_new_from_multipart(uri_string: [*]const gchar, multipart_: *SoupMultipart) -> ?*SoupMessage
pub extern("c") fn soup_message_set_request_body(msg: *SoupMessage, content_type: ?[*]const gchar, stream: ?*GInputStream, content_length: gssize) -> void
pub extern("c") fn soup_message_set_request_body_from_bytes(msg: *SoupMessage, content_type: ?[*]const gchar, bytes: ?*GBytes) -> void
pub extern("c") fn soup_message_get_http_version(msg: *SoupMessage) -> SoupHTTPVersion
pub extern("c") fn soup_message_is_keepalive(msg: *SoupMessage) -> gboolean
pub extern("c") fn soup_message_get_uri(msg: *SoupMessage) -> *GUri
pub extern("c") fn soup_message_set_uri(msg: *SoupMessage, uri: *GUri) -> void
pub extern("c") fn soup_message_get_first_party(msg: *SoupMessage) -> ?*GUri
pub extern("c") fn soup_message_set_first_party(msg: *SoupMessage, first_party: ?*GUri) -> void
pub extern("c") fn soup_message_get_site_for_cookies(msg: *SoupMessage) -> ?*GUri
pub extern("c") fn soup_message_set_site_for_cookies(msg: *SoupMessage, site_for_cookies: ?*GUri) -> void
pub extern("c") fn soup_message_set_is_top_level_navigation(msg: *SoupMessage, is_top_level_navigation: gboolean) -> void
pub extern("c") fn soup_message_get_is_top_level_navigation(msg: *SoupMessage) -> gboolean

pub const SoupMessageFlags = enum(c_int) {
    SOUP_MESSAGE_NO_REDIRECT = 2,
    SOUP_MESSAGE_NEW_CONNECTION = 4,
    SOUP_MESSAGE_IDEMPOTENT = 8,
    SOUP_MESSAGE_DO_NOT_USE_AUTH_CACHE = 16,
    SOUP_MESSAGE_COLLECT_METRICS = 32,
}

pub extern("c") fn soup_message_set_flags(msg: *SoupMessage, flags: SoupMessageFlags) -> void
pub extern("c") fn soup_message_get_flags(msg: *SoupMessage) -> SoupMessageFlags
pub extern("c") fn soup_message_add_flags(msg: *SoupMessage, flags: SoupMessageFlags) -> void
pub extern("c") fn soup_message_remove_flags(msg: *SoupMessage, flags: SoupMessageFlags) -> void
pub extern("c") fn soup_message_query_flags(msg: *SoupMessage, flags: SoupMessageFlags) -> gboolean
pub extern("c") fn soup_message_get_tls_peer_certificate(msg: *SoupMessage) -> ?*GTlsCertificate
pub extern("c") fn soup_message_get_tls_peer_certificate_errors(msg: *SoupMessage) -> gioenums.GTlsCertificateFlags
pub extern("c") fn soup_message_get_tls_protocol_version(msg: *SoupMessage) -> gioenums.GTlsProtocolVersion
pub extern("c") fn soup_message_get_tls_ciphersuite_name(msg: *SoupMessage) -> ?[*]const gchar
pub extern("c") fn soup_message_set_tls_client_certificate(msg: *SoupMessage, certificate: ?*GTlsCertificate) -> void
pub extern("c") fn soup_message_tls_client_certificate_password_request_complete(msg: *SoupMessage) -> void
pub extern("c") fn soup_message_add_header_handler(msg: *SoupMessage, signal: [*]const gchar, header: [*]const gchar, callback: gclosure.GCallback, user_data: gpointer) -> guint
pub extern("c") fn soup_message_add_status_code_handler(msg: *SoupMessage, signal: [*]const gchar, status_code: guint, callback: gclosure.GCallback, user_data: gpointer) -> guint
pub extern("c") fn soup_message_disable_feature(msg: *SoupMessage, feature_type: GType) -> void
pub extern("c") fn soup_message_is_feature_disabled(msg: *SoupMessage, feature_type: GType) -> gboolean

pub const SoupMessagePriority = enum(c_int) {
    SOUP_MESSAGE_PRIORITY_VERY_LOW = 0,
    SOUP_MESSAGE_PRIORITY_LOW,
    SOUP_MESSAGE_PRIORITY_NORMAL,
    SOUP_MESSAGE_PRIORITY_HIGH,
    SOUP_MESSAGE_PRIORITY_VERY_HIGH,
}

pub extern("c") fn soup_message_set_priority(msg: *SoupMessage, priority: SoupMessagePriority) -> void
pub extern("c") fn soup_message_get_priority(msg: *SoupMessage) -> SoupMessagePriority
pub extern("c") fn soup_message_get_method(msg: *SoupMessage) -> [*]const gchar
pub extern("c") fn soup_message_set_method(msg: *SoupMessage, method_: [*]const gchar) -> void
pub extern("c") fn soup_message_get_status(msg: *SoupMessage) -> SoupStatus
pub extern("c") fn soup_message_get_reason_phrase(msg: *SoupMessage) -> ?[*]const gchar
pub extern("c") fn soup_message_get_request_headers(msg: *SoupMessage) -> *SoupMessageHeaders
pub extern("c") fn soup_message_get_response_headers(msg: *SoupMessage) -> *SoupMessageHeaders
pub extern("c") fn soup_message_get_is_options_ping(msg: *SoupMessage) -> gboolean
pub extern("c") fn soup_message_set_is_options_ping(msg: *SoupMessage, is_options_ping: gboolean) -> void
pub extern("c") fn soup_message_get_connection_id(msg: *SoupMessage) -> guint64
pub extern("c") fn soup_message_get_remote_address(msg: *SoupMessage) -> ?*GSocketAddress
pub extern("c") fn soup_message_get_metrics(msg: *SoupMessage) -> ?*types.SoupMessageMetrics
pub extern("c") fn soup_message_set_force_http1(msg: *SoupMessage, value: gboolean) -> void
pub extern("c") fn soup_message_get_force_http1(msg: *SoupMessage) -> gboolean

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupMessage, soup_message, SOUP, MESSAGE, GObject)\nG_END_DECLS"
