// libsoup/soup-websocket-extension-manager.h
// mlx-soup: SoupWebsocketExtensionManager, the session feature holding
// the WebSocket extensions a session offers (permessage-deflate from the
// start).
const c_function_pointers = true
const gtype = @import("../../glib/api/gtype.mlx")
const types = @import("./soup_types.mlx")

pub const SOUP_TYPE_WEBSOCKET_EXTENSION_MANAGER: gtype.GType = soup_websocket_extension_manager_get_type()

pub const _SoupWebsocketExtensionManager = struct {}
pub const SoupWebsocketExtensionManager = _SoupWebsocketExtensionManager

pub extern("c") fn soup_websocket_extension_manager_get_type() -> gtype.GType

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupWebsocketExtensionManager, soup_websocket_extension_manager, SOUP, WEBSOCKET_EXTENSION_MANAGER, GObject)\nG_END_DECLS"
