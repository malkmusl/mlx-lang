// libsoup/soup-session.h
// mlx-soup: SoupSession, what sends messages: HTTP/1.1 over connections it
// keeps open and reuses per host (TCP from GIO's socket client; TLS for
// https:// through GIO's TLS connections), following redirects, with the
// features it is given acting on each message; the response's body is a
// stream read as it arrives, at once on the calling thread's main context
// (soup_session_send_async) or read whole (send_and_read). WebSocket
// connections start from it too.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gerror = @import("../../glib/api/gerror.mlx")
const gobject = @import("../../glib/api/gobject.mlx")
const gquark = @import("../../glib/api/gquark.mlx")
const gbytes = @import("../../glib/api/gbytes.mlx")
const giotypes = @import("../../glib/api/giotypes.mlx")
const gioenums = @import("../../glib/api/gioenums.mlx")
const ginetsocketaddress = @import("../../glib/api/ginetsocketaddress.mlx")
const gsocketconnectable = @import("../../glib/api/gsocketconnectable.mlx")
const types = @import("./soup_types.mlx")
const message = @import("./soup_message.mlx")
const websocketconnection = @import("./soup_websocket_connection.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const gssize = gtypes.gssize
const gpointer = gtypes.gpointer
const c_varargs = gtypes.c_varargs
const GType = gtype.GType
const GError = gerror.GError
const GBytes = gbytes.GBytes
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback
const GInputStream = giotypes.GInputStream
const GOutputStream = giotypes.GOutputStream
const SoupSession = types.SoupSession
const SoupMessage = types.SoupMessage
const SoupSessionFeature = types.SoupSessionFeature

pub const SOUP_TYPE_SESSION: GType = soup_session_get_type()

pub const _SoupSessionClass = struct {
    parent_class: gobject.GObjectClass
    request_queued: ?fn(session: *SoupSession, msg: *SoupMessage) -> void
    request_unqueued: ?fn(session: *SoupSession, msg: *SoupMessage) -> void
    _soup_reserved1: ?fn() -> void
    _soup_reserved2: ?fn() -> void
    _soup_reserved3: ?fn() -> void
    _soup_reserved4: ?fn() -> void
    _soup_reserved5: ?fn() -> void
    _soup_reserved6: ?fn() -> void
    _soup_reserved7: ?fn() -> void
    _soup_reserved8: ?fn() -> void
}
pub const SoupSessionClass = _SoupSessionClass

pub extern("c") fn soup_session_error_quark() -> gquark.GQuark
pub const SOUP_SESSION_ERROR: gquark.GQuark = soup_session_error_quark()

pub const SoupSessionError = enum(c_int) {
    SOUP_SESSION_ERROR_PARSING,
    SOUP_SESSION_ERROR_ENCODING,
    SOUP_SESSION_ERROR_TOO_MANY_REDIRECTS,
    SOUP_SESSION_ERROR_TOO_MANY_RESTARTS,
    SOUP_SESSION_ERROR_REDIRECT_NO_LOCATION,
    SOUP_SESSION_ERROR_REDIRECT_BAD_URI,
    SOUP_SESSION_ERROR_MESSAGE_ALREADY_IN_QUEUE,
}

pub extern("c") fn soup_session_get_type() -> GType
pub extern("c") fn soup_session_new() -> *SoupSession
pub extern("c") fn soup_session_new_with_options(optname1: ?[*]const gchar, rest: c_varargs) -> *SoupSession
pub extern("c") fn soup_session_get_local_address(session: *SoupSession) -> ?*ginetsocketaddress.GInetSocketAddress
pub extern("c") fn soup_session_get_max_conns(session: *SoupSession) -> guint
pub extern("c") fn soup_session_get_max_conns_per_host(session: *SoupSession) -> guint
pub extern("c") fn soup_session_set_proxy_resolver(session: *SoupSession, proxy_resolver: ?*giotypes.GProxyResolver) -> void
pub extern("c") fn soup_session_get_proxy_resolver(session: *SoupSession) -> ?*giotypes.GProxyResolver
pub extern("c") fn soup_session_set_tls_database(session: *SoupSession, tls_database: ?*giotypes.GTlsDatabase) -> void
pub extern("c") fn soup_session_get_tls_database(session: *SoupSession) -> ?*giotypes.GTlsDatabase
pub extern("c") fn soup_session_set_tls_interaction(session: *SoupSession, tls_interaction: ?*giotypes.GTlsInteraction) -> void
pub extern("c") fn soup_session_get_tls_interaction(session: *SoupSession) -> ?*giotypes.GTlsInteraction
pub extern("c") fn soup_session_set_timeout(session: *SoupSession, timeout: guint) -> void
pub extern("c") fn soup_session_get_timeout(session: *SoupSession) -> guint
pub extern("c") fn soup_session_set_idle_timeout(session: *SoupSession, timeout: guint) -> void
pub extern("c") fn soup_session_get_idle_timeout(session: *SoupSession) -> guint
pub extern("c") fn soup_session_set_user_agent(session: *SoupSession, user_agent: ?[*]const gchar) -> void
pub extern("c") fn soup_session_get_user_agent(session: *SoupSession) -> ?[*]const gchar
pub extern("c") fn soup_session_set_accept_language(session: *SoupSession, accept_language: ?[*]const gchar) -> void
pub extern("c") fn soup_session_get_accept_language(session: *SoupSession) -> ?[*]const gchar
pub extern("c") fn soup_session_set_accept_language_auto(session: *SoupSession, accept_language_auto: gboolean) -> void
pub extern("c") fn soup_session_get_accept_language_auto(session: *SoupSession) -> gboolean
pub extern("c") fn soup_session_get_remote_connectable(session: *SoupSession) -> ?*gsocketconnectable.GSocketConnectable
pub extern("c") fn soup_session_abort(session: *SoupSession) -> void
pub extern("c") fn soup_session_send_async(session: *SoupSession, msg: *SoupMessage, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn soup_session_send_finish(session: *SoupSession, result: *GAsyncResult, error_: ?**GError) -> ?*GInputStream
pub extern("c") fn soup_session_send(session: *SoupSession, msg: *SoupMessage, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GInputStream
pub extern("c") fn soup_session_send_and_read_async(session: *SoupSession, msg: *SoupMessage, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn soup_session_send_and_read_finish(session: *SoupSession, result: *GAsyncResult, error_: ?**GError) -> ?*GBytes
pub extern("c") fn soup_session_send_and_read(session: *SoupSession, msg: *SoupMessage, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GBytes
pub extern("c") fn soup_session_send_and_splice_async(session: *SoupSession, msg: *SoupMessage, out_stream: *GOutputStream, flags: gioenums.GOutputStreamSpliceFlags, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn soup_session_send_and_splice_finish(session: *SoupSession, result: *GAsyncResult, error_: ?**GError) -> gssize
pub extern("c") fn soup_session_send_and_splice(session: *SoupSession, msg: *SoupMessage, out_stream: *GOutputStream, flags: gioenums.GOutputStreamSpliceFlags, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn soup_session_get_async_result_message(session: *SoupSession, result: *GAsyncResult) -> ?*SoupMessage
pub extern("c") fn soup_session_add_feature(session: *SoupSession, feature: *SoupSessionFeature) -> void
pub extern("c") fn soup_session_add_feature_by_type(session: *SoupSession, feature_type: GType) -> void
pub extern("c") fn soup_session_remove_feature(session: *SoupSession, feature: *SoupSessionFeature) -> void
pub extern("c") fn soup_session_remove_feature_by_type(session: *SoupSession, feature_type: GType) -> void
pub extern("c") fn soup_session_has_feature(session: *SoupSession, feature_type: GType) -> gboolean
pub extern("c") fn soup_session_get_feature(session: *SoupSession, feature_type: GType) -> ?*SoupSessionFeature
pub extern("c") fn soup_session_get_feature_for_message(session: *SoupSession, feature_type: GType, msg: *SoupMessage) -> ?*SoupSessionFeature
pub extern("c") fn soup_session_websocket_connect_async(session: *SoupSession, msg: *SoupMessage, origin: ?[*]const gchar, protocols: ?*[*]gchar, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn soup_session_websocket_connect_finish(session: *SoupSession, result: *GAsyncResult, error_: ?**GError) -> ?*types.SoupWebsocketConnection
pub extern("c") fn soup_session_preconnect_async(session: *SoupSession, msg: *SoupMessage, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn soup_session_preconnect_finish(session: *SoupSession, result: *GAsyncResult, error_: ?**GError) -> gboolean

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_DERIVABLE_TYPE (SoupSession, soup_session, SOUP, SESSION, GObject)\nG_END_DECLS"
