// libsoup/soup-cache.h
// mlx-soup: SoupCache, an HTTP cache (RFC 9111) as a session feature: the
// cacheability of a response, its freshness, and the store of responses
// in a directory. WebKit keeps its own cache (NetworkCache) and does not
// add this one to its sessions.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gobject = @import("../../glib/api/gobject.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const guint = gtypes.guint
const gpointer = gtypes.gpointer
const SoupMessage = types.SoupMessage

pub const SOUP_TYPE_CACHE: gtype.GType = soup_cache_get_type()

pub const _SoupCache = struct {}
pub const SoupCache = _SoupCache

pub const SoupCacheability = enum(c_int) {
    SOUP_CACHE_CACHEABLE = 1,
    SOUP_CACHE_UNCACHEABLE = 2,
    SOUP_CACHE_INVALIDATES = 4,
    SOUP_CACHE_VALIDATES = 8,
}

pub const SoupCacheType = enum(c_int) {
    SOUP_CACHE_SINGLE_USER,
    SOUP_CACHE_SHARED,
}

pub const _SoupCacheClass = struct {
    parent_class: gobject.GObjectClass
    get_cacheability: ?fn(cache: *SoupCache, msg: *SoupMessage) -> SoupCacheability
    padding: [4]gpointer
}
pub const SoupCacheClass = _SoupCacheClass

pub extern("c") fn soup_cache_get_type() -> gtype.GType
pub extern("c") fn soup_cache_new(cache_dir: ?[*]const gchar, cache_type: SoupCacheType) -> *SoupCache
pub extern("c") fn soup_cache_flush(cache: *SoupCache) -> void
pub extern("c") fn soup_cache_clear(cache: *SoupCache) -> void
pub extern("c") fn soup_cache_dump(cache: *SoupCache) -> void
pub extern("c") fn soup_cache_load(cache: *SoupCache) -> void
pub extern("c") fn soup_cache_set_max_size(cache: *SoupCache, max_size: guint) -> void
pub extern("c") fn soup_cache_get_max_size(cache: *SoupCache) -> guint

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_DERIVABLE_TYPE (SoupCache, soup_cache, SOUP, CACHE, GObject)\nG_END_DECLS"
