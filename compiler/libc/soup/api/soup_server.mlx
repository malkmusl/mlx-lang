// libsoup/soup-server.h
// mlx-soup: SoupServer, an HTTP/1.1 server on the GLib main loop: it
// listens on addresses or sockets, reads requests, runs the handler of
// the longest path that covers each (early handlers before the body,
// WebSocket handlers for upgrades), and writes the responses (WebKit's
// remote inspector serves its pages with one).
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gerror = @import("../../glib/api/gerror.mlx")
const gobject = @import("../../glib/api/gobject.mlx")
const gslist = @import("../../glib/api/gslist.mlx")
const ghash = @import("../../glib/api/ghash.mlx")
const giotypes = @import("../../glib/api/giotypes.mlx")
const gioenums = @import("../../glib/api/gioenums.mlx")
const types = @import("./soup_types.mlx")
const uriutils = @import("./soup_uri_utils.mlx")
const websocketconnection = @import("./soup_websocket_connection.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const gpointer = gtypes.gpointer
const GDestroyNotify = gtypes.GDestroyNotify
const c_varargs = gtypes.c_varargs
const GError = gerror.GError
const GType = gtype.GType
const SoupServer = types.SoupServer
const SoupServerMessage = types.SoupServerMessage

pub const SOUP_TYPE_SERVER: GType = soup_server_get_type()

pub const SoupServerListenOptions = enum(c_int) {
    SOUP_SERVER_LISTEN_HTTPS = 1,
    SOUP_SERVER_LISTEN_IPV4_ONLY = 2,
    SOUP_SERVER_LISTEN_IPV6_ONLY = 4,
}

pub const _SoupServerClass = struct {
    parent_class: gobject.GObjectClass
    request_started: ?fn(server: *SoupServer, msg: *SoupServerMessage) -> void
    request_read: ?fn(server: *SoupServer, msg: *SoupServerMessage) -> void
    request_finished: ?fn(server: *SoupServer, msg: *SoupServerMessage) -> void
    request_aborted: ?fn(server: *SoupServer, msg: *SoupServerMessage) -> void
    padding: [6]gpointer
}
pub const SoupServerClass = _SoupServerClass

pub const SoupServerCallback = fn(server: *SoupServer, msg: *SoupServerMessage, path: [*]const gchar, query: ?*ghash.GHashTable, user_data: gpointer) -> void
pub const SoupServerWebsocketCallback = fn(server: *SoupServer, msg: *SoupServerMessage, path: [*]const gchar, connection: *types.SoupWebsocketConnection, user_data: gpointer) -> void

pub extern("c") fn soup_server_get_type() -> GType
pub extern("c") fn soup_server_new(optname1: ?[*]const gchar, rest: c_varargs) -> ?*SoupServer
pub extern("c") fn soup_server_set_tls_certificate(server: *SoupServer, certificate: *giotypes.GTlsCertificate) -> void
pub extern("c") fn soup_server_get_tls_certificate(server: *SoupServer) -> ?*giotypes.GTlsCertificate
pub extern("c") fn soup_server_set_tls_database(server: *SoupServer, tls_database: *giotypes.GTlsDatabase) -> void
pub extern("c") fn soup_server_get_tls_database(server: *SoupServer) -> ?*giotypes.GTlsDatabase
pub extern("c") fn soup_server_set_tls_auth_mode(server: *SoupServer, mode: gioenums.GTlsAuthenticationMode) -> void
pub extern("c") fn soup_server_get_tls_auth_mode(server: *SoupServer) -> gioenums.GTlsAuthenticationMode
pub extern("c") fn soup_server_is_https(server: *SoupServer) -> gboolean
pub extern("c") fn soup_server_listen(server: *SoupServer, address: *giotypes.GSocketAddress, options: SoupServerListenOptions, error_: ?**GError) -> gboolean
pub extern("c") fn soup_server_listen_all(server: *SoupServer, port: guint, options: SoupServerListenOptions, error_: ?**GError) -> gboolean
pub extern("c") fn soup_server_listen_local(server: *SoupServer, port: guint, options: SoupServerListenOptions, error_: ?**GError) -> gboolean
pub extern("c") fn soup_server_listen_socket(server: *SoupServer, socket: *giotypes.GSocket, options: SoupServerListenOptions, error_: ?**GError) -> gboolean
pub extern("c") fn soup_server_get_uris(server: *SoupServer) -> ?*gslist.GSList
pub extern("c") fn soup_server_get_listeners(server: *SoupServer) -> ?*gslist.GSList
pub extern("c") fn soup_server_disconnect(server: *SoupServer) -> void
pub extern("c") fn soup_server_accept_iostream(server: *SoupServer, stream: *giotypes.GIOStream, local_addr: ?*giotypes.GSocketAddress, remote_addr: ?*giotypes.GSocketAddress, error_: ?**GError) -> gboolean
pub extern("c") fn soup_server_add_handler(server: *SoupServer, path: ?[*]const gchar, callback: SoupServerCallback, user_data: gpointer, destroy: ?GDestroyNotify) -> void
pub extern("c") fn soup_server_add_early_handler(server: *SoupServer, path: ?[*]const gchar, callback: SoupServerCallback, user_data: gpointer, destroy: ?GDestroyNotify) -> void
pub extern("c") fn soup_server_add_websocket_handler(server: *SoupServer, path: ?[*]const gchar, origin: ?[*]const gchar, protocols: ?*[*]gchar, callback: SoupServerWebsocketCallback, user_data: gpointer, destroy: ?GDestroyNotify) -> void
pub extern("c") fn soup_server_add_websocket_extension(server: *SoupServer, extension_type: GType) -> void
pub extern("c") fn soup_server_remove_websocket_extension(server: *SoupServer, extension_type: GType) -> void
pub extern("c") fn soup_server_remove_handler(server: *SoupServer, path: [*]const gchar) -> void
pub extern("c") fn soup_server_add_auth_domain(server: *SoupServer, auth_domain: *types.SoupAuthDomain) -> void
pub extern("c") fn soup_server_remove_auth_domain(server: *SoupServer, auth_domain: *types.SoupAuthDomain) -> void
pub extern("c") fn soup_server_pause_message(server: *SoupServer, msg: *SoupServerMessage) -> void
pub extern("c") fn soup_server_unpause_message(server: *SoupServer, msg: *SoupServerMessage) -> void

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_DERIVABLE_TYPE (SoupServer, soup_server, SOUP, SERVER, GObject)\nG_END_DECLS"
