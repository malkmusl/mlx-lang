// libsoup/soup-auth-domain-digest.h
// mlx-soup: SoupAuthDomainDigest, a server's protection space checked by
// HTTP Digest authentication (MD5, as libsoup does it).
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const types = @import("./soup_types.mlx")
const domain = @import("./soup_auth_domain.mlx")

const gchar = gtypes.gchar
const gpointer = gtypes.gpointer
const GDestroyNotify = gtypes.GDestroyNotify
const c_varargs = gtypes.c_varargs
const SoupAuthDomain = types.SoupAuthDomain
const SoupServerMessage = types.SoupServerMessage

pub const SOUP_TYPE_AUTH_DOMAIN_DIGEST: gtype.GType = soup_auth_domain_digest_get_type()

pub const _SoupAuthDomainDigest = struct {}
pub const SoupAuthDomainDigest = _SoupAuthDomainDigest

pub const SoupAuthDomainDigestAuthCallback = fn(domain_: *SoupAuthDomain, msg: *SoupServerMessage, username: [*]const gchar, user_data: gpointer) -> ?[*]gchar

pub extern("c") fn soup_auth_domain_digest_get_type() -> gtype.GType
pub extern("c") fn soup_auth_domain_digest_new(optname1: ?[*]const gchar, rest: c_varargs) -> *SoupAuthDomain
pub extern("c") fn soup_auth_domain_digest_set_auth_callback(domain_: *SoupAuthDomain, callback: ?SoupAuthDomainDigestAuthCallback, user_data: gpointer, dnotify: ?GDestroyNotify) -> void
pub extern("c") fn soup_auth_domain_digest_encode_password(username: [*]const gchar, realm: [*]const gchar, password: [*]const gchar) -> [*]gchar

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupAuthDomainDigest, soup_auth_domain_digest, SOUP, AUTH_DOMAIN_DIGEST, SoupAuthDomain)\nG_END_DECLS"
