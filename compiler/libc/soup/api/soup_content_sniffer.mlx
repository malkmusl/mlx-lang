// libsoup/soup-content-sniffer.h
// mlx-soup: SoupContentSniffer, the session feature that finds the type
// of a response's content from its first bytes as the MIME Sniffing
// Standard says (and libsoup does), and tells it with the message's
// "content-sniffed" signal.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gbytes = @import("../../glib/api/gbytes.mlx")
const ghash = @import("../../glib/api/ghash.mlx")
const types = @import("./soup_types.mlx")
const body = @import("./soup_message_body.mlx")

const gchar = gtypes.gchar

pub const SOUP_TYPE_CONTENT_SNIFFER: gtype.GType = soup_content_sniffer_get_type()

pub const _SoupContentSniffer = struct {}
pub const SoupContentSniffer = _SoupContentSniffer

pub extern("c") fn soup_content_sniffer_get_type() -> gtype.GType
pub extern("c") fn soup_content_sniffer_new() -> *SoupContentSniffer
pub extern("c") fn soup_content_sniffer_sniff(sniffer: *SoupContentSniffer, msg: *types.SoupMessage, buffer: *gbytes.GBytes, params: ?**ghash.GHashTable) -> [*]gchar

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupContentSniffer, soup_content_sniffer, SOUP, CONTENT_SNIFFER, GObject)\nG_END_DECLS"
