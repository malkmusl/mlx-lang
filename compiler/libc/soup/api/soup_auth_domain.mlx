// libsoup/soup-auth-domain.h
// mlx-soup: SoupAuthDomain, a server's protection space: the paths it
// covers (and a filter), the realm, and how a request's credentials are
// checked and a challenge is made for one without them.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gobject = @import("../../glib/api/gobject.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GDestroyNotify = gtypes.GDestroyNotify
const SoupAuthDomain = types.SoupAuthDomain
const SoupServerMessage = types.SoupServerMessage

pub const SOUP_TYPE_AUTH_DOMAIN: gtype.GType = soup_auth_domain_get_type()

pub const _SoupAuthDomainClass = struct {
    parent_class: gobject.GObjectClass
    accepts: ?fn(domain: *SoupAuthDomain, msg: *SoupServerMessage, header: [*]const gchar) -> ?[*]gchar
    challenge: ?fn(domain: *SoupAuthDomain, msg: *SoupServerMessage) -> [*]gchar
    check_password: ?fn(domain: *SoupAuthDomain, msg: *SoupServerMessage, username: [*]const gchar, password: [*]const gchar) -> gboolean
    padding: [6]gpointer
}
pub const SoupAuthDomainClass = _SoupAuthDomainClass

pub const SoupAuthDomainFilter = fn(domain: *SoupAuthDomain, msg: *SoupServerMessage, user_data: gpointer) -> gboolean
pub const SoupAuthDomainGenericAuthCallback = fn(domain: *SoupAuthDomain, msg: *SoupServerMessage, username: [*]const gchar, user_data: gpointer) -> gboolean

pub extern("c") fn soup_auth_domain_get_type() -> gtype.GType
pub extern("c") fn soup_auth_domain_add_path(domain: *SoupAuthDomain, path: [*]const gchar) -> void
pub extern("c") fn soup_auth_domain_remove_path(domain: *SoupAuthDomain, path: [*]const gchar) -> void
pub extern("c") fn soup_auth_domain_set_filter(domain: *SoupAuthDomain, filter: ?SoupAuthDomainFilter, filter_data: gpointer, dnotify: ?GDestroyNotify) -> void
pub extern("c") fn soup_auth_domain_get_realm(domain: *SoupAuthDomain) -> [*]const gchar
pub extern("c") fn soup_auth_domain_set_generic_auth_callback(domain: *SoupAuthDomain, auth_callback: ?SoupAuthDomainGenericAuthCallback, auth_data: gpointer, dnotify: ?GDestroyNotify) -> void
pub extern("c") fn soup_auth_domain_check_password(domain: *SoupAuthDomain, msg: *SoupServerMessage, username: [*]const gchar, password: [*]const gchar) -> gboolean
pub extern("c") fn soup_auth_domain_covers(domain: *SoupAuthDomain, msg: *SoupServerMessage) -> gboolean
pub extern("c") fn soup_auth_domain_accepts(domain: *SoupAuthDomain, msg: *SoupServerMessage) -> ?[*]gchar
pub extern("c") fn soup_auth_domain_challenge(domain: *SoupAuthDomain, msg: *SoupServerMessage) -> void

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_DERIVABLE_TYPE (SoupAuthDomain, soup_auth_domain, SOUP, AUTH_DOMAIN, GObject)\nG_END_DECLS"
