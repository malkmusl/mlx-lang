// libsoup/soup-cookie-jar-text.h
// mlx-soup: SoupCookieJarText, a cookie jar kept in a text file of
// Mozilla's cookies.txt form, read when the jar is made and written
// whenever a cookie changes.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const jar = @import("./soup_cookie_jar.mlx")
const types = @import("./soup_types.mlx")

pub const SOUP_TYPE_COOKIE_JAR_TEXT: gtype.GType = soup_cookie_jar_text_get_type()

pub const _SoupCookieJarText = struct {}
pub const SoupCookieJarText = _SoupCookieJarText

pub extern("c") fn soup_cookie_jar_text_get_type() -> gtype.GType
pub extern("c") fn soup_cookie_jar_text_new(filename: [*]const gtypes.gchar, read_only: gtypes.gboolean) -> *types.SoupCookieJar

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupCookieJarText, soup_cookie_jar_text, SOUP, COOKIE_JAR_TEXT, SoupCookieJar)\nG_END_DECLS"
