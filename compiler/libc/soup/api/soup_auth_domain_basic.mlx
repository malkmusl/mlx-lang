// libsoup/soup-auth-domain-basic.h
// mlx-soup: SoupAuthDomainBasic, a server's protection space checked by
// HTTP Basic authentication.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const types = @import("./soup_types.mlx")
const domain = @import("./soup_auth_domain.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GDestroyNotify = gtypes.GDestroyNotify
const c_varargs = gtypes.c_varargs
const SoupAuthDomain = types.SoupAuthDomain
const SoupServerMessage = types.SoupServerMessage

pub const SOUP_TYPE_AUTH_DOMAIN_BASIC: gtype.GType = soup_auth_domain_basic_get_type()

pub const _SoupAuthDomainBasic = struct {}
pub const SoupAuthDomainBasic = _SoupAuthDomainBasic

pub const SoupAuthDomainBasicAuthCallback = fn(domain_: *SoupAuthDomain, msg: *SoupServerMessage, username: [*]const gchar, password: [*]const gchar, user_data: gpointer) -> gboolean

pub extern("c") fn soup_auth_domain_basic_get_type() -> gtype.GType
pub extern("c") fn soup_auth_domain_basic_new(optname1: ?[*]const gchar, rest: c_varargs) -> *SoupAuthDomain
pub extern("c") fn soup_auth_domain_basic_set_auth_callback(domain_: *SoupAuthDomain, callback: ?SoupAuthDomainBasicAuthCallback, user_data: gpointer, dnotify: ?GDestroyNotify) -> void

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupAuthDomainBasic, soup_auth_domain_basic, SOUP, AUTH_DOMAIN_BASIC, SoupAuthDomain)\nG_END_DECLS"
