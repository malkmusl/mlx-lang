// libsoup/soup-message-metrics.h
// mlx-soup: SoupMessageMetrics, when each stage of a message's load
// happened (monotonic microseconds) and how many bytes went each way,
// collected for messages with SOUP_MESSAGE_COLLECT_METRICS.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const types = @import("./soup_types.mlx")

const guint64 = gtypes.guint64
const SoupMessageMetrics = types.SoupMessageMetrics

pub extern("c") fn soup_message_metrics_get_type() -> gtype.GType
pub const SOUP_TYPE_MESSAGE_METRICS: gtype.GType = soup_message_metrics_get_type()

pub extern("c") fn soup_message_metrics_copy(metrics: *SoupMessageMetrics) -> *SoupMessageMetrics
pub extern("c") fn soup_message_metrics_free(metrics: *SoupMessageMetrics) -> void
pub extern("c") fn soup_message_metrics_get_fetch_start(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_dns_start(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_dns_end(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_connect_start(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_connect_end(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_tls_start(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_request_start(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_response_start(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_response_end(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_request_header_bytes_sent(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_request_body_size(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_request_body_bytes_sent(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_response_header_bytes_received(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_response_body_size(metrics: *SoupMessageMetrics) -> guint64
pub extern("c") fn soup_message_metrics_get_response_body_bytes_received(metrics: *SoupMessageMetrics) -> guint64

const c_macros = "G_BEGIN_DECLS\nG_DEFINE_AUTOPTR_CLEANUP_FUNC (SoupMessageMetrics, soup_message_metrics_free)\nG_END_DECLS"
