// libsoup/soup-websocket-connection.h
// mlx-soup: SoupWebsocketConnection, a WebSocket connection over an
// IOStream once the handshake is done: messages (text and binary) sent
// and received as frames, pings and pongs, the closing handshake and its
// code and reason, extensions (permessage-deflate) applied to each
// message.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gbytes = @import("../../glib/api/gbytes.mlx")
const glist = @import("../../glib/api/glist.mlx")
const guri = @import("../../glib/api/guri.mlx")
const giotypes = @import("../../glib/api/giotypes.mlx")
const types = @import("./soup_types.mlx")
const websocket = @import("./soup_websocket.mlx")

const gchar = gtypes.gchar
const guint = gtypes.guint
const gushort = gtypes.gushort
const guint64 = gtypes.guint64
const gsize = gtypes.gsize
const gconstpointer = gtypes.gconstpointer
const SoupWebsocketConnection = types.SoupWebsocketConnection

pub const SOUP_TYPE_WEBSOCKET_CONNECTION: gtype.GType = soup_websocket_connection_get_type()

pub extern("c") fn soup_websocket_connection_get_type() -> gtype.GType
pub extern("c") fn soup_websocket_connection_new(stream: *giotypes.GIOStream, uri: *guri.GUri, type_: websocket.SoupWebsocketConnectionType, origin: ?[*]const gchar, protocol: ?[*]const gchar, extensions: ?*glist.GList) -> *SoupWebsocketConnection
pub extern("c") fn soup_websocket_connection_get_io_stream(self: *SoupWebsocketConnection) -> *giotypes.GIOStream
pub extern("c") fn soup_websocket_connection_get_connection_type(self: *SoupWebsocketConnection) -> websocket.SoupWebsocketConnectionType
pub extern("c") fn soup_websocket_connection_get_uri(self: *SoupWebsocketConnection) -> *guri.GUri
pub extern("c") fn soup_websocket_connection_get_origin(self: *SoupWebsocketConnection) -> ?[*]const gchar
pub extern("c") fn soup_websocket_connection_get_protocol(self: *SoupWebsocketConnection) -> ?[*]const gchar
pub extern("c") fn soup_websocket_connection_get_extensions(self: *SoupWebsocketConnection) -> ?*glist.GList
pub extern("c") fn soup_websocket_connection_get_state(self: *SoupWebsocketConnection) -> websocket.SoupWebsocketState
pub extern("c") fn soup_websocket_connection_get_close_code(self: *SoupWebsocketConnection) -> gushort
pub extern("c") fn soup_websocket_connection_get_close_data(self: *SoupWebsocketConnection) -> ?[*]const gchar
pub extern("c") fn soup_websocket_connection_send_text(self: *SoupWebsocketConnection, text: [*]const gchar) -> void
pub extern("c") fn soup_websocket_connection_send_binary(self: *SoupWebsocketConnection, data: ?gconstpointer, length: gsize) -> void
pub extern("c") fn soup_websocket_connection_send_message(self: *SoupWebsocketConnection, type_: websocket.SoupWebsocketDataType, message: *gbytes.GBytes) -> void
pub extern("c") fn soup_websocket_connection_close(self: *SoupWebsocketConnection, code: gushort, data: ?[*]const gchar) -> void
pub extern("c") fn soup_websocket_connection_get_max_incoming_payload_size(self: *SoupWebsocketConnection) -> guint64
pub extern("c") fn soup_websocket_connection_set_max_incoming_payload_size(self: *SoupWebsocketConnection, max_incoming_payload_size: guint64) -> void
pub extern("c") fn soup_websocket_connection_get_keepalive_interval(self: *SoupWebsocketConnection) -> guint
pub extern("c") fn soup_websocket_connection_set_keepalive_interval(self: *SoupWebsocketConnection, interval: guint) -> void

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupWebsocketConnection, soup_websocket_connection, SOUP, WEBSOCKET_CONNECTION, GObject)\nG_END_DECLS"
