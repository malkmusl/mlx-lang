// libsoup/soup-uri-utils.h
// mlx-soup: what libsoup adds to GLib's GUri: data: URIs decoded, URIs
// compared as HTTP compares them, copies with components replaced, and
// the flags HTTP URIs are parsed with.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gbytes = @import("../../glib/api/gbytes.mlx")
const guri = @import("../../glib/api/guri.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const c_varargs = gtypes.c_varargs
const GUri = guri.GUri
pub const c_tokens = usize

pub const SoupURIComponent = enum(c_int) {
    SOUP_URI_NONE,
    SOUP_URI_SCHEME,
    SOUP_URI_USER,
    SOUP_URI_PASSWORD,
    SOUP_URI_AUTH_PARAMS,
    SOUP_URI_HOST,
    SOUP_URI_PORT,
    SOUP_URI_PATH,
    SOUP_URI_QUERY,
    SOUP_URI_FRAGMENT,
}

pub extern("c") fn soup_uri_decode_data_uri(uri: [*]const gchar, content_type: ?*[*]gchar) -> ?*gbytes.GBytes
pub extern("c") fn soup_uri_equal(uri1: *GUri, uri2: *GUri) -> gboolean
pub extern("c") fn soup_uri_copy(uri: *GUri, first_component: SoupURIComponent, rest: c_varargs) -> *GUri

pub const SOUP_HTTP_URI_FLAGS: c_tokens = "(G_URI_FLAGS_HAS_PASSWORD | G_URI_FLAGS_ENCODED_PATH | G_URI_FLAGS_ENCODED_QUERY | G_URI_FLAGS_ENCODED_FRAGMENT | G_URI_FLAGS_SCHEME_NORMALIZE)"
