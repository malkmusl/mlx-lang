// libsoup/soup-message-body.h
// mlx-soup: SoupMessageBody, a body kept as the chunks it came in (GBytes),
// whose `data` and `length` are the chunks joined once it is complete or
// flattened.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gbytes = @import("../../glib/api/gbytes.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const guchar = gtypes.guchar
const gboolean = gtypes.gboolean
const gconstpointer = gtypes.gconstpointer
const gsize = gtypes.gsize
const goffset = gtypes.goffset
const GBytes = gbytes.GBytes

pub const SoupMemoryUse = enum(c_int) {
    SOUP_MEMORY_STATIC,
    SOUP_MEMORY_TAKE,
    SOUP_MEMORY_COPY,
}

pub const SoupMessageBody = struct {
    data: ?[*]const gchar
    length: goffset
}

pub extern("c") fn soup_message_body_get_type() -> gtype.GType
pub const SOUP_TYPE_MESSAGE_BODY: gtype.GType = soup_message_body_get_type()

pub extern("c") fn soup_message_body_new() -> *SoupMessageBody
pub extern("c") fn soup_message_body_ref(body: *SoupMessageBody) -> *SoupMessageBody
pub extern("c") fn soup_message_body_unref(body: *SoupMessageBody) -> void
pub extern("c") fn soup_message_body_set_accumulate(body: *SoupMessageBody, accumulate: gboolean) -> void
pub extern("c") fn soup_message_body_get_accumulate(body: *SoupMessageBody) -> gboolean
pub extern("c") fn soup_message_body_append(body: *SoupMessageBody, use: SoupMemoryUse, data: ?gconstpointer, length: gsize) -> void
pub extern("c") fn soup_message_body_append_take(body: *SoupMessageBody, data: ?*guchar, length: gsize) -> void
pub extern("c") fn soup_message_body_append_bytes(body: *SoupMessageBody, buffer: *GBytes) -> void
pub extern("c") fn soup_message_body_truncate(body: *SoupMessageBody) -> void
pub extern("c") fn soup_message_body_complete(body: *SoupMessageBody) -> void
pub extern("c") fn soup_message_body_flatten(body: *SoupMessageBody) -> *GBytes
pub extern("c") fn soup_message_body_get_chunk(body: *SoupMessageBody, offset: goffset) -> ?*GBytes
pub extern("c") fn soup_message_body_got_chunk(body: *SoupMessageBody, chunk: *GBytes) -> void
pub extern("c") fn soup_message_body_wrote_chunk(body: *SoupMessageBody, chunk: *GBytes) -> void

const c_macros = "G_BEGIN_DECLS\nG_DEFINE_AUTOPTR_CLEANUP_FUNC (SoupMessageBody, soup_message_body_unref)\nG_END_DECLS"
