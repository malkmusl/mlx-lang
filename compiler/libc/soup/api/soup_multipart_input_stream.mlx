// libsoup/soup-multipart-input-stream.h
// mlx-soup: SoupMultipartInputStream, a multipart response read part by
// part as it arrives: each part a stream of its own, with its headers
// (multipart/x-mixed-replace, as WebKit's loads of MJPEG streams read).
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gerror = @import("../../glib/api/gerror.mlx")
const giotypes = @import("../../glib/api/giotypes.mlx")
const types = @import("./soup_types.mlx")
const headers = @import("./soup_message_headers.mlx")

const gpointer = gtypes.gpointer
const GError = gerror.GError
const GInputStream = giotypes.GInputStream
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult

pub const SOUP_TYPE_MULTIPART_INPUT_STREAM: gtype.GType = soup_multipart_input_stream_get_type()

pub const _SoupMultipartInputStream = struct {}
pub const SoupMultipartInputStream = _SoupMultipartInputStream

pub extern("c") fn soup_multipart_input_stream_get_type() -> gtype.GType
pub extern("c") fn soup_multipart_input_stream_new(msg: *types.SoupMessage, base_stream: *GInputStream) -> *SoupMultipartInputStream
pub extern("c") fn soup_multipart_input_stream_next_part(multipart: *SoupMultipartInputStream, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GInputStream
pub extern("c") fn soup_multipart_input_stream_next_part_async(multipart: *SoupMultipartInputStream, io_priority: c_int, cancellable: ?*GCancellable, callback: ?giotypes.GAsyncReadyCallback, data: gpointer) -> void
pub extern("c") fn soup_multipart_input_stream_next_part_finish(multipart: *SoupMultipartInputStream, result: *GAsyncResult, error_: ?**GError) -> ?*GInputStream
pub extern("c") fn soup_multipart_input_stream_get_headers(multipart: *SoupMultipartInputStream) -> ?*headers.SoupMessageHeaders

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupMultipartInputStream, soup_multipart_input_stream, SOUP, MULTIPART_INPUT_STREAM, GFilterInputStream)\nG_END_DECLS"
