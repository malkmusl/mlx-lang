// libsoup/soup-date-utils.h
// mlx-soup: dates as HTTP writes them (RFC 9110's IMF-fixdate, and the
// cookie form of Netscape's Expires), and HTTP dates of every form
// servers send read back (RFC 850's, asctime's and what libsoup also
// takes).
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gdatetime = @import("../../glib/api/gdatetime.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const GDateTime = gdatetime.GDateTime

pub const SoupDateFormat = enum(c_int) {
    SOUP_DATE_HTTP = 1,
    SOUP_DATE_COOKIE,
}

pub extern("c") fn soup_date_time_to_string(date: *GDateTime, format: SoupDateFormat) -> [*]gchar
pub extern("c") fn soup_date_time_new_from_http_string(date_string: [*]const gchar) -> ?*GDateTime
