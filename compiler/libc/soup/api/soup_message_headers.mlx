// libsoup/soup-message-headers.h
// mlx-soup: SoupMessageHeaders, the headers of a request, a response or
// a multipart body's part: names compared without case, values in the
// order they came, the headers libsoup gives meaning to (Content-Length,
// Transfer-Encoding, Expect, Range, Content-Range, Content-Type,
// Content-Disposition) read and written by their own functions.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const ghash = @import("../../glib/api/ghash.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const goffset = gtypes.goffset
const GHashTable = ghash.GHashTable

pub const _SoupMessageHeaders = struct {}
pub const SoupMessageHeaders = _SoupMessageHeaders

pub extern("c") fn soup_message_headers_get_type() -> gtype.GType
pub const SOUP_TYPE_MESSAGE_HEADERS: gtype.GType = soup_message_headers_get_type()

pub const SoupMessageHeadersType = enum(c_int) {
    SOUP_MESSAGE_HEADERS_REQUEST,
    SOUP_MESSAGE_HEADERS_RESPONSE,
    SOUP_MESSAGE_HEADERS_MULTIPART,
}

pub extern("c") fn soup_message_headers_new(type_: SoupMessageHeadersType) -> *SoupMessageHeaders
pub extern("c") fn soup_message_headers_ref(hdrs: *SoupMessageHeaders) -> *SoupMessageHeaders
pub extern("c") fn soup_message_headers_unref(hdrs: *SoupMessageHeaders) -> void
pub extern("c") fn soup_message_headers_append(hdrs: *SoupMessageHeaders, name: [*]const gchar, value: [*]const gchar) -> void
pub extern("c") fn soup_message_headers_replace(hdrs: *SoupMessageHeaders, name: [*]const gchar, value: [*]const gchar) -> void
pub extern("c") fn soup_message_headers_remove(hdrs: *SoupMessageHeaders, name: [*]const gchar) -> void
pub extern("c") fn soup_message_headers_clear(hdrs: *SoupMessageHeaders) -> void
pub extern("c") fn soup_message_headers_clean_connection_headers(hdrs: *SoupMessageHeaders) -> void
pub extern("c") fn soup_message_headers_get_one(hdrs: *SoupMessageHeaders, name: [*]const gchar) -> ?[*]const gchar
pub extern("c") fn soup_message_headers_get_list(hdrs: *SoupMessageHeaders, name: [*]const gchar) -> ?[*]const gchar
pub extern("c") fn soup_message_headers_header_contains(hdrs: *SoupMessageHeaders, name: [*]const gchar, token: [*]const gchar) -> gboolean
pub extern("c") fn soup_message_headers_header_equals(hdrs: *SoupMessageHeaders, name: [*]const gchar, value: [*]const gchar) -> gboolean

pub const SoupMessageHeadersForeachFunc = fn(name: [*]const gchar, value: [*]const gchar, user_data: gpointer) -> void

pub extern("c") fn soup_message_headers_foreach(hdrs: *SoupMessageHeaders, func: SoupMessageHeadersForeachFunc, user_data: gpointer) -> void
pub extern("c") fn soup_message_headers_get_headers_type(hdrs: *SoupMessageHeaders) -> SoupMessageHeadersType

// An iteration over the headers (the headers and where it is).
pub const SoupMessageHeadersIter = struct {
    dummy: [3]gpointer
}

pub extern("c") fn soup_message_headers_iter_init(iter: *SoupMessageHeadersIter, hdrs: *SoupMessageHeaders) -> void
pub extern("c") fn soup_message_headers_iter_next(iter: *SoupMessageHeadersIter, name: *[*]const gchar, value: *[*]const gchar) -> gboolean

pub const SoupEncoding = enum(c_int) {
    SOUP_ENCODING_UNRECOGNIZED,
    SOUP_ENCODING_NONE,
    SOUP_ENCODING_CONTENT_LENGTH,
    SOUP_ENCODING_EOF,
    SOUP_ENCODING_CHUNKED,
    SOUP_ENCODING_BYTERANGES,
}

pub extern("c") fn soup_message_headers_get_encoding(hdrs: *SoupMessageHeaders) -> SoupEncoding
pub extern("c") fn soup_message_headers_set_encoding(hdrs: *SoupMessageHeaders, encoding: SoupEncoding) -> void
pub extern("c") fn soup_message_headers_get_content_length(hdrs: *SoupMessageHeaders) -> goffset
pub extern("c") fn soup_message_headers_set_content_length(hdrs: *SoupMessageHeaders, content_length: goffset) -> void

pub const SoupExpectation = enum(c_int) {
    SOUP_EXPECTATION_UNRECOGNIZED = 1,
    SOUP_EXPECTATION_CONTINUE = 2,
}

pub extern("c") fn soup_message_headers_get_expectations(hdrs: *SoupMessageHeaders) -> SoupExpectation
pub extern("c") fn soup_message_headers_set_expectations(hdrs: *SoupMessageHeaders, expectations: SoupExpectation) -> void

pub const SoupRange = struct {
    start: goffset
    end: goffset
}

pub extern("c") fn soup_message_headers_get_ranges(hdrs: *SoupMessageHeaders, total_length: goffset, ranges: **SoupRange, length: *c_int) -> gboolean
pub extern("c") fn soup_message_headers_free_ranges(hdrs: *SoupMessageHeaders, ranges: *SoupRange) -> void
pub extern("c") fn soup_message_headers_set_ranges(hdrs: *SoupMessageHeaders, ranges: *SoupRange, length: c_int) -> void
pub extern("c") fn soup_message_headers_set_range(hdrs: *SoupMessageHeaders, start: goffset, end: goffset) -> void
pub extern("c") fn soup_message_headers_get_content_range(hdrs: *SoupMessageHeaders, start: *goffset, end: *goffset, total_length: ?*goffset) -> gboolean
pub extern("c") fn soup_message_headers_set_content_range(hdrs: *SoupMessageHeaders, start: goffset, end: goffset, total_length: goffset) -> void
pub extern("c") fn soup_message_headers_get_content_type(hdrs: *SoupMessageHeaders, params: ?**GHashTable) -> ?[*]const gchar
pub extern("c") fn soup_message_headers_set_content_type(hdrs: *SoupMessageHeaders, content_type: [*]const gchar, params: ?*GHashTable) -> void
pub extern("c") fn soup_message_headers_get_content_disposition(hdrs: *SoupMessageHeaders, disposition: ?*[*]gchar, params: ?**GHashTable) -> gboolean
pub extern("c") fn soup_message_headers_set_content_disposition(hdrs: *SoupMessageHeaders, disposition: [*]const gchar, params: ?*GHashTable) -> void

const c_macros = "G_BEGIN_DECLS\nG_DEFINE_AUTOPTR_CLEANUP_FUNC (SoupMessageHeaders, soup_message_headers_unref)\nG_END_DECLS"
