// libsoup/soup-cookie.h
// mlx-soup: SoupCookie, an HTTP cookie (RFC 6265): parsed from a
// Set-Cookie header against the URI it came from, made by hand, written
// as Set-Cookie and Cookie headers, matched against hosts and URIs.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gslist = @import("../../glib/api/gslist.mlx")
const guri = @import("../../glib/api/guri.mlx")
const gdatetime = @import("../../glib/api/gdatetime.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const GSList = gslist.GSList
const GUri = guri.GUri
const GDateTime = gdatetime.GDateTime
const SoupCookie = types.SoupCookie
const SoupMessage = types.SoupMessage
pub const c_tokens = usize

pub const SoupSameSitePolicy = enum(c_int) {
    SOUP_SAME_SITE_POLICY_NONE,
    SOUP_SAME_SITE_POLICY_LAX,
    SOUP_SAME_SITE_POLICY_STRICT,
}

pub extern("c") fn soup_cookie_get_type() -> gtype.GType
pub const SOUP_TYPE_COOKIE: gtype.GType = soup_cookie_get_type()

pub const SOUP_COOKIE_MAX_AGE_ONE_HOUR: c_int = 60 * 60
pub const SOUP_COOKIE_MAX_AGE_ONE_DAY: c_int = 60 * 60 * 24
pub const SOUP_COOKIE_MAX_AGE_ONE_WEEK: c_int = 60 * 60 * 24 * 7
// (A double, as libsoup's: a year of 365.2422 days.)
pub const SOUP_COOKIE_MAX_AGE_ONE_YEAR: c_tokens = "(SOUP_COOKIE_MAX_AGE_ONE_DAY * 365.2422)"

pub extern("c") fn soup_cookie_new(name: [*]const gchar, value: [*]const gchar, domain: [*]const gchar, path: [*]const gchar, max_age: c_int) -> *SoupCookie
pub extern("c") fn soup_cookie_parse(header: [*]const gchar, origin: ?*GUri) -> ?*SoupCookie
pub extern("c") fn soup_cookie_copy(cookie: *SoupCookie) -> *SoupCookie
pub extern("c") fn soup_cookie_get_name(cookie: *SoupCookie) -> [*]const gchar
pub extern("c") fn soup_cookie_set_name(cookie: *SoupCookie, name: [*]const gchar) -> void
pub extern("c") fn soup_cookie_get_value(cookie: *SoupCookie) -> [*]const gchar
pub extern("c") fn soup_cookie_set_value(cookie: *SoupCookie, value: [*]const gchar) -> void
pub extern("c") fn soup_cookie_get_domain(cookie: *SoupCookie) -> [*]const gchar
pub extern("c") fn soup_cookie_set_domain(cookie: *SoupCookie, domain: [*]const gchar) -> void
pub extern("c") fn soup_cookie_get_path(cookie: *SoupCookie) -> [*]const gchar
pub extern("c") fn soup_cookie_set_path(cookie: *SoupCookie, path: [*]const gchar) -> void
pub extern("c") fn soup_cookie_set_max_age(cookie: *SoupCookie, max_age: c_int) -> void
pub extern("c") fn soup_cookie_get_expires(cookie: *SoupCookie) -> ?*GDateTime
pub extern("c") fn soup_cookie_set_expires(cookie: *SoupCookie, expires: ?*GDateTime) -> void
pub extern("c") fn soup_cookie_get_secure(cookie: *SoupCookie) -> gboolean
pub extern("c") fn soup_cookie_set_secure(cookie: *SoupCookie, secure: gboolean) -> void
pub extern("c") fn soup_cookie_get_http_only(cookie: *SoupCookie) -> gboolean
pub extern("c") fn soup_cookie_set_http_only(cookie: *SoupCookie, http_only: gboolean) -> void
pub extern("c") fn soup_cookie_set_same_site_policy(cookie: *SoupCookie, policy: SoupSameSitePolicy) -> void
pub extern("c") fn soup_cookie_get_same_site_policy(cookie: *SoupCookie) -> SoupSameSitePolicy
pub extern("c") fn soup_cookie_to_set_cookie_header(cookie: *SoupCookie) -> [*]gchar
pub extern("c") fn soup_cookie_to_cookie_header(cookie: *SoupCookie) -> [*]gchar
pub extern("c") fn soup_cookie_applies_to_uri(cookie: *SoupCookie, uri: *GUri) -> gboolean
pub extern("c") fn soup_cookie_equal(cookie1: *SoupCookie, cookie2: *SoupCookie) -> gboolean
pub extern("c") fn soup_cookie_free(cookie: *SoupCookie) -> void
pub extern("c") fn soup_cookies_from_response(msg: *SoupMessage) -> ?*GSList
pub extern("c") fn soup_cookies_from_request(msg: *SoupMessage) -> ?*GSList
pub extern("c") fn soup_cookies_to_response(cookies: ?*GSList, msg: *SoupMessage) -> void
pub extern("c") fn soup_cookies_to_request(cookies: ?*GSList, msg: *SoupMessage) -> void
pub extern("c") fn soup_cookies_free(cookies: ?*GSList) -> void
pub extern("c") fn soup_cookies_to_cookie_header(cookies: ?*GSList) -> [*]gchar
pub extern("c") fn soup_cookie_domain_matches(cookie: *SoupCookie, host: [*]const gchar) -> gboolean

const c_macros = "G_BEGIN_DECLS\nG_DEFINE_AUTOPTR_CLEANUP_FUNC (SoupCookie, soup_cookie_free)\nG_END_DECLS"
