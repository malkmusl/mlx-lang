// libsoup/soup-cookie-jar.h
// mlx-soup: SoupCookieJar, the session feature that keeps cookies: it
// takes those of responses (Set-Cookie) as its accept policy allows,
// gives requests theirs (Cookie) by domain, path, security and same-site
// rules, and tells of every change ("changed").
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gobject = @import("../../glib/api/gobject.mlx")
const gslist = @import("../../glib/api/gslist.mlx")
const guri = @import("../../glib/api/guri.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GSList = gslist.GSList
const GUri = guri.GUri
const SoupCookie = types.SoupCookie
const SoupCookieJar = types.SoupCookieJar

pub const SOUP_TYPE_COOKIE_JAR: gtype.GType = soup_cookie_jar_get_type()

pub const _SoupCookieJarClass = struct {
    parent_class: gobject.GObjectClass
    save: ?fn(jar: *SoupCookieJar) -> void
    is_persistent: ?fn(jar: *SoupCookieJar) -> gboolean
    changed: ?fn(jar: *SoupCookieJar, old_cookie: ?*SoupCookie, new_cookie: ?*SoupCookie) -> void
    padding: [6]gpointer
}
pub const SoupCookieJarClass = _SoupCookieJarClass

pub const SoupCookieJarAcceptPolicy = enum(c_int) {
    SOUP_COOKIE_JAR_ACCEPT_ALWAYS,
    SOUP_COOKIE_JAR_ACCEPT_NEVER,
    SOUP_COOKIE_JAR_ACCEPT_NO_THIRD_PARTY,
    SOUP_COOKIE_JAR_ACCEPT_GRANDFATHERED_THIRD_PARTY,
}

pub extern("c") fn soup_cookie_jar_get_type() -> gtype.GType
pub extern("c") fn soup_cookie_jar_new() -> *SoupCookieJar
pub extern("c") fn soup_cookie_jar_get_cookies(jar: *SoupCookieJar, uri: *GUri, for_http: gboolean) -> ?[*]gchar
pub extern("c") fn soup_cookie_jar_get_cookie_list(jar: *SoupCookieJar, uri: *GUri, for_http: gboolean) -> ?*GSList
pub extern("c") fn soup_cookie_jar_get_cookie_list_with_same_site_info(jar: *SoupCookieJar, uri: *GUri, top_level: ?*GUri, site_for_cookies: ?*GUri, for_http: gboolean, is_safe_method: gboolean, is_top_level_navigation: gboolean) -> ?*GSList
pub extern("c") fn soup_cookie_jar_set_cookie(jar: *SoupCookieJar, uri: *GUri, cookie: [*]const gchar) -> void
pub extern("c") fn soup_cookie_jar_set_cookie_with_first_party(jar: *SoupCookieJar, uri: *GUri, first_party: *GUri, cookie: [*]const gchar) -> void
pub extern("c") fn soup_cookie_jar_add_cookie(jar: *SoupCookieJar, cookie: *SoupCookie) -> void
pub extern("c") fn soup_cookie_jar_add_cookie_with_first_party(jar: *SoupCookieJar, first_party: *GUri, cookie: *SoupCookie) -> void
pub extern("c") fn soup_cookie_jar_add_cookie_full(jar: *SoupCookieJar, cookie: *SoupCookie, uri: ?*GUri, first_party: ?*GUri) -> void
pub extern("c") fn soup_cookie_jar_delete_cookie(jar: *SoupCookieJar, cookie: *SoupCookie) -> void
pub extern("c") fn soup_cookie_jar_all_cookies(jar: *SoupCookieJar) -> ?*GSList
pub extern("c") fn soup_cookie_jar_set_accept_policy(jar: *SoupCookieJar, policy: SoupCookieJarAcceptPolicy) -> void
pub extern("c") fn soup_cookie_jar_get_accept_policy(jar: *SoupCookieJar) -> SoupCookieJarAcceptPolicy
pub extern("c") fn soup_cookie_jar_is_persistent(jar: *SoupCookieJar) -> gboolean

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_DERIVABLE_TYPE (SoupCookieJar, soup_cookie_jar, SOUP, COOKIE_JAR, GObject)\nG_END_DECLS"
