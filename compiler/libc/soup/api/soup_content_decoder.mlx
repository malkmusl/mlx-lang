// libsoup/soup-content-decoder.h
// mlx-soup: SoupContentDecoder, the session feature that asks for
// compressed responses (Accept-Encoding: gzip, deflate) and decodes them
// as they are read (std.flate); a session has it from the start.
const c_function_pointers = true
const gtype = @import("../../glib/api/gtype.mlx")
const types = @import("./soup_types.mlx")
const body = @import("./soup_message_body.mlx")

pub const SOUP_TYPE_CONTENT_DECODER: gtype.GType = soup_content_decoder_get_type()

pub const _SoupContentDecoder = struct {}
pub const SoupContentDecoder = _SoupContentDecoder

pub extern("c") fn soup_content_decoder_get_type() -> gtype.GType

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupContentDecoder, soup_content_decoder, SOUP, CONTENT_DECODER, GObject)\nG_END_DECLS"
