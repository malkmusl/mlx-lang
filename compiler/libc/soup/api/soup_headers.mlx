// libsoup/soup-headers.h
// mlx-soup: parsing HTTP's message heads (a request line or a status line
// and the header lines after it) and the values of single headers: comma
// lists, lists by quality, parameter lists, and writing parameters back.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gslist = @import("../../glib/api/gslist.mlx")
const ghash = @import("../../glib/api/ghash.mlx")
const gstring = @import("../../glib/api/gstring.mlx")
const message = @import("./soup_message.mlx")
const headers = @import("./soup_message_headers.mlx")
const status = @import("./soup_status.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const GSList = gslist.GSList
const GHashTable = ghash.GHashTable
const GString = gstring.GString
const SoupMessageHeaders = headers.SoupMessageHeaders
const SoupHTTPVersion = status.SoupHTTPVersion

pub extern("c") fn soup_headers_parse(str: [*]const gchar, len: c_int, dest: *SoupMessageHeaders) -> gboolean
pub extern("c") fn soup_headers_parse_request(str: [*]const gchar, len: c_int, req_headers: *SoupMessageHeaders, req_method: ?*[*]gchar, req_path: ?*[*]gchar, ver: ?*SoupHTTPVersion) -> guint
pub extern("c") fn soup_headers_parse_status_line(status_line: [*]const gchar, ver: ?*SoupHTTPVersion, status_code: ?*guint, reason_phrase: ?*[*]gchar) -> gboolean
pub extern("c") fn soup_headers_parse_response(str: [*]const gchar, len: c_int, headers_: *SoupMessageHeaders, ver: ?*SoupHTTPVersion, status_code: ?*guint, reason_phrase: ?*[*]gchar) -> gboolean
pub extern("c") fn soup_header_parse_list(header: [*]const gchar) -> ?*GSList
pub extern("c") fn soup_header_parse_quality_list(header: [*]const gchar, unacceptable: ?**GSList) -> ?*GSList
pub extern("c") fn soup_header_free_list(list: ?*GSList) -> void
pub extern("c") fn soup_header_contains(header: [*]const gchar, token: [*]const gchar) -> gboolean
pub extern("c") fn soup_header_parse_param_list(header: [*]const gchar) -> *GHashTable
pub extern("c") fn soup_header_parse_semi_param_list(header: [*]const gchar) -> *GHashTable
pub extern("c") fn soup_header_parse_param_list_strict(header: [*]const gchar) -> ?*GHashTable
pub extern("c") fn soup_header_parse_semi_param_list_strict(header: [*]const gchar) -> ?*GHashTable
pub extern("c") fn soup_header_free_param_list(param_list: *GHashTable) -> void
pub extern("c") fn soup_header_g_string_append_param(string: *GString, name: [*]const gchar, value: ?[*]const gchar) -> void
pub extern("c") fn soup_header_g_string_append_param_quoted(string: *GString, name: [*]const gchar, value: [*]const gchar) -> void
