// libsoup/soup-auth-manager.h
// mlx-soup: SoupAuthManager, the session feature that answers 401 and 407
// responses: it asks for credentials ("authenticate" on the message),
// keeps them by protection space and authority, and authorizes later
// requests to the same space before they are challenged.
const c_function_pointers = true
const gtype = @import("../../glib/api/gtype.mlx")
const guri = @import("../../glib/api/guri.mlx")
const types = @import("./soup_types.mlx")
const auth = @import("./soup_auth.mlx")

pub const SOUP_TYPE_AUTH_MANAGER: gtype.GType = soup_auth_manager_get_type()

pub extern("c") fn soup_auth_manager_get_type() -> gtype.GType
pub extern("c") fn soup_auth_manager_use_auth(manager: *SoupAuthManager, uri: *guri.GUri, auth_: *types.SoupAuth) -> void
pub extern("c") fn soup_auth_manager_clear_cached_credentials(manager: *SoupAuthManager) -> void

pub const _SoupAuthManager = struct {}
pub const SoupAuthManager = _SoupAuthManager

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupAuthManager, soup_auth_manager, SOUP, AUTH_MANAGER, GObject)\nG_END_DECLS"
