// libsoup/soup-hsts-enforcer-db.h
// mlx-soup: SoupHSTSEnforcerDB, an HSTS enforcer whose policies are kept
// in a file between runs. libsoup keeps them in an SQLite database; there
// is no SQLite here, so the file holds a line of text per policy (its
// domain, expiry, max-age and whether it covers subdomains), read when
// the enforcer is made and written at each change.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const enforcer = @import("./soup_hsts_enforcer.mlx")
const types = @import("./soup_types.mlx")

pub const SOUP_TYPE_HSTS_ENFORCER_DB: gtype.GType = soup_hsts_enforcer_db_get_type()

pub const _SoupHSTSEnforcerDB = struct {}
pub const SoupHSTSEnforcerDB = _SoupHSTSEnforcerDB

pub extern("c") fn soup_hsts_enforcer_db_get_type() -> gtype.GType
pub extern("c") fn soup_hsts_enforcer_db_new(filename: [*]const gtypes.gchar) -> *types.SoupHSTSEnforcer

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupHSTSEnforcerDB, soup_hsts_enforcer_db, SOUP, HSTS_ENFORCER_DB, SoupHSTSEnforcer)\nG_END_DECLS"
