// libsoup/soup-session-feature.h
// mlx-soup: SoupSessionFeature, the interface of what a session can be
// given to act on its messages (the cookie jar, the authentication
// manager, the logger, the content decoder and sniffer, the cache, the
// HSTS enforcer, the WebSocket extension manager).
const c_function_pointers = true
const types = @import("./soup_types.mlx")
const gtype = @import("../../glib/api/gtype.mlx")

pub const SOUP_TYPE_SESSION_FEATURE: gtype.GType = soup_session_feature_get_type()

pub extern("c") fn soup_session_feature_get_type() -> gtype.GType

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_INTERFACE (SoupSessionFeature, soup_session_feature, SOUP, SESSION_FEATURE, GObject)\nG_END_DECLS"
