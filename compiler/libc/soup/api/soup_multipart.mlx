// libsoup/soup-multipart.h
// mlx-soup: SoupMultipart, a multipart body (RFC 2046) as its parts:
// read from a message's headers and body, built part by part (form
// fields and files of multipart/form-data among them) and written out.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gbytes = @import("../../glib/api/gbytes.mlx")
const types = @import("./soup_types.mlx")
const body = @import("./soup_message_body.mlx")
const headers = @import("./soup_message_headers.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const GBytes = gbytes.GBytes
const SoupMessageHeaders = headers.SoupMessageHeaders

pub const _SoupMultipart = struct {}
pub const SoupMultipart = _SoupMultipart

pub extern("c") fn soup_multipart_get_type() -> gtype.GType
pub const SOUP_TYPE_MULTIPART: gtype.GType = soup_multipart_get_type()

pub extern("c") fn soup_multipart_new(mime_type: [*]const gchar) -> *SoupMultipart
pub extern("c") fn soup_multipart_new_from_message(headers_: *SoupMessageHeaders, body_: *GBytes) -> ?*SoupMultipart
pub extern("c") fn soup_multipart_get_length(multipart: *SoupMultipart) -> c_int
pub extern("c") fn soup_multipart_get_part(multipart: *SoupMultipart, part: c_int, headers_: **SoupMessageHeaders, body_: **GBytes) -> gboolean
pub extern("c") fn soup_multipart_append_part(multipart: *SoupMultipart, headers_: *SoupMessageHeaders, body_: *GBytes) -> void
pub extern("c") fn soup_multipart_append_form_string(multipart: *SoupMultipart, control_name: [*]const gchar, data: [*]const gchar) -> void
pub extern("c") fn soup_multipart_append_form_file(multipart: *SoupMultipart, control_name: [*]const gchar, filename: ?[*]const gchar, content_type: ?[*]const gchar, body_: *GBytes) -> void
pub extern("c") fn soup_multipart_to_message(multipart: *SoupMultipart, dest_headers: *SoupMessageHeaders, dest_body: **GBytes) -> void
pub extern("c") fn soup_multipart_free(multipart: *SoupMultipart) -> void

const c_macros = "G_BEGIN_DECLS\nG_DEFINE_AUTOPTR_CLEANUP_FUNC (SoupMultipart, soup_multipart_free)\nG_END_DECLS"
