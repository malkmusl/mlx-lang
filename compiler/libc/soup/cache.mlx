// soup-cache.h: SoupCache, the session feature of libsoup's HTTP cache.
// Here it is the object and its settings only: its directory and type
// ("cache-dir", "cache-type"), its maximum size, and the index file it
// keeps there ("soup.cache2", written empty by dump and removed by clear).
// Responses are not stored nor served from it: a session with this
// feature sends every request (WebKit keeps its own cache, NetworkCache,
// and does not add this one).
//
// The private data is a pointer to a record: the directory (0), the type
// (8), the maximum size (12).
//
// SoupCacheClass: get_cacheability (136), padding to 176.
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const feature = @import("./feature.mlx")
const enumtypes = @import("./enumtypes.mlx")

extern("c") fn g_get_user_cache_dir() -> usize
extern("c") fn g_get_prgname() -> usize
extern("c") fn g_build_filename(first: usize, a: usize, b: usize) -> usize
extern("c") fn g_strdup(text: usize) -> usize
extern("c") fn g_free(address: usize) -> void
extern("c") fn g_mkdir_with_parents(path: usize, mode: i32) -> i32
extern("c") fn g_file_set_contents(path: usize, contents: usize, length: i64, err: usize) -> i32
extern("c") fn unlink(path: usize) -> i32

const P_DIR: usize = 0
const P_TYPE: usize = 8
const P_MAX: usize = 12
const P_SIZE: usize = 16

const CLASS_SIZE: usize = 176
const DEFAULT_MAX_SIZE: u32 = 50 * 1024 * 1024
const INDEX: []const u8 = "soup.cache2"

var cacheType: usize = 0
var cachePrivate: i32 = 0

export fn soup_cache_get_type() -> usize {
    if c.onceEnter(&cacheType) {
        const t = c.defineType(c.T_OBJECT, "SoupCache", CLASS_SIZE, @intFromPtr(__mlx_soup_cache_class_init), 24, @intFromPtr(__mlx_soup_cache_init), 0)
        cachePrivate = c.addPrivate(t, 8)
        feature.implementFeature(t, @intFromPtr(__mlx_soup_cache_feature_init))
        c.onceLeave(&cacheType, t)
    }
    return cacheType
}

fn priv(cache: usize) -> usize { return m.getWord(c.privateAt(cache, cachePrivate)) }

export fn __mlx_soup_cache_init(cache: usize, class: usize) -> void {
    const p = m.alloc(P_SIZE)
    m.putWord(c.privateAt(cache, cachePrivate), p)
    m.put32(p + P_MAX, DEFAULT_MAX_SIZE)
}

export fn __mlx_soup_cache_finalize(cache: usize) -> void {
    const p = priv(cache)
    g_free(m.getWord(p + P_DIR))
    m.release(p)
    c.chainUp(g.g_type_class_ref(soup_cache_get_type()), 48, cache)
}

export fn __mlx_soup_cache_set_property(cache: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = priv(cache)
    if id == 1 {
        g_free(m.getWord(p + P_DIR))
        const dir = g.g_value_get_string(value)
        // By default the program's directory in the user's cache.
        m.putWord(p + P_DIR, if dir != 0 { g_strdup(dir) } else { g_build_filename(g_get_user_cache_dir(), g_get_prgname(), 0) })
    }
    if id == 2 { m.putI32(p + P_TYPE, g.g_value_get_enum(value)) }
}

export fn __mlx_soup_cache_get_property(cache: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = priv(cache)
    if id == 1 { g.g_value_set_string(value, m.getWord(p + P_DIR)) }
    if id == 2 { g.g_value_set_enum(value, m.getI32(p + P_TYPE)) }
}

export fn __mlx_soup_cache_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &cachePrivate)
    m.putWord(class + 24, @intFromPtr(__mlx_soup_cache_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_cache_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_cache_finalize))
    _ = c.stringProperty(class, 1, "cache-dir", c.READWRITE | c.CONSTRUCT_ONLY)
    _ = c.enumProperty(class, 2, "cache-type", enumtypes.cacheTypeTypeGet(), 0, c.READWRITE | c.CONSTRUCT_ONLY)
}

export fn __mlx_soup_cache_feature_init(iface: usize, data: usize) -> void {}

export fn soup_cache_new(dir: usize, kind: i32) -> usize {
    var names: [2]usize = [2]usize{ m.literal("cache-dir"), m.literal("cache-type") }
    const values = m.alloc(48)
    _ = g.g_value_init(values, c.T_STRING)
    g.g_value_set_string(values, dir)
    _ = g.g_value_init(values + 24, enumtypes.cacheTypeTypeGet())
    g.g_value_set_enum(values + 24, kind)
    const cache = g_object_new_with_properties(soup_cache_get_type(), 2, @intFromPtr(&names), values)
    g.g_value_unset(values)
    g.g_value_unset(values + 24)
    m.release(values)
    return cache
}

extern("c") fn g_object_new_with_properties(t: usize, count: u32, names: usize, values: usize) -> usize

fn indexPath(cache: usize) -> usize { return g_build_filename(m.getWord(priv(cache) + P_DIR), m.literal(INDEX), 0) }

// Nothing is being written: there is nothing to wait for.
export fn soup_cache_flush(cache: usize) -> void {}

export fn soup_cache_clear(cache: usize) -> void {
    const path = indexPath(cache)
    _ = unlink(path)
    g_free(path)
}

export fn soup_cache_dump(cache: usize) -> void {
    const dir = m.getWord(priv(cache) + P_DIR)
    if g_mkdir_with_parents(dir, 448) != 0 { return }
    const path = indexPath(cache)
    _ = g_file_set_contents(path, m.literal(""), 0, 0)
    g_free(path)
}

export fn soup_cache_load(cache: usize) -> void {}

export fn soup_cache_set_max_size(cache: usize, size: u32) -> void { m.put32(priv(cache) + P_MAX, size) }
export fn soup_cache_get_max_size(cache: usize) -> u32 { return m.get32(priv(cache) + P_MAX) }
