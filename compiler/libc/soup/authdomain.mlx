// soup-auth-domain.h, soup-auth-domain-basic.h, soup-auth-domain-digest.h:
// a server's authentication, as libsoup's: a domain covers the paths
// added to it (all of them for a proxy) that its filter lets through,
// accepts a request whose Authorization its subclass checks (Basic: a
// user and password given to a callback; Digest: the response computed
// from the user's MD5 of user:realm:password, qop "auth" only), and
// challenges the others (401 or 407 with WWW-Authenticate or
// Proxy-Authenticate).
//
// A domain's private data is a pointer to a record: its realm (0),
// whether it is a proxy's (8), its paths (16, a path map), its filter
// (24, data 32, destroy notify 40), the generic auth callback (48, 56,
// 64). A Basic or Digest domain's own: its callback (0, data 8, destroy
// notify 16).
//
// SoupAuthDomainClass: accepts (136), challenge (144), check_password
// (152).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const misc = @import("./misc.mlx")
const pathmap = @import("./pathmap.mlx")
const auth = @import("./auth.mlx")
const stdauth = @import("std.http.auth")
const varargs = @import("../glib/varargs.mlx")

extern("c") fn soup_server_message_get_uri(msg: usize) -> usize
extern("c") fn soup_server_message_get_method(msg: usize) -> usize
extern("c") fn soup_server_message_get_request_headers(msg: usize) -> usize
extern("c") fn soup_server_message_get_response_headers(msg: usize) -> usize
extern("c") fn soup_server_message_set_status(msg: usize, code: u32, reason: usize) -> void
extern("c") fn soup_message_headers_get_one(h: usize, name: usize) -> usize
extern("c") fn soup_message_headers_append(h: usize, name: usize, value: usize) -> void
extern("c") fn soup_header_parse_param_list(header: usize) -> usize
extern("c") fn soup_header_free_param_list(list: usize) -> void
extern("c") fn soup_header_g_string_append_param(s: usize, name: usize, value: usize) -> void
extern("c") fn soup_header_g_string_append_param_quoted(s: usize, name: usize, value: usize) -> void
extern("c") fn g_object_new_valist(t: usize, first: usize, list: usize) -> usize
extern("c") fn g_strdup(text: usize) -> usize
extern("c") fn g_strndup(text: usize, length: usize) -> usize
extern("c") fn g_free(address: usize) -> void
extern("c") fn g_uri_parse(text: usize, flags: u32, err: usize) -> usize
extern("c") fn g_uri_unescape_string(text: usize, illegal: usize) -> usize
extern("c") fn time(at: usize) -> i64

const P_REALM: usize = 0
const P_PROXY: usize = 8
const P_PATHS: usize = 16
const P_FILTER: usize = 24
const P_GENERIC: usize = 48
const P_SIZE: usize = 72

const C_ACCEPTS: usize = 136
const C_CHALLENGE: usize = 144
const C_CHECK_PASSWORD: usize = 152
const CLASS_SIZE: usize = 208

const HTTP_URI_FLAGS: u32 = 1 | 2 | 4 | 8 | 16 | 64 | 256 | 512

pub const NotifyFn = fn(usize) -> void
pub const FilterFn = fn(usize, usize, usize) -> i32
pub const GenericFn = fn(usize, usize, usize, usize) -> i32
pub const AcceptsFn = fn(usize, usize, usize) -> usize
pub const ChallengeFn = fn(usize, usize) -> usize
pub const CheckFn = fn(usize, usize, usize, usize) -> i32
pub const BasicFn = fn(usize, usize, usize, usize, usize) -> i32
pub const DigestFn = fn(usize, usize, usize, usize) -> usize

var domainType: usize = 0
var domainPrivate: i32 = 0
var domainSpecs: [7]usize = [7]usize{ 0, 0, 0, 0, 0, 0, 0 }

pub fn domainTypeGet() -> usize {
    if c.onceEnter(&domainType) {
        const t = c.defineType(c.T_OBJECT, "SoupAuthDomain", CLASS_SIZE, @intFromPtr(__mlx_soup_auth_domain_class_init), 24, @intFromPtr(__mlx_soup_auth_domain_init), c.ABSTRACT)
        domainPrivate = c.addPrivate(t, 8)
        c.onceLeave(&domainType, t)
    }
    return domainType
}

export fn soup_auth_domain_get_type() -> usize { return domainTypeGet() }

fn priv(domain: usize) -> usize { return m.getWord(c.privateAt(domain, domainPrivate)) }

fn callNotify(f: usize, data: usize) -> void {
    if f == 0 { return }
    const call: NotifyFn = unsafe { @ptrFromInt(NotifyFn, f) }
    call(data)
}

export fn __mlx_soup_auth_domain_init(domain: usize, class: usize) -> void {
    const p = m.alloc(P_SIZE)
    m.putWord(c.privateAt(domain, domainPrivate), p)
    m.putWord(p + P_PATHS, pathmap.new(0))
}

export fn __mlx_soup_auth_domain_finalize(domain: usize) -> void {
    const p = priv(domain)
    g_free(m.getWord(p + P_REALM))
    pathmap.free(m.getWord(p + P_PATHS))
    callNotify(m.getWord(p + P_FILTER + 16), m.getWord(p + P_FILTER + 8))
    callNotify(m.getWord(p + P_GENERIC + 16), m.getWord(p + P_GENERIC + 8))
    m.release(p)
    c.chainUp(g.g_type_class_ref(domainTypeGet()), 48, domain)
}

// Setting a callback's data drops the old data (by its destroy notify).
fn setData(p: usize, at: usize, data: usize) -> void {
    const notify = m.getWord(p + at + 16)
    if notify != 0 {
        callNotify(notify, m.getWord(p + at + 8))
        m.putWord(p + at + 16, 0)
    }
    m.putWord(p + at + 8, data)
}

export fn __mlx_soup_auth_domain_set_property(domain: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = priv(domain)
    if id == 1 {
        g_free(m.getWord(p + P_REALM))
        m.putWord(p + P_REALM, g_strdup(g.g_value_get_string(value)))
    }
    if id == 2 { m.putI32(p + P_PROXY, g.g_value_get_boolean(value)) }
    if id == 3 { m.putWord(p + P_FILTER, g.g_value_get_pointer(value)) }
    if id == 4 { setData(p, P_FILTER, g.g_value_get_pointer(value)) }
    if id == 5 { m.putWord(p + P_GENERIC, g.g_value_get_pointer(value)) }
    if id == 6 { setData(p, P_GENERIC, g.g_value_get_pointer(value)) }
}

export fn __mlx_soup_auth_domain_get_property(domain: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = priv(domain)
    if id == 1 { g.g_value_set_string(value, m.getWord(p + P_REALM)) }
    if id == 2 { g.g_value_set_boolean(value, m.getI32(p + P_PROXY)) }
    if id == 3 { g.g_value_set_pointer(value, m.getWord(p + P_FILTER)) }
    if id == 4 { g.g_value_set_pointer(value, m.getWord(p + P_FILTER + 8)) }
    if id == 5 { g.g_value_set_pointer(value, m.getWord(p + P_GENERIC)) }
    if id == 6 { g.g_value_set_pointer(value, m.getWord(p + P_GENERIC + 8)) }
}

export fn __mlx_soup_auth_domain_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &domainPrivate)
    m.putWord(class + 24, @intFromPtr(__mlx_soup_auth_domain_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_auth_domain_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_auth_domain_finalize))
    domainSpecs[1] = c.stringProperty(class, 1, "realm", c.READWRITE | c.CONSTRUCT_ONLY)
    domainSpecs[2] = c.booleanProperty(class, 2, "proxy", false, c.READWRITE | c.CONSTRUCT_ONLY)
    domainSpecs[3] = c.pointerProperty(class, 3, "filter", c.READWRITE)
    domainSpecs[4] = c.pointerProperty(class, 4, "filter-data", c.READWRITE)
    domainSpecs[5] = c.pointerProperty(class, 5, "generic-auth-callback", c.READWRITE)
    domainSpecs[6] = c.pointerProperty(class, 6, "generic-auth-data", c.READWRITE)
}

fn pathOrRoot(path: usize) -> usize {
    // "" is "/" (not "*").
    if path == 0 || m.get8(path) == 0 { return m.literal("/") }
    return path
}

export fn soup_auth_domain_add_path(domain: usize, path: usize) -> void { pathmap.add(m.getWord(priv(domain) + P_PATHS), pathOrRoot(path), 1) }
export fn soup_auth_domain_remove_path(domain: usize, path: usize) -> void { pathmap.add(m.getWord(priv(domain) + P_PATHS), pathOrRoot(path), 0) }

fn setCallback(domain: usize, at: usize, f: usize, data: usize, destroy: usize, specA: usize, specB: usize) -> void {
    const p = priv(domain)
    callNotify(m.getWord(p + at + 16), m.getWord(p + at + 8))
    m.putWord(p + at, f)
    m.putWord(p + at + 8, data)
    m.putWord(p + at + 16, destroy)
    g.g_object_notify_by_pspec(domain, specA)
    g.g_object_notify_by_pspec(domain, specB)
}

export fn soup_auth_domain_set_filter(domain: usize, filter: usize, data: usize, destroy: usize) -> void { setCallback(domain, P_FILTER, filter, data, destroy, domainSpecs[3], domainSpecs[4]) }
export fn soup_auth_domain_set_generic_auth_callback(domain: usize, f: usize, data: usize, destroy: usize) -> void { setCallback(domain, P_GENERIC, f, data, destroy, domainSpecs[5], domainSpecs[6]) }
export fn soup_auth_domain_get_realm(domain: usize) -> usize { return m.getWord(priv(domain) + P_REALM) }

fn tryGeneric(domain: usize, msg: usize, user: usize) -> bool {
    const p = priv(domain)
    const f = m.getWord(p + P_GENERIC)
    if f == 0 { return false }
    const call: GenericFn = unsafe { @ptrFromInt(GenericFn, f) }
    return call(domain, msg, user, m.getWord(p + P_GENERIC + 8)) != 0
}

fn classSlot(domain: usize, slot: usize) -> usize { return m.getWord(m.getWord(domain) + slot) }

export fn soup_auth_domain_check_password(domain: usize, msg: usize, user: usize, password: usize) -> i32 {
    const call: CheckFn = unsafe { @ptrFromInt(CheckFn, classSlot(domain, C_CHECK_PASSWORD)) }
    return call(domain, msg, user, password)
}

export fn soup_auth_domain_covers(domain: usize, msg: usize) -> i32 {
    const p = priv(domain)
    if m.getI32(p + P_PROXY) == 0 {
        const path = g.g_uri_get_path(soup_server_message_get_uri(msg))
        if pathmap.lookup(m.getWord(p + P_PATHS), path) == 0 { return 0 }
    }
    const filter = m.getWord(p + P_FILTER)
    if filter != 0 {
        const call: FilterFn = unsafe { @ptrFromInt(FilterFn, filter) }
        if call(domain, msg, m.getWord(p + P_FILTER + 8)) == 0 { return 0 }
    }
    return 1
}

export fn soup_auth_domain_accepts(domain: usize, msg: usize) -> usize {
    const proxy = m.getI32(priv(domain) + P_PROXY) != 0
    const header = soup_message_headers_get_one(soup_server_message_get_request_headers(msg), m.literal(if proxy { "Proxy-Authorization" } else { "Authorization" }))
    if header == 0 { return 0 }
    const call: AcceptsFn = unsafe { @ptrFromInt(AcceptsFn, classSlot(domain, C_ACCEPTS)) }
    return call(domain, msg, header)
}

export fn soup_auth_domain_challenge(domain: usize, msg: usize) -> void {
    const proxy = m.getI32(priv(domain) + P_PROXY) != 0
    const call: ChallengeFn = unsafe { @ptrFromInt(ChallengeFn, classSlot(domain, C_CHALLENGE)) }
    const challenge = call(domain, msg)
    soup_server_message_set_status(msg, if proxy { 407 } else { 401 }, 0)
    soup_message_headers_append(soup_server_message_get_response_headers(msg), m.literal(if proxy { "Proxy-Authenticate" } else { "WWW-Authenticate" }), challenge)
    g_free(challenge)
}

// ---------------------------------------------------------------------------
// The subclasses' callbacks

const S_CALLBACK: usize = 0
const S_SIZE: usize = 24

var basicType: usize = 0
var basicPrivate: i32 = 0
var digestType: usize = 0
var digestPrivate: i32 = 0
var basicSpecs: [3]usize = [3]usize{ 0, 0, 0 }
var digestSpecs: [3]usize = [3]usize{ 0, 0, 0 }

fn subPriv(domain: usize, offset: i32) -> usize { return m.getWord(c.privateAt(domain, offset)) }

fn subFinalize(domain: usize, offset: i32) -> void {
    const p = subPriv(domain, offset)
    callNotify(m.getWord(p + 16), m.getWord(p + 8))
    m.release(p)
}

fn subSetProperty(p: usize, id: u32, value: usize) -> void {
    if id == 1 { m.putWord(p + S_CALLBACK, g.g_value_get_pointer(value)) }
    if id == 2 {
        const notify = m.getWord(p + 16)
        if notify != 0 {
            callNotify(notify, m.getWord(p + 8))
            m.putWord(p + 16, 0)
        }
        m.putWord(p + 8, g.g_value_get_pointer(value))
    }
}

fn subGetProperty(p: usize, id: u32, value: usize) -> void {
    if id == 1 { g.g_value_set_pointer(value, m.getWord(p + S_CALLBACK)) }
    if id == 2 { g.g_value_set_pointer(value, m.getWord(p + 8)) }
}

fn newDomain(t: usize, optname1: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, frame: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ optname1, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 1, frame, @intFromPtr(&words), @intFromPtr(&doubles))
    return g_object_new_valist(t, optname1, list)
}

// ---------------------------------------------------------------------------
// Basic

export fn soup_auth_domain_basic_get_type() -> usize {
    if c.onceEnter(&basicType) {
        const t = c.defineType(domainTypeGet(), "SoupAuthDomainBasic", CLASS_SIZE, @intFromPtr(__mlx_soup_auth_domain_basic_class_init), 24, @intFromPtr(__mlx_soup_auth_domain_basic_init), c.FINAL)
        basicPrivate = c.addPrivate(t, 8)
        c.onceLeave(&basicType, t)
    }
    return basicType
}

export fn __mlx_soup_auth_domain_basic_init(domain: usize, class: usize) -> void { m.putWord(c.privateAt(domain, basicPrivate), m.alloc(S_SIZE)) }

export fn __mlx_soup_auth_domain_basic_finalize(domain: usize) -> void {
    subFinalize(domain, basicPrivate)
    c.chainUp(g.g_type_class_ref(soup_auth_domain_basic_get_type()), 48, domain)
}

export fn __mlx_soup_auth_domain_basic_set_property(domain: usize, id: u32, value: usize, pspec: usize) -> void { subSetProperty(subPriv(domain, basicPrivate), id, value) }
export fn __mlx_soup_auth_domain_basic_get_property(domain: usize, id: u32, value: usize, pspec: usize) -> void { subGetProperty(subPriv(domain, basicPrivate), id, value) }

export fn soup_auth_domain_basic_new(optname1: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    return newDomain(soup_auth_domain_basic_get_type(), optname1, a1, a2, a3, a4, a5, @frameAddress(), x0, x1, x2, x3, x4, x5, x6, x7)
}

export fn soup_auth_domain_basic_set_auth_callback(domain: usize, callback: usize, data: usize, destroy: usize) -> void {
    const p = subPriv(domain, basicPrivate)
    callNotify(m.getWord(p + 16), m.getWord(p + 8))
    m.putWord(p + S_CALLBACK, callback)
    m.putWord(p + 8, data)
    m.putWord(p + 16, destroy)
    g.g_object_notify_by_pspec(domain, basicSpecs[1])
    g.g_object_notify_by_pspec(domain, basicSpecs[2])
}

// "Basic ..." as a user (in `user`, to free) and password (in
// `password`, to free).
fn parseBasic(header: usize, user: *usize, password: *usize) -> bool {
    if header == 0 { return false }
    const text = m.cSlice(header)
    if text.length < 6 || !m.same(text[0..6], "Basic ") { return false }
    const lengthCell = m.alloc(8)
    const decoded = g.g_base64_decode(header + 6, lengthCell)
    const length = m.getWord(lengthCell)
    m.release(lengthCell)
    if decoded == 0 { return false }
    var colon: usize = 0
    var found = false
    while colon < length {
        if m.get8(decoded + colon) == 58 {
            found = true
            break
        }
        colon += 1
    }
    if !found {
        m.zero(decoded, length)
        g_free(decoded)
        return false
    }
    m.put8(decoded + colon, 0)
    password.* = g_strndup(decoded + colon + 1, length - colon - 1)
    m.zero(decoded + colon + 1, length - colon - 1)
    user.* = decoded
    return true
}

fn freePassword(password: usize) -> void {
    m.zero(password, m.cLength(password))
    g_free(password)
}

export fn __mlx_soup_auth_domain_basic_accepts(domain: usize, msg: usize, header: usize) -> usize {
    var user: usize = 0
    var password: usize = 0
    if !parseBasic(header, &user, &password) { return 0 }
    const p = subPriv(domain, basicPrivate)
    var ok = false
    const f = m.getWord(p + S_CALLBACK)
    if f != 0 {
        const call: BasicFn = unsafe { @ptrFromInt(BasicFn, f) }
        ok = call(domain, msg, user, password, m.getWord(p + 8)) != 0
    } else {
        ok = tryGeneric(domain, msg, user)
    }
    freePassword(password)
    if ok { return user }
    g_free(user)
    return 0
}

export fn __mlx_soup_auth_domain_basic_challenge(domain: usize, msg: usize) -> usize {
    const s = g.g_string_new(m.literal("Basic "))
    soup_header_g_string_append_param(s, m.literal("realm"), soup_auth_domain_get_realm(domain))
    return g.g_string_free(s, 0)
}

export fn __mlx_soup_auth_domain_basic_check_password(domain: usize, msg: usize, user: usize, password: usize) -> i32 {
    const header = soup_message_headers_get_one(soup_server_message_get_request_headers(msg), m.literal("Authorization"))
    var msgUser: usize = 0
    var msgPassword: usize = 0
    if !parseBasic(header, &msgUser, &msgPassword) { return 0 }
    const ok = m.cEqual(user, msgUser) && m.cEqual(password, msgPassword)
    g_free(msgUser)
    freePassword(msgPassword)
    return if ok { 1 } else { 0 }
}

export fn __mlx_soup_auth_domain_basic_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &basicPrivate)
    m.putWord(class + 24, @intFromPtr(__mlx_soup_auth_domain_basic_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_auth_domain_basic_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_auth_domain_basic_finalize))
    m.putWord(class + C_ACCEPTS, @intFromPtr(__mlx_soup_auth_domain_basic_accepts))
    m.putWord(class + C_CHALLENGE, @intFromPtr(__mlx_soup_auth_domain_basic_challenge))
    m.putWord(class + C_CHECK_PASSWORD, @intFromPtr(__mlx_soup_auth_domain_basic_check_password))
    basicSpecs[1] = c.pointerProperty(class, 1, "auth-callback", c.READWRITE)
    basicSpecs[2] = c.pointerProperty(class, 2, "auth-data", c.READWRITE)
}

// ---------------------------------------------------------------------------
// Digest

export fn soup_auth_domain_digest_get_type() -> usize {
    if c.onceEnter(&digestType) {
        const t = c.defineType(domainTypeGet(), "SoupAuthDomainDigest", CLASS_SIZE, @intFromPtr(__mlx_soup_auth_domain_digest_class_init), 24, @intFromPtr(__mlx_soup_auth_domain_digest_init), c.FINAL)
        digestPrivate = c.addPrivate(t, 8)
        c.onceLeave(&digestType, t)
    }
    return digestType
}

export fn __mlx_soup_auth_domain_digest_init(domain: usize, class: usize) -> void { m.putWord(c.privateAt(domain, digestPrivate), m.alloc(S_SIZE)) }

export fn __mlx_soup_auth_domain_digest_finalize(domain: usize) -> void {
    subFinalize(domain, digestPrivate)
    c.chainUp(g.g_type_class_ref(soup_auth_domain_digest_get_type()), 48, domain)
}

export fn __mlx_soup_auth_domain_digest_set_property(domain: usize, id: u32, value: usize, pspec: usize) -> void { subSetProperty(subPriv(domain, digestPrivate), id, value) }
export fn __mlx_soup_auth_domain_digest_get_property(domain: usize, id: u32, value: usize, pspec: usize) -> void { subGetProperty(subPriv(domain, digestPrivate), id, value) }

export fn soup_auth_domain_digest_new(optname1: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    return newDomain(soup_auth_domain_digest_get_type(), optname1, a1, a2, a3, a4, a5, @frameAddress(), x0, x1, x2, x3, x4, x5, x6, x7)
}

export fn soup_auth_domain_digest_set_auth_callback(domain: usize, callback: usize, data: usize, destroy: usize) -> void {
    const p = subPriv(domain, digestPrivate)
    callNotify(m.getWord(p + 16), m.getWord(p + 8))
    m.putWord(p + S_CALLBACK, callback)
    m.putWord(p + 8, data)
    m.putWord(p + 16, destroy)
    g.g_object_notify_by_pspec(domain, digestSpecs[1])
    g.g_object_notify_by_pspec(domain, digestSpecs[2])
}

// The MD5 of user:realm:password, in hex (33 bytes at `out`).
fn hexUrp(user: usize, realm: usize, password: usize, out: usize) -> void {
    const hex: *[32]u8 = unsafe { @ptrFromInt(*[32]u8, out) }
    stdauth.hexUrp(m.cSlice(user), m.cSlice(realm), m.cSlice(password), hex)
    m.put8(out + 32, 0)
}

fn lookup(params: usize, name: []const u8) -> usize { return g.g_hash_table_lookup(params, m.literal(name)) }

fn checkHexUrp(domain: usize, msg: usize, params: usize, user: usize, urp: usize) -> bool {
    const msgUser = lookup(params, "username")
    if msgUser == 0 || !m.cEqual(msgUser, user) { return false }
    const uri = lookup(params, "uri")
    if uri == 0 { return false }
    const requestUri = soup_server_message_get_uri(msg)
    const digestUri = g_uri_parse(uri, HTTP_URI_FLAGS, 0)
    if digestUri != 0 {
        const same = misc.uriEqual(digestUri, requestUri)
        g.g_uri_unref(digestUri)
        if !same { return false }
    } else {
        const requestPath = misc.pathAndQuery(requestUri)
        const digestPath = g_uri_unescape_string(uri, 0)
        const same = digestPath != 0 && m.cEqual(digestPath, requestPath)
        g_free(requestPath)
        g_free(digestPath)
        if !same { return false }
    }
    // Only qop "auth".
    const qop = lookup(params, "qop")
    if qop == 0 || !m.cIs(qop, "auth") { return false }
    const realm = lookup(params, "realm")
    if realm == 0 || !m.cEqual(realm, soup_auth_domain_get_realm(domain)) { return false }
    const nonce = lookup(params, "nonce")
    if nonce == 0 { return false }
    const nc = lookup(params, "nc")
    if nc == 0 { return false }
    const count = stdauth.nonceCountOf(m.cSlice(nc))
    if count == 0 { return false }
    const cnonce = lookup(params, "cnonce")
    if cnonce == 0 { return false }
    const response = lookup(params, "response")
    if response == 0 { return false }
    // MD5 (not MD5-sess): A1 is the user's hash itself.
    const computed = m.alloc(33)
    auth.computeResponse(soup_server_message_get_method(msg), uri, urp, 1, nonce, cnonce, @intCast(u32, count), computed)
    const ok = m.cEqual(response, computed)
    m.release(computed)
    return ok
}

export fn __mlx_soup_auth_domain_digest_accepts(domain: usize, msg: usize, header: usize) -> usize {
    const text = m.cSlice(header)
    if text.length < 7 || !m.same(text[0..7], "Digest ") { return 0 }
    const params = soup_header_parse_param_list(header + 7)
    if params == 0 { return 0 }
    const user = lookup(params, "username")
    if user == 0 {
        soup_header_free_param_list(params)
        return 0
    }
    const p = subPriv(domain, digestPrivate)
    var accept = false
    const f = m.getWord(p + S_CALLBACK)
    if f != 0 {
        const call: DigestFn = unsafe { @ptrFromInt(DigestFn, f) }
        const urp = call(domain, msg, user, m.getWord(p + 8))
        if urp != 0 {
            accept = checkHexUrp(domain, msg, params, user, urp)
            g_free(urp)
        }
    } else {
        accept = tryGeneric(domain, msg, user)
    }
    const result = if accept { g_strdup(user) } else { 0 }
    soup_header_free_param_list(params)
    return result
}

export fn __mlx_soup_auth_domain_digest_challenge(domain: usize, msg: usize) -> usize {
    const s = g.g_string_new(m.literal("Digest "))
    soup_header_g_string_append_param_quoted(s, m.literal("realm"), soup_auth_domain_get_realm(domain))
    var t = m.text()
    m.pushText(&t, ", nonce=\"")
    m.pushDecimal(&t, @intCast(u64, msg))
    m.pushDecimal(&t, @intCast(u64, time(0)))
    m.pushText(&t, "\", qop=\"auth\", algorithm=MD5")
    _ = g.g_string_append_len(s, t.address, @intCast(i64, t.length))
    m.dispose(&t)
    return g.g_string_free(s, 0)
}

export fn soup_auth_domain_digest_encode_password(user: usize, realm: usize, password: usize) -> usize {
    const out = m.alloc(33)
    hexUrp(user, realm, password, out)
    const result = g_strdup(out)
    m.release(out)
    return result
}

export fn __mlx_soup_auth_domain_digest_check_password(domain: usize, msg: usize, user: usize, password: usize) -> i32 {
    const header = soup_message_headers_get_one(soup_server_message_get_request_headers(msg), m.literal("Authorization"))
    if header == 0 { return 0 }
    const text = m.cSlice(header)
    if text.length < 7 || !m.same(text[0..7], "Digest ") { return 0 }
    const params = soup_header_parse_param_list(header + 7)
    if params == 0 { return 0 }
    const msgUser = lookup(params, "username")
    if msgUser == 0 || !m.cEqual(msgUser, user) {
        soup_header_free_param_list(params)
        return 0
    }
    const urp = m.alloc(33)
    hexUrp(user, soup_auth_domain_get_realm(domain), password, urp)
    const accept = checkHexUrp(domain, msg, params, user, urp)
    m.release(urp)
    soup_header_free_param_list(params)
    return if accept { 1 } else { 0 }
}

export fn __mlx_soup_auth_domain_digest_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &digestPrivate)
    m.putWord(class + 24, @intFromPtr(__mlx_soup_auth_domain_digest_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_auth_domain_digest_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_auth_domain_digest_finalize))
    m.putWord(class + C_ACCEPTS, @intFromPtr(__mlx_soup_auth_domain_digest_accepts))
    m.putWord(class + C_CHALLENGE, @intFromPtr(__mlx_soup_auth_domain_digest_challenge))
    m.putWord(class + C_CHECK_PASSWORD, @intFromPtr(__mlx_soup_auth_domain_digest_check_password))
    digestSpecs[1] = c.pointerProperty(class, 1, "auth-callback", c.READWRITE)
    digestSpecs[2] = c.pointerProperty(class, 2, "auth-data", c.READWRITE)
}
