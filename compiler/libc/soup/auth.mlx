// soup-auth.h: SoupAuth, an HTTP authentication scheme's state for a
// realm (the abstract class, its class functions called as libsoup calls
// them), and its schemes: Basic (RFC 7617), Digest (RFC 2617's MD5 and
// MD5-sess with qop=auth), NTLM and Negotiate. The credentials themselves
// (tokens, hashes, the Authorization values) are std.http.auth's; this
// module keeps them in the objects' C memory. NTLM and Negotiate are
// types that take no challenge here (libsoup's NTLM needs its own crypto
// and Negotiate GSSAPI, neither of which this library has): a server
// offering them alone is answered with its 401.
//
// A SoupAuth's private data is a pointer to a record of the realm (0), the
// authority (8), whether for a proxy (16) and whether cancelled (20).
// Basic and Digest add (24) their own record: Basic its token (0); Digest
// the user (0), the hex of user:realm:password (8, 33 bytes), of A1 (48),
// the nonce (88), opaque (96), qop options (104), algorithm (108), domain
// (112), client nonce (120), nonce count (128) and qop (132).
//
// The class (SoupAuthClass): the scheme's name (136), strength (144),
// update (152), get_protection_space (160), authenticate (168),
// is_authenticated (176), get_authorization (184), is_ready (192),
// can_authenticate (200).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const misc = @import("./misc.mlx")
const message = @import("./message.mlx")
const http = @import("std.http.headers")
const stdauth = @import("std.http.auth")
const md5 = @import("std.md5")

extern("c") fn soup_header_parse_param_list(header: usize) -> usize
extern("c") fn soup_header_free_param_list(list: usize) -> void
extern("c") fn soup_message_headers_get_one(h: usize, name: usize) -> usize
extern("c") fn soup_message_add_header_handler(msg: usize, signal: usize, header: usize, callback: usize, data: usize) -> u32
extern("c") fn g_type_class_peek(t: usize) -> usize
extern("c") fn g_type_check_instance_is_a(instance: usize, t: usize) -> i32
extern("c") fn getpid() -> i32
extern("c") fn time(t: usize) -> i64
extern("c") fn g_free(address: usize) -> void

const P_REALM: usize = 0
const P_AUTHORITY: usize = 8
const P_PROXY: usize = 16
const P_CANCELLED: usize = 20

const C_SCHEME: usize = 136
const C_STRENGTH: usize = 144
const C_UPDATE: usize = 152
const C_PROTECTION_SPACE: usize = 160
const C_AUTHENTICATE: usize = 168
const C_IS_AUTHENTICATED: usize = 176
const C_GET_AUTHORIZATION: usize = 184
const C_IS_READY: usize = 192
const C_CAN_AUTHENTICATE: usize = 200
pub const CLASS_SIZE: usize = 256

const PROP_SCHEME_NAME: u32 = 1
const PROP_REALM: u32 = 2
const PROP_AUTHORITY: u32 = 3
const PROP_IS_FOR_PROXY: u32 = 4
const PROP_IS_AUTHENTICATED: u32 = 5
const PROP_IS_CANCELLED: u32 = 6

pub const UpdateFn = fn(usize, usize, usize) -> i32
pub const SpaceFn = fn(usize, usize) -> usize
pub const AuthenticateFn = fn(usize, usize, usize) -> void
pub const BoolFn = fn(usize) -> i32
pub const MsgFn = fn(usize, usize) -> usize
pub const ReadyFn = fn(usize, usize) -> i32

var authType: usize = 0
var basicType: usize = 0
var digestType: usize = 0
var ntlmType: usize = 0
var negotiateType: usize = 0
var privateOffset: i32 = 0
var specs: [7]usize = undefined

pub fn authTypeGet() -> usize {
    if c.onceEnter(&authType) {
        const t = c.defineType(c.T_OBJECT, "SoupAuth", CLASS_SIZE, @intFromPtr(__mlx_soup_auth_class_init), 24, @intFromPtr(__mlx_soup_auth_init), c.ABSTRACT)
        privateOffset = c.addPrivate(t, 8)
        c.onceLeave(&authType, t)
    }
    return authType
}

export fn soup_auth_get_type() -> usize { return authTypeGet() }

fn priv(auth: usize) -> usize { return m.getWord(c.privateAt(auth, privateOffset)) }
fn classOf(auth: usize) -> usize { return m.getWord(auth) }
fn sub(auth: usize) -> usize { return m.getWord(auth + 24) }

pub fn isAuth(object: usize) -> bool { return object != 0 && g_type_check_instance_is_a(object, authTypeGet()) != 0 }

export fn __mlx_soup_auth_init(auth: usize, class: usize) -> void { m.putWord(c.privateAt(auth, privateOffset), m.alloc(24)) }

export fn __mlx_soup_auth_dispose(auth: usize) -> void {
    const p = priv(auth)
    if m.getI32(p + P_CANCELLED) == 0 && !isAuthenticated(auth) { cancel(auth) }
    c.chainUp(g.g_type_class_ref(authTypeGet()), 40, auth)
}

export fn __mlx_soup_auth_finalize(auth: usize) -> void {
    const p = priv(auth)
    m.release(m.getWord(p + P_REALM))
    m.release(m.getWord(p + P_AUTHORITY))
    m.release(p)
    c.chainUp(g.g_type_class_ref(authTypeGet()), 48, auth)
}

export fn __mlx_soup_auth_set_property(auth: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = priv(auth)
    if id == PROP_REALM {
        c.replaceString(p + P_REALM, g.g_value_get_string(value))
    } else if id == PROP_AUTHORITY {
        c.replaceString(p + P_AUTHORITY, g.g_value_get_string(value))
    } else if id == PROP_IS_FOR_PROXY {
        m.putI32(p + P_PROXY, g.g_value_get_boolean(value))
    }
}

export fn __mlx_soup_auth_get_property(auth: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = priv(auth)
    if id == PROP_SCHEME_NAME {
        g.g_value_set_string(value, schemeName(auth))
    } else if id == PROP_REALM {
        g.g_value_set_string(value, m.getWord(p + P_REALM))
    } else if id == PROP_AUTHORITY {
        g.g_value_set_string(value, m.getWord(p + P_AUTHORITY))
    } else if id == PROP_IS_FOR_PROXY {
        g.g_value_set_boolean(value, m.getI32(p + P_PROXY))
    } else if id == PROP_IS_AUTHENTICATED {
        g.g_value_set_boolean(value, if isAuthenticated(auth) { 1 } else { 0 })
    } else if id == PROP_IS_CANCELLED {
        g.g_value_set_boolean(value, m.getI32(p + P_CANCELLED))
    }
}

export fn __mlx_soup_auth_can_authenticate_default(auth: usize) -> i32 { return 1 }

export fn __mlx_soup_auth_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &privateOffset)
    m.putWord(class + 24, @intFromPtr(__mlx_soup_auth_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_auth_get_property))
    m.putWord(class + 40, @intFromPtr(__mlx_soup_auth_dispose))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_auth_finalize))
    m.putWord(class + C_CAN_AUTHENTICATE, @intFromPtr(__mlx_soup_auth_can_authenticate_default))
    specs[PROP_SCHEME_NAME] = c.stringProperty(class, PROP_SCHEME_NAME, "scheme-name", c.READABLE)
    specs[PROP_REALM] = c.stringProperty(class, PROP_REALM, "realm", c.READWRITE)
    specs[PROP_AUTHORITY] = c.stringProperty(class, PROP_AUTHORITY, "authority", c.READWRITE)
    specs[PROP_IS_FOR_PROXY] = c.booleanProperty(class, PROP_IS_FOR_PROXY, "is-for-proxy", false, c.READWRITE)
    specs[PROP_IS_AUTHENTICATED] = c.booleanProperty(class, PROP_IS_AUTHENTICATED, "is-authenticated", false, c.READABLE)
    specs[PROP_IS_CANCELLED] = c.booleanProperty(class, PROP_IS_CANCELLED, "is-cancelled", false, c.READABLE)
}

// ---------------------------------------------------------------------------
// The class functions

fn classWord(auth: usize, offset: usize) -> usize { return m.getWord(classOf(auth) + offset) }

pub fn schemeName(auth: usize) -> usize { return classWord(auth, C_SCHEME) }
pub fn strengthOfClass(class: usize) -> u32 { return m.get32(class + C_STRENGTH) }
pub fn schemeOfClass(class: usize) -> usize { return m.getWord(class + C_SCHEME) }

fn callUpdate(auth: usize, msg: usize, params: usize) -> bool {
    const f = classWord(auth, C_UPDATE)
    if f == 0 { return false }
    const call: UpdateFn = unsafe { @ptrFromInt(UpdateFn, f) }
    return call(auth, msg, params) != 0
}

fn classIsAuthenticated(auth: usize) -> bool {
    const f = classWord(auth, C_IS_AUTHENTICATED)
    if f == 0 { return false }
    const call: BoolFn = unsafe { @ptrFromInt(BoolFn, f) }
    return call(auth) != 0
}

pub fn isAuthenticated(auth: usize) -> bool {
    if m.getI32(priv(auth) + P_CANCELLED) != 0 { return false }
    return classIsAuthenticated(auth)
}

pub fn isCancelled(auth: usize) -> bool { return m.getI32(priv(auth) + P_CANCELLED) != 0 }
pub fn isForProxy(auth: usize) -> bool { return m.getI32(priv(auth) + P_PROXY) != 0 }
pub fn setAuthority(auth: usize, authority: usize) -> void { c.replaceString(priv(auth) + P_AUTHORITY, authority) }
pub fn realm(auth: usize) -> usize { return m.getWord(priv(auth) + P_REALM) }

pub fn cancel(auth: usize) -> void {
    const p = priv(auth)
    if m.getI32(p + P_CANCELLED) != 0 { return }
    m.putI32(p + P_CANCELLED, 1)
    g.g_object_notify_by_pspec(auth, specs[PROP_IS_CANCELLED])
}

pub fn authenticate(auth: usize, username: usize, password: usize) -> void {
    if isCancelled(auth) { return }
    const was = isAuthenticated(auth)
    const f = classWord(auth, C_AUTHENTICATE)
    if f != 0 {
        const call: AuthenticateFn = unsafe { @ptrFromInt(AuthenticateFn, f) }
        call(auth, username, password)
    }
    if was != isAuthenticated(auth) { g.g_object_notify_by_pspec(auth, specs[PROP_IS_AUTHENTICATED]) }
}

pub fn isReady(auth: usize, msg: usize) -> bool {
    if isCancelled(auth) { return false }
    const f = classWord(auth, C_IS_READY)
    if f != 0 {
        const call: ReadyFn = unsafe { @ptrFromInt(ReadyFn, f) }
        return call(auth, msg) != 0
    }
    return classIsAuthenticated(auth)
}

pub fn canAuthenticate(auth: usize) -> bool {
    if isCancelled(auth) { return false }
    const f = classWord(auth, C_CAN_AUTHENTICATE)
    if f == 0 { return false }
    const call: BoolFn = unsafe { @ptrFromInt(BoolFn, f) }
    return call(auth) != 0
}

pub fn authorization(auth: usize, msg: usize) -> usize {
    const f = classWord(auth, C_GET_AUTHORIZATION)
    if f == 0 { return 0 }
    const call: MsgFn = unsafe { @ptrFromInt(MsgFn, f) }
    return call(auth, msg)
}

pub fn protectionSpace(auth: usize, uri: usize) -> usize {
    const n = misc.normalized(uri)
    const f = classWord(auth, C_PROTECTION_SPACE)
    var space: usize = 0
    if f != 0 {
        const call: SpaceFn = unsafe { @ptrFromInt(SpaceFn, f) }
        space = call(auth, n)
    }
    g.g_uri_unref(n)
    return space
}

// "scheme:realm" (the scheme alone for a connection auth: NTLM,
// Negotiate).
pub fn info(auth: usize) -> usize {
    var t = m.text()
    m.pushC(&t, schemeName(auth))
    if !isConnectionAuth(auth) {
        m.pushByte(&t, 58)
        if realm(auth) != 0 { m.pushC(&t, realm(auth)) } else { m.pushText(&t, "(null)") }
    }
    return m.finish(&t)
}

pub fn isConnectionAuth(auth: usize) -> bool {
    _ = authTypes()
    return g_type_check_instance_is_a(auth, ntlmType) != 0 || g_type_check_instance_is_a(auth, negotiateType) != 0
}

// The URI an auth is for: the message's (a proxy's would be the
// connection's proxy, and there are none here).
pub fn uriForAuth(msg: usize) -> usize {
    if message.statusOf(msg) == 407 { return 0 }
    return message.uri(msg)
}

// The challenge's parameters after the scheme's name: a table (empty when
// there are none).
fn challengeParams(header: usize, scheme: usize) -> usize {
    const params = soup_header_parse_param_list(header + m.cLength(scheme))
    if params != 0 { return params }
    return g.g_hash_table_new_full(0, 0, 0, 0)
}

fn schemeMatches(header: usize, scheme: usize) -> bool {
    const h = m.cSlice(header)
    const s = m.cSlice(scheme)
    if h.length < s.length { return false }
    return http.equalsIgnoringCase(h[0..s.length], s)
}

pub fn newAuth(t: usize, msg: usize, header: usize) -> usize {
    const uri = uriForAuth(msg)
    if uri == 0 { return 0 }
    const auth = g.g_object_new(t, 0)
    const p = priv(auth)
    m.putI32(p + P_PROXY, if message.statusOf(msg) == 407 { 1 } else { 0 })
    var a = m.text()
    m.pushC(&a, g.g_uri_get_host(uri))
    m.pushByte(&a, 58)
    m.pushSigned(&a, @intCast(i64, g.g_uri_get_port(uri)))
    m.putWord(p + P_AUTHORITY, m.finish(&a))
    const scheme = schemeName(auth)
    if !schemeMatches(header, scheme) {
        g.g_object_unref(auth)
        return 0
    }
    const params = challengeParams(header, scheme)
    c.replaceString(p + P_REALM, g.g_hash_table_lookup(params, m.literal("realm")))
    var result = auth
    if !callUpdate(auth, msg, params) {
        g.g_object_unref(auth)
        result = 0
    }
    soup_header_free_param_list(params)
    return result
}

pub fn update(auth: usize, msg: usize, header: usize) -> bool {
    const p = priv(auth)
    if m.getI32(p + P_CANCELLED) != 0 { return false }
    const scheme = schemeName(auth)
    if !schemeMatches(header, scheme) { return false }
    const params = challengeParams(header, scheme)
    const challengeRealm = g.g_hash_table_lookup(params, m.literal("realm"))
    if challengeRealm != 0 && m.getWord(p + P_REALM) != 0 && !m.cEqual(challengeRealm, m.getWord(p + P_REALM)) {
        soup_header_free_param_list(params)
        return false
    }
    const was = isAuthenticated(auth)
    const ok = callUpdate(auth, msg, params)
    if was != isAuthenticated(auth) { g.g_object_notify_by_pspec(auth, specs[PROP_IS_AUTHENTICATED]) }
    soup_header_free_param_list(params)
    return ok
}

// ---------------------------------------------------------------------------
// The C API

export fn soup_auth_new(t: usize, msg: usize, auth_header: usize) -> usize {
    if g.g_type_is_a(t, authTypeGet()) == 0 || auth_header == 0 { return 0 }
    return newAuth(t, msg, auth_header)
}

export fn soup_auth_update(auth: usize, msg: usize, auth_header: usize) -> i32 { return if update(auth, msg, auth_header) { 1 } else { 0 } }
export fn soup_auth_is_for_proxy(auth: usize) -> i32 { return m.getI32(priv(auth) + P_PROXY) }
export fn soup_auth_get_scheme_name(auth: usize) -> usize { return schemeName(auth) }
export fn soup_auth_get_authority(auth: usize) -> usize { return m.getWord(priv(auth) + P_AUTHORITY) }
export fn soup_auth_get_realm(auth: usize) -> usize { return realm(auth) }
export fn soup_auth_get_info(auth: usize) -> usize { return info(auth) }
export fn soup_auth_authenticate(auth: usize, username: usize, password: usize) -> void { authenticate(auth, username, password) }
export fn soup_auth_cancel(auth: usize) -> void { cancel(auth) }
export fn soup_auth_is_authenticated(auth: usize) -> i32 { return if isAuthenticated(auth) { 1 } else { 0 } }
export fn soup_auth_is_cancelled(auth: usize) -> i32 { return m.getI32(priv(auth) + P_CANCELLED) }
export fn soup_auth_is_ready(auth: usize, msg: usize) -> i32 { return if isReady(auth, msg) { 1 } else { 0 } }
export fn soup_auth_can_authenticate(auth: usize) -> i32 { return if canAuthenticate(auth) { 1 } else { 0 } }
export fn soup_auth_get_authorization(auth: usize, msg: usize) -> usize { return authorization(auth, msg) }
export fn soup_auth_get_protection_space(auth: usize, source_uri: usize) -> usize { return protectionSpace(auth, source_uri) }
export fn soup_auth_free_protection_space(auth: usize, space: usize) -> void { g.g_slist_free_full(space, @intFromPtr(g_free)) }

// Negotiate needs GSSAPI, which this library does not have (libsoup built
// without it says the same).
export fn soup_auth_negotiate_supported() -> i32 { return 0 }

// ---------------------------------------------------------------------------
// The schemes

fn authTypes() -> usize {
    if c.onceEnter(&basicType) {
        const parent = authTypeGet()
        c.onceLeave(&basicType, c.defineType(parent, "SoupAuthBasic", CLASS_SIZE, @intFromPtr(__mlx_soup_auth_basic_class_init), 32, @intFromPtr(__mlx_soup_auth_sub_init), c.FINAL))
    }
    if c.onceEnter(&digestType) {
        c.onceLeave(&digestType, c.defineType(authTypeGet(), "SoupAuthDigest", CLASS_SIZE, @intFromPtr(__mlx_soup_auth_digest_class_init), 32, @intFromPtr(__mlx_soup_auth_sub_init), c.FINAL))
    }
    if c.onceEnter(&ntlmType) {
        c.onceLeave(&ntlmType, c.defineType(authTypeGet(), "SoupAuthNTLM", CLASS_SIZE, @intFromPtr(__mlx_soup_auth_ntlm_class_init), 32, @intFromPtr(__mlx_soup_auth_sub_init), c.FINAL))
    }
    if c.onceEnter(&negotiateType) {
        c.onceLeave(&negotiateType, c.defineType(authTypeGet(), "SoupAuthNegotiate", CLASS_SIZE, @intFromPtr(__mlx_soup_auth_negotiate_class_init), 32, @intFromPtr(__mlx_soup_auth_sub_init), c.FINAL))
    }
    return basicType
}

export fn soup_auth_basic_get_type() -> usize { return authTypes() }

export fn soup_auth_digest_get_type() -> usize {
    _ = authTypes()
    return digestType
}

export fn soup_auth_ntlm_get_type() -> usize {
    _ = authTypes()
    return ntlmType
}

export fn soup_auth_negotiate_get_type() -> usize {
    _ = authTypes()
    return negotiateType
}

pub fn ntlmTypeGet() -> usize {
    _ = authTypes()
    return ntlmType
}

export fn __mlx_soup_auth_sub_init(auth: usize, class: usize) -> void { m.putWord(auth + 24, m.alloc(136)) }

fn subFinalize(auth: usize, class: usize) -> void {
    const r = sub(auth)
    m.release(r)
    c.chainUp(class, 48, auth)
}

// Basic

const B_TOKEN: usize = 0

fn forget(text: usize) -> void {
    if text == 0 { return }
    m.zero(text, m.cLength(text))
    m.release(text)
}

export fn __mlx_soup_auth_basic_finalize(auth: usize) -> void {
    forget(m.getWord(sub(auth) + B_TOKEN))
    subFinalize(auth, g.g_type_class_ref(basicType))
}

// A pre-existing auth's credentials must have been wrong: forgotten.
export fn __mlx_soup_auth_basic_update(auth: usize, msg: usize, params: usize) -> i32 {
    forget(m.getWord(sub(auth) + B_TOKEN))
    m.putWord(sub(auth) + B_TOKEN, 0)
    return 1
}

// The directory of the URI's path ("/a/b" for "/a/b/c", "/" for "/c").
export fn __mlx_soup_auth_basic_protection_space(auth: usize, uri: usize) -> usize {
    return g.g_slist_prepend(0, c.dup(stdauth.basicSpace(m.cSlice(g.g_uri_get_path(uri)))))
}

// The token: the base64 of user:password (ISO-8859-1 when every character
// has a code there, as libsoup's g_convert makes it).
export fn __mlx_soup_auth_basic_authenticate(auth: usize, username: usize, password: usize) -> void {
    const user = m.cSlice(username)
    const pass = m.cSlice(password)
    const room = stdauth.basicTokenRoom(user.length, pass.length)
    const token = m.alloc(room + 1)
    const out: [*]u8 = unsafe { @ptrFromInt([*]u8, token) }
    const length = stdauth.basicToken(user, pass, out[0..room])
    m.put8(token + length, 0)
    forget(m.getWord(sub(auth) + B_TOKEN))
    m.putWord(sub(auth) + B_TOKEN, token)
}

export fn __mlx_soup_auth_basic_is_authenticated(auth: usize) -> i32 { return if m.getWord(sub(auth) + B_TOKEN) != 0 { 1 } else { 0 } }

export fn __mlx_soup_auth_basic_get_authorization(auth: usize, msg: usize) -> usize {
    var t = m.text()
    stdauth.writeBasic(c.sinkOf(&t), m.cSlice(m.getWord(sub(auth) + B_TOKEN)))
    return m.finish(&t)
}

export fn __mlx_soup_auth_basic_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_soup_auth_basic_finalize))
    m.putWord(class + C_SCHEME, m.literal("Basic\x00"))
    m.put32(class + C_STRENGTH, 1)
    m.putWord(class + C_UPDATE, @intFromPtr(__mlx_soup_auth_basic_update))
    m.putWord(class + C_PROTECTION_SPACE, @intFromPtr(__mlx_soup_auth_basic_protection_space))
    m.putWord(class + C_AUTHENTICATE, @intFromPtr(__mlx_soup_auth_basic_authenticate))
    m.putWord(class + C_IS_AUTHENTICATED, @intFromPtr(__mlx_soup_auth_basic_is_authenticated))
    m.putWord(class + C_GET_AUTHORIZATION, @intFromPtr(__mlx_soup_auth_basic_get_authorization))
}

// Digest

const D_USER: usize = 0
const D_HEX_URP: usize = 8
const D_HEX_A1: usize = 48
const D_NONCE: usize = 88
const D_OPAQUE: usize = 96
const D_QOP_OPTIONS: usize = 104
const D_ALGORITHM: usize = 108
const D_DOMAIN: usize = 112
const D_CNONCE: usize = 120
const D_NC: usize = 128
const D_QOP: usize = 132

const QOP_AUTH: i32 = 1
const QOP_AUTH_INT: i32 = 2
const ALGORITHM_MD5: i32 = 1
const ALGORITHM_MD5_SESS: i32 = 2

export fn __mlx_soup_auth_digest_finalize(auth: usize) -> void {
    const d = sub(auth)
    m.release(m.getWord(d + D_USER))
    m.release(m.getWord(d + D_NONCE))
    m.release(m.getWord(d + D_DOMAIN))
    m.release(m.getWord(d + D_CNONCE))
    m.release(m.getWord(d + D_OPAQUE))
    m.zero(d + D_HEX_URP, 33)
    m.zero(d + D_HEX_A1, 33)
    subFinalize(auth, g.g_type_class_ref(digestType))
}

fn parseAlgorithm(text: usize) -> i32 {
    var algorithm = stdauth.Algorithm.md5
    if !stdauth.algorithmOf(m.cSlice(text), text != 0, &algorithm) { return -1 }
    return if algorithm == stdauth.Algorithm.md5 { ALGORITHM_MD5 } else { ALGORITHM_MD5_SESS }
}

fn parseQop(text: usize) -> i32 { return @intCast(i32, stdauth.qopOptionsOf(m.cSlice(text))) }

fn algorithmOf(d: usize) -> stdauth.Algorithm { return if m.getI32(d + D_ALGORITHM) == ALGORITHM_MD5_SESS { stdauth.Algorithm.md5Sess } else { stdauth.Algorithm.md5 } }

// The 32 hex digits at `address` (a NUL after them).
fn hex32(address: usize) -> *[32]u8 { return unsafe { @ptrFromInt(*[32]u8, address) } }

// MD5's hex of `text`, into the 33 bytes at `out`.
pub fn md5Into(text: []const u8, out: usize) -> void {
    md5.md5Hex(text, hex32(out))
    m.put8(out + 32, 0)
}

fn recomputeA1(d: usize) -> void {
    stdauth.hexA1(algorithmOf(d), hex32(d + D_HEX_URP), m.cSlice(m.getWord(d + D_NONCE)), m.cSlice(m.getWord(d + D_CNONCE)), hex32(d + D_HEX_A1))
    m.put8(d + D_HEX_A1 + 32, 0)
}

export fn __mlx_soup_auth_digest_update(auth: usize, msg: usize, params: usize) -> i32 {
    const d = sub(auth)
    if realm(auth) == 0 || g.g_hash_table_lookup(params, m.literal("nonce")) == 0 { return 0 }
    m.putI32(d + D_NC, 1)
    c.replaceString(d + D_DOMAIN, g.g_hash_table_lookup(params, m.literal("domain")))
    c.replaceString(d + D_NONCE, g.g_hash_table_lookup(params, m.literal("nonce")))
    c.replaceString(d + D_OPAQUE, g.g_hash_table_lookup(params, m.literal("opaque")))
    var ok = true
    const qop = g.g_hash_table_lookup(params, m.literal("qop"))
    if qop != 0 {
        if (parseQop(qop) & QOP_AUTH) == 0 { ok = false }
        m.putI32(d + D_QOP, QOP_AUTH)
    } else {
        m.putI32(d + D_QOP, 0)
    }
    m.putI32(d + D_ALGORITHM, parseAlgorithm(g.g_hash_table_lookup(params, m.literal("algorithm"))))
    if m.getI32(d + D_ALGORITHM) == -1 { ok = false }
    if (m.getI32(d + D_QOP) != 0 || m.getI32(d + D_ALGORITHM) == ALGORITHM_MD5_SESS) && m.getWord(d + D_NONCE) == 0 { ok = false }
    if ok {
        const stale = g.g_hash_table_lookup(params, m.literal("stale"))
        if stale != 0 && http.equalsIgnoringCase(m.cSlice(stale), "TRUE") && m.get8(d + D_HEX_URP) != 0 {
            recomputeA1(d)
        } else {
            c.replaceString(d + D_USER, 0)
            c.replaceString(d + D_CNONCE, 0)
            m.zero(d + D_HEX_URP, 33)
            m.zero(d + D_HEX_A1, 33)
        }
    }
    return if ok { 1 } else { 0 }
}

export fn __mlx_soup_auth_digest_protection_space(auth: usize, source: usize) -> usize {
    const d = sub(auth)
    const domain = m.cSlice(m.getWord(d + D_DOMAIN))
    if domain.length == 0 { return g.g_slist_prepend(0, m.dupSlice("")) }
    var space: usize = 0
    var at: usize = 0
    var item: []const u8 = ""
    while stdauth.nextDomainItem(domain, &at, &item) {
        if item[0] == 47 {
            space = g.g_slist_prepend(space, c.dup(stdauth.withoutTrailingSlash(item)))
            continue
        }
        const part = c.dup(item)
        const uri = g.g_uri_parse(part, misc.HTTP_URI_FLAGS, 0)
        m.release(part)
        if uri == 0 { continue }
        if c.cEquals(g.g_uri_get_scheme(uri), g.g_uri_get_scheme(source)) && g.g_uri_get_port(uri) == g.g_uri_get_port(source) && c.cEquals(g.g_uri_get_host(uri), g.g_uri_get_host(source)) {
            space = g.g_slist_prepend(space, c.dup(stdauth.withoutTrailingSlash(m.cSlice(g.g_uri_get_path(uri)))))
        }
        g.g_uri_unref(uri)
    }
    return space
}

export fn __mlx_soup_auth_digest_authenticate(auth: usize, username: usize, password: usize) -> void {
    const d = sub(auth)
    // The client nonce: the auth's address, the process and the time.
    var nonce: [64]u8 = undefined
    const length = stdauth.clientNonce(@intCast(u64, auth), @intCast(u64, getpid()), time(0), &nonce)
    c.replaceString(d + D_CNONCE, 0)
    m.putWord(d + D_CNONCE, m.dupBytes(@intFromPtr(&nonce), length))
    c.replaceString(d + D_USER, username)
    stdauth.hexUrp(m.cSlice(username), m.cSlice(realm(auth)), m.cSlice(password), hex32(d + D_HEX_URP))
    m.put8(d + D_HEX_URP + 32, 0)
    recomputeA1(d)
}

export fn __mlx_soup_auth_digest_is_authenticated(auth: usize) -> i32 { return if m.getWord(sub(auth) + D_CNONCE) != 0 { 1 } else { 0 } }

// RFC 2617's request-digest (std.http.auth's), the 33 bytes at `out`.
pub fn computeResponse(method: usize, uri: usize, hexA1: usize, qop: i32, nonce: usize, cnonce: usize, nc: u32, out: usize) -> void {
    stdauth.digestResponse(m.cSlice(method), m.cSlice(uri), hex32(hexA1), qop != 0, m.cSlice(nonce), m.cSlice(cnonce), nc, hex32(out))
    m.put8(out + 32, 0)
}

export fn __mlx_soup_auth_digest_info(msg: usize, auth: usize) -> void {
    if auth != message.auth(msg) { return }
    const d = sub(auth)
    const header = soup_message_headers_get_one(message.responseHeaders(msg), if isForProxy(auth) { m.literal("Proxy-Authentication-Info") } else { m.literal("Authentication-Info") })
    const params = soup_header_parse_param_list(header)
    if params == 0 { return }
    const next = g.g_hash_table_lookup(params, m.literal("nextnonce"))
    if next != 0 { c.replaceString(d + D_NONCE, next) }
    soup_header_free_param_list(params)
}

export fn __mlx_soup_auth_digest_get_authorization(auth: usize, msg: usize) -> usize {
    const d = sub(auth)
    const url = misc.pathAndQuery(message.uri(msg))
    var response: [32]u8 = undefined
    stdauth.digestResponse(m.cSlice(message.method(msg)), m.cSlice(url), hex32(d + D_HEX_A1), m.getI32(d + D_QOP) != 0, m.cSlice(m.getWord(d + D_NONCE)), m.cSlice(m.getWord(d + D_CNONCE)), m.get32(d + D_NC), &response)
    const credentials = stdauth.DigestCredentials.{ .user = m.cSlice(m.getWord(d + D_USER)), .realm = m.cSlice(realm(auth)), .nonce = m.cSlice(m.getWord(d + D_NONCE)), .uri = m.cSlice(url), .algorithm = algorithmOf(d), .response = response[0..32], .opaque = m.cSlice(m.getWord(d + D_OPAQUE)), .hasOpaque = m.getWord(d + D_OPAQUE) != 0, .qopAuth = m.getI32(d + D_QOP) != 0, .cnonce = m.cSlice(m.getWord(d + D_CNONCE)), .nc = m.get32(d + D_NC) }
    var out = m.text()
    stdauth.writeDigest(c.sinkOf(&out), &credentials)
    m.release(url)
    m.put32(d + D_NC, m.get32(d + D_NC) + 1)
    _ = soup_message_add_header_handler(msg, m.literal("got_headers\x00"), if isForProxy(auth) { m.literal("Proxy-Authentication-Info\x00") } else { m.literal("Authentication-Info\x00") }, @intFromPtr(__mlx_soup_auth_digest_info), auth)
    return m.finish(&out)
}

export fn __mlx_soup_auth_digest_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_soup_auth_digest_finalize))
    m.putWord(class + C_SCHEME, m.literal("Digest\x00"))
    m.put32(class + C_STRENGTH, 5)
    m.putWord(class + C_UPDATE, @intFromPtr(__mlx_soup_auth_digest_update))
    m.putWord(class + C_PROTECTION_SPACE, @intFromPtr(__mlx_soup_auth_digest_protection_space))
    m.putWord(class + C_AUTHENTICATE, @intFromPtr(__mlx_soup_auth_digest_authenticate))
    m.putWord(class + C_IS_AUTHENTICATED, @intFromPtr(__mlx_soup_auth_digest_is_authenticated))
    m.putWord(class + C_GET_AUTHORIZATION, @intFromPtr(__mlx_soup_auth_digest_get_authorization))
}

// NTLM and Negotiate: no challenge taken.

export fn __mlx_soup_auth_none_update(auth: usize, msg: usize, params: usize) -> i32 { return 0 }
export fn __mlx_soup_auth_none_is_authenticated(auth: usize) -> i32 { return 0 }
export fn __mlx_soup_auth_none_can_authenticate(auth: usize) -> i32 { return 0 }
export fn __mlx_soup_auth_none_get_authorization(auth: usize, msg: usize) -> usize { return 0 }
export fn __mlx_soup_auth_none_protection_space(auth: usize, uri: usize) -> usize { return g.g_slist_prepend(0, m.dupSlice("")) }
export fn __mlx_soup_auth_none_authenticate(auth: usize, username: usize, password: usize) -> void {}

fn noneClass(class: usize, scheme: usize, strength: u32) -> void {
    m.putWord(class + C_SCHEME, scheme)
    m.put32(class + C_STRENGTH, strength)
    m.putWord(class + C_UPDATE, @intFromPtr(__mlx_soup_auth_none_update))
    m.putWord(class + C_PROTECTION_SPACE, @intFromPtr(__mlx_soup_auth_none_protection_space))
    m.putWord(class + C_AUTHENTICATE, @intFromPtr(__mlx_soup_auth_none_authenticate))
    m.putWord(class + C_IS_AUTHENTICATED, @intFromPtr(__mlx_soup_auth_none_is_authenticated))
    m.putWord(class + C_GET_AUTHORIZATION, @intFromPtr(__mlx_soup_auth_none_get_authorization))
    m.putWord(class + C_CAN_AUTHENTICATE, @intFromPtr(__mlx_soup_auth_none_can_authenticate))
}

export fn __mlx_soup_auth_ntlm_class_init(class: usize, data: usize) -> void { noneClass(class, m.literal("NTLM\x00"), 3) }
export fn __mlx_soup_auth_negotiate_class_init(class: usize, data: usize) -> void { noneClass(class, m.literal("Negotiate\x00"), 7) }
