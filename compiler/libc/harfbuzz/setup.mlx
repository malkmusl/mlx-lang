// What the C library hands std.shaping before its first call: C's calloc,
// realloc and free for its memory (so a block is the same whichever side
// frees it, and no allocator state lives in the library), and setlocale's
// LC_CTYPE for the default language, as HarfBuzz takes it.
const memory = @import("std.shaping.memory")
const common = @import("std.shaping.common")

extern("c") fn calloc(count: usize, size: usize) -> usize
extern("c") fn realloc(address: usize, size: usize) -> usize
extern("c") fn free(address: usize) -> void
extern("c") fn setlocale(category: i32, locale: usize) -> usize

fn currentLocale() -> usize { return setlocale(0, 0) }

var ready: u32 = 0

pub fn ensure() -> void {
    if memory.atomicLoad32(@intFromPtr(&ready)) != 0 { return }
    memory.useCFunctions(@intFromPtr(calloc), @intFromPtr(realloc), @intFromPtr(free))
    common.useLocaleFunction(@intFromPtr(currentLocale))
    memory.atomicStore32(@intFromPtr(&ready), 1)
}
