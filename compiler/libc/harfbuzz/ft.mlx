// hb-ft.h (HarfBuzz's hb-ft.cc): faces and fonts of FreeType faces, and
// font functions that ask FreeType (libmlxfreetype, FreeType's C API) for
// glyphs, advances, extents, names and outlines. FreeType's records are
// read at the offsets of its C ABI (the same in mlx-freetype's headers as
// in FreeType's own).
//
// Color glyphs: bitmaps (BGRA) are painted as images and outlines as a
// clip filled with the foreground; COLR layers through FreeType are not
// painted (HarfBuzz's hb-ft-colr.hh).
const m = @import("std.shaping.memory")
const o = @import("std.shaping.object")
const blob = @import("std.shaping.blob")
const face = @import("std.shaping.face")
const font = @import("std.shaping.font")
const otfont = @import("std.shaping.otfont")
const cmap = @import("std.shaping.cmap")
const draw = @import("std.shaping.draw")
const paint = @import("std.shaping.paint")
const variations = @import("std.shaping.variations")
const setup = @import("./setup.mlx")

extern("c") fn FT_Reference_Face(face: usize) -> i32
extern("c") fn FT_Done_Face(face: usize) -> i32
extern("c") fn FT_Load_Sfnt_Table(face: usize, tag: u64, offset: i64, buffer: usize, length: usize) -> i32
extern("c") fn FT_Get_Char_Index(face: usize, charcode: u64) -> u32
extern("c") fn FT_Face_GetCharVariantIndex(face: usize, charcode: u64, selector: u64) -> u32
extern("c") fn FT_Get_Advance(face: usize, glyph: u32, flags: i32, advance: usize) -> i32
extern("c") fn FT_Load_Glyph(face: usize, glyph: u32, flags: i32) -> i32
extern("c") fn FT_Get_Glyph_Name(face: usize, glyph: u32, buffer: usize, size: u32) -> i32
extern("c") fn FT_Get_Name_Index(face: usize, name: usize) -> u32
extern("c") fn FT_Set_Char_Size(face: usize, width: i64, height: i64, hres: u32, vres: u32) -> i32
extern("c") fn FT_Set_Transform(face: usize, matrix: usize, delta: usize) -> void
extern("c") fn FT_Get_Transform(face: usize, matrix: usize, delta: usize) -> void
extern("c") fn FT_Set_Var_Design_Coordinates(face: usize, count: u32, coords: usize) -> i32
extern("c") fn FT_Get_MM_Var(face: usize, master: usize) -> i32
extern("c") fn FT_Get_Var_Blend_Coordinates(face: usize, count: u32, coords: usize) -> i32
extern("c") fn FT_Done_MM_Var(library: usize, master: usize) -> i32
extern("c") fn FT_Get_Kerning(face: usize, left: u32, right: u32, mode: u32, kerning: usize) -> i32
extern("c") fn FT_MulFix(a: i64, b: i64) -> i64
extern("c") fn FT_Outline_EmboldenXY(outline: usize, x: i64, y: i64) -> i32
extern("c") fn FT_Outline_Decompose(outline: usize, funcs: usize, user: usize) -> i32
extern("c") fn FT_Init_FreeType(library: usize) -> i32
extern("c") fn FT_New_Memory_Face(library: usize, data: usize, size: i64, index: i64, face: usize) -> i32
extern("c") fn FT_Select_Charmap(face: usize, encoding: u32) -> i32

// FreeType's records.
const FACE_INDEX: usize = 8
const FACE_NUM_FIXED_SIZES: usize = 56
const FACE_AVAILABLE_SIZES: usize = 64
const FACE_GENERIC_DATA: usize = 88
const FACE_GENERIC_FINALIZER: usize = 96
const FACE_UNITS_PER_EM: usize = 136
const FACE_ASCENDER: usize = 138
const FACE_DESCENDER: usize = 140
const FACE_HEIGHT: usize = 142
const FACE_GLYPH: usize = 152
const FACE_SIZE: usize = 160
const FACE_CHARMAP: usize = 168
const FACE_STREAM: usize = 192
const STREAM_BASE: usize = 0
const STREAM_SIZE: usize = 8
const STREAM_READ: usize = 40
const SIZE_X_SCALE: usize = 32
const SIZE_Y_SCALE: usize = 40
const SIZE_ASCENDER: usize = 48
const SIZE_DESCENDER: usize = 56
const SIZE_HEIGHT: usize = 64
const BITMAP_SIZE_X_PPEM: usize = 16
const BITMAP_SIZE_Y_PPEM: usize = 24
const BITMAP_SIZE_SIZE: usize = 32
const SLOT_LIBRARY: usize = 0
const SLOT_WIDTH: usize = 48
const SLOT_HEIGHT: usize = 56
const SLOT_HORI_BEARING_X: usize = 64
const SLOT_HORI_BEARING_Y: usize = 72
const SLOT_VERT_BEARING_X: usize = 88
const SLOT_VERT_BEARING_Y: usize = 96
const SLOT_FORMAT: usize = 144
const SLOT_BITMAP_ROWS: usize = 152
const SLOT_BITMAP_WIDTH: usize = 156
const SLOT_BITMAP_PITCH: usize = 160
const SLOT_BITMAP_BUFFER: usize = 168
const SLOT_BITMAP_PIXEL_MODE: usize = 178
const SLOT_OUTLINE: usize = 200
const OUTLINE_N_CONTOURS: usize = 0
const OUTLINE_N_POINTS: usize = 2
const OUTLINE_POINTS: usize = 8
const OUTLINE_CONTOURS: usize = 24
const CHARMAP_ENCODING: usize = 8

const LOAD_DEFAULT: i32 = 0
const LOAD_NO_HINTING: i32 = 2
const LOAD_NO_BITMAP: i32 = 8
const LOAD_VERTICAL_LAYOUT: i32 = 16
const LOAD_COLOR: i32 = 0x100000
const ENCODING_MS_SYMBOL: u32 = 0x73796D62
const ENCODING_UNICODE: u32 = 0x756E6963
const GLYPH_FORMAT_OUTLINE: u32 = 0x6F75746C
const GLYPH_FORMAT_BITMAP: u32 = 0x62697473
const PIXEL_MODE_BGRA: u32 = 7
const PAINT_IMAGE_FORMAT_BGRA: u32 = 0x42475241

fn ftFace(f: usize) -> usize { return m.getWord(f) }
fn slot(ftface: usize) -> usize { return m.getWord(ftface + FACE_GLYPH) }
fn sizeOf(ftface: usize) -> usize { return m.getWord(ftface + FACE_SIZE) }
fn i64at(a: usize) -> i64 { return @bitCast(i64, m.get64(a)) }
fn i16at(a: usize) -> i32 { return @intCast(i32, @bitCast(i16, m.get16(a))) }

// The font data of an hb-ft font.
pub const FtFont = struct {
    loadFlags: i32
    symbol: bool
    unref: bool
    transform: bool
    lock: u32
    ftFace: usize
    cachedSerial: u32
}

fn ftFont(address: usize) -> *FtFont { unsafe { return @ptrFromInt(*FtFont, address) } }

fn ftFontCreate(ftface: usize, symbol: bool, unref: bool) -> usize {
    const address = m.alloc(@sizeOf(FtFont))
    if address == 0 { return 0 }
    const ff = ftFont(address)
    ff.*.ftFace = ftface
    ff.*.symbol = symbol
    ff.*.unref = unref
    ff.*.transform = false
    ff.*.lock = 0
    ff.*.loadFlags = LOAD_DEFAULT | LOAD_NO_HINTING
    ff.*.cachedSerial = 0xFFFFFFFF
    return address
}

fn ftFaceDestroy(data: usize) -> void { _ = FT_Done_Face(data) }

fn ftFontDestroy(data: usize) -> void {
    const ff = ftFont(data)
    if ff.*.unref { ftFaceDestroy(ff.*.ftFace) }
    m.release(data)
}

// The font's FtFont if its functions are hb-ft's (0: they are not).
fn ftFontOf(f: usize) -> usize {
    if font.font(f).*.destroy != @intFromPtr(ftFontDestroy) { return 0 }
    return font.font(f).*.userData
}

fn hbFontChanged(f: usize, ftface: usize) -> void {
    const fo = font.font(f)
    const ff = ftFont(fo.*.userData)
    var xMult: f32 = 1.0
    var yMult: f32 = 1.0
    if fo.*.xScale < 0 { xMult = -xMult }
    if fo.*.yScale < 0 { yMult = -yMult }
    const xs = if fo.*.xScale < 0 { 0 - fo.*.xScale } else { fo.*.xScale }
    const ys = if fo.*.yScale < 0 { 0 - fo.*.yScale } else { fo.*.yScale }
    const numFixed = @bitCast(i32, m.get32(ftface + FACE_NUM_FIXED_SIZES))
    if FT_Set_Char_Size(ftface, @intCast(i64, xs), @intCast(i64, ys), 0, 0) != 0 && numFixed != 0 {
        // A bitmap font (color emoji): its largest size.
        const sizes = m.getWord(ftface + FACE_AVAILABLE_SIZES)
        const last = sizes + @intCast(usize, numFixed - 1) * BITMAP_SIZE_SIZE
        const xPpem = m.low32(i64at(last + BITMAP_SIZE_X_PPEM))
        const yPpem = m.low32(i64at(last + BITMAP_SIZE_Y_PPEM))
        _ = FT_Set_Char_Size(ftface, @intCast(i64, xPpem), @intCast(i64, yPpem), 0, 0)
        xMult = @floatFromInt(f32, fo.*.xScale) / @floatFromInt(f32, xPpem)
        yMult = @floatFromInt(f32, fo.*.yScale) / @floatFromInt(f32, yPpem)
    }
    if xMult != 1.0 || yMult != 1.0 {
        var matrix: [4]i64 = undefined
        matrix[0] = @intCast(i64, m.intOf(m.roundf(xMult * 65536.0)))
        matrix[1] = 0
        matrix[2] = 0
        matrix[3] = @intCast(i64, m.intOf(m.roundf(yMult * 65536.0)))
        FT_Set_Transform(ftface, @intFromPtr(&matrix), 0)
        ff.*.transform = true
    }
    var numCoords: u32 = 0
    const coords = font.fontGetVarCoordsDesign(f, @intFromPtr(&numCoords))
    if numCoords != 0 {
        const ftCoords = m.alloc(@intCast(usize, numCoords) * 8)
        if ftCoords != 0 {
            var i: u32 = 0
            while i < numCoords {
                const c = m.getF32(coords + @intCast(usize, i) * 4) * 65536.0
                m.put64(ftCoords + @intCast(usize, i) * 8, @bitCast(u64, @intFromFloat(i64, c)))
                i += 1
            }
            _ = FT_Set_Var_Design_Coordinates(ftface, numCoords, ftCoords)
            m.release(ftCoords)
        }
    }
}

// The multipliers of FreeType's transform (or the scale's sign).
fn xMultOf(f: usize, ff: *FtFont) -> f32 {
    const sign: f32 = if font.font(f).*.xScale < 0 { -1.0 } else { 1.0 }
    if !ff.*.transform { return sign }
    var matrix: [4]i64 = undefined
    FT_Get_Transform(ff.*.ftFace, @intFromPtr(&matrix), 0)
    const xx = @floatFromInt(f32, matrix[0])
    const xy = @floatFromInt(f32, matrix[1])
    return @sqrt(xx * xx + xy * xy) / 65536.0 * sign
}

fn yMultOf(f: usize, ff: *FtFont) -> f32 {
    const sign: f32 = if font.font(f).*.yScale < 0 { -1.0 } else { 1.0 }
    if !ff.*.transform { return sign }
    var matrix: [4]i64 = undefined
    FT_Get_Transform(ff.*.ftFace, @intFromPtr(&matrix), 0)
    const yx = @floatFromInt(f32, matrix[2])
    const yy = @floatFromInt(f32, matrix[3])
    return @sqrt(yx * yx + yy * yy) / 65536.0 * sign
}

// ---------------------------------------------------------------------------
// The font functions

fn getNominalGlyph(f: usize, data: usize, u: u32, glyph: usize, user: usize) -> i32 {
    const ff = ftFont(data)
    m.lock(@intFromPtr(&ff.*.lock))
    var g = FT_Get_Char_Index(ff.*.ftFace, @intCast(u64, u))
    if g == 0 && ff.*.symbol {
        const mode = cmap.symbolMode(cmap.fontPage(font.font(f).*.face))
        if mode == cmap.SYMBOL_PUA {
            if u <= 0xFF { g = FT_Get_Char_Index(ff.*.ftFace, @intCast(u64, 0xF000 + u)) }
        } else if mode != 0 {
            g = FT_Get_Char_Index(ff.*.ftFace, @intCast(u64, cmap.symbolRemap(mode, u)))
        }
    }
    m.unlock(@intFromPtr(&ff.*.lock))
    if g == 0 { return 0 }
    m.put32(glyph, g)
    return 1
}

fn getNominalGlyphs(f: usize, data: usize, count: u32, firstUnicode: usize, unicodeStride: u32, firstGlyph: usize, glyphStride: u32, user: usize) -> u32 {
    const ff = ftFont(data)
    m.lock(@intFromPtr(&ff.*.lock))
    var done: u32 = 0
    var u = firstUnicode
    var g = firstGlyph
    while done < count {
        const glyph = FT_Get_Char_Index(ff.*.ftFace, @intCast(u64, m.get32(u)))
        m.put32(g, glyph)
        if glyph == 0 { break }
        u += @intCast(usize, unicodeStride)
        g += @intCast(usize, glyphStride)
        done += 1
    }
    m.unlock(@intFromPtr(&ff.*.lock))
    return done
}

fn getVariationGlyph(f: usize, data: usize, u: u32, vs: u32, glyph: usize, user: usize) -> i32 {
    const ff = ftFont(data)
    m.lock(@intFromPtr(&ff.*.lock))
    const g = FT_Face_GetCharVariantIndex(ff.*.ftFace, @intCast(u64, u), @intCast(u64, vs))
    m.unlock(@intFromPtr(&ff.*.lock))
    if g == 0 { return 0 }
    m.put32(glyph, g)
    return 1
}

fn getGlyphHAdvances(f: usize, data: usize, count: u32, firstGlyph: usize, glyphStride: u32, firstAdvance: usize, advanceStride: u32, user: usize) -> void {
    const ff = ftFont(data)
    const fo = font.font(f)
    m.lock(@intFromPtr(&ff.*.lock))
    const xMult = xMultOf(f, ff)
    var v: i64 = 0
    var i: u32 = 0
    var g = firstGlyph
    var a = firstAdvance
    while i < count {
        v = 0
        _ = FT_Get_Advance(ff.*.ftFace, m.get32(g), ff.*.loadFlags, @intFromPtr(&v))
        if v < 0 { v = 0 - v }
        // (int) (v * x_mult + (1<<9)) >> 10, in float as C does it.
        const scaled = m.intOf(@floatFromInt(f32, v) * xMult + 512.0)
        m.putI32(a, scaled >> 10)
        g += @intCast(usize, glyphStride)
        a += @intCast(usize, advanceStride)
        i += 1
    }
    m.unlock(@intFromPtr(&ff.*.lock))
    if fo.*.xStrength != 0 && fo.*.emboldenInPlace == 0 {
        const xStrength = if fo.*.xScale >= 0 { fo.*.xStrength } else { 0 - fo.*.xStrength }
        a = firstAdvance
        i = 0
        while i < count {
            const adv = m.getI32(a)
            m.putI32(a, adv + (if adv != 0 { xStrength } else { 0 }))
            a += @intCast(usize, advanceStride)
            i += 1
        }
    }
}

fn getGlyphVAdvance(f: usize, data: usize, glyph: u32, user: usize) -> i32 {
    const ff = ftFont(data)
    const fo = font.font(f)
    m.lock(@intFromPtr(&ff.*.lock))
    const yMult = yMultOf(f, ff)
    var v: i64 = 0
    const err = FT_Get_Advance(ff.*.ftFace, glyph, ff.*.loadFlags | LOAD_VERTICAL_LAYOUT, @intFromPtr(&v))
    m.unlock(@intFromPtr(&ff.*.lock))
    if err != 0 { return 0 }
    const vi = @intCast(i64, m.intOf(yMult * @floatFromInt(f32, v)))
    const yStrength = if fo.*.yScale >= 0 { fo.*.yStrength } else { 0 - fo.*.yStrength }
    return m.low32((0 - vi + 512) >> 10) + (if fo.*.emboldenInPlace != 0 { 0 } else { yStrength })
}

fn getGlyphVOrigin(f: usize, data: usize, glyph: u32, x: usize, y: usize, user: usize) -> i32 {
    const ff = ftFont(data)
    m.lock(@intFromPtr(&ff.*.lock))
    const xMult = xMultOf(f, ff)
    const yMult = yMultOf(f, ff)
    const ftface = ff.*.ftFace
    if FT_Load_Glyph(ftface, glyph, ff.*.loadFlags) != 0 {
        m.unlock(@intFromPtr(&ff.*.lock))
        return 0
    }
    const s = slot(ftface)
    const ox = i64at(s + SLOT_HORI_BEARING_X) - i64at(s + SLOT_VERT_BEARING_X)
    const oy = i64at(s + SLOT_HORI_BEARING_Y) + i64at(s + SLOT_VERT_BEARING_Y)
    m.unlock(@intFromPtr(&ff.*.lock))
    // (hb_position_t) of the 64-bit position first, then of the product.
    m.putI32(x, m.intOf(xMult * @floatFromInt(f32, m.low32(ox))))
    m.putI32(y, m.intOf(yMult * @floatFromInt(f32, m.low32(oy))))
    return 1
}

fn getGlyphHKerning(f: usize, data: usize, left: u32, right: u32, user: usize) -> i32 {
    const ff = ftFont(data)
    m.lock(@intFromPtr(&ff.*.lock))
    var kerning: [2]i64 = undefined
    const mode: u32 = if font.font(f).*.xPpem != 0 { 0 } else { 1 }
    const err = FT_Get_Kerning(ff.*.ftFace, left, right, mode, @intFromPtr(&kerning))
    m.unlock(@intFromPtr(&ff.*.lock))
    if err != 0 { return 0 }
    return m.low32(kerning[0])
}

fn getGlyphExtents(f: usize, data: usize, glyph: u32, e: usize, user: usize) -> i32 {
    const ff = ftFont(data)
    const fo = font.font(f)
    m.lock(@intFromPtr(&ff.*.lock))
    const xMult = xMultOf(f, ff)
    const yMult = yMultOf(f, ff)
    const slantXy = fo.*.slantXy
    const ftface = ff.*.ftFace
    if FT_Load_Glyph(ftface, glyph, ff.*.loadFlags) != 0 {
        m.unlock(@intFromPtr(&ff.*.lock))
        return 0
    }
    const s = slot(ftface)
    var x1 = xMult * @floatFromInt(f32, i64at(s + SLOT_HORI_BEARING_X))
    const y1 = yMult * @floatFromInt(f32, i64at(s + SLOT_HORI_BEARING_Y))
    var x2 = x1 + xMult * @floatFromInt(f32, i64at(s + SLOT_WIDTH))
    const y2 = y1 + yMult * @floatFromInt(f32, 0 - i64at(s + SLOT_HEIGHT))
    m.unlock(@intFromPtr(&ff.*.lock))
    if slantXy != 0.0 {
        const a = y1 * slantXy
        const b = y2 * slantXy
        x1 += if a < b { a } else { b }
        x2 += if a > b { a } else { b }
    }
    var xBearing = m.intOf(m.floorf(x1))
    var yBearing = m.intOf(m.floorf(y1))
    var width = m.intOf(m.ceilf(x2)) - xBearing
    var height = m.intOf(m.ceilf(y2)) - yBearing
    if fo.*.xStrength != 0 || fo.*.yStrength != 0 {
        var yShift = fo.*.yStrength
        if fo.*.yScale < 0 { yShift = 0 - yShift }
        yBearing += yShift
        height -= yShift
        var xShift = fo.*.xStrength
        if fo.*.xScale < 0 { xShift = 0 - xShift }
        if fo.*.emboldenInPlace != 0 { xBearing -= xShift / 2 }
        width += xShift
    }
    m.putI32(e, xBearing)
    m.putI32(e + 4, yBearing)
    m.putI32(e + 8, width)
    m.putI32(e + 12, height)
    return 1
}

fn getGlyphContourPoint(f: usize, data: usize, glyph: u32, pointIndex: u32, x: usize, y: usize, user: usize) -> i32 {
    const ff = ftFont(data)
    m.lock(@intFromPtr(&ff.*.lock))
    const ftface = ff.*.ftFace
    var ok = FT_Load_Glyph(ftface, glyph, ff.*.loadFlags) == 0
    const s = slot(ftface)
    ok = ok && m.get32(s + SLOT_FORMAT) == GLYPH_FORMAT_OUTLINE
    ok = ok && @intCast(i32, pointIndex) < i16at(s + SLOT_OUTLINE + OUTLINE_N_POINTS) && pointIndex < 0x8000
    if ok {
        const points = m.getWord(s + SLOT_OUTLINE + OUTLINE_POINTS)
        m.putI32(x, m.low32(i64at(points + @intCast(usize, pointIndex) * 16)))
        m.putI32(y, m.low32(i64at(points + @intCast(usize, pointIndex) * 16 + 8)))
    }
    m.unlock(@intFromPtr(&ff.*.lock))
    return if ok { 1 } else { 0 }
}

fn getGlyphName(f: usize, data: usize, glyph: u32, name: usize, size: u32, user: usize) -> i32 {
    const ff = ftFont(data)
    m.lock(@intFromPtr(&ff.*.lock))
    var ok = FT_Get_Glyph_Name(ff.*.ftFace, glyph, name, size) == 0
    if ok && size != 0 && m.get8(name) == 0 { ok = false }
    m.unlock(@intFromPtr(&ff.*.lock))
    return if ok { 1 } else { 0 }
}

fn getGlyphFromName(f: usize, data: usize, name: usize, len_: i32, glyph: usize, user: usize) -> i32 {
    const ff = ftFont(data)
    m.lock(@intFromPtr(&ff.*.lock))
    const ftface = ff.*.ftFace
    var len = len_
    var buf: [128]u8 = undefined
    const b = @intFromPtr(&buf)
    var g: u32 = 0
    if len < 0 {
        g = FT_Get_Name_Index(ftface, name)
    } else {
        // A nul-terminated copy (strncpy: up to a nul of the name).
        if len > 127 { len = 127 }
        var k: usize = 0
        var ended = false
        while k < @intCast(usize, len) {
            const c = if ended { @intCast(u8, 0) } else { m.get8(name + k) }
            if c == 0 { ended = true }
            m.put8(b + k, c)
            k += 1
        }
        m.put8(b + @intCast(usize, len), 0)
        g = FT_Get_Name_Index(ftface, b)
    }
    m.put32(glyph, g)
    var found = g != 0
    if g == 0 {
        // Maybe the name of glyph 0.
        var zero: [128]u8 = undefined
        const z = @intFromPtr(&zero)
        const err = FT_Get_Glyph_Name(ftface, 0, z, 128)
        // (`!err && len < 0 ? !strcmp : !strncmp`, as C groups it.)
        if err == 0 && len < 0 {
            found = sameCString(z, name, -1)
        } else {
            found = sameCString(z, name, @intCast(i64, len))
        }
    }
    m.unlock(@intFromPtr(&ff.*.lock))
    return if found { 1 } else { 0 }
}

// strcmp (n < 0) or strncmp of two C strings: whether they are equal.
fn sameCString(a: usize, b: usize, n: i64) -> bool {
    var i: usize = 0
    while n < 0 || @intCast(i64, i) < n {
        const x = m.get8(a + i)
        const y = m.get8(b + i)
        if x != y { return false }
        if x == 0 { return true }
        i += 1
    }
    return true
}

fn getFontHExtents(f: usize, data: usize, e: usize, user: usize) -> i32 {
    const ff = ftFont(data)
    const fo = font.font(f)
    m.lock(@intFromPtr(&ff.*.lock))
    const ftface = ff.*.ftFace
    const yMult = yMultOf(f, ff)
    const size = sizeOf(ftface)
    var ascender: i64 = 0
    var descender: i64 = 0
    var lineGap: i64 = 0
    if m.get16(ftface + FACE_UNITS_PER_EM) != 0 {
        const yScale = i64at(size + SIZE_Y_SCALE)
        ascender = @intCast(i64, m.low32(FT_MulFix(@intCast(i64, i16at(ftface + FACE_ASCENDER)), yScale)))
        descender = @intCast(i64, m.low32(FT_MulFix(@intCast(i64, i16at(ftface + FACE_DESCENDER)), yScale)))
        lineGap = @intCast(i64, m.low32(FT_MulFix(@intCast(i64, i16at(ftface + FACE_HEIGHT)), yScale) - (ascender - descender)))
    } else {
        ascender = @intCast(i64, m.low32(i64at(size + SIZE_ASCENDER)))
        descender = @intCast(i64, m.low32(i64at(size + SIZE_DESCENDER)))
        lineGap = @intCast(i64, m.low32(i64at(size + SIZE_HEIGHT) - (ascender - descender)))
    }
    m.unlock(@intFromPtr(&ff.*.lock))
    m.putI32(e, m.intOf(yMult * @floatFromInt(f32, ascender + @intCast(i64, fo.*.yStrength))))
    m.putI32(e + 4, m.intOf(yMult * @floatFromInt(f32, descender)))
    m.putI32(e + 8, m.intOf(yMult * @floatFromInt(f32, lineGap)))
    return 1
}

fn moveTo(to: usize, s: usize) -> i32 {
    draw.sMoveTo(s, @floatFromInt(f32, i64at(to)), @floatFromInt(f32, i64at(to + 8)))
    return 0
}

fn lineTo(to: usize, s: usize) -> i32 {
    draw.sLineTo(s, @floatFromInt(f32, i64at(to)), @floatFromInt(f32, i64at(to + 8)))
    return 0
}

fn conicTo(control: usize, to: usize, s: usize) -> i32 {
    draw.sQuadraticTo(s, @floatFromInt(f32, i64at(control)), @floatFromInt(f32, i64at(control + 8)), @floatFromInt(f32, i64at(to)), @floatFromInt(f32, i64at(to + 8)))
    return 0
}

fn cubicTo(control1: usize, control2: usize, to: usize, s: usize) -> i32 {
    draw.sCubicTo(s, @floatFromInt(f32, i64at(control1)), @floatFromInt(f32, i64at(control1 + 8)), @floatFromInt(f32, i64at(control2)), @floatFromInt(f32, i64at(control2 + 8)), @floatFromInt(f32, i64at(to)), @floatFromInt(f32, i64at(to + 8)))
    return 0
}

fn drawGlyph(f: usize, data: usize, glyph: u32, drawFuncs: usize, drawData: usize, user: usize) -> void {
    const ff = ftFont(data)
    const fo = font.font(f)
    m.lock(@intFromPtr(&ff.*.lock))
    const ftface = ff.*.ftFace
    if FT_Load_Glyph(ftface, glyph, LOAD_NO_BITMAP | ff.*.loadFlags) != 0 || m.get32(slot(ftface) + SLOT_FORMAT) != GLYPH_FORMAT_OUTLINE {
        m.unlock(@intFromPtr(&ff.*.lock))
        return
    }
    var funcs: [6]usize = undefined
    funcs[0] = @intFromPtr(moveTo)
    funcs[1] = @intFromPtr(lineTo)
    funcs[2] = @intFromPtr(conicTo)
    funcs[3] = @intFromPtr(cubicTo)
    funcs[4] = 0
    funcs[5] = 0
    const outline = slot(ftface) + SLOT_OUTLINE
    if fo.*.xStrength != 0 || fo.*.yStrength != 0 {
        _ = FT_Outline_EmboldenXY(outline, @intCast(i64, fo.*.xStrength), @intCast(i64, fo.*.yStrength))
        var xShift: i32 = 0
        var yShift: i32 = 0
        if fo.*.emboldenInPlace != 0 {
            // Undo FreeType's shift.
            xShift = (0 - fo.*.xStrength) / 2
            if fo.*.yScale < 0 { yShift = 0 - fo.*.yStrength }
        } else {
            // FreeType's direction for negative scales, fixed up.
            if fo.*.xScale < 0 { xShift = 0 - fo.*.xStrength }
            if fo.*.yScale < 0 { yShift = 0 - fo.*.yStrength }
        }
        if xShift != 0 || yShift != 0 {
            const nContours = i16at(outline + OUTLINE_N_CONTOURS)
            const points = m.getWord(outline + OUTLINE_POINTS)
            const contours = m.getWord(outline + OUTLINE_CONTOURS)
            const count = i16at(contours + @intCast(usize, nContours - 1) * 2) + 1
            var k: i32 = 0
            while k < count {
                const p = points + @intCast(usize, k) * 16
                m.put64(p, @bitCast(u64, i64at(p) + @intCast(i64, xShift)))
                m.put64(p + 8, @bitCast(u64, i64at(p + 8) + @intCast(i64, yShift)))
                k += 1
            }
        }
    }
    const s = draw.beginSession(drawFuncs, drawData, fo.*.slantXy)
    if s != 0 {
        _ = FT_Outline_Decompose(outline, @intFromPtr(&funcs), s)
        draw.endSession(s)
    }
    m.unlock(@intFromPtr(&ff.*.lock))
}

fn paintGlyph(f: usize, data: usize, glyph: u32, paintFuncs: usize, paintData: usize, palette: u32, foreground: u32, user: usize) -> void {
    const ff = ftFont(data)
    m.lock(@intFromPtr(&ff.*.lock))
    const ftface = ff.*.ftFace
    if FT_Load_Glyph(ftface, glyph, ff.*.loadFlags | LOAD_COLOR) != 0 {
        m.unlock(@intFromPtr(&ff.*.lock))
        return
    }
    const s = slot(ftface)
    const format = m.get32(s + SLOT_FORMAT)
    if format == GLYPH_FORMAT_OUTLINE {
        // A simple outline (COLR glyphs are not painted through FreeType).
        m.unlock(@intFromPtr(&ff.*.lock))
        paint.pushClipGlyph(paintFuncs, paintData, glyph, f)
        paint.color(paintFuncs, paintData, true, foreground)
        paint.popClip(paintFuncs, paintData)
        return
    }
    if format == GLYPH_FORMAT_BITMAP && @intCast(u32, m.get8(s + SLOT_BITMAP_PIXEL_MODE)) == PIXEL_MODE_BGRA {
        const width = m.get32(s + SLOT_BITMAP_WIDTH)
        const rows = m.get32(s + SLOT_BITMAP_ROWS)
        const pitch = @bitCast(i32, m.get32(s + SLOT_BITMAP_PITCH))
        if pitch != @bitCast(i32, width * 4) {
            m.unlock(@intFromPtr(&ff.*.lock))
            return
        }
        m.unlock(@intFromPtr(&ff.*.lock))
        const b = blob.blobCreate(m.getWord(s + SLOT_BITMAP_BUFFER), @bitCast(u32, pitch) * rows, blob.MODE_DUPLICATE, 0, 0)
        var extents: [4]i32 = undefined
        if font.fontGetGlyphExtents(f, glyph, @intFromPtr(&extents)) != 0 {
            _ = paint.image(paintFuncs, paintData, b, width, rows, PAINT_IMAGE_FORMAT_BGRA, font.font(f).*.slantXy, @intFromPtr(&extents))
        }
        blob.blobDestroy(b)
        return
    }
    m.unlock(@intFromPtr(&ff.*.lock))
}

var staticFuncs: usize = 0

fn ftFuncs() -> usize {
    var funcs = m.atomicLoadWord(@intFromPtr(&staticFuncs))
    if funcs == 0 {
        const made = font.funcsCreate()
        font.setFunc(made, font.F_NOMINAL_GLYPH, @intFromPtr(getNominalGlyph), 0, 0)
        font.setFunc(made, font.F_NOMINAL_GLYPHS, @intFromPtr(getNominalGlyphs), 0, 0)
        font.setFunc(made, font.F_VARIATION_GLYPH, @intFromPtr(getVariationGlyph), 0, 0)
        font.setFunc(made, font.F_FONT_H_EXTENTS, @intFromPtr(getFontHExtents), 0, 0)
        font.setFunc(made, font.F_GLYPH_H_ADVANCES, @intFromPtr(getGlyphHAdvances), 0, 0)
        font.setFunc(made, font.F_GLYPH_V_ADVANCE, @intFromPtr(getGlyphVAdvance), 0, 0)
        font.setFunc(made, font.F_GLYPH_V_ORIGIN, @intFromPtr(getGlyphVOrigin), 0, 0)
        font.setFunc(made, font.F_GLYPH_H_KERNING, @intFromPtr(getGlyphHKerning), 0, 0)
        font.setFunc(made, font.F_GLYPH_EXTENTS, @intFromPtr(getGlyphExtents), 0, 0)
        font.setFunc(made, font.F_GLYPH_CONTOUR_POINT, @intFromPtr(getGlyphContourPoint), 0, 0)
        font.setFunc(made, font.F_GLYPH_NAME, @intFromPtr(getGlyphName), 0, 0)
        font.setFunc(made, font.F_GLYPH_FROM_NAME, @intFromPtr(getGlyphFromName), 0, 0)
        font.setFunc(made, font.F_DRAW_GLYPH, @intFromPtr(drawGlyph), 0, 0)
        font.setFunc(made, font.F_PAINT_GLYPH, @intFromPtr(paintGlyph), 0, 0)
        o.makeImmutable(made)
        if !m.swapWord(@intFromPtr(&staticFuncs), 0, made) { font.funcsDestroy(made) }
        funcs = m.atomicLoadWord(@intFromPtr(&staticFuncs))
    }
    return funcs
}

fn setFuncsOf(f: usize, ftface: usize, unref: bool) -> void {
    const charmap = m.getWord(ftface + FACE_CHARMAP)
    const symbol = charmap != 0 && m.get32(charmap + CHARMAP_ENCODING) == ENCODING_MS_SYMBOL
    const ff = ftFontCreate(ftface, symbol, unref)
    if ff == 0 { return }
    font.setFuncs(f, ftFuncs(), ff, @intFromPtr(ftFontDestroy))
}

// ---------------------------------------------------------------------------
// Faces

// A table of a face FreeType reads from a stream.
fn referenceTable(fc: usize, tag: u32, ftface: usize) -> usize {
    var length: u64 = 0
    if FT_Load_Sfnt_Table(ftface, @intCast(u64, tag), 0, 0, @intFromPtr(&length)) != 0 { return 0 }
    const buffer = m.alloc(@intCast(usize, length))
    if buffer == 0 { return 0 }
    if FT_Load_Sfnt_Table(ftface, @intCast(u64, tag), 0, buffer, @intFromPtr(&length)) != 0 {
        m.release(buffer)
        return 0
    }
    return blob.blobCreate(buffer, @intCast(u32, length), blob.MODE_WRITABLE, buffer, @intFromPtr(m.releaseCallback))
}

fn faceCreate(ftface: usize, destroy: usize) -> usize {
    var fc: usize = 0
    // A face read from memory (no read function) is a blob of that memory;
    // others are asked for their tables. (mlx-freetype leaves the stream
    // of a face it read from a file or memory NULL: its tables then.)
    const stream = m.getWord(ftface + FACE_STREAM)
    if stream != 0 && m.getWord(stream + STREAM_READ) == 0 {
        const b = blob.blobCreate(m.getWord(stream + STREAM_BASE), @intCast(u32, m.get64(stream + STREAM_SIZE) & 0xFFFFFFFF), blob.MODE_READONLY, ftface, destroy)
        fc = face.faceCreate(b, m.get32(ftface + FACE_INDEX))
        blob.blobDestroy(b)
    } else {
        fc = face.faceCreateForTables(@intFromPtr(referenceTable), ftface, destroy)
    }
    face.faceSetIndex(fc, m.get32(ftface + FACE_INDEX))
    face.faceSetUpem(fc, @intCast(u32, m.get16(ftface + FACE_UNITS_PER_EM)))
    return fc
}

export fn hb_ft_face_create(ftface: usize, destroy: usize) -> usize {
    setup.ensure()
    return faceCreate(ftface, destroy)
}

export fn hb_ft_face_create_referenced(ftface: usize) -> usize {
    setup.ensure()
    _ = FT_Reference_Face(ftface)
    return faceCreate(ftface, @intFromPtr(ftFaceDestroy))
}

fn faceFinalize(ftface: usize) -> void { face.faceDestroy(m.getWord(ftface + FACE_GENERIC_DATA)) }

export fn hb_ft_face_create_cached(ftface: usize) -> usize {
    setup.ensure()
    const finalizer = m.getWord(ftface + FACE_GENERIC_FINALIZER)
    if m.getWord(ftface + FACE_GENERIC_DATA) == 0 || finalizer != @intFromPtr(faceFinalize) {
        if finalizer != 0 { o.callDestroy(finalizer, ftface) }
        m.putWord(ftface + FACE_GENERIC_DATA, faceCreate(ftface, 0))
        m.putWord(ftface + FACE_GENERIC_FINALIZER, @intFromPtr(faceFinalize))
    }
    return face.faceReference(m.getWord(ftface + FACE_GENERIC_DATA))
}

// ---------------------------------------------------------------------------
// Fonts

fn fontCreate(ftface: usize, destroy: usize) -> usize {
    const fc = faceCreate(ftface, destroy)
    const f = otfont.fontCreate(fc)
    face.faceDestroy(fc)
    setFuncsOf(f, ftface, false)
    fontChanged(f)
    return f
}

export fn hb_ft_font_create(ftface: usize, destroy: usize) -> usize {
    setup.ensure()
    return fontCreate(ftface, destroy)
}

export fn hb_ft_font_create_referenced(ftface: usize) -> usize {
    setup.ensure()
    _ = FT_Reference_Face(ftface)
    return fontCreate(ftface, @intFromPtr(ftFaceDestroy))
}

fn fontChanged(f: usize) -> void {
    const data = ftFontOf(f)
    if data == 0 { return }
    const ff = ftFont(data)
    const ftface = ff.*.ftFace
    const size = sizeOf(ftface)
    const upem = @intCast(u64, m.get16(ftface + FACE_UNITS_PER_EM))
    const xs = (m.get64(size + SIZE_X_SCALE) *% upem +% 0x8000) >> 16
    const ys = (m.get64(size + SIZE_Y_SCALE) *% upem +% 0x8000) >> 16
    font.fontSetScale(f, @bitCast(i32, @intCast(u32, xs & 0xFFFFFFFF)), @bitCast(i32, @intCast(u32, ys & 0xFFFFFFFF)))
    var mmVar: usize = 0
    if FT_Get_MM_Var(ftface, @intFromPtr(&mmVar)) == 0 {
        const numAxis = m.get32(mmVar)
        const ftCoords = m.alloc(@intCast(usize, numAxis) * 8 + 8)
        const coords = m.alloc(@intCast(usize, numAxis) * 4 + 4)
        if ftCoords != 0 && coords != 0 {
            if FT_Get_Var_Blend_Coordinates(ftface, numAxis, ftCoords) == 0 {
                var nonzero = false
                var i: u32 = 0
                while i < numAxis {
                    const c = m.low32(i64at(ftCoords + @intCast(usize, i) * 8) >> 2)
                    m.putI32(coords + @intCast(usize, i) * 4, c)
                    nonzero = nonzero || c != 0
                    i += 1
                }
                if nonzero {
                    variations.fontSetVarCoordsNormalized(f, coords, numAxis)
                } else {
                    variations.fontSetVarCoordsNormalized(f, 0, 0)
                }
            }
        }
        m.release(coords)
        m.release(ftCoords)
        _ = FT_Done_MM_Var(m.getWord(slot(ftface) + SLOT_LIBRARY), mmVar)
    }
    ff.*.cachedSerial = font.font(f).*.serial
}

export fn hb_ft_font_changed(f: usize) -> void {
    setup.ensure()
    fontChanged(f)
}

export fn hb_ft_hb_font_changed(f: usize) -> i32 {
    setup.ensure()
    const data = ftFontOf(f)
    if data == 0 { return 0 }
    const ff = ftFont(data)
    if font.font(f).*.serial != ff.*.cachedSerial {
        hbFontChanged(f, ff.*.ftFace)
        ff.*.cachedSerial = font.font(f).*.serial
        return 1
    }
    return 0
}

export fn hb_ft_font_set_load_flags(f: usize, flags: i32) -> void {
    setup.ensure()
    if o.isImmutable(f) { return }
    const data = ftFontOf(f)
    if data == 0 { return }
    ftFont(data).*.loadFlags = flags
}

export fn hb_ft_font_get_load_flags(f: usize) -> i32 {
    setup.ensure()
    const data = ftFontOf(f)
    if data == 0 { return 0 }
    return ftFont(data).*.loadFlags
}

export fn hb_ft_font_get_face(f: usize) -> usize {
    setup.ensure()
    const data = ftFontOf(f)
    if data == 0 { return 0 }
    return ftFont(data).*.ftFace
}

export fn hb_ft_font_lock_face(f: usize) -> usize {
    setup.ensure()
    const data = ftFontOf(f)
    if data == 0 { return 0 }
    m.lock(@intFromPtr(&ftFont(data).*.lock))
    return ftFont(data).*.ftFace
}

export fn hb_ft_font_unlock_face(f: usize) -> void {
    setup.ensure()
    const data = ftFontOf(f)
    if data == 0 { return }
    m.unlock(@intFromPtr(&ftFont(data).*.lock))
}

var library: usize = 0

fn ftLibrary() -> usize {
    var l = m.atomicLoadWord(@intFromPtr(&library))
    if l == 0 {
        var made: usize = 0
        if FT_Init_FreeType(@intFromPtr(&made)) != 0 { return 0 }
        if !m.swapWord(@intFromPtr(&library), 0, made) { }
        l = m.atomicLoadWord(@intFromPtr(&library))
    }
    return l
}

fn releaseBlob(ftface: usize) -> void { blob.blobDestroy(m.getWord(ftface + FACE_GENERIC_DATA)) }

export fn hb_ft_font_set_funcs(f: usize) -> void {
    setup.ensure()
    const fc = font.font(f).*.face
    const b = face.faceReferenceBlob(fc)
    var length: u32 = 0
    const bytes = blob.blobGetData(b, @intFromPtr(&length))
    var ftface: usize = 0
    if FT_New_Memory_Face(ftLibrary(), bytes, @intCast(i64, length), @intCast(i64, face.faceGetIndex(fc)), @intFromPtr(&ftface)) != 0 {
        blob.blobDestroy(b)
        return
    }
    if FT_Select_Charmap(ftface, ENCODING_MS_SYMBOL) != 0 { _ = FT_Select_Charmap(ftface, ENCODING_UNICODE) }
    m.putWord(ftface + FACE_GENERIC_DATA, b)
    m.putWord(ftface + FACE_GENERIC_FINALIZER, @intFromPtr(releaseBlob))
    setFuncsOf(f, ftface, true)
    hb_ft_font_set_load_flags(f, LOAD_DEFAULT | LOAD_NO_HINTING)
    if ftFontOf(f) != 0 { hbFontChanged(f, ftface) }
}
