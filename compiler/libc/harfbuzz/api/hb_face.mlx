// hb-face.h
// mlx-harfbuzz: faces: a font of a blob (or of a collection), its tables, units
// per em and glyph count, its characters, variation selectors; faces built
// of tables.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")
const hb_blob = @import("./hb_blob.mlx")
const hb_map = @import("./hb_map.mlx")
const hb_set = @import("./hb_set.mlx")

pub extern("c") fn hb_face_count(blob: *hb_blob_t) -> c_uint
pub const hb_face_t = struct {}

pub extern("c") fn hb_face_create(blob: *hb_blob_t, index: c_uint) -> *hb_face_t
pub const hb_reference_table_func_t = fn(face: *hb_face_t, tag: hb_tag_t, user_data: *anyopaque) -> *hb_blob_t

pub extern("c") fn hb_face_create_for_tables(reference_table_func: hb_reference_table_func_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> *hb_face_t
pub extern("c") fn hb_face_get_empty() -> *hb_face_t
pub extern("c") fn hb_face_reference(face: *hb_face_t) -> *hb_face_t
pub extern("c") fn hb_face_destroy(face: *hb_face_t) -> void
pub extern("c") fn hb_face_set_user_data(face: *hb_face_t, key: *hb_user_data_key_t, data: *anyopaque, destroy: hb_destroy_func_t, replace: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_face_get_user_data(face: *const hb_face_t, key: *hb_user_data_key_t) -> *anyopaque
pub extern("c") fn hb_face_make_immutable(face: *hb_face_t) -> void
pub extern("c") fn hb_face_is_immutable(face: *const hb_face_t) -> hb_bool_t
pub extern("c") fn hb_face_reference_table(face: *const hb_face_t, tag: hb_tag_t) -> *hb_blob_t
pub extern("c") fn hb_face_reference_blob(face: *hb_face_t) -> *hb_blob_t
pub extern("c") fn hb_face_set_index(face: *hb_face_t, index: c_uint) -> void
pub extern("c") fn hb_face_get_index(face: *const hb_face_t) -> c_uint
pub extern("c") fn hb_face_set_upem(face: *hb_face_t, upem: c_uint) -> void
pub extern("c") fn hb_face_get_upem(face: *const hb_face_t) -> c_uint
pub extern("c") fn hb_face_set_glyph_count(face: *hb_face_t, glyph_count: c_uint) -> void
pub extern("c") fn hb_face_get_glyph_count(face: *const hb_face_t) -> c_uint
pub extern("c") fn hb_face_get_table_tags(face: *const hb_face_t, start_offset: c_uint, table_count: *c_uint, table_tags: *hb_tag_t) -> c_uint
pub extern("c") fn hb_face_collect_unicodes(face: *hb_face_t, out: *hb_set_t) -> void
pub extern("c") fn hb_face_collect_nominal_glyph_mapping(face: *hb_face_t, mapping: *hb_map_t, unicodes: *hb_set_t) -> void
pub extern("c") fn hb_face_collect_variation_selectors(face: *hb_face_t, out: *hb_set_t) -> void
pub extern("c") fn hb_face_collect_variation_unicodes(face: *hb_face_t, variation_selector: hb_codepoint_t, out: *hb_set_t) -> void
pub extern("c") fn hb_face_builder_create() -> *hb_face_t
pub extern("c") fn hb_face_builder_add_table(face: *hb_face_t, tag: hb_tag_t, blob: *hb_blob_t) -> hb_bool_t
pub extern("c") fn hb_face_builder_sort_tables(face: *hb_face_t, tags: *const hb_tag_t) -> void
