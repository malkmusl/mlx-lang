// hb-shape-plan.h
// mlx-harfbuzz: shape plans: what shaping does for a face, segment
// properties and features, made once and used for many buffers.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")
const hb_font = @import("./hb_font.mlx")

pub const hb_shape_plan_t = struct {}

pub extern("c") fn hb_shape_plan_create(face: *hb_face_t, props: *const hb_segment_properties_t, user_features: *const hb_feature_t, num_user_features: c_uint, shaper_list: **const c_char) -> *hb_shape_plan_t
pub extern("c") fn hb_shape_plan_create_cached(face: *hb_face_t, props: *const hb_segment_properties_t, user_features: *const hb_feature_t, num_user_features: c_uint, shaper_list: **const c_char) -> *hb_shape_plan_t
pub extern("c") fn hb_shape_plan_create2(face: *hb_face_t, props: *const hb_segment_properties_t, user_features: *const hb_feature_t, num_user_features: c_uint, coords: *const c_int, num_coords: c_uint, shaper_list: **const c_char) -> *hb_shape_plan_t
pub extern("c") fn hb_shape_plan_create_cached2(face: *hb_face_t, props: *const hb_segment_properties_t, user_features: *const hb_feature_t, num_user_features: c_uint, coords: *const c_int, num_coords: c_uint, shaper_list: **const c_char) -> *hb_shape_plan_t
pub extern("c") fn hb_shape_plan_get_empty() -> *hb_shape_plan_t
pub extern("c") fn hb_shape_plan_reference(shape_plan: *hb_shape_plan_t) -> *hb_shape_plan_t
pub extern("c") fn hb_shape_plan_destroy(shape_plan: *hb_shape_plan_t) -> void
pub extern("c") fn hb_shape_plan_set_user_data(shape_plan: *hb_shape_plan_t, key: *hb_user_data_key_t, data: *anyopaque, destroy: hb_destroy_func_t, replace: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_shape_plan_get_user_data(shape_plan: *const hb_shape_plan_t, key: *hb_user_data_key_t) -> *anyopaque
pub extern("c") fn hb_shape_plan_execute(shape_plan: *hb_shape_plan_t, font: *hb_font_t, buffer: *hb_buffer_t, features: *const hb_feature_t, num_features: c_uint) -> hb_bool_t
pub extern("c") fn hb_shape_plan_get_shaper(shape_plan: *hb_shape_plan_t) -> *const c_char
