// hb-ot-font.h
// mlx-harfbuzz: the font functions of the OpenType tables themselves (cmap,
// hmtx, vmtx, glyf, CFF, the color tables): what hb_font_create uses.
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")

pub extern("c") fn hb_ot_font_set_funcs(font: *hb_font_t) -> void
