// hb-buffer.h
// mlx-harfbuzz: buffers: the text to shape (UTF-8, UTF-16, UTF-32, Latin-1
// or codepoints, with the context around it) and, after shaping, the
// glyphs with their clusters and positions; segment properties, flags,
// cluster levels, serialization to and from text and JSON.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")
const hb_unicode = @import("./hb_unicode.mlx")
const hb_font = @import("./hb_font.mlx")

pub const hb_glyph_info_t = struct {
    codepoint: hb_codepoint_t
    mask: hb_mask_t
    cluster: u32
    var1: hb_var_int_t
    var2: hb_var_int_t
}

pub const hb_glyph_flags_t = enum(c_int) {
    HB_GLYPH_FLAG_UNSAFE_TO_BREAK = 1,
    HB_GLYPH_FLAG_UNSAFE_TO_CONCAT = 2,
    HB_GLYPH_FLAG_SAFE_TO_INSERT_TATWEEL = 4,
    HB_GLYPH_FLAG_DEFINED = 7,
}

pub extern("c") fn hb_glyph_info_get_glyph_flags(info: *const hb_glyph_info_t) -> hb_glyph_flags_t
pub const hb_glyph_position_t = struct {
    x_advance: hb_position_t
    y_advance: hb_position_t
    x_offset: hb_position_t
    y_offset: hb_position_t
    var_: hb_var_int_t
}

pub const hb_segment_properties_t = struct {
    direction: hb_direction_t
    script: hb_script_t
    language: hb_language_t
    reserved1: *anyopaque
    reserved2: *anyopaque
}

pub extern("c") fn hb_segment_properties_equal(a: *const hb_segment_properties_t, b: *const hb_segment_properties_t) -> hb_bool_t
pub extern("c") fn hb_segment_properties_hash(p: *const hb_segment_properties_t) -> c_uint
pub extern("c") fn hb_segment_properties_overlay(p: *hb_segment_properties_t, src: *const hb_segment_properties_t) -> void
pub const hb_buffer_t = struct {}

pub extern("c") fn hb_buffer_create() -> *hb_buffer_t
pub extern("c") fn hb_buffer_create_similar(src: *const hb_buffer_t) -> *hb_buffer_t
pub extern("c") fn hb_buffer_reset(buffer: *hb_buffer_t) -> void
pub extern("c") fn hb_buffer_get_empty() -> *hb_buffer_t
pub extern("c") fn hb_buffer_reference(buffer: *hb_buffer_t) -> *hb_buffer_t
pub extern("c") fn hb_buffer_destroy(buffer: *hb_buffer_t) -> void
pub extern("c") fn hb_buffer_set_user_data(buffer: *hb_buffer_t, key: *hb_user_data_key_t, data: *anyopaque, destroy: hb_destroy_func_t, replace: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_buffer_get_user_data(buffer: *const hb_buffer_t, key: *hb_user_data_key_t) -> *anyopaque
pub const hb_buffer_content_type_t = enum(c_int) {
    HB_BUFFER_CONTENT_TYPE_INVALID = 0,
    HB_BUFFER_CONTENT_TYPE_UNICODE = 1,
    HB_BUFFER_CONTENT_TYPE_GLYPHS = 2,
}

pub extern("c") fn hb_buffer_set_content_type(buffer: *hb_buffer_t, content_type: hb_buffer_content_type_t) -> void
pub extern("c") fn hb_buffer_get_content_type(buffer: *const hb_buffer_t) -> hb_buffer_content_type_t
pub extern("c") fn hb_buffer_set_unicode_funcs(buffer: *hb_buffer_t, unicode_funcs: *hb_unicode_funcs_t) -> void
pub extern("c") fn hb_buffer_get_unicode_funcs(buffer: *const hb_buffer_t) -> *hb_unicode_funcs_t
pub extern("c") fn hb_buffer_set_direction(buffer: *hb_buffer_t, direction: hb_direction_t) -> void
pub extern("c") fn hb_buffer_get_direction(buffer: *const hb_buffer_t) -> hb_direction_t
pub extern("c") fn hb_buffer_set_script(buffer: *hb_buffer_t, script: hb_script_t) -> void
pub extern("c") fn hb_buffer_get_script(buffer: *const hb_buffer_t) -> hb_script_t
pub extern("c") fn hb_buffer_set_language(buffer: *hb_buffer_t, language: hb_language_t) -> void
pub extern("c") fn hb_buffer_get_language(buffer: *const hb_buffer_t) -> hb_language_t
pub extern("c") fn hb_buffer_set_segment_properties(buffer: *hb_buffer_t, props: *const hb_segment_properties_t) -> void
pub extern("c") fn hb_buffer_get_segment_properties(buffer: *const hb_buffer_t, props: *hb_segment_properties_t) -> void
pub extern("c") fn hb_buffer_guess_segment_properties(buffer: *hb_buffer_t) -> void
pub const hb_buffer_flags_t = enum(c_int) {
    HB_BUFFER_FLAG_DEFAULT = 0,
    HB_BUFFER_FLAG_BOT = 1,
    HB_BUFFER_FLAG_EOT = 2,
    HB_BUFFER_FLAG_PRESERVE_DEFAULT_IGNORABLES = 4,
    HB_BUFFER_FLAG_REMOVE_DEFAULT_IGNORABLES = 8,
    HB_BUFFER_FLAG_DO_NOT_INSERT_DOTTED_CIRCLE = 16,
    HB_BUFFER_FLAG_VERIFY = 32,
    HB_BUFFER_FLAG_PRODUCE_UNSAFE_TO_CONCAT = 64,
    HB_BUFFER_FLAG_PRODUCE_SAFE_TO_INSERT_TATWEEL = 128,
    HB_BUFFER_FLAG_DEFINED = 0x000000FF,
}

pub extern("c") fn hb_buffer_set_flags(buffer: *hb_buffer_t, flags: hb_buffer_flags_t) -> void
pub extern("c") fn hb_buffer_get_flags(buffer: *const hb_buffer_t) -> hb_buffer_flags_t
pub const hb_buffer_cluster_level_t = enum(c_int) {
    HB_BUFFER_CLUSTER_LEVEL_MONOTONE_GRAPHEMES = 0,
    HB_BUFFER_CLUSTER_LEVEL_MONOTONE_CHARACTERS = 1,
    HB_BUFFER_CLUSTER_LEVEL_CHARACTERS = 2,
}
pub const HB_BUFFER_CLUSTER_LEVEL_DEFAULT = @intCast(hb_buffer_cluster_level_t, 0)

pub extern("c") fn hb_buffer_set_cluster_level(buffer: *hb_buffer_t, cluster_level: hb_buffer_cluster_level_t) -> void
pub extern("c") fn hb_buffer_get_cluster_level(buffer: *const hb_buffer_t) -> hb_buffer_cluster_level_t
pub extern("c") fn hb_buffer_set_replacement_codepoint(buffer: *hb_buffer_t, replacement: hb_codepoint_t) -> void
pub extern("c") fn hb_buffer_get_replacement_codepoint(buffer: *const hb_buffer_t) -> hb_codepoint_t
pub extern("c") fn hb_buffer_set_invisible_glyph(buffer: *hb_buffer_t, invisible: hb_codepoint_t) -> void
pub extern("c") fn hb_buffer_get_invisible_glyph(buffer: *const hb_buffer_t) -> hb_codepoint_t
pub extern("c") fn hb_buffer_set_not_found_glyph(buffer: *hb_buffer_t, not_found: hb_codepoint_t) -> void
pub extern("c") fn hb_buffer_get_not_found_glyph(buffer: *const hb_buffer_t) -> hb_codepoint_t
pub extern("c") fn hb_buffer_clear_contents(buffer: *hb_buffer_t) -> void
pub extern("c") fn hb_buffer_pre_allocate(buffer: *hb_buffer_t, size: c_uint) -> hb_bool_t
pub extern("c") fn hb_buffer_allocation_successful(buffer: *hb_buffer_t) -> hb_bool_t
pub extern("c") fn hb_buffer_reverse(buffer: *hb_buffer_t) -> void
pub extern("c") fn hb_buffer_reverse_range(buffer: *hb_buffer_t, start: c_uint, end: c_uint) -> void
pub extern("c") fn hb_buffer_reverse_clusters(buffer: *hb_buffer_t) -> void
pub extern("c") fn hb_buffer_add(buffer: *hb_buffer_t, codepoint: hb_codepoint_t, cluster: c_uint) -> void
pub extern("c") fn hb_buffer_add_utf8(buffer: *hb_buffer_t, text: *const c_char, text_length: c_int, item_offset: c_uint, item_length: c_int) -> void
pub extern("c") fn hb_buffer_add_utf16(buffer: *hb_buffer_t, text: *const u16, text_length: c_int, item_offset: c_uint, item_length: c_int) -> void
pub extern("c") fn hb_buffer_add_utf32(buffer: *hb_buffer_t, text: *const u32, text_length: c_int, item_offset: c_uint, item_length: c_int) -> void
pub extern("c") fn hb_buffer_add_latin1(buffer: *hb_buffer_t, text: *const u8, text_length: c_int, item_offset: c_uint, item_length: c_int) -> void
pub extern("c") fn hb_buffer_add_codepoints(buffer: *hb_buffer_t, text: *const hb_codepoint_t, text_length: c_int, item_offset: c_uint, item_length: c_int) -> void
pub extern("c") fn hb_buffer_append(buffer: *hb_buffer_t, source: *const hb_buffer_t, start: c_uint, end: c_uint) -> void
pub extern("c") fn hb_buffer_set_length(buffer: *hb_buffer_t, length: c_uint) -> hb_bool_t
pub extern("c") fn hb_buffer_get_length(buffer: *const hb_buffer_t) -> c_uint
pub extern("c") fn hb_buffer_get_glyph_infos(buffer: *hb_buffer_t, length: *c_uint) -> *hb_glyph_info_t
pub extern("c") fn hb_buffer_get_glyph_positions(buffer: *hb_buffer_t, length: *c_uint) -> *hb_glyph_position_t
pub extern("c") fn hb_buffer_has_positions(buffer: *hb_buffer_t) -> hb_bool_t
pub extern("c") fn hb_buffer_normalize_glyphs(buffer: *hb_buffer_t) -> void
pub const hb_buffer_serialize_flags_t = enum(c_int) {
    HB_BUFFER_SERIALIZE_FLAG_DEFAULT = 0,
    HB_BUFFER_SERIALIZE_FLAG_NO_CLUSTERS = 1,
    HB_BUFFER_SERIALIZE_FLAG_NO_POSITIONS = 2,
    HB_BUFFER_SERIALIZE_FLAG_NO_GLYPH_NAMES = 4,
    HB_BUFFER_SERIALIZE_FLAG_GLYPH_EXTENTS = 8,
    HB_BUFFER_SERIALIZE_FLAG_GLYPH_FLAGS = 16,
    HB_BUFFER_SERIALIZE_FLAG_NO_ADVANCES = 32,
    HB_BUFFER_SERIALIZE_FLAG_DEFINED = 0x0000003F,
}

pub const hb_buffer_serialize_format_t = enum(c_int) {
    HB_BUFFER_SERIALIZE_FORMAT_TEXT = 0x54455854,
    HB_BUFFER_SERIALIZE_FORMAT_JSON = 0x4A534F4E,
    HB_BUFFER_SERIALIZE_FORMAT_INVALID = 0,
}

pub extern("c") fn hb_buffer_serialize_format_from_string(str: *const c_char, len: c_int) -> hb_buffer_serialize_format_t
pub extern("c") fn hb_buffer_serialize_format_to_string(format: hb_buffer_serialize_format_t) -> *const c_char
pub extern("c") fn hb_buffer_serialize_list_formats() -> **const c_char
pub extern("c") fn hb_buffer_serialize_glyphs(buffer: *hb_buffer_t, start: c_uint, end: c_uint, buf: *c_char, buf_size: c_uint, buf_consumed: *c_uint, font: *hb_font_t, format: hb_buffer_serialize_format_t, flags: hb_buffer_serialize_flags_t) -> c_uint
pub extern("c") fn hb_buffer_serialize_unicode(buffer: *hb_buffer_t, start: c_uint, end: c_uint, buf: *c_char, buf_size: c_uint, buf_consumed: *c_uint, format: hb_buffer_serialize_format_t, flags: hb_buffer_serialize_flags_t) -> c_uint
pub extern("c") fn hb_buffer_serialize(buffer: *hb_buffer_t, start: c_uint, end: c_uint, buf: *c_char, buf_size: c_uint, buf_consumed: *c_uint, font: *hb_font_t, format: hb_buffer_serialize_format_t, flags: hb_buffer_serialize_flags_t) -> c_uint
pub extern("c") fn hb_buffer_deserialize_glyphs(buffer: *hb_buffer_t, buf: *const c_char, buf_len: c_int, end_ptr: **const c_char, font: *hb_font_t, format: hb_buffer_serialize_format_t) -> hb_bool_t
pub extern("c") fn hb_buffer_deserialize_unicode(buffer: *hb_buffer_t, buf: *const c_char, buf_len: c_int, end_ptr: **const c_char, format: hb_buffer_serialize_format_t) -> hb_bool_t
pub const hb_buffer_diff_flags_t = enum(c_int) {
    HB_BUFFER_DIFF_FLAG_EQUAL = 0,
    HB_BUFFER_DIFF_FLAG_CONTENT_TYPE_MISMATCH = 1,
    HB_BUFFER_DIFF_FLAG_LENGTH_MISMATCH = 2,
    HB_BUFFER_DIFF_FLAG_NOTDEF_PRESENT = 4,
    HB_BUFFER_DIFF_FLAG_DOTTED_CIRCLE_PRESENT = 8,
    HB_BUFFER_DIFF_FLAG_CODEPOINT_MISMATCH = 16,
    HB_BUFFER_DIFF_FLAG_CLUSTER_MISMATCH = 32,
    HB_BUFFER_DIFF_FLAG_GLYPH_FLAGS_MISMATCH = 64,
    HB_BUFFER_DIFF_FLAG_POSITION_MISMATCH = 128,
}

pub extern("c") fn hb_buffer_diff(buffer: *hb_buffer_t, reference: *hb_buffer_t, dottedcircle_glyph: hb_codepoint_t, position_fuzz: c_uint) -> hb_buffer_diff_flags_t
pub const hb_buffer_message_func_t = fn(buffer: *hb_buffer_t, font: *hb_font_t, message: *const c_char, user_data: *anyopaque) -> hb_bool_t

pub extern("c") fn hb_buffer_set_message_func(buffer: *hb_buffer_t, func: hb_buffer_message_func_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> void
pub const HB_BUFFER_REPLACEMENT_CODEPOINT_DEFAULT: c_uint = 0xFFFD

// The default segment properties: no direction, script or language.
pub const HB_SEGMENT_PROPERTIES_DEFAULT = hb_segment_properties_t.{ .direction = hb_direction_t.HB_DIRECTION_INVALID, .script = hb_script_t.HB_SCRIPT_INVALID, .language = HB_LANGUAGE_INVALID, .reserved1 = null, .reserved2 = null }

// The character that replaces invalid input (U+FFFD).
pub const HB_BUFFER_REPLACEMENT_CODEPOINT_DEFAULT: hb_codepoint_t = 0xFFFD
