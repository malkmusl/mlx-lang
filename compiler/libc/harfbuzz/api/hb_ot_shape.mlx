// hb-ot-shape.h
// mlx-harfbuzz: what the OpenType shaper can say of a shaping: the glyphs
// it may produce, the lookups of a plan.
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")

pub extern("c") fn hb_ot_shape_glyphs_closure(font: *hb_font_t, buffer: *hb_buffer_t, features: *const hb_feature_t, num_features: c_uint, glyphs: *hb_set_t) -> void
pub extern("c") fn hb_ot_shape_plan_collect_lookups(shape_plan: *hb_shape_plan_t, table_tag: hb_tag_t, lookup_indexes: *hb_set_t) -> void
