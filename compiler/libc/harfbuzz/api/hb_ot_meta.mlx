// hb-ot-meta.h
// mlx-harfbuzz: the meta table's metadata.
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")

pub const hb_ot_meta_tag_t = enum(c_int) {
    HB_OT_META_TAG_DESIGN_LANGUAGES = 0x646C6E67,
    HB_OT_META_TAG_SUPPORTED_LANGUAGES = 0x736C6E67,
    _HB_OT_META_TAG_MAX_VALUE = 0x7FFFFFFF,
}

pub extern("c") fn hb_ot_meta_get_entry_tags(face: *hb_face_t, start_offset: c_uint, entries_count: *c_uint, entries: *hb_ot_meta_tag_t) -> c_uint
pub extern("c") fn hb_ot_meta_reference_entry(face: *hb_face_t, meta_tag: hb_ot_meta_tag_t) -> *hb_blob_t
