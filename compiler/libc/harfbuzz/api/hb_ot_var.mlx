// hb-ot-var.h
// mlx-harfbuzz: font variations: the axes and named instances of fvar,
// design coordinates normalized (avar).
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")

pub extern("c") fn hb_ot_var_has_data(face: *hb_face_t) -> hb_bool_t
pub extern("c") fn hb_ot_var_get_axis_count(face: *hb_face_t) -> c_uint
pub const hb_ot_var_axis_flags_t = enum(c_int) {
    HB_OT_VAR_AXIS_FLAG_HIDDEN = 1,
    _HB_OT_VAR_AXIS_FLAG_MAX_VALUE = 0x7FFFFFFF,
}

pub const hb_ot_var_axis_info_t = struct {
    axis_index: c_uint
    tag: hb_tag_t
    name_id: hb_ot_name_id_t
    flags: hb_ot_var_axis_flags_t
    min_value: f32
    default_value: f32
    max_value: f32
    reserved: c_uint
}

pub extern("c") fn hb_ot_var_get_axis_infos(face: *hb_face_t, start_offset: c_uint, axes_count: *c_uint, axes_array: *hb_ot_var_axis_info_t) -> c_uint
pub extern("c") fn hb_ot_var_find_axis_info(face: *hb_face_t, axis_tag: hb_tag_t, axis_info: *hb_ot_var_axis_info_t) -> hb_bool_t
pub extern("c") fn hb_ot_var_get_named_instance_count(face: *hb_face_t) -> c_uint
pub extern("c") fn hb_ot_var_named_instance_get_subfamily_name_id(face: *hb_face_t, instance_index: c_uint) -> hb_ot_name_id_t
pub extern("c") fn hb_ot_var_named_instance_get_postscript_name_id(face: *hb_face_t, instance_index: c_uint) -> hb_ot_name_id_t
pub extern("c") fn hb_ot_var_named_instance_get_design_coords(face: *hb_face_t, instance_index: c_uint, coords_length: *c_uint, coords: *f32) -> c_uint
pub extern("c") fn hb_ot_var_normalize_variations(face: *hb_face_t, variations: *const hb_variation_t, variations_length: c_uint, coords: *c_int, coords_length: c_uint) -> void
pub extern("c") fn hb_ot_var_normalize_coords(face: *hb_face_t, coords_length: c_uint, design_coords: *const f32, normalized_coords: *c_int) -> void
pub const HB_OT_TAG_VAR_AXIS_ITALIC: hb_tag_t = 0x6974616C
pub const HB_OT_TAG_VAR_AXIS_OPTICAL_SIZE: hb_tag_t = 0x6F70737A
pub const HB_OT_TAG_VAR_AXIS_SLANT: hb_tag_t = 0x736C6E74
pub const HB_OT_TAG_VAR_AXIS_WIDTH: hb_tag_t = 0x77647468
pub const HB_OT_TAG_VAR_AXIS_WEIGHT: hb_tag_t = 0x77676874

pub const HB_OT_VAR_NO_AXIS_INDEX: c_uint = 0xFFFFFFFF
