// hb-map.h
// mlx-harfbuzz: maps of 32-bit keys to 32-bit values.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")
const hb_set = @import("./hb_set.mlx")

pub const hb_map_t = struct {}

pub extern("c") fn hb_map_create() -> *hb_map_t
pub extern("c") fn hb_map_get_empty() -> *hb_map_t
pub extern("c") fn hb_map_reference(map: *hb_map_t) -> *hb_map_t
pub extern("c") fn hb_map_destroy(map: *hb_map_t) -> void
pub extern("c") fn hb_map_set_user_data(map: *hb_map_t, key: *hb_user_data_key_t, data: *anyopaque, destroy: hb_destroy_func_t, replace: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_map_get_user_data(map: *const hb_map_t, key: *hb_user_data_key_t) -> *anyopaque
pub extern("c") fn hb_map_allocation_successful(map: *const hb_map_t) -> hb_bool_t
pub extern("c") fn hb_map_copy(map: *const hb_map_t) -> *hb_map_t
pub extern("c") fn hb_map_clear(map: *hb_map_t) -> void
pub extern("c") fn hb_map_is_empty(map: *const hb_map_t) -> hb_bool_t
pub extern("c") fn hb_map_get_population(map: *const hb_map_t) -> c_uint
pub extern("c") fn hb_map_is_equal(map: *const hb_map_t, other: *const hb_map_t) -> hb_bool_t
pub extern("c") fn hb_map_hash(map: *const hb_map_t) -> c_uint
pub extern("c") fn hb_map_set(map: *hb_map_t, key: hb_codepoint_t, value: hb_codepoint_t) -> void
pub extern("c") fn hb_map_get(map: *const hb_map_t, key: hb_codepoint_t) -> hb_codepoint_t
pub extern("c") fn hb_map_del(map: *hb_map_t, key: hb_codepoint_t) -> void
pub extern("c") fn hb_map_has(map: *const hb_map_t, key: hb_codepoint_t) -> hb_bool_t
pub extern("c") fn hb_map_update(map: *hb_map_t, other: *const hb_map_t) -> void
pub extern("c") fn hb_map_next(map: *const hb_map_t, idx: *c_int, key: *hb_codepoint_t, value: *hb_codepoint_t) -> hb_bool_t
pub extern("c") fn hb_map_keys(map: *const hb_map_t, keys: *hb_set_t) -> void
pub extern("c") fn hb_map_values(map: *const hb_map_t, values: *hb_set_t) -> void

pub const HB_MAP_VALUE_INVALID: hb_codepoint_t = 0xFFFFFFFF
