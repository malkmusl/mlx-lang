// hb-features.h
// mlx-harfbuzz: what this build of the library has: FreeType and ICU
// integration.
const c_function_pointers = true
const c_keyword_names = true

// The library has hb-ft.h (on libmlxfreetype) and hb-icu.h (on
// libmlxunicode).
pub const HB_HAS_FREETYPE: c_int = 1
pub const HB_HAS_ICU: c_int = 1
