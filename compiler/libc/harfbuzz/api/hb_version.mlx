// hb-version.h
// mlx-harfbuzz: the version this library is compatible with (HarfBuzz
// 8.3.0) and HB_VERSION_ATLEAST.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")

pub extern("c") fn hb_version(major: *c_uint, minor: *c_uint, micro: *c_uint) -> void
pub extern("c") fn hb_version_string() -> *const c_char
pub extern("c") fn hb_version_atleast(major: c_uint, minor: c_uint, micro: c_uint) -> hb_bool_t
pub const HB_VERSION_MAJOR: c_uint = 8
pub const HB_VERSION_MINOR: c_uint = 3
pub const HB_VERSION_MICRO: c_uint = 0

pub const HB_VERSION_MAJOR: c_int = 8
pub const HB_VERSION_MINOR: c_int = 3
pub const HB_VERSION_MICRO: c_int = 0
pub const HB_VERSION_STRING: []const u8 = "8.3.0"

// Whether the version is at least major.minor.micro (in #if too).
pub fn HB_VERSION_ATLEAST(major: anytype, minor: anytype, micro: anytype) -> bool {
    return major * 10000 + minor * 100 + micro <= HB_VERSION_MAJOR * 10000 + HB_VERSION_MINOR * 100 + HB_VERSION_MICRO
}
