// hb-draw.h
// mlx-harfbuzz: drawing glyph outlines: the callbacks a program gives for
// moves, lines, quadratic and cubic curves and closed paths.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")

pub const hb_draw_state_t = struct {
    path_open: hb_bool_t
    path_start_x: f32
    path_start_y: f32
    current_x: f32
    current_y: f32
    reserved1: hb_var_num_t
    reserved2: hb_var_num_t
    reserved3: hb_var_num_t
    reserved4: hb_var_num_t
    reserved5: hb_var_num_t
    reserved6: hb_var_num_t
    reserved7: hb_var_num_t
}

pub const hb_draw_funcs_t = struct {}

pub const hb_draw_move_to_func_t = fn(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t, to_x: f32, to_y: f32, user_data: *anyopaque) -> void

pub const hb_draw_line_to_func_t = fn(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t, to_x: f32, to_y: f32, user_data: *anyopaque) -> void

pub const hb_draw_quadratic_to_func_t = fn(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t, control_x: f32, control_y: f32, to_x: f32, to_y: f32, user_data: *anyopaque) -> void

pub const hb_draw_cubic_to_func_t = fn(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t, control1_x: f32, control1_y: f32, control2_x: f32, control2_y: f32, to_x: f32, to_y: f32, user_data: *anyopaque) -> void

pub const hb_draw_close_path_func_t = fn(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t, user_data: *anyopaque) -> void

pub extern("c") fn hb_draw_funcs_set_move_to_func(dfuncs: *hb_draw_funcs_t, func: hb_draw_move_to_func_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> void
pub extern("c") fn hb_draw_funcs_set_line_to_func(dfuncs: *hb_draw_funcs_t, func: hb_draw_line_to_func_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> void
pub extern("c") fn hb_draw_funcs_set_quadratic_to_func(dfuncs: *hb_draw_funcs_t, func: hb_draw_quadratic_to_func_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> void
pub extern("c") fn hb_draw_funcs_set_cubic_to_func(dfuncs: *hb_draw_funcs_t, func: hb_draw_cubic_to_func_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> void
pub extern("c") fn hb_draw_funcs_set_close_path_func(dfuncs: *hb_draw_funcs_t, func: hb_draw_close_path_func_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> void
pub extern("c") fn hb_draw_funcs_create() -> *hb_draw_funcs_t
pub extern("c") fn hb_draw_funcs_get_empty() -> *hb_draw_funcs_t
pub extern("c") fn hb_draw_funcs_reference(dfuncs: *hb_draw_funcs_t) -> *hb_draw_funcs_t
pub extern("c") fn hb_draw_funcs_destroy(dfuncs: *hb_draw_funcs_t) -> void
pub extern("c") fn hb_draw_funcs_set_user_data(dfuncs: *hb_draw_funcs_t, key: *hb_user_data_key_t, data: *anyopaque, destroy: hb_destroy_func_t, replace: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_draw_funcs_get_user_data(dfuncs: *const hb_draw_funcs_t, key: *hb_user_data_key_t) -> *anyopaque
pub extern("c") fn hb_draw_funcs_make_immutable(dfuncs: *hb_draw_funcs_t) -> void
pub extern("c") fn hb_draw_funcs_is_immutable(dfuncs: *hb_draw_funcs_t) -> hb_bool_t
pub extern("c") fn hb_draw_move_to(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t, to_x: f32, to_y: f32) -> void
pub extern("c") fn hb_draw_line_to(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t, to_x: f32, to_y: f32) -> void
pub extern("c") fn hb_draw_quadratic_to(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t, control_x: f32, control_y: f32, to_x: f32, to_y: f32) -> void
pub extern("c") fn hb_draw_cubic_to(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t, control1_x: f32, control1_y: f32, control2_x: f32, control2_y: f32, to_x: f32, to_y: f32) -> void
pub extern("c") fn hb_draw_close_path(dfuncs: *hb_draw_funcs_t, draw_data: *anyopaque, st: *hb_draw_state_t) -> void

// A drawing's state at its start.
pub const HB_DRAW_STATE_DEFAULT = hb_draw_state_t.{ .path_open = 0, .path_start_x = 0.0, .path_start_y = 0.0, .current_x = 0.0, .current_y = 0.0, .reserved1 = 0, .reserved2 = 0, .reserved3 = 0 }
