// hb-ot-color.h
// mlx-harfbuzz: color fonts: CPAL palettes, COLR layers and paints, SVG
// documents and PNG images of glyphs (sbix, CBDT).
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")
const hb_ot_name = @import("./hb_ot_name.mlx")

pub extern("c") fn hb_ot_color_has_palettes(face: *hb_face_t) -> hb_bool_t
pub extern("c") fn hb_ot_color_palette_get_count(face: *hb_face_t) -> c_uint
pub extern("c") fn hb_ot_color_palette_get_name_id(face: *hb_face_t, palette_index: c_uint) -> hb_ot_name_id_t
pub extern("c") fn hb_ot_color_palette_color_get_name_id(face: *hb_face_t, color_index: c_uint) -> hb_ot_name_id_t
pub const hb_ot_color_palette_flags_t = enum(c_int) {
    HB_OT_COLOR_PALETTE_FLAG_DEFAULT = 0,
    HB_OT_COLOR_PALETTE_FLAG_USABLE_WITH_LIGHT_BACKGROUND = 1,
    HB_OT_COLOR_PALETTE_FLAG_USABLE_WITH_DARK_BACKGROUND = 2,
}

pub extern("c") fn hb_ot_color_palette_get_flags(face: *hb_face_t, palette_index: c_uint) -> hb_ot_color_palette_flags_t
pub extern("c") fn hb_ot_color_palette_get_colors(face: *hb_face_t, palette_index: c_uint, start_offset: c_uint, color_count: *c_uint, colors: *hb_color_t) -> c_uint
pub extern("c") fn hb_ot_color_has_layers(face: *hb_face_t) -> hb_bool_t
pub const hb_ot_color_layer_t = struct {
    glyph: hb_codepoint_t
    color_index: c_uint
}

pub extern("c") fn hb_ot_color_glyph_get_layers(face: *hb_face_t, glyph: hb_codepoint_t, start_offset: c_uint, layer_count: *c_uint, layers: *hb_ot_color_layer_t) -> c_uint
pub extern("c") fn hb_ot_color_has_paint(face: *hb_face_t) -> hb_bool_t
pub extern("c") fn hb_ot_color_glyph_has_paint(face: *hb_face_t, glyph: hb_codepoint_t) -> hb_bool_t
pub extern("c") fn hb_ot_color_has_svg(face: *hb_face_t) -> hb_bool_t
pub extern("c") fn hb_ot_color_glyph_reference_svg(face: *hb_face_t, glyph: hb_codepoint_t) -> *hb_blob_t
pub extern("c") fn hb_ot_color_has_png(face: *hb_face_t) -> hb_bool_t
pub extern("c") fn hb_ot_color_glyph_reference_png(font: *hb_font_t, glyph: hb_codepoint_t) -> *hb_blob_t
