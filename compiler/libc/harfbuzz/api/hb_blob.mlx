// hb-blob.h
// mlx-harfbuzz: blobs: a range of bytes the library reads fonts from, with
// the way it is held (duplicated, read-only, writable), sub-blobs and
// blobs of files.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")

pub const hb_memory_mode_t = enum(c_int) {
    HB_MEMORY_MODE_DUPLICATE = 0,
    HB_MEMORY_MODE_READONLY = 1,
    HB_MEMORY_MODE_WRITABLE = 2,
    HB_MEMORY_MODE_READONLY_MAY_MAKE_WRITABLE = 3,
}

pub const hb_blob_t = struct {}

pub extern("c") fn hb_blob_create(data: *const c_char, length: c_uint, mode: hb_memory_mode_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> *hb_blob_t
pub extern("c") fn hb_blob_create_or_fail(data: *const c_char, length: c_uint, mode: hb_memory_mode_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> *hb_blob_t
pub extern("c") fn hb_blob_create_from_file(file_name: *const c_char) -> *hb_blob_t
pub extern("c") fn hb_blob_create_from_file_or_fail(file_name: *const c_char) -> *hb_blob_t
pub extern("c") fn hb_blob_create_sub_blob(parent: *hb_blob_t, offset: c_uint, length: c_uint) -> *hb_blob_t
pub extern("c") fn hb_blob_copy_writable_or_fail(blob: *hb_blob_t) -> *hb_blob_t
pub extern("c") fn hb_blob_get_empty() -> *hb_blob_t
pub extern("c") fn hb_blob_reference(blob: *hb_blob_t) -> *hb_blob_t
pub extern("c") fn hb_blob_destroy(blob: *hb_blob_t) -> void
pub extern("c") fn hb_blob_set_user_data(blob: *hb_blob_t, key: *hb_user_data_key_t, data: *anyopaque, destroy: hb_destroy_func_t, replace: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_blob_get_user_data(blob: *const hb_blob_t, key: *hb_user_data_key_t) -> *anyopaque
pub extern("c") fn hb_blob_make_immutable(blob: *hb_blob_t) -> void
pub extern("c") fn hb_blob_is_immutable(blob: *hb_blob_t) -> hb_bool_t
pub extern("c") fn hb_blob_get_length(blob: *hb_blob_t) -> c_uint
pub extern("c") fn hb_blob_get_data(blob: *hb_blob_t, length: *c_uint) -> *const c_char
pub extern("c") fn hb_blob_get_data_writable(blob: *hb_blob_t, length: *c_uint) -> *c_char
