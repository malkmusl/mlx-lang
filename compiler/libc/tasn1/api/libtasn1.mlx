// libtasn1.h
// mlx-tasn1: libtasn1's C API (4.19), the part WebKit's PAL::TASN1
// (Source/WebCore/PAL/pal/crypto/tasn1) calls to read and write the DER
// of WebCrypto's keys (SubjectPublicKeyInfo, PKCS #8, ECPrivateKey,
// RSAPublicKey, RSAPrivateKey): definitions from asn1Parser's static
// arrays, structures made of them, DER decoding and encoding, and the
// reading and writing of their elements; implemented in Mlx by
// libmlxtasn1.so (compiler/libc/tasn1).
const c_function_pointers = true
const c_keyword_names = true
const c_system_headers = "stdio.h sys/types.h time.h"

pub const c_char = u8
pub const c_uchar = u8
pub const c_int = i32
pub const c_uint = u32
pub const c_size = usize

pub const ASN1_VERSION: []const u8 = "4.19.0"
pub const ASN1_VERSION_MAJOR: c_int = 4
pub const ASN1_VERSION_MINOR: c_int = 19
pub const ASN1_VERSION_PATCH: c_int = 0
pub const ASN1_VERSION_NUMBER: c_int = 0x041300

// The errors.
pub const ASN1_SUCCESS: c_int = 0
pub const ASN1_FILE_NOT_FOUND: c_int = 1
pub const ASN1_ELEMENT_NOT_FOUND: c_int = 2
pub const ASN1_IDENTIFIER_NOT_FOUND: c_int = 3
pub const ASN1_DER_ERROR: c_int = 4
pub const ASN1_VALUE_NOT_FOUND: c_int = 5
pub const ASN1_GENERIC_ERROR: c_int = 6
pub const ASN1_VALUE_NOT_VALID: c_int = 7
pub const ASN1_TAG_ERROR: c_int = 8
pub const ASN1_TAG_IMPLICIT: c_int = 9
pub const ASN1_ERROR_TYPE_ANY: c_int = 10
pub const ASN1_SYNTAX_ERROR: c_int = 11
pub const ASN1_MEM_ERROR: c_int = 12
pub const ASN1_MEM_ALLOC_ERROR: c_int = 13
pub const ASN1_DER_OVERFLOW: c_int = 14
pub const ASN1_NAME_TOO_LONG: c_int = 15
pub const ASN1_ARRAY_ERROR: c_int = 16
pub const ASN1_ELEMENT_NOT_EMPTY: c_int = 17
pub const ASN1_TIME_ENCODING_ERROR: c_int = 18
pub const ASN1_RECURSION: c_int = 19

// asn1_print_structure's modes.
pub const ASN1_PRINT_NAME: c_int = 1
pub const ASN1_PRINT_NAME_TYPE: c_int = 2
pub const ASN1_PRINT_NAME_TYPE_VALUE: c_int = 3
pub const ASN1_PRINT_ALL: c_int = 4

// Tag classes and the universal tags.
pub const ASN1_CLASS_UNIVERSAL: c_int = 0x00
pub const ASN1_CLASS_APPLICATION: c_int = 0x40
pub const ASN1_CLASS_CONTEXT_SPECIFIC: c_int = 0x80
pub const ASN1_CLASS_PRIVATE: c_int = 0xC0
pub const ASN1_CLASS_STRUCTURED: c_int = 0x20
pub const ASN1_TAG_BOOLEAN: c_int = 0x01
pub const ASN1_TAG_INTEGER: c_int = 0x02
pub const ASN1_TAG_SEQUENCE: c_int = 0x10
pub const ASN1_TAG_SET: c_int = 0x11
pub const ASN1_TAG_OCTET_STRING: c_int = 0x04
pub const ASN1_TAG_BIT_STRING: c_int = 0x03
pub const ASN1_TAG_UTCTime: c_int = 0x17
pub const ASN1_TAG_GENERALIZEDTime: c_int = 0x18
pub const ASN1_TAG_OBJECT_ID: c_int = 0x06
pub const ASN1_TAG_ENUMERATED: c_int = 0x0A
pub const ASN1_TAG_NULL: c_int = 0x05
pub const ASN1_TAG_GENERALSTRING: c_int = 0x1B
pub const ASN1_TAG_NUMERIC_STRING: c_int = 0x12
pub const ASN1_TAG_IA5_STRING: c_int = 0x16
pub const ASN1_TAG_TELETEX_STRING: c_int = 0x14
pub const ASN1_TAG_PRINTABLE_STRING: c_int = 0x13
pub const ASN1_TAG_UNIVERSAL_STRING: c_int = 0x1C
pub const ASN1_TAG_BMP_STRING: c_int = 0x1E
pub const ASN1_TAG_UTF8_STRING: c_int = 0x0C
pub const ASN1_TAG_VISIBLE_STRING: c_int = 0x1A

// A structure or definitions tree (the library's own).
pub const asn1_node_st = struct {}
pub const asn1_node = *asn1_node_st
pub const asn1_node_const = *const asn1_node_st

pub const ASN1_MAX_NAME_SIZE: c_int = 64
pub const ASN1_MAX_ERROR_DESCRIPTION_SIZE: c_int = 128

// One node of the definitions asn1Parser writes as C.
pub const asn1_static_node_st = struct {
    name: ?[*]const c_char
    type_: c_uint
    value: ?*const anyopaque
}
pub const asn1_static_node = asn1_static_node_st

// The types of asn1_read_value_type.
pub const ASN1_ETYPE_INVALID: c_uint = 0
pub const ASN1_ETYPE_CONSTANT: c_uint = 1
pub const ASN1_ETYPE_IDENTIFIER: c_uint = 2
pub const ASN1_ETYPE_INTEGER: c_uint = 3
pub const ASN1_ETYPE_BOOLEAN: c_uint = 4
pub const ASN1_ETYPE_SEQUENCE: c_uint = 5
pub const ASN1_ETYPE_BIT_STRING: c_uint = 6
pub const ASN1_ETYPE_OCTET_STRING: c_uint = 7
pub const ASN1_ETYPE_TAG: c_uint = 8
pub const ASN1_ETYPE_DEFAULT: c_uint = 9
pub const ASN1_ETYPE_SIZE: c_uint = 10
pub const ASN1_ETYPE_SEQUENCE_OF: c_uint = 11
pub const ASN1_ETYPE_OBJECT_ID: c_uint = 12
pub const ASN1_ETYPE_ANY: c_uint = 13
pub const ASN1_ETYPE_SET: c_uint = 14
pub const ASN1_ETYPE_SET_OF: c_uint = 15
pub const ASN1_ETYPE_DEFINITIONS: c_uint = 16
pub const ASN1_ETYPE_CHOICE: c_uint = 18
pub const ASN1_ETYPE_IMPORTS: c_uint = 19
pub const ASN1_ETYPE_NULL: c_uint = 20
pub const ASN1_ETYPE_ENUMERATED: c_uint = 21
pub const ASN1_ETYPE_GENERALSTRING: c_uint = 27
pub const ASN1_ETYPE_NUMERIC_STRING: c_uint = 28
pub const ASN1_ETYPE_IA5_STRING: c_uint = 29
pub const ASN1_ETYPE_TELETEX_STRING: c_uint = 30
pub const ASN1_ETYPE_PRINTABLE_STRING: c_uint = 31
pub const ASN1_ETYPE_UNIVERSAL_STRING: c_uint = 32
pub const ASN1_ETYPE_BMP_STRING: c_uint = 33
pub const ASN1_ETYPE_UTF8_STRING: c_uint = 34
pub const ASN1_ETYPE_VISIBLE_STRING: c_uint = 35
pub const ASN1_ETYPE_UTC_TIME: c_uint = 36
pub const ASN1_ETYPE_GENERALIZED_TIME: c_uint = 37

// asn1_der_decoding2's flags.
pub const ASN1_DECODE_FLAG_ALLOW_PADDING: c_uint = 1
pub const ASN1_DECODE_FLAG_STRICT_DER: c_uint = 2
pub const ASN1_DECODE_FLAG_ALLOW_INCORRECT_TIME: c_uint = 4

pub extern("c") fn asn1_array2tree(array: [*]const asn1_static_node, definitions: *?asn1_node, errorDescription: ?[*]c_char) -> c_int
pub extern("c") fn asn1_create_element(definitions: asn1_node_const, source_name: [*]const c_char, element: *?asn1_node) -> c_int
pub extern("c") fn asn1_delete_structure(structure: *?asn1_node) -> c_int
pub extern("c") fn asn1_write_value(node_root: asn1_node, name: [*]const c_char, ivalue: ?*const anyopaque, len: c_int) -> c_int
pub extern("c") fn asn1_read_value(root: asn1_node_const, name: [*]const c_char, ivalue: ?*anyopaque, len: *c_int) -> c_int
pub extern("c") fn asn1_read_value_type(root: asn1_node_const, name: [*]const c_char, ivalue: ?*anyopaque, len: *c_int, etype: ?*c_uint) -> c_int
pub extern("c") fn asn1_der_coding(element: asn1_node_const, name: [*]const c_char, ider: ?*anyopaque, len: *c_int, ErrorDescription: ?[*]c_char) -> c_int
pub extern("c") fn asn1_der_decoding(element: *?asn1_node, ider: *const anyopaque, ider_len: c_int, errorDescription: ?[*]c_char) -> c_int
pub extern("c") fn asn1_der_decoding2(element: *?asn1_node, ider: *const anyopaque, max_ider_len: *c_int, flags: c_uint, errorDescription: ?[*]c_char) -> c_int
pub extern("c") fn asn1_strerror(error_: c_int) -> ?[*]const c_char
pub extern("c") fn asn1_perror(error_: c_int) -> void
pub extern("c") fn asn1_check_version(req_version: ?[*]const c_char) -> ?[*]const c_char
