// libmlxtasn1.so: libtasn1's C API (4.19, declared by api/libtasn1.mlx,
// whose header mlx-cheaders makes), the part WebKit's PAL::TASN1 calls,
// in Mlx:
//
//     ./mlx build tasn1
//
// A tree of nodes holds both the definitions (asn1_array2tree makes them
// of the array asn1Parser writes: each entry's flags say whether the next
// one is its first child or its next sibling) and the structures made of
// them (asn1_create_element copies a definition, with the types it names
// put in place of the names). A node has a name, libtasn1's type word (the
// type in the low byte, the flags above: OPTIONAL, tags...), a value and
// its children; helper nodes (TAG, SIZE, CONSTANT, DEFAULT) carry what a
// definition says of its parent.
//
// Values are kept as their contents: an INTEGER's two's complement bytes,
// an OBJECT IDENTIFIER's dotted text, a BIT STRING's bytes and bit count,
// an ANY's whole encoding. DER decoding walks a structure against the
// bytes (OPTIONAL elements that are not there are deleted, a CHOICE keeps
// the alternative found, a SEQUENCE OF grows "?1", "?2"...); encoding
// writes the elements with their tags, explicit and implicit, the members
// of a SET OF in DER's order. What is read and written, and the errors,
// are libtasn1's (tests/tasn1.c prints what libtasn1 prints).
const std = @import("std")

extern("c") fn calloc(count: usize, size: usize) -> usize
extern("c") fn realloc(address: usize, size: usize) -> usize
extern("c") fn free(address: usize) -> void

const SUCCESS: i32 = 0
const ELEMENT_NOT_FOUND: i32 = 2
const IDENTIFIER_NOT_FOUND: i32 = 3
const DER_ERROR: i32 = 4
const VALUE_NOT_FOUND: i32 = 5
const GENERIC_ERROR: i32 = 6
const VALUE_NOT_VALID: i32 = 7
const TAG_ERROR: i32 = 8
const MEM_ERROR: i32 = 12
const MEM_ALLOC_ERROR: i32 = 13
const ARRAY_ERROR: i32 = 16
const ELEMENT_NOT_EMPTY: i32 = 17

// The types (the type word's low byte).
const T_CONSTANT: u32 = 1
const T_IDENTIFIER: u32 = 2
const T_INTEGER: u32 = 3
const T_BOOLEAN: u32 = 4
const T_SEQUENCE: u32 = 5
const T_BIT_STRING: u32 = 6
const T_OCTET_STRING: u32 = 7
const T_TAG: u32 = 8
const T_DEFAULT: u32 = 9
const T_SIZE: u32 = 10
const T_SEQUENCE_OF: u32 = 11
const T_OBJECT_ID: u32 = 12
const T_ANY: u32 = 13
const T_SET: u32 = 14
const T_SET_OF: u32 = 15
const T_DEFINITIONS: u32 = 16
const T_TIME: u32 = 17
const T_CHOICE: u32 = 18
const T_NULL: u32 = 20
const T_ENUMERATED: u32 = 21
const T_GENERALSTRING: u32 = 27
const T_NUMERIC_STRING: u32 = 28
const T_IA5_STRING: u32 = 29
const T_TELETEX_STRING: u32 = 30
const T_PRINTABLE_STRING: u32 = 31
const T_UNIVERSAL_STRING: u32 = 32
const T_BMP_STRING: u32 = 33
const T_UTF8_STRING: u32 = 34
const T_VISIBLE_STRING: u32 = 35
const T_UTC_TIME: u32 = 36
const T_GENERALIZED_TIME: u32 = 37

// The flags.
const F_UNIVERSAL: u32 = 256
const F_PRIVATE: u32 = 512
const F_APPLICATION: u32 = 1024
const F_EXPLICIT: u32 = 2048
const F_IMPLICIT: u32 = 4096
const F_TAG: u32 = 8192
const F_OPTION: u32 = 16384
const F_DEFAULT: u32 = 32768
const F_LIST: u32 = 262144
const F_SIZE: u32 = 2097152
const F_GENERALIZED: u32 = 8388608
const F_UTC: u32 = 16777216
const F_NOT_USED: u32 = 67108864
const F_SET: u32 = 134217728
const F_ASSIGN: u32 = 268435456
const F_DOWN: u32 = 536870912
const F_RIGHT: u32 = 1073741824

// ---------------------------------------------------------------------------
// Memory.

fn alloc(size: usize) -> usize { return calloc(1, if size == 0 { 1 } else { size }) }

fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }
fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }
fn put32(address: usize, value: u32) -> void { unsafe { @ptrFromInt(*u32, address).* = value } }
fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }
fn getInt(address: usize) -> i32 { unsafe { return @ptrFromInt(*i32, address).* } }
fn putInt(address: usize, value: i32) -> void { unsafe { @ptrFromInt(*i32, address).* = value } }

fn copyBytes(target: usize, source: usize, count: usize) -> void {
    var index: usize = 0
    while index < count {
        put8(target + index, get8(source + index))
        index += 1
    }
}

fn cLength(text: usize) -> usize {
    var length: usize = 0
    while get8(text + length) != 0 { length += 1 }
    return length
}

fn sameText(a: usize, aLength: usize, b: usize, bLength: usize) -> bool {
    if aLength != bLength { return false }
    var index: usize = 0
    while index < aLength {
        if get8(a + index) != get8(b + index) { return false }
        index += 1
    }
    return true
}

fn sameLiteral(a: usize, aLength: usize, b: []const u8) -> bool { return sameText(a, aLength, @intFromPtr(b.pointer), b.length) }

// A buffer that grows as it is written.
const Buffer = struct {
    address: usize
    length: usize
    capacity: usize
}

fn bufferInit(b: *Buffer) -> void {
    b.*.capacity = 64
    b.*.address = alloc(64)
    b.*.length = 0
}

fn bufferRoom(b: *Buffer, more: usize) -> void {
    if b.*.length + more <= b.*.capacity { return }
    var capacity = b.*.capacity * 2
    while capacity < b.*.length + more { capacity *= 2 }
    b.*.address = realloc(b.*.address, capacity)
    b.*.capacity = capacity
}

fn pushByte(b: *Buffer, byte: u8) -> void {
    bufferRoom(b, 1)
    put8(b.*.address + b.*.length, byte)
    b.*.length += 1
}

fn pushBytes(b: *Buffer, source: usize, count: usize) -> void {
    bufferRoom(b, count)
    copyBytes(b.*.address + b.*.length, source, count)
    b.*.length += count
}

// ---------------------------------------------------------------------------
// Nodes.

const Node = struct {
    name: usize
    nameLength: usize
    kind: u32
    value: usize
    valueLength: usize
    hasValue: bool
    // A BIT STRING's bits.
    bits: usize
    down: usize
    right: usize
    up: usize
}

fn at(address: usize) -> *Node { unsafe { return @ptrFromInt(*Node, address) } }

fn typeOf(address: usize) -> u32 { return at(address).*.kind & 255 }

fn newNode(kind: u32) -> usize {
    const address = alloc(@sizeOf(Node))
    at(address).*.kind = kind
    return address
}

fn setName(node: usize, text: usize, length: usize) -> void {
    const n = at(node)
    if n.*.name != 0 { free(n.*.name) }
    n.*.name = alloc(length + 1)
    copyBytes(n.*.name, text, length)
    n.*.nameLength = length
}

fn setNameLiteral(node: usize, text: []const u8) -> void { setName(node, @intFromPtr(text.pointer), text.length) }

fn setValue(node: usize, bytes: usize, length: usize) -> void {
    const n = at(node)
    if n.*.value != 0 { free(n.*.value) }
    n.*.value = alloc(length + 1)
    if length > 0 { copyBytes(n.*.value, bytes, length) }
    n.*.valueLength = length
    n.*.hasValue = true
}

fn clearValue(node: usize) -> void {
    const n = at(node)
    if n.*.value != 0 { free(n.*.value) }
    n.*.value = 0
    n.*.valueLength = 0
    n.*.hasValue = false
}

fn freeTree(node: usize) -> void {
    if node == 0 { return }
    var child = at(node).*.down
    while child != 0 {
        const next = at(child).*.right
        freeTree(child)
        child = next
    }
    const n = at(node)
    if n.*.name != 0 { free(n.*.name) }
    if n.*.value != 0 { free(n.*.value) }
    free(node)
}

// The node out of its parent's children.
fn unlink(node: usize) -> void {
    const parent = at(node).*.up
    if parent == 0 { return }
    if at(parent).*.down == node {
        at(parent).*.down = at(node).*.right
    } else {
        var sibling = at(parent).*.down
        while sibling != 0 && at(sibling).*.right != node { sibling = at(sibling).*.right }
        if sibling != 0 { at(sibling).*.right = at(node).*.right }
    }
    at(node).*.right = 0
    at(node).*.up = 0
}

fn deleteNode(node: usize) -> void {
    unlink(node)
    freeTree(node)
}

fn lastChild(parent: usize) -> usize {
    var child = at(parent).*.down
    if child == 0 { return 0 }
    while at(child).*.right != 0 { child = at(child).*.right }
    return child
}

fn appendChild(parent: usize, child: usize) -> void {
    at(child).*.up = parent
    at(child).*.right = 0
    const last = lastChild(parent)
    if last == 0 {
        at(parent).*.down = child
    } else {
        at(last).*.right = child
    }
}

// A copy of the node and what is under it (not its siblings).
fn copyTree(node: usize) -> usize {
    const n = at(node)
    const copied = newNode(n.*.kind)
    if n.*.name != 0 { setName(copied, n.*.name, n.*.nameLength) }
    if n.*.hasValue { setValue(copied, n.*.value, n.*.valueLength) }
    at(copied).*.bits = n.*.bits
    var child = n.*.down
    while child != 0 {
        appendChild(copied, copyTree(child))
        child = at(child).*.right
    }
    return copied
}

fn isHelper(node: usize) -> bool {
    const t = typeOf(node)
    return t == T_TAG || t == T_SIZE || t == T_CONSTANT || t == T_DEFAULT
}

// The first child that is an element (not a TAG, SIZE...), from `node`.
fn element(node: usize) -> usize {
    var p = node
    while p != 0 && isHelper(p) { p = at(p).*.right }
    return p
}

// libtasn1's asn1_find_node: dotted names, the first matched against the
// root (and its siblings) unless the root has no name; "?LAST" is the
// last child.
fn findNode(root: usize, name: usize) -> usize {
    if root == 0 || name == 0 { return 0 }
    var p = root
    var start = name
    const total = cLength(name)
    const end = name + total
    if at(root).*.nameLength != 0 {
        var stop = start
        while stop < end && get8(stop) != 46 { stop += 1 }
        while p != 0 && !sameText(at(p).*.name, at(p).*.nameLength, start, stop - start) { p = at(p).*.right }
        if p == 0 { return 0 }
        if stop >= end { return p }
        start = stop + 1
    } else if total == 0 {
        return root
    }
    while true {
        var stop = start
        while stop < end && get8(stop) != 46 { stop += 1 }
        p = at(p).*.down
        if p == 0 { return 0 }
        if stop - start >= 2 && get8(start) == 63 && get8(start + 1) == 76 {
            while at(p).*.right != 0 { p = at(p).*.right }
        } else {
            while p != 0 && !sameText(at(p).*.name, at(p).*.nameLength, start, stop - start) { p = at(p).*.right }
            if p == 0 { return 0 }
        }
        if stop >= end { break }
        start = stop + 1
    }
    return p
}

// ---------------------------------------------------------------------------
// Definitions: asn1_array2tree.

var missingIdentifier: [130]u8 = undefined
var missingLength: usize = 0

// Every IDENTIFIER names a definition: else the first that does not.
fn checkIdentifiers(root: usize) -> i32 {
    var name: [200]u8 = undefined
    return checkUnder(root, root, &name)
}

fn checkUnder(root: usize, node: usize, scratch: [*]u8) -> i32 {
    var child = at(node).*.down
    while child != 0 {
        const c = at(child)
        if typeOf(child) == T_IDENTIFIER && c.*.hasValue {
            const r = at(root)
            if r.*.nameLength + 1 + c.*.valueLength < 199 {
                copyBytes(@intFromPtr(scratch), r.*.name, r.*.nameLength)
                scratch[r.*.nameLength] = 46
                copyBytes(@intFromPtr(scratch) + r.*.nameLength + 1, c.*.value, c.*.valueLength)
                scratch[r.*.nameLength + 1 + c.*.valueLength] = 0
                if findNode(root, @intFromPtr(scratch)) == 0 {
                    const length = if c.*.valueLength > 128 { 128 } else { c.*.valueLength }
                    copyBytes(@intFromPtr(&missingIdentifier), c.*.value, length)
                    missingLength = length
                    return IDENTIFIER_NOT_FOUND
                }
            }
        }
        const result = checkUnder(root, child, scratch)
        if result != SUCCESS { return result }
        child = c.*.right
    }
    return SUCCESS
}

fn describe(errorDescription: usize, text: []const u8) -> void {
    if errorDescription == 0 { return }
    copyBytes(errorDescription, @intFromPtr(text.pointer), text.length)
    put8(errorDescription + text.length, 0)
}

export fn asn1_array2tree(array: usize, definitions: usize, errorDescription: usize) -> i32 {
    if errorDescription != 0 { put8(errorDescription, 0) }
    if getWord(definitions) != 0 { return ELEMENT_NOT_EMPTY }
    var root: usize = 0
    var last: usize = 0
    // 1 up (the first), 2 right, 3 down.
    var move: u8 = 1
    var k: usize = 0
    while true {
        const entry = array + k * 24
        const name = getWord(entry)
        var kind = get32(entry + 8)
        const value = getWord(entry + 16)
        if name == 0 && kind == 0 && value == 0 { break }
        // The old TIME type is UTC or generalized.
        if kind & 255 == T_TIME {
            const time = if kind & F_UTC != 0 { T_UTC_TIME } else { T_GENERALIZED_TIME }
            kind = (kind & (F_UTC | F_GENERALIZED | 255) ^ 4294967295) | time
        }
        const node = newNode(kind & (F_DOWN ^ 4294967295))
        if name != 0 { setName(node, name, cLength(name)) }
        if value != 0 { setValue(node, value, cLength(value)) }
        if root == 0 { root = node }
        if move == 3 {
            at(last).*.down = node
            at(node).*.up = last
        } else if move == 2 {
            at(last).*.right = node
            at(node).*.up = at(last).*.up
        }
        last = node
        if kind & F_DOWN != 0 {
            move = 3
        } else if kind & F_RIGHT != 0 {
            move = 2
        } else {
            while last != root {
                last = at(last).*.up
                if last == 0 { break }
                if at(last).*.kind & F_RIGHT != 0 {
                    at(last).*.kind = at(last).*.kind & (F_RIGHT ^ 4294967295)
                    move = 2
                    break
                }
            }
        }
        k += 1
    }
    var result = SUCCESS
    if last == root && root != 0 {
        result = checkIdentifiers(root)
    } else {
        result = ARRAY_ERROR
    }
    if result == IDENTIFIER_NOT_FOUND && errorDescription != 0 {
        describe(errorDescription, ":: identifier '")
        const at_ = errorDescription + 15
        copyBytes(at_, @intFromPtr(&missingIdentifier), missingLength)
        describe(at_ + missingLength, "' not found")
    }
    if result != SUCCESS {
        freeTree(root)
        return result
    }
    putWord(definitions, root)
    return SUCCESS
}

// ---------------------------------------------------------------------------
// Structures: asn1_create_element.

// The definitions' node `name` under the root's name, or 0.
fn definitionOf(definitions: usize, name: usize, length: usize) -> usize {
    const r = at(definitions)
    const text = alloc(r.*.nameLength + length + 2)
    copyBytes(text, r.*.name, r.*.nameLength)
    put8(text + r.*.nameLength, 46)
    copyBytes(text + r.*.nameLength + 1, name, length)
    const found = findNode(definitions, text)
    free(text)
    return found
}

// Each IDENTIFIER under `node` replaced by a copy of the type it names
// (keeping its name, its flags of use and the tags it has).
fn expand(node: usize, definitions: usize) -> i32 {
    var child = at(node).*.down
    while child != 0 {
        var current = child
        while typeOf(current) == T_IDENTIFIER {
            const c = at(current)
            const target = definitionOf(definitions, c.*.value, c.*.valueLength)
            if target == 0 { return IDENTIFIER_NOT_FOUND }
            const replacement = copyTree(target)
            const r = at(replacement)
            if c.*.name != 0 {
                setName(replacement, c.*.name, c.*.nameLength)
            } else {
                setNameLiteral(replacement, "")
            }
            r.*.kind = r.*.kind | (c.*.kind & (F_SIZE | F_TAG | F_OPTION | F_DEFAULT | F_SET | F_NOT_USED))
            // The identifier's own children (its tags) before the type's.
            var own = c.*.down
            c.*.down = 0
            if own != 0 {
                var tail = own
                while at(tail).*.right != 0 { tail = at(tail).*.right }
                at(tail).*.right = r.*.down
                r.*.down = own
                var p = own
                while p != 0 {
                    at(p).*.up = replacement
                    p = at(p).*.right
                }
            }
            // In the identifier's place.
            r.*.up = c.*.up
            r.*.right = c.*.right
            const parent = c.*.up
            if at(parent).*.down == current {
                at(parent).*.down = replacement
            } else {
                var sibling = at(parent).*.down
                while at(sibling).*.right != current { sibling = at(sibling).*.right }
                at(sibling).*.right = replacement
            }
            c.*.right = 0
            c.*.up = 0
            freeTree(current)
            current = replacement
        }
        const result = expand(current, definitions)
        if result != SUCCESS { return result }
        child = at(current).*.right
    }
    return SUCCESS
}

// A tagged CHOICE gives its tags to each of its alternatives.
fn configureChoices(node: usize) -> void {
    if typeOf(node) == T_CHOICE && at(node).*.kind & F_TAG != 0 {
        var alternative = at(node).*.down
        while alternative != 0 {
            if typeOf(alternative) != T_TAG {
                at(alternative).*.kind = at(alternative).*.kind | F_TAG
                // The choice's tags, in their order, first.
                var tag = at(node).*.down
                var previous: usize = 0
                while tag != 0 && tag != alternative {
                    if typeOf(tag) == T_TAG {
                        const copied = newNode(at(tag).*.kind)
                        if at(tag).*.hasValue { setValue(copied, at(tag).*.value, at(tag).*.valueLength) }
                        at(copied).*.up = alternative
                        if previous == 0 {
                            at(copied).*.right = at(alternative).*.down
                            at(alternative).*.down = copied
                        } else {
                            at(copied).*.right = at(previous).*.right
                            at(previous).*.right = copied
                        }
                        previous = copied
                    }
                    tag = at(tag).*.right
                }
            }
            alternative = at(alternative).*.right
        }
        at(node).*.kind = at(node).*.kind & (F_TAG ^ 4294967295)
        var p = at(node).*.down
        while p != 0 {
            const next = at(p).*.right
            if typeOf(p) == T_TAG { deleteNode(p) }
            p = next
        }
    }
    var child = at(node).*.down
    while child != 0 {
        configureChoices(child)
        child = at(child).*.right
    }
}

export fn asn1_create_element(definitions: usize, source_name: usize, element_: usize) -> i32 {
    const source = findNode(definitions, source_name)
    if source == 0 { return ELEMENT_NOT_FOUND }
    const root = copyTree(source)
    setNameLiteral(root, "")
    // The root itself may name a type (PrivateKeyAlgorithmIdentifier).
    var result = SUCCESS
    var top = root
    while typeOf(top) == T_IDENTIFIER {
        const target = definitionOf(definitions, at(top).*.value, at(top).*.valueLength)
        if target == 0 {
            result = IDENTIFIER_NOT_FOUND
            break
        }
        const replacement = copyTree(target)
        setNameLiteral(replacement, "")
        at(replacement).*.kind = at(replacement).*.kind | (at(top).*.kind & (F_SIZE | F_TAG | F_OPTION | F_DEFAULT | F_SET | F_NOT_USED))
        var own = at(top).*.down
        at(top).*.down = 0
        if own != 0 {
            var tail = own
            while at(tail).*.right != 0 { tail = at(tail).*.right }
            at(tail).*.right = at(replacement).*.down
            at(replacement).*.down = own
            var p = own
            while p != 0 {
                at(p).*.up = replacement
                p = at(p).*.right
            }
        }
        freeTree(top)
        top = replacement
    }
    if result == SUCCESS { result = expand(top, definitions) }
    configureChoices(top)
    putWord(element_, top)
    return result
}

export fn asn1_delete_structure(structure: usize) -> i32 {
    const node = getWord(structure)
    if node == 0 { return ELEMENT_NOT_FOUND }
    deleteNode(node)
    putWord(structure, 0)
    return SUCCESS
}

// ---------------------------------------------------------------------------
// Integers and object identifiers.

// A decimal text as 8 big-endian bytes of two's complement.
fn decimalToBytes(text: usize, out: [*]u8) -> void {
    var negative = false
    var p = text
    if get8(p) == 45 {
        negative = true
        p += 1
    } else if get8(p) == 43 {
        p += 1
    }
    var value: u64 = 0
    while get8(p) >= 48 && get8(p) <= 57 {
        value = value *% 10 +% @intCast(u64, get8(p) - 48)
        p += 1
    }
    if negative { value = 0 -% value }
    var index: usize = 0
    while index < 8 {
        out[index] = @intCast(u8, (value >> @intCast(u64, 56 - 8 * index)) & 255)
        index += 1
    }
}

// Two's complement bytes without the redundant leading 00 or FF ones.
fn minimalStart(bytes: usize, length: usize) -> usize {
    if length == 0 { return 0 }
    const negative = get8(bytes) & 128 != 0
    var k: usize = 0
    while k + 1 < length {
        const byte = get8(bytes + k)
        if negative && byte != 255 { break }
        if !negative && byte != 0 { break }
        k += 1
    }
    if k > 0 {
        const top = get8(bytes + k) & 128 != 0
        if negative != top { k -= 1 }
    }
    return k
}

// An OBJECT IDENTIFIER's contents into `out`; false for text that is not
// one.
fn encodeOid(text: usize, length: usize, out: *Buffer) -> bool {
    var arcs: [64]u64 = undefined
    var count: usize = 0
    var p = text
    const end = text + length
    while p < end {
        var value: u64 = 0
        var digits: usize = 0
        while p < end && get8(p) >= 48 && get8(p) <= 57 {
            value = value *% 10 +% @intCast(u64, get8(p) - 48)
            digits += 1
            p += 1
        }
        if digits == 0 || count >= 64 { return false }
        arcs[count] = value
        count += 1
        if p < end {
            if get8(p) != 46 { return false }
            p += 1
            if p == end { return false }
        }
    }
    if count < 2 { return false }
    var index: usize = 1
    while index < count {
        var value = arcs[index]
        if index == 1 { value = arcs[0] * 40 + arcs[1] }
        var groups: [10]u8 = undefined
        var n: usize = 0
        while true {
            groups[n] = @intCast(u8, value & 127)
            n += 1
            value = value >> 7
            if value == 0 { break }
        }
        while n > 0 {
            n -= 1
            pushByte(out, if n > 0 { groups[n] | 128 } else { groups[n] })
        }
        index += 1
    }
    return true
}

fn pushDecimal(out: *Buffer, value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        pushByte(out, digits[count])
    }
}

// The contents of an OBJECT IDENTIFIER as dotted text; false when they
// are malformed.
fn decodeOid(bytes: usize, length: usize, out: *Buffer) -> bool {
    if length == 0 { return false }
    var p = bytes
    const end = bytes + length
    var first = true
    while p < end {
        if get8(p) == 128 { return false }
        var value: u64 = 0
        while true {
            if p >= end { return false }
            const byte = get8(p)
            p += 1
            if value > 144115188075855871 { return false }
            value = (value << 7) | @intCast(u64, byte & 127)
            if byte & 128 == 0 { break }
        }
        if first {
            if value < 40 {
                pushByte(out, 48)
                pushByte(out, 46)
                pushDecimal(out, value)
            } else if value < 80 {
                pushByte(out, 49)
                pushByte(out, 46)
                pushDecimal(out, value - 40)
            } else {
                pushByte(out, 50)
                pushByte(out, 46)
                pushDecimal(out, value - 80)
            }
            first = false
        } else {
            pushByte(out, 46)
            pushDecimal(out, value)
        }
    }
    return true
}

// ---------------------------------------------------------------------------
// Tags.

// A type's universal tag (0 for none: CHOICE, ANY).
fn universalTag(kind: u32) -> u8 {
    const t = kind & 255
    if t == T_BOOLEAN { return 1 }
    if t == T_INTEGER { return 2 }
    if t == T_BIT_STRING { return 3 }
    if t == T_OCTET_STRING { return 4 }
    if t == T_NULL { return 5 }
    if t == T_OBJECT_ID { return 6 }
    if t == T_ENUMERATED { return 10 }
    if t == T_UTF8_STRING { return 12 }
    if t == T_SEQUENCE || t == T_SEQUENCE_OF { return 48 }
    if t == T_SET || t == T_SET_OF { return 49 }
    if t == T_NUMERIC_STRING { return 18 }
    if t == T_PRINTABLE_STRING { return 19 }
    if t == T_TELETEX_STRING { return 20 }
    if t == T_IA5_STRING { return 22 }
    if t == T_UTC_TIME { return 23 }
    if t == T_GENERALIZED_TIME { return 24 }
    if t == T_VISIBLE_STRING { return 26 }
    if t == T_GENERALSTRING { return 27 }
    if t == T_UNIVERSAL_STRING { return 28 }
    if t == T_BMP_STRING { return 30 }
    return 0
}

fn isStructured(kind: u32) -> bool {
    const t = kind & 255
    return t == T_SEQUENCE || t == T_SEQUENCE_OF || t == T_SET || t == T_SET_OF
}

fn tagClass(tagNode: usize) -> u8 {
    const kind = at(tagNode).*.kind
    if kind & F_APPLICATION != 0 { return 64 }
    if kind & F_UNIVERSAL != 0 { return 0 }
    if kind & F_PRIVATE != 0 { return 192 }
    return 128
}

fn tagNumber(tagNode: usize) -> u64 {
    var value: u64 = 0
    const n = at(tagNode)
    var index: usize = 0
    while index < n.*.valueLength && get8(n.*.value + index) >= 48 && get8(n.*.value + index) <= 57 {
        value = value * 10 + @intCast(u64, get8(n.*.value + index) - 48)
        index += 1
    }
    return value
}

// An identifier octet (or several, for numbers of 31 and more).
const Tag = struct {
    class: u8
    number: u64
}

fn pushTag(out: *Buffer, tag: Tag) -> void {
    if tag.number < 31 {
        pushByte(out, tag.class | @intCast(u8, tag.number))
        return
    }
    pushByte(out, tag.class | 31)
    var groups: [10]u8 = undefined
    var n: usize = 0
    var value = tag.number
    while true {
        groups[n] = @intCast(u8, value & 127)
        n += 1
        value = value >> 7
        if value == 0 { break }
    }
    while n > 0 {
        n -= 1
        pushByte(out, if n > 0 { groups[n] | 128 } else { groups[n] })
    }
}

fn pushLength(out: *Buffer, length: usize) -> void {
    if length < 128 {
        pushByte(out, @intCast(u8, length))
        return
    }
    var bytes: usize = 0
    var rest = length
    while rest > 0 {
        bytes += 1
        rest = rest >> 8
    }
    pushByte(out, @intCast(u8, 128 | bytes))
    while bytes > 0 {
        bytes -= 1
        pushByte(out, @intCast(u8, (length >> @intCast(u64, 8 * bytes)) & 255))
    }
}

// The tags a node is written with, outermost first: the explicit ones
// (each constructed), then its own (an implicit tag, or the universal one;
// `hasInner` false for an untagged CHOICE or ANY). An implicit tag stands
// for the next explicit one when one follows it.
const Tags = struct {
    outer: [8]Tag
    count: usize
    inner: Tag
    hasInner: bool
}

fn tagsOf(node: usize, tags: *Tags) -> void {
    tags.*.count = 0
    var implicit = false
    var pending = Tag.{ .class = 0, .number = 0 }
    const kind = at(node).*.kind
    if kind & F_TAG != 0 {
        var p = at(node).*.down
        while p != 0 {
            if typeOf(p) == T_TAG {
                const class = tagClass(p)
                if at(p).*.kind & F_EXPLICIT != 0 {
                    if tags.*.count < 8 {
                        tags.*.outer[tags.*.count] = if implicit { pending } else { Tag.{ .class = class | 32, .number = tagNumber(p) } }
                        tags.*.count += 1
                    }
                    implicit = false
                } else if !implicit {
                    pending = Tag.{ .class = if isStructured(kind) { class | 32 } else { class }, .number = tagNumber(p) }
                    implicit = true
                }
            }
            p = at(p).*.right
        }
    }
    if implicit {
        tags.*.inner = pending
        tags.*.hasInner = true
        return
    }
    const universal = universalTag(kind)
    tags.*.hasInner = universal != 0
    tags.*.inner = Tag.{ .class = universal & 224, .number = @intCast(u64, universal & 31) }
}

// ---------------------------------------------------------------------------
// Encoding: asn1_der_coding.

var failedNode: usize = 0

// The node's encoding appended to `out`: a libtasn1 error code.
fn encode(node: usize, out: *Buffer) -> i32 {
    const n = at(node)
    const t = n.*.kind & 255
    var body: Buffer = undefined
    bufferInit(&body)
    var result = SUCCESS
    var skip = false
    if t == T_NULL {
        // No contents.
    } else if t == T_BOOLEAN {
        if !n.*.hasValue {
            if n.*.kind & F_DEFAULT != 0 { skip = true } else { result = VALUE_NOT_FOUND }
        } else {
            pushByte(&body, if get8(n.*.value) == 70 { 0 } else { 255 })
        }
    } else if t == T_INTEGER || t == T_ENUMERATED || t == T_OCTET_STRING || t == T_GENERALSTRING || t == T_NUMERIC_STRING || t == T_IA5_STRING || t == T_TELETEX_STRING || t == T_PRINTABLE_STRING || t == T_UNIVERSAL_STRING || t == T_BMP_STRING || t == T_UTF8_STRING || t == T_VISIBLE_STRING || t == T_UTC_TIME || t == T_GENERALIZED_TIME {
        if !n.*.hasValue {
            if n.*.kind & F_DEFAULT != 0 && (t == T_INTEGER || t == T_ENUMERATED) { skip = true } else { result = VALUE_NOT_FOUND }
        } else {
            pushBytes(&body, n.*.value, n.*.valueLength)
        }
    } else if t == T_OBJECT_ID {
        if !n.*.hasValue {
            if n.*.kind & F_DEFAULT != 0 { skip = true } else { result = VALUE_NOT_FOUND }
        } else if !encodeOid(n.*.value, n.*.valueLength, &body) {
            result = VALUE_NOT_VALID
        }
    } else if t == T_BIT_STRING {
        if !n.*.hasValue {
            result = VALUE_NOT_FOUND
        } else {
            const bytes = (n.*.bits + 7) / 8
            pushByte(&body, @intCast(u8, (bytes * 8 - n.*.bits) & 255))
            pushBytes(&body, n.*.value, bytes)
        }
    } else if t == T_SEQUENCE || t == T_CHOICE {
        var child = element(n.*.down)
        while child != 0 && result == SUCCESS {
            result = encode(child, &body)
            child = element(at(child).*.right)
        }
    } else if t == T_SET {
        result = encodeSorted(element(n.*.down), &body, true)
    } else if t == T_SEQUENCE_OF || t == T_SET_OF {
        // The template's copies, after it.
        const template = element(n.*.down)
        const first = if template != 0 { at(template).*.right } else { 0 }
        if t == T_SET_OF {
            result = encodeSorted(first, &body, false)
        } else {
            var child = first
            while child != 0 && result == SUCCESS {
                result = encode(child, &body)
                child = at(child).*.right
            }
        }
    } else if t == T_ANY {
        if !n.*.hasValue {
            result = VALUE_NOT_FOUND
        } else {
            pushBytes(&body, n.*.value, n.*.valueLength)
        }
    } else {
        result = GENERIC_ERROR
    }
    if result != SUCCESS || skip {
        if result == VALUE_NOT_FOUND && failedNode == 0 { failedNode = node }
        free(body.address)
        return result
    }
    var tags: Tags = undefined
    tagsOf(node, &tags)
    // Inside out: the node's own tag, then each explicit one around it.
    var inner: Buffer = undefined
    bufferInit(&inner)
    if tags.hasInner && t != T_CHOICE && t != T_ANY {
        pushTag(&inner, tags.inner)
        pushLength(&inner, body.length)
    } else if tags.hasInner && t == T_ANY {
        // An implicitly tagged ANY: its tag in place of the value's.
        pushTag(&inner, tags.inner)
        pushLength(&inner, body.length)
    }
    pushBytes(&inner, body.address, body.length)
    free(body.address)
    var index = tags.count
    while index > 0 {
        index -= 1
        var wrapped: Buffer = undefined
        bufferInit(&wrapped)
        pushTag(&wrapped, tags.outer[index])
        pushLength(&wrapped, inner.length)
        pushBytes(&wrapped, inner.address, inner.length)
        free(inner.address)
        inner = wrapped
    }
    pushBytes(out, inner.address, inner.length)
    free(inner.address)
    return SUCCESS
}

// The elements from `first` on, encoded and appended in DER's order: a
// SET's by their tags, a SET OF's by their encodings.
fn encodeSorted(first: usize, out: *Buffer, byTag: bool) -> i32 {
    var count: usize = 0
    var p = first
    while p != 0 {
        if !isHelper(p) { count += 1 }
        p = at(p).*.right
    }
    if count == 0 { return SUCCESS }
    const pieces = alloc(count * @sizeOf(Buffer))
    unsafe {
        const list = @ptrFromInt([*]Buffer, pieces)
        var index: usize = 0
        p = first
        var result = SUCCESS
        while p != 0 && result == SUCCESS {
            if !isHelper(p) {
                bufferInit(&list[index])
                result = encode(p, &list[index])
                index += 1
            }
            p = at(p).*.right
        }
        if result == SUCCESS {
            // Insertion sort: sets are small.
            var i: usize = 1
            while i < index {
                var j = i
                while j > 0 && before(&list[j], &list[j - 1], byTag) {
                    const saved = list[j]
                    list[j] = list[j - 1]
                    list[j - 1] = saved
                    j -= 1
                }
                i += 1
            }
            i = 0
            while i < index {
                pushBytes(out, list[i].address, list[i].length)
                i += 1
            }
        }
        var i: usize = 0
        while i < index {
            free(list[i].address)
            i += 1
        }
        free(pieces)
        return result
    }
}

fn before(a: *Buffer, b: *Buffer, byTag: bool) -> bool {
    const x = a.*.address
    const y = b.*.address
    if byTag {
        const xc = get8(x) & 192
        const yc = get8(y) & 192
        if xc != yc { return xc < yc }
        return (get8(x) & 31) < (get8(y) & 31)
    }
    var index: usize = 0
    while index < a.*.length && index < b.*.length {
        if get8(x + index) != get8(y + index) { return get8(x + index) < get8(y + index) }
        index += 1
    }
    return a.*.length < b.*.length
}

// The node's name from the root, for an error's description.
fn describeNode(errorDescription: usize, node: usize, prefix: []const u8, suffix: []const u8) -> void {
    if errorDescription == 0 { return }
    describe(errorDescription, prefix)
    var at_ = errorDescription + prefix.length
    const n = at(node)
    const length = if n.*.nameLength > 64 { 64 } else { n.*.nameLength }
    copyBytes(at_, n.*.name, length)
    at_ += length
    describe(at_, suffix)
}

export fn asn1_der_coding(element_: usize, name: usize, ider: usize, len: usize, ErrorDescription: usize) -> i32 {
    if ErrorDescription != 0 { put8(ErrorDescription, 0) }
    const node = findNode(element_, name)
    if node == 0 { return ELEMENT_NOT_FOUND }
    const room = getInt(len)
    if ider == 0 && room > 0 { return VALUE_NOT_VALID }
    var out: Buffer = undefined
    bufferInit(&out)
    failedNode = 0
    const result = encode(node, &out)
    if result != SUCCESS {
        if result == VALUE_NOT_FOUND && failedNode != 0 { describeNode(ErrorDescription, failedNode, ":: value of element '", "' not found") }
        free(out.address)
        return result
    }
    putInt(len, @intCast(i32, out.length))
    if ider == 0 || @intCast(i32, out.length) > room {
        free(out.address)
        return MEM_ERROR
    }
    copyBytes(ider, out.address, out.length)
    free(out.address)
    return SUCCESS
}

// ---------------------------------------------------------------------------
// Decoding: asn1_der_decoding2.

const Reader = struct {
    der: usize
    end: usize
    strict: bool
}

// The identifier and length at `position`: the tag into *tag, where the
// contents start and end. DER_ERROR when they do not fit.
fn readHeader(r: *Reader, position: usize, limit: usize, tag: *Tag, start: *usize, end: *usize) -> i32 {
    var p = position
    if p >= limit { return DER_ERROR }
    const first = get8(p)
    p += 1
    tag.*.class = first & 224
    if first & 31 == 31 {
        var number: u64 = 0
        while true {
            if p >= limit { return DER_ERROR }
            const byte = get8(p)
            p += 1
            number = (number << 7) | @intCast(u64, byte & 127)
            if byte & 128 == 0 { break }
        }
        tag.*.number = number
    } else {
        tag.*.number = @intCast(u64, first & 31)
    }
    if p >= limit { return DER_ERROR }
    const lengthByte = get8(p)
    p += 1
    var length: usize = 0
    if lengthByte < 128 {
        length = @intCast(usize, lengthByte)
    } else {
        const count = @intCast(usize, lengthByte & 127)
        if count == 0 || count > 4 { return DER_ERROR }
        var index: usize = 0
        while index < count {
            if p >= limit { return DER_ERROR }
            length = (length << 8) | @intCast(usize, get8(p))
            p += 1
            index += 1
        }
    }
    if length > limit - p { return DER_ERROR }
    start.* = p
    end.* = p + length
    return SUCCESS
}

// The first tag a node is written with (for a CHOICE, none: its
// alternatives are tried).
fn firstTag(node: usize, tag: *Tag) -> bool {
    var tags: Tags = undefined
    tagsOf(node, &tags)
    if tags.count > 0 {
        tag.* = tags.outer[0]
        return true
    }
    if !tags.hasInner { return false }
    tag.* = tags.inner
    return true
}

// Whether the element at `position` may be `node`.
fn matches(r: *Reader, node: usize, position: usize, limit: usize) -> bool {
    if position >= limit { return false }
    const t = typeOf(node)
    if t == T_CHOICE && at(node).*.kind & F_TAG == 0 {
        var alternative = element(at(node).*.down)
        while alternative != 0 {
            if matches(r, alternative, position, limit) { return true }
            alternative = element(at(alternative).*.right)
        }
        return false
    }
    var expected = Tag.{ .class = 0, .number = 0 }
    if !firstTag(node, &expected) { return true }
    var found = Tag.{ .class = 0, .number = 0 }
    var start: usize = 0
    var end: usize = 0
    if readHeader(r, position, limit, &found, &start, &end) != SUCCESS { return false }
    if found.number != expected.number { return false }
    if found.class == expected.class { return true }
    // A constructed OCTET STRING is BER's, not DER's.
    return !r.*.strict && t == T_OCTET_STRING && found.class == (expected.class | 32)
}

fn appendElement(node: usize) -> usize {
    const template = element(at(node).*.down)
    const copied = copyTree(template)
    var count: usize = 0
    var p = at(template).*.right
    while p != 0 {
        count += 1
        p = at(p).*.right
    }
    var name: Buffer = undefined
    bufferInit(&name)
    pushByte(&name, 63)
    pushDecimal(&name, @intCast(u64, count + 1))
    setName(copied, name.address, name.length)
    free(name.address)
    appendChild(node, copied)
    return copied
}

// Decodes `node` from the element at *position (which it must match),
// moving *position past it.
fn decodeNode(r: *Reader, node: usize, position: *usize, limit: usize) -> i32 {
    const n = at(node)
    const t = n.*.kind & 255
    if t == T_CHOICE {
        // The alternative found stays; the others go.
        var alternative = element(n.*.down)
        var chosen: usize = 0
        while alternative != 0 {
            if chosen == 0 && matches(r, alternative, position.*, limit) {
                chosen = alternative
            }
            alternative = element(at(alternative).*.right)
        }
        if chosen == 0 { return TAG_ERROR }
        var p = n.*.down
        while p != 0 {
            const next = at(p).*.right
            if p != chosen && !isHelper(p) { deleteNode(p) }
            p = next
        }
        return decodeNode(r, chosen, position, limit)
    }
    var tags: Tags = undefined
    tagsOf(node, &tags)
    var p = position.*
    var contentLimit = limit
    // Through the explicit tags.
    var index: usize = 0
    var found = Tag.{ .class = 0, .number = 0 }
    var start: usize = 0
    var end: usize = 0
    var explicitEnds: [8]usize = undefined
    while index < tags.count {
        const result = readHeader(r, p, contentLimit, &found, &start, &end)
        if result != SUCCESS { return result }
        if found.class != tags.outer[index].class || found.number != tags.outer[index].number { return TAG_ERROR }
        explicitEnds[index] = end
        p = start
        contentLimit = end
        index += 1
    }
    var result = SUCCESS
    if t == T_ANY && !tags.hasInner {
        // The whole element, whatever it is.
        result = readHeader(r, p, contentLimit, &found, &start, &end)
        if result != SUCCESS { return result }
        setValue(node, p, end - p)
        p = end
    } else {
        result = readHeader(r, p, contentLimit, &found, &start, &end)
        if result != SUCCESS { return result }
        if found.number != tags.inner.number { return TAG_ERROR }
        if found.class != tags.inner.class {
            if r.*.strict || t != T_OCTET_STRING || found.class != (tags.inner.class | 32) { return TAG_ERROR }
            // (A constructed OCTET STRING is not read here.)
            return DER_ERROR
        }
        result = decodeContents(r, node, start, end)
        if result != SUCCESS { return result }
        p = end
    }
    // Each explicit tag's contents end where the element does.
    index = tags.count
    while index > 0 {
        index -= 1
        if p != explicitEnds[index] { return DER_ERROR }
    }
    position.* = p
    return SUCCESS
}

fn decodeContents(r: *Reader, node: usize, start: usize, end: usize) -> i32 {
    const t = typeOf(node)
    const length = end - start
    if t == T_NULL {
        return if length == 0 { SUCCESS } else { DER_ERROR }
    }
    if t == T_BOOLEAN {
        if length != 1 { return DER_ERROR }
        setValue(node, @intFromPtr(if get8(start) == 0 { "F".pointer } else { "T".pointer }), 1)
        return SUCCESS
    }
    if t == T_INTEGER || t == T_ENUMERATED || t == T_OCTET_STRING || t == T_GENERALSTRING || t == T_NUMERIC_STRING || t == T_IA5_STRING || t == T_TELETEX_STRING || t == T_PRINTABLE_STRING || t == T_UNIVERSAL_STRING || t == T_BMP_STRING || t == T_UTF8_STRING || t == T_VISIBLE_STRING || t == T_UTC_TIME || t == T_GENERALIZED_TIME {
        setValue(node, start, length)
        return SUCCESS
    }
    if t == T_OBJECT_ID {
        var text: Buffer = undefined
        bufferInit(&text)
        const ok = decodeOid(start, length, &text)
        if ok { setValue(node, text.address, text.length) }
        free(text.address)
        return if ok { SUCCESS } else { DER_ERROR }
    }
    if t == T_BIT_STRING {
        if length == 0 { return DER_ERROR }
        const unused = @intCast(usize, get8(start))
        if unused > 7 || (length == 1 && unused != 0) { return DER_ERROR }
        setValue(node, start + 1, length - 1)
        at(node).*.bits = (length - 1) * 8 - unused
        return SUCCESS
    }
    if t == T_ANY {
        setValue(node, start, length)
        return SUCCESS
    }
    if t == T_SEQUENCE {
        var p = start
        var child = element(at(node).*.down)
        while child != 0 {
            const next = element(at(child).*.right)
            if matches(r, child, p, end) {
                const result = decodeNode(r, child, &p, end)
                if result != SUCCESS { return result }
            } else if at(child).*.kind & F_OPTION != 0 {
                deleteNode(child)
            } else if at(child).*.kind & F_DEFAULT != 0 {
                clearValue(child)
            } else {
                return if p >= end { DER_ERROR } else { TAG_ERROR }
            }
            child = next
        }
        return if p == end { SUCCESS } else { DER_ERROR }
    }
    if t == T_SET {
        // The members in any order; those not found, if optional, go.
        var p = start
        while p < end {
            var child = element(at(node).*.down)
            var taken = false
            while child != 0 {
                if at(child).*.kind & F_NOT_USED == 0 && matches(r, child, p, end) {
                    at(child).*.kind = at(child).*.kind | F_NOT_USED
                    const result = decodeNode(r, child, &p, end)
                    if result != SUCCESS { return result }
                    taken = true
                    break
                }
                child = element(at(child).*.right)
            }
            if !taken { return DER_ERROR }
        }
        var child = element(at(node).*.down)
        while child != 0 {
            const next = element(at(child).*.right)
            if at(child).*.kind & F_NOT_USED != 0 {
                at(child).*.kind = at(child).*.kind & (F_NOT_USED ^ 4294967295)
            } else if at(child).*.kind & F_OPTION != 0 {
                deleteNode(child)
            } else if at(child).*.kind & F_DEFAULT == 0 {
                return DER_ERROR
            }
            child = next
        }
        return SUCCESS
    }
    if t == T_SEQUENCE_OF || t == T_SET_OF {
        var p = start
        while p < end {
            const item = appendElement(node)
            if !matches(r, item, p, end) { return TAG_ERROR }
            const result = decodeNode(r, item, &p, end)
            if result != SUCCESS { return result }
        }
        return SUCCESS
    }
    return GENERIC_ERROR
}

// (asn1_der_decoding is this with no flags; an export cannot be called
// from Mlx, so both exports call this.)
pub fn decoding(element_: usize, ider: usize, max_ider_len: usize, flags: u32, errorDescription: usize) -> i32 {
    if errorDescription != 0 { put8(errorDescription, 0) }
    const node = getWord(element_)
    if node == 0 { return ELEMENT_NOT_FOUND }
    var result = SUCCESS
    if at(node).*.kind & F_OPTION != 0 {
        result = GENERIC_ERROR
    } else {
        const total = @intCast(usize, getInt(max_ider_len))
        var reader = Reader.{ .der = ider, .end = ider + total, .strict = flags & 2 != 0 }
        var position = ider
        if !matches(&reader, node, position, ider + total) {
            var tag = Tag.{ .class = 0, .number = 0 }
            var start: usize = 0
            var end: usize = 0
            result = if readHeader(&reader, position, ider + total, &tag, &start, &end) != SUCCESS { DER_ERROR } else { TAG_ERROR }
        } else {
            result = decodeNode(&reader, node, &position, ider + total)
        }
        if result == SUCCESS && position != ider + total && flags & 1 == 0 { result = DER_ERROR }
        if result == SUCCESS {
            putInt(max_ider_len, @intCast(i32, position - ider))
            return SUCCESS
        }
    }
    deleteNode(node)
    putWord(element_, 0)
    return result
}

export fn asn1_der_decoding(element_: usize, ider: usize, ider_len: i32, errorDescription: usize) -> i32 {
    var length = ider_len
    return decoding(element_, ider, @intFromPtr(&length), 0, errorDescription)
}

export fn asn1_der_decoding2(element_: usize, ider: usize, max_ider_len: usize, flags: u32, errorDescription: usize) -> i32 {
    return decoding(element_, ider, max_ider_len, flags, errorDescription)
}

// ---------------------------------------------------------------------------
// Reading and writing values.

// Puts `length` bytes into the caller's buffer of *len bytes: the length
// into *len, MEM_ERROR when they do not fit.
fn putValue(out: usize, len: usize, data: usize, length: usize) -> i32 {
    const room = getInt(len)
    putInt(len, @intCast(i32, length))
    if room < @intCast(i32, length) { return MEM_ERROR }
    if out != 0 && length > 0 { copyBytes(out, data, length) }
    return SUCCESS
}

// The same for text, its NUL counted.
fn putText(out: usize, len: usize, data: usize, length: usize) -> i32 {
    const room = getInt(len)
    putInt(len, @intCast(i32, length + 1))
    if room < @intCast(i32, length + 1) { return MEM_ERROR }
    if out != 0 {
        copyBytes(out, data, length)
        put8(out + length, 0)
    }
    return SUCCESS
}

// (asn1_read_value is this without the type.)
pub fn readValue(root: usize, name: usize, ivalue: usize, len: usize, etype: usize) -> i32 {
    const node = findNode(root, name)
    if node == 0 { return ELEMENT_NOT_FOUND }
    const n = at(node)
    const t = n.*.kind & 255
    if t != T_NULL && t != T_CHOICE && n.*.kind & F_DEFAULT == 0 && n.*.kind & F_ASSIGN == 0 && !n.*.hasValue { return VALUE_NOT_FOUND }
    if etype != 0 { put32(etype, t) }
    if t == T_NULL { return putText(ivalue, len, @intFromPtr("NULL".pointer), 4) }
    if t == T_BOOLEAN {
        const truth = n.*.hasValue && get8(n.*.value) == 84
        return if truth { putText(ivalue, len, @intFromPtr("TRUE".pointer), 4) } else { putText(ivalue, len, @intFromPtr("FALSE".pointer), 5) }
    }
    if t == T_INTEGER || t == T_ENUMERATED || t == T_OCTET_STRING || t == T_GENERALSTRING || t == T_NUMERIC_STRING || t == T_IA5_STRING || t == T_TELETEX_STRING || t == T_PRINTABLE_STRING || t == T_UNIVERSAL_STRING || t == T_BMP_STRING || t == T_UTF8_STRING || t == T_VISIBLE_STRING || t == T_ANY {
        if !n.*.hasValue { return VALUE_NOT_FOUND }
        return putValue(ivalue, len, n.*.value, n.*.valueLength)
    }
    if t == T_UTC_TIME || t == T_GENERALIZED_TIME { return putText(ivalue, len, n.*.value, n.*.valueLength) }
    if t == T_OBJECT_ID {
        if !n.*.hasValue { return VALUE_NOT_FOUND }
        return putText(ivalue, len, n.*.value, n.*.valueLength)
    }
    if t == T_BIT_STRING {
        // The length is in bits; the room in bytes.
        const bytes = (n.*.bits + 7) / 8
        const room = getInt(len)
        putInt(len, @intCast(i32, n.*.bits))
        if room < @intCast(i32, bytes) { return MEM_ERROR }
        if ivalue != 0 && bytes > 0 { copyBytes(ivalue, n.*.value, bytes) }
        return SUCCESS
    }
    if t == T_CHOICE {
        const chosen = n.*.down
        if chosen == 0 { return ELEMENT_NOT_FOUND }
        return putText(ivalue, len, at(chosen).*.name, at(chosen).*.nameLength)
    }
    return ELEMENT_NOT_FOUND
}

export fn asn1_read_value_type(root: usize, name: usize, ivalue: usize, len: usize, etype: usize) -> i32 { return readValue(root, name, ivalue, len, etype) }

export fn asn1_read_value(root: usize, name: usize, ivalue: usize, len: usize) -> i32 { return readValue(root, name, ivalue, len, 0) }

export fn asn1_write_value(node_root: usize, name: usize, ivalue: usize, len: i32) -> i32 {
    const node = findNode(node_root, name)
    if node == 0 { return ELEMENT_NOT_FOUND }
    const n = at(node)
    if n.*.kind & F_OPTION != 0 && ivalue == 0 && len == 0 {
        deleteNode(node)
        return SUCCESS
    }
    const t = n.*.kind & 255
    if (t == T_SEQUENCE_OF || t == T_SET_OF) && ivalue == 0 && len == 0 {
        const template = element(n.*.down)
        while template != 0 && at(template).*.right != 0 { deleteNode(at(template).*.right) }
        return SUCCESS
    }
    if ivalue == 0 { return VALUE_NOT_VALID }
    if t == T_BOOLEAN {
        const text = ivalue
        if sameLiteral(text, cLength(text), "TRUE") {
            setValue(node, @intFromPtr("T".pointer), 1)
        } else if sameLiteral(text, cLength(text), "FALSE") {
            setValue(node, @intFromPtr("F".pointer), 1)
        } else {
            return VALUE_NOT_VALID
        }
        return SUCCESS
    }
    if t == T_INTEGER || t == T_ENUMERATED {
        var eight: [8]u8 = undefined
        var bytes = ivalue
        var length: usize = 0
        if len == 0 {
            const first = get8(ivalue)
            if !((first >= 48 && first <= 57) || first == 45) { return VALUE_NOT_VALID }
            decimalToBytes(ivalue, &eight)
            bytes = @intFromPtr(&eight)
            length = 8
        } else {
            length = @intCast(usize, len)
        }
        if t == T_ENUMERATED && get8(bytes) & 128 != 0 { return VALUE_NOT_VALID }
        const k = minimalStart(bytes, length)
        setValue(node, bytes + k, length - k)
        return SUCCESS
    }
    if t == T_OBJECT_ID {
        const length = cLength(ivalue)
        var index: usize = 0
        while index < length {
            const byte = get8(ivalue + index)
            if !((byte >= 48 && byte <= 57) || byte == 46 || byte == 43) { return VALUE_NOT_VALID }
            index += 1
        }
        setValue(node, ivalue, length)
        return SUCCESS
    }
    if t == T_UTC_TIME || t == T_GENERALIZED_TIME {
        setValue(node, ivalue, cLength(ivalue))
        return SUCCESS
    }
    if t == T_OCTET_STRING || t == T_GENERALSTRING || t == T_NUMERIC_STRING || t == T_IA5_STRING || t == T_TELETEX_STRING || t == T_PRINTABLE_STRING || t == T_UNIVERSAL_STRING || t == T_BMP_STRING || t == T_UTF8_STRING || t == T_VISIBLE_STRING {
        const length = if len == 0 { cLength(ivalue) } else { @intCast(usize, len) }
        setValue(node, ivalue, length)
        return SUCCESS
    }
    if t == T_BIT_STRING {
        // The length in bits; the unused ones of the last byte cleared.
        const bits = if len == 0 { cLength(ivalue) } else { @intCast(usize, len) }
        const bytes = (bits + 7) / 8
        setValue(node, ivalue, bytes)
        n.*.bits = bits
        if bits % 8 != 0 {
            const keep = @intCast(u8, (@intCast(u32, 255) << @intCast(u32, 8 - bits % 8)) & 255)
            put8(n.*.value + bytes - 1, get8(n.*.value + bytes - 1) & keep)
        }
        return SUCCESS
    }
    if t == T_CHOICE {
        const length = cLength(ivalue)
        var chosen = n.*.down
        while chosen != 0 && !sameText(at(chosen).*.name, at(chosen).*.nameLength, ivalue, length) { chosen = at(chosen).*.right }
        if chosen == 0 { return ELEMENT_NOT_FOUND }
        var p = n.*.down
        while p != 0 {
            const next = at(p).*.right
            if p != chosen { deleteNode(p) }
            p = next
        }
        return SUCCESS
    }
    if t == T_ANY {
        setValue(node, ivalue, @intCast(usize, if len < 0 { 0 } else { len }))
        return SUCCESS
    }
    if t == T_SEQUENCE_OF || t == T_SET_OF {
        if !sameLiteral(ivalue, cLength(ivalue), "NEW") { return VALUE_NOT_VALID }
        const added = appendElement(node)
        return SUCCESS
    }
    return ELEMENT_NOT_FOUND
}

// ---------------------------------------------------------------------------
// Errors and the version.

fn errorName(error_: i32) -> []const u8 {
    return match error_ {
        0 => "SUCCESS\x00",
        1 => "FILE_NOT_FOUND\x00",
        2 => "ELEMENT_NOT_FOUND\x00",
        3 => "IDENTIFIER_NOT_FOUND\x00",
        4 => "DER_ERROR\x00",
        5 => "VALUE_NOT_FOUND\x00",
        6 => "GENERIC_ERROR\x00",
        7 => "VALUE_NOT_VALID\x00",
        8 => "TAG_ERROR\x00",
        9 => "TAG_IMPLICIT\x00",
        10 => "ERROR_TYPE_ANY\x00",
        11 => "SYNTAX_ERROR\x00",
        12 => "MEM_ERROR\x00",
        13 => "MEM_ALLOC_ERROR\x00",
        14 => "DER_OVERFLOW\x00",
        15 => "NAME_TOO_LONG\x00",
        16 => "ARRAY_ERROR\x00",
        17 => "ELEMENT_NOT_EMPTY\x00",
        18 => "TIME_ENCODING_ERROR\x00",
        19 => "RECURSION\x00",
        else => "",
    }
}

export fn asn1_strerror(error_: i32) -> usize {
    const name = errorName(error_)
    if name.length == 0 { return 0 }
    return @intFromPtr(name.pointer)
}

// asn1_perror writes to the standard error stream's descriptor itself: an
// extern C variable (stdio's `stderr`) is not something Mlx can name, and
// the line is short enough to go out in one write.
extern("c") fn write(descriptor: i32, bytes: usize, length: usize) -> isize

export fn asn1_perror(error_: i32) -> void {
    var line: [64]u8 = undefined
    var length: usize = 0
    const prefix = "LIBTASN1 ERROR: "
    var i: usize = 0
    while i < prefix.length {
        line[length] = prefix[i]
        length += 1
        i += 1
    }
    var name = errorName(error_)
    if name.length == 0 { name = "(null)\x00" }
    i = 0
    while i + 1 < name.length {
        line[length] = name[i]
        length += 1
        i += 1
    }
    line[length] = 10
    length += 1
    const written = write(2, @intFromPtr(&line[0]), length)
}

const VERSION = "4.19.0\x00"

fn versionNumber(text: usize) -> u64 {
    var parts: [3]u64 = [3]u64{ 0, 0, 0 }
    var part: usize = 0
    var p = text
    while get8(p) != 0 && part < 3 {
        const byte = get8(p)
        if byte == 46 {
            part += 1
        } else if byte >= 48 && byte <= 57 {
            parts[part] = parts[part] * 10 + @intCast(u64, byte - 48)
        } else {
            break
        }
        p += 1
    }
    return (parts[0] << 16) | (parts[1] << 8) | parts[2]
}

export fn asn1_check_version(req_version: usize) -> usize {
    const own = @intFromPtr(VERSION.pointer)
    if req_version == 0 { return own }
    return if versionNumber(req_version) > versionNumber(own) { 0 } else { own }
}
