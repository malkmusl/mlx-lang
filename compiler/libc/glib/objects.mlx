// GObject (gobject.h), the base class, as GLib's gobject.c makes it.
//
// A GObject: the class word, the reference count (8), the library's
// flags (12: floating, in construction, has a toggle reference) and in
// GLib's qdata word (16) a record of the library's own, made when first
// needed: data by quark (quark, data, destroy notify), weak references
// (notify, data), toggle references, the closures watching the object,
// the GWeakRefs pointing to it, the count of notification freezes and
// the properties whose notification waits.
//
// The GObject class: GLib's slots (construct_properties 8, constructor
// 16, set_property 24, get_property 32, dispose 40, finalize 48,
// dispatch_properties_changed 56, notify 64, constructed 72, flags 80,
// n_construct_properties 88, pspecs 96, n_pspecs 104). Properties are
// kept in a pool by name, each GParamSpec with its owner type; a class
// finds one on its type or the nearest ancestor that has it.
//
// The last reference: the GWeakRefs are cleared, dispose runs (GObject's
// own disconnects the handlers, invalidates the watching closures and
// calls the weak references), and when nothing took a reference
// meanwhile, finalize runs (GObject's own drops the data) and the
// instance is freed.
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const messages = @import("./messages.mlx")
const varargs = @import("./varargs.mlx")
const errors = @import("./errors.mlx")
const hash = @import("./hash.mlx")
const lists = @import("./lists.mlx")
const types = @import("./types.mlx")
const values = @import("./values.mlx")
const params = @import("./params.mlx")
const closures = @import("./closures.mlx")
const signals = @import("./signals.mlx")

extern("c") fn g_param_spec_get_default_value(pspec: usize) -> usize
extern("c") fn g_param_spec_override(name: usize, overridden: usize) -> usize
extern("c") fn g_param_value_is_valid(pspec: usize, value: usize) -> i32
extern("c") fn g_signal_connect_closure(instance: usize, detailed_signal: usize, closure: usize, after: i32) -> u64
extern("c") fn g_strdup_value_contents(value: usize) -> usize
extern("c") fn g_type_class_peek(t: usize) -> usize
extern("c") fn g_type_class_peek_parent(c: usize) -> usize
extern("c") fn g_type_class_ref(t: usize) -> usize
extern("c") fn g_type_class_unref(c: usize) -> void
extern("c") fn g_type_depth(t: usize) -> u32
extern("c") fn g_type_interfaces(t: usize, n: usize) -> usize
extern("c") fn g_value_type_transformable(a: usize, b: usize) -> i32
extern("c") fn snprintf(buffer: usize, size: usize, format: usize, a: usize) -> i32
extern("c") fn __mlx_glib_value_zero(value: usize) -> void
extern("c") fn __mlx_glib_value_peek(value: usize) -> usize

const O_REFS: usize = 8
const O_FLAGS: usize = 12
const O_EXTRA: usize = 16
const OBJECT_SIZE: usize = 24

const FLOATING: u32 = 1
const IN_CONSTRUCTION: u32 = 2
const HAS_TOGGLE: u32 = 4

const X_QDATA: usize = 0
const X_WEAK_REFS: usize = 24
const X_TOGGLES: usize = 48
const X_CLOSURES: usize = 72
const X_WEAK_LOCATIONS: usize = 96
const X_FREEZE: usize = 120
const X_QUEUE: usize = 128
const X_SIZE: usize = 152

const C_CONSTRUCT_PROPERTIES: usize = 8
const C_CONSTRUCTOR: usize = 16
const C_SET_PROPERTY: usize = 24
const C_GET_PROPERTY: usize = 32
const C_DISPOSE: usize = 40
const C_FINALIZE: usize = 48
const C_DISPATCH: usize = 56
const C_NOTIFY: usize = 64
const C_CONSTRUCTED: usize = 72
const C_FLAGS: usize = 80
const C_N_CONSTRUCT: usize = 88
const C_PSPECS: usize = 96
const C_N_PSPECS: usize = 104
const CLASS_SIZE: usize = 136

const READABLE: i32 = 1
const WRITABLE: i32 = 2
const CONSTRUCT: i32 = 4
const CONSTRUCT_ONLY: i32 = 8
const LAX_VALIDATION: i32 = 16
const EXPLICIT_NOTIFY: i32 = 1073741824

pub const ObjectFunc = fn(usize) -> void
pub const PropertyFunc = fn(usize, u32, usize, usize) -> void
pub const Constructor = fn(usize, u32, usize) -> usize
pub const Dispatch = fn(usize, u32, usize) -> void
pub const WeakNotify = fn(usize, usize) -> void
pub const ToggleNotify = fn(usize, usize, i32) -> void
pub const Notify = fn(usize) -> void
pub const Duplicate = fn(usize, usize) -> usize

var objectTable: [8]usize = undefined
var objectLock: usize = 0
var weakLock: u32 = 0
var pool: usize = 0
var notifySignal: u32 = 0
var unownedType: usize = 0
var unownedOnce: u64 = 0

fn wordsAt(address: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, address) } }
fn classOf(object: usize) -> usize { return m.getWord(object) }
fn typeOf(object: usize) -> usize { return m.getWord(m.getWord(object)) }
fn flags(object: usize) -> u32 { return @atomicLoad(u32, m.word32(object + O_FLAGS), acquire) }
fn setFlag(object: usize, flag: u32) -> void { _ = @atomicRmw(u32, m.word32(object + O_FLAGS), or, flag, acq_rel) }
fn clearFlag(object: usize, flag: u32) -> void { _ = @atomicRmw(u32, m.word32(object + O_FLAGS), and, 0xffffffff ^ flag, acq_rel) }

fn lock() -> void { threads.recursiveLock(objectLock) }
fn unlock() -> void { threads.recursiveUnlock(objectLock) }

// The record of the object (made under the lock).
fn extra(object: usize) -> usize {
    var x = m.getWord(object + O_EXTRA)
    if x == 0 {
        x = m.alloc(X_SIZE)
        m.putWord(object + O_EXTRA, x)
    }
    return x
}

fn warnText(t: *m.Text) -> void {
    messages.log(m.literal("GLib-GObject"), messages.LEVEL_WARNING, t.*.address)
    m.dispose(t)
}

fn criticalText(t: *m.Text) -> void {
    messages.log(m.literal("GLib-GObject"), messages.LEVEL_CRITICAL, t.*.address)
    m.dispose(t)
}

fn pushPointer(t: *m.Text, p: usize) -> void {
    const buffer = m.alloc(32)
    _ = snprintf(buffer, 32, m.literal("%p"), p)
    m.pushC(t, buffer)
    m.release(buffer)
}

fn isObject(object: usize) -> bool { return object != 0 && m.getWord(object) != 0 && types.fundamentalOf(typeOf(object)) == types.T_OBJECT }

fn assertObject(object: usize, function: []const u8) -> bool {
    if isObject(object) { return true }
    var t = m.text()
    m.pushText(&t, function)
    m.pushText(&t, ": assertion 'G_IS_OBJECT (object)' failed")
    criticalText(&t)
    return false
}

// ---------------------------------------------------------------------------
// The type

export fn __mlx_glib_object_value_free(value: usize) -> void { if m.getWord(value + 8) != 0 { unref(m.getWord(value + 8)) } }
export fn __mlx_glib_object_value_copy(src: usize, dest: usize) -> void { m.putWord(dest + 8, if m.getWord(src + 8) == 0 { 0 } else { ref(m.getWord(src + 8)) }) }

export fn __mlx_glib_object_value_collect(value: usize, n: u32, cvalues: usize, collectFlags: u32) -> usize {
    const object = m.getWord(cvalues)
    if object == 0 {
        m.putWord(value + 8, 0)
        return 0
    }
    if m.getWord(object) == 0 {
        var t = m.text()
        m.pushText(&t, "invalid unclassed object pointer for value type '")
        m.pushC(&t, types.describe(m.getWord(value)))
        m.pushText(&t, "'")
        return m.finish(&t)
    }
    if !values.compatible(typeOf(object), m.getWord(value)) {
        var t = m.text()
        m.pushText(&t, "invalid object type '")
        m.pushC(&t, types.describe(typeOf(object)))
        m.pushText(&t, "' for value type '")
        m.pushC(&t, types.describe(m.getWord(value)))
        m.pushText(&t, "'")
        return m.finish(&t)
    }
    m.putWord(value + 8, ref(object))
    return 0
}

export fn __mlx_glib_object_value_lcopy(value: usize, n: u32, cvalues: usize, collectFlags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 {
        var t = m.text()
        m.pushText(&t, "value location for '")
        m.pushC(&t, types.describe(m.getWord(value)))
        m.pushText(&t, "' passed as NULL")
        return m.finish(&t)
    }
    const object = m.getWord(value + 8)
    if object == 0 || (collectFlags & values.NOCOPY_CONTENTS) != 0 {
        m.putWord(p, object)
    } else {
        m.putWord(p, ref(object))
    }
    return 0
}

export fn __mlx_glib_object_base_init(class: usize) -> void {
    const parent = g_type_class_peek_parent(class)
    var copied: usize = 0
    if parent != 0 {
        var node = m.getWord(parent + C_CONSTRUCT_PROPERTIES)
        while node != 0 {
            copied = lists.slistAppend(copied, m.getWord(node))
            node = m.getWord(node + 8)
        }
    }
    m.putWord(class + C_CONSTRUCT_PROPERTIES, copied)
    m.putWord(class + C_N_CONSTRUCT, lists.listLength(copied))
    m.putWord(class + C_GET_PROPERTY, 0)
    m.putWord(class + C_SET_PROPERTY, 0)
    m.putWord(class + C_PSPECS, 0)
    m.putWord(class + C_N_PSPECS, 0)
}

export fn __mlx_glib_object_class_init(class: usize, data: usize) -> void {
    m.putWord(class + C_CONSTRUCTOR, @intFromPtr(__mlx_glib_object_constructor))
    m.putWord(class + C_CONSTRUCTED, @intFromPtr(__mlx_glib_object_constructed))
    m.putWord(class + C_SET_PROPERTY, @intFromPtr(__mlx_glib_object_do_set_property))
    m.putWord(class + C_GET_PROPERTY, @intFromPtr(__mlx_glib_object_do_get_property))
    m.putWord(class + C_DISPOSE, @intFromPtr(__mlx_glib_object_real_dispose))
    m.putWord(class + C_FINALIZE, @intFromPtr(__mlx_glib_object_finalize))
    m.putWord(class + C_DISPATCH, @intFromPtr(__mlx_glib_object_dispatch_properties_changed))
    m.putWord(class + C_NOTIFY, 0)
    const paramType = m.alloc(16)
    m.putWord(paramType, types.T_PARAM)
    notifySignal = signals.newSignal(m.literal("notify"), types.T_OBJECT, 1 | 8 | 16 | 64 | 32, closures.typeClosure(types.T_OBJECT, @intCast(u32, C_NOTIFY)), 0, 0, 0, types.T_NONE, 1, paramType)
    m.release(paramType)
}

export fn __mlx_glib_object_init(object: usize, class: usize) -> void {
    m.put32(object + O_REFS, 1)
    m.put32(object + O_FLAGS, IN_CONSTRUCTION)
    m.putWord(object + O_EXTRA, 0)
}

export fn __mlx_glib_objects_init() -> void {
    objectLock = m.alloc(16)
    pool = hash.newTable(0, 0, 0, 0)
    const table = @intFromPtr(&objectTable)
    m.putWord(table, @intFromPtr(__mlx_glib_value_zero))
    m.putWord(table + 8, @intFromPtr(__mlx_glib_object_value_free))
    m.putWord(table + 16, @intFromPtr(__mlx_glib_object_value_copy))
    m.putWord(table + 24, @intFromPtr(__mlx_glib_value_peek))
    m.putWord(table + 32, m.literal("p"))
    m.putWord(table + 40, @intFromPtr(__mlx_glib_object_value_collect))
    m.putWord(table + 48, m.literal("p"))
    m.putWord(table + 56, @intFromPtr(__mlx_glib_object_value_lcopy))
    const info = m.alloc(72)
    m.put16(info, @intCast(u16, CLASS_SIZE))
    m.putWord(info + 8, @intFromPtr(__mlx_glib_object_base_init))
    m.putWord(info + 24, @intFromPtr(__mlx_glib_object_class_init))
    m.put16(info + 48, @intCast(u16, OBJECT_SIZE))
    m.putWord(info + 56, @intFromPtr(__mlx_glib_object_init))
    m.putWord(info + 64, table)
    const finfo = m.alloc(8)
    m.put32(finfo, types.CLASSED | types.INSTANTIATABLE | types.DERIVABLE | types.DEEP_DERIVABLE)
    _ = types.registerFundamental(types.T_OBJECT, m.literal("GObject"), info, finfo, 0)
    m.release(info)
    m.release(finfo)
}

export fn g_object_get_type() -> usize {
    types.ensureInit()
    return types.T_OBJECT
}

export fn __mlx_glib_unowned_init(object: usize, class: usize) -> void { setFlag(object, FLOATING) }

export fn g_initially_unowned_get_type() -> usize {
    types.ensureInit()
    if threads.onceEnter(@intFromPtr(&unownedOnce)) {
        const info = m.alloc(72)
        m.put16(info, @intCast(u16, CLASS_SIZE))
        m.put16(info + 48, @intCast(u16, OBJECT_SIZE))
        m.putWord(info + 56, @intFromPtr(__mlx_glib_unowned_init))
        unownedType = types.registerStatic(types.T_OBJECT, m.literal("GInitiallyUnowned"), info, 0)
        m.release(info)
        threads.onceLeave(@intFromPtr(&unownedOnce), 1)
    }
    return unownedType
}

// ---------------------------------------------------------------------------
// References

fn toggleNotify(object: usize, isLast: bool) -> void {
    lock()
    const x = m.getWord(object + O_EXTRA)
    var notify: usize = 0
    var data: usize = 0
    if x != 0 && wordsAt(x + X_TOGGLES).*.length == 2 {
        notify = m.wordAt(wordsAt(x + X_TOGGLES), 0)
        data = m.wordAt(wordsAt(x + X_TOGGLES), 1)
    }
    unlock()
    if notify != 0 {
        const call: ToggleNotify = unsafe { @ptrFromInt(ToggleNotify, notify) }
        call(data, object, if isLast { 1 } else { 0 })
    }
}

pub fn ref(object: usize) -> usize {
    const old = @atomicRmw(u32, m.word32(object + O_REFS), add, 1, acq_rel)
    if old == 0 {
        values.gobjectCritical("g_object_ref: assertion 'old_val > 0' failed")
    } else if old == 1 && (flags(object) & HAS_TOGGLE) != 0 {
        toggleNotify(object, false)
    }
    return object
}

fn clearWeakLocations(object: usize) -> void {
    const x = m.getWord(object + O_EXTRA)
    if x == 0 { return }
    const locations = wordsAt(x + X_WEAK_LOCATIONS)
    var k: usize = 0
    while k < locations.*.length {
        m.putWord(m.wordAt(locations, k), 0)
        k += 1
    }
    m.disposeWords(locations)
}

pub fn unref(object: usize) -> void {
    while true {
        const old = @atomicLoad(u32, m.word32(object + O_REFS), acquire)
        if old == 0 {
            values.gobjectCritical("g_object_unref: assertion 'old_ref > 0' failed")
            return
        }
        if old > 1 {
            const swapped = @cmpxchgStrong(u32, m.word32(object + O_REFS), old, old - 1, acq_rel, acquire)
            if swapped.0 {
                if old == 2 && (flags(object) & HAS_TOGGLE) != 0 { toggleNotify(object, true) }
                return
            }
            continue
        }
        // The last reference: no GWeakRef may hand the object out again.
        threads.lock(@intFromPtr(&weakLock))
        if @atomicLoad(u32, m.word32(object + O_REFS), acquire) != 1 {
            threads.unlock(@intFromPtr(&weakLock))
            continue
        }
        clearWeakLocations(object)
        threads.unlock(@intFromPtr(&weakLock))
        break
    }
    const class = classOf(object)
    const dispose = m.getWord(class + C_DISPOSE)
    if dispose != 0 {
        const call: ObjectFunc = unsafe { @ptrFromInt(ObjectFunc, dispose) }
        call(object)
    }
    // A reference taken meanwhile keeps it.
    while true {
        const old = @atomicLoad(u32, m.word32(object + O_REFS), acquire)
        if old <= 1 { break }
        const swapped = @cmpxchgStrong(u32, m.word32(object + O_REFS), old, old - 1, acq_rel, acquire)
        if swapped.0 {
            if old == 2 && (flags(object) & HAS_TOGGLE) != 0 { toggleNotify(object, true) }
            return
        }
    }
    invalidateClosures(object)
    signals.destroyHandlers(object)
    callWeakRefs(object)
    if @atomicRmw(u32, m.word32(object + O_REFS), sub, 1, acq_rel) != 1 { return }
    const finalize = m.getWord(classOf(object) + C_FINALIZE)
    if finalize != 0 {
        const call: ObjectFunc = unsafe { @ptrFromInt(ObjectFunc, finalize) }
        call(object)
    }
    types.freeInstance(object)
}

export fn g_object_ref(object: usize) -> usize {
    if !assertObject(object, "g_object_ref") { return 0 }
    return ref(object)
}

export fn g_object_unref(object: usize) -> void {
    if !assertObject(object, "g_object_unref") { return }
    unref(object)
}

export fn g_object_is_floating(object: usize) -> i32 { return if (flags(object) & FLOATING) != 0 { 1 } else { 0 } }

export fn g_object_ref_sink(object: usize) -> usize {
    if !assertObject(object, "g_object_ref_sink") { return 0 }
    const old = @atomicRmw(u32, m.word32(object + O_FLAGS), and, 0xffffffff ^ FLOATING, acq_rel)
    if (old & FLOATING) == 0 { _ = ref(object) }
    return object
}

export fn g_object_take_ref(object: usize) -> usize {
    clearFlag(object, FLOATING)
    return object
}

export fn g_object_force_floating(object: usize) -> void { setFlag(object, FLOATING) }

export fn g_object_run_dispose(object: usize) -> void {
    _ = ref(object)
    const dispose = m.getWord(classOf(object) + C_DISPOSE)
    if dispose != 0 {
        const call: ObjectFunc = unsafe { @ptrFromInt(ObjectFunc, dispose) }
        call(object)
    }
    unref(object)
}

export fn g_object_compat_control(what: usize, data: usize) -> usize { return 0 }

// GObject's own dispose and finalize.
export fn __mlx_glib_object_real_dispose(object: usize) -> void {
    signals.destroyHandlers(object)
    invalidateClosures(object)
    callWeakRefs(object)
    threads.lock(@intFromPtr(&weakLock))
    clearWeakLocations(object)
    threads.unlock(@intFromPtr(&weakLock))
}

export fn __mlx_glib_object_finalize(object: usize) -> void {
    clearData(object)
    lock()
    const x = m.getWord(object + O_EXTRA)
    if x != 0 {
        m.disposeWords(wordsAt(x + X_WEAK_REFS))
        m.disposeWords(wordsAt(x + X_TOGGLES))
        m.disposeWords(wordsAt(x + X_CLOSURES))
        m.disposeWords(wordsAt(x + X_WEAK_LOCATIONS))
        m.disposeWords(wordsAt(x + X_QUEUE))
        m.release(x)
        m.putWord(object + O_EXTRA, 0)
    }
    unlock()
}

export fn __mlx_glib_object_constructed(object: usize) -> void {}

// ---------------------------------------------------------------------------
// Weak references, weak pointers, toggle references

export fn g_object_weak_ref(object: usize, notify: usize, data: usize) -> void {
    if !assertObject(object, "g_object_weak_ref") { return }
    lock()
    const list = wordsAt(extra(object) + X_WEAK_REFS)
    m.pushWord(list, notify)
    m.pushWord(list, data)
    unlock()
}

fn removePair(list: *m.Words, a: usize, b: usize) -> bool {
    var k: usize = 0
    while k + 1 < list.*.length {
        if m.wordAt(list, k) == a && m.wordAt(list, k + 1) == b {
            var i = k
            while i + 2 < list.*.length {
                m.putWord(list.*.address + i * 8, m.wordAt(list, i + 2))
                i += 1
            }
            list.*.length -= 2
            return true
        }
        k += 2
    }
    return false
}

export fn g_object_weak_unref(object: usize, notify: usize, data: usize) -> void {
    if !assertObject(object, "g_object_weak_unref") { return }
    lock()
    const found = removePair(wordsAt(extra(object) + X_WEAK_REFS), notify, data)
    unlock()
    if !found {
        var t = m.text()
        m.pushText(&t, "g_object_weak_unref: couldn't find weak ref ")
        pushPointer(&t, notify)
        m.pushText(&t, "(")
        pushPointer(&t, data)
        m.pushText(&t, ")")
        warnText(&t)
    }
}

// Calls the weak references (in the order they were added), each taken
// off first.
fn callWeakRefs(object: usize) -> void {
    while true {
        lock()
        const x = m.getWord(object + O_EXTRA)
        if x == 0 || wordsAt(x + X_WEAK_REFS).*.length == 0 {
            unlock()
            return
        }
        const list = wordsAt(x + X_WEAK_REFS)
        const notify = m.wordAt(list, 0)
        const data = m.wordAt(list, 1)
        var i: usize = 0
        while i + 2 < list.*.length {
            m.putWord(list.*.address + i * 8, m.wordAt(list, i + 2))
            i += 1
        }
        list.*.length -= 2
        unlock()
        const call: WeakNotify = unsafe { @ptrFromInt(WeakNotify, notify) }
        call(data, object)
    }
}

export fn __mlx_glib_nullify_pointer(location: usize, object: usize) -> void { m.putWord(location, 0) }

export fn g_object_add_weak_pointer(object: usize, weak_pointer_location: usize) -> void {
    if !assertObject(object, "g_object_add_weak_pointer") { return }
    g_object_weak_ref(object, @intFromPtr(__mlx_glib_nullify_pointer), weak_pointer_location)
}

export fn g_object_remove_weak_pointer(object: usize, weak_pointer_location: usize) -> void {
    if !assertObject(object, "g_object_remove_weak_pointer") { return }
    g_object_weak_unref(object, @intFromPtr(__mlx_glib_nullify_pointer), weak_pointer_location)
}

export fn g_object_add_toggle_ref(object: usize, notify: usize, data: usize) -> void {
    if !assertObject(object, "g_object_add_toggle_ref") { return }
    _ = ref(object)
    lock()
    const list = wordsAt(extra(object) + X_TOGGLES)
    m.pushWord(list, notify)
    m.pushWord(list, data)
    if list.*.length == 2 { setFlag(object, HAS_TOGGLE) } else { clearFlag(object, HAS_TOGGLE) }
    unlock()
}

export fn g_object_remove_toggle_ref(object: usize, notify: usize, data: usize) -> void {
    if !assertObject(object, "g_object_remove_toggle_ref") { return }
    lock()
    const list = wordsAt(extra(object) + X_TOGGLES)
    const found = removePair(list, notify, data)
    if list.*.length == 2 { setFlag(object, HAS_TOGGLE) } else { clearFlag(object, HAS_TOGGLE) }
    unlock()
    if found {
        unref(object)
    } else {
        var t = m.text()
        m.pushText(&t, "g_object_remove_toggle_ref: couldn't find toggle ref ")
        pushPointer(&t, notify)
        m.pushText(&t, "(")
        pushPointer(&t, data)
        m.pushText(&t, ")")
        warnText(&t)
    }
}

// GWeakRef: its word is the object (or NULL); the object keeps the
// addresses of the GWeakRefs pointing to it.
fn weakRefSet(weak: usize, object: usize) -> void {
    threads.lock(@intFromPtr(&weakLock))
    const old = m.getWord(weak)
    if old != object {
        if old != 0 {
            lock()
            const x = m.getWord(old + O_EXTRA)
            if x != 0 {
                const list = wordsAt(x + X_WEAK_LOCATIONS)
                var k: usize = 0
                while k < list.*.length {
                    if m.wordAt(list, k) == weak {
                        m.putWord(list.*.address + k * 8, m.wordAt(list, list.*.length - 1))
                        list.*.length -= 1
                        break
                    }
                    k += 1
                }
            }
            unlock()
        }
        m.putWord(weak, object)
        if object != 0 {
            lock()
            m.pushWord(wordsAt(extra(object) + X_WEAK_LOCATIONS), weak)
            unlock()
        }
    }
    threads.unlock(@intFromPtr(&weakLock))
}

export fn g_weak_ref_init(weak_ref: usize, object: usize) -> void {
    m.putWord(weak_ref, 0)
    if object != 0 { weakRefSet(weak_ref, object) }
}

export fn g_weak_ref_clear(weak_ref: usize) -> void { weakRefSet(weak_ref, 0) }
export fn g_weak_ref_set(weak_ref: usize, object: usize) -> void { weakRefSet(weak_ref, object) }

export fn g_weak_ref_get(weak_ref: usize) -> usize {
    threads.lock(@intFromPtr(&weakLock))
    var object = m.getWord(weak_ref)
    if object != 0 {
        if @atomicLoad(u32, m.word32(object + O_REFS), acquire) == 0 {
            object = 0
        } else {
            _ = ref(object)
        }
    }
    threads.unlock(@intFromPtr(&weakLock))
    return object
}

// ---------------------------------------------------------------------------
// Data by quark

fn dataFind(list: *m.Words, quark: u32) -> isize {
    var k: usize = 0
    while k < list.*.length {
        if m.wordAt(list, k) == @intCast(usize, quark) { return @intCast(isize, k) }
        k += 3
    }
    return -1
}

fn getQdata(object: usize, quark: u32) -> usize {
    if quark == 0 { return 0 }
    lock()
    const x = m.getWord(object + O_EXTRA)
    var data: usize = 0
    if x != 0 {
        const list = wordsAt(x + X_QDATA)
        const at = dataFind(list, quark)
        if at >= 0 { data = m.wordAt(list, @intCast(usize, at) + 1) }
    }
    unlock()
    return data
}

fn setQdata(object: usize, quark: u32, data: usize, destroy: usize) -> void {
    if quark == 0 { return }
    lock()
    const list = wordsAt(extra(object) + X_QDATA)
    const at = dataFind(list, quark)
    var oldData: usize = 0
    var oldDestroy: usize = 0
    if at >= 0 {
        const slot = list.*.address + @intCast(usize, at) * 8
        oldData = m.getWord(slot + 8)
        oldDestroy = m.getWord(slot + 16)
        if data == 0 {
            var i = @intCast(usize, at)
            while i + 3 < list.*.length {
                m.putWord(list.*.address + i * 8, m.wordAt(list, i + 3))
                i += 1
            }
            list.*.length -= 3
        } else {
            m.putWord(slot + 8, data)
            m.putWord(slot + 16, destroy)
        }
    } else if data != 0 {
        m.pushWord(list, @intCast(usize, quark))
        m.pushWord(list, data)
        m.pushWord(list, destroy)
    }
    unlock()
    if oldDestroy != 0 {
        const call: Notify = unsafe { @ptrFromInt(Notify, oldDestroy) }
        call(oldData)
    }
}

fn stealQdata(object: usize, quark: u32) -> usize {
    if quark == 0 { return 0 }
    lock()
    const x = m.getWord(object + O_EXTRA)
    var data: usize = 0
    if x != 0 {
        const list = wordsAt(x + X_QDATA)
        const at = dataFind(list, quark)
        if at >= 0 {
            data = m.wordAt(list, @intCast(usize, at) + 1)
            var i = @intCast(usize, at)
            while i + 3 < list.*.length {
                m.putWord(list.*.address + i * 8, m.wordAt(list, i + 3))
                i += 1
            }
            list.*.length -= 3
        }
    }
    unlock()
    return data
}

fn clearData(object: usize) -> void {
    while true {
        lock()
        const x = m.getWord(object + O_EXTRA)
        if x == 0 || wordsAt(x + X_QDATA).*.length == 0 {
            unlock()
            return
        }
        const list = wordsAt(x + X_QDATA)
        const data = m.wordAt(list, 1)
        const destroy = m.wordAt(list, 2)
        var i: usize = 0
        while i + 3 < list.*.length {
            m.putWord(list.*.address + i * 8, m.wordAt(list, i + 3))
            i += 1
        }
        list.*.length -= 3
        unlock()
        if destroy != 0 {
            const call: Notify = unsafe { @ptrFromInt(Notify, destroy) }
            call(data)
        }
    }
}

export fn g_object_get_qdata(object: usize, quark: u32) -> usize { return getQdata(object, quark) }
export fn g_object_set_qdata(object: usize, quark: u32, data: usize) -> void { setQdata(object, quark, data, 0) }
export fn g_object_set_qdata_full(object: usize, quark: u32, data: usize, destroy: usize) -> void { setQdata(object, quark, data, destroy) }
export fn g_object_steal_qdata(object: usize, quark: u32) -> usize { return stealQdata(object, quark) }
export fn g_object_get_data(object: usize, key: usize) -> usize { return getQdata(object, errors.quarkOf(key, false, false)) }
export fn g_object_set_data(object: usize, key: usize, data: usize) -> void { setQdata(object, errors.quarkOf(key, true, true), data, 0) }
export fn g_object_set_data_full(object: usize, key: usize, data: usize, destroy: usize) -> void { setQdata(object, errors.quarkOf(key, true, true), data, destroy) }
export fn g_object_steal_data(object: usize, key: usize) -> usize { return stealQdata(object, errors.quarkOf(key, false, false)) }

export fn g_object_dup_data(object: usize, key: usize, dup_func: usize, user_data: usize) -> usize {
    const data = getQdata(object, errors.quarkOf(key, false, false))
    if dup_func == 0 { return data }
    const call: Duplicate = unsafe { @ptrFromInt(Duplicate, dup_func) }
    return call(data, user_data)
}

// ---------------------------------------------------------------------------
// Closures watching objects

export fn __mlx_glib_object_closure_invalid(object: usize, closure: usize) -> void {
    lock()
    const x = m.getWord(object + O_EXTRA)
    if x != 0 {
        const list = wordsAt(x + X_CLOSURES)
        var k: usize = 0
        while k < list.*.length {
            if m.wordAt(list, k) == closure {
                m.putWord(list.*.address + k * 8, m.wordAt(list, list.*.length - 1))
                list.*.length -= 1
                break
            }
            k += 1
        }
    }
    unlock()
}

pub fn watchClosure(object: usize, closure: usize) -> void {
    lock()
    m.pushWord(wordsAt(extra(object) + X_CLOSURES), closure)
    unlock()
    closures.addInvalidateNotifier(closure, object, @intFromPtr(__mlx_glib_object_closure_invalid))
}

fn invalidateClosures(object: usize) -> void {
    while true {
        lock()
        const x = m.getWord(object + O_EXTRA)
        if x == 0 || wordsAt(x + X_CLOSURES).*.length == 0 {
            unlock()
            return
        }
        const list = wordsAt(x + X_CLOSURES)
        const closure = m.wordAt(list, list.*.length - 1)
        list.*.length -= 1
        unlock()
        closures.removeInvalidateNotifier(closure, object, @intFromPtr(__mlx_glib_object_closure_invalid))
        closures.invalidate(closure)
    }
}

export fn g_object_watch_closure(object: usize, closure: usize) -> void { watchClosure(object, closure) }

export fn g_cclosure_new_object(callback_func: usize, object: usize) -> usize {
    const closure = closures.newC(callback_func, object, 0, false)
    watchClosure(object, closure)
    return closure
}

export fn g_cclosure_new_object_swap(callback_func: usize, object: usize) -> usize {
    const closure = closures.newC(callback_func, object, 0, true)
    watchClosure(object, closure)
    return closure
}

export fn g_closure_new_object(sizeof_closure: u32, object: usize) -> usize {
    const closure = closures.newSimple(sizeof_closure, object)
    watchClosure(object, closure)
    return closure
}

export fn g_signal_connect_object(instance: usize, detailed_signal: usize, c_handler: usize, gobject: usize, connect_flags: u32) -> u64 {
    if gobject == 0 { return signals.connectData(instance, detailed_signal, c_handler, 0, 0, connect_flags) }
    const closure = if (connect_flags & 2) != 0 { g_cclosure_new_object_swap(c_handler, gobject) } else { g_cclosure_new_object(c_handler, gobject) }
    return g_signal_connect_closure(instance, detailed_signal, closure, if (connect_flags & 1) != 0 { 1 } else { 0 })
}

// ---------------------------------------------------------------------------
// The property pool: names to the GParamSpecs of that name.

fn poolInsert(pspec: usize) -> void {
    lock()
    const name = params.nameOf(pspec)
    var list = hash.lookup(pool, name)
    if list == 0 {
        list = m.alloc(24)
        _ = hash.insert(pool, name, list, true)
    }
    m.pushWord(wordsAt(list), pspec)
    unlock()
}

// The pspec of the name (canonical) owned by `owner` or, `walk`, its
// nearest ancestor.
fn poolLookup(name_: usize, owner: usize, walk: bool) -> usize {
    if name_ == 0 { return 0 }
    const name = params.canonicalName(name_)
    lock()
    const list = hash.lookup(pool, name)
    var found: usize = 0
    if list != 0 {
        var t = owner
        while t != 0 && found == 0 {
            const pspecs = wordsAt(list)
            var k: usize = 0
            while k < pspecs.*.length {
                const p = m.wordAt(pspecs, k)
                if m.getWord(p + 32) == t {
                    found = p
                    break
                }
                k += 1
            }
            if !walk { break }
            t = types.parentOf(t)
        }
    }
    unlock()
    return found
}

fn findPspec(class: usize, name: usize) -> usize { return poolLookup(name, m.getWord(class), true) }

fn installInternal(owner: usize, id: u32, pspec: usize) -> bool {
    _ = params.refSink(pspec)
    if poolLookup(params.nameOf(pspec), owner, false) != 0 {
        var t = m.text()
        m.pushText(&t, "When installing property: type '")
        m.pushC(&t, types.describe(owner))
        m.pushText(&t, "' already has a property named '")
        m.pushC(&t, params.nameOf(pspec))
        m.pushText(&t, "'")
        criticalText(&t)
        params.unref(pspec)
        return false
    }
    m.put32(pspec + 68, id)
    m.putWord(pspec + 32, owner)
    poolInsert(pspec)
    return true
}

fn installProperty(class: usize, id: u32, pspec: usize) -> void {
    const f = params.flagsOf(pspec)
    if id == 0 {
        values.gobjectCritical("g_object_class_install_property: assertion 'property_id > 0' failed")
        return
    }
    if (f & (READABLE | WRITABLE)) == 0 {
        values.gobjectCritical("validate_pspec_to_install: assertion 'pspec->flags & (G_PARAM_READABLE | G_PARAM_WRITABLE)' failed")
        return
    }
    if (f & (CONSTRUCT | CONSTRUCT_ONLY)) != 0 && (f & WRITABLE) == 0 {
        values.gobjectCritical("validate_pspec_to_install: assertion 'pspec->flags & G_PARAM_WRITABLE' failed")
        return
    }
    if (f & WRITABLE) != 0 && m.getWord(class + C_SET_PROPERTY) == 0 {
        values.gobjectCritical("validate_and_install_class_property: assertion 'class->set_property != NULL' failed")
        return
    }
    if (f & READABLE) != 0 && m.getWord(class + C_GET_PROPERTY) == 0 {
        values.gobjectCritical("validate_and_install_class_property: assertion 'class->get_property != NULL' failed")
        return
    }
    const owner = m.getWord(class)
    if !installInternal(owner, id, pspec) { return }
    if (f & (CONSTRUCT | CONSTRUCT_ONLY)) != 0 {
        m.putWord(class + C_CONSTRUCT_PROPERTIES, lists.slistAppend(m.getWord(class + C_CONSTRUCT_PROPERTIES), pspec))
        m.putWord(class + C_N_CONSTRUCT, m.getWord(class + C_N_CONSTRUCT) + 1)
    }
    // An override of an inherited construct property replaces it.
    const inherited = poolLookup(params.nameOf(pspec), types.parentOf(owner), true)
    if inherited != 0 && (params.flagsOf(inherited) & (CONSTRUCT | CONSTRUCT_ONLY)) != 0 {
        const before = m.getWord(class + C_CONSTRUCT_PROPERTIES)
        const after = lists.slistRemove(before, inherited)
        if lists.listLength(after) != m.getWord(class + C_N_CONSTRUCT) {
            m.putWord(class + C_N_CONSTRUCT, m.getWord(class + C_N_CONSTRUCT) - 1)
        }
        m.putWord(class + C_CONSTRUCT_PROPERTIES, after)
    }
}

export fn g_object_class_install_property(oclass: usize, property_id: u32, pspec: usize) -> void { installProperty(oclass, property_id, pspec) }

export fn g_object_class_install_properties(oclass: usize, n_pspecs: u32, pspecs: usize) -> void {
    var i: u32 = 1
    while i < n_pspecs {
        const pspec = m.getWord(pspecs + @intCast(usize, i) * 8)
        if pspec != 0 { installProperty(oclass, i, pspec) }
        i += 1
    }
}

export fn g_object_class_find_property(oclass: usize, property_name: usize) -> usize {
    const pspec = findPspec(oclass, property_name)
    if pspec != 0 && params.redirectTarget(pspec) != 0 { return params.redirectTarget(pspec) }
    return pspec
}

export fn g_object_class_override_property(oclass: usize, property_id: u32, name: usize) -> void {
    const t = m.getWord(oclass)
    var overridden: usize = 0
    const parent = types.parentOf(t)
    if parent != 0 { overridden = poolLookup(name, parent, true) }
    if overridden == 0 {
        // An interface of the class.
        const count = m.alloc(8)
        const ifaces = g_type_interfaces(t, count)
        var i: usize = 0
        while i < @intCast(usize, m.get32(count)) && overridden == 0 {
            overridden = poolLookup(name, m.getWord(ifaces + i * 8), false)
            i += 1
        }
        m.release(ifaces)
        m.release(count)
    }
    if overridden == 0 {
        var text = m.text()
        m.pushText(&text, "g_object_class_override_property: Can't find property to override for '")
        m.pushC(&text, types.describe(t))
        m.pushText(&text, "::")
        m.pushC(&text, name)
        m.pushText(&text, "'")
        criticalText(&text)
        return
    }
    installProperty(oclass, property_id, g_param_spec_override(name, overridden))
}

// The pspecs a class has: from the root down, each type's ordered by id,
// overrides and the properties they override counted once.
fn listFor(t: usize, iface: bool, count: usize) -> usize {
    var result = m.words()
    lock()
    const depth = if iface { 1 } else { @intCast(usize, g_type_depth(t)) }
    var level = depth
    var all = m.words()
    // Every pspec of the pool.
    var bucket = hash.nextUsed(pool, -1)
    while bucket >= 0 {
        const list = wordsAt(hash.valueAtBucket(pool, bucket))
        var k: usize = 0
        while k < list.*.length {
            m.pushWord(&all, m.wordAt(list, k))
            k += 1
        }
        bucket = hash.nextUsed(pool, bucket)
    }
    while level > 0 {
        level -= 1
        // The type at this depth (root first).
        const owner = if iface { t } else { ancestorAt(t, depth - level) }
        var level_ = m.words()
        var k: usize = 0
        while k < all.length {
            const p = m.wordAt(&all, k)
            const pOwner = m.getWord(p + 32)
            // The interfaces' properties count as the root's.
            if pOwner == owner || (!iface && level == depth - 1 && types.fundamentalOf(pOwner) == types.T_INTERFACE && types.isA(t, pOwner)) { m.pushWord(&level_, p) }
            k += 1
        }
        sortById(&level_)
        k = 0
        while k < level_.length {
            const p = m.wordAt(&level_, k)
            var keep = params.redirectTarget(p) == 0
            if keep && !iface {
                const found = poolLookup(params.nameOf(p), t, true)
                if found != p && params.redirectTarget(found) != p { keep = false }
            }
            if keep { m.pushWord(&result, p) }
            k += 1
        }
        m.disposeWords(&level_)
    }
    m.disposeWords(&all)
    unlock()
    const array = m.alloc((result.length + 1) * 8)
    m.copy(array, result.address, result.length * 8)
    if count != 0 { m.put32(count, @intCast(u32, result.length)) }
    m.disposeWords(&result)
    return array
}

// The ancestor of `t` at depth `d` (1 the root).
fn ancestorAt(t: usize, d: usize) -> usize {
    var owner = t
    var depth = @intCast(usize, g_type_depth(t))
    while depth > d {
        owner = types.parentOf(owner)
        depth -= 1
    }
    return owner
}

fn sortById(list: *m.Words) -> void {
    var i: usize = 1
    while i < list.*.length {
        const p = m.wordAt(list, i)
        var j = i
        while j > 0 && m.get32(m.wordAt(list, j - 1) + 68) > m.get32(p + 68) {
            m.putWord(list.*.address + j * 8, m.wordAt(list, j - 1))
            j -= 1
        }
        m.putWord(list.*.address + j * 8, p)
        i += 1
    }
}

export fn g_object_class_list_properties(oclass: usize, n_properties: usize) -> usize { return listFor(m.getWord(oclass), false, n_properties) }

export fn g_object_interface_install_property(g_iface: usize, pspec: usize) -> void {
    const iface = m.getWord(g_iface)
    const f = params.flagsOf(pspec)
    if (f & (READABLE | WRITABLE)) == 0 {
        values.gobjectCritical("validate_pspec_to_install: assertion 'pspec->flags & (G_PARAM_READABLE | G_PARAM_WRITABLE)' failed")
        return
    }
    _ = installInternal(iface, 0, pspec)
}

export fn g_object_interface_find_property(g_iface: usize, property_name: usize) -> usize { return poolLookup(property_name, m.getWord(g_iface), false) }
export fn g_object_interface_list_properties(g_iface: usize, n_properties_p: usize) -> usize { return listFor(m.getWord(g_iface), true, n_properties_p) }

// ---------------------------------------------------------------------------
// Setting and getting properties

export fn __mlx_glib_object_do_set_property(object: usize, id: u32, value: usize, pspec: usize) -> void { g_object_warn_invalid_pspec(object, m.literal("property"), id, pspec) }
export fn __mlx_glib_object_do_get_property(object: usize, id: u32, value: usize, pspec: usize) -> void { g_object_warn_invalid_pspec(object, m.literal("property"), id, pspec) }

export fn g_object_warn_invalid_pspec(object: usize, what: usize, property_id: u32, pspec: usize) -> void {
    var t = m.text()
    m.pushText(&t, "invalid ")
    m.pushC(&t, what)
    m.pushText(&t, " id ")
    m.pushDecimal(&t, @intCast(u64, property_id))
    m.pushText(&t, " for \"")
    m.pushC(&t, params.nameOf(pspec))
    m.pushText(&t, "\" of type '")
    m.pushC(&t, types.describe(types.instanceType(pspec)))
    m.pushText(&t, "' in '")
    m.pushC(&t, types.describe(typeOf(object)))
    m.pushText(&t, "'")
    warnText(&t)
}

fn frozen(object: usize) -> bool {
    lock()
    const x = m.getWord(object + O_EXTRA)
    const result = x != 0 && m.get32(x + X_FREEZE) > 0
    unlock()
    return result
}

fn freeze(object: usize) -> void {
    lock()
    const x = extra(object)
    m.put32(x + X_FREEZE, m.get32(x + X_FREEZE) + 1)
    unlock()
}

fn thaw(object: usize) -> void {
    lock()
    const x = extra(object)
    if m.get32(x + X_FREEZE) == 0 {
        unlock()
        var t = m.text()
        m.pushText(&t, "g_object_thaw_notify: object of type '")
        m.pushC(&t, types.describe(typeOf(object)))
        m.pushText(&t, "' has no notify queue to thaw")
        criticalText(&t)
        return
    }
    m.put32(x + X_FREEZE, m.get32(x + X_FREEZE) - 1)
    if m.get32(x + X_FREEZE) > 0 {
        unlock()
        return
    }
    const queue = wordsAt(x + X_QUEUE)
    const n = queue.*.length
    var pspecs: usize = 0
    if n > 0 {
        // Last queued first, as GLib's list does.
        pspecs = m.alloc(n * 8)
        var k: usize = 0
        while k < n {
            m.putWord(pspecs + k * 8, m.wordAt(queue, n - 1 - k))
            k += 1
        }
        queue.*.length = 0
    }
    unlock()
    if n > 0 {
        _ = ref(object)
        dispatch(object, @intCast(u32, n), pspecs)
        unref(object)
        m.release(pspecs)
    }
}

fn dispatch(object: usize, n: u32, pspecs: usize) -> void {
    const f = m.getWord(classOf(object) + C_DISPATCH)
    if f == 0 { return }
    const call: Dispatch = unsafe { @ptrFromInt(Dispatch, f) }
    call(object, n, pspecs)
}

export fn __mlx_glib_object_dispatch_properties_changed(object: usize, n: u32, pspecs: usize) -> void {
    var i: u32 = 0
    while i < n {
        const pspec = m.getWord(pspecs + @intCast(usize, i) * 8)
        emitNotify(object, pspec)
        i += 1
    }
}

fn emitNotify(object: usize, pspec: usize) -> void {
    const values_ = m.alloc(48)
    _ = values.init(values_, typeOf(object))
    m.putWord(values_ + 8, object)
    _ = values.init(values_ + 24, types.T_PARAM)
    m.putWord(values_ + 32, pspec)
    signals.emit(values_, notifySignal, params.nameQuark(pspec), 0)
    m.release(values_)
}

fn queueNotify(object: usize, pspec: usize) -> void {
    lock()
    const queue = wordsAt(extra(object) + X_QUEUE)
    var k: usize = 0
    var seen = false
    while k < queue.*.length {
        if m.wordAt(queue, k) == pspec { seen = true }
        k += 1
    }
    if !seen { m.pushWord(queue, pspec) }
    unlock()
}

fn notifyPspec(object: usize, pspec_: usize) -> void {
    var pspec = pspec_
    if (params.flagsOf(pspec) & READABLE) == 0 { return }
    const target = params.redirectTarget(pspec)
    if target != 0 { pspec = target }
    if frozen(object) {
        queueNotify(object, pspec)
    } else {
        const one = m.alloc(8)
        m.putWord(one, pspec)
        _ = ref(object)
        dispatch(object, 1, one)
        unref(object)
        m.release(one)
    }
}

export fn g_object_freeze_notify(object: usize) -> void { if assertObject(object, "g_object_freeze_notify") { freeze(object) } }
export fn g_object_thaw_notify(object: usize) -> void { if assertObject(object, "g_object_thaw_notify") { thaw(object) } }

export fn g_object_notify(object: usize, property_name: usize) -> void {
    if !assertObject(object, "g_object_notify") { return }
    const pspec = findPspec(classOf(object), property_name)
    if pspec == 0 {
        var t = m.text()
        m.pushText(&t, "g_object_notify: object class '")
        m.pushC(&t, types.describe(typeOf(object)))
        m.pushText(&t, "' has no property named '")
        m.pushC(&t, property_name)
        m.pushText(&t, "'")
        warnText(&t)
        return
    }
    notifyPspec(object, pspec)
}

export fn g_object_notify_by_pspec(object: usize, pspec: usize) -> void { if assertObject(object, "g_object_notify_by_pspec") { notifyPspec(object, pspec) } }

// GLib's object_set_property: the value converted and validated when it
// must be, the class's set_property, the notification queued.
fn setProperty(object: usize, pspec_: usize, value: usize, queue: bool) -> void {
    var pspec = pspec_
    const class = g_type_class_peek(m.getWord(pspec + 32))
    if class == 0 { return }
    const id = m.get32(pspec + 68)
    const target = params.redirectTarget(pspec)
    if target != 0 { pspec = target }
    const pclass = m.getWord(pspec)
    const setter = m.getWord(class + C_SET_PROPERTY)
    if setter == 0 { return }
    const call: PropertyFunc = unsafe { @ptrFromInt(PropertyFunc, setter) }
    const validate = m.getWord(pclass + 32)
    const isValid = m.getWord(pclass + 48)
    if values.compatible(m.getWord(value), params.valueType(pspec)) && (validate == 0 || (isValid != 0 && g_param_value_is_valid(pspec, value) != 0) || !needsValidation(pspec, value)) {
        call(object, id, value, pspec)
    } else {
        const tmp = m.alloc(24)
        _ = values.init(tmp, params.valueType(pspec))
        if !values.transform(value, tmp) {
            var t = m.text()
            m.pushText(&t, "unable to set property '")
            m.pushC(&t, params.nameOf(pspec))
            m.pushText(&t, "' of type '")
            m.pushC(&t, types.describe(params.valueType(pspec)))
            m.pushText(&t, "' from value of type '")
            m.pushC(&t, types.describe(m.getWord(value)))
            m.pushText(&t, "'")
            criticalText(&t)
        } else if params.validate(pspec, tmp) && (params.flagsOf(pspec) & LAX_VALIDATION) == 0 {
            const contents = g_strdup_value_contents(value)
            var t = m.text()
            m.pushText(&t, "value \"")
            m.pushC(&t, contents)
            m.pushText(&t, "\" of type '")
            m.pushC(&t, types.describe(m.getWord(value)))
            m.pushText(&t, "' is invalid or out of range for property '")
            m.pushC(&t, params.nameOf(pspec))
            m.pushText(&t, "' of type '")
            m.pushC(&t, types.describe(params.valueType(pspec)))
            m.pushText(&t, "'")
            criticalText(&t)
            m.release(contents)
        } else {
            call(object, id, tmp, pspec)
        }
        values.unset(tmp)
        m.release(tmp)
    }
    if queue && (params.flagsOf(pspec) & (EXPLICIT_NOTIFY | READABLE)) == READABLE { queueNotify(object, pspec) }
}

// Whether validating the value would change it (GLib asks the pspec's
// value_is_valid; without one, a copy is validated).
fn needsValidation(pspec: usize, value: usize) -> bool {
    if !values.compatible(m.getWord(value), params.valueType(pspec)) { return true }
    return g_param_value_is_valid(pspec, value) == 0
}

fn getProperty(object: usize, pspec_: usize, value: usize) -> void {
    var pspec = pspec_
    const class = g_type_class_peek(m.getWord(pspec + 32))
    if class == 0 { return }
    const id = m.get32(pspec + 68)
    const target = params.redirectTarget(pspec)
    if target != 0 { pspec = target }
    const getter = m.getWord(class + C_GET_PROPERTY)
    if getter == 0 { return }
    const call: PropertyFunc = unsafe { @ptrFromInt(PropertyFunc, getter) }
    call(object, id, value, pspec)
}

fn inConstruction(object: usize) -> bool { return (flags(object) & IN_CONSTRUCTION) != 0 }

fn propertyWarning(function: []const u8, middle: []const u8, first: usize, between: []const u8, second: usize, last: []const u8) -> void {
    var t = m.text()
    m.pushText(&t, function)
    m.pushText(&t, middle)
    m.pushC(&t, first)
    m.pushText(&t, between)
    m.pushC(&t, second)
    m.pushText(&t, last)
    warnText(&t)
}

fn setIsValid(object: usize, pspec: usize, name: usize) -> bool {
    if pspec == 0 {
        propertyWarning("g_object_set_is_valid_property", ": object class '", types.describe(typeOf(object)), "' has no property named '", name, "'")
        return false
    }
    if (params.flagsOf(pspec) & WRITABLE) == 0 {
        propertyWarning("g_object_set_is_valid_property", ": property '", params.nameOf(pspec), "' of object class '", types.describe(typeOf(object)), "' is not writable")
        return false
    }
    if (params.flagsOf(pspec) & CONSTRUCT_ONLY) != 0 && !inConstruction(object) {
        propertyWarning("g_object_set_is_valid_property", ": construct property \"", params.nameOf(pspec), "\" for object '", types.describe(typeOf(object)), "' can't be set after construction")
        return false
    }
    return true
}

fn getIsValid(object: usize, pspec: usize, name: usize) -> bool {
    if pspec == 0 {
        propertyWarning("g_object_get_is_valid_property", ": object class '", types.describe(typeOf(object)), "' has no property named '", name, "'")
        return false
    }
    if (params.flagsOf(pspec) & READABLE) == 0 {
        propertyWarning("g_object_get_is_valid_property", ": property '", params.nameOf(pspec), "' of object class '", types.describe(typeOf(object)), "' is not readable")
        return false
    }
    return true
}

export fn g_object_set_property(object: usize, property_name: usize, value: usize) -> void {
    if !assertObject(object, "g_object_set_property") { return }
    _ = ref(object)
    freeze(object)
    const pspec = findPspec(classOf(object), property_name)
    if setIsValid(object, pspec, property_name) { setProperty(object, pspec, value, true) }
    thaw(object)
    unref(object)
}

export fn g_object_get_property(object: usize, property_name: usize, value: usize) -> void {
    if !assertObject(object, "g_object_get_property") { return }
    const pspec = findPspec(classOf(object), property_name)
    if !getIsValid(object, pspec, property_name) { return }
    _ = ref(object)
    const vt = params.valueType(pspec)
    if m.getWord(value) == vt {
        values.reset(value)
        getProperty(object, pspec, value)
    } else if g_value_type_transformable(vt, m.getWord(value)) != 0 {
        const tmp = m.alloc(24)
        _ = values.init(tmp, vt)
        getProperty(object, pspec, tmp)
        _ = values.transform(tmp, value)
        values.unset(tmp)
        m.release(tmp)
    } else {
        var t = m.text()
        m.pushText(&t, "g_object_get_property: can't retrieve property '")
        m.pushC(&t, params.nameOf(pspec))
        m.pushText(&t, "' of type '")
        m.pushC(&t, types.describe(vt))
        m.pushText(&t, "' as value of type '")
        m.pushC(&t, types.describe(m.getWord(value)))
        m.pushText(&t, "'")
        warnText(&t)
    }
    unref(object)
}

fn setFromList(object: usize, firstName: usize, list: usize) -> void {
    _ = ref(object)
    freeze(object)
    var name = firstName
    while name != 0 {
        const pspec = findPspec(classOf(object), name)
        if !setIsValid(object, pspec, name) { break }
        const value = m.alloc(24)
        _ = values.init(value, params.valueType(pspec))
        const err = values.collect(value, list, 0)
        if err != 0 {
            var t = m.text()
            m.pushText(&t, "g_object_set_valist: ")
            m.pushC(&t, err)
            criticalText(&t)
            m.release(err)
            m.release(value)
            break
        }
        setProperty(object, pspec, value, true)
        values.unset(value)
        m.release(value)
        name = varargs.nextPointer(list)
    }
    thaw(object)
    unref(object)
}

fn getFromList(object: usize, firstName: usize, list: usize) -> void {
    _ = ref(object)
    var name = firstName
    while name != 0 {
        const pspec = findPspec(classOf(object), name)
        if !getIsValid(object, pspec, name) { break }
        const value = m.alloc(24)
        _ = values.init(value, params.valueType(pspec))
        getProperty(object, pspec, value)
        const err = values.lcopy(value, list, 0)
        values.unset(value)
        m.release(value)
        if err != 0 {
            var t = m.text()
            m.pushText(&t, "g_object_get_valist: ")
            m.pushC(&t, err)
            criticalText(&t)
            m.release(err)
            break
        }
        name = varargs.nextPointer(list)
    }
    unref(object)
}

export fn g_object_set(object: usize, first_property_name: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ object, first_property_name, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 2, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    if !assertObject(object, "g_object_set") { return }
    setFromList(object, first_property_name, list)
}

export fn g_object_get(object: usize, first_property_name: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ object, first_property_name, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 2, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    if !assertObject(object, "g_object_get") { return }
    getFromList(object, first_property_name, list)
}

export fn g_object_set_valist(object: usize, first_property_name: usize, var_args: usize) -> void { if assertObject(object, "g_object_set_valist") { setFromList(object, first_property_name, var_args) } }
export fn g_object_get_valist(object: usize, first_property_name: usize, var_args: usize) -> void { if assertObject(object, "g_object_get_valist") { getFromList(object, first_property_name, var_args) } }

export fn g_object_setv(object: usize, n_properties: u32, names: usize, values_: usize) -> void {
    if !assertObject(object, "g_object_setv") { return }
    _ = ref(object)
    freeze(object)
    var i: u32 = 0
    while i < n_properties {
        const name = m.getWord(names + @intCast(usize, i) * 8)
        const pspec = findPspec(classOf(object), name)
        if !setIsValid(object, pspec, name) { break }
        setProperty(object, pspec, values_ + @intCast(usize, i) * 24, true)
        i += 1
    }
    thaw(object)
    unref(object)
}

export fn g_object_getv(object: usize, n_properties: u32, names: usize, values_: usize) -> void {
    if !assertObject(object, "g_object_getv") { return }
    var i: u32 = 0
    while i < n_properties {
        const name = m.getWord(names + @intCast(usize, i) * 8)
        const pspec = findPspec(classOf(object), name)
        if !getIsValid(object, pspec, name) { break }
        const value = values_ + @intCast(usize, i) * 24
        if m.getWord(value) == 0 { _ = values.init(value, params.valueType(pspec)) } else { values.reset(value) }
        getProperty(object, pspec, value)
        i += 1
    }
}

// ---------------------------------------------------------------------------
// Construction

// GLib's g_object_constructor: the instance, its construct properties
// set (GObjectConstructParam: pspec, value).
export fn __mlx_glib_object_constructor(t: usize, n: u32, construct: usize) -> usize {
    const object = types.createInstance(t)
    if object == 0 { return 0 }
    var i: u32 = 0
    while i < n {
        const p = construct + @intCast(usize, i) * 16
        setProperty(object, m.getWord(p), m.getWord(p + 8), true)
        i += 1
    }
    return object
}

fn constructWith(t: usize, count: usize, pspecs: usize, valuesArray: usize) -> usize {
    const class = g_type_class_ref(t)
    if class == 0 { return 0 }
    // Every construct property: the value given, or its default.
    var construct = m.words()
    var node = m.getWord(class + C_CONSTRUCT_PROPERTIES)
    while node != 0 {
        const pspec = m.getWord(node)
        var value: usize = 0
        var k: usize = 0
        while k < count {
            if m.getWord(pspecs + k * 8) == pspec { value = valuesArray + k * 24 }
            k += 1
        }
        if value == 0 { value = g_param_spec_get_default_value(pspec) }
        m.pushWord(&construct, pspec)
        m.pushWord(&construct, value)
        node = m.getWord(node + 8)
    }
    var object: usize = 0
    const constructor = m.getWord(class + C_CONSTRUCTOR)
    if constructor == @intFromPtr(__mlx_glib_object_constructor) || constructor == 0 {
        object = types.createInstance(t)
        if object != 0 {
            freeze(object)
            var k: usize = 0
            while k < construct.length {
                setProperty(object, m.wordAt(&construct, k), m.wordAt(&construct, k + 1), true)
                k += 2
            }
        }
    } else {
        const call: Constructor = unsafe { @ptrFromInt(Constructor, constructor) }
        object = call(t, @intCast(u32, construct.length / 2), construct.address)
        if object != 0 && inConstruction(object) { freeze(object) } else if object != 0 {
            // A singleton handed back: no construction this time.
            m.disposeWords(&construct)
            return object
        }
    }
    m.disposeWords(&construct)
    if object == 0 { return 0 }
    clearFlag(object, IN_CONSTRUCTION)
    const constructed = m.getWord(class + C_CONSTRUCTED)
    if constructed != 0 && constructed != @intFromPtr(__mlx_glib_object_constructed) {
        const call: ObjectFunc = unsafe { @ptrFromInt(ObjectFunc, constructed) }
        call(object)
    }
    var k: usize = 0
    while k < count {
        const pspec = m.getWord(pspecs + k * 8)
        if (params.flagsOf(pspec) & (CONSTRUCT | CONSTRUCT_ONLY)) == 0 { setProperty(object, pspec, valuesArray + k * 24, true) }
        k += 1
    }
    thaw(object)
    return object
}

fn newIsValid(t: usize, pspec: usize, name: usize, seen: *m.Words) -> bool {
    if pspec == 0 {
        propertyWarning("g_object_new_is_valid_property", ": object class '", types.describe(t), "' has no property named '", name, "'")
        return false
    }
    if (params.flagsOf(pspec) & WRITABLE) == 0 {
        propertyWarning("g_object_new_is_valid_property", ": property '", params.nameOf(pspec), "' of object class '", types.describe(t), "' is not writable")
        return false
    }
    if (params.flagsOf(pspec) & (CONSTRUCT | CONSTRUCT_ONLY)) != 0 {
        var k: usize = 0
        while k < seen.*.length {
            if m.wordAt(seen, k) == pspec {
                propertyWarning("g_object_new_is_valid_property", ": property '", params.nameOf(pspec), "' for type '", types.describe(t), "' cannot be set twice")
                return false
            }
            k += 1
        }
    }
    return true
}

fn checkObjectType(t: usize, function: []const u8) -> bool {
    if types.fundamentalOf(t) == types.T_OBJECT { return true }
    var text = m.text()
    m.pushText(&text, function)
    m.pushText(&text, ": assertion 'G_TYPE_IS_OBJECT (object_type)' failed")
    criticalText(&text)
    return false
}

fn newFromList(t: usize, firstName: usize, list: usize) -> usize {
    if !checkObjectType(t, "g_object_new_valist") { return 0 }
    const class = g_type_class_ref(t)
    if class == 0 { return 0 }
    var pspecs = m.words()
    var valueList = m.words()
    var name = firstName
    while name != 0 {
        const pspec = findPspec(class, name)
        if !newIsValid(t, pspec, name, &pspecs) { break }
        const value = m.alloc(24)
        _ = values.init(value, params.valueType(pspec))
        const err = values.collect(value, list, values.NOCOPY_CONTENTS)
        if err != 0 {
            var text = m.text()
            m.pushText(&text, "g_object_new_valist: ")
            m.pushC(&text, err)
            criticalText(&text)
            m.release(err)
            m.release(value)
            break
        }
        m.pushWord(&pspecs, pspec)
        m.pushWord(&valueList, value)
        name = varargs.nextPointer(list)
    }
    const n = pspecs.length
    const slots = m.alloc((n + 1) * 24)
    var k: usize = 0
    while k < n {
        m.copy(slots + k * 24, m.wordAt(&valueList, k), 24)
        m.release(m.wordAt(&valueList, k))
        k += 1
    }
    const object = constructWith(t, n, pspecs.address, slots)
    k = 0
    while k < n {
        values.unset(slots + k * 24)
        k += 1
    }
    m.release(slots)
    m.disposeWords(&pspecs)
    m.disposeWords(&valueList)
    g_type_class_unref(class)
    return object
}

export fn g_object_new(object_type: usize, first_property_name: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ object_type, first_property_name, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 2, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    return newFromList(object_type, first_property_name, list)
}

export fn g_object_new_valist(object_type: usize, first_property_name: usize, var_args: usize) -> usize { return newFromList(object_type, first_property_name, var_args) }

export fn g_object_new_with_properties(object_type: usize, n_properties: u32, names: usize, values_: usize) -> usize {
    if !checkObjectType(object_type, "g_object_new_with_properties") { return 0 }
    const class = g_type_class_ref(object_type)
    if class == 0 { return 0 }
    var pspecs = m.words()
    const slots = m.alloc((@intCast(usize, n_properties) + 1) * 24)
    var n: usize = 0
    var i: u32 = 0
    while i < n_properties {
        const name = m.getWord(names + @intCast(usize, i) * 8)
        const pspec = findPspec(class, name)
        if !newIsValid(object_type, pspec, name, &pspecs) { break }
        m.pushWord(&pspecs, pspec)
        _ = values.init(slots + n * 24, m.getWord(values_ + @intCast(usize, i) * 24))
        values.copy(values_ + @intCast(usize, i) * 24, slots + n * 24)
        n += 1
        i += 1
    }
    const object = constructWith(object_type, n, pspecs.address, slots)
    var k: usize = 0
    while k < n {
        values.unset(slots + k * 24)
        k += 1
    }
    m.release(slots)
    m.disposeWords(&pspecs)
    g_type_class_unref(class)
    return object
}

// ---------------------------------------------------------------------------
// Objects in GValues

fn holdsObject(value: usize, function: []const u8) -> bool {
    if value != 0 && types.fundamentalOf(m.getWord(value)) == types.T_OBJECT { return true }
    if value != 0 && types.isA(m.getWord(value), types.T_OBJECT) { return true }
    var t = m.text()
    m.pushText(&t, function)
    m.pushText(&t, ": assertion 'G_VALUE_HOLDS_OBJECT (value)' failed")
    criticalText(&t)
    return false
}

export fn g_value_set_object(value: usize, v_object: usize) -> void {
    if !holdsObject(value, "g_value_set_object") { return }
    const old = m.getWord(value + 8)
    if v_object != 0 {
        if !values.compatible(typeOf(v_object), m.getWord(value)) {
            values.gobjectCritical("g_value_set_object: assertion 'g_value_type_compatible (G_OBJECT_TYPE (v_object), G_VALUE_TYPE (value))' failed")
            return
        }
        m.putWord(value + 8, ref(v_object))
    } else {
        m.putWord(value + 8, 0)
    }
    if old != 0 { unref(old) }
}

export fn g_value_take_object(value: usize, v_object: usize) -> void {
    if !holdsObject(value, "g_value_take_object") { return }
    const old = m.getWord(value + 8)
    m.putWord(value + 8, v_object)
    if old != 0 { unref(old) }
}

export fn g_value_get_object(value: usize) -> usize { return if holdsObject(value, "g_value_get_object") { m.getWord(value + 8) } else { 0 } }

export fn g_value_dup_object(value: usize) -> usize {
    if !holdsObject(value, "g_value_dup_object") { return 0 }
    const object = m.getWord(value + 8)
    return if object == 0 { 0 } else { ref(object) }
}
