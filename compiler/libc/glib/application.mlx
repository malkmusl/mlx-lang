// GApplication (gapplication.h) as far as a library asks for it: the
// application's id and flags, the rules of ids, and the default
// application (the first one made, as GIO's g_application_constructed
// makes it, until it goes or another is set). Running an application
// (its D-Bus registration and main loop) is not part of this library.
//
// The instance: a GObject and (24) a record of the id (0) and flags (8).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const messages = @import("./messages.mlx")
const types = @import("./types.mlx")
const ioerrors = @import("./ioerrors.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize

var applicationType: usize = 0
var applicationOnce: u64 = 0
var defaultApplication: usize = 0

fn rec(app: usize) -> usize { return m.getWord(app + 24) }

export fn __mlx_glib_application_init(app: usize, class: usize) -> void { m.putWord(app + 24, m.alloc(16)) }

export fn __mlx_glib_application_finalize(app: usize) -> void {
    if defaultApplication == app { defaultApplication = 0 }
    m.release(m.getWord(rec(app)))
    m.release(rec(app))
    ioerrors.chainUp(types.T_OBJECT, 48, app)
}

export fn __mlx_glib_application_class_init(class: usize, data: usize) -> void { m.putWord(class + 48, @intFromPtr(__mlx_glib_application_finalize)) }

export fn g_application_get_type() -> usize {
    if threads.onceEnter(@intFromPtr(&applicationOnce)) {
        types.ensureInit()
        applicationType = ioerrors.defineType(types.T_OBJECT, "GApplication", 312, @intFromPtr(__mlx_glib_application_class_init), 32, @intFromPtr(__mlx_glib_application_init), 0)
        threads.onceLeave(@intFromPtr(&applicationOnce), 1)
    }
    return applicationType
}

// GIO's g_application_id_is_valid: at most 255 characters, a letter,
// '_' or '-' first, elements of [A-Za-z0-9_-] separated by single dots,
// at least two of them.
pub fn idIsValid(id: usize) -> bool {
    const length = m.cLength(id)
    if length == 0 || length > 255 { return false }
    const first = m.get8(id)
    if !(m.isAlpha(first) || first == '_' || first == '-') { return false }
    if m.get8(id + length - 1) == '.' { return false }
    var allowDot = true
    var hasDot = false
    var p = id + 1
    while m.get8(p) != 0 {
        const c = m.get8(p)
        if m.isAlnum(c) || c == '-' || c == '_' {
            allowDot = true
        } else if allowDot && c == '.' {
            hasDot = true
            allowDot = false
        } else {
            return false
        }
        p += 1
    }
    return hasDot
}

export fn g_application_id_is_valid(application_id: usize) -> i32 { return if idIsValid(application_id) { 1 } else { 0 } }

export fn g_application_new(application_id: usize, flags: i32) -> usize {
    if application_id != 0 && !idIsValid(application_id) {
        messages.logText(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, "g_application_new: assertion 'application_id == NULL || g_application_id_is_valid (application_id)' failed")
        return 0
    }
    const app = g_object_new(g_application_get_type(), 0)
    m.putWord(rec(app), if application_id == 0 { 0 } else { m.dup(application_id) })
    m.putI32(rec(app) + 8, flags)
    if defaultApplication == 0 { defaultApplication = app }
    return app
}

export fn g_application_get_application_id(app: usize) -> usize { return m.getWord(rec(app)) }

export fn g_application_set_application_id(app: usize, application_id: usize) -> void {
    if application_id != 0 && !idIsValid(application_id) {
        messages.logText(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, "g_application_set_application_id: assertion 'application_id == NULL || g_application_id_is_valid (application_id)' failed")
        return
    }
    m.release(m.getWord(rec(app)))
    m.putWord(rec(app), if application_id == 0 { 0 } else { m.dup(application_id) })
}

export fn g_application_get_flags(app: usize) -> i32 { return m.getI32(rec(app) + 8) }
export fn g_application_get_default() -> usize { return defaultApplication }
export fn g_application_set_default(app: usize) -> void { defaultApplication = app }
