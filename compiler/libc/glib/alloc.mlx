// Memory (gmem.h): C's allocator, the program aborting when it is out
// of memory for the forms that may not fail.
const m = @import("./memory.mlx")

// n * size, or the program aborts when it overflows.
fn product(n: usize, size: usize) -> usize {
    if size != 0 && n > 18446744073709551615 / size { m.outOfMemory(0) }
    return n * size
}

fn tryProduct(n: usize, size: usize) -> usize {
    if size != 0 && n > 18446744073709551615 / size { return 18446744073709551615 }
    return n * size
}

export fn g_free(mem: usize) -> void { m.release(mem) }
export fn g_free_sized(mem: usize, size: usize) -> void { m.release(mem) }
export fn g_malloc(n_bytes: usize) -> usize { return if n_bytes == 0 { 0 } else { m.raw(n_bytes) } }
export fn g_malloc0(n_bytes: usize) -> usize { return if n_bytes == 0 { 0 } else { m.alloc(n_bytes) } }

export fn g_realloc(mem: usize, n_bytes: usize) -> usize {
    if n_bytes == 0 {
        m.release(mem)
        return 0
    }
    return m.grow(mem, n_bytes)
}

export fn g_try_malloc(n_bytes: usize) -> usize { return if n_bytes == 0 { 0 } else { m.tryRaw(n_bytes) } }
export fn g_try_malloc0(n_bytes: usize) -> usize { return if n_bytes == 0 { 0 } else { m.tryZeroed(n_bytes) } }

export fn g_try_realloc(mem: usize, n_bytes: usize) -> usize {
    if n_bytes == 0 {
        m.release(mem)
        return 0
    }
    return m.tryGrow(mem, n_bytes)
}

export fn g_malloc_n(n_blocks: usize, n_block_bytes: usize) -> usize { return g_malloc(product(n_blocks, n_block_bytes)) }
export fn g_malloc0_n(n_blocks: usize, n_block_bytes: usize) -> usize { return g_malloc0(product(n_blocks, n_block_bytes)) }
export fn g_realloc_n(mem: usize, n_blocks: usize, n_block_bytes: usize) -> usize { return g_realloc(mem, product(n_blocks, n_block_bytes)) }

export fn g_try_malloc_n(n_blocks: usize, n_block_bytes: usize) -> usize {
    const size = tryProduct(n_blocks, n_block_bytes)
    if size == 18446744073709551615 { return 0 }
    return g_try_malloc(size)
}

export fn g_try_malloc0_n(n_blocks: usize, n_block_bytes: usize) -> usize {
    const size = tryProduct(n_blocks, n_block_bytes)
    if size == 18446744073709551615 { return 0 }
    return g_try_malloc0(size)
}

export fn g_try_realloc_n(mem: usize, n_blocks: usize, n_block_bytes: usize) -> usize {
    const size = tryProduct(n_blocks, n_block_bytes)
    if size == 18446744073709551615 { return 0 }
    return g_try_realloc(mem, size)
}

export fn g_memdup2(mem: usize, byte_size: usize) -> usize {
    if mem == 0 || byte_size == 0 { return 0 }
    const copied = m.raw(byte_size)
    m.copy(copied, mem, byte_size)
    return copied
}
