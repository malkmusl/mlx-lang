// GCancellable (gcancellable.h): a flag operations check to stop early,
// as GIO's gcancellable.c keeps it: cancelling sets it (once), wakes its
// descriptor (an eventfd, made when first asked for) and emits
// "cancelled" in the cancelling thread; g_cancellable_connect runs the
// callback at once on one cancelled already. A thread's current
// cancellables are a stack of its own. A cancellable's source becomes
// ready (its ready time 0) when the cancellable is cancelled.
//
// The instance: a GObject and GIO's priv word (24), here a record of the
// flag (0), the lock (4), the descriptor (8) and how many asked for it
// (12).
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const types = @import("./types.mlx")
const signals = @import("./signals.mlx")
const closures = @import("./closures.mlx")
const ioerrors = @import("./ioerrors.mlx")
const messages = @import("./messages.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_ref(object: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_signal_connect_data(instance: usize, detailed: usize, handler: usize, data: usize, destroy: usize, flags: u32) -> u64
extern("c") fn g_signal_handler_disconnect(instance: usize, id: u64) -> void
extern("c") fn g_signal_emit(instance: usize, id: u32, detail: u32) -> void
extern("c") fn g_source_new(funcs: usize, size: u32) -> usize
extern("c") fn g_source_set_ready_time(source: usize, ready_time: i64) -> void
extern("c") fn g_source_set_static_name(source: usize, name: usize) -> void

const P_CANCELLED: usize = 0
const P_LOCK: usize = 4
const P_FD: usize = 8
const P_FD_REFS: usize = 12
const P_SIZE: usize = 16

const CLASS_SIZE: usize = 184
const INSTANCE_SIZE: usize = 32
const CLASS_CANCELLED: usize = 136

var cancellableType: usize = 0
var cancellableOnce: u64 = 0
var cancelledSignal: u32 = 0
var currentKey: u32 = 0
var currentOnce: u64 = 0
var sourceFuncs: [6]usize = undefined
var sourceOnce: u64 = 0

pub const Callback = fn(usize, usize) -> void
pub const Notify = fn(usize) -> void
pub const SourceFunc = fn(usize, usize) -> i32

fn priv(c: usize) -> usize { return m.getWord(c + 24) }

export fn __mlx_glib_cancellable_init(c: usize, class: usize) -> void {
    const p = m.alloc(P_SIZE)
    m.putI32(p + P_FD, -1)
    m.putWord(c + 24, p)
}

export fn __mlx_glib_cancellable_finalize(c: usize) -> void {
    const p = priv(c)
    if m.getI32(p + P_FD) >= 0 { _ = sys.close(m.getI32(p + P_FD)) }
    m.release(p)
    ioerrors.chainUp(types.T_OBJECT, 48, c)
}

export fn __mlx_glib_cancellable_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_glib_cancellable_finalize))
    cancelledSignal = signals.newSignal(m.literal("cancelled"), m.getWord(class), 2, closures.typeClosure(m.getWord(class), @intCast(u32, CLASS_CANCELLED)), 0, 0, 0, types.T_NONE, 0, 0)
}

pub fn cancellableGType() -> usize {
    if threads.onceEnter(@intFromPtr(&cancellableOnce)) {
        types.ensureInit()
        cancellableType = ioerrors.defineType(types.T_OBJECT, "GCancellable", CLASS_SIZE, @intFromPtr(__mlx_glib_cancellable_class_init), INSTANCE_SIZE, @intFromPtr(__mlx_glib_cancellable_init), 0)
        threads.onceLeave(@intFromPtr(&cancellableOnce), 1)
    }
    return cancellableType
}

export fn g_cancellable_get_type() -> usize { return cancellableGType() }
export fn g_cancellable_new() -> usize { return g_object_new(cancellableGType(), 0) }

pub fn isCancelled(c: usize) -> bool {
    if c == 0 { return false }
    return @atomicLoad(u32, m.word32(priv(c) + P_CANCELLED), acquire) != 0
}

export fn g_cancellable_is_cancelled(c: usize) -> i32 { return if isCancelled(c) { 1 } else { 0 } }

pub fn setErrorIfCancelled(c: usize, err: usize) -> bool {
    if !isCancelled(c) { return false }
    ioerrors.set(err, ioerrors.CANCELLED, "Operation was cancelled")
    return true
}

export fn g_cancellable_set_error_if_cancelled(c: usize, err: usize) -> i32 { return if setErrorIfCancelled(c, err) { 1 } else { 0 } }

fn signalFd(fd: i32) -> void {
    const one = m.alloc(8)
    m.put64(one, 1)
    _ = sys.write(fd, one, 8)
    m.release(one)
}

pub fn fdOf(c: usize) -> i32 {
    if c == 0 { return -1 }
    const p = priv(c)
    threads.lock(p + P_LOCK)
    if m.getI32(p + P_FD) < 0 {
        // EFD_CLOEXEC | EFD_NONBLOCK.
        m.putI32(p + P_FD, sys.eventfd(0, 524288 | 2048))
        if isCancelled(c) { signalFd(m.getI32(p + P_FD)) }
    }
    m.put32(p + P_FD_REFS, m.get32(p + P_FD_REFS) + 1)
    const fd = m.getI32(p + P_FD)
    threads.unlock(p + P_LOCK)
    return fd
}

export fn g_cancellable_get_fd(c: usize) -> i32 { return fdOf(c) }

export fn g_cancellable_make_pollfd(c: usize, pollfd: usize) -> i32 {
    if c == 0 { return 0 }
    m.putI32(pollfd, fdOf(c))
    m.put16(pollfd + 4, 1)
    m.put16(pollfd + 6, 0)
    return 1
}

export fn g_cancellable_release_fd(c: usize) -> void {
    if c == 0 { return }
    const p = priv(c)
    threads.lock(p + P_LOCK)
    if m.get32(p + P_FD_REFS) > 0 {
        m.put32(p + P_FD_REFS, m.get32(p + P_FD_REFS) - 1)
        if m.get32(p + P_FD_REFS) == 0 && m.getI32(p + P_FD) >= 0 {
            _ = sys.close(m.getI32(p + P_FD))
            m.putI32(p + P_FD, -1)
        }
    }
    threads.unlock(p + P_LOCK)
}

export fn g_cancellable_cancel(c: usize) -> void {
    if c == 0 || isCancelled(c) { return }
    const p = priv(c)
    threads.lock(p + P_LOCK)
    if m.get32(p + P_CANCELLED) != 0 {
        threads.unlock(p + P_LOCK)
        return
    }
    @atomicStore(u32, m.word32(p + P_CANCELLED), 1, release)
    if m.getI32(p + P_FD) >= 0 { signalFd(m.getI32(p + P_FD)) }
    threads.unlock(p + P_LOCK)
    _ = g_object_ref(c)
    g_signal_emit(c, cancelledSignal, 0)
    g_object_unref(c)
}

export fn g_cancellable_reset(c: usize) -> void {
    const p = priv(c)
    threads.lock(p + P_LOCK)
    if m.get32(p + P_CANCELLED) != 0 {
        if m.getI32(p + P_FD) >= 0 {
            const drain = m.alloc(8)
            _ = sys.read(m.getI32(p + P_FD), drain, 8)
            m.release(drain)
        }
        @atomicStore(u32, m.word32(p + P_CANCELLED), 0, release)
    }
    threads.unlock(p + P_LOCK)
}

export fn g_cancellable_connect(c: usize, callback: usize, data: usize, data_destroy_func: usize) -> u64 {
    if isCancelled(c) {
        const call: Callback = unsafe { @ptrFromInt(Callback, callback) }
        call(c, data)
        if data_destroy_func != 0 {
            const destroy: Notify = unsafe { @ptrFromInt(Notify, data_destroy_func) }
            destroy(data)
        }
        return 0
    }
    return g_signal_connect_data(c, m.literal("cancelled"), callback, data, data_destroy_func, 0)
}

export fn g_cancellable_disconnect(c: usize, handler_id: u64) -> void {
    if c == 0 || handler_id == 0 { return }
    g_signal_handler_disconnect(c, handler_id)
}

// The thread's current cancellables.
fn currentStack() -> usize {
    if threads.onceEnter(@intFromPtr(&currentOnce)) {
        currentKey = threads.newKey(0)
        threads.onceLeave(@intFromPtr(&currentOnce), 1)
    }
    var stack = sys.pthread_getspecific(currentKey)
    if stack == 0 {
        stack = m.alloc(24)
        _ = sys.pthread_setspecific(currentKey, stack)
    }
    return stack
}

fn stackWords(stack: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, stack) } }

export fn g_cancellable_get_current() -> usize {
    const stack = stackWords(currentStack())
    if stack.*.length == 0 { return 0 }
    return m.wordAt(stack, stack.*.length - 1)
}

export fn g_cancellable_push_current(c: usize) -> void { m.pushWord(stackWords(currentStack()), c) }

export fn g_cancellable_pop_current(c: usize) -> void {
    const stack = stackWords(currentStack())
    if stack.*.length == 0 || m.wordAt(stack, stack.*.length - 1) != c {
        messages.critical("g_cancellable_pop_current: assertion 'l->data == cancellable' failed")
        return
    }
    stack.*.length -= 1
}

// The source: a GSource (96 bytes), the cancellable (96), the handler
// that makes it ready (104).
export fn __mlx_glib_cancellable_source_cancelled(c: usize, source: usize) -> void { g_source_set_ready_time(source, 0) }

export fn __mlx_glib_cancellable_source_dispatch(source: usize, callback: usize, user_data: usize) -> i32 {
    g_source_set_ready_time(source, -1)
    if callback == 0 { return 0 }
    const call: SourceFunc = unsafe { @ptrFromInt(SourceFunc, callback) }
    return call(m.getWord(source + 96), user_data)
}

export fn __mlx_glib_cancellable_source_finalize(source: usize) -> void {
    const c = m.getWord(source + 96)
    if c != 0 {
        if m.get64(source + 104) != 0 { g_signal_handler_disconnect(c, m.get64(source + 104)) }
        g_object_unref(c)
    }
}

export fn g_cancellable_source_new(c: usize) -> usize {
    if threads.onceEnter(@intFromPtr(&sourceOnce)) {
        sourceFuncs[0] = 0
        sourceFuncs[1] = 0
        sourceFuncs[2] = @intFromPtr(__mlx_glib_cancellable_source_dispatch)
        sourceFuncs[3] = @intFromPtr(__mlx_glib_cancellable_source_finalize)
        sourceFuncs[4] = 0
        sourceFuncs[5] = 0
        threads.onceLeave(@intFromPtr(&sourceOnce), 1)
    }
    const source = g_source_new(@intFromPtr(&sourceFuncs), 112)
    g_source_set_static_name(source, m.literal("GCancellable"))
    if c != 0 {
        m.putWord(source + 96, g_object_ref(c))
        m.put64(source + 104, g_signal_connect_data(c, m.literal("cancelled"), @intFromPtr(__mlx_glib_cancellable_source_cancelled), source, 0, 0))
        if isCancelled(c) { g_source_set_ready_time(source, 0) }
    }
    return source
}
