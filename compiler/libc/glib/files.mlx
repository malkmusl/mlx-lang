// Files (gfileutils.h, gstdio.h, gdir.h, gmappedfile.h, gconvert.h's
// file names, ghostutils.h): read and written whole through the C
// library's calls, directories read with getdents64, with GLib's error
// messages (the file name between “ and ”).
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const strings = @import("./strings.mlx")
const utils = @import("./utils.mlx")
const arrays = @import("./arrays.mlx")

extern("c") fn stat(path: usize, buffer: usize) -> i32
extern("c") fn lstat(path: usize, buffer: usize) -> i32
extern("c") fn fstat(fd: i32, buffer: usize) -> i32
extern("c") fn access(path: usize, mode: i32) -> i32
extern("c") fn unlink(path: usize) -> i32
extern("c") fn rmdir(path: usize) -> i32
extern("c") fn remove(path: usize) -> i32
extern("c") fn rename(old: usize, new: usize) -> i32
extern("c") fn mkdir(path: usize, mode: u32) -> i32
extern("c") fn chmod(path: usize, mode: u32) -> i32
extern("c") fn chdir(path: usize) -> i32
extern("c") fn fsync(fd: i32) -> i32
extern("c") fn readlink(path: usize, buffer: usize, size: usize) -> isize
extern("c") fn mkdtemp(template: usize) -> usize
extern("c") fn mkstemp(template: usize) -> i32
extern("c") fn mmap(address: usize, length: usize, protection: i32, flags: i32, fd: i32, offset: i64) -> usize
extern("c") fn munmap(address: usize, length: usize) -> i32
extern("c") fn geteuid() -> u32

const O_RDONLY: i32 = 0
const O_WRONLY: i32 = 1
const O_RDWR: i32 = 2
const O_CREAT: i32 = 64
const O_EXCL: i32 = 128
const O_TRUNC: i32 = 512
const O_DIRECTORY: i32 = 65536
const O_CLOEXEC: i32 = 524288

// The quotes GLib puts around names in its messages.
pub fn pushQuoted(t: *m.Text, name: usize) -> void {
    m.pushByte(t, 0xe2)
    m.pushByte(t, 0x80)
    m.pushByte(t, 0x9c)
    const display = displayName(name)
    m.pushC(t, display)
    m.release(display)
    m.pushByte(t, 0xe2)
    m.pushByte(t, 0x80)
    m.pushByte(t, 0x9d)
}

// The error `prefix“name”middle: strerror(errno)` of the file domain.
pub fn fileError(err: usize, errnum: i32, prefix: []const u8, name: usize, middle: []const u8) -> void {
    if err == 0 { return }
    var t = m.text()
    m.pushText(&t, prefix)
    pushQuoted(&t, name)
    m.pushText(&t, middle)
    m.pushText(&t, ": ")
    m.pushC(&t, errors.errnoText(errnum))
    errors.report(err, errors.newError(errors.quarkLiteral("g-file-error-quark"), errors.fileErrorOf(errnum), m.finish(&t)))
}

// ---------------------------------------------------------------------------
// stat: st_mode at 24, st_size at 48 (x86_64).

const STAT_SIZE: usize = 144
const S_IFMT: u32 = 0o170000
const S_IFDIR: u32 = 0o040000
const S_IFREG: u32 = 0o100000
const S_IFLNK: u32 = 0o120000

// The mode of `path` (0 when it cannot be read); `follow` through links.
pub fn modeOf(path: usize, follow: bool) -> u32 {
    const buffer = m.alloc(STAT_SIZE)
    const result = if follow { stat(path, buffer) } else { lstat(path, buffer) }
    const mode = if result == 0 { m.get32(buffer + 24) } else { 0 }
    m.release(buffer)
    return mode
}

pub fn isDirectory(path: usize) -> bool { return (modeOf(path, true) & S_IFMT) == S_IFDIR }

export fn g_file_test(filename: usize, test_: i32) -> i32 {
    if (test_ & 16) != 0 && access(filename, 0) == 0 { return 1 }
    if (test_ & 8) != 0 && access(filename, 1) == 0 {
        if geteuid() != 0 { return 1 }
        // (Root may execute what has an executable bit.)
        const mode = modeOf(filename, true)
        if (mode & S_IFMT) == S_IFREG && (mode & 0o111) != 0 { return 1 }
    }
    if (test_ & 2) != 0 {
        if (modeOf(filename, false) & S_IFMT) == S_IFLNK { return 1 }
    }
    if (test_ & (1 | 4 | 8)) != 0 {
        const mode = modeOf(filename, true)
        if mode != 0 {
            if (test_ & 1) != 0 && (mode & S_IFMT) == S_IFREG { return 1 }
            if (test_ & 4) != 0 && (mode & S_IFMT) == S_IFDIR { return 1 }
            if (test_ & 8) != 0 && (mode & S_IFMT) != S_IFDIR && (mode & 0o111) != 0 { return 1 }
        }
    }
    return 0
}

// The whole content of the descriptor `fd` (NUL-ended), its length in
// `length`; 0 and errno on failure.
pub fn readAll(fd: i32, length: *usize) -> usize {
    var t = m.text()
    m.reserve(&t, 4096)
    while true {
        m.reserve(&t, 4096)
        const count = sys.read(fd, t.address + t.length, t.capacity - t.length - 1)
        if count < 0 {
            if sys.errno() == sys.EINTR { continue }
            const saved = sys.errno()
            m.dispose(&t)
            sys.setErrno(saved)
            return 0
        }
        if count == 0 { break }
        t.length += @intCast(usize, count)
    }
    m.put8(t.address + t.length, 0)
    length.* = t.length
    return t.address
}

pub fn getContents(filename: usize, contents: usize, length: usize, err: usize) -> bool {
    const fd = sys.open(filename, O_RDONLY | O_CLOEXEC, 0)
    if fd < 0 {
        fileError(err, sys.errno(), "Failed to open file ", filename, "")
        return false
    }
    var size: usize = 0
    const data = readAll(fd, &size)
    const saved = sys.errno()
    _ = sys.close(fd)
    if data == 0 {
        fileError(err, saved, "Failed to read from file ", filename, "")
        return false
    }
    m.putWord(contents, data)
    if length != 0 { m.putWord(length, size) }
    return true
}

export fn g_file_get_contents(filename: usize, contents: usize, length: usize, err: usize) -> i32 { return if getContents(filename, contents, length, err) { 1 } else { 0 } }

fn writeAll(fd: i32, data: usize, length: usize) -> bool {
    var done: usize = 0
    while done < length {
        const count = sys.write(fd, data + done, length - done)
        if count < 0 {
            if sys.errno() == sys.EINTR { continue }
            return false
        }
        done += @intCast(usize, count)
    }
    return true
}

export fn g_file_set_contents_full(filename: usize, contents: usize, length: i64, flags: i32, mode: i32, err: usize) -> i32 { return setContents(filename, contents, length, flags, mode, err) }

pub fn setContents(filename: usize, contents: usize, length: i64, flags: i32, mode: i32, err: usize) -> i32 {
    const size = if length < 0 { m.cLength(contents) } else { @intCast(usize, length) }
    var t = m.text()
    m.pushC(&t, filename)
    m.pushText(&t, ".XXXXXX")
    const temporary = m.finish(&t)
    const fd = mkstemp(temporary)
    if fd < 0 {
        fileError(err, sys.errno(), "Failed to create file ", temporary, "")
        m.release(temporary)
        return 0
    }
    _ = chmod(temporary, @intCast(u32, mode))
    if !writeAll(fd, contents, size) {
        const saved = sys.errno()
        _ = sys.close(fd)
        _ = unlink(temporary)
        fileError(err, saved, "Failed to write file ", temporary, ": write() failed")
        m.release(temporary)
        return 0
    }
    if (flags & 2) != 0 { _ = fsync(fd) }
    _ = sys.close(fd)
    if rename(temporary, filename) != 0 {
        const saved = sys.errno()
        _ = unlink(temporary)
        if err != 0 {
            var e = m.text()
            m.pushText(&e, "Failed to rename file ")
            pushQuoted(&e, temporary)
            m.pushText(&e, " to ")
            pushQuoted(&e, filename)
            m.pushText(&e, ": g_rename() failed: ")
            m.pushC(&e, errors.errnoText(saved))
            errors.report(err, errors.newError(errors.quarkLiteral("g-file-error-quark"), errors.fileErrorOf(saved), m.finish(&e)))
        }
        m.release(temporary)
        return 0
    }
    m.release(temporary)
    return 1
}

export fn g_file_set_contents(filename: usize, contents: usize, length: i64, err: usize) -> i32 { return setContents(filename, contents, length, 3, 438, err) }

export fn g_file_read_link(filename: usize, err: usize) -> usize {
    var size: usize = 256
    while true {
        const buffer = m.raw(size)
        const count = readlink(filename, buffer, size)
        if count < 0 {
            const saved = sys.errno()
            m.release(buffer)
            fileError(err, saved, "Failed to read the symbolic link ", filename, "")
            return 0
        }
        if @intCast(usize, count) < size {
            m.put8(buffer + @intCast(usize, count), 0)
            return buffer
        }
        m.release(buffer)
        size = size * 2
    }
    return 0
}

export fn g_mkdtemp(tmpl: usize) -> usize { return mkdtemp(tmpl) }
export fn g_mkdtemp_full(tmpl: usize, mode: i32) -> usize {
    const result = mkdtemp(tmpl)
    if result != 0 { _ = chmod(result, @intCast(u32, mode)) }
    return result
}
export fn g_mkstemp(tmpl: usize) -> i32 { return mkstemp(tmpl) }
export fn g_mkstemp_full(tmpl: usize, flags: i32, mode: i32) -> i32 {
    const fd = mkstemp(tmpl)
    if fd >= 0 { _ = chmod(tmpl, @intCast(u32, mode)) }
    return fd
}

// The template checks of g_file_open_tmp and g_dir_make_tmp; the path in
// the temporary directory, or 0 with the error.
fn temporaryPath(tmpl: usize, fallback: []const u8, err: usize) -> usize {
    const name = if tmpl == 0 { m.literal(fallback) } else { tmpl }
    const quark = errors.quarkLiteral("g-file-error-quark")
    var index: usize = 0
    while m.get8(name + index) != 0 {
        if m.get8(name + index) == 47 {
            if err != 0 {
                var t = m.text()
                m.pushText(&t, "Template ")
                pushQuoted(&t, name)
                m.pushText(&t, " invalid, should not contain a ")
                pushQuoted(&t, m.literal("/"))
                errors.report(err, errors.newError(quark, 24, m.finish(&t)))
            }
            return 0
        }
        index += 1
    }
    if strings.findBytes(name, -1, m.literal("XXXXXX")) == 0 {
        if err != 0 {
            var t = m.text()
            m.pushText(&t, "Template ")
            pushQuoted(&t, name)
            m.pushText(&t, " doesn")
            m.pushByte(&t, 0xe2)
            m.pushByte(&t, 0x80)
            m.pushByte(&t, 0x99)
            m.pushText(&t, "t contain XXXXXX")
            errors.report(err, errors.newError(quark, 24, m.finish(&t)))
        }
        return 0
    }
    var t = m.text()
    m.pushC(&t, utils.tmpDirectory())
    m.pushByte(&t, 47)
    m.pushC(&t, name)
    return m.finish(&t)
}

export fn g_dir_make_tmp(tmpl: usize, err: usize) -> usize {
    const path = temporaryPath(tmpl, ".XXXXXX", err)
    if path == 0 { return 0 }
    if mkdtemp(path) == 0 {
        fileError(err, sys.errno(), "Failed to create file ", path, "")
        m.release(path)
        return 0
    }
    return path
}

export fn g_file_open_tmp(tmpl: usize, name_used: usize, err: usize) -> i32 {
    const path = temporaryPath(tmpl, ".XXXXXX", err)
    if path == 0 { return -1 }
    const fd = mkstemp(path)
    if fd < 0 {
        fileError(err, sys.errno(), "Failed to create file ", path, "")
        m.release(path)
        return -1
    }
    if name_used != 0 { m.putWord(name_used, path) } else { m.release(path) }
    return fd
}

export fn g_mkdir_with_parents(pathname: usize, mode: i32) -> i32 {
    if pathname == 0 || m.get8(pathname) == 0 {
        sys.setErrno(22)
        return -1
    }
    const copy = m.dup(pathname)
    const length = m.cLength(copy)
    var at: usize = 1
    while at <= length {
        if at == length || m.get8(copy + at) == 47 {
            const saved = m.get8(copy + at)
            m.put8(copy + at, 0)
            if !isDirectory(copy) {
                if mkdir(copy, @intCast(u32, mode)) != 0 && sys.errno() != 17 {
                    const errnum = sys.errno()
                    m.release(copy)
                    sys.setErrno(errnum)
                    return -1
                }
                if !isDirectory(copy) {
                    m.release(copy)
                    sys.setErrno(20)
                    return -1
                }
            }
            m.put8(copy + at, saved)
        }
        at += 1
    }
    m.release(copy)
    return 0
}

// ---------------------------------------------------------------------------
// gstdio.h

export fn g_access(filename: usize, mode: i32) -> i32 { return access(filename, mode) }
export fn g_chdir(path: usize) -> i32 { return chdir(path) }
export fn g_unlink(filename: usize) -> i32 { return unlink(filename) }
export fn g_rmdir(filename: usize) -> i32 { return rmdir(filename) }
export fn g_remove(filename: usize) -> i32 { return remove(filename) }
export fn g_rename(oldfilename: usize, newfilename: usize) -> i32 { return rename(oldfilename, newfilename) }
export fn g_mkdir(filename: usize, mode: i32) -> i32 { return mkdir(filename, @intCast(u32, mode)) }
export fn g_chmod(filename: usize, mode: i32) -> i32 { return chmod(filename, @intCast(u32, mode)) }
export fn g_open(filename: usize, flags: i32, mode: i32) -> i32 { return sys.open(filename, flags, @intCast(u32, mode)) }
export fn g_creat(filename: usize, mode: i32) -> i32 { return sys.open(filename, O_WRONLY | O_CREAT | O_TRUNC, @intCast(u32, mode)) }
export fn g_fsync(fd: i32) -> i32 { return fsync(fd) }

export fn g_close(fd: i32, err: usize) -> i32 {
    if sys.close(fd) == 0 { return 1 }
    const errnum = sys.errno()
    // (EINTR: the descriptor is closed all the same.)
    if errnum == sys.EINTR { return 1 }
    if err != 0 {
        var t = m.text()
        m.pushC(&t, errors.errnoText(errnum))
        errors.report(err, errors.newError(errors.quarkLiteral("g-file-error-quark"), errors.fileErrorOf(errnum), m.finish(&t)))
    }
    return 0
}

// ---------------------------------------------------------------------------
// GDir: the descriptor, the getdents64 buffer, its fill and position,
// the name last read (a copy), references.

const D_FD: usize = 0
const D_BUFFER: usize = 8
const D_FILL: usize = 16
const D_AT: usize = 24
const D_REFS: usize = 32
const D_SIZE: usize = 40
const BUFFER_SIZE: usize = 8192

export fn g_dir_open(path: usize, flags: u32, err: usize) -> usize {
    const fd = sys.open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC, 0)
    if fd < 0 {
        fileError(err, sys.errno(), "Error opening directory ", path, "")
        return 0
    }
    const dir = m.alloc(D_SIZE)
    m.putI32(dir + D_FD, fd)
    m.putWord(dir + D_BUFFER, m.raw(BUFFER_SIZE))
    m.put32(dir + D_REFS, 1)
    return dir
}

export fn g_dir_read_name(dir: usize) -> usize {
    while true {
        if m.getWord(dir + D_AT) >= m.getWord(dir + D_FILL) {
            const count = sys.syscall3(217, @intCast(usize, m.getI32(dir + D_FD)), m.getWord(dir + D_BUFFER), BUFFER_SIZE)
            if count <= 0 { return 0 }
            m.putWord(dir + D_FILL, @intCast(usize, count))
            m.putWord(dir + D_AT, 0)
        }
        const entry = m.getWord(dir + D_BUFFER) + m.getWord(dir + D_AT)
        m.putWord(dir + D_AT, m.getWord(dir + D_AT) + @intCast(usize, m.get16(entry + 16)))
        const name = entry + 19
        if m.cIs(name, ".") || m.cIs(name, "..") { continue }
        return name
    }
    return 0
}

export fn g_dir_rewind(dir: usize) -> void {
    _ = sys.syscall3(8, @intCast(usize, m.getI32(dir + D_FD)), 0, 0)
    m.putWord(dir + D_FILL, 0)
    m.putWord(dir + D_AT, 0)
}

fn dirFree(dir: usize) -> void {
    if m.getI32(dir + D_FD) >= 0 { _ = sys.close(m.getI32(dir + D_FD)) }
    m.release(m.getWord(dir + D_BUFFER))
    m.release(dir)
}

export fn g_dir_close(dir: usize) -> void {
    _ = sys.close(m.getI32(dir + D_FD))
    m.putI32(dir + D_FD, -1)
    if threads.refDec(dir + D_REFS) { dirFree(dir) }
}

export fn g_dir_ref(dir: usize) -> usize {
    threads.refInc(dir + D_REFS)
    return dir
}

export fn g_dir_unref(dir: usize) -> void {
    if threads.refDec(dir + D_REFS) { dirFree(dir) }
}

// ---------------------------------------------------------------------------
// GMappedFile: the contents (mapped, or "" for an empty file), the
// length, the references.

export fn __mlx_glib_mapped_file_unref(file: usize) -> void { mappedUnref(file) }

fn mappedUnref(file: usize) -> void {
    if threads.refDec(file + 16) {
        if m.getWord(file + 8) > 0 { _ = munmap(m.getWord(file), m.getWord(file + 8)) }
        m.release(file)
    }
}

fn mapDescriptor(fd: i32, writable: bool, filename: usize, err: usize) -> usize {
    const buffer = m.alloc(STAT_SIZE)
    if fstat(fd, buffer) != 0 {
        const saved = sys.errno()
        m.release(buffer)
        if filename != 0 { fileError(err, saved, "Failed to get attributes of file ", filename, ": fstat() failed") }
        return 0
    }
    const size = @intCast(usize, m.getI64(buffer + 48))
    m.release(buffer)
    const file = m.alloc(24)
    m.put32(file + 16, 1)
    if size == 0 { return file }
    const address = mmap(0, size, if writable { 3 } else { 1 }, if writable { 2 } else { 2 }, fd, 0)
    if address == 18446744073709551615 {
        const saved = sys.errno()
        m.release(file)
        if err != 0 {
            var t = m.text()
            m.pushText(&t, "Failed to map ")
            pushQuoted(&t, if filename != 0 { filename } else { m.literal("fd") })
            m.pushText(&t, ": mmap() failed: ")
            m.pushC(&t, errors.errnoText(saved))
            errors.report(err, errors.newError(errors.quarkLiteral("g-file-error-quark"), errors.fileErrorOf(saved), m.finish(&t)))
        }
        return 0
    }
    m.putWord(file, address)
    m.putWord(file + 8, size)
    return file
}

export fn g_mapped_file_new(filename: usize, writable: i32, err: usize) -> usize {
    const fd = sys.open(filename, (if writable != 0 { O_RDWR } else { O_RDONLY }) | O_CLOEXEC, 0)
    if fd < 0 {
        fileError(err, sys.errno(), "Failed to open file ", filename, ": open() failed")
        return 0
    }
    const file = mapDescriptor(fd, writable != 0, filename, err)
    _ = sys.close(fd)
    return file
}

export fn g_mapped_file_new_from_fd(fd: i32, writable: i32, err: usize) -> usize { return mapDescriptor(fd, writable != 0, 0, err) }
export fn g_mapped_file_get_length(file: usize) -> usize { return m.getWord(file + 8) }
export fn g_mapped_file_get_contents(file: usize) -> usize { return m.getWord(file) }

export fn g_mapped_file_get_bytes(file: usize) -> usize {
    threads.refInc(file + 16)
    return arrays.newBytes(m.getWord(file), m.getWord(file + 8), @intFromPtr(__mlx_glib_mapped_file_unref), file)
}

export fn g_mapped_file_ref(file: usize) -> usize {
    threads.refInc(file + 16)
    return file
}

export fn g_mapped_file_unref(file: usize) -> void { mappedUnref(file) }
export fn g_mapped_file_free(file: usize) -> void { mappedUnref(file) }

// ---------------------------------------------------------------------------
// File names (UTF-8 here) and file URIs.

// A UTF-8 form of `filename` to show: itself when it is valid UTF-8,
// else with U+FFFD for what is not.
pub fn displayName(filename: usize) -> usize {
    if strings.validate(filename, -1, 0) { return m.dup(filename) }
    return strings.makeValid(filename, -1)
}

export fn g_filename_display_name(filename: usize) -> usize { return displayName(filename) }

export fn g_filename_display_basename(filename: usize) -> usize {
    const base = utils.basename(filename)
    const display = displayName(base)
    m.release(base)
    return display
}

fn convertFilename(text: usize, len: i64, bytes_read: usize, bytes_written: usize, err: usize) -> usize {
    const length = if len < 0 { m.cLength(text) } else { @intCast(usize, len) }
    var end: usize = 0
    if !strings.validate(text, @intCast(i64, length), @intFromPtr(&end)) {
        if bytes_read != 0 { m.putWord(bytes_read, end - text) }
        errors.set(err, errors.quarkLiteral("g_convert_error"), 1, "Invalid byte sequence in conversion input")
        return 0
    }
    if bytes_read != 0 { m.putWord(bytes_read, length) }
    if bytes_written != 0 { m.putWord(bytes_written, length) }
    return m.dupBytes(text, length)
}

export fn g_filename_to_utf8(opsysstring: usize, len: i64, bytes_read: usize, bytes_written: usize, err: usize) -> usize { return convertFilename(opsysstring, len, bytes_read, bytes_written, err) }
export fn g_filename_from_utf8(utf8string: usize, len: i64, bytes_read: usize, bytes_written: usize, err: usize) -> usize { return convertFilename(utf8string, len, bytes_read, bytes_written, err) }

export fn g_get_filename_charsets(filename_charsets: usize) -> i32 {
    if filename_charsets != 0 {
        const list = m.alloc(16)
        m.putWord(list, m.literal("UTF-8"))
        m.putWord(filename_charsets, list)
    }
    return 1
}

fn badUri(err: usize, uri: usize, reason: []const u8) -> void {
    if err == 0 { return }
    var t = m.text()
    m.pushText(&t, "The URI ")
    pushQuoted(&t, uri)
    m.pushText(&t, reason)
    errors.report(err, errors.newError(errors.quarkLiteral("g_convert_error"), 4, m.finish(&t)))
}

// The local path of a file:// URI (its %XX unescaped), the host in
// `hostname` when there is one.
export fn g_filename_from_uri(uri: usize, hostname: usize, err: usize) -> usize {
    if hostname != 0 { m.putWord(hostname, 0) }
    if !(m.lower(m.get8(uri)) == 102 && m.lower(m.get8(uri + 1)) == 105 && m.lower(m.get8(uri + 2)) == 108 && m.lower(m.get8(uri + 3)) == 101 && m.get8(uri + 4) == 58) {
        badUri(err, uri, " is not an absolute URI using the “file” scheme")
        return 0
    }
    var at: usize = 5
    var hostStart: usize = 0
    var hostEnd: usize = 0
    if m.get8(uri + at) == 47 && m.get8(uri + at + 1) == 47 {
        at += 2
        hostStart = at
        while m.get8(uri + at) != 0 && m.get8(uri + at) != 47 { at += 1 }
        hostEnd = at
    }
    if m.get8(uri + at) != 47 {
        badUri(err, uri, " is invalid")
        return 0
    }
    var t = m.text()
    while m.get8(uri + at) != 0 && m.get8(uri + at) != 35 && m.get8(uri + at) != 63 {
        const c = m.get8(uri + at)
        if c == 37 {
            if !m.isHex(m.get8(uri + at + 1)) || !m.isHex(m.get8(uri + at + 2)) {
                m.dispose(&t)
                badUri(err, uri, " contains invalidly escaped characters")
                return 0
            }
            const value = (m.hexValue(m.get8(uri + at + 1)) << 4) | m.hexValue(m.get8(uri + at + 2))
            if value == 0 || value == 47 {
                m.dispose(&t)
                badUri(err, uri, " contains invalidly escaped characters")
                return 0
            }
            m.pushByte(&t, value)
            at += 3
        } else {
            m.pushByte(&t, c)
            at += 1
        }
    }
    if hostname != 0 && hostEnd > hostStart && !(hostEnd - hostStart == 9 && m.same(m.bytes(uri + hostStart, 9), "localhost")) {
        m.putWord(hostname, m.dupBytes(uri + hostStart, hostEnd - hostStart))
    }
    return m.finish(&t)
}

// "file://" with the path's reserved bytes %XX-escaped.
export fn g_filename_to_uri(filename: usize, hostname: usize, err: usize) -> usize {
    if m.get8(filename) != 47 {
        if err != 0 {
            var t = m.text()
            m.pushText(&t, "The pathname ")
            pushQuoted(&t, filename)
            m.pushText(&t, " is not an absolute path")
            errors.report(err, errors.newError(errors.quarkLiteral("g_convert_error"), 5, m.finish(&t)))
        }
        return 0
    }
    var t = m.text()
    m.pushText(&t, "file://")
    if hostname != 0 { m.pushC(&t, hostname) }
    var at: usize = 0
    while m.get8(filename + at) != 0 {
        const c = m.get8(filename + at)
        const allowed = m.isAlnum(c) || c == 45 || c == 46 || c == 95 || c == 126 || c == 47 || c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61 || c == 58 || c == 64
        if allowed {
            m.pushByte(&t, c)
        } else {
            m.pushByte(&t, 37)
            m.pushByte(&t, "0123456789ABCDEF"[@intCast(usize, c >> 4)])
            m.pushByte(&t, "0123456789ABCDEF"[@intCast(usize, c & 15)])
        }
        at += 1
    }
    return m.finish(&t)
}

// ---------------------------------------------------------------------------
// Host names (GLib's checks, letter for letter).

pub fn isIpAddress(hostname: usize) -> bool {
    var p = hostname
    var hasColon = false
    var k: usize = 0
    while m.get8(hostname + k) != 0 {
        if m.get8(hostname + k) == 58 { hasColon = true }
        k += 1
    }
    if hasColon {
        var segments: usize = 0
        var skipped = false
        while m.get8(p) != 0 && m.get8(p) != 37 && segments < 8 {
            if p != hostname || (m.get8(p) == 58 && m.get8(p + 1) == 58) {
                if m.get8(p) != 58 { return false }
                p += 1
            }
            if m.get8(p) == 58 && !skipped {
                skipped = true
                segments += 1
                if m.get8(p + 1) == 0 { p += 1 }
                continue
            }
            var end = p
            while m.isHex(m.get8(end)) { end += 1 }
            if end == p || end > p + 4 { return false }
            if m.get8(end) == 46 {
                if (segments == 6 && !skipped) || (segments <= 6 && skipped) { return isIpv4(p) }
                return false
            }
            segments += 1
            p = end
        }
        return (m.get8(p) == 0 || (m.get8(p) == 37 && m.get8(p + 1) != 0)) && (segments == 8 || skipped)
    }
    return isIpv4(p)
}

fn isIpv4(start: usize) -> bool {
    var p = start
    var segments: usize = 0
    while segments < 4 {
        if segments != 0 {
            if m.get8(p) != 46 { return false }
            p += 1
        }
        var octet: u32 = 0
        var end = p
        if m.get8(p) == 48 {
            end = p + 1
        } else {
            while m.isDigit(m.get8(end)) {
                octet = 10 * octet + @intCast(u32, m.get8(end) - 48)
                if octet > 255 { break }
                end += 1
            }
        }
        if end == p || end > p + 3 || octet > 255 { return false }
        p = end
        segments += 1
    }
    return m.get8(p) == 0
}

export fn g_hostname_is_ip_address(hostname: usize) -> i32 { return if isIpAddress(hostname) { 1 } else { 0 } }

export fn g_hostname_is_non_ascii(hostname: usize) -> i32 {
    var k: usize = 0
    while m.get8(hostname + k) != 0 {
        if m.get8(hostname + k) >= 128 { return 1 }
        k += 1
    }
    return 0
}

export fn g_hostname_is_ascii_encoded(hostname: usize) -> i32 {
    var at: usize = 0
    while true {
        if m.lower(m.get8(hostname + at)) == 120 && m.lower(m.get8(hostname + at + 1)) == 110 && m.get8(hostname + at + 2) == 45 && m.get8(hostname + at + 3) == 45 { return 1 }
        while m.get8(hostname + at) != 0 && m.get8(hostname + at) != 46 { at += 1 }
        if m.get8(hostname + at) == 0 { return 0 }
        at += 1
    }
    return 0
}
