// gnetworkaddress.h: GNetworkAddress, a host name and port to connect to,
// a GSocketConnectable. What it is here is what libsoup gives a TLS
// connection as its server identity: the name a certificate must be for
// ("hostname"), the port and the URI scheme, as properties. (Resolving
// it is the client's: g_socket_client_connect_to_host.)
//
// A GNetworkAddress: a GObject and (24) a record of the host name (0), the
// port (8) and the scheme (16).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const types = @import("./types.mlx")
const ioerrors = @import("./ioerrors.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_class_install_property(class: usize, id: u32, pspec: usize) -> void
extern("c") fn g_param_spec_string(name: usize, nick: usize, blurb: usize, default_value: usize, flags: i32) -> usize
extern("c") fn g_param_spec_uint(name: usize, nick: usize, blurb: usize, minimum: u32, maximum: u32, default_value: u32, flags: i32) -> usize
extern("c") fn g_value_get_string(value: usize) -> usize
extern("c") fn g_value_set_string(value: usize, text: usize) -> void
extern("c") fn g_value_get_uint(value: usize) -> u32
extern("c") fn g_value_set_uint(value: usize, v: u32) -> void
extern("c") fn g_type_add_interface_static(t: usize, iface: usize, info: usize) -> void
extern("c") fn g_socket_connectable_get_type() -> usize

var typesOnce: u64 = 0
var addressType: usize = 0

const R_HOST: usize = 0
const R_PORT: usize = 8
const R_SCHEME: usize = 16
const R_SIZE: usize = 24

const PROP_HOSTNAME: u32 = 1
const PROP_PORT: u32 = 2
const PROP_SCHEME: u32 = 3

fn rec(address: usize) -> usize { return m.getWord(address + 24) }

fn ensureType() -> void {
    if threads.onceEnter(@intFromPtr(&typesOnce)) {
        types.ensureInit()
        addressType = ioerrors.defineType(types.T_OBJECT, "GNetworkAddress", 136, @intFromPtr(__mlx_glib_network_address_class_init), 32, @intFromPtr(__mlx_glib_network_address_init), 0)
        const info = m.alloc(24)
        g_type_add_interface_static(addressType, g_socket_connectable_get_type(), info)
        m.release(info)
        threads.onceLeave(@intFromPtr(&typesOnce), 1)
    }
}

export fn g_network_address_get_type() -> usize {
    ensureType()
    return addressType
}

export fn __mlx_glib_network_address_init(address: usize, class: usize) -> void { m.putWord(address + 24, m.alloc(R_SIZE)) }

export fn __mlx_glib_network_address_finalize(address: usize) -> void {
    const r = rec(address)
    m.release(m.getWord(r + R_HOST))
    m.release(m.getWord(r + R_SCHEME))
    m.release(r)
    ioerrors.chainUp(types.T_OBJECT, 48, address)
}

export fn __mlx_glib_network_address_set_property(address: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = rec(address)
    if id == PROP_HOSTNAME {
        m.release(m.getWord(r + R_HOST))
        m.putWord(r + R_HOST, m.dup(g_value_get_string(value)))
    } else if id == PROP_PORT {
        m.putWord(r + R_PORT, @intCast(usize, g_value_get_uint(value)))
    } else if id == PROP_SCHEME {
        m.release(m.getWord(r + R_SCHEME))
        m.putWord(r + R_SCHEME, m.dup(g_value_get_string(value)))
    }
}

export fn __mlx_glib_network_address_get_property(address: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = rec(address)
    if id == PROP_HOSTNAME { g_value_set_string(value, m.getWord(r + R_HOST)) }
    if id == PROP_PORT { g_value_set_uint(value, @intCast(u32, m.getWord(r + R_PORT))) }
    if id == PROP_SCHEME { g_value_set_string(value, m.getWord(r + R_SCHEME)) }
}

export fn __mlx_glib_network_address_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_glib_network_address_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_network_address_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_network_address_finalize))
    // Read and written, construct-only, static strings, as in GIO.
    const flags: i32 = 3 | 8 | 224
    g_object_class_install_property(class, PROP_HOSTNAME, g_param_spec_string(m.literal("hostname"), m.literal("Hostname"), m.literal("Hostname to resolve"), 0, flags))
    g_object_class_install_property(class, PROP_PORT, g_param_spec_uint(m.literal("port"), m.literal("Port"), m.literal("Network port"), 0, 65535, 0, flags))
    g_object_class_install_property(class, PROP_SCHEME, g_param_spec_string(m.literal("scheme"), m.literal("Scheme"), m.literal("URI Scheme"), 0, flags))
}

fn make(hostname: usize, port: u16, scheme: usize) -> usize {
    ensureType()
    const address = g_object_new(addressType, 0)
    const r = rec(address)
    m.putWord(r + R_HOST, m.dup(hostname))
    m.putWord(r + R_PORT, @intCast(usize, port))
    m.putWord(r + R_SCHEME, m.dup(scheme))
    return address
}

export fn g_network_address_new(hostname: usize, port: u16) -> usize { return make(hostname, port, 0) }

export fn g_network_address_new_loopback(port: u16) -> usize { return make(m.literal("localhost"), port, 0) }

export fn g_network_address_get_hostname(addr: usize) -> usize { return m.getWord(rec(addr) + R_HOST) }
export fn g_network_address_get_port(addr: usize) -> u16 { return @intCast(u16, m.getWord(rec(addr) + R_PORT) & 65535) }
export fn g_network_address_get_scheme(addr: usize) -> usize { return m.getWord(rec(addr) + R_SCHEME) }
