// GAsyncResult and GTask (gasyncresult.h, gtask.h), as GIO's gtask.c
// runs them: a task keeps its source object, cancellable, callback and
// the thread-default main context it was made in; its result (a
// pointer, a boolean, an integer or an error) is handed to the callback
// in that context, at once when it is returned from a later iteration
// of that context's loop, else from an idle source. A task run in a
// thread runs its function in a thread of its own and completes in its
// context once the function returns.
//
// The task: a GObject, then (24) a record of the source object (0), the
// cancellable (8), callback (16) and its data (24), the context (32),
// the task data (40) and its destroy notify (48), the priority (56),
// whether a cancelled cancellable makes it fail (60), the source tag
// (64), the name (72), completed (84), the result's kind (88), whether
// an error was propagated (92), the result (96) and its destroy notify
// (104), the error (112), the time it was made (120), threaded (128),
// synchronous (132), the result set (144), ever returned (148).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const varargs = @import("./varargs.mlx")
const errors = @import("./errors.mlx")
const messages = @import("./messages.mlx")
const types = @import("./types.mlx")
const ioerrors = @import("./ioerrors.mlx")
const cancellable = @import("./cancellable.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_ref(object: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_type_interface_peek(class: usize, iface: usize) -> usize
extern("c") fn g_type_add_interface_static(t: usize, iface: usize, info: usize) -> void
extern("c") fn g_type_interface_add_prerequisite(iface: usize, prerequisite: usize) -> void
extern("c") fn g_type_check_instance_is_a(instance: usize, t: usize) -> i32
extern("c") fn g_main_context_ref_thread_default() -> usize
extern("c") fn g_main_context_unref(c: usize) -> void
extern("c") fn g_main_context_push_thread_default(c: usize) -> void
extern("c") fn g_main_context_pop_thread_default(c: usize) -> void
extern("c") fn g_main_current_source() -> usize
extern("c") fn g_source_get_time(source: usize) -> i64
extern("c") fn g_source_get_context(source: usize) -> usize
extern("c") fn g_idle_source_new() -> usize
extern("c") fn g_source_set_callback(source: usize, func: usize, data: usize, notify: usize) -> void
extern("c") fn g_source_set_priority(source: usize, priority: i32) -> void
extern("c") fn g_source_set_static_name(source: usize, name: usize) -> void
extern("c") fn g_source_attach(source: usize, context: usize) -> u32
extern("c") fn g_source_unref(source: usize) -> void
extern("c") fn g_thread_new(name: usize, func: usize, data: usize) -> usize
extern("c") fn g_thread_join(thread: usize) -> usize
extern("c") fn g_thread_unref(thread: usize) -> void
extern("c") fn g_propagate_error(dest: usize, src: usize) -> void

const T_SOURCE: usize = 0
const T_CANCELLABLE: usize = 8
const T_CALLBACK: usize = 16
const T_DATA: usize = 24
const T_CONTEXT: usize = 32
const T_TASK_DATA: usize = 40
const T_TASK_DESTROY: usize = 48
const T_PRIORITY: usize = 56
const T_CHECK: usize = 60
const T_TAG: usize = 64
const T_NAME: usize = 72
const T_NAME_OWNED: usize = 80
const T_COMPLETED: usize = 84
const T_KIND: usize = 88
const T_HAD_ERROR: usize = 92
const T_RESULT: usize = 96
const T_RESULT_DESTROY: usize = 104
const T_ERROR: usize = 112
const T_CREATED: usize = 120
const T_THREADED: usize = 128
const T_SYNCHRONOUS: usize = 132
const T_FUNC: usize = 136
const T_RESULT_SET: usize = 144
const T_RETURNED: usize = 148
const T_SIZE: usize = 152

const KIND_POINTER: u32 = 1
const KIND_BOOLEAN: u32 = 2
const KIND_INT: u32 = 3

const RETURN_SUCCESS: u32 = 0
const RETURN_ERROR: u32 = 1
const RETURN_FROM_THREAD: u32 = 2

pub const Callback = fn(usize, usize, usize) -> void
pub const ThreadFunc = fn(usize, usize, usize, usize) -> void
pub const Notify = fn(usize) -> void
pub const UserData = fn(usize) -> usize
pub const IsTagged = fn(usize, usize) -> i32

var asyncResultType: usize = 0
var asyncResultOnce: u64 = 0
var taskType: usize = 0
var taskOnce: u64 = 0

fn rec(task: usize) -> usize { return m.getWord(task + 24) }

// ---------------------------------------------------------------------------
// GAsyncResult: an interface (vtable: get_user_data 16, get_source_object
// 24, is_tagged 32).

pub fn asyncResultGType() -> usize {
    if threads.onceEnter(@intFromPtr(&asyncResultOnce)) {
        types.ensureInit()
        asyncResultType = ioerrors.defineType(types.T_INTERFACE, "GAsyncResult", 40, 0, 0, 0, 0)
        g_type_interface_add_prerequisite(asyncResultType, types.T_OBJECT)
        threads.onceLeave(@intFromPtr(&asyncResultOnce), 1)
    }
    return asyncResultType
}

export fn g_async_result_get_type() -> usize { return asyncResultGType() }

fn vtableOf(res: usize) -> usize { return g_type_interface_peek(m.getWord(res), asyncResultGType()) }

export fn g_async_result_get_user_data(res: usize) -> usize {
    const vtable = vtableOf(res)
    if vtable == 0 || m.getWord(vtable + 16) == 0 { return 0 }
    const call: UserData = unsafe { @ptrFromInt(UserData, m.getWord(vtable + 16)) }
    return call(res)
}

export fn g_async_result_get_source_object(res: usize) -> usize {
    const vtable = vtableOf(res)
    if vtable == 0 || m.getWord(vtable + 24) == 0 { return 0 }
    const call: UserData = unsafe { @ptrFromInt(UserData, m.getWord(vtable + 24)) }
    return call(res)
}

export fn g_async_result_is_tagged(res: usize, source_tag: usize) -> i32 {
    const vtable = vtableOf(res)
    if vtable == 0 || m.getWord(vtable + 32) == 0 { return 0 }
    const call: IsTagged = unsafe { @ptrFromInt(IsTagged, m.getWord(vtable + 32)) }
    return call(res, source_tag)
}

export fn g_async_result_legacy_propagate_error(res: usize, err: usize) -> i32 { return 0 }

// ---------------------------------------------------------------------------
// GTask

export fn __mlx_glib_task_user_data(task: usize) -> usize { return m.getWord(rec(task) + T_DATA) }

export fn __mlx_glib_task_source_object(task: usize) -> usize {
    const source = m.getWord(rec(task) + T_SOURCE)
    return if source == 0 { 0 } else { g_object_ref(source) }
}

export fn __mlx_glib_task_is_tagged(task: usize, tag: usize) -> i32 { return if m.getWord(rec(task) + T_TAG) == tag { 1 } else { 0 } }

export fn __mlx_glib_task_iface_init(vtable: usize, data: usize) -> void {
    m.putWord(vtable + 16, @intFromPtr(__mlx_glib_task_user_data))
    m.putWord(vtable + 24, @intFromPtr(__mlx_glib_task_source_object))
    m.putWord(vtable + 32, @intFromPtr(__mlx_glib_task_is_tagged))
}

export fn __mlx_glib_task_init(task: usize, class: usize) -> void {
    const r = m.alloc(T_SIZE)
    m.put32(r + T_CHECK, 1)
    m.putWord(task + 24, r)
}

export fn __mlx_glib_task_finalize(task: usize) -> void {
    const r = rec(task)
    if m.getWord(r + T_SOURCE) != 0 { g_object_unref(m.getWord(r + T_SOURCE)) }
    if m.getWord(r + T_CANCELLABLE) != 0 { g_object_unref(m.getWord(r + T_CANCELLABLE)) }
    if m.getWord(r + T_CONTEXT) != 0 { g_main_context_unref(m.getWord(r + T_CONTEXT)) }
    callNotify(m.getWord(r + T_TASK_DESTROY), m.getWord(r + T_TASK_DATA))
    if m.get32(r + T_KIND) == KIND_POINTER && m.get32(r + T_RESULT_SET) != 0 { callNotify(m.getWord(r + T_RESULT_DESTROY), m.getWord(r + T_RESULT)) }
    if m.getWord(r + T_ERROR) != 0 { errors.freeError(m.getWord(r + T_ERROR)) }
    if m.get32(r + T_NAME_OWNED) != 0 { m.release(m.getWord(r + T_NAME)) }
    m.release(r)
    ioerrors.chainUp(types.T_OBJECT, 48, task)
}

fn callNotify(notify: usize, data: usize) -> void {
    if notify == 0 || data == 0 { return }
    const call: Notify = unsafe { @ptrFromInt(Notify, notify) }
    call(data)
}

export fn __mlx_glib_task_class_init(class: usize, data: usize) -> void { m.putWord(class + 48, @intFromPtr(__mlx_glib_task_finalize)) }

pub fn taskGType() -> usize {
    if threads.onceEnter(@intFromPtr(&taskOnce)) {
        types.ensureInit()
        taskType = ioerrors.defineType(types.T_OBJECT, "GTask", 136, @intFromPtr(__mlx_glib_task_class_init), 32, @intFromPtr(__mlx_glib_task_init), types.FINAL)
        const info = m.alloc(24)
        m.putWord(info, @intFromPtr(__mlx_glib_task_iface_init))
        g_type_add_interface_static(taskType, asyncResultGType(), info)
        m.release(info)
        threads.onceLeave(@intFromPtr(&taskOnce), 1)
    }
    return taskType
}

export fn g_task_get_type() -> usize { return taskGType() }

pub fn newTask(source: usize, c: usize, callback: usize, data: usize) -> usize {
    const task = g_object_new(taskGType(), 0)
    const r = rec(task)
    m.putWord(r + T_SOURCE, if source == 0 { 0 } else { g_object_ref(source) })
    m.putWord(r + T_CANCELLABLE, if c == 0 { 0 } else { g_object_ref(c) })
    m.putWord(r + T_CALLBACK, callback)
    m.putWord(r + T_DATA, data)
    m.putWord(r + T_CONTEXT, g_main_context_ref_thread_default())
    const current = g_main_current_source()
    if current != 0 { m.putI64(r + T_CREATED, g_source_get_time(current)) }
    return task
}

export fn g_task_new(source_object: usize, c: usize, callback: usize, callback_data: usize) -> usize { return newTask(source_object, c, callback, callback_data) }

fn isTask(task: usize) -> bool { return task != 0 && g_type_check_instance_is_a(task, taskGType()) != 0 }

export fn g_task_is_valid(result: usize, source_object: usize) -> i32 {
    if !isTask(result) { return 0 }
    return if m.getWord(rec(result) + T_SOURCE) == source_object { 1 } else { 0 }
}

export fn g_task_set_task_data(task: usize, task_data: usize, destroy: usize) -> void {
    const r = rec(task)
    callNotify(m.getWord(r + T_TASK_DESTROY), m.getWord(r + T_TASK_DATA))
    m.putWord(r + T_TASK_DATA, task_data)
    m.putWord(r + T_TASK_DESTROY, destroy)
}

export fn g_task_set_priority(task: usize, priority: i32) -> void { m.putI32(rec(task) + T_PRIORITY, priority) }
export fn g_task_set_check_cancellable(task: usize, check: i32) -> void { m.put32(rec(task) + T_CHECK, if check != 0 { 1 } else { 0 }) }
export fn g_task_set_source_tag(task: usize, tag: usize) -> void { m.putWord(rec(task) + T_TAG, tag) }

export fn g_task_set_name(task: usize, name: usize) -> void {
    const r = rec(task)
    if m.get32(r + T_NAME_OWNED) != 0 { m.release(m.getWord(r + T_NAME)) }
    m.putWord(r + T_NAME, if name == 0 { 0 } else { m.dup(name) })
    m.put32(r + T_NAME_OWNED, 1)
}

export fn g_task_set_static_name(task: usize, name: usize) -> void {
    const r = rec(task)
    if m.get32(r + T_NAME_OWNED) != 0 { m.release(m.getWord(r + T_NAME)) }
    m.putWord(r + T_NAME, name)
    m.put32(r + T_NAME_OWNED, 0)
}

export fn g_task_get_source_object(task: usize) -> usize { return m.getWord(rec(task) + T_SOURCE) }
export fn g_task_get_task_data(task: usize) -> usize { return m.getWord(rec(task) + T_TASK_DATA) }
export fn g_task_get_priority(task: usize) -> i32 { return m.getI32(rec(task) + T_PRIORITY) }
export fn g_task_get_context(task: usize) -> usize { return m.getWord(rec(task) + T_CONTEXT) }
export fn g_task_get_cancellable(task: usize) -> usize { return m.getWord(rec(task) + T_CANCELLABLE) }
export fn g_task_get_check_cancellable(task: usize) -> i32 { return @bitCast(i32, m.get32(rec(task) + T_CHECK)) }
export fn g_task_get_source_tag(task: usize) -> usize { return m.getWord(rec(task) + T_TAG) }
export fn g_task_get_name(task: usize) -> usize { return m.getWord(rec(task) + T_NAME) }
export fn g_task_get_completed(task: usize) -> i32 { return @bitCast(i32, m.get32(rec(task) + T_COMPLETED)) }

fn returnNow(task: usize) -> void {
    const r = rec(task)
    const context = m.getWord(r + T_CONTEXT)
    g_main_context_push_thread_default(context)
    const callback = m.getWord(r + T_CALLBACK)
    if callback != 0 {
        const call: Callback = unsafe { @ptrFromInt(Callback, callback) }
        call(m.getWord(r + T_SOURCE), task, m.getWord(r + T_DATA))
    }
    m.put32(r + T_COMPLETED, 1)
    g_main_context_pop_thread_default(context)
}

export fn __mlx_glib_task_complete_in_idle(task: usize) -> i32 {
    returnNow(task)
    return 0
}

export fn __mlx_glib_task_unref(task: usize) -> void { g_object_unref(task) }

// GIO's g_task_return: at once in a later iteration of the task's own
// context, else from an idle source of that context.
fn complete(task: usize, kind: u32) -> void {
    const r = rec(task)
    if kind != RETURN_FROM_THREAD { m.put32(r + T_RETURNED, 1) }
    if kind == RETURN_SUCCESS { m.put32(r + T_RESULT_SET, 1) }
    if m.get32(r + T_SYNCHRONOUS) != 0 { return }
    if m.get32(r + T_THREADED) != 0 && kind != RETURN_FROM_THREAD { return }
    _ = g_object_ref(task)
    const current = g_main_current_source()
    if current != 0 && g_source_get_context(current) == m.getWord(r + T_CONTEXT) {
        if g_source_get_time(current) > m.getI64(r + T_CREATED) && !cancellable.isCancelled(m.getWord(r + T_CANCELLABLE)) {
            returnNow(task)
            g_object_unref(task)
            return
        }
    }
    const source = g_idle_source_new()
    g_source_set_static_name(source, if m.getWord(r + T_NAME) != 0 { m.getWord(r + T_NAME) } else { m.literal("[gio] (unnamed) complete_in_idle_cb") })
    g_source_set_callback(source, @intFromPtr(__mlx_glib_task_complete_in_idle), task, @intFromPtr(__mlx_glib_task_unref))
    g_source_set_priority(source, m.getI32(r + T_PRIORITY))
    _ = g_source_attach(source, m.getWord(r + T_CONTEXT))
    g_source_unref(source)
}

fn checkFresh(task: usize, function: []const u8) -> bool {
    if m.get32(rec(task) + T_RETURNED) == 0 { return true }
    var t = m.text()
    m.pushText(&t, function)
    m.pushText(&t, ": assertion '!task->ever_returned' failed")
    messages.log(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, t.address)
    m.dispose(&t)
    return false
}

export fn g_task_return_pointer(task: usize, result: usize, result_destroy: usize) -> void {
    if !checkFresh(task, "g_task_return_pointer") { return }
    const r = rec(task)
    m.put32(r + T_KIND, KIND_POINTER)
    m.putWord(r + T_RESULT, result)
    m.putWord(r + T_RESULT_DESTROY, result_destroy)
    complete(task, RETURN_SUCCESS)
}

export fn g_task_return_boolean(task: usize, result: i32) -> void {
    if !checkFresh(task, "g_task_return_boolean") { return }
    const r = rec(task)
    m.put32(r + T_KIND, KIND_BOOLEAN)
    m.putWord(r + T_RESULT, if result != 0 { 1 } else { 0 })
    complete(task, RETURN_SUCCESS)
}

export fn g_task_return_int(task: usize, result: i64) -> void {
    if !checkFresh(task, "g_task_return_int") { return }
    const r = rec(task)
    m.put32(r + T_KIND, KIND_INT)
    m.putI64(r + T_RESULT, result)
    complete(task, RETURN_SUCCESS)
}

pub fn returnError(task: usize, e: usize) -> void {
    if !checkFresh(task, "g_task_return_error") {
        errors.freeError(e)
        return
    }
    m.putWord(rec(task) + T_ERROR, e)
    complete(task, RETURN_ERROR)
}

export fn g_task_return_error(task: usize, e: usize) -> void { returnError(task, e) }

export fn g_task_return_new_error_literal(task: usize, domain: u32, code: i32, message: usize) -> void { returnError(task, errors.errorLiteral(domain, code, message)) }

export fn g_task_return_new_error(task: usize, domain: u32, code: i32, format: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ task, @intCast(usize, domain), @intCast(usize, @bitCast(u32, code)), format, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 4, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    returnError(task, errors.newError(domain, code, varargs.formatted(format, list)))
}

export fn g_task_return_error_if_cancelled(task: usize) -> i32 {
    const r = rec(task)
    if !cancellable.isCancelled(m.getWord(r + T_CANCELLABLE)) { return 0 }
    const cell = m.alloc(8)
    _ = cancellable.setErrorIfCancelled(m.getWord(r + T_CANCELLABLE), cell)
    returnError(task, m.getWord(cell))
    m.release(cell)
    return 1
}

// GIO's g_task_propagate_error: a cancelled cancellable (when checked)
// or the error returned.
fn propagateError(task: usize, err: usize) -> bool {
    const r = rec(task)
    if m.get32(r + T_CHECK) != 0 && cancellable.setErrorIfCancelled(m.getWord(r + T_CANCELLABLE), err) { return true }
    const e = m.getWord(r + T_ERROR)
    if e != 0 {
        m.putWord(r + T_ERROR, 0)
        m.put32(r + T_HAD_ERROR, 1)
        g_propagate_error(err, e)
        return true
    }
    return false
}

export fn g_task_propagate_pointer(task: usize, err: usize) -> usize {
    if propagateError(task, err) { return 0 }
    const r = rec(task)
    m.putWord(r + T_RESULT_DESTROY, 0)
    m.put32(r + T_RESULT_SET, 0)
    const result = m.getWord(r + T_RESULT)
    m.putWord(r + T_RESULT, 0)
    return result
}

export fn g_task_propagate_boolean(task: usize, err: usize) -> i32 {
    if propagateError(task, err) { return 0 }
    m.put32(rec(task) + T_RESULT_SET, 0)
    return @intCast(i32, m.getWord(rec(task) + T_RESULT) & 1)
}

export fn g_task_propagate_int(task: usize, err: usize) -> i64 {
    if propagateError(task, err) { return -1 }
    m.put32(rec(task) + T_RESULT_SET, 0)
    return m.getI64(rec(task) + T_RESULT)
}

export fn g_task_had_error(task: usize) -> i32 {
    const r = rec(task)
    if m.getWord(r + T_ERROR) != 0 || m.get32(r + T_HAD_ERROR) != 0 { return 1 }
    if m.get32(r + T_CHECK) != 0 && cancellable.isCancelled(m.getWord(r + T_CANCELLABLE)) { return 1 }
    return 0
}

export fn __mlx_glib_task_thread(task: usize) -> usize {
    const r = rec(task)
    const call: ThreadFunc = unsafe { @ptrFromInt(ThreadFunc, m.getWord(r + T_FUNC)) }
    call(task, m.getWord(r + T_SOURCE), m.getWord(r + T_TASK_DATA), m.getWord(r + T_CANCELLABLE))
    complete(task, RETURN_FROM_THREAD)
    g_object_unref(task)
    return 0
}

export fn g_task_run_in_thread(task: usize, task_func: usize) -> void {
    const r = rec(task)
    m.put32(r + T_THREADED, 1)
    m.putWord(r + T_FUNC, task_func)
    _ = g_object_ref(task)
    const thread = g_thread_new(m.literal("gtask"), @intFromPtr(__mlx_glib_task_thread), task)
    g_thread_unref(thread)
}

export fn g_task_run_in_thread_sync(task: usize, task_func: usize) -> void {
    const r = rec(task)
    m.put32(r + T_THREADED, 1)
    m.put32(r + T_SYNCHRONOUS, 1)
    m.putWord(r + T_FUNC, task_func)
    _ = g_object_ref(task)
    const thread = g_thread_new(m.literal("gtask"), @intFromPtr(__mlx_glib_task_thread), task)
    _ = g_thread_join(thread)
    m.put32(r + T_COMPLETED, 1)
}

export fn g_task_report_error(source_object: usize, callback: usize, callback_data: usize, source_tag: usize, e: usize) -> void {
    const task = newTask(source_object, 0, callback, callback_data)
    g_task_set_source_tag(task, source_tag)
    returnError(task, e)
    g_object_unref(task)
}

export fn g_task_report_new_error(source_object: usize, callback: usize, callback_data: usize, source_tag: usize, domain: u32, code: i32, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    // Six fixed integer arguments fill the registers: the format and what
    // follows it are on the stack.
    const list = m.alloc(24)
    m.put32(list, 48)
    m.put32(list + 4, 48)
    m.putWord(list + 8, @frameAddress() + 16)
    const doubles = m.alloc(176)
    m.putF64(doubles + 48, x0)
    m.putF64(doubles + 64, x1)
    m.putF64(doubles + 80, x2)
    m.putF64(doubles + 96, x3)
    m.putF64(doubles + 112, x4)
    m.putF64(doubles + 128, x5)
    m.putF64(doubles + 144, x6)
    m.putF64(doubles + 160, x7)
    m.putWord(list + 16, doubles)
    const format = varargs.nextPointer(list)
    const message = varargs.formatted(format, list)
    m.release(doubles)
    m.release(list)
    const task = newTask(source_object, 0, callback, callback_data)
    g_task_set_source_tag(task, source_tag)
    returnError(task, errors.newError(domain, code, message))
    g_object_unref(task)
}
