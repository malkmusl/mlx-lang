// gcharset.h's g_get_language_names: the user's languages for messages,
// from the first of LANGUAGE (a colon-separated list), LC_ALL,
// LC_MESSAGES and LANG that is set, each with its variants from the most
// to the least specific (ll_CC.codeset@modifier, ll_CC@modifier,
// ll.codeset@modifier... ll), then "C". The list is made again only when
// the variables change. (GLib also maps the names of locale.alias; names
// here are taken as they are.)
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")

var lock: u64 = 0
var cachedValue: usize = 0
var cachedNames: usize = 0

const CODESET: usize = 1
const TERRITORY: usize = 2
const MODIFIER: usize = 4

fn guess() -> usize {
    const names = [4][]const u8{ "LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG" }
    for name in names {
        const value = sys.getenv(m.literal(name))
        if value != 0 && m.get8(value) != 0 { return value }
    }
    return m.literal("C")
}

fn indexFrom(text: []const u8, byte: u8, from: usize) -> usize {
    var i = from
    while i < text.length {
        if text[i] == byte { return i }
        i += 1
    }
    return text.length
}

fn appendVariants(w: *m.Words, locale: []const u8) -> void {
    const uscore = indexFrom(locale, 95, 0)
    const dot = indexFrom(locale, 46, if uscore < locale.length { uscore } else { 0 })
    const at = indexFrom(locale, 64, if dot < locale.length { dot } else if uscore < locale.length { uscore } else { 0 })
    var mask: usize = 0
    if at < locale.length { mask |= MODIFIER }
    const codesetEnd = at
    if dot < locale.length { mask |= CODESET }
    const territoryEnd = if dot < locale.length { dot } else { at }
    if uscore < locale.length { mask |= TERRITORY }
    const languageEnd = if uscore < locale.length { uscore } else { territoryEnd }
    var j: usize = 0
    while j <= mask {
        const i = mask - j
        if (i & ~mask) == 0 {
            var t = m.text()
            m.pushBytes(&t, m.literal(locale), languageEnd)
            if (i & TERRITORY) != 0 { m.pushBytes(&t, m.literal(locale) + uscore, territoryEnd - uscore) }
            if (i & CODESET) != 0 { m.pushBytes(&t, m.literal(locale) + dot, codesetEnd - dot) }
            if (i & MODIFIER) != 0 { m.pushBytes(&t, m.literal(locale) + at, locale.length - at) }
            m.pushWord(w, m.finish(&t))
        }
        j += 1
    }
}

export fn g_get_language_names() -> usize {
    threads.lock(@intFromPtr(&lock))
    const value = guess()
    if cachedNames == 0 || !m.cEqual(cachedValue, value) {
        // (The lists made before are kept: callers may hold them.)
        var w = m.words()
        const text = m.cSlice(value)
        var start: usize = 0
        while start <= text.length {
            const end = indexFrom(text, 58, start)
            if end > start { appendVariants(&w, text[start..end]) }
            start = end + 1
        }
        m.pushWord(&w, m.dupSlice("C"))
        cachedNames = m.finishWords(&w)
        cachedValue = m.dup(value)
    }
    const result = cachedNames
    threads.unlock(@intFromPtr(&lock))
    return result
}
