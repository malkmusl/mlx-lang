// gresolver.h: GResolver, host names to addresses and addresses to names.
// The public functions answer IP addresses and "localhost" themselves, as
// GIO does, and give the rest to the class: GResolverClass is GIO's
// (reload 136, lookup_by_name 144, its async 152 and finish 160,
// lookup_by_address 168, 176, 184, lookup_service 192, 200, 208,
// lookup_records 216, 224, 232, lookup_by_name_with_flags_async 240, its
// finish 248, lookup_by_name_with_flags 256), so that a subclass (WebKit's
// cached resolver) overrides it. The default resolver is GThreadedResolver:
// getaddrinfo and getnameinfo, in a thread for the asynchronous calls.
// Records (SRV, MX, TXT...) are not looked up here: no DNS client.
//
// A GResolver: a GObject and (24) a record of its timeout in milliseconds.
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const types = @import("./types.mlx")
const errors = @import("./errors.mlx")
const ioerrors = @import("./ioerrors.mlx")
const signals = @import("./signals.mlx")
const closures = @import("./closures.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_ref(object: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_object_class_install_property(class: usize, id: u32, pspec: usize) -> void
extern("c") fn g_param_spec_uint(name: usize, nick: usize, blurb: usize, minimum: u32, maximum: u32, default_value: u32, flags: i32) -> usize
extern("c") fn g_value_get_uint(value: usize) -> u32
extern("c") fn g_value_set_uint(value: usize, v: u32) -> void
extern("c") fn g_object_notify(object: usize, name: usize) -> void
extern("c") fn g_list_append(list: usize, data: usize) -> usize
extern("c") fn g_list_free_full(list: usize, free: usize) -> void
extern("c") fn g_hostname_is_ip_address(host: usize) -> i32
extern("c") fn g_hostname_to_ascii(host: usize) -> usize
extern("c") fn g_inet_address_new_from_string(text: usize) -> usize
extern("c") fn g_inet_address_new_from_bytes(bytes: usize, family: i32) -> usize
extern("c") fn g_inet_address_new_loopback(family: i32) -> usize
extern("c") fn g_inet_address_to_string(address: usize) -> usize
extern("c") fn g_inet_address_equal(a: usize, b: usize) -> i32
extern("c") fn g_inet_socket_address_new(address: usize, port: u16) -> usize
extern("c") fn g_socket_address_to_native(address: usize, dest: usize, length: usize, err: usize) -> i32
extern("c") fn g_socket_address_get_native_size(address: usize) -> i64
extern("c") fn g_task_new(source: usize, c: usize, callback: usize, data: usize) -> usize
extern("c") fn g_task_set_source_tag(task: usize, tag: usize) -> void
extern("c") fn g_task_set_task_data(task: usize, data: usize, destroy: usize) -> void
extern("c") fn g_task_get_task_data(task: usize) -> usize
extern("c") fn g_task_return_pointer(task: usize, result: usize, destroy: usize) -> void
extern("c") fn g_task_return_error(task: usize, e: usize) -> void
extern("c") fn g_task_propagate_pointer(task: usize, err: usize) -> usize
extern("c") fn g_task_run_in_thread(task: usize, func: usize) -> void
extern("c") fn g_async_result_is_tagged(result: usize, tag: usize) -> i32
extern("c") fn g_free(address: usize) -> void
extern("c") fn getaddrinfo(node: usize, service: usize, hints: usize, result: usize) -> i32
extern("c") fn freeaddrinfo(info: usize) -> void
extern("c") fn gai_strerror(code: i32) -> usize
extern("c") fn getnameinfo(address: usize, length: u32, host: usize, hostLength: u32, service: usize, serviceLength: u32, flags: i32) -> i32

// The class's slots.
const C_RELOAD: usize = 136
const C_BY_NAME: usize = 144
const C_BY_NAME_ASYNC: usize = 152
const C_BY_NAME_FINISH: usize = 160
const C_BY_ADDRESS: usize = 168
const C_BY_ADDRESS_ASYNC: usize = 176
const C_BY_ADDRESS_FINISH: usize = 184
const C_RECORDS: usize = 216
const C_RECORDS_ASYNC: usize = 224
const C_RECORDS_FINISH: usize = 232
const C_FLAGS_ASYNC: usize = 240
const C_FLAGS_FINISH: usize = 248
const C_FLAGS: usize = 256
const CLASS_SIZE: usize = 264

// GResolverError.
const NOT_FOUND: i32 = 0
const TEMPORARY_FAILURE: i32 = 1
const INTERNAL: i32 = 2

// GResolverNameLookupFlags.
const IPV4_ONLY: i32 = 1
const IPV6_ONLY: i32 = 2

const AF_INET: i32 = 2
const AF_INET6: i32 = 10
const SOCK_STREAM: i32 = 1
const NI_NAMEREQD: i32 = 8
const EAI_AGAIN: i32 = -3
const EAI_NONAME: i32 = -2

pub const LookupFn = fn(usize, usize, usize, usize) -> usize
pub const LookupFlagsFn = fn(usize, usize, i32, usize, usize) -> usize
pub const AsyncFn = fn(usize, usize, usize, usize, usize) -> void
pub const AsyncFlagsFn = fn(usize, usize, i32, usize, usize, usize) -> void
pub const RecordsFn = fn(usize, usize, i32, usize, usize) -> usize
pub const RecordsAsyncFn = fn(usize, usize, i32, usize, usize, usize) -> void
pub const FinishFn = fn(usize, usize, usize) -> usize

var typesOnce: u64 = 0
var resolverType: usize = 0
var threadedType: usize = 0
var reloadSignal: u32 = 0
var defaultResolver: usize = 0
var defaultLock: u64 = 0
var tagImmediate: u8 = 0
var tagThreaded: u8 = 0

fn ensureTypes() -> void {
    if threads.onceEnter(@intFromPtr(&typesOnce)) {
        types.ensureInit()
        resolverType = ioerrors.defineType(types.T_OBJECT, "GResolver", CLASS_SIZE, @intFromPtr(__mlx_glib_resolver_class_init), 32, @intFromPtr(__mlx_glib_resolver_init), 0)
        threadedType = ioerrors.defineType(resolverType, "GThreadedResolver", CLASS_SIZE, @intFromPtr(__mlx_glib_threaded_resolver_class_init), 32, 0, 0)
        threads.onceLeave(@intFromPtr(&typesOnce), 1)
    }
}

export fn g_resolver_get_type() -> usize {
    ensureTypes()
    return resolverType
}

export fn g_resolver_error_quark() -> u32 { return errors.quarkLiteral("g-resolver-error-quark") }

export fn __mlx_glib_resolver_init(resolver: usize, class: usize) -> void { m.putWord(resolver + 24, m.alloc(8)) }

export fn __mlx_glib_resolver_finalize(resolver: usize) -> void {
    m.release(m.getWord(resolver + 24))
    ioerrors.chainUp(types.T_OBJECT, 48, resolver)
}

export fn __mlx_glib_resolver_set_property(resolver: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == 1 { m.put32(m.getWord(resolver + 24), g_value_get_uint(value)) }
}

export fn __mlx_glib_resolver_get_property(resolver: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == 1 { g_value_set_uint(value, m.get32(m.getWord(resolver + 24))) }
}

export fn __mlx_glib_resolver_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_glib_resolver_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_resolver_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_resolver_finalize))
    // G_PARAM_READWRITE | G_PARAM_EXPLICIT_NOTIFY | G_PARAM_STATIC_STRINGS
    g_object_class_install_property(class, 1, g_param_spec_uint(m.literal("timeout"), m.literal("timeout"), m.literal("timeout"), 0, 0xffffffff, 0, 3 | 1073741824 | 224))
    reloadSignal = signals.newSignal(m.literal("reload"), m.getWord(class), 2, closures.typeClosure(m.getWord(class), @intCast(u32, C_RELOAD)), 0, 0, 0, types.T_NONE, 0, 0)
}

export fn __mlx_glib_threaded_resolver_class_init(class: usize, data: usize) -> void {
    m.putWord(class + C_BY_NAME, @intFromPtr(__mlx_glib_threaded_lookup_by_name))
    m.putWord(class + C_BY_NAME_ASYNC, @intFromPtr(__mlx_glib_threaded_lookup_by_name_async))
    m.putWord(class + C_BY_NAME_FINISH, @intFromPtr(__mlx_glib_threaded_finish))
    m.putWord(class + C_FLAGS, @intFromPtr(__mlx_glib_threaded_lookup_by_name_with_flags))
    m.putWord(class + C_FLAGS_ASYNC, @intFromPtr(__mlx_glib_threaded_lookup_by_name_with_flags_async))
    m.putWord(class + C_FLAGS_FINISH, @intFromPtr(__mlx_glib_threaded_finish))
    m.putWord(class + C_BY_ADDRESS, @intFromPtr(__mlx_glib_threaded_lookup_by_address))
    m.putWord(class + C_BY_ADDRESS_ASYNC, @intFromPtr(__mlx_glib_threaded_lookup_by_address_async))
    m.putWord(class + C_BY_ADDRESS_FINISH, @intFromPtr(__mlx_glib_threaded_finish))
    m.putWord(class + C_RECORDS, @intFromPtr(__mlx_glib_threaded_lookup_records))
    m.putWord(class + C_RECORDS_ASYNC, @intFromPtr(__mlx_glib_threaded_lookup_records_async))
    m.putWord(class + C_RECORDS_FINISH, @intFromPtr(__mlx_glib_threaded_finish))
}

export fn g_resolver_get_default() -> usize {
    ensureTypes()
    threads.lock(@intFromPtr(&defaultLock))
    // GIO's default resolver gives up on a name after 30 seconds.
    if defaultResolver == 0 {
        defaultResolver = g_object_new(threadedType, 0)
        m.put32(m.getWord(defaultResolver + 24), 30000)
    }
    const resolver = g_object_ref(defaultResolver)
    threads.unlock(@intFromPtr(&defaultLock))
    return resolver
}

export fn g_resolver_set_default(resolver: usize) -> void {
    threads.lock(@intFromPtr(&defaultLock))
    const old = defaultResolver
    defaultResolver = g_object_ref(resolver)
    threads.unlock(@intFromPtr(&defaultLock))
    if old != 0 { g_object_unref(old) }
}

export fn g_resolver_get_timeout(resolver: usize) -> u32 { return m.get32(m.getWord(resolver + 24)) }

export fn g_resolver_set_timeout(resolver: usize, timeout: u32) -> void {
    if m.get32(m.getWord(resolver + 24)) == timeout { return }
    m.put32(m.getWord(resolver + 24), timeout)
    g_object_notify(resolver, m.literal("timeout"))
}

export fn __mlx_glib_object_unref_each(object: usize) -> void { g_object_unref(object) }

export fn g_resolver_free_addresses(addresses: usize) -> void { g_list_free_full(addresses, @intFromPtr(__mlx_glib_object_unref_each)) }

fn slot(resolver: usize, at: usize) -> usize { return m.getWord(m.getWord(resolver) + at) }

// ---------------------------------------------------------------------------
// What the public functions answer themselves

fn isLocalhost(host: []const u8) -> bool {
    var name = host
    // A final dot is passed over.
    if name.length > 0 && name[name.length - 1] == 46 { name = name[0..name.length - 1] }
    const word = "localhost"
    if name.length < word.length { return false }
    var index: usize = 0
    while index < word.length {
        if m.lower(name[name.length - word.length + index]) != word[index] { return false }
        index += 1
    }
    return name.length == word.length || name[name.length - word.length - 1] == 46
}

// An IP address or a localhost name: its addresses (`handled` true), or
// an error for an invalid name.
fn handleDirect(host: usize, flags: i32, handled: *bool, err: usize) -> usize {
    handled.* = true
    if g_hostname_is_ip_address(host) != 0 {
        const address = g_inet_address_new_from_string(host)
        if address != 0 { return g_list_append(0, address) }
    }
    if isLocalhost(m.cSlice(host)) {
        var list: usize = 0
        if flags != IPV4_ONLY { list = g_list_append(list, g_inet_address_new_loopback(AF_INET6)) }
        if flags != IPV6_ONLY { list = g_list_append(list, g_inet_address_new_loopback(AF_INET)) }
        return list
    }
    handled.* = false
    return 0
}

fn resolveError(host: usize, code: i32, err: usize) -> void {
    var t = m.text()
    m.pushText(&t, "Error resolving \xe2\x80\x9c")
    m.pushC(&t, host)
    m.pushText(&t, "\xe2\x80\x9d: ")
    m.pushC(&t, gai_strerror(code))
    const kind = if code == EAI_AGAIN { TEMPORARY_FAILURE } else if code == EAI_NONAME { NOT_FOUND } else { NOT_FOUND }
    errors.report(err, errors.newError(g_resolver_error_quark(), kind, m.finish(&t)))
}

// ---------------------------------------------------------------------------
// The threaded resolver's work

// getaddrinfo's addresses of `host` (each once), as GInetAddresses.
fn lookupName(host: usize, flags: i32, err: usize) -> usize {
    const hints = m.alloc(48)
    if flags == IPV4_ONLY { m.putI32(hints + 4, AF_INET) }
    if flags == IPV6_ONLY { m.putI32(hints + 4, AF_INET6) }
    m.putI32(hints + 8, SOCK_STREAM)
    const result = m.alloc(8)
    const code = getaddrinfo(host, 0, hints, result)
    m.release(hints)
    if code != 0 {
        m.release(result)
        resolveError(host, code, err)
        return 0
    }
    var list: usize = 0
    var info = m.getWord(result)
    while info != 0 {
        const family = m.getI32(info + 4)
        const native = m.getWord(info + 24)
        var address: usize = 0
        if family == AF_INET { address = g_inet_address_new_from_bytes(native + 4, AF_INET) }
        if family == AF_INET6 { address = g_inet_address_new_from_bytes(native + 8, AF_INET6) }
        if address != 0 {
            var seen = false
            var at = list
            while at != 0 {
                if g_inet_address_equal(m.getWord(at), address) != 0 { seen = true }
                at = m.getWord(at + 8)
            }
            if seen { g_object_unref(address) } else { list = g_list_append(list, address) }
        }
        info = m.getWord(info + 40)
    }
    freeaddrinfo(m.getWord(result))
    m.release(result)
    if list == 0 {
        var t = m.text()
        m.pushText(&t, "No DNS record of the requested type for \xe2\x80\x9c")
        m.pushC(&t, host)
        m.pushText(&t, "\xe2\x80\x9d")
        errors.report(err, errors.newError(g_resolver_error_quark(), NOT_FOUND, m.finish(&t)))
    }
    return list
}

fn lookupAddress(address: usize, err: usize) -> usize {
    const socketAddress = g_inet_socket_address_new(address, 0)
    const native = m.alloc(128)
    _ = g_socket_address_to_native(socketAddress, native, 128, 0)
    const length = @intCast(u32, g_socket_address_get_native_size(socketAddress))
    g_object_unref(socketAddress)
    const name = m.alloc(1025)
    const code = getnameinfo(native, length, name, 1025, 0, 0, NI_NAMEREQD)
    m.release(native)
    if code != 0 {
        m.release(name)
        const text = g_inet_address_to_string(address)
        var t = m.text()
        m.pushText(&t, "Error reverse-resolving \xe2\x80\x9c")
        m.pushC(&t, text)
        m.pushText(&t, "\xe2\x80\x9d: ")
        m.pushC(&t, gai_strerror(code))
        g_free(text)
        errors.report(err, errors.newError(g_resolver_error_quark(), if code == EAI_AGAIN { TEMPORARY_FAILURE } else { NOT_FOUND }, m.finish(&t)))
        return 0
    }
    const result = m.dup(name)
    m.release(name)
    return result
}

export fn __mlx_glib_threaded_lookup_by_name(resolver: usize, host: usize, c: usize, err: usize) -> usize { return lookupName(host, 0, err) }
export fn __mlx_glib_threaded_lookup_by_name_with_flags(resolver: usize, host: usize, flags: i32, c: usize, err: usize) -> usize { return lookupName(host, flags, err) }
export fn __mlx_glib_threaded_lookup_by_address(resolver: usize, address: usize, c: usize, err: usize) -> usize { return lookupAddress(address, err) }

export fn __mlx_glib_threaded_lookup_records(resolver: usize, name: usize, kind: i32, c: usize, err: usize) -> usize {
    errors.report(err, errors.errorOf(ioerrors.quark(), ioerrors.NOT_SUPPORTED, "Looking up DNS records is not supported"))
    return 0
}

// A job: its kind (0 a name, 1 an address, 2 records), its name or
// address, the lookup flags.
const J_KIND: usize = 0
const J_NAME: usize = 8
const J_FLAGS: usize = 16
const J_SIZE: usize = 24

export fn __mlx_glib_resolver_job_free(job: usize) -> void {
    if m.getI32(job + J_KIND) == 1 { g_object_unref(m.getWord(job + J_NAME)) } else { m.release(m.getWord(job + J_NAME)) }
    m.release(job)
}

export fn __mlx_glib_resolver_free_string(text: usize) -> void { g_free(text) }

export fn __mlx_glib_resolver_thread(task: usize, resolver: usize, job: usize, c: usize) -> void {
    const cell = m.alloc(8)
    const kind = m.getI32(job + J_KIND)
    var result: usize = 0
    if kind == 0 { result = lookupName(m.getWord(job + J_NAME), m.getI32(job + J_FLAGS), cell) }
    if kind == 1 { result = lookupAddress(m.getWord(job + J_NAME), cell) }
    if kind == 2 { result = __mlx_glib_threaded_lookup_records(resolver, m.getWord(job + J_NAME), 0, c, cell) }
    if result == 0 {
        g_task_return_error(task, m.getWord(cell))
    } else {
        g_task_return_pointer(task, result, if kind == 1 { @intFromPtr(__mlx_glib_resolver_free_string) } else { @intFromPtr(g_resolver_free_addresses) })
    }
    m.release(cell)
}

fn runJob(resolver: usize, kind: i32, name: usize, flags: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(resolver, c, callback, data)
    g_task_set_source_tag(task, @intFromPtr(&tagThreaded))
    const job = m.alloc(J_SIZE)
    m.putI32(job + J_KIND, kind)
    m.putWord(job + J_NAME, if kind == 1 { g_object_ref(name) } else { m.dup(name) })
    m.putI32(job + J_FLAGS, flags)
    g_task_set_task_data(task, job, @intFromPtr(__mlx_glib_resolver_job_free))
    g_task_run_in_thread(task, @intFromPtr(__mlx_glib_resolver_thread))
    g_object_unref(task)
}

export fn __mlx_glib_threaded_lookup_by_name_async(resolver: usize, host: usize, c: usize, callback: usize, data: usize) -> void { runJob(resolver, 0, host, 0, c, callback, data) }
export fn __mlx_glib_threaded_lookup_by_name_with_flags_async(resolver: usize, host: usize, flags: i32, c: usize, callback: usize, data: usize) -> void { runJob(resolver, 0, host, flags, c, callback, data) }
export fn __mlx_glib_threaded_lookup_by_address_async(resolver: usize, address: usize, c: usize, callback: usize, data: usize) -> void { runJob(resolver, 1, address, 0, c, callback, data) }
export fn __mlx_glib_threaded_lookup_records_async(resolver: usize, name: usize, kind: i32, c: usize, callback: usize, data: usize) -> void { runJob(resolver, 2, name, 0, c, callback, data) }
export fn __mlx_glib_threaded_finish(resolver: usize, result: usize, err: usize) -> usize { return g_task_propagate_pointer(result, err) }

// ---------------------------------------------------------------------------
// The public functions

fn notImplemented(err: usize, what: []const u8) -> usize {
    errors.report(err, errors.errorOf(ioerrors.quark(), ioerrors.NOT_SUPPORTED, what))
    return 0
}

fn lookupByName(resolver: usize, host: usize, flags: i32, c: usize, err: usize) -> usize {
    var handled = false
    const direct = handleDirect(host, flags, &handled, err)
    if handled { return direct }
    const ascii = g_hostname_to_ascii(host)
    if ascii == 0 {
        var t = m.text()
        m.pushText(&t, "Invalid hostname")
        errors.report(err, errors.newError(g_resolver_error_quark(), NOT_FOUND, m.finish(&t)))
        return 0
    }
    var result: usize = 0
    if flags != 0 {
        const f = slot(resolver, C_FLAGS)
        if f == 0 {
            g_free(ascii)
            return notImplemented(err, "lookup_by_name_with_flags not implemented")
        }
        const call: LookupFlagsFn = unsafe { @ptrFromInt(LookupFlagsFn, f) }
        result = call(resolver, ascii, flags, c, err)
    } else {
        const call: LookupFn = unsafe { @ptrFromInt(LookupFn, slot(resolver, C_BY_NAME)) }
        result = call(resolver, ascii, c, err)
    }
    g_free(ascii)
    return result
}

export fn g_resolver_lookup_by_name(resolver: usize, host: usize, c: usize, err: usize) -> usize { return lookupByName(resolver, host, 0, c, err) }
export fn g_resolver_lookup_by_name_with_flags(resolver: usize, host: usize, flags: i32, c: usize, err: usize) -> usize { return lookupByName(resolver, host, flags, c, err) }

fn lookupByNameAsync(resolver: usize, host: usize, flags: i32, c: usize, callback: usize, data: usize) -> void {
    var handled = false
    const cell = m.alloc(8)
    const direct = handleDirect(host, flags, &handled, cell)
    if handled {
        const task = g_task_new(resolver, c, callback, data)
        g_task_set_source_tag(task, @intFromPtr(&tagImmediate))
        if direct != 0 { g_task_return_pointer(task, direct, @intFromPtr(g_resolver_free_addresses)) } else { g_task_return_error(task, m.getWord(cell)) }
        g_object_unref(task)
        m.release(cell)
        return
    }
    m.release(cell)
    const ascii = g_hostname_to_ascii(host)
    const name = if ascii != 0 { ascii } else { host }
    if flags != 0 {
        const f = slot(resolver, C_FLAGS_ASYNC)
        if f == 0 {
            const task = g_task_new(resolver, c, callback, data)
            g_task_set_source_tag(task, @intFromPtr(&tagImmediate))
            g_task_return_error(task, errors.errorOf(ioerrors.quark(), ioerrors.NOT_SUPPORTED, "lookup_by_name_with_flags_async not implemented"))
            g_object_unref(task)
        } else {
            const call: AsyncFlagsFn = unsafe { @ptrFromInt(AsyncFlagsFn, f) }
            call(resolver, name, flags, c, callback, data)
        }
    } else {
        const call: AsyncFn = unsafe { @ptrFromInt(AsyncFn, slot(resolver, C_BY_NAME_ASYNC)) }
        call(resolver, name, c, callback, data)
    }
    if ascii != 0 { g_free(ascii) }
}

export fn g_resolver_lookup_by_name_async(resolver: usize, host: usize, c: usize, callback: usize, data: usize) -> void { lookupByNameAsync(resolver, host, 0, c, callback, data) }
export fn g_resolver_lookup_by_name_with_flags_async(resolver: usize, host: usize, flags: i32, c: usize, callback: usize, data: usize) -> void { lookupByNameAsync(resolver, host, flags, c, callback, data) }

fn finishWith(resolver: usize, result: usize, err: usize, at: usize) -> usize {
    if g_async_result_is_tagged(result, @intFromPtr(&tagImmediate)) != 0 { return g_task_propagate_pointer(result, err) }
    const call: FinishFn = unsafe { @ptrFromInt(FinishFn, slot(resolver, at)) }
    return call(resolver, result, err)
}

export fn g_resolver_lookup_by_name_finish(resolver: usize, result: usize, err: usize) -> usize { return finishWith(resolver, result, err, C_BY_NAME_FINISH) }

export fn g_resolver_lookup_by_name_with_flags_finish(resolver: usize, result: usize, err: usize) -> usize {
    if g_async_result_is_tagged(result, @intFromPtr(&tagImmediate)) != 0 { return g_task_propagate_pointer(result, err) }
    if slot(resolver, C_FLAGS_FINISH) == 0 { return notImplemented(err, "lookup_by_name_with_flags_finish not implemented") }
    return finishWith(resolver, result, err, C_FLAGS_FINISH)
}

export fn g_resolver_lookup_by_address(resolver: usize, address: usize, c: usize, err: usize) -> usize {
    const call: LookupFn = unsafe { @ptrFromInt(LookupFn, slot(resolver, C_BY_ADDRESS)) }
    return call(resolver, address, c, err)
}

export fn g_resolver_lookup_by_address_async(resolver: usize, address: usize, c: usize, callback: usize, data: usize) -> void {
    const call: AsyncFn = unsafe { @ptrFromInt(AsyncFn, slot(resolver, C_BY_ADDRESS_ASYNC)) }
    call(resolver, address, c, callback, data)
}

export fn g_resolver_lookup_by_address_finish(resolver: usize, result: usize, err: usize) -> usize { return finishWith(resolver, result, err, C_BY_ADDRESS_FINISH) }

