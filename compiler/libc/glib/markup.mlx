// GMarkup (gmarkup.h): GLib's simple XML subset parsed into callbacks,
// the text fed in pieces.
//
// The context keeps what it was fed and not yet used; each call to parse
// takes every construct that is complete (text up to the next '<', a
// start or end tag, a comment, a processing instruction, a CDATA section
// or a declaration) and leaves the rest for the next call or
// end_parse. Text is passed unescaped (the five entities and character
// references, line ends made "\n"), comments, processing instructions
// and declarations through passthrough, CDATA as passthrough or (with
// G_MARKUP_TREAT_CDATA_AS_TEXT) text. White space outside every element
// is skipped, other text there is an error. An error set by a callback
// stops the parse; the context then refuses more.
//
// The context: the parser's callbacks (0), flags (8), references (12),
// user data (16) and its notify (24), the text not yet used (32, its
// address, length and capacity), the open elements (56, names), the
// line and character reached (80, 84), whether it failed (88), whether
// an element was seen (92), whether a parse is running (96), whether
// the next thing is a construct (100) rather than the text before one.
const m = @import("./memory.mlx")
const errors = @import("./errors.mlx")
const strings = @import("./strings.mlx")
const varargs = @import("./varargs.mlx")
const messages = @import("./messages.mlx")

extern("c") fn snprintf(buffer: usize, size: usize, format: usize, a: usize) -> i32
extern("c") fn g_markup_error_quark() -> u32

const K_PARSER: usize = 0
const K_FLAGS: usize = 8
const K_REFS: usize = 12
const K_USER: usize = 16
const K_NOTIFY: usize = 24
const K_BUFFER: usize = 32
const K_STACK: usize = 56
const K_LINE: usize = 80
const K_CHAR: usize = 84
const K_FAILED: usize = 88
const K_SEEN: usize = 92
const K_RUNNING: usize = 96
const K_AT_CONSTRUCT: usize = 100
const K_SIZE: usize = 104

const TREAT_CDATA_AS_TEXT: i32 = 2
const PREFIX_ERROR_POSITION: i32 = 4

const ERROR_BAD_UTF8: i32 = 0
const ERROR_EMPTY: i32 = 1
const ERROR_PARSE: i32 = 2

pub const StartElement = fn(usize, usize, usize, usize, usize, usize) -> void
pub const EndElement = fn(usize, usize, usize, usize) -> void
pub const TextFunc = fn(usize, usize, usize, usize, usize) -> void
pub const ErrorFunc = fn(usize, usize, usize) -> void
pub const Notify = fn(usize) -> void

fn bufferOf(k: usize) -> *m.Text { unsafe { return @ptrFromInt(*m.Text, k + K_BUFFER) } }
fn stackOf(k: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, k + K_STACK) } }

export fn g_markup_parse_context_new(parser: usize, flags: i32, user_data: usize, user_data_dnotify: usize) -> usize {
    const k = m.alloc(K_SIZE)
    m.putWord(k + K_PARSER, parser)
    m.putI32(k + K_FLAGS, flags)
    m.put32(k + K_REFS, 1)
    m.putWord(k + K_USER, user_data)
    m.putWord(k + K_NOTIFY, user_data_dnotify)
    m.putI32(k + K_LINE, 1)
    m.putI32(k + K_CHAR, 1)
    return k
}

export fn g_markup_parse_context_ref(k: usize) -> usize {
    m.put32(k + K_REFS, m.get32(k + K_REFS) + 1)
    return k
}

fn destroy(k: usize) -> void {
    const notify = m.getWord(k + K_NOTIFY)
    if notify != 0 {
        const call: Notify = unsafe { @ptrFromInt(Notify, notify) }
        call(m.getWord(k + K_USER))
    }
    const stack = stackOf(k)
    var i: usize = 0
    while i < stack.*.length {
        m.release(m.wordAt(stack, i))
        i += 1
    }
    m.disposeWords(stack)
    m.dispose(bufferOf(k))
    m.release(k)
}

export fn g_markup_parse_context_unref(k: usize) -> void {
    const refs = m.get32(k + K_REFS)
    if refs <= 1 {
        destroy(k)
    } else {
        m.put32(k + K_REFS, refs - 1)
    }
}

export fn g_markup_parse_context_free(k: usize) -> void {
    if k == 0 { return }
    destroy(k)
}

export fn g_markup_parse_context_get_user_data(k: usize) -> usize { return m.getWord(k + K_USER) }

export fn g_markup_parse_context_get_element(k: usize) -> usize {
    const stack = stackOf(k)
    if stack.*.length == 0 { return 0 }
    return m.wordAt(stack, stack.*.length - 1)
}

export fn g_markup_parse_context_get_position(k: usize, line_number: usize, char_number: usize) -> void {
    if line_number != 0 { m.putI32(line_number, m.getI32(k + K_LINE)) }
    if char_number != 0 { m.putI32(char_number, m.getI32(k + K_CHAR)) }
}

// Moves the position over `length` bytes at `p` (characters, not bytes).
fn advance(k: usize, p: usize, length: usize) -> void {
    var i: usize = 0
    while i < length {
        const c = m.get8(p + i)
        if c == 10 {
            m.putI32(k + K_LINE, m.getI32(k + K_LINE) + 1)
            m.putI32(k + K_CHAR, 1)
        } else if (c & 0xc0) != 0x80 {
            m.putI32(k + K_CHAR, m.getI32(k + K_CHAR) + 1)
        }
        i += 1
    }
}

// An error of the parse ("Error on line L char C: ..."), reported to the
// error callback and stored for the caller.
fn fail(k: usize, err: usize, code: i32, t: *m.Text) -> void {
    var full = m.text()
    m.pushText(&full, "Error on line ")
    m.pushSigned(&full, @intCast(i64, m.getI32(k + K_LINE)))
    m.pushText(&full, " char ")
    m.pushSigned(&full, @intCast(i64, m.getI32(k + K_CHAR)))
    m.pushText(&full, ": ")
    m.pushBytes(&full, t.*.address, t.*.length)
    m.dispose(t)
    failWith(k, err, errors.newError(g_markup_error_quark(), code, m.finish(&full)))
}

fn failWith(k: usize, err: usize, e: usize) -> void {
    m.putI32(k + K_FAILED, 1)
    const parser = m.getWord(k + K_PARSER)
    const onError = m.getWord(parser + 32)
    if onError != 0 {
        const call: ErrorFunc = unsafe { @ptrFromInt(ErrorFunc, onError) }
        call(k, e, m.getWord(k + K_USER))
    }
    errors.report(err, e)
}

// An error in text or an attribute value ("Error on line L: ...").
fn failLine(k: usize, err: usize, t: *m.Text) -> void {
    var full = m.text()
    m.pushText(&full, "Error on line ")
    m.pushSigned(&full, @intCast(i64, m.getI32(k + K_LINE)))
    m.pushText(&full, ": ")
    m.pushBytes(&full, t.*.address, t.*.length)
    m.dispose(t)
    failWith(k, err, errors.newError(g_markup_error_quark(), ERROR_PARSE, m.finish(&full)))
}

fn failLineText(k: usize, err: usize, text: []const u8) -> void {
    var t = m.text()
    m.pushText(&t, text)
    failLine(k, err, &t)
}

fn failText(k: usize, err: usize, code: i32, text: []const u8) -> void {
    var t = m.text()
    m.pushText(&t, text)
    fail(k, err, code, &t)
}

// A callback's error: the parse stops (with the position first when
// G_MARKUP_PREFIX_ERROR_POSITION asks for it).
fn callbackFailed(k: usize, err: usize, cell: usize) -> bool {
    const e = m.getWord(cell)
    if e == 0 { return false }
    m.putWord(cell, 0)
    if (m.getI32(k + K_FLAGS) & PREFIX_ERROR_POSITION) != 0 {
        var t = m.text()
        m.pushText(&t, "line ")
        m.pushSigned(&t, @intCast(i64, m.getI32(k + K_LINE)))
        m.pushText(&t, " char ")
        m.pushSigned(&t, @intCast(i64, m.getI32(k + K_CHAR)))
        m.pushText(&t, ": ")
        m.pushC(&t, errors.message(e))
        m.release(errors.message(e))
        m.putWord(e + 8, m.finish(&t))
    }
    failWith(k, err, e)
    return true
}

// ---------------------------------------------------------------------------
// Unescaping

fn quoted(t: *m.Text, start: usize, length: usize) -> void {
    m.pushText(t, "“")
    m.pushBytes(t, start, length)
    m.pushText(t, "”")
}

// The text of `length` bytes at `start` with its entities and character
// references replaced and its line ends made "\n"; 0 on an error.
fn unescape(k: usize, err: usize, start: usize, length: usize) -> usize {
    var out = m.text()
    m.reserve(&out, length)
    var p = start
    const end = start + length
    while p < end {
        const c = m.get8(p)
        if c == 13 {
            m.pushByte(&out, 10)
            p += if p + 1 < end && m.get8(p + 1) == 10 { 2 } else { 1 }
            continue
        }
        if c != '&' {
            m.pushByte(&out, c)
            p += 1
            continue
        }
        const name = p + 1
        var q = name
        while q < end && m.get8(q) != ';' && m.get8(q) != '&' && !m.isSpace(m.get8(q)) && m.get8(q) != '<' { q += 1 }
        if q >= end || m.get8(q) != ';' {
            if name < end && !(m.isAlpha(m.get8(name)) || m.get8(name) == '#') {
                var t = m.text()
                m.pushText(&t, "Character ")
                quoted(&t, name, strings.skipLength(m.get8(name)))
                m.pushText(&t, " is not valid at the start of an entity name; the & character begins an entity; if this ampersand isn't supposed to be an entity, escape it as &amp;")
                failLine(k, err, &t)
            } else {
                failLineText(k, err, "Entity did not end with a semicolon; most likely you used an ampersand character without intending to start an entity — escape ampersand as &amp;")
            }
            m.dispose(&out)
            return 0
        }
        const n = q - name
        if n == 0 {
            failLineText(k, err, "Empty entity “&;” seen; valid entities are: &amp; &quot; &lt; &gt; &apos;")
            m.dispose(&out)
            return 0
        }
        if m.get8(name) == '#' {
            var value: u64 = 0
            var digits = name + 1
            var base: u64 = 10
            if digits < q && m.get8(digits) == 'x' {
                base = 16
                digits += 1
            }
            var good = digits < q
            var d = digits
            while d < q {
                const x = m.get8(d)
                if base == 16 && m.isHex(x) {
                    value = value * 16 + @intCast(u64, m.hexValue(x))
                } else if m.isDigit(x) {
                    value = value * base + @intCast(u64, x - 48)
                } else {
                    good = false
                }
                if value > 0x10ffff { good = false }
                d += 1
            }
            const ch = @intCast(u32, value & 0xffffffff)
            if !good || value == 0 || (ch >= 0xd800 && ch <= 0xdfff) || ch > 0x10ffff || ch == 0xfffe || ch == 0xffff {
                var t = m.text()
                m.pushText(&t, "Character reference ")
                quoted(&t, name - 1, n + 2)
                m.pushText(&t, " does not encode a permitted character")
                failLine(k, err, &t)
                m.dispose(&out)
                return 0
            }
            const bytes = m.alloc(8)
            const count = strings.encodeUtf8(ch, bytes)
            m.pushBytes(&out, bytes, count)
            m.release(bytes)
        } else if n == 2 && m.get8(name) == 'l' && m.get8(name + 1) == 't' {
            m.pushByte(&out, '<')
        } else if n == 2 && m.get8(name) == 'g' && m.get8(name + 1) == 't' {
            m.pushByte(&out, '>')
        } else if n == 3 && m.get8(name) == 'a' && m.get8(name + 1) == 'm' && m.get8(name + 2) == 'p' {
            m.pushByte(&out, '&')
        } else if n == 4 && m.get8(name) == 'q' && m.get8(name + 1) == 'u' && m.get8(name + 2) == 'o' && m.get8(name + 3) == 't' {
            m.pushByte(&out, '"')
        } else if n == 4 && m.get8(name) == 'a' && m.get8(name + 1) == 'p' && m.get8(name + 2) == 'o' && m.get8(name + 3) == 's' {
            m.pushByte(&out, 39)
        } else {
            var t = m.text()
            m.pushText(&t, "Entity name ")
            quoted(&t, name, n)
            m.pushText(&t, " is not known")
            failLine(k, err, &t)
            m.dispose(&out)
            return 0
        }
        p = q + 1
    }
    if out.address == 0 { return m.dupBytes(0, 0) }
    return m.finish(&out)
}

// ---------------------------------------------------------------------------
// The constructs

fn find(start: usize, end: usize, text: []const u8) -> usize {
    var p = start
    while p + text.length <= end {
        var i: usize = 0
        var same = true
        while i < text.length {
            if m.get8(p + i) != text[i] {
                same = false
                break
            }
            i += 1
        }
        if same { return p }
        p += 1
    }
    return 0
}

fn startsWith(p: usize, end: usize, text: []const u8) -> bool {
    if p + text.length > end { return false }
    var i: usize = 0
    while i < text.length {
        if m.get8(p + i) != text[i] { return false }
        i += 1
    }
    return true
}

fn isNameStart(c: u8) -> bool { return m.isAlpha(c) || c == '_' || c == ':' || c >= 0x80 }
fn isNameChar(c: u8) -> bool { return isNameStart(c) || m.isDigit(c) || c == '-' || c == '.' }

fn callText(k: usize, err: usize, text: usize, length: usize, slot: usize) -> bool {
    const parser = m.getWord(k + K_PARSER)
    const f = m.getWord(parser + slot)
    if f == 0 { return true }
    const cell = m.alloc(8)
    const call: TextFunc = unsafe { @ptrFromInt(TextFunc, f) }
    call(k, text, length, m.getWord(k + K_USER), cell)
    const failed = callbackFailed(k, err, cell)
    m.release(cell)
    return !failed
}

// The end of a tag starting at `p` (its '>'), quotes respected; 0 when
// it has not come yet.
fn tagEnd(p: usize, end: usize) -> usize {
    var q = p + 1
    var quote: u8 = 0
    while q < end {
        const c = m.get8(q)
        if quote != 0 {
            if c == quote { quote = 0 }
        } else if c == 34 || c == 39 {
            quote = c
        } else if c == '>' {
            return q
        }
        q += 1
    }
    return 0
}

fn endTag(k: usize, err: usize, p: usize, close: usize) -> bool {
    var start = p + 2
    var stop = close
    while start < stop && m.isSpace(m.get8(start)) { start += 1 }
    while stop > start && m.isSpace(m.get8(stop - 1)) { stop -= 1 }
    const stack = stackOf(k)
    if stack.*.length == 0 {
        var t = m.text()
        m.pushText(&t, "Element ")
        quoted(&t, start, stop - start)
        m.pushText(&t, " was closed, no element is currently open")
        fail(k, err, ERROR_PARSE, &t)
        return false
    }
    const top = m.wordAt(stack, stack.*.length - 1)
    if m.cLength(top) != stop - start || !m.same(m.bytes(top, stop - start), m.bytes(start, stop - start)) {
        var t = m.text()
        m.pushText(&t, "Element ")
        quoted(&t, start, stop - start)
        m.pushText(&t, " was closed, but the currently open element is ")
        quoted(&t, top, m.cLength(top))
        fail(k, err, ERROR_PARSE, &t)
        return false
    }
    return endCurrent(k, err)
}

// The end of the element open last: its callback, then it is closed.
fn endCurrent(k: usize, err: usize) -> bool {
    const stack = stackOf(k)
    const top = m.wordAt(stack, stack.*.length - 1)
    const parser = m.getWord(k + K_PARSER)
    const f = m.getWord(parser + 8)
    var good = true
    if f != 0 {
        const cell = m.alloc(8)
        const call: EndElement = unsafe { @ptrFromInt(EndElement, f) }
        call(k, top, m.getWord(k + K_USER), cell)
        good = !callbackFailed(k, err, cell)
        m.release(cell)
    }
    stack.*.length -= 1
    m.release(top)
    return good
}

fn startTag(k: usize, err: usize, p: usize, close: usize) -> bool {
    var q = p + 1
    if !isNameStart(m.get8(q)) {
        var t = m.text()
        m.pushText(&t, "“")
        m.pushBytes(&t, q, strings.skipLength(m.get8(q)))
        m.pushText(&t, "” is not a valid character following a “<” character; it may not begin an element name")
        fail(k, err, ERROR_PARSE, &t)
        return false
    }
    while q < close && isNameChar(m.get8(q)) { q += 1 }
    const name = m.dupBytes(p + 1, q - p - 1)
    var names = m.words()
    var valuesList = m.words()
    var good = true
    var selfClosing = false
    while good {
        while q < close && m.isSpace(m.get8(q)) { q += 1 }
        if q >= close { break }
        if m.get8(q) == '/' && q + 1 == close {
            selfClosing = true
            break
        }
        if !isNameStart(m.get8(q)) {
            var t = m.text()
            m.pushText(&t, "Odd character ")
            quoted(&t, q, strings.skipLength(m.get8(q)))
            m.pushText(&t, ", expected a “>” character to end the start tag of element ")
            quoted(&t, name, m.cLength(name))
            fail(k, err, ERROR_PARSE, &t)
            good = false
            break
        }
        const attrStart = q
        while q < close && isNameChar(m.get8(q)) { q += 1 }
        const attrName = m.dupBytes(attrStart, q - attrStart)
        while q < close && m.isSpace(m.get8(q)) { q += 1 }
        if q >= close || m.get8(q) != '=' {
            var t = m.text()
            m.pushText(&t, "Odd character ")
            quoted(&t, q, if q < close { strings.skipLength(m.get8(q)) } else { 1 })
            m.pushText(&t, ", expected a “=” after attribute name ")
            quoted(&t, attrName, m.cLength(attrName))
            m.pushText(&t, " of element ")
            quoted(&t, name, m.cLength(name))
            fail(k, err, ERROR_PARSE, &t)
            m.release(attrName)
            good = false
            break
        }
        q += 1
        while q < close && m.isSpace(m.get8(q)) { q += 1 }
        const quote = m.get8(q)
        if quote != 34 && quote != 39 {
            var t = m.text()
            m.pushText(&t, "Odd character ")
            quoted(&t, q, strings.skipLength(m.get8(q)))
            m.pushText(&t, ", expected an open quote mark after the equals sign when giving value for attribute ")
            quoted(&t, attrName, m.cLength(attrName))
            m.pushText(&t, " of element ")
            quoted(&t, name, m.cLength(name))
            fail(k, err, ERROR_PARSE, &t)
            m.release(attrName)
            good = false
            break
        }
        const valueStart = q + 1
        var valueEnd = valueStart
        while valueEnd < close && m.get8(valueEnd) != quote { valueEnd += 1 }
        const value = unescape(k, err, valueStart, valueEnd - valueStart)
        if value == 0 {
            m.release(attrName)
            good = false
            break
        }
        m.pushWord(&names, attrName)
        m.pushWord(&valuesList, value)
        q = valueEnd + 1
    }
    if good {
        m.pushWord(&names, 0)
        m.pushWord(&valuesList, 0)
        m.pushWord(stackOf(k), name)
        m.putI32(k + K_SEEN, 1)
        const parser = m.getWord(k + K_PARSER)
        const f = m.getWord(parser)
        if f != 0 {
            const cell = m.alloc(8)
            const call: StartElement = unsafe { @ptrFromInt(StartElement, f) }
            call(k, name, names.address, valuesList.address, m.getWord(k + K_USER), cell)
            good = !callbackFailed(k, err, cell)
            m.release(cell)
        }
        if good && selfClosing { good = endCurrent(k, err) }
    } else {
        m.release(name)
    }
    var i: usize = 0
    while i < names.length {
        m.release(m.wordAt(&names, i))
        m.release(m.wordAt(&valuesList, i))
        i += 1
    }
    m.disposeWords(&names)
    m.disposeWords(&valuesList)
    return good
}

// Every complete construct of the buffer; `final` at end_parse.
fn process(k: usize, err: usize, final: bool) -> bool {
    const buffer = bufferOf(k)
    var consumed: usize = 0
    var good = true
    while good {
        const p = buffer.*.address + consumed
        const end = buffer.*.address + buffer.*.length
        if p >= end { break }
        // Each gap between constructs: text inside an element (passed on
        // even when empty, as GLib does, once its '<' has come), white
        // space outside every element.
        if m.getI32(k + K_AT_CONSTRUCT) == 0 {
            var lt = p
            while lt < end && m.get8(lt) != '<' { lt += 1 }
            if stackOf(k).*.length == 0 {
                var q = p
                while q < lt && m.isSpace(m.get8(q)) { q += 1 }
                if q < lt {
                    advance(k, p, q - p)
                    failText(k, err, ERROR_PARSE, "Document must begin with an element (e.g. <book>)")
                    good = false
                    break
                }
                if lt == end {
                    advance(k, p, lt - p)
                    consumed = lt - buffer.*.address
                    break
                }
            } else if lt == end {
                // Text the document ends in is not passed on.
                if final {
                    advance(k, p, lt - p)
                    consumed = lt - buffer.*.address
                }
                break
            } else {
                const text = unescape(k, err, p, lt - p)
                if text == 0 {
                    good = false
                    break
                }
                good = callText(k, err, text, m.cLength(text), 16)
                m.release(text)
            }
            advance(k, p, lt - p)
            consumed = lt - buffer.*.address
            m.putI32(k + K_AT_CONSTRUCT, 1)
            continue
        }
        // A construct starting with '<'.
        var close: usize = 0
        var after: usize = 0
        if startsWith(p, end, "<!--") {
            close = find(p + 4, end, "-->")
            if close == 0 {
                if final { good = unfinished(k, err) }
                break
            }
            after = close + 3
            good = callText(k, err, p, after - p, 24)
        } else if startsWith(p, end, "<![CDATA[") {
            close = find(p + 9, end, "]]>")
            if close == 0 {
                if final { good = unfinished(k, err) }
                break
            }
            after = close + 3
            if (m.getI32(k + K_FLAGS) & TREAT_CDATA_AS_TEXT) != 0 {
                good = callText(k, err, p + 9, close - p - 9, 16)
            } else {
                good = callText(k, err, p, after - p, 24)
            }
        } else if startsWith(p, end, "<?") {
            close = find(p + 2, end, "?>")
            if close == 0 {
                if final { good = unfinished(k, err) }
                break
            }
            after = close + 2
            good = callText(k, err, p, after - p, 24)
        } else if startsWith(p, end, "<!") {
            var depth: usize = 0
            var q = p + 2
            while q < end {
                const c = m.get8(q)
                if c == '[' { depth += 1 }
                if c == ']' && depth > 0 { depth -= 1 }
                if c == '>' && depth == 0 {
                    close = q
                    break
                }
                q += 1
            }
            if close == 0 {
                if final { good = unfinished(k, err) }
                break
            }
            after = close + 1
            good = callText(k, err, p, after - p, 24)
        } else {
            if p + 1 >= end {
                if final { good = unfinished(k, err) }
                break
            }
            close = tagEnd(p, end)
            if close == 0 {
                if final { good = unfinished(k, err) }
                break
            }
            after = close + 1
            if m.get8(p + 1) == '/' {
                // (An error points at the end tag's '>'.)
                advance(k, p, close - p)
                good = endTag(k, err, p, close)
                advance(k, close, 1)
                consumed = after - buffer.*.address
                m.putI32(k + K_AT_CONSTRUCT, 0)
                continue
            } else {
                good = startTag(k, err, p, close)
            }
        }
        advance(k, p, after - p)
        consumed = after - buffer.*.address
        m.putI32(k + K_AT_CONSTRUCT, 0)
    }
    // Keep what is left.
    if consumed > 0 {
        const rest = buffer.*.length - consumed
        m.copy(buffer.*.address, buffer.*.address + consumed, rest)
        buffer.*.length = rest
        m.put8(buffer.*.address + rest, 0)
    }
    return good
}

fn unfinished(k: usize, err: usize) -> bool {
    failText(k, err, ERROR_PARSE, "Document ended unexpectedly just after an open angle bracket “<”")
    return false
}

export fn g_markup_parse_context_parse(k: usize, text: usize, text_len: i64, err: usize) -> i32 {
    if m.getI32(k + K_FAILED) != 0 {
        messages.critical("g_markup_parse_context_parse: assertion 'context->state != STATE_ERROR' failed")
        return 0
    }
    const length = if text_len < 0 { m.cLength(text) } else { @intCast(usize, text_len) }
    if !strings.validate(text, @intCast(i64, length), 0) {
        failText(k, err, ERROR_BAD_UTF8, "Invalid UTF-8 encoded text")
        return 0
    }
    m.pushBytes(bufferOf(k), text, length)
    return if process(k, err, false) { 1 } else { 0 }
}

export fn g_markup_parse_context_end_parse(k: usize, err: usize) -> i32 {
    if m.getI32(k + K_FAILED) != 0 { return 0 }
    if !process(k, err, true) { return 0 }
    if m.getI32(k + K_SEEN) == 0 {
        failText(k, err, ERROR_EMPTY, "Document was empty or contained only whitespace")
        return 0
    }
    const stack = stackOf(k)
    if stack.*.length > 0 {
        const top = m.wordAt(stack, stack.*.length - 1)
        var t = m.text()
        m.pushText(&t, "Document ended unexpectedly with elements still open — ")
        quoted(&t, top, m.cLength(top))
        m.pushText(&t, " was the last element opened")
        fail(k, err, ERROR_PARSE, &t)
        return 0
    }
    return 1
}

// ---------------------------------------------------------------------------
// Escaping

pub fn escapeInto(out: *m.Text, text: usize, length: usize) -> void {
    var p = text
    const end = text + length
    while p < end {
        const c = m.get8(p)
        if c == '&' {
            m.pushText(out, "&amp;")
        } else if c == '<' {
            m.pushText(out, "&lt;")
        } else if c == '>' {
            m.pushText(out, "&gt;")
        } else if c == 39 {
            m.pushText(out, "&apos;")
        } else if c == 34 {
            m.pushText(out, "&quot;")
        } else if (c >= 1 && c <= 8) || c == 11 || c == 12 || (c >= 14 && c <= 31) || c == 127 {
            m.pushText(out, "&#x")
            const buffer = m.alloc(16)
            _ = snprintf(buffer, 16, m.literal("%x"), @intCast(usize, c))
            m.pushC(out, buffer)
            m.release(buffer)
            m.pushByte(out, ';')
        } else if c == 0xc2 && p + 1 < end && ((m.get8(p + 1) >= 0x80 && m.get8(p + 1) <= 0x84) || (m.get8(p + 1) >= 0x86 && m.get8(p + 1) <= 0x9f)) {
            m.pushText(out, "&#x")
            const buffer = m.alloc(16)
            _ = snprintf(buffer, 16, m.literal("%x"), @intCast(usize, m.get8(p + 1)))
            m.pushC(out, buffer)
            m.release(buffer)
            m.pushByte(out, ';')
            p += 1
        } else {
            m.pushByte(out, c)
        }
        p += 1
    }
}

export fn g_markup_escape_text(text: usize, length: i64) -> usize {
    var out = m.text()
    escapeInto(&out, text, if length < 0 { m.cLength(text) } else { @intCast(usize, length) })
    return m.finish(&out)
}

extern("c") fn vsnprintf(buffer: usize, size: usize, format: usize, list: usize) -> i32

// GLib's g_markup_printf_escaped: each conversion formatted on its own,
// the text of %s and %c arguments escaped.
export fn g_markup_printf_escaped(format: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ format, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    var out = m.text()
    var p = format
    const spec = m.alloc(64)
    const buffer = m.alloc(512)
    const one = m.alloc(64)
    while m.get8(p) != 0 {
        const c = m.get8(p)
        if c != '%' {
            m.pushByte(&out, c)
            p += 1
            continue
        }
        if m.get8(p + 1) == '%' {
            m.pushByte(&out, '%')
            p += 2
            continue
        }
        // The conversion: flags, width, precision, length, its letter.
        var q = p + 1
        while m.get8(q) != 0 && !m.isAlpha(m.get8(q)) { q += 1 }
        var longs: usize = 0
        while m.get8(q) == 'l' || m.get8(q) == 'h' || m.get8(q) == 'z' || m.get8(q) == 'j' || m.get8(q) == 't' || m.get8(q) == 'L' || m.get8(q) == 'q' {
            if m.get8(q) == 'l' || m.get8(q) == 'z' || m.get8(q) == 'j' || m.get8(q) == 't' || m.get8(q) == 'q' { longs += 1 }
            q += 1
        }
        const letter = m.get8(q)
        const n = q + 1 - p
        m.copy(spec, p, n)
        m.put8(spec + n, 0)
        // A va_list of the one argument.
        m.zero(one, 64)
        const header = one
        const save = one + 24
        m.put32(header, 40)
        m.put32(header + 4, 48)
        m.putWord(header + 8, 0)
        m.putWord(header + 16, save - 40)
        if letter == 'f' || letter == 'e' || letter == 'g' || letter == 'E' || letter == 'G' || letter == 'a' || letter == 'A' || letter == 'F' {
            m.put32(header, 48)
            m.put32(header + 4, 48)
            m.putWord(header + 16, save - 48)
            m.putF64(save, varargs.nextDouble(list))
        } else {
            m.putWord(save, varargs.nextWord(list))
        }
        _ = vsnprintf(buffer, 512, spec, header)
        if letter == 's' || letter == 'c' {
            escapeInto(&out, buffer, m.cLength(buffer))
        } else {
            m.pushC(&out, buffer)
        }
        p = q + 1
    }
    m.release(spec)
    m.release(buffer)
    m.release(one)
    return m.finish(&out)
}
