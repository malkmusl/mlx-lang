// GDateTime and GTimeZone (gdatetime.h, gtimezone.h): points in time on
// the proleptic Gregorian calendar, years 1 to 9999.
//
// A GDateTime: its references (0), time zone (8), the microseconds since
// the Unix epoch in UTC (16) and the zone's offset from UTC at that time
// in seconds (24). A GTimeZone: its references (0), kind (4: UTC, the
// local zone, a fixed offset), offset (8) and identifier (16). The local
// zone's offset at each moment is the C library's (localtime_r, which
// follows TZ and the system's zone files); other named zones are not
// available (g_time_zone_new_identifier returns NULL for them).
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")

extern("c") fn localtime_r(t: usize, tm: usize) -> usize
extern("c") fn snprintf(buffer: usize, size: usize, format: usize, a: i64, b: i64, c: i64, d: i64) -> i32

const USEC: i64 = 1000000
const DAY_SECONDS: i64 = 86400
// 0001-01-01T00:00:00Z and 9999-12-31T23:59:59Z in Unix seconds.
const MIN_UNIX: i64 = -62135596800
const MAX_UNIX: i64 = 253402300799

const Z_REFS: usize = 0
const Z_KIND: usize = 4
const Z_OFFSET: usize = 8
const Z_IDENTIFIER: usize = 16
const Z_SIZE: usize = 24
const KIND_UTC: u32 = 0
const KIND_LOCAL: u32 = 1
const KIND_OFFSET: u32 = 2

const D_REFS: usize = 0
const D_ZONE: usize = 8
const D_USEC: usize = 16
const D_OFFSET: usize = 24
const D_SIZE: usize = 32

// ---------------------------------------------------------------------------
// Time zones

fn newZone(kind: u32, offset: i32, identifier: usize) -> usize {
    const z = m.alloc(Z_SIZE)
    m.put32(z + Z_REFS, 1)
    m.put32(z + Z_KIND, kind)
    m.putI32(z + Z_OFFSET, offset)
    m.putWord(z + Z_IDENTIFIER, identifier)
    return z
}

fn offsetIdentifier(seconds: i32) -> usize {
    const buffer = m.alloc(32)
    const magnitude = if seconds < 0 { 0 - seconds } else { seconds }
    _ = snprintf(buffer, 32, m.literal("%c%02ld:%02ld:%02ld"), if seconds < 0 { @intCast(i64, 45) } else { @intCast(i64, 43) }, @intCast(i64, magnitude / 3600), @intCast(i64, (magnitude / 60) % 60), @intCast(i64, magnitude % 60))
    return buffer
}

fn localIdentifier() -> usize {
    const tz = sys.getenv(m.literal("TZ"))
    if tz != 0 && m.get8(tz) != 0 { return m.dup(if m.get8(tz) == ':' { tz + 1 } else { tz }) }
    return m.dupSlice("localtime")
}

export fn g_time_zone_new_utc() -> usize { return newZone(KIND_UTC, 0, m.dupSlice("UTC")) }
export fn g_time_zone_new_local() -> usize { return newZone(KIND_LOCAL, 0, localIdentifier()) }
export fn g_time_zone_new_offset(seconds: i32) -> usize { return newZone(KIND_OFFSET, seconds, offsetIdentifier(seconds)) }

fn digits(p: usize, n: usize) -> i32 {
    var value: i32 = 0
    var i: usize = 0
    while i < n {
        const c = m.get8(p + i)
        if !m.isDigit(c) { return -1 }
        value = value * 10 + @intCast(i32, c - 48)
        i += 1
    }
    return value
}

// "UTC", "Z" and "±hh", "±hh:mm", "±hhmm", "±hh:mm:ss"; NULL the local
// zone; the local zone's own TZ value.
export fn g_time_zone_new_identifier(identifier: usize) -> usize {
    if identifier == 0 { return g_time_zone_new_local() }
    if m.cIs(identifier, "UTC") || m.cIs(identifier, "Z") { return g_time_zone_new_utc() }
    const c = m.get8(identifier)
    if c == '+' || c == '-' {
        const n = m.cLength(identifier)
        var hours: i32 = -1
        var minutes: i32 = 0
        var seconds: i32 = 0
        if n == 3 {
            hours = digits(identifier + 1, 2)
        } else if n == 5 {
            hours = digits(identifier + 1, 2)
            minutes = digits(identifier + 3, 2)
        } else if n == 6 && m.get8(identifier + 3) == ':' {
            hours = digits(identifier + 1, 2)
            minutes = digits(identifier + 4, 2)
        } else if n == 9 && m.get8(identifier + 3) == ':' && m.get8(identifier + 6) == ':' {
            hours = digits(identifier + 1, 2)
            minutes = digits(identifier + 4, 2)
            seconds = digits(identifier + 7, 2)
        }
        if hours < 0 || minutes < 0 || seconds < 0 || hours > 24 || minutes > 59 || seconds > 59 { return 0 }
        var total = hours * 3600 + minutes * 60 + seconds
        if c == '-' { total = 0 - total }
        return newZone(KIND_OFFSET, total, m.dup(identifier))
    }
    const tz = sys.getenv(m.literal("TZ"))
    if tz != 0 && (m.cEqual(tz, identifier) || (m.get8(tz) == ':' && m.cEqual(tz + 1, identifier))) { return g_time_zone_new_local() }
    return 0
}

export fn g_time_zone_ref(tz: usize) -> usize {
    threads.refInc(tz + Z_REFS)
    return tz
}

export fn g_time_zone_unref(tz: usize) -> void {
    if threads.refDec(tz + Z_REFS) {
        m.release(m.getWord(tz + Z_IDENTIFIER))
        m.release(tz)
    }
}

export fn g_time_zone_get_identifier(tz: usize) -> usize { return m.getWord(tz + Z_IDENTIFIER) }

// The zone's offset from UTC at Unix time `t` (seconds).
fn offsetAt(tz: usize, t: i64) -> i32 {
    const kind = m.get32(tz + Z_KIND)
    if kind == KIND_UTC { return 0 }
    if kind == KIND_OFFSET { return m.getI32(tz + Z_OFFSET) }
    const cells = m.alloc(72)
    m.putI64(cells, t)
    var offset: i32 = 0
    if localtime_r(cells, cells + 8) != 0 { offset = @intCast(i32, m.getI64(cells + 8 + 40)) }
    m.release(cells)
    return offset
}

// ---------------------------------------------------------------------------
// The calendar (days since 1970-01-01, after Howard Hinnant's algorithms)

fn floorDiv(a: i64, b: i64) -> i64 {
    const q = a / b
    return if (a % b != 0) && ((a < 0) != (b < 0)) { q - 1 } else { q }
}

fn floorMod(a: i64, b: i64) -> i64 { return a - floorDiv(a, b) * b }

fn daysFromCivil(y_: i64, month: i64, day: i64) -> i64 {
    const y = if month <= 2 { y_ - 1 } else { y_ }
    const era = floorDiv(y, 400)
    const yoe = y - era * 400
    const mp = if month > 2 { month - 3 } else { month + 9 }
    const doy = (153 * mp + 2) / 5 + day - 1
    const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

const Civil = struct {
    year: i64
    month: i64
    day: i64
}

fn civilFromDays(z_: i64) -> Civil {
    const z = z_ + 719468
    const era = floorDiv(z, 146097)
    const doe = z - era * 146097
    const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    const doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    const mp = (5 * doy + 2) / 153
    const day = doy - (153 * mp + 2) / 5 + 1
    const month = if mp < 10 { mp + 3 } else { mp - 9 }
    const year = yoe + era * 400 + (if month <= 2 { 1 } else { 0 })
    return Civil.{ .year = year, .month = month, .day = day }
}

fn isLeap(y: i64) -> bool { return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0 }

fn daysInMonth(y: i64, month: i64) -> i64 {
    if month == 2 { return if isLeap(y) { 29 } else { 28 } }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

// ---------------------------------------------------------------------------
// GDateTime

fn make(tz: usize, usec: i64) -> usize {
    const seconds = floorDiv(usec, USEC)
    if seconds < MIN_UNIX || seconds > MAX_UNIX { return 0 }
    const offset = offsetAt(tz, seconds)
    const local = seconds + @intCast(i64, offset)
    if local < MIN_UNIX || local > MAX_UNIX { return 0 }
    const d = m.alloc(D_SIZE)
    m.put32(d + D_REFS, 1)
    m.putWord(d + D_ZONE, g_time_zone_ref(tz))
    m.putI64(d + D_USEC, usec)
    m.putI32(d + D_OFFSET, offset)
    return d
}

fn makeWith(kind: u32, usec: i64) -> usize {
    const tz = if kind == KIND_UTC { g_time_zone_new_utc() } else { g_time_zone_new_local() }
    const d = make(tz, usec)
    g_time_zone_unref(tz)
    return d
}

fn usecOf(d: usize) -> i64 { return m.getI64(d + D_USEC) }
fn localUsec(d: usize) -> i64 { return usecOf(d) + @intCast(i64, m.getI32(d + D_OFFSET)) * USEC }
fn localSeconds(d: usize) -> i64 { return floorDiv(localUsec(d), USEC) }
fn civilOf(d: usize) -> Civil { return civilFromDays(floorDiv(localSeconds(d), DAY_SECONDS)) }
fn secondOfDay(d: usize) -> i64 { return floorMod(localSeconds(d), DAY_SECONDS) }

export fn g_date_time_ref(d: usize) -> usize {
    threads.refInc(d + D_REFS)
    return d
}

export fn g_date_time_unref(d: usize) -> void {
    if threads.refDec(d + D_REFS) {
        g_time_zone_unref(m.getWord(d + D_ZONE))
        m.release(d)
    }
}

export fn g_date_time_new_now(tz: usize) -> usize { return make(tz, sys.realMicroseconds()) }
export fn g_date_time_new_now_local() -> usize { return makeWith(KIND_LOCAL, sys.realMicroseconds()) }
export fn g_date_time_new_now_utc() -> usize { return makeWith(KIND_UTC, sys.realMicroseconds()) }

fn fromUnix(kind: u32, seconds: i64) -> usize {
    if seconds < MIN_UNIX || seconds > MAX_UNIX { return 0 }
    return makeWith(kind, seconds * USEC)
}

export fn g_date_time_new_from_unix_local(t: i64) -> usize { return fromUnix(KIND_LOCAL, t) }
export fn g_date_time_new_from_unix_utc(t: i64) -> usize { return fromUnix(KIND_UTC, t) }
export fn g_date_time_new_from_unix_local_usec(usecs: i64) -> usize { return makeWith(KIND_LOCAL, usecs) }
export fn g_date_time_new_from_unix_utc_usec(usecs: i64) -> usize { return makeWith(KIND_UTC, usecs) }

export fn g_date_time_new(tz: usize, year: i32, month: i32, day: i32, hour: i32, minute: i32, seconds: f64) -> usize {
    if year < 1 || year > 9999 || month < 1 || month > 12 || day < 1 || hour < 0 || hour > 23 || minute < 0 || minute > 59 { return 0 }
    if @intCast(i64, day) > daysInMonth(@intCast(i64, year), @intCast(i64, month)) { return 0 }
    if !(seconds >= 0.0) || seconds >= 60.0 { return 0 }
    const whole = @intFromFloat(i64, seconds)
    var fraction = @intFromFloat(i64, (seconds - @floatFromInt(f64, whole)) * 1000000.0 + 0.5)
    if fraction >= USEC { fraction = USEC - 1 }
    const days = daysFromCivil(@intCast(i64, year), @intCast(i64, month), @intCast(i64, day))
    const wall = days * DAY_SECONDS + @intCast(i64, hour) * 3600 + @intCast(i64, minute) * 60 + whole
    // The offset in force at that wall time (asked twice around a change).
    const first = @intCast(i64, offsetAt(tz, wall))
    var t = wall - first
    const second = @intCast(i64, offsetAt(tz, t))
    if second != first { t = wall - second }
    return make(tz, t * USEC + fraction)
}

export fn g_date_time_new_utc(year: i32, month: i32, day: i32, hour: i32, minute: i32, seconds: f64) -> usize {
    const tz = g_time_zone_new_utc()
    const d = g_date_time_new(tz, year, month, day, hour, minute, seconds)
    g_time_zone_unref(tz)
    return d
}

export fn g_date_time_new_local(year: i32, month: i32, day: i32, hour: i32, minute: i32, seconds: f64) -> usize {
    const tz = g_time_zone_new_local()
    const d = g_date_time_new(tz, year, month, day, hour, minute, seconds)
    g_time_zone_unref(tz)
    return d
}

export fn g_date_time_add(d: usize, timespan: i64) -> usize { return make(m.getWord(d + D_ZONE), usecOf(d) + timespan) }
export fn g_date_time_add_seconds(d: usize, seconds: f64) -> usize { return g_date_time_add(d, @intFromFloat(i64, seconds * 1000000.0)) }
export fn g_date_time_difference(end: usize, begin: usize) -> i64 { return usecOf(end) - usecOf(begin) }

export fn g_date_time_compare(a: usize, b: usize) -> i32 {
    const x = usecOf(a)
    const y = usecOf(b)
    return if x < y { -1 } else if x > y { 1 } else { 0 }
}

export fn g_date_time_equal(a: usize, b: usize) -> i32 { return if usecOf(a) == usecOf(b) { 1 } else { 0 } }

// GLib hashes the instant (microseconds since year 1).
export fn g_date_time_hash(d: usize) -> u32 { return @intCast(u32, @bitCast(u64, usecOf(d) - MIN_UNIX * USEC + 86400 * USEC) & 0xffffffff) }

export fn g_date_time_to_unix(d: usize) -> i64 { return floorDiv(usecOf(d), USEC) }
export fn g_date_time_to_unix_usec(d: usize) -> i64 { return usecOf(d) }
export fn g_date_time_to_utc(d: usize) -> usize { return makeWith(KIND_UTC, usecOf(d)) }
export fn g_date_time_to_local(d: usize) -> usize { return makeWith(KIND_LOCAL, usecOf(d)) }
export fn g_date_time_get_utc_offset(d: usize) -> i64 { return @intCast(i64, m.getI32(d + D_OFFSET)) * USEC }
export fn g_date_time_get_year(d: usize) -> i32 { return @intCast(i32, civilOf(d).year) }
export fn g_date_time_get_month(d: usize) -> i32 { return @intCast(i32, civilOf(d).month) }
export fn g_date_time_get_day_of_month(d: usize) -> i32 { return @intCast(i32, civilOf(d).day) }

// ISO: 1 Monday to 7 Sunday (1970-01-01 was a Thursday).
export fn g_date_time_get_day_of_week(d: usize) -> i32 { return @intCast(i32, floorMod(floorDiv(localSeconds(d), DAY_SECONDS) + 3, 7) + 1) }

export fn g_date_time_get_day_of_year(d: usize) -> i32 {
    const c = civilOf(d)
    return @intCast(i32, floorDiv(localSeconds(d), DAY_SECONDS) - daysFromCivil(c.year, 1, 1) + 1)
}

export fn g_date_time_get_hour(d: usize) -> i32 { return @intCast(i32, secondOfDay(d) / 3600) }
export fn g_date_time_get_minute(d: usize) -> i32 { return @intCast(i32, (secondOfDay(d) / 60) % 60) }
export fn g_date_time_get_second(d: usize) -> i32 { return @intCast(i32, secondOfDay(d) % 60) }
export fn g_date_time_get_microsecond(d: usize) -> i32 { return @intCast(i32, floorMod(usecOf(d), USEC)) }

export fn g_date_time_get_seconds(d: usize) -> f64 {
    return @floatFromInt(f64, g_date_time_get_second(d)) + @floatFromInt(f64, g_date_time_get_microsecond(d)) / 1000000.0
}

// GLib's "%C%y-%m-%dT%H:%M:%S" (".%f" when there are microseconds), then
// "Z" or the offset ("±hh", "±hh:mm").
export fn g_date_time_format_iso8601(d: usize) -> usize {
    const c = civilOf(d)
    var t = m.text()
    const buffer = m.alloc(64)
    _ = snprintf(buffer, 64, m.literal("%04ld-%02ld-%02ld"), c.year, c.month, c.day, 0)
    m.pushC(&t, buffer)
    const s = secondOfDay(d)
    _ = snprintf(buffer, 64, m.literal("T%02ld:%02ld:%02ld"), s / 3600, (s / 60) % 60, s % 60, 0)
    m.pushC(&t, buffer)
    const micro = floorMod(usecOf(d), USEC)
    if micro != 0 {
        _ = snprintf(buffer, 64, m.literal(".%06ld"), micro, 0, 0, 0)
        m.pushC(&t, buffer)
    }
    const offset = @intCast(i64, m.getI32(d + D_OFFSET))
    if offset == 0 {
        m.pushByte(&t, 'Z')
    } else {
        const magnitude = if offset < 0 { 0 - offset } else { offset }
        m.pushByte(&t, if offset < 0 { '-' } else { '+' })
        if (magnitude / 60) % 60 == 0 {
            _ = snprintf(buffer, 64, m.literal("%02ld"), magnitude / 3600, 0, 0, 0)
        } else {
            _ = snprintf(buffer, 64, m.literal("%02ld:%02ld"), magnitude / 3600, (magnitude / 60) % 60, 0, 0)
        }
        m.pushC(&t, buffer)
    }
    m.release(buffer)
    return m.finish(&t)
}
