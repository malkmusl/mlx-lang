// gio/gmemoryinputstream.h
// mlx-glib: GMemoryInputStream, an input stream reading chunks of memory
// (data or GBytes) added to it; pollable, and always ready.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gbytes = @import("./gbytes.mlx")
const giotypes = @import("./giotypes.mlx")

const gpointer = gtypes.gpointer
const gssize = gtypes.gssize
const GInputStream = giotypes.GInputStream

pub const _GMemoryInputStreamPrivate = struct {}
pub const GMemoryInputStreamPrivate = _GMemoryInputStreamPrivate
pub const _GMemoryInputStream = struct {
    parent_instance: GInputStream
    priv: *GMemoryInputStreamPrivate
}
pub const GMemoryInputStream = _GMemoryInputStream

pub const _GMemoryInputStreamClass = struct {
    parent_class: giotypes.GInputStreamClass
    _g_reserved1: gpointer
    _g_reserved2: gpointer
    _g_reserved3: gpointer
    _g_reserved4: gpointer
    _g_reserved5: gpointer
}
pub const GMemoryInputStreamClass = _GMemoryInputStreamClass

pub extern("c") fn g_memory_input_stream_get_type() -> gtype.GType
pub extern("c") fn g_memory_input_stream_new() -> *GInputStream
pub extern("c") fn g_memory_input_stream_new_from_data(data: ?*const anyopaque, len: gssize, destroy: ?gtypes.GDestroyNotify) -> *GInputStream
pub extern("c") fn g_memory_input_stream_new_from_bytes(bytes: *gbytes.GBytes) -> *GInputStream
pub extern("c") fn g_memory_input_stream_add_data(stream: *GMemoryInputStream, data: ?*const anyopaque, len: gssize, destroy: ?gtypes.GDestroyNotify) -> void
pub extern("c") fn g_memory_input_stream_add_bytes(stream: *GMemoryInputStream, bytes: *gbytes.GBytes) -> void

pub const G_TYPE_MEMORY_INPUT_STREAM: gtype.GType = g_memory_input_stream_get_type()
pub fn G_MEMORY_INPUT_STREAM(o: anytype) -> *GMemoryInputStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_MEMORY_INPUT_STREAM, GMemoryInputStream) }
pub fn G_IS_MEMORY_INPUT_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_MEMORY_INPUT_STREAM) }
