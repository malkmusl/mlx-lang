// glib/ggettext.h
// mlx-glib: messages in the user's language. There are no message
// catalogs: every message is the program's own (the singular or the
// plural by the count, a context's prefix taken off), as with GLib when
// no translation is installed.
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const gulong = gtypes.gulong
const gsize = gtypes.gsize
const gint = gtypes.gint

pub extern("c") fn g_strip_context(msgid: [*]const gchar, msgval: [*]const gchar) -> [*]const gchar
pub extern("c") fn g_dgettext(domain: ?[*]const gchar, msgid: [*]const gchar) -> [*]const gchar
pub extern("c") fn g_dcgettext(domain: ?[*]const gchar, msgid: [*]const gchar, category: gint) -> [*]const gchar
pub extern("c") fn g_dngettext(domain: ?[*]const gchar, msgid: [*]const gchar, msgid_plural: [*]const gchar, n: gulong) -> [*]const gchar
pub extern("c") fn g_dpgettext(domain: ?[*]const gchar, msgctxtid: [*]const gchar, msgidoffset: gsize) -> [*]const gchar
pub extern("c") fn g_dpgettext2(domain: ?[*]const gchar, context: [*]const gchar, msgid: [*]const gchar) -> [*]const gchar
