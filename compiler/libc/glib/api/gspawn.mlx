// glib/gspawn.h
// mlx-glib: running programs (fork and exec), waiting for them and
// reading their output.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar
const gint = gtypes.gint
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GError = gerror.GError

pub const GSpawnError = enum(c_int) {
    G_SPAWN_ERROR_FORK,
    G_SPAWN_ERROR_READ,
    G_SPAWN_ERROR_CHDIR,
    G_SPAWN_ERROR_ACCES,
    G_SPAWN_ERROR_PERM,
    G_SPAWN_ERROR_TOO_BIG,
    G_SPAWN_ERROR_NOEXEC,
    G_SPAWN_ERROR_NAMETOOLONG,
    G_SPAWN_ERROR_NOENT,
    G_SPAWN_ERROR_NOMEM,
    G_SPAWN_ERROR_NOTDIR,
    G_SPAWN_ERROR_LOOP,
    G_SPAWN_ERROR_TXTBUSY,
    G_SPAWN_ERROR_IO,
    G_SPAWN_ERROR_NFILE,
    G_SPAWN_ERROR_MFILE,
    G_SPAWN_ERROR_INVAL,
    G_SPAWN_ERROR_ISDIR,
    G_SPAWN_ERROR_LIBBAD,
    G_SPAWN_ERROR_FAILED,
}

pub const G_SPAWN_ERROR_2BIG: c_int = 5

pub const GSpawnFlags = enum(c_int) {
    G_SPAWN_DEFAULT = 0,
    G_SPAWN_LEAVE_DESCRIPTORS_OPEN = 1,
    G_SPAWN_DO_NOT_REAP_CHILD = 2,
    G_SPAWN_SEARCH_PATH = 4,
    G_SPAWN_STDOUT_TO_DEV_NULL = 8,
    G_SPAWN_STDERR_TO_DEV_NULL = 16,
    G_SPAWN_CHILD_INHERITS_STDIN = 32,
    G_SPAWN_FILE_AND_ARGV_ZERO = 64,
    G_SPAWN_SEARCH_PATH_FROM_ENVP = 128,
    G_SPAWN_CLOEXEC_PIPES = 256,
    G_SPAWN_CHILD_INHERITS_STDOUT = 512,
    G_SPAWN_CHILD_INHERITS_STDERR = 1024,
    G_SPAWN_STDIN_FROM_DEV_NULL = 2048,
}

pub const GSpawnChildSetupFunc = fn(user_data: gpointer) -> void

pub const G_SPAWN_ERROR: gquark.GQuark = g_spawn_error_quark()
pub const G_SPAWN_EXIT_ERROR: gquark.GQuark = g_spawn_exit_error_quark()

pub extern("c") fn g_spawn_error_quark() -> gquark.GQuark
pub extern("c") fn g_spawn_exit_error_quark() -> gquark.GQuark
pub extern("c") fn g_spawn_async(working_directory: ?[*]const gchar, argv: [*][*]gchar, envp: ?[*][*]gchar, flags: GSpawnFlags, child_setup: GSpawnChildSetupFunc, user_data: gpointer, child_pid: ?*gtypes.GPid, error_: ?**GError) -> gboolean
pub extern("c") fn g_spawn_async_with_pipes(working_directory: ?[*]const gchar, argv: [*][*]gchar, envp: ?[*][*]gchar, flags: GSpawnFlags, child_setup: GSpawnChildSetupFunc, user_data: gpointer, child_pid: ?*gtypes.GPid, standard_input: ?*gint, standard_output: ?*gint, standard_error: ?*gint, error_: ?**GError) -> gboolean
pub extern("c") fn g_spawn_sync(working_directory: ?[*]const gchar, argv: [*][*]gchar, envp: ?[*][*]gchar, flags: GSpawnFlags, child_setup: GSpawnChildSetupFunc, user_data: gpointer, standard_output: ?*[*]gchar, standard_error: ?*[*]gchar, wait_status: ?*gint, error_: ?**GError) -> gboolean
pub extern("c") fn g_spawn_command_line_sync(command_line: [*]const gchar, standard_output: ?*[*]gchar, standard_error: ?*[*]gchar, wait_status: ?*gint, error_: ?**GError) -> gboolean
pub extern("c") fn g_spawn_command_line_async(command_line: [*]const gchar, error_: ?**GError) -> gboolean
pub extern("c") fn g_spawn_check_wait_status(wait_status: gint, error_: ?**GError) -> gboolean
pub extern("c") fn g_spawn_check_exit_status(wait_status: gint, error_: ?**GError) -> gboolean
pub extern("c") fn g_spawn_close_pid(pid: gtypes.GPid) -> void
