// glib/gslist.h
// mlx-glib: singly linked lists; the empty list is NULL.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gpointer = gtypes.gpointer
const gconstpointer = gtypes.gconstpointer
const gint = gtypes.gint
const guint = gtypes.guint

pub const _GSList = struct {
    data: gpointer
    next: ?*GSList
}
pub const GSList = _GSList

pub extern("c") fn g_slist_alloc() -> *GSList
pub extern("c") fn g_slist_free(list: ?*GSList) -> void
pub extern("c") fn g_slist_free_1(list: ?*GSList) -> void
pub extern("c") fn g_slist_free_full(list: ?*GSList, free_func: gtypes.GDestroyNotify) -> void
pub extern("c") fn g_slist_append(list: ?*GSList, data: gpointer) -> *GSList
pub extern("c") fn g_slist_prepend(list: ?*GSList, data: gpointer) -> *GSList
pub extern("c") fn g_slist_insert(list: ?*GSList, data: gpointer, position: gint) -> *GSList
pub extern("c") fn g_slist_insert_sorted(list: ?*GSList, data: gpointer, func: gtypes.GCompareFunc) -> *GSList
pub extern("c") fn g_slist_concat(list1: ?*GSList, list2: ?*GSList) -> ?*GSList
pub extern("c") fn g_slist_remove(list: ?*GSList, data: gconstpointer) -> ?*GSList
pub extern("c") fn g_slist_remove_all(list: ?*GSList, data: gconstpointer) -> ?*GSList
pub extern("c") fn g_slist_remove_link(list: ?*GSList, link_: ?*GSList) -> ?*GSList
pub extern("c") fn g_slist_delete_link(list: ?*GSList, link_: ?*GSList) -> ?*GSList
pub extern("c") fn g_slist_reverse(list: ?*GSList) -> ?*GSList
pub extern("c") fn g_slist_copy(list: ?*GSList) -> ?*GSList
pub extern("c") fn g_slist_copy_deep(list: ?*GSList, func: gtypes.GCopyFunc, user_data: gpointer) -> ?*GSList
pub extern("c") fn g_slist_nth(list: ?*GSList, n: guint) -> ?*GSList
pub extern("c") fn g_slist_find(list: ?*GSList, data: gconstpointer) -> ?*GSList
pub extern("c") fn g_slist_find_custom(list: ?*GSList, data: gconstpointer, func: gtypes.GCompareFunc) -> ?*GSList
pub extern("c") fn g_slist_position(list: ?*GSList, llink: ?*GSList) -> gint
pub extern("c") fn g_slist_index(list: ?*GSList, data: gconstpointer) -> gint
pub extern("c") fn g_slist_last(list: ?*GSList) -> ?*GSList
pub extern("c") fn g_slist_length(list: ?*GSList) -> guint
pub extern("c") fn g_slist_foreach(list: ?*GSList, func: gtypes.GFunc, user_data: gpointer) -> void
pub extern("c") fn g_slist_sort(list: ?*GSList, compare_func: gtypes.GCompareFunc) -> ?*GSList
pub extern("c") fn g_slist_sort_with_data(list: ?*GSList, compare_func: gtypes.GCompareDataFunc, user_data: gpointer) -> ?*GSList
pub extern("c") fn g_slist_nth_data(list: ?*GSList, n: guint) -> gpointer

pub inline fn g_slist_next(list: ?*GSList) -> ?*GSList { return if list != null { list.*.next } else { null } }
