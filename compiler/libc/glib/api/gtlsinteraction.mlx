// gio/gtlsinteraction.h
// mlx-glib: GTlsInteraction, how a TLS connection asks the user (for a
// password, a certificate). The type is here for what names it (libsoup's
// connections take one).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")

const GTlsInteraction = giotypes.GTlsInteraction

pub extern("c") fn g_tls_interaction_get_type() -> gtype.GType

pub const G_TYPE_TLS_INTERACTION: gtype.GType = g_tls_interaction_get_type()
pub fn G_TLS_INTERACTION(o: anytype) -> *GTlsInteraction { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TLS_INTERACTION, GTlsInteraction) }
pub fn G_IS_TLS_INTERACTION(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TLS_INTERACTION) }
