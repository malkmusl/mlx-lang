// glib/grand.h
// mlx-glib: the global random number generator (the kernel's random
// bytes; GRand objects are not here).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

pub extern("c") fn g_random_set_seed(seed: gtypes.guint32) -> void
pub extern("c") fn g_random_int() -> gtypes.guint32
pub extern("c") fn g_random_int_range(begin: gtypes.gint32, end: gtypes.gint32) -> gtypes.gint32
pub extern("c") fn g_random_double() -> gtypes.gdouble
pub extern("c") fn g_random_double_range(begin: gtypes.gdouble, end: gtypes.gdouble) -> gtypes.gdouble

const c_macros = "#define g_random_boolean() ((g_random_int () & (1 << 15)) != 0)\n"
