// glib/gthread.h
// mlx-glib: threads, locks, conditions, thread-local keys and one-time
// initialization. The locks wait on futexes, as GLib's do on Linux.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gquark = @import("./gquark.mlx")

const gpointer = gtypes.gpointer
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const gsize = gtypes.gsize
const gint64 = gtypes.gint64
const gchar = gtypes.gchar

pub const GThreadFunc = fn(data: gpointer) -> gpointer

pub const GThreadError = enum(c_int) {
    G_THREAD_ERROR_AGAIN,
}

pub const G_THREAD_ERROR: gquark.GQuark = g_thread_error_quark()

pub const _GThread = struct {
    func: GThreadFunc
    data: gpointer
    joinable: gboolean
    priority: c_int
}
pub const GThread = _GThread

pub const _GMutex = union {
    p: gpointer
    i: [2]guint
}
pub const GMutex = _GMutex

pub const _GRWLock = struct {
    p: gpointer
    i: [2]guint
}
pub const GRWLock = _GRWLock

pub const _GCond = struct {
    p: gpointer
    i: [2]guint
}
pub const GCond = _GCond

pub const _GRecMutex = struct {
    p: gpointer
    i: [2]guint
}
pub const GRecMutex = _GRecMutex

pub const _GPrivate = struct {
    p: gpointer
    notify: gtypes.GDestroyNotify
    future: [2]gpointer
}
pub const GPrivate = _GPrivate

pub const GOnceStatus = enum(c_int) {
    G_ONCE_STATUS_NOTCALLED,
    G_ONCE_STATUS_PROGRESS,
    G_ONCE_STATUS_READY,
}

pub const _GOnce = struct {
    status: GOnceStatus
    retval: gpointer
}
pub const GOnce = _GOnce

pub extern("c") fn g_thread_error_quark() -> gquark.GQuark
pub extern("c") fn g_thread_ref(thread: *GThread) -> *GThread
pub extern("c") fn g_thread_unref(thread: *GThread) -> void
pub extern("c") fn g_thread_new(name: ?[*]const gchar, func: GThreadFunc, data: gpointer) -> *GThread
pub extern("c") fn g_thread_try_new(name: ?[*]const gchar, func: GThreadFunc, data: gpointer, error_: ?**gerror.GError) -> ?*GThread
pub extern("c") fn g_thread_self() -> *GThread
pub extern("c") fn g_thread_exit(retval: gpointer) -> void
pub extern("c") fn g_thread_join(thread: *GThread) -> gpointer
pub extern("c") fn g_thread_yield() -> void

pub extern("c") fn g_mutex_init(mutex: *GMutex) -> void
pub extern("c") fn g_mutex_clear(mutex: *GMutex) -> void
pub extern("c") fn g_mutex_lock(mutex: *GMutex) -> void
pub extern("c") fn g_mutex_trylock(mutex: *GMutex) -> gboolean
pub extern("c") fn g_mutex_unlock(mutex: *GMutex) -> void
pub extern("c") fn g_rw_lock_init(rw_lock: *GRWLock) -> void
pub extern("c") fn g_rw_lock_clear(rw_lock: *GRWLock) -> void
pub extern("c") fn g_rw_lock_writer_lock(rw_lock: *GRWLock) -> void
pub extern("c") fn g_rw_lock_writer_trylock(rw_lock: *GRWLock) -> gboolean
pub extern("c") fn g_rw_lock_writer_unlock(rw_lock: *GRWLock) -> void
pub extern("c") fn g_rw_lock_reader_lock(rw_lock: *GRWLock) -> void
pub extern("c") fn g_rw_lock_reader_trylock(rw_lock: *GRWLock) -> gboolean
pub extern("c") fn g_rw_lock_reader_unlock(rw_lock: *GRWLock) -> void
pub extern("c") fn g_rec_mutex_init(rec_mutex: *GRecMutex) -> void
pub extern("c") fn g_rec_mutex_clear(rec_mutex: *GRecMutex) -> void
pub extern("c") fn g_rec_mutex_lock(rec_mutex: *GRecMutex) -> void
pub extern("c") fn g_rec_mutex_trylock(rec_mutex: *GRecMutex) -> gboolean
pub extern("c") fn g_rec_mutex_unlock(rec_mutex: *GRecMutex) -> void
pub extern("c") fn g_cond_init(cond: *GCond) -> void
pub extern("c") fn g_cond_clear(cond: *GCond) -> void
pub extern("c") fn g_cond_wait(cond: *GCond, mutex: *GMutex) -> void
pub extern("c") fn g_cond_signal(cond: *GCond) -> void
pub extern("c") fn g_cond_broadcast(cond: *GCond) -> void
pub extern("c") fn g_cond_wait_until(cond: *GCond, mutex: *GMutex, end_time: gint64) -> gboolean
pub extern("c") fn g_private_get(key: *GPrivate) -> gpointer
pub extern("c") fn g_private_set(key: *GPrivate, value: gpointer) -> void
pub extern("c") fn g_private_replace(key: *GPrivate, value: gpointer) -> void

pub extern("c") fn g_once_impl(once: *GOnce, func: GThreadFunc, arg: gpointer) -> gpointer
pub extern("c") fn g_once_init_enter(location: *anyopaque) -> gboolean
pub extern("c") fn g_once_init_leave(location: *anyopaque, result: gsize) -> void
pub extern("c") fn g_once_init_enter_pointer(location: *anyopaque) -> gboolean
pub extern("c") fn g_once_init_leave_pointer(location: *anyopaque, result: gpointer) -> void
pub extern("c") fn g_get_num_processors() -> guint

pub inline fn g_once(once: *GOnce, func: GThreadFunc, arg: gpointer) -> gpointer { return g_once_impl(once, func, arg) }
