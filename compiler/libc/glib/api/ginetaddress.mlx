// gio/ginetaddress.h
// mlx-glib: GInetAddress, an IPv4 or IPv6 address, from its text or its
// bytes, and the kinds of address it is.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const guint8 = gtypes.guint8
const guint16 = gtypes.guint16
const guint32 = gtypes.guint32
const gint = gtypes.gint
const guint = gtypes.guint
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GObject = gobject.GObject
const GCancellable = giotypes.GCancellable
const GSocketAddress = giotypes.GSocketAddress
const GSocketConnection = giotypes.GSocketConnection
const GSocket = giotypes.GSocket
const GAsyncResult = giotypes.GAsyncResult

pub const _GInetAddress = struct {}
pub const GInetAddress = _GInetAddress

pub extern("c") fn g_inet_address_get_type() -> gtype.GType
pub extern("c") fn g_inet_address_new_from_string(string: [*]const gchar) -> ?*GInetAddress
pub extern("c") fn g_inet_address_new_from_bytes(bytes: [*]const guint8, family: gioenums.GSocketFamily) -> *GInetAddress
pub extern("c") fn g_inet_address_new_loopback(family: gioenums.GSocketFamily) -> *GInetAddress
pub extern("c") fn g_inet_address_new_any(family: gioenums.GSocketFamily) -> *GInetAddress
pub extern("c") fn g_inet_address_equal(address: *GInetAddress, other_address: *GInetAddress) -> gboolean
pub extern("c") fn g_inet_address_to_string(address: *GInetAddress) -> [*]gchar
pub extern("c") fn g_inet_address_to_bytes(address: *GInetAddress) -> [*]const guint8
pub extern("c") fn g_inet_address_get_native_size(address: *GInetAddress) -> gsize
pub extern("c") fn g_inet_address_get_family(address: *GInetAddress) -> gioenums.GSocketFamily
pub extern("c") fn g_inet_address_get_is_any(address: *GInetAddress) -> gboolean
pub extern("c") fn g_inet_address_get_is_loopback(address: *GInetAddress) -> gboolean

pub const G_TYPE_INET_ADDRESS: gtype.GType = g_inet_address_get_type()
pub fn G_INET_ADDRESS(o: anytype) -> *GInetAddress { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_INET_ADDRESS, GInetAddress) }
pub fn G_IS_INET_ADDRESS(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_INET_ADDRESS) }
