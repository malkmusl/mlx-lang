// gio/gapplication.h
// mlx-glib: GApplication as far as a library asks for it: the default
// application (there is none until a program makes one) and the rules of
// application ids.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const GApplication = giotypes.GApplication

pub extern("c") fn g_application_get_type() -> gtype.GType
pub extern("c") fn g_application_id_is_valid(application_id: [*]const gchar) -> gboolean
pub extern("c") fn g_application_new(application_id: ?[*]const gchar, flags: gioenums.GApplicationFlags) -> *GApplication
pub extern("c") fn g_application_get_application_id(application: *GApplication) -> ?[*]const gchar
pub extern("c") fn g_application_set_application_id(application: *GApplication, application_id: ?[*]const gchar) -> void
pub extern("c") fn g_application_get_flags(application: *GApplication) -> gioenums.GApplicationFlags
pub extern("c") fn g_application_get_default() -> ?*GApplication
pub extern("c") fn g_application_set_default(application: ?*GApplication) -> void

pub const G_TYPE_APPLICATION: gtype.GType = g_application_get_type()
pub fn G_APPLICATION(o: anytype) -> *GApplication { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_APPLICATION, GApplication) }
pub fn G_IS_APPLICATION(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_APPLICATION) }
