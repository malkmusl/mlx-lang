// gio/giostream.h
// mlx-glib: what GIOStream adds to gsocket.h's: its class as GIO lays it
// out, its input and output streams, closing asynchronously, the pending
// mark; and GSimpleIOStream (gsimpleiostream.h), the pair of a given input
// and output stream.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const giotypes = @import("./giotypes.mlx")
const gsocket = @import("./gsocket.mlx")

const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GIOStream = giotypes.GIOStream
const GInputStream = giotypes.GInputStream
const GOutputStream = giotypes.GOutputStream
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback

pub const _GIOStreamClass = struct {
    parent_class: gobject.GObjectClass
    get_input_stream: ?fn(stream: *GIOStream) -> *GInputStream
    get_output_stream: ?fn(stream: *GIOStream) -> *GOutputStream
    close_fn: ?fn(stream: *GIOStream, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
    close_async: ?fn(stream: *GIOStream, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    close_finish: ?fn(stream: *GIOStream, result: *GAsyncResult, error_: ?**GError) -> gboolean
    _g_reserved1: gpointer
    _g_reserved2: gpointer
    _g_reserved3: gpointer
    _g_reserved4: gpointer
    _g_reserved5: gpointer
    _g_reserved6: gpointer
    _g_reserved7: gpointer
    _g_reserved8: gpointer
    _g_reserved9: gpointer
    _g_reserved10: gpointer
}
pub const GIOStreamClass = _GIOStreamClass

pub extern("c") fn g_io_stream_get_input_stream(stream: *GIOStream) -> *GInputStream
pub extern("c") fn g_io_stream_get_output_stream(stream: *GIOStream) -> *GOutputStream
pub extern("c") fn g_io_stream_close_async(stream: *GIOStream, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_io_stream_close_finish(stream: *GIOStream, result: *GAsyncResult, error_: ?**GError) -> gboolean
pub extern("c") fn g_io_stream_set_pending(stream: *GIOStream, error_: ?**GError) -> gboolean
pub extern("c") fn g_io_stream_clear_pending(stream: *GIOStream) -> void

pub const _GSimpleIOStream = struct {}
pub const GSimpleIOStream = _GSimpleIOStream

pub extern("c") fn g_simple_io_stream_get_type() -> gtype.GType
pub extern("c") fn g_simple_io_stream_new(input_stream: *GInputStream, output_stream: *GOutputStream) -> *GIOStream

pub const G_TYPE_SIMPLE_IO_STREAM: gtype.GType = g_simple_io_stream_get_type()
