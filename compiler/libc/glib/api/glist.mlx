// glib/glist.h
// mlx-glib: doubly linked lists; the empty list is NULL.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gpointer = gtypes.gpointer
const gconstpointer = gtypes.gconstpointer
const gint = gtypes.gint
const guint = gtypes.guint

pub const _GList = struct {
    data: gpointer
    next: ?*GList
    prev: ?*GList
}
pub const GList = _GList

pub extern("c") fn g_list_alloc() -> *GList
pub extern("c") fn g_list_free(list: ?*GList) -> void
pub extern("c") fn g_list_free_1(list: ?*GList) -> void
pub extern("c") fn g_list_free_full(list: ?*GList, free_func: gtypes.GDestroyNotify) -> void
pub extern("c") fn g_list_append(list: ?*GList, data: gpointer) -> *GList
pub extern("c") fn g_list_prepend(list: ?*GList, data: gpointer) -> *GList
pub extern("c") fn g_list_insert(list: ?*GList, data: gpointer, position: gint) -> *GList
pub extern("c") fn g_list_insert_sorted(list: ?*GList, data: gpointer, func: gtypes.GCompareFunc) -> *GList
pub extern("c") fn g_list_insert_before(list: ?*GList, sibling: ?*GList, data: gpointer) -> *GList
pub extern("c") fn g_list_concat(list1: ?*GList, list2: ?*GList) -> ?*GList
pub extern("c") fn g_list_remove(list: ?*GList, data: gconstpointer) -> ?*GList
pub extern("c") fn g_list_remove_all(list: ?*GList, data: gconstpointer) -> ?*GList
pub extern("c") fn g_list_remove_link(list: ?*GList, llink: ?*GList) -> ?*GList
pub extern("c") fn g_list_delete_link(list: ?*GList, link_: ?*GList) -> ?*GList
pub extern("c") fn g_list_reverse(list: ?*GList) -> ?*GList
pub extern("c") fn g_list_copy(list: ?*GList) -> ?*GList
pub extern("c") fn g_list_copy_deep(list: ?*GList, func: gtypes.GCopyFunc, user_data: gpointer) -> ?*GList
pub extern("c") fn g_list_nth(list: ?*GList, n: guint) -> ?*GList
pub extern("c") fn g_list_nth_prev(list: ?*GList, n: guint) -> ?*GList
pub extern("c") fn g_list_find(list: ?*GList, data: gconstpointer) -> ?*GList
pub extern("c") fn g_list_find_custom(list: ?*GList, data: gconstpointer, func: gtypes.GCompareFunc) -> ?*GList
pub extern("c") fn g_list_position(list: ?*GList, llink: ?*GList) -> gint
pub extern("c") fn g_list_index(list: ?*GList, data: gconstpointer) -> gint
pub extern("c") fn g_list_last(list: ?*GList) -> ?*GList
pub extern("c") fn g_list_first(list: ?*GList) -> ?*GList
pub extern("c") fn g_list_length(list: ?*GList) -> guint
pub extern("c") fn g_list_foreach(list: ?*GList, func: gtypes.GFunc, user_data: gpointer) -> void
pub extern("c") fn g_list_sort(list: ?*GList, compare_func: gtypes.GCompareFunc) -> ?*GList
pub extern("c") fn g_list_sort_with_data(list: ?*GList, compare_func: gtypes.GCompareDataFunc, user_data: gpointer) -> ?*GList
pub extern("c") fn g_list_nth_data(list: ?*GList, n: guint) -> gpointer

pub inline fn g_list_previous(list: ?*GList) -> ?*GList { return if list != null { list.*.prev } else { null } }
pub inline fn g_list_next(list: ?*GList) -> ?*GList { return if list != null { list.*.next } else { null } }
