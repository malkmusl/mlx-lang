// glib/gstrfuncs.h
// mlx-glib: strings and NULL-ended arrays of them (strv). Every string
// returned to be freed comes from g_malloc; g_free releases it, g_strfreev
// an array of them.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const gint = gtypes.gint
const guint = gtypes.guint
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const gboolean = gtypes.gboolean

pub const GStrv = [*][*]gchar

pub extern("c") fn g_strdup(text: ?[*]const gchar) -> [*]gchar
pub extern("c") fn g_strndup(text: ?[*]const gchar, n: gsize) -> [*]gchar
pub extern("c") fn g_strnfill(length: gsize, fill_char: gchar) -> [*]gchar
pub extern("c") fn g_strdup_printf(format: [*]const gchar, args: gtypes.c_varargs) -> [*]gchar
pub extern("c") fn g_strdup_vprintf(format: [*]const gchar, args: gtypes.c_va_list) -> [*]gchar
pub extern("c") fn g_strconcat(string1: [*]const gchar, args: gtypes.c_varargs) -> [*]gchar
pub extern("c") fn g_strjoin(separator: ?[*]const gchar, args: gtypes.c_varargs) -> [*]gchar
pub extern("c") fn g_strjoinv(separator: ?[*]const gchar, str_array: [*][*]gchar) -> [*]gchar
pub extern("c") fn g_strsplit(text: [*]const gchar, delimiter: [*]const gchar, max_tokens: gint) -> [*][*]gchar
pub extern("c") fn g_strsplit_set(text: [*]const gchar, delimiters: [*]const gchar, max_tokens: gint) -> [*][*]gchar
pub extern("c") fn g_strfreev(str_array: ?[*][*]gchar) -> void
pub extern("c") fn g_strdupv(str_array: ?[*][*]gchar) -> [*][*]gchar
pub extern("c") fn g_strv_length(str_array: [*][*]gchar) -> guint
pub extern("c") fn g_strv_contains(strv: [*]const [*]const gchar, text: [*]const gchar) -> gboolean
pub extern("c") fn g_strv_equal(strv1: [*]const [*]const gchar, strv2: [*]const [*]const gchar) -> gboolean
pub extern("c") fn g_strlcpy(dest: [*]gchar, src: [*]const gchar, dest_size: gsize) -> gsize
pub extern("c") fn g_strlcat(dest: [*]gchar, src: [*]const gchar, dest_size: gsize) -> gsize
pub extern("c") fn g_str_has_prefix(text: [*]const gchar, prefix: [*]const gchar) -> gboolean
pub extern("c") fn g_str_has_suffix(text: [*]const gchar, suffix: [*]const gchar) -> gboolean
pub extern("c") fn g_str_is_ascii(text: [*]const gchar) -> gboolean
pub extern("c") fn g_strcmp0(str1: ?[*]const c_char, str2: ?[*]const c_char) -> c_int
pub extern("c") fn g_strstr_len(haystack: [*]const gchar, haystack_len: gssize, needle: [*]const gchar) -> ?[*]gchar
pub extern("c") fn g_strrstr(haystack: [*]const gchar, needle: [*]const gchar) -> ?[*]gchar
pub extern("c") fn g_strchug(text: [*]gchar) -> [*]gchar
pub extern("c") fn g_strchomp(text: [*]gchar) -> [*]gchar
pub extern("c") fn g_strreverse(text: [*]gchar) -> [*]gchar
pub extern("c") fn g_strdelimit(text: [*]gchar, delimiters: ?[*]const gchar, new_delimiter: gchar) -> [*]gchar
pub extern("c") fn g_strcanon(text: [*]gchar, valid_chars: [*]const gchar, substitutor: gchar) -> [*]gchar
pub extern("c") fn g_strescape(source: [*]const gchar, exceptions: ?[*]const gchar) -> [*]gchar
pub extern("c") fn g_strcompress(source: [*]const gchar) -> [*]gchar
pub extern("c") fn g_strerror(errnum: gint) -> [*]const gchar
pub extern("c") fn g_snprintf(text: [*]gchar, n: gtypes.gulong, format: [*]const gchar, args: gtypes.c_varargs) -> gint
pub extern("c") fn g_vsnprintf(text: [*]gchar, n: gtypes.gulong, format: [*]const gchar, args: gtypes.c_va_list) -> gint
pub extern("c") fn g_vasprintf(text: *[*]gchar, format: [*]const gchar, args: gtypes.c_va_list) -> gint
pub extern("c") fn g_ascii_strcasecmp(s1: [*]const gchar, s2: [*]const gchar) -> gint
pub extern("c") fn g_ascii_strncasecmp(s1: [*]const gchar, s2: [*]const gchar, n: gsize) -> gint
pub extern("c") fn g_ascii_strdown(text: [*]const gchar, len: gssize) -> [*]gchar
pub extern("c") fn g_ascii_strup(text: [*]const gchar, len: gssize) -> [*]gchar
pub extern("c") fn g_ascii_tolower(c: gchar) -> gchar
pub extern("c") fn g_ascii_toupper(c: gchar) -> gchar
pub extern("c") fn g_ascii_digit_value(c: gchar) -> gint
pub extern("c") fn g_ascii_xdigit_value(c: gchar) -> gint
pub extern("c") fn g_ascii_strtoll(nptr: [*]const gchar, endptr: ?*[*]gchar, base: guint) -> gtypes.gint64
pub extern("c") fn g_ascii_strtoull(nptr: [*]const gchar, endptr: ?*[*]gchar, base: guint) -> gtypes.guint64
pub extern("c") fn g_ascii_strtod(nptr: [*]const gchar, endptr: ?*[*]gchar) -> gtypes.gdouble
pub extern("c") fn g_ascii_dtostr(buffer: [*]gchar, buf_len: gint, d: gtypes.gdouble) -> [*]gchar
pub extern("c") fn g_ascii_formatd(buffer: [*]gchar, buf_len: gint, format: [*]const gchar, d: gtypes.gdouble) -> [*]gchar

pub const G_ASCII_DTOSTR_BUF_SIZE: c_int = 39
pub const G_STR_DELIMITERS: []const u8 = "_-|> <."

// The leading and trailing white space of `text` removed, in place.
pub inline fn g_strstrip(text: [*]gchar) -> [*]gchar { return g_strchomp(g_strchug(text)) }

// ASCII's classes of a byte, as GLib's g_ascii_is... macros.
pub inline fn g_ascii_isdigit(c: gchar) -> bool { return c >= '0' && c <= '9' }
pub inline fn g_ascii_isxdigit(c: gchar) -> bool { return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') }
pub inline fn g_ascii_isupper(c: gchar) -> bool { return c >= 'A' && c <= 'Z' }
pub inline fn g_ascii_islower(c: gchar) -> bool { return c >= 'a' && c <= 'z' }
pub inline fn g_ascii_isalpha(c: gchar) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') }
pub inline fn g_ascii_isalnum(c: gchar) -> bool { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') }
pub inline fn g_ascii_isspace(c: gchar) -> bool { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == 12 }
pub inline fn g_ascii_ispunct(c: gchar) -> bool { return (c >= '!' && c <= '/') || (c >= ':' && c <= '@') || (c >= '[' && c <= '`') || (c >= '{' && c <= '~') }
pub inline fn g_ascii_iscntrl(c: gchar) -> bool { return (c >= 0 && c < ' ') || c == 127 }
pub inline fn g_ascii_isprint(c: gchar) -> bool { return c >= ' ' && c <= '~' }
pub inline fn g_ascii_isgraph(c: gchar) -> bool { return c > ' ' && c <= '~' }
