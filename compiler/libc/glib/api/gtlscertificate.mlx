// gio/gtlscertificate.h
// mlx-glib: GTlsCertificate, an X.509 certificate (its DER and PEM forms,
// the certificate that issued it, a private key or its PKCS #11 URI),
// as the TLS backend's certificate type makes it, with the fields of its
// X.509 structure (validity, names as GnuTLS prints them, DNS names,
// addresses), verified against a CA certificate as GnuTLS verifies it.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")
const gsocketconnectable = @import("./gsocketconnectable.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gssize = gtypes.gssize
const GError = gerror.GError
const GTlsCertificate = giotypes.GTlsCertificate

pub const _GTlsCertificateClass = struct {
    parent_class: gobject.GObjectClass
    verify: fn(cert: *GTlsCertificate, identity: ?*gsocketconnectable.GSocketConnectable, trusted_ca: ?*GTlsCertificate) -> gioenums.GTlsCertificateFlags
    padding: [8]gpointer
}
pub const GTlsCertificateClass = _GTlsCertificateClass

pub extern("c") fn g_tls_certificate_get_type() -> gtype.GType
pub extern("c") fn g_tls_certificate_new_from_pem(data: [*]const gchar, length: gssize, error_: ?**GError) -> ?*GTlsCertificate
pub extern("c") fn g_tls_certificate_get_issuer(cert: *GTlsCertificate) -> ?*GTlsCertificate
pub extern("c") fn g_tls_certificate_is_same(cert_one: *GTlsCertificate, cert_two: *GTlsCertificate) -> gboolean
pub extern("c") fn g_tls_certificate_verify(cert: *GTlsCertificate, identity: ?*gsocketconnectable.GSocketConnectable, trusted_ca: ?*GTlsCertificate) -> gioenums.GTlsCertificateFlags

pub const G_TYPE_TLS_CERTIFICATE: gtype.GType = g_tls_certificate_get_type()
pub fn G_TLS_CERTIFICATE(o: anytype) -> *GTlsCertificate { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TLS_CERTIFICATE, GTlsCertificate) }
pub fn G_IS_TLS_CERTIFICATE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TLS_CERTIFICATE) }
