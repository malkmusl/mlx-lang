// glib/ghash.h
// mlx-glib: hash tables of pointers (keys and values are what C gives;
// the hash and equality functions say what a key means), and the hash
// functions of strings, integers and pointers.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const glist = @import("./glist.mlx")

const gpointer = gtypes.gpointer
const gconstpointer = gtypes.gconstpointer
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const gint = gtypes.gint

pub const _GHashTable = struct {}
pub const GHashTable = _GHashTable

pub const GHRFunc = fn(key: gpointer, value: gpointer, user_data: gpointer) -> gboolean

// An iterator over a table (its fields are the library's own).
pub const _GHashTableIter = struct {
    dummy1: gpointer
    dummy2: gpointer
    dummy3: gpointer
    dummy4: c_int
    dummy5: gboolean
    dummy6: gpointer
}
pub const GHashTableIter = _GHashTableIter

pub extern("c") fn g_hash_table_new(hash_func: gtypes.GHashFunc, key_equal_func: gtypes.GEqualFunc) -> *GHashTable
pub extern("c") fn g_hash_table_new_full(hash_func: gtypes.GHashFunc, key_equal_func: gtypes.GEqualFunc, key_destroy_func: gtypes.GDestroyNotify, value_destroy_func: gtypes.GDestroyNotify) -> *GHashTable
pub extern("c") fn g_hash_table_new_similar(other_hash_table: *GHashTable) -> *GHashTable
pub extern("c") fn g_hash_table_destroy(hash_table: *GHashTable) -> void
pub extern("c") fn g_hash_table_insert(hash_table: *GHashTable, key: gpointer, value: gpointer) -> gboolean
pub extern("c") fn g_hash_table_replace(hash_table: *GHashTable, key: gpointer, value: gpointer) -> gboolean
pub extern("c") fn g_hash_table_add(hash_table: *GHashTable, key: gpointer) -> gboolean
pub extern("c") fn g_hash_table_remove(hash_table: *GHashTable, key: gconstpointer) -> gboolean
pub extern("c") fn g_hash_table_remove_all(hash_table: *GHashTable) -> void
pub extern("c") fn g_hash_table_steal(hash_table: *GHashTable, key: gconstpointer) -> gboolean
pub extern("c") fn g_hash_table_steal_extended(hash_table: *GHashTable, lookup_key: gconstpointer, stolen_key: ?*gpointer, stolen_value: ?*gpointer) -> gboolean
pub extern("c") fn g_hash_table_steal_all(hash_table: *GHashTable) -> void
pub extern("c") fn g_hash_table_lookup(hash_table: *GHashTable, key: gconstpointer) -> gpointer
pub extern("c") fn g_hash_table_contains(hash_table: *GHashTable, key: gconstpointer) -> gboolean
pub extern("c") fn g_hash_table_lookup_extended(hash_table: *GHashTable, lookup_key: gconstpointer, orig_key: ?*gpointer, value: ?*gpointer) -> gboolean
pub extern("c") fn g_hash_table_foreach(hash_table: *GHashTable, func: gtypes.GHFunc, user_data: gpointer) -> void
pub extern("c") fn g_hash_table_find(hash_table: *GHashTable, predicate: GHRFunc, user_data: gpointer) -> gpointer
pub extern("c") fn g_hash_table_foreach_remove(hash_table: *GHashTable, func: GHRFunc, user_data: gpointer) -> guint
pub extern("c") fn g_hash_table_foreach_steal(hash_table: *GHashTable, func: GHRFunc, user_data: gpointer) -> guint
pub extern("c") fn g_hash_table_size(hash_table: *GHashTable) -> guint
pub extern("c") fn g_hash_table_get_keys(hash_table: *GHashTable) -> ?*glist.GList
pub extern("c") fn g_hash_table_get_values(hash_table: *GHashTable) -> ?*glist.GList
pub extern("c") fn g_hash_table_get_keys_as_array(hash_table: *GHashTable, length: ?*guint) -> *gpointer
pub extern("c") fn g_hash_table_iter_init(iter: *GHashTableIter, hash_table: *GHashTable) -> void
pub extern("c") fn g_hash_table_iter_next(iter: *GHashTableIter, key: ?*gpointer, value: ?*gpointer) -> gboolean
pub extern("c") fn g_hash_table_iter_get_hash_table(iter: *GHashTableIter) -> *GHashTable
pub extern("c") fn g_hash_table_iter_remove(iter: *GHashTableIter) -> void
pub extern("c") fn g_hash_table_iter_replace(iter: *GHashTableIter, value: gpointer) -> void
pub extern("c") fn g_hash_table_iter_steal(iter: *GHashTableIter) -> void
pub extern("c") fn g_hash_table_ref(hash_table: *GHashTable) -> *GHashTable
pub extern("c") fn g_hash_table_unref(hash_table: *GHashTable) -> void

pub extern("c") fn g_str_equal(v1: gconstpointer, v2: gconstpointer) -> gboolean
pub extern("c") fn g_str_hash(v: gconstpointer) -> guint
pub extern("c") fn g_int_equal(v1: gconstpointer, v2: gconstpointer) -> gboolean
pub extern("c") fn g_int_hash(v: gconstpointer) -> guint
pub extern("c") fn g_int64_equal(v1: gconstpointer, v2: gconstpointer) -> gboolean
pub extern("c") fn g_int64_hash(v: gconstpointer) -> guint
pub extern("c") fn g_double_equal(v1: gconstpointer, v2: gconstpointer) -> gboolean
pub extern("c") fn g_double_hash(v: gconstpointer) -> guint
pub extern("c") fn g_direct_hash(v: gconstpointer) -> guint
pub extern("c") fn g_direct_equal(v1: gconstpointer, v2: gconstpointer) -> gboolean
