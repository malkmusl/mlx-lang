// glib/gvarianttype.h
// mlx-glib: the types of GVariant values, written as GVariant's type
// strings ("i", "as", "(sv)", "a{sv}" ...); a GVariantType is its string.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gsize = gtypes.gsize
const guint = gtypes.guint
const gconstpointer = gtypes.gconstpointer

pub const _GVariantType = struct {}
pub const GVariantType = _GVariantType

// The type of the type string `type_string`.
pub fn G_VARIANT_TYPE(type_string: anytype) -> *const GVariantType { return @ptrCast(*const GVariantType, type_string) }

pub const G_VARIANT_TYPE_BOOLEAN: *const GVariantType = @ptrCast(*const GVariantType, "b")
pub const G_VARIANT_TYPE_BYTE: *const GVariantType = @ptrCast(*const GVariantType, "y")
pub const G_VARIANT_TYPE_INT16: *const GVariantType = @ptrCast(*const GVariantType, "n")
pub const G_VARIANT_TYPE_UINT16: *const GVariantType = @ptrCast(*const GVariantType, "q")
pub const G_VARIANT_TYPE_INT32: *const GVariantType = @ptrCast(*const GVariantType, "i")
pub const G_VARIANT_TYPE_UINT32: *const GVariantType = @ptrCast(*const GVariantType, "u")
pub const G_VARIANT_TYPE_INT64: *const GVariantType = @ptrCast(*const GVariantType, "x")
pub const G_VARIANT_TYPE_UINT64: *const GVariantType = @ptrCast(*const GVariantType, "t")
pub const G_VARIANT_TYPE_DOUBLE: *const GVariantType = @ptrCast(*const GVariantType, "d")
pub const G_VARIANT_TYPE_STRING: *const GVariantType = @ptrCast(*const GVariantType, "s")
pub const G_VARIANT_TYPE_OBJECT_PATH: *const GVariantType = @ptrCast(*const GVariantType, "o")
pub const G_VARIANT_TYPE_SIGNATURE: *const GVariantType = @ptrCast(*const GVariantType, "g")
pub const G_VARIANT_TYPE_VARIANT: *const GVariantType = @ptrCast(*const GVariantType, "v")
pub const G_VARIANT_TYPE_HANDLE: *const GVariantType = @ptrCast(*const GVariantType, "h")
pub const G_VARIANT_TYPE_UNIT: *const GVariantType = @ptrCast(*const GVariantType, "()")
pub const G_VARIANT_TYPE_ANY: *const GVariantType = @ptrCast(*const GVariantType, "*")
pub const G_VARIANT_TYPE_BASIC: *const GVariantType = @ptrCast(*const GVariantType, "?")
pub const G_VARIANT_TYPE_MAYBE: *const GVariantType = @ptrCast(*const GVariantType, "m*")
pub const G_VARIANT_TYPE_ARRAY: *const GVariantType = @ptrCast(*const GVariantType, "a*")
pub const G_VARIANT_TYPE_TUPLE: *const GVariantType = @ptrCast(*const GVariantType, "r")
pub const G_VARIANT_TYPE_DICT_ENTRY: *const GVariantType = @ptrCast(*const GVariantType, "{?*}")
pub const G_VARIANT_TYPE_DICTIONARY: *const GVariantType = @ptrCast(*const GVariantType, "a{?*}")
pub const G_VARIANT_TYPE_STRING_ARRAY: *const GVariantType = @ptrCast(*const GVariantType, "as")
pub const G_VARIANT_TYPE_OBJECT_PATH_ARRAY: *const GVariantType = @ptrCast(*const GVariantType, "ao")
pub const G_VARIANT_TYPE_BYTESTRING: *const GVariantType = @ptrCast(*const GVariantType, "ay")
pub const G_VARIANT_TYPE_BYTESTRING_ARRAY: *const GVariantType = @ptrCast(*const GVariantType, "aay")
pub const G_VARIANT_TYPE_VARDICT: *const GVariantType = @ptrCast(*const GVariantType, "a{sv}")

pub extern("c") fn g_variant_type_string_is_valid(type_string: [*]const gchar) -> gboolean
pub extern("c") fn g_variant_type_string_scan(text: [*]const gchar, limit: ?[*]const gchar, endptr: ?*[*]const gchar) -> gboolean
pub extern("c") fn g_variant_type_free(type_: ?*GVariantType) -> void
pub extern("c") fn g_variant_type_copy(type_: *const GVariantType) -> *GVariantType
pub extern("c") fn g_variant_type_new(type_string: [*]const gchar) -> *GVariantType
pub extern("c") fn g_variant_type_get_string_length(type_: *const GVariantType) -> gsize
pub extern("c") fn g_variant_type_peek_string(type_: *const GVariantType) -> [*]const gchar
pub extern("c") fn g_variant_type_dup_string(type_: *const GVariantType) -> [*]gchar
pub extern("c") fn g_variant_type_is_definite(type_: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_type_is_container(type_: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_type_is_basic(type_: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_type_is_maybe(type_: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_type_is_array(type_: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_type_is_tuple(type_: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_type_is_dict_entry(type_: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_type_is_variant(type_: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_type_hash(type_: gconstpointer) -> guint
pub extern("c") fn g_variant_type_equal(type1: gconstpointer, type2: gconstpointer) -> gboolean
pub extern("c") fn g_variant_type_is_subtype_of(type_: *const GVariantType, supertype: *const GVariantType) -> gboolean
pub extern("c") fn g_variant_type_element(type_: *const GVariantType) -> *const GVariantType
pub extern("c") fn g_variant_type_first(type_: *const GVariantType) -> ?*const GVariantType
pub extern("c") fn g_variant_type_next(type_: *const GVariantType) -> ?*const GVariantType
pub extern("c") fn g_variant_type_n_items(type_: *const GVariantType) -> gsize
pub extern("c") fn g_variant_type_key(type_: *const GVariantType) -> *const GVariantType
pub extern("c") fn g_variant_type_value(type_: *const GVariantType) -> *const GVariantType
pub extern("c") fn g_variant_type_new_array(element: *const GVariantType) -> *GVariantType
pub extern("c") fn g_variant_type_new_maybe(element: *const GVariantType) -> *GVariantType
pub extern("c") fn g_variant_type_new_tuple(items: [*]const *const GVariantType, length: gtypes.gint) -> *GVariantType
pub extern("c") fn g_variant_type_new_dict_entry(key: *const GVariantType, value: *const GVariantType) -> *GVariantType
