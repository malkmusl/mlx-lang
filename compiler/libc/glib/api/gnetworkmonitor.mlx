// gio/gnetworkmonitor.h
// mlx-glib: GNetworkMonitor, whether the network can be reached. The
// default monitor is GIO's base one without netlink: the network is
// always available, with full connectivity and not metered, so
// "network-changed" is never emitted by it; can_reach resolves the
// name and says it can be reached when it resolves. GNetworkConnectivity
// is GIO's (gioenums.h there).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")
const gsocketconnectable = @import("./gsocketconnectable.mlx")

const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback
const GSocketConnectable = gsocketconnectable.GSocketConnectable

pub const GNetworkConnectivity = enum(c_int) {
    G_NETWORK_CONNECTIVITY_LOCAL = 1,
    G_NETWORK_CONNECTIVITY_LIMITED = 2,
    G_NETWORK_CONNECTIVITY_PORTAL = 3,
    G_NETWORK_CONNECTIVITY_FULL = 4,
}

pub const _GNetworkMonitor = struct {}
pub const GNetworkMonitor = _GNetworkMonitor

pub const _GNetworkMonitorInterface = struct {
    g_iface: gtype.GTypeInterface
    network_changed: ?fn(monitor: *GNetworkMonitor, network_available: gboolean) -> void
    can_reach: ?fn(monitor: *GNetworkMonitor, connectable: *GSocketConnectable, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
    can_reach_async: ?fn(monitor: *GNetworkMonitor, connectable: *GSocketConnectable, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    can_reach_finish: ?fn(monitor: *GNetworkMonitor, result: *GAsyncResult, error_: ?**GError) -> gboolean
}
pub const GNetworkMonitorInterface = _GNetworkMonitorInterface

pub extern("c") fn g_network_monitor_get_type() -> gtype.GType
pub extern("c") fn g_network_connectivity_get_type() -> gtype.GType
pub extern("c") fn g_network_monitor_get_default() -> *GNetworkMonitor
pub extern("c") fn g_network_monitor_get_network_available(monitor: *GNetworkMonitor) -> gboolean
pub extern("c") fn g_network_monitor_get_network_metered(monitor: *GNetworkMonitor) -> gboolean
pub extern("c") fn g_network_monitor_get_connectivity(monitor: *GNetworkMonitor) -> GNetworkConnectivity
pub extern("c") fn g_network_monitor_can_reach(monitor: *GNetworkMonitor, connectable: *GSocketConnectable, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_network_monitor_can_reach_async(monitor: *GNetworkMonitor, connectable: *GSocketConnectable, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_network_monitor_can_reach_finish(monitor: *GNetworkMonitor, result: *GAsyncResult, error_: ?**GError) -> gboolean

pub const G_TYPE_NETWORK_MONITOR: gtype.GType = g_network_monitor_get_type()
pub const G_TYPE_NETWORK_CONNECTIVITY: gtype.GType = g_network_connectivity_get_type()
pub fn G_NETWORK_MONITOR(o: anytype) -> *GNetworkMonitor { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_NETWORK_MONITOR, GNetworkMonitor) }
pub fn G_IS_NETWORK_MONITOR(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_NETWORK_MONITOR) }
pub fn G_NETWORK_MONITOR_GET_INTERFACE(o: anytype) -> *GNetworkMonitorInterface { return gtype.G_TYPE_INSTANCE_GET_INTERFACE(o, G_TYPE_NETWORK_MONITOR, GNetworkMonitorInterface) }
