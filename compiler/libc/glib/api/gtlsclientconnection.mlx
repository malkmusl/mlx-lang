// gio/gtlsclientconnection.h
// mlx-glib: GTlsClientConnection, the client side of a TLS connection:
// the backend's (std.tls) over a base GIOStream, its server identity
// (the name sent by SNI and the chain checked against). Client
// certificates are not sent (an empty one answers a server that asks).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const glist = @import("./glist.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")
const gsocketconnectable = @import("./gsocketconnectable.mlx")

const gboolean = gtypes.gboolean
const GError = gerror.GError
const GIOStream = giotypes.GIOStream
const GTlsClientConnection = giotypes.GTlsClientConnection
const GSocketConnectable = gsocketconnectable.GSocketConnectable

pub extern("c") fn g_tls_client_connection_get_type() -> gtype.GType
pub extern("c") fn g_tls_client_connection_new(base_io_stream: *GIOStream, server_identity: ?*GSocketConnectable, error_: ?**GError) -> ?*GIOStream
pub extern("c") fn g_tls_client_connection_get_server_identity(conn: *GTlsClientConnection) -> ?*GSocketConnectable
pub extern("c") fn g_tls_client_connection_set_server_identity(conn: *GTlsClientConnection, identity: *GSocketConnectable) -> void
pub extern("c") fn g_tls_client_connection_get_validation_flags(conn: *GTlsClientConnection) -> gioenums.GTlsCertificateFlags
pub extern("c") fn g_tls_client_connection_set_validation_flags(conn: *GTlsClientConnection, flags: gioenums.GTlsCertificateFlags) -> void
pub extern("c") fn g_tls_client_connection_get_use_ssl3(conn: *GTlsClientConnection) -> gboolean
pub extern("c") fn g_tls_client_connection_set_use_ssl3(conn: *GTlsClientConnection, use_ssl3: gboolean) -> void
pub extern("c") fn g_tls_client_connection_get_accepted_cas(conn: *GTlsClientConnection) -> ?*glist.GList
pub extern("c") fn g_tls_client_connection_copy_session_state(conn: *GTlsClientConnection, source: *GTlsClientConnection) -> void

pub const G_TYPE_TLS_CLIENT_CONNECTION: gtype.GType = g_tls_client_connection_get_type()
pub fn G_TLS_CLIENT_CONNECTION(o: anytype) -> *GTlsClientConnection { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TLS_CLIENT_CONNECTION, GTlsClientConnection) }
pub fn G_IS_TLS_CLIENT_CONNECTION(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TLS_CLIENT_CONNECTION) }
