// glib/gmain.h
// mlx-glib: the main loop. A context (GMainContext) holds sources
// (GSource): each is ready when its ready time has come, when one of its
// descriptors polled ready, or when its prepare or check function says
// so; the context prepares, polls, checks and dispatches them by
// priority, on the thread that acquired it. Timeouts, idles and
// descriptor sources are sources of the library's own.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gslist = @import("./gslist.mlx")
const gpoll = @import("./gpoll.mlx")

const gpointer = gtypes.gpointer
const gboolean = gtypes.gboolean
const gint = gtypes.gint
const guint = gtypes.guint
const gint64 = gtypes.gint64
const gchar = gtypes.gchar
const GPollFD = gpoll.GPollFD

pub const GIOCondition = enum(c_int) {
    G_IO_IN = 1,
    G_IO_OUT = 4,
    G_IO_PRI = 2,
    G_IO_ERR = 8,
    G_IO_HUP = 16,
    G_IO_NVAL = 32,
}

pub const GMainContextFlags = enum(c_int) {
    G_MAIN_CONTEXT_FLAGS_NONE = 0,
    G_MAIN_CONTEXT_FLAGS_OWNERLESS_POLLING = 1,
}

pub const _GMainContext = struct {}
pub const GMainContext = _GMainContext
pub const _GMainLoop = struct {}
pub const GMainLoop = _GMainLoop
pub const _GSourcePrivate = struct {}
pub const GSourcePrivate = _GSourcePrivate

pub const GSourceFunc = fn(user_data: gpointer) -> gboolean
pub const GSourceOnceFunc = fn(user_data: gpointer) -> void
pub const GChildWatchFunc = fn(pid: gtypes.GPid, wait_status: gint, user_data: gpointer) -> void
pub const GSourceDisposeFunc = fn(source: *GSource) -> void
pub const GSourceDummyMarshal = fn() -> void
pub const GClearHandleFunc = fn(handle_id: guint) -> void

pub const _GSourceCallbackFuncs = struct {
    ref: fn(cb_data: gpointer) -> void
    unref: fn(cb_data: gpointer) -> void
    get: fn(cb_data: gpointer, source: *GSource, func: *GSourceFunc, data: *gpointer) -> void
}
pub const GSourceCallbackFuncs = _GSourceCallbackFuncs

pub const _GSourceFuncs = struct {
    prepare: fn(source: *GSource, timeout_: *gint) -> gboolean
    check: fn(source: *GSource) -> gboolean
    dispatch: fn(source: *GSource, callback: GSourceFunc, user_data: gpointer) -> gboolean
    finalize: fn(source: *GSource) -> void
    closure_callback: GSourceFunc
    closure_marshal: GSourceDummyMarshal
}
pub const GSourceFuncs = _GSourceFuncs

pub const _GSource = struct {
    callback_data: gpointer
    callback_funcs: *GSourceCallbackFuncs
    source_funcs: *const GSourceFuncs
    ref_count: guint
    context: *GMainContext
    priority: gint
    flags: guint
    source_id: guint
    poll_fds: *gslist.GSList
    prev: *GSource
    next: *GSource
    name: [*]c_char
    priv: *GSourcePrivate
}
pub const GSource = _GSource

pub const G_PRIORITY_HIGH: c_int = -100
pub const G_PRIORITY_DEFAULT: c_int = 0
pub const G_PRIORITY_HIGH_IDLE: c_int = 100
pub const G_PRIORITY_DEFAULT_IDLE: c_int = 200
pub const G_PRIORITY_LOW: c_int = 300
pub const G_SOURCE_REMOVE: c_int = 0
pub const G_SOURCE_CONTINUE: c_int = 1

pub extern("c") fn g_main_context_new() -> *GMainContext
pub extern("c") fn g_main_context_new_with_flags(flags: GMainContextFlags) -> *GMainContext
pub extern("c") fn g_main_context_ref(context: *GMainContext) -> *GMainContext
pub extern("c") fn g_main_context_unref(context: *GMainContext) -> void
pub extern("c") fn g_main_context_default() -> *GMainContext
pub extern("c") fn g_main_context_iteration(context: ?*GMainContext, may_block: gboolean) -> gboolean
pub extern("c") fn g_main_context_pending(context: ?*GMainContext) -> gboolean
pub extern("c") fn g_main_context_find_source_by_id(context: ?*GMainContext, source_id: guint) -> ?*GSource
pub extern("c") fn g_main_context_find_source_by_user_data(context: ?*GMainContext, user_data: gpointer) -> ?*GSource
pub extern("c") fn g_main_context_find_source_by_funcs_user_data(context: ?*GMainContext, funcs: *GSourceFuncs, user_data: gpointer) -> ?*GSource
pub extern("c") fn g_main_context_wakeup(context: ?*GMainContext) -> void
pub extern("c") fn g_main_context_acquire(context: ?*GMainContext) -> gboolean
pub extern("c") fn g_main_context_release(context: ?*GMainContext) -> void
pub extern("c") fn g_main_context_is_owner(context: ?*GMainContext) -> gboolean
pub extern("c") fn g_main_context_prepare(context: ?*GMainContext, priority: ?*gint) -> gboolean
pub extern("c") fn g_main_context_query(context: ?*GMainContext, max_priority: gint, timeout_: *gint, fds: ?*GPollFD, n_fds: gint) -> gint
pub extern("c") fn g_main_context_check(context: ?*GMainContext, max_priority: gint, fds: ?*GPollFD, n_fds: gint) -> gboolean
pub extern("c") fn g_main_context_dispatch(context: ?*GMainContext) -> void
pub extern("c") fn g_main_context_set_poll_func(context: ?*GMainContext, func: gpoll.GPollFunc) -> void
pub extern("c") fn g_main_context_get_poll_func(context: ?*GMainContext) -> gpoll.GPollFunc
pub extern("c") fn g_main_context_add_poll(context: ?*GMainContext, fd: *GPollFD, priority: gint) -> void
pub extern("c") fn g_main_context_remove_poll(context: ?*GMainContext, fd: *GPollFD) -> void
pub extern("c") fn g_main_depth() -> gint
pub extern("c") fn g_main_current_source() -> ?*GSource
pub extern("c") fn g_main_context_push_thread_default(context: ?*GMainContext) -> void
pub extern("c") fn g_main_context_pop_thread_default(context: ?*GMainContext) -> void
pub extern("c") fn g_main_context_get_thread_default() -> ?*GMainContext
pub extern("c") fn g_main_context_ref_thread_default() -> *GMainContext
pub extern("c") fn g_main_context_invoke(context: ?*GMainContext, function: GSourceFunc, data: gpointer) -> void
pub extern("c") fn g_main_context_invoke_full(context: ?*GMainContext, priority: gint, function: GSourceFunc, data: gpointer, notify: gtypes.GDestroyNotify) -> void

pub extern("c") fn g_main_loop_new(context: ?*GMainContext, is_running: gboolean) -> *GMainLoop
pub extern("c") fn g_main_loop_run(main_loop: *GMainLoop) -> void
pub extern("c") fn g_main_loop_quit(main_loop: *GMainLoop) -> void
pub extern("c") fn g_main_loop_ref(main_loop: *GMainLoop) -> *GMainLoop
pub extern("c") fn g_main_loop_unref(main_loop: *GMainLoop) -> void
pub extern("c") fn g_main_loop_is_running(main_loop: *GMainLoop) -> gboolean
pub extern("c") fn g_main_loop_get_context(main_loop: *GMainLoop) -> *GMainContext

pub extern("c") fn g_source_new(source_funcs: *GSourceFuncs, struct_size: guint) -> *GSource
pub extern("c") fn g_source_set_dispose_function(source: *GSource, dispose: GSourceDisposeFunc) -> void
pub extern("c") fn g_source_ref(source: *GSource) -> *GSource
pub extern("c") fn g_source_unref(source: *GSource) -> void
pub extern("c") fn g_source_attach(source: *GSource, context: ?*GMainContext) -> guint
pub extern("c") fn g_source_destroy(source: *GSource) -> void
pub extern("c") fn g_source_set_priority(source: *GSource, priority: gint) -> void
pub extern("c") fn g_source_get_priority(source: *GSource) -> gint
pub extern("c") fn g_source_set_can_recurse(source: *GSource, can_recurse: gboolean) -> void
pub extern("c") fn g_source_get_can_recurse(source: *GSource) -> gboolean
pub extern("c") fn g_source_get_id(source: *GSource) -> guint
pub extern("c") fn g_source_get_context(source: *GSource) -> ?*GMainContext
pub extern("c") fn g_source_set_callback(source: *GSource, func: GSourceFunc, data: gpointer, notify: gtypes.GDestroyNotify) -> void
pub extern("c") fn g_source_set_funcs(source: *GSource, funcs: *GSourceFuncs) -> void
pub extern("c") fn g_source_is_destroyed(source: *GSource) -> gboolean
pub extern("c") fn g_source_set_name(source: *GSource, name: ?[*]const c_char) -> void
pub extern("c") fn g_source_set_static_name(source: *GSource, name: ?[*]const c_char) -> void
pub extern("c") fn g_source_get_name(source: *GSource) -> ?[*]const c_char
pub extern("c") fn g_source_set_name_by_id(tag: guint, name: ?[*]const c_char) -> void
pub extern("c") fn g_source_set_ready_time(source: *GSource, ready_time: gint64) -> void
pub extern("c") fn g_source_get_ready_time(source: *GSource) -> gint64
pub extern("c") fn g_source_add_unix_fd(source: *GSource, fd: gint, events: GIOCondition) -> gpointer
pub extern("c") fn g_source_modify_unix_fd(source: *GSource, tag: gpointer, new_events: GIOCondition) -> void
pub extern("c") fn g_source_remove_unix_fd(source: *GSource, tag: gpointer) -> void
pub extern("c") fn g_source_query_unix_fd(source: *GSource, tag: gpointer) -> GIOCondition
pub extern("c") fn g_source_set_callback_indirect(source: *GSource, callback_data: gpointer, callback_funcs: *GSourceCallbackFuncs) -> void
pub extern("c") fn g_source_add_poll(source: *GSource, fd: *GPollFD) -> void
pub extern("c") fn g_source_remove_poll(source: *GSource, fd: *GPollFD) -> void
pub extern("c") fn g_source_add_child_source(source: *GSource, child_source: *GSource) -> void
pub extern("c") fn g_source_remove_child_source(source: *GSource, child_source: *GSource) -> void
pub extern("c") fn g_source_get_time(source: *GSource) -> gint64
pub extern("c") fn g_source_remove(tag: guint) -> gboolean
pub extern("c") fn g_source_remove_by_user_data(user_data: gpointer) -> gboolean
pub extern("c") fn g_source_remove_by_funcs_user_data(funcs: *GSourceFuncs, user_data: gpointer) -> gboolean
pub extern("c") fn g_clear_handle_id(tag_ptr: *guint, clear_func: GClearHandleFunc) -> void

pub extern("c") fn g_idle_source_new() -> *GSource
pub extern("c") fn g_child_watch_source_new(pid: gtypes.GPid) -> *GSource
pub extern("c") fn g_timeout_source_new(interval: guint) -> *GSource
pub extern("c") fn g_timeout_source_new_seconds(interval: guint) -> *GSource
pub extern("c") fn g_timeout_add_full(priority: gint, interval: guint, function: GSourceFunc, data: gpointer, notify: gtypes.GDestroyNotify) -> guint
pub extern("c") fn g_timeout_add(interval: guint, function: GSourceFunc, data: gpointer) -> guint
