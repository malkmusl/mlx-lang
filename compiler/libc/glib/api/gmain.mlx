pub extern("c") fn g_timeout_add_seconds_full(priority: gint, interval: guint, function: GSourceFunc, data: gpointer, notify: gtypes.GDestroyNotify) -> guint
pub extern("c") fn g_timeout_add_seconds(interval: guint, function: GSourceFunc, data: gpointer) -> guint
pub extern("c") fn g_child_watch_add_full(priority: gint, pid: gtypes.GPid, function: GChildWatchFunc, data: gpointer, notify: gtypes.GDestroyNotify) -> guint
pub extern("c") fn g_child_watch_add(pid: gtypes.GPid, function: GChildWatchFunc, data: gpointer) -> guint
