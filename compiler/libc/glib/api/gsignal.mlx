// gobject/gsignal.h
// mlx-glib: signals: named events of a type, emitted on an instance with
// arguments, calling the class's handler and the connected ones in
// GLib's order (run-first class handler, handlers, run-last class
// handler, after-handlers), with details ("notify::name") and blocking.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gtype = @import("./gtype.mlx")
const gvalue = @import("./gvalue.mlx")
const gclosure = @import("./gclosure.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const gulong = gtypes.gulong
const gpointer = gtypes.gpointer
const GType = gtype.GType
const GQuark = gquark.GQuark
const GValue = gvalue.GValue
const GClosure = gclosure.GClosure
const GCallback = gclosure.GCallback

pub const GSignalFlags = enum(c_int) {
    G_SIGNAL_RUN_FIRST = 1,
    G_SIGNAL_RUN_LAST = 2,
    G_SIGNAL_RUN_CLEANUP = 4,
    G_SIGNAL_NO_RECURSE = 8,
    G_SIGNAL_DETAILED = 16,
    G_SIGNAL_ACTION = 32,
    G_SIGNAL_NO_HOOKS = 64,
    G_SIGNAL_MUST_COLLECT = 128,
    G_SIGNAL_DEPRECATED = 256,
    G_SIGNAL_ACCUMULATOR_FIRST_RUN = 131072,
}

pub const G_SIGNAL_FLAGS_MASK: c_int = 511

pub const GConnectFlags = enum(c_int) {
    G_CONNECT_DEFAULT = 0,
    G_CONNECT_AFTER = 1,
    G_CONNECT_SWAPPED = 2,
}

pub const GSignalMatchType = enum(c_int) {
    G_SIGNAL_MATCH_ID = 1,
    G_SIGNAL_MATCH_DETAIL = 2,
    G_SIGNAL_MATCH_CLOSURE = 4,
    G_SIGNAL_MATCH_FUNC = 8,
    G_SIGNAL_MATCH_DATA = 16,
    G_SIGNAL_MATCH_UNBLOCKED = 32,
}

pub const G_SIGNAL_MATCH_MASK: c_int = 63

pub const _GSignalInvocationHint = struct {
    signal_id: guint
    detail: GQuark
    run_type: GSignalFlags
}
pub const GSignalInvocationHint = _GSignalInvocationHint

pub const _GSignalQuery = struct {
    signal_id: guint
    signal_name: [*]const gchar
    itype: GType
    signal_flags: GSignalFlags
    return_type: GType
    n_params: guint
    param_types: *const GType
}
pub const GSignalQuery = _GSignalQuery

pub const GSignalCMarshaller = gclosure.GClosureMarshal
pub const GSignalCVaMarshaller = gclosure.GVaClosureMarshal
pub const GSignalEmissionHook = fn(ihint: *GSignalInvocationHint, n_param_values: guint, param_values: *const GValue, data: gpointer) -> gboolean
pub const GSignalAccumulator = fn(ihint: *GSignalInvocationHint, return_accu: *GValue, handler_return: *const GValue, data: gpointer) -> gboolean

pub extern("c") fn g_signal_newv(signal_name: [*]const gchar, itype: GType, signal_flags: GSignalFlags, class_closure: ?*GClosure, accumulator: GSignalAccumulator, accu_data: gpointer, c_marshaller: GSignalCMarshaller, return_type: GType, n_params: guint, param_types: ?*GType) -> guint
pub extern("c") fn g_signal_new_valist(signal_name: [*]const gchar, itype: GType, signal_flags: GSignalFlags, class_closure: ?*GClosure, accumulator: GSignalAccumulator, accu_data: gpointer, c_marshaller: GSignalCMarshaller, return_type: GType, n_params: guint, args: gtypes.c_va_list) -> guint
pub extern("c") fn g_signal_new(signal_name: [*]const gchar, itype: GType, signal_flags: GSignalFlags, class_offset: guint, accumulator: GSignalAccumulator, accu_data: gpointer, c_marshaller: GSignalCMarshaller, return_type: GType, n_params: guint, args: gtypes.c_varargs) -> guint
pub extern("c") fn g_signal_new_class_handler(signal_name: [*]const gchar, itype: GType, signal_flags: GSignalFlags, class_handler: GCallback, accumulator: GSignalAccumulator, accu_data: gpointer, c_marshaller: GSignalCMarshaller, return_type: GType, n_params: guint, args: gtypes.c_varargs) -> guint
pub extern("c") fn g_signal_emitv(instance_and_params: *const GValue, signal_id: guint, detail: GQuark, return_value: ?*GValue) -> void
pub extern("c") fn g_signal_emit_valist(instance: gpointer, signal_id: guint, detail: GQuark, var_args: gtypes.c_va_list) -> void
pub extern("c") fn g_signal_emit(instance: gpointer, signal_id: guint, detail: GQuark, args: gtypes.c_varargs) -> void
pub extern("c") fn g_signal_emit_by_name(instance: gpointer, detailed_signal: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_signal_lookup(name: [*]const gchar, itype: GType) -> guint
pub extern("c") fn g_signal_name(signal_id: guint) -> ?[*]const gchar
pub extern("c") fn g_signal_query(signal_id: guint, query: *GSignalQuery) -> void
pub extern("c") fn g_signal_list_ids(itype: GType, n_ids: *guint) -> *guint
pub extern("c") fn g_signal_is_valid_name(name: [*]const gchar) -> gboolean
pub extern("c") fn g_signal_parse_name(detailed_signal: [*]const gchar, itype: GType, signal_id_p: *guint, detail_p: *GQuark, force_detail_quark: gboolean) -> gboolean
pub extern("c") fn g_signal_get_invocation_hint(instance: gpointer) -> ?*GSignalInvocationHint
pub extern("c") fn g_signal_stop_emission(instance: gpointer, signal_id: guint, detail: GQuark) -> void
pub extern("c") fn g_signal_stop_emission_by_name(instance: gpointer, detailed_signal: [*]const gchar) -> void
pub extern("c") fn g_signal_add_emission_hook(signal_id: guint, detail: GQuark, hook_func: GSignalEmissionHook, hook_data: gpointer, data_destroy: gtypes.GDestroyNotify) -> gulong
pub extern("c") fn g_signal_remove_emission_hook(signal_id: guint, hook_id: gulong) -> void
pub extern("c") fn g_signal_has_handler_pending(instance: gpointer, signal_id: guint, detail: GQuark, may_be_blocked: gboolean) -> gboolean
pub extern("c") fn g_signal_connect_closure_by_id(instance: gpointer, signal_id: guint, detail: GQuark, closure: *GClosure, after: gboolean) -> gulong
pub extern("c") fn g_signal_connect_closure(instance: gpointer, detailed_signal: [*]const gchar, closure: *GClosure, after: gboolean) -> gulong
pub extern("c") fn g_signal_connect_data(instance: gpointer, detailed_signal: [*]const gchar, c_handler: GCallback, data: gpointer, destroy_data: gclosure.GClosureNotify, connect_flags: GConnectFlags) -> gulong
pub extern("c") fn g_signal_handler_block(instance: gpointer, handler_id: gulong) -> void
pub extern("c") fn g_signal_handler_unblock(instance: gpointer, handler_id: gulong) -> void
pub extern("c") fn g_signal_handler_disconnect(instance: gpointer, handler_id: gulong) -> void
pub extern("c") fn g_signal_handler_is_connected(instance: gpointer, handler_id: gulong) -> gboolean
pub extern("c") fn g_signal_handler_find(instance: gpointer, mask: GSignalMatchType, signal_id: guint, detail: GQuark, closure: ?*GClosure, func: gpointer, data: gpointer) -> gulong
pub extern("c") fn g_signal_handlers_block_matched(instance: gpointer, mask: GSignalMatchType, signal_id: guint, detail: GQuark, closure: ?*GClosure, func: gpointer, data: gpointer) -> guint
pub extern("c") fn g_signal_handlers_unblock_matched(instance: gpointer, mask: GSignalMatchType, signal_id: guint, detail: GQuark, closure: ?*GClosure, func: gpointer, data: gpointer) -> guint
pub extern("c") fn g_signal_handlers_disconnect_matched(instance: gpointer, mask: GSignalMatchType, signal_id: guint, detail: GQuark, closure: ?*GClosure, func: gpointer, data: gpointer) -> guint
pub extern("c") fn g_clear_signal_handler(handler_id_ptr: *gulong, instance: gpointer) -> void
pub extern("c") fn g_signal_override_class_closure(signal_id: guint, instance_type: GType, class_closure: *GClosure) -> void
pub extern("c") fn g_signal_chain_from_overridden(instance_and_params: *const GValue, return_value: ?*GValue) -> void
pub extern("c") fn g_signal_handlers_destroy(instance: gpointer) -> void
pub extern("c") fn g_signal_accumulator_true_handled(ihint: *GSignalInvocationHint, return_accu: *GValue, handler_return: *const GValue, dummy: gpointer) -> gboolean
pub extern("c") fn g_signal_accumulator_first_wins(ihint: *GSignalInvocationHint, return_accu: *GValue, handler_return: *const GValue, dummy: gpointer) -> gboolean

// Connecting handlers (GLib's macros over g_signal_connect_data).
pub inline fn g_signal_connect(instance: anytype, detailed_signal: anytype, c_handler: anytype, data: anytype) -> gulong { return g_signal_connect_data(instance, detailed_signal, c_handler, data, null, @intCast(GConnectFlags, 0)) }
pub inline fn g_signal_connect_after(instance: anytype, detailed_signal: anytype, c_handler: anytype, data: anytype) -> gulong { return g_signal_connect_data(instance, detailed_signal, c_handler, data, null, @intCast(GConnectFlags, 1)) }
pub inline fn g_signal_connect_swapped(instance: anytype, detailed_signal: anytype, c_handler: anytype, data: anytype) -> gulong { return g_signal_connect_data(instance, detailed_signal, c_handler, data, null, @intCast(GConnectFlags, 2)) }
pub inline fn g_signal_handlers_disconnect_by_func(instance: anytype, func: anytype, data: anytype) -> guint { return g_signal_handlers_disconnect_matched(instance, @intCast(GSignalMatchType, 24), 0, 0, null, @ptrCast(gpointer, func), data) }
pub inline fn g_signal_handlers_disconnect_by_data(instance: anytype, data: anytype) -> guint { return g_signal_handlers_disconnect_matched(instance, @intCast(GSignalMatchType, 16), 0, 0, null, null, data) }
pub inline fn g_signal_handlers_block_by_func(instance: anytype, func: anytype, data: anytype) -> guint { return g_signal_handlers_block_matched(instance, @intCast(GSignalMatchType, 24), 0, 0, null, @ptrCast(gpointer, func), data) }
pub inline fn g_signal_handlers_unblock_by_func(instance: anytype, func: anytype, data: anytype) -> guint { return g_signal_handlers_unblock_matched(instance, @intCast(GSignalMatchType, 24), 0, 0, null, @ptrCast(gpointer, func), data) }

// The marshallers GLib generates for common signatures: here each is the
// generic one, which reads the signal's parameter types.
pub extern("c") fn g_cclosure_marshal_VOID__VOID(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__BOOLEAN(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__INT(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__UINT(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__ENUM(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__FLAGS(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__STRING(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__PARAM(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__BOXED(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__POINTER(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__OBJECT(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__VARIANT(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_VOID__UINT_POINTER(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_BOOLEAN__FLAGS(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_BOOLEAN__BOXED_BOXED(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_STRING__OBJECT_POINTER(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
