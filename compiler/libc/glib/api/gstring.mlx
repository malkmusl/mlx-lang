// glib/gstring.h
// mlx-glib: strings that grow (GString), their bytes NUL-ended.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const gsize = gtypes.gsize
const gssize = gtypes.gssize

pub const _GString = struct {
    str: [*]gchar
    len: gsize
    allocated_len: gsize
}
pub const GString = _GString

pub extern("c") fn g_string_new(init: ?[*]const gchar) -> *GString
pub extern("c") fn g_string_new_take(init: ?[*]gchar) -> *GString
pub extern("c") fn g_string_new_len(init: ?[*]const gchar, len: gssize) -> *GString
pub extern("c") fn g_string_sized_new(dfl_size: gsize) -> *GString
pub extern("c") fn g_string_free(text: *GString, free_segment: gtypes.gboolean) -> ?[*]gchar
pub extern("c") fn g_string_free_and_steal(text: *GString) -> [*]gchar
pub extern("c") fn g_string_equal(v: *const GString, v2: *const GString) -> gtypes.gboolean
pub extern("c") fn g_string_hash(text: *const GString) -> gtypes.guint
pub extern("c") fn g_string_assign(text: *GString, rval: [*]const gchar) -> *GString
pub extern("c") fn g_string_truncate(text: *GString, len: gsize) -> *GString
pub extern("c") fn g_string_set_size(text: *GString, len: gsize) -> *GString
pub extern("c") fn g_string_insert_len(text: *GString, pos: gssize, val: [*]const gchar, len: gssize) -> *GString
pub extern("c") fn g_string_append(text: *GString, val: [*]const gchar) -> *GString
pub extern("c") fn g_string_append_len(text: *GString, val: [*]const gchar, len: gssize) -> *GString
pub extern("c") fn g_string_append_c(text: *GString, c: gchar) -> *GString
pub extern("c") fn g_string_append_unichar(text: *GString, wc: gtypes.gunichar) -> *GString
pub extern("c") fn g_string_append_uri_escaped(text: *GString, unescaped: [*]const gchar, reserved_chars_allowed: ?[*]const gchar, allow_utf8: gtypes.gboolean) -> *GString
pub extern("c") fn g_string_prepend(text: *GString, val: [*]const gchar) -> *GString
pub extern("c") fn g_string_prepend_c(text: *GString, c: gchar) -> *GString
pub extern("c") fn g_string_prepend_len(text: *GString, val: [*]const gchar, len: gssize) -> *GString
pub extern("c") fn g_string_insert(text: *GString, pos: gssize, val: [*]const gchar) -> *GString
pub extern("c") fn g_string_insert_c(text: *GString, pos: gssize, c: gchar) -> *GString
pub extern("c") fn g_string_erase(text: *GString, pos: gssize, len: gssize) -> *GString
pub extern("c") fn g_string_replace(text: *GString, find: [*]const gchar, replace: [*]const gchar, limit: gtypes.guint) -> gtypes.guint
pub extern("c") fn g_string_ascii_down(text: *GString) -> *GString
pub extern("c") fn g_string_ascii_up(text: *GString) -> *GString
pub extern("c") fn g_string_vprintf(text: *GString, format: [*]const gchar, args: gtypes.c_va_list) -> void
pub extern("c") fn g_string_printf(text: *GString, format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_string_append_vprintf(text: *GString, format: [*]const gchar, args: gtypes.c_va_list) -> void
pub extern("c") fn g_string_append_printf(text: *GString, format: [*]const gchar, args: gtypes.c_varargs) -> void
