// glib/gconvert.h
// mlx-glib: file names (whose encoding is UTF-8 here, as GLib takes it
// on Linux unless G_FILENAME_ENCODING says otherwise) and file URIs.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar
const gssize = gtypes.gssize
const gsize = gtypes.gsize
const GError = gerror.GError

pub const GConvertError = enum(c_int) {
    G_CONVERT_ERROR_NO_CONVERSION,
    G_CONVERT_ERROR_ILLEGAL_SEQUENCE,
    G_CONVERT_ERROR_FAILED,
    G_CONVERT_ERROR_PARTIAL_INPUT,
    G_CONVERT_ERROR_BAD_URI,
    G_CONVERT_ERROR_NOT_ABSOLUTE_PATH,
    G_CONVERT_ERROR_NO_MEMORY,
    G_CONVERT_ERROR_EMBEDDED_NUL,
}

pub const G_CONVERT_ERROR: gquark.GQuark = g_convert_error_quark()

pub extern("c") fn g_convert_error_quark() -> gquark.GQuark
pub extern("c") fn g_filename_display_name(filename: [*]const gchar) -> [*]gchar
pub extern("c") fn g_filename_display_basename(filename: [*]const gchar) -> [*]gchar
pub extern("c") fn g_filename_to_utf8(opsysstring: [*]const gchar, len: gssize, bytes_read: ?*gsize, bytes_written: ?*gsize, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_filename_from_utf8(utf8string: [*]const gchar, len: gssize, bytes_read: ?*gsize, bytes_written: ?*gsize, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_filename_from_uri(uri: [*]const gchar, hostname: ?*[*]gchar, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_filename_to_uri(filename: [*]const gchar, hostname: ?[*]const gchar, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_get_filename_charsets(filename_charsets: ?*[*]const [*]const gchar) -> gtypes.gboolean
