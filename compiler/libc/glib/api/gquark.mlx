// glib/gquark.h
// mlx-glib: quarks, strings known by a number (0 is no string), and
// interned strings, kept for the program's life.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar

pub const GQuark = gtypes.guint32

pub extern("c") fn g_quark_try_string(text: [*]const gchar) -> GQuark
pub extern("c") fn g_quark_from_static_string(text: [*]const gchar) -> GQuark
pub extern("c") fn g_quark_from_string(text: [*]const gchar) -> GQuark
pub extern("c") fn g_quark_to_string(quark: GQuark) -> [*]const gchar
pub extern("c") fn g_intern_string(text: [*]const gchar) -> [*]const gchar
pub extern("c") fn g_intern_static_string(text: [*]const gchar) -> [*]const gchar
