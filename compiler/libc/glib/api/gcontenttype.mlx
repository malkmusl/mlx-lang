// gio/gcontenttype.h
// mlx-glib: content types, which on this system are MIME types. There is
// no shared-mime-info database: a type is guessed from the file name's
// extension (the common types of the web), else from the data (text or
// not), else it is unknown ("application/octet-stream").
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const guchar = gtypes.guchar
const gsize = gtypes.gsize
const gboolean = gtypes.gboolean

pub extern("c") fn g_content_type_guess(filename: ?[*]const gchar, data: ?[*]const guchar, data_size: gsize, result_uncertain: ?*gboolean) -> [*]gchar
pub extern("c") fn g_content_type_equals(type1: [*]const gchar, type2: [*]const gchar) -> gboolean
pub extern("c") fn g_content_type_is_unknown(type_: [*]const gchar) -> gboolean
pub extern("c") fn g_content_type_get_mime_type(type_: [*]const gchar) -> ?[*]gchar
pub extern("c") fn g_content_type_from_mime_type(mime_type: [*]const gchar) -> ?[*]gchar
