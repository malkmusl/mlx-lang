// glib/gpoll.h
// mlx-glib: what poll(2) waits on: a descriptor and its conditions.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gint = gtypes.gint
const guint = gtypes.guint
const gushort = gtypes.gushort

pub const _GPollFD = struct {
    fd: gint
    events: gushort
    revents: gushort
}
pub const GPollFD = _GPollFD

pub const GPollFunc = fn(ufds: *GPollFD, nfsd: guint, timeout_: gint) -> gint

pub extern("c") fn g_poll(fds: *GPollFD, nfds: guint, timeout: gint) -> gint
