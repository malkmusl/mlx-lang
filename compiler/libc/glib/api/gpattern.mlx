// glib/gpattern.h
// mlx-glib: glob-style patterns ('*' any run, '?' any one character).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const guint = gtypes.guint

pub const _GPatternSpec = struct {}
pub const GPatternSpec = _GPatternSpec

pub extern("c") fn g_pattern_spec_new(pattern: [*]const gchar) -> *GPatternSpec
pub extern("c") fn g_pattern_spec_free(pspec: *GPatternSpec) -> void
pub extern("c") fn g_pattern_spec_copy(pspec: *GPatternSpec) -> *GPatternSpec
pub extern("c") fn g_pattern_spec_equal(pspec1: *GPatternSpec, pspec2: *GPatternSpec) -> gboolean
pub extern("c") fn g_pattern_spec_match(pspec: *GPatternSpec, string_length: gtypes.gsize, text: [*]const gchar, string_reversed: ?[*]const gchar) -> gboolean
pub extern("c") fn g_pattern_spec_match_string(pspec: *GPatternSpec, text: [*]const gchar) -> gboolean
pub extern("c") fn g_pattern_match(pspec: *GPatternSpec, string_length: guint, text: [*]const gchar, string_reversed: ?[*]const gchar) -> gboolean
pub extern("c") fn g_pattern_match_string(pspec: *GPatternSpec, text: [*]const gchar) -> gboolean
pub extern("c") fn g_pattern_match_simple(pattern: [*]const gchar, text: [*]const gchar) -> gboolean
