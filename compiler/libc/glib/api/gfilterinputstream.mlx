// gio/gfilterinputstream.h
// mlx-glib: GFilterInputStream, an input stream over another (its base
// stream, closed with it unless told otherwise); the structures are in
// giotypes.h.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")

const GFilterInputStream = giotypes.GFilterInputStream

pub extern("c") fn g_filter_input_stream_get_type() -> gtype.GType
pub extern("c") fn g_filter_input_stream_get_base_stream(stream: *GFilterInputStream) -> *giotypes.GInputStream
pub extern("c") fn g_filter_input_stream_get_close_base_stream(stream: *GFilterInputStream) -> gtypes.gboolean
pub extern("c") fn g_filter_input_stream_set_close_base_stream(stream: *GFilterInputStream, close_base: gtypes.gboolean) -> void

pub const G_TYPE_FILTER_INPUT_STREAM: gtype.GType = g_filter_input_stream_get_type()
pub fn G_FILTER_INPUT_STREAM(o: anytype) -> *GFilterInputStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_FILTER_INPUT_STREAM, GFilterInputStream) }
pub fn G_IS_FILTER_INPUT_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_FILTER_INPUT_STREAM) }
