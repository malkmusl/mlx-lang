// glib/gversion.h
// mlx-glib: the version of GLib's API this library has (2.80), for
// GLIB_CHECK_VERSION in C's preprocessor and glib_check_version.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const guint = gtypes.guint
const GLIB_MAJOR_VERSION = gtypes.GLIB_MAJOR_VERSION
const GLIB_MINOR_VERSION = gtypes.GLIB_MINOR_VERSION
const GLIB_MICRO_VERSION = gtypes.GLIB_MICRO_VERSION

pub extern("c") fn glib_check_version(required_major: guint, required_minor: guint, required_micro: guint) -> ?[*]const gtypes.gchar

// Whether this API is at least the version `major`.`minor`.`micro`.
pub fn GLIB_CHECK_VERSION(major: c_int, minor: c_int, micro: c_int) -> bool {
    return GLIB_MAJOR_VERSION > major || (GLIB_MAJOR_VERSION == major && GLIB_MINOR_VERSION > minor) || (GLIB_MAJOR_VERSION == major && GLIB_MINOR_VERSION == minor && GLIB_MICRO_VERSION >= micro)
}

pub fn G_ENCODE_VERSION(major: c_int, minor: c_int) -> c_int { return (major << 16) | (minor << 8) }
