// glib/gutils.h
// mlx-glib: the environment, the user's directories (the XDG base
// directories, as GLib reads them), the program's name and paths.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean

pub extern("c") fn g_getenv(variable: [*]const gchar) -> ?[*]const gchar
pub extern("c") fn g_setenv(variable: [*]const gchar, value: [*]const gchar, overwrite: gboolean) -> gboolean
pub extern("c") fn g_unsetenv(variable: [*]const gchar) -> void
pub extern("c") fn g_listenv() -> [*][*]gchar
pub extern("c") fn g_get_environ() -> [*][*]gchar
pub extern("c") fn g_environ_getenv(envp: ?[*][*]gchar, variable: [*]const gchar) -> ?[*]const gchar
pub extern("c") fn g_environ_setenv(envp: ?[*][*]gchar, variable: [*]const gchar, value: [*]const gchar, overwrite: gboolean) -> [*][*]gchar
pub extern("c") fn g_environ_unsetenv(envp: ?[*][*]gchar, variable: [*]const gchar) -> [*][*]gchar

pub extern("c") fn g_get_user_name() -> [*]const gchar
pub extern("c") fn g_get_real_name() -> [*]const gchar
pub extern("c") fn g_get_home_dir() -> [*]const gchar
pub extern("c") fn g_get_tmp_dir() -> [*]const gchar
pub extern("c") fn g_get_host_name() -> [*]const gchar
pub extern("c") fn g_get_prgname() -> ?[*]const gchar
pub extern("c") fn g_set_prgname(prgname: [*]const gchar) -> void
pub extern("c") fn g_get_application_name() -> ?[*]const gchar
pub extern("c") fn g_set_application_name(application_name: [*]const gchar) -> void
pub extern("c") fn g_get_user_data_dir() -> [*]const gchar
pub extern("c") fn g_get_user_config_dir() -> [*]const gchar
pub extern("c") fn g_get_user_cache_dir() -> [*]const gchar
pub extern("c") fn g_get_user_state_dir() -> [*]const gchar
pub extern("c") fn g_get_user_runtime_dir() -> [*]const gchar
pub extern("c") fn g_get_system_data_dirs() -> [*]const [*]const gchar
pub extern("c") fn g_get_system_config_dirs() -> [*]const [*]const gchar
pub extern("c") fn g_get_os_info(key_name: [*]const gchar) -> ?[*]gchar

pub extern("c") fn g_get_current_dir() -> [*]gchar
pub extern("c") fn g_path_is_absolute(file_name: [*]const gchar) -> gboolean
pub extern("c") fn g_path_skip_root(file_name: [*]const gchar) -> ?[*]const gchar
pub extern("c") fn g_path_get_basename(file_name: [*]const gchar) -> [*]gchar
pub extern("c") fn g_path_get_dirname(file_name: [*]const gchar) -> [*]gchar
pub extern("c") fn g_build_filename(first_element: [*]const gchar, args: gtypes.c_varargs) -> [*]gchar
pub extern("c") fn g_build_filenamev(args: [*][*]gchar) -> [*]gchar
pub extern("c") fn g_build_path(separator: [*]const gchar, first_element: [*]const gchar, args: gtypes.c_varargs) -> [*]gchar
pub extern("c") fn g_build_pathv(separator: [*]const gchar, args: [*][*]gchar) -> [*]gchar
pub extern("c") fn g_canonicalize_filename(filename: [*]const gchar, relative_to: ?[*]const gchar) -> [*]gchar
pub extern("c") fn g_find_program_in_path(program: [*]const gchar) -> ?[*]gchar

pub extern("c") fn g_usleep(microseconds: gtypes.gulong) -> void
pub extern("c") fn g_get_real_time() -> gtypes.gint64
pub extern("c") fn g_get_monotonic_time() -> gtypes.gint64

pub extern("c") fn g_bit_nth_lsf(mask: gtypes.gulong, nth_bit: gtypes.gint) -> gtypes.gint
pub extern("c") fn g_bit_nth_msf(mask: gtypes.gulong, nth_bit: gtypes.gint) -> gtypes.gint
pub extern("c") fn g_bit_storage(number: gtypes.gulong) -> gtypes.guint
