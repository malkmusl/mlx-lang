// gio/gsocketaddress.h
// mlx-glib: GSocketAddress, the address of a socket (here its IPv4 and
// IPv6 kind, GInetSocketAddress), and its native form (a sockaddr).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const guint8 = gtypes.guint8
const guint16 = gtypes.guint16
const guint32 = gtypes.guint32
const gint = gtypes.gint
const guint = gtypes.guint
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GObject = gobject.GObject
const GCancellable = giotypes.GCancellable
const GSocketAddress = giotypes.GSocketAddress
const GSocketConnection = giotypes.GSocketConnection
const GSocket = giotypes.GSocket
const GAsyncResult = giotypes.GAsyncResult

pub extern("c") fn g_socket_address_get_type() -> gtype.GType
pub extern("c") fn g_socket_address_get_family(address: *GSocketAddress) -> gioenums.GSocketFamily
pub extern("c") fn g_socket_address_new_from_native(native: gpointer, len: gsize) -> ?*GSocketAddress
pub extern("c") fn g_socket_address_to_native(address: *GSocketAddress, dest: gpointer, destlen: gsize, error_: ?**GError) -> gboolean
pub extern("c") fn g_socket_address_get_native_size(address: *GSocketAddress) -> gssize

pub const G_TYPE_SOCKET_ADDRESS: gtype.GType = g_socket_address_get_type()
pub fn G_SOCKET_ADDRESS(o: anytype) -> *GSocketAddress { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_SOCKET_ADDRESS, GSocketAddress) }
pub fn G_IS_SOCKET_ADDRESS(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_SOCKET_ADDRESS) }
