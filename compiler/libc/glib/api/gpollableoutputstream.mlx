// gio/gpollableoutputstream.h
// mlx-glib: GPollableOutputStream, an output stream that can say whether
// a write would block, write without blocking, and give a source that
// dispatches when it can be written.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gmain = @import("./gmain.mlx")
const giotypes = @import("./giotypes.mlx")

const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GCancellable = giotypes.GCancellable

pub const _GPollableOutputStream = struct {}
pub const GPollableOutputStream = _GPollableOutputStream

pub const _GPollableOutputStreamInterface = struct {
    g_iface: gtype.GTypeInterface
    can_poll: ?fn(stream: *GPollableOutputStream) -> gboolean
    is_writable: ?fn(stream: *GPollableOutputStream) -> gboolean
    create_source: ?fn(stream: *GPollableOutputStream, cancellable: ?*GCancellable) -> *gmain.GSource
    write_nonblocking: ?fn(stream: *GPollableOutputStream, buffer: ?*const anyopaque, count: gsize, error_: ?**GError) -> gssize
    writev_nonblocking: gpointer
}
pub const GPollableOutputStreamInterface = _GPollableOutputStreamInterface

pub extern("c") fn g_pollable_output_stream_get_type() -> gtype.GType
pub extern("c") fn g_pollable_output_stream_can_poll(stream: *GPollableOutputStream) -> gboolean
pub extern("c") fn g_pollable_output_stream_is_writable(stream: *GPollableOutputStream) -> gboolean
pub extern("c") fn g_pollable_output_stream_create_source(stream: *GPollableOutputStream, cancellable: ?*GCancellable) -> *gmain.GSource
pub extern("c") fn g_pollable_output_stream_write_nonblocking(stream: *GPollableOutputStream, buffer: ?*const anyopaque, count: gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gssize

pub const G_TYPE_POLLABLE_OUTPUT_STREAM: gtype.GType = g_pollable_output_stream_get_type()
pub fn G_POLLABLE_OUTPUT_STREAM(o: anytype) -> *GPollableOutputStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_POLLABLE_OUTPUT_STREAM, GPollableOutputStream) }
pub fn G_IS_POLLABLE_OUTPUT_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_POLLABLE_OUTPUT_STREAM) }
