// glib/garray.h
// mlx-glib: arrays that grow: of elements of a size (GArray), of
// pointers (GPtrArray) and of bytes (GByteArray), counted references.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gbytes = @import("./gbytes.mlx")

const gpointer = gtypes.gpointer
const gconstpointer = gtypes.gconstpointer
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const gint = gtypes.gint
const guint8 = gtypes.guint8
const gsize = gtypes.gsize

pub const _GArray = struct {
    data: [*]gtypes.gchar
    len: guint
}
pub const GArray = _GArray

pub const _GByteArray = struct {
    data: [*]guint8
    len: guint
}
pub const GByteArray = _GByteArray

pub const _GPtrArray = struct {
    pdata: [*]gpointer
    len: guint
}
pub const GPtrArray = _GPtrArray

pub extern("c") fn g_array_new(zero_terminated: gboolean, clear_: gboolean, element_size: guint) -> *GArray
pub extern("c") fn g_array_sized_new(zero_terminated: gboolean, clear_: gboolean, element_size: guint, reserved_size: guint) -> *GArray
pub extern("c") fn g_array_copy(array: *GArray) -> *GArray
pub extern("c") fn g_array_free(array: *GArray, free_segment: gboolean) -> ?[*]gtypes.gchar
pub extern("c") fn g_array_steal(array: *GArray, len: ?*gsize) -> gpointer
pub extern("c") fn g_array_ref(array: *GArray) -> *GArray
pub extern("c") fn g_array_unref(array: *GArray) -> void
pub extern("c") fn g_array_get_element_size(array: *GArray) -> guint
pub extern("c") fn g_array_append_vals(array: *GArray, data: gconstpointer, len: guint) -> *GArray
pub extern("c") fn g_array_prepend_vals(array: *GArray, data: gconstpointer, len: guint) -> *GArray
pub extern("c") fn g_array_insert_vals(array: *GArray, index_: guint, data: gconstpointer, len: guint) -> *GArray
pub extern("c") fn g_array_set_size(array: *GArray, length: guint) -> *GArray
pub extern("c") fn g_array_remove_index(array: *GArray, index_: guint) -> *GArray
pub extern("c") fn g_array_remove_index_fast(array: *GArray, index_: guint) -> *GArray
pub extern("c") fn g_array_remove_range(array: *GArray, index_: guint, length: guint) -> *GArray
pub extern("c") fn g_array_sort(array: *GArray, compare_func: gtypes.GCompareFunc) -> void
pub extern("c") fn g_array_set_clear_func(array: *GArray, clear_func: gtypes.GDestroyNotify) -> void

pub inline fn g_array_append_val(a: *GArray, v: anytype) -> *GArray { return g_array_append_vals(a, &v, 1) }
pub inline fn g_array_prepend_val(a: *GArray, v: anytype) -> *GArray { return g_array_prepend_vals(a, &v, 1) }
pub inline fn g_array_insert_val(a: *GArray, i: guint, v: anytype) -> *GArray { return g_array_insert_vals(a, i, &v, 1) }
pub inline fn g_array_index(a: *GArray, comptime t: type, i: guint) -> anytype { return @ptrCast([*]t, @ptrCast(gpointer, a.*.data))[i] }

pub extern("c") fn g_ptr_array_new() -> *GPtrArray
pub extern("c") fn g_ptr_array_new_with_free_func(element_free_func: gtypes.GDestroyNotify) -> *GPtrArray
pub extern("c") fn g_ptr_array_new_full(reserved_size: guint, element_free_func: gtypes.GDestroyNotify) -> *GPtrArray
pub extern("c") fn g_ptr_array_new_null_terminated(reserved_size: guint, element_free_func: gtypes.GDestroyNotify, null_terminated: gboolean) -> *GPtrArray
pub extern("c") fn g_ptr_array_sized_new(reserved_size: guint) -> *GPtrArray
pub extern("c") fn g_ptr_array_copy(array: *GPtrArray, func: gtypes.GCopyFunc, user_data: gpointer) -> *GPtrArray
pub extern("c") fn g_ptr_array_free(array: *GPtrArray, free_seg: gboolean) -> ?*gpointer
pub extern("c") fn g_ptr_array_steal(array: *GPtrArray, len: ?*gsize) -> ?*gpointer
pub extern("c") fn g_ptr_array_ref(array: *GPtrArray) -> *GPtrArray
pub extern("c") fn g_ptr_array_unref(array: *GPtrArray) -> void
pub extern("c") fn g_ptr_array_set_free_func(array: *GPtrArray, element_free_func: gtypes.GDestroyNotify) -> void
pub extern("c") fn g_ptr_array_set_size(array: *GPtrArray, length: gint) -> void
pub extern("c") fn g_ptr_array_remove_index(array: *GPtrArray, index_: guint) -> gpointer
pub extern("c") fn g_ptr_array_remove_index_fast(array: *GPtrArray, index_: guint) -> gpointer
pub extern("c") fn g_ptr_array_steal_index(array: *GPtrArray, index_: guint) -> gpointer
pub extern("c") fn g_ptr_array_remove(array: *GPtrArray, data: gpointer) -> gboolean
pub extern("c") fn g_ptr_array_remove_fast(array: *GPtrArray, data: gpointer) -> gboolean
pub extern("c") fn g_ptr_array_remove_range(array: *GPtrArray, index_: guint, length: guint) -> *GPtrArray
pub extern("c") fn g_ptr_array_add(array: *GPtrArray, data: gpointer) -> void
pub extern("c") fn g_ptr_array_extend(array_to_extend: *GPtrArray, array: *GPtrArray, func: gtypes.GCopyFunc, user_data: gpointer) -> void
pub extern("c") fn g_ptr_array_insert(array: *GPtrArray, index_: gint, data: gpointer) -> void
pub extern("c") fn g_ptr_array_sort(array: *GPtrArray, compare_func: gtypes.GCompareFunc) -> void
pub extern("c") fn g_ptr_array_foreach(array: *GPtrArray, func: gtypes.GFunc, user_data: gpointer) -> void
pub extern("c") fn g_ptr_array_find(haystack: *GPtrArray, needle: gconstpointer, index_: ?*guint) -> gboolean
pub extern("c") fn g_ptr_array_find_with_equal_func(haystack: *GPtrArray, needle: gconstpointer, equal_func: gtypes.GEqualFunc, index_: ?*guint) -> gboolean

pub inline fn g_ptr_array_index(array: *GPtrArray, index_: guint) -> gpointer { return array.*.pdata[index_] }

pub extern("c") fn g_byte_array_new() -> *GByteArray
pub extern("c") fn g_byte_array_new_take(data: [*]guint8, len: gsize) -> *GByteArray
pub extern("c") fn g_byte_array_sized_new(reserved_size: guint) -> *GByteArray
pub extern("c") fn g_byte_array_free(array: *GByteArray, free_segment: gboolean) -> ?[*]guint8
pub extern("c") fn g_byte_array_steal(array: *GByteArray, len: ?*gsize) -> ?[*]guint8
pub extern("c") fn g_byte_array_free_to_bytes(array: *GByteArray) -> *gbytes.GBytes
pub extern("c") fn g_byte_array_ref(array: *GByteArray) -> *GByteArray
pub extern("c") fn g_byte_array_unref(array: *GByteArray) -> void
pub extern("c") fn g_byte_array_append(array: *GByteArray, data: [*]const guint8, len: guint) -> *GByteArray
pub extern("c") fn g_byte_array_prepend(array: *GByteArray, data: [*]const guint8, len: guint) -> *GByteArray
pub extern("c") fn g_byte_array_set_size(array: *GByteArray, length: guint) -> *GByteArray
pub extern("c") fn g_byte_array_remove_index(array: *GByteArray, index_: guint) -> *GByteArray
pub extern("c") fn g_byte_array_remove_range(array: *GByteArray, index_: guint, length: guint) -> *GByteArray
