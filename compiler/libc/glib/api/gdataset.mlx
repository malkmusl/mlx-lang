// glib/gdataset.h
// mlx-glib: keyed data lists (GData), data kept by quark with an
// optional destroy notify.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")

const gchar = gtypes.gchar
const gpointer = gtypes.gpointer
const GQuark = gquark.GQuark

pub const _GData = struct {}
pub const GData = _GData

pub const GDataForeachFunc = fn(key_id: GQuark, data: gpointer, user_data: gpointer) -> void

pub extern("c") fn g_datalist_init(datalist: *?*GData) -> void
pub extern("c") fn g_datalist_clear(datalist: *?*GData) -> void
pub extern("c") fn g_datalist_id_get_data(datalist: *?*GData, key_id: GQuark) -> gpointer
pub extern("c") fn g_datalist_id_set_data_full(datalist: *?*GData, key_id: GQuark, data: gpointer, destroy_func: ?gtypes.GDestroyNotify) -> void
pub extern("c") fn g_datalist_id_remove_no_notify(datalist: *?*GData, key_id: GQuark) -> gpointer
pub extern("c") fn g_datalist_foreach(datalist: *?*GData, func: GDataForeachFunc, user_data: gpointer) -> void
pub extern("c") fn g_datalist_get_data(datalist: *?*GData, key: [*]const gchar) -> gpointer
