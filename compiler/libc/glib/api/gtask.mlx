// gio/gtask.h
// mlx-glib: GAsyncResult and GTask, an asynchronous operation's result
// delivered to its callback in the main context it was started from.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gmain = @import("./gmain.mlx")
const giotypes = @import("./giotypes.mlx")

const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gssize = gtypes.gssize
const gint = gtypes.gint
const gchar = gtypes.gchar
const GObject = gobject.GObject
const GError = gerror.GError
const GTask = giotypes.GTask
const GAsyncResult = giotypes.GAsyncResult
const GCancellable = giotypes.GCancellable

pub const GTaskThreadFunc = fn(task: *GTask, source_object: gpointer, task_data: gpointer, cancellable: ?*GCancellable) -> void

pub extern("c") fn g_async_result_get_type() -> gtype.GType
pub extern("c") fn g_async_result_get_user_data(res: *GAsyncResult) -> gpointer
pub extern("c") fn g_async_result_get_source_object(res: *GAsyncResult) -> ?*GObject
pub extern("c") fn g_async_result_legacy_propagate_error(res: *GAsyncResult, error_: ?**GError) -> gboolean
pub extern("c") fn g_async_result_is_tagged(res: *GAsyncResult, source_tag: gpointer) -> gboolean

pub extern("c") fn g_task_get_type() -> gtype.GType
pub extern("c") fn g_task_new(source_object: gpointer, cancellable: ?*GCancellable, callback: giotypes.GAsyncReadyCallback, callback_data: gpointer) -> *GTask
pub extern("c") fn g_task_report_error(source_object: gpointer, callback: giotypes.GAsyncReadyCallback, callback_data: gpointer, source_tag: gpointer, error_: *GError) -> void
pub extern("c") fn g_task_report_new_error(source_object: gpointer, callback: giotypes.GAsyncReadyCallback, callback_data: gpointer, source_tag: gpointer, domain: gquark.GQuark, code: gint, format: [*]const c_char, args: gtypes.c_varargs) -> void
pub extern("c") fn g_task_set_task_data(task: *GTask, task_data: gpointer, task_data_destroy: gtypes.GDestroyNotify) -> void
pub extern("c") fn g_task_set_priority(task: *GTask, priority: gint) -> void
pub extern("c") fn g_task_set_check_cancellable(task: *GTask, check_cancellable: gboolean) -> void
pub extern("c") fn g_task_set_source_tag(task: *GTask, source_tag: gpointer) -> void
pub extern("c") fn g_task_set_name(task: *GTask, name: ?[*]const gchar) -> void
pub extern("c") fn g_task_set_static_name(task: *GTask, name: ?[*]const gchar) -> void
pub extern("c") fn g_task_get_source_object(task: *GTask) -> gpointer
pub extern("c") fn g_task_get_task_data(task: *GTask) -> gpointer
pub extern("c") fn g_task_get_priority(task: *GTask) -> gint
pub extern("c") fn g_task_get_context(task: *GTask) -> *gmain.GMainContext
pub extern("c") fn g_task_get_cancellable(task: *GTask) -> ?*GCancellable
pub extern("c") fn g_task_get_check_cancellable(task: *GTask) -> gboolean
pub extern("c") fn g_task_get_source_tag(task: *GTask) -> gpointer
pub extern("c") fn g_task_get_name(task: *GTask) -> ?[*]const gchar
pub extern("c") fn g_task_is_valid(result: gpointer, source_object: gpointer) -> gboolean
pub extern("c") fn g_task_run_in_thread(task: *GTask, task_func: GTaskThreadFunc) -> void
pub extern("c") fn g_task_run_in_thread_sync(task: *GTask, task_func: GTaskThreadFunc) -> void
pub extern("c") fn g_task_return_pointer(task: *GTask, result: gpointer, result_destroy: gtypes.GDestroyNotify) -> void
pub extern("c") fn g_task_return_boolean(task: *GTask, result: gboolean) -> void
pub extern("c") fn g_task_return_int(task: *GTask, result: gssize) -> void
pub extern("c") fn g_task_return_error(task: *GTask, error_: *GError) -> void
pub extern("c") fn g_task_return_new_error(task: *GTask, domain: gquark.GQuark, code: gint, format: [*]const c_char, args: gtypes.c_varargs) -> void
pub extern("c") fn g_task_return_new_error_literal(task: *GTask, domain: gquark.GQuark, code: gint, message: [*]const c_char) -> void
pub extern("c") fn g_task_return_error_if_cancelled(task: *GTask) -> gboolean
pub extern("c") fn g_task_propagate_pointer(task: *GTask, error_: ?**GError) -> gpointer
pub extern("c") fn g_task_propagate_boolean(task: *GTask, error_: ?**GError) -> gboolean
pub extern("c") fn g_task_propagate_int(task: *GTask, error_: ?**GError) -> gssize
pub extern("c") fn g_task_had_error(task: *GTask) -> gboolean
pub extern("c") fn g_task_get_completed(task: *GTask) -> gboolean

pub const G_TYPE_ASYNC_RESULT: gtype.GType = g_async_result_get_type()
pub const G_TYPE_TASK: gtype.GType = g_task_get_type()
pub fn G_ASYNC_RESULT(o: anytype) -> *GAsyncResult { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_ASYNC_RESULT, GAsyncResult) }
pub fn G_IS_ASYNC_RESULT(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_ASYNC_RESULT) }
pub fn G_TASK(o: anytype) -> *GTask { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TASK, GTask) }
pub fn G_IS_TASK(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TASK) }
