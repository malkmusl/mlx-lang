// glib/gchecksum.h
// mlx-glib: checksums (MD5, SHA-1, SHA-256, SHA-384, SHA-512) as
// lower-case hexadecimal strings or digests.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gbytes = @import("./gbytes.mlx")

const gchar = gtypes.gchar
const guchar = gtypes.guchar
const gsize = gtypes.gsize
const gssize = gtypes.gssize

pub const GChecksumType = enum(c_int) {
    G_CHECKSUM_MD5,
    G_CHECKSUM_SHA1,
    G_CHECKSUM_SHA256,
    G_CHECKSUM_SHA512,
    G_CHECKSUM_SHA384,
}

pub const _GChecksum = struct {}
pub const GChecksum = _GChecksum

pub extern("c") fn g_checksum_type_get_length(checksum_type: GChecksumType) -> gssize
pub extern("c") fn g_checksum_new(checksum_type: GChecksumType) -> ?*GChecksum
pub extern("c") fn g_checksum_reset(checksum: *GChecksum) -> void
pub extern("c") fn g_checksum_copy(checksum: *const GChecksum) -> *GChecksum
pub extern("c") fn g_checksum_free(checksum: *GChecksum) -> void
pub extern("c") fn g_checksum_update(checksum: *GChecksum, data: [*]const guchar, length: gssize) -> void
pub extern("c") fn g_checksum_get_string(checksum: *GChecksum) -> [*]const gchar
pub extern("c") fn g_checksum_get_digest(checksum: *GChecksum, buffer: [*]gtypes.guint8, digest_len: *gsize) -> void
pub extern("c") fn g_compute_checksum_for_data(checksum_type: GChecksumType, data: [*]const guchar, length: gsize) -> ?[*]gchar
pub extern("c") fn g_compute_checksum_for_string(checksum_type: GChecksumType, text: [*]const gchar, length: gssize) -> ?[*]gchar
pub extern("c") fn g_compute_checksum_for_bytes(checksum_type: GChecksumType, data: *gbytes.GBytes) -> ?[*]gchar
