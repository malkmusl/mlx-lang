// glib/guri.h
// mlx-glib: URIs (RFC 3986) parsed into their parts, resolved against a
// base, written back, escaped and unescaped, as GLib's GUri does.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")
const gbytes = @import("./gbytes.mlx")
const ghash = @import("./ghash.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gint = gtypes.gint
const gssize = gtypes.gssize
const gsize = gtypes.gsize
const GError = gerror.GError

pub const _GUri = struct {}
pub const GUri = _GUri

pub const GUriFlags = enum(c_int) {
    G_URI_FLAGS_NONE = 0,
    G_URI_FLAGS_PARSE_RELAXED = 1,
    G_URI_FLAGS_HAS_PASSWORD = 2,
    G_URI_FLAGS_HAS_AUTH_PARAMS = 4,
    G_URI_FLAGS_ENCODED = 8,
    G_URI_FLAGS_NON_DNS = 16,
    G_URI_FLAGS_ENCODED_QUERY = 32,
    G_URI_FLAGS_ENCODED_PATH = 64,
    G_URI_FLAGS_ENCODED_FRAGMENT = 128,
    G_URI_FLAGS_SCHEME_NORMALIZE = 256,
}

pub const GUriHideFlags = enum(c_int) {
    G_URI_HIDE_NONE = 0,
    G_URI_HIDE_USERINFO = 1,
    G_URI_HIDE_PASSWORD = 2,
    G_URI_HIDE_AUTH_PARAMS = 4,
    G_URI_HIDE_QUERY = 8,
    G_URI_HIDE_FRAGMENT = 16,
}

pub const GUriParamsFlags = enum(c_int) {
    G_URI_PARAMS_NONE = 0,
    G_URI_PARAMS_CASE_INSENSITIVE = 1,
    G_URI_PARAMS_WWW_FORM = 2,
    G_URI_PARAMS_PARSE_RELAXED = 4,
}

pub const GUriError = enum(c_int) {
    G_URI_ERROR_FAILED,
    G_URI_ERROR_BAD_SCHEME,
    G_URI_ERROR_BAD_USER,
    G_URI_ERROR_BAD_PASSWORD,
    G_URI_ERROR_BAD_AUTH_PARAMS,
    G_URI_ERROR_BAD_HOST,
    G_URI_ERROR_BAD_PORT,
    G_URI_ERROR_BAD_PATH,
    G_URI_ERROR_BAD_QUERY,
    G_URI_ERROR_BAD_FRAGMENT,
}

pub const G_URI_ERROR: gquark.GQuark = g_uri_error_quark()

pub const G_URI_RESERVED_CHARS_GENERIC_DELIMITERS: []const u8 = ":/?#[]@"
pub const G_URI_RESERVED_CHARS_SUBCOMPONENT_DELIMITERS: []const u8 = "!$&'()*+,;="
pub const G_URI_RESERVED_CHARS_ALLOWED_IN_PATH_ELEMENT: []const u8 = "!$&'()*+,;=:@"
pub const G_URI_RESERVED_CHARS_ALLOWED_IN_PATH: []const u8 = "!$&'()*+,;=:@/"
pub const G_URI_RESERVED_CHARS_ALLOWED_IN_USERINFO: []const u8 = "!$&'()*+,;=:"

// An iterator over the parameters of a query (its fields are the
// library's own).
pub const _GUriParamsIter = struct {
    dummy0: gint
    dummy1: gtypes.gpointer
    dummy2: gtypes.gpointer
    dummy3: [256]gtypes.guint8
}
pub const GUriParamsIter = _GUriParamsIter

pub extern("c") fn g_uri_ref(uri: *GUri) -> *GUri
pub extern("c") fn g_uri_unref(uri: *GUri) -> void
pub extern("c") fn g_uri_split(uri_ref: [*]const gchar, flags: GUriFlags, scheme: ?*[*]gchar, userinfo: ?*[*]gchar, host: ?*[*]gchar, port: ?*gint, path: ?*[*]gchar, query: ?*[*]gchar, fragment: ?*[*]gchar, error_: ?**GError) -> gboolean
pub extern("c") fn g_uri_split_with_user(uri_ref: [*]const gchar, flags: GUriFlags, scheme: ?*[*]gchar, user: ?*[*]gchar, password: ?*[*]gchar, auth_params: ?*[*]gchar, host: ?*[*]gchar, port: ?*gint, path: ?*[*]gchar, query: ?*[*]gchar, fragment: ?*[*]gchar, error_: ?**GError) -> gboolean
pub extern("c") fn g_uri_split_network(uri_string: [*]const gchar, flags: GUriFlags, scheme: ?*[*]gchar, host: ?*[*]gchar, port: ?*gint, error_: ?**GError) -> gboolean
pub extern("c") fn g_uri_is_valid(uri_string: [*]const gchar, flags: GUriFlags, error_: ?**GError) -> gboolean
pub extern("c") fn g_uri_join(flags: GUriFlags, scheme: ?[*]const gchar, userinfo: ?[*]const gchar, host: ?[*]const gchar, port: gint, path: [*]const gchar, query: ?[*]const gchar, fragment: ?[*]const gchar) -> [*]gchar
pub extern("c") fn g_uri_join_with_user(flags: GUriFlags, scheme: ?[*]const gchar, user: ?[*]const gchar, password: ?[*]const gchar, auth_params: ?[*]const gchar, host: ?[*]const gchar, port: gint, path: [*]const gchar, query: ?[*]const gchar, fragment: ?[*]const gchar) -> [*]gchar
pub extern("c") fn g_uri_parse(uri_string: [*]const gchar, flags: GUriFlags, error_: ?**GError) -> ?*GUri
pub extern("c") fn g_uri_parse_relative(base_uri: ?*GUri, uri_ref: [*]const gchar, flags: GUriFlags, error_: ?**GError) -> ?*GUri
pub extern("c") fn g_uri_resolve_relative(base_uri_string: ?[*]const gchar, uri_ref: [*]const gchar, flags: GUriFlags, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_uri_build(flags: GUriFlags, scheme: [*]const gchar, userinfo: ?[*]const gchar, host: ?[*]const gchar, port: gint, path: [*]const gchar, query: ?[*]const gchar, fragment: ?[*]const gchar) -> *GUri
pub extern("c") fn g_uri_build_with_user(flags: GUriFlags, scheme: [*]const gchar, user: ?[*]const gchar, password: ?[*]const gchar, auth_params: ?[*]const gchar, host: ?[*]const gchar, port: gint, path: [*]const gchar, query: ?[*]const gchar, fragment: ?[*]const gchar) -> *GUri
pub extern("c") fn g_uri_to_string(uri: *GUri) -> [*]c_char
pub extern("c") fn g_uri_to_string_partial(uri: *GUri, flags: GUriHideFlags) -> [*]c_char
pub extern("c") fn g_uri_get_scheme(uri: *GUri) -> [*]const gchar
pub extern("c") fn g_uri_get_userinfo(uri: *GUri) -> ?[*]const gchar
pub extern("c") fn g_uri_get_user(uri: *GUri) -> ?[*]const gchar
pub extern("c") fn g_uri_get_password(uri: *GUri) -> ?[*]const gchar
pub extern("c") fn g_uri_get_auth_params(uri: *GUri) -> ?[*]const gchar
pub extern("c") fn g_uri_get_host(uri: *GUri) -> ?[*]const gchar
pub extern("c") fn g_uri_get_port(uri: *GUri) -> gint
pub extern("c") fn g_uri_get_path(uri: *GUri) -> [*]const gchar
pub extern("c") fn g_uri_get_query(uri: *GUri) -> ?[*]const gchar
pub extern("c") fn g_uri_get_fragment(uri: *GUri) -> ?[*]const gchar
pub extern("c") fn g_uri_get_flags(uri: *GUri) -> GUriFlags
pub extern("c") fn g_uri_parse_params(params: [*]const gchar, length: gssize, separators: [*]const gchar, flags: GUriParamsFlags, error_: ?**GError) -> ?*ghash.GHashTable
pub extern("c") fn g_uri_params_iter_init(iter: *GUriParamsIter, params: [*]const gchar, length: gssize, separators: [*]const gchar, flags: GUriParamsFlags) -> void
pub extern("c") fn g_uri_params_iter_next(iter: *GUriParamsIter, attribute: ?*[*]gchar, value: ?*[*]gchar, error_: ?**GError) -> gboolean
pub extern("c") fn g_uri_error_quark() -> gquark.GQuark
pub extern("c") fn g_uri_unescape_string(escaped_string: [*]const c_char, illegal_characters: ?[*]const c_char) -> ?[*]c_char
pub extern("c") fn g_uri_unescape_segment(escaped_string: ?[*]const c_char, escaped_string_end: ?[*]const c_char, illegal_characters: ?[*]const c_char) -> ?[*]c_char
pub extern("c") fn g_uri_parse_scheme(uri: [*]const c_char) -> ?[*]c_char
pub extern("c") fn g_uri_peek_scheme(uri: [*]const c_char) -> ?[*]const c_char
pub extern("c") fn g_uri_escape_string(unescaped: [*]const c_char, reserved_chars_allowed: ?[*]const c_char, allow_utf8: gboolean) -> [*]c_char
pub extern("c") fn g_uri_unescape_bytes(escaped_string: [*]const c_char, length: gssize, illegal_characters: ?[*]const c_char, error_: ?**GError) -> ?*gbytes.GBytes
pub extern("c") fn g_uri_escape_bytes(unescaped: [*]const gtypes.guint8, length: gsize, reserved_chars_allowed: ?[*]const c_char) -> [*]c_char
