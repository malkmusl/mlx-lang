// gio/ginputstream.h
// mlx-glib: GInputStream, a stream of bytes read synchronously or
// asynchronously (in a later iteration of the caller's main context),
// skipped and closed; one operation at a time.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gbytes = @import("./gbytes.mlx")
const giotypes = @import("./giotypes.mlx")

const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GBytes = gbytes.GBytes
const GInputStream = giotypes.GInputStream
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback

pub extern("c") fn g_input_stream_get_type() -> gtype.GType
pub extern("c") fn g_input_stream_read(stream: *GInputStream, buffer: ?*anyopaque, count: gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn g_input_stream_read_all(stream: *GInputStream, buffer: ?*anyopaque, count: gsize, bytes_read: ?*gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_input_stream_read_bytes(stream: *GInputStream, count: gsize, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GBytes
pub extern("c") fn g_input_stream_skip(stream: *GInputStream, count: gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn g_input_stream_close(stream: *GInputStream, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_input_stream_read_async(stream: *GInputStream, buffer: ?*anyopaque, count: gsize, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_input_stream_read_finish(stream: *GInputStream, result: *GAsyncResult, error_: ?**GError) -> gssize
pub extern("c") fn g_input_stream_read_all_async(stream: *GInputStream, buffer: ?*anyopaque, count: gsize, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_input_stream_read_all_finish(stream: *GInputStream, result: *GAsyncResult, bytes_read: ?*gsize, error_: ?**GError) -> gboolean
pub extern("c") fn g_input_stream_read_bytes_async(stream: *GInputStream, count: gsize, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_input_stream_read_bytes_finish(stream: *GInputStream, result: *GAsyncResult, error_: ?**GError) -> ?*GBytes
pub extern("c") fn g_input_stream_skip_async(stream: *GInputStream, count: gsize, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_input_stream_skip_finish(stream: *GInputStream, result: *GAsyncResult, error_: ?**GError) -> gssize
pub extern("c") fn g_input_stream_close_async(stream: *GInputStream, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_input_stream_close_finish(stream: *GInputStream, result: *GAsyncResult, error_: ?**GError) -> gboolean
pub extern("c") fn g_input_stream_is_closed(stream: *GInputStream) -> gboolean
pub extern("c") fn g_input_stream_has_pending(stream: *GInputStream) -> gboolean
pub extern("c") fn g_input_stream_set_pending(stream: *GInputStream, error_: ?**GError) -> gboolean
pub extern("c") fn g_input_stream_clear_pending(stream: *GInputStream) -> void

pub const G_TYPE_INPUT_STREAM: gtype.GType = g_input_stream_get_type()
pub fn G_INPUT_STREAM(o: anytype) -> *GInputStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_INPUT_STREAM, GInputStream) }
pub fn G_IS_INPUT_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_INPUT_STREAM) }
pub fn G_INPUT_STREAM_CLASS(k: anytype) -> *giotypes.GInputStreamClass { return gtype.G_TYPE_CHECK_CLASS_CAST(k, G_TYPE_INPUT_STREAM, giotypes.GInputStreamClass) }
pub fn G_INPUT_STREAM_GET_CLASS(o: anytype) -> *giotypes.GInputStreamClass { return gtype.G_TYPE_INSTANCE_GET_CLASS(o, G_TYPE_INPUT_STREAM, giotypes.GInputStreamClass) }
