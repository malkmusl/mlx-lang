// glib/gmarkup.h
// mlx-glib: GLib's simple XML subset parsed into callbacks (elements and
// their attributes, text, passthrough of comments and processing
// instructions), fed in pieces.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const gpointer = gtypes.gpointer
const gint = gtypes.gint
const GError = gerror.GError

pub const GMarkupError = enum(c_int) {
    G_MARKUP_ERROR_BAD_UTF8,
    G_MARKUP_ERROR_EMPTY,
    G_MARKUP_ERROR_PARSE,
    G_MARKUP_ERROR_UNKNOWN_ELEMENT,
    G_MARKUP_ERROR_UNKNOWN_ATTRIBUTE,
    G_MARKUP_ERROR_INVALID_CONTENT,
    G_MARKUP_ERROR_MISSING_ATTRIBUTE,
}

pub const GMarkupParseFlags = enum(c_int) {
    G_MARKUP_DEFAULT_FLAGS = 0,
    G_MARKUP_DO_NOT_USE_THIS_UNSUPPORTED_FLAG = 1,
    G_MARKUP_TREAT_CDATA_AS_TEXT = 2,
    G_MARKUP_PREFIX_ERROR_POSITION = 4,
    G_MARKUP_IGNORE_QUALIFIED = 8,
}

pub const G_MARKUP_ERROR: gquark.GQuark = g_markup_error_quark()

pub const _GMarkupParseContext = struct {}
pub const GMarkupParseContext = _GMarkupParseContext

pub const _GMarkupParser = struct {
    start_element: fn(context: *GMarkupParseContext, element_name: [*]const gchar, attribute_names: [*][*]const gchar, attribute_values: [*][*]const gchar, user_data: gpointer, error_: **GError) -> void
    end_element: fn(context: *GMarkupParseContext, element_name: [*]const gchar, user_data: gpointer, error_: **GError) -> void
    text: fn(context: *GMarkupParseContext, text: [*]const gchar, text_len: gsize, user_data: gpointer, error_: **GError) -> void
    passthrough: fn(context: *GMarkupParseContext, passthrough_text: [*]const gchar, text_len: gsize, user_data: gpointer, error_: **GError) -> void
    error_: fn(context: *GMarkupParseContext, error_: *GError, user_data: gpointer) -> void
}
pub const GMarkupParser = _GMarkupParser

pub extern("c") fn g_markup_error_quark() -> gquark.GQuark
pub extern("c") fn g_markup_parse_context_new(parser: *const GMarkupParser, flags: GMarkupParseFlags, user_data: gpointer, user_data_dnotify: gtypes.GDestroyNotify) -> *GMarkupParseContext
pub extern("c") fn g_markup_parse_context_ref(context: *GMarkupParseContext) -> *GMarkupParseContext
pub extern("c") fn g_markup_parse_context_unref(context: *GMarkupParseContext) -> void
pub extern("c") fn g_markup_parse_context_free(context: *GMarkupParseContext) -> void
pub extern("c") fn g_markup_parse_context_parse(context: *GMarkupParseContext, text: [*]const gchar, text_len: gssize, error_: ?**GError) -> gboolean
pub extern("c") fn g_markup_parse_context_end_parse(context: *GMarkupParseContext, error_: ?**GError) -> gboolean
pub extern("c") fn g_markup_parse_context_get_element(context: *GMarkupParseContext) -> ?[*]const gchar
pub extern("c") fn g_markup_parse_context_get_position(context: *GMarkupParseContext, line_number: ?*gint, char_number: ?*gint) -> void
pub extern("c") fn g_markup_parse_context_get_user_data(context: *GMarkupParseContext) -> gpointer
pub extern("c") fn g_markup_escape_text(text: [*]const gchar, length: gssize) -> [*]gchar
pub extern("c") fn g_markup_printf_escaped(format: [*]const c_char, args: gtypes.c_varargs) -> [*]gchar
