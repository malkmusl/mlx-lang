// glib/gtimer.h
// mlx-glib: stopwatches on the monotonic clock.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

pub const _GTimer = struct {}
pub const GTimer = _GTimer


pub extern("c") fn g_timer_new() -> *GTimer
pub extern("c") fn g_timer_destroy(timer: *GTimer) -> void
pub extern("c") fn g_timer_start(timer: *GTimer) -> void
pub extern("c") fn g_timer_stop(timer: *GTimer) -> void
pub extern("c") fn g_timer_reset(timer: *GTimer) -> void
pub extern("c") fn g_timer_continue(timer: *GTimer) -> void
pub extern("c") fn g_timer_elapsed(timer: *GTimer, microseconds: ?*gtypes.gulong) -> gtypes.gdouble
pub extern("c") fn g_timer_is_active(timer: *GTimer) -> gtypes.gboolean
