// gio/gtlspassword.h
// mlx-glib: GTlsPassword, a password a TLS connection asks for (a
// client certificate's key, a PKCS #11 token's PIN): its value, flags,
// description and warning, with the "description", "flags" and
// "warning" properties.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const guchar = gtypes.guchar
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const gpointer = gtypes.gpointer
const GTlsPassword = giotypes.GTlsPassword

pub const _GTlsPasswordClass = struct {
    parent_class: gobject.GObjectClass
    get_value: fn(password: *GTlsPassword, length: ?*gsize) -> [*]const guchar
    set_value: fn(password: *GTlsPassword, value: [*]guchar, length: gssize, destroy: gtypes.GDestroyNotify) -> void
    get_default_warning: fn(password: *GTlsPassword) -> [*]const gchar
    padding: [4]gpointer
}
pub const GTlsPasswordClass = _GTlsPasswordClass

pub extern("c") fn g_tls_password_get_type() -> gtype.GType
pub extern("c") fn g_tls_password_new(flags: gioenums.GTlsPasswordFlags, description: [*]const gchar) -> *GTlsPassword
pub extern("c") fn g_tls_password_get_value(password: *GTlsPassword, length: ?*gsize) -> [*]const guchar
pub extern("c") fn g_tls_password_set_value(password: *GTlsPassword, value: [*]const guchar, length: gssize) -> void
pub extern("c") fn g_tls_password_get_flags(password: *GTlsPassword) -> gioenums.GTlsPasswordFlags
pub extern("c") fn g_tls_password_set_flags(password: *GTlsPassword, flags: gioenums.GTlsPasswordFlags) -> void
pub extern("c") fn g_tls_password_get_description(password: *GTlsPassword) -> [*]const gchar
pub extern("c") fn g_tls_password_set_description(password: *GTlsPassword, description: [*]const gchar) -> void
pub extern("c") fn g_tls_password_get_warning(password: *GTlsPassword) -> [*]const gchar
pub extern("c") fn g_tls_password_set_warning(password: *GTlsPassword, warning: [*]const gchar) -> void

pub const G_TYPE_TLS_PASSWORD: gtype.GType = g_tls_password_get_type()
pub fn G_TLS_PASSWORD(o: anytype) -> *GTlsPassword { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TLS_PASSWORD, GTlsPassword) }
pub fn G_IS_TLS_PASSWORD(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TLS_PASSWORD) }
