// glib/gprintf.h
// mlx-glib: C's printf family by GLib's names, to standard output, a
// stream, a buffer or a newly allocated string. Not included by glib.h.
const c_system_headers = "stdio.h"
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const gint = gtypes.gint

pub extern("c") fn g_printf(format: [*]const gchar, args: gtypes.c_varargs) -> gint
pub extern("c") fn g_fprintf(file: *anyopaque, format: [*]const gchar, args: gtypes.c_varargs) -> gint
pub extern("c") fn g_sprintf(string: [*]gchar, format: [*]const gchar, args: gtypes.c_varargs) -> gint
pub extern("c") fn g_vprintf(format: [*]const gchar, args: gtypes.c_va_list) -> gint
pub extern("c") fn g_vfprintf(file: *anyopaque, format: [*]const gchar, args: gtypes.c_va_list) -> gint
pub extern("c") fn g_vsprintf(string: [*]gchar, format: [*]const gchar, args: gtypes.c_va_list) -> gint
pub extern("c") fn g_vasprintf(string: *[*]gchar, format: [*]const gchar, args: gtypes.c_va_list) -> gint
