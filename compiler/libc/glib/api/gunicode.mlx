// glib/gunicode.h
// mlx-glib: UTF-8 strings: validating, measuring, decoding and encoding
// them (the properties of characters are mlx-unicode's part).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar
const glong = gtypes.glong
const gssize = gtypes.gssize
const gsize = gtypes.gsize
const gint = gtypes.gint
const gboolean = gtypes.gboolean
const gunichar = gtypes.gunichar
const gunichar2 = gtypes.gunichar2

pub extern("c") fn g_utf8_validate(text: [*]const gchar, max_len: gssize, end: ?*[*]const gchar) -> gboolean
pub extern("c") fn g_utf8_validate_len(text: [*]const gchar, max_len: gsize, end: ?*[*]const gchar) -> gboolean
pub extern("c") fn g_utf8_strlen(p: [*]const gchar, max: gssize) -> glong
pub extern("c") fn g_utf8_get_char(p: [*]const gchar) -> gunichar
pub extern("c") fn g_utf8_get_char_validated(p: [*]const gchar, max_len: gssize) -> gunichar
pub extern("c") fn g_utf8_offset_to_pointer(text: [*]const gchar, offset: glong) -> [*]gchar
pub extern("c") fn g_utf8_pointer_to_offset(text: [*]const gchar, pos: [*]const gchar) -> glong
pub extern("c") fn g_utf8_find_next_char(p: [*]const gchar, end: ?[*]const gchar) -> ?[*]gchar
pub extern("c") fn g_utf8_find_prev_char(text: [*]const gchar, p: [*]const gchar) -> ?[*]gchar
pub extern("c") fn g_utf8_prev_char(p: [*]const gchar) -> [*]gchar
pub extern("c") fn g_utf8_strncpy(dest: [*]gchar, src: [*]const gchar, n: gsize) -> [*]gchar
pub extern("c") fn g_utf8_substring(text: [*]const gchar, start_pos: glong, end_pos: glong) -> [*]gchar
pub extern("c") fn g_utf8_make_valid(text: [*]const gchar, len: gssize) -> [*]gchar
pub extern("c") fn g_utf8_strchr(p: [*]const gchar, len: gssize, c: gunichar) -> ?[*]gchar
pub extern("c") fn g_utf8_to_ucs4(text: [*]const gchar, len: glong, items_read: ?*glong, items_written: ?*glong, error_: ?**gerror.GError) -> ?*gunichar
pub extern("c") fn g_utf8_to_utf16(text: [*]const gchar, len: glong, items_read: ?*glong, items_written: ?*glong, error_: ?**gerror.GError) -> ?*gunichar2
pub extern("c") fn g_utf16_to_utf8(text: *const gunichar2, len: glong, items_read: ?*glong, items_written: ?*glong, error_: ?**gerror.GError) -> ?[*]gchar
pub extern("c") fn g_ucs4_to_utf8(text: *const gunichar, len: glong, items_read: ?*glong, items_written: ?*glong, error_: ?**gerror.GError) -> ?[*]gchar
pub extern("c") fn g_unichar_to_utf8(c: gunichar, outbuf: ?[*]gchar) -> gint
pub extern("c") fn g_unichar_validate(ch: gunichar) -> gboolean
pub extern("c") fn g_utf8_skip_length(c: gchar) -> gint

// The character after the one at `p` (UTF-8's lead byte says how far).
pub inline fn g_utf8_next_char(p: anytype) -> [*]gchar { return @ptrCast([*]gchar, p) + g_utf8_skip_length(@ptrCast([*]const gchar, p)[0]) }
