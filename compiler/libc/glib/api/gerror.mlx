// glib/gerror.h
// mlx-glib: errors reported to the caller, a domain (a quark), a code
// and a message.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")

const gchar = gtypes.gchar
const gint = gtypes.gint
const GQuark = gquark.GQuark

pub const _GError = struct {
    domain: GQuark
    code: gint
    message: [*]gchar
}
pub const GError = _GError

pub extern("c") fn g_error_new(domain: GQuark, code: gint, format: [*]const gchar, args: gtypes.c_varargs) -> *GError
pub extern("c") fn g_error_new_literal(domain: GQuark, code: gint, message: [*]const gchar) -> *GError
pub extern("c") fn g_error_new_valist(domain: GQuark, code: gint, format: [*]const gchar, args: gtypes.c_va_list) -> *GError
pub extern("c") fn g_error_free(error_: *GError) -> void
pub extern("c") fn g_error_copy(error_: *const GError) -> *GError
pub extern("c") fn g_error_matches(error_: *const GError, domain: GQuark, code: gint) -> gtypes.gboolean
pub extern("c") fn g_set_error(err: **GError, domain: GQuark, code: gint, format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_set_error_literal(err: **GError, domain: GQuark, code: gint, message: [*]const gchar) -> void
pub extern("c") fn g_propagate_error(dest: **GError, src: *GError) -> void
pub extern("c") fn g_clear_error(err: **GError) -> void
pub extern("c") fn g_prefix_error(err: **GError, format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_prefix_error_literal(err: **GError, prefix: [*]const gchar) -> void
pub extern("c") fn g_propagate_prefixed_error(dest: **GError, src: *GError, format: [*]const gchar, args: gtypes.c_varargs) -> void
