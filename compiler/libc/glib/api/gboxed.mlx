// gobject/gboxed.h
// mlx-glib: boxed types, C structures the type system copies and frees
// with the functions they were registered with (and the boxed types of
// GLib's own structures).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gvalue = @import("./gvalue.mlx")

const gchar = gtypes.gchar
const gpointer = gtypes.gpointer
const gconstpointer = gtypes.gconstpointer
const GType = gtype.GType
const GValue = gvalue.GValue

pub const GBoxedCopyFunc = fn(boxed: gpointer) -> gpointer
pub const GBoxedFreeFunc = fn(boxed: gpointer) -> void

pub extern("c") fn g_boxed_copy(boxed_type: GType, src_boxed: gconstpointer) -> gpointer
pub extern("c") fn g_boxed_free(boxed_type: GType, boxed: gpointer) -> void
pub extern("c") fn g_value_set_boxed(value: *GValue, v_boxed: gconstpointer) -> void
pub extern("c") fn g_value_set_static_boxed(value: *GValue, v_boxed: gconstpointer) -> void
pub extern("c") fn g_value_take_boxed(value: *GValue, v_boxed: gconstpointer) -> void
pub extern("c") fn g_value_get_boxed(value: *const GValue) -> gpointer
pub extern("c") fn g_value_dup_boxed(value: *const GValue) -> gpointer
pub extern("c") fn g_boxed_type_register_static(name: [*]const gchar, boxed_copy: GBoxedCopyFunc, boxed_free: GBoxedFreeFunc) -> GType

pub extern("c") fn g_closure_get_type() -> GType
pub extern("c") fn g_value_get_type() -> GType
pub extern("c") fn g_strv_get_type() -> GType
pub extern("c") fn g_bytes_get_type() -> GType
pub extern("c") fn g_variant_type_get_gtype() -> GType
pub extern("c") fn g_error_get_type() -> GType
pub extern("c") fn g_hash_table_get_type() -> GType
pub extern("c") fn g_array_get_type() -> GType
pub extern("c") fn g_ptr_array_get_type() -> GType
pub extern("c") fn g_byte_array_get_type() -> GType
pub extern("c") fn g_main_context_get_type() -> GType
pub extern("c") fn g_main_loop_get_type() -> GType
pub extern("c") fn g_source_get_type() -> GType
pub extern("c") fn g_uri_get_type() -> GType
pub extern("c") fn g_date_time_get_type() -> GType
pub extern("c") fn g_key_file_get_type() -> GType
pub extern("c") fn g_mapped_file_get_type() -> GType
pub extern("c") fn g_variant_builder_get_type() -> GType

pub const G_TYPE_CLOSURE: GType = g_closure_get_type()
pub const G_TYPE_VALUE: GType = g_value_get_type()
pub const G_TYPE_STRV: GType = g_strv_get_type()
pub const G_TYPE_BYTES: GType = g_bytes_get_type()
pub const G_TYPE_VARIANT_TYPE: GType = g_variant_type_get_gtype()
pub const G_TYPE_ERROR: GType = g_error_get_type()
pub const G_TYPE_HASH_TABLE: GType = g_hash_table_get_type()
pub const G_TYPE_ARRAY: GType = g_array_get_type()
pub const G_TYPE_PTR_ARRAY: GType = g_ptr_array_get_type()
pub const G_TYPE_BYTE_ARRAY: GType = g_byte_array_get_type()
pub const G_TYPE_MAIN_CONTEXT: GType = g_main_context_get_type()
pub const G_TYPE_MAIN_LOOP: GType = g_main_loop_get_type()
pub const G_TYPE_SOURCE: GType = g_source_get_type()
pub const G_TYPE_URI: GType = g_uri_get_type()
pub const G_TYPE_DATE_TIME: GType = g_date_time_get_type()
pub const G_TYPE_KEY_FILE: GType = g_key_file_get_type()
pub const G_TYPE_MAPPED_FILE: GType = g_mapped_file_get_type()
pub const G_TYPE_VARIANT_BUILDER: GType = g_variant_builder_get_type()

pub fn G_TYPE_IS_BOXED(type_: GType) -> bool { return gtype.G_TYPE_FUNDAMENTAL(type_) == gtype.G_TYPE_BOXED }
pub fn G_VALUE_HOLDS_BOXED(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_BOXED) }
