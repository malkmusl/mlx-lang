// gio/gmemoryoutputstream.h
// mlx-glib: GMemoryOutputStream, an output stream writing into memory (a
// buffer given, or one that grows with a realloc function), whose data
// is taken at the end (steal_data, steal_as_bytes).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gbytes = @import("./gbytes.mlx")
const giotypes = @import("./giotypes.mlx")
const goutputstream = @import("./goutputstream.mlx")

const gpointer = gtypes.gpointer
const gsize = gtypes.gsize
const GOutputStream = giotypes.GOutputStream

pub const GReallocFunc = fn(data: gpointer, size: gsize) -> gpointer

pub const _GMemoryOutputStreamPrivate = struct {}
pub const GMemoryOutputStreamPrivate = _GMemoryOutputStreamPrivate
pub const _GMemoryOutputStream = struct {
    parent_instance: GOutputStream
    priv: *GMemoryOutputStreamPrivate
}
pub const GMemoryOutputStream = _GMemoryOutputStream

pub const _GMemoryOutputStreamClass = struct {
    parent_class: goutputstream.GOutputStreamClass
    _g_reserved1: gpointer
    _g_reserved2: gpointer
    _g_reserved3: gpointer
    _g_reserved4: gpointer
    _g_reserved5: gpointer
}
pub const GMemoryOutputStreamClass = _GMemoryOutputStreamClass

pub extern("c") fn g_memory_output_stream_get_type() -> gtype.GType
pub extern("c") fn g_memory_output_stream_new(data: gpointer, size: gsize, realloc_function: ?GReallocFunc, destroy_function: ?gtypes.GDestroyNotify) -> *GOutputStream
pub extern("c") fn g_memory_output_stream_new_resizable() -> *GOutputStream
pub extern("c") fn g_memory_output_stream_get_data(ostream: *GMemoryOutputStream) -> gpointer
pub extern("c") fn g_memory_output_stream_get_size(ostream: *GMemoryOutputStream) -> gsize
pub extern("c") fn g_memory_output_stream_get_data_size(ostream: *GMemoryOutputStream) -> gsize
pub extern("c") fn g_memory_output_stream_steal_data(ostream: *GMemoryOutputStream) -> gpointer
pub extern("c") fn g_memory_output_stream_steal_as_bytes(ostream: *GMemoryOutputStream) -> *gbytes.GBytes

pub const G_TYPE_MEMORY_OUTPUT_STREAM: gtype.GType = g_memory_output_stream_get_type()
pub fn G_MEMORY_OUTPUT_STREAM(o: anytype) -> *GMemoryOutputStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_MEMORY_OUTPUT_STREAM, GMemoryOutputStream) }
pub fn G_IS_MEMORY_OUTPUT_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_MEMORY_OUTPUT_STREAM) }
