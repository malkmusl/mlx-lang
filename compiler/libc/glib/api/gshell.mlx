// glib/gshell.h
// mlx-glib: the shell's quoting: quoting, unquoting and splitting a
// command line into its words, as /bin/sh reads them.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar

pub const GShellError = enum(c_int) {
    G_SHELL_ERROR_BAD_QUOTING,
    G_SHELL_ERROR_EMPTY_STRING,
    G_SHELL_ERROR_FAILED,
}

pub const G_SHELL_ERROR: gquark.GQuark = g_shell_error_quark()

pub extern("c") fn g_shell_error_quark() -> gquark.GQuark
pub extern("c") fn g_shell_quote(unquoted_string: [*]const gchar) -> [*]gchar
pub extern("c") fn g_shell_unquote(quoted_string: [*]const gchar, error_: ?**gerror.GError) -> ?[*]gchar
pub extern("c") fn g_shell_parse_argv(command_line: [*]const gchar, argcp: ?*gtypes.gint, argvp: ?*[*][*]gchar, error_: ?**gerror.GError) -> gtypes.gboolean
