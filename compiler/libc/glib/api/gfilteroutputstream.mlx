// gio/gfilteroutputstream.h
// mlx-glib: GFilterOutputStream, an output stream over another (its base
// stream, closed with it unless told otherwise).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")
const goutputstream = @import("./goutputstream.mlx")

const gpointer = gtypes.gpointer
const GOutputStream = giotypes.GOutputStream

pub const _GFilterOutputStream = struct {
    parent_instance: GOutputStream
    base_stream: *GOutputStream
}
pub const GFilterOutputStream = _GFilterOutputStream

pub const _GFilterOutputStreamClass = struct {
    parent_class: goutputstream.GOutputStreamClass
    _g_reserved1: gpointer
    _g_reserved2: gpointer
    _g_reserved3: gpointer
}
pub const GFilterOutputStreamClass = _GFilterOutputStreamClass

pub extern("c") fn g_filter_output_stream_get_type() -> gtype.GType
pub extern("c") fn g_filter_output_stream_get_base_stream(stream: *GFilterOutputStream) -> *GOutputStream
pub extern("c") fn g_filter_output_stream_get_close_base_stream(stream: *GFilterOutputStream) -> gtypes.gboolean
pub extern("c") fn g_filter_output_stream_set_close_base_stream(stream: *GFilterOutputStream, close_base: gtypes.gboolean) -> void

pub const G_TYPE_FILTER_OUTPUT_STREAM: gtype.GType = g_filter_output_stream_get_type()
pub fn G_FILTER_OUTPUT_STREAM(o: anytype) -> *GFilterOutputStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_FILTER_OUTPUT_STREAM, GFilterOutputStream) }
pub fn G_IS_FILTER_OUTPUT_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_FILTER_OUTPUT_STREAM) }
