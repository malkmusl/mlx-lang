// glib/gfileutils.h
// mlx-glib: files as GLib reads and writes them whole, their tests, and
// temporary directories; failures are G_FILE_ERROR errors.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar
const gint = gtypes.gint
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const gboolean = gtypes.gboolean
const GError = gerror.GError

pub const GFileError = enum(c_int) {
    G_FILE_ERROR_EXIST,
    G_FILE_ERROR_ISDIR,
    G_FILE_ERROR_ACCES,
    G_FILE_ERROR_NAMETOOLONG,
    G_FILE_ERROR_NOENT,
    G_FILE_ERROR_NOTDIR,
    G_FILE_ERROR_NXIO,
    G_FILE_ERROR_NODEV,
    G_FILE_ERROR_ROFS,
    G_FILE_ERROR_TXTBSY,
    G_FILE_ERROR_FAULT,
    G_FILE_ERROR_LOOP,
    G_FILE_ERROR_NOSPC,
    G_FILE_ERROR_NOMEM,
    G_FILE_ERROR_MFILE,
    G_FILE_ERROR_NFILE,
    G_FILE_ERROR_BADF,
    G_FILE_ERROR_INVAL,
    G_FILE_ERROR_PIPE,
    G_FILE_ERROR_AGAIN,
    G_FILE_ERROR_INTR,
    G_FILE_ERROR_IO,
    G_FILE_ERROR_PERM,
    G_FILE_ERROR_NOSYS,
    G_FILE_ERROR_FAILED,
}

pub const GFileTest = enum(c_int) {
    G_FILE_TEST_IS_REGULAR = 1,
    G_FILE_TEST_IS_SYMLINK = 2,
    G_FILE_TEST_IS_DIR = 4,
    G_FILE_TEST_IS_EXECUTABLE = 8,
    G_FILE_TEST_EXISTS = 16,
}

pub const GFileSetContentsFlags = enum(c_int) {
    G_FILE_SET_CONTENTS_NONE = 0,
    G_FILE_SET_CONTENTS_CONSISTENT = 1,
    G_FILE_SET_CONTENTS_DURABLE = 2,
    G_FILE_SET_CONTENTS_ONLY_EXISTING = 4,
}

pub const G_FILE_ERROR: gquark.GQuark = g_file_error_quark()

pub extern("c") fn g_file_error_quark() -> gquark.GQuark
pub extern("c") fn g_file_error_from_errno(err_no: gint) -> GFileError
pub extern("c") fn g_file_test(filename: [*]const gchar, test_: GFileTest) -> gboolean
pub extern("c") fn g_file_get_contents(filename: [*]const gchar, contents: *[*]gchar, length: ?*gsize, error_: ?**GError) -> gboolean
pub extern("c") fn g_file_set_contents(filename: [*]const gchar, contents: [*]const gchar, length: gssize, error_: ?**GError) -> gboolean
pub extern("c") fn g_file_set_contents_full(filename: [*]const gchar, contents: [*]const gchar, length: gssize, flags: GFileSetContentsFlags, mode: c_int, error_: ?**GError) -> gboolean
pub extern("c") fn g_file_read_link(filename: [*]const gchar, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_mkdtemp(tmpl: [*]gchar) -> ?[*]gchar
pub extern("c") fn g_mkdtemp_full(tmpl: [*]gchar, mode: gint) -> ?[*]gchar
pub extern("c") fn g_mkstemp(tmpl: [*]gchar) -> gint
pub extern("c") fn g_mkstemp_full(tmpl: [*]gchar, flags: gint, mode: gint) -> gint
pub extern("c") fn g_file_open_tmp(tmpl: ?[*]const gchar, name_used: ?*[*]gchar, error_: ?**GError) -> gint
pub extern("c") fn g_dir_make_tmp(tmpl: ?[*]const gchar, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_mkdir_with_parents(pathname: [*]const gchar, mode: gint) -> gint
