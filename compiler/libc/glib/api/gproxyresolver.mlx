// gio/gproxyresolver.h
// mlx-glib: GProxyResolver, the proxies to reach a URI through. The
// default resolver knows no proxy settings (no GSettings, no environment):
// every URI is reached directly ("direct://"), as GLib's dummy resolver
// says, and it reports itself as not supported.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GProxyResolver = giotypes.GProxyResolver

pub const _GProxyResolverInterface = struct {
    g_iface: gtype.GTypeInterface
    is_supported: ?fn(resolver: *GProxyResolver) -> gboolean
    lookup: ?fn(resolver: *GProxyResolver, uri: [*]const gchar, cancellable: ?*GCancellable, error_: ?**GError) -> ?*?[*]gchar
    lookup_async: ?fn(resolver: *GProxyResolver, uri: [*]const gchar, cancellable: ?*GCancellable, callback: ?giotypes.GAsyncReadyCallback, user_data: gpointer) -> void
    lookup_finish: ?fn(resolver: *GProxyResolver, result: *GAsyncResult, error_: ?**GError) -> ?*?[*]gchar
}
pub const GProxyResolverInterface = _GProxyResolverInterface

pub extern("c") fn g_proxy_resolver_get_type() -> gtype.GType
pub extern("c") fn g_proxy_resolver_get_default() -> *GProxyResolver
pub extern("c") fn g_proxy_resolver_is_supported(resolver: *GProxyResolver) -> gboolean
pub extern("c") fn g_proxy_resolver_lookup(resolver: *GProxyResolver, uri: [*]const gchar, cancellable: ?*GCancellable, error_: ?**GError) -> ?*?[*]gchar
pub extern("c") fn g_proxy_resolver_lookup_async(resolver: *GProxyResolver, uri: [*]const gchar, cancellable: ?*GCancellable, callback: ?giotypes.GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_proxy_resolver_lookup_finish(resolver: *GProxyResolver, result: *GAsyncResult, error_: ?**GError) -> ?*?[*]gchar

pub const G_TYPE_PROXY_RESOLVER: gtype.GType = g_proxy_resolver_get_type()
pub fn G_PROXY_RESOLVER(o: anytype) -> *GProxyResolver { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_PROXY_RESOLVER, GProxyResolver) }
pub fn G_IS_PROXY_RESOLVER(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_PROXY_RESOLVER) }
