// gobject/gclosure.h
// mlx-glib: closures, a callback and its data called through a
// marshaller with GValues (what signals call), and the C closure of a
// plain C function. A closure's first word holds GLib's bit fields: the
// reference count (15 bits), then the counts of notifiers and the
// floating, marshalling and invalid bits.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gvalue = @import("./gvalue.mlx")

const gpointer = gtypes.gpointer
const guint = gtypes.guint
const gboolean = gtypes.gboolean
const GValue = gvalue.GValue

pub const GCallback = fn() -> void
pub const GClosureNotify = fn(data: gpointer, closure: *GClosure) -> void
pub const GClosureMarshal = fn(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
pub const GVaClosureMarshal = fn(closure: *GClosure, return_value: ?*GValue, instance: gpointer, args: gtypes.c_va_list, marshal_data: gpointer, n_params: c_int, param_types: *gtype.GType) -> void

pub const _GClosureNotifyData = struct {
    data: gpointer
    notify: GClosureNotify
}
pub const GClosureNotifyData = _GClosureNotifyData

pub const _GClosure = struct {
    bits: guint
    marshal: fn(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
    data: gpointer
    notifiers: *GClosureNotifyData
}
pub const GClosure = _GClosure

pub const _GCClosure = struct {
    closure: GClosure
    callback: gpointer
}
pub const GCClosure = _GCClosure

pub fn G_CALLBACK(f: anytype) -> GCallback { return @ptrCast(GCallback, f) }
pub fn G_CLOSURE_NEEDS_MARSHAL(closure: anytype) -> bool { return @ptrCast(*GClosure, closure).*.marshal == null }
pub fn G_CCLOSURE_SWAP_DATA(cclosure: anytype) -> bool { return (@ptrCast(*GClosure, cclosure).*.bits & 536870912) != 0 }

pub extern("c") fn g_cclosure_new(callback_func: GCallback, user_data: gpointer, destroy_data: GClosureNotify) -> *GClosure
pub extern("c") fn g_cclosure_new_swap(callback_func: GCallback, user_data: gpointer, destroy_data: GClosureNotify) -> *GClosure
pub extern("c") fn g_signal_type_cclosure_new(itype: gtype.GType, struct_offset: guint) -> *GClosure
pub extern("c") fn g_closure_ref(closure: *GClosure) -> *GClosure
pub extern("c") fn g_closure_sink(closure: *GClosure) -> void
pub extern("c") fn g_closure_unref(closure: *GClosure) -> void
pub extern("c") fn g_closure_new_simple(sizeof_closure: guint, data: gpointer) -> *GClosure
pub extern("c") fn g_closure_add_finalize_notifier(closure: *GClosure, notify_data: gpointer, notify_func: GClosureNotify) -> void
pub extern("c") fn g_closure_remove_finalize_notifier(closure: *GClosure, notify_data: gpointer, notify_func: GClosureNotify) -> void
pub extern("c") fn g_closure_add_invalidate_notifier(closure: *GClosure, notify_data: gpointer, notify_func: GClosureNotify) -> void
pub extern("c") fn g_closure_remove_invalidate_notifier(closure: *GClosure, notify_data: gpointer, notify_func: GClosureNotify) -> void
pub extern("c") fn g_closure_set_marshal(closure: *GClosure, marshal: GClosureMarshal) -> void
pub extern("c") fn g_closure_set_meta_marshal(closure: *GClosure, marshal_data: gpointer, meta_marshal: GClosureMarshal) -> void
pub extern("c") fn g_closure_invalidate(closure: *GClosure) -> void
pub extern("c") fn g_closure_invoke(closure: *GClosure, return_value: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer) -> void
pub extern("c") fn g_cclosure_marshal_generic(closure: *GClosure, return_gvalue: ?*GValue, n_param_values: guint, param_values: *const GValue, invocation_hint: gpointer, marshal_data: gpointer) -> void
