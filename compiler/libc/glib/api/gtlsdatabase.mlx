// gio/gtlsdatabase.h
// mlx-glib: GTlsDatabase, the certificates a TLS backend trusts: the
// backend's default one (the system's CA bundle) and file databases.
// A chain is verified as GnuTLS verifies it: up to an anchor, the
// signatures, the validity, the identity (RFC 6125).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")
const gsocketconnectable = @import("./gsocketconnectable.mlx")

const gchar = gtypes.gchar
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GTlsDatabase = giotypes.GTlsDatabase
const GTlsCertificate = giotypes.GTlsCertificate
const GTlsInteraction = giotypes.GTlsInteraction
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback
const GSocketConnectable = gsocketconnectable.GSocketConnectable

pub const G_TLS_DATABASE_PURPOSE_AUTHENTICATE_SERVER: []const u8 = "1.3.6.1.5.5.7.3.1"
pub const G_TLS_DATABASE_PURPOSE_AUTHENTICATE_CLIENT: []const u8 = "1.3.6.1.5.5.7.3.2"

pub extern("c") fn g_tls_database_get_type() -> gtype.GType
pub extern("c") fn g_tls_database_verify_chain(self: *GTlsDatabase, chain: *GTlsCertificate, purpose: [*]const gchar, identity: ?*GSocketConnectable, interaction: ?*GTlsInteraction, flags: gioenums.GTlsDatabaseVerifyFlags, cancellable: ?*GCancellable, error_: ?**GError) -> gioenums.GTlsCertificateFlags
pub extern("c") fn g_tls_database_verify_chain_async(self: *GTlsDatabase, chain: *GTlsCertificate, purpose: [*]const gchar, identity: ?*GSocketConnectable, interaction: ?*GTlsInteraction, flags: gioenums.GTlsDatabaseVerifyFlags, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_tls_database_verify_chain_finish(self: *GTlsDatabase, result: *GAsyncResult, error_: ?**GError) -> gioenums.GTlsCertificateFlags

pub const G_TYPE_TLS_DATABASE: gtype.GType = g_tls_database_get_type()
pub fn G_TLS_DATABASE(o: anytype) -> *GTlsDatabase { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TLS_DATABASE, GTlsDatabase) }
pub fn G_IS_TLS_DATABASE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TLS_DATABASE) }
