// gio/ginetsocketaddress.h
// mlx-glib: GInetSocketAddress, an inet address and a port.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")
const ginetaddress = @import("./ginetaddress.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const guint8 = gtypes.guint8
const guint16 = gtypes.guint16
const guint32 = gtypes.guint32
const gint = gtypes.gint
const guint = gtypes.guint
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GObject = gobject.GObject
const GCancellable = giotypes.GCancellable
const GSocketAddress = giotypes.GSocketAddress
const GSocketConnection = giotypes.GSocketConnection
const GSocket = giotypes.GSocket
const GAsyncResult = giotypes.GAsyncResult

pub const _GInetSocketAddress = struct {}
pub const GInetSocketAddress = _GInetSocketAddress

pub extern("c") fn g_inet_socket_address_get_type() -> gtype.GType
pub extern("c") fn g_inet_socket_address_new(address: *ginetaddress.GInetAddress, port: guint16) -> *GSocketAddress
pub extern("c") fn g_inet_socket_address_new_from_string(address: [*]const gchar, port: guint) -> ?*GSocketAddress
pub extern("c") fn g_inet_socket_address_get_address(address: *GInetSocketAddress) -> *ginetaddress.GInetAddress
pub extern("c") fn g_inet_socket_address_get_port(address: *GInetSocketAddress) -> guint16
pub extern("c") fn g_inet_socket_address_get_flowinfo(address: *GInetSocketAddress) -> guint32
pub extern("c") fn g_inet_socket_address_get_scope_id(address: *GInetSocketAddress) -> guint32

pub const G_TYPE_INET_SOCKET_ADDRESS: gtype.GType = g_inet_socket_address_get_type()
pub fn G_INET_SOCKET_ADDRESS(o: anytype) -> *GInetSocketAddress { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_INET_SOCKET_ADDRESS, GInetSocketAddress) }
pub fn G_IS_INET_SOCKET_ADDRESS(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_INET_SOCKET_ADDRESS) }
