// gio/gresolver.h
// mlx-glib: GResolver, names to addresses and back: the default resolver
// asks the C library (getaddrinfo, getnameinfo) in a thread for the
// asynchronous calls, as GIO's threaded resolver does; a subclass (WebKit's
// cached resolver) overrides the class's functions.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gquark = @import("./gquark.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const glist = @import("./glist.mlx")
const giotypes = @import("./giotypes.mlx")
const ginetaddress = @import("./ginetaddress.mlx")

const gchar = gtypes.gchar
const guint = gtypes.guint
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GList = glist.GList
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback
const GInetAddress = ginetaddress.GInetAddress

pub const GResolverNameLookupFlags = enum(c_int) {
    G_RESOLVER_NAME_LOOKUP_FLAGS_DEFAULT = 0,
    G_RESOLVER_NAME_LOOKUP_FLAGS_IPV4_ONLY = 1,
    G_RESOLVER_NAME_LOOKUP_FLAGS_IPV6_ONLY = 2,
}

pub const GResolverRecordType = enum(c_int) {
    G_RESOLVER_RECORD_SRV = 1,
    G_RESOLVER_RECORD_MX,
    G_RESOLVER_RECORD_TXT,
    G_RESOLVER_RECORD_SOA,
    G_RESOLVER_RECORD_NS,
}

pub const GResolverError = enum(c_int) {
    G_RESOLVER_ERROR_NOT_FOUND,
    G_RESOLVER_ERROR_TEMPORARY_FAILURE,
    G_RESOLVER_ERROR_INTERNAL,
}

pub const _GResolver = struct {
    parent_instance: gobject.GObject
    priv: gpointer
}
pub const GResolver = _GResolver

pub const _GResolverClass = struct {
    parent_class: gobject.GObjectClass
    reload: ?fn(resolver: *GResolver) -> void
    lookup_by_name: ?fn(resolver: *GResolver, hostname: [*]const gchar, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GList
    lookup_by_name_async: ?fn(resolver: *GResolver, hostname: [*]const gchar, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    lookup_by_name_finish: ?fn(resolver: *GResolver, result: *GAsyncResult, error_: ?**GError) -> ?*GList
    lookup_by_address: ?fn(resolver: *GResolver, address: *GInetAddress, cancellable: ?*GCancellable, error_: ?**GError) -> ?[*]gchar
    lookup_by_address_async: ?fn(resolver: *GResolver, address: *GInetAddress, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    lookup_by_address_finish: ?fn(resolver: *GResolver, result: *GAsyncResult, error_: ?**GError) -> ?[*]gchar
    lookup_service: ?fn(resolver: *GResolver, rrname: [*]const gchar, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GList
    lookup_service_async: ?fn(resolver: *GResolver, rrname: [*]const gchar, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    lookup_service_finish: ?fn(resolver: *GResolver, result: *GAsyncResult, error_: ?**GError) -> ?*GList
    lookup_records: ?fn(resolver: *GResolver, rrname: [*]const gchar, record_type: GResolverRecordType, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GList
    lookup_records_async: ?fn(resolver: *GResolver, rrname: [*]const gchar, record_type: GResolverRecordType, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    lookup_records_finish: ?fn(resolver: *GResolver, result: *GAsyncResult, error_: ?**GError) -> ?*GList
    lookup_by_name_with_flags_async: ?fn(resolver: *GResolver, hostname: [*]const gchar, flags: GResolverNameLookupFlags, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    lookup_by_name_with_flags_finish: ?fn(resolver: *GResolver, result: *GAsyncResult, error_: ?**GError) -> ?*GList
    lookup_by_name_with_flags: ?fn(resolver: *GResolver, hostname: [*]const gchar, flags: GResolverNameLookupFlags, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GList
}
pub const GResolverClass = _GResolverClass

pub extern("c") fn g_resolver_get_type() -> gtype.GType
pub extern("c") fn g_resolver_error_quark() -> gquark.GQuark
pub extern("c") fn g_resolver_get_default() -> *GResolver
pub extern("c") fn g_resolver_set_default(resolver: *GResolver) -> void
pub extern("c") fn g_resolver_lookup_by_name(resolver: *GResolver, hostname: [*]const gchar, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GList
pub extern("c") fn g_resolver_lookup_by_name_async(resolver: *GResolver, hostname: [*]const gchar, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_resolver_lookup_by_name_finish(resolver: *GResolver, result: *GAsyncResult, error_: ?**GError) -> ?*GList
pub extern("c") fn g_resolver_lookup_by_name_with_flags(resolver: *GResolver, hostname: [*]const gchar, flags: GResolverNameLookupFlags, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GList
pub extern("c") fn g_resolver_lookup_by_name_with_flags_async(resolver: *GResolver, hostname: [*]const gchar, flags: GResolverNameLookupFlags, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_resolver_lookup_by_name_with_flags_finish(resolver: *GResolver, result: *GAsyncResult, error_: ?**GError) -> ?*GList
pub extern("c") fn g_resolver_free_addresses(addresses: ?*GList) -> void
pub extern("c") fn g_resolver_lookup_by_address(resolver: *GResolver, address: *GInetAddress, cancellable: ?*GCancellable, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_resolver_lookup_by_address_async(resolver: *GResolver, address: *GInetAddress, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_resolver_lookup_by_address_finish(resolver: *GResolver, result: *GAsyncResult, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_resolver_lookup_records(resolver: *GResolver, rrname: [*]const gchar, record_type: GResolverRecordType, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GList
pub extern("c") fn g_resolver_lookup_records_async(resolver: *GResolver, rrname: [*]const gchar, record_type: GResolverRecordType, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_resolver_lookup_records_finish(resolver: *GResolver, result: *GAsyncResult, error_: ?**GError) -> ?*GList
pub extern("c") fn g_resolver_get_timeout(resolver: *GResolver) -> guint
pub extern("c") fn g_resolver_set_timeout(resolver: *GResolver, timeout_ms: guint) -> void

pub const G_TYPE_RESOLVER: gtype.GType = g_resolver_get_type()
pub const G_RESOLVER_ERROR: gquark.GQuark = g_resolver_error_quark()
pub fn G_RESOLVER(o: anytype) -> *GResolver { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_RESOLVER, GResolver) }
pub fn G_RESOLVER_CLASS(k: anytype) -> *GResolverClass { return gtype.G_TYPE_CHECK_CLASS_CAST(k, G_TYPE_RESOLVER, GResolverClass) }
pub fn G_IS_RESOLVER(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_RESOLVER) }
pub fn G_RESOLVER_GET_CLASS(o: anytype) -> *GResolverClass { return gtype.G_TYPE_INSTANCE_GET_CLASS(o, G_TYPE_RESOLVER, GResolverClass) }
