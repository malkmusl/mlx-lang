// glib/gkeyfile.h
// mlx-glib: key files (".desktop"-like: [groups] of key=value lines).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gsize = gtypes.gsize
const gint = gtypes.gint
const GError = gerror.GError

pub const _GKeyFile = struct {}
pub const GKeyFile = _GKeyFile

pub const GKeyFileError = enum(c_int) {
    G_KEY_FILE_ERROR_UNKNOWN_ENCODING,
    G_KEY_FILE_ERROR_PARSE,
    G_KEY_FILE_ERROR_NOT_FOUND,
    G_KEY_FILE_ERROR_KEY_NOT_FOUND,
    G_KEY_FILE_ERROR_GROUP_NOT_FOUND,
    G_KEY_FILE_ERROR_INVALID_VALUE,
}

pub const GKeyFileFlags = enum(c_int) {
    G_KEY_FILE_NONE = 0,
    G_KEY_FILE_KEEP_COMMENTS = 1,
    G_KEY_FILE_KEEP_TRANSLATIONS = 2,
}

pub const G_KEY_FILE_ERROR: gquark.GQuark = g_key_file_error_quark()
pub const G_KEY_FILE_DESKTOP_GROUP: []const u8 = "Desktop Entry"

pub extern("c") fn g_key_file_error_quark() -> gquark.GQuark
pub extern("c") fn g_key_file_new() -> *GKeyFile
pub extern("c") fn g_key_file_ref(key_file: *GKeyFile) -> *GKeyFile
pub extern("c") fn g_key_file_unref(key_file: *GKeyFile) -> void
pub extern("c") fn g_key_file_free(key_file: *GKeyFile) -> void
pub extern("c") fn g_key_file_set_list_separator(key_file: *GKeyFile, separator: gchar) -> void
pub extern("c") fn g_key_file_load_from_file(key_file: *GKeyFile, file: [*]const gchar, flags: GKeyFileFlags, error_: ?**GError) -> gboolean
pub extern("c") fn g_key_file_load_from_data(key_file: *GKeyFile, data: [*]const gchar, length: gsize, flags: GKeyFileFlags, error_: ?**GError) -> gboolean
pub extern("c") fn g_key_file_to_data(key_file: *GKeyFile, length: ?*gsize, error_: ?**GError) -> [*]gchar
pub extern("c") fn g_key_file_save_to_file(key_file: *GKeyFile, filename: [*]const gchar, error_: ?**GError) -> gboolean
pub extern("c") fn g_key_file_get_start_group(key_file: *GKeyFile) -> ?[*]gchar
pub extern("c") fn g_key_file_get_groups(key_file: *GKeyFile, length: ?*gsize) -> [*][*]gchar
pub extern("c") fn g_key_file_get_keys(key_file: *GKeyFile, group_name: [*]const gchar, length: ?*gsize, error_: ?**GError) -> ?[*][*]gchar
pub extern("c") fn g_key_file_has_group(key_file: *GKeyFile, group_name: [*]const gchar) -> gboolean
pub extern("c") fn g_key_file_has_key(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, error_: ?**GError) -> gboolean
pub extern("c") fn g_key_file_get_value(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_key_file_set_value(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, value: [*]const gchar) -> void
pub extern("c") fn g_key_file_get_string(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_key_file_set_string(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, text: [*]const gchar) -> void
pub extern("c") fn g_key_file_get_boolean(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, error_: ?**GError) -> gboolean
pub extern("c") fn g_key_file_set_boolean(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, value: gboolean) -> void
pub extern("c") fn g_key_file_get_integer(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, error_: ?**GError) -> gint
pub extern("c") fn g_key_file_set_integer(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, value: gint) -> void
pub extern("c") fn g_key_file_get_int64(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, error_: ?**GError) -> gtypes.gint64
pub extern("c") fn g_key_file_get_uint64(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, error_: ?**GError) -> gtypes.guint64
pub extern("c") fn g_key_file_get_double(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, error_: ?**GError) -> gtypes.gdouble
pub extern("c") fn g_key_file_get_string_list(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, length: ?*gsize, error_: ?**GError) -> ?[*][*]gchar
pub extern("c") fn g_key_file_get_locale_string(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, locale: ?[*]const gchar, error_: ?**GError) -> ?[*]gchar
pub extern("c") fn g_key_file_remove_group(key_file: *GKeyFile, group_name: [*]const gchar, error_: ?**GError) -> gboolean
pub extern("c") fn g_key_file_remove_key(key_file: *GKeyFile, group_name: [*]const gchar, key: [*]const gchar, error_: ?**GError) -> gboolean
