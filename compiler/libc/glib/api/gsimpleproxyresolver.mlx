// gio/gsimpleproxyresolver.h
// mlx-glib: GSimpleProxyResolver, a proxy resolver of a default proxy,
// proxies by URI scheme and hosts reached directly (names, domains with a
// leading ".", addresses and CIDR ranges, each with an optional port).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gpointer = gtypes.gpointer

pub const _GSimpleProxyResolver = struct {
    parent_instance: gobject.GObject
    priv: gpointer
}
pub const GSimpleProxyResolver = _GSimpleProxyResolver

pub const _GSimpleProxyResolverClass = struct {
    parent_class: gobject.GObjectClass
    _g_reserved1: ?fn() -> void
    _g_reserved2: ?fn() -> void
    _g_reserved3: ?fn() -> void
    _g_reserved4: ?fn() -> void
    _g_reserved5: ?fn() -> void
}
pub const GSimpleProxyResolverClass = _GSimpleProxyResolverClass

pub extern("c") fn g_simple_proxy_resolver_get_type() -> gtype.GType
pub extern("c") fn g_simple_proxy_resolver_new(default_proxy: ?[*]const gchar, ignore_hosts: ?*?[*]gchar) -> *giotypes.GProxyResolver
pub extern("c") fn g_simple_proxy_resolver_set_default_proxy(resolver: *GSimpleProxyResolver, default_proxy: ?[*]const gchar) -> void
pub extern("c") fn g_simple_proxy_resolver_set_ignore_hosts(resolver: *GSimpleProxyResolver, ignore_hosts: ?*?[*]gchar) -> void
pub extern("c") fn g_simple_proxy_resolver_set_uri_proxy(resolver: *GSimpleProxyResolver, uri_scheme: [*]const gchar, proxy: [*]const gchar) -> void

pub const G_TYPE_SIMPLE_PROXY_RESOLVER: gtype.GType = g_simple_proxy_resolver_get_type()
pub fn G_SIMPLE_PROXY_RESOLVER(o: anytype) -> *GSimpleProxyResolver { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_SIMPLE_PROXY_RESOLVER, GSimpleProxyResolver) }
pub fn G_IS_SIMPLE_PROXY_RESOLVER(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_SIMPLE_PROXY_RESOLVER) }
