// gio/goutputstream.h
// mlx-glib: GOutputStream, a stream of bytes written synchronously or
// asynchronously, flushed, spliced from an input stream and closed; one
// operation at a time.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gbytes = @import("./gbytes.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GBytes = gbytes.GBytes
const GInputStream = giotypes.GInputStream
const GOutputStream = giotypes.GOutputStream
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback
const GOutputStreamSpliceFlags = gioenums.GOutputStreamSpliceFlags

// The class of an output stream, as GIO lays it out.
pub const _GOutputStreamClass = struct {
    parent_class: gobject.GObjectClass
    write_fn: ?fn(stream: *GOutputStream, buffer: ?*const anyopaque, count: gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
    splice: ?fn(stream: *GOutputStream, source: *GInputStream, flags: GOutputStreamSpliceFlags, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
    flush: ?fn(stream: *GOutputStream, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
    close_fn: ?fn(stream: *GOutputStream, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
    write_async: ?fn(stream: *GOutputStream, buffer: ?*const anyopaque, count: gsize, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    write_finish: ?fn(stream: *GOutputStream, result: *GAsyncResult, error_: ?**GError) -> gssize
    splice_async: ?fn(stream: *GOutputStream, source: *GInputStream, flags: GOutputStreamSpliceFlags, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    splice_finish: ?fn(stream: *GOutputStream, result: *GAsyncResult, error_: ?**GError) -> gssize
    flush_async: ?fn(stream: *GOutputStream, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    flush_finish: ?fn(stream: *GOutputStream, result: *GAsyncResult, error_: ?**GError) -> gboolean
    close_async: ?fn(stream: *GOutputStream, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    close_finish: ?fn(stream: *GOutputStream, result: *GAsyncResult, error_: ?**GError) -> gboolean
    writev_fn: gpointer
    writev_async: gpointer
    writev_finish: gpointer
    _g_reserved4: gpointer
    _g_reserved5: gpointer
    _g_reserved6: gpointer
    _g_reserved7: gpointer
    _g_reserved8: gpointer
}
pub const GOutputStreamClass = _GOutputStreamClass

pub extern("c") fn g_output_stream_get_type() -> gtype.GType
pub extern("c") fn g_output_stream_write(stream: *GOutputStream, buffer: ?*const anyopaque, count: gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn g_output_stream_write_all(stream: *GOutputStream, buffer: ?*const anyopaque, count: gsize, bytes_written: ?*gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_output_stream_write_bytes(stream: *GOutputStream, bytes: *GBytes, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn g_output_stream_splice(stream: *GOutputStream, source: *GInputStream, flags: GOutputStreamSpliceFlags, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn g_output_stream_flush(stream: *GOutputStream, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_output_stream_close(stream: *GOutputStream, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_output_stream_write_async(stream: *GOutputStream, buffer: ?*const anyopaque, count: gsize, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_output_stream_write_finish(stream: *GOutputStream, result: *GAsyncResult, error_: ?**GError) -> gssize
pub extern("c") fn g_output_stream_write_all_async(stream: *GOutputStream, buffer: ?*const anyopaque, count: gsize, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_output_stream_write_all_finish(stream: *GOutputStream, result: *GAsyncResult, bytes_written: ?*gsize, error_: ?**GError) -> gboolean
pub extern("c") fn g_output_stream_write_bytes_async(stream: *GOutputStream, bytes: *GBytes, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_output_stream_write_bytes_finish(stream: *GOutputStream, result: *GAsyncResult, error_: ?**GError) -> gssize
pub extern("c") fn g_output_stream_splice_async(stream: *GOutputStream, source: *GInputStream, flags: GOutputStreamSpliceFlags, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_output_stream_splice_finish(stream: *GOutputStream, result: *GAsyncResult, error_: ?**GError) -> gssize
pub extern("c") fn g_output_stream_flush_async(stream: *GOutputStream, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_output_stream_flush_finish(stream: *GOutputStream, result: *GAsyncResult, error_: ?**GError) -> gboolean
pub extern("c") fn g_output_stream_close_async(stream: *GOutputStream, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_output_stream_close_finish(stream: *GOutputStream, result: *GAsyncResult, error_: ?**GError) -> gboolean
pub extern("c") fn g_output_stream_is_closed(stream: *GOutputStream) -> gboolean
pub extern("c") fn g_output_stream_is_closing(stream: *GOutputStream) -> gboolean
pub extern("c") fn g_output_stream_has_pending(stream: *GOutputStream) -> gboolean
pub extern("c") fn g_output_stream_set_pending(stream: *GOutputStream, error_: ?**GError) -> gboolean
pub extern("c") fn g_output_stream_clear_pending(stream: *GOutputStream) -> void

pub const G_TYPE_OUTPUT_STREAM: gtype.GType = g_output_stream_get_type()
pub fn G_OUTPUT_STREAM(o: anytype) -> *GOutputStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_OUTPUT_STREAM, GOutputStream) }
pub fn G_IS_OUTPUT_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_OUTPUT_STREAM) }
pub fn G_OUTPUT_STREAM_CLASS(k: anytype) -> *GOutputStreamClass { return gtype.G_TYPE_CHECK_CLASS_CAST(k, G_TYPE_OUTPUT_STREAM, GOutputStreamClass) }
pub fn G_OUTPUT_STREAM_GET_CLASS(o: anytype) -> *GOutputStreamClass { return gtype.G_TYPE_INSTANCE_GET_CLASS(o, G_TYPE_OUTPUT_STREAM, GOutputStreamClass) }
