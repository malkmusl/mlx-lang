// Threads and what they share (gthread.h, gatomic.h). The locks are
// futex words as GLib's are on Linux: a GMutex's first word is 0 when it
// is free, 1 when it is held, 2 when it is held and waited for. A
// GRecMutex holds its owner's thread id and its depth beside such a
// word, a GCond a sequence number its waiters wait on, a GRWLock (here a
// mutex: readers too take it alone). Thread-local keys are the C
// library's; threads are its threads, with a GThread made for each.
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")

// ---------------------------------------------------------------------------
// Futex locks (for the library's own state too).

pub fn lock(word: usize) -> void {
    const w = m.word32(word)
    const first = @cmpxchgStrong(u32, w, 0, 1, acquire, monotonic)
    if first.0 { return }
    while @atomicRmw(u32, w, xchg, 2, acquire) != 0 {
        _ = sys.futexWait(word, 2, 0)
    }
}

pub fn tryLock(word: usize) -> bool {
    const first = @cmpxchgStrong(u32, m.word32(word), 0, 1, acquire, monotonic)
    return first.0
}

pub fn unlock(word: usize) -> void {
    if @atomicRmw(u32, m.word32(word), xchg, 0, release) == 2 { sys.futexWake(word, 1) }
}

// Waits on the condition word `cond` with the lock `word` held: released
// while waiting, held again after (contended, so that a later unlock
// wakes whoever waits). `timeout` is 0 or the address of a relative
// timespec; whether the wait ended before it ran out.
pub fn wait(cond: usize, word: usize, timeout: usize) -> bool {
    const sequence = @atomicLoad(u32, m.word32(cond), acquire)
    unlock(word)
    const result = sys.futexWait(cond, sequence, timeout)
    while @atomicRmw(u32, m.word32(word), xchg, 2, acquire) != 0 {
        _ = sys.futexWait(word, 2, 0)
    }
    return result != -110
}

pub fn signal(cond: usize) -> void {
    _ = @atomicRmw(u32, m.word32(cond), add, 1, acq_rel)
    sys.futexWake(cond, 1)
}

pub fn broadcast(cond: usize) -> void {
    _ = @atomicRmw(u32, m.word32(cond), add, 1, acq_rel)
    sys.futexWake(cond, 2147483647)
}

// A recursive lock of three words: the owner's thread id, the futex word,
// the depth (the layout of a GRecMutex: a pointer, two integers).
pub fn recursiveLock(r: usize) -> void {
    const me = sys.tid()
    if @atomicLoad(u32, m.word32(r), acquire) == me {
        m.put32(r + 12, m.get32(r + 12) + 1)
        return
    }
    lock(r + 8)
    @atomicStore(u32, m.word32(r), me, release)
    m.put32(r + 12, 1)
}

pub fn recursiveTryLock(r: usize) -> bool {
    const me = sys.tid()
    if @atomicLoad(u32, m.word32(r), acquire) == me {
        m.put32(r + 12, m.get32(r + 12) + 1)
        return true
    }
    if !tryLock(r + 8) { return false }
    @atomicStore(u32, m.word32(r), me, release)
    m.put32(r + 12, 1)
    return true
}

pub fn recursiveUnlock(r: usize) -> void {
    const depth = m.get32(r + 12)
    if depth > 1 {
        m.put32(r + 12, depth - 1)
        return
    }
    m.put32(r + 12, 0)
    @atomicStore(u32, m.word32(r), 0, release)
    unlock(r + 8)
}

export fn g_mutex_init(mutex: usize) -> void { m.put64(mutex, 0) }
export fn g_mutex_clear(mutex: usize) -> void { m.put64(mutex, 0) }
export fn g_mutex_lock(mutex: usize) -> void { lock(mutex) }
export fn g_mutex_trylock(mutex: usize) -> i32 { return if tryLock(mutex) { 1 } else { 0 } }
export fn g_mutex_unlock(mutex: usize) -> void { unlock(mutex) }

export fn g_rec_mutex_init(rec_mutex: usize) -> void { m.zero(rec_mutex, 16) }
export fn g_rec_mutex_clear(rec_mutex: usize) -> void { m.zero(rec_mutex, 16) }
export fn g_rec_mutex_lock(rec_mutex: usize) -> void { recursiveLock(rec_mutex) }
export fn g_rec_mutex_trylock(rec_mutex: usize) -> i32 { return if recursiveTryLock(rec_mutex) { 1 } else { 0 } }
export fn g_rec_mutex_unlock(rec_mutex: usize) -> void { recursiveUnlock(rec_mutex) }

// (A GRWLock: its first word a lock readers and writers take alike.)
export fn g_rw_lock_init(rw_lock: usize) -> void { m.zero(rw_lock, 16) }
export fn g_rw_lock_clear(rw_lock: usize) -> void { m.zero(rw_lock, 16) }
export fn g_rw_lock_writer_lock(rw_lock: usize) -> void { recursiveLock(rw_lock) }
export fn g_rw_lock_writer_trylock(rw_lock: usize) -> i32 { return if recursiveTryLock(rw_lock) { 1 } else { 0 } }
export fn g_rw_lock_writer_unlock(rw_lock: usize) -> void { recursiveUnlock(rw_lock) }
export fn g_rw_lock_reader_lock(rw_lock: usize) -> void { recursiveLock(rw_lock) }
export fn g_rw_lock_reader_trylock(rw_lock: usize) -> i32 { return if recursiveTryLock(rw_lock) { 1 } else { 0 } }
export fn g_rw_lock_reader_unlock(rw_lock: usize) -> void { recursiveUnlock(rw_lock) }

export fn g_cond_init(cond: usize) -> void { m.put64(cond, 0) }
export fn g_cond_clear(cond: usize) -> void { m.put64(cond, 0) }
export fn g_cond_wait(cond: usize, mutex: usize) -> void { _ = wait(cond, mutex, 0) }
export fn g_cond_signal(cond: usize) -> void { signal(cond) }
export fn g_cond_broadcast(cond: usize) -> void { broadcast(cond) }

// Waits until the monotonic time `end_time` (microseconds) at most.
export fn g_cond_wait_until(cond: usize, mutex: usize, end_time: i64) -> i32 {
    const left = end_time - sys.monotonicMicroseconds()
    if left <= 0 {
        unlock(mutex)
        lock(mutex)
        return 0
    }
    const spec = m.raw(16)
    m.putI64(spec, left / 1000000)
    m.putI64(spec + 8, (left % 1000000) * 1000)
    const woken = wait(cond, mutex, spec)
    m.release(spec)
    return if woken { 1 } else { 0 }
}

// ---------------------------------------------------------------------------
// Thread-local keys: a GPrivate's first word is its C library key plus
// one (0 until it is first used), its second the destructor.

var keysLock: u32 = 0

fn keyOf(key: usize) -> u32 {
    const known = @atomicLoad(u64, m.word64(key), acquire)
    if known != 0 { return @intCast(u32, known - 1) }
    lock(@intFromPtr(&keysLock))
    if m.get64(key) == 0 {
        const storage = m.alloc(8)
        _ = sys.pthread_key_create(storage, m.getWord(key + 8))
        @atomicStore(u64, m.word64(key), @intCast(u64, m.get32(storage)) + 1, release)
        m.release(storage)
    }
    unlock(@intFromPtr(&keysLock))
    return @intCast(u32, m.get64(key) - 1)
}

export fn g_private_get(key: usize) -> usize { return sys.pthread_getspecific(keyOf(key)) }
export fn g_private_set(key: usize, value: usize) -> void { _ = sys.pthread_setspecific(keyOf(key), value) }

// Sets the value and destroys the old one.
export fn g_private_replace(key: usize, value: usize) -> void {
    const k = keyOf(key)
    const old = sys.pthread_getspecific(k)
    _ = sys.pthread_setspecific(k, value)
    const notify = m.getWord(key + 8)
    if old != 0 && notify != 0 {
        const destroy: Notify = unsafe { @ptrFromInt(Notify, notify) }
        destroy(old)
    }
}

pub const Notify = fn(usize) -> void

// A key of the library's own (made once): its C library key.
pub fn newKey(destructor: usize) -> u32 {
    const storage = m.alloc(8)
    _ = sys.pthread_key_create(storage, destructor)
    const key = m.get32(storage)
    m.release(storage)
    return key
}

// ---------------------------------------------------------------------------
// One-time initialization: the locations being initialized now, which
// the other threads wait for.

var onceLock: u32 = 0
var onceCond: u32 = 0
var initializing: [64]usize = undefined
var initializingCount: usize = 0

fn isInitializing(location: usize) -> bool {
    var index: usize = 0
    while index < initializingCount {
        if initializing[index] == location { return true }
        index += 1
    }
    return false
}

fn finishInitializing(location: usize) -> void {
    var index: usize = 0
    while index < initializingCount {
        if initializing[index] == location {
            initializing[index] = initializing[initializingCount - 1]
            initializingCount -= 1
            return
        }
        index += 1
    }
}

// Whether the caller is to initialize `location` (a word that is 0
// until it is): only one thread is told so, the others wait until it is
// done.
pub fn onceEnter(location: usize) -> bool {
    if @atomicLoad(u64, m.word64(location), acquire) != 0 { return false }
    const l = @intFromPtr(&onceLock)
    const c = @intFromPtr(&onceCond)
    lock(l)
    var result = false
    if m.get64(location) == 0 {
        if !isInitializing(location) {
            if initializingCount < 64 {
                initializing[initializingCount] = location
                initializingCount += 1
            }
            result = true
        } else {
            while isInitializing(location) { _ = wait(c, l, 0) }
        }
    }
    unlock(l)
    return result
}

pub fn onceLeave(location: usize, value: u64) -> void {
    @atomicStore(u64, m.word64(location), value, release)
    const l = @intFromPtr(&onceLock)
    lock(l)
    finishInitializing(location)
    broadcast(@intFromPtr(&onceCond))
    unlock(l)
}

export fn g_once_init_enter(location: usize) -> i32 { return if onceEnter(location) { 1 } else { 0 } }
export fn g_once_init_leave(location: usize, result: usize) -> void { onceLeave(location, @intCast(u64, result)) }
export fn g_once_init_enter_pointer(location: usize) -> i32 { return if onceEnter(location) { 1 } else { 0 } }
export fn g_once_init_leave_pointer(location: usize, result: usize) -> void { onceLeave(location, @intCast(u64, result)) }

pub const ThreadFunc = fn(usize) -> usize

// GOnce: its status (0 not called, 1 in progress, 2 ready) and result.
export fn g_once_impl(once: usize, func: usize, arg: usize) -> usize {
    const l = @intFromPtr(&onceLock)
    const c = @intFromPtr(&onceCond)
    lock(l)
    while m.get32(once) == 1 { _ = wait(c, l, 0) }
    if m.get32(once) != 2 {
        m.put32(once, 1)
        unlock(l)
        const call: ThreadFunc = unsafe { @ptrFromInt(ThreadFunc, func) }
        const result = call(arg)
        lock(l)
        m.putWord(once + 8, result)
        @atomicStore(u32, m.word32(once), 2, release)
        broadcast(c)
    }
    unlock(l)
    return m.getWord(once + 8)
}

// ---------------------------------------------------------------------------
// Atomics (sequentially consistent).

export fn g_atomic_int_get(atomic: usize) -> i32 { return @bitCast(i32, @atomicLoad(u32, m.word32(atomic), seq_cst)) }
export fn g_atomic_int_set(atomic: usize, newval: i32) -> void { @atomicStore(u32, m.word32(atomic), @bitCast(u32, newval), seq_cst) }
export fn g_atomic_int_inc(atomic: usize) -> void { _ = @atomicRmw(u32, m.word32(atomic), add, 1, seq_cst) }
export fn g_atomic_int_dec_and_test(atomic: usize) -> i32 { return if @atomicRmw(u32, m.word32(atomic), sub, 1, seq_cst) == 1 { 1 } else { 0 } }
export fn g_atomic_int_compare_and_exchange(atomic: usize, oldval: i32, newval: i32) -> i32 {
    const result = @cmpxchgStrong(u32, m.word32(atomic), @bitCast(u32, oldval), @bitCast(u32, newval), seq_cst, seq_cst)
    return if result.0 { 1 } else { 0 }
}
export fn g_atomic_int_exchange(atomic: usize, newval: i32) -> i32 { return @bitCast(i32, @atomicRmw(u32, m.word32(atomic), xchg, @bitCast(u32, newval), seq_cst)) }
export fn g_atomic_int_add(atomic: usize, val: i32) -> i32 { return @bitCast(i32, @atomicRmw(u32, m.word32(atomic), add, @bitCast(u32, val), seq_cst)) }
export fn g_atomic_int_and(atomic: usize, val: u32) -> u32 { return @atomicRmw(u32, m.word32(atomic), and, val, seq_cst) }
export fn g_atomic_int_or(atomic: usize, val: u32) -> u32 { return @atomicRmw(u32, m.word32(atomic), or, val, seq_cst) }
export fn g_atomic_int_xor(atomic: usize, val: u32) -> u32 { return @atomicRmw(u32, m.word32(atomic), xor, val, seq_cst) }
export fn g_atomic_pointer_get(atomic: usize) -> usize { return @intCast(usize, @atomicLoad(u64, m.word64(atomic), seq_cst)) }
export fn g_atomic_pointer_set(atomic: usize, newval: usize) -> void { @atomicStore(u64, m.word64(atomic), @intCast(u64, newval), seq_cst) }
export fn g_atomic_pointer_compare_and_exchange(atomic: usize, oldval: usize, newval: usize) -> i32 {
    const result = @cmpxchgStrong(u64, m.word64(atomic), @intCast(u64, oldval), @intCast(u64, newval), seq_cst, seq_cst)
    return if result.0 { 1 } else { 0 }
}
export fn g_atomic_pointer_exchange(atomic: usize, newval: usize) -> usize { return @intCast(usize, @atomicRmw(u64, m.word64(atomic), xchg, @intCast(u64, newval), seq_cst)) }
export fn g_atomic_pointer_add(atomic: usize, val: i64) -> i64 { return @bitCast(i64, @atomicRmw(u64, m.word64(atomic), add, @bitCast(u64, val), seq_cst)) }
export fn g_atomic_pointer_and(atomic: usize, val: u64) -> u64 { return @atomicRmw(u64, m.word64(atomic), and, val, seq_cst) }
export fn g_atomic_pointer_or(atomic: usize, val: u64) -> u64 { return @atomicRmw(u64, m.word64(atomic), or, val, seq_cst) }

export fn g_atomic_ref_count_init(arc: usize) -> void { m.put32(arc, 1) }
export fn g_atomic_ref_count_inc(arc: usize) -> void { _ = @atomicRmw(u32, m.word32(arc), add, 1, seq_cst) }
export fn g_atomic_ref_count_dec(arc: usize) -> i32 { return if @atomicRmw(u32, m.word32(arc), sub, 1, seq_cst) == 1 { 1 } else { 0 } }
export fn g_atomic_ref_count_compare(arc: usize, val: i32) -> i32 { return if @atomicLoad(u32, m.word32(arc), seq_cst) == @bitCast(u32, val) { 1 } else { 0 } }
// (GLib's grefcount counts down from -1; the C code sees only these.)
export fn g_ref_count_init(rc: usize) -> void { m.putI32(rc, -1) }
export fn g_ref_count_inc(rc: usize) -> void { m.putI32(rc, m.getI32(rc) - 1) }
export fn g_ref_count_dec(rc: usize) -> i32 {
    const value = m.getI32(rc)
    if value == -1 { return 1 }
    m.putI32(rc, value + 1)
    return 0
}
export fn g_ref_count_compare(rc: usize, val: i32) -> i32 { return if m.getI32(rc) == 0 - val { 1 } else { 0 } }

// Reference counts of the library's own records.
pub fn refInc(address: usize) -> void { _ = @atomicRmw(u32, m.word32(address), add, 1, acq_rel) }
pub fn refDec(address: usize) -> bool { return @atomicRmw(u32, m.word32(address), sub, 1, acq_rel) == 1 }

// ---------------------------------------------------------------------------
// Threads. A GThread: the public words (func, data, joinable, priority),
// then the C library's thread, the result, the reference count, whether
// it ended, and its name.
const THREAD_FUNC: usize = 0
const THREAD_DATA: usize = 8
const THREAD_JOINABLE: usize = 16
const THREAD_HANDLE: usize = 24
const THREAD_RESULT: usize = 32
const THREAD_REFS: usize = 40
const THREAD_OURS: usize = 44
const THREAD_NAME: usize = 48
const THREAD_SIZE: usize = 56

var selfKey: u32 = 0
var selfKeyMade: u64 = 0

fn currentKey() -> u32 {
    if onceEnter(@intFromPtr(&selfKeyMade)) {
        selfKey = newKey(@intFromPtr(__mlx_glib_thread_gone))
        onceLeave(@intFromPtr(&selfKeyMade), 1)
    }
    return selfKey
}

// A thread's GThread when it ends: the thread's reference dropped (the
// record of a thread GLib did not start goes then).
export fn __mlx_glib_thread_gone(thread: usize) -> void { unrefThread(thread) }

fn unrefThread(thread: usize) -> void {
    if thread == 0 { return }
    if refDec(thread + THREAD_REFS) {
        m.release(m.getWord(thread + THREAD_NAME))
        m.release(thread)
    }
}

// The thread a GThread starts on: it runs the function and keeps its
// result for g_thread_join.
export fn __mlx_glib_thread_start(thread: usize) -> usize {
    _ = sys.pthread_setspecific(currentKey(), thread)
    const call: ThreadFunc = unsafe { @ptrFromInt(ThreadFunc, m.getWord(thread + THREAD_FUNC)) }
    const result = call(m.getWord(thread + THREAD_DATA))
    m.putWord(thread + THREAD_RESULT, result)
    return result
}

export fn g_thread_new(name: usize, func: usize, data: usize) -> usize {
    const thread = newThread(name, func, data)
    if thread == 0 {
        const text = "GLib: creating a thread failed\n"
        _ = sys.write(2, m.literal(text), text.length)
        m.fatal()
    }
    return thread
}

pub fn newThread(name: usize, func: usize, data: usize) -> usize {
    const thread = m.alloc(THREAD_SIZE)
    m.putWord(thread + THREAD_FUNC, func)
    m.putWord(thread + THREAD_DATA, data)
    m.putI32(thread + THREAD_JOINABLE, 1)
    // One reference for the caller, one for the thread (its key's).
    m.put32(thread + THREAD_REFS, 2)
    m.put32(thread + THREAD_OURS, 1)
    m.putWord(thread + THREAD_NAME, if name == 0 { 0 } else { m.dup(name) })
    _ = currentKey()
    if sys.pthread_create(thread + THREAD_HANDLE, 0, @intFromPtr(__mlx_glib_thread_start), thread) != 0 {
        m.release(m.getWord(thread + THREAD_NAME))
        m.release(thread)
        return 0
    }
    return thread
}

extern("c") fn g_thread_error_quark() -> u32
extern("c") fn g_set_error_literal(err: usize, domain: u32, code: i32, message: usize) -> void
extern("c") fn strerror(errnum: i32) -> usize

// As g_thread_new, but a thread the system cannot make is an error
// (G_THREAD_ERROR_AGAIN) rather than the end of the program.
export fn g_thread_try_new(name: usize, func: usize, data: usize, err: usize) -> usize {
    const thread = newThread(name, func, data)
    if thread == 0 {
        var t = m.text()
        m.pushText(&t, "Error creating thread: ")
        m.pushC(&t, strerror(11))
        g_set_error_literal(err, g_thread_error_quark(), 0, t.address)
        m.dispose(&t)
    }
    return thread
}

export fn g_thread_join(thread: usize) -> usize {
    _ = sys.pthread_join(m.getWord(thread + THREAD_HANDLE), 0)
    m.putI32(thread + THREAD_JOINABLE, 0)
    const result = m.getWord(thread + THREAD_RESULT)
    unrefThread(thread)
    return result
}

export fn g_thread_ref(thread: usize) -> usize {
    refInc(thread + THREAD_REFS)
    return thread
}

export fn g_thread_unref(thread: usize) -> void {
    // (A thread no one will join: detached, its resources go when it ends.)
    if m.get32(thread + THREAD_REFS) == 2 && m.getI32(thread + THREAD_JOINABLE) != 0 && m.get32(thread + THREAD_OURS) != 0 {
        _ = sys.pthread_detach(m.getWord(thread + THREAD_HANDLE))
        m.putI32(thread + THREAD_JOINABLE, 0)
    }
    unrefThread(thread)
}

export fn g_thread_self() -> usize {
    const key = currentKey()
    var thread = sys.pthread_getspecific(key)
    if thread == 0 {
        thread = m.alloc(THREAD_SIZE)
        m.putWord(thread + THREAD_HANDLE, sys.pthread_self())
        m.put32(thread + THREAD_REFS, 1)
        _ = sys.pthread_setspecific(key, thread)
    }
    return thread
}

export fn g_thread_exit(retval: usize) -> void {
    const thread = g_thread_self()
    m.putWord(thread + THREAD_RESULT, retval)
    sys.pthread_exit(retval)
}

export fn g_thread_yield() -> void { _ = sys.sched_yield() }

export fn g_get_num_processors() -> u32 {
    const count = sys.sysconf(84)
    return if count > 0 { @intCast(u32, count) } else { 1 }
}
