// Command line options (goption.h). A group: its name (0), description
// (8), help description (16), user data (24), destroy notify (32), its
// entries (40, GOptionEntry's of 48 bytes copied in) and their count
// (48), translation domain (56), translate function, data and notify (64,
// 72, 80), pre-parse and post-parse hooks (88, 96), error hook (104),
// references (112). A context: parameter string (0), summary (8),
// description (16), the groups (24, a Words), the main group (48), help
// enabled (56), unknown options ignored (60), strict POSIX (64),
// translation domain (72), translate function, data and notify (80, 88,
// 96).
//
// Parsing reads argv once: options of the main group by their names,
// another group's also by GROUP-NAME, short options alone or together
// (-vc: the last may take the next argument), `--` ending the options.
// What an entry points to is changed as it is met, each first change
// noted, so that an error puts every value back and frees what was made;
// argv is rewritten only when all went well (and the post-parse hooks
// said so). The texts of the errors are GLib's.
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const errors = @import("./errors.mlx")

extern("c") fn strtoll(text: usize, end: usize, base: i32) -> i64
extern("c") fn strtod(text: usize, end: usize) -> f64

const G_NAME: usize = 0
const G_DESCRIPTION: usize = 8
const G_HELP: usize = 16
const G_DATA: usize = 24
const G_DESTROY: usize = 32
const G_ENTRIES: usize = 40
const G_COUNT: usize = 48
const G_DOMAIN: usize = 56
const G_TRANSLATE: usize = 64
const G_TRANSLATE_DATA: usize = 72
const G_TRANSLATE_NOTIFY: usize = 80
const G_PRE: usize = 88
const G_POST: usize = 96
const G_ERROR_HOOK: usize = 104
const G_REFS: usize = 112
const G_SIZE: usize = 120

const C_PARAMETER: usize = 0
const C_SUMMARY: usize = 8
const C_DESCRIPTION: usize = 16
const C_GROUPS: usize = 24
const C_MAIN: usize = 48
const C_HELP: usize = 56
const C_IGNORE: usize = 60
const C_STRICT: usize = 64
const C_DOMAIN: usize = 72
const C_TRANSLATE: usize = 80
const C_TRANSLATE_DATA: usize = 88
const C_TRANSLATE_NOTIFY: usize = 96
const C_SIZE: usize = 104

// GOptionEntry.
const E_LONG: usize = 0
const E_SHORT: usize = 8
const E_FLAGS: usize = 12
const E_ARG: usize = 16
const E_DATA: usize = 24
const E_SIZE: usize = 48

const ARG_NONE: i32 = 0
const ARG_STRING: i32 = 1
const ARG_INT: i32 = 2
const ARG_CALLBACK: i32 = 3
const ARG_FILENAME: i32 = 4
const ARG_STRING_ARRAY: i32 = 5
const ARG_FILENAME_ARRAY: i32 = 6
const ARG_DOUBLE: i32 = 7
const ARG_INT64: i32 = 8

const FLAG_REVERSE: i32 = 4
const FLAG_NO_ARG: i32 = 8
const FLAG_OPTIONAL_ARG: i32 = 32

const ERROR_UNKNOWN_OPTION: i32 = 0
const ERROR_BAD_VALUE: i32 = 1
const ERROR_FAILED: i32 = 2

const ERANGE: i32 = 34

pub const Notify = fn(usize) -> void
const ArgFunc = fn(usize, usize, usize, usize) -> i32
const ParseFunc = fn(usize, usize, usize, usize) -> i32
const ErrorFunc = fn(usize, usize, usize, usize) -> void

export fn g_option_error_quark() -> u32 { return errors.quarkLiteral("g-option-context-error-quark") }

fn dupOrNull(text: usize) -> usize { return if text == 0 { 0 } else { m.dup(text) } }

// ---------------------------------------------------------------------------
// Groups

export fn g_option_group_new(name: usize, description: usize, help: usize, data: usize, destroy: usize) -> usize {
    const g = m.alloc(G_SIZE)
    m.zero(g, G_SIZE)
    m.putWord(g + G_NAME, dupOrNull(name))
    m.putWord(g + G_DESCRIPTION, dupOrNull(description))
    m.putWord(g + G_HELP, dupOrNull(help))
    m.putWord(g + G_DATA, data)
    m.putWord(g + G_DESTROY, destroy)
    m.putWord(g + G_REFS, 1)
    return g
}

export fn g_option_group_ref(g: usize) -> usize {
    m.putWord(g + G_REFS, m.getWord(g + G_REFS) + 1)
    return g
}

export fn g_option_group_unref(g: usize) -> void {
    const refs = m.getWord(g + G_REFS)
    if refs > 1 {
        m.putWord(g + G_REFS, refs - 1)
        return
    }
    if m.getWord(g + G_DESTROY) != 0 {
        const notify: Notify = unsafe { @ptrFromInt(Notify, m.getWord(g + G_DESTROY)) }
        notify(m.getWord(g + G_DATA))
    }
    if m.getWord(g + G_TRANSLATE_NOTIFY) != 0 {
        const notify: Notify = unsafe { @ptrFromInt(Notify, m.getWord(g + G_TRANSLATE_NOTIFY)) }
        notify(m.getWord(g + G_TRANSLATE_DATA))
    }
    m.release(m.getWord(g + G_NAME))
    m.release(m.getWord(g + G_DESCRIPTION))
    m.release(m.getWord(g + G_HELP))
    m.release(m.getWord(g + G_DOMAIN))
    m.release(m.getWord(g + G_ENTRIES))
    m.release(g)
}

export fn g_option_group_free(g: usize) -> void { g_option_group_unref(g) }

export fn g_option_group_add_entries(g: usize, entries: usize) -> void {
    var added: usize = 0
    while m.getWord(entries + added * E_SIZE + E_LONG) != 0 { added += 1 }
    const count = m.getWord(g + G_COUNT)
    const block = m.grow(m.getWord(g + G_ENTRIES), (count + added) * E_SIZE + 1)
    m.copy(block + count * E_SIZE, entries, added * E_SIZE)
    m.putWord(g + G_ENTRIES, block)
    m.putWord(g + G_COUNT, count + added)
}

export fn g_option_group_set_parse_hooks(g: usize, pre: usize, post: usize) -> void {
    m.putWord(g + G_PRE, pre)
    m.putWord(g + G_POST, post)
}

export fn g_option_group_set_error_hook(g: usize, hook: usize) -> void { m.putWord(g + G_ERROR_HOOK, hook) }

export fn g_option_group_set_translate_func(g: usize, func: usize, data: usize, notify: usize) -> void {
    if m.getWord(g + G_TRANSLATE_NOTIFY) != 0 {
        const old: Notify = unsafe { @ptrFromInt(Notify, m.getWord(g + G_TRANSLATE_NOTIFY)) }
        old(m.getWord(g + G_TRANSLATE_DATA))
    }
    m.putWord(g + G_TRANSLATE, func)
    m.putWord(g + G_TRANSLATE_DATA, data)
    m.putWord(g + G_TRANSLATE_NOTIFY, notify)
}

export fn g_option_group_set_translation_domain(g: usize, domain: usize) -> void {
    m.release(m.getWord(g + G_DOMAIN))
    m.putWord(g + G_DOMAIN, dupOrNull(domain))
}

// ---------------------------------------------------------------------------
// Contexts

fn groups(c: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, c + C_GROUPS) } }

export fn g_option_context_new(parameter: usize) -> usize {
    const c = m.alloc(C_SIZE)
    m.zero(c, C_SIZE)
    m.putWord(c + C_PARAMETER, dupOrNull(parameter))
    m.put32(c + C_HELP, 1)
    return c
}

export fn g_option_context_free(c: usize) -> void {
    const list = groups(c)
    var index: usize = 0
    while index < list.*.length {
        g_option_group_unref(m.wordAt(list, index))
        index += 1
    }
    m.disposeWords(list)
    if m.getWord(c + C_MAIN) != 0 { g_option_group_unref(m.getWord(c + C_MAIN)) }
    if m.getWord(c + C_TRANSLATE_NOTIFY) != 0 {
        const notify: Notify = unsafe { @ptrFromInt(Notify, m.getWord(c + C_TRANSLATE_NOTIFY)) }
        notify(m.getWord(c + C_TRANSLATE_DATA))
    }
    m.release(m.getWord(c + C_PARAMETER))
    m.release(m.getWord(c + C_SUMMARY))
    m.release(m.getWord(c + C_DESCRIPTION))
    m.release(m.getWord(c + C_DOMAIN))
    m.release(c)
}

export fn g_option_context_set_summary(c: usize, text: usize) -> void {
    m.release(m.getWord(c + C_SUMMARY))
    m.putWord(c + C_SUMMARY, dupOrNull(text))
}
export fn g_option_context_get_summary(c: usize) -> usize { return m.getWord(c + C_SUMMARY) }
export fn g_option_context_set_description(c: usize, text: usize) -> void {
    m.release(m.getWord(c + C_DESCRIPTION))
    m.putWord(c + C_DESCRIPTION, dupOrNull(text))
}
export fn g_option_context_get_description(c: usize) -> usize { return m.getWord(c + C_DESCRIPTION) }
export fn g_option_context_set_help_enabled(c: usize, enabled: i32) -> void { m.put32(c + C_HELP, if enabled != 0 { 1 } else { 0 }) }
export fn g_option_context_get_help_enabled(c: usize) -> i32 { return @bitCast(i32, m.get32(c + C_HELP)) }
export fn g_option_context_set_ignore_unknown_options(c: usize, ignore: i32) -> void { m.put32(c + C_IGNORE, if ignore != 0 { 1 } else { 0 }) }
export fn g_option_context_get_ignore_unknown_options(c: usize) -> i32 { return @bitCast(i32, m.get32(c + C_IGNORE)) }
export fn g_option_context_set_strict_posix(c: usize, strict: i32) -> void { m.put32(c + C_STRICT, if strict != 0 { 1 } else { 0 }) }
export fn g_option_context_get_strict_posix(c: usize) -> i32 { return @bitCast(i32, m.get32(c + C_STRICT)) }

export fn g_option_context_set_translate_func(c: usize, func: usize, data: usize, notify: usize) -> void {
    if m.getWord(c + C_TRANSLATE_NOTIFY) != 0 {
        const old: Notify = unsafe { @ptrFromInt(Notify, m.getWord(c + C_TRANSLATE_NOTIFY)) }
        old(m.getWord(c + C_TRANSLATE_DATA))
    }
    m.putWord(c + C_TRANSLATE, func)
    m.putWord(c + C_TRANSLATE_DATA, data)
    m.putWord(c + C_TRANSLATE_NOTIFY, notify)
}

export fn g_option_context_set_translation_domain(c: usize, domain: usize) -> void {
    m.release(m.getWord(c + C_DOMAIN))
    m.putWord(c + C_DOMAIN, dupOrNull(domain))
}

export fn g_option_context_add_group(c: usize, g: usize) -> void { m.pushWord(groups(c), g) }

export fn g_option_context_set_main_group(c: usize, g: usize) -> void {
    if m.getWord(c + C_MAIN) != 0 { g_option_group_unref(m.getWord(c + C_MAIN)) }
    m.putWord(c + C_MAIN, g)
}

export fn g_option_context_get_main_group(c: usize) -> usize { return m.getWord(c + C_MAIN) }

export fn g_option_context_add_main_entries(c: usize, entries: usize, domain: usize) -> void {
    if m.getWord(c + C_MAIN) == 0 { m.putWord(c + C_MAIN, g_option_group_new(0, 0, 0, 0, 0)) }
    const g = m.getWord(c + C_MAIN)
    g_option_group_add_entries(g, entries)
    g_option_group_set_translation_domain(g, domain)
}

// ---------------------------------------------------------------------------
// Parsing

// What a parse changed: for each entry's data, a record of where it is
// (0), the argument kind (8), the value before (16), and what the parse
// made: the string (24), or the array's strings (24, a Words).
const R_DATA: usize = 0
const R_KIND: usize = 8
const R_BEFORE: usize = 16
const R_MADE: usize = 24
const R_SIZE: usize = 48

const Parse = struct {
    context: usize
    changes: m.Words
    // Which arguments were taken (a byte each), what the remaining entry
    // took, the error.
    taken: usize
    err: usize
    failed: bool
}

fn changeOf(p: *Parse, data: usize, kind: i32) -> usize {
    var index: usize = 0
    while index < p.*.changes.length {
        const r = m.wordAt(&p.*.changes, index)
        if m.getWord(r + R_DATA) == data { return r }
        index += 1
    }
    const r = m.alloc(R_SIZE)
    m.zero(r, R_SIZE)
    m.putWord(r + R_DATA, data)
    m.putWord(r + R_KIND, @intCast(usize, kind))
    m.putWord(r + R_BEFORE, m.getWord(data))
    m.pushWord(&p.*.changes, r)
    return r
}

fn madeWords(r: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, r + R_MADE) } }

// The array a string array's entry holds now: the strings given so far.
fn storeArray(r: usize) -> void {
    const list = madeWords(r)
    const array = m.alloc((list.*.length + 1) * 8)
    var index: usize = 0
    while index < list.*.length {
        m.putWord(array + index * 8, m.wordAt(list, index))
        index += 1
    }
    m.putWord(array + list.*.length * 8, 0)
    // (The array made before, not its strings, which the new one holds.)
    const current = m.getWord(m.getWord(r + R_DATA))
    if current != m.getWord(r + R_BEFORE) { m.release(current) }
    m.putWord(m.getWord(r + R_DATA), array)
}

// Every value as it was before the parse, what it made freed.
fn revert(p: *Parse) -> void {
    var index: usize = 0
    while index < p.*.changes.length {
        const r = m.wordAt(&p.*.changes, index)
        const kind = @intCast(i32, m.getWord(r + R_KIND))
        const data = m.getWord(r + R_DATA)
        if kind == ARG_STRING || kind == ARG_FILENAME {
            m.release(m.getWord(r + R_MADE))
        } else if kind == ARG_STRING_ARRAY || kind == ARG_FILENAME_ARRAY {
            const list = madeWords(r)
            var at: usize = 0
            while at < list.*.length {
                m.release(m.wordAt(list, at))
                at += 1
            }
            const current = m.getWord(data)
            if current != m.getWord(r + R_BEFORE) { m.release(current) }
        }
        m.putWord(data, m.getWord(r + R_BEFORE))
        index += 1
    }
}

fn forget(p: *Parse) -> void {
    var index: usize = 0
    while index < p.*.changes.length {
        const r = m.wordAt(&p.*.changes, index)
        const kind = @intCast(i32, m.getWord(r + R_KIND))
        if kind == ARG_STRING_ARRAY || kind == ARG_FILENAME_ARRAY { m.disposeWords(madeWords(r)) }
        m.release(r)
        index += 1
    }
    m.disposeWords(&p.*.changes)
}

fn fail(p: *Parse, code: i32, text: usize) -> void {
    if !p.*.failed {
        p.*.failed = true
        const e = errors.newError(g_option_error_quark(), code, text)
        errors.report(p.*.err, e)
    } else {
        m.release(text)
    }
}

// “VALUE” for NAME in a message: `Cannot parse integer value “x” for --count`.
fn valueMessage(prefix: []const u8, value: usize, middle: []const u8, name: usize, suffix: []const u8) -> usize {
    var t = m.text()
    m.pushText(&t, prefix)
    m.pushText(&t, "\xe2\x80\x9c")
    m.pushC(&t, value)
    m.pushText(&t, "\xe2\x80\x9d")
    m.pushText(&t, middle)
    m.pushC(&t, name)
    m.pushText(&t, suffix)
    return m.finish(&t)
}

fn nameMessage(prefix: []const u8, name: usize) -> usize {
    var t = m.text()
    m.pushText(&t, prefix)
    m.pushC(&t, name)
    return m.finish(&t)
}

// The entry ENTRY of GROUP met as NAME (as written: --count, -c) with
// VALUE (0 for none); false when it failed.
fn apply(p: *Parse, group: usize, entry: usize, name: usize, value: usize) -> bool {
    const kind = m.getI32(entry + E_ARG)
    const flags = m.getI32(entry + E_FLAGS)
    const data = m.getWord(entry + E_DATA)
    if kind == ARG_NONE {
        _ = changeOf(p, data, kind)
        m.putI32(data, if (flags & FLAG_REVERSE) != 0 { 0 } else { 1 })
        return true
    }
    if kind == ARG_STRING || kind == ARG_FILENAME {
        const r = changeOf(p, data, kind)
        m.release(m.getWord(r + R_MADE))
        const copy = m.dup(value)
        m.putWord(r + R_MADE, copy)
        m.putWord(data, copy)
        return true
    }
    if kind == ARG_STRING_ARRAY || kind == ARG_FILENAME_ARRAY {
        const r = changeOf(p, data, kind)
        m.pushWord(madeWords(r), m.dup(value))
        storeArray(r)
        return true
    }
    if kind == ARG_INT || kind == ARG_INT64 {
        const end = m.alloc(8)
        sys.setErrno(0)
        const number = strtoll(value, end, 0)
        const bad = m.get8(value) == 0 || m.get8(m.getWord(end)) != 0
        const range = sys.errno() == ERANGE || (kind == ARG_INT && (number > 2147483647 || number < -2147483648))
        m.release(end)
        if bad {
            fail(p, ERROR_BAD_VALUE, valueMessage("Cannot parse integer value ", value, " for ", name, ""))
            return false
        }
        if range {
            fail(p, ERROR_BAD_VALUE, valueMessage("Integer value ", value, " for ", name, " out of range"))
            return false
        }
        _ = changeOf(p, data, kind)
        if kind == ARG_INT { m.putI32(data, @intCast(i32, number)) } else { m.putI64(data, number) }
        return true
    }
    if kind == ARG_DOUBLE {
        const end = m.alloc(8)
        sys.setErrno(0)
        const number = strtod(value, end)
        const bad = m.get8(value) == 0 || m.get8(m.getWord(end)) != 0
        const range = sys.errno() == ERANGE
        m.release(end)
        if bad {
            fail(p, ERROR_BAD_VALUE, valueMessage("Cannot parse double value ", value, " for ", name, ""))
            return false
        }
        if range {
            fail(p, ERROR_BAD_VALUE, valueMessage("Double value ", value, " for ", name, " out of range"))
            return false
        }
        _ = changeOf(p, data, kind)
        m.putF64(data, number)
        return true
    }
    if kind == ARG_CALLBACK {
        const call: ArgFunc = unsafe { @ptrFromInt(ArgFunc, data) }
        const local = m.alloc(8)
        m.putWord(local, 0)
        const ok = call(name, value, m.getWord(group + G_DATA), local)
        const e = m.getWord(local)
        m.release(local)
        if ok == 0 {
            if e != 0 {
                if !p.*.failed {
                    p.*.failed = true
                    errors.report(p.*.err, e)
                } else {
                    errors.freeError(e)
                }
            } else {
                fail(p, ERROR_FAILED, nameMessage("Error parsing option ", name))
            }
            return false
        }
        if e != 0 { errors.freeError(e) }
        return true
    }
    return true
}

// Whether the entry takes a value.
fn takesValue(entry: usize) -> bool {
    const kind = m.getI32(entry + E_ARG)
    if kind == ARG_NONE { return false }
    if kind == ARG_CALLBACK { return (m.getI32(entry + E_FLAGS) & (FLAG_NO_ARG | FLAG_OPTIONAL_ARG)) == 0 }
    return true
}

fn isOptional(entry: usize) -> bool {
    return m.getI32(entry + E_ARG) == ARG_CALLBACK && (m.getI32(entry + E_FLAGS) & FLAG_OPTIONAL_ARG) != 0
}

// The groups in the order they are searched: the main group, then the
// others as added.
fn groupAt(c: usize, index: usize) -> usize {
    const main = m.getWord(c + C_MAIN)
    if main != 0 {
        if index == 0 { return main }
        return m.wordAt(groups(c), index - 1)
    }
    return m.wordAt(groups(c), index)
}

fn groupCount(c: usize) -> usize { return groups(c).*.length + (if m.getWord(c + C_MAIN) != 0 { 1 } else { 0 }) }

// The entry of GROUP named NAME (LENGTH bytes), 0 for none.
fn entryNamed(g: usize, name: usize, length: usize) -> usize {
    var index: usize = 0
    while index < m.getWord(g + G_COUNT) {
        const entry = m.getWord(g + G_ENTRIES) + index * E_SIZE
        const long = m.getWord(entry + E_LONG)
        if long != 0 && m.get8(long) != 0 && m.cLength(long) == length && m.same(m.bytes(long, length), m.bytes(name, length)) { return entry }
        index += 1
    }
    return 0
}

fn entryShort(g: usize, c: u8) -> usize {
    var index: usize = 0
    while index < m.getWord(g + G_COUNT) {
        const entry = m.getWord(g + G_ENTRIES) + index * E_SIZE
        if m.get8(entry + E_SHORT) == c && c != 0 { return entry }
        index += 1
    }
    return 0
}

// The entry taking the arguments that are no options, and its group.
fn remainingEntry(c: usize, groupOut: *usize) -> usize {
    var index: usize = 0
    while index < groupCount(c) {
        const g = groupAt(c, index)
        var at: usize = 0
        while at < m.getWord(g + G_COUNT) {
            const entry = m.getWord(g + G_ENTRIES) + at * E_SIZE
            const long = m.getWord(entry + E_LONG)
            if long != 0 && m.get8(long) == 0 {
                groupOut.* = g
                return entry
            }
            at += 1
        }
        index += 1
    }
    return 0
}

fn callHooks(p: *Parse, offset: usize) -> bool {
    const c = p.*.context
    var index: usize = 0
    const count = groupCount(c)
    while index < count {
        // (The others first, then the main group, as GLib calls them.)
        const g = if m.getWord(c + C_MAIN) != 0 { (if index + 1 < count { groupAt(c, index + 1) } else { groupAt(c, 0) }) } else { groupAt(c, index) }
        if m.getWord(g + offset) != 0 {
            const hook: ParseFunc = unsafe { @ptrFromInt(ParseFunc, m.getWord(g + offset)) }
            const local = m.alloc(8)
            m.putWord(local, 0)
            const ok = hook(c, g, m.getWord(g + G_DATA), local)
            const e = m.getWord(local)
            m.release(local)
            if ok == 0 {
                if e != 0 {
                    p.*.failed = true
                    errors.report(p.*.err, e)
                } else {
                    fail(p, ERROR_FAILED, nameMessage("Error parsing option ", m.literal("\x00")))
                }
                return false
            }
        }
        index += 1
    }
    return true
}

fn callErrorHooks(p: *Parse) -> void {
    const c = p.*.context
    var index: usize = 0
    while index < groupCount(c) {
        const g = groupAt(c, index)
        if m.getWord(g + G_ERROR_HOOK) != 0 {
            const hook: ErrorFunc = unsafe { @ptrFromInt(ErrorFunc, m.getWord(g + G_ERROR_HOOK)) }
            hook(c, g, m.getWord(g + G_DATA), p.*.err)
        }
        index += 1
    }
}

// ARGS (COUNT of them, ARGS[0] the program) parsed: which were taken
// (p.taken, a byte each: 1 taken, 2 replaced by REPLACED's string).
fn parseArguments(p: *Parse, args: usize, count: usize, replaced: usize) -> void {
    const c = p.*.context
    var remainingGroup: usize = 0
    const remaining = remainingEntry(c, &remainingGroup)
    var i: usize = 1
    var ended = false
    while i < count && !p.*.failed {
        const arg = m.getWord(args + i * 8)
        if ended || m.get8(arg) != 45 || m.get8(arg + 1) == 0 {
            // An argument that is no option.
            if remaining != 0 {
                if apply(p, remainingGroup, remaining, arg, arg) { m.put8(p.*.taken + i, 1) }
            }
            i += 1
            continue
        }
        if m.get8(arg + 1) == 45 && m.get8(arg + 2) == 0 {
            // `--`: the rest are no options.
            if remaining != 0 {
                m.put8(p.*.taken + i, 1)
                ended = true
                i += 1
                continue
            }
            break
        }
        if m.get8(arg + 1) == 45 {
            // --NAME, --NAME=VALUE, --GROUP-NAME.
            const name = arg + 2
            var length: usize = 0
            while m.get8(name + length) != 0 && m.get8(name + length) != 61 { length += 1 }
            const hasValue = m.get8(name + length) == 61
            var group: usize = 0
            var entry: usize = 0
            var index: usize = 0
            while entry == 0 && index < groupCount(c) {
                group = groupAt(c, index)
                entry = entryNamed(group, name, length)
                index += 1
            }
            index = 0
            while entry == 0 && index < groupCount(c) {
                group = groupAt(c, index)
                const prefix = m.getWord(group + G_NAME)
                if prefix != 0 {
                    const prefixLength = m.cLength(prefix)
                    if length > prefixLength + 1 && m.same(m.bytes(name, prefixLength), m.bytes(prefix, prefixLength)) && m.get8(name + prefixLength) == 45 {
                        entry = entryNamed(group, name + prefixLength + 1, length - prefixLength - 1)
                    }
                }
                index += 1
            }
            if entry == 0 {
                if m.get32(c + C_IGNORE) == 0 { fail(p, ERROR_UNKNOWN_OPTION, nameMessage("Unknown option ", arg)) }
                i += 1
                continue
            }
            const optionName = m.dupBytes(arg, length + 2)
            var value: usize = 0
            var consumed: usize = 1
            if hasValue {
                value = name + length + 1
            } else if takesValue(entry) {
                if i + 1 >= count {
                    fail(p, ERROR_BAD_VALUE, nameMessage("Missing argument for ", optionName))
                    m.release(optionName)
                    break
                }
                value = m.getWord(args + (i + 1) * 8)
                consumed = 2
            }
            if !takesValue(entry) && !isOptional(entry) { value = 0 }
            if apply(p, group, entry, optionName, value) {
                m.put8(p.*.taken + i, 1)
                if consumed == 2 { m.put8(p.*.taken + i + 1, 1) }
            }
            m.release(optionName)
            i += consumed
            continue
        }
        // -abc: short options, the last of them may take the next argument.
        var j: usize = 1
        var next: usize = 0
        var unknown = m.text()
        m.pushByte(&unknown, 45)
        var known = false
        while m.get8(arg + j) != 0 && !p.*.failed {
            const letter = m.get8(arg + j)
            var group: usize = 0
            var entry: usize = 0
            var index: usize = 0
            while entry == 0 && index < groupCount(c) {
                group = groupAt(c, index)
                entry = entryShort(group, letter)
                index += 1
            }
            const optionName = m.alloc(3)
            m.put8(optionName, 45)
            m.put8(optionName + 1, letter)
            m.put8(optionName + 2, 0)
            if entry == 0 {
                if m.get32(c + C_IGNORE) == 0 {
                    fail(p, ERROR_UNKNOWN_OPTION, nameMessage("Unknown option ", optionName))
                } else {
                    m.pushByte(&unknown, letter)
                }
            } else {
                known = true
                var value: usize = 0
                if takesValue(entry) {
                    if m.get8(arg + j + 1) != 0 || i + 1 >= count {
                        fail(p, ERROR_BAD_VALUE, nameMessage("Missing argument for ", optionName))
                    } else {
                        value = m.getWord(args + (i + 1) * 8)
                        next = 1
                    }
                }
                if !p.*.failed { _ = apply(p, group, entry, optionName, value) }
            }
            m.release(optionName)
            j += 1
        }
        if !p.*.failed && known {
            if unknown.length > 1 {
                // (What is left of the argument: its unknown options.)
                m.put8(p.*.taken + i, 2)
                m.putWord(replaced + i * 8, m.finish(&unknown))
            } else {
                m.put8(p.*.taken + i, 1)
                m.dispose(&unknown)
            }
            if next == 1 { m.put8(p.*.taken + i + 1, 1) }
        } else {
            m.dispose(&unknown)
        }
        i += 1 + next
    }
}

// Parses ARGS (COUNT strings); on success the strings left, in order, are
// written to KEPT (and how many returned), the others' indexes noted in
// p.taken; on failure every value is as before.
fn run(c: usize, args: usize, count: usize, err: usize, kept: usize, keptCount: *usize, replaced: usize) -> bool {
    var p = Parse.{ .context = c, .changes = m.words(), .taken = m.alloc(count + 1), .err = err, .failed = false }
    m.zero(p.taken, count + 1)
    m.zero(replaced, (count + 1) * 8)
    var ok = callHooks(&p, G_PRE)
    if ok {
        parseArguments(&p, args, count, replaced)
        ok = !p.failed
    }
    if ok { ok = callHooks(&p, G_POST) }
    if !ok {
        callErrorHooks(&p)
        revert(&p)
        var index: usize = 0
        while index < count {
            if m.get8(p.taken + index) == 2 { m.release(m.getWord(replaced + index * 8)) }
            index += 1
        }
    } else {
        var n: usize = 0
        var index: usize = 0
        while index < count {
            const state = m.get8(p.taken + index)
            if state == 0 { m.putWord(kept + n * 8, m.getWord(args + index * 8)) }
            if state == 2 { m.putWord(kept + n * 8, m.getWord(replaced + index * 8)) }
            if state != 1 { n += 1 }
            index += 1
        }
        keptCount.* = n
    }
    forget(&p)
    m.release(p.taken)
    return ok
}

export fn g_option_context_parse(c: usize, argc: usize, argv: usize, err: usize) -> i32 {
    if argc == 0 || argv == 0 || m.getWord(argv) == 0 {
        var none: usize = 0
        const empty = m.alloc(16)
        const ok = run(c, empty, 0, err, empty, &none, m.alloc(16))
        return if ok { 1 } else { 0 }
    }
    const count = @intCast(usize, m.getI32(argc))
    const args = m.getWord(argv)
    const kept = m.alloc((count + 1) * 8)
    const replaced = m.alloc((count + 1) * 8)
    var keptCount: usize = 0
    const ok = run(c, args, count, err, kept, &keptCount, replaced)
    if ok {
        // argv rewritten in place: what is left first, NULL after it.
        var index: usize = 0
        while index < keptCount {
            m.putWord(args + index * 8, m.getWord(kept + index * 8))
            index += 1
        }
        while index < count {
            m.putWord(args + index * 8, 0)
            index += 1
        }
        m.putI32(argc, @intCast(i32, keptCount))
    }
    m.release(kept)
    m.release(replaced)
    return if ok { 1 } else { 0 }
}

export fn g_option_context_parse_strv(c: usize, arguments: usize, err: usize) -> i32 {
    if arguments == 0 || m.getWord(arguments) == 0 { return g_option_context_parse(c, 0, 0, err) }
    const args = m.getWord(arguments)
    var count: usize = 0
    while m.getWord(args + count * 8) != 0 { count += 1 }
    const kept = m.alloc((count + 1) * 8)
    const replaced = m.alloc((count + 1) * 8)
    var keptCount: usize = 0
    const ok = run(c, args, count, err, kept, &keptCount, replaced)
    if ok {
        // The strings taken out are freed (the array owns them).
        var index: usize = 0
        while index < count {
            const arg = m.getWord(args + index * 8)
            var still = false
            var at: usize = 0
            while at < keptCount {
                if m.getWord(kept + at * 8) == arg { still = true }
                at += 1
            }
            if !still { m.release(arg) }
            index += 1
        }
        index = 0
        while index < keptCount {
            m.putWord(args + index * 8, m.getWord(kept + index * 8))
            index += 1
        }
        m.putWord(args + keptCount * 8, 0)
    }
    m.release(kept)
    m.release(replaced)
    return if ok { 1 } else { 0 }
}
