// GValue (gvalue.h, gvaluetypes.h, gvaluetransform.c), boxed types
// (gboxed.h), enumerations and flags (genums.h) and GValueArray.
//
// A GValue is its type and two words; what the words hold, and how a
// value is made, freed, copied and collected from C's variable arguments,
// is the type's value table (GTypeValueTable: value_init 0, value_free 8,
// value_copy 16, value_peek_pointer 24, collect_format 32, collect_value
// 40, lcopy_format 48, lcopy_value 56), found on the type or its nearest
// ancestor, as in GLib. This module registers the fundamental types of
// plain values (gchar to gdouble, gchararray, gpointer, GVariant), GEnum,
// GFlags and GBoxed with their tables, the transformations between
// numbers and to strings, and the boxed types of GLib's own structures.
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const messages = @import("./messages.mlx")
const varargs = @import("./varargs.mlx")
const strings = @import("./strings.mlx")
const types = @import("./types.mlx")

extern("c") fn g_type_from_name(name: usize) -> usize
extern("c") fn g_type_value_table_peek(t: usize) -> usize
extern("c") fn snprintf(buffer: usize, size: usize, format: usize, a: usize) -> i32
extern("c") fn g_variant_ref(v: usize) -> usize
extern("c") fn g_variant_ref_sink(v: usize) -> usize
extern("c") fn g_variant_unref(v: usize) -> void
extern("c") fn g_closure_ref(c: usize) -> usize
extern("c") fn g_closure_unref(c: usize) -> void
extern("c") fn g_strdupv(v: usize) -> usize
extern("c") fn g_strfreev(v: usize) -> void
extern("c") fn g_bytes_ref(b: usize) -> usize
extern("c") fn g_bytes_unref(b: usize) -> void
extern("c") fn g_variant_type_copy(t: usize) -> usize
extern("c") fn g_variant_type_free(t: usize) -> void
extern("c") fn g_error_copy(e: usize) -> usize
extern("c") fn g_error_free(e: usize) -> void
extern("c") fn g_hash_table_ref(t: usize) -> usize
extern("c") fn g_hash_table_unref(t: usize) -> void
extern("c") fn g_array_ref(a: usize) -> usize
extern("c") fn g_array_unref(a: usize) -> void
extern("c") fn g_ptr_array_ref(a: usize) -> usize
extern("c") fn g_ptr_array_unref(a: usize) -> void
extern("c") fn g_byte_array_ref(a: usize) -> usize
extern("c") fn g_byte_array_unref(a: usize) -> void
extern("c") fn g_main_context_ref(c: usize) -> usize
extern("c") fn g_main_context_unref(c: usize) -> void
extern("c") fn g_main_loop_ref(l: usize) -> usize
extern("c") fn g_main_loop_unref(l: usize) -> void
extern("c") fn g_source_ref(s: usize) -> usize
extern("c") fn g_source_unref(s: usize) -> void
extern("c") fn g_uri_ref(u: usize) -> usize
extern("c") fn g_uri_unref(u: usize) -> void
extern("c") fn g_date_time_ref(d: usize) -> usize
extern("c") fn g_date_time_unref(d: usize) -> void
extern("c") fn g_key_file_ref(k: usize) -> usize
extern("c") fn g_key_file_unref(k: usize) -> void
extern("c") fn g_mapped_file_ref(f: usize) -> usize
extern("c") fn g_mapped_file_unref(f: usize) -> void
extern("c") fn g_variant_builder_ref(b: usize) -> usize
extern("c") fn g_variant_builder_unref(b: usize) -> void

pub const NOCOPY_CONTENTS: u32 = 1 << 27
pub const INTERNED_STRING: u32 = 1 << 28

pub const ValueFunc = fn(usize) -> void
pub const CopyFunc = fn(usize, usize) -> void
pub const PeekFunc = fn(usize) -> usize
pub const CollectFunc = fn(usize, u32, usize, u32) -> usize
pub const BoxedCopy = fn(usize) -> usize
pub const BoxedFree = fn(usize) -> void
pub const Transform = fn(usize, usize) -> void

fn valueType(value: usize) -> usize { return m.getWord(value) }
fn data0(value: usize) -> usize { return m.getWord(value + 8) }
fn data1(value: usize) -> usize { return m.getWord(value + 16) }

pub fn gobjectCritical(text: []const u8) -> void { messages.logText(m.literal("GLib-GObject"), messages.LEVEL_CRITICAL, text) }

fn gobjectWarning(t: *m.Text) -> void {
    messages.log(m.literal("GLib-GObject"), messages.LEVEL_WARNING, t.*.address)
    m.dispose(t)
}

// ---------------------------------------------------------------------------
// The value tables of the plain fundamental types

var intTable: [8]usize = undefined
var longTable: [8]usize = undefined
var int64Table: [8]usize = undefined
var floatTable: [8]usize = undefined
var doubleTable: [8]usize = undefined
var charTable: [8]usize = undefined
var ucharTable: [8]usize = undefined
var booleanTable: [8]usize = undefined
var enumTable: [8]usize = undefined
var flagsTable: [8]usize = undefined
var stringTable: [8]usize = undefined
var pointerTable: [8]usize = undefined
var variantTable: [8]usize = undefined
var boxedTable: [8]usize = undefined

export fn __mlx_glib_value_zero(value: usize) -> void {
    m.putWord(value + 8, 0)
    m.putWord(value + 16, 0)
}

export fn __mlx_glib_value_copy_word(src: usize, dest: usize) -> void { m.putWord(dest + 8, data0(src)) }

export fn __mlx_glib_value_peek(value: usize) -> usize { return data0(value) }

fn nullLocation(value: usize) -> usize {
    var t = m.text()
    m.pushText(&t, "value location for '")
    m.pushC(&t, types.describe(valueType(value)))
    m.pushText(&t, "' passed as NULL")
    return m.finish(&t)
}

export fn __mlx_glib_collect_int(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    m.putWord(value + 8, @bitCast(usize, @intCast(i64, m.getI32(cvalues))))
    return 0
}

export fn __mlx_glib_collect_word(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    m.putWord(value + 8, m.getWord(cvalues))
    return 0
}

export fn __mlx_glib_collect_float(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    m.putWord(value + 8, 0)
    m.putF32(value + 8, @floatCast(f32, m.getF64(cvalues)))
    return 0
}

export fn __mlx_glib_lcopy_int(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 { return nullLocation(value) }
    m.put32(p, m.get32(value + 8))
    return 0
}

export fn __mlx_glib_lcopy_char(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 { return nullLocation(value) }
    m.put8(p, m.get8(value + 8))
    return 0
}

export fn __mlx_glib_lcopy_word(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 { return nullLocation(value) }
    m.putWord(p, data0(value))
    return 0
}

export fn __mlx_glib_lcopy_float(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 { return nullLocation(value) }
    m.put32(p, m.get32(value + 8))
    return 0
}

export fn __mlx_glib_string_free(value: usize) -> void {
    if (m.get32(value + 16) & NOCOPY_CONTENTS) == 0 { m.release(data0(value)) }
}

export fn __mlx_glib_string_copy(src: usize, dest: usize) -> void {
    if (m.get32(src + 16) & INTERNED_STRING) != 0 {
        m.putWord(dest + 8, data0(src))
        m.put32(dest + 16, INTERNED_STRING)
    } else {
        m.putWord(dest + 8, if data0(src) == 0 { 0 } else { m.dup(data0(src)) })
    }
}

export fn __mlx_glib_string_collect(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 {
        m.putWord(value + 8, 0)
    } else if (flags & NOCOPY_CONTENTS) != 0 {
        m.putWord(value + 8, p)
        m.put32(value + 16, NOCOPY_CONTENTS)
    } else {
        m.putWord(value + 8, m.dup(p))
    }
    return 0
}

export fn __mlx_glib_string_lcopy(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 { return nullLocation(value) }
    if data0(value) == 0 {
        m.putWord(p, 0)
    } else if (flags & NOCOPY_CONTENTS) != 0 {
        m.putWord(p, data0(value))
    } else {
        m.putWord(p, m.dup(data0(value)))
    }
    return 0
}

export fn __mlx_glib_variant_free(value: usize) -> void { if data0(value) != 0 { g_variant_unref(data0(value)) } }
export fn __mlx_glib_variant_copy(src: usize, dest: usize) -> void { m.putWord(dest + 8, if data0(src) == 0 { 0 } else { g_variant_ref_sink(data0(src)) }) }

export fn __mlx_glib_variant_collect(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    m.putWord(value + 8, if p == 0 { 0 } else { g_variant_ref_sink(p) })
    return 0
}

export fn __mlx_glib_variant_lcopy(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 { return nullLocation(value) }
    if data0(value) == 0 || (flags & NOCOPY_CONTENTS) != 0 {
        m.putWord(p, data0(value))
    } else {
        m.putWord(p, g_variant_ref_sink(data0(value)))
    }
    return 0
}

export fn __mlx_glib_boxed_free_value(value: usize) -> void {
    if data0(value) != 0 && (m.get32(value + 16) & NOCOPY_CONTENTS) == 0 { boxedFree(valueType(value), data0(value)) }
}

export fn __mlx_glib_boxed_copy_value(src: usize, dest: usize) -> void {
    m.putWord(dest + 8, if data0(src) == 0 { 0 } else { boxedCopy(valueType(src), data0(src)) })
}

export fn __mlx_glib_boxed_collect(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 {
        m.putWord(value + 8, 0)
    } else if (flags & NOCOPY_CONTENTS) != 0 {
        m.putWord(value + 8, p)
        m.put32(value + 16, NOCOPY_CONTENTS)
    } else {
        m.putWord(value + 8, boxedCopy(valueType(value), p))
    }
    return 0
}

export fn __mlx_glib_boxed_lcopy(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 { return nullLocation(value) }
    if data0(value) == 0 || (flags & NOCOPY_CONTENTS) != 0 {
        m.putWord(p, data0(value))
    } else {
        m.putWord(p, boxedCopy(valueType(value), data0(value)))
    }
    return 0
}

fn fillTable(table: usize, init: usize, free: usize, copy: usize, peek: usize, collectFormat: []const u8, collect: usize, lcopyFormat: []const u8, lcopy: usize) -> void {
    m.putWord(table, init)
    m.putWord(table + 8, free)
    m.putWord(table + 16, copy)
    m.putWord(table + 24, peek)
    m.putWord(table + 32, m.literal(collectFormat))
    m.putWord(table + 40, collect)
    m.putWord(table + 48, m.literal(lcopyFormat))
    m.putWord(table + 56, lcopy)
}

fn registerValueType(t: usize, name: []const u8, table: usize, classSize: u16, classInit: usize, fflags: u32, flags: u32) -> void {
    const info = m.alloc(72)
    m.put16(info, classSize)
    m.putWord(info + 24, classInit)
    m.putWord(info + 64, table)
    const finfo = m.alloc(8)
    m.put32(finfo, fflags)
    _ = types.registerFundamental(t, m.literal(name), info, finfo, flags)
    m.release(info)
    m.release(finfo)
}

export fn __mlx_glib_values_init() -> void {
    const zero = @intFromPtr(__mlx_glib_value_zero)
    const copyWord = @intFromPtr(__mlx_glib_value_copy_word)
    const peek = @intFromPtr(__mlx_glib_value_peek)
    fillTable(@intFromPtr(&charTable), zero, 0, copyWord, 0, "i", @intFromPtr(__mlx_glib_collect_int), "p", @intFromPtr(__mlx_glib_lcopy_char))
    fillTable(@intFromPtr(&ucharTable), zero, 0, copyWord, 0, "i", @intFromPtr(__mlx_glib_collect_int), "p", @intFromPtr(__mlx_glib_lcopy_char))
    fillTable(@intFromPtr(&booleanTable), zero, 0, copyWord, 0, "i", @intFromPtr(__mlx_glib_collect_int), "p", @intFromPtr(__mlx_glib_lcopy_int))
    fillTable(@intFromPtr(&intTable), zero, 0, copyWord, 0, "i", @intFromPtr(__mlx_glib_collect_int), "p", @intFromPtr(__mlx_glib_lcopy_int))
    fillTable(@intFromPtr(&longTable), zero, 0, copyWord, 0, "l", @intFromPtr(__mlx_glib_collect_word), "p", @intFromPtr(__mlx_glib_lcopy_word))
    fillTable(@intFromPtr(&int64Table), zero, 0, copyWord, 0, "q", @intFromPtr(__mlx_glib_collect_word), "p", @intFromPtr(__mlx_glib_lcopy_word))
    fillTable(@intFromPtr(&floatTable), zero, 0, copyWord, 0, "d", @intFromPtr(__mlx_glib_collect_float), "p", @intFromPtr(__mlx_glib_lcopy_float))
    fillTable(@intFromPtr(&doubleTable), zero, 0, copyWord, 0, "d", @intFromPtr(__mlx_glib_collect_word), "p", @intFromPtr(__mlx_glib_lcopy_word))
    fillTable(@intFromPtr(&enumTable), zero, 0, copyWord, 0, "i", @intFromPtr(__mlx_glib_collect_int), "p", @intFromPtr(__mlx_glib_lcopy_int))
    fillTable(@intFromPtr(&flagsTable), zero, 0, copyWord, 0, "i", @intFromPtr(__mlx_glib_collect_int), "p", @intFromPtr(__mlx_glib_lcopy_int))
    fillTable(@intFromPtr(&stringTable), zero, @intFromPtr(__mlx_glib_string_free), @intFromPtr(__mlx_glib_string_copy), peek, "p", @intFromPtr(__mlx_glib_string_collect), "p", @intFromPtr(__mlx_glib_string_lcopy))
    fillTable(@intFromPtr(&pointerTable), zero, 0, copyWord, peek, "p", @intFromPtr(__mlx_glib_collect_word), "p", @intFromPtr(__mlx_glib_lcopy_word))
    fillTable(@intFromPtr(&variantTable), zero, @intFromPtr(__mlx_glib_variant_free), @intFromPtr(__mlx_glib_variant_copy), peek, "p", @intFromPtr(__mlx_glib_variant_collect), "p", @intFromPtr(__mlx_glib_variant_lcopy))
    fillTable(@intFromPtr(&boxedTable), zero, @intFromPtr(__mlx_glib_boxed_free_value), @intFromPtr(__mlx_glib_boxed_copy_value), peek, "p", @intFromPtr(__mlx_glib_boxed_collect), "p", @intFromPtr(__mlx_glib_boxed_lcopy))
    registerValueType(types.T_CHAR, "gchar", @intFromPtr(&charTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_UCHAR, "guchar", @intFromPtr(&ucharTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_BOOLEAN, "gboolean", @intFromPtr(&booleanTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_INT, "gint", @intFromPtr(&intTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_UINT, "guint", @intFromPtr(&intTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_LONG, "glong", @intFromPtr(&longTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_ULONG, "gulong", @intFromPtr(&longTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_INT64, "gint64", @intFromPtr(&int64Table), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_UINT64, "guint64", @intFromPtr(&int64Table), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_FLOAT, "gfloat", @intFromPtr(&floatTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_DOUBLE, "gdouble", @intFromPtr(&doubleTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_STRING, "gchararray", @intFromPtr(&stringTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_POINTER, "gpointer", @intFromPtr(&pointerTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_VARIANT, "GVariant", @intFromPtr(&variantTable), 0, 0, types.DERIVABLE, 0)
    registerValueType(types.T_ENUM, "GEnum", @intFromPtr(&enumTable), 32, @intFromPtr(__mlx_glib_enum_class_init), types.CLASSED | types.DERIVABLE, types.ABSTRACT | types.VALUE_ABSTRACT)
    registerValueType(types.T_FLAGS, "GFlags", @intFromPtr(&flagsTable), 24, @intFromPtr(__mlx_glib_flags_class_init), types.CLASSED | types.DERIVABLE, types.ABSTRACT | types.VALUE_ABSTRACT)
    registerValueType(types.T_BOXED, "GBoxed", @intFromPtr(&boxedTable), 0, 0, types.DERIVABLE, types.ABSTRACT | types.VALUE_ABSTRACT)
    registerTransforms()
}

// ---------------------------------------------------------------------------
// GValue

fn tableOf(t: usize) -> usize { return types.valueTableOf(t) }

fn callValue(table: usize, slot: usize, value: usize) -> void {
    const f = m.getWord(table + slot)
    if f != 0 {
        const call: ValueFunc = unsafe { @ptrFromInt(ValueFunc, f) }
        call(value)
    }
}

pub fn init(value: usize, t: usize) -> usize {
    const table = g_type_value_table_peek(t)
    if table == 0 {
        var text = m.text()
        m.pushText(&text, "cannot initialize GValue with type '")
        m.pushC(&text, types.describe(t))
        m.pushText(&text, if t == 0 { "'" } else { "', this type has no GTypeValueTable implementation" })
        gobjectWarning(&text)
        return value
    }
    if valueType(value) != 0 {
        var text = m.text()
        m.pushText(&text, "cannot initialize GValue with type '")
        m.pushC(&text, types.describe(t))
        m.pushText(&text, "', the value has already been initialized as '")
        m.pushC(&text, types.describe(valueType(value)))
        m.pushText(&text, "'")
        gobjectWarning(&text)
        return value
    }
    m.putWord(value, t)
    m.putWord(value + 8, 0)
    m.putWord(value + 16, 0)
    callValue(table, 0, value)
    return value
}

pub fn unset(value: usize) -> void {
    const t = valueType(value)
    if t == 0 { return }
    const table = tableOf(t)
    if table != 0 { callValue(table, 8, value) }
    m.zero(value, 24)
}

pub fn reset(value: usize) -> void {
    const t = valueType(value)
    const table = tableOf(t)
    if table != 0 { callValue(table, 8, value) }
    m.putWord(value + 8, 0)
    m.putWord(value + 16, 0)
    if table != 0 { callValue(table, 0, value) }
}

pub fn compatible(src: usize, dest: usize) -> bool {
    if src == dest { return true }
    return types.isA(src, dest) && tableOf(src) == tableOf(dest)
}

pub fn copy(src: usize, dest: usize) -> void {
    if !compatible(valueType(src), valueType(dest)) {
        gobjectCritical("g_value_copy: assertion 'g_value_type_compatible (G_VALUE_TYPE (src_value), G_VALUE_TYPE (dest_value))' failed")
        return
    }
    if src == dest { return }
    const t = valueType(dest)
    const table = tableOf(t)
    if table != 0 { callValue(table, 8, dest) }
    m.putWord(dest + 8, 0)
    m.putWord(dest + 16, 0)
    const f = m.getWord(table + 16)
    if f != 0 {
        const call: CopyFunc = unsafe { @ptrFromInt(CopyFunc, f) }
        call(src, dest)
    }
}

export fn g_value_init(value: usize, t: usize) -> usize { return init(value, t) }
export fn g_value_copy(src: usize, dest: usize) -> void { copy(src, dest) }

export fn g_value_reset(value: usize) -> usize {
    reset(value)
    return value
}

export fn g_value_unset(value: usize) -> void { unset(value) }

export fn g_value_fits_pointer(value: usize) -> i32 {
    const table = tableOf(valueType(value))
    return if table != 0 && m.getWord(table + 24) != 0 { 1 } else { 0 }
}

export fn g_value_peek_pointer(value: usize) -> usize {
    const table = tableOf(valueType(value))
    if table == 0 || m.getWord(table + 24) == 0 { return 0 }
    const call: PeekFunc = unsafe { @ptrFromInt(PeekFunc, m.getWord(table + 24)) }
    return call(value)
}

export fn g_value_type_compatible(src_type: usize, dest_type: usize) -> i32 { return if compatible(src_type, dest_type) { 1 } else { 0 } }

// Collects a value of the type `value` was initialized with from `list`
// (its value table's collect format); an error text or 0.
pub fn collect(value: usize, list: usize, flags: u32) -> usize {
    const table = tableOf(valueType(value))
    const format = m.getWord(table + 32)
    const cvalues = m.alloc(64)
    var n: u32 = 0
    var p = format
    while m.get8(p) != 0 && n < 8 {
        const c = m.get8(p)
        const cell = cvalues + @intCast(usize, n) * 8
        if c == 'i' {
            m.putI32(cell, varargs.nextInt(list))
        } else if c == 'd' {
            m.putF64(cell, varargs.nextDouble(list))
        } else {
            m.putWord(cell, varargs.nextPointer(list))
        }
        n += 1
        p += 1
    }
    const call: CollectFunc = unsafe { @ptrFromInt(CollectFunc, m.getWord(table + 40)) }
    const err = call(value, n, cvalues, flags)
    m.release(cvalues)
    return err
}

// Stores `value` through the pointers of `list` (its lcopy format).
pub fn lcopy(value: usize, list: usize, flags: u32) -> usize {
    const table = tableOf(valueType(value))
    const format = m.getWord(table + 48)
    const cvalues = m.alloc(64)
    var n: u32 = 0
    var p = format
    while m.get8(p) != 0 && n < 8 {
        m.putWord(cvalues + @intCast(usize, n) * 8, varargs.nextPointer(list))
        n += 1
        p += 1
    }
    const call: CollectFunc = unsafe { @ptrFromInt(CollectFunc, m.getWord(table + 56)) }
    const err = call(value, n, cvalues, flags)
    m.release(cvalues)
    return err
}

// Skips the arguments of a value of type `t` in `list`.
pub fn skip(t: usize, list: usize) -> void {
    const table = tableOf(t)
    var p = m.getWord(table + 32)
    while m.get8(p) != 0 {
        if m.get8(p) == 'd' { _ = varargs.nextDouble(list) } else { _ = varargs.nextWord(list) }
        p += 1
    }
}

export fn g_value_set_instance(value: usize, instance: usize) -> void {
    reset(value)
    if instance == 0 { return }
    const table = tableOf(valueType(value))
    const cvalues = m.alloc(64)
    m.putWord(cvalues, instance)
    const call: CollectFunc = unsafe { @ptrFromInt(CollectFunc, m.getWord(table + 40)) }
    const err = call(value, 1, cvalues, 0)
    m.release(cvalues)
    if err != 0 {
        messages.log(m.literal("GLib-GObject"), messages.LEVEL_WARNING, err)
        m.release(err)
    }
}

export fn g_value_init_from_instance(value: usize, instance: usize) -> void {
    _ = init(value, types.instanceType(instance))
    g_value_set_instance(value, instance)
}

// Getters and setters check what the value holds, as GLib's do.
fn holds(value: usize, t: usize, function: []const u8, macro: []const u8) -> bool {
    if value != 0 && types.isA(valueType(value), t) { return true }
    var text = m.text()
    m.pushText(&text, function)
    m.pushText(&text, ": assertion '")
    m.pushText(&text, macro)
    m.pushText(&text, " (value)' failed")
    messages.log(m.literal("GLib-GObject"), messages.LEVEL_CRITICAL, text.address)
    m.dispose(&text)
    return false
}

export fn g_value_set_char(value: usize, v: i8) -> void { if holds(value, types.T_CHAR, "g_value_set_char", "G_VALUE_HOLDS_CHAR") { m.putWord(value + 8, @bitCast(usize, @intCast(i64, v))) } }
export fn g_value_get_char(value: usize) -> i8 { return if holds(value, types.T_CHAR, "g_value_get_char", "G_VALUE_HOLDS_CHAR") { @bitCast(i8, m.get8(value + 8)) } else { 0 } }
export fn g_value_set_schar(value: usize, v: i8) -> void { if holds(value, types.T_CHAR, "g_value_set_schar", "G_VALUE_HOLDS_CHAR") { m.putWord(value + 8, @bitCast(usize, @intCast(i64, v))) } }
export fn g_value_get_schar(value: usize) -> i8 { return if holds(value, types.T_CHAR, "g_value_get_schar", "G_VALUE_HOLDS_CHAR") { @bitCast(i8, m.get8(value + 8)) } else { 0 } }
export fn g_value_set_uchar(value: usize, v: u8) -> void { if holds(value, types.T_UCHAR, "g_value_set_uchar", "G_VALUE_HOLDS_UCHAR") { m.putWord(value + 8, @intCast(usize, v)) } }
export fn g_value_get_uchar(value: usize) -> u8 { return if holds(value, types.T_UCHAR, "g_value_get_uchar", "G_VALUE_HOLDS_UCHAR") { m.get8(value + 8) } else { 0 } }
export fn g_value_set_boolean(value: usize, v: i32) -> void { if holds(value, types.T_BOOLEAN, "g_value_set_boolean", "G_VALUE_HOLDS_BOOLEAN") { m.putWord(value + 8, if v != 0 { 1 } else { 0 }) } }
export fn g_value_get_boolean(value: usize) -> i32 { return if holds(value, types.T_BOOLEAN, "g_value_get_boolean", "G_VALUE_HOLDS_BOOLEAN") { m.getI32(value + 8) } else { 0 } }
export fn g_value_set_int(value: usize, v: i32) -> void { if holds(value, types.T_INT, "g_value_set_int", "G_VALUE_HOLDS_INT") { m.putWord(value + 8, @bitCast(usize, @intCast(i64, v))) } }
export fn g_value_get_int(value: usize) -> i32 { return if holds(value, types.T_INT, "g_value_get_int", "G_VALUE_HOLDS_INT") { m.getI32(value + 8) } else { 0 } }
export fn g_value_set_uint(value: usize, v: u32) -> void { if holds(value, types.T_UINT, "g_value_set_uint", "G_VALUE_HOLDS_UINT") { m.putWord(value + 8, @intCast(usize, v)) } }
export fn g_value_get_uint(value: usize) -> u32 { return if holds(value, types.T_UINT, "g_value_get_uint", "G_VALUE_HOLDS_UINT") { m.get32(value + 8) } else { 0 } }
export fn g_value_set_long(value: usize, v: i64) -> void { if holds(value, types.T_LONG, "g_value_set_long", "G_VALUE_HOLDS_LONG") { m.putI64(value + 8, v) } }
export fn g_value_get_long(value: usize) -> i64 { return if holds(value, types.T_LONG, "g_value_get_long", "G_VALUE_HOLDS_LONG") { m.getI64(value + 8) } else { 0 } }
export fn g_value_set_ulong(value: usize, v: u64) -> void { if holds(value, types.T_ULONG, "g_value_set_ulong", "G_VALUE_HOLDS_ULONG") { m.put64(value + 8, v) } }
export fn g_value_get_ulong(value: usize) -> u64 { return if holds(value, types.T_ULONG, "g_value_get_ulong", "G_VALUE_HOLDS_ULONG") { m.get64(value + 8) } else { 0 } }
export fn g_value_set_int64(value: usize, v: i64) -> void { if holds(value, types.T_INT64, "g_value_set_int64", "G_VALUE_HOLDS_INT64") { m.putI64(value + 8, v) } }
export fn g_value_get_int64(value: usize) -> i64 { return if holds(value, types.T_INT64, "g_value_get_int64", "G_VALUE_HOLDS_INT64") { m.getI64(value + 8) } else { 0 } }
export fn g_value_set_uint64(value: usize, v: u64) -> void { if holds(value, types.T_UINT64, "g_value_set_uint64", "G_VALUE_HOLDS_UINT64") { m.put64(value + 8, v) } }
export fn g_value_get_uint64(value: usize) -> u64 { return if holds(value, types.T_UINT64, "g_value_get_uint64", "G_VALUE_HOLDS_UINT64") { m.get64(value + 8) } else { 0 } }

export fn g_value_set_float(value: usize, v: f32) -> void {
    if !holds(value, types.T_FLOAT, "g_value_set_float", "G_VALUE_HOLDS_FLOAT") { return }
    m.putWord(value + 8, 0)
    m.putF32(value + 8, v)
}

export fn g_value_get_float(value: usize) -> f32 { return if holds(value, types.T_FLOAT, "g_value_get_float", "G_VALUE_HOLDS_FLOAT") { m.getF32(value + 8) } else { 0.0 } }
export fn g_value_set_double(value: usize, v: f64) -> void { if holds(value, types.T_DOUBLE, "g_value_set_double", "G_VALUE_HOLDS_DOUBLE") { m.putF64(value + 8, v) } }
export fn g_value_get_double(value: usize) -> f64 { return if holds(value, types.T_DOUBLE, "g_value_get_double", "G_VALUE_HOLDS_DOUBLE") { m.getF64(value + 8) } else { 0.0 } }

fn setString(value: usize, text: usize, flags: u32) -> void {
    if (m.get32(value + 16) & NOCOPY_CONTENTS) == 0 { m.release(data0(value)) }
    m.putWord(value + 8, text)
    m.put32(value + 16, flags)
}

export fn g_value_set_string(value: usize, v: usize) -> void { if holds(value, types.T_STRING, "g_value_set_string", "G_VALUE_HOLDS_STRING") { setString(value, if v == 0 { 0 } else { m.dup(v) }, 0) } }
export fn g_value_set_static_string(value: usize, v: usize) -> void { if holds(value, types.T_STRING, "g_value_set_static_string", "G_VALUE_HOLDS_STRING") { setString(value, v, NOCOPY_CONTENTS) } }
export fn g_value_set_interned_string(value: usize, v: usize) -> void { if holds(value, types.T_STRING, "g_value_set_interned_string", "G_VALUE_HOLDS_STRING") { setString(value, v, NOCOPY_CONTENTS | INTERNED_STRING) } }
export fn g_value_take_string(value: usize, v: usize) -> void { if holds(value, types.T_STRING, "g_value_take_string", "G_VALUE_HOLDS_STRING") { setString(value, v, 0) } }
export fn g_value_get_string(value: usize) -> usize { return if holds(value, types.T_STRING, "g_value_get_string", "G_VALUE_HOLDS_STRING") { data0(value) } else { 0 } }

export fn g_value_dup_string(value: usize) -> usize {
    if !holds(value, types.T_STRING, "g_value_dup_string", "G_VALUE_HOLDS_STRING") { return 0 }
    return if data0(value) == 0 { 0 } else { m.dup(data0(value)) }
}

export fn g_value_steal_string(value: usize) -> usize {
    if !holds(value, types.T_STRING, "g_value_steal_string", "G_VALUE_HOLDS_STRING") { return 0 }
    var text = data0(value)
    if (m.get32(value + 16) & NOCOPY_CONTENTS) != 0 && text != 0 { text = m.dup(text) }
    m.putWord(value + 8, 0)
    m.put32(value + 16, 0)
    return text
}

export fn g_value_set_pointer(value: usize, v: usize) -> void { if holds(value, types.T_POINTER, "g_value_set_pointer", "G_VALUE_HOLDS_POINTER") { m.putWord(value + 8, v) } }
export fn g_value_get_pointer(value: usize) -> usize { return if holds(value, types.T_POINTER, "g_value_get_pointer", "G_VALUE_HOLDS_POINTER") { data0(value) } else { 0 } }

export fn g_value_set_gtype(value: usize, v: usize) -> void { if holds(value, gtypeType(), "g_value_set_gtype", "G_VALUE_HOLDS_GTYPE") { m.putWord(value + 8, v) } }
export fn g_value_get_gtype(value: usize) -> usize { return if holds(value, gtypeType(), "g_value_get_gtype", "G_VALUE_HOLDS_GTYPE") { data0(value) } else { 0 } }

export fn g_value_set_variant(value: usize, v: usize) -> void {
    if !holds(value, types.T_VARIANT, "g_value_set_variant", "G_VALUE_HOLDS_VARIANT") { return }
    const old = data0(value)
    m.putWord(value + 8, if v == 0 { 0 } else { g_variant_ref_sink(v) })
    if old != 0 { g_variant_unref(old) }
}

export fn g_value_take_variant(value: usize, v: usize) -> void {
    if !holds(value, types.T_VARIANT, "g_value_take_variant", "G_VALUE_HOLDS_VARIANT") { return }
    const old = data0(value)
    m.putWord(value + 8, if v == 0 { 0 } else { g_variant_take_ref(v) })
    if old != 0 { g_variant_unref(old) }
}

extern("c") fn g_variant_take_ref(v: usize) -> usize

export fn g_value_get_variant(value: usize) -> usize { return if holds(value, types.T_VARIANT, "g_value_get_variant", "G_VALUE_HOLDS_VARIANT") { data0(value) } else { 0 } }

export fn g_value_dup_variant(value: usize) -> usize {
    if !holds(value, types.T_VARIANT, "g_value_dup_variant", "G_VALUE_HOLDS_VARIANT") { return 0 }
    return if data0(value) == 0 { 0 } else { g_variant_ref_sink(data0(value)) }
}

var gtypeTypeId: usize = 0
var gtypeTypeOnce: u64 = 0

pub fn gtypeType() -> usize {
    if threads.onceEnter(@intFromPtr(&gtypeTypeOnce)) {
        const info = m.alloc(72)
        gtypeTypeId = types.registerStatic(types.T_POINTER, m.literal("GType"), info, 0)
        m.release(info)
        threads.onceLeave(@intFromPtr(&gtypeTypeOnce), 1)
    }
    return gtypeTypeId
}

export fn g_gtype_get_type() -> usize { return gtypeType() }

export fn g_pointer_type_register_static(name: usize) -> usize {
    const existing = g_type_from_name(name)
    if existing != 0 { return existing }
    const info = m.alloc(72)
    const t = types.registerStatic(types.T_POINTER, name, info, 0)
    m.release(info)
    return t
}

// ---------------------------------------------------------------------------
// Transformations

var transformList: usize = 0
var transformLock: u32 = 0

fn transformsOf() -> *m.Words {
    if transformList == 0 { transformList = m.alloc(24) }
    unsafe { return @ptrFromInt(*m.Words, transformList) }
}

export fn g_value_register_transform_func(src_type: usize, dest_type: usize, func: usize) -> void {
    threads.lock(@intFromPtr(&transformLock))
    const transforms = transformsOf()
    var k: usize = 0
    while k < transforms.*.length {
        if m.wordAt(transforms, k) == src_type && m.wordAt(transforms, k + 1) == dest_type {
            m.putWord(transforms.*.address + (k + 2) * 8, func)
            threads.unlock(@intFromPtr(&transformLock))
            return
        }
        k += 3
    }
    m.pushWord(transforms, src_type)
    m.pushWord(transforms, dest_type)
    m.pushWord(transforms, func)
    threads.unlock(@intFromPtr(&transformLock))
}

fn registered(src: usize, dest: usize) -> usize {
    const transforms = transformsOf()
    var k: usize = 0
    while k < transforms.*.length {
        if m.wordAt(transforms, k) == src && m.wordAt(transforms, k + 1) == dest { return m.wordAt(transforms, k + 2) }
        k += 3
    }
    return 0
}

// GLib's transform_func_lookup: the source's ancestors (while they keep
// its value table) against the destination's.
fn findTransform(src: usize, dest: usize) -> usize {
    threads.lock(@intFromPtr(&transformLock))
    var s = src
    var found: usize = 0
    while s != 0 && found == 0 {
        var d = dest
        while d != 0 && found == 0 {
            found = registered(s, d)
            const dp = types.parentOf(d)
            if dp == 0 || tableOf(dp) != tableOf(d) { break }
            d = dp
        }
        const sp = types.parentOf(s)
        if sp == 0 || tableOf(sp) != tableOf(s) { break }
        s = sp
    }
    threads.unlock(@intFromPtr(&transformLock))
    return found
}

export fn g_value_type_transformable(src_type: usize, dest_type: usize) -> i32 {
    if compatible(src_type, dest_type) { return 1 }
    return if findTransform(src_type, dest_type) != 0 { 1 } else { 0 }
}

pub fn transform(src: usize, dest: usize) -> bool {
    if compatible(valueType(src), valueType(dest)) {
        copy(src, dest)
        return true
    }
    const f = findTransform(valueType(src), valueType(dest))
    if f == 0 { return false }
    reset(dest)
    const call: Transform = unsafe { @ptrFromInt(Transform, f) }
    call(src, dest)
    return true
}

export fn g_value_transform(src: usize, dest: usize) -> i32 { return if transform(src, dest) { 1 } else { 0 } }

fn isFloat(t: usize) -> bool { return t == types.T_FLOAT || t == types.T_DOUBLE }
fn isSigned(t: usize) -> bool { return t == types.T_CHAR || t == types.T_INT || t == types.T_LONG || t == types.T_INT64 || t == types.T_ENUM }

// A number of the value as a double and as a 64-bit integer.
fn numberF(value: usize) -> f64 {
    const f = types.fundamentalOf(valueType(value))
    if f == types.T_FLOAT { return @floatCast(f64, m.getF32(value + 8)) }
    if f == types.T_DOUBLE { return m.getF64(value + 8) }
    if isSigned(f) { return @floatFromInt(f64, numberI(value)) }
    return @floatFromInt(f64, numberU(value))
}

fn numberI(value: usize) -> i64 {
    const f = types.fundamentalOf(valueType(value))
    if f == types.T_CHAR { return @intCast(i64, @bitCast(i8, m.get8(value + 8))) }
    if f == types.T_UCHAR { return @intCast(i64, m.get8(value + 8)) }
    if f == types.T_BOOLEAN || f == types.T_INT || f == types.T_ENUM { return @intCast(i64, m.getI32(value + 8)) }
    if f == types.T_UINT || f == types.T_FLAGS { return @intCast(i64, m.get32(value + 8)) }
    if f == types.T_FLOAT { return @intFromFloat(i64, @floatCast(f64, m.getF32(value + 8))) }
    if f == types.T_DOUBLE { return @intFromFloat(i64, m.getF64(value + 8)) }
    return m.getI64(value + 8)
}

fn numberU(value: usize) -> u64 { return @bitCast(u64, numberI(value)) }

export fn __mlx_glib_transform_number(src: usize, dest: usize) -> void {
    const f = types.fundamentalOf(valueType(dest))
    if f == types.T_FLOAT {
        m.putWord(dest + 8, 0)
        m.putF32(dest + 8, @floatCast(f32, numberF(src)))
    } else if f == types.T_DOUBLE {
        m.putF64(dest + 8, numberF(src))
    } else if f == types.T_BOOLEAN {
        m.putWord(dest + 8, if numberI(src) != 0 { 1 } else { 0 })
    } else if f == types.T_CHAR {
        m.putWord(dest + 8, @bitCast(usize, @intCast(i64, @bitCast(i8, @intCast(u8, numberU(src) & 0xff)))))
    } else if f == types.T_UCHAR {
        m.putWord(dest + 8, @intCast(usize, numberU(src) & 0xff))
    } else if f == types.T_INT || f == types.T_ENUM {
        m.putWord(dest + 8, @bitCast(usize, @intCast(i64, @bitCast(i32, @intCast(u32, numberU(src) & 0xffffffff)))))
    } else if f == types.T_UINT || f == types.T_FLAGS {
        m.putWord(dest + 8, @intCast(usize, numberU(src) & 0xffffffff))
    } else {
        m.put64(dest + 8, numberU(src))
    }
}

fn formatted(format: []const u8, value: usize) -> usize {
    const buffer = m.alloc(64)
    _ = snprintf(buffer, 64, m.literal(format), value)
    return buffer
}

extern("c") fn g_strdup_printf(format: usize, value: f64) -> usize

export fn __mlx_glib_transform_to_string(src: usize, dest: usize) -> void {
    const f = types.fundamentalOf(valueType(src))
    var text: usize = 0
    if f == types.T_BOOLEAN {
        text = m.dupSlice(if m.getI32(src + 8) != 0 { "TRUE" } else { "FALSE" })
    } else if f == types.T_FLOAT || f == types.T_DOUBLE {
        text = g_strdup_printf(m.literal("%f"), numberF(src))
    } else if f == types.T_ENUM {
        const class = types.classOf(valueType(src))
        const v = enumValue(class, m.getI32(src + 8))
        text = if v != 0 { m.dup(m.getWord(v + 8)) } else { formatted("%d", @bitCast(usize, @intCast(i64, m.getI32(src + 8)))) }
    } else if f == types.T_FLAGS {
        text = flagsText(types.classOf(valueType(src)), m.get32(src + 8))
    } else if f == types.T_STRING {
        text = if data0(src) == 0 { 0 } else { m.dup(data0(src)) }
    } else if isSigned(f) {
        text = formatted(if f == types.T_CHAR || f == types.T_INT { "%d" } else { "%ld" }, @bitCast(usize, numberI(src)))
    } else {
        text = formatted(if f == types.T_UCHAR || f == types.T_UINT { "%u" } else { "%lu" }, @intCast(usize, numberU(src)))
    }
    m.putWord(dest + 8, text)
}

fn registerTransforms() -> void {
    const numbers = [13]usize{ types.T_CHAR, types.T_UCHAR, types.T_BOOLEAN, types.T_INT, types.T_UINT, types.T_LONG, types.T_ULONG, types.T_INT64, types.T_UINT64, types.T_ENUM, types.T_FLAGS, types.T_FLOAT, types.T_DOUBLE }
    const number = @intFromPtr(__mlx_glib_transform_number)
    const toString = @intFromPtr(__mlx_glib_transform_to_string)
    var i: usize = 0
    while i < 13 {
        var k: usize = 0
        while k < 13 {
            const src = numbers[i]
            const dest = numbers[k]
            // As in GLib: no floats to booleans, enums or flags, and enums
            // and flags only from and to integers.
            var allowed = src != dest
            if (src == types.T_FLOAT || src == types.T_DOUBLE) && (dest == types.T_BOOLEAN || dest == types.T_ENUM || dest == types.T_FLAGS) { allowed = false }
            if (dest == types.T_FLOAT || dest == types.T_DOUBLE) && (src == types.T_BOOLEAN || src == types.T_ENUM || src == types.T_FLAGS) { allowed = false }
            if (src == types.T_ENUM || src == types.T_FLAGS) && (dest == types.T_ENUM || dest == types.T_FLAGS || dest == types.T_BOOLEAN) { allowed = false }
            if (dest == types.T_ENUM || dest == types.T_FLAGS) && src == types.T_BOOLEAN { allowed = false }
            if allowed { g_value_register_transform_func(src, dest, number) }
            k += 1
        }
        g_value_register_transform_func(numbers[i], types.T_STRING, toString)
        i += 1
    }
    g_value_register_transform_func(types.T_STRING, types.T_STRING, toString)
}

export fn g_strdup_value_contents(value: usize) -> usize {
    const t = valueType(value)
    if types.isA(t, types.T_STRING) {
        const text = data0(value)
        if text == 0 { return m.dupSlice("NULL") }
        const escaped = strings.escape(text, 0)
        var out = m.text()
        m.pushByte(&out, '"')
        m.pushC(&out, escaped)
        m.pushByte(&out, '"')
        m.release(escaped)
        return m.finish(&out)
    }
    if g_value_type_transformable(t, types.T_STRING) != 0 {
        const tmp = m.alloc(24)
        _ = init(tmp, types.T_STRING)
        _ = transform(value, tmp)
        const text = data0(tmp)
        const escaped = if text == 0 { 0 } else { strings.escape(text, 0) }
        unset(tmp)
        m.release(tmp)
        var out = m.text()
        const f = types.fundamentalOf(t)
        if f == types.T_ENUM || f == types.T_FLAGS {
            m.pushText(&out, "((")
            m.pushC(&out, types.nameOf(t))
            m.pushText(&out, ") ")
            m.pushC(&out, escaped)
            m.pushText(&out, ")")
        } else if escaped == 0 {
            m.pushText(&out, "NULL")
        } else {
            m.pushC(&out, escaped)
        }
        m.release(escaped)
        return m.finish(&out)
    }
    if g_value_fits_pointer(value) != 0 {
        const p = g_value_peek_pointer(value)
        if p == 0 { return m.dupSlice("NULL") }
        const f = types.fundamentalOf(t)
        var out = m.text()
        if f == types.T_OBJECT || f == types.T_PARAM {
            m.pushText(&out, "((")
            m.pushC(&out, types.nameOf(types.instanceType(p)))
            m.pushText(&out, "*) ")
            pushPointer(&out, p)
            m.pushText(&out, ")")
        } else if types.isA(t, strvType()) {
            m.pushByte(&out, '[')
            var s = p
            while m.getWord(s) != 0 {
                const escaped = strings.escape(m.getWord(s), 0)
                m.pushByte(&out, '"')
                m.pushC(&out, escaped)
                m.pushByte(&out, '"')
                m.release(escaped)
                s += 8
                if m.getWord(s) != 0 { m.pushText(&out, ", ") }
            }
            m.pushByte(&out, ']')
        } else if f == types.T_BOXED {
            m.pushText(&out, "((")
            m.pushC(&out, types.nameOf(t))
            m.pushText(&out, "*) ")
            pushPointer(&out, p)
            m.pushText(&out, ")")
        } else if f == types.T_POINTER {
            m.pushText(&out, "((gpointer) ")
            pushPointer(&out, p)
            m.pushText(&out, ")")
        } else {
            m.pushText(&out, "???")
        }
        return m.finish(&out)
    }
    return m.dupSlice("???")
}

fn pushPointer(out: *m.Text, p: usize) -> void {
    const text = formatted("%p", p)
    m.pushC(out, text)
    m.release(text)
}

// ---------------------------------------------------------------------------
// Boxed types

pub fn boxedCopy(t: usize, boxed: usize) -> usize {
    if boxed == 0 { return 0 }
    if t == valueGType() {
        const copied = m.alloc(24)
        _ = init(copied, valueType(boxed))
        copy(boxed, copied)
        return copied
    }
    const f = types.boxedCopyOf(t)
    if f == 0 {
        var text = m.text()
        m.pushText(&text, "g_boxed_copy: assertion 'G_TYPE_IS_BOXED (boxed_type)' failed for '")
        m.pushC(&text, types.describe(t))
        m.pushText(&text, "'")
        messages.log(m.literal("GLib-GObject"), messages.LEVEL_CRITICAL, text.address)
        m.dispose(&text)
        return 0
    }
    const call: BoxedCopy = unsafe { @ptrFromInt(BoxedCopy, f) }
    return call(boxed)
}

pub fn boxedFree(t: usize, boxed: usize) -> void {
    if boxed == 0 { return }
    if t == valueGType() {
        unset(boxed)
        m.release(boxed)
        return
    }
    const f = types.boxedFreeOf(t)
    if f == 0 { return }
    const call: BoxedFree = unsafe { @ptrFromInt(BoxedFree, f) }
    call(boxed)
}

export fn g_boxed_copy(boxed_type: usize, src_boxed: usize) -> usize { return boxedCopy(boxed_type, src_boxed) }
export fn g_boxed_free(boxed_type: usize, boxed: usize) -> void { boxedFree(boxed_type, boxed) }

fn setBoxed(value: usize, boxed: usize, flags: u32, take: bool) -> void {
    if !holds(value, types.T_BOXED, "g_value_set_boxed", "G_VALUE_HOLDS_BOXED") { return }
    const old = data0(value)
    const oldFlags = m.get32(value + 16)
    var stored = boxed
    if boxed != 0 && !take && (flags & NOCOPY_CONTENTS) == 0 { stored = boxedCopy(valueType(value), boxed) }
    m.putWord(value + 8, stored)
    m.put32(value + 16, flags)
    if old != 0 && (oldFlags & NOCOPY_CONTENTS) == 0 { boxedFree(valueType(value), old) }
}

export fn g_value_set_boxed(value: usize, v: usize) -> void { setBoxed(value, v, 0, false) }
export fn g_value_set_static_boxed(value: usize, v: usize) -> void { setBoxed(value, v, NOCOPY_CONTENTS, false) }
export fn g_value_take_boxed(value: usize, v: usize) -> void { setBoxed(value, v, 0, true) }
export fn g_value_get_boxed(value: usize) -> usize { return if holds(value, types.T_BOXED, "g_value_get_boxed", "G_VALUE_HOLDS_BOXED") { data0(value) } else { 0 } }

export fn g_value_dup_boxed(value: usize) -> usize {
    if !holds(value, types.T_BOXED, "g_value_dup_boxed", "G_VALUE_HOLDS_BOXED") { return 0 }
    return boxedCopy(valueType(value), data0(value))
}

pub fn registerBoxed(name: usize, copyFunc: usize, freeFunc: usize) -> usize {
    const info = m.alloc(72)
    const t = types.registerStatic(types.T_BOXED, name, info, 0)
    m.release(info)
    if t != 0 { types.setBoxedFunctions(t, copyFunc, freeFunc) }
    return t
}

export fn g_boxed_type_register_static(name: usize, boxed_copy: usize, boxed_free: usize) -> usize { return registerBoxed(name, boxed_copy, boxed_free) }

// The boxed types of GLib's structures, each registered the first time
// it is asked for.
fn boxedOnce(cell: usize, once: usize, name: []const u8, copyFunc: usize, freeFunc: usize) -> usize {
    if threads.onceEnter(once) {
        m.putWord(cell, registerBoxed(m.literal(name), copyFunc, freeFunc))
        threads.onceLeave(once, 1)
    }
    return m.getWord(cell)
}

var closureTypeId: usize = 0
var closureTypeOnce: u64 = 0
var valueTypeId: usize = 0
var valueTypeOnce: u64 = 0
var strvTypeId: usize = 0
var strvTypeOnce: u64 = 0
var bytesTypeId: usize = 0
var bytesTypeOnce: u64 = 0
var variantTypeTypeId: usize = 0
var variantTypeTypeOnce: u64 = 0
var errorTypeId: usize = 0
var errorTypeOnce: u64 = 0
var hashTypeId: usize = 0
var hashTypeOnce: u64 = 0
var arrayTypeId: usize = 0
var arrayTypeOnce: u64 = 0
var ptrArrayTypeId: usize = 0
var ptrArrayTypeOnce: u64 = 0
var byteArrayTypeId: usize = 0
var byteArrayTypeOnce: u64 = 0
var contextTypeId: usize = 0
var contextTypeOnce: u64 = 0
var loopTypeId: usize = 0
var loopTypeOnce: u64 = 0
var sourceTypeId: usize = 0
var sourceTypeOnce: u64 = 0
var uriTypeId: usize = 0
var uriTypeOnce: u64 = 0
var dateTimeTypeId: usize = 0
var dateTimeTypeOnce: u64 = 0
var keyFileTypeId: usize = 0
var keyFileTypeOnce: u64 = 0
var mappedFileTypeId: usize = 0
var mappedFileTypeOnce: u64 = 0
var builderTypeId: usize = 0
var builderTypeOnce: u64 = 0
var valueArrayTypeId: usize = 0
var valueArrayTypeOnce: u64 = 0

export fn __mlx_glib_value_box_copy(value: usize) -> usize { return boxedCopy(valueGType(), value) }
export fn __mlx_glib_value_box_free(value: usize) -> void { boxedFree(valueGType(), value) }

export fn g_closure_get_type() -> usize { return boxedOnce(@intFromPtr(&closureTypeId), @intFromPtr(&closureTypeOnce), "GClosure", @intFromPtr(g_closure_ref), @intFromPtr(g_closure_unref)) }

pub fn valueGType() -> usize {
    if threads.onceEnter(@intFromPtr(&valueTypeOnce)) {
        valueTypeId = registerBoxed(m.literal("GValue"), @intFromPtr(__mlx_glib_value_box_copy), @intFromPtr(__mlx_glib_value_box_free))
        threads.onceLeave(@intFromPtr(&valueTypeOnce), 1)
    }
    return valueTypeId
}

export fn g_value_get_type() -> usize { return valueGType() }

pub fn strvType() -> usize { return boxedOnce(@intFromPtr(&strvTypeId), @intFromPtr(&strvTypeOnce), "GStrv", @intFromPtr(g_strdupv), @intFromPtr(g_strfreev)) }

export fn g_strv_get_type() -> usize { return strvType() }
export fn g_bytes_get_type() -> usize { return boxedOnce(@intFromPtr(&bytesTypeId), @intFromPtr(&bytesTypeOnce), "GBytes", @intFromPtr(g_bytes_ref), @intFromPtr(g_bytes_unref)) }
export fn g_variant_type_get_gtype() -> usize { return boxedOnce(@intFromPtr(&variantTypeTypeId), @intFromPtr(&variantTypeTypeOnce), "GVariantType", @intFromPtr(g_variant_type_copy), @intFromPtr(g_variant_type_free)) }
export fn g_error_get_type() -> usize { return boxedOnce(@intFromPtr(&errorTypeId), @intFromPtr(&errorTypeOnce), "GError", @intFromPtr(g_error_copy), @intFromPtr(g_error_free)) }
export fn g_hash_table_get_type() -> usize { return boxedOnce(@intFromPtr(&hashTypeId), @intFromPtr(&hashTypeOnce), "GHashTable", @intFromPtr(g_hash_table_ref), @intFromPtr(g_hash_table_unref)) }
export fn g_array_get_type() -> usize { return boxedOnce(@intFromPtr(&arrayTypeId), @intFromPtr(&arrayTypeOnce), "GArray", @intFromPtr(g_array_ref), @intFromPtr(g_array_unref)) }
export fn g_ptr_array_get_type() -> usize { return boxedOnce(@intFromPtr(&ptrArrayTypeId), @intFromPtr(&ptrArrayTypeOnce), "GPtrArray", @intFromPtr(g_ptr_array_ref), @intFromPtr(g_ptr_array_unref)) }
export fn g_byte_array_get_type() -> usize { return boxedOnce(@intFromPtr(&byteArrayTypeId), @intFromPtr(&byteArrayTypeOnce), "GByteArray", @intFromPtr(g_byte_array_ref), @intFromPtr(g_byte_array_unref)) }
export fn g_main_context_get_type() -> usize { return boxedOnce(@intFromPtr(&contextTypeId), @intFromPtr(&contextTypeOnce), "GMainContext", @intFromPtr(g_main_context_ref), @intFromPtr(g_main_context_unref)) }
export fn g_main_loop_get_type() -> usize { return boxedOnce(@intFromPtr(&loopTypeId), @intFromPtr(&loopTypeOnce), "GMainLoop", @intFromPtr(g_main_loop_ref), @intFromPtr(g_main_loop_unref)) }
export fn g_source_get_type() -> usize { return boxedOnce(@intFromPtr(&sourceTypeId), @intFromPtr(&sourceTypeOnce), "GSource", @intFromPtr(g_source_ref), @intFromPtr(g_source_unref)) }
export fn g_uri_get_type() -> usize { return boxedOnce(@intFromPtr(&uriTypeId), @intFromPtr(&uriTypeOnce), "GUri", @intFromPtr(g_uri_ref), @intFromPtr(g_uri_unref)) }
export fn g_date_time_get_type() -> usize { return boxedOnce(@intFromPtr(&dateTimeTypeId), @intFromPtr(&dateTimeTypeOnce), "GDateTime", @intFromPtr(g_date_time_ref), @intFromPtr(g_date_time_unref)) }
export fn g_key_file_get_type() -> usize { return boxedOnce(@intFromPtr(&keyFileTypeId), @intFromPtr(&keyFileTypeOnce), "GKeyFile", @intFromPtr(g_key_file_ref), @intFromPtr(g_key_file_unref)) }
export fn g_mapped_file_get_type() -> usize { return boxedOnce(@intFromPtr(&mappedFileTypeId), @intFromPtr(&mappedFileTypeOnce), "GMappedFile", @intFromPtr(g_mapped_file_ref), @intFromPtr(g_mapped_file_unref)) }
export fn g_variant_builder_get_type() -> usize { return boxedOnce(@intFromPtr(&builderTypeId), @intFromPtr(&builderTypeOnce), "GVariantBuilder", @intFromPtr(g_variant_builder_ref), @intFromPtr(g_variant_builder_unref)) }
export fn g_value_array_get_type() -> usize { return boxedOnce(@intFromPtr(&valueArrayTypeId), @intFromPtr(&valueArrayTypeOnce), "GValueArray", @intFromPtr(g_value_array_copy), @intFromPtr(g_value_array_free)) }

// ---------------------------------------------------------------------------
// Enumerations and flags. GEnumClass: the class word, minimum 8,
// maximum 12, n_values 16, values 24; GFlagsClass: mask 8, n_values 12,
// values 16; a GEnumValue/GFlagsValue: value 0, name 8, nick 16.

export fn __mlx_glib_enum_class_init(class: usize, values: usize) -> void {
    if values == 0 { return }
    var n: u32 = 0
    var minimum: i32 = 0
    var maximum: i32 = 0
    var v = values
    while m.getWord(v + 8) != 0 {
        const x = m.getI32(v)
        if n == 0 || x < minimum { minimum = x }
        if n == 0 || x > maximum { maximum = x }
        n += 1
        v += 24
    }
    m.putI32(class + 8, minimum)
    m.putI32(class + 12, maximum)
    m.put32(class + 16, n)
    m.putWord(class + 24, values)
}

export fn __mlx_glib_flags_class_init(class: usize, values: usize) -> void {
    if values == 0 { return }
    var n: u32 = 0
    var mask: u32 = 0
    var v = values
    while m.getWord(v + 8) != 0 {
        mask = mask | m.get32(v)
        n += 1
        v += 24
    }
    m.put32(class + 8, mask)
    m.put32(class + 12, n)
    m.putWord(class + 16, values)
}

fn registerWithValues(parent: usize, name: usize, values: usize, classSize: u16, classInit: usize) -> usize {
    const info = m.alloc(72)
    m.put16(info, classSize)
    m.putWord(info + 24, classInit)
    m.putWord(info + 40, values)
    const t = types.registerStatic(parent, name, info, 0)
    m.release(info)
    return t
}

export fn g_enum_register_static(name: usize, const_static_values: usize) -> usize { return registerWithValues(types.T_ENUM, name, const_static_values, 32, @intFromPtr(__mlx_glib_enum_class_init)) }
export fn g_flags_register_static(name: usize, const_static_values: usize) -> usize { return registerWithValues(types.T_FLAGS, name, const_static_values, 24, @intFromPtr(__mlx_glib_flags_class_init)) }

pub fn enumValue(class: usize, value: i32) -> usize {
    if class == 0 { return 0 }
    var v = m.getWord(class + 24)
    var i: u32 = 0
    while i < m.get32(class + 16) {
        if m.getI32(v) == value { return v }
        v += 24
        i += 1
    }
    return 0
}

fn enumFind(class: usize, text: usize, field: usize) -> usize {
    if class == 0 || text == 0 { return 0 }
    var v = m.getWord(class + 24)
    var i: u32 = 0
    while i < m.get32(class + 16) {
        if m.cEqual(m.getWord(v + field), text) { return v }
        v += 24
        i += 1
    }
    return 0
}

export fn g_enum_get_value(enum_class: usize, value: i32) -> usize { return enumValue(enum_class, value) }
export fn g_enum_get_value_by_name(enum_class: usize, name: usize) -> usize { return enumFind(enum_class, name, 8) }
export fn g_enum_get_value_by_nick(enum_class: usize, nick: usize) -> usize { return enumFind(enum_class, nick, 16) }

pub fn flagsFirst(class: usize, value: u32) -> usize {
    if class == 0 { return 0 }
    var v = m.getWord(class + 16)
    var i: u32 = 0
    while i < m.get32(class + 12) {
        const x = m.get32(v)
        if (value == 0 && x == 0) || (value != 0 && x != 0 && (x & value) == x) { return v }
        v += 24
        i += 1
    }
    return 0
}

fn flagsFind(class: usize, text: usize, field: usize) -> usize {
    if class == 0 || text == 0 { return 0 }
    var v = m.getWord(class + 16)
    var i: u32 = 0
    while i < m.get32(class + 12) {
        if m.cEqual(m.getWord(v + field), text) { return v }
        v += 24
        i += 1
    }
    return 0
}

export fn g_flags_get_first_value(flags_class: usize, value: u32) -> usize { return flagsFirst(flags_class, value) }
export fn g_flags_get_value_by_name(flags_class: usize, name: usize) -> usize { return flagsFind(flags_class, name, 8) }
export fn g_flags_get_value_by_nick(flags_class: usize, nick: usize) -> usize { return flagsFind(flags_class, nick, 16) }

// GLib's g_flags_get_value_string: the names joined by " | ", the bits
// no name stands for in hex.
pub fn flagsText(class: usize, value_: u32) -> usize {
    var value = value_
    var out = m.text()
    while out.length == 0 || value != 0 {
        const v = flagsFirst(class, value)
        if v == 0 { break }
        if out.length > 0 { m.pushText(&out, " | ") }
        m.pushC(&out, m.getWord(v + 8))
        value = value & (0xffffffff ^ m.get32(v))
    }
    if value != 0 || out.length == 0 {
        if out.length > 0 { m.pushText(&out, " | ") }
        const hex = formatted("0x%x", @intCast(usize, value))
        m.pushC(&out, hex)
        m.release(hex)
    }
    return m.finish(&out)
}

export fn g_enum_to_string(g_enum_type: usize, value: i32) -> usize {
    const class = types.classOf(g_enum_type)
    const v = enumValue(class, value)
    if v == 0 { return formatted("%d", @bitCast(usize, @intCast(i64, value))) }
    return m.dup(m.getWord(v + 8))
}

export fn g_flags_to_string(flags_type: usize, value: u32) -> usize { return flagsText(types.classOf(flags_type), value) }

export fn g_value_set_enum(value: usize, v: i32) -> void { if holds(value, types.T_ENUM, "g_value_set_enum", "G_VALUE_HOLDS_ENUM") { m.putWord(value + 8, @bitCast(usize, @intCast(i64, v))) } }
export fn g_value_get_enum(value: usize) -> i32 { return if holds(value, types.T_ENUM, "g_value_get_enum", "G_VALUE_HOLDS_ENUM") { m.getI32(value + 8) } else { 0 } }
export fn g_value_set_flags(value: usize, v: u32) -> void { if holds(value, types.T_FLAGS, "g_value_set_flags", "G_VALUE_HOLDS_FLAGS") { m.putWord(value + 8, @intCast(usize, v)) } }
export fn g_value_get_flags(value: usize) -> u32 { return if holds(value, types.T_FLAGS, "g_value_get_flags", "G_VALUE_HOLDS_FLAGS") { m.get32(value + 8) } else { 0 } }

// ---------------------------------------------------------------------------
// GValueArray: n_values 0, values 8, n_prealloced 16.

export fn g_value_array_new(n_prealloced: u32) -> usize {
    const a = m.alloc(24)
    m.putWord(a + 8, m.alloc(@intCast(usize, if n_prealloced == 0 { 1 } else { n_prealloced }) * 24))
    m.put32(a + 16, n_prealloced)
    return a
}

export fn g_value_array_get_nth(a: usize, index: u32) -> usize {
    if index >= m.get32(a) { return 0 }
    return m.getWord(a + 8) + @intCast(usize, index) * 24
}

export fn g_value_array_free(a: usize) -> void {
    if a == 0 { return }
    var i: u32 = 0
    while i < m.get32(a) {
        unset(m.getWord(a + 8) + @intCast(usize, i) * 24)
        i += 1
    }
    m.release(m.getWord(a + 8))
    m.release(a)
}

export fn g_value_array_insert(a: usize, index: u32, value: usize) -> usize {
    const n = m.get32(a)
    if index > n { return a }
    if n + 1 > m.get32(a + 16) {
        const room = (n + 1) * 2
        const grown = m.alloc(@intCast(usize, room) * 24)
        m.copy(grown, m.getWord(a + 8), @intCast(usize, n) * 24)
        m.release(m.getWord(a + 8))
        m.putWord(a + 8, grown)
        m.put32(a + 16, room)
    }
    const base = m.getWord(a + 8)
    var i = n
    while i > index {
        m.copy(base + @intCast(usize, i) * 24, base + @intCast(usize, i - 1) * 24, 24)
        i -= 1
    }
    const slot = base + @intCast(usize, index) * 24
    m.zero(slot, 24)
    if value != 0 {
        _ = init(slot, valueType(value))
        copy(value, slot)
    }
    m.put32(a, n + 1)
    return a
}

export fn g_value_array_append(a: usize, value: usize) -> usize { return g_value_array_insert(a, m.get32(a), value) }
export fn g_value_array_prepend(a: usize, value: usize) -> usize { return g_value_array_insert(a, 0, value) }

export fn g_value_array_remove(a: usize, index: u32) -> usize {
    const n = m.get32(a)
    if index >= n { return a }
    const base = m.getWord(a + 8)
    unset(base + @intCast(usize, index) * 24)
    var i = index
    while i + 1 < n {
        m.copy(base + @intCast(usize, i) * 24, base + @intCast(usize, i + 1) * 24, 24)
        i += 1
    }
    m.zero(base + @intCast(usize, n - 1) * 24, 24)
    m.put32(a, n - 1)
    return a
}

export fn g_value_array_copy(a: usize) -> usize {
    const result = g_value_array_new(m.get32(a))
    var i: u32 = 0
    while i < m.get32(a) {
        _ = g_value_array_append(result, m.getWord(a + 8) + @intCast(usize, i) * 24)
        i += 1
    }
    return result
}
