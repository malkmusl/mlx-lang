// Messages to the log (gmessages.h): g_log and the functions of each
// level, handlers by domain, and GLib's default handler's form:
//
//     ** (process:PID): WARNING **: HH:MM:SS.mmm: message
//     Domain-Message: HH:MM:SS.mmm: message
//
// on standard error, debug and info messages on standard output and only
// when G_MESSAGES_DEBUG names the domain or "all". An error (and any
// level made fatal) aborts the program.
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const varargs = @import("./varargs.mlx")
const utils = @import("./utils.mlx")

pub const FLAG_RECURSION: i32 = 1
pub const FLAG_FATAL: i32 = 2
pub const LEVEL_ERROR: i32 = 4
pub const LEVEL_CRITICAL: i32 = 8
pub const LEVEL_WARNING: i32 = 16
pub const LEVEL_MESSAGE: i32 = 32
pub const LEVEL_INFO: i32 = 64
pub const LEVEL_DEBUG: i32 = 128

pub const LogFunc = fn(usize, i32, usize, usize) -> void

// The handlers set: cells of (domain, levels, function, data, id, next).
var handlersLock: u32 = 0
var handlers: usize = 0
var handlerIds: u32 = 0
var defaultHandler: usize = 0
var defaultData: usize = 0
var alwaysFatal: i32 = 0

extern("c") fn localtime_r(seconds: usize, result: usize) -> usize
extern("c") fn abort() -> void

fn handlerFor(domain: usize, level: i32, data: *usize) -> usize {
    threads.lock(@intFromPtr(&handlersLock))
    var cell = handlers
    var found: usize = 0
    while cell != 0 {
        if (m.getI32(cell + 8) & level) != 0 && m.cEqual(m.getWord(cell), domain) {
            found = m.getWord(cell + 16)
            data.* = m.getWord(cell + 24)
            break
        }
        cell = m.getWord(cell + 40)
    }
    if found == 0 && defaultHandler != 0 {
        found = defaultHandler
        data.* = defaultData
    }
    threads.unlock(@intFromPtr(&handlersLock))
    return found
}

// Whether G_MESSAGES_DEBUG asks for the debug and info messages of
// `domain`.
fn debugWanted(domain: usize) -> bool {
    const wanted = sys.getenv(m.literal("G_MESSAGES_DEBUG"))
    if wanted == 0 { return false }
    if m.cIs(wanted, "all") { return true }
    if domain == 0 { return false }
    // A list of domains separated by spaces.
    const length = m.cLength(domain)
    var at: usize = 0
    const total = m.cLength(wanted)
    while at < total {
        var end = at
        while end < total && m.get8(wanted + end) != 32 && m.get8(wanted + end) != 44 { end += 1 }
        if end - at == length {
            var same = true
            var k: usize = 0
            while k < length {
                if m.get8(wanted + at + k) != m.get8(domain + k) { same = false }
                k += 1
            }
            if same { return true }
            if length == 3 && m.cIs(domain, "all") { return true }
        }
        at = end + 1
    }
    return false
}

fn levelName(level: i32) -> []const u8 {
    if (level & LEVEL_ERROR) != 0 { return "ERROR" }
    if (level & LEVEL_CRITICAL) != 0 { return "CRITICAL" }
    if (level & LEVEL_WARNING) != 0 { return "WARNING" }
    if (level & LEVEL_MESSAGE) != 0 { return "Message" }
    if (level & LEVEL_INFO) != 0 { return "INFO" }
    if (level & LEVEL_DEBUG) != 0 { return "DEBUG" }
    return "LOG"
}

fn pushTwo(t: *m.Text, value: i64) -> void {
    m.pushByte(t, @intCast(u8, 48 + @intCast(u64, value / 10 % 10)))
    m.pushByte(t, @intCast(u8, 48 + @intCast(u64, value % 10)))
}

// GLib's default handler.
pub fn defaultLog(domain: usize, level: i32, message: usize) -> void {
    const debugLike = (level & (LEVEL_DEBUG | LEVEL_INFO)) != 0
    if debugLike && (level & FLAG_FATAL) == 0 && !debugWanted(domain) { return }
    var t = m.text()
    const alert = (level & (LEVEL_ERROR | LEVEL_CRITICAL | LEVEL_WARNING)) != 0
    if alert { m.pushByte(&t, 10) }
    if domain == 0 { m.pushText(&t, "** ") }
    if (level & (LEVEL_ERROR | LEVEL_CRITICAL | LEVEL_WARNING | LEVEL_DEBUG)) != 0 {
        m.pushByte(&t, 40)
        const name = utils.prgname()
        if name != 0 { m.pushC(&t, name) } else { m.pushText(&t, "process") }
        m.pushByte(&t, 58)
        m.pushDecimal(&t, @intCast(u64, sys.getpid()))
        m.pushText(&t, "): ")
    }
    if domain != 0 {
        m.pushC(&t, domain)
        m.pushByte(&t, 45)
    }
    m.pushText(&t, levelName(level))
    if alert { m.pushText(&t, " **") }
    m.pushText(&t, ": ")
    // The local time of day, to the millisecond.
    const now = sys.realMicroseconds()
    const seconds = m.alloc(8)
    const parts = m.alloc(64)
    m.putI64(seconds, now / 1000000)
    _ = localtime_r(seconds, parts)
    pushTwo(&t, @intCast(i64, m.getI32(parts + 8)))
    m.pushByte(&t, 58)
    pushTwo(&t, @intCast(i64, m.getI32(parts + 4)))
    m.pushByte(&t, 58)
    pushTwo(&t, @intCast(i64, m.getI32(parts)))
    m.pushByte(&t, 46)
    const millis = (now / 1000) % 1000
    m.pushByte(&t, @intCast(u8, 48 + @intCast(u64, millis / 100)))
    pushTwo(&t, millis % 100)
    m.release(seconds)
    m.release(parts)
    m.pushText(&t, ": ")
    if message != 0 { m.pushC(&t, message) } else { m.pushText(&t, "(NULL) message") }
    m.pushByte(&t, 10)
    _ = sys.write(if debugLike { 1 } else { 2 }, t.address, t.length)
    m.dispose(&t)
}

// The message `text` (a C string) of `level` in `domain`.
pub fn log(domain: usize, level: i32, text: usize) -> void {
    var data: usize = 0
    const handler = handlerFor(domain, level, &data)
    var fatal = (level & LEVEL_ERROR) != 0 || (level & FLAG_FATAL) != 0 || (level & alwaysFatal) != 0
    const levelFlags = if fatal { level | FLAG_FATAL } else { level }
    if handler != 0 {
        const call: LogFunc = unsafe { @ptrFromInt(LogFunc, handler) }
        call(domain, levelFlags, text, data)
    } else {
        defaultLog(domain, levelFlags, text)
    }
    if fatal { abort() }
}

// A literal message.
pub fn logText(domain: usize, level: i32, text: []const u8) -> void {
    const copied = m.dupSlice(text)
    log(domain, level, copied)
    m.release(copied)
}

pub fn warning(text: []const u8) -> void { logText(0, LEVEL_WARNING, text) }
pub fn critical(text: []const u8) -> void { logText(m.literal("GLib"), LEVEL_CRITICAL, text) }

fn logList(domain: usize, level: i32, format: usize, list: usize) -> void {
    const text = varargs.formatted(format, list)
    log(domain, level, text)
    m.release(text)
}

export fn g_logv(domain: usize, level: i32, format: usize, args: usize) -> void { logList(domain, level, format, args) }

export fn g_log(domain: usize, level: i32, format: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ domain, @intCast(usize, @bitCast(u32, level)), format, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 3, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    logList(domain, level, format, list)
}

export fn g_debug(format: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ format, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    logList(0, LEVEL_DEBUG, format, list)
}

export fn g_info(format: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
