fn printTo(fd: i32, format: usize, list: usize) -> void {
    var length: usize = 0
    const text = varargs.format(format, list, &length)
    _ = sys.write(fd, text, length)
    m.release(text)
}

export fn g_print(format: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ format, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    printTo(1, format, list)
}

export fn g_printerr(format: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ format, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    printTo(2, format, list)
}

export fn g_log_default_handler(domain: usize, level: i32, message: usize, unused: usize) -> void { defaultLog(domain, level, message) }

export fn g_log_set_handler(domain: usize, levels: i32, func: usize, data: usize) -> u32 {
    const cell = m.alloc(48)
    m.putWord(cell, m.dup(domain))
    m.putI32(cell + 8, levels)
    m.putWord(cell + 16, func)
    m.putWord(cell + 24, data)
    threads.lock(@intFromPtr(&handlersLock))
    handlerIds += 1
    m.put32(cell + 32, handlerIds)
    m.putWord(cell + 40, handlers)
    handlers = cell
    threads.unlock(@intFromPtr(&handlersLock))
    return m.get32(cell + 32)
}

export fn g_log_remove_handler(domain: usize, handler_id: u32) -> void {
    threads.lock(@intFromPtr(&handlersLock))
    var place = @intFromPtr(&handlers)
    while m.getWord(place) != 0 {
        const cell = m.getWord(place)
        if m.get32(cell + 32) == handler_id {
            m.putWord(place, m.getWord(cell + 40))
            m.release(m.getWord(cell))
            m.release(cell)
            break
        }
        place = cell + 40
    }
    threads.unlock(@intFromPtr(&handlersLock))
}

export fn g_log_set_default_handler(func: usize, data: usize) -> usize {
    threads.lock(@intFromPtr(&handlersLock))
    const old = defaultHandler
    defaultHandler = func
    defaultData = data
    threads.unlock(@intFromPtr(&handlersLock))
    return if old == 0 { @intFromPtr(g_log_default_handler) } else { old }
}

export fn g_log_set_always_fatal(fatal_mask: i32) -> i32 {
    const old = alwaysFatal
    alwaysFatal = fatal_mask & 252
    return old | LEVEL_ERROR
}

export fn g_log_set_fatal_mask(domain: usize, fatal_mask: i32) -> i32 { return g_log_set_always_fatal(fatal_mask) }

export fn g_return_if_fail_warning(domain: usize, function: usize, expression: usize) -> void {
    var t = m.text()
    m.pushC(&t, function)
    m.pushText(&t, ": assertion '")
    m.pushC(&t, expression)
    m.pushText(&t, "' failed")
    log(domain, LEVEL_CRITICAL, t.address)
    m.dispose(&t)
}

export fn g_warn_message(domain: usize, file: usize, line: i32, function: usize, expression: usize) -> void {
    var t = m.text()
    m.pushC(&t, file)
    m.pushByte(&t, 58)
    m.pushSigned(&t, @intCast(i64, line))
    m.pushText(&t, ":")
    m.pushC(&t, function)
    m.pushText(&t, ": ")
    if expression == 0 {
        m.pushText(&t, "code should not be reached")
    } else {
        m.pushText(&t, "runtime check failed: (")
        m.pushC(&t, expression)
        m.pushByte(&t, 41)
    }
    log(domain, LEVEL_WARNING, t.address)
    m.dispose(&t)
}

export fn g_assertion_message_expr(domain: usize, file: usize, line: i32, function: usize, expression: usize) -> void {
    var t = m.text()
    if domain != 0 {
        m.pushC(&t, domain)
        m.pushByte(&t, 58)
    }
    m.pushText(&t, "ERROR:")
    m.pushC(&t, file)
    m.pushByte(&t, 58)
    m.pushSigned(&t, @intCast(i64, line))
    m.pushByte(&t, 58)
    m.pushC(&t, function)
    m.pushText(&t, ": ")
    if expression == 0 {
        m.pushText(&t, "code should not be reached")
    } else {
        m.pushText(&t, "assertion failed: (")
        m.pushC(&t, expression)
        m.pushByte(&t, 41)
    }
    m.pushText(&t, "\nBail out! ")
    m.pushByte(&t, 10)
    _ = sys.write(2, t.address, t.length)
    m.dispose(&t)
    abort()
}

export fn g_on_error_query(prg_name: usize) -> void {}
export fn g_on_error_stack_trace(prg_name: usize) -> void {}
