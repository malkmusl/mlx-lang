// gdataset.h's keyed data lists (GData): what a GData * points at is a
// record of the entry count (0), room (8) and the entries (16), each a
// key quark (0), the data (8) and its destroy notify (16). An entry
// removed takes the last one's place, as in GLib, so a list walked after
// removals is in GLib's order. (The flags GLib keeps in the pointer's low
// bits are not here.)
const m = @import("./memory.mlx")
const errors = @import("./errors.mlx")

pub const DestroyFn = fn(usize) -> void
pub const ForeachFn = fn(u32, usize, usize) -> void

const D_COUNT: usize = 0
const D_ROOM: usize = 8
const D_ENTRIES: usize = 16

fn entryAt(list: usize, index: usize) -> usize { return m.getWord(list + D_ENTRIES) + index * 24 }

fn find(list: usize, key: u32) -> usize {
    var index: usize = 0
    while index < m.getWord(list + D_COUNT) {
        if m.get32(entryAt(list, index)) == key { return index }
        index += 1
    }
    return m.getWord(list + D_COUNT)
}

fn destroyEntry(entry: usize) -> void {
    const destroy = m.getWord(entry + 16)
    if destroy != 0 {
        const call: DestroyFn = unsafe { @ptrFromInt(DestroyFn, destroy) }
        call(m.getWord(entry + 8))
    }
}

export fn g_datalist_init(datalist: usize) -> void { m.putWord(datalist, 0) }

export fn g_datalist_clear(datalist: usize) -> void {
    const list = m.getWord(datalist)
    if list == 0 { return }
    m.putWord(datalist, 0)
    var index: usize = 0
    while index < m.getWord(list + D_COUNT) {
        destroyEntry(entryAt(list, index))
        index += 1
    }
    m.release(m.getWord(list + D_ENTRIES))
    m.release(list)
}

fn setData(datalist: usize, key: u32, data: usize, destroy: usize, notify: bool) -> usize {
    var list = m.getWord(datalist)
    if list == 0 {
        if data == 0 { return 0 }
        list = m.alloc(D_ENTRIES + 8)
        m.putWord(datalist, list)
    }
    const index = find(list, key)
    const count = m.getWord(list + D_COUNT)
    if data == 0 {
        if index == count { return 0 }
        const entry = entryAt(list, index)
        const old = m.getWord(entry + 8)
        if notify { destroyEntry(entry) }
        m.copy(entry, entryAt(list, count - 1), 24)
        m.putWord(list + D_COUNT, count - 1)
        return old
    }
    if index < count {
        const entry = entryAt(list, index)
        destroyEntry(entry)
        m.putWord(entry + 8, data)
        m.putWord(entry + 16, destroy)
        return 0
    }
    if count == m.getWord(list + D_ROOM) {
        const larger = if count == 0 { 4 } else { count * 2 }
        m.putWord(list + D_ENTRIES, m.grow(m.getWord(list + D_ENTRIES), larger * 24))
        m.putWord(list + D_ROOM, larger)
    }
    const entry = entryAt(list, count)
    m.put32(entry, key)
    m.putWord(entry + 8, data)
    m.putWord(entry + 16, destroy)
    m.putWord(list + D_COUNT, count + 1)
    return 0
}

export fn g_datalist_id_set_data_full(datalist: usize, key_id: u32, data: usize, destroy_func: usize) -> void {
    if key_id == 0 { return }
    _ = setData(datalist, key_id, data, destroy_func, true)
}

export fn g_datalist_id_remove_no_notify(datalist: usize, key_id: u32) -> usize { return setData(datalist, key_id, 0, 0, false) }

export fn g_datalist_id_get_data(datalist: usize, key_id: u32) -> usize {
    const list = m.getWord(datalist)
    if list == 0 { return 0 }
    const index = find(list, key_id)
    if index == m.getWord(list + D_COUNT) { return 0 }
    return m.getWord(entryAt(list, index) + 8)
}

export fn g_datalist_get_data(datalist: usize, key: usize) -> usize {
    const list = m.getWord(datalist)
    if list == 0 || key == 0 { return 0 }
    var index: usize = 0
    while index < m.getWord(list + D_COUNT) {
        const entry = entryAt(list, index)
        if m.cEqual(errors.quarkString(m.get32(entry)), key) { return m.getWord(entry + 8) }
        index += 1
    }
    return 0
}

// Each entry's key, data and `user_data`, over the keys the list had when
// the walk started (an entry the function removes is not visited).
export fn g_datalist_foreach(datalist: usize, func: usize, user_data: usize) -> void {
    const list = m.getWord(datalist)
    if list == 0 || func == 0 { return }
    const count = m.getWord(list + D_COUNT)
    const keys = m.alloc(count * 4 + 4)
    var index: usize = 0
    while index < count {
        m.put32(keys + index * 4, m.get32(entryAt(list, index)))
        index += 1
    }
    const call: ForeachFn = unsafe { @ptrFromInt(ForeachFn, func) }
    index = 0
    while index < count {
        const now = m.getWord(datalist)
        if now != 0 {
            const at = find(now, m.get32(keys + index * 4))
            if at < m.getWord(now + D_COUNT) { call(m.get32(keys + index * 4), m.getWord(entryAt(now, at) + 8), user_data) }
        }
        index += 1
    }
    m.release(keys)
}
