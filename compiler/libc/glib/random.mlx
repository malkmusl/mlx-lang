// grand.h's global generator: GLib's is a Mersenne Twister seeded from
// /dev/urandom; here each number comes from the kernel's random bytes
// (getrandom), which is as unpredictable and needs no seed or lock.
// (GRand objects with their own seeds are not here.)
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")

const SYS_getrandom: usize = 318

fn randomBytes(target: usize, count: usize) -> void {
    var at: usize = 0
    while at < count {
        const n = sys.syscall3(SYS_getrandom, target + at, count - at, 0)
        if n <= 0 { continue }
        at += @intCast(usize, n)
    }
}

pub fn randomU32() -> u32 {
    var word: u32 = 0
    randomBytes(@intFromPtr(&word), 4)
    return word
}

export fn g_random_int() -> u32 { return randomU32() }

// A number in [begin, end), without the bias of a plain remainder.
export fn g_random_int_range(begin: i32, end: i32) -> i32 {
    if end <= begin { return begin }
    const span = @intCast(u64, @intCast(i64, end) - @intCast(i64, begin))
    const limit = 4294967296 - 4294967296 % span
    while true {
        const value = @intCast(u64, randomU32())
        if value < limit { return @intCast(i32, @intCast(i64, begin) + @intCast(i64, value % span)) }
    }
    return begin
}

fn randomDouble() -> f64 {
    var word: u64 = 0
    randomBytes(@intFromPtr(&word), 8)
    return @floatFromInt(f64, word >> 11) / 9007199254740992.0
}

export fn g_random_double() -> f64 { return randomDouble() }
export fn g_random_double_range(begin: f64, end: f64) -> f64 { return begin + (end - begin) * randomDouble() }

export fn g_random_set_seed(seed: u32) -> void {}
