// GParamFlags.
const READABLE: i32 = 1
const WRITABLE: i32 = 2
const CONSTRUCT: i32 = 4
const CONSTRUCT_ONLY: i32 = 8
const STATIC_STRINGS: i32 = 224

// GTlsError.
const TLS_ERROR_MISC: i32 = 1
const TLS_ERROR_BAD_CERTIFICATE: i32 = 2
const TLS_ERROR_NOT_TLS: i32 = 3
const TLS_ERROR_EOF: i32 = 6

const IO_ERROR_WOULD_BLOCK: i32 = 27
const IO_ERROR_CLOSED: i32 = 18

// GTlsProtocolVersion.
const VERSION_UNKNOWN: u32 = 0
const VERSION_TLS_1_2: u32 = 4
const VERSION_TLS_1_3: u32 = 5

// The classes' slots: GObjectClass's set_property (24), get_property
// (32), finalize (48); GIOStreamClass's get_input_stream (136),
// get_output_stream (144), close_fn (152); GInputStreamClass's read_fn
// (136); GOutputStreamClass's write_fn (136) and flush (152); the
// pollable interfaces' can_poll (16), is_readable/is_writable (24),
// create_source (32), read/write_nonblocking (40); GInitableIface's init
// (16).
const SET_PROPERTY: usize = 24
const GET_PROPERTY: usize = 32
const FINALIZE: usize = 48
const IO_GET_INPUT: usize = 136
const IO_GET_OUTPUT: usize = 144
const IO_CLOSE: usize = 152
const IN_READ: usize = 136
const OUT_WRITE: usize = 136
const OUT_FLUSH: usize = 152
const POLL_CAN_POLL: usize = 16
const POLL_READY: usize = 24
const POLL_CREATE_SOURCE: usize = 32
const POLL_NONBLOCKING: usize = 40

// The connection's record (40).
const R_BASE: usize = 0
const R_IDENTITY: usize = 8
const R_DATABASE: usize = 16
const R_DATABASE_SET: usize = 24
const R_REQUIRE_CLOSE: usize = 28
const R_INTERACTION: usize = 32
const R_CERTIFICATE: usize = 40
const R_VALIDATION: usize = 48
const R_USE_SYSTEM: usize = 52
const R_PROTOCOLS: usize = 56
const R_ENGINE: usize = 64
const R_STATE: usize = 72
const R_CLOSED: usize = 76
const R_ERROR: usize = 80
const R_PEER: usize = 88
const R_PEER_ERRORS: usize = 96
const R_VERSION: usize = 100
const R_NEGOTIATED: usize = 104
const R_SUITE: usize = 112
const R_INPUT: usize = 120
const R_OUTPUT: usize = 128
const R_TASK: usize = 136
const R_SIZE: usize = 144

// The handshake's state.
const S_NEW: u32 = 0
const S_HANDSHAKING: u32 = 1
const S_DONE: u32 = 2
const S_FAILED: u32 = 3

// Properties: GTlsConnection's, then GTlsClientConnection's (overridden).
const PROP_BASE_IO_STREAM: u32 = 1
const PROP_REQUIRE_CLOSE_NOTIFY: u32 = 2
const PROP_DATABASE: u32 = 3
const PROP_INTERACTION: u32 = 4
const PROP_CERTIFICATE: u32 = 5
const PROP_PEER_CERTIFICATE: u32 = 6
const PROP_PEER_CERTIFICATE_ERRORS: u32 = 7
const PROP_ADVERTISED_PROTOCOLS: u32 = 8
const PROP_NEGOTIATED_PROTOCOL: u32 = 9
const PROP_PROTOCOL_VERSION: u32 = 10
const PROP_CIPHERSUITE_NAME: u32 = 11
const PROP_USE_SYSTEM_CERTDB: u32 = 12
const PROP_VALIDATION_FLAGS: u32 = 21
const PROP_SERVER_IDENTITY: u32 = 22
const PROP_USE_SSL3: u32 = 23
const PROP_ACCEPTED_CAS: u32 = 24

pub const ReadFn = fn(usize, usize, usize, usize, usize) -> i64

var typesOnce: u64 = 0
var connectionType: usize = 0
var clientConnectionType: usize = 0
var implType: usize = 0
var inputType: usize = 0
var outputType: usize = 0
var acceptSignal: u32 = 0
var handshakeTag: u8 = 0

fn implement(t: usize, iface: usize, init: usize) -> void {
    const info = m.alloc(24)
    m.putWord(info, init)
    g_type_add_interface_static(t, iface, info)
    m.release(info)
}

fn ensureTypes() -> void {
    if threads.onceEnter(@intFromPtr(&typesOnce)) {
        types.ensureInit()
        connectionType = ioerrors.defineType(g_io_stream_get_type(), "GTlsConnection", 384, @intFromPtr(__mlx_glib_tls_connection_class_init), 40, 0, types.ABSTRACT)
        clientConnectionType = ioerrors.defineType(types.T_INTERFACE, "GTlsClientConnection", 64, @intFromPtr(__mlx_glib_tls_client_iface_default), 0, 0, 0)
        g_type_interface_add_prerequisite(clientConnectionType, connectionType)
        implType = ioerrors.defineType(connectionType, "GMlxTlsClientConnection", 384, @intFromPtr(__mlx_glib_tls_client_class_init), 48, @intFromPtr(__mlx_glib_tls_client_init), 0)
        implement(implType, clientConnectionType, 0)
        implement(implType, g_initable_get_type(), @intFromPtr(__mlx_glib_tls_client_initable_init))
        inputType = ioerrors.defineType(g_input_stream_get_type(), "GMlxTlsInputStream", 248, @intFromPtr(__mlx_glib_tls_input_class_init), 40, 0, 0)
        implement(inputType, g_pollable_input_stream_get_type(), @intFromPtr(__mlx_glib_tls_input_pollable_init))
        outputType = ioerrors.defineType(g_output_stream_get_type(), "GMlxTlsOutputStream", 296, @intFromPtr(__mlx_glib_tls_output_class_init), 40, 0, 0)
        implement(outputType, g_pollable_output_stream_get_type(), @intFromPtr(__mlx_glib_tls_output_pollable_init))
        threads.onceLeave(@intFromPtr(&typesOnce), 1)
    }
}

export fn g_tls_connection_get_type() -> usize {
    ensureTypes()
    return connectionType
}

export fn g_tls_client_connection_get_type() -> usize {
    ensureTypes()
    return clientConnectionType
}

// The backend's client connection type (g_tls_backend_get_client_connection_type).
export fn __mlx_glib_tls_client_connection_impl_type() -> usize {
    ensureTypes()
    return implType
}

fn record(conn: usize) -> usize { return m.getWord(conn + 40) }

fn engineOf(conn: usize) -> *tls.Client {
    unsafe { return @ptrFromInt(*tls.Client, m.getWord(record(conn) + R_ENGINE)) }
}

// ---------------------------------------------------------------------------
// The classes.

fn property(class: usize, id: u32, pspec: usize) -> void { g_object_class_install_property(class, id, pspec) }

fn named(text: []const u8) -> usize { return m.literal(text) }

export fn __mlx_glib_tls_connection_class_init(class: usize, data: usize) -> void {
    // The properties are set and read by the one implementation's
    // handlers (GObject wants them before the properties).
    m.putWord(class + SET_PROPERTY, @intFromPtr(__mlx_glib_tls_client_set_property))
    m.putWord(class + GET_PROPERTY, @intFromPtr(__mlx_glib_tls_client_get_property))
    const given = READABLE | WRITABLE | STATIC_STRINGS
    property(class, PROP_BASE_IO_STREAM, g_param_spec_object(named("base-io-stream"), named("Base IOStream"), named("The GIOStream that the connection wraps"), g_io_stream_get_type(), given | CONSTRUCT_ONLY))
    property(class, PROP_REQUIRE_CLOSE_NOTIFY, g_param_spec_boolean(named("require-close-notify"), named("Require close notify"), named("Whether to require proper TLS close notification"), 1, given | CONSTRUCT))
    property(class, PROP_DATABASE, g_param_spec_object(named("database"), named("Database"), named("Certificate database to use for looking up or verifying certificates"), g_tls_database_get_type(), given))
    property(class, PROP_INTERACTION, g_param_spec_object(named("interaction"), named("Interaction"), named("Optional object for user interaction"), g_tls_interaction_get_type(), given))
    property(class, PROP_CERTIFICATE, g_param_spec_object(named("certificate"), named("Certificate"), named("The connection's certificate"), g_tls_certificate_get_type(), given))
    property(class, PROP_PEER_CERTIFICATE, g_param_spec_object(named("peer-certificate"), named("Peer Certificate"), named("The peer's certificate"), g_tls_certificate_get_type(), READABLE | STATIC_STRINGS))
    property(class, PROP_PEER_CERTIFICATE_ERRORS, g_param_spec_flags(named("peer-certificate-errors"), named("Peer Certificate Errors"), named("Errors found with the peer's certificate"), g_tls_certificate_flags_get_type(), 0, READABLE | STATIC_STRINGS))
    property(class, PROP_ADVERTISED_PROTOCOLS, g_param_spec_boxed(named("advertised-protocols"), named("Advertised Protocols"), named("Application-layer protocols available on this connection"), g_strv_get_type(), given))
    property(class, PROP_NEGOTIATED_PROTOCOL, g_param_spec_string(named("negotiated-protocol"), named("Negotiated Protocol"), named("Application-layer protocol negotiated for this connection"), 0, READABLE | STATIC_STRINGS))
    property(class, PROP_PROTOCOL_VERSION, g_param_spec_enum(named("protocol-version"), named("Protocol Version"), named("TLS protocol version negotiated for this connection"), g_tls_protocol_version_get_type(), 0, READABLE | STATIC_STRINGS))
    property(class, PROP_CIPHERSUITE_NAME, g_param_spec_string(named("ciphersuite-name"), named("Ciphersuite Name"), named("Name of ciphersuite negotiated for this connection"), 0, READABLE | STATIC_STRINGS))
    property(class, PROP_USE_SYSTEM_CERTDB, g_param_spec_boolean(named("use-system-certdb"), named("Use system certificate database"), named("Whether to verify peer certificates against the system certificate database"), 1, given | CONSTRUCT))
    // "accept-certificate" (GTlsCertificate, GTlsCertificateFlags) ->
    // gboolean, run last, the first TRUE stopping it.
    const params = m.alloc(16)
    m.putWord(params, g_tls_certificate_get_type())
    m.putWord(params + 8, g_tls_certificate_flags_get_type())
    acceptSignal = signals.newSignal(named("accept-certificate"), m.getWord(class), 2, 0, @intFromPtr(g_signal_accumulator_true_handled), 0, 0, types.T_BOOLEAN, 2, params)
    m.release(params)
}

export fn __mlx_glib_tls_client_iface_default(iface: usize, data: usize) -> void {
    const given = READABLE | WRITABLE | STATIC_STRINGS
    g_object_interface_install_property(iface, g_param_spec_flags(named("validation-flags"), named("Validation flags"), named("What certificate validation to perform"), g_tls_certificate_flags_get_type(), 127, given | CONSTRUCT))
    g_object_interface_install_property(iface, g_param_spec_object(named("server-identity"), named("Server identity"), named("GSocketConnectable identifying the server"), g_socket_connectable_get_type(), given | CONSTRUCT))
    g_object_interface_install_property(iface, g_param_spec_boolean(named("use-ssl3"), named("Use fallback"), named("Use fallback version of SSL/TLS rather than most recent version"), 0, given | CONSTRUCT))
    g_object_interface_install_property(iface, g_param_spec_pointer(named("accepted-cas"), named("Accepted CAs"), named("Distinguished names of the CAs the server accepts certificates from"), READABLE | STATIC_STRINGS))
}

export fn __mlx_glib_tls_client_class_init(class: usize, data: usize) -> void {
    m.putWord(class + SET_PROPERTY, @intFromPtr(__mlx_glib_tls_client_set_property))
    m.putWord(class + GET_PROPERTY, @intFromPtr(__mlx_glib_tls_client_get_property))
    m.putWord(class + FINALIZE, @intFromPtr(__mlx_glib_tls_client_finalize))
    m.putWord(class + IO_GET_INPUT, @intFromPtr(__mlx_glib_tls_client_input))
    m.putWord(class + IO_GET_OUTPUT, @intFromPtr(__mlx_glib_tls_client_output))
    m.putWord(class + IO_CLOSE, @intFromPtr(__mlx_glib_tls_client_close))
    g_object_class_override_property(class, PROP_VALIDATION_FLAGS, named("validation-flags"))
    g_object_class_override_property(class, PROP_SERVER_IDENTITY, named("server-identity"))
    g_object_class_override_property(class, PROP_USE_SSL3, named("use-ssl3"))
    g_object_class_override_property(class, PROP_ACCEPTED_CAS, named("accepted-cas"))
}

export fn __mlx_glib_tls_client_init(conn: usize, class: usize) -> void {
    const r = m.alloc(R_SIZE)
    m.putWord(conn + 40, r)
    m.put32(r + R_REQUIRE_CLOSE, 1)
    m.put32(r + R_USE_SYSTEM, 1)
    m.put32(r + R_VALIDATION, 127)
    const input = g_object_new(inputType, 0)
    m.putWord(input + 32, conn)
    m.putWord(r + R_INPUT, input)
    const output = g_object_new(outputType, 0)
    m.putWord(output + 32, conn)
    m.putWord(r + R_OUTPUT, output)
}

fn dropObject(r: usize, field: usize) -> void {
    const object = m.getWord(r + field)
    if object != 0 { g_object_unref(object) }
    m.putWord(r + field, 0)
}

fn setObject(r: usize, field: usize, object: usize) -> void {
    if object != 0 { _ = g_object_ref(object) }
    dropObject(r, field)
    m.putWord(r + field, object)
}

export fn __mlx_glib_tls_client_finalize(conn: usize) -> void {
    const r = record(conn)
    // The streams first: closing them on the way flushes nothing now.
    m.put32(r + R_CLOSED, 1)
    dropObject(r, R_INPUT)
    dropObject(r, R_OUTPUT)
    if m.getWord(r + R_ENGINE) != 0 {
        tls.clientFree(engineOf(conn))
        m.release(m.getWord(r + R_ENGINE))
    }
    dropObject(r, R_BASE)
    dropObject(r, R_IDENTITY)
    dropObject(r, R_DATABASE)
    dropObject(r, R_INTERACTION)
    dropObject(r, R_CERTIFICATE)
    dropObject(r, R_PEER)
    if m.getWord(r + R_PROTOCOLS) != 0 { g_strfreev(m.getWord(r + R_PROTOCOLS)) }
    if m.getWord(r + R_ERROR) != 0 { g_error_free(m.getWord(r + R_ERROR)) }
    m.release(m.getWord(r + R_NEGOTIATED))
    m.release(m.getWord(r + R_SUITE))
    m.release(r)
    ioerrors.chainUp(g_io_stream_get_type(), FINALIZE, conn)
}

export fn __mlx_glib_tls_client_set_property(conn: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = record(conn)
    if id == PROP_BASE_IO_STREAM {
        if g_value_get_object(value) != 0 { setObject(r, R_BASE, g_value_get_object(value)) }
    } else if id == PROP_REQUIRE_CLOSE_NOTIFY {
        m.putI32(r + R_REQUIRE_CLOSE, g_value_get_boolean(value))
    } else if id == PROP_DATABASE {
        setObject(r, R_DATABASE, g_value_get_object(value))
        m.put32(r + R_DATABASE_SET, 1)
    } else if id == PROP_INTERACTION {
        setObject(r, R_INTERACTION, g_value_get_object(value))
    } else if id == PROP_CERTIFICATE {
        setObject(r, R_CERTIFICATE, g_value_get_object(value))
    } else if id == PROP_ADVERTISED_PROTOCOLS {
        if m.getWord(r + R_PROTOCOLS) != 0 { g_strfreev(m.getWord(r + R_PROTOCOLS)) }
        const strv = g_value_get_boxed(value)
        m.putWord(r + R_PROTOCOLS, if strv == 0 { 0 } else { g_strdupv(strv) })
    } else if id == PROP_USE_SYSTEM_CERTDB {
        m.putI32(r + R_USE_SYSTEM, g_value_get_boolean(value))
    } else if id == PROP_VALIDATION_FLAGS {
        m.put32(r + R_VALIDATION, g_value_get_flags(value))
    } else if id == PROP_SERVER_IDENTITY {
        setObject(r, R_IDENTITY, g_value_get_object(value))
    }
}

export fn __mlx_glib_tls_client_get_property(conn: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = record(conn)
    if id == PROP_BASE_IO_STREAM {
        g_value_set_object(value, m.getWord(r + R_BASE))
    } else if id == PROP_REQUIRE_CLOSE_NOTIFY {
        g_value_set_boolean(value, m.getI32(r + R_REQUIRE_CLOSE))
    } else if id == PROP_DATABASE {
        g_value_set_object(value, databaseOf(conn))
    } else if id == PROP_INTERACTION {
        g_value_set_object(value, m.getWord(r + R_INTERACTION))
    } else if id == PROP_CERTIFICATE {
        g_value_set_object(value, m.getWord(r + R_CERTIFICATE))
    } else if id == PROP_PEER_CERTIFICATE {
        g_value_set_object(value, m.getWord(r + R_PEER))
    } else if id == PROP_PEER_CERTIFICATE_ERRORS {
        g_value_set_flags(value, m.get32(r + R_PEER_ERRORS))
    } else if id == PROP_ADVERTISED_PROTOCOLS {
        g_value_set_boxed(value, m.getWord(r + R_PROTOCOLS))
    } else if id == PROP_NEGOTIATED_PROTOCOL {
        g_value_set_string(value, m.getWord(r + R_NEGOTIATED))
    } else if id == PROP_PROTOCOL_VERSION {
        g_value_set_enum(value, @bitCast(i32, m.get32(r + R_VERSION)))
    } else if id == PROP_CIPHERSUITE_NAME {
        g_value_set_string(value, m.getWord(r + R_SUITE))
    } else if id == PROP_USE_SYSTEM_CERTDB {
        g_value_set_boolean(value, m.getI32(r + R_USE_SYSTEM))
    } else if id == PROP_VALIDATION_FLAGS {
        g_value_set_flags(value, m.get32(r + R_VALIDATION))
    } else if id == PROP_SERVER_IDENTITY {
        g_value_set_object(value, m.getWord(r + R_IDENTITY))
    } else if id == PROP_USE_SSL3 {
        g_value_set_boolean(value, 0)
    } else if id == PROP_ACCEPTED_CAS {
        g_value_set_pointer(value, 0)
    }
}

// GInitable: a connection needs its base stream.
export fn __mlx_glib_tls_client_initable_check(conn: usize, cancellable: usize, err: usize) -> i32 {
    if m.getWord(record(conn) + R_BASE) == 0 {
        errors.set(err, g_tls_error_quark(), TLS_ERROR_MISC, "No base IO stream")
        return 0
    }
    return 1
}

export fn __mlx_glib_tls_client_initable_init(iface: usize, data: usize) -> void { m.putWord(iface + 16, @intFromPtr(__mlx_glib_tls_client_initable_check)) }

export fn __mlx_glib_tls_client_input(conn: usize) -> usize { return m.getWord(record(conn) + R_INPUT) }
export fn __mlx_glib_tls_client_output(conn: usize) -> usize { return m.getWord(record(conn) + R_OUTPUT) }

// The database chains are verified against: the one set (even NULL), or
// the backend's default one (the system's anchors).
fn databaseOf(conn: usize) -> usize {
    const r = record(conn)
    if m.get32(r + R_DATABASE_SET) == 0 && m.getWord(r + R_DATABASE) == 0 && m.getI32(r + R_USE_SYSTEM) != 0 {
        const database = g_tls_backend_get_default_database(g_tls_backend_get_default())
        m.putWord(r + R_DATABASE, database)
    }
    return m.getWord(r + R_DATABASE)
}

// ---------------------------------------------------------------------------
// Errors.

fn isWouldBlock(e: usize) -> bool {
    return e != 0 && m.get32(e) == ioerrors.quark() && m.getI32(e + 4) == IO_ERROR_WOULD_BLOCK
}

// Takes the error in `cell` (if any) into `err` (or frees it).
fn hand(cell: usize, err: usize) -> void {
    const e = m.getWord(cell)
    m.putWord(cell, 0)
    if e == 0 { return }
    if err != 0 && m.getWord(err) == 0 {
        m.putWord(err, e)
    } else {
        g_error_free(e)
    }
}

// The connection failed with the error in `cell`: it is kept (later
// operations report it again) and handed to `err`.
fn failWith(conn: usize, cell: usize, err: usize) -> void {
    const r = record(conn)
    m.put32(r + R_STATE, S_FAILED)
    const e = m.getWord(cell)
    if e != 0 && m.getWord(r + R_ERROR) == 0 { m.putWord(r + R_ERROR, g_error_copy(e)) }
    hand(cell, err)
}

fn reportFailure(conn: usize, err: usize) -> void {
    const e = m.getWord(record(conn) + R_ERROR)
    if e != 0 && err != 0 && m.getWord(err) == 0 { m.putWord(err, g_error_copy(e)) }
}

// GnuTLS's names of the alerts a server sends most.
fn alertName(code: u64) -> []const u8 {
    return match code {
        10 => "An unexpected TLS packet was received.",
        20 => "Bad record MAC",
        40 => "Handshake failed",
        42 => "Certificate is bad",
        43 => "Certificate is not supported",
        45 => "Certificate is expired",
        46 => "Unknown certificate",
        47 => "Illegal parameter",
        48 => "CA is unknown",
        50 => "Decode error",
        51 => "Decrypt error",
        70 => "Protocol version is not supported",
        71 => "Insufficient security",
        80 => "Internal error",
        86 => "Inappropriate fallback",
        109 => "A mandatory extension is missing",
        112 => "The server name sent was not recognized",
        116 => "Certificate is required",
        120 => "No supported application protocol could be negotiated",
        else => "Unknown alert",
    }
}

// The error of a failed engine, GIO's (GnuTLS backend's) words for it.
fn engineError(conn: usize, cell: usize, handshaking: bool) -> void {
    const engine = engineOf(conn)
    const failure = engine.*.failure
    var t = m.text()
    var code = TLS_ERROR_MISC
    if failure == tls.Failure.badCertificate {
        code = TLS_ERROR_BAD_CERTIFICATE
        m.pushText(&t, "Unacceptable TLS certificate")
    } else if failure == tls.Failure.eof {
        if handshaking {
            code = TLS_ERROR_NOT_TLS
            m.pushText(&t, "Peer failed to perform TLS handshake: The TLS connection was non-properly terminated.")
        } else {
            code = TLS_ERROR_EOF
            m.pushText(&t, "TLS connection closed unexpectedly")
        }
    } else if failure == tls.Failure.alertReceived {
        m.pushText(&t, "Peer sent fatal TLS alert: ")
        m.pushText(&t, alertName(engine.*.peerAlert))
    } else {
        m.pushText(&t, if handshaking { "Error performing TLS handshake: " } else { "Error reading data from TLS socket: " })
        m.pushText(&t, match failure {
            tls.Failure.protocol => "An unexpected TLS packet was received.",
            tls.Failure.handshake => "Could not negotiate a supported cipher suite.",
            tls.Failure.badRecord => "Decryption has failed.",
            tls.Failure.badSignature => "Public key signature verification has failed.",
            else => "Internal error.",
        })
    }
    const message = m.finish(&t)
    errors.set(cell, g_tls_error_quark(), code, m.cSlice(message))
    m.release(message)
}

// ---------------------------------------------------------------------------
// The base stream, blocking or not.

// Sends what the engine has to send: 1 when all of it went, 0 when the
// base stream would block (only when not `blocking`), -1 at an error (in
// `cell`).
fn flushPending(conn: usize, blocking: bool, c: usize, cell: usize) -> i32 {
    const engine = engineOf(conn)
    const output = g_io_stream_get_output_stream(m.getWord(record(conn) + R_BASE))
    while tls.hasPendingOutput(engine) {
        const pending = tls.pendingOutput(engine)
        var count: i64 = 0
        if blocking {
            count = g_output_stream_write(output, @intFromPtr(pending.pointer), pending.length, c, cell)
        } else {
            count = g_pollable_output_stream_write_nonblocking(output, @intFromPtr(pending.pointer), pending.length, c, cell)
            if count < 0 && isWouldBlock(m.getWord(cell)) {
                g_error_free(m.getWord(cell))
                m.putWord(cell, 0)
                return 0
            }
        }
        if count < 0 { return -1 }
        tls.outputSent(engine, @intCast(usize, count))
    }
    return 1
}

// Reads what the base stream has into the engine: the bytes read, 0 at
// its end, -1 at an error (in `cell`), -2 when it would block (only
// when not `blocking`).
fn fillInput(conn: usize, blocking: bool, c: usize, cell: usize) -> i64 {
    const engine = engineOf(conn)
    const input = g_io_stream_get_input_stream(m.getWord(record(conn) + R_BASE))
    const room = tls.inputRoom(engine)
    if room == 0 { return 1 }
    const space = @intFromPtr(tls.inputSpace(engine))
    var count: i64 = 0
    if blocking {
        count = g_input_stream_read(input, space, room, c, cell)
    } else {
        count = g_pollable_input_stream_read_nonblocking(input, space, room, c, cell)
        if count < 0 && isWouldBlock(m.getWord(cell)) {
            g_error_free(m.getWord(cell))
            m.putWord(cell, 0)
            return -2
        }
    }
    if count > 0 { tls.inputAdded(engine, @intCast(usize, count)) }
    return count
}

// ---------------------------------------------------------------------------
// The handshake.

// The engine, set up from the connection's properties: the server's
// name (SNI, and what the chain is checked against), the protocols to
// offer, the database's anchors.
fn startEngine(conn: usize) -> bool {
    const r = record(conn)
    const memory = m.tryZeroed(@sizeOf(tls.Client))
    if memory == 0 { return false }
    const engine: *tls.Client = unsafe { @ptrFromInt(*tls.Client, memory) }
    if !tls.clientInit(engine, m.stdAllocator()) {
        m.release(memory)
        return false
    }
    m.putWord(r + R_ENGINE, memory)
    const host = __mlx_glib_tls_identity_host(m.getWord(r + R_IDENTITY))
    if host != 0 {
        tls.setServerName(engine, m.cSlice(host))
        m.release(host)
    }
    const protocols = m.getWord(r + R_PROTOCOLS)
    if protocols != 0 {
        var list: [128]u8 = undefined
        var length: usize = 0
        var index: usize = 0
        while m.getWord(protocols + index * 8) != 0 {
            const name = m.cSlice(m.getWord(protocols + index * 8))
            if name.length > 0 && name.length < 256 && length + 1 + name.length <= 128 {
                list[length] = @intCast(u8, name.length)
                length += 1
                var at: usize = 0
                while at < name.length {
                    list[length] = name[at]
                    length += 1
                    at += 1
                }
            }
            index += 1
        }
        const bytes: [*]const u8 = &list
        tls.setAlpn(engine, bytes[0..length])
    }
    const store = __mlx_glib_tls_database_store(databaseOf(conn))
    if store != 0 { tls.setTrustStore(engine, unsafe { @ptrFromInt(*x509.TrustStore, store) }) }
    const started = tls.start(engine)
    return started != tls.State.failed
}

// The peer's chain as GTlsCertificates (each holding its issuer), and
// its errors.
fn takePeer(conn: usize) -> void {
    const r = record(conn)
    const engine = engineOf(conn)
    const count = tls.peerCertificateCount(engine)
    var issuer: usize = 0
    var index = count
    while index > 0 {
        index -= 1
        const der = x509.derOf(tls.peerCertificate(engine, index))
        const made = __mlx_glib_tls_certificate_from_der(@intFromPtr(der.pointer), der.length, issuer)
        if issuer != 0 { g_object_unref(issuer) }
        issuer = made
    }
    dropObject(r, R_PEER)
    m.putWord(r + R_PEER, issuer)
    m.put32(r + R_PEER_ERRORS, engine.*.peerFlags)
    g_object_notify(conn, named("peer-certificate\x00"))
    g_object_notify(conn, named("peer-certificate-errors\x00"))
}

// What was negotiated, once connected.
fn takeNegotiated(conn: usize) -> void {
    const r = record(conn)
    const engine = engineOf(conn)
    if m.getWord(r + R_PEER) == 0 && tls.peerCertificateCount(engine) > 0 { takePeer(conn) }
    m.put32(r + R_VERSION, if tls.negotiatedVersion(engine) == tls.VERSION_13 { VERSION_TLS_1_3 } else { VERSION_TLS_1_2 })
    m.release(m.getWord(r + R_SUITE))
    m.putWord(r + R_SUITE, m.dupSlice(tls.cipherSuiteName(tls.cipherSuite(engine))))
    const alpn = tls.alpnProtocol(engine)
    m.release(m.getWord(r + R_NEGOTIATED))
    m.putWord(r + R_NEGOTIATED, if alpn.length > 0 { m.dupSlice(alpn) } else { 0 })
    g_object_notify(conn, named("protocol-version\x00"))
    g_object_notify(conn, named("ciphersuite-name\x00"))
    if alpn.length > 0 { g_object_notify(conn, named("negotiated-protocol\x00")) }
}

// "accept-certificate": whether a handler took the chain.
fn emitAccept(conn: usize, peer: usize, flags: u32) -> bool {
    const handled = m.alloc(8)
    g_signal_emit(conn, acceptSignal, 0, peer, @intCast(usize, flags), handled)
    const accepted = m.getI32(handled) != 0
    m.release(handled)
    return accepted
}

// Runs the handshake as far as it goes: 1 when it is done, 0 when the
// base stream would block (`waiting` says on what: 1 input, 2 output),
// -1 when it failed (the error in `err`).
fn drive(conn: usize, blocking: bool, c: usize, err: usize, waiting: *u32) -> i32 {
    const r = record(conn)
    const state = m.get32(r + R_STATE)
    if state == S_DONE { return 1 }
    if state == S_FAILED {
        reportFailure(conn, err)
        return -1
    }
    const cell = m.alloc(8)
    defer m.release(cell)
    if state == S_NEW {
        if m.getWord(r + R_BASE) == 0 || !startEngine(conn) {
            errors.set(cell, g_tls_error_quark(), TLS_ERROR_MISC, "Could not create TLS connection")
            failWith(conn, cell, err)
            return -1
        }
        m.put32(r + R_STATE, S_HANDSHAKING)
    }
    const engine = engineOf(conn)
    while true {
        const flushed = flushPending(conn, blocking, c, cell)
        if flushed < 0 {
            failWith(conn, cell, err)
            return -1
        }
        if flushed == 0 {
            waiting.* = 2
            return 0
        }
        var current = tls.process(engine)
        if current == tls.State.checkCertificate {
            takePeer(conn)
            const accepted = emitAccept(conn, m.getWord(r + R_PEER), engine.*.peerFlags)
            current = tls.acceptCertificate(engine, accepted)
            continue
        }
        if current == tls.State.connected {
            takeNegotiated(conn)
            m.put32(r + R_STATE, S_DONE)
            const sent = flushPending(conn, blocking, c, cell)
            if sent < 0 {
                failWith(conn, cell, err)
                return -1
            }
            return 1
        }
        if current == tls.State.failed || current == tls.State.closed {
            // The alert, if one is to go, before giving up.
            const sent = flushPending(conn, false, c, cell)
            hand(cell, 0)
            engineError(conn, cell, true)
            failWith(conn, cell, err)
            return -1
        }
        // What the records taken in made us send (TLS 1.2's second
        // flight) goes out before waiting for more: the server waits
        // for it.
        if tls.hasPendingOutput(engine) { continue }
        const read = fillInput(conn, blocking, c, cell)
        if read == -2 {
            waiting.* = 1
            return 0
        }
        if read < 0 {
            failWith(conn, cell, err)
            return -1
        }
        if read == 0 {
            const ended = tls.endOfInput(engine)
            engineError(conn, cell, true)
            failWith(conn, cell, err)
            return -1
        }
    }
    return -1
}

export fn g_tls_connection_handshake(conn: usize, c: usize, err: usize) -> i32 {
    var waiting: u32 = 0
    return if drive(conn, true, c, err, &waiting) == 1 { 1 } else { 0 }
}

// The asynchronous handshake goes as far as the base stream lets it and
// waits on its source for more, in the task's main context.
fn asyncStep(conn: usize) -> void {
    const r = record(conn)
    const task = m.getWord(r + R_TASK)
    if task == 0 { return }
    const cell = m.alloc(8)
    var waiting: u32 = 0
    const cancellable = g_task_get_cancellable(task)
    const result = drive(conn, false, cancellable, cell, &waiting)
    if result != 0 {
        m.putWord(r + R_TASK, 0)
        if result == 1 {
            g_task_return_boolean(task, 1)
        } else {
            g_task_return_error(task, m.getWord(cell))
        }
        m.release(cell)
        g_object_unref(task)
        return
    }
    m.release(cell)
    const base = m.getWord(r + R_BASE)
    var source: usize = 0
    if waiting == 1 {
        source = g_pollable_input_stream_create_source(g_io_stream_get_input_stream(base), cancellable)
    } else {
        source = g_pollable_output_stream_create_source(g_io_stream_get_output_stream(base), cancellable)
    }
    g_source_set_callback(source, @intFromPtr(__mlx_glib_tls_handshake_ready), conn, 0)
    _ = g_source_attach(source, g_task_get_context(task))
    g_source_unref(source)
}

export fn __mlx_glib_tls_handshake_ready(stream: usize, conn: usize) -> i32 {
    asyncStep(conn)
    return 0
}

// Base streams that cannot be polled: the synchronous handshake in a
// thread, as GIO's default asynchronous operations run.
export fn __mlx_glib_tls_handshake_thread(task: usize, conn: usize, data: usize, c: usize) -> void {
    const cell = m.alloc(8)
    if g_tls_connection_handshake(conn, c, cell) != 0 {
        g_task_return_boolean(task, 1)
    } else {
        g_task_return_error(task, m.getWord(cell))
    }
    m.release(cell)
}

fn basePollable(conn: usize) -> bool {
    const base = m.getWord(record(conn) + R_BASE)
    if base == 0 { return false }
    const input = g_io_stream_get_input_stream(base)
    const output = g_io_stream_get_output_stream(base)
    return g_pollable_input_stream_can_poll(input) != 0 && g_pollable_output_stream_can_poll(output) != 0
}

export fn g_tls_connection_handshake_async(conn: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(conn, c, callback, data)
    g_task_set_source_tag(task, @intFromPtr(&handshakeTag))
    g_task_set_priority(task, io_priority)
    if !basePollable(conn) {
        g_task_run_in_thread(task, @intFromPtr(__mlx_glib_tls_handshake_thread))
        g_object_unref(task)
        return
    }
    m.putWord(record(conn) + R_TASK, task)
    asyncStep(conn)
}

export fn g_tls_connection_handshake_finish(conn: usize, result: usize, err: usize) -> i32 { return g_task_propagate_boolean(result, err) }

// ---------------------------------------------------------------------------
// Reading and writing.

fn wouldBlock(err: usize) -> void { ioerrors.set(err, IO_ERROR_WOULD_BLOCK, "Operation would block") }

// Decrypted data into `buffer`: the bytes, 0 at the end, -1 at an error.
fn readData(conn: usize, buffer: usize, count: usize, blocking: bool, c: usize, err: usize) -> i64 {
    var waiting: u32 = 0
    const handshake = drive(conn, blocking, c, err, &waiting)
    if handshake == 0 {
        wouldBlock(err)
        return -1
    }
    if handshake < 0 { return -1 }
    const r = record(conn)
    const engine = engineOf(conn)
    const cell = m.alloc(8)
    defer m.release(cell)
    while true {
        // What the engine has to send (an answer to a KeyUpdate, or data
        // a non-blocking write left) goes first.
        if flushPending(conn, blocking, c, cell) < 0 {
            hand(cell, err)
            return -1
        }
        const state = tls.process(engine)
        if tls.readable(engine) > 0 {
            return @intCast(i64, tls.read(engine, unsafe { @ptrFromInt([*]u8, buffer) }, count))
        }
        if state == tls.State.closed { return 0 }
        if state == tls.State.failed {
            if m.getWord(r + R_ERROR) == 0 {
                engineError(conn, cell, false)
                failWith(conn, cell, err)
            } else {
                reportFailure(conn, err)
            }
            return -1
        }
        const read = fillInput(conn, blocking, c, cell)
        if read == -2 {
            wouldBlock(err)
            return -1
        }
        if read < 0 {
            hand(cell, err)
            return -1
        }
        if read == 0 {
            if m.getI32(r + R_REQUIRE_CLOSE) != 0 {
                errors.set(err, g_tls_error_quark(), TLS_ERROR_EOF, "TLS connection closed unexpectedly")
                return -1
            }
            return 0
        }
    }
    return -1
}

// Data encrypted for the base stream: the bytes taken, -1 at an error.
fn writeData(conn: usize, buffer: usize, count: usize, blocking: bool, c: usize, err: usize) -> i64 {
    var waiting: u32 = 0
    const handshake = drive(conn, blocking, c, err, &waiting)
    if handshake == 0 {
        wouldBlock(err)
        return -1
    }
    if handshake < 0 { return -1 }
    const engine = engineOf(conn)
    const cell = m.alloc(8)
    defer m.release(cell)
    const before = flushPending(conn, blocking, c, cell)
    if before < 0 {
        hand(cell, err)
        return -1
    }
    if before == 0 {
        wouldBlock(err)
        return -1
    }
    const taken = tls.write(engine, unsafe { @ptrFromInt([*]const u8, buffer) }, count)
    if taken == 0 && count > 0 {
        errors.set(err, g_tls_error_quark(), TLS_ERROR_MISC, "Error writing data to TLS socket: The connection is closed.")
        return -1
    }
    // Not blocking, what does not go now goes before the next read or
    // write: the data is taken either way.
    if flushPending(conn, blocking, c, cell) < 0 {
        hand(cell, err)
        return -1
    }
    return @intCast(i64, taken)
}

fn connOf(stream: usize) -> usize { return m.getWord(stream + 32) }

export fn __mlx_glib_tls_input_read(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 { return readData(connOf(stream), buffer, count, true, c, err) }
export fn __mlx_glib_tls_output_write(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 { return writeData(connOf(stream), buffer, count, true, c, err) }

export fn __mlx_glib_tls_output_flush(stream: usize, c: usize, err: usize) -> i32 {
    const conn = connOf(stream)
    const r = record(conn)
    if m.get32(r + R_STATE) != S_DONE || m.get32(r + R_CLOSED) != 0 { return 1 }
    const cell = m.alloc(8)
    const flushed = flushPending(conn, true, c, cell)
    hand(cell, err)
    m.release(cell)
    return if flushed > 0 { 1 } else { 0 }
}

export fn __mlx_glib_tls_input_class_init(class: usize, data: usize) -> void { m.putWord(class + IN_READ, @intFromPtr(__mlx_glib_tls_input_read)) }

export fn __mlx_glib_tls_output_class_init(class: usize, data: usize) -> void {
    m.putWord(class + OUT_WRITE, @intFromPtr(__mlx_glib_tls_output_write))
    m.putWord(class + OUT_FLUSH, @intFromPtr(__mlx_glib_tls_output_flush))
}

// The pollable streams: readable when the engine has data or a whole
// record, or the base stream is; their sources the base stream's (or
// ready at once while the engine has what to give).
export fn __mlx_glib_tls_can_poll(stream: usize) -> i32 { return if basePollable(connOf(stream)) { 1 } else { 0 } }

fn engineReady(conn: usize) -> bool {
    const r = record(conn)
    if m.getWord(r + R_ENGINE) == 0 || m.get32(r + R_STATE) != S_DONE { return false }
    return tls.hasBufferedInput(engineOf(conn))
}

export fn __mlx_glib_tls_input_readable(stream: usize) -> i32 {
    const conn = connOf(stream)
    if engineReady(conn) { return 1 }
    return g_pollable_input_stream_is_readable(g_io_stream_get_input_stream(m.getWord(record(conn) + R_BASE)))
}

export fn __mlx_glib_tls_output_writable(stream: usize) -> i32 {
    const conn = connOf(stream)
    return g_pollable_output_stream_is_writable(g_io_stream_get_output_stream(m.getWord(record(conn) + R_BASE)))
}

export fn __mlx_glib_tls_input_source(stream: usize, c: usize) -> usize {
    const conn = connOf(stream)
    const base = m.getWord(record(conn) + R_BASE)
    var child: usize = 0
    if engineReady(conn) {
        child = g_timeout_source_new(0)
    } else if m.getWord(record(conn) + R_ENGINE) != 0 && tls.hasPendingOutput(engineOf(conn)) {
        child = g_pollable_output_stream_create_source(g_io_stream_get_output_stream(base), c)
    } else {
        child = g_pollable_input_stream_create_source(g_io_stream_get_input_stream(base), c)
    }
    const source = g_pollable_source_new_full(stream, child, c)
    g_source_unref(child)
    return source
}

export fn __mlx_glib_tls_output_source(stream: usize, c: usize) -> usize {
    const conn = connOf(stream)
    const child = g_pollable_output_stream_create_source(g_io_stream_get_output_stream(m.getWord(record(conn) + R_BASE)), c)
    const source = g_pollable_source_new_full(stream, child, c)
    g_source_unref(child)
    return source
}

export fn __mlx_glib_tls_input_nonblocking(stream: usize, buffer: usize, count: usize, err: usize) -> i64 { return readData(connOf(stream), buffer, count, false, 0, err) }
export fn __mlx_glib_tls_output_nonblocking(stream: usize, buffer: usize, count: usize, err: usize) -> i64 { return writeData(connOf(stream), buffer, count, false, 0, err) }

export fn __mlx_glib_tls_input_pollable_init(iface: usize, data: usize) -> void {
    m.putWord(iface + POLL_CAN_POLL, @intFromPtr(__mlx_glib_tls_can_poll))
    m.putWord(iface + POLL_READY, @intFromPtr(__mlx_glib_tls_input_readable))
    m.putWord(iface + POLL_CREATE_SOURCE, @intFromPtr(__mlx_glib_tls_input_source))
    m.putWord(iface + POLL_NONBLOCKING, @intFromPtr(__mlx_glib_tls_input_nonblocking))
}

export fn __mlx_glib_tls_output_pollable_init(iface: usize, data: usize) -> void {
    m.putWord(iface + POLL_CAN_POLL, @intFromPtr(__mlx_glib_tls_can_poll))
    m.putWord(iface + POLL_READY, @intFromPtr(__mlx_glib_tls_output_writable))
    m.putWord(iface + POLL_CREATE_SOURCE, @intFromPtr(__mlx_glib_tls_output_source))
    m.putWord(iface + POLL_NONBLOCKING, @intFromPtr(__mlx_glib_tls_output_nonblocking))
}

// Closing: close_notify (when the handshake was done), then the base
// stream.
export fn __mlx_glib_tls_client_close(conn: usize, c: usize, err: usize) -> i32 {
    const r = record(conn)
    if m.get32(r + R_CLOSED) != 0 { return 1 }
    m.put32(r + R_CLOSED, 1)
    if m.get32(r + R_STATE) == S_DONE {
        tls.close(engineOf(conn))
        const cell = m.alloc(8)
        const sent = flushPending(conn, true, c, cell)
        hand(cell, 0)
        m.release(cell)
    }
    const base = m.getWord(r + R_BASE)
    if base == 0 { return 1 }
    return g_io_stream_close(base, c, err)
}

// ---------------------------------------------------------------------------
// The API.

export fn g_tls_client_connection_new(base: usize, identity: usize, err: usize) -> usize {
    ensureTypes()
    const conn = g_object_new(implType, 0)
    const r = record(conn)
    setObject(r, R_BASE, base)
    setObject(r, R_IDENTITY, identity)
    if __mlx_glib_tls_client_initable_check(conn, 0, err) == 0 {
        g_object_unref(conn)
        return 0
    }
    return conn
}

export fn g_tls_client_connection_get_server_identity(conn: usize) -> usize { return m.getWord(record(conn) + R_IDENTITY) }

export fn g_tls_client_connection_set_server_identity(conn: usize, identity: usize) -> void {
    setObject(record(conn), R_IDENTITY, identity)
    g_object_notify(conn, named("server-identity\x00"))
}

export fn g_tls_client_connection_get_validation_flags(conn: usize) -> u32 { return m.get32(record(conn) + R_VALIDATION) }

export fn g_tls_client_connection_set_validation_flags(conn: usize, flags: u32) -> void {
    m.put32(record(conn) + R_VALIDATION, flags)
    g_object_notify(conn, named("validation-flags\x00"))
}

export fn g_tls_client_connection_get_use_ssl3(conn: usize) -> i32 { return 0 }
export fn g_tls_client_connection_set_use_ssl3(conn: usize, use_ssl3: i32) -> void {}
export fn g_tls_client_connection_get_accepted_cas(conn: usize) -> usize { return 0 }
export fn g_tls_client_connection_copy_session_state(conn: usize, source: usize) -> void {}

export fn g_tls_connection_set_database(conn: usize, database: usize) -> void {
    const r = record(conn)
    setObject(r, R_DATABASE, database)
    m.put32(r + R_DATABASE_SET, 1)
    g_object_notify(conn, named("database\x00"))
}

export fn g_tls_connection_get_database(conn: usize) -> usize { return databaseOf(conn) }

export fn g_tls_connection_set_certificate(conn: usize, certificate: usize) -> void {
    setObject(record(conn), R_CERTIFICATE, certificate)
    g_object_notify(conn, named("certificate\x00"))
}

export fn g_tls_connection_get_certificate(conn: usize) -> usize { return m.getWord(record(conn) + R_CERTIFICATE) }

export fn g_tls_connection_set_interaction(conn: usize, interaction: usize) -> void {
    setObject(record(conn), R_INTERACTION, interaction)
    g_object_notify(conn, named("interaction\x00"))
}

export fn g_tls_connection_get_interaction(conn: usize) -> usize { return m.getWord(record(conn) + R_INTERACTION) }

export fn g_tls_connection_get_peer_certificate(conn: usize) -> usize { return m.getWord(record(conn) + R_PEER) }

export fn g_tls_connection_get_peer_certificate_errors(conn: usize) -> u32 { return m.get32(record(conn) + R_PEER_ERRORS) }

export fn g_tls_connection_set_require_close_notify(conn: usize, require: i32) -> void {
    m.putI32(record(conn) + R_REQUIRE_CLOSE, require)
    g_object_notify(conn, named("require-close-notify\x00"))
}

export fn g_tls_connection_get_require_close_notify(conn: usize) -> i32 { return m.getI32(record(conn) + R_REQUIRE_CLOSE) }

export fn g_tls_connection_set_use_system_certdb(conn: usize, use_system: i32) -> void { m.putI32(record(conn) + R_USE_SYSTEM, use_system) }
export fn g_tls_connection_get_use_system_certdb(conn: usize) -> i32 { return m.getI32(record(conn) + R_USE_SYSTEM) }

// TLS 1.3 has no renegotiation and TLS 1.2's is refused: the mode is kept
// for who asks, and does nothing.
export fn g_tls_connection_set_rehandshake_mode(conn: usize, mode: i32) -> void {}
export fn g_tls_connection_get_rehandshake_mode(conn: usize) -> i32 { return 1 }

export fn g_tls_connection_set_advertised_protocols(conn: usize, protocols: usize) -> void {
    const r = record(conn)
    if m.getWord(r + R_PROTOCOLS) != 0 { g_strfreev(m.getWord(r + R_PROTOCOLS)) }
    m.putWord(r + R_PROTOCOLS, if protocols == 0 { 0 } else { g_strdupv(protocols) })
    g_object_notify(conn, named("advertised-protocols\x00"))
}

export fn g_tls_connection_get_negotiated_protocol(conn: usize) -> usize { return m.getWord(record(conn) + R_NEGOTIATED) }

export fn g_tls_connection_get_protocol_version(conn: usize) -> i32 { return @bitCast(i32, m.get32(record(conn) + R_VERSION)) }

export fn g_tls_connection_get_ciphersuite_name(conn: usize) -> usize {
    const name = m.getWord(record(conn) + R_SUITE)
    return if name == 0 { 0 } else { m.dup(name) }
}

export fn g_tls_connection_emit_accept_certificate(conn: usize, peer: usize, errors_: u32) -> i32 {
    ensureTypes()
    return if emitAccept(conn, peer, errors_) { 1 } else { 0 }
}
