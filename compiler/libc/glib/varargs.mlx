// C's variable arguments. A variadic export of the library takes the six
// integer registers and the eight vector registers as its parameters
// (its fixed parameters first) and makes them, with the caller's stack
// words above its frame, a System V va_list (what C's va_start would
// make: the gp_offset and fp_offset words, the overflow area, the
// register save area of six integer and eight vector registers), as
// mlxlibc's printf does. The arguments are then read from the va_list, or
// handed to the C library's vprintf family as one.
const m = @import("./memory.mlx")

extern("c") fn vsnprintf(buffer: usize, size: usize, format: usize, list: usize) -> i32

pub const CallList = struct {
    header: [4]u64
    save: [22]u64
}

// The va_list of a variadic export's call: `fixed` of its integer
// registers are its own parameters, `frame` its frame address, `words`
// the six integer registers, `doubles` the eight vector registers.
pub fn start(call: *CallList, fixed: usize, frame: usize, words: usize, doubles: usize) -> usize {
    const save = @intFromPtr(&call.*.save)
    m.copy(save, words, 48)
    var index: usize = 0
    while index < 8 {
        m.put64(save + 48 + index * 16, m.get64(doubles + index * 8))
        m.put64(save + 56 + index * 16, 0)
        index += 1
    }
    const header = @intFromPtr(&call.*.header)
    m.put32(header, @intCast(u32, fixed * 8))
    m.put32(header + 4, 48)
    m.putWord(header + 8, frame + 16)
    m.putWord(header + 16, save)
    return header
}

// The next integer-class argument (an integer or a pointer) of `list`.
pub fn nextWord(list: usize) -> u64 {
    const offset = m.get32(list)
    if offset < 48 {
        m.put32(list, offset + 8)
        return m.get64(m.getWord(list + 16) + @intCast(usize, offset))
    }
    const overflow = m.getWord(list + 8)
    m.putWord(list + 8, overflow + 8)
    return m.get64(overflow)
}

pub fn nextPointer(list: usize) -> usize { return @intCast(usize, nextWord(list)) }

pub fn nextInt(list: usize) -> i32 { return @bitCast(i32, @intCast(u32, (nextWord(list)) & 0xffffffff)) }

pub fn nextUint(list: usize) -> u32 { return @intCast(u32, (nextWord(list)) & 0xffffffff) }

pub fn nextLong(list: usize) -> i64 { return @bitCast(i64, nextWord(list)) }

// The next floating argument (a double; a float is passed as one).
pub fn nextDouble(list: usize) -> f64 {
    const offset = m.get32(list + 4)
    if offset < 176 {
        m.put32(list + 4, offset + 16)
        return m.getF64(m.getWord(list + 16) + @intCast(usize, offset))
    }
    const overflow = m.getWord(list + 8)
    m.putWord(list + 8, overflow + 8)
    return m.getF64(overflow)
}

// A copy of `list` (va_copy) into `storage` (24 bytes): its own reading.
pub fn duplicate(list: usize, storage: usize) -> usize {
    m.copy(storage, list, 24)
    return storage
}

// The text printf's `format` makes of `list`, as a C string from the C
// allocator (GLib's g_strdup_vprintf); its length in `length`.
pub fn format(format_: usize, list: usize, length: *usize) -> usize {
    var copyStorage: [4]u64 = [4]u64{ 0, 0, 0, 0 }
    const counting = duplicate(list, @intFromPtr(&copyStorage))
    var first: [256]u8 = undefined
    const needed = vsnprintf(@intFromPtr(&first), 256, format_, counting)
    if needed < 0 {
        length.* = 0
        return m.dupBytes(0, 0)
    }
    const size = @intCast(usize, needed)
    const result = m.raw(size + 1)
    if size < 256 {
        m.copy(result, @intFromPtr(&first), size + 1)
    } else {
        _ = vsnprintf(result, size + 1, format_, list)
    }
    length.* = size
    return result
}

pub fn formatted(format_: usize, list: usize) -> usize {
    var length: usize = 0
    return format(format_, list, &length)
}
