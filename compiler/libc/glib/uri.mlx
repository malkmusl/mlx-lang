// GUri (guri.h): URIs (RFC 3986) split into their parts, parsed against
// a base, written back, escaped and unescaped, and query parameters, by
// GLib's guri.c algorithms (its error messages included).
//
// A GUri: the scheme (0), userinfo (8), host (16), port (24, an i32),
// references (28), path (32), query (40), fragment (48), user (56),
// password (64), auth params (72) and flags (80), each text a C string
// of its own or NULL.
//
// A host name that is not ASCII is written in Punycode (its labels
// "xn--" and their encoding, ASCII letters lowered); GLib also maps it
// through IDNA's nameprep first, which this library does not do.
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const messages = @import("./messages.mlx")
const strings = @import("./strings.mlx")
const files = @import("./files.mlx")
const hash = @import("./hash.mlx")
const arrays = @import("./arrays.mlx")

const U_SCHEME: usize = 0
const U_USERINFO: usize = 8
const U_HOST: usize = 16
const U_PORT: usize = 24
const U_REFS: usize = 28
const U_PATH: usize = 32
const U_QUERY: usize = 40
const U_FRAGMENT: usize = 48
const U_USER: usize = 56
const U_PASSWORD: usize = 64
const U_AUTH_PARAMS: usize = 72
const U_FLAGS: usize = 80
const U_SIZE: usize = 88

const PARSE_RELAXED: i32 = 1
const HAS_PASSWORD: i32 = 2
const HAS_AUTH_PARAMS: i32 = 4
const ENCODED: i32 = 8
const NON_DNS: i32 = 16
const ENCODED_QUERY: i32 = 32
const ENCODED_PATH: i32 = 64
const ENCODED_FRAGMENT: i32 = 128
const SCHEME_NORMALIZE: i32 = 256

const ERROR_FAILED: i32 = 0
const ERROR_BAD_SCHEME: i32 = 1
const ERROR_BAD_USER: i32 = 2
const ERROR_BAD_PASSWORD: i32 = 3
const ERROR_BAD_AUTH_PARAMS: i32 = 4
const ERROR_BAD_HOST: i32 = 5
const ERROR_BAD_PORT: i32 = 6
const ERROR_BAD_PATH: i32 = 7
const ERROR_BAD_QUERY: i32 = 8
const ERROR_BAD_FRAGMENT: i32 = 9

fn uriQuark() -> u32 { return errors.quarkLiteral("g-uri-quark") }

fn fail(err: usize, code: i32, message: []const u8) -> void { errors.set(err, uriQuark(), code, message) }

// An error whose message quotes `length` bytes at `start` (GLib's
// "‘%.*s’") between `prefix` and `suffix`.
fn failQuoting(err: usize, code: i32, prefix: []const u8, start: usize, length: usize, suffix: []const u8) -> void {
    if err == 0 { return }
    var t = m.text()
    m.pushText(&t, prefix)
    m.pushText(&t, "‘")
    m.pushBytes(&t, start, length)
    m.pushText(&t, "’")
    m.pushText(&t, suffix)
    errors.report(err, errors.newError(uriQuark(), code, m.finish(&t)))
}

fn has(text: usize, c: u8) -> bool {
    if text == 0 { return false }
    var p = text
    while m.get8(p) != 0 {
        if m.get8(p) == c { return true }
        p += 1
    }
    return false
}

fn hasIn(text: []const u8, c: u8) -> bool {
    var i: usize = 0
    while i < text.length {
        if text[i] == c { return true }
        i += 1
    }
    return false
}

fn find(start: usize, end: usize, c: u8) -> usize {
    var p = start
    while p < end {
        if m.get8(p) == c { return p }
        p += 1
    }
    return 0
}

fn isUnreserved(c: u8) -> bool { return m.isAlnum(c) || c == '-' || c == '.' || c == '_' || c == '~' }

fn isGraph(c: u8) -> bool { return c > 32 && c < 127 }

// ---------------------------------------------------------------------------
// Decoding and encoding

// GLib's uri_decoder: %XX sequences decoded (or, `normalize` with the
// ENCODED flag, kept but upper-cased unless they stand for an unreserved
// character, and bytes that are not graphic encoded), '+' a space in a
// form. The length of the result stored in `out` (when not 0), -1 on an
// error.
fn decoder(out: usize, illegal: usize, start: usize, length: usize, normalize: bool, wwwForm: bool, flags: i32, parseError: i32, err: usize) -> isize {
    const justNormalize = normalize && (flags & ENCODED) != 0
    var t = m.text()
    m.reserve(&t, length + 1)
    var s = start
    const end = start + length
    while s < end {
        const c = m.get8(s)
        if c == '%' {
            if s + 2 >= end || !m.isHex(m.get8(s + 1)) || !m.isHex(m.get8(s + 2)) {
                if (flags & PARSE_RELAXED) == 0 {
                    fail(err, parseError, "Invalid %-encoding in URI")
                    m.dispose(&t)
                    return -1
                }
                m.pushByte(&t, c)
                s += 1
                continue
            }
            const decoded = m.hexValue(m.get8(s + 1)) * 16 + m.hexValue(m.get8(s + 2))
            if illegal != 0 && has(illegal, decoded) {
                fail(err, parseError, "Illegal character in URI")
                m.dispose(&t)
                return -1
            }
            if justNormalize && !isUnreserved(decoded) {
                m.pushByte(&t, c)
                m.pushByte(&t, m.upper(m.get8(s + 1)))
                m.pushByte(&t, m.upper(m.get8(s + 2)))
            } else {
                m.pushByte(&t, decoded)
            }
            s += 3
            continue
        }
        if wwwForm && c == '+' {
            m.pushByte(&t, ' ')
        } else if justNormalize && !isGraph(c) {
            m.pushByte(&t, '%')
            m.pushByte(&t, "0123456789ABCDEF"[@intCast(usize, c >> 4)])
            m.pushByte(&t, "0123456789ABCDEF"[@intCast(usize, c & 15)])
        } else {
            m.pushByte(&t, c)
        }
        s += 1
    }
    m.put8(t.address + t.length, 0)
    const result = m.finish(&t)
    const n = t.length
    if (flags & ENCODED) == 0 && !strings.validate(result, @intCast(i64, n), 0) {
        fail(err, parseError, "Non-UTF-8 characters in URI")
        m.release(result)
        return -1
    }
    if out != 0 {
        m.putWord(out, result)
    } else {
        m.release(result)
    }
    return @intCast(isize, n)
}

fn decode(out: usize, illegal: usize, start: usize, length: usize, wwwForm: bool, flags: i32, parseError: i32, err: usize) -> bool {
    return decoder(out, illegal, start, length, false, wwwForm, flags, parseError, err) != -1
}

fn normalize(out: usize, start: usize, length: usize, flags: i32, parseError: i32, err: usize) -> bool {
    return decoder(out, 0, start, length, true, false, flags, parseError, err) != -1
}

// GLib's _uri_encoder: unreserved and allowed characters as they are
// (and, `allowUtf8`, whole UTF-8 characters), other bytes %XX.
pub fn encode(out: *m.Text, start: usize, length: usize, allowed: usize, allowUtf8: bool) -> void {
    var p = start
    const end = start + length
    while p < end {
        const c = m.get8(p)
        if allowUtf8 && c >= 0x80 {
            const n = strings.skipLength(c)
            if p + n <= end && strings.validate(p, @intCast(i64, n), 0) {
                m.pushBytes(out, p, n)
                p += n
                continue
            }
        }
        if isUnreserved(c) || has(allowed, c) {
            m.pushByte(out, c)
        } else {
            m.pushByte(out, '%')
            m.pushByte(out, "0123456789ABCDEF"[@intCast(usize, c >> 4)])
            m.pushByte(out, "0123456789ABCDEF"[@intCast(usize, c & 15)])
        }
        p += 1
    }
}

fn encodeC(out: *m.Text, text: usize, allowed: []const u8) -> void {
    const copy = m.dupSlice(allowed)
    encode(out, text, m.cLength(text), copy, true)
    m.release(copy)
}

export fn g_uri_escape_string(unescaped: usize, reserved_chars_allowed: usize, allow_utf8: i32) -> usize {
    var t = m.text()
    encode(&t, unescaped, m.cLength(unescaped), reserved_chars_allowed, allow_utf8 != 0)
    return m.finish(&t)
}

export fn g_uri_escape_bytes(unescaped: usize, length: usize, reserved_chars_allowed: usize) -> usize {
    var t = m.text()
    encode(&t, unescaped, length, reserved_chars_allowed, false)
    return m.finish(&t)
}

export fn g_string_append_uri_escaped(s: usize, unescaped: usize, reserved_chars_allowed: usize, allow_utf8: i32) -> usize {
    var t = m.text()
    encode(&t, unescaped, m.cLength(unescaped), reserved_chars_allowed, allow_utf8 != 0)
    _ = strings.stringAppend(s, if t.address == 0 { m.literal("") } else { t.address }, t.length)
    m.dispose(&t)
    return s
}

export fn g_uri_unescape_segment(escaped: usize, escaped_end: usize, illegal: usize) -> usize {
    if escaped == 0 { return 0 }
    const length = if escaped_end != 0 { escaped_end - escaped } else { m.cLength(escaped) }
    var result: usize = 0
    const n = decoder(@intFromPtr(&result), illegal, escaped, length, false, false, ENCODED, 0, 0)
    if n < 0 { return 0 }
    if m.cLength(result) != @intCast(usize, n) {
        m.release(result)
        return 0
    }
    return result
}

export fn g_uri_unescape_string(escaped: usize, illegal: usize) -> usize { return g_uri_unescape_segment(escaped, 0, illegal) }

export fn g_uri_unescape_bytes(escaped: usize, length: i64, illegal: usize, err: usize) -> usize {
    const n = if length < 0 { m.cLength(escaped) } else { @intCast(usize, length) }
    var result: usize = 0
    const decoded = decoder(@intFromPtr(&result), illegal, escaped, n, false, false, ENCODED, ERROR_FAILED, err)
    if decoded < 0 { return 0 }
    return arrays.newBytes(result, @intCast(usize, decoded), arrays.freeFunction(), result)
}

// ---------------------------------------------------------------------------
// Host names in Punycode (RFC 3492)

fn punycodeDigit(d: u32) -> u8 { return if d < 26 { @intCast(u8, 97 + d) } else { @intCast(u8, 22 + d) } }

fn adapt(delta_: u32, points: u32, first: bool) -> u32 {
    var delta = if first { delta_ / 700 } else { delta_ / 2 }
    delta += delta / points
    var k: u32 = 0
    while delta > 455 {
        delta = delta / 35
        k += 36
    }
    return k + (36 * delta) / (delta + 38)
}

// The label of `count` characters at `points` (code points) in Punycode.
fn punycode(out: *m.Text, points: usize, count: usize) -> void {
    var basic: u32 = 0
    var i: usize = 0
    while i < count {
        const c = m.get32(points + i * 4)
        if c < 128 {
            m.pushByte(out, @intCast(u8, c))
            basic += 1
        }
        i += 1
    }
    if basic > 0 { m.pushByte(out, '-') }
    var n: u32 = 128
    var delta: u32 = 0
    var bias: u32 = 72
    var handled = basic
    while @intCast(usize, handled) < count {
        var next: u32 = 0x7fffffff
        i = 0
        while i < count {
            const c = m.get32(points + i * 4)
            if c >= n && c < next { next = c }
            i += 1
        }
        delta += (next - n) * (handled + 1)
        n = next
        i = 0
        while i < count {
            const c = m.get32(points + i * 4)
            if c < n { delta += 1 }
            if c == n {
                var q = delta
                var k: u32 = 36
                while true {
                    const t = if k <= bias { 1 } else if k >= bias + 26 { 26 } else { k - bias }
                    if q < t { break }
                    m.pushByte(out, punycodeDigit(t + (q - t) % (36 - t)))
                    q = (q - t) / (36 - t)
                    k += 36
                }
                m.pushByte(out, punycodeDigit(q))
                bias = adapt(delta, handled + 1, handled == basic)
                delta = 0
                handled += 1
            }
            i += 1
        }
        delta += 1
        n += 1
    }
}

fn hostToAscii(host: usize) -> usize {
    var out = m.text()
    var p = host
    const points = m.alloc((m.cLength(host) + 1) * 4)
    while true {
        var count: usize = 0
        var ascii = true
        while m.get8(p) != 0 && m.get8(p) != '.' {
            var c = strings.decodeUtf8(p)
            if c < 128 {
                c = @intCast(u32, m.lower(@intCast(u8, c)))
            } else {
                ascii = false
            }
            m.put32(points + count * 4, c)
            count += 1
            p += strings.skipLength(m.get8(p))
        }
        if ascii {
            var i: usize = 0
            while i < count {
                m.pushByte(&out, @intCast(u8, m.get32(points + i * 4)))
                i += 1
            }
        } else {
            m.pushText(&out, "xn--")
            punycode(&out, points, count)
        }
        if m.get8(p) == 0 { break }
        m.pushByte(&out, '.')
        p += 1
    }
    m.release(points)
    return m.finish(&out)
}

fn isNonAscii(text: usize) -> bool {
    var p = text
    while m.get8(p) != 0 {
        if m.get8(p) >= 128 { return true }
        p += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// The parts

fn parseIpLiteral(start: usize, length: usize, flags: i32, out: usize, err: usize) -> bool {
    if m.get8(start + length - 1) != ']' {
        failQuoting(err, ERROR_BAD_HOST, "Invalid IPv6 address ", start, length, " in URI")
        return false
    }
    const addrLength = length - 2
    const addr = m.dupBytes(start + 1, addrLength)
    var zone: usize = 0
    var zoneLength: usize = 0
    const pct = find(addr, addr + addrLength, '%')
    var good = true
    if pct != 0 {
        m.put8(pct, 0)
        const rest = addrLength - (pct - addr)
        if rest >= 4 && m.get8(pct + 1) == '2' && m.get8(pct + 2) == '5' {
            zone = pct + 3
        } else if (flags & PARSE_RELAXED) != 0 && rest >= 2 {
            zone = pct + 1
        } else {
            good = false
        }
        if good { zoneLength = addrLength - (zone - addr) }
    }
    if good && (!files.isIpAddress(addr) || !has(addr, ':')) { good = false }
    var decodedZone: usize = 0
    if good && zone != 0 && !decode(@intFromPtr(&decodedZone), 0, zone, zoneLength, false, flags, ERROR_BAD_HOST, 0) { good = false }
    if !good {
        m.release(addr)
        failQuoting(err, ERROR_BAD_HOST, "Invalid IPv6 address ", start, length, " in URI")
        return false
    }
    if out != 0 {
        if decodedZone != 0 {
            var t = m.text()
            m.pushC(&t, addr)
            m.pushByte(&t, '%')
            m.pushC(&t, decodedZone)
            m.putWord(out, m.finish(&t))
            m.release(addr)
        } else {
            m.putWord(out, addr)
        }
    } else {
        m.release(addr)
    }
    m.release(decodedZone)
    return true
}

fn parseHost(start: usize, length: usize, flags: i32, out: usize, err: usize) -> bool {
    if m.get8(start) == '[' { return parseIpLiteral(start, length, flags, out, err) }
    if m.isDigit(m.get8(start)) {
        const addr = m.dupBytes(start, length)
        if files.isIpAddress(addr) {
            if out != 0 { m.putWord(out, addr) } else { m.release(addr) }
            return true
        }
        m.release(addr)
    }
    if (flags & NON_DNS) != 0 { return normalize(out, start, length, flags, ERROR_BAD_HOST, err) }
    var decoded: usize = 0
    if !decode(@intFromPtr(&decoded), 0, start, length, false, flags & (0 - 1 - ENCODED), ERROR_BAD_HOST, err) { return false }
    if files.isIpAddress(decoded) {
        m.release(decoded)
        failQuoting(err, ERROR_BAD_HOST, "Illegal encoded IP address ", start, length, " in URI")
        return false
    }
    var host = decoded
    if isNonAscii(decoded) {
        host = hostToAscii(decoded)
        m.release(decoded)
    }
    if out != 0 { m.putWord(out, host) } else { m.release(host) }
    return true
}

fn parsePort(start: usize, length: usize, out: usize, err: usize) -> bool {
    if !m.isDigit(m.get8(start)) {
        failQuoting(err, ERROR_BAD_PORT, "Could not parse port ", start, length, " in URI")
        return false
    }
    var value: u64 = 0
    var p = start
    while p < start + length && m.isDigit(m.get8(p)) {
        if value < 100000000 { value = value * 10 + @intCast(u64, m.get8(p) - 48) }
        p += 1
    }
    if p != start + length {
        failQuoting(err, ERROR_BAD_PORT, "Could not parse port ", start, length, " in URI")
        return false
    }
    if value > 65535 {
        failQuoting(err, ERROR_BAD_PORT, "Port ", start, length, " in URI is out of range")
        return false
    }
    if out != 0 { m.putI32(out, @intCast(i32, value)) }
    return true
}

fn parseUserinfo(start: usize, length: usize, flags: i32, user: usize, password: usize, authParams: usize, err: usize) -> bool {
    const authEnd = start + length
    var passwordEnd: usize = 0
    if (flags & HAS_AUTH_PARAMS) != 0 { passwordEnd = find(start, authEnd, ';') }
    if passwordEnd == 0 { passwordEnd = authEnd }
    var userEnd: usize = 0
    if (flags & HAS_PASSWORD) != 0 { userEnd = find(start, passwordEnd, ':') }
    if userEnd == 0 { userEnd = passwordEnd }
    if !normalize(user, start, userEnd - start, flags, ERROR_BAD_USER, err) { return false }
    if userEnd < authEnd && m.get8(userEnd) == ':' {
        if !normalize(password, userEnd + 1, passwordEnd - (userEnd + 1), flags, ERROR_BAD_PASSWORD, err) {
            clear(user)
            return false
        }
    }
    if passwordEnd < authEnd && m.get8(passwordEnd) == ';' {
        if !normalize(authParams, passwordEnd + 1, authEnd - (passwordEnd + 1), flags, ERROR_BAD_AUTH_PARAMS, err) {
            clear(user)
            clear(password)
            return false
        }
    }
    return true
}

fn clear(out: usize) -> void {
    if out == 0 { return }
    m.release(m.getWord(out))
    m.putWord(out, 0)
}

// GLib's uri_cleanup: surrounding white space dropped, spaces %20, other
// white space removed.
fn cleanup(text: usize) -> usize {
    var start = text
    while m.isSpace(m.get8(start)) { start += 1 }
    var end = start + m.cLength(start)
    while end > start && m.isSpace(m.get8(end - 1)) { end -= 1 }
    var t = m.text()
    var p = start
    while p < end {
        const c = m.get8(p)
        if c == ' ' {
            m.pushText(&t, "%20")
        } else if !m.isSpace(c) {
            m.pushByte(&t, c)
        }
        p += 1
    }
    return m.finish(&t)
}

fn sameText(text: usize, word: []const u8) -> bool { return text != 0 && m.cIs(text, word) }

fn normalizesEmptyPath(scheme: usize) -> bool {
    return sameText(scheme, "https") || sameText(scheme, "http") || sameText(scheme, "wss") || sameText(scheme, "ws")
}

fn normalizePort(scheme: usize, port: i32) -> i32 {
    if port == 21 && sameText(scheme, "ftp") { return -1 }
    if port == 80 && (sameText(scheme, "http") || sameText(scheme, "ws")) { return -1 }
    if port == 443 && (sameText(scheme, "https") || sameText(scheme, "wss")) { return -1 }
    return port
}

pub fn defaultPort(scheme: usize) -> i32 {
    if sameText(scheme, "http") || sameText(scheme, "ws") { return 80 }
    if sameText(scheme, "https") || sameText(scheme, "wss") { return 443 }
    if sameText(scheme, "ftp") { return 21 }
    if m.get8(scheme) == 's' && m.get8(scheme + 1) == 'o' && m.get8(scheme + 2) == 'c' && m.get8(scheme + 3) == 'k' && m.get8(scheme + 4) == 's' { return 1080 }
    return -1
}



fn lowered(start: usize, length: usize) -> usize {
    const copy = m.dupBytes(start, length)
    var i: usize = 0
    while i < length {
        m.put8(copy + i, m.lower(m.get8(copy + i)))
        i += 1
    }
    return copy
}

fn spanNot(p: usize, stops: []const u8) -> usize {
    var q = p
    while m.get8(q) != 0 && !hasIn(stops, m.get8(q)) { q += 1 }
    return q
}

// GLib's g_uri_split_internal into the GUri record `u` (its texts and
// port; the user, password and auth params only `withUser`).
fn split(text: usize, flags: i32, u: usize, withUser: bool, err: usize) -> bool {
    m.putI32(u + U_PORT, -1)
    var cleaned: usize = 0
    var uri = text
    if (flags & PARSE_RELAXED) != 0 && (has(text, ' ') || has(text, 9) || has(text, 10) || has(text, 13)) {
        cleaned = cleanup(text)
        uri = cleaned
    }
    var p = uri
    while m.get8(p) != 0 && (m.isAlpha(m.get8(p)) || (p > uri && (m.isDigit(m.get8(p)) || m.get8(p) == '.' || m.get8(p) == '+' || m.get8(p) == '-'))) { p += 1 }
    if p > uri && m.get8(p) == ':' {
        m.putWord(u + U_SCHEME, lowered(uri, p - uri))
        p += 1
    } else {
        p = uri
    }
    var good = true
    if m.get8(p) == '/' && m.get8(p + 1) == '/' {
        p += 2
        var pathStart = spanNot(p, "/?#")
        var at = find(p, pathStart, '@')
        if at != 0 {
            if (flags & PARSE_RELAXED) != 0 {
                while true {
                    const next = find(at + 1, pathStart, '@')
                    if next == 0 { break }
                    at = next
                }
            }
            if withUser || (flags & (HAS_PASSWORD | HAS_AUTH_PARAMS)) != 0 {
                if !parseUserinfo(p, at - p, flags, if withUser { u + U_USER } else { 0 }, if withUser { u + U_PASSWORD } else { 0 }, if withUser { u + U_AUTH_PARAMS } else { 0 }, err) { good = false }
            }
            if good && !normalize(u + U_USERINFO, p, at - p, flags, ERROR_BAD_USER, err) { good = false }
            p = at + 1
        }
        if good {
            if (flags & PARSE_RELAXED) != 0 {
                const semi = find(p, p + m.cLength(p), ';')
                if semi != 0 && semi < pathStart { pathStart = semi }
            }
            var colon: usize = 0
            if m.get8(p) == '[' {
                const bracket = find(p, pathStart, ']')
                if bracket != 0 && m.get8(bracket + 1) == ':' { colon = bracket + 1 }
            } else {
                colon = find(p, pathStart, ':')
            }
            const hostEnd = if colon != 0 { colon } else { pathStart }
            if !parseHost(p, hostEnd - p, flags, u + U_HOST, err) {
                good = false
            } else if colon != 0 && colon != pathStart - 1 {
                p = colon + 1
                if !parsePort(p, pathStart - p, u + U_PORT, err) { good = false }
            }
            p = pathStart
        }
    }
    if good {
        const end0 = spanNot(p, "#")
        var end = end0
        if m.get8(end0) == '#' {
            if !normalize(u + U_FRAGMENT, end0 + 1, m.cLength(end0 + 1), flags | (if (flags & ENCODED_FRAGMENT) != 0 { ENCODED } else { 0 }), ERROR_BAD_FRAGMENT, err) { good = false }
        }
        if good {
            const question = find(p, end, '?')
            if question != 0 {
                if !normalize(u + U_QUERY, question + 1, end - (question + 1), flags | (if (flags & ENCODED_QUERY) != 0 { ENCODED } else { 0 }), ERROR_BAD_QUERY, err) { good = false }
                end = question
            }
        }
        if good && !normalize(u + U_PATH, p, end - p, flags | (if (flags & ENCODED_PATH) != 0 { ENCODED } else { 0 }), ERROR_BAD_PATH, err) { good = false }
    }
    if good && (flags & SCHEME_NORMALIZE) != 0 && m.getWord(u + U_SCHEME) != 0 {
        const scheme = m.getWord(u + U_SCHEME)
        if normalizesEmptyPath(scheme) && m.get8(m.getWord(u + U_PATH)) == 0 {
            m.release(m.getWord(u + U_PATH))
            m.putWord(u + U_PATH, m.dupSlice("/"))
        }
        if m.getI32(u + U_PORT) == -1 { m.putI32(u + U_PORT, defaultPort(scheme)) }
    }
    m.release(cleaned)
    if !good {
        clearParts(u)
        return false
    }
    return true
}

fn clearParts(u: usize) -> void {
    clear(u + U_SCHEME)
    clear(u + U_USERINFO)
    clear(u + U_HOST)
    clear(u + U_PATH)
    clear(u + U_QUERY)
    clear(u + U_FRAGMENT)
    clear(u + U_USER)
    clear(u + U_PASSWORD)
    clear(u + U_AUTH_PARAMS)
    m.putI32(u + U_PORT, -1)
}

fn hand(u: usize, field: usize, out: usize) -> void {
    if out != 0 {
        m.putWord(out, m.getWord(u + field))
        m.putWord(u + field, 0)
    }
}

export fn g_uri_split(uri_ref: usize, flags: i32, scheme: usize, userinfo: usize, host: usize, port: usize, path: usize, query: usize, fragment: usize, err: usize) -> i32 {
    const u = m.alloc(U_SIZE)
    const good = split(uri_ref, flags, u, false, err)
    hand(u, U_SCHEME, scheme)
    hand(u, U_USERINFO, userinfo)
    hand(u, U_HOST, host)
    if port != 0 { m.putI32(port, m.getI32(u + U_PORT)) }
    hand(u, U_PATH, path)
    hand(u, U_QUERY, query)
    hand(u, U_FRAGMENT, fragment)
    clearParts(u)
    m.release(u)
    return if good { 1 } else { 0 }
}

export fn g_uri_split_with_user(uri_ref: usize, flags: i32, scheme: usize, user: usize, password: usize, auth_params: usize, host: usize, port: usize, path: usize, query: usize, fragment: usize, err: usize) -> i32 {
    const u = m.alloc(U_SIZE)
    const good = split(uri_ref, flags, u, true, err)
    hand(u, U_SCHEME, scheme)
    hand(u, U_USER, user)
    hand(u, U_PASSWORD, password)
    hand(u, U_AUTH_PARAMS, auth_params)
    hand(u, U_HOST, host)
    if port != 0 { m.putI32(port, m.getI32(u + U_PORT)) }
    hand(u, U_PATH, path)
    hand(u, U_QUERY, query)
    hand(u, U_FRAGMENT, fragment)
    clearParts(u)
    m.release(u)
    return if good { 1 } else { 0 }
}

fn failUri(err: usize, code: i32, uri: usize, suffix: []const u8) -> void {
    if err == 0 { return }
    var t = m.text()
    m.pushText(&t, "URI ‘")
    m.pushC(&t, uri)
    m.pushText(&t, "’")
    m.pushText(&t, suffix)
    errors.report(err, errors.newError(uriQuark(), code, m.finish(&t)))
}

export fn g_uri_split_network(uri_string: usize, flags: i32, scheme: usize, host: usize, port: usize, err: usize) -> i32 {
    const u = m.alloc(U_SIZE)
    var good = split(uri_string, flags, u, false, err)
    if good {
        if m.getWord(u + U_SCHEME) == 0 {
            failUri(err, ERROR_BAD_SCHEME, uri_string, " is not an absolute URI")
            good = false
        } else if m.getWord(u + U_HOST) == 0 {
            failUri(err, ERROR_BAD_HOST, uri_string, " has no host component")
            good = false
        }
    }
    if good {
        hand(u, U_SCHEME, scheme)
        hand(u, U_HOST, host)
        if port != 0 { m.putI32(port, m.getI32(u + U_PORT)) }
    } else if port != 0 {
        m.putI32(port, -1)
    }
    clearParts(u)
    m.release(u)
    return if good { 1 } else { 0 }
}

export fn g_uri_is_valid(uri_string: usize, flags: i32, err: usize) -> i32 {
    const u = m.alloc(U_SIZE)
    var good = split(uri_string, flags, u, false, err)
    if good && m.getWord(u + U_SCHEME) == 0 {
        failUri(err, ERROR_BAD_SCHEME, uri_string, " is not an absolute URI")
        good = false
    }
    clearParts(u)
    m.release(u)
    return if good { 1 } else { 0 }
}

// RFC 3986's remove_dot_segments (5.2.4), in place.
fn removeDotSegments(path: usize) -> void {
    if m.get8(path) == 0 { return }
    var input = path
    var output = path
    while m.get8(input) != 0 {
        if startsWith(input, "../") {
            input += 3
        } else if startsWith(input, "./") {
            input += 2
        } else if startsWith(input, "/./") {
            input += 2
        } else if m.cIs(input, "/.") {
            m.put8(input + 1, 0)
        } else if startsWith(input, "/../") {
            input += 3
            output = backUp(path, output)
        } else if m.cIs(input, "/..") {
            m.put8(input + 1, 0)
            output = backUp(path, output)
        } else if m.cIs(input, "..") || m.cIs(input, ".") {
            m.put8(input, 0)
        } else {
            m.put8(output, m.get8(input))
            output += 1
            input += 1
            while m.get8(input) != 0 && m.get8(input) != '/' {
                m.put8(output, m.get8(input))
                output += 1
                input += 1
            }
        }
    }
    m.put8(output, 0)
}

fn backUp(path: usize, output: usize) -> usize {
    var o = output
    if o > path {
        while true {
            o -= 1
            if m.get8(o) == '/' || o <= path { break }
        }
    }
    return o
}

fn startsWith(p: usize, word: []const u8) -> bool {
    var i: usize = 0
    while i < word.length {
        if m.get8(p + i) != word[i] { return false }
        i += 1
    }
    return true
}

fn dupOrNull(text: usize) -> usize { return if text == 0 { 0 } else { m.dup(text) } }

fn newUri(flags: i32) -> usize {
    const u = m.alloc(U_SIZE)
    m.put32(u + U_REFS, 1)
    m.putI32(u + U_FLAGS, flags)
    m.putI32(u + U_PORT, -1)
    return u
}

pub fn parseRelative(base: usize, uriRef: usize, flags: i32, err: usize) -> usize {
    if uriRef == 0 {
        messages.critical("g_uri_parse_relative: assertion 'uri_ref != NULL' failed")
        return 0
    }
    const u = newUri(flags)
    if !split(uriRef, flags, u, true, err) {
        unref(u)
        return 0
    }
    if m.getWord(u + U_SCHEME) == 0 && base == 0 {
        fail(err, ERROR_FAILED, "URI is not absolute, and no base URI was provided")
        unref(u)
        return 0
    }
    if base != 0 {
        if m.getWord(u + U_SCHEME) != 0 {
            removeDotSegments(m.getWord(u + U_PATH))
        } else {
            m.putWord(u + U_SCHEME, m.dup(m.getWord(base + U_SCHEME)))
            if m.getWord(u + U_HOST) != 0 {
                removeDotSegments(m.getWord(u + U_PATH))
            } else {
                const path = m.getWord(u + U_PATH)
                if m.get8(path) == 0 {
                    m.release(path)
                    m.putWord(u + U_PATH, m.dup(m.getWord(base + U_PATH)))
                    if m.getWord(u + U_QUERY) == 0 { m.putWord(u + U_QUERY, dupOrNull(m.getWord(base + U_QUERY))) }
                } else if m.get8(path) == '/' {
                    removeDotSegments(path)
                } else {
                    const basePath = m.getWord(base + U_PATH)
                    var last: usize = 0
                    var q = basePath
                    while m.get8(q) != 0 {
                        if m.get8(q) == '/' { last = q }
                        q += 1
                    }
                    var t = m.text()
                    if last != 0 { m.pushBytes(&t, basePath, last - basePath) }
                    m.pushByte(&t, '/')
                    m.pushC(&t, path)
                    m.release(path)
                    const merged = m.finish(&t)
                    m.putWord(u + U_PATH, merged)
                    removeDotSegments(merged)
                }
                m.putWord(u + U_USERINFO, dupOrNull(m.getWord(base + U_USERINFO)))
                m.putWord(u + U_USER, dupOrNull(m.getWord(base + U_USER)))
                m.putWord(u + U_PASSWORD, dupOrNull(m.getWord(base + U_PASSWORD)))
                m.putWord(u + U_AUTH_PARAMS, dupOrNull(m.getWord(base + U_AUTH_PARAMS)))
                m.putWord(u + U_HOST, dupOrNull(m.getWord(base + U_HOST)))
                m.putI32(u + U_PORT, m.getI32(base + U_PORT))
            }
        }
        if (flags & SCHEME_NORMALIZE) != 0 {
            if normalizesEmptyPath(m.getWord(u + U_SCHEME)) && m.get8(m.getWord(u + U_PATH)) == 0 {
                m.release(m.getWord(u + U_PATH))
                m.putWord(u + U_PATH, m.dupSlice("/"))
            }
            m.putI32(u + U_PORT, normalizePort(m.getWord(u + U_SCHEME), m.getI32(u + U_PORT)))
        }
    } else {
        removeDotSegments(m.getWord(u + U_PATH))
    }
    return u
}

export fn g_uri_parse_relative(base_uri: usize, uri_ref: usize, flags: i32, err: usize) -> usize { return parseRelative(base_uri, uri_ref, flags, err) }
export fn g_uri_parse(uri_string: usize, flags: i32, err: usize) -> usize { return parseRelative(0, uri_string, flags, err) }

export fn g_uri_resolve_relative(base_uri_string: usize, uri_ref: usize, flags: i32, err: usize) -> usize {
    var base: usize = 0
    if base_uri_string != 0 {
        base = parseRelative(0, base_uri_string, flags, err)
        if base == 0 { return 0 }
    }
    const resolved = parseRelative(base, uri_ref, flags, err)
    if base != 0 { unref(base) }
    if resolved == 0 { return 0 }
    const text = toStringPartial(resolved, 0)
    unref(resolved)
    return text
}

pub fn ref(u: usize) -> usize {
    threads.refInc(u + U_REFS)
    return u
}

pub fn unref(u: usize) -> void {
    if threads.refDec(u + U_REFS) {
        clearParts(u)
        m.release(u)
    }
}

export fn g_uri_ref(u: usize) -> usize { return ref(u) }
export fn g_uri_unref(u: usize) -> void { unref(u) }

// ---------------------------------------------------------------------------
// Writing

fn join(flags: i32, scheme: usize, userinfo: bool, user: usize, password: usize, authParams: usize, host: usize, port: i32, path: usize, query: usize, fragment: usize) -> usize {
    const encoded = (flags & ENCODED) != 0
    if path == 0 {
        messages.critical("g_uri_join_internal: assertion 'path != NULL' failed")
        return 0
    }
    if host != 0 && m.get8(path) != 0 && m.get8(path) != '/' {
        messages.critical("g_uri_join_internal: assertion 'host == NULL || (path[0] == '\\0' || path[0] == '/')' failed")
        return 0
    }
    if host == 0 && m.get8(path) == '/' && m.get8(path + 1) == '/' {
        messages.critical("g_uri_join_internal: assertion 'host != NULL || (path[0] != '/' || path[1] != '/')' failed")
        return 0
    }
    var t = m.text()
    m.reserve(&t, 127)
    if scheme != 0 {
        m.pushC(&t, scheme)
        m.pushByte(&t, ':')
    }
    var normalizedScheme: usize = 0
    if (flags & SCHEME_NORMALIZE) != 0 && scheme != 0 && ((host != 0 && port != -1) || m.get8(path) == 0) { normalizedScheme = lowered(scheme, m.cLength(scheme)) }
    if host != 0 {
        m.pushText(&t, "//")
        if user != 0 {
            if encoded {
                m.pushC(&t, user)
            } else if userinfo {
                encodeC(&t, user, "!$&'()*+,;=:")
            } else {
                encodeC(&t, user, "!$&'()*+,=")
            }
            if password != 0 {
                m.pushByte(&t, ':')
                if encoded { m.pushC(&t, password) } else { encodeC(&t, password, "!$&'()*+,=:") }
            }
            if authParams != 0 {
                m.pushByte(&t, ';')
                if encoded { m.pushC(&t, authParams) } else { encodeC(&t, authParams, "!$&'()*+,;=:") }
            }
            m.pushByte(&t, '@')
        }
        if has(host, ':') && files.isIpAddress(host) {
            m.pushByte(&t, '[')
            if encoded { m.pushC(&t, host) } else { encodeC(&t, host, ":") }
            m.pushByte(&t, ']')
        } else {
            if encoded { m.pushC(&t, host) } else { encodeC(&t, host, "!$&'()*+,;=") }
        }
        if port != -1 && (normalizedScheme == 0 || normalizePort(normalizedScheme, port) != -1) {
            m.pushByte(&t, ':')
            m.pushSigned(&t, @intCast(i64, port))
        }
    }
    if m.get8(path) == 0 && normalizedScheme != 0 && normalizesEmptyPath(normalizedScheme) {
        m.pushByte(&t, '/')
    } else if encoded || (flags & ENCODED_PATH) != 0 {
        m.pushC(&t, path)
    } else {
        encodeC(&t, path, "!$&'()*+,;=:@/")
    }
    m.release(normalizedScheme)
    if query != 0 {
        m.pushByte(&t, '?')
        if encoded || (flags & ENCODED_QUERY) != 0 { m.pushC(&t, query) } else { encodeC(&t, query, "!$&'()*+,;=:@/?") }
    }
    if fragment != 0 {
        m.pushByte(&t, '#')
        if encoded || (flags & ENCODED_FRAGMENT) != 0 { m.pushC(&t, fragment) } else { encodeC(&t, fragment, "!$&'()*+,;=:@/?") }
    }
    return m.finish(&t)
}

export fn g_uri_join(flags: i32, scheme: usize, userinfo: usize, host: usize, port: i32, path: usize, query: usize, fragment: usize) -> usize {
    return join(flags, scheme, true, userinfo, 0, 0, host, port, path, query, fragment)
}

export fn g_uri_join_with_user(flags: i32, scheme: usize, user: usize, password: usize, auth_params: usize, host: usize, port: i32, path: usize, query: usize, fragment: usize) -> usize {
    return join(flags, scheme, false, user, password, auth_params, host, port, path, query, fragment)
}

pub fn toStringPartial(u: usize, hide: i32) -> usize {
    const hideUser = (hide & 1) != 0
    const hidePassword = (hide & 3) != 0
    const hideAuthParams = (hide & 5) != 0
    const hideQuery = (hide & 8) != 0
    const hideFragment = (hide & 16) != 0
    const flags = m.getI32(u + U_FLAGS)
    const query = if hideQuery { 0 } else { m.getWord(u + U_QUERY) }
    const fragment = if hideFragment { 0 } else { m.getWord(u + U_FRAGMENT) }
    if (flags & (HAS_PASSWORD | HAS_AUTH_PARAMS)) != 0 {
        return join(flags, m.getWord(u + U_SCHEME), false, if hideUser { 0 } else { m.getWord(u + U_USER) }, if hidePassword { 0 } else { m.getWord(u + U_PASSWORD) }, if hideAuthParams { 0 } else { m.getWord(u + U_AUTH_PARAMS) }, m.getWord(u + U_HOST), m.getI32(u + U_PORT), m.getWord(u + U_PATH), query, fragment)
    }
    return join(flags, m.getWord(u + U_SCHEME), true, if hideUser { 0 } else { m.getWord(u + U_USERINFO) }, 0, 0, m.getWord(u + U_HOST), m.getI32(u + U_PORT), m.getWord(u + U_PATH), query, fragment)
}

export fn g_uri_to_string(u: usize) -> usize { return toStringPartial(u, 0) }
export fn g_uri_to_string_partial(u: usize, flags: i32) -> usize { return toStringPartial(u, flags) }

export fn g_uri_build(flags: i32, scheme: usize, userinfo: usize, host: usize, port: i32, path: usize, query: usize, fragment: usize) -> usize {
    const u = newUri(flags)
    m.putWord(u + U_SCHEME, m.dup(scheme))
    m.putWord(u + U_USERINFO, dupOrNull(userinfo))
    m.putWord(u + U_HOST, dupOrNull(host))
    m.putI32(u + U_PORT, port)
    m.putWord(u + U_PATH, m.dup(path))
    m.putWord(u + U_QUERY, dupOrNull(query))
    m.putWord(u + U_FRAGMENT, dupOrNull(fragment))
    return u
}

export fn g_uri_build_with_user(flags: i32, scheme: usize, user: usize, password: usize, auth_params: usize, host: usize, port: i32, path: usize, query: usize, fragment: usize) -> usize {
    const u = g_uri_build(flags, scheme, 0, host, port, path, query, fragment)
    m.putWord(u + U_USER, dupOrNull(user))
    m.putWord(u + U_PASSWORD, dupOrNull(password))
    m.putWord(u + U_AUTH_PARAMS, dupOrNull(auth_params))
    if user != 0 || password != 0 || auth_params != 0 {
        var t = m.text()
        if user != 0 { m.pushC(&t, user) }
        if password != 0 {
            m.pushByte(&t, ':')
            m.pushC(&t, password)
        }
        if auth_params != 0 {
            m.pushByte(&t, ';')
            m.pushC(&t, auth_params)
        }
        m.putWord(u + U_USERINFO, m.finish(&t))
    }
    return u
}

export fn g_uri_get_scheme(u: usize) -> usize { return m.getWord(u + U_SCHEME) }
export fn g_uri_get_userinfo(u: usize) -> usize { return m.getWord(u + U_USERINFO) }
export fn g_uri_get_user(u: usize) -> usize { return m.getWord(u + U_USER) }
export fn g_uri_get_password(u: usize) -> usize { return m.getWord(u + U_PASSWORD) }
export fn g_uri_get_auth_params(u: usize) -> usize { return m.getWord(u + U_AUTH_PARAMS) }
export fn g_uri_get_host(u: usize) -> usize { return m.getWord(u + U_HOST) }

export fn g_uri_get_port(u: usize) -> i32 {
    const port = m.getI32(u + U_PORT)
    if port == -1 && (m.getI32(u + U_FLAGS) & SCHEME_NORMALIZE) != 0 { return defaultPort(m.getWord(u + U_SCHEME)) }
    return port
}

export fn g_uri_get_path(u: usize) -> usize { return m.getWord(u + U_PATH) }
export fn g_uri_get_query(u: usize) -> usize { return m.getWord(u + U_QUERY) }
export fn g_uri_get_fragment(u: usize) -> usize { return m.getWord(u + U_FRAGMENT) }
export fn g_uri_get_flags(u: usize) -> i32 { return m.getI32(u + U_FLAGS) }

// ---------------------------------------------------------------------------
// Schemes

fn schemeLength(uri: usize) -> isize {
    if !m.isAlpha(m.get8(uri)) { return -1 }
    var p = uri + 1
    while m.isAlnum(m.get8(p)) || m.get8(p) == '.' || m.get8(p) == '+' || m.get8(p) == '-' { p += 1 }
    if m.get8(p) == ':' { return @intCast(isize, p - uri) }
    return -1
}

export fn g_uri_parse_scheme(uri: usize) -> usize {
    const n = schemeLength(uri)
    if n < 0 { return 0 }
    return m.dupBytes(uri, @intCast(usize, n))
}

export fn g_uri_peek_scheme(uri: usize) -> usize {
    const n = schemeLength(uri)
    if n < 0 { return 0 }
    const lower = lowered(uri, @intCast(usize, n))
    const interned = errors.intern(lower)
    m.release(lower)
    return interned
}

// ---------------------------------------------------------------------------
// Query parameters. The iterator: the flags (0), the next attribute (8),
// the end (16), a table of the separator bytes (24).

export fn g_uri_params_iter_init(iter: usize, params: usize, length: i64, separators: usize, flags: i32) -> void {
    m.putI32(iter, flags)
    m.putWord(iter + 8, params)
    m.putWord(iter + 16, params + (if length < 0 { m.cLength(params) } else { @intCast(usize, length) }))
    m.zero(iter + 24, 256)
    var s = separators
    while m.get8(s) != 0 {
        m.put8(iter + 24 + @intCast(usize, m.get8(s)), 1)
        s += 1
    }
}

export fn g_uri_params_iter_next(iter: usize, attribute: usize, value: usize, err: usize) -> i32 {
    if attribute != 0 { m.putWord(attribute, 0) }
    if value != 0 { m.putWord(value, 0) }
    const flags = m.getI32(iter)
    const attr = m.getWord(iter + 8)
    const end = m.getWord(iter + 16)
    if attr >= end { return 0 }
    const wwwForm = (flags & 2) != 0
    const decodeFlags = if (flags & 4) != 0 { PARSE_RELAXED } else { 0 }
    var valueEnd = attr
    while valueEnd < end && m.get8(iter + 24 + @intCast(usize, m.get8(valueEnd))) == 0 { valueEnd += 1 }
    const attrEnd = find(attr, valueEnd, '=')
    if attrEnd == 0 {
        fail(err, ERROR_FAILED, "Missing ‘=’ and parameter value")
        return 0
    }
    var decodedAttr: usize = 0
    if !decode(@intFromPtr(&decodedAttr), 0, attr, attrEnd - attr, wwwForm, decodeFlags, ERROR_FAILED, err) { return 0 }
    var decodedValue: usize = 0
    if !decode(@intFromPtr(&decodedValue), 0, attrEnd + 1, valueEnd - (attrEnd + 1), wwwForm, decodeFlags, ERROR_FAILED, err) {
        m.release(decodedAttr)
        return 0
    }
    if attribute != 0 { m.putWord(attribute, decodedAttr) } else { m.release(decodedAttr) }
    if value != 0 { m.putWord(value, decodedValue) } else { m.release(decodedValue) }
    m.putWord(iter + 8, valueEnd + 1)
    return 1
}

export fn __mlx_glib_ascii_case_hash(key: usize) -> u32 {
    var h: u32 = 5381
    var p = key
    while m.get8(p) != 0 {
        h = (h << 5) +% h +% @intCast(u32, m.lower(m.get8(p)))
        p += 1
    }
    return h
}

export fn __mlx_glib_ascii_case_equal(a: usize, b: usize) -> i32 {
    var i: usize = 0
    while true {
        const x = m.lower(m.get8(a + i))
        const y = m.lower(m.get8(b + i))
        if x != y { return 0 }
        if x == 0 { return 1 }
        i += 1
    }
    return 0
}

export fn g_uri_parse_params(params: usize, length: i64, separators: usize, flags: i32, err: usize) -> usize {
    var table: usize = 0
    if (flags & 1) != 0 {
        table = hash.newTable(@intFromPtr(__mlx_glib_ascii_case_hash), @intFromPtr(__mlx_glib_ascii_case_equal), arrays.freeFunction(), arrays.freeFunction())
    } else {
        table = hash.newTable(hash.strHashFunction(), hash.strEqualFunction(), arrays.freeFunction(), arrays.freeFunction())
    }
    const iter = m.alloc(288)
    g_uri_params_iter_init(iter, params, length, separators, flags)
    const cells = m.alloc(24)
    var failed = false
    while true {
        if g_uri_params_iter_next(iter, cells, cells + 8, cells + 16) == 0 {
            failed = m.getWord(cells + 16) != 0
            break
        }
        _ = hash.insert(table, m.getWord(cells), m.getWord(cells + 8), true)
    }
    m.release(iter)
    if failed {
        errors.report(err, m.getWord(cells + 16))
        m.release(cells)
        hash.unref(table)
        return 0
    }
    m.release(cells)
    return table
}
