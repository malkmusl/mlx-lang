// gproxyresolver.h and gsimpleproxyresolver.h: the proxies to use for a
// URI. GProxyResolver is the interface (its vtable: is_supported 16,
// lookup 24, lookup_async 32, lookup_finish 40); the default resolver is
// GIO's when no proxy module is installed, GDummyProxyResolver, whose
// answer is always "direct://". GSimpleProxyResolver answers from what it
// is given, as GIO's does: hosts to ignore (names and their subdomains,
// `*.` and `.` prefixes, a port after a colon, IPv4 and IPv6 addresses and
// IPv4 ranges in CIDR form) go direct; else the proxy of the URI's scheme,
// the default proxy, or "direct://"; a socks:// proxy stands for socks5,
// socks4a and socks4 in turn.
//
// A GSimpleProxyResolver: a GObject and (24) a record of the default proxy
// (0), the hosts to ignore (8, a strv), the proxies by scheme (16, a
// GHashTable).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const types = @import("./types.mlx")
const ioerrors = @import("./ioerrors.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_object_ref(object: usize) -> usize
extern("c") fn g_object_notify(object: usize, name: usize) -> void
extern("c") fn g_object_class_install_property(class: usize, id: u32, pspec: usize) -> void
extern("c") fn g_param_spec_string(name: usize, nick: usize, blurb: usize, default_value: usize, flags: i32) -> usize
extern("c") fn g_param_spec_boxed(name: usize, nick: usize, blurb: usize, t: usize, flags: i32) -> usize
extern("c") fn g_value_get_string(value: usize) -> usize
extern("c") fn g_value_set_string(value: usize, text: usize) -> void
extern("c") fn g_value_get_boxed(value: usize) -> usize
extern("c") fn g_value_set_boxed(value: usize, boxed: usize) -> void
extern("c") fn g_strv_get_type() -> usize
extern("c") fn g_strdupv(list: usize) -> usize
extern("c") fn g_strfreev(list: usize) -> void
extern("c") fn g_type_add_interface_static(t: usize, iface: usize, info: usize) -> void
extern("c") fn g_type_interface_add_prerequisite(t: usize, prerequisite: usize) -> void
extern("c") fn g_type_interface_peek(class: usize, iface: usize) -> usize
extern("c") fn g_hash_table_new_full(hash: usize, equal: usize, key_destroy: usize, value_destroy: usize) -> usize
extern("c") fn g_hash_table_replace(table: usize, key: usize, value: usize) -> i32
extern("c") fn g_hash_table_lookup(table: usize, key: usize) -> usize
extern("c") fn g_hash_table_size(table: usize) -> u32
extern("c") fn g_hash_table_unref(table: usize) -> void
extern("c") fn g_str_hash(key: usize) -> u32
extern("c") fn g_str_equal(a: usize, b: usize) -> i32
extern("c") fn g_free(address: usize) -> void
extern("c") fn g_uri_split_network(uri: usize, flags: i32, scheme: usize, host: usize, port: usize, err: usize) -> i32
extern("c") fn g_hostname_is_ip_address(host: usize) -> i32
extern("c") fn g_task_new(source: usize, c: usize, callback: usize, data: usize) -> usize
extern("c") fn g_task_set_source_tag(task: usize, tag: usize) -> void
extern("c") fn g_task_return_pointer(task: usize, result: usize, destroy: usize) -> void
extern("c") fn g_task_return_error(task: usize, e: usize) -> void
extern("c") fn g_task_propagate_pointer(task: usize, err: usize) -> usize
extern("c") fn inet_pton(family: i32, text: usize, out: usize) -> i32

pub const LookupFn = fn(usize, usize, usize, usize) -> usize
pub const SupportedFn = fn(usize) -> i32
pub const LookupAsyncFn = fn(usize, usize, usize, usize, usize) -> void
pub const FinishFn = fn(usize, usize, usize) -> usize

var typesOnce: u64 = 0
var resolverType: usize = 0
var dummyType: usize = 0
var simpleType: usize = 0
var defaultOnce: u64 = 0
var defaultResolver: usize = 0
var lookupTag: u8 = 0

const R_DEFAULT: usize = 0
const R_IGNORE: usize = 8
const R_SCHEMES: usize = 16
const R_SIZE: usize = 24

fn rec(resolver: usize) -> usize { return m.getWord(resolver + 24) }

fn implement(t: usize, iface: usize, init: usize) -> void {
    const info = m.alloc(24)
    m.putWord(info, init)
    g_type_add_interface_static(t, iface, info)
    m.release(info)
}

fn ensureTypes() -> void {
    if threads.onceEnter(@intFromPtr(&typesOnce)) {
        types.ensureInit()
        resolverType = ioerrors.defineType(types.T_INTERFACE, "GProxyResolver", 48, 0, 0, 0, 0)
        g_type_interface_add_prerequisite(resolverType, types.T_OBJECT)
        dummyType = ioerrors.defineType(types.T_OBJECT, "GDummyProxyResolver", 136, 0, 24, 0, 0)
        implement(dummyType, resolverType, @intFromPtr(__mlx_glib_dummy_resolver_iface_init))
        simpleType = ioerrors.defineType(types.T_OBJECT, "GSimpleProxyResolver", 176, @intFromPtr(__mlx_glib_simple_resolver_class_init), 32, @intFromPtr(__mlx_glib_simple_resolver_init), 0)
        implement(simpleType, resolverType, @intFromPtr(__mlx_glib_simple_resolver_iface_init))
        threads.onceLeave(@intFromPtr(&typesOnce), 1)
    }
}

export fn g_proxy_resolver_get_type() -> usize {
    ensureTypes()
    return resolverType
}

export fn g_simple_proxy_resolver_get_type() -> usize {
    ensureTypes()
    return simpleType
}

export fn g_proxy_resolver_get_default() -> usize {
    ensureTypes()
    if threads.onceEnter(@intFromPtr(&defaultOnce)) {
        defaultResolver = g_object_new(dummyType, 0)
        threads.onceLeave(@intFromPtr(&defaultOnce), 1)
    }
    return defaultResolver
}

fn vtable(resolver: usize) -> usize {
    ensureTypes()
    return g_type_interface_peek(m.getWord(resolver), resolverType)
}

export fn g_proxy_resolver_is_supported(resolver: usize) -> i32 {
    const v = vtable(resolver)
    if v == 0 || m.getWord(v + 16) == 0 { return 1 }
    const call: SupportedFn = unsafe { @ptrFromInt(SupportedFn, m.getWord(v + 16)) }
    return call(resolver)
}

export fn g_proxy_resolver_lookup(resolver: usize, uri: usize, c: usize, err: usize) -> usize {
    const v = vtable(resolver)
    if v == 0 || m.getWord(v + 24) == 0 { return 0 }
    const call: LookupFn = unsafe { @ptrFromInt(LookupFn, m.getWord(v + 24)) }
    return call(resolver, uri, c, err)
}

export fn g_proxy_resolver_lookup_async(resolver: usize, uri: usize, c: usize, callback: usize, data: usize) -> void {
    const v = vtable(resolver)
    const call: LookupAsyncFn = unsafe { @ptrFromInt(LookupAsyncFn, m.getWord(v + 32)) }
    call(resolver, uri, c, callback, data)
}

export fn g_proxy_resolver_lookup_finish(resolver: usize, result: usize, err: usize) -> usize {
    const v = vtable(resolver)
    const call: FinishFn = unsafe { @ptrFromInt(FinishFn, m.getWord(v + 40)) }
    return call(resolver, result, err)
}

// A strv of one proxy (or socks:// as its three kinds).
fn proxies(proxy: usize) -> usize {
    var w = m.words()
    const text = m.cSlice(proxy)
    if text.length >= 8 && m.same(text[0..8], "socks://") {
        const kinds = [3][]const u8{ "socks5://", "socks4a://", "socks4://" }
        for kind in kinds {
            var t = m.text()
            m.pushText(&t, kind)
            m.pushC(&t, proxy + 8)
            m.pushWord(&w, m.finish(&t))
        }
    } else {
        m.pushWord(&w, m.dup(proxy))
    }
    return m.finishWords(&w)
}

export fn __mlx_glib_proxy_strfreev(list: usize) -> void { g_strfreev(list) }

// The lookups of a resolver whose answers are at hand: the task returns at
// once (in a later iteration of the context).
export fn __mlx_glib_resolver_lookup_async(resolver: usize, uri: usize, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(resolver, c, callback, data)
    g_task_set_source_tag(task, @intFromPtr(&lookupTag))
    const cell = m.alloc(8)
    const result = g_proxy_resolver_lookup(resolver, uri, c, cell)
    if result != 0 { g_task_return_pointer(task, result, @intFromPtr(__mlx_glib_proxy_strfreev)) } else { g_task_return_error(task, m.getWord(cell)) }
    m.release(cell)
    g_object_unref(task)
}

export fn __mlx_glib_resolver_lookup_finish(resolver: usize, result: usize, err: usize) -> usize { return g_task_propagate_pointer(result, err) }

export fn __mlx_glib_dummy_lookup(resolver: usize, uri: usize, c: usize, err: usize) -> usize { return proxies(m.literal("direct://")) }

export fn __mlx_glib_dummy_supported(resolver: usize) -> i32 { return 0 }

export fn __mlx_glib_dummy_resolver_iface_init(iface: usize, data: usize) -> void {
    m.putWord(iface + 16, @intFromPtr(__mlx_glib_dummy_supported))
    m.putWord(iface + 24, @intFromPtr(__mlx_glib_dummy_lookup))
    m.putWord(iface + 32, @intFromPtr(__mlx_glib_resolver_lookup_async))
    m.putWord(iface + 40, @intFromPtr(__mlx_glib_resolver_lookup_finish))
}

// ---------------------------------------------------------------------------
// GSimpleProxyResolver

const PROP_DEFAULT_PROXY: u32 = 1
const PROP_IGNORE_HOSTS: u32 = 2

export fn __mlx_glib_simple_resolver_init(resolver: usize, class: usize) -> void {
    const r = m.alloc(R_SIZE)
    m.putWord(r + R_SCHEMES, g_hash_table_new_full(@intFromPtr(g_str_hash), @intFromPtr(g_str_equal), @intFromPtr(g_free), @intFromPtr(g_free)))
    m.putWord(resolver + 24, r)
}

export fn __mlx_glib_simple_resolver_finalize(resolver: usize) -> void {
    const r = rec(resolver)
    m.release(m.getWord(r + R_DEFAULT))
    g_strfreev(m.getWord(r + R_IGNORE))
    g_hash_table_unref(m.getWord(r + R_SCHEMES))
    m.release(r)
    ioerrors.chainUp(types.T_OBJECT, 48, resolver)
}

export fn __mlx_glib_simple_resolver_set_property(resolver: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_DEFAULT_PROXY { setDefault(resolver, g_value_get_string(value)) }
    if id == PROP_IGNORE_HOSTS { setIgnore(resolver, g_value_get_boxed(value)) }
}

export fn __mlx_glib_simple_resolver_get_property(resolver: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_DEFAULT_PROXY { g_value_set_string(value, m.getWord(rec(resolver) + R_DEFAULT)) }
    if id == PROP_IGNORE_HOSTS { g_value_set_boxed(value, m.getWord(rec(resolver) + R_IGNORE)) }
}

export fn __mlx_glib_simple_resolver_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_glib_simple_resolver_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_simple_resolver_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_simple_resolver_finalize))
    g_object_class_install_property(class, PROP_DEFAULT_PROXY, g_param_spec_string(m.literal("default-proxy"), m.literal("default-proxy"), m.literal("default-proxy"), 0, 3 | 224))
    g_object_class_install_property(class, PROP_IGNORE_HOSTS, g_param_spec_boxed(m.literal("ignore-hosts"), m.literal("ignore-hosts"), m.literal("ignore-hosts"), g_strv_get_type(), 3 | 224))
}

fn setDefault(resolver: usize, proxy: usize) -> void {
    const r = rec(resolver)
    m.release(m.getWord(r + R_DEFAULT))
    m.putWord(r + R_DEFAULT, m.dup(proxy))
}

fn setIgnore(resolver: usize, hosts: usize) -> void {
    const r = rec(resolver)
    g_strfreev(m.getWord(r + R_IGNORE))
    m.putWord(r + R_IGNORE, if hosts != 0 { g_strdupv(hosts) } else { 0 })
}

export fn g_simple_proxy_resolver_new(default_proxy: usize, ignore_hosts: usize) -> usize {
    ensureTypes()
    const resolver = g_object_new(simpleType, 0)
    setDefault(resolver, default_proxy)
    setIgnore(resolver, ignore_hosts)
    return resolver
}

export fn g_simple_proxy_resolver_set_default_proxy(resolver: usize, default_proxy: usize) -> void {
    setDefault(resolver, default_proxy)
    g_object_notify(resolver, m.literal("default-proxy"))
}

export fn g_simple_proxy_resolver_set_ignore_hosts(resolver: usize, ignore_hosts: usize) -> void {
    setIgnore(resolver, ignore_hosts)
    g_object_notify(resolver, m.literal("ignore-hosts"))
}

export fn g_simple_proxy_resolver_set_uri_proxy(resolver: usize, uri_scheme: usize, proxy: usize) -> void {
    _ = g_hash_table_replace(m.getWord(rec(resolver) + R_SCHEMES), m.dup(uri_scheme), m.dup(proxy))
}

fn lowered(text: []const u8) -> usize {
    const copy = m.dupSlice(text)
    var i: usize = 0
    while i < text.length {
        m.put8(copy + i, m.lower(text[i]))
        i += 1
    }
    return copy
}

// An address (IPv4 or IPv6) of `text`: its family (0 when it is not one)
// and its bytes at `out` (16).
fn parseAddress(text: usize, out: usize) -> i32 {
    if inet_pton(2, text, out) == 1 { return 2 }
    if inet_pton(10, text, out) == 1 { return 10 }
    return 0
}

// Whether `host` (and `port`) is one the ignore list sends direct.
fn ignored(resolver: usize, host: usize, port: i32) -> bool {
    const list = m.getWord(rec(resolver) + R_IGNORE)
    if list == 0 { return false }
    const hostText = m.cSlice(host)
    const address = m.alloc(16)
    const family = parseAddress(host, address)
    var index: usize = 0
    var result = false
    while m.getWord(list + index * 8) != 0 && !result {
        const entry = m.cSlice(m.getWord(list + index * 8))
        index += 1
        if entry.length == 0 { continue }
        // An address or a range of them.
        var slash = entry.length
        var i: usize = 0
        while i < entry.length {
            if entry[i] == 47 { slash = i }
            i += 1
        }
        const base = m.dupSlice(entry[0..slash])
        const entryAddress = m.alloc(16)
        const entryFamily = parseAddress(base, entryAddress)
        m.release(base)
        if entryFamily != 0 {
            if family == entryFamily {
                var bits: usize = if entryFamily == 2 { 32 } else { 128 }
                if slash < entry.length {
                    var n: usize = 0
                    var j = slash + 1
                    while j < entry.length && m.isDigit(entry[j]) {
                        n = n * 10 + @intCast(usize, entry[j] - 48)
                        j += 1
                    }
                    if n < bits { bits = n }
                }
                var same = true
                var b: usize = 0
                while b < bits {
                    const mask = @intCast(u8, 128 >> @intCast(u8, b % 8))
                    if (m.get8(address + b / 8) & mask) != (m.get8(entryAddress + b / 8) & mask) { same = false }
                    b += 1
                }
                if same { result = true }
            }
            m.release(entryAddress)
            continue
        }
        m.release(entryAddress)
        // A domain, with an optional port.
        var name = entry
        var wantedPort: i32 = 0
        var colon = name.length
        i = 0
        while i < name.length {
            if name[i] == 58 { colon = i }
            i += 1
        }
        if colon < name.length {
            var n: i32 = 0
            var j = colon + 1
            while j < name.length && m.isDigit(name[j]) {
                n = n * 10 + @intCast(i32, name[j] - 48)
                j += 1
            }
            wantedPort = n
            name = name[0..colon]
        }
        if wantedPort != 0 && wantedPort != port { continue }
        if name.length >= 2 && name[0] == 42 && name[1] == 46 { name = name[2..name.length] } else if name.length >= 1 && name[0] == 46 { name = name[1..name.length] }
        if name.length == 0 { continue }
        if hostText.length == name.length && sameIgnoringCase(hostText, name) { result = true }
        if hostText.length > name.length && hostText[hostText.length - name.length - 1] == 46 && sameIgnoringCase(hostText[hostText.length - name.length..hostText.length], name) { result = true }
    }
    m.release(address)
    return result
}

fn sameIgnoringCase(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var i: usize = 0
    while i < a.length {
        if m.lower(a[i]) != m.lower(b[i]) { return false }
        i += 1
    }
    return true
}

export fn __mlx_glib_simple_lookup(resolver: usize, uri: usize, c: usize, err: usize) -> usize {
    const r = rec(resolver)
    var proxy: usize = 0
    if m.getWord(r + R_IGNORE) != 0 {
        const cells = m.alloc(16)
        // (A URI without a host is an error here, as in GLib, only when
        // there are hosts to ignore.)
        if g_uri_split_network(uri, 0, 0, cells, cells + 8, 0) == 0 {
            m.release(cells)
            var t = m.text()
            m.pushText(&t, "Invalid URI ‘")
            m.pushBytes(&t, uri, m.cLength(uri))
            m.pushText(&t, "’")
            ioerrors.setText(err, 13, &t)
            return 0
        }
        if ignored(resolver, m.getWord(cells), m.getI32(cells + 8)) { proxy = m.literal("direct://") }
        g_free(m.getWord(cells))
        m.release(cells)
    }
    if proxy == 0 && g_hash_table_size(m.getWord(r + R_SCHEMES)) > 0 {
        const text = m.cSlice(uri)
        var colon: usize = 0
        while colon < text.length && text[colon] != 58 { colon += 1 }
        const scheme = lowered(text[0..colon])
        proxy = g_hash_table_lookup(m.getWord(r + R_SCHEMES), scheme)
        m.release(scheme)
    }
    if proxy == 0 { proxy = m.getWord(r + R_DEFAULT) }
    if proxy == 0 { proxy = m.literal("direct://") }
    return proxies(proxy)
}

export fn __mlx_glib_simple_resolver_iface_init(iface: usize, data: usize) -> void {
    m.putWord(iface + 24, @intFromPtr(__mlx_glib_simple_lookup))
    m.putWord(iface + 32, @intFromPtr(__mlx_glib_resolver_lookup_async))
    m.putWord(iface + 40, @intFromPtr(__mlx_glib_resolver_lookup_finish))
}
