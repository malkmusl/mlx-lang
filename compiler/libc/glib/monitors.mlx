// gnetworkmonitor.h and gpowerprofilemonitor.h: what WebKit asks of the
// system's network and power.
//
// GNetworkMonitor is the interface (its vtable: network_changed 16,
// can_reach 24, can_reach_async 32, can_reach_finish 40) with GIO's
// properties ("network-available", "network-metered", "connectivity")
// and "network-changed" signal. The default monitor is GIO's base one
// as it is without netlink: the network is available with full
// connectivity, never metered, and does not change; it can reach what
// resolves (a GNetworkAddress by the default GResolver, a socket
// address at once).
//
// GPowerProfileMonitor is the interface with "power-saver-enabled"; the
// default monitor has no daemon to ask (GIO's asks
// power-profiles-daemon over D-Bus), so power saving is never on.
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const types = @import("./types.mlx")
const signals = @import("./signals.mlx")
const closures = @import("./closures.mlx")
const ioerrors = @import("./ioerrors.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_ref(object: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_object_interface_install_property(iface: usize, pspec: usize) -> void
extern("c") fn g_object_class_override_property(class: usize, id: u32, name: usize) -> void
extern("c") fn g_param_spec_boolean(name: usize, nick: usize, blurb: usize, default_value: i32, flags: i32) -> usize
extern("c") fn g_param_spec_enum(name: usize, nick: usize, blurb: usize, enum_type: usize, default_value: i32, flags: i32) -> usize
extern("c") fn g_value_set_boolean(value: usize, b: i32) -> void
extern("c") fn g_value_set_enum(value: usize, v: i32) -> void
extern("c") fn g_type_add_interface_static(t: usize, iface: usize, info: usize) -> void
extern("c") fn g_type_interface_add_prerequisite(t: usize, prerequisite: usize) -> void
extern("c") fn g_type_interface_peek(class: usize, iface: usize) -> usize
extern("c") fn g_type_check_instance_is_a(instance: usize, t: usize) -> i32
extern("c") fn g_network_connectivity_get_type() -> usize
extern("c") fn g_network_address_get_type() -> usize
extern("c") fn g_network_address_get_hostname(address: usize) -> usize
extern("c") fn g_resolver_get_default() -> usize
extern("c") fn g_resolver_lookup_by_name(resolver: usize, host: usize, c: usize, err: usize) -> usize
extern("c") fn g_resolver_free_addresses(addresses: usize) -> void
extern("c") fn g_task_new(source: usize, c: usize, callback: usize, data: usize) -> usize
extern("c") fn g_task_set_source_tag(task: usize, tag: usize) -> void
extern("c") fn g_task_return_boolean(task: usize, result: i32) -> void
extern("c") fn g_task_return_error(task: usize, e: usize) -> void
extern("c") fn g_task_propagate_boolean(task: usize, err: usize) -> i32

pub const CanReachFn = fn(usize, usize, usize, usize) -> i32
pub const CanReachAsyncFn = fn(usize, usize, usize, usize, usize) -> void
pub const FinishFn = fn(usize, usize, usize) -> i32

const N_CHANGED: usize = 16
const N_CAN_REACH: usize = 24
const N_CAN_REACH_ASYNC: usize = 32
const N_CAN_REACH_FINISH: usize = 40

const PROP_AVAILABLE: u32 = 1
const PROP_METERED: u32 = 2
const PROP_CONNECTIVITY: u32 = 3
const CONNECTIVITY_FULL: i32 = 4

// G_PARAM_READABLE | G_PARAM_STATIC_STRINGS
const READ_ONLY: i32 = 1 | 224

var typesOnce: u64 = 0
var monitorType: usize = 0
var baseType: usize = 0
var powerType: usize = 0
var powerBaseType: usize = 0
var changedSignal: u32 = 0
var defaultOnce: u64 = 0
var defaultMonitor: usize = 0
var powerOnce: u64 = 0
var defaultPower: usize = 0
var tagReach: u8 = 0

fn implement(t: usize, iface: usize, init: usize) -> void {
    const info = m.alloc(24)
    m.putWord(info, init)
    g_type_add_interface_static(t, iface, info)
    m.release(info)
}

fn ensureTypes() -> void {
    if threads.onceEnter(@intFromPtr(&typesOnce)) {
        types.ensureInit()
        monitorType = ioerrors.defineType(types.T_INTERFACE, "GNetworkMonitor", 48, @intFromPtr(__mlx_glib_network_monitor_iface_default), 0, 0, 0)
        g_type_interface_add_prerequisite(monitorType, types.T_OBJECT)
        baseType = ioerrors.defineType(types.T_OBJECT, "GNetworkMonitorBase", 136, @intFromPtr(__mlx_glib_network_monitor_base_class_init), 24, 0, 0)
        implement(baseType, monitorType, @intFromPtr(__mlx_glib_network_monitor_base_iface_init))
        powerType = ioerrors.defineType(types.T_INTERFACE, "GPowerProfileMonitor", 16, @intFromPtr(__mlx_glib_power_monitor_iface_default), 0, 0, 0)
        g_type_interface_add_prerequisite(powerType, types.T_OBJECT)
        powerBaseType = ioerrors.defineType(types.T_OBJECT, "GPowerProfileMonitorMlx", 136, @intFromPtr(__mlx_glib_power_monitor_class_init), 24, 0, 0)
        implement(powerBaseType, powerType, 0)
        threads.onceLeave(@intFromPtr(&typesOnce), 1)
    }
}

// ---------------------------------------------------------------------------
// GNetworkMonitor

export fn __mlx_glib_network_monitor_iface_default(iface: usize, data: usize) -> void {
    g_object_interface_install_property(iface, g_param_spec_boolean(m.literal("network-available"), m.literal("Network available"), m.literal("Whether the network is available"), 0, READ_ONLY))
    g_object_interface_install_property(iface, g_param_spec_boolean(m.literal("network-metered"), m.literal("Network metered"), m.literal("Whether the network is metered"), 0, READ_ONLY))
    g_object_interface_install_property(iface, g_param_spec_enum(m.literal("connectivity"), m.literal("Network connectivity"), m.literal("Level of network connectivity"), g_network_connectivity_get_type(), CONNECTIVITY_FULL, READ_ONLY))
    // G_SIGNAL_RUN_LAST, one gboolean.
    const params = m.alloc(8)
    m.putWord(params, types.T_BOOLEAN)
    changedSignal = signals.newSignal(m.literal("network-changed"), m.getWord(iface), 2, closures.typeClosure(m.getWord(iface), @intCast(u32, N_CHANGED)), 0, 0, 0, types.T_NONE, 1, params)
    m.release(params)
}

export fn __mlx_glib_network_monitor_base_get_property(monitor: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_AVAILABLE { g_value_set_boolean(value, 1) }
    if id == PROP_METERED { g_value_set_boolean(value, 0) }
    if id == PROP_CONNECTIVITY { g_value_set_enum(value, CONNECTIVITY_FULL) }
}

export fn __mlx_glib_network_monitor_base_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 32, @intFromPtr(__mlx_glib_network_monitor_base_get_property))
    g_object_class_override_property(class, PROP_AVAILABLE, m.literal("network-available"))
    g_object_class_override_property(class, PROP_METERED, m.literal("network-metered"))
    g_object_class_override_property(class, PROP_CONNECTIVITY, m.literal("connectivity"))
}

// Reachable is resolvable: a name by the default resolver, an address at
// once.
export fn __mlx_glib_network_monitor_base_can_reach(monitor: usize, connectable: usize, c: usize, err: usize) -> i32 {
    if g_type_check_instance_is_a(connectable, g_network_address_get_type()) == 0 { return 1 }
    const resolver = g_resolver_get_default()
    const addresses = g_resolver_lookup_by_name(resolver, g_network_address_get_hostname(connectable), c, err)
    g_object_unref(resolver)
    if addresses == 0 { return 0 }
    g_resolver_free_addresses(addresses)
    return 1
}

export fn __mlx_glib_network_monitor_base_can_reach_async(monitor: usize, connectable: usize, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(monitor, c, callback, data)
    g_task_set_source_tag(task, @intFromPtr(&tagReach))
    const cell = m.alloc(8)
    if __mlx_glib_network_monitor_base_can_reach(monitor, connectable, c, cell) != 0 { g_task_return_boolean(task, 1) } else { g_task_return_error(task, m.getWord(cell)) }
    m.release(cell)
    g_object_unref(task)
}

export fn __mlx_glib_network_monitor_base_can_reach_finish(monitor: usize, result: usize, err: usize) -> i32 { return g_task_propagate_boolean(result, err) }

export fn __mlx_glib_network_monitor_base_iface_init(iface: usize, data: usize) -> void {
    m.putWord(iface + N_CAN_REACH, @intFromPtr(__mlx_glib_network_monitor_base_can_reach))
    m.putWord(iface + N_CAN_REACH_ASYNC, @intFromPtr(__mlx_glib_network_monitor_base_can_reach_async))
    m.putWord(iface + N_CAN_REACH_FINISH, @intFromPtr(__mlx_glib_network_monitor_base_can_reach_finish))
}

export fn g_network_monitor_get_type() -> usize {
    ensureTypes()
    return monitorType
}

// The monitor is the program's, never freed (as GIO's default is).
export fn g_network_monitor_get_default() -> usize {
    if threads.onceEnter(@intFromPtr(&defaultOnce)) {
        ensureTypes()
        defaultMonitor = g_object_new(baseType, 0)
        threads.onceLeave(@intFromPtr(&defaultOnce), 1)
    }
    return defaultMonitor
}

extern("c") fn g_object_get(object: usize, name: usize, out: usize, end: usize) -> void

fn property(monitor: usize, name: []const u8) -> i32 {
    var value: i32 = 0
    g_object_get(monitor, m.literal(name), @intFromPtr(&value), 0)
    return value
}

export fn g_network_monitor_get_network_available(monitor: usize) -> i32 { return property(monitor, "network-available") }
export fn g_network_monitor_get_network_metered(monitor: usize) -> i32 { return property(monitor, "network-metered") }
export fn g_network_monitor_get_connectivity(monitor: usize) -> i32 { return property(monitor, "connectivity") }

fn vtable(monitor: usize) -> usize {
    ensureTypes()
    return g_type_interface_peek(m.getWord(monitor), monitorType)
}

export fn g_network_monitor_can_reach(monitor: usize, connectable: usize, c: usize, err: usize) -> i32 {
    const call: CanReachFn = unsafe { @ptrFromInt(CanReachFn, m.getWord(vtable(monitor) + N_CAN_REACH)) }
    return call(monitor, connectable, c, err)
}

export fn g_network_monitor_can_reach_async(monitor: usize, connectable: usize, c: usize, callback: usize, data: usize) -> void {
    const call: CanReachAsyncFn = unsafe { @ptrFromInt(CanReachAsyncFn, m.getWord(vtable(monitor) + N_CAN_REACH_ASYNC)) }
    call(monitor, connectable, c, callback, data)
}

export fn g_network_monitor_can_reach_finish(monitor: usize, result: usize, err: usize) -> i32 {
    const call: FinishFn = unsafe { @ptrFromInt(FinishFn, m.getWord(vtable(monitor) + N_CAN_REACH_FINISH)) }
    return call(monitor, result, err)
}

// ---------------------------------------------------------------------------
// GPowerProfileMonitor

export fn __mlx_glib_power_monitor_iface_default(iface: usize, data: usize) -> void {
    g_object_interface_install_property(iface, g_param_spec_boolean(m.literal("power-saver-enabled"), m.literal("Power Saver Enabled"), m.literal("Power Saver Enabled"), 0, READ_ONLY))
}

export fn __mlx_glib_power_monitor_get_property(monitor: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == 1 { g_value_set_boolean(value, 0) }
}

export fn __mlx_glib_power_monitor_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 32, @intFromPtr(__mlx_glib_power_monitor_get_property))
    g_object_class_override_property(class, 1, m.literal("power-saver-enabled"))
}

export fn g_power_profile_monitor_get_type() -> usize {
    ensureTypes()
    return powerType
}

export fn g_power_profile_monitor_dup_default() -> usize {
    if threads.onceEnter(@intFromPtr(&powerOnce)) {
        ensureTypes()
        defaultPower = g_object_new(powerBaseType, 0)
        threads.onceLeave(@intFromPtr(&powerOnce), 1)
    }
    return g_object_ref(defaultPower)
}

export fn g_power_profile_monitor_get_power_saver_enabled(monitor: usize) -> i32 { return property(monitor, "power-saver-enabled") }
