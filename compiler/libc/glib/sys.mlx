// The system under the library: Linux's calls made directly where the
// library needs nothing of the C library's state (futexes, the thread's
// id, the clocks), and the C library's functions where C programs share
// its state with the library (errno, the environment, descriptors,
// threads and their keys).
const m = @import("./memory.mlx")

pub extern("syscall") fn syscall0(number: usize) -> isize {}
pub extern("syscall") fn syscall1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn syscall2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}
pub extern("syscall") fn syscall6(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {}

pub const SYS_futex: usize = 202
pub const SYS_gettid: usize = 186
pub const SYS_clock_gettime: usize = 228

pub extern("c") fn __errno_location() -> usize
pub extern("c") fn getenv(name: usize) -> usize
pub extern("c") fn setenv(name: usize, value: usize, overwrite: i32) -> i32
pub extern("c") fn unsetenv(name: usize) -> i32
pub extern("c") fn read(fd: i32, buffer: usize, count: usize) -> isize
pub extern("c") fn write(fd: i32, buffer: usize, count: usize) -> isize
pub extern("c") fn open(path: usize, flags: i32, mode: u32) -> i32
pub extern("c") fn close(fd: i32) -> i32
pub extern("c") fn poll(fds: usize, count: u64, timeout: i32) -> i32
pub extern("c") fn pipe2(fds: usize, flags: i32) -> i32
pub extern("c") fn eventfd(initial: u32, flags: i32) -> i32
pub extern("c") fn fcntl(fd: i32, command: i32, argument: usize) -> i32
pub extern("c") fn getpid() -> i32
pub extern("c") fn strerror(errnum: i32) -> usize
pub extern("c") fn pthread_key_create(key: usize, destructor: usize) -> i32
pub extern("c") fn pthread_key_delete(key: u32) -> i32
pub extern("c") fn pthread_getspecific(key: u32) -> usize
pub extern("c") fn pthread_setspecific(key: u32, value: usize) -> i32
pub extern("c") fn pthread_create(thread: usize, attributes: usize, start: usize, argument: usize) -> i32
pub extern("c") fn pthread_join(thread: usize, result: usize) -> i32
pub extern("c") fn pthread_detach(thread: usize) -> i32
pub extern("c") fn pthread_self() -> usize
pub extern("c") fn pthread_exit(value: usize) -> void
pub extern("c") fn sched_yield() -> i32
pub extern("c") fn sysconf(name: i32) -> i64
pub extern("c") fn nanosleep(request: usize, remaining: usize) -> i32

pub fn errno() -> i32 { return m.getI32(__errno_location()) }
pub fn setErrno(value: i32) -> void { m.putI32(__errno_location(), value) }

pub const EINTR: i32 = 4
pub const EAGAIN: i32 = 11
pub const ENOENT: i32 = 2

// The calling thread's id.
pub fn tid() -> u32 { return @intCast(u32, syscall0(SYS_gettid)) }

// The monotonic clock in microseconds (GLib's g_get_monotonic_time).
pub fn monotonicMicroseconds() -> i64 { return clockMicroseconds(1) }

// The real time in microseconds since the epoch.
pub fn realMicroseconds() -> i64 { return clockMicroseconds(0) }

// (The timespec is in C memory: the main loop reads the clock over and
// over within one call of the library, which must not grow its arena.)
fn clockMicroseconds(clock: usize) -> i64 {
    const spec = m.raw(16)
    _ = syscall2(SYS_clock_gettime, clock, spec)
    const result = m.getI64(spec) * 1000000 + m.getI64(spec + 8) / 1000
    m.release(spec)
    return result
}

// Futexes (private to the process).
pub fn futexWait(word: usize, expected: u32, timeout: usize) -> isize {
    return syscall4(SYS_futex, word, 128, @intCast(usize, expected), timeout)
}

pub fn futexWake(word: usize, count: u32) -> void {
    _ = syscall3(SYS_futex, word, 129, @intCast(usize, count))
}
