// webp/mux.h
// mlx-libwebp: libwebp's muxing API (libwebp 1.3.2, mux ABI 0x0108):
// WebP files put together and taken apart (the picture or the frames,
// the ICCP, EXIF and XMP chunks, the animation's parameters, the
// canvas), and the animation encoder (WebPAnimEncoder: each frame coded
// whole and losslessly, as std.webp.encode codes). The muxer keeps copies
// of what it is given, whatever copy_data says.
const encode = @import("./encode.mlx")
const mux_types = @import("./mux_types.mlx")
const types = @import("./types.mlx")

const c_char = types.c_char
const c_int = types.c_int
const c_tokens = types.c_tokens
const WebPData = mux_types.WebPData
const WebPMuxAnimDispose = mux_types.WebPMuxAnimDispose
const WebPMuxAnimBlend = mux_types.WebPMuxAnimBlend
const WebPPicture = encode.WebPPicture
const WebPConfig = encode.WebPConfig

pub const WEBP_WEBP_MUX_H_: c_tokens = ""
pub const WEBP_MUX_ABI_VERSION: c_int = 0x0108

pub const WebPMux = struct {}

pub const WebPMuxError = enum(c_int) {
    WEBP_MUX_OK = 1,
    WEBP_MUX_NOT_FOUND = 0,
    WEBP_MUX_INVALID_ARGUMENT = -1,
    WEBP_MUX_BAD_DATA = -2,
    WEBP_MUX_MEMORY_ERROR = -3,
    WEBP_MUX_NOT_ENOUGH_DATA = -4,
}

pub const WebPChunkId = enum(c_int) {
    WEBP_CHUNK_VP8X = 0,
    WEBP_CHUNK_ICCP = 1,
    WEBP_CHUNK_ANIM = 2,
    WEBP_CHUNK_ANMF = 3,
    WEBP_CHUNK_DEPRECATED = 4,
    WEBP_CHUNK_ALPHA = 5,
    WEBP_CHUNK_IMAGE = 6,
    WEBP_CHUNK_EXIF = 7,
    WEBP_CHUNK_XMP = 8,
    WEBP_CHUNK_UNKNOWN = 9,
    WEBP_CHUNK_NIL = 10,
}

// The muxer's version: 1.3.2.
pub extern("c") fn WebPGetMuxVersion() -> c_int

pub extern("c") fn WebPNewInternal(version: c_int) -> *WebPMux

pub fn WebPMuxNew() -> *WebPMux {
    return WebPNewInternal(WEBP_MUX_ABI_VERSION)
}

pub extern("c") fn WebPMuxDelete(mux: *WebPMux) -> void
pub extern("c") fn WebPMuxCreateInternal(bitstream: *const WebPData, copy_data: c_int, version: c_int) -> *WebPMux

// A muxer holding the parts of a WebP file.
pub fn WebPMuxCreate(bitstream: *const WebPData, copy_data: c_int) -> *WebPMux {
    return WebPMuxCreateInternal(bitstream, copy_data, WEBP_MUX_ABI_VERSION)
}

pub extern("c") fn WebPMuxSetChunk(mux: *WebPMux, fourcc: *const c_char, chunk_data: *const WebPData, copy_data: c_int) -> WebPMuxError
pub extern("c") fn WebPMuxGetChunk(mux: *const WebPMux, fourcc: *const c_char, chunk_data: *WebPData) -> WebPMuxError
pub extern("c") fn WebPMuxDeleteChunk(mux: *WebPMux, fourcc: *const c_char) -> WebPMuxError

pub const WebPMuxFrameInfo = struct {
    bitstream: WebPData
    x_offset: c_int
    y_offset: c_int
    duration: c_int
    id: WebPChunkId
    dispose_method: WebPMuxAnimDispose
    blend_method: WebPMuxAnimBlend
    pad: [1]u32
}

pub extern("c") fn WebPMuxSetImage(mux: *WebPMux, bitstream: *const WebPData, copy_data: c_int) -> WebPMuxError
pub extern("c") fn WebPMuxPushFrame(mux: *WebPMux, frame: *const WebPMuxFrameInfo, copy_data: c_int) -> WebPMuxError
pub extern("c") fn WebPMuxGetFrame(mux: *const WebPMux, nth: u32, frame: *WebPMuxFrameInfo) -> WebPMuxError
pub extern("c") fn WebPMuxDeleteFrame(mux: *WebPMux, nth: u32) -> WebPMuxError

pub const WebPMuxAnimParams = struct {
    bgcolor: u32
    loop_count: c_int
}

pub extern("c") fn WebPMuxSetAnimationParams(mux: *WebPMux, params: *const WebPMuxAnimParams) -> WebPMuxError
pub extern("c") fn WebPMuxGetAnimationParams(mux: *const WebPMux, params: *WebPMuxAnimParams) -> WebPMuxError
pub extern("c") fn WebPMuxSetCanvasSize(mux: *WebPMux, width: c_int, height: c_int) -> WebPMuxError
pub extern("c") fn WebPMuxGetCanvasSize(mux: *const WebPMux, width: *c_int, height: *c_int) -> WebPMuxError
pub extern("c") fn WebPMuxGetFeatures(mux: *const WebPMux, flags: *u32) -> WebPMuxError
pub extern("c") fn WebPMuxNumChunks(mux: *const WebPMux, id: WebPChunkId, num_elements: *c_int) -> WebPMuxError
// The file, into memory of the library's (WebPDataClear frees it).
pub extern("c") fn WebPMuxAssemble(mux: *WebPMux, assembled_data: *WebPData) -> WebPMuxError

pub const WebPAnimEncoder = struct {}

pub const WebPAnimEncoderOptions = struct {
    anim_params: WebPMuxAnimParams
    minimize_size: c_int
    kmin: c_int
    kmax: c_int
    allow_mixed: c_int
    verbose: c_int
    padding: [4]u32
}

pub extern("c") fn WebPAnimEncoderOptionsInitInternal(enc_options: *WebPAnimEncoderOptions, version: c_int) -> c_int

pub fn WebPAnimEncoderOptionsInit(enc_options: *WebPAnimEncoderOptions) -> c_int {
    return WebPAnimEncoderOptionsInitInternal(enc_options, WEBP_MUX_ABI_VERSION)
}

pub extern("c") fn WebPAnimEncoderNewInternal(width: c_int, height: c_int, enc_options: *const WebPAnimEncoderOptions, version: c_int) -> *WebPAnimEncoder

pub fn WebPAnimEncoderNew(width: c_int, height: c_int, enc_options: *const WebPAnimEncoderOptions) -> *WebPAnimEncoder {
    return WebPAnimEncoderNewInternal(width, height, enc_options, WEBP_MUX_ABI_VERSION)
}

// The frame (NULL: the end of the last one) shown from TIMESTAMP_MS.
pub extern("c") fn WebPAnimEncoderAdd(enc: *WebPAnimEncoder, frame: *WebPPicture, timestamp_ms: c_int, config: *const WebPConfig) -> c_int
pub extern("c") fn WebPAnimEncoderAssemble(enc: *WebPAnimEncoder, webp_data: *WebPData) -> c_int
pub extern("c") fn WebPAnimEncoderGetError(enc: *WebPAnimEncoder) -> *const c_char
pub extern("c") fn WebPAnimEncoderDelete(enc: *WebPAnimEncoder) -> void
