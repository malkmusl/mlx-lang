// webp/decode.h: the simple decoders, WebPDecode with its configuration,
// and the incremental decoder, over std.webp.decode (dec/webp_dec.c,
// dec/buffer_dec.c and dec/idec_dec.c of libwebp 1.3.2). The structures
// the caller passes (WebPDecBuffer, WebPDecoderConfig,
// WebPBitstreamFeatures) are std.webp.io's, laid out alike.
const io = @import("std.webp.io")
const decode = @import("std.webp.decode")
const c = @import("./common.mlx")

const DECODER_ABI_VERSION: i32 = 0x0209

inline fn putInt(address: usize, value: i64) -> void {
    if address != 0 { io.putI32(address, value) }
}

inline fn putAddress(address: usize, value: usize) -> void {
    if address != 0 { io.put64(address, @intCast(u64, value)) }
}

export fn WebPGetDecoderVersion() -> i32 { return (1 << 16) | (3 << 8) | 2 }

export fn WebPGetInfo(data: usize, dataSize: usize, width: usize, height: usize) -> i32 {
    var features: io.Features = undefined
    if decode.getFeatures(data, dataSize, &features) != io.OK { return 0 }
    putInt(width, @intCast(i64, features.width))
    putInt(height, @intCast(i64, features.height))
    return 1
}

// Decode: DATA into memory of the library's in colour space MODE; the
// size into WIDTH and HEIGHT (as soon as it is known), the buffer into
// KEEP (0: not wanted).
fn decodeNew(mode: i32, data: usize, dataSize: usize, width: usize, height: usize, keep: *io.Buffer) -> usize {
    var output: io.Buffer = undefined
    io.zero(@intFromPtr(&output), @sizeOf(io.Buffer))
    var p: io.Params = undefined
    io.resetParams(&p, c.allocator())
    p.output = @intFromPtr(&output)
    output.colorspace = mode
    var features: io.Features = undefined
    if decode.getFeatures(data, dataSize, &features) != io.OK { return 0 }
    output.width = features.width
    output.height = features.height
    putInt(width, @intCast(i64, output.width))
    putInt(height, @intCast(i64, output.height))
    if decode.decodeInto(data, dataSize, &p) != io.OK { return 0 }
    keep.* = output
    if io.isRGBMode(mode) { return io.rgbaOf(&output) }
    return output.y
}

fn decodeSimple(mode: i32, data: usize, dataSize: usize, width: usize, height: usize) -> usize {
    var keep: io.Buffer = undefined
    return decodeNew(mode, data, dataSize, width, height, &keep)
}

export fn WebPDecodeRGBA(data: usize, dataSize: usize, width: usize, height: usize) -> usize { return decodeSimple(io.MODE_RGBA, data, dataSize, width, height) }
export fn WebPDecodeARGB(data: usize, dataSize: usize, width: usize, height: usize) -> usize { return decodeSimple(io.MODE_ARGB, data, dataSize, width, height) }
export fn WebPDecodeBGRA(data: usize, dataSize: usize, width: usize, height: usize) -> usize { return decodeSimple(io.MODE_BGRA, data, dataSize, width, height) }
export fn WebPDecodeRGB(data: usize, dataSize: usize, width: usize, height: usize) -> usize { return decodeSimple(io.MODE_RGB, data, dataSize, width, height) }
export fn WebPDecodeBGR(data: usize, dataSize: usize, width: usize, height: usize) -> usize { return decodeSimple(io.MODE_BGR, data, dataSize, width, height) }

export fn WebPDecodeYUV(data: usize, dataSize: usize, width: usize, height: usize, u: usize, v: usize, stride: usize, uvStride: usize) -> usize {
    if u == 0 || v == 0 || stride == 0 || uvStride == 0 { return 0 }
    var keep: io.Buffer = undefined
    const out = decodeNew(io.MODE_YUV, data, dataSize, width, height, &keep)
    if out != 0 {
        putAddress(u, keep.u)
        putAddress(v, keep.v)
        putInt(stride, @intCast(i64, keep.yStride))
        putInt(uvStride, @intCast(i64, keep.uStride))
    }
    return out
}

// DecodeIntoRGBABuffer: into the caller's memory.
fn decodeInto(mode: i32, data: usize, dataSize: usize, rgba: usize, size: usize, stride: i32) -> usize {
    if rgba == 0 { return 0 }
    var output: io.Buffer = undefined
    io.zero(@intFromPtr(&output), @sizeOf(io.Buffer))
    var p: io.Params = undefined
    io.resetParams(&p, c.allocator())
    p.output = @intFromPtr(&output)
    output.colorspace = mode
    io.setRgba(&output, rgba)
    io.setStride(&output, @intCast(i64, stride))
    io.setRgbaSize(&output, size)
    output.isExternalMemory = 1
    if decode.decodeInto(data, dataSize, &p) != io.OK { return 0 }
    return rgba
}

export fn WebPDecodeRGBAInto(data: usize, dataSize: usize, output: usize, size: usize, stride: i32) -> usize { return decodeInto(io.MODE_RGBA, data, dataSize, output, size, stride) }
export fn WebPDecodeARGBInto(data: usize, dataSize: usize, output: usize, size: usize, stride: i32) -> usize { return decodeInto(io.MODE_ARGB, data, dataSize, output, size, stride) }
export fn WebPDecodeBGRAInto(data: usize, dataSize: usize, output: usize, size: usize, stride: i32) -> usize { return decodeInto(io.MODE_BGRA, data, dataSize, output, size, stride) }
export fn WebPDecodeRGBInto(data: usize, dataSize: usize, output: usize, size: usize, stride: i32) -> usize { return decodeInto(io.MODE_RGB, data, dataSize, output, size, stride) }
export fn WebPDecodeBGRInto(data: usize, dataSize: usize, output: usize, size: usize, stride: i32) -> usize { return decodeInto(io.MODE_BGR, data, dataSize, output, size, stride) }

export fn WebPDecodeYUVInto(data: usize, dataSize: usize, luma: usize, lumaSize: usize, lumaStride: i32, u: usize, uSize: usize, uStride: i32, v: usize, vSize: usize, vStride: i32) -> usize {
    if luma == 0 { return 0 }
    var output: io.Buffer = undefined
    io.zero(@intFromPtr(&output), @sizeOf(io.Buffer))
    var p: io.Params = undefined
    io.resetParams(&p, c.allocator())
    p.output = @intFromPtr(&output)
    output.colorspace = io.MODE_YUV
    output.y = luma
    output.yStride = lumaStride
    output.ySize = lumaSize
    output.u = u
    output.uStride = uStride
    output.uSize = uSize
    output.v = v
    output.vStride = vStride
    output.vSize = vSize
    output.isExternalMemory = 1
    if decode.decodeInto(data, dataSize, &p) != io.OK { return 0 }
    return luma
}

export fn WebPInitDecBufferInternal(buffer: usize, version: i32) -> i32 {
    if c.incompatible(version, DECODER_ABI_VERSION) { return 0 }
    if buffer == 0 { return 0 }
    io.zero(buffer, @sizeOf(io.Buffer))
    return 1
}

export fn WebPFreeDecBuffer(buffer: usize) -> void {
    if buffer != 0 { io.freeDecBuffer(io.bufferAt(buffer), c.allocator()) }
}

export fn WebPGetFeaturesInternal(data: usize, dataSize: usize, features: usize, version: i32) -> i32 {
    if c.incompatible(version, DECODER_ABI_VERSION) { return io.INVALID_PARAM }
    if features == 0 { return io.INVALID_PARAM }
    return decode.getFeatures(data, dataSize, unsafe { @ptrFromInt(*io.Features, features) })
}

// WebPDecoderConfig: the features (40 bytes), the output (120), the
// options.
const CONFIG_OUTPUT: usize = 40
const CONFIG_OPTIONS: usize = 160
const CONFIG_SIZE: usize = 240

export fn WebPInitDecoderConfigInternal(config: usize, version: i32) -> i32 {
    if c.incompatible(version, DECODER_ABI_VERSION) { return 0 }
    if config == 0 { return 0 }
    io.zero(config, CONFIG_SIZE)
    return 1
}

export fn WebPDecode(data: usize, dataSize: usize, config: usize) -> i32 {
    if config == 0 { return io.INVALID_PARAM }
    return decode.decode(data, dataSize, unsafe { @ptrFromInt(*io.Features, config) }, config + CONFIG_OPTIONS, io.bufferAt(config + CONFIG_OUTPUT), c.allocator())
}

// ---------------------------------------------------------------------------
// The incremental decoder

export fn WebPINewDecoder(output: usize) -> usize { return decode.newDecoder(output, 0, c.allocator()) }

export fn WebPINewRGB(mode: i32, output: usize, size: usize, stride: i32) -> usize {
    var external: i32 = 0
    var givenSize = size
    var givenStride = stride
    if mode >= io.MODE_YUV { return 0 }
    if output != 0 { external = 1 }
    if external == 0 {
        givenSize = 0
        givenStride = 0
    } else if givenStride == 0 || givenSize == 0 {
        return 0
    }
    const address = decode.newDecoder(0, 0, c.allocator())
    if address == 0 { return 0 }
    const idec = decode.idecAt(address)
    idec.*.output.colorspace = mode
    idec.*.output.isExternalMemory = external
    io.setRgba(&idec.*.output, output)
    io.setStride(&idec.*.output, @intCast(i64, givenStride))
    io.setRgbaSize(&idec.*.output, givenSize)
    return address
}

export fn WebPINewYUVA(luma: usize, lumaSize: usize, lumaStride: i32, u: usize, uSize: usize, uStride: i32, v: usize, vSize: usize, vStride: i32, a: usize, aSize: usize, aStride: i32) -> usize {
    return newYuva(luma, lumaSize, lumaStride, u, uSize, uStride, v, vSize, vStride, a, aSize, aStride)
}

fn newYuva(luma: usize, lumaSize: usize, lumaStride: i32, u: usize, uSize: usize, uStride: i32, v: usize, vSize: usize, vStride: i32, a: usize, aSize: usize, aStride: i32) -> usize {
    var external: i32 = 0
    var mode = io.MODE_YUVA
    var sizes: [4]usize = [4]usize{ lumaSize, uSize, vSize, aSize }
    var strides: [4]i32 = [4]i32{ lumaStride, uStride, vStride, aStride }
    var planes: [4]usize = [4]usize{ luma, u, v, a }
    if luma != 0 { external = 1 }
    if external == 0 {
        var k: usize = 0
        while k < 4 {
            sizes[k] = 0
            strides[k] = 0
            if k > 0 { planes[k] = 0 }
            k += 1
        }
    } else {
        if u == 0 || v == 0 { return 0 }
        if lumaSize == 0 || uSize == 0 || vSize == 0 { return 0 }
        if lumaStride == 0 || uStride == 0 || vStride == 0 { return 0 }
        if a != 0 {
            if aSize == 0 || aStride == 0 { return 0 }
        }
        if a == 0 { mode = io.MODE_YUV }
    }
    const address = decode.newDecoder(0, 0, c.allocator())
    if address == 0 { return 0 }
    const idec = decode.idecAt(address)
    idec.*.output.colorspace = mode
    idec.*.output.isExternalMemory = external
    idec.*.output.y = planes[0]
    idec.*.output.yStride = strides[0]
    idec.*.output.ySize = sizes[0]
    idec.*.output.u = planes[1]
    idec.*.output.uStride = strides[1]
    idec.*.output.uSize = sizes[1]
    idec.*.output.v = planes[2]
    idec.*.output.vStride = strides[2]
    idec.*.output.vSize = sizes[2]
    idec.*.output.a = planes[3]
    idec.*.output.aStride = strides[3]
    idec.*.output.aSize = sizes[3]
    return address
}

export fn WebPINewYUV(luma: usize, lumaSize: usize, lumaStride: i32, u: usize, uSize: usize, uStride: i32, v: usize, vSize: usize, vStride: i32) -> usize {
    return newYuva(luma, lumaSize, lumaStride, u, uSize, uStride, v, vSize, vStride, 0, 0, 0)
}

export fn WebPIDecode(data: usize, dataSize: usize, config: usize) -> usize {
    var temporary: io.Features = undefined
    io.zero(@intFromPtr(&temporary), @sizeOf(io.Features))
    var features = @intFromPtr(&temporary)
    if config != 0 { features = config }
    if data != 0 && dataSize > 0 {
        if decode.getFeatures(data, dataSize, unsafe { @ptrFromInt(*io.Features, features) }) != io.OK { return 0 }
    }
    var output: usize = 0
    if config != 0 { output = config + CONFIG_OUTPUT }
    const address = decode.newDecoder(output, features, c.allocator())
    if address == 0 { return 0 }
    if config != 0 { decode.idecAt(address).*.params.options = config + CONFIG_OPTIONS }
    return address
}

export fn WebPIDelete(idec: usize) -> void { decode.deleteDecoder(idec) }

export fn WebPIAppend(idec: usize, data: usize, dataSize: usize) -> i32 {
    if idec == 0 { return io.INVALID_PARAM }
    return decode.append(decode.idecAt(idec), data, dataSize)
}

export fn WebPIUpdate(idec: usize, data: usize, dataSize: usize) -> i32 {
    if idec == 0 { return io.INVALID_PARAM }
    return decode.update(decode.idecAt(idec), data, dataSize)
}

fn outputOf(idec: usize) -> usize {
    if idec == 0 { return 0 }
    return decode.outputBuffer(decode.idecAt(idec))
}

export fn WebPIDecGetRGB(idec: usize, lastY: usize, width: usize, height: usize, stride: usize) -> usize {
    const source = outputOf(idec)
    if source == 0 { return 0 }
    const b = io.bufferAt(source)
    if b.*.colorspace >= io.MODE_YUV { return 0 }
    putInt(lastY, decode.idecAt(idec).*.params.lastY)
    putInt(width, @intCast(i64, b.*.width))
    putInt(height, @intCast(i64, b.*.height))
    putInt(stride, io.strideOf(b))
    return io.rgbaOf(b)
}

export fn WebPIDecGetYUVA(idec: usize, lastY: usize, u: usize, v: usize, a: usize, width: usize, height: usize, stride: usize, uvStride: usize, aStride: usize) -> usize {
    const source = outputOf(idec)
    if source == 0 { return 0 }
    const b = io.bufferAt(source)
    if b.*.colorspace < io.MODE_YUV { return 0 }
    putInt(lastY, decode.idecAt(idec).*.params.lastY)
    putAddress(u, b.*.u)
    putAddress(v, b.*.v)
    putAddress(a, b.*.a)
    putInt(width, @intCast(i64, b.*.width))
    putInt(height, @intCast(i64, b.*.height))
    putInt(stride, @intCast(i64, b.*.yStride))
    putInt(uvStride, @intCast(i64, b.*.uStride))
    putInt(aStride, @intCast(i64, b.*.aStride))
    return b.*.y
}

export fn WebPIDecodedArea(idec: usize, left: usize, top: usize, width: usize, height: usize) -> usize {
    const source = outputOf(idec)
    putInt(left, 0)
    putInt(top, 0)
    if source != 0 {
        putInt(width, @intCast(i64, io.bufferAt(source).*.width))
        putInt(height, decode.idecAt(idec).*.params.lastY)
    } else {
        putInt(width, 0)
        putInt(height, 0)
    }
    return source
}
