// libmlxwebp.so.7: libwebp's C API (libwebp 1.3.2: decode.h, demux.h,
// mux_types.h, declared by the modules of api/, whose C headers
// mlx-cheaders makes) over std.webp: the simple and advanced decoders,
// the incremental decoder, the demuxer and the animation decoder.
//
//     ./mlx build webp
//
// The parts: common.mlx (the memory, WebPMalloc and WebPFree),
// decoding.mlx (decode.h), demuxing.mlx (demux.h).
const common = @import("./common.mlx")
const decoding = @import("./decoding.mlx")
const demuxing = @import("./demuxing.mlx")
