// libmlxwebp.so.7: libwebp's C API (libwebp 1.3.2: decode.h, demux.h,
// encode.h, mux.h, mux_types.h, declared by the modules of api/, whose C
// headers mlx-cheaders makes) over std.webp: the simple and advanced
// decoders, the incremental decoder, the demuxer and the animation
// decoder; the encoder (lossless whatever the configuration says), the
// muxer and the animation encoder.
//
//     ./mlx build webp
//
// The parts: common.mlx (the memory, WebPMalloc and WebPFree),
// decoding.mlx (decode.h), demuxing.mlx (demux.h), encoding.mlx
// (encode.h), muxing.mlx (mux.h).
const common = @import("./common.mlx")
const decoding = @import("./decoding.mlx")
const demuxing = @import("./demuxing.mlx")
const encoding = @import("./encoding.mlx")
const muxing = @import("./muxing.mlx")
