// webp/mux.h over std.webp.mux: the muxer and the animation encoder. The
// muxer keeps copies of what it is given (copy_data or not); what it
// hands out to keep (WebPMuxAssemble's file, WebPMuxGetFrame's
// bitstream) is the C library's memory, freed by WebPDataClear.
const io = @import("std.webp.io")
const encode = @import("std.webp.encode")
const mux = @import("std.webp.mux")
const encoding = @import("./encoding.mlx")
const c = @import("./common.mlx")

const MUX_ABI_VERSION: i32 = 0x0108

inline fn tagAt(fourcc: usize) -> u64 { return io.get32(fourcc) }
inline fn dataBytes(data: usize) -> usize { return @intCast(usize, io.get64(data)) }
inline fn dataSize(data: usize) -> usize { return @intCast(usize, io.get64(data + 8)) }

fn setData(data: usize, bytes: usize, size: usize) -> void {
    io.put64(data, @intCast(u64, bytes))
    io.put64(data + 8, @intCast(u64, size))
}

export fn WebPGetMuxVersion() -> i32 { return (1 << 16) | (3 << 8) | 2 }

export fn WebPNewInternal(version: i32) -> usize {
    if c.incompatible(version, MUX_ABI_VERSION) { return 0 }
    return mux.create(c.allocator())
}

export fn WebPMuxDelete(m: usize) -> void { mux.delete(m) }

export fn WebPMuxCreateInternal(bitstream: usize, copyData: i32, version: i32) -> usize {
    if c.incompatible(version, MUX_ABI_VERSION) || bitstream == 0 { return 0 }
    return mux.createFrom(dataBytes(bitstream), dataSize(bitstream), c.allocator())
}

export fn WebPMuxSetChunk(m: usize, fourcc: usize, chunk: usize, copyData: i32) -> i32 {
    if m == 0 || fourcc == 0 || chunk == 0 || dataBytes(chunk) == 0 { return mux.INVALID_ARGUMENT }
    return mux.setChunk(mux.muxAt(m), tagAt(fourcc), dataBytes(chunk), dataSize(chunk))
}

export fn WebPMuxGetChunk(m: usize, fourcc: usize, chunk: usize) -> i32 {
    if m == 0 || fourcc == 0 || chunk == 0 { return mux.INVALID_ARGUMENT }
    var bytes: usize = 0
    var size: usize = 0
    const status = mux.getChunk(mux.muxAt(m), tagAt(fourcc), &bytes, &size)
    if status == mux.OK { setData(chunk, bytes, size) }
    return status
}

export fn WebPMuxDeleteChunk(m: usize, fourcc: usize) -> i32 {
    if m == 0 || fourcc == 0 { return mux.INVALID_ARGUMENT }
    return mux.deleteChunk(mux.muxAt(m), tagAt(fourcc))
}

export fn WebPMuxSetImage(m: usize, bitstream: usize, copyData: i32) -> i32 {
    if m == 0 || bitstream == 0 { return mux.INVALID_ARGUMENT }
    return mux.setImage(mux.muxAt(m), dataBytes(bitstream), dataSize(bitstream))
}

// WebPMuxFrameInfo is std.webp.mux's FrameInfo, laid out alike.
export fn WebPMuxPushFrame(m: usize, frame: usize, copyData: i32) -> i32 {
    if m == 0 || frame == 0 { return mux.INVALID_ARGUMENT }
    return mux.pushFrame(mux.muxAt(m), unsafe { @ptrFromInt(*mux.FrameInfo, frame) })
}

export fn WebPMuxGetFrame(m: usize, nth: u32, frame: usize) -> i32 {
    if m == 0 || frame == 0 { return mux.INVALID_ARGUMENT }
    return mux.getFrame(mux.muxAt(m), @intCast(u64, nth), unsafe { @ptrFromInt(*mux.FrameInfo, frame) })
}

export fn WebPMuxDeleteFrame(m: usize, nth: u32) -> i32 {
    if m == 0 { return mux.INVALID_ARGUMENT }
    return mux.deleteFrame(mux.muxAt(m), @intCast(u64, nth))
}

// WebPMuxAnimParams: the background colour, the loop count.
export fn WebPMuxSetAnimationParams(m: usize, params: usize) -> i32 {
    if m == 0 || params == 0 { return mux.INVALID_ARGUMENT }
    return mux.setAnimationParams(mux.muxAt(m), io.get32(params), io.getI32(params + 4))
}

export fn WebPMuxGetAnimationParams(m: usize, params: usize) -> i32 {
    if m == 0 || params == 0 { return mux.INVALID_ARGUMENT }
    const x = mux.muxAt(m)
    if !x.*.hasAnim { return mux.NOT_FOUND }
    io.put32(params, x.*.bgcolor)
    io.putI32(params + 4, x.*.loopCount)
    return mux.OK
}

export fn WebPMuxSetCanvasSize(m: usize, width: i32, height: i32) -> i32 {
    if m == 0 { return mux.INVALID_ARGUMENT }
    return mux.setCanvasSize(mux.muxAt(m), @intCast(i64, width), @intCast(i64, height))
}

export fn WebPMuxGetCanvasSize(m: usize, width: usize, height: usize) -> i32 {
    if m == 0 || width == 0 || height == 0 { return mux.INVALID_ARGUMENT }
    var w: i64 = 0
    var h: i64 = 0
    const status = mux.canvasSize(mux.muxAt(m), &w, &h)
    if status != mux.OK { return status }
    io.putI32(width, w)
    io.putI32(height, h)
    return mux.OK
}

export fn WebPMuxGetFeatures(m: usize, flags: usize) -> i32 {
    if m == 0 || flags == 0 { return mux.INVALID_ARGUMENT }
    if mux.muxAt(m).*.images == 0 { return mux.NOT_FOUND }
    io.put32(flags, mux.features(mux.muxAt(m)))
    return mux.OK
}

export fn WebPMuxNumChunks(m: usize, id: i32, count: usize) -> i32 {
    if m == 0 || count == 0 { return mux.INVALID_ARGUMENT }
    io.putI32(count, mux.numChunks(mux.muxAt(m), id))
    return mux.OK
}

export fn WebPMuxAssemble(m: usize, assembled: usize) -> i32 {
    if assembled == 0 { return mux.INVALID_ARGUMENT }
    setData(assembled, 0, 0)
    if m == 0 { return mux.INVALID_ARGUMENT }
    var out: encode.Bytes = undefined
    encode.initBytes(&out, c.allocator())
    const status = mux.assemble(mux.muxAt(m), &out)
    if status != mux.OK {
        encode.freeBytes(&out)
        return status
    }
    setData(assembled, out.data, out.size)
    return mux.OK
}

// ---------------------------------------------------------------------------
// The animation encoder

// WebPAnimEncoderOptions: the animation's parameters (background colour,
// loop count), minimize_size, kmin, kmax, allow_mixed, verbose, padding.
export fn WebPAnimEncoderOptionsInitInternal(options: usize, version: i32) -> i32 {
    if options == 0 || c.incompatible(version, MUX_ABI_VERSION) { return 0 }
    io.zero(options, 44)
    io.put32(options, 0xffffffff)
    io.putI32(options + 4, 0)
    io.putI32(options + 16, 2147483647)
    io.putI32(options + 12, 2147483646)
    return 1
}

export fn WebPAnimEncoderNewInternal(width: i32, height: i32, options: usize, version: i32) -> usize {
    if c.incompatible(version, MUX_ABI_VERSION) { return 0 }
    var bgcolor: u64 = 0xffffffff
    var loopCount: i64 = 0
    if options != 0 {
        bgcolor = io.get32(options)
        loopCount = io.getI32(options + 4)
    }
    return mux.createAnimEncoder(@intCast(i64, width), @intCast(i64, height), loopCount, bgcolor, c.allocator())
}

export fn WebPAnimEncoderAdd(enc: usize, frame: usize, timestamp: i32, config: usize) -> i32 {
    if enc == 0 { return 0 }
    const e = mux.animEncoderAt(enc)
    if frame == 0 {
        if mux.addFrame(e, 0, 0, @intCast(i64, timestamp)) { return 1 }
        return 0
    }
    const p = encoding.pictureAt(frame)
    if config != 0 && encoding.validateConfig(config) == 0 {
        p.*.errorCode = 4
        e.*.failure = io.literal("ERROR adding frame: invalid WebPConfig")
        return 0
    }
    if @intCast(i64, p.*.width) != e.*.width || @intCast(i64, p.*.height) != e.*.height {
        p.*.errorCode = 5
        e.*.failure = io.literal("ERROR adding frame: Invalid frame dimensions")
        return 0
    }
    var temporary: encoding.Picture = undefined
    var source = frame
    if p.*.argb == 0 {
        temporary = p.*
        temporary.memory = 0
        temporary.memoryArgb = 0
        if encoding.yuvaToArgb(@intFromPtr(&temporary)) == 0 {
            p.*.errorCode = 3
            return 0
        }
        source = @intFromPtr(&temporary)
    }
    const s = encoding.pictureAt(source)
    const ok = mux.addFrame(e, s.*.argb, @intCast(usize, s.*.argbStride), @intCast(i64, timestamp))
    if source != frame { encoding.pictureFree(source) }
    if ok { return 1 }
    return 0
}

export fn WebPAnimEncoderAssemble(enc: usize, data: usize) -> i32 {
    if enc == 0 || data == 0 { return 0 }
    setData(data, 0, 0)
    var out: encode.Bytes = undefined
    encode.initBytes(&out, c.allocator())
    if !mux.assembleAnimation(mux.animEncoderAt(enc), &out) {
        encode.freeBytes(&out)
        return 0
    }
    setData(data, out.data, out.size)
    return 1
}

export fn WebPAnimEncoderGetError(enc: usize) -> usize {
    if enc == 0 { return 0 }
    return mux.animEncoderAt(enc).*.failure
}

export fn WebPAnimEncoderDelete(enc: usize) -> void { mux.deleteAnimEncoder(enc) }
