// What the parts of mlx-libwebp share: the C library's memory, which
// std.webp's parts allocate from (so that what the API hands out, the
// pixels of WebPDecodeRGBA, WebPData's bytes, is freed by WebPFree as
// libwebp's is), and the ABI check of the *Internal functions.
const zs = @import("std.flate.stream")

pub const Allocator = zs.Allocator

pub extern("c") fn malloc(size: usize) -> usize
pub extern("c") fn free(address: usize) -> void

fn allocatorAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const address = malloc(if length == 0 { 1 } else { length })
    if address == 0 { return null }
    return zs.bytes(address)
}

fn allocatorResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> bool { return false }

fn allocatorRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> ?[*]u8 {
    const address = malloc(if newLength == 0 { 1 } else { newLength })
    if address == 0 { return null }
    zs.copy(address, @intFromPtr(memory), if length < newLength { length } else { newLength })
    free(@intFromPtr(memory))
    return zs.bytes(address)
}

fn allocatorFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    free(@intFromPtr(memory))
}

pub fn allocator() -> Allocator {
    unsafe {
        return Allocator.{
            .context = @ptrFromInt(*anyopaque, 16),
            .allocFn = allocatorAlloc,
            .resizeFn = allocatorResize,
            .remapFn = allocatorRemap,
            .freeFn = allocatorFree
        }
    }
}

// WEBP_ABI_IS_INCOMPATIBLE: a caller built for another major version.
pub fn incompatible(version: i32, ours: i32) -> bool {
    return (version >> 8) != (ours >> 8)
}

export fn WebPMalloc(size: usize) -> usize { return malloc(size) }

export fn WebPFree(address: usize) -> void { free(address) }
