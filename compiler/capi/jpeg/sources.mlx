// libjpeg's standard data sources (jdatasrc.c): a buffer in memory
// (jpeg_mem_src) and a stdio file (jpeg_stdio_src). Each puts an end of
// image marker after the data, with libjpeg's warning, when the data
// runs out (a file cut short is decoded as far as it goes).
const zs = @import("std.flate.stream")
const rec = @import("./records.mlx")
const c = @import("./common.mlx")

extern("c") fn fread(buffer: usize, size: usize, count: usize, file: usize) -> usize

const INPUT_BUFFER_SIZE: usize = 4096

// The stdio source: libjpeg's my_source_mgr.
const StdioSource = struct {
    base: rec.SourceMgr
    infile: usize
    buffer: usize
    startOfFile: i32
}

// The two bytes of the end of image put in place of missing data.
var fakeEnd: usize = 0

fn insertEnd(cinfo: usize) -> void {
    if fakeEnd == 0 {
        fakeEnd = c.malloc(2)
        c.put8(fakeEnd, 0xff)
        c.put8(fakeEnd + 1, 0xd9)
    }
    const src = rec.source(rec.decompress(cinfo).*.src)
    src.*.next_input_byte = fakeEnd
    src.*.bytes_in_buffer = 2
}

export fn mlxjpeg_init_mem_source(cinfo: usize) -> void {}

export fn mlxjpeg_fill_mem_input_buffer(cinfo: usize) -> i32 {
    c.warn(cinfo, c.JWRN_JPEG_EOF, 0, 0)
    insertEnd(cinfo)
    return 1
}

// skip_input_data: through fill_input_buffer when the buffer has too few.
export fn mlxjpeg_skip_input_data(cinfo: usize, count: i64) -> void {
    if count <= 0 { return }
    const src = rec.source(rec.decompress(cinfo).*.src)
    var left = @intCast(usize, count)
    while left > src.*.bytes_in_buffer {
        left -= src.*.bytes_in_buffer
        const call: c.FillFn = unsafe { @ptrFromInt(c.FillFn, src.*.fill_input_buffer) }
        _ = call(cinfo)
    }
    src.*.next_input_byte += left
    src.*.bytes_in_buffer -= left
}

export fn mlxjpeg_term_source(cinfo: usize) -> void {}

export fn mlxjpeg_resync_to_restart(cinfo: usize, desired: i32) -> i32 { return 1 }

export fn jpeg_mem_src(cinfo: usize, inbuffer: usize, insize: u64) -> void {
    if inbuffer == 0 || insize == 0 {
        c.raise0(cinfo, c.JERR_INPUT_EMPTY)
        return
    }
    const info = rec.decompress(cinfo)
    if info.*.src == 0 {
        info.*.src = c.allocSmall(cinfo, c.JPOOL_PERMANENT, @sizeOf(rec.SourceMgr))
    } else if rec.source(info.*.src).*.init_source != @intFromPtr(mlxjpeg_init_mem_source) {
        c.raise0(cinfo, c.JERR_BUFFER_SIZE)
        return
    }
    const src = rec.source(info.*.src)
    src.*.init_source = @intFromPtr(mlxjpeg_init_mem_source)
    src.*.fill_input_buffer = @intFromPtr(mlxjpeg_fill_mem_input_buffer)
    src.*.skip_input_data = @intFromPtr(mlxjpeg_skip_input_data)
    src.*.resync_to_restart = @intFromPtr(mlxjpeg_resync_to_restart)
    src.*.term_source = @intFromPtr(mlxjpeg_term_source)
    src.*.bytes_in_buffer = @intCast(usize, insize)
    src.*.next_input_byte = inbuffer
}

export fn mlxjpeg_init_stdio_source(cinfo: usize) -> void {
    const src: *StdioSource = unsafe { @ptrFromInt(*StdioSource, rec.decompress(cinfo).*.src) }
    src.*.startOfFile = 1
}

export fn mlxjpeg_fill_stdio_input_buffer(cinfo: usize) -> i32 {
    const src: *StdioSource = unsafe { @ptrFromInt(*StdioSource, rec.decompress(cinfo).*.src) }
    const count = fread(src.*.buffer, 1, INPUT_BUFFER_SIZE, src.*.infile)
    if count == 0 {
        if src.*.startOfFile != 0 {
            c.raise0(cinfo, c.JERR_INPUT_EMPTY)
            return 0
        }
        c.warn(cinfo, c.JWRN_JPEG_EOF, 0, 0)
        insertEnd(cinfo)
        return 1
    }
    src.*.base.next_input_byte = src.*.buffer
    src.*.base.bytes_in_buffer = count
    src.*.startOfFile = 0
    return 1
}

export fn jpeg_stdio_src(cinfo: usize, infile: usize) -> void {
    const info = rec.decompress(cinfo)
    if info.*.src == 0 {
        info.*.src = c.allocSmall(cinfo, c.JPOOL_PERMANENT, @sizeOf(StdioSource))
        const fresh: *StdioSource = unsafe { @ptrFromInt(*StdioSource, info.*.src) }
        fresh.*.buffer = c.allocSmall(cinfo, c.JPOOL_PERMANENT, INPUT_BUFFER_SIZE)
    } else if rec.source(info.*.src).*.init_source != @intFromPtr(mlxjpeg_init_stdio_source) {
        c.raise0(cinfo, c.JERR_BUFFER_SIZE)
        return
    }
    const src: *StdioSource = unsafe { @ptrFromInt(*StdioSource, info.*.src) }
    src.*.base.init_source = @intFromPtr(mlxjpeg_init_stdio_source)
    src.*.base.fill_input_buffer = @intFromPtr(mlxjpeg_fill_stdio_input_buffer)
    src.*.base.skip_input_data = @intFromPtr(mlxjpeg_skip_input_data)
    src.*.base.resync_to_restart = @intFromPtr(mlxjpeg_resync_to_restart)
    src.*.base.term_source = @intFromPtr(mlxjpeg_term_source)
    src.*.infile = infile
    src.*.base.bytes_in_buffer = 0
    src.*.base.next_input_byte = 0
}
