// The functions jpeglib.h declares for both kinds of object (jcomapi.c,
// jerror.c): the standard error manager, aborting and destroying, the
// tables libjpeg allocates.
const zs = @import("std.flate.stream")
const rec = @import("./records.mlx")
const c = @import("./common.mlx")
const decompress = @import("./decompress.mlx")

export fn jpeg_std_error(err: usize) -> usize { return c.stdError(err) }

export fn jpeg_abort(cinfo: usize) -> void {
    if rec.common(cinfo).*.is_decompressor != 0 {
        decompress.abortImage(cinfo)
    } else {
        c.abort(cinfo)
    }
}

export fn jpeg_destroy(cinfo: usize) -> void { c.destroy(cinfo) }

// A quantization table (JQUANT_TBL, 132 bytes) for the object's life.
export fn jpeg_alloc_quant_table(cinfo: usize) -> usize {
    const table = c.allocSmall(cinfo, c.JPOOL_PERMANENT, 132)
    if table != 0 {
        zs.zero(table, 132)
    }
    return table
}

// A Huffman table (JHUFF_TBL, 280 bytes) for the object's life.
export fn jpeg_alloc_huff_table(cinfo: usize) -> usize {
    const table = c.allocSmall(cinfo, c.JPOOL_PERMANENT, 280)
    if table != 0 {
        zs.zero(table, 280)
    }
    return table
}
