// libmlxjpeg.so.8: libjpeg's C API (the libjpeg 8 API of libjpeg-turbo
// 2.1.5, declared by the modules of api/, whose C headers mlx-cheaders
// makes) over std.jpeg: the decompressor (std.jpeg.read reads the file
// as libjpeg reads it, std.jpeg.output makes libjpeg's pixels), its data
// sources, setjmp-based errors through the error manager, and the
// compressor's objects.
//
//     ./mlx build jpeg
//
// The parts: records.mlx (the public structures' layout), common.mlx
// (the state, the memory manager, the error manager), messages.mlx
// (libjpeg's message texts), decompress.mlx (jpeg_read_header ...
// jpeg_finish_decompress), sources.mlx (jpeg_mem_src, jpeg_stdio_src),
// compress.mlx (the compressor), exports.mlx (the rest of jpeglib.h).
const common = @import("./common.mlx")
const decompress = @import("./decompress.mlx")
const sources = @import("./sources.mlx")
const compress = @import("./compress.mlx")
const exports = @import("./exports.mlx")
