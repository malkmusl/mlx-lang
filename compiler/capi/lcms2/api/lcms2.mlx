// Tone curves: a segment of a parametric or sampled function.
pub const cmsCurveSegment = struct {
    x0: cmsFloat32Number
    x1: cmsFloat32Number
    Type: cmsInt32Number
    Params: [10]cmsFloat64Number
    nGridPoints: cmsUInt32Number
    SampledPoints: *cmsFloat32Number
}

