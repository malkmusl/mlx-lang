// Rendering intents and the transforms' flags.
pub const INTENT_PERCEPTUAL: c_int = 0
pub const INTENT_RELATIVE_COLORIMETRIC: c_int = 1
pub const INTENT_SATURATION: c_int = 2
pub const INTENT_ABSOLUTE_COLORIMETRIC: c_int = 3
pub const INTENT_PRESERVE_K_ONLY_PERCEPTUAL: c_int = 10
pub const INTENT_PRESERVE_K_ONLY_RELATIVE_COLORIMETRIC: c_int = 11
pub const INTENT_PRESERVE_K_ONLY_SATURATION: c_int = 12
pub const INTENT_PRESERVE_K_PLANE_PERCEPTUAL: c_int = 13
pub const INTENT_PRESERVE_K_PLANE_RELATIVE_COLORIMETRIC: c_int = 14
pub const INTENT_PRESERVE_K_PLANE_SATURATION: c_int = 15

pub const cmsFLAGS_NOCACHE: c_int = 0x0040
pub const cmsFLAGS_NOOPTIMIZE: c_int = 0x0100
pub const cmsFLAGS_NULLTRANSFORM: c_int = 0x0200
pub const cmsFLAGS_GAMUTCHECK: c_int = 0x1000
pub const cmsFLAGS_SOFTPROOFING: c_int = 0x4000
pub const cmsFLAGS_BLACKPOINTCOMPENSATION: c_int = 0x2000
pub const cmsFLAGS_NOWHITEONWHITEFIXUP: c_int = 0x0004
pub const cmsFLAGS_HIGHRESPRECALC: c_int = 0x0400
pub const cmsFLAGS_LOWRESPRECALC: c_int = 0x0800
pub const cmsFLAGS_8BITS_DEVICELINK: c_int = 0x0008
pub const cmsFLAGS_GUESSDEVICECLASS: c_int = 0x0020
pub const cmsFLAGS_KEEP_SEQUENCE: c_int = 0x0080
pub const cmsFLAGS_FORCE_CLUT: c_int = 0x0002
pub const cmsFLAGS_CLUT_POST_LINEARIZATION: c_int = 0x0001
pub const cmsFLAGS_CLUT_PRE_LINEARIZATION: c_int = 0x0010
pub const cmsFLAGS_NONEGATIVES: c_int = 0x8000
pub const cmsFLAGS_COPY_ALPHA: c_int = 0x04000000
pub inline fn cmsFLAGS_GRIDPOINTS(n: anytype) -> cmsUInt32Number { return (n & 0xFF) << 16 }
pub const cmsFLAGS_NODEFAULTRESOURCEDEF: c_int = 0x01000000

pub const LCMS_USED_AS_INPUT: c_int = 0
pub const LCMS_USED_AS_OUTPUT: c_int = 1
