// lcms2.h
// mlx-lcms2: Little CMS's C API (2.14, LCMS_VERSION 2140), implemented
// in Mlx by libmlxlcms2.so (compiler/capi/lcms2, over std.colorprofile):
// ICC profiles opened from memory or files and built in memory (sRGB,
// RGB of primaries and tone curves, grey, XYZ), their header and tags,
// tone curves (parametric, tabulated, segmented; evaluated, reversed,
// estimated), and colour transforms of 8- and 16-bit pixels for the four
// ICC intents, whose pixels are those Little CMS gives. WebKit's image
// decoders (PNGImageDecoder, JPEGImageDecoder) transform their rows from
// an embedded profile to sRGB with them.
//
// Not supported: black point compensation, floating-point pixel
// formats, the float tags (D2Bn), named colours, CMYK lookup tables (4
// and more inputs), gamut checks and proofing, writing profiles, plug-ins.
// Such transforms are not made (cmsCreateTransform answers NULL).
const c_system_headers = "stdio.h limits.h time.h stddef.h"
const c_macros = "#define CMSEXPORT\n#define CMSAPI\n#define CMSREGISTER"

// (Mlx names of C types: C has them as they are.)
pub const c_char = u8
pub const c_int = i32
pub const c_tokens = usize

pub const _lcms2_H: c_tokens = ""
pub const LCMS_VERSION: c_int = 2140

pub const cmsUInt8Number = u8
pub const cmsInt8Number = i8
pub const cmsUInt16Number = u16
pub const cmsInt16Number = i16
pub const cmsUInt32Number = u32
pub const cmsInt32Number = i32
pub const cmsUInt64Number = u64
pub const cmsInt64Number = i64
pub const cmsFloat32Number = f32
pub const cmsFloat64Number = f64
pub const cmsSignature = cmsUInt32Number
pub const cmsU8Fixed8Number = cmsUInt16Number
pub const cmsS15Fixed16Number = cmsInt32Number
pub const cmsU16Fixed16Number = cmsUInt32Number
pub const cmsBool = c_int

pub const cmsMAX_PATH: c_int = 256
pub const cmsMAXCHANNELS: c_int = 16
pub const cmsD50X: c_tokens = "0.9642"
pub const cmsD50Y: c_tokens = "1.0"
pub const cmsD50Z: c_tokens = "0.8249"
