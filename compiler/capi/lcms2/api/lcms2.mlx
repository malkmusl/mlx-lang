pub const cmsToneCurve = _cms_curve_struct
pub const _cmsPipeline_struct = struct {}
pub const cmsPipeline = _cmsPipeline_struct
pub const _cmsStage_struct = struct {}
pub const cmsStage = _cmsStage_struct

// Pixel formats: the fields of a format word, and the words.
pub fn PREMUL_SH(m: anytype) -> cmsUInt32Number { return m << 23 }
pub fn FLOAT_SH(a: anytype) -> cmsUInt32Number { return a << 22 }
pub fn OPTIMIZED_SH(s: anytype) -> cmsUInt32Number { return s << 21 }
pub fn COLORSPACE_SH(s: anytype) -> cmsUInt32Number { return s << 16 }
pub fn SWAPFIRST_SH(s: anytype) -> cmsUInt32Number { return s << 14 }
pub fn FLAVOR_SH(s: anytype) -> cmsUInt32Number { return s << 13 }
pub fn PLANAR_SH(p: anytype) -> cmsUInt32Number { return p << 12 }
pub fn ENDIAN16_SH(e: anytype) -> cmsUInt32Number { return e << 11 }
pub fn DOSWAP_SH(e: anytype) -> cmsUInt32Number { return e << 10 }
pub fn EXTRA_SH(e: anytype) -> cmsUInt32Number { return e << 7 }
pub fn CHANNELS_SH(c: anytype) -> cmsUInt32Number { return c << 3 }
pub fn BYTES_SH(b: anytype) -> cmsUInt32Number { return b }

pub fn T_PREMUL(m: anytype) -> cmsUInt32Number { return (m >> 23) & 1 }
pub fn T_FLOAT(a: anytype) -> cmsUInt32Number { return (a >> 22) & 1 }
pub fn T_OPTIMIZED(o: anytype) -> cmsUInt32Number { return (o >> 21) & 1 }
pub fn T_COLORSPACE(s: anytype) -> cmsUInt32Number { return (s >> 16) & 31 }
pub fn T_SWAPFIRST(s: anytype) -> cmsUInt32Number { return (s >> 14) & 1 }
pub fn T_FLAVOR(s: anytype) -> cmsUInt32Number { return (s >> 13) & 1 }
pub fn T_PLANAR(p: anytype) -> cmsUInt32Number { return (p >> 12) & 1 }
pub fn T_ENDIAN16(e: anytype) -> cmsUInt32Number { return (e >> 11) & 1 }
pub fn T_DOSWAP(e: anytype) -> cmsUInt32Number { return (e >> 10) & 1 }
pub fn T_EXTRA(e: anytype) -> cmsUInt32Number { return (e >> 7) & 7 }
pub fn T_CHANNELS(c: anytype) -> cmsUInt32Number { return (c >> 3) & 15 }
pub fn T_BYTES(b: anytype) -> cmsUInt32Number { return b & 7 }

