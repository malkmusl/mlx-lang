// The version of the library (2140) and the error handler.
pub extern("c") fn cmsGetEncodedCMMversion() -> c_int
pub extern("c") fn cmsSetLogErrorHandler(Fn: ?cmsLogErrorHandlerFunction) -> void
pub extern("c") fn cmsSetLogErrorHandlerTHR(ContextID: cmsContext, Fn: ?cmsLogErrorHandlerFunction) -> void
// Contexts are not kept apart: every context is the global one.
pub extern("c") fn cmsCreateContext(Plugin: *anyopaque, UserData: *anyopaque) -> cmsContext
pub extern("c") fn cmsDeleteContext(ContextID: cmsContext) -> void
pub extern("c") fn cmsGetContextUserData(ContextID: cmsContext) -> *anyopaque
// The adaptation state of absolute colorimetry: 1 (the default) and 0
// are supported; the previous state is returned.
pub extern("c") fn cmsSetAdaptationState(d: cmsFloat64Number) -> cmsFloat64Number

