// The object infos for C: pw_core_info_*, pw_node_info_*, pw_port_info_*,
// pw_device_info_*, pw_client_info_*, pw_link_info_*, pw_factory_info_*,
// pw_module_info_* (infos.mlx).
const infos = @import("./infos.mlx")

export fn pw_core_info_merge(info: usize, update: usize, reset: u8) -> usize { return infos.mergeCore(info, update, reset != 0) }
export fn pw_core_info_update(info: usize, update: usize) -> usize { return infos.mergeCore(info, update, true) }
export fn pw_core_info_free(info: usize) -> void { infos.freeCore(info) }

export fn pw_node_info_merge(info: usize, update: usize, reset: u8) -> usize { return infos.mergeNode(info, update, reset != 0) }
export fn pw_node_info_update(info: usize, update: usize) -> usize { return infos.mergeNode(info, update, true) }
export fn pw_node_info_free(info: usize) -> void { infos.freeNode(info) }

export fn pw_port_info_merge(info: usize, update: usize, reset: u8) -> usize { return infos.mergePort(info, update, reset != 0) }
export fn pw_port_info_update(info: usize, update: usize) -> usize { return infos.mergePort(info, update, true) }
export fn pw_port_info_free(info: usize) -> void { infos.freePort(info) }

export fn pw_device_info_merge(info: usize, update: usize, reset: u8) -> usize { return infos.mergeDevice(info, update, reset != 0) }
export fn pw_device_info_update(info: usize, update: usize) -> usize { return infos.mergeDevice(info, update, true) }
export fn pw_device_info_free(info: usize) -> void { infos.freeDevice(info) }

export fn pw_client_info_merge(info: usize, update: usize, reset: u8) -> usize { return infos.mergeClient(info, update, reset != 0) }
export fn pw_client_info_update(info: usize, update: usize) -> usize { return infos.mergeClient(info, update, true) }
export fn pw_client_info_free(info: usize) -> void { infos.freeClient(info) }

export fn pw_link_info_merge(info: usize, update: usize, reset: u8) -> usize { return infos.mergeLink(info, update, reset != 0) }
export fn pw_link_info_update(info: usize, update: usize) -> usize { return infos.mergeLink(info, update, true) }
export fn pw_link_info_free(info: usize) -> void { infos.freeLink(info) }

export fn pw_factory_info_merge(info: usize, update: usize, reset: u8) -> usize { return infos.mergeFactory(info, update, reset != 0) }
export fn pw_factory_info_update(info: usize, update: usize) -> usize { return infos.mergeFactory(info, update, true) }
export fn pw_factory_info_free(info: usize) -> void { infos.freeFactory(info) }

export fn pw_module_info_merge(info: usize, update: usize, reset: u8) -> usize { return infos.mergeModule(info, update, reset != 0) }
export fn pw_module_info_update(info: usize, update: usize) -> usize { return infos.mergeModule(info, update, true) }
export fn pw_module_info_free(info: usize) -> void { infos.freeModule(info) }
