// libmlxpng16.so: libpng's C API (1.6.43, declared by the modules of
// api/, whose C headers mlx-cheaders makes) over std.png: the reader
// (std.png.read reads the file as libpng does; std.png.rows has the
// filters and libpng's row transformations), the progressive reader's
// callbacks, the info getters and setters, setjmp-based errors, and the
// writer.
//
//     ./mlx build png
//
// The parts: common.mlx (the structures, memory, errors), reader.mlx
// (creating, png_process_data, the transformations, the rows), info.mlx
// (png_get_* and png_set_* of the info), writer.mlx (the writer),
// exports.mlx (the functions png.h declares).
const common = @import("./common.mlx")
const reader = @import("./reader.mlx")
const info = @import("./info.mlx")
const writer = @import("./writer.mlx")
const exports = @import("./exports.mlx")
