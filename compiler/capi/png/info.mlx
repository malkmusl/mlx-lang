// The info getters and setters of libpng (pngget.c, pngset.c) over what
// std.png's reader read (a reader's info is the file's) or what the
// application set (a writer's), with libpng's answers: the header as
// png_read_update_info made it, pointers into the info for the palette,
// transparency and profile, the colour space's gamma and chromaticities.
const c = @import("./common.mlx")
const read = @import("std.png.read")
const rows = @import("std.png.rows")

const Png = c.Png
const PngInfo = c.PngInfo

// The file's information an info stands for: a reader's own, a writer's
// in the info.
pub fn dataOf(png: *Png, info: *PngInfo) -> *read.Info {
    if png.*.magic == c.READ_MAGIC { return &png.*.file }
    return &info.*.data
}

pub fn usable(pngAddress: usize, infoAddress: usize) -> bool {
    return c.isAny(pngAddress) && infoAddress != 0 && c.infoOf(infoAddress).*.magic == c.INFO_MAGIC
}

pub fn colorType(png: *Png, info: *PngInfo) -> usize {
    if info.*.updated { return info.*.colorType }
    return dataOf(png, info).*.colorType
}

pub fn bitDepth(png: *Png, info: *PngInfo) -> usize {
    if info.*.updated { return info.*.bitDepth }
    return dataOf(png, info).*.bitDepth
}

pub fn channels(png: *Png, info: *PngInfo) -> usize {
    if info.*.updated { return info.*.channels }
    return dataOf(png, info).*.channels
}

pub fn rowBytes(png: *Png, info: *PngInfo) -> usize {
    if info.*.updated { return info.*.rowBytes }
    return dataOf(png, info).*.rowBytes
}

pub fn numTrans(png: *Png, info: *PngInfo) -> usize {
    if info.*.updated { return info.*.numTrans }
    return dataOf(png, info).*.numTrans
}

// png_get_valid (a tRNS the PLTE cancelled is not valid).
pub fn valid(png: *Png, info: *PngInfo, flag: usize) -> usize {
    const data = dataOf(png, info)
    if flag == read.INFO_tRNS {
        const count = if png.*.flags & c.F_ROW_INIT != 0 { png.*.numTrans } else { data.*.numTrans }
        if count == 0 { return 0 }
    }
    return data.*.valid & flag
}

pub fn getIHDR(png: *Png, info: *PngInfo, width: usize, height: usize, depth: usize, color: usize, interlace: usize, compression: usize, filter: usize) -> usize {
    const data = dataOf(png, info)
    if width != 0 { c.put32(width, data.*.width) }
    if height != 0 { c.put32(height, data.*.height) }
    if depth != 0 { c.put32(depth, bitDepth(png, info)) }
    if color != 0 { c.put32(color, colorType(png, info)) }
    if compression != 0 { c.put32(compression, data.*.compression) }
    if filter != 0 { c.put32(filter, data.*.filter) }
    if interlace != 0 { c.put32(interlace, data.*.interlace) }
    return 1
}

pub fn getPLTE(png: *Png, info: *PngInfo, palette: usize, count: usize) -> usize {
    const data = dataOf(png, info)
    if data.*.valid & read.INFO_PLTE == 0 || palette == 0 { return 0 }
    c.putWord(palette, @intFromPtr(&data.*.palette))
    if count != 0 { c.put32(count, data.*.numPalette) }
    return read.INFO_PLTE
}

// A png_color_16 at ADDRESS.
fn putColor16(address: usize, index: usize, red: usize, green: usize, blue: usize, gray: usize) -> void {
    c.put8(address, index)
    c.put8(address + 1, 0)
    c.put16(address + 2, red)
    c.put16(address + 4, green)
    c.put16(address + 6, blue)
    c.put16(address + 8, gray)
}

pub fn getTRNS(png: *Png, info: *PngInfo, alpha: usize, count: usize, color: usize) -> usize {
    const data = dataOf(png, info)
    if data.*.valid & read.INFO_tRNS == 0 { return 0 }
    var result: usize = 0
    const view = @intFromPtr(&info.*.transColor)
    putColor16(view, 0, data.*.transRed, data.*.transGreen, data.*.transBlue, data.*.transGray)
    if colorType(png, info) == 3 {
        if alpha != 0 {
            c.putWord(alpha, @intFromPtr(&data.*.transAlpha))
            result |= read.INFO_tRNS
        }
        if color != 0 { c.putWord(color, view) }
    } else {
        if color != 0 {
            c.putWord(color, view)
            result |= read.INFO_tRNS
        }
        if alpha != 0 { c.putWord(alpha, 0) }
    }
    if count != 0 {
        c.put32(count, numTrans(png, info))
        result |= read.INFO_tRNS
    }
    return result
}

pub fn getSBIT(png: *Png, info: *PngInfo, sigBit: usize) -> usize {
    const data = dataOf(png, info)
    if data.*.valid & read.INFO_sBIT == 0 || sigBit == 0 { return 0 }
    c.putWord(sigBit, @intFromPtr(&data.*.sigBit))
    return read.INFO_sBIT
}

pub fn getBKGD(png: *Png, info: *PngInfo, background: usize) -> usize {
    const data = dataOf(png, info)
    if data.*.valid & read.INFO_bKGD == 0 || background == 0 { return 0 }
    const view = @intFromPtr(&info.*.background)
    putColor16(view, data.*.background[0], data.*.background[1], data.*.background[2], data.*.background[3], data.*.background[4])
    c.putWord(background, view)
    return read.INFO_bKGD
}

pub fn getGamma(png: *Png, info: *PngInfo) -> i64 {
    const data = dataOf(png, info)
    if data.*.colorspace & read.CS_HAVE_GAMMA == 0 { return 0 }
    return data.*.gamma
}

pub fn getCHRM(png: *Png, info: *PngInfo, values: usize, doubles: bool) -> usize {
    const data = dataOf(png, info)
    if data.*.colorspace & read.CS_HAVE_ENDPOINTS == 0 { return 0 }
    var index: usize = 0
    while index < 8 {
        const target = c.getWord(values + index * 8)
        if target != 0 {
            if doubles { c.putDouble(target, @floatFromInt(f64, data.*.endpoints[index]) * 0.00001) } else { c.putI32(target, data.*.endpoints[index]) }
        }
        index += 1
    }
    return read.INFO_cHRM
}

pub fn getSRGB(png: *Png, info: *PngInfo, intent: usize) -> usize {
    const data = dataOf(png, info)
    if data.*.valid & read.INFO_sRGB == 0 || intent == 0 { return 0 }
    c.put32(intent, data.*.intent)
    return read.INFO_sRGB
}

pub fn getICCP(png: *Png, info: *PngInfo, name: usize, compression: usize, profile: usize, length: usize) -> usize {
    const data = dataOf(png, info)
    if data.*.valid & read.INFO_iCCP == 0 || name == 0 || profile == 0 || length == 0 { return 0 }
    c.putWord(name, @intFromPtr(&data.*.iccpName))
    c.putWord(profile, data.*.iccpProfile)
    c.put32(length, read.read32(data.*.iccpProfile))
    if compression != 0 { c.put32(compression, 0) }
    return read.INFO_iCCP
}

pub fn getPHYS(png: *Png, info: *PngInfo, x: usize, y: usize, unit: usize) -> usize {
    const data = dataOf(png, info)
    if data.*.valid & read.INFO_pHYs == 0 { return 0 }
    var result: usize = 0
    if x != 0 {
        c.put32(x, data.*.xPixelsPerUnit)
        result |= read.INFO_pHYs
    }
    if y != 0 {
        c.put32(y, data.*.yPixelsPerUnit)
        result |= read.INFO_pHYs
    }
    if unit != 0 {
        c.put32(unit, data.*.physUnit)
        result |= read.INFO_pHYs
    }
    return result
}

pub fn pixelsPerMeter(png: *Png, info: *PngInfo, vertical: bool) -> usize {
    const data = dataOf(png, info)
    if data.*.valid & read.INFO_pHYs == 0 || data.*.physUnit != 1 { return 0 }
    return if vertical { data.*.yPixelsPerUnit } else { data.*.xPixelsPerUnit }
}

// ---------------------------------------------------------------------------
// Setters

// png_check_IHDR's checks, each a warning, then png_error.
fn checkIHDR(png: *Png, width: usize, height: usize, depth: usize, color: usize, interlace: usize, compression: usize, filter: usize) -> void {
    var bad = false
    if width == 0 {
        c.pngWarning(png, c.literal("Image width is zero in IHDR"))
        bad = true
    }
    if width > 0x7fffffff {
        c.pngWarning(png, c.literal("Invalid image width in IHDR"))
        bad = true
    }
    if width > png.*.userWidthMax {
        c.pngWarning(png, c.literal("Image width exceeds user limit in IHDR"))
        bad = true
    }
    if height == 0 {
        c.pngWarning(png, c.literal("Image height is zero in IHDR"))
        bad = true
    }
    if height > 0x7fffffff {
        c.pngWarning(png, c.literal("Invalid image height in IHDR"))
        bad = true
    }
    if height > png.*.userHeightMax {
        c.pngWarning(png, c.literal("Image height exceeds user limit in IHDR"))
        bad = true
    }
    if depth != 1 && depth != 2 && depth != 4 && depth != 8 && depth != 16 {
        c.pngWarning(png, c.literal("Invalid bit depth in IHDR"))
        bad = true
    }
    if color == 1 || color == 5 || color > 6 {
        c.pngWarning(png, c.literal("Invalid color type in IHDR"))
        bad = true
    }
    if (color == 3 && depth > 8) || ((color == 2 || color == 4 || color == 6) && depth < 8) {
        c.pngWarning(png, c.literal("Invalid color type/bit depth combination in IHDR"))
        bad = true
    }
    if interlace >= 2 {
        c.pngWarning(png, c.literal("Unknown interlace method in IHDR"))
        bad = true
    }
    if compression != 0 {
        c.pngWarning(png, c.literal("Unknown compression method in IHDR"))
        bad = true
    }
    if filter != 0 {
        c.pngWarning(png, c.literal("Unknown filter method in IHDR"))
        bad = true
    }
    if bad { c.pngError(png, c.literal("Invalid IHDR data")) }
}

pub fn setIHDR(png: *Png, info: *PngInfo, width: usize, height: usize, depth: usize, color: usize, interlace: usize, compression: usize, filter: usize) -> void {
    const data = dataOf(png, info)
    checkIHDR(png, width, height, depth, color, interlace, compression, filter)
    data.*.width = width
    data.*.height = height
    data.*.bitDepth = depth
    data.*.colorType = color
    data.*.interlace = interlace
    data.*.compression = compression
    data.*.filter = filter
    data.*.channels = read.channelsOf(color)
    data.*.pixelDepth = data.*.channels * depth
    data.*.rowBytes = rows.rowBytes(data.*.pixelDepth, width)
}

pub fn setPLTE(png: *Png, info: *PngInfo, palette: usize, count: i64) -> void {
    const data = dataOf(png, info)
    var most: i64 = 256
    if data.*.colorType == 3 { most = @intCast(i64, @intCast(usize, 1) << data.*.bitDepth) }
    if count < 0 || count > most {
        if data.*.colorType == 3 { c.pngError(png, c.literal("Invalid palette length")) }
        c.pngWarning(png, c.literal("Invalid palette length"))
        return
    }
    if (count > 0 && palette == 0) || count == 0 { c.pngError(png, c.literal("Invalid palette")) }
    c.zero(@intFromPtr(&data.*.palette), 768)
    c.copy(@intFromPtr(&data.*.palette), palette, @intCast(usize, count) * 3)
    data.*.numPalette = @intCast(usize, count)
    data.*.valid |= read.INFO_PLTE
}

pub fn setTRNS(png: *Png, info: *PngInfo, alpha: usize, count: i64, color: usize) -> void {
    const data = dataOf(png, info)
    if alpha != 0 && count > 0 {
        var index: usize = 0
        while index < 256 {
            data.*.transAlpha[index] = if index < @intCast(usize, count) { @intCast(u8, c.get8(alpha + index)) } else { 255 }
            index += 1
        }
    }
    if color != 0 {
        data.*.transRed = @intCast(usize, unsafe { @ptrFromInt(*u16, color + 2).* })
        data.*.transGreen = @intCast(usize, unsafe { @ptrFromInt(*u16, color + 4).* })
        data.*.transBlue = @intCast(usize, unsafe { @ptrFromInt(*u16, color + 6).* })
        data.*.transGray = @intCast(usize, unsafe { @ptrFromInt(*u16, color + 8).* })
        if data.*.bitDepth < 16 {
            const most = (@intCast(usize, 1) << data.*.bitDepth) - 1
            if (data.*.colorType == 0 && data.*.transGray > most) || (data.*.colorType == 2 && (data.*.transRed > most || data.*.transGreen > most || data.*.transBlue > most)) {
                c.pngWarning(png, c.literal("tRNS chunk has out-of-range samples for bit_depth"))
            }
        }
        if count < 1 {
            data.*.numTrans = 1
        } else {
            data.*.numTrans = @intCast(usize, count)
        }
    } else {
        data.*.numTrans = if count < 0 { 0 } else { @intCast(usize, count) }
    }
    if data.*.numTrans != 0 { data.*.valid |= read.INFO_tRNS }
    if png.*.magic == c.READ_MAGIC { png.*.numTrans = data.*.numTrans }
}

pub fn setSBIT(png: *Png, info: *PngInfo, sigBit: usize) -> void {
    const data = dataOf(png, info)
    var index: usize = 0
    while index < 5 {
        data.*.sigBit[index] = @intCast(u8, c.get8(sigBit + index))
        index += 1
    }
    data.*.valid |= read.INFO_sBIT
}

pub fn setBKGD(png: *Png, info: *PngInfo, background: usize) -> void {
    const data = dataOf(png, info)
    data.*.background[0] = c.get8(background)
    data.*.background[1] = @intCast(usize, unsafe { @ptrFromInt(*u16, background + 2).* })
    data.*.background[2] = @intCast(usize, unsafe { @ptrFromInt(*u16, background + 4).* })
    data.*.background[3] = @intCast(usize, unsafe { @ptrFromInt(*u16, background + 6).* })
    data.*.background[4] = @intCast(usize, unsafe { @ptrFromInt(*u16, background + 8).* })
    data.*.valid |= read.INFO_bKGD
}

fn syncColorspace(data: *read.Info) -> void {
    if data.*.colorspace & read.CS_INVALID != 0 {
        data.*.valid &= ~(read.INFO_gAMA | read.INFO_cHRM | read.INFO_sRGB | read.INFO_iCCP)
        return
    }
    if data.*.colorspace & read.CS_MATCHES_sRGB != 0 { data.*.valid |= read.INFO_sRGB } else { data.*.valid &= ~read.INFO_sRGB }
    if data.*.colorspace & read.CS_HAVE_ENDPOINTS != 0 { data.*.valid |= read.INFO_cHRM } else { data.*.valid &= ~read.INFO_cHRM }
    if data.*.colorspace & read.CS_HAVE_GAMMA != 0 { data.*.valid |= read.INFO_gAMA } else { data.*.valid &= ~read.INFO_gAMA }
}

// png_set_gAMA_fixed: png_colorspace_set_gamma on the info.
pub fn setGamma(png: *Png, info: *PngInfo, value: i64) -> void {
    const data = dataOf(png, info)
    if value < 16 || value > 625000000 {
        data.*.colorspace |= read.CS_INVALID
        c.pngWarning(png, c.literal("gamma value out of range"))
    } else if png.*.magic == c.READ_MAGIC && data.*.colorspace & read.CS_FROM_gAMA != 0 {
        data.*.colorspace |= read.CS_INVALID
        c.pngWarning(png, c.literal("duplicate"))
    } else if data.*.colorspace & read.CS_INVALID == 0 {
        var ok = true
        if data.*.colorspace & read.CS_HAVE_GAMMA != 0 {
            var ratio: i64 = 0
            if !read.mulDiv(data.*.gamma, read.FP_1, value, &ratio) || read.gammaSignificant(ratio) {
                if data.*.colorspace & read.CS_FROM_sRGB != 0 {
                    c.benignError(png, c.literal("gamma value does not match sRGB"))
                    ok = false
                } else {
                    c.pngWarning(png, c.literal("gamma value does not match libpng estimate"))
                }
            }
        }
        if ok {
            data.*.gamma = value
            data.*.colorspace |= read.CS_HAVE_GAMMA | read.CS_FROM_gAMA
        }
    }
    syncColorspace(data)
}

pub fn setSRGB(png: *Png, info: *PngInfo, intent: usize, withGammaAndChromaticities: bool) -> void {
    const data = dataOf(png, info)
    if intent >= 4 {
        data.*.colorspace |= read.CS_INVALID
        c.benignError(png, c.literal("profile 'sRGB': invalid sRGB rendering intent"))
        syncColorspace(data)
        return
    }
    data.*.intent = intent
    const standard = [8]i64{ 31270, 32900, 64000, 33000, 30000, 60000, 15000, 6000 }
    var index: usize = 0
    while index < 8 {
        data.*.endpoints[index] = standard[index]
        index += 1
    }
    data.*.gamma = read.GAMMA_sRGB_INVERSE
    data.*.colorspace |= read.CS_HAVE_INTENT | read.CS_HAVE_ENDPOINTS | read.CS_ENDPOINTS_MATCH_sRGB | read.CS_HAVE_GAMMA | read.CS_MATCHES_sRGB | read.CS_FROM_sRGB
    // (A writer writes gAMA and cHRM with sRGB only when asked.)
    if withGammaAndChromaticities { data.*.colorspace |= read.CS_FROM_gAMA | read.CS_FROM_cHRM }
    syncColorspace(data)
}

pub fn setICCP(png: *Png, info: *PngInfo, name: usize, compression: i32, profile: usize, length: usize) -> void {
    const data = dataOf(png, info)
    if name == 0 || profile == 0 { return }
    if compression != 0 { c.appError(png, c.literal("Invalid iCCP compression method")) }
    if data.*.colorspace & read.CS_INVALID != 0 { return }
    // png_colorspace_set_ICC: the profile's checks; each problem is an
    // application error on a writer, a warning or benign error on a
    // reader.
    const view: [*]const u8 = unsafe { @ptrFromInt([*]const u8, name) }
    const good = read.checkProfile(&png.*.reader, view[0..c.cLength(name)], profile, length, data.*.colorType)
    var isError = false
    while read.takeQueued(&png.*.reader, &isError) {
        const message = read.messageText(&png.*.reader)
        if png.*.magic == c.WRITE_MAGIC {
            c.appError(png, message)
        } else if isError {
            c.pngError(png, message)
        } else {
            c.pngWarning(png, message)
        }
    }
    if !good {
        data.*.colorspace |= read.CS_INVALID
        syncColorspace(data)
        return
    }
    data.*.colorspace |= read.CS_FROM_gAMA | read.CS_FROM_cHRM
    const copyAt = c.rawAlloc(png, length)
    if copyAt == 0 {
        c.benignError(png, c.literal("Insufficient memory to process iCCP profile"))
        return
    }
    c.copy(copyAt, profile, length)
    read.freeProfile(data)
    data.*.allocator = c.allocatorOf(png)
    data.*.iccpProfile = copyAt
    data.*.iccpLength = length
    c.zero(@intFromPtr(&data.*.iccpName), 81)
    var index: usize = 0
    while index < 79 && c.get8(name + index) != 0 {
        data.*.iccpName[index] = @intCast(u8, c.get8(name + index))
        index += 1
    }
    data.*.valid |= read.INFO_iCCP
}

pub fn setPHYS(png: *Png, info: *PngInfo, x: usize, y: usize, unit: usize) -> void {
    const data = dataOf(png, info)
    data.*.xPixelsPerUnit = x
    data.*.yPixelsPerUnit = y
    data.*.physUnit = unit
    data.*.valid |= read.INFO_pHYs
}

// png_set_text: the texts kept in the info (key and text copied, the
// compression), each entry two words: the copy (key NUL text NUL) and
// the compression.
pub fn setText(png: *Png, info: *PngInfo, texts: usize, count: i64) -> void {
    if count <= 0 || texts == 0 { return }
    const total = info.*.textCount + @intCast(usize, count)
    const table = c.allocate(png, total * 16)
    if info.*.textCount != 0 { c.copy(table, info.*.texts, info.*.textCount * 16) }
    c.rawFree(png, info.*.texts)
    info.*.texts = table
    var index: usize = 0
    while index < @intCast(usize, count) {
        const entry = texts + index * 56
        const compression = unsafe { @ptrFromInt(*i32, entry).* }
        const key = c.getWord(entry + 8)
        const text = c.getWord(entry + 16)
        var keyLength: usize = 0
        if key != 0 { keyLength = c.cLength(key) }
        var textLength: usize = 0
        if text != 0 { textLength = c.cLength(text) }
        if keyLength == 0 || keyLength > 79 {
            c.pngWarning(png, c.literal("text chunk: invalid keyword"))
        } else {
            const copyAt = c.allocate(png, keyLength + textLength + 2)
            c.copy(copyAt, key, keyLength)
            c.put8(copyAt + keyLength, 0)
            c.copy(copyAt + keyLength + 1, text, textLength)
            c.put8(copyAt + keyLength + 1 + textLength, 0)
            const slot = table + info.*.textCount * 16
            c.putWord(slot, copyAt)
            c.putWord(slot + 8, @bitCast(usize, @intCast(i64, compression)))
            info.*.textCount += 1
        }
        index += 1
    }
}

// png_set_unknown_chunks: copies kept in the info, as png_unknown_chunk
// structures (32 bytes: name, data, size, location).
pub fn setUnknown(png: *Png, info: *PngInfo, chunks: usize, count: i64) -> void {
    if count <= 0 || chunks == 0 { return }
    const total = info.*.unknownCount + @intCast(usize, count)
    const table = c.allocate(png, total * 32)
    if info.*.unknownCount != 0 { c.copy(table, info.*.unknowns, info.*.unknownCount * 32) }
    c.rawFree(png, info.*.unknowns)
    info.*.unknowns = table
    var index: usize = 0
    while index < @intCast(usize, count) {
        const source = chunks + index * 32
        const target = table + info.*.unknownCount * 32
        c.copy(target, source, 5)
        const size = c.getWord(source + 16)
        var dataCopy: usize = 0
        if size != 0 {
            dataCopy = c.allocate(png, size)
            c.copy(dataCopy, c.getWord(source + 8), size)
        }
        c.putWord(target + 8, dataCopy)
        c.putWord(target + 16, size)
        // (libpng checks the location: one of IHDR, PLTE or after IDAT.)
        var location = c.get8(source + 24) & (1 | 2 | 8)
        if location == 0 {
            c.appError(png, c.literal("png_set_unknown_chunks now expects a valid location"))
            location = 1
        }
        if location & 8 != 0 { location = 8 } else if location & 2 != 0 { location = 2 } else { location = 1 }
        c.putWord(target + 24, location)
        info.*.unknownCount += 1
        index += 1
    }
}
