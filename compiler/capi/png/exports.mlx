// The functions png.h declares, as C calls them: each checks its
// structure and calls the library's own (reader.mlx, info.mlx,
// writer.mlx, common.mlx). A null or foreign structure is passed over as
// libpng passes over a null one.
const c = @import("./common.mlx")
const reader = @import("./reader.mlx")
const info = @import("./info.mlx")
const writer = @import("./writer.mlx")
const read = @import("std.png.read")


fn png(address: usize) -> *c.Png { return c.pngOf(address) }
fn inf(address: usize) -> *c.PngInfo { return c.infoOf(address) }

// ---------------------------------------------------------------------------
// The library

export fn png_access_version_number() -> u32 { return 10643 }
export fn png_get_libpng_ver(png_ptr: usize) -> usize { return c.literal("1.6.43") }
export fn png_get_header_ver(png_ptr: usize) -> usize { return c.literal("1.6.43") }
export fn png_get_header_version(png_ptr: usize) -> usize { return c.literal(" libpng version 1.6.43 - mlx-libpng\n") }
export fn png_get_copyright(png_ptr: usize) -> usize { return c.literal("\nmlx-libpng: libpng's API (1.6.43) in Mlx, over std.png.\n") }

export fn png_sig_cmp(sig: usize, start: usize, num_to_check: usize) -> i32 {
    const expected = [8]u8{ 137, 80, 78, 71, 13, 10, 26, 10 }
    var count = num_to_check
    if count > 8 { count = 8 }
    if count < 1 { return -1 }
    if start > 7 { return -1 }
    if start + count > 8 { count = 8 - start }
    var index = start
    while index < start + count {
        const theirs = c.get8(sig + index)
        const ours = @intCast(usize, expected[index])
        if theirs != ours { return if theirs < ours { -1 } else { 1 } }
        index += 1
    }
    return 0
}

export fn png_set_sig_bytes(png_ptr: usize, num_bytes: i32) -> void {
    if !c.isPng(png_ptr) { return }
    if num_bytes < 0 { read.setSignatureBytes(&png(png_ptr).*.reader, 0) } else { read.setSignatureBytes(&png(png_ptr).*.reader, @intCast(usize, num_bytes)) }
    if num_bytes > 8 { c.pngError(png(png_ptr), c.literal("Too many bytes for PNG signature")) }
}

export fn png_create_read_struct(user_png_ver: usize, error_ptr: usize, error_fn: usize, warn_fn: usize) -> usize {
    return reader.createStruct(user_png_ver, error_ptr, error_fn, warn_fn, 0, 0, 0, c.READ_MAGIC)
}

export fn png_create_read_struct_2(user_png_ver: usize, error_ptr: usize, error_fn: usize, warn_fn: usize, mem_ptr: usize, malloc_fn: usize, free_fn: usize) -> usize {
    return reader.createStruct(user_png_ver, error_ptr, error_fn, warn_fn, mem_ptr, malloc_fn, free_fn, c.READ_MAGIC)
}

export fn png_create_write_struct(user_png_ver: usize, error_ptr: usize, error_fn: usize, warn_fn: usize) -> usize {
    return writer.create(user_png_ver, error_ptr, error_fn, warn_fn, 0, 0, 0)
}

export fn png_create_write_struct_2(user_png_ver: usize, error_ptr: usize, error_fn: usize, warn_fn: usize, mem_ptr: usize, malloc_fn: usize, free_fn: usize) -> usize {
    return writer.create(user_png_ver, error_ptr, error_fn, warn_fn, mem_ptr, malloc_fn, free_fn)
}

export fn png_create_info_struct(png_ptr: usize) -> usize { return reader.createInfo(png_ptr) }

export fn png_destroy_info_struct(png_ptr: usize, info_ptr_ptr: usize) -> void { reader.destroyInfo(png_ptr, info_ptr_ptr) }

export fn png_destroy_read_struct(png_ptr_ptr: usize, info_ptr_ptr: usize, end_info_ptr_ptr: usize) -> void {
    reader.destroyRead(png_ptr_ptr, info_ptr_ptr, end_info_ptr_ptr)
}

export fn png_destroy_write_struct(png_ptr_ptr: usize, info_ptr_ptr: usize) -> void { writer.destroy(png_ptr_ptr, info_ptr_ptr) }

export fn png_free_data(png_ptr: usize, info_ptr: usize, free_me: u32, num: i32) -> void {
    if !info.usable(png_ptr, info_ptr) { return }
    const data = info.dataOf(png(png_ptr), inf(info_ptr))
    if free_me & 0x0010 != 0 {
        read.freeProfile(data)
        data.*.valid &= ~read.INFO_iCCP
    }
}

// ---------------------------------------------------------------------------
// Memory

export fn png_malloc(png_ptr: usize, size: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    return c.allocate(png(png_ptr), size)
}

export fn png_calloc(png_ptr: usize, size: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    const address = c.allocate(png(png_ptr), size)
    c.zero(address, size)
    return address
}

export fn png_malloc_warn(png_ptr: usize, size: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    const address = c.rawAlloc(png(png_ptr), size)
    if address == 0 { c.pngWarning(png(png_ptr), c.literal("Out of memory")) }
    return address
}

export fn png_free(png_ptr: usize, ptr: usize) -> void {
    if !c.isAny(png_ptr) { return }
    c.rawFree(png(png_ptr), ptr)
}

export fn png_get_mem_ptr(png_ptr: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    return png(png_ptr).*.memPtr
}

export fn png_set_mem_fn(png_ptr: usize, mem_ptr: usize, malloc_fn: usize, free_fn: usize) -> void {
    if !c.isAny(png_ptr) { return }
    png(png_ptr).*.memPtr = mem_ptr
    png(png_ptr).*.mallocFn = malloc_fn
    png(png_ptr).*.freeFn = free_fn
}

// ---------------------------------------------------------------------------
// Errors

export fn png_set_longjmp_fn(png_ptr: usize, longjmp_fn: usize, jmp_buf_size: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    return reader.setLongjmp(png(png_ptr), longjmp_fn, jmp_buf_size)
}

export fn png_longjmp(png_ptr: usize, val: i32) -> void {
    if c.isAny(png_ptr) { c.pngLongjmp(png(png_ptr), val) }
}

export fn png_error(png_ptr: usize, error_message: usize) -> void {
    if c.isAny(png_ptr) { c.pngError(png(png_ptr), error_message) }
}

export fn png_chunk_error(png_ptr: usize, error_message: usize) -> void {
    if c.isAny(png_ptr) { c.chunkError(png(png_ptr), error_message) }
}

export fn png_warning(png_ptr: usize, warning_message: usize) -> void {
    if c.isAny(png_ptr) { c.pngWarning(png(png_ptr), warning_message) }
}

export fn png_chunk_warning(png_ptr: usize, warning_message: usize) -> void {
    if c.isAny(png_ptr) { c.chunkWarning(png(png_ptr), warning_message) }
}

export fn png_benign_error(png_ptr: usize, warning_message: usize) -> void {
    if c.isAny(png_ptr) { c.benignError(png(png_ptr), warning_message) }
}

export fn png_chunk_benign_error(png_ptr: usize, warning_message: usize) -> void {
    if !c.isAny(png_ptr) { return }
    if png(png_ptr).*.flags & c.F_BENIGN_ERRORS_WARN != 0 { c.chunkWarning(png(png_ptr), warning_message) } else { c.chunkError(png(png_ptr), warning_message) }
}

export fn png_set_benign_errors(png_ptr: usize, allowed: i32) -> void {
    if !c.isAny(png_ptr) { return }
    const p = png(png_ptr)
    if allowed != 0 {
        p.*.flags |= c.F_BENIGN_ERRORS_WARN | c.F_APP_WARNINGS_WARN | c.F_APP_ERRORS_WARN
    } else {
        p.*.flags &= ~(c.F_BENIGN_ERRORS_WARN | c.F_APP_WARNINGS_WARN | c.F_APP_ERRORS_WARN)
    }
    p.*.reader.benignErrors = allowed != 0
}

export fn png_set_error_fn(png_ptr: usize, error_ptr: usize, error_fn: usize, warning_fn: usize) -> void {
    if !c.isAny(png_ptr) { return }
    png(png_ptr).*.errorPtr = error_ptr
    png(png_ptr).*.errorFn = error_fn
    png(png_ptr).*.warningFn = warning_fn
}

export fn png_get_error_ptr(png_ptr: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    return png(png_ptr).*.errorPtr
}

// ---------------------------------------------------------------------------
// The reader's settings

export fn png_set_crc_action(png_ptr: usize, crit_action: i32, ancil_action: i32) -> void {
    if c.isPng(png_ptr) { reader.setCrcAction(png(png_ptr), crit_action, ancil_action) }
}

export fn png_set_option(png_ptr: usize, option: i32, onoff: i32) -> i32 {
    if !c.isAny(png_ptr) { return 1 }
    return reader.setOption(png(png_ptr), option, onoff)
}

export fn png_set_user_limits(png_ptr: usize, user_width_max: u32, user_height_max: u32) -> void {
    if !c.isAny(png_ptr) { return }
    png(png_ptr).*.userWidthMax = @intCast(usize, user_width_max)
    png(png_ptr).*.userHeightMax = @intCast(usize, user_height_max)
}

export fn png_get_user_width_max(png_ptr: usize) -> u32 {
    if !c.isAny(png_ptr) { return 0 }
    return @intCast(u32, png(png_ptr).*.userWidthMax & 0xffffffff)
}

export fn png_get_user_height_max(png_ptr: usize) -> u32 {
    if !c.isAny(png_ptr) { return 0 }
    return @intCast(u32, png(png_ptr).*.userHeightMax & 0xffffffff)
}

export fn png_set_chunk_cache_max(png_ptr: usize, user_chunk_cache_max: u32) -> void {
    if c.isAny(png_ptr) { png(png_ptr).*.reader.chunkCacheMax = @intCast(usize, user_chunk_cache_max) }
}

export fn png_get_chunk_cache_max(png_ptr: usize) -> u32 {
    if !c.isAny(png_ptr) { return 0 }
    return @intCast(u32, png(png_ptr).*.reader.chunkCacheMax & 0xffffffff)
}

export fn png_set_chunk_malloc_max(png_ptr: usize, user_chunk_malloc_max: usize) -> void {
    if c.isAny(png_ptr) { png(png_ptr).*.reader.chunkMallocMax = user_chunk_malloc_max }
}

export fn png_get_chunk_malloc_max(png_ptr: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    return png(png_ptr).*.reader.chunkMallocMax
}

// ---------------------------------------------------------------------------
// The progressive reader

export fn png_set_progressive_read_fn(png_ptr: usize, progressive_ptr: usize, info_fn: usize, row_fn: usize, end_fn: usize) -> void {
    if !c.isPng(png_ptr) { return }
    png(png_ptr).*.ioPtr = progressive_ptr
    png(png_ptr).*.infoFn = info_fn
    png(png_ptr).*.rowFn = row_fn
    png(png_ptr).*.endFn = end_fn
}

export fn png_get_progressive_ptr(png_ptr: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    return png(png_ptr).*.ioPtr
}

export fn png_get_io_ptr(png_ptr: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    return png(png_ptr).*.ioPtr
}

export fn png_process_data(png_ptr: usize, info_ptr: usize, buffer: usize, buffer_size: usize) -> void {
    if !c.isPng(png_ptr) || info_ptr == 0 { return }
    reader.processData(png(png_ptr), info_ptr, buffer, buffer_size)
}

export fn png_process_data_pause(png_ptr: usize, save: i32) -> usize {
    if !c.isPng(png_ptr) { return 0 }
    return reader.pause(png(png_ptr), save)
}

export fn png_process_data_skip(png_ptr: usize) -> u32 {
    if c.isPng(png_ptr) { c.appWarning(png(png_ptr), c.literal("png_process_data_skip is not implemented in any current version of libpng")) }
    return 0
}

export fn png_progressive_combine_row(png_ptr: usize, old_row: usize, new_row: usize) -> void {
    if !c.isPng(png_ptr) { return }
    reader.combineRow(png(png_ptr), old_row, new_row)
}

export fn png_read_update_info(png_ptr: usize, info_ptr: usize) -> void {
    if !c.isPng(png_ptr) { return }
    const p = png(png_ptr)
    if p.*.flags & c.F_ROW_INIT == 0 {
        reader.startRow(p)
        if info_ptr != 0 { reader.transformInfo(p, inf(info_ptr)) }
    } else {
        c.appError(p, c.literal("png_read_update_info/png_start_read_image: duplicate call"))
    }
}

export fn png_start_read_image(png_ptr: usize) -> void {
    if !c.isPng(png_ptr) { return }
    const p = png(png_ptr)
    if p.*.flags & c.F_ROW_INIT == 0 {
        reader.startRow(p)
    } else {
        c.appError(p, c.literal("png_start_read_image/png_read_update_info: duplicate call"))
    }
}

export fn png_set_read_user_chunk_fn(png_ptr: usize, user_chunk_ptr: usize, read_user_chunk_fn: usize) -> void {
    if !c.isPng(png_ptr) { return }
    png(png_ptr).*.userChunkPtr = user_chunk_ptr
    png(png_ptr).*.userChunkFn = read_user_chunk_fn
}

export fn png_get_user_chunk_ptr(png_ptr: usize) -> usize {
    if !c.isAny(png_ptr) { return 0 }
    return png(png_ptr).*.userChunkPtr
}

export fn png_set_keep_unknown_chunks(png_ptr: usize, keep: i32, chunk_list: usize, num_chunks: i32) -> void {
    if c.isAny(png_ptr) { reader.setKeepUnknown(png(png_ptr), keep, chunk_list, num_chunks) }
}

export fn png_handle_as_unknown(png_ptr: usize, chunk_name: usize) -> i32 {
    if !c.isAny(png_ptr) || chunk_name == 0 { return 0 }
    return @intCast(i32, read.keepOf(&png(png_ptr).*.reader, read.read32(chunk_name)))
}

export fn png_set_unknown_chunks(png_ptr: usize, info_ptr: usize, unknowns: usize, num_unknowns: i32) -> void {
    if info.usable(png_ptr, info_ptr) { info.setUnknown(png(png_ptr), inf(info_ptr), unknowns, @intCast(i64, num_unknowns)) }
}

// ---------------------------------------------------------------------------
// Transformations

fn transform(png_ptr: usize, bits: usize, checked: bool) -> void {
    if c.isPng(png_ptr) { reader.setTransformation(png(png_ptr), bits, checked) }
}

export fn png_set_expand(png_ptr: usize) -> void { transform(png_ptr, c.T_EXPAND | c.T_EXPAND_tRNS, true) }
export fn png_set_expand_gray_1_2_4_to_8(png_ptr: usize) -> void { transform(png_ptr, c.T_EXPAND, true) }
export fn png_set_palette_to_rgb(png_ptr: usize) -> void { transform(png_ptr, c.T_EXPAND | c.T_EXPAND_tRNS, true) }
export fn png_set_tRNS_to_alpha(png_ptr: usize) -> void { transform(png_ptr, c.T_EXPAND | c.T_EXPAND_tRNS, true) }
export fn png_set_expand_16(png_ptr: usize) -> void { transform(png_ptr, c.T_EXPAND_16 | c.T_EXPAND | c.T_EXPAND_tRNS, true) }
export fn png_set_strip_16(png_ptr: usize) -> void { transform(png_ptr, c.T_16_TO_8, true) }
export fn png_set_scale_16(png_ptr: usize) -> void { transform(png_ptr, c.T_SCALE_16_TO_8, true) }
export fn png_set_strip_alpha(png_ptr: usize) -> void { transform(png_ptr, c.T_STRIP_ALPHA, true) }
export fn png_set_gray_to_rgb(png_ptr: usize) -> void { transform(png_ptr, c.T_GRAY_TO_RGB | c.T_EXPAND, true) }
export fn png_set_bgr(png_ptr: usize) -> void { transform(png_ptr, c.T_BGR, false) }
export fn png_set_swap_alpha(png_ptr: usize) -> void { transform(png_ptr, c.T_SWAP_ALPHA, false) }
export fn png_set_invert_alpha(png_ptr: usize) -> void { transform(png_ptr, c.T_INVERT_ALPHA, false) }
export fn png_set_invert_mono(png_ptr: usize) -> void { transform(png_ptr, c.T_INVERT_MONO, false) }

export fn png_set_packing(png_ptr: usize) -> void {
    if c.isPng(png_ptr) && png(png_ptr).*.file.bitDepth < 8 { png(png_ptr).*.transformations |= c.T_PACK }
    if c.isWriter(png_ptr) { writer.setPacking(png(png_ptr)) }
}

export fn png_set_packswap(png_ptr: usize) -> void {
    if c.isPng(png_ptr) && png(png_ptr).*.file.bitDepth < 8 { png(png_ptr).*.transformations |= c.T_PACKSWAP }
}

export fn png_set_swap(png_ptr: usize) -> void {
    if c.isPng(png_ptr) && png(png_ptr).*.file.bitDepth == 16 { png(png_ptr).*.transformations |= c.T_SWAP_BYTES }
    if c.isWriter(png_ptr) { writer.setSwap(png(png_ptr)) }
}

export fn png_set_filler(png_ptr: usize, filler: u32, flags: i32) -> void { setFiller(png_ptr, filler, flags) }

fn setFiller(png_ptr: usize, filler: u32, flags: i32) -> void {
    if c.isWriter(png_ptr) {
        writer.setFiller(png(png_ptr), flags)
        return
    }
    if !c.isPng(png_ptr) { return }
    const p = png(png_ptr)
    p.*.filler = @intCast(usize, filler) & 0xffff
    if flags == 1 { p.*.flags |= c.F_FILLER_AFTER } else { p.*.flags &= ~c.F_FILLER_AFTER }
    p.*.transformations |= c.T_FILLER
}

export fn png_set_add_alpha(png_ptr: usize, filler: u32, flags: i32) -> void {
    if !c.isPng(png_ptr) { return }
    setFiller(png_ptr, filler, flags)
    png(png_ptr).*.transformations |= c.T_ADD_ALPHA
}

export fn png_set_interlace_handling(png_ptr: usize) -> i32 {
    if c.isAny(png_ptr) {
        const p = png(png_ptr)
        const interlaced = if p.*.magic == c.READ_MAGIC { p.*.file.interlace } else { writer.interlaced(p) }
        if interlaced != 0 {
            p.*.transformations |= c.T_INTERLACE
            return 7
        }
    }
    return 1
}

export fn png_set_gamma(png_ptr: usize, screen_gamma: f64, override_file_gamma: f64) -> void {
    if !c.isPng(png_ptr) { return }
    const p = png(png_ptr)
    const screen = reader.gammaFromDouble(p, screen_gamma)
    const file = reader.gammaFromDouble(p, override_file_gamma)
    reader.setGamma(p, screen, file)
}

export fn png_set_gamma_fixed(png_ptr: usize, screen_gamma: i32, override_file_gamma: i32) -> void {
    if c.isPng(png_ptr) { reader.setGamma(png(png_ptr), @intCast(i64, screen_gamma), @intCast(i64, override_file_gamma)) }
}

// ---------------------------------------------------------------------------
// The info

export fn png_get_valid(png_ptr: usize, info_ptr: usize, flag: u32) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.valid(png(png_ptr), inf(info_ptr), @intCast(usize, flag)) & 0xffffffff)
}

export fn png_get_rowbytes(png_ptr: usize, info_ptr: usize) -> usize {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return info.rowBytes(png(png_ptr), inf(info_ptr))
}

export fn png_get_image_width(png_ptr: usize, info_ptr: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.dataOf(png(png_ptr), inf(info_ptr)).*.width & 0xffffffff)
}

export fn png_get_image_height(png_ptr: usize, info_ptr: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.dataOf(png(png_ptr), inf(info_ptr)).*.height & 0xffffffff)
}

export fn png_get_bit_depth(png_ptr: usize, info_ptr: usize) -> u8 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u8, info.bitDepth(png(png_ptr), inf(info_ptr)) & 255)
}

export fn png_get_color_type(png_ptr: usize, info_ptr: usize) -> u8 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u8, info.colorType(png(png_ptr), inf(info_ptr)) & 255)
}

export fn png_get_filter_type(png_ptr: usize, info_ptr: usize) -> u8 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u8, info.dataOf(png(png_ptr), inf(info_ptr)).*.filter & 255)
}

export fn png_get_interlace_type(png_ptr: usize, info_ptr: usize) -> u8 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u8, info.dataOf(png(png_ptr), inf(info_ptr)).*.interlace & 255)
}

export fn png_get_compression_type(png_ptr: usize, info_ptr: usize) -> u8 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u8, info.dataOf(png(png_ptr), inf(info_ptr)).*.compression & 255)
}

export fn png_get_channels(png_ptr: usize, info_ptr: usize) -> u8 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u8, info.channels(png(png_ptr), inf(info_ptr)) & 255)
}

export fn png_get_signature(png_ptr: usize, info_ptr: usize) -> usize {
    if !c.isPng(png_ptr) { return 0 }
    return @intFromPtr(&png(png_ptr).*.reader.signature)
}

export fn png_get_IHDR(png_ptr: usize, info_ptr: usize, width: usize, height: usize, bit_depth: usize, color_type: usize, interlace_method: usize, compression_method: usize, filter_method: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.getIHDR(png(png_ptr), inf(info_ptr), width, height, bit_depth, color_type, interlace_method, compression_method, filter_method))
}

export fn png_get_PLTE(png_ptr: usize, info_ptr: usize, palette: usize, num_palette: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.getPLTE(png(png_ptr), inf(info_ptr), palette, num_palette))
}

export fn png_get_tRNS(png_ptr: usize, info_ptr: usize, trans_alpha: usize, num_trans: usize, trans_color: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.getTRNS(png(png_ptr), inf(info_ptr), trans_alpha, num_trans, trans_color))
}

export fn png_get_sBIT(png_ptr: usize, info_ptr: usize, sig_bit: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.getSBIT(png(png_ptr), inf(info_ptr), sig_bit))
}

export fn png_get_bKGD(png_ptr: usize, info_ptr: usize, background: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.getBKGD(png(png_ptr), inf(info_ptr), background))
}

export fn png_get_gAMA(png_ptr: usize, info_ptr: usize, file_gamma: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) || file_gamma == 0 { return 0 }
    const value = info.getGamma(png(png_ptr), inf(info_ptr))
    if value == 0 { return 0 }
    c.putDouble(file_gamma, @floatFromInt(f64, value) * 0.00001)
    return 1
}

export fn png_get_gAMA_fixed(png_ptr: usize, info_ptr: usize, int_file_gamma: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) || int_file_gamma == 0 { return 0 }
    const value = info.getGamma(png(png_ptr), inf(info_ptr))
    if value == 0 { return 0 }
    c.putI32(int_file_gamma, value)
    return 1
}

export fn png_get_cHRM(png_ptr: usize, info_ptr: usize, white_x: usize, white_y: usize, red_x: usize, red_y: usize, green_x: usize, green_y: usize, blue_x: usize, blue_y: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    var targets = [8]usize{ white_x, white_y, red_x, red_y, green_x, green_y, blue_x, blue_y }
    return @intCast(u32, info.getCHRM(png(png_ptr), inf(info_ptr), @intFromPtr(&targets), true))
}

export fn png_get_cHRM_fixed(png_ptr: usize, info_ptr: usize, white_x: usize, white_y: usize, red_x: usize, red_y: usize, green_x: usize, green_y: usize, blue_x: usize, blue_y: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    var targets = [8]usize{ white_x, white_y, red_x, red_y, green_x, green_y, blue_x, blue_y }
    return @intCast(u32, info.getCHRM(png(png_ptr), inf(info_ptr), @intFromPtr(&targets), false))
}

export fn png_get_sRGB(png_ptr: usize, info_ptr: usize, file_srgb_intent: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.getSRGB(png(png_ptr), inf(info_ptr), file_srgb_intent))
}

export fn png_get_iCCP(png_ptr: usize, info_ptr: usize, name: usize, compression_type: usize, profile: usize, proflen: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.getICCP(png(png_ptr), inf(info_ptr), name, compression_type, profile, proflen))
}

export fn png_get_pHYs(png_ptr: usize, info_ptr: usize, res_x: usize, res_y: usize, unit_type: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.getPHYS(png(png_ptr), inf(info_ptr), res_x, res_y, unit_type))
}

export fn png_get_x_pixels_per_meter(png_ptr: usize, info_ptr: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.pixelsPerMeter(png(png_ptr), inf(info_ptr), false) & 0xffffffff)
}

export fn png_get_y_pixels_per_meter(png_ptr: usize, info_ptr: usize) -> u32 {
    if !info.usable(png_ptr, info_ptr) { return 0 }
    return @intCast(u32, info.pixelsPerMeter(png(png_ptr), inf(info_ptr), true) & 0xffffffff)
}

export fn png_set_IHDR(png_ptr: usize, info_ptr: usize, width: u32, height: u32, bit_depth: i32, color_type: i32, interlace_method: i32, compression_method: i32, filter_method: i32) -> void {
    if !info.usable(png_ptr, info_ptr) { return }
    info.setIHDR(png(png_ptr), inf(info_ptr), @intCast(usize, width), @intCast(usize, height), @bitCast(usize, @intCast(i64, bit_depth)), @bitCast(usize, @intCast(i64, color_type)), @bitCast(usize, @intCast(i64, interlace_method)), @bitCast(usize, @intCast(i64, compression_method)), @bitCast(usize, @intCast(i64, filter_method)))
}

export fn png_set_PLTE(png_ptr: usize, info_ptr: usize, palette: usize, num_palette: i32) -> void {
    if info.usable(png_ptr, info_ptr) { info.setPLTE(png(png_ptr), inf(info_ptr), palette, @intCast(i64, num_palette)) }
}

export fn png_set_tRNS(png_ptr: usize, info_ptr: usize, trans_alpha: usize, num_trans: i32, trans_color: usize) -> void {
    if info.usable(png_ptr, info_ptr) { info.setTRNS(png(png_ptr), inf(info_ptr), trans_alpha, @intCast(i64, num_trans), trans_color) }
}

export fn png_set_sBIT(png_ptr: usize, info_ptr: usize, sig_bit: usize) -> void {
    if info.usable(png_ptr, info_ptr) && sig_bit != 0 { info.setSBIT(png(png_ptr), inf(info_ptr), sig_bit) }
}

export fn png_set_bKGD(png_ptr: usize, info_ptr: usize, background: usize) -> void {
    if info.usable(png_ptr, info_ptr) && background != 0 { info.setBKGD(png(png_ptr), inf(info_ptr), background) }
}

export fn png_set_gAMA(png_ptr: usize, info_ptr: usize, file_gamma: f64) -> void {
    if !info.usable(png_ptr, info_ptr) { return }
    const p = png(png_ptr)
    info.setGamma(p, inf(info_ptr), reader.gammaFromDouble(p, file_gamma))
}

export fn png_set_gAMA_fixed(png_ptr: usize, info_ptr: usize, int_file_gamma: i32) -> void {
    if info.usable(png_ptr, info_ptr) { info.setGamma(png(png_ptr), inf(info_ptr), @intCast(i64, int_file_gamma)) }
}

export fn png_set_sRGB(png_ptr: usize, info_ptr: usize, srgb_intent: i32) -> void {
    if info.usable(png_ptr, info_ptr) { info.setSRGB(png(png_ptr), inf(info_ptr), @bitCast(usize, @intCast(i64, srgb_intent)), false) }
}

export fn png_set_sRGB_gAMA_and_cHRM(png_ptr: usize, info_ptr: usize, srgb_intent: i32) -> void {
    if info.usable(png_ptr, info_ptr) { info.setSRGB(png(png_ptr), inf(info_ptr), @bitCast(usize, @intCast(i64, srgb_intent)), true) }
}

export fn png_set_iCCP(png_ptr: usize, info_ptr: usize, name: usize, compression_type: i32, profile: usize, proflen: u32) -> void {
    if info.usable(png_ptr, info_ptr) { info.setICCP(png(png_ptr), inf(info_ptr), name, compression_type, profile, @intCast(usize, proflen)) }
}

export fn png_set_pHYs(png_ptr: usize, info_ptr: usize, res_x: u32, res_y: u32, unit_type: i32) -> void {
    if info.usable(png_ptr, info_ptr) { info.setPHYS(png(png_ptr), inf(info_ptr), @intCast(usize, res_x), @intCast(usize, res_y), @bitCast(usize, @intCast(i64, unit_type))) }
}

export fn png_set_text(png_ptr: usize, info_ptr: usize, text_ptr: usize, num_text: i32) -> void {
    if info.usable(png_ptr, info_ptr) { info.setText(png(png_ptr), inf(info_ptr), text_ptr, @intCast(i64, num_text)) }
}

// ---------------------------------------------------------------------------
// Numbers in buffers

export fn png_get_uint_32(buf: usize) -> u32 { return @intCast(u32, read.read32(buf)) }
export fn png_get_uint_16(buf: usize) -> u16 { return @intCast(u16, read.read16(buf)) }
export fn png_get_int_32(buf: usize) -> i32 { return @bitCast(i32, @intCast(u32, read.read32(buf))) }

export fn png_get_uint_31(png_ptr: usize, buf: usize) -> u32 {
    const value = read.read32(buf)
    if value > 0x7fffffff && c.isAny(png_ptr) { c.pngError(png(png_ptr), c.literal("PNG unsigned integer out of range")) }
    return @intCast(u32, value)
}

export fn png_save_uint_32(buf: usize, i: u32) -> void { save32(buf, i) }

fn save32(buf: usize, i: u32) -> void {
    const value = @intCast(usize, i)
    c.put8(buf, value >> 24)
    c.put8(buf + 1, (value >> 16) & 255)
    c.put8(buf + 2, (value >> 8) & 255)
    c.put8(buf + 3, value & 255)
}

export fn png_save_int_32(buf: usize, i: i32) -> void { save32(buf, @bitCast(u32, i)) }

export fn png_save_uint_16(buf: usize, i: u32) -> void {
    const value = @intCast(usize, i)
    c.put8(buf, (value >> 8) & 255)
    c.put8(buf + 1, value & 255)
}
