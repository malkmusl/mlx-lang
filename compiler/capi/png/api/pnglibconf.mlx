// pnglibconf.h
// mlx-libpng: what this libpng supports, as libpng's own configuration
// header says it to programs that ask (`#ifdef PNG_..._SUPPORTED`): the
// progressive reader with its transformations, unknown chunks, user
// limits and options, the writer, and the numbers libpng is built with.
// The library is this repository's own, in Mlx (compiler/capi/png, over
// std.png); mlx-cheaders makes the header of this module.
