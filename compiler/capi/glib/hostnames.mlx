// ghostutils.h's g_hostname_to_ascii: a host name with labels beyond
// ASCII written as IDNA's ACE labels ("xn--" and the label's Punycode,
// RFC 3492); an ASCII name is returned as it is, as GLib does. GLib also
// prepares each label (case folding and NFKC); here only the ASCII letters
// of a name beyond ASCII are made lower case. NULL for a name that is not
// UTF-8 or whose label grows past 63 bytes.
const m = @import("./memory.mlx")

fn decodeUtf8(text: usize, length: usize, at: *usize) -> u32 {
    const first = @intCast(u32, m.get8(text + at.*))
    var count: usize = 0
    var value: u32 = 0
    if first < 128 {
        at.* += 1
        return first
    } else if (first & 224) == 192 {
        count = 1
        value = first & 31
    } else if (first & 240) == 224 {
        count = 2
        value = first & 15
    } else if (first & 248) == 240 {
        count = 3
        value = first & 7
    } else {
        return 4294967295
    }
    if at.* + count >= length { return 4294967295 }
    var index: usize = 1
    while index <= count {
        const next = @intCast(u32, m.get8(text + at.* + index))
        if (next & 192) != 128 { return 4294967295 }
        value = (value << 6) | (next & 63)
        index += 1
    }
    at.* += count + 1
    return value
}

fn digit(d: u32) -> u8 { return if d < 26 { @intCast(u8, 97 + d) } else { @intCast(u8, 22 + d) } }

fn adapt(deltaIn: u32, points: u32, first: bool) -> u32 {
    var delta = if first { deltaIn / 700 } else { deltaIn / 2 }
    delta += delta / points
    var k: u32 = 0
    while delta > 455 {
        delta = delta / 35
        k += 36
    }
    return k + (36 * delta) / (delta + 38)
}

// One label's Punycode appended to `t`.
fn punycode(t: *m.Text, points: usize, count: usize) -> bool {
    var basic: usize = 0
    var index: usize = 0
    while index < count {
        const p = m.get32(points + index * 4)
        if p < 128 {
            m.pushByte(t, @intCast(u8, p))
            basic += 1
        }
        index += 1
    }
    if basic > 0 { m.pushByte(t, 45) }
    var n: u32 = 128
    var delta: u32 = 0
    var bias: u32 = 72
    var handled = basic
    while handled < count {
        var smallest: u32 = 4294967295
        index = 0
        while index < count {
            const p = m.get32(points + index * 4)
            if p >= n && p < smallest { smallest = p }
            index += 1
        }
        delta += (smallest - n) * @intCast(u32, handled + 1)
        n = smallest
        index = 0
        while index < count {
            const p = m.get32(points + index * 4)
            if p < n { delta += 1 }
            if p == n {
                var q = delta
                var k: u32 = 36
                while true {
                    const tk = if k <= bias { 1 } else if k >= bias + 26 { 26 } else { k - bias }
                    if q < tk { break }
                    m.pushByte(t, digit(tk + (q - tk) % (36 - tk)))
                    q = (q - tk) / (36 - tk)
                    k += 36
                }
                m.pushByte(t, digit(q))
                bias = adapt(delta, @intCast(u32, handled + 1), handled == basic)
                delta = 0
                handled += 1
            }
            index += 1
        }
        delta += 1
        n += 1
    }
    return true
}

export fn g_hostname_to_ascii(hostname: usize) -> usize {
    if hostname == 0 { return 0 }
    const length = m.cLength(hostname)
    var ascii = true
    var k: usize = 0
    while k < length {
        if m.get8(hostname + k) >= 128 { ascii = false }
        k += 1
    }
    if ascii { return m.dup(hostname) }
    var t = m.text()
    const points = m.alloc(length * 4 + 4)
    var at: usize = 0
    while at <= length {
        var end = at
        while end < length && m.get8(hostname + end) != 46 { end += 1 }
        var count: usize = 0
        var wide = false
        var p = at
        while p < end {
            var c = decodeUtf8(hostname, end, &p)
            if c == 4294967295 {
                m.release(points)
                m.dispose(&t)
                return 0
            }
            if c >= 65 && c <= 90 { c += 32 }
            if c >= 128 { wide = true }
            m.put32(points + count * 4, c)
            count += 1
        }
        const labelStart = t.length
        if wide {
            m.pushText(&t, "xn--")
            _ = punycode(&t, points, count)
        } else {
            var i: usize = 0
            while i < count {
                m.pushByte(&t, @intCast(u8, m.get32(points + i * 4)))
                i += 1
            }
        }
        if t.length - labelStart > 63 {
            m.release(points)
            m.dispose(&t)
            return 0
        }
        if end < length { m.pushByte(&t, 46) }
        at = end + 1
    }
    m.release(points)
    return m.finish(&t)
}
