// gunixfdlist.h: GUnixFDList, the descriptors a D-Bus message carries
// (its 'h' values are indices into it). The list owns its descriptors:
// appending duplicates one (close-on-exec), getting one hands out a
// duplicate, and they are closed with the list unless stolen.
//
// A GUnixFDList: a GObject and (24) a record of the descriptors (0, an
// array of i32 ended by -1, as GIO's peek_fds gives it), their number (8)
// and the array's room (16).
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const types = @import("./types.mlx")
const errors = @import("./errors.mlx")
const ioerrors = @import("./ioerrors.mlx")
const messages = @import("./messages.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_type_check_instance_is_a(instance: usize, t: usize) -> i32

const F_DUPFD_CLOEXEC: i32 = 1030

const L_FDS: usize = 0
const L_COUNT: usize = 8
const L_ROOM: usize = 16
const L_SIZE: usize = 24

var listOnce: u64 = 0
var listType: usize = 0

fn rec(list: usize) -> usize { return m.getWord(list + 24) }

export fn g_unix_fd_list_get_type() -> usize { return listGType() }

pub fn listGType() -> usize {
    if threads.onceEnter(@intFromPtr(&listOnce)) {
        types.ensureInit()
        listType = ioerrors.defineType(types.T_OBJECT, "GUnixFDList", 136 + 64, @intFromPtr(__mlx_glib_unix_fd_list_class_init), 32, @intFromPtr(__mlx_glib_unix_fd_list_init), 0)
        threads.onceLeave(@intFromPtr(&listOnce), 1)
    }
    return listType
}

pub fn isList(list: usize) -> bool { return list != 0 && g_type_check_instance_is_a(list, listGType()) != 0 }

export fn __mlx_glib_unix_fd_list_init(list: usize, class: usize) -> void {
    const r = m.alloc(L_SIZE)
    m.putWord(r + L_FDS, m.alloc(4))
    m.putI32(m.getWord(r + L_FDS), -1)
    m.putWord(r + L_ROOM, 1)
    m.putWord(list + 24, r)
}

export fn __mlx_glib_unix_fd_list_finalize(list: usize) -> void {
    const r = rec(list)
    var i: usize = 0
    while i < m.getWord(r + L_COUNT) {
        _ = sys.close(m.getI32(m.getWord(r + L_FDS) + i * 4))
        i += 1
    }
    m.release(m.getWord(r + L_FDS))
    m.release(r)
    ioerrors.chainUp(types.T_OBJECT, 48, list)
}

export fn __mlx_glib_unix_fd_list_class_init(class: usize, data: usize) -> void { m.putWord(class + 48, @intFromPtr(__mlx_glib_unix_fd_list_finalize)) }

// Takes `fd` over (the list closes it).
pub fn adopt(list: usize, fd: i32) -> usize {
    const r = rec(list)
    const count = m.getWord(r + L_COUNT)
    if count + 1 >= m.getWord(r + L_ROOM) {
        const room = (count + 1) * 2
        m.putWord(r + L_FDS, m.grow(m.getWord(r + L_FDS), room * 4))
        m.putWord(r + L_ROOM, room)
    }
    const fds = m.getWord(r + L_FDS)
    m.putI32(fds + count * 4, fd)
    m.putI32(fds + (count + 1) * 4, -1)
    m.putWord(r + L_COUNT, count + 1)
    return count
}

pub fn count(list: usize) -> usize { return m.getWord(rec(list) + L_COUNT) }

// The descriptor at `index`, still the list's.
pub fn peek(list: usize, index: usize) -> i32 { return m.getI32(m.getWord(rec(list) + L_FDS) + index * 4) }

pub fn newList() -> usize { return g_object_new(listGType(), 0) }

export fn g_unix_fd_list_new() -> usize { return newList() }

export fn g_unix_fd_list_new_from_array(fds: usize, n_fds: i32) -> usize {
    const list = newList()
    var i: usize = 0
    while (n_fds < 0 && m.getI32(fds + i * 4) != -1) || (n_fds >= 0 && i < @intCast(usize, n_fds)) {
        _ = adopt(list, m.getI32(fds + i * 4))
        i += 1
    }
    return list
}

fn dupFailed(err: usize) -> void {
    const errnum = sys.errno()
    var t = m.text()
    m.pushText(&t, "dup: ")
    m.pushC(&t, errors.errnoText(errnum))
    ioerrors.setText(err, ioerrors.fromErrno(errnum), &t)
}

export fn g_unix_fd_list_append(list: usize, fd: i32, err: usize) -> i32 {
    if !isList(list) {
        messages.logText(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, "g_unix_fd_list_append: assertion 'G_IS_UNIX_FD_LIST (list)' failed")
        return -1
    }
    if fd < 0 {
        messages.logText(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, "g_unix_fd_list_append: assertion 'fd >= 0' failed")
        return -1
    }
    const copy = sys.fcntl(fd, F_DUPFD_CLOEXEC, 0)
    if copy < 0 {
        dupFailed(err)
        return -1
    }
    return @intCast(i32, adopt(list, copy))
}

export fn g_unix_fd_list_get(list: usize, index: i32, err: usize) -> i32 {
    if !isList(list) {
        messages.logText(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, "g_unix_fd_list_get: assertion 'G_IS_UNIX_FD_LIST (list)' failed")
        return -1
    }
    if index < 0 || @intCast(usize, index) >= count(list) {
        messages.logText(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, "g_unix_fd_list_get: assertion 'index_ < list->priv->nfd' failed")
        return -1
    }
    const copy = sys.fcntl(peek(list, @intCast(usize, index)), F_DUPFD_CLOEXEC, 0)
    if copy < 0 { dupFailed(err) }
    return copy
}

export fn g_unix_fd_list_get_length(list: usize) -> i32 {
    if !isList(list) { return 0 }
    return @intCast(i32, count(list))
}

export fn g_unix_fd_list_peek_fds(list: usize, length: usize) -> usize {
    if length != 0 { m.putI32(length, @intCast(i32, count(list))) }
    return m.getWord(rec(list) + L_FDS)
}

// The descriptors (a -1 ended array, the caller's with what it holds);
// the list is empty after.
export fn g_unix_fd_list_steal_fds(list: usize, length: usize) -> usize {
    const r = rec(list)
    if length != 0 { m.putI32(length, @intCast(i32, m.getWord(r + L_COUNT))) }
    const fds = m.getWord(r + L_FDS)
    m.putWord(r + L_FDS, m.alloc(4))
    m.putI32(m.getWord(r + L_FDS), -1)
    m.putWord(r + L_COUNT, 0)
    m.putWord(r + L_ROOM, 1)
    return fds
}
