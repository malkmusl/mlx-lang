parse: --name
  pre-parse (extra data)
  ok 0, error g-option-context-error-quark 1: Missing argument for --name
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  left 2: program --name
  group data destroyed (extra data)
parse: --call=bad
  pre-parse (extra data)
  callback --call = bad (data extra data)
  ok 0, error g-option-context-error-quark 1: Failed parse value 'bad' for --call
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  left 2: program --call=bad
  group data destroyed (extra data)
parse: --call=silent
  pre-parse (extra data)
  callback --call = silent (data extra data)
  ok 0, error g-option-context-error-quark 2: Error parsing option --call
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  left 2: program --call=silent
  group data destroyed (extra data)
parse: --unknown -v --other=1 file
  pre-parse (extra data)
  post-parse (extra data)
  ok 1
  verbose 1 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  remaining: [file]
  left 3: program --unknown --other=1
  group data destroyed (extra data)
parse: -vc 5
  pre-parse (extra data)
  post-parse (extra data)
  ok 1
  verbose 1 quiet 1 name - count 5 ratio 0 big 0 file - level 0 mode -
  left 1: program
  group data destroyed (extra data)
parse: -c7
  pre-parse (extra data)
  ok 0, error g-option-context-error-quark 1: Missing argument for -c
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  left 2: program -c7
  group data destroyed (extra data)
plain: ok 1 verbose 1 left 5: program a -- -v b
main group: 1
done
exit 0
