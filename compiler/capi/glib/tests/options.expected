gettext: Hello | Marked | Open | one file | %d files
strip: text | plain | Close
error quark: g-option-context-error-quark
parse: -v --name=Ada -c 12 --ratio 0.5 --big=-9000000000 -w a --word=b -f /tmp/x plain
  pre-parse (extra data)
  post-parse (extra data)
  ok 1
  verbose 1 quiet 1 name Ada count 12 ratio 0.5 big -9000000000 file /tmp/x level 0 mode -
  words: [a] [b]
  remaining: [plain]
  left 1: program
  group data destroyed (extra data)
parse: --loud -n Grace --count=-3 one -- --verbose two
  pre-parse (extra data)
  post-parse (extra data)
  ok 1
  verbose 0 quiet 0 name Grace count -3 ratio 0 big 0 file - level 0 mode -
  remaining: [one] [--verbose] [two]
  left 1: program
  group data destroyed (extra data)
parse: --level=4 --extra-mode fast --call value --flag --maybe --maybe=given
  pre-parse (extra data)
  callback --call = value (data extra data)
  callback --flag = (none) (data extra data)
  callback --maybe = (none) (data extra data)
  callback --maybe = given (data extra data)
  post-parse (extra data)
  ok 1
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 4 mode fast
  left 1: program
  group data destroyed (extra data)
parse: --count x12
  pre-parse (extra data)
  ok 0, error g-option-context-error-quark 1: Cannot parse integer value “x12” for --count
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  left 3: program --count x12
  group data destroyed (extra data)
parse: --count=99999999999
  pre-parse (extra data)
  ok 0, error g-option-context-error-quark 1: Integer value “99999999999” for --count out of range
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  left 2: program --count=99999999999
  group data destroyed (extra data)
parse: --ratio=pi
  pre-parse (extra data)
  ok 0, error g-option-context-error-quark 1: Cannot parse double value “pi” for --ratio
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  left 2: program --ratio=pi
  group data destroyed (extra data)
parse: --unknown -v
  pre-parse (extra data)
  ok 0, error g-option-context-error-quark 0: Unknown option --unknown
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  left 3: program --unknown -v
  group data destroyed (extra data)
parse: -z
  pre-parse (extra data)
  ok 0, error g-option-context-error-quark 0: Unknown option -z
  verbose 0 quiet 1 name - count -1 ratio 0 big 0 file - level 0 mode -
  left 2: program -z
