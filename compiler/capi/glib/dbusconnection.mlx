// ---------------------------------------------------------------------------
// Records

// A connection: a GObject and (24) this record.
const C_LOCK: usize = 0
const C_COND: usize = 4
const C_FD: usize = 8
const C_WAKE: usize = 12
const C_ADDRESS: usize = 16
const C_FLAGS: usize = 24
const C_EXIT: usize = 28
const C_GUID: usize = 32
const C_UNIQUE: usize = 40
const C_CLOSED: usize = 48
const C_SERIAL: usize = 52
const C_FDS: usize = 56
const C_STATE: usize = 60
const C_INIT_ERROR: usize = 64
const C_PENDING: usize = 72
const C_SIGNALS: usize = 96
const C_OBJECTS: usize = 120
const C_CONTEXT: usize = 144
const C_OBJECT: usize = 152
const C_FINALIZING: usize = 160
const C_WORKER: usize = 168
const C_IN: usize = 176
const C_IN_LENGTH: usize = 184
const C_IN_ROOM: usize = 192
const C_IN_FDS: usize = 200
const C_INIT_LOCK: usize = 224
const C_SIZE: usize = 232

// A message: a GObject and (24) this record.
const M_KIND: usize = 0
const M_FLAGS: usize = 4
const M_SERIAL: usize = 8
const M_REPLY_SERIAL: usize = 12
const M_PATH: usize = 16
const M_INTERFACE: usize = 24
const M_MEMBER: usize = 32
const M_ERROR_NAME: usize = 40
const M_DESTINATION: usize = 48
const M_SENDER: usize = 56
const M_SIGNATURE: usize = 64
const M_BODY: usize = 72
const M_FDLIST: usize = 80
const M_SIZE: usize = 88

// A method invocation: a GObject and (24) this record.
const I_SENDER: usize = 0
const I_PATH: usize = 8
const I_INTERFACE: usize = 16
const I_METHOD: usize = 24
const I_METHOD_INFO: usize = 32
const I_PROPERTY_INFO: usize = 40
const I_CONNECTION: usize = 48
const I_MESSAGE: usize = 56
const I_PARAMETERS: usize = 64
const I_DATA: usize = 72
const I_REGISTRATION: usize = 80
const I_SIZE: usize = 88

// A call waiting for its reply: references (0), the serial (4), whether
// it is asynchronous (8) and done (12), the reply (16) or error (24), the
// task (32), the timeout source (40), the cancellable (48) and its
// handler (56), the connection's record (64).
const P_REFS: usize = 0
const P_SERIAL: usize = 4
const P_ASYNC: usize = 8
const P_DONE: usize = 12
const P_REPLY: usize = 16
const P_ERROR: usize = 24
const P_TASK: usize = 32
const P_TIMEOUT: usize = 40
const P_CANCELLABLE: usize = 48
const P_HANDLER: usize = 56
const P_RECORD: usize = 64
const P_SIZE: usize = 72

// The signals of one match rule (GIO's SignalData): the rule (0), the
// sender (8), the sender to match (16: a unique name, the bus's, or ""),
// interface (24), member (32), path (40), arg0 (48), flags (56), the
// subscribers (64, words).
const D_RULE: usize = 0
const D_SENDER: usize = 8
const D_UNIQUE: usize = 16
const D_INTERFACE: usize = 24
const D_MEMBER: usize = 32
const D_PATH: usize = 40
const D_ARG0: usize = 48
const D_FLAGS: usize = 56
const D_SUBSCRIBERS: usize = 64
const D_SIZE: usize = 88

// A subscriber: its id (0), references (4), callback (8), data (16) and
// notify (24), context (32), whether it is still subscribed (40).
const S_ID: usize = 0
const S_REFS: usize = 4
const S_CALLBACK: usize = 8
const S_DATA: usize = 16
const S_NOTIFY: usize = 24
const S_CONTEXT: usize = 32
const S_ACTIVE: usize = 40
const S_SIZE: usize = 48

// A registered interface: its id (0), references (4), path (8), interface
// info (16), the vtable's three functions (24, 32, 40), data (48) and
// notify (56), context (64), whether it is still registered (72), whether
// there was a vtable (76).
const R_ID: usize = 0
const R_REFS: usize = 4
const R_PATH: usize = 8
const R_INFO: usize = 16
const R_METHOD: usize = 24
const R_GET: usize = 32
const R_SET: usize = 40
const R_DATA: usize = 48
const R_NOTIFY: usize = 56
const R_CONTEXT: usize = 64
const R_ACTIVE: usize = 72
const R_VTABLE: usize = 76
const R_SIZE: usize = 80

// Connection flags.
const AUTHENTICATION_CLIENT: u32 = 1
const MESSAGE_BUS_CONNECTION: u32 = 8

// Signal flags.
const NO_MATCH_RULE: u32 = 1
const MATCH_ARG0_NAMESPACE: u32 = 2
const MATCH_ARG0_PATH: u32 = 4

// Call flags.
const CALL_NO_AUTO_START: i32 = 1
const CALL_ALLOW_INTERACTIVE_AUTHORIZATION: i32 = 2

const DEFAULT_TIMEOUT: i32 = 25000
const G_MAXINT: i32 = 2147483647

const MethodCall = fn(usize, usize, usize, usize, usize, usize, usize, usize) -> void
const GetProperty = fn(usize, usize, usize, usize, usize, usize, usize) -> usize
const SetProperty = fn(usize, usize, usize, usize, usize, usize, usize, usize) -> i32
const SignalCallback = fn(usize, usize, usize, usize, usize, usize, usize) -> void
const Notify = fn(usize) -> void

var typesOnce: u64 = 0
var connectionType: usize = 0
var messageType: usize = 0
var invocationType: usize = 0
var flagsType: usize = 0
var closedSignal: u32 = 0
var nextSubscriber: u32 = 1
var nextRegistration: u32 = 1
var callTag: u8 = 0
var newTag: u8 = 0
var closeTag: u8 = 0

fn rec(object: usize) -> usize { return m.getWord(object + 24) }
fn wordsAt(address: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, address) } }
fn lock(r: usize) -> void { threads.lock(r + C_LOCK) }
fn unlock(r: usize) -> void { threads.unlock(r + C_LOCK) }

fn critical(function: []const u8, expression: []const u8) -> void {
    var t = m.text()
    m.pushText(&t, function)
    m.pushText(&t, ": assertion '")
    m.pushText(&t, expression)
    m.pushText(&t, "' failed")
    messages.log(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, t.address)
    m.dispose(&t)
}

fn warning(t: *m.Text) -> void {
    m.pushByte(t, 0)
    messages.log(m.literal("GLib-GIO"), messages.LEVEL_WARNING, t.*.address)
    m.dispose(t)
}

fn dupOrNull(text: usize) -> usize { return if text == 0 { 0 } else { m.dup(text) } }

fn sliceOf(text: usize) -> []const u8 {
    if text == 0 { return m.bytes(m.literal(""), 0) }
    return m.cSlice(text)
}

// An idle source of `context` calling `func` with `data`.
fn idle(context: usize, priority: i32, func: usize, data: usize, notify: usize) -> void {
    const source = g_idle_source_new()
    g_source_set_priority(source, priority)
    g_source_set_callback(source, func, data, notify)
    _ = g_source_attach(source, context)
    g_source_unref(source)
}

// ---------------------------------------------------------------------------
// Types

fn ensureTypes() -> void {
    if threads.onceEnter(@intFromPtr(&typesOnce)) {
        types.ensureInit()
        connectionType = ioerrors.defineType(types.T_OBJECT, "GDBusConnection", 144, @intFromPtr(__mlx_glib_dbus_connection_class_init), 32, @intFromPtr(__mlx_glib_dbus_connection_init), 0)
        const info = m.alloc(24)
        m.putWord(info, @intFromPtr(__mlx_glib_dbus_connection_initable_init))
        g_type_add_interface_static(connectionType, g_initable_get_type(), info)
        m.release(info)
        messageType = ioerrors.defineType(types.T_OBJECT, "GDBusMessage", 136, @intFromPtr(__mlx_glib_dbus_message_class_init), 32, @intFromPtr(__mlx_glib_dbus_message_init), 0)
        invocationType = ioerrors.defineType(types.T_OBJECT, "GDBusMethodInvocation", 136, @intFromPtr(__mlx_glib_dbus_invocation_class_init), 32, @intFromPtr(__mlx_glib_dbus_invocation_init), 0)
        threads.onceLeave(@intFromPtr(&typesOnce), 1)
    }
}

pub fn connectionGType() -> usize {
    ensureTypes()
    return connectionType
}

fn messageGType() -> usize {
    ensureTypes()
    return messageType
}

fn invocationGType() -> usize {
    ensureTypes()
    return invocationType
}

export fn g_dbus_connection_get_type() -> usize { return connectionGType() }
export fn g_dbus_message_get_type() -> usize { return messageGType() }
export fn g_dbus_method_invocation_get_type() -> usize { return invocationGType() }
export fn g_dbus_connection_flags_get_type() -> usize { return connectionFlags() }

// GDBusConnectionFlags as GIO's flags type.
fn connectionFlags() -> usize {
    if threads.onceEnter(@intFromPtr(&flagsType)) {
        const values = m.alloc(9 * 24)
        const valueNames = [8][]const u8{ "G_DBUS_CONNECTION_FLAGS_NONE", "G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT", "G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_SERVER", "G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_ALLOW_ANONYMOUS", "G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION", "G_DBUS_CONNECTION_FLAGS_DELAY_MESSAGE_PROCESSING", "G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_REQUIRE_SAME_USER", "G_DBUS_CONNECTION_FLAGS_CROSS_NAMESPACE" }
        const nicks = [8][]const u8{ "none", "authentication-client", "authentication-server", "authentication-allow-anonymous", "message-bus-connection", "delay-message-processing", "authentication-require-same-user", "cross-namespace" }
        var i: usize = 0
        while i < 8 {
            m.put32(values + i * 24, if i == 0 { 0 } else { @intCast(u32, 1) << @intCast(u5, i - 1) })
            m.putWord(values + i * 24 + 8, m.literal(valueNames[i]))
            m.putWord(values + i * 24 + 16, m.literal(nicks[i]))
            i += 1
        }
        const t = g_flags_register_static(m.literal("GDBusConnectionFlags"), values)
        threads.onceLeave(@intFromPtr(&flagsType), @intCast(u64, t))
    }
    return flagsType
}

pub fn isConnection(object: usize) -> bool { return object != 0 && g_type_check_instance_is_a(object, connectionGType()) != 0 }

const PROP_ADDRESS: u32 = 1
const PROP_FLAGS: u32 = 2
const PROP_EXIT_ON_CLOSE: u32 = 3
const PROP_GUID: u32 = 4
const PROP_UNIQUE_NAME: u32 = 5
const PROP_CLOSED: u32 = 6

export fn __mlx_glib_dbus_connection_init(conn: usize, class: usize) -> void {
    const r = m.alloc(C_SIZE)
    m.putI32(r + C_FD, -1)
    m.putI32(r + C_WAKE, -1)
    m.putWord(r + C_OBJECT, conn)
    m.putWord(r + C_CONTEXT, g_main_context_ref_thread_default())
    m.putWord(conn + 24, r)
}

export fn __mlx_glib_dbus_connection_set_property(conn: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = rec(conn)
    if id == PROP_ADDRESS {
        m.release(m.getWord(r + C_ADDRESS))
        m.putWord(r + C_ADDRESS, dupOrNull(g_value_get_string(value)))
    } else if id == PROP_FLAGS {
        m.put32(r + C_FLAGS, g_value_get_flags(value))
    } else if id == PROP_EXIT_ON_CLOSE {
        m.put32(r + C_EXIT, if g_value_get_boolean(value) != 0 { 1 } else { 0 })
    } else if id == PROP_GUID {
        m.release(m.getWord(r + C_GUID))
        m.putWord(r + C_GUID, dupOrNull(g_value_get_string(value)))
    }
}

export fn __mlx_glib_dbus_connection_get_property(conn: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = rec(conn)
    if id == PROP_FLAGS { g_value_set_flags(value, m.get32(r + C_FLAGS)) }
    if id == PROP_EXIT_ON_CLOSE { g_value_set_boolean(value, @bitCast(i32, m.get32(r + C_EXIT))) }
    if id == PROP_GUID { g_value_set_string(value, m.getWord(r + C_GUID)) }
    if id == PROP_UNIQUE_NAME { g_value_set_string(value, m.getWord(r + C_UNIQUE)) }
    if id == PROP_CLOSED { g_value_set_boolean(value, @bitCast(i32, @atomicLoad(u32, m.word32(r + C_CLOSED), acquire))) }
}

// The last reference going: from now on the worker hands the connection
// to no one (unless a reference was taken meanwhile).
export fn __mlx_glib_dbus_connection_dispose(conn: usize) -> void {
    const r = rec(conn)
    lock(r)
    if m.get32(conn + 8) <= 1 { m.put32(r + C_FINALIZING, 1) }
    unlock(r)
    ioerrors.chainUp(types.T_OBJECT, 40, conn)
}

export fn __mlx_glib_dbus_connection_finalize(conn: usize) -> void {
    const r = rec(conn)
    m.put32(r + C_FINALIZING, 1)
    stopWorker(r)
    if m.getWord(r + C_WORKER) != 0 { _ = g_thread_join(m.getWord(r + C_WORKER)) }
    // What is still subscribed or registered goes, with its notify.
    const subscriptions = wordsAt(r + C_SIGNALS)
    while subscriptions.*.length > 0 {
        const d = m.wordAt(subscriptions, subscriptions.*.length - 1)
        const subscribers = wordsAt(d + D_SUBSCRIBERS)
        while subscribers.*.length > 0 {
            subscribers.*.length -= 1
            const s = m.wordAt(subscribers, subscribers.*.length)
            m.put32(s + S_ACTIVE, 0)
            subscriberUnref(s)
        }
        subscriptions.*.length -= 1
        freeSignalData(d)
    }
    m.disposeWords(subscriptions)
    const objects = wordsAt(r + C_OBJECTS)
    var i: usize = 0
    while i < objects.*.length {
        const g = m.wordAt(objects, i)
        m.put32(g + R_ACTIVE, 0)
        registrationUnref(g)
        i += 1
    }
    m.disposeWords(objects)
    m.disposeWords(wordsAt(r + C_PENDING))
    const fds = wordsAt(r + C_IN_FDS)
    i = 0
    while i < fds.*.length {
        _ = sys.close(@intCast(i32, m.wordAt(fds, i)))
        i += 1
    }
    m.disposeWords(fds)
    if m.getI32(r + C_FD) >= 0 { _ = sys.close(m.getI32(r + C_FD)) }
    if m.getI32(r + C_WAKE) >= 0 { _ = sys.close(m.getI32(r + C_WAKE)) }
    m.release(m.getWord(r + C_IN))
    m.release(m.getWord(r + C_ADDRESS))
    m.release(m.getWord(r + C_GUID))
    m.release(m.getWord(r + C_UNIQUE))
    if m.getWord(r + C_INIT_ERROR) != 0 { errors.freeError(m.getWord(r + C_INIT_ERROR)) }
    g_main_context_unref(m.getWord(r + C_CONTEXT))
    m.release(r)
    ioerrors.chainUp(types.T_OBJECT, 48, conn)
}

// The class's "closed": with exit-on-close, the program ends when the
// other side went away (GIO's g_dbus_connection_real_closed).
export fn __mlx_glib_dbus_connection_real_closed(conn: usize, vanished: i32, e: usize) -> void {
    const r = rec(conn)
    if vanished != 0 && m.get32(r + C_EXIT) != 0 {
        var t = m.text()
        if e != 0 {
            m.pushText(&t, "g_dbus_connection_real_closed: Remote peer vanished with error: ")
            m.pushC(&t, errors.message(e))
            m.pushText(&t, " (")
            m.pushC(&t, errors.quarkString(errors.domainOf(e)))
            m.pushText(&t, ", ")
            m.pushSigned(&t, @intCast(i64, errors.code(e)))
            m.pushText(&t, "). Exiting.\n")
        } else {
            m.pushText(&t, "g_dbus_connection_real_closed: Remote peer vanished. Exiting.\n")
        }
        _ = sys.write(2, t.address, t.length)
        m.dispose(&t)
        _ = raise(15)
    }
}

export fn __mlx_glib_dbus_connection_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_glib_dbus_connection_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_dbus_connection_get_property))
    m.putWord(class + 40, @intFromPtr(__mlx_glib_dbus_connection_dispose))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_dbus_connection_finalize))
    m.putWord(class + 136, @intFromPtr(__mlx_glib_dbus_connection_real_closed))
    const constructOnly: i32 = 2 | 8 | 224
    g_object_class_install_property(class, PROP_ADDRESS, g_param_spec_string(m.literal("address"), m.literal("Address"), m.literal("D-Bus address specifying potential socket endpoints"), 0, constructOnly))
    g_object_class_install_property(class, PROP_FLAGS, g_param_spec_flags(m.literal("flags"), m.literal("Flags"), m.literal("Flags"), connectionFlags(), 0, constructOnly))
    g_object_class_install_property(class, PROP_EXIT_ON_CLOSE, g_param_spec_boolean(m.literal("exit-on-close"), m.literal("Exit on close"), m.literal("Whether the process is terminated when the connection is closed"), 0, 3 | 224))
    g_object_class_install_property(class, PROP_GUID, g_param_spec_string(m.literal("guid"), m.literal("GUID"), m.literal("GUID of the server peer"), 0, 3 | 8 | 224))
    g_object_class_install_property(class, PROP_UNIQUE_NAME, g_param_spec_string(m.literal("unique-name"), m.literal("unique-name"), m.literal("Unique name of bus connection"), 0, 1 | 224))
    g_object_class_install_property(class, PROP_CLOSED, g_param_spec_boolean(m.literal("closed"), m.literal("Closed"), m.literal("Whether the connection is closed"), 0, 1 | 224))
    const params = m.alloc(16)
    m.putWord(params, types.T_BOOLEAN)
    m.putWord(params + 8, g_error_get_type())
    closedSignal = signals.newSignal(m.literal("closed"), m.getWord(class), 2, closures.typeClosure(m.getWord(class), 136), 0, 0, 0, types.T_NONE, 2, params)
    m.release(params)
}

// Messages.

export fn __mlx_glib_dbus_message_init(message: usize, class: usize) -> void { m.putWord(message + 24, m.alloc(M_SIZE)) }

export fn __mlx_glib_dbus_message_finalize(message: usize) -> void {
    const r = rec(message)
    var at = M_PATH
    while at <= M_SIGNATURE {
        m.release(m.getWord(r + at))
        at += 8
    }
    variant.unref(m.getWord(r + M_BODY))
    if m.getWord(r + M_FDLIST) != 0 { g_object_unref(m.getWord(r + M_FDLIST)) }
    m.release(r)
    ioerrors.chainUp(types.T_OBJECT, 48, message)
}

export fn __mlx_glib_dbus_message_class_init(class: usize, data: usize) -> void { m.putWord(class + 48, @intFromPtr(__mlx_glib_dbus_message_finalize)) }

fn messageText(message: usize, at: usize) -> usize {
    if message == 0 { return 0 }
    return m.getWord(rec(message) + at)
}

export fn g_dbus_message_get_message_type(message: usize) -> i32 { return @bitCast(i32, m.get32(rec(message) + M_KIND)) }
export fn g_dbus_message_get_flags(message: usize) -> i32 { return @bitCast(i32, m.get32(rec(message) + M_FLAGS)) }
export fn g_dbus_message_get_serial(message: usize) -> u32 { return m.get32(rec(message) + M_SERIAL) }
export fn g_dbus_message_get_reply_serial(message: usize) -> u32 { return m.get32(rec(message) + M_REPLY_SERIAL) }
export fn g_dbus_message_get_path(message: usize) -> usize { return messageText(message, M_PATH) }
export fn g_dbus_message_get_interface(message: usize) -> usize { return messageText(message, M_INTERFACE) }
export fn g_dbus_message_get_member(message: usize) -> usize { return messageText(message, M_MEMBER) }
export fn g_dbus_message_get_error_name(message: usize) -> usize { return messageText(message, M_ERROR_NAME) }
export fn g_dbus_message_get_destination(message: usize) -> usize { return messageText(message, M_DESTINATION) }
export fn g_dbus_message_get_sender(message: usize) -> usize { return messageText(message, M_SENDER) }

// GIO gives "" for a message without a signature.
fn signatureOf(message: usize) -> usize {
    const s = messageText(message, M_SIGNATURE)
    return if s == 0 { m.literal("") } else { s }
}

export fn g_dbus_message_get_signature(message: usize) -> usize { return signatureOf(message) }

export fn g_dbus_message_get_body(message: usize) -> usize { return m.getWord(rec(message) + M_BODY) }
export fn g_dbus_message_get_unix_fd_list(message: usize) -> usize { return m.getWord(rec(message) + M_FDLIST) }
export fn g_dbus_message_get_num_unix_fds(message: usize) -> u32 {
    const list = m.getWord(rec(message) + M_FDLIST)
    return if list == 0 { 0 } else { @intCast(u32, fdlist.count(list)) }
}

// The body's first value when it is a string (or an object path for the
// path form).
fn firstText(message: usize, wanted: u8) -> usize {
    const body = m.getWord(rec(message) + M_BODY)
    if body == 0 || variant.childCount(body) == 0 || m.get8(variant.typeOf(body) + 1) != wanted { return 0 }
    const child = variant.childValue(body, 0)
    const text = variant.stringOf(child)
    // The text lives in the body's data, which the body keeps.
    variant.unref(child)
    return text
}

export fn g_dbus_message_get_arg0(message: usize) -> usize { return firstText(message, 's') }
export fn g_dbus_message_get_arg0_path(message: usize) -> usize { return firstText(message, 'o') }

// ---------------------------------------------------------------------------
// Writing messages

// Sends a message (the connection's lock held): its serial, 0 with `err`
// set when it could not go.
fn sendLocked(r: usize, kind: u8, flags: u8, destination: usize, path: usize, interface: usize, member: usize, errorName: usize, replySerial: u32, body: usize, list: usize, err: usize) -> u32 {
    if m.get32(r + C_CLOSED) != 0 {
        ioerrors.set(err, ioerrors.CLOSED, "The connection is closed")
        return 0
    }
    const fdCount = if list != 0 { fdlist.count(list) } else { 0 }
    if fdCount > 0 && m.get32(r + C_FDS) == 0 {
        ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Tried sending a file descriptor but remote peer does not support this capability")
        return 0
    }
    var payload = m.text()
    var signature = m.bytes(m.literal(""), 0)
    if body != 0 {
        const t = variant.typeOf(body)
        if marshal.hasMaybe(t) || !marshal.encodeBody(&payload, body) {
            m.dispose(&payload)
            var e = m.text()
            m.pushText(&e, "Cannot serialize a value of type “")
            m.pushC(&e, t)
            m.pushText(&e, "” on D-Bus")
            ioerrors.setText(err, ioerrors.INVALID_ARGUMENT, &e)
            return 0
        }
        signature = m.bytes(t + 1, m.cLength(t) - 2)
    }
    var serial = m.get32(r + C_SERIAL) +% 1
    if serial == 0 { serial = 1 }
    m.put32(r + C_SERIAL, serial)
    var header = dbus.newHeader(kind, serial)
    header.flags = flags
    header.destination = sliceOf(destination)
    header.path = sliceOf(path)
    header.interface = sliceOf(interface)
    header.member = sliceOf(member)
    header.errorName = sliceOf(errorName)
    if kind == dbus.METHOD_RETURN || kind == dbus.ERROR {
        header.replySerial = replySerial
        header.hasReplySerial = true
    }
    header.signature = signature
    header.bodyLength = payload.length
    header.unixFds = @intCast(u32, fdCount)
    const capacity = 256 + header.destination.length + header.path.length + header.interface.length + header.member.length + header.errorName.length + signature.length + payload.length
    const buffer = m.alloc(capacity)
    var writing: dbus.Writer = undefined
    const none = if payload.address == 0 { m.literal("") } else { payload.address }
    unsafe {
        dbus.begin(&writing, @ptrFromInt([*]u8, buffer), capacity, false)
        dbus.writeMessage(&writing, &header, m.bytes(m.literal(""), 0), @ptrFromInt([*]const u8, none))
    }
    m.dispose(&payload)
    const ok = !writing.failed && writeAll(r, buffer, writing.length, list, fdCount, err)
    m.release(buffer)
    return if ok { serial } else { 0 }
}

// Writes the whole message, the descriptors with its first bytes.
fn writeAll(r: usize, buffer: usize, length: usize, list: usize, fdCount: usize, err: usize) -> bool {
    var fds: [28]isize = undefined
    var i: usize = 0
    while i < fdCount && i < 28 {
        fds[i] = @intCast(isize, fdlist.peek(list, i))
        i += 1
    }
    var done: usize = 0
    var first = true
    while done < length {
        var sent: isize = 0
        unsafe { sent = std.linux.socket.sendWithDescriptors(@intCast(isize, m.getI32(r + C_FD)), @ptrFromInt([*]const u8, buffer + done), length - done, &fds, if first { fdCount } else { 0 }, 16384) }
        if sent < 0 {
            const errnum = @intCast(i32, -sent)
            var t = m.text()
            m.pushText(&t, "Error sending message: ")
            m.pushC(&t, errors.errnoText(errnum))
            ioerrors.setText(err, ioerrors.fromErrno(errnum), &t)
            return false
        }
        first = false
        done += @bitCast(usize, sent)
    }
    return true
}

// ---------------------------------------------------------------------------
// Reading messages

// Reads what the socket has (blocking until something comes): false when
// it ended or failed (`errnum` then 0 at the end).
fn receiveSome(r: usize, errnum: *i32) -> bool {
    var room = m.getWord(r + C_IN_ROOM)
    var length = m.getWord(r + C_IN_LENGTH)
    if room - length < 4096 {
        room = if room == 0 { 65536 } else { room * 2 }
        m.putWord(r + C_IN, m.grow(m.getWord(r + C_IN), room))
        m.putWord(r + C_IN_ROOM, room)
    }
    var fds: [28]isize = undefined
    var count: usize = 0
    var got: isize = 0
    unsafe { got = std.linux.socket.receiveWithDescriptors(@intCast(isize, m.getI32(r + C_FD)), @ptrFromInt([*]u8, m.getWord(r + C_IN) + length), room - length, &fds, 28, &count, 1073741824) }
    var i: usize = 0
    while i < count {
        m.pushWord(wordsAt(r + C_IN_FDS), @bitCast(usize, fds[i]))
        i += 1
    }
    if got <= 0 {
        errnum.* = if got == 0 { 0 } else { @intCast(i32, -got) }
        return false
    }
    m.putWord(r + C_IN_LENGTH, length + @bitCast(usize, got))
    return true
}

// The size of the message at `offset` in the input when it is all there,
// 0 when more must come, the input's length + 1 when it is not a message.
fn bufferedMessage(r: usize, offset: usize) -> usize {
    const available = m.getWord(r + C_IN_LENGTH) - offset
    var size: usize = 0
    unsafe { size = dbus.messageSize(@ptrFromInt([*]const u8, m.getWord(r + C_IN) + offset), available) }
    if size == 0 || size > available {
        if size > 134217728 + 65536 { return m.getWord(r + C_IN_LENGTH) + 1 }
        return 0
    }
    return size
}

// Drops `size` bytes at `offset` of the input.
fn dropInput(r: usize, offset: usize, size: usize) -> void {
    const input = m.getWord(r + C_IN)
    const length = m.getWord(r + C_IN_LENGTH)
    m.copy(input + offset, input + offset + size, length - offset - size)
    m.putWord(r + C_IN_LENGTH, length - size)
}

// A message object of the `size` bytes at `offset` of the input, taking
// as many received descriptors as it says it carries; 0 when it is not a
// proper message.
fn parseMessage(r: usize, offset: usize, size: usize) -> usize {
    var header: dbus.Header = undefined
    const bytes = m.getWord(r + C_IN) + offset
    var good = false
    unsafe { good = dbus.parseHeader(@ptrFromInt([*]const u8, bytes), size, &header) }
    if !good { return 0 }
    const signature = m.dupBytes(@intFromPtr(header.signature.pointer), header.signature.length)
    var body: usize = 0
    if header.bodyLength > 0 || header.signature.length > 0 {
        body = marshal.decodeBody(bytes + header.bodyStart, header.bodyLength, header.big, signature)
        if body == 0 {
            m.release(signature)
            return 0
        }
    }
    const message = g_object_new(messageGType(), 0)
    const mr = rec(message)
    m.put32(mr + M_KIND, @intCast(u32, header.kind))
    m.put32(mr + M_FLAGS, @intCast(u32, header.flags))
    m.put32(mr + M_SERIAL, header.serial)
    m.put32(mr + M_REPLY_SERIAL, header.replySerial)
    m.putWord(mr + M_PATH, sliceCopy(header.path))
    m.putWord(mr + M_INTERFACE, sliceCopy(header.interface))
    m.putWord(mr + M_MEMBER, sliceCopy(header.member))
    m.putWord(mr + M_ERROR_NAME, sliceCopy(header.errorName))
    m.putWord(mr + M_DESTINATION, sliceCopy(header.destination))
    m.putWord(mr + M_SENDER, sliceCopy(header.sender))
    if header.signature.length > 0 {
        m.putWord(mr + M_SIGNATURE, signature)
    } else {
        m.release(signature)
    }
    m.putWord(mr + M_BODY, body)
    const wanted = @intCast(usize, header.unixFds)
    if wanted > 0 {
        const fds = wordsAt(r + C_IN_FDS)
        if fds.*.length < wanted {
            g_object_unref(message)
            return 0
        }
        const list = fdlist.newList()
        var i: usize = 0
        while i < wanted {
            _ = fdlist.adopt(list, @intCast(i32, m.wordAt(fds, i)))
            i += 1
        }
        m.copy(fds.*.address, fds.*.address + wanted * 8, (fds.*.length - wanted) * 8)
        fds.*.length -= wanted
        m.putWord(mr + M_FDLIST, list)
    }
    return message
}

fn sliceCopy(text: []const u8) -> usize {
    if text.length == 0 { return 0 }
    return m.dupBytes(@intFromPtr(text.pointer), text.length)
}

// ---------------------------------------------------------------------------
// The worker

const Dispatch = fn(usize, usize) -> void

fn stopWorker(r: usize) -> void {
    const wake = m.getI32(r + C_WAKE)
    if wake >= 0 {
        var one: u64 = 1
        _ = sys.write(wake, @intFromPtr(&one), 8)
    }
}

// Reads and dispatches until the connection is closed here (its wake
// descriptor) or there (the end of the socket).
export fn __mlx_glib_dbus_worker(r: usize) -> usize {
    const polls = m.alloc(16)
    var vanished = false
    var errnum: i32 = 0
    var running = true
    while running {
        // Each complete message, in order (an export of its own each, so
        // that what it makes on the way is given back when it returns).
        const dispatch: Dispatch = unsafe { @ptrFromInt(Dispatch, @intFromPtr(__mlx_glib_dbus_dispatch)) }
        var offset: usize = 0
        var size = bufferedMessage(r, 0)
        while size != 0 && running {
            if size > m.getWord(r + C_IN_LENGTH) {
                vanished = true
                running = false
                errnum = 71
            } else {
                const message = parseMessage(r, offset, size)
                offset += size
                if message == 0 {
                    vanished = true
                    running = false
                    errnum = 71
                } else {
                    if @atomicLoad(u32, m.word32(r + C_CLOSED), acquire) == 0 { dispatch(r, message) }
                    g_object_unref(message)
                    size = bufferedMessage(r, offset)
                }
            }
        }
        if offset > 0 { dropInput(r, 0, offset) }
        if running {
            m.putI32(polls, m.getI32(r + C_FD))
            m.put16(polls + 4, 1)
            m.put16(polls + 6, 0)
            m.putI32(polls + 8, m.getI32(r + C_WAKE))
            m.put16(polls + 12, 1)
            m.put16(polls + 14, 0)
            const ready = sys.poll(polls, 2, -1)
            if ready < 0 && sys.errno() != 4 { running = false }
            if (m.get16(polls + 14) & 0xffff) != 0 || @atomicLoad(u32, m.word32(r + C_CLOSED), acquire) != 0 {
                running = false
            } else if (m.get16(polls + 6) & 0xffff) != 0 {
                if !receiveSome(r, &errnum) {
                    if errnum != 4 && errnum != 11 {
                        vanished = true
                        running = false
                    }
                }
            }
        }
    }
    m.release(polls)
    if vanished {
        var e: usize = 0
        if errnum == 0 {
            e = errors.errorOf(ioerrors.quark(), ioerrors.FAILED, "Underlying GIOStream returned 0 bytes on an async read")
        } else {
            var t = m.text()
            m.pushText(&t, "Error while reading: ")
            m.pushC(&t, errors.errnoText(errnum))
            e = errors.newError(ioerrors.quark(), ioerrors.fromErrno(errnum), m.finish(&t))
        }
        closeConnection(r, true, e)
    }
    return 0
}

// One message from the worker.
export fn __mlx_glib_dbus_dispatch(r: usize, message: usize) -> void {
    const mr = rec(message)
    const kind = @intCast(u8, m.get32(mr + M_KIND) & 0xff)
    if kind == dbus.METHOD_RETURN || kind == dbus.ERROR {
        lock(r)
        const p = takeBySerial(r, m.get32(mr + M_REPLY_SERIAL))
        unlock(r)
        if p != 0 { complete(p, g_object_ref(message), 0) }
    } else if kind == dbus.SIGNAL {
        lock(r)
        distributeSignal(r, message)
        unlock(r)
    } else if kind == dbus.METHOD_CALL {
        lock(r)
        distributeMethodCall(r, message)
        unlock(r)
    }
}

// The connection ends: no more messages, the waiting calls fail, and
// "closed" is emitted in the context the connection was made in. `e`
// (taken over) says why, `vanished` whether the other side went away.
fn closeConnection(r: usize, vanished: bool, e: usize) -> void {
    lock(r)
    if m.get32(r + C_CLOSED) != 0 {
        unlock(r)
        if e != 0 { errors.freeError(e) }
        return
    }
    @atomicStore(u32, m.word32(r + C_CLOSED), 1, release)
    var taken = m.words()
    const pending = wordsAt(r + C_PENDING)
    var i: usize = 0
    while i < pending.*.length {
        m.pushWord(&taken, m.wordAt(pending, i))
        i += 1
    }
    pending.*.length = 0
    var conn: usize = 0
    if m.get32(r + C_FINALIZING) == 0 { conn = g_object_ref(m.getWord(r + C_OBJECT)) }
    unlock(r)
    i = 0
    while i < taken.length {
        complete(m.wordAt(&taken, i), 0, errors.errorOf(ioerrors.quark(), ioerrors.CLOSED, "The connection is closed"))
        i += 1
    }
    m.disposeWords(&taken)
    if conn != 0 {
        const data = m.alloc(24)
        m.putWord(data, conn)
        m.putWord(data + 8, if vanished { 1 } else { 0 })
        m.putWord(data + 16, e)
        idle(m.getWord(r + C_CONTEXT), 0, @intFromPtr(__mlx_glib_dbus_emit_closed), data, @intFromPtr(__mlx_glib_dbus_closed_free))
    } else if e != 0 {
        errors.freeError(e)
    }
}

export fn __mlx_glib_dbus_emit_closed(data: usize) -> i32 {
    g_signal_emit(m.getWord(data), closedSignal, 0, m.getWord(data + 8), m.getWord(data + 16))
    return 0
}

export fn __mlx_glib_dbus_closed_free(data: usize) -> void {
    g_object_unref(m.getWord(data))
    if m.getWord(data + 16) != 0 { errors.freeError(m.getWord(data + 16)) }
    m.release(data)
}

// ---------------------------------------------------------------------------
// Calls

fn pendingUnref(p: usize) -> void {
    if !threads.refDec(p + P_REFS) { return }
    if m.getWord(p + P_REPLY) != 0 { g_object_unref(m.getWord(p + P_REPLY)) }
    if m.getWord(p + P_ERROR) != 0 { errors.freeError(m.getWord(p + P_ERROR)) }
    m.release(p)
}

export fn __mlx_glib_dbus_pending_unref(p: usize) -> void { pendingUnref(p) }

// Takes the pending call `p` out of the list (the lock held): whether it
// was there.
fn takePending(r: usize, p: usize) -> bool {
    const pending = wordsAt(r + C_PENDING)
    var i: usize = 0
    while i < pending.*.length {
        if m.wordAt(pending, i) == p {
            m.putWord(pending.*.address + i * 8, m.wordAt(pending, pending.*.length - 1))
            pending.*.length -= 1
            return true
        }
        i += 1
    }
    return false
}

fn takeBySerial(r: usize, serial: u32) -> usize {
    const pending = wordsAt(r + C_PENDING)
    var i: usize = 0
    while i < pending.*.length {
        const p = m.wordAt(pending, i)
        if m.get32(p + P_SERIAL) == serial {
            m.putWord(pending.*.address + i * 8, m.wordAt(pending, pending.*.length - 1))
            pending.*.length -= 1
            return p
        }
        i += 1
    }
    return 0
}

// A call taken out of the list ends: with the reply message (a
// reference) or the error (taken over).
fn complete(p: usize, reply: usize, e: usize) -> void {
    const r = m.getWord(p + P_RECORD)
    if m.get32(p + P_ASYNC) == 0 {
        lock(r)
        m.putWord(p + P_REPLY, reply)
        m.putWord(p + P_ERROR, e)
        m.put32(p + P_DONE, 1)
        threads.broadcast(r + C_COND)
        unlock(r)
        return
    }
    const timeout = m.getWord(p + P_TIMEOUT)
    if timeout != 0 {
        g_source_destroy(timeout)
        g_source_unref(timeout)
        m.putWord(p + P_TIMEOUT, 0)
    }
    if m.getWord(p + P_HANDLER) != 0 {
        g_cancellable_disconnect(m.getWord(p + P_CANCELLABLE), @intCast(u64, m.getWord(p + P_HANDLER)))
        m.putWord(p + P_HANDLER, 0)
    }
    const task = m.getWord(p + P_TASK)
    if reply != 0 {
        g_task_return_pointer(task, reply, @intFromPtr(g_object_unref))
    } else {
        g_task_return_error(task, e)
    }
    g_object_unref(task)
    pendingUnref(p)
}

export fn __mlx_glib_dbus_call_timeout(p: usize) -> i32 {
    const r = m.getWord(p + P_RECORD)
    lock(r)
    const taken = takePending(r, p)
    unlock(r)
    if taken {
        // The source is the one running: complete leaves it be.
        g_source_unref(m.getWord(p + P_TIMEOUT))
        m.putWord(p + P_TIMEOUT, 0)
        complete(p, 0, errors.errorOf(ioerrors.quark(), ioerrors.TIMED_OUT, "Timeout was reached"))
    }
    return 0
}

export fn __mlx_glib_dbus_call_cancelled(c: usize, p: usize) -> void {
    const r = m.getWord(p + P_RECORD)
    lock(r)
    const taken = takePending(r, p)
    unlock(r)
    if taken {
        m.putWord(p + P_HANDLER, 0)
        complete(p, 0, errors.errorOf(ioerrors.quark(), ioerrors.CANCELLED, "Operation was cancelled"))
    }
}

fn messageFlags(flags: i32) -> u8 {
    var result: u8 = 0
    if (flags & CALL_NO_AUTO_START) != 0 { result = result | dbus.NO_AUTO_START }
    if (flags & CALL_ALLOW_INTERACTIVE_AUTHORIZATION) != 0 { result = result | 4 }
    return result
}

// GIO's checks of a call's arguments: false (after a critical) when one
// fails.
fn checkCall(function: []const u8, connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, timeout: i32) -> bool {
    if !isConnection(connection) {
        critical(function, "G_IS_DBUS_CONNECTION (connection)")
        return false
    }
    if bus_name != 0 && !names.isName(bus_name) {
        critical(function, "bus_name == NULL || g_dbus_is_name (bus_name)")
        return false
    }
    if object_path == 0 || !variant.isObjectPath(object_path) {
        critical(function, "object_path != NULL && g_variant_is_object_path (object_path)")
        return false
    }
    if interface_name != 0 && !names.isInterfaceName(interface_name) {
        critical(function, "interface_name == NULL || g_dbus_is_interface_name (interface_name)")
        return false
    }
    if method_name == 0 || !names.isMemberName(method_name) {
        critical(function, "method_name != NULL && g_dbus_is_member_name (method_name)")
        return false
    }
    if timeout < -1 {
        critical(function, "timeout_msec >= 0 || timeout_msec == -1")
        return false
    }
    if parameters != 0 && m.get8(variant.typeOf(parameters)) != '(' {
        critical(function, "(parameters == NULL) || g_variant_is_of_type (parameters, G_VARIANT_TYPE_TUPLE)")
        return false
    }
    return true
}

// GIO's decode_method_reply: the body (a reference; "()" for none) of a
// return of the expected type, else the error.
fn decodeReply(reply: usize, method: usize, replyType: usize, fdOut: usize, err: usize) -> usize {
    const mr = rec(reply)
    if m.get32(mr + M_KIND) == @intCast(u32, dbus.ERROR) {
        errors.report(err, errorOfReply(reply))
        return 0
    }
    var result = m.getWord(mr + M_BODY)
    if result == 0 {
        result = variant.refSink(variant.newTuple(0, 0))
    } else {
        result = variant.ref(result)
    }
    const expected = if replyType != 0 { replyType } else { m.literal("r") }
    if !variant.isSubtype(variant.typeOf(result), expected) {
        var t = m.text()
        m.pushText(&t, "Method “")
        m.pushC(&t, method)
        m.pushText(&t, "” returned type “")
        m.pushC(&t, variant.typeOf(result))
        m.pushText(&t, "”, but expected “")
        m.pushBytes(&t, expected, variant.typeEnd(expected) - expected)
        m.pushText(&t, "”")
        ioerrors.setText(err, ioerrors.INVALID_ARGUMENT, &t)
        variant.unref(result)
        return 0
    }
    if fdOut != 0 {
        const list = m.getWord(mr + M_FDLIST)
        m.putWord(fdOut, if list != 0 { g_object_ref(list) } else { 0 })
    }
    return result
}

// GIO's g_dbus_message_to_gerror.
fn errorOfReply(reply: usize) -> usize {
    const mr = rec(reply)
    const name = m.getWord(mr + M_ERROR_NAME)
    if name == 0 { return errors.errorOf(ioerrors.quark(), ioerrors.FAILED, "Error return without error-name header!") }
    const body = m.getWord(mr + M_BODY)
    if body != 0 && m.cIs(variant.typeOf(body), "(s)") {
        const child = variant.childValue(body, 0)
        const e = names.errorFor(name, variant.stringOf(child))
        variant.unref(child)
        return e
    }
    // GIO's g_dbus_error_set_dbus_error with a format: its text, ": "
    // and the (empty) message.
    var t = m.text()
    if body != 0 {
        m.pushText(&t, "Error return with body of type “")
        m.pushC(&t, variant.typeOf(body))
        m.pushText(&t, "”: ")
    } else {
        m.pushText(&t, "Error return with empty body: ")
    }
    m.pushByte(&t, 0)
    const e = names.errorFor(name, t.address)
    m.dispose(&t)
    return e
}

// A synchronous call: the reply message (a reference), 0 with `err` set.
fn callSync(r: usize, destination: usize, path: usize, interface: usize, method: usize, parameters: usize, flags: i32, timeout: i32, list: usize, c: usize, err: usize) -> usize {
    const body = if parameters != 0 { variant.refSink(parameters) } else { 0 }
    if cancellable.setErrorIfCancelled(c, err) {
        variant.unref(body)
        return 0
    }
    const p = m.alloc(P_SIZE)
    m.put32(p + P_REFS, 1)
    m.putWord(p + P_RECORD, r)
    lock(r)
    const serial = sendLocked(r, dbus.METHOD_CALL, messageFlags(flags), destination, path, interface, method, 0, 0, body, list, err)
    variant.unref(body)
    if serial == 0 {
        unlock(r)
        pendingUnref(p)
        return 0
    }
    m.put32(p + P_SERIAL, serial)
    m.pushWord(wordsAt(r + C_PENDING), p)
    var handler: u64 = 0
    if c != 0 {
        // (The handler runs under the lock's protection of the list.)
        unlock(r)
        threads.refInc(p + P_REFS)
        handler = g_cancellable_connect(c, @intFromPtr(__mlx_glib_dbus_sync_cancelled), p, @intFromPtr(__mlx_glib_dbus_pending_unref))
        lock(r)
    }
    const wait = if timeout == -1 { DEFAULT_TIMEOUT } else { timeout }
    const deadline = g_get_monotonic_time() + @intCast(i64, wait) * 1000
    while m.get32(p + P_DONE) == 0 {
        if wait == G_MAXINT {
            g_cond_wait(r + C_COND, r + C_LOCK)
        } else if g_cond_wait_until(r + C_COND, r + C_LOCK, deadline) == 0 && m.get32(p + P_DONE) == 0 && g_get_monotonic_time() >= deadline {
            if takePending(r, p) {
                m.putWord(p + P_ERROR, errors.errorOf(ioerrors.quark(), ioerrors.TIMED_OUT, "Timeout was reached"))
                m.put32(p + P_DONE, 1)
            }
        }
    }
    unlock(r)
    if handler != 0 { g_cancellable_disconnect(c, handler) }
    const reply = m.getWord(p + P_REPLY)
    m.putWord(p + P_REPLY, 0)
    if reply == 0 {
        errors.report(err, m.getWord(p + P_ERROR))
        m.putWord(p + P_ERROR, 0)
    }
    pendingUnref(p)
    return reply
}

export fn __mlx_glib_dbus_sync_cancelled(c: usize, p: usize) -> void {
    const r = m.getWord(p + P_RECORD)
    lock(r)
    if takePending(r, p) {
        m.putWord(p + P_ERROR, errors.errorOf(ioerrors.quark(), ioerrors.CANCELLED, "Operation was cancelled"))
        m.put32(p + P_DONE, 1)
        threads.broadcast(r + C_COND)
    }
    unlock(r)
}

// What an asynchronous call's finish needs: the method's name (0) and the
// reply type expected (8, or 0).
export fn __mlx_glib_dbus_call_data_free(d: usize) -> void {
    m.release(m.getWord(d))
    m.release(m.getWord(d + 8))
    m.release(d)
}

fn callAsync(conn: usize, destination: usize, path: usize, interface: usize, method: usize, parameters: usize, replyType: usize, flags: i32, timeout: i32, list: usize, c: usize, callback: usize, data: usize) -> void {
    const r = rec(conn)
    const body = if parameters != 0 { variant.refSink(parameters) } else { 0 }
    if callback == 0 {
        // No one waits: the message says so.
        lock(r)
        _ = sendLocked(r, dbus.METHOD_CALL, messageFlags(flags) | dbus.NO_REPLY_EXPECTED, destination, path, interface, method, 0, 0, body, list, 0)
        unlock(r)
        variant.unref(body)
        return
    }
    const task = g_task_new(conn, c, callback, data)
    g_task_set_source_tag(task, @intFromPtr(&callTag))
    const d = m.alloc(16)
    m.putWord(d, m.dup(method))
    m.putWord(d + 8, if replyType != 0 { variant.dupType(replyType) } else { 0 })
    g_task_set_task_data(task, d, @intFromPtr(__mlx_glib_dbus_call_data_free))
    const cell = m.alloc(8)
    if cancellable.setErrorIfCancelled(c, cell) {
        g_task_return_error(task, m.getWord(cell))
        m.release(cell)
        g_object_unref(task)
        variant.unref(body)
        return
    }
    const p = m.alloc(P_SIZE)
    m.put32(p + P_REFS, 1)
    m.put32(p + P_ASYNC, 1)
    m.putWord(p + P_TASK, task)
    m.putWord(p + P_RECORD, r)
    m.putWord(p + P_CANCELLABLE, c)
    lock(r)
    const serial = sendLocked(r, dbus.METHOD_CALL, messageFlags(flags), destination, path, interface, method, 0, 0, body, list, cell)
    variant.unref(body)
    if serial == 0 {
        unlock(r)
        g_task_return_error(task, m.getWord(cell))
        m.release(cell)
        g_object_unref(task)
        pendingUnref(p)
        return
    }
    m.release(cell)
    m.put32(p + P_SERIAL, serial)
    // Its timeout, in the task's context.
    const wait = if timeout == -1 { DEFAULT_TIMEOUT } else { timeout }
    if wait != G_MAXINT {
        const source = g_timeout_source_new(@intCast(u32, wait))
        threads.refInc(p + P_REFS)
        g_source_set_callback(source, @intFromPtr(__mlx_glib_dbus_call_timeout), p, @intFromPtr(__mlx_glib_dbus_pending_unref))
        _ = g_source_attach(source, g_task_get_context(task))
        m.putWord(p + P_TIMEOUT, source)
    }
    m.pushWord(wordsAt(r + C_PENDING), p)
    unlock(r)
    if c != 0 {
        threads.refInc(p + P_REFS)
        threads.refInc(p + P_REFS)
        const handler = g_cancellable_connect(c, @intFromPtr(__mlx_glib_dbus_call_cancelled), p, @intFromPtr(__mlx_glib_dbus_pending_unref))
        lock(r)
        const still = m.get32(p + P_DONE) == 0 && isPending(r, p)
        if still { m.putWord(p + P_HANDLER, @intCast(usize, handler)) }
        unlock(r)
        if !still && handler != 0 { g_cancellable_disconnect(c, handler) }
        pendingUnref(p)
    }
}

fn isPending(r: usize, p: usize) -> bool {
    const pending = wordsAt(r + C_PENDING)
    var i: usize = 0
    while i < pending.*.length {
        if m.wordAt(pending, i) == p { return true }
        i += 1
    }
    return false
}

fn callFinish(conn: usize, res: usize, fdOut: usize, err: usize) -> usize {
    const d = g_task_get_task_data(res)
    const reply = g_task_propagate_pointer(res, err)
    if reply == 0 { return 0 }
    const result = decodeReply(reply, m.getWord(d), m.getWord(d + 8), fdOut, err)
    g_object_unref(reply)
    return result
}

export fn g_dbus_connection_call(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout_msec: i32, c: usize, callback: usize, user_data: usize) -> void {
    if !checkCall("g_dbus_connection_call_internal", connection, bus_name, object_path, interface_name, method_name, parameters, timeout_msec) { return }
    callAsync(connection, bus_name, object_path, interface_name, method_name, parameters, reply_type, flags, timeout_msec, 0, c, callback, user_data)
}

export fn g_dbus_connection_call_finish(connection: usize, res: usize, err: usize) -> usize { return callFinish(connection, res, 0, err) }

export fn g_dbus_connection_call_with_unix_fd_list(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout_msec: i32, fd_list: usize, c: usize, callback: usize, user_data: usize) -> void {
    if !checkCall("g_dbus_connection_call_internal", connection, bus_name, object_path, interface_name, method_name, parameters, timeout_msec) { return }
    callAsync(connection, bus_name, object_path, interface_name, method_name, parameters, reply_type, flags, timeout_msec, fd_list, c, callback, user_data)
}

export fn g_dbus_connection_call_with_unix_fd_list_finish(connection: usize, out_fd_list: usize, res: usize, err: usize) -> usize { return callFinish(connection, res, out_fd_list, err) }

fn syncCall(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout_msec: i32, fd_list: usize, out_fd_list: usize, c: usize, err: usize) -> usize {
    if !checkCall("g_dbus_connection_call_sync_internal", connection, bus_name, object_path, interface_name, method_name, parameters, timeout_msec) { return 0 }
    const reply = callSync(rec(connection), bus_name, object_path, interface_name, method_name, parameters, flags, timeout_msec, fd_list, c, err)
    if reply == 0 { return 0 }
    const result = decodeReply(reply, method_name, reply_type, out_fd_list, err)
    g_object_unref(reply)
    return result
}

export fn g_dbus_connection_call_sync(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout_msec: i32, c: usize, err: usize) -> usize {
    return syncCall(connection, bus_name, object_path, interface_name, method_name, parameters, reply_type, flags, timeout_msec, 0, 0, c, err)
}

export fn g_dbus_connection_call_with_unix_fd_list_sync(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout_msec: i32, fd_list: usize, out_fd_list: usize, c: usize, err: usize) -> usize {
    return syncCall(connection, bus_name, object_path, interface_name, method_name, parameters, reply_type, flags, timeout_msec, fd_list, out_fd_list, c, err)
}

// ---------------------------------------------------------------------------
// Signals

export fn g_dbus_connection_emit_signal(connection: usize, destination_bus_name: usize, object_path: usize, interface_name: usize, signal_name: usize, parameters: usize, err: usize) -> i32 {
    if !isConnection(connection) {
        critical("g_dbus_connection_emit_signal", "G_IS_DBUS_CONNECTION (connection)")
        return 0
    }
    if destination_bus_name != 0 && !names.isName(destination_bus_name) {
        critical("g_dbus_connection_emit_signal", "destination_bus_name == NULL || g_dbus_is_name (destination_bus_name)")
        return 0
    }
    if object_path == 0 || !variant.isObjectPath(object_path) {
        critical("g_dbus_connection_emit_signal", "object_path != NULL && g_variant_is_object_path (object_path)")
        return 0
    }
    if interface_name == 0 || !names.isInterfaceName(interface_name) {
        critical("g_dbus_connection_emit_signal", "interface_name != NULL && g_dbus_is_interface_name (interface_name)")
        return 0
    }
    if signal_name == 0 || !names.isMemberName(signal_name) {
        critical("g_dbus_connection_emit_signal", "signal_name != NULL && g_dbus_is_member_name (signal_name)")
        return 0
    }
    if parameters != 0 && m.get8(variant.typeOf(parameters)) != '(' {
        critical("g_dbus_connection_emit_signal", "parameters == NULL || g_variant_is_of_type (parameters, G_VARIANT_TYPE_TUPLE)")
        return 0
    }
    const r = rec(connection)
    const body = if parameters != 0 { variant.refSink(parameters) } else { 0 }
    lock(r)
    const serial = sendLocked(r, dbus.SIGNAL, 0, destination_bus_name, object_path, interface_name, signal_name, 0, 0, body, 0, err)
    unlock(r)
    variant.unref(body)
    return if serial != 0 { 1 } else { 0 }
}

// GIO's args_to_rule.
fn ruleOf(sender: usize, interface: usize, member: usize, path: usize, arg0: usize, flags: u32) -> usize {
    var t = m.text()
    if (flags & NO_MATCH_RULE) != 0 { m.pushByte(&t, '-') }
    m.pushText(&t, "type='signal'")
    if sender != 0 {
        m.pushText(&t, ",sender='")
        m.pushC(&t, sender)
        m.pushByte(&t, 39)
    }
    if interface != 0 {
        m.pushText(&t, ",interface='")
        m.pushC(&t, interface)
        m.pushByte(&t, 39)
    }
    if member != 0 {
        m.pushText(&t, ",member='")
        m.pushC(&t, member)
        m.pushByte(&t, 39)
    }
    if path != 0 {
        m.pushText(&t, ",path='")
        m.pushC(&t, path)
        m.pushByte(&t, 39)
    }
    if arg0 != 0 {
        if (flags & MATCH_ARG0_PATH) != 0 {
            m.pushText(&t, ",arg0path='")
        } else if (flags & MATCH_ARG0_NAMESPACE) != 0 {
            m.pushText(&t, ",arg0namespace='")
        } else {
            m.pushText(&t, ",arg0='")
        }
        m.pushC(&t, arg0)
        m.pushByte(&t, 39)
    }
    return m.finish(&t)
}

// Whether the bus is told of the rule: on a bus, unless the rule is
// NO_MATCH_RULE's or watches the bus's own NameLost or NameAcquired
// (which it sends to us anyway).
fn needsMatchRule(r: usize, d: usize) -> bool {
    if (m.get32(r + C_FLAGS) & MESSAGE_BUS_CONNECTION) == 0 { return false }
    if m.get8(m.getWord(d + D_RULE)) == '-' { return false }
    const sender = m.getWord(d + D_SENDER)
    const interface = m.getWord(d + D_INTERFACE)
    const member = m.getWord(d + D_MEMBER)
    const path = m.getWord(d + D_PATH)
    const ownSignal = sender != 0 && m.cIs(sender, "org.freedesktop.DBus") && interface != 0 && m.cIs(interface, "org.freedesktop.DBus") && path != 0 && m.cIs(path, "/org/freedesktop/DBus") && member != 0 && (m.cIs(member, "NameLost") || m.cIs(member, "NameAcquired"))
    return !ownSignal
}

fn busCall(r: usize, member: []const u8, rule: usize) -> void {
    const args = m.alloc(8)
    m.putWord(args, variant.newString(rule))
    const body = variant.refSink(variant.newTuple(args, 1))
    m.release(args)
    _ = sendLocked(r, dbus.METHOD_CALL, dbus.NO_REPLY_EXPECTED, m.literal("org.freedesktop.DBus"), m.literal("/org/freedesktop/DBus"), m.literal("org.freedesktop.DBus"), m.literal(member), 0, 0, body, 0, 0)
    variant.unref(body)
}

fn freeSignalData(d: usize) -> void {
    var at = D_RULE
    while at <= D_ARG0 {
        m.release(m.getWord(d + at))
        at += 8
    }
    m.disposeWords(wordsAt(d + D_SUBSCRIBERS))
    m.release(d)
}

fn subscriberUnref(s: usize) -> void {
    if !threads.refDec(s + S_REFS) { return }
    if m.getWord(s + S_NOTIFY) != 0 {
        const data = m.alloc(16)
        m.putWord(data, m.getWord(s + S_NOTIFY))
        m.putWord(data + 8, m.getWord(s + S_DATA))
        idle(m.getWord(s + S_CONTEXT), 0, @intFromPtr(__mlx_glib_dbus_call_notify), data, @intFromPtr(__mlx_glib_dbus_free_record))
    }
    g_main_context_unref(m.getWord(s + S_CONTEXT))
    m.release(s)
}

// GIO's call_destroy_notify: a notify run from an idle source.
export fn __mlx_glib_dbus_call_notify(data: usize) -> i32 {
    const notify: Notify = unsafe { @ptrFromInt(Notify, m.getWord(data)) }
    notify(m.getWord(data + 8))
    return 0
}

export fn __mlx_glib_dbus_free_record(data: usize) -> void { m.release(data) }

// A subscription delivering in `context` (a reference taken here).
pub fn subscribeIn(connection: usize, sender: usize, interface_name: usize, member: usize, object_path: usize, arg0: usize, flags: i32, callback: usize, user_data: usize, notify: usize, context: usize) -> u32 {
    const r = rec(connection)
    const f = @bitCast(u32, flags)
    const rule = ruleOf(sender, interface_name, member, object_path, arg0, f)
    const s = m.alloc(S_SIZE)
    m.put32(s + S_ID, @atomicRmw(u32, &nextSubscriber, add, 1, acq_rel))
    m.put32(s + S_REFS, 1)
    m.putWord(s + S_CALLBACK, callback)
    m.putWord(s + S_DATA, user_data)
    m.putWord(s + S_NOTIFY, notify)
    m.putWord(s + S_CONTEXT, g_main_context_ref(context))
    m.put32(s + S_ACTIVE, 1)
    lock(r)
    const all = wordsAt(r + C_SIGNALS)
    var d: usize = 0
    var i: usize = 0
    while i < all.*.length && d == 0 {
        if m.cEqual(m.getWord(m.wordAt(all, i) + D_RULE), rule) { d = m.wordAt(all, i) }
        i += 1
    }
    if d != 0 {
        m.release(rule)
    } else {
        d = m.alloc(D_SIZE)
        m.putWord(d + D_RULE, rule)
        m.putWord(d + D_SENDER, dupOrNull(sender))
        const unique = sender != 0 && (names.isUniqueName(sender) || m.cIs(sender, "org.freedesktop.DBus"))
        m.putWord(d + D_UNIQUE, if unique { m.dup(sender) } else { m.dupSlice("") })
        m.putWord(d + D_INTERFACE, dupOrNull(interface_name))
        m.putWord(d + D_MEMBER, dupOrNull(member))
        m.putWord(d + D_PATH, dupOrNull(object_path))
        m.putWord(d + D_ARG0, dupOrNull(arg0))
        m.put32(d + D_FLAGS, f)
        m.pushWord(all, d)
        if needsMatchRule(r, d) { busCall(r, "AddMatch", rule) }
    }
    m.pushWord(wordsAt(d + D_SUBSCRIBERS), s)
    unlock(r)
    return m.get32(s + S_ID)
}

export fn g_dbus_connection_signal_subscribe(connection: usize, sender: usize, interface_name: usize, member: usize, object_path: usize, arg0: usize, flags: i32, callback: usize, user_data: usize, user_data_free_func: usize) -> u32 {
    if !isConnection(connection) {
        critical("g_dbus_connection_signal_subscribe", "G_IS_DBUS_CONNECTION (connection)")
        return 0
    }
    if callback == 0 {
        critical("g_dbus_connection_signal_subscribe", "callback != NULL")
        return 0
    }
    const f = @bitCast(u32, flags)
    if (f & MATCH_ARG0_PATH) != 0 && (f & MATCH_ARG0_NAMESPACE) != 0 {
        critical("g_dbus_connection_signal_subscribe", "!((flags & G_DBUS_SIGNAL_FLAGS_MATCH_ARG0_PATH) && (flags & G_DBUS_SIGNAL_FLAGS_MATCH_ARG0_NAMESPACE))")
        return 0
    }
    if arg0 == 0 && (f & (MATCH_ARG0_PATH | MATCH_ARG0_NAMESPACE)) != 0 {
        critical("g_dbus_connection_signal_subscribe", "!(arg0 == NULL && (flags & (G_DBUS_SIGNAL_FLAGS_MATCH_ARG0_PATH | G_DBUS_SIGNAL_FLAGS_MATCH_ARG0_NAMESPACE)))")
        return 0
    }
    const context = g_main_context_ref_thread_default()
    const id = subscribeIn(connection, sender, interface_name, member, object_path, arg0, flags, callback, user_data, user_data_free_func, context)
    g_main_context_unref(context)
    return id
}

export fn g_dbus_connection_signal_unsubscribe(connection: usize, subscription_id: u32) -> void {
    if !isConnection(connection) {
        critical("g_dbus_connection_signal_unsubscribe", "G_IS_DBUS_CONNECTION (connection)")
        return
    }
    const r = rec(connection)
    lock(r)
    const all = wordsAt(r + C_SIGNALS)
    var found: usize = 0
    var i: usize = 0
    while i < all.*.length && found == 0 {
        const d = m.wordAt(all, i)
        const subscribers = wordsAt(d + D_SUBSCRIBERS)
        var k: usize = 0
        while k < subscribers.*.length && found == 0 {
            const s = m.wordAt(subscribers, k)
            if m.get32(s + S_ID) == subscription_id {
                found = s
                m.copy(subscribers.*.address + k * 8, subscribers.*.address + (k + 1) * 8, (subscribers.*.length - k - 1) * 8)
                subscribers.*.length -= 1
                m.put32(s + S_ACTIVE, 0)
                if subscribers.*.length == 0 {
                    if needsMatchRule(r, d) && m.get32(r + C_CLOSED) == 0 { busCall(r, "RemoveMatch", m.getWord(d + D_RULE)) }
                    m.copy(all.*.address + i * 8, all.*.address + (i + 1) * 8, (all.*.length - i - 1) * 8)
                    all.*.length -= 1
                    freeSignalData(d)
                }
            }
            k += 1
        }
        i += 1
    }
    unlock(r)
    if found != 0 { subscriberUnref(found) }
}

fn namespaceMatches(namespace: usize, name: usize) -> bool {
    const n = m.cLength(namespace)
    const length = m.cLength(name)
    if length < n || !m.same(m.bytes(namespace, n), m.bytes(name, n)) { return false }
    return length == n || m.get8(name + n) == '.'
}

fn pathMatches(a: usize, b: usize) -> bool {
    const la = m.cLength(a)
    const lb = m.cLength(b)
    if la < lb && (la == 0 || m.get8(a + la - 1) != '/') { return false }
    if lb < la && (lb == 0 || m.get8(b + lb - 1) != '/') { return false }
    const n = if la < lb { la } else { lb }
    return m.same(m.bytes(a, n), m.bytes(b, n))
}

fn textIs(a: usize, b: usize) -> bool {
    if a == 0 || b == 0 { return a == b }
    return m.cEqual(a, b)
}

// A signal instance for a subscriber's idle source: the subscriber (0),
// the connection (8) and the message (16), references all.
export fn __mlx_glib_dbus_emit_signal(data: usize) -> i32 {
    const s = m.getWord(data)
    const conn = m.getWord(data + 8)
    const message = m.getWord(data + 16)
    const r = rec(conn)
    lock(r)
    const active = m.get32(s + S_ACTIVE) != 0
    unlock(r)
    if active {
        const mr = rec(message)
        var parameters = m.getWord(mr + M_BODY)
        parameters = if parameters == 0 { variant.refSink(variant.newTuple(0, 0)) } else { variant.ref(parameters) }
        const call: SignalCallback = unsafe { @ptrFromInt(SignalCallback, m.getWord(s + S_CALLBACK)) }
        call(conn, m.getWord(mr + M_SENDER), m.getWord(mr + M_PATH), m.getWord(mr + M_INTERFACE), m.getWord(mr + M_MEMBER), parameters, m.getWord(s + S_DATA))
        variant.unref(parameters)
    }
    return 0
}

export fn __mlx_glib_dbus_signal_free(data: usize) -> void {
    g_object_unref(m.getWord(data + 16))
    g_object_unref(m.getWord(data + 8))
    subscriberUnref(m.getWord(data))
    m.release(data)
}

// GIO's schedule_callbacks over the rules whose sender to match is
// `unique`.
fn scheduleCallbacks(r: usize, message: usize, unique: usize) -> void {
    const mr = rec(message)
    const interface = m.getWord(mr + M_INTERFACE)
    const member = m.getWord(mr + M_MEMBER)
    const path = m.getWord(mr + M_PATH)
    const arg0 = firstText(message, 's')
    const arg0Path = firstText(message, 'o')
    const all = wordsAt(r + C_SIGNALS)
    var i: usize = 0
    while i < all.*.length {
        const d = m.wordAt(all, i)
        var matches = m.cEqual(m.getWord(d + D_UNIQUE), unique)
        if matches && m.getWord(d + D_INTERFACE) != 0 && !textIs(m.getWord(d + D_INTERFACE), interface) { matches = false }
        if matches && m.getWord(d + D_MEMBER) != 0 && !textIs(m.getWord(d + D_MEMBER), member) { matches = false }
        if matches && m.getWord(d + D_PATH) != 0 && !textIs(m.getWord(d + D_PATH), path) { matches = false }
        const wanted = m.getWord(d + D_ARG0)
        if matches && wanted != 0 {
            const flags = m.get32(d + D_FLAGS)
            if (flags & MATCH_ARG0_NAMESPACE) != 0 {
                matches = arg0 != 0 && namespaceMatches(wanted, arg0)
            } else if (flags & MATCH_ARG0_PATH) != 0 {
                matches = (arg0 != 0 && pathMatches(wanted, arg0)) || (arg0Path != 0 && pathMatches(wanted, arg0Path))
            } else {
                matches = arg0 != 0 && m.cEqual(wanted, arg0)
            }
        }
        if matches {
            const subscribers = wordsAt(d + D_SUBSCRIBERS)
            var k: usize = 0
            while k < subscribers.*.length {
                const s = m.wordAt(subscribers, k)
                threads.refInc(s + S_REFS)
                const data = m.alloc(24)
                m.putWord(data, s)
                m.putWord(data + 8, g_object_ref(m.getWord(r + C_OBJECT)))
                m.putWord(data + 16, g_object_ref(message))
                idle(m.getWord(s + S_CONTEXT), 0, @intFromPtr(__mlx_glib_dbus_emit_signal), data, @intFromPtr(__mlx_glib_dbus_signal_free))
                k += 1
            }
        }
        i += 1
    }
}

// GIO's distribute_signals (the lock held).
fn distributeSignal(r: usize, message: usize) -> void {
    if m.get32(r + C_FINALIZING) != 0 { return }
    const sender = m.getWord(rec(message) + M_SENDER)
    if sender != 0 { scheduleCallbacks(r, message, sender) }
    scheduleCallbacks(r, message, m.literal(""))
}

// ---------------------------------------------------------------------------
// Method invocations

export fn __mlx_glib_dbus_invocation_init(invocation: usize, class: usize) -> void { m.putWord(invocation + 24, m.alloc(I_SIZE)) }

export fn __mlx_glib_dbus_invocation_finalize(invocation: usize) -> void {
    const r = rec(invocation)
    m.release(m.getWord(r + I_SENDER))
    m.release(m.getWord(r + I_PATH))
    m.release(m.getWord(r + I_INTERFACE))
    m.release(m.getWord(r + I_METHOD))
    g_object_unref(m.getWord(r + I_CONNECTION))
    g_object_unref(m.getWord(r + I_MESSAGE))
    variant.unref(m.getWord(r + I_PARAMETERS))
    if m.getWord(r + I_REGISTRATION) != 0 { registrationUnref(m.getWord(r + I_REGISTRATION)) }
    m.release(r)
    ioerrors.chainUp(types.T_OBJECT, 48, invocation)
}

export fn __mlx_glib_dbus_invocation_class_init(class: usize, data: usize) -> void { m.putWord(class + 48, @intFromPtr(__mlx_glib_dbus_invocation_finalize)) }

fn newInvocation(r: usize, message: usize, g: usize, methodInfo: usize, propertyInfo: usize, parameters: usize) -> usize {
    const invocation = g_object_new(invocationGType(), 0)
    const ir = rec(invocation)
    const mr = rec(message)
    m.putWord(ir + I_SENDER, dupOrNull(m.getWord(mr + M_SENDER)))
    m.putWord(ir + I_PATH, dupOrNull(m.getWord(mr + M_PATH)))
    m.putWord(ir + I_INTERFACE, dupOrNull(m.getWord(mr + M_INTERFACE)))
    m.putWord(ir + I_METHOD, dupOrNull(m.getWord(mr + M_MEMBER)))
    m.putWord(ir + I_METHOD_INFO, methodInfo)
    m.putWord(ir + I_PROPERTY_INFO, propertyInfo)
    m.putWord(ir + I_CONNECTION, g_object_ref(m.getWord(r + C_OBJECT)))
    m.putWord(ir + I_MESSAGE, g_object_ref(message))
    m.putWord(ir + I_PARAMETERS, variant.ref(parameters))
    m.putWord(ir + I_DATA, m.getWord(g + R_DATA))
    threads.refInc(g + R_REFS)
    m.putWord(ir + I_REGISTRATION, g)
    return invocation
}

fn isInvocation(invocation: usize) -> bool { return invocation != 0 && g_type_check_instance_is_a(invocation, invocationGType()) != 0 }

export fn g_dbus_method_invocation_get_sender(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_SENDER) }
export fn g_dbus_method_invocation_get_object_path(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_PATH) }
export fn g_dbus_method_invocation_get_interface_name(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_INTERFACE) }
export fn g_dbus_method_invocation_get_method_name(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_METHOD) }
export fn g_dbus_method_invocation_get_method_info(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_METHOD_INFO) }
export fn g_dbus_method_invocation_get_property_info(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_PROPERTY_INFO) }
export fn g_dbus_method_invocation_get_connection(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_CONNECTION) }
export fn g_dbus_method_invocation_get_message(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_MESSAGE) }
export fn g_dbus_method_invocation_get_parameters(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_PARAMETERS) }
export fn g_dbus_method_invocation_get_user_data(invocation: usize) -> usize { return m.getWord(rec(invocation) + I_DATA) }

// An error reply to `message` (the lock held).
fn replyError(r: usize, message: usize, name: []const u8, text: *m.Text) -> void {
    m.pushByte(text, 0)
    const args = m.alloc(8)
    m.putWord(args, variant.newString(text.*.address))
    const body = variant.refSink(variant.newTuple(args, 1))
    m.release(args)
    m.dispose(text)
    const mr = rec(message)
    if (m.get32(mr + M_FLAGS) & @intCast(u32, dbus.NO_REPLY_EXPECTED)) == 0 {
        _ = sendLocked(r, dbus.ERROR, 0, m.getWord(mr + M_SENDER), 0, 0, 0, m.literal(name), m.get32(mr + M_SERIAL), body, 0, 0)
    }
    variant.unref(body)
}

// A return of `body` (a full reference, or 0) to `message` (the lock
// held).
fn replyReturn(r: usize, message: usize, body: usize, list: usize, err: usize) -> bool {
    const mr = rec(message)
    var ok = true
    if (m.get32(mr + M_FLAGS) & @intCast(u32, dbus.NO_REPLY_EXPECTED)) == 0 {
        ok = sendLocked(r, dbus.METHOD_RETURN, 0, m.getWord(mr + M_SENDER), 0, 0, 0, 0, m.get32(mr + M_SERIAL), body, list, err) != 0
    }
    variant.unref(body)
    return ok
}

// "(" and the args' signatures and ")": a new string.
fn argsSignature(args: usize) -> usize {
    var t = m.text()
    m.pushByte(&t, '(')
    var p = args
    while p != 0 && m.getWord(p) != 0 {
        m.pushC(&t, m.getWord(m.getWord(p) + 16))
        p += 8
    }
    m.pushByte(&t, ')')
    return m.finish(&t)
}

fn returnValue(invocation: usize, parameters: usize, list: usize) -> void {
    if !isInvocation(invocation) {
        critical("g_dbus_method_invocation_return_value_internal", "G_IS_DBUS_METHOD_INVOCATION (invocation)")
        return
    }
    if parameters != 0 && m.get8(variant.typeOf(parameters)) != '(' {
        critical("g_dbus_method_invocation_return_value_internal", "(parameters == NULL) || g_variant_is_of_type (parameters, G_VARIANT_TYPE_TUPLE)")
        return
    }
    const ir = rec(invocation)
    const message = m.getWord(ir + I_MESSAGE)
    var body = if parameters != 0 { variant.refSink(parameters) } else { variant.refSink(variant.newTuple(0, 0)) }
    var good = (m.get32(rec(message) + M_FLAGS) & @intCast(u32, dbus.NO_REPLY_EXPECTED)) == 0
    const methodInfo = m.getWord(ir + I_METHOD_INFO)
    const propertyInfo = m.getWord(ir + I_PROPERTY_INFO)
    if good && methodInfo != 0 {
        const expected = argsSignature(m.getWord(methodInfo + 24))
        if !variant.isSubtype(variant.typeOf(body), expected) {
            var t = m.text()
            m.pushText(&t, "Type of return value is incorrect: expected '")
            m.pushC(&t, expected)
            m.pushText(&t, "', got '")
            m.pushC(&t, variant.typeOf(body))
            m.pushText(&t, "'")
            warning(&t)
            good = false
        }
        m.release(expected)
    }
    if good && propertyInfo != 0 {
        if m.cIs(m.getWord(ir + I_METHOD), "Get") {
            if !m.cIs(variant.typeOf(body), "(v)") {
                var t = m.text()
                m.pushText(&t, "Type of return value for property 'Get' call should be '(v)' but got '")
                m.pushC(&t, variant.typeOf(body))
                m.pushText(&t, "'")
                warning(&t)
                good = false
            } else {
                const boxed = variant.childValue(body, 0)
                const nested = variant.childValue(boxed, 0)
                if !m.cEqual(variant.typeOf(nested), m.getWord(propertyInfo + 16)) {
                    var t = m.text()
                    m.pushText(&t, "Value returned from property 'Get' call for '")
                    m.pushC(&t, m.getWord(propertyInfo + 8))
                    m.pushText(&t, "' should be '")
                    m.pushC(&t, m.getWord(propertyInfo + 16))
                    m.pushText(&t, "' but is '")
                    m.pushC(&t, variant.typeOf(nested))
                    m.pushText(&t, "'")
                    warning(&t)
                    good = false
                }
                variant.unref(nested)
                variant.unref(boxed)
            }
        } else if !m.cIs(variant.typeOf(body), "()") {
            var t = m.text()
            m.pushText(&t, "Type of return value for property 'Set' call should be '()' but got '")
            m.pushC(&t, variant.typeOf(body))
            m.pushText(&t, "'")
            warning(&t)
            good = false
        }
    } else if good && textIs(m.getWord(ir + I_INTERFACE), m.literal("org.freedesktop.DBus.Properties")) && m.cIs(m.getWord(ir + I_METHOD), "GetAll") {
        if !m.cIs(variant.typeOf(body), "(a{sv})") {
            var t = m.text()
            m.pushText(&t, "Type of return value for property 'GetAll' call should be '(a{sv})' but got '")
            m.pushC(&t, variant.typeOf(body))
            m.pushText(&t, "'")
            warning(&t)
            good = false
        }
    }
    if good {
        const r = rec(m.getWord(ir + I_CONNECTION))
        const cell = m.alloc(8)
        lock(r)
        _ = replyReturn(r, message, variant.ref(body), list, cell)
        unlock(r)
        const e = m.getWord(cell)
        if e != 0 {
            if !errors.matches(e, ioerrors.quark(), ioerrors.CLOSED) {
                var t = m.text()
                m.pushText(&t, "Error sending message: ")
                m.pushC(&t, errors.message(e))
                warning(&t)
            }
            errors.freeError(e)
        }
        m.release(cell)
    }
    variant.unref(body)
    g_object_unref(invocation)
}

export fn g_dbus_method_invocation_return_value(invocation: usize, parameters: usize) -> void { returnValue(invocation, parameters, 0) }

export fn g_dbus_method_invocation_return_value_with_unix_fd_list(invocation: usize, parameters: usize, fd_list: usize) -> void { returnValue(invocation, parameters, fd_list) }

export fn g_dbus_method_invocation_return_dbus_error(invocation: usize, error_name: usize, error_message: usize) -> void { returnDBusError(invocation, error_name, error_message) }

fn returnDBusError(invocation: usize, error_name: usize, error_message: usize) -> void {
    if !isInvocation(invocation) {
        critical("g_dbus_method_invocation_return_dbus_error", "G_IS_DBUS_METHOD_INVOCATION (invocation)")
        return
    }
    if error_name == 0 || !names.isName(error_name) {
        critical("g_dbus_method_invocation_return_dbus_error", "error_name != NULL && g_dbus_is_name (error_name)")
        return
    }
    if error_message == 0 {
        critical("g_dbus_method_invocation_return_dbus_error", "error_message != NULL")
        return
    }
    const ir = rec(invocation)
    const r = rec(m.getWord(ir + I_CONNECTION))
    var t = m.text()
    m.pushC(&t, error_message)
    lock(r)
    replyError(r, m.getWord(ir + I_MESSAGE), m.cSlice(error_name), &t)
    unlock(r)
    g_object_unref(invocation)
}

fn returnGError(invocation: usize, e: usize) -> void {
    if e == 0 {
        critical("g_dbus_method_invocation_return_gerror", "error != NULL")
        return
    }
    const name = names.encodeError(e)
    returnDBusError(invocation, name, errors.message(e))
    m.release(name)
}

fn returnErrorLiteral(invocation: usize, domain: u32, code: i32, message: usize) -> void {
    if message == 0 {
        critical("g_dbus_method_invocation_return_error_literal", "message != NULL")
        return
    }
    const e = errors.errorLiteral(domain, code, message)
    returnGError(invocation, e)
    errors.freeError(e)
}

export fn g_dbus_method_invocation_return_gerror(invocation: usize, e: usize) -> void { returnGError(invocation, e) }

export fn g_dbus_method_invocation_take_error(invocation: usize, e: usize) -> void {
    returnGError(invocation, e)
    errors.freeError(e)
}

export fn g_dbus_method_invocation_return_error_literal(invocation: usize, domain: u32, code: i32, message: usize) -> void { returnErrorLiteral(invocation, domain, code, message) }

export fn g_dbus_method_invocation_return_error_valist(invocation: usize, domain: u32, code: i32, format: usize, var_args: usize) -> void {
    const text = varargs.formatted(format, var_args)
    returnErrorLiteral(invocation, domain, code, text)
    m.release(text)
}

export fn g_dbus_method_invocation_return_error(invocation: usize, domain: u32, code: i32, format: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ invocation, @intCast(usize, domain), @intCast(usize, @bitCast(u32, code)), format, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 4, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    const text = varargs.formatted(format, list)
    returnErrorLiteral(invocation, domain, code, text)
    m.release(text)
}

// ---------------------------------------------------------------------------
// Registered objects

fn registrationUnref(g: usize) -> void {
    if !threads.refDec(g + R_REFS) { return }
    if m.getWord(g + R_NOTIFY) != 0 {
        const data = m.alloc(16)
        m.putWord(data, m.getWord(g + R_NOTIFY))
        m.putWord(data + 8, m.getWord(g + R_DATA))
        idle(m.getWord(g + R_CONTEXT), 0, @intFromPtr(__mlx_glib_dbus_call_notify), data, @intFromPtr(__mlx_glib_dbus_free_record))
    }
    introspection.interfaceUnref(m.getWord(g + R_INFO))
    g_main_context_unref(m.getWord(g + R_CONTEXT))
    m.release(m.getWord(g + R_PATH))
    m.release(g)
}

export fn g_dbus_connection_register_object(connection: usize, object_path: usize, interface_info: usize, vtable: usize, user_data: usize, user_data_free_func: usize, err: usize) -> u32 {
    if !isConnection(connection) {
        critical("g_dbus_connection_register_object", "G_IS_DBUS_CONNECTION (connection)")
        return 0
    }
    if object_path == 0 || !variant.isObjectPath(object_path) {
        critical("g_dbus_connection_register_object", "object_path != NULL && g_variant_is_object_path (object_path)")
        return 0
    }
    if interface_info == 0 {
        critical("g_dbus_connection_register_object", "interface_info != NULL")
        return 0
    }
    const name = m.getWord(interface_info + 8)
    if !names.isInterfaceName(name) {
        critical("g_dbus_connection_register_object", "g_dbus_is_interface_name (interface_info->name)")
        return 0
    }
    const r = rec(connection)
    lock(r)
    const objects = wordsAt(r + C_OBJECTS)
    var i: usize = 0
    while i < objects.*.length {
        const g = m.wordAt(objects, i)
        if m.cEqual(m.getWord(g + R_PATH), object_path) && m.cEqual(m.getWord(m.getWord(g + R_INFO) + 8), name) {
            unlock(r)
            var t = m.text()
            m.pushText(&t, "An object is already exported for the interface ")
            m.pushC(&t, name)
            m.pushText(&t, " at ")
            m.pushC(&t, object_path)
            ioerrors.setText(err, ioerrors.EXISTS, &t)
            return 0
        }
        i += 1
    }
    const g = m.alloc(R_SIZE)
    m.put32(g + R_ID, @atomicRmw(u32, &nextRegistration, add, 1, acq_rel))
    m.put32(g + R_REFS, 1)
    m.putWord(g + R_PATH, m.dup(object_path))
    m.putWord(g + R_INFO, introspection.interfaceRef(interface_info))
    if vtable != 0 {
        m.putWord(g + R_METHOD, m.getWord(vtable))
        m.putWord(g + R_GET, m.getWord(vtable + 8))
        m.putWord(g + R_SET, m.getWord(vtable + 16))
        m.put32(g + R_VTABLE, 1)
    }
    m.putWord(g + R_DATA, user_data)
    m.putWord(g + R_NOTIFY, user_data_free_func)
    m.putWord(g + R_CONTEXT, g_main_context_ref_thread_default())
    m.put32(g + R_ACTIVE, 1)
    m.pushWord(objects, g)
    unlock(r)
    return m.get32(g + R_ID)
}

export fn g_dbus_connection_unregister_object(connection: usize, registration_id: u32) -> i32 {
    if !isConnection(connection) {
        critical("g_dbus_connection_unregister_object", "G_IS_DBUS_CONNECTION (connection)")
        return 0
    }
    const r = rec(connection)
    lock(r)
    const objects = wordsAt(r + C_OBJECTS)
    var found: usize = 0
    var i: usize = 0
    while i < objects.*.length && found == 0 {
        const g = m.wordAt(objects, i)
        if m.get32(g + R_ID) == registration_id {
            found = g
            m.copy(objects.*.address + i * 8, objects.*.address + (i + 1) * 8, (objects.*.length - i - 1) * 8)
            objects.*.length -= 1
            m.put32(g + R_ACTIVE, 0)
        }
        i += 1
    }
    unlock(r)
    if found == 0 { return 0 }
    registrationUnref(found)
    return 1
}

// The registration of `interface` at `path` (the lock held), 0 when none.
fn registrationAt(r: usize, path: usize, interface: usize) -> usize {
    const objects = wordsAt(r + C_OBJECTS)
    var i: usize = 0
    while i < objects.*.length {
        const g = m.wordAt(objects, i)
        if m.cEqual(m.getWord(g + R_PATH), path) && m.cEqual(m.getWord(m.getWord(g + R_INFO) + 8), interface) { return g }
        i += 1
    }
    return 0
}

fn hasObjectAt(r: usize, path: usize) -> bool {
    const objects = wordsAt(r + C_OBJECTS)
    var i: usize = 0
    while i < objects.*.length {
        if m.cEqual(m.getWord(m.wordAt(objects, i) + R_PATH), path) { return true }
        i += 1
    }
    return false
}

// An idle call of `func` with `data` in the registration's context.
fn scheduleIn(g: usize, func: usize, data: usize, notify: usize) -> void { idle(m.getWord(g + R_CONTEXT), 0, func, data, notify) }

export fn __mlx_glib_dbus_invocation_unref(invocation: usize) -> void { g_object_unref(invocation) }

// GIO's call_in_idle_cb.
export fn __mlx_glib_dbus_call_in_idle(invocation: usize) -> i32 {
    const ir = rec(invocation)
    const g = m.getWord(ir + I_REGISTRATION)
    const conn = m.getWord(ir + I_CONNECTION)
    const r = rec(conn)
    lock(r)
    const active = m.get32(g + R_ACTIVE) != 0
    if !active {
        var t = m.text()
        m.pushText(&t, "No such interface “")
        m.pushC(&t, m.getWord(ir + I_INTERFACE))
        m.pushText(&t, "” on object at path ")
        m.pushC(&t, m.getWord(ir + I_PATH))
        replyError(r, m.getWord(ir + I_MESSAGE), "org.freedesktop.DBus.Error.UnknownMethod", &t)
    }
    unlock(r)
    if active {
        const call: MethodCall = unsafe { @ptrFromInt(MethodCall, m.getWord(g + R_METHOD)) }
        call(conn, m.getWord(ir + I_SENDER), m.getWord(ir + I_PATH), m.getWord(ir + I_INTERFACE), m.getWord(ir + I_METHOD), m.getWord(ir + I_PARAMETERS), g_object_ref(invocation), m.getWord(g + R_DATA))
    }
    return 0
}

fn scheduleMethodCall(r: usize, message: usize, g: usize, methodInfo: usize, propertyInfo: usize, parameters: usize) -> void {
    const invocation = newInvocation(r, message, g, methodInfo, propertyInfo, parameters)
    scheduleIn(g, @intFromPtr(__mlx_glib_dbus_call_in_idle), invocation, @intFromPtr(__mlx_glib_dbus_invocation_unref))
}

fn bodyOrUnit(message: usize) -> usize {
    const body = m.getWord(rec(message) + M_BODY)
    return if body != 0 { variant.ref(body) } else { variant.refSink(variant.newTuple(0, 0)) }
}

// GIO's validate_and_maybe_schedule_method_call.
fn methodCall(r: usize, message: usize, g: usize) -> void {
    const mr = rec(message)
    const info = m.getWord(g + R_INFO)
    const methodInfo = introspection.lookup(m.getWord(info + 16), m.getWord(mr + M_MEMBER))
    if methodInfo == 0 {
        var t = m.text()
        m.pushText(&t, "No such method “")
        m.pushC(&t, m.getWord(mr + M_MEMBER))
        m.pushText(&t, "”")
        replyError(r, message, "org.freedesktop.DBus.Error.UnknownMethod", &t)
        return
    }
    const parameters = bodyOrUnit(message)
    const expected = argsSignature(m.getWord(methodInfo + 16))
    if !variant.isSubtype(variant.typeOf(parameters), expected) {
        var t = m.text()
        m.pushText(&t, "Type of message, “")
        m.pushC(&t, variant.typeOf(parameters))
        m.pushText(&t, "”, does not match expected type “")
        m.pushC(&t, expected)
        m.pushText(&t, "”")
        replyError(r, message, "org.freedesktop.DBus.Error.InvalidArgs", &t)
    } else {
        scheduleMethodCall(r, message, g, methodInfo, 0, parameters)
    }
    m.release(expected)
    variant.unref(parameters)
}

// A property request for an idle source: the connection (0), the message
// (8), the registration (16), the property's name (24), what to do (32:
// 0 Get, 1 Set, 2 GetAll); references all.
const Q_CONNECTION: usize = 0
const Q_MESSAGE: usize = 8
const Q_REGISTRATION: usize = 16
const Q_NAME: usize = 24
const Q_KIND: usize = 32
const Q_SIZE: usize = 40

export fn __mlx_glib_dbus_property_free(q: usize) -> void {
    g_object_unref(m.getWord(q + Q_CONNECTION))
    g_object_unref(m.getWord(q + Q_MESSAGE))
    registrationUnref(m.getWord(q + Q_REGISTRATION))
    m.release(m.getWord(q + Q_NAME))
    m.release(q)
}

fn schedulePropertyRequest(r: usize, message: usize, g: usize, name: usize, kind: usize) -> void {
    const q = m.alloc(Q_SIZE)
    m.putWord(q + Q_CONNECTION, g_object_ref(m.getWord(r + C_OBJECT)))
    m.putWord(q + Q_MESSAGE, g_object_ref(message))
    threads.refInc(g + R_REFS)
    m.putWord(q + Q_REGISTRATION, g)
    m.putWord(q + Q_NAME, dupOrNull(name))
    m.putWord(q + Q_KIND, kind)
    scheduleIn(g, @intFromPtr(__mlx_glib_dbus_property_in_idle), q, @intFromPtr(__mlx_glib_dbus_property_free))
}

// The error reply for a GError a vtable function set (GIO asserts there
// is one).
fn replyGError(r: usize, message: usize, e: usize) -> void {
    var name: usize = 0
    var t = m.text()
    if e != 0 {
        name = names.encodeError(e)
        m.pushC(&t, errors.message(e))
    } else {
        name = m.dupSlice("org.freedesktop.DBus.Error.Failed")
    }
    replyError(r, message, m.cSlice(name), &t)
    m.release(name)
}

export fn __mlx_glib_dbus_property_in_idle(q: usize) -> i32 {
    const conn = m.getWord(q + Q_CONNECTION)
    const r = rec(conn)
    const message = m.getWord(q + Q_MESSAGE)
    const mr = rec(message)
    const g = m.getWord(q + Q_REGISTRATION)
    const kind = m.getWord(q + Q_KIND)
    const interfaceName = m.getWord(m.getWord(g + R_INFO) + 8)
    lock(r)
    const active = m.get32(g + R_ACTIVE) != 0
    if !active && kind != 1 {
        var t = m.text()
        m.pushText(&t, "No such interface “org.freedesktop.DBus.Properties” on object at path ")
        m.pushC(&t, m.getWord(mr + M_PATH))
        replyError(r, message, "org.freedesktop.DBus.Error.UnknownMethod", &t)
        unlock(r)
        return 0
    }
    unlock(r)
    if kind == 0 {
        const cell = m.alloc(8)
        const get: GetProperty = unsafe { @ptrFromInt(GetProperty, m.getWord(g + R_GET)) }
        const value = get(conn, m.getWord(mr + M_SENDER), m.getWord(mr + M_PATH), interfaceName, m.getWord(q + Q_NAME), cell, m.getWord(g + R_DATA))
        lock(r)
        if value != 0 {
            const held = variant.refSink(value)
            const args = m.alloc(8)
            m.putWord(args, variant.newVariant(held))
            const body = variant.refSink(variant.newTuple(args, 1))
            m.release(args)
            _ = replyReturn(r, message, body, 0, 0)
            variant.unref(held)
        } else {
            replyGError(r, message, m.getWord(cell))
        }
        unlock(r)
        if m.getWord(cell) != 0 { errors.freeError(m.getWord(cell)) }
        m.release(cell)
    } else if kind == 1 {
        const cell = m.alloc(8)
        const body = m.getWord(mr + M_BODY)
        const boxed = variant.childValue(body, 2)
        const value = variant.childValue(boxed, 0)
        const set: SetProperty = unsafe { @ptrFromInt(SetProperty, m.getWord(g + R_SET)) }
        const done = set(conn, m.getWord(mr + M_SENDER), m.getWord(mr + M_PATH), interfaceName, m.getWord(q + Q_NAME), value, cell, m.getWord(g + R_DATA))
        lock(r)
        if done != 0 {
            _ = replyReturn(r, message, 0, 0, 0)
        } else {
            replyGError(r, message, m.getWord(cell))
        }
        unlock(r)
        variant.unref(value)
        variant.unref(boxed)
        if m.getWord(cell) != 0 { errors.freeError(m.getWord(cell)) }
        m.release(cell)
    } else {
        // GetAll: the readable properties whose getter gives a value.
        var entries = m.words()
        const properties = m.getWord(m.getWord(g + R_INFO) + 32)
        var p = properties
        const get: GetProperty = unsafe { @ptrFromInt(GetProperty, m.getWord(g + R_GET)) }
        while p != 0 && m.getWord(p) != 0 {
            const property = m.getWord(p)
            if (m.get32(property + 24) & 1) != 0 {
                const value = get(conn, m.getWord(mr + M_SENDER), m.getWord(mr + M_PATH), interfaceName, m.getWord(property + 8), 0, m.getWord(g + R_DATA))
                if value != 0 {
                    const held = variant.refSink(value)
                    m.pushWord(&entries, variant.newDictEntry(variant.newString(m.getWord(property + 8)), variant.newVariant(held)))
                    variant.unref(held)
                }
            }
            p += 8
        }
        const array = variant.newArray(m.literal("{sv}"), entries.address, entries.length)
        m.disposeWords(&entries)
        const args = m.alloc(8)
        m.putWord(args, array)
        const body = variant.refSink(variant.newTuple(args, 1))
        m.release(args)
        lock(r)
        _ = replyReturn(r, message, body, 0, 0)
        unlock(r)
    }
    return 0
}

// GIO's handle_getset_property and handle_get_all_properties (the lock
// held): whether the request was answered or scheduled.
fn propertyRequest(r: usize, message: usize, kind: usize) -> bool {
    const mr = rec(message)
    const body = m.getWord(mr + M_BODY)
    const first = variant.childValue(body, 0)
    const interfaceName = variant.stringOf(first)
    var propertyName: usize = 0
    var second: usize = 0
    if kind != 2 {
        second = variant.childValue(body, 1)
        propertyName = variant.stringOf(second)
    }
    var handled = true
    const g = registrationAt(r, m.getWord(mr + M_PATH), interfaceName)
    if g == 0 {
        var t = m.text()
        m.pushText(&t, "No such interface “")
        m.pushC(&t, interfaceName)
        m.pushText(&t, "”")
        replyError(r, message, "org.freedesktop.DBus.Error.InvalidArgs", &t)
    } else if m.get32(g + R_VTABLE) == 0 {
        handled = false
    } else if kind == 2 {
        var readable = false
        var p = m.getWord(m.getWord(g + R_INFO) + 32)
        while p != 0 && m.getWord(p) != 0 {
            if (m.get32(m.getWord(p) + 24) & 1) != 0 { readable = true }
            p += 8
        }
        if m.getWord(g + R_GET) == 0 && readable {
            const parameters = bodyOrUnit(message)
            scheduleMethodCall(r, message, g, 0, 0, parameters)
            variant.unref(parameters)
        } else {
            schedulePropertyRequest(r, message, g, 0, 2)
        }
    } else {
        const property = introspection.lookup(m.getWord(m.getWord(g + R_INFO) + 32), propertyName)
        var t = m.text()
        var failed = true
        if property == 0 {
            m.pushText(&t, "No such property “")
            m.pushC(&t, propertyName)
            m.pushText(&t, "”")
        } else if kind == 0 && (m.get32(property + 24) & 1) == 0 {
            m.pushText(&t, "Property “")
            m.pushC(&t, propertyName)
            m.pushText(&t, "” is not readable")
        } else if kind == 1 && (m.get32(property + 24) & 2) == 0 {
            m.pushText(&t, "Property “")
            m.pushC(&t, propertyName)
            m.pushText(&t, "” is not writable")
        } else if kind == 1 {
            const boxed = variant.childValue(body, 2)
            const value = variant.childValue(boxed, 0)
            if !m.cEqual(variant.typeOf(value), m.getWord(property + 16)) {
                m.pushText(&t, "Error setting property “")
                m.pushC(&t, propertyName)
                m.pushText(&t, "”: Expected type “")
                m.pushC(&t, m.getWord(property + 16))
                m.pushText(&t, "” but got “")
                m.pushC(&t, variant.typeOf(value))
                m.pushText(&t, "”")
            } else {
                failed = false
            }
            variant.unref(value)
            variant.unref(boxed)
        } else {
            failed = false
        }
        if failed {
            replyError(r, message, "org.freedesktop.DBus.Error.InvalidArgs", &t)
        } else {
            m.dispose(&t)
            const direct = if kind == 0 { m.getWord(g + R_GET) } else { m.getWord(g + R_SET) }
            if direct == 0 {
                const parameters = bodyOrUnit(message)
                scheduleMethodCall(r, message, g, 0, property, parameters)
                variant.unref(parameters)
            } else {
                schedulePropertyRequest(r, message, g, propertyName, kind)
            }
        }
    }
    if second != 0 { variant.unref(second) }
    variant.unref(first)
    return handled
}

const INTROSPECT_HEADER = "<!DOCTYPE node PUBLIC \"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN\"\n                      \"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd\">\n<!-- GDBus 2.80.0 -->\n<node>\n"

const INTROSPECT_PROPERTIES = "  <interface name=\"org.freedesktop.DBus.Properties\">\n    <method name=\"Get\">\n      <arg type=\"s\" name=\"interface_name\" direction=\"in\"/>\n      <arg type=\"s\" name=\"property_name\" direction=\"in\"/>\n      <arg type=\"v\" name=\"value\" direction=\"out\"/>\n    </method>\n    <method name=\"GetAll\">\n      <arg type=\"s\" name=\"interface_name\" direction=\"in\"/>\n      <arg type=\"a{sv}\" name=\"properties\" direction=\"out\"/>\n    </method>\n    <method name=\"Set\">\n      <arg type=\"s\" name=\"interface_name\" direction=\"in\"/>\n      <arg type=\"s\" name=\"property_name\" direction=\"in\"/>\n      <arg type=\"v\" name=\"value\" direction=\"in\"/>\n    </method>\n    <signal name=\"PropertiesChanged\">\n      <arg type=\"s\" name=\"interface_name\"/>\n      <arg type=\"a{sv}\" name=\"changed_properties\"/>\n      <arg type=\"as\" name=\"invalidated_properties\"/>\n    </signal>\n  </interface>\n"

const INTROSPECT_INTROSPECTABLE = "  <interface name=\"org.freedesktop.DBus.Introspectable\">\n    <method name=\"Introspect\">\n      <arg type=\"s\" name=\"xml_data\" direction=\"out\"/>\n    </method>\n  </interface>\n  <interface name=\"org.freedesktop.DBus.Peer\">\n    <method name=\"Ping\"/>\n    <method name=\"GetMachineId\">\n      <arg type=\"s\" name=\"machine_uuid\" direction=\"out\"/>\n    </method>\n  </interface>\n"

// The `<node name="..."/>` lines of the paths registered below `path`.
fn childNodes(r: usize, path: usize, t: *m.Text) -> void {
    var length = m.cLength(path)
    if length > 1 { length += 1 }
    var seen = m.words()
    const objects = wordsAt(r + C_OBJECTS)
    var i: usize = 0
    while i < objects.*.length {
        const other = m.getWord(m.wordAt(objects, i) + R_PATH)
        const otherLength = m.cLength(other)
        if otherLength > length && m.same(m.bytes(other, m.cLength(path)), m.cSlice(path)) && m.get8(other + length - 1) == '/' {
            const begin = other + length
            var end = begin
            while m.get8(end) != 0 && m.get8(end) != '/' { end += 1 }
            const child = m.dupBytes(begin, end - begin)
            var known = false
            var k: usize = 0
            while k < seen.length {
                if m.cEqual(m.wordAt(&seen, k), child) { known = true }
                k += 1
            }
            if known {
                m.release(child)
            } else {
                m.pushWord(&seen, child)
            }
        }
        i += 1
    }
    i = 0
    while i < seen.length {
        m.pushText(t, "  <node name=\"")
        m.pushC(t, m.wordAt(&seen, i))
        m.pushText(t, "\"/>\n")
        m.release(m.wordAt(&seen, i))
        i += 1
    }
    m.disposeWords(&seen)
}

fn replyText(r: usize, message: usize, t: *m.Text) -> void {
    m.pushByte(t, 0)
    const args = m.alloc(8)
    m.putWord(args, variant.newString(t.*.address))
    const body = variant.refSink(variant.newTuple(args, 1))
    m.release(args)
    m.dispose(t)
    _ = replyReturn(r, message, body, 0, 0)
}

// GIO's handle_introspect for an object with interfaces registered.
fn introspectObject(r: usize, message: usize) -> void {
    const path = m.getWord(rec(message) + M_PATH)
    var t = m.text()
    m.pushText(&t, INTROSPECT_HEADER)
    if registrationAt(r, path, m.literal("org.freedesktop.DBus.Properties")) == 0 { m.pushText(&t, INTROSPECT_PROPERTIES) }
    if registrationAt(r, path, m.literal("org.freedesktop.DBus.Introspectable")) == 0 { m.pushText(&t, INTROSPECT_INTROSPECTABLE) }
    const objects = wordsAt(r + C_OBJECTS)
    var i: usize = 0
    while i < objects.*.length {
        const g = m.wordAt(objects, i)
        if m.cEqual(m.getWord(g + R_PATH), path) { introspection.interfaceXml(m.getWord(g + R_INFO), 2, &t) }
        i += 1
    }
    childNodes(r, path, &t)
    m.pushText(&t, "</node>\n")
    replyText(r, message, &t)
}

fn machineId(t: *m.Text) -> bool {
    const files = [2][]const u8{ "/var/lib/dbus/machine-id", "/etc/machine-id" }
    var i: usize = 0
    while i < 2 {
        const fd = sys.open(m.literal(files[i]), 524288, 0)
        if fd >= 0 {
            var buffer: [64]u8 = undefined
            const got = sys.read(fd, @intFromPtr(&buffer), 64)
            _ = sys.close(fd)
            if got >= 32 {
                var n: usize = 0
                while n < @intCast(usize, got) && buffer[n] != 10 && buffer[n] != 0 { n += 1 }
                m.pushBytes(t, @intFromPtr(&buffer), n)
                return true
            }
        }
        i += 1
    }
    return false
}

// GIO's handle_generic_unlocked: Introspect, Ping and GetMachineId on any
// path.
fn genericCall(r: usize, message: usize) -> bool {
    const mr = rec(message)
    const interface = m.getWord(mr + M_INTERFACE)
    const member = m.getWord(mr + M_MEMBER)
    const signature = signatureOf(message)
    if interface == 0 || m.get8(signature) != 0 { return false }
    if m.cIs(interface, "org.freedesktop.DBus.Introspectable") && m.cIs(member, "Introspect") {
        var t = m.text()
        m.pushText(&t, INTROSPECT_HEADER)
        childNodes(r, m.getWord(mr + M_PATH), &t)
        m.pushText(&t, "</node>\n")
        replyText(r, message, &t)
        return true
    }
    if m.cIs(interface, "org.freedesktop.DBus.Peer") && m.cIs(member, "Ping") {
        _ = replyReturn(r, message, 0, 0, 0)
        return true
    }
    if m.cIs(interface, "org.freedesktop.DBus.Peer") && m.cIs(member, "GetMachineId") {
        var t = m.text()
        if machineId(&t) {
            replyText(r, message, &t)
        } else {
            m.dispose(&t)
            var e = m.text()
            m.pushText(&e, "Unable to load /var/lib/dbus/machine-id or /etc/machine-id: No such file or directory")
            replyError(r, message, "org.freedesktop.DBus.Error.Failed", &e)
        }
        return true
    }
    return false
}

// GIO's distribute_method_call (the lock held).
fn distributeMethodCall(r: usize, message: usize) -> void {
    if m.get32(r + C_FINALIZING) != 0 { return }
    const mr = rec(message)
    const path = m.getWord(mr + M_PATH)
    const interface = m.getWord(mr + M_INTERFACE)
    const member = m.getWord(mr + M_MEMBER)
    const signature = signatureOf(message)
    var handled = false
    var objectFound = false
    if hasObjectAt(r, path) {
        var registered: usize = 0
        if interface != 0 { registered = registrationAt(r, path, interface) }
        if registered != 0 {
            if m.get32(registered + R_VTABLE) != 0 && m.getWord(registered + R_METHOD) != 0 {
                methodCall(r, message, registered)
                handled = true
            }
        } else {
            if interface != 0 { objectFound = true }
            if textIs(interface, m.literal("org.freedesktop.DBus.Introspectable")) && m.cIs(member, "Introspect") && m.cIs(signature, "") {
                introspectObject(r, message)
                handled = true
            } else if textIs(interface, m.literal("org.freedesktop.DBus.Properties")) && m.cIs(member, "Get") && m.cIs(signature, "ss") {
                handled = propertyRequest(r, message, 0)
            } else if textIs(interface, m.literal("org.freedesktop.DBus.Properties")) && m.cIs(member, "Set") && m.cIs(signature, "ssv") {
                handled = propertyRequest(r, message, 1)
            } else if textIs(interface, m.literal("org.freedesktop.DBus.Properties")) && m.cIs(member, "GetAll") && m.cIs(signature, "s") {
                handled = propertyRequest(r, message, 2)
            }
        }
    }
    if !handled { handled = genericCall(r, message) }
    if handled { return }
    var t = m.text()
    if objectFound {
        m.pushText(&t, "No such interface “")
        m.pushC(&t, interface)
        m.pushText(&t, "” on object at path ")
        m.pushC(&t, path)
    } else {
        m.pushText(&t, "Object does not exist at path “")
        m.pushC(&t, path)
        m.pushText(&t, "”")
    }
    replyError(r, message, "org.freedesktop.DBus.Error.UnknownMethod", &t)
}

// ---------------------------------------------------------------------------
// Connecting

// Connects to the first element of the address list that answers (a
// blocking socket, close-on-exec): its descriptor, -1 with `err` set.
pub fn connectAddress(address: usize, err: usize) -> i32 {
    var p = address
    var lastErrno: i32 = 2
    var tried = false
    const value = m.alloc(256)
    while m.get8(p) != 0 {
        var end = p
        while m.get8(end) != 0 && m.get8(end) != ';' { end += 1 }
        const entry = m.bytes(p, end - p)
        const transport = dbus.addressTransport(entry)
        if transport.length == 0 && end > p {
            var t = m.text()
            m.pushText(&t, "Address element “")
            m.pushBytes(&t, p, end - p)
            m.pushText(&t, "” does not contain a colon (:)")
            ioerrors.setText(err, ioerrors.INVALID_ARGUMENT, &t)
            m.release(value)
            return -1
        }
        if m.same(transport, "unix") {
            var abstract = false
            var length: isize = 0
            unsafe { length = dbus.addressValue(entry, "path", @ptrFromInt([*]u8, value), 256) }
            if length < 0 {
                abstract = true
                unsafe { length = dbus.addressValue(entry, "abstract", @ptrFromInt([*]u8, value), 256) }
            }
            if length >= 0 {
                tried = true
                const fd = std.linux.socket.connectUnix(m.bytes(value, @intCast(usize, length)), abstract, 524288)
                if fd >= 0 {
                    m.release(value)
                    return @intCast(i32, fd)
                }
                lastErrno = @intCast(i32, -fd)
            }
        }
        p = if m.get8(end) == ';' { end + 1 } else { end }
    }
    m.release(value)
    if !tried {
        ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Unknown or unsupported transport for address")
        return -1
    }
    var t = m.text()
    m.pushText(&t, "Could not connect: ")
    m.pushC(&t, errors.errnoText(lastErrno))
    ioerrors.setText(err, ioerrors.fromErrno(lastErrno), &t)
    return -1
}

// Says Hello on a bus (before the worker runs): the unique name, 0 with
// `err` set. What else comes meanwhile stays in the input for the
// worker.
fn hello(r: usize, err: usize) -> usize {
    lock(r)
    const serial = sendLocked(r, dbus.METHOD_CALL, 0, m.literal("org.freedesktop.DBus"), m.literal("/org/freedesktop/DBus"), m.literal("org.freedesktop.DBus"), m.literal("Hello"), 0, 0, 0, 0, err)
    unlock(r)
    if serial == 0 { return 0 }
    while true {
        var offset: usize = 0
        var size = bufferedMessage(r, offset)
        while size != 0 {
            if size > m.getWord(r + C_IN_LENGTH) {
                ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Invalid message from the bus")
                return 0
            }
            var header: dbus.Header = undefined
            var good = false
            unsafe { good = dbus.parseHeader(@ptrFromInt([*]const u8, m.getWord(r + C_IN) + offset), size, &header) }
            if good && (header.kind == dbus.METHOD_RETURN || header.kind == dbus.ERROR) && header.hasReplySerial && header.replySerial == serial {
                const message = parseMessage(r, offset, size)
                dropInput(r, offset, size)
                if message == 0 {
                    ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Invalid reply to Hello")
                    return 0
                }
                const result = decodeReply(message, m.literal("Hello"), m.literal("(s)"), 0, err)
                g_object_unref(message)
                if result == 0 { return 0 }
                const child = variant.childValue(result, 0)
                const unique = m.dup(variant.stringOf(child))
                variant.unref(child)
                variant.unref(result)
                return unique
            }
            offset += size
            size = bufferedMessage(r, offset)
        }
        var errnum: i32 = 0
        if !receiveSome(r, &errnum) && errnum != 4 {
            if errnum == 0 {
                ioerrors.set(err, ioerrors.FAILED, "Underlying GIOStream returned 0 bytes on an async read")
            } else {
                var t = m.text()
                m.pushText(&t, "Error while reading: ")
                m.pushC(&t, errors.errnoText(errnum))
                ioerrors.setText(err, ioerrors.fromErrno(errnum), &t)
            }
            return 0
        }
    }
    return 0
}

// GInitable's init: connect, authenticate, say Hello, start the worker.
fn initialize(conn: usize, c: usize, err: usize) -> bool {
    const r = rec(conn)
    threads.lock(r + C_INIT_LOCK)
    const state = m.get32(r + C_STATE)
    if state != 0 {
        threads.unlock(r + C_INIT_LOCK)
        if state == 1 { return true }
        errors.report(err, g_error_copy(m.getWord(r + C_INIT_ERROR)))
        return false
    }
    const cell = m.alloc(8)
    const ok = connectAndGreet(r, c, cell)
    if ok {
        m.put32(r + C_STATE, 1)
    } else {
        m.put32(r + C_STATE, 2)
        m.putWord(r + C_INIT_ERROR, m.getWord(cell))
        errors.report(err, g_error_copy(m.getWord(cell)))
    }
    m.release(cell)
    threads.unlock(r + C_INIT_LOCK)
    return ok
}

fn connectAndGreet(r: usize, c: usize, err: usize) -> bool {
    if cancellable.setErrorIfCancelled(c, err) { return false }
    const address = m.getWord(r + C_ADDRESS)
    if address == 0 {
        ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Connections over a stream are not available in this library")
        return false
    }
    const fd = connectAddress(address, err)
    if fd < 0 { return false }
    m.putI32(r + C_FD, fd)
    var guid: [33]u8 = undefined
    const authenticated = dbus.authenticate(@intCast(isize, fd), getuid(), true, &guid)
    if authenticated < 0 {
        ioerrors.set(err, ioerrors.FAILED, "Exhausted all available authentication mechanisms (tried: EXTERNAL) (available: )")
        return false
    }
    m.put32(r + C_FDS, if authenticated == 1 { 1 } else { 0 })
    if m.getWord(r + C_GUID) == 0 { m.putWord(r + C_GUID, m.dup(@intFromPtr(&guid))) }
    if (m.get32(r + C_FLAGS) & MESSAGE_BUS_CONNECTION) != 0 {
        const unique = hello(r, err)
        if unique == 0 { return false }
        m.putWord(r + C_UNIQUE, unique)
    }
    m.putI32(r + C_WAKE, sys.eventfd(0, 524288))
    m.putWord(r + C_WORKER, g_thread_new(m.literal("gdbus"), @intFromPtr(__mlx_glib_dbus_worker), r))
    return true
}

export fn __mlx_glib_dbus_connection_init_sync(initable: usize, c: usize, err: usize) -> i32 { return if initialize(initable, c, err) { 1 } else { 0 } }

export fn __mlx_glib_dbus_connection_initable_init(iface: usize, data: usize) -> void { m.putWord(iface + 16, @intFromPtr(__mlx_glib_dbus_connection_init_sync)) }

fn newConnection(address: usize, flags: i32) -> usize {
    const conn = g_object_new(connectionGType(), 0)
    const r = rec(conn)
    m.putWord(r + C_ADDRESS, m.dup(address))
    m.put32(r + C_FLAGS, @bitCast(u32, flags) | AUTHENTICATION_CLIENT)
    return conn
}

pub fn connectionFor(address: usize, flags: i32, exitOnClose: bool) -> usize {
    const conn = newConnection(address, flags)
    m.put32(rec(conn) + C_EXIT, if exitOnClose { 1 } else { 0 })
    return conn
}

pub fn initializeSync(conn: usize, c: usize, err: usize) -> bool { return initialize(conn, c, err) }

export fn g_dbus_connection_new_for_address_sync(address: usize, flags: i32, observer: usize, c: usize, err: usize) -> usize {
    const conn = newConnection(address, flags)
    if !initialize(conn, c, err) {
        g_object_unref(conn)
        return 0
    }
    return conn
}

export fn __mlx_glib_dbus_connection_init_thread(task: usize, source: usize, data: usize, c: usize) -> void {
    const cell = m.alloc(8)
    if initialize(source, c, cell) {
        g_task_return_boolean(task, 1)
    } else {
        g_task_return_error(task, m.getWord(cell))
    }
    m.release(cell)
}

// Initializes `conn` in a thread, then calls back in the caller's context.
pub fn initializeAsync(conn: usize, c: usize, callback: usize, user_data: usize, tag: usize) -> void {
    const task = g_task_new(conn, c, callback, user_data)
    g_task_set_source_tag(task, tag)
    g_task_run_in_thread(task, @intFromPtr(__mlx_glib_dbus_connection_init_thread))
    g_object_unref(task)
}

export fn g_dbus_connection_new_for_address(address: usize, flags: i32, observer: usize, c: usize, callback: usize, user_data: usize) -> void {
    const conn = newConnection(address, flags)
    initializeAsync(conn, c, callback, user_data, @intFromPtr(&newTag))
    g_object_unref(conn)
}

// The connection a GAsyncInitable-style task made, when it went well.
pub fn initializedFrom(res: usize, err: usize) -> usize {
    const conn = g_task_get_source_object(res)
    if g_task_propagate_boolean(res, err) == 0 { return 0 }
    return g_object_ref(conn)
}

export fn g_dbus_connection_new_for_address_finish(res: usize, err: usize) -> usize { return initializedFrom(res, err) }

// ---------------------------------------------------------------------------
// The connection's state

export fn g_dbus_connection_get_unique_name(connection: usize) -> usize {
    if !isConnection(connection) {
        critical("g_dbus_connection_get_unique_name", "G_IS_DBUS_CONNECTION (connection)")
        return 0
    }
    return m.getWord(rec(connection) + C_UNIQUE)
}

export fn g_dbus_connection_get_guid(connection: usize) -> usize { return m.getWord(rec(connection) + C_GUID) }
export fn g_dbus_connection_get_flags(connection: usize) -> i32 { return @bitCast(i32, m.get32(rec(connection) + C_FLAGS)) }
export fn g_dbus_connection_get_capabilities(connection: usize) -> i32 { return @bitCast(i32, m.get32(rec(connection) + C_FDS)) }
export fn g_dbus_connection_get_exit_on_close(connection: usize) -> i32 { return @bitCast(i32, m.get32(rec(connection) + C_EXIT)) }
export fn g_dbus_connection_set_exit_on_close(connection: usize, exit_on_close: i32) -> void { m.put32(rec(connection) + C_EXIT, if exit_on_close != 0 { 1 } else { 0 }) }
export fn g_dbus_connection_get_last_serial(connection: usize) -> u32 { return m.get32(rec(connection) + C_SERIAL) }
export fn g_dbus_connection_get_stream(connection: usize) -> usize { return 0 }

pub fn isClosed(connection: usize) -> bool { return @atomicLoad(u32, m.word32(rec(connection) + C_CLOSED), acquire) != 0 }

export fn g_dbus_connection_is_closed(connection: usize) -> i32 {
    if !isConnection(connection) {
        critical("g_dbus_connection_is_closed", "G_IS_DBUS_CONNECTION (connection)")
        return 0
    }
    return if isClosed(connection) { 1 } else { 0 }
}

// Closing: the worker stops, the socket shuts, "closed" follows.
fn closeHere(connection: usize, err: usize) -> bool {
    const r = rec(connection)
    if m.get32(r + C_STATE) != 1 || @atomicLoad(u32, m.word32(r + C_CLOSED), acquire) != 0 {
        ioerrors.set(err, ioerrors.CLOSED, "The connection is closed")
        return false
    }
    closeConnection(r, false, 0)
    stopWorker(r)
    _ = shutdown(m.getI32(r + C_FD), 2)
    return true
}

export fn g_dbus_connection_close_sync(connection: usize, c: usize, err: usize) -> i32 {
    if !isConnection(connection) {
        critical("g_dbus_connection_close_sync", "G_IS_DBUS_CONNECTION (connection)")
        return 0
    }
    if cancellable.setErrorIfCancelled(c, err) { return 0 }
    return if closeHere(connection, err) { 1 } else { 0 }
}

export fn g_dbus_connection_close(connection: usize, c: usize, callback: usize, user_data: usize) -> void {
    const task = g_task_new(connection, c, callback, user_data)
    g_task_set_source_tag(task, @intFromPtr(&closeTag))
    const cell = m.alloc(8)
    if closeHere(connection, cell) {
        g_task_return_boolean(task, 1)
    } else {
        g_task_return_error(task, m.getWord(cell))
    }
    m.release(cell)
    g_object_unref(task)
}

export fn g_dbus_connection_close_finish(connection: usize, res: usize, err: usize) -> i32 { return g_task_propagate_boolean(res, err) }

// Messages are written when sent: there is nothing to flush.
fn flushHere(connection: usize, err: usize) -> bool {
    if isClosed(connection) {
        ioerrors.set(err, ioerrors.CLOSED, "The connection is closed")
        return false
    }
    return true
}

export fn g_dbus_connection_flush_sync(connection: usize, c: usize, err: usize) -> i32 { return if flushHere(connection, err) { 1 } else { 0 } }

export fn g_dbus_connection_flush(connection: usize, c: usize, callback: usize, user_data: usize) -> void {
    const task = g_task_new(connection, c, callback, user_data)
    const cell = m.alloc(8)
    if flushHere(connection, cell) {
        g_task_return_boolean(task, 1)
    } else {
        g_task_return_error(task, m.getWord(cell))
    }
    m.release(cell)
    g_object_unref(task)
}

export fn g_dbus_connection_flush_finish(connection: usize, res: usize, err: usize) -> i32 { return g_task_propagate_boolean(res, err) }

// ---------------------------------------------------------------------------
// The buses: one shared connection to each (exit-on-close), kept while
// someone holds it, as GIO's g_bus_get keeps them.

var busLock: u32 = 0
var sessionBus: usize = 0
var systemBus: usize = 0
var busTag: u8 = 0

fn busKind(busType: i32) -> i32 {
    if busType != -1 { return busType }
    const starter = sys.getenv(m.literal("DBUS_STARTER_BUS_TYPE"))
    return if starter != 0 && m.cIs(starter, "system") { 1 } else { 2 }
}

export fn __mlx_glib_dbus_bus_gone(slot: usize, object: usize) -> void {
    threads.lock(@intFromPtr(&busLock))
    if m.getWord(slot) == object { m.putWord(slot, 0) }
    threads.unlock(@intFromPtr(&busLock))
}

// The bus's connection (a reference), made when there is none; 0 with
// `err` set when it cannot be.
pub fn busFor(busType: i32, c: usize, err: usize) -> usize {
    const kind = busKind(busType)
    if kind != 1 && kind != 2 {
        ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Unknown bus type")
        return 0
    }
    const slot = if kind == 1 { @intFromPtr(&systemBus) } else { @intFromPtr(&sessionBus) }
    threads.lock(@intFromPtr(&busLock))
    const existing = m.getWord(slot)
    if existing != 0 {
        _ = g_object_ref(existing)
        threads.unlock(@intFromPtr(&busLock))
        return existing
    }
    const address = introspection.addressFor(busType, err)
    if address == 0 {
        threads.unlock(@intFromPtr(&busLock))
        return 0
    }
    // (GIO adds CROSS_NAMESPACE on Linux.)
    const conn = connectionFor(address, @bitCast(i32, AUTHENTICATION_CLIENT | MESSAGE_BUS_CONNECTION | 64), true)
    m.release(address)
    if !initialize(conn, c, err) {
        threads.unlock(@intFromPtr(&busLock))
        g_object_unref(conn)
        return 0
    }
    m.putWord(slot, conn)
    g_object_weak_ref(conn, @intFromPtr(__mlx_glib_dbus_bus_gone), slot)
    threads.unlock(@intFromPtr(&busLock))
    return conn
}

export fn g_bus_get_sync(bus_type: i32, c: usize, err: usize) -> usize {
    if cancellable.setErrorIfCancelled(c, err) { return 0 }
    return busFor(bus_type, c, err)
}

export fn __mlx_glib_dbus_bus_thread(task: usize, source: usize, data: usize, c: usize) -> void {
    const cell = m.alloc(8)
    const conn = busFor(@bitCast(i32, @intCast(u32, data & 0xffffffff)), c, cell)
    if conn != 0 {
        g_task_return_pointer(task, conn, @intFromPtr(g_object_unref))
    } else {
        g_task_return_error(task, m.getWord(cell))
    }
    m.release(cell)
}

export fn g_bus_get(bus_type: i32, c: usize, callback: usize, user_data: usize) -> void {
    const task = g_task_new(0, c, callback, user_data)
    g_task_set_source_tag(task, @intFromPtr(&busTag))
    g_task_set_task_data(task, @intCast(usize, @bitCast(u32, bus_type)), 0)
    g_task_run_in_thread(task, @intFromPtr(__mlx_glib_dbus_bus_thread))
    g_object_unref(task)
}

export fn g_bus_get_finish(res: usize, err: usize) -> usize { return g_task_propagate_pointer(res, err) }
