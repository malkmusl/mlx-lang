// GDBus's connection (gdbusconnection.h), its messages (GDBusMessage, as
// far as a method invocation hands one out) and method invocations
// (gdbusmethodinvocation.h), on std.dbus's wire format.
//
// A connection is made to an address (unix:path= or unix:abstract=,
// the first of a list that answers), authenticates with EXTERNAL asking
// to pass descriptors, and on a message bus says Hello. A worker thread
// of its own then reads the socket, as GIO's GDBusWorker does: replies go
// to the calls waiting for them (a synchronous call waits on a condition,
// an asynchronous one completes its GTask in the caller's context), each
// signal to the subscriptions that match it (in their thread-default
// contexts, from idle sources, as in GIO), each method call to the object
// registered at its path (its vtable's method_call, get_property and
// set_property, run in the registering thread's context; Introspect,
// Properties' Get, Set and GetAll, Peer's Ping and GetMachineId as GIO
// answers them; GIO's error replies otherwise). Messages are written by
// whichever thread sends them, under the connection's lock.
//
// What GIO's GDBusConnection has that is not here: connections over a
// GIOStream (g_dbus_connection_new), servers and peer-to-peer
// authentication, subtrees, message filters, GDBusMessage built by hand.
const std = @import("std")
const dbus = @import("std.dbus")
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const messages = @import("./messages.mlx")
const types = @import("./types.mlx")
const ioerrors = @import("./ioerrors.mlx")
const cancellable = @import("./cancellable.mlx")
const variant = @import("./variant.mlx")
const varargs = @import("./varargs.mlx")
const marshal = @import("./dbusmarshal.mlx")
const names = @import("./dbusnames.mlx")
const fdlist = @import("./unixfdlist.mlx")
const signals = @import("./signals.mlx")
const closures = @import("./closures.mlx")
const introspection = @import("./dbus.mlx")

