export fn g_dbus_proxy_get_default_timeout(proxy: usize) -> i32 {
    noProxy("g_dbus_proxy_get_default_timeout")
    return -1
}

export fn g_dbus_proxy_set_default_timeout(proxy: usize, timeout_msec: i32) -> void { noProxy("g_dbus_proxy_set_default_timeout") }

export fn g_dbus_proxy_get_cached_property(proxy: usize, property_name: usize) -> usize {
    noProxy("g_dbus_proxy_get_cached_property")
    return 0
}

export fn g_dbus_proxy_set_cached_property(proxy: usize, property_name: usize, value: usize) -> void { noProxy("g_dbus_proxy_set_cached_property") }

export fn g_dbus_proxy_get_cached_property_names(proxy: usize) -> usize {
    noProxy("g_dbus_proxy_get_cached_property_names")
    return 0
}

export fn g_dbus_proxy_call(proxy: usize, method_name: usize, parameters: usize, flags: i32, timeout_msec: i32, c: usize, callback: usize, user_data: usize) -> void { noProxy("g_dbus_proxy_call") }

export fn g_dbus_proxy_call_finish(proxy: usize, res: usize, err: usize) -> usize {
    noProxy("g_dbus_proxy_call_finish")
    return 0
