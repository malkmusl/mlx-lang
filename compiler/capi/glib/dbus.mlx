// ---------------------------------------------------------------------------
// Introspection data. The structures are GIO's: every one starts with
// its reference count and name; their lists are NULL-ended arrays.
//
// node: path 8, interfaces 16, nodes 24, annotations 32
// interface: name 8, methods 16, signals 24, properties 32, annotations 40
// method: name 8, in_args 16, out_args 24, annotations 32
// signal: name 8, args 16, annotations 24
// property: name 8, signature 16, flags 24, annotations 32
// arg: name 8, signature 16, annotations 24
// annotation: key 8, value 16, annotations 24

const K_NODE: usize = 0
const K_INTERFACE: usize = 1
const K_METHOD: usize = 2
const K_SIGNAL: usize = 3
const K_PROPERTY: usize = 4
const K_ARG: usize = 5
const K_ANNOTATION: usize = 6
const K_OTHER: usize = 7

// A frame of the parse: the kind (0), the structure (8), three lists
// (16, 40, 64) and the annotations (88).
const F_KIND: usize = 0
const F_OBJECT: usize = 8
const F_LIST1: usize = 16
const F_LIST2: usize = 40
const F_LIST3: usize = 64
const F_ANNOTATIONS: usize = 88
const F_SIZE: usize = 112

fn wordsAt(address: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, address) } }

fn attribute(names: usize, valuesArray: usize, wanted: []const u8) -> usize {
    var i: usize = 0
    while m.getWord(names + i * 8) != 0 {
        if m.cIs(m.getWord(names + i * 8), wanted) { return m.getWord(valuesArray + i * 8) }
        i += 1
    }
    return 0
}

fn dupOrNull(text: usize) -> usize { return if text == 0 { 0 } else { m.dup(text) } }

fn arrayOf(list: *m.Words) -> usize {
    m.pushWord(list, 0)
    return m.finishWords(list)
}

// The parse's state: the frames (words) and the root node (24).
export fn __mlx_glib_dbus_start(k: usize, name: usize, names: usize, valuesArray: usize, state: usize, err: usize) -> void {
    const frames = wordsAt(state)
    const frame = m.alloc(F_SIZE)
    var kind = K_OTHER
    var size: usize = 0
    if m.cIs(name, "node") {
        kind = K_NODE
        size = 40
    } else if m.cIs(name, "interface") {
        kind = K_INTERFACE
        size = 48
    } else if m.cIs(name, "method") {
        kind = K_METHOD
        size = 40
    } else if m.cIs(name, "signal") {
        kind = K_SIGNAL
        size = 32
    } else if m.cIs(name, "property") {
        kind = K_PROPERTY
        size = 40
    } else if m.cIs(name, "arg") {
        kind = K_ARG
        size = 32
    } else if m.cIs(name, "annotation") {
        kind = K_ANNOTATION
        size = 32
    }
    m.putWord(frame + F_KIND, kind)
    if size != 0 {
        const object = m.alloc(size)
        m.putI32(object, 1)
        if kind == K_ANNOTATION {
            m.putWord(object + 8, dupOrNull(attribute(names, valuesArray, "name")))
            m.putWord(object + 16, dupOrNull(attribute(names, valuesArray, "value")))
        } else {
            m.putWord(object + 8, dupOrNull(attribute(names, valuesArray, "name")))
        }
        if kind == K_ARG {
            m.putWord(object + 16, dupOrNull(attribute(names, valuesArray, "type")))
            // (The direction decides the method's list it goes to.)
            const direction = attribute(names, valuesArray, "direction")
            m.putWord(frame + F_LIST3, if direction != 0 && m.cIs(direction, "out") { 1 } else { 0 })
        }
        if kind == K_PROPERTY {
            m.putWord(object + 16, dupOrNull(attribute(names, valuesArray, "type")))
            const access = attribute(names, valuesArray, "access")
            var flags: i32 = 0
            if access != 0 && (m.cIs(access, "read") || m.cIs(access, "readwrite")) { flags = flags | 1 }
            if access != 0 && (m.cIs(access, "write") || m.cIs(access, "readwrite")) { flags = flags | 2 }
            m.putI32(object + 24, flags)
        }
        m.putWord(frame + F_OBJECT, object)
    }
    m.pushWord(frames, frame)
}

export fn __mlx_glib_dbus_end(k: usize, name: usize, state: usize, err: usize) -> void {
    const frames = wordsAt(state)
    const frame = m.wordAt(frames, frames.*.length - 1)
    frames.*.length -= 1
    const kind = m.getWord(frame + F_KIND)
    const object = m.getWord(frame + F_OBJECT)
    const annotations = arrayOf(wordsAt(frame + F_ANNOTATIONS))
    if kind == K_NODE {
        m.putWord(object + 16, arrayOf(wordsAt(frame + F_LIST1)))
        m.putWord(object + 24, arrayOf(wordsAt(frame + F_LIST2)))
        m.putWord(object + 32, annotations)
    } else if kind == K_INTERFACE {
        m.putWord(object + 16, arrayOf(wordsAt(frame + F_LIST1)))
        m.putWord(object + 24, arrayOf(wordsAt(frame + F_LIST2)))
        m.putWord(object + 32, arrayOf(wordsAt(frame + F_LIST3)))
        m.putWord(object + 40, annotations)
    } else if kind == K_METHOD {
        m.putWord(object + 16, arrayOf(wordsAt(frame + F_LIST1)))
        m.putWord(object + 24, arrayOf(wordsAt(frame + F_LIST2)))
        m.putWord(object + 32, annotations)
    } else if kind == K_SIGNAL {
        m.putWord(object + 16, arrayOf(wordsAt(frame + F_LIST1)))
        m.putWord(object + 24, annotations)
    } else if kind == K_PROPERTY {
        m.putWord(object + 32, annotations)
    } else if kind == K_ARG || kind == K_ANNOTATION {
        m.putWord(object + 24, annotations)
    } else {
        m.release(annotations)
    }
    const isOut = m.getWord(frame + F_LIST3) == 1 && kind == K_ARG
    m.release(frame)
    if kind == K_OTHER { return }
    if frames.*.length == 0 {
        if kind == K_NODE && m.getWord(state + 24) == 0 { m.putWord(state + 24, object) }
        return
    }
    const parent = m.wordAt(frames, frames.*.length - 1)
    const parentKind = m.getWord(parent + F_KIND)
    if kind == K_ANNOTATION {
        m.pushWord(wordsAt(parent + F_ANNOTATIONS), object)
    } else if kind == K_INTERFACE && parentKind == K_NODE {
        m.pushWord(wordsAt(parent + F_LIST1), object)
    } else if kind == K_NODE && parentKind == K_NODE {
        m.pushWord(wordsAt(parent + F_LIST2), object)
    } else if kind == K_METHOD && parentKind == K_INTERFACE {
        m.pushWord(wordsAt(parent + F_LIST1), object)
    } else if kind == K_SIGNAL && parentKind == K_INTERFACE {
        m.pushWord(wordsAt(parent + F_LIST2), object)
    } else if kind == K_PROPERTY && parentKind == K_INTERFACE {
        m.pushWord(wordsAt(parent + F_LIST3), object)
    } else if kind == K_ARG && parentKind == K_METHOD {
        m.pushWord(wordsAt(parent + (if isOut { F_LIST2 } else { F_LIST1 })), object)
    } else if kind == K_ARG && parentKind == K_SIGNAL {
        m.pushWord(wordsAt(parent + F_LIST1), object)
    }
}

export fn g_dbus_node_info_new_for_xml(xml_data: usize, err: usize) -> usize {
    if threads.onceEnter(@intFromPtr(&parserOnce)) {
        parserFuncs[0] = @intFromPtr(__mlx_glib_dbus_start)
        parserFuncs[1] = @intFromPtr(__mlx_glib_dbus_end)
        parserFuncs[2] = 0
        parserFuncs[3] = 0
        parserFuncs[4] = 0
        threads.onceLeave(@intFromPtr(&parserOnce), 1)
    }
    const state = m.alloc(32)
    const k = g_markup_parse_context_new(@intFromPtr(&parserFuncs), 0, state, 0)
    const ok = g_markup_parse_context_parse(k, xml_data, -1, err) != 0 && g_markup_parse_context_end_parse(k, err) != 0
    g_markup_parse_context_free(k)
    const root = m.getWord(state + 24)
    m.disposeWords(wordsAt(state))
    m.release(state)
    if !ok {
        if root != 0 { freeNode(root) }
        return 0
    }
    if root == 0 {
        errors.set(err, errors.quarkLiteral("g-markup-error-quark"), 5, "Expected a <node> element")
        return 0
    }
    return root
}

fn freeList(list: usize, kind: usize) -> void {
    if list == 0 { return }
    var p = list
    while m.getWord(p) != 0 {
        freeOf(m.getWord(p), kind)
        p += 8
    }
    m.release(list)
}

fn freeOf(object: usize, kind: usize) -> void {
    if kind == K_NODE {
        freeNode(object)
        return
    }
    m.release(m.getWord(object + 8))
    if kind == K_INTERFACE {
        freeList(m.getWord(object + 16), K_METHOD)
        freeList(m.getWord(object + 24), K_SIGNAL)
        freeList(m.getWord(object + 32), K_PROPERTY)
        freeList(m.getWord(object + 40), K_ANNOTATION)
    } else if kind == K_METHOD {
        freeList(m.getWord(object + 16), K_ARG)
        freeList(m.getWord(object + 24), K_ARG)
        freeList(m.getWord(object + 32), K_ANNOTATION)
    } else if kind == K_SIGNAL {
        freeList(m.getWord(object + 16), K_ARG)
        freeList(m.getWord(object + 24), K_ANNOTATION)
    } else if kind == K_PROPERTY {
        m.release(m.getWord(object + 16))
        freeList(m.getWord(object + 32), K_ANNOTATION)
    } else {
        m.release(m.getWord(object + 16))
        freeList(m.getWord(object + 24), K_ANNOTATION)
    }
    m.release(object)
}

fn freeNode(node: usize) -> void {
    m.release(m.getWord(node + 8))
    freeList(m.getWord(node + 16), K_INTERFACE)
    freeList(m.getWord(node + 24), K_NODE)
    freeList(m.getWord(node + 32), K_ANNOTATION)
    m.release(node)
}

export fn g_dbus_node_info_ref(info: usize) -> usize {
    _ = @atomicRmw(u32, m.word32(info), add, 1, acq_rel)
    return info
}

export fn g_dbus_node_info_unref(info: usize) -> void {
    if @atomicRmw(u32, m.word32(info), sub, 1, acq_rel) == 1 { freeNode(info) }
}

export fn g_dbus_interface_info_ref(info: usize) -> usize {
    _ = @atomicRmw(u32, m.word32(info), add, 1, acq_rel)
    return info
}

export fn g_dbus_interface_info_unref(info: usize) -> void {
    if @atomicRmw(u32, m.word32(info), sub, 1, acq_rel) == 1 { freeOf(info, K_INTERFACE) }
}

fn findIn(list: usize, name: usize) -> usize {
    if list == 0 { return 0 }
    var p = list
    while m.getWord(p) != 0 {
        if m.cEqual(m.getWord(m.getWord(p) + 8), name) { return m.getWord(p) }
        p += 8
    }
    return 0
}

export fn g_dbus_node_info_lookup_interface(info: usize, name: usize) -> usize { return findIn(m.getWord(info + 16), name) }
export fn g_dbus_interface_info_lookup_method(info: usize, name: usize) -> usize { return findIn(m.getWord(info + 16), name) }
export fn g_dbus_interface_info_lookup_signal(info: usize, name: usize) -> usize { return findIn(m.getWord(info + 24), name) }
export fn g_dbus_interface_info_lookup_property(info: usize, name: usize) -> usize { return findIn(m.getWord(info + 32), name) }
