// D-Bus's addresses, remote errors and introspection data
// (gdbusaddress.h, gdbuserror.h, gdbusintrospection.h). A bus's address
// is found as GIO finds it (DBUS_SYSTEM_BUS_ADDRESS or the system's
// socket, DBUS_SESSION_BUS_ADDRESS or $XDG_RUNTIME_DIR/bus; "Cannot
// autolaunch D-Bus without X11 $DISPLAY" for a session bus without an
// address). Introspection XML is parsed into GDBusNodeInfo (with GMarkup)
// and written back as GIO writes it; D-Bus's remote error names are read
// from errors' messages. Connections are dbusconnection.mlx's, proxies
// dbusproxy.mlx's.
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const messages = @import("./messages.mlx")
const ioerrors = @import("./ioerrors.mlx")
const cancellable = @import("./cancellable.mlx")

extern("c") fn stat(path: usize, buffer: usize) -> i32
extern("c") fn g_string_append_len(s: usize, text: usize, length: i64) -> usize
extern("c") fn g_markup_escape_text(text: usize, length: i64) -> usize
extern("c") fn g_markup_parse_context_new(parser: usize, flags: i32, data: usize, notify: usize) -> usize
extern("c") fn g_markup_parse_context_parse(k: usize, text: usize, length: i64, err: usize) -> i32
extern("c") fn g_markup_parse_context_end_parse(k: usize, err: usize) -> i32
extern("c") fn g_markup_parse_context_free(k: usize) -> void

const BUS_STARTER: i32 = -1
const BUS_SYSTEM: i32 = 1
const BUS_SESSION: i32 = 2

var parserFuncs: [5]usize = undefined
var parserOnce: u64 = 0

// ---------------------------------------------------------------------------
// Remote errors ("GDBus.Error:name: message")

fn remoteName(message: usize, start: *usize, end: *usize) -> bool {
    const prefix = "GDBus.Error:"
    var i: usize = 0
    while i < prefix.length {
        if m.get8(message + i) != prefix[i] { return false }
        i += 1
    }
    const begin = message + prefix.length
    var p = begin
    while m.get8(p) != 0 && m.get8(p) != ':' { p += 1 }
    if m.get8(p) != ':' || m.get8(p + 1) != ' ' { return false }
    start.* = begin
    end.* = p
    return true
}

export fn g_dbus_error_is_remote_error(e: usize) -> i32 {
    const message = errors.message(e)
    var i: usize = 0
    const prefix = "GDBus.Error:"
    while i < prefix.length {
        if m.get8(message + i) != prefix[i] { return 0 }
        i += 1
    }
    return 1
}

export fn g_dbus_error_get_remote_error(e: usize) -> usize {
    var start: usize = 0
    var end: usize = 0
    if !remoteName(errors.message(e), &start, &end) { return 0 }
    return m.dupBytes(start, end - start)
}

export fn g_dbus_error_strip_remote_error(e: usize) -> i32 {
    var start: usize = 0
    var end: usize = 0
    const message = errors.message(e)
    if !remoteName(message, &start, &end) { return 0 }
    m.putWord(e + 8, m.dup(end + 2))
    m.release(message)
    return 1
}

// ---------------------------------------------------------------------------
// Addresses and connecting

fn isSocket(path: usize) -> bool {
    const buffer = m.alloc(144)
    const good = stat(path, buffer) == 0 && (m.get32(buffer + 24) & 0o170000) == 0o140000
    m.release(buffer)
    return good
}

pub fn addressFor(busType: i32, err: usize) -> usize {
    var kind = busType
    if kind == BUS_STARTER {
        const starter = sys.getenv(m.literal("DBUS_STARTER_BUS_TYPE"))
        kind = if starter != 0 && m.cIs(starter, "system") { BUS_SYSTEM } else { BUS_SESSION }
        const address = sys.getenv(m.literal("DBUS_STARTER_ADDRESS"))
        if address != 0 { return m.dup(address) }
    }
    if kind == BUS_SYSTEM {
        const address = sys.getenv(m.literal("DBUS_SYSTEM_BUS_ADDRESS"))
        return if address != 0 { m.dup(address) } else { m.dupSlice("unix:path=/run/dbus/system_bus_socket") }
    }
    if kind == BUS_SESSION {
        const address = sys.getenv(m.literal("DBUS_SESSION_BUS_ADDRESS"))
        if address != 0 { return m.dup(address) }
        const runtime = sys.getenv(m.literal("XDG_RUNTIME_DIR"))
        if runtime != 0 {
            var path = m.text()
            m.pushC(&path, runtime)
            m.pushText(&path, "/bus")
            if isSocket(path.address) {
                var t = m.text()
                m.pushText(&t, "unix:path=")
                m.pushBytes(&t, path.address, path.length)
                m.dispose(&path)
                return m.finish(&t)
            }
            m.dispose(&path)
        }
        if sys.getenv(m.literal("DISPLAY")) == 0 {
            ioerrors.set(err, ioerrors.FAILED, "Cannot autolaunch D-Bus without X11 $DISPLAY")
        } else {
            ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Autolaunching D-Bus (dbus-launch) is not available")
        }
        return 0
    }
    ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Unknown bus type")
    return 0
}

export fn g_dbus_address_get_for_bus_sync(bus_type: i32, c: usize, err: usize) -> usize {
    if cancellable.setErrorIfCancelled(c, err) { return 0 }
    return addressFor(bus_type, err)
}

// ---------------------------------------------------------------------------
// Introspection data. The structures are GIO's: every one starts with
// its reference count and name; their lists are NULL-ended arrays.
//
// node: path 8, interfaces 16, nodes 24, annotations 32
// interface: name 8, methods 16, signals 24, properties 32, annotations 40
// method: name 8, in_args 16, out_args 24, annotations 32
// signal: name 8, args 16, annotations 24
// property: name 8, signature 16, flags 24, annotations 32
// arg: name 8, signature 16, annotations 24
// annotation: key 8, value 16, annotations 24

const K_NODE: usize = 0
const K_INTERFACE: usize = 1
const K_METHOD: usize = 2
const K_SIGNAL: usize = 3
const K_PROPERTY: usize = 4
const K_ARG: usize = 5
const K_ANNOTATION: usize = 6
const K_OTHER: usize = 7

// A frame of the parse: the kind (0), the structure (8), three lists
// (16, 40, 64) and the annotations (88).
const F_KIND: usize = 0
const F_OBJECT: usize = 8
const F_LIST1: usize = 16
const F_LIST2: usize = 40
const F_LIST3: usize = 64
const F_ANNOTATIONS: usize = 88
const F_SIZE: usize = 112

fn wordsAt(address: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, address) } }

fn attribute(names: usize, valuesArray: usize, wanted: []const u8) -> usize {
    var i: usize = 0
    while m.getWord(names + i * 8) != 0 {
        if m.cIs(m.getWord(names + i * 8), wanted) { return m.getWord(valuesArray + i * 8) }
        i += 1
    }
    return 0
}

fn dupOrNull(text: usize) -> usize { return if text == 0 { 0 } else { m.dup(text) } }

fn arrayOf(list: *m.Words) -> usize {
    m.pushWord(list, 0)
    return m.finishWords(list)
}

// The parse's state: the frames (words) and the root node (24).
export fn __mlx_glib_dbus_start(k: usize, name: usize, names: usize, valuesArray: usize, state: usize, err: usize) -> void {
    const frames = wordsAt(state)
    const frame = m.alloc(F_SIZE)
    var kind = K_OTHER
    var size: usize = 0
    if m.cIs(name, "node") {
        kind = K_NODE
        size = 40
    } else if m.cIs(name, "interface") {
        kind = K_INTERFACE
        size = 48
    } else if m.cIs(name, "method") {
        kind = K_METHOD
        size = 40
    } else if m.cIs(name, "signal") {
        kind = K_SIGNAL
        size = 32
    } else if m.cIs(name, "property") {
        kind = K_PROPERTY
        size = 40
    } else if m.cIs(name, "arg") {
        kind = K_ARG
        size = 32
    } else if m.cIs(name, "annotation") {
        kind = K_ANNOTATION
        size = 32
    }
    m.putWord(frame + F_KIND, kind)
    if size != 0 {
        const object = m.alloc(size)
        m.putI32(object, 1)
        if kind == K_ANNOTATION {
            m.putWord(object + 8, dupOrNull(attribute(names, valuesArray, "name")))
            m.putWord(object + 16, dupOrNull(attribute(names, valuesArray, "value")))
        } else {
            m.putWord(object + 8, dupOrNull(attribute(names, valuesArray, "name")))
        }
        // An arg without a name is GIO's "arg_N", N counting the method's
        // or signal's args so far.
        if kind == K_ARG && m.getWord(object + 8) == 0 && frames.*.length > 0 {
            const parent = m.wordAt(frames, frames.*.length - 1)
            const n = wordsAt(parent + F_LIST1).*.length + (if m.getWord(parent + F_KIND) == K_METHOD { wordsAt(parent + F_LIST2).*.length } else { 0 })
            var t = m.text()
            m.pushText(&t, "arg_")
            m.pushDecimal(&t, @intCast(u64, n))
            m.putWord(object + 8, m.finish(&t))
        }
        if kind == K_ARG {
            m.putWord(object + 16, dupOrNull(attribute(names, valuesArray, "type")))
            // (The direction decides the method's list it goes to.)
            const direction = attribute(names, valuesArray, "direction")
            m.putWord(frame + F_LIST3, if direction != 0 && m.cIs(direction, "out") { 1 } else { 0 })
        }
        if kind == K_PROPERTY {
            m.putWord(object + 16, dupOrNull(attribute(names, valuesArray, "type")))
            const access = attribute(names, valuesArray, "access")
            var flags: i32 = 0
            if access != 0 && (m.cIs(access, "read") || m.cIs(access, "readwrite")) { flags = flags | 1 }
            if access != 0 && (m.cIs(access, "write") || m.cIs(access, "readwrite")) { flags = flags | 2 }
            m.putI32(object + 24, flags)
        }
        m.putWord(frame + F_OBJECT, object)
    }
    m.pushWord(frames, frame)
}

export fn __mlx_glib_dbus_end(k: usize, name: usize, state: usize, err: usize) -> void {
    const frames = wordsAt(state)
    const frame = m.wordAt(frames, frames.*.length - 1)
    frames.*.length -= 1
    const kind = m.getWord(frame + F_KIND)
    const object = m.getWord(frame + F_OBJECT)
    const annotations = arrayOf(wordsAt(frame + F_ANNOTATIONS))
    if kind == K_NODE {
        m.putWord(object + 16, arrayOf(wordsAt(frame + F_LIST1)))
        m.putWord(object + 24, arrayOf(wordsAt(frame + F_LIST2)))
        m.putWord(object + 32, annotations)
    } else if kind == K_INTERFACE {
        m.putWord(object + 16, arrayOf(wordsAt(frame + F_LIST1)))
        m.putWord(object + 24, arrayOf(wordsAt(frame + F_LIST2)))
        m.putWord(object + 32, arrayOf(wordsAt(frame + F_LIST3)))
        m.putWord(object + 40, annotations)
    } else if kind == K_METHOD {
        m.putWord(object + 16, arrayOf(wordsAt(frame + F_LIST1)))
        m.putWord(object + 24, arrayOf(wordsAt(frame + F_LIST2)))
        m.putWord(object + 32, annotations)
    } else if kind == K_SIGNAL {
        m.putWord(object + 16, arrayOf(wordsAt(frame + F_LIST1)))
        m.putWord(object + 24, annotations)
    } else if kind == K_PROPERTY {
        m.putWord(object + 32, annotations)
    } else if kind == K_ARG || kind == K_ANNOTATION {
        m.putWord(object + 24, annotations)
    } else {
        m.release(annotations)
    }
    const isOut = m.getWord(frame + F_LIST3) == 1 && kind == K_ARG
    m.release(frame)
    if kind == K_OTHER { return }
    if frames.*.length == 0 {
        if kind == K_NODE && m.getWord(state + 24) == 0 { m.putWord(state + 24, object) }
        return
    }
    const parent = m.wordAt(frames, frames.*.length - 1)
    const parentKind = m.getWord(parent + F_KIND)
    if kind == K_ANNOTATION {
        m.pushWord(wordsAt(parent + F_ANNOTATIONS), object)
    } else if kind == K_INTERFACE && parentKind == K_NODE {
        m.pushWord(wordsAt(parent + F_LIST1), object)
    } else if kind == K_NODE && parentKind == K_NODE {
        m.pushWord(wordsAt(parent + F_LIST2), object)
    } else if kind == K_METHOD && parentKind == K_INTERFACE {
        m.pushWord(wordsAt(parent + F_LIST1), object)
    } else if kind == K_SIGNAL && parentKind == K_INTERFACE {
        m.pushWord(wordsAt(parent + F_LIST2), object)
    } else if kind == K_PROPERTY && parentKind == K_INTERFACE {
        m.pushWord(wordsAt(parent + F_LIST3), object)
    } else if kind == K_ARG && parentKind == K_METHOD {
        m.pushWord(wordsAt(parent + (if isOut { F_LIST2 } else { F_LIST1 })), object)
    } else if kind == K_ARG && parentKind == K_SIGNAL {
        m.pushWord(wordsAt(parent + F_LIST1), object)
    }
}

export fn g_dbus_node_info_new_for_xml(xml_data: usize, err: usize) -> usize {
    if threads.onceEnter(@intFromPtr(&parserOnce)) {
        parserFuncs[0] = @intFromPtr(__mlx_glib_dbus_start)
        parserFuncs[1] = @intFromPtr(__mlx_glib_dbus_end)
        parserFuncs[2] = 0
        parserFuncs[3] = 0
        parserFuncs[4] = 0
        threads.onceLeave(@intFromPtr(&parserOnce), 1)
    }
    const state = m.alloc(32)
    const k = g_markup_parse_context_new(@intFromPtr(&parserFuncs), 0, state, 0)
    const ok = g_markup_parse_context_parse(k, xml_data, -1, err) != 0 && g_markup_parse_context_end_parse(k, err) != 0
    g_markup_parse_context_free(k)
    const root = m.getWord(state + 24)
    m.disposeWords(wordsAt(state))
    m.release(state)
    if !ok {
        if root != 0 { freeNode(root) }
        return 0
    }
    if root == 0 {
        errors.set(err, errors.quarkLiteral("g-markup-error-quark"), 5, "Expected a <node> element")
        return 0
    }
    return root
}

fn freeList(list: usize, kind: usize) -> void {
    if list == 0 { return }
    var p = list
    while m.getWord(p) != 0 {
        freeOf(m.getWord(p), kind)
        p += 8
    }
    m.release(list)
}

fn freeOf(object: usize, kind: usize) -> void {
    if kind == K_NODE {
        freeNode(object)
        return
    }
    m.release(m.getWord(object + 8))
    if kind == K_INTERFACE {
        freeList(m.getWord(object + 16), K_METHOD)
        freeList(m.getWord(object + 24), K_SIGNAL)
        freeList(m.getWord(object + 32), K_PROPERTY)
        freeList(m.getWord(object + 40), K_ANNOTATION)
    } else if kind == K_METHOD {
        freeList(m.getWord(object + 16), K_ARG)
        freeList(m.getWord(object + 24), K_ARG)
        freeList(m.getWord(object + 32), K_ANNOTATION)
    } else if kind == K_SIGNAL {
        freeList(m.getWord(object + 16), K_ARG)
        freeList(m.getWord(object + 24), K_ANNOTATION)
    } else if kind == K_PROPERTY {
        m.release(m.getWord(object + 16))
        freeList(m.getWord(object + 32), K_ANNOTATION)
    } else {
        m.release(m.getWord(object + 16))
        freeList(m.getWord(object + 24), K_ANNOTATION)
    }
    m.release(object)
}

fn freeNode(node: usize) -> void {
    m.release(m.getWord(node + 8))
    freeList(m.getWord(node + 16), K_INTERFACE)
    freeList(m.getWord(node + 24), K_NODE)
    freeList(m.getWord(node + 32), K_ANNOTATION)
    m.release(node)
}

// Static data (a C program's own, its count -1) are not counted.
fn infoRef(info: usize) -> usize {
    if m.getI32(info) != -1 { _ = @atomicRmw(u32, m.word32(info), add, 1, acq_rel) }
    return info
}

fn infoUnref(info: usize) -> bool {
    if m.getI32(info) == -1 { return false }
    return @atomicRmw(u32, m.word32(info), sub, 1, acq_rel) == 1
}

export fn g_dbus_node_info_ref(info: usize) -> usize { return infoRef(info) }

export fn g_dbus_node_info_unref(info: usize) -> void {
    if infoUnref(info) { freeNode(info) }
}

pub fn interfaceRef(info: usize) -> usize { return infoRef(info) }

pub fn interfaceUnref(info: usize) -> void {
    if infoUnref(info) { freeOf(info, K_INTERFACE) }
}

export fn g_dbus_interface_info_ref(info: usize) -> usize { return infoRef(info) }
export fn g_dbus_interface_info_unref(info: usize) -> void { interfaceUnref(info) }

// The entry of a NULL-ended list (of any of the info structures, each
// with its name at 8) named `name`, 0 when none.
pub fn lookup(list: usize, name: usize) -> usize {
    if list == 0 || name == 0 { return 0 }
    var p = list
    while m.getWord(p) != 0 {
        if m.cEqual(m.getWord(m.getWord(p) + 8), name) { return m.getWord(p) }
        p += 8
    }
    return 0
}

export fn g_dbus_node_info_lookup_interface(info: usize, name: usize) -> usize { return lookup(m.getWord(info + 16), name) }
export fn g_dbus_interface_info_lookup_method(info: usize, name: usize) -> usize { return lookup(m.getWord(info + 16), name) }
export fn g_dbus_interface_info_lookup_signal(info: usize, name: usize) -> usize { return lookup(m.getWord(info + 24), name) }
export fn g_dbus_interface_info_lookup_property(info: usize, name: usize) -> usize { return lookup(m.getWord(info + 32), name) }

// ---------------------------------------------------------------------------
// Introspection XML, as GIO writes it (g_dbus_*_info_generate_xml): two
// more spaces of indent for each level, an element without children
// closed at once.

fn indent(t: *m.Text, count: usize) -> void {
    var i: usize = 0
    while i < count {
        m.pushByte(t, 32)
        i += 1
    }
}

fn pushEscaped(t: *m.Text, text: usize) -> void {
    const escaped = g_markup_escape_text(text, -1)
    m.pushC(t, escaped)
    m.release(escaped)
}

fn hasAny(list: usize) -> bool { return list != 0 }

fn annotationsXml(list: usize, level: usize, t: *m.Text) -> void {
    var p = list
    while p != 0 && m.getWord(p) != 0 {
        const a = m.getWord(p)
        indent(t, level)
        m.pushText(t, "<annotation name=\"")
        pushEscaped(t, m.getWord(a + 8))
        m.pushText(t, "\" value=\"")
        pushEscaped(t, m.getWord(a + 16))
        m.pushText(t, "\"")
        if !hasAny(m.getWord(a + 24)) {
            m.pushText(t, "/>\n")
        } else {
            m.pushText(t, ">\n")
            annotationsXml(m.getWord(a + 24), level + 2, t)
            indent(t, level)
            m.pushText(t, "</annotation>\n")
        }
        p += 8
    }
}

fn argsXml(list: usize, level: usize, direction: []const u8, t: *m.Text) -> void {
    var p = list
    while p != 0 && m.getWord(p) != 0 {
        const a = m.getWord(p)
        indent(t, level)
        m.pushText(t, "<arg type=\"")
        m.pushC(t, m.getWord(a + 16))
        m.pushText(t, "\"")
        if m.getWord(a + 8) != 0 {
            m.pushText(t, " name=\"")
            m.pushC(t, m.getWord(a + 8))
            m.pushText(t, "\"")
        }
        if direction.length > 0 {
            m.pushText(t, " ")
            m.pushText(t, direction)
        }
        if !hasAny(m.getWord(a + 24)) {
            m.pushText(t, "/>\n")
        } else {
            m.pushText(t, ">\n")
            annotationsXml(m.getWord(a + 24), level + 2, t)
            indent(t, level)
            m.pushText(t, "</arg>\n")
        }
        p += 8
    }
}

pub fn interfaceXml(info: usize, level: usize, t: *m.Text) -> void {
    indent(t, level)
    m.pushText(t, "<interface name=\"")
    m.pushC(t, m.getWord(info + 8))
    m.pushText(t, "\">\n")
    annotationsXml(m.getWord(info + 40), level + 2, t)
    var p = m.getWord(info + 16)
    while p != 0 && m.getWord(p) != 0 {
        const method = m.getWord(p)
        indent(t, level + 2)
        m.pushText(t, "<method name=\"")
        m.pushC(t, m.getWord(method + 8))
        m.pushText(t, "\"")
        if !hasAny(m.getWord(method + 32)) && !hasAny(m.getWord(method + 16)) && !hasAny(m.getWord(method + 24)) {
            m.pushText(t, "/>\n")
        } else {
            m.pushText(t, ">\n")
            annotationsXml(m.getWord(method + 32), level + 4, t)
            argsXml(m.getWord(method + 16), level + 4, "direction=\"in\"", t)
            argsXml(m.getWord(method + 24), level + 4, "direction=\"out\"", t)
            indent(t, level + 2)
            m.pushText(t, "</method>\n")
        }
        p += 8
    }
    p = m.getWord(info + 24)
    while p != 0 && m.getWord(p) != 0 {
        const signal = m.getWord(p)
        indent(t, level + 2)
        m.pushText(t, "<signal name=\"")
        m.pushC(t, m.getWord(signal + 8))
        m.pushText(t, "\"")
        if !hasAny(m.getWord(signal + 24)) && !hasAny(m.getWord(signal + 16)) {
            m.pushText(t, "/>\n")
        } else {
            m.pushText(t, ">\n")
            annotationsXml(m.getWord(signal + 24), level + 4, t)
            argsXml(m.getWord(signal + 16), level + 4, "", t)
            indent(t, level + 2)
            m.pushText(t, "</signal>\n")
        }
        p += 8
    }
    p = m.getWord(info + 32)
    while p != 0 && m.getWord(p) != 0 {
        const property = m.getWord(p)
        const flags = m.get32(property + 24)
        indent(t, level + 2)
        m.pushText(t, "<property type=\"")
        m.pushC(t, m.getWord(property + 16))
        m.pushText(t, "\" name=\"")
        m.pushC(t, m.getWord(property + 8))
        m.pushText(t, "\" access=\"")
        if (flags & 3) == 3 {
            m.pushText(t, "readwrite")
        } else if (flags & 1) != 0 {
            m.pushText(t, "read")
        } else {
            m.pushText(t, "write")
        }
        m.pushText(t, "\"")
        if !hasAny(m.getWord(property + 32)) {
            m.pushText(t, "/>\n")
        } else {
            m.pushText(t, ">\n")
            annotationsXml(m.getWord(property + 32), level + 4, t)
            indent(t, level + 2)
            m.pushText(t, "</property>\n")
        }
        p += 8
    }
    indent(t, level)
    m.pushText(t, "</interface>\n")
}

fn nodeXml(info: usize, level: usize, t: *m.Text) -> void {
    indent(t, level)
    m.pushText(t, "<node")
    if m.getWord(info + 8) != 0 {
        m.pushText(t, " name=\"")
        m.pushC(t, m.getWord(info + 8))
        m.pushText(t, "\"")
    }
    if !hasAny(m.getWord(info + 16)) && !hasAny(m.getWord(info + 24)) && !hasAny(m.getWord(info + 32)) {
        m.pushText(t, "/>\n")
        return
    }
    m.pushText(t, ">\n")
    annotationsXml(m.getWord(info + 32), level + 2, t)
    var p = m.getWord(info + 16)
    while p != 0 && m.getWord(p) != 0 {
        interfaceXml(m.getWord(p), level + 2, t)
        p += 8
    }
    p = m.getWord(info + 24)
    while p != 0 && m.getWord(p) != 0 {
        nodeXml(m.getWord(p), level + 2, t)
        p += 8
    }
    indent(t, level)
    m.pushText(t, "</node>\n")
}

export fn g_dbus_interface_info_generate_xml(info: usize, level: u32, string_builder: usize) -> void {
    var t = m.text()
    interfaceXml(info, @intCast(usize, level), &t)
    _ = g_string_append_len(string_builder, t.address, @intCast(i64, t.length))
    m.dispose(&t)
}

export fn g_dbus_node_info_generate_xml(info: usize, level: u32, string_builder: usize) -> void {
    var t = m.text()
    nodeXml(info, @intCast(usize, level), &t)
    _ = g_string_append_len(string_builder, t.address, @intCast(i64, t.length))
    m.dispose(&t)
}
