pub const ReadFn = fn(usize, usize, usize, usize, usize) -> i64
pub const SkipFn = fn(usize, usize, usize, usize) -> i64
pub const CloseFn = fn(usize, usize, usize) -> i32
pub const ReadAsyncFn = fn(usize, usize, usize, i32, usize, usize, usize) -> void
pub const SkipAsyncFn = fn(usize, usize, i32, usize, usize, usize) -> void
pub const CloseAsyncFn = fn(usize, i32, usize, usize, usize) -> void
pub const FinishFn = fn(usize, usize, usize) -> i64
pub const BoolFinishFn = fn(usize, usize, usize) -> i32
pub const WriteFn = fn(usize, usize, usize, usize, usize) -> i64
pub const SpliceFn = fn(usize, usize, i32, usize, usize) -> i64
pub const FlushFn = fn(usize, usize, usize) -> i32
pub const WriteAsyncFn = fn(usize, usize, usize, i32, usize, usize, usize) -> void
pub const SpliceAsyncFn = fn(usize, usize, i32, i32, usize, usize, usize) -> void
pub const Callback = fn(usize, usize, usize) -> void
pub const CanPollFn = fn(usize) -> i32
pub const CreateSourceFn = fn(usize, usize) -> usize
pub const NonblockingFn = fn(usize, usize, usize, usize) -> i64
pub const PollableSourceFunc = fn(usize, usize) -> i32
pub const ReallocFn = fn(usize, usize) -> usize
pub const DestroyFn = fn(usize) -> void
pub const StreamFn = fn(usize) -> usize

// GInputStreamClass (GObjectClass 136): read_fn, skip, close_fn,
// read_async, read_finish, skip_async, skip_finish, close_async,
// close_finish, five reserved.
const IN_READ: usize = 136
const IN_SKIP: usize = 144
const IN_CLOSE: usize = 152
const IN_READ_ASYNC: usize = 160
const IN_READ_FINISH: usize = 168
const IN_SKIP_ASYNC: usize = 176
const IN_SKIP_FINISH: usize = 184
const IN_CLOSE_ASYNC: usize = 192
const IN_CLOSE_FINISH: usize = 200
const IN_CLASS_SIZE: usize = 248

// GOutputStreamClass: write_fn, splice, flush, close_fn, write_async,
// write_finish, splice_async, splice_finish, flush_async, flush_finish,
// close_async, close_finish, writev_fn, writev_async, writev_finish,
// five reserved.
const OUT_WRITE: usize = 136
const OUT_SPLICE: usize = 144
const OUT_FLUSH: usize = 152
const OUT_CLOSE: usize = 160
const OUT_WRITE_ASYNC: usize = 168
const OUT_WRITE_FINISH: usize = 176
const OUT_SPLICE_ASYNC: usize = 184
const OUT_SPLICE_FINISH: usize = 192
const OUT_FLUSH_ASYNC: usize = 200
const OUT_FLUSH_FINISH: usize = 208
const OUT_CLOSE_ASYNC: usize = 216
const OUT_CLOSE_FINISH: usize = 224
const OUT_CLASS_SIZE: usize = 296

// GIOStreamClass: get_input_stream, get_output_stream, close_fn,
// close_async, close_finish.
const IO_GET_INPUT: usize = 136
const IO_GET_OUTPUT: usize = 144
const IO_CLOSE: usize = 152
const IO_CLOSE_ASYNC: usize = 160
const IO_CLOSE_FINISH: usize = 168

// The pollable interfaces (GTypeInterface 16): can_poll, is_readable or
// is_writable, create_source, read_nonblocking or write_nonblocking (and
// writev_nonblocking).
const POLL_CAN_POLL: usize = 16
const POLL_READY: usize = 24
const POLL_CREATE_SOURCE: usize = 32
const POLL_NONBLOCKING: usize = 40

const G_IO_IN: i32 = 1
const G_IO_OUT: i32 = 4

// GParamFlags.
const READABLE: i32 = 1
const WRITABLE: i32 = 2
const CONSTRUCT: i32 = 4
const CONSTRUCT_ONLY: i32 = 8
const STATIC_STRINGS: i32 = 224

const SPLICE_CLOSE_SOURCE: i32 = 1
const SPLICE_CLOSE_TARGET: i32 = 2

const CHUNK: usize = 8192
const MAX_COUNT: usize = 9223372036854775807

var typesOnce: u64 = 0
var inputType: usize = 0
var outputType: usize = 0
var filterInputType: usize = 0
var filterOutputType: usize = 0
var memoryInputType: usize = 0
var memoryOutputType: usize = 0
var pollableInputType: usize = 0
var pollableOutputType: usize = 0
var seekableType: usize = 0
var socketInputType: usize = 0
var socketOutputType: usize = 0
var simpleIOType: usize = 0
var filterInputPrivate: i32 = 8
var filterOutputPrivate: i32 = 8
var pollableSourceFuncs: [6]usize = undefined

// The tags of the asynchronous operations whose results the stream's
// own functions make (a zero count, an error reported before the class
// was asked), as GIO tags them with the public functions.
var tagRead: u8 = 0
var tagSkip: u8 = 0
var tagClose: u8 = 0
var tagReadAll: u8 = 0
var tagReadBytes: u8 = 0
var tagWrite: u8 = 0
var tagWriteAll: u8 = 0
var tagWriteBytes: u8 = 0
var tagSplice: u8 = 0
var tagFlush: u8 = 0
var tagOutClose: u8 = 0
var tagIOClose: u8 = 0
var tagRealRead: u8 = 0
var tagRealSkip: u8 = 0
var tagRealClose: u8 = 0
var tagRealWrite: u8 = 0
var tagRealSplice: u8 = 0
var tagRealFlush: u8 = 0
var tagRealOutClose: u8 = 0

fn tag(t: *u8) -> usize { return @intFromPtr(t) }

fn word(object: usize, offset: usize) -> usize { return m.getWord(object + offset) }
fn classOf(object: usize) -> usize { return m.getWord(object) }
fn slot(object: usize, offset: usize) -> usize { return m.getWord(classOf(object) + offset) }

// An error of GIO's: "Too large count value passed to FUNCTION".
fn tooLarge(err: usize, function: []const u8) -> void {
    var t = m.text()
    m.pushText(&t, "Too large count value passed to ")
    m.pushText(&t, function)
    ioerrors.setText(err, ioerrors.INVALID_ARGUMENT, &t)
}

fn critical(text: []const u8) -> void { messages.logText(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, text) }

// ---------------------------------------------------------------------------
// The types

export fn __mlx_glib_filter_input_class_init(class: usize, data: usize) -> void {
    g_type_class_adjust_private_offset(class, @intFromPtr(&filterInputPrivate))
    m.putWord(class + 24, @intFromPtr(__mlx_glib_filter_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_filter_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_filter_input_finalize))
    m.putWord(class + IN_READ, @intFromPtr(__mlx_glib_filter_input_read))
    m.putWord(class + IN_SKIP, @intFromPtr(__mlx_glib_filter_input_skip))
    m.putWord(class + IN_CLOSE, @intFromPtr(__mlx_glib_filter_input_close))
    filterProperties(class, inputType)
}

export fn __mlx_glib_filter_output_class_init(class: usize, data: usize) -> void {
    g_type_class_adjust_private_offset(class, @intFromPtr(&filterOutputPrivate))
    m.putWord(class + 24, @intFromPtr(__mlx_glib_filter_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_filter_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_filter_output_finalize))
    m.putWord(class + OUT_WRITE, @intFromPtr(__mlx_glib_filter_output_write))
    m.putWord(class + OUT_FLUSH, @intFromPtr(__mlx_glib_filter_output_flush))
    m.putWord(class + OUT_CLOSE, @intFromPtr(__mlx_glib_filter_output_close))
    filterProperties(class, outputType)
}

fn filterProperties(class: usize, baseType: usize) -> void {
    g_object_class_install_property(class, 1, g_param_spec_object(m.literal("base-stream"), m.literal("base-stream"), m.literal("base-stream"), baseType, READABLE | WRITABLE | CONSTRUCT_ONLY | STATIC_STRINGS))
    g_object_class_install_property(class, 2, g_param_spec_boolean(m.literal("close-base-stream"), m.literal("close-base-stream"), m.literal("close-base-stream"), 1, READABLE | WRITABLE | CONSTRUCT | STATIC_STRINGS))
}

fn implement(t: usize, iface: usize, init: usize) -> void {
    const info = m.alloc(24)
    m.putWord(info, init)
    g_type_add_interface_static(t, iface, info)
    m.release(info)
}

fn ensureTypes() -> void {
    if threads.onceEnter(@intFromPtr(&typesOnce)) {
        types.ensureInit()
        inputType = ioerrors.defineType(types.T_OBJECT, "GInputStream", IN_CLASS_SIZE, @intFromPtr(__mlx_glib_input_class_init), 32, @intFromPtr(__mlx_glib_input_init), types.ABSTRACT)
        outputType = ioerrors.defineType(types.T_OBJECT, "GOutputStream", OUT_CLASS_SIZE, @intFromPtr(__mlx_glib_output_class_init), 32, @intFromPtr(__mlx_glib_output_init), types.ABSTRACT)
        pollableInputType = ioerrors.defineType(types.T_INTERFACE, "GPollableInputStream", 48, 0, 0, 0, 0)
        g_type_interface_add_prerequisite(pollableInputType, inputType)
        pollableOutputType = ioerrors.defineType(types.T_INTERFACE, "GPollableOutputStream", 56, 0, 0, 0, 0)
        g_type_interface_add_prerequisite(pollableOutputType, outputType)
        seekableType = ioerrors.defineType(types.T_INTERFACE, "GSeekable", 72, 0, 0, 0, 0)
        g_type_interface_add_prerequisite(seekableType, types.T_OBJECT)
        filterInputType = ioerrors.defineType(inputType, "GFilterInputStream", IN_CLASS_SIZE + 24, @intFromPtr(__mlx_glib_filter_input_class_init), 40, 0, types.ABSTRACT)
        filterOutputType = ioerrors.defineType(outputType, "GFilterOutputStream", OUT_CLASS_SIZE + 24, @intFromPtr(__mlx_glib_filter_output_class_init), 40, 0, types.ABSTRACT)
        memoryInputType = ioerrors.defineType(inputType, "GMemoryInputStream", IN_CLASS_SIZE + 40, @intFromPtr(__mlx_glib_memory_input_class_init), 40, @intFromPtr(__mlx_glib_memory_input_init), 0)
        implement(memoryInputType, pollableInputType, @intFromPtr(__mlx_glib_memory_input_pollable_init))
        implement(memoryInputType, seekableType, @intFromPtr(__mlx_glib_memory_input_seekable_init))
        memoryOutputType = ioerrors.defineType(outputType, "GMemoryOutputStream", OUT_CLASS_SIZE + 40, @intFromPtr(__mlx_glib_memory_output_class_init), 40, @intFromPtr(__mlx_glib_memory_output_init), 0)
        implement(memoryOutputType, pollableOutputType, @intFromPtr(__mlx_glib_memory_output_pollable_init))
        socketInputType = ioerrors.defineType(inputType, "GSocketInputStream", IN_CLASS_SIZE, @intFromPtr(__mlx_glib_socket_input_class_init), 40, 0, 0)
        implement(socketInputType, pollableInputType, @intFromPtr(__mlx_glib_socket_input_pollable_init))
        socketOutputType = ioerrors.defineType(outputType, "GSocketOutputStream", OUT_CLASS_SIZE, @intFromPtr(__mlx_glib_socket_output_class_init), 40, 0, 0)
        implement(socketOutputType, pollableOutputType, @intFromPtr(__mlx_glib_socket_output_pollable_init))
        simpleIOType = ioerrors.defineType(g_io_stream_type(), "GSimpleIOStream", 256, @intFromPtr(__mlx_glib_simple_io_class_init), 32, 0, 0)
        pollableSourceFuncs[0] = 0
        pollableSourceFuncs[1] = 0
        pollableSourceFuncs[2] = @intFromPtr(__mlx_glib_pollable_source_dispatch)
        pollableSourceFuncs[3] = @intFromPtr(__mlx_glib_pollable_source_finalize)
        pollableSourceFuncs[4] = 0
        pollableSourceFuncs[5] = 0
        threads.onceLeave(@intFromPtr(&typesOnce), 1)
    }
}

extern("c") fn g_io_stream_get_type() -> usize
fn g_io_stream_type() -> usize { return g_io_stream_get_type() }

export fn g_input_stream_get_type() -> usize {
    ensureTypes()
    return inputType
}
export fn g_output_stream_get_type() -> usize {
    ensureTypes()
    return outputType
}
export fn g_filter_input_stream_get_type() -> usize {
    ensureTypes()
    return filterInputType
}
export fn g_filter_output_stream_get_type() -> usize {
    ensureTypes()
    return filterOutputType
}
export fn g_memory_input_stream_get_type() -> usize {
    ensureTypes()
    return memoryInputType
}
export fn g_memory_output_stream_get_type() -> usize {
    ensureTypes()
    return memoryOutputType
}
export fn g_pollable_input_stream_get_type() -> usize {
    ensureTypes()
    return pollableInputType
}
export fn g_pollable_output_stream_get_type() -> usize {
    ensureTypes()
    return pollableOutputType
}
export fn g_seekable_get_type() -> usize {
    ensureTypes()
    return seekableType
}
export fn g_simple_io_stream_get_type() -> usize {
    ensureTypes()
    return simpleIOType
}

pub fn inputGType() -> usize {
    ensureTypes()
    return inputType
}
pub fn seekableGType() -> usize {
    ensureTypes()
    return seekableType
}
pub const INPUT_CLASS_SIZE: usize = IN_CLASS_SIZE
pub fn outputGType() -> usize {
    ensureTypes()
    return outputType
}

fn isA(object: usize, t: usize) -> bool { return object != 0 && g_type_check_instance_is_a(object, t) != 0 }

// ---------------------------------------------------------------------------
// The pollable source: dispatched when its child sources are (the
// stream's own readiness, a cancellable), calling GPollableSourceFunc.

export fn __mlx_glib_pollable_source_dispatch(source: usize, callback: usize, user_data: usize) -> i32 {
    if callback == 0 { return 0 }
    const call: PollableSourceFunc = unsafe { @ptrFromInt(PollableSourceFunc, callback) }
    return call(m.getWord(source + 96), user_data)
}

export fn __mlx_glib_pollable_source_finalize(source: usize) -> void { g_object_unref(m.getWord(source + 96)) }

export fn __mlx_glib_pollable_dummy(data: usize) -> i32 { return 1 }

fn pollableSource(stream: usize) -> usize {
    ensureTypes()
    const source = g_source_new(@intFromPtr(&pollableSourceFuncs), 104)
    g_source_set_static_name(source, m.literal("GPollableSource"))
    m.putWord(source + 96, g_object_ref(stream))
    return source
}

export fn g_pollable_source_new(pollable_stream: usize) -> usize { return pollableSource(pollable_stream) }

export fn g_pollable_source_new_full(pollable_stream: usize, child_source: usize, c: usize) -> usize {
    const source = pollableSource(pollable_stream)
    if child_source != 0 {
        g_source_set_callback(child_source, @intFromPtr(__mlx_glib_pollable_dummy), 0, 0)
        g_source_add_child_source(source, child_source)
    }
    if c != 0 {
        const cancellableSource = g_cancellable_source_new(c)
        g_source_set_callback(cancellableSource, @intFromPtr(__mlx_glib_pollable_dummy), 0, 0)
        g_source_add_child_source(source, cancellableSource)
        g_source_unref(cancellableSource)
    }
    return source
}

fn pollVtable(stream: usize, iface: usize) -> usize {
    ensureTypes()
    if stream == 0 { return 0 }
    return g_type_interface_peek(classOf(stream), iface)
}

fn callCanPoll(vtable: usize, stream: usize) -> bool {
    const f = m.getWord(vtable + POLL_CAN_POLL)
    if f == 0 { return true }
    const call: CanPollFn = unsafe { @ptrFromInt(CanPollFn, f) }
    return call(stream) != 0
}

// Whether `stream` is a pollable input stream that can poll now.
fn inputCanPoll(stream: usize) -> bool {
    const vtable = pollVtable(stream, pollableInputType)
    return vtable != 0 && callCanPoll(vtable, stream)
}

fn outputCanPoll(stream: usize) -> bool {
    const vtable = pollVtable(stream, pollableOutputType)
    return vtable != 0 && callCanPoll(vtable, stream)
}

export fn g_pollable_input_stream_can_poll(stream: usize) -> i32 { return if inputCanPoll(stream) { 1 } else { 0 } }
export fn g_pollable_output_stream_can_poll(stream: usize) -> i32 { return if outputCanPoll(stream) { 1 } else { 0 } }

export fn g_pollable_input_stream_is_readable(stream: usize) -> i32 {
    const vtable = pollVtable(stream, pollableInputType)
    if vtable == 0 || m.getWord(vtable + POLL_READY) == 0 { return 0 }
    const call: CanPollFn = unsafe { @ptrFromInt(CanPollFn, m.getWord(vtable + POLL_READY)) }
    return call(stream)
}

export fn g_pollable_output_stream_is_writable(stream: usize) -> i32 {
    const vtable = pollVtable(stream, pollableOutputType)
    if vtable == 0 || m.getWord(vtable + POLL_READY) == 0 { return 0 }
    const call: CanPollFn = unsafe { @ptrFromInt(CanPollFn, m.getWord(vtable + POLL_READY)) }
    return call(stream)
}

fn createSource(stream: usize, iface: usize, c: usize) -> usize {
    const vtable = pollVtable(stream, iface)
    if vtable == 0 || m.getWord(vtable + POLL_CREATE_SOURCE) == 0 { return 0 }
    const call: CreateSourceFn = unsafe { @ptrFromInt(CreateSourceFn, m.getWord(vtable + POLL_CREATE_SOURCE)) }
    return call(stream, c)
}

export fn g_pollable_input_stream_create_source(stream: usize, c: usize) -> usize { return createSource(stream, pollableInputType, c) }
export fn g_pollable_output_stream_create_source(stream: usize, c: usize) -> usize { return createSource(stream, pollableOutputType, c) }

// GIO's read_nonblocking: the count checked, the cancellable checked and
// current while the stream's own runs.
fn nonblocking(stream: usize, iface: usize, buffer: usize, count: usize, c: usize, err: usize, function: []const u8) -> i64 {
    if count == 0 { return 0 }
    if count > MAX_COUNT {
        tooLarge(err, function)
        return -1
    }
    if cancellable.setErrorIfCancelled(c, err) { return -1 }
    const vtable = pollVtable(stream, iface)
    if vtable == 0 || m.getWord(vtable + POLL_NONBLOCKING) == 0 { return -1 }
    const call: NonblockingFn = unsafe { @ptrFromInt(NonblockingFn, m.getWord(vtable + POLL_NONBLOCKING)) }
    if c != 0 { g_cancellable_push_current(c) }
    const result = call(stream, buffer, count, err)
    if c != 0 { g_cancellable_pop_current(c) }
    return result
}

export fn g_pollable_input_stream_read_nonblocking(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 {
    return nonblocking(stream, pollableInputType, buffer, count, c, err, "g_pollable_input_stream_read_nonblocking")
}

export fn g_pollable_output_stream_write_nonblocking(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 {
    return nonblocking(stream, pollableOutputType, buffer, count, c, err, "g_pollable_output_stream_write_nonblocking")
}

// ---------------------------------------------------------------------------
// GInputStream

fn inRec(stream: usize) -> usize { return word(stream, 24) }

export fn __mlx_glib_input_init(stream: usize, class: usize) -> void { m.putWord(stream + 24, m.alloc(16)) }

export fn __mlx_glib_input_dispose(stream: usize) -> void {
    if m.get32(inRec(stream)) == 0 { _ = inputClose(stream, 0, 0) }
    ioerrors.chainUp(types.T_OBJECT, 40, stream)
}

export fn __mlx_glib_input_finalize(stream: usize) -> void {
    m.release(inRec(stream))
    ioerrors.chainUp(types.T_OBJECT, 48, stream)
}

export fn __mlx_glib_input_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 40, @intFromPtr(__mlx_glib_input_dispose))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_input_finalize))
    m.putWord(class + IN_SKIP, @intFromPtr(__mlx_glib_input_real_skip))
    m.putWord(class + IN_READ_ASYNC, @intFromPtr(__mlx_glib_input_real_read_async))
    m.putWord(class + IN_READ_FINISH, @intFromPtr(__mlx_glib_input_real_read_finish))
    m.putWord(class + IN_SKIP_ASYNC, @intFromPtr(__mlx_glib_input_real_skip_async))
    m.putWord(class + IN_SKIP_FINISH, @intFromPtr(__mlx_glib_input_real_skip_finish))
    m.putWord(class + IN_CLOSE_ASYNC, @intFromPtr(__mlx_glib_input_real_close_async))
    m.putWord(class + IN_CLOSE_FINISH, @intFromPtr(__mlx_glib_input_real_close_finish))
}

pub fn inputIsClosed(stream: usize) -> bool { return m.get32(inRec(stream)) != 0 }

fn inputSetPending(stream: usize, err: usize) -> bool {
    const r = inRec(stream)
    if m.get32(r) != 0 {
        ioerrors.set(err, ioerrors.CLOSED, "Stream is already closed")
        return false
    }
    if m.get32(r + 4) != 0 {
        ioerrors.set(err, ioerrors.PENDING, "Stream has outstanding operation")
        return false
    }
    m.put32(r + 4, 1)
    return true
}

fn inputClearPending(stream: usize) -> void { m.put32(inRec(stream) + 4, 0) }

export fn g_input_stream_is_closed(stream: usize) -> i32 { return if inputIsClosed(stream) { 1 } else { 0 } }
export fn g_input_stream_has_pending(stream: usize) -> i32 { return @bitCast(i32, m.get32(inRec(stream) + 4)) }
export fn g_input_stream_set_pending(stream: usize, err: usize) -> i32 { return if inputSetPending(stream, err) { 1 } else { 0 } }
export fn g_input_stream_clear_pending(stream: usize) -> void { inputClearPending(stream) }

fn callRead(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 {
    const f = slot(stream, IN_READ)
    if f == 0 {
        ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Input stream doesn\u{2019}t implement read")
        return -1
    }
    const call: ReadFn = unsafe { @ptrFromInt(ReadFn, f) }
    if c != 0 { g_cancellable_push_current(c) }
    const result = call(stream, buffer, count, c, err)
    if c != 0 { g_cancellable_pop_current(c) }
    return result
}

pub fn inputRead(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 {
    if count == 0 { return 0 }
    if count > MAX_COUNT {
        tooLarge(err, "g_input_stream_read")
        return -1
    }
    if slot(stream, IN_READ) == 0 {
        ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Input stream doesn\u{2019}t implement read")
        return -1
    }
    if !inputSetPending(stream, err) { return -1 }
    const result = callRead(stream, buffer, count, c, err)
    inputClearPending(stream)
    return result
}

export fn g_input_stream_read(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 { return inputRead(stream, buffer, count, c, err) }

export fn g_input_stream_read_all(stream: usize, buffer: usize, count: usize, bytes_read: usize, c: usize, err: usize) -> i32 {
    var total: usize = 0
    var good = true
    while total < count {
        const n = inputRead(stream, buffer + total, count - total, c, err)
        if n < 0 {
            good = false
            break
        }
        if n == 0 { break }
        total += @intCast(usize, n)
    }
    if bytes_read != 0 { m.putWord(bytes_read, total) }
    return if good { 1 } else { 0 }
}

// GIO's read_bytes: the bytes read (an empty GBytes at the end).
export fn g_input_stream_read_bytes(stream: usize, count: usize, c: usize, err: usize) -> usize {
    const buffer = m.raw(count + 1)
    const n = inputRead(stream, buffer, count, c, err)
    if n < 0 {
        m.release(buffer)
        return 0
    }
    if n == 0 {
        m.release(buffer)
        return g_bytes_new(0, 0)
    }
    return g_bytes_new_take(m.grow(buffer, @intCast(usize, n)), @intCast(usize, n))
}

// The default skip: reading and dropping what is read (8 KB at a time).
export fn __mlx_glib_input_real_skip(stream: usize, count: usize, c: usize, err: usize) -> i64 {
    const buffer = m.raw(CHUNK)
    var total: usize = 0
    var failed = false
    while total < count {
        const want = if count - total > CHUNK { CHUNK } else { count - total }
        const n = callRead(stream, buffer, want, c, if total == 0 { err } else { 0 })
        if n < 0 {
            failed = total == 0
            break
        }
        if n == 0 { break }
        total += @intCast(usize, n)
    }
    m.release(buffer)
    return if failed { -1 } else { @intCast(i64, total) }
}

export fn g_input_stream_skip(stream: usize, count: usize, c: usize, err: usize) -> i64 {
    if count == 0 { return 0 }
    if count > MAX_COUNT {
        tooLarge(err, "g_input_stream_skip")
        return -1
    }
    if !inputSetPending(stream, err) { return -1 }
    if c != 0 { g_cancellable_push_current(c) }
    const call: SkipFn = unsafe { @ptrFromInt(SkipFn, slot(stream, IN_SKIP)) }
    const result = call(stream, count, c, err)
    if c != 0 { g_cancellable_pop_current(c) }
    inputClearPending(stream)
    return result
}

pub fn inputClose(stream: usize, c: usize, err: usize) -> i32 {
    const r = inRec(stream)
    if m.get32(r) != 0 { return 1 }
    if !inputSetPending(stream, err) { return 0 }
    var result: i32 = 1
    const f = slot(stream, IN_CLOSE)
    if c != 0 { g_cancellable_push_current(c) }
    if f != 0 {
        const call: CloseFn = unsafe { @ptrFromInt(CloseFn, f) }
        result = call(stream, c, err)
    }
    if c != 0 { g_cancellable_pop_current(c) }
    inputClearPending(stream)
    m.put32(r, 1)
    return result
}

export fn g_input_stream_close(stream: usize, c: usize, err: usize) -> i32 { return inputClose(stream, c, err) }

// The callback the class's asynchronous operation is given: the pending
// mark cleared, then the caller's callback.
export fn __mlx_glib_input_wrapper(source: usize, res: usize, data: usize) -> void {
    inputClearPending(source)
    const callback = m.getWord(inRec(source) + 8)
    m.putWord(inRec(source) + 8, 0)
    if callback != 0 {
        const call: Callback = unsafe { @ptrFromInt(Callback, callback) }
        call(source, res, data)
    }
    g_object_unref(source)
}

// The close callback also marks the stream closed.
export fn __mlx_glib_input_close_wrapper(source: usize, res: usize, data: usize) -> void {
    m.put32(inRec(source), 1)
    __mlx_glib_input_wrapper(source, res, data)
}

fn reportError(source: usize, callback: usize, data: usize, t: usize, cell: usize) -> void {
    g_task_report_error(source, callback, data, t, m.getWord(cell))
    m.release(cell)
}

// A task of the stream returning `value` at once (a zero count).
fn returnIntNow(stream: usize, c: usize, callback: usize, data: usize, t: usize, value: i64, priority: i32) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, t)
    g_task_set_priority(task, priority)
    g_task_return_int(task, value)
    g_object_unref(task)
}

export fn g_input_stream_read_async(stream: usize, buffer: usize, count: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    if count == 0 {
        returnIntNow(stream, c, callback, data, tag(&tagRead), 0, io_priority)
        return
    }
    const cell = m.alloc(8)
    if count > MAX_COUNT {
        tooLarge(cell, "g_input_stream_read_async")
        reportError(stream, callback, data, tag(&tagRead), cell)
        return
    }
    if !inputSetPending(stream, cell) {
        reportError(stream, callback, data, tag(&tagRead), cell)
        return
    }
    m.release(cell)
    m.putWord(inRec(stream) + 8, callback)
    _ = g_object_ref(stream)
    const call: ReadAsyncFn = unsafe { @ptrFromInt(ReadAsyncFn, slot(stream, IN_READ_ASYNC)) }
    call(stream, buffer, count, io_priority, c, @intFromPtr(__mlx_glib_input_wrapper), data)
}

export fn g_input_stream_read_finish(stream: usize, result: usize, err: usize) -> i64 {
    if g_async_result_is_tagged(result, tag(&tagRead)) != 0 { return g_task_propagate_int(result, err) }
    const call: FinishFn = unsafe { @ptrFromInt(FinishFn, slot(stream, IN_READ_FINISH)) }
    return call(stream, result, err)
}

// The operation of a task: the buffer (0), the count (8), what was done
// so far (16), a second stream (24), flags (32), the caller's callback
// (40) and its data (48), a buffer of its own (56).
const OP_BUFFER: usize = 0
const OP_COUNT: usize = 8
const OP_DONE: usize = 16
const OP_OTHER: usize = 24
const OP_FLAGS: usize = 32
const OP_CALLBACK: usize = 40
const OP_DATA: usize = 48
const OP_OWN: usize = 56
const OP_SIZE: usize = 64

export fn __mlx_glib_stream_op_free(op: usize) -> void {
    if m.getWord(op + OP_OTHER) != 0 { g_object_unref(m.getWord(op + OP_OTHER)) }
    m.release(m.getWord(op + OP_OWN))
    m.release(op)
}

fn newOp(task: usize, buffer: usize, count: usize) -> usize {
    const op = m.alloc(OP_SIZE)
    m.putWord(op + OP_BUFFER, buffer)
    m.putWord(op + OP_COUNT, count)
    g_task_set_task_data(task, op, @intFromPtr(__mlx_glib_stream_op_free))
    return op
}

export fn __mlx_glib_input_read_thread(task: usize, stream: usize, op: usize, c: usize) -> void {
    const cell = m.alloc(8)
    const n = callRead(stream, m.getWord(op + OP_BUFFER), m.getWord(op + OP_COUNT), c, cell)
    if n < 0 { g_task_return_error(task, m.getWord(cell)) } else { g_task_return_int(task, n) }
    m.release(cell)
}

// One try of a pollable read: done, failed, or waiting on the stream's
// source again.
fn pollableReadStep(task: usize) -> void {
    const stream = g_task_get_source_object(task)
    const op = g_task_get_task_data(task)
    if g_task_return_error_if_cancelled(task) != 0 { return }
    const cell = m.alloc(8)
    const n = nonblocking(stream, pollableInputType, m.getWord(op + OP_BUFFER), m.getWord(op + OP_COUNT), 0, cell, "g_pollable_input_stream_read_nonblocking")
    if n >= 0 {
        m.release(cell)
        g_task_return_int(task, n)
        return
    }
    const e = m.getWord(cell)
    m.release(cell)
    if g_error_matches(e, ioerrors.quark(), ioerrors.WOULD_BLOCK) == 0 {
        g_task_return_error(task, e)
        return
    }
    g_error_free(e)
    const source = createSource(stream, pollableInputType, g_task_get_cancellable(task))
    g_source_set_priority(source, g_task_get_priority(task))
    g_source_set_callback(source, @intFromPtr(__mlx_glib_input_pollable_ready), g_object_ref(task), @intFromPtr(__mlx_glib_object_unref))
    _ = g_source_attach(source, g_task_get_context(task))
    g_source_unref(source)
}

export fn __mlx_glib_object_unref(object: usize) -> void { g_object_unref(object) }

export fn __mlx_glib_input_pollable_ready(stream: usize, task: usize) -> i32 {
    pollableReadStep(task)
    return 0
}

export fn __mlx_glib_input_real_read_async(stream: usize, buffer: usize, count: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagRealRead))
    g_task_set_priority(task, io_priority)
    _ = newOp(task, buffer, count)
    if inputCanPoll(stream) {
        pollableReadStep(task)
    } else {
        g_task_run_in_thread(task, @intFromPtr(__mlx_glib_input_read_thread))
    }
    g_object_unref(task)
}

export fn __mlx_glib_input_real_read_finish(stream: usize, result: usize, err: usize) -> i64 { return g_task_propagate_int(result, err) }

export fn __mlx_glib_input_skip_thread(task: usize, stream: usize, op: usize, c: usize) -> void {
    const cell = m.alloc(8)
    const call: SkipFn = unsafe { @ptrFromInt(SkipFn, slot(stream, IN_SKIP)) }
    const n = call(stream, m.getWord(op + OP_COUNT), c, cell)
    if n < 0 { g_task_return_error(task, m.getWord(cell)) } else { g_task_return_int(task, n) }
    m.release(cell)
}

// Skipping by the class's read_async, when it has its own (GIO's
// emulation): reads of up to 8 KB until the count or the end.
export fn __mlx_glib_input_skip_read_ready(source: usize, res: usize, task: usize) -> void {
    const op = g_task_get_task_data(task)
    const cell = m.alloc(8)
    const finish: FinishFn = unsafe { @ptrFromInt(FinishFn, slot(source, IN_READ_FINISH)) }
    const n = finish(source, res, cell)
    if n < 0 {
        if m.getWord(op + OP_DONE) > 0 {
            g_error_free(m.getWord(cell))
            g_task_return_int(task, @intCast(i64, m.getWord(op + OP_DONE)))
        } else {
            g_task_return_error(task, m.getWord(cell))
        }
        m.release(cell)
        g_object_unref(task)
        return
    }
    m.release(cell)
    m.putWord(op + OP_DONE, m.getWord(op + OP_DONE) + @intCast(usize, n))
    const left = m.getWord(op + OP_COUNT) - m.getWord(op + OP_DONE)
    if n == 0 || left == 0 {
        g_task_return_int(task, @intCast(i64, m.getWord(op + OP_DONE)))
        g_object_unref(task)
        return
    }
    const call: ReadAsyncFn = unsafe { @ptrFromInt(ReadAsyncFn, slot(source, IN_READ_ASYNC)) }
    call(source, m.getWord(op + OP_OWN), if left > CHUNK { CHUNK } else { left }, g_task_get_priority(task), g_task_get_cancellable(task), @intFromPtr(__mlx_glib_input_skip_read_ready), task)
}

export fn __mlx_glib_input_real_skip_async(stream: usize, count: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagRealSkip))
    g_task_set_priority(task, io_priority)
    const op = newOp(task, 0, count)
    if slot(stream, IN_READ_ASYNC) == @intFromPtr(__mlx_glib_input_real_read_async) {
        g_task_run_in_thread(task, @intFromPtr(__mlx_glib_input_skip_thread))
        g_object_unref(task)
        return
    }
    m.putWord(op + OP_OWN, m.raw(CHUNK))
    const call: ReadAsyncFn = unsafe { @ptrFromInt(ReadAsyncFn, slot(stream, IN_READ_ASYNC)) }
    call(stream, m.getWord(op + OP_OWN), if count > CHUNK { CHUNK } else { count }, io_priority, c, @intFromPtr(__mlx_glib_input_skip_read_ready), task)
}

export fn __mlx_glib_input_real_skip_finish(stream: usize, result: usize, err: usize) -> i64 { return g_task_propagate_int(result, err) }

export fn g_input_stream_skip_async(stream: usize, count: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    if count == 0 {
        returnIntNow(stream, c, callback, data, tag(&tagSkip), 0, io_priority)
        return
    }
    const cell = m.alloc(8)
    if count > MAX_COUNT {
        tooLarge(cell, "g_input_stream_skip_async")
        reportError(stream, callback, data, tag(&tagSkip), cell)
        return
    }
    if !inputSetPending(stream, cell) {
        reportError(stream, callback, data, tag(&tagSkip), cell)
        return
    }
    m.release(cell)
    m.putWord(inRec(stream) + 8, callback)
    _ = g_object_ref(stream)
    const call: SkipAsyncFn = unsafe { @ptrFromInt(SkipAsyncFn, slot(stream, IN_SKIP_ASYNC)) }
    call(stream, count, io_priority, c, @intFromPtr(__mlx_glib_input_wrapper), data)
}

export fn g_input_stream_skip_finish(stream: usize, result: usize, err: usize) -> i64 {
    if g_async_result_is_tagged(result, tag(&tagSkip)) != 0 { return g_task_propagate_int(result, err) }
    const call: FinishFn = unsafe { @ptrFromInt(FinishFn, slot(stream, IN_SKIP_FINISH)) }
    return call(stream, result, err)
}

// The default close_async: the synchronous close at once, its result
// reported from the task.
export fn __mlx_glib_input_real_close_async(stream: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagRealClose))
    g_task_set_priority(task, io_priority)
    const cell = m.alloc(8)
    var good: i32 = 1
    const f = slot(stream, IN_CLOSE)
    if f != 0 {
        if c != 0 { g_cancellable_push_current(c) }
        const call: CloseFn = unsafe { @ptrFromInt(CloseFn, f) }
        good = call(stream, c, cell)
        if c != 0 { g_cancellable_pop_current(c) }
    }
    if good != 0 { g_task_return_boolean(task, 1) } else { g_task_return_error(task, m.getWord(cell)) }
    m.release(cell)
    g_object_unref(task)
}

export fn __mlx_glib_input_real_close_finish(stream: usize, result: usize, err: usize) -> i32 { return g_task_propagate_boolean(result, err) }

fn returnBooleanNow(stream: usize, c: usize, callback: usize, data: usize, t: usize, priority: i32) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, t)
    g_task_set_priority(task, priority)
    g_task_return_boolean(task, 1)
    g_object_unref(task)
}

export fn g_input_stream_close_async(stream: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    if inputIsClosed(stream) {
        returnBooleanNow(stream, c, callback, data, tag(&tagClose), io_priority)
        return
    }
    const cell = m.alloc(8)
    if !inputSetPending(stream, cell) {
        reportError(stream, callback, data, tag(&tagClose), cell)
        return
    }
    m.release(cell)
    m.putWord(inRec(stream) + 8, callback)
    _ = g_object_ref(stream)
    const call: CloseAsyncFn = unsafe { @ptrFromInt(CloseAsyncFn, slot(stream, IN_CLOSE_ASYNC)) }
    call(stream, io_priority, c, @intFromPtr(__mlx_glib_input_close_wrapper), data)
}

export fn g_input_stream_close_finish(stream: usize, result: usize, err: usize) -> i32 {
    if g_async_result_is_tagged(result, tag(&tagClose)) != 0 { return g_task_propagate_boolean(result, err) }
    const call: BoolFinishFn = unsafe { @ptrFromInt(BoolFinishFn, slot(stream, IN_CLOSE_FINISH)) }
    return call(stream, result, err)
}

// read_all_async: read_async until the count or the end; the count read
// is the task's integer (and, failing, kept for read_all_finish).
export fn __mlx_glib_input_read_all_ready(source: usize, res: usize, task: usize) -> void {
    const op = g_task_get_task_data(task)
    const cell = m.alloc(8)
    const n = g_input_stream_read_finish(source, res, cell)
    if n < 0 {
        g_task_return_error(task, m.getWord(cell))
        m.release(cell)
        g_object_unref(task)
        return
    }
    m.release(cell)
    m.putWord(op + OP_DONE, m.getWord(op + OP_DONE) + @intCast(usize, n))
    if n == 0 || m.getWord(op + OP_DONE) == m.getWord(op + OP_COUNT) {
        g_task_return_int(task, @intCast(i64, m.getWord(op + OP_DONE)))
        g_object_unref(task)
        return
    }
    g_input_stream_read_async(source, m.getWord(op + OP_BUFFER) + m.getWord(op + OP_DONE), m.getWord(op + OP_COUNT) - m.getWord(op + OP_DONE), g_task_get_priority(task), g_task_get_cancellable(task), @intFromPtr(__mlx_glib_input_read_all_ready), task)
}

export fn g_input_stream_read_all_async(stream: usize, buffer: usize, count: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagReadAll))
    g_task_set_priority(task, io_priority)
    _ = newOp(task, buffer, count)
    if count == 0 {
        g_task_return_int(task, 0)
        g_object_unref(task)
        return
    }
    g_input_stream_read_async(stream, buffer, count, io_priority, c, @intFromPtr(__mlx_glib_input_read_all_ready), task)
}

export fn g_input_stream_read_all_finish(stream: usize, result: usize, bytes_read: usize, err: usize) -> i32 {
    const op = g_task_get_task_data(result)
    if bytes_read != 0 { m.putWord(bytes_read, if op != 0 { m.getWord(op + OP_DONE) } else { 0 }) }
    return if g_task_propagate_int(result, err) >= 0 { 1 } else { 0 }
}

export fn __mlx_glib_bytes_unref(b: usize) -> void { g_bytes_unref(b) }

export fn __mlx_glib_input_read_bytes_ready(source: usize, res: usize, task: usize) -> void {
    const op = g_task_get_task_data(task)
    const cell = m.alloc(8)
    const n = g_input_stream_read_finish(source, res, cell)
    if n < 0 {
        g_task_return_error(task, m.getWord(cell))
    } else {
        const buffer = m.getWord(op + OP_OWN)
        m.putWord(op + OP_OWN, 0)
        var bytes: usize = 0
        if n == 0 {
            m.release(buffer)
            bytes = g_bytes_new(0, 0)
        } else {
            bytes = g_bytes_new_take(m.grow(buffer, @intCast(usize, n)), @intCast(usize, n))
        }
        g_task_return_pointer(task, bytes, @intFromPtr(__mlx_glib_bytes_unref))
    }
    m.release(cell)
    g_object_unref(task)
}

export fn g_input_stream_read_bytes_async(stream: usize, count: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagReadBytes))
    g_task_set_priority(task, io_priority)
    const op = newOp(task, 0, count)
    m.putWord(op + OP_OWN, m.raw(count + 1))
    g_input_stream_read_async(stream, m.getWord(op + OP_OWN), count, io_priority, c, @intFromPtr(__mlx_glib_input_read_bytes_ready), task)
}

export fn g_input_stream_read_bytes_finish(stream: usize, result: usize, err: usize) -> usize { return g_task_propagate_pointer(result, err) }

// ---------------------------------------------------------------------------
// GOutputStream

fn outRec(stream: usize) -> usize { return word(stream, 24) }

export fn __mlx_glib_output_init(stream: usize, class: usize) -> void { m.putWord(stream + 24, m.alloc(24)) }

export fn __mlx_glib_output_dispose(stream: usize) -> void {
    if m.get32(outRec(stream)) == 0 { _ = outputClose(stream, 0, 0) }
    ioerrors.chainUp(types.T_OBJECT, 40, stream)
}

export fn __mlx_glib_output_finalize(stream: usize) -> void {
    m.release(outRec(stream))
    ioerrors.chainUp(types.T_OBJECT, 48, stream)
}

export fn __mlx_glib_output_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 40, @intFromPtr(__mlx_glib_output_dispose))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_output_finalize))
    m.putWord(class + OUT_SPLICE, @intFromPtr(__mlx_glib_output_real_splice))
    m.putWord(class + OUT_WRITE_ASYNC, @intFromPtr(__mlx_glib_output_real_write_async))
    m.putWord(class + OUT_WRITE_FINISH, @intFromPtr(__mlx_glib_output_real_write_finish))
    m.putWord(class + OUT_SPLICE_ASYNC, @intFromPtr(__mlx_glib_output_real_splice_async))
    m.putWord(class + OUT_SPLICE_FINISH, @intFromPtr(__mlx_glib_output_real_int_finish))
    m.putWord(class + OUT_FLUSH_ASYNC, @intFromPtr(__mlx_glib_output_real_flush_async))
    m.putWord(class + OUT_FLUSH_FINISH, @intFromPtr(__mlx_glib_output_real_bool_finish))
    m.putWord(class + OUT_CLOSE_ASYNC, @intFromPtr(__mlx_glib_output_real_close_async))
    m.putWord(class + OUT_CLOSE_FINISH, @intFromPtr(__mlx_glib_output_real_bool_finish))
}

pub fn outputIsClosed(stream: usize) -> bool { return m.get32(outRec(stream)) != 0 }

fn outputSetPending(stream: usize, err: usize) -> bool {
    const r = outRec(stream)
    if m.get32(r) != 0 {
        ioerrors.set(err, ioerrors.CLOSED, "Stream is already closed")
        return false
    }
    if m.get32(r + 8) != 0 {
        ioerrors.set(err, ioerrors.PENDING, "Stream has outstanding operation")
        return false
    }
    m.put32(r + 8, 1)
    return true
}

fn outputClearPending(stream: usize) -> void { m.put32(outRec(stream) + 8, 0) }

export fn g_output_stream_is_closed(stream: usize) -> i32 { return if outputIsClosed(stream) { 1 } else { 0 } }
export fn g_output_stream_is_closing(stream: usize) -> i32 { return @bitCast(i32, m.get32(outRec(stream) + 4)) }
export fn g_output_stream_has_pending(stream: usize) -> i32 { return @bitCast(i32, m.get32(outRec(stream) + 8)) }
export fn g_output_stream_set_pending(stream: usize, err: usize) -> i32 { return if outputSetPending(stream, err) { 1 } else { 0 } }
export fn g_output_stream_clear_pending(stream: usize) -> void { outputClearPending(stream) }

fn callWrite(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 {
    const f = slot(stream, OUT_WRITE)
    if f == 0 {
        ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Output stream doesn\u{2019}t implement write")
        return -1
    }
    const call: WriteFn = unsafe { @ptrFromInt(WriteFn, f) }
    if c != 0 { g_cancellable_push_current(c) }
    const result = call(stream, buffer, count, c, err)
    if c != 0 { g_cancellable_pop_current(c) }
    return result
}

pub fn outputWrite(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 {
    if count == 0 { return 0 }
    if count > MAX_COUNT {
        tooLarge(err, "g_output_stream_write")
        return -1
    }
    if slot(stream, OUT_WRITE) == 0 {
        ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Output stream doesn\u{2019}t implement write")
        return -1
    }
    if !outputSetPending(stream, err) { return -1 }
    const result = callWrite(stream, buffer, count, c, err)
    outputClearPending(stream)
    return result
}

export fn g_output_stream_write(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 { return outputWrite(stream, buffer, count, c, err) }

pub fn outputWriteAll(stream: usize, buffer: usize, count: usize, written: usize, c: usize, err: usize) -> i32 {
    var total: usize = 0
    var good = true
    while total < count {
        const n = outputWrite(stream, buffer + total, count - total, c, err)
        if n < 0 {
            good = false
            break
        }
        // (GIO stops at a write of nothing.)
        if n == 0 { break }
        total += @intCast(usize, n)
    }
    if written != 0 { m.putWord(written, total) }
    return if good { 1 } else { 0 }
}

export fn g_output_stream_write_all(stream: usize, buffer: usize, count: usize, bytes_written: usize, c: usize, err: usize) -> i32 { return outputWriteAll(stream, buffer, count, bytes_written, c, err) }

export fn g_output_stream_write_bytes(stream: usize, bytes: usize, c: usize, err: usize) -> i64 {
    const size = g_bytes_get_size(bytes)
    if size == 0 { return 0 }
    return outputWrite(stream, g_bytes_get_data(bytes, 0), size, c, err)
}

fn callFlush(stream: usize, c: usize, err: usize) -> i32 {
    const f = slot(stream, OUT_FLUSH)
    if f == 0 { return 1 }
    const call: FlushFn = unsafe { @ptrFromInt(FlushFn, f) }
    if c != 0 { g_cancellable_push_current(c) }
    const result = call(stream, c, err)
    if c != 0 { g_cancellable_pop_current(c) }
    return result
}

export fn g_output_stream_flush(stream: usize, c: usize, err: usize) -> i32 {
    if !outputSetPending(stream, err) { return 0 }
    const result = callFlush(stream, c, err)
    outputClearPending(stream)
    return result
}

// GIO's internal close: flushed, then closed (even when flushing failed;
// the flush's error is the one reported then).
fn internalClose(stream: usize, c: usize, err: usize) -> i32 {
    const r = outRec(stream)
    m.put32(r + 4, 1)
    const cell = m.alloc(8)
    var result = callFlush(stream, c, cell)
    const f = slot(stream, OUT_CLOSE)
    var closed: i32 = 1
    if f != 0 {
        const call: CloseFn = unsafe { @ptrFromInt(CloseFn, f) }
        if c != 0 { g_cancellable_push_current(c) }
        closed = call(stream, c, if result != 0 { err } else { 0 })
        if c != 0 { g_cancellable_pop_current(c) }
    }
    if result == 0 {
        errors.report(err, m.getWord(cell))
    } else {
        result = closed
    }
    m.release(cell)
    m.put32(r + 4, 0)
    m.put32(r, 1)
    return result
}

pub fn outputClose(stream: usize, c: usize, err: usize) -> i32 {
    if outputIsClosed(stream) { return 1 }
    if !outputSetPending(stream, err) { return 0 }
    const result = internalClose(stream, c, err)
    outputClearPending(stream)
    return result
}

export fn g_output_stream_close(stream: usize, c: usize, err: usize) -> i32 { return outputClose(stream, c, err) }

// The default splice: 8 KB at a time from `source` to `stream` (no
// pending mark set on the target: the caller set it).
export fn __mlx_glib_output_real_splice(stream: usize, source: usize, flags: i32, c: usize, err: usize) -> i64 {
    const buffer = m.raw(CHUNK)
    var total: i64 = 0
    var failed = false
    while true {
        const n = inputRead(source, buffer, CHUNK, c, err)
        if n < 0 {
            failed = true
            break
        }
        if n == 0 { break }
        var at: usize = 0
        while at < @intCast(usize, n) {
            const w = callWrite(stream, buffer + at, @intCast(usize, n) - at, c, err)
            if w <= 0 {
                failed = true
                break
            }
            at += @intCast(usize, w)
        }
        if failed { break }
        total += n
    }
    m.release(buffer)
    if (flags & SPLICE_CLOSE_SOURCE) != 0 {
        _ = inputClose(source, c, 0)
    }
    if (flags & SPLICE_CLOSE_TARGET) != 0 {
        const closed = internalClose(stream, c, if failed { 0 } else { err })
        if closed == 0 && !failed { failed = true }
    }
    return if failed { -1 } else { total }
}

export fn g_output_stream_splice(stream: usize, source: usize, flags: i32, c: usize, err: usize) -> i64 {
    if inputIsClosed(source) {
        ioerrors.set(err, ioerrors.CLOSED, "Source stream is already closed")
        return -1
    }
    if !outputSetPending(stream, err) { return -1 }
    const call: SpliceFn = unsafe { @ptrFromInt(SpliceFn, slot(stream, OUT_SPLICE)) }
    if c != 0 { g_cancellable_push_current(c) }
    const result = call(stream, source, flags, c, err)
    if c != 0 { g_cancellable_pop_current(c) }
    outputClearPending(stream)
    return result
}

export fn __mlx_glib_output_wrapper(source: usize, res: usize, data: usize) -> void {
    outputClearPending(source)
    const callback = m.getWord(outRec(source) + 16)
    m.putWord(outRec(source) + 16, 0)
    if callback != 0 {
        const call: Callback = unsafe { @ptrFromInt(Callback, callback) }
        call(source, res, data)
    }
    g_object_unref(source)
}

export fn __mlx_glib_output_close_wrapper(source: usize, res: usize, data: usize) -> void {
    m.put32(outRec(source), 1)
    m.put32(outRec(source) + 4, 0)
    __mlx_glib_output_wrapper(source, res, data)
}

export fn __mlx_glib_output_write_thread(task: usize, stream: usize, op: usize, c: usize) -> void {
    const cell = m.alloc(8)
    const n = callWrite(stream, m.getWord(op + OP_BUFFER), m.getWord(op + OP_COUNT), c, cell)
    if n < 0 { g_task_return_error(task, m.getWord(cell)) } else { g_task_return_int(task, n) }
    m.release(cell)
}

fn pollableWriteStep(task: usize) -> void {
    const stream = g_task_get_source_object(task)
    const op = g_task_get_task_data(task)
    if g_task_return_error_if_cancelled(task) != 0 { return }
    const cell = m.alloc(8)
    const n = nonblocking(stream, pollableOutputType, m.getWord(op + OP_BUFFER), m.getWord(op + OP_COUNT), 0, cell, "g_pollable_output_stream_write_nonblocking")
    if n >= 0 {
        m.release(cell)
        g_task_return_int(task, n)
        return
    }
    const e = m.getWord(cell)
    m.release(cell)
    if g_error_matches(e, ioerrors.quark(), ioerrors.WOULD_BLOCK) == 0 {
        g_task_return_error(task, e)
        return
    }
    g_error_free(e)
    const source = createSource(stream, pollableOutputType, g_task_get_cancellable(task))
    g_source_set_priority(source, g_task_get_priority(task))
    g_source_set_callback(source, @intFromPtr(__mlx_glib_output_pollable_ready), g_object_ref(task), @intFromPtr(__mlx_glib_object_unref))
    _ = g_source_attach(source, g_task_get_context(task))
    g_source_unref(source)
}

export fn __mlx_glib_output_pollable_ready(stream: usize, task: usize) -> i32 {
    pollableWriteStep(task)
    return 0
}

export fn __mlx_glib_output_real_write_async(stream: usize, buffer: usize, count: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagRealWrite))
    g_task_set_priority(task, io_priority)
    _ = newOp(task, buffer, count)
    if outputCanPoll(stream) {
        pollableWriteStep(task)
    } else {
        g_task_run_in_thread(task, @intFromPtr(__mlx_glib_output_write_thread))
    }
    g_object_unref(task)
}

export fn __mlx_glib_output_real_write_finish(stream: usize, result: usize, err: usize) -> i64 { return g_task_propagate_int(result, err) }
export fn __mlx_glib_output_real_int_finish(stream: usize, result: usize, err: usize) -> i64 { return g_task_propagate_int(result, err) }
export fn __mlx_glib_output_real_bool_finish(stream: usize, result: usize, err: usize) -> i32 { return g_task_propagate_boolean(result, err) }

export fn g_output_stream_write_async(stream: usize, buffer: usize, count: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    if count == 0 {
        returnIntNow(stream, c, callback, data, tag(&tagWrite), 0, io_priority)
        return
    }
    const cell = m.alloc(8)
    if count > MAX_COUNT {
        tooLarge(cell, "g_output_stream_write_async")
        reportError(stream, callback, data, tag(&tagWrite), cell)
        return
    }
    if !outputSetPending(stream, cell) {
        reportError(stream, callback, data, tag(&tagWrite), cell)
        return
    }
    m.release(cell)
    m.putWord(outRec(stream) + 16, callback)
    _ = g_object_ref(stream)
    const call: WriteAsyncFn = unsafe { @ptrFromInt(WriteAsyncFn, slot(stream, OUT_WRITE_ASYNC)) }
    call(stream, buffer, count, io_priority, c, @intFromPtr(__mlx_glib_output_wrapper), data)
}

export fn g_output_stream_write_finish(stream: usize, result: usize, err: usize) -> i64 {
    if g_async_result_is_tagged(result, tag(&tagWrite)) != 0 { return g_task_propagate_int(result, err) }
    const call: FinishFn = unsafe { @ptrFromInt(FinishFn, slot(stream, OUT_WRITE_FINISH)) }
    return call(stream, result, err)
}

// write_all_async: write_async until all is written; what was written
// is kept for write_all_finish.
export fn __mlx_glib_output_write_all_ready(source: usize, res: usize, task: usize) -> void {
    const op = g_task_get_task_data(task)
    const cell = m.alloc(8)
    const n = g_output_stream_write_finish(source, res, cell)
    if n < 0 {
        g_task_return_error(task, m.getWord(cell))
        m.release(cell)
        g_object_unref(task)
        return
    }
    m.release(cell)
    m.putWord(op + OP_DONE, m.getWord(op + OP_DONE) + @intCast(usize, n))
    if n == 0 || m.getWord(op + OP_DONE) == m.getWord(op + OP_COUNT) {
        g_task_return_boolean(task, 1)
        g_object_unref(task)
        return
    }
    g_output_stream_write_async(source, m.getWord(op + OP_BUFFER) + m.getWord(op + OP_DONE), m.getWord(op + OP_COUNT) - m.getWord(op + OP_DONE), g_task_get_priority(task), g_task_get_cancellable(task), @intFromPtr(__mlx_glib_output_write_all_ready), task)
}

export fn g_output_stream_write_all_async(stream: usize, buffer: usize, count: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagWriteAll))
    g_task_set_priority(task, io_priority)
    _ = newOp(task, buffer, count)
    if count == 0 {
        g_task_return_boolean(task, 1)
        g_object_unref(task)
        return
    }
    g_output_stream_write_async(stream, buffer, count, io_priority, c, @intFromPtr(__mlx_glib_output_write_all_ready), task)
}

export fn g_output_stream_write_all_finish(stream: usize, result: usize, bytes_written: usize, err: usize) -> i32 {
    const op = g_task_get_task_data(result)
    if bytes_written != 0 { m.putWord(bytes_written, if op != 0 { m.getWord(op + OP_DONE) } else { 0 }) }
    return g_task_propagate_boolean(result, err)
}

export fn __mlx_glib_output_write_bytes_ready(source: usize, res: usize, task: usize) -> void {
    const cell = m.alloc(8)
    const n = g_output_stream_write_finish(source, res, cell)
    if n < 0 { g_task_return_error(task, m.getWord(cell)) } else { g_task_return_int(task, n) }
    m.release(cell)
    g_object_unref(task)
}

export fn g_output_stream_write_bytes_async(stream: usize, bytes: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagWriteBytes))
    g_task_set_priority(task, io_priority)
    // (The task keeps the bytes while they are written.)
    g_task_set_task_data(task, g_bytes_ref(bytes), @intFromPtr(__mlx_glib_bytes_unref))
    g_output_stream_write_async(stream, g_bytes_get_data(bytes, 0), g_bytes_get_size(bytes), io_priority, c, @intFromPtr(__mlx_glib_output_write_bytes_ready), task)
}

export fn g_output_stream_write_bytes_finish(stream: usize, result: usize, err: usize) -> i64 { return g_task_propagate_int(result, err) }

export fn __mlx_glib_output_splice_thread(task: usize, stream: usize, op: usize, c: usize) -> void {
    const cell = m.alloc(8)
    const call: SpliceFn = unsafe { @ptrFromInt(SpliceFn, slot(stream, OUT_SPLICE)) }
    const n = call(stream, m.getWord(op + OP_OTHER), @intCast(i32, m.getWord(op + OP_FLAGS)), c, cell)
    if n < 0 { g_task_return_error(task, m.getWord(cell)) } else { g_task_return_int(task, n) }
    m.release(cell)
}

// Whether a stream's asynchronous reads (writes) run in a thread: GIO's
// defaults on a stream that cannot be polled.
fn readViaThreads(stream: usize) -> bool { return slot(stream, IN_READ_ASYNC) == @intFromPtr(__mlx_glib_input_real_read_async) && !inputCanPoll(stream) }
fn writeViaThreads(stream: usize) -> bool { return slot(stream, OUT_WRITE_ASYNC) == @intFromPtr(__mlx_glib_output_real_write_async) && !outputCanPoll(stream) }

// The default splice_async, as GIO's: in a thread only when both the
// source's reads and the target's writes would be; else reads and writes
// chained on the task's context, 8 KB at a time. The op keeps the source
// (OP_OTHER), the flags, the buffer (OP_OWN), what the last read gave
// (OP_COUNT), how much of it went (OP_DATA), the total (OP_DONE) and the
// first error (OP_CALLBACK).
export fn __mlx_glib_output_real_splice_async(stream: usize, source: usize, flags: i32, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagRealSplice))
    g_task_set_priority(task, io_priority)
    const op = newOp(task, 0, 0)
    m.putWord(op + OP_OTHER, g_object_ref(source))
    m.putWord(op + OP_FLAGS, @intCast(usize, flags))
    if readViaThreads(source) && writeViaThreads(stream) {
        g_task_run_in_thread(task, @intFromPtr(__mlx_glib_output_splice_thread))
        g_object_unref(task)
        return
    }
    const buffer = m.raw(CHUNK)
    m.putWord(op + OP_OWN, buffer)
    m.putWord(op + OP_BUFFER, buffer)
    spliceRead(task)
}

fn spliceRead(task: usize) -> void {
    const op = g_task_get_task_data(task)
    g_input_stream_read_async(m.getWord(op + OP_OTHER), m.getWord(op + OP_BUFFER), CHUNK, g_task_get_priority(task), g_task_get_cancellable(task), @intFromPtr(__mlx_glib_splice_read_ready), task)
}

fn spliceWrite(task: usize) -> void {
    const op = g_task_get_task_data(task)
    const stream = g_task_get_source_object(task)
    const written = m.getWord(op + OP_DATA)
    const call: WriteAsyncFn = unsafe { @ptrFromInt(WriteAsyncFn, slot(stream, OUT_WRITE_ASYNC)) }
    call(stream, m.getWord(op + OP_BUFFER) + written, m.getWord(op + OP_COUNT) - written, g_task_get_priority(task), g_task_get_cancellable(task), @intFromPtr(__mlx_glib_splice_write_ready), task)
}

export fn __mlx_glib_splice_read_ready(source: usize, result: usize, task: usize) -> void {
    const op = g_task_get_task_data(task)
    const cell = m.alloc(8)
    const n = g_input_stream_read_finish(source, result, cell)
    if n < 0 { m.putWord(op + OP_CALLBACK, m.getWord(cell)) }
    m.release(cell)
    if n <= 0 {
        spliceComplete(task)
        return
    }
    m.putWord(op + OP_COUNT, @intCast(usize, n))
    m.putWord(op + OP_DATA, 0)
    spliceWrite(task)
}

export fn __mlx_glib_splice_write_ready(stream: usize, result: usize, task: usize) -> void {
    const op = g_task_get_task_data(task)
    const cell = m.alloc(8)
    const call: FinishFn = unsafe { @ptrFromInt(FinishFn, slot(stream, OUT_WRITE_FINISH)) }
    const n = call(stream, result, cell)
    if n < 0 {
        m.putWord(op + OP_CALLBACK, m.getWord(cell))
        m.release(cell)
        spliceComplete(task)
        return
    }
    m.release(cell)
    m.putWord(op + OP_DATA, m.getWord(op + OP_DATA) + @intCast(usize, n))
    m.putWord(op + OP_DONE, m.getWord(op + OP_DONE) + @intCast(usize, n))
    if m.getWord(op + OP_DATA) < m.getWord(op + OP_COUNT) {
        spliceWrite(task)
    } else {
        spliceRead(task)
    }
}

// The streams closed as the flags say, then the result.
fn spliceComplete(task: usize) -> void {
    const op = g_task_get_task_data(task)
    const source = m.getWord(op + OP_OTHER)
    if (@intCast(i32, m.getWord(op + OP_FLAGS)) & SPLICE_CLOSE_SOURCE) != 0 && !inputIsClosed(source) {
        g_input_stream_close_async(source, g_task_get_priority(task), g_task_get_cancellable(task), @intFromPtr(__mlx_glib_splice_input_closed), task)
        return
    }
    spliceCloseTarget(task)
}

export fn __mlx_glib_splice_input_closed(source: usize, result: usize, task: usize) -> void {
    const op = g_task_get_task_data(task)
    const cell = m.alloc(8)
    if g_input_stream_close_finish(source, result, cell) == 0 {
        if m.getWord(op + OP_CALLBACK) == 0 { m.putWord(op + OP_CALLBACK, m.getWord(cell)) } else { g_error_free(m.getWord(cell)) }
    }
    m.release(cell)
    spliceCloseTarget(task)
}

fn spliceCloseTarget(task: usize) -> void {
    const op = g_task_get_task_data(task)
    const stream = g_task_get_source_object(task)
    if (@intCast(i32, m.getWord(op + OP_FLAGS)) & SPLICE_CLOSE_TARGET) != 0 && !outputIsClosed(stream) {
        const cell = m.alloc(8)
        if internalClose(stream, g_task_get_cancellable(task), cell) == 0 {
            if m.getWord(op + OP_CALLBACK) == 0 { m.putWord(op + OP_CALLBACK, m.getWord(cell)) } else { g_error_free(m.getWord(cell)) }
        }
        m.release(cell)
    }
    const e = m.getWord(op + OP_CALLBACK)
    if e != 0 {
        m.putWord(op + OP_CALLBACK, 0)
        g_task_return_error(task, e)
    } else {
        g_task_return_int(task, @intCast(i64, m.getWord(op + OP_DONE)))
    }
    g_object_unref(task)
}

export fn g_output_stream_splice_async(stream: usize, source: usize, flags: i32, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    const cell = m.alloc(8)
    if inputIsClosed(source) {
        ioerrors.set(cell, ioerrors.CLOSED, "Source stream is already closed")
        reportError(stream, callback, data, tag(&tagSplice), cell)
        return
    }
    if !outputSetPending(stream, cell) {
        reportError(stream, callback, data, tag(&tagSplice), cell)
        return
    }
    m.release(cell)
    m.putWord(outRec(stream) + 16, callback)
    _ = g_object_ref(stream)
    const call: SpliceAsyncFn = unsafe { @ptrFromInt(SpliceAsyncFn, slot(stream, OUT_SPLICE_ASYNC)) }
    call(stream, source, flags, io_priority, c, @intFromPtr(__mlx_glib_output_wrapper), data)
}

export fn g_output_stream_splice_finish(stream: usize, result: usize, err: usize) -> i64 {
    if g_async_result_is_tagged(result, tag(&tagSplice)) != 0 { return g_task_propagate_int(result, err) }
    const call: FinishFn = unsafe { @ptrFromInt(FinishFn, slot(stream, OUT_SPLICE_FINISH)) }
    return call(stream, result, err)
}

export fn __mlx_glib_output_real_flush_async(stream: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagRealFlush))
    g_task_set_priority(task, io_priority)
    const cell = m.alloc(8)
    if callFlush(stream, c, cell) != 0 { g_task_return_boolean(task, 1) } else { g_task_return_error(task, m.getWord(cell)) }
    m.release(cell)
    g_object_unref(task)
}

export fn g_output_stream_flush_async(stream: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    const cell = m.alloc(8)
    if !outputSetPending(stream, cell) {
        reportError(stream, callback, data, tag(&tagFlush), cell)
        return
    }
    m.release(cell)
    m.putWord(outRec(stream) + 16, callback)
    _ = g_object_ref(stream)
    const call: CloseAsyncFn = unsafe { @ptrFromInt(CloseAsyncFn, slot(stream, OUT_FLUSH_ASYNC)) }
    call(stream, io_priority, c, @intFromPtr(__mlx_glib_output_wrapper), data)
}

export fn g_output_stream_flush_finish(stream: usize, result: usize, err: usize) -> i32 {
    if g_async_result_is_tagged(result, tag(&tagFlush)) != 0 { return g_task_propagate_boolean(result, err) }
    const call: BoolFinishFn = unsafe { @ptrFromInt(BoolFinishFn, slot(stream, OUT_FLUSH_FINISH)) }
    return call(stream, result, err)
}

export fn __mlx_glib_output_real_close_async(stream: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagRealOutClose))
    g_task_set_priority(task, io_priority)
    const cell = m.alloc(8)
    const result = internalClose(stream, c, cell)
    if result != 0 { g_task_return_boolean(task, 1) } else { g_task_return_error(task, m.getWord(cell)) }
    m.release(cell)
    g_object_unref(task)
}

export fn g_output_stream_close_async(stream: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    if outputIsClosed(stream) {
        returnBooleanNow(stream, c, callback, data, tag(&tagOutClose), io_priority)
        return
    }
    const cell = m.alloc(8)
    if !outputSetPending(stream, cell) {
        reportError(stream, callback, data, tag(&tagOutClose), cell)
        return
    }
    m.release(cell)
    m.put32(outRec(stream) + 4, 1)
    m.putWord(outRec(stream) + 16, callback)
    _ = g_object_ref(stream)
    const call: CloseAsyncFn = unsafe { @ptrFromInt(CloseAsyncFn, slot(stream, OUT_CLOSE_ASYNC)) }
    call(stream, io_priority, c, @intFromPtr(__mlx_glib_output_close_wrapper), data)
}

export fn g_output_stream_close_finish(stream: usize, result: usize, err: usize) -> i32 {
    if g_async_result_is_tagged(result, tag(&tagOutClose)) != 0 { return g_task_propagate_boolean(result, err) }
    const call: BoolFinishFn = unsafe { @ptrFromInt(BoolFinishFn, slot(stream, OUT_CLOSE_FINISH)) }
    return call(stream, result, err)
}

// ---------------------------------------------------------------------------
// GFilterInputStream and GFilterOutputStream

fn filterPrivate(stream: usize, offset: i32) -> usize { return @bitCast(usize, @bitCast(i64, stream) + @intCast(i64, offset)) }
fn closeBase(stream: usize, input: bool) -> bool { return m.get32(filterPrivate(stream, if input { filterInputPrivate } else { filterOutputPrivate })) == 0 }

export fn __mlx_glib_filter_set_property(object: usize, id: u32, value: usize, pspec: usize) -> void {
    const input = isA(object, filterInputType)
    if id == 1 {
        const base = g_value_get_object(value)
        if base != 0 { m.putWord(object + 32, g_object_ref(base)) }
    }
    // (Kept as its opposite, so that zeroed memory says "close the base".)
    if id == 2 { m.put32(filterPrivate(object, if input { filterInputPrivate } else { filterOutputPrivate }), if g_value_get_boolean(value) != 0 { 0 } else { 1 }) }
}

export fn __mlx_glib_filter_get_property(object: usize, id: u32, value: usize, pspec: usize) -> void {
    const input = isA(object, filterInputType)
    if id == 1 { g_value_set_object(value, m.getWord(object + 32)) }
    if id == 2 { g_value_set_boolean(value, if closeBase(object, input) { 1 } else { 0 }) }
}

export fn __mlx_glib_filter_input_finalize(stream: usize) -> void {
    if m.getWord(stream + 32) != 0 { g_object_unref(m.getWord(stream + 32)) }
    ioerrors.chainUp(inputType, 48, stream)
}

export fn __mlx_glib_filter_output_finalize(stream: usize) -> void {
    if m.getWord(stream + 32) != 0 { g_object_unref(m.getWord(stream + 32)) }
    ioerrors.chainUp(outputType, 48, stream)
}

export fn __mlx_glib_filter_input_read(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 { return inputRead(m.getWord(stream + 32), buffer, count, c, err) }
export fn __mlx_glib_filter_input_skip(stream: usize, count: usize, c: usize, err: usize) -> i64 { return g_input_stream_skip(m.getWord(stream + 32), count, c, err) }

export fn __mlx_glib_filter_input_close(stream: usize, c: usize, err: usize) -> i32 {
    if !closeBase(stream, true) { return 1 }
    return inputClose(m.getWord(stream + 32), c, err)
}

export fn __mlx_glib_filter_output_write(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 { return outputWrite(m.getWord(stream + 32), buffer, count, c, err) }
export fn __mlx_glib_filter_output_flush(stream: usize, c: usize, err: usize) -> i32 { return g_output_stream_flush(m.getWord(stream + 32), c, err) }

export fn __mlx_glib_filter_output_close(stream: usize, c: usize, err: usize) -> i32 {
    if !closeBase(stream, false) { return 1 }
    return outputClose(m.getWord(stream + 32), c, err)
}

export fn g_filter_input_stream_get_base_stream(stream: usize) -> usize { return m.getWord(stream + 32) }
export fn g_filter_input_stream_get_close_base_stream(stream: usize) -> i32 { return if closeBase(stream, true) { 1 } else { 0 } }
export fn g_filter_input_stream_set_close_base_stream(stream: usize, close_base: i32) -> void { m.put32(filterPrivate(stream, filterInputPrivate), if close_base != 0 { 0 } else { 1 }) }
export fn g_filter_output_stream_get_base_stream(stream: usize) -> usize { return m.getWord(stream + 32) }
export fn g_filter_output_stream_get_close_base_stream(stream: usize) -> i32 { return if closeBase(stream, false) { 1 } else { 0 } }
export fn g_filter_output_stream_set_close_base_stream(stream: usize, close_base: i32) -> void { m.put32(filterPrivate(stream, filterOutputPrivate), if close_base != 0 { 0 } else { 1 }) }

// ---------------------------------------------------------------------------
// GMemoryInputStream: its chunks (GBytes, a growing array of words at 0,
// their count at 8, its capacity 16), the position (24) and the length
// of all (32); the record at 32 of the instance.

fn memIn(stream: usize) -> usize { return m.getWord(stream + 32) }

export fn __mlx_glib_memory_input_init(stream: usize, class: usize) -> void { m.putWord(stream + 32, m.alloc(40)) }

export fn __mlx_glib_memory_input_finalize(stream: usize) -> void {
    const r = memIn(stream)
    var index: usize = 0
    while index < m.getWord(r + 8) {
        g_bytes_unref(m.getWord(m.getWord(r) + index * 8))
        index += 1
    }
    m.release(m.getWord(r))
    m.release(r)
    ioerrors.chainUp(inputType, 48, stream)
}

export fn __mlx_glib_memory_input_read(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 {
    const r = memIn(stream)
    var position = m.getWord(r + 24)
    var copied: usize = 0
    var start: usize = 0
    var index: usize = 0
    while index < m.getWord(r + 8) && copied < count {
        const chunk = m.getWord(m.getWord(r) + index * 8)
        const size = g_bytes_get_size(chunk)
        if position < start + size {
            const offset = position - start
            const take = if size - offset > count - copied { count - copied } else { size - offset }
            m.copy(buffer + copied, g_bytes_get_data(chunk, 0) + offset, take)
            copied += take
            position += take
        }
        start += size
        index += 1
    }
    m.putWord(r + 24, position)
    return @intCast(i64, copied)
}

export fn __mlx_glib_memory_input_skip(stream: usize, count: usize, c: usize, err: usize) -> i64 {
    const r = memIn(stream)
    const left = m.getWord(r + 32) - m.getWord(r + 24)
    const n = if count > left { left } else { count }
    m.putWord(r + 24, m.getWord(r + 24) + n)
    return @intCast(i64, n)
}

export fn __mlx_glib_memory_input_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_glib_memory_input_finalize))
    m.putWord(class + IN_READ, @intFromPtr(__mlx_glib_memory_input_read))
    m.putWord(class + IN_SKIP, @intFromPtr(__mlx_glib_memory_input_skip))
}

export fn __mlx_glib_always(stream: usize) -> i32 { return 1 }

// A memory stream is always ready: its source a timeout of no time.
export fn __mlx_glib_memory_create_source(stream: usize, c: usize) -> usize {
    const base = g_timeout_source_new(0)
    const source = g_pollable_source_new_full(stream, base, c)
    g_source_unref(base)
    return source
}

export fn __mlx_glib_memory_input_nonblocking(stream: usize, buffer: usize, count: usize, err: usize) -> i64 { return __mlx_glib_memory_input_read(stream, buffer, count, 0, err) }

export fn __mlx_glib_memory_input_pollable_init(iface: usize, data: usize) -> void {
    m.putWord(iface + POLL_CAN_POLL, @intFromPtr(__mlx_glib_always))
    m.putWord(iface + POLL_READY, @intFromPtr(__mlx_glib_always))
    m.putWord(iface + POLL_CREATE_SOURCE, @intFromPtr(__mlx_glib_memory_create_source))
    m.putWord(iface + POLL_NONBLOCKING, @intFromPtr(__mlx_glib_memory_input_nonblocking))
}

fn memoryAddBytes(stream: usize, bytes: usize) -> void {
    const r = memIn(stream)
    const count = m.getWord(r + 8)
    if count == m.getWord(r + 16) {
        const larger = if count == 0 { 4 } else { count * 2 }
        m.putWord(r, m.grow(m.getWord(r), larger * 8))
        m.putWord(r + 16, larger)
    }
    m.putWord(m.getWord(r) + count * 8, g_bytes_ref(bytes))
    m.putWord(r + 8, count + 1)
    m.putWord(r + 32, m.getWord(r + 32) + g_bytes_get_size(bytes))
}

export fn g_memory_input_stream_new() -> usize {
    ensureTypes()
    return g_object_new(memoryInputType, 0)
}

export fn g_memory_input_stream_add_bytes(stream: usize, bytes: usize) -> void { memoryAddBytes(stream, bytes) }

export fn g_memory_input_stream_add_data(stream: usize, data: usize, len: i64, destroy: usize) -> void {
    const size = if len < 0 { m.cLength(data) } else { @intCast(usize, len) }
    var bytes: usize = 0
    if destroy != 0 {
        bytes = g_bytes_new_with_free_func(data, size, destroy, data)
    } else {
        bytes = g_bytes_new_static(data, size)
    }
    memoryAddBytes(stream, bytes)
    g_bytes_unref(bytes)
}

extern("c") fn g_bytes_new_with_free_func(data: usize, size: usize, free_func: usize, user_data: usize) -> usize
extern("c") fn g_bytes_new_static(data: usize, size: usize) -> usize

export fn g_memory_input_stream_new_from_data(data: usize, len: i64, destroy: usize) -> usize {
    const stream = g_memory_input_stream_new()
    g_memory_input_stream_add_data(stream, data, len, destroy)
    return stream
}

export fn g_memory_input_stream_new_from_bytes(bytes: usize) -> usize {
    const stream = g_memory_input_stream_new()
    memoryAddBytes(stream, bytes)
    return stream
}

// ---------------------------------------------------------------------------
// GSeekable (gseekable.h): the interface's tell (16), can_seek (24), seek
// (32), can_truncate (40) and truncate_fn (48), called as they are.
// GSeekType: G_SEEK_CUR 0, G_SEEK_SET 1, G_SEEK_END 2.

pub const SEEK_TELL: usize = 16
pub const SEEK_CAN_SEEK: usize = 24
pub const SEEK_SEEK: usize = 32
pub const SEEK_CAN_TRUNCATE: usize = 40
pub const SEEK_TRUNCATE: usize = 48
pub const SEEK_CUR: i32 = 0
pub const SEEK_SET: i32 = 1
pub const SEEK_END: i32 = 2

pub const TellFn = fn(usize) -> i64
pub const SeekFn = fn(usize, i64, i32, usize, usize) -> i32
pub const TruncateFn = fn(usize, i64, usize, usize) -> i32

fn seekVtable(seekable: usize, offset: usize) -> usize {
    ensureTypes()
    return m.getWord(g_type_interface_peek(classOf(seekable), seekableType) + offset)
}

export fn g_seekable_tell(seekable: usize) -> i64 {
    const call: TellFn = unsafe { @ptrFromInt(TellFn, seekVtable(seekable, SEEK_TELL)) }
    return call(seekable)
}

export fn g_seekable_can_seek(seekable: usize) -> i32 {
    const call: CanPollFn = unsafe { @ptrFromInt(CanPollFn, seekVtable(seekable, SEEK_CAN_SEEK)) }
    return call(seekable)
}

export fn g_seekable_seek(seekable: usize, offset: i64, kind: i32, c: usize, err: usize) -> i32 {
    const call: SeekFn = unsafe { @ptrFromInt(SeekFn, seekVtable(seekable, SEEK_SEEK)) }
    return call(seekable, offset, kind, c, err)
}

export fn g_seekable_can_truncate(seekable: usize) -> i32 {
    const call: CanPollFn = unsafe { @ptrFromInt(CanPollFn, seekVtable(seekable, SEEK_CAN_TRUNCATE)) }
    return call(seekable)
}

export fn g_seekable_truncate(seekable: usize, offset: i64, c: usize, err: usize) -> i32 {
    const call: TruncateFn = unsafe { @ptrFromInt(TruncateFn, seekVtable(seekable, SEEK_TRUNCATE)) }
    return call(seekable, offset, c, err)
}

// The position a seek asks for, from the current one and the end; -1
// with INVALID_ARGUMENT reported when the kind is none of the three.
pub fn seekTarget(current: i64, end: i64, offset: i64, kind: i32, err: usize) -> i64 {
    if kind == SEEK_CUR { return current + offset }
    if kind == SEEK_SET { return offset }
    if kind == SEEK_END { return end + offset }
    ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Invalid GSeekType supplied")
    return -1
}

// A memory input stream moves anywhere between its start and its end, as
// GIO's does, and cannot be truncated.
export fn __mlx_glib_memory_input_tell(stream: usize) -> i64 { return @intCast(i64, m.getWord(memIn(stream) + 24)) }

export fn __mlx_glib_memory_input_seek(stream: usize, offset: i64, kind: i32, c: usize, err: usize) -> i32 {
    const r = memIn(stream)
    if kind != SEEK_CUR && kind != SEEK_SET && kind != SEEK_END {
        ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Invalid GSeekType supplied")
        return 0
    }
    const target = seekTarget(@intCast(i64, m.getWord(r + 24)), @intCast(i64, m.getWord(r + 32)), offset, kind, err)
    if target < 0 || target > @intCast(i64, m.getWord(r + 32)) {
        ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Invalid seek request")
        return 0
    }
    m.putWord(r + 24, @intCast(usize, target))
    return 1
}

export fn __mlx_glib_never(stream: usize) -> i32 { return 0 }

export fn __mlx_glib_memory_input_truncate(stream: usize, offset: i64, c: usize, err: usize) -> i32 {
    ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Cannot truncate GMemoryInputStream")
    return 0
}

export fn __mlx_glib_memory_input_seekable_init(iface: usize, data: usize) -> void {
    m.putWord(iface + SEEK_TELL, @intFromPtr(__mlx_glib_memory_input_tell))
    m.putWord(iface + SEEK_CAN_SEEK, @intFromPtr(__mlx_glib_always))
    m.putWord(iface + SEEK_SEEK, @intFromPtr(__mlx_glib_memory_input_seek))
    m.putWord(iface + SEEK_CAN_TRUNCATE, @intFromPtr(__mlx_glib_never))
    m.putWord(iface + SEEK_TRUNCATE, @intFromPtr(__mlx_glib_memory_input_truncate))
}

// ---------------------------------------------------------------------------
// GMemoryOutputStream: its data (0), allocated size (8), the size written
// (16), the position (24), realloc (32) and destroy (40) functions; the
// record at 32 of the instance.

fn memOut(stream: usize) -> usize { return m.getWord(stream + 32) }

export fn __mlx_glib_memory_output_init(stream: usize, class: usize) -> void { m.putWord(stream + 32, m.alloc(48)) }

export fn __mlx_glib_memory_output_finalize(stream: usize) -> void {
    const r = memOut(stream)
    const destroy = m.getWord(r + 40)
    if destroy != 0 && m.getWord(r) != 0 {
        const call: DestroyFn = unsafe { @ptrFromInt(DestroyFn, destroy) }
        call(m.getWord(r))
    }
    m.release(r)
    ioerrors.chainUp(outputType, 48, stream)
}

// Room for `needed` bytes, as GIO makes it: the nearest power of two (16
// at least); a buffer that cannot grow takes what fits (a short write),
// and fails only when it is full.
fn memoryReserve(stream: usize, needed: usize, err: usize) -> bool {
    const r = memOut(stream)
    if needed <= m.getWord(r + 8) { return true }
    const realloc = m.getWord(r + 32)
    if realloc == 0 {
        if m.getWord(r + 24) < m.getWord(r + 8) { return true }
        ioerrors.set(err, ioerrors.NO_SPACE, "Memory output stream not resizable")
        return false
    }
    var size: usize = 1
    while size < needed { size = size * 2 }
    if size < 16 { size = 16 }
    const call: ReallocFn = unsafe { @ptrFromInt(ReallocFn, realloc) }
    const data = call(m.getWord(r), size)
    if data == 0 {
        ioerrors.set(err, ioerrors.NO_SPACE, "Failed to resize memory output stream")
        return false
    }
    if size > m.getWord(r + 8) { m.zero(data + m.getWord(r + 8), size - m.getWord(r + 8)) }
    m.putWord(r, data)
    m.putWord(r + 8, size)
    return true
}

export fn __mlx_glib_memory_output_write(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 {
    const r = memOut(stream)
    const position = m.getWord(r + 24)
    if !memoryReserve(stream, position + count, err) { return -1 }
    const room = m.getWord(r + 8) - position
    const n = if count > room { room } else { count }
    m.copy(m.getWord(r) + position, buffer, n)
    m.putWord(r + 24, position + n)
    if position + n > m.getWord(r + 16) { m.putWord(r + 16, position + n) }
    return @intCast(i64, n)
}

export fn __mlx_glib_memory_output_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_glib_memory_output_finalize))
    m.putWord(class + OUT_WRITE, @intFromPtr(__mlx_glib_memory_output_write))
}

export fn __mlx_glib_memory_output_nonblocking(stream: usize, buffer: usize, count: usize, err: usize) -> i64 { return __mlx_glib_memory_output_write(stream, buffer, count, 0, err) }

export fn __mlx_glib_memory_output_pollable_init(iface: usize, data: usize) -> void {
    m.putWord(iface + POLL_CAN_POLL, @intFromPtr(__mlx_glib_always))
    m.putWord(iface + POLL_READY, @intFromPtr(__mlx_glib_always))
    m.putWord(iface + POLL_CREATE_SOURCE, @intFromPtr(__mlx_glib_memory_create_source))
    m.putWord(iface + POLL_NONBLOCKING, @intFromPtr(__mlx_glib_memory_output_nonblocking))
}

export fn g_memory_output_stream_new(data: usize, size: usize, realloc_function: usize, destroy_function: usize) -> usize {
    ensureTypes()
    const stream = g_object_new(memoryOutputType, 0)
    const r = memOut(stream)
    m.putWord(r, data)
    m.putWord(r + 8, size)
    m.putWord(r + 32, realloc_function)
    m.putWord(r + 40, destroy_function)
    return stream
}

export fn g_memory_output_stream_new_resizable() -> usize { return g_memory_output_stream_new(0, 0, @intFromPtr(g_realloc), @intFromPtr(g_free)) }
export fn g_memory_output_stream_get_data(stream: usize) -> usize { return m.getWord(memOut(stream)) }
export fn g_memory_output_stream_get_size(stream: usize) -> usize { return m.getWord(memOut(stream) + 8) }
export fn g_memory_output_stream_get_data_size(stream: usize) -> usize { return m.getWord(memOut(stream) + 16) }

export fn g_memory_output_stream_steal_data(stream: usize) -> usize {
    const r = memOut(stream)
    const data = m.getWord(r)
    m.putWord(r, 0)
    // (GIO leaves the sizes as they were; the stream no longer frees it.)
    m.putWord(r + 40, 0)
    return data
}

export fn g_memory_output_stream_steal_as_bytes(stream: usize) -> usize {
    if !outputIsClosed(stream) {
        critical("g_memory_output_stream_steal_as_bytes: assertion 'g_output_stream_is_closed (G_OUTPUT_STREAM (ostream))' failed")
        return 0
    }
    const r = memOut(stream)
    const size = m.getWord(r + 16)
    const destroy = m.getWord(r + 40)
    const data = g_memory_output_stream_steal_data(stream)
    if destroy == 0 { return g_bytes_new_static(data, size) }
    return g_bytes_new_with_free_func(data, size, destroy, data)
}

// ---------------------------------------------------------------------------
// GSocketInputStream and GSocketOutputStream: a connection's socket read
// and written (blocking for the synchronous calls, without for the
// pollable ones).

export fn __mlx_glib_socket_stream_finalize(stream: usize) -> void {
    g_object_unref(m.getWord(stream + 32))
    ioerrors.chainUp(if isA(stream, inputType) { inputType } else { outputType }, 48, stream)
}

export fn __mlx_glib_socket_input_read(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 { return g_socket_receive_with_blocking(m.getWord(stream + 32), buffer, count, 1, c, err) }
export fn __mlx_glib_socket_output_write(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 { return g_socket_send_with_blocking(m.getWord(stream + 32), buffer, count, 1, c, err) }

export fn __mlx_glib_socket_input_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_glib_socket_stream_finalize))
    m.putWord(class + IN_READ, @intFromPtr(__mlx_glib_socket_input_read))
}

export fn __mlx_glib_socket_output_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_glib_socket_stream_finalize))
    m.putWord(class + OUT_WRITE, @intFromPtr(__mlx_glib_socket_output_write))
}

export fn __mlx_glib_socket_input_readable(stream: usize) -> i32 { return if g_socket_condition_check(m.getWord(stream + 32), G_IO_IN) != 0 { 1 } else { 0 } }
export fn __mlx_glib_socket_output_writable(stream: usize) -> i32 { return if g_socket_condition_check(m.getWord(stream + 32), G_IO_OUT) != 0 { 1 } else { 0 } }

export fn __mlx_glib_socket_input_source(stream: usize, c: usize) -> usize {
    const base = g_socket_create_source(m.getWord(stream + 32), G_IO_IN, c)
    const source = g_pollable_source_new_full(stream, base, c)
    g_source_unref(base)
    return source
}

export fn __mlx_glib_socket_output_source(stream: usize, c: usize) -> usize {
    const base = g_socket_create_source(m.getWord(stream + 32), G_IO_OUT, c)
    const source = g_pollable_source_new_full(stream, base, c)
    g_source_unref(base)
    return source
}

export fn __mlx_glib_socket_input_nonblocking(stream: usize, buffer: usize, count: usize, err: usize) -> i64 { return g_socket_receive_with_blocking(m.getWord(stream + 32), buffer, count, 0, 0, err) }
export fn __mlx_glib_socket_output_nonblocking(stream: usize, buffer: usize, count: usize, err: usize) -> i64 { return g_socket_send_with_blocking(m.getWord(stream + 32), buffer, count, 0, 0, err) }

export fn __mlx_glib_socket_input_pollable_init(iface: usize, data: usize) -> void {
    m.putWord(iface + POLL_CAN_POLL, @intFromPtr(__mlx_glib_always))
    m.putWord(iface + POLL_READY, @intFromPtr(__mlx_glib_socket_input_readable))
    m.putWord(iface + POLL_CREATE_SOURCE, @intFromPtr(__mlx_glib_socket_input_source))
    m.putWord(iface + POLL_NONBLOCKING, @intFromPtr(__mlx_glib_socket_input_nonblocking))
}

export fn __mlx_glib_socket_output_pollable_init(iface: usize, data: usize) -> void {
    m.putWord(iface + POLL_CAN_POLL, @intFromPtr(__mlx_glib_always))
    m.putWord(iface + POLL_READY, @intFromPtr(__mlx_glib_socket_output_writable))
    m.putWord(iface + POLL_CREATE_SOURCE, @intFromPtr(__mlx_glib_socket_output_source))
    m.putWord(iface + POLL_NONBLOCKING, @intFromPtr(__mlx_glib_socket_output_nonblocking))
}

// The streams of a socket (the connection's, made when first asked for).
pub fn socketInputStream(s: usize) -> usize {
    ensureTypes()
    const stream = g_object_new(socketInputType, 0)
    m.putWord(stream + 32, g_object_ref(s))
    return stream
}

pub fn socketOutputStream(s: usize) -> usize {
    ensureTypes()
    const stream = g_object_new(socketOutputType, 0)
    m.putWord(stream + 32, g_object_ref(s))
    return stream
}

// ---------------------------------------------------------------------------
// GIOStream's streams, closing asynchronously, and GSimpleIOStream (its
// streams kept in the GIOStream's record: input 8, output 16).

fn ioRec(stream: usize) -> usize { return m.getWord(stream + 24) }

export fn g_io_stream_get_input_stream(stream: usize) -> usize {
    const f = slot(stream, IO_GET_INPUT)
    if f == 0 { return 0 }
    const call: StreamFn = unsafe { @ptrFromInt(StreamFn, f) }
    return call(stream)
}

export fn g_io_stream_get_output_stream(stream: usize) -> usize {
    const f = slot(stream, IO_GET_OUTPUT)
    if f == 0 { return 0 }
    const call: StreamFn = unsafe { @ptrFromInt(StreamFn, f) }
    return call(stream)
}

export fn g_io_stream_set_pending(stream: usize, err: usize) -> i32 {
    const r = ioRec(stream)
    if m.get32(r) != 0 {
        ioerrors.set(err, ioerrors.CLOSED, "Stream is already closed")
        return 0
    }
    if m.get32(r + 4) != 0 {
        ioerrors.set(err, ioerrors.PENDING, "Stream has outstanding operation")
        return 0
    }
    m.put32(r + 4, 1)
    return 1
}

export fn g_io_stream_clear_pending(stream: usize) -> void { m.put32(ioRec(stream) + 4, 0) }

// GIO's g_io_stream_real_close: the output stream closed, then the input
// stream (the first error is the one reported).
pub fn ioRealClose(stream: usize, c: usize, err: usize) -> i32 {
    var result: i32 = 1
    var reported = err
    const output = g_io_stream_get_output_stream(stream)
    if output != 0 && outputClose(output, c, reported) == 0 {
        result = 0
        reported = 0
    }
    const input = g_io_stream_get_input_stream(stream)
    if input != 0 && inputClose(input, c, reported) == 0 { result = 0 }
    return result
}

export fn __mlx_glib_io_stream_real_close(stream: usize, c: usize, err: usize) -> i32 { return ioRealClose(stream, c, err) }

extern("c") fn g_io_stream_close(stream: usize, c: usize, err: usize) -> i32

export fn g_io_stream_close_async(stream: usize, io_priority: i32, c: usize, callback: usize, data: usize) -> void {
    ensureTypes()
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, tag(&tagIOClose))
    g_task_set_priority(task, io_priority)
    const cell = m.alloc(8)
    if g_io_stream_close(stream, c, cell) != 0 { g_task_return_boolean(task, 1) } else { g_task_return_error(task, m.getWord(cell)) }
    m.release(cell)
    g_object_unref(task)
}

export fn g_io_stream_close_finish(stream: usize, result: usize, err: usize) -> i32 { return g_task_propagate_boolean(result, err) }

export fn __mlx_glib_simple_io_input(stream: usize) -> usize { return m.getWord(ioRec(stream) + 8) }
export fn __mlx_glib_simple_io_output(stream: usize) -> usize { return m.getWord(ioRec(stream) + 16) }

export fn __mlx_glib_simple_io_class_init(class: usize, data: usize) -> void {
    m.putWord(class + IO_GET_INPUT, @intFromPtr(__mlx_glib_simple_io_input))
    m.putWord(class + IO_GET_OUTPUT, @intFromPtr(__mlx_glib_simple_io_output))
    m.putWord(class + IO_CLOSE, @intFromPtr(__mlx_glib_io_stream_real_close))
}

export fn g_simple_io_stream_new(input_stream: usize, output_stream: usize) -> usize {
    ensureTypes()
    const stream = g_object_new(simpleIOType, 0)
    m.putWord(ioRec(stream) + 8, g_object_ref(input_stream))
    m.putWord(ioRec(stream) + 16, g_object_ref(output_stream))
    return stream
}
