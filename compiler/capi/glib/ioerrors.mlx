// What GIO's parts share: its errors (gioerror.h: the G_IO_ERROR codes
// from errno and from GFileError) and the making of its GObject types
// (classes whose init functions are this library's, chained to their
// parent's dispose and finalize).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const types = @import("./types.mlx")

extern("c") fn g_io_error_quark() -> u32

pub const FAILED: i32 = 0
pub const NOT_FOUND: i32 = 1
pub const EXISTS: i32 = 2
pub const IS_DIRECTORY: i32 = 3
pub const NOT_DIRECTORY: i32 = 4
pub const NOT_EMPTY: i32 = 5
pub const NOT_REGULAR_FILE: i32 = 6
pub const FILENAME_TOO_LONG: i32 = 9
pub const TOO_MANY_LINKS: i32 = 11
pub const NO_SPACE: i32 = 12
pub const INVALID_ARGUMENT: i32 = 13
pub const PERMISSION_DENIED: i32 = 14
pub const NOT_SUPPORTED: i32 = 15
pub const CLOSED: i32 = 18
pub const CANCELLED: i32 = 19
pub const PENDING: i32 = 20
pub const READ_ONLY: i32 = 21
pub const TIMED_OUT: i32 = 24
pub const BUSY: i32 = 26
pub const WOULD_BLOCK: i32 = 27
pub const TOO_MANY_OPEN_FILES: i32 = 31
pub const ADDRESS_IN_USE: i32 = 33
pub const HOST_UNREACHABLE: i32 = 37
pub const NETWORK_UNREACHABLE: i32 = 38
pub const CONNECTION_REFUSED: i32 = 39
pub const BROKEN_PIPE: i32 = 44
pub const CONNECTION_CLOSED: i32 = 44
pub const NOT_CONNECTED: i32 = 45
pub const MESSAGE_TOO_LARGE: i32 = 46
pub const NO_SUCH_DEVICE: i32 = 47

// GLib's g_io_error_from_errno.
pub fn fromErrno(errnum: i32) -> i32 {
    if errnum == 17 { return EXISTS }
    if errnum == 21 { return IS_DIRECTORY }
    if errnum == 13 || errnum == 1 { return PERMISSION_DENIED }
    if errnum == 36 { return FILENAME_TOO_LONG }
    if errnum == 2 { return NOT_FOUND }
    if errnum == 20 { return NOT_DIRECTORY }
    if errnum == 6 { return NOT_REGULAR_FILE }
    if errnum == 30 { return READ_ONLY }
    if errnum == 40 || errnum == 31 { return TOO_MANY_LINKS }
    if errnum == 122 || errnum == 28 || errnum == 12 { return NO_SPACE }
    if errnum == 22 || errnum == 88 { return INVALID_ARGUMENT }
    if errnum == 125 { return CANCELLED }
    if errnum == 39 { return NOT_EMPTY }
    if errnum == 95 || errnum == 93 || errnum == 94 || errnum == 96 || errnum == 97 { return NOT_SUPPORTED }
    if errnum == 110 { return TIMED_OUT }
    if errnum == 16 { return BUSY }
    if errnum == 11 { return WOULD_BLOCK }
    if errnum == 24 || errnum == 23 { return TOO_MANY_OPEN_FILES }
    if errnum == 98 { return ADDRESS_IN_USE }
    if errnum == 113 { return HOST_UNREACHABLE }
    if errnum == 101 { return NETWORK_UNREACHABLE }
    if errnum == 111 { return CONNECTION_REFUSED }
    if errnum == 32 { return BROKEN_PIPE }
    if errnum == 104 { return CONNECTION_CLOSED }
    if errnum == 107 { return NOT_CONNECTED }
    if errnum == 90 { return MESSAGE_TOO_LARGE }
    if errnum == 19 { return NO_SUCH_DEVICE }
    return FAILED
}

export fn g_io_error_from_errno(err_no: i32) -> i32 { return fromErrno(err_no) }

// GLib's g_io_error_from_file_error (GFileError's order: EXIST, ISDIR,
// ACCES, NAMETOOLONG, NOENT, NOTDIR, NXIO, NODEV, ROFS, TXTBSY, FAULT,
// LOOP, NOSPC, NOMEM, MFILE, NFILE, BADF, INVAL, PIPE, AGAIN, INTR, IO,
// PERM, NOSYS, FAILED).
export fn g_io_error_from_file_error(file_error: i32) -> i32 {
    if file_error == 0 { return EXISTS }
    if file_error == 1 { return IS_DIRECTORY }
    if file_error == 2 || file_error == 22 { return PERMISSION_DENIED }
    if file_error == 3 { return FILENAME_TOO_LONG }
    if file_error == 4 { return NOT_FOUND }
    if file_error == 5 { return NOT_DIRECTORY }
    if file_error == 6 { return NOT_REGULAR_FILE }
    if file_error == 7 { return NO_SUCH_DEVICE }
    if file_error == 8 { return READ_ONLY }
    if file_error == 9 { return BUSY }
    if file_error == 11 { return TOO_MANY_LINKS }
    if file_error == 12 || file_error == 13 { return NO_SPACE }
    if file_error == 14 || file_error == 15 { return TOO_MANY_OPEN_FILES }
    if file_error == 17 { return INVALID_ARGUMENT }
    if file_error == 18 { return BROKEN_PIPE }
    if file_error == 19 { return WOULD_BLOCK }
    if file_error == 23 { return NOT_SUPPORTED }
    return FAILED
}

pub fn quark() -> u32 { return g_io_error_quark() }

pub fn set(err: usize, code: i32, message: []const u8) -> void { errors.set(err, g_io_error_quark(), code, message) }

// An error whose message is the text `t` (which it takes).
pub fn setText(err: usize, code: i32, t: *m.Text) -> void {
    if err == 0 {
        m.dispose(t)
        return
    }
    errors.report(err, errors.newError(g_io_error_quark(), code, m.finish(t)))
}

// "prefix: strerror(errnum)" with the code errno maps to.
pub fn setErrno(err: usize, prefix: []const u8, errnum: i32) -> void {
    var t = m.text()
    m.pushText(&t, prefix)
    m.pushC(&t, errors.errnoText(errnum))
    setText(err, fromErrno(errnum), &t)
}

// A GObject type of this library: `info` filled from the sizes and the
// init functions.
pub fn defineType(parent: usize, name: []const u8, classSize: usize, classInit: usize, instanceSize: usize, instanceInit: usize, flags: u32) -> usize {
    const info = m.alloc(72)
    m.put16(info, @intCast(u16, classSize))
    m.putWord(info + 24, classInit)
    m.put16(info + 48, @intCast(u16, instanceSize))
    m.putWord(info + 56, instanceInit)
    const t = types.registerStatic(parent, m.literal(name), info, flags)
    m.release(info)
    return t
}

pub const ObjectFunc = fn(usize) -> void

// Runs the dispose (40) or finalize (48) of the class of `parent`, the
// parent of the type whose own one calls this.
pub fn chainUp(parent: usize, slot: usize, object: usize) -> void {
    const class = types.classOf(parent)
    if class == 0 { return }
    const f = m.getWord(class + slot)
    if f == 0 { return }
    const call: ObjectFunc = unsafe { @ptrFromInt(ObjectFunc, f) }
    call(object)
}
