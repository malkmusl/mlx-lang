// Linked lists (glist.h, gslist.h): GList's links are (data, next,
// prev), GSList's (data, next); the empty list is NULL, and a function
// that changes a list returns its new first link.
const m = @import("./memory.mlx")

const DATA: usize = 0
const NEXT: usize = 8
const PREV: usize = 16

pub const Func = fn(usize, usize) -> void
pub const Compare = fn(usize, usize) -> i32
pub const CompareData = fn(usize, usize, usize) -> i32
pub const Copy = fn(usize, usize) -> usize
pub const Notify = fn(usize) -> void

fn next(link: usize) -> usize { return m.getWord(link + NEXT) }
fn prev(link: usize) -> usize { return m.getWord(link + PREV) }
fn data(link: usize) -> usize { return m.getWord(link + DATA) }

// ---------------------------------------------------------------------------
// GList

pub fn listLink(value: usize) -> usize {
    const link = m.alloc(24)
    m.putWord(link + DATA, value)
    return link
}

pub fn listLast(list: usize) -> usize {
    if list == 0 { return 0 }
    var link = list
    while next(link) != 0 { link = next(link) }
    return link
}

pub fn listAppend(list: usize, value: usize) -> usize {
    const link = listLink(value)
    if list == 0 { return link }
    const last = listLast(list)
    m.putWord(last + NEXT, link)
    m.putWord(link + PREV, last)
    return list
}

pub fn listPrepend(list: usize, value: usize) -> usize {
    const link = listLink(value)
    m.putWord(link + NEXT, list)
    if list != 0 {
        m.putWord(link + PREV, prev(list))
        if prev(list) != 0 { m.putWord(prev(list) + NEXT, link) }
        m.putWord(list + PREV, link)
    }
    return link
}

pub fn listFree(list: usize) -> void {
    var link = list
    while link != 0 {
        const following = next(link)
        m.release(link)
        link = following
    }
}

pub fn listLength(list: usize) -> usize {
    var count: usize = 0
    var link = list
    while link != 0 {
        count += 1
        link = next(link)
    }
    return count
}

// Unlinks `link` from `list` (not freed); the list's new first link.
pub fn listRemoveLink(list: usize, link: usize) -> usize {
    if link == 0 { return list }
    var first = list
    if prev(link) != 0 { m.putWord(prev(link) + NEXT, next(link)) }
    if next(link) != 0 { m.putWord(next(link) + PREV, prev(link)) }
    if link == first { first = next(link) }
    m.putWord(link + NEXT, 0)
    m.putWord(link + PREV, 0)
    return first
}

pub fn listFind(list: usize, value: usize) -> usize {
    var link = list
    while link != 0 {
        if data(link) == value { return link }
        link = next(link)
    }
    return 0
}

pub fn listRemove(list: usize, value: usize) -> usize {
    const link = listFind(list, value)
    if link == 0 { return list }
    const first = listRemoveLink(list, link)
    m.release(link)
    return first
}

export fn g_list_alloc() -> usize { return listLink(0) }
export fn g_list_free(list: usize) -> void { listFree(list) }
export fn g_list_free_1(list: usize) -> void { m.release(list) }

export fn g_list_free_full(list: usize, free_func: usize) -> void {
    const notify: Notify = unsafe { @ptrFromInt(Notify, free_func) }
    var link = list
    while link != 0 {
        const following = next(link)
        notify(data(link))
        m.release(link)
        link = following
    }
}

export fn g_list_append(list: usize, value: usize) -> usize { return listAppend(list, value) }
export fn g_list_prepend(list: usize, value: usize) -> usize { return listPrepend(list, value) }

export fn g_list_insert(list: usize, value: usize, position: i32) -> usize {
    if position < 0 { return listAppend(list, value) }
    if position == 0 { return listPrepend(list, value) }
    const at = g_list_nth(list, @intCast(u32, position))
    if at == 0 { return listAppend(list, value) }
    _ = listPrepend(at, value)
    return list
}

export fn g_list_insert_before(list: usize, sibling: usize, value: usize) -> usize {
    if list == 0 || sibling == 0 { return listAppend(list, value) }
    const link = listPrepend(sibling, value)
    return if sibling == list { link } else { list }
}

export fn g_list_insert_sorted(list: usize, value: usize, func: usize) -> usize {
    const compare: Compare = unsafe { @ptrFromInt(Compare, func) }
    var link = list
    var last: usize = 0
    while link != 0 && compare(value, data(link)) > 0 {
        last = link
        link = next(link)
    }
    if link == 0 { return listAppend(list, value) }
    const made = listPrepend(link, value)
    return if link == list { made } else { list }
}

export fn g_list_concat(list1: usize, list2: usize) -> usize {
    if list2 == 0 { return list1 }
    if list1 == 0 { return list2 }
    const last = listLast(list1)
    m.putWord(last + NEXT, list2)
    m.putWord(list2 + PREV, last)
    return list1
}

export fn g_list_remove(list: usize, value: usize) -> usize { return listRemove(list, value) }

export fn g_list_remove_all(list: usize, value: usize) -> usize {
    var first = list
    var link = list
    while link != 0 {
        const following = next(link)
        if data(link) == value {
            first = listRemoveLink(first, link)
            m.release(link)
        }
        link = following
    }
    return first
}

export fn g_list_remove_link(list: usize, llink: usize) -> usize { return listRemoveLink(list, llink) }

export fn g_list_delete_link(list: usize, link_: usize) -> usize {
    const first = listRemoveLink(list, link_)
    m.release(link_)
    return first
}

export fn g_list_reverse(list: usize) -> usize {
    var link = list
    var last: usize = 0
    while link != 0 {
        last = link
        const following = next(link)
        m.putWord(link + NEXT, prev(link))
        m.putWord(link + PREV, following)
        link = following
    }
    return last
}

export fn g_list_copy(list: usize) -> usize {
    var result: usize = 0
    var tail: usize = 0
    var link = list
    while link != 0 {
        const made = listLink(data(link))
        if tail == 0 { result = made } else {
            m.putWord(tail + NEXT, made)
            m.putWord(made + PREV, tail)
        }
        tail = made
        link = next(link)
    }
    return result
}

export fn g_list_copy_deep(list: usize, func: usize, user_data: usize) -> usize {
    const copied = g_list_copy(list)
    if func != 0 {
        const copy: Copy = unsafe { @ptrFromInt(Copy, func) }
        var link = copied
        while link != 0 {
            m.putWord(link + DATA, copy(data(link), user_data))
            link = next(link)
        }
    }
    return copied
}

export fn g_list_nth(list: usize, n: u32) -> usize {
    var link = list
    var k: u32 = 0
    while link != 0 && k < n {
        link = next(link)
        k += 1
    }
    return link
}

export fn g_list_nth_prev(list: usize, n: u32) -> usize {
    var link = list
    var k: u32 = 0
    while link != 0 && k < n {
        link = prev(link)
        k += 1
    }
    return link
}

export fn g_list_nth_data(list: usize, n: u32) -> usize {
    const link = g_list_nth(list, n)
    return if link == 0 { 0 } else { data(link) }
}

export fn g_list_find(list: usize, value: usize) -> usize { return listFind(list, value) }

export fn g_list_find_custom(list: usize, value: usize, func: usize) -> usize {
    const compare: Compare = unsafe { @ptrFromInt(Compare, func) }
    var link = list
    while link != 0 {
        if compare(data(link), value) == 0 { return link }
        link = next(link)
    }
    return 0
}

export fn g_list_position(list: usize, llink: usize) -> i32 {
    var link = list
    var index: i32 = 0
    while link != 0 {
        if link == llink { return index }
        index += 1
        link = next(link)
    }
    return -1
}

export fn g_list_index(list: usize, value: usize) -> i32 {
    var link = list
    var index: i32 = 0
    while link != 0 {
        if data(link) == value { return index }
        index += 1
        link = next(link)
    }
    return -1
}

export fn g_list_last(list: usize) -> usize { return listLast(list) }

export fn g_list_first(list: usize) -> usize {
    if list == 0 { return 0 }
    var link = list
    while prev(link) != 0 { link = prev(link) }
    return link
}

export fn g_list_length(list: usize) -> u32 { return @intCast(u32, listLength(list)) }

export fn g_list_foreach(list: usize, func: usize, user_data: usize) -> void {
    const call: Func = unsafe { @ptrFromInt(Func, func) }
    var link = list
    while link != 0 {
        const following = next(link)
        call(data(link), user_data)
        link = following
    }
}

// A stable merge sort of the links' data (the links are relinked).
fn mergeSort(list: usize, compare: usize, user_data: usize, withData: bool, doubly: bool) -> usize {
    if list == 0 || next(list) == 0 { return list }
    // Split in halves.
    var slow = list
    var fast = next(list)
    while fast != 0 && next(fast) != 0 {
        slow = next(slow)
        fast = next(next(fast))
    }
    var second = next(slow)
    m.putWord(slow + NEXT, 0)
    var first = mergeSort(list, compare, user_data, withData, doubly)
    second = mergeSort(second, compare, user_data, withData, doubly)
    var head: usize = 0
    var tail: usize = 0
    while first != 0 && second != 0 {
        var order: i32 = 0
        if withData {
            const call: CompareData = unsafe { @ptrFromInt(CompareData, compare) }
            order = call(data(first), data(second), user_data)
        } else {
            const call: Compare = unsafe { @ptrFromInt(Compare, compare) }
            order = call(data(first), data(second))
        }
        var taken: usize = 0
        if order <= 0 {
            taken = first
            first = next(first)
        } else {
            taken = second
            second = next(second)
        }
        if tail == 0 { head = taken } else { m.putWord(tail + NEXT, taken) }
        if doubly { m.putWord(taken + PREV, tail) }
        tail = taken
    }
    var rest = if first != 0 { first } else { second }
    if tail == 0 { head = rest } else { m.putWord(tail + NEXT, rest) }
    while rest != 0 {
        if doubly { m.putWord(rest + PREV, tail) }
        tail = rest
        rest = next(rest)
    }
    if doubly && head != 0 { m.putWord(head + PREV, 0) }
    return head
}

export fn g_list_sort(list: usize, compare_func: usize) -> usize { return mergeSort(list, compare_func, 0, false, true) }
export fn g_list_sort_with_data(list: usize, compare_func: usize, user_data: usize) -> usize { return mergeSort(list, compare_func, user_data, true, true) }

// ---------------------------------------------------------------------------
// GSList

pub fn slistLink(value: usize) -> usize {
    const link = m.alloc(16)
    m.putWord(link + DATA, value)
    return link
}

pub fn slistPrepend(list: usize, value: usize) -> usize {
    const link = slistLink(value)
    m.putWord(link + NEXT, list)
    return link
}

pub fn slistAppend(list: usize, value: usize) -> usize {
    const link = slistLink(value)
    if list == 0 { return link }
    m.putWord(listLast(list) + NEXT, link)
    return list
}

pub fn slistRemove(list: usize, value: usize) -> usize {
    var first = list
    var previous: usize = 0
    var link = list
    while link != 0 {
        if data(link) == value {
            if previous == 0 { first = next(link) } else { m.putWord(previous + NEXT, next(link)) }
            m.release(link)
            return first
        }
        previous = link
        link = next(link)
    }
    return first
}

pub fn slistFree(list: usize) -> void { listFree(list) }

export fn g_slist_alloc() -> usize { return slistLink(0) }
export fn g_slist_free(list: usize) -> void { listFree(list) }
export fn g_slist_free_1(list: usize) -> void { m.release(list) }
export fn g_slist_free_full(list: usize, free_func: usize) -> void { g_list_free_full(list, free_func) }
export fn g_slist_append(list: usize, value: usize) -> usize { return slistAppend(list, value) }
export fn g_slist_prepend(list: usize, value: usize) -> usize { return slistPrepend(list, value) }

export fn g_slist_insert(list: usize, value: usize, position: i32) -> usize {
    if position < 0 { return slistAppend(list, value) }
    if position == 0 { return slistPrepend(list, value) }
    var link = list
    var k: i32 = 1
    while link != 0 && next(link) != 0 && k < position {
        link = next(link)
        k += 1
    }
    if link == 0 { return slistLink(value) }
    const made = slistLink(value)
    m.putWord(made + NEXT, next(link))
    m.putWord(link + NEXT, made)
    return list
}

export fn g_slist_insert_sorted(list: usize, value: usize, func: usize) -> usize {
    const compare: Compare = unsafe { @ptrFromInt(Compare, func) }
    var previous: usize = 0
    var link = list
    while link != 0 && compare(value, data(link)) > 0 {
        previous = link
        link = next(link)
    }
    const made = slistLink(value)
    m.putWord(made + NEXT, link)
    if previous == 0 { return made }
    m.putWord(previous + NEXT, made)
    return list
}

export fn g_slist_concat(list1: usize, list2: usize) -> usize {
    if list1 == 0 { return list2 }
    if list2 != 0 { m.putWord(listLast(list1) + NEXT, list2) }
    return list1
}

export fn g_slist_remove(list: usize, value: usize) -> usize { return slistRemove(list, value) }

export fn g_slist_remove_all(list: usize, value: usize) -> usize {
    var first = list
    var previous: usize = 0
    var link = list
    while link != 0 {
        const following = next(link)
        if data(link) == value {
            if previous == 0 { first = following } else { m.putWord(previous + NEXT, following) }
            m.release(link)
        } else {
            previous = link
        }
        link = following
    }
    return first
}

fn slistUnlink(list: usize, target: usize) -> usize {
    var previous: usize = 0
    var link = list
    while link != 0 {
        if link == target {
            const following = next(link)
            m.putWord(link + NEXT, 0)
            if previous == 0 { return following }
            m.putWord(previous + NEXT, following)
            return list
        }
        previous = link
        link = next(link)
    }
    return list
}

export fn g_slist_remove_link(list: usize, link_: usize) -> usize { return slistUnlink(list, link_) }

export fn g_slist_delete_link(list: usize, link_: usize) -> usize {
    const first = slistUnlink(list, link_)
    m.release(link_)
    return first
}

export fn g_slist_reverse(list: usize) -> usize {
    var reversed: usize = 0
    var link = list
    while link != 0 {
        const following = next(link)
        m.putWord(link + NEXT, reversed)
        reversed = link
        link = following
    }
    return reversed
}

export fn g_slist_copy(list: usize) -> usize {
    var result: usize = 0
    var tail: usize = 0
    var link = list
    while link != 0 {
        const made = slistLink(data(link))
        if tail == 0 { result = made } else { m.putWord(tail + NEXT, made) }
        tail = made
        link = next(link)
    }
    return result
}

export fn g_slist_copy_deep(list: usize, func: usize, user_data: usize) -> usize {
    const copied = g_slist_copy(list)
    if func != 0 {
        const copy: Copy = unsafe { @ptrFromInt(Copy, func) }
        var link = copied
        while link != 0 {
            m.putWord(link + DATA, copy(data(link), user_data))
            link = next(link)
        }
    }
    return copied
}

export fn g_slist_nth(list: usize, n: u32) -> usize { return g_list_nth(list, n) }
export fn g_slist_nth_data(list: usize, n: u32) -> usize { return g_list_nth_data(list, n) }
export fn g_slist_find(list: usize, value: usize) -> usize { return listFind(list, value) }
export fn g_slist_find_custom(list: usize, value: usize, func: usize) -> usize { return g_list_find_custom(list, value, func) }
export fn g_slist_position(list: usize, llink: usize) -> i32 { return g_list_position(list, llink) }
export fn g_slist_index(list: usize, value: usize) -> i32 { return g_list_index(list, value) }
export fn g_slist_last(list: usize) -> usize { return listLast(list) }
export fn g_slist_length(list: usize) -> u32 { return @intCast(u32, listLength(list)) }
export fn g_slist_foreach(list: usize, func: usize, user_data: usize) -> void { g_list_foreach(list, func, user_data) }
export fn g_slist_sort(list: usize, compare_func: usize) -> usize { return mergeSort(list, compare_func, 0, false, false) }
export fn g_slist_sort_with_data(list: usize, compare_func: usize, user_data: usize) -> usize { return mergeSort(list, compare_func, user_data, true, false) }
