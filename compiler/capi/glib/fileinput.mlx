// GFileInputStream (gfileinputstream.h) and g_file_read: a file of this
// system read as an input stream, as GIO's GLocalFileInputStream reads
// it: the descriptor read, skipped and moved with lseek, closed once,
// errors with GIO's messages ("Error reading from file: ...").
//
// GFileInputStream is abstract: its class (GInputStreamClass, 248)
// adds tell (248), can_seek (256), seek (264), query_info (272) and its
// asynchronous pair, five reserved; it is a GSeekable through them, the
// seek with the stream pending as GIO's. A GLocalFileInputStream is a
// GInputStream (32), the private word (32) and its descriptor (40).
// g_file_read_async opens the file at once and reports from a task in a
// later iteration of the main context (GIO opens it in a thread; the
// result and its moment are the same).
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const types = @import("./types.mlx")
const ioerrors = @import("./ioerrors.mlx")
const cancellable = @import("./cancellable.mlx")
const streams = @import("./streams.mlx")
const localfile = @import("./localfile.mlx")
const fileinfo = @import("./fileinfo.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_type_add_interface_static(t: usize, iface: usize, info: usize) -> void
extern("c") fn g_input_stream_set_pending(stream: usize, err: usize) -> i32
extern("c") fn g_input_stream_clear_pending(stream: usize) -> void
extern("c") fn g_cancellable_push_current(c: usize) -> void
extern("c") fn g_cancellable_pop_current(c: usize) -> void
extern("c") fn g_task_new(source: usize, c: usize, callback: usize, data: usize) -> usize
extern("c") fn g_task_set_source_tag(task: usize, tag: usize) -> void
extern("c") fn g_task_set_priority(task: usize, priority: i32) -> void
extern("c") fn g_task_return_pointer(task: usize, result: usize, destroy: usize) -> void
extern("c") fn g_task_return_error(task: usize, e: usize) -> void
extern("c") fn g_task_propagate_pointer(task: usize, err: usize) -> usize
extern("c") fn lseek(fd: i32, offset: i64, whence: i32) -> i64
extern("c") fn fstat(fd: i32, buffer: usize) -> i32

const FIS_TELL: usize = streams.INPUT_CLASS_SIZE
const FIS_CAN_SEEK: usize = streams.INPUT_CLASS_SIZE + 8
const FIS_SEEK: usize = streams.INPUT_CLASS_SIZE + 16
const FIS_QUERY_INFO: usize = streams.INPUT_CLASS_SIZE + 24
const FIS_CLASS_SIZE: usize = streams.INPUT_CLASS_SIZE + 88
const L_FD: usize = 40

const IN_READ: usize = 136
const IN_SKIP: usize = 144
const IN_CLOSE: usize = 152

const O_RDONLY: i32 = 0
const O_CLOEXEC: i32 = 524288
const S_IFMT: u32 = 0o170000
const S_IFDIR: u32 = 0o040000
const SEEK_SET_C: i32 = 0
const SEEK_CUR_C: i32 = 1
const SEEK_END_C: i32 = 2

var typesOnce: u64 = 0
var fileInputType: usize = 0
var localInputType: usize = 0
var tagRead: u8 = 0
var tagQueryInfo: u8 = 0

pub const QueryInfoFn = fn(usize, usize, usize, usize) -> usize

fn ensureTypes() -> void {
    if threads.onceEnter(@intFromPtr(&typesOnce)) {
        types.ensureInit()
        fileInputType = ioerrors.defineType(streams.inputGType(), "GFileInputStream", FIS_CLASS_SIZE, 0, 40, 0, types.ABSTRACT)
        const info = m.alloc(24)
        m.putWord(info, @intFromPtr(__mlx_glib_file_input_seekable_init))
        g_type_add_interface_static(fileInputType, streams.seekableGType(), info)
        m.release(info)
        localInputType = ioerrors.defineType(fileInputType, "GLocalFileInputStream", FIS_CLASS_SIZE, @intFromPtr(__mlx_glib_local_input_class_init), 48, @intFromPtr(__mlx_glib_local_input_init), 0)
        threads.onceLeave(@intFromPtr(&typesOnce), 1)
    }
}

export fn g_file_input_stream_get_type() -> usize {
    ensureTypes()
    return fileInputType
}

fn classSlot(stream: usize, offset: usize) -> usize { return m.getWord(m.getWord(stream) + offset) }

// ---------------------------------------------------------------------------
// GFileInputStream as a GSeekable

export fn __mlx_glib_file_input_tell(stream: usize) -> i64 {
    const f = classSlot(stream, FIS_TELL)
    if f == 0 { return 0 }
    const call: streams.TellFn = unsafe { @ptrFromInt(streams.TellFn, f) }
    return call(stream)
}

export fn __mlx_glib_file_input_can_seek(stream: usize) -> i32 {
    if classSlot(stream, FIS_SEEK) == 0 { return 0 }
    const f = classSlot(stream, FIS_CAN_SEEK)
    if f == 0 { return 1 }
    const call: streams.CanPollFn = unsafe { @ptrFromInt(streams.CanPollFn, f) }
    return call(stream)
}

export fn __mlx_glib_file_input_seek(stream: usize, offset: i64, kind: i32, c: usize, err: usize) -> i32 {
    const f = classSlot(stream, FIS_SEEK)
    if f == 0 {
        ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Seek not supported on stream")
        return 0
    }
    if g_input_stream_set_pending(stream, err) == 0 { return 0 }
    if c != 0 { g_cancellable_push_current(c) }
    const call: streams.SeekFn = unsafe { @ptrFromInt(streams.SeekFn, f) }
    const done = call(stream, offset, kind, c, err)
    if c != 0 { g_cancellable_pop_current(c) }
    g_input_stream_clear_pending(stream)
    return done
}

export fn __mlx_glib_file_input_can_truncate(stream: usize) -> i32 { return 0 }

export fn __mlx_glib_file_input_truncate(stream: usize, offset: i64, c: usize, err: usize) -> i32 {
    ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Truncate not allowed on input stream")
    return 0
}

export fn __mlx_glib_file_input_seekable_init(iface: usize, data: usize) -> void {
    m.putWord(iface + streams.SEEK_TELL, @intFromPtr(__mlx_glib_file_input_tell))
    m.putWord(iface + streams.SEEK_CAN_SEEK, @intFromPtr(__mlx_glib_file_input_can_seek))
    m.putWord(iface + streams.SEEK_SEEK, @intFromPtr(__mlx_glib_file_input_seek))
    m.putWord(iface + streams.SEEK_CAN_TRUNCATE, @intFromPtr(__mlx_glib_file_input_can_truncate))
    m.putWord(iface + streams.SEEK_TRUNCATE, @intFromPtr(__mlx_glib_file_input_truncate))
}

// ---------------------------------------------------------------------------
// GLocalFileInputStream

fn fdOf(stream: usize) -> i32 { return m.getI32(stream + L_FD) }

export fn __mlx_glib_local_input_init(stream: usize, class: usize) -> void { m.putI32(stream + L_FD, -1) }

export fn __mlx_glib_local_input_read(stream: usize, buffer: usize, count: usize, c: usize, err: usize) -> i64 {
    while true {
        if cancellable.setErrorIfCancelled(c, err) { return -1 }
        const n = sys.read(fdOf(stream), buffer, count)
        if n >= 0 { return @intCast(i64, n) }
        const errnum = sys.errno()
        if errnum != sys.EINTR {
            ioerrors.setErrno(err, "Error reading from file: ", errnum)
            return -1
        }
    }
    return -1
}

// Skipping moves the position, up to the end at most.
export fn __mlx_glib_local_input_skip(stream: usize, count: usize, c: usize, err: usize) -> i64 {
    if cancellable.setErrorIfCancelled(c, err) { return -1 }
    const fd = fdOf(stream)
    const start = lseek(fd, 0, SEEK_CUR_C)
    if start < 0 {
        ioerrors.setErrno(err, "Error seeking in file: ", sys.errno())
        return -1
    }
    const end = lseek(fd, 0, SEEK_END_C)
    if end < 0 {
        ioerrors.setErrno(err, "Error seeking in file: ", sys.errno())
        return -1
    }
    var position = end
    if end - start > @intCast(i64, count) {
        position = lseek(fd, start + @intCast(i64, count), SEEK_SET_C)
        if position < 0 {
            ioerrors.setErrno(err, "Error seeking in file: ", sys.errno())
            return -1
        }
    }
    return position - start
}

export fn __mlx_glib_local_input_close(stream: usize, c: usize, err: usize) -> i32 {
    const fd = fdOf(stream)
    if fd < 0 { return 1 }
    m.putI32(stream + L_FD, -1)
    if sys.close(fd) != 0 {
        const errnum = sys.errno()
        if errnum != sys.EINTR {
            ioerrors.setErrno(err, "Error closing file: ", errnum)
            return 0
        }
    }
    return 1
}

export fn __mlx_glib_local_input_tell(stream: usize) -> i64 {
    const position = lseek(fdOf(stream), 0, SEEK_CUR_C)
    return if position < 0 { -1 } else { position }
}

export fn __mlx_glib_local_input_can_seek(stream: usize) -> i32 { return if lseek(fdOf(stream), 0, SEEK_CUR_C) >= 0 { 1 } else { 0 } }

export fn __mlx_glib_local_input_seek(stream: usize, offset: i64, kind: i32, c: usize, err: usize) -> i32 {
    var whence = SEEK_SET_C
    if kind == streams.SEEK_CUR {
        whence = SEEK_CUR_C
    } else if kind == streams.SEEK_END {
        whence = SEEK_END_C
    } else if kind != streams.SEEK_SET {
        ioerrors.set(err, ioerrors.INVALID_ARGUMENT, "Invalid GSeekType supplied")
        return 0
    }
    if lseek(fdOf(stream), offset, whence) < 0 {
        ioerrors.setErrno(err, "Error seeking in file: ", sys.errno())
        return 0
    }
    return 1
}

export fn __mlx_glib_local_input_class_init(class: usize, data: usize) -> void {
    m.putWord(class + IN_READ, @intFromPtr(__mlx_glib_local_input_read))
    m.putWord(class + IN_SKIP, @intFromPtr(__mlx_glib_local_input_skip))
    m.putWord(class + IN_CLOSE, @intFromPtr(__mlx_glib_local_input_close))
    m.putWord(class + FIS_TELL, @intFromPtr(__mlx_glib_local_input_tell))
    m.putWord(class + FIS_CAN_SEEK, @intFromPtr(__mlx_glib_local_input_can_seek))
    m.putWord(class + FIS_SEEK, @intFromPtr(__mlx_glib_local_input_seek))
    m.putWord(class + FIS_QUERY_INFO, @intFromPtr(__mlx_glib_local_input_query_info))
}

// What the descriptor's fstat says (GIO's local streams'
// _g_local_file_info_get_from_fd).
export fn __mlx_glib_local_input_query_info(stream: usize, attributes: usize, c: usize, err: usize) -> usize {
    if cancellable.setErrorIfCancelled(c, err) { return 0 }
    return fileinfo.descriptorInfo(fdOf(stream), attributes, err)
}

// ---------------------------------------------------------------------------
// g_file_input_stream_query_info: the class's query_info, the stream
// pending meanwhile, as GIO's.

export fn g_file_input_stream_query_info(stream: usize, attributes: usize, c: usize, err: usize) -> usize {
    const f = classSlot(stream, FIS_QUERY_INFO)
    if f == 0 {
        ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Stream doesn’t support query_info")
        return 0
    }
    if g_input_stream_set_pending(stream, err) == 0 { return 0 }
    if c != 0 { g_cancellable_push_current(c) }
    const call: QueryInfoFn = unsafe { @ptrFromInt(QueryInfoFn, f) }
    const info = call(stream, attributes, c, err)
    if c != 0 { g_cancellable_pop_current(c) }
    g_input_stream_clear_pending(stream)
    return info
}

export fn g_file_input_stream_query_info_async(stream: usize, attributes: usize, priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(stream, c, callback, data)
    g_task_set_source_tag(task, @intFromPtr(&tagQueryInfo))
    g_task_set_priority(task, priority)
    const cell = m.alloc(8)
    m.putWord(cell, 0)
    const info = g_file_input_stream_query_info(stream, attributes, c, cell)
    if info != 0 { g_task_return_pointer(task, info, @intFromPtr(g_object_unref)) } else { g_task_return_error(task, m.getWord(cell)) }
    m.release(cell)
    g_object_unref(task)
}

export fn g_file_input_stream_query_info_finish(stream: usize, result: usize, err: usize) -> usize { return g_task_propagate_pointer(result, err) }

// ---------------------------------------------------------------------------
// g_file_read

export fn g_file_read(file: usize, c: usize, err: usize) -> usize {
    if cancellable.setErrorIfCancelled(c, err) { return 0 }
    const path = localfile.localPath(file)
    if path == 0 {
        ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Operation not supported")
        return 0
    }
    const fd = sys.open(path, O_RDONLY | O_CLOEXEC, 0)
    if fd < 0 {
        localfile.openError(err, file, sys.errno())
        return 0
    }
    const buffer = m.alloc(144)
    const isDirectory = fstat(fd, buffer) == 0 && (m.get32(buffer + 24) & S_IFMT) == S_IFDIR
    m.release(buffer)
    if isDirectory {
        _ = sys.close(fd)
        // As GIO: an error opening the file, EISDIR (21).
        localfile.openError(err, file, 21)
        return 0
    }
    ensureTypes()
    const stream = g_object_new(localInputType, 0)
    m.putI32(stream + L_FD, fd)
    return stream
}

export fn g_file_read_async(file: usize, priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(file, c, callback, data)
    g_task_set_source_tag(task, @intFromPtr(&tagRead))
    g_task_set_priority(task, priority)
    const cell = m.alloc(8)
    const stream = g_file_read(file, c, cell)
    if stream != 0 { g_task_return_pointer(task, stream, @intFromPtr(g_object_unref)) } else { g_task_return_error(task, m.getWord(cell)) }
    m.release(cell)
    g_object_unref(task)
}

export fn g_file_read_finish(file: usize, result: usize, err: usize) -> usize { return g_task_propagate_pointer(result, err) }
