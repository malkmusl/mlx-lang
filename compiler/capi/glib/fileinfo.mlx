// GFileInfo (gfileinfo.h), GFileAttributeMatcher, g_file_query_info and
// g_file_input_stream_query_info, as GIO's gfileinfo.c and
// glocalfileinfo.c have them.
//
// A GFileInfo is a GObject (24) and its attributes (24): a record of
// how many there are (0), its room (8) and the entries (16), 32 bytes
// each: the attribute's name (a C string of its own, 0), its type (8),
// its status (12) and its value (16: a number, or a string, string array
// or object of its own); then its mask (32), a matcher outside of which
// no attribute is set while it is there. A matcher is a record of its
// references (0), its list of attributes as given (8), the names of a
// namespace being enumerated (16) and where the enumeration is (24),
// matched as GIO's matcher matches: "*", "NAMESPACE::*" or the
// attribute's name, separated by commas.
//
// A query of a file of this system sets what GIO's local files set: the
// names (standard::name, display-name, edit-name, copy-name), what lstat
// and stat say (type, size, allocated size, the unix:: fields, the times
// with their microseconds and nanoseconds, statx's creation time), whether
// it is hidden, a backup or a link (and where to), its content type (by
// its name, then by its first bytes when the name does not tell), its
// owner's names, the access rights, etag::value and id::file. Icons,
// thumbnails, extended attributes and SELinux contexts are not set.
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const types = @import("./types.mlx")
const messages = @import("./messages.mlx")
const ioerrors = @import("./ioerrors.mlx")
const errors = @import("./errors.mlx")
const cancellable = @import("./cancellable.mlx")
const localfile = @import("./localfile.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_ref(object: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_date_time_new_from_unix_utc(t: i64) -> usize
extern("c") fn g_date_time_add(d: usize, timespan: i64) -> usize
extern("c") fn g_date_time_unref(d: usize) -> void
extern("c") fn g_date_time_to_unix(d: usize) -> i64
extern("c") fn g_date_time_get_microsecond(d: usize) -> i32
extern("c") fn g_content_type_guess(filename: usize, data: usize, size: usize, uncertain: usize) -> usize
extern("c") fn g_content_type_from_mime_type(mime: usize) -> usize
extern("c") fn g_filename_display_basename(path: usize) -> usize
extern("c") fn g_filename_to_utf8(text: usize, length: i64, read: usize, written: usize, err: usize) -> usize
extern("c") fn g_task_new(source: usize, c: usize, callback: usize, data: usize) -> usize
extern("c") fn g_task_set_source_tag(task: usize, tag: usize) -> void
extern("c") fn g_task_set_priority(task: usize, priority: i32) -> void
extern("c") fn g_task_return_pointer(task: usize, result: usize, destroy: usize) -> void
extern("c") fn g_task_return_error(task: usize, e: usize) -> void
extern("c") fn g_task_propagate_pointer(task: usize, err: usize) -> usize
extern("c") fn g_boxed_type_register_static(name: usize, copy: usize, free: usize) -> usize
extern("c") fn g_filename_display_name(path: usize) -> usize
extern("c") fn g_strdupv(v: usize) -> usize
extern("c") fn g_strfreev(v: usize) -> void
extern("c") fn stat(path: usize, buffer: usize) -> i32
extern("c") fn lstat(path: usize, buffer: usize) -> i32
extern("c") fn fstat(fd: i32, buffer: usize) -> i32
extern("c") fn statx(dirfd: i32, path: usize, flags: i32, mask: u32, buffer: usize) -> i32
extern("c") fn access(path: usize, mode: i32) -> i32
extern("c") fn readlink(path: usize, buffer: usize, size: usize) -> i64
extern("c") fn getpwuid(uid: u32) -> usize
extern("c") fn getgrgid(gid: u32) -> usize
extern("c") fn open(path: usize, flags: i32, mode: u32) -> i32
extern("c") fn read(fd: i32, buffer: usize, count: usize) -> i64
extern("c") fn close(fd: i32) -> i32

pub const T_INVALID: u32 = 0
pub const T_STRING: u32 = 1
pub const T_BYTE_STRING: u32 = 2
pub const T_BOOLEAN: u32 = 3
pub const T_UINT32: u32 = 4
pub const T_INT32: u32 = 5
pub const T_UINT64: u32 = 6
pub const T_INT64: u32 = 7
pub const T_OBJECT: u32 = 8
pub const T_STRINGV: u32 = 9

const STATUS_SET: u32 = 1

const I_ATTRIBUTES: usize = 24
const I_MASK: usize = 32
const INSTANCE_SIZE: usize = 40
const CLASS_SIZE: usize = 136
const ENTRY: usize = 32

var infoType: usize = 0
var infoOnce: u64 = 0
var matcherType: usize = 0
var matcherOnce: u64 = 0

export fn __mlx_glib_file_info_finalize(info: usize) -> void {
    const list = m.getWord(info + I_ATTRIBUTES)
    if list != 0 {
        var i: usize = 0
        while i < m.getWord(list) {
            const e = m.getWord(list + 16) + i * ENTRY
            m.release(m.getWord(e))
            freeValue(e)
            i += 1
        }
        m.release(m.getWord(list + 16))
        m.release(list)
    }
    if m.getWord(info + I_MASK) != 0 { g_file_attribute_matcher_unref(m.getWord(info + I_MASK)) }
    ioerrors.chainUp(types.T_OBJECT, 48, info)
}

export fn __mlx_glib_file_info_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_glib_file_info_finalize))
}

export fn g_file_info_get_type() -> usize {
    if threads.onceEnter(@intFromPtr(&infoOnce)) {
        types.ensureInit()
        infoType = ioerrors.defineType(types.T_OBJECT, "GFileInfo", CLASS_SIZE, @intFromPtr(__mlx_glib_file_info_class_init), INSTANCE_SIZE, 0, 0)
        threads.onceLeave(@intFromPtr(&infoOnce), 1)
    }
    return infoType
}

export fn g_file_info_new() -> usize { return g_object_new(g_file_info_get_type(), 0) }

// ---------------------------------------------------------------------------
// Attributes

fn freeValue(e: usize) -> void {
    const t = m.get32(e + 8)
    const v = m.getWord(e + 16)
    if t == T_STRING || t == T_BYTE_STRING { m.release(v) }
    if t == T_STRINGV { g_strfreev(v) }
    if t == T_OBJECT && v != 0 { g_object_unref(v) }
    m.put32(e + 8, T_INVALID)
    m.putWord(e + 16, 0)
}

fn entryCount(info: usize) -> usize {
    const list = m.getWord(info + I_ATTRIBUTES)
    return if list == 0 { 0 } else { m.getWord(list) }
}

fn entryAt(info: usize, i: usize) -> usize { return m.getWord(m.getWord(info + I_ATTRIBUTES) + 16) + i * ENTRY }

fn find(info: usize, attribute: usize) -> usize {
    if info == 0 || attribute == 0 { return 0 }
    var i: usize = 0
    while i < entryCount(info) {
        const e = entryAt(info, i)
        if m.cEqual(m.getWord(e), attribute) { return e }
        i += 1
    }
    return 0
}

// The entry of the attribute, made when there is none (0 when the mask
// leaves it out).
fn entryFor(info: usize, attribute: usize) -> usize {
    const mask = m.getWord(info + I_MASK)
    if mask != 0 && g_file_attribute_matcher_matches(mask, attribute) == 0 { return 0 }
    const found = find(info, attribute)
    if found != 0 { return found }
    var list = m.getWord(info + I_ATTRIBUTES)
    if list == 0 {
        list = m.alloc(24)
        m.zero(list, 24)
        m.putWord(info + I_ATTRIBUTES, list)
    }
    const n = m.getWord(list)
    if n == m.getWord(list + 8) {
        const room = if n == 0 { 8 } else { n * 2 }
        m.putWord(list + 16, m.grow(m.getWord(list + 16), room * ENTRY))
        m.putWord(list + 8, room)
    }
    const e = m.getWord(list + 16) + n * ENTRY
    m.zero(e, ENTRY)
    m.putWord(e, m.dup(attribute))
    m.putWord(list, n + 1)
    return e
}

fn setValue(info: usize, attribute: usize, t: u32, v: usize) -> void {
    if info == 0 || attribute == 0 { return }
    const e = entryFor(info, attribute)
    if e == 0 { return }
    freeValue(e)
    m.put32(e + 8, t)
    m.put32(e + 12, 0)
    m.putWord(e + 16, v)
}

fn setLiteral(info: usize, attribute: []const u8, t: u32, v: usize) -> void { setValue(info, m.literal(attribute), t, v) }

// A value of the entry as a type, as gfileattribute.c's getters: what the
// attribute holds when it is of that type, else 0 (with GIO's critical).
fn valueAs(info: usize, attribute: usize, t: u32) -> usize {
    const e = find(info, attribute)
    if e == 0 { return 0 }
    if m.get32(e + 8) != t {
        var text = m.text()
        m.pushText(&text, "_g_file_attribute_value_get_")
        m.pushText(&text, typeWord(t))
        m.pushText(&text, ": assertion 'attr->type == G_FILE_ATTRIBUTE_TYPE_")
        m.pushText(&text, typeName(t))
        m.pushText(&text, "' failed")
        messages.log(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, m.finish(&text))
        return 0
    }
    return m.getWord(e + 16)
}

fn typeWord(t: u32) -> []const u8 {
    return match t {
        1 => "string"
        2 => "byte_string"
        3 => "boolean"
        4 => "uint32"
        5 => "int32"
        6 => "uint64"
        7 => "int64"
        8 => "object"
        9 => "stringv"
        else => "invalid"
    }
}

fn typeName(t: u32) -> []const u8 {
    return match t {
        1 => "STRING"
        2 => "BYTE_STRING"
        3 => "BOOLEAN"
        4 => "UINT32"
        5 => "INT32"
        6 => "UINT64"
        7 => "INT64"
        8 => "OBJECT"
        9 => "STRINGV"
        else => "INVALID"
    }
}

// A getter of a common attribute: GIO's critical when it is not there.
fn required(info: usize, attribute: []const u8, t: u32) -> usize {
    if find(info, m.literal(attribute)) == 0 {
        var text = m.text()
        m.pushText(&text, "GFileInfo created without ")
        m.pushText(&text, attribute)
        messages.log(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, m.finish(&text))
        return 0
    }
    return valueAs(info, m.literal(attribute), t)
}

export fn g_file_info_dup(other: usize) -> usize {
    const info = g_file_info_new()
    g_file_info_copy_into(other, info)
    return info
}

export fn g_file_info_copy_into(source: usize, target: usize) -> void {
    if source == 0 || target == 0 { return }
    var i: usize = 0
    while i < entryCount(source) {
        const e = entryAt(source, i)
        const t = m.get32(e + 8)
        var v = m.getWord(e + 16)
        if t == T_STRING || t == T_BYTE_STRING { v = m.dup(v) }
        if t == T_STRINGV { v = g_strdupv(v) }
        if t == T_OBJECT && v != 0 { v = g_object_ref(v) }
        setValue(target, m.getWord(e), t, v)
        const copied = find(target, m.getWord(e))
        if copied != 0 { m.put32(copied + 12, m.get32(e + 12)) }
        i += 1
    }
}

export fn g_file_info_has_attribute(info: usize, attribute: usize) -> i32 { return if find(info, attribute) != 0 { 1 } else { 0 } }

fn inNamespace(name: usize, ns: usize) -> bool {
    const n = m.cLength(ns)
    var i: usize = 0
    while i < n {
        if m.get8(name + i) != m.get8(ns + i) { return false }
        i += 1
    }
    return m.get8(name + n) == ':' && m.get8(name + n + 1) == ':'
}

export fn g_file_info_has_namespace(info: usize, ns: usize) -> i32 {
    var i: usize = 0
    while i < entryCount(info) {
        if inNamespace(m.getWord(entryAt(info, i)), ns) { return 1 }
        i += 1
    }
    return 0
}

export fn g_file_info_list_attributes(info: usize, ns: usize) -> usize {
    var list = m.words()
    var i: usize = 0
    while i < entryCount(info) {
        const name = m.getWord(entryAt(info, i))
        if ns == 0 || inNamespace(name, ns) { m.pushWord(&list, m.dup(name)) }
        i += 1
    }
    m.pushWord(&list, 0)
    return m.finishWords(&list)
}

export fn g_file_info_get_attribute_type(info: usize, attribute: usize) -> i32 {
    const e = find(info, attribute)
    return if e == 0 { 0 } else { @intCast(i32, m.get32(e + 8)) }
}

export fn g_file_info_remove_attribute(info: usize, attribute: usize) -> void {
    const e = find(info, attribute)
    if e == 0 { return }
    m.release(m.getWord(e))
    freeValue(e)
    const list = m.getWord(info + I_ATTRIBUTES)
    const n = m.getWord(list)
    const last = m.getWord(list + 16) + (n - 1) * ENTRY
    if e != last { m.copy(e, e + ENTRY, last - e) }
    m.putWord(list, n - 1)
}

export fn g_file_info_get_attribute_status(info: usize, attribute: usize) -> i32 {
    const e = find(info, attribute)
    return if e == 0 { 0 } else { @intCast(i32, m.get32(e + 12)) }
}

export fn g_file_info_set_attribute_status(info: usize, attribute: usize, status: i32) -> i32 {
    const e = find(info, attribute)
    if e == 0 { return 0 }
    m.put32(e + 12, @bitCast(u32, status))
    return 1
}

export fn g_file_info_clear_status(info: usize) -> void {
    var i: usize = 0
    while i < entryCount(info) {
        m.put32(entryAt(info, i) + 12, 0)
        i += 1
    }
}

// _g_file_attribute_value_as_string: strings escaped as GIO escapes them
// (bytes outside printable ASCII as \xNN), a byte string's too, numbers
// in decimal, booleans TRUE or FALSE, string arrays as [a, b].
fn pushEscaped(t: *m.Text, s: usize) -> void {
    var p = s
    while m.get8(p) != 0 {
        const c = m.get8(p)
        if c < 32 || c > 126 || c == '\\' {
            m.pushText(t, "\\x")
            m.pushHex(t, c)
        } else {
            m.pushByte(t, c)
        }
        p += 1
    }
}

export fn g_file_info_get_attribute_as_string(info: usize, attribute: usize) -> usize {
    const e = find(info, attribute)
    if e == 0 { return 0 }
    const v = m.getWord(e + 16)
    var t = m.text()
    const kind = m.get32(e + 8)
    if kind == T_STRING {
        m.pushC(&t, v)
    } else if kind == T_BYTE_STRING {
        pushEscaped(&t, v)
    } else if kind == T_BOOLEAN {
        m.pushText(&t, if v != 0 { "TRUE" } else { "FALSE" })
    } else if kind == T_UINT32 || kind == T_UINT64 {
        m.pushDecimal(&t, @intCast(u64, v))
    } else if kind == T_INT32 {
        m.pushSigned(&t, @intCast(i64, @bitCast(i32, @intCast(u32, v & 0xffffffff))))
    } else if kind == T_INT64 {
        m.pushSigned(&t, @bitCast(i64, @intCast(u64, v)))
    } else if kind == T_STRINGV {
        m.pushByte(&t, '[')
        var i: usize = 0
        while m.getWord(v + i * 8) != 0 {
            if i > 0 { m.pushText(&t, ", ") }
            m.pushC(&t, m.getWord(v + i * 8))
            i += 1
        }
        m.pushByte(&t, ']')
    } else if kind == T_OBJECT {
        m.pushText(&t, "<object>")
    } else {
        m.pushText(&t, "<invalid>")
    }
    return m.finish(&t)
}

export fn g_file_info_get_attribute_string(info: usize, attribute: usize) -> usize { return valueAs(info, attribute, T_STRING) }
export fn g_file_info_get_attribute_byte_string(info: usize, attribute: usize) -> usize { return valueAs(info, attribute, T_BYTE_STRING) }
export fn g_file_info_get_attribute_boolean(info: usize, attribute: usize) -> i32 { return if valueAs(info, attribute, T_BOOLEAN) != 0 { 1 } else { 0 } }
export fn g_file_info_get_attribute_uint32(info: usize, attribute: usize) -> u32 { return @intCast(u32, valueAs(info, attribute, T_UINT32) & 0xffffffff) }
export fn g_file_info_get_attribute_int32(info: usize, attribute: usize) -> i32 { return @bitCast(i32, @intCast(u32, valueAs(info, attribute, T_INT32) & 0xffffffff)) }
export fn g_file_info_get_attribute_uint64(info: usize, attribute: usize) -> u64 { return @intCast(u64, valueAs(info, attribute, T_UINT64)) }
export fn g_file_info_get_attribute_int64(info: usize, attribute: usize) -> i64 { return @bitCast(i64, @intCast(u64, valueAs(info, attribute, T_INT64))) }
export fn g_file_info_get_attribute_object(info: usize, attribute: usize) -> usize { return valueAs(info, attribute, T_OBJECT) }
export fn g_file_info_get_attribute_stringv(info: usize, attribute: usize) -> usize { return valueAs(info, attribute, T_STRINGV) }

export fn g_file_info_set_attribute_string(info: usize, attribute: usize, v: usize) -> void { setValue(info, attribute, T_STRING, m.dup(v)) }
export fn g_file_info_set_attribute_byte_string(info: usize, attribute: usize, v: usize) -> void { setValue(info, attribute, T_BYTE_STRING, m.dup(v)) }
export fn g_file_info_set_attribute_boolean(info: usize, attribute: usize, v: i32) -> void { setValue(info, attribute, T_BOOLEAN, if v != 0 { 1 } else { 0 }) }
export fn g_file_info_set_attribute_uint32(info: usize, attribute: usize, v: u32) -> void { setValue(info, attribute, T_UINT32, @intCast(usize, v)) }
export fn g_file_info_set_attribute_int32(info: usize, attribute: usize, v: i32) -> void { setValue(info, attribute, T_INT32, @intCast(usize, @bitCast(u32, v))) }
export fn g_file_info_set_attribute_uint64(info: usize, attribute: usize, v: u64) -> void { setValue(info, attribute, T_UINT64, @intCast(usize, v)) }
export fn g_file_info_set_attribute_int64(info: usize, attribute: usize, v: i64) -> void { setValue(info, attribute, T_INT64, @intCast(usize, @bitCast(u64, v))) }
export fn g_file_info_set_attribute_object(info: usize, attribute: usize, v: usize) -> void { setValue(info, attribute, T_OBJECT, if v == 0 { 0 } else { g_object_ref(v) }) }
export fn g_file_info_set_attribute_stringv(info: usize, attribute: usize, v: usize) -> void { setValue(info, attribute, T_STRINGV, g_strdupv(v)) }

export fn g_file_info_set_attribute_mask(info: usize, mask: usize) -> void {
    if m.getWord(info + I_MASK) != 0 { g_file_attribute_matcher_unref(m.getWord(info + I_MASK)) }
    m.putWord(info + I_MASK, if mask == 0 { 0 } else { g_file_attribute_matcher_ref(mask) })
    // (What the mask leaves out goes.)
    if mask == 0 { return }
    var i: usize = 0
    while i < entryCount(info) {
        const e = entryAt(info, i)
        if g_file_attribute_matcher_matches(mask, m.getWord(e)) == 0 {
            g_file_info_remove_attribute(info, m.getWord(e))
        } else {
            i += 1
        }
    }
}

export fn g_file_info_unset_attribute_mask(info: usize) -> void {
    if m.getWord(info + I_MASK) != 0 { g_file_attribute_matcher_unref(m.getWord(info + I_MASK)) }
    m.putWord(info + I_MASK, 0)
}

// ---------------------------------------------------------------------------
// The common attributes

export fn g_file_info_get_file_type(info: usize) -> i32 { return @intCast(i32, required(info, "standard::type", T_UINT32) & 0xffffffff) }
export fn g_file_info_get_is_hidden(info: usize) -> i32 { return if required(info, "standard::is-hidden", T_BOOLEAN) != 0 { 1 } else { 0 } }
export fn g_file_info_get_is_backup(info: usize) -> i32 { return if required(info, "standard::is-backup", T_BOOLEAN) != 0 { 1 } else { 0 } }
export fn g_file_info_get_is_symlink(info: usize) -> i32 { return if required(info, "standard::is-symlink", T_BOOLEAN) != 0 { 1 } else { 0 } }
export fn g_file_info_get_name(info: usize) -> usize { return required(info, "standard::name", T_BYTE_STRING) }
export fn g_file_info_get_display_name(info: usize) -> usize { return required(info, "standard::display-name", T_STRING) }
export fn g_file_info_get_edit_name(info: usize) -> usize { return required(info, "standard::edit-name", T_STRING) }
export fn g_file_info_get_content_type(info: usize) -> usize { return required(info, "standard::content-type", T_STRING) }
export fn g_file_info_get_size(info: usize) -> i64 { return @bitCast(i64, @intCast(u64, required(info, "standard::size", T_UINT64))) }
export fn g_file_info_get_symlink_target(info: usize) -> usize { return required(info, "standard::symlink-target", T_BYTE_STRING) }
export fn g_file_info_get_etag(info: usize) -> usize { return required(info, "etag::value", T_STRING) }
export fn g_file_info_get_sort_order(info: usize) -> i32 { return @bitCast(i32, @intCast(u32, required(info, "standard::sort-order", T_INT32) & 0xffffffff)) }

fn dateTime(info: usize, seconds: []const u8, usec: []const u8) -> usize {
    const e = find(info, m.literal(seconds))
    if e == 0 { return 0 }
    const d = g_date_time_new_from_unix_utc(@bitCast(i64, @intCast(u64, m.getWord(e + 16))))
    const u = find(info, m.literal(usec))
    if u == 0 { return d }
    const added = g_date_time_add(d, @intCast(i64, m.getWord(u + 16) & 0xffffffff))
    g_date_time_unref(d)
    return added
}

export fn g_file_info_get_modification_date_time(info: usize) -> usize { return dateTime(info, "time::modified", "time::modified-usec") }
export fn g_file_info_get_access_date_time(info: usize) -> usize { return dateTime(info, "time::access", "time::access-usec") }
export fn g_file_info_get_creation_date_time(info: usize) -> usize { return dateTime(info, "time::created", "time::created-usec") }

export fn g_file_info_set_file_type(info: usize, t: i32) -> void { setLiteral(info, "standard::type", T_UINT32, @intCast(usize, @bitCast(u32, t))) }
export fn g_file_info_set_is_hidden(info: usize, b: i32) -> void { setLiteral(info, "standard::is-hidden", T_BOOLEAN, if b != 0 { 1 } else { 0 }) }
export fn g_file_info_set_is_symlink(info: usize, b: i32) -> void { setLiteral(info, "standard::is-symlink", T_BOOLEAN, if b != 0 { 1 } else { 0 }) }
export fn g_file_info_set_name(info: usize, name: usize) -> void { setLiteral(info, "standard::name", T_BYTE_STRING, m.dup(name)) }
export fn g_file_info_set_display_name(info: usize, name: usize) -> void { setLiteral(info, "standard::display-name", T_STRING, m.dup(name)) }
export fn g_file_info_set_edit_name(info: usize, name: usize) -> void { setLiteral(info, "standard::edit-name", T_STRING, m.dup(name)) }
export fn g_file_info_set_content_type(info: usize, t: usize) -> void { setLiteral(info, "standard::content-type", T_STRING, m.dup(t)) }
export fn g_file_info_set_size(info: usize, size: i64) -> void { setLiteral(info, "standard::size", T_UINT64, @intCast(usize, @bitCast(u64, size))) }
export fn g_file_info_set_symlink_target(info: usize, target: usize) -> void { setLiteral(info, "standard::symlink-target", T_BYTE_STRING, m.dup(target)) }
export fn g_file_info_set_sort_order(info: usize, order: i32) -> void { setLiteral(info, "standard::sort-order", T_INT32, @intCast(usize, @bitCast(u32, order))) }

fn setDateTime(info: usize, seconds: []const u8, usec: []const u8, nsec: []const u8, d: usize) -> void {
    setLiteral(info, seconds, T_UINT64, @intCast(usize, @bitCast(u64, g_date_time_to_unix(d))))
    const micro = @intCast(usize, @bitCast(u32, g_date_time_get_microsecond(d)))
    setLiteral(info, usec, T_UINT32, micro)
    g_file_info_remove_attribute(info, m.literal(nsec))
}

export fn g_file_info_set_modification_date_time(info: usize, d: usize) -> void { setDateTime(info, "time::modified", "time::modified-usec", "time::modified-nsec", d) }
export fn g_file_info_set_access_date_time(info: usize, d: usize) -> void { setDateTime(info, "time::access", "time::access-usec", "time::access-nsec", d) }
export fn g_file_info_set_creation_date_time(info: usize, d: usize) -> void { setDateTime(info, "time::created", "time::created-usec", "time::created-nsec", d) }

// ---------------------------------------------------------------------------
// GFileAttributeMatcher

export fn g_file_attribute_matcher_get_type() -> usize {
    if threads.onceEnter(@intFromPtr(&matcherOnce)) {
        types.ensureInit()
        matcherType = g_boxed_type_register_static(m.literal("GFileAttributeMatcher"), @intFromPtr(g_file_attribute_matcher_ref), @intFromPtr(g_file_attribute_matcher_unref))
        threads.onceLeave(@intFromPtr(&matcherOnce), 1)
    }
    return matcherType
}

export fn g_file_attribute_matcher_new(attributes: usize) -> usize {
    if attributes == 0 { return 0 }
    const matcher = m.alloc(32)
    m.zero(matcher, 32)
    m.put64(matcher, 1)
    m.putWord(matcher + 8, m.dup(attributes))
    return matcher
}

export fn g_file_attribute_matcher_ref(matcher: usize) -> usize {
    if matcher != 0 { _ = @atomicRmw(u64, m.word64(matcher), add, 1, monotonic) }
    return matcher
}

export fn g_file_attribute_matcher_unref(matcher: usize) -> void {
    if matcher == 0 { return }
    if @atomicRmw(u64, m.word64(matcher), sub, 1, acq_rel) != 1 { return }
    m.release(m.getWord(matcher + 8))
    if m.getWord(matcher + 16) != 0 { g_strfreev(m.getWord(matcher + 16)) }
    m.release(matcher)
}

// Whether the list's token from `start` (`length` bytes, blanks around
// it passed over) asks for `attribute`.
fn tokenMatches(start: usize, length: usize, attribute: usize) -> bool {
    var s = start
    var n = length
    while n > 0 && m.isSpace(m.get8(s)) {
        s += 1
        n -= 1
    }
    while n > 0 && m.isSpace(m.get8(s + n - 1)) { n -= 1 }
    if n == 1 && m.get8(s) == '*' { return true }
    if n >= 3 && m.get8(s + n - 1) == '*' && m.get8(s + n - 2) == ':' && m.get8(s + n - 3) == ':' {
        var i: usize = 0
        while i < n - 1 {
            if m.get8(attribute + i) != m.get8(s + i) { return false }
            i += 1
        }
        return true
    }
    var i: usize = 0
    while i < n {
        if m.get8(attribute + i) != m.get8(s + i) { return false }
        i += 1
    }
    return m.get8(attribute + n) == 0
}

export fn g_file_attribute_matcher_matches(matcher: usize, attribute: usize) -> i32 {
    if matcher == 0 || attribute == 0 { return 0 }
    const list = m.getWord(matcher + 8)
    var start = list
    while true {
        var end = start
        while m.get8(end) != 0 && m.get8(end) != ',' { end += 1 }
        if tokenMatches(start, end - start, attribute) { return 1 }
        if m.get8(end) == 0 { break }
        start = end + 1
    }
    return 0
}

// The list is the attribute alone (GIO: one sub-matcher, the
// attribute's own).
export fn g_file_attribute_matcher_matches_only(matcher: usize, attribute: usize) -> i32 {
    if matcher == 0 || attribute == 0 { return 0 }
    const list = m.getWord(matcher + 8)
    var s = list
    var n = m.cLength(list)
    while n > 0 && m.isSpace(m.get8(s)) {
        s += 1
        n -= 1
    }
    while n > 0 && m.isSpace(m.get8(s + n - 1)) { n -= 1 }
    if n == m.cLength(attribute) && m.same(m.bytes(s, n), m.cSlice(attribute)) { return 1 }
    return 0
}

// Enumerating a namespace: whether all of it is asked for; the names it
// asks for one by one from enumerate_next (a list of the matcher's, 16).
export fn g_file_attribute_matcher_enumerate_namespace(matcher: usize, ns: usize) -> i32 {
    if matcher == 0 || ns == 0 { return 0 }
    var all = false
    var names = m.words()
    const list = m.getWord(matcher + 8)
    var start = list
    while true {
        var end = start
        while m.get8(end) != 0 && m.get8(end) != ',' { end += 1 }
        var s = start
        var n = end - start
        while n > 0 && m.isSpace(m.get8(s)) {
            s += 1
            n -= 1
        }
        while n > 0 && m.isSpace(m.get8(s + n - 1)) { n -= 1 }
        const name = m.dupBytes(s, n)
        if n == 1 && m.get8(s) == '*' {
            all = true
        } else if inNamespace(name, ns) {
            if m.get8(name + m.cLength(ns) + 2) == '*' { all = true } else { m.pushWord(&names, m.dup(name)) }
        }
        m.release(name)
        if m.get8(end) == 0 { break }
        start = end + 1
    }
    m.pushWord(&names, 0)
    const old = m.getWord(matcher + 16)
    if old != 0 { g_strfreev(old) }
    m.putWord(matcher + 16, m.finishWords(&names))
    m.putWord(matcher + 24, 0)
    return if all { 1 } else { 0 }
}

export fn g_file_attribute_matcher_enumerate_next(matcher: usize) -> usize {
    if matcher == 0 { return 0 }
    const names = m.getWord(matcher + 16)
    if names == 0 { return 0 }
    const at = m.getWord(matcher + 24)
    const name = m.getWord(names + at * 8)
    if name != 0 { m.putWord(matcher + 24, at + 1) }
    return name
}

export fn g_file_attribute_matcher_subtract(matcher: usize, subtract: usize) -> usize {
    if matcher == 0 { return 0 }
    if subtract == 0 { return g_file_attribute_matcher_ref(matcher) }
    // Every name of `matcher` that `subtract` does not ask for.
    var t = m.text()
    const list = m.getWord(matcher + 8)
    var start = list
    var count: usize = 0
    while true {
        var end = start
        while m.get8(end) != 0 && m.get8(end) != ',' { end += 1 }
        const name = m.dupBytes(start, end - start)
        if g_file_attribute_matcher_matches(subtract, name) == 0 {
            if count > 0 { m.pushByte(&t, ',') }
            m.pushC(&t, name)
            count += 1
        }
        m.release(name)
        if m.get8(end) == 0 { break }
        start = end + 1
    }
    if count == 0 {
        m.dispose(&t)
        return 0
    }
    const text = m.finish(&t)
    const result = g_file_attribute_matcher_new(text)
    m.release(text)
    return result
}

export fn g_file_attribute_matcher_to_string(matcher: usize) -> usize {
    if matcher == 0 { return m.dupSlice("") }
    return m.dup(m.getWord(matcher + 8))
}

// ---------------------------------------------------------------------------
// The information of the files of this system

// struct stat's fields (x86_64), and statx's creation time.
const ST_DEV: usize = 0
const ST_INO: usize = 8
const ST_NLINK: usize = 16
const ST_MODE: usize = 24
const ST_UID: usize = 28
const ST_GID: usize = 32
const ST_RDEV: usize = 40
const ST_SIZE: usize = 48
const ST_BLKSIZE: usize = 56
const ST_BLOCKS: usize = 64
const ST_ATIME: usize = 72
const ST_MTIME: usize = 88
const ST_CTIME: usize = 104
const STATX_BTIME_MASK: u32 = 2048
const STX_BTIME: usize = 80

const S_IFMT: u32 = 0o170000
const S_IFREG: u32 = 0o100000
const S_IFDIR: u32 = 0o040000
const S_IFLNK: u32 = 0o120000
const S_IFCHR: u32 = 0o020000
const S_IFBLK: u32 = 0o060000
const S_IFIFO: u32 = 0o010000
const S_IFSOCK: u32 = 0o140000

fn modeOf(buffer: usize) -> u32 { return m.get32(buffer + ST_MODE) }

fn setU32(info: usize, attribute: []const u8, v: u64) -> void { setLiteral(info, attribute, T_UINT32, @intCast(usize, v & 0xffffffff)) }
fn setU64(info: usize, attribute: []const u8, v: u64) -> void { setLiteral(info, attribute, T_UINT64, @intCast(usize, v)) }
fn setBool(info: usize, attribute: []const u8, b: bool) -> void { setLiteral(info, attribute, T_BOOLEAN, if b { 1 } else { 0 }) }
fn setString(info: usize, attribute: []const u8, owned: usize) -> void { setLiteral(info, attribute, T_STRING, owned) }

fn wants(matcher: usize, attribute: []const u8) -> bool { return g_file_attribute_matcher_matches(matcher, m.literal(attribute)) != 0 }

// set_info_from_stat.
fn fromStat(info: usize, buffer: usize, matcher: usize, btime: usize) -> void {
    const mode = modeOf(buffer)
    const kind = mode & S_IFMT
    var fileType: u64 = 0
    if kind == S_IFREG {
        fileType = 1
    } else if kind == S_IFDIR {
        fileType = 2
    } else if kind == S_IFCHR || kind == S_IFBLK || kind == S_IFIFO || kind == S_IFSOCK {
        fileType = 4
    } else if kind == S_IFLNK {
        fileType = 3
    }
    setU32(info, "standard::type", fileType)
    setU64(info, "standard::size", m.get64(buffer + ST_SIZE))
    setU32(info, "unix::device", m.get64(buffer + ST_DEV))
    setU32(info, "unix::nlink", m.get64(buffer + ST_NLINK))
    setU64(info, "unix::inode", m.get64(buffer + ST_INO))
    setU32(info, "unix::uid", @intCast(u64, m.get32(buffer + ST_UID)))
    setU32(info, "unix::gid", @intCast(u64, m.get32(buffer + ST_GID)))
    setU32(info, "unix::rdev", m.get64(buffer + ST_RDEV))
    setU32(info, "unix::mode", @intCast(u64, mode))
    setU32(info, "unix::block-size", m.get64(buffer + ST_BLKSIZE))
    setU64(info, "unix::blocks", m.get64(buffer + ST_BLOCKS))
    setU64(info, "standard::allocated-size", m.get64(buffer + ST_BLOCKS) *% 512)
    setU64(info, "time::modified", m.get64(buffer + ST_MTIME))
    setU32(info, "time::modified-usec", m.get64(buffer + ST_MTIME + 8) / 1000)
    setU32(info, "time::modified-nsec", m.get64(buffer + ST_MTIME + 8))
    setU64(info, "time::access", m.get64(buffer + ST_ATIME))
    setU32(info, "time::access-usec", m.get64(buffer + ST_ATIME + 8) / 1000)
    setU32(info, "time::access-nsec", m.get64(buffer + ST_ATIME + 8))
    setU64(info, "time::changed", m.get64(buffer + ST_CTIME))
    setU32(info, "time::changed-usec", m.get64(buffer + ST_CTIME + 8) / 1000)
    setU32(info, "time::changed-nsec", m.get64(buffer + ST_CTIME + 8))
    if btime != 0 && (m.get32(btime) & STATX_BTIME_MASK) != 0 {
        setU64(info, "time::created", m.get64(btime + STX_BTIME))
        setU32(info, "time::created-usec", @intCast(u64, m.get32(btime + STX_BTIME + 8)) / 1000)
        setU32(info, "time::created-nsec", @intCast(u64, m.get32(btime + STX_BTIME + 8)))
    }
    if wants(matcher, "etag::value") {
        var t = m.text()
        m.pushDecimal(&t, m.get64(buffer + ST_MTIME))
        m.pushByte(&t, ':')
        m.pushDecimal(&t, m.get64(buffer + ST_MTIME + 8) / 1000)
        m.pushByte(&t, ':')
        m.pushDecimal(&t, m.get64(buffer + ST_MTIME + 8))
        setString(info, "etag::value", m.finish(&t))
    }
    if wants(matcher, "id::file") {
        var t = m.text()
        m.pushByte(&t, 'l')
        m.pushDecimal(&t, m.get64(buffer + ST_DEV))
        m.pushByte(&t, ':')
        m.pushDecimal(&t, m.get64(buffer + ST_INO))
        setString(info, "id::file", m.finish(&t))
    }
    if wants(matcher, "id::filesystem") {
        var t = m.text()
        m.pushByte(&t, 'l')
        m.pushDecimal(&t, m.get64(buffer + ST_DEV))
        setString(info, "id::filesystem", m.finish(&t))
    }
}

// get_content_type: the kinds of files that are not sniffed, else by the
// name and, when that is uncertain (and not `fast`), the first bytes.
fn contentType(basename: usize, path: usize, buffer: usize, statOk: bool, isSymlink: bool, broken: bool, flags: i32, fast: bool) -> usize {
    if isSymlink && (broken || (flags & 1) != 0) { return g_content_type_from_mime_type(m.literal("inode/symlink")) }
    if statOk {
        const kind = modeOf(buffer) & S_IFMT
        if kind == S_IFDIR { return g_content_type_from_mime_type(m.literal("inode/directory")) }
        if kind == S_IFCHR { return g_content_type_from_mime_type(m.literal("inode/chardevice")) }
        if kind == S_IFBLK { return g_content_type_from_mime_type(m.literal("inode/blockdevice")) }
        if kind == S_IFIFO { return g_content_type_from_mime_type(m.literal("inode/fifo")) }
        if kind == S_IFREG && m.get64(buffer + ST_SIZE) == 0 { return g_content_type_from_mime_type(m.literal("application/x-zerosize")) }
        if kind == S_IFSOCK { return g_content_type_from_mime_type(m.literal("inode/socket")) }
    }
    const uncertain = m.alloc(8)
    m.putI32(uncertain, 0)
    var result = g_content_type_guess(basename, 0, 0, uncertain)
    if !fast && m.getI32(uncertain) != 0 && path != 0 {
        const fd = open(path, 524288, 0)
        if fd >= 0 {
            const sniff = m.alloc(16384)
            const n = read(fd, sniff, 16384)
            _ = close(fd)
            if n >= 0 {
                m.release(result)
                result = g_content_type_guess(basename, sniff, @intCast(usize, n), 0)
            }
            m.release(sniff)
        }
    }
    m.release(uncertain)
    return result
}

// A name of a file listed in its directory's ".hidden" file.
fn listedHidden(path: usize, basename: usize) -> bool {
    var dir = m.text()
    const n = m.cLength(path)
    var slash = n
    while slash > 0 && m.get8(path + slash - 1) != '/' { slash -= 1 }
    if slash == 0 { return false }
    m.pushBytes(&dir, path, slash)
    m.pushText(&dir, ".hidden")
    const file = m.finish(&dir)
    const fd = open(file, 524288, 0)
    m.release(file)
    if fd < 0 { return false }
    const data = m.alloc(65537)
    const got = read(fd, data, 65536)
    _ = close(fd)
    var found = false
    if got > 0 {
        const end = data + @intCast(usize, got)
        var start = data
        const want = m.cLength(basename)
        while start < end && !found {
            var stop = start
            while stop < end && m.get8(stop) != '\n' { stop += 1 }
            if stop - start == want && m.same(m.bytes(start, want), m.cSlice(basename)) { found = true }
            start = stop + 1
        }
    }
    m.release(data)
    return found
}

// get_access_rights: access(2) for reading, writing and running, the
// directory's writability for deleting and renaming.
fn accessRights(info: usize, matcher: usize, path: usize) -> void {
    if wants(matcher, "access::can-read") { setBool(info, "access::can-read", access(path, 4) == 0) }
    if wants(matcher, "access::can-write") { setBool(info, "access::can-write", access(path, 2) == 0) }
    if wants(matcher, "access::can-execute") { setBool(info, "access::can-execute", access(path, 1) == 0) }
    if wants(matcher, "access::can-delete") || wants(matcher, "access::can-rename") {
        var t = m.text()
        const n = m.cLength(path)
        var slash = n
        while slash > 0 && m.get8(path + slash - 1) != '/' { slash -= 1 }
        if slash <= 1 { m.pushText(&t, "/") } else { m.pushBytes(&t, path, slash - 1) }
        const dir = m.finish(&t)
        const writable = access(dir, 2 | 1) == 0
        m.release(dir)
        setBool(info, "access::can-delete", writable)
        setBool(info, "access::can-rename", writable)
    }
}

fn ownerNames(info: usize, matcher: usize, buffer: usize) -> void {
    if wants(matcher, "owner::user") {
        const pw = getpwuid(m.get32(buffer + ST_UID))
        if pw != 0 { setString(info, "owner::user", m.dup(m.getWord(pw))) }
    }
    if wants(matcher, "owner::user-real") {
        const pw = getpwuid(m.get32(buffer + ST_UID))
        if pw != 0 {
            // The GECOS field up to its first comma, else the user name.
            const gecos = m.getWord(pw + 24)
            var n: usize = 0
            if gecos != 0 { while m.get8(gecos + n) != 0 && m.get8(gecos + n) != ',' { n += 1 } }
            setString(info, "owner::user-real", if n > 0 { m.dupBytes(gecos, n) } else { m.dup(m.getWord(pw)) })
        }
    }
    if wants(matcher, "owner::group") {
        const gr = getgrgid(m.get32(buffer + ST_GID))
        if gr != 0 { setString(info, "owner::group", m.dup(m.getWord(gr))) }
    }
}

// _g_local_file_info_get: the information of the file `path` (its last
// part `basename`) that `attributes` asks for; 0 and the error when it
// cannot be read.
pub fn localInfo(basename: usize, path: usize, attributes: usize, flags: i32, err: usize) -> usize {
    const info = g_file_info_new()
    const matcher = g_file_attribute_matcher_new(attributes)
    g_file_info_set_attribute_mask(info, matcher)
    // _g_local_file_info_get_nostat.
    g_file_info_set_name(info, basename)
    if wants(matcher, "standard::display-name") {
        const display = g_filename_display_basename(path)
        g_file_info_set_display_name(info, display)
        m.release(display)
    }
    if wants(matcher, "standard::edit-name") {
        const edit = g_filename_display_basename(path)
        g_file_info_set_edit_name(info, edit)
        m.release(edit)
    }
    if wants(matcher, "standard::copy-name") {
        const copy = g_filename_to_utf8(basename, -1, 0, 0, 0)
        if copy != 0 { setString(info, "standard::copy-name", copy) }
    }
    const buffer = m.alloc(144)
    var statOk = lstat(path, buffer) == 0
    if !statOk {
        const errnum = sys.errno()
        if errnum != 13 {
            var t = m.text()
            m.pushText(&t, "Error when getting information for file “")
            const full = g_filename_display_name(path)
            m.pushC(&t, full)
            m.release(full)
            m.pushText(&t, "”: ")
            m.pushC(&t, errors.errnoText(errnum))
            ioerrors.setText(err, ioerrors.fromErrno(errnum), &t)
            m.release(buffer)
            g_file_attribute_matcher_unref(matcher)
            g_object_unref(info)
            return 0
        }
    }
    const isSymlink = statOk && (modeOf(buffer) & S_IFMT) == S_IFLNK
    var broken = false
    if isSymlink {
        g_file_info_set_is_symlink(info, 1)
        if (flags & 1) == 0 {
            const followed = m.alloc(144)
            if stat(path, followed) == 0 {
                m.copy(buffer, followed, 144)
            } else {
                broken = true
            }
            m.release(followed)
        }
    } else {
        g_file_info_set_is_symlink(info, 0)
    }
    const btime = m.alloc(256)
    m.zero(btime, 256)
    if statOk {
        if statx(-100, path, if (flags & 1) != 0 || broken { 256 } else { 0 }, STATX_BTIME_MASK, btime) != 0 { m.put32(btime, 0) }
        fromStat(info, buffer, matcher, btime)
    }
    m.release(btime)
    if wants(matcher, "standard::is-hidden") {
        setBool(info, "standard::is-hidden", basename != 0 && (m.get8(basename) == '.' || listedHidden(path, basename)))
    }
    const length = m.cLength(basename)
    setBool(info, "standard::is-backup", basename != 0 && length > 0 && m.get8(basename + length - 1) == '~' && statOk && (modeOf(buffer) & S_IFMT) == S_IFREG)
    if isSymlink && wants(matcher, "standard::symlink-target") {
        const target = m.alloc(4097)
        const n = readlink(path, target, 4096)
        if n >= 0 {
            m.put8(target + @intCast(usize, n), 0)
            g_file_info_set_symlink_target(info, target)
        }
        m.release(target)
    }
    if wants(matcher, "standard::content-type") || wants(matcher, "standard::icon") || wants(matcher, "standard::symbolic-icon") {
        const t = contentType(basename, path, buffer, statOk, isSymlink, broken, flags, false)
        if t != 0 {
            g_file_info_set_content_type(info, t)
            m.release(t)
        }
    }
    if wants(matcher, "standard::fast-content-type") {
        const t = contentType(basename, path, buffer, statOk, isSymlink, broken, flags, true)
        if t != 0 { setString(info, "standard::fast-content-type", t) }
    }
    if statOk {
        ownerNames(info, matcher, buffer)
        accessRights(info, matcher, path)
    }
    m.release(buffer)
    g_file_info_unset_attribute_mask(info)
    g_file_attribute_matcher_unref(matcher)
    return info
}

// _g_local_file_info_get_from_fd.
pub fn descriptorInfo(fd: i32, attributes: usize, err: usize) -> usize {
    const buffer = m.alloc(144)
    if fstat(fd, buffer) != 0 {
        const errnum = sys.errno()
        var t = m.text()
        m.pushText(&t, "Error when getting information for file descriptor: ")
        m.pushC(&t, errors.errnoText(errnum))
        ioerrors.setText(err, ioerrors.fromErrno(errnum), &t)
        m.release(buffer)
        return 0
    }
    const info = g_file_info_new()
    const matcher = g_file_attribute_matcher_new(attributes)
    g_file_info_set_attribute_mask(info, matcher)
    const btime = m.alloc(256)
    m.zero(btime, 256)
    if statx(fd, m.literal(""), 4096, STATX_BTIME_MASK, btime) != 0 { m.put32(btime, 0) }
    fromStat(info, buffer, matcher, btime)
    m.release(btime)
    m.release(buffer)
    g_file_info_unset_attribute_mask(info)
    g_file_attribute_matcher_unref(matcher)
    return info
}

// ---------------------------------------------------------------------------
// g_file_query_info

var tagQuery: u8 = 0

export fn g_file_query_info(file: usize, attributes: usize, flags: i32, c: usize, err: usize) -> usize {
    if cancellable.setErrorIfCancelled(c, err) { return 0 }
    const path = localfile.localPath(file)
    if path == 0 {
        ioerrors.set(err, ioerrors.NOT_SUPPORTED, "Operation not supported")
        return 0
    }
    const n = m.cLength(path)
    var slash = n
    while slash > 0 && m.get8(path + slash - 1) != '/' { slash -= 1 }
    // ("/" itself is named "/".)
    const basename = if slash == n { m.dup(path) } else { m.dup(path + slash) }
    const info = localInfo(basename, path, attributes, flags, err)
    m.release(basename)
    return info
}

// As g_file_read_async: the query runs at once; the task reports in a
// later iteration of the main context.
export fn g_file_query_info_async(file: usize, attributes: usize, flags: i32, priority: i32, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(file, c, callback, data)
    g_task_set_source_tag(task, @intFromPtr(&tagQuery))
    g_task_set_priority(task, priority)
    const cell = m.alloc(8)
    m.putWord(cell, 0)
    const info = g_file_query_info(file, attributes, flags, c, cell)
    if info != 0 { g_task_return_pointer(task, info, @intFromPtr(g_object_unref)) } else { g_task_return_error(task, m.getWord(cell)) }
    m.release(cell)
    g_object_unref(task)
}

export fn g_file_query_info_finish(file: usize, result: usize, err: usize) -> usize { return g_task_propagate_pointer(result, err) }
