// D-Bus names and errors (gdbusutils.h, gdbuserror.h) and owning a name
// on a bus (gdbusnameowning.h).
//
// Names are checked as GIO checks them: bus names (unique ones start with
// ':'), interface and error names, member names. A D-Bus error's name is
// mapped to a GError's domain and code by the registered pairs (G_DBUS_ERROR's
// org.freedesktop.DBus.Error.* names, then whatever
// g_dbus_error_register_error adds), else by GIO's encoding of an
// unregistered GError ("org.gtk.GDBus.UnmappedGError.Quark._" and the
// domain's quark with its other characters as "_xx", ".Code" and the
// code), else G_IO_ERROR_DBUS_ERROR; the message is always
// "GDBus.Error:<name>: <message>".
//
// Owning a name is GIO's client of RequestName: NameAcquired and NameLost
// are watched (by signal subscriptions with arg0 the name), the handlers
// run in the owner's thread-default context, each only when the state
// changes, and g_bus_unown_name releases the name with a call it waits
// for.
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const messages = @import("./messages.mlx")
const varargs = @import("./varargs.mlx")
const ioerrors = @import("./ioerrors.mlx")

extern("c") fn g_quark_from_string(text: usize) -> u32
extern("c") fn g_quark_to_string(quark: u32) -> usize
extern("c") fn g_object_ref(object: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_main_context_ref_thread_default() -> usize
extern("c") fn g_main_context_unref(context: usize) -> void
extern("c") fn g_idle_source_new() -> usize
extern("c") fn g_source_set_callback(source: usize, func: usize, data: usize, notify: usize) -> void
extern("c") fn g_source_set_priority(source: usize, priority: i32) -> void
extern("c") fn g_source_attach(source: usize, context: usize) -> u32
extern("c") fn g_source_unref(source: usize) -> void
extern("c") fn g_variant_new_tuple(children: usize, n: usize) -> usize
extern("c") fn g_variant_new_string(text: usize) -> usize
extern("c") fn g_variant_new_uint32(value: u32) -> usize
extern("c") fn g_variant_get_child_value(v: usize, index: usize) -> usize
extern("c") fn g_variant_get_uint32(v: usize) -> u32
extern("c") fn g_variant_get_string(v: usize, length: usize) -> usize
extern("c") fn g_variant_get_type_string(v: usize) -> usize
extern("c") fn g_variant_unref(v: usize) -> void
extern("c") fn g_variant_type_new(text: usize) -> usize
extern("c") fn g_variant_type_free(t: usize) -> void
extern("c") fn g_dbus_connection_call(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout: i32, c: usize, callback: usize, user_data: usize) -> void
extern("c") fn g_dbus_connection_call_finish(connection: usize, res: usize, err: usize) -> usize
extern("c") fn g_dbus_connection_call_sync(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout: i32, c: usize, err: usize) -> usize
extern("c") fn g_dbus_connection_signal_subscribe(connection: usize, sender: usize, interface_name: usize, member: usize, object_path: usize, arg0: usize, flags: i32, callback: usize, user_data: usize, notify: usize) -> u32
extern("c") fn g_dbus_connection_signal_unsubscribe(connection: usize, id: u32) -> void
extern("c") fn g_dbus_connection_is_closed(connection: usize) -> i32
extern("c") fn g_signal_connect_data(instance: usize, signal: usize, handler: usize, data: usize, notify: usize, flags: i32) -> u64
extern("c") fn g_signal_handler_disconnect(instance: usize, id: u64) -> void
extern("c") fn g_bus_get(bus_type: i32, c: usize, callback: usize, user_data: usize) -> void
extern("c") fn g_bus_get_finish(res: usize, err: usize) -> usize
extern("c") fn atoi(text: usize) -> i32

// ---------------------------------------------------------------------------
// Names

fn isNameCharacter(c: u8, hyphen: bool) -> bool { return m.isAlnum(c) || c == '_' || (hyphen && c == '-') }

fn isInitialCharacter(c: u8, digit: bool, hyphen: bool) -> bool {
    if digit { return isNameCharacter(c, hyphen) }
    return m.isAlpha(c) || c == '_' || (hyphen && c == '-')
}

// GIO's is_valid_name: `length` bytes at `start`, elements separated by
// dots, at least one dot.
fn isValidName(start: usize, length: usize, digit: bool, hyphen: bool) -> bool {
    if length == 0 { return false }
    var s = start
    const end = start + length
    var dot = false
    while s < end {
        if m.get8(s) == '.' {
            s += 1
            if s >= end || !isInitialCharacter(m.get8(s), digit, hyphen) { return false }
            dot = true
        } else if !isNameCharacter(m.get8(s), hyphen) {
            return false
        }
        s += 1
    }
    return dot
}

pub fn isName(text: usize) -> bool {
    if text == 0 { return false }
    const length = m.cLength(text)
    if length == 0 || length > 255 { return false }
    const first = m.get8(text)
    if first == ':' { return isValidName(text + 1, length - 1, true, true) }
    if first == '.' || !isInitialCharacter(first, false, true) { return false }
    return isValidName(text + 1, length - 1, false, true)
}

pub fn isUniqueName(text: usize) -> bool {
    if text == 0 { return false }
    const length = m.cLength(text)
    if length == 0 || length > 255 || m.get8(text) != ':' { return false }
    return isValidName(text + 1, length - 1, true, true)
}

pub fn isMemberName(text: usize) -> bool {
    if text == 0 || !isInitialCharacter(m.get8(text), false, false) { return false }
    var p = text + 1
    while m.get8(p) != 0 {
        if !isNameCharacter(m.get8(p), false) { return false }
        p += 1
    }
    return true
}

pub fn isInterfaceName(text: usize) -> bool {
    if text == 0 { return false }
    const length = m.cLength(text)
    if length == 0 || length > 255 { return false }
    const first = m.get8(text)
    if first == '.' || !isInitialCharacter(first, false, false) { return false }
    return isValidName(text + 1, length - 1, false, false)
}

fn critical(function: []const u8, expression: []const u8) -> void {
    var t = m.text()
    m.pushText(&t, function)
    m.pushText(&t, ": assertion '")
    m.pushText(&t, expression)
    m.pushText(&t, "' failed")
    messages.log(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, t.address)
    m.dispose(&t)
}

export fn g_dbus_is_name(text: usize) -> i32 {
    if text == 0 {
        critical("g_dbus_is_name", "string != NULL")
        return 0
    }
    return if isName(text) { 1 } else { 0 }
}

export fn g_dbus_is_unique_name(text: usize) -> i32 {
    if text == 0 {
        critical("g_dbus_is_unique_name", "string != NULL")
        return 0
    }
    return if isUniqueName(text) { 1 } else { 0 }
}

export fn g_dbus_is_member_name(text: usize) -> i32 { return if isMemberName(text) { 1 } else { 0 } }

export fn g_dbus_is_interface_name(text: usize) -> i32 {
    if text == 0 {
        critical("g_dbus_is_interface_name", "string != NULL")
        return 0
    }
    return if isInterfaceName(text) { 1 } else { 0 }
}

export fn g_dbus_is_error_name(text: usize) -> i32 { return if isInterfaceName(text) { 1 } else { 0 } }

// GIO's GUIDs: 32 hex digits.
export fn g_dbus_is_guid(text: usize) -> i32 {
    if text == 0 { return 0 }
    var i: usize = 0
    while i < 32 {
        if !m.isHex(m.get8(text + i)) { return 0 }
        i += 1
    }
    return if m.get8(text + 32) == 0 { 1 } else { 0 }
}

extern("c") fn g_random_int() -> u32

export fn g_dbus_generate_guid() -> usize {
    var t = m.text()
    const hex = "0123456789abcdef"
    var i: usize = 0
    while i < 16 {
        const r = g_random_int()
        m.pushByte(&t, hex[@intCast(usize, (r >> 4) & 15)])
        m.pushByte(&t, hex[@intCast(usize, r & 15)])
        i += 1
    }
    return m.finish(&t)
}

// ---------------------------------------------------------------------------
// Errors

const DBUS_ERROR_NAMES = "Failed NoMemory ServiceUnknown NameHasNoOwner NoReply IOError BadAddress NotSupported LimitsExceeded AccessDenied AuthFailed NoServer Timeout NoNetwork AddressInUse Disconnected InvalidArgs FileNotFound FileExists UnknownMethod TimedOut MatchRuleNotFound MatchRuleInvalid Spawn.ExecFailed Spawn.ForkFailed Spawn.ChildExited Spawn.ChildSignaled Spawn.Failed Spawn.FailedToSetup Spawn.ConfigInvalid Spawn.ServiceNotValid Spawn.ServiceNotFound Spawn.PermissionsInvalid Spawn.FileInvalid Spawn.NoMemory UnixProcessIdUnknown InvalidSignature InvalidFileContent SELinuxSecurityContextUnknown AdtAuditDataUnknown ObjectPathInUse UnknownObject UnknownInterface UnknownProperty PropertyReadOnly"

// The registered pairs: words of records of the domain (0), the code (4)
// and the name (8).
var registeredList: usize = 0
var registeredLock: u32 = 0
var registeredOnce: u64 = 0

fn wordsAt(address: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, address) } }

// The registered pairs and the owners: lists made on first use.
fn registered() -> *m.Words { return wordsAt(registeredList) }

fn owners() -> *m.Words {
    if ownersList == 0 { ownersList = m.alloc(24) }
    return wordsAt(ownersList)
}

fn ensureRegistered() -> void {
    if threads.onceEnter(@intFromPtr(&registeredOnce)) {
        registeredList = m.alloc(24)
        const domain = errors.quarkLiteral("g-dbus-error-quark")
        const names = DBUS_ERROR_NAMES
        var at: usize = 0
        var code: i32 = 0
        while at < names.length {
            var end = at
            while end < names.length && names[end] != ' ' { end += 1 }
            var t = m.text()
            m.pushText(&t, "org.freedesktop.DBus.Error.")
            m.pushBytes(&t, m.literal(names) + at, end - at)
            const name = m.finish(&t)
            _ = register(domain, code, name)
            m.release(name)
            code += 1
            at = end + 1
        }
        threads.onceLeave(@intFromPtr(&registeredOnce), 1)
    }
}

fn register(domain: u32, code: i32, name: usize) -> bool {
    threads.lock(@intFromPtr(&registeredLock))
    var i: usize = 0
    while i < registered().*.length {
        const r = m.wordAt(registered(), i)
        if (m.get32(r) == domain && m.getI32(r + 4) == code) || m.cEqual(m.getWord(r + 8), name) {
            threads.unlock(@intFromPtr(&registeredLock))
            return false
        }
        i += 1
    }
    const r = m.alloc(16)
    m.put32(r, domain)
    m.putI32(r + 4, code)
    m.putWord(r + 8, m.dup(name))
    m.pushWord(registered(), r)
    threads.unlock(@intFromPtr(&registeredLock))
    return true
}

// The registered name of `domain` and `code` (a copy), 0 when none.
fn registeredName(domain: u32, code: i32) -> usize {
    ensureRegistered()
    threads.lock(@intFromPtr(&registeredLock))
    var found: usize = 0
    var i: usize = 0
    while i < registered().*.length && found == 0 {
        const r = m.wordAt(registered(), i)
        if m.get32(r) == domain && m.getI32(r + 4) == code { found = m.dup(m.getWord(r + 8)) }
        i += 1
    }
    threads.unlock(@intFromPtr(&registeredLock))
    return found
}

// The domain and code registered for `name`.
fn registeredPair(name: usize, domain: *u32, code: *i32) -> bool {
    ensureRegistered()
    threads.lock(@intFromPtr(&registeredLock))
    var found = false
    var i: usize = 0
    while i < registered().*.length && !found {
        const r = m.wordAt(registered(), i)
        if m.cEqual(m.getWord(r + 8), name) {
            domain.* = m.get32(r)
            code.* = m.getI32(r + 4)
            found = true
        }
        i += 1
    }
    threads.unlock(@intFromPtr(&registeredLock))
    return found
}

export fn g_dbus_error_register_error(error_domain: u32, error_code: i32, dbus_error_name: usize) -> i32 {
    ensureRegistered()
    return if register(error_domain, error_code, dbus_error_name) { 1 } else { 0 }
}

export fn g_dbus_error_unregister_error(error_domain: u32, error_code: i32, dbus_error_name: usize) -> i32 {
    ensureRegistered()
    threads.lock(@intFromPtr(&registeredLock))
    var removed = false
    var i: usize = 0
    while i < registered().*.length && !removed {
        const r = m.wordAt(registered(), i)
        if m.get32(r) == error_domain && m.getI32(r + 4) == error_code && m.cEqual(m.getWord(r + 8), dbus_error_name) {
            m.putWord(registered().*.address + i * 8, m.wordAt(registered(), registered().*.length - 1))
            registered().*.length -= 1
            m.release(m.getWord(r + 8))
            m.release(r)
            removed = true
        }
        i += 1
    }
    threads.unlock(@intFromPtr(&registeredLock))
    return if removed { 1 } else { 0 }
}

// GDBusErrorEntry records: the code (0) and the name (8).
export fn g_dbus_error_register_error_domain(error_domain_quark_name: usize, quark_volatile: usize, entries: usize, num_entries: u32) -> void {
    if threads.onceEnter(quark_volatile) {
        const quark = g_quark_from_string(error_domain_quark_name)
        var i: usize = 0
        while i < @intCast(usize, num_entries) {
            ensureRegistered()
            _ = register(quark, m.getI32(entries + i * 16), m.getWord(entries + i * 16 + 8))
            i += 1
        }
        threads.onceLeave(quark_volatile, @intCast(u64, quark))
    }
}

// GIO's _g_dbus_error_decode_gerror.
fn decodeUnmapped(name: usize, domain: *u32, code: *i32) -> bool {
    const prefix = "org.gtk.GDBus.UnmappedGError.Quark._"
    if m.cLength(name) < prefix.length || !m.same(m.bytes(name, prefix.length), prefix) { return false }
    var t = m.text()
    var p = name + prefix.length
    while m.get8(p) != '.' && m.get8(p) != 0 {
        const c = m.get8(p)
        if m.isAlnum(c) {
            m.pushByte(&t, c)
        } else if c == '_' {
            const high = m.get8(p + 1)
            const low = if high == 0 { 0 } else { m.get8(p + 2) }
            const okHigh = m.isDigit(high) || (high >= 'a' && high <= 'f')
            const okLow = m.isDigit(low) || (low >= 'a' && low <= 'f')
            if !okHigh || !okLow {
                m.dispose(&t)
                return false
            }
            m.pushByte(&t, (m.hexValue(high) << 4) | m.hexValue(low))
            p += 2
        } else {
            m.dispose(&t)
            return false
        }
        p += 1
    }
    if m.cLength(p) < 5 || !m.same(m.bytes(p, 5), ".Code") {
        m.dispose(&t)
        return false
    }
    m.pushByte(&t, 0)
    domain.* = g_quark_from_string(t.address)
    m.dispose(&t)
    code.* = atoi(p + 5)
    return true
}

// The GError for a D-Bus error `name` with `text`.
pub fn errorFor(name: usize, text: usize) -> usize {
    var domain: u32 = 0
    var code: i32 = 0
    if !registeredPair(name, &domain, &code) && !decodeUnmapped(name, &domain, &code) {
        domain = ioerrors.quark()
        code = 36
    }
    var t = m.text()
    m.pushText(&t, "GDBus.Error:")
    m.pushC(&t, name)
    m.pushText(&t, ": ")
    m.pushC(&t, text)
    return errors.newError(domain, code, m.finish(&t))
}

export fn g_dbus_error_new_for_dbus_error(dbus_error_name: usize, dbus_error_message: usize) -> usize { return errorFor(dbus_error_name, dbus_error_message) }

// GIO's g_dbus_error_set_dbus_error: with a format, the message is its
// text, ": " and the D-Bus error's message.
export fn g_dbus_error_set_dbus_error(err: usize, dbus_error_name: usize, dbus_error_message: usize, format: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> void {
    if err == 0 { return }
    if format == 0 {
        errors.report(err, errorFor(dbus_error_name, dbus_error_message))
        return
    }
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ err, dbus_error_name, dbus_error_message, format, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 4, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    const prefix = varargs.formatted(format, list)
    var t = m.text()
    m.pushC(&t, prefix)
    m.pushText(&t, ": ")
    m.pushC(&t, dbus_error_message)
    m.pushByte(&t, 0)
    m.release(prefix)
    errors.report(err, errorFor(dbus_error_name, t.address))
    m.dispose(&t)
}

pub fn prefixError(e: usize, prefix: usize) -> void {
    var t = m.text()
    m.pushC(&t, prefix)
    m.pushText(&t, ": ")
    m.pushC(&t, errors.message(e))
    m.release(errors.message(e))
    m.putWord(e + 8, m.finish(&t))
}

// The D-Bus error name for a GError (a new string).
pub fn encodeError(e: usize) -> usize {
    const known = registeredName(errors.domainOf(e), errors.code(e))
    if known != 0 { return known }
    const domain = g_quark_to_string(errors.domainOf(e))
    var t = m.text()
    m.pushText(&t, "org.gtk.GDBus.UnmappedGError.Quark._")
    var p = domain
    const hex = "0123456789abcdef"
    while p != 0 && m.get8(p) != 0 {
        const c = m.get8(p)
        if m.isAlnum(c) {
            m.pushByte(&t, c)
        } else {
            m.pushByte(&t, '_')
            m.pushByte(&t, hex[@intCast(usize, c >> 4)])
            m.pushByte(&t, hex[@intCast(usize, c & 15)])
        }
        p += 1
    }
    m.pushText(&t, ".Code")
    m.pushSigned(&t, @intCast(i64, errors.code(e)))
    return m.finish(&t)
}

export fn g_dbus_error_encode_gerror(e: usize) -> usize { return encodeError(e) }

// ---------------------------------------------------------------------------
// Owning names

// An owner: its id (0), references (4), the connection (8), the name
// (16), the flags (24), the handlers for the bus (32), the name acquired
// (40) and lost (48), their data (56) and its notify (64), the context
// (72), the last call made (80: 0 none, 1 acquired, 2 lost), whether it
// was unowned (84), whether the name needs releasing (88), the NameLost
// (92) and NameAcquired (96) subscriptions, the "closed" handler (104).
const O_ID: usize = 0
const O_REFS: usize = 4
const O_CONNECTION: usize = 8
const O_NAME: usize = 16
const O_FLAGS: usize = 24
const O_BUS: usize = 32
const O_ACQUIRED: usize = 40
const O_LOST: usize = 48
const O_DATA: usize = 56
const O_NOTIFY: usize = 64
const O_CONTEXT: usize = 72
const O_PREVIOUS: usize = 80
const O_CANCELLED: usize = 84
const O_RELEASE: usize = 88
const O_SUB_LOST: usize = 92
const O_SUB_ACQUIRED: usize = 96
const O_CLOSED: usize = 104
const O_SIZE: usize = 112

const NameHandler = fn(usize, usize, usize) -> void
const Notify = fn(usize) -> void

var ownersLock: u32 = 0
var ownersList: usize = 0
var nextOwner: u32 = 1

fn ownerRef(o: usize) -> usize {
    threads.refInc(o + O_REFS)
    return o
}

export fn __mlx_glib_dbus_owner_unref(o: usize) -> void {
    if !threads.refDec(o + O_REFS) { return }
    if m.getWord(O_NOTIFY + o) != 0 {
        const notify: Notify = unsafe { @ptrFromInt(Notify, m.getWord(o + O_NOTIFY)) }
        notify(m.getWord(o + O_DATA))
    }
    if m.getWord(o + O_CONNECTION) != 0 { g_object_unref(m.getWord(o + O_CONNECTION)) }
    g_main_context_unref(m.getWord(o + O_CONTEXT))
    m.release(m.getWord(o + O_NAME))
    m.release(o)
}

// An idle call of a handler in the owner's context: the owner (0), the
// connection (8, a reference or 0), the kind (16: 1 acquired, 2 lost).
export fn __mlx_glib_dbus_owner_call_idle(data: usize) -> i32 {
    callHandler(m.getWord(data), m.getWord(data + 8), m.getWord(data + 16))
    return 0
}

export fn __mlx_glib_dbus_owner_call_free(data: usize) -> void {
    if m.getWord(data + 8) != 0 { g_object_unref(m.getWord(data + 8)) }
    __mlx_glib_dbus_owner_unref(m.getWord(data))
    m.release(data)
}

fn callHandler(o: usize, connection: usize, kind: usize) -> void {
    const handler = m.getWord(o + (if kind == 1 { O_ACQUIRED } else { O_LOST }))
    if handler == 0 { return }
    const call: NameHandler = unsafe { @ptrFromInt(NameHandler, handler) }
    call(connection, m.getWord(o + O_NAME), m.getWord(o + O_DATA))
}

// GIO's do_call: at once in the owner's context, else from an idle source
// of it.
fn doCall(o: usize, kind: usize) -> void {
    const current = g_main_context_ref_thread_default()
    if current == m.getWord(o + O_CONTEXT) {
        callHandler(o, m.getWord(o + O_CONNECTION), kind)
    } else {
        const data = m.alloc(24)
        m.putWord(data, ownerRef(o))
        const connection = m.getWord(o + O_CONNECTION)
        m.putWord(data + 8, if connection != 0 { g_object_ref(connection) } else { 0 })
        m.putWord(data + 16, kind)
        const source = g_idle_source_new()
        g_source_set_priority(source, -100)
        g_source_set_callback(source, @intFromPtr(__mlx_glib_dbus_owner_call_idle), data, @intFromPtr(__mlx_glib_dbus_owner_call_free))
        _ = g_source_attach(source, m.getWord(o + O_CONTEXT))
        g_source_unref(source)
    }
    g_main_context_unref(current)
}

fn callIfChanged(o: usize, kind: usize) -> void {
    threads.lock(@intFromPtr(&ownersLock))
    var call = false
    if m.get32(o + O_PREVIOUS) != @intCast(u32, kind) {
        m.put32(o + O_PREVIOUS, @intCast(u32, kind))
        call = m.get32(o + O_CANCELLED) == 0
    }
    threads.unlock(@intFromPtr(&ownersLock))
    if call { doCall(o, kind) }
}

fn unsubscribe(o: usize) -> void {
    const connection = m.getWord(o + O_CONNECTION)
    if connection == 0 { return }
    if m.get32(o + O_SUB_LOST) != 0 { g_dbus_connection_signal_unsubscribe(connection, m.get32(o + O_SUB_LOST)) }
    if m.get32(o + O_SUB_ACQUIRED) != 0 { g_dbus_connection_signal_unsubscribe(connection, m.get32(o + O_SUB_ACQUIRED)) }
    m.put32(o + O_SUB_LOST, 0)
    m.put32(o + O_SUB_ACQUIRED, 0)
}

export fn __mlx_glib_dbus_owner_signal(connection: usize, sender: usize, path: usize, interface: usize, member: usize, parameters: usize, o: usize) -> void {
    if path == 0 || !m.cIs(path, "/org/freedesktop/DBus") || interface == 0 || !m.cIs(interface, "org.freedesktop.DBus") || sender == 0 || !m.cIs(sender, "org.freedesktop.DBus") { return }
    if !m.cIs(g_variant_get_type_string(parameters), "(s)") {
        var t = m.text()
        m.pushC(&t, member)
        m.pushText(&t, " signal had unexpected signature ")
        m.pushC(&t, g_variant_get_type_string(parameters))
        messages.log(m.literal("GLib-GIO"), messages.LEVEL_WARNING, t.address)
        m.dispose(&t)
        return
    }
    const child = g_variant_get_child_value(parameters, 0)
    const same = m.cEqual(g_variant_get_string(child, 0), m.getWord(o + O_NAME))
    g_variant_unref(child)
    if !same { return }
    if m.cIs(member, "NameLost") {
        callIfChanged(o, 2)
    } else if m.cIs(member, "NameAcquired") {
        callIfChanged(o, 1)
    }
}

export fn __mlx_glib_dbus_owner_request_done(source: usize, res: usize, o: usize) -> void {
    const result = g_dbus_connection_call_finish(source, res, 0)
    var reply: u32 = 0
    if result != 0 {
        const child = g_variant_get_child_value(result, 0)
        reply = g_variant_get_uint32(child)
        g_variant_unref(child)
        g_variant_unref(result)
    }
    if reply == 1 {
        callIfChanged(o, 1)
    } else if reply == 2 {
        callIfChanged(o, 2)
    } else {
        callIfChanged(o, 2)
        m.put32(o + O_RELEASE, 0)
        threads.lock(@intFromPtr(&ownersLock))
        const live = m.get32(o + O_CANCELLED) == 0
        threads.unlock(@intFromPtr(&ownersLock))
        if live { unsubscribe(o) }
    }
    __mlx_glib_dbus_owner_unref(o)
}

export fn __mlx_glib_dbus_owner_closed(connection: usize, vanished: i32, e: usize, o: usize) -> void {
    if m.getWord(o + O_CLOSED) != 0 { g_signal_handler_disconnect(connection, @intCast(u64, m.getWord(o + O_CLOSED))) }
    m.putWord(o + O_CLOSED, 0)
    unsubscribe(o)
    g_object_unref(connection)
    m.putWord(o + O_CONNECTION, 0)
    callIfChanged(o, 2)
}

// GIO's has_connection: watch for the connection closing and the name
// coming and going, then ask for it.
fn hasConnection(o: usize) -> void {
    const connection = m.getWord(o + O_CONNECTION)
    m.putWord(o + O_CLOSED, @intCast(usize, g_signal_connect_data(connection, m.literal("closed"), @intFromPtr(__mlx_glib_dbus_owner_closed), o, 0, 0)))
    const bus = m.literal("org.freedesktop.DBus")
    const path = m.literal("/org/freedesktop/DBus")
    m.put32(o + O_SUB_LOST, g_dbus_connection_signal_subscribe(connection, bus, bus, m.literal("NameLost"), path, m.getWord(o + O_NAME), 0, @intFromPtr(__mlx_glib_dbus_owner_signal), ownerRef(o), @intFromPtr(__mlx_glib_dbus_owner_unref)))
    m.put32(o + O_SUB_ACQUIRED, g_dbus_connection_signal_subscribe(connection, bus, bus, m.literal("NameAcquired"), path, m.getWord(o + O_NAME), 0, @intFromPtr(__mlx_glib_dbus_owner_signal), ownerRef(o), @intFromPtr(__mlx_glib_dbus_owner_unref)))
    m.put32(o + O_RELEASE, 1)
    var kids: [2]usize = [2]usize{ g_variant_new_string(m.getWord(o + O_NAME)), g_variant_new_uint32(@intCast(u32, m.getWord(o + O_FLAGS))) }
    const replyType = g_variant_type_new(m.literal("(u)"))
    g_dbus_connection_call(connection, bus, path, bus, m.literal("RequestName"), g_variant_new_tuple(@intFromPtr(&kids), 2), replyType, 0, -1, 0, @intFromPtr(__mlx_glib_dbus_owner_request_done), ownerRef(o))
    g_variant_type_free(replyType)
}

fn newOwner(name: usize, flags: i32, acquired: usize, lost: usize, data: usize, notify: usize) -> usize {
    const o = m.alloc(O_SIZE)
    m.put32(o + O_REFS, 1)
    m.putWord(o + O_NAME, m.dup(name))
    m.putWord(o + O_FLAGS, @intCast(usize, @bitCast(u32, flags)))
    m.putWord(o + O_ACQUIRED, acquired)
    m.putWord(o + O_LOST, lost)
    m.putWord(o + O_DATA, data)
    m.putWord(o + O_NOTIFY, notify)
    m.putWord(o + O_CONTEXT, g_main_context_ref_thread_default())
    threads.lock(@intFromPtr(&ownersLock))
    m.put32(o + O_ID, nextOwner)
    nextOwner += 1
    m.pushWord(owners(), o)
    threads.unlock(@intFromPtr(&ownersLock))
    return o
}

export fn g_bus_own_name_on_connection(connection: usize, name: usize, flags: i32, name_acquired_handler: usize, name_lost_handler: usize, user_data: usize, user_data_free_func: usize) -> u32 {
    if !isName(name) || isUniqueName(name) {
        critical("g_bus_own_name_on_connection", "g_dbus_is_name (name) && !g_dbus_is_unique_name (name)")
        return 0
    }
    const o = newOwner(name, flags, name_acquired_handler, name_lost_handler, user_data, user_data_free_func)
    m.putWord(o + O_CONNECTION, g_object_ref(connection))
    hasConnection(o)
    return m.get32(o + O_ID)
}

export fn __mlx_glib_dbus_owner_bus_ready(source: usize, res: usize, o: usize) -> void {
    const connection = g_bus_get_finish(res, 0)
    threads.lock(@intFromPtr(&ownersLock))
    const cancelled = m.get32(o + O_CANCELLED) != 0
    threads.unlock(@intFromPtr(&ownersLock))
    if connection == 0 || cancelled {
        if connection != 0 { g_object_unref(connection) }
        if !cancelled { callIfChanged(o, 2) }
        __mlx_glib_dbus_owner_unref(o)
        return
    }
    m.putWord(o + O_CONNECTION, connection)
    const bus = m.getWord(o + O_BUS)
    if bus != 0 {
        const call: NameHandler = unsafe { @ptrFromInt(NameHandler, bus) }
        call(connection, m.getWord(o + O_NAME), m.getWord(o + O_DATA))
    }
    hasConnection(o)
    __mlx_glib_dbus_owner_unref(o)
}

export fn g_bus_own_name(bus_type: i32, name: usize, flags: i32, bus_acquired_handler: usize, name_acquired_handler: usize, name_lost_handler: usize, user_data: usize, user_data_free_func: usize) -> u32 {
    if !isName(name) || isUniqueName(name) {
        critical("g_bus_own_name", "g_dbus_is_name (name) && !g_dbus_is_unique_name (name)")
        return 0
    }
    const o = newOwner(name, flags, name_acquired_handler, name_lost_handler, user_data, user_data_free_func)
    m.putWord(o + O_BUS, bus_acquired_handler)
    g_bus_get(bus_type, 0, @intFromPtr(__mlx_glib_dbus_owner_bus_ready), ownerRef(o))
    return m.get32(o + O_ID)
}

export fn g_bus_unown_name(owner_id: u32) -> void {
    threads.lock(@intFromPtr(&ownersLock))
    var o: usize = 0
    var i: usize = 0
    while i < owners().*.length && o == 0 {
        const candidate = m.wordAt(owners(), i)
        if m.get32(candidate + O_ID) == owner_id {
            o = candidate
            m.putWord(owners().*.address + i * 8, m.wordAt(owners(), owners().*.length - 1))
            owners().*.length -= 1
            m.put32(o + O_CANCELLED, 1)
        }
        i += 1
    }
    threads.unlock(@intFromPtr(&ownersLock))
    if o == 0 {
        var t = m.text()
        m.pushText(&t, "Invalid id ")
        m.pushDecimal(&t, @intCast(u64, owner_id))
        m.pushText(&t, " passed to g_bus_unown_name()")
        messages.log(m.literal("GLib-GIO"), messages.LEVEL_WARNING, t.address)
        m.dispose(&t)
        return
    }
    const connection = m.getWord(o + O_CONNECTION)
    if m.get32(o + O_RELEASE) != 0 && connection != 0 && g_dbus_connection_is_closed(connection) == 0 {
        const cell = m.alloc(8)
        var kids: [1]usize = [1]usize{ g_variant_new_string(m.getWord(o + O_NAME)) }
        const replyType = g_variant_type_new(m.literal("(u)"))
        const bus = m.literal("org.freedesktop.DBus")
        const result = g_dbus_connection_call_sync(connection, bus, m.literal("/org/freedesktop/DBus"), bus, m.literal("ReleaseName"), g_variant_new_tuple(@intFromPtr(&kids), 1), replyType, 0, -1, 0, cell)
        g_variant_type_free(replyType)
        if result == 0 {
            var t = m.text()
            m.pushText(&t, "Error releasing name ")
            m.pushC(&t, m.getWord(o + O_NAME))
            m.pushText(&t, ": ")
            m.pushC(&t, errors.message(m.getWord(cell)))
            messages.log(m.literal("GLib-GIO"), messages.LEVEL_WARNING, t.address)
            m.dispose(&t)
            errors.freeError(m.getWord(cell))
        } else {
            const child = g_variant_get_child_value(result, 0)
            const reply = g_variant_get_uint32(child)
            g_variant_unref(child)
            g_variant_unref(result)
            if reply != 1 {
                var t = m.text()
                m.pushText(&t, "Unexpected reply ")
                m.pushDecimal(&t, @intCast(u64, reply))
                m.pushText(&t, " when releasing name ")
                m.pushC(&t, m.getWord(o + O_NAME))
                messages.log(m.literal("GLib-GIO"), messages.LEVEL_WARNING, t.address)
                m.dispose(&t)
            } else {
                m.put32(o + O_RELEASE, 0)
            }
        }
        m.release(cell)
    }
    if connection != 0 {
        if m.getWord(o + O_CLOSED) != 0 { g_signal_handler_disconnect(connection, @intCast(u64, m.getWord(o + O_CLOSED))) }
        m.putWord(o + O_CLOSED, 0)
        unsubscribe(o)
        g_object_unref(connection)
        m.putWord(o + O_CONNECTION, 0)
    }
    __mlx_glib_dbus_owner_unref(o)
}
