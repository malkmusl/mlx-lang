// Smaller parts of GLib: glob patterns (gpattern.h), timers
// (gtimer.h), key files (gkeyfile.h), the shell's quoting (gshell.h),
// the version check (gversion.h).
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const strings = @import("./strings.mlx")
const files = @import("./files.mlx")

// ---------------------------------------------------------------------------
// Patterns: '*' any run of characters, '?' one character (UTF-8's).

fn matchFrom(pattern: usize, text: usize) -> bool {
    var p = pattern
    var t = text
    while m.get8(p) != 0 {
        const c = m.get8(p)
        if c == 42 {
            while m.get8(p) == 42 { p += 1 }
            if m.get8(p) == 0 { return true }
            while true {
                if matchFrom(p, t) { return true }
                if m.get8(t) == 0 { return false }
                t += strings.skipLength(m.get8(t))
            }
        } else if c == 63 {
            if m.get8(t) == 0 { return false }
            t += strings.skipLength(m.get8(t))
            p += 1
        } else {
            if m.get8(t) != c { return false }
            p += 1
            t += 1
        }
    }
    return m.get8(t) == 0
}

pub fn patternMatch(pattern: usize, text: usize) -> bool { return matchFrom(pattern, text) }

export fn g_pattern_spec_new(pattern: usize) -> usize { return m.dup(pattern) }
export fn g_pattern_spec_free(pspec: usize) -> void { m.release(pspec) }
export fn g_pattern_spec_copy(pspec: usize) -> usize { return m.dup(pspec) }
export fn g_pattern_spec_equal(pspec1: usize, pspec2: usize) -> i32 { return if m.cEqual(pspec1, pspec2) { 1 } else { 0 } }
export fn g_pattern_spec_match(pspec: usize, string_length: usize, text: usize, string_reversed: usize) -> i32 { return if matchFrom(pspec, text) { 1 } else { 0 } }
export fn g_pattern_spec_match_string(pspec: usize, text: usize) -> i32 { return if matchFrom(pspec, text) { 1 } else { 0 } }
export fn g_pattern_match(pspec: usize, string_length: u32, text: usize, string_reversed: usize) -> i32 { return if matchFrom(pspec, text) { 1 } else { 0 } }
export fn g_pattern_match_string(pspec: usize, text: usize) -> i32 { return if matchFrom(pspec, text) { 1 } else { 0 } }
export fn g_pattern_match_simple(pattern: usize, text: usize) -> i32 { return if matchFrom(pattern, text) { 1 } else { 0 } }

// ---------------------------------------------------------------------------
// Timers: the start, the end (monotonic microseconds), whether running.

export fn g_timer_new() -> usize {
    const timer = m.alloc(24)
    m.putI64(timer, sys.monotonicMicroseconds())
    m.put32(timer + 16, 1)
    return timer
}

export fn g_timer_destroy(timer: usize) -> void { m.release(timer) }

export fn g_timer_start(timer: usize) -> void {
    m.putI64(timer, sys.monotonicMicroseconds())
    m.put32(timer + 16, 1)
}

export fn g_timer_stop(timer: usize) -> void {
    m.putI64(timer + 8, sys.monotonicMicroseconds())
    m.put32(timer + 16, 0)
}

export fn g_timer_reset(timer: usize) -> void {
    m.putI64(timer, sys.monotonicMicroseconds())
    m.putI64(timer + 8, m.getI64(timer))
}

export fn g_timer_continue(timer: usize) -> void {
    if m.get32(timer + 16) != 0 { return }
    const elapsed = m.getI64(timer + 8) - m.getI64(timer)
    m.putI64(timer, sys.monotonicMicroseconds() - elapsed)
    m.put32(timer + 16, 1)
}

export fn g_timer_elapsed(timer: usize, microseconds: usize) -> f64 {
    const end = if m.get32(timer + 16) != 0 { sys.monotonicMicroseconds() } else { m.getI64(timer + 8) }
    const elapsed = end - m.getI64(timer)
    if microseconds != 0 { m.put64(microseconds, @intCast(u64, elapsed % 1000000)) }
    return @floatFromInt(f64, elapsed) / 1000000.0
}

export fn g_timer_is_active(timer: usize) -> i32 { return @intCast(i32, m.get32(timer + 16)) }

// ---------------------------------------------------------------------------
// Key files: the groups in order, each its name and its (key, value)
// pairs in order; values are kept as written (escapes and all).

const K_GROUPS: usize = 0
const K_REFS: usize = 24
const K_SEPARATOR: usize = 28
const K_SIZE: usize = 32
// A group: name, keys (words of key, value), count, room.
const G_NAME: usize = 0
const G_PAIRS: usize = 8
const G_SIZE: usize = 32

fn keyFileError(err: usize, code: i32, prefix: []const u8, a: usize, middle: []const u8, b: usize, suffix: []const u8) -> void {
    if err == 0 { return }
    var t = m.text()
    m.pushText(&t, prefix)
    if a != 0 { files.pushQuoted(&t, a) }
    m.pushText(&t, middle)
    if b != 0 { files.pushQuoted(&t, b) }
    m.pushText(&t, suffix)
    errors.report(err, errors.newError(errors.quarkLiteral("g-key-file-error-quark"), code, m.finish(&t)))
}

fn groupsOf(k: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, k + K_GROUPS) } }
fn pairsOf(g: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, g + G_PAIRS) } }

fn findGroup(k: usize, name: usize) -> usize {
    const groups = groupsOf(k)
    var index: usize = 0
    while index < groups.*.length {
        const g = m.wordAt(groups, index)
        if m.cEqual(m.getWord(g + G_NAME), name) { return g }
        index += 1
    }
    return 0
}

fn addGroup(k: usize, name: usize, length: usize) -> usize {
    const named = m.dupBytes(name, length)
    const existing = findGroup(k, named)
    if existing != 0 {
        m.release(named)
        return existing
    }
    const g = m.alloc(G_SIZE)
    m.putWord(g + G_NAME, named)
    m.pushWord(groupsOf(k), g)
    return g
}

// The index of `key` among a group's pairs, or -1.
fn findKey(g: usize, key: usize) -> isize {
    const pairs = pairsOf(g)
    var index: usize = 0
    while index < pairs.*.length {
        if m.cEqual(m.wordAt(pairs, index), key) { return @intCast(isize, index) }
        index += 2
    }
    return -1
}

fn setPair(g: usize, key: usize, value: usize) -> void {
    const found = findKey(g, key)
    if found >= 0 {
        const pairs = pairsOf(g)
        m.release(m.wordAt(pairs, @intCast(usize, found) + 1))
        m.putWord(pairs.*.address + (@intCast(usize, found) + 1) * 8, value)
        m.release(key)
        return
    }
    m.pushWord(pairsOf(g), key)
    m.pushWord(pairsOf(g), value)
}

fn clearKeyFile(k: usize) -> void {
    const groups = groupsOf(k)
    var index: usize = 0
    while index < groups.*.length {
        const g = m.wordAt(groups, index)
        const pairs = pairsOf(g)
        var p: usize = 0
        while p < pairs.*.length {
            m.release(m.wordAt(pairs, p))
            p += 1
        }
        m.disposeWords(pairs)
        m.release(m.getWord(g + G_NAME))
        m.release(g)
        index += 1
    }
    m.disposeWords(groups)
}

export fn g_key_file_new() -> usize {
    const k = m.alloc(K_SIZE)
    m.put32(k + K_REFS, 1)
    m.put8(k + K_SEPARATOR, 59)
    return k
}

export fn g_key_file_ref(k: usize) -> usize {
    threads.refInc(k + K_REFS)
    return k
}

export fn g_key_file_unref(k: usize) -> void {
    if threads.refDec(k + K_REFS) {
        clearKeyFile(k)
        m.release(k)
    }
}

export fn g_key_file_free(k: usize) -> void {
    clearKeyFile(k)
    g_key_file_unref(k)
}

export fn g_key_file_set_list_separator(k: usize, separator: u8) -> void { m.put8(k + K_SEPARATOR, separator) }

fn isBlank(c: u8) -> bool { return c == 32 || c == 9 }

pub fn loadData(k: usize, data: usize, length: usize, err: usize) -> bool {
    clearKeyFile(k)
    var group: usize = 0
    var at: usize = 0
    while at < length {
        var end = at
        while end < length && m.get8(data + end) != 10 { end += 1 }
        var lineEnd = end
        if lineEnd > at && m.get8(data + lineEnd - 1) == 13 { lineEnd -= 1 }
        var start = at
        while start < lineEnd && isBlank(m.get8(data + start)) { start += 1 }
        if start == lineEnd || m.get8(data + start) == 35 {
            at = end + 1
            continue
        }
        if m.get8(data + start) == 91 {
            var close = lineEnd
            while close > start && m.get8(data + close - 1) != 93 { close -= 1 }
            if close <= start + 1 {
                const line = m.dupBytes(data + start, lineEnd - start)
                keyFileError(err, 1, "Key file contains line ", line, " which is not a key-value pair, group, or comment", 0, "")
                m.release(line)
                return false
            }
            group = addGroup(k, data + start + 1, close - 1 - start - 1)
            at = end + 1
            continue
        }
        var equals = start
        while equals < lineEnd && m.get8(data + equals) != 61 { equals += 1 }
        if equals == lineEnd {
            const line = m.dupBytes(data + start, lineEnd - start)
            keyFileError(err, 1, "Key file contains line ", line, " which is not a key-value pair, group, or comment", 0, "")
            m.release(line)
            return false
        }
        if group == 0 {
            keyFileError(err, 4, "Key file does not start with a group", 0, "", 0, "")
            return false
        }
        var keyEnd = equals
        while keyEnd > start && isBlank(m.get8(data + keyEnd - 1)) { keyEnd -= 1 }
        var valueStart = equals + 1
        while valueStart < lineEnd && isBlank(m.get8(data + valueStart)) { valueStart += 1 }
        setPair(group, m.dupBytes(data + start, keyEnd - start), m.dupBytes(data + valueStart, lineEnd - valueStart))
        at = end + 1
    }
    return true
}

export fn g_key_file_load_from_data(k: usize, data: usize, length: usize, flags: i32, err: usize) -> i32 {
    const size = if length == 18446744073709551615 { m.cLength(data) } else { length }
    return if loadData(k, data, size, err) { 1 } else { 0 }
}

export fn g_key_file_load_from_file(k: usize, file: usize, flags: i32, err: usize) -> i32 {
    var contents: usize = 0
    var length: usize = 0
    if !files.getContents(file, @intFromPtr(&contents), @intFromPtr(&length), err) { return 0 }
    const ok = loadData(k, contents, length, err)
    m.release(contents)
    return if ok { 1 } else { 0 }
}

export fn g_key_file_to_data(k: usize, length: usize, err: usize) -> usize {
    var t = m.text()
    const groups = groupsOf(k)
    var index: usize = 0
    while index < groups.*.length {
        const g = m.wordAt(groups, index)
        if index > 0 { m.pushByte(&t, 10) }
        m.pushByte(&t, 91)
        m.pushC(&t, m.getWord(g + G_NAME))
        m.pushText(&t, "]\n")
        const pairs = pairsOf(g)
        var p: usize = 0
        while p < pairs.*.length {
            m.pushC(&t, m.wordAt(pairs, p))
            m.pushByte(&t, 61)
            m.pushC(&t, m.wordAt(pairs, p + 1))
            m.pushByte(&t, 10)
            p += 2
        }
        index += 1
    }
    if length != 0 { m.putWord(length, t.length) }
    return m.finish(&t)
}

export fn g_key_file_save_to_file(k: usize, filename: usize, err: usize) -> i32 {
    var length: usize = 0
    const data = g_key_file_to_data(k, @intFromPtr(&length), 0)
    const ok = files.setContents(filename, data, @intCast(i64, length), 3, 438, err)
    m.release(data)
    return ok
}

export fn g_key_file_get_start_group(k: usize) -> usize {
    if groupsOf(k).*.length == 0 { return 0 }
    return m.dup(m.getWord(m.wordAt(groupsOf(k), 0) + G_NAME))
}

export fn g_key_file_get_groups(k: usize, length: usize) -> usize {
    var list = m.words()
    const groups = groupsOf(k)
    var index: usize = 0
    while index < groups.*.length {
        m.pushWord(&list, m.dup(m.getWord(m.wordAt(groups, index) + G_NAME)))
        index += 1
    }
    if length != 0 { m.putWord(length, groups.*.length) }
    return m.finishWords(&list)
}

fn groupOrError(k: usize, group_name: usize, err: usize) -> usize {
    const g = findGroup(k, group_name)
    if g == 0 { keyFileError(err, 4, "Key file does not have group ", group_name, "", 0, "") }
    return g
}

export fn g_key_file_get_keys(k: usize, group_name: usize, length: usize, err: usize) -> usize {
    const g = groupOrError(k, group_name, err)
    if g == 0 {
        if length != 0 { m.putWord(length, 0) }
        return 0
    }
    var list = m.words()
    const pairs = pairsOf(g)
    var p: usize = 0
    while p < pairs.*.length {
        m.pushWord(&list, m.dup(m.wordAt(pairs, p)))
        p += 2
    }
    if length != 0 { m.putWord(length, pairs.*.length / 2) }
    return m.finishWords(&list)
}

export fn g_key_file_has_group(k: usize, group_name: usize) -> i32 { return if findGroup(k, group_name) != 0 { 1 } else { 0 } }

export fn g_key_file_has_key(k: usize, group_name: usize, key: usize, err: usize) -> i32 {
    const g = groupOrError(k, group_name, err)
    if g == 0 { return 0 }
    return if findKey(g, key) >= 0 { 1 } else { 0 }
}

// The value as written of `key` in `group_name` (the key file's own), or
// 0 with the error.
fn rawValue(k: usize, group_name: usize, key: usize, err: usize) -> usize {
    const g = groupOrError(k, group_name, err)
    if g == 0 { return 0 }
    const found = findKey(g, key)
    if found < 0 {
        keyFileError(err, 3, "Key file does not have key ", key, " in group ", group_name, "")
        return 0
    }
    return m.wordAt(pairsOf(g), @intCast(usize, found) + 1)
}

export fn g_key_file_get_value(k: usize, group_name: usize, key: usize, err: usize) -> usize { return m.dup(rawValue(k, group_name, key, err)) }

export fn g_key_file_set_value(k: usize, group_name: usize, key: usize, value: usize) -> void {
    const g = addGroup(k, group_name, m.cLength(group_name))
    setPair(g, m.dup(key), m.dup(value))
}

// A value's escapes (\s \n \t \r \\) read; with `separator`, the list
// separator escaped as itself.
fn unescape(value: usize, length: usize) -> usize {
    var t = m.text()
    var at: usize = 0
    while at < length {
        const c = m.get8(value + at)
        if c == 92 && at + 1 < length {
            const e = m.get8(value + at + 1)
            if e == 115 { m.pushByte(&t, 32) } else if e == 110 { m.pushByte(&t, 10) } else if e == 116 { m.pushByte(&t, 9) } else if e == 114 { m.pushByte(&t, 13) } else { m.pushByte(&t, e) }
            at += 2
        } else {
            m.pushByte(&t, c)
            at += 1
        }
    }
    return m.finish(&t)
}

export fn g_key_file_get_string(k: usize, group_name: usize, key: usize, err: usize) -> usize {
    const value = rawValue(k, group_name, key, err)
    if value == 0 { return 0 }
    return unescape(value, m.cLength(value))
}

export fn g_key_file_get_locale_string(k: usize, group_name: usize, key: usize, locale: usize, err: usize) -> usize {
    if locale != 0 {
        var t = m.text()
        m.pushC(&t, key)
        m.pushByte(&t, 91)
        m.pushC(&t, locale)
        m.pushByte(&t, 93)
        const g = findGroup(k, group_name)
        if g != 0 && findKey(g, t.address) >= 0 {
            const value = g_key_file_get_string(k, group_name, t.address, 0)
            m.dispose(&t)
            return value
        }
        m.dispose(&t)
    }
    return g_key_file_get_string(k, group_name, key, err)
}

export fn g_key_file_set_string(k: usize, group_name: usize, key: usize, text: usize) -> void {
    var t = m.text()
    var at: usize = 0
    while m.get8(text + at) != 0 {
        const c = m.get8(text + at)
        if c == 10 { m.pushText(&t, "\\n") } else if c == 9 { m.pushText(&t, "\\t") } else if c == 13 { m.pushText(&t, "\\r") } else if c == 92 { m.pushText(&t, "\\\\") } else if c == 32 && at == 0 { m.pushText(&t, "\\s") } else { m.pushByte(&t, c) }
        at += 1
    }
    const g = addGroup(k, group_name, m.cLength(group_name))
    setPair(g, m.dup(key), m.finish(&t))
}

export fn g_key_file_get_string_list(k: usize, group_name: usize, key: usize, length: usize, err: usize) -> usize {
    const value = rawValue(k, group_name, key, err)
    if value == 0 { return 0 }
    const separator = m.get8(k + K_SEPARATOR)
    var list = m.words()
    const total = m.cLength(value)
    var start: usize = 0
    var at: usize = 0
    while at < total {
        const c = m.get8(value + at)
        if c == 92 {
            at += 2
            continue
        }
        if c == separator {
            m.pushWord(&list, unescape(value + start, at - start))
            start = at + 1
        }
        at += 1
    }
    if start < total { m.pushWord(&list, unescape(value + start, total - start)) }
    if length != 0 { m.putWord(length, list.length) }
    return m.finishWords(&list)
}

fn invalidValue(err: usize, value: usize, kind: []const u8) -> void { keyFileError(err, 5, "Value ", value, kind, 0, "") }

export fn g_key_file_get_boolean(k: usize, group_name: usize, key: usize, err: usize) -> i32 {
    const value = rawValue(k, group_name, key, err)
    if value == 0 { return 0 }
    if m.cIs(value, "true") || m.cIs(value, "1") { return 1 }
    if m.cIs(value, "false") || m.cIs(value, "0") { return 0 }
    invalidValue(err, value, " cannot be interpreted as a boolean.")
    return 0
}

export fn g_key_file_set_boolean(k: usize, group_name: usize, key: usize, value: i32) -> void { g_key_file_set_value(k, group_name, key, m.literal(if value != 0 { "true" } else { "false" })) }

extern("c") fn strtoll(text: usize, end: usize, base: i32) -> i64
extern("c") fn strtoull(text: usize, end: usize, base: i32) -> u64
extern("c") fn strtod(text: usize, end: usize) -> f64

fn numberEnd(value: usize, end: usize) -> bool {
    // (All of the value was the number, but for blanks after it.)
    var p = m.getWord(end)
    if p == value { return false }
    while isBlank(m.get8(p)) { p += 1 }
    return m.get8(p) == 0
}

export fn g_key_file_get_integer(k: usize, group_name: usize, key: usize, err: usize) -> i32 {
    const value = rawValue(k, group_name, key, err)
    if value == 0 { return 0 }
    var end: usize = 0
    const number = strtoll(value, @intFromPtr(&end), 10)
    if !numberEnd(value, @intFromPtr(&end)) || number > 2147483647 || number < -2147483648 {
        invalidValue(err, value, " cannot be interpreted as a number.")
        return 0
    }
    return @intCast(i32, number)
}

export fn g_key_file_set_integer(k: usize, group_name: usize, key: usize, value: i32) -> void {
    var t = m.text()
    m.pushSigned(&t, @intCast(i64, value))
    const g = addGroup(k, group_name, m.cLength(group_name))
    setPair(g, m.dup(key), m.finish(&t))
}

export fn g_key_file_get_int64(k: usize, group_name: usize, key: usize, err: usize) -> i64 {
    const value = rawValue(k, group_name, key, err)
    if value == 0 { return 0 }
    var end: usize = 0
    const number = strtoll(value, @intFromPtr(&end), 10)
    if !numberEnd(value, @intFromPtr(&end)) {
        invalidValue(err, value, " cannot be interpreted as a number.")
        return 0
    }
    return number
}

export fn g_key_file_get_uint64(k: usize, group_name: usize, key: usize, err: usize) -> u64 {
    const value = rawValue(k, group_name, key, err)
    if value == 0 { return 0 }
    var end: usize = 0
    const number = strtoull(value, @intFromPtr(&end), 10)
    if !numberEnd(value, @intFromPtr(&end)) {
        invalidValue(err, value, " cannot be interpreted as a number.")
        return 0
    }
    return number
}

export fn g_key_file_get_double(k: usize, group_name: usize, key: usize, err: usize) -> f64 {
    const value = rawValue(k, group_name, key, err)
    if value == 0 { return 0.0 }
    var end: usize = 0
    const number = strtod(value, @intFromPtr(&end))
    if !numberEnd(value, @intFromPtr(&end)) {
        invalidValue(err, value, " cannot be interpreted as a float number.")
        return 0.0
    }
    return number
}

export fn g_key_file_remove_group(k: usize, group_name: usize, err: usize) -> i32 {
    const groups = groupsOf(k)
    var index: usize = 0
    while index < groups.*.length {
        const g = m.wordAt(groups, index)
        if m.cEqual(m.getWord(g + G_NAME), group_name) {
            const pairs = pairsOf(g)
            var p: usize = 0
            while p < pairs.*.length {
                m.release(m.wordAt(pairs, p))
                p += 1
            }
            m.disposeWords(pairs)
            m.release(m.getWord(g + G_NAME))
            m.release(g)
            m.copy(groups.*.address + index * 8, groups.*.address + (index + 1) * 8, (groups.*.length - index - 1) * 8)
            groups.*.length -= 1
            return 1
        }
        index += 1
    }
    keyFileError(err, 4, "Key file does not have group ", group_name, "", 0, "")
    return 0
}

export fn g_key_file_remove_key(k: usize, group_name: usize, key: usize, err: usize) -> i32 {
    const g = groupOrError(k, group_name, err)
    if g == 0 { return 0 }
    const found = findKey(g, key)
    if found < 0 {
        keyFileError(err, 3, "Key file does not have key ", key, " in group ", group_name, "")
        return 0
    }
    const pairs = pairsOf(g)
    const at = @intCast(usize, found)
    m.release(m.wordAt(pairs, at))
    m.release(m.wordAt(pairs, at + 1))
    m.copy(pairs.*.address + at * 8, pairs.*.address + (at + 2) * 8, (pairs.*.length - at - 2) * 8)
    pairs.*.length -= 2
    return 1
}

// ---------------------------------------------------------------------------
// The shell's quoting.

fn shellError(err: usize, code: i32, message: []const u8, text: usize) -> void {
    if err == 0 { return }
    var t = m.text()
    m.pushText(&t, message)
    if text != 0 {
        m.pushText(&t, " (The text was ")
        files.pushQuoted(&t, text)
        m.pushByte(&t, 41)
    }
    errors.report(err, errors.newError(errors.quarkLiteral("g-shell-error-quark"), code, m.finish(&t)))
}

export fn g_shell_quote(unquoted_string: usize) -> usize {
    var t = m.text()
    m.pushByte(&t, 39)
    var at: usize = 0
    while m.get8(unquoted_string + at) != 0 {
        const c = m.get8(unquoted_string + at)
        if c == 39 { m.pushText(&t, "'\\''") } else { m.pushByte(&t, c) }
        at += 1
    }
    m.pushByte(&t, 39)
    return m.finish(&t)
}

// Unquotes the text from `at` (single and double quotes, backslashes)
// into `t`; the position after it, or the length + 1 on bad quoting.
export fn g_shell_unquote(quoted_string: usize, err: usize) -> usize {
    var t = m.text()
    var at: usize = 0
    while m.get8(quoted_string + at) != 0 {
        const c = m.get8(quoted_string + at)
        if c == 92 {
            at += 1
            const next = m.get8(quoted_string + at)
            if next == 0 { break }
            // (A backslash before a newline joins the lines.)
            if next != 10 { m.pushByte(&t, next) }
            at += 1
        } else if c == 39 {
            at += 1
            while m.get8(quoted_string + at) != 0 && m.get8(quoted_string + at) != 39 {
                m.pushByte(&t, m.get8(quoted_string + at))
                at += 1
            }
            if m.get8(quoted_string + at) == 0 {
                m.dispose(&t)
                shellError(err, 0, "Unmatched quotation mark in command line or other shell-quoted text", 0)
                return 0
            }
            at += 1
        } else if c == 34 {
            at += 1
            while m.get8(quoted_string + at) != 0 && m.get8(quoted_string + at) != 34 {
                const d = m.get8(quoted_string + at)
                if d == 92 {
                    const e = m.get8(quoted_string + at + 1)
                    if e == 34 || e == 92 || e == 36 || e == 96 {
                        m.pushByte(&t, e)
                        at += 2
                        continue
                    }
                    if e == 10 {
                        at += 2
                        continue
                    }
                }
                m.pushByte(&t, d)
                at += 1
            }
            if m.get8(quoted_string + at) == 0 {
                m.dispose(&t)
                shellError(err, 0, "Unmatched quotation mark in command line or other shell-quoted text", 0)
                return 0
            }
            at += 1
        } else {
            m.pushByte(&t, c)
            at += 1
        }
    }
    return m.finish(&t)
}

// The words of a command line, as /bin/sh splits them (quotes kept
// together, '#' at a word's start a comment to the line's end).
export fn g_shell_parse_argv(command_line: usize, argcp: usize, argvp: usize, err: usize) -> i32 {
    var list = m.words()
    var at: usize = 0
    while true {
        while m.get8(command_line + at) == 32 || m.get8(command_line + at) == 9 || m.get8(command_line + at) == 10 { at += 1 }
        const c = m.get8(command_line + at)
        if c == 0 { break }
        if c == 35 {
            while m.get8(command_line + at) != 0 && m.get8(command_line + at) != 10 { at += 1 }
            continue
        }
        // The word's raw text, quotes included, then unquoted.
        const start = at
        var quote: u8 = 0
        while m.get8(command_line + at) != 0 {
            const d = m.get8(command_line + at)
            if quote == 0 && (d == 32 || d == 9 || d == 10) { break }
            if d == 92 && quote != 39 {
                at += 2
                continue
            }
            if quote == 0 && (d == 39 || d == 34) {
                quote = d
            } else if quote != 0 && d == quote {
                quote = 0
            }
            at += 1
        }
        if quote != 0 {
            var index: usize = 0
            while index < list.length {
                m.release(m.wordAt(&list, index))
                index += 1
            }
            m.disposeWords(&list)
            shellError(err, 0, "Text ended before matching quote was found for ", 0)
            return 0
        }
        const raw = m.dupBytes(command_line + start, at - start)
        const word = g_shell_unquote(raw, 0)
        m.release(raw)
        m.pushWord(&list, word)
    }
    if list.length == 0 {
        m.disposeWords(&list)
        shellError(err, 1, "Text was empty (or contained only whitespace)", 0)
        return 0
    }
    if argcp != 0 { m.putI32(argcp, @intCast(i32, list.length)) }
    if argvp != 0 {
        m.putWord(argvp, m.finishWords(&list))
    } else {
        strings.freeStrv(m.finishWords(&list))
    }
    return 1
}

// ---------------------------------------------------------------------------
// The version.

export fn glib_check_version(required_major: u32, required_minor: u32, required_micro: u32) -> usize {
    if required_major > 2 { return m.literal("GLib version too old (major mismatch)") }
    if required_major < 2 { return m.literal("GLib version too new (major mismatch)") }
    if required_minor > 80 || (required_minor == 80 && required_micro > 0) { return m.literal("GLib version too old (micro mismatch)") }
    return 0
}

// ---------------------------------------------------------------------------
// Messages in the user's language (ggettext.h): there are no message
// catalogs, so a message is the program's own; the plural form is chosen
// by the count as in English, a context's prefix is taken off.

export fn g_dgettext(domain: usize, msgid: usize) -> usize { return msgid }
export fn g_dcgettext(domain: usize, msgid: usize, category: i32) -> usize { return msgid }
export fn g_dngettext(domain: usize, msgid: usize, plural: usize, n: u64) -> usize { return if n == 1 { msgid } else { plural } }
export fn g_dpgettext2(domain: usize, context: usize, msgid: usize) -> usize { return msgid }

// The text after the first SEPARATOR of TEXT, 0 when there is none.
fn after(text: usize, separator: u8) -> usize {
    var p = text
    while m.get8(p) != 0 {
        if m.get8(p) == separator { return p + 1 }
        p += 1
    }
    return 0
}

export fn g_dpgettext(domain: usize, msgctxtid: usize, msgidoffset: usize) -> usize {
    if msgidoffset > 0 { return msgctxtid + msgidoffset }
    const byEot = after(msgctxtid, 4)
    if byEot != 0 { return byEot }
    const byBar = after(msgctxtid, 124)
    return if byBar != 0 { byBar } else { msgctxtid }
}

export fn g_strip_context(msgid: usize, msgval: usize) -> usize {
    if msgval != msgid { return msgval }
    const rest = after(msgid, 124)
    return if rest != 0 { rest } else { msgval }
}
