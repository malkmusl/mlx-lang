// GVariant values in D-Bus's wire format, for GDBus (dbusconnection.mlx):
// a message body from a tuple (its children one after another at D-Bus's
// alignments, little-endian) and a tuple from a body of either byte order
// (std.dbus's Reader). D-Bus has no maybe type: a value holding one cannot
// be sent, as in GLib. Arrays of fixed-size numbers are copied whole both
// ways (their layouts are the same in either format), all other values
// one by one.
const m = @import("./memory.mlx")
const variant = @import("./variant.mlx")
const strings = @import("./strings.mlx")
const dbus = @import("std.dbus")

// ---------------------------------------------------------------------------
// Writing

// The alignment of the type starting with `c` on the wire.
fn wireAlignment(c: u8) -> usize {
    if c == 'y' || c == 'g' || c == 'v' { return 1 }
    if c == 'n' || c == 'q' { return 2 }
    if c == 'x' || c == 't' || c == 'd' || c == '(' || c == '{' { return 8 }
    return 4
}

// The size of a number of the type `c` whose bytes are the same in both
// formats (all fixed-size basic types but booleans), 0 for the others.
fn numberSize(c: u8) -> usize {
    if c == 'y' { return 1 }
    if c == 'n' || c == 'q' { return 2 }
    if c == 'i' || c == 'u' || c == 'h' { return 4 }
    if c == 'x' || c == 't' || c == 'd' { return 8 }
    return 0
}

fn padTo(out: *m.Text, alignment: usize) -> void {
    while out.*.length % alignment != 0 { m.pushByte(out, 0) }
}

fn put32(out: *m.Text, value: u32) -> void {
    padTo(out, 4)
    var i: usize = 0
    while i < 4 {
        m.pushByte(out, @intCast(u8, (value >> @intCast(u5, i * 8)) & 0xff))
        i += 1
    }
}

// A fixed-size basic value's bytes (`size` of them, zeros when the value
// does not hold that many).
fn putNumber(out: *m.Text, v: usize, size: usize) -> void {
    padTo(out, size)
    if variant.sizeOf(v) == size {
        m.pushBytes(out, variant.dataOf(v), size)
    } else {
        var i: usize = 0
        while i < size {
            m.pushByte(out, 0)
            i += 1
        }
    }
}

// Appends `v`; false when it holds what D-Bus cannot carry (a maybe).
pub fn encodeValue(out: *m.Text, v: usize) -> bool {
    const t = variant.typeOf(v)
    const c = m.get8(t)
    if c == 'b' {
        put32(out, if variant.read8(v) != 0 { 1 } else { 0 })
        return true
    }
    const size = numberSize(c)
    if size != 0 {
        putNumber(out, v, size)
        return true
    }
    if c == 's' || c == 'o' {
        const text = variant.stringOf(v)
        const length = m.cLength(text)
        put32(out, @intCast(u32, length))
        m.pushBytes(out, text, length + 1)
        return true
    }
    if c == 'g' {
        const text = variant.stringOf(v)
        const length = m.cLength(text)
        m.pushByte(out, @intCast(u8, length & 0xff))
        m.pushBytes(out, text, length + 1)
        return true
    }
    if c == 'v' {
        const child = variant.childValue(v, 0)
        const inner = variant.typeOf(child)
        const length = m.cLength(inner)
        m.pushByte(out, @intCast(u8, length & 0xff))
        m.pushBytes(out, inner, length + 1)
        const ok = encodeValue(out, child)
        variant.unref(child)
        return ok
    }
    if c == 'a' {
        put32(out, 0)
        const at = out.*.length - 4
        const element = m.get8(t + 1)
        padTo(out, wireAlignment(element))
        const start = out.*.length
        const elementSize = numberSize(element)
        if elementSize != 0 {
            m.pushBytes(out, variant.dataOf(v), variant.sizeOf(v) - variant.sizeOf(v) % elementSize)
        } else {
            const n = variant.childCount(v)
            var i: usize = 0
            while i < n {
                const child = variant.childValue(v, i)
                const ok = encodeValue(out, child)
                variant.unref(child)
                if !ok { return false }
                i += 1
            }
        }
        m.put32(out.*.address + at, @intCast(u32, out.*.length - start))
        return true
    }
    if c == '(' || c == '{' {
        padTo(out, 8)
        const n = variant.childCount(v)
        var i: usize = 0
        while i < n {
            const child = variant.childValue(v, i)
            const ok = encodeValue(out, child)
            variant.unref(child)
            if !ok { return false }
            i += 1
        }
        return true
    }
    return false
}

// A message body: the children of the tuple `body`.
pub fn encodeBody(out: *m.Text, body: usize) -> bool {
    const n = variant.childCount(body)
    var i: usize = 0
    while i < n {
        const child = variant.childValue(body, i)
        const ok = encodeValue(out, child)
        variant.unref(child)
        if !ok { return false }
        i += 1
    }
    return true
}

// Whether a value of the type at `t` (a complete type) holds a maybe
// somewhere.
pub fn hasMaybe(t: usize) -> bool {
    const end = variant.typeEnd(t)
    var p = t
    while p < end {
        if m.get8(p) == 'm' { return true }
        p += 1
    }
    return false
}

// ---------------------------------------------------------------------------
// Reading

fn readerAt(bytes: usize, length: usize, big: bool) -> dbus.Reader {
    unsafe { return dbus.reader(@ptrFromInt([*]const u8, bytes), length, big) }
}

fn readNumber(reading: *dbus.Reader, size: usize) -> u64 {
    dbus.alignTo(reading, size)
    if reading.*.failed || reading.*.position + size > reading.*.length {
        reading.*.failed = true
        return 0
    }
    var value: u64 = 0
    var i: usize = 0
    while i < size {
        const byte = @intCast(u64, reading.*.bytes[reading.*.position + i])
        if reading.*.big {
            value = (value << 8) | byte
        } else {
            value = value | (byte << @intCast(u6, i * 8))
        }
        i += 1
    }
    reading.*.position += size
    return value
}

// A string's bytes (with the NUL the wire has after them), checked: no
// NUL inside, valid UTF-8 for a string, an object path's or a
// signature's syntax. 0 when they are not.
fn checkedText(reading: *dbus.Reader, c: u8, text: []const u8) -> usize {
    if reading.*.failed { return 0 }
    const address = @intFromPtr(text.pointer)
    if m.get8(address + text.length) != 0 || m.cLength(address) != text.length { return 0 }
    if c == 's' && !strings.validate(address, -1, 0) { return 0 }
    if c == 'o' && !variant.isObjectPath(address) { return 0 }
    if c == 'g' && !variant.isSignature(address) { return 0 }
    return address
}

fn releaseAll(kids: *m.Words) -> void {
    var i: usize = 0
    while i < kids.*.length {
        variant.unref(variant.refSink(m.wordAt(kids, i)))
        i += 1
    }
    m.disposeWords(kids)
}

// One value of the complete type at `t` (in a signature already checked):
// a floating GVariant, 0 when the data do not hold one.
fn decodeValue(reading: *dbus.Reader, t: usize, depth: usize) -> usize {
    if depth > 64 { return 0 }
    const c = m.get8(t)
    if c == 'b' {
        const value = dbus.readU32(reading)
        if reading.*.failed || value > 1 { return 0 }
        return variant.fixedValue(m.bytes(t, 1), @intCast(u64, value), 1)
    }
    const size = numberSize(c)
    if size != 0 {
        const value = readNumber(reading, size)
        if reading.*.failed { return 0 }
        return variant.fixedValue(m.bytes(t, 1), value, size)
    }
    if c == 's' || c == 'o' {
        const text = checkedText(reading, c, dbus.readString(reading))
        if text == 0 { return 0 }
        return if c == 's' { variant.newString(text) } else { variant.newObjectPath(text) }
    }
    if c == 'g' {
        const text = checkedText(reading, c, dbus.readSignature(reading))
        if text == 0 { return 0 }
        return variant.newSignature(text)
    }
    if c == 'v' {
        const inner = checkedText(reading, 'g', dbus.readSignature(reading))
        if inner == 0 || m.get8(inner) == 0 || variant.typeEnd(inner) != inner + m.cLength(inner) { return 0 }
        const child = decodeValue(reading, inner, depth + 1)
        if child == 0 { return 0 }
        return variant.newVariant(child)
    }
    if c == 'a' {
        const length = @intCast(usize, dbus.readU32(reading))
        const element = t + 1
        const e = m.get8(element)
        dbus.alignTo(reading, wireAlignment(e))
        if reading.*.failed || reading.*.position + length > reading.*.length || length > 67108864 { return 0 }
        const end = reading.*.position + length
        const elementSize = numberSize(e)
        if elementSize != 0 && !reading.*.big {
            if length % elementSize != 0 { return 0 }
            const whole = variant.dupType(t)
            const v = variant.fromBytes(whole, @intFromPtr(reading.*.bytes) + reading.*.position, length)
            m.release(whole)
            reading.*.position = end
            return v
        }
        var kids = m.words()
        while reading.*.position < end {
            var child: usize = 0
            if e == '{' {
                dbus.alignTo(reading, 8)
                const key = decodeValue(reading, element + 1, depth + 1)
                if key != 0 {
                    const value = decodeValue(reading, variant.typeEnd(element + 1), depth + 1)
                    if value != 0 {
                        child = variant.newDictEntry(key, value)
                    } else {
                        variant.unref(variant.refSink(key))
                    }
                }
            } else {
                child = decodeValue(reading, element, depth + 1)
            }
            if child == 0 || reading.*.position > end {
                if child != 0 { variant.unref(variant.refSink(child)) }
                releaseAll(&kids)
                return 0
            }
            m.pushWord(&kids, child)
        }
        const v = variant.newArray(element, kids.address, kids.length)
        m.disposeWords(&kids)
        return v
    }
    if c == '(' {
        dbus.alignTo(reading, 8)
        var kids = m.words()
        var p = t + 1
        while m.get8(p) != ')' {
            const child = decodeValue(reading, p, depth + 1)
            if child == 0 {
                releaseAll(&kids)
                return 0
            }
            m.pushWord(&kids, child)
            p = variant.typeEnd(p)
        }
        const v = variant.newTuple(kids.address, kids.length)
        m.disposeWords(&kids)
        return v
    }
    return 0
}

// The body (`length` bytes at `bytes`) of a message of `signature` (a NUL
// ended string): a tuple of its values (a full reference), "()" for an
// empty one; 0 when the signature is not one or the data do not hold
// what it says, or hold more.
pub fn decodeBody(bytes: usize, length: usize, big: bool, signature: usize) -> usize {
    if !variant.isSignature(signature) { return 0 }
    var reading = readerAt(bytes, length, big)
    var kids = m.words()
    var p = signature
    while m.get8(p) != 0 {
        if m.get8(p) == '{' {
            releaseAll(&kids)
            return 0
        }
        const child = decodeValue(&reading, p, 0)
        if child == 0 {
            releaseAll(&kids)
            return 0
        }
        m.pushWord(&kids, child)
        p = variant.typeEnd(p)
    }
    if reading.position != length {
        releaseAll(&kids)
        return 0
    }
    const v = variant.newTuple(kids.address, kids.length)
    m.disposeWords(&kids)
    return variant.refSink(v)
}
