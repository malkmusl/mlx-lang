// gioenumtypes.h: the GTypes of GIO's enumerations that libsoup's
// properties and signals carry, with GIO's value names and nicks (as
// glib-mkenums makes them). GTlsCertificateFlags' and
// GTlsProtocolVersion's are the TLS backend's (tls.mlx).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")

extern("c") fn g_enum_register_static(name: usize, values: usize) -> usize

var clientEventType: u64 = 0
var authenticationModeType: u64 = 0

// GEnumValue records (value, name, nick) of `count` values, kept for the
// program's life as GLib requires; names and nicks are space-separated.
fn register(name: []const u8, count: usize, names: []const u8, nicks: []const u8) -> usize {
    const values = m.alloc((count + 1) * 24)
    var nameAt: usize = 0
    var nickAt: usize = 0
    var index: usize = 0
    while index < count {
        var nameEnd = nameAt
        while nameEnd < names.length && names[nameEnd] != 32 { nameEnd += 1 }
        var nickEnd = nickAt
        while nickEnd < nicks.length && nicks[nickEnd] != 32 { nickEnd += 1 }
        m.put32(values + index * 24, @intCast(u32, index))
        m.putWord(values + index * 24 + 8, m.dupBytes(m.literal(names) + nameAt, nameEnd - nameAt))
        m.putWord(values + index * 24 + 16, m.dupBytes(m.literal(nicks) + nickAt, nickEnd - nickAt))
        nameAt = nameEnd + 1
        nickAt = nickEnd + 1
        index += 1
    }
    return g_enum_register_static(m.literal(name), values)
}

export fn g_socket_client_event_get_type() -> usize {
    if threads.onceEnter(@intFromPtr(&clientEventType)) {
        const t = register("GSocketClientEvent", 9, "G_SOCKET_CLIENT_RESOLVING G_SOCKET_CLIENT_RESOLVED G_SOCKET_CLIENT_CONNECTING G_SOCKET_CLIENT_CONNECTED G_SOCKET_CLIENT_PROXY_NEGOTIATING G_SOCKET_CLIENT_PROXY_NEGOTIATED G_SOCKET_CLIENT_TLS_HANDSHAKING G_SOCKET_CLIENT_TLS_HANDSHAKED G_SOCKET_CLIENT_COMPLETE", "resolving resolved connecting connected proxy-negotiating proxy-negotiated tls-handshaking tls-handshaked complete")
        threads.onceLeave(@intFromPtr(&clientEventType), @intCast(u64, t))
    }
    return @intCast(usize, clientEventType)
}

export fn g_tls_authentication_mode_get_type() -> usize {
    if threads.onceEnter(@intFromPtr(&authenticationModeType)) {
        const t = register("GTlsAuthenticationMode", 3, "G_TLS_AUTHENTICATION_NONE G_TLS_AUTHENTICATION_REQUESTED G_TLS_AUTHENTICATION_REQUIRED", "none requested required")
        threads.onceLeave(@intFromPtr(&authenticationModeType), @intCast(u64, t))
    }
    return @intCast(usize, authenticationModeType)
}
