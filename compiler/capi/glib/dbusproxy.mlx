// GDBusProxy (gdbusproxy.h): an object on a connection seen through one
// interface, as GIO's proxy does it. Made (synchronously, or in a thread
// for the asynchronous forms, the callback then in the caller's
// context), it watches its signals ("g-signal"), its properties
// (PropertiesChanged, "g-properties-changed") and who owns its name
// (NameOwnerChanged, "g-name-owner"), as its flags allow; it learns the
// name's owner (starting the service first unless told not to) and loads
// the properties with GetAll. Calls go to the owner (or to the name, for
// D-Bus to start the service), "Interface.Method" names an interface of
// the call's own, and the interface info set on the proxy gives the
// reply type a call must have.
//
// A GDBusProxy: a GObject and (24) this record.
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const messages = @import("./messages.mlx")
const types = @import("./types.mlx")
const ioerrors = @import("./ioerrors.mlx")
const cancellable = @import("./cancellable.mlx")
const variant = @import("./variant.mlx")
const signals = @import("./signals.mlx")
const closures = @import("./closures.mlx")
const names = @import("./dbusnames.mlx")
const connection = @import("./dbusconnection.mlx")
const introspection = @import("./dbus.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_ref(object: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_object_notify(object: usize, name: usize) -> void
extern("c") fn g_object_class_install_property(class: usize, id: u32, pspec: usize) -> void
extern("c") fn g_param_spec_string(name: usize, nick: usize, blurb: usize, default_value: usize, flags: i32) -> usize
extern("c") fn g_param_spec_int(name: usize, nick: usize, blurb: usize, minimum: i32, maximum: i32, default_value: i32, flags: i32) -> usize
extern("c") fn g_param_spec_object(name: usize, nick: usize, blurb: usize, object_type: usize, flags: i32) -> usize
extern("c") fn g_value_set_string(value: usize, text: usize) -> void
extern("c") fn g_value_set_int(value: usize, v: i32) -> void
extern("c") fn g_value_get_int(value: usize) -> i32
extern("c") fn g_value_set_object(value: usize, object: usize) -> void
extern("c") fn g_type_check_instance_is_a(instance: usize, t: usize) -> i32
extern("c") fn g_strv_get_type() -> usize
extern("c") fn g_quark_try_string(text: usize) -> u32
extern("c") fn g_signal_emit(instance: usize, id: u32, detail: u32, a: usize, b: usize, c: usize) -> void
extern("c") fn g_main_context_ref_thread_default() -> usize
extern("c") fn g_main_context_unref(context: usize) -> void
extern("c") fn g_task_new(source_object: usize, c: usize, callback: usize, data: usize) -> usize
extern("c") fn g_task_set_source_tag(task: usize, tag: usize) -> void
extern("c") fn g_task_return_pointer(task: usize, result: usize, destroy: usize) -> void
extern("c") fn g_task_return_boolean(task: usize, result: i32) -> void
extern("c") fn g_task_return_error(task: usize, e: usize) -> void
extern("c") fn g_task_propagate_pointer(task: usize, err: usize) -> usize
extern("c") fn g_task_propagate_boolean(task: usize, err: usize) -> i32
extern("c") fn g_task_get_source_object(task: usize) -> usize
extern("c") fn g_task_run_in_thread(task: usize, func: usize) -> void
extern("c") fn g_dbus_connection_call(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout: i32, c: usize, callback: usize, user_data: usize) -> void
extern("c") fn g_dbus_connection_call_finish(connection: usize, res: usize, err: usize) -> usize
extern("c") fn g_dbus_connection_call_sync(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout: i32, c: usize, err: usize) -> usize
extern("c") fn g_dbus_connection_call_with_unix_fd_list(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout: i32, fd_list: usize, c: usize, callback: usize, user_data: usize) -> void
extern("c") fn g_dbus_connection_call_with_unix_fd_list_finish(connection: usize, out_fd_list: usize, res: usize, err: usize) -> usize
extern("c") fn g_dbus_connection_call_with_unix_fd_list_sync(connection: usize, bus_name: usize, object_path: usize, interface_name: usize, method_name: usize, parameters: usize, reply_type: usize, flags: i32, timeout: i32, fd_list: usize, out_fd_list: usize, c: usize, err: usize) -> usize
extern("c") fn g_dbus_connection_signal_unsubscribe(connection: usize, id: u32) -> void
extern("c") fn g_dbus_connection_get_flags(connection: usize) -> i32
extern("c") fn g_dbus_error_get_remote_error(e: usize) -> usize
extern("c") fn g_dbus_error_strip_remote_error(e: usize) -> i32

const X_CONNECTION: usize = 0
const X_FLAGS: usize = 8
const X_TIMEOUT: usize = 12
const X_NAME: usize = 16
const X_OWNER: usize = 24
const X_PATH: usize = 32
const X_INTERFACE: usize = 40
const X_INFO: usize = 48
const X_CACHE: usize = 56
const X_SUB_PROPERTIES: usize = 80
const X_SUB_SIGNALS: usize = 84
const X_SUB_OWNER: usize = 88
const X_LOCK: usize = 92
const X_CONTEXT: usize = 96
const X_BUS: usize = 104
const X_INITIALIZED: usize = 108
const X_SIZE: usize = 112

// Proxy flags.
const DO_NOT_LOAD_PROPERTIES: u32 = 1
const DO_NOT_CONNECT_SIGNALS: u32 = 2
const DO_NOT_AUTO_START: u32 = 4
const DO_NOT_AUTO_START_AT_CONSTRUCTION: u32 = 16
const NO_MATCH_RULE: u32 = 32

const PROP_CONNECTION: u32 = 1
const PROP_NAME: u32 = 2
const PROP_NAME_OWNER: u32 = 3
const PROP_OBJECT_PATH: u32 = 4
const PROP_INTERFACE_NAME: u32 = 5
const PROP_DEFAULT_TIMEOUT: u32 = 6

var proxyOnce: u64 = 0
var proxyType: usize = 0
var propertiesChangedSignal: u32 = 0
var signalSignal: u32 = 0
var newTag: u8 = 0
var callTag: u8 = 0

fn rec(proxy: usize) -> usize { return m.getWord(proxy + 24) }
fn wordsAt(address: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, address) } }
fn dupOrNull(text: usize) -> usize { return if text == 0 { 0 } else { m.dup(text) } }

fn critical(function: []const u8, expression: []const u8) -> void {
    var t = m.text()
    m.pushText(&t, function)
    m.pushText(&t, ": assertion '")
    m.pushText(&t, expression)
    m.pushText(&t, "' failed")
    messages.log(m.literal("GLib-GIO"), messages.LEVEL_CRITICAL, t.address)
    m.dispose(&t)
}

pub fn proxyGType() -> usize {
    if threads.onceEnter(@intFromPtr(&proxyOnce)) {
        types.ensureInit()
        proxyType = ioerrors.defineType(types.T_OBJECT, "GDBusProxy", 408, @intFromPtr(__mlx_glib_dbus_proxy_class_init), 32, @intFromPtr(__mlx_glib_dbus_proxy_init), 0)
        threads.onceLeave(@intFromPtr(&proxyOnce), 1)
    }
    return proxyType
}

export fn g_dbus_proxy_get_type() -> usize { return proxyGType() }

fn isProxy(proxy: usize) -> bool { return proxy != 0 && g_type_check_instance_is_a(proxy, proxyGType()) != 0 }

fn checkProxy(proxy: usize, function: []const u8) -> bool {
    if isProxy(proxy) { return true }
    critical(function, "G_IS_DBUS_PROXY (proxy)")
    return false
}

export fn __mlx_glib_dbus_proxy_init(proxy: usize, class: usize) -> void {
    const r = m.alloc(X_SIZE)
    m.putI32(r + X_TIMEOUT, -1)
    m.putWord(proxy + 24, r)
}

fn unsubscribeAll(r: usize) -> void {
    const conn = m.getWord(r + X_CONNECTION)
    if conn == 0 { return }
    var at = X_SUB_PROPERTIES
    while at <= X_SUB_OWNER {
        if m.get32(r + at) != 0 { g_dbus_connection_signal_unsubscribe(conn, m.get32(r + at)) }
        m.put32(r + at, 0)
        at += 4
    }
}

fn clearCache(r: usize) -> void {
    const cache = wordsAt(r + X_CACHE)
    var i: usize = 0
    while i < cache.*.length {
        const entry = m.wordAt(cache, i)
        m.release(m.getWord(entry))
        variant.unref(m.getWord(entry + 8))
        m.release(entry)
        i += 1
    }
    cache.*.length = 0
}

export fn __mlx_glib_dbus_proxy_dispose(proxy: usize) -> void {
    unsubscribeAll(rec(proxy))
    ioerrors.chainUp(types.T_OBJECT, 40, proxy)
}

export fn __mlx_glib_dbus_proxy_finalize(proxy: usize) -> void {
    const r = rec(proxy)
    unsubscribeAll(r)
    clearCache(r)
    m.disposeWords(wordsAt(r + X_CACHE))
    if m.getWord(r + X_CONNECTION) != 0 { g_object_unref(m.getWord(r + X_CONNECTION)) }
    if m.getWord(r + X_INFO) != 0 { introspection.interfaceUnref(m.getWord(r + X_INFO)) }
    m.release(m.getWord(r + X_NAME))
    m.release(m.getWord(r + X_OWNER))
    m.release(m.getWord(r + X_PATH))
    m.release(m.getWord(r + X_INTERFACE))
    if m.getWord(r + X_CONTEXT) != 0 { g_main_context_unref(m.getWord(r + X_CONTEXT)) }
    m.release(r)
    ioerrors.chainUp(types.T_OBJECT, 48, proxy)
}

export fn __mlx_glib_dbus_proxy_set_property(proxy: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_DEFAULT_TIMEOUT { m.putI32(rec(proxy) + X_TIMEOUT, g_value_get_int(value)) }
}

export fn __mlx_glib_dbus_proxy_get_property(proxy: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = rec(proxy)
    if id == PROP_CONNECTION { g_value_set_object(value, m.getWord(r + X_CONNECTION)) }
    if id == PROP_NAME { g_value_set_string(value, m.getWord(r + X_NAME)) }
    if id == PROP_NAME_OWNER {
        threads.lock(r + X_LOCK)
        g_value_set_string(value, m.getWord(r + X_OWNER))
        threads.unlock(r + X_LOCK)
    }
    if id == PROP_OBJECT_PATH { g_value_set_string(value, m.getWord(r + X_PATH)) }
    if id == PROP_INTERFACE_NAME { g_value_set_string(value, m.getWord(r + X_INTERFACE)) }
    if id == PROP_DEFAULT_TIMEOUT { g_value_set_int(value, m.getI32(r + X_TIMEOUT)) }
}

export fn __mlx_glib_dbus_proxy_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_glib_dbus_proxy_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_dbus_proxy_get_property))
    m.putWord(class + 40, @intFromPtr(__mlx_glib_dbus_proxy_dispose))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_dbus_proxy_finalize))
    const readable: i32 = 1 | 224
    g_object_class_install_property(class, PROP_CONNECTION, g_param_spec_object(m.literal("g-connection"), m.literal("g-connection"), m.literal("The connection the proxy is for"), connection.connectionGType(), readable))
    g_object_class_install_property(class, PROP_NAME, g_param_spec_string(m.literal("g-name"), m.literal("g-name"), m.literal("The well-known or unique name that the proxy is for"), 0, readable))
    g_object_class_install_property(class, PROP_NAME_OWNER, g_param_spec_string(m.literal("g-name-owner"), m.literal("g-name-owner"), m.literal("The unique name for the owner"), 0, readable))
    g_object_class_install_property(class, PROP_OBJECT_PATH, g_param_spec_string(m.literal("g-object-path"), m.literal("g-object-path"), m.literal("The object path the proxy is for"), 0, readable))
    g_object_class_install_property(class, PROP_INTERFACE_NAME, g_param_spec_string(m.literal("g-interface-name"), m.literal("g-interface-name"), m.literal("The D-Bus interface name the proxy is for"), 0, readable))
    g_object_class_install_property(class, PROP_DEFAULT_TIMEOUT, g_param_spec_int(m.literal("g-default-timeout"), m.literal("Default Timeout"), m.literal("Timeout for remote method invocation"), -1, 2147483647, -1, 3 | 4 | 224))
    const changed = m.alloc(16)
    m.putWord(changed, types.T_VARIANT)
    m.putWord(changed + 8, g_strv_get_type())
    propertiesChangedSignal = signals.newSignal(m.literal("g-properties-changed"), m.getWord(class), 2 | 64, closures.typeClosure(m.getWord(class), 136), 0, 0, 0, types.T_NONE, 2, changed)
    m.release(changed)
    const params = m.alloc(24)
    m.putWord(params, types.T_STRING)
    m.putWord(params + 8, types.T_STRING)
    m.putWord(params + 16, types.T_VARIANT)
    signalSignal = signals.newSignal(m.literal("g-signal"), m.getWord(class), 2 | 16 | 64, closures.typeClosure(m.getWord(class), 144), 0, 0, 0, types.T_NONE, 3, params)
    m.release(params)
}

// ---------------------------------------------------------------------------
// Cached properties: words of records of the name (0) and the value (8),
// sorted by name.

fn cacheIndex(r: usize, name: usize, found: *bool) -> usize {
    const cache = wordsAt(r + X_CACHE)
    var i: usize = 0
    while i < cache.*.length {
        const order = m.cCompare(m.getWord(m.wordAt(cache, i)), name)
        if order == 0 {
            found.* = true
            return i
        }
        if order > 0 { break }
        i += 1
    }
    found.* = false
    return i
}

// Sets `name` to `value` (a reference taken here), or removes it.
fn cacheSet(r: usize, name: usize, value: usize) -> void {
    const cache = wordsAt(r + X_CACHE)
    var found = false
    const at = cacheIndex(r, name, &found)
    if found {
        const entry = m.wordAt(cache, at)
        if value != 0 {
            variant.unref(m.getWord(entry + 8))
            m.putWord(entry + 8, variant.ref(value))
            return
        }
        m.release(m.getWord(entry))
        variant.unref(m.getWord(entry + 8))
        m.release(entry)
        m.copy(cache.*.address + at * 8, cache.*.address + (at + 1) * 8, (cache.*.length - at - 1) * 8)
        cache.*.length -= 1
        return
    }
    if value == 0 { return }
    const entry = m.alloc(16)
    m.putWord(entry, m.dup(name))
    m.putWord(entry + 8, variant.ref(value))
    m.pushWord(cache, 0)
    m.copy(cache.*.address + (at + 1) * 8, cache.*.address + at * 8, (cache.*.length - at - 1) * 8)
    m.putWord(cache.*.address + at * 8, entry)
}

// The entries of an a{sv} into the cache.
fn cacheDictionary(r: usize, dictionary: usize) -> void {
    const n = variant.childCount(dictionary)
    var i: usize = 0
    while i < n {
        const entry = variant.childValue(dictionary, i)
        const key = variant.childValue(entry, 0)
        const boxed = variant.childValue(entry, 1)
        const value = variant.childValue(boxed, 0)
        cacheSet(r, variant.stringOf(key), value)
        variant.unref(value)
        variant.unref(boxed)
        variant.unref(key)
        variant.unref(entry)
        i += 1
    }
}

export fn g_dbus_proxy_get_cached_property(proxy: usize, property_name: usize) -> usize {
    if !checkProxy(proxy, "g_dbus_proxy_get_cached_property") { return 0 }
    const r = rec(proxy)
    threads.lock(r + X_LOCK)
    var found = false
    const at = cacheIndex(r, property_name, &found)
    var value: usize = 0
    if found { value = variant.ref(m.getWord(m.wordAt(wordsAt(r + X_CACHE), at) + 8)) }
    threads.unlock(r + X_LOCK)
    return value
}

export fn g_dbus_proxy_set_cached_property(proxy: usize, property_name: usize, value: usize) -> void {
    if !checkProxy(proxy, "g_dbus_proxy_set_cached_property") { return }
    const r = rec(proxy)
    const held = if value != 0 { variant.refSink(value) } else { 0 }
    threads.lock(r + X_LOCK)
    cacheSet(r, property_name, held)
    threads.unlock(r + X_LOCK)
    variant.unref(held)
}

export fn g_dbus_proxy_get_cached_property_names(proxy: usize) -> usize {
    if !checkProxy(proxy, "g_dbus_proxy_get_cached_property_names") { return 0 }
    const r = rec(proxy)
    threads.lock(r + X_LOCK)
    const cache = wordsAt(r + X_CACHE)
    var result: usize = 0
    if cache.*.length > 0 {
        result = m.alloc((cache.*.length + 1) * 8)
        var i: usize = 0
        while i < cache.*.length {
            m.putWord(result + i * 8, m.dup(m.getWord(m.wordAt(cache, i))))
            i += 1
        }
    }
    threads.unlock(r + X_LOCK)
    return result
}

// ---------------------------------------------------------------------------
// What the proxy watches

fn ownerIs(r: usize, sender: usize) -> bool {
    threads.lock(r + X_LOCK)
    const owner = m.getWord(r + X_OWNER)
    const good = owner == 0 || (sender != 0 && m.cEqual(owner, sender))
    threads.unlock(r + X_LOCK)
    return good
}

export fn __mlx_glib_dbus_proxy_signal(conn: usize, sender: usize, path: usize, interface: usize, member: usize, parameters: usize, proxy: usize) -> void {
    const r = rec(proxy)
    if m.get32(r + X_INITIALIZED) == 0 || !ownerIs(r, sender) { return }
    g_signal_emit(proxy, signalSignal, g_quark_try_string(member), sender, member, parameters)
}

export fn __mlx_glib_dbus_proxy_properties_changed(conn: usize, sender: usize, path: usize, interface: usize, member: usize, parameters: usize, proxy: usize) -> void {
    const r = rec(proxy)
    if m.get32(r + X_INITIALIZED) == 0 || !ownerIs(r, sender) { return }
    if !m.cIs(variant.typeOf(parameters), "(sa{sv}as)") {
        var t = m.text()
        m.pushText(&t, "Value for PropertiesChanged signal with type '")
        m.pushC(&t, variant.typeOf(parameters))
        m.pushText(&t, "' does not match '(sa{sv}as)'")
        m.pushByte(&t, 0)
        messages.log(m.literal("GLib-GIO"), messages.LEVEL_WARNING, t.address)
        m.dispose(&t)
        return
    }
    const name = variant.childValue(parameters, 0)
    const same = m.cEqual(variant.stringOf(name), m.getWord(r + X_INTERFACE))
    variant.unref(name)
    if !same { return }
    const changed = variant.childValue(parameters, 1)
    const invalidated = variant.childValue(parameters, 2)
    threads.lock(r + X_LOCK)
    cacheDictionary(r, changed)
    const n = variant.childCount(invalidated)
    const strv = m.alloc((n + 1) * 8)
    var i: usize = 0
    while i < n {
        const item = variant.childValue(invalidated, i)
        cacheSet(r, variant.stringOf(item), 0)
        m.putWord(strv + i * 8, m.dup(variant.stringOf(item)))
        variant.unref(item)
        i += 1
    }
    threads.unlock(r + X_LOCK)
    g_signal_emit(proxy, propertiesChangedSignal, 0, changed, strv, 0)
    i = 0
    while i < n {
        m.release(m.getWord(strv + i * 8))
        i += 1
    }
    m.release(strv)
    variant.unref(invalidated)
    variant.unref(changed)
}

// GetAll's reply after the name got an owner.
export fn __mlx_glib_dbus_proxy_reloaded(source: usize, res: usize, proxy: usize) -> void {
    const result = g_dbus_connection_call_finish(source, res, 0)
    if result != 0 {
        const r = rec(proxy)
        const dictionary = variant.childValue(result, 0)
        threads.lock(r + X_LOCK)
        cacheDictionary(r, dictionary)
        threads.unlock(r + X_LOCK)
        const none = m.alloc(8)
        g_signal_emit(proxy, propertiesChangedSignal, 0, dictionary, none, 0)
        m.release(none)
        variant.unref(dictionary)
        variant.unref(result)
    }
    g_object_notify(proxy, m.literal("g-name-owner"))
    g_object_unref(proxy)
}

export fn __mlx_glib_dbus_proxy_owner_changed(conn: usize, sender: usize, path: usize, interface: usize, member: usize, parameters: usize, proxy: usize) -> void {
    const r = rec(proxy)
    if !m.cIs(variant.typeOf(parameters), "(sss)") { return }
    const nameValue = variant.childValue(parameters, 0)
    const newValue = variant.childValue(parameters, 2)
    const same = m.cEqual(variant.stringOf(nameValue), m.getWord(r + X_NAME))
    const newOwner = variant.stringOf(newValue)
    if same {
        if m.get8(newOwner) == 0 {
            threads.lock(r + X_LOCK)
            m.release(m.getWord(r + X_OWNER))
            m.putWord(r + X_OWNER, 0)
            const cache = wordsAt(r + X_CACHE)
            const n = cache.*.length
            const strv = m.alloc((n + 1) * 8)
            var i: usize = 0
            while i < n {
                m.putWord(strv + i * 8, m.dup(m.getWord(m.wordAt(cache, i))))
                i += 1
            }
            clearCache(r)
            threads.unlock(r + X_LOCK)
            if n > 0 {
                const empty = variant.refSink(variant.newArray(m.literal("{sv}"), 0, 0))
                g_signal_emit(proxy, propertiesChangedSignal, 0, empty, strv, 0)
                variant.unref(empty)
            }
            i = 0
            while i < n {
                m.release(m.getWord(strv + i * 8))
                i += 1
            }
            m.release(strv)
            g_object_notify(proxy, m.literal("g-name-owner"))
        } else {
            threads.lock(r + X_LOCK)
            m.release(m.getWord(r + X_OWNER))
            m.putWord(r + X_OWNER, m.dup(newOwner))
            threads.unlock(r + X_LOCK)
            if (m.get32(r + X_FLAGS) & DO_NOT_LOAD_PROPERTIES) == 0 {
                const args = m.alloc(8)
                m.putWord(args, variant.newString(m.getWord(r + X_INTERFACE)))
                const body = variant.newTuple(args, 1)
                m.release(args)
                g_dbus_connection_call(m.getWord(r + X_CONNECTION), newOwner, m.getWord(r + X_PATH), m.literal("org.freedesktop.DBus.Properties"), m.literal("GetAll"), body, m.literal("(a{sv})"), 0, -1, 0, @intFromPtr(__mlx_glib_dbus_proxy_reloaded), g_object_ref(proxy))
            } else {
                g_object_notify(proxy, m.literal("g-name-owner"))
            }
        }
    }
    variant.unref(newValue)
    variant.unref(nameValue)
}

// GIO's async_initable_init_first: the subscriptions, delivered in the
// context the proxy was made in.
fn initFirst(proxy: usize) -> void {
    const r = rec(proxy)
    const conn = m.getWord(r + X_CONNECTION)
    const flags = m.get32(r + X_FLAGS)
    const signalFlags: i32 = if (flags & NO_MATCH_RULE) != 0 { 1 } else { 0 }
    const name = m.getWord(r + X_NAME)
    const context = m.getWord(r + X_CONTEXT)
    if (flags & DO_NOT_LOAD_PROPERTIES) == 0 {
        m.put32(r + X_SUB_PROPERTIES, connection.subscribeIn(conn, name, m.literal("org.freedesktop.DBus.Properties"), m.literal("PropertiesChanged"), m.getWord(r + X_PATH), m.getWord(r + X_INTERFACE), signalFlags, @intFromPtr(__mlx_glib_dbus_proxy_properties_changed), proxy, 0, context))
    }
    if (flags & DO_NOT_CONNECT_SIGNALS) == 0 {
        m.put32(r + X_SUB_SIGNALS, connection.subscribeIn(conn, name, m.getWord(r + X_INTERFACE), 0, m.getWord(r + X_PATH), 0, signalFlags, @intFromPtr(__mlx_glib_dbus_proxy_signal), proxy, 0, context))
    }
    if name != 0 && (@bitCast(u32, g_dbus_connection_get_flags(conn)) & 8) != 0 {
        const bus = m.literal("org.freedesktop.DBus")
        m.put32(r + X_SUB_OWNER, connection.subscribeIn(conn, bus, bus, m.literal("NameOwnerChanged"), m.literal("/org/freedesktop/DBus"), name, signalFlags, @intFromPtr(__mlx_glib_dbus_proxy_owner_changed), proxy, 0, context))
    }
}

fn busCall(r: usize, member: []const u8, args: usize, n: usize, replyType: []const u8, err: usize) -> usize {
    const bus = m.literal("org.freedesktop.DBus")
    const body = variant.newTuple(args, n)
    return g_dbus_connection_call_sync(m.getWord(r + X_CONNECTION), bus, m.literal("/org/freedesktop/DBus"), bus, m.literal(member), body, m.literal(replyType), 0, -1, 0, err)
}

// GIO's StartServiceByName step: false (with `err` set) when it failed in
// a way that is not "there is no such service".
fn startService(r: usize, err: usize) -> bool {
    const args = m.alloc(16)
    m.putWord(args, variant.newString(m.getWord(r + X_NAME)))
    m.putWord(args + 8, variant.fixedValue("u", 0, 4))
    const cell = m.alloc(8)
    const result = busCall(r, "StartServiceByName", args, 2, "(u)", cell)
    m.release(args)
    if result == 0 {
        const e = m.getWord(cell)
        m.release(cell)
        if errors.matches(e, errors.quarkLiteral("g-dbus-error-quark"), 2) {
            errors.freeError(e)
            return true
        }
        const remote = g_dbus_error_get_remote_error(e)
        const masked = remote != 0 && m.cIs(remote, "org.freedesktop.systemd1.Masked")
        m.release(remote)
        if masked {
            errors.freeError(e)
            return true
        }
        _ = g_dbus_error_strip_remote_error(e)
        var t = m.text()
        m.pushText(&t, "Error calling StartServiceByName for ")
        m.pushC(&t, m.getWord(r + X_NAME))
        m.pushByte(&t, 0)
        names.prefixError(e, t.address)
        m.dispose(&t)
        errors.report(err, e)
        return false
    }
    m.release(cell)
    const child = variant.childValue(result, 0)
    const reply = variant.read32(child)
    variant.unref(child)
    variant.unref(result)
    if reply == 1 || reply == 2 { return true }
    var t = m.text()
    m.pushText(&t, "Unexpected reply ")
    m.pushDecimal(&t, @intCast(u64, reply))
    m.pushText(&t, " from StartServiceByName(\"")
    m.pushC(&t, m.getWord(r + X_NAME))
    m.pushText(&t, "\") method")
    ioerrors.setText(err, ioerrors.FAILED, &t)
    return false
}

// GIO's async_initable_init_second, done with blocking calls (in the
// caller's thread, or a thread of its own for the asynchronous forms).
fn initSecond(proxy: usize, err: usize) -> bool {
    const r = rec(proxy)
    const flags = m.get32(r + X_FLAGS)
    const name = m.getWord(r + X_NAME)
    if name != 0 && names.isUniqueName(name) {
        m.putWord(r + X_OWNER, m.dup(name))
    } else if name != 0 {
        if (flags & (DO_NOT_AUTO_START | DO_NOT_AUTO_START_AT_CONSTRUCTION)) == 0 {
            if !startService(r, err) { return false }
        }
        const args = m.alloc(8)
        m.putWord(args, variant.newString(name))
        const cell = m.alloc(8)
        const result = busCall(r, "GetNameOwner", args, 1, "(s)", cell)
        m.release(args)
        if result == 0 {
            const e = m.getWord(cell)
            m.release(cell)
            if !errors.matches(e, errors.quarkLiteral("g-dbus-error-quark"), 3) {
                errors.report(err, e)
                return false
            }
            errors.freeError(e)
        } else {
            m.release(cell)
            const child = variant.childValue(result, 0)
            threads.lock(r + X_LOCK)
            m.putWord(r + X_OWNER, m.dup(variant.stringOf(child)))
            threads.unlock(r + X_LOCK)
            variant.unref(child)
            variant.unref(result)
        }
    }
    const owner = m.getWord(r + X_OWNER)
    if (flags & DO_NOT_LOAD_PROPERTIES) == 0 && (owner != 0 || name == 0) {
        const args = m.alloc(8)
        m.putWord(args, variant.newString(m.getWord(r + X_INTERFACE)))
        const body = variant.newTuple(args, 1)
        m.release(args)
        const result = g_dbus_connection_call_sync(m.getWord(r + X_CONNECTION), owner, m.getWord(r + X_PATH), m.literal("org.freedesktop.DBus.Properties"), m.literal("GetAll"), body, m.literal("(a{sv})"), 0, -1, 0, 0)
        if result != 0 {
            const dictionary = variant.childValue(result, 0)
            threads.lock(r + X_LOCK)
            cacheDictionary(r, dictionary)
            threads.unlock(r + X_LOCK)
            variant.unref(dictionary)
            variant.unref(result)
        }
    }
    m.put32(r + X_INITIALIZED, 1)
    return true
}

fn newProxy(conn: usize, flags: i32, info: usize, name: usize, object_path: usize, interface_name: usize) -> usize {
    const proxy = g_object_new(proxyGType(), 0)
    const r = rec(proxy)
    if conn != 0 { m.putWord(r + X_CONNECTION, g_object_ref(conn)) }
    m.put32(r + X_FLAGS, @bitCast(u32, flags))
    m.putWord(r + X_NAME, dupOrNull(name))
    m.putWord(r + X_PATH, m.dup(object_path))
    m.putWord(r + X_INTERFACE, m.dup(interface_name))
    if info != 0 { m.putWord(r + X_INFO, introspection.interfaceRef(info)) }
    m.putWord(r + X_CONTEXT, g_main_context_ref_thread_default())
    return proxy
}

fn checkNew(function: []const u8, conn: usize, needConnection: bool, flags: i32, name: usize, object_path: usize, interface_name: usize) -> bool {
    if needConnection && !connection.isConnection(conn) {
        critical(function, "G_IS_DBUS_CONNECTION (connection)")
        return false
    }
    if name != 0 && !names.isName(name) {
        critical(function, "(name == NULL && g_dbus_connection_get_unique_name (connection) == NULL) || g_dbus_is_name (name)")
        return false
    }
    if object_path == 0 || !variant.isObjectPath(object_path) {
        critical(function, "g_variant_is_object_path (object_path)")
        return false
    }
    if interface_name == 0 || !names.isInterfaceName(interface_name) {
        critical(function, "g_dbus_is_interface_name (interface_name)")
        return false
    }
    return true
}

export fn g_dbus_proxy_new_sync(conn: usize, flags: i32, info: usize, name: usize, object_path: usize, interface_name: usize, c: usize, err: usize) -> usize {
    if !checkNew("g_dbus_proxy_new_sync", conn, true, flags, name, object_path, interface_name) { return 0 }
    if cancellable.setErrorIfCancelled(c, err) { return 0 }
    const proxy = newProxy(conn, flags, info, name, object_path, interface_name)
    initFirst(proxy)
    if !initSecond(proxy, err) {
        g_object_unref(proxy)
        return 0
    }
    return proxy
}

// The second part of the initialization in a thread (with the bus got
// first for a proxy made for one).
export fn __mlx_glib_dbus_proxy_init_thread(task: usize, proxy: usize, data: usize, c: usize) -> void {
    const r = rec(proxy)
    const cell = m.alloc(8)
    var ok = true
    if m.getWord(r + X_CONNECTION) == 0 {
        const conn = connection.busFor(m.getI32(r + X_BUS), c, cell)
        if conn == 0 {
            ok = false
        } else {
            m.putWord(r + X_CONNECTION, conn)
            initFirst(proxy)
        }
    }
    if ok && cancellable.setErrorIfCancelled(c, cell) { ok = false }
    if ok { ok = initSecond(proxy, cell) }
    if ok {
        g_task_return_boolean(task, 1)
    } else {
        g_task_return_error(task, m.getWord(cell))
    }
    m.release(cell)
}

fn initAsync(proxy: usize, c: usize, callback: usize, user_data: usize) -> void {
    const task = g_task_new(proxy, c, callback, user_data)
    g_task_set_source_tag(task, @intFromPtr(&newTag))
    g_task_run_in_thread(task, @intFromPtr(__mlx_glib_dbus_proxy_init_thread))
    g_object_unref(task)
    g_object_unref(proxy)
}

export fn g_dbus_proxy_new(conn: usize, flags: i32, info: usize, name: usize, object_path: usize, interface_name: usize, c: usize, callback: usize, user_data: usize) -> void {
    if !checkNew("g_dbus_proxy_new", conn, true, flags, name, object_path, interface_name) { return }
    const proxy = newProxy(conn, flags, info, name, object_path, interface_name)
    initFirst(proxy)
    initAsync(proxy, c, callback, user_data)
}

fn newFinish(res: usize, err: usize) -> usize {
    const proxy = g_task_get_source_object(res)
    if g_task_propagate_boolean(res, err) == 0 { return 0 }
    return g_object_ref(proxy)
}

export fn g_dbus_proxy_new_finish(res: usize, err: usize) -> usize { return newFinish(res, err) }

export fn g_dbus_proxy_new_for_bus(bus_type: i32, flags: i32, info: usize, name: usize, object_path: usize, interface_name: usize, c: usize, callback: usize, user_data: usize) -> void {
    if !checkNew("g_dbus_proxy_new_for_bus", 0, false, flags, name, object_path, interface_name) { return }
    const proxy = newProxy(0, flags, info, name, object_path, interface_name)
    m.putI32(rec(proxy) + X_BUS, bus_type)
    initAsync(proxy, c, callback, user_data)
}

export fn g_dbus_proxy_new_for_bus_finish(res: usize, err: usize) -> usize { return newFinish(res, err) }

export fn g_dbus_proxy_new_for_bus_sync(bus_type: i32, flags: i32, info: usize, name: usize, object_path: usize, interface_name: usize, c: usize, err: usize) -> usize {
    if !checkNew("g_dbus_proxy_new_for_bus_sync", 0, false, flags, name, object_path, interface_name) { return 0 }
    if cancellable.setErrorIfCancelled(c, err) { return 0 }
    const conn = connection.busFor(bus_type, c, err)
    if conn == 0 { return 0 }
    const proxy = newProxy(conn, flags, info, name, object_path, interface_name)
    g_object_unref(conn)
    initFirst(proxy)
    if !initSecond(proxy, err) {
        g_object_unref(proxy)
        return 0
    }
    return proxy
}

// ---------------------------------------------------------------------------
// Getters

export fn g_dbus_proxy_get_connection(proxy: usize) -> usize {
    if !checkProxy(proxy, "g_dbus_proxy_get_connection") { return 0 }
    return m.getWord(rec(proxy) + X_CONNECTION)
}

export fn g_dbus_proxy_get_flags(proxy: usize) -> i32 {
    if !checkProxy(proxy, "g_dbus_proxy_get_flags") { return 0 }
    return @bitCast(i32, m.get32(rec(proxy) + X_FLAGS))
}

export fn g_dbus_proxy_get_name(proxy: usize) -> usize {
    if !checkProxy(proxy, "g_dbus_proxy_get_name") { return 0 }
    return m.getWord(rec(proxy) + X_NAME)
}

export fn g_dbus_proxy_get_name_owner(proxy: usize) -> usize {
    if !checkProxy(proxy, "g_dbus_proxy_get_name_owner") { return 0 }
    const r = rec(proxy)
    threads.lock(r + X_LOCK)
    const owner = dupOrNull(m.getWord(r + X_OWNER))
    threads.unlock(r + X_LOCK)
    return owner
}

export fn g_dbus_proxy_get_object_path(proxy: usize) -> usize {
    if !checkProxy(proxy, "g_dbus_proxy_get_object_path") { return 0 }
    return m.getWord(rec(proxy) + X_PATH)
}

export fn g_dbus_proxy_get_interface_name(proxy: usize) -> usize {
    if !checkProxy(proxy, "g_dbus_proxy_get_interface_name") { return 0 }
    return m.getWord(rec(proxy) + X_INTERFACE)
}

export fn g_dbus_proxy_get_default_timeout(proxy: usize) -> i32 {
    if !checkProxy(proxy, "g_dbus_proxy_get_default_timeout") { return -1 }
    return m.getI32(rec(proxy) + X_TIMEOUT)
}

export fn g_dbus_proxy_set_default_timeout(proxy: usize, timeout_msec: i32) -> void {
    if !checkProxy(proxy, "g_dbus_proxy_set_default_timeout") { return }
    m.putI32(rec(proxy) + X_TIMEOUT, timeout_msec)
}

export fn g_dbus_proxy_get_interface_info(proxy: usize) -> usize {
    if !checkProxy(proxy, "g_dbus_proxy_get_interface_info") { return 0 }
    return m.getWord(rec(proxy) + X_INFO)
}

export fn g_dbus_proxy_set_interface_info(proxy: usize, info: usize) -> void {
    if !checkProxy(proxy, "g_dbus_proxy_set_interface_info") { return }
    const r = rec(proxy)
    if m.getWord(r + X_INFO) != 0 { introspection.interfaceUnref(m.getWord(r + X_INFO)) }
    m.putWord(r + X_INFO, if info != 0 { introspection.interfaceRef(info) } else { 0 })
}

// ---------------------------------------------------------------------------
// Calls

// What a call goes to: its interface (a new string), its method (in
// `method_name`), its destination (a new string, or 0 for none) and the
// reply type the interface info gives (a new string, or 0). False when
// there is no one to call.
const T_INTERFACE: usize = 0
const T_METHOD: usize = 8
const T_DESTINATION: usize = 16
const T_REPLY: usize = 24
const T_SIZE: usize = 32

fn freeTarget(t: usize) -> void {
    m.release(m.getWord(t + T_INTERFACE))
    m.release(m.getWord(t + T_METHOD))
    m.release(m.getWord(t + T_DESTINATION))
    m.release(m.getWord(t + T_REPLY))
    m.release(t)
}

fn targetOf(proxy: usize, method_name: usize, err: usize) -> usize {
    const r = rec(proxy)
    const t = m.alloc(T_SIZE)
    // "Interface.Method": the interface of the call's own.
    var dot: usize = 0
    var p = method_name
    while m.get8(p) != 0 {
        if m.get8(p) == '.' { dot = p }
        p += 1
    }
    if dot != 0 {
        m.putWord(t + T_INTERFACE, m.dupBytes(method_name, dot - method_name))
        m.putWord(t + T_METHOD, m.dup(dot + 1))
    } else {
        m.putWord(t + T_INTERFACE, m.dup(m.getWord(r + X_INTERFACE)))
        m.putWord(t + T_METHOD, m.dup(method_name))
        const info = m.getWord(r + X_INFO)
        if info != 0 {
            const method = introspection.lookup(m.getWord(info + 16), method_name)
            if method != 0 {
                var s = m.text()
                m.pushByte(&s, '(')
                var a = m.getWord(method + 24)
                while a != 0 && m.getWord(a) != 0 {
                    m.pushC(&s, m.getWord(m.getWord(a) + 16))
                    a += 8
                }
                m.pushByte(&s, ')')
                m.putWord(t + T_REPLY, m.finish(&s))
            }
        }
    }
    const name = m.getWord(r + X_NAME)
    if name != 0 {
        threads.lock(r + X_LOCK)
        var destination = m.getWord(r + X_OWNER)
        if destination == 0 && (m.get32(r + X_FLAGS) & DO_NOT_AUTO_START) == 0 { destination = name }
        m.putWord(t + T_DESTINATION, dupOrNull(destination))
        threads.unlock(r + X_LOCK)
        if destination == 0 {
            var e = m.text()
            m.pushText(&e, "Cannot invoke method; proxy is for the well-known name ")
            m.pushC(&e, name)
            m.pushText(&e, " without an owner, and proxy was constructed with the G_DBUS_PROXY_FLAGS_DO_NOT_AUTO_START flag")
            ioerrors.setText(err, ioerrors.FAILED, &e)
            freeTarget(t)
            return 0
        }
    }
    return t
}

fn checkCall(function: []const u8, proxy: usize, method_name: usize, parameters: usize, timeout_msec: i32) -> bool {
    if !checkProxy(proxy, function) { return false }
    if method_name == 0 || !(names.isMemberName(method_name) || names.isInterfaceName(method_name)) {
        critical(function, "g_dbus_is_member_name (method_name) || g_dbus_is_interface_name (method_name)")
        return false
    }
    if parameters != 0 && m.get8(variant.typeOf(parameters)) != '(' {
        critical(function, "parameters == NULL || g_variant_is_of_type (parameters, G_VARIANT_TYPE_TUPLE)")
        return false
    }
    if timeout_msec < -1 {
        critical(function, "timeout_msec == -1 || timeout_msec >= 0")
        return false
    }
    return true
}

// A reply for the proxy's task: the value (0) and descriptor list (8).
fn freeReply(data: usize) -> void {
    variant.unref(m.getWord(data))
    if m.getWord(data + 8) != 0 { g_object_unref(m.getWord(data + 8)) }
    m.release(data)
}

export fn __mlx_glib_dbus_proxy_reply_free(data: usize) -> void { freeReply(data) }

export fn __mlx_glib_dbus_proxy_reply(source: usize, res: usize, task: usize) -> void {
    const cell = m.alloc(16)
    const value = g_dbus_connection_call_with_unix_fd_list_finish(source, cell + 8, res, cell)
    if value == 0 {
        g_task_return_error(task, m.getWord(cell))
    } else {
        const data = m.alloc(16)
        m.putWord(data, value)
        m.putWord(data + 8, m.getWord(cell + 8))
        g_task_return_pointer(task, data, @intFromPtr(__mlx_glib_dbus_proxy_reply_free))
    }
    m.release(cell)
    g_object_unref(task)
}

fn callAsync(proxy: usize, method_name: usize, parameters: usize, flags: i32, timeout_msec: i32, fd_list: usize, c: usize, callback: usize, user_data: usize) -> void {
    if !checkCall("g_dbus_proxy_call_internal", proxy, method_name, parameters, timeout_msec) { return }
    const r = rec(proxy)
    var task: usize = 0
    if callback != 0 {
        task = g_task_new(proxy, c, callback, user_data)
        g_task_set_source_tag(task, @intFromPtr(&callTag))
    }
    const cell = m.alloc(8)
    const t = targetOf(proxy, method_name, cell)
    if t == 0 {
        if task != 0 {
            g_task_return_error(task, m.getWord(cell))
            g_object_unref(task)
        } else {
            errors.freeError(m.getWord(cell))
        }
        m.release(cell)
        if parameters != 0 { variant.unref(variant.refSink(parameters)) }
        return
    }
    m.release(cell)
    const timeout = if timeout_msec == -1 { m.getI32(r + X_TIMEOUT) } else { timeout_msec }
    g_dbus_connection_call_with_unix_fd_list(m.getWord(r + X_CONNECTION), m.getWord(t + T_DESTINATION), m.getWord(r + X_PATH), m.getWord(t + T_INTERFACE), m.getWord(t + T_METHOD), parameters, m.getWord(t + T_REPLY), flags, timeout, fd_list, c, if task != 0 { @intFromPtr(__mlx_glib_dbus_proxy_reply) } else { 0 }, task)
    freeTarget(t)
}

fn callFinish(proxy: usize, fdOut: usize, res: usize, err: usize) -> usize {
    const data = g_task_propagate_pointer(res, err)
    if data == 0 { return 0 }
    const value = variant.ref(m.getWord(data))
    if fdOut != 0 { m.putWord(fdOut, if m.getWord(data + 8) != 0 { g_object_ref(m.getWord(data + 8)) } else { 0 }) }
    freeReply(data)
    return value
}

fn callSync(proxy: usize, method_name: usize, parameters: usize, flags: i32, timeout_msec: i32, fd_list: usize, fdOut: usize, c: usize, err: usize) -> usize {
    if !checkCall("g_dbus_proxy_call_sync_internal", proxy, method_name, parameters, timeout_msec) { return 0 }
    const r = rec(proxy)
    const t = targetOf(proxy, method_name, err)
    if t == 0 {
        if parameters != 0 { variant.unref(variant.refSink(parameters)) }
        return 0
    }
    const timeout = if timeout_msec == -1 { m.getI32(r + X_TIMEOUT) } else { timeout_msec }
    const value = g_dbus_connection_call_with_unix_fd_list_sync(m.getWord(r + X_CONNECTION), m.getWord(t + T_DESTINATION), m.getWord(r + X_PATH), m.getWord(t + T_INTERFACE), m.getWord(t + T_METHOD), parameters, m.getWord(t + T_REPLY), flags, timeout, fd_list, fdOut, c, err)
    freeTarget(t)
    return value
}

export fn g_dbus_proxy_call(proxy: usize, method_name: usize, parameters: usize, flags: i32, timeout_msec: i32, c: usize, callback: usize, user_data: usize) -> void { callAsync(proxy, method_name, parameters, flags, timeout_msec, 0, c, callback, user_data) }

export fn g_dbus_proxy_call_finish(proxy: usize, res: usize, err: usize) -> usize { return callFinish(proxy, 0, res, err) }

export fn g_dbus_proxy_call_sync(proxy: usize, method_name: usize, parameters: usize, flags: i32, timeout_msec: i32, c: usize, err: usize) -> usize { return callSync(proxy, method_name, parameters, flags, timeout_msec, 0, 0, c, err) }

export fn g_dbus_proxy_call_with_unix_fd_list(proxy: usize, method_name: usize, parameters: usize, flags: i32, timeout_msec: i32, fd_list: usize, c: usize, callback: usize, user_data: usize) -> void { callAsync(proxy, method_name, parameters, flags, timeout_msec, fd_list, c, callback, user_data) }

export fn g_dbus_proxy_call_with_unix_fd_list_finish(proxy: usize, out_fd_list: usize, res: usize, err: usize) -> usize { return callFinish(proxy, out_fd_list, res, err) }

export fn g_dbus_proxy_call_with_unix_fd_list_sync(proxy: usize, method_name: usize, parameters: usize, flags: i32, timeout_msec: i32, fd_list: usize, out_fd_list: usize, c: usize, err: usize) -> usize { return callSync(proxy, method_name, parameters, flags, timeout_msec, fd_list, out_fd_list, c, err) }
