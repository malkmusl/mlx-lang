// GInitable (ginitable.h) and GIO's TLS types (gtlscertificate.h,
// gtlsbackend.h, gtlsdatabase.h, gtlsfiledatabase.h, gtlsinteraction.h,
// gtlspassword.h): certificates, the backend, databases; the connections
// themselves are tlsconnection.mlx's.
//
// GIO leaves TLS to a backend module (glib-networking); the backend here
// is the library's own, on std.x509 and std.tls (no GnuTLS): its
// certificates are real objects (the DER and PEM forms, both ways; the
// issuer chain; a private key or its PKCS #11 URI; compared by their
// DER), made with g_initable_new or g_tls_certificate_new_from_pem as
// WebKit makes and copies them, with the fields of their X.509 structure
// (not-valid-before and -after, subject-name and issuer-name as GnuTLS
// prints them, dns-names, ip-addresses), verified as GnuTLS verifies
// them (g_tls_certificate_verify, g_tls_database_verify_chain: the chain
// up to an anchor, signatures, validity, the identity by RFC 6125). The
// default database is the system's CA bundle
// (/etc/ssl/certs/ca-certificates.crt), read when first needed; a file
// database reads its anchors when made. A chain of certificates from PEM
// is linked by the names of their issuers and subjects, not by checking
// their signatures. GTlsInteraction is a type only. GTlsPassword is
// whole: its value, flags, description and warning (GIO's default
// warnings by the flags).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const types = @import("./types.mlx")
const ioerrors = @import("./ioerrors.mlx")
const varargs = @import("./varargs.mlx")
const std = @import("std")
const x509 = @import("std.x509")

