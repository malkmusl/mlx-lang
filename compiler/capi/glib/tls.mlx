// GTlsError and GTlsCertificateFlags.
const TLS_ERROR_UNAVAILABLE: i32 = 0
const TLS_ERROR_BAD_CERTIFICATE: i32 = 2
const CERTIFICATE_UNKNOWN_CA: i32 = 1
const CERTIFICATE_GENERIC_ERROR: i32 = 64

