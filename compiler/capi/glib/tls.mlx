}
export fn g_tls_protocol_version_get_type() -> usize {
    ensureTypes()
    return protocolVersionType
}
export fn g_tls_database_get_type() -> usize {
    ensureTypes()
    return databaseType
}
export fn g_tls_file_database_get_type() -> usize {
    ensureTypes()
    return fileDatabaseType
}
export fn g_tls_interaction_get_type() -> usize {
    ensureTypes()
    return interactionType
}
export fn g_tls_password_get_type() -> usize {
    ensureTypes()
    return passwordType
}

// ---------------------------------------------------------------------------
// GInitable

export fn g_initable_init(initable: usize, cancellable: usize, err: usize) -> i32 {
    ensureTypes()
    if initable == 0 { return 0 }
    const vtable = g_type_interface_peek(m.getWord(initable), initableType)
    if vtable == 0 || m.getWord(vtable + 16) == 0 { return 0 }
    const call: InitFunc = unsafe { @ptrFromInt(InitFunc, m.getWord(vtable + 16)) }
    return call(initable, cancellable, err)
}

export fn g_initable_new_valist(object_type: usize, first_property_name: usize, var_args: usize, cancellable: usize, err: usize) -> usize {
    const object = g_object_new_valist(object_type, first_property_name, var_args)
    if object == 0 { return 0 }
    if g_initable_init(object, cancellable, err) == 0 {
        g_object_unref(object)
        return 0
    }
    return object
}

export fn g_initable_new(object_type: usize, cancellable: usize, err: usize, first_property_name: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ object_type, cancellable, err, first_property_name, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 4, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    return g_initable_new_valist(object_type, first_property_name, list, cancellable, err)
}

// ---------------------------------------------------------------------------
// PEM: Base64 between "-----BEGIN LABEL-----" and "-----END LABEL-----".

// A block found in PEM text: where its label and its Base64 are, and
// where it ends (all offsets into the text; `end` 0 when none was found).
const Block = struct {
    label: usize
    labelLength: usize
    body: usize
    bodyEnd: usize
    start: usize
    end: usize
}

fn startsAt(text: usize, length: usize, at: usize, word: []const u8) -> bool {
    if at + word.length > length { return false }
    var index: usize = 0
    while index < word.length {
        if m.get8(text + at + index) != word[index] { return false }
        index += 1
    }
    return true
}

// The first block at or after `from` whose label `wanted` accepts
// (any label when it is empty; else a label that ends with it, so
// "PRIVATE KEY" takes "RSA PRIVATE KEY" and "EC PRIVATE KEY" too).
fn findBlock(text: usize, length: usize, from: usize, wanted: []const u8) -> Block {
    const none = Block.{ .label = 0, .labelLength = 0, .body = 0, .bodyEnd = 0, .start = 0, .end = 0 }
    var at = from
    while at < length {
        if !startsAt(text, length, at, "-----BEGIN ") {
            at += 1
            continue
        }
        const label = at + 11
        var labelEnd = label
        while labelEnd < length && !startsAt(text, length, labelEnd, "-----") && m.get8(text + labelEnd) != 10 { labelEnd += 1 }
        if !startsAt(text, length, labelEnd, "-----") {
            at = labelEnd
            continue
        }
        const labelLength = labelEnd - label
        var accepted = wanted.length == 0
        if !accepted && labelLength >= wanted.length {
            accepted = startsAt(text, length, labelEnd - wanted.length, wanted)
            // (Not "ENCRYPTED PRIVATE KEY": GIO refuses encrypted keys.)
            if accepted && labelLength >= 10 && startsAt(text, length, label, "ENCRYPTED ") { accepted = false }
        }
        const body = labelEnd + 5
        var close = body
        while close < length && !startsAt(text, length, close, "-----END ") { close += 1 }
        if close >= length { return none }
        const closeLabel = close + 9
        var same = startsAt(text, length, closeLabel + labelLength, "-----")
        var index: usize = 0
        while same && index < labelLength {
            if m.get8(text + closeLabel + index) != m.get8(text + label + index) { same = false }
            index += 1
        }
        if !same { return none }
        var end = closeLabel + labelLength + 5
        if end < length && m.get8(text + end) == 13 { end += 1 }
        if end < length && m.get8(text + end) == 10 { end += 1 }
        if accepted { return Block.{ .label = label, .labelLength = labelLength, .body = body, .bodyEnd = close, .start = at, .end = end } }
        at = end
    }
    return none
}

// The bytes the Base64 of a block decodes to (C memory; their length at
// `length`), 0 when there are none.
fn decodeBlock(text: usize, block: Block, length: usize) -> usize {
    var t = m.text()
    var at = block.body
    while at < block.bodyEnd {
        const byte = m.get8(text + at)
        if byte != 10 && byte != 13 && byte != 32 && byte != 9 { m.pushByte(&t, byte) }
        at += 1
    }
    m.pushByte(&t, 0)
    const encoded = m.finish(&t)
    const decoded = g_base64_decode(encoded, length)
    m.release(encoded)
    if m.getWord(length) == 0 {
        m.release(decoded)
        return 0
    }
    return decoded
}

// `der` (`length` bytes) as PEM with LABEL: lines of 64 characters.
fn encodePem(der: usize, length: usize, label: []const u8) -> usize {
    const encoded = g_base64_encode(der, length)
    var t = m.text()
    m.pushText(&t, "-----BEGIN ")
    m.pushText(&t, label)
    m.pushText(&t, "-----\n")
    const total = m.cLength(encoded)
    var at: usize = 0
    while at < total {
        const line = if total - at > 64 { 64 } else { total - at }
        m.pushBytes(&t, encoded + at, line)
        m.pushByte(&t, 10)
        at += line
    }
    m.pushText(&t, "-----END ")
    m.pushText(&t, label)
    m.pushText(&t, "-----\n")
    m.release(encoded)
    return m.finish(&t)
}

// ---------------------------------------------------------------------------
// DER: what the chain of certificates needs of X.509, the names.

// An element of DER: where it starts, where its content starts, where
// it ends (`end` 0 when there is no well-formed element there).
const Element = struct {
    start: usize
    content: usize
    end: usize
}

fn element(der: usize, length: usize, at: usize) -> Element {
    const bad = Element.{ .start = at, .content = at, .end = 0 }
    if at + 2 > length { return bad }
    var size = @intCast(usize, m.get8(der + at + 1))
    var content = at + 2
    if size >= 128 {
        const count = size - 128
        if count == 0 || count > 4 || content + count > length { return bad }
        size = 0
        var index: usize = 0
        while index < count {
            size = size * 256 + @intCast(usize, m.get8(der + content + index))
            index += 1
        }
        content += count
    }
    if content + size > length { return bad }
    return Element.{ .start = at, .content = content, .end = content + size }
}

// The issuer's Name of a certificate's DER, or its subject's.
fn nameOf(der: usize, length: usize, subject: bool) -> Element {
    const bad = Element.{ .start = 0, .content = 0, .end = 0 }
    const certificate = element(der, length, 0)
    if certificate.end == 0 { return bad }
    const tbs = element(der, length, certificate.content)
    if tbs.end == 0 { return bad }
    var at = tbs.content
    // [0] version, serialNumber, signature, issuer, validity, subject.
    if at < length && m.get8(der + at) == 160 { at = element(der, length, at).end }
    var skip: usize = if subject { 4 } else { 2 }
    while skip > 0 {
        if at == 0 { return bad }
        at = element(der, length, at).end
        skip -= 1
    }
    if at == 0 { return bad }
    return element(der, length, at)
}

// Whether the certificate `der` names `issuer` as its issuer.
fn issuedBy(der: usize, length: usize, issuer: usize, issuerLength: usize) -> bool {
    const named = nameOf(der, length, false)
    const subject = nameOf(issuer, issuerLength, true)
    if named.end == 0 || subject.end == 0 || named.end - named.start != subject.end - subject.start { return false }
    var index: usize = 0
    while index < named.end - named.start {
        if m.get8(der + named.start + index) != m.get8(issuer + subject.start + index) { return false }
        index += 1
    }
    return true
}

// ---------------------------------------------------------------------------
// GTlsCertificate

// The instance: a GObject and its private part (24), here a record of
// the DER (0, its length 8), the private key's DER (16, 24) and PEM (32),
// the issuer (40), the PKCS #11 URIs of the certificate (48) and the key
// (56), and what went wrong reading what construction gave (64: 0, or 1
// when PEM had no certificate, 2 when the key's PEM had no key).
const P_DER: usize = 0
const P_DER_LENGTH: usize = 8
const P_KEY: usize = 16
const P_KEY_LENGTH: usize = 24
const P_KEY_PEM: usize = 32
const P_ISSUER: usize = 40
const P_URI: usize = 48
const P_KEY_URI: usize = 56
const P_PROBLEM: usize = 64
const P_SIZE: usize = 72

// GObjectClass (136), verify, eight words of padding.
const C_CLASS_SIZE: usize = 208
const CLASS_VERIFY: usize = 136

const PROP_CERTIFICATE: u32 = 1
const PROP_CERTIFICATE_PEM: u32 = 2
const PROP_PRIVATE_KEY: u32 = 3
const PROP_PRIVATE_KEY_PEM: u32 = 4
const PROP_ISSUER: u32 = 5
const PROP_PKCS11_URI: u32 = 6
const PROP_PRIVATE_KEY_PKCS11_URI: u32 = 7
const PROP_NOT_VALID_BEFORE: u32 = 8
const PROP_NOT_VALID_AFTER: u32 = 9
const PROP_SUBJECT_NAME: u32 = 10
const PROP_ISSUER_NAME: u32 = 11
const PROP_DNS_NAMES: u32 = 12
const PROP_IP_ADDRESSES: u32 = 13
const PROP_PASSWORD: u32 = 14

fn certPriv(cert: usize) -> usize { return m.getWord(cert + 24) }

export fn __mlx_glib_tls_certificate_init(cert: usize, class: usize) -> void { m.putWord(cert + 24, m.alloc(P_SIZE)) }

export fn __mlx_glib_tls_certificate_finalize(cert: usize) -> void {
    const p = certPriv(cert)
    m.release(m.getWord(p + P_DER))
    m.release(m.getWord(p + P_KEY))
    m.release(m.getWord(p + P_KEY_PEM))
    m.release(m.getWord(p + P_URI))
    m.release(m.getWord(p + P_KEY_URI))
    if m.getWord(p + P_ISSUER) != 0 { g_object_unref(m.getWord(p + P_ISSUER)) }
    m.release(p)
    ioerrors.chainUp(types.T_OBJECT, 48, cert)
}

// Takes `der` (C memory) as the certificate's DER.
fn setDer(p: usize, der: usize, length: usize) -> void {
    m.release(m.getWord(p + P_DER))
    m.putWord(p + P_DER, der)
    m.putWord(p + P_DER_LENGTH, length)
}

fn copyBytes(address: usize, length: usize) -> usize {
    const copy = m.alloc(length)
    m.copy(copy, address, length)
    return copy
}

// The first certificate of PEM text.
fn setCertificatePem(p: usize, pem: usize) -> void {
    const length = m.cLength(pem)
    const block = findBlock(pem, length, 0, "CERTIFICATE")
    var size: usize = 0
    const der = if block.end != 0 { decodeBlock(pem, block, @intFromPtr(&size)) } else { 0 }
    if der == 0 {
        m.putWord(p + P_PROBLEM, 1)
        return
    }
    setDer(p, der, size)
}

// The first private key of PEM text, kept as PEM and as DER.
fn setKeyPem(p: usize, pem: usize) -> void {
    const length = m.cLength(pem)
    const block = findBlock(pem, length, 0, "PRIVATE KEY")
    var size: usize = 0
    const der = if block.end != 0 { decodeBlock(pem, block, @intFromPtr(&size)) } else { 0 }
    if der == 0 {
        m.putWord(p + P_PROBLEM, 2)
        return
    }
    m.release(m.getWord(p + P_KEY))
    m.putWord(p + P_KEY, der)
    m.putWord(p + P_KEY_LENGTH, size)
    m.release(m.getWord(p + P_KEY_PEM))
    m.putWord(p + P_KEY_PEM, m.dupBytes(pem + block.start, block.end - block.start))
}

fn replaceText(p: usize, field: usize, text: usize) -> void {
    m.release(m.getWord(p + field))
    m.putWord(p + field, if text == 0 { 0 } else { m.dup(text) })
}

// A GByteArray's data (0) and length (8, a guint).
fn arrayData(array: usize) -> usize { return m.getWord(array) }
fn arrayLength(array: usize) -> usize { return @intCast(usize, m.get32(array + 8)) }

export fn __mlx_glib_tls_certificate_set_property(cert: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = certPriv(cert)
    // (Construct-only properties not given come with their defaults,
    // NULL: they leave what another property set.)
    if id == PROP_CERTIFICATE {
        const array = g_value_get_boxed(value)
        if array != 0 { setDer(p, copyBytes(arrayData(array), arrayLength(array)), arrayLength(array)) }
    } else if id == PROP_CERTIFICATE_PEM {
        const pem = g_value_get_string(value)
        if pem != 0 { setCertificatePem(p, pem) }
    } else if id == PROP_PRIVATE_KEY {
        const array = g_value_get_boxed(value)
        if array != 0 {
            m.release(m.getWord(p + P_KEY))
            m.putWord(p + P_KEY, copyBytes(arrayData(array), arrayLength(array)))
            m.putWord(p + P_KEY_LENGTH, arrayLength(array))
            m.release(m.getWord(p + P_KEY_PEM))
            m.putWord(p + P_KEY_PEM, encodePem(arrayData(array), arrayLength(array), "PRIVATE KEY"))
        }
    } else if id == PROP_PRIVATE_KEY_PEM {
        const pem = g_value_get_string(value)
        if pem != 0 { setKeyPem(p, pem) }
    } else if id == PROP_ISSUER {
        const issuer = g_value_get_object(value)
        if issuer != 0 {
            if m.getWord(p + P_ISSUER) != 0 { g_object_unref(m.getWord(p + P_ISSUER)) }
            m.putWord(p + P_ISSUER, g_object_ref(issuer))
        }
    } else if id == PROP_PKCS11_URI {
        if g_value_get_string(value) != 0 { replaceText(p, P_URI, g_value_get_string(value)) }
    } else if id == PROP_PRIVATE_KEY_PKCS11_URI {
        if g_value_get_string(value) != 0 { replaceText(p, P_KEY_URI, g_value_get_string(value)) }
    }
    // (The password of a PKCS #12 certificate: there is no PKCS #12 here.)
}

// A new GByteArray of `length` bytes at `data`.
fn byteArrayOf(data: usize, length: usize) -> usize {
    const array = g_byte_array_new()
    _ = g_byte_array_append(array, data, @intCast(u32, length))
    return array
}

export fn __mlx_glib_tls_certificate_get_property(cert: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = certPriv(cert)
    if id == PROP_CERTIFICATE || id == PROP_PRIVATE_KEY {
        const data = m.getWord(p + (if id == PROP_CERTIFICATE { P_DER } else { P_KEY }))
        if data == 0 { return }
        const array = byteArrayOf(data, m.getWord(p + (if id == PROP_CERTIFICATE { P_DER_LENGTH } else { P_KEY_LENGTH })))
        g_value_set_boxed(value, array)
        g_byte_array_unref(array)
    } else if id == PROP_CERTIFICATE_PEM {
        if m.getWord(p + P_DER) == 0 { return }
        const pem = encodePem(m.getWord(p + P_DER), m.getWord(p + P_DER_LENGTH), "CERTIFICATE")
        g_value_set_string(value, pem)
        m.release(pem)
    } else if id == PROP_PRIVATE_KEY_PEM {
        g_value_set_string(value, m.getWord(p + P_KEY_PEM))
    } else if id == PROP_ISSUER {
        g_value_set_object(value, m.getWord(p + P_ISSUER))
    } else if id == PROP_PKCS11_URI {
        g_value_set_string(value, m.getWord(p + P_URI))
    } else if id == PROP_PRIVATE_KEY_PKCS11_URI {
        g_value_set_string(value, m.getWord(p + P_KEY_URI))
    } else if id >= PROP_NOT_VALID_BEFORE && id <= PROP_IP_ADDRESSES {
        x509Property(p, id, value)
    }
}

// The certificate's X.509 structure, parsed over its DER.
fn parsed(p: usize, out: *x509.Certificate) -> bool {
    const der = m.getWord(p + P_DER)
    if der == 0 { return false }
    return x509.parse(out, m.bytes(der, m.getWord(p + P_DER_LENGTH)))
}

// A Name as GnuTLS prints it (the RDNs in the certificate's order).
fn nameString(cert: *x509.Certificate, name: x509.Range) -> usize {
    const buffer = m.alloc(1024)
    const out: [*]u8 = unsafe { @ptrFromInt([*]u8, buffer) }
    var length = x509.nameTextOrdered(cert, name, out, 1023, false)
    if length > 1023 { length = 1023 }
    const text = m.dupBytes(buffer, length)
    m.release(buffer)
    return text
}

fn x509Property(p: usize, id: u32, value: usize) -> void {
    var cert: x509.Certificate = undefined
    if !parsed(p, &cert) { return }
    if id == PROP_NOT_VALID_BEFORE {
        g_value_take_boxed(value, g_date_time_new_from_unix_utc(cert.notBefore))
    } else if id == PROP_NOT_VALID_AFTER {
        g_value_take_boxed(value, g_date_time_new_from_unix_utc(cert.notAfter))
    } else if id == PROP_SUBJECT_NAME {
        g_value_take_string(value, nameString(&cert, cert.subject))
    } else if id == PROP_ISSUER_NAME {
        g_value_take_string(value, nameString(&cert, cert.issuer))
    } else if id == PROP_DNS_NAMES {
        // GBytes of each dNSName, as the certificate has them (an empty
        // array when there is none, as GnuTLS's backend gives).
        var name: x509.Range = undefined
        var index: usize = 0
        const array = g_ptr_array_new_with_free_func(@intFromPtr(g_bytes_unref))
        while x509.altName(&cert, 130, index, &name) {
            g_ptr_array_add(array, g_bytes_new(@intFromPtr(cert.der) + name.start, name.length))
            index += 1
        }
        g_value_take_boxed(value, array)
    } else if id == PROP_IP_ADDRESSES {
        var name: x509.Range = undefined
        var index: usize = 0
        const array = g_ptr_array_new_with_free_func(@intFromPtr(g_object_unref))
        while x509.altName(&cert, 135, index, &name) {
            if name.length == 4 || name.length == 16 {
                // G_SOCKET_FAMILY_IPV4 (2) or IPV6 (10).
                g_ptr_array_add(array, g_inet_address_new_from_bytes(@intFromPtr(cert.der) + name.start, if name.length == 4 { 2 } else { 10 }))
            }
            index += 1
        }
        g_value_take_boxed(value, array)
    }
}

fn property(class: usize, id: u32, pspec: usize) -> void { g_object_class_install_property(class, id, pspec) }

fn stringProperty(class: usize, id: u32, name: []const u8, flags: i32) -> void {
    property(class, id, g_param_spec_string(m.literal(name), m.literal(name), m.literal(name), 0, flags | STATIC_STRINGS))
}

fn boxedProperty(class: usize, id: u32, name: []const u8, t: usize, flags: i32) -> void {
    property(class, id, g_param_spec_boxed(m.literal(name), m.literal(name), m.literal(name), t, flags | STATIC_STRINGS))
}

export fn __mlx_glib_tls_certificate_verify(cert: usize, identity: usize, trusted: usize) -> i32 { return verifyCertificate(cert, identity, trusted) }

export fn __mlx_glib_tls_certificate_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_glib_tls_certificate_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_tls_certificate_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_tls_certificate_finalize))
    m.putWord(class + CLASS_VERIFY, @intFromPtr(__mlx_glib_tls_certificate_verify))
    const given = READABLE | WRITABLE | CONSTRUCT_ONLY
    boxedProperty(class, PROP_CERTIFICATE, "certificate", g_byte_array_get_type(), given)
    stringProperty(class, PROP_CERTIFICATE_PEM, "certificate-pem", given)
    boxedProperty(class, PROP_PRIVATE_KEY, "private-key", g_byte_array_get_type(), given)
    stringProperty(class, PROP_PRIVATE_KEY_PEM, "private-key-pem", given)
    property(class, PROP_ISSUER, g_param_spec_object(m.literal("issuer"), m.literal("issuer"), m.literal("issuer"), m.getWord(class), given | STATIC_STRINGS))
    stringProperty(class, PROP_PKCS11_URI, "pkcs11-uri", given)
    stringProperty(class, PROP_PRIVATE_KEY_PKCS11_URI, "private-key-pkcs11-uri", given)
    boxedProperty(class, PROP_NOT_VALID_BEFORE, "not-valid-before", g_date_time_get_type(), READABLE)
    boxedProperty(class, PROP_NOT_VALID_AFTER, "not-valid-after", g_date_time_get_type(), READABLE)
    stringProperty(class, PROP_SUBJECT_NAME, "subject-name", READABLE)
    stringProperty(class, PROP_ISSUER_NAME, "issuer-name", READABLE)
    boxedProperty(class, PROP_DNS_NAMES, "dns-names", g_ptr_array_get_type(), READABLE)
    boxedProperty(class, PROP_IP_ADDRESSES, "ip-addresses", g_ptr_array_get_type(), READABLE)
    stringProperty(class, PROP_PASSWORD, "password", WRITABLE | CONSTRUCT_ONLY)
}

// GInitable's init: the certificate is there, and what PEM was given
// read; else G_TLS_ERROR_BAD_CERTIFICATE, with GIO's (GnuTLS
// backend's) messages.
export fn __mlx_glib_tls_certificate_initable_init(cert: usize, cancellable: usize, err: usize) -> i32 {
    const p = certPriv(cert)
    const problem = m.getWord(p + P_PROBLEM)
    if problem == 1 {
        errors.set(err, g_tls_error_quark(), TLS_ERROR_BAD_CERTIFICATE, "Could not parse PEM certificate")
        return 0
    }
    if problem == 2 {
        errors.set(err, g_tls_error_quark(), TLS_ERROR_BAD_CERTIFICATE, "Could not parse PEM private key")
        return 0
    }
    if m.getWord(p + P_DER) == 0 && m.getWord(p + P_URI) == 0 {
        errors.set(err, g_tls_error_quark(), TLS_ERROR_BAD_CERTIFICATE, "No certificate data provided")
        return 0
    }
    return 1
}

// GInitableIface: its init (16).
export fn __mlx_glib_tls_certificate_initable_iface_init(iface: usize, data: usize) -> void { m.putWord(iface + 16, @intFromPtr(__mlx_glib_tls_certificate_initable_init)) }

// A certificate of the backend's type from DER (taken) and a key's PEM
// (copied; 0 for none), issued by `issuer` (0 for none).
fn newCertificate(der: usize, length: usize, keyPem: usize, issuer: usize) -> usize {
    ensureTypes()
    const cert = g_object_new(backendCertificateType, 0)
    const p = certPriv(cert)
    setDer(p, der, length)
    if keyPem != 0 { setKeyPem(p, keyPem) }
    if issuer != 0 { m.putWord(p + P_ISSUER, g_object_ref(issuer)) }
    return cert
}

// GIO's g_tls_certificate_new_from_pem: the first certificate, the
// private key if the text has one, and the certificates after the first
// as its chain of issuers.
export fn g_tls_certificate_new_from_pem(data: usize, length: isize, err: usize) -> usize {
    ensureTypes()
    const size = if length < 0 { m.cLength(data) } else { @intCast(usize, length) }
    // The certificates, in order.
    var ders = m.words()
    var lengths = m.words()
    var at: usize = 0
    while at < size {
        const block = findBlock(data, size, at, "CERTIFICATE")
        if block.end == 0 { break }
        var bytes: usize = 0
        const der = decodeBlock(data, block, @intFromPtr(&bytes))
        if der == 0 { break }
        m.pushWord(&ders, der)
        m.pushWord(&lengths, bytes)
        at = block.end
    }
    if ders.length == 0 {
        m.disposeWords(&ders)
        m.disposeWords(&lengths)
        errors.set(err, g_tls_error_quark(), TLS_ERROR_BAD_CERTIFICATE, "No PEM-encoded certificate found")
        return 0
    }
    // GIO keeps the chain when the certificates verify up to the last one;
    // here, when each names the next as its issuer (by the DER of the
    // names: the signatures are not checked). Else the first is alone.
    var linked = true
    var link: usize = 0
    while link + 1 < ders.length {
        if !issuedBy(m.wordAt(&ders, link), m.wordAt(&lengths, link), m.wordAt(&ders, link + 1), m.wordAt(&lengths, link + 1)) { linked = false }
        link += 1
    }
    if !linked {
        while ders.length > 1 {
            m.release(m.wordAt(&ders, ders.length - 1))
            ders.length -= 1
        }
    }
    const key = findBlock(data, size, 0, "PRIVATE KEY")
    var keyPem: usize = 0
    if key.end != 0 { keyPem = m.dupBytes(data + key.start, key.end - key.start) }
    // The last issuer first: each certificate made holds the one after it.
    var issuer: usize = 0
    var index = ders.length
    while index > 0 {
        index -= 1
        const made = newCertificate(m.wordAt(&ders, index), m.wordAt(&lengths, index), if index == 0 { keyPem } else { 0 }, issuer)
        if issuer != 0 { g_object_unref(issuer) }
        issuer = made
    }
    m.release(keyPem)
    m.disposeWords(&ders)
    m.disposeWords(&lengths)
    if keyPem != 0 && m.getWord(certPriv(issuer) + P_PROBLEM) == 2 {
        g_object_unref(issuer)
        errors.set(err, g_tls_error_quark(), TLS_ERROR_BAD_CERTIFICATE, "Could not parse PEM private key")
        return 0
    }
    return issuer
}

export fn g_tls_certificate_get_issuer(cert: usize) -> usize {
    if cert == 0 { return 0 }
    return m.getWord(certPriv(cert) + P_ISSUER)
}

// Two certificates are the same when their DER is.
export fn g_tls_certificate_is_same(first: usize, second: usize) -> i32 {
    if first == 0 || second == 0 { return 0 }
    const a = certPriv(first)
    const b = certPriv(second)
    const length = m.getWord(a + P_DER_LENGTH)
    if m.getWord(a + P_DER) == 0 || m.getWord(b + P_DER) == 0 || length != m.getWord(b + P_DER_LENGTH) { return 0 }
    var index: usize = 0
    while index < length {
        if m.get8(m.getWord(a + P_DER) + index) != m.get8(m.getWord(b + P_DER) + index) { return 0 }
        index += 1
    }
    return 1
}

// The name a GSocketConnectable stands for, as a new C string (0 when it
// has none): an address's text, or the "hostname" of a network address
// (the "domain" of a service).
pub fn identityHost(identity: usize) -> usize {
    if identity == 0 { return 0 }
    if g_type_check_instance_is_a(identity, g_inet_socket_address_get_type()) != 0 {
        return g_inet_address_to_string(g_inet_socket_address_get_address(identity))
    }
    var name = m.literal("hostname\x00")
    if g_object_class_find_property(m.getWord(identity), name) == 0 {
        name = m.literal("domain\x00")
        if g_object_class_find_property(m.getWord(identity), name) == 0 { return 0 }
    }
    const value = m.alloc(24)
    _ = g_value_init(value, types.T_STRING)
    g_object_get_property(identity, name, value)
    const host = g_value_dup_string(value)
    g_value_unset(value)
    m.release(value)
    return host
}

export fn __mlx_glib_tls_identity_host(identity: usize) -> usize { return identityHost(identity) }

// A certificate and the issuers it holds, parsed into `chain` (ten at
// most): how many.
fn chainOf(cert: usize, chain: [*]x509.Certificate) -> usize {
    var count: usize = 0
    var at = cert
    while at != 0 && count < 10 {
        if !parsed(certPriv(at), &chain[count]) { break }
        count += 1
        at = m.getWord(certPriv(at) + P_ISSUER)
    }
    return count
}

// The chain of `cert` against the anchors of `store` and the identity:
// GTlsCertificateFlags.
fn verifyAgainst(cert: usize, identity: usize, store: *x509.TrustStore) -> i32 {
    var chain: [10]x509.Certificate = undefined
    const certificates: [*]x509.Certificate = &chain
    const count = chainOf(cert, certificates)
    if count == 0 { return CERTIFICATE_GENERIC_ERROR }
    const host = identityHost(identity)
    const name = if host == 0 { m.literal("") } else { host }
    const flags = x509.verifyChain(store, certificates, count, m.bytes(name, m.cLength(name)), x509.now())
    m.release(host)
    return @bitCast(i32, flags)
}

// GnuTLS's verification of a certificate: against `trusted` alone, with
// its validity and the identity; without `trusted`, the validity and the
// identity only (glib-networking asks GnuTLS about the authority only
// when it is given one).
fn verifyCertificate(cert: usize, identity: usize, trusted: usize) -> i32 {
    var store: x509.TrustStore = undefined
    x509.storeInit(&store, m.stdAllocator())
    if trusted != 0 {
        const t = certPriv(trusted)
        if m.getWord(t + P_DER) != 0 { _ = x509.storeAddDer(&store, m.bytes(m.getWord(t + P_DER), m.getWord(t + P_DER_LENGTH))) }
    }
    var flags = verifyAgainst(cert, identity, &store)
    if trusted == 0 { flags = flags & (CERTIFICATE_UNKNOWN_CA ^ 127) }
    x509.storeFree(&store)
    return flags
}

export fn g_tls_certificate_verify(cert: usize, identity: usize, trusted: usize) -> i32 {
    if cert == 0 { return CERTIFICATE_GENERIC_ERROR }
    return verifyCertificate(cert, identity, trusted)
}

// A certificate of the backend's type from a copy of `length` bytes of
// DER, issued by `issuer` (0 for none): for the connections' peers.
export fn __mlx_glib_tls_certificate_from_der(der: usize, length: usize, issuer: usize) -> usize {
    return newCertificate(copyBytes(der, length), length, 0, issuer)
}

// ---------------------------------------------------------------------------
// GTlsBackend: one, made at the first call, kept for the program's life.

export fn g_tls_backend_get_default() -> usize {
    ensureTypes()
    if threads.onceEnter(@intFromPtr(&backendOnce)) {
        defaultBackend = g_object_new(backendType, 0)
        threads.onceLeave(@intFromPtr(&backendOnce), 1)
    }
    return defaultBackend
}

export fn g_tls_backend_supports_tls(backend: usize) -> i32 { return 1 }
export fn g_tls_backend_supports_dtls(backend: usize) -> i32 { return 0 }
// The default database: the system's anchors (a new reference each
// time).
export fn g_tls_backend_get_default_database(backend: usize) -> usize {
    ensureTypes()
    if threads.onceEnter(@intFromPtr(&databaseOnce)) {
        defaultDatabase = g_object_new(backendDatabaseType, 0)
        m.putWord(databaseRecord(defaultDatabase) + D_ANCHORS, m.dupSlice("/etc/ssl/certs/ca-certificates.crt"))
        threads.onceLeave(@intFromPtr(&databaseOnce), 1)
    }
    return g_object_ref(defaultDatabase)
}

export fn g_tls_backend_get_certificate_type(backend: usize) -> usize {
    ensureTypes()
    return backendCertificateType
}

export fn g_tls_backend_get_client_connection_type(backend: usize) -> usize { return __mlx_glib_tls_client_connection_impl_type() }
// No servers here: a TLS server connection is not made.
export fn g_tls_backend_get_server_connection_type(backend: usize) -> usize { return 0 }

export fn g_tls_backend_get_file_database_type(backend: usize) -> usize {
    ensureTypes()
    return fileDatabaseType
}

// ---------------------------------------------------------------------------
// GTlsDatabase: the backend's (the default one) and GTlsFileDatabase's.
// The instance's record (32): the anchors' file (0, a C string), the
// trust store once read (8, a std.x509 TrustStore) and its once (16).

const D_ANCHORS: usize = 0
const D_STORE: usize = 8
const D_ONCE: usize = 16
const D_SIZE: usize = 24

const PROP_ANCHORS: u32 = 1

fn databaseRecord(database: usize) -> usize { return m.getWord(database + 32) }

export fn __mlx_glib_tls_database_init(database: usize, class: usize) -> void { m.putWord(database + 32, m.alloc(D_SIZE)) }

export fn __mlx_glib_tls_database_finalize(database: usize) -> void {
    const r = databaseRecord(database)
    const store = m.getWord(r + D_STORE)
    if store != 0 {
        x509.storeFree(unsafe { @ptrFromInt(*x509.TrustStore, store) })
        m.release(store)
    }
    m.release(m.getWord(r + D_ANCHORS))
    m.release(r)
    ioerrors.chainUp(types.T_OBJECT, 48, database)
}

export fn __mlx_glib_tls_database_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_glib_tls_database_finalize))
}

export fn __mlx_glib_tls_file_database_set_property(database: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_ANCHORS { replaceText(databaseRecord(database), D_ANCHORS, g_value_get_string(value)) }
}

export fn __mlx_glib_tls_file_database_get_property(database: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_ANCHORS { g_value_set_string(value, m.getWord(databaseRecord(database) + D_ANCHORS)) }
}

// GTlsFileDatabase's "anchors", installed on the interface.
export fn __mlx_glib_tls_file_database_iface_default(iface: usize, data: usize) -> void {
    g_object_interface_install_property(iface, g_param_spec_string(m.literal("anchors"), m.literal("Anchors"), m.literal("The certificate authority anchor file"), 0, READABLE | WRITABLE | CONSTRUCT_ONLY | STATIC_STRINGS))
}

export fn __mlx_glib_tls_file_database_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_glib_tls_file_database_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_tls_file_database_get_property))
    g_object_class_override_property(class, PROP_ANCHORS, m.literal("anchors"))
}

// The database's trust store, its anchors read the first time (0 when
// it has no file).
export fn __mlx_glib_tls_database_store(database: usize) -> usize {
    if database == 0 { return 0 }
    const r = databaseRecord(database)
    if threads.onceEnter(r + D_ONCE) {
        const anchors = m.getWord(r + D_ANCHORS)
        if anchors != 0 {
            const store = m.alloc(@sizeOf(x509.TrustStore))
            const trust: *x509.TrustStore = unsafe { @ptrFromInt(*x509.TrustStore, store) }
            x509.storeInit(trust, m.stdAllocator())
            const count = x509.storeLoadFile(trust, unsafe { @ptrFromInt([*]const u8, anchors) })
            m.putWord(r + D_STORE, store)
        }
        threads.onceLeave(r + D_ONCE, 1)
    }
    return m.getWord(r + D_STORE)
}

// GIO's GnuTLS file database: the anchors are read now, and a file that
// cannot be read is G_TLS_ERROR_MISC with GnuTLS's words.
export fn g_tls_file_database_new(anchors: usize, err: usize) -> usize {
    ensureTypes()
    if anchors == 0 { return 0 }
    const probe = m.alloc(1)
    const opened = std.fs.readFileResult(unsafe { @ptrFromInt([*]const u8, anchors) }, unsafe { @ptrFromInt([*]u8, probe) }, 1)
    m.release(probe)
    if opened < 0 {
        var t = m.text()
        m.pushText(&t, "Failed to populate trust list from ")
        m.pushC(&t, anchors)
        m.pushText(&t, ": Error while reading file.")
        const message = m.finish(&t)
        errors.set(err, g_tls_error_quark(), 1, m.cSlice(message))
        m.release(message)
        return 0
    }
    const database = g_object_new(fileDatabaseImplType, 0)
    replaceText(databaseRecord(database), D_ANCHORS, anchors)
    const store = __mlx_glib_tls_database_store(database)
    return database
}

// g_tls_database_verify_chain: the chain of `chain` (the certificate and
// the issuers it holds) up to the database's anchors, and the identity.
export fn g_tls_database_verify_chain(database: usize, chain: usize, purpose: usize, identity: usize, interaction: usize, flags: i32, cancellable: usize, err: usize) -> i32 {
    if database == 0 || chain == 0 { return CERTIFICATE_GENERIC_ERROR }
    const store = __mlx_glib_tls_database_store(database)
    if store == 0 {
        var empty: x509.TrustStore = undefined
        x509.storeInit(&empty, m.stdAllocator())
        return verifyAgainst(chain, identity, &empty)
    }
    return verifyAgainst(chain, identity, unsafe { @ptrFromInt(*x509.TrustStore, store) })
}

// The same reported from a task (at once: the work is the same).
export fn g_tls_database_verify_chain_async(database: usize, chain: usize, purpose: usize, identity: usize, interaction: usize, flags: i32, cancellable: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(database, cancellable, callback, data)
    g_task_return_int(task, @intCast(i64, g_tls_database_verify_chain(database, chain, purpose, identity, interaction, flags, cancellable, 0)))
    g_object_unref(task)
}

export fn g_tls_database_verify_chain_finish(database: usize, result: usize, err: usize) -> i32 {
    const flags = g_task_propagate_int(result, err)
    if flags < 0 { return CERTIFICATE_GENERIC_ERROR }
    return @intCast(i32, flags)
}

// ---------------------------------------------------------------------------
// GTlsPassword

// The instance's private part (24): the value (0, its length 8), the
// flags (16), the description (24) and the warning (32).
const W_VALUE: usize = 0
const W_LENGTH: usize = 8
const W_FLAGS: usize = 16
const W_DESCRIPTION: usize = 24
const W_WARNING: usize = 32
const W_SIZE: usize = 40

// GObjectClass, get_value, set_value, get_default_warning, padding.
const W_CLASS_SIZE: usize = 192
const W_CLASS_DEFAULT_WARNING: usize = 152

const PROP_FLAGS: u32 = 1
const PROP_DESCRIPTION: u32 = 2
const PROP_WARNING: u32 = 3

pub const WarningFunc = fn(usize) -> usize

fn passwordPriv(password: usize) -> usize { return m.getWord(password + 24) }

export fn __mlx_glib_tls_password_init(password: usize, class: usize) -> void { m.putWord(password + 24, m.alloc(W_SIZE)) }

export fn __mlx_glib_tls_password_finalize(password: usize) -> void {
    const p = passwordPriv(password)
    m.release(m.getWord(p + W_VALUE))
    m.release(m.getWord(p + W_DESCRIPTION))
    m.release(m.getWord(p + W_WARNING))
    m.release(p)
    ioerrors.chainUp(types.T_OBJECT, 48, password)
}

export fn __mlx_glib_tls_password_set_property(password: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = passwordPriv(password)
    if id == PROP_FLAGS { m.put32(p + W_FLAGS, g_value_get_flags(value)) }
    if id == PROP_DESCRIPTION { replaceText(p, W_DESCRIPTION, g_value_get_string(value)) }
    if id == PROP_WARNING { replaceText(p, W_WARNING, g_value_get_string(value)) }
}

export fn __mlx_glib_tls_password_get_property(password: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_FLAGS { g_value_set_flags(value, m.get32(passwordPriv(password) + W_FLAGS)) }
    if id == PROP_DESCRIPTION { g_value_set_string(value, g_tls_password_get_description(password)) }
    if id == PROP_WARNING { g_value_set_string(value, g_tls_password_get_warning(password)) }
}

// GIO's default warnings, by the flags.
export fn __mlx_glib_tls_password_default_warning(password: usize) -> usize {
    const flags = m.get32(passwordPriv(password) + W_FLAGS)
    if (flags & 8) != 0 { return m.literal("This is the last chance to enter the password correctly before your access is locked out.") }
    if (flags & 4) != 0 { return m.literal("Several passwords entered have been incorrect, and your access will be locked out after further failures.") }
    if (flags & 2) != 0 { return m.literal("The password entered is incorrect.") }
    return 0
}

export fn __mlx_glib_tls_password_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_glib_tls_password_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_glib_tls_password_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_glib_tls_password_finalize))
    m.putWord(class + W_CLASS_DEFAULT_WARNING, @intFromPtr(__mlx_glib_tls_password_default_warning))
    const both = READABLE | WRITABLE
    property(class, PROP_FLAGS, g_param_spec_flags(m.literal("flags"), m.literal("flags"), m.literal("flags"), passwordFlagsType, 0, both | STATIC_STRINGS))
    stringProperty(class, PROP_DESCRIPTION, "description", both)
    stringProperty(class, PROP_WARNING, "warning", both)
}

export fn g_tls_password_new(flags: u32, description: usize) -> usize {
    ensureTypes()
    const password = g_object_new(passwordType, 0)
    const p = passwordPriv(password)
    m.put32(p + W_FLAGS, flags)
    replaceText(p, W_DESCRIPTION, description)
    return password
}

export fn g_tls_password_get_value(password: usize, length: usize) -> usize {
    const p = passwordPriv(password)
    if length != 0 { m.putWord(length, m.getWord(p + W_LENGTH)) }
    return m.getWord(p + W_VALUE)
}

// The value copied (`length` -1: up to its NUL); a NUL follows the copy.
export fn g_tls_password_set_value(password: usize, value: usize, length: isize) -> void {
    const p = passwordPriv(password)
    const size = if length < 0 { m.cLength(value) } else { @intCast(usize, length) }
    m.release(m.getWord(p + W_VALUE))
    m.putWord(p + W_VALUE, m.dupBytes(value, size))
    m.putWord(p + W_LENGTH, size)
}

export fn g_tls_password_get_flags(password: usize) -> u32 { return m.get32(passwordPriv(password) + W_FLAGS) }
export fn g_tls_password_set_flags(password: usize, flags: u32) -> void { m.put32(passwordPriv(password) + W_FLAGS, flags) }
export fn g_tls_password_get_description(password: usize) -> usize { return m.getWord(passwordPriv(password) + W_DESCRIPTION) }
export fn g_tls_password_set_description(password: usize, description: usize) -> void { replaceText(passwordPriv(password), W_DESCRIPTION, description) }

// The warning set, else the class's default for the flags.
export fn g_tls_password_get_warning(password: usize) -> usize {
    const warning = m.getWord(passwordPriv(password) + W_WARNING)
    if warning != 0 { return warning }
    const f = m.getWord(m.getWord(password) + W_CLASS_DEFAULT_WARNING)
    if f == 0 { return 0 }
    const call: WarningFunc = unsafe { @ptrFromInt(WarningFunc, f) }
    return call(password)
}

export fn g_tls_password_set_warning(password: usize, warning: usize) -> void { replaceText(passwordPriv(password), W_WARNING, warning) }
