// gcontenttype.h: content types, MIME types on this system. GIO guesses
// with the shared-mime-info database; there is none here, so a type is
// guessed as GIO guesses with that database for the common types of the
// web: by the file name's extension (a table of its answers, with
// whether GIO calls them uncertain, the case of the name ignored), else
// by the first bytes of the data (images, fonts, PDF, HTML, SVG and XML
// by their signatures, else text when the bytes are UTF-8 without
// control characters), else "application/octet-stream", uncertain. A
// name that gives a type with data alongside makes it certain, the data
// confirming it as far as GIO's database is concerned.
const m = @import("./memory.mlx")

extern("c") fn g_utf8_validate(text: usize, length: i64, end: usize) -> i32
extern("c") fn g_ascii_strcasecmp(a: usize, b: usize) -> i32
extern("c") fn g_ascii_strdown(text: usize, length: i64) -> usize

const UNKNOWN = "application/octet-stream"

// Extension, type, uncertain (1) or not (0); compound extensions first.
const EXTENSIONS = "tar.gz application/x-compressed-tar 0 html text/html 1 htm text/html 1 xhtml application/xhtml+xml 0 css text/css 0 js text/javascript 0 mjs text/javascript 0 json application/json 1 png image/png 1 jpg image/jpeg 0 jpeg image/jpeg 0 gif image/gif 0 svg image/svg+xml 0 webp image/webp 0 avif image/avif 0 bmp image/bmp 0 ico image/vnd.microsoft.icon 0 tif image/tiff 0 tiff image/tiff 0 jxl image/jxl 0 heic image/heif 0 txt text/plain 0 csv text/csv 0 md text/markdown 0 vtt text/vtt 0 srt application/x-subrip 0 m3u8 audio/x-mpegurl 1 xml application/xml 0 pdf application/pdf 0 wasm application/wasm 0 zip application/zip 0 gz application/gzip 0 mp4 video/mp4 0 webm video/webm 0 ogv video/ogg 0 ogg audio/ogg 1 oga audio/ogg 1 opus audio/ogg 1 mp3 audio/mpeg 0 wav audio/vnd.wave 0 flac audio/flac 0 m4a audio/mp4 0 aac audio/aac 0 woff font/woff 0 woff2 font/woff2 0 ttf font/ttf 0 otf font/otf 1 c text/x-csrc 0"

fn word(text: []const u8, at: *usize) -> []const u8 {
    const start = at.*
    var end = start
    while end < text.length && text[end] != 32 { end += 1 }
    at.* = end + 1
    return text[start..end]
}

fn endsWith(name: usize, length: usize, extension: []const u8) -> bool {
    if length < extension.length + 1 { return false }
    if m.get8(name + length - extension.length - 1) != '.' { return false }
    var index: usize = 0
    while index < extension.length {
        var byte = m.get8(name + length - extension.length + index)
        if byte >= 'A' && byte <= 'Z' { byte += 32 }
        if byte != extension[index] { return false }
        index += 1
    }
    return true
}

// The type of the name's extension, or 0; `uncertain` set from the table.
fn byName(name: usize, uncertain: *bool) -> usize {
    var base = name
    var index: usize = 0
    while m.get8(name + index) != 0 {
        if m.get8(name + index) == '/' { base = name + index + 1 }
        index += 1
    }
    const length = m.cLength(base)
    // (shared-mime-info's "*~": a backup.)
    if length > 1 && m.get8(base + length - 1) == '~' {
        uncertain.* = false
        return m.dupSlice("application/x-trash")
    }
    var at: usize = 0
    while at < EXTENSIONS.length {
        const extension = word(EXTENSIONS, &at)
        const mime = word(EXTENSIONS, &at)
        const flag = word(EXTENSIONS, &at)
        if endsWith(base, length, extension) {
            uncertain.* = flag[0] == '1'
            return m.dupBytes(m.literal(mime), mime.length)
        }
    }
    return 0
}

fn startsWith(data: usize, size: usize, signature: []const u8) -> bool {
    if size < signature.length { return false }
    var index: usize = 0
    while index < signature.length {
        if m.get8(data + index) != signature[index] { return false }
        index += 1
    }
    return true
}

// Whether the data starts with `tag` (case ignored) after white space.
fn startsWithTag(data: usize, size: usize, tag: []const u8) -> bool {
    var at: usize = 0
    while at < size && (m.get8(data + at) == 32 || m.get8(data + at) == 9 || m.get8(data + at) == 10 || m.get8(data + at) == 13) { at += 1 }
    if size - at < tag.length { return false }
    var index: usize = 0
    while index < tag.length {
        var byte = m.get8(data + at + index)
        if byte >= 'A' && byte <= 'Z' { byte += 32 }
        if byte != tag[index] { return false }
        index += 1
    }
    return true
}

fn isText(data: usize, size: usize) -> bool {
    if g_utf8_validate(data, @intCast(i64, size), 0) == 0 { return false }
    var index: usize = 0
    while index < size {
        const byte = m.get8(data + index)
        if byte < 32 && byte != 9 && byte != 10 && byte != 12 && byte != 13 { return false }
        if byte == 127 { return false }
        index += 1
    }
    return true
}

fn byData(data: usize, size: usize, uncertain: *bool) -> []const u8 {
    uncertain.* = false
    if size == 0 { return "application/x-zerosize" }
    if startsWith(data, size, "\x89PNG\r\n\x1a\n") { return "image/png" }
    if startsWith(data, size, "GIF87a") || startsWith(data, size, "GIF89a") { return "image/gif" }
    if startsWith(data, size, "\xff\xd8\xff") { return "image/jpeg" }
    if startsWith(data, size, "%PDF-") { return "application/pdf" }
    if size >= 12 && startsWith(data, size, "RIFF") && m.get8(data + 8) == 'W' && m.get8(data + 9) == 'E' && m.get8(data + 10) == 'B' && m.get8(data + 11) == 'P' { return "image/webp" }
    if startsWith(data, size, "wOFF") { return "font/woff" }
    if startsWith(data, size, "wOF2") { return "font/woff2" }
    if startsWithTag(data, size, "<?xml") { return "application/xml" }
    if startsWithTag(data, size, "<svg") { return "image/svg+xml" }
    if startsWithTag(data, size, "<html") || startsWithTag(data, size, "<!doctype html") { return "text/html" }
    if isText(data, size) { return "text/plain" }
    uncertain.* = true
    return UNKNOWN
}

export fn g_content_type_guess(filename: usize, data: usize, size: usize, result_uncertain: usize) -> usize {
    var uncertain = false
    var result: usize = 0
    if filename != 0 { result = byName(filename, &uncertain) }
    if result != 0 {
        if data != 0 && size > 0 { uncertain = false }
    } else if data != 0 {
        const mime = byData(data, size, &uncertain)
        result = m.dupBytes(m.literal(mime), mime.length)
    } else {
        uncertain = true
        result = m.dupBytes(m.literal(UNKNOWN), UNKNOWN.length)
    }
    if result_uncertain != 0 { m.putI32(result_uncertain, if uncertain { 1 } else { 0 }) }
    return result
}

export fn g_content_type_equals(a: usize, b: usize) -> i32 { return if g_ascii_strcasecmp(a, b) == 0 { 1 } else { 0 } }

export fn g_content_type_is_unknown(t: usize) -> i32 { return if m.cIs(t, UNKNOWN) { 1 } else { 0 } }

export fn g_content_type_get_mime_type(t: usize) -> usize { return m.dup(t) }

export fn g_content_type_from_mime_type(mime: usize) -> usize { return g_ascii_strdown(mime, -1) }
