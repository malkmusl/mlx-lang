// gio/gsocketclient.h
// mlx-glib: GSocketClient, connections made to "host:port" or to a
// socket address, at once or asynchronously (the connection completed in
// the thread-default main context). A host is an address's text, or a
// name the C library resolves (at once, before the connection is made).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")
const gsocketconnectable = @import("./gsocketconnectable.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const guint8 = gtypes.guint8
const guint16 = gtypes.guint16
const guint32 = gtypes.guint32
const gint = gtypes.gint
const guint = gtypes.guint
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GObject = gobject.GObject
const GCancellable = giotypes.GCancellable
const GSocketAddress = giotypes.GSocketAddress
const GSocketConnection = giotypes.GSocketConnection
const GSocket = giotypes.GSocket
const GAsyncResult = giotypes.GAsyncResult

pub const _GSocketClient = struct {}
pub const GSocketClient = _GSocketClient

pub extern("c") fn g_socket_client_get_type() -> gtype.GType
pub extern("c") fn g_socket_client_new() -> *GSocketClient
pub extern("c") fn g_socket_client_set_timeout(client: *GSocketClient, timeout: guint) -> void
pub extern("c") fn g_socket_client_get_timeout(client: *GSocketClient) -> guint
pub extern("c") fn g_socket_client_connect(client: *GSocketClient, connectable: *gsocketconnectable.GSocketConnectable, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GSocketConnection
pub extern("c") fn g_socket_client_connect_to_host(client: *GSocketClient, host_and_port: [*]const gchar, default_port: guint16, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GSocketConnection
pub extern("c") fn g_socket_client_connect_to_host_async(client: *GSocketClient, host_and_port: [*]const gchar, default_port: guint16, cancellable: ?*GCancellable, callback: ?giotypes.GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_socket_client_connect_to_host_finish(client: *GSocketClient, result: *GAsyncResult, error_: ?**GError) -> ?*GSocketConnection

pub const G_TYPE_SOCKET_CLIENT: gtype.GType = g_socket_client_get_type()
pub fn G_SOCKET_CLIENT(o: anytype) -> *GSocketClient { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_SOCKET_CLIENT, GSocketClient) }
pub fn G_IS_SOCKET_CLIENT(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_SOCKET_CLIENT) }
