// glib/gmessages.h
// mlx-glib: messages to the log. GLib has g_debug, g_message, g_info,
// g_warning, g_critical and g_error as macros over g_log; here they are
// functions of the same names (the default domain), which print as
// GLib's default handler does: on standard error, debug and info
// messages only when G_MESSAGES_DEBUG names the domain or "all", and
// g_error aborts the program. g_return_if_fail and the assertions are
// macros, as GLib's.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gchar = gtypes.gchar
const gint = gtypes.gint
const gpointer = gtypes.gpointer

pub const GLogLevelFlags = enum(c_int) {
    G_LOG_FLAG_RECURSION = 1,
    G_LOG_FLAG_FATAL = 2,
    G_LOG_LEVEL_ERROR = 4,
    G_LOG_LEVEL_CRITICAL = 8,
    G_LOG_LEVEL_WARNING = 16,
    G_LOG_LEVEL_MESSAGE = 32,
    G_LOG_LEVEL_INFO = 64,
    G_LOG_LEVEL_DEBUG = 128,
    G_LOG_LEVEL_MASK = -4,
}

pub const G_LOG_LEVEL_USER_SHIFT: c_int = 8
pub const G_LOG_FATAL_MASK: c_int = 5

pub const GLogFunc = fn(log_domain: [*]const gchar, log_level: GLogLevelFlags, message: [*]const gchar, user_data: gpointer) -> void

pub extern("c") fn g_log(log_domain: ?[*]const gchar, log_level: GLogLevelFlags, format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_logv(log_domain: ?[*]const gchar, log_level: GLogLevelFlags, format: [*]const gchar, args: gtypes.c_va_list) -> void
pub extern("c") fn g_log_default_handler(log_domain: ?[*]const gchar, log_level: GLogLevelFlags, message: ?[*]const gchar, unused_data: gpointer) -> void
pub extern("c") fn g_log_set_handler(log_domain: ?[*]const gchar, log_levels: GLogLevelFlags, log_func: GLogFunc, user_data: gpointer) -> gtypes.guint
pub extern("c") fn g_log_remove_handler(log_domain: ?[*]const gchar, handler_id: gtypes.guint) -> void
pub extern("c") fn g_log_set_default_handler(log_func: GLogFunc, user_data: gpointer) -> GLogFunc
pub extern("c") fn g_log_set_always_fatal(fatal_mask: GLogLevelFlags) -> GLogLevelFlags
pub extern("c") fn g_log_set_fatal_mask(log_domain: [*]const gchar, fatal_mask: GLogLevelFlags) -> GLogLevelFlags

pub extern("c") fn g_debug(format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_info(format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_message(format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_warning(format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_critical(format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_error(format: [*]const gchar, args: gtypes.c_varargs) -> void

pub extern("c") fn g_print(format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_printerr(format: [*]const gchar, args: gtypes.c_varargs) -> void

pub extern("c") fn g_return_if_fail_warning(log_domain: ?[*]const c_char, pretty_function: [*]const c_char, expression: [*]const c_char) -> void
pub extern("c") fn g_warn_message(domain: ?[*]const c_char, file: [*]const c_char, line: c_int, func: [*]const c_char, warnexpr: ?[*]const c_char) -> void
pub extern("c") fn g_assertion_message_expr(domain: ?[*]const c_char, file: [*]const c_char, line: c_int, func: [*]const c_char, expr: ?[*]const c_char) -> void
pub extern("c") fn g_on_error_query(prg_name: ?[*]const gchar) -> void
pub extern("c") fn g_on_error_stack_trace(prg_name: ?[*]const gchar) -> void

// The precondition checks of GLib's functions: a critical warning and a
// return when `expr` is false.
pub inline fn g_return_if_fail(expr: bool) -> void {
    if !expr {
        g_return_if_fail_warning(null, __func__, "expression")
        return
    }
}
pub inline fn g_return_val_if_fail(expr: bool, val: anytype) -> void {
    if !expr {
        g_return_if_fail_warning(null, __func__, "expression")
        return val
    }
}
pub inline fn g_return_if_reached() -> void {
    g_warn_message(null, __FILE__, __LINE__, __func__, null)
    return
}
pub inline fn g_return_val_if_reached(val: anytype) -> void {
    g_warn_message(null, __FILE__, __LINE__, __func__, null)
    return val
}
pub inline fn g_warn_if_fail(expr: bool) -> void {
    if !expr { g_warn_message(null, __FILE__, __LINE__, __func__, "expression") }
}
pub inline fn g_warn_if_reached() -> void { g_warn_message(null, __FILE__, __LINE__, __func__, null) }

// Assertions: the program aborts with a message when `expr` is false.
pub inline fn g_assert(expr: bool) -> void {
    if !expr { g_assertion_message_expr(null, __FILE__, __LINE__, __func__, "expression") }
}
pub inline fn g_assert_not_reached() -> void { g_assertion_message_expr(null, __FILE__, __LINE__, __func__, null) }
