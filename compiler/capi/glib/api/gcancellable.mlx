// gio/gcancellable.h
// mlx-glib: GCancellable, a flag an operation checks to stop early (with
// its "cancelled" signal and a descriptor that turns readable).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gmain = @import("./gmain.mlx")
const gtype = @import("./gtype.mlx")
const gclosure = @import("./gclosure.mlx")
const gobject = @import("./gobject.mlx")
const giotypes = @import("./giotypes.mlx")

const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gulong = gtypes.gulong
const GCancellable = giotypes.GCancellable

pub const _GCancellableClass = struct {
    parent_class: gobject.GObjectClass
    cancelled: fn(cancellable: *GCancellable) -> void
    _g_reserved: [5]gpointer
}
pub const GCancellableClass = _GCancellableClass

pub extern("c") fn g_cancellable_get_type() -> gtype.GType
pub extern("c") fn g_cancellable_new() -> *GCancellable
pub extern("c") fn g_cancellable_is_cancelled(cancellable: ?*GCancellable) -> gboolean
pub extern("c") fn g_cancellable_set_error_if_cancelled(cancellable: ?*GCancellable, error_: ?**gerror.GError) -> gboolean
pub extern("c") fn g_cancellable_get_fd(cancellable: ?*GCancellable) -> c_int
pub extern("c") fn g_cancellable_make_pollfd(cancellable: ?*GCancellable, pollfd: *gmain.GPollFD) -> gboolean
pub extern("c") fn g_cancellable_release_fd(cancellable: ?*GCancellable) -> void
pub extern("c") fn g_cancellable_source_new(cancellable: ?*GCancellable) -> *gmain.GSource
pub extern("c") fn g_cancellable_get_current() -> ?*GCancellable
pub extern("c") fn g_cancellable_push_current(cancellable: *GCancellable) -> void
pub extern("c") fn g_cancellable_pop_current(cancellable: *GCancellable) -> void
pub extern("c") fn g_cancellable_reset(cancellable: *GCancellable) -> void
pub extern("c") fn g_cancellable_connect(cancellable: *GCancellable, callback: gclosure.GCallback, data: gpointer, data_destroy_func: gtypes.GDestroyNotify) -> gulong
pub extern("c") fn g_cancellable_disconnect(cancellable: ?*GCancellable, handler_id: gulong) -> void
pub extern("c") fn g_cancellable_cancel(cancellable: ?*GCancellable) -> void

pub const G_TYPE_CANCELLABLE: gtype.GType = g_cancellable_get_type()
pub fn G_CANCELLABLE(o: anytype) -> *GCancellable { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_CANCELLABLE, GCancellable) }
pub fn G_IS_CANCELLABLE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_CANCELLABLE) }
