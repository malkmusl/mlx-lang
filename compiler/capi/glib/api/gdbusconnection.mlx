// gio/gdbusconnection.h
// mlx-glib: D-Bus connections (to an address or a bus: calls, signals
// emitted and subscribed to, objects exported with a vtable), method
// invocations (a call to an exported object and its reply), messages as
// far as an invocation hands one out, owning names on a bus.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gvariant = @import("./gvariant.mlx")
const gvarianttype = @import("./gvarianttype.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")
const gdbus = @import("./gdbus.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gint = gtypes.gint
const guint = gtypes.guint
const guint32 = gtypes.guint32
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GVariant = gvariant.GVariant
const GVariantType = gvarianttype.GVariantType
const GDBusConnection = giotypes.GDBusConnection
const GDBusMethodInvocation = giotypes.GDBusMethodInvocation
const GDBusMessage = giotypes.GDBusMessage
const GDBusAuthObserver = giotypes.GDBusAuthObserver
const GUnixFDList = giotypes.GUnixFDList
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback
const GDBusInterfaceInfo = gdbus.GDBusInterfaceInfo
const GDBusMethodInfo = gdbus.GDBusMethodInfo
const GDBusPropertyInfo = gdbus.GDBusPropertyInfo

pub const GDBusInterfaceMethodCallFunc = fn(connection: *GDBusConnection, sender: [*]const gchar, object_path: [*]const gchar, interface_name: [*]const gchar, method_name: [*]const gchar, parameters: *GVariant, invocation: *GDBusMethodInvocation, user_data: gpointer) -> void
pub const GDBusInterfaceGetPropertyFunc = fn(connection: *GDBusConnection, sender: [*]const gchar, object_path: [*]const gchar, interface_name: [*]const gchar, property_name: [*]const gchar, error_: ?**GError, user_data: gpointer) -> ?*GVariant
pub const GDBusInterfaceSetPropertyFunc = fn(connection: *GDBusConnection, sender: [*]const gchar, object_path: [*]const gchar, interface_name: [*]const gchar, property_name: [*]const gchar, value: *GVariant, error_: ?**GError, user_data: gpointer) -> gboolean

pub const _GDBusInterfaceVTable = struct {
    method_call: ?GDBusInterfaceMethodCallFunc
    get_property: ?GDBusInterfaceGetPropertyFunc
    set_property: ?GDBusInterfaceSetPropertyFunc
    padding: [8]gpointer
}
pub const GDBusInterfaceVTable = _GDBusInterfaceVTable

pub const GDBusSignalCallback = fn(connection: *GDBusConnection, sender_name: ?[*]const gchar, object_path: [*]const gchar, interface_name: [*]const gchar, signal_name: [*]const gchar, parameters: *GVariant, user_data: gpointer) -> void

pub const GBusAcquiredCallback = fn(connection: *GDBusConnection, name: [*]const gchar, user_data: gpointer) -> void
pub const GBusNameAcquiredCallback = fn(connection: *GDBusConnection, name: [*]const gchar, user_data: gpointer) -> void
pub const GBusNameLostCallback = fn(connection: *GDBusConnection, name: [*]const gchar, user_data: gpointer) -> void

pub extern("c") fn g_dbus_connection_get_type() -> gtype.GType
pub extern("c") fn g_dbus_connection_new_for_address(address: [*]const gchar, flags: gioenums.GDBusConnectionFlags, observer: ?*GDBusAuthObserver, cancellable: ?*GCancellable, callback: GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_dbus_connection_new_for_address_finish(res: *GAsyncResult, error_: ?**GError) -> ?*GDBusConnection
pub extern("c") fn g_dbus_connection_new_for_address_sync(address: [*]const gchar, flags: gioenums.GDBusConnectionFlags, observer: ?*GDBusAuthObserver, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GDBusConnection
pub extern("c") fn g_dbus_connection_get_unique_name(connection: *GDBusConnection) -> ?[*]const gchar
pub extern("c") fn g_dbus_connection_get_guid(connection: *GDBusConnection) -> [*]const gchar
pub extern("c") fn g_dbus_connection_get_flags(connection: *GDBusConnection) -> gioenums.GDBusConnectionFlags
pub extern("c") fn g_dbus_connection_get_capabilities(connection: *GDBusConnection) -> gioenums.GDBusCapabilityFlags
pub extern("c") fn g_dbus_connection_get_exit_on_close(connection: *GDBusConnection) -> gboolean
pub extern("c") fn g_dbus_connection_set_exit_on_close(connection: *GDBusConnection, exit_on_close: gboolean) -> void
pub extern("c") fn g_dbus_connection_get_last_serial(connection: *GDBusConnection) -> guint32
pub extern("c") fn g_dbus_connection_is_closed(connection: *GDBusConnection) -> gboolean
pub extern("c") fn g_dbus_connection_close(connection: *GDBusConnection, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_dbus_connection_close_finish(connection: *GDBusConnection, res: *GAsyncResult, error_: ?**GError) -> gboolean
pub extern("c") fn g_dbus_connection_close_sync(connection: *GDBusConnection, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_dbus_connection_flush(connection: *GDBusConnection, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_dbus_connection_flush_finish(connection: *GDBusConnection, res: *GAsyncResult, error_: ?**GError) -> gboolean
pub extern("c") fn g_dbus_connection_flush_sync(connection: *GDBusConnection, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean

pub extern("c") fn g_dbus_connection_call(connection: *GDBusConnection, bus_name: ?[*]const gchar, object_path: [*]const gchar, interface_name: ?[*]const gchar, method_name: [*]const gchar, parameters: ?*GVariant, reply_type: ?*const GVariantType, flags: gioenums.GDBusCallFlags, timeout_msec: gint, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_dbus_connection_call_finish(connection: *GDBusConnection, res: *GAsyncResult, error_: ?**GError) -> ?*GVariant
pub extern("c") fn g_dbus_connection_call_sync(connection: *GDBusConnection, bus_name: ?[*]const gchar, object_path: [*]const gchar, interface_name: ?[*]const gchar, method_name: [*]const gchar, parameters: ?*GVariant, reply_type: ?*const GVariantType, flags: gioenums.GDBusCallFlags, timeout_msec: gint, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GVariant
pub extern("c") fn g_dbus_connection_call_with_unix_fd_list(connection: *GDBusConnection, bus_name: ?[*]const gchar, object_path: [*]const gchar, interface_name: ?[*]const gchar, method_name: [*]const gchar, parameters: ?*GVariant, reply_type: ?*const GVariantType, flags: gioenums.GDBusCallFlags, timeout_msec: gint, fd_list: ?*GUnixFDList, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_dbus_connection_call_with_unix_fd_list_finish(connection: *GDBusConnection, out_fd_list: ?**GUnixFDList, res: *GAsyncResult, error_: ?**GError) -> ?*GVariant
pub extern("c") fn g_dbus_connection_call_with_unix_fd_list_sync(connection: *GDBusConnection, bus_name: ?[*]const gchar, object_path: [*]const gchar, interface_name: ?[*]const gchar, method_name: [*]const gchar, parameters: ?*GVariant, reply_type: ?*const GVariantType, flags: gioenums.GDBusCallFlags, timeout_msec: gint, fd_list: ?*GUnixFDList, out_fd_list: ?**GUnixFDList, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GVariant

pub extern("c") fn g_dbus_connection_emit_signal(connection: *GDBusConnection, destination_bus_name: ?[*]const gchar, object_path: [*]const gchar, interface_name: [*]const gchar, signal_name: [*]const gchar, parameters: ?*GVariant, error_: ?**GError) -> gboolean
pub extern("c") fn g_dbus_connection_signal_subscribe(connection: *GDBusConnection, sender: ?[*]const gchar, interface_name: ?[*]const gchar, member: ?[*]const gchar, object_path: ?[*]const gchar, arg0: ?[*]const gchar, flags: gioenums.GDBusSignalFlags, callback: GDBusSignalCallback, user_data: gpointer, user_data_free_func: ?gtypes.GDestroyNotify) -> guint
pub extern("c") fn g_dbus_connection_signal_unsubscribe(connection: *GDBusConnection, subscription_id: guint) -> void

pub extern("c") fn g_dbus_connection_register_object(connection: *GDBusConnection, object_path: [*]const gchar, interface_info: *GDBusInterfaceInfo, vtable: ?*const GDBusInterfaceVTable, user_data: gpointer, user_data_free_func: ?gtypes.GDestroyNotify, error_: ?**GError) -> guint
pub extern("c") fn g_dbus_connection_unregister_object(connection: *GDBusConnection, registration_id: guint) -> gboolean

pub extern("c") fn g_dbus_method_invocation_get_type() -> gtype.GType
pub extern("c") fn g_dbus_method_invocation_get_sender(invocation: *GDBusMethodInvocation) -> [*]const gchar
pub extern("c") fn g_dbus_method_invocation_get_object_path(invocation: *GDBusMethodInvocation) -> [*]const gchar
pub extern("c") fn g_dbus_method_invocation_get_interface_name(invocation: *GDBusMethodInvocation) -> [*]const gchar
pub extern("c") fn g_dbus_method_invocation_get_method_name(invocation: *GDBusMethodInvocation) -> [*]const gchar
pub extern("c") fn g_dbus_method_invocation_get_method_info(invocation: *GDBusMethodInvocation) -> ?*const GDBusMethodInfo
pub extern("c") fn g_dbus_method_invocation_get_property_info(invocation: *GDBusMethodInvocation) -> ?*const GDBusPropertyInfo
pub extern("c") fn g_dbus_method_invocation_get_connection(invocation: *GDBusMethodInvocation) -> *GDBusConnection
pub extern("c") fn g_dbus_method_invocation_get_message(invocation: *GDBusMethodInvocation) -> *GDBusMessage
pub extern("c") fn g_dbus_method_invocation_get_parameters(invocation: *GDBusMethodInvocation) -> *GVariant
pub extern("c") fn g_dbus_method_invocation_get_user_data(invocation: *GDBusMethodInvocation) -> gpointer
pub extern("c") fn g_dbus_method_invocation_return_value(invocation: *GDBusMethodInvocation, parameters: ?*GVariant) -> void
pub extern("c") fn g_dbus_method_invocation_return_value_with_unix_fd_list(invocation: *GDBusMethodInvocation, parameters: ?*GVariant, fd_list: ?*GUnixFDList) -> void
pub extern("c") fn g_dbus_method_invocation_return_error(invocation: *GDBusMethodInvocation, domain: gquark.GQuark, code: gint, format: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_dbus_method_invocation_return_error_valist(invocation: *GDBusMethodInvocation, domain: gquark.GQuark, code: gint, format: [*]const gchar, var_args: gtypes.c_va_list) -> void
pub extern("c") fn g_dbus_method_invocation_return_error_literal(invocation: *GDBusMethodInvocation, domain: gquark.GQuark, code: gint, message: [*]const gchar) -> void
pub extern("c") fn g_dbus_method_invocation_return_gerror(invocation: *GDBusMethodInvocation, error_: *const GError) -> void
pub extern("c") fn g_dbus_method_invocation_take_error(invocation: *GDBusMethodInvocation, error_: *GError) -> void
pub extern("c") fn g_dbus_method_invocation_return_dbus_error(invocation: *GDBusMethodInvocation, error_name: [*]const gchar, error_message: [*]const gchar) -> void

pub extern("c") fn g_dbus_message_get_type() -> gtype.GType
pub extern("c") fn g_dbus_message_get_message_type(message: *GDBusMessage) -> gioenums.GDBusMessageType
pub extern("c") fn g_dbus_message_get_flags(message: *GDBusMessage) -> gioenums.GDBusMessageFlags
pub extern("c") fn g_dbus_message_get_serial(message: *GDBusMessage) -> guint32
pub extern("c") fn g_dbus_message_get_reply_serial(message: *GDBusMessage) -> guint32
pub extern("c") fn g_dbus_message_get_path(message: *GDBusMessage) -> ?[*]const gchar
pub extern("c") fn g_dbus_message_get_interface(message: *GDBusMessage) -> ?[*]const gchar
pub extern("c") fn g_dbus_message_get_member(message: *GDBusMessage) -> ?[*]const gchar
pub extern("c") fn g_dbus_message_get_error_name(message: *GDBusMessage) -> ?[*]const gchar
pub extern("c") fn g_dbus_message_get_destination(message: *GDBusMessage) -> ?[*]const gchar
pub extern("c") fn g_dbus_message_get_sender(message: *GDBusMessage) -> ?[*]const gchar
pub extern("c") fn g_dbus_message_get_signature(message: *GDBusMessage) -> [*]const gchar
pub extern("c") fn g_dbus_message_get_body(message: *GDBusMessage) -> ?*GVariant
pub extern("c") fn g_dbus_message_get_unix_fd_list(message: *GDBusMessage) -> ?*GUnixFDList
pub extern("c") fn g_dbus_message_get_num_unix_fds(message: *GDBusMessage) -> guint32
pub extern("c") fn g_dbus_message_get_arg0(message: *GDBusMessage) -> ?[*]const gchar
pub extern("c") fn g_dbus_message_get_arg0_path(message: *GDBusMessage) -> ?[*]const gchar

pub extern("c") fn g_bus_own_name(bus_type: gioenums.GBusType, name: [*]const gchar, flags: gioenums.GBusNameOwnerFlags, bus_acquired_handler: ?GBusAcquiredCallback, name_acquired_handler: ?GBusNameAcquiredCallback, name_lost_handler: ?GBusNameLostCallback, user_data: gpointer, user_data_free_func: ?gtypes.GDestroyNotify) -> guint
pub extern("c") fn g_bus_own_name_on_connection(connection: *GDBusConnection, name: [*]const gchar, flags: gioenums.GBusNameOwnerFlags, name_acquired_handler: ?GBusNameAcquiredCallback, name_lost_handler: ?GBusNameLostCallback, user_data: gpointer, user_data_free_func: ?gtypes.GDestroyNotify) -> guint
pub extern("c") fn g_bus_unown_name(owner_id: guint) -> void

pub const G_TYPE_DBUS_CONNECTION: gtype.GType = g_dbus_connection_get_type()
pub fn G_DBUS_CONNECTION(o: anytype) -> *GDBusConnection { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_DBUS_CONNECTION, GDBusConnection) }
pub fn G_IS_DBUS_CONNECTION(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_DBUS_CONNECTION) }
pub const G_TYPE_DBUS_METHOD_INVOCATION: gtype.GType = g_dbus_method_invocation_get_type()
pub fn G_DBUS_METHOD_INVOCATION(o: anytype) -> *GDBusMethodInvocation { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_DBUS_METHOD_INVOCATION, GDBusMethodInvocation) }
pub fn G_IS_DBUS_METHOD_INVOCATION(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_DBUS_METHOD_INVOCATION) }
pub const G_TYPE_DBUS_MESSAGE: gtype.GType = g_dbus_message_get_type()
pub fn G_DBUS_MESSAGE(o: anytype) -> *GDBusMessage { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_DBUS_MESSAGE, GDBusMessage) }
pub fn G_IS_DBUS_MESSAGE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_DBUS_MESSAGE) }
