// glib/goption.h
// mlx-glib: command line options. A context holds groups of option
// entries (the main group's without a prefix, another's also as
// --GROUP-NAME); parsing takes the options out of argv, sets what their
// entries point to and calls their callbacks, and on an error leaves argv
// and every value as they were. --help is not answered (the help text is
// not here): with no entry of that name it is an unknown option.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")

const gchar = gtypes.gchar
const gint = gtypes.gint
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GError = gerror.GError

pub const _GOptionContext = struct {}
pub const GOptionContext = _GOptionContext
pub const _GOptionGroup = struct {}
pub const GOptionGroup = _GOptionGroup

pub const GOptionFlags = enum(c_int) {
    G_OPTION_FLAG_NONE = 0,
    G_OPTION_FLAG_HIDDEN = 1,
    G_OPTION_FLAG_IN_MAIN = 2,
    G_OPTION_FLAG_REVERSE = 4,
    G_OPTION_FLAG_NO_ARG = 8,
    G_OPTION_FLAG_FILENAME = 16,
    G_OPTION_FLAG_OPTIONAL_ARG = 32,
    G_OPTION_FLAG_NOALIAS = 64,
    G_OPTION_FLAG_DEPRECATED = 128,
}

pub const GOptionArg = enum(c_int) {
    G_OPTION_ARG_NONE,
    G_OPTION_ARG_STRING,
    G_OPTION_ARG_INT,
    G_OPTION_ARG_CALLBACK,
    G_OPTION_ARG_FILENAME,
    G_OPTION_ARG_STRING_ARRAY,
    G_OPTION_ARG_FILENAME_ARRAY,
    G_OPTION_ARG_DOUBLE,
    G_OPTION_ARG_INT64,
}

pub const GOptionError = enum(c_int) {
    G_OPTION_ERROR_UNKNOWN_OPTION,
    G_OPTION_ERROR_BAD_VALUE,
    G_OPTION_ERROR_FAILED,
}

pub const G_OPTION_ERROR: gquark.GQuark = g_option_error_quark()

// The long name of the entry that takes the arguments that are no
// options.
pub const G_OPTION_REMAINING: []const u8 = ""

pub const GOptionArgFunc = fn(option_name: [*]const gchar, value: ?[*]const gchar, data: gpointer, error_: ?**GError) -> gboolean
pub const GOptionParseFunc = fn(context: *GOptionContext, group: *GOptionGroup, data: gpointer, error_: ?**GError) -> gboolean
pub const GOptionErrorFunc = fn(context: *GOptionContext, group: *GOptionGroup, data: gpointer, error_: ?**GError) -> void

pub const _GOptionEntry = struct {
    long_name: ?[*]const gchar
    short_name: gchar
    flags: gint
    arg: GOptionArg
    arg_data: gpointer
    description: ?[*]const gchar
    arg_description: ?[*]const gchar
}
pub const GOptionEntry = _GOptionEntry

pub extern("c") fn g_option_error_quark() -> gquark.GQuark

pub extern("c") fn g_option_context_new(parameter_string: ?[*]const gchar) -> *GOptionContext
pub extern("c") fn g_option_context_free(context: *GOptionContext) -> void
pub extern("c") fn g_option_context_set_summary(context: *GOptionContext, summary: ?[*]const gchar) -> void
pub extern("c") fn g_option_context_get_summary(context: *GOptionContext) -> ?[*]const gchar
pub extern("c") fn g_option_context_set_description(context: *GOptionContext, description: ?[*]const gchar) -> void
pub extern("c") fn g_option_context_get_description(context: *GOptionContext) -> ?[*]const gchar
pub extern("c") fn g_option_context_set_help_enabled(context: *GOptionContext, help_enabled: gboolean) -> void
pub extern("c") fn g_option_context_get_help_enabled(context: *GOptionContext) -> gboolean
pub extern("c") fn g_option_context_set_ignore_unknown_options(context: *GOptionContext, ignore_unknown: gboolean) -> void
pub extern("c") fn g_option_context_get_ignore_unknown_options(context: *GOptionContext) -> gboolean
pub extern("c") fn g_option_context_set_strict_posix(context: *GOptionContext, strict_posix: gboolean) -> void
pub extern("c") fn g_option_context_get_strict_posix(context: *GOptionContext) -> gboolean
pub extern("c") fn g_option_context_set_translate_func(context: *GOptionContext, func: ?gtypes.GTranslateFunc, data: gpointer, destroy_notify: ?gtypes.GDestroyNotify) -> void
pub extern("c") fn g_option_context_set_translation_domain(context: *GOptionContext, domain: ?[*]const gchar) -> void
pub extern("c") fn g_option_context_add_main_entries(context: *GOptionContext, entries: [*]const GOptionEntry, translation_domain: ?[*]const gchar) -> void
pub extern("c") fn g_option_context_add_group(context: *GOptionContext, group: *GOptionGroup) -> void
pub extern("c") fn g_option_context_set_main_group(context: *GOptionContext, group: *GOptionGroup) -> void
pub extern("c") fn g_option_context_get_main_group(context: *GOptionContext) -> ?*GOptionGroup
pub extern("c") fn g_option_context_parse(context: *GOptionContext, argc: ?*gint, argv: ?*[*][*]gchar, error_: ?**GError) -> gboolean
pub extern("c") fn g_option_context_parse_strv(context: *GOptionContext, arguments: ?*[*][*]gchar, error_: ?**GError) -> gboolean

pub extern("c") fn g_option_group_new(name: [*]const gchar, description: [*]const gchar, help_description: [*]const gchar, user_data: gpointer, destroy: ?gtypes.GDestroyNotify) -> *GOptionGroup
pub extern("c") fn g_option_group_ref(group: *GOptionGroup) -> *GOptionGroup
pub extern("c") fn g_option_group_unref(group: *GOptionGroup) -> void
pub extern("c") fn g_option_group_free(group: *GOptionGroup) -> void
pub extern("c") fn g_option_group_add_entries(group: *GOptionGroup, entries: [*]const GOptionEntry) -> void
pub extern("c") fn g_option_group_set_parse_hooks(group: *GOptionGroup, pre_parse_func: ?GOptionParseFunc, post_parse_func: ?GOptionParseFunc) -> void
pub extern("c") fn g_option_group_set_error_hook(group: *GOptionGroup, error_func: ?GOptionErrorFunc) -> void
pub extern("c") fn g_option_group_set_translate_func(group: *GOptionGroup, func: ?gtypes.GTranslateFunc, data: gpointer, destroy_notify: ?gtypes.GDestroyNotify) -> void
pub extern("c") fn g_option_group_set_translation_domain(group: *GOptionGroup, domain: ?[*]const gchar) -> void

// (C the header has as it is: the entry that ends a list.)
const c_macros = "#define G_OPTION_ENTRY_NULL { NULL, 0, 0, (GOptionArg) 0, NULL, NULL, NULL }"
