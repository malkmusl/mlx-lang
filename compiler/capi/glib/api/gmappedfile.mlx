// glib/gmappedfile.h
// mlx-glib: files mapped into memory (mmap), counted references.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gbytes = @import("./gbytes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean

pub const _GMappedFile = struct {}
pub const GMappedFile = _GMappedFile

pub extern("c") fn g_mapped_file_new(filename: [*]const gchar, writable: gboolean, error_: ?**gerror.GError) -> ?*GMappedFile
pub extern("c") fn g_mapped_file_new_from_fd(fd: gtypes.gint, writable: gboolean, error_: ?**gerror.GError) -> ?*GMappedFile
pub extern("c") fn g_mapped_file_get_length(file: *GMappedFile) -> gtypes.gsize
pub extern("c") fn g_mapped_file_get_contents(file: *GMappedFile) -> ?[*]gchar
pub extern("c") fn g_mapped_file_get_bytes(file: *GMappedFile) -> *gbytes.GBytes
pub extern("c") fn g_mapped_file_ref(file: *GMappedFile) -> *GMappedFile
pub extern("c") fn g_mapped_file_unref(file: *GMappedFile) -> void
pub extern("c") fn g_mapped_file_free(file: *GMappedFile) -> void
