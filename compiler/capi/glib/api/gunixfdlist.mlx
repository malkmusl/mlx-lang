// gio/gunixfdlist.h
// mlx-glib: GUnixFDList, the file descriptors a D-Bus message carries
// (owned by the list: appended ones are duplicated, gotten ones handed
// out as duplicates).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")
const gio = @import("./gio.mlx")

const gint = gtypes.gint
const GUnixFDList = giotypes.GUnixFDList

pub extern("c") fn g_unix_fd_list_get_type() -> gtype.GType
pub extern("c") fn g_unix_fd_list_new() -> *GUnixFDList
pub extern("c") fn g_unix_fd_list_new_from_array(fds: [*]const gint, n_fds: gint) -> *GUnixFDList
pub extern("c") fn g_unix_fd_list_append(list: *GUnixFDList, fd: gint, error_: ?**gerror.GError) -> gint
pub extern("c") fn g_unix_fd_list_get(list: *GUnixFDList, index_: gint, error_: ?**gerror.GError) -> gint
pub extern("c") fn g_unix_fd_list_get_length(list: *GUnixFDList) -> gint
pub extern("c") fn g_unix_fd_list_peek_fds(list: *GUnixFDList, length: ?*gint) -> [*]const gint
pub extern("c") fn g_unix_fd_list_steal_fds(list: *GUnixFDList, length: ?*gint) -> [*]gint

pub const G_TYPE_UNIX_FD_LIST: gtype.GType = g_unix_fd_list_get_type()
pub fn G_UNIX_FD_LIST(o: anytype) -> *GUnixFDList { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_UNIX_FD_LIST, GUnixFDList) }
pub fn G_IS_UNIX_FD_LIST(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_UNIX_FD_LIST) }
