// gobject/gvaluecollector.h
// mlx-glib: collecting values from a function's variable arguments (a
// va_list) by the value table of their type: its collect format says
// which arguments to read (i, l, q, d, p), its collect_value makes the
// value of them. For the implementations of variadic functions taking
// values (g_object_new's kind); not included by glib-object.h.
const c_system_headers = "stdarg.h string.h"
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gvalue = @import("./gvalue.mlx")

const gchar = gtypes.gchar

pub const G_VALUE_COLLECT_INT: gchar = 'i'
pub const G_VALUE_COLLECT_LONG: gchar = 'l'
pub const G_VALUE_COLLECT_INT64: gchar = 'q'
pub const G_VALUE_COLLECT_DOUBLE: gchar = 'd'
pub const G_VALUE_COLLECT_POINTER: gchar = 'p'

// (C the header has as it is: GTypeCValue, a union Mlx has no tag for
// here, and the macros, which read va_arg.)
const c_macros = "#define G_VALUE_COLLECT_FORMAT_MAX_LENGTH (8)\ntypedef union _GTypeCValue {\n    gint v_int;\n    glong v_long;\n    gint64 v_int64;\n    gdouble v_double;\n    gpointer v_pointer;\n} GTypeCValue;\n#define G_VALUE_COLLECT_INIT2(value, g_vci_vtab, _value_type, var_args, flags, __error) \\\nG_STMT_START { \\\n    GValue *g_vci_val = (value); \\\n    guint g_vci_flags = (flags); \\\n    const gchar *g_vci_format = (g_vci_vtab)->collect_format; \\\n    GTypeCValue g_vci_cvalues[G_VALUE_COLLECT_FORMAT_MAX_LENGTH]; \\\n    guint g_vci_n = 0; \\\n    memset(g_vci_cvalues, 0, sizeof g_vci_cvalues); \\\n    g_vci_val->g_type = (_value_type); \\\n    memset(g_vci_val->data, 0, sizeof g_vci_val->data); \\\n    while (*g_vci_format) { \\\n        GTypeCValue *g_vci_cvalue = g_vci_cvalues + g_vci_n++; \\\n        switch (*g_vci_format++) { \\\n        case G_VALUE_COLLECT_INT: g_vci_cvalue->v_int = va_arg((var_args), gint); break; \\\n        case G_VALUE_COLLECT_LONG: g_vci_cvalue->v_long = va_arg((var_args), glong); break; \\\n        case G_VALUE_COLLECT_INT64: g_vci_cvalue->v_int64 = va_arg((var_args), gint64); break; \\\n        case G_VALUE_COLLECT_DOUBLE: g_vci_cvalue->v_double = va_arg((var_args), gdouble); break; \\\n        case G_VALUE_COLLECT_POINTER: g_vci_cvalue->v_pointer = va_arg((var_args), gpointer); break; \\\n        default: break; \\\n        } \\\n    } \\\n    *(__error) = (g_vci_vtab)->collect_value(g_vci_val, g_vci_n, g_vci_cvalues, g_vci_flags); \\\n} G_STMT_END\n#define G_VALUE_COLLECT_INIT(value, _value_type, var_args, flags, __error) \\\nG_STMT_START { \\\n    GTypeValueTable *g_vci_vtab_ = g_type_value_table_peek(_value_type); \\\n    G_VALUE_COLLECT_INIT2(value, g_vci_vtab_, _value_type, var_args, flags, __error); \\\n} G_STMT_END\n#define G_VALUE_COLLECT(value, var_args, flags, __error) \\\nG_STMT_START { \\\n    GValue *g_vc_value = (value); \\\n    GType g_vc_type = G_VALUE_TYPE(g_vc_value); \\\n    GTypeValueTable *g_vc_vtab = g_type_value_table_peek(g_vc_type); \\\n    if (g_vc_vtab->value_free) g_vc_vtab->value_free(g_vc_value); \\\n    G_VALUE_COLLECT_INIT2(g_vc_value, g_vc_vtab, g_vc_type, var_args, flags, __error); \\\n} G_STMT_END\n#define G_VALUE_COLLECT_SKIP(_value_type, var_args) \\\nG_STMT_START { \\\n    GTypeValueTable *g_vcs_vtab = g_type_value_table_peek(_value_type); \\\n    const gchar *g_vcs_format = g_vcs_vtab->collect_format; \\\n    while (*g_vcs_format) { \\\n        switch (*g_vcs_format++) { \\\n        case G_VALUE_COLLECT_INT: (void) va_arg((var_args), gint); break; \\\n        case G_VALUE_COLLECT_LONG: (void) va_arg((var_args), glong); break; \\\n        case G_VALUE_COLLECT_INT64: (void) va_arg((var_args), gint64); break; \\\n        case G_VALUE_COLLECT_DOUBLE: (void) va_arg((var_args), gdouble); break; \\\n        case G_VALUE_COLLECT_POINTER: (void) va_arg((var_args), gpointer); break; \\\n        default: break; \\\n        } \\\n    } \\\n} G_STMT_END\n#define G_VALUE_LCOPY(value, var_args, flags, __error) \\\nG_STMT_START { \\\n    const GValue *g_vl_value = (value); \\\n    guint g_vl_flags = (flags); \\\n    GType g_vl_type = G_VALUE_TYPE(g_vl_value); \\\n    GTypeValueTable *g_vl_vtab = g_type_value_table_peek(g_vl_type); \\\n    const gchar *g_vl_format = g_vl_vtab->lcopy_format; \\\n    GTypeCValue g_vl_cvalues[G_VALUE_COLLECT_FORMAT_MAX_LENGTH]; \\\n    guint g_vl_n = 0; \\\n    memset(g_vl_cvalues, 0, sizeof g_vl_cvalues); \\\n    while (*g_vl_format) { \\\n        GTypeCValue *g_vl_cvalue = g_vl_cvalues + g_vl_n++; \\\n        g_vl_format++; \\\n        g_vl_cvalue->v_pointer = va_arg((var_args), gpointer); \\\n    } \\\n    *(__error) = g_vl_vtab->lcopy_value(g_vl_value, g_vl_n, g_vl_cvalues, g_vl_flags); \\\n} G_STMT_END"
