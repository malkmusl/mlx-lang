// gio/gfile.h
// mlx-glib: GFile, a file named by a path (local files: the file:// URIs
// and paths of this system), and the monitoring of one (GFileMonitor,
// on inotify: "changed" is emitted in the main context the monitor was
// made in).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gbytes = @import("./gbytes.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")
const gfileinputstream = @import("./gfileinputstream.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gint = gtypes.gint
const gsize = gtypes.gsize
const guint = gtypes.guint
const GError = gerror.GError
const GFile = giotypes.GFile
const GFileMonitor = giotypes.GFileMonitor
const GCancellable = giotypes.GCancellable

pub const _GFileMonitorClass = struct {
    parent_class: gobject.GObjectClass
    changed: fn(monitor: *GFileMonitor, file: *GFile, other_file: ?*GFile, event_type: gioenums.GFileMonitorEvent) -> void
    cancel: fn(monitor: *GFileMonitor) -> gboolean
    _g_reserved: [5]gpointer
}
pub const GFileMonitorClass = _GFileMonitorClass

pub extern("c") fn g_file_get_type() -> gtype.GType
pub extern("c") fn g_file_new_for_path(path: [*]const c_char) -> *GFile
pub extern("c") fn g_file_new_for_uri(uri: [*]const c_char) -> *GFile
pub extern("c") fn g_file_new_for_commandline_arg(arg: [*]const c_char) -> *GFile
pub extern("c") fn g_file_new_build_filename(first_element: [*]const gchar, args: gtypes.c_varargs) -> *GFile
pub extern("c") fn g_file_parse_name(parse_name: [*]const c_char) -> *GFile
pub extern("c") fn g_file_dup(file: *GFile) -> *GFile
pub extern("c") fn g_file_hash(file: gtypes.gconstpointer) -> guint
pub extern("c") fn g_file_equal(file1: *GFile, file2: *GFile) -> gboolean
pub extern("c") fn g_file_get_basename(file: *GFile) -> ?[*]c_char
pub extern("c") fn g_file_get_path(file: *GFile) -> ?[*]c_char
pub extern("c") fn g_file_peek_path(file: *GFile) -> ?[*]const c_char
pub extern("c") fn g_file_get_uri(file: *GFile) -> [*]c_char
pub extern("c") fn g_file_get_parse_name(file: *GFile) -> [*]c_char
pub extern("c") fn g_file_get_parent(file: *GFile) -> ?*GFile
pub extern("c") fn g_file_has_parent(file: *GFile, parent: ?*GFile) -> gboolean
pub extern("c") fn g_file_get_child(file: *GFile, name: [*]const c_char) -> *GFile
pub extern("c") fn g_file_resolve_relative_path(file: *GFile, relative_path: [*]const c_char) -> *GFile
pub extern("c") fn g_file_has_prefix(file: *GFile, prefix: *GFile) -> gboolean
pub extern("c") fn g_file_get_relative_path(parent: *GFile, descendant: *GFile) -> ?[*]c_char
pub extern("c") fn g_file_is_native(file: *GFile) -> gboolean
pub extern("c") fn g_file_has_uri_scheme(file: *GFile, uri_scheme: [*]const c_char) -> gboolean
pub extern("c") fn g_file_get_uri_scheme(file: *GFile) -> ?[*]c_char
pub extern("c") fn g_file_query_exists(file: *GFile, cancellable: ?*GCancellable) -> gboolean
pub extern("c") fn g_file_query_file_type(file: *GFile, flags: gioenums.GFileQueryInfoFlags, cancellable: ?*GCancellable) -> gioenums.GFileType
pub extern("c") fn g_file_load_contents(file: *GFile, cancellable: ?*GCancellable, contents: *[*]c_char, length: ?*gsize, etag_out: ?*[*]c_char, error_: ?**GError) -> gboolean
pub extern("c") fn g_file_load_bytes(file: *GFile, cancellable: ?*GCancellable, etag_out: ?*[*]gchar, error_: ?**GError) -> ?*gbytes.GBytes
pub extern("c") fn g_file_read(file: *GFile, cancellable: ?*GCancellable, error_: ?**GError) -> ?*gfileinputstream.GFileInputStream
pub extern("c") fn g_file_read_async(file: *GFile, io_priority: c_int, cancellable: ?*GCancellable, callback: ?giotypes.GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_file_read_finish(file: *GFile, res: *giotypes.GAsyncResult, error_: ?**GError) -> ?*gfileinputstream.GFileInputStream
pub extern("c") fn g_file_replace_contents(file: *GFile, contents: [*]const c_char, length: gsize, etag: ?[*]const c_char, make_backup: gboolean, flags: gioenums.GFileCreateFlags, new_etag: ?*[*]c_char, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_file_delete(file: *GFile, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_file_make_directory(file: *GFile, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_file_make_directory_with_parents(file: *GFile, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_file_monitor_directory(file: *GFile, flags: gioenums.GFileMonitorFlags, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GFileMonitor
pub extern("c") fn g_file_monitor_file(file: *GFile, flags: gioenums.GFileMonitorFlags, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GFileMonitor
pub extern("c") fn g_file_monitor(file: *GFile, flags: gioenums.GFileMonitorFlags, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GFileMonitor

pub extern("c") fn g_file_monitor_get_type() -> gtype.GType
pub extern("c") fn g_file_monitor_cancel(monitor: *GFileMonitor) -> gboolean
pub extern("c") fn g_file_monitor_is_cancelled(monitor: *GFileMonitor) -> gboolean
pub extern("c") fn g_file_monitor_set_rate_limit(monitor: *GFileMonitor, limit_msecs: gint) -> void
pub extern("c") fn g_file_monitor_emit_event(monitor: *GFileMonitor, child: *GFile, other_file: ?*GFile, event_type: gioenums.GFileMonitorEvent) -> void

pub const G_TYPE_FILE: gtype.GType = g_file_get_type()
pub const G_TYPE_FILE_MONITOR: gtype.GType = g_file_monitor_get_type()
pub fn G_FILE(o: anytype) -> *GFile { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_FILE, GFile) }
pub fn G_IS_FILE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_FILE) }
pub fn G_FILE_MONITOR(o: anytype) -> *GFileMonitor { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_FILE_MONITOR, GFileMonitor) }
pub fn G_IS_FILE_MONITOR(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_FILE_MONITOR) }
