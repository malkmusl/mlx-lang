// glib/gatomic.h
// mlx-glib: atomic operations on integers and pointers (sequentially
// consistent, as GLib's are).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gint = gtypes.gint
const guint = gtypes.guint
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gssize = gtypes.gssize
const gsize = gtypes.gsize

pub extern("c") fn g_atomic_int_get(atomic: *const gint) -> gint
pub extern("c") fn g_atomic_int_set(atomic: *gint, newval: gint) -> void
pub extern("c") fn g_atomic_int_inc(atomic: *gint) -> void
pub extern("c") fn g_atomic_int_dec_and_test(atomic: *gint) -> gboolean
pub extern("c") fn g_atomic_int_compare_and_exchange(atomic: *gint, oldval: gint, newval: gint) -> gboolean
pub extern("c") fn g_atomic_int_exchange(atomic: *gint, newval: gint) -> gint
pub extern("c") fn g_atomic_int_add(atomic: *gint, val: gint) -> gint
pub extern("c") fn g_atomic_int_and(atomic: *guint, val: guint) -> guint
pub extern("c") fn g_atomic_int_or(atomic: *guint, val: guint) -> guint
pub extern("c") fn g_atomic_int_xor(atomic: *guint, val: guint) -> guint
pub extern("c") fn g_atomic_pointer_get(atomic: *const anyopaque) -> gpointer
pub extern("c") fn g_atomic_pointer_set(atomic: *anyopaque, newval: gpointer) -> void
pub extern("c") fn g_atomic_pointer_compare_and_exchange(atomic: *anyopaque, oldval: gpointer, newval: gpointer) -> gboolean
pub extern("c") fn g_atomic_pointer_exchange(atomic: *anyopaque, newval: gpointer) -> gpointer
pub extern("c") fn g_atomic_pointer_add(atomic: *anyopaque, val: gssize) -> gssize
pub extern("c") fn g_atomic_pointer_and(atomic: *anyopaque, val: gsize) -> gsize
pub extern("c") fn g_atomic_pointer_or(atomic: *anyopaque, val: gsize) -> gsize

pub extern("c") fn g_atomic_ref_count_init(arc: *gtypes.gatomicrefcount) -> void
pub extern("c") fn g_atomic_ref_count_inc(arc: *gtypes.gatomicrefcount) -> void
pub extern("c") fn g_atomic_ref_count_dec(arc: *gtypes.gatomicrefcount) -> gboolean
pub extern("c") fn g_atomic_ref_count_compare(arc: *gtypes.gatomicrefcount, val: gint) -> gboolean
pub extern("c") fn g_ref_count_init(rc: *gtypes.grefcount) -> void
pub extern("c") fn g_ref_count_inc(rc: *gtypes.grefcount) -> void
pub extern("c") fn g_ref_count_dec(rc: *gtypes.grefcount) -> gboolean
pub extern("c") fn g_ref_count_compare(rc: *gtypes.grefcount, val: gint) -> gboolean
