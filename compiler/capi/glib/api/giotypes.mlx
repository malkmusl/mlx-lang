pub const GAsyncReadyCallback = fn(source_object: ?*GObject, res: *GAsyncResult, data: gpointer) -> void
pub const GSocketSourceFunc = fn(socket: *GSocket, condition: gmain.GIOCondition, data: gpointer) -> gboolean
pub const GCancellableSourceFunc = fn(cancellable: ?*GCancellable, data: gpointer) -> gboolean
pub const GFileProgressCallback = fn(current_num_bytes: gtypes.goffset, total_num_bytes: gtypes.goffset, data: gpointer) -> void
