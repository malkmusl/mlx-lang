pub const _GFilterInputStream = struct {
    parent_instance: GInputStream
    base_stream: *GInputStream
}
pub const GFilterInputStream = _GFilterInputStream

// The classes of an input stream and of a filter over one, as GIO lays
// them out (a subclass's class begins with them: libsoup's
// SoupMultipartInputStream is a GFilterInputStream). The streams' own
// functions are not here yet.
pub const _GInputStreamClass = struct {
    parent_class: gobject.GObjectClass
    read_fn: ?fn(stream: *GInputStream, buffer: ?*anyopaque, count: gtypes.gsize, cancellable: ?*GCancellable, error_: ?**gerror.GError) -> gtypes.gssize
    skip: ?fn(stream: *GInputStream, count: gtypes.gsize, cancellable: ?*GCancellable, error_: ?**gerror.GError) -> gtypes.gssize
    close_fn: ?fn(stream: *GInputStream, cancellable: ?*GCancellable, error_: ?**gerror.GError) -> gboolean
    read_async: ?fn(stream: *GInputStream, buffer: ?*anyopaque, count: gtypes.gsize, io_priority: gtypes.gint, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    read_finish: ?fn(stream: *GInputStream, result: *GAsyncResult, error_: ?**gerror.GError) -> gtypes.gssize
    skip_async: ?fn(stream: *GInputStream, count: gtypes.gsize, io_priority: gtypes.gint, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    skip_finish: ?fn(stream: *GInputStream, result: *GAsyncResult, error_: ?**gerror.GError) -> gtypes.gssize
    close_async: ?fn(stream: *GInputStream, io_priority: gtypes.gint, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    close_finish: ?fn(stream: *GInputStream, result: *GAsyncResult, error_: ?**gerror.GError) -> gboolean
    _g_reserved: [5]gpointer
}
pub const GInputStreamClass = _GInputStreamClass

pub const _GFilterInputStreamClass = struct {
    parent_class: GInputStreamClass
    _g_reserved: [3]gpointer
}
pub const GFilterInputStreamClass = _GFilterInputStreamClass

