    priv: *GOutputStreamPrivate
}
pub const GOutputStream = _GOutputStream

pub const _GIOStreamPrivate = struct {}
pub const GIOStreamPrivate = _GIOStreamPrivate
pub const _GIOStream = struct {
    parent_instance: GObject
    priv: *GIOStreamPrivate
}
pub const GIOStream = _GIOStream

pub const _GSocketPrivate = struct {}
pub const GSocketPrivate = _GSocketPrivate
pub const _GSocket = struct {
