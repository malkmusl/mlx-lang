// gio/giotypes.h
// mlx-glib: GIO's types: its objects (an instance is its parent's and a
// private part, as in GIO) and the callbacks of its operations.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gmain = @import("./gmain.mlx")
const gobject = @import("./gobject.mlx")
const gerror = @import("./gerror.mlx")

const gpointer = gtypes.gpointer
const gboolean = gtypes.gboolean
const GObject = gobject.GObject

pub const _GAsyncResult = struct {}
pub const GAsyncResult = _GAsyncResult
pub const _GFile = struct {}
pub const GFile = _GFile
pub const _GTask = struct {}
pub const GTask = _GTask
pub const _GResource = struct {}
pub const GResource = _GResource
pub const _GDBusConnection = struct {}
pub const GDBusConnection = _GDBusConnection
pub const _GSocketAddress = struct {}
pub const GSocketAddress = _GSocketAddress
pub const _GFileInfo = struct {}
pub const GFileInfo = _GFileInfo
pub const _GInitable = struct {}
pub const GInitable = _GInitable
pub const _GProxyResolver = struct {}
pub const GProxyResolver = _GProxyResolver
pub const _GTlsBackend = struct {}
pub const GTlsBackend = _GTlsBackend
pub const _GTlsClientConnection = struct {}
pub const GTlsClientConnection = _GTlsClientConnection
pub const _GTlsFileDatabase = struct {}
pub const GTlsFileDatabase = _GTlsFileDatabase

pub const _GCancellablePrivate = struct {}
pub const GCancellablePrivate = _GCancellablePrivate
pub const _GCancellable = struct {
    parent_instance: GObject
    priv: *GCancellablePrivate
}
pub const GCancellable = _GCancellable

pub const _GFileMonitorPrivate = struct {}
pub const GFileMonitorPrivate = _GFileMonitorPrivate
pub const _GFileMonitor = struct {
