// glib-unix.h
// mlx-glib: what GLib has for Unix alone: descriptor sources, pipes and
// non-blocking descriptors, signal sources.
const c_function_pointers = true
const c_system_headers = "unistd.h errno.h sys/wait.h stdlib.h fcntl.h"
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")
const gmain = @import("./gmain.mlx")

const gint = gtypes.gint
const guint = gtypes.guint
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GError = gerror.GError

pub const GUnixFDSourceFunc = fn(fd: gint, condition: gmain.GIOCondition, user_data: gpointer) -> gboolean

pub const G_UNIX_ERROR: gquark.GQuark = g_unix_error_quark()

pub extern("c") fn g_unix_error_quark() -> gquark.GQuark
pub extern("c") fn g_unix_open_pipe(fds: *gint, flags: gint, error_: ?**GError) -> gboolean
pub extern("c") fn g_unix_set_fd_nonblocking(fd: gint, nonblock: gboolean, error_: ?**GError) -> gboolean
pub extern("c") fn g_unix_fd_source_new(fd: gint, condition: gmain.GIOCondition) -> *gmain.GSource
pub extern("c") fn g_unix_fd_add_full(priority: gint, fd: gint, condition: gmain.GIOCondition, function: GUnixFDSourceFunc, user_data: gpointer, notify: gtypes.GDestroyNotify) -> guint
pub extern("c") fn g_unix_fd_add(fd: gint, condition: gmain.GIOCondition, function: GUnixFDSourceFunc, user_data: gpointer) -> guint
pub extern("c") fn g_unix_signal_source_new(signum: gint) -> *gmain.GSource
pub extern("c") fn g_unix_signal_add_full(priority: gint, signum: gint, handler: gmain.GSourceFunc, user_data: gpointer, notify: gtypes.GDestroyNotify) -> guint
pub extern("c") fn g_unix_signal_add(signum: gint, handler: gmain.GSourceFunc, user_data: gpointer) -> guint
