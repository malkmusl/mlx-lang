pub extern("c") fn g_file_info_get_attribute_boolean(info: *GFileInfo, attribute: [*]const gchar) -> gboolean
pub extern("c") fn g_file_info_get_attribute_uint32(info: *GFileInfo, attribute: [*]const gchar) -> guint32
pub extern("c") fn g_file_info_get_attribute_int32(info: *GFileInfo, attribute: [*]const gchar) -> gint32
pub extern("c") fn g_file_info_get_attribute_uint64(info: *GFileInfo, attribute: [*]const gchar) -> guint64
pub extern("c") fn g_file_info_get_attribute_int64(info: *GFileInfo, attribute: [*]const gchar) -> gint64
