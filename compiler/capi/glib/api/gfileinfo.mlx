pub extern("c") fn g_file_attribute_matcher_matches(matcher: *GFileAttributeMatcher, attribute: [*]const gchar) -> gboolean
pub extern("c") fn g_file_attribute_matcher_matches_only(matcher: *GFileAttributeMatcher, attribute: [*]const gchar) -> gboolean
pub extern("c") fn g_file_attribute_matcher_enumerate_namespace(matcher: *GFileAttributeMatcher, ns: [*]const gchar) -> gboolean
pub extern("c") fn g_file_attribute_matcher_enumerate_next(matcher: *GFileAttributeMatcher) -> ?[*]const gchar
pub extern("c") fn g_file_attribute_matcher_to_string(matcher: ?*GFileAttributeMatcher) -> ?[*]gchar

pub const G_TYPE_FILE_INFO: gtype.GType = g_file_info_get_type()
pub fn G_FILE_INFO(o: anytype) -> *GFileInfo { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_FILE_INFO, GFileInfo) }
pub fn G_IS_FILE_INFO(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_FILE_INFO) }
pub const G_TYPE_FILE_ATTRIBUTE_MATCHER: gtype.GType = g_file_attribute_matcher_get_type()
