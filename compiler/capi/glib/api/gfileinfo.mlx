pub extern("c") fn g_file_info_get_attribute_stringv(info: *GFileInfo, attribute: [*]const gchar) -> ?[*]?[*]gchar
pub extern("c") fn g_file_info_set_attribute_string(info: *GFileInfo, attribute: [*]const gchar, attr_value: [*]const gchar) -> void
