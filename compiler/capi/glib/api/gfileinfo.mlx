pub extern("c") fn g_file_attribute_matcher_get_type() -> gtype.GType
pub extern("c") fn g_file_attribute_matcher_new(attributes: [*]const gchar) -> *GFileAttributeMatcher
pub extern("c") fn g_file_attribute_matcher_ref(matcher: *GFileAttributeMatcher) -> *GFileAttributeMatcher
pub extern("c") fn g_file_attribute_matcher_unref(matcher: *GFileAttributeMatcher) -> void
