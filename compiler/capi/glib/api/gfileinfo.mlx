// gio/gfileinfo.h
// mlx-glib: GFileInfo, a file's attributes by name ("standard::size",
// "time::modified"...), each of a type (strings, byte strings, booleans,
// 32- and 64-bit integers, objects, string arrays) and a status, with
// GIO's getters and setters of the common ones; GFileAttributeMatcher,
// the lists of attributes ("standard::*,time::modified") a query asks
// for. g_file_query_info and g_file_input_stream_query_info give them for
// the files of this system (gfile.h, gfileinputstream.h).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gdatetime = @import("./gdatetime.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gint = gtypes.gint
const guint32 = gtypes.guint32
const gint32 = gtypes.gint32
const guint64 = gtypes.guint64
const gint64 = gtypes.gint64
const goffset = gtypes.goffset
const GObject = gobject.GObject
const GDateTime = gdatetime.GDateTime
const GFileInfo = giotypes.GFileInfo
const GFileType = gioenums.GFileType

pub const _GFileInfoClass = struct {}
pub const GFileInfoClass = _GFileInfoClass
pub const _GFileAttributeMatcher = struct {}
pub const GFileAttributeMatcher = _GFileAttributeMatcher

pub const GFileAttributeType = enum(c_int) {
    G_FILE_ATTRIBUTE_TYPE_INVALID = 0,
    G_FILE_ATTRIBUTE_TYPE_STRING = 1,
    G_FILE_ATTRIBUTE_TYPE_BYTE_STRING = 2,
    G_FILE_ATTRIBUTE_TYPE_BOOLEAN = 3,
    G_FILE_ATTRIBUTE_TYPE_UINT32 = 4,
    G_FILE_ATTRIBUTE_TYPE_INT32 = 5,
    G_FILE_ATTRIBUTE_TYPE_UINT64 = 6,
    G_FILE_ATTRIBUTE_TYPE_INT64 = 7,
    G_FILE_ATTRIBUTE_TYPE_OBJECT = 8,
    G_FILE_ATTRIBUTE_TYPE_STRINGV = 9,
}

pub const GFileAttributeStatus = enum(c_int) {
    G_FILE_ATTRIBUTE_STATUS_UNSET = 0,
    G_FILE_ATTRIBUTE_STATUS_SET = 1,
    G_FILE_ATTRIBUTE_STATUS_ERROR_SETTING = 2,
}

