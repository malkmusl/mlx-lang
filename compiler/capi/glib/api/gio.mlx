// gio/gio.h
// mlx-glib: GIO's C API (2.80) as far as WebKit's base library uses it:
// cancellables, asynchronous results and tasks, local files and their
// monitors, input and output streams (filters, memory, pollable and
// socket streams), sockets and socket connections, inet addresses, listeners,
// services and clients, resources, the default
// application, D-Bus proxies (whose buses are not there yet), GInitable,
// and the TLS types libsoup's and WebKit's headers name (certificates,
// passwords, the backend; TLS connections themselves are not there yet).
