// gio/gsocketlistener.h
// mlx-glib: GSocketListener, the listening sockets of addresses added to
// it.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const guint8 = gtypes.guint8
const guint16 = gtypes.guint16
const guint32 = gtypes.guint32
const gint = gtypes.gint
const guint = gtypes.guint
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GObject = gobject.GObject
const GCancellable = giotypes.GCancellable
const GSocketAddress = giotypes.GSocketAddress
const GSocketConnection = giotypes.GSocketConnection
const GSocket = giotypes.GSocket
const GAsyncResult = giotypes.GAsyncResult

pub const _GSocketListener = struct {}
pub const GSocketListener = _GSocketListener

pub extern("c") fn g_socket_listener_get_type() -> gtype.GType
pub extern("c") fn g_socket_listener_new() -> *GSocketListener
pub extern("c") fn g_socket_listener_set_backlog(listener: *GSocketListener, listen_backlog: gint) -> void
pub extern("c") fn g_socket_listener_add_address(listener: *GSocketListener, address: *GSocketAddress, type_: gioenums.GSocketType, protocol: gioenums.GSocketProtocol, source_object: ?*GObject, effective_address: ?**GSocketAddress, error_: ?**GError) -> gboolean
pub extern("c") fn g_socket_listener_add_inet_port(listener: *GSocketListener, port: guint16, source_object: ?*GObject, error_: ?**GError) -> gboolean
pub extern("c") fn g_socket_listener_accept(listener: *GSocketListener, source_object: ?**GObject, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GSocketConnection
pub extern("c") fn g_socket_listener_close(listener: *GSocketListener) -> void

pub const G_TYPE_SOCKET_LISTENER: gtype.GType = g_socket_listener_get_type()
pub fn G_SOCKET_LISTENER(o: anytype) -> *GSocketListener { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_SOCKET_LISTENER, GSocketListener) }
pub fn G_IS_SOCKET_LISTENER(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_SOCKET_LISTENER) }
