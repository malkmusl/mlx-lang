// gio/gdbusproxy.h
// mlx-glib: D-Bus's proxies (an object of a connection seen through one
// interface: its calls, signals, cached properties and name owner), the
// introspection data (parsed from XML and written back), D-Bus's errors
// and their mapping to GErrors, names' syntax, the buses' addresses.
// Connections, method invocations and name owning are
// gdbusconnection.h's.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gvariant = @import("./gvariant.mlx")
const gvarianttype = @import("./gvarianttype.mlx")
const gstring = @import("./gstring.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gint = gtypes.gint
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GVariant = gvariant.GVariant
const GDBusProxy = giotypes.GDBusProxy
const GDBusConnection = giotypes.GDBusConnection
const GCancellable = giotypes.GCancellable

pub const _GDBusAnnotationInfo = struct {
    ref_count: gint
    key: [*]gchar
    value: [*]gchar
    annotations: ?[*]*GDBusAnnotationInfo
}
pub const GDBusAnnotationInfo = _GDBusAnnotationInfo

pub const _GDBusArgInfo = struct {
    ref_count: gint
    name: [*]gchar
    signature: [*]gchar
    annotations: ?[*]*GDBusAnnotationInfo
}
pub const GDBusArgInfo = _GDBusArgInfo

pub const _GDBusMethodInfo = struct {
    ref_count: gint
    name: [*]gchar
    in_args: ?[*]*GDBusArgInfo
    out_args: ?[*]*GDBusArgInfo
    annotations: ?[*]*GDBusAnnotationInfo
}
pub const GDBusMethodInfo = _GDBusMethodInfo

pub const _GDBusSignalInfo = struct {
    ref_count: gint
    name: [*]gchar
    args: ?[*]*GDBusArgInfo
    annotations: ?[*]*GDBusAnnotationInfo
}
pub const GDBusSignalInfo = _GDBusSignalInfo

pub const GDBusPropertyInfoFlags = enum(c_int) {
    G_DBUS_PROPERTY_INFO_FLAGS_NONE = 0,
    G_DBUS_PROPERTY_INFO_FLAGS_READABLE = 1,
    G_DBUS_PROPERTY_INFO_FLAGS_WRITABLE = 2,
}

pub const _GDBusPropertyInfo = struct {
    ref_count: gint
    name: [*]gchar
    signature: [*]gchar
    flags: GDBusPropertyInfoFlags
    annotations: ?[*]*GDBusAnnotationInfo
}
pub const GDBusPropertyInfo = _GDBusPropertyInfo

pub const _GDBusInterfaceInfo = struct {
    ref_count: gint
    name: [*]gchar
    methods: ?[*]*GDBusMethodInfo
    signals: ?[*]*GDBusSignalInfo
    properties: ?[*]*GDBusPropertyInfo
    annotations: ?[*]*GDBusAnnotationInfo
}
pub const GDBusInterfaceInfo = _GDBusInterfaceInfo

pub const _GDBusNodeInfo = struct {
    ref_count: gint
    path: [*]gchar
    interfaces: ?[*]*GDBusInterfaceInfo
    nodes: ?[*]*GDBusNodeInfo
    annotations: ?[*]*GDBusAnnotationInfo
}
pub const GDBusNodeInfo = _GDBusNodeInfo

pub const G_DBUS_ERROR: gquark.GQuark = g_dbus_error_quark()

pub const _GDBusErrorEntry = struct {
    error_code: gint
    dbus_error_name: [*]const gchar
}
pub const GDBusErrorEntry = _GDBusErrorEntry

pub extern("c") fn g_dbus_error_new_for_dbus_error(dbus_error_name: [*]const gchar, dbus_error_message: [*]const gchar) -> *GError
pub extern("c") fn g_dbus_error_set_dbus_error(error_: ?**GError, dbus_error_name: [*]const gchar, dbus_error_message: [*]const gchar, format: ?[*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_dbus_error_encode_gerror(error_: *const GError) -> [*]gchar
pub extern("c") fn g_dbus_error_register_error(error_domain: gquark.GQuark, error_code: gint, dbus_error_name: [*]const gchar) -> gboolean
pub extern("c") fn g_dbus_error_unregister_error(error_domain: gquark.GQuark, error_code: gint, dbus_error_name: [*]const gchar) -> gboolean
pub extern("c") fn g_dbus_error_register_error_domain(error_domain_quark_name: [*]const gchar, quark_volatile: *gtypes.gsize, entries: [*]const GDBusErrorEntry, num_entries: gtypes.guint) -> void

pub extern("c") fn g_dbus_is_name(string: [*]const gchar) -> gboolean
pub extern("c") fn g_dbus_is_unique_name(string: [*]const gchar) -> gboolean
pub extern("c") fn g_dbus_is_member_name(string: [*]const gchar) -> gboolean
pub extern("c") fn g_dbus_is_interface_name(string: [*]const gchar) -> gboolean
pub extern("c") fn g_dbus_is_error_name(string: [*]const gchar) -> gboolean
pub extern("c") fn g_dbus_is_guid(string: [*]const gchar) -> gboolean
pub extern("c") fn g_dbus_generate_guid() -> [*]gchar

pub extern("c") fn g_dbus_error_quark() -> gquark.GQuark
pub extern("c") fn g_dbus_error_is_remote_error(error_: *const GError) -> gboolean
pub extern("c") fn g_dbus_error_get_remote_error(error_: *const GError) -> ?[*]gchar
pub extern("c") fn g_dbus_error_strip_remote_error(error_: *GError) -> gboolean

pub extern("c") fn g_bus_get_sync(bus_type: gioenums.GBusType, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GDBusConnection
pub extern("c") fn g_bus_get(bus_type: gioenums.GBusType, cancellable: ?*GCancellable, callback: giotypes.GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_bus_get_finish(res: *giotypes.GAsyncResult, error_: ?**GError) -> ?*GDBusConnection
pub extern("c") fn g_dbus_address_get_for_bus_sync(bus_type: gioenums.GBusType, cancellable: ?*GCancellable, error_: ?**GError) -> ?[*]gchar

pub extern("c") fn g_dbus_proxy_get_type() -> gtype.GType
pub extern("c") fn g_dbus_proxy_new(connection: *GDBusConnection, flags: gioenums.GDBusProxyFlags, info: ?*GDBusInterfaceInfo, name: ?[*]const gchar, object_path: [*]const gchar, interface_name: [*]const gchar, cancellable: ?*GCancellable, callback: giotypes.GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_dbus_proxy_new_finish(res: *giotypes.GAsyncResult, error_: ?**GError) -> ?*GDBusProxy
pub extern("c") fn g_dbus_proxy_new_sync(connection: *GDBusConnection, flags: gioenums.GDBusProxyFlags, info: ?*GDBusInterfaceInfo, name: ?[*]const gchar, object_path: [*]const gchar, interface_name: [*]const gchar, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GDBusProxy
pub extern("c") fn g_dbus_proxy_new_for_bus(bus_type: gioenums.GBusType, flags: gioenums.GDBusProxyFlags, info: ?*GDBusInterfaceInfo, name: [*]const gchar, object_path: [*]const gchar, interface_name: [*]const gchar, cancellable: ?*GCancellable, callback: giotypes.GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_dbus_proxy_new_for_bus_finish(res: *giotypes.GAsyncResult, error_: ?**GError) -> ?*GDBusProxy
pub extern("c") fn g_dbus_proxy_new_for_bus_sync(bus_type: gioenums.GBusType, flags: gioenums.GDBusProxyFlags, info: ?*GDBusInterfaceInfo, name: [*]const gchar, object_path: [*]const gchar, interface_name: [*]const gchar, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GDBusProxy
pub extern("c") fn g_dbus_proxy_get_connection(proxy: *GDBusProxy) -> *GDBusConnection
pub extern("c") fn g_dbus_proxy_get_flags(proxy: *GDBusProxy) -> gioenums.GDBusProxyFlags
pub extern("c") fn g_dbus_proxy_get_name(proxy: *GDBusProxy) -> ?[*]const gchar
pub extern("c") fn g_dbus_proxy_get_name_owner(proxy: *GDBusProxy) -> ?[*]gchar
pub extern("c") fn g_dbus_proxy_get_object_path(proxy: *GDBusProxy) -> [*]const gchar
pub extern("c") fn g_dbus_proxy_get_interface_name(proxy: *GDBusProxy) -> [*]const gchar
pub extern("c") fn g_dbus_proxy_get_default_timeout(proxy: *GDBusProxy) -> gint
pub extern("c") fn g_dbus_proxy_set_default_timeout(proxy: *GDBusProxy, timeout_msec: gint) -> void
pub extern("c") fn g_dbus_proxy_get_cached_property(proxy: *GDBusProxy, property_name: [*]const gchar) -> ?*GVariant
pub extern("c") fn g_dbus_proxy_set_cached_property(proxy: *GDBusProxy, property_name: [*]const gchar, value: ?*GVariant) -> void
pub extern("c") fn g_dbus_proxy_get_cached_property_names(proxy: *GDBusProxy) -> ?[*][*]gchar
pub extern("c") fn g_dbus_proxy_call(proxy: *GDBusProxy, method_name: [*]const gchar, parameters: ?*GVariant, flags: gioenums.GDBusCallFlags, timeout_msec: gint, cancellable: ?*GCancellable, callback: giotypes.GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_dbus_proxy_call_finish(proxy: *GDBusProxy, res: *giotypes.GAsyncResult, error_: ?**GError) -> ?*GVariant
pub extern("c") fn g_dbus_proxy_call_sync(proxy: *GDBusProxy, method_name: [*]const gchar, parameters: ?*GVariant, flags: gioenums.GDBusCallFlags, timeout_msec: gint, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GVariant
pub extern("c") fn g_dbus_proxy_call_with_unix_fd_list(proxy: *GDBusProxy, method_name: [*]const gchar, parameters: ?*GVariant, flags: gioenums.GDBusCallFlags, timeout_msec: gint, fd_list: ?*giotypes.GUnixFDList, cancellable: ?*GCancellable, callback: giotypes.GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_dbus_proxy_call_with_unix_fd_list_finish(proxy: *GDBusProxy, out_fd_list: ?**giotypes.GUnixFDList, res: *giotypes.GAsyncResult, error_: ?**GError) -> ?*GVariant
pub extern("c") fn g_dbus_proxy_call_with_unix_fd_list_sync(proxy: *GDBusProxy, method_name: [*]const gchar, parameters: ?*GVariant, flags: gioenums.GDBusCallFlags, timeout_msec: gint, fd_list: ?*giotypes.GUnixFDList, out_fd_list: ?**giotypes.GUnixFDList, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GVariant
pub extern("c") fn g_dbus_proxy_get_interface_info(proxy: *GDBusProxy) -> ?*GDBusInterfaceInfo
pub extern("c") fn g_dbus_proxy_set_interface_info(proxy: *GDBusProxy, info: ?*GDBusInterfaceInfo) -> void

pub extern("c") fn g_dbus_node_info_new_for_xml(xml_data: [*]const gchar, error_: ?**GError) -> ?*GDBusNodeInfo
pub extern("c") fn g_dbus_node_info_lookup_interface(info: *GDBusNodeInfo, name: [*]const gchar) -> ?*GDBusInterfaceInfo
pub extern("c") fn g_dbus_node_info_ref(info: *GDBusNodeInfo) -> *GDBusNodeInfo
pub extern("c") fn g_dbus_node_info_unref(info: *GDBusNodeInfo) -> void
pub extern("c") fn g_dbus_interface_info_ref(info: *GDBusInterfaceInfo) -> *GDBusInterfaceInfo
pub extern("c") fn g_dbus_interface_info_unref(info: *GDBusInterfaceInfo) -> void
pub extern("c") fn g_dbus_interface_info_lookup_method(info: *GDBusInterfaceInfo, name: [*]const gchar) -> ?*GDBusMethodInfo
pub extern("c") fn g_dbus_interface_info_lookup_signal(info: *GDBusInterfaceInfo, name: [*]const gchar) -> ?*GDBusSignalInfo
pub extern("c") fn g_dbus_interface_info_lookup_property(info: *GDBusInterfaceInfo, name: [*]const gchar) -> ?*GDBusPropertyInfo
pub extern("c") fn g_dbus_interface_info_generate_xml(info: *GDBusInterfaceInfo, indent: gtypes.guint, string_builder: *gstring.GString) -> void
pub extern("c") fn g_dbus_node_info_generate_xml(info: *GDBusNodeInfo, indent: gtypes.guint, string_builder: *gstring.GString) -> void

pub const G_TYPE_DBUS_PROXY: gtype.GType = g_dbus_proxy_get_type()
pub fn G_DBUS_PROXY(o: anytype) -> *GDBusProxy { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_DBUS_PROXY, GDBusProxy) }
pub fn G_IS_DBUS_PROXY(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_DBUS_PROXY) }
