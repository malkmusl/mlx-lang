// gio/gtlsbackend.h
// mlx-glib: GTlsBackend, the TLS implementation GIO's TLS types come
// from. The default backend here makes certificates (they are kept and
// compared) but no TLS connections: g_tls_backend_supports_tls is FALSE,
// as with GIO when no TLS module is installed, the default database has
// no certificates, and a file database fails with G_TLS_ERROR_UNAVAILABLE.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")

const gboolean = gtypes.gboolean
const GTlsBackend = giotypes.GTlsBackend

pub extern("c") fn g_tls_backend_get_type() -> gtype.GType
pub extern("c") fn g_tls_backend_get_default() -> *GTlsBackend
pub extern("c") fn g_tls_backend_supports_tls(backend: *GTlsBackend) -> gboolean
pub extern("c") fn g_tls_backend_supports_dtls(backend: *GTlsBackend) -> gboolean
pub extern("c") fn g_tls_backend_get_default_database(backend: *GTlsBackend) -> *giotypes.GTlsDatabase
pub extern("c") fn g_tls_backend_get_certificate_type(backend: *GTlsBackend) -> gtype.GType
pub extern("c") fn g_tls_backend_get_client_connection_type(backend: *GTlsBackend) -> gtype.GType
pub extern("c") fn g_tls_backend_get_file_database_type(backend: *GTlsBackend) -> gtype.GType

pub const G_TYPE_TLS_BACKEND: gtype.GType = g_tls_backend_get_type()
pub fn G_TLS_BACKEND(o: anytype) -> *GTlsBackend { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TLS_BACKEND, GTlsBackend) }
pub fn G_IS_TLS_BACKEND(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TLS_BACKEND) }
