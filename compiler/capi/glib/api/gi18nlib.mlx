// glib/gi18n-lib.h
// mlx-glib: the gettext macros of a library (its GETTEXT_PACKAGE the
// domain): _() a message in the user's language, N_() one marked for it
// and kept as it is, C_() with a context. As there are no message
// catalogs, each is the message itself.
const c_system_headers = "string.h"
const glib = @import("./glib.mlx")

// (C the header has as it is: macros of the library's GETTEXT_PACKAGE,
// and string literals pasted together.)
const c_macros = "#define _(String) ((char *) g_dgettext(GETTEXT_PACKAGE, String))\n#define Q_(String) g_dpgettext(GETTEXT_PACKAGE, String, 0)\n#define N_(String) (String)\n#define C_(Context, String) g_dpgettext(GETTEXT_PACKAGE, Context \"\\004\" String, strlen(Context) + 1)\n#define NC_(Context, String) (String)"
