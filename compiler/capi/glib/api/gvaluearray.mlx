// gobject/gvaluearray.h
// mlx-glib: arrays of GValues (deprecated in GLib, still in its API).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gvalue = @import("./gvalue.mlx")

const guint = gtypes.guint
const GValue = gvalue.GValue

pub const _GValueArray = struct {
    n_values: guint
    values: *GValue
    n_prealloced: guint
}
pub const GValueArray = _GValueArray

pub extern("c") fn g_value_array_get_type() -> gvalue.GType
pub extern("c") fn g_value_array_get_nth(value_array: *GValueArray, index_: guint) -> *GValue
pub extern("c") fn g_value_array_new(n_prealloced: guint) -> *GValueArray
pub extern("c") fn g_value_array_free(value_array: *GValueArray) -> void
pub extern("c") fn g_value_array_copy(value_array: *const GValueArray) -> *GValueArray
pub extern("c") fn g_value_array_prepend(value_array: *GValueArray, value: ?*const GValue) -> *GValueArray
pub extern("c") fn g_value_array_append(value_array: *GValueArray, value: ?*const GValue) -> *GValueArray
pub extern("c") fn g_value_array_insert(value_array: *GValueArray, index_: guint, value: ?*const GValue) -> *GValueArray
pub extern("c") fn g_value_array_remove(value_array: *GValueArray, index_: guint) -> *GValueArray
