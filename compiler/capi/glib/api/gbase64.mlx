// glib/gbase64.h
// mlx-glib: Base64 (RFC 4648) encoding and decoding.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

pub extern("c") fn g_base64_encode(data: [*]const gtypes.guchar, len: gtypes.gsize) -> [*]gtypes.gchar
pub extern("c") fn g_base64_decode(text: [*]const gtypes.gchar, out_len: *gtypes.gsize) -> [*]gtypes.guchar
pub extern("c") fn g_base64_decode_inplace(text: [*]gtypes.gchar, out_len: *gtypes.gsize) -> [*]gtypes.guchar
