// gio/gsocket.h
// mlx-glib: GSocket, a socket descriptor as an object (blocking or not,
// with timeouts, sources that dispatch when it is ready), and the
// streams of a connected one (GIOStream, GSocketConnection).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gmain = @import("./gmain.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const gint = gtypes.gint
const guint = gtypes.guint
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const gint64 = gtypes.gint64
const GError = gerror.GError
const GSocket = giotypes.GSocket
const GCancellable = giotypes.GCancellable
const GIOStream = giotypes.GIOStream
const GSocketConnection = giotypes.GSocketConnection

pub extern("c") fn g_socket_get_type() -> gtype.GType
pub extern("c") fn g_socket_new(family: gioenums.GSocketFamily, type_: gioenums.GSocketType, protocol: gioenums.GSocketProtocol, error_: ?**GError) -> ?*GSocket
pub extern("c") fn g_socket_new_from_fd(fd: gint, error_: ?**GError) -> ?*GSocket
pub extern("c") fn g_socket_get_fd(socket: *GSocket) -> c_int
pub extern("c") fn g_socket_get_family(socket: *GSocket) -> gioenums.GSocketFamily
pub extern("c") fn g_socket_get_socket_type(socket: *GSocket) -> gioenums.GSocketType
pub extern("c") fn g_socket_get_protocol(socket: *GSocket) -> gioenums.GSocketProtocol
pub extern("c") fn g_socket_set_blocking(socket: *GSocket, blocking: gboolean) -> void
pub extern("c") fn g_socket_get_blocking(socket: *GSocket) -> gboolean
pub extern("c") fn g_socket_set_keepalive(socket: *GSocket, keepalive: gboolean) -> void
pub extern("c") fn g_socket_get_keepalive(socket: *GSocket) -> gboolean
pub extern("c") fn g_socket_set_timeout(socket: *GSocket, timeout: guint) -> void
pub extern("c") fn g_socket_get_timeout(socket: *GSocket) -> guint
pub extern("c") fn g_socket_is_connected(socket: *GSocket) -> gboolean
pub extern("c") fn g_socket_is_closed(socket: *GSocket) -> gboolean
pub extern("c") fn g_socket_get_available_bytes(socket: *GSocket) -> gssize
pub extern("c") fn g_socket_condition_check(socket: *GSocket, condition: gmain.GIOCondition) -> gmain.GIOCondition
pub extern("c") fn g_socket_condition_wait(socket: *GSocket, condition: gmain.GIOCondition, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_socket_condition_timed_wait(socket: *GSocket, condition: gmain.GIOCondition, timeout_us: gint64, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_socket_receive(socket: *GSocket, buffer: [*]gchar, size: gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn g_socket_receive_with_blocking(socket: *GSocket, buffer: [*]gchar, size: gsize, blocking: gboolean, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn g_socket_send(socket: *GSocket, buffer: [*]const gchar, size: gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn g_socket_send_with_blocking(socket: *GSocket, buffer: [*]const gchar, size: gsize, blocking: gboolean, cancellable: ?*GCancellable, error_: ?**GError) -> gssize
pub extern("c") fn g_socket_close(socket: *GSocket, error_: ?**GError) -> gboolean
pub extern("c") fn g_socket_shutdown(socket: *GSocket, shutdown_read: gboolean, shutdown_write: gboolean, error_: ?**GError) -> gboolean
pub extern("c") fn g_socket_create_source(socket: *GSocket, condition: gmain.GIOCondition, cancellable: ?*GCancellable) -> *gmain.GSource

pub extern("c") fn g_io_stream_get_type() -> gtype.GType
pub extern("c") fn g_io_stream_close(stream: *GIOStream, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_io_stream_is_closed(stream: *GIOStream) -> gboolean
pub extern("c") fn g_io_stream_has_pending(stream: *GIOStream) -> gboolean

pub extern("c") fn g_socket_connection_get_type() -> gtype.GType
pub extern("c") fn g_socket_connection_get_socket(connection: *GSocketConnection) -> *GSocket
pub extern("c") fn g_socket_connection_is_connected(connection: *GSocketConnection) -> gboolean
pub extern("c") fn g_socket_connection_factory_create_connection(socket: *GSocket) -> *GSocketConnection
pub extern("c") fn g_socket_connection_get_local_address(connection: *GSocketConnection, error_: ?**GError) -> ?*giotypes.GSocketAddress
pub extern("c") fn g_socket_connection_get_remote_address(connection: *GSocketConnection, error_: ?**GError) -> ?*giotypes.GSocketAddress
pub extern("c") fn g_socket_get_local_address(socket: *GSocket, error_: ?**GError) -> ?*giotypes.GSocketAddress
pub extern("c") fn g_socket_get_remote_address(socket: *GSocket, error_: ?**GError) -> ?*giotypes.GSocketAddress

pub const G_TYPE_SOCKET: gtype.GType = g_socket_get_type()
pub const G_TYPE_IO_STREAM: gtype.GType = g_io_stream_get_type()
pub const G_TYPE_SOCKET_CONNECTION: gtype.GType = g_socket_connection_get_type()
pub fn G_SOCKET(o: anytype) -> *GSocket { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_SOCKET, GSocket) }
pub fn G_IS_SOCKET(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_SOCKET) }
pub fn G_IO_STREAM(o: anytype) -> *GIOStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_IO_STREAM, GIOStream) }
pub fn G_IS_IO_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_IO_STREAM) }
pub fn G_SOCKET_CONNECTION(o: anytype) -> *GSocketConnection { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_SOCKET_CONNECTION, GSocketConnection) }
pub fn G_IS_SOCKET_CONNECTION(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_SOCKET_CONNECTION) }
