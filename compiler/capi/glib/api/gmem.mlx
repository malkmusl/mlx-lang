// glib/gmem.h
// mlx-glib: memory. What the g_malloc family gives is C's malloc's, so
// free() and g_free() both release it; the forms without `try` abort the
// program when there is no memory, as GLib's do.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")

const gpointer = gtypes.gpointer
const gconstpointer = gtypes.gconstpointer
const gsize = gtypes.gsize

// (C the header has as it is: g_alloca is the stack's room until the
// function returns, <alloca.h>'s.)
const c_macros = "#include <alloca.h>\n#define g_alloca(size) alloca(size)\n#define g_newa(struct_type, n_structs) ((struct_type *) g_alloca(sizeof(struct_type) * (gsize) (n_structs)))\n#define g_newa0(struct_type, n_structs) ((struct_type *) memset(g_alloca(sizeof(struct_type) * (gsize) (n_structs)), 0, sizeof(struct_type) * (gsize) (n_structs)))"

pub extern("c") fn g_free(mem: gpointer) -> void
pub extern("c") fn g_free_sized(mem: gpointer, size: gsize) -> void
pub extern("c") fn g_malloc(n_bytes: gsize) -> gpointer
pub extern("c") fn g_malloc0(n_bytes: gsize) -> gpointer
pub extern("c") fn g_realloc(mem: gpointer, n_bytes: gsize) -> gpointer
pub extern("c") fn g_try_malloc(n_bytes: gsize) -> gpointer
pub extern("c") fn g_try_malloc0(n_bytes: gsize) -> gpointer
pub extern("c") fn g_try_realloc(mem: gpointer, n_bytes: gsize) -> gpointer
pub extern("c") fn g_malloc_n(n_blocks: gsize, n_block_bytes: gsize) -> gpointer
pub extern("c") fn g_malloc0_n(n_blocks: gsize, n_block_bytes: gsize) -> gpointer
pub extern("c") fn g_realloc_n(mem: gpointer, n_blocks: gsize, n_block_bytes: gsize) -> gpointer
pub extern("c") fn g_try_malloc_n(n_blocks: gsize, n_block_bytes: gsize) -> gpointer
pub extern("c") fn g_try_malloc0_n(n_blocks: gsize, n_block_bytes: gsize) -> gpointer
pub extern("c") fn g_try_realloc_n(mem: gpointer, n_blocks: gsize, n_block_bytes: gsize) -> gpointer
pub extern("c") fn g_memdup2(mem: gconstpointer, byte_size: gsize) -> gpointer

// Releases what `*pp` points to with `destroy` and clears `*pp` (nothing
// when it is null).
pub inline fn g_clear_pointer(pp: anytype, destroy: anytype) -> void {
    const _pp: *gpointer = @ptrCast(*gpointer, pp)
    const _p: gpointer = _pp.*
    if _p != null {
        _pp.* = null
        @ptrCast(gtypes.GDestroyNotify, destroy)(_p)
    }
}

// `n_structs` structures of `struct_type`, as their pointer.
pub inline fn g_new(comptime struct_type: type, n_structs: gsize) -> *struct_type { return @ptrCast(*struct_type, g_malloc_n(n_structs, @sizeOf(struct_type))) }
pub inline fn g_new0(comptime struct_type: type, n_structs: gsize) -> *struct_type { return @ptrCast(*struct_type, g_malloc0_n(n_structs, @sizeOf(struct_type))) }
pub inline fn g_renew(comptime struct_type: type, mem: gpointer, n_structs: gsize) -> *struct_type { return @ptrCast(*struct_type, g_realloc_n(mem, n_structs, @sizeOf(struct_type))) }
pub inline fn g_try_new(comptime struct_type: type, n_structs: gsize) -> *struct_type { return @ptrCast(*struct_type, g_try_malloc_n(n_structs, @sizeOf(struct_type))) }
pub inline fn g_try_new0(comptime struct_type: type, n_structs: gsize) -> *struct_type { return @ptrCast(*struct_type, g_try_malloc0_n(n_structs, @sizeOf(struct_type))) }
