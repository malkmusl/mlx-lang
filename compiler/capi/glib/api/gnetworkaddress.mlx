// gio/gnetworkaddress.h
// mlx-glib: GNetworkAddress, a host name and port (and URI scheme) to
// connect to: a GSocketConnectable whose "hostname" a TLS connection
// checks the server's certificate against.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gsocketconnectable = @import("./gsocketconnectable.mlx")

const gchar = gtypes.gchar
const guint16 = gtypes.guint16
const gpointer = gtypes.gpointer

pub const _GNetworkAddress = struct {
    parent_instance: gobject.GObject
    priv: gpointer
}
pub const GNetworkAddress = _GNetworkAddress

pub const _GNetworkAddressClass = struct {
    parent_class: gobject.GObjectClass
}
pub const GNetworkAddressClass = _GNetworkAddressClass

pub extern("c") fn g_network_address_get_type() -> gtype.GType
pub extern("c") fn g_network_address_new(hostname: [*]const gchar, port: guint16) -> *gsocketconnectable.GSocketConnectable
pub extern("c") fn g_network_address_new_loopback(port: guint16) -> *gsocketconnectable.GSocketConnectable
pub extern("c") fn g_network_address_get_hostname(addr: *GNetworkAddress) -> [*]const gchar
pub extern("c") fn g_network_address_get_port(addr: *GNetworkAddress) -> guint16
pub extern("c") fn g_network_address_get_scheme(addr: *GNetworkAddress) -> ?[*]const gchar

pub const G_TYPE_NETWORK_ADDRESS: gtype.GType = g_network_address_get_type()
pub fn G_NETWORK_ADDRESS(o: anytype) -> *GNetworkAddress { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_NETWORK_ADDRESS, GNetworkAddress) }
pub fn G_IS_NETWORK_ADDRESS(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_NETWORK_ADDRESS) }
