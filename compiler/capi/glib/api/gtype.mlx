// gobject/gtype.h
// mlx-glib: GObject's type system. A type has a name, a parent (or is
// fundamental), a class structure made once (the parent's copied, then
// each class_init from the root down) and, when it is instantiatable,
// instances whose first word points to the class. Interfaces are types
// a class implements with a vtable of its own. Instances may have
// private data, placed before the instance as GLib places it.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gint = gtypes.gint
const guint = gtypes.guint
const guint16 = gtypes.guint16
const gsize = gtypes.gsize
const gpointer = gtypes.gpointer
const gconstpointer = gtypes.gconstpointer
const GQuark = gquark.GQuark

// (C the header has as it is: the macros declaring a type's names,
// which paste tokens. There is no g_autoptr: the cleanup functions are
// declared for code that calls them.)
const c_macros = "#define G_DEFINE_AUTOPTR_CLEANUP_FUNC(TypeName, func) \\\n    typedef TypeName *TypeName##_autoptr; \\\n    G_GNUC_UNUSED static inline void glib_autoptr_clear_##TypeName(TypeName *_ptr) { if (_ptr) (func)(_ptr); } \\\n    G_GNUC_UNUSED static inline void glib_autoptr_cleanup_##TypeName(TypeName **_ptr) { glib_autoptr_clear_##TypeName(*_ptr); }\n#define G_DECLARE_FINAL_TYPE(ModuleObjName, module_obj_name, MODULE, OBJ_NAME, ParentName) \\\n    GType module_obj_name##_get_type(void); \\\n    typedef struct _##ModuleObjName ModuleObjName; \\\n    typedef struct { ParentName##Class parent_class; } ModuleObjName##Class; \\\n    G_DEFINE_AUTOPTR_CLEANUP_FUNC(ModuleObjName, g_object_unref) \\\n    G_GNUC_UNUSED static inline ModuleObjName *MODULE##_##OBJ_NAME(gpointer ptr) { \\\n        return (ModuleObjName *) g_type_check_instance_cast((GTypeInstance *) ptr, module_obj_name##_get_type()); } \\\n    G_GNUC_UNUSED static inline gboolean MODULE##_IS_##OBJ_NAME(gpointer ptr) { \\\n        return g_type_check_instance_is_a((GTypeInstance *) ptr, module_obj_name##_get_type()); }\n#define G_DECLARE_INTERFACE(ModuleObjName, module_obj_name, MODULE, OBJ_NAME, PrerequisiteName) \\\n    GType module_obj_name##_get_type(void); \\\n    typedef struct _##ModuleObjName ModuleObjName; \\\n    typedef struct _##ModuleObjName##Interface ModuleObjName##Interface; \\\n    G_DEFINE_AUTOPTR_CLEANUP_FUNC(ModuleObjName, g_object_unref) \\\n    G_GNUC_UNUSED static inline ModuleObjName *MODULE##_##OBJ_NAME(gpointer ptr) { \\\n        return (ModuleObjName *) g_type_check_instance_cast((GTypeInstance *) ptr, module_obj_name##_get_type()); } \\\n    G_GNUC_UNUSED static inline gboolean MODULE##_IS_##OBJ_NAME(gpointer ptr) { \\\n        return g_type_check_instance_is_a((GTypeInstance *) ptr, module_obj_name##_get_type()); } \\\n    G_GNUC_UNUSED static inline ModuleObjName##Interface *MODULE##_##OBJ_NAME##_GET_IFACE(gpointer ptr) { \\\n        return (ModuleObjName##Interface *) g_type_interface_peek(((GTypeInstance *) ptr)->g_class, module_obj_name##_get_type()); }\n#define G_DECLARE_DERIVABLE_TYPE(ModuleObjName, module_obj_name, MODULE, OBJ_NAME, ParentName) \\\n    GType module_obj_name##_get_type(void); \\\n    typedef struct _##ModuleObjName ModuleObjName; \\\n    typedef struct _##ModuleObjName##Class ModuleObjName##Class; \\\n    struct _##ModuleObjName { ParentName parent_instance; }; \\\n    G_DEFINE_AUTOPTR_CLEANUP_FUNC(ModuleObjName, g_object_unref) \\\n    G_GNUC_UNUSED static inline ModuleObjName *MODULE##_##OBJ_NAME(gpointer ptr) { \\\n        return (ModuleObjName *) g_type_check_instance_cast((GTypeInstance *) ptr, module_obj_name##_get_type()); } \\\n    G_GNUC_UNUSED static inline ModuleObjName##Class *MODULE##_##OBJ_NAME##_CLASS(gpointer ptr) { \\\n        return (ModuleObjName##Class *) g_type_check_class_cast((GTypeClass *) ptr, module_obj_name##_get_type()); } \\\n    G_GNUC_UNUSED static inline gboolean MODULE##_IS_##OBJ_NAME(gpointer ptr) { \\\n        return g_type_check_instance_is_a((GTypeInstance *) ptr, module_obj_name##_get_type()); } \\\n    G_GNUC_UNUSED static inline gboolean MODULE##_IS_##OBJ_NAME##_CLASS(gpointer ptr) { \\\n        return g_type_check_class_is_a((GTypeClass *) ptr, module_obj_name##_get_type()); } \\\n    G_GNUC_UNUSED static inline ModuleObjName##Class *MODULE##_##OBJ_NAME##_GET_CLASS(gpointer ptr) { \\\n        return (ModuleObjName##Class *) ((GTypeInstance *) ptr)->g_class; }\n#define G_IMPLEMENT_INTERFACE(TYPE_IFACE, iface_init) { \\\n    const GInterfaceInfo g_implement_interface_info = { (GInterfaceInitFunc)(void (*)(void)) iface_init, NULL, NULL }; \\\n    g_type_add_interface_static(g_define_type_id, TYPE_IFACE, &g_implement_interface_info); }"

pub const GType = gsize

pub const G_TYPE_FUNDAMENTAL_SHIFT: c_int = 2
pub const G_TYPE_FUNDAMENTAL_MAX: c_int = 255 << 2
pub const G_TYPE_RESERVED_GLIB_FIRST: c_int = 22
pub const G_TYPE_RESERVED_GLIB_LAST: c_int = 31
pub const G_TYPE_RESERVED_BSE_FIRST: c_int = 32
pub const G_TYPE_RESERVED_BSE_LAST: c_int = 48
pub const G_TYPE_RESERVED_USER_FIRST: c_int = 49

pub const G_TYPE_INVALID: GType = @intCast(GType, 0)
pub const G_TYPE_NONE: GType = @intCast(GType, 1 << 2)
pub const G_TYPE_INTERFACE: GType = @intCast(GType, 2 << 2)
pub const G_TYPE_CHAR: GType = @intCast(GType, 3 << 2)
pub const G_TYPE_UCHAR: GType = @intCast(GType, 4 << 2)
pub const G_TYPE_BOOLEAN: GType = @intCast(GType, 5 << 2)
pub const G_TYPE_INT: GType = @intCast(GType, 6 << 2)
pub const G_TYPE_UINT: GType = @intCast(GType, 7 << 2)
pub const G_TYPE_LONG: GType = @intCast(GType, 8 << 2)
pub const G_TYPE_ULONG: GType = @intCast(GType, 9 << 2)
pub const G_TYPE_INT64: GType = @intCast(GType, 10 << 2)
pub const G_TYPE_UINT64: GType = @intCast(GType, 11 << 2)
pub const G_TYPE_ENUM: GType = @intCast(GType, 12 << 2)
pub const G_TYPE_FLAGS: GType = @intCast(GType, 13 << 2)
pub const G_TYPE_FLOAT: GType = @intCast(GType, 14 << 2)
pub const G_TYPE_DOUBLE: GType = @intCast(GType, 15 << 2)
pub const G_TYPE_STRING: GType = @intCast(GType, 16 << 2)
pub const G_TYPE_POINTER: GType = @intCast(GType, 17 << 2)
pub const G_TYPE_BOXED: GType = @intCast(GType, 18 << 2)
pub const G_TYPE_PARAM: GType = @intCast(GType, 19 << 2)
pub const G_TYPE_OBJECT: GType = @intCast(GType, 20 << 2)
pub const G_TYPE_VARIANT: GType = @intCast(GType, 21 << 2)

// (A signal's parameter type with this bit is passed as it is, not
// copied.)
pub const G_SIGNAL_TYPE_STATIC_SCOPE: GType = @intCast(GType, 1)

pub const _GTypeClass = struct {
    g_type: GType
}
pub const GTypeClass = _GTypeClass

pub const _GTypeInstance = struct {
    g_class: *GTypeClass
}
pub const GTypeInstance = _GTypeInstance

pub const _GTypeInterface = struct {
    g_type: GType
    g_instance_type: GType
}
pub const GTypeInterface = _GTypeInterface

pub const _GTypeQuery = struct {
    type_: GType
    type_name: [*]const gchar
    class_size: guint
    instance_size: guint
}
pub const GTypeQuery = _GTypeQuery

pub const GTypeDebugFlags = enum(c_int) {
    G_TYPE_DEBUG_NONE = 0,
    G_TYPE_DEBUG_OBJECTS = 1,
    G_TYPE_DEBUG_SIGNALS = 2,
    G_TYPE_DEBUG_INSTANCE_COUNT = 4,
    G_TYPE_DEBUG_MASK = 7,
}

pub const GTypeFundamentalFlags = enum(c_int) {
    G_TYPE_FLAG_CLASSED = 1,
    G_TYPE_FLAG_INSTANTIATABLE = 2,
    G_TYPE_FLAG_DERIVABLE = 4,
    G_TYPE_FLAG_DEEP_DERIVABLE = 8,
}

pub const GTypeFlags = enum(c_int) {
    G_TYPE_FLAG_NONE = 0,
    G_TYPE_FLAG_ABSTRACT = 16,
    G_TYPE_FLAG_VALUE_ABSTRACT = 32,
    G_TYPE_FLAG_FINAL = 64,
    G_TYPE_FLAG_DEPRECATED = 128,
}

pub const GBaseInitFunc = fn(g_class: gpointer) -> void
pub const GBaseFinalizeFunc = fn(g_class: gpointer) -> void
pub const GClassInitFunc = fn(g_class: gpointer, class_data: gpointer) -> void
pub const GClassFinalizeFunc = fn(g_class: gpointer, class_data: gpointer) -> void
pub const GInstanceInitFunc = fn(instance: *GTypeInstance, g_class: gpointer) -> void
pub const GInterfaceInitFunc = fn(g_iface: gpointer, iface_data: gpointer) -> void
pub const GInterfaceFinalizeFunc = fn(g_iface: gpointer, iface_data: gpointer) -> void
pub const GTypeClassCacheFunc = fn(cache_data: gpointer, g_class: *GTypeClass) -> gboolean
pub const GTypeInterfaceCheckFunc = fn(check_data: gpointer, g_iface: gpointer) -> void

// How values of a fundamental type are held, copied and collected
// (GValue's part of a type).
pub const _GTypeValueTable = struct {
    value_init: fn(value: *anyopaque) -> void
    value_free: fn(value: *anyopaque) -> void
    value_copy: fn(src_value: *const anyopaque, dest_value: *anyopaque) -> void
    value_peek_pointer: fn(value: *const anyopaque) -> gpointer
    collect_format: [*]const gchar
    collect_value: fn(value: *anyopaque, n_collect_values: guint, collect_values: *anyopaque, collect_flags: guint) -> [*]gchar
    lcopy_format: [*]const gchar
    lcopy_value: fn(value: *const anyopaque, n_collect_values: guint, collect_values: *anyopaque, collect_flags: guint) -> [*]gchar
}
pub const GTypeValueTable = _GTypeValueTable

pub const _GTypeInfo = struct {
    class_size: guint16
    base_init: GBaseInitFunc
    base_finalize: GBaseFinalizeFunc
    class_init: GClassInitFunc
    class_finalize: GClassFinalizeFunc
    class_data: gconstpointer
    instance_size: guint16
    n_preallocs: guint16
    instance_init: GInstanceInitFunc
    value_table: *const GTypeValueTable
}
pub const GTypeInfo = _GTypeInfo

pub const _GTypeFundamentalInfo = struct {
    type_flags: GTypeFundamentalFlags
}
pub const GTypeFundamentalInfo = _GTypeFundamentalInfo

pub const _GInterfaceInfo = struct {
    interface_init: GInterfaceInitFunc
    interface_finalize: GInterfaceFinalizeFunc
    interface_data: gpointer
}
pub const GInterfaceInfo = _GInterfaceInfo

pub const _GTypePlugin = struct {}
pub const GTypePlugin = _GTypePlugin

pub extern("c") fn g_type_init() -> void
pub extern("c") fn g_type_init_with_debug_flags(debug_flags: GTypeDebugFlags) -> void
pub extern("c") fn g_type_name(type_: GType) -> ?[*]const gchar
pub extern("c") fn g_type_qname(type_: GType) -> GQuark
pub extern("c") fn g_type_from_name(name: [*]const gchar) -> GType
pub extern("c") fn g_type_parent(type_: GType) -> GType
pub extern("c") fn g_type_depth(type_: GType) -> guint
pub extern("c") fn g_type_next_base(leaf_type: GType, root_type: GType) -> GType
pub extern("c") fn g_type_is_a(type_: GType, is_a_type: GType) -> gboolean
pub extern("c") fn g_type_class_ref(type_: GType) -> gpointer
pub extern("c") fn g_type_class_peek(type_: GType) -> gpointer
pub extern("c") fn g_type_class_peek_static(type_: GType) -> gpointer
pub extern("c") fn g_type_class_unref(g_class: gpointer) -> void
pub extern("c") fn g_type_class_peek_parent(g_class: gpointer) -> gpointer
pub extern("c") fn g_type_interface_peek(instance_class: gpointer, iface_type: GType) -> gpointer
pub extern("c") fn g_type_interface_peek_parent(g_iface: gpointer) -> gpointer
pub extern("c") fn g_type_default_interface_ref(g_type: GType) -> gpointer
pub extern("c") fn g_type_default_interface_peek(g_type: GType) -> gpointer
pub extern("c") fn g_type_default_interface_unref(g_iface: gpointer) -> void
pub extern("c") fn g_type_children(type_: GType, n_children: ?*guint) -> *GType
pub extern("c") fn g_type_interfaces(type_: GType, n_interfaces: ?*guint) -> *GType
pub extern("c") fn g_type_interface_prerequisites(interface_type: GType, n_prerequisites: ?*guint) -> *GType
pub extern("c") fn g_type_set_qdata(type_: GType, quark: GQuark, data: gpointer) -> void
pub extern("c") fn g_type_get_qdata(type_: GType, quark: GQuark) -> gpointer
pub extern("c") fn g_type_query(type_: GType, query: *GTypeQuery) -> void
pub extern("c") fn g_type_get_instance_count(type_: GType) -> c_int
pub extern("c") fn g_type_register_static(parent_type: GType, type_name: [*]const gchar, info: *const GTypeInfo, flags: GTypeFlags) -> GType
pub extern("c") fn g_type_register_static_simple(parent_type: GType, type_name: [*]const gchar, class_size: guint, class_init: GClassInitFunc, instance_size: guint, instance_init: GInstanceInitFunc, flags: GTypeFlags) -> GType
pub extern("c") fn g_type_register_dynamic(parent_type: GType, type_name: [*]const gchar, plugin: *GTypePlugin, flags: GTypeFlags) -> GType
pub extern("c") fn g_type_register_fundamental(type_id: GType, type_name: [*]const gchar, info: *const GTypeInfo, finfo: *const GTypeFundamentalInfo, flags: GTypeFlags) -> GType
pub extern("c") fn g_type_add_interface_static(instance_type: GType, interface_type: GType, info: *const GInterfaceInfo) -> void
pub extern("c") fn g_type_interface_add_prerequisite(interface_type: GType, prerequisite_type: GType) -> void
pub extern("c") fn g_type_get_type_registration_serial() -> guint
pub extern("c") fn g_type_fundamental_next() -> GType
pub extern("c") fn g_type_fundamental(type_id: GType) -> GType
pub extern("c") fn g_type_create_instance(type_: GType) -> *GTypeInstance
pub extern("c") fn g_type_free_instance(instance: *GTypeInstance) -> void
pub extern("c") fn g_type_add_class_cache_func(cache_data: gpointer, cache_func: GTypeClassCacheFunc) -> void
pub extern("c") fn g_type_remove_class_cache_func(cache_data: gpointer, cache_func: GTypeClassCacheFunc) -> void
pub extern("c") fn g_type_class_unref_uncached(g_class: gpointer) -> void
pub extern("c") fn g_type_get_plugin(type_: GType) -> ?*GTypePlugin
pub extern("c") fn g_type_interface_get_plugin(instance_type: GType, interface_type: GType) -> ?*GTypePlugin
pub extern("c") fn g_type_class_add_private(g_class: gpointer, private_size: gsize) -> void
pub extern("c") fn g_type_add_instance_private(class_type: GType, private_size: gsize) -> gint
pub extern("c") fn g_type_instance_get_private(instance: *GTypeInstance, private_type: GType) -> gpointer
pub extern("c") fn g_type_class_adjust_private_offset(g_class: gpointer, private_size_or_offset: *gint) -> void
pub extern("c") fn g_type_class_get_private(klass: *GTypeClass, private_type: GType) -> gpointer
pub extern("c") fn g_type_class_get_instance_private_offset(g_class: gpointer) -> gint
pub extern("c") fn g_type_ensure(type_: GType) -> void
pub extern("c") fn g_type_check_instance(instance: ?*GTypeInstance) -> gboolean
pub extern("c") fn g_type_check_instance_cast(instance: ?*GTypeInstance, iface_type: GType) -> ?*GTypeInstance
pub extern("c") fn g_type_check_instance_is_a(instance: ?*GTypeInstance, iface_type: GType) -> gboolean
pub extern("c") fn g_type_check_instance_is_fundamentally_a(instance: ?*GTypeInstance, fundamental_type: GType) -> gboolean
pub extern("c") fn g_type_check_class_cast(g_class: ?*GTypeClass, is_a_type: GType) -> ?*GTypeClass
pub extern("c") fn g_type_check_class_is_a(g_class: ?*GTypeClass, is_a_type: GType) -> gboolean
pub extern("c") fn g_type_check_is_value_type(type_: GType) -> gboolean
pub extern("c") fn g_type_check_value(value: *const anyopaque) -> gboolean
pub extern("c") fn g_type_check_value_holds(value: *const anyopaque, type_: GType) -> gboolean
pub extern("c") fn g_type_test_flags(type_: GType, flags: guint) -> gboolean
pub extern("c") fn g_type_name_from_instance(instance: *GTypeInstance) -> [*]const gchar
pub extern("c") fn g_type_name_from_class(g_class: *GTypeClass) -> [*]const gchar
pub extern("c") fn g_type_value_table_peek(type_: GType) -> ?*GTypeValueTable

pub fn G_TYPE_MAKE_FUNDAMENTAL(x: c_int) -> GType { return @intCast(GType, x << G_TYPE_FUNDAMENTAL_SHIFT) }
pub fn G_TYPE_FUNDAMENTAL(type_: GType) -> GType { return g_type_fundamental(type_) }
pub fn G_TYPE_IS_FUNDAMENTAL(type_: GType) -> bool { return type_ <= G_TYPE_FUNDAMENTAL_MAX }
pub fn G_TYPE_IS_DERIVED(type_: GType) -> bool { return type_ > G_TYPE_FUNDAMENTAL_MAX }
pub fn G_TYPE_IS_INTERFACE(type_: GType) -> bool { return G_TYPE_FUNDAMENTAL(type_) == G_TYPE_INTERFACE }
pub fn G_TYPE_IS_CLASSED(type_: GType) -> bool { return g_type_test_flags(type_, 1) != 0 }
pub fn G_TYPE_IS_INSTANTIATABLE(type_: GType) -> bool { return g_type_test_flags(type_, 2) != 0 }
pub fn G_TYPE_IS_DERIVABLE(type_: GType) -> bool { return g_type_test_flags(type_, 4) != 0 }
pub fn G_TYPE_IS_DEEP_DERIVABLE(type_: GType) -> bool { return g_type_test_flags(type_, 8) != 0 }
pub fn G_TYPE_IS_ABSTRACT(type_: GType) -> bool { return g_type_test_flags(type_, 16) != 0 }
pub fn G_TYPE_IS_VALUE_ABSTRACT(type_: GType) -> bool { return g_type_test_flags(type_, 32) != 0 }
pub fn G_TYPE_IS_VALUE_TYPE(type_: GType) -> bool { return g_type_check_is_value_type(type_) != 0 }
pub fn G_TYPE_HAS_VALUE_TABLE(type_: GType) -> bool { return g_type_value_table_peek(type_) != null }
pub fn G_TYPE_IS_FINAL(type_: GType) -> bool { return g_type_test_flags(type_, 64) != 0 }
pub fn G_TYPE_IS_DEPRECATED(type_: GType) -> bool { return g_type_test_flags(type_, 128) != 0 }

pub fn G_TYPE_CHECK_INSTANCE(instance: anytype) -> bool { return g_type_check_instance(@ptrCast(*GTypeInstance, instance)) != 0 }
pub fn G_TYPE_CHECK_INSTANCE_CAST(instance: anytype, g_type: GType, comptime c_type: type) -> *c_type { return @ptrCast(*c_type, g_type_check_instance_cast(@ptrCast(*GTypeInstance, instance), g_type)) }
pub fn G_TYPE_CHECK_INSTANCE_TYPE(instance: anytype, g_type: GType) -> bool { return g_type_check_instance_is_a(@ptrCast(*GTypeInstance, instance), g_type) != 0 }
pub fn G_TYPE_CHECK_INSTANCE_FUNDAMENTAL_TYPE(instance: anytype, g_type: GType) -> bool { return g_type_check_instance_is_fundamentally_a(@ptrCast(*GTypeInstance, instance), g_type) != 0 }
pub fn G_TYPE_INSTANCE_GET_CLASS(instance: anytype, g_type: GType, comptime c_type: type) -> *c_type { return @ptrCast(*c_type, @ptrCast(*GTypeInstance, instance).*.g_class) }
pub fn G_TYPE_INSTANCE_GET_INTERFACE(instance: anytype, g_type: GType, comptime c_type: type) -> *c_type { return @ptrCast(*c_type, g_type_interface_peek(@ptrCast(*GTypeInstance, instance).*.g_class, g_type)) }
pub fn G_TYPE_CHECK_CLASS_CAST(g_class: anytype, g_type: GType, comptime c_type: type) -> *c_type { return @ptrCast(*c_type, g_type_check_class_cast(@ptrCast(*GTypeClass, g_class), g_type)) }
pub fn G_TYPE_CHECK_CLASS_TYPE(g_class: anytype, g_type: GType) -> bool { return g_type_check_class_is_a(@ptrCast(*GTypeClass, g_class), g_type) != 0 }
pub fn G_TYPE_CHECK_VALUE(value: anytype) -> bool { return g_type_check_value(@ptrCast(*const anyopaque, value)) != 0 }
pub fn G_TYPE_CHECK_VALUE_TYPE(value: anytype, g_type: GType) -> bool { return g_type_check_value_holds(@ptrCast(*const anyopaque, value), g_type) != 0 }
pub fn G_TYPE_FROM_INSTANCE(instance: anytype) -> GType { return @ptrCast(*GTypeClass, @ptrCast(*GTypeInstance, instance).*.g_class).*.g_type }
pub fn G_TYPE_FROM_CLASS(g_class: anytype) -> GType { return @ptrCast(*GTypeClass, g_class).*.g_type }
pub fn G_TYPE_FROM_INTERFACE(g_iface: anytype) -> GType { return @ptrCast(*GTypeInterface, g_iface).*.g_type }
pub fn G_TYPE_INSTANCE_GET_PRIVATE(instance: anytype, g_type: GType, comptime c_type: type) -> *c_type { return @ptrCast(*c_type, g_type_instance_get_private(@ptrCast(*GTypeInstance, instance), g_type)) }
pub fn G_TYPE_CLASS_GET_PRIVATE(klass: anytype, g_type: GType, comptime c_type: type) -> *c_type { return @ptrCast(*c_type, g_type_class_get_private(@ptrCast(*GTypeClass, klass), g_type)) }
