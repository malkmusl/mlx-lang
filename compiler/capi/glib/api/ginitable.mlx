// gio/ginitable.h
// mlx-glib: GInitable, an object whose construction can fail:
// g_initable_new makes it with its properties and initializes it, NULL
// and the error when that fails.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GCancellable = giotypes.GCancellable
const GInitable = giotypes.GInitable

pub const _GInitableIface = struct {
    g_iface: gtype.GTypeInterface
    init: fn(initable: *GInitable, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
}
pub const GInitableIface = _GInitableIface

pub extern("c") fn g_initable_get_type() -> gtype.GType
pub extern("c") fn g_initable_init(initable: *GInitable, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_initable_new(object_type: gtype.GType, cancellable: ?*GCancellable, error_: ?**GError, first_property_name: ?[*]const gchar, rest: gtypes.c_varargs) -> gpointer
pub extern("c") fn g_initable_new_valist(object_type: gtype.GType, first_property_name: ?[*]const gchar, var_args: gtypes.c_va_list, cancellable: ?*GCancellable, error_: ?**GError) -> *gobject.GObject

pub const G_TYPE_INITABLE: gtype.GType = g_initable_get_type()
pub fn G_INITABLE(o: anytype) -> *GInitable { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_INITABLE, GInitable) }
pub fn G_IS_INITABLE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_INITABLE) }
pub fn G_INITABLE_GET_IFACE(o: anytype) -> *GInitableIface { return gtype.G_TYPE_INSTANCE_GET_INTERFACE(o, G_TYPE_INITABLE, GInitableIface) }
