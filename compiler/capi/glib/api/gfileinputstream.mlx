// gio/gfileinputstream.h
// mlx-glib: GFileInputStream, what g_file_read gives: an input stream of
// a file, seekable (GSeekable through the class's tell, can_seek and
// seek). Files' information (GFileInfo) is not here, nor
// g_file_input_stream_query_info.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")
const gseekable = @import("./gseekable.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const goffset = gtypes.goffset
const GError = gerror.GError
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback
const GFileInfo = giotypes.GFileInfo

pub const _GFileInputStreamPrivate = struct {}
pub const GFileInputStreamPrivate = _GFileInputStreamPrivate

pub const _GFileInputStream = struct {
    parent_instance: giotypes.GInputStream
    priv: ?*GFileInputStreamPrivate
}
pub const GFileInputStream = _GFileInputStream

pub const _GFileInputStreamClass = struct {
    parent_class: giotypes.GInputStreamClass
    tell: ?fn(stream: *GFileInputStream) -> goffset
    can_seek: ?fn(stream: *GFileInputStream) -> gboolean
    seek: ?fn(stream: *GFileInputStream, offset: goffset, type_: gseekable.GSeekType, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
    query_info: ?fn(stream: *GFileInputStream, attributes: [*]const gchar, cancellable: ?*GCancellable, error_: ?**GError) -> ?*GFileInfo
    query_info_async: ?fn(stream: *GFileInputStream, attributes: [*]const gchar, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
    query_info_finish: ?fn(stream: *GFileInputStream, result: *GAsyncResult, error_: ?**GError) -> ?*GFileInfo
    _g_reserved1: ?fn() -> void
    _g_reserved2: ?fn() -> void
    _g_reserved3: ?fn() -> void
    _g_reserved4: ?fn() -> void
    _g_reserved5: ?fn() -> void
}
pub const GFileInputStreamClass = _GFileInputStreamClass

pub extern("c") fn g_file_input_stream_get_type() -> gtype.GType

pub const G_TYPE_FILE_INPUT_STREAM: gtype.GType = g_file_input_stream_get_type()
pub fn G_FILE_INPUT_STREAM(o: anytype) -> *GFileInputStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_FILE_INPUT_STREAM, GFileInputStream) }
pub fn G_IS_FILE_INPUT_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_FILE_INPUT_STREAM) }
pub fn G_FILE_INPUT_STREAM_CLASS(k: anytype) -> *GFileInputStreamClass { return gtype.G_TYPE_CHECK_CLASS_CAST(k, G_TYPE_FILE_INPUT_STREAM, GFileInputStreamClass) }
pub fn G_FILE_INPUT_STREAM_GET_CLASS(o: anytype) -> *GFileInputStreamClass { return gtype.G_TYPE_INSTANCE_GET_CLASS(o, G_TYPE_FILE_INPUT_STREAM, GFileInputStreamClass) }
