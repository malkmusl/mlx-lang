// gio/gpowerprofilemonitor.h
// mlx-glib: GPowerProfileMonitor, whether the system saves power. The
// default monitor asks no daemon (GIO's asks power-profiles-daemon over
// D-Bus): power saving is never on.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")

const gboolean = gtypes.gboolean

pub const _GPowerProfileMonitor = struct {}
pub const GPowerProfileMonitor = _GPowerProfileMonitor

pub const _GPowerProfileMonitorInterface = struct {
    g_iface: gtype.GTypeInterface
}
pub const GPowerProfileMonitorInterface = _GPowerProfileMonitorInterface

pub extern("c") fn g_power_profile_monitor_get_type() -> gtype.GType
pub extern("c") fn g_power_profile_monitor_dup_default() -> *GPowerProfileMonitor
pub extern("c") fn g_power_profile_monitor_get_power_saver_enabled(monitor: *GPowerProfileMonitor) -> gboolean

pub const G_TYPE_POWER_PROFILE_MONITOR: gtype.GType = g_power_profile_monitor_get_type()
pub fn G_POWER_PROFILE_MONITOR(o: anytype) -> *GPowerProfileMonitor { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_POWER_PROFILE_MONITOR, GPowerProfileMonitor) }
pub fn G_IS_POWER_PROFILE_MONITOR(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_POWER_PROFILE_MONITOR) }
