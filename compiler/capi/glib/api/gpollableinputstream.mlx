// gio/gpollableinputstream.h
// mlx-glib: GPollableInputStream, an input stream that can say whether a
// read would block, read without blocking, and give a source that
// dispatches when it can be read (sockets' and memory streams).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gmain = @import("./gmain.mlx")
const giotypes = @import("./giotypes.mlx")

const gboolean = gtypes.gboolean
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GCancellable = giotypes.GCancellable

pub const _GPollableInputStream = struct {}
pub const GPollableInputStream = _GPollableInputStream

pub const _GPollableInputStreamInterface = struct {
    g_iface: gtype.GTypeInterface
    can_poll: ?fn(stream: *GPollableInputStream) -> gboolean
    is_readable: ?fn(stream: *GPollableInputStream) -> gboolean
    create_source: ?fn(stream: *GPollableInputStream, cancellable: ?*GCancellable) -> *gmain.GSource
    read_nonblocking: ?fn(stream: *GPollableInputStream, buffer: ?*anyopaque, count: gsize, error_: ?**GError) -> gssize
}
pub const GPollableInputStreamInterface = _GPollableInputStreamInterface

pub extern("c") fn g_pollable_input_stream_get_type() -> gtype.GType
pub extern("c") fn g_pollable_input_stream_can_poll(stream: *GPollableInputStream) -> gboolean
pub extern("c") fn g_pollable_input_stream_is_readable(stream: *GPollableInputStream) -> gboolean
pub extern("c") fn g_pollable_input_stream_create_source(stream: *GPollableInputStream, cancellable: ?*GCancellable) -> *gmain.GSource
pub extern("c") fn g_pollable_input_stream_read_nonblocking(stream: *GPollableInputStream, buffer: ?*anyopaque, count: gsize, cancellable: ?*GCancellable, error_: ?**GError) -> gssize

pub const G_TYPE_POLLABLE_INPUT_STREAM: gtype.GType = g_pollable_input_stream_get_type()
pub fn G_POLLABLE_INPUT_STREAM(o: anytype) -> *GPollableInputStream { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_POLLABLE_INPUT_STREAM, GPollableInputStream) }
pub fn G_IS_POLLABLE_INPUT_STREAM(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_POLLABLE_INPUT_STREAM) }
