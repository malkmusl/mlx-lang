const gclosure = @import("./gclosure.mlx")
const gsignal = @import("./gsignal.mlx")
const gobject = @import("./gobject.mlx")
const gboxed = @import("./gboxed.mlx")
const genums = @import("./genums.mlx")
const gvaluearray = @import("./gvaluearray.mlx")
