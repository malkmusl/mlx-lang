// gio/gseekable.h
// mlx-glib: GSeekable, a stream whose position can be told and moved
// (memory input streams and files read). GSeekType is GLib's
// (glib/giochannel.h there, which is not here).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")

const gboolean = gtypes.gboolean
const goffset = gtypes.goffset
const GError = gerror.GError
const GCancellable = giotypes.GCancellable

pub const GSeekType = enum(c_int) {
    G_SEEK_CUR,
    G_SEEK_SET,
    G_SEEK_END,
}

pub const _GSeekable = struct {}
pub const GSeekable = _GSeekable

pub const _GSeekableIface = struct {
    g_iface: gtype.GTypeInterface
    tell: ?fn(seekable: *GSeekable) -> goffset
    can_seek: ?fn(seekable: *GSeekable) -> gboolean
    seek: ?fn(seekable: *GSeekable, offset: goffset, type_: GSeekType, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
    can_truncate: ?fn(seekable: *GSeekable) -> gboolean
    truncate_fn: ?fn(seekable: *GSeekable, offset: goffset, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
}
pub const GSeekableIface = _GSeekableIface

pub extern("c") fn g_seekable_get_type() -> gtype.GType
pub extern("c") fn g_seekable_tell(seekable: *GSeekable) -> goffset
pub extern("c") fn g_seekable_can_seek(seekable: *GSeekable) -> gboolean
pub extern("c") fn g_seekable_seek(seekable: *GSeekable, offset: goffset, type_: GSeekType, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_seekable_can_truncate(seekable: *GSeekable) -> gboolean
pub extern("c") fn g_seekable_truncate(seekable: *GSeekable, offset: goffset, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean

pub const G_TYPE_SEEKABLE: gtype.GType = g_seekable_get_type()
pub fn G_SEEKABLE(o: anytype) -> *GSeekable { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_SEEKABLE, GSeekable) }
pub fn G_IS_SEEKABLE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_SEEKABLE) }
pub fn G_SEEKABLE_GET_IFACE(o: anytype) -> *GSeekableIface { return gtype.G_TYPE_INSTANCE_GET_INTERFACE(o, G_TYPE_SEEKABLE, GSeekableIface) }
