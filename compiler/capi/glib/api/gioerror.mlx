// gio/gioerror.h
// mlx-glib: GIO's errors (the G_IO_ERROR domain), from errno too.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gioenums = @import("./gioenums.mlx")

pub const G_IO_ERROR: gquark.GQuark = g_io_error_quark()

pub extern("c") fn g_io_error_quark() -> gquark.GQuark
pub extern("c") fn g_io_error_from_errno(err_no: gtypes.gint) -> gioenums.GIOErrorEnum
pub extern("c") fn g_io_error_from_file_error(file_error: c_int) -> gioenums.GIOErrorEnum
