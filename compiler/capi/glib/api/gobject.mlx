// gobject/gobject.h
// mlx-glib: GObject, the base class: counted references (a floating
// first one for GInitiallyUnowned), weak pointers and weak references,
// data by key, properties (installed on the class, set and read by name,
// notified by the "notify" signal) and the dispose and finalize stages.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gslist = @import("./gslist.mlx")
const gmem = @import("./gmem.mlx")
const gtype = @import("./gtype.mlx")
const gvalue = @import("./gvalue.mlx")
const gparam = @import("./gparam.mlx")
const gclosure = @import("./gclosure.mlx")
const gsignal = @import("./gsignal.mlx")
const gdataset = @import("./gdataset.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const gulong = gtypes.gulong
const gsize = gtypes.gsize
const gpointer = gtypes.gpointer
const GType = gtype.GType
const GQuark = gquark.GQuark
const GValue = gvalue.GValue
const GParamSpec = gparam.GParamSpec
const GClosure = gclosure.GClosure

const GData = gdataset.GData

pub const _GObject = struct {
    g_type_instance: gtype.GTypeInstance
    ref_count: guint
    qdata: *GData
}
pub const GObject = _GObject

pub const _GObjectConstructParam = struct {
    pspec: *GParamSpec
    value: *GValue
}
pub const GObjectConstructParam = _GObjectConstructParam

pub const _GObjectClass = struct {
    g_type_class: gtype.GTypeClass
    construct_properties: *gslist.GSList
    constructor: fn(type_: GType, n_construct_properties: guint, construct_properties: *GObjectConstructParam) -> *GObject
    set_property: fn(object: *GObject, property_id: guint, value: *const GValue, pspec: *GParamSpec) -> void
    get_property: fn(object: *GObject, property_id: guint, value: *GValue, pspec: *GParamSpec) -> void
    dispose: fn(object: *GObject) -> void
    finalize: fn(object: *GObject) -> void
    dispatch_properties_changed: fn(object: *GObject, n_pspecs: guint, pspecs: **GParamSpec) -> void
    notify: fn(object: *GObject, pspec: *GParamSpec) -> void
    constructed: fn(object: *GObject) -> void
    flags: gsize
    n_construct_properties: gsize
    pspecs: gpointer
    n_pspecs: gsize
    pdummy: [3]gpointer
}
pub const GObjectClass = _GObjectClass

pub const GInitiallyUnowned = GObject
pub const GInitiallyUnownedClass = GObjectClass

pub const GObjectGetPropertyFunc = fn(object: *GObject, property_id: guint, value: *GValue, pspec: *GParamSpec) -> void
pub const GObjectSetPropertyFunc = fn(object: *GObject, property_id: guint, value: *const GValue, pspec: *GParamSpec) -> void
pub const GObjectFinalizeFunc = fn(object: *GObject) -> void
pub const GWeakNotify = fn(data: gpointer, where_the_object_was: *GObject) -> void
pub const GToggleNotify = fn(data: gpointer, object: *GObject, is_last_ref: gboolean) -> void
pub const GDuplicateFunc = fn(data: gpointer, user_data: gpointer) -> gpointer

// A weak reference safe across threads (its word is the library's own).
pub const GWeakRef = struct {
    priv: union { p: gpointer }
}

pub extern("c") fn g_initially_unowned_get_type() -> GType
pub const G_TYPE_INITIALLY_UNOWNED: GType = g_initially_unowned_get_type()

pub extern("c") fn g_object_class_install_property(oclass: *GObjectClass, property_id: guint, pspec: *GParamSpec) -> void
pub extern("c") fn g_object_class_install_properties(oclass: *GObjectClass, n_pspecs: guint, pspecs: **GParamSpec) -> void
pub extern("c") fn g_object_class_find_property(oclass: *GObjectClass, property_name: [*]const gchar) -> ?*GParamSpec
pub extern("c") fn g_object_class_list_properties(oclass: *GObjectClass, n_properties: *guint) -> **GParamSpec
pub extern("c") fn g_object_class_override_property(oclass: *GObjectClass, property_id: guint, name: [*]const gchar) -> void
pub extern("c") fn g_object_interface_install_property(g_iface: gpointer, pspec: *GParamSpec) -> void
pub extern("c") fn g_object_interface_find_property(g_iface: gpointer, property_name: [*]const gchar) -> ?*GParamSpec
pub extern("c") fn g_object_interface_list_properties(g_iface: gpointer, n_properties_p: *guint) -> **GParamSpec
pub extern("c") fn g_object_get_type() -> GType
pub extern("c") fn g_object_new(object_type: GType, first_property_name: ?[*]const gchar, args: gtypes.c_varargs) -> gpointer
pub extern("c") fn g_object_new_with_properties(object_type: GType, n_properties: guint, names: ?[*][*]const c_char, values: ?*const GValue) -> *GObject
pub extern("c") fn g_object_new_valist(object_type: GType, first_property_name: ?[*]const gchar, var_args: gtypes.c_va_list) -> *GObject
pub extern("c") fn g_object_set(object: gpointer, first_property_name: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_object_get(object: gpointer, first_property_name: [*]const gchar, args: gtypes.c_varargs) -> void
pub extern("c") fn g_object_set_valist(object: *GObject, first_property_name: [*]const gchar, var_args: gtypes.c_va_list) -> void
pub extern("c") fn g_object_get_valist(object: *GObject, first_property_name: [*]const gchar, var_args: gtypes.c_va_list) -> void
pub extern("c") fn g_object_setv(object: *GObject, n_properties: guint, names: [*][*]const gchar, values: *const GValue) -> void
pub extern("c") fn g_object_getv(object: *GObject, n_properties: guint, names: [*][*]const gchar, values: *GValue) -> void
pub extern("c") fn g_object_set_property(object: *GObject, property_name: [*]const gchar, value: *const GValue) -> void
pub extern("c") fn g_object_get_property(object: *GObject, property_name: [*]const gchar, value: *GValue) -> void
pub extern("c") fn g_object_freeze_notify(object: *GObject) -> void
pub extern("c") fn g_object_notify(object: *GObject, property_name: [*]const gchar) -> void
pub extern("c") fn g_object_notify_by_pspec(object: *GObject, pspec: *GParamSpec) -> void
pub extern("c") fn g_object_thaw_notify(object: *GObject) -> void
pub extern("c") fn g_object_is_floating(object: gpointer) -> gboolean
pub extern("c") fn g_object_ref_sink(object: gpointer) -> gpointer
pub extern("c") fn g_object_take_ref(object: gpointer) -> gpointer
pub extern("c") fn g_object_ref(object: gpointer) -> gpointer
pub extern("c") fn g_object_unref(object: gpointer) -> void
pub extern("c") fn g_object_weak_ref(object: *GObject, notify: GWeakNotify, data: gpointer) -> void
pub extern("c") fn g_object_weak_unref(object: *GObject, notify: GWeakNotify, data: gpointer) -> void
pub extern("c") fn g_object_add_weak_pointer(object: *GObject, weak_pointer_location: *gpointer) -> void
pub extern("c") fn g_object_remove_weak_pointer(object: *GObject, weak_pointer_location: *gpointer) -> void
pub extern("c") fn g_object_add_toggle_ref(object: *GObject, notify: GToggleNotify, data: gpointer) -> void
pub extern("c") fn g_object_remove_toggle_ref(object: *GObject, notify: GToggleNotify, data: gpointer) -> void
pub extern("c") fn g_object_get_qdata(object: *GObject, quark: GQuark) -> gpointer
pub extern("c") fn g_object_set_qdata(object: *GObject, quark: GQuark, data: gpointer) -> void
pub extern("c") fn g_object_set_qdata_full(object: *GObject, quark: GQuark, data: gpointer, destroy: gtypes.GDestroyNotify) -> void
pub extern("c") fn g_object_steal_qdata(object: *GObject, quark: GQuark) -> gpointer
pub extern("c") fn g_object_get_data(object: *GObject, key: [*]const gchar) -> gpointer
pub extern("c") fn g_object_set_data(object: *GObject, key: [*]const gchar, data: gpointer) -> void
pub extern("c") fn g_object_set_data_full(object: *GObject, key: [*]const gchar, data: gpointer, destroy: gtypes.GDestroyNotify) -> void
pub extern("c") fn g_object_steal_data(object: *GObject, key: [*]const gchar) -> gpointer
pub extern("c") fn g_object_dup_data(object: *GObject, key: [*]const gchar, dup_func: GDuplicateFunc, user_data: gpointer) -> gpointer
pub extern("c") fn g_object_watch_closure(object: *GObject, closure: *GClosure) -> void
pub extern("c") fn g_cclosure_new_object(callback_func: gclosure.GCallback, object: *GObject) -> *GClosure
pub extern("c") fn g_cclosure_new_object_swap(callback_func: gclosure.GCallback, object: *GObject) -> *GClosure
pub extern("c") fn g_closure_new_object(sizeof_closure: guint, object: *GObject) -> *GClosure
pub extern("c") fn g_value_set_object(value: *GValue, v_object: gpointer) -> void
pub extern("c") fn g_value_get_object(value: *const GValue) -> gpointer
pub extern("c") fn g_value_dup_object(value: *const GValue) -> gpointer
pub extern("c") fn g_value_take_object(value: *GValue, v_object: gpointer) -> void
pub extern("c") fn g_signal_connect_object(instance: gpointer, detailed_signal: [*]const gchar, c_handler: gclosure.GCallback, gobject: gpointer, connect_flags: gsignal.GConnectFlags) -> gulong
pub extern("c") fn g_object_force_floating(object: *GObject) -> void
pub extern("c") fn g_object_run_dispose(object: *GObject) -> void
pub extern("c") fn g_object_compat_control(what: gsize, data: gpointer) -> gsize
// Drops the reference `*object_ptr` holds and clears it.
pub inline fn g_clear_object(object_ptr: anytype) -> void { gmem.g_clear_pointer(object_ptr, g_object_unref) }
pub extern("c") fn g_weak_ref_init(weak_ref: *GWeakRef, object: gpointer) -> void
pub extern("c") fn g_weak_ref_clear(weak_ref: *GWeakRef) -> void
pub extern("c") fn g_weak_ref_get(weak_ref: *GWeakRef) -> gpointer
pub extern("c") fn g_weak_ref_set(weak_ref: *GWeakRef, object: gpointer) -> void

pub fn G_TYPE_IS_OBJECT(type_: GType) -> bool { return gtype.G_TYPE_FUNDAMENTAL(type_) == gtype.G_TYPE_OBJECT }
pub fn G_OBJECT(object: anytype) -> *GObject { return gtype.G_TYPE_CHECK_INSTANCE_CAST(object, gtype.G_TYPE_OBJECT, GObject) }
pub fn G_OBJECT_CLASS(klass: anytype) -> *GObjectClass { return gtype.G_TYPE_CHECK_CLASS_CAST(klass, gtype.G_TYPE_OBJECT, GObjectClass) }
pub fn G_IS_OBJECT(object: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_FUNDAMENTAL_TYPE(object, gtype.G_TYPE_OBJECT) }
pub fn G_IS_OBJECT_CLASS(klass: anytype) -> bool { return gtype.G_TYPE_CHECK_CLASS_TYPE(klass, gtype.G_TYPE_OBJECT) }
pub fn G_OBJECT_GET_CLASS(object: anytype) -> *GObjectClass { return gtype.G_TYPE_INSTANCE_GET_CLASS(object, gtype.G_TYPE_OBJECT, GObjectClass) }
pub fn G_OBJECT_TYPE(object: anytype) -> GType { return gtype.G_TYPE_FROM_INSTANCE(object) }
pub fn G_OBJECT_TYPE_NAME(object: anytype) -> [*]const gchar { return gtype.g_type_name(G_OBJECT_TYPE(object)) }
pub fn G_OBJECT_CLASS_TYPE(klass: anytype) -> GType { return gtype.G_TYPE_FROM_CLASS(klass) }
pub fn G_OBJECT_CLASS_NAME(klass: anytype) -> [*]const gchar { return gtype.g_type_name(G_OBJECT_CLASS_TYPE(klass)) }
pub fn G_VALUE_HOLDS_OBJECT(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_OBJECT) }
pub fn G_INITIALLY_UNOWNED(object: anytype) -> *GObject { return gtype.G_TYPE_CHECK_INSTANCE_CAST(object, G_TYPE_INITIALLY_UNOWNED, GObject) }
pub fn G_IS_INITIALLY_UNOWNED(object: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(object, G_TYPE_INITIALLY_UNOWNED) }

// The warning of a property id a class does not know.
pub extern("c") fn g_object_warn_invalid_pspec(object: gpointer, what: [*]const gchar, property_id: guint, pspec: *GParamSpec) -> void
pub fn G_OBJECT_WARN_INVALID_PROPERTY_ID(object: anytype, property_id: guint, pspec: anytype) -> void {
    g_object_warn_invalid_pspec(object, "property", property_id, pspec)
}
