// gio/gpollableutils.h
// mlx-glib: the sources of pollable streams: dispatched when the child
// source of the stream's readiness (or the cancellable) is, calling a
// GPollableSourceFunc with the stream.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gmain = @import("./gmain.mlx")
const gobject = @import("./gobject.mlx")
const giotypes = @import("./giotypes.mlx")

pub const GPollableSourceFunc = fn(pollable_stream: *gobject.GObject, data: gtypes.gpointer) -> gtypes.gboolean

pub extern("c") fn g_pollable_source_new(pollable_stream: *gobject.GObject) -> *gmain.GSource
pub extern("c") fn g_pollable_source_new_full(pollable_stream: gtypes.gpointer, child_source: ?*gmain.GSource, cancellable: ?*giotypes.GCancellable) -> *gmain.GSource
