// gobject/genums.h
// mlx-glib: enumeration and flags types (their values with names and
// nicks), as glib-mkenums registers them.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const gvalue = @import("./gvalue.mlx")

const gchar = gtypes.gchar
const gint = gtypes.gint
const guint = gtypes.guint
const GType = gtype.GType
const GValue = gvalue.GValue

pub const _GEnumValue = struct {
    value: gint
    value_name: [*]const gchar
    value_nick: [*]const gchar
}
pub const GEnumValue = _GEnumValue

pub const _GFlagsValue = struct {
    value: guint
    value_name: [*]const gchar
    value_nick: [*]const gchar
}
pub const GFlagsValue = _GFlagsValue

pub const _GEnumClass = struct {
    g_type_class: gtype.GTypeClass
    minimum: gint
    maximum: gint
    n_values: guint
    values: *GEnumValue
}
pub const GEnumClass = _GEnumClass

pub const _GFlagsClass = struct {
    g_type_class: gtype.GTypeClass
    mask: guint
    n_values: guint
    values: *GFlagsValue
}
pub const GFlagsClass = _GFlagsClass

pub extern("c") fn g_enum_get_value(enum_class: *GEnumClass, value: gint) -> ?*GEnumValue
pub extern("c") fn g_enum_get_value_by_name(enum_class: *GEnumClass, name: [*]const gchar) -> ?*GEnumValue
pub extern("c") fn g_enum_get_value_by_nick(enum_class: *GEnumClass, nick: [*]const gchar) -> ?*GEnumValue
pub extern("c") fn g_flags_get_first_value(flags_class: *GFlagsClass, value: guint) -> ?*GFlagsValue
pub extern("c") fn g_flags_get_value_by_name(flags_class: *GFlagsClass, name: [*]const gchar) -> ?*GFlagsValue
pub extern("c") fn g_flags_get_value_by_nick(flags_class: *GFlagsClass, nick: [*]const gchar) -> ?*GFlagsValue
pub extern("c") fn g_enum_to_string(g_enum_type: GType, value: gint) -> [*]gchar
pub extern("c") fn g_flags_to_string(flags_type: GType, value: guint) -> [*]gchar
pub extern("c") fn g_value_set_enum(value: *GValue, v_enum: gint) -> void
pub extern("c") fn g_value_get_enum(value: *const GValue) -> gint
pub extern("c") fn g_value_set_flags(value: *GValue, v_flags: guint) -> void
pub extern("c") fn g_value_get_flags(value: *const GValue) -> guint
pub extern("c") fn g_enum_register_static(name: [*]const gchar, const_static_values: *const GEnumValue) -> GType
pub extern("c") fn g_flags_register_static(name: [*]const gchar, const_static_values: *const GFlagsValue) -> GType

pub fn G_TYPE_IS_ENUM(type_: GType) -> bool { return gtype.G_TYPE_FUNDAMENTAL(type_) == gtype.G_TYPE_ENUM }
pub fn G_TYPE_IS_FLAGS(type_: GType) -> bool { return gtype.G_TYPE_FUNDAMENTAL(type_) == gtype.G_TYPE_FLAGS }
pub fn G_ENUM_CLASS(klass: anytype) -> *GEnumClass { return gtype.G_TYPE_CHECK_CLASS_CAST(klass, gtype.G_TYPE_ENUM, GEnumClass) }
pub fn G_FLAGS_CLASS(klass: anytype) -> *GFlagsClass { return gtype.G_TYPE_CHECK_CLASS_CAST(klass, gtype.G_TYPE_FLAGS, GFlagsClass) }
pub fn G_VALUE_HOLDS_ENUM(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_ENUM) }
pub fn G_VALUE_HOLDS_FLAGS(value: anytype) -> bool { return gtype.G_TYPE_CHECK_VALUE_TYPE(value, gtype.G_TYPE_FLAGS) }
