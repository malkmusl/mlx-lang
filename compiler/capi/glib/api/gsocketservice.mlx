// gio/gsocketservice.h
// mlx-glib: GSocketService, a listener that accepts connections in the
// main context it was made in and tells them by its "incoming" signal
// (connection, source object; a handler returning TRUE stops the
// others).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gobject = @import("./gobject.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")
const gsocketlistener = @import("./gsocketlistener.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const guint8 = gtypes.guint8
const guint16 = gtypes.guint16
const guint32 = gtypes.guint32
const gint = gtypes.gint
const guint = gtypes.guint
const gsize = gtypes.gsize
const gssize = gtypes.gssize
const GError = gerror.GError
const GObject = gobject.GObject
const GCancellable = giotypes.GCancellable
const GSocketAddress = giotypes.GSocketAddress
const GSocketConnection = giotypes.GSocketConnection
const GSocket = giotypes.GSocket
const GAsyncResult = giotypes.GAsyncResult

pub const _GSocketService = struct {}
pub const GSocketService = _GSocketService

pub extern("c") fn g_socket_service_get_type() -> gtype.GType
pub extern("c") fn g_socket_service_new() -> *GSocketService
pub extern("c") fn g_socket_service_start(service: *GSocketService) -> void
pub extern("c") fn g_socket_service_stop(service: *GSocketService) -> void
pub extern("c") fn g_socket_service_is_active(service: *GSocketService) -> gboolean

pub const G_TYPE_SOCKET_SERVICE: gtype.GType = g_socket_service_get_type()
pub fn G_SOCKET_SERVICE(o: anytype) -> *GSocketService { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_SOCKET_SERVICE, GSocketService) }
pub fn G_IS_SOCKET_SERVICE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_SOCKET_SERVICE) }
