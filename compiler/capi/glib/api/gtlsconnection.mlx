// gio/gtlsconnection.h
// mlx-glib: GTlsConnection, a TLS connection over a GIOStream (std.tls:
// TLS 1.3 and 1.2), and the TLS errors (G_TLS_ERROR). The handshake,
// synchronous or asynchronous, verifies the peer's chain against the
// connection's database and emits "accept-certificate" when it does not
// verify; the connection's streams then encrypt and decrypt.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gquark = @import("./gquark.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const gioenums = @import("./gioenums.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GTlsConnection = giotypes.GTlsConnection
const GTlsCertificate = giotypes.GTlsCertificate
const GTlsDatabase = giotypes.GTlsDatabase
const GTlsInteraction = giotypes.GTlsInteraction
const GCancellable = giotypes.GCancellable
const GAsyncResult = giotypes.GAsyncResult
const GAsyncReadyCallback = giotypes.GAsyncReadyCallback

pub extern("c") fn g_tls_connection_get_type() -> gtype.GType
pub extern("c") fn g_tls_error_quark() -> gquark.GQuark
pub extern("c") fn g_tls_channel_binding_error_quark() -> gquark.GQuark

pub extern("c") fn g_tls_connection_handshake(conn: *GTlsConnection, cancellable: ?*GCancellable, error_: ?**GError) -> gboolean
pub extern("c") fn g_tls_connection_handshake_async(conn: *GTlsConnection, io_priority: c_int, cancellable: ?*GCancellable, callback: ?GAsyncReadyCallback, user_data: gpointer) -> void
pub extern("c") fn g_tls_connection_handshake_finish(conn: *GTlsConnection, result: *GAsyncResult, error_: ?**GError) -> gboolean
pub extern("c") fn g_tls_connection_set_database(conn: *GTlsConnection, database: ?*GTlsDatabase) -> void
pub extern("c") fn g_tls_connection_get_database(conn: *GTlsConnection) -> ?*GTlsDatabase
pub extern("c") fn g_tls_connection_set_certificate(conn: *GTlsConnection, certificate: *GTlsCertificate) -> void
pub extern("c") fn g_tls_connection_get_certificate(conn: *GTlsConnection) -> ?*GTlsCertificate
pub extern("c") fn g_tls_connection_set_interaction(conn: *GTlsConnection, interaction: ?*GTlsInteraction) -> void
pub extern("c") fn g_tls_connection_get_interaction(conn: *GTlsConnection) -> ?*GTlsInteraction
pub extern("c") fn g_tls_connection_get_peer_certificate(conn: *GTlsConnection) -> ?*GTlsCertificate
pub extern("c") fn g_tls_connection_get_peer_certificate_errors(conn: *GTlsConnection) -> gioenums.GTlsCertificateFlags
pub extern("c") fn g_tls_connection_set_require_close_notify(conn: *GTlsConnection, require_close_notify: gboolean) -> void
pub extern("c") fn g_tls_connection_get_require_close_notify(conn: *GTlsConnection) -> gboolean
pub extern("c") fn g_tls_connection_set_use_system_certdb(conn: *GTlsConnection, use_system_certdb: gboolean) -> void
pub extern("c") fn g_tls_connection_get_use_system_certdb(conn: *GTlsConnection) -> gboolean
pub extern("c") fn g_tls_connection_set_rehandshake_mode(conn: *GTlsConnection, mode: gioenums.GTlsRehandshakeMode) -> void
pub extern("c") fn g_tls_connection_get_rehandshake_mode(conn: *GTlsConnection) -> gioenums.GTlsRehandshakeMode
pub extern("c") fn g_tls_connection_set_advertised_protocols(conn: *GTlsConnection, protocols: ?[*]const [*]const gchar) -> void
pub extern("c") fn g_tls_connection_get_negotiated_protocol(conn: *GTlsConnection) -> ?[*]const gchar
pub extern("c") fn g_tls_connection_get_protocol_version(conn: *GTlsConnection) -> gioenums.GTlsProtocolVersion
pub extern("c") fn g_tls_connection_get_ciphersuite_name(conn: *GTlsConnection) -> ?[*]gchar
pub extern("c") fn g_tls_connection_emit_accept_certificate(conn: *GTlsConnection, peer_cert: *GTlsCertificate, errors: gioenums.GTlsCertificateFlags) -> gboolean

pub const G_TYPE_TLS_CONNECTION: gtype.GType = g_tls_connection_get_type()
pub fn G_TLS_CONNECTION(o: anytype) -> *GTlsConnection { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TLS_CONNECTION, GTlsConnection) }
pub fn G_IS_TLS_CONNECTION(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TLS_CONNECTION) }

pub const G_TLS_ERROR: gquark.GQuark = g_tls_error_quark()
pub const G_TLS_CHANNEL_BINDING_ERROR: gquark.GQuark = g_tls_channel_binding_error_quark()
