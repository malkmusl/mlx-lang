// gio/gtlsfiledatabase.h
// mlx-glib: GTlsFileDatabase, a database of the certificates in a PEM
// file. Without a TLS implementation g_tls_file_database_new fails with
// G_TLS_ERROR_UNAVAILABLE ("TLS support is not available"), as GIO's
// does when no TLS module is installed.
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gerror = @import("./gerror.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")

const gchar = gtypes.gchar
const GTlsFileDatabase = giotypes.GTlsFileDatabase

pub extern("c") fn g_tls_file_database_get_type() -> gtype.GType
pub extern("c") fn g_tls_file_database_new(anchors: [*]const gchar, error_: ?**gerror.GError) -> ?*giotypes.GTlsDatabase

pub const G_TYPE_TLS_FILE_DATABASE: gtype.GType = g_tls_file_database_get_type()
pub fn G_TLS_FILE_DATABASE(o: anytype) -> *GTlsFileDatabase { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TLS_FILE_DATABASE, GTlsFileDatabase) }
pub fn G_IS_TLS_FILE_DATABASE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TLS_FILE_DATABASE) }
