// gio/gtlsdatabase.h
// mlx-glib: GTlsDatabase, the certificates a TLS backend trusts. The
// type is here for what names it; the backend here has no database (no
// default one, and a file database cannot be made).
const c_function_pointers = true
const gtypes = @import("./gtypes.mlx")
const gtype = @import("./gtype.mlx")
const giotypes = @import("./giotypes.mlx")

const GTlsDatabase = giotypes.GTlsDatabase

pub extern("c") fn g_tls_database_get_type() -> gtype.GType

pub const G_TYPE_TLS_DATABASE: gtype.GType = g_tls_database_get_type()
pub fn G_TLS_DATABASE(o: anytype) -> *GTlsDatabase { return gtype.G_TYPE_CHECK_INSTANCE_CAST(o, G_TYPE_TLS_DATABASE, GTlsDatabase) }
pub fn G_IS_TLS_DATABASE(o: anytype) -> bool { return gtype.G_TYPE_CHECK_INSTANCE_TYPE(o, G_TYPE_TLS_DATABASE) }
