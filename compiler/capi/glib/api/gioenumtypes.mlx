// gio/gioenumtypes.h
// mlx-glib: the GTypes of GIO's enumerations that have one here (each
// registered with GIO's value names and nicks).
const c_function_pointers = true
const gtype = @import("./gtype.mlx")

pub extern("c") fn g_socket_client_event_get_type() -> gtype.GType
pub extern("c") fn g_tls_authentication_mode_get_type() -> gtype.GType
pub extern("c") fn g_dbus_connection_flags_get_type() -> gtype.GType

pub const G_TYPE_SOCKET_CLIENT_EVENT: gtype.GType = g_socket_client_event_get_type()
pub const G_TYPE_TLS_AUTHENTICATION_MODE: gtype.GType = g_tls_authentication_mode_get_type()
pub const G_TYPE_DBUS_CONNECTION_FLAGS: gtype.GType = g_dbus_connection_flags_get_type()
