// GResource (gresource.h): the GVDB files glib-compile-resources writes,
// read as GIO's gvdb-reader.c reads them, and the resources registered
// for lookups by path.
//
// A GVDB file: a header ("GVariant", version, options, the root table),
// then hash tables: their bloom filter, buckets and items (hash, parent,
// key segment, type, value). A key is found by its djb hash's bucket and
// its segments compared from the end up through the parents. In a
// resource every path is a key: a file's value a variant "(uuay)" (its
// size, flags (1: zlib-compressed) and data, a NUL after it), a
// directory's ("/a/b/") a list of its children's items.
//
// A GResource: references (0), its GBytes (8), the root table's start
// (16) and end (24).
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const messages = @import("./messages.mlx")
const arrays = @import("./arrays.mlx")
const hash = @import("./hash.mlx")
const strings = @import("./strings.mlx")
const values = @import("./values.mlx")
const flate = @import("std.flate")

extern("c") fn g_resource_error_quark() -> u32
extern("c") fn g_file_error_quark() -> u32
extern("c") fn g_mapped_file_new(filename: usize, writable: i32, err: usize) -> usize
extern("c") fn g_mapped_file_get_bytes(file: usize) -> usize
extern("c") fn g_mapped_file_unref(file: usize) -> void

const R_REFS: usize = 0
const R_BYTES: usize = 8
const R_START: usize = 16
const R_END: usize = 24
const R_SIZE: usize = 32

const COMPRESSED: u32 = 1

var registered: usize = 0
var registryLock: u32 = 0
var resourceTypeId: usize = 0
var resourceTypeOnce: u64 = 0

fn dataOf(r: usize) -> usize { return arrays.bytesData(m.getWord(r + R_BYTES)) }
fn sizeOf(r: usize) -> usize { return arrays.bytesSize(m.getWord(r + R_BYTES)) }

// ---------------------------------------------------------------------------
// The GVDB table

// The table's parts: bloom words, buckets, items and how many.
const Table = struct {
    buckets: usize
    nBuckets: usize
    items: usize
    nItems: usize
}

fn tableOf(r: usize) -> Table {
    const data = dataOf(r)
    const start = m.getWord(r + R_START)
    const end = m.getWord(r + R_END)
    var t = Table.{ .buckets = 0, .nBuckets = 0, .items = 0, .nItems = 0 }
    if end < start + 8 { return t }
    const bloom = @intCast(usize, m.get32(data + start) & ((1 << 27) - 1))
    const nBuckets = @intCast(usize, m.get32(data + start + 4))
    const buckets = start + 8 + bloom * 4
    const items = buckets + nBuckets * 4
    if items > end { return t }
    t.buckets = data + buckets
    t.nBuckets = nBuckets
    t.items = data + items
    t.nItems = (end - items) / 24
    return t
}

fn djb(start: usize, length: usize) -> u32 {
    var h: u32 = 5381
    var i: usize = 0
    while i < length {
        h = (h << 5) +% h +% @bitCast(u32, @intCast(i32, @bitCast(i8, m.get8(start + i))))
        i += 1
    }
    return h
}

// Whether item `index`'s key (its segment and its parents') is the
// `length` bytes at `key`.
fn checkName(r: usize, t: Table, index: usize, key: usize, length: usize) -> bool {
    const item = t.items + index * 24
    const start = @intCast(usize, m.get32(item + 8))
    const size = @intCast(usize, m.get16(item + 12))
    if start + size > sizeOf(r) || size > length { return false }
    const data = dataOf(r)
    var i: usize = 0
    while i < size {
        if m.get8(data + start + i) != m.get8(key + length - size + i) { return false }
        i += 1
    }
    const parent = m.get32(item + 4)
    if parent == 0xffffffff { return size == length }
    if @intCast(usize, parent) >= t.nItems { return false }
    return checkName(r, t, @intCast(usize, parent), key, length - size)
}

// The item of the key and type ('v' a value, 'L' a list), -1 if none.
fn lookup(r: usize, key: usize, length: usize, kind: u8) -> isize {
    const t = tableOf(r)
    if t.nBuckets == 0 || t.nItems == 0 { return -1 }
    const h = djb(key, length)
    const bucket = @intCast(usize, h % @intCast(u32, t.nBuckets))
    var index = @intCast(usize, m.get32(t.buckets + bucket * 4))
    var last = t.nItems
    if bucket + 1 < t.nBuckets {
        const next = @intCast(usize, m.get32(t.buckets + (bucket + 1) * 4))
        if next <= t.nItems { last = next }
    }
    while index < last {
        const item = t.items + index * 24
        if m.get32(item) == h && checkName(r, t, index, key, length) && m.get8(item + 14) == kind { return @intCast(isize, index) }
        index += 1
    }
    return -1
}

// The value pointer of an item: its start (0) and end (4), checked.
fn valueRange(r: usize, item: usize, start: *usize, end: *usize) -> bool {
    const s = @intCast(usize, m.get32(item + 16))
    const e = @intCast(usize, m.get32(item + 20))
    if s > e || e > sizeOf(r) { return false }
    start.* = s
    end.* = e
    return true
}

// ---------------------------------------------------------------------------
// GResource

fn resourceError(err: usize, code: i32, path: usize) -> void {
    if err == 0 { return }
    var t = m.text()
    m.pushText(&t, "The resource at “")
    m.pushC(&t, path)
    m.pushText(&t, "” does not exist")
    errors.report(err, errors.newError(g_resource_error_quark(), code, m.finish(&t)))
}

export fn g_resource_new_from_data(data: usize, err: usize) -> usize {
    const d = arrays.bytesData(data)
    const n = arrays.bytesSize(data)
    if n < 24 || m.get32(d) != 0x72615647 || m.get32(d + 4) != 0x746e6169 {
        errors.set(err, g_file_error_quark(), 17, "invalid gvdb header")
        return 0
    }
    const start = @intCast(usize, m.get32(d + 16))
    const end = @intCast(usize, m.get32(d + 20))
    if start > end || end > n {
        errors.set(err, g_file_error_quark(), 17, "invalid gvdb header")
        return 0
    }
    const r = m.alloc(R_SIZE)
    m.put32(r + R_REFS, 1)
    m.putWord(r + R_BYTES, arrays.bytesRef(data))
    m.putWord(r + R_START, start)
    m.putWord(r + R_END, end)
    return r
}

export fn g_resource_ref(r: usize) -> usize {
    threads.refInc(r + R_REFS)
    return r
}

export fn g_resource_unref(r: usize) -> void {
    if threads.refDec(r + R_REFS) {
        arrays.bytesUnref(m.getWord(r + R_BYTES))
        m.release(r)
    }
}

export fn g_resource_load(filename: usize, err: usize) -> usize {
    const mapped = g_mapped_file_new(filename, 0, err)
    if mapped == 0 { return 0 }
    const bytes = g_mapped_file_get_bytes(mapped)
    g_mapped_file_unref(mapped)
    const r = g_resource_new_from_data(bytes, err)
    arrays.bytesUnref(bytes)
    return r
}

export fn g_resource_get_type() -> usize {
    if threads.onceEnter(@intFromPtr(&resourceTypeOnce)) {
        resourceTypeId = values.registerBoxed(m.literal("GResource"), @intFromPtr(g_resource_ref), @intFromPtr(g_resource_unref))
        threads.onceLeave(@intFromPtr(&resourceTypeOnce), 1)
    }
    return resourceTypeId
}

// A file's entry: its size (0), flags (4), data (8) and their size (16).
fn findFile(r: usize, path: usize, out: usize) -> bool {
    var length = m.cLength(path)
    if length > 1 && m.get8(path + length - 1) == '/' { length -= 1 }
    const index = lookup(r, path, length, 'v')
    if index < 0 { return false }
    const t = tableOf(r)
    const item = t.items + @intCast(usize, index) * 24
    var start: usize = 0
    var end: usize = 0
    if !valueRange(r, item, &start, &end) { return false }
    // A variant: "(uuay)", then a NUL, then its type string.
    const data = dataOf(r)
    var p = end
    while p > start && m.get8(data + p - 1) != 0 { p -= 1 }
    if p <= start + 8 { return false }
    // ("(uuay)" has no framing offsets: its last item runs to the end.)
    const body = data + start
    const bodySize = p - 1 - start
    m.put32(out, m.get32(body))
    m.put32(out + 4, m.get32(body + 4))
    m.putWord(out + 8, body + 8)
    m.putWord(out + 16, bodySize - 8)
    return true
}

fn lookupData(r: usize, path: usize, err: usize) -> usize {
    const entry = m.alloc(24)
    if !findFile(r, path, entry) {
        m.release(entry)
        resourceError(err, 0, path)
        return 0
    }
    const size = @intCast(usize, m.get32(entry))
    const flags = m.get32(entry + 4)
    const data = m.getWord(entry + 8)
    const dataSize = m.getWord(entry + 16)
    m.release(entry)
    if (flags & COMPRESSED) != 0 {
        // A zlib stream of `size` bytes (glib-compile-resources compresses
        // with zlib's format), the Adler-32 checked.
        const result = m.alloc(size)
        var inflated: usize = 0
        unsafe { inflated = flate.decompress(@ptrFromInt([*]const u8, data), dataSize, @ptrFromInt([*]u8, result), size, flate.Format.zlib) }
        if inflated != size {
            m.release(result)
            var t = m.text()
            m.pushText(&t, "The resource at “")
            m.pushC(&t, path)
            m.pushText(&t, "” failed to decompress")
            if err != 0 { errors.report(err, errors.newError(g_resource_error_quark(), 1, m.finish(&t))) } else { m.dispose(&t) }
            return 0
        }
        return arrays.newBytes(result, size, arrays.freeFunction(), result)
    }
    if size > dataSize { return 0 }
    return arrays.newBytes(data, size, arrays.bytesUnrefFunction(), arrays.bytesRef(m.getWord(r + R_BYTES)))
}

export fn g_resource_lookup_data(r: usize, path: usize, lookup_flags: i32, err: usize) -> usize { return lookupData(r, path, err) }

export fn g_resource_get_info(r: usize, path: usize, lookup_flags: i32, size: usize, flags: usize, err: usize) -> i32 {
    const entry = m.alloc(24)
    const found = findFile(r, path, entry)
    if found {
        if size != 0 { m.putWord(size, @intCast(usize, m.get32(entry))) }
        if flags != 0 { m.put32(flags, m.get32(entry + 4)) }
    } else {
        resourceError(err, 0, path)
    }
    m.release(entry)
    return if found { 1 } else { 0 }
}

// The names of a directory's children (pushed to `names`, words of C
// strings the caller frees), false when the directory is not there.
fn children(r: usize, path: usize, names: *m.Words) -> bool {
    var key = m.text()
    m.pushC(&key, path)
    if key.length == 0 || m.get8(key.address + key.length - 1) != '/' { m.pushByte(&key, '/') }
    const index = lookup(r, key.address, key.length, 'L')
    m.dispose(&key)
    if index < 0 { return false }
    const t = tableOf(r)
    const item = t.items + @intCast(usize, index) * 24
    var start: usize = 0
    var end: usize = 0
    if !valueRange(r, item, &start, &end) { return false }
    const data = dataOf(r)
    var p = start
    while p + 4 <= end {
        const child = @intCast(usize, m.get32(data + p))
        if child < t.nItems {
            const childItem = t.items + child * 24
            const keyStart = @intCast(usize, m.get32(childItem + 8))
            const keySize = @intCast(usize, m.get16(childItem + 12))
            if keyStart + keySize <= sizeOf(r) { m.pushWord(names, m.dupBytes(data + keyStart, keySize)) }
        }
        p += 4
    }
    return true
}

fn strvOf(names: *m.Words) -> usize {
    m.pushWord(names, 0)
    return m.finishWords(names)
}

export fn g_resource_enumerate_children(r: usize, path: usize, lookup_flags: i32, err: usize) -> usize {
    var names = m.words()
    if !children(r, path, &names) {
        m.disposeWords(&names)
        resourceError(err, 0, path)
        return 0
    }
    return strvOf(&names)
}

// ---------------------------------------------------------------------------
// The registered resources (the last registered first).

fn registry() -> *m.Words {
    if registered == 0 { registered = m.alloc(24) }
    unsafe { return @ptrFromInt(*m.Words, registered) }
}

export fn g_resources_register(r: usize) -> void {
    threads.lock(@intFromPtr(&registryLock))
    m.pushWord(registry(), g_resource_ref(r))
    threads.unlock(@intFromPtr(&registryLock))
}

export fn g_resources_unregister(r: usize) -> void {
    threads.lock(@intFromPtr(&registryLock))
    const list = registry()
    var k: usize = 0
    var found = false
    while k < list.*.length {
        if m.wordAt(list, k) == r {
            var i = k
            while i + 1 < list.*.length {
                m.putWord(list.*.address + i * 8, m.wordAt(list, i + 1))
                i += 1
            }
            list.*.length -= 1
            found = true
            break
        }
        k += 1
    }
    threads.unlock(@intFromPtr(&registryLock))
    if found {
        g_resource_unref(r)
    } else {
        messages.warning("Tried to remove not registered resource")
    }
}

// The registered resources, newest first, each with a reference.
fn snapshot() -> m.Words {
    var copy = m.words()
    threads.lock(@intFromPtr(&registryLock))
    const list = registry()
    var k = list.*.length
    while k > 0 {
        k -= 1
        m.pushWord(&copy, g_resource_ref(m.wordAt(list, k)))
    }
    threads.unlock(@intFromPtr(&registryLock))
    return copy
}

fn release(list: *m.Words) -> void {
    var k: usize = 0
    while k < list.*.length {
        g_resource_unref(m.wordAt(list, k))
        k += 1
    }
    m.disposeWords(list)
}

export fn g_resources_lookup_data(path: usize, lookup_flags: i32, err: usize) -> usize {
    var list = snapshot()
    var result: usize = 0
    var k: usize = 0
    while k < list.length && result == 0 {
        result = lookupData(m.wordAt(&list, k), path, 0)
        k += 1
    }
    release(&list)
    if result == 0 { resourceError(err, 0, path) }
    return result
}

export fn g_resources_get_info(path: usize, lookup_flags: i32, size: usize, flags: usize, err: usize) -> i32 {
    var list = snapshot()
    var found = false
    var k: usize = 0
    while k < list.length && !found {
        found = g_resource_get_info(m.wordAt(&list, k), path, lookup_flags, size, flags, 0) != 0
        k += 1
    }
    release(&list)
    if !found { resourceError(err, 0, path) }
    return if found { 1 } else { 0 }
}

export fn g_resources_enumerate_children(path: usize, lookup_flags: i32, err: usize) -> usize {
    var list = snapshot()
    var names = m.words()
    var any = false
    var k: usize = 0
    while k < list.length {
        var some = m.words()
        if children(m.wordAt(&list, k), path, &some) {
            any = true
            var i: usize = 0
            while i < some.length {
                const name = m.wordAt(&some, i)
                var seen = false
                var j: usize = 0
                while j < names.length {
                    if m.cEqual(m.wordAt(&names, j), name) { seen = true }
                    j += 1
                }
                if seen { m.release(name) } else { m.pushWord(&names, name) }
                i += 1
            }
        }
        m.disposeWords(&some)
        k += 1
    }
    release(&list)
    if !any {
        m.disposeWords(&names)
        resourceError(err, 0, path)
        return 0
    }
    return strvOf(&names)
}

// GStaticResource: data (0), data_len (8), resource (16), next (24).
export fn g_static_resource_init(static_resource: usize) -> void {
    if m.getWord(static_resource + 16) != 0 { return }
    const bytes = arrays.newBytes(m.getWord(static_resource), m.getWord(static_resource + 8), 0, 0)
    const r = g_resource_new_from_data(bytes, 0)
    arrays.bytesUnref(bytes)
    if r == 0 { return }
    m.putWord(static_resource + 16, r)
    g_resources_register(r)
}

export fn g_static_resource_fini(static_resource: usize) -> void {
    const r = m.getWord(static_resource + 16)
    if r == 0 { return }
    m.putWord(static_resource + 16, 0)
    g_resources_unregister(r)
    g_resource_unref(r)
}

export fn g_static_resource_get_resource(static_resource: usize) -> usize {
    if m.getWord(static_resource + 16) == 0 { g_static_resource_init(static_resource) }
    return m.getWord(static_resource + 16)
}
