// GIO's networking (ginetaddress.h, gsocketaddress.h,
// ginetsocketaddress.h, gsocketconnectable.h, gsocketlistener.h,
// gsocketservice.h, gsocketclient.h), IPv4 and IPv6 over TCP.
//
// A GInetAddress: a GObject, then its family (24) and its bytes (28, 16
// of them). A GSocketAddress is abstract (a GObject) and a
// GSocketConnectable; a GInetSocketAddress adds its GInetAddress (24),
// port (32), flow info (36) and scope (40). A GSocketListener: a GObject
// and (24) a record of its listening sockets (0, a Words of entries: the
// socket, the source object, the watch) and backlog (24); a
// GSocketService adds (32) a record of whether it is active (0) and the
// main context it accepts in (8). A GSocketClient: a GObject and (24) its
// timeout in seconds.
//
// A service watches each listening socket with a socket source in its
// main context; a connection accepted there is told by "incoming" and
// kept only by its handlers. A client resolves the host at once (an
// address's text, or the C library's getaddrinfo), then connects to each
// address in turn: waiting with poll, or asynchronously with a socket
// source in the task's context. The errors are GIO's ("Error binding to
// address 127.0.0.1:80: Address already in use", "Could not connect to
// HOST: Connection refused").
const m = @import("./memory.mlx")
const sys = @import("./sys.mlx")
const threads = @import("./threads.mlx")
const errors = @import("./errors.mlx")
const types = @import("./types.mlx")
const signals = @import("./signals.mlx")
const ioerrors = @import("./ioerrors.mlx")

extern("c") fn g_object_new(t: usize, first: usize) -> usize
extern("c") fn g_object_ref(object: usize) -> usize
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_type_check_instance_is_a(instance: usize, t: usize) -> i32
extern("c") fn g_type_add_interface_static(t: usize, iface: usize, info: usize) -> void
extern("c") fn g_type_interface_add_prerequisite(t: usize, prerequisite: usize) -> void
extern("c") fn g_type_name(t: usize) -> usize
extern("c") fn g_signal_emit(instance: usize, id: u32, detail: u32, a: usize, b: usize, c: usize) -> void
extern("c") fn g_signal_accumulator_true_handled(ihint: usize, accu: usize, handler: usize, data: usize) -> i32
extern("c") fn g_socket_new(family: i32, kind: i32, protocol: i32, err: usize) -> usize
extern("c") fn g_socket_new_from_fd(fd: i32, err: usize) -> usize
extern("c") fn g_socket_get_fd(s: usize) -> i32
extern("c") fn g_socket_close(s: usize, err: usize) -> i32
extern("c") fn g_socket_create_source(s: usize, condition: i32, c: usize) -> usize
extern("c") fn g_socket_connection_factory_create_connection(s: usize) -> usize
extern("c") fn g_socket_connection_get_socket(connection: usize) -> usize
extern("c") fn g_socket_connection_get_type() -> usize
extern("c") fn dup(fd: i32) -> i32
extern("c") fn g_source_set_callback(source: usize, func: usize, data: usize, notify: usize) -> void
extern("c") fn g_source_attach(source: usize, context: usize) -> u32
extern("c") fn g_source_destroy(source: usize) -> void
extern("c") fn g_source_unref(source: usize) -> void
extern("c") fn g_main_context_get_thread_default() -> usize
extern("c") fn g_main_context_ref(context: usize) -> usize
extern("c") fn g_main_context_unref(context: usize) -> void
extern("c") fn g_task_new(source: usize, c: usize, callback: usize, data: usize) -> usize
extern("c") fn g_task_get_context(task: usize) -> usize
extern("c") fn g_task_get_cancellable(task: usize) -> usize
extern("c") fn g_task_set_task_data(task: usize, data: usize, destroy: usize) -> void
extern("c") fn g_task_get_task_data(task: usize) -> usize
extern("c") fn g_task_return_pointer(task: usize, result: usize, destroy: usize) -> void
extern("c") fn g_task_return_error(task: usize, e: usize) -> void
extern("c") fn g_task_propagate_pointer(task: usize, err: usize) -> usize
extern("c") fn g_cancellable_set_error_if_cancelled(c: usize, err: usize) -> i32
extern("c") fn socket(domain: i32, kind: i32, protocol: i32) -> i32
extern("c") fn bind(fd: i32, address: usize, length: u32) -> i32
extern("c") fn listen(fd: i32, backlog: i32) -> i32
extern("c") fn accept4(fd: i32, address: usize, length: usize, flags: i32) -> i32
extern("c") fn connect(fd: i32, address: usize, length: u32) -> i32
extern("c") fn getsockname(fd: i32, address: usize, length: usize) -> i32
extern("c") fn getpeername(fd: i32, address: usize, length: usize) -> i32
extern("c") fn getsockopt(fd: i32, level: i32, name: i32, value: usize, length: usize) -> i32
extern("c") fn setsockopt(fd: i32, level: i32, name: i32, value: usize, length: u32) -> i32
extern("c") fn inet_pton(family: i32, text: usize, out: usize) -> i32
extern("c") fn inet_ntop(family: i32, bytes: usize, out: usize, size: u32) -> usize
extern("c") fn getaddrinfo(node: usize, service: usize, hints: usize, result: usize) -> i32
extern("c") fn freeaddrinfo(list: usize) -> void
extern("c") fn gai_strerror(code: i32) -> usize
extern("c") fn poll(fds: usize, count: u64, timeout: i32) -> i32

const AF_INET: i32 = 2
const AF_INET6: i32 = 10
const SOCK_STREAM: i32 = 1
const SOCK_CLOEXEC: i32 = 524288
const SOCK_NONBLOCK: i32 = 2048
const SOL_SOCKET: i32 = 1
const SO_REUSEADDR: i32 = 2
const SO_ERROR: i32 = 4
const EINPROGRESS: i32 = 115
const EINTR: i32 = 4
const G_IO_OUT: i32 = 4
const G_IO_IN: i32 = 1
const G_IO_ERR: i32 = 8
const G_IO_HUP: i32 = 16

const A_FAMILY: usize = 24
const A_BYTES: usize = 28
const A_SIZE: usize = 48
const S_ADDRESS: usize = 24
const S_PORT: usize = 32
const S_FLOW: usize = 36
const S_SCOPE: usize = 40
const S_SIZE: usize = 48
const L_RECORD: usize = 24
const L_SIZE: usize = 32
const V_RECORD: usize = 32
const V_SIZE: usize = 40
const C_TIMEOUT: usize = 24
const C_SIZE: usize = 32

pub const SourceFunc = fn(usize, i32, usize) -> i32

var connectableType: usize = 0
var inetAddressType: usize = 0
var socketAddressType: usize = 0
var inetSocketAddressType: usize = 0
var listenerType: usize = 0
var serviceType: usize = 0
var clientType: usize = 0
var incomingSignal: u32 = 0
var typesOnce: u64 = 0

// ---------------------------------------------------------------------------
// The types

export fn __mlx_glib_inet_socket_address_finalize(a: usize) -> void {
    if m.getWord(a + S_ADDRESS) != 0 { g_object_unref(m.getWord(a + S_ADDRESS)) }
    ioerrors.chainUp(socketAddressType, 48, a)
}

export fn __mlx_glib_inet_socket_address_class_init(class: usize, data: usize) -> void { m.putWord(class + 48, @intFromPtr(__mlx_glib_inet_socket_address_finalize)) }

export fn __mlx_glib_listener_init(l: usize, class: usize) -> void {
    const r = m.alloc(32)
    m.zero(r, 32)
    m.putI32(r + 24, 10)
    m.putWord(l + L_RECORD, r)
}

export fn __mlx_glib_listener_finalize(l: usize) -> void {
    closeListener(l)
    m.release(m.getWord(l + L_RECORD))
    ioerrors.chainUp(types.T_OBJECT, 48, l)
}

export fn __mlx_glib_listener_class_init(class: usize, data: usize) -> void { m.putWord(class + 48, @intFromPtr(__mlx_glib_listener_finalize)) }

export fn __mlx_glib_service_init(s: usize, class: usize) -> void {
    const r = m.alloc(16)
    m.put32(r, 1)
    m.putWord(r + 8, g_main_context_ref(contextHere()))
    m.putWord(s + V_RECORD, r)
}

export fn __mlx_glib_service_finalize(s: usize) -> void {
    const r = m.getWord(s + V_RECORD)
    closeListener(s)
    g_main_context_unref(m.getWord(r + 8))
    m.release(r)
    ioerrors.chainUp(listenerType, 48, s)
}

export fn __mlx_glib_service_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 48, @intFromPtr(__mlx_glib_service_finalize))
    const params = m.alloc(16)
    m.putWord(params, g_socket_connection_get_type())
    m.putWord(params + 8, types.T_OBJECT)
    incomingSignal = signals.newSignal(m.literal("incoming"), m.getWord(class), 2, 0, @intFromPtr(g_signal_accumulator_true_handled), 0, 0, types.T_BOOLEAN, 2, params)
    m.release(params)
}

fn ensureTypes() -> void {
    if threads.onceEnter(@intFromPtr(&typesOnce)) {
        types.ensureInit()
        connectableType = ioerrors.defineType(types.T_INTERFACE, "GSocketConnectable", 40, 0, 0, 0, 0)
        g_type_interface_add_prerequisite(connectableType, types.T_OBJECT)
        inetAddressType = ioerrors.defineType(types.T_OBJECT, "GInetAddress", 136, 0, A_SIZE, 0, 0)
        socketAddressType = ioerrors.defineType(types.T_OBJECT, "GSocketAddress", 160, 0, 24, 0, types.ABSTRACT)
        const info = m.alloc(24)
        m.zero(info, 24)
        g_type_add_interface_static(socketAddressType, connectableType, info)
        m.release(info)
        inetSocketAddressType = ioerrors.defineType(socketAddressType, "GInetSocketAddress", 160, @intFromPtr(__mlx_glib_inet_socket_address_class_init), S_SIZE, 0, 0)
        listenerType = ioerrors.defineType(types.T_OBJECT, "GSocketListener", 200, @intFromPtr(__mlx_glib_listener_class_init), L_SIZE, @intFromPtr(__mlx_glib_listener_init), 0)
        serviceType = ioerrors.defineType(listenerType, "GSocketService", 240, @intFromPtr(__mlx_glib_service_class_init), V_SIZE, @intFromPtr(__mlx_glib_service_init), 0)
        clientType = ioerrors.defineType(types.T_OBJECT, "GSocketClient", 200, 0, C_SIZE, 0, 0)
        threads.onceLeave(@intFromPtr(&typesOnce), 1)
    }
}

export fn g_socket_connectable_get_type() -> usize {
    ensureTypes()
    return connectableType
}
export fn g_inet_address_get_type() -> usize {
    ensureTypes()
    return inetAddressType
}
export fn g_socket_address_get_type() -> usize {
    ensureTypes()
    return socketAddressType
}
export fn g_inet_socket_address_get_type() -> usize {
    ensureTypes()
    return inetSocketAddressType
}
export fn g_socket_listener_get_type() -> usize {
    ensureTypes()
    return listenerType
}
export fn g_socket_service_get_type() -> usize {
    ensureTypes()
    return serviceType
}
export fn g_socket_client_get_type() -> usize {
    ensureTypes()
    return clientType
}

fn isA(object: usize, t: usize) -> bool { return object != 0 && g_type_check_instance_is_a(object, t) != 0 }

fn contextHere() -> usize {
    const context = g_main_context_get_thread_default()
    return if context != 0 { context } else { mainContextDefault() }
}

extern("c") fn g_main_context_default() -> usize
fn mainContextDefault() -> usize { return g_main_context_default() }

// ---------------------------------------------------------------------------
// Inet addresses

fn byteSize(family: i32) -> usize { return if family == AF_INET6 { 16 } else { 4 } }

fn newInetAddress(family: i32, bytes: usize) -> usize {
    ensureTypes()
    const a = g_object_new(inetAddressType, 0)
    m.putI32(a + A_FAMILY, family)
    m.zero(a + A_BYTES, 16)
    m.copy(a + A_BYTES, bytes, byteSize(family))
    return a
}

export fn g_inet_address_new_from_string(text: usize) -> usize {
    const bytes = m.alloc(16)
    m.zero(bytes, 16)
    var a: usize = 0
    if inet_pton(AF_INET, text, bytes) == 1 {
        a = newInetAddress(AF_INET, bytes)
    } else if inet_pton(AF_INET6, text, bytes) == 1 {
        a = newInetAddress(AF_INET6, bytes)
    }
    m.release(bytes)
    return a
}

export fn g_inet_address_new_from_bytes(bytes: usize, family: i32) -> usize { return newInetAddress(family, bytes) }

export fn g_inet_address_new_loopback(family: i32) -> usize {
    const bytes = m.alloc(16)
    m.zero(bytes, 16)
    if family == AF_INET6 {
        m.put8(bytes + 15, 1)
    } else {
        m.put8(bytes, 127)
        m.put8(bytes + 3, 1)
    }
    const a = newInetAddress(family, bytes)
    m.release(bytes)
    return a
}

export fn g_inet_address_new_any(family: i32) -> usize {
    const bytes = m.alloc(16)
    m.zero(bytes, 16)
    const a = newInetAddress(family, bytes)
    m.release(bytes)
    return a
}

export fn g_inet_address_equal(a: usize, b: usize) -> i32 {
    if m.getI32(a + A_FAMILY) != m.getI32(b + A_FAMILY) { return 0 }
    return if m.same(m.bytes(a + A_BYTES, 16), m.bytes(b + A_BYTES, 16)) { 1 } else { 0 }
}

export fn g_inet_address_to_string(a: usize) -> usize {
    const out = m.alloc(64)
    _ = inet_ntop(m.getI32(a + A_FAMILY), a + A_BYTES, out, 64)
    const text = m.dup(out)
    m.release(out)
    return text
}

export fn g_inet_address_to_bytes(a: usize) -> usize { return a + A_BYTES }
export fn g_inet_address_get_native_size(a: usize) -> usize { return byteSize(m.getI32(a + A_FAMILY)) }
export fn g_inet_address_get_family(a: usize) -> i32 { return m.getI32(a + A_FAMILY) }

export fn g_inet_address_get_is_any(a: usize) -> i32 {
    var index: usize = 0
    while index < byteSize(m.getI32(a + A_FAMILY)) {
        if m.get8(a + A_BYTES + index) != 0 { return 0 }
        index += 1
    }
    return 1
}

export fn g_inet_address_get_is_loopback(a: usize) -> i32 {
    if m.getI32(a + A_FAMILY) == AF_INET { return if m.get8(a + A_BYTES) == 127 { 1 } else { 0 } }
    var index: usize = 0
    while index < 15 {
        if m.get8(a + A_BYTES + index) != 0 { return 0 }
        index += 1
    }
    return if m.get8(a + A_BYTES + 15) == 1 { 1 } else { 0 }
}

// ---------------------------------------------------------------------------
// Socket addresses

fn newInetSocketAddress(address: usize, port: u16, flow: u32, scope: u32) -> usize {
    ensureTypes()
    const s = g_object_new(inetSocketAddressType, 0)
    m.putWord(s + S_ADDRESS, g_object_ref(address))
    m.put16(s + S_PORT, port)
    m.put32(s + S_FLOW, flow)
    m.put32(s + S_SCOPE, scope)
    return s
}

export fn g_inet_socket_address_new(address: usize, port: u16) -> usize { return newInetSocketAddress(address, port, 0, 0) }

export fn g_inet_socket_address_new_from_string(text: usize, port: u32) -> usize {
    const address = g_inet_address_new_from_string(text)
    if address == 0 { return 0 }
    const s = newInetSocketAddress(address, @intCast(u16, port & 65535), 0, 0)
    g_object_unref(address)
    return s
}

export fn g_inet_socket_address_get_address(s: usize) -> usize { return m.getWord(s + S_ADDRESS) }
export fn g_inet_socket_address_get_port(s: usize) -> u16 { return m.get16(s + S_PORT) }
export fn g_inet_socket_address_get_flowinfo(s: usize) -> u32 { return m.get32(s + S_FLOW) }
export fn g_inet_socket_address_get_scope_id(s: usize) -> u32 { return m.get32(s + S_SCOPE) }

fn familyOf(s: usize) -> i32 { return m.getI32(m.getWord(s + S_ADDRESS) + A_FAMILY) }

export fn g_socket_address_get_family(s: usize) -> i32 { return if isA(s, inetSocketAddressType) { familyOf(s) } else { 0 } }

export fn g_socket_address_get_native_size(s: usize) -> isize {
    if !isA(s, inetSocketAddressType) { return -1 }
    return if familyOf(s) == AF_INET6 { 28 } else { 16 }
}

fn swap16(value: u16) -> u16 { return (value >> 8) | ((value & 255) << 8) }

fn swap32(value: u32) -> u32 { return (value >> 24) | ((value >> 8) & 0xff00) | ((value & 0xff00) << 8) | ((value & 255) << 24) }

export fn g_socket_address_to_native(s: usize, dest: usize, length: usize, err: usize) -> i32 {
    const size = g_socket_address_get_native_size(s)
    if size < 0 || length < @intCast(usize, size) {
        ioerrors.set(err, ioerrors.NO_SPACE, "Not enough space for socket address")
        return 0
    }
    m.zero(dest, @intCast(usize, size))
    const family = familyOf(s)
    const bytes = m.getWord(s + S_ADDRESS) + A_BYTES
    m.put16(dest, @intCast(u16, family))
    m.put16(dest + 2, swap16(m.get16(s + S_PORT)))
    if family == AF_INET6 {
        m.put32(dest + 4, swap32(m.get32(s + S_FLOW)))
        m.copy(dest + 8, bytes, 16)
        m.put32(dest + 24, m.get32(s + S_SCOPE))
    } else {
        m.copy(dest + 4, bytes, 4)
    }
    return 1
}

export fn g_socket_address_new_from_native(native: usize, length: usize) -> usize {
    if length < 2 { return 0 }
    const family = @intCast(i32, m.get16(native))
    if family == AF_INET && length >= 16 {
        const address = newInetAddress(AF_INET, native + 4)
        const s = newInetSocketAddress(address, swap16(m.get16(native + 2)), 0, 0)
        g_object_unref(address)
        return s
    }
    if family == AF_INET6 && length >= 28 {
        const address = newInetAddress(AF_INET6, native + 8)
        const s = newInetSocketAddress(address, swap16(m.get16(native + 2)), swap32(m.get32(native + 4)), m.get32(native + 24))
        g_object_unref(address)
        return s
    }
    return 0
}

// "127.0.0.1:80", "[::1]:80".
export fn g_socket_connectable_to_string(c: usize) -> usize {
    if !isA(c, inetSocketAddressType) { return m.dup(g_type_name(types.instanceType(c))) }
    const host = g_inet_address_to_string(m.getWord(c + S_ADDRESS))
    var t = m.text()
    if familyOf(c) == AF_INET6 { m.pushByte(&t, 91) }
    m.pushC(&t, host)
    if familyOf(c) == AF_INET6 { m.pushByte(&t, 93) }
    m.pushByte(&t, 58)
    m.pushDecimal(&t, @intCast(u64, m.get16(c + S_PORT)))
    m.release(host)
    return m.finish(&t)
}

fn addressOfName(fd: i32, peer: bool, err: usize) -> usize {
    const native = m.alloc(128)
    const length = m.alloc(8)
    m.put32(length, 128)
    const result = if peer { getpeername(fd, native, length) } else { getsockname(fd, native, length) }
    var s: usize = 0
    if result != 0 {
        ioerrors.setErrno(err, if peer { "could not get remote address: " } else { "could not get local address: " }, sys.errno())
    } else {
        s = g_socket_address_new_from_native(native, @intCast(usize, m.get32(length)))
    }
    m.release(native)
    m.release(length)
    return s
}

export fn g_socket_get_local_address(s: usize, err: usize) -> usize { return addressOfName(g_socket_get_fd(s), false, err) }
export fn g_socket_get_remote_address(s: usize, err: usize) -> usize { return addressOfName(g_socket_get_fd(s), true, err) }
export fn g_socket_connection_get_local_address(c: usize, err: usize) -> usize { return g_socket_get_local_address(g_socket_connection_get_socket(c), err) }
export fn g_socket_connection_get_remote_address(c: usize, err: usize) -> usize { return g_socket_get_remote_address(g_socket_connection_get_socket(c), err) }

// ---------------------------------------------------------------------------
// Listeners and services

// A listening socket's entry: the socket (0), the source object (8), the
// service's watch (16).
const LE_SOCKET: usize = 0
const LE_SOURCE: usize = 8
const LE_WATCH: usize = 16

fn entries(l: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, m.getWord(l + L_RECORD)) } }

export fn g_socket_listener_new() -> usize {
    ensureTypes()
    return g_object_new(listenerType, 0)
}

export fn g_socket_listener_set_backlog(l: usize, backlog: i32) -> void { m.putI32(m.getWord(l + L_RECORD) + 24, backlog) }

fn isService(l: usize) -> bool { return isA(l, serviceType) }

fn serviceActive(s: usize) -> bool { return m.get32(m.getWord(s + V_RECORD)) != 0 }

export fn __mlx_glib_service_accept(listening: usize, condition: i32, entry: usize) -> i32 {
    const service = m.getWord(entry + 24)
    const fd = accept4(g_socket_get_fd(listening), 0, 0, SOCK_CLOEXEC)
    if fd < 0 { return 1 }
    const s = g_socket_new_from_fd(fd, 0)
    if s == 0 { return 1 }
    const connection = g_socket_connection_factory_create_connection(s)
    g_object_unref(s)
    _ = g_object_ref(service)
    const handled = m.alloc(8)
    m.putI32(handled, 0)
    g_signal_emit(service, incomingSignal, 0, connection, m.getWord(entry + LE_SOURCE), handled)
    m.release(handled)
    g_object_unref(connection)
    g_object_unref(service)
    return 1
}

fn watch(service: usize, entry: usize) -> void {
    if m.getWord(entry + LE_WATCH) != 0 { return }
    const source = g_socket_create_source(m.getWord(entry + LE_SOCKET), G_IO_IN, 0)
    m.putWord(entry + 24, service)
    g_source_set_callback(source, @intFromPtr(__mlx_glib_service_accept), entry, 0)
    _ = g_source_attach(source, m.getWord(m.getWord(service + V_RECORD) + 8))
    m.putWord(entry + LE_WATCH, source)
}

fn unwatch(entry: usize) -> void {
    const source = m.getWord(entry + LE_WATCH)
    if source == 0 { return }
    g_source_destroy(source)
    g_source_unref(source)
    m.putWord(entry + LE_WATCH, 0)
}

fn closeListener(l: usize) -> void {
    const list = entries(l)
    var index: usize = 0
    while index < list.*.length {
        const entry = m.wordAt(list, index)
        unwatch(entry)
        _ = g_socket_close(m.getWord(entry + LE_SOCKET), 0)
        g_object_unref(m.getWord(entry + LE_SOCKET))
        if m.getWord(entry + LE_SOURCE) != 0 { g_object_unref(m.getWord(entry + LE_SOURCE)) }
        m.release(entry)
        index += 1
    }
    m.disposeWords(list)
}

export fn g_socket_listener_close(l: usize) -> void { closeListener(l) }

export fn g_socket_listener_add_address(l: usize, address: usize, kind: i32, protocol: i32, source: usize, effective: usize, err: usize) -> i32 {
    const family = g_socket_address_get_family(address)
    const s = g_socket_new(family, kind, protocol, err)
    if s == 0 { return 0 }
    const fd = g_socket_get_fd(s)
    const one = m.alloc(8)
    m.putI32(one, 1)
    _ = setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, one, 4)
    m.release(one)
    const native = m.alloc(128)
    const size = g_socket_address_get_native_size(address)
    _ = g_socket_address_to_native(address, native, 128, 0)
    if bind(fd, native, @intCast(u32, size)) != 0 {
        const errnum = sys.errno()
        const text = g_socket_connectable_to_string(address)
        var t = m.text()
        m.pushText(&t, "Error binding to address ")
        m.pushC(&t, text)
        m.pushText(&t, ": ")
        m.pushC(&t, errors.errnoText(errnum))
        ioerrors.setText(err, ioerrors.fromErrno(errnum), &t)
        m.release(text)
        m.release(native)
        g_object_unref(s)
        return 0
    }
    m.release(native)
    if listen(fd, m.getI32(m.getWord(l + L_RECORD) + 24)) != 0 {
        ioerrors.setErrno(err, "Error listening: ", sys.errno())
        g_object_unref(s)
        return 0
    }
    if effective != 0 { m.putWord(effective, g_socket_get_local_address(s, 0)) }
    const entry = m.alloc(32)
    m.zero(entry, 32)
    m.putWord(entry + LE_SOCKET, s)
    m.putWord(entry + LE_SOURCE, if source != 0 { g_object_ref(source) } else { 0 })
    m.pushWord(entries(l), entry)
    if isService(l) && serviceActive(l) { watch(l, entry) }
    return 1
}

export fn g_socket_listener_add_inet_port(l: usize, port: u16, source: usize, err: usize) -> i32 {
    const any = g_inet_address_new_any(AF_INET)
    const address = g_inet_socket_address_new(any, port)
    const ok = g_socket_listener_add_address(l, address, SOCK_STREAM, 6, source, 0, err)
    g_object_unref(address)
    g_object_unref(any)
    return ok
}

// A connection accepted at once (waiting for one), and its source object.
export fn g_socket_listener_accept(l: usize, sourceOut: usize, c: usize, err: usize) -> usize {
    const list = entries(l)
    if list.*.length == 0 {
        ioerrors.set(err, ioerrors.FAILED, "No sockets to listen on")
        return 0
    }
    const fds = m.alloc(list.*.length * 8)
    while true {
        if g_cancellable_set_error_if_cancelled(c, err) != 0 {
            m.release(fds)
            return 0
        }
        var index: usize = 0
        while index < list.*.length {
            m.putI32(fds + index * 8, g_socket_get_fd(m.getWord(m.wordAt(list, index) + LE_SOCKET)))
            m.put16(fds + index * 8 + 4, 1)
            m.put16(fds + index * 8 + 6, 0)
            index += 1
        }
        _ = poll(fds, @intCast(u64, list.*.length), 1000)
        index = 0
        while index < list.*.length {
            if (m.get16(fds + index * 8 + 6) & 1) != 0 {
                const entry = m.wordAt(list, index)
                const fd = accept4(g_socket_get_fd(m.getWord(entry + LE_SOCKET)), 0, 0, SOCK_CLOEXEC)
                if fd >= 0 {
                    m.release(fds)
                    const s = g_socket_new_from_fd(fd, err)
                    if s == 0 { return 0 }
                    const connection = g_socket_connection_factory_create_connection(s)
                    g_object_unref(s)
                    if sourceOut != 0 { m.putWord(sourceOut, m.getWord(entry + LE_SOURCE)) }
                    return connection
                }
            }
            index += 1
        }
    }
    return 0
}

export fn g_socket_service_new() -> usize {
    ensureTypes()
    return g_object_new(serviceType, 0)
}

export fn g_socket_service_is_active(s: usize) -> i32 { return if serviceActive(s) { 1 } else { 0 } }

export fn g_socket_service_start(s: usize) -> void {
    if serviceActive(s) { return }
    m.put32(m.getWord(s + V_RECORD), 1)
    const list = entries(s)
    var index: usize = 0
    while index < list.*.length {
        watch(s, m.wordAt(list, index))
        index += 1
    }
}

export fn g_socket_service_stop(s: usize) -> void {
    m.put32(m.getWord(s + V_RECORD), 0)
    const list = entries(s)
    var index: usize = 0
    while index < list.*.length {
        unwatch(m.wordAt(list, index))
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Clients

export fn g_socket_client_new() -> usize {
    ensureTypes()
    return g_object_new(clientType, 0)
}

export fn g_socket_client_set_timeout(client: usize, timeout: u32) -> void { m.put32(client + C_TIMEOUT, timeout) }
export fn g_socket_client_get_timeout(client: usize) -> u32 { return m.get32(client + C_TIMEOUT) }

// What a connection is made to: the host as written (for the messages)
// and its addresses (sockaddrs of 28 bytes each, their lengths).
const Target = struct {
    host: usize
    addresses: m.Words
    lengths: m.Words
    next: usize
}

fn addAddress(target: *Target, native: usize, length: usize) -> void {
    const copy = m.alloc(32)
    m.copy(copy, native, length)
    m.pushWord(&target.*.addresses, copy)
    m.pushWord(&target.*.lengths, length)
}

fn disposeTarget(target: *Target) -> void {
    var index: usize = 0
    while index < target.*.addresses.length {
        m.release(m.wordAt(&target.*.addresses, index))
        index += 1
    }
    m.disposeWords(&target.*.addresses)
    m.disposeWords(&target.*.lengths)
    m.release(target.*.host)
}

// "host:port", "[v6]:port", "host" (DEFAULT_PORT) resolved; false with
// the error set when it is not an address and no name resolves.
fn resolve(hostAndPort: usize, defaultPort: u16, target: *Target, err: usize) -> bool {
    target.* = Target.{ .host = 0, .addresses = m.words(), .lengths = m.words(), .next = 0 }
    const length = m.cLength(hostAndPort)
    var hostStart: usize = 0
    var hostEnd = length
    var port: u64 = @intCast(u64, defaultPort)
    var portStart = length
    if length > 0 && m.get8(hostAndPort) == 91 {
        hostStart = 1
        hostEnd = 1
        while hostEnd < length && m.get8(hostAndPort + hostEnd) != 93 { hostEnd += 1 }
        if hostEnd + 1 < length && m.get8(hostAndPort + hostEnd + 1) == 58 { portStart = hostEnd + 2 }
    } else {
        var colons: usize = 0
        var last: usize = 0
        var index: usize = 0
        while index < length {
            if m.get8(hostAndPort + index) == 58 {
                colons += 1
                last = index
            }
            index += 1
        }
        if colons == 1 {
            hostEnd = last
            portStart = last + 1
        }
    }
    var bad = portStart < length && m.get8(hostAndPort + portStart) == 0
    if portStart < length {
        port = 0
        var index = portStart
        while index < length {
            const c = m.get8(hostAndPort + index)
            if !m.isDigit(c) || port > 65535 { bad = true }
            if !bad { port = port * 10 + @intCast(u64, c - 48) }
            index += 1
        }
        if port > 65535 { bad = true }
    }
    target.*.host = m.dupBytes(hostAndPort + hostStart, hostEnd - hostStart)
    if bad || hostEnd == hostStart {
        var t = m.text()
        m.pushText(&t, "Invalid hostname")
        ioerrors.setText(err, ioerrors.INVALID_ARGUMENT, &t)
        return false
    }
    const native = m.alloc(32)
    m.zero(native, 32)
    if inet_pton(AF_INET, target.*.host, native + 4) == 1 {
        m.put16(native, @intCast(u16, AF_INET))
        m.put16(native + 2, swap16(@intCast(u16, port)))
        addAddress(target, native, 16)
        m.release(native)
        return true
    }
    if inet_pton(AF_INET6, target.*.host, native + 8) == 1 {
        m.put16(native, @intCast(u16, AF_INET6))
        m.put16(native + 2, swap16(@intCast(u16, port)))
        addAddress(target, native, 28)
        m.release(native)
        return true
    }
    m.release(native)
    // A name: getaddrinfo's addresses of streams.
    const hints = m.alloc(48)
    m.zero(hints, 48)
    m.putI32(hints + 8, SOCK_STREAM)
    const result = m.alloc(8)
    m.putWord(result, 0)
    const code = getaddrinfo(target.*.host, 0, hints, result)
    m.release(hints)
    if code != 0 {
        var t = m.text()
        m.pushText(&t, "Error resolving \xe2\x80\x9c")
        m.pushC(&t, target.*.host)
        m.pushText(&t, "\xe2\x80\x9d: ")
        m.pushC(&t, gai_strerror(code))
        if err != 0 {
            errors.report(err, errors.newError(errors.quarkLiteral("g-resolver-error-quark"), 0, m.finish(&t)))
        } else {
            m.dispose(&t)
        }
        m.release(result)
        return false
    }
    // struct addrinfo: flags, family, socktype, protocol (0..16), addrlen
    // (16), addr (24), canonname (32), next (40).
    var info = m.getWord(result)
    while info != 0 {
        const family = m.getI32(info + 4)
        if family == AF_INET || family == AF_INET6 {
            const addrLength = @intCast(usize, m.get32(info + 16))
            const copy = m.alloc(32)
            m.zero(copy, 32)
            m.copy(copy, m.getWord(info + 24), addrLength)
            m.put16(copy + 2, swap16(@intCast(u16, port)))
            addAddress(target, copy, addrLength)
            m.release(copy)
        }
        info = m.getWord(info + 40)
    }
    freeaddrinfo(m.getWord(result))
    m.release(result)
    return true
}

fn connectError(host: usize, errnum: i32) -> usize {
    var t = m.text()
    m.pushText(&t, "Could not connect to ")
    m.pushC(&t, host)
    m.pushText(&t, ": ")
    m.pushC(&t, errors.errnoText(errnum))
    return errors.newError(ioerrors.quark(), ioerrors.fromErrno(errnum), m.finish(&t))
}

// Starts connecting to the target's next address: the descriptor (-1
// when none is left, `errnum` the last error), `pending` whether it is
// still in progress.
fn startNext(target: *Target, pending: *bool, errnum: *i32) -> i32 {
    while target.*.next < target.*.addresses.length {
        const native = m.wordAt(&target.*.addresses, target.*.next)
        const length = m.wordAt(&target.*.lengths, target.*.next)
        target.*.next += 1
        const fd = socket(@intCast(i32, m.get16(native)), SOCK_STREAM | SOCK_CLOEXEC | SOCK_NONBLOCK, 0)
        if fd < 0 {
            errnum.* = sys.errno()
            continue
        }
        if connect(fd, native, @intCast(u32, length)) == 0 {
            pending.* = false
            return fd
        }
        const e = sys.errno()
        if e == EINPROGRESS || e == EINTR {
            pending.* = true
            return fd
        }
        errnum.* = e
        _ = sys.close(fd)
    }
    return -1
}

// The error a connection in progress ended with (0 for none).
fn pendingError(fd: i32) -> i32 {
    const value = m.alloc(16)
    m.putI32(value, 0)
    m.put32(value + 8, 4)
    var e: i32 = 0
    if getsockopt(fd, SOL_SOCKET, SO_ERROR, value, value + 8) != 0 { e = sys.errno() } else { e = m.getI32(value) }
    m.release(value)
    return e
}

fn connectionOf(fd: i32, err: usize) -> usize {
    const s = g_socket_new_from_fd(fd, err)
    if s == 0 { return 0 }
    const connection = g_socket_connection_factory_create_connection(s)
    g_object_unref(s)
    return connection
}

export fn g_socket_client_connect_to_host(client: usize, hostAndPort: usize, defaultPort: u16, c: usize, err: usize) -> usize {
    var target: Target = undefined
    if !resolve(hostAndPort, defaultPort, &target, err) {
        disposeTarget(&target)
        return 0
    }
    var errnum: i32 = 111
    var connection: usize = 0
    while connection == 0 {
        if g_cancellable_set_error_if_cancelled(c, err) != 0 { break }
        var pending = false
        const fd = startNext(&target, &pending, &errnum)
        if fd < 0 {
            errors.report(err, connectError(target.host, errnum))
            break
        }
        if pending {
            const pollfd = m.alloc(8)
            m.putI32(pollfd, fd)
            m.put16(pollfd + 4, 4)
            m.put16(pollfd + 6, 0)
            const timeout = m.get32(client + C_TIMEOUT)
            const ready = poll(pollfd, 1, if timeout == 0 { -1 } else { @intCast(i32, timeout * 1000) })
            m.release(pollfd)
            if ready == 0 {
                _ = sys.close(fd)
                ioerrors.set(err, ioerrors.TIMED_OUT, "Socket I/O timed out")
                break
            }
            const e = pendingError(fd)
            if e != 0 {
                errnum = e
                _ = sys.close(fd)
                continue
            }
        }
        connection = connectionOf(fd, err)
        if connection == 0 { break }
    }
    disposeTarget(&target)
    return connection
}

export fn g_socket_client_connect(client: usize, connectable: usize, c: usize, err: usize) -> usize {
    const text = g_socket_connectable_to_string(connectable)
    const connection = g_socket_client_connect_to_host(client, text, 0, c, err)
    m.release(text)
    return connection
}

// An asynchronous connection: its target (0, a Target), the descriptor
// in progress (40), its watch (48).
const AC_TARGET: usize = 0
const AC_FD: usize = 40
const AC_WATCH: usize = 48
const AC_ERRNO: usize = 56
const AC_SIZE: usize = 64

fn targetOf(state: usize) -> *Target { unsafe { return @ptrFromInt(*Target, state + AC_TARGET) } }

export fn __mlx_glib_connect_state_free(state: usize) -> void {
    const source = m.getWord(state + AC_WATCH)
    if source != 0 {
        g_source_destroy(source)
        g_source_unref(source)
    }
    disposeTarget(targetOf(state))
    m.release(state)
}

export fn __mlx_glib_object_unref(object: usize) -> void { g_object_unref(object) }

// The next address tried, the task returned when one connects or none
// is left.
fn advance(task: usize) -> void {
    const state = g_task_get_task_data(task)
    while true {
        var pending = false
        var errnum = m.getI32(state + AC_ERRNO)
        const fd = startNext(targetOf(state), &pending, &errnum)
        m.putI32(state + AC_ERRNO, errnum)
        if fd < 0 {
            g_task_return_error(task, connectError(targetOf(state).*.host, errnum))
            return
        }
        if !pending {
            const local = m.alloc(8)
            m.putWord(local, 0)
            const connection = connectionOf(fd, local)
            if connection == 0 { g_task_return_error(task, m.getWord(local)) } else { g_task_return_pointer(task, connection, @intFromPtr(__mlx_glib_object_unref)) }
            m.release(local)
            return
        }
        m.putI32(state + AC_FD, fd)
        // (Watched by a socket of its own, which the descriptor outlives:
        // the connection takes it when it connects.)
        const watched = g_socket_new_from_fd(fd, 0)
        const source = g_socket_create_source(watched, G_IO_OUT | G_IO_ERR | G_IO_HUP, g_task_get_cancellable(task))
        g_object_unref(watched)
        _ = g_object_ref(task)
        g_source_set_callback(source, @intFromPtr(__mlx_glib_connect_ready), task, @intFromPtr(__mlx_glib_object_unref))
        _ = g_source_attach(source, g_task_get_context(task))
        m.putWord(state + AC_WATCH, source)
        return
    }
}

export fn __mlx_glib_connect_ready(watched: usize, condition: i32, task: usize) -> i32 {
    const state = g_task_get_task_data(task)
    const fd = m.getI32(state + AC_FD)
    const source = m.getWord(state + AC_WATCH)
    m.putWord(state + AC_WATCH, 0)
    if source != 0 { g_source_unref(source) }
    const local = m.alloc(8)
    m.putWord(local, 0)
    // (The descriptor is the watching socket's, which closes it.)
    if g_cancellable_set_error_if_cancelled(g_task_get_cancellable(task), local) != 0 {
        g_task_return_error(task, m.getWord(local))
        m.release(local)
        return 0
    }
    const e = pendingError(fd)
    if e != 0 {
        m.putI32(state + AC_ERRNO, e)
        m.release(local)
        advance(task)
        return 0
    }
    // (The watching socket's descriptor is this one: the connection's
    // socket is made of a duplicate, and the watcher's closed now, before
    // the callback runs, which may close the connection and wait for the
    // other end to see it.)
    const connection = connectionOf(dup(fd), local)
    _ = g_socket_close(watched, 0)
    if connection == 0 { g_task_return_error(task, m.getWord(local)) } else { g_task_return_pointer(task, connection, @intFromPtr(__mlx_glib_object_unref)) }
    m.release(local)
    return 0
}

export fn g_socket_client_connect_to_host_async(client: usize, hostAndPort: usize, defaultPort: u16, c: usize, callback: usize, data: usize) -> void {
    const task = g_task_new(client, c, callback, data)
    const state = m.alloc(AC_SIZE)
    m.zero(state, AC_SIZE)
    m.putI32(state + AC_ERRNO, 111)
    g_task_set_task_data(task, state, @intFromPtr(__mlx_glib_connect_state_free))
    const local = m.alloc(8)
    m.putWord(local, 0)
    if !resolve(hostAndPort, defaultPort, targetOf(state), local) {
        g_task_return_error(task, m.getWord(local))
    } else {
        advance(task)
    }
    m.release(local)
    g_object_unref(task)
}

export fn g_socket_client_connect_to_host_finish(client: usize, result: usize, err: usize) -> usize { return g_task_propagate_pointer(result, err) }
