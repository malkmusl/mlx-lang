// GParamSpec (gparam.h, gparamspecs.h): the descriptions of properties,
// instances of the fundamental type GParam and its 23 subtypes, as
// GLib's gparam.c and gparamspecs.c make them.
//
// A GParamSpec (72 bytes: the class word, name 8, flags 16, value_type
// 24, owner_type 32, nick 40, blurb 48, qdata 56, ref_count 64, param_id
// 68) and the fields of its subtype after it. Its qdata word points to a
// record of the library's own (the name's quark, the default value, data
// by quark), its lowest bit but one the floating flag, as in GLib. A
// subtype's class (GParamSpecClass: value_type 8, finalize 16,
// value_set_default 24, value_validate 32, values_cmp 40, value_is_valid
// 48) keeps in its first spare word which of the 23 it is; this module's
// functions in its slots do what GLib's do for that kind.
const m = @import("./memory.mlx")
const threads = @import("./threads.mlx")
const messages = @import("./messages.mlx")
const errors = @import("./errors.mlx")
const strings = @import("./strings.mlx")
const types = @import("./types.mlx")
const values = @import("./values.mlx")

extern("c") fn g_type_class_ref(t: usize) -> usize
extern("c") fn g_type_class_unref(c: usize) -> void
extern("c") fn g_variant_ref_sink(v: usize) -> usize
extern("c") fn g_variant_unref(v: usize) -> void
extern("c") fn g_variant_is_of_type(v: usize, t: usize) -> i32
extern("c") fn g_variant_compare(a: usize, b: usize) -> i32
extern("c") fn g_variant_equal(a: usize, b: usize) -> i32
extern("c") fn g_variant_type_copy(t: usize) -> usize
extern("c") fn g_variant_type_free(t: usize) -> void
extern("c") fn g_value_array_get_type() -> usize
extern("c") fn g_unichar_validate(c: u32) -> i32
extern("c") fn __mlx_glib_value_zero(value: usize) -> void
extern("c") fn __mlx_glib_value_peek(value: usize) -> usize

const P_NAME: usize = 8
const P_FLAGS: usize = 16
const P_VALUE_TYPE: usize = 24
const P_OWNER: usize = 32
const P_NICK: usize = 40
const P_BLURB: usize = 48
const P_QDATA: usize = 56
const P_REFS: usize = 64
const P_ID: usize = 68
const PSPEC_SIZE: usize = 72

const C_VALUE_TYPE: usize = 8
const C_FINALIZE: usize = 16
const C_SET_DEFAULT: usize = 24
const C_VALIDATE: usize = 32
const C_CMP: usize = 40
const C_IS_VALID: usize = 48
const C_KIND: usize = 56
const CLASS_SIZE: usize = 80

// The private record: the name's quark (0), the default value (8, a
// GValue, made when first asked for), data by quark (32, words).
const R_QUARK: usize = 0
const R_DEFAULT: usize = 8
const R_QDATA: usize = 32
const R_SIZE: usize = 56

const FLOATING: usize = 2

const STATIC_NAME: i32 = 32
const STATIC_NICK: i32 = 64
const STATIC_BLURB: i32 = 128

const K_CHAR: usize = 0
const K_UCHAR: usize = 1
const K_BOOLEAN: usize = 2
const K_INT: usize = 3
const K_UINT: usize = 4
const K_LONG: usize = 5
const K_ULONG: usize = 6
const K_INT64: usize = 7
const K_UINT64: usize = 8
const K_UNICHAR: usize = 9
const K_ENUM: usize = 10
const K_FLAGS: usize = 11
const K_FLOAT: usize = 12
const K_DOUBLE: usize = 13
const K_STRING: usize = 14
const K_PARAM: usize = 15
const K_BOXED: usize = 16
const K_POINTER: usize = 17
const K_VALUE_ARRAY: usize = 18
const K_OBJECT: usize = 19
const K_OVERRIDE: usize = 20
const K_GTYPE: usize = 21
const K_VARIANT: usize = 22
const KINDS: usize = 23

pub const Finalize = fn(usize) -> void
pub const SetDefault = fn(usize, usize) -> void
pub const Validate = fn(usize, usize) -> i32
pub const Compare = fn(usize, usize, usize) -> i32

var kindTypes: [23]usize = undefined
var paramTable: [8]usize = undefined

fn record(pspec: usize) -> usize { return m.getWord(pspec + P_QDATA) & (0 - 1 - 3) }
fn classOf(pspec: usize) -> usize { return m.getWord(pspec) }
fn kindOf(pspec: usize) -> usize { return m.getWord(classOf(pspec) + C_KIND) }
fn valueOf(value: usize) -> usize { return m.getWord(value + 8) }

pub fn valueType(pspec: usize) -> usize { return m.getWord(pspec + P_VALUE_TYPE) }
pub fn nameOf(pspec: usize) -> usize { return m.getWord(pspec + P_NAME) }
pub fn flagsOf(pspec: usize) -> i32 { return m.getI32(pspec + P_FLAGS) }

// ---------------------------------------------------------------------------
// The fundamental type and its values

export fn __mlx_glib_param_class_init(class: usize, data: usize) -> void {
    m.putWord(class + C_VALUE_TYPE, types.T_NONE)
    m.putWord(class + C_FINALIZE, @intFromPtr(__mlx_glib_param_finalize))
    m.putWord(class + C_SET_DEFAULT, 0)
    m.putWord(class + C_VALIDATE, 0)
    m.putWord(class + C_CMP, 0)
    m.putWord(class + C_IS_VALID, 0)
}

export fn __mlx_glib_param_init(pspec: usize, class: usize) -> void {
    m.putWord(pspec + P_VALUE_TYPE, m.getWord(class + C_VALUE_TYPE))
    m.putWord(pspec + P_QDATA, m.alloc(R_SIZE) | FLOATING)
    m.put32(pspec + P_REFS, 1)
}

export fn __mlx_glib_param_finalize(pspec: usize) -> void {
    const flags = flagsOf(pspec)
    if (flags & STATIC_NICK) == 0 { m.release(m.getWord(pspec + P_NICK)) }
    if (flags & STATIC_BLURB) == 0 { m.release(m.getWord(pspec + P_BLURB)) }
    const r = record(pspec)
    if m.getWord(r + R_DEFAULT) != 0 { values.unset(r + R_DEFAULT) }
    const qdata = wordsAt(r + R_QDATA)
    var k: usize = 0
    while k < qdata.*.length {
        const notify = m.wordAt(qdata, k + 2)
        if notify != 0 {
            const call: Finalize = unsafe { @ptrFromInt(Finalize, notify) }
            call(m.wordAt(qdata, k + 1))
        }
        k += 3
    }
    m.disposeWords(qdata)
    m.release(r)
    types.freeInstance(pspec)
}

fn wordsAt(address: usize) -> *m.Words { unsafe { return @ptrFromInt(*m.Words, address) } }

export fn __mlx_glib_param_value_free(value: usize) -> void { if valueOf(value) != 0 { unref(valueOf(value)) } }
export fn __mlx_glib_param_value_copy(src: usize, dest: usize) -> void { m.putWord(dest + 8, if valueOf(src) == 0 { 0 } else { ref(valueOf(src)) }) }

export fn __mlx_glib_param_value_collect(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    m.putWord(value + 8, if p == 0 { 0 } else { ref(p) })
    return 0
}

export fn __mlx_glib_param_value_lcopy(value: usize, n: u32, cvalues: usize, flags: u32) -> usize {
    const p = m.getWord(cvalues)
    if p == 0 { return m.dupSlice("value location passed as NULL") }
    if valueOf(value) == 0 || (flags & values.NOCOPY_CONTENTS) != 0 {
        m.putWord(p, valueOf(value))
    } else {
        m.putWord(p, ref(valueOf(value)))
    }
    return 0
}

fn kindName(kind: usize) -> []const u8 {
    if kind == 0 { return "GParamChar" }
    if kind == 1 { return "GParamUChar" }
    if kind == 2 { return "GParamBoolean" }
    if kind == 3 { return "GParamInt" }
    if kind == 4 { return "GParamUInt" }
    if kind == 5 { return "GParamLong" }
    if kind == 6 { return "GParamULong" }
    if kind == 7 { return "GParamInt64" }
    if kind == 8 { return "GParamUInt64" }
    if kind == 9 { return "GParamUnichar" }
    if kind == 10 { return "GParamEnum" }
    if kind == 11 { return "GParamFlags" }
    if kind == 12 { return "GParamFloat" }
    if kind == 13 { return "GParamDouble" }
    if kind == 14 { return "GParamString" }
    if kind == 15 { return "GParamParam" }
    if kind == 16 { return "GParamBoxed" }
    if kind == 17 { return "GParamPointer" }
    if kind == 18 { return "GParamValueArray" }
    if kind == 19 { return "GParamObject" }
    if kind == 20 { return "GParamOverride" }
    if kind == 21 { return "GParamGType" }
    if kind == 22 { return "GParamVariant" }
    return "GParamVariant"
}

fn instanceSize(kind: usize) -> u16 {
    if kind == K_CHAR || kind == K_UCHAR || kind == K_BOOLEAN || kind == K_UNICHAR || kind == K_OVERRIDE || kind == K_GTYPE { return 80 }
    if kind == K_INT || kind == K_UINT || kind == K_ENUM || kind == K_FLAGS || kind == K_FLOAT || kind == K_VALUE_ARRAY { return 88 }
    if kind == K_LONG || kind == K_ULONG || kind == K_INT64 || kind == K_UINT64 { return 96 }
    if kind == K_DOUBLE || kind == K_STRING { return 104 }
    if kind == K_VARIANT { return 120 }
    return 72
}

fn kindValueType(kind: usize) -> usize {
    if kind == K_CHAR { return types.T_CHAR }
    if kind == K_UCHAR { return types.T_UCHAR }
    if kind == K_BOOLEAN { return types.T_BOOLEAN }
    if kind == K_INT { return types.T_INT }
    if kind == K_UINT || kind == K_UNICHAR { return types.T_UINT }
    if kind == K_LONG { return types.T_LONG }
    if kind == K_ULONG { return types.T_ULONG }
    if kind == K_INT64 { return types.T_INT64 }
    if kind == K_UINT64 { return types.T_UINT64 }
    if kind == K_ENUM { return types.T_ENUM }
    if kind == K_FLAGS { return types.T_FLAGS }
    if kind == K_FLOAT { return types.T_FLOAT }
    if kind == K_DOUBLE { return types.T_DOUBLE }
    if kind == K_STRING { return types.T_STRING }
    if kind == K_PARAM { return types.T_PARAM }
    if kind == K_BOXED { return types.T_BOXED }
    if kind == K_POINTER { return types.T_POINTER }
    if kind == K_VALUE_ARRAY { return g_value_array_get_type() }
    if kind == K_OBJECT { return types.T_OBJECT }
    if kind == K_GTYPE { return values.gtypeType() }
    if kind == K_VARIANT { return types.T_VARIANT }
    return types.T_NONE
}

export fn __mlx_glib_params_init() -> void {
    const zero = @intFromPtr(__mlx_glib_value_zero)
    m.putWord(@intFromPtr(&paramTable), zero)
    m.putWord(@intFromPtr(&paramTable) + 8, @intFromPtr(__mlx_glib_param_value_free))
    m.putWord(@intFromPtr(&paramTable) + 16, @intFromPtr(__mlx_glib_param_value_copy))
    m.putWord(@intFromPtr(&paramTable) + 24, @intFromPtr(__mlx_glib_value_peek))
    m.putWord(@intFromPtr(&paramTable) + 32, m.literal("p"))
    m.putWord(@intFromPtr(&paramTable) + 40, @intFromPtr(__mlx_glib_param_value_collect))
    m.putWord(@intFromPtr(&paramTable) + 48, m.literal("p"))
    m.putWord(@intFromPtr(&paramTable) + 56, @intFromPtr(__mlx_glib_param_value_lcopy))
    const info = m.alloc(72)
    m.put16(info, @intCast(u16, CLASS_SIZE))
    m.putWord(info + 24, @intFromPtr(__mlx_glib_param_class_init))
    m.put16(info + 48, @intCast(u16, PSPEC_SIZE))
    m.putWord(info + 56, @intFromPtr(__mlx_glib_param_init))
    m.putWord(info + 64, @intFromPtr(&paramTable))
    const finfo = m.alloc(8)
    m.put32(finfo, types.CLASSED | types.INSTANTIATABLE | types.DERIVABLE | types.DEEP_DERIVABLE)
    _ = types.registerFundamental(types.T_PARAM, m.literal("GParam"), info, finfo, types.ABSTRACT)
    m.release(finfo)
    var kind: usize = 0
    while kind < KINDS {
        m.zero(info, 72)
        m.put16(info, @intCast(u16, CLASS_SIZE))
        m.putWord(info + 24, @intFromPtr(__mlx_glib_param_kind_class_init))
        m.putWord(info + 40, kind)
        m.put16(info + 48, instanceSize(kind))
        m.putWord(info + 56, @intFromPtr(__mlx_glib_param_kind_init))
        kindTypes[kind] = types.registerStatic(types.T_PARAM, m.literal(kindName(kind)), info, 0)
        kind += 1
    }
    m.release(info)
}

export fn g_param_spec_type_of(index: u32) -> usize {
    types.ensureInit()
    if @intCast(usize, index) >= KINDS { return 0 }
    return kindTypes[@intCast(usize, index)]
}

export fn __mlx_glib_param_kind_class_init(class: usize, kind: usize) -> void {
    m.putWord(class + C_KIND, kind)
    m.putWord(class + C_VALUE_TYPE, kindValueType(kind))
    m.putWord(class + C_FINALIZE, @intFromPtr(__mlx_glib_param_kind_finalize))
    m.putWord(class + C_SET_DEFAULT, @intFromPtr(__mlx_glib_param_kind_set_default))
    m.putWord(class + C_VALIDATE, @intFromPtr(__mlx_glib_param_kind_validate))
    m.putWord(class + C_CMP, @intFromPtr(__mlx_glib_param_kind_cmp))
}

export fn __mlx_glib_param_kind_init(pspec: usize, class: usize) -> void {
    const kind = m.getWord(class + C_KIND)
    if kind == K_CHAR {
        m.put8(pspec + 72, 0x80)
        m.put8(pspec + 73, 0x7f)
    } else if kind == K_UCHAR {
        m.put8(pspec + 73, 0xff)
    } else if kind == K_INT {
        m.putI32(pspec + 72, -2147483647 - 1)
        m.putI32(pspec + 76, 2147483647)
    } else if kind == K_UINT {
        m.put32(pspec + 76, 0xffffffff)
    } else if kind == K_LONG || kind == K_INT64 {
        m.putI64(pspec + 72, -9223372036854775807 - 1)
        m.putI64(pspec + 80, 9223372036854775807)
    } else if kind == K_ULONG || kind == K_UINT64 {
        m.put64(pspec + 80, 0xffffffffffffffff)
    } else if kind == K_FLOAT {
        m.putF32(pspec + 72, -3.4028234663852886e38)
        m.putF32(pspec + 76, 3.4028234663852886e38)
        m.putF32(pspec + 84, 1e-30)
    } else if kind == K_DOUBLE {
        m.putF64(pspec + 72, -1.7976931348623157e308)
        m.putF64(pspec + 80, 1.7976931348623157e308)
        m.putF64(pspec + 96, 1e-90)
    } else if kind == K_STRING {
        m.put8(pspec + 96, '_')
    } else if kind == K_GTYPE {
        m.putWord(pspec + 72, types.T_NONE)
    }
}

export fn __mlx_glib_param_kind_finalize(pspec: usize) -> void {
    const kind = kindOf(pspec)
    if kind == K_ENUM || kind == K_FLAGS {
        g_type_class_unref(m.getWord(pspec + 72))
    } else if kind == K_STRING {
        m.release(m.getWord(pspec + 72))
        m.release(m.getWord(pspec + 80))
        m.release(m.getWord(pspec + 88))
    } else if kind == K_OVERRIDE || kind == K_VALUE_ARRAY {
        if m.getWord(pspec + 72) != 0 { unref(m.getWord(pspec + 72)) }
    } else if kind == K_VARIANT {
        g_variant_type_free(m.getWord(pspec + 72))
        if m.getWord(pspec + 80) != 0 { g_variant_unref(m.getWord(pspec + 80)) }
    }
    __mlx_glib_param_finalize(pspec)
}

export fn __mlx_glib_param_kind_set_default(pspec: usize, value: usize) -> void {
    const kind = kindOf(pspec)
    if kind == K_CHAR {
        m.putWord(value + 8, @bitCast(usize, @intCast(i64, @bitCast(i8, m.get8(pspec + 74)))))
    } else if kind == K_UCHAR {
        m.putWord(value + 8, @intCast(usize, m.get8(pspec + 74)))
    } else if kind == K_BOOLEAN || kind == K_UNICHAR {
        m.putWord(value + 8, @intCast(usize, m.get32(pspec + 72)))
    } else if kind == K_INT {
        m.putWord(value + 8, @bitCast(usize, @intCast(i64, m.getI32(pspec + 80))))
    } else if kind == K_UINT {
        m.putWord(value + 8, @intCast(usize, m.get32(pspec + 80)))
    } else if kind == K_LONG || kind == K_ULONG || kind == K_INT64 || kind == K_UINT64 {
        m.putWord(value + 8, m.getWord(pspec + 88))
    } else if kind == K_ENUM {
        m.putWord(value + 8, @bitCast(usize, @intCast(i64, m.getI32(pspec + 80))))
    } else if kind == K_FLAGS {
        m.putWord(value + 8, @intCast(usize, m.get32(pspec + 80)))
    } else if kind == K_FLOAT {
        m.putF32(value + 8, m.getF32(pspec + 80))
    } else if kind == K_DOUBLE {
        m.putF64(value + 8, m.getF64(pspec + 88))
    } else if kind == K_STRING {
        const text = m.getWord(pspec + 72)
        m.putWord(value + 8, if text == 0 { 0 } else { m.dup(text) })
    } else if kind == K_GTYPE {
        m.putWord(value + 8, m.getWord(pspec + 72))
    } else if kind == K_VARIANT {
        const v = m.getWord(pspec + 80)
        m.putWord(value + 8, if v == 0 { 0 } else { g_variant_ref_sink(v) })
    } else if kind == K_OVERRIDE {
        setDefault(m.getWord(pspec + 72), value)
    } else {
        m.putWord(value + 8, 0)
    }
}

fn clampI(value: usize, low: i64, high: i64) -> i32 {
    const v = m.getI64(value + 8)
    if v < low {
        m.putI64(value + 8, low)
        return 1
    }
    if v > high {
        m.putI64(value + 8, high)
        return 1
    }
    return 0
}

fn clampU(value: usize, low: u64, high: u64) -> i32 {
    const v = m.get64(value + 8)
    if v < low {
        m.put64(value + 8, low)
        return 1
    }
    if v > high {
        m.put64(value + 8, high)
        return 1
    }
    return 0
}

export fn __mlx_glib_param_kind_validate(pspec: usize, value: usize) -> i32 {
    const kind = kindOf(pspec)
    if kind == K_CHAR { return clampI(value, @intCast(i64, @bitCast(i8, m.get8(pspec + 72))), @intCast(i64, @bitCast(i8, m.get8(pspec + 73)))) }
    if kind == K_UCHAR { return clampU(value, @intCast(u64, m.get8(pspec + 72)), @intCast(u64, m.get8(pspec + 73))) }
    if kind == K_BOOLEAN {
        const v = m.getI32(value + 8)
        m.putWord(value + 8, if v != 0 { 1 } else { 0 })
        return if v != 0 && v != 1 { 1 } else { 0 }
    }
    if kind == K_INT { return clampI(value, @intCast(i64, m.getI32(pspec + 72)), @intCast(i64, m.getI32(pspec + 76))) }
    if kind == K_UINT { return clampU(value, @intCast(u64, m.get32(pspec + 72)), @intCast(u64, m.get32(pspec + 76))) }
    if kind == K_LONG || kind == K_INT64 { return clampI(value, m.getI64(pspec + 72), m.getI64(pspec + 80)) }
    if kind == K_ULONG || kind == K_UINT64 { return clampU(value, m.get64(pspec + 72), m.get64(pspec + 80)) }
    if kind == K_UNICHAR {
        if g_unichar_validate(m.get32(value + 8)) == 0 {
            m.putWord(value + 8, 0)
            return 1
        }
        return 0
    }
    if kind == K_ENUM {
        if values.enumValue(m.getWord(pspec + 72), m.getI32(value + 8)) == 0 {
            m.putWord(value + 8, @bitCast(usize, @intCast(i64, m.getI32(pspec + 80))))
            return 1
        }
        return 0
    }
    if kind == K_FLAGS {
        const mask = m.get32(m.getWord(pspec + 72) + 8)
        const v = m.get32(value + 8)
        if (v & mask) != v {
            m.putWord(value + 8, @intCast(usize, v & mask))
            return 1
        }
        return 0
    }
    if kind == K_FLOAT {
        const v = m.getF32(value + 8)
        if v < m.getF32(pspec + 72) {
            m.putF32(value + 8, m.getF32(pspec + 72))
            return 1
        }
        if v > m.getF32(pspec + 76) {
            m.putF32(value + 8, m.getF32(pspec + 76))
            return 1
        }
        return 0
    }
    if kind == K_DOUBLE {
        const v = m.getF64(value + 8)
        if v < m.getF64(pspec + 72) {
            m.putF64(value + 8, m.getF64(pspec + 72))
            return 1
        }
        if v > m.getF64(pspec + 80) {
            m.putF64(value + 8, m.getF64(pspec + 80))
            return 1
        }
        return 0
    }
    if kind == K_STRING { return validateString(pspec, value) }
    if kind == K_PARAM {
        const p = valueOf(value)
        if p != 0 && !types.isA(types.instanceType(p), valueType(pspec)) {
            unref(p)
            m.putWord(value + 8, 0)
            return 1
        }
        return 0
    }
    if kind == K_OBJECT {
        const o = valueOf(value)
        if o != 0 && !values.compatible(types.instanceType(o), valueType(pspec)) {
            values.reset(value)
            return 1
        }
        return 0
    }
    if kind == K_GTYPE {
        if !types.isA(m.getWord(value + 8), m.getWord(pspec + 72)) {
            m.putWord(value + 8, m.getWord(pspec + 72))
            return 1
        }
        return 0
    }
    if kind == K_VARIANT {
        const v = valueOf(value)
        if v == 0 || g_variant_is_of_type(v, m.getWord(pspec + 72)) == 0 {
            values.reset(value)
            __mlx_glib_param_kind_set_default(pspec, value)
            return 1
        }
        return 0
    }
    if kind == K_OVERRIDE { return if validate(m.getWord(pspec + 72), value) { 1 } else { 0 } }
    return 0
}

// GLib's param_string_validate: the first character from cset_first and
// the others from cset_nth (others become the substitutor), NULL made ""
// (ensure_non_null), "" made NULL (null_fold_if_empty).
fn validateString(pspec: usize, value: usize) -> i32 {
    var changed: i32 = 0
    var text = valueOf(value)
    const first = m.getWord(pspec + 80)
    const nth = m.getWord(pspec + 88)
    const sub = m.get8(pspec + 96)
    const flags = m.get32(pspec + 100)
    if text != 0 && m.get8(text) != 0 && (first != 0 || nth != 0) {
        if (m.get32(value + 16) & values.NOCOPY_CONTENTS) != 0 {
            text = m.dup(text)
            m.putWord(value + 8, text)
            m.put32(value + 16, 0)
        }
        if first != 0 && !contains(first, m.get8(text)) {
            m.put8(text, sub)
            changed += 1
        }
        if nth != 0 {
            var p = text + 1
            while m.get8(p) != 0 {
                if !contains(nth, m.get8(p)) {
                    m.put8(p, sub)
                    changed += 1
                }
                p += 1
            }
        }
    }
    if (flags & 1) != 0 && text != 0 && m.get8(text) == 0 {
        if (m.get32(value + 16) & values.NOCOPY_CONTENTS) == 0 { m.release(text) }
        m.put32(value + 16, 0)
        m.putWord(value + 8, 0)
        changed += 1
        text = 0
    }
    if (flags & 2) != 0 && text == 0 {
        m.put32(value + 16, 0)
        m.putWord(value + 8, m.dupSlice(""))
        changed += 1
    }
    return changed
}

fn contains(set: usize, c: u8) -> bool {
    var p = set
    while m.get8(p) != 0 {
        if m.get8(p) == c { return true }
        p += 1
    }
    return false
}

fn compareI(a: i64, b: i64) -> i32 { return if a < b { -1 } else if a > b { 1 } else { 0 } }
fn compareU(a: u64, b: u64) -> i32 { return if a < b { -1 } else if a > b { 1 } else { 0 } }

export fn __mlx_glib_param_kind_cmp(pspec: usize, a: usize, b: usize) -> i32 {
    const kind = kindOf(pspec)
    if kind == K_CHAR || kind == K_BOOLEAN || kind == K_INT || kind == K_ENUM { return compareI(@intCast(i64, m.getI32(a + 8)), @intCast(i64, m.getI32(b + 8))) }
    if kind == K_UCHAR || kind == K_UINT || kind == K_UNICHAR || kind == K_FLAGS { return compareU(@intCast(u64, m.get32(a + 8)), @intCast(u64, m.get32(b + 8))) }
    if kind == K_LONG || kind == K_INT64 { return compareI(m.getI64(a + 8), m.getI64(b + 8)) }
    if kind == K_FLOAT {
        const e = m.getF32(pspec + 84)
        const x = m.getF32(a + 8)
        const y = m.getF32(b + 8)
        if x < y { return if y - x > e { -1 } else { 0 } }
        return if x - y > e { 1 } else { 0 }
    }
    if kind == K_DOUBLE {
        const e = m.getF64(pspec + 96)
        const x = m.getF64(a + 8)
        const y = m.getF64(b + 8)
        if x < y { return if y - x > e { -1 } else { 0 } }
        return if x - y > e { 1 } else { 0 }
    }
    if kind == K_STRING {
        const x = valueOf(a)
        const y = valueOf(b)
        if x == 0 { return if y != 0 { -1 } else { 0 } }
        if y == 0 { return 1 }
        return m.cCompare(x, y)
    }
    if kind == K_VARIANT {
        const x = valueOf(a)
        const y = valueOf(b)
        if x == 0 || y == 0 { return compareU(@intCast(u64, x), @intCast(u64, y)) }
        return if g_variant_equal(x, y) != 0 { 0 } else { compareU(@intCast(u64, x), @intCast(u64, y)) }
    }
    if kind == K_OVERRIDE { return cmp(m.getWord(pspec + 72), a, b) }
    return compareU(m.get64(a + 8), m.get64(b + 8))
}

// ---------------------------------------------------------------------------
// GParamSpec

fn isValidChar(c: u8) -> bool { return m.isAlnum(c) || c == '-' || c == '_' }

pub fn isValidName(name: usize) -> bool {
    if name == 0 || !m.isAlpha(m.get8(name)) { return false }
    var p = name + 1
    while m.get8(p) != 0 {
        if !isValidChar(m.get8(p)) { return false }
        p += 1
    }
    return true
}

fn isCanonical(name: usize) -> bool {
    var p = name
    while m.get8(p) != 0 {
        if m.get8(p) == '_' { return false }
        p += 1
    }
    return true
}

// The canonical form of a property name ('_' made '-'), interned.
pub fn canonicalName(name: usize) -> usize {
    if isCanonical(name) { return errors.intern(name) }
    const copy = m.dup(name)
    var p = copy
    while m.get8(p) != 0 {
        if m.get8(p) == '_' { m.put8(p, '-') }
        p += 1
    }
    const interned = errors.intern(copy)
    m.release(copy)
    return interned
}

export fn g_param_spec_is_valid_name(name: usize) -> i32 { return if isValidName(name) { 1 } else { 0 } }

pub fn internal(paramType: usize, name: usize, nick: usize, blurb: usize, flags: i32) -> usize {
    if types.fundamentalOf(paramType) != types.T_PARAM || paramType == types.T_PARAM {
        values.gobjectCritical("g_param_spec_internal: assertion 'G_TYPE_IS_PARAM (param_type) && param_type != G_TYPE_PARAM' failed")
        return 0
    }
    if name == 0 || !isValidName(name) {
        values.gobjectCritical("g_param_spec_internal: assertion 'g_param_spec_is_valid_name (name)' failed")
        return 0
    }
    if (flags & STATIC_NAME) != 0 && !isCanonical(name) {
        values.gobjectCritical("g_param_spec_internal: assertion '!(flags & G_PARAM_STATIC_NAME) || is_canonical (name)' failed")
        return 0
    }
    const pspec = types.createInstance(paramType)
    const interned = canonicalName(name)
    m.putWord(pspec + P_NAME, interned)
    m.put32(record(pspec) + R_QUARK, errors.quarkOf(interned, false, true))
    m.putWord(pspec + P_NICK, if (flags & STATIC_NICK) != 0 { nick } else if nick == 0 { 0 } else { m.dup(nick) })
    m.putWord(pspec + P_BLURB, if (flags & STATIC_BLURB) != 0 { blurb } else if blurb == 0 { 0 } else { m.dup(blurb) })
    m.putI32(pspec + P_FLAGS, flags)
    return pspec
}

export fn g_param_spec_internal(param_type: usize, name: usize, nick: usize, blurb: usize, flags: i32) -> usize { return internal(param_type, name, nick, blurb, flags) }

pub fn ref(pspec: usize) -> usize {
    threads.refInc(pspec + P_REFS)
    return pspec
}

pub fn unref(pspec: usize) -> void {
    if threads.refDec(pspec + P_REFS) {
        const f = m.getWord(classOf(pspec) + C_FINALIZE)
        const call: Finalize = unsafe { @ptrFromInt(Finalize, f) }
        call(pspec)
    }
}

fn takeFloating(pspec: usize) -> bool {
    while true {
        const old = @atomicLoad(u64, m.word64(pspec + P_QDATA), acquire)
        if (old & FLOATING) == 0 { return false }
        const swapped = @cmpxchgStrong(u64, m.word64(pspec + P_QDATA), old, old & (0xffffffffffffffff ^ FLOATING), acq_rel, acquire)
        if swapped.0 { return true }
    }
    return false
}

pub fn refSink(pspec: usize) -> usize {
    if !takeFloating(pspec) { _ = ref(pspec) }
    return pspec
}

export fn g_param_spec_ref(pspec: usize) -> usize { return ref(pspec) }
export fn g_param_spec_unref(pspec: usize) -> void { unref(pspec) }
export fn g_param_spec_sink(pspec: usize) -> void { if takeFloating(pspec) { unref(pspec) } }
export fn g_param_spec_ref_sink(pspec: usize) -> usize { return refSink(pspec) }

fn qdataFind(pspec: usize, quark: u32) -> isize {
    const list = wordsAt(record(pspec) + R_QDATA)
    var k: usize = 0
    while k < list.*.length {
        if m.wordAt(list, k) == @intCast(usize, quark) { return @intCast(isize, k) }
        k += 3
    }
    return -1
}

export fn g_param_spec_get_qdata(pspec: usize, quark: u32) -> usize {
    const at = qdataFind(pspec, quark)
    if at < 0 { return 0 }
    return m.wordAt(wordsAt(record(pspec) + R_QDATA), @intCast(usize, at) + 1)
}

export fn g_param_spec_set_qdata(pspec: usize, quark: u32, data: usize) -> void { g_param_spec_set_qdata_full(pspec, quark, data, 0) }

export fn g_param_spec_set_qdata_full(pspec: usize, quark: u32, data: usize, destroy: usize) -> void {
    const list = wordsAt(record(pspec) + R_QDATA)
    const at = qdataFind(pspec, quark)
    if at >= 0 {
        const slot = list.*.address + @intCast(usize, at) * 8
        const oldData = m.getWord(slot + 8)
        const oldDestroy = m.getWord(slot + 16)
        m.putWord(slot + 8, data)
        m.putWord(slot + 16, destroy)
        if oldDestroy != 0 {
            const call: Finalize = unsafe { @ptrFromInt(Finalize, oldDestroy) }
            call(oldData)
        }
        return
    }
    m.pushWord(list, @intCast(usize, quark))
    m.pushWord(list, data)
    m.pushWord(list, destroy)
}

export fn g_param_spec_steal_qdata(pspec: usize, quark: u32) -> usize {
    const at = qdataFind(pspec, quark)
    if at < 0 { return 0 }
    const list = wordsAt(record(pspec) + R_QDATA)
    const slot = list.*.address + @intCast(usize, at) * 8
    const data = m.getWord(slot + 8)
    m.putWord(slot + 16, 0)
    m.putWord(slot, 0)
    return data
}

pub fn redirectTarget(pspec: usize) -> usize {
    if kindOf(pspec) == K_OVERRIDE && types.instanceType(pspec) == kindTypes[K_OVERRIDE] { return m.getWord(pspec + 72) }
    return 0
}

export fn g_param_spec_get_redirect_target(pspec: usize) -> usize { return redirectTarget(pspec) }
export fn g_param_spec_get_name(pspec: usize) -> usize { return nameOf(pspec) }

export fn g_param_spec_get_nick(pspec: usize) -> usize {
    if m.getWord(pspec + P_NICK) != 0 { return m.getWord(pspec + P_NICK) }
    const target = redirectTarget(pspec)
    if target != 0 && m.getWord(target + P_NICK) != 0 { return m.getWord(target + P_NICK) }
    return nameOf(pspec)
}

export fn g_param_spec_get_blurb(pspec: usize) -> usize {
    if m.getWord(pspec + P_BLURB) != 0 { return m.getWord(pspec + P_BLURB) }
    const target = redirectTarget(pspec)
    if target != 0 { return m.getWord(target + P_BLURB) }
    return 0
}

pub fn nameQuark(pspec: usize) -> u32 { return m.get32(record(pspec) + R_QUARK) }

export fn g_param_spec_get_name_quark(pspec: usize) -> u32 { return nameQuark(pspec) }

export fn g_param_spec_get_default_value(pspec: usize) -> usize {
    const r = record(pspec)
    const value = r + R_DEFAULT
    if m.getWord(value) == 0 {
        lockDefaults()
        if m.getWord(value) == 0 {
            const made = m.alloc(24)
            _ = values.init(made, valueType(pspec))
            setDefault(pspec, made)
            m.copy(value + 8, made + 8, 16)
            @atomicStore(u64, m.word64(value), @intCast(u64, m.getWord(made)), release)
            m.release(made)
        }
        unlockDefaults()
    }
    return value
}

var defaultsLock: u32 = 0
fn lockDefaults() -> void { threads.lock(@intFromPtr(&defaultsLock)) }
fn unlockDefaults() -> void { threads.unlock(@intFromPtr(&defaultsLock)) }

fn appliesTo(pspec: usize, value: usize) -> bool { return values.compatible(m.getWord(value), valueType(pspec)) }

pub fn setDefault(pspec: usize, value: usize) -> void {
    if m.getWord(value) == 0 {
        _ = values.init(value, valueType(pspec))
    } else {
        values.reset(value)
    }
    const f = m.getWord(classOf(pspec) + C_SET_DEFAULT)
    if f != 0 {
        const call: SetDefault = unsafe { @ptrFromInt(SetDefault, f) }
        call(pspec, value)
    }
}

pub fn validate(pspec: usize, value: usize) -> bool {
    const f = m.getWord(classOf(pspec) + C_VALIDATE)
    if f == 0 { return false }
    const before0 = m.getWord(value + 8)
    const before1 = m.getWord(value + 16)
    const call: Validate = unsafe { @ptrFromInt(Validate, f) }
    const changed = call(pspec, value)
    return changed != 0 || before0 != m.getWord(value + 8) || before1 != m.getWord(value + 16)
}

pub fn cmp(pspec: usize, a: usize, b: usize) -> i32 {
    const f = m.getWord(classOf(pspec) + C_CMP)
    if f == 0 { return 0 }
    const call: Compare = unsafe { @ptrFromInt(Compare, f) }
    const r = call(pspec, a, b)
    return if r < 0 { -1 } else if r > 0 { 1 } else { 0 }
}

export fn g_param_value_set_default(pspec: usize, value: usize) -> void { setDefault(pspec, value) }

export fn g_param_value_defaults(pspec: usize, value: usize) -> i32 {
    const dflt = m.alloc(24)
    _ = values.init(dflt, valueType(pspec))
    setDefault(pspec, dflt)
    const same = cmp(pspec, value, dflt) == 0
    values.unset(dflt)
    m.release(dflt)
    return if same { 1 } else { 0 }
}

export fn g_param_value_validate(pspec: usize, value: usize) -> i32 { return if validate(pspec, value) { 1 } else { 0 } }

export fn g_param_value_is_valid(pspec: usize, value: usize) -> i32 {
    const f = m.getWord(classOf(pspec) + C_IS_VALID)
    if f != 0 {
        const call: Validate = unsafe { @ptrFromInt(Validate, f) }
        return call(pspec, value)
    }
    const tmp = m.alloc(24)
    _ = values.init(tmp, m.getWord(value))
    values.copy(value, tmp)
    const changed = validate(pspec, tmp)
    values.unset(tmp)
    m.release(tmp)
    return if changed { 0 } else { 1 }
}

pub fn convert(pspec: usize, src: usize, dest: usize, strict: bool) -> bool {
    const tmp = m.alloc(24)
    _ = values.init(tmp, m.getWord(dest))
    if values.transform(src, tmp) && (!validate(pspec, tmp) || !strict) {
        values.unset(dest)
        m.copy(dest, tmp, 24)
        m.release(tmp)
        return true
    }
    values.unset(tmp)
    m.release(tmp)
    return false
}

export fn g_param_value_convert(pspec: usize, src_value: usize, dest_value: usize, strict_validation: i32) -> i32 { return if convert(pspec, src_value, dest_value, strict_validation != 0) { 1 } else { 0 } }
export fn g_param_values_cmp(pspec: usize, value1: usize, value2: usize) -> i32 { return cmp(pspec, value1, value2) }

fn holdsParam(value: usize, function: []const u8) -> bool {
    if value != 0 && types.isA(m.getWord(value), types.T_PARAM) { return true }
    var text = m.text()
    m.pushText(&text, function)
    m.pushText(&text, ": assertion 'G_VALUE_HOLDS_PARAM (value)' failed")
    messages.log(m.literal("GLib-GObject"), messages.LEVEL_CRITICAL, text.address)
    m.dispose(&text)
    return false
}

export fn g_value_set_param(value: usize, param: usize) -> void {
    if !holdsParam(value, "g_value_set_param") { return }
    if param != 0 { _ = ref(param) }
    if valueOf(value) != 0 { unref(valueOf(value)) }
    m.putWord(value + 8, param)
}

export fn g_value_take_param(value: usize, param: usize) -> void {
    if !holdsParam(value, "g_value_take_param") { return }
    if valueOf(value) != 0 { unref(valueOf(value)) }
    m.putWord(value + 8, param)
}

export fn g_value_get_param(value: usize) -> usize { return if holdsParam(value, "g_value_get_param") { valueOf(value) } else { 0 } }

export fn g_value_dup_param(value: usize) -> usize {
    if !holdsParam(value, "g_value_dup_param") { return 0 }
    return if valueOf(value) == 0 { 0 } else { ref(valueOf(value)) }
}

// ---------------------------------------------------------------------------
// The constructors

fn make(kind: usize, name: usize, nick: usize, blurb: usize, flags: i32) -> usize { return internal(kindTypes[kind], name, nick, blurb, flags) }

fn rangeFailed(function: []const u8) -> usize {
    var text = m.text()
    m.pushText(&text, function)
    m.pushText(&text, ": assertion 'default_value >= minimum && default_value <= maximum' failed")
    messages.log(m.literal("GLib-GObject"), messages.LEVEL_CRITICAL, text.address)
    m.dispose(&text)
    return 0
}

export fn g_param_spec_char(name: usize, nick: usize, blurb: usize, minimum: i8, maximum: i8, default_value: i8, flags: i32) -> usize {
    if default_value < minimum || default_value > maximum { return rangeFailed("g_param_spec_char") }
    const p = make(K_CHAR, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.put8(p + 72, @bitCast(u8, minimum))
    m.put8(p + 73, @bitCast(u8, maximum))
    m.put8(p + 74, @bitCast(u8, default_value))
    return p
}

export fn g_param_spec_uchar(name: usize, nick: usize, blurb: usize, minimum: u8, maximum: u8, default_value: u8, flags: i32) -> usize {
    if default_value < minimum || default_value > maximum { return rangeFailed("g_param_spec_uchar") }
    const p = make(K_UCHAR, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.put8(p + 72, minimum)
    m.put8(p + 73, maximum)
    m.put8(p + 74, default_value)
    return p
}

export fn g_param_spec_boolean(name: usize, nick: usize, blurb: usize, default_value: i32, flags: i32) -> usize {
    const p = make(K_BOOLEAN, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putI32(p + 72, if default_value != 0 { 1 } else { 0 })
    return p
}

export fn g_param_spec_int(name: usize, nick: usize, blurb: usize, minimum: i32, maximum: i32, default_value: i32, flags: i32) -> usize {
    if default_value < minimum || default_value > maximum { return rangeFailed("g_param_spec_int") }
    const p = make(K_INT, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putI32(p + 72, minimum)
    m.putI32(p + 76, maximum)
    m.putI32(p + 80, default_value)
    return p
}

export fn g_param_spec_uint(name: usize, nick: usize, blurb: usize, minimum: u32, maximum: u32, default_value: u32, flags: i32) -> usize {
    if default_value < minimum || default_value > maximum { return rangeFailed("g_param_spec_uint") }
    const p = make(K_UINT, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.put32(p + 72, minimum)
    m.put32(p + 76, maximum)
    m.put32(p + 80, default_value)
    return p
}

fn wide(kind: usize, function: []const u8, name: usize, nick: usize, blurb: usize, minimum: u64, maximum: u64, default_value: u64, signed: bool, flags: i32) -> usize {
    var bad = false
    if signed {
        bad = @bitCast(i64, default_value) < @bitCast(i64, minimum) || @bitCast(i64, default_value) > @bitCast(i64, maximum)
    } else {
        bad = default_value < minimum || default_value > maximum
    }
    if bad { return rangeFailed(function) }
    const p = make(kind, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.put64(p + 72, minimum)
    m.put64(p + 80, maximum)
    m.put64(p + 88, default_value)
    return p
}

export fn g_param_spec_long(name: usize, nick: usize, blurb: usize, minimum: i64, maximum: i64, default_value: i64, flags: i32) -> usize { return wide(K_LONG, "g_param_spec_long", name, nick, blurb, @bitCast(u64, minimum), @bitCast(u64, maximum), @bitCast(u64, default_value), true, flags) }
export fn g_param_spec_ulong(name: usize, nick: usize, blurb: usize, minimum: u64, maximum: u64, default_value: u64, flags: i32) -> usize { return wide(K_ULONG, "g_param_spec_ulong", name, nick, blurb, minimum, maximum, default_value, false, flags) }
export fn g_param_spec_int64(name: usize, nick: usize, blurb: usize, minimum: i64, maximum: i64, default_value: i64, flags: i32) -> usize { return wide(K_INT64, "g_param_spec_int64", name, nick, blurb, @bitCast(u64, minimum), @bitCast(u64, maximum), @bitCast(u64, default_value), true, flags) }
export fn g_param_spec_uint64(name: usize, nick: usize, blurb: usize, minimum: u64, maximum: u64, default_value: u64, flags: i32) -> usize { return wide(K_UINT64, "g_param_spec_uint64", name, nick, blurb, minimum, maximum, default_value, false, flags) }

export fn g_param_spec_unichar(name: usize, nick: usize, blurb: usize, default_value: u32, flags: i32) -> usize {
    const p = make(K_UNICHAR, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.put32(p + 72, default_value)
    return p
}

export fn g_param_spec_enum(name: usize, nick: usize, blurb: usize, enum_type: usize, default_value: i32, flags: i32) -> usize {
    if types.fundamentalOf(enum_type) != types.T_ENUM {
        values.gobjectCritical("g_param_spec_enum: assertion 'G_TYPE_IS_ENUM (enum_type)' failed")
        return 0
    }
    const class = g_type_class_ref(enum_type)
    if values.enumValue(class, default_value) == 0 {
        values.gobjectCritical("g_param_spec_enum: assertion 'g_enum_get_value (enum_class, default_value) != NULL' failed")
        return 0
    }
    const p = make(K_ENUM, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putWord(p + P_VALUE_TYPE, enum_type)
    m.putWord(p + 72, class)
    m.putI32(p + 80, default_value)
    return p
}

export fn g_param_spec_flags(name: usize, nick: usize, blurb: usize, flags_type: usize, default_value: u32, flags: i32) -> usize {
    if types.fundamentalOf(flags_type) != types.T_FLAGS {
        values.gobjectCritical("g_param_spec_flags: assertion 'G_TYPE_IS_FLAGS (flags_type)' failed")
        return 0
    }
    const class = g_type_class_ref(flags_type)
    if (default_value & m.get32(class + 8)) != default_value {
        values.gobjectCritical("g_param_spec_flags: assertion '(default_value & flags_class->mask) == default_value' failed")
        return 0
    }
    const p = make(K_FLAGS, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putWord(p + P_VALUE_TYPE, flags_type)
    m.putWord(p + 72, class)
    m.put32(p + 80, default_value)
    return p
}

export fn g_param_spec_float(name: usize, nick: usize, blurb: usize, minimum: f32, maximum: f32, default_value: f32, flags: i32) -> usize {
    if default_value < minimum || default_value > maximum { return rangeFailed("g_param_spec_float") }
    const p = make(K_FLOAT, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putF32(p + 72, minimum)
    m.putF32(p + 76, maximum)
    m.putF32(p + 80, default_value)
    return p
}

export fn g_param_spec_double(name: usize, nick: usize, blurb: usize, minimum: f64, maximum: f64, default_value: f64, flags: i32) -> usize {
    if default_value < minimum || default_value > maximum { return rangeFailed("g_param_spec_double") }
    const p = make(K_DOUBLE, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putF64(p + 72, minimum)
    m.putF64(p + 80, maximum)
    m.putF64(p + 88, default_value)
    return p
}

export fn g_param_spec_string(name: usize, nick: usize, blurb: usize, default_value: usize, flags: i32) -> usize {
    const p = make(K_STRING, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putWord(p + 72, if default_value == 0 { 0 } else { m.dup(default_value) })
    return p
}

fn typed(kind: usize, t: usize, name: usize, nick: usize, blurb: usize, flags: i32) -> usize {
    const p = make(kind, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putWord(p + P_VALUE_TYPE, t)
    return p
}

export fn g_param_spec_param(name: usize, nick: usize, blurb: usize, param_type: usize, flags: i32) -> usize { return typed(K_PARAM, param_type, name, nick, blurb, flags) }

export fn g_param_spec_boxed(name: usize, nick: usize, blurb: usize, boxed_type: usize, flags: i32) -> usize {
    if types.fundamentalOf(boxed_type) != types.T_BOXED || boxed_type == types.T_BOXED {
        values.gobjectCritical("g_param_spec_boxed: assertion 'G_TYPE_IS_BOXED (boxed_type)' failed")
        return 0
    }
    return typed(K_BOXED, boxed_type, name, nick, blurb, flags)
}

export fn g_param_spec_pointer(name: usize, nick: usize, blurb: usize, flags: i32) -> usize { return make(K_POINTER, name, nick, blurb, flags) }

export fn g_param_spec_object(name: usize, nick: usize, blurb: usize, object_type: usize, flags: i32) -> usize {
    if !types.isA(object_type, types.T_OBJECT) && types.fundamentalOf(object_type) != types.T_INTERFACE {
        values.gobjectCritical("g_param_spec_object: assertion 'g_type_is_a (object_type, G_TYPE_OBJECT)' failed")
        return 0
    }
    return typed(K_OBJECT, object_type, name, nick, blurb, flags)
}

export fn g_param_spec_gtype(name: usize, nick: usize, blurb: usize, is_a_type: usize, flags: i32) -> usize {
    const p = make(K_GTYPE, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putWord(p + 72, is_a_type)
    return p
}

export fn g_param_spec_variant(name: usize, nick: usize, blurb: usize, t: usize, default_value: usize, flags: i32) -> usize {
    if default_value != 0 && g_variant_is_of_type(default_value, t) == 0 {
        values.gobjectCritical("g_param_spec_variant: assertion 'default_value == NULL || g_variant_is_of_type (default_value, type)' failed")
        return 0
    }
    const p = make(K_VARIANT, name, nick, blurb, flags)
    if p == 0 { return 0 }
    m.putWord(p + 72, g_variant_type_copy(t))
    m.putWord(p + 80, if default_value == 0 { 0 } else { g_variant_ref_sink(default_value) })
    return p
}

export fn g_param_spec_override(name: usize, overridden_: usize) -> usize {
    var overridden = overridden_
    while redirectTarget(overridden) != 0 { overridden = redirectTarget(overridden) }
    const p = make(K_OVERRIDE, name, 0, 0, flagsOf(overridden))
    if p == 0 { return 0 }
    m.putWord(p + P_VALUE_TYPE, valueType(overridden))
    m.putWord(p + 72, ref(overridden))
    return p
}
