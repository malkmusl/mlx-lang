// ubidi.h for C: the functions of std.unicode.bidi
// (std/src/unicode/bidi.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.bidi")

export fn ubidi_open() -> usize { return implementation.ubidi_open() }
export fn ubidi_openSized(maxLength: i32, maxRunCount: i32, status: usize) -> usize { return implementation.ubidi_openSized(maxLength, maxRunCount, status) }
export fn ubidi_close(b: usize) -> void { implementation.ubidi_close(b) }
export fn ubidi_setInverse(b: usize, isInverse: u8) -> void { implementation.ubidi_setInverse(b, isInverse) }
export fn ubidi_isInverse(b: usize) -> u8 { return implementation.ubidi_isInverse(b) }
export fn ubidi_orderParagraphsLTR(b: usize, orderParagraphsLTR: u8) -> void { implementation.ubidi_orderParagraphsLTR(b, orderParagraphsLTR) }
export fn ubidi_isOrderParagraphsLTR(b: usize) -> u8 { return implementation.ubidi_isOrderParagraphsLTR(b) }
export fn ubidi_setReorderingMode(b: usize, mode: i32) -> void { implementation.ubidi_setReorderingMode(b, mode) }
export fn ubidi_getReorderingMode(b: usize) -> i32 { return implementation.ubidi_getReorderingMode(b) }
export fn ubidi_setReorderingOptions(b: usize, options: u32) -> void { implementation.ubidi_setReorderingOptions(b, options) }
export fn ubidi_getReorderingOptions(b: usize) -> u32 { return implementation.ubidi_getReorderingOptions(b) }
export fn ubidi_setContext(b: usize, prologue: usize, proLength: i32, epilogue: usize, epiLength: i32, status: usize) -> void { implementation.ubidi_setContext(b, prologue, proLength, epilogue, epiLength, status) }
export fn ubidi_setPara(b: usize, text: usize, length: i32, paraLevel: u8, embeddingLevels: usize, status: usize) -> void { implementation.ubidi_setPara(b, text, length, paraLevel, embeddingLevels, status) }
export fn ubidi_setLine(para: usize, start: i32, limit: i32, line: usize, status: usize) -> void { implementation.ubidi_setLine(para, start, limit, line, status) }
export fn ubidi_getDirection(b: usize) -> i32 { return implementation.ubidi_getDirection(b) }
export fn ubidi_getBaseDirection(text: usize, length: i32) -> i32 { return implementation.ubidi_getBaseDirection(text, length) }
export fn ubidi_getText(b: usize) -> usize { return implementation.ubidi_getText(b) }
export fn ubidi_getLength(b: usize) -> i32 { return implementation.ubidi_getLength(b) }
export fn ubidi_getParaLevel(b: usize) -> u8 { return implementation.ubidi_getParaLevel(b) }
export fn ubidi_countParagraphs(b: usize) -> i32 { return implementation.ubidi_countParagraphs(b) }
export fn ubidi_getParagraph(b: usize, charIndex: i32, paraStart: usize, paraLimit: usize, paraLevel: usize, status: usize) -> i32 { return implementation.ubidi_getParagraph(b, charIndex, paraStart, paraLimit, paraLevel, status) }
export fn ubidi_getParagraphByIndex(b: usize, paraIndex: i32, paraStart: usize, paraLimit: usize, paraLevel: usize, status: usize) -> void { implementation.ubidi_getParagraphByIndex(b, paraIndex, paraStart, paraLimit, paraLevel, status) }
export fn ubidi_getLevelAt(b: usize, charIndex: i32) -> u8 { return implementation.ubidi_getLevelAt(b, charIndex) }
export fn ubidi_getLevels(b: usize, status: usize) -> usize { return implementation.ubidi_getLevels(b, status) }
export fn ubidi_getLogicalRun(b: usize, logicalPosition: i32, logicalLimit: usize, level: usize) -> void { implementation.ubidi_getLogicalRun(b, logicalPosition, logicalLimit, level) }
export fn ubidi_countRuns(b: usize, status: usize) -> i32 { return implementation.ubidi_countRuns(b, status) }
export fn ubidi_getVisualRun(b: usize, runIndex: i32, logicalStart: usize, length: usize) -> i32 { return implementation.ubidi_getVisualRun(b, runIndex, logicalStart, length) }
export fn ubidi_getVisualIndex(b: usize, logicalIndex: i32, status: usize) -> i32 { return implementation.ubidi_getVisualIndex(b, logicalIndex, status) }
export fn ubidi_getLogicalIndex(b: usize, visualIndex: i32, status: usize) -> i32 { return implementation.ubidi_getLogicalIndex(b, visualIndex, status) }
export fn ubidi_getLogicalMap(b: usize, indexMap: usize, status: usize) -> void { implementation.ubidi_getLogicalMap(b, indexMap, status) }
export fn ubidi_getVisualMap(b: usize, indexMap: usize, status: usize) -> void { implementation.ubidi_getVisualMap(b, indexMap, status) }
export fn ubidi_reorderLogical(levels: usize, length: i32, indexMap: usize) -> void { implementation.ubidi_reorderLogical(levels, length, indexMap) }
export fn ubidi_reorderVisual(levels: usize, length: i32, indexMap: usize) -> void { implementation.ubidi_reorderVisual(levels, length, indexMap) }
export fn ubidi_invertMap(srcMap: usize, destMap: usize, length: i32) -> void { implementation.ubidi_invertMap(srcMap, destMap, length) }
export fn ubidi_getProcessedLength(b: usize) -> i32 { return implementation.ubidi_getProcessedLength(b) }
export fn ubidi_getResultLength(b: usize, status: usize) -> i32 { return implementation.ubidi_getResultLength(b, status) }
export fn ubidi_getCustomizedClass(b: usize, c: i32) -> i32 { return implementation.ubidi_getCustomizedClass(b, c) }
export fn ubidi_setClassCallback(b: usize, newFn: usize, newContext: usize, oldFn: usize, oldContext: usize, status: usize) -> void { implementation.ubidi_setClassCallback(b, newFn, newContext, oldFn, oldContext, status) }
export fn ubidi_getClassCallback(b: usize, callback: usize, context: usize) -> void { implementation.ubidi_getClassCallback(b, callback, context) }
export fn ubidi_writeReordered(b: usize, dest: usize, destSize: i32, options: u16, status: usize) -> i32 { return implementation.ubidi_writeReordered(b, dest, destSize, options, status) }
export fn ubidi_writeReverse(src: usize, srcLength: i32, dest: usize, destSize: i32, options: u16, status: usize) -> i32 { return implementation.ubidi_writeReverse(src, srcLength, dest, destSize, options, status) }
