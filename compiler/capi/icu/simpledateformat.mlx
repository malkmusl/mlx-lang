// udat.h for C: the functions of std.unicode.format.date.simple
// (std/src/unicode/format/date/simple.mlx), each calling the pub function
// of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.date.simple")

export fn udat_open(timeStyle: i32, dateStyle: i32, localeId: usize, tzID: usize, tzIDLength: i32, pattern: usize, patternLength: i32, status: usize) -> usize { return implementation.udat_open(timeStyle, dateStyle, localeId, tzID, tzIDLength, pattern, patternLength, status) }
export fn udat_close(format: usize) -> void { implementation.udat_close(format) }
export fn udat_clone(fmt: usize, status: usize) -> usize { return implementation.udat_clone(fmt, status) }
export fn udat_format(format: usize, dateToFormat: f64, result: usize, resultLength: i32, position: usize, status: usize) -> i32 { return implementation.udat_format(format, dateToFormat, result, resultLength, position, status) }
export fn udat_formatCalendar(format: usize, calendar: usize, result: usize, capacity: i32, position: usize, status: usize) -> i32 { return implementation.udat_formatCalendar(format, calendar, result, capacity, position, status) }
export fn udat_formatForFields(format: usize, dateToFormat: f64, result: usize, resultLength: i32, fpositer: usize, status: usize) -> i32 { return implementation.udat_formatForFields(format, dateToFormat, result, resultLength, fpositer, status) }
export fn udat_formatCalendarForFields(format: usize, calendar: usize, result: usize, capacity: i32, fpositer: usize, status: usize) -> i32 { return implementation.udat_formatCalendarForFields(format, calendar, result, capacity, fpositer, status) }
export fn udat_parse(format: usize, textUnits: usize, textLength: i32, parsePos: usize, status: usize) -> f64 { return implementation.udat_parse(format, textUnits, textLength, parsePos, status) }
export fn udat_parseCalendar(format: usize, calendar: usize, textUnits: usize, textLength: i32, parsePos: usize, status: usize) -> void { implementation.udat_parseCalendar(format, calendar, textUnits, textLength, parsePos, status) }
export fn udat_isLenient(fmt: usize) -> u8 { return implementation.udat_isLenient(fmt) }
export fn udat_setLenient(fmt: usize, isLenient: u8) -> void { implementation.udat_setLenient(fmt, isLenient) }
export fn udat_getBooleanAttribute(fmt: usize, attr: i32, status: usize) -> u8 { return implementation.udat_getBooleanAttribute(fmt, attr, status) }
export fn udat_setBooleanAttribute(fmt: usize, attr: i32, newValue: u8, status: usize) -> void { implementation.udat_setBooleanAttribute(fmt, attr, newValue, status) }
export fn udat_getCalendar(fmt: usize) -> usize { return implementation.udat_getCalendar(fmt) }
export fn udat_setCalendar(fmt: usize, calendarToSet: usize) -> void { implementation.udat_setCalendar(fmt, calendarToSet) }
export fn udat_getNumberFormat(fmt: usize) -> usize { return implementation.udat_getNumberFormat(fmt) }
export fn udat_getNumberFormatForField(fmt: usize, field: u16) -> usize { return implementation.udat_getNumberFormatForField(fmt, field) }
export fn udat_adoptNumberFormatForFields(fmt: usize, fields: usize, numberFormatToSet: usize, status: usize) -> void { implementation.udat_adoptNumberFormatForFields(fmt, fields, numberFormatToSet, status) }
export fn udat_setNumberFormat(fmt: usize, numberFormatToSet: usize) -> void { implementation.udat_setNumberFormat(fmt, numberFormatToSet) }
export fn udat_adoptNumberFormat(fmt: usize, numberFormatToAdopt: usize) -> void { implementation.udat_adoptNumberFormat(fmt, numberFormatToAdopt) }
export fn udat_getAvailable(localeIndex: i32) -> usize { return implementation.udat_getAvailable(localeIndex) }
export fn udat_countAvailable() -> i32 { return implementation.udat_countAvailable() }
export fn udat_getLocaleByType(fmt: usize, kind: i32, status: usize) -> usize { return implementation.udat_getLocaleByType(fmt, kind, status) }
export fn udat_get2DigitYearStart(fmt: usize, status: usize) -> f64 { return implementation.udat_get2DigitYearStart(fmt, status) }
export fn udat_set2DigitYearStart(fmt: usize, d: f64, status: usize) -> void { implementation.udat_set2DigitYearStart(fmt, d, status) }
export fn udat_toPattern(fmt: usize, localized: u8, result: usize, resultLength: i32, status: usize) -> i32 { return implementation.udat_toPattern(fmt, localized, result, resultLength, status) }
export fn udat_applyPattern(format: usize, localized: u8, pattern: usize, patternLength: i32) -> void { implementation.udat_applyPattern(format, localized, pattern, patternLength) }
export fn udat_getSymbols(fmt: usize, kind: i32, symbolIndex: i32, result: usize, resultLength: i32, status: usize) -> i32 { return implementation.udat_getSymbols(fmt, kind, symbolIndex, result, resultLength, status) }
export fn udat_countSymbols(fmt: usize, kind: i32) -> i32 { return implementation.udat_countSymbols(fmt, kind) }
export fn udat_setSymbols(format: usize, kind: i32, symbolIndex: i32, value: usize, valueLength: i32, status: usize) -> void { implementation.udat_setSymbols(format, kind, symbolIndex, value, valueLength, status) }
export fn udat_setContext(fmt: usize, value: i32, status: usize) -> void { implementation.udat_setContext(fmt, value, status) }
export fn udat_getContext(fmt: usize, kind: i32, status: usize) -> i32 { return implementation.udat_getContext(fmt, kind, status) }
export fn udat_toCalendarDateField(field: i32) -> i32 { return implementation.udat_toCalendarDateField(field) }
