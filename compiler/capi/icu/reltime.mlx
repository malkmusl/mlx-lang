// ureldatefmt.h for C: the functions of std.unicode.format.reltime
// (std/src/unicode/format/reltime.mlx), each calling the pub function of
// the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.reltime")

export fn ureldatefmt_open(localeId: usize, nfToAdopt: usize, width: i32, capitalizationContext: i32, status: usize) -> usize { return implementation.ureldatefmt_open(localeId, nfToAdopt, width, capitalizationContext, status) }
export fn ureldatefmt_close(reldatefmt: usize) -> void { implementation.ureldatefmt_close(reldatefmt) }
export fn ureldatefmt_openResult(ec: usize) -> usize { return implementation.ureldatefmt_openResult(ec) }
export fn ureldatefmt_resultAsValue(ufrdt: usize, ec: usize) -> usize { return implementation.ureldatefmt_resultAsValue(ufrdt, ec) }
export fn ureldatefmt_closeResult(ufrdt: usize) -> void { implementation.ureldatefmt_closeResult(ufrdt) }
export fn ureldatefmt_formatNumeric(reldatefmt: usize, offset: f64, unit: i32, result: usize, resultCapacity: i32, status: usize) -> i32 { return implementation.ureldatefmt_formatNumeric(reldatefmt, offset, unit, result, resultCapacity, status) }
export fn ureldatefmt_formatNumericToResult(reldatefmt: usize, offset: f64, unit: i32, result: usize, status: usize) -> void { implementation.ureldatefmt_formatNumericToResult(reldatefmt, offset, unit, result, status) }
export fn ureldatefmt_format(reldatefmt: usize, offset: f64, unit: i32, result: usize, resultCapacity: i32, status: usize) -> i32 { return implementation.ureldatefmt_format(reldatefmt, offset, unit, result, resultCapacity, status) }
export fn ureldatefmt_formatToResult(reldatefmt: usize, offset: f64, unit: i32, result: usize, status: usize) -> void { implementation.ureldatefmt_formatToResult(reldatefmt, offset, unit, result, status) }
export fn ureldatefmt_combineDateAndTime(reldatefmt: usize, relativeDateString: usize, relativeDateStringLen: i32, timeString: usize, timeStringLen: i32, result: usize, resultCapacity: i32, status: usize) -> i32 { return implementation.ureldatefmt_combineDateAndTime(reldatefmt, relativeDateString, relativeDateStringLen, timeString, timeStringLen, result, resultCapacity, status) }
