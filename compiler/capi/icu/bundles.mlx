// ures.h for C: the functions of std.unicode.locale.bundles
// (std/src/unicode/locale/bundles.mlx), each calling the pub function of
// the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.locale.bundles")

export fn ures_open(packageName: usize, locale: usize, status: usize) -> usize { return implementation.ures_open(packageName, locale, status) }
export fn ures_openDirect(packageName: usize, locale: usize, status: usize) -> usize { return implementation.ures_openDirect(packageName, locale, status) }
export fn ures_openU(packageName: usize, locale: usize, status: usize) -> usize { return implementation.ures_openU(packageName, locale, status) }
export fn ures_close(resourceBundle: usize) -> void { implementation.ures_close(resourceBundle) }
export fn ures_getVersion(resB: usize, versionInfo: usize) -> void { implementation.ures_getVersion(resB, versionInfo) }
export fn ures_getLocaleByType(resourceBundle: usize, type_: i32, status: usize) -> usize { return implementation.ures_getLocaleByType(resourceBundle, type_, status) }
export fn ures_getString(resourceBundle: usize, len: usize, status: usize) -> usize { return implementation.ures_getString(resourceBundle, len, status) }
export fn ures_getUTF8String(resB: usize, dest: usize, length: usize, forceCopy: bool, status: usize) -> usize { return implementation.ures_getUTF8String(resB, dest, length, forceCopy, status) }
export fn ures_getBinary(resourceBundle: usize, len: usize, status: usize) -> usize { return implementation.ures_getBinary(resourceBundle, len, status) }
export fn ures_getIntVector(resourceBundle: usize, len: usize, status: usize) -> usize { return implementation.ures_getIntVector(resourceBundle, len, status) }
export fn ures_getUInt(resourceBundle: usize, status: usize) -> u32 { return implementation.ures_getUInt(resourceBundle, status) }
export fn ures_getInt(resourceBundle: usize, status: usize) -> i32 { return implementation.ures_getInt(resourceBundle, status) }
export fn ures_getSize(resourceBundle: usize) -> i32 { return implementation.ures_getSize(resourceBundle) }
export fn ures_getType(resourceBundle: usize) -> i32 { return implementation.ures_getType(resourceBundle) }
export fn ures_getKey(resourceBundle: usize) -> usize { return implementation.ures_getKey(resourceBundle) }
export fn ures_resetIterator(resourceBundle: usize) -> void { implementation.ures_resetIterator(resourceBundle) }
export fn ures_hasNext(resourceBundle: usize) -> bool { return implementation.ures_hasNext(resourceBundle) }
export fn ures_getNextResource(resourceBundle: usize, fillIn: usize, status: usize) -> usize { return implementation.ures_getNextResource(resourceBundle, fillIn, status) }
export fn ures_getNextString(resourceBundle: usize, len: usize, key: usize, status: usize) -> usize { return implementation.ures_getNextString(resourceBundle, len, key, status) }
export fn ures_getByIndex(resourceBundle: usize, indexR: i32, fillIn: usize, status: usize) -> usize { return implementation.ures_getByIndex(resourceBundle, indexR, fillIn, status) }
export fn ures_getStringByIndex(resourceBundle: usize, indexS: i32, len: usize, status: usize) -> usize { return implementation.ures_getStringByIndex(resourceBundle, indexS, len, status) }
export fn ures_getUTF8StringByIndex(resB: usize, stringIndex: i32, dest: usize, pLength: usize, forceCopy: bool, status: usize) -> usize { return implementation.ures_getUTF8StringByIndex(resB, stringIndex, dest, pLength, forceCopy, status) }
export fn ures_getByKey(resourceBundle: usize, key: usize, fillIn: usize, status: usize) -> usize { return implementation.ures_getByKey(resourceBundle, key, fillIn, status) }
export fn ures_getStringByKey(resB: usize, key: usize, len: usize, status: usize) -> usize { return implementation.ures_getStringByKey(resB, key, len, status) }
export fn ures_getUTF8StringByKey(resB: usize, key: usize, dest: usize, pLength: usize, forceCopy: bool, status: usize) -> usize { return implementation.ures_getUTF8StringByKey(resB, key, dest, pLength, forceCopy, status) }
export fn ures_openAvailableLocales(packageName: usize, status: usize) -> usize { return implementation.ures_openAvailableLocales(packageName, status) }
