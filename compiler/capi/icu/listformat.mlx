// ulistformatter.h for C: the functions of std.unicode.format.list
// (std/src/unicode/format/list.mlx), each calling the pub function of the
// same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.list")

export fn ulistfmt_open(locale_: usize, status: usize) -> usize { return implementation.ulistfmt_open(locale_, status) }
export fn ulistfmt_openForType(locale_: usize, kind: i32, width: i32, status: usize) -> usize { return implementation.ulistfmt_openForType(locale_, kind, width, status) }
export fn ulistfmt_close(listfmt: usize) -> void { implementation.ulistfmt_close(listfmt) }
export fn ulistfmt_openResult(ec: usize) -> usize { return implementation.ulistfmt_openResult(ec) }
export fn ulistfmt_resultAsValue(uresult: usize, ec: usize) -> usize { return implementation.ulistfmt_resultAsValue(uresult, ec) }
export fn ulistfmt_closeResult(uresult: usize) -> void { implementation.ulistfmt_closeResult(uresult) }
export fn ulistfmt_format(listfmt: usize, strings: usize, stringLengths: usize, stringCount: i32, dest: usize, capacity: i32, status: usize) -> i32 { return implementation.ulistfmt_format(listfmt, strings, stringLengths, stringCount, dest, capacity, status) }
export fn ulistfmt_formatStringsToResult(listfmt: usize, strings: usize, stringLengths: usize, stringCount: i32, uresult: usize, status: usize) -> void { implementation.ulistfmt_formatStringsToResult(listfmt, strings, stringLengths, stringCount, uresult, status) }
