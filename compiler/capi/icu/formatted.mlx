// uformattedvalue.h, ufieldpositer.h for C: the functions of
// std.unicode.format (std/src/unicode/format.mlx), each calling the pub
// function of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format")

export fn ucfpos_open(ec: usize) -> usize { return implementation.ucfpos_open(ec) }
export fn ucfpos_reset(ucfpos: usize, ec: usize) -> void { implementation.ucfpos_reset(ucfpos, ec) }
export fn ucfpos_close(ucfpos: usize) -> void { implementation.ucfpos_close(ucfpos) }
export fn ucfpos_constrainCategory(ucfpos: usize, category: i32, ec: usize) -> void { implementation.ucfpos_constrainCategory(ucfpos, category, ec) }
export fn ucfpos_constrainField(ucfpos: usize, category: i32, field: i32, ec: usize) -> void { implementation.ucfpos_constrainField(ucfpos, category, field, ec) }
export fn ucfpos_getCategory(ucfpos: usize, ec: usize) -> i32 { return implementation.ucfpos_getCategory(ucfpos, ec) }
export fn ucfpos_getField(ucfpos: usize, ec: usize) -> i32 { return implementation.ucfpos_getField(ucfpos, ec) }
export fn ucfpos_getIndexes(ucfpos: usize, pStart: usize, pLimit: usize, ec: usize) -> void { implementation.ucfpos_getIndexes(ucfpos, pStart, pLimit, ec) }
export fn ucfpos_getInt64IterationContext(ucfpos: usize, ec: usize) -> i64 { return implementation.ucfpos_getInt64IterationContext(ucfpos, ec) }
export fn ucfpos_setInt64IterationContext(ucfpos: usize, context: i64, ec: usize) -> void { implementation.ucfpos_setInt64IterationContext(ucfpos, context, ec) }
export fn ucfpos_matchesField(ucfpos: usize, category: i32, field: i32, ec: usize) -> bool { return implementation.ucfpos_matchesField(ucfpos, category, field, ec) }
export fn ucfpos_setState(ucfpos: usize, category: i32, field: i32, start: i32, limit: i32, ec: usize) -> void { implementation.ucfpos_setState(ucfpos, category, field, start, limit, ec) }
export fn ufmtval_getString(ufmtval: usize, pLength: usize, ec: usize) -> usize { return implementation.ufmtval_getString(ufmtval, pLength, ec) }
export fn ufmtval_nextPosition(ufmtval: usize, ucfpos: usize, ec: usize) -> bool { return implementation.ufmtval_nextPosition(ufmtval, ucfpos, ec) }
export fn ufieldpositer_open(status: usize) -> usize { return implementation.ufieldpositer_open(status) }
export fn ufieldpositer_close(fpositer: usize) -> void { implementation.ufieldpositer_close(fpositer) }
export fn ufieldpositer_next(fpositer: usize, beginIndex: usize, endIndex: usize) -> i32 { return implementation.ufieldpositer_next(fpositer, beginIndex, endIndex) }
