// ustring.h (case mapping) for C: the functions of std.unicode.casing
// (std/src/unicode/casing.mlx), each calling the pub function of the same
// name there, with the same C types and error codes.
const implementation = @import("std.unicode.casing")

export fn u_strToLower(dest: usize, capacity: i32, src: usize, length: i32, locale: usize, status: usize) -> i32 { return implementation.u_strToLower(dest, capacity, src, length, locale, status) }
export fn u_strToUpper(dest: usize, capacity: i32, src: usize, length: i32, locale: usize, status: usize) -> i32 { return implementation.u_strToUpper(dest, capacity, src, length, locale, status) }
export fn u_strFoldCase(dest: usize, capacity: i32, src: usize, length: i32, options: u32, status: usize) -> i32 { return implementation.u_strFoldCase(dest, capacity, src, length, options, status) }
