// unicode/umachine.h
// mlx-unicode: the basic types of ICU's C API. The library is this
// repository's own, in Mlx (std.unicode, with its C functions in
// compiler/capi/icu); these modules declare what C and C++ programs
// written for ICU's API name, and mlx-cheaders makes the headers of them.

// (Mlx names of C types: C has them as they are.)
pub const char16 = u16
pub const c_char = u8
pub const c_int = i32

pub const UBool = i8
// char16_t in C++, uint16_t in C.
pub const UChar = char16
pub const UChar32 = i32
pub const UVersionInfo = [4]u8
pub const UDate = f64

pub const U_SENTINEL: i32 = -1
pub const UCHAR_MIN_VALUE: i32 = 0
pub const UCHAR_MAX_VALUE: i32 = 0x10ffff
pub const U_MAX_VERSION_LENGTH: i32 = 4
pub const U_MAX_VERSION_STRING_LENGTH: i32 = 20
pub const U_IS_BIG_ENDIAN: i32 = 0
pub const U_SIZEOF_UCHAR: i32 = 2
pub const U_SIZEOF_WCHAR_T: i32 = 4
pub const U_HAVE_WCHAR_H: i32 = 1
pub const U_CHARSET_FAMILY: i32 = 0
pub const U_ASCII_FAMILY: i32 = 0
pub const U_DISABLE_RENAMING: i32 = 1
pub const U_PLATFORM_IS_LINUX_BASED: i32 = 1
pub const U_HAVE_PLACEMENT_NEW: i32 = 1
pub const U_HAVE_CHAR16_T: i32 = 1
pub const U_MILLIS_PER_SECOND: i32 = 1000
pub const U_MILLIS_PER_MINUTE: i32 = 60000
pub const U_MILLIS_PER_HOUR: i32 = 3600000
pub const U_MILLIS_PER_DAY: i32 = 86400000
