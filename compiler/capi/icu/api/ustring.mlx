// unicode/ustring.h
// mlx-unicode: strings of UTF-16 code units. A function that writes a
// string returns its whole length: when it does not fit in `capacity`
// it sets U_BUFFER_OVERFLOW_ERROR, when it fits exactly no NUL follows
// (U_STRING_NOT_TERMINATED_WARNING), else a NUL does. A length of -1
// means the string ends at its NUL.
const ubrk = @import("./ubrk.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const U_COMPARE_CODE_POINT_ORDER: i32 = 0x8000
pub const U_COMPARE_IGNORE_CASE: i32 = 0x10000
pub const U_TITLECASE_NO_LOWERCASE: i32 = 0x100
pub const U_TITLECASE_NO_BREAK_ADJUSTMENT: i32 = 0x200
pub const U_TITLECASE_ADJUST_TO_CASED: i32 = 0x400
pub const U_TITLECASE_SENTENCES: i32 = 0x800
pub const U_TITLECASE_WHOLE_STRING: i32 = 0x20
pub const U_FOLD_CASE_DEFAULT: i32 = 0
pub const U_FOLD_CASE_EXCLUDE_SPECIAL_I: i32 = 1
pub extern("c") fn u_strlen(s: [*]const umachine.UChar) -> i32
pub extern("c") fn u_countChar32(s: [*]const umachine.UChar, length: i32) -> i32
pub extern("c") fn u_strcat(dst: [*]umachine.UChar, src: [*]const umachine.UChar) -> [*]umachine.UChar
pub extern("c") fn u_strncat(dst: [*]umachine.UChar, src: [*]const umachine.UChar, n: i32) -> [*]umachine.UChar
pub extern("c") fn u_strchr(s: [*]const umachine.UChar, c: umachine.UChar) -> [*]umachine.UChar
pub extern("c") fn u_strchr32(s: [*]const umachine.UChar, c: umachine.UChar32) -> [*]umachine.UChar
pub extern("c") fn u_strrchr(s: [*]const umachine.UChar, c: umachine.UChar) -> [*]umachine.UChar
pub extern("c") fn u_memchr(s: [*]const umachine.UChar, c: umachine.UChar, count: i32) -> [*]umachine.UChar
pub extern("c") fn u_strstr(s: [*]const umachine.UChar, substring: [*]const umachine.UChar) -> [*]umachine.UChar
pub extern("c") fn u_strcmp(s1: [*]const umachine.UChar, s2: [*]const umachine.UChar) -> i32
pub extern("c") fn u_strncmp(ucs1: [*]const umachine.UChar, ucs2: [*]const umachine.UChar, n: i32) -> i32
pub extern("c") fn u_strCompare(s1: [*]const umachine.UChar, length1: i32, s2: [*]const umachine.UChar, length2: i32, codePointOrder: umachine.UBool) -> i32
pub extern("c") fn u_strcmpCodePointOrder(s1: [*]const umachine.UChar, s2: [*]const umachine.UChar) -> i32
pub extern("c") fn u_strCaseCompare(s1: [*]const umachine.UChar, length1: i32, s2: [*]const umachine.UChar, length2: i32, options: u32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn u_strcasecmp(s1: [*]const umachine.UChar, s2: [*]const umachine.UChar, options: u32) -> i32
pub extern("c") fn u_strncasecmp(s1: [*]const umachine.UChar, s2: [*]const umachine.UChar, n: i32, options: u32) -> i32
pub extern("c") fn u_memcasecmp(s1: [*]const umachine.UChar, s2: [*]const umachine.UChar, length: i32, options: u32) -> i32
pub extern("c") fn u_strcpy(dst: [*]umachine.UChar, src: [*]const umachine.UChar) -> [*]umachine.UChar
pub extern("c") fn u_strncpy(dst: [*]umachine.UChar, src: [*]const umachine.UChar, n: i32) -> [*]umachine.UChar
pub extern("c") fn u_uastrcpy(dst: [*]umachine.UChar, src: [*]const umachine.c_char) -> [*]umachine.UChar
pub extern("c") fn u_uastrncpy(dst: [*]umachine.UChar, src: [*]const umachine.c_char, n: i32) -> [*]umachine.UChar
pub extern("c") fn u_austrcpy(dst: [*]umachine.c_char, src: [*]const umachine.UChar) -> [*]umachine.c_char
pub extern("c") fn u_austrncpy(dst: [*]umachine.c_char, src: [*]const umachine.UChar, n: i32) -> [*]umachine.c_char
pub extern("c") fn u_memcpy(dest: [*]umachine.UChar, src: [*]const umachine.UChar, count: i32) -> [*]umachine.UChar
pub extern("c") fn u_memmove(dest: [*]umachine.UChar, src: [*]const umachine.UChar, count: i32) -> [*]umachine.UChar
pub extern("c") fn u_memset(dest: [*]umachine.UChar, c: umachine.UChar, count: i32) -> [*]umachine.UChar
pub extern("c") fn u_memcmp(buf1: [*]const umachine.UChar, buf2: [*]const umachine.UChar, count: i32) -> i32
pub extern("c") fn u_memcmpCodePointOrder(s1: [*]const umachine.UChar, s2: [*]const umachine.UChar, count: i32) -> i32
pub extern("c") fn u_unescape(src: [*]const umachine.c_char, dest: [*]umachine.UChar, destCapacity: i32) -> i32
pub extern("c") fn u_strToUpper(dest: [*]umachine.UChar, destCapacity: i32, src: [*]const umachine.UChar, srcLength: i32, locale: [*]const umachine.c_char, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn u_strToLower(dest: [*]umachine.UChar, destCapacity: i32, src: [*]const umachine.UChar, srcLength: i32, locale: [*]const umachine.c_char, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn u_strToTitle(dest: [*]umachine.UChar, destCapacity: i32, src: [*]const umachine.UChar, srcLength: i32, titleIter: *ubrk.UBreakIterator, locale: [*]const umachine.c_char, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn u_strFoldCase(dest: [*]umachine.UChar, destCapacity: i32, src: [*]const umachine.UChar, srcLength: i32, options: u32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn u_strToUTF8(dest: [*]umachine.c_char, destCapacity: i32, pDestLength: [*]i32, src: [*]const umachine.UChar, srcLength: i32, pErrorCode: *utypes.UErrorCode) -> [*]umachine.c_char
pub extern("c") fn u_strFromUTF8(dest: [*]umachine.UChar, destCapacity: i32, pDestLength: [*]i32, src: [*]const umachine.c_char, srcLength: i32, pErrorCode: *utypes.UErrorCode) -> [*]umachine.UChar
pub extern("c") fn u_strToUTF8WithSub(dest: [*]umachine.c_char, destCapacity: i32, pDestLength: [*]i32, src: [*]const umachine.UChar, srcLength: i32, subchar: umachine.UChar32, pNumSubstitutions: [*]i32, pErrorCode: *utypes.UErrorCode) -> [*]umachine.c_char
pub extern("c") fn u_strFromUTF8WithSub(dest: [*]umachine.UChar, destCapacity: i32, pDestLength: [*]i32, src: [*]const umachine.c_char, srcLength: i32, subchar: umachine.UChar32, pNumSubstitutions: [*]i32, pErrorCode: *utypes.UErrorCode) -> [*]umachine.UChar
pub extern("c") fn u_strFromUTF8Lenient(dest: [*]umachine.UChar, destCapacity: i32, pDestLength: [*]i32, src: [*]const umachine.c_char, srcLength: i32, pErrorCode: *utypes.UErrorCode) -> [*]umachine.UChar
pub extern("c") fn u_strToUTF32(dest: [*]umachine.UChar32, destCapacity: i32, pDestLength: [*]i32, src: [*]const umachine.UChar, srcLength: i32, pErrorCode: *utypes.UErrorCode) -> [*]umachine.UChar32
pub extern("c") fn u_strFromUTF32(dest: [*]umachine.UChar, destCapacity: i32, pDestLength: [*]i32, src: [*]const umachine.UChar32, srcLength: i32, pErrorCode: *utypes.UErrorCode) -> [*]umachine.UChar
