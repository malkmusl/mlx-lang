// unicode/utf.h
// mlx-unicode: code points, and UTF-8 and UTF-16.
const umachine = @import("./umachine.mlx")
const utf8 = @import("./utf8.mlx")
const utf16 = @import("./utf16.mlx")

const UChar32 = umachine.UChar32

pub fn U_IS_UNICODE_NONCHAR(c: UChar32) -> bool { return c >= 0xfdd0 && (c <= 0xfdef || (c & 0xfffe) == 0xfffe) && c <= 0x10ffff }
pub fn U_IS_UNICODE_CHAR(c: UChar32) -> bool { return @bitCast(u32, c) < 0xd800 || (0xdfff < c && c <= 0x10ffff && !U_IS_UNICODE_NONCHAR(c)) }
pub fn U_IS_BMP(c: UChar32) -> bool { return @bitCast(u32, c) <= 0xffff }
pub fn U_IS_SUPPLEMENTARY(c: UChar32) -> bool { return @bitCast(u32, c -% 0x10000) <= 0xfffff }
pub fn U_IS_LEAD(c: UChar32) -> bool { return (@bitCast(u32, c) & 0xfffffc00) == 0xd800 }
pub fn U_IS_TRAIL(c: UChar32) -> bool { return (@bitCast(u32, c) & 0xfffffc00) == 0xdc00 }
pub fn U_IS_SURROGATE(c: UChar32) -> bool { return (@bitCast(u32, c) & 0xfffff800) == 0xd800 }
pub fn U_IS_SURROGATE_LEAD(c: UChar32) -> bool { return (c & 0x400) == 0 }
pub fn U_IS_SURROGATE_TRAIL(c: UChar32) -> bool { return (c & 0x400) != 0 }
