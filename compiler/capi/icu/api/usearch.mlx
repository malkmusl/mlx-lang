// unicode/usearch.h
// mlx-unicode: string search by collation (std.unicode.search): where a
// pattern occurs in text as a collator compares them, matches beginning
// and ending on grapheme cluster boundaries, with ICU's element
// comparisons (exact, or a base letter of the pattern matching it with
// any accent or case). Canonical matching is kept but takes no part.
const ubrk = @import("./ubrk.mlx")
const ucol = @import("./ucol.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const USEARCH_DONE: i32 = -1

pub const UStringSearch = struct {}

pub const USearchAttribute = enum(i32, nonexhaustive) {
    USEARCH_OVERLAP = 0,
    USEARCH_CANONICAL_MATCH = 1,
    USEARCH_ELEMENT_COMPARISON = 2,
    USEARCH_ATTRIBUTE_COUNT = 3,
}

pub const USearchAttributeValue = enum(i32, nonexhaustive) {
    USEARCH_DEFAULT = -1,
    USEARCH_OFF,
    USEARCH_ON,
    USEARCH_STANDARD_ELEMENT_COMPARISON,
    USEARCH_PATTERN_BASE_WEIGHT_IS_WILDCARD,
    USEARCH_ANY_BASE_WEIGHT_IS_WILDCARD,
    USEARCH_ATTRIBUTE_VALUE_COUNT,
}

pub extern("c") fn usearch_open(pattern: [*]const umachine.UChar, patternlength: i32, text: [*]const umachine.UChar, textlength: i32, locale: ?[*]const umachine.c_char, breakiter: ?*ubrk.UBreakIterator, status: *utypes.UErrorCode) -> ?*UStringSearch
pub extern("c") fn usearch_openFromCollator(pattern: [*]const umachine.UChar, patternlength: i32, text: [*]const umachine.UChar, textlength: i32, collator: *const ucol.UCollator, breakiter: ?*ubrk.UBreakIterator, status: *utypes.UErrorCode) -> ?*UStringSearch
pub extern("c") fn usearch_close(searchiter: ?*UStringSearch) -> void
pub extern("c") fn usearch_setOffset(strsrch: *UStringSearch, position: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn usearch_getOffset(strsrch: *const UStringSearch) -> i32
pub extern("c") fn usearch_setAttribute(strsrch: *UStringSearch, attribute: USearchAttribute, value: USearchAttributeValue, status: *utypes.UErrorCode) -> void
pub extern("c") fn usearch_getAttribute(strsrch: *const UStringSearch, attribute: USearchAttribute) -> USearchAttributeValue
pub extern("c") fn usearch_getMatchedStart(strsrch: *const UStringSearch) -> i32
pub extern("c") fn usearch_getMatchedLength(strsrch: *const UStringSearch) -> i32
pub extern("c") fn usearch_getMatchedText(strsrch: *const UStringSearch, result: ?[*]umachine.UChar, resultCapacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn usearch_setBreakIterator(strsrch: *UStringSearch, breakiter: ?*ubrk.UBreakIterator, status: *utypes.UErrorCode) -> void
pub extern("c") fn usearch_getBreakIterator(strsrch: *const UStringSearch) -> ?*const ubrk.UBreakIterator
pub extern("c") fn usearch_setText(strsrch: *UStringSearch, text: [*]const umachine.UChar, textlength: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn usearch_getText(strsrch: *const UStringSearch, length: *i32) -> [*]const umachine.UChar
pub extern("c") fn usearch_getCollator(strsrch: *const UStringSearch) -> *ucol.UCollator
pub extern("c") fn usearch_setCollator(strsrch: *UStringSearch, collator: *const ucol.UCollator, status: *utypes.UErrorCode) -> void
pub extern("c") fn usearch_setPattern(strsrch: *UStringSearch, pattern: [*]const umachine.UChar, patternlength: i32, status: *utypes.UErrorCode) -> void
pub extern("c") fn usearch_getPattern(strsrch: *const UStringSearch, length: *i32) -> [*]const umachine.UChar
pub extern("c") fn usearch_first(strsrch: *UStringSearch, status: *utypes.UErrorCode) -> i32
pub extern("c") fn usearch_following(strsrch: *UStringSearch, position: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn usearch_last(strsrch: *UStringSearch, status: *utypes.UErrorCode) -> i32
pub extern("c") fn usearch_preceding(strsrch: *UStringSearch, position: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn usearch_next(strsrch: *UStringSearch, status: *utypes.UErrorCode) -> i32
pub extern("c") fn usearch_previous(strsrch: *UStringSearch, status: *utypes.UErrorCode) -> i32
pub extern("c") fn usearch_reset(strsrch: *UStringSearch) -> void
// (ICU's internal API, which its own string search stands on.)
pub extern("c") fn usearch_search(strsrch: *UStringSearch, startIdx: i32, matchStart: ?*i32, matchLimit: ?*i32, status: *utypes.UErrorCode) -> umachine.UBool
pub extern("c") fn usearch_searchBackwards(strsrch: *UStringSearch, startIdx: i32, matchStart: ?*i32, matchLimit: ?*i32, status: *utypes.UErrorCode) -> umachine.UBool
