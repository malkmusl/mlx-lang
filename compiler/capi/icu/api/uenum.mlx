// unicode/uenum.h
// mlx-unicode: enumerations of strings.
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UEnumeration = struct {}
pub extern("c") fn uenum_close(en: *UEnumeration) -> void
pub extern("c") fn uenum_count(en: *UEnumeration, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uenum_unext(en: *UEnumeration, resultLength: [*]i32, status: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn uenum_next(en: *UEnumeration, resultLength: [*]i32, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn uenum_reset(en: *UEnumeration, status: *utypes.UErrorCode) -> void
pub extern("c") fn uenum_openCharStringsEnumeration(strings: [*]const [*]const umachine.c_char, count: i32, ec: *utypes.UErrorCode) -> *UEnumeration
pub extern("c") fn uenum_openUCharStringsEnumeration(strings: [*]const [*]const umachine.UChar, count: i32, ec: *utypes.UErrorCode) -> *UEnumeration
