// unicode/ucol.h
// mlx-unicode: collation (the Unicode Collation Algorithm, UTS #10,
// with CLDR's root collation and the tailorings of CLDR's locales).
const parseerr = @import("./parseerr.mlx")
const uenum = @import("./uenum.mlx")
const ugenerated = @import("./ugenerated.mlx")
const uiter = @import("./uiter.mlx")
const uloc = @import("./uloc.mlx")
const umachine = @import("./umachine.mlx")
const uset = @import("./uset.mlx")
const utypes = @import("./utypes.mlx")

pub const UCollator = struct {}
pub const UCollationResult = enum(i32, nonexhaustive) {
    UCOL_EQUAL = 0,
    UCOL_GREATER = 1,
    UCOL_LESS = -1,
}

pub const UColAttributeValue = enum(i32, nonexhaustive) {
    UCOL_DEFAULT = -1,
    UCOL_PRIMARY = 0,
    UCOL_SECONDARY = 1,
    UCOL_TERTIARY = 2,
    UCOL_CE_STRENGTH_LIMIT,
    UCOL_IDENTICAL = 15,
    UCOL_STRENGTH_LIMIT,
    UCOL_ON = 17,
    UCOL_SHIFTED = 20,
    UCOL_NON_IGNORABLE = 21,
    UCOL_LOWER_FIRST = 24,
    UCOL_UPPER_FIRST = 25,
    UCOL_ATTRIBUTE_VALUE_COUNT,
}
pub const UCollationStrength = UColAttributeValue
pub const UCOL_DEFAULT_STRENGTH: UColAttributeValue = UColAttributeValue.UCOL_TERTIARY
pub const UCOL_QUATERNARY: UColAttributeValue = UColAttributeValue.UCOL_CE_STRENGTH_LIMIT
pub const UCOL_OFF: UColAttributeValue = UColAttributeValue.UCOL_STRENGTH_LIMIT

pub const UColReorderCode = enum(i32, nonexhaustive) {
    UCOL_REORDER_CODE_DEFAULT = -1,
    UCOL_REORDER_CODE_SPACE = 0x1000,
    UCOL_REORDER_CODE_PUNCTUATION = 0x1001,
    UCOL_REORDER_CODE_SYMBOL = 0x1002,
    UCOL_REORDER_CODE_CURRENCY = 0x1003,
    UCOL_REORDER_CODE_DIGIT = 0x1004,
    UCOL_REORDER_CODE_LIMIT = 0x1005,
}
pub const UCOL_REORDER_CODE_NONE: i32 = @intFromEnum(ugenerated.UScriptCode.USCRIPT_UNKNOWN)
pub const UCOL_REORDER_CODE_OTHERS: i32 = @intFromEnum(ugenerated.UScriptCode.USCRIPT_UNKNOWN)
pub const UCOL_REORDER_CODE_FIRST: UColReorderCode = UColReorderCode.UCOL_REORDER_CODE_SPACE

pub const UColAttribute = enum(i32, nonexhaustive) {
    UCOL_FRENCH_COLLATION,
    UCOL_ALTERNATE_HANDLING,
    UCOL_CASE_FIRST,
    UCOL_CASE_LEVEL,
    UCOL_NORMALIZATION_MODE,
    UCOL_STRENGTH,
    UCOL_HIRAGANA_QUATERNARY_MODE = 6,
    UCOL_NUMERIC_COLLATION = 7,
    UCOL_ATTRIBUTE_COUNT,
}
pub const UCOL_DECOMPOSITION_MODE: UColAttribute = UColAttribute.UCOL_NORMALIZATION_MODE

pub const UColRuleOption = enum(i32, nonexhaustive) {
    UCOL_TAILORING_ONLY,
    UCOL_FULL_RULES,
}

pub const UColBoundMode = enum(i32, nonexhaustive) {
    UCOL_BOUND_LOWER = 0,
    UCOL_BOUND_UPPER = 1,
    UCOL_BOUND_UPPER_LONG = 2,
    UCOL_BOUND_VALUE_COUNT,
}

pub extern("c") fn ucol_open(loc: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *UCollator
pub extern("c") fn ucol_openRules(rules: [*]const umachine.UChar, rulesLength: i32, normalizationMode: UColAttributeValue, strength: UCollationStrength, parseError: *parseerr.UParseError, status: *utypes.UErrorCode) -> *UCollator
pub extern("c") fn ucol_close(coll: *UCollator) -> void
pub extern("c") fn ucol_clone(coll: *const UCollator, status: *utypes.UErrorCode) -> *UCollator
pub extern("c") fn ucol_safeClone(coll: *const UCollator, stackBuffer: ?*anyopaque, pBufferSize: [*]i32, status: *utypes.UErrorCode) -> *UCollator
pub extern("c") fn ucol_strcoll(coll: *const UCollator, source: [*]const umachine.UChar, sourceLength: i32, target: [*]const umachine.UChar, targetLength: i32) -> UCollationResult
pub extern("c") fn ucol_strcollUTF8(coll: *const UCollator, source: [*]const umachine.c_char, sourceLength: i32, target: [*]const umachine.c_char, targetLength: i32, status: *utypes.UErrorCode) -> UCollationResult
pub extern("c") fn ucol_strcollIter(coll: *const UCollator, sIter: *uiter.UCharIterator, tIter: *uiter.UCharIterator, status: *utypes.UErrorCode) -> UCollationResult
pub extern("c") fn ucol_greater(coll: *const UCollator, source: [*]const umachine.UChar, sourceLength: i32, target: [*]const umachine.UChar, targetLength: i32) -> umachine.UBool
pub extern("c") fn ucol_greaterOrEqual(coll: *const UCollator, source: [*]const umachine.UChar, sourceLength: i32, target: [*]const umachine.UChar, targetLength: i32) -> umachine.UBool
pub extern("c") fn ucol_equal(coll: *const UCollator, source: [*]const umachine.UChar, sourceLength: i32, target: [*]const umachine.UChar, targetLength: i32) -> umachine.UBool
pub extern("c") fn ucol_getStrength(coll: *const UCollator) -> UCollationStrength
pub extern("c") fn ucol_setStrength(coll: *UCollator, strength: UCollationStrength) -> void
pub extern("c") fn ucol_setAttribute(coll: *UCollator, attr: UColAttribute, value: UColAttributeValue, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucol_getAttribute(coll: *const UCollator, attr: UColAttribute, status: *utypes.UErrorCode) -> UColAttributeValue
pub extern("c") fn ucol_getSortKey(coll: *const UCollator, source: [*]const umachine.UChar, sourceLength: i32, result: [*]u8, resultLength: i32) -> i32
pub extern("c") fn ucol_countAvailable() -> i32
pub extern("c") fn ucol_getAvailable(localeIndex: i32) -> [*]const umachine.c_char
pub extern("c") fn ucol_openAvailableLocales(status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucol_getKeywords(status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucol_getKeywordValues(keyword: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucol_getKeywordValuesForLocale(key: [*]const umachine.c_char, locale: [*]const umachine.c_char, commonlyUsed: umachine.UBool, status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucol_getLocaleByType(coll: *const UCollator, kind: uloc.ULocDataLocaleType, status: *utypes.UErrorCode) -> [*]const umachine.c_char
pub extern("c") fn ucol_getReorderCodes(coll: *const UCollator, dest: [*]i32, destCapacity: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ucol_setReorderCodes(coll: *UCollator, reorderCodes: [*]const i32, reorderCodesLength: i32, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ucol_getRules(coll: *const UCollator, length: [*]i32) -> [*]const umachine.UChar
pub extern("c") fn ucol_getMaxVariable(coll: *const UCollator) -> UColReorderCode
pub extern("c") fn ucol_setMaxVariable(coll: *UCollator, group: UColReorderCode, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ucol_getVariableTop(coll: *const UCollator, status: *utypes.UErrorCode) -> u32
pub extern("c") fn ucol_setVariableTop(coll: *UCollator, varTop: [*]const umachine.UChar, len: i32, status: *utypes.UErrorCode) -> u32
pub extern("c") fn ucol_restoreVariableTop(coll: *UCollator, varTop: u32, status: *utypes.UErrorCode) -> void
pub extern("c") fn ucol_getVersion(coll: *const UCollator, info: *u8) -> void
pub extern("c") fn ucol_getUCAVersion(coll: *const UCollator, info: *u8) -> void
pub extern("c") fn ucol_getTailoredSet(coll: *const UCollator, status: *utypes.UErrorCode) -> *uset.USet
pub extern("c") fn ucol_getContractionsAndExpansions(coll: *const UCollator, contractions: *uset.USet, expansions: *uset.USet, addPrefixes: umachine.UBool, status: *utypes.UErrorCode) -> void
