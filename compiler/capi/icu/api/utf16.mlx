// unicode/utf16.h
// mlx-unicode: UTF-16 by macros (code units in, code points out). Each
// macro is the Mlx function of its name; one that writes takes what it
// writes as pointers (`i: *i64`: the index the macro moves).
const umachine = @import("./umachine.mlx")

const UChar = umachine.UChar
const UChar32 = umachine.UChar32

pub fn U16_IS_SINGLE(c: UChar32) -> bool { return (@bitCast(u32, c) & 0xfffff800) != 0xd800 }
pub fn U16_IS_LEAD(c: UChar32) -> bool { return (@bitCast(u32, c) & 0xfffffc00) == 0xd800 }
pub fn U16_IS_TRAIL(c: UChar32) -> bool { return (@bitCast(u32, c) & 0xfffffc00) == 0xdc00 }
pub fn U16_IS_SURROGATE(c: UChar32) -> bool { return (@bitCast(u32, c) & 0xfffff800) == 0xd800 }
pub fn U16_IS_SURROGATE_LEAD(c: UChar32) -> bool { return (c & 0x400) == 0 }
pub fn U16_IS_SURROGATE_TRAIL(c: UChar32) -> bool { return (c & 0x400) != 0 }

// lead << 10 + trail - this: the code point.
pub const U16_SURROGATE_OFFSET: i32 = (0xd800 << 10) + 0xdc00 - 0x10000
pub const U16_MAX_LENGTH: i32 = 2

pub fn U16_GET_SUPPLEMENTARY(lead: UChar32, trail: UChar32) -> UChar32 { return (lead << 10) + trail - U16_SURROGATE_OFFSET }
pub fn U16_LEAD(supplementary: UChar32) -> UChar { return @intCast(UChar, (supplementary >> 10) + 0xd7c0) }
pub fn U16_TRAIL(supplementary: UChar32) -> UChar { return @intCast(UChar, (supplementary & 0x3ff) | 0xdc00) }
pub fn U16_LENGTH(c: UChar32) -> i32 { return if @bitCast(u32, c) <= 0xffff { 1 } else { 2 } }

pub fn U16_GET_UNSAFE(s: [*]const UChar, i: i64, c: *UChar32) -> void {
    c.* = @intCast(UChar32, s[@intCast(usize, i)])
    if U16_IS_SURROGATE(c.*) {
        if U16_IS_SURROGATE_LEAD(c.*) {
            c.* = U16_GET_SUPPLEMENTARY(c.*, @intCast(UChar32, s[@intCast(usize, i + 1)]))
        } else {
            c.* = U16_GET_SUPPLEMENTARY(@intCast(UChar32, s[@intCast(usize, i - 1)]), c.*)
        }
    }
}

pub fn U16_GET(s: [*]const UChar, start: i64, i: i64, length: i64, c: *UChar32) -> void {
    c.* = @intCast(UChar32, s[@intCast(usize, i)])
    if U16_IS_SURROGATE(c.*) {
        if U16_IS_SURROGATE_LEAD(c.*) {
            if i + 1 != length {
                const trail: UChar32 = @intCast(UChar32, s[@intCast(usize, i + 1)])
                if U16_IS_TRAIL(trail) { c.* = U16_GET_SUPPLEMENTARY(c.*, trail) }
            }
        } else {
            if i > start {
                const lead: UChar32 = @intCast(UChar32, s[@intCast(usize, i - 1)])
                if U16_IS_LEAD(lead) { c.* = U16_GET_SUPPLEMENTARY(lead, c.*) }
            }
        }
    }
}

pub fn U16_GET_OR_FFFD(s: [*]const UChar, start: i64, i: i64, length: i64, c: *UChar32) -> void {
    c.* = @intCast(UChar32, s[@intCast(usize, i)])
    if U16_IS_SURROGATE(c.*) {
        var pair: UChar32 = -1
        if U16_IS_SURROGATE_LEAD(c.*) {
            if i + 1 != length {
                const trail: UChar32 = @intCast(UChar32, s[@intCast(usize, i + 1)])
                if U16_IS_TRAIL(trail) { pair = U16_GET_SUPPLEMENTARY(c.*, trail) }
            }
        } else {
            if i > start {
                const lead: UChar32 = @intCast(UChar32, s[@intCast(usize, i - 1)])
                if U16_IS_LEAD(lead) { pair = U16_GET_SUPPLEMENTARY(lead, c.*) }
            }
        }
        c.* = if pair >= 0 { pair } else { 0xfffd }
    }
}

pub fn U16_NEXT_UNSAFE(s: [*]const UChar, i: *i64, c: *UChar32) -> void {
    c.* = @intCast(UChar32, s[@intCast(usize, i.*)])
    i.* += 1
    if U16_IS_LEAD(c.*) {
        c.* = U16_GET_SUPPLEMENTARY(c.*, @intCast(UChar32, s[@intCast(usize, i.*)]))
        i.* += 1
    }
}

pub fn U16_NEXT(s: [*]const UChar, i: *i64, length: i64, c: *UChar32) -> void {
    c.* = @intCast(UChar32, s[@intCast(usize, i.*)])
    i.* += 1
    if U16_IS_LEAD(c.*) {
        if i.* != length {
            const trail: UChar32 = @intCast(UChar32, s[@intCast(usize, i.*)])
            if U16_IS_TRAIL(trail) {
                i.* += 1
                c.* = U16_GET_SUPPLEMENTARY(c.*, trail)
            }
        }
    }
}

pub fn U16_NEXT_OR_FFFD(s: [*]const UChar, i: *i64, length: i64, c: *UChar32) -> void {
    c.* = @intCast(UChar32, s[@intCast(usize, i.*)])
    i.* += 1
    if U16_IS_SURROGATE(c.*) {
        var pair: UChar32 = 0xfffd
        if U16_IS_SURROGATE_LEAD(c.*) && i.* != length {
            const trail: UChar32 = @intCast(UChar32, s[@intCast(usize, i.*)])
            if U16_IS_TRAIL(trail) {
                i.* += 1
                pair = U16_GET_SUPPLEMENTARY(c.*, trail)
            }
        }
        c.* = pair
    }
}

pub fn U16_APPEND_UNSAFE(s: [*]UChar, i: *i64, c: UChar32) -> void {
    if @bitCast(u32, c) <= 0xffff {
        s[@intCast(usize, i.*)] = @intCast(UChar, c)
        i.* += 1
    } else {
        s[@intCast(usize, i.*)] = @intCast(UChar, (c >> 10) + 0xd7c0)
        i.* += 1
        s[@intCast(usize, i.*)] = @intCast(UChar, (c & 0x3ff) | 0xdc00)
        i.* += 1
    }
}

pub fn U16_APPEND(s: [*]UChar, i: *i64, capacity: i64, c: UChar32, isError: *bool) -> void {
    if @bitCast(u32, c) <= 0xffff {
        s[@intCast(usize, i.*)] = @intCast(UChar, c)
        i.* += 1
    } else if @bitCast(u32, c) <= 0x10ffff && i.* + 1 < capacity {
        s[@intCast(usize, i.*)] = @intCast(UChar, (c >> 10) + 0xd7c0)
        i.* += 1
        s[@intCast(usize, i.*)] = @intCast(UChar, (c & 0x3ff) | 0xdc00)
        i.* += 1
    } else {
        isError.* = true
    }
}

pub fn U16_FWD_1_UNSAFE(s: [*]const UChar, i: *i64) -> void {
    const lead: UChar32 = @intCast(UChar32, s[@intCast(usize, i.*)])
    i.* += 1
    if U16_IS_LEAD(lead) { i.* += 1 }
}

pub fn U16_FWD_1(s: [*]const UChar, i: *i64, length: i64) -> void {
    const lead: UChar32 = @intCast(UChar32, s[@intCast(usize, i.*)])
    i.* += 1
    if U16_IS_LEAD(lead) && i.* != length && U16_IS_TRAIL(@intCast(UChar32, s[@intCast(usize, i.*)])) { i.* += 1 }
}

pub fn U16_FWD_N(s: [*]const UChar, i: *i64, length: i64, n: i32) -> void {
    var count: i32 = n
    while count > 0 && (i.* < length || (length < 0 && s[@intCast(usize, i.*)] != 0)) {
        U16_FWD_1(s, i, length)
        count -= 1
    }
}

pub fn U16_FWD_N_UNSAFE(s: [*]const UChar, i: *i64, n: i32) -> void {
    var count: i32 = n
    while count > 0 {
        U16_FWD_1_UNSAFE(s, i)
        count -= 1
    }
}

pub fn U16_SET_CP_START_UNSAFE(s: [*]const UChar, i: *i64) -> void {
    if U16_IS_TRAIL(@intCast(UChar32, s[@intCast(usize, i.*)])) { i.* -= 1 }
}

pub fn U16_SET_CP_START(s: [*]const UChar, start: i64, i: *i64) -> void {
    if U16_IS_TRAIL(@intCast(UChar32, s[@intCast(usize, i.*)])) && i.* > start && U16_IS_LEAD(@intCast(UChar32, s[@intCast(usize, i.* - 1)])) { i.* -= 1 }
}

pub fn U16_PREV_UNSAFE(s: [*]const UChar, i: *i64, c: *UChar32) -> void {
    i.* -= 1
    c.* = @intCast(UChar32, s[@intCast(usize, i.*)])
    if U16_IS_TRAIL(c.*) {
        i.* -= 1
        c.* = U16_GET_SUPPLEMENTARY(@intCast(UChar32, s[@intCast(usize, i.*)]), c.*)
    }
}

pub fn U16_PREV(s: [*]const UChar, start: i64, i: *i64, c: *UChar32) -> void {
    i.* -= 1
    c.* = @intCast(UChar32, s[@intCast(usize, i.*)])
    if U16_IS_TRAIL(c.*) && i.* > start {
        const lead: UChar32 = @intCast(UChar32, s[@intCast(usize, i.* - 1)])
        if U16_IS_LEAD(lead) {
            i.* -= 1
            c.* = U16_GET_SUPPLEMENTARY(lead, c.*)
        }
    }
}

pub fn U16_PREV_OR_FFFD(s: [*]const UChar, start: i64, i: *i64, c: *UChar32) -> void {
    i.* -= 1
    c.* = @intCast(UChar32, s[@intCast(usize, i.*)])
    if U16_IS_SURROGATE(c.*) {
        var pair: UChar32 = 0xfffd
        if U16_IS_SURROGATE_TRAIL(c.*) && i.* > start {
            const lead: UChar32 = @intCast(UChar32, s[@intCast(usize, i.* - 1)])
            if U16_IS_LEAD(lead) {
                i.* -= 1
                pair = U16_GET_SUPPLEMENTARY(lead, c.*)
            }
        }
        c.* = pair
    }
}

pub fn U16_BACK_1_UNSAFE(s: [*]const UChar, i: *i64) -> void {
    i.* -= 1
    if U16_IS_TRAIL(@intCast(UChar32, s[@intCast(usize, i.*)])) { i.* -= 1 }
}

pub fn U16_BACK_1(s: [*]const UChar, start: i64, i: *i64) -> void {
    i.* -= 1
    if U16_IS_TRAIL(@intCast(UChar32, s[@intCast(usize, i.*)])) && i.* > start && U16_IS_LEAD(@intCast(UChar32, s[@intCast(usize, i.* - 1)])) { i.* -= 1 }
}

pub fn U16_BACK_N(s: [*]const UChar, start: i64, i: *i64, n: i32) -> void {
    var count: i32 = n
    while count > 0 && i.* > start {
        U16_BACK_1(s, start, i)
        count -= 1
    }
}

pub fn U16_BACK_N_UNSAFE(s: [*]const UChar, i: *i64, n: i32) -> void {
    var count: i32 = n
    while count > 0 {
        U16_BACK_1_UNSAFE(s, i)
        count -= 1
    }
}

pub fn U16_SET_CP_LIMIT_UNSAFE(s: [*]const UChar, i: *i64) -> void {
    if U16_IS_LEAD(@intCast(UChar32, s[@intCast(usize, i.* - 1)])) { i.* += 1 }
}

pub fn U16_SET_CP_LIMIT(s: [*]const UChar, start: i64, i: *i64, length: i64) -> void {
    if start < i.* && (i.* < length || length < 0) && U16_IS_LEAD(@intCast(UChar32, s[@intCast(usize, i.* - 1)])) && U16_IS_TRAIL(@intCast(UChar32, s[@intCast(usize, i.*)])) { i.* += 1 }
}
