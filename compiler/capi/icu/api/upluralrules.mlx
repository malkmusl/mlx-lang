// unicode/upluralrules.h
// mlx-unicode: plural rules (CLDR's cardinal and ordinal categories of a
// number for a locale).
const uenum = @import("./uenum.mlx")
const umachine = @import("./umachine.mlx")
const unum = @import("./unum.mlx")
const utypes = @import("./utypes.mlx")

// The results of uformattednumber.h and unumberrangeformatter.h, which
// ICU's header names without including theirs (C allows the typedef twice).
pub const UFormattedNumber = struct {}
pub const UFormattedNumberRange = struct {}

pub const UPluralType = enum(i32, nonexhaustive) {
    UPLURAL_TYPE_CARDINAL,
    UPLURAL_TYPE_ORDINAL,
    UPLURAL_TYPE_COUNT,
}

pub const UPluralRules = struct {}

pub extern("c") fn uplrules_open(locale: [*]const umachine.c_char, status: *utypes.UErrorCode) -> *UPluralRules
pub extern("c") fn uplrules_openForType(locale: [*]const umachine.c_char, type_: UPluralType, status: *utypes.UErrorCode) -> *UPluralRules
pub extern("c") fn uplrules_close(uplrules: *UPluralRules) -> void
pub extern("c") fn uplrules_select(uplrules: *const UPluralRules, number: f64, keyword: [*]umachine.UChar, capacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uplrules_selectFormatted(uplrules: *const UPluralRules, number: *const UFormattedNumber, keyword: [*]umachine.UChar, capacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uplrules_selectForRange(uplrules: *const UPluralRules, urange: *const UFormattedNumberRange, keyword: [*]umachine.UChar, capacity: i32, status: *utypes.UErrorCode) -> i32
pub extern("c") fn uplrules_getKeywords(uplrules: *const UPluralRules, status: *utypes.UErrorCode) -> *uenum.UEnumeration
