// unicode/ucnv.h
// mlx-unicode: converters between charsets and UTF-16
// (std.unicode.converters): UTF-8, UTF-16 and UTF-32 (with and without
// byte order), ISO-8859-1, US-ASCII and the single-byte charsets of the
// Encoding Standard and of the Mac OS, by any of their names; streaming,
// whole texts, one character, or from one charset to another. A charset
// with no converter here (the East Asian multi-byte ones, ISO-2022, EBCDIC)
// fails to open with U_FILE_ACCESS_ERROR; a converter's name is its own,
// not one of ICU's table names.
const c_function_pointers = true
const ucnv_err = @import("./ucnv_err.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

const UConverter = ucnv_err.UConverter
const c_char = umachine.c_char
const UChar = umachine.UChar

pub const UCNV_MAX_CONVERTER_NAME_LENGTH: i32 = 60
pub const UCNV_MAX_FULL_FILE_NAME_LENGTH: i32 = 660
pub const UCNV_SI: i32 = 0x0f
pub const UCNV_SO: i32 = 0x0e

pub const UConverterType = enum(i32, nonexhaustive) {
    UCNV_UNSUPPORTED_CONVERTER = -1,
    UCNV_SBCS = 0,
    UCNV_DBCS = 1,
    UCNV_MBCS = 2,
    UCNV_LATIN_1 = 3,
    UCNV_UTF8 = 4,
    UCNV_UTF16_BigEndian = 5,
    UCNV_UTF16_LittleEndian = 6,
    UCNV_UTF32_BigEndian = 7,
    UCNV_UTF32_LittleEndian = 8,
    UCNV_EBCDIC_STATEFUL = 9,
    UCNV_ISO_2022 = 10,
    UCNV_LMBCS_1 = 11,
    UCNV_LMBCS_2 = 12,
    UCNV_LMBCS_3 = 13,
    UCNV_LMBCS_4 = 14,
    UCNV_LMBCS_5 = 15,
    UCNV_LMBCS_6 = 16,
    UCNV_LMBCS_8 = 17,
    UCNV_LMBCS_11 = 18,
    UCNV_LMBCS_16 = 19,
    UCNV_LMBCS_17 = 20,
    UCNV_LMBCS_18 = 21,
    UCNV_LMBCS_19 = 22,
    UCNV_HZ = 23,
    UCNV_SCSU = 24,
    UCNV_ISCII = 25,
    UCNV_US_ASCII = 26,
    UCNV_UTF7 = 27,
    UCNV_BOCU1 = 28,
    UCNV_UTF16 = 29,
    UCNV_UTF32 = 30,
    UCNV_CESU8 = 31,
    UCNV_IMAP_MAILBOX = 32,
    UCNV_COMPOUND_TEXT = 33,
    UCNV_NUMBER_OF_SUPPORTED_CONVERTER_TYPES = 34,
}

pub const UCNV_LMBCS_LAST: i32 = 22

pub const UConverterPlatform = enum(i32, nonexhaustive) {
    UCNV_UNKNOWN = -1,
    UCNV_IBM = 0,
}

// A callback for what converting to UTF-16 cannot read (the
// UCNV_TO_U_CALLBACK_* of ucnv_err.h, or a program's own).
pub const UConverterToUCallback = fn(context: ?*const anyopaque, args: *ucnv_err.UConverterToUnicodeArgs, codeUnits: ?[*]const c_char, length: i32, reason: ucnv_err.UConverterCallbackReason, pErrorCode: *utypes.UErrorCode) -> void

// A callback for what converting from UTF-16 cannot write.
pub const UConverterFromUCallback = fn(context: ?*const anyopaque, args: *ucnv_err.UConverterFromUnicodeArgs, codeUnits: ?[*]const UChar, length: i32, codePoint: umachine.UChar32, reason: ucnv_err.UConverterCallbackReason, pErrorCode: *utypes.UErrorCode) -> void

pub const UCNV_OPTION_SEP_STRING: []const u8 = ","
pub const UCNV_VALUE_SEP_STRING: []const u8 = "="
pub const UCNV_LOCALE_OPTION_STRING: []const u8 = ",locale="
pub const UCNV_VERSION_OPTION_STRING: []const u8 = ",version="
pub const UCNV_SWAP_LFNL_OPTION_STRING: []const u8 = ",swaplfnl"

// The room for a clone (ucnv_safeClone).
pub const U_CNV_SAFECLONE_BUFFERSIZE: i32 = 1024

// The most bytes a text of `length` UTF-16 units can become.
pub fn UCNV_GET_MAX_BYTES_FOR_STRING(length: i32, maxCharSize: i32) -> i32 { return (length + 10) * maxCharSize }

pub extern("c") fn ucnv_compareNames(name1: [*]const c_char, name2: [*]const c_char) -> umachine.c_int
pub extern("c") fn ucnv_open(converterName: ?[*]const c_char, err: *utypes.UErrorCode) -> ?*UConverter
pub extern("c") fn ucnv_openU(name: ?[*]const UChar, err: *utypes.UErrorCode) -> ?*UConverter
pub extern("c") fn ucnv_openCCSID(codepage: i32, platform: UConverterPlatform, err: *utypes.UErrorCode) -> ?*UConverter
pub extern("c") fn ucnv_openPackage(packageName: ?[*]const c_char, converterName: ?[*]const c_char, err: *utypes.UErrorCode) -> ?*UConverter
pub extern("c") fn ucnv_clone(cnv: *const UConverter, status: *utypes.UErrorCode) -> ?*UConverter
pub extern("c") fn ucnv_safeClone(cnv: *const UConverter, stackBuffer: ?*anyopaque, pBufferSize: ?*i32, status: *utypes.UErrorCode) -> ?*UConverter
pub extern("c") fn ucnv_close(converter: ?*UConverter) -> void
pub extern("c") fn ucnv_getSubstChars(converter: *const UConverter, subChars: [*]c_char, len: *i8, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_setSubstChars(converter: *UConverter, subChars: [*]const c_char, len: i8, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_setSubstString(cnv: *UConverter, s: [*]const UChar, length: i32, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_getInvalidChars(converter: *const UConverter, errBytes: [*]c_char, len: *i8, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_getInvalidUChars(converter: *const UConverter, errUChars: [*]UChar, len: *i8, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_reset(converter: ?*UConverter) -> void
pub extern("c") fn ucnv_resetToUnicode(converter: ?*UConverter) -> void
pub extern("c") fn ucnv_resetFromUnicode(converter: ?*UConverter) -> void
pub extern("c") fn ucnv_getMaxCharSize(converter: *const UConverter) -> i8
pub extern("c") fn ucnv_getMinCharSize(converter: *const UConverter) -> i8
pub extern("c") fn ucnv_getName(converter: *const UConverter, err: *utypes.UErrorCode) -> ?[*]const c_char
pub extern("c") fn ucnv_getCCSID(converter: *const UConverter, err: *utypes.UErrorCode) -> i32
pub extern("c") fn ucnv_getPlatform(converter: *const UConverter, err: *utypes.UErrorCode) -> UConverterPlatform
pub extern("c") fn ucnv_getType(converter: *const UConverter) -> UConverterType
pub extern("c") fn ucnv_getToUCallBack(converter: *const UConverter, action: ?*UConverterToUCallback, context: ?**const anyopaque) -> void
pub extern("c") fn ucnv_getFromUCallBack(converter: *const UConverter, action: ?*UConverterFromUCallback, context: ?**const anyopaque) -> void
pub extern("c") fn ucnv_setToUCallBack(converter: *UConverter, newAction: ?UConverterToUCallback, newContext: ?*const anyopaque, oldAction: ?*UConverterToUCallback, oldContext: ?**const anyopaque, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_setFromUCallBack(converter: *UConverter, newAction: ?UConverterFromUCallback, newContext: ?*const anyopaque, oldAction: ?*UConverterFromUCallback, oldContext: ?**const anyopaque, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_fromUnicode(converter: *UConverter, target: *[*]c_char, targetLimit: [*]const c_char, source: *[*]const UChar, sourceLimit: [*]const UChar, offsets: ?[*]i32, flush: umachine.UBool, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_toUnicode(converter: *UConverter, target: *[*]UChar, targetLimit: [*]const UChar, source: *[*]const c_char, sourceLimit: [*]const c_char, offsets: ?[*]i32, flush: umachine.UBool, err: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_fromUChars(cnv: *UConverter, dest: ?[*]c_char, destCapacity: i32, src: ?[*]const UChar, srcLength: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ucnv_toUChars(cnv: *UConverter, dest: ?[*]UChar, destCapacity: i32, src: ?[*]const c_char, srcLength: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ucnv_getNextUChar(converter: *UConverter, source: *[*]const c_char, sourceLimit: [*]const c_char, err: *utypes.UErrorCode) -> umachine.UChar32
pub extern("c") fn ucnv_convertEx(targetCnv: *UConverter, sourceCnv: *UConverter, target: *[*]c_char, targetLimit: [*]const c_char, source: *[*]const c_char, sourceLimit: [*]const c_char, pivotStart: ?[*]UChar, pivotSource: ?*[*]UChar, pivotTarget: ?*[*]UChar, pivotLimit: ?[*]const UChar, reset: umachine.UBool, flush: umachine.UBool, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_convert(toConverterName: [*]const c_char, fromConverterName: [*]const c_char, target: ?[*]c_char, targetCapacity: i32, source: ?[*]const c_char, sourceLength: i32, pErrorCode: *utypes.UErrorCode) -> i32
pub extern("c") fn ucnv_flushCache() -> i32
pub extern("c") fn ucnv_countAvailable() -> i32
pub extern("c") fn ucnv_getAvailableName(n: i32) -> ?[*]const c_char
pub extern("c") fn ucnv_countAliases(alias: [*]const c_char, pErrorCode: *utypes.UErrorCode) -> u16
pub extern("c") fn ucnv_getAlias(alias: [*]const c_char, n: u16, pErrorCode: *utypes.UErrorCode) -> ?[*]const c_char
pub extern("c") fn ucnv_getAliases(alias: [*]const c_char, aliases: [*]?[*]const c_char, pErrorCode: *utypes.UErrorCode) -> void
pub extern("c") fn ucnv_getStandardName(name: [*]const c_char, standard: ?[*]const c_char, pErrorCode: *utypes.UErrorCode) -> ?[*]const c_char
pub extern("c") fn ucnv_getCanonicalName(alias: [*]const c_char, standard: ?[*]const c_char, pErrorCode: *utypes.UErrorCode) -> ?[*]const c_char
pub extern("c") fn ucnv_getDefaultName() -> [*]const c_char
pub extern("c") fn ucnv_setDefaultName(name: ?[*]const c_char) -> void
pub extern("c") fn ucnv_fixFileSeparator(cnv: *const UConverter, source: ?[*]UChar, sourceLen: i32) -> void
pub extern("c") fn ucnv_isAmbiguous(cnv: *const UConverter) -> umachine.UBool
pub extern("c") fn ucnv_setFallback(cnv: *UConverter, usesFallback: umachine.UBool) -> void
pub extern("c") fn ucnv_usesFallback(cnv: *const UConverter) -> umachine.UBool
pub extern("c") fn ucnv_detectUnicodeSignature(source: [*]const c_char, sourceLength: i32, signatureLength: ?*i32, pErrorCode: *utypes.UErrorCode) -> ?[*]const c_char
pub extern("c") fn ucnv_fromUCountPending(cnv: *const UConverter, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucnv_toUCountPending(cnv: *const UConverter, status: *utypes.UErrorCode) -> i32
pub extern("c") fn ucnv_isFixedWidth(cnv: *UConverter, status: *utypes.UErrorCode) -> umachine.UBool
