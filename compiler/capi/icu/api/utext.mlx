// unicode/utext.h
// mlx-unicode: UText, text a provider hands out in chunks of UTF-16. The
// layout is ICU's: programs fill these structures themselves.
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

const UChar = umachine.UChar
const UChar32 = umachine.UChar32
const UBool = umachine.UBool
const UErrorCode = utypes.UErrorCode

pub const UText = struct {
    magic: u32,
    flags: i32,
    providerProperties: i32,
    sizeOfStruct: i32,
    chunkNativeLimit: i64,
    extraSize: i32,
    nativeIndexingLimit: i32,
    chunkNativeStart: i64,
    chunkOffset: i32,
    chunkLength: i32,
    chunkContents: ?[*]const UChar,
    pFuncs: ?*const UTextFuncs,
    pExtra: ?*anyopaque,
    context: ?*const anyopaque,
    p: ?*const anyopaque,
    q: ?*const anyopaque,
    r: ?*const anyopaque,
    privP: ?*anyopaque,
    a: i64,
    b: i64,
    c: i64,
    privA: i64,
    privB: i64,
    privC: i64,
}

pub const UTextClone = fn(dest: ?UText, src: *const UText, deep: UBool, status: *UErrorCode) -> ?*UText
pub const UTextNativeLength = fn(ut: *UText) -> i64
pub const UTextAccess = fn(ut: *UText, nativeIndex: i64, forward: UBool) -> UBool
pub const UTextExtract = fn(ut: *UText, nativeStart: i64, nativeLimit: i64, dest: ?[*]UChar, destCapacity: i32, status: *UErrorCode) -> i32
pub const UTextReplace = fn(ut: *UText, nativeStart: i64, nativeLimit: i64, replacementText: ?[*]const UChar, replacmentLength: i32, status: *UErrorCode) -> i32
pub const UTextCopy = fn(ut: *UText, nativeStart: i64, nativeLimit: i64, nativeDest: i64, move: UBool, status: *UErrorCode) -> void
pub const UTextMapOffsetToNative = fn(ut: *const UText) -> i64
pub const UTextMapNativeIndexToUTF16 = fn(ut: *const UText, nativeIndex: i64) -> i32
pub const UTextClose = fn(ut: *UText) -> void

pub const UTextFuncs = struct {
    tableSize: i32,
    reserved1: i32,
    reserved2: i32,
    reserved3: i32,
    clone: ?UTextClone,
    nativeLength: ?UTextNativeLength,
    access: ?UTextAccess,
    extract: ?UTextExtract,
    replace: ?UTextReplace,
    copy: ?UTextCopy,
    mapOffsetToNative: ?UTextMapOffsetToNative,
    mapNativeIndexToUTF16: ?UTextMapNativeIndexToUTF16,
    close: ?UTextClose,
    spare1: ?UTextClose,
    spare2: ?UTextClose,
    spare3: ?UTextClose,
}

// What a provider has (bits of providerProperties, by number).
pub const UTEXT_PROVIDER_LENGTH_IS_EXPENSIVE: i32 = 1
pub const UTEXT_PROVIDER_STABLE_CHUNKS: i32 = 2
pub const UTEXT_PROVIDER_WRITABLE: i32 = 3
pub const UTEXT_PROVIDER_HAS_META_DATA: i32 = 4
pub const UTEXT_PROVIDER_OWNS_TEXT: i32 = 5

pub const UTEXT_MAGIC: u32 = 0x345ad82c
pub const U_TEXT_SENTINEL: i32 = -1

// A UText to set up (utext_setup), as a program declares one.
pub const UTEXT_INITIALIZER: UText = UText.{
    .magic = UTEXT_MAGIC, .flags = 0, .providerProperties = 0, .sizeOfStruct = @sizeOf(UText),
    .chunkNativeLimit = 0, .extraSize = 0, .nativeIndexingLimit = 0, .chunkNativeStart = 0,
    .chunkOffset = 0, .chunkLength = 0, .chunkContents = null, .pFuncs = null, .pExtra = null,
    .context = null, .p = null, .q = null, .r = null, .privP = null,
    .a = 0, .b = 0, .c = 0, .privA = 0, .privB = 0, .privC = 0,
}

pub extern("c") fn utext_close(ut: ?*UText) -> ?*UText
pub extern("c") fn utext_setup(ut: ?UText, extraSpace: i32, status: *UErrorCode) -> ?*UText
pub extern("c") fn utext_openUChars(ut: ?UText, s: ?[*]const UChar, length: i64, status: *UErrorCode) -> ?*UText
pub extern("c") fn utext_openUTF8(ut: ?UText, s: ?[*]const umachine.c_char, length: i64, status: *UErrorCode) -> ?*UText
pub extern("c") fn utext_clone(dest: ?UText, src: *const UText, deep: UBool, readOnly: UBool, status: *UErrorCode) -> ?*UText
pub extern("c") fn utext_nativeLength(ut: *UText) -> i64
pub extern("c") fn utext_char32At(ut: *UText, nativeIndex: i64) -> UChar32
pub extern("c") fn utext_current32(ut: *UText) -> UChar32
pub extern("c") fn utext_next32(ut: *UText) -> UChar32
pub extern("c") fn utext_previous32(ut: *UText) -> UChar32
pub extern("c") fn utext_next32From(ut: *UText, nativeIndex: i64) -> UChar32
pub extern("c") fn utext_previous32From(ut: *UText, nativeIndex: i64) -> UChar32
pub extern("c") fn utext_getNativeIndex(ut: *const UText) -> i64
pub extern("c") fn utext_setNativeIndex(ut: *UText, nativeIndex: i64) -> void
pub extern("c") fn utext_extract(ut: *UText, nativeStart: i64, nativeLimit: i64, dest: ?[*]UChar, destCapacity: i32, status: *UErrorCode) -> i32
