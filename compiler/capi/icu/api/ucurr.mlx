// unicode/ucurr.h
// mlx-unicode: currencies (ISO 4217 codes, their names, fraction digits and
// rounding, the currencies of a locale).
const uenum = @import("./uenum.mlx")
const umachine = @import("./umachine.mlx")
const utypes = @import("./utypes.mlx")

pub const UCurrencyUsage = enum(i32, nonexhaustive) {
    UCURR_USAGE_STANDARD = 0,
    UCURR_USAGE_CASH = 1,
    UCURR_USAGE_COUNT = 2,
}

pub extern("c") fn ucurr_forLocale(locale: [*]const umachine.c_char, buff: [*]umachine.UChar, buffCapacity: i32, ec: *utypes.UErrorCode) -> i32

pub const UCurrNameStyle = enum(i32, nonexhaustive) {
    UCURR_SYMBOL_NAME,
    UCURR_LONG_NAME,
    UCURR_NARROW_SYMBOL_NAME,
    UCURR_FORMAL_SYMBOL_NAME,
    UCURR_VARIANT_SYMBOL_NAME,
}

pub extern("c") fn ucurr_getName(currency: [*]const umachine.UChar, locale: [*]const umachine.c_char, nameStyle: UCurrNameStyle, isChoiceFormat: *umachine.UBool, len: *i32, ec: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn ucurr_getPluralName(currency: [*]const umachine.UChar, locale: [*]const umachine.c_char, isChoiceFormat: *umachine.UBool, pluralCount: [*]const umachine.c_char, len: *i32, ec: *utypes.UErrorCode) -> [*]const umachine.UChar
pub extern("c") fn ucurr_getDefaultFractionDigits(currency: [*]const umachine.UChar, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn ucurr_getDefaultFractionDigitsForUsage(currency: [*]const umachine.UChar, usage: UCurrencyUsage, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn ucurr_getRoundingIncrement(currency: [*]const umachine.UChar, ec: *utypes.UErrorCode) -> f64
pub extern("c") fn ucurr_getRoundingIncrementForUsage(currency: [*]const umachine.UChar, usage: UCurrencyUsage, ec: *utypes.UErrorCode) -> f64

pub const UCurrCurrencyType = enum(i32, nonexhaustive) {
    UCURR_ALL = 2147483647,
    UCURR_COMMON = 1,
    UCURR_UNCOMMON = 2,
    UCURR_DEPRECATED = 4,
    UCURR_NON_DEPRECATED = 8,
}

pub extern("c") fn ucurr_openISOCurrencies(currType: u32, pErrorCode: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucurr_isAvailable(isoCode: [*]const umachine.UChar, from: umachine.UDate, to: umachine.UDate, errorCode: *utypes.UErrorCode) -> umachine.UBool
pub extern("c") fn ucurr_countCurrencies(locale: [*]const umachine.c_char, date: umachine.UDate, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn ucurr_forLocaleAndDate(locale: [*]const umachine.c_char, date: umachine.UDate, index: i32, buff: [*]umachine.UChar, buffCapacity: i32, ec: *utypes.UErrorCode) -> i32
pub extern("c") fn ucurr_getKeywordValuesForLocale(key: [*]const umachine.c_char, locale: [*]const umachine.c_char, commonlyUsed: umachine.UBool, status: *utypes.UErrorCode) -> *uenum.UEnumeration
pub extern("c") fn ucurr_getNumericCode(currency: [*]const umachine.UChar) -> i32
