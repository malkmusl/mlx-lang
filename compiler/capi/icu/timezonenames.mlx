// ucal.h (the names of zones) for C: the functions of
// std.unicode.format.date.zonenames
// (std/src/unicode/format/date/zonenames.mlx), each calling the pub
// function of the same name there, with the same C types and error codes.
const implementation = @import("std.unicode.format.date.zonenames")

export fn ucal_getTimeZoneDisplayName(cal: usize, kind: i32, localeId: usize, result: usize, resultLength: i32, status: usize) -> i32 { return implementation.ucal_getTimeZoneDisplayName(cal, kind, localeId, result, resultLength, status) }
