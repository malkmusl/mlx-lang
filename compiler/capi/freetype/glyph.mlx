// Glyph objects (ftglyph.h): outline and bitmap glyphs copied out of a
// slot, transformed, measured and rendered as FreeType's do it.
//
// FT_GlyphRec: library, clazz, format, advance (16.16); an outline glyph
// has the FT_Outline after it, a bitmap glyph left, top and the
// FT_Bitmap. A glyph's class is one of two records the library makes
// (FT_Glyph_Class: the glyph's size and format; its functions are this
// module's, not called through the record).
const m = @import("std.truetype.memory")
const r = @import("std.truetype.records")
const o = @import("std.truetype.objects")
const calc = @import("std.truetype.calc")
const outlines = @import("std.truetype.outlines")
const bitmap = @import("std.truetype.bitmap")
const render = @import("std.truetype.render")

const GLYPH_SIZE: usize = 80
const G_LIBRARY: usize = 0
const G_CLASS: usize = 8
const G_FORMAT: usize = 16
const G_ADVANCE: usize = 24
// An outline glyph's outline; a bitmap glyph's left, top and bitmap.
const G_OUTLINE: usize = 40
const G_LEFT: usize = 40
const G_TOP: usize = 44
const G_BITMAP: usize = 48

// The two classes: FT_Glyph_Class (glyph_size, glyph_format, six
// functions), made when first needed.
var bitmapClass: usize = 0
var outlineClass: usize = 0

fn classOf(format: u32) -> usize {
    if format == r.FORMAT_BITMAP {
        if bitmapClass == 0 {
            bitmapClass = m.cAlloc(64)
            m.putI64(bitmapClass, 80)
            m.put32(bitmapClass + 8, r.FORMAT_BITMAP)
        }
        return bitmapClass
    }
    if format == r.FORMAT_OUTLINE {
        if outlineClass == 0 {
            outlineClass = m.cAlloc(64)
            m.putI64(outlineClass, 80)
            m.put32(outlineClass + 8, r.FORMAT_OUTLINE)
        }
        return outlineClass
    }
    return 0
}

fn isBitmap(glyph: usize) -> bool { return bitmapClass != 0 && m.getWord(glyph + G_CLASS) == bitmapClass }
fn isOutline(glyph: usize) -> bool { return outlineClass != 0 && m.getWord(glyph + G_CLASS) == outlineClass }

fn newGlyph(library: usize, clazz: usize) -> usize {
    const glyph = m.alloc(m.getWord(library), GLYPH_SIZE)
    if glyph == 0 { return 0 }
    m.putWord(glyph + G_LIBRARY, library)
    m.putWord(glyph + G_CLASS, clazz)
    m.put32(glyph + G_FORMAT, m.get32(clazz + 8))
    return glyph
}

export fn FT_New_Glyph(library: usize, format: u32, aglyph: usize) -> i32 {
    if library == 0 || aglyph == 0 { return r.ERR_INVALID_ARGUMENT }
    const clazz = classOf(format)
    if clazz == 0 { return r.ERR_INVALID_GLYPH_FORMAT }
    m.putWord(aglyph, 0)
    const glyph = newGlyph(library, clazz)
    if glyph == 0 { return r.ERR_OUT_OF_MEMORY }
    m.putWord(aglyph, glyph)
    return r.OK
}

// The glyph of a slot (FreeType's ft_bitmap_glyph_init and
// ft_outline_glyph_init).
fn initFromSlot(glyph: usize, slot: usize) -> i32 {
    const s = r.slotRec(slot)
    const library = m.getWord(glyph + G_LIBRARY)
    if isBitmap(glyph) {
        if s.*.format != r.FORMAT_BITMAP { return r.ERR_INVALID_GLYPH_FORMAT }
        m.putI32(glyph + G_LEFT, s.*.bitmap_left)
        m.putI32(glyph + G_TOP, s.*.bitmap_top)
        const internal = o.slotRecord(slot)
        if internal.*.ownBitmap {
            m.copy(glyph + G_BITMAP, slot + r.SLOT_BITMAP, 32)
            internal.*.ownBitmap = false
            return r.OK
        }
        bitmap.init(glyph + G_BITMAP)
        return bitmap.copy(library, slot + r.SLOT_BITMAP, glyph + G_BITMAP)
    }
    if s.*.format != r.FORMAT_OUTLINE { return r.ERR_INVALID_GLYPH_FORMAT }
    const err = outlines.newOutline(library, @intCast(u32, @intCast(i64, s.*.n_points) & 0xFFFF), @intCast(i32, s.*.n_contours), glyph + G_OUTLINE)
    if err != r.OK { return err }
    _ = outlines.copyOutline(slot + r.SLOT_OUTLINE, glyph + G_OUTLINE)
    return r.OK
}

pub fn doneGlyph(glyph: usize) -> void {
    if glyph == 0 { return }
    const library = m.getWord(glyph + G_LIBRARY)
    if isBitmap(glyph) {
        _ = bitmap.done(library, glyph + G_BITMAP)
    } else if isOutline(glyph) {
        _ = outlines.doneOutline(library, glyph + G_OUTLINE)
    }
    m.release(m.getWord(library), glyph)
}

export fn FT_Done_Glyph(glyph: usize) -> void { doneGlyph(glyph) }

export fn FT_Get_Glyph(slot: usize, aglyph: usize) -> i32 {
    if slot == 0 { return r.ERR_INVALID_SLOT_HANDLE }
    if aglyph == 0 { return r.ERR_INVALID_ARGUMENT }
    const s = r.slotRec(slot)
    const clazz = classOf(s.*.format)
    if clazz == 0 { return r.ERR_INVALID_GLYPH_FORMAT }
    const glyph = newGlyph(s.*.library, clazz)
    if glyph == 0 { return r.ERR_OUT_OF_MEMORY }
    var err = r.OK
    if s.*.advance_x >= 0x8000 * 64 || s.*.advance_x <= -0x8000 * 64 || s.*.advance_y >= 0x8000 * 64 || s.*.advance_y <= -0x8000 * 64 {
        err = r.ERR_INVALID_ARGUMENT
    } else {
        m.putI64(glyph + G_ADVANCE, s.*.advance_x * 1024)
        m.putI64(glyph + G_ADVANCE + 8, s.*.advance_y * 1024)
        err = initFromSlot(glyph, slot)
    }
    if err != r.OK {
        doneGlyph(glyph)
        m.putWord(aglyph, 0)
        return err
    }
    m.putWord(aglyph, glyph)
    return r.OK
}

export fn FT_Glyph_Copy(source: usize, target: usize) -> i32 {
    if target == 0 || source == 0 || m.getWord(source + G_CLASS) == 0 { return r.ERR_INVALID_ARGUMENT }
    m.putWord(target, 0)
    const library = m.getWord(source + G_LIBRARY)
    const copy = newGlyph(library, m.getWord(source + G_CLASS))
    if copy == 0 { return r.ERR_OUT_OF_MEMORY }
    m.putI64(copy + G_ADVANCE, m.getI64(source + G_ADVANCE))
    m.putI64(copy + G_ADVANCE + 8, m.getI64(source + G_ADVANCE + 8))
    m.put32(copy + G_FORMAT, m.get32(source + G_FORMAT))
    var err = r.OK
    if isBitmap(source) {
        m.putI32(copy + G_LEFT, m.getI32(source + G_LEFT))
        m.putI32(copy + G_TOP, m.getI32(source + G_TOP))
        err = bitmap.copy(library, source + G_BITMAP, copy + G_BITMAP)
    } else if isOutline(source) {
        const so = r.outline(source + G_OUTLINE)
        err = outlines.newOutline(library, @intCast(u32, @intCast(i64, so.*.n_points) & 0xFFFF), @intCast(i32, so.*.n_contours), copy + G_OUTLINE)
        if err == r.OK { _ = outlines.copyOutline(source + G_OUTLINE, copy + G_OUTLINE) }
    }
    if err != r.OK {
        doneGlyph(copy)
        return err
    }
    m.putWord(target, copy)
    return r.OK
}

fn transform(glyph: usize, matrix: usize, delta: usize) -> void {
    const outline = r.outline(glyph + G_OUTLINE)
    const count = @intCast(i64, outline.*.n_points)
    if matrix != 0 { outlines.transform(outline.*.points, count, m.getI64(matrix), m.getI64(matrix + 8), m.getI64(matrix + 16), m.getI64(matrix + 24)) }
    if delta != 0 { outlines.translate(outline.*.points, count, m.getI64(delta), m.getI64(delta + 8)) }
}

export fn FT_Glyph_Transform(glyph: usize, matrix: usize, delta: usize) -> i32 {
    if glyph == 0 || m.getWord(glyph + G_CLASS) == 0 { return r.ERR_INVALID_ARGUMENT }
    if !isOutline(glyph) { return r.ERR_INVALID_GLYPH_FORMAT }
    transform(glyph, matrix, delta)
    if matrix != 0 { calc.vectorTransform(glyph + G_ADVANCE, matrix) }
    return r.OK
}

const BBOX_UNSCALED: u32 = 0
const BBOX_SUBPIXELS: u32 = 0
const BBOX_GRIDFIT: u32 = 1
const BBOX_TRUNCATE: u32 = 2
const BBOX_PIXELS: u32 = 3

export fn FT_Glyph_Get_CBox(glyph: usize, bbox_mode: u32, acbox: usize) -> void {
    if acbox == 0 { return }
    m.zero(acbox, 32)
    if glyph == 0 || m.getWord(glyph + G_CLASS) == 0 { return }
    var xMin: i64 = 0
    var yMin: i64 = 0
    var xMax: i64 = 0
    var yMax: i64 = 0
    if isBitmap(glyph) {
        xMin = @intCast(i64, m.getI32(glyph + G_LEFT)) * 64
        xMax = xMin + @intCast(i64, r.bitmap(glyph + G_BITMAP).*.width) * 64
        yMax = @intCast(i64, m.getI32(glyph + G_TOP)) * 64
        yMin = yMax - @intCast(i64, r.bitmap(glyph + G_BITMAP).*.rows) * 64
    } else if isOutline(glyph) {
        const box = outlines.outlineCbox(glyph + G_OUTLINE)
        xMin = box.0
        yMin = box.1
        xMax = box.2
        yMax = box.3
    } else {
        return
    }
    if bbox_mode == BBOX_GRIDFIT || bbox_mode == BBOX_PIXELS {
        xMin = calc.pixFloor(xMin)
        yMin = calc.pixFloor(yMin)
        xMax = calc.pixCeil(xMax)
        yMax = calc.pixCeil(yMax)
    }
    if bbox_mode == BBOX_TRUNCATE || bbox_mode == BBOX_PIXELS {
        xMin >>= 6
        yMin >>= 6
        xMax >>= 6
        yMax >>= 6
    }
    m.putI64(acbox, xMin)
    m.putI64(acbox + 8, yMin)
    m.putI64(acbox + 16, xMax)
    m.putI64(acbox + 24, yMax)
}

export fn FT_Glyph_To_Bitmap(the_glyph: usize, render_mode: i32, origin: usize, destroy: u8) -> i32 {
    if the_glyph == 0 { return r.ERR_INVALID_ARGUMENT }
    const glyph = m.getWord(the_glyph)
    if glyph == 0 { return r.ERR_INVALID_ARGUMENT }
    const library = m.getWord(glyph + G_LIBRARY)
    if library == 0 || m.getWord(glyph + G_CLASS) == 0 { return r.ERR_INVALID_ARGUMENT }
    if isBitmap(glyph) { return r.OK }
    if !isOutline(glyph) { return r.ERR_INVALID_ARGUMENT }
    // A slot of its own (FreeType's dummy slot) for the renderer.
    const dummy = m.cAlloc(r.SLOT_REC_SIZE + @sizeOf(o.Slot))
    if dummy == 0 { return r.ERR_OUT_OF_MEMORY }
    const s = r.slotRec(dummy)
    s.*.internal = dummy + r.SLOT_REC_SIZE
    s.*.library = library
    s.*.format = r.FORMAT_OUTLINE
    const b = newGlyph(library, classOf(r.FORMAT_BITMAP))
    if b == 0 {
        m.cFree(dummy)
        return r.ERR_OUT_OF_MEMORY
    }
    if origin != 0 { transform(glyph, 0, origin) }
    // (FreeType's ft_outline_glyph_prepare: the slot borrows the outline.)
    m.copy(dummy + r.SLOT_OUTLINE, glyph + G_OUTLINE, 40)
    s.*.outline_flags &= ~r.OUTLINE_OWNER
    var err = render.renderGlyph(dummy, @intCast(i64, render_mode))
    if destroy == 0 && origin != 0 {
        var back: [2]i64 = undefined
        back[0] = 0 - m.getI64(origin)
        back[1] = 0 - m.getI64(origin + 8)
        transform(glyph, 0, @intFromPtr(&back[0]))
    }
    if err == r.OK { err = initFromSlot(b, dummy) }
    if err != r.OK {
        if o.slotRecord(dummy).*.ownBitmap { m.release(m.getWord(library), s.*.bitmap_buffer) }
        m.cFree(dummy)
        doneGlyph(b)
        return err
    }
    m.putI64(b + G_ADVANCE, m.getI64(glyph + G_ADVANCE))
    m.putI64(b + G_ADVANCE + 8, m.getI64(glyph + G_ADVANCE + 8))
    if destroy != 0 { doneGlyph(glyph) }
    m.putWord(the_glyph, b)
    m.cFree(dummy)
    return r.OK
}
