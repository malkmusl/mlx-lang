// freetype/ftbitmap.h
// mlx-freetype: bitmaps: copying, emboldening, converting to 8 bits a
// pixel, blending onto a BGRA bitmap, and the glyph slot's bitmap made
// its own.
const freetype = @import("./freetype.mlx")
const ftcolor = @import("./ftcolor.mlx")

const FT_Library = freetype.FT_Library
const FT_Bitmap = ftimage.FT_Bitmap
const FT_Error = fttypes.FT_Error

pub extern("c") fn FT_Bitmap_Init(abitmap: *FT_Bitmap) -> void
pub extern("c") fn FT_Bitmap_New(abitmap: *FT_Bitmap) -> void
pub extern("c") fn FT_Bitmap_Copy(library: FT_Library, source: *const FT_Bitmap, target: *FT_Bitmap) -> FT_Error
pub extern("c") fn FT_Bitmap_Embolden(library: FT_Library, bitmap: *FT_Bitmap, xStrength: ftimage.FT_Pos, yStrength: ftimage.FT_Pos) -> FT_Error
// `source` as 8 bits a pixel (gray levels as they are, one bit as 0 or
// 1), its lines a multiple of `alignment` bytes long.
pub extern("c") fn FT_Bitmap_Convert(library: FT_Library, source: *const FT_Bitmap, target: *FT_Bitmap, alignment: fttypes.FT_Int) -> FT_Error
pub extern("c") fn FT_Bitmap_Blend(library: FT_Library, source: *const FT_Bitmap, source_offset: ftimage.FT_Vector, target: *FT_Bitmap, atarget_offset: *ftimage.FT_Vector, color: ftcolor.FT_Color) -> FT_Error
pub extern("c") fn FT_GlyphSlot_Own_Bitmap(slot: freetype.FT_GlyphSlot) -> FT_Error
pub extern("c") fn FT_Bitmap_Done(library: FT_Library, bitmap: *FT_Bitmap) -> FT_Error
