// freetype/t1tables.h
// mlx-freetype: what a PostScript font's dictionaries say, for the CFF
// fonts of the library (FT_Get_PS_Font_Info and FT_Get_PS_Font_Private
// read their Top and Private DICTs); a TrueType font has none (the
// functions fail with FT_Err_Invalid_Argument, as FreeType's do).
const freetype = @import("./freetype.mlx")

const FT_String = fttypes.FT_String
const FT_Long = fttypes.FT_Long
const FT_ULong = fttypes.FT_ULong
const FT_Int = fttypes.FT_Int
const FT_UInt = fttypes.FT_UInt
const FT_Short = fttypes.FT_Short
const FT_UShort = fttypes.FT_UShort
const FT_Byte = fttypes.FT_Byte
const FT_Bool = fttypes.FT_Bool
const FT_Fixed = fttypes.FT_Fixed
const FT_Face = freetype.FT_Face

pub const PS_FontInfoRec_ = struct {
    version: *FT_String
    notice: *FT_String
    full_name: *FT_String
    family_name: *FT_String
    weight: *FT_String
    italic_angle: FT_Long
    is_fixed_pitch: FT_Bool
    underline_position: FT_Short
    underline_thickness: FT_UShort
}
pub const PS_FontInfoRec = PS_FontInfoRec_
pub const PS_FontInfo = *PS_FontInfoRec_
pub const T1_FontInfo = PS_FontInfoRec_

pub const PS_PrivateRec_ = struct {
    unique_id: FT_Int
    lenIV: FT_Int
    num_blue_values: FT_Byte
    num_other_blues: FT_Byte
    num_family_blues: FT_Byte
    num_family_other_blues: FT_Byte
    blue_values: [14]FT_Short
    other_blues: [10]FT_Short
    family_blues: [14]FT_Short
    family_other_blues: [10]FT_Short
    blue_scale: FT_Fixed
    blue_shift: FT_Int
    blue_fuzz: FT_Int
    standard_width: [1]FT_UShort
    standard_height: [1]FT_UShort
    num_snap_widths: FT_Byte
    num_snap_heights: FT_Byte
    force_bold: FT_Bool
    round_stem_up: FT_Bool
    snap_widths: [13]FT_Short
    snap_heights: [13]FT_Short
    expansion_factor: FT_Fixed
    language_group: FT_Long
    password: FT_Long
    min_feature: [2]FT_Short
}
pub const PS_PrivateRec = PS_PrivateRec_
pub const PS_Private = *PS_PrivateRec_
pub const T1_Private = PS_PrivateRec_

pub const T1_Blend_Flags_ = enum(c_int) {
    T1_BLEND_UNDERLINE_POSITION = 0,
    T1_BLEND_UNDERLINE_THICKNESS = 1,
    T1_BLEND_ITALIC_ANGLE = 2,
    T1_BLEND_BLUE_VALUES = 3,
    T1_BLEND_OTHER_BLUES = 4,
    T1_BLEND_STANDARD_WIDTH = 5,
    T1_BLEND_STANDARD_HEIGHT = 6,
    T1_BLEND_STEM_SNAP_WIDTHS = 7,
    T1_BLEND_STEM_SNAP_HEIGHTS = 8,
    T1_BLEND_BLUE_SCALE = 9,
    T1_BLEND_BLUE_SHIFT = 10,
    T1_BLEND_FAMILY_BLUES = 11,
    T1_BLEND_FAMILY_OTHER_BLUES = 12,
    T1_BLEND_FORCE_BOLD = 13,
    T1_BLEND_MAX = 14,
}
pub const T1_Blend_Flags = T1_Blend_Flags_

pub const T1_MAX_MM_DESIGNS: c_int = 16
pub const T1_MAX_MM_AXIS: c_int = 4
pub const T1_MAX_MM_MAP_POINTS: c_int = 20

pub const PS_DesignMap_ = struct {
    num_points: FT_Byte
    design_points: *FT_Long
    blend_points: *FT_Fixed
}
pub const PS_DesignMapRec = PS_DesignMap_
pub const PS_DesignMap = *PS_DesignMap_
pub const T1_DesignMap = PS_DesignMap_

pub const PS_BlendRec_ = struct {
    num_designs: FT_UInt
    num_axis: FT_UInt
    axis_names: [4]*FT_String
    design_pos: [16]*FT_Fixed
    design_map: [4]PS_DesignMapRec
    weight_vector: *FT_Fixed
    default_weight_vector: *FT_Fixed
    font_infos: [17]PS_FontInfo
    privates: [17]PS_Private
    blend_bitflags: FT_ULong
    bboxes: [17]*ftimage.FT_BBox
    default_design_vector: [16]FT_UInt
    num_default_design_vector: FT_UInt
}
pub const PS_BlendRec = PS_BlendRec_
pub const PS_Blend = *PS_BlendRec_
pub const T1_Blend = PS_BlendRec_

pub const CID_FaceDictRec_ = struct {
    private_dict: PS_PrivateRec
    len_buildchar: FT_UInt
    forcebold_threshold: FT_Fixed
    stroke_width: ftimage.FT_Pos
    expansion_factor: FT_Fixed
    paint_type: FT_Byte
    font_type: FT_Byte
    font_matrix: fttypes.FT_Matrix
    font_offset: ftimage.FT_Vector
    num_subrs: FT_UInt
    subrmap_offset: FT_ULong
    sd_bytes: FT_UInt
}
pub const CID_FaceDictRec = CID_FaceDictRec_
pub const CID_FaceDict = *CID_FaceDictRec_
pub const CID_FontDict = CID_FaceDictRec_

pub const CID_FaceInfoRec_ = struct {
    cid_font_name: *FT_String
    cid_version: FT_Fixed
    cid_font_type: FT_Int
    registry: *FT_String
    ordering: *FT_String
    supplement: FT_Int
    font_info: PS_FontInfoRec
    font_bbox: ftimage.FT_BBox
    uid_base: FT_ULong
    num_xuid: FT_Int
    xuid: [16]FT_ULong
    cidmap_offset: FT_ULong
    fd_bytes: FT_UInt
    gd_bytes: FT_UInt
    cid_count: FT_ULong
    num_dicts: FT_UInt
    font_dicts: CID_FaceDict
    data_offset: FT_ULong
}
pub const CID_FaceInfoRec = CID_FaceInfoRec_
pub const CID_FaceInfo = *CID_FaceInfoRec_
pub const CID_Info = CID_FaceInfoRec_

// Whether the face's glyph names are reliable (a CFF font's are).
pub extern("c") fn FT_Has_PS_Glyph_Names(face: FT_Face) -> FT_Int
pub extern("c") fn FT_Get_PS_Font_Info(face: FT_Face, afont_info: PS_FontInfo) -> fttypes.FT_Error
pub extern("c") fn FT_Get_PS_Font_Private(face: FT_Face, afont_private: PS_Private) -> fttypes.FT_Error

pub const T1_EncodingType_ = enum(c_int) {
    T1_ENCODING_TYPE_NONE = 0,
    T1_ENCODING_TYPE_ARRAY = 1,
    T1_ENCODING_TYPE_STANDARD = 2,
    T1_ENCODING_TYPE_ISOLATIN1 = 3,
    T1_ENCODING_TYPE_EXPERT = 4,
}
pub const T1_EncodingType = T1_EncodingType_

pub const PS_Dict_Keys_ = enum(c_int) {
    PS_DICT_FONT_TYPE = 0,
    PS_DICT_FONT_MATRIX = 1,
    PS_DICT_FONT_BBOX = 2,
    PS_DICT_PAINT_TYPE = 3,
    PS_DICT_FONT_NAME = 4,
    PS_DICT_UNIQUE_ID = 5,
    PS_DICT_NUM_CHAR_STRINGS = 6,
    PS_DICT_CHAR_STRING_KEY = 7,
    PS_DICT_CHAR_STRING = 8,
    PS_DICT_ENCODING_TYPE = 9,
    PS_DICT_ENCODING_ENTRY = 10,
    PS_DICT_NUM_SUBRS = 11,
    PS_DICT_SUBR = 12,
    PS_DICT_STD_HW = 13,
    PS_DICT_STD_VW = 14,
    PS_DICT_NUM_BLUE_VALUES = 15,
    PS_DICT_BLUE_VALUE = 16,
    PS_DICT_BLUE_FUZZ = 17,
    PS_DICT_NUM_OTHER_BLUES = 18,
    PS_DICT_OTHER_BLUE = 19,
    PS_DICT_NUM_FAMILY_BLUES = 20,
    PS_DICT_FAMILY_BLUE = 21,
    PS_DICT_NUM_FAMILY_OTHER_BLUES = 22,
    PS_DICT_FAMILY_OTHER_BLUE = 23,
    PS_DICT_BLUE_SCALE = 24,
    PS_DICT_BLUE_SHIFT = 25,
    PS_DICT_NUM_STEM_SNAP_H = 26,
    PS_DICT_STEM_SNAP_H = 27,
    PS_DICT_NUM_STEM_SNAP_V = 28,
    PS_DICT_STEM_SNAP_V = 29,
    PS_DICT_FORCE_BOLD = 30,
    PS_DICT_RND_STEM_UP = 31,
    PS_DICT_MIN_FEATURE = 32,
    PS_DICT_LEN_IV = 33,
    PS_DICT_PASSWORD = 34,
    PS_DICT_LANGUAGE_GROUP = 35,
    PS_DICT_VERSION = 36,
    PS_DICT_NOTICE = 37,
    PS_DICT_FULL_NAME = 38,
    PS_DICT_FAMILY_NAME = 39,
    PS_DICT_WEIGHT = 40,
    PS_DICT_IS_FIXED_PITCH = 41,
    PS_DICT_UNDERLINE_POSITION = 42,
    PS_DICT_UNDERLINE_THICKNESS = 43,
    PS_DICT_FS_TYPE = 44,
    PS_DICT_ITALIC_ANGLE = 45,
    PS_DICT_MAX = 45,
}
pub const PS_Dict_Keys = PS_Dict_Keys_

// A value of a Type 1 font's dictionaries; -1 for the fonts of this
// library, which have none (FreeType's answer for any but Type 1).
pub extern("c") fn FT_Get_PS_Font_Value(face: FT_Face, key: PS_Dict_Keys, idx: FT_UInt, value: *anyopaque, value_len: FT_Long) -> FT_Long
