// libmlxfreetype.so: FreeType's C API (2.13) for C and C++ programs,
// over std.truetype, the font engine of the standard library (declared
// by the modules of api/, whose C headers mlx-cheaders makes), first what
// WebKit's Skia and WebCore ask of it.
//
//     ./mlx build freetype
//
// The parts: records.mlx (FreeType's records of faces, sizes, slots and
// charmaps), library.mlx (FT_Library, its modules and properties),
// faces.mlx (opening faces, their records over the engine's, sizes),
// glyphs.mlx (loading and rendering glyphs, advances, kerning),
// outlines.mlx (ftoutln.h, ftbbox.h, FT_Outline_Render), bitmap.mlx
// (ftbitmap.h, ftsynth.h), glyph.mlx (ftglyph.h), calc.mlx (fixed-point
// arithmetic, trigonometry), variations.mlx (ftmm.h), color.mlx
// (ftcolor.h), api.mlx (the rest: charmaps, SFNT tables and names,
// glyph and PostScript names, CID).
const library = @import("./library.mlx")
const faces = @import("./faces.mlx")
const glyphs = @import("./glyphs.mlx")
const outlines = @import("./outlines.mlx")
const bitmap = @import("./bitmap.mlx")
const glyph = @import("./glyph.mlx")
const calc = @import("./calc.mlx")
const variations = @import("./variations.mlx")
const color = @import("./color.mlx")
const api = @import("./api.mlx")
