// libmlxfreetype.so: FreeType's C API (2.13) for C and C++ programs, in
// Mlx (declared by the modules of api/, whose C headers mlx-cheaders
// makes), first what WebKit's Skia and WebCore ask of it.
//
//     ./mlx build freetype
//
// The parts: memory.mlx (memory by address, a library's allocator),
// calc.mlx (fixed-point arithmetic, trigonometry, matrices), library.mlx
// (FT_Library, its modules and properties), records.mlx and objects.mlx
// (the public records and the library's own), face.mlx (opening faces,
// sizes), sfnt.mlx (the SFNT container and its tables), cmap.mlx
// (charmaps), psnames.mlx (Unicode charmaps of glyph names),
// truetype.mlx (TrueType outlines), cff.mlx (CFF and CFF2 outlines),
// variations.mlx (variable fonts), sbit.mlx (embedded bitmaps),
// color.mlx (`COLR` and `CPAL`), load.mlx (FT_Load_Glyph,
// advances, kerning), outlines.mlx (outline functions), render.mlx (the
// anti-aliasing rasterizer and the renderers), raster.mlx (the monochrome
// rasterizer), api.mlx (the rest of the API).
const calc = @import("std.truetype.calc")
const library = @import("std.truetype.library")
const face = @import("std.truetype.face")
const load = @import("std.truetype.load")
const outlines = @import("std.truetype.outlines")
const render = @import("std.truetype.render")
const api = @import("./api.mlx")
const bitmap = @import("std.truetype.bitmap")
const glyph = @import("./glyph.mlx")
