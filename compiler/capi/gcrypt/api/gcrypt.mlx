pub const gcry_md_algos = enum(c_int) {
    GCRY_MD_NONE = 0,
    GCRY_MD_SHA1 = 2,
    GCRY_MD_SHA256 = 8,
    GCRY_MD_SHA384 = 9,
    GCRY_MD_SHA512 = 10,
    GCRY_MD_SHA224 = 11,
}

pub const gcry_md_flags = enum(c_int) {
    GCRY_MD_FLAG_SECURE = 1,
    GCRY_MD_FLAG_HMAC = 2,
    GCRY_MD_FLAG_BUGEMU1 = 256,
}

pub extern("c") fn gcry_md_open(h: *?gcry_md_hd_t, algo: c_int, flags: c_uint) -> gcry_error_t
pub extern("c") fn gcry_md_close(hd: ?gcry_md_hd_t) -> void
pub extern("c") fn gcry_md_enable(hd: gcry_md_hd_t, algo: c_int) -> gcry_error_t
pub extern("c") fn gcry_md_copy(bhd: *?gcry_md_hd_t, ahd: gcry_md_hd_t) -> gcry_error_t
pub extern("c") fn gcry_md_reset(hd: gcry_md_hd_t) -> void
pub extern("c") fn gcry_md_ctl(hd: gcry_md_hd_t, cmd: c_int, buffer: ?*anyopaque, buflen: c_size) -> gcry_error_t
pub extern("c") fn gcry_md_write(hd: gcry_md_hd_t, buffer: *const anyopaque, length: c_size) -> void
pub extern("c") fn gcry_md_read(hd: gcry_md_hd_t, algo: c_int) -> ?[*]c_uchar
pub extern("c") fn gcry_md_setkey(hd: gcry_md_hd_t, key: *const anyopaque, keylen: c_size) -> gcry_error_t
pub extern("c") fn gcry_md_hash_buffer(algo: c_int, digest: *anyopaque, buffer: *const anyopaque, length: c_size) -> void
pub extern("c") fn gcry_md_get_algo_dlen(algo: c_int) -> c_uint
pub extern("c") fn gcry_md_map_name(name: [*]const c_char) -> c_int
pub extern("c") fn gcry_md_algo_name(algo: c_int) -> [*]const c_char

pub inline fn gcry_md_final(a: gcry_md_hd_t) -> gcry_error_t { return gcry_md_ctl(a, 5, null, 0) }

// ---------------------------------------------------------------------------
// MACs.

pub const gcry_mac_handle = struct {}
pub const gcry_mac_hd_t = *gcry_mac_handle

pub const gcry_mac_algos = enum(c_int) {
    GCRY_MAC_NONE = 0,
    GCRY_MAC_HMAC_SHA256 = 101,
    GCRY_MAC_HMAC_SHA224 = 102,
    GCRY_MAC_HMAC_SHA512 = 103,
    GCRY_MAC_HMAC_SHA384 = 104,
    GCRY_MAC_HMAC_SHA1 = 105,
}

pub extern("c") fn gcry_mac_open(handle: *?gcry_mac_hd_t, algo: c_int, flags: c_uint, ctx: ?gcry_ctx_t) -> gcry_error_t
pub extern("c") fn gcry_mac_close(h: ?gcry_mac_hd_t) -> void
pub extern("c") fn gcry_mac_ctl(h: gcry_mac_hd_t, cmd: c_int, buffer: ?*anyopaque, buflen: c_size) -> gcry_error_t
pub extern("c") fn gcry_mac_setkey(hd: gcry_mac_hd_t, key: *const anyopaque, keylen: c_size) -> gcry_error_t
pub extern("c") fn gcry_mac_write(hd: gcry_mac_hd_t, buffer: *const anyopaque, length: c_size) -> gcry_error_t
pub extern("c") fn gcry_mac_read(hd: gcry_mac_hd_t, buffer: *anyopaque, buflen: *c_size) -> gcry_error_t
pub extern("c") fn gcry_mac_verify(hd: gcry_mac_hd_t, buffer: *const anyopaque, buflen: c_size) -> gcry_error_t
pub extern("c") fn gcry_mac_get_algo_maclen(algo: c_int) -> c_uint
pub extern("c") fn gcry_mac_get_algo_keylen(algo: c_int) -> c_uint

pub inline fn gcry_mac_reset(h: gcry_mac_hd_t) -> gcry_error_t { return gcry_mac_ctl(h, 4, null, 0) }

// ---------------------------------------------------------------------------
// Key derivation.

pub const gcry_kdf_algos = enum(c_int) {
    GCRY_KDF_NONE = 0,
    GCRY_KDF_SIMPLE_S2K = 16,
    GCRY_KDF_SALTED_S2K = 17,
    GCRY_KDF_ITERSALTED_S2K = 19,
    GCRY_KDF_PBKDF1 = 33,
    GCRY_KDF_PBKDF2 = 34,
    GCRY_KDF_SCRYPT = 48,
}

pub extern("c") fn gcry_kdf_derive(passphrase: *const anyopaque, passphraselen: c_size, algo: c_int, subalgo: c_int, salt: ?*const anyopaque, saltlen: c_size, iterations: c_ulong, keysize: c_size, keybuffer: *anyopaque) -> gpg_error_t

// ---------------------------------------------------------------------------
// Public keys.

pub const gcry_pk_algos = enum(c_int) {
    GCRY_PK_RSA = 1,
    GCRY_PK_RSA_E = 2,
    GCRY_PK_RSA_S = 3,
    GCRY_PK_ELG_E = 16,
    GCRY_PK_DSA = 17,
    GCRY_PK_ECC = 18,
    GCRY_PK_ELG = 20,
    GCRY_PK_ECDSA = 301,
    GCRY_PK_ECDH = 302,
    GCRY_PK_EDDSA = 303,
}

pub extern("c") fn gcry_pk_encrypt(result: *?gcry_sexp_t, data: gcry_sexp_t, pkey: gcry_sexp_t) -> gcry_error_t
pub extern("c") fn gcry_pk_decrypt(result: *?gcry_sexp_t, data: gcry_sexp_t, skey: gcry_sexp_t) -> gcry_error_t
pub extern("c") fn gcry_pk_sign(result: *?gcry_sexp_t, data: gcry_sexp_t, skey: gcry_sexp_t) -> gcry_error_t
pub extern("c") fn gcry_pk_verify(sigval: gcry_sexp_t, data: gcry_sexp_t, pkey: gcry_sexp_t) -> gcry_error_t
pub extern("c") fn gcry_pk_testkey(key: gcry_sexp_t) -> gcry_error_t
pub extern("c") fn gcry_pk_genkey(r_key: *?gcry_sexp_t, s_parms: gcry_sexp_t) -> gcry_error_t
pub extern("c") fn gcry_pk_get_nbits(key: gcry_sexp_t) -> c_uint

