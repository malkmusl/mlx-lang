// Random numbers and memory.


pub extern("c") fn gcry_randomize(buffer: *anyopaque, length: c_size, level: gcry_random_level) -> void
pub extern("c") fn gcry_random_bytes(nbytes: c_size, level: gcry_random_level) -> ?*anyopaque
pub extern("c") fn gcry_create_nonce(buffer: *anyopaque, length: c_size) -> void

pub extern("c") fn gcry_malloc(n: c_size) -> ?*anyopaque
pub extern("c") fn gcry_calloc(n: c_size, m: c_size) -> ?*anyopaque
pub extern("c") fn gcry_free(a: ?*anyopaque) -> void
