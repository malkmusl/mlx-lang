// gcrypt.h
// mlx-gcrypt: libgcrypt's C API (1.10), the part WebKit's WebCrypto
// (WebCore/crypto/gcrypt, PAL's digests) calls, implemented in Mlx by
// libmlxgcrypt.so (compiler/capi/gcrypt) over std.crypto: message
// digests and HMAC (SHA-1, SHA-2), PBKDF2, AES in ECB, CBC, CTR, GCM and
// key wrap modes, multi-precision integers, S-expressions, the curves
// NIST P-256, P-384, P-521, Curve25519 and Ed25519 as contexts and
// points, and public keys: RSA (PKCS #1 v1.5 and PSS signatures, OAEP,
// key generation), ECDSA, ECDH and EdDSA.
const c_function_pointers = true
const c_system_headers = "stdio.h stdlib.h stdarg.h string.h sys/types.h sys/time.h"
const gpgerror = @import("./gpgerror.mlx")
const c_macros = "#define GCRYMPI_CONST_ONE (_gcry_mpi_get_const (1))\n#define GCRYMPI_CONST_TWO (_gcry_mpi_get_const (2))\n#define GCRYMPI_CONST_THREE (_gcry_mpi_get_const (3))\n#define GCRYMPI_CONST_FOUR (_gcry_mpi_get_const (4))\n#define GCRYMPI_CONST_EIGHT (_gcry_mpi_get_const (8))"

pub const c_char = u8
pub const c_uchar = u8
pub const c_int = i32
pub const c_uint = u32
pub const c_ulong = u64
pub const c_size = usize
pub const c_varargs = usize
pub const c_tokens = usize

const gpg_error_t = gpgerror.gpg_error_t
const gpg_err_code_t = gpgerror.gpg_err_code_t
const gpg_err_source_t = gpgerror.gpg_err_source_t

pub const GCRYPT_VERSION: []const u8 = "1.10.3"
pub const GCRYPT_VERSION_NUMBER: c_int = 0x010a03

pub const gcry_error_t = gpg_error_t
pub const gcry_err_code_t = gpg_err_code_t
pub const gcry_err_source_t = gpg_err_source_t

// Errors an application makes itself have this source.
pub const GCRY_ERR_SOURCE_DEFAULT: gpg_err_source_t = 32

pub inline fn gcry_err_make(source: gcry_err_source_t, code: gcry_err_code_t) -> gcry_error_t { return gpgerror.gpg_err_make(source, code) }
pub inline fn gcry_error(code: gcry_err_code_t) -> gcry_error_t { return gpgerror.gpg_err_make(GCRY_ERR_SOURCE_DEFAULT, code) }
pub inline fn gcry_err_code(err: gcry_error_t) -> gcry_err_code_t { return gpgerror.gpg_err_code(err) }
pub inline fn gcry_err_source(err: gcry_error_t) -> gcry_err_source_t { return gpgerror.gpg_err_source(err) }

pub extern("c") fn gcry_strerror(err: gcry_error_t) -> [*]const c_char
pub extern("c") fn gcry_strsource(err: gcry_error_t) -> [*]const c_char

// gcry_control's commands (those that do something are noted; the rest
// are accepted and do nothing: there is no secure memory to set up).
