// ---------------------------------------------------------------------------
// Symmetric ciphers.

pub const gcry_cipher_handle = struct {}
pub const gcry_cipher_hd_t = *gcry_cipher_handle

pub const gcry_cipher_algos = enum(c_int) {
    GCRY_CIPHER_NONE = 0,
    GCRY_CIPHER_AES = 7,
    GCRY_CIPHER_AES192 = 8,
    GCRY_CIPHER_AES256 = 9,
}
pub const GCRY_CIPHER_AES128: c_int = 7
pub const GCRY_CIPHER_RIJNDAEL: c_int = 7
pub const GCRY_CIPHER_RIJNDAEL128: c_int = 7
pub const GCRY_CIPHER_RIJNDAEL192: c_int = 8
pub const GCRY_CIPHER_RIJNDAEL256: c_int = 9

pub const gcry_cipher_modes = enum(c_int) {
    GCRY_CIPHER_MODE_NONE = 0,
    GCRY_CIPHER_MODE_ECB = 1,
    GCRY_CIPHER_MODE_CFB = 2,
    GCRY_CIPHER_MODE_CBC = 3,
    GCRY_CIPHER_MODE_STREAM = 4,
    GCRY_CIPHER_MODE_OFB = 5,
    GCRY_CIPHER_MODE_CTR = 6,
    GCRY_CIPHER_MODE_AESWRAP = 7,
    GCRY_CIPHER_MODE_CCM = 8,
    GCRY_CIPHER_MODE_GCM = 9,
}

pub const gcry_cipher_flags = enum(c_int) {
    GCRY_CIPHER_SECURE = 1,
    GCRY_CIPHER_ENABLE_SYNC = 2,
    GCRY_CIPHER_CBC_CTS = 4,
    GCRY_CIPHER_CBC_MAC = 8,
}

pub const GCRY_GCM_BLOCK_LEN: c_int = 16

pub extern("c") fn gcry_cipher_open(handle: *?gcry_cipher_hd_t, algo: c_int, mode: c_int, flags: c_uint) -> gcry_error_t
pub extern("c") fn gcry_cipher_close(h: ?gcry_cipher_hd_t) -> void
pub extern("c") fn gcry_cipher_ctl(h: gcry_cipher_hd_t, cmd: c_int, buffer: ?*anyopaque, buflen: c_size) -> gcry_error_t
pub extern("c") fn gcry_cipher_encrypt(h: gcry_cipher_hd_t, out: *anyopaque, outsize: c_size, in_: ?*const anyopaque, inlen: c_size) -> gcry_error_t
pub extern("c") fn gcry_cipher_decrypt(h: gcry_cipher_hd_t, out: *anyopaque, outsize: c_size, in_: ?*const anyopaque, inlen: c_size) -> gcry_error_t
pub extern("c") fn gcry_cipher_setkey(hd: gcry_cipher_hd_t, key: *const anyopaque, keylen: c_size) -> gcry_error_t
pub extern("c") fn gcry_cipher_setiv(hd: gcry_cipher_hd_t, iv: ?*const anyopaque, ivlen: c_size) -> gcry_error_t
pub extern("c") fn gcry_cipher_setctr(hd: gcry_cipher_hd_t, ctr: ?*const anyopaque, ctrlen: c_size) -> gpg_error_t
pub extern("c") fn gcry_cipher_authenticate(hd: gcry_cipher_hd_t, abuf: *const anyopaque, abuflen: c_size) -> gcry_error_t
pub extern("c") fn gcry_cipher_gettag(hd: gcry_cipher_hd_t, outtag: *anyopaque, taglen: c_size) -> gcry_error_t
pub extern("c") fn gcry_cipher_checktag(hd: gcry_cipher_hd_t, intag: *const anyopaque, taglen: c_size) -> gcry_error_t
pub extern("c") fn gcry_cipher_get_algo_keylen(algo: c_int) -> c_size
pub extern("c") fn gcry_cipher_get_algo_blklen(algo: c_int) -> c_size

pub inline fn gcry_cipher_reset(h: gcry_cipher_hd_t) -> gcry_error_t { return gcry_cipher_ctl(h, 4, null, 0) }
pub inline fn gcry_cipher_final(a: gcry_cipher_hd_t) -> gcry_error_t { return gcry_cipher_ctl(a, 5, null, 0) }

