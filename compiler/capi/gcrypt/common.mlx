// What every part of mlx-gcrypt uses: C's memory (what the library hands
// out, C frees with gcry_free or free), the error values (libgcrypt's
// source and the codes of libgpg-error, with their texts), the version
// and gcry_control, random numbers (the kernel's), and C's variable
// arguments (gcry_sexp_build's and gcry_sexp_extract_param's).
const std = @import("std")
const random = @import("std.random")

extern("c") fn malloc(size: usize) -> usize
extern("c") fn calloc(count: usize, size: usize) -> usize
extern("c") fn realloc(address: usize, size: usize) -> usize
extern("c") fn free(address: usize) -> void

// ---------------------------------------------------------------------------
// Memory.

// `size` zeroed bytes (0 when there is no memory).
pub fn alloc(size: usize) -> usize { return calloc(1, if size == 0 { 1 } else { size }) }

pub fn grow(address: usize, size: usize) -> usize { return realloc(address, if size == 0 { 1 } else { size }) }

pub fn release(address: usize) -> void {
    if address != 0 { free(address) }
}

// Zeroed and released: memory that held a key.
pub fn wipeRelease(address: usize, size: usize) -> void {
    if address == 0 { return }
    zero(address, size)
    free(address)
}

pub fn bytes(address: usize) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, address) }
}

pub fn slice(address: usize, length: usize) -> []const u8 {
    unsafe { return @ptrFromInt([*]const u8, address)[0..length] }
}

pub fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
pub fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }
pub fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }
pub fn put32(address: usize, value: u32) -> void { unsafe { @ptrFromInt(*u32, address).* = value } }
pub fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }
pub fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub fn put64(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u64, address).* = value } }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if count == 0 { return }
    std.mem.copy(bytes(target), bytes(source), count)
}

pub fn zero(target: usize, count: usize) -> void {
    var index: usize = 0
    while index < count {
        put8(target + index, 0)
        index += 1
    }
}

pub fn cLength(text: usize) -> usize {
    var length: usize = 0
    while get8(text + length) != 0 { length += 1 }
    return length
}

pub fn cSlice(text: usize) -> []const u8 { return slice(text, cLength(text)) }

pub fn same(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var index: usize = 0
    while index < a.length {
        if a[index] != b[index] { return false }
        index += 1
    }
    return true
}

// A copy of `length` bytes from C's allocator.
pub fn dupBytes(address: usize, length: usize) -> usize {
    const copied = alloc(length + 1)
    if copied != 0 { copy(copied, address, length) }
    return copied
}

export fn gcry_malloc(n: usize) -> usize { return malloc(if n == 0 { 1 } else { n }) }
export fn gcry_calloc(n: usize, size: usize) -> usize { return calloc(n, size) }
export fn gcry_free(a: usize) -> void { release(a) }

// ---------------------------------------------------------------------------
