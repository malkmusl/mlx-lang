// The error value of the library for `code`.
pub fn failure(code: u32) -> u32 {
    if code == 0 { return 0 }
    return 16777216 | (code & 65535)
}

// libgpg-error's texts of the codes the library returns.
fn codeText(code: u32) -> []const u8 {
    return match code {
        0 => "Success",
        1 => "General error",
        4 => "Invalid public key algorithm",
        5 => "Invalid digest algorithm",
        6 => "Bad public key",
        7 => "Bad secret key",
        8 => "Bad signature",
        9 => "No public key",
        10 => "Checksum error",
        12 => "Invalid cipher algorithm",
        17 => "No secret key",
        27 => "Not found",
        29 => "Syntax error",
        30 => "Bad MPI value",
        41 => "Wrong public key algorithm",
        43 => "Weak encryption key",
        44 => "Invalid key length",
        45 => "Invalid argument",
        55 => "Invalid value",
        58 => "No data",
        60 => "Not supported",
        61 => "Invalid operation code",
        63 => "Internal error",
        65 => "Invalid object",
        66 => "Provided object is too short",
        67 => "Provided object is too large",
        68 => "Missing item in object",
        69 => "Not implemented",
        70 => "Conflicting use",
        71 => "Invalid cipher mode",
        72 => "Invalid flag",
        73 => "Invalid handle",
        79 => "Invalid data",
        83 => "Invalid S-expression",
        89 => "Bad data",
        90 => "Invalid parameter",
        104 => "Unknown S-expression",
        125 => "Wrong key usage",
        128 => "Missing value",
        139 => "Invalid length",
        147 => "Unsupported encoding",
        149 => "Unknown algorithm",
        152 => "Decryption failed",
        155 => "Encoding problem",
        156 => "Invalid state",
        165 => "Unknown name",
        181 => "Missing key",
        183 => "Limit reached",
        187 => "Invalid elliptic curve",
        188 => "Unknown elliptic curve",
        191 => "No crypto context",
        195 => "Broken public key",
        196 => "Broken secret key",
        197 => "Invalid MAC algorithm",
        200 => "Buffer too short",
        201 => "Invalid length specifier in S-expression",
        202 => "String too long in S-expression",
        203 => "Unmatched parentheses in S-expression",
        204 => "S-expression not canonical",
        205 => "Bad character in S-expression",
        206 => "Bad quotation in S-expression",
        207 => "Zero prefix in S-expression",
        208 => "Nested display hints in S-expression",
        209 => "Unmatched display hints",
        210 => "Unexpected reserved punctuation in S-expression",
        211 => "Bad hexadecimal character in S-expression",
        212 => "Odd hexadecimal numbers in S-expression",
        213 => "Bad octal character in S-expression",
        309 => "Unknown flag",
        16383 => "End of file",
        32854 => "Cannot allocate memory",
        32885 => "Numerical result out of range",
        else => "Unknown error code",
    }
}

fn sourceText(source: u32) -> []const u8 {
    return match source {
        0 => "Unspecified source",
        1 => "gcrypt",
        32 => "User defined source 1",
        else => "Unknown source",
    }
}

export fn gcry_strerror(err: u32) -> usize { return @intFromPtr(codeText(err & 65535).pointer) }
export fn gcry_strsource(err: u32) -> usize { return @intFromPtr(sourceText((err >> 24) & 127).pointer) }
export fn gpg_strerror(err: u32) -> usize { return gcry_strerror(err) }
export fn gpg_strsource(err: u32) -> usize { return gcry_strsource(err) }

// ---------------------------------------------------------------------------
// The version and gcry_control.

const VERSION = "1.10.3\x00"

// A version "a.b.c" as a number, (a << 16) | (b << 8) | c.
fn versionNumber(text: usize) -> u64 {
    var parts: [3]u64 = [3]u64{ 0, 0, 0 }
    var part: usize = 0
    var at = text
    while get8(at) != 0 && part < 3 {
        const byte = get8(at)
        if byte == 46 {
            part += 1
        } else if byte >= 48 && byte <= 57 {
            parts[part] = parts[part] * 10 + @intCast(u64, byte - 48)
        } else {
            break
        }
        at += 1
    }
    return (parts[0] << 16) | (parts[1] << 8) | parts[2]
}

// The library's version when it is at least `required` (or nothing is
// required), else NULL.
export fn gcry_check_version(required: usize) -> usize {
    const own = @intFromPtr(VERSION.pointer)
    if required == 0 { return own }
    if versionNumber(required) > versionNumber(own) { return 0 }
    return own
}

var initialized: u32 = 0

// The commands that say something answer; the others (secure memory,
// threads, debugging) have nothing to do here and succeed.
export fn gcry_control(cmd: i32, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> u32 {
    if cmd == 38 { initialized = 1 }
    if cmd == 39 { return initialized }
    if cmd == 40 { return 1 }
    if cmd == 54 { return 1 }
    if cmd == 55 { return 0 }
    return 0
}

// ---------------------------------------------------------------------------
// Random numbers: the kernel's (getrandom) at every level.

pub fn fill(address: usize, length: usize) -> void {
    if length == 0 { return }
    const ok = random.fill(bytes(address), length)
}

export fn gcry_randomize(buffer: usize, length: usize, level: i32) -> void { fill(buffer, length) }
export fn gcry_create_nonce(buffer: usize, length: usize) -> void { fill(buffer, length) }

export fn gcry_random_bytes(count: usize, level: i32) -> usize {
    const buffer = malloc(if count == 0 { 1 } else { count })
    if buffer != 0 { fill(buffer, count) }
    return buffer
}

// ---------------------------------------------------------------------------
// C's variable arguments. A variadic export takes the six integer
// registers and the eight vector registers as its parameters (its fixed
// parameters first) and makes them, with the caller's stack words above
// its frame, a System V va_list: the gp_offset and fp_offset words, the
// overflow area, the register save area.

pub const CallList = struct {
    header: [4]u64
    save: [22]u64
}

pub fn varStart(call: *CallList, fixed: usize, frame: usize, words: usize, doubles: usize) -> usize {
    const save = @intFromPtr(&call.*.save)
    copy(save, words, 48)
    var index: usize = 0
    while index < 8 {
        put64(save + 48 + index * 16, get64(doubles + index * 8))
        put64(save + 56 + index * 16, 0)
        index += 1
    }
    const header = @intFromPtr(&call.*.header)
    put32(header, @intCast(u32, fixed * 8))
    put32(header + 4, 48)
    putWord(header + 8, frame + 16)
    putWord(header + 16, save)
    return header
}

// The next integer-class argument (an integer or a pointer).
pub fn nextWord(list: usize) -> u64 {
    const offset = get32(list)
    if offset < 48 {
        put32(list, offset + 8)
        return get64(getWord(list + 16) + @intCast(usize, offset))
    }
    const overflow = getWord(list + 8)
    putWord(list + 8, overflow + 8)
    return get64(overflow)
}

pub fn nextPointer(list: usize) -> usize { return @intCast(usize, nextWord(list)) }
pub fn nextInt(list: usize) -> i32 { return @bitCast(i32, @intCast(u32, nextWord(list) & 4294967295)) }
