// The memory allocator of sqlite3_config(SQLITE_CONFIG_MALLOC): taken and
// not used (the library's memory is the C library's malloc).
pub const sqlite3_mem_methods = struct {
    xMalloc: ?fn(c_int) -> ?*anyopaque
    xFree: ?fn(?*anyopaque) -> void
    xRealloc: ?fn(?*anyopaque, c_int) -> ?*anyopaque
    xSize: ?fn(?*anyopaque) -> c_int
    xRoundup: ?fn(c_int) -> c_int
    xInit: ?fn(?*anyopaque) -> c_int
    xShutdown: ?fn(?*anyopaque) -> void
    pAppData: ?*anyopaque
}

