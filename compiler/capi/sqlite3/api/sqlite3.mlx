// sqlite3.h
// mlx-sqlite3: SQLite's C API (3.45), implemented in Mlx by
// libmlxsqlite3.so (compiler/capi/sqlite3) over std.sql: connections,
// prepared statements with their parameters and result columns, the
// values and contexts of application-defined functions and collations,
// the authorizer, busy handlers, transactions, incremental blob I/O, and
// the utility functions (the printf family, memory, errors). Databases
// are SQLite's file format with its rollback journal and locks.
const c_function_pointers = true
const c_system_headers = "stdarg.h stddef.h"
const c_macros = "#define SQLITE_STATIC ((sqlite3_destructor_type)0)\n#define SQLITE_TRANSIENT ((sqlite3_destructor_type)-1)\n#define SQLITE_EXTERN extern\n#define SQLITE_API\n#define SQLITE_CDECL\n#define SQLITE_APICALL\n#define SQLITE_STDCALL\n#define SQLITE_CALLBACK\n#define SQLITE_SYSAPI\n#define SQLITE_DEPRECATED\n#define SQLITE_EXPERIMENTAL"

pub const c_char = u8
pub const c_uchar = u8
pub const c_int = i32
pub const c_uint = u32
pub const c_longlong = i64
pub const c_ulonglong = u64
pub const c_double = f64
pub const c_size = usize
pub const c_va_list = usize
pub const c_varargs = usize
pub const c_tokens = usize

pub const SQLITE_VERSION: []const u8 = "3.45.1"
pub const SQLITE_VERSION_NUMBER: c_int = 3045001
pub const SQLITE_SOURCE_ID: []const u8 = "2024-01-30 16:01:20 e876e51a0ed5c5b3126f52e532044363a014bc594cfefa87ffb5b82257ccalt1"

