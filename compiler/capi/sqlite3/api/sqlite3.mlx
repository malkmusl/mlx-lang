pub extern("c") fn sqlite3_compileoption_get(N: c_int) -> ?[*]const c_char
pub extern("c") fn sqlite3_threadsafe() -> c_int

// The handles C sees (their contents are the library's).
pub const sqlite3 = struct {}
pub const sqlite3_stmt = struct {}
pub const sqlite3_value = struct {}
pub const sqlite3_context = struct {}
pub const sqlite3_blob = struct {}
pub const sqlite3_file = struct {}
pub const sqlite3_vfs = struct {}

pub const sqlite_int64 = c_longlong
pub const sqlite_uint64 = c_ulonglong
pub const sqlite3_int64 = sqlite_int64
pub const sqlite3_uint64 = sqlite_uint64

pub extern("c") fn sqlite3_close(db: ?*sqlite3) -> c_int
pub extern("c") fn sqlite3_close_v2(db: ?*sqlite3) -> c_int

// sqlite3_exec's row callback: (argument, columns, values, names).
pub const sqlite3_callback = fn(arg: ?*anyopaque, columns: c_int, values: ?[*]?[*]c_char, names: ?[*]?[*]c_char) -> c_int

pub extern("c") fn sqlite3_exec(db: ?*sqlite3, sql: [*]const c_char, callback: ?sqlite3_callback, arg: ?*anyopaque, errmsg: ?*?[*]c_char) -> c_int

