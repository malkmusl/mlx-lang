// Application-defined functions: xFunc, xStep (context, arguments,
// values), xFinal (context).
pub const sqlite3_function = fn(context: ?*sqlite3_context, count: c_int, values: ?[*]?*sqlite3_value) -> void
pub const sqlite3_final = fn(context: ?*sqlite3_context) -> void
pub const sqlite3_destroy = fn(data: ?*anyopaque) -> void

