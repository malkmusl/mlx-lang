// libmlxsqlite3.so: SQLite's C API (3.45, declared by the module of api/,
// whose sqlite3.h mlx-cheaders makes), the part WebKit's databases
// (WebCore's SQLiteDatabase, SQLiteStatement and the stores over them)
// call and most of the rest, in Mlx over std.sql:
//
//     ./mlx build sqlite3
//
// The parts: common.mlx (memory, C strings, UTF-16, C's variable
// arguments), main.mlx (the library and connections: open, close,
// errors, exec, get_table, the busy handler, the authorizer, hooks,
// memory, utilities), statements.mlx (prepare, step, bind, column),
// values.mlx (values, function results, application functions and
// collations), blob.mlx (incremental blob I/O), printf.mlx (SQLite's
// printf).
const main = @import("./main.mlx")
const statements = @import("./statements.mlx")
const values = @import("./values.mlx")
const blob = @import("./blob.mlx")
const printf = @import("./printf.mlx")
