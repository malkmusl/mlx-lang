// libxml2's character encodings (encoding.h) over std.xml.encoding: the
// encodings the first bytes show, those of names, their aliases, and the
// handlers of each (xmlCharEncodingHandler: a name, and the decoder of
// std.xml.encoding after it, which the parser decodes with). libxml2's
// own handlers have their names (UTF-8, UTF-16LE, UTF-16BE, UTF-16,
// ISO-8859-1, ASCII, US-ASCII); those of the encodings libxml2 asks iconv
// for (UCS-4, the charsets of std.unicode.charmaps) the name asked for.
// A handler is made once per name and kept. Handlers a program makes
// (xmlNewCharEncodingHandler) are kept and found, but a parser does not
// decode through their functions.
const text = @import("std.xml.text")
const encoding = @import("std.xml.encoding")
const m = @import("./memory.mlx")
const layout = @import("./layout.mlx")

// A handler: libxml2's structure, then the next handler made and the
// std decoder.
const Block = struct {
    name: usize
    input: usize
    output: usize
    next: usize
    decoder: encoding.Handler
}

inline fn blockAt(address: usize) -> *Block { return unsafe { @ptrFromInt(*Block, address) } }

var handlers: usize = 0

fn upperEqual(a: usize, b: usize) -> bool {
    var index: usize = 0
    while true {
        var x = text.get8(a + index)
        var y = text.get8(b + index)
        if x >= 97 && x <= 122 { x -= 32 }
        if y >= 97 && y <= 122 { y -= 32 }
        if x != y { return false }
        if x == 0 { return true }
        index += 1
    }
    return true
}

fn upperCopy(s: usize) -> usize {
    const copy = m.dup(s)
    if copy == 0 { return 0 }
    var at = copy
    while text.get8(at) != 0 {
        const c = text.get8(at)
        if c >= 97 && c <= 122 { text.put8(at, c - 32) }
        at += 1
    }
    return copy
}

fn findMade(name: usize) -> usize {
    var at = handlers
    while at != 0 {
        if upperEqual(blockAt(at).*.name, name) { return at }
        at = blockAt(at).*.next
    }
    return 0
}

fn make(name: usize, decoder: encoding.Handler) -> usize {
    const block = m.zalloc(@sizeOf(Block))
    if block == 0 { return 0 }
    const b = blockAt(block)
    b.*.name = m.dup(name)
    b.*.decoder = decoder
    b.*.next = handlers
    handlers = block
    return block
}

// The std decoder of a handler of this module (none for another).
pub fn stdHandler(handler: usize) -> encoding.Handler {
    var at = handlers
    while at != 0 {
        if at == handler { return blockAt(at).*.decoder }
        at = blockAt(at).*.next
    }
    return encoding.handlerOf(encoding.KIND_NONE)
}

// ---------------------------------------------------------------------------
// Aliases

var aliases: usize = 0

const Alias = struct {
    name: usize
    alias: usize
    next: usize
}

inline fn aliasAt(address: usize) -> *Alias { return unsafe { @ptrFromInt(*Alias, address) } }

export fn xmlGetEncodingAlias(alias: usize) -> usize {
    if alias == 0 { return 0 }
    var at = aliases
    while at != 0 {
        if upperEqual(aliasAt(at).*.alias, alias) { return aliasAt(at).*.name }
        at = aliasAt(at).*.next
    }
    return 0
}

export fn xmlAddEncodingAlias(name: usize, alias: usize) -> i32 {
    if name == 0 || alias == 0 { return -1 }
    var at = aliases
    while at != 0 {
        if upperEqual(aliasAt(at).*.alias, alias) {
            m.xfree(aliasAt(at).*.name)
            aliasAt(at).*.name = m.dup(name)
            return 0
        }
        at = aliasAt(at).*.next
    }
    const block = m.zalloc(@sizeOf(Alias))
    if block == 0 { return -1 }
    aliasAt(block).*.name = m.dup(name)
    aliasAt(block).*.alias = upperCopy(alias)
    aliasAt(block).*.next = aliases
    aliases = block
    return 0
}

export fn xmlDelEncodingAlias(alias: usize) -> i32 {
    if alias == 0 { return -1 }
    var at = aliases
    var previous: usize = 0
    while at != 0 {
        if text.equal(aliasAt(at).*.alias, alias) {
            if previous == 0 { aliases = aliasAt(at).*.next } else { aliasAt(previous).*.next = aliasAt(at).*.next }
            m.xfree(aliasAt(at).*.name)
            m.xfree(aliasAt(at).*.alias)
            m.free(at)
            return 0
        }
        previous = at
        at = aliasAt(at).*.next
    }
    return -1
}

export fn xmlCleanupEncodingAliases() -> void {
    var at = aliases
    while at != 0 {
        const next = aliasAt(at).*.next
        m.xfree(aliasAt(at).*.name)
        m.xfree(aliasAt(at).*.alias)
        m.free(at)
        at = next
    }
    aliases = 0
}

// ---------------------------------------------------------------------------
// Encodings and their handlers

export fn xmlParseCharEncoding(nameIn: usize) -> i32 {
    if nameIn == 0 { return 0 }
    var name = nameIn
    const alias = xmlGetEncodingAlias(name)
    if alias != 0 { name = alias }
    if text.get8(name) == 0 { return 0 }
    if upperEqual(name, @intFromPtr("UTF-8".pointer)) || upperEqual(name, @intFromPtr("UTF8".pointer)) { return 1 }
    if upperEqual(name, @intFromPtr("UTF-16".pointer)) || upperEqual(name, @intFromPtr("UTF16".pointer)) { return 2 }
    if upperEqual(name, @intFromPtr("ISO-10646-UCS-2".pointer)) || upperEqual(name, @intFromPtr("UCS-2".pointer)) || upperEqual(name, @intFromPtr("UCS2".pointer)) { return 9 }
    if upperEqual(name, @intFromPtr("ISO-10646-UCS-4".pointer)) || upperEqual(name, @intFromPtr("UCS-4".pointer)) || upperEqual(name, @intFromPtr("UCS4".pointer)) { return 4 }
    if upperEqual(name, @intFromPtr("ISO-8859-1".pointer)) || upperEqual(name, @intFromPtr("ISO-LATIN-1".pointer)) || upperEqual(name, @intFromPtr("ISO LATIN 1".pointer)) { return 10 }
    if upperEqual(name, @intFromPtr("ISO-8859-2".pointer)) || upperEqual(name, @intFromPtr("ISO-LATIN-2".pointer)) || upperEqual(name, @intFromPtr("ISO LATIN 2".pointer)) { return 11 }
    if upperEqual(name, @intFromPtr("ISO-8859-3".pointer)) { return 12 }
    if upperEqual(name, @intFromPtr("ISO-8859-4".pointer)) { return 13 }
    if upperEqual(name, @intFromPtr("ISO-8859-5".pointer)) { return 14 }
    if upperEqual(name, @intFromPtr("ISO-8859-6".pointer)) { return 15 }
    if upperEqual(name, @intFromPtr("ISO-8859-7".pointer)) { return 16 }
    if upperEqual(name, @intFromPtr("ISO-8859-8".pointer)) { return 17 }
    if upperEqual(name, @intFromPtr("ISO-8859-9".pointer)) { return 18 }
    if upperEqual(name, @intFromPtr("ISO-2022-JP".pointer)) { return 19 }
    if upperEqual(name, @intFromPtr("SHIFT_JIS".pointer)) { return 20 }
    if upperEqual(name, @intFromPtr("EUC-JP".pointer)) { return 21 }
    return -1
}

export fn xmlGetCharEncodingName(enc: i32) -> usize {
    var name: []const u8 = ""
    if enc == 1 {
        name = "UTF-8"
    } else if enc == 2 || enc == 3 {
        name = "UTF-16"
    } else if enc == 6 {
        name = "EBCDIC"
    } else if enc == 4 || enc == 5 || enc == 7 || enc == 8 {
        name = "ISO-10646-UCS-4"
    } else if enc == 9 {
        name = "ISO-10646-UCS-2"
    } else if enc == 10 {
        name = "ISO-8859-1"
    } else if enc == 11 {
        name = "ISO-8859-2"
    } else if enc == 12 {
        name = "ISO-8859-3"
    } else if enc == 13 {
        name = "ISO-8859-4"
    } else if enc == 14 {
        name = "ISO-8859-5"
    } else if enc == 15 {
        name = "ISO-8859-6"
    } else if enc == 16 {
        name = "ISO-8859-7"
    } else if enc == 17 {
        name = "ISO-8859-8"
    } else if enc == 18 {
        name = "ISO-8859-9"
    } else if enc == 19 {
        name = "ISO-2022-JP"
    } else if enc == 20 {
        name = "Shift-JIS"
    } else if enc == 21 {
        name = "EUC-JP"
    } else {
        return 0
    }
    return @intFromPtr(name.pointer)
}

export fn xmlDetectCharEncoding(input: usize, len: i32) -> i32 {
    if input == 0 || len < 0 { return 0 }
    return @intCast(i32, encoding.detect(input, @intCast(usize, len)))
}

// The handler of NAME: one made before (or registered), else libxml2's
// own or iconv's of the std decoders; 0 when there is none.
export fn xmlFindCharEncodingHandler(nameIn: usize) -> usize {
    if nameIn == 0 || text.get8(nameIn) == 0 { return 0 }
    var name = nameIn
    const alias = xmlGetEncodingAlias(name)
    if alias != 0 { name = alias }
    const made = findMade(name)
    if made != 0 { return made }
    var decoder: encoding.Handler = undefined
    if !encoding.handlerForName(name, &decoder) {
        // The canonical name of an encoding libxml2 knows by another.
        const enc = xmlParseCharEncoding(nameIn)
        const canon = xmlGetCharEncodingName(enc)
        if canon != 0 && !text.equal(name, canon) { return xmlFindCharEncodingHandler(canon) }
        return 0
    }
    if decoder.builtin {
        // libxml2's own: one handler of its own name.
        const own = ownName(decoder.kind, name)
        const kept = findMade(own)
        if kept != 0 { return kept }
        return make(own, decoder)
    }
    return make(name, decoder)
}

// The name of libxml2's own handler of a decoder (NAME asked for).
fn ownName(kind: u64, name: usize) -> usize {
    if kind == encoding.KIND_UTF8 { return @intFromPtr("UTF-8".pointer) }
    if kind == encoding.KIND_UTF16LE { return @intFromPtr("UTF-16LE".pointer) }
    if kind == encoding.KIND_UTF16BE { return @intFromPtr("UTF-16BE".pointer) }
    if kind == encoding.KIND_UTF16 { return @intFromPtr("UTF-16".pointer) }
    if kind == encoding.KIND_LATIN1 { return @intFromPtr("ISO-8859-1".pointer) }
    if text.equalTextNoCase(name, "US-ASCII") { return @intFromPtr("US-ASCII".pointer) }
    return @intFromPtr("ASCII".pointer)
}

export fn xmlGetCharEncodingHandler(enc: i32) -> usize {
    if enc == 2 { return xmlFindCharEncodingHandler(@intFromPtr("UTF-16LE".pointer)) }
    if enc == 3 { return xmlFindCharEncodingHandler(@intFromPtr("UTF-16BE".pointer)) }
    if enc == 4 || enc == 5 {
        var h = xmlFindCharEncodingHandler(@intFromPtr("ISO-10646-UCS-4".pointer))
        if h == 0 { h = xmlFindCharEncodingHandler(@intFromPtr("UCS-4".pointer)) }
        return h
    }
    if enc >= 10 && enc <= 18 { return xmlFindCharEncodingHandler(xmlGetCharEncodingName(enc)) }
    if enc == 9 { return xmlFindCharEncodingHandler(@intFromPtr("ISO-10646-UCS-2".pointer)) }
    if enc == 19 || enc == 21 { return xmlFindCharEncodingHandler(xmlGetCharEncodingName(enc)) }
    if enc == 20 { return xmlFindCharEncodingHandler(@intFromPtr("SHIFT_JIS".pointer)) }
    return 0
}

export fn xmlNewCharEncodingHandler(name: usize, input: usize, output: usize) -> usize {
    if name == 0 { return 0 }
    var n = name
    const alias = xmlGetEncodingAlias(name)
    if alias != 0 { n = alias }
    const upper = upperCopy(n)
    if upper == 0 { return 0 }
    const block = make(upper, encoding.handlerOf(encoding.KIND_NONE))
    m.xfree(upper)
    if block == 0 { return 0 }
    blockAt(block).*.input = input
    blockAt(block).*.output = output
    return block
}

// A program's handler, found by name from now on (it is one of this
// module's when made by xmlNewCharEncodingHandler).
export fn xmlRegisterCharEncodingHandler(handler: usize) -> void {
    if handler == 0 { return }
    var at = handlers
    while at != 0 {
        if at == handler { return }
        at = blockAt(at).*.next
    }
    // (A structure the program made: its name, without a decoder.)
    const block = make(text.getWord(handler), encoding.handlerOf(encoding.KIND_NONE))
    if block != 0 {
        blockAt(block).*.input = text.getWord(handler + 8)
        blockAt(block).*.output = text.getWord(handler + 16)
    }
}

// The handlers are kept: closing one frees nothing.
export fn xmlCharEncCloseFunc(handler: usize) -> i32 {
    if handler == 0 { return -1 }
    return 0
}

export fn xmlInitCharEncodingHandlers() -> void {}
export fn xmlCleanupCharEncodingHandlers() -> void { xmlCleanupEncodingAliases() }

// ---------------------------------------------------------------------------
// Latin-1

export fn isolat1ToUTF8(out: usize, outlen: usize, input: usize, inlen: usize) -> i32 {
    if out == 0 || input == 0 || outlen == 0 || inlen == 0 { return -1 }
    const outend = out + @intCast(usize, text.getInt(outlen))
    const inend = input + @intCast(usize, text.getInt(inlen))
    var o = out
    var i = input
    while i < inend && o + 1 < outend {
        const c = text.get8(i)
        if c >= 0x80 {
            text.put8(o, ((c >> 6) & 0x1F) | 0xC0)
            text.put8(o + 1, (c & 0x3F) | 0x80)
            o += 2
        } else {
            text.put8(o, c)
            o += 1
        }
        i += 1
    }
    if i < inend && o < outend && text.get8(i) < 0x80 {
        text.put8(o, text.get8(i))
        o += 1
        i += 1
    }
    text.putInt(outlen, @intCast(i64, o - out))
    text.putInt(inlen, @intCast(i64, i - input))
    return @intCast(i32, o - out)
}

export fn UTF8Toisolat1(out: usize, outlen: usize, input: usize, inlen: usize) -> i32 {
    if out == 0 || outlen == 0 || inlen == 0 { return -1 }
    if input == 0 {
        text.putInt(outlen, 0)
        text.putInt(inlen, 0)
        return 0
    }
    const inend = input + @intCast(usize, text.getInt(inlen))
    const outend = out + @intCast(usize, text.getInt(outlen))
    var o = out
    var i = input
    var processed = input
    while i < inend {
        var d = text.get8(i)
        i += 1
        var c: u64 = 0
        var trailing: usize = 0
        if d < 0x80 {
            c = d
        } else if d < 0xC0 || d >= 0xF8 {
            text.putInt(outlen, @intCast(i64, o - out))
            text.putInt(inlen, @intCast(i64, processed - input))
            return -2
        } else if d < 0xE0 {
            c = d & 0x1F
            trailing = 1
        } else if d < 0xF0 {
            c = d & 0x0F
            trailing = 2
        } else {
            c = d & 0x07
            trailing = 3
        }
        if inend - i < trailing { break }
        while trailing > 0 {
            d = text.get8(i)
            i += 1
            if (d & 0xC0) != 0x80 {
                text.putInt(outlen, @intCast(i64, o - out))
                text.putInt(inlen, @intCast(i64, processed - input))
                return -2
            }
            c = (c << 6) | (d & 0x3F)
            trailing -= 1
        }
        if c > 0xFF {
            text.putInt(outlen, @intCast(i64, o - out))
            text.putInt(inlen, @intCast(i64, processed - input))
            return -2
        }
        if o >= outend { break }
        text.put8(o, c)
        o += 1
        processed = i
    }
    text.putInt(outlen, @intCast(i64, o - out))
    text.putInt(inlen, @intCast(i64, processed - input))
    return @intCast(i32, o - out)
}
