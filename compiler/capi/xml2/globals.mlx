// libxml2's global variables (globals.h): the defaults a new parser
// takes (xmlKeepBlanksDefaultValue and its kin), the version string, the
// error handlers' (errors.mlx). A program reaches each through the
// function that answers its address (__xmlKeepBlanksDefaultValue()...),
// which the header's macros call, as in libxml2 built with threads.

pub var keepBlanksDefault: i32 = 1
pub var substituteEntitiesDefault: i32 = 0
pub var lineNumbersDefault: i32 = 0
pub var getWarningsDefault: i32 = 1
pub var pedanticParserDefault: i32 = 0
pub var loadExtDtdDefault: i32 = 0
pub var doValidityCheckingDefault: i32 = 0
// xmlParserVersion: the address of LIBXML_VERSION_STRING (set when first
// asked for).
var parserVersion: usize = 0

export fn __xmlKeepBlanksDefaultValue() -> usize { return @intFromPtr(&keepBlanksDefault) }
export fn __xmlSubstituteEntitiesDefaultValue() -> usize { return @intFromPtr(&substituteEntitiesDefault) }
export fn __xmlLineNumbersDefaultValue() -> usize { return @intFromPtr(&lineNumbersDefault) }
export fn __xmlGetWarningsDefaultValue() -> usize { return @intFromPtr(&getWarningsDefault) }
export fn __xmlPedanticParserDefaultValue() -> usize { return @intFromPtr(&pedanticParserDefault) }
export fn __xmlLoadExtDtdDefaultValue() -> usize { return @intFromPtr(&loadExtDtdDefault) }
export fn __xmlDoValidityCheckingDefaultValue() -> usize { return @intFromPtr(&doValidityCheckingDefault) }

export fn __xmlParserVersion() -> usize {
    if parserVersion == 0 { parserVersion = @intFromPtr("20914".pointer) }
    return @intFromPtr(&parserVersion)
}

export fn xmlInitGlobals() -> void {}
export fn xmlCleanupGlobals() -> void {}

// xmlSubstituteEntitiesDefault and its kin: the new default, the old one
// answered.
export fn xmlSubstituteEntitiesDefault(val: i32) -> i32 {
    const old = substituteEntitiesDefault
    substituteEntitiesDefault = val
    return old
}

export fn xmlKeepBlanksDefault(val: i32) -> i32 {
    const old = keepBlanksDefault
    keepBlanksDefault = val
    // (libxml2 also sets xmlIndentTreeOutput here: there is no output.)
    return old
}

export fn xmlPedanticParserDefault(val: i32) -> i32 {
    const old = pedanticParserDefault
    pedanticParserDefault = val
    return old
}

export fn xmlLineNumbersDefault(val: i32) -> i32 {
    const old = lineNumbersDefault
    lineNumbersDefault = val
    return old
}
