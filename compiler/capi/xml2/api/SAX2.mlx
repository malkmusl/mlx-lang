// libxml/SAX2.h
// libxml2's SAX2 callbacks, the defaults of a parser's handler: a
// document made at the start (xmlSAX2StartDocument), its internal
// subset and the entities it declares kept (xmlSAX2InternalSubset,
// xmlSAX2EntityDecl), the entities looked up there (xmlSAX2GetEntity).
// The tree builders (elements, text, comments...) build no tree here.
const v = @import("./xmlversion.mlx")
const s = @import("./xmlstring.mlx")
const t = @import("./tree.mlx")
const p = @import("./parser.mlx")

pub extern("c") fn xmlSAX2GetPublicId(ctx: ?*anyopaque) -> ?[*]const s.xmlChar
pub extern("c") fn xmlSAX2GetSystemId(ctx: ?*anyopaque) -> ?[*]const s.xmlChar
pub extern("c") fn xmlSAX2SetDocumentLocator(ctx: ?*anyopaque, loc: ?*t.xmlSAXLocator) -> void
pub extern("c") fn xmlSAX2GetLineNumber(ctx: ?*anyopaque) -> v.c_int
pub extern("c") fn xmlSAX2GetColumnNumber(ctx: ?*anyopaque) -> v.c_int
pub extern("c") fn xmlSAX2IsStandalone(ctx: ?*anyopaque) -> v.c_int
pub extern("c") fn xmlSAX2HasInternalSubset(ctx: ?*anyopaque) -> v.c_int
pub extern("c") fn xmlSAX2HasExternalSubset(ctx: ?*anyopaque) -> v.c_int
pub extern("c") fn xmlSAX2InternalSubset(ctx: ?*anyopaque, name: ?[*]const s.xmlChar, ExternalID: ?[*]const s.xmlChar, SystemID: ?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2ExternalSubset(ctx: ?*anyopaque, name: ?[*]const s.xmlChar, ExternalID: ?[*]const s.xmlChar, SystemID: ?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2GetEntity(ctx: ?*anyopaque, name: ?[*]const s.xmlChar) -> ?*t.xmlEntity
pub extern("c") fn xmlSAX2GetParameterEntity(ctx: ?*anyopaque, name: ?[*]const s.xmlChar) -> ?*t.xmlEntity
pub extern("c") fn xmlSAX2ResolveEntity(ctx: ?*anyopaque, publicId: ?[*]const s.xmlChar, systemId: ?[*]const s.xmlChar) -> ?*t.xmlParserInput
pub extern("c") fn xmlSAX2EntityDecl(ctx: ?*anyopaque, name: ?[*]const s.xmlChar, type_: v.c_int, publicId: ?[*]const s.xmlChar, systemId: ?[*]const s.xmlChar, content: ?[*]s.xmlChar) -> void
pub extern("c") fn xmlSAX2AttributeDecl(ctx: ?*anyopaque, elem: ?[*]const s.xmlChar, fullname: ?[*]const s.xmlChar, type_: v.c_int, def: v.c_int, defaultValue: ?[*]const s.xmlChar, tree: ?*t.xmlEnumeration) -> void
pub extern("c") fn xmlSAX2ElementDecl(ctx: ?*anyopaque, name: ?[*]const s.xmlChar, type_: v.c_int, content: ?*t.xmlElementContent) -> void
pub extern("c") fn xmlSAX2NotationDecl(ctx: ?*anyopaque, name: ?[*]const s.xmlChar, publicId: ?[*]const s.xmlChar, systemId: ?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2UnparsedEntityDecl(ctx: ?*anyopaque, name: ?[*]const s.xmlChar, publicId: ?[*]const s.xmlChar, systemId: ?[*]const s.xmlChar, notationName: ?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2StartDocument(ctx: ?*anyopaque) -> void
pub extern("c") fn xmlSAX2EndDocument(ctx: ?*anyopaque) -> void
pub extern("c") fn xmlSAX2StartElement(ctx: ?*anyopaque, fullname: ?[*]const s.xmlChar, atts: ?[*]?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2EndElement(ctx: ?*anyopaque, name: ?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2StartElementNs(ctx: ?*anyopaque, localname: ?[*]const s.xmlChar, prefix: ?[*]const s.xmlChar, URI: ?[*]const s.xmlChar, nb_namespaces: v.c_int, namespaces: ?[*]?[*]const s.xmlChar, nb_attributes: v.c_int, nb_defaulted: v.c_int, attributes: ?[*]?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2EndElementNs(ctx: ?*anyopaque, localname: ?[*]const s.xmlChar, prefix: ?[*]const s.xmlChar, URI: ?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2Reference(ctx: ?*anyopaque, name: ?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2Characters(ctx: ?*anyopaque, ch: ?[*]const s.xmlChar, len: v.c_int) -> void
pub extern("c") fn xmlSAX2IgnorableWhitespace(ctx: ?*anyopaque, ch: ?[*]const s.xmlChar, len: v.c_int) -> void
pub extern("c") fn xmlSAX2ProcessingInstruction(ctx: ?*anyopaque, target: ?[*]const s.xmlChar, data: ?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2Comment(ctx: ?*anyopaque, value: ?[*]const s.xmlChar) -> void
pub extern("c") fn xmlSAX2CDataBlock(ctx: ?*anyopaque, value: ?[*]const s.xmlChar, len: v.c_int) -> void
pub extern("c") fn xmlSAXDefaultVersion(version: v.c_int) -> v.c_int
pub extern("c") fn xmlSAXVersion(hdlr: ?*t.xmlSAXHandler, version: v.c_int) -> v.c_int
pub extern("c") fn xmlSAX2InitDefaultSAXHandler(hdlr: ?*t.xmlSAXHandler, warning: v.c_int) -> void
pub extern("c") fn xmlSAX2InitHtmlDefaultSAXHandler(hdlr: ?*t.xmlSAXHandler) -> void
pub extern("c") fn xmlDefaultSAXHandlerInit() -> void
