// libxml/dict.h
// libxml2's dictionaries: each string once, at an address that stays as
// long as the dictionary (a parser's names are its dictionary's).
const v = @import("./xmlversion.mlx")
const s = @import("./xmlstring.mlx")
const t = @import("./tree.mlx")

pub extern("c") fn xmlInitializeDict() -> v.c_int
pub extern("c") fn xmlDictCreate() -> ?*t.xmlDict
pub extern("c") fn xmlDictSetLimit(dict: ?*t.xmlDict, limit: usize) -> usize
pub extern("c") fn xmlDictGetUsage(dict: ?*t.xmlDict) -> usize
pub extern("c") fn xmlDictCreateSub(sub: ?*t.xmlDict) -> ?*t.xmlDict
pub extern("c") fn xmlDictReference(dict: ?*t.xmlDict) -> v.c_int
pub extern("c") fn xmlDictFree(dict: ?*t.xmlDict) -> void
pub extern("c") fn xmlDictLookup(dict: ?*t.xmlDict, name: ?[*]const s.xmlChar, len: v.c_int) -> ?[*]const s.xmlChar
pub extern("c") fn xmlDictExists(dict: ?*t.xmlDict, name: ?[*]const s.xmlChar, len: v.c_int) -> ?[*]const s.xmlChar
pub extern("c") fn xmlDictQLookup(dict: ?*t.xmlDict, prefix: ?[*]const s.xmlChar, name: ?[*]const s.xmlChar) -> ?[*]const s.xmlChar
pub extern("c") fn xmlDictOwns(dict: ?*t.xmlDict, str: ?[*]const s.xmlChar) -> v.c_int
pub extern("c") fn xmlDictSize(dict: ?*t.xmlDict) -> v.c_int
pub extern("c") fn xmlDictCleanup() -> void
