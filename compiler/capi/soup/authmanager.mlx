// soup-auth-manager.h: SoupAuthManager, the session feature that answers
// 401 and 407: it picks the strongest scheme it knows among a response's
// challenges, asks the message's "authenticate" handlers for credentials
// (who may give them at once, or later: the message waits, paused), sends
// the message again with them, and remembers them for the host's paths
// (the protection space) so that later messages carry them at once.
//
// A SoupAuthManager: a GObject and (24) a record of the auth classes (0,
// a GPtrArray, weakest first), the hosts (8: a GHashTable of host URI to
// a host record), the proxy's auth (16), the session (24), whether NTLM is
// tried unasked (32). A host: its URI (0), its realms by path (8, a
// pathmap of "scheme:realm"), its auths by "scheme:realm" (16).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const misc = @import("./misc.mlx")
const message = @import("./message.mlx")
const feature = @import("./feature.mlx")
const auth = @import("./auth.mlx")
const pathmap = @import("./pathmap.mlx")
const http = @import("std.http.headers")

extern("c") fn soup_header_parse_list(header: usize) -> usize
extern("c") fn soup_header_free_list(list: usize) -> void
extern("c") fn soup_message_headers_get_list(h: usize, name: usize) -> usize
extern("c") fn soup_message_headers_remove(h: usize, name: usize) -> void
extern("c") fn soup_message_headers_replace(h: usize, name: usize, value: usize) -> void
extern("c") fn soup_message_add_status_code_handler(msg: usize, signal: usize, code: u32, callback: usize, data: usize) -> u32
extern("c") fn soup_uri_copy(uri: usize, first: i32, a: usize, b: i32, c_: usize, end: i32) -> usize
extern("c") fn soup_session_get_type() -> usize
extern("c") fn __mlx_soup_session_pause_message(session: usize, msg: usize) -> void
extern("c") fn __mlx_soup_session_unpause_message(session: usize, msg: usize) -> void
extern("c") fn __mlx_soup_session_requeue_message(session: usize, msg: usize) -> void
extern("c") fn g_ptr_array_new() -> usize
extern("c") fn g_ptr_array_add(array: usize, data: usize) -> void
extern("c") fn g_ptr_array_remove_index(array: usize, index: u32) -> usize
extern("c") fn g_ptr_array_unref(array: usize) -> void
extern("c") fn g_type_class_peek(t: usize) -> usize
extern("c") fn g_type_check_instance_is_a(instance: usize, t: usize) -> i32
extern("c") fn g_hash_table_remove_all(table: usize) -> void
extern("c") fn g_object_unref(object: usize) -> void
extern("c") fn g_free(address: usize) -> void
extern("c") fn g_str_hash(key: usize) -> u32
extern("c") fn g_str_equal(a: usize, b: usize) -> i32
extern("c") fn g_signal_handlers_disconnect_matched(instance: usize, mask: i32, id: u32, detail: u32, closure: usize, func: usize, data: usize) -> u32
extern("c") fn g_object_get_data(object: usize, key: usize) -> usize
extern("c") fn g_object_set_data_full(object: usize, key: usize, data: usize, destroy: usize) -> void
extern("c") fn g_object_steal_data(object: usize, key: usize) -> usize

const R_TYPES: usize = 0
const R_HOSTS: usize = 8
const R_PROXY_AUTH: usize = 16
const R_SESSION: usize = 24
const R_AUTO_NTLM: usize = 32
const R_SIZE: usize = 40

const H_URI: usize = 0
const H_REALMS: usize = 8
const H_AUTHS: usize = 16

var managerType: usize = 0
var managerLock: u64 = 0

pub fn managerTypeGet() -> usize {
    if c.onceEnter(&managerType) {
        const t = c.defineType(c.T_OBJECT, "SoupAuthManager", 136, @intFromPtr(__mlx_soup_auth_manager_class_init), 32, @intFromPtr(__mlx_soup_auth_manager_init), c.FINAL)
        feature.implementFeature(t, @intFromPtr(__mlx_soup_auth_manager_feature_init))
        c.onceLeave(&managerType, t)
    }
    return managerType
}

export fn soup_auth_manager_get_type() -> usize { return managerTypeGet() }

fn rec(manager: usize) -> usize { return m.getWord(manager + 24) }

// The hosts table: keyed by the host URI (scheme, host, port).
export fn __mlx_soup_auth_host_hash(uri: usize) -> u32 {
    var h: u32 = g_str_hash(g.g_uri_get_scheme(uri)) +% @bitCast(u32, g.g_uri_get_port(uri))
    const host = g.g_uri_get_host(uri)
    if host != 0 {
        for ch in m.cSlice(host) { h = (h << 5) +% h +% @intCast(u32, m.lower(ch)) }
    }
    return h
}

export fn __mlx_soup_auth_host_equal(a: usize, b: usize) -> i32 { return if misc.uriHostEqual(a, b) { 1 } else { 0 } }

export fn __mlx_soup_auth_host_free(host: usize) -> void {
    pathmap.free(m.getWord(host + H_REALMS))
    if m.getWord(host + H_AUTHS) != 0 { g.g_hash_table_destroy(m.getWord(host + H_AUTHS)) }
    g.g_uri_unref(m.getWord(host + H_URI))
    m.release(host)
}

export fn __mlx_soup_auth_manager_init(manager: usize, class: usize) -> void {
    const r = m.alloc(R_SIZE)
    m.putWord(manager + 24, r)
    m.putWord(r + R_TYPES, g_ptr_array_new())
    m.putWord(r + R_HOSTS, g.g_hash_table_new_full(@intFromPtr(__mlx_soup_auth_host_hash), @intFromPtr(__mlx_soup_auth_host_equal), 0, @intFromPtr(__mlx_soup_auth_host_free)))
}

export fn __mlx_soup_auth_manager_finalize(manager: usize) -> void {
    const r = rec(manager)
    g_ptr_array_unref(m.getWord(r + R_TYPES))
    g.g_hash_table_destroy(m.getWord(r + R_HOSTS))
    c.clearObject(r + R_PROXY_AUTH)
    m.release(r)
    c.chainUp(g.g_type_class_ref(managerTypeGet()), 48, manager)
}

export fn __mlx_soup_auth_manager_class_init(class: usize, data: usize) -> void { m.putWord(class + 48, @intFromPtr(__mlx_soup_auth_manager_finalize)) }

fn typesCount(r: usize) -> usize { return @intCast(usize, m.get32(m.getWord(r + R_TYPES) + 8)) }
fn typeAt(r: usize, index: usize) -> usize { return m.getWord(m.getWord(m.getWord(r + R_TYPES)) + index * 8) }

export fn __mlx_soup_auth_manager_add_feature(manager: usize, t: usize) -> i32 {
    if g.g_type_is_a(t, auth.authTypeGet()) == 0 { return 0 }
    const r = rec(manager)
    const class = g.g_type_class_ref(t)
    // Kept weakest first.
    g_ptr_array_add(m.getWord(r + R_TYPES), class)
    const array = m.getWord(m.getWord(r + R_TYPES))
    var index = typesCount(r) - 1
    while index > 0 && auth.strengthOfClass(m.getWord(array + (index - 1) * 8)) > auth.strengthOfClass(m.getWord(array + index * 8)) {
        const swap = m.getWord(array + index * 8)
        m.putWord(array + index * 8, m.getWord(array + (index - 1) * 8))
        m.putWord(array + (index - 1) * 8, swap)
        index -= 1
    }
    if t == auth.ntlmTypeGet() && m.getWord(r + R_SESSION) != 0 && m.getWord(m.getWord(m.getWord(r + R_SESSION))) != soup_session_get_type() { m.putI32(r + R_AUTO_NTLM, 1) }
    return 1
}

export fn __mlx_soup_auth_manager_remove_feature(manager: usize, t: usize) -> i32 {
    if g.g_type_is_a(t, auth.authTypeGet()) == 0 { return 0 }
    const r = rec(manager)
    const class = g_type_class_peek(t)
    var index: usize = 0
    while index < typesCount(r) {
        if typeAt(r, index) == class {
            if t == auth.ntlmTypeGet() { m.putI32(r + R_AUTO_NTLM, 0) }
            _ = g_ptr_array_remove_index(m.getWord(r + R_TYPES), @intCast(u32, index))
            return 1
        }
        index += 1
    }
    return 0
}

export fn __mlx_soup_auth_manager_has_feature(manager: usize, t: usize) -> i32 {
    if g.g_type_is_a(t, auth.authTypeGet()) == 0 { return 0 }
    const r = rec(manager)
    const class = g_type_class_peek(t)
    var index: usize = 0
    while index < typesCount(r) {
        if typeAt(r, index) == class { return 1 }
        index += 1
    }
    return 0
}

export fn __mlx_soup_auth_manager_attach(manager: usize, session: usize) -> void { m.putWord(rec(manager) + R_SESSION, session) }

fn authHeader(msg: usize) -> usize {
    if message.statusOf(msg) == 407 { return soup_message_headers_get_list(message.responseHeaders(msg), m.literal("Proxy-Authenticate")) }
    return soup_message_headers_get_list(message.responseHeaders(msg), m.literal("WWW-Authenticate"))
}

// libsoup's next_challenge_start: the item that starts a challenge (a
// scheme alone, or a scheme and its first parameter or token).
fn nextChallengeStart(items: usize) -> usize {
    var at = items
    while at != 0 {
        const text = m.cSlice(m.getWord(at))
        const eq = http.indexOf(text, 61, 0)
        if eq == text.length { return at }
        var sp = text.length
        var i: usize = 0
        while i < text.length {
            if text[i] == 9 || text[i] == 13 || text[i] == 10 || text[i] == 32 {
                sp = i
                break
            }
            i += 1
        }
        if sp == text.length || sp > eq {
            at = m.getWord(at + 8)
            continue
        }
        sp += 1
        while sp < text.length && http.isSpace(text[sp]) { sp += 1 }
        if sp == eq {
            at = m.getWord(at + 8)
            continue
        }
        return at
    }
    return 0
}

// The challenges of `scheme` in a list of them: a strv (0: none).
fn extractChallenges(challenges: usize, scheme: usize) -> usize {
    var w = m.words()
    const s = m.cSlice(scheme)
    const items = soup_header_parse_list(challenges)
    var at = items
    while at != 0 {
        while at != 0 {
            const text = m.cSlice(m.getWord(at))
            if text.length >= s.length && http.equalsIgnoringCase(text[0..s.length], s) && (text.length == s.length || http.isSpace(text[s.length])) { break }
            at = nextChallengeStart(m.getWord(at + 8))
        }
        if at == 0 { break }
        const next = nextChallengeStart(m.getWord(at + 8))
        var t = m.text()
        m.pushC(&t, m.getWord(at))
        at = m.getWord(at + 8)
        while at != next {
            m.pushText(&t, ", ")
            m.pushC(&t, m.getWord(at))
            at = m.getWord(at + 8)
        }
        m.pushWord(&w, m.finish(&t))
    }
    soup_header_free_list(items)
    if w.length == 0 {
        m.disposeWords(&w)
        return 0
    }
    m.pushWord(&w, 0)
    return m.finishWords(&w)
}

fn createAuth(r: usize, msg: usize) -> usize {
    const header = authHeader(msg)
    if header == 0 { return 0 }
    var index = typesCount(r)
    while index > 0 {
        index -= 1
        const class = typeAt(r, index)
        const challenges = extractChallenges(header, auth.schemeOfClass(class))
        if challenges == 0 { continue }
        var j: usize = 0
        while m.getWord(challenges + j * 8) != 0 {
            const a = auth.newAuth(m.getWord(class), msg, m.getWord(challenges + j * 8))
            if a != 0 {
                g.g_strfreev(challenges)
                return a
            }
            j += 1
        }
        g.g_strfreev(challenges)
    }
    return 0
}

fn checkAuth(msg: usize, a: usize) -> bool {
    const scheme = auth.schemeName(a)
    const header = authHeader(msg)
    var challenges: usize = 0
    var ok = true
    if header != 0 { challenges = extractChallenges(header, scheme) }
    if challenges == 0 {
        var w = m.words()
        m.pushWord(&w, m.dup(scheme))
        m.pushWord(&w, 0)
        challenges = m.finishWords(&w)
        ok = false
    }
    var good = false
    var j: usize = 0
    while m.getWord(challenges + j * 8) != 0 {
        if auth.update(a, msg, m.getWord(challenges + j * 8)) {
            good = true
            break
        }
        j += 1
    }
    if !good { ok = false }
    g.g_strfreev(challenges)
    return ok
}

fn hostFor(r: usize, uri: usize) -> usize {
    const hosts = m.getWord(r + R_HOSTS)
    const found = g.g_hash_table_lookup(hosts, uri)
    if found != 0 { return found }
    const host = m.alloc(24)
    m.putWord(host + H_URI, misc.copyHost(uri))
    _ = g.g_hash_table_insert(hosts, m.getWord(host + H_URI), host)
    return host
}

fn recordAuth(r: usize, uri: usize, a: usize, priorFailed: bool) -> usize {
    const host = hostFor(r, uri)
    const authInfo = auth.info(a)
    if m.getWord(host + H_REALMS) == 0 {
        m.putWord(host + H_REALMS, pathmap.new(@intFromPtr(g_free)))
        m.putWord(host + H_AUTHS, g.g_hash_table_new_full(@intFromPtr(g_str_hash), @intFromPtr(g_str_equal), @intFromPtr(g_free), @intFromPtr(g_object_unref)))
    }
    const realms = m.getWord(host + H_REALMS)
    const space = auth.protectionSpace(a, uri)
    var p = space
    while p != 0 {
        const path = m.getWord(p)
        const old = pathmap.lookup(realms, path)
        var skip = false
        if old != 0 {
            if m.cEqual(old, authInfo) {
                skip = true
            } else {
                pathmap.remove(realms, path)
            }
        }
        if !skip { pathmap.add(realms, path, m.dup(authInfo)) }
        p = m.getWord(p + 8)
    }
    g.g_slist_free_full(space, @intFromPtr(g_free))
    const auths = m.getWord(host + H_AUTHS)
    const oldAuth = g.g_hash_table_lookup(auths, authInfo)
    if oldAuth != 0 && (oldAuth != a || !priorFailed) && !auth.isCancelled(oldAuth) {
        m.release(authInfo)
        return oldAuth
    }
    _ = g.g_hash_table_insert(auths, authInfo, g.g_object_ref(a))
    return a
}

fn makeAutoNtlm(r: usize, host: usize) -> bool {
    if m.getI32(r + R_AUTO_NTLM) == 0 { return false }
    const uri = m.getWord(host + H_URI)
    const a = g.g_object_new(auth.ntlmTypeGet(), 0)
    var t = m.text()
    m.pushC(&t, g.g_uri_get_host(uri))
    m.pushByte(&t, 58)
    m.pushSigned(&t, @intCast(i64, g.g_uri_get_port(uri)))
    const authority = m.finish(&t)
    auth.setAuthority(a, authority)
    m.release(authority)
    _ = recordAuth(r, uri, a, false)
    g.g_object_unref(a)
    return true
}

fn updateAuthorization(msg: usize, a: usize, proxy: bool) -> void {
    const name = if proxy { m.literal("Proxy-Authorization") } else { m.literal("Authorization") }
    if message.auth(msg) != 0 { soup_message_headers_remove(message.requestHeaders(msg), name) }
    if a == 0 { return }
    const token = auth.authorization(a, msg)
    if token == 0 { return }
    soup_message_headers_replace(message.requestHeaders(msg), name, token)
    g.g_free(token)
}

fn lookupAuth(r: usize, msg: usize) -> usize {
    const a = message.auth(msg)
    if a != 0 && auth.isReady(a, msg) { return a }
    if message.hasFlag(msg, message.DO_NOT_USE_AUTH_CACHE) { return 0 }
    const uri = auth.uriForAuth(msg)
    if uri == 0 { return 0 }
    const host = hostFor(r, uri)
    if m.getWord(host + H_REALMS) == 0 && !makeAutoNtlm(r, host) { return 0 }
    if m.getWord(host + H_REALMS) == 0 { return 0 }
    var path = g.g_uri_get_path(uri)
    if path == 0 { path = m.literal("/") }
    const realmInfo = pathmap.lookup(m.getWord(host + H_REALMS), path)
    if realmInfo != 0 { return g.g_hash_table_lookup(m.getWord(host + H_AUTHS), realmInfo) }
    return 0
}

fn lookupProxyAuth(r: usize, msg: usize) -> usize {
    const a = message.proxyAuth(msg)
    if a != 0 && auth.isReady(a, msg) { return a }
    if message.hasFlag(msg, message.DO_NOT_USE_AUTH_CACHE) { return 0 }
    return m.getWord(r + R_PROXY_AUTH)
}

// "notify::is-authenticated" or "notify::is-cancelled" of an auth the
// message waits on: it goes on.
export fn __mlx_soup_auth_manager_async_finished(a: usize, pspec: usize, msg: usize) -> void {
    const session = g_object_steal_data(msg, m.literal("auth-msg-session"))
    if session == 0 { return }
    _ = g_signal_handlers_disconnect_matched(a, 16, 0, 0, 0, @intFromPtr(__mlx_soup_auth_manager_async_finished), msg)
    __mlx_soup_session_unpause_message(session, msg)
    g.g_object_unref(session)
}

fn authenticateAuth(r: usize, a: usize, msg: usize, priorFailed: bool, proxy: bool, canInteract: bool) -> void {
    if !auth.canAuthenticate(a) { return }
    const uri = auth.uriForAuth(msg)
    if uri != 0 && g.g_uri_get_user(uri) != 0 {
        // Credentials in the URI are used, and taken out of it.
        const password = g.g_uri_get_password(uri)
        auth.authenticate(a, g.g_uri_get_user(uri), if password != 0 { password } else { m.literal("") })
        // SOUP_URI_USER 2, SOUP_URI_PASSWORD 3, SOUP_URI_NONE 0.
        const bare = soup_uri_copy(uri, 2, 0, 3, 0, 0)
        message.setUri(msg, bare)
        g.g_uri_unref(bare)
    } else if !auth.isAuthenticated(a) && canInteract {
        const handled = message.authenticate(msg, a, priorFailed)
        if handled && !auth.isAuthenticated(a) && !auth.isCancelled(a) {
            const session = m.getWord(r + R_SESSION)
            __mlx_soup_session_pause_message(session, msg)
            g_object_set_data_full(msg, m.literal("auth-msg-session"), g.g_object_ref(session), @intFromPtr(g_object_unref))
            _ = g.g_signal_connect_data(a, m.literal("notify::is-authenticated"), @intFromPtr(__mlx_soup_auth_manager_async_finished), msg, 0, 0)
            _ = g.g_signal_connect_data(a, m.literal("notify::is-cancelled"), @intFromPtr(__mlx_soup_auth_manager_async_finished), msg, 0, 0)
        }
    }
}

export fn __mlx_soup_auth_manager_got_headers(msg: usize, manager: usize) -> void {
    const r = rec(manager)
    c.lock(&managerLock)
    const prior = message.auth(msg)
    var priorFailed = false
    var a: usize = 0
    if prior != 0 && checkAuth(msg, prior) {
        a = g.g_object_ref(prior)
        if !auth.isReady(a, msg) { priorFailed = true }
    } else {
        a = createAuth(r, msg)
        if a == 0 {
            c.unlock(&managerLock)
            return
        }
    }
    if !message.hasFlag(msg, message.DO_NOT_USE_AUTH_CACHE) {
        const recorded = recordAuth(r, auth.uriForAuth(msg), a, priorFailed)
        g.g_object_unref(a)
        a = g.g_object_ref(recorded)
    }
    c.unlock(&managerLock)
    authenticateAuth(r, a, msg, priorFailed, false, true)
    message.setAuth(msg, a)
    g.g_object_unref(a)
}

export fn __mlx_soup_auth_manager_got_body(msg: usize, manager: usize) -> void {
    const r = rec(manager)
    c.lock(&managerLock)
    const a = lookupAuth(r, msg)
    if a != 0 && auth.isReady(a, msg) {
        if auth.isConnectionAuth(a) { message.removeFlag(msg, message.NEW_CONNECTION) }
        if message.hasFlag(msg, message.DO_NOT_USE_AUTH_CACHE) { updateAuthorization(msg, a, false) }
        __mlx_soup_session_requeue_message(m.getWord(r + R_SESSION), msg)
    }
    c.unlock(&managerLock)
}

export fn __mlx_soup_auth_manager_proxy_got_headers(msg: usize, manager: usize) -> void {
    const r = rec(manager)
    c.lock(&managerLock)
    const prior = message.proxyAuth(msg)
    var priorFailed = false
    if prior != 0 && checkAuth(msg, prior) {
        if !auth.isReady(prior, msg) { priorFailed = true }
    }
    var a: usize = 0
    if !message.hasFlag(msg, message.DO_NOT_USE_AUTH_CACHE) && m.getWord(r + R_PROXY_AUTH) != 0 { a = g.g_object_ref(m.getWord(r + R_PROXY_AUTH)) }
    if a == 0 {
        a = createAuth(r, msg)
        if a == 0 {
            c.unlock(&managerLock)
            return
        }
        if !message.hasFlag(msg, message.DO_NOT_USE_AUTH_CACHE) { c.replaceObject(r + R_PROXY_AUTH, a) }
    }
    c.unlock(&managerLock)
    authenticateAuth(r, a, msg, priorFailed, true, true)
    message.setProxyAuth(msg, a)
    g.g_object_unref(a)
}

export fn __mlx_soup_auth_manager_proxy_got_body(msg: usize, manager: usize) -> void {
    const r = rec(manager)
    c.lock(&managerLock)
    const a = lookupProxyAuth(r, msg)
    if a != 0 && auth.isReady(a, msg) {
        if message.hasFlag(msg, message.DO_NOT_USE_AUTH_CACHE) { updateAuthorization(msg, a, true) }
        __mlx_soup_session_requeue_message(m.getWord(r + R_SESSION), msg)
    }
    c.unlock(&managerLock)
}

export fn __mlx_soup_auth_manager_starting(msg: usize, manager: usize) -> void {
    if message.hasFlag(msg, message.DO_NOT_USE_AUTH_CACHE) { return }
    const r = rec(manager)
    c.lock(&managerLock)
    if !message.methodIs(msg, "CONNECT") {
        var a = lookupAuth(r, msg)
        if a != 0 {
            authenticateAuth(r, a, msg, false, false, false)
            if !auth.isReady(a, msg) { a = 0 }
        }
        updateAuthorization(msg, a, false)
        message.setAuth(msg, a)
    }
    var p = lookupProxyAuth(r, msg)
    if p != 0 {
        authenticateAuth(r, p, msg, false, true, false)
        if !auth.isReady(p, msg) { p = 0 }
    }
    const hadProxyAuth = message.proxyAuth(msg) != 0
    message.setProxyAuth(msg, p)
    if p != 0 || hadProxyAuth { updateProxyAuthorization(msg, p) }
    c.unlock(&managerLock)
}

fn updateProxyAuthorization(msg: usize, a: usize) -> void {
    const name = m.literal("Proxy-Authorization")
    soup_message_headers_remove(message.requestHeaders(msg), name)
    if a == 0 { return }
    const token = auth.authorization(a, msg)
    if token == 0 { return }
    soup_message_headers_replace(message.requestHeaders(msg), name, token)
    g.g_free(token)
}

export fn __mlx_soup_auth_manager_request_queued(manager: usize, msg: usize) -> void {
    _ = g.g_signal_connect_data(msg, m.literal("starting"), @intFromPtr(__mlx_soup_auth_manager_starting), manager, 0, 0)
    _ = soup_message_add_status_code_handler(msg, m.literal("got_headers"), 401, @intFromPtr(__mlx_soup_auth_manager_got_headers), manager)
    _ = soup_message_add_status_code_handler(msg, m.literal("got_body"), 401, @intFromPtr(__mlx_soup_auth_manager_got_body), manager)
    _ = soup_message_add_status_code_handler(msg, m.literal("got_headers"), 407, @intFromPtr(__mlx_soup_auth_manager_proxy_got_headers), manager)
    _ = soup_message_add_status_code_handler(msg, m.literal("got_body"), 407, @intFromPtr(__mlx_soup_auth_manager_proxy_got_body), manager)
}

export fn __mlx_soup_auth_manager_request_unqueued(manager: usize, msg: usize) -> void { _ = g_signal_handlers_disconnect_matched(msg, 16, 0, 0, 0, 0, manager) }

export fn __mlx_soup_auth_manager_feature_init(iface: usize, data: usize) -> void {
    m.putWord(iface + feature.ATTACH, @intFromPtr(__mlx_soup_auth_manager_attach))
    m.putWord(iface + feature.REQUEST_QUEUED, @intFromPtr(__mlx_soup_auth_manager_request_queued))
    m.putWord(iface + feature.REQUEST_UNQUEUED, @intFromPtr(__mlx_soup_auth_manager_request_unqueued))
    m.putWord(iface + feature.ADD_FEATURE, @intFromPtr(__mlx_soup_auth_manager_add_feature))
    m.putWord(iface + feature.REMOVE_FEATURE, @intFromPtr(__mlx_soup_auth_manager_remove_feature))
    m.putWord(iface + feature.HAS_FEATURE, @intFromPtr(__mlx_soup_auth_manager_has_feature))
}

export fn soup_auth_manager_use_auth(manager: usize, uri: usize, a: usize) -> void {
    c.lock(&managerLock)
    _ = recordAuth(rec(manager), uri, a, false)
    c.unlock(&managerLock)
}

export fn soup_auth_manager_clear_cached_credentials(manager: usize) -> void {
    c.lock(&managerLock)
    g_hash_table_remove_all(m.getWord(rec(manager) + R_HOSTS))
    c.unlock(&managerLock)
}
