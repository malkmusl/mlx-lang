// soup-enum-types.h: the GTypes of libsoup's enumerations and flags,
// with libsoup's value names and nicks (what glib-mkenums makes of its
// headers), each registered on first use.
const c = @import("./common.mlx")

var cacheabilityType: usize = 0

export fn soup_cacheability_get_type() -> usize { return cacheabilityTypeGet() }

pub fn cacheabilityTypeGet() -> usize {
    if c.onceEnter(&cacheabilityType) {
        const values = [4]i64{ 1, 2, 4, 8 }
        c.onceLeave(&cacheabilityType, c.enumType("SoupCacheability", true, values[0..4], "SOUP_CACHE_CACHEABLE SOUP_CACHE_UNCACHEABLE SOUP_CACHE_INVALIDATES SOUP_CACHE_VALIDATES", "cacheable uncacheable invalidates validates"))
    }
    return cacheabilityType
}

