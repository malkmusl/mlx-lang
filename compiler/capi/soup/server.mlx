// ---------------------------------------------------------------------------
// Constants

// SoupMessageHeadersType, SoupEncoding.
const HEADERS_REQUEST: i32 = 0
const HEADERS_RESPONSE: i32 = 1
const ENCODING_UNRECOGNIZED: i32 = 0
const ENCODING_NONE: i32 = 1
const ENCODING_CONTENT_LENGTH: i32 = 2
const ENCODING_EOF: i32 = 3
const ENCODING_CHUNKED: i32 = 4

// SoupHTTPVersion.
const HTTP_1_0: i32 = 0
const HTTP_1_1: i32 = 1

// The I/O states (libsoup's SoupMessageIOState).
const NOT_STARTED: i32 = 0
const HEADERS: i32 = 1
const BLOCKING: i32 = 2
const BODY_START: i32 = 3
const BODY: i32 = 4
const BODY_DATA: i32 = 5
const BODY_FLUSH: i32 = 6
const BODY_DONE: i32 = 7
const FINISHING: i32 = 8
const DONE: i32 = 9

// SoupMessageIOCompletion.
const COMPLETE: i32 = 0
const INTERRUPTED: i32 = 1
const STOLEN: i32 = 2

// GIOErrorEnum.
const IO_FAILED: i32 = 0
const IO_NOT_SUPPORTED: i32 = 15
const IO_INVALID_ARGUMENT: i32 = 13
const IO_WOULD_BLOCK: i32 = 27
const IO_ADDRESS_IN_USE: i32 = 33
const IO_PARTIAL_INPUT: i32 = 34
const IO_MESSAGE_TOO_LARGE: i32 = 46

const HEADER_SIZE_LIMIT: usize = 65536
const RESPONSE_BLOCK_SIZE: usize = 8192
const HTTP_URI_FLAGS: u32 = 1 | 2 | 4 | 8 | 16 | 64 | 256 | 512

const LISTEN_HTTPS: i32 = 1
const LISTEN_IPV4_ONLY: i32 = 2
const LISTEN_IPV6_ONLY: i32 = 4

const AF_INET: i32 = 2
const AF_INET6: i32 = 10
const SOCK_STREAM: i32 = 1
const SOCK_NONBLOCK: i32 = 2048
const SOCK_CLOEXEC: i32 = 524288
const SOL_SOCKET: i32 = 1
const SO_REUSEADDR: i32 = 2
const IPPROTO_IPV6: i32 = 41
const IPV6_V6ONLY: i32 = 26
const EAFNOSUPPORT: i32 = 97
const EADDRINUSE: i32 = 98

// ---------------------------------------------------------------------------
// SoupServerMessage

const SM_CONN: usize = 0
const SM_AUTH_DOMAIN: usize = 8
const SM_AUTH_USER: usize = 16
const SM_REMOTE_IP: usize = 24
const SM_METHOD: usize = 32
const SM_VERSION: usize = 40
const SM_ORIG_VERSION: usize = 44
const SM_STATUS: usize = 48
const SM_REASON: usize = 56
const SM_URI: usize = 64
const SM_REQUEST_BODY: usize = 72
const SM_REQUEST_HEADERS: usize = 80
const SM_RESPONSE_BODY: usize = 88
const SM_RESPONSE_HEADERS: usize = 96
const SM_IO: usize = 104
const SM_OPTIONS_PING: usize = 108
const SM_TLS_CERTIFICATE: usize = 112
const SM_TLS_ERRORS: usize = 120
const SM_SIZE: usize = 128

var messageType: usize = 0
var messagePrivate: i32 = 0
var sigWroteInformational: u32 = 0
var sigWroteHeaders: u32 = 0
var sigWroteChunk: u32 = 0
var sigWroteBodyData: u32 = 0
var sigWroteBody: u32 = 0
var sigGotHeaders: u32 = 0
var sigGotChunk: u32 = 0
var sigGotBody: u32 = 0
var sigConnected: u32 = 0
var sigDisconnected: u32 = 0
var sigFinished: u32 = 0
var sigAcceptCertificate: u32 = 0

pub fn messageTypeGet() -> usize {
    if c.onceEnter(&messageType) {
        const t = c.defineType(c.T_OBJECT, "SoupServerMessage", 136, @intFromPtr(__mlx_soup_server_message_class_init), 24, @intFromPtr(__mlx_soup_server_message_init), c.FINAL)
        messagePrivate = c.addPrivate(t, 8)
        c.onceLeave(&messageType, t)
    }
    return messageType
}

export fn soup_server_message_get_type() -> usize { return messageTypeGet() }

fn sm(msg: usize) -> usize { return m.getWord(c.privateAt(msg, messagePrivate)) }

export fn __mlx_soup_server_message_init(msg: usize, class: usize) -> void {
    const r = m.alloc(SM_SIZE)
    m.putWord(c.privateAt(msg, messagePrivate), r)
    m.putWord(r + SM_REQUEST_BODY, soup_message_body_new())
    m.putWord(r + SM_REQUEST_HEADERS, soup_message_headers_new(HEADERS_REQUEST))
    m.putWord(r + SM_RESPONSE_BODY, soup_message_body_new())
    m.putWord(r + SM_RESPONSE_HEADERS, soup_message_headers_new(HEADERS_RESPONSE))
    soup_message_headers_set_encoding(m.getWord(r + SM_RESPONSE_HEADERS), ENCODING_CONTENT_LENGTH)
}

export fn __mlx_soup_server_message_finalize(msg: usize) -> void {
    const r = sm(msg)
    c.clearObject(r + SM_AUTH_DOMAIN)
    g_free(m.getWord(r + SM_AUTH_USER))
    if m.getWord(r + SM_CONN) != 0 { connUnref(m.getWord(r + SM_CONN)) }
    g_free(m.getWord(r + SM_REMOTE_IP))
    if m.getWord(r + SM_URI) != 0 { g.g_uri_unref(m.getWord(r + SM_URI)) }
    g_free(m.getWord(r + SM_REASON))
    soup_message_body_unref(m.getWord(r + SM_REQUEST_BODY))
    soup_message_headers_unref(m.getWord(r + SM_REQUEST_HEADERS))
    soup_message_body_unref(m.getWord(r + SM_RESPONSE_BODY))
    soup_message_headers_unref(m.getWord(r + SM_RESPONSE_HEADERS))
    c.clearObject(r + SM_TLS_CERTIFICATE)
    m.release(r)
    c.chainUp(g.g_type_class_ref(messageTypeGet()), 48, msg)
}

export fn __mlx_soup_server_message_get_property(msg: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == 1 { g.g_value_set_object(value, m.getWord(sm(msg) + SM_TLS_CERTIFICATE)) }
    if id == 2 { g.g_value_set_flags(value, m.get32(sm(msg) + SM_TLS_ERRORS)) }
}

fn plainSignal(class: usize, name: []const u8) -> u32 { return c.signal(class, name, c.RUN_LAST, 0, 0, c.T_NONE, 0, 0, 0, 0, 0) }

export fn __mlx_soup_server_message_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &messagePrivate)
    m.putWord(class + 32, @intFromPtr(__mlx_soup_server_message_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_server_message_finalize))
    sigWroteInformational = plainSignal(class, "wrote-informational")
    sigWroteHeaders = plainSignal(class, "wrote-headers")
    sigWroteChunk = plainSignal(class, "wrote-chunk")
    sigWroteBodyData = c.signal(class, "wrote-body-data", c.RUN_LAST, 0, 0, c.T_NONE, 1, c.T_UINT, 0, 0, 0)
    sigWroteBody = plainSignal(class, "wrote-body")
    sigGotHeaders = plainSignal(class, "got-headers")
    sigGotChunk = c.signal(class, "got-chunk", c.RUN_FIRST, 0, 0, c.T_NONE, 1, g_bytes_get_type(), 0, 0, 0)
    sigGotBody = plainSignal(class, "got-body")
    sigFinished = plainSignal(class, "finished")
    sigConnected = plainSignal(class, "connected")
    sigDisconnected = plainSignal(class, "disconnected")
    sigAcceptCertificate = c.signal(class, "accept-certificate", c.RUN_LAST, 0, @intFromPtr(g.g_signal_accumulator_true_handled), c.T_BOOLEAN, 2, g_tls_certificate_get_type(), g_tls_certificate_flags_get_type(), 0, 0)
    _ = c.objectProperty(class, 1, "tls-peer-certificate", g_tls_certificate_get_type(), c.READABLE)
    _ = c.flagsProperty(class, 2, "tls-peer-certificate-errors", g_tls_certificate_flags_get_type(), 0, c.READABLE)
}

fn newMessage(cn: usize) -> usize {
    const msg = g.g_object_new(messageTypeGet(), 0)
    m.putWord(sm(msg) + SM_CONN, connRef(cn))
    return msg
}

export fn soup_server_message_get_request_headers(msg: usize) -> usize { return m.getWord(sm(msg) + SM_REQUEST_HEADERS) }
export fn soup_server_message_get_response_headers(msg: usize) -> usize { return m.getWord(sm(msg) + SM_RESPONSE_HEADERS) }
export fn soup_server_message_get_request_body(msg: usize) -> usize { return m.getWord(sm(msg) + SM_REQUEST_BODY) }
export fn soup_server_message_get_response_body(msg: usize) -> usize { return m.getWord(sm(msg) + SM_RESPONSE_BODY) }
export fn soup_server_message_get_method(msg: usize) -> usize { return m.getWord(sm(msg) + SM_METHOD) }
export fn soup_server_message_get_http_version(msg: usize) -> i32 { return m.getI32(sm(msg) + SM_VERSION) }

export fn soup_server_message_set_http_version(msg: usize, version: i32) -> void {
    const r = sm(msg)
    m.putI32(r + SM_VERSION, version)
    if m.get32(r + SM_STATUS) == 0 { m.putI32(r + SM_ORIG_VERSION, version) }
}

export fn soup_server_message_get_reason_phrase(msg: usize) -> usize { return m.getWord(sm(msg) + SM_REASON) }
export fn soup_server_message_get_status(msg: usize) -> u32 { return m.get32(sm(msg) + SM_STATUS) }

export fn soup_server_message_set_status(msg: usize, code: u32, reason: usize) -> void {
    const r = sm(msg)
    g_free(m.getWord(r + SM_REASON))
    m.put32(r + SM_STATUS, code)
    m.putWord(r + SM_REASON, g_strdup(if reason != 0 { reason } else { soup_status_get_phrase(code) }))
}

export fn soup_server_message_get_uri(msg: usize) -> usize { return m.getWord(sm(msg) + SM_URI) }

fn setUri(msg: usize, u: usize) -> void {
    const r = sm(msg)
    if m.getWord(r + SM_URI) != 0 { g.g_uri_unref(m.getWord(r + SM_URI)) }
    m.putWord(r + SM_URI, misc.normalized(u))
}

export fn soup_server_message_set_response(msg: usize, contentType: usize, use: i32, body: usize, length: usize) -> void {
    const r = sm(msg)
    if contentType != 0 {
        soup_message_headers_replace(m.getWord(r + SM_RESPONSE_HEADERS), m.literal("Content-Type"), contentType)
        soup_message_body_append(m.getWord(r + SM_RESPONSE_BODY), use, body, length)
    } else {
        soup_message_headers_remove(m.getWord(r + SM_RESPONSE_HEADERS), m.literal("Content-Type"))
        soup_message_body_truncate(m.getWord(r + SM_RESPONSE_BODY))
    }
}

export fn soup_server_message_set_redirect(msg: usize, code: u32, target: usize) -> void {
    const location = g_uri_parse_relative(soup_server_message_get_uri(msg), target, HTTP_URI_FLAGS, 0)
    soup_server_message_set_status(msg, code, 0)
    const text = g.g_uri_to_string(location)
    soup_message_headers_replace(m.getWord(sm(msg) + SM_RESPONSE_HEADERS), m.literal("Location"), text)
    g_free(text)
    g.g_uri_unref(location)
}

export fn soup_server_message_get_socket(msg: usize) -> usize {
    const cn = m.getWord(sm(msg) + SM_CONN)
    return if cn == 0 { 0 } else { m.getWord(cn + C_SOCKET) }
}

export fn soup_server_message_get_remote_address(msg: usize) -> usize {
    const cn = m.getWord(sm(msg) + SM_CONN)
    return if cn == 0 { 0 } else { connAddress(cn, true) }
}

export fn soup_server_message_get_local_address(msg: usize) -> usize {
    const cn = m.getWord(sm(msg) + SM_CONN)
    return if cn == 0 { 0 } else { connAddress(cn, false) }
}

export fn soup_server_message_get_remote_host(msg: usize) -> usize {
    const r = sm(msg)
    if m.getWord(r + SM_REMOTE_IP) == 0 {
        const address = soup_server_message_get_remote_address(msg)
        if address == 0 || g_type_check_instance_is_a(address, g_inet_socket_address_get_type()) == 0 { return 0 }
        m.putWord(r + SM_REMOTE_IP, g_inet_address_to_string(g_inet_socket_address_get_address(address)))
    }
    return m.getWord(r + SM_REMOTE_IP)
}

export fn soup_server_message_is_options_ping(msg: usize) -> i32 { return m.getI32(sm(msg) + SM_OPTIONS_PING) }
export fn soup_server_message_get_tls_peer_certificate(msg: usize) -> usize { return m.getWord(sm(msg) + SM_TLS_CERTIFICATE) }
export fn soup_server_message_get_tls_peer_certificate_errors(msg: usize) -> u32 { return m.get32(sm(msg) + SM_TLS_ERRORS) }

fn isKeepalive(msg: usize) -> bool {
    const r = sm(msg)
    const response = m.getWord(r + SM_RESPONSE_HEADERS)
    if m.get32(r + SM_STATUS) == 200 && m.cIs(m.getWord(r + SM_METHOD), "CONNECT") { return true }
    // A response to the end of the connection ends it.
    if soup_message_headers_get_encoding(response) == ENCODING_EOF { return false }
    if m.getI32(r + SM_VERSION) == HTTP_1_0 {
        // HTTP/1.0 connections persist only when the response says so.
        return soup_message_headers_header_contains(response, m.literal("Connection"), m.literal("Keep-Alive")) != 0
    }
    if soup_message_headers_header_contains(m.getWord(r + SM_REQUEST_HEADERS), m.literal("Connection"), m.literal("close")) != 0 { return false }
    if soup_message_headers_header_contains(response, m.literal("Connection"), m.literal("close")) != 0 { return false }
    return true
}

fn cleanupResponse(msg: usize) -> void {
    const r = sm(msg)
    soup_message_body_truncate(m.getWord(r + SM_RESPONSE_BODY))
    soup_message_headers_clear(m.getWord(r + SM_RESPONSE_HEADERS))
    soup_message_headers_set_encoding(m.getWord(r + SM_RESPONSE_HEADERS), ENCODING_CONTENT_LENGTH)
    m.put32(r + SM_STATUS, 0)
    g_free(m.getWord(r + SM_REASON))
    m.putWord(r + SM_REASON, 0)
    m.putI32(r + SM_VERSION, m.getI32(r + SM_ORIG_VERSION))
}

// For the auth domains: the user they accepted.
pub fn setAuth(msg: usize, domain: usize, user: usize) -> void {
    const r = sm(msg)
    c.clearObject(r + SM_AUTH_DOMAIN)
    m.putWord(r + SM_AUTH_DOMAIN, domain)
    g_free(m.getWord(r + SM_AUTH_USER))
    m.putWord(r + SM_AUTH_USER, user)
}

// ---------------------------------------------------------------------------
// Connections

const C_SERVER: usize = 0
const C_IOSTREAM: usize = 8
const C_SOCKET: usize = 16
const C_ISTREAM: usize = 24
const C_OSTREAM: usize = 32
const C_LOCAL: usize = 40
const C_REMOTE: usize = 48
const C_MSG: usize = 56
const C_IN: usize = 64
const C_IN_START: usize = 72
const C_IN_END: usize = 80
const C_IN_SIZE: usize = 88
const C_SOURCE: usize = 96
const C_CONNECTED: usize = 104
const C_IN_RUN: usize = 108
const C_READ: usize = 112
const C_WRITE: usize = 116
const C_RENC: usize = 120
const C_WENC: usize = 124
const C_RLENGTH: usize = 128
const C_WLENGTH: usize = 136
const C_OUT: usize = 144
const C_OUT_LEN: usize = 152
const C_OUT_SENT: usize = 160
const C_WOFFSET: usize = 168
const C_WCHUNK: usize = 176
const C_PAUSED: usize = 184
const C_COMPLETION: usize = 188
const C_UNPAUSE: usize = 192
const C_CHUNK_LEFT: usize = 200
const C_CHUNK_PHASE: usize = 208
const C_EOF: usize = 212
const C_REFS: usize = 216
const C_SIZE: usize = 224

// The request's chunked coding: a size line, its data, the line end after
// it, the trailers.
const CH_SIZE: i32 = 0
const CH_DATA: i32 = 1
const CH_DATA_END: i32 = 2
const CH_TRAILERS: i32 = 3
const CH_DONE: i32 = 4

fn connRef(cn: usize) -> usize {
    m.putWord(cn + C_REFS, m.getWord(cn + C_REFS) + 1)
    return cn
}

fn connUnref(cn: usize) -> void {
    const refs = m.getWord(cn + C_REFS) - 1
    m.putWord(cn + C_REFS, refs)
    if refs > 0 { return }
    dropSource(cn, C_SOURCE)
    dropSource(cn, C_UNPAUSE)
    c.clearObject(cn + C_IOSTREAM)
    c.clearObject(cn + C_SOCKET)
    c.clearObject(cn + C_LOCAL)
    c.clearObject(cn + C_REMOTE)
    m.release(m.getWord(cn + C_IN))
    m.release(m.getWord(cn + C_OUT))
    if m.getWord(cn + C_WCHUNK) != 0 { g_bytes_unref(m.getWord(cn + C_WCHUNK)) }
    m.release(cn)
}

fn dropSource(cn: usize, at: usize) -> void {
    const source = m.getWord(cn + at)
    if source == 0 { return }
    g_source_destroy(source)
    g.g_source_unref(source)
    m.putWord(cn + at, 0)
}

fn connAddress(cn: usize, remote: bool) -> usize {
    const at = if remote { C_REMOTE } else { C_LOCAL }
    if m.getWord(cn + at) == 0 {
        const stream = m.getWord(cn + C_IOSTREAM)
        if stream != 0 && g_type_check_instance_is_a(stream, g_socket_connection_get_type()) != 0 {
            m.putWord(cn + at, if remote { g_socket_connection_get_remote_address(stream, 0) } else { g_socket_connection_get_local_address(stream, 0) })
        }
    }
    return m.getWord(cn + at)
}

fn newConnection(server: usize, stream: usize, local: usize, remote: usize) -> usize {
    const cn = m.alloc(C_SIZE)
    m.putWord(cn + C_REFS, 1)
    m.putWord(cn + C_SERVER, server)
    m.putWord(cn + C_IOSTREAM, g.g_object_ref(stream))
    if g_type_check_instance_is_a(stream, g_socket_connection_get_type()) != 0 { m.putWord(cn + C_SOCKET, g.g_object_ref(g_socket_connection_get_socket(stream))) }
    m.putWord(cn + C_ISTREAM, g_io_stream_get_input_stream(stream))
    m.putWord(cn + C_OSTREAM, g_io_stream_get_output_stream(stream))
    if local != 0 { m.putWord(cn + C_LOCAL, g.g_object_ref(local)) }
    if remote != 0 { m.putWord(cn + C_REMOTE, g.g_object_ref(remote)) }
    m.putI32(cn + C_CONNECTED, 1)
    return cn
}

fn isConnected(cn: usize) -> bool { return m.getI32(cn + C_CONNECTED) != 0 }

fn resetIo(cn: usize) -> void {
    m.putI32(cn + C_READ, HEADERS)
    m.putI32(cn + C_WRITE, NOT_STARTED)
    m.putI32(cn + C_RENC, 0)
    m.putI32(cn + C_WENC, 0)
    m.putI64(cn + C_RLENGTH, 0)
    m.putI64(cn + C_WLENGTH, 0)
    m.putWord(cn + C_OUT_LEN, 0)
    m.putWord(cn + C_OUT_SENT, 0)
    m.putWord(cn + C_WOFFSET, 0)
    if m.getWord(cn + C_WCHUNK) != 0 {
        g_bytes_unref(m.getWord(cn + C_WCHUNK))
        m.putWord(cn + C_WCHUNK, 0)
    }
    m.putI32(cn + C_PAUSED, 0)
    m.putI32(cn + C_COMPLETION, 0)
    m.putWord(cn + C_CHUNK_LEFT, 0)
    m.putI32(cn + C_CHUNK_PHASE, CH_SIZE)
    dropSource(cn, C_UNPAUSE)
}

// The message the connection's I/O is for (0: none).
fn currentMsg(cn: usize) -> usize { return m.getWord(cn + C_MSG) }

fn disconnect(cn: usize) -> void {
    if !isConnected(cn) { return }
    m.putI32(cn + C_CONNECTED, 0)
    dropSource(cn, C_SOURCE)
    dropSource(cn, C_UNPAUSE)
    _ = connRef(cn)
    const stream = m.getWord(cn + C_IOSTREAM)
    if stream != 0 { _ = g_io_stream_close(stream, 0, 0) }
    const msg = currentMsg(cn)
    m.putWord(cn + C_MSG, 0)
    if msg != 0 {
        m.putI32(sm(msg) + SM_IO, 0)
        c.emitPlain(msg, sigDisconnected)
        g.g_object_unref(msg)
    }
    const server = m.getWord(cn + C_SERVER)
    if server != 0 { clientGone(server, cn) }
    connUnref(cn)
}

// ---------------------------------------------------------------------------
// Reading

fn ioError(err: usize, code: i32, text: []const u8) -> bool {
    c.setError(err, g.g_io_error_quark(), code, text)
    return false
}

fn buffered(cn: usize) -> usize { return m.getWord(cn + C_IN_END) - m.getWord(cn + C_IN_START) }
fn bufferStart(cn: usize) -> usize { return m.getWord(cn + C_IN) + m.getWord(cn + C_IN_START) }

fn consume(cn: usize, count: usize) -> void {
    m.putWord(cn + C_IN_START, m.getWord(cn + C_IN_START) + count)
    if m.getWord(cn + C_IN_START) == m.getWord(cn + C_IN_END) {
        m.putWord(cn + C_IN_START, 0)
        m.putWord(cn + C_IN_END, 0)
    }
}

// Reads what the connection has into the buffer: >0 bytes, 0 at the end,
// -1 at an error (in `err`), -2 when it would block.
fn fill(cn: usize, err: usize) -> i64 {
    var start = m.getWord(cn + C_IN_START)
    var end = m.getWord(cn + C_IN_END)
    const buffer = m.getWord(cn + C_IN)
    if start > 0 {
        m.copy(buffer, buffer + start, end - start)
        end -= start
        start = 0
        m.putWord(cn + C_IN_START, 0)
        m.putWord(cn + C_IN_END, end)
    }
    if m.getWord(cn + C_IN_SIZE) < end + RESPONSE_BLOCK_SIZE {
        const size = end + RESPONSE_BLOCK_SIZE
        m.putWord(cn + C_IN, m.grow(buffer, size))
        m.putWord(cn + C_IN_SIZE, size)
    }
    const cell = m.alloc(8)
    const n = g_pollable_input_stream_read_nonblocking(m.getWord(cn + C_ISTREAM), m.getWord(cn + C_IN) + end, RESPONSE_BLOCK_SIZE, 0, cell)
    const e = m.getWord(cell)
    m.release(cell)
    if n < 0 {
        if g_error_matches(e, g.g_io_error_quark(), IO_WOULD_BLOCK) != 0 {
            g_error_free(e)
            return -2
        }
        if err != 0 { m.putWord(err, e) } else { g_error_free(e) }
        return -1
    }
    if n == 0 { m.putI32(cn + C_EOF, 1) }
    m.putWord(cn + C_IN_END, end + @intCast(usize, n))
    return n
}

// Where the headers' blank line ends in the buffer (0: not there yet).
fn headersEnd(cn: usize) -> usize {
    const data = bufferStart(cn)
    const length = buffered(cn)
    var at: usize = 0
    while at < length {
        if m.get8(data + at) == 10 {
            if at + 1 < length && m.get8(data + at + 1) == 10 { return at + 2 }
            if at + 2 < length && m.get8(data + at + 1) == 13 && m.get8(data + at + 2) == 10 { return at + 3 }
        }
        at += 1
    }
    return 0
}

fn isSsl(cn: usize) -> bool { return false }

fn localUri(cn: usize, path: usize) -> usize {
    const address = connAddress(cn, false)
    if address == 0 { return 0 }
    const ip = g_inet_address_to_string(g_inet_socket_address_get_address(address))
    var port: i32 = @intCast(i32, g_inet_socket_address_get_port(address))
    if port == 0 { port = -1 }
    const u = g_uri_build(HTTP_URI_FLAGS, m.literal(if isSsl(cn) { "https" } else { "http" }), 0, ip, port, path, 0, 0)
    g_free(ip)
    return u
}

fn parseConnectAuthority(path: usize) -> usize {
    var t = m.text()
    m.pushText(&t, "http://")
    m.pushC(&t, path)
    const text = m.finish(&t)
    const u = g_uri_parse(text, HTTP_URI_FLAGS, 0)
    m.release(text)
    if u == 0 { return 0 }
    if g_uri_get_user(u) != 0 || g_uri_get_password(u) != 0 || g.g_uri_get_query(u) != 0 || g_uri_get_fragment(u) != 0 || g.g_uri_get_host(u) == 0 || g.g_uri_get_port(u) <= 0 || !m.cIs(g.g_uri_get_path(u), "/") {
        g.g_uri_unref(u)
        return 0
    }
    return u
}

fn uriFrom(cn: usize, prefix: []const u8, host: usize, path: usize) -> usize {
    var t = m.text()
    m.pushText(&t, prefix)
    m.pushC(&t, host)
    m.pushC(&t, path)
    const text = m.finish(&t)
    const u = g_uri_parse(text, HTTP_URI_FLAGS, 0)
    m.release(text)
    return u
}

// The request line and headers: the status to answer with (200 when they
// are good).
fn parseRequest(cn: usize, msg: usize, text: usize, length: usize) -> u32 {
    const r = sm(msg)
    const hdrs = m.getWord(r + SM_REQUEST_HEADERS)
    const cells = m.alloc(24)
    const status = soup_headers_parse_request(text, @intCast(i32, length), hdrs, cells, cells + 8, cells + 16)
    if status < 200 || status >= 300 {
        m.release(cells)
        return status
    }
    const method = m.getWord(cells)
    const path = m.getWord(cells + 8)
    m.putWord(r + SM_METHOD, g_intern_string(method))
    soup_server_message_set_http_version(msg, m.getI32(cells + 16))
    g_free(method)
    m.release(cells)
    const encoding = soup_message_headers_get_encoding(hdrs)
    m.putI32(cn + C_RENC, encoding)
    if encoding == ENCODING_UNRECOGNIZED {
        g_free(path)
        return if soup_message_headers_get_list(hdrs, m.literal("Transfer-Encoding")) != 0 { 501 } else { 400 }
    }
    // A request with both Content-Length and chunked coding is read as
    // chunked, and its connection not kept.
    if encoding == ENCODING_CHUNKED && soup_message_headers_get_one(hdrs, m.literal("Content-Length")) != 0 {
        soup_message_headers_replace(hdrs, m.literal("Connection"), m.literal("close"))
    }
    const host = soup_message_headers_get_one(hdrs, m.literal("Host"))
    if host != 0 && m.cSlice(host).length > 0 {
        for ch in m.cSlice(host) {
            if ch == 47 {
                g_free(path)
                return 400
            }
        }
    }
    var u: usize = 0
    const scheme: []const u8 = if isSsl(cn) { "https://" } else { "http://" }
    if m.cIs(path, "*") && host != 0 {
        u = uriFrom(cn, scheme, host, m.literal("/"))
        m.putI32(r + SM_OPTIONS_PING, 1)
    } else if m.cIs(m.getWord(r + SM_METHOD), "CONNECT") {
        u = parseConnectAuthority(path)
    } else if m.get8(path) != 47 {
        u = g_uri_parse(path, HTTP_URI_FLAGS, 0)
    } else if host != 0 {
        u = uriFrom(cn, scheme, host, path)
    } else if m.getI32(r + SM_VERSION) == HTTP_1_0 {
        u = localUri(cn, path)
    }
    g_free(path)
    if u == 0 || g.g_uri_get_host(u) == 0 {
        if u != 0 { g.g_uri_unref(u) }
        return 400
    }
    setUri(msg, u)
    g.g_uri_unref(u)
    return 200
}

// The connection's first bytes of a request the server has not been told
// of: it is now (a request after the first on the connection).
fn maybeStarted(cn: usize, msg: usize) -> void {
    if m.getI32(cn + C_COMPLETION) != 0 || m.getWord(sm(msg) + SM_METHOD) != 0 || buffered(cn) == 0 { return }
    requestStarted(m.getWord(cn + C_SERVER), msg)
    readRequest(cn)
}

// Reads up to `count` bytes of the request body: >0, 0 at its end, -1 at
// an error, -2 when it would block.
fn readBody(cn: usize, out: usize, count: usize, err: usize) -> i64 {
    const encoding = m.getI32(cn + C_RENC)
    if encoding == ENCODING_NONE { return 0 }
    if encoding == ENCODING_CONTENT_LENGTH {
        const left = m.getI64(cn + C_RLENGTH)
        if left <= 0 { return 0 }
        if buffered(cn) == 0 {
            const n = fill(cn, err)
            if n == 0 {
                c.setError(err, g.g_io_error_quark(), IO_PARTIAL_INPUT, "Connection terminated unexpectedly")
                return -1
            }
            if n < 0 { return n }
        }
        var take = buffered(cn)
        if @intCast(i64, take) > left { take = @intCast(usize, left) }
        if take > count { take = count }
        m.copy(out, bufferStart(cn), take)
        consume(cn, take)
        m.putI64(cn + C_RLENGTH, left - @intCast(i64, take))
        return @intCast(i64, take)
    }
    if encoding == ENCODING_CHUNKED { return readChunked(cn, out, count, err) }
    // To the end of the connection.
    if buffered(cn) == 0 {
        const n = fill(cn, err)
        if n <= 0 { return n }
    }
    var take = buffered(cn)
    if take > count { take = count }
    m.copy(out, bufferStart(cn), take)
    consume(cn, take)
    return @intCast(i64, take)
}

// A line from the buffer (its length with the line end in `taken`), or
// false when there is no whole line yet; -1 failed, -2 would block in
// `status`.
fn line(cn: usize, text: *[]const u8, taken: *usize, status: *i64, err: usize) -> bool {
    while true {
        const data = bufferStart(cn)
        const length = buffered(cn)
        var at: usize = 0
        while at < length {
            if m.get8(data + at) == 10 {
                var end = at
                if end > 0 && m.get8(data + end - 1) == 13 { end -= 1 }
                text.* = m.bytes(data, end)
                taken.* = at + 1
                return true
            }
            at += 1
        }
        const n = fill(cn, err)
        if n == 0 {
            c.setError(err, g.g_io_error_quark(), IO_PARTIAL_INPUT, "Connection terminated unexpectedly")
            status.* = -1
            return false
        }
        if n < 0 {
            status.* = n
            return false
        }
    }
    return false
}

fn readChunked(cn: usize, out: usize, count: usize, err: usize) -> i64 {
    while true {
        const phase = m.getI32(cn + C_CHUNK_PHASE)
        if phase == CH_DONE { return 0 }
        if phase == CH_DATA {
            const left = m.getWord(cn + C_CHUNK_LEFT)
            if buffered(cn) == 0 {
                const n = fill(cn, err)
                if n == 0 {
                    c.setError(err, g.g_io_error_quark(), IO_PARTIAL_INPUT, "Connection terminated unexpectedly")
                    return -1
                }
                if n < 0 { return n }
            }
            var take = buffered(cn)
            if take > left { take = left }
            if take > count { take = count }
            m.copy(out, bufferStart(cn), take)
            consume(cn, take)
            m.putWord(cn + C_CHUNK_LEFT, left - take)
            if left - take == 0 { m.putI32(cn + C_CHUNK_PHASE, CH_DATA_END) }
            return @intCast(i64, take)
        }
        var text: []const u8 = m.bytes(0, 0)
        var taken: usize = 0
        var status: i64 = 0
        if !line(cn, &text, &taken, &status, err) { return status }
        if phase == CH_SIZE {
            const size = chunked.chunkSize(text)
            consume(cn, taken)
            if size == 0 {
                m.putI32(cn + C_CHUNK_PHASE, CH_TRAILERS)
            } else {
                m.putWord(cn + C_CHUNK_LEFT, @intCast(usize, size))
                m.putI32(cn + C_CHUNK_PHASE, CH_DATA)
            }
        } else if phase == CH_DATA_END {
            consume(cn, taken)
            m.putI32(cn + C_CHUNK_PHASE, CH_SIZE)
        } else {
            consume(cn, taken)
            if text.length == 0 { m.putI32(cn + C_CHUNK_PHASE, CH_DONE) }
        }
    }
    return 0
}

fn ioRead(cn: usize, err: usize) -> bool {
    const msg = currentMsg(cn)
    const r = sm(msg)
    const state = m.getI32(cn + C_READ)
    if state == HEADERS {
        var end = headersEnd(cn)
        while end == 0 {
            if buffered(cn) > HEADER_SIZE_LIMIT {
                soup_server_message_set_status(msg, 400, 0)
                return ioError(err, IO_PARTIAL_INPUT, "Header too big")
            }
            const n = fill(cn, err)
            if n == 0 {
                soup_server_message_set_status(msg, 400, 0)
                return ioError(err, IO_PARTIAL_INPUT, "Connection terminated unexpectedly")
            }
            if n == -2 {
                maybeStarted(cn, msg)
                return ioError(err, IO_WOULD_BLOCK, "Operation would block")
            }
            if n < 0 { return false }
            maybeStarted(cn, msg)
            end = headersEnd(cn)
        }
        maybeStarted(cn, msg)
        const status = parseRequest(cn, msg, bufferStart(cn), end)
        consume(cn, end)
        const hdrs = m.getWord(r + SM_REQUEST_HEADERS)
        if status != 200 {
            soup_server_message_set_status(msg, status, 0)
            soup_message_headers_append(hdrs, m.literal("Connection"), m.literal("close"))
            m.putI32(cn + C_READ, FINISHING)
            return true
        }
        if (soup_message_headers_get_expectations(hdrs) & 2) != 0 {
            // "Expect: 100-continue": an answer before the body.
            m.putI32(cn + C_WRITE, HEADERS)
            m.putI32(cn + C_READ, BLOCKING)
        } else {
            m.putI32(cn + C_READ, BODY_START)
        }
        m.putI64(cn + C_RLENGTH, if m.getI32(cn + C_RENC) == ENCODING_CONTENT_LENGTH { soup_message_headers_get_content_length(hdrs) } else { -1 })
        m.putI32(cn + C_CHUNK_PHASE, CH_SIZE)
        c.emitPlain(msg, sigGotHeaders)
        return true
    }
    if state == BODY_START {
        m.putI32(cn + C_READ, BODY)
        return true
    }
    if state == BODY {
        const buffer = m.raw(RESPONSE_BLOCK_SIZE)
        const cell = m.alloc(8)
        const n = readBody(cn, buffer, RESPONSE_BLOCK_SIZE, cell)
        if n > 0 {
            const bytes = g_bytes_new(buffer, @intCast(usize, n))
            m.release(buffer)
            m.release(cell)
            soup_message_body_got_chunk(m.getWord(r + SM_REQUEST_BODY), bytes)
            c.emitOne(msg, sigGotChunk, g_bytes_get_type(), bytes)
            g_bytes_unref(bytes)
            return true
        }
        m.release(buffer)
        if n == -2 {
            m.release(cell)
            return ioError(err, IO_WOULD_BLOCK, "Operation would block")
        }
        if n < 0 {
            const e = m.getWord(cell)
            m.release(cell)
            if e != 0 && (g_error_matches(e, g.g_io_error_quark(), IO_INVALID_ARGUMENT) != 0 || g_error_matches(e, g.g_io_error_quark(), IO_PARTIAL_INPUT) != 0) {
                soup_server_message_set_status(msg, 400, 0)
            } else if e != 0 && g_error_matches(e, g.g_io_error_quark(), IO_MESSAGE_TOO_LARGE) != 0 {
                soup_server_message_set_status(msg, 413, 0)
            } else {
                if err != 0 { m.putWord(err, e) } else if e != 0 { g_error_free(e) }
                return false
            }
            g_error_free(e)
            soup_message_headers_append(m.getWord(r + SM_REQUEST_HEADERS), m.literal("Connection"), m.literal("close"))
            m.putI32(cn + C_READ, FINISHING)
            return true
        }
        m.release(cell)
        m.putI32(cn + C_READ, BODY_DONE)
        return true
    }
    if state == BODY_DONE {
        m.putI32(cn + C_READ, FINISHING)
        const body = m.getWord(r + SM_REQUEST_BODY)
        if soup_message_body_get_accumulate(body) != 0 { g_bytes_unref(soup_message_body_flatten(body)) }
        c.emitPlain(msg, sigGotBody)
        return true
    }
    if state == FINISHING {
        m.putI32(cn + C_READ, DONE)
        m.putI32(cn + C_WRITE, HEADERS)
        return true
    }
    return false
}

// ---------------------------------------------------------------------------
// Writing

fn outAppend(cn: usize, data: usize, length: usize) -> void {
    const used = m.getWord(cn + C_OUT_LEN)
    m.putWord(cn + C_OUT, m.grow(m.getWord(cn + C_OUT), used + length + 1))
    m.copy(m.getWord(cn + C_OUT) + used, data, length)
    m.putWord(cn + C_OUT_LEN, used + length)
}

fn outText(cn: usize, text: []const u8) -> void { outAppend(cn, @intFromPtr(text.pointer), text.length) }

// Writes what is waiting: true when all of it went.
fn flushOut(cn: usize, err: usize) -> bool {
    while m.getWord(cn + C_OUT_SENT) < m.getWord(cn + C_OUT_LEN) {
        const sent = m.getWord(cn + C_OUT_SENT)
        const cell = m.alloc(8)
        const n = g_pollable_output_stream_write_nonblocking(m.getWord(cn + C_OSTREAM), m.getWord(cn + C_OUT) + sent, m.getWord(cn + C_OUT_LEN) - sent, 0, cell)
        const e = m.getWord(cell)
        m.release(cell)
        if n < 0 {
            if err != 0 { m.putWord(err, e) } else { g_error_free(e) }
            return false
        }
        m.putWord(cn + C_OUT_SENT, sent + @intCast(usize, n))
    }
    m.putWord(cn + C_OUT_LEN, 0)
    m.putWord(cn + C_OUT_SENT, 0)
    return true
}

fn writeHeaders(cn: usize, msg: usize) -> void {
    const r = sm(msg)
    if m.get32(r + SM_STATUS) == 0 { soup_server_message_set_status(msg, 500, 0) }
    const status = m.get32(r + SM_STATUS)
    var t = m.text()
    m.pushText(&t, if m.getI32(r + SM_VERSION) == HTTP_1_0 { "HTTP/1.0 " } else { "HTTP/1.1 " })
    m.pushDecimal(&t, @intCast(u64, status))
    m.pushByte(&t, 32)
    if m.getWord(r + SM_REASON) != 0 { m.pushC(&t, m.getWord(r + SM_REASON)) }
    m.pushText(&t, "\r\n")
    const hdrs = m.getWord(r + SM_RESPONSE_HEADERS)
    const claimed = soup_message_headers_get_encoding(hdrs)
    const method = m.getWord(r + SM_METHOD)
    const informational = status >= 100 && status < 200
    var encoding = claimed
    if (method != 0 && m.cIs(method, "HEAD")) || status == 204 || status == 304 || informational || (method != 0 && m.cIs(method, "CONNECT") && status >= 200 && status < 300) { encoding = ENCODING_NONE }
    m.putI32(cn + C_WENC, encoding)
    // No Content-Length on what has no body by RFC 7230; else the body's.
    if status == 204 || informational {
        soup_message_headers_remove(hdrs, m.literal("Content-Length"))
    } else if claimed == ENCODING_CONTENT_LENGTH && soup_message_headers_get_content_length(hdrs) == 0 {
        soup_message_headers_set_content_length(hdrs, @intCast(i64, bodyLength(m.getWord(r + SM_RESPONSE_BODY))))
    }
    const iter = m.alloc(32)
    const cells = m.alloc(16)
    soup_message_headers_iter_init(iter, hdrs)
    while soup_message_headers_iter_next(iter, cells, cells + 8) != 0 {
        m.pushC(&t, m.getWord(cells))
        m.pushText(&t, ": ")
        m.pushC(&t, m.getWord(cells + 8))
        m.pushText(&t, "\r\n")
    }
    m.release(cells)
    m.release(iter)
    m.pushText(&t, "\r\n")
    outAppend(cn, t.address, t.length)
    m.dispose(&t)
}

// SoupMessageBody's length (its public field).
fn bodyLength(body: usize) -> u64 { return m.get64(body + 8) }

fn ioWrite(cn: usize, err: usize) -> bool {
    const msg = currentMsg(cn)
    const r = sm(msg)
    const state = m.getI32(cn + C_WRITE)
    if state == HEADERS {
        if m.getI32(cn + C_READ) == BLOCKING && m.get32(r + SM_STATUS) == 0 {
            // The client asked for "100 Continue" and no handler answered
            // otherwise.
            soup_server_message_set_status(msg, 100, 0)
        }
        if m.getWord(cn + C_OUT_LEN) == 0 { writeHeaders(cn, msg) }
        if !flushOut(cn, err) { return false }
        const status = m.get32(r + SM_STATUS)
        if status >= 100 && status < 200 {
            if status == 100 {
                // The body is read now.
                m.putI32(cn + C_WRITE, BLOCKING)
                m.putI32(cn + C_READ, BODY_START)
            }
            c.emitPlain(msg, sigWroteInformational)
            // A "101 Switching Protocols" may have taken the connection.
            if currentMsg(cn) != msg || m.getI32(sm(msg) + SM_IO) == 0 { return false }
            cleanupResponse(msg)
            return true
        }
        if m.getI32(cn + C_WENC) == ENCODING_CONTENT_LENGTH { m.putI64(cn + C_WLENGTH, soup_message_headers_get_content_length(m.getWord(r + SM_RESPONSE_HEADERS))) }
        m.putI32(cn + C_WRITE, BODY_START)
        // A client that waited for "100 Continue" and got an answer: its
        // body is not read.
        if m.getI32(cn + C_READ) == BLOCKING { m.putI32(cn + C_READ, DONE) }
        c.emitPlain(msg, sigWroteHeaders)
        return true
    }
    if state == BODY_START {
        m.putI32(cn + C_WRITE, BODY)
        return true
    }
    const encoding = m.getI32(cn + C_WENC)
    if state == BODY {
        if m.getI64(cn + C_WLENGTH) == 0 && encoding != ENCODING_EOF && encoding != ENCODING_CHUNKED {
            m.putI32(cn + C_WRITE, BODY_FLUSH)
            return true
        }
        if m.getWord(cn + C_WCHUNK) == 0 {
            const chunk = soup_message_body_get_chunk(m.getWord(r + SM_RESPONSE_BODY), @intCast(i64, m.getWord(cn + C_WOFFSET)))
            if chunk == 0 {
                // More of the body later: the handler unpauses it.
                soup_server_message_pause(msg)
                return false
            }
            m.putWord(cn + C_WCHUNK, chunk)
            if g_bytes_get_size(chunk) == 0 {
                m.putI32(cn + C_WRITE, BODY_FLUSH)
                return true
            }
            const sizeCell = m.alloc(8)
            const data = g_bytes_get_data(chunk, sizeCell)
            var length = m.getWord(sizeCell)
            m.release(sizeCell)
            // A Content-Length body takes no more than it said.
            if encoding == ENCODING_CONTENT_LENGTH && @intCast(i64, length) > m.getI64(cn + C_WLENGTH) { length = @intCast(usize, m.getI64(cn + C_WLENGTH)) }
            if encoding == ENCODING_CHUNKED {
                var t = m.text()
                chunked.writeSizeLine(c.sinkOf(&t), @intCast(u64, length))
                outAppend(cn, t.address, t.length)
                m.dispose(&t)
            }
            outAppend(cn, data, length)
            if encoding == ENCODING_CHUNKED { outText(cn, "\r\n") }
            if encoding == ENCODING_CONTENT_LENGTH { m.putI64(cn + C_WLENGTH, m.getI64(cn + C_WLENGTH) - @intCast(i64, length)) }
        }
        if !flushOut(cn, err) { return false }
        m.putI32(cn + C_WRITE, BODY_DATA)
        var ts: [1]usize = [1]usize{ c.T_UINT }
        var args: [1]usize = [1]usize{ g_bytes_get_size(m.getWord(cn + C_WCHUNK)) }
        c.emit(msg, sigWroteBodyData, 1, ts[0..1], args[0..1], 0)
        return true
    }
    if state == BODY_DATA {
        const chunk = m.getWord(cn + C_WCHUNK)
        if g_bytes_get_size(chunk) == 0 {
            m.putI32(cn + C_WRITE, BODY_FLUSH)
            return true
        }
        soup_message_body_wrote_chunk(m.getWord(r + SM_RESPONSE_BODY), chunk)
        m.putWord(cn + C_WOFFSET, m.getWord(cn + C_WOFFSET) + g_bytes_get_size(chunk))
        g_bytes_unref(chunk)
        m.putWord(cn + C_WCHUNK, 0)
        m.putI32(cn + C_WRITE, BODY)
        c.emitPlain(msg, sigWroteChunk)
        return true
    }
    if state == BODY_FLUSH {
        if encoding == ENCODING_CHUNKED {
            if m.getWord(cn + C_OUT_LEN) == 0 { outText(cn, "0\r\n\r\n") }
            if !flushOut(cn, err) { return false }
        }
        m.putI32(cn + C_WRITE, BODY_DONE)
        return true
    }
    if state == BODY_DONE {
        m.putI32(cn + C_WRITE, FINISHING)
        c.emitPlain(msg, sigWroteBody)
        return true
    }
    if state == FINISHING {
        m.putI32(cn + C_WRITE, DONE)
        return true
    }
    return false
}

// ---------------------------------------------------------------------------
// Running the I/O

fn active(state: i32) -> bool { return state != NOT_STARTED && state != BLOCKING && state != DONE }

fn isWouldBlock(e: usize) -> bool { return e != 0 && g_error_matches(e, g.g_io_error_quark(), IO_WOULD_BLOCK) != 0 }

// Runs the I/O as far as it goes: 1 when the message is done, 0 when it
// waits, -1 at an error (in `err`), -2 when the message is not the
// connection's any more.
fn runUntilDone(cn: usize, msg: usize, err: usize) -> i32 {
    while true {
        if currentMsg(cn) != msg || m.getI32(sm(msg) + SM_IO) == 0 { return -2 }
        if m.getI32(cn + C_PAUSED) != 0 { return 0 }
        const readState = m.getI32(cn + C_READ)
        const writeState = m.getI32(cn + C_WRITE)
        if readState >= DONE && writeState >= DONE { return 1 }
        var progress = false
        const cell = m.alloc(8)
        if active(readState) {
            progress = ioRead(cn, cell)
        } else if active(writeState) {
            progress = ioWrite(cn, cell)
        }
        const e = m.getWord(cell)
        m.release(cell)
        if currentMsg(cn) != msg || m.getI32(sm(msg) + SM_IO) == 0 {
            if e != 0 { g_error_free(e) }
            return -2
        }
        if !progress {
            if e == 0 || isWouldBlock(e) {
                if e != 0 { g_error_free(e) }
                return 0
            }
            if err != 0 { m.putWord(err, e) } else { g_error_free(e) }
            return -1
        }
    }
    return 0
}

export fn __mlx_soup_server_io_ready(object: usize, cn: usize) -> i32 {
    m.putWord(cn + C_SOURCE, 0)
    ioRun(cn)
    return 0
}

export fn __mlx_soup_server_io_ready_timeout(cn: usize) -> i32 {
    m.putWord(cn + C_SOURCE, 0)
    ioRun(cn)
    return 0
}

// Waits for the connection to be readable or writable as the I/O needs.
fn attachSource(cn: usize) -> void {
    dropSource(cn, C_SOURCE)
    if m.getI32(cn + C_PAUSED) != 0 { return }
    var source: usize = 0
    if active(m.getI32(cn + C_READ)) && buffered(cn) == 0 && m.getI32(cn + C_EOF) == 0 {
        source = g.g_pollable_input_stream_create_source(m.getWord(cn + C_ISTREAM), 0)
        g_source_set_callback(source, @intFromPtr(__mlx_soup_server_io_ready), cn, 0)
    } else if !active(m.getI32(cn + C_READ)) && active(m.getI32(cn + C_WRITE)) {
        source = g_pollable_output_stream_create_source(m.getWord(cn + C_OSTREAM), 0)
        g_source_set_callback(source, @intFromPtr(__mlx_soup_server_io_ready), cn, 0)
    } else {
        source = g.g_timeout_source_new(0)
        g_source_set_callback(source, @intFromPtr(__mlx_soup_server_io_ready_timeout), cn, 0)
    }
    m.putWord(cn + C_SOURCE, source)
    _ = g_source_attach(source, g_main_context_get_thread_default())
}

fn ioRun(cn: usize) -> void {
    if m.getI32(cn + C_IN_RUN) != 0 { return }
    const msg = currentMsg(cn)
    if msg == 0 { return }
    dropSource(cn, C_SOURCE)
    m.putI32(cn + C_IN_RUN, 1)
    _ = connRef(cn)
    _ = g.g_object_ref(msg)
    const cell = m.alloc(8)
    const result = runUntilDone(cn, msg, cell)
    m.putI32(cn + C_IN_RUN, 0)
    if result == 1 {
        finishIo(cn, msg)
    } else if result == 0 {
        if isConnected(cn) && currentMsg(cn) == msg { attachSource(cn) }
    } else if result == -1 {
        const e = m.getWord(cell)
        if currentMsg(cn) == msg {
            soup_server_message_set_status(msg, 500, if e != 0 { m.getWord(e + 8) } else { 0 })
            finishIo(cn, msg)
        }
        if e != 0 { g_error_free(e) }
    }
    m.release(cell)
    g.g_object_unref(msg)
    connUnref(cn)
}

// The message's I/O is over: the server is told, and a kept connection
// waits for its next request.
fn finishIo(cn: usize, msg: usize) -> void {
    if currentMsg(cn) != msg || m.getI32(sm(msg) + SM_IO) == 0 { return }
    const completion = if m.getI32(cn + C_READ) >= FINISHING && m.getI32(cn + C_WRITE) >= FINISHING { COMPLETE } else { INTERRUPTED }
    const told = m.getI32(cn + C_COMPLETION) != 0
    m.putI32(sm(msg) + SM_IO, 0)
    m.putWord(cn + C_MSG, 0)
    resetIo(cn)
    _ = connRef(cn)
    if told {
        requestFinished(m.getWord(cn + C_SERVER), msg, completion)
        if isConnected(cn) {
            const next = newMessage(cn)
            m.putWord(cn + C_MSG, next)
            m.putI32(sm(next) + SM_IO, 1)
            attachSource(cn)
        }
    } else {
        disconnect(cn)
    }
    g.g_object_unref(msg)
    connUnref(cn)
}

// The server reads the message's request now.
fn readRequest(cn: usize) -> void {
    m.putI32(cn + C_COMPLETION, 1)
    ioRun(cn)
}

export fn __mlx_soup_server_unpause(cn: usize) -> i32 {
    g.g_source_unref(m.getWord(cn + C_UNPAUSE))
    m.putWord(cn + C_UNPAUSE, 0)
    m.putI32(cn + C_PAUSED, 0)
    ioRun(cn)
    return 0
}

export fn soup_server_message_pause(msg: usize) -> void {
    const cn = m.getWord(sm(msg) + SM_CONN)
    if cn == 0 || m.getI32(sm(msg) + SM_IO) == 0 { return }
    dropSource(cn, C_UNPAUSE)
    m.putI32(cn + C_PAUSED, 1)
    dropSource(cn, C_SOURCE)
}

export fn soup_server_message_unpause(msg: usize) -> void {
    const cn = m.getWord(sm(msg) + SM_CONN)
    if cn == 0 || m.getI32(sm(msg) + SM_IO) == 0 { return }
    if m.getWord(cn + C_UNPAUSE) != 0 { return }
    const source = g_idle_source_new()
    g_source_set_callback(source, @intFromPtr(__mlx_soup_server_unpause), cn, 0)
    m.putWord(cn + C_UNPAUSE, source)
    _ = g_source_attach(source, g_main_context_get_thread_default())
}

export fn soup_server_message_steal_connection(msg: usize) -> usize {
    const cn = m.getWord(sm(msg) + SM_CONN)
    if cn == 0 { return 0 }
    _ = g.g_object_ref(msg)
    _ = connRef(cn)
    var stream: usize = 0
    if m.getI32(sm(msg) + SM_IO) != 0 && currentMsg(cn) == msg {
        stream = g.g_object_ref(m.getWord(cn + C_IOSTREAM))
        const told = m.getI32(cn + C_COMPLETION) != 0
        m.putI32(sm(msg) + SM_IO, 0)
        m.putWord(cn + C_MSG, 0)
        dropSource(cn, C_SOURCE)
        dropSource(cn, C_UNPAUSE)
        if told { requestFinished(m.getWord(cn + C_SERVER), msg, STOLEN) }
        // The message's reference the connection held.
        g.g_object_unref(msg)
    }
    // The connection is the stream's now: no longer the server's.
    const leftover = if buffered(cn) > 0 { g_bytes_new(bufferStart(cn), buffered(cn)) } else { 0 }
    m.putWord(cn + C_IN_START, 0)
    m.putWord(cn + C_IN_END, 0)
    _ = connAddress(cn, false)
    _ = connAddress(cn, true)
    m.putI32(cn + C_CONNECTED, 0)
    c.clearObject(cn + C_IOSTREAM)
    c.emitPlain(msg, sigDisconnected)
    const server = m.getWord(cn + C_SERVER)
    if server != 0 { clientGone(server, cn) }
    connUnref(cn)
    g.g_object_unref(msg)
    if leftover != 0 {
        // (Kept for the WebSocket connection made of the stream.)
        stealLeftover = leftover
    }
    return stream
}

// What a stolen connection had read past the request.
var stealLeftover: usize = 0

// ---------------------------------------------------------------------------
// SoupServer

const S_LISTENERS: usize = 0
const S_CLIENTS: usize = 8
const S_TLS_CERT: usize = 16
const S_TLS_DATABASE: usize = 24
const S_TLS_AUTH_MODE: usize = 32
const S_SERVER_HEADER: usize = 40
const S_RAW_PATHS: usize = 48
const S_HANDLERS: usize = 56
const S_AUTH_DOMAINS: usize = 64
const S_EXTENSIONS: usize = 72
const S_DISPOSED: usize = 80
const S_SIZE: usize = 88

// SoupServerClass: request_started (136), request_read (144),
// request_finished (152), request_aborted (160).
const CLASS_SIZE: usize = 216

// A handler: its path (0), early callback (8, destroy 16, data 24),
// callback (32, 40, 48), the WebSocket origin (56), protocols (64),
// extensions accepted (72), callback (80, 88, 96).
const H_PATH: usize = 0
const H_EARLY: usize = 8
const H_CALLBACK: usize = 32
const H_WS_ORIGIN: usize = 56
const H_WS_PROTOCOLS: usize = 64
const H_WS_EXTENSIONS: usize = 72
const H_WS_CALLBACK: usize = 80
const H_SIZE: usize = 104

// A listener: its GSocket (0), its source (8), its address (16), the
// server (24).
const L_SOCKET: usize = 0
const L_SOURCE: usize = 8
const L_ADDRESS: usize = 16
const L_SERVER: usize = 24
const L_SIZE: usize = 32

const SERVER_HEADER_BASE: []const u8 = "libsoup/3.4.4"

var serverType: usize = 0
var serverPrivate: i32 = 0
var serverSpecs: [6]usize = [6]usize{ 0, 0, 0, 0, 0, 0 }
var sigRequestStarted: u32 = 0
var sigRequestRead: u32 = 0
var sigRequestFinished: u32 = 0
var sigRequestAborted: u32 = 0

pub const NotifyFn = fn(usize) -> void
pub const CallbackFn = fn(usize, usize, usize, usize, usize) -> void

pub fn serverTypeGet() -> usize {
    if c.onceEnter(&serverType) {
        const t = c.defineType(c.T_OBJECT, "SoupServer", CLASS_SIZE, @intFromPtr(__mlx_soup_server_class_init), 24, @intFromPtr(__mlx_soup_server_init), 0)
        serverPrivate = c.addPrivate(t, 8)
        c.onceLeave(&serverType, t)
    }
    return serverType
}

export fn soup_server_get_type() -> usize { return serverTypeGet() }

fn srv(server: usize) -> usize { return m.getWord(c.privateAt(server, serverPrivate)) }

fn callNotify(f: usize, data: usize) -> void {
    if f == 0 { return }
    const call: NotifyFn = unsafe { @ptrFromInt(NotifyFn, f) }
    call(data)
}

export fn __mlx_soup_server_handler_free(handler: usize) -> void {
    g_free(m.getWord(handler + H_PATH))
    g_free(m.getWord(handler + H_WS_ORIGIN))
    g_strfreev(m.getWord(handler + H_WS_PROTOCOLS))
    g_list_free_full(m.getWord(handler + H_WS_EXTENSIONS), @intFromPtr(g.g_object_unref))
    callNotify(m.getWord(handler + H_EARLY + 8), m.getWord(handler + H_EARLY + 16))
    callNotify(m.getWord(handler + H_CALLBACK + 8), m.getWord(handler + H_CALLBACK + 16))
    callNotify(m.getWord(handler + H_WS_CALLBACK + 8), m.getWord(handler + H_WS_CALLBACK + 16))
    m.release(handler)
}

export fn __mlx_soup_server_init(server: usize, class: usize) -> void {
    const p = m.alloc(S_SIZE)
    m.putWord(c.privateAt(server, serverPrivate), p)
    m.putWord(p + S_HANDLERS, pathmap.new(@intFromPtr(__mlx_soup_server_handler_free)))
    const extensions = g_ptr_array_new_with_free_func(@intFromPtr(g_type_class_unref))
    // permessage-deflate from the start.
    g_ptr_array_add(extensions, g_type_class_ref(soup_websocket_extension_deflate_get_type()))
    m.putWord(p + S_EXTENSIONS, extensions)
}

export fn __mlx_soup_server_dispose(server: usize) -> void {
    m.putI32(srv(server) + S_DISPOSED, 1)
    soup_server_disconnect(server)
    c.chainUp(g.g_type_class_ref(serverTypeGet()), 40, server)
}

export fn __mlx_soup_server_finalize(server: usize) -> void {
    const p = srv(server)
    c.clearObject(p + S_TLS_CERT)
    c.clearObject(p + S_TLS_DATABASE)
    g_free(m.getWord(p + S_SERVER_HEADER))
    pathmap.free(m.getWord(p + S_HANDLERS))
    g_slist_free_full(m.getWord(p + S_AUTH_DOMAINS), @intFromPtr(g.g_object_unref))
    _ = g_ptr_array_free(m.getWord(p + S_EXTENSIONS), 1)
    m.release(p)
    c.chainUp(g.g_type_class_ref(serverTypeGet()), 48, server)
}

fn setServerHeader(p: usize, header: usize) -> void {
    g_free(m.getWord(p + S_SERVER_HEADER))
    if header == 0 {
        m.putWord(p + S_SERVER_HEADER, 0)
        return
    }
    const text = m.cSlice(header)
    var t = m.text()
    if text.length == 0 {
        m.pushText(&t, SERVER_HEADER_BASE)
    } else if text[text.length - 1] == 32 {
        m.pushText(&t, text)
        m.pushText(&t, SERVER_HEADER_BASE)
    } else {
        m.pushText(&t, text)
    }
    const made = m.finish(&t)
    m.putWord(p + S_SERVER_HEADER, g_strdup(made))
    m.release(made)
}

export fn __mlx_soup_server_set_property(server: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = srv(server)
    if id == 1 { soup_server_set_tls_certificate(server, g.g_value_get_object(value)) }
    if id == 2 { soup_server_set_tls_database(server, g.g_value_get_object(value)) }
    if id == 3 { soup_server_set_tls_auth_mode(server, g.g_value_get_enum(value)) }
    if id == 4 { m.putI32(p + S_RAW_PATHS, g.g_value_get_boolean(value)) }
    if id == 5 { setServerHeader(p, g.g_value_get_string(value)) }
}

export fn __mlx_soup_server_get_property(server: usize, id: u32, value: usize, pspec: usize) -> void {
    const p = srv(server)
    if id == 1 { g.g_value_set_object(value, m.getWord(p + S_TLS_CERT)) }
    if id == 2 { g.g_value_set_object(value, m.getWord(p + S_TLS_DATABASE)) }
    if id == 3 { g.g_value_set_enum(value, m.getI32(p + S_TLS_AUTH_MODE)) }
    if id == 4 { g.g_value_set_boolean(value, m.getI32(p + S_RAW_PATHS)) }
    if id == 5 { g.g_value_set_string(value, m.getWord(p + S_SERVER_HEADER)) }
}

export fn __mlx_soup_server_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &serverPrivate)
    m.putWord(class + 24, @intFromPtr(__mlx_soup_server_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_server_get_property))
    m.putWord(class + 40, @intFromPtr(__mlx_soup_server_dispose))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_server_finalize))
    sigRequestStarted = c.signal(class, "request-started", c.RUN_FIRST, 136, 0, c.T_NONE, 1, messageTypeGet(), 0, 0, 0)
    sigRequestRead = c.signal(class, "request-read", c.RUN_FIRST, 144, 0, c.T_NONE, 1, messageTypeGet(), 0, 0, 0)
    sigRequestFinished = c.signal(class, "request-finished", c.RUN_FIRST, 152, 0, c.T_NONE, 1, messageTypeGet(), 0, 0, 0)
    sigRequestAborted = c.signal(class, "request-aborted", c.RUN_FIRST, 160, 0, c.T_NONE, 1, messageTypeGet(), 0, 0, 0)
    serverSpecs[1] = c.objectProperty(class, 1, "tls-certificate", g_tls_certificate_get_type(), c.READWRITE | c.CONSTRUCT)
    serverSpecs[2] = c.objectProperty(class, 2, "tls-database", g_tls_database_get_type(), c.READWRITE | c.CONSTRUCT)
    serverSpecs[3] = c.enumProperty(class, 3, "tls-auth-mode", g_tls_authentication_mode_get_type(), 0, c.READWRITE | c.CONSTRUCT)
    serverSpecs[4] = c.booleanProperty(class, 4, "raw-paths", false, c.READWRITE | c.CONSTRUCT_ONLY)
    serverSpecs[5] = c.stringProperty(class, 5, "server-header", c.READWRITE | c.CONSTRUCT)
}

export fn soup_server_new(optname1: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ optname1, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    return g_object_new_valist(serverTypeGet(), optname1, list)
}

export fn soup_server_set_tls_certificate(server: usize, certificate: usize) -> void {
    const p = srv(server)
    if m.getWord(p + S_TLS_CERT) == certificate { return }
    c.replaceObject(p + S_TLS_CERT, certificate)
    g.g_object_notify_by_pspec(server, serverSpecs[1])
}

export fn soup_server_get_tls_certificate(server: usize) -> usize { return m.getWord(srv(server) + S_TLS_CERT) }

export fn soup_server_set_tls_database(server: usize, database: usize) -> void {
    const p = srv(server)
    if m.getWord(p + S_TLS_DATABASE) == database { return }
    c.replaceObject(p + S_TLS_DATABASE, database)
    g.g_object_notify_by_pspec(server, serverSpecs[2])
}

export fn soup_server_get_tls_database(server: usize) -> usize { return m.getWord(srv(server) + S_TLS_DATABASE) }

export fn soup_server_set_tls_auth_mode(server: usize, mode: i32) -> void {
    const p = srv(server)
    if m.getI32(p + S_TLS_AUTH_MODE) == mode { return }
    m.putI32(p + S_TLS_AUTH_MODE, mode)
    g.g_object_notify_by_pspec(server, serverSpecs[3])
}

export fn soup_server_get_tls_auth_mode(server: usize) -> i32 { return m.getI32(srv(server) + S_TLS_AUTH_MODE) }
export fn soup_server_is_https(server: usize) -> i32 { return if m.getWord(srv(server) + S_TLS_CERT) != 0 { 1 } else { 0 } }

export fn soup_server_get_listeners(server: usize) -> usize {
    var result: usize = 0
    var at = m.getWord(srv(server) + S_LISTENERS)
    while at != 0 {
        result = g_slist_prepend(result, m.getWord(m.getWord(at) + L_SOCKET))
        at = m.getWord(at + 8)
    }
    return result
}

// ---------------------------------------------------------------------------
// Handlers

fn msgPath(msg: usize) -> usize {
    // A GUri cannot hold "*".
    if soup_server_message_is_options_ping(msg) != 0 { return m.literal("*") }
    const path = g.g_uri_get_path(soup_server_message_get_uri(msg))
    if path == 0 || m.get8(path) == 0 { return m.literal("/") }
    return path
}

fn handlerFor(server: usize, msg: usize) -> usize { return pathmap.lookup(m.getWord(srv(server) + S_HANDLERS), msgPath(msg)) }

fn callHandler(server: usize, handler: usize, msg: usize, early: bool) -> void {
    const at = if early { H_EARLY } else { H_CALLBACK }
    const f = m.getWord(handler + at)
    if f == 0 { return }
    if soup_server_message_get_status(msg) != 0 { return }
    const query = g.g_uri_get_query(soup_server_message_get_uri(msg))
    const form = if query != 0 { soup_form_decode(query) } else { 0 }
    const call: CallbackFn = unsafe { @ptrFromInt(CallbackFn, f) }
    call(server, msg, msgPath(msg), form, m.getWord(handler + at + 16))
    if form != 0 { g_hash_table_unref(form) }
}

export fn __mlx_soup_server_got_headers(server: usize, msg: usize) -> void {
    const p = srv(server)
    const hdrs = soup_server_message_get_response_headers(msg)
    const now = g_date_time_new_now_utc()
    const date = soup_date_time_to_string(now, 1)
    soup_message_headers_replace(hdrs, m.literal("Date"), date)
    g_free(date)
    g_date_time_unref(now)
    if soup_server_message_get_status(msg) != 0 { return }
    const u = soup_server_message_get_uri(msg)
    if !misc.isHttp(u) {
        soup_server_message_set_status(msg, 400, 0)
        return
    }
    // Encoded paths are decoded unless "raw-paths"; one that would gain
    // ".." segments is refused.
    if m.getI32(p + S_RAW_PATHS) == 0 && (g.g_uri_get_flags(u) & 16) != 0 {
        const decoded = g_uri_unescape_string(g.g_uri_get_path(u), 0)
        if decoded == 0 || containsDotDot(m.cSlice(decoded)) {
            g_free(decoded)
            soup_server_message_set_status(msg, 400, 0)
            return
        }
        const copy = soup_uri_copy(u, 7, decoded, 0, 0, 0)
        setUri(msg, copy)
        g_free(decoded)
        g.g_uri_unref(copy)
    }
    var rejected = false
    var at = m.getWord(p + S_AUTH_DOMAINS)
    while at != 0 {
        const domain = m.getWord(at)
        if soup_auth_domain_covers(domain, msg) != 0 {
            const user = soup_auth_domain_accepts(domain, msg)
            if user != 0 {
                setAuth(msg, g.g_object_ref(domain), user)
                return
            }
            rejected = true
        }
        at = m.getWord(at + 8)
    }
    if rejected {
        at = m.getWord(p + S_AUTH_DOMAINS)
        while at != 0 {
            const domain = m.getWord(at)
            if soup_auth_domain_covers(domain, msg) != 0 { soup_auth_domain_challenge(domain, msg) }
            at = m.getWord(at + 8)
        }
        return
    }
    const handler = handlerFor(server, msg)
    if handler != 0 { callHandler(server, handler, msg, true) }
}

fn containsDotDot(text: []const u8) -> bool {
    var at: usize = 0
    while at + 4 <= text.length {
        if text[at] == 47 && text[at + 1] == 46 && text[at + 2] == 46 && text[at + 3] == 47 { return true }
        at += 1
    }
    return text.length >= 3 && text[text.length - 3] == 47 && text[text.length - 2] == 46 && text[text.length - 1] == 46
}

pub const WebsocketFn = fn(usize, usize, usize, usize, usize) -> void

export fn __mlx_soup_server_websocket_upgrade(server: usize, msg: usize) -> void {
    const u = soup_server_message_get_uri(msg)
    const handler = handlerFor(server, msg)
    if handler == 0 || m.getWord(handler + H_WS_CALLBACK) == 0 { return }
    _ = g.g_object_ref(msg)
    stealLeftover = 0
    const stream = soup_server_message_steal_connection(msg)
    const leftover = stealLeftover
    stealLeftover = 0
    const conn = soup_websocket_connection_new(stream, u, 2, soup_message_headers_get_one(soup_server_message_get_request_headers(msg), m.literal("Origin")), soup_message_headers_get_one(soup_server_message_get_response_headers(msg), m.literal("Sec-WebSocket-Protocol")), m.getWord(handler + H_WS_EXTENSIONS))
    m.putWord(handler + H_WS_EXTENSIONS, 0)
    if leftover != 0 {
        websocket.feedLeftover(conn, leftover)
        g_bytes_unref(leftover)
    }
    g.g_object_unref(stream)
    const call: WebsocketFn = unsafe { @ptrFromInt(WebsocketFn, m.getWord(handler + H_WS_CALLBACK)) }
    call(server, msg, g.g_uri_get_path(u), conn, m.getWord(handler + H_WS_CALLBACK + 16))
    g.g_object_unref(conn)
    g.g_object_unref(msg)
}

export fn __mlx_soup_server_got_body(server: usize, msg: usize) -> void {
    c.emitOne(server, sigRequestRead, messageTypeGet(), msg)
    if soup_server_message_get_status(msg) != 0 { return }
    const handler = handlerFor(server, msg)
    if handler == 0 {
        soup_server_message_set_status(msg, 404, 0)
        return
    }
    callHandler(server, handler, msg, false)
    if soup_server_message_get_status(msg) != 0 { return }
    if m.getWord(handler + H_WS_CALLBACK) != 0 {
        const p = srv(server)
        if soup_websocket_server_process_handshake(msg, m.getWord(handler + H_WS_ORIGIN), m.getWord(handler + H_WS_PROTOCOLS), m.getWord(p + S_EXTENSIONS), handler + H_WS_EXTENSIONS) != 0 {
            _ = g.g_signal_connect_data(msg, m.literal("wrote-informational"), @intFromPtr(__mlx_soup_server_websocket_upgrade), server, 0, 2)
        }
    }
}

// A request has begun: the server's handlers are connected to it.
fn requestStarted(server: usize, msg: usize) -> void {
    _ = g.g_signal_connect_data(msg, m.literal("got-headers"), @intFromPtr(__mlx_soup_server_got_headers), server, 0, 2)
    _ = g.g_signal_connect_data(msg, m.literal("got-body"), @intFromPtr(__mlx_soup_server_got_body), server, 0, 2)
    const header = m.getWord(srv(server) + S_SERVER_HEADER)
    if header != 0 { soup_message_headers_append(soup_server_message_get_response_headers(msg), m.literal("Server"), header) }
    c.emitOne(server, sigRequestStarted, messageTypeGet(), msg)
}

fn requestFinished(server: usize, msg: usize, completion: i32) -> void {
    if completion == STOLEN { return }
    const cn = m.getWord(sm(msg) + SM_CONN)
    // A message that really began is finished.
    if soup_server_message_get_method(msg) != 0 {
        c.emitPlain(msg, sigFinished)
        const failed = completion == INTERRUPTED || soup_server_message_get_status(msg) == 500
        c.emitOne(server, if failed { sigRequestAborted } else { sigRequestFinished }, messageTypeGet(), msg)
    }
    if completion == COMPLETE && isConnected(cn) && isKeepalive(msg) && m.getWord(srv(server) + S_LISTENERS) != 0 { return }
    disconnect(cn)
}

fn clientGone(server: usize, cn: usize) -> void {
    const p = srv(server)
    const before = m.getWord(p + S_CLIENTS)
    const after = g_slist_remove(before, cn)
    if after == before && !listHas(before, cn) { return }
    m.putWord(p + S_CLIENTS, after)
    connUnref(cn)
}

fn listHas(list: usize, data: usize) -> bool {
    var at = list
    while at != 0 {
        if m.getWord(at) == data { return true }
        at = m.getWord(at + 8)
    }
    return false
}

fn acceptConnection(server: usize, cn: usize) -> void {
    const p = srv(server)
    m.putWord(p + S_CLIENTS, g_slist_prepend(m.getWord(p + S_CLIENTS), connRef(cn)))
    resetIo(cn)
    const msg = newMessage(cn)
    m.putWord(cn + C_MSG, msg)
    // The first request is begun at once (libsoup makes it then, for a TLS
    // handshake's certificate).
    requestStarted(server, msg)
    m.putI32(sm(msg) + SM_IO, 1)
    c.emitPlain(msg, sigConnected)
    if currentMsg(cn) == msg { readRequest(cn) }
}

export fn soup_server_accept_iostream(server: usize, stream: usize, local: usize, remote: usize, err: usize) -> i32 {
    const cn = newConnection(server, stream, local, remote)
    acceptConnection(server, cn)
    connUnref(cn)
    return 1
}

export fn soup_server_disconnect(server: usize) -> void {
    const p = srv(server)
    const clients = m.getWord(p + S_CLIENTS)
    m.putWord(p + S_CLIENTS, 0)
    const listeners = m.getWord(p + S_LISTENERS)
    m.putWord(p + S_LISTENERS, 0)
    var at = clients
    while at != 0 {
        const cn = m.getWord(at)
        m.putWord(cn + C_SERVER, 0)
        disconnect(cn)
        connUnref(cn)
        at = m.getWord(at + 8)
    }
    g_slist_free(clients)
    at = listeners
    while at != 0 {
        listenerFree(m.getWord(at))
        at = m.getWord(at + 8)
    }
    g_slist_free(listeners)
}

// ---------------------------------------------------------------------------
// Listening

fn listenerFree(listener: usize) -> void {
    const source = m.getWord(listener + L_SOURCE)
    if source != 0 {
        g_source_destroy(source)
        g.g_source_unref(source)
    }
    _ = g_socket_close(m.getWord(listener + L_SOCKET), 0)
    g.g_object_unref(m.getWord(listener + L_SOCKET))
    c.clearObject(listener + L_ADDRESS)
    m.release(listener)
}

export fn __mlx_soup_server_accept(socketObject: usize, condition: i32, listener: usize) -> i32 {
    const server = m.getWord(listener + L_SERVER)
    while true {
        const fd = accept4(g_socket_get_fd(m.getWord(listener + L_SOCKET)), 0, 0, SOCK_CLOEXEC)
        if fd < 0 { break }
        const s = g_socket_new_from_fd(fd, 0)
        if s == 0 {
            _ = close(fd)
            continue
        }
        const connection = g_socket_connection_factory_create_connection(s)
        g.g_object_unref(s)
        const cn = newConnection(server, connection, 0, 0)
        g.g_object_unref(connection)
        acceptConnection(server, cn)
        connUnref(cn)
    }
    return 1
}

fn errnoText(prefix: []const u8, code: i32) -> usize {
    var t = m.text()
    m.pushText(&t, prefix)
    m.pushC(&t, strerror(code))
    return m.finish(&t)
}

fn setErrno(err: usize, prefix: []const u8, code: i32) -> void {
    const text = errnoText(prefix, code)
    var kind = IO_FAILED
    if code == EADDRINUSE { kind = IO_ADDRESS_IN_USE }
    if code == EAFNOSUPPORT { kind = IO_NOT_SUPPORTED }
    c.setError(err, g.g_io_error_quark(), kind, m.cSlice(text))
    m.release(text)
}

fn addListener(server: usize, socketObject: usize, options: i32, err: usize) -> bool {
    const p = srv(server)
    if (options & LISTEN_HTTPS) != 0 {
        if m.getWord(p + S_TLS_CERT) == 0 {
            c.setError(err, g.g_io_error_quark(), IO_INVALID_ARGUMENT, "Can’t create a TLS server without a TLS certificate")
        } else {
            c.setError(err, g.g_io_error_quark(), IO_NOT_SUPPORTED, "TLS servers are not supported")
        }
        _ = g_socket_close(socketObject, 0)
        g.g_object_unref(socketObject)
        return false
    }
    const listener = m.alloc(L_SIZE)
    m.putWord(listener + L_SOCKET, socketObject)
    m.putWord(listener + L_SERVER, server)
    m.putWord(listener + L_ADDRESS, g_socket_get_local_address(socketObject, 0))
    const source = g_socket_create_source(socketObject, 1, 0)
    g_source_set_callback(source, @intFromPtr(__mlx_soup_server_accept), listener, 0)
    _ = g_source_attach(source, g_main_context_get_thread_default())
    m.putWord(listener + L_SOURCE, source)
    m.putWord(p + S_LISTENERS, g_slist_prepend(m.getWord(p + S_LISTENERS), listener))
    return true
}

// A listening socket for `address`; 0 with `err` set.
fn listenOn(address: usize, err: usize) -> usize {
    const family = g_socket_address_get_family(address)
    const fd = socket(family, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0)
    if fd < 0 {
        setErrno(err, "Unable to create socket: ", m.getI32(__errno_location()))
        return 0
    }
    var one: i32 = 1
    _ = setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, @intFromPtr(&one), 4)
    if family == AF_INET6 { _ = setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, @intFromPtr(&one), 4) }
    const size = g_socket_address_get_native_size(address)
    const native = m.alloc(128)
    _ = g_socket_address_to_native(address, native, 128, 0)
    if bind(fd, native, @intCast(u32, size)) != 0 {
        const code = m.getI32(__errno_location())
        m.release(native)
        _ = close(fd)
        setErrno(err, "Error binding to address: ", code)
        return 0
    }
    m.release(native)
    if listen(fd, 128) != 0 {
        const code = m.getI32(__errno_location())
        _ = close(fd)
        setErrno(err, "Error listening: ", code)
        return 0
    }
    return g_socket_new_from_fd(fd, err)
}

export fn soup_server_listen(server: usize, address: usize, options: i32, err: usize) -> i32 {
    if (options & (LISTEN_IPV4_ONLY | LISTEN_IPV6_ONLY)) != 0 {
        c.critical("soup_server_listen: assertion '!(options & SOUP_SERVER_LISTEN_IPV4_ONLY) && !(options & SOUP_SERVER_LISTEN_IPV6_ONLY)' failed")
        return 0
    }
    const s = listenOn(address, err)
    if s == 0 { return 0 }
    return if addListener(server, s, options, err) { 1 } else { 0 }
}

export fn soup_server_listen_socket(server: usize, socketObject: usize, options: i32, err: usize) -> i32 {
    _ = g.g_object_ref(socketObject)
    return if addListener(server, socketObject, options, err) { 1 } else { 0 }
}

fn firstListenerPort(server: usize) -> u16 {
    const listeners = m.getWord(srv(server) + S_LISTENERS)
    if listeners == 0 { return 0 }
    const address = m.getWord(m.getWord(listeners) + L_ADDRESS)
    if address == 0 { return 0 }
    return g_inet_socket_address_get_port(address)
}

fn listenIpv4Ipv6(server: usize, address4: usize, address6: usize, portIn: u32, optionsIn: i32, err: usize) -> bool {
    const options = optionsIn & ~(LISTEN_IPV4_ONLY | LISTEN_IPV6_ONLY)
    var port = portIn
    while true {
        var v4: usize = 0
        var v4port = port
        if address4 != 0 {
            const a = g_inet_socket_address_new(address4, @intCast(u16, port & 0xffff))
            const ok = soup_server_listen(server, a, options, err) != 0
            g.g_object_unref(a)
            if !ok { return false }
            v4 = m.getWord(m.getWord(srv(server) + S_LISTENERS))
            v4port = @intCast(u32, firstListenerPort(server))
        }
        if address6 == 0 { return true }
        const cell = m.alloc(8)
        const a6 = g_inet_socket_address_new(address6, @intCast(u16, v4port & 0xffff))
        const ok6 = soup_server_listen(server, a6, options, cell) != 0
        g.g_object_unref(a6)
        const e = m.getWord(cell)
        m.release(cell)
        if ok6 { return true }
        if v4 != 0 && g_error_matches(e, g.g_io_error_quark(), IO_NOT_SUPPORTED) != 0 {
            // No IPv6 here: IPv4 is enough.
            g_error_free(e)
            return true
        }
        if v4 != 0 {
            const p = srv(server)
            m.putWord(p + S_LISTENERS, g_slist_remove(m.getWord(p + S_LISTENERS), v4))
            listenerFree(v4)
        }
        if port == 0 && g_error_matches(e, g.g_io_error_quark(), IO_ADDRESS_IN_USE) != 0 {
            // The port given to IPv4 was taken on IPv6: again.
            g_error_free(e)
            continue
        }
        if err != 0 { m.putWord(err, e) } else { g_error_free(e) }
        return false
    }
    return false
}

fn listenFamilies(server: usize, port: u32, options: i32, err: usize, loopback: bool) -> i32 {
    var a4: usize = 0
    var a6: usize = 0
    if (options & LISTEN_IPV6_ONLY) == 0 { a4 = if loopback { g_inet_address_new_loopback(AF_INET) } else { g_inet_address_new_any(AF_INET) } }
    if (options & LISTEN_IPV4_ONLY) == 0 { a6 = if loopback { g_inet_address_new_loopback(AF_INET6) } else { g_inet_address_new_any(AF_INET6) } }
    const ok = listenIpv4Ipv6(server, a4, a6, port, options, err)
    if a4 != 0 { g.g_object_unref(a4) }
    if a6 != 0 { g.g_object_unref(a6) }
    return if ok { 1 } else { 0 }
}

export fn soup_server_listen_all(server: usize, port: u32, options: i32, err: usize) -> i32 { return listenFamilies(server, port, options, err, false) }
export fn soup_server_listen_local(server: usize, port: u32, options: i32, err: usize) -> i32 { return listenFamilies(server, port, options, err, true) }

export fn soup_server_get_uris(server: usize) -> usize {
    var uris: usize = 0
    var at = m.getWord(srv(server) + S_LISTENERS)
    while at != 0 {
        const address = m.getWord(m.getWord(at) + L_ADDRESS)
        if address != 0 {
            const ip = g_inet_address_to_string(g_inet_socket_address_get_address(address))
            var port: i32 = @intCast(i32, g_inet_socket_address_get_port(address))
            if port == 0 { port = -1 }
            uris = g_slist_prepend(uris, g_uri_build(HTTP_URI_FLAGS, m.literal("http"), 0, ip, port, m.literal("/"), 0, 0))
            g_free(ip)
        }
        at = m.getWord(at + 8)
    }
    return uris
}

fn handlerAt(server: usize, pathIn: usize) -> usize {
    const path = if pathIn == 0 || m.get8(pathIn) == 0 { m.literal("/") } else { pathIn }
    const map = m.getWord(srv(server) + S_HANDLERS)
    var handler = pathmap.lookup(map, path)
    if handler != 0 && m.cEqual(m.getWord(handler + H_PATH), path) { return handler }
    handler = m.alloc(H_SIZE)
    m.putWord(handler + H_PATH, g_strdup(path))
    pathmap.add(map, path, handler)
    return handler
}

fn setCallback(handler: usize, at: usize, callback: usize, data: usize, destroy: usize) -> void {
    callNotify(m.getWord(handler + at + 8), m.getWord(handler + at + 16))
    m.putWord(handler + at, callback)
    m.putWord(handler + at + 8, destroy)
    m.putWord(handler + at + 16, data)
}

export fn soup_server_add_handler(server: usize, path: usize, callback: usize, data: usize, destroy: usize) -> void {
    if callback == 0 { return }
    setCallback(handlerAt(server, path), H_CALLBACK, callback, data, destroy)
}

export fn soup_server_add_early_handler(server: usize, path: usize, callback: usize, data: usize, destroy: usize) -> void {
    if callback == 0 { return }
    setCallback(handlerAt(server, path), H_EARLY, callback, data, destroy)
}

export fn soup_server_add_websocket_handler(server: usize, path: usize, origin: usize, protocols: usize, callback: usize, data: usize, destroy: usize) -> void {
    if callback == 0 { return }
    const handler = handlerAt(server, path)
    setCallback(handler, H_WS_CALLBACK, callback, data, destroy)
    g_free(m.getWord(handler + H_WS_ORIGIN))
    g_strfreev(m.getWord(handler + H_WS_PROTOCOLS))
    g_list_free_full(m.getWord(handler + H_WS_EXTENSIONS), @intFromPtr(g.g_object_unref))
    m.putWord(handler + H_WS_ORIGIN, g_strdup(origin))
    m.putWord(handler + H_WS_PROTOCOLS, g_strdupv(protocols))
    m.putWord(handler + H_WS_EXTENSIONS, 0)
}

export fn soup_server_remove_handler(server: usize, path: usize) -> void {
    pathmap.remove(m.getWord(srv(server) + S_HANDLERS), if path == 0 || m.get8(path) == 0 { m.literal("/") } else { path })
}

export fn soup_server_add_auth_domain(server: usize, domain: usize) -> void {
    const p = srv(server)
    m.putWord(p + S_AUTH_DOMAINS, g_slist_append(m.getWord(p + S_AUTH_DOMAINS), g.g_object_ref(domain)))
}

export fn soup_server_remove_auth_domain(server: usize, domain: usize) -> void {
    const p = srv(server)
    m.putWord(p + S_AUTH_DOMAINS, g_slist_remove(m.getWord(p + S_AUTH_DOMAINS), domain))
    g.g_object_unref(domain)
}

export fn soup_server_pause_message(server: usize, msg: usize) -> void { soup_server_message_pause(msg) }
export fn soup_server_unpause_message(server: usize, msg: usize) -> void { soup_server_message_unpause(msg) }

fn notExtension(t: usize) -> bool {
    if g_type_is_a(t, wsext.extensionTypeGet()) != 0 { return false }
    var text = m.text()
    m.pushText(&text, "Type '")
    m.pushC(&text, g_type_name(t))
    m.pushText(&text, "' is not a SoupWebsocketExtension")
    const message = m.finish(&text)
    c.warning(m.cSlice(message))
    m.release(message)
    return true
}

export fn soup_server_add_websocket_extension(server: usize, t: usize) -> void {
    if notExtension(t) { return }
    g_ptr_array_add(m.getWord(srv(server) + S_EXTENSIONS), g_type_class_ref(t))
}

export fn soup_server_remove_websocket_extension(server: usize, t: usize) -> void {
    if notExtension(t) { return }
    const class = g_type_class_peek(t)
    const array = m.getWord(srv(server) + S_EXTENSIONS)
    var index: usize = 0
    while index < @intCast(usize, m.get32(array + 8)) {
        if m.getWord(m.getWord(array) + index * 8) == class {
            _ = g_ptr_array_remove_index(array, @intCast(u32, index))
            return
        }
        index += 1
    }
}
