// A message in a session's queue (libsoup's SoupMessageQueueItem): where
// it is in being sent, the task that waits on it, the connection it has.
//
// The record:
//   0 references (u32)          8 the session
//  16 the message              24 the GTask of send_async (0: none)
//  32 the cancellable          40 whether asynchronous, 44 the state
//  48 whether paused, 52 whether its I/O started (send_async)
//  56 times resent, 60 the I/O priority
//  64 the error it ended with  72 its connection (conn.mlx)
//  80 the main context it runs in
//  88 whether only connecting (preconnect)
//  96 the I/O record (io.mlx)
// 104 the body gathered while it may be requeued (a GMemoryOutputStream)
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")

pub const STARTING: i32 = 0
pub const CONNECTING: i32 = 1
pub const CONNECTED: i32 = 2
pub const TUNNELING: i32 = 3
pub const READY: i32 = 4
pub const RUNNING: i32 = 5
pub const CACHED: i32 = 6
pub const REQUEUED: i32 = 7
pub const RESTARTING: i32 = 8
pub const FINISHING: i32 = 9
pub const FINISHED: i32 = 10

pub const R_REFS: usize = 0
pub const R_SESSION: usize = 8
pub const R_MSG: usize = 16
pub const R_TASK: usize = 24
pub const R_CANCELLABLE: usize = 32
pub const R_ASYNC: usize = 40
pub const R_STATE: usize = 44
pub const R_PAUSED: usize = 48
pub const R_IO_STARTED: usize = 52
pub const R_RESENDS: usize = 56
pub const R_PRIORITY: usize = 60
pub const R_ERROR: usize = 64
pub const R_CONN: usize = 72
pub const R_CONTEXT: usize = 80
pub const R_CONNECT_ONLY: usize = 88
pub const R_IO: usize = 96
pub const R_GATHER: usize = 104
const R_SIZE: usize = 112

// libsoup's SOUP_SESSION_MAX_RESEND_COUNT.
pub const MAX_RESEND_COUNT: i32 = 20

pub fn new(session: usize, msg: usize, asynchronous: bool, cancellable: usize) -> usize {
    const item = m.alloc(R_SIZE)
    m.put32(item + R_REFS, 1)
    m.putWord(item + R_SESSION, g.g_object_ref(session))
    m.putWord(item + R_MSG, g.g_object_ref(msg))
    m.putWord(item + R_CANCELLABLE, if cancellable != 0 { g.g_object_ref(cancellable) } else { g.g_cancellable_new() })
    m.putI32(item + R_ASYNC, if asynchronous { 1 } else { 0 })
    m.putWord(item + R_CONTEXT, g.g_main_context_ref_thread_default())
    return item
}

pub fn ref(item: usize) -> usize {
    m.put32(item + R_REFS, m.get32(item + R_REFS) + 1)
    return item
}

pub fn unref(item: usize) -> void {
    const refs = m.get32(item + R_REFS) - 1
    m.put32(item + R_REFS, refs)
    if refs != 0 { return }
    g.g_object_unref(m.getWord(item + R_SESSION))
    g.g_object_unref(m.getWord(item + R_MSG))
    c.clearObject(item + R_CANCELLABLE)
    c.clearObject(item + R_GATHER)
    if m.getWord(item + R_ERROR) != 0 { g.g_error_free(m.getWord(item + R_ERROR)) }
    g.g_main_context_unref(m.getWord(item + R_CONTEXT))
    m.release(item)
}

export fn __mlx_soup_item_unref(item: usize) -> void { unref(item) }

pub fn session(item: usize) -> usize { return m.getWord(item + R_SESSION) }
pub fn msg(item: usize) -> usize { return m.getWord(item + R_MSG) }
pub fn state(item: usize) -> i32 { return m.getI32(item + R_STATE) }
pub fn setState(item: usize, s: i32) -> void { m.putI32(item + R_STATE, s) }
pub fn isAsync(item: usize) -> bool { return m.getI32(item + R_ASYNC) != 0 }
pub fn cancellable(item: usize) -> usize { return m.getWord(item + R_CANCELLABLE) }
pub fn errorOf(item: usize) -> usize { return m.getWord(item + R_ERROR) }
pub fn io(item: usize) -> usize { return m.getWord(item + R_IO) }
pub fn setIo(item: usize, value: usize) -> void { m.putWord(item + R_IO, value) }
pub fn priority(item: usize) -> i32 { return m.getI32(item + R_PRIORITY) }
pub fn isPaused(item: usize) -> bool { return m.getI32(item + R_PAUSED) != 0 }

// Keeps `e` as the item's error unless it has one (it takes `e`).
pub fn setError(item: usize, e: usize) -> void {
    if m.getWord(item + R_ERROR) != 0 {
        g.g_error_free(e)
        return
    }
    m.putWord(item + R_ERROR, e)
}

// A new cancellable for the next operation (the last one's is done).
pub fn renewCancellable(item: usize) -> void {
    c.clearObject(item + R_CANCELLABLE)
    m.putWord(item + R_CANCELLABLE, g.g_cancellable_new())
}
