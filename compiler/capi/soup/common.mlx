// What mlx-soup's parts share: making GObject types (classes whose init
// functions are this library's, chained to their parent's dispose and
// finalize), enumeration and flags types, properties and signals; errors;
// text for C (mlx-glib's memory.mlx: C's allocator, so g_free frees what
// this library hands out); the Sink std.http writes through.
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const headers = @import("std.http.headers")

extern("c") fn g_once_init_enter(location: usize) -> i32
extern("c") fn g_once_init_leave(location: usize, result: usize) -> void
extern("c") fn g_mutex_lock(mutex: usize) -> void
extern("c") fn g_mutex_unlock(mutex: usize) -> void

// GParamFlags.
pub const READABLE: i32 = 1
pub const WRITABLE: i32 = 2
pub const READWRITE: i32 = 3
pub const CONSTRUCT: i32 = 4
pub const CONSTRUCT_ONLY: i32 = 8
pub const EXPLICIT_NOTIFY: i32 = 1073741824
pub const STATIC_STRINGS: i32 = 224

// GSignalFlags.
pub const RUN_FIRST: u32 = 1
pub const RUN_LAST: u32 = 2

// GType fundamentals.
pub const T_NONE: usize = 4
pub const T_INTERFACE: usize = 8
pub const T_BOOLEAN: usize = 20
pub const T_INT: usize = 24
pub const T_UINT: usize = 28
pub const T_UINT64: usize = 44
pub const T_ENUM: usize = 48
pub const T_FLAGS: usize = 52
pub const T_STRING: usize = 64
pub const T_POINTER: usize = 68
pub const T_BOXED: usize = 72
pub const T_OBJECT: usize = 80

// GTypeFlags.
pub const ABSTRACT: i32 = 16
pub const FINAL: i32 = 64

// Whether the caller is to make what `location` holds (only one thread
// is told so), and its leaving.
pub fn onceEnter(location: *usize) -> bool { return g_once_init_enter(@intFromPtr(location)) != 0 }
pub fn onceLeave(location: *usize, value: usize) -> void { g_once_init_leave(@intFromPtr(location), value) }

pub fn lock(mutex: *u64) -> void { g_mutex_lock(@intFromPtr(mutex)) }
pub fn unlock(mutex: *u64) -> void { g_mutex_unlock(@intFromPtr(mutex)) }

// A GObject type: GTypeInfo filled from the sizes and init functions.
pub fn defineType(parent: usize, name: []const u8, classSize: usize, classInit: usize, instanceSize: usize, instanceInit: usize, flags: i32) -> usize {
    const info = m.alloc(72)
    m.put16(info, @intCast(u16, classSize))
    m.putWord(info + 24, classInit)
    m.put16(info + 48, @intCast(u16, instanceSize))
    m.putWord(info + 56, instanceInit)
    const t = g.g_type_register_static(parent, m.literal(name), info, flags)
    m.release(info)
    return t
}

// An interface type (its vtable `size` bytes), on GObject.
pub fn defineInterface(name: []const u8, size: usize, defaultInit: usize) -> usize {
    const t = defineType(T_INTERFACE, name, size, defaultInit, 0, 0, 0)
    g.g_type_interface_add_prerequisite(t, T_OBJECT)
    return t
}

pub fn implement(t: usize, iface: usize, init: usize) -> void {
    const info = m.alloc(24)
    m.putWord(info, init)
    g.g_type_add_interface_static(t, iface, info)
    m.release(info)
}

pub const ObjectFunc = fn(usize) -> void

// Runs the dispose (40) or finalize (48) of `class`'s parent class.
pub fn chainUp(class: usize, slot: usize, object: usize) -> void {
    const parent = g.g_type_class_peek_parent(class)
    if parent == 0 { return }
    const f = m.getWord(parent + slot)
    if f == 0 { return }
    const call: ObjectFunc = unsafe { @ptrFromInt(ObjectFunc, f) }
    call(object)
}

// An enumeration or flags type of NAME with values (GEnumValue and
// GFlagsValue records: value, name, nick; kept for the program's life).
pub fn enumType(name: []const u8, flags: bool, values: []const i64, names: []const u8, nicks: []const u8) -> usize {
    const count = values.length
    const records = m.alloc((count + 1) * 24)
    var nameAt: usize = 0
    var nickAt: usize = 0
    var index: usize = 0
    while index < count {
        const nameEnd = headers.indexOf(names, 32, nameAt)
        const nickEnd = headers.indexOf(nicks, 32, nickAt)
        m.put32(records + index * 24, @bitCast(u32, @intCast(i32, values[index])))
        m.putWord(records + index * 24 + 8, m.dupBytes(@intFromPtr(names.pointer) + nameAt, nameEnd - nameAt))
        m.putWord(records + index * 24 + 16, m.dupBytes(@intFromPtr(nicks.pointer) + nickAt, nickEnd - nickAt))
        nameAt = nameEnd + 1
        nickAt = nickEnd + 1
        index += 1
    }
    if flags { return g.g_flags_register_static(m.literal(name), records) }
    return g.g_enum_register_static(m.literal(name), records)
}

// Properties: the nick and blurb are the name (the library keeps no
// other descriptions).
pub fn install(class: usize, id: u32, pspec: usize) -> void { g.g_object_class_install_property(class, id, pspec) }

pub fn stringProperty(class: usize, id: u32, name: []const u8, flags: i32) -> usize {
    const pspec = g.g_param_spec_string(m.literal(name), m.literal(name), m.literal(name), 0, flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

pub fn booleanProperty(class: usize, id: u32, name: []const u8, value: bool, flags: i32) -> usize {
    const pspec = g.g_param_spec_boolean(m.literal(name), m.literal(name), m.literal(name), if value { 1 } else { 0 }, flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

pub fn intProperty(class: usize, id: u32, name: []const u8, minimum: i32, maximum: i32, value: i32, flags: i32) -> usize {
    const pspec = g.g_param_spec_int(m.literal(name), m.literal(name), m.literal(name), minimum, maximum, value, flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

pub fn uintProperty(class: usize, id: u32, name: []const u8, minimum: u32, maximum: u32, value: u32, flags: i32) -> usize {
    const pspec = g.g_param_spec_uint(m.literal(name), m.literal(name), m.literal(name), minimum, maximum, value, flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

pub fn uint64Property(class: usize, id: u32, name: []const u8, maximum: u64, value: u64, flags: i32) -> usize {
    const pspec = g.g_param_spec_uint64(m.literal(name), m.literal(name), m.literal(name), 0, maximum, value, flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

pub fn enumProperty(class: usize, id: u32, name: []const u8, t: usize, value: i32, flags: i32) -> usize {
    const pspec = g.g_param_spec_enum(m.literal(name), m.literal(name), m.literal(name), t, value, flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

pub fn flagsProperty(class: usize, id: u32, name: []const u8, t: usize, value: u32, flags: i32) -> usize {
    const pspec = g.g_param_spec_flags(m.literal(name), m.literal(name), m.literal(name), t, value, flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

pub fn objectProperty(class: usize, id: u32, name: []const u8, t: usize, flags: i32) -> usize {
    const pspec = g.g_param_spec_object(m.literal(name), m.literal(name), m.literal(name), t, flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

pub fn boxedProperty(class: usize, id: u32, name: []const u8, t: usize, flags: i32) -> usize {
    const pspec = g.g_param_spec_boxed(m.literal(name), m.literal(name), m.literal(name), t, flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

pub fn pointerProperty(class: usize, id: u32, name: []const u8, flags: i32) -> usize {
    const pspec = g.g_param_spec_pointer(m.literal(name), m.literal(name), m.literal(name), flags | STATIC_STRINGS)
    install(class, id, pspec)
    return pspec
}

// A signal of the class's type with up to four parameters (a class
// closure at `offset` in the class when it is not 0); its id.
pub fn signal(class: usize, name: []const u8, flags: u32, offset: u32, accumulator: usize, returnType: usize, count: u32, p1: usize, p2: usize, p3: usize, p4: usize) -> u32 {
    const t = m.getWord(class)
    const params = m.alloc(32)
    m.putWord(params, p1)
    m.putWord(params + 8, p2)
    m.putWord(params + 16, p3)
    m.putWord(params + 24, p4)
    const closure = if offset != 0 { g.g_signal_type_cclosure_new(t, offset) } else { 0 }
    const id = g.g_signal_newv(m.literal(name), t, flags, closure, accumulator, 0, 0, returnType, count, params)
    m.release(params)
    return id
}

// A signal emitted with its arguments (GValues made of words: an object,
// a boxed or a string as a pointer, the others by their type), `result`
// the return value's GValue (0: none).
pub fn emit(instance: usize, id: u32, count: usize, types: []const usize, args: []const usize, result: usize) -> void {
    const values = m.alloc((count + 1) * 24)
    _ = g.g_value_init(values, m.getWord(m.getWord(instance)))
    g.g_value_set_object(values, instance)
    var index: usize = 0
    while index < count {
        const v = values + (index + 1) * 24
        const t = types[index]
        _ = g.g_value_init(v, t)
        setValue(v, t, args[index])
        index += 1
    }
    g.g_signal_emitv(values, id, 0, result)
    index = 0
    while index <= count {
        g.g_value_unset(values + index * 24)
        index += 1
    }
    m.release(values)
}

// The fundamental type of `t` (from the registry's own numbering: a
// fundamental is under 1024, and a derived type's is found by
// walking up to it).
extern("c") fn g_type_fundamental(t: usize) -> usize

pub fn setValue(v: usize, t: usize, word: usize) -> void {
    const f = g_type_fundamental(t)
    if f == T_OBJECT || f == T_INTERFACE {
        g.g_value_set_object(v, word)
    } else if f == T_BOXED {
        g.g_value_set_boxed(v, word)
    } else if f == T_STRING {
        g.g_value_set_string(v, word)
    } else if f == T_BOOLEAN {
        g.g_value_set_boolean(v, @intCast(i32, word & 1))
    } else if f == T_INT {
        g.g_value_set_int(v, @bitCast(i32, @intCast(u32, word & 0xffffffff)))
    } else if f == T_UINT {
        g.g_value_set_uint(v, @intCast(u32, word & 0xffffffff))
    } else if f == T_UINT64 {
        g.g_value_set_uint64(v, word)
    } else if f == T_ENUM {
        g.g_value_set_enum(v, @bitCast(i32, @intCast(u32, word & 0xffffffff)))
    } else if f == T_FLAGS {
        g.g_value_set_flags(v, @intCast(u32, word & 0xffffffff))
    } else if f == T_POINTER {
        g.g_value_set_pointer(v, word)
    }
}

// A signal returning a boolean (true when a handler handled it).
pub fn emitBoolean(instance: usize, id: u32, count: usize, types: []const usize, args: []const usize) -> bool {
    const result = m.alloc(24)
    _ = g.g_value_init(result, T_BOOLEAN)
    emit(instance, id, count, types, args, result)
    const handled = g.g_value_get_boolean(result) != 0
    g.g_value_unset(result)
    m.release(result)
    return handled
}

pub fn emitPlain(instance: usize, id: u32) -> void {
    const none: [1]usize = [1]usize{ 0 }
    emit(instance, id, 0, none[0..0], none[0..0], 0)
}

pub fn emitOne(instance: usize, id: u32, t: usize, arg: usize) -> void {
    var ts: [1]usize = [1]usize{ t }
    var args: [1]usize = [1]usize{ arg }
    emit(instance, id, 1, ts[0..1], args[0..1], 0)
}

pub fn emitTwo(instance: usize, id: u32, t1: usize, a1: usize, t2: usize, a2: usize) -> void {
    var ts: [2]usize = [2]usize{ t1, t2 }
    var args: [2]usize = [2]usize{ a1, a2 }
    emit(instance, id, 2, ts[0..2], args[0..2], 0)
}

// ---------------------------------------------------------------------------
// Errors

pub fn setError(err: usize, domain: u32, code: i32, message: []const u8) -> void {
    if err == 0 { return }
    const text = m.dupSlice(message)
    g.g_set_error_literal(err, domain, code, text)
    m.release(text)
}

pub fn newError(domain: u32, code: i32, message: []const u8) -> usize {
    const text = m.dupSlice(message)
    const e = g.g_error_new_literal(domain, code, text)
    m.release(text)
    return e
}

pub fn ioError(code: i32, message: []const u8) -> usize { return newError(g.g_io_error_quark(), code, message) }

// ---------------------------------------------------------------------------
// Text

pub fn appendText(context: usize, bytes: []const u8) -> void {
    const t: *m.Text = unsafe { @ptrFromInt(*m.Text, context) }
    m.pushBytes(t, @intFromPtr(bytes.pointer), bytes.length)
}

// A Sink that appends to `t`.
pub fn sinkOf(t: *m.Text) -> headers.Sink { return headers.Sink.{ .context = @intFromPtr(t), .write = appendText } }

pub fn appendGString(context: usize, bytes: []const u8) -> void { _ = g.g_string_append_len(context, @intFromPtr(bytes.pointer), @intCast(i64, bytes.length)) }

// A Sink that appends to the GString `s`.
pub fn gstringSink(s: usize) -> headers.Sink { return headers.Sink.{ .context = s, .write = appendGString } }

// A C string as a slice (empty for NULL).
pub fn slice(text: usize) -> []const u8 { return m.cSlice(text) }

// A slice as a new C string.
pub fn dup(text: []const u8) -> usize { return m.dupSlice(text) }

pub fn same(a: []const u8, b: []const u8) -> bool { return m.same(a, b) }

pub fn equalsIgnoringCase(a: []const u8, b: []const u8) -> bool { return headers.equalsIgnoringCase(a, b) }

// g_strcmp0: NULL first.
pub fn strcmp0(a: usize, b: usize) -> i32 {
    if a == b { return 0 }
    if a == 0 { return -1 }
    if b == 0 { return 1 }
    return m.cCompare(a, b)
}

pub fn cEquals(a: usize, b: usize) -> bool { return strcmp0(a, b) == 0 }

// Replaces the C string in the word at `field` by a copy of `text`.
pub fn replaceString(field: usize, text: usize) -> void {
    const old = m.getWord(field)
    m.putWord(field, m.dup(text))
    m.release(old)
}

pub fn replaceObject(field: usize, object: usize) -> void {
    const old = m.getWord(field)
    if object != 0 { _ = g.g_object_ref(object) }
    m.putWord(field, object)
    if old != 0 { g.g_object_unref(old) }
}

pub fn replaceUri(field: usize, uri: usize) -> void {
    const old = m.getWord(field)
    if uri != 0 { _ = g.g_uri_ref(uri) }
    m.putWord(field, uri)
    if old != 0 { g.g_uri_unref(old) }
}

pub fn clearObject(field: usize) -> void {
    const old = m.getWord(field)
    m.putWord(field, 0)
    if old != 0 { g.g_object_unref(old) }
}

pub fn critical(text: []const u8) -> void {
    const message = m.dupSlice(text)
    g_log_soup(message)
    m.release(message)
}

extern("c") fn g_log(domain: usize, level: i32, format: usize, a: usize) -> void

fn g_log_soup(message: usize) -> void { g_log(m.literal("libsoup"), 8, m.literal("%s"), message) }

pub fn warning(text: []const u8) -> void {
    const message = m.dupSlice(text)
    g_log(m.literal("libsoup"), 16, m.literal("%s"), message)
    m.release(message)
}
