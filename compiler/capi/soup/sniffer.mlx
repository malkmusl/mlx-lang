// soup-content-sniffer.h: SoupContentSniffer, the session feature that
// holds the first 512 bytes of each response's body (bodystream.mlx's
// sniffer stream) and tells the message the type they show
// ("content-sniffed"), by std.http.sniff's rules (the MIME Sniffing
// Standard, as libsoup applies it).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const message = @import("./message.mlx")
const feature = @import("./feature.mlx")
const bodystream = @import("./bodystream.mlx")
const sniff = @import("std.http.sniff")

extern("c") fn soup_message_headers_get_content_type(h: usize, params: usize) -> usize
extern("c") fn soup_message_headers_get_one(h: usize, name: usize) -> usize

var snifferType: usize = 0

pub fn snifferTypeGet() -> usize {
    if c.onceEnter(&snifferType) {
        const t = c.defineType(c.T_OBJECT, "SoupContentSniffer", 136, 0, 24, 0, c.FINAL)
        feature.implementFeature(t, @intFromPtr(__mlx_soup_sniffer_feature_init))
        c.onceLeave(&snifferType, t)
    }
    return snifferType
}

export fn soup_content_sniffer_get_type() -> usize { return snifferTypeGet() }
export fn soup_content_sniffer_new() -> usize { return g.g_object_new(snifferTypeGet(), 0) }

// The type of `data` for the message's response (C heap), and its
// Content-Type's parameters into `params` (when not 0).
fn sniffType(msg: usize, data: []const u8, params: usize) -> usize {
    const hdrs = message.responseHeaders(msg)
    const contentType = soup_message_headers_get_content_type(hdrs, params)
    const options = soup_message_headers_get_one(hdrs, m.literal("X-Content-Type-Options"))
    const noSniff = options != 0 && m.same(m.cSlice(options), "nosniff")
    return m.dupSlice(sniff.sniff(m.cSlice(contentType), contentType != 0, noSniff, data))
}

export fn soup_content_sniffer_sniff(sniffer: usize, msg: usize, buffer: usize, params: usize) -> usize {
    const size = m.alloc(8)
    const data = g.g_bytes_get_data(buffer, size)
    const result = sniffType(msg, m.bytes(data, m.getWord(size)), params)
    m.release(size)
    return result
}

// The I/O's hook: the bytes held, sniffed, told as "content-sniffed".
export fn __mlx_soup_sniffer_sniff(msg: usize, stream: usize) -> void {
    const cell = m.alloc(8)
    const sniffed = sniffType(msg, bodystream.sniffed(stream), cell)
    message.contentSniffed(msg, sniffed, m.getWord(cell))
    if m.getWord(cell) != 0 { g.g_hash_table_destroy(m.getWord(cell)) }
    m.release(cell)
    m.release(sniffed)
}

export fn __mlx_soup_sniffer_request_queued(sniffer: usize, msg: usize) -> void { message.setSniffer(msg, sniffer) }
export fn __mlx_soup_sniffer_request_unqueued(sniffer: usize, msg: usize) -> void { message.setSniffer(msg, 0) }
export fn __mlx_soup_sniffer_wrap_input(sniffer: usize, base: usize, msg: usize) -> usize { return bodystream.newSniffer(base) }

export fn __mlx_soup_sniffer_feature_init(iface: usize, data: usize) -> void {
    m.putWord(iface + feature.REQUEST_QUEUED, @intFromPtr(__mlx_soup_sniffer_request_queued))
    m.putWord(iface + feature.REQUEST_UNQUEUED, @intFromPtr(__mlx_soup_sniffer_request_unqueued))
    m.putWord(iface + feature.WRAP_INPUT, @intFromPtr(__mlx_soup_sniffer_wrap_input))
    m.putWord(iface + feature.STAGE, feature.STAGE_BODY_DATA)
}
