// libsoup/soup-version.h
// mlx-soup: the version of libsoup's API this library has (3.4.4), for
// SOUP_CHECK_VERSION in C's preprocessor and soup_check_version, and the
// version macros libsoup's headers mark their declarations with (empty
// here: every declaration is available).
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gversion = @import("../../glib/api/gversion.mlx")

const guint = gtypes.guint
const gboolean = gtypes.gboolean
pub const c_tokens = usize

pub const SOUP_MAJOR_VERSION: c_int = 3
pub const SOUP_MINOR_VERSION: c_int = 4
pub const SOUP_MICRO_VERSION: c_int = 4

// Whether this API is at least the version `major`.`minor`.`micro`.
pub fn SOUP_CHECK_VERSION(major: c_int, minor: c_int, micro: c_int) -> bool {
    return SOUP_MAJOR_VERSION > major || (SOUP_MAJOR_VERSION == major && SOUP_MINOR_VERSION > minor) || (SOUP_MAJOR_VERSION == major && SOUP_MINOR_VERSION == minor && SOUP_MICRO_VERSION >= micro)
}

pub const _SOUP_EXTERN: c_tokens = "extern"
pub const SOUP_VAR: c_tokens = "extern"
pub const SOUP_VERSION_3_0: c_int = (3 << 16) | (0 << 8)
pub const SOUP_VERSION_3_2: c_int = (3 << 16) | (2 << 8)
pub const SOUP_VERSION_3_4: c_int = (3 << 16) | (4 << 8)
pub const SOUP_VERSION_CUR_STABLE: c_int = (3 << 16) | (4 << 8)
pub const SOUP_VERSION_PREV_STABLE: c_int = (3 << 16) | (2 << 8)
pub const SOUP_AVAILABLE_IN_ALL: c_tokens = "extern"
pub const SOUP_AVAILABLE_IN_3_0: c_tokens = "extern"
pub const SOUP_AVAILABLE_IN_3_2: c_tokens = "extern"
pub const SOUP_AVAILABLE_IN_3_4: c_tokens = "extern"
pub const SOUP_DEPRECATED_IN_3_0: c_tokens = "extern"
pub const SOUP_DEPRECATED_IN_3_2: c_tokens = "extern"
pub const SOUP_DEPRECATED_IN_3_4: c_tokens = "extern"

pub extern("c") fn soup_get_major_version() -> guint
pub extern("c") fn soup_get_minor_version() -> guint
pub extern("c") fn soup_get_micro_version() -> guint
pub extern("c") fn soup_check_version(major: guint, minor: guint, micro: guint) -> gboolean
