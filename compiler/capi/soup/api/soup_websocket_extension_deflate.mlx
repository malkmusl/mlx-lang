// libsoup/soup-websocket-extension-deflate.h
// mlx-soup: SoupWebsocketExtensionDeflate, the permessage-deflate
// extension (RFC 7692): messages compressed with DEFLATE (std.flate),
// with its parameters of window bits and context takeover.
const c_function_pointers = true
const gtype = @import("../../glib/api/gtype.mlx")
const extension = @import("./soup_websocket_extension.mlx")

pub const SOUP_TYPE_WEBSOCKET_EXTENSION_DEFLATE: gtype.GType = soup_websocket_extension_deflate_get_type()

pub const _SoupWebsocketExtensionDeflate = struct {}
pub const SoupWebsocketExtensionDeflate = _SoupWebsocketExtensionDeflate

pub extern("c") fn soup_websocket_extension_deflate_get_type() -> gtype.GType

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupWebsocketExtensionDeflate, soup_websocket_extension_deflate, SOUP, WEBSOCKET_EXTENSION_DEFLATE, SoupWebsocketExtension)\nG_END_DECLS"
