// libsoup/soup-hsts-enforcer.h
// mlx-soup: SoupHSTSEnforcer, the session feature that keeps HSTS
// policies: it takes them from secure responses and turns a request for
// http:// to a host under a policy into one for https:// ("hsts-enforced"
// on the message), telling of each change ("changed").
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gobject = @import("../../glib/api/gobject.mlx")
const glist = @import("../../glib/api/glist.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const gpointer = gtypes.gpointer
const SoupHSTSEnforcer = types.SoupHSTSEnforcer
const SoupHSTSPolicy = types.SoupHSTSPolicy

pub const SOUP_TYPE_HSTS_ENFORCER: gtype.GType = soup_hsts_enforcer_get_type()

pub const _SoupHSTSEnforcerClass = struct {
    parent_class: gobject.GObjectClass
    is_persistent: ?fn(hsts_enforcer: *SoupHSTSEnforcer) -> gboolean
    has_valid_policy: ?fn(hsts_enforcer: *SoupHSTSEnforcer, domain: [*]const gchar) -> gboolean
    changed: ?fn(enforcer: *SoupHSTSEnforcer, old_policy: ?*SoupHSTSPolicy, new_policy: ?*SoupHSTSPolicy) -> void
    padding: [4]gpointer
}
pub const SoupHSTSEnforcerClass = _SoupHSTSEnforcerClass

pub extern("c") fn soup_hsts_enforcer_get_type() -> gtype.GType
pub extern("c") fn soup_hsts_enforcer_new() -> *SoupHSTSEnforcer
pub extern("c") fn soup_hsts_enforcer_is_persistent(hsts_enforcer: *SoupHSTSEnforcer) -> gboolean
pub extern("c") fn soup_hsts_enforcer_has_valid_policy(hsts_enforcer: *SoupHSTSEnforcer, domain: [*]const gchar) -> gboolean
pub extern("c") fn soup_hsts_enforcer_set_session_policy(hsts_enforcer: *SoupHSTSEnforcer, domain: [*]const gchar, include_subdomains: gboolean) -> void
pub extern("c") fn soup_hsts_enforcer_set_policy(hsts_enforcer: *SoupHSTSEnforcer, policy: *SoupHSTSPolicy) -> void
pub extern("c") fn soup_hsts_enforcer_get_domains(hsts_enforcer: *SoupHSTSEnforcer, session_policies: gboolean) -> ?*glist.GList
pub extern("c") fn soup_hsts_enforcer_get_policies(hsts_enforcer: *SoupHSTSEnforcer, session_policies: gboolean) -> ?*glist.GList

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_DERIVABLE_TYPE (SoupHSTSEnforcer, soup_hsts_enforcer, SOUP, HSTS_ENFORCER, GObject)\nG_END_DECLS"
