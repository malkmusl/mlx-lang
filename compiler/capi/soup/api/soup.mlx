// libsoup/soup.h
// mlx-soup: libsoup 3's C API (3.4), an HTTP client and server library on
// GLib, in Mlx over mlx-glib's GObject and GIO and std.http: sessions
// and messages, headers and bodies, cookies, HSTS, authentication,
// content decoding and sniffing, multipart bodies, forms, dates, the
// Public Suffix List, WebSockets, and a server.
