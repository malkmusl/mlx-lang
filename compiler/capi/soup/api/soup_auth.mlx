// libsoup/soup-auth.h
// mlx-soup: SoupAuth, an HTTP authentication challenge and its answer,
// and its schemes: Basic and Digest (RFC 7617, RFC 7616), NTLM and
// Negotiate (whose types are here; NTLM's and GSSAPI's exchanges are
// not, and Negotiate is not supported, as in a libsoup without GSSAPI).
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gobject = @import("../../glib/api/gobject.mlx")
const gslist = @import("../../glib/api/gslist.mlx")
const ghash = @import("../../glib/api/ghash.mlx")
const guri = @import("../../glib/api/guri.mlx")
const types = @import("./soup_types.mlx")
const soupheaders = @import("./soup_headers.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const guint = gtypes.guint
const gpointer = gtypes.gpointer
const GType = gtype.GType
const GSList = gslist.GSList
const GHashTable = ghash.GHashTable
const GUri = guri.GUri
const SoupAuth = types.SoupAuth
const SoupMessage = types.SoupMessage

pub const SOUP_TYPE_AUTH: GType = soup_auth_get_type()

pub const _SoupAuthClass = struct {
    parent_class: gobject.GObjectClass
    scheme_name: [*]const gchar
    strength: guint
    update: ?fn(auth: *SoupAuth, msg: *SoupMessage, auth_header: *GHashTable) -> gboolean
    get_protection_space: ?fn(auth: *SoupAuth, source_uri: *GUri) -> *GSList
    authenticate: ?fn(auth: *SoupAuth, username: [*]const gchar, password: [*]const gchar) -> void
    is_authenticated: ?fn(auth: *SoupAuth) -> gboolean
    get_authorization: ?fn(auth: *SoupAuth, msg: *SoupMessage) -> [*]gchar
    is_ready: ?fn(auth: *SoupAuth, msg: *SoupMessage) -> gboolean
    can_authenticate: ?fn(auth: *SoupAuth) -> gboolean
    padding: [6]gpointer
}
pub const SoupAuthClass = _SoupAuthClass

pub extern("c") fn soup_auth_get_type() -> GType
pub extern("c") fn soup_auth_new(type_: GType, msg: *SoupMessage, auth_header: [*]const gchar) -> ?*SoupAuth
pub extern("c") fn soup_auth_update(auth: *SoupAuth, msg: *SoupMessage, auth_header: [*]const gchar) -> gboolean
pub extern("c") fn soup_auth_is_for_proxy(auth: *SoupAuth) -> gboolean
pub extern("c") fn soup_auth_get_scheme_name(auth: *SoupAuth) -> [*]const gchar
pub extern("c") fn soup_auth_get_authority(auth: *SoupAuth) -> [*]const gchar
pub extern("c") fn soup_auth_get_realm(auth: *SoupAuth) -> [*]const gchar
pub extern("c") fn soup_auth_get_info(auth: *SoupAuth) -> [*]gchar
pub extern("c") fn soup_auth_authenticate(auth: *SoupAuth, username: [*]const gchar, password: [*]const gchar) -> void
pub extern("c") fn soup_auth_cancel(auth: *SoupAuth) -> void
pub extern("c") fn soup_auth_is_authenticated(auth: *SoupAuth) -> gboolean
pub extern("c") fn soup_auth_is_cancelled(auth: *SoupAuth) -> gboolean
pub extern("c") fn soup_auth_is_ready(auth: *SoupAuth, msg: *SoupMessage) -> gboolean
pub extern("c") fn soup_auth_can_authenticate(auth: *SoupAuth) -> gboolean
pub extern("c") fn soup_auth_get_authorization(auth: *SoupAuth, msg: *SoupMessage) -> [*]gchar
pub extern("c") fn soup_auth_get_protection_space(auth: *SoupAuth, source_uri: *GUri) -> *GSList
pub extern("c") fn soup_auth_free_protection_space(auth: *SoupAuth, space: *GSList) -> void
pub extern("c") fn soup_auth_negotiate_supported() -> gboolean

pub const SOUP_TYPE_AUTH_BASIC: GType = soup_auth_basic_get_type()
pub extern("c") fn soup_auth_basic_get_type() -> GType
pub const SOUP_TYPE_AUTH_DIGEST: GType = soup_auth_digest_get_type()
pub extern("c") fn soup_auth_digest_get_type() -> GType
pub const SOUP_TYPE_AUTH_NTLM: GType = soup_auth_ntlm_get_type()
pub extern("c") fn soup_auth_ntlm_get_type() -> GType
pub const SOUP_TYPE_AUTH_NEGOTIATE: GType = soup_auth_negotiate_get_type()
pub extern("c") fn soup_auth_negotiate_get_type() -> GType

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_DERIVABLE_TYPE (SoupAuth, soup_auth, SOUP, AUTH, GObject)\nG_END_DECLS"
