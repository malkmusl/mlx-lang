// libsoup/soup-websocket-extension.h
// mlx-soup: SoupWebsocketExtension, a WebSocket extension (RFC 6455
// section 9): configured from the parameters of the handshake, it
// rewrites each message's frame header and payload on the way out and in.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const gerror = @import("../../glib/api/gerror.mlx")
const gobject = @import("../../glib/api/gobject.mlx")
const gbytes = @import("../../glib/api/gbytes.mlx")
const ghash = @import("../../glib/api/ghash.mlx")
const types = @import("./soup_types.mlx")
const websocket = @import("./soup_websocket.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const guint8 = gtypes.guint8
const gpointer = gtypes.gpointer
const GError = gerror.GError
const GBytes = gbytes.GBytes
const GHashTable = ghash.GHashTable
const SoupWebsocketExtension = types.SoupWebsocketExtension

pub const SOUP_TYPE_WEBSOCKET_EXTENSION: gtype.GType = soup_websocket_extension_get_type()

pub const _SoupWebsocketExtensionClass = struct {
    parent_class: gobject.GObjectClass
    name: [*]const gchar
    configure: ?fn(extension: *SoupWebsocketExtension, connection_type: websocket.SoupWebsocketConnectionType, params: ?*GHashTable, error_: ?**GError) -> gboolean
    get_request_params: ?fn(extension: *SoupWebsocketExtension) -> ?[*]gchar
    get_response_params: ?fn(extension: *SoupWebsocketExtension) -> ?[*]gchar
    process_outgoing_message: ?fn(extension: *SoupWebsocketExtension, header: *guint8, payload: *GBytes, error_: ?**GError) -> ?*GBytes
    process_incoming_message: ?fn(extension: *SoupWebsocketExtension, header: *guint8, payload: *GBytes, error_: ?**GError) -> ?*GBytes
    padding: [6]gpointer
}
pub const SoupWebsocketExtensionClass = _SoupWebsocketExtensionClass

pub extern("c") fn soup_websocket_extension_get_type() -> gtype.GType
pub extern("c") fn soup_websocket_extension_configure(extension: *SoupWebsocketExtension, connection_type: websocket.SoupWebsocketConnectionType, params: ?*GHashTable, error_: ?**GError) -> gboolean
pub extern("c") fn soup_websocket_extension_get_request_params(extension: *SoupWebsocketExtension) -> ?[*]gchar
pub extern("c") fn soup_websocket_extension_get_response_params(extension: *SoupWebsocketExtension) -> ?[*]gchar
pub extern("c") fn soup_websocket_extension_process_outgoing_message(extension: *SoupWebsocketExtension, header: *guint8, payload: *GBytes, error_: ?**GError) -> ?*GBytes
pub extern("c") fn soup_websocket_extension_process_incoming_message(extension: *SoupWebsocketExtension, header: *guint8, payload: *GBytes, error_: ?**GError) -> ?*GBytes

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_DERIVABLE_TYPE (SoupWebsocketExtension, soup_websocket_extension, SOUP, WEBSOCKET_EXTENSION, GObject)\nG_END_DECLS"
