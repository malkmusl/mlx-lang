// libsoup/soup-tld.h
// mlx-soup: domains by the Public Suffix List (std.http.psl): whether a
// domain is a public suffix, and a host's base domain (its public suffix
// and the label before it), which cookies and WebKit's site isolation go
// by.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gerror = @import("../../glib/api/gerror.mlx")
const gquark = @import("../../glib/api/gquark.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean

pub extern("c") fn soup_tld_get_base_domain(hostname: [*]const gchar, error_: ?**gerror.GError) -> ?[*]const gchar
pub extern("c") fn soup_tld_domain_is_public_suffix(domain: [*]const gchar) -> gboolean
pub extern("c") fn soup_tld_error_quark() -> gquark.GQuark
pub const SOUP_TLD_ERROR: gquark.GQuark = soup_tld_error_quark()

pub const SoupTLDError = enum(c_int) {
    SOUP_TLD_ERROR_INVALID_HOSTNAME,
    SOUP_TLD_ERROR_IS_IP_ADDRESS,
    SOUP_TLD_ERROR_NOT_ENOUGH_DOMAINS,
    SOUP_TLD_ERROR_NO_BASE_DOMAIN,
    SOUP_TLD_ERROR_NO_PSL_DATA,
}
