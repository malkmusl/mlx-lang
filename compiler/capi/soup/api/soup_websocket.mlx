// libsoup/soup-websocket.h
// mlx-soup: the WebSocket protocol (RFC 6455): its errors, close codes and
// states, and the opening handshake of a client (the request's headers
// and the check of the server's answer) and of a server.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gerror = @import("../../glib/api/gerror.mlx")
const gquark = @import("../../glib/api/gquark.mlx")
const garray = @import("../../glib/api/garray.mlx")
const glist = @import("../../glib/api/glist.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gboolean = gtypes.gboolean
const GError = gerror.GError
const GPtrArray = garray.GPtrArray
const GList = glist.GList

pub extern("c") fn soup_websocket_error_quark() -> gquark.GQuark
pub const SOUP_WEBSOCKET_ERROR: gquark.GQuark = soup_websocket_error_quark()

pub const SoupWebsocketError = enum(c_int) {
    SOUP_WEBSOCKET_ERROR_FAILED,
    SOUP_WEBSOCKET_ERROR_NOT_WEBSOCKET,
    SOUP_WEBSOCKET_ERROR_BAD_HANDSHAKE,
    SOUP_WEBSOCKET_ERROR_BAD_ORIGIN,
}

pub const SoupWebsocketConnectionType = enum(c_int) {
    SOUP_WEBSOCKET_CONNECTION_UNKNOWN,
    SOUP_WEBSOCKET_CONNECTION_CLIENT,
    SOUP_WEBSOCKET_CONNECTION_SERVER,
}

pub const SoupWebsocketDataType = enum(c_int) {
    SOUP_WEBSOCKET_DATA_TEXT = 1,
    SOUP_WEBSOCKET_DATA_BINARY = 2,
}

pub const SoupWebsocketCloseCode = enum(c_int) {
    SOUP_WEBSOCKET_CLOSE_NORMAL = 1000,
    SOUP_WEBSOCKET_CLOSE_GOING_AWAY = 1001,
    SOUP_WEBSOCKET_CLOSE_PROTOCOL_ERROR = 1002,
    SOUP_WEBSOCKET_CLOSE_UNSUPPORTED_DATA = 1003,
    SOUP_WEBSOCKET_CLOSE_NO_STATUS = 1005,
    SOUP_WEBSOCKET_CLOSE_ABNORMAL = 1006,
    SOUP_WEBSOCKET_CLOSE_BAD_DATA = 1007,
    SOUP_WEBSOCKET_CLOSE_POLICY_VIOLATION = 1008,
    SOUP_WEBSOCKET_CLOSE_TOO_BIG = 1009,
    SOUP_WEBSOCKET_CLOSE_NO_EXTENSION = 1010,
    SOUP_WEBSOCKET_CLOSE_SERVER_ERROR = 1011,
    SOUP_WEBSOCKET_CLOSE_TLS_HANDSHAKE = 1015,
}

pub const SoupWebsocketState = enum(c_int) {
    SOUP_WEBSOCKET_STATE_OPEN = 1,
    SOUP_WEBSOCKET_STATE_CLOSING = 2,
    SOUP_WEBSOCKET_STATE_CLOSED = 3,
}

pub extern("c") fn soup_websocket_client_prepare_handshake(msg: *types.SoupMessage, origin: ?[*]const gchar, protocols: ?*[*]gchar, supported_extensions: ?*GPtrArray) -> void
pub extern("c") fn soup_websocket_client_verify_handshake(msg: *types.SoupMessage, supported_extensions: ?*GPtrArray, accepted_extensions: ?**GList, error_: ?**GError) -> gboolean
pub extern("c") fn soup_websocket_server_check_handshake(msg: *types.SoupServerMessage, origin: ?[*]const gchar, protocols: ?*[*]gchar, supported_extensions: ?*GPtrArray, error_: ?**GError) -> gboolean
pub extern("c") fn soup_websocket_server_process_handshake(msg: *types.SoupServerMessage, expected_origin: ?[*]const gchar, protocols: ?*[*]gchar, supported_extensions: ?*GPtrArray, accepted_extensions: ?**GList) -> gboolean
