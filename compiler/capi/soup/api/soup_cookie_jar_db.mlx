// libsoup/soup-cookie-jar-db.h
// mlx-soup: SoupCookieJarDB, a cookie jar kept in a file between runs.
// libsoup keeps it in an SQLite database; there is no SQLite here, so
// the file holds the jar as SoupCookieJarText writes one (Mozilla's
// cookies.txt lines), read when the jar is made and written at each
// change.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const jar = @import("./soup_cookie_jar.mlx")
const types = @import("./soup_types.mlx")

pub const SOUP_TYPE_COOKIE_JAR_DB: gtype.GType = soup_cookie_jar_db_get_type()

pub const _SoupCookieJarDB = struct {}
pub const SoupCookieJarDB = _SoupCookieJarDB

pub extern("c") fn soup_cookie_jar_db_get_type() -> gtype.GType
pub extern("c") fn soup_cookie_jar_db_new(filename: [*]const gtypes.gchar, read_only: gtypes.gboolean) -> *types.SoupCookieJar

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupCookieJarDB, soup_cookie_jar_db, SOUP, COOKIE_JAR_DB, SoupCookieJar)\nG_END_DECLS"
