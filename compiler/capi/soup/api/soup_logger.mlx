// libsoup/soup-logger.h
// mlx-soup: SoupLogger, the session feature that writes out the messages
// a session sends and receives (their request and status lines, headers
// and bodies, as much as its level says), to stdout or to a printer.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const gtype = @import("../../glib/api/gtype.mlx")
const types = @import("./soup_types.mlx")

const gchar = gtypes.gchar
const gpointer = gtypes.gpointer
const GDestroyNotify = gtypes.GDestroyNotify
const SoupMessage = types.SoupMessage

pub const SOUP_TYPE_LOGGER: gtype.GType = soup_logger_get_type()

pub const _SoupLogger = struct {}
pub const SoupLogger = _SoupLogger

pub const SoupLoggerLogLevel = enum(c_int) {
    SOUP_LOGGER_LOG_NONE,
    SOUP_LOGGER_LOG_MINIMAL,
    SOUP_LOGGER_LOG_HEADERS,
    SOUP_LOGGER_LOG_BODY,
}

pub const SoupLoggerFilter = fn(logger: *SoupLogger, msg: *SoupMessage, user_data: gpointer) -> SoupLoggerLogLevel
pub const SoupLoggerPrinter = fn(logger: *SoupLogger, level: SoupLoggerLogLevel, direction: c_char, data: [*]const gchar, user_data: gpointer) -> void

pub extern("c") fn soup_logger_get_type() -> gtype.GType
pub extern("c") fn soup_logger_new(level: SoupLoggerLogLevel) -> *SoupLogger
pub extern("c") fn soup_logger_set_request_filter(logger: *SoupLogger, request_filter: ?SoupLoggerFilter, filter_data: gpointer, destroy: ?GDestroyNotify) -> void
pub extern("c") fn soup_logger_set_response_filter(logger: *SoupLogger, response_filter: ?SoupLoggerFilter, filter_data: gpointer, destroy: ?GDestroyNotify) -> void
pub extern("c") fn soup_logger_set_printer(logger: *SoupLogger, printer: ?SoupLoggerPrinter, printer_data: gpointer, destroy: ?GDestroyNotify) -> void
pub extern("c") fn soup_logger_set_max_body_size(logger: *SoupLogger, max_body_size: c_int) -> void
pub extern("c") fn soup_logger_get_max_body_size(logger: *SoupLogger) -> c_int

const c_macros = "G_BEGIN_DECLS\nG_DECLARE_FINAL_TYPE (SoupLogger, soup_logger, SOUP, LOGGER, GObject)\nG_END_DECLS"
