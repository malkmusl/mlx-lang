// libsoup/soup-enum-types.h
// mlx-soup: the GObject types of libsoup's enumerations and flags (what
// glib-mkenums makes for libsoup), with libsoup's value names and nicks.
const c_function_pointers = true
const gtype = @import("../../glib/api/gtype.mlx")
const glibobject = @import("../../glib/api/glibobject.mlx")
const version = @import("./soup_version.mlx")

const GType = gtype.GType

pub extern("c") fn soup_cacheability_get_type() -> GType
pub const SOUP_TYPE_CACHEABILITY: GType = soup_cacheability_get_type()
pub extern("c") fn soup_cache_type_get_type() -> GType
pub const SOUP_TYPE_CACHE_TYPE: GType = soup_cache_type_get_type()
