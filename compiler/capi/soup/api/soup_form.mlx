// libsoup/soup-form.h
// mlx-soup: HTML forms: application/x-www-form-urlencoded data encoded
// from fields and decoded into a table, and multipart/form-data bodies
// decoded with the file they carry.
const c_function_pointers = true
const gtypes = @import("../../glib/api/gtypes.mlx")
const ghash = @import("../../glib/api/ghash.mlx")
const gbytes = @import("../../glib/api/gbytes.mlx")
const gobject = @import("../../glib/api/gobject.mlx")
const types = @import("./soup_types.mlx")
const multipart = @import("./soup_multipart.mlx")

const gchar = gtypes.gchar
const GHashTable = ghash.GHashTable
const GBytes = gbytes.GBytes
const c_varargs = gtypes.c_varargs
const c_va_list = gtypes.c_va_list
pub const c_tokens = usize

pub const SOUP_FORM_MIME_TYPE_URLENCODED: [*]const gchar = "application/x-www-form-urlencoded"
pub const SOUP_FORM_MIME_TYPE_MULTIPART: [*]const gchar = "multipart/form-data"

pub extern("c") fn soup_form_decode(encoded_form: [*]const gchar) -> *GHashTable
pub extern("c") fn soup_form_decode_multipart(multipart_: *multipart.SoupMultipart, file_control_name: ?[*]const gchar, filename: ?*[*]gchar, content_type: ?*[*]gchar, file: ?**GBytes) -> ?*GHashTable
pub extern("c") fn soup_form_encode(first_field: [*]const gchar, rest: c_varargs) -> [*]gchar
pub extern("c") fn soup_form_encode_hash(form_data_set: *GHashTable) -> [*]gchar
pub extern("c") fn soup_form_encode_datalist(form_data_set: **gobject.GData) -> [*]gchar
pub extern("c") fn soup_form_encode_valist(first_field: [*]const gchar, args: c_va_list) -> [*]gchar
