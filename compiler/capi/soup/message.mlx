// soup-message.h: SoupMessage, one HTTP request and its response: the
// method, URI, headers and body stream of the request, the status, reason
// phrase and headers of the response, the TLS facts of the connection it
// went over, and the signals each stage of its exchange is told by. The
// session drives it (session.mlx); what the session needs of it is the
// pub functions here.
//
// A SoupMessage: a GObject and (24) a record of
//   0 the method (interned)          8 the URI (normalized, owned)
//  16 the reason phrase (owned)      24 the status (u32), 28 the flags
//  32 the HTTP version, 36 the version asked for
//  40 the request headers           48 the response headers
//  56 the request body stream       64 the first party URI
//  72 the site for cookies          80 the TLS peer certificate
//  88 its errors (u32), 92 the TLS protocol version
//  96 the TLS ciphersuite name      104 the client certificate to use
// 112 the priority, 116 whether a top-level navigation
// 120 whether an OPTIONS ping, 124 whether a preconnection
// 128 the last connection's id     136 the remote address
// 144 the metrics                  152 the auth, 160 the proxy auth
// 168 the disabled feature types (a GHashTable)
// 176 the connection (conn.mlx's record, while it is on one)
// 184 the content sniffer          192 the session's queue item
// 200 a pending client certificate request (GTask)
// 208 the TLS password asked for   216 the HTTP version forced (255: none)
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const misc = @import("./misc.mlx")
const enums = @import("./enumtypes.mlx")
const metrics = @import("./metrics.mlx")
const tls = @import("./tls.mlx")
const http = @import("std.http.headers")
const status = @import("std.http.status")

extern("c") fn soup_message_headers_get_type() -> usize
extern("c") fn soup_message_headers_new(t: i32) -> usize
extern("c") fn soup_message_headers_unref(h: usize) -> void
extern("c") fn soup_message_headers_clear(h: usize) -> void
extern("c") fn soup_message_headers_get_one(h: usize, name: usize) -> usize
extern("c") fn soup_message_headers_get_list(h: usize, name: usize) -> usize
extern("c") fn soup_message_headers_replace(h: usize, name: usize, value: usize) -> void
extern("c") fn soup_message_headers_append(h: usize, name: usize, value: usize) -> void
extern("c") fn soup_message_headers_remove(h: usize, name: usize) -> void
extern("c") fn soup_message_headers_header_contains(h: usize, name: usize, token: usize) -> i32
extern("c") fn soup_message_headers_get_encoding(h: usize) -> i32
extern("c") fn soup_message_headers_set_encoding(h: usize, encoding: i32) -> void
extern("c") fn soup_message_headers_set_content_length(h: usize, length: i64) -> void
extern("c") fn soup_message_headers_get_content_type(h: usize, params: usize) -> usize
extern("c") fn soup_multipart_to_message(multipart: usize, headers: usize, body: usize) -> void
extern("c") fn soup_auth_get_type() -> usize
extern("c") fn g_closure_set_meta_marshal(closure: usize, data: usize, meta: usize) -> void
extern("c") fn g_closure_add_finalize_notifier(closure: usize, data: usize, notify: usize) -> void
extern("c") fn g_signal_connect_closure(instance: usize, signal: usize, closure: usize, after: i32) -> u64
extern("c") fn g_cclosure_marshal_generic(closure: usize, ret: usize, n: u32, params: usize, hint: usize, data: usize) -> void
extern("c") fn g_signal_accumulator_true_handled(hint: usize, accu: usize, ret: usize, data: usize) -> i32
extern("c") fn g_direct_hash(key: usize) -> u32
extern("c") fn g_direct_equal(a: usize, b: usize) -> i32
extern("c") fn g_hash_table_add(table: usize, key: usize) -> i32
extern("c") fn g_hash_table_get_keys(table: usize) -> usize
extern("c") fn g_type_check_instance_is_a(instance: usize, t: usize) -> i32
extern("c") fn g_socket_address_get_type() -> usize
extern("c") fn g_io_stream_get_type() -> usize
extern("c") fn g_memory_input_stream_new_from_bytes(bytes: usize) -> usize

pub const R_METHOD: usize = 0
pub const R_URI: usize = 8
pub const R_REASON: usize = 16
pub const R_STATUS: usize = 24
pub const R_FLAGS: usize = 28
pub const R_VERSION: usize = 32
pub const R_ORIG_VERSION: usize = 36
pub const R_REQUEST_HEADERS: usize = 40
pub const R_RESPONSE_HEADERS: usize = 48
pub const R_BODY_STREAM: usize = 56
pub const R_FIRST_PARTY: usize = 64
pub const R_SITE_FOR_COOKIES: usize = 72
pub const R_PEER_CERTIFICATE: usize = 80
pub const R_PEER_ERRORS: usize = 88
pub const R_TLS_VERSION: usize = 92
pub const R_CIPHERSUITE: usize = 96
pub const R_CLIENT_CERTIFICATE: usize = 104
pub const R_PRIORITY: usize = 112
pub const R_TOP_LEVEL: usize = 116
pub const R_OPTIONS_PING: usize = 120
pub const R_PRECONNECT: usize = 124
pub const R_CONNECTION_ID: usize = 128
pub const R_REMOTE_ADDRESS: usize = 136
pub const R_METRICS: usize = 144
pub const R_AUTH: usize = 152
pub const R_PROXY_AUTH: usize = 160
pub const R_DISABLED: usize = 168
pub const R_CONNECTION: usize = 176
pub const R_SNIFFER: usize = 184
pub const R_ITEM: usize = 192
pub const R_CERT_REQUEST: usize = 200
pub const R_CERT_PASSWORD: usize = 208
pub const R_FORCE_VERSION: usize = 216
const R_SIZE: usize = 224

// SoupHTTPVersion.
pub const HTTP_1_0: i32 = 0
pub const HTTP_1_1: i32 = 1
pub const HTTP_2_0: i32 = 2

// SoupMessageFlags.
pub const NO_REDIRECT: u32 = 2
pub const NEW_CONNECTION: u32 = 4
pub const IDEMPOTENT: u32 = 8
pub const DO_NOT_USE_AUTH_CACHE: u32 = 16
pub const COLLECT_METRICS: u32 = 32

// SoupMessagePriority.
pub const PRIORITY_NORMAL: i32 = 2

const PROP_METHOD: u32 = 1
const PROP_URI: u32 = 2
const PROP_HTTP_VERSION: u32 = 3
const PROP_FLAGS: u32 = 4
const PROP_STATUS_CODE: u32 = 5
const PROP_REASON_PHRASE: u32 = 6
const PROP_FIRST_PARTY: u32 = 7
const PROP_REQUEST_HEADERS: u32 = 8
const PROP_RESPONSE_HEADERS: u32 = 9
const PROP_TLS_PEER_CERTIFICATE: u32 = 10
const PROP_TLS_PEER_CERTIFICATE_ERRORS: u32 = 11
const PROP_TLS_PROTOCOL_VERSION: u32 = 12
const PROP_TLS_CIPHERSUITE_NAME: u32 = 13
const PROP_REMOTE_ADDRESS: u32 = 14
const PROP_PRIORITY: u32 = 15
const PROP_SITE_FOR_COOKIES: u32 = 16
const PROP_IS_TOP_LEVEL_NAVIGATION: u32 = 17
const PROP_IS_OPTIONS_PING: u32 = 18

var messageType: usize = 0

// The signals' ids.
var sigWroteHeaders: u32 = 0
var sigWroteBodyData: u32 = 0
var sigWroteBody: u32 = 0
var sigGotInformational: u32 = 0
var sigGotHeaders: u32 = 0
var sigGotBodyData: u32 = 0
var sigGotBody: u32 = 0
var sigContentSniffed: u32 = 0
var sigStarting: u32 = 0
var sigRestarted: u32 = 0
var sigFinished: u32 = 0
var sigAuthenticate: u32 = 0
var sigNetworkEvent: u32 = 0
var sigAcceptCertificate: u32 = 0
var sigRequestCertificate: u32 = 0
var sigRequestCertificatePassword: u32 = 0
var sigHstsEnforced: u32 = 0

// The pspecs notified by the setters.
var specs: [19]usize = undefined

pub fn rec(msg: usize) -> usize { return m.getWord(msg + 24) }

pub fn messageTypeGet() -> usize {
    if c.onceEnter(&messageType) {
        c.onceLeave(&messageType, c.defineType(c.T_OBJECT, "SoupMessage", 136, @intFromPtr(__mlx_soup_message_class_init), 32, @intFromPtr(__mlx_soup_message_init), c.FINAL))
    }
    return messageType
}

export fn soup_message_get_type() -> usize { return messageTypeGet() }

pub fn isMessage(object: usize) -> bool { return object != 0 && g_type_check_instance_is_a(object, messageTypeGet()) != 0 }

export fn __mlx_soup_message_init(msg: usize, class: usize) -> void {
    const r = m.alloc(R_SIZE)
    m.putWord(msg + 24, r)
    m.putI32(r + R_VERSION, HTTP_1_1)
    m.putI32(r + R_ORIG_VERSION, HTTP_1_1)
    m.putI32(r + R_PRIORITY, PRIORITY_NORMAL)
    m.putI32(r + R_FORCE_VERSION, 255)
    m.putWord(r + R_REQUEST_HEADERS, soup_message_headers_new(0))
    m.putWord(r + R_RESPONSE_HEADERS, soup_message_headers_new(1))
}

export fn __mlx_soup_message_finalize(msg: usize) -> void {
    const r = rec(msg)
    if m.getWord(r + R_CERT_REQUEST) != 0 {
        // G_TLS_INTERACTION_FAILED.
        g.g_task_return_int(m.getWord(r + R_CERT_REQUEST), 2)
        g.g_object_unref(m.getWord(r + R_CERT_REQUEST))
    }
    c.clearObject(r + R_CERT_PASSWORD)
    unrefUri(r + R_URI)
    unrefUri(r + R_FIRST_PARTY)
    unrefUri(r + R_SITE_FOR_COOKIES)
    m.release(m.getWord(r + R_METRICS))
    m.release(m.getWord(r + R_CIPHERSUITE))
    c.clearObject(r + R_AUTH)
    c.clearObject(r + R_PROXY_AUTH)
    if m.getWord(r + R_DISABLED) != 0 { g.g_hash_table_destroy(m.getWord(r + R_DISABLED)) }
    c.clearObject(r + R_PEER_CERTIFICATE)
    c.clearObject(r + R_REMOTE_ADDRESS)
    c.clearObject(r + R_CLIENT_CERTIFICATE)
    c.clearObject(r + R_SNIFFER)
    soup_message_headers_unref(m.getWord(r + R_REQUEST_HEADERS))
    soup_message_headers_unref(m.getWord(r + R_RESPONSE_HEADERS))
    c.clearObject(r + R_BODY_STREAM)
    m.release(m.getWord(r + R_REASON))
    m.release(r)
    c.chainUp(g.g_type_class_ref(messageTypeGet()), 48, msg)
}

fn unrefUri(field: usize) -> void {
    const uri = m.getWord(field)
    m.putWord(field, 0)
    if uri != 0 { g.g_uri_unref(uri) }
}

export fn __mlx_soup_message_set_property(msg: usize, id: u32, value: usize, pspec: usize) -> void {
    if id == PROP_METHOD {
        soup_message_set_method(msg, g.g_value_get_string(value))
    } else if id == PROP_URI {
        soup_message_set_uri(msg, g.g_value_get_boxed(value))
    } else if id == PROP_SITE_FOR_COOKIES {
        soup_message_set_site_for_cookies(msg, g.g_value_get_boxed(value))
    } else if id == PROP_IS_TOP_LEVEL_NAVIGATION {
        soup_message_set_is_top_level_navigation(msg, g.g_value_get_boolean(value))
    } else if id == PROP_FLAGS {
        soup_message_set_flags(msg, g.g_value_get_flags(value))
    } else if id == PROP_FIRST_PARTY {
        soup_message_set_first_party(msg, g.g_value_get_boxed(value))
    } else if id == PROP_PRIORITY {
        soup_message_set_priority(msg, g.g_value_get_enum(value))
    } else if id == PROP_IS_OPTIONS_PING {
        soup_message_set_is_options_ping(msg, g.g_value_get_boolean(value))
    }
}

export fn __mlx_soup_message_get_property(msg: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = rec(msg)
    if id == PROP_METHOD {
        g.g_value_set_string(value, m.getWord(r + R_METHOD))
    } else if id == PROP_URI {
        g.g_value_set_boxed(value, m.getWord(r + R_URI))
    } else if id == PROP_SITE_FOR_COOKIES {
        g.g_value_set_boxed(value, m.getWord(r + R_SITE_FOR_COOKIES))
    } else if id == PROP_IS_TOP_LEVEL_NAVIGATION {
        g.g_value_set_boolean(value, m.getI32(r + R_TOP_LEVEL))
    } else if id == PROP_HTTP_VERSION {
        g.g_value_set_enum(value, m.getI32(r + R_VERSION))
    } else if id == PROP_FLAGS {
        g.g_value_set_flags(value, m.get32(r + R_FLAGS))
    } else if id == PROP_STATUS_CODE {
        g.g_value_set_uint(value, m.get32(r + R_STATUS))
    } else if id == PROP_REASON_PHRASE {
        g.g_value_set_string(value, m.getWord(r + R_REASON))
    } else if id == PROP_FIRST_PARTY {
        g.g_value_set_boxed(value, m.getWord(r + R_FIRST_PARTY))
    } else if id == PROP_REQUEST_HEADERS {
        g.g_value_set_boxed(value, m.getWord(r + R_REQUEST_HEADERS))
    } else if id == PROP_RESPONSE_HEADERS {
        g.g_value_set_boxed(value, m.getWord(r + R_RESPONSE_HEADERS))
    } else if id == PROP_TLS_PEER_CERTIFICATE {
        g.g_value_set_object(value, m.getWord(r + R_PEER_CERTIFICATE))
    } else if id == PROP_TLS_PEER_CERTIFICATE_ERRORS {
        g.g_value_set_flags(value, m.get32(r + R_PEER_ERRORS))
    } else if id == PROP_TLS_PROTOCOL_VERSION {
        g.g_value_set_enum(value, m.getI32(r + R_TLS_VERSION))
    } else if id == PROP_TLS_CIPHERSUITE_NAME {
        g.g_value_set_string(value, m.getWord(r + R_CIPHERSUITE))
    } else if id == PROP_REMOTE_ADDRESS {
        g.g_value_set_object(value, m.getWord(r + R_REMOTE_ADDRESS))
    } else if id == PROP_PRIORITY {
        g.g_value_set_enum(value, m.getI32(r + R_PRIORITY))
    } else if id == PROP_IS_OPTIONS_PING {
        g.g_value_set_boolean(value, m.getI32(r + R_OPTIONS_PING))
    }
}

export fn __mlx_soup_message_class_init(class: usize, data: usize) -> void {
    m.putWord(class + 24, @intFromPtr(__mlx_soup_message_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_message_get_property))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_message_finalize))
    const none = c.T_NONE
    sigWroteHeaders = c.signal(class, "wrote-headers", c.RUN_FIRST, 0, 0, none, 0, 0, 0, 0, 0)
    sigWroteBodyData = c.signal(class, "wrote-body-data", c.RUN_FIRST, 0, 0, none, 1, c.T_UINT, 0, 0, 0)
    sigWroteBody = c.signal(class, "wrote-body", c.RUN_FIRST, 0, 0, none, 0, 0, 0, 0, 0)
    sigGotInformational = c.signal(class, "got-informational", c.RUN_FIRST, 0, 0, none, 0, 0, 0, 0, 0)
    sigGotHeaders = c.signal(class, "got-headers", c.RUN_FIRST, 0, 0, none, 0, 0, 0, 0, 0)
    sigGotBodyData = c.signal(class, "got-body-data", c.RUN_FIRST, 0, 0, none, 1, c.T_UINT, 0, 0, 0)
    sigGotBody = c.signal(class, "got-body", c.RUN_FIRST, 0, 0, none, 0, 0, 0, 0, 0)
    sigContentSniffed = c.signal(class, "content-sniffed", c.RUN_FIRST, 0, 0, none, 2, c.T_STRING, g.g_hash_table_get_type(), 0, 0)
    sigStarting = c.signal(class, "starting", c.RUN_FIRST, 0, 0, none, 0, 0, 0, 0, 0)
    sigRestarted = c.signal(class, "restarted", c.RUN_FIRST, 0, 0, none, 0, 0, 0, 0, 0)
    sigFinished = c.signal(class, "finished", c.RUN_FIRST, 0, 0, none, 0, 0, 0, 0, 0)
    const handled = @intFromPtr(g_signal_accumulator_true_handled)
    sigAuthenticate = c.signal(class, "authenticate", c.RUN_LAST, 0, handled, c.T_BOOLEAN, 2, soup_auth_get_type(), c.T_BOOLEAN, 0, 0)
    sigNetworkEvent = c.signal(class, "network-event", c.RUN_FIRST, 0, 0, none, 2, g.g_socket_client_event_get_type(), g_io_stream_get_type(), 0, 0)
    sigAcceptCertificate = c.signal(class, "accept-certificate", c.RUN_LAST, 0, handled, c.T_BOOLEAN, 2, g.g_tls_certificate_get_type(), tls.certificateFlagsType(), 0, 0)
    sigRequestCertificate = c.signal(class, "request-certificate", c.RUN_LAST, 0, handled, c.T_BOOLEAN, 1, g.g_tls_client_connection_get_type(), 0, 0, 0)
    sigRequestCertificatePassword = c.signal(class, "request-certificate-password", c.RUN_LAST, 0, handled, c.T_BOOLEAN, 1, g.g_tls_password_get_type(), 0, 0, 0)
    sigHstsEnforced = c.signal(class, "hsts-enforced", c.RUN_LAST, 0, 0, none, 0, 0, 0, 0, 0)

    const rw = c.READWRITE
    specs[PROP_METHOD] = c.stringProperty(class, PROP_METHOD, "method", rw)
    specs[PROP_URI] = c.boxedProperty(class, PROP_URI, "uri", g.g_uri_get_type(), rw)
    specs[PROP_HTTP_VERSION] = c.enumProperty(class, PROP_HTTP_VERSION, "http-version", enums.httpVersionTypeGet(), HTTP_1_1, c.READABLE)
    specs[PROP_FLAGS] = c.flagsProperty(class, PROP_FLAGS, "flags", enums.messageFlagsTypeGet(), 0, rw)
    specs[PROP_STATUS_CODE] = c.uintProperty(class, PROP_STATUS_CODE, "status-code", 0, 999, 0, c.READABLE)
    specs[PROP_REASON_PHRASE] = c.stringProperty(class, PROP_REASON_PHRASE, "reason-phrase", c.READABLE)
    specs[PROP_FIRST_PARTY] = c.boxedProperty(class, PROP_FIRST_PARTY, "first-party", g.g_uri_get_type(), rw)
    specs[PROP_SITE_FOR_COOKIES] = c.boxedProperty(class, PROP_SITE_FOR_COOKIES, "site-for-cookies", g.g_uri_get_type(), rw)
    specs[PROP_IS_TOP_LEVEL_NAVIGATION] = c.booleanProperty(class, PROP_IS_TOP_LEVEL_NAVIGATION, "is-top-level-navigation", false, rw)
    specs[PROP_REQUEST_HEADERS] = c.boxedProperty(class, PROP_REQUEST_HEADERS, "request-headers", soup_message_headers_get_type(), c.READABLE)
    specs[PROP_RESPONSE_HEADERS] = c.boxedProperty(class, PROP_RESPONSE_HEADERS, "response-headers", soup_message_headers_get_type(), c.READABLE)
    specs[PROP_TLS_PEER_CERTIFICATE] = c.objectProperty(class, PROP_TLS_PEER_CERTIFICATE, "tls-peer-certificate", g.g_tls_certificate_get_type(), c.READABLE)
    specs[PROP_TLS_PEER_CERTIFICATE_ERRORS] = c.flagsProperty(class, PROP_TLS_PEER_CERTIFICATE_ERRORS, "tls-peer-certificate-errors", tls.certificateFlagsType(), 0, c.READABLE)
    specs[PROP_TLS_PROTOCOL_VERSION] = c.enumProperty(class, PROP_TLS_PROTOCOL_VERSION, "tls-protocol-version", tls.protocolVersionType(), 0, c.READABLE)
    specs[PROP_TLS_CIPHERSUITE_NAME] = c.stringProperty(class, PROP_TLS_CIPHERSUITE_NAME, "tls-ciphersuite-name", c.READABLE)
    specs[PROP_REMOTE_ADDRESS] = c.objectProperty(class, PROP_REMOTE_ADDRESS, "remote-address", g_socket_address_get_type(), c.READABLE)
    specs[PROP_PRIORITY] = c.enumProperty(class, PROP_PRIORITY, "priority", enums.messagePriorityTypeGet(), PRIORITY_NORMAL, rw)
    specs[PROP_IS_OPTIONS_PING] = c.booleanProperty(class, PROP_IS_OPTIONS_PING, "is-options-ping", false, rw)
}

fn notify(msg: usize, id: u32) -> void { g.g_object_notify_by_pspec(msg, specs[id]) }

// ---------------------------------------------------------------------------
// Construction

fn newMessage(method: usize, uri: usize) -> usize {
    const msg = g.g_object_new(messageTypeGet(), 0)
    soup_message_set_method(msg, method)
    soup_message_set_uri(msg, uri)
    return msg
}

export fn soup_message_new(method: usize, uri_string: usize) -> usize {
    if method == 0 || uri_string == 0 { return 0 }
    const uri = g.g_uri_parse(uri_string, misc.HTTP_URI_FLAGS, 0)
    if uri == 0 { return 0 }
    if !misc.isValid(uri) {
        g.g_uri_unref(uri)
        return 0
    }
    const msg = newMessage(method, uri)
    g.g_uri_unref(uri)
    return msg
}

export fn soup_message_new_from_uri(method: usize, uri: usize) -> usize {
    if method == 0 || !misc.isValid(uri) {
        c.critical("soup_message_new_from_uri: assertion 'soup_uri_is_valid (uri)' failed")
        return 0
    }
    return newMessage(method, uri)
}

export fn soup_message_new_options_ping(base_uri: usize) -> usize {
    if !misc.isValid(base_uri) {
        c.critical("soup_message_new_options_ping: assertion 'soup_uri_is_valid (base_uri)' failed")
        return 0
    }
    const msg = newMessage(m.literal("OPTIONS"), base_uri)
    soup_message_set_is_options_ping(msg, 1)
    return msg
}

extern("c") fn soup_uri_copy(uri: usize, first: i32, value: usize, end: i32) -> usize

export fn soup_message_new_from_encoded_form(method: usize, uri_string: usize, encoded_form: usize) -> usize {
    if method == 0 || uri_string == 0 || encoded_form == 0 { return 0 }
    const uri = g.g_uri_parse(uri_string, misc.HTTP_URI_FLAGS, 0)
    if uri == 0 || g.g_uri_get_host(uri) == 0 {
        g.g_free(encoded_form)
        if uri != 0 { g.g_uri_unref(uri) }
        return 0
    }
    var msg: usize = 0
    const name = m.cSlice(method)
    if m.same(name, "GET") {
        // SOUP_URI_QUERY is 8, SOUP_URI_NONE 0.
        const withQuery = soup_uri_copy(uri, 8, encoded_form, 0)
        msg = soup_message_new_from_uri(method, withQuery)
        g.g_uri_unref(withQuery)
        g.g_free(encoded_form)
    } else if m.same(name, "POST") || m.same(name, "PUT") {
        msg = soup_message_new_from_uri(method, uri)
        const body = g.g_bytes_new_take(encoded_form, m.cLength(encoded_form))
        soup_message_set_request_body_from_bytes(msg, m.literal("application/x-www-form-urlencoded"), body)
        g.g_bytes_unref(body)
    } else {
        g.g_free(encoded_form)
    }
    g.g_uri_unref(uri)
    return msg
}

export fn soup_message_new_from_multipart(uri_string: usize, multipart: usize) -> usize {
    if uri_string == 0 || multipart == 0 { return 0 }
    const uri = g.g_uri_parse(uri_string, misc.HTTP_URI_FLAGS, 0)
    if uri == 0 || g.g_uri_get_host(uri) == 0 {
        if uri != 0 { g.g_uri_unref(uri) }
        return 0
    }
    const msg = soup_message_new_from_uri(m.literal("POST"), uri)
    const cell = m.alloc(8)
    soup_multipart_to_message(multipart, requestHeaders(msg), cell)
    const body = m.getWord(cell)
    m.release(cell)
    soup_message_set_request_body_from_bytes(msg, soup_message_headers_get_content_type(requestHeaders(msg), 0), body)
    g.g_bytes_unref(body)
    g.g_uri_unref(uri)
    return msg
}

// ---------------------------------------------------------------------------
// The request body

export fn soup_message_set_request_body(msg: usize, content_type: usize, stream: usize, content_length: i64) -> void {
    const r = rec(msg)
    c.clearObject(r + R_BODY_STREAM)
    const hdrs = m.getWord(r + R_REQUEST_HEADERS)
    if stream != 0 {
        if content_type != 0 && soup_message_headers_get_content_type(hdrs, 0) != content_type {
            soup_message_headers_replace(hdrs, m.literal("Content-Type"), content_type)
        }
        if content_length == -1 {
            soup_message_headers_set_encoding(hdrs, 4)
        } else {
            soup_message_headers_set_content_length(hdrs, content_length)
        }
        m.putWord(r + R_BODY_STREAM, g.g_object_ref(stream))
    } else {
        soup_message_headers_remove(hdrs, m.literal("Content-Type"))
        soup_message_headers_remove(hdrs, m.literal("Content-Length"))
    }
}

export fn soup_message_set_request_body_from_bytes(msg: usize, content_type: usize, bytes: usize) -> void {
    if bytes != 0 {
        const stream = g_memory_input_stream_new_from_bytes(bytes)
        soup_message_set_request_body(msg, content_type, stream, @intCast(i64, g.g_bytes_get_size(bytes)))
        g.g_object_unref(stream)
    } else {
        soup_message_set_request_body(msg, 0, 0, 0)
    }
}

pub fn requestBodyStream(msg: usize) -> usize { return m.getWord(rec(msg) + R_BODY_STREAM) }

// ---------------------------------------------------------------------------
// The signals, emitted by the session

pub fn wroteHeaders(msg: usize) -> void { c.emitPlain(msg, sigWroteHeaders) }
pub fn wroteBodyData(msg: usize, count: usize) -> void { c.emitOne(msg, sigWroteBodyData, c.T_UINT, count) }
pub fn wroteBody(msg: usize) -> void { c.emitPlain(msg, sigWroteBody) }
pub fn gotInformational(msg: usize) -> void { c.emitPlain(msg, sigGotInformational) }
pub fn gotHeaders(msg: usize) -> void { c.emitPlain(msg, sigGotHeaders) }
pub fn gotBodyData(msg: usize, count: usize) -> void { c.emitOne(msg, sigGotBodyData, c.T_UINT, count) }
pub fn gotBody(msg: usize) -> void { c.emitPlain(msg, sigGotBody) }
pub fn contentSniffed(msg: usize, contentType: usize, params: usize) -> void { c.emitTwo(msg, sigContentSniffed, c.T_STRING, contentType, g.g_hash_table_get_type(), params) }
pub fn starting(msg: usize) -> void { c.emitPlain(msg, sigStarting) }
pub fn hstsEnforced(msg: usize) -> void { c.emitPlain(msg, sigHstsEnforced) }

pub fn restarted(msg: usize) -> void {
    c.clearObject(rec(msg) + R_BODY_STREAM)
    c.emitPlain(msg, sigRestarted)
}

pub fn finished(msg: usize) -> void {
    c.emitPlain(msg, sigFinished)
    m.putI32(rec(msg) + R_FORCE_VERSION, 255)
}

// Whether a handler of "authenticate" took the auth on.
pub fn authenticate(msg: usize, auth: usize, retrying: bool) -> bool {
    var ts: [2]usize = [2]usize{ soup_auth_get_type(), c.T_BOOLEAN }
    var args: [2]usize = [2]usize{ auth, if retrying { 1 } else { 0 } }
    return c.emitBoolean(msg, sigAuthenticate, 2, ts[0..2], args[0..2])
}

pub fn networkEvent(msg: usize, event: i32, connection: usize) -> void {
    stampForEvent(msg, event)
    c.emitTwo(msg, sigNetworkEvent, g.g_socket_client_event_get_type(), @bitCast(usize, @intCast(i64, event)), g_io_stream_get_type(), connection)
}

pub fn acceptCertificate(msg: usize, certificate: usize, errors: u32) -> bool {
    var ts: [2]usize = [2]usize{ g.g_tls_certificate_get_type(), tls.certificateFlagsType() }
    var args: [2]usize = [2]usize{ certificate, @intCast(usize, errors) }
    return c.emitBoolean(msg, sigAcceptCertificate, 2, ts[0..2], args[0..2])
}

pub fn requestCertificate(msg: usize, connection: usize) -> bool {
    var ts: [1]usize = [1]usize{ g.g_tls_client_connection_get_type() }
    var args: [1]usize = [1]usize{ connection }
    return c.emitBoolean(msg, sigRequestCertificate, 1, ts[0..1], args[0..1])
}

pub fn requestCertificatePassword(msg: usize, password: usize) -> bool {
    var ts: [1]usize = [1]usize{ g.g_tls_password_get_type() }
    var args: [1]usize = [1]usize{ password }
    return c.emitBoolean(msg, sigRequestCertificatePassword, 1, ts[0..1], args[0..1])
}

// GSocketClientEvent's stages as the metrics' times.
fn stampForEvent(msg: usize, event: i32) -> void {
    const mx = metricsOf(msg)
    if event == 0 { metrics.stamp(mx, metrics.DNS_START) }
    if event == 1 { metrics.stamp(mx, metrics.DNS_END) }
    if event == 2 { metrics.stamp(mx, metrics.CONNECT_START) }
    if event == 6 { metrics.stamp(mx, metrics.TLS_START) }
    if event == 8 { metrics.stamp(mx, metrics.CONNECT_END) }
}

// ---------------------------------------------------------------------------
// Handlers run only for a header or a status

// The closure's data: the header's name (owned) or the status.
export fn __mlx_soup_header_handler_free(name: usize, closure: usize) -> void { m.release(name) }

fn invokeClosure(closure: usize, ret: usize, n: u32, params: usize, hint: usize) -> void {
    const marshal = m.getWord(closure + 8)
    const callback = m.getWord(closure + 32)
    if marshal != 0 {
        const call: MarshalFn = unsafe { @ptrFromInt(MarshalFn, marshal) }
        call(closure, ret, n, params, hint, callback)
    } else {
        g_cclosure_marshal_generic(closure, ret, n, params, hint, callback)
    }
}

pub const MarshalFn = fn(usize, usize, u32, usize, usize, usize) -> void

export fn __mlx_soup_header_meta(closure: usize, ret: usize, n: u32, params: usize, hint: usize, name: usize) -> void {
    const msg = g.g_value_get_object(params)
    if soup_message_headers_get_one(responseHeaders(msg), name) != 0 { invokeClosure(closure, ret, n, params, hint) }
}

export fn __mlx_soup_status_meta(closure: usize, ret: usize, n: u32, params: usize, hint: usize, code: usize) -> void {
    const msg = g.g_value_get_object(params)
    if @intCast(usize, m.get32(rec(msg) + R_STATUS)) == code { invokeClosure(closure, ret, n, params, hint) }
}

export fn soup_message_add_header_handler(msg: usize, signal: usize, header: usize, callback: usize, user_data: usize) -> u32 {
    if !isMessage(msg) || signal == 0 || header == 0 || callback == 0 { return 0 }
    const closure = g.g_cclosure_new(callback, user_data, 0)
    const name = m.dup(header)
    g_closure_set_meta_marshal(closure, name, @intFromPtr(__mlx_soup_header_meta))
    g_closure_add_finalize_notifier(closure, name, @intFromPtr(__mlx_soup_header_handler_free))
    return @intCast(u32, g_signal_connect_closure(msg, signal, closure, 0) & 0xffffffff)
}

export fn soup_message_add_status_code_handler(msg: usize, signal: usize, status_code: u32, callback: usize, user_data: usize) -> u32 {
    if !isMessage(msg) || signal == 0 || callback == 0 { return 0 }
    const closure = g.g_cclosure_new(callback, user_data, 0)
    g_closure_set_meta_marshal(closure, @intCast(usize, status_code), @intFromPtr(__mlx_soup_status_meta))
    return @intCast(u32, g_signal_connect_closure(msg, signal, closure, 0) & 0xffffffff)
}

// ---------------------------------------------------------------------------
// Auths

export fn soup_message_set_auth(msg: usize, auth: usize) -> void { c.replaceObject(rec(msg) + R_AUTH, auth) }
export fn soup_message_get_auth(msg: usize) -> usize { return m.getWord(rec(msg) + R_AUTH) }
export fn soup_message_set_proxy_auth(msg: usize, auth: usize) -> void { c.replaceObject(rec(msg) + R_PROXY_AUTH, auth) }
export fn soup_message_get_proxy_auth(msg: usize) -> usize { return m.getWord(rec(msg) + R_PROXY_AUTH) }

pub fn setAuth(msg: usize, auth: usize) -> void { c.replaceObject(rec(msg) + R_AUTH, auth) }
pub fn auth(msg: usize) -> usize { return m.getWord(rec(msg) + R_AUTH) }
pub fn setProxyAuth(msg: usize, auth: usize) -> void { c.replaceObject(rec(msg) + R_PROXY_AUTH, auth) }
pub fn proxyAuth(msg: usize) -> usize { return m.getWord(rec(msg) + R_PROXY_AUTH) }

// ---------------------------------------------------------------------------
// The connection's facts

pub fn setTlsPeerCertificate(msg: usize, certificate: usize, errors: u32) -> void {
    const r = rec(msg)
    if m.getWord(r + R_PEER_CERTIFICATE) == certificate && m.get32(r + R_PEER_ERRORS) == errors { return }
    c.replaceObject(r + R_PEER_CERTIFICATE, certificate)
    m.put32(r + R_PEER_ERRORS, errors)
    notify(msg, PROP_TLS_PEER_CERTIFICATE)
    notify(msg, PROP_TLS_PEER_CERTIFICATE_ERRORS)
}

pub fn setTlsProtocolVersion(msg: usize, version: i32) -> void {
    const r = rec(msg)
    if m.getI32(r + R_TLS_VERSION) == version { return }
    m.putI32(r + R_TLS_VERSION, version)
    notify(msg, PROP_TLS_PROTOCOL_VERSION)
}

pub fn setTlsCiphersuiteName(msg: usize, name: usize) -> void {
    const r = rec(msg)
    if c.cEquals(m.getWord(r + R_CIPHERSUITE), name) { return }
    c.replaceString(r + R_CIPHERSUITE, name)
    notify(msg, PROP_TLS_CIPHERSUITE_NAME)
}

pub fn setRemoteAddress(msg: usize, address: usize) -> void {
    const r = rec(msg)
    if m.getWord(r + R_REMOTE_ADDRESS) == address { return }
    c.replaceObject(r + R_REMOTE_ADDRESS, address)
    notify(msg, PROP_REMOTE_ADDRESS)
}

pub fn connection(msg: usize) -> usize { return m.getWord(rec(msg) + R_CONNECTION) }

// The connection the message goes over (0: none). conn.mlx keeps the
// connection's side (in use, its id); the TLS facts are copied here.
pub fn setConnection(msg: usize, conn: usize, id: u64, certificate: usize, errors: u32, version: i32, ciphersuite: usize, address: usize) -> void {
    const r = rec(msg)
    m.putWord(r + R_CONNECTION, conn)
    if conn == 0 { return }
    m.putWord(r + R_CONNECTION_ID, id)
    setTlsPeerCertificate(msg, certificate, errors)
    setTlsProtocolVersion(msg, version)
    setTlsCiphersuiteName(msg, ciphersuite)
    setRemoteAddress(msg, address)
}

pub fn clientCertificate(msg: usize) -> usize { return m.getWord(rec(msg) + R_CLIENT_CERTIFICATE) }

// Clears the response for the message's next try: the headers, status
// and version; the connection's facts when it is not on one.
pub fn cleanupResponse(msg: usize) -> void {
    const r = rec(msg)
    g.g_object_freeze_notify(msg)
    soup_message_headers_clear(m.getWord(r + R_RESPONSE_HEADERS))
    setStatus(msg, 0, 0)
    setHttpVersion(msg, m.getI32(r + R_ORIG_VERSION))
    if m.getWord(r + R_CONNECTION) == 0 {
        setTlsPeerCertificate(msg, 0, 0)
        setTlsProtocolVersion(msg, 0)
        setTlsCiphersuiteName(msg, 0)
        setRemoteAddress(msg, 0)
        m.putWord(r + R_CONNECTION_ID, 0)
    }
    g.g_object_thaw_notify(msg)
}

// ---------------------------------------------------------------------------
// Flags, version, URIs

export fn soup_message_set_flags(msg: usize, flags: u32) -> void {
    const r = rec(msg)
    if m.get32(r + R_FLAGS) == flags { return }
    m.put32(r + R_FLAGS, flags)
    notify(msg, PROP_FLAGS)
}

export fn soup_message_get_flags(msg: usize) -> u32 { return m.get32(rec(msg) + R_FLAGS) }
export fn soup_message_add_flags(msg: usize, flags: u32) -> void { soup_message_set_flags(msg, m.get32(rec(msg) + R_FLAGS) | flags) }
export fn soup_message_query_flags(msg: usize, flags: u32) -> i32 { return if (m.get32(rec(msg) + R_FLAGS) & flags) != 0 { 1 } else { 0 } }
export fn soup_message_remove_flags(msg: usize, flags: u32) -> void { soup_message_set_flags(msg, m.get32(rec(msg) + R_FLAGS) & (flags ^ 0xffffffff)) }

pub fn removeFlag(msg: usize, flag: u32) -> void { soup_message_set_flags(msg, m.get32(rec(msg) + R_FLAGS) & (flag ^ 0xffffffff)) }

pub fn hasFlag(msg: usize, flag: u32) -> bool { return (m.get32(rec(msg) + R_FLAGS) & flag) != 0 }

pub fn setHttpVersion(msg: usize, version: i32) -> void {
    const r = rec(msg)
    if m.getI32(r + R_VERSION) == version { return }
    m.putI32(r + R_VERSION, version)
    if m.get32(r + R_STATUS) == 0 { m.putI32(r + R_ORIG_VERSION, version) }
    notify(msg, PROP_HTTP_VERSION)
}

export fn soup_message_get_http_version(msg: usize) -> i32 { return m.getI32(rec(msg) + R_VERSION) }

pub fn httpVersion(msg: usize) -> i32 { return m.getI32(rec(msg) + R_VERSION) }

pub fn isKeepalive(msg: usize) -> bool {
    const r = rec(msg)
    const version = m.getI32(r + R_VERSION)
    if version == HTTP_2_0 { return false }
    if m.get32(r + R_STATUS) == 200 && m.cEqual(m.getWord(r + R_METHOD), m.literal("CONNECT")) { return true }
    const response = m.getWord(r + R_RESPONSE_HEADERS)
    // SOUP_ENCODING_EOF.
    if soup_message_headers_get_encoding(response) == 3 { return false }
    if version == HTTP_1_0 {
        return soup_message_headers_header_contains(response, m.literal("Connection"), m.literal("Keep-Alive")) != 0
    }
    const request = m.getWord(r + R_REQUEST_HEADERS)
    if soup_message_headers_header_contains(request, m.literal("Connection"), m.literal("close")) != 0 { return false }
    if soup_message_headers_header_contains(response, m.literal("Connection"), m.literal("close")) != 0 { return false }
    return true
}

export fn soup_message_is_keepalive(msg: usize) -> i32 { return if isKeepalive(msg) { 1 } else { 0 } }

export fn soup_message_set_uri(msg: usize, uri: usize) -> void {
    if uri == 0 { return }
    const r = rec(msg)
    const n = misc.normalized(uri)
    if m.getWord(r + R_URI) != 0 {
        if misc.uriEqual(m.getWord(r + R_URI), n) {
            g.g_uri_unref(n)
            return
        }
        g.g_uri_unref(m.getWord(r + R_URI))
    }
    m.putWord(r + R_URI, n)
    notify(msg, PROP_URI)
}

export fn soup_message_get_uri(msg: usize) -> usize { return m.getWord(rec(msg) + R_URI) }

pub fn uri(msg: usize) -> usize { return m.getWord(rec(msg) + R_URI) }

export fn soup_message_get_first_party(msg: usize) -> usize { return m.getWord(rec(msg) + R_FIRST_PARTY) }

export fn soup_message_set_first_party(msg: usize, first_party: usize) -> void {
    if first_party == 0 { return }
    const r = rec(msg)
    const n = misc.normalized(first_party)
    if m.getWord(r + R_FIRST_PARTY) != 0 {
        if misc.uriEqual(m.getWord(r + R_FIRST_PARTY), n) {
            g.g_uri_unref(n)
            return
        }
        g.g_uri_unref(m.getWord(r + R_FIRST_PARTY))
    }
    m.putWord(r + R_FIRST_PARTY, n)
    notify(msg, PROP_FIRST_PARTY)
}

export fn soup_message_get_site_for_cookies(msg: usize) -> usize { return m.getWord(rec(msg) + R_SITE_FOR_COOKIES) }

export fn soup_message_set_site_for_cookies(msg: usize, site_for_cookies: usize) -> void {
    const r = rec(msg)
    var n: usize = 0
    if site_for_cookies != 0 { n = misc.normalized(site_for_cookies) }
    const old = m.getWord(r + R_SITE_FOR_COOKIES)
    if old != 0 {
        if n != 0 && misc.uriEqual(old, n) {
            g.g_uri_unref(n)
            return
        }
        g.g_uri_unref(old)
    }
    m.putWord(r + R_SITE_FOR_COOKIES, n)
    notify(msg, PROP_SITE_FOR_COOKIES)
}

export fn soup_message_set_is_top_level_navigation(msg: usize, value: i32) -> void {
    const r = rec(msg)
    const v: i32 = if value != 0 { 1 } else { 0 }
    if m.getI32(r + R_TOP_LEVEL) == v { return }
    m.putI32(r + R_TOP_LEVEL, v)
    notify(msg, PROP_IS_TOP_LEVEL_NAVIGATION)
}

export fn soup_message_get_is_top_level_navigation(msg: usize) -> i32 { return m.getI32(rec(msg) + R_TOP_LEVEL) }

// ---------------------------------------------------------------------------
// Status, method, headers

pub fn setReasonPhrase(msg: usize, reason: usize) -> void {
    const r = rec(msg)
    if c.cEquals(m.getWord(r + R_REASON), reason) { return }
    c.replaceString(r + R_REASON, reason)
    notify(msg, PROP_REASON_PHRASE)
}

pub fn setStatus(msg: usize, code: u32, reason: usize) -> void {
    const r = rec(msg)
    g.g_object_freeze_notify(msg)
    if m.get32(r + R_STATUS) != code {
        m.put32(r + R_STATUS, code)
        notify(msg, PROP_STATUS_CODE)
    }
    if reason != 0 {
        setReasonPhrase(msg, reason)
    } else if code != 0 {
        const phrase = m.dupSlice(status.phrase(code))
        setReasonPhrase(msg, phrase)
        m.release(phrase)
    } else {
        setReasonPhrase(msg, 0)
    }
    g.g_object_thaw_notify(msg)
}

export fn soup_message_get_status(msg: usize) -> u32 { return m.get32(rec(msg) + R_STATUS) }
export fn soup_message_get_reason_phrase(msg: usize) -> usize { return m.getWord(rec(msg) + R_REASON) }
export fn soup_message_get_request_headers(msg: usize) -> usize { return m.getWord(rec(msg) + R_REQUEST_HEADERS) }
export fn soup_message_get_response_headers(msg: usize) -> usize { return m.getWord(rec(msg) + R_RESPONSE_HEADERS) }
export fn soup_message_get_method(msg: usize) -> usize { return m.getWord(rec(msg) + R_METHOD) }

pub fn statusOf(msg: usize) -> u32 { return m.get32(rec(msg) + R_STATUS) }
pub fn requestHeaders(msg: usize) -> usize { return m.getWord(rec(msg) + R_REQUEST_HEADERS) }
pub fn responseHeaders(msg: usize) -> usize { return m.getWord(rec(msg) + R_RESPONSE_HEADERS) }
pub fn method(msg: usize) -> usize { return m.getWord(rec(msg) + R_METHOD) }
pub fn methodIs(msg: usize, name: []const u8) -> bool { return m.same(m.cSlice(method(msg)), name) }

export fn soup_message_set_method(msg: usize, method_: usize) -> void {
    if method_ == 0 { return }
    const r = rec(msg)
    const interned = g.g_intern_string(method_)
    if m.getWord(r + R_METHOD) == interned { return }
    m.putWord(r + R_METHOD, interned)
    notify(msg, PROP_METHOD)
}

export fn soup_message_get_is_options_ping(msg: usize) -> i32 { return m.getI32(rec(msg) + R_OPTIONS_PING) }

export fn soup_message_set_is_options_ping(msg: usize, value: i32) -> void {
    const r = rec(msg)
    const v: i32 = if value != 0 { 1 } else { 0 }
    if m.getI32(r + R_OPTIONS_PING) == v { return }
    m.putI32(r + R_OPTIONS_PING, v)
    notify(msg, PROP_IS_OPTIONS_PING)
    if v != 0 { soup_message_set_method(msg, m.literal("OPTIONS")) }
}

pub fn priorityOf(msg: usize) -> i32 { return m.getI32(rec(msg) + R_PRIORITY) }
pub fn setMethodName(msg: usize, name: []const u8) -> void {
    const text = m.dupSlice(name)
    soup_message_set_method(msg, text)
    m.release(text)
}
pub fn setUri(msg: usize, u: usize) -> void { soup_message_set_uri(msg, u) }

pub fn isOptionsPing(msg: usize) -> bool { return m.getI32(rec(msg) + R_OPTIONS_PING) != 0 }

export fn soup_message_get_connection_id(msg: usize) -> u64 { return m.getWord(rec(msg) + R_CONNECTION_ID) }
export fn soup_message_get_remote_address(msg: usize) -> usize { return m.getWord(rec(msg) + R_REMOTE_ADDRESS) }

export fn soup_message_set_priority(msg: usize, priority: i32) -> void {
    const r = rec(msg)
    if m.getI32(r + R_PRIORITY) == priority { return }
    m.putI32(r + R_PRIORITY, priority)
    notify(msg, PROP_PRIORITY)
}

export fn soup_message_get_priority(msg: usize) -> i32 { return m.getI32(rec(msg) + R_PRIORITY) }

export fn soup_message_set_force_http1(msg: usize, value: i32) -> void { m.putI32(rec(msg) + R_FORCE_VERSION, if value != 0 { HTTP_1_1 } else { 255 }) }
export fn soup_message_get_force_http1(msg: usize) -> i32 { return if m.getI32(rec(msg) + R_FORCE_VERSION) == HTTP_1_1 { 1 } else { 0 } }

// ---------------------------------------------------------------------------
// Features

export fn soup_message_disable_feature(msg: usize, feature_type: usize) -> void {
    const r = rec(msg)
    if m.getWord(r + R_DISABLED) == 0 { m.putWord(r + R_DISABLED, g.g_hash_table_new_full(@intFromPtr(g_direct_hash), @intFromPtr(g_direct_equal), 0, 0)) }
    _ = g_hash_table_add(m.getWord(r + R_DISABLED), feature_type)
}

// Whether `feature` (an instance) is of a type the message disables.
pub fn disablesFeature(msg: usize, feature: usize) -> bool {
    const table = m.getWord(rec(msg) + R_DISABLED)
    if table == 0 || feature == 0 { return false }
    const iter = m.alloc(48)
    const key = m.alloc(8)
    g.g_hash_table_iter_init(iter, table)
    var found = false
    while g.g_hash_table_iter_next(iter, key, 0) != 0 {
        if g_type_check_instance_is_a(feature, m.getWord(key)) != 0 { found = true }
    }
    m.release(key)
    m.release(iter)
    return found
}

pub fn featureTypeDisabled(msg: usize, featureType: usize) -> bool {
    const table = m.getWord(rec(msg) + R_DISABLED)
    if table == 0 { return false }
    const iter = m.alloc(48)
    const key = m.alloc(8)
    g.g_hash_table_iter_init(iter, table)
    var found = false
    while g.g_hash_table_iter_next(iter, key, 0) != 0 {
        if g.g_type_is_a(m.getWord(key), featureType) != 0 { found = true }
    }
    m.release(key)
    m.release(iter)
    return found
}

export fn soup_message_is_feature_disabled(msg: usize, feature_type: usize) -> i32 { return if featureTypeDisabled(msg, feature_type) { 1 } else { 0 } }

// ---------------------------------------------------------------------------
// TLS

export fn soup_message_get_tls_peer_certificate(msg: usize) -> usize { return m.getWord(rec(msg) + R_PEER_CERTIFICATE) }
export fn soup_message_get_tls_peer_certificate_errors(msg: usize) -> u32 { return m.get32(rec(msg) + R_PEER_ERRORS) }
export fn soup_message_get_tls_protocol_version(msg: usize) -> i32 { return m.getI32(rec(msg) + R_TLS_VERSION) }
export fn soup_message_get_tls_ciphersuite_name(msg: usize) -> usize { return m.getWord(rec(msg) + R_CIPHERSUITE) }

// Without a request pending, the certificate is kept for the connection
// the message will get (conn.mlx gives it to the TLS connection); with
// one, the request is answered.
export fn soup_message_set_tls_client_certificate(msg: usize, certificate: usize) -> void {
    const r = rec(msg)
    const task = m.getWord(r + R_CERT_REQUEST)
    if task != 0 {
        m.putWord(r + R_CERT_REQUEST, 0)
        // The connection (the task's source) is given the certificate,
        // and the interaction is HANDLED (1) or FAILED (2).
        const conn = g.g_task_get_source_object(task)
        if certificate != 0 && conn != 0 { tls.setCertificate(conn, certificate) }
        g.g_task_return_int(task, if certificate != 0 { 1 } else { 2 })
        g.g_object_unref(task)
        return
    }
    c.replaceObject(r + R_CLIENT_CERTIFICATE, certificate)
}

export fn soup_message_tls_client_certificate_password_request_complete(msg: usize) -> void {
    const r = rec(msg)
    const task = m.getWord(r + R_CERT_PASSWORD)
    if task == 0 {
        c.warning("soup_message_tls_client_certificate_password_request_complete should only be called as a response to SoupMessage::request-certificate-password signal")
        return
    }
    m.putWord(r + R_CERT_PASSWORD, 0)
    g.g_task_return_int(task, 1)
    g.g_object_unref(task)
}

// ---------------------------------------------------------------------------
// Metrics

export fn soup_message_get_metrics(msg: usize) -> usize { return metricsOf(msg) }

pub fn metricsOf(msg: usize) -> usize {
    const r = rec(msg)
    if m.getWord(r + R_METRICS) != 0 { return m.getWord(r + R_METRICS) }
    if (m.get32(r + R_FLAGS) & COLLECT_METRICS) != 0 { m.putWord(r + R_METRICS, metrics.new()) }
    return m.getWord(r + R_METRICS)
}

pub fn stamp(msg: usize, field: usize) -> void { metrics.stamp(metricsOf(msg), field) }

// ---------------------------------------------------------------------------
// What the session sets before sending

// The Host header from `uri` ("host" or "host:port").
pub fn setRequestHostFromUri(msg: usize, u: usize) -> void {
    if httpVersion(msg) == HTTP_2_0 { return }
    const host = misc.hostForHeaders(u)
    if misc.usesDefaultPort(u) {
        soup_message_headers_replace(requestHeaders(msg), m.literal("Host"), host)
    } else {
        var t = m.text()
        m.pushC(&t, host)
        m.pushByte(&t, 58)
        m.pushDecimal(&t, @intCast(u64, g.g_uri_get_port(u)))
        const value = m.finish(&t)
        soup_message_headers_replace(requestHeaders(msg), m.literal("Host"), value)
        m.release(value)
    }
    m.release(host)
}

pub fn updateRequestHostIfNeeded(msg: usize) -> void {
    if soup_message_headers_get_one(requestHeaders(msg), m.literal("Host")) != 0 { return }
    setRequestHostFromUri(msg, uri(msg))
}

// HTTP/1.0 is kept alive by asking; HTTP/1.1 is anyway, and libsoup asks
// all the same.
pub fn forceKeepAliveIfNeeded(msg: usize) -> void {
    const hdrs = requestHeaders(msg)
    const name = m.literal("Connection")
    if soup_message_headers_header_contains(hdrs, name, m.literal("Keep-Alive")) == 0 && soup_message_headers_header_contains(hdrs, name, m.literal("close")) == 0 && soup_message_headers_header_contains(hdrs, name, m.literal("Upgrade")) == 0 {
        soup_message_headers_append(hdrs, name, m.literal("Keep-Alive"))
    }
}

pub fn setPreconnect(msg: usize, value: bool) -> void { m.putI32(rec(msg) + R_PRECONNECT, if value { 1 } else { 0 }) }
pub fn isPreconnect(msg: usize) -> bool { return m.getI32(rec(msg) + R_PRECONNECT) != 0 }

pub fn setItem(msg: usize, item: usize) -> void { m.putWord(rec(msg) + R_ITEM, item) }
pub fn item(msg: usize) -> usize { return m.getWord(rec(msg) + R_ITEM) }

pub fn setSniffer(msg: usize, sniffer: usize) -> void { c.replaceObject(rec(msg) + R_SNIFFER, sniffer) }
pub fn sniffer(msg: usize) -> usize { return m.getWord(rec(msg) + R_SNIFFER) }

// The pending client certificate request: a GTask whose source is the
// TLS connection.
pub fn setCertificateRequest(msg: usize, task: usize) -> void { m.putWord(rec(msg) + R_CERT_REQUEST, task) }
pub fn setPasswordRequest(msg: usize, task: usize) -> void { m.putWord(rec(msg) + R_CERT_PASSWORD, task) }
