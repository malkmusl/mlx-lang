// std.flate's decompressor for the content decoder and the WebSocket
// deflate extension: an Inflater kept on the C heap (its memory from
// malloc and free), fed in pieces.
const m = @import("../glib/memory.mlx")
const flate = @import("std.flate")

extern("c") fn malloc(size: usize) -> usize
extern("c") fn free(address: usize) -> void

pub const Format = flate.Format
pub const Status = flate.Status

fn heapAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const address = malloc(length)
    if address == 0 { return null }
    unsafe { return @ptrFromInt([*]u8, address) }
}

fn heapResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> bool { return false }

fn heapRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> ?[*]u8 { return null }

fn heapFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void { free(@intFromPtr(memory)) }

var heapContext: u64 = 0

fn heap() -> flate.Allocator {
    unsafe {
        return flate.Allocator.{
            .context = @ptrFromInt(*anyopaque, @intFromPtr(&heapContext)),
            .allocFn = heapAlloc,
            .resizeFn = heapResize,
            .remapFn = heapRemap,
            .freeFn = heapFree,
        }
    }
}

fn inflaterAt(address: usize) -> *flate.Inflater { unsafe { return @ptrFromInt(*flate.Inflater, address) } }

// A new inflater for `format` (0 when it cannot be set up).
pub fn new(format: Format) -> usize {
    const address = m.alloc(@sizeOf(flate.Inflater))
    if flate.inflaterInit(inflaterAt(address), heap(), format) != Status.ok {
        m.release(address)
        return 0
    }
    return address
}

pub fn reset(inflater: usize) -> void { _ = flate.inflaterReset(inflaterAt(inflater)) }

pub fn setDictionary(inflater: usize, dictionary: usize, length: usize) -> void {
    unsafe { _ = flate.inflaterSetDictionary(inflaterAt(inflater), @ptrFromInt([*]const u8, dictionary), length) }
}

pub fn dispose(inflater: usize) -> void {
    if inflater == 0 { return }
    flate.inflaterEnd(inflaterAt(inflater))
    m.release(inflater)
}

// Decompresses what it can of `length` bytes at `input` into `output`
// (`capacity` bytes); `consumed` and `produced` say how much.
pub fn run(inflater: usize, input: usize, length: usize, output: usize, capacity: usize, consumed: *usize, produced: *usize) -> Status {
    var progress = flate.Progress.{ .consumed = 0, .produced = 0 }
    var status = Status.ok
    unsafe { status = flate.inflaterRun(inflaterAt(inflater), @ptrFromInt([*]const u8, input), length, @ptrFromInt([*]u8, output), capacity, &progress) }
    consumed.* = progress.consumed
    produced.* = progress.produced
    return status
}
