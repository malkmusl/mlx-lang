// soup-tld.h: a host's base domain and whether a domain is a public
// suffix, by the Public Suffix List (std.http.psl), with libsoup's errors.
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const psl = @import("std.http.psl")

// SoupTLDError.
const INVALID_HOSTNAME: i32 = 0
const IS_IP_ADDRESS: i32 = 1
const NOT_ENOUGH_DOMAINS: i32 = 2
const NO_BASE_DOMAIN: i32 = 3

export fn soup_tld_error_quark() -> u32 { return g.g_quark_from_static_string(m.literal("soup-tld-error-quark")) }

pub fn isPublicSuffix(domain: usize) -> bool { return psl.isPublicSuffix(m.cSlice(domain), true) }

export fn soup_tld_domain_is_public_suffix(domain: usize) -> i32 {
    if domain == 0 {
        c.critical("soup_tld_domain_is_public_suffix: assertion 'domain' failed")
        return 0
    }
    return if isPublicSuffix(domain) { 1 } else { 0 }
}

// The base domain of `hostname` (a pointer into it), or 0 with `err` set.
pub fn baseDomain(hostname: usize, err: usize) -> usize {
    const text = m.cSlice(hostname)
    if text.length > 0 && text[0] == 46 {
        c.setError(err, soup_tld_error_quark(), INVALID_HOSTNAME, "Invalid hostname")
        return 0
    }
    if g.g_hostname_is_ip_address(hostname) != 0 {
        c.setError(err, soup_tld_error_quark(), IS_IP_ADDRESS, "Hostname is an IP address")
        return 0
    }
    const suffix = psl.suffixStart(text)
    if !psl.isPublicSuffix(text[suffix..text.length], true) {
        c.setError(err, soup_tld_error_quark(), NO_BASE_DOMAIN, "Hostname has no base domain")
        return 0
    }
    const registrable = psl.registrableStart(text)
    if registrable == text.length {
        c.setError(err, soup_tld_error_quark(), NOT_ENOUGH_DOMAINS, "Not enough domains")
        return 0
    }
    return hostname + registrable
}

export fn soup_tld_get_base_domain(hostname: usize, err: usize) -> usize {
    if hostname == 0 {
        c.critical("soup_tld_get_base_domain: assertion 'hostname' failed")
        return 0
    }
    return baseDomain(hostname, err)
}
