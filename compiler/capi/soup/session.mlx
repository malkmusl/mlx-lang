extern("c") fn soup_message_add_status_code_handler(msg: usize, signal: usize, code: u32, callback: usize, data: usize) -> u32

const R_CONTEXT: usize = 0
const R_QUEUE: usize = 8
const R_QUEUE_LEN: usize = 16
const R_QUEUE_ROOM: usize = 24
const R_FEATURES: usize = 32
const R_CONNS: usize = 40
const R_CONNS_LEN: usize = 48
const R_CONNS_ROOM: usize = 56
const R_MAX_CONNS: usize = 64
const R_MAX_PER_HOST: usize = 68
const R_IO_TIMEOUT: usize = 72
const R_IDLE_TIMEOUT: usize = 76
const R_USER_AGENT: usize = 80
const R_ACCEPT_LANGUAGE: usize = 88
const R_ACCEPT_LANGUAGE_AUTO: usize = 96
const R_PROXY_DEFAULT: usize = 100
const R_PROXY: usize = 104
const R_TLSDB: usize = 112
const R_TLSDB_DEFAULT: usize = 120
const R_NUM_ASYNC: usize = 124
const R_INTERACTION: usize = 128
const R_LOCAL_ADDRESS: usize = 136
const R_REMOTE_CONNECTABLE: usize = 144
const R_KICKS: usize = 152
const R_KICKS_LEN: usize = 160
const R_KICKS_ROOM: usize = 168
const R_LAST_CONN_ID: usize = 176
const R_SIZE: usize = 184

const MAX_CONNS_DEFAULT: i32 = 10
const MAX_CONNS_PER_HOST_DEFAULT: i32 = 2

const PROP_PROXY_RESOLVER: u32 = 1
const PROP_MAX_CONNS: u32 = 2
const PROP_MAX_CONNS_PER_HOST: u32 = 3
const PROP_TLS_DATABASE: u32 = 4
const PROP_TIMEOUT: u32 = 5
const PROP_USER_AGENT: u32 = 6
const PROP_ACCEPT_LANGUAGE: u32 = 7
const PROP_ACCEPT_LANGUAGE_AUTO: u32 = 8
const PROP_REMOTE_CONNECTABLE: u32 = 9
const PROP_IDLE_TIMEOUT: u32 = 10
const PROP_LOCAL_ADDRESS: u32 = 11
const PROP_TLS_INTERACTION: u32 = 12

// SoupSessionError.
pub const ERROR_PARSING: i32 = 0
pub const ERROR_ENCODING: i32 = 1
pub const ERROR_TOO_MANY_REDIRECTS: i32 = 2
pub const ERROR_TOO_MANY_RESTARTS: i32 = 3
pub const ERROR_REDIRECT_NO_LOCATION: i32 = 4
pub const ERROR_REDIRECT_BAD_URI: i32 = 5
pub const ERROR_MESSAGE_ALREADY_IN_QUEUE: i32 = 6

var sessionType: usize = 0
var privateOffset: i32 = 0
var specs: [13]usize = undefined
var sigRequestQueued: u32 = 0
var sigRequestUnqueued: u32 = 0
var sendTag: u8 = 0
var spliceTag: u8 = 0
var readTag: u8 = 0
var preconnectTag: u8 = 0

pub fn sessionTypeGet() -> usize {
    if c.onceEnter(&sessionType) {
        const t = c.defineType(c.T_OBJECT, "SoupSession", 216, @intFromPtr(__mlx_soup_session_class_init), 24, @intFromPtr(__mlx_soup_session_init), 0)
        privateOffset = c.addPrivate(t, 8)
        c.onceLeave(&sessionType, t)
    }
    return sessionType
}

export fn soup_session_get_type() -> usize { return sessionTypeGet() }

pub fn rec(session: usize) -> usize { return m.getWord(c.privateAt(session, privateOffset)) }

export fn soup_session_error_quark() -> u32 { return g.g_quark_from_static_string(m.literal("soup-session-error-quark")) }

fn sessionError(code: i32, text: []const u8) -> usize { return c.newError(soup_session_error_quark(), code, text) }

// ---------------------------------------------------------------------------
// The object

export fn __mlx_soup_session_init(session: usize, class: usize) -> void {
    const r = m.alloc(R_SIZE)
    m.putWord(c.privateAt(session, privateOffset), r)
    m.putWord(r + R_CONTEXT, g.g_main_context_ref_thread_default())
    m.putI32(r + R_MAX_CONNS, MAX_CONNS_DEFAULT)
    m.putI32(r + R_MAX_PER_HOST, MAX_CONNS_PER_HOST_DEFAULT)
    m.put32(r + R_IO_TIMEOUT, 60)
    m.put32(r + R_IDLE_TIMEOUT, 60)
    m.putI32(r + R_PROXY_DEFAULT, 1)
    m.putI32(r + R_TLSDB_DEFAULT, 1)
    const manager = g.g_object_new(soup_auth_manager_get_type(), 0)
    _ = feature.addFeature(manager, soup_auth_basic_get_type())
    _ = feature.addFeature(manager, soup_auth_digest_get_type())
    addFeature(session, manager)
    g.g_object_unref(manager)
    addFeatureByType(session, soup_content_decoder_get_type())
}

export fn __mlx_soup_session_dispose(session: usize) -> void {
    soup_session_abort(session)
    const r = rec(session)
    while m.getWord(r + R_FEATURES) != 0 {
        removeFeature(session, m.getWord(m.getWord(r + R_FEATURES)))
    }
    c.chainUp(g.g_type_class_ref(sessionTypeGet()), 40, session)
}

export fn __mlx_soup_session_finalize(session: usize) -> void {
    const r = rec(session)
    var index: usize = 0
    while index < m.getWord(r + R_CONNS_LEN) {
        conn.unref(m.getWord(m.getWord(r + R_CONNS) + index * 8))
        index += 1
    }
    m.release(m.getWord(r + R_CONNS))
    m.release(m.getWord(r + R_QUEUE))
    m.release(m.getWord(r + R_KICKS))
    g.g_main_context_unref(m.getWord(r + R_CONTEXT))
    m.release(m.getWord(r + R_USER_AGENT))
    m.release(m.getWord(r + R_ACCEPT_LANGUAGE))
    c.clearObject(r + R_TLSDB)
    c.clearObject(r + R_INTERACTION)
    c.clearObject(r + R_LOCAL_ADDRESS)
    c.clearObject(r + R_PROXY)
    c.clearObject(r + R_REMOTE_CONNECTABLE)
    m.release(r)
    c.chainUp(g.g_type_class_ref(sessionTypeGet()), 48, session)
}

export fn __mlx_soup_session_set_property(session: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = rec(session)
    if id == PROP_LOCAL_ADDRESS {
        c.replaceObject(r + R_LOCAL_ADDRESS, g.g_value_get_object(value))
    } else if id == PROP_PROXY_RESOLVER {
        soup_session_set_proxy_resolver(session, g.g_value_get_object(value))
    } else if id == PROP_MAX_CONNS {
        m.putI32(r + R_MAX_CONNS, g.g_value_get_int(value))
    } else if id == PROP_MAX_CONNS_PER_HOST {
        m.putI32(r + R_MAX_PER_HOST, g.g_value_get_int(value))
    } else if id == PROP_TLS_DATABASE {
        soup_session_set_tls_database(session, g.g_value_get_object(value))
    } else if id == PROP_TLS_INTERACTION {
        soup_session_set_tls_interaction(session, g.g_value_get_object(value))
    } else if id == PROP_TIMEOUT {
        soup_session_set_timeout(session, g.g_value_get_uint(value))
    } else if id == PROP_USER_AGENT {
        soup_session_set_user_agent(session, g.g_value_get_string(value))
    } else if id == PROP_ACCEPT_LANGUAGE {
        soup_session_set_accept_language(session, g.g_value_get_string(value))
    } else if id == PROP_ACCEPT_LANGUAGE_AUTO {
        soup_session_set_accept_language_auto(session, g.g_value_get_boolean(value))
    } else if id == PROP_REMOTE_CONNECTABLE {
        c.replaceObject(r + R_REMOTE_CONNECTABLE, g.g_value_get_object(value))
    } else if id == PROP_IDLE_TIMEOUT {
        soup_session_set_idle_timeout(session, g.g_value_get_uint(value))
    }
}

export fn __mlx_soup_session_get_property(session: usize, id: u32, value: usize, pspec: usize) -> void {
    const r = rec(session)
    if id == PROP_LOCAL_ADDRESS {
        g.g_value_set_object(value, m.getWord(r + R_LOCAL_ADDRESS))
    } else if id == PROP_PROXY_RESOLVER {
        g.g_value_set_object(value, soup_session_get_proxy_resolver(session))
    } else if id == PROP_MAX_CONNS {
        g.g_value_set_int(value, m.getI32(r + R_MAX_CONNS))
    } else if id == PROP_MAX_CONNS_PER_HOST {
        g.g_value_set_int(value, m.getI32(r + R_MAX_PER_HOST))
    } else if id == PROP_TLS_DATABASE {
        g.g_value_set_object(value, soup_session_get_tls_database(session))
    } else if id == PROP_TLS_INTERACTION {
        g.g_value_set_object(value, m.getWord(r + R_INTERACTION))
    } else if id == PROP_TIMEOUT {
        g.g_value_set_uint(value, m.get32(r + R_IO_TIMEOUT))
    } else if id == PROP_USER_AGENT {
        g.g_value_set_string(value, m.getWord(r + R_USER_AGENT))
    } else if id == PROP_ACCEPT_LANGUAGE {
        g.g_value_set_string(value, m.getWord(r + R_ACCEPT_LANGUAGE))
    } else if id == PROP_ACCEPT_LANGUAGE_AUTO {
        g.g_value_set_boolean(value, m.getI32(r + R_ACCEPT_LANGUAGE_AUTO))
    } else if id == PROP_REMOTE_CONNECTABLE {
        g.g_value_set_object(value, m.getWord(r + R_REMOTE_CONNECTABLE))
    } else if id == PROP_IDLE_TIMEOUT {
        g.g_value_set_uint(value, m.get32(r + R_IDLE_TIMEOUT))
    }
}

export fn __mlx_soup_session_class_init(class: usize, data: usize) -> void {
    c.adjustPrivate(class, &privateOffset)
    m.putWord(class + 24, @intFromPtr(__mlx_soup_session_set_property))
    m.putWord(class + 32, @intFromPtr(__mlx_soup_session_get_property))
    m.putWord(class + 40, @intFromPtr(__mlx_soup_session_dispose))
    m.putWord(class + 48, @intFromPtr(__mlx_soup_session_finalize))
    sigRequestQueued = c.signal(class, "request-queued", c.RUN_FIRST, 136, 0, c.T_NONE, 1, message.messageTypeGet(), 0, 0, 0)
    sigRequestUnqueued = c.signal(class, "request-unqueued", c.RUN_FIRST, 144, 0, c.T_NONE, 1, message.messageTypeGet(), 0, 0, 0)
    const rw = c.READWRITE
    specs[PROP_PROXY_RESOLVER] = c.objectProperty(class, PROP_PROXY_RESOLVER, "proxy-resolver", g_proxy_resolver_get_type(), rw)
    specs[PROP_MAX_CONNS] = c.intProperty(class, PROP_MAX_CONNS, "max-conns", 1, 2147483647, MAX_CONNS_DEFAULT, rw | c.CONSTRUCT_ONLY)
    specs[PROP_MAX_CONNS_PER_HOST] = c.intProperty(class, PROP_MAX_CONNS_PER_HOST, "max-conns-per-host", 1, 2147483647, MAX_CONNS_PER_HOST_DEFAULT, rw | c.CONSTRUCT_ONLY)
    specs[PROP_IDLE_TIMEOUT] = c.uintProperty(class, PROP_IDLE_TIMEOUT, "idle-timeout", 0, 4294967295, 60, rw)
    specs[PROP_TLS_DATABASE] = c.objectProperty(class, PROP_TLS_DATABASE, "tls-database", g.g_tls_database_get_type(), rw)
    specs[PROP_TIMEOUT] = c.uintProperty(class, PROP_TIMEOUT, "timeout", 0, 4294967295, 0, rw)
    specs[PROP_USER_AGENT] = c.stringProperty(class, PROP_USER_AGENT, "user-agent", rw)
    specs[PROP_ACCEPT_LANGUAGE] = c.stringProperty(class, PROP_ACCEPT_LANGUAGE, "accept-language", rw)
    specs[PROP_ACCEPT_LANGUAGE_AUTO] = c.booleanProperty(class, PROP_ACCEPT_LANGUAGE_AUTO, "accept-language-auto", false, rw)
    specs[PROP_REMOTE_CONNECTABLE] = c.objectProperty(class, PROP_REMOTE_CONNECTABLE, "remote-connectable", g_socket_connectable_get_type(), rw | c.CONSTRUCT_ONLY)
    specs[PROP_LOCAL_ADDRESS] = c.objectProperty(class, PROP_LOCAL_ADDRESS, "local-address", g_inet_socket_address_get_type(), rw | c.CONSTRUCT_ONLY)
    specs[PROP_TLS_INTERACTION] = c.objectProperty(class, PROP_TLS_INTERACTION, "tls-interaction", g.g_tls_interaction_get_type(), rw)
    io.setHooks(@intFromPtr(__mlx_soup_session_setup_body), @intFromPtr(__mlx_soup_sniffer_sniff))
}

fn notify(session: usize, id: u32) -> void { g.g_object_notify_by_pspec(session, specs[id]) }

export fn soup_session_new() -> usize { return g.g_object_new(sessionTypeGet(), 0) }

export fn soup_session_new_with_options(optname1: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    var call: varargs.CallList = undefined
    var words: [6]usize = [6]usize{ optname1, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = varargs.start(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    return g_object_new_valist(sessionTypeGet(), optname1, list)
}

// ---------------------------------------------------------------------------
// Settings

export fn soup_session_get_local_address(session: usize) -> usize { return m.getWord(rec(session) + R_LOCAL_ADDRESS) }
export fn soup_session_get_max_conns(session: usize) -> u32 { return m.get32(rec(session) + R_MAX_CONNS) }
export fn soup_session_get_max_conns_per_host(session: usize) -> u32 { return m.get32(rec(session) + R_MAX_PER_HOST) }

export fn soup_session_set_proxy_resolver(session: usize, resolver: usize) -> void {
    const r = rec(session)
    m.putI32(r + R_PROXY_DEFAULT, 0)
    if m.getWord(r + R_PROXY) == resolver { return }
    c.replaceObject(r + R_PROXY, resolver)
    notify(session, PROP_PROXY_RESOLVER)
}

export fn soup_session_get_proxy_resolver(session: usize) -> usize {
    const r = rec(session)
    if m.getI32(r + R_PROXY_DEFAULT) == 0 { return m.getWord(r + R_PROXY) }
    return g_proxy_resolver_get_default()
}

export fn soup_session_set_tls_database(session: usize, database: usize) -> void {
    const r = rec(session)
    m.putI32(r + R_TLSDB_DEFAULT, 0)
    if m.getWord(r + R_TLSDB) == database { return }
    c.replaceObject(r + R_TLSDB, database)
    notify(session, PROP_TLS_DATABASE)
}

export fn soup_session_get_tls_database(session: usize) -> usize {
    const r = rec(session)
    if m.getI32(r + R_TLSDB_DEFAULT) != 0 && m.getWord(r + R_TLSDB) == 0 {
        const backend = g.g_tls_backend_get_default()
        if backend != 0 { m.putWord(r + R_TLSDB, g.g_tls_backend_get_default_database(backend)) }
    }
    return m.getWord(r + R_TLSDB)
}

export fn soup_session_set_tls_interaction(session: usize, interaction: usize) -> void {
    const r = rec(session)
    if m.getWord(r + R_INTERACTION) == interaction { return }
    c.replaceObject(r + R_INTERACTION, interaction)
    notify(session, PROP_TLS_INTERACTION)
}

export fn soup_session_get_tls_interaction(session: usize) -> usize { return m.getWord(rec(session) + R_INTERACTION) }

export fn soup_session_set_timeout(session: usize, timeout: u32) -> void {
    const r = rec(session)
    if m.get32(r + R_IO_TIMEOUT) == timeout { return }
    m.put32(r + R_IO_TIMEOUT, timeout)
    notify(session, PROP_TIMEOUT)
}

export fn soup_session_get_timeout(session: usize) -> u32 { return m.get32(rec(session) + R_IO_TIMEOUT) }

export fn soup_session_set_idle_timeout(session: usize, timeout: u32) -> void {
    const r = rec(session)
    if m.get32(r + R_IDLE_TIMEOUT) == timeout { return }
    m.put32(r + R_IDLE_TIMEOUT, timeout)
    notify(session, PROP_IDLE_TIMEOUT)
}

export fn soup_session_get_idle_timeout(session: usize) -> u32 { return m.get32(rec(session) + R_IDLE_TIMEOUT) }

export fn soup_session_set_user_agent(session: usize, user_agent: usize) -> void {
    const r = rec(session)
    const old = m.getWord(r + R_USER_AGENT)
    if old == 0 && user_agent == 0 { return }
    if user_agent == 0 {
        m.release(old)
        m.putWord(r + R_USER_AGENT, 0)
    } else if m.get8(user_agent) == 0 {
        if old != 0 && m.same(m.cSlice(old), "libsoup/3.4.4") { return }
        m.release(old)
        m.putWord(r + R_USER_AGENT, m.dupSlice("libsoup/3.4.4"))
    } else {
        const text = m.cSlice(user_agent)
        if text[text.length - 1] == 32 {
            var t = m.text()
            m.pushText(&t, text)
            m.pushText(&t, "libsoup/3.4.4")
            const value = m.finish(&t)
            if old != 0 && m.cEqual(old, value) {
                m.release(value)
                return
            }
            m.release(old)
            m.putWord(r + R_USER_AGENT, value)
        } else {
            if old != 0 && m.cEqual(old, user_agent) { return }
            m.release(old)
            m.putWord(r + R_USER_AGENT, m.dup(user_agent))
        }
    }
    notify(session, PROP_USER_AGENT)
}

export fn soup_session_get_user_agent(session: usize) -> usize { return m.getWord(rec(session) + R_USER_AGENT) }

export fn soup_session_set_accept_language(session: usize, accept_language: usize) -> void {
    const r = rec(session)
    if c.cEquals(m.getWord(r + R_ACCEPT_LANGUAGE), accept_language) { return }
    c.replaceString(r + R_ACCEPT_LANGUAGE, accept_language)
    m.putI32(r + R_ACCEPT_LANGUAGE_AUTO, 0)
    g.g_object_freeze_notify(session)
    notify(session, PROP_ACCEPT_LANGUAGE)
    notify(session, PROP_ACCEPT_LANGUAGE_AUTO)
    g.g_object_thaw_notify(session)
}

export fn soup_session_get_accept_language(session: usize) -> usize { return m.getWord(rec(session) + R_ACCEPT_LANGUAGE) }

// libsoup's soup_get_accept_languages_from_system: the user's languages
// as an Accept-Language list with falling q-values ("en-us, en;q=0.9").
fn systemLanguages() -> usize {
    const names = g.g_get_language_names()
    var t = m.text()
    var count: usize = 0
    var total: usize = 0
    var index: usize = 0
    while m.getWord(names + index * 8) != 0 {
        if languageUsable(m.getWord(names + index * 8)) { total += 1 }
        index += 1
    }
    const delta: usize = if total < 10 { 10 } else if total < 20 { 5 } else { 1 }
    index = 0
    while m.getWord(names + index * 8) != 0 {
        const name = m.getWord(names + index * 8)
        index += 1
        if !languageUsable(name) { continue }
        if count > 0 { m.pushText(&t, ", ") }
        for ch in m.cSlice(name) {
            m.pushByte(&t, if ch == 95 { 45 } else { m.lower(ch) })
        }
        const quality = 100 - @intCast(i64, count * delta)
        if quality >= 0 && quality < 100 {
            m.pushText(&t, ";q=0.")
            if quality % 10 != 0 {
                m.pushByte(&t, @intCast(u8, 48 + quality / 10))
                m.pushByte(&t, @intCast(u8, 48 + quality % 10))
            } else {
                m.pushDecimal(&t, @intCast(u64, quality / 10))
            }
        }
        count += 1
    }
    if count == 0 { m.pushText(&t, "en") }
    return m.finish(&t)
}

fn languageUsable(name: usize) -> bool {
    const text = m.cSlice(name)
    for ch in text {
        if ch == 46 || ch == 64 { return false }
    }
    return !m.same(text, "C")
}

export fn soup_session_set_accept_language_auto(session: usize, value: i32) -> void {
    const r = rec(session)
    const v: i32 = if value != 0 { 1 } else { 0 }
    if m.getI32(r + R_ACCEPT_LANGUAGE_AUTO) == v { return }
    m.putI32(r + R_ACCEPT_LANGUAGE_AUTO, v)
    m.release(m.getWord(r + R_ACCEPT_LANGUAGE))
    m.putWord(r + R_ACCEPT_LANGUAGE, if v != 0 { systemLanguages() } else { 0 })
    g.g_object_freeze_notify(session)
    notify(session, PROP_ACCEPT_LANGUAGE)
    notify(session, PROP_ACCEPT_LANGUAGE_AUTO)
    g.g_object_thaw_notify(session)
}

export fn soup_session_get_accept_language_auto(session: usize) -> i32 { return m.getI32(rec(session) + R_ACCEPT_LANGUAGE_AUTO) }
export fn soup_session_get_remote_connectable(session: usize) -> usize { return m.getWord(rec(session) + R_REMOTE_CONNECTABLE) }

// ---------------------------------------------------------------------------
// Features

pub fn hasFeature(session: usize, t: usize) -> bool {
    var list = m.getWord(rec(session) + R_FEATURES)
    const isFeatureType = g.g_type_is_a(t, feature.featureTypeGet()) != 0
    while list != 0 {
        const f = m.getWord(list)
        if isFeatureType {
            if g_type_check_instance_is_a(f, t) != 0 { return true }
        } else if feature.hasFeature(f, t) {
            return true
        }
        list = m.getWord(list + 8)
    }
    return false
}

fn alreadyAdded(session: usize, t: usize) -> bool {
    if !hasFeature(session, t) { return false }
    var w = m.text()
    m.pushText(&w, "SoupSession already has a ")
    m.pushC(&w, g.g_type_name(t))
    m.pushText(&w, ", ignoring new feature")
    const text = m.finish(&w)
    c.warning(m.cSlice(text))
    m.release(text)
    return true
}

pub fn addFeature(session: usize, f: usize) -> void {
    if alreadyAdded(session, m.getWord(m.getWord(f))) { return }
    const r = rec(session)
    m.putWord(r + R_FEATURES, g.g_slist_prepend(m.getWord(r + R_FEATURES), g.g_object_ref(f)))
    feature.attach(f, session)
}

pub fn addFeatureByType(session: usize, t: usize) -> void {
    if g.g_type_is_a(t, feature.featureTypeGet()) != 0 {
        if alreadyAdded(session, t) { return }
        const f = g.g_object_new(t, 0)
        addFeature(session, f)
        g.g_object_unref(f)
        return
    }
    var list = m.getWord(rec(session) + R_FEATURES)
    while list != 0 {
        if feature.addFeature(m.getWord(list), t) { return }
        list = m.getWord(list + 8)
    }
    var w = m.text()
    m.pushText(&w, "No feature manager for feature of type '")
    m.pushC(&w, g.g_type_name(t))
    m.pushText(&w, "'")
    const text = m.finish(&w)
    c.warning(m.cSlice(text))
    m.release(text)
}

pub fn removeFeature(session: usize, f: usize) -> void {
    const r = rec(session)
    if g_slist_find(m.getWord(r + R_FEATURES), f) == 0 { return }
    m.putWord(r + R_FEATURES, g_slist_remove(m.getWord(r + R_FEATURES), f))
    feature.detach(f, session)
    g.g_object_unref(f)
}

export fn soup_session_add_feature(session: usize, f: usize) -> void { addFeature(session, f) }
export fn soup_session_add_feature_by_type(session: usize, t: usize) -> void { addFeatureByType(session, t) }
export fn soup_session_remove_feature(session: usize, f: usize) -> void { removeFeature(session, f) }

export fn soup_session_remove_feature_by_type(session: usize, t: usize) -> void {
    const r = rec(session)
    if g.g_type_is_a(t, feature.featureTypeGet()) != 0 {
        var again = true
        while again {
            again = false
            var list = m.getWord(r + R_FEATURES)
            while list != 0 {
                const f = m.getWord(list)
                if g_type_check_instance_is_a(f, t) != 0 {
                    removeFeature(session, f)
                    again = true
                    break
                }
                list = m.getWord(list + 8)
            }
        }
        return
    }
    var list = m.getWord(r + R_FEATURES)
    while list != 0 {
        if feature.removeFeature(m.getWord(list), t) { return }
        list = m.getWord(list + 8)
    }
    var w = m.text()
    m.pushText(&w, "No feature manager for feature of type '")
    m.pushC(&w, g.g_type_name(t))
    m.pushText(&w, "'")
    const text = m.finish(&w)
    c.warning(m.cSlice(text))
    m.release(text)
}

export fn soup_session_has_feature(session: usize, t: usize) -> i32 { return if hasFeature(session, t) { 1 } else { 0 } }

pub fn getFeature(session: usize, t: usize) -> usize {
    var list = m.getWord(rec(session) + R_FEATURES)
    while list != 0 {
        const f = m.getWord(list)
        if g_type_check_instance_is_a(f, t) != 0 { return f }
        list = m.getWord(list + 8)
    }
    return 0
}

export fn soup_session_get_feature(session: usize, t: usize) -> usize { return getFeature(session, t) }

export fn soup_session_get_feature_for_message(session: usize, t: usize, msg: usize) -> usize {
    const f = getFeature(session, t)
    if f != 0 && message.disablesFeature(msg, f) { return 0 }
    return f
}

// The features that process a response's body, wrapped around it in the
// order of their stages.
export fn __mlx_soup_session_setup_body(msg: usize, stream: usize) -> usize {
    const it = message.item(msg)
    var current = g.g_object_ref(stream)
    if it == 0 { return current }
    const session = item.session(it)
    var stage: usize = 1
    while stage <= 8 {
        // As libsoup's (a stable sort of its list by stage), the features
        // of a stage go on newest first: the content sniffer added before
        // the logger still ends up outermost.
        var at = m.getWord(rec(session) + R_FEATURES)
        while at != 0 {
            const f = m.getWord(at)
            if feature.isProcessor(f) && feature.stage(f) == stage && !message.disablesFeature(msg, f) {
                const wrapped = feature.wrapInput(f, current, msg)
                if wrapped != 0 {
                    g.g_object_unref(current)
                    current = wrapped
                }
            }
            at = m.getWord(at + 8)
        }
        stage += 1
    }
    return current
}

// ---------------------------------------------------------------------------
// The queue

fn queueLength(session: usize) -> usize { return m.getWord(rec(session) + R_QUEUE_LEN) }
fn queueAt(session: usize, index: usize) -> usize { return m.getWord(m.getWord(rec(session) + R_QUEUE) + index * 8) }

pub fn lookupItem(session: usize, msg: usize) -> usize {
    var index: usize = 0
    while index < queueLength(session) {
        const it = queueAt(session, index)
        if item.msg(it) == msg { return it }
        index += 1
    }
    return 0
}

// soup_session_cancel_message (private in libsoup, used by the HSTS
// enforcer when a TLS error makes an enforced message unsafe): cancels the
// message's queue item, which then finishes with G_IO_ERROR_CANCELLED.
export fn __mlx_soup_session_cancel_message(session: usize, msg: usize) -> void {
    const it = lookupItem(session, msg)
    if it != 0 { g.g_cancellable_cancel(item.cancellable(it)) }
}

// Inserts after the items of the same or higher priority.
fn queueInsert(session: usize, it: usize) -> void {
    const r = rec(session)
    const length = m.getWord(r + R_QUEUE_LEN)
    if length == m.getWord(r + R_QUEUE_ROOM) {
        const room = if length == 0 { 8 } else { length * 2 }
        m.putWord(r + R_QUEUE, m.grow(m.getWord(r + R_QUEUE), room * 8))
        m.putWord(r + R_QUEUE_ROOM, room)
    }
    const priority = message.priorityOf(item.msg(it))
    var at = length
    var index: usize = 0
    while index < length {
        if message.priorityOf(item.msg(queueAt(session, index))) < priority {
            at = index
            break
        }
        index += 1
    }
    const queue = m.getWord(r + R_QUEUE)
    var move = length
    while move > at {
        m.putWord(queue + move * 8, m.getWord(queue + (move - 1) * 8))
        move -= 1
    }
    m.putWord(queue + at * 8, it)
    m.putWord(r + R_QUEUE_LEN, length + 1)
}

fn queueRemove(session: usize, it: usize) -> bool {
    const r = rec(session)
    const length = m.getWord(r + R_QUEUE_LEN)
    const queue = m.getWord(r + R_QUEUE)
    var index: usize = 0
    while index < length {
        if m.getWord(queue + index * 8) == it {
            var move = index
            while move + 1 < length {
                m.putWord(queue + move * 8, m.getWord(queue + (move + 1) * 8))
                move += 1
            }
            m.putWord(r + R_QUEUE_LEN, length - 1)
            return true
        }
        index += 1
    }
    return false
}

fn wouldRedirectAsGet(msg: usize) -> bool {
    const code = message.statusOf(msg)
    if code == 303 { return true }
    if code == 302 && !methodIsSafe(msg) { return true }
    return code == 301 && message.methodIs(msg, "POST")
}

fn wouldRedirectAsSafe(msg: usize) -> bool {
    const code = message.statusOf(msg)
    return (code == 301 || code == 308 || code == 307 || code == 302) && methodIsSafe(msg)
}

fn methodIsSafe(msg: usize) -> bool { return message.methodIs(msg, "GET") || message.methodIs(msg, "HEAD") || message.methodIs(msg, "OPTIONS") || message.methodIs(msg, "PROPFIND") || message.methodIs(msg, "TRACE") }

fn redirectionUri(session: usize, msg: usize, err: usize) -> usize {
    const location = soup_message_headers_get_one(message.responseHeaders(msg), m.literal("Location"))
    if location == 0 || m.get8(location) == 0 {
        c.setError(err, soup_session_error_quark(), ERROR_REDIRECT_NO_LOCATION, "Location header is missing or empty in response headers")
        return 0
    }
    const uri = g.g_uri_parse_relative(message.uri(msg), location, misc.HTTP_URI_FLAGS, 0)
    if uri == 0 { return 0 }
    const host = g.g_uri_get_host(uri)
    if host == 0 || m.get8(host) == 0 || (!misc.isHttp(uri) && !misc.isHttps(uri)) {
        g.g_uri_unref(uri)
        var t = m.text()
        m.pushText(&t, "Invalid URI “")
        m.pushC(&t, location)
        m.pushText(&t, "” in Location response header")
        const text = m.finish(&t)
        c.setError(err, soup_session_error_quark(), ERROR_REDIRECT_BAD_URI, m.cSlice(text))
        m.release(text)
        return 0
    }
    return uri
}

fn requeueItem(it: usize, err: usize) -> bool {
    if m.getI32(it + item.R_RESENDS) >= item.MAX_RESEND_COUNT {
        const code = message.statusOf(item.msg(it))
        if code >= 300 && code < 400 {
            c.setError(err, soup_session_error_quark(), ERROR_TOO_MANY_REDIRECTS, "Too many redirects")
        } else {
            c.setError(err, soup_session_error_quark(), ERROR_TOO_MANY_RESTARTS, "Message was restarted too many times")
        }
        return false
    }
    m.putI32(it + item.R_RESENDS, m.getI32(it + item.R_RESENDS) + 1)
    item.setState(it, item.REQUEUED)
    return true
}

fn redirectMessage(session: usize, msg: usize, err: usize) -> bool {
    const uri = redirectionUri(session, msg, err)
    if uri == 0 { return false }
    if wouldRedirectAsGet(msg) {
        if !message.methodIs(msg, "HEAD") { message.setMethodName(msg, "GET") }
        soup_message_set_request_body(msg, 0, 0, 0)
        soup_message_headers_set_encoding(message.requestHeaders(msg), 1)
    }
    // Credentials are not taken to another host.
    if !misc.uriHostEqual(message.uri(msg), uri) {
        soup_message_headers_remove(message.requestHeaders(msg), m.literal("Authorization"))
        soup_message_headers_remove(message.requestHeaders(msg), m.literal("Proxy-Authorization"))
        message.setAuth(msg, 0)
    }
    message.setRequestHostFromUri(msg, uri)
    message.setUri(msg, uri)
    g.g_uri_unref(uri)
    return requeueItem(lookupItem(session, msg), err)
}

fn itemErrorCell(it: usize) -> usize { return it + item.R_ERROR }

export fn __mlx_soup_session_redirect_handler(msg: usize, it: usize) -> void {
    if !wouldRedirectAsGet(msg) && !wouldRedirectAsSafe(msg) { return }
    if m.getWord(it + item.R_ERROR) != 0 { return }
    _ = redirectMessage(item.session(it), msg, itemErrorCell(it))
}

export fn __mlx_soup_session_misdirected_handler(msg: usize, it: usize) -> void {
    if m.getWord(it + item.R_ERROR) != 0 { return }
    _ = requeueItem(it, itemErrorCell(it))
}

export fn __mlx_soup_session_message_restarted(msg: usize, it: usize) -> void {
    const cn = message.connection(msg)
    const code = message.statusOf(msg)
    if cn != 0 && (!message.isKeepalive(msg) || (code >= 300 && code < 400)) { releaseConnection(it) }
    message.cleanupResponse(msg)
}

fn appendItem(session: usize, msg: usize, asynchronous: bool, cancellable: usize) -> usize {
    message.stamp(msg, metrics.FETCH_START)
    message.cleanupResponse(msg)
    message.setPreconnect(msg, false)
    const it = item.new(session, msg, asynchronous, cancellable)
    queueInsert(session, it)
    message.setItem(msg, it)
    if asynchronous { m.putI32(rec(session) + R_NUM_ASYNC, m.getI32(rec(session) + R_NUM_ASYNC) + 1) }
    if !message.hasFlag(msg, message.NO_REDIRECT) {
        _ = soup_message_add_header_handler(msg, m.literal("got_body"), m.literal("Location"), @intFromPtr(__mlx_soup_session_redirect_handler), it)
    }
    _ = soup_message_add_status_code_handler(msg, m.literal("got-body"), 421, @intFromPtr(__mlx_soup_session_misdirected_handler), it)
    _ = g.g_signal_connect_data(msg, m.literal("restarted"), @intFromPtr(__mlx_soup_session_message_restarted), it, 0, 0)
    var list = m.getWord(rec(session) + R_FEATURES)
    while list != 0 {
        const f = m.getWord(list)
        _ = g.g_object_ref(f)
        feature.requestQueued(f, msg)
        list = m.getWord(list + 8)
    }
    c.emitOne(session, sigRequestQueued, message.messageTypeGet(), msg)
    return it
}

fn unqueueItem(session: usize, it: usize) -> void {
    releaseConnection(it)
    if item.state(it) != item.FINISHED {
        c.warning("finished an item with state")
        return
    }
    if !queueRemove(session, it) { return }
    const msg = item.msg(it)
    if message.item(msg) == it { message.setItem(msg, 0) }
    if item.isAsync(it) { m.putI32(rec(session) + R_NUM_ASYNC, m.getI32(rec(session) + R_NUM_ASYNC) - 1) }
    _ = g_signal_handlers_disconnect_matched(msg, 16, 0, 0, 0, 0, it)
    var list = m.getWord(rec(session) + R_FEATURES)
    while list != 0 {
        const f = m.getWord(list)
        list = m.getWord(list + 8)
        feature.requestUnqueued(f, msg)
        g.g_object_unref(f)
    }
    c.emitOne(session, sigRequestUnqueued, message.messageTypeGet(), msg)
    item.unref(it)
}

// ---------------------------------------------------------------------------
// Connections

fn connsLength(session: usize) -> usize { return m.getWord(rec(session) + R_CONNS_LEN) }
fn connAt(session: usize, index: usize) -> usize { return m.getWord(m.getWord(rec(session) + R_CONNS) + index * 8) }

fn addConn(session: usize, cn: usize) -> void {
    const r = rec(session)
    const length = m.getWord(r + R_CONNS_LEN)
    if length == m.getWord(r + R_CONNS_ROOM) {
        const room = if length == 0 { 8 } else { length * 2 }
        m.putWord(r + R_CONNS, m.grow(m.getWord(r + R_CONNS), room * 8))
        m.putWord(r + R_CONNS_ROOM, room)
    }
    m.putWord(m.getWord(r + R_CONNS) + length * 8, cn)
    m.putWord(r + R_CONNS_LEN, length + 1)
}

fn removeConnAt(session: usize, index: usize) -> void {
    const r = rec(session)
    const length = m.getWord(r + R_CONNS_LEN)
    const conns = m.getWord(r + R_CONNS)
    conn.unref(m.getWord(conns + index * 8))
    var move = index
    while move + 1 < length {
        m.putWord(conns + move * 8, m.getWord(conns + (move + 1) * 8))
        move += 1
    }
    m.putWord(r + R_CONNS_LEN, length - 1)
}

// Drops the connections that are closed (and, `all`, the idle ones).
fn cleanupConns(session: usize, all: bool) -> void {
    var index: usize = 0
    while index < connsLength(session) {
        const cn = connAt(session, index)
        const s = conn.state(cn)
        if s == conn.DISCONNECTED || (s == conn.IDLE && (all || !conn.isIdleOpen(cn))) {
            conn.disconnect(cn)
            removeConnAt(session, index)
        } else {
            index += 1
        }
    }
}

fn sameHost(a: usize, b: usize) -> bool {
    return c.cEquals(g.g_uri_get_scheme(a), g.g_uri_get_scheme(b)) && http.equalsIgnoringCase(m.cSlice(g.g_uri_get_host(a)), m.cSlice(g.g_uri_get_host(b))) && g.g_uri_get_port(a) == g.g_uri_get_port(b)
}

// The connection for the item: an idle one to its host, or a new one when
// the limits allow (0: the item waits).
fn methodIsIdempotent(msg: usize) -> bool { return message.methodIs(msg, "GET") || message.methodIs(msg, "HEAD") || message.methodIs(msg, "OPTIONS") || message.methodIs(msg, "TRACE") || message.methodIs(msg, "PUT") || message.methodIs(msg, "DELETE") }

// Drops the closed connections and (`all`) the idle ones: whether any
// went.
fn cleanupSome(session: usize, all: bool) -> bool {
    const before = connsLength(session)
    cleanupConns(session, all)
    return connsLength(session) < before
}

// The connection for the item, as libsoup's connection manager picks it:
// the one the message kept, an idle one to its host (not for a message
// that needs a new one: SOUP_MESSAGE_NEW_CONNECTION, or a method that is
// not idempotent), or a new one when the limits allow (idle connections
// are closed to make room); 0 when the item must wait.
fn getConnection(session: usize, it: usize) -> usize {
    const msg = item.msg(it)
    const r = rec(session)
    // A message sent again keeps the connection it had (kept alive).
    const own = m.getWord(it + item.R_CONN)
    if own != 0 {
        if conn.state(own) == conn.IN_USE { return own }
        releaseConnection(it)
    }
    cleanupConns(session, false)
    const needNew = message.hasFlag(msg, message.NEW_CONNECTION) || (!message.hasFlag(msg, message.IDEMPOTENT) && !methodIsIdempotent(msg))
    const hostUri = misc.copyHost(message.uri(msg))
    var tryCleanup = true
    while true {
        // The newest connection first, as libsoup's host list has them.
        var perHost: i32 = 0
        var index = connsLength(session)
        while index > 0 {
            index -= 1
            const cn = connAt(session, index)
            if sameHost(conn.hostUri(cn), hostUri) {
                perHost += 1
                if conn.state(cn) == conn.IDLE && !needNew && conn.isIdleOpen(cn) {
                    g.g_uri_unref(hostUri)
                    conn.setInUse(cn, true, 0)
                    return cn
                }
            }
        }
        if perHost >= m.getI32(r + R_MAX_PER_HOST) {
            if needNew && tryCleanup {
                tryCleanup = false
                if cleanupSome(session, true) { continue }
            }
            g.g_uri_unref(hostUri)
            return 0
        }
        if @intCast(i32, connsLength(session)) >= m.getI32(r + R_MAX_CONNS) {
            if tryCleanup {
                tryCleanup = false
                if cleanupSome(session, true) { continue }
            }
            g.g_uri_unref(hostUri)
            return 0
        }
        break
    }
    m.putWord(r + R_LAST_CONN_ID, m.getWord(r + R_LAST_CONN_ID) + 1)
    const cn = conn.new(session, hostUri, m.get32(r + R_IO_TIMEOUT), m.getWord(r + R_LAST_CONN_ID))
    g.g_uri_unref(hostUri)
    conn.setTlsDatabase(cn, soup_session_get_tls_database(session))
    conn.setTlsInteraction(cn, m.getWord(r + R_INTERACTION))
    addConn(session, cn)
    return cn
}

fn setItemConnection(it: usize, cn: usize) -> void {
    m.putWord(it + item.R_CONN, cn)
    conn.attachMessage(cn, item.msg(it))
}

// The item lets go of its connection: idle when reusable, else closed.
fn releaseConnection(it: usize) -> void {
    const cn = m.getWord(it + item.R_CONN)
    if cn == 0 { return }
    m.putWord(it + item.R_CONN, 0)
    message.setConnection(item.msg(it), 0, 0, 0, 0, 0, 0, 0)
    const session = item.session(it)
    conn.setInUse(cn, false, m.get32(rec(session) + R_IDLE_TIMEOUT))
    if conn.state(cn) == conn.DISCONNECTED {
        var index: usize = 0
        while index < connsLength(session) {
            if connAt(session, index) == cn {
                removeConnAt(session, index)
                break
            }
            index += 1
        }
    }
    kickQueue(session)
}

export fn __mlx_soup_session_connected(cn: usize, e: usize, it: usize) -> void {
    connectComplete(it, cn, e)
    const s = item.state(it)
    if s == item.CONNECTED || s == item.READY {
        processItem(item.session(it), it, true)
    } else {
        kickQueue(item.session(it))
    }
    item.unref(it)
}

fn connectComplete(it: usize, cn: usize, e: usize) -> void {
    if e == 0 {
        item.setState(it, item.CONNECTED)
        return
    }
    message.stamp(item.msg(it), metrics.RESPONSE_END)
    item.setError(it, e)
    if item.state(it) == item.CONNECTING {
        releaseConnection(it)
        item.setState(it, item.READY)
    }
}

fn ensureItemConnection(session: usize, it: usize) -> bool {
    const cn = getConnection(session, it)
    if cn == 0 { return false }
    setItemConnection(it, cn)
    if conn.state(cn) == conn.IN_USE {
        item.setState(it, item.READY)
        return true
    }
    item.setState(it, item.CONNECTING)
    if item.isAsync(it) {
        conn.connectAsync(cn, item.msg(it), item.cancellable(it), @intFromPtr(__mlx_soup_session_connected), item.ref(it))
        return false
    }
    const cell = m.alloc(8)
    _ = conn.connectSync(cn, item.msg(it), item.cancellable(it), cell)
    const e = m.getWord(cell)
    m.release(cell)
    connectComplete(it, cn, e)
    return true
}

// ---------------------------------------------------------------------------
// Running items

fn sendItem(session: usize, it: usize) -> void {
    const r = rec(session)
    const msg = item.msg(it)
    const hdrs = message.requestHeaders(msg)
    if m.getWord(r + R_USER_AGENT) != 0 { soup_message_headers_replace(hdrs, m.literal("User-Agent"), m.getWord(r + R_USER_AGENT)) }
    if m.getWord(r + R_ACCEPT_LANGUAGE) != 0 && soup_message_headers_get_list(hdrs, m.literal("Accept-Language")) == 0 {
        soup_message_headers_append(hdrs, m.literal("Accept-Language"), m.getWord(r + R_ACCEPT_LANGUAGE))
    }
    message.setHttpVersion(msg, message.HTTP_1_1)
    message.forceKeepAliveIfNeeded(msg)
    message.updateRequestHostIfNeeded(msg)
    // A POST or PUT says its body is empty.
    if (message.methodIs(msg, "POST") || message.methodIs(msg, "PUT")) && message.requestBodyStream(msg) == 0 {
        soup_message_headers_set_content_length(hdrs, 0)
    }
    message.starting(msg)
    if item.state(it) == item.RUNNING {
        const cn = m.getWord(it + item.R_CONN)
        _ = io.new(it, cn, @intFromPtr(__mlx_soup_session_message_completed), it)
    }
}

export fn __mlx_soup_session_message_completed(msg: usize, completion: i32, it: usize) -> void {
    const session = item.session(it)
    if item.isAsync(it) { kickQueue(session) }
    if completion == io.STOLEN {
        item.setState(it, item.FINISHED)
        unqueueItem(session, it)
        return
    }
    if item.state(it) == item.REQUEUED { item.setState(it, item.RESTARTING) }
    if item.state(it) != item.RESTARTING {
        item.setState(it, item.FINISHING)
        processItem(session, it, !item.isAsync(it))
    }
}

pub fn processItem(session: usize, it: usize, loop: bool) -> void {
    _ = item.ref(it)
    var again = true
    while again {
        again = false
        if item.isPaused(it) { break }
        const s = item.state(it)
        const msg = item.msg(it)
        if s == item.STARTING {
            if g_cancellable_is_cancelled(item.cancellable(it)) != 0 {
                item.setError(it, c.ioError(19, "Operation was cancelled"))
                item.setState(it, item.FINISHING)
            } else if !ensureItemConnection(session, it) {
                break
            }
        } else if s == item.CONNECTED {
            item.setState(it, item.READY)
        } else if s == item.READY {
            if m.getI32(it + item.R_CONNECT_ONLY) != 0 || item.errorOf(it) != 0 || message.statusOf(msg) != 0 {
                item.setState(it, item.FINISHING)
            } else {
                item.setState(it, item.RUNNING)
                message.stamp(msg, metrics.REQUEST_START)
                sendItem(session, it)
                if item.isAsync(it) { sendRunning(session, it) }
                break
            }
        } else if s == item.RUNNING {
            if item.isAsync(it) { break }
            item.setState(it, item.FINISHING)
        } else if s == item.RESTARTING {
            item.setState(it, item.STARTING)
            message.stamp(msg, metrics.FETCH_START)
            message.restarted(msg)
        } else if s == item.FINISHING {
            item.setState(it, item.FINISHED)
            message.finished(msg)
            unqueueItem(session, it)
            break
        } else {
            break
        }
        again = loop && item.state(it) != item.FINISHED
    }
    item.unref(it)
}

// Runs the async items of a main context (what a kick does there).
fn runQueue(session: usize, context: usize) -> void {
    cleanupConns(session, false)
    var w = m.words()
    var index: usize = 0
    while index < queueLength(session) {
        const it = queueAt(session, index)
        if item.isAsync(it) && m.getWord(it + item.R_CONTEXT) == context && !message.methodIs(item.msg(it), "CONNECT") { m.pushWord(&w, item.ref(it)) }
        index += 1
    }
    index = 0
    while index < w.length {
        const it = m.wordAt(&w, index)
        if item.state(it) != item.FINISHED { processItem(session, it, true) }
        item.unref(it)
        index += 1
    }
    m.disposeWords(&w)
}

// A kick's idle source: the session and the context (a record of two
// words, the session referenced).
export fn __mlx_soup_session_kicked(data: usize) -> i32 {
    const session = m.getWord(data)
    const context = m.getWord(data + 8)
    const r = rec(session)
    var index: usize = 0
    while index < m.getWord(r + R_KICKS_LEN) {
        if m.getWord(m.getWord(r + R_KICKS) + index * 8) == context {
            const kicks = m.getWord(r + R_KICKS)
            var move = index
            while move + 1 < m.getWord(r + R_KICKS_LEN) {
                m.putWord(kicks + move * 8, m.getWord(kicks + (move + 1) * 8))
                move += 1
            }
            m.putWord(r + R_KICKS_LEN, m.getWord(r + R_KICKS_LEN) - 1)
            break
        }
        index += 1
    }
    runQueue(session, context)
    return 0
}

export fn __mlx_soup_session_kick_free(data: usize) -> void {
    g.g_object_unref(m.getWord(data))
    m.release(data)
}

pub fn kickQueue(session: usize) -> void {
    const r = rec(session)
    if m.getI32(r + R_NUM_ASYNC) <= 0 { return }
    var index: usize = 0
    while index < queueLength(session) {
        const it = queueAt(session, index)
        index += 1
        if !item.isAsync(it) { continue }
        const context = m.getWord(it + item.R_CONTEXT)
        var pending = false
        var k: usize = 0
        while k < m.getWord(r + R_KICKS_LEN) {
            if m.getWord(m.getWord(r + R_KICKS) + k * 8) == context { pending = true }
            k += 1
        }
        if pending { continue }
        const length = m.getWord(r + R_KICKS_LEN)
        if length == m.getWord(r + R_KICKS_ROOM) {
            const room = if length == 0 { 4 } else { length * 2 }
            m.putWord(r + R_KICKS, m.grow(m.getWord(r + R_KICKS), room * 8))
            m.putWord(r + R_KICKS_ROOM, room)
        }
        m.putWord(m.getWord(r + R_KICKS) + length * 8, context)
        m.putWord(r + R_KICKS_LEN, length + 1)
        const data = m.alloc(16)
        m.putWord(data, g.g_object_ref(session))
        m.putWord(data + 8, context)
        const source = g.g_idle_source_new()
        g.g_source_set_callback(source, @intFromPtr(__mlx_soup_session_kicked), data, @intFromPtr(__mlx_soup_session_kick_free))
        _ = g.g_source_attach(source, context)
        g.g_source_unref(source)
    }
}

// ---------------------------------------------------------------------------
// Asynchronous sending

fn expectedToBeRequeued(session: usize, msg: usize) -> bool {
    const code = message.statusOf(msg)
    if code == 401 || code == 407 {
        const manager = getFeature(session, soup_auth_manager_get_type())
        return manager == 0 || !message.disablesFeature(msg, manager)
    }
    if code == 421 { return true }
    if !message.hasFlag(msg, message.NO_REDIRECT) { return wouldRedirectAsGet(msg) || wouldRedirectAsSafe(msg) }
    return false
}

fn returnResult(it: usize, stream: usize, e: usize) -> void {
    const task = m.getWord(it + item.R_TASK)
    if task == 0 {
        if stream != 0 { g.g_object_unref(stream) }
        if e != 0 { g.g_error_free(e) }
        return
    }
    _ = g_signal_handlers_disconnect_matched(item.msg(it), 16, 0, 0, 0, 0, it)
    m.putWord(it + item.R_TASK, 0)
    item.renewCancellable(it)
    if e != 0 {
        if stream != 0 { g.g_object_unref(stream) }
        g.g_task_return_error(task, e)
    } else if item.errorOf(it) != 0 {
        if stream != 0 { g.g_object_unref(stream) }
        g.g_task_return_error(task, g.g_error_copy(item.errorOf(it)))
    } else {
        g.g_task_return_pointer(task, stream, @intFromPtr(g_object_unref))
    }
    g.g_object_unref(task)
}


export fn __mlx_soup_session_async_restarted(msg: usize, it: usize) -> void {
    c.clearObject(it + item.R_GATHER)
    m.putI32(it + item.R_IO_STARTED, 0)
}

export fn __mlx_soup_session_async_finished(msg: usize, it: usize) -> void {
    if m.getWord(it + item.R_TASK) == 0 { return }
    const gathered = m.getWord(it + item.R_GATHER)
    var stream: usize = 0
    if gathered != 0 {
        // It was not requeued after all: the body gathered is the answer.
        const size = g_memory_output_stream_get_data_size(gathered)
        const data = if size > 0 { g_memory_output_stream_steal_data(gathered) } else { m.dupSlice("") }
        stream = g_memory_input_stream_new_from_data(data, @intCast(i64, size), @intFromPtr(g_free))
    } else if m.getI32(it + item.R_IO_STARTED) != 0 {
        return
    } else {
        stream = g_memory_input_stream_new()
    }
    returnResult(it, stream, 0)
}

export fn __mlx_soup_session_spliced(ostream: usize, result: usize, it: usize) -> void {
    const istream = g.g_object_get_data(ostream, m.literal("istream"))
    _ = g.g_input_stream_close(istream, 0, 0)
    g.g_object_unref(istream)
    if g_cancellable_is_cancelled(item.cancellable(it)) != 0 || m.getWord(it + item.R_TASK) == 0 {
        item.unref(it)
        return
    }
    const cell = m.alloc(8)
    if g.g_output_stream_splice_finish(ostream, result, cell) == -1 {
        returnResult(it, 0, m.getWord(cell))
        m.release(cell)
        item.unref(it)
        return
    }
    m.release(cell)
    kickQueue(item.session(it))
    item.unref(it)
}

fn maybeComplete(session: usize, it: usize, stream: usize) -> void {
    if expectedToBeRequeued(session, item.msg(it)) {
        const ostream = g.g_memory_output_stream_new_resizable()
        c.clearObject(it + item.R_GATHER)
        m.putWord(it + item.R_GATHER, ostream)
        g.g_object_set_data(ostream, m.literal("istream"), stream)
        // G_OUTPUT_STREAM_SPLICE_CLOSE_TARGET.
        g.g_output_stream_splice_async(ostream, stream, 2, item.priority(it), item.cancellable(it), @intFromPtr(__mlx_soup_session_spliced), item.ref(it))
        return
    }
    returnResult(it, stream, 0)
}

export fn __mlx_soup_session_until_read_done(msg: usize, result: usize, it: usize) -> void {
    const cell = m.alloc(8)
    _ = io.runUntilReadFinish(result, cell)
    var e = m.getWord(cell)
    m.release(cell)
    if e != 0 && (m.getI32(it + item.R_IO_STARTED) == 0 || item.state(it) == item.RESTARTING) {
        // Restarted: it is tried again.
        g.g_error_free(e)
        return
    }
    var stream: usize = 0
    if e == 0 {
        const current = item.io(it)
        if current != 0 { stream = io.responseStream(current) }
    }
    if stream != 0 {
        maybeComplete(item.session(it), it, stream)
        return
    }
    if item.state(it) != item.FINISHED {
        if item.io(it) != 0 { io.finished(item.io(it)) }
        m.putI32(it + item.R_PAUSED, 0)
        if item.state(it) != item.FINISHED {
            item.setState(it, item.FINISHING)
            processItem(item.session(it), it, false)
        }
    }
    returnResult(it, 0, e)
}

fn sendRunning(session: usize, it: usize) -> void {
    const current = item.io(it)
    if current == 0 { return }
    if m.getWord(it + item.R_TASK) != 0 {
        m.putI32(it + item.R_IO_STARTED, 1)
        io.runUntilReadAsync(current, item.priority(it), item.cancellable(it), @intFromPtr(__mlx_soup_session_until_read_done), it)
        return
    }
    io.run(current, false)
}

fn alreadyInQueue(session: usize, msg: usize, cancellable: usize, callback: usize, data: usize) -> bool {
    if lookupItem(session, msg) == 0 { return false }
    const it = item.new(session, msg, true, cancellable)
    item.setState(it, item.FINISHED)
    item.setError(it, sessionError(ERROR_MESSAGE_ALREADY_IN_QUEUE, "Message is already in session queue"))
    const task = g.g_task_new(session, cancellable, callback, data)
    g_task_set_task_data(task, it, @intFromPtr(__mlx_soup_item_unref))
    g.g_task_return_error(task, g.g_error_copy(item.errorOf(it)))
    g.g_object_unref(task)
    return true
}

export fn soup_session_send_async(session: usize, msg: usize, priority: i32, cancellable: usize, callback: usize, data: usize) -> void {
    if alreadyInQueue(session, msg, cancellable, callback, data) { return }
    const it = appendItem(session, msg, true, cancellable)
    m.putI32(it + item.R_PRIORITY, priority)
    _ = g.g_signal_connect_data(msg, m.literal("restarted"), @intFromPtr(__mlx_soup_session_async_restarted), it, 0, 0)
    _ = g.g_signal_connect_data(msg, m.literal("finished"), @intFromPtr(__mlx_soup_session_async_finished), it, 0, 0)
    const task = g.g_task_new(session, item.cancellable(it), callback, data)
    g.g_task_set_source_tag(task, @intFromPtr(&sendTag))
    g.g_task_set_priority(task, priority)
    g_task_set_task_data(task, item.ref(it), @intFromPtr(__mlx_soup_item_unref))
    m.putWord(it + item.R_TASK, task)
    kickQueue(session)
}

export fn soup_session_send_finish(session: usize, result: usize, err: usize) -> usize {
    if g.g_task_had_error(result) != 0 {
        const it = g.g_task_get_task_data(result)
        if it != 0 && g.g_error_matches(item.errorOf(it), soup_session_error_quark(), ERROR_MESSAGE_ALREADY_IN_QUEUE) == 0 {
            if item.io(it) != 0 {
                io.finished(item.io(it))
            } else if item.state(it) != item.FINISHED {
                item.setState(it, item.FINISHING)
            }
            if item.state(it) != item.FINISHED { processItem(session, it, false) }
        }
    }
    return g.g_task_propagate_pointer(result, err)
}

// ---------------------------------------------------------------------------
// Synchronous sending

export fn soup_session_send(session: usize, msg: usize, cancellable: usize, err: usize) -> usize {
    if lookupItem(session, msg) != 0 {
        c.setError(err, soup_session_error_quark(), ERROR_MESSAGE_ALREADY_IN_QUEUE, "Message is already in session queue")
        return 0
    }
    const it = appendItem(session, msg, false, cancellable)
    _ = item.ref(it)
    var stream: usize = 0
    const cell = m.alloc(8)
    while stream == 0 {
        processItem(session, it, true)
        if item.state(it) != item.RUNNING { break }
        const current = item.io(it)
        if current == 0 { break }
        if !io.runUntilRead(current, item.cancellable(it), cell) {
            if item.state(it) == item.RESTARTING {
                g.g_clear_error(cell)
                continue
            }
            break
        }
        stream = io.responseStream(current)
        if stream == 0 { break }
        if !expectedToBeRequeued(session, msg) { break }
        // Gather the body: the message may be sent again.
        const ostream = g.g_memory_output_stream_new_resizable()
        if g.g_output_stream_splice(ostream, stream, 1 | 2, item.cancellable(it), cell) == -1 {
            g.g_object_unref(stream)
            g.g_object_unref(ostream)
            stream = 0
            break
        }
        g.g_object_unref(stream)
        stream = 0
        if item.state(it) == item.RESTARTING {
            g.g_object_unref(ostream)
            continue
        }
        const size = g_memory_output_stream_get_data_size(ostream)
        const data = if size > 0 { g_memory_output_stream_steal_data(ostream) } else { m.dupSlice("") }
        stream = g_memory_input_stream_new_from_data(data, @intCast(i64, size), @intFromPtr(g_free))
        g.g_object_unref(ostream)
    }
    item.renewCancellable(it)
    if m.getWord(cell) != 0 {
        g.g_propagate_error(err, m.getWord(cell))
        if stream != 0 {
            g.g_object_unref(stream)
            stream = 0
        }
    } else if item.errorOf(it) != 0 {
        if stream != 0 {
            g.g_object_unref(stream)
            stream = 0
        }
        if err != 0 { m.putWord(err, g.g_error_copy(item.errorOf(it))) }
    } else if stream == 0 {
        stream = g_memory_input_stream_new()
    }
    if stream == 0 {
        if item.io(it) != 0 {
            io.finished(item.io(it))
        } else if item.state(it) != item.FINISHED {
            item.setState(it, item.FINISHING)
        }
        m.putI32(it + item.R_PAUSED, 0)
        if item.state(it) != item.FINISHED { processItem(session, it, true) }
    }
    m.release(cell)
    item.unref(it)
    return stream
}

// ---------------------------------------------------------------------------
// Sending and splicing, sending and reading

// A splice's state: the output stream (0), the flags (8), the task (16).
export fn __mlx_soup_session_splice_data_free(data: usize) -> void {
    c.clearObject(data)
    m.release(data)
}

export fn __mlx_soup_session_splice_done(ostream: usize, result: usize, task: usize) -> void {
    const cell = m.alloc(8)
    const n = g.g_output_stream_splice_finish(ostream, result, cell)
    if n == -1 {
        g.g_task_return_error(task, m.getWord(cell))
    } else {
        g.g_task_return_int(task, n)
    }
    m.release(cell)
    g.g_object_unref(task)
}

export fn __mlx_soup_session_splice_sent(session: usize, result: usize, task: usize) -> void {
    const data = g.g_task_get_task_data(task)
    // The send's item, for soup_session_get_async_result_message.
    const it = g.g_task_get_task_data(result)
    if it != 0 { g.g_object_set_data_full(task, m.literal("soup-item"), item.ref(it), @intFromPtr(__mlx_soup_item_unref)) }
    const cell = m.alloc(8)
    const stream = soup_session_send_finish(session, result, cell)
    if stream == 0 {
        g.g_task_return_error(task, m.getWord(cell))
        m.release(cell)
        g.g_object_unref(task)
        return
    }
    m.release(cell)
    g.g_output_stream_splice_async(m.getWord(data), stream, @bitCast(i32, @intCast(u32, m.getWord(data + 8) & 0xffffffff)), g.g_task_get_priority(task), g.g_task_get_cancellable(task), @intFromPtr(__mlx_soup_session_splice_done), task)
    g.g_object_unref(stream)
}

export fn soup_session_send_and_splice_async(session: usize, msg: usize, out_stream: usize, flags: i32, priority: i32, cancellable: usize, callback: usize, user_data: usize) -> void {
    const task = g.g_task_new(session, cancellable, callback, user_data)
    g.g_task_set_source_tag(task, @intFromPtr(&spliceTag))
    g.g_task_set_priority(task, priority)
    const data = m.alloc(24)
    m.putWord(data, g.g_object_ref(out_stream))
    m.putWord(data + 8, @intCast(usize, @bitCast(u32, flags)))
    g_task_set_task_data(task, data, @intFromPtr(__mlx_soup_session_splice_data_free))
    soup_session_send_async(session, msg, priority, cancellable, @intFromPtr(__mlx_soup_session_splice_sent), task)
}

export fn soup_session_send_and_splice_finish(session: usize, result: usize, err: usize) -> i64 { return g.g_task_propagate_int(result, err) }

export fn soup_session_send_and_splice(session: usize, msg: usize, out_stream: usize, flags: i32, cancellable: usize, err: usize) -> i64 {
    const stream = soup_session_send(session, msg, cancellable, err)
    if stream == 0 { return -1 }
    const n = g.g_output_stream_splice(out_stream, stream, flags, cancellable, err)
    g.g_object_unref(stream)
    return n
}

export fn __mlx_soup_session_read_done(session: usize, result: usize, task: usize) -> void {
    const ostream = g.g_task_get_task_data(task)
    const it = g.g_object_get_data(result, m.literal("soup-item"))
    if it != 0 { g.g_object_set_data_full(task, m.literal("soup-item"), item.ref(it), @intFromPtr(__mlx_soup_item_unref)) }
    const cell = m.alloc(8)
    if soup_session_send_and_splice_finish(session, result, cell) != -1 {
        g.g_task_return_pointer(task, g.g_memory_output_stream_steal_as_bytes(ostream), @intFromPtr(g_bytes_unref))
    } else {
        g.g_task_return_error(task, m.getWord(cell))
    }
    m.release(cell)
    g.g_object_unref(task)
}

export fn soup_session_send_and_read_async(session: usize, msg: usize, priority: i32, cancellable: usize, callback: usize, user_data: usize) -> void {
    const ostream = g.g_memory_output_stream_new_resizable()
    const task = g.g_task_new(session, cancellable, callback, user_data)
    g.g_task_set_source_tag(task, @intFromPtr(&readTag))
    g.g_task_set_priority(task, priority)
    g_task_set_task_data(task, ostream, @intFromPtr(g_object_unref))
    soup_session_send_and_splice_async(session, msg, ostream, 1 | 2, priority, g.g_task_get_cancellable(task), @intFromPtr(__mlx_soup_session_read_done), task)
}

export fn soup_session_send_and_read_finish(session: usize, result: usize, err: usize) -> usize { return g.g_task_propagate_pointer(result, err) }

export fn soup_session_send_and_read(session: usize, msg: usize, cancellable: usize, err: usize) -> usize {
    const ostream = g.g_memory_output_stream_new_resizable()
    var bytes: usize = 0
    if soup_session_send_and_splice(session, msg, ostream, 1 | 2, cancellable, err) != -1 { bytes = g.g_memory_output_stream_steal_as_bytes(ostream) }
    g.g_object_unref(ostream)
    return bytes
}

// The message of an asynchronous operation's result: the item a send's
// task holds, or the one a splice or read kept.
export fn soup_session_get_async_result_message(session: usize, result: usize) -> usize {
    var it = g.g_object_get_data(result, m.literal("soup-item"))
    if it == 0 && (g.g_async_result_is_tagged(result, @intFromPtr(&sendTag)) != 0 || g.g_async_result_is_tagged(result, @intFromPtr(&preconnectTag)) != 0) { it = g.g_task_get_task_data(result) }
    if it == 0 { return 0 }
    return item.msg(it)
}

// ---------------------------------------------------------------------------
// Abort, pause, requeue (what the features ask)

export fn soup_session_abort(session: usize) -> void {
    var index: usize = 0
    while index < queueLength(session) {
        g.g_cancellable_cancel(item.cancellable(queueAt(session, index)))
        index += 1
    }
    cleanupConns(session, true)
}

export fn __mlx_soup_session_pause_message(session: usize, msg: usize) -> void {
    const it = lookupItem(session, msg)
    if it == 0 || !item.isAsync(it) { return }
    m.putI32(it + item.R_PAUSED, 1)
    if item.state(it) == item.RUNNING && item.io(it) != 0 { io.pause(item.io(it)) }
}

export fn __mlx_soup_session_unpause_message(session: usize, msg: usize) -> void {
    const it = lookupItem(session, msg)
    if it == 0 || !item.isAsync(it) { return }
    m.putI32(it + item.R_PAUSED, 0)
    if item.state(it) == item.RUNNING && item.io(it) != 0 {
        io.unpause(item.io(it))
        io.kick(item.io(it))
    }
    kickQueue(session)
}

export fn __mlx_soup_session_requeue_message(session: usize, msg: usize) -> void {
    const it = lookupItem(session, msg)
    if it == 0 { return }
    if m.getWord(it + item.R_ERROR) != 0 { return }
    _ = requeueItem(it, itemErrorCell(it))
}

pub fn requeueMessage(session: usize, msg: usize) -> void { __mlx_soup_session_requeue_message(session, msg) }
pub fn pauseMessage(session: usize, msg: usize) -> void { __mlx_soup_session_pause_message(session, msg) }
pub fn unpauseMessage(session: usize, msg: usize) -> void { __mlx_soup_session_unpause_message(session, msg) }

// ---------------------------------------------------------------------------
// Preconnecting

export fn __mlx_soup_session_preconnect_finished(msg: usize, it: usize) -> void {
    const task = m.getWord(it + item.R_TASK)
    if task == 0 { return }
    m.putWord(it + item.R_TASK, 0)
    _ = g_signal_handlers_disconnect_matched(msg, 16, 0, 0, 0, 0, it)
    if item.errorOf(it) != 0 {
        g.g_task_return_error(task, g.g_error_copy(item.errorOf(it)))
    } else {
        g.g_task_return_boolean(task, 1)
    }
    g.g_object_unref(task)
}

export fn soup_session_preconnect_async(session: usize, msg: usize, priority: i32, cancellable: usize, callback: usize, user_data: usize) -> void {
    if alreadyInQueue(session, msg, cancellable, callback, user_data) { return }
    const it = appendItem(session, msg, true, cancellable)
    m.putI32(it + item.R_PRIORITY, priority)
    m.putI32(it + item.R_CONNECT_ONLY, 1)
    message.setPreconnect(msg, true)
    _ = g.g_signal_connect_data(msg, m.literal("finished"), @intFromPtr(__mlx_soup_session_preconnect_finished), it, 0, 0)
    const task = g.g_task_new(session, item.cancellable(it), callback, user_data)
    g.g_task_set_source_tag(task, @intFromPtr(&preconnectTag))
    g.g_task_set_priority(task, priority)
    g_task_set_task_data(task, item.ref(it), @intFromPtr(__mlx_soup_item_unref))
    m.putWord(it + item.R_TASK, task)
    kickQueue(session)
}

export fn soup_session_preconnect_finish(session: usize, result: usize, err: usize) -> i32 { return g.g_task_propagate_boolean(result, err) }

// For the WebSocket handshake (websocket.mlx): the message's item and its
// connection's streams taken away.
pub fn appendForWebsocket(session: usize, msg: usize, cancellable: usize) -> usize { return appendItem(session, msg, true, cancellable) }
pub fn itemConnection(it: usize) -> usize { return m.getWord(it + item.R_CONN) }
