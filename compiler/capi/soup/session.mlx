extern("c") fn g_type_check_instance_is_a(instance: usize, t: usize) -> i32
extern("c") fn g_signal_handlers_disconnect_matched(instance: usize, mask: i32, id: u32, detail: u32, closure: usize, func: usize, data: usize) -> u32
extern("c") fn g_task_set_task_data(task: usize, data: usize, destroy: usize) -> void
extern("c") fn g_cancellable_is_cancelled(cancellable: usize) -> i32
