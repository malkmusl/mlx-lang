extern("c") fn g_proxy_resolver_get_type() -> usize
extern("c") fn g_inet_socket_address_get_type() -> usize
extern("c") fn g_socket_connectable_get_type() -> usize
extern("c") fn g_memory_output_stream_get_data_size(stream: usize) -> usize
extern("c") fn g_memory_output_stream_steal_data(stream: usize) -> usize
extern("c") fn g_memory_input_stream_new() -> usize
extern("c") fn g_memory_input_stream_new_from_data(data: usize, length: i64, destroy: usize) -> usize
