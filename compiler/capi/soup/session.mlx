// soup-session.h: SoupSession (libsoup's soup-session.c and its
// connection manager): a queue of messages, each taken from STARTING
// through a connection (one of the session's, kept per host and reused
// while idle, up to max-conns and max-conns-per-host), RUNNING (io.mlx),
// to FINISHED; redirects followed, requeued messages (authentication)
// sent again, the features told of each message. Asynchronous sends run
// in the thread-default main context of their caller; synchronous ones
// block on the same machinery.
//
// A SoupSession: a GObject whose private data is a pointer to a record:
//   0 the main context it was made in
//   8 the queue (items, by priority), 16 its length, 24 its room
//  32 the features (a GSList)
//  40 the connections, 48 their count, 56 the room
//  64 max-conns, 68 max-conns-per-host
//  72 the I/O timeout, 76 the idle timeout (seconds)
//  80 the user agent, 88 the Accept-Language
//  96 accept-language-auto, 100 whether the default proxy resolver is used
// 104 the proxy resolver, 112 the TLS database
// 120 whether the default TLS database is used, 124 asynchronous items
// 128 the TLS interaction, 136 the local address
// 144 the remote connectable
// 152 the main contexts a kick is pending in, 160 their count, 168 room
// 176 the last connection's id (ids count from 1 in each session)
const m = @import("../glib/memory.mlx")
const varargs = @import("../glib/varargs.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")
const misc = @import("./misc.mlx")
const conn = @import("./conn.mlx")
const item = @import("./item.mlx")
const io = @import("./io.mlx")
const message = @import("./message.mlx")
const metrics = @import("./metrics.mlx")
const feature = @import("./feature.mlx")
const bodystream = @import("./bodystream.mlx")
const http = @import("std.http.headers")
const status = @import("std.http.status")

