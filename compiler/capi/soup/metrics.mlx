// soup-message-metrics.h: SoupMessageMetrics, the times (monotonic
// microseconds) a message's fetch went through and the bytes it sent and
// received, kept when the message has SOUP_MESSAGE_COLLECT_METRICS.
//
// The record is libsoup's, fifteen 64-bit words: fetch start (0), DNS
// start (8) and end (16), connect start (24) and end (32), TLS start (40),
// request start (48), response start (56) and end (64), request header
// bytes sent (72), request body size (80) and bytes sent (88), response
// header bytes received (96), response body size (104) and bytes
// received (112).
const m = @import("../glib/memory.mlx")
const g = @import("./g.mlx")
const c = @import("./common.mlx")

pub const FETCH_START: usize = 0
pub const DNS_START: usize = 8
pub const DNS_END: usize = 16
pub const CONNECT_START: usize = 24
pub const CONNECT_END: usize = 32
pub const TLS_START: usize = 40
pub const REQUEST_START: usize = 48
pub const RESPONSE_START: usize = 56
pub const RESPONSE_END: usize = 64
pub const REQUEST_HEADER_BYTES_SENT: usize = 72
pub const REQUEST_BODY_SIZE: usize = 80
pub const REQUEST_BODY_BYTES_SENT: usize = 88
pub const RESPONSE_HEADER_BYTES_RECEIVED: usize = 96
pub const RESPONSE_BODY_SIZE: usize = 104
pub const RESPONSE_BODY_BYTES_RECEIVED: usize = 112
pub const SIZE: usize = 120

var metricsType: usize = 0

export fn soup_message_metrics_get_type() -> usize {
    if c.onceEnter(&metricsType) {
        c.onceLeave(&metricsType, g.g_boxed_type_register_static(m.literal("SoupMessageMetrics"), @intFromPtr(soup_message_metrics_copy), @intFromPtr(soup_message_metrics_free)))
    }
    return metricsType
}

pub fn new() -> usize { return m.alloc(SIZE) }

export fn soup_message_metrics_copy(metrics: usize) -> usize {
    if metrics == 0 { return 0 }
    const copy = m.alloc(SIZE)
    m.copy(copy, metrics, SIZE)
    return copy
}

export fn soup_message_metrics_free(metrics: usize) -> void { m.release(metrics) }

// Sets the time of a stage to now: the fetch start clears the rest (a
// restarted message starts over), the response start keeps the first one
// (an informational response comes before the final one).
pub fn stamp(metrics: usize, field: usize) -> void {
    if metrics == 0 { return }
    const now = @bitCast(u64, g.g_get_monotonic_time())
    if field == FETCH_START {
        m.zero(metrics, SIZE)
    } else if field == RESPONSE_START && m.getWord(metrics + RESPONSE_START) != 0 {
        return
    }
    m.putWord(metrics + field, now)
}

pub fn add(metrics: usize, field: usize, count: u64) -> void {
    if metrics == 0 { return }
    m.putWord(metrics + field, m.getWord(metrics + field) +% count)
}

fn read(metrics: usize, field: usize) -> u64 { return if metrics == 0 { 0 } else { m.getWord(metrics + field) } }

export fn soup_message_metrics_get_fetch_start(metrics: usize) -> u64 { return read(metrics, FETCH_START) }
export fn soup_message_metrics_get_dns_start(metrics: usize) -> u64 { return read(metrics, DNS_START) }
export fn soup_message_metrics_get_dns_end(metrics: usize) -> u64 { return read(metrics, DNS_END) }
export fn soup_message_metrics_get_connect_start(metrics: usize) -> u64 { return read(metrics, CONNECT_START) }
export fn soup_message_metrics_get_connect_end(metrics: usize) -> u64 { return read(metrics, CONNECT_END) }
export fn soup_message_metrics_get_tls_start(metrics: usize) -> u64 { return read(metrics, TLS_START) }
export fn soup_message_metrics_get_request_start(metrics: usize) -> u64 { return read(metrics, REQUEST_START) }
export fn soup_message_metrics_get_response_start(metrics: usize) -> u64 { return read(metrics, RESPONSE_START) }
export fn soup_message_metrics_get_response_end(metrics: usize) -> u64 { return read(metrics, RESPONSE_END) }
export fn soup_message_metrics_get_request_header_bytes_sent(metrics: usize) -> u64 { return read(metrics, REQUEST_HEADER_BYTES_SENT) }
export fn soup_message_metrics_get_request_body_size(metrics: usize) -> u64 { return read(metrics, REQUEST_BODY_SIZE) }
export fn soup_message_metrics_get_request_body_bytes_sent(metrics: usize) -> u64 { return read(metrics, REQUEST_BODY_BYTES_SENT) }
export fn soup_message_metrics_get_response_header_bytes_received(metrics: usize) -> u64 { return read(metrics, RESPONSE_HEADER_BYTES_RECEIVED) }
export fn soup_message_metrics_get_response_body_size(metrics: usize) -> u64 { return read(metrics, RESPONSE_BODY_SIZE) }
export fn soup_message_metrics_get_response_body_bytes_received(metrics: usize) -> u64 { return read(metrics, RESPONSE_BODY_BYTES_RECEIVED) }
