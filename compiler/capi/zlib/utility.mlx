// The one-call functions (compress, uncompress and their bounds), the
// version and error strings, and inflateBack, which inflates raw deflate
// data from an input function to an output function through the
// caller's window.
const c = @import("./common.mlx")
const deflate = @import("./deflate.mlx")
const inflate = @import("./inflate.mlx")

pub fn compressBuffer(dest: usize, destLen: usize, source: usize, sourceLen0: u64, level: i32) -> i32 {
    var stream: c.ZStream = undefined
    c.zero(@intFromPtr(&stream), @sizeOf(c.ZStream))
    const strm = @intFromPtr(&stream)
    const max: u64 = 0xffffffff
    var left = c.getWord(destLen)
    var sourceLen = sourceLen0
    c.putWord(destLen, 0)
    var err = deflate.init2(strm, level, c.Z_DEFLATED, c.MAX_WBITS, c.DEF_MEM_LEVEL, c.Z_DEFAULT_STRATEGY, c.literal(c.VERSION), c.STREAM_SIZE)
    if err != c.Z_OK { return err }
    stream.next_out = dest
    stream.avail_out = 0
    stream.next_in = source
    stream.avail_in = 0
    while true {
        if stream.avail_out == 0 {
            stream.avail_out = @intCast(u32, if left > max { max } else { left })
            left -= @intCast(u64, stream.avail_out)
        }
        if stream.avail_in == 0 {
            stream.avail_in = @intCast(u32, if sourceLen > max { max } else { sourceLen })
            sourceLen -= @intCast(u64, stream.avail_in)
        }
        err = deflate.run(strm, if sourceLen != 0 { c.Z_NO_FLUSH } else { c.Z_FINISH })
        if err != c.Z_OK { break }
    }
    c.putWord(destLen, stream.total_out)
    _ = deflate.end(strm)
    return if err == c.Z_STREAM_END { c.Z_OK } else { err }
}

pub fn bound(sourceLen: u64) -> u64 {
    return sourceLen + (sourceLen >> 12) + (sourceLen >> 14) + (sourceLen >> 25) + 13
}

pub fn uncompressBuffer(dest0: usize, destLen: usize, source: usize, sourceLen: usize) -> i32 {
    var stream: c.ZStream = undefined
    c.zero(@intFromPtr(&stream), @sizeOf(c.ZStream))
    const strm = @intFromPtr(&stream)
    const max: u64 = 0xffffffff
    var len = c.getWord(sourceLen)
    var left: u64 = 0
    var dest = dest0
    // (With no room at all, one byte of its own tells whether there is
    // data at all.)
    var buf: u64 = 0
    if c.getWord(destLen) != 0 {
        left = c.getWord(destLen)
        c.putWord(destLen, 0)
    } else {
        left = 1
        dest = @intFromPtr(&buf)
    }
    stream.next_in = source
    stream.avail_in = 0
    var err = inflate.init2(strm, c.MAX_WBITS, c.literal(c.VERSION), c.STREAM_SIZE)
    if err != c.Z_OK { return err }
    stream.next_out = dest
    stream.avail_out = 0
    while true {
        if stream.avail_out == 0 {
            stream.avail_out = @intCast(u32, if left > max { max } else { left })
            left -= @intCast(u64, stream.avail_out)
        }
        if stream.avail_in == 0 {
            stream.avail_in = @intCast(u32, if len > max { max } else { len })
            len -= @intCast(u64, stream.avail_in)
        }
        err = inflate.run(strm, c.Z_NO_FLUSH)
        if err != c.Z_OK { break }
    }
    c.putWord(sourceLen, c.getWord(sourceLen) - (len + @intCast(u64, stream.avail_in)))
    if dest != @intFromPtr(&buf) {
        c.putWord(destLen, stream.total_out)
    } else if stream.total_out != 0 && err == c.Z_BUF_ERROR {
        left = 1
    }
    _ = inflate.end(strm)
    if err == c.Z_STREAM_END { return c.Z_OK }
    if err == c.Z_NEED_DICT { return c.Z_DATA_ERROR }
    if err == c.Z_BUF_ERROR && left + @intCast(u64, stream.avail_out) != 0 { return c.Z_DATA_ERROR }
    return err
}

// The sizes of uInt, uLong, pointers and z_off_t (4, 8, 8, 8 bytes) and
// the options zlib reports (none).
pub fn compileFlags() -> u64 { return 1 + (2 << 2) + (2 << 4) + (2 << 6) }

// ---------------------------------------------------------------------------
// inflateBack

const InFunc = fn(usize, usize) -> u32
const OutFunc = fn(usize, usize, u32) -> i32

pub fn backInit(strmAddress: usize, windowBits: i32, window: usize, version: usize, streamSize: i32) -> i32 {
    if !c.versionMatches(version, streamSize) { return c.Z_VERSION_ERROR }
    if strmAddress == 0 || window == 0 || windowBits < 8 || windowBits > 15 { return c.Z_STREAM_ERROR }
    const result = inflate.init2(strmAddress, -windowBits, version, streamSize)
    if result != c.Z_OK { return result }
    inflate.client(strmAddress).* = window
    return c.Z_OK
}

// Raw deflate data from IN to OUT: the caller's window is filled with
// output and handed to OUT each time it is full, and what is left at the
// end; inflate keeps the history itself.
pub fn back(strmAddress: usize, inFunc: usize, inDesc: usize, outFunc: usize, outDesc: usize) -> i32 {
    if strmAddress == 0 { return c.Z_STREAM_ERROR }
    const strm = c.stream(strmAddress)
    if strm.*.state == 0 { return c.Z_STREAM_ERROR }
    const window = inflate.client(strmAddress).*
    if window == 0 { return c.Z_STREAM_ERROR }
    strm.*.msg = 0
    const wsize = inflate.windowSize(strmAddress)
    _ = inflate.reset(strmAddress)
    const input: InFunc = unsafe { @ptrFromInt(InFunc, inFunc) }
    const output: OutFunc = unsafe { @ptrFromInt(OutFunc, outFunc) }
    var next = strm.*.next_in
    var have: usize = if next != 0 { @intCast(usize, strm.*.avail_in) } else { 0 }
    var filled: usize = 0
    var ret = c.Z_OK
    var nextSlot: usize = 0
    while true {
        if have == 0 {
            have = @intCast(usize, input(inDesc, @intFromPtr(&nextSlot)))
            next = nextSlot
            if have == 0 {
                next = 0
                ret = c.Z_BUF_ERROR
                break
            }
        }
        strm.*.next_in = next
        strm.*.avail_in = @intCast(u32, have)
        strm.*.next_out = window + filled
        strm.*.avail_out = @intCast(u32, wsize - filled)
        const result = inflate.run(strmAddress, c.Z_NO_FLUSH)
        next = strm.*.next_in
        have = @intCast(usize, strm.*.avail_in)
        filled = wsize - @intCast(usize, strm.*.avail_out)
        if result == c.Z_STREAM_END || result == c.Z_DATA_ERROR || result == c.Z_MEM_ERROR || result == c.Z_STREAM_ERROR {
            ret = result
            break
        }
        if filled == wsize {
            if output(outDesc, window, @intCast(u32, wsize)) != 0 {
                ret = c.Z_BUF_ERROR
                filled = 0
                break
            }
            filled = 0
        }
    }
    if filled != 0 {
        if output(outDesc, window, @intCast(u32, filled)) != 0 && ret == c.Z_STREAM_END { ret = c.Z_BUF_ERROR }
    }
    strm.*.next_in = next
    strm.*.avail_in = @intCast(u32, have)
    return ret
}

pub fn backEnd(strmAddress: usize) -> i32 {
    if strmAddress == 0 { return c.Z_STREAM_ERROR }
    const strm = c.stream(strmAddress)
    if strm.*.state == 0 || strm.*.zfree == 0 { return c.Z_STREAM_ERROR }
    return inflate.end(strmAddress)
}

// ---------------------------------------------------------------------------

export fn zlibVersion() -> usize { return c.literal(c.VERSION) }
export fn zlibCompileFlags() -> u64 { return compileFlags() }
export fn zError(err: i32) -> usize { return c.errorMessage(err) }
export fn compress(dest: usize, destLen: usize, source: usize, sourceLen: u64) -> i32 { return compressBuffer(dest, destLen, source, sourceLen, -1) }
export fn compress2(dest: usize, destLen: usize, source: usize, sourceLen: u64, level: i32) -> i32 { return compressBuffer(dest, destLen, source, sourceLen, level) }
export fn compressBound(sourceLen: u64) -> u64 { return bound(sourceLen) }
export fn uncompress(dest: usize, destLen: usize, source: usize, sourceLen: u64) -> i32 {
    var length: u64 = sourceLen
    return uncompressBuffer(dest, destLen, source, @intFromPtr(&length))
}
export fn uncompress2(dest: usize, destLen: usize, source: usize, sourceLen: usize) -> i32 { return uncompressBuffer(dest, destLen, source, sourceLen) }
export fn inflateBackInit_(strm: usize, windowBits: i32, window: usize, version: usize, stream_size: i32) -> i32 { return backInit(strm, windowBits, window, version, stream_size) }
export fn inflateBack(strm: usize, in_: usize, in_desc: usize, out: usize, out_desc: usize) -> i32 { return back(strm, in_, in_desc, out, out_desc) }
export fn inflateBackEnd(strm: usize) -> i32 { return backEnd(strm) }
