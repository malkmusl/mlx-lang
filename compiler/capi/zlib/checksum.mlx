// zlib.h's check value functions: std.crc's Adler-32 and CRC-32 with
// zlib's arguments (a null buffer gives the initial value).
const checksum = @import("std.crc")

export fn adler32(adler: u64, buf: usize, len: u32) -> u64 { return checksum.adler32Update(adler, buf, @intCast(usize, len)) }
export fn adler32_z(adler: u64, buf: usize, len: usize) -> u64 { return checksum.adler32Update(adler, buf, len) }
export fn crc32(crc: u64, buf: usize, len: u32) -> u64 { return checksum.crc32Update(crc, buf, @intCast(usize, len)) }
export fn crc32_z(crc: u64, buf: usize, len: usize) -> u64 { return checksum.crc32Update(crc, buf, len) }
export fn adler32_combine(adler1: u64, adler2: u64, len2: i64) -> u64 { return checksum.adler32Combine(adler1, adler2, len2) }
export fn adler32_combine64(adler1: u64, adler2: u64, len2: i64) -> u64 { return checksum.adler32Combine(adler1, adler2, len2) }
export fn crc32_combine(crc1: u64, crc2: u64, len2: i64) -> u64 { return checksum.crc32Combine(crc1, crc2, len2) }
export fn crc32_combine64(crc1: u64, crc2: u64, len2: i64) -> u64 { return checksum.crc32Combine(crc1, crc2, len2) }
export fn crc32_combine_gen(len2: i64) -> u64 { return checksum.crc32CombineGen(len2) }
export fn crc32_combine_gen64(len2: i64) -> u64 { return checksum.crc32CombineGen(len2) }
export fn crc32_combine_op(crc1: u64, crc2: u64, op: u64) -> u64 { return checksum.crc32CombineOp(crc1, crc2, op) }
export fn get_crc_table() -> usize { return checksum.table() }
