// What the parts of mlx-zlib share: the z_stream and gz_header structures
// as C lays them out, the return codes and their messages, the stream's
// allocator (zalloc and zfree, or the C library's malloc and free when
// the caller gives none), a z_stream made the std.flate Stream of a call
// and back (enter, leave), and byte access by address.
//
// Arithmetic is done in 64-bit words (usize, u64, i64) and values are
// narrowed only where memory holds them narrower: a narrow integer in a
// register is not cut to its width by every operation, so a shifted or
// complemented u32 or u16 is masked before it is compared or stored.

const flate = @import("std.flate")
const zs = @import("std.flate.stream")

extern("c") fn malloc(size: usize) -> usize
extern("c") fn calloc(count: usize, size: usize) -> usize
extern("c") fn free(address: usize) -> void
extern("c") fn memcpy(target: usize, source: usize, count: usize) -> usize
extern("c") fn memmove(target: usize, source: usize, count: usize) -> usize
extern("c") fn memset(target: usize, value: i32, count: usize) -> usize

// z_stream (112 bytes): next_in and the rest as zlib.h declares them.
pub const ZStream = struct {
    next_in: usize
    avail_in: u32
    total_in: u64
    next_out: usize
    avail_out: u32
    total_out: u64
    msg: usize
    state: usize
    zalloc: usize
    zfree: usize
    opaque: usize
    data_type: i32
    adler: u64
    reserved: u64
}

// gz_header (80 bytes): std.flate's Header is laid out the same.
pub const GzHeader = struct {
    text: i32
    time: u64
    xflags: i32
    os: i32
    extra: usize
    extra_len: u32
    extra_max: u32
    name: usize
    name_max: u32
    comment: usize
    comm_max: u32
    hcrc: i32
    done: i32
}

pub const Z_NO_FLUSH: i32 = 0
pub const Z_PARTIAL_FLUSH: i32 = 1
pub const Z_SYNC_FLUSH: i32 = 2
pub const Z_FULL_FLUSH: i32 = 3
pub const Z_FINISH: i32 = 4
pub const Z_BLOCK: i32 = 5
pub const Z_TREES: i32 = 6

pub const Z_OK: i32 = 0
pub const Z_STREAM_END: i32 = 1
pub const Z_NEED_DICT: i32 = 2
pub const Z_ERRNO: i32 = -1
pub const Z_STREAM_ERROR: i32 = -2
pub const Z_DATA_ERROR: i32 = -3
pub const Z_MEM_ERROR: i32 = -4
pub const Z_BUF_ERROR: i32 = -5
pub const Z_VERSION_ERROR: i32 = -6

pub const Z_FILTERED: i32 = 1
pub const Z_HUFFMAN_ONLY: i32 = 2
pub const Z_RLE: i32 = 3
pub const Z_FIXED: i32 = 4
pub const Z_DEFAULT_STRATEGY: i32 = 0

pub const Z_BINARY: i32 = 0
pub const Z_TEXT: i32 = 1
pub const Z_UNKNOWN: i32 = 2
pub const Z_DEFLATED: i32 = 8

pub const MAX_WBITS: i32 = 15
pub const DEF_MEM_LEVEL: i32 = 8
// The operating system a gzip header names: Unix.
pub const OS_CODE: usize = 3

// The version the library is, and the first character a caller's
// version string must share with it.
pub const VERSION: []const u8 = "1.3.1"
pub const VERSION_NUMBER: u64 = 0x1310

// The size of z_stream, which deflateInit_ and inflateInit_ check.
pub const STREAM_SIZE: i32 = 112

// The address of a literal's bytes (a NUL follows them), for C.
pub fn literal(text: []const u8) -> usize { return @intFromPtr(text.pointer) }

// The message of a return code (zError, and the msg of a stream).
pub fn errorMessage(code: i32) -> usize { return zs.errorMessage(code) }

// Whether a caller's version string is one the library serves: its first
// character is the library's, and its z_stream has the library's size.
pub fn versionMatches(version: usize, streamSize: i32) -> bool {
    if version == 0 || streamSize != STREAM_SIZE { return false }
    return get8(version) == VERSION[0]
}

pub inline fn stream(address: usize) -> *ZStream { return unsafe { @ptrFromInt(*ZStream, address) } }
pub inline fn header(address: usize) -> *GzHeader { return unsafe { @ptrFromInt(*GzHeader, address) } }
pub inline fn bytes(address: usize) -> [*]u8 { return unsafe { @ptrFromInt([*]u8, address) } }
pub inline fn shorts(address: usize) -> [*]u16 { return unsafe { @ptrFromInt([*]u16, address) } }

pub inline fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
pub inline fn put8(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*u8, address).* = @intCast(u8, value & 255) } }
pub inline fn get16(address: usize) -> u16 { unsafe { return @ptrFromInt(*u16, address).* } }
pub inline fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }
pub inline fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub inline fn put32(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*u32, address).* = @intCast(u32, value & 0xffffffff) } }
pub inline fn getI32(address: usize) -> i32 { unsafe { return @ptrFromInt(*i32, address).* } }
pub inline fn putI32(address: usize, value: i32) -> void { unsafe { @ptrFromInt(*i32, address).* = value } }
pub inline fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
pub inline fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if count != 0 { _ = memcpy(target, source, count) }
}

pub fn move(target: usize, source: usize, count: usize) -> void {
    if count != 0 { _ = memmove(target, source, count) }
}

pub fn zero(target: usize, count: usize) -> void {
    if count != 0 { _ = memset(target, 0, count) }
}

// A C string's length.
pub fn cLength(text: usize) -> usize {
    var count: usize = 0
    while get8(text + count) != 0 { count += 1 }
    return count
}

// Memory of the C library (the gz functions' states and buffers).
pub fn rawAlloc(size: usize) -> usize { return malloc(if size == 0 { 1 } else { size }) }
pub fn rawFree(address: usize) -> void { if address != 0 { free(address) } }

// ---------------------------------------------------------------------------
// The stream's allocator: zalloc(opaque, items, size) and zfree(opaque,
// address), the caller's or these, which are the C library's malloc and
// free (as zlib's own are).

const AllocFunc = fn(usize, u32, u32) -> usize
const FreeFunc = fn(usize, usize) -> void

export fn __mlx_zlib_zcalloc(opaque: usize, items: u32, size: u32) -> usize {
    return malloc(@intCast(usize, items) * @intCast(usize, size))
}

export fn __mlx_zlib_zcfree(opaque: usize, address: usize) -> void {
    free(address)
}

// Gives a stream without an allocator the default ones.
pub fn defaultAllocators(strm: *ZStream) -> void {
    if strm.*.zalloc == 0 {
        strm.*.zalloc = @intFromPtr(__mlx_zlib_zcalloc)
        strm.*.opaque = 0
    }
    if strm.*.zfree == 0 { strm.*.zfree = @intFromPtr(__mlx_zlib_zcfree) }
}

// The stream's allocator as std.flate's: CONTEXT is the z_stream, whose
// zalloc, zfree and opaque are called (zalloc with the size as the count
// of one-byte items).
fn streamAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const strm = stream(@intFromPtr(context))
    const call: AllocFunc = unsafe { @ptrFromInt(AllocFunc, strm.*.zalloc) }
    const address = call(strm.*.opaque, @intCast(u32, length & 0xffffffff), 1)
    if address == 0 { return null }
    return bytes(address)
}

fn streamResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> bool { return false }

fn streamRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> ?[*]u8 { return null }

fn streamFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    const strm = stream(@intFromPtr(context))
    const call: FreeFunc = unsafe { @ptrFromInt(FreeFunc, strm.*.zfree) }
    call(strm.*.opaque, @intFromPtr(memory))
}

fn allocatorOf(strmAddress: usize) -> flate.Allocator {
    unsafe {
        return flate.Allocator.{
            .context = @ptrFromInt(*anyopaque, strmAddress),
            .allocFn = streamAlloc,
            .resizeFn = streamResize,
            .remapFn = streamRemap,
            .freeFn = streamFree,
        }
    }
}

// Makes *S the std.flate Stream of the z_stream at STRM for one call (its
// owner the z_stream's address, so that a z_stream copied by hand is
// refused, as zlib refuses it); false, and a stream with no state, when
// STRM is null or has no allocator (the engine then answers as zlib does
// for a stream that is not set up).
pub fn enter(s: *zs.Stream, strmAddress: usize) -> bool {
    s.*.next_in = 0
    s.*.avail_in = 0
    s.*.total_in = 0
    s.*.next_out = 0
    s.*.avail_out = 0
    s.*.total_out = 0
    s.*.msg = 0
    s.*.state = 0
    s.*.data_type = 0
    s.*.adler = 0
    s.*.allocator = allocatorOf(strmAddress)
    s.*.owner = 0
    if strmAddress == 0 { return false }
    const strm = stream(strmAddress)
    if strm.*.zalloc == 0 || strm.*.zfree == 0 { return false }
    s.*.next_in = strm.*.next_in
    s.*.avail_in = strm.*.avail_in
    s.*.total_in = strm.*.total_in
    s.*.next_out = strm.*.next_out
    s.*.avail_out = strm.*.avail_out
    s.*.total_out = strm.*.total_out
    s.*.msg = strm.*.msg
    s.*.state = strm.*.state
    s.*.data_type = strm.*.data_type
    s.*.adler = strm.*.adler
    s.*.owner = strmAddress
    return true
}

// Gives the z_stream at STRM what the call did to *S.
pub fn leave(s: *zs.Stream, strmAddress: usize) -> void {
    const strm = stream(strmAddress)
    strm.*.next_in = s.*.next_in
    strm.*.avail_in = s.*.avail_in
    strm.*.total_in = s.*.total_in
    strm.*.next_out = s.*.next_out
    strm.*.avail_out = s.*.avail_out
    strm.*.total_out = s.*.total_out
    strm.*.msg = s.*.msg
    strm.*.state = s.*.state
    strm.*.data_type = s.*.data_type
    strm.*.adler = s.*.adler
}
