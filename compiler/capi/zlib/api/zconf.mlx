// zconf.h
// mlx-zlib: the configuration of zlib's C API for x86_64 Linux: its
// basic types, the sizes of the window and the hash tables, and the
// macros old programs write declarations with (FAR, OF, ZEXTERN...),
// which are empty or plain here. The library is this repository's own,
// in Mlx (compiler/capi/zlib, over std.flate); these modules declare what
// C and C++ programs written for zlib name, and mlx-cheaders makes the
// headers of them.
const c_function_pointers = true
const c_system_headers = "sys/types.h stdarg.h stddef.h limits.h unistd.h"

// (Mlx names of C types: C has them as they are.)
pub const c_char = u8
pub const c_uchar = u8
pub const c_int = i32
pub const c_uint = u32
pub const c_long = i64
pub const c_ulong = u64
pub const c_size = usize
pub const c_va_list = usize
// A variadic function's `...`.
pub const c_varargs = usize
// C tokens a macro takes or stands for.
pub const c_tokens = usize

pub const ZCONF_H: c_tokens = ""

// The largest memLevel and windowBits deflateInit2 and inflateInit2 take.
pub const MAX_MEM_LEVEL: c_int = 9
pub const MAX_WBITS: c_int = 15

// (Qualifiers and linkage of the declarations: zlib's defaults.)
pub const z_const: c_tokens = ""
pub const FAR: c_tokens = ""
pub const ZEXTERN: c_tokens = "extern"
pub const ZEXPORT: c_tokens = ""
pub const ZEXPORTVA: c_tokens = ""

// The prototypes of compilers without them, written OF((...)).
pub inline fn OF(args: c_tokens) -> c_tokens { return args }
pub inline fn Z_ARG(args: c_tokens) -> c_tokens { return args }

pub const Byte = c_uchar
pub const uInt = c_uint
pub const uLong = c_ulong
pub const Bytef = Byte
pub const charf = c_char
pub const intf = c_int
pub const uIntf = uInt
pub const uLongf = uLong
pub const voidpc = *const anyopaque
pub const voidpf = *anyopaque
pub const voidp = *anyopaque
pub const z_crc_t = c_uint
pub const z_size_t = c_size
pub const z_off_t = c_long
pub const z_off64_t = c_long
