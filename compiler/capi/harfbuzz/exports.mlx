// The C API: one exported function per HarfBuzz function, each a thin
// call into std.shaping (after setup.ensure() has handed the library
// C's memory functions and locale). Written by tools/harfbuzz_exports.py
// from the API modules; not to be edited by hand.
const setup = @import("./setup.mlx")
const std_blob = @import("std.shaping.blob")
const std_buffer = @import("std.shaping.buffer")
const std_cmap = @import("std.shaping.cmap")
const std_common = @import("std.shaping.common")
const std_draw = @import("std.shaping.draw")
const std_face = @import("std.shaping.face")
const std_font = @import("std.shaping.font")
const std_layout = @import("std.shaping.layout")
const std_metrics = @import("std.shaping.metrics")
const std_otfont = @import("std.shaping.otfont")
const std_paint = @import("std.shaping.paint")
const std_serialize = @import("std.shaping.serialize")
const std_set = @import("std.shaping.set")
const std_shape = @import("std.shaping.shape")
const std_tags = @import("std.shaping.tags")
const std_unicode = @import("std.shaping.unicode")
const std_variations = @import("std.shaping.variations")

// std.shaping.blob
export fn hb_blob_create(data: usize, length: u32, mode: u32, user_data: usize, destroy: usize) -> usize {
    setup.ensure()
    return std_blob.blobCreate(data, length, mode, user_data, destroy)
}
export fn hb_blob_create_or_fail(data: usize, length: u32, mode: u32, user_data: usize, destroy: usize) -> usize {
    setup.ensure()
    return std_blob.blobCreateOrFail(data, length, mode, user_data, destroy)
}
