// hb-font.h
// mlx-harfbuzz: fonts: a face at a size (scale, ppem, point size), with
// variations and synthetic bold and slant, and the functions that give its
// glyphs (nominal and variation glyphs, advances, origins, kerning,
// extents, contour points, names, outlines, paints) through a font
// functions object, sub-fonts chaining to their parent.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")
const hb_face = @import("./hb_face.mlx")
const hb_draw = @import("./hb_draw.mlx")
const hb_paint = @import("./hb_paint.mlx")

pub const hb_font_funcs_t = struct {}

pub extern("c") fn hb_font_funcs_create() -> *hb_font_funcs_t
pub extern("c") fn hb_font_funcs_get_empty() -> *hb_font_funcs_t
pub extern("c") fn hb_font_funcs_reference(ffuncs: *hb_font_funcs_t) -> *hb_font_funcs_t
pub extern("c") fn hb_font_funcs_destroy(ffuncs: *hb_font_funcs_t) -> void
pub extern("c") fn hb_font_funcs_set_user_data(ffuncs: *hb_font_funcs_t, key: *hb_user_data_key_t, data: *anyopaque, destroy: hb_destroy_func_t, replace: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_font_funcs_get_user_data(ffuncs: *const hb_font_funcs_t, key: *hb_user_data_key_t) -> *anyopaque
pub extern("c") fn hb_font_funcs_make_immutable(ffuncs: *hb_font_funcs_t) -> void
pub extern("c") fn hb_font_funcs_is_immutable(ffuncs: *hb_font_funcs_t) -> hb_bool_t
pub const hb_font_extents_t = struct {
    ascender: hb_position_t
    descender: hb_position_t
    line_gap: hb_position_t
    reserved9: hb_position_t
    reserved8: hb_position_t
    reserved7: hb_position_t
    reserved6: hb_position_t
    reserved5: hb_position_t
    reserved4: hb_position_t
    reserved3: hb_position_t
    reserved2: hb_position_t
    reserved1: hb_position_t
}

pub const hb_font_get_font_extents_func_t = fn(font: *hb_font_t, font_data: *anyopaque, extents: *hb_font_extents_t, user_data: *anyopaque) -> hb_bool_t

pub const hb_font_get_font_h_extents_func_t = hb_font_get_font_extents_func_t

pub const hb_font_get_font_v_extents_func_t = hb_font_get_font_extents_func_t

pub const hb_font_get_nominal_glyph_func_t = fn(font: *hb_font_t, font_data: *anyopaque, unicode: hb_codepoint_t, glyph: *hb_codepoint_t, user_data: *anyopaque) -> hb_bool_t

pub const hb_font_get_variation_glyph_func_t = fn(font: *hb_font_t, font_data: *anyopaque, unicode: hb_codepoint_t, variation_selector: hb_codepoint_t, glyph: *hb_codepoint_t, user_data: *anyopaque) -> hb_bool_t

pub const hb_font_get_nominal_glyphs_func_t = fn(font: *hb_font_t, font_data: *anyopaque, count: c_uint, first_unicode: *const hb_codepoint_t, unicode_stride: c_uint, first_glyph: *hb_codepoint_t, glyph_stride: c_uint, user_data: *anyopaque) -> c_uint

pub const hb_font_get_glyph_advance_func_t = fn(font: *hb_font_t, font_data: *anyopaque, glyph: hb_codepoint_t, user_data: *anyopaque) -> hb_position_t

pub const hb_font_get_glyph_h_advance_func_t = hb_font_get_glyph_advance_func_t

pub const hb_font_get_glyph_v_advance_func_t = hb_font_get_glyph_advance_func_t

pub const hb_font_get_glyph_advances_func_t = fn(font: *hb_font_t, font_data: *anyopaque, count: c_uint, first_glyph: *const hb_codepoint_t, glyph_stride: c_uint, first_advance: *hb_position_t, advance_stride: c_uint, user_data: *anyopaque) -> void

pub const hb_font_get_glyph_h_advances_func_t = hb_font_get_glyph_advances_func_t

pub const hb_font_get_glyph_v_advances_func_t = hb_font_get_glyph_advances_func_t

pub const hb_font_get_glyph_origin_func_t = fn(font: *hb_font_t, font_data: *anyopaque, glyph: hb_codepoint_t, x: *hb_position_t, y: *hb_position_t, user_data: *anyopaque) -> hb_bool_t

pub const hb_font_get_glyph_h_origin_func_t = hb_font_get_glyph_origin_func_t

pub const hb_font_get_glyph_v_origin_func_t = hb_font_get_glyph_origin_func_t

pub const hb_font_get_glyph_kerning_func_t = fn(font: *hb_font_t, font_data: *anyopaque, first_glyph: hb_codepoint_t, second_glyph: hb_codepoint_t, user_data: *anyopaque) -> hb_position_t

pub const hb_font_get_glyph_h_kerning_func_t = hb_font_get_glyph_kerning_func_t

pub const hb_font_get_glyph_extents_func_t = fn(font: *hb_font_t, font_data: *anyopaque, glyph: hb_codepoint_t, extents: *hb_glyph_extents_t, user_data: *anyopaque) -> hb_bool_t

pub const hb_font_get_glyph_contour_point_func_t = fn(font: *hb_font_t, font_data: *anyopaque, glyph: hb_codepoint_t, point_index: c_uint, x: *hb_position_t, y: *hb_position_t, user_data: *anyopaque) -> hb_bool_t

pub const hb_font_get_glyph_name_func_t = fn(font: *hb_font_t, font_data: *anyopaque, glyph: hb_codepoint_t, name: *c_char, size: c_uint, user_data: *anyopaque) -> hb_bool_t

pub const hb_font_get_glyph_from_name_func_t = fn(font: *hb_font_t, font_data: *anyopaque, name: *const c_char, len: c_int, glyph: *hb_codepoint_t, user_data: *anyopaque) -> hb_bool_t

pub const hb_font_draw_glyph_func_t = fn(font: *hb_font_t, font_data: *anyopaque, glyph: hb_codepoint_t, draw_funcs: *hb_draw_funcs_t, draw_data: *anyopaque, user_data: *anyopaque) -> void

pub const hb_font_paint_glyph_func_t = fn(font: *hb_font_t, font_data: *anyopaque, glyph: hb_codepoint_t, paint_funcs: *hb_paint_funcs_t, paint_data: *anyopaque, palette_index: c_uint, foreground: hb_color_t, user_data: *anyopaque) -> void

pub extern("c") fn hb_font_funcs_set_font_h_extents_func(ffuncs: *hb_font_funcs_t, func: hb_font_get_font_h_extents_func_t, user_data: *anyopaque, destroy: hb_destroy_func_t) -> void
