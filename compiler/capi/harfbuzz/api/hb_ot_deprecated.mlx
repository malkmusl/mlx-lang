// hb-ot-deprecated.h
// mlx-harfbuzz: OpenType functions kept for programs of earlier
// versions.
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")
const hb_ot_name = @import("./hb_ot_name.mlx")

pub extern("c") fn hb_ot_layout_table_choose_script(face: *hb_face_t, table_tag: hb_tag_t, script_tags: *const hb_tag_t, script_index: *c_uint, chosen_script: *hb_tag_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_script_find_language(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, language_tag: hb_tag_t, language_index: *c_uint) -> hb_bool_t
pub extern("c") fn hb_ot_tags_from_script(script: hb_script_t, script_tag_1: *hb_tag_t, script_tag_2: *hb_tag_t) -> void
pub extern("c") fn hb_ot_tag_from_language(language: hb_language_t) -> hb_tag_t
pub const hb_ot_var_axis_t = struct {
    tag: hb_tag_t
    name_id: hb_ot_name_id_t
    min_value: f32
    default_value: f32
    max_value: f32
}

pub extern("c") fn hb_ot_var_get_axes(face: *hb_face_t, start_offset: c_uint, axes_count: *c_uint, axes_array: *hb_ot_var_axis_t) -> c_uint
pub extern("c") fn hb_ot_var_find_axis(face: *hb_face_t, axis_tag: hb_tag_t, axis_index: *c_uint, axis_info: *hb_ot_var_axis_t) -> hb_bool_t
pub const HB_OT_VAR_NO_AXIS_INDEX: c_uint = 0xFFFFFFFF

pub const HB_MATH_GLYPH_PART_FLAG_EXTENDER = @intCast(hb_ot_math_glyph_part_flags_t, 1)
pub const HB_OT_MATH_SCRIPT: hb_tag_t = 0x6D617468
