// hb-shape.h
// mlx-harfbuzz: shaping: a buffer of text into positioned glyphs of a font
// with features.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")
const hb_buffer = @import("./hb_buffer.mlx")
const hb_font = @import("./hb_font.mlx")

pub extern("c") fn hb_shape(font: *hb_font_t, buffer: *hb_buffer_t, features: *const hb_feature_t, num_features: c_uint) -> void
pub extern("c") fn hb_shape_full(font: *hb_font_t, buffer: *hb_buffer_t, features: *const hb_feature_t, num_features: c_uint, shaper_list: **const c_char) -> hb_bool_t
pub extern("c") fn hb_shape_justify(font: *hb_font_t, buffer: *hb_buffer_t, features: *const hb_feature_t, num_features: c_uint, shaper_list: **const c_char, min_target_advance: f32, max_target_advance: f32, advance: *f32, var_tag: *hb_tag_t, var_value: *f32) -> hb_bool_t
pub extern("c") fn hb_shape_list_shapers() -> **const c_char
