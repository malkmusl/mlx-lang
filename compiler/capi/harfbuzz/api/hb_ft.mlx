// hb-ft.h
// mlx-harfbuzz: faces and fonts of FreeType faces (libmlxfreetype), and font
// functions that ask FreeType for glyphs, advances, extents and outlines.
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")
const ft2build = @import("../../freetype/api/ft2build.mlx")
const freetype = @import("../../freetype/api/freetype.mlx")

pub extern("c") fn hb_ft_face_create(ft_face: freetype.FT_Face, destroy: hb_destroy_func_t) -> *hb_face_t
pub extern("c") fn hb_ft_face_create_cached(ft_face: freetype.FT_Face) -> *hb_face_t
pub extern("c") fn hb_ft_face_create_referenced(ft_face: freetype.FT_Face) -> *hb_face_t
pub extern("c") fn hb_ft_font_create(ft_face: freetype.FT_Face, destroy: hb_destroy_func_t) -> *hb_font_t
pub extern("c") fn hb_ft_font_create_referenced(ft_face: freetype.FT_Face) -> *hb_font_t
pub extern("c") fn hb_ft_font_get_face(font: *hb_font_t) -> freetype.FT_Face
pub extern("c") fn hb_ft_font_lock_face(font: *hb_font_t) -> freetype.FT_Face
pub extern("c") fn hb_ft_font_unlock_face(font: *hb_font_t) -> void
pub extern("c") fn hb_ft_font_set_load_flags(font: *hb_font_t, load_flags: c_int) -> void
pub extern("c") fn hb_ft_font_get_load_flags(font: *hb_font_t) -> c_int
pub extern("c") fn hb_ft_font_changed(font: *hb_font_t) -> void
pub extern("c") fn hb_ft_hb_font_changed(font: *hb_font_t) -> hb_bool_t
pub extern("c") fn hb_ft_font_set_funcs(font: *hb_font_t) -> void
