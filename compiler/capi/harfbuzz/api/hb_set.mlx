// hb-set.h
// mlx-harfbuzz: sets of 32-bit values (codepoints, glyphs, indexes).
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")

pub const hb_set_t = struct {}

pub extern("c") fn hb_set_create() -> *hb_set_t
pub extern("c") fn hb_set_get_empty() -> *hb_set_t
pub extern("c") fn hb_set_reference(set: *hb_set_t) -> *hb_set_t
pub extern("c") fn hb_set_destroy(set: *hb_set_t) -> void
pub extern("c") fn hb_set_set_user_data(set: *hb_set_t, key: *hb_user_data_key_t, data: *anyopaque, destroy: hb_destroy_func_t, replace: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_set_get_user_data(set: *const hb_set_t, key: *hb_user_data_key_t) -> *anyopaque
pub extern("c") fn hb_set_allocation_successful(set: *const hb_set_t) -> hb_bool_t
pub extern("c") fn hb_set_copy(set: *const hb_set_t) -> *hb_set_t
pub extern("c") fn hb_set_clear(set: *hb_set_t) -> void
pub extern("c") fn hb_set_is_empty(set: *const hb_set_t) -> hb_bool_t
pub extern("c") fn hb_set_invert(set: *hb_set_t) -> void
pub extern("c") fn hb_set_is_inverted(set: *const hb_set_t) -> hb_bool_t
pub extern("c") fn hb_set_has(set: *const hb_set_t, codepoint: hb_codepoint_t) -> hb_bool_t
pub extern("c") fn hb_set_add(set: *hb_set_t, codepoint: hb_codepoint_t) -> void
pub extern("c") fn hb_set_add_range(set: *hb_set_t, first: hb_codepoint_t, last: hb_codepoint_t) -> void
pub extern("c") fn hb_set_add_sorted_array(set: *hb_set_t, sorted_codepoints: *const hb_codepoint_t, num_codepoints: c_uint) -> void
pub extern("c") fn hb_set_del(set: *hb_set_t, codepoint: hb_codepoint_t) -> void
pub extern("c") fn hb_set_del_range(set: *hb_set_t, first: hb_codepoint_t, last: hb_codepoint_t) -> void
pub extern("c") fn hb_set_is_equal(set: *const hb_set_t, other: *const hb_set_t) -> hb_bool_t
pub extern("c") fn hb_set_hash(set: *const hb_set_t) -> c_uint
pub extern("c") fn hb_set_is_subset(set: *const hb_set_t, larger_set: *const hb_set_t) -> hb_bool_t
pub extern("c") fn hb_set_set(set: *hb_set_t, other: *const hb_set_t) -> void
pub extern("c") fn hb_set_union(set: *hb_set_t, other: *const hb_set_t) -> void
pub extern("c") fn hb_set_intersect(set: *hb_set_t, other: *const hb_set_t) -> void
pub extern("c") fn hb_set_subtract(set: *hb_set_t, other: *const hb_set_t) -> void
pub extern("c") fn hb_set_symmetric_difference(set: *hb_set_t, other: *const hb_set_t) -> void
pub extern("c") fn hb_set_get_population(set: *const hb_set_t) -> c_uint
pub extern("c") fn hb_set_get_min(set: *const hb_set_t) -> hb_codepoint_t
pub extern("c") fn hb_set_get_max(set: *const hb_set_t) -> hb_codepoint_t
pub extern("c") fn hb_set_next(set: *const hb_set_t, codepoint: *hb_codepoint_t) -> hb_bool_t
pub extern("c") fn hb_set_previous(set: *const hb_set_t, codepoint: *hb_codepoint_t) -> hb_bool_t
pub extern("c") fn hb_set_next_range(set: *const hb_set_t, first: *hb_codepoint_t, last: *hb_codepoint_t) -> hb_bool_t
pub extern("c") fn hb_set_previous_range(set: *const hb_set_t, first: *hb_codepoint_t, last: *hb_codepoint_t) -> hb_bool_t
pub extern("c") fn hb_set_next_many(set: *const hb_set_t, codepoint: hb_codepoint_t, out: *hb_codepoint_t, size: c_uint) -> c_uint

pub const HB_SET_VALUE_INVALID: hb_codepoint_t = 0xFFFFFFFF
