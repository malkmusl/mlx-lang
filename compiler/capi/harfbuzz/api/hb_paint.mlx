// hb-paint.h
// mlx-harfbuzz: painting color glyphs: the callbacks for transforms, clips,
// solid colors, images, gradients and groups a program gives.
const c_function_pointers = true
const c_keyword_names = true
const hb_common = @import("./hb_common.mlx")

pub const hb_paint_funcs_t = struct {}

pub extern("c") fn hb_paint_funcs_create() -> *hb_paint_funcs_t
pub extern("c") fn hb_paint_funcs_get_empty() -> *hb_paint_funcs_t
pub extern("c") fn hb_paint_funcs_reference(funcs: *hb_paint_funcs_t) -> *hb_paint_funcs_t
pub extern("c") fn hb_paint_funcs_destroy(funcs: *hb_paint_funcs_t) -> void
pub extern("c") fn hb_paint_funcs_set_user_data(funcs: *hb_paint_funcs_t, key: *hb_user_data_key_t, data: *anyopaque, destroy: hb_destroy_func_t, replace: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_paint_funcs_get_user_data(funcs: *const hb_paint_funcs_t, key: *hb_user_data_key_t) -> *anyopaque
pub extern("c") fn hb_paint_funcs_make_immutable(funcs: *hb_paint_funcs_t) -> void
pub extern("c") fn hb_paint_funcs_is_immutable(funcs: *hb_paint_funcs_t) -> hb_bool_t
pub const hb_paint_push_transform_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, xx: f32, yx: f32, xy: f32, yy: f32, dx: f32, dy: f32, user_data: *anyopaque) -> void

pub const hb_paint_pop_transform_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, user_data: *anyopaque) -> void

pub const hb_paint_color_glyph_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, glyph: hb_codepoint_t, font: *hb_font_t, user_data: *anyopaque) -> hb_bool_t

pub const hb_paint_push_clip_glyph_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, glyph: hb_codepoint_t, font: *hb_font_t, user_data: *anyopaque) -> void

pub const hb_paint_push_clip_rectangle_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, xmin: f32, ymin: f32, xmax: f32, ymax: f32, user_data: *anyopaque) -> void

pub const hb_paint_pop_clip_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, user_data: *anyopaque) -> void

pub const hb_paint_color_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, is_foreground: hb_bool_t, color: hb_color_t, user_data: *anyopaque) -> void

pub const hb_paint_image_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, image: *hb_blob_t, width: c_uint, height: c_uint, format: hb_tag_t, slant: f32, extents: *hb_glyph_extents_t, user_data: *anyopaque) -> hb_bool_t

pub const hb_color_stop_t = struct {
    offset: f32
    is_foreground: hb_bool_t
    color: hb_color_t
}

pub const hb_paint_extend_t = enum(c_int) {
    HB_PAINT_EXTEND_PAD = 0,
    HB_PAINT_EXTEND_REPEAT = 1,
    HB_PAINT_EXTEND_REFLECT = 2,
}

pub const hb_color_line_t = struct {}

pub const hb_color_line_get_color_stops_func_t = fn(color_line: *hb_color_line_t, color_line_data: *anyopaque, start: c_uint, count: *c_uint, color_stops: *hb_color_stop_t, user_data: *anyopaque) -> c_uint

pub const hb_color_line_get_extend_func_t = fn(color_line: *hb_color_line_t, color_line_data: *anyopaque, user_data: *anyopaque) -> hb_paint_extend_t

pub const hb_color_line_t = struct {
    data: *anyopaque
    get_color_stops: hb_color_line_get_color_stops_func_t
    get_color_stops_user_data: *anyopaque
    get_extend: hb_color_line_get_extend_func_t
    get_extend_user_data: *anyopaque
    reserved0: *anyopaque
    reserved1: *anyopaque
    reserved2: *anyopaque
    reserved3: *anyopaque
    reserved5: *anyopaque
    reserved6: *anyopaque
    reserved7: *anyopaque
    reserved8: *anyopaque
}

pub extern("c") fn hb_color_line_get_color_stops(color_line: *hb_color_line_t, start: c_uint, count: *c_uint, color_stops: *hb_color_stop_t) -> c_uint
pub extern("c") fn hb_color_line_get_extend(color_line: *hb_color_line_t) -> hb_paint_extend_t
pub const hb_paint_linear_gradient_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, color_line: *hb_color_line_t, x0: f32, y0: f32, x1: f32, y1: f32, x2: f32, y2: f32, user_data: *anyopaque) -> void

pub const hb_paint_radial_gradient_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, color_line: *hb_color_line_t, x0: f32, y0: f32, r0: f32, x1: f32, y1: f32, r1: f32, user_data: *anyopaque) -> void

pub const hb_paint_sweep_gradient_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, color_line: *hb_color_line_t, x0: f32, y0: f32, start_angle: f32, end_angle: f32, user_data: *anyopaque) -> void

pub const hb_paint_composite_mode_t = enum(c_int) {
    HB_PAINT_COMPOSITE_MODE_CLEAR = 0,
    HB_PAINT_COMPOSITE_MODE_SRC = 1,
    HB_PAINT_COMPOSITE_MODE_DEST = 2,
    HB_PAINT_COMPOSITE_MODE_SRC_OVER = 3,
    HB_PAINT_COMPOSITE_MODE_DEST_OVER = 4,
    HB_PAINT_COMPOSITE_MODE_SRC_IN = 5,
    HB_PAINT_COMPOSITE_MODE_DEST_IN = 6,
    HB_PAINT_COMPOSITE_MODE_SRC_OUT = 7,
    HB_PAINT_COMPOSITE_MODE_DEST_OUT = 8,
    HB_PAINT_COMPOSITE_MODE_SRC_ATOP = 9,
    HB_PAINT_COMPOSITE_MODE_DEST_ATOP = 10,
    HB_PAINT_COMPOSITE_MODE_XOR = 11,
    HB_PAINT_COMPOSITE_MODE_PLUS = 12,
    HB_PAINT_COMPOSITE_MODE_SCREEN = 13,
    HB_PAINT_COMPOSITE_MODE_OVERLAY = 14,
    HB_PAINT_COMPOSITE_MODE_DARKEN = 15,
    HB_PAINT_COMPOSITE_MODE_LIGHTEN = 16,
    HB_PAINT_COMPOSITE_MODE_COLOR_DODGE = 17,
    HB_PAINT_COMPOSITE_MODE_COLOR_BURN = 18,
    HB_PAINT_COMPOSITE_MODE_HARD_LIGHT = 19,
    HB_PAINT_COMPOSITE_MODE_SOFT_LIGHT = 20,
    HB_PAINT_COMPOSITE_MODE_DIFFERENCE = 21,
    HB_PAINT_COMPOSITE_MODE_EXCLUSION = 22,
    HB_PAINT_COMPOSITE_MODE_MULTIPLY = 23,
    HB_PAINT_COMPOSITE_MODE_HSL_HUE = 24,
    HB_PAINT_COMPOSITE_MODE_HSL_SATURATION = 25,
    HB_PAINT_COMPOSITE_MODE_HSL_COLOR = 26,
    HB_PAINT_COMPOSITE_MODE_HSL_LUMINOSITY = 27,
}

pub const hb_paint_push_group_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, user_data: *anyopaque) -> void

pub const hb_paint_pop_group_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, mode: hb_paint_composite_mode_t, user_data: *anyopaque) -> void

pub const hb_paint_custom_palette_color_func_t = fn(funcs: *hb_paint_funcs_t, paint_data: *anyopaque, color_index: c_uint, color: *hb_color_t, user_data: *anyopaque) -> hb_bool_t

