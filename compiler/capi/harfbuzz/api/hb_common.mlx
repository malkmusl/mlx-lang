// hb-common.h
// mlx-harfbuzz: the types every other header uses: codepoints, positions,
// masks, tags (HB_TAG), directions, languages, scripts (ISO 15924 tags),
// features and variations (with their string forms), colors, glyph
// extents, user data keys.
const c_function_pointers = true
const c_keyword_names = true

pub const hb_bool_t = c_int

pub const hb_codepoint_t = u32

pub const hb_position_t = i32

pub const hb_mask_t = u32

pub const _hb_var_int_t = union {
    u32: u32
    i32: i32
    u16: [2]u16
    i16: [2]i16
    u8: [4]u8
    i8: [4]i8
}
pub const hb_var_int_t = _hb_var_int_t

pub const _hb_var_num_t = union {
    f: f32
    u32: u32
    i32: i32
    u16: [2]u16
    i16: [2]i16
    u8: [4]u8
    i8: [4]i8
}
pub const hb_var_num_t = _hb_var_num_t

pub const hb_tag_t = u32

pub extern("c") fn hb_tag_from_string(str: *const c_char, len: c_int) -> hb_tag_t
pub extern("c") fn hb_tag_to_string(tag: hb_tag_t, buf: *c_char) -> void
pub const hb_direction_t = enum(c_int) {
    HB_DIRECTION_INVALID = 0,
    HB_DIRECTION_LTR = 4,
    HB_DIRECTION_RTL = 5,
    HB_DIRECTION_TTB = 6,
    HB_DIRECTION_BTT = 7,
}

pub extern("c") fn hb_direction_from_string(str: *const c_char, len: c_int) -> hb_direction_t
pub extern("c") fn hb_direction_to_string(direction: hb_direction_t) -> *const c_char
pub const hb_language_impl_t = struct {}
pub const hb_language_t = *const hb_language_impl_t

pub extern("c") fn hb_language_from_string(str: *const c_char, len: c_int) -> hb_language_t
pub extern("c") fn hb_language_to_string(language: hb_language_t) -> *const c_char
pub extern("c") fn hb_language_get_default() -> hb_language_t
pub extern("c") fn hb_language_matches(language: hb_language_t, specific: hb_language_t) -> hb_bool_t
