pub extern("c") fn hb_script_from_iso15924_tag(tag: hb_tag_t) -> hb_script_t
pub extern("c") fn hb_script_from_string(str: *const c_char, len: c_int) -> hb_script_t
pub extern("c") fn hb_script_to_iso15924_tag(script: hb_script_t) -> hb_tag_t
pub extern("c") fn hb_script_get_horizontal_direction(script: hb_script_t) -> hb_direction_t
pub const hb_user_data_key_t = struct {
    unused: c_char
}

pub const hb_destroy_func_t = fn(user_data: *anyopaque) -> void

pub const hb_feature_t = struct {
    tag: hb_tag_t
    value: u32
    start: c_uint
    end: c_uint
}

pub extern("c") fn hb_feature_from_string(str: *const c_char, len: c_int, feature: *hb_feature_t) -> hb_bool_t
pub extern("c") fn hb_feature_to_string(feature: *hb_feature_t, buf: *c_char, size: c_uint) -> void
pub const hb_variation_t = struct {
    tag: hb_tag_t
    value: f32
}

pub extern("c") fn hb_variation_from_string(str: *const c_char, len: c_int, variation: *hb_variation_t) -> hb_bool_t
pub extern("c") fn hb_variation_to_string(variation: *hb_variation_t, buf: *c_char, size: c_uint) -> void
pub const hb_color_t = u32

pub extern("c") fn hb_color_get_alpha(color: hb_color_t) -> u8
pub extern("c") fn hb_color_get_red(color: hb_color_t) -> u8
pub extern("c") fn hb_color_get_green(color: hb_color_t) -> u8
pub extern("c") fn hb_color_get_blue(color: hb_color_t) -> u8
pub const hb_glyph_extents_t = struct {
    x_bearing: hb_position_t
    y_bearing: hb_position_t
    width: hb_position_t
    height: hb_position_t
}

pub const hb_font_t = struct {}

pub const HB_FEATURE_GLOBAL_START: c_uint = 0

// The invalid codepoint.
pub const HB_CODEPOINT_INVALID: hb_codepoint_t = 0xFFFFFFFF

// The tag of four characters, the first in the high byte.
pub fn HB_TAG(c1: anytype, c2: anytype, c3: anytype, c4: anytype) -> hb_tag_t {
    return @intCast(hb_tag_t, ((@intCast(u32, c1) & 0xFF) << 24) | ((@intCast(u32, c2) & 0xFF) << 16) | ((@intCast(u32, c3) & 0xFF) << 8) | (@intCast(u32, c4) & 0xFF))
}

// The four characters of a tag, as arguments.
pub fn HB_UNTAG(tag: anytype) -> (u8, u8, u8, u8) {
    return -> (@intCast(u8, (tag >> 24) & 0xFF), @intCast(u8, (tag >> 16) & 0xFF), @intCast(u8, (tag >> 8) & 0xFF), @intCast(u8, tag & 0xFF))
}

pub const HB_TAG_NONE: hb_tag_t = 0
pub const HB_TAG_MAX: hb_tag_t = 0xFFFFFFFF
pub const HB_TAG_MAX_SIGNED: hb_tag_t = 0x7FFFFFFF

// What a direction is: valid, horizontal or vertical, forward or
// backward; the opposite direction.
pub fn HB_DIRECTION_IS_VALID(dir: anytype) -> bool { return (@intCast(c_uint, dir) & ~@intCast(c_uint, 3)) == 4 }
pub fn HB_DIRECTION_IS_HORIZONTAL(dir: anytype) -> bool { return (@intCast(c_uint, dir) & ~@intCast(c_uint, 1)) == 4 }
pub fn HB_DIRECTION_IS_VERTICAL(dir: anytype) -> bool { return (@intCast(c_uint, dir) & ~@intCast(c_uint, 1)) == 6 }
pub fn HB_DIRECTION_IS_FORWARD(dir: anytype) -> bool { return (@intCast(c_uint, dir) & ~@intCast(c_uint, 2)) == 4 }
pub fn HB_DIRECTION_IS_BACKWARD(dir: anytype) -> bool { return (@intCast(c_uint, dir) & ~@intCast(c_uint, 2)) == 5 }
pub fn HB_DIRECTION_REVERSE(dir: anytype) -> hb_direction_t { return @intCast(hb_direction_t, @intCast(c_uint, dir) ^ 1) }

pub const HB_LANGUAGE_INVALID = @ptrFromInt(hb_language_t, 0)

// A feature's range: from the start of the buffer to its end.
pub const HB_FEATURE_GLOBAL_START: c_uint = 0
pub const HB_FEATURE_GLOBAL_END: c_uint = 0xFFFFFFFF

// A color of its blue, green, red and alpha values.
pub fn HB_COLOR(b: anytype, g: anytype, r: anytype, a: anytype) -> hb_color_t { return @intCast(hb_color_t, HB_TAG(b, g, r, a)) }
