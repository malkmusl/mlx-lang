// hb-ot-layout.h
// mlx-harfbuzz: OpenType layout: script and language tags, GDEF glyph
// classes, attachment points and ligature carets, the scripts, languages,
// features and lookups of GSUB and GPOS, feature variations, baselines.
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")
const hb_ot_name = @import("./hb_ot_name.mlx")

pub extern("c") fn hb_ot_tags_from_script_and_language(script: hb_script_t, language: hb_language_t, script_count: *c_uint, script_tags: *hb_tag_t, language_count: *c_uint, language_tags: *hb_tag_t) -> void
pub extern("c") fn hb_ot_tag_to_script(tag: hb_tag_t) -> hb_script_t
pub extern("c") fn hb_ot_tag_to_language(tag: hb_tag_t) -> hb_language_t
pub extern("c") fn hb_ot_tags_to_script_and_language(script_tag: hb_tag_t, language_tag: hb_tag_t, script: *hb_script_t, language: *hb_language_t) -> void
pub extern("c") fn hb_ot_layout_has_glyph_classes(face: *hb_face_t) -> hb_bool_t
pub const hb_ot_layout_glyph_class_t = enum(c_int) {
    HB_OT_LAYOUT_GLYPH_CLASS_UNCLASSIFIED = 0,
    HB_OT_LAYOUT_GLYPH_CLASS_BASE_GLYPH = 1,
    HB_OT_LAYOUT_GLYPH_CLASS_LIGATURE = 2,
    HB_OT_LAYOUT_GLYPH_CLASS_MARK = 3,
    HB_OT_LAYOUT_GLYPH_CLASS_COMPONENT = 4,
}

pub extern("c") fn hb_ot_layout_get_glyph_class(face: *hb_face_t, glyph: hb_codepoint_t) -> hb_ot_layout_glyph_class_t
pub extern("c") fn hb_ot_layout_get_glyphs_in_class(face: *hb_face_t, klass: hb_ot_layout_glyph_class_t, glyphs: *hb_set_t) -> void
pub extern("c") fn hb_ot_layout_get_attach_points(face: *hb_face_t, glyph: hb_codepoint_t, start_offset: c_uint, point_count: *c_uint, point_array: *c_uint) -> c_uint
pub extern("c") fn hb_ot_layout_get_ligature_carets(font: *hb_font_t, direction: hb_direction_t, glyph: hb_codepoint_t, start_offset: c_uint, caret_count: *c_uint, caret_array: *hb_position_t) -> c_uint
pub extern("c") fn hb_ot_layout_table_get_script_tags(face: *hb_face_t, table_tag: hb_tag_t, start_offset: c_uint, script_count: *c_uint, script_tags: *hb_tag_t) -> c_uint
pub extern("c") fn hb_ot_layout_table_find_script(face: *hb_face_t, table_tag: hb_tag_t, script_tag: hb_tag_t, script_index: *c_uint) -> hb_bool_t
pub extern("c") fn hb_ot_layout_table_select_script(face: *hb_face_t, table_tag: hb_tag_t, script_count: c_uint, script_tags: *const hb_tag_t, script_index: *c_uint, chosen_script: *hb_tag_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_table_get_feature_tags(face: *hb_face_t, table_tag: hb_tag_t, start_offset: c_uint, feature_count: *c_uint, feature_tags: *hb_tag_t) -> c_uint
pub extern("c") fn hb_ot_layout_script_get_language_tags(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, start_offset: c_uint, language_count: *c_uint, language_tags: *hb_tag_t) -> c_uint
pub extern("c") fn hb_ot_layout_script_select_language(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, language_count: c_uint, language_tags: *const hb_tag_t, language_index: *c_uint) -> hb_bool_t
pub extern("c") fn hb_ot_layout_script_select_language2(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, language_count: c_uint, language_tags: *const hb_tag_t, language_index: *c_uint, chosen_language: *hb_tag_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_language_get_required_feature_index(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, language_index: c_uint, feature_index: *c_uint) -> hb_bool_t
pub extern("c") fn hb_ot_layout_language_get_required_feature(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, language_index: c_uint, feature_index: *c_uint, feature_tag: *hb_tag_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_language_get_feature_indexes(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, language_index: c_uint, start_offset: c_uint, feature_count: *c_uint, feature_indexes: *c_uint) -> c_uint
pub extern("c") fn hb_ot_layout_language_get_feature_tags(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, language_index: c_uint, start_offset: c_uint, feature_count: *c_uint, feature_tags: *hb_tag_t) -> c_uint
pub extern("c") fn hb_ot_layout_language_find_feature(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, language_index: c_uint, feature_tag: hb_tag_t, feature_index: *c_uint) -> hb_bool_t
pub extern("c") fn hb_ot_layout_feature_get_lookups(face: *hb_face_t, table_tag: hb_tag_t, feature_index: c_uint, start_offset: c_uint, lookup_count: *c_uint, lookup_indexes: *c_uint) -> c_uint
pub extern("c") fn hb_ot_layout_table_get_lookup_count(face: *hb_face_t, table_tag: hb_tag_t) -> c_uint
pub extern("c") fn hb_ot_layout_collect_features(face: *hb_face_t, table_tag: hb_tag_t, scripts: *const hb_tag_t, languages: *const hb_tag_t, features: *const hb_tag_t, feature_indexes: *hb_set_t) -> void
pub extern("c") fn hb_ot_layout_collect_features_map(face: *hb_face_t, table_tag: hb_tag_t, script_index: c_uint, language_index: c_uint, feature_map: *hb_map_t) -> void
pub extern("c") fn hb_ot_layout_collect_lookups(face: *hb_face_t, table_tag: hb_tag_t, scripts: *const hb_tag_t, languages: *const hb_tag_t, features: *const hb_tag_t, lookup_indexes: *hb_set_t) -> void
pub extern("c") fn hb_ot_layout_lookup_collect_glyphs(face: *hb_face_t, table_tag: hb_tag_t, lookup_index: c_uint, glyphs_before: *hb_set_t, glyphs_input: *hb_set_t, glyphs_after: *hb_set_t, glyphs_output: *hb_set_t) -> void
pub extern("c") fn hb_ot_layout_table_find_feature_variations(face: *hb_face_t, table_tag: hb_tag_t, coords: *const c_int, num_coords: c_uint, variations_index: *c_uint) -> hb_bool_t
pub extern("c") fn hb_ot_layout_feature_with_variations_get_lookups(face: *hb_face_t, table_tag: hb_tag_t, feature_index: c_uint, variations_index: c_uint, start_offset: c_uint, lookup_count: *c_uint, lookup_indexes: *c_uint) -> c_uint
pub extern("c") fn hb_ot_layout_has_substitution(face: *hb_face_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_lookup_get_glyph_alternates(face: *hb_face_t, lookup_index: c_uint, glyph: hb_codepoint_t, start_offset: c_uint, alternate_count: *c_uint, alternate_glyphs: *hb_codepoint_t) -> c_uint
pub extern("c") fn hb_ot_layout_lookup_would_substitute(face: *hb_face_t, lookup_index: c_uint, glyphs: *const hb_codepoint_t, glyphs_length: c_uint, zero_context: hb_bool_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_lookup_substitute_closure(face: *hb_face_t, lookup_index: c_uint, glyphs: *hb_set_t) -> void
pub extern("c") fn hb_ot_layout_lookups_substitute_closure(face: *hb_face_t, lookups: *const hb_set_t, glyphs: *hb_set_t) -> void
pub extern("c") fn hb_ot_layout_has_positioning(face: *hb_face_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_get_size_params(face: *hb_face_t, design_size: *c_uint, subfamily_id: *c_uint, subfamily_name_id: *hb_ot_name_id_t, range_start: *c_uint, range_end: *c_uint) -> hb_bool_t
pub extern("c") fn hb_ot_layout_lookup_get_optical_bound(font: *hb_font_t, lookup_index: c_uint, direction: hb_direction_t, glyph: hb_codepoint_t) -> hb_position_t
pub extern("c") fn hb_ot_layout_feature_get_name_ids(face: *hb_face_t, table_tag: hb_tag_t, feature_index: c_uint, label_id: *hb_ot_name_id_t, tooltip_id: *hb_ot_name_id_t, sample_id: *hb_ot_name_id_t, num_named_parameters: *c_uint, first_param_id: *hb_ot_name_id_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_feature_get_characters(face: *hb_face_t, table_tag: hb_tag_t, feature_index: c_uint, start_offset: c_uint, char_count: *c_uint, characters: *hb_codepoint_t) -> c_uint
pub extern("c") fn hb_ot_layout_get_font_extents(font: *hb_font_t, direction: hb_direction_t, script_tag: hb_tag_t, language_tag: hb_tag_t, extents: *hb_font_extents_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_get_font_extents2(font: *hb_font_t, direction: hb_direction_t, script: hb_script_t, language: hb_language_t, extents: *hb_font_extents_t) -> hb_bool_t
pub const hb_ot_layout_baseline_tag_t = enum(c_int) {
    HB_OT_LAYOUT_BASELINE_TAG_ROMAN = 0x726F6D6E,
    HB_OT_LAYOUT_BASELINE_TAG_HANGING = 0x68616E67,
    HB_OT_LAYOUT_BASELINE_TAG_IDEO_FACE_BOTTOM_OR_LEFT = 0x69636662,
    HB_OT_LAYOUT_BASELINE_TAG_IDEO_FACE_TOP_OR_RIGHT = 0x69636674,
    HB_OT_LAYOUT_BASELINE_TAG_IDEO_FACE_CENTRAL = 0x49636663,
    HB_OT_LAYOUT_BASELINE_TAG_IDEO_EMBOX_BOTTOM_OR_LEFT = 0x6964656F,
    HB_OT_LAYOUT_BASELINE_TAG_IDEO_EMBOX_TOP_OR_RIGHT = 0x69647470,
    HB_OT_LAYOUT_BASELINE_TAG_IDEO_EMBOX_CENTRAL = 0x49646365,
    HB_OT_LAYOUT_BASELINE_TAG_MATH = 0x6D617468,
    _HB_OT_LAYOUT_BASELINE_TAG_MAX_VALUE = 0x7FFFFFFF,
}

pub extern("c") fn hb_ot_layout_get_horizontal_baseline_tag_for_script(script: hb_script_t) -> hb_ot_layout_baseline_tag_t
pub extern("c") fn hb_ot_layout_get_baseline(font: *hb_font_t, baseline_tag: hb_ot_layout_baseline_tag_t, direction: hb_direction_t, script_tag: hb_tag_t, language_tag: hb_tag_t, coord: *hb_position_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_get_baseline2(font: *hb_font_t, baseline_tag: hb_ot_layout_baseline_tag_t, direction: hb_direction_t, script: hb_script_t, language: hb_language_t, coord: *hb_position_t) -> hb_bool_t
pub extern("c") fn hb_ot_layout_get_baseline_with_fallback(font: *hb_font_t, baseline_tag: hb_ot_layout_baseline_tag_t, direction: hb_direction_t, script_tag: hb_tag_t, language_tag: hb_tag_t, coord: *hb_position_t) -> void
pub extern("c") fn hb_ot_layout_get_baseline_with_fallback2(font: *hb_font_t, baseline_tag: hb_ot_layout_baseline_tag_t, direction: hb_direction_t, script: hb_script_t, language: hb_language_t, coord: *hb_position_t) -> void
pub const HB_OT_TAG_BASE: hb_tag_t = 0x42415345
pub const HB_OT_TAG_GDEF: hb_tag_t = 0x47444546
pub const HB_OT_TAG_GSUB: hb_tag_t = 0x47535542
pub const HB_OT_TAG_GPOS: hb_tag_t = 0x47504F53
pub const HB_OT_TAG_JSTF: hb_tag_t = 0x4A535446
pub const HB_OT_TAG_DEFAULT_SCRIPT: hb_tag_t = 0x44464C54
pub const HB_OT_TAG_DEFAULT_LANGUAGE: hb_tag_t = 0x64666C74
pub const HB_OT_MAX_TAGS_PER_SCRIPT: c_uint = 3
pub const HB_OT_MAX_TAGS_PER_LANGUAGE: c_uint = 3
pub const HB_OT_LAYOUT_NO_SCRIPT_INDEX: c_uint = 0xFFFF
pub const HB_OT_LAYOUT_NO_FEATURE_INDEX: c_uint = 0xFFFF
pub const HB_OT_LAYOUT_DEFAULT_LANGUAGE_INDEX: c_uint = 0xFFFF
pub const HB_OT_LAYOUT_NO_VARIATIONS_INDEX: c_uint = 0xFFFFFFFF
