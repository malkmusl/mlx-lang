// hb-style.h
// mlx-harfbuzz: the style values of a font (weight, width, italic, slant,
// optical size) from its variations and tables.
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")

pub const hb_style_tag_t = enum(c_int) {
    HB_STYLE_TAG_ITALIC = 0x6974616C,
    HB_STYLE_TAG_OPTICAL_SIZE = 0x6F70737A,
    HB_STYLE_TAG_SLANT_ANGLE = 0x736C6E74,
    HB_STYLE_TAG_SLANT_RATIO = 0x536C6E74,
    HB_STYLE_TAG_WIDTH = 0x77647468,
    HB_STYLE_TAG_WEIGHT = 0x77676874,
    _HB_STYLE_TAG_MAX_VALUE = 0x7FFFFFFF,
}

pub extern("c") fn hb_style_get_value(font: *hb_font_t, style_tag: hb_style_tag_t) -> f32
