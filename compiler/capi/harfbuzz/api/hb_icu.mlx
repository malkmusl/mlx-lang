// hb-icu.h
// mlx-harfbuzz: ICU scripts (libmlxunicode) to HarfBuzz scripts and back, and
// Unicode functions of the ICU API.
const c_function_pointers = true
const c_keyword_names = true
const hb = @import("./hb.mlx")
const uscript = @import("../../../../projects/unicode/api/uscript.mlx")

pub extern("c") fn hb_icu_script_to_script(script: uscript.UScriptCode) -> hb_script_t
pub extern("c") fn hb_icu_script_from_script(script: hb_script_t) -> uscript.UScriptCode
pub extern("c") fn hb_icu_get_unicode_funcs() -> *hb_unicode_funcs_t
