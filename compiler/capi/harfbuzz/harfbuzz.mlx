// libmlxharfbuzz.so: HarfBuzz's C API (8.3) for C and C++ programs, a thin
// layer over std.shaping (std/src/shaping.mlx), first what WebKit's WebCore
// and Skia ask of it. The API is declared by the modules of api/, whose C
// headers (<hb.h>, <hb-ot.h>, <hb-ft.h>, <hb-icu.h>) mlx-cheaders makes;
// exports.mlx has one exported function per HarfBuzz function of
// std.shaping, ft.mlx those of <hb-ft.h> over libmlxfreetype.
//
//     ./mlx build harfbuzz
const setup = @import("./setup.mlx")
const exports = @import("./exports.mlx")
const ft = @import("./ft.mlx")
