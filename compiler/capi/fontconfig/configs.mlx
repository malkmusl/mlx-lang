// Configurations (fccfg.c, fcinit.c, fcxml.c), matching, sorting and
// listing (fcmatch.c, fclist.c), defaults, scanning (fcdir.c,
// fcfreetype.c's FcFreeTypeQuery), the cache's functions (fccache.c),
// blanks and atomic files, over std.fontconfig's config, load and
// matching. A null FcConfig* is the current configuration (loaded with
// its fonts by the first call that needs it), as in Fontconfig.
const common = @import("./common.mlx")
const std = @import("std")
const fs = std.fs

// open(2)'s O_EXCL.
const EXCLUSIVE: usize = 128

const mem = common.mem
const strset = common.strset
const objects = common.objects
const pattern = common.pattern
const config = common.config
const paths = common.paths
const load = common.load
const matching = common.matching
const env = common.env

// ---------------------------------------------------------------------------
// Initialization.

export fn FcGetVersion() -> i32 { return 21500 }

export fn FcInit() -> i32 {
    common.ready()
    return common.truth(load.init())
}

export fn FcFini() -> void {
    common.ready()
    load.fini()
}

export fn FcInitLoadConfig() -> usize {
    common.ready()
    return load.loadConfig(0)
}

export fn FcInitLoadConfigAndFonts() -> usize {
    common.ready()
    return load.loadConfigAndFonts()
}

export fn FcInitReinitialize() -> i32 {
    common.ready()
    common.refreshEnvironment()
    return common.truth(load.reinitialize())
}

export fn FcInitBringUptoDate() -> i32 {
    common.ready()
    return common.truth(load.bringUptoDate())
}

// ---------------------------------------------------------------------------
// Configurations.

var homeEnabled: bool = true

export fn FcConfigHome() -> usize {
    common.ready()
    if !homeEnabled { return 0 }
    return env.get("HOME")
}

export fn FcConfigEnableHome(enable: i32) -> i32 {
    const previous = homeEnabled
    homeEnabled = enable != 0
    return common.truth(previous)
}

export fn FcConfigGetFilename(c: usize, url: usize) -> usize {
    common.ready()
    return common.toC(paths.configFilename(url))
}

export fn FcConfigFilename(url: usize) -> usize { return FcConfigGetFilename(0, url) }

export fn FcConfigCreate() -> usize {
    common.ready()
    return config.create()
}

export fn FcConfigReference(c: usize) -> usize {
    common.ready()
    return load.reference(c)
}

export fn FcConfigDestroy(c: usize) -> void { if c != 0 { config.destroy(c) } }

export fn FcConfigSetCurrent(c: usize) -> i32 {
    common.ready()
    return common.truth(load.setCurrent(c))
}

export fn FcConfigGetCurrent() -> usize { return common.configOf(0) }

export fn FcConfigUptoDate(c: usize) -> i32 { return common.truth(load.uptoDate(common.configOf(c))) }

export fn FcConfigBuildFonts(c: usize) -> i32 { return common.truth(load.buildFonts(common.configOf(c))) }

fn listOf(set: usize) -> usize {
    if set == 0 { return 0 }
    return strset.listCreate(set)
}

export fn FcConfigGetFontDirs(c: usize) -> usize { return listOf(config.fontDirs(common.configOf(c))) }
export fn FcConfigGetConfigDirs(c: usize) -> usize { return listOf(config.configDirs(common.configOf(c))) }
export fn FcConfigGetConfigFiles(c: usize) -> usize { return listOf(config.configFiles(common.configOf(c))) }
export fn FcConfigGetCacheDirs(c: usize) -> usize { return listOf(config.cacheDirs(common.configOf(c))) }

// Deprecated in Fontconfig: no single cache file, no blanks.
export fn FcConfigGetCache(c: usize) -> usize { return 0 }
export fn FcConfigGetBlanks(c: usize) -> usize { return 0 }

export fn FcConfigGetRescanInterval(c: usize) -> i32 { return @intCast(i32, mem.getI32(common.configOf(c) + config.CONFIG_RESCAN)) }

export fn FcConfigSetRescanInterval(c: usize, interval: i32) -> i32 {
    const cfg = common.configOf(c)
    if cfg == 0 { return 0 }
    mem.put64(cfg + config.CONFIG_RESCAN, @bitCast(u64, @intCast(i64, interval)))
    return 1
}

export fn FcConfigGetFonts(c: usize, set: i32) -> usize {
    if set < 0 || set > 1 { return 0 }
    const cfg = common.configOf(c)
    if cfg == 0 { return 0 }
    return config.fonts(cfg, @intCast(i64, set))
}

export fn FcConfigAppFontAddFile(c: usize, file: usize) -> i32 { return common.truth(load.appFontAddFile(common.configOf(c), file)) }
export fn FcConfigAppFontAddDir(c: usize, dir: usize) -> i32 { return common.truth(load.appFontAddDir(common.configOf(c), dir)) }
export fn FcConfigAppFontClear(c: usize) -> void { load.appFontClear(common.configOf(c)) }

export fn FcConfigSubstituteWithPat(c: usize, p: usize, pPat: usize, kind: i32) -> i32 {
    if p == 0 { return 0 }
    return common.truth(config.substituteWithPat(common.configOf(c), p, pPat, @intCast(i64, kind)))
}

export fn FcConfigSubstitute(c: usize, p: usize, kind: i32) -> i32 { return FcConfigSubstituteWithPat(c, p, 0, kind) }

export fn FcConfigGetSysRoot(c: usize) -> usize { return config.sysroot(common.configOf(c)) }

// The system root is kept and handed back; the files are read where they
// are (std.fontconfig reads no other root).
export fn FcConfigSetSysRoot(c: usize, sysroot: usize) -> void {
    const cfg = common.configOf(c)
    if cfg == 0 { return }
    mem.free(mem.getWord(cfg + config.CONFIG_SYSROOT))
    mem.putWord(cfg + config.CONFIG_SYSROOT, if sysroot == 0 { 0 } else { paths.copyFilename(sysroot) })
}

// The configuration files, in the caller's FcConfigFileInfoIter: the
// index of the next one.
export fn FcConfigFileInfoIterInit(c: usize, iter: usize) -> void { if iter != 0 { mem.putWord(iter, 0) } }

export fn FcConfigFileInfoIterNext(c: usize, iter: usize) -> i32 {
    if iter == 0 { return 0 }
    const files = config.configFiles(common.configOf(c))
    const next = mem.getWord(iter) + 1
    if next >= strset.size(files) { return 0 }
    mem.putWord(iter, next)
    return 1
}

export fn FcConfigFileInfoIterGet(c: usize, iter: usize, name: usize, description: usize, enabled: usize) -> i32 {
    if iter == 0 { return 0 }
    const files = config.configFiles(common.configOf(c))
    const index = mem.getWord(iter)
    if index >= strset.size(files) { return 0 }
    if name != 0 { mem.putWord(name, common.cCopyC(strset.at(files, index))) }
    if description != 0 { mem.putWord(description, common.cCopyC(@intFromPtr("No description".pointer))) }
    if enabled != 0 { mem.putI32(enabled, 1) }
    return 1
}

export fn FcConfigParseAndLoad(c: usize, file: usize, complain: i32) -> i32 {
    common.ready()
    return common.truth(load.parseAndLoad(common.configOf(c), file, complain != 0))
}

export fn FcConfigParseAndLoadFromMemory(c: usize, buffer: usize, complain: i32) -> i32 {
    common.ready()
    if buffer == 0 { return 0 }
    return common.truth(load.parseAndLoadMemory(common.configOf(c), buffer, complain != 0))
}

export fn FcDefaultSubstitute(p: usize) -> void {
    common.ready()
    if p != 0 { config.defaultSubstitute(p) }
}

// ---------------------------------------------------------------------------
// Matching, sorting, listing. A null configuration is the current one,
// brought up to date first, as Fontconfig's are.

fn configForQuery(c: usize) -> usize {
    common.ready()
    if c == 0 { _ = load.bringUptoDate() }
    return common.configOf(c)
}

export fn FcFontSetMatch(c: usize, sets: usize, nsets: i32, p: usize, result: usize) -> usize {
    const cfg = configForQuery(c)
    var r: i64 = pattern.RESULT_NO_MATCH
    var font: usize = 0
    if sets != 0 && nsets > 0 && p != 0 { font = matching.fontSetMatch(cfg, sets, @intCast(usize, nsets), p, &r) }
    if result != 0 { mem.putI32(result, r) }
    return font
}

export fn FcFontMatch(c: usize, p: usize, result: usize) -> usize {
    const cfg = configForQuery(c)
    var r: i64 = pattern.RESULT_NO_MATCH
    var font: usize = 0
    if cfg != 0 && p != 0 { font = matching.fontMatch(cfg, p, &r) }
    if result != 0 { mem.putI32(result, r) }
    return font
}

export fn FcFontRenderPrepare(c: usize, p: usize, font: usize) -> usize {
    if p == 0 || font == 0 { return 0 }
    return matching.renderPrepare(common.configOf(c), p, font)
}

export fn FcFontSetSort(c: usize, sets: usize, nsets: i32, p: usize, trim: i32, csp: usize, result: usize) -> usize {
    _ = configForQuery(c)
    var r: i64 = pattern.RESULT_NO_MATCH
    var sorted: usize = 0
    if sets != 0 && nsets > 0 && p != 0 { sorted = matching.fontSetSort(sets, @intCast(usize, nsets), p, trim != 0, csp, &r) }
    if result != 0 { mem.putI32(result, r) }
    return sorted
}

export fn FcFontSort(c: usize, p: usize, trim: i32, csp: usize, result: usize) -> usize {
    const cfg = configForQuery(c)
    var r: i64 = pattern.RESULT_NO_MATCH
    var sorted: usize = 0
    if cfg != 0 && p != 0 { sorted = matching.fontSort(cfg, p, trim != 0, csp, &r) }
    if result != 0 { mem.putI32(result, r) }
    return sorted
}

export fn FcFontSetSortDestroy(s: usize) -> void { if s != 0 { pattern.fontSetDestroy(s) } }

export fn FcFontSetList(c: usize, sets: usize, nsets: i32, p: usize, os: usize) -> usize {
    _ = configForQuery(c)
    if sets == 0 || nsets <= 0 { return pattern.fontSetCreate() }
    return matching.fontSetList(sets, @intCast(usize, nsets), p, os)
}

export fn FcFontList(c: usize, p: usize, os: usize) -> usize {
    const cfg = configForQuery(c)
    if cfg == 0 { return 0 }
    return matching.fontList(cfg, p, os)
}

// ---------------------------------------------------------------------------
// Files and directories scanned (into the caller's sets, with the current
// configuration's scan rules).

export fn FcFileIsDir(file: usize) -> i32 {
    if file == 0 { return 0 }
    return common.truth(paths.isDirectory(file))
}

export fn FcFileScan(set: usize, dirs: usize, cache: usize, blanks: usize, file: usize, force: i32) -> i32 {
    if file == 0 { return 0 }
    const cfg = common.configOf(0)
    const s = load.newScanner()
    if s == 0 { return 0 }
    const ok = load.scanFile(cfg, set, dirs, file, s)
    load.freeScanner(s)
    return common.truth(ok)
}

export fn FcDirScan(set: usize, dirs: usize, cache: usize, blanks: usize, dir: usize, force: i32) -> i32 {
    if cache != 0 || force == 0 || dir == 0 { return 0 }
    const cfg = common.configOf(0)
    const s = load.newScanner()
    if s == 0 { return 0 }
    load.scanDirectory(cfg, set, dirs, dir, s)
    load.freeScanner(s)
    return 1
}

// Deprecated in Fontconfig.
export fn FcDirSave(set: usize, dirs: usize, dir: usize) -> i32 { return 0 }

// FcFreeTypeQueryAll: the faces of a file (`id` -1: all of them; else
// that face or named instance) added to `set`; how many were. `count`
// the number of faces of the file.
export fn FcFreeTypeQueryAll(file: usize, id: u32, blanks: usize, count: usize, set: usize) -> u32 {
    common.ready()
    if file == 0 { return 0 }
    const all = pattern.fontSetCreate()
    const n = load.queryFile(file, all)
    var faces: i64 = 0
    var added: u32 = 0
    var i: usize = 0
    while i < pattern.fontSetCount(all) {
        const font = pattern.fontSetFont(all, i)
        var index: i64 = 0
        _ = pattern.getInteger(font, objects.INDEX, 0, &index)
        if (index & 0xffff) + 1 > faces { faces = (index & 0xffff) + 1 }
        if id == 0xffffffff || @bitCast(u64, index) & 0xffffffff == @intCast(u64, id) {
            if set != 0 {
                pattern.reference(font)
                if pattern.fontSetAdd(set, font) { added += 1 } else { pattern.destroy(font) }
            } else {
                added += 1
            }
        }
        i += 1
    }
    pattern.fontSetDestroy(all)
    if count != 0 { mem.putI32(count, faces) }
    if n == 0 { return 0 }
    return added
}

export fn FcFreeTypeQuery(file: usize, id: u32, blanks: usize, count: usize) -> usize {
    const set = pattern.fontSetCreate()
    _ = FcFreeTypeQueryAll(file, id, blanks, count, set)
    var result: usize = 0
    if pattern.fontSetCount(set) > 0 {
        result = pattern.fontSetFont(set, 0)
        pattern.reference(result)
    }
    pattern.fontSetDestroy(set)
    return result
}

// ---------------------------------------------------------------------------
// Caches: a FcCache* is a directory's fonts and subdirectories as this
// library reads them (from its own cache when that is valid): a record of
// the directory's name, a font set and a string set.

fn cacheRecord(dir: usize, fonts: usize, subdirs: usize) -> usize {
    const record = mem.alloc(24)
    if record == 0 { return 0 }
    mem.putWord(record, mem.dupC(dir))
    mem.putWord(record + 8, fonts)
    mem.putWord(record + 16, subdirs)
    return record
}

export fn FcDirCacheRead(dir: usize, force: i32, c: usize) -> usize {
    if dir == 0 { return 0 }
    const cfg = common.configOf(c)
    if force != 0 { _ = load.cacheUnlink(dir) }
    const s = load.newScanner()
    if s == 0 { return 0 }
    const read = load.readDirectory(cfg, dir, s)
    load.freeScanner(s)
    if read.0 == 0 { return 0 }
    return cacheRecord(dir, read.0, read.1)
}

export fn FcDirCacheRescan(dir: usize, c: usize) -> usize { return FcDirCacheRead(dir, 1, c) }

export fn FcDirCacheLoad(dir: usize, c: usize, cacheFile: usize) -> usize {
    if dir == 0 { return 0 }
    common.ready()
    if !load.cacheValid(dir) { return 0 }
    if cacheFile != 0 { mem.putWord(cacheFile, common.toC(load.cacheFileOf(dir))) }
    return FcDirCacheRead(dir, 0, c)
}

// Fontconfig's own cache files are not read.
export fn FcDirCacheLoadFile(file: usize, stat: usize) -> usize { return 0 }

export fn FcDirCacheUnload(cache: usize) -> void {
    if cache == 0 { return }
    mem.free(mem.getWord(cache))
    pattern.fontSetDestroy(mem.getWord(cache + 8))
    strset.destroy(mem.getWord(cache + 16))
    mem.free(cache)
}

export fn FcCacheDir(cache: usize) -> usize {
    if cache == 0 { return 0 }
    return mem.getWord(cache)
}

export fn FcCacheCopySet(cache: usize) -> usize {
    if cache == 0 { return 0 }
    const fonts = mem.getWord(cache + 8)
    const copy = pattern.fontSetCreate()
    var i: usize = 0
    while i < pattern.fontSetCount(fonts) {
        const font = pattern.fontSetFont(fonts, i)
        pattern.reference(font)
        if !pattern.fontSetAdd(copy, font) { pattern.destroy(font) }
        i += 1
    }
    return copy
}

export fn FcCacheSubdir(cache: usize, i: i32) -> usize {
    if cache == 0 || i < 0 { return 0 }
    const subdirs = mem.getWord(cache + 16)
    if @intCast(usize, i) >= strset.size(subdirs) { return 0 }
    return strset.at(subdirs, @intCast(usize, i))
}

export fn FcCacheNumSubdir(cache: usize) -> i32 {
    if cache == 0 { return 0 }
    return @intCast(i32, strset.size(mem.getWord(cache + 16)))
}

export fn FcCacheNumFont(cache: usize) -> i32 {
    if cache == 0 { return 0 }
    return @intCast(i32, pattern.fontSetCount(mem.getWord(cache + 8)))
}

export fn FcDirCacheUnlink(dir: usize, c: usize) -> i32 {
    common.ready()
    if dir == 0 { return 0 }
    return common.truth(load.cacheUnlink(dir))
}

export fn FcDirCacheValid(dir: usize) -> i32 {
    common.ready()
    if dir == 0 { return 0 }
    return common.truth(load.cacheValid(dir))
}

// The caches of directories gone stay until their names are used again.
export fn FcDirCacheClean(cacheDir: usize, verbose: i32) -> i32 { return 1 }
export fn FcCacheCreateTagFile(c: usize) -> void {}
export fn FcDirCacheCreateUUID(dir: usize, force: i32, c: usize) -> i32 { return 1 }
export fn FcDirCacheDeleteUUID(dir: usize, c: usize) -> i32 { return 1 }

// ---------------------------------------------------------------------------
// Blanks: deprecated in Fontconfig 2.15, as there.

export fn FcBlanksCreate() -> usize { return 0 }
export fn FcBlanksDestroy(b: usize) -> void {}
export fn FcBlanksAdd(b: usize, ucs4: u32) -> i32 { return 0 }
export fn FcBlanksIsMember(b: usize, ucs4: u32) -> i32 { return 0 }

// ---------------------------------------------------------------------------
// Atomic files: a record of the file's name, its new file ("NAME.NEW")
// and its lock ("NAME.LCK"), made with O_EXCL.

fn suffixed(file: usize, suffix: []const u8) -> usize {
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = mem.appendC(&b, file)
    _ = mem.appendText(&b, suffix)
    return mem.takeBuffer(&b)
}

export fn FcAtomicCreate(file: usize) -> usize {
    common.ready()
    if file == 0 { return 0 }
    const atomic = mem.alloc(24)
    if atomic == 0 { return 0 }
    mem.putWord(atomic, mem.dupC(file))
    mem.putWord(atomic + 8, suffixed(file, ".NEW"))
    mem.putWord(atomic + 16, suffixed(file, ".LCK"))
    return atomic
}

export fn FcAtomicLock(atomic: usize) -> i32 {
    if atomic == 0 { return 0 }
    const lock = fs.open(mem.bytes(mem.getWord(atomic + 16)), fs.WRITE_ONLY | fs.CREATE | EXCLUSIVE, 420)
    if !fs.isValid(lock) { return 0 }
    _ = fs.close(lock)
    _ = fs.delete(mem.bytes(mem.getWord(atomic + 8)))
    return 1
}

export fn FcAtomicNewFile(atomic: usize) -> usize { return if atomic == 0 { 0 } else { mem.getWord(atomic + 8) } }
export fn FcAtomicOrigFile(atomic: usize) -> usize { return if atomic == 0 { 0 } else { mem.getWord(atomic) } }

export fn FcAtomicReplaceOrig(atomic: usize) -> i32 {
    if atomic == 0 { return 0 }
    return common.truth(fs.rename(mem.bytes(mem.getWord(atomic + 8)), mem.bytes(mem.getWord(atomic))))
}

export fn FcAtomicDeleteNew(atomic: usize) -> void { if atomic != 0 { _ = fs.delete(mem.bytes(mem.getWord(atomic + 8))) } }
export fn FcAtomicUnlock(atomic: usize) -> void { if atomic != 0 { _ = fs.delete(mem.bytes(mem.getWord(atomic + 16))) } }

export fn FcAtomicDestroy(atomic: usize) -> void {
    if atomic == 0 { return }
    mem.free(mem.getWord(atomic))
    mem.free(mem.getWord(atomic + 8))
    mem.free(mem.getWord(atomic + 16))
    mem.free(atomic)
}
