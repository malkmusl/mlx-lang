// What the parts of mlx-fontconfig share: the C library's memory (std.
// fontconfig's blocks come from it; what C frees itself, the strings
// FcStrFree and free take, is a plain malloc block), the environment as
// the C library has it, the configuration a null FcConfig* means, and C's
// variable arguments (FcPatternBuild's, FcObjectSetBuild's,
// FcStrBuildFilename's).
const fc = @import("std.fontconfig")

pub const mem = fc.mem
pub const strings = fc.strings
pub const strset = fc.strset
pub const charset = fc.charset
pub const lang = fc.lang
pub const objects = fc.objects
pub const value = fc.value
pub const pattern = fc.pattern
pub const config = fc.config
pub const confparse = fc.confparse
pub const paths = fc.paths
pub const load = fc.load
pub const matching = fc.matching
pub const env = fc.env

pub extern("c") fn malloc(size: usize) -> usize
pub extern("c") fn realloc(address: usize, size: usize) -> usize
pub extern("c") fn free(address: usize) -> void
pub extern("c") fn getenv(name: usize) -> usize

fn allocatorAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    const address = malloc(if length == 0 { 1 } else { length })
    if address == 0 { return null }
    return mem.bytes(address)
}

fn allocatorResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> bool { return false }

fn allocatorRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, newLength: usize) -> ?[*]u8 {
    const address = realloc(@intFromPtr(memory), if newLength == 0 { 1 } else { newLength })
    if address == 0 { return null }
    return mem.bytes(address)
}

fn allocatorFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    free(@intFromPtr(memory))
}

// The variables std.fontconfig reads, taken from the C library's
// environment (a program may set them before it initializes Fontconfig,
// or between two configurations).
const VARIABLES: []const u8 = "HOME XDG_DATA_HOME XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_DIRS XDG_CURRENT_DESKTOP FC_LANG LC_ALL LC_CTYPE LANG LANGUAGE FONTCONFIG_FILE FONTCONFIG_PATH FONTCONFIG_SYSROOT"

pub fn refreshEnvironment() -> void {
    var at: usize = 0
    while at < VARIABLES.length {
        var stop = at
        while stop < VARIABLES.length && VARIABLES[stop] != 32 { stop += 1 }
        const name = VARIABLES[at..stop]
        const c = mem.dupText(name)
        env.set(name, getenv(c))
        mem.free(c)
        at = stop + 1
    }
}

var readied: bool = false

// std.fontconfig takes its memory from the C library's malloc (safe from
// every thread). Called by the entry points a program may call first.
pub fn ready() -> void {
    if readied { return }
    if !mem.ready() {
        unsafe {
            mem.use(mem.Allocator.{
                .context = @ptrFromInt(*anyopaque, 16),
                .allocFn = allocatorAlloc,
                .resizeFn = allocatorResize,
                .remapFn = allocatorRemap,
                .freeFn = allocatorFree
            })
        }
    }
    refreshEnvironment()
    readied = true
}

// The configuration `c` means: itself, or the current one (loaded with
// its fonts by the first who asks).
pub fn configOf(c: usize) -> usize {
    ready()
    if c != 0 { return c }
    return load.current()
}

// ---------------------------------------------------------------------------
// C strings.

// A copy (from malloc, which C frees) of `length` bytes, with a 0 after them.
pub fn cCopy(address: usize, length: usize) -> usize {
    const copy = malloc(length + 1)
    if copy == 0 { return 0 }
    if length > 0 { mem.copy(copy, address, length) }
    mem.put8(copy + length, 0)
    return copy
}

pub fn cCopyC(text: usize) -> usize {
    if text == 0 { return 0 }
    return cCopy(text, mem.cLength(text))
}

// A string of std.fontconfig's memory handed to C as a malloc block (the
// module's block freed).
pub fn toC(text: usize) -> usize {
    if text == 0 { return 0 }
    const copy = cCopyC(text)
    mem.free(text)
    return copy
}

pub fn truth(b: bool) -> i32 { return if b { 1 } else { 0 } }

// A C int argument (the low 32 bits of its register), sign extended.
pub fn cInt(word: u64) -> i64 { return @intCast(i64, @bitCast(i32, @intCast(u32, word & 0xffffffff))) }

// ---------------------------------------------------------------------------
// C's variable arguments. A variadic export takes the six integer
// registers and the eight vector registers as its parameters (its fixed
// parameters first) and makes them, with the caller's stack words above
// its frame, a System V va_list: the gp_offset and fp_offset words, the
// overflow area, the register save area of six integer and eight vector
// registers. The arguments are then read from it as va_arg reads them.

pub const CallList = struct {
    header: [4]u64
    save: [22]u64
}

pub fn startList(call: *CallList, fixed: usize, frame: usize, words: usize, doubles: usize) -> usize {
    const save = @intFromPtr(&call.*.save)
    mem.copy(save, words, 48)
    var index: usize = 0
    while index < 8 {
        mem.put64(save + 48 + index * 16, mem.get64(doubles + index * 8))
        mem.put64(save + 56 + index * 16, 0)
        index += 1
    }
    const header = @intFromPtr(&call.*.header)
    mem.put32(header, @intCast(u64, fixed * 8))
    mem.put32(header + 4, 48)
    mem.putWord(header + 8, frame + 16)
    mem.putWord(header + 16, save)
    return header
}

// The next integer-class argument (an integer or a pointer).
pub fn nextWord(list: usize) -> u64 {
    const offset = mem.get32(list)
    if offset < 48 {
        mem.put32(list, offset + 8)
        return mem.get64(mem.getWord(list + 16) + @intCast(usize, offset))
    }
    const overflow = mem.getWord(list + 8)
    mem.putWord(list + 8, overflow + 8)
    return mem.get64(overflow)
}

// The next floating argument (a double).
pub fn nextDouble(list: usize) -> u64 {
    const offset = mem.get32(list + 4)
    if offset < 176 {
        mem.put32(list + 4, offset + 16)
        return mem.get64(mem.getWord(list + 16) + @intCast(usize, offset))
    }
    const overflow = mem.getWord(list + 8)
    mem.putWord(list + 8, overflow + 8)
    return mem.get64(overflow)
}
