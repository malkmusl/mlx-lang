// fontconfig/fcfreetype.h
// mlx-fontconfig: Fontconfig's functions of FreeType faces (mlx-freetype's
// FT_Face): a face's glyph of a character, its character set, faces kept
// in patterns, and a pattern made of an open face.
const fontconfig = @import("./fontconfig.mlx")
const freetype = @import("../../freetype/api/freetype.mlx")
const fttypes = @import("../../freetype/api/fttypes.mlx")

const c_int = fontconfig.c_int
const c_uint = fontconfig.c_uint
const c_char = fontconfig.c_char
const FcChar8 = fontconfig.FcChar8
const FcChar32 = fontconfig.FcChar32
const FcBool = fontconfig.FcBool
const FcBlanks = fontconfig.FcBlanks
const FcCharSet = fontconfig.FcCharSet
const FcPattern = fontconfig.FcPattern
const FcResult = fontconfig.FcResult
const FT_Face = freetype.FT_Face
const FT_UInt = fttypes.FT_UInt

pub extern("c") fn FcFreeTypeCharIndex(face: FT_Face, ucs4: FcChar32) -> FT_UInt
pub extern("c") fn FcFreeTypeCharSetAndSpacing(face: FT_Face, blanks: ?*FcBlanks, spacing: ?*c_int) -> ?*FcCharSet
pub extern("c") fn FcFreeTypeCharSet(face: FT_Face, blanks: ?*FcBlanks) -> ?*FcCharSet
pub extern("c") fn FcPatternGetFTFace(p: ?*const FcPattern, object: ?[*]const c_char, n: c_int, f: ?*FT_Face) -> FcResult
pub extern("c") fn FcPatternAddFTFace(p: ?*FcPattern, object: ?[*]const c_char, f: FT_Face) -> FcBool
pub extern("c") fn FcFreeTypeQueryFace(face: FT_Face, file: ?[*]const FcChar8, id: c_uint, blanks: ?*FcBlanks) -> ?*FcPattern
