// fontconfig/fontconfig.h
// mlx-fontconfig: Fontconfig's C API (2.15), implemented in Mlx by
// libmlxfontconfig.so (compiler/capi/fontconfig) over std.fontconfig:
// configurations (fonts.conf and conf.d, read as Fontconfig reads them),
// the fonts of their directories, patterns and their values, character
// and language sets, names, matching, sorting and listing with
// Fontconfig's priorities, defaults and rules. Fonts are read by
// std.truetype (TrueType, OpenType, their collections, variable fonts);
// Type 1, PCF and other bitmap formats are not read.
const c_keyword_names = true
const c_system_headers = "sys/types.h sys/stat.h stdarg.h limits.h"
const c_macros = "#define FC_VERSION ((FC_MAJOR * 10000) + (FC_MINOR * 100) + (FC_REVISION))\n#define _FC_STRINGIFY_(s) #s\n#define _FC_STRINGIFY(s) _FC_STRINGIFY_(s)\n#define FC_CACHE_VERSION _FC_STRINGIFY(FC_CACHE_VERSION_NUMBER)\n#define FC_CACHE_SUFFIX \".cache-\" FC_CACHE_VERSION\n#define FC_DIR_CACHE_FILE \"fonts.cache-\" FC_CACHE_VERSION\n#define FC_USER_CACHE_FILE \".fonts.cache-\" FC_CACHE_VERSION\n#define FC_CHARSET_DONE ((FcChar32) -1)\n#define FcMatrixInit(m) ((m)->xx = (m)->yy = 1, (m)->xy = (m)->yx = 0)\n#define FcIsUpper(c) ((0101 <= (c) && (c) <= 0132))\n#define FcIsLower(c) ((0141 <= (c) && (c) <= 0172))\n#define FcToLower(c) (FcIsUpper(c) ? (c) - 0101 + 0141 : (c))\n#define FcConfigGetRescanInverval FcConfigGetRescanInverval_REPLACE_BY_FcConfigGetRescanInterval\n#define FcConfigSetRescanInverval FcConfigSetRescanInverval_REPLACE_BY_FcConfigSetRescanInterval\n#define FC_ATTRIBUTE_SENTINEL(x) __attribute__((__sentinel__(0)))\n#ifndef FcPublic\n#define FcPublic\n#endif\n#define _FCFUNCPROTOBEGIN\n#define _FCFUNCPROTOEND\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n/* FcValueSave: the value a struct, as C returns it, of FcValueSaveInto's. */\nstatic inline FcValue FcValueSave (FcValue v) { FcValue r; FcValueSaveInto (&v, &r); return r; }\n#ifdef __cplusplus\n}\n#endif"

