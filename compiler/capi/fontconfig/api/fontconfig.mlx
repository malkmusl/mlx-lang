// FcValueSave's work: `v` copied into `out` with copies of what it points
// to (FcValueSave itself, which returns the struct, is the inline function
// of the end of the header).
pub extern("c") fn FcValueSaveInto(v: ?*const FcValue, out: ?*FcValue) -> void

// Blanks (FcBlanks): kept for programs that still pass them;
// Fontconfig 2.15 no longer uses them, and neither does this library.
pub extern("c") fn FcBlanksCreate() -> ?*FcBlanks
pub extern("c") fn FcBlanksDestroy(b: ?*FcBlanks) -> void
pub extern("c") fn FcBlanksAdd(b: ?*FcBlanks, ucs4: FcChar32) -> FcBool
pub extern("c") fn FcBlanksIsMember(b: ?*FcBlanks, ucs4: FcChar32) -> FcBool

// Caches. This library keeps a cache of its own for each font directory
// (std.fontconfig.load), not Fontconfig's files: these read and clean
// none, and say so.
pub extern("c") fn FcCacheDir(c: ?*const FcCache) -> ?[*]const FcChar8
pub extern("c") fn FcCacheCopySet(c: ?*const FcCache) -> ?*FcFontSet
pub extern("c") fn FcCacheSubdir(c: ?*const FcCache, i: c_int) -> ?[*]const FcChar8
pub extern("c") fn FcCacheNumSubdir(c: ?*const FcCache) -> c_int
pub extern("c") fn FcCacheNumFont(c: ?*const FcCache) -> c_int
pub extern("c") fn FcDirCacheUnlink(dir: ?[*]const FcChar8, config: ?*FcConfig) -> FcBool
pub extern("c") fn FcDirCacheValid(cache_file: ?[*]const FcChar8) -> FcBool
pub extern("c") fn FcDirCacheClean(cache_dir: ?[*]const FcChar8, verbose: FcBool) -> FcBool
pub extern("c") fn FcCacheCreateTagFile(config: ?*FcConfig) -> void
pub extern("c") fn FcDirCacheCreateUUID(dir: ?[*]FcChar8, force: FcBool, config: ?*FcConfig) -> FcBool
pub extern("c") fn FcDirCacheDeleteUUID(dir: ?[*]const FcChar8, config: ?*FcConfig) -> FcBool

