pub const _FcValue = struct {
    type_: FcType
    u: union {
        s: ?[*]const FcChar8
        i: c_int
        b: FcBool
        d: c_double
        m: ?*const FcMatrix
        c: ?*const FcCharSet
        f: ?*anyopaque
        l: ?*const FcLangSet
        r: ?*const FcRange
    }
}
pub const FcValue = _FcValue

