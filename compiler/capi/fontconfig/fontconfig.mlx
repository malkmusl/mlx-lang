// libmlxfontconfig.so: Fontconfig's C API (2.15, declared by the modules
// of api/, whose fontconfig/fontconfig.h and fontconfig/fcfreetype.h
// mlx-cheaders makes), in Mlx over std.fontconfig:
//
//     ./mlx build fontconfig
//
// The parts: common.mlx (memory, the environment, the current
// configuration, C strings, C's variable arguments), patterns.mlx
// (patterns, values, names, ranges, matrices, weights, FcPatternFormat,
// printing), sets.mlx (character, language, font, object and string sets,
// strings), configs.mlx (configurations, initialization, matching,
// sorting, listing, scanning, caches, blanks, atomic files), freetype.mlx
// (fcfreetype.h, over mlx-freetype's FT_Face).
const patterns = @import("./patterns.mlx")
const sets = @import("./sets.mlx")
const configs = @import("./configs.mlx")
const freetype = @import("./freetype.mlx")
