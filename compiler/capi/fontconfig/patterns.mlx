// Patterns and their values (fcpat.c), names (fcname.c), ranges,
// matrices, weights, FcPatternFormat (fcformat.c) and the printing of
// fcdbg.c, over std.fontconfig.pattern. A FcPattern* is a pattern's
// address; the values FcPatternGet hands out point into the pattern, as
// Fontconfig's do. A FcValue passed by value comes in two registers: its
// type word and its value word.
const common = @import("./common.mlx")

const mem = common.mem
const objects = common.objects
const value = common.value
const pattern = common.pattern
const charset = common.charset
const lang = common.lang

extern("c") fn printf(format: usize, text: usize) -> i32

// The text of a buffer printed to C's standard output (through its stdio,
// in order with the program's own printing), the buffer freed.
pub fn printBuffer(b: *mem.Buffer) -> void {
    _ = mem.appendText(b, "")
    if b.*.address != 0 { _ = printf(@intFromPtr("%s".pointer), b.*.address) }
    mem.freeBuffer(b)
}

fn objectOf(name: usize) -> i64 {
    common.ready()
    if name == 0 { return 0 }
    return objects.fromName(name)
}

// A FcValue's type word (C's int in the low half).
fn typeWord(t: u64) -> i64 { return common.cInt(t) }

// The value of a type word and value word, normalized as a list keeps it
// (an integer or a bool in the low 32 bits).
fn valueWord(t: i64, w: u64) -> u64 {
    if t == objects.TYPE_INTEGER || t == objects.TYPE_BOOL { return w & 0xffffffff }
    return w
}

// ---------------------------------------------------------------------------
// Patterns.

export fn FcPatternCreate() -> usize {
    common.ready()
    return pattern.create()
}

export fn FcPatternDuplicate(p: usize) -> usize { return pattern.duplicate(p) }

export fn FcPatternReference(p: usize) -> void { if p != 0 { pattern.reference(p) } }

export fn FcPatternDestroy(p: usize) -> void { if p != 0 { pattern.destroy(p) } }

export fn FcPatternFilter(p: usize, os: usize) -> usize {
    if p == 0 { return 0 }
    return pattern.filter(p, os)
}

export fn FcPatternObjectCount(p: usize) -> i32 { return @intCast(i32, pattern.count(p)) }

export fn FcPatternEqual(a: usize, b: usize) -> i32 {
    if a == b { return 1 }
    if a == 0 || b == 0 { return 0 }
    return common.truth(pattern.equal(a, b))
}

export fn FcPatternEqualSubset(a: usize, b: usize, os: usize) -> i32 { return common.truth(pattern.equalSubset(a, b, os)) }

export fn FcPatternHash(p: usize) -> u32 { return @intCast(u32, pattern.hash(p) & 0xffffffff) }

fn addBound(p: usize, object: usize, t: u64, w: u64, append: i32, binding: i64) -> i32 {
    if p == 0 { return 0 }
    const kind = typeWord(t)
    if kind == objects.TYPE_VOID { return 0 }
    return common.truth(pattern.addWithBinding(p, objectOf(object), kind, valueWord(kind, w), binding, append != 0))
}

export fn FcPatternAdd(p: usize, object: usize, t: u64, w: u64, append: i32) -> i32 { return addBound(p, object, t, w, append, value.BINDING_STRONG) }

export fn FcPatternAddWeak(p: usize, object: usize, t: u64, w: u64, append: i32) -> i32 { return addBound(p, object, t, w, append, value.BINDING_WEAK) }

export fn FcPatternGetWithBinding(p: usize, object: usize, id: i32, v: usize, b: usize) -> i32 {
    var at: usize = 0
    var binding: i64 = 0
    const r = pattern.getWithBinding(p, objectOf(object), @intCast(i64, id), &at, &binding)
    if r == pattern.RESULT_MATCH {
        if v != 0 { mem.copy(v, at, 16) }
        if b != 0 { mem.putI32(b, binding) }
    }
    return @intCast(i32, r)
}

export fn FcPatternGet(p: usize, object: usize, id: i32, v: usize) -> i32 { return FcPatternGetWithBinding(p, object, id, v, 0) }

export fn FcPatternDel(p: usize, object: usize) -> i32 {
    if p == 0 { return 0 }
    return common.truth(pattern.del(p, objectOf(object)))
}

export fn FcPatternRemove(p: usize, object: usize, id: i32) -> i32 {
    if p == 0 { return 0 }
    return common.truth(pattern.remove(p, objectOf(object), @intCast(i64, id)))
}

export fn FcPatternAddInteger(p: usize, object: usize, i: i32) -> i32 {
    if p == 0 { return 0 }
    return common.truth(pattern.addInteger(p, objectOf(object), @intCast(i64, i)))
}

export fn FcPatternAddDouble(p: usize, object: usize, d: f64) -> i32 {
    if p == 0 { return 0 }
    return common.truth(pattern.addDouble(p, objectOf(object), d))
}

export fn FcPatternAddString(p: usize, object: usize, s: usize) -> i32 {
    if p == 0 || s == 0 { return 0 }
    return common.truth(pattern.addString(p, objectOf(object), s))
}

export fn FcPatternAddMatrix(p: usize, object: usize, m: usize) -> i32 {
    if p == 0 || m == 0 { return 0 }
    return common.truth(pattern.addPointer(p, objectOf(object), objects.TYPE_MATRIX, m))
}

export fn FcPatternAddCharSet(p: usize, object: usize, c: usize) -> i32 {
    if p == 0 || c == 0 { return 0 }
    return common.truth(pattern.addPointer(p, objectOf(object), objects.TYPE_CHARSET, c))
}

export fn FcPatternAddBool(p: usize, object: usize, b: i32) -> i32 {
    if p == 0 { return 0 }
    return common.truth(pattern.addBool(p, objectOf(object), @intCast(i64, b)))
}

export fn FcPatternAddLangSet(p: usize, object: usize, ls: usize) -> i32 {
    if p == 0 || ls == 0 { return 0 }
    return common.truth(pattern.addPointer(p, objectOf(object), objects.TYPE_LANGSET, ls))
}

export fn FcPatternAddRange(p: usize, object: usize, r: usize) -> i32 {
    if p == 0 || r == 0 { return 0 }
    return common.truth(pattern.addPointer(p, objectOf(object), objects.TYPE_RANGE, r))
}

export fn FcPatternGetInteger(p: usize, object: usize, n: i32, i: usize) -> i32 {
    var got: i64 = 0
    const r = pattern.getInteger(p, objectOf(object), @intCast(i64, n), &got)
    if r == pattern.RESULT_MATCH && i != 0 { mem.putI32(i, got) }
    return @intCast(i32, r)
}

export fn FcPatternGetDouble(p: usize, object: usize, n: i32, d: usize) -> i32 {
    var got: f64 = 0.0
    const r = pattern.getDouble(p, objectOf(object), @intCast(i64, n), &got)
    if r == pattern.RESULT_MATCH && d != 0 { mem.putF64(d, got) }
    return @intCast(i32, r)
}

fn getPointer(p: usize, object: usize, n: i32, t: i64, out: usize) -> i32 {
    var got: usize = 0
    const r = pattern.getPointer(p, objectOf(object), @intCast(i64, n), t, &got)
    if r == pattern.RESULT_MATCH && out != 0 { mem.putWord(out, got) }
    return @intCast(i32, r)
}

export fn FcPatternGetString(p: usize, object: usize, n: i32, s: usize) -> i32 { return getPointer(p, object, n, objects.TYPE_STRING, s) }
export fn FcPatternGetMatrix(p: usize, object: usize, n: i32, m: usize) -> i32 { return getPointer(p, object, n, objects.TYPE_MATRIX, m) }
export fn FcPatternGetCharSet(p: usize, object: usize, n: i32, c: usize) -> i32 { return getPointer(p, object, n, objects.TYPE_CHARSET, c) }
export fn FcPatternGetLangSet(p: usize, object: usize, n: i32, ls: usize) -> i32 { return getPointer(p, object, n, objects.TYPE_LANGSET, ls) }
export fn FcPatternGetRange(p: usize, object: usize, n: i32, r: usize) -> i32 { return getPointer(p, object, n, objects.TYPE_RANGE, r) }

export fn FcPatternGetBool(p: usize, object: usize, n: i32, b: usize) -> i32 {
    var got: i64 = 0
    const r = pattern.getBool(p, objectOf(object), @intCast(i64, n), &got)
    if r == pattern.RESULT_MATCH && b != 0 { mem.putI32(b, got) }
    return @intCast(i32, r)
}

// FcPatternVaBuild: the (object, type, value) triples of `list` up to a
// null object added to `p` (a new pattern when it is null); null when one
// cannot be added.
fn build(p0: usize, list: usize) -> usize {
    var p = p0
    if p == 0 { p = pattern.create() }
    if p == 0 { return 0 }
    while true {
        const object = @intCast(usize, common.nextWord(list))
        if object == 0 { break }
        const t = common.cInt(common.nextWord(list))
        var w: u64 = 0
        if t == objects.TYPE_DOUBLE {
            w = common.nextDouble(list)
        } else if t == objects.TYPE_INTEGER || t == objects.TYPE_BOOL {
            w = common.nextWord(list) & 0xffffffff
        } else if t != objects.TYPE_VOID {
            w = common.nextWord(list)
        }
        if !pattern.add(p, objectOf(object), t, w, true) {
            if p != p0 { pattern.destroy(p) }
            return 0
        }
    }
    return p
}

export fn FcPatternVaBuild(p: usize, list: usize) -> usize {
    common.ready()
    return build(p, list)
}

export fn FcPatternBuild(p: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, x0: f64, x1: f64, x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64) -> usize {
    common.ready()
    var call: common.CallList = undefined
    var words: [6]usize = [6]usize{ p, a1, a2, a3, a4, a5 }
    var doubles: [8]f64 = [8]f64{ x0, x1, x2, x3, x4, x5, x6, x7 }
    const list = common.startList(&call, 1, @frameAddress(), @intFromPtr(&words), @intFromPtr(&doubles))
    return build(p, list)
}

// ---------------------------------------------------------------------------
// Iterating over a pattern's elements: the caller's FcPatternIter holds
// the element's address (0 past the last) and its position.

fn iterSet(p: usize, iter: usize, index: usize) -> void {
    if iter == 0 { return }
    if p != 0 && index < pattern.count(p) {
        mem.putWord(iter, pattern.elt(p, index))
        mem.putWord(iter + 8, index)
    } else {
        mem.putWord(iter, 0)
        mem.putWord(iter + 8, 0)
    }
}

export fn FcPatternIterStart(p: usize, iter: usize) -> void { iterSet(p, iter, 0) }

export fn FcPatternIterNext(p: usize, iter: usize) -> i32 {
    if iter == 0 || mem.getWord(iter) == 0 { return 0 }
    iterSet(p, iter, mem.getWord(iter + 8) + 1)
    return common.truth(mem.getWord(iter) != 0)
}

export fn FcPatternIterIsValid(p: usize, iter: usize) -> i32 {
    if iter == 0 || p == 0 { return 0 }
    const e = mem.getWord(iter)
    const index = mem.getWord(iter + 8)
    return common.truth(e != 0 && index < pattern.count(p) && pattern.elt(p, index) == e)
}

export fn FcPatternFindIter(p: usize, iter: usize, object: usize) -> i32 {
    const position = pattern.position(p, objectOf(object))
    if position < 0 {
        iterSet(p, iter, pattern.count(p))
        return 0
    }
    iterSet(p, iter, @intCast(usize, position))
    return 1
}

export fn FcPatternIterEqual(p1: usize, i1: usize, p2: usize, i2: usize) -> i32 {
    const v1 = FcPatternIterIsValid(p1, i1)
    const v2 = FcPatternIterIsValid(p2, i2)
    if v1 == 0 || v2 == 0 { return common.truth(v1 == v2) }
    const e1 = mem.getWord(i1)
    const e2 = mem.getWord(i2)
    if pattern.eltObject(e1) != pattern.eltObject(e2) { return 0 }
    return common.truth(value.listEqual(pattern.eltValues(e1), pattern.eltValues(e2)))
}

export fn FcPatternIterGetObject(p: usize, iter: usize) -> usize {
    if iter == 0 || mem.getWord(iter) == 0 { return 0 }
    return objects.name(pattern.eltObject(mem.getWord(iter)))
}

export fn FcPatternIterValueCount(p: usize, iter: usize) -> i32 {
    if iter == 0 || mem.getWord(iter) == 0 { return 0 }
    return @intCast(i32, value.listLength(pattern.eltValues(mem.getWord(iter))))
}

export fn FcPatternIterGetValue(p: usize, iter: usize, id: i32, v: usize, b: usize) -> i32 {
    if iter == 0 || mem.getWord(iter) == 0 { return @intCast(i32, pattern.RESULT_NO_MATCH) }
    var l = pattern.eltValues(mem.getWord(iter))
    var k = id
    while l != 0 && k > 0 {
        l = value.next(l)
        k -= 1
    }
    if l == 0 { return @intCast(i32, pattern.RESULT_NO_ID) }
    if v != 0 { mem.copy(v, value.valueOf(l), 16) }
    if b != 0 { mem.putI32(b, value.bindingOf(l)) }
    return @intCast(i32, pattern.RESULT_MATCH)
}

// ---------------------------------------------------------------------------
// Values.

export fn FcValueDestroy(t: u64, w: u64) -> void {
    var v: [2]u64 = [2]u64{ t, w }
    value.release(@intFromPtr(&v))
}

export fn FcValueEqual(t1: u64, w1: u64, t2: u64, w2: u64) -> i32 {
    var a: [2]u64 = [2]u64{ t1 & 0xffffffff, valueWord(typeWord(t1), w1) }
    var b: [2]u64 = [2]u64{ t2 & 0xffffffff, valueWord(typeWord(t2), w2) }
    return common.truth(value.equal(@intFromPtr(&a), @intFromPtr(&b)))
}

export fn FcValueSaveInto(v: usize, out: usize) -> void {
    if out == 0 { return }
    common.ready()
    if v == 0 || !value.save(out, v) { value.setVoid(out) }
}

export fn FcValuePrint(t: u64, w: u64) -> void {
    var v: [2]u64 = [2]u64{ t & 0xffffffff, valueWord(typeWord(t), w) }
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = mem.appendText(&b, " ")
    _ = pattern.printValue(&b, @intFromPtr(&v))
    printBuffer(&b)
}

export fn FcPatternPrint(p: usize) -> void {
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = pattern.print(&b, p)
    printBuffer(&b)
}

export fn FcFontSetPrint(s: usize) -> void {
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    _ = mem.appendText(&b, "FontSet ")
    _ = mem.appendSigned(&b, mem.getI32(s))
    _ = mem.appendText(&b, " of ")
    _ = mem.appendSigned(&b, mem.getI32(s + 4))
    _ = mem.appendText(&b, "\n")
    var i: usize = 0
    while i < pattern.fontSetCount(s) {
        _ = mem.appendText(&b, "Font ")
        _ = mem.appendUnsigned(&b, i)
        _ = mem.appendText(&b, " ")
        _ = pattern.print(&b, pattern.fontSetFont(s, i))
        i += 1
    }
    printBuffer(&b)
}

// ---------------------------------------------------------------------------
// Names.

export fn FcNameParse(name: usize) -> usize {
    common.ready()
    if name == 0 { return 0 }
    return pattern.parseName(name)
}

export fn FcNameUnparse(p: usize) -> usize {
    if p == 0 { return 0 }
    return common.toC(pattern.unparseName(p, true))
}

// The records FcNameGetObjectType and FcNameGetConstant hand out, made
// once: FcObjectType {name, type} of each built-in object (the first, of
// none, for the others), FcConstant {name, object, value} of each
// constant.
var objectTypes: usize = 0
var constants: usize = 0
var constantCount: usize = 0
var tablesGuard: u32 = 0

fn makeTables() -> void {
    mem.lock(&tablesGuard)
    if objectTypes == 0 {
        const n = @intCast(usize, objects.MAX_BASE) + 1
        const table = common.malloc(n * 16)
        mem.putWord(table, @intFromPtr("".pointer))
        mem.put64(table + 8, @bitCast(u64, @intCast(i64, objects.TYPE_UNKNOWN)) & 0xffffffff)
        var id: usize = 1
        while id < n {
            mem.putWord(table + id * 16, objects.name(@intCast(i64, id)))
            mem.put64(table + id * 16 + 8, @bitCast(u64, objects.typeOf(@intCast(i64, id))) & 0xffffffff)
            id += 1
        }
        const count = objects.CONSTANTS
        const list = common.malloc(count * 24 + 24)
        var i: usize = 0
        while i < count {
            mem.putWord(list + i * 24, objects.constantName(i))
            mem.putWord(list + i * 24 + 8, objects.constantObject(i))
            mem.put64(list + i * 24 + 16, @bitCast(u64, objects.constantValueAt(i)) & 0xffffffff)
            i += 1
        }
        constants = list
        constantCount = count
        objectTypes = table
    }
    mem.unlock(&tablesGuard)
}

export fn FcNameGetObjectType(object: usize) -> usize {
    common.ready()
    makeTables()
    if object == 0 { return objectTypes }
    const id = objects.builtinId(object)
    return objectTypes + @intCast(usize, id) * 16
}

export fn FcNameGetConstant(s: usize) -> usize {
    common.ready()
    makeTables()
    if s == 0 { return 0 }
    const i = objects.constantIndex(s)
    if i < 0 { return 0 }
    return constants + @intCast(usize, i) * 24
}

export fn FcNameGetConstantFor(s: usize, object: usize) -> usize {
    common.ready()
    makeTables()
    if s == 0 || object == 0 { return 0 }
    const i = objects.constantIndexFor(s, object)
    if i < 0 { return 0 }
    return constants + @intCast(usize, i) * 24
}

export fn FcNameConstant(s: usize, result: usize) -> i32 {
    common.ready()
    if s == 0 { return 0 }
    var v: i64 = 0
    if !objects.constantValue(s, &v) { return 0 }
    if result != 0 { mem.putI32(result, v) }
    return 1
}

// Deprecated in Fontconfig 2.15: nothing is registered.
export fn FcNameRegisterObjectTypes(types: usize, n: i32) -> i32 { return 0 }
export fn FcNameUnregisterObjectTypes(types: usize, n: i32) -> i32 { return 0 }
export fn FcNameRegisterConstants(consts: usize, n: i32) -> i32 { return 0 }
export fn FcNameUnregisterConstants(consts: usize, n: i32) -> i32 { return 0 }

// ---------------------------------------------------------------------------
// Ranges, matrices, weights.

export fn FcRangeCreateDouble(begin: f64, end: f64) -> usize {
    common.ready()
    return value.rangeCreate(begin, end)
}

export fn FcRangeCreateInteger(begin: u32, end: u32) -> usize {
    common.ready()
    return value.rangeCreate(@floatFromInt(f64, begin), @floatFromInt(f64, end))
}

export fn FcRangeDestroy(r: usize) -> void { mem.free(r) }

export fn FcRangeCopy(r: usize) -> usize {
    if r == 0 { return 0 }
    return value.rangeCopy(r)
}

export fn FcRangeGetDouble(r: usize, begin: usize, end: usize) -> i32 {
    if r == 0 { return 0 }
    if begin != 0 { mem.putF64(begin, value.rangeBegin(r)) }
    if end != 0 { mem.putF64(end, value.rangeEnd(r)) }
    return 1
}

// FcMatrixCopy's matrix is C's (from malloc: freed with free).
export fn FcMatrixCopy(m: usize) -> usize {
    if m == 0 { return 0 }
    return common.cCopy(m, 32)
}

export fn FcMatrixEqual(a: usize, b: usize) -> i32 {
    if a == b { return 1 }
    if a == 0 || b == 0 { return 0 }
    return common.truth(value.matrixEqual(a, b))
}

export fn FcMatrixMultiply(result: usize, a: usize, b: usize) -> void { value.matrixMultiply(result, a, b) }

// The matrix multiplied by [c s; -s c] (a rotation), [sx 0; 0 sy] or
// [1 sh; sv 1], on its left, as Fontconfig's do.
fn transform(m: usize, xx: f64, xy: f64, yx: f64, yy: f64) -> void {
    var r: [4]f64 = [4]f64{ xx, xy, yx, yy }
    var out: [4]f64 = [4]f64{ 0.0, 0.0, 0.0, 0.0 }
    value.matrixMultiply(@intFromPtr(&out), @intFromPtr(&r), m)
    mem.copy(m, @intFromPtr(&out), 32)
}

export fn FcMatrixRotate(m: usize, c: f64, s: f64) -> void { transform(m, c, 0.0 - s, s, c) }
export fn FcMatrixScale(m: usize, sx: f64, sy: f64) -> void { transform(m, sx, 0.0, 0.0, sy) }
export fn FcMatrixShear(m: usize, sh: f64, sv: f64) -> void { transform(m, 1.0, sh, sv, 1.0) }

export fn FcWeightFromOpenTypeDouble(w: f64) -> f64 { return objects.weightFromOpenType(w) }
export fn FcWeightToOpenTypeDouble(w: f64) -> f64 { return objects.weightToOpenType(w) }
export fn FcWeightFromOpenType(w: i32) -> i32 { return @intCast(i32, pattern.truncate(objects.weightFromOpenType(@floatFromInt(f64, w)) + 0.5)) }
export fn FcWeightToOpenType(w: i32) -> i32 { return @intCast(i32, pattern.truncate(objects.weightToOpenType(@floatFromInt(f64, w)) + 0.5)) }

// ---------------------------------------------------------------------------
// FcPatternFormat: fcformat.c's format, its common part: text (`\`
// escaping the next character), and `%{...}` with an optional width
// before it (`%-20{family}`): an element's values (`family`, `:family`
// with a ":" before them, `family=` with its name, `family[1]` one of
// them, `family:-none` a default), `=unparse` the whole name, and `-a,b`
// (the pattern without the objects) or `+a,b` (with only them) before a
// `{...}` of its own. What is not this part (conditions, enumerations,
// conversions, the other builtins) makes FcPatternFormat return null.

const Format = struct {
    text: usize
    at: usize
    failed: bool
}

fn peekByte(f: *Format) -> u64 { return mem.get8(f.*.text + f.*.at) }

fn consume(f: *Format, c: u64) -> bool {
    if peekByte(f) != c { return false }
    f.*.at += 1
    return true
}

// A word (an object's name: letters, digits, "-" and "_") into a new C
// string (0 when there is none).
fn word(f: *Format) -> usize {
    const start = f.*.at
    while true {
        const c = peekByte(f)
        if !((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 45) { break }
        f.*.at += 1
    }
    if f.*.at == start { return 0 }
    return mem.dup(f.*.text + start, f.*.at - start)
}

// The characters up to `stop` (or `}`), `\` escapes kept as the
// character, into a new C string.
fn chars(f: *Format, stop: u64) -> usize {
    var b: mem.Buffer = undefined
    mem.initBuffer(&b)
    while true {
        var c = peekByte(f)
        if c == 0 || c == stop || c == 125 { break }
        if c == 92 {
            f.*.at += 1
            c = peekByte(f)
            if c == 0 { break }
        }
        _ = mem.appendByte(&b, c)
        f.*.at += 1
    }
    _ = mem.appendText(&b, "")
    return mem.takeBuffer(&b)
}

fn simple(f: *Format, p: usize, out: *mem.Buffer) -> void {
    const colon = consume(f, 58)
    const name = word(f)
    if name == 0 {
        f.*.failed = true
        return
    }
    var index: i64 = -1
    if consume(f, 91) {
        index = 0
        while peekByte(f) >= 48 && peekByte(f) <= 57 {
            index = index * 10 + @intCast(i64, peekByte(f) - 48)
            f.*.at += 1
        }
        if !consume(f, 93) { f.*.failed = true }
    }
    const withName = consume(f, 61)
    var fallback: usize = 0
    if consume(f, 58) {
        if !consume(f, 45) {
            f.*.failed = true
        } else {
            // (An empty default is an error, as Fontconfig's read_chars
            // has it.)
            fallback = chars(f, 124)
            if mem.get8(fallback) == 0 { f.*.failed = true }
        }
    }
    if !f.*.failed {
        const e = pattern.findElt(p, objects.fromName(name))
        if e != 0 || fallback != 0 {
            if colon { _ = mem.appendByte(out, 58) }
            if withName {
                _ = mem.appendC(out, name)
                _ = mem.appendByte(out, 61)
            }
            var l: usize = 0
            if e != 0 { l = pattern.eltValues(e) }
            if index >= 0 {
                var k = index
                while l != 0 && k > 0 {
                    l = value.next(l)
                    k -= 1
                }
                if l != 0 {
                    _ = pattern.unparseValue(out, value.valueOf(l), "")
                } else if fallback != 0 {
                    _ = mem.appendC(out, fallback)
                }
            } else if l != 0 {
                _ = pattern.unparseValueList(out, l, "")
            } else if fallback != 0 {
                _ = mem.appendC(out, fallback)
            }
        }
    }
    mem.free(name)
    mem.free(fallback)
}

// An object set of the names separated by "," before a `{`.
fn nameList(f: *Format) -> usize {
    const os = pattern.objectSetCreate()
    while true {
        const name = word(f)
        if name == 0 {
            f.*.failed = true
            break
        }
        _ = pattern.objectSetAdd(os, name)
        mem.free(name)
        if !consume(f, 44) { break }
    }
    return os
}

fn expression(f: *Format, p: usize, out: *mem.Buffer) -> void {
    while !f.*.failed {
        const c = peekByte(f)
        if c == 0 || c == 125 { return }
        if c == 92 {
            f.*.at += 1
            if peekByte(f) != 0 {
                _ = mem.appendByte(out, peekByte(f))
                f.*.at += 1
            }
        } else if c == 37 {
            f.*.at += 1
            directive(f, p, out)
        } else {
            _ = mem.appendByte(out, c)
            f.*.at += 1
        }
    }
}

fn directive(f: *Format, p: usize, out: *mem.Buffer) -> void {
    var left = false
    if consume(f, 45) { left = true }
    var width: usize = 0
    while peekByte(f) >= 48 && peekByte(f) <= 57 {
        width = width * 10 + @intCast(usize, peekByte(f) - 48)
        f.*.at += 1
    }
    if !consume(f, 123) {
        f.*.failed = true
        return
    }
    var piece: mem.Buffer = undefined
    mem.initBuffer(&piece)
    const c = peekByte(f)
    if c == 61 {
        f.*.at += 1
        const name = word(f)
        if name != 0 && mem.cIs(name, "unparse") {
            const text = pattern.unparseName(p, true)
            _ = mem.appendC(&piece, text)
            mem.free(text)
        } else {
            f.*.failed = true
        }
        mem.free(name)
    } else if c == 45 || c == 43 {
        f.*.at += 1
        const os = nameList(f)
        if !f.*.failed && consume(f, 123) {
            var sub: usize = 0
            if c == 43 {
                sub = pattern.filter(p, os)
            } else {
                sub = pattern.duplicate(p)
                var i: usize = 0
                while i < pattern.objectSetCount(os) {
                    _ = pattern.del(sub, objects.fromName(pattern.objectSetName(os, i)))
                    i += 1
                }
            }
            expression(f, sub, &piece)
            pattern.destroy(sub)
            if !consume(f, 125) { f.*.failed = true }
        } else {
            f.*.failed = true
        }
        pattern.objectSetDestroy(os)
    } else {
        simple(f, p, &piece)
    }
    if !consume(f, 125) { f.*.failed = true }
    if !f.*.failed {
        const text = mem.bufferText(&piece)
        var pad: usize = 0
        if width > text.length { pad = width - text.length }
        if !left {
            while pad > 0 {
                _ = mem.appendByte(out, 32)
                pad -= 1
            }
        }
        _ = mem.appendText(out, text)
        while pad > 0 {
            _ = mem.appendByte(out, 32)
            pad -= 1
        }
    }
    mem.freeBuffer(&piece)
}

export fn FcPatternFormat(p: usize, format: usize) -> usize {
    common.ready()
    if p == 0 || format == 0 { return 0 }
    var f = Format.{ .text = format, .at = 0, .failed = false }
    var out: mem.Buffer = undefined
    mem.initBuffer(&out)
    expression(&f, p, &out)
    if f.failed || peekByte(&f) != 0 {
        mem.freeBuffer(&out)
        return 0
    }
    _ = mem.appendText(&out, "")
    const text = mem.takeBuffer(&out)
    if text == 0 { return common.cCopy(@intFromPtr("".pointer), 0) }
    return common.toC(text)
}
