// fcfreetype.h: Fontconfig's functions of FreeType faces, over mlx-
// freetype's C API (libmlxfreetype.so: its FT_Face records, read at
// FreeType 2.13's offsets).
//
// FcFreeTypeQueryFace reads the face's file again with std.truetype (the
// pattern is then the one the configuration's fonts have); for a face
// without a file (opened from memory) it makes a smaller pattern of what
// FT_Face says (family, style, index, weight and slant of its style
// flags, outline and scalable, spacing, charset and languages).
const common = @import("./common.mlx")

const mem = common.mem
const objects = common.objects
const value = common.value
const pattern = common.pattern
const charset = common.charset
const lang = common.lang
const load = common.load

extern("c") fn FT_Get_Char_Index(face: usize, charcode: u64) -> u32
extern("c") fn FT_Select_Charmap(face: usize, encoding: u32) -> i32
extern("c") fn FT_Get_First_Char(face: usize, agindex: usize) -> u64
extern("c") fn FT_Get_Next_Char(face: usize, charcode: u64, agindex: usize) -> u64
extern("c") fn FT_Load_Glyph(face: usize, glyph: u32, flags: i32) -> i32
extern("c") fn FT_Get_Advance(face: usize, glyph: u32, flags: i32, advance: usize) -> i32

// FT_FaceRec's fields, FT_CharMapRec's encoding, FT_GlyphSlotRec's format
// and outline (whose first field is n_contours, a short).
const FACE_NUM_FACES: usize = 0
const FACE_FLAGS: usize = 16
const FACE_STYLE_FLAGS: usize = 24
const FACE_FAMILY_NAME: usize = 40
const FACE_STYLE_NAME: usize = 48
const FACE_GLYPH: usize = 152
const FACE_CHARMAP: usize = 168
const CHARMAP_ENCODING: usize = 8
const SLOT_FORMAT: usize = 144
const SLOT_OUTLINE: usize = 200

const ENCODING_UNICODE: u32 = 1970170211
const ENCODING_MS_SYMBOL: u32 = 1937337698
const GLYPH_FORMAT_OUTLINE: u64 = 1869968492
// FT_LOAD_IGNORE_GLOBAL_ADVANCE_WIDTH | FT_LOAD_NO_SCALE | FT_LOAD_NO_HINTING
const LOAD_FLAGS: i32 = 515

const FACE_FLAG_SCALABLE: u64 = 1
const STYLE_FLAG_ITALIC: u64 = 1
const STYLE_FLAG_BOLD: u64 = 2

fn charmapEncoding(face: usize) -> u32 {
    const charmap = mem.getWord(face + FACE_CHARMAP)
    if charmap == 0 { return 0 }
    return @intCast(u32, mem.get32(charmap + CHARMAP_ENCODING))
}

fn encodingAt(i: usize) -> u32 { return if i == 0 { ENCODING_UNICODE } else { ENCODING_MS_SYMBOL } }

// FcFreeTypeCharIndex: the glyph of `ucs4` in the Unicode charmap or the
// symbol one (the current charmap first), U+F000 to U+F0FF of a symbol
// font standing for U+0000 to U+00FF.
export fn FcFreeTypeCharIndex(face: usize, ucs4: u32) -> u32 {
    if face == 0 { return 0 }
    var initial: usize = 0
    if mem.getWord(face + FACE_CHARMAP) != 0 {
        while initial < 2 && encodingAt(initial) != charmapEncoding(face) { initial += 1 }
        if initial == 2 { initial = 0 }
    }
    var offset: usize = 0
    while offset < 2 {
        const encoding = encodingAt((initial + offset) % 2)
        offset += 1
        if mem.getWord(face + FACE_CHARMAP) == 0 || charmapEncoding(face) != encoding {
            if FT_Select_Charmap(face, encoding) != 0 { continue }
        }
        var glyph = FT_Get_Char_Index(face, @intCast(u64, ucs4))
        if glyph != 0 { return glyph }
        if ucs4 < 256 && mem.getWord(face + FACE_CHARMAP) != 0 && charmapEncoding(face) == ENCODING_MS_SYMBOL {
            glyph = FT_Get_Char_Index(face, @intCast(u64, ucs4) + 0xf000)
            if glyph != 0 { return glyph }
        }
    }
    return 0
}

// FcFreeTypeCharSet: the characters of the first of the Unicode and
// symbol charmaps the face has (control characters only with a glyph of
// contours: CID fonts map them to their space).
fn charSetOf(face: usize) -> usize {
    const cs = charset.create()
    if cs == 0 || face == 0 { return cs }
    // (The glyph index's word on the heap: the C calls write it.)
    const glyph = mem.alloc(8)
    var o: usize = 0
    while o < 2 {
        if FT_Select_Charmap(face, encodingAt(o)) != 0 {
            o += 1
            continue
        }
        var ucs4 = FT_Get_First_Char(face, glyph)
        while mem.get32(glyph) != 0 {
            var good = true
            if ucs4 <= 0x1f {
                if FT_Load_Glyph(face, @intCast(u32, mem.get32(glyph)), LOAD_FLAGS) != 0 {
                    good = false
                } else {
                    const slot = mem.getWord(face + FACE_GLYPH)
                    if mem.get32(slot + SLOT_FORMAT) == GLYPH_FORMAT_OUTLINE && mem.get16(slot + SLOT_OUTLINE) == 0 { good = false }
                }
            }
            if good { _ = charset.addChar(cs, ucs4) }
            ucs4 = FT_Get_Next_Char(face, ucs4, glyph)
        }
        if encodingAt(o) == ENCODING_MS_SYMBOL {
            var c: u64 = 0xf000
            while c < 0xf100 {
                if charset.hasChar(cs, c) { _ = charset.addChar(cs, c - 0xf000) }
                c += 1
            }
        }
        break
    }
    mem.free(glyph)
    return cs
}

export fn FcFreeTypeCharSet(face: usize, blanks: usize) -> usize {
    common.ready()
    return charSetOf(face)
}

fn approximatelyEqual(x: i64, y: i64) -> bool {
    const ax = if x < 0 { 0 - x } else { x }
    const ay = if y < 0 { 0 - y } else { y }
    const d = if x > y { x - y } else { y - x }
    return d * 33 <= (if ax > ay { ax } else { ay })
}

// FcFreeTypeSpacing: monospace when the glyphs of the first charmap have
// one advance (unscaled), dual when two, one twice the other, else
// proportional. (A bitmap-only face is not set to its strike nearest 16
// pixels first, as Fontconfig sets it: its advances are its own.)
fn spacingOf(face: usize) -> i64 {
    var flags: i32 = LOAD_FLAGS
    if (mem.get64(face + FACE_FLAGS) & FACE_FLAG_SCALABLE) != 0 { flags = flags | 8 }
    // (The glyph and the advance written by the C calls: heap words.)
    const words = mem.alloc(16)
    var advances: [3]i64 = [3]i64{ 0, 0, 0 }
    var count: usize = 0
    var o: usize = 0
    while o < 2 {
        if FT_Select_Charmap(face, encodingAt(o)) != 0 {
            o += 1
            continue
        }
        var ucs4 = FT_Get_First_Char(face, words)
        while mem.get32(words) != 0 && count < 3 {
            mem.put64(words + 8, 0)
            if FT_Get_Advance(face, @intCast(u32, mem.get32(words)), flags, words + 8) == 0 && mem.get64(words + 8) != 0 {
                const advance = @bitCast(i64, mem.get64(words + 8))
                var j: usize = 0
                while j < count && !approximatelyEqual(advance, advances[j]) { j += 1 }
                if j == count {
                    advances[count] = advance
                    count += 1
                }
            }
            ucs4 = FT_Get_Next_Char(face, ucs4, words)
        }
        break
    }
    mem.free(words)
    if count <= 1 { return 100 }
    if count == 2 {
        const small = if advances[0] < advances[1] { advances[0] } else { advances[1] }
        const large = if advances[0] < advances[1] { advances[1] } else { advances[0] }
        if approximatelyEqual(small * 2, large) { return 90 }
    }
    return 0
}

export fn FcFreeTypeCharSetAndSpacing(face: usize, blanks: usize, spacing: usize) -> usize {
    common.ready()
    if spacing != 0 && face != 0 { mem.putI32(spacing, spacingOf(face)) }
    return charSetOf(face)
}

export fn FcPatternGetFTFace(p: usize, object: usize, n: i32, f: usize) -> i32 {
    common.ready()
    var got: usize = 0
    const r = pattern.getPointer(p, objects.fromName(object), @intCast(i64, n), objects.TYPE_FTFACE, &got)
    if r == pattern.RESULT_MATCH && f != 0 { mem.putWord(f, got) }
    return @intCast(i32, r)
}

export fn FcPatternAddFTFace(p: usize, object: usize, f: usize) -> i32 {
    common.ready()
    if p == 0 || f == 0 { return 0 }
    return common.truth(pattern.addPointer(p, objects.fromName(object), objects.TYPE_FTFACE, f))
}

export fn FcFreeTypeQueryFace(face: usize, file: usize, id: u32, blanks: usize) -> usize {
    common.ready()
    if face == 0 { return 0 }
    if file != 0 {
        const set = pattern.fontSetCreate()
        _ = load.queryFile(file, set)
        var found: usize = 0
        var i: usize = 0
        while i < pattern.fontSetCount(set) && found == 0 {
            const font = pattern.fontSetFont(set, i)
            var index: i64 = 0
            _ = pattern.getInteger(font, objects.INDEX, 0, &index)
            if @bitCast(u64, index) & 0xffffffff == @intCast(u64, id) {
                found = font
                pattern.reference(found)
            }
            i += 1
        }
        pattern.fontSetDestroy(set)
        if found != 0 { return found }
    }
    // A face of memory: what FT_Face says.
    const p = pattern.create()
    const family = mem.getWord(face + FACE_FAMILY_NAME)
    const style = mem.getWord(face + FACE_STYLE_NAME)
    if family != 0 { _ = pattern.addString(p, objects.FAMILY, family) }
    if style != 0 { _ = pattern.addString(p, objects.STYLE, style) }
    if file != 0 { _ = pattern.addString(p, objects.FILE, file) }
    _ = pattern.addInteger(p, objects.INDEX, @intCast(i64, id))
    const flags = mem.get64(face + FACE_STYLE_FLAGS)
    _ = pattern.addDouble(p, objects.WEIGHT, if (flags & STYLE_FLAG_BOLD) != 0 { 200.0 } else { 80.0 })
    _ = pattern.addInteger(p, objects.SLANT, if (flags & STYLE_FLAG_ITALIC) != 0 { 100 } else { 0 })
    _ = pattern.addDouble(p, objects.WIDTH, 100.0)
    const scalable = (mem.get64(face + FACE_FLAGS) & FACE_FLAG_SCALABLE) != 0
    _ = pattern.addBool(p, objects.OUTLINE, if scalable { 1 } else { 0 })
    _ = pattern.addBool(p, objects.SCALABLE, if scalable { 1 } else { 0 })
    const spacing = spacingOf(face)
    if spacing != 0 { _ = pattern.addInteger(p, objects.SPACING, spacing) }
    const cs = charSetOf(face)
    if cs != 0 {
        _ = pattern.addPointer(p, objects.CHARSET, objects.TYPE_CHARSET, cs)
        const ls = lang.ofCharSet(cs, 0)
        if ls != 0 {
            _ = pattern.addPointer(p, objects.LANG, objects.TYPE_LANGSET, ls)
            lang.destroy(ls)
        }
        charset.destroy(cs)
    }
    return p
}
