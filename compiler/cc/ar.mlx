// mlx-ar: static libraries, archives of relocatable objects, as `ar`
// makes them (compiler/selfhost/object/archive.mlx):
//
//     mlx-ar rcs LIBRARY.a OBJECT.o...   makes the archive (any mode with r)
//     mlx-ar t LIBRARY.a                 lists its members
//     mlx-ar x LIBRARY.a                 extracts them into the directory
//
// mlx-cc links an archive given on its command line or found by -l in a
// -L directory, taking the members that define what the program needs.
const std = @import("std")
const crash = @import("std.crash")
const page_allocator = @import("../../std/bootstrap/page_allocator.mlx")
const source = @import("../../compiler/selfhost/source.mlx")
const archive = @import("../../compiler/selfhost/object/archive.mlx")
const relocatable = @import("../../compiler/selfhost/object/relocatable.mlx")

fn cLength(text: [*]const u8) -> usize {
    var length: usize = 0
    while text[length] != 0 { length += 1 }
    return length
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn sayName(text: []const u8, name: [*]const u8, length: usize) -> void {
    say(text)
    say(name[0..length])
    say("\n")
}

fn usage() -> u8 {
    say("usage: mlx-ar rcs LIBRARY.a OBJECT.o...  |  mlx-ar t LIBRARY.a  |  mlx-ar x LIBRARY.a\n")
    return 2
}

// The part of a path after its last slash.
fn baseName(path: [*]const u8, length: usize) -> (usize, usize) {
    var start: usize = 0
    var index: usize = 0
    while index < length {
        if path[index] == 47 { start = index + 1 }
        index += 1
    }
    return -> (start, length - start)
}

pub fn main(arguments: [][*]const u8) -> u8 {
    // The crash report before anything else: a crash names the function it
    // was in and its callers, and is kept for MLX Observatory (std.crash).
    _ = crash.install()
    if arguments.length < 3 { return usage() }
    const allocator = page_allocator.init()
    const mode = arguments[1]
    const library = arguments[2]
    const library_length = cLength(library)
    var creates = false
    var lists = false
    var extracts = false
    var index: usize = 0
    while mode[index] != 0 {
        if mode[index] == 114 { creates = true }
        if mode[index] == 116 { lists = true }
        if mode[index] == 120 { extracts = true }
        index += 1
    }
    if creates {
        const count = arguments.length - 3
        const memory = allocator.alloc((count + 1) * @sizeOf(archive.Member), @alignOf(archive.Member))
        if memory == null { return 1 }
        var members: [*]archive.Member = undefined
        unsafe { members = @ptrCast([*]archive.Member, memory.?) }
        index = 0
        while index < count {
            const path = arguments[3 + index]
            const length = cLength(path)
            const file = source.load(allocator, path, length)
            if !file.valid {
                sayName("mlx-ar: cannot read ", path, length)
                return 1
            }
            if !relocatable.isObject(file.bytes, file.length) {
                sayName("mlx-ar: not a relocatable object: ", path, length)
                return 1
            }
            const base = baseName(path, length)
            unsafe { members[index] = archive.Member.{ .namePointer = @ptrFromInt([*]const u8, @intFromPtr(path) + base.0), .nameLength = base.1, .bytes = file.bytes, .length = file.length } }
            index += 1
        }
        if !archive.write(allocator, library, members, count) {
            sayName("mlx-ar: cannot write ", library, library_length)
            return 1
        }
        return 0
    }
    if lists || extracts {
        const file = source.load(allocator, library, library_length)
        if !file.valid {
            sayName("mlx-ar: cannot read ", library, library_length)
            return 1
        }
        if !archive.isArchive(file.bytes, file.length) {
            sayName("mlx-ar: not an archive: ", library, library_length)
            return 1
        }
        var r = archive.reader(file.bytes, file.length)
        var member: archive.Member = undefined
        while archive.next(&r, &member) {
            if lists {
                const ignored = std.io.writeAll(std.io.stdout(), member.namePointer[0..member.nameLength])
                const ignored2 = std.io.writeAll(std.io.stdout(), "\n")
            } else {
                // The name as a NUL-ended path.
                const path_memory = allocator.alloc(member.nameLength + 1, 1)
                if path_memory == null { return 1 }
                const path = path_memory.?
                var copy: usize = 0
                while copy < member.nameLength {
                    path[copy] = member.namePointer[copy]
                    copy += 1
                }
                path[member.nameLength] = 0
                if !relocatable.writeFile(path, member.bytes, member.length) {
                    sayName("mlx-ar: cannot write ", member.namePointer, member.nameLength)
                    return 1
                }
            }
        }
        return 0
    }
    return usage()
}
