// `mlx-cc --emit-mlx=FILE`: the C++ to Mlx translator's first step
// (projects/webkit/LATTICE.md, L0). After a unit is parsed and typed, the
// definitions of its main file -- its structs, globals and functions, not
// what its headers declared -- are written as Mlx from the typed tree:
// declarations, control flow and expressions with their resolved types,
// casts made explicit as Mlx wants them, the C functions the unit calls as
// extern("c") declarations. It is a first version for the hand to make
// Mlx (ownership, errors, containers): whatever the translator cannot
// express is marked `// LATTICE: ...` in place or listed at the end of the
// file, so the tool improves before the hand work grows.
//
// How the text is made: each statement is written into a buffer of its
// own, so that an expression needing a statement before it (a temporary
// assigned in a comma expression) can hoist one; a function's body is
// written before its locals are declared, so only the locals the Mlx
// uses are declared; the structs are those the written code names.
const base = @import("./base.mlx")
const ast = @import("./ast.mlx")
const types = @import("./types.mlx")
const tokens = @import("./tokens.mlx")
const names = @import("./names.mlx")
const program = @import("./program.mlx")

pub var enabled = false
// MLX_CC_EMIT_TRACE: every expression statement under a comment with
// its tree, the node kinds (ast.mlx's numbers) with a variable's name
// and each node's type kind: what the front end handed over, when a
// line of the Mlx is not what the C++ says.
pub var trace = false
// The output file (an address and a length: a global slice has no
// lowering as a module variable).
var outputAt: usize = 0
var outputLength: usize = 0

pub fn enable(path: []const u8) -> void {
    if path.length == 0 { return }
    enabled = true
    outputAt = base.keep(path)
    outputLength = path.length
}

fn outputPath() -> []const u8 { return base.bytes(outputAt, outputLength) }

// The import of the runtime module (projects/lattice/runtime/c.mlx: the C
// library's functions as Mlx), as the translated file imports it;
// `--emit-mlx-runtime=IMPORT`, `../../runtime/c.mlx` by default (the
// translations in projects/lattice/angle/common).
var runtimeAt: usize = 0
var runtimeLength: usize = 0

pub fn setRuntime(path: []const u8) -> void {
    runtimeAt = base.keep(path)
    runtimeLength = path.length
}

fn runtimeImport() -> []const u8 {
    if runtimeLength == 0 { return "../../runtime/c.mlx" }
    return base.bytes(runtimeAt, runtimeLength)
}

var usesRuntime = false

// ---------------------------------------------------------------------------
// Modules: a header's declarations resolved to the translated module that
// defines them (LATTICE.md). A unit named with `--emit-mlx-units=a,b,...`
// has a module `./a.mlx` beside this file: a function its header declares
// is called as `a.name(...)`, a record its header defines named `a.Name`.
// The C++ library's non-template classes (mlxlibcpp's `string`) live in
// the std module (`--emit-mlx-std=IMPORT`, alias `libcpp`). Template
// instances and inline functions are carried along per unit (their bodies
// are here); the module's own headers are its own.
const MAX_MODULES: usize = 1024
var unitNames: [MAX_MODULES]u32 = undefined
var unitCount: usize = 0
var stdModuleAt: usize = 0
var stdModuleLength: usize = 0
var mainUnitName: u32 = 0
var usedModules: [MAX_MODULES]u32 = undefined
var usedModuleCount: usize = 0

pub fn setUnits(list: []const u8) -> void {
    var start: usize = 0
    var k: usize = 0
    while k <= list.length {
        if k == list.length || list[k] == 44 {
            if k > start && unitCount < MAX_MODULES {
                unitNames[unitCount] = base.intern(list[start..k])
                unitCount += 1
            }
            start = k + 1
        }
        k += 1
    }
}

pub fn setStdModule(path: []const u8) -> void {
    stdModuleAt = base.keep(path)
    stdModuleLength = path.length
}

// The std module's file where the translator reads it
// (`--emit-mlx-std-file=FILE`; without it the import, from the directory
// of the file written).
var stdFileAt: usize = 0
var stdFileLength: usize = 0

pub fn setStdModuleFile(path: []const u8) -> void {
    stdFileAt = base.keep(path)
    stdFileLength = path.length
}

// The records the std module declares (its `pub const NAME = ... struct`
// lines): what a unit names `libcpp.NAME`. Another instance of the same
// headers' templates (basic_string over another allocator, hash<string>)
// comes along with the unit, as vector<T> does.
const MAX_STD_RECORDS: usize = 1024
var stdRecords: [MAX_STD_RECORDS]u32 = undefined
var stdRecordCount: usize = 0
var stdRecordsRead = false

fn readStdRecords() -> void {
    stdRecordsRead = true
    var id: u32 = 0
    if stdFileLength > 0 {
        id = base.readFile(base.bytes(stdFileAt, stdFileLength))
    } else {
        var path = emptyBuffer()
        const output = outputPath()
        var end = output.length
        while end > 0 && output[end - 1] != 47 { end -= 1 }
        putTo(&path, output[0..end])
        putTo(&path, base.bytes(stdModuleAt, stdModuleLength))
        id = base.readFile(textOf(&path))
    }
    if id == 0 { return }
    const text = base.bytes(base.fileData(id), base.fileLength(id))
    var k: usize = 0
    while k < text.length {
        var end = k
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[k..end]
        if startsWith(line, "pub const ") && (containsText(line, "struct {") || containsText(line, "union {")) {
            var stop: usize = 10
            while stop < line.length && line[stop] != 32 { stop += 1 }
            if stdRecordCount < MAX_STD_RECORDS {
                stdRecords[stdRecordCount] = base.intern(line[10..stop])
                stdRecordCount += 1
            }
        }
        k = end + 1
    }
}

// Whether the std module has the record (every record of its headers
// when the module cannot be read).
fn stdModuleHas(ty: usize) -> bool {
    if !stdRecordsRead { readStdRecords() }
    if stdRecordCount == 0 { return true }
    var text = emptyBuffer()
    const savedOut = out
    out = text
    putTypeName(ty)
    text = out
    out = savedOut
    const name = base.intern(textOf(&text))
    var k: usize = 0
    while k < stdRecordCount {
        if stdRecords[k] == name { return true }
        k += 1
    }
    return false
}

fn fileOfToken(token: usize) -> []const u8 {
    return base.nameOf(base.fileName(@intCast(u32, tokens.at(token).*.file)))
}

// `dir/name.ext` as `name`.
fn baseNameOf(path: []const u8) -> []const u8 {
    var start: usize = 0
    var end = path.length
    var k: usize = 0
    while k < path.length {
        if path[k] == 47 { start = k + 1 }
        k += 1
    }
    k = start
    while k < path.length {
        if path[k] == 46 { end = k }
        k += 1
    }
    return path[start..end]
}

fn isStdHeader(path: []const u8) -> bool {
    return containsText(path, "/include/c++/")
}

// The C++ library's classes the std module defines (mlxlibcpp's
// string.cpp translated); the streams are not there yet.
// The library headers the std module (mlxlibcpp's string.cpp translated)
// has: its records and functions, template instances included
// (basic_string_view<char>, char_traits<char>), are `libcpp.NAME`.
fn isStdModuleHeader(path: []const u8) -> bool {
    if !isStdHeader(path) { return false }
    const name = baseNameOf(path)
    return base.same(name, "string") || base.same(name, "string_view")
}

// A token placing a record: its first member's, else one of its
// methods' (a class of static methods has no members).
fn recordToken(ty: usize) -> usize {
    const t = types.at(ty)
    if t.*.members != 0 { return types.member(t.*.members).*.token }
    if t.*.name != 0 {
        const slot = classSlot(t.*.name)
        return if className[slot] == t.*.name { classToken[slot] } else { 0 }
    }
    var o = unitGlobals
    while o != 0 {
        const obj = ast.obj(o)
        if obj.*.isFunction && obj.*.classType != 0 && sameStruct(obj.*.classType, ty) { return obj.*.token }
        o = obj.*.next
    }
    return 0
}

fn isUnitName(name: []const u8) -> bool {
    var k: usize = 0
    while k < unitCount {
        if base.same(base.nameOf(unitNames[k]), name) { return true }
        k += 1
    }
    return false
}

// The module (its alias, interned) a declaration at `token` belongs to;
// 0 for this unit's own declarations and for what no module has.
fn moduleOfToken(token: usize) -> u32 {
    if token == 0 || inMainFile(token) { return 0 }
    const path = fileOfToken(token)
    if isStdHeader(path) {
        if stdModuleLength == 0 || !isStdModuleHeader(path) { return 0 }
        return base.intern("libcpp")
    }
    const name = baseNameOf(path)
    if mainUnitName != 0 && base.same(name, base.nameOf(mainUnitName)) { return 0 }
    if !isUnitName(name) { return 0 }
    return base.intern(name)
}

// Whether a header's record is this unit's own: its methods are defined
// here (mlxlibcpp's `string` in string.cpp, a class in its .cpp).
fn ownedHere(ty: usize) -> bool {
    const known = memoGet(0, ty)
    if known != 0 { return known == 2 }
    const answer = ownedHereScan(ty)
    memoPut(0, ty, answer)
    return answer
}

// What the unit's functions say of each class, by the class's name
// (sameStruct's identity), from one pass over the declarations: whether
// one of its methods is defined in this file, whether one is virtual.
// (Asked per type record, of which a unit of libANGLE has hundreds of
// thousands; a scan of the declarations for each is the whole run.)
const CLASS_SLOTS: usize = 131072
const CLASS_HERE: u8 = 1
const CLASS_VIRTUAL: u8 = 2
var className: [CLASS_SLOTS]u32 = undefined
var classFlags: [CLASS_SLOTS]u8 = undefined
// (A token of one of the class's methods: where the class is declared,
// for one without members.)
var classToken: [CLASS_SLOTS]usize = undefined

fn classSlot(name: u32) -> usize {
    var slot = (@intCast(usize, name) *% 2654435761) % CLASS_SLOTS
    var probes: usize = 0
    while className[slot] != 0 && className[slot] != name && probes < CLASS_SLOTS {
        slot = (slot + 1) % CLASS_SLOTS
        probes += 1
    }
    return slot
}

// The names of the unit's functions outside classes (a set): a class of
// an anonymous namespace with a function's name (`ValidateAST` the class
// in the .cpp beside sh::ValidateAST the function) is written `Name_`.
const FREE_SLOTS: usize = 65536
var freeNames: [FREE_SLOTS]u32 = undefined

fn freeSlot(name: u32) -> usize {
    var slot = (@intCast(usize, name) *% 2654435761) % FREE_SLOTS
    var probes: usize = 0
    while freeNames[slot] != 0 && freeNames[slot] != name && probes < FREE_SLOTS {
        slot = (slot + 1) % FREE_SLOTS
        probes += 1
    }
    return slot
}

fn isFreeFunctionName(text: []const u8) -> bool {
    const name = base.intern(text)
    return freeNames[freeSlot(name)] == name
}

// The names of the C functions the unit declares without a body (stat,
// sigaction, copysign: declared extern under their own names). A record
// or a C++ function that would be written with such a name gets `Name_`:
// C's `struct stat` beside `stat()`, std::copysign(float, float) beside
// C's copysign.
var cNames: [FREE_SLOTS]u32 = undefined

fn cSlot(name: u32) -> usize {
    var slot = (@intCast(usize, name) *% 2654435761) % FREE_SLOTS
    var probes: usize = 0
    while cNames[slot] != 0 && cNames[slot] != name && probes < FREE_SLOTS {
        slot = (slot + 1) % FREE_SLOTS
        probes += 1
    }
    return slot
}

fn isCFunction(obj: *ast.Obj) -> bool {
    return obj.*.isFunction && obj.*.classType == 0 && obj.*.name != 0 && (obj.*.linkName == 0 || obj.*.linkName == obj.*.name)
}

fn isCFunctionName(text: []const u8) -> bool {
    const name = base.intern(text)
    return cNames[cSlot(name)] == name
}

// The unit's functions in chains, so that the functions of one name and
// the methods of one class are found without a walk of every declaration
// (a unit of the Vulkan back end has some hundred thousand; a walk for
// every function's name was two thirds of a run). An entry is a function;
// entry 0 ends a chain. A class's chain keeps the order of the
// declarations; a name's does not.
const CHAIN_MAX: usize = 1048576
const NAME_SLOTS: usize = 262144
var chainObj: [CHAIN_MAX]usize = undefined
var chainNextName: [CHAIN_MAX]u32 = undefined
var chainNextClass: [CHAIN_MAX]u32 = undefined
var chainCount: usize = 1
// (More functions than entries: the walks are used again.)
var chainsFull: bool = false
var nameKey: [NAME_SLOTS]u32 = undefined
var nameHead: [NAME_SLOTS]u32 = undefined
var classHead: [CLASS_SLOTS]u32 = undefined
var classTail: [CLASS_SLOTS]u32 = undefined

fn nameSlot(name: u32) -> usize {
    var slot = (@intCast(usize, name) *% 2654435761) % NAME_SLOTS
    var probes: usize = 0
    while nameKey[slot] != 0 && nameKey[slot] != name && probes < NAME_SLOTS {
        slot = (slot + 1) % NAME_SLOTS
        probes += 1
    }
    return slot
}

// The first entry of the functions named `name`, 0 without one.
fn firstOfName(name: u32) -> u32 {
    const slot = nameSlot(name)
    return if nameKey[slot] == name { nameHead[slot] } else { 0 }
}

// The first entry of the methods of the class named `name`.
fn firstOfClass(name: u32) -> u32 {
    const slot = classSlot(name)
    return if className[slot] == name { classHead[slot] } else { 0 }
}

fn chainFunction(o: usize) -> void {
    const obj = ast.obj(o)
    if chainCount >= CHAIN_MAX {
        chainsFull = true
        return
    }
    const entry = @intCast(u32, chainCount)
    chainCount += 1
    chainObj[entry] = o
    chainNextName[entry] = 0
    chainNextClass[entry] = 0
    if obj.*.name != 0 {
        const slot = nameSlot(obj.*.name)
        if nameKey[slot] == 0 || nameKey[slot] == obj.*.name {
            nameKey[slot] = obj.*.name
            chainNextName[entry] = nameHead[slot]
            nameHead[slot] = entry
        } else {
            chainsFull = true
        }
    }
    if obj.*.classType != 0 && types.at(obj.*.classType).*.name != 0 {
        const slot = classSlot(types.at(obj.*.classType).*.name)
        if classTail[slot] == 0 {
            classHead[slot] = entry
        } else {
            chainNextClass[classTail[slot]] = entry
        }
        classTail[slot] = entry
    }
}

fn indexClasses() -> void {
    var k: usize = 0
    while k < CLASS_SLOTS {
        className[k] = 0
        classFlags[k] = 0
        classToken[k] = 0
        classHead[k] = 0
        classTail[k] = 0
        k += 1
    }
    k = 0
    while k < FREE_SLOTS {
        freeNames[k] = 0
        cNames[k] = 0
        k += 1
    }
    k = 0
    while k < NAME_SLOTS {
        nameKey[k] = 0
        nameHead[k] = 0
        k += 1
    }
    chainCount = 1
    chainsFull = false
    var o = unitGlobals
    while o != 0 {
        const obj = ast.obj(o)
        if obj.*.isFunction && obj.*.classType == 0 && obj.*.name != 0 { freeNames[freeSlot(obj.*.name)] = obj.*.name }
        if isCFunction(obj) && obj.*.body == 0 { cNames[cSlot(obj.*.name)] = obj.*.name }
        if obj.*.isFunction && obj.*.classType != 0 {
            const name = types.at(obj.*.classType).*.name
            if name != 0 {
                const slot = classSlot(name)
                className[slot] = name
                if classToken[slot] == 0 { classToken[slot] = obj.*.token }
                if functionHere(obj) { classFlags[slot] = classFlags[slot] | CLASS_HERE }
                if obj.*.isVirtual { classFlags[slot] = classFlags[slot] | CLASS_VIRTUAL }
            }
        }
        if obj.*.isFunction { chainFunction(o) }
        o = obj.*.next
    }
}

fn classFlag(name: u32, flag: u8) -> bool {
    const slot = classSlot(name)
    return className[slot] == name && (classFlags[slot] & flag) != 0
}

fn ownedHereScan(ty: usize) -> bool {
    if types.at(ty).*.name != 0 && startsWith(lastComponent(base.nameOf(types.at(ty).*.name)), "__lambda") { return false }
    if types.at(ty).*.name != 0 { return classFlag(types.at(ty).*.name, CLASS_HERE) }
    var o = unitGlobals
    while o != 0 {
        const obj = ast.obj(o)
        if obj.*.isFunction && obj.*.classType != 0 && sameStruct(obj.*.classType, ty) && functionHere(obj) { return true }
        o = obj.*.next
    }
    return false
}

// The answers of the questions asked of a type over and over (whether
// its methods are this file's, whether it has virtual functions, whether
// the Mlx has it), each a scan of the unit's declarations: kept by the
// type, in direct-mapped tables (a slot taken by another type is asked
// again). 0 not known, 1 no, 2 yes.
const MEMO_SLOTS: usize = 262144
var memoType: [5][MEMO_SLOTS]usize = undefined
var memoAnswer: [5][MEMO_SLOTS]u8 = undefined
// (A type's module, an interned name: kept beside the yes and no.)
var memoModule: [MEMO_SLOTS]u32 = undefined

fn memoClear() -> void {
    var which: usize = 0
    while which < 5 {
        var k: usize = 0
        while k < MEMO_SLOTS {
            memoType[which][k] = 0
            memoAnswer[which][k] = 0
            k += 1
        }
        which += 1
    }
}

// (A type is the address of its record: spread by a multiplication,
// the top 18 bits the slot.)
fn memoSlot(ty: usize) -> usize {
    return ((ty >> 3) *% 11400714819323198485) >> 46
}

fn memoGet(which: usize, ty: usize) -> u8 {
    const slot = memoSlot(ty)
    if memoType[which][slot] != ty { return 0 }
    return memoAnswer[which][slot]
}

fn memoPut(which: usize, ty: usize, answer: bool) -> void {
    const slot = memoSlot(ty)
    memoType[which][slot] = ty
    memoAnswer[which][slot] = if answer { 2 } else { 1 }
}

// The module a record is named from, 0 when it is this file's (defined,
// owned or carried along: a template instance is carried).
fn moduleOfType(ty: usize) -> u32 {
    const slot = memoSlot(ty)
    if memoType[3][slot] == ty && memoAnswer[3][slot] != 0 { return memoModule[slot] }
    const module = moduleOfTypeScan(ty)
    memoType[3][slot] = ty
    memoAnswer[3][slot] = 2
    memoModule[slot] = module
    return module
}

fn moduleOfTypeScan(ty: usize) -> u32 {
    const t = types.at(ty)
    if !isRecordKind(t.*.kind) || t.*.name == 0 || isStdArray(ty) { return 0 }
    if definedHere(ty) || ownedHere(ty) { return 0 }
    const token = recordToken(ty)
    if token == 0 || inMainFile(token) { return 0 }
    const path = fileOfToken(token)
    if isStdHeader(path) {
        // The library's: the std module's when it has the header; the
        // other headers' template instances (vector<T>, optional<T>) come
        // along with the unit.
        if stdModuleLength == 0 || !isStdModuleHeader(path) || !stdModuleHas(ty) { return 0 }
        return base.intern("libcpp")
    }
    // (A template's instance is made in each unit that uses it.)
    if containsText(base.nameOf(t.*.name), "<") { return 0 }
    return moduleOfToken(token)
}

// The module a called function is in: its class's, else its header's
// when the function has no body here (one with a body is carried along).
fn moduleOfFunction(obj: *ast.Obj) -> u32 {
    if functionHere(obj) { return 0 }
    if obj.*.classType != 0 { return moduleOfType(obj.*.classType) }
    if obj.*.body != 0 { return 0 }
    return moduleOfToken(obj.*.token)
}

fn useModule(name: u32) -> void {
    var k: usize = 0
    while k < usedModuleCount {
        if usedModules[k] == name { return }
        k += 1
    }
    if usedModuleCount >= MAX_MODULES { return }
    usedModules[usedModuleCount] = name
    usedModuleCount += 1
}

// ---------------------------------------------------------------------------
// One program of many units
//
// A unit translated on its own carries along what its headers define: a
// record, an inline function, a template's instance are written in every
// unit that uses them, a type of its own in each. For one program every
// such thing has one home. The units are translated twice:
//
// 1. `--emit-mlx-unit=NAME --emit-mlx-index=FILE`: the unit is translated
//    as ever and every definition it writes is listed in FILE: a record
//    (`R`, full or opaque), a variable (`G`), a function (`F`, with the
//    name it would have alone and with its parameter types, whether it is
//    held back on its own account, and the functions it calls).
// 2. `mlx-cc --lattice-manifest=...` (lattice.mlx) reads the units' lists:
//    a thing's home is the first unit that defines it, its name is unique
//    in its home, and a function is held back when one it calls is, in
//    whatever unit.
// 3. `--emit-mlx-unit=NAME --emit-mlx-manifest=FILE`: the unit is
//    translated again. It walks what it walked before; a definition whose
//    home is another unit is dropped, a name is the manifest's, and what
//    lives elsewhere is named through its home's module (`home.name`).
//
// A thing's key says what it is across the units: a function's and a
// variable's C++ symbol (with the unit before it when it is the unit's
// own: `static`), a record's C++ name.
var unitName: u32 = 0
var indexAt: usize = 0
var indexLength: usize = 0
var manifestAt: usize = 0
var manifestLength: usize = 0
var manifestLoaded = false
var indexText = Buffer.{ .data = 0, .length = 0, .capacity = 0 }

pub fn setUnit(name: []const u8) -> void { unitName = base.intern(name) }

pub fn setIndex(path: []const u8) -> void {
    indexAt = base.keep(path)
    indexLength = path.length
}

pub fn setManifest(path: []const u8) -> void {
    manifestAt = base.keep(path)
    manifestLength = path.length
}

fn wholeProgram() -> bool { return unitName != 0 }

// The keys made so far, by the object's or the type's address.
const KEY_SLOTS: usize = 262144
var keyOwner: [KEY_SLOTS]usize = undefined
var keyId: [KEY_SLOTS]u32 = undefined

fn keySlot(owner: usize) -> usize { return ((owner >> 3) *% 11400714819323198485) >> 46 }

fn functionKey(obj: *ast.Obj) -> u32 {
    const owner = @intFromPtr(obj)
    const slot = keySlot(owner)
    if keyOwner[slot] == owner { return keyId[slot] }
    var id: u32 = 0
    const symbol = if obj.*.linkName != 0 { obj.*.linkName } else { obj.*.name }
    if symbol != 0 {
        var text = emptyBuffer()
        putTo(&text, if obj.*.isFunction { "F:" } else { "G:" })
        if obj.*.isStatic && unitName != 0 {
            putTo(&text, base.nameOf(unitName))
            putTo(&text, "|")
        }
        putTo(&text, base.nameOf(symbol))
        // (A function's static local shares its name with another's.)
        if !obj.*.isFunction && unscopedStatic(obj) {
            putTo(&text, "#")
            putTo(&text, base.decimal(@intCast(u64, staticNumber(obj))))
        }
        id = base.intern(textOf(&text))
    }
    keyOwner[slot] = owner
    keyId[slot] = id
    return id
}

fn recordKey(given: usize) -> u32 {
    const ty = types.unqualified(given)
    const slot = keySlot(ty)
    if keyOwner[slot] == ty { return keyId[slot] }
    var id: u32 = 0
    if types.at(ty).*.name != 0 {
        var text = emptyBuffer()
        putTo(&text, "R:")
        putTo(&text, base.nameOf(types.at(ty).*.name))
        id = base.intern(textOf(&text))
    }
    keyOwner[slot] = ty
    keyId[slot] = id
    return id
}

// The manifest: a table from a key to its home, its name and a flag (a
// function held back, a record written in full).
const MANIFEST_SLOTS: usize = 4194304
var manifestKeys: usize = 0
var manifestHomes: usize = 0
var manifestNames: usize = 0
var manifestFlags: usize = 0

fn manifestSlot(key: u32) -> usize {
    var slot = (@intCast(usize, key) *% 2654435761) & (MANIFEST_SLOTS - 1)
    while base.get32(manifestKeys + slot * 4) != 0 && base.get32(manifestKeys + slot * 4) != key { slot = (slot + 1) & (MANIFEST_SLOTS - 1) }
    return slot
}

// A key's entry (its slot and one), 0 for none.
fn entryOf(key: u32) -> usize {
    if !manifestLoaded || key == 0 { return 0 }
    const slot = manifestSlot(key)
    return if base.get32(manifestKeys + slot * 4) == key { slot + 1 } else { 0 }
}

fn entryHome(entry: usize) -> u32 { return base.get32(manifestHomes + (entry - 1) * 4) }
fn entryName(entry: usize) -> u32 { return base.get32(manifestNames + (entry - 1) * 4) }
fn entryFlag(entry: usize) -> bool { return base.get8(manifestFlags + (entry - 1)) & 1 != 0 }

fn functionEntry(obj: *ast.Obj) -> usize {
    if !manifestLoaded { return 0 }
    return entryOf(functionKey(obj))
}

fn recordEntry(ty: usize) -> usize {
    if !manifestLoaded || ty == 0 { return 0 }
    return entryOf(recordKey(ty))
}

// Whether an entry's home is another unit.
fn elsewhere(entry: usize) -> bool { return entry != 0 && entryHome(entry) != unitName }

fn putHomePrefix(entry: usize) -> void {
    if elsewhere(entry) { putModulePrefix(entryHome(entry)) }
}

fn loadManifest() -> void {
    manifestLoaded = true
    manifestKeys = base.alloc(MANIFEST_SLOTS * 4)
    manifestHomes = base.alloc(MANIFEST_SLOTS * 4)
    manifestNames = base.alloc(MANIFEST_SLOTS * 4)
    manifestFlags = base.alloc(MANIFEST_SLOTS)
    var k: usize = 0
    while k < MANIFEST_SLOTS {
        base.put32(manifestKeys + k * 4, 0)
        base.put8(manifestFlags + k, 0)
        k += 1
    }
    const id = base.readFile(base.bytes(manifestAt, manifestLength))
    if id == 0 {
        base.say("mlx-cc: cannot read the manifest ")
        base.say(base.bytes(manifestAt, manifestLength))
        base.say("\n")
        base.exit(1)
    }
    const text = base.bytes(base.fileData(id), base.fileLength(id))
    var entries: usize = 0
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        // KIND key home name flag, tabs between.
        var fields: [5]usize = undefined
        var count: usize = 0
        var f = at
        fields[0] = at
        while f < end && count < 4 {
            if text[f] == 9 {
                count += 1
                fields[count] = f + 1
            }
            f += 1
        }
        if count == 4 && entries < MANIFEST_SLOTS / 2 {
            // (A record another unit has too, made differently: listed as
            // `R:name|unit`. It is this unit's record of the name when the
            // unit is this one, whatever the line of the plain name says.)
            var keyEnd = fields[2] - 1
            var own = false
            if text[at] == 82 && unitName != 0 {
                const unit = base.nameOf(unitName)
                if keyEnd - fields[1] > unit.length + 1 && text[keyEnd - unit.length - 1] == 124 && base.same(text[keyEnd - unit.length..keyEnd], unit) {
                    keyEnd = keyEnd - unit.length - 1
                    own = true
                }
            }
            const key = base.intern(text[fields[1]..keyEnd])
            const slot = manifestSlot(key)
            if base.get32(manifestKeys + slot * 4) == key && base.get8(manifestFlags + slot) >= 2 && !own {
                at = end + 1
                continue
            }
            base.put32(manifestKeys + slot * 4, key)
            base.put32(manifestHomes + slot * 4, base.intern(text[fields[2]..fields[3] - 1]))
            base.put32(manifestNames + slot * 4, base.intern(text[fields[3]..fields[4] - 1]))
            base.put8(manifestFlags + slot, (if fields[4] < end && text[fields[4]] == 49 { 1 } else { 0 }) + (if own { 2 } else { 0 }))
            entries += 1
        }
        at = end + 1
    }
}

// The unit's list of what it writes (step 1 above).
fn logText(text: []const u8) -> void { putTo(&indexText, text) }

fn logName(buffer: *Buffer) -> void {
    logText("\t")
    logText(textOf(buffer))
}

// A key's 64 bits (FNV-1a), as the calls name a function in the list.
fn keyHash(key: u32) -> u64 {
    var hash: u64 = 14695981039346656037
    for byte in base.nameOf(key) {
        hash = (hash ^ @intCast(u64, byte)) *% 1099511628211
    }
    return hash
}

fn logHash(hash: u64) -> void {
    var digits: [17]u8 = undefined
    digits[0] = 32
    var k: usize = 0
    while k < 16 {
        const nibble = @intCast(u8, (hash >> @intCast(u6, (15 - k) * 4)) & 15)
        digits[k + 1] = if nibble < 10 { 48 + nibble } else { 87 + nibble }
        k += 1
    }
    logText(digits[0..17])
}

var suffixMode: u8 = 0

fn logFunction(o: usize, held: bool) -> void {
    const obj = ast.obj(o)
    const key = functionKey(obj)
    if indexLength == 0 || key == 0 { return }
    logText("F\t")
    logText(base.nameOf(key))
    const savedOut = out
    const savedMode = suffixMode
    out = emptyBuffer()
    suffixMode = 1
    putFunctionNameText(obj)
    var short = out
    out = emptyBuffer()
    suffixMode = 2
    putFunctionNameText(obj)
    var long = out
    out = savedOut
    suffixMode = savedMode
    logName(&short)
    logName(&long)
    logText(if held { "\t1\t" } else { "\t0\t" })
    logCallees(obj.*.body)
    logText("\n")
    if !held { return }
    // What it waits for on its own account (`W`, for the reader of the
    // lists; the manifest does not use it): a type its signature has, a
    // construct, a type it works on by value.
    if signatureIsForeign(obj) {
        logText("W\t")
        logText(base.nameOf(key))
        logText("\tsignature\t")
        logRootCause(lastForeign, 0)
    } else if bodyUnknown(obj.*.body) {
        logText("W\t")
        logText(base.nameOf(key))
        logText("\tconstruct\t")
        logText(base.decimal(@intCast(u64, lastUnknownKind)))
        logText("\tno Mlx for it")
    } else if touchesForeignValue(obj.*.body) {
        logText("W\t")
        logText(base.nameOf(key))
        logText("\tvalue\t")
        logRootCause(lastForeign, 0)
    } else {
        return
    }
    logText("\n")
}

// The record a foreign record is foreign for: the first member that is
// not translated, followed down to one that is so on its own account,
// with why.
fn logRootCause(given: usize, depth: usize) -> void {
    const ty = types.unqualified(given)
    const t = types.at(ty)
    const lambda = t.*.name != 0 && startsWith(lastComponent(base.nameOf(t.*.name)), "__lambda")
    const library = isStdRecord(ty) && t.*.name != 0 && !containsText(base.nameOf(t.*.name), "<")
    if depth < 12 && t.*.members != 0 && !hasVirtualBase(ty) && !lambda && !library {
        var m = t.*.members
        while m != 0 {
            var member = types.member(m).*.ty
            while types.at(member).*.kind == types.ARRAY { member = types.at(member).*.base }
            if isStdArray(member) {
                member = stdArrayType(member)
                while types.at(member).*.kind == types.ARRAY { member = types.at(member).*.base }
            }
            if isRecordKind(types.at(member).*.kind) && !isStdArray(member) && !memberTypeTranslated(member, 0) {
                logRootCause(member, depth + 1)
                return
            }
            m = types.member(m).*.next
        }
    }
    logText(if t.*.name != 0 { base.nameOf(t.*.name) } else { "(unnamed)" })
    logText("\t")
    if lambda {
        logText("a lambda's closure")
    } else if hasVirtualBase(ty) {
        logText("a virtual base")
    } else if library {
        logText("the library's class")
    } else if t.*.members == 0 && t.*.incomplete {
        logText("incomplete here")
    } else if t.*.kind == types.UNION {
        logText("a union")
    } else {
        logText("its members translate, the record does not")
    }
}

fn logRecord(ty: usize, full: bool) -> void {
    const key = recordKey(ty)
    if indexLength == 0 || key == 0 { return }
    logText("R\t")
    logText(base.nameOf(key))
    const savedOut = out
    out = emptyBuffer()
    putTypeName(ty)
    var name = out
    out = savedOut
    logName(&name)
    logText(if full { "\t1\t" } else { "\t0\t" })
    // (What the record is made of, as a number: two records of one name
    // that differ, flex's `yyguts_t` in each scanner, are two.)
    logHash(if full { recordPrint(ty) } else { 0 })
    logText("\n")
}

// A record's make-up as a number: its size and each member's name, place
// and size.
fn recordPrint(ty: usize) -> u64 {
    const t = types.at(ty)
    var hash: u64 = 14695981039346656037
    hash = (hash ^ @bitCast(u64, t.*.size)) *% 1099511628211
    var m = t.*.members
    while m != 0 {
        const member = types.member(m)
        if member.*.name != 0 {
            for byte in base.nameOf(member.*.name) {
                hash = (hash ^ @intCast(u64, byte)) *% 1099511628211
            }
        }
        hash = (hash ^ @bitCast(u64, member.*.offset)) *% 1099511628211
        hash = (hash ^ @bitCast(u64, member.*.bitWidth)) *% 1099511628211
        hash = (hash ^ @bitCast(u64, types.at(member.*.ty).*.size)) *% 1099511628211
        // The member's type as it is named (flex's `YYSTYPE *yylval_r`
        // is a pointer to another type in each scanner). The number of
        // an unnamed record is the unit's own count: left out.
        // (A pointer to a function is one whatever its parameters are
        // written as: a `const std::array<uint8_t, 20> &` is `[20]u8`
        // where <array> was read and a record only declared where it
        // was not, in one and the same record.)
        var pointed = member.*.ty
        while pointed != 0 && (types.at(pointed).*.kind == types.PTR || types.at(pointed).*.kind == types.ARRAY) { pointed = types.at(pointed).*.base }
        if pointed != 0 && types.at(pointed).*.kind == types.FUNC {
            hash = (hash ^ 102) *% 1099511628211
            m = member.*.next
            continue
        }
        const savedOut = out
        const savedNaming = namingSuffix
        const savedStructs = structCount
        out = emptyBuffer()
        namingSuffix = true
        putType(member.*.ty)
        namingSuffix = savedNaming
        structCount = savedStructs
        const text = out
        out = savedOut
        const named = textOf(&text)
        var k: usize = 0
        while k < named.length {
            hash = (hash ^ @intCast(u64, named[k])) *% 1099511628211
            if k + 6 <= named.length && base.same(named[k..k + 6], "__anon") {
                k += 6
                while k < named.length && named[k] >= 48 && named[k] <= 57 { k += 1 }
            } else {
                k += 1
            }
        }
        m = member.*.next
    }
    return if hash == 0 { 1 } else { hash }
}

fn logGlobal(o: usize) -> void {
    const obj = ast.obj(o)
    const key = functionKey(obj)
    if indexLength == 0 || key == 0 { return }
    logText("G\t")
    logText(base.nameOf(key))
    const savedOut = out
    out = emptyBuffer()
    putGlobalName(obj)
    var name = out
    out = savedOut
    logName(&name)
    logText("\n")
}

// The functions a body calls, as callsForeign walks it: what the emitter
// drops is not called, a call it writes itself (std::min, an array's
// size) names no function.
fn logCallees(n: usize) -> void {
    if n == 0 { return }
    const node = ast.node(n)
    if node.*.kind == ast.COND && types.at(node.*.ty).*.kind == types.VOID && (callsOperator(node.*.then) || callsOperator(node.*.els)) {
        logCallees(node.*.cond)
        return
    }
    if node.*.kind == ast.EXPR_STMT && callsOperator(node.*.lhs) { return }
    if node.*.kind == ast.FUNCALL && node.*.lhs != 0 && ast.kindOf(node.*.lhs) == ast.VAR {
        const callee = ast.obj(ast.node(node.*.lhs).*.variable)
        const machinery = callee.*.isConstructor || callee.*.isDestructor || startsWith(base.nameOf(callee.*.name), "operator")
        if callee.*.isFunction && (!machinery || callee.*.classType == 0 || isTranslated(callee.*.classType)) && !isKnownCall(node, callee) {
            const key = functionKey(callee)
            if key != 0 { logHash(keyHash(key)) }
        }
    }
    logCallees(node.*.lhs)
    logCallees(node.*.rhs)
    logCallees(node.*.cond)
    logCallees(node.*.then)
    logCallees(node.*.els)
    logCallees(node.*.init)
    logCallees(node.*.inc)
    var b = node.*.body
    while b != 0 {
        logCallees(b)
        b = ast.node(b).*.next
    }
    var a = node.*.args
    while a != 0 {
        logCallees(a)
        a = ast.node(a).*.next
    }
}

// A definition whose home is another unit: written all the same (what it
// names is walked as before) and dropped. `begin` answers what `end`
// needs back.
const Dropped = struct {
    out: Buffer
    notes: Buffer
    markers: usize
    modules: usize
    active: bool
}

fn beginDropped(entry: usize) -> Dropped {
    var saved = Dropped.{ .out = out, .notes = notes, .markers = markerCount, .modules = usedModuleCount, .active = false }
    if elsewhere(entry) {
        saved.active = true
        out = emptyBuffer()
    }
    return saved
}

fn endDropped(saved: Dropped) -> void {
    if !saved.active { return }
    out = saved.out
    notes = saved.notes
    markerCount = saved.markers
    usedModuleCount = saved.modules
}

fn putModulePrefix(name: u32) -> void {
    useModule(name)
    put(base.nameOf(name))
    putByte(46)
}

// The C library's `FILE` (`_IO_FILE`).
fn isCStream(ty: usize) -> bool {
    const t = types.at(ty)
    if !isRecordKind(t.*.kind) || t.*.name == 0 { return false }
    const name = lastComponent(base.nameOf(t.*.name))
    return base.same(name, "_IO_FILE") || base.same(name, "FILE")
}

// A record's name where it is used: with its module's alias before it.
// (While an overload suffix is written: the type's name alone, the same
// in the module that defines it and in the ones that import it.)
var namingSuffix = false

fn putTypeRef(ty: usize) -> void {
    const module = if namingSuffix { 0 } else { moduleOfType(ty) }
    if module != 0 {
        putModulePrefix(module)
    } else if !namingSuffix {
        putHomePrefix(recordEntry(ty))
    }
    putTypeName(ty)
}

// ---------------------------------------------------------------------------
// Buffers

const Buffer = struct {
    data: usize
    length: usize
    capacity: usize
}

fn emptyBuffer() -> Buffer { return Buffer.{ .data = 0, .length = 0, .capacity = 0 } }

// Where the text goes now (swapped to write a part on its own).
var out = Buffer.{ .data = 0, .length = 0, .capacity = 0 }
// The statements hoisted before the statement being written.
var pre = Buffer.{ .data = 0, .length = 0, .capacity = 0 }
// The notes for the end of the file.
var notes = Buffer.{ .data = 0, .length = 0, .capacity = 0 }
var markerCount: usize = 0
var usesStd = false

fn grow(buffer: *Buffer, more: usize) -> void {
    if buffer.*.length + more <= buffer.*.capacity { return }
    var capacity = if buffer.*.capacity == 0 { 4096 } else { buffer.*.capacity * 2 }
    while capacity < buffer.*.length + more { capacity *= 2 }
    const data = base.alloc(capacity)
    if buffer.*.length > 0 { base.copy(data, buffer.*.data, buffer.*.length) }
    buffer.*.data = data
    buffer.*.capacity = capacity
}

fn putTo(buffer: *Buffer, text: []const u8) -> void {
    grow(buffer, text.length)
    base.putText(buffer.*.data + buffer.*.length, text)
    buffer.*.length += text.length
}

fn textOf(buffer: *const Buffer) -> []const u8 { return base.bytes(buffer.*.data, buffer.*.length) }

fn put(text: []const u8) -> void { putTo(&out, text) }

fn putByte(byte: u8) -> void {
    grow(&out, 1)
    base.put8(out.data + out.length, byte)
    out.length += 1
}

fn putNumber(value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    const bytes: [*]u8 = &digits
    put(bytes[24 - count..24])
}

fn putSigned(value: i64) -> void {
    if value < 0 {
        putByte(45)
        putNumber(@bitCast(u64, 0 -% value))
    } else {
        putNumber(@bitCast(u64, value))
    }
}

fn newline() -> void { putByte(10) }

fn indent(level: usize) -> void {
    var k: usize = 0
    while k < level {
        put("    ")
        k += 1
    }
}

// A mark in place (at a line's end or on a line of its own).
fn marker(text: []const u8) -> void {
    put("// LATTICE: ")
    put(text)
    markerCount += 1
}

// A note for the end of the file (for what is found inside an expression,
// where no comment fits).
fn note(text: []const u8) -> void {
    putTo(&notes, "// LATTICE: ")
    putTo(&notes, text)
    putTo(&notes, "\n")
    markerCount += 1
}

// A double as Mlx reads it back (the whole part, then up to 17 digits of
// the fraction, trailing zeros dropped).
fn putFloat(bits: u64) -> void {
    const value = @bitCast(f64, bits)
    if value != value {
        put("0.0")
        note("a NaN constant")
        return
    }
    var v = value
    if v < 0.0 {
        putByte(45)
        v = 0.0 - v
    }
    if v > 1000000000000000000.0 {
        put("1000000000000000000.0")
        note("a floating constant beyond the printer's range")
        return
    }
    const floored = @floor(v)
    const whole = @intFromFloat(u64, floored)
    putNumber(whole)
    putByte(46)
    var fraction = v - floored
    var digits: [20]u8 = undefined
    var count: usize = 0
    while count < 17 {
        fraction = fraction * 10.0
        const f = @floor(fraction)
        const d = @intFromFloat(u64, f)
        digits[count] = @intCast(u8, 48 + d)
        fraction = fraction - f
        count += 1
    }
    while count > 1 && digits[count - 1] == 48 { count -= 1 }
    const p: [*]u8 = &digits
    put(p[0..count])
}

// ---------------------------------------------------------------------------
// Names

fn isIdentByte(byte: u8) -> bool {
    return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
}

// Mlx's keywords and the names the translation itself uses, and the
// sibling modules' aliases (not this unit's own name: a unit does not
// import itself, and its records keep their names).
fn isReserved(text: []const u8) -> bool {
    if isKeyword(text) { return true }
    if mainUnitName != 0 && base.same(text, base.nameOf(mainUnitName)) { return false }
    return isUnitName(text)
}

fn isKeyword(text: []const u8) -> bool {
    const words = [38][]const u8{ "fn", "const", "var", "if", "else", "while", "for", "in", "return", "break", "continue", "match", "struct", "enum", "union", "error", "try", "defer", "errdefer", "pub", "export", "inline", "noinline", "comptime", "test", "type", "unsafe", "null", "undefined", "true", "false", "self", "Self", "packed", "extern", "threadlocal", "noreturn", "anytype" }
    for word in words {
        if base.same(text, word) { return true }
    }
    // (The types' names: a C local named `i32` would shadow the type.)
    const typeNames = [21][]const u8{ "u8", "u16", "u32", "u64", "u128", "i8", "i16", "i32", "i64", "i128", "f32", "f64", "usize", "isize", "bool", "void", "anyopaque", "std", "c", "math", "libcpp" }
    for name in typeNames {
        if base.same(text, name) { return true }
    }
    return false
}

fn putIdentText(text: []const u8) -> void {
    for byte in text {
        putByte(if isIdentByte(byte) { byte } else { 95 })
    }
    if isReserved(text) { putByte(95) }
}

fn ident(id: u32) -> void {
    if id == 0 {
        put("anonymous")
        return
    }
    putIdentText(base.nameOf(id))
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && base.same(text[0..prefix.length], prefix)
}

// The part of a qualified name after its last `::`.
fn lastComponent(text: []const u8) -> []const u8 {
    var start: usize = 0
    var k: usize = 0
    while k + 1 < text.length {
        if text[k] == 58 && text[k + 1] == 58 { start = k + 2 }
        k += 1
    }
    return text[start..text.length]
}

// (A record's name is the same in the module that defines it and after
// the module's alias in the ones that import it: only the keywords are
// avoided, not the aliases.)
fn putTypeName(ty: usize) -> void {
    const name = types.at(ty).*.name
    if name == 0 {
        put("Anonymous")
        return
    }
    if !namingSuffix {
        const known = recordEntry(ty)
        if known != 0 {
            put(base.nameOf(entryName(known)))
            return
        }
    }
    // The qualified name, `::` as `_` (gl::Context is gl_Context beside
    // egl_Context, a nested record carries its class), without the
    // library's `std` and the anonymous namespaces.
    const text = base.nameOf(name)
    var from: usize = 0
    var depth: usize = 0
    var written: usize = 0
    var anonymous = false
    var k: usize = 0
    while k <= text.length {
        const atEnd = k == text.length
        if !atEnd && text[k] == 60 { depth += 1 }
        if !atEnd && text[k] == 62 && depth > 0 { depth -= 1 }
        const separator = !atEnd && depth == 0 && k + 1 < text.length && text[k] == 58 && text[k + 1] == 58
        if atEnd || separator {
            const component = text[from..k]
            const unnamed = !atEnd && (component.length == 0 || component[0] == 40 || startsWith(component, "_GLOBAL__N_") || startsWith(component, "<anonymous"))
            if unnamed { anonymous = true }
            const skipped = unnamed || (!atEnd && base.same(component, "std"))
            if !skipped {
                if written > 0 { putByte(95) }
                for byte in component {
                    putByte(if isIdentByte(byte) { byte } else { 95 })
                }
                written += 1
            }
            if atEnd { break }
            k += 2
            from = k
            continue
        }
        k += 1
    }
    if written == 1 && isKeyword(text[from..text.length]) { putByte(95) }
    if anonymous && isFreeFunctionName(text[from..text.length]) {
        putByte(95)
    } else if written == 1 && isCFunctionName(text[from..text.length]) {
        putByte(95)
    }
}

// The scope of a function or variable outside a class, from its C++
// symbol (`_ZN2gl12IsOpaqueTypeEj`: `gl_`), as putTypeName writes a
// record's: gl::IsOpaqueType is gl_IsOpaqueType beside sh_IsOpaqueType,
// a class's static member carries the class. Nothing for a C name, the
// library's `std`, an anonymous namespace.
fn putScopePrefix(obj: *ast.Obj) -> void {
    if obj.*.linkName == 0 { return }
    const text = base.nameOf(obj.*.linkName)
    if !startsWith(text, "_ZN") { return }
    var at: usize = 3
    if at < text.length && text[at] == 75 { at += 1 }
    while at < text.length && text[at] >= 48 && text[at] <= 57 {
        var length: usize = 0
        while at < text.length && text[at] >= 48 && text[at] <= 57 {
            length = length * 10 + @intCast(usize, text[at] - 48)
            at += 1
        }
        if at + length > text.length { break }
        const component = text[at..at + length]
        at += length
        // (The last component is the entity's own name.)
        const more = at < text.length && text[at] >= 48 && text[at] <= 57
        if !more { break }
        if base.same(component, "std") || startsWith(component, "_GLOBAL__N_") { continue }
        for byte in component {
            putByte(if isIdentByte(byte) { byte } else { 95 })
        }
        putByte(95)
    }
}

// A global variable's name: its scope, then its own. A function's static
// local has no scope in its symbol: the second of a name in the unit is
// `name_2`, the third `name_3` (kDistance in four functions).
// (Two tables with open addressing: a variable's number by the variable,
// and how many of a name were numbered.)
const STATIC_SLOTS: usize = 131072
const MAX_STATICS: usize = 98304
var staticObjects: [STATIC_SLOTS]usize = undefined
var staticNumbers: [STATIC_SLOTS]u32 = undefined
var staticNames: [STATIC_SLOTS]u32 = undefined
var staticSeen: [STATIC_SLOTS]u32 = undefined
var staticCount: usize = 0

fn clearStatics() -> void {
    var k: usize = 0
    while k < STATIC_SLOTS {
        staticObjects[k] = 0
        staticNames[k] = 4294967295
        staticSeen[k] = 0
        k += 1
    }
    staticCount = 0
}

fn staticNumber(obj: *ast.Obj) -> u32 {
    const identity = @intFromPtr(obj)
    var slot = ((identity >> 4) *% 2654435761) % STATIC_SLOTS
    while staticObjects[slot] != 0 && staticObjects[slot] != identity { slot = (slot + 1) % STATIC_SLOTS }
    if staticObjects[slot] == identity { return staticNumbers[slot] }
    if staticCount >= MAX_STATICS {
        listsFull = true
        return 0
    }
    // (An unnamed variable's name is 0: a name like another.)
    var named = (@intCast(usize, obj.*.name) *% 2654435761) % STATIC_SLOTS
    while staticNames[named] != 4294967295 && staticNames[named] != obj.*.name { named = (named + 1) % STATIC_SLOTS }
    staticNames[named] = obj.*.name
    const same = staticSeen[named]
    staticSeen[named] = same + 1
    staticObjects[slot] = identity
    staticNumbers[slot] = same
    staticCount += 1
    return same
}

// A static variable whose symbol carries no scope (a function's static
// local, a file's static outside the namespaces).
fn unscopedStatic(obj: *ast.Obj) -> bool {
    if obj.*.isTable || obj.*.isFunction || obj.*.isLiteral { return false }
    // (A variable without a name, a static local's guard, the array
    // under an initializer list: `anonymous`, `anonymous_2`, each its
    // own.)
    if obj.*.name == 0 { return !obj.*.isLocal }
    if obj.*.linkName != 0 && startsWith(base.nameOf(obj.*.linkName), "_ZN") { return false }
    return obj.*.isStatic || (obj.*.linkName != 0 && startsWith(base.nameOf(obj.*.linkName), "_ZZ"))
}

fn putGlobalName(obj: *ast.Obj) -> void {
    const known = functionEntry(obj)
    if known != 0 {
        put(base.nameOf(entryName(known)))
        return
    }
    if !obj.*.isTable { putScopePrefix(obj) }
    ident(obj.*.name)
    if !unscopedStatic(obj) { return }
    const number = staticNumber(obj)
    if number > 0 {
        putByte(95)
        putNumber(@intCast(u64, number) + 1)
    }
}

// The namespaces of a mangled name (`_ZN2gl3fooEv`: gl), written as a
// comment; nothing for a plain C name.
fn putNamespaceComment(obj: *ast.Obj) -> void {
    if obj.*.linkName == 0 { return }
    const text = base.nameOf(obj.*.linkName)
    if !startsWith(text, "_ZN") { return }
    var at: usize = 3
    if at < text.length && text[at] == 75 { at += 1 }
    var written = false
    while at < text.length && text[at] >= 48 && text[at] <= 57 {
        var length: usize = 0
        while at < text.length && text[at] >= 48 && text[at] <= 57 {
            length = length * 10 + @intCast(usize, text[at] - 48)
            at += 1
        }
        if at + length > text.length { break }
        const component = text[at..at + length]
        at += length
        // The last component is the function's own name.
        const more = at < text.length && text[at] >= 48 && text[at] <= 57
        if !more { break }
        if !written {
            put("// namespace ")
            written = true
        } else {
            put("::")
        }
        put(if startsWith(component, "_GLOBAL__N_") { "(anonymous)" } else { component })
    }
    if written { newline() }
}

// A function of the C++ standard library (`std::` mangled: _ZSt, _ZNSt, _ZN3std).
fn isStdFunction(obj: *ast.Obj) -> bool {
    if obj.*.linkName == 0 { return false }
    const text = base.nameOf(obj.*.linkName)
    return startsWith(text, "_ZSt") || startsWith(text, "_ZNSt") || startsWith(text, "_ZN3std")
}

// ---------------------------------------------------------------------------
// Types

fn isIntKind(kind: u8) -> bool {
    return kind == types.CHAR || kind == types.SHORT || kind == types.INT || kind == types.LONG || kind == types.ENUM
}

fn isFloatKind(kind: u8) -> bool {
    return kind == types.FLOAT || kind == types.DOUBLE || kind == types.LDOUBLE
}

fn isRecordKind(kind: u8) -> bool { return kind == types.STRUCT || kind == types.UNION }

// A C integer as the Mlx one of its width and sign; a plain `char` as
// u8 (Mlx's strings are bytes; `signed char` stays i8).
// Whether an integer type is unsigned as the Mlx writes it (a plain
// `char` is u8).
fn writtenUnsigned(t: *types.Type) -> bool {
    return t.*.unsigned || (t.*.kind == types.CHAR && !t.*.signedChar && t.*.charKind == 0)
}

fn putIntType(t: *types.Type) -> void {
    if t.*.kind == types.CHAR && !t.*.signedChar && t.*.charKind == 0 {
        put("u8")
        return
    }
    putByte(if t.*.unsigned { 117 } else { 105 })
    putNumber(@intCast(u64, t.*.size * 8))
}

// Whether two types are the same in shape (two records of `int *` are
// two addresses in the arena).
fn sameType(a: usize, b: usize) -> bool {
    if a == b { return true }
    if a == 0 || b == 0 { return false }
    const ta = types.at(a)
    const tb = types.at(b)
    if ta.*.kind != tb.*.kind || ta.*.unsigned != tb.*.unsigned || ta.*.size != tb.*.size { return false }
    const kind = ta.*.kind
    if kind == types.PTR || kind == types.REF || kind == types.ARRAY { return sameType(ta.*.base, tb.*.base) }
    if isRecordKind(kind) { return ta.*.name != 0 && ta.*.name == tb.*.name }
    if kind == types.FUNC { return false }
    return true
}

// The record a va_list is one of (the front end's, System V's
// `__va_list_tag`): the runtime's `c.VaList` in the Mlx. A function with
// `...` takes the arguments after its named ones as the words of a last
// parameter, `va_arguments: []const u64`, which va_start hands to the
// list (the runtime module says how a word is an argument).
var vaRecord: usize = 0

pub fn setVaList(list: usize) -> void {
    vaRecord = if list != 0 { types.at(list).*.base } else { 0 }
}

fn isVaRecord(ty: usize) -> bool {
    return vaRecord != 0 && ty != 0 && (ty == vaRecord || types.unqualified(ty) == vaRecord)
}

// A va_list named (an array of one record, or a parameter: the pointer
// to it), as the pointer the runtime's functions take.
fn emitVaPointer(list: usize) -> void {
    if ast.typeOf(list) != 0 && types.at(ast.typeOf(list)).*.kind == types.ARRAY {
        putByte(38)
        emitLvalue(list)
        put("[0]")
    } else {
        emitExpr(list)
    }
}

// va_arg(list, T): the next word as a T.
fn emitVaArg(n: usize) -> void {
    const node = ast.node(n)
    const target = types.at(node.*.ty).*.base
    const t = types.at(target)
    usesRuntime = true
    if t.*.kind == types.PTR {
        put("unsafe { @ptrFromInt(")
        putType(target)
        put(", @intCast(usize, c.va_arg(")
        emitVaPointer(node.*.lhs)
        put("))) }")
    } else if isFloatKind(t.*.kind) {
        put("@bitCast(f64, c.va_arg(")
        emitVaPointer(node.*.lhs)
        put("))")
    } else if t.*.kind == types.BOOL {
        put("(c.va_arg(")
        emitVaPointer(node.*.lhs)
        put(") != 0)")
    } else if t.*.unsigned {
        put("@intCast(")
        putType(target)
        put(", c.va_arg(")
        emitVaPointer(node.*.lhs)
        put("))")
    } else {
        put("@intCast(")
        putType(target)
        put(", @bitCast(i64, c.va_arg(")
        emitVaPointer(node.*.lhs)
        put(")))")
    }
}

// Whether va_arg's type is one a word holds.
fn vaArgTranslates(n: usize) -> bool {
    const target = types.at(ast.node(n).*.ty).*.base
    if target == 0 { return false }
    const t = types.at(target)
    return t.*.kind == types.PTR || t.*.kind == types.DOUBLE || t.*.kind == types.BOOL || isIntKind(t.*.kind)
}

// An argument as a word of the variable arguments.
fn putVaWord(argument: usize) -> void {
    const t = types.at(ast.typeOf(argument))
    if t.*.kind == types.PTR || t.*.kind == types.REF || t.*.kind == types.ARRAY {
        if ast.kindOf(uncast(argument)) == ast.NUM {
            put("0")
            return
        }
        put("@intCast(u64, @intFromPtr(")
        emitExpr(argument)
        put("))")
    } else if isFloatKind(t.*.kind) {
        put("@bitCast(u64, ")
        putAsDouble(argument)
        putByte(41)
    } else if t.*.kind == types.BOOL {
        usesRuntime = true
        put("c.va_bool(")
        emitExpr(argument)
        putByte(41)
    } else if t.*.unsigned {
        put("@intCast(u64, ")
        emitExpr(argument)
        putByte(41)
    } else {
        put("@bitCast(u64, @intCast(i64, ")
        emitExpr(argument)
        put("))")
    }
}

fn vaWordTranslates(argument: usize) -> bool {
    if ast.typeOf(argument) == 0 { return false }
    const t = types.at(ast.typeOf(argument))
    return t.*.kind == types.PTR || t.*.kind == types.REF || t.*.kind == types.ARRAY || isFloatKind(t.*.kind) || t.*.kind == types.BOOL || isIntKind(t.*.kind)
}

// The arguments from `first` on as the words: `[_]u64{ a, b }[0..2]`.
fn emitVaWords(first: usize) -> void {
    put("[_]u64{ ")
    var count: u64 = 0
    var a = first
    while a != 0 {
        if count > 0 { put(", ") }
        putVaWord(a)
        count += 1
        a = ast.node(a).*.next
    }
    if count == 0 { put("0") }
    put(" }[0..")
    putNumber(count)
    putByte(93)
}

// The C library's functions with `...` the runtime has.
fn isRuntimeVariadic(name: []const u8) -> bool {
    return base.same(name, "printf") || base.same(name, "fprintf") || base.same(name, "snprintf") || base.same(name, "sprintf") || base.same(name, "sscanf") || base.same(name, "syscall") || base.same(name, "fcntl")
}

// Whether a function with `...` takes the words in the Mlx: one of the
// program (a C++ function, or a C one with its body here), or the
// runtime's. Another C function's variable arguments have no Mlx.
fn takesWords(obj: *ast.Obj) -> bool {
    if !obj.*.isFunction || !types.at(obj.*.ty).*.variadic { return false }
    return obj.*.body != 0 || !isCFunction(obj) || isRuntimeVariadic(base.nameOf(obj.*.name))
}

// The function type a call calls (through a pointer too), 0 unknown.
fn calledType(call: usize) -> usize {
    const callee = ast.node(call).*.lhs
    if callee == 0 { return 0 }
    if ast.kindOf(callee) == ast.VAR && ast.obj(ast.node(callee).*.variable).*.isFunction { return ast.obj(ast.node(callee).*.variable).*.ty }
    var called = ast.typeOf(callee)
    if called == 0 { return 0 }
    if types.at(called).*.kind == types.PTR && types.at(called).*.base != 0 { called = types.at(called).*.base }
    return if types.at(called).*.kind == types.FUNC { called } else { 0 }
}

// Whether a call hands its arguments after the named ones over as words.
fn packsArguments(call: usize) -> bool {
    const called = calledType(call)
    if called == 0 || !types.at(called).*.variadic { return false }
    const callee = ast.node(call).*.lhs
    if ast.kindOf(callee) == ast.VAR && ast.obj(ast.node(callee).*.variable).*.isFunction { return takesWords(ast.obj(ast.node(callee).*.variable)) }
    return true
}

// The first of a call's arguments after the named ones (0: none given).
fn firstVariableArgument(call: usize) -> usize {
    var param = types.at(calledType(call)).*.params
    var a = ast.node(call).*.args
    while a != 0 && param != 0 {
        a = ast.node(a).*.next
        param = types.param(param).*.next
    }
    return a
}

// Whether a pointer to `target` is written `const` in the Mlx (putPointer:
// a scalar's and a byte's const stays, a record's and a pointer's does
// not).
// Whether two pointers' targets, pointers themselves, lead to targets
// the Mlx writes with a different const.
fn constDiffersBelow(a: usize, b: usize) -> bool {
    var x = a
    var y = b
    while x != 0 && y != 0 && types.at(x).*.kind == types.PTR && types.at(y).*.kind == types.PTR {
        x = types.at(x).*.base
        y = types.at(y).*.base
        if x == 0 || y == 0 { return false }
        if writesConst(x) != writesConst(y) { return true }
    }
    return false
}

fn writesConst(target: usize) -> bool {
    if target == 0 { return false }
    const t = types.at(target)
    return t.*.isConst && !(isRecordKind(t.*.kind) || t.*.kind == types.PTR || t.*.kind == types.REF || t.*.kind == types.FUNC)
}

// A pointer's target kind decides the Mlx pointer: a record `*S`, a
// function `fn`, anything else a many-item pointer `[*]T` (C indexes
// pointers); `optional` for a C pointer (null is a value of it), not for
// `this`, a reference, or the bare type of @ptrFromInt.
fn putPointer(target: usize, optional: bool) -> void {
    const t = types.at(target)
    if optional { putByte(63) }
    if t.*.kind == types.FUNC {
        putType(target)
        return
    }
    if isCStream(target) {
        // A C `FILE *`: an opaque handle the runtime's stdio takes.
        put("*anyopaque")
        return
    }
    putByte(if isRecordKind(t.*.kind) { 42 } else { 91 })
    if !isRecordKind(t.*.kind) { put("*]") }
    // (A pointer to a record is never const in the Mlx: C++'s tree drops
    // and adds the const of objects freely, and Mlx's types would want a
    // cast at each place. A scalar's and a string's const stays. An
    // overload's suffix names the C++ type whole.)
    // (Nor is a pointer to a pointer: `T *const *` and `T **` meet at
    // every iterator.)
    if t.*.isConst && (namingSuffix || !(isRecordKind(t.*.kind) || t.*.kind == types.PTR || t.*.kind == types.REF)) { put("const ") }
    if t.*.kind == types.VOID {
        put("u8")
    } else {
        putType(target)
    }
}

pub fn putType(ty: usize) -> void {
    const t = types.at(ty)
    const kind = t.*.kind
    if isVaRecord(ty) {
        usesRuntime = true
        put("c.VaList")
        return
    }
    noteType(ty)
    if kind == types.VOID {
        put("void")
    } else if kind == types.BOOL {
        put("bool")
    } else if isIntKind(kind) {
        putIntType(t)
    } else if kind == types.FLOAT {
        put("f32")
    } else if kind == types.DOUBLE || kind == types.LDOUBLE {
        put("f64")
    } else if kind == types.PTR {
        putPointer(t.*.base, true)
    } else if kind == types.REF {
        putPointer(t.*.base, false)
    } else if kind == types.ARRAY {
        putByte(91)
        putNumber(@bitCast(u64, if t.*.arrayLength < 0 { 0 } else { t.*.arrayLength }))
        putByte(93)
        putType(t.*.base)
    } else if kind == types.FUNC {
        put("fn(")
        var p = t.*.params
        var first = true
        while p != 0 {
            if !first { put(", ") }
            first = false
            putType(types.param(p).*.ty)
            p = types.param(p).*.next
        }
        if t.*.variadic { put(if first { "[]const u64" } else { ", []const u64" }) }
        put(") -> ")
        putType(t.*.base)
    } else if isRecordKind(kind) && isStdArray(ty) {
        putType(stdArrayType(ty))
    } else if isRecordKind(kind) {
        putTypeRef(ty)
    } else if kind == types.TPARAM {
        put("anytype")
    } else if kind == types.WIDE {
        put("u128")
    } else {
        put("usize")
    }
}

// A bit-field member's own type (`unsigned x : 9` is a u9 of a packed
// struct).
fn putBitFieldType(member: *types.Member) -> void {
    const t = types.at(member.*.ty)
    putByte(if t.*.unsigned || t.*.kind == types.BOOL { 117 } else { 105 })
    putNumber(@bitCast(u64, member.*.bitWidth))
}

// ---------------------------------------------------------------------------
// What the unit mentions: the records, the functions it calls elsewhere

const MAX_LIST: usize = 32768
// (A function's locals.)
const MAX_LOCALS: usize = 32768
// Set when one of the lists is full: said in the notes, the output is
// missing what did not fit.
var listsFull = false

var structList: [MAX_LIST]usize = undefined
var structCount: usize = 0
var externList: [MAX_LIST]usize = undefined
var externCount: usize = 0

fn sameStruct(a: usize, b: usize) -> bool {
    if a == b { return true }
    const na = types.at(a).*.name
    return na != 0 && na == types.at(b).*.name
}

fn noteType(ty: usize) -> void {
    if ty == 0 { return }
    const t = types.at(ty)
    if !isRecordKind(t.*.kind) || isStdArray(ty) || isVaRecord(ty) { return }
    var k: usize = 0
    while k < structCount {
        if sameStruct(structList[k], ty) { return }
        k += 1
    }
    if structCount >= MAX_LIST {
        listsFull = true
        return
    }
    structList[structCount] = ty
    structCount += 1
}

// The headers' variables the functions name (`static const EGLenum
// First...` in a header): written as this file's constants, with their
// values when the headers give them.
var headerGlobalList: [MAX_LIST]usize = undefined
var headerGlobalCount: usize = 0

fn noteHeaderGlobal(o: usize) -> void {
    var k: usize = 0
    while k < headerGlobalCount {
        if headerGlobalList[k] == o { return }
        k += 1
    }
    if headerGlobalCount >= MAX_LIST {
        listsFull = true
        return
    }
    headerGlobalList[headerGlobalCount] = o
    headerGlobalCount += 1
}

fn noteExtern(o: usize) -> void {
    var k: usize = 0
    while k < externCount {
        if externList[k] == o { return }
        k += 1
    }
    if externCount >= MAX_LIST {
        listsFull = true
        return
    }
    externList[externCount] = o
    externCount += 1
}

// The unit's main file (given by the driver: the parser moves state.file()
// through the includes).
var mainFile: u32 = 0

fn inMainFile(token: usize) -> bool {
    if token == 0 { return false }
    return @intCast(u32, tokens.at(token).*.file) == mainFile
}

// A function defined in the main file: its body is there (its object's
// token may be a header's prototype, the first declaration).
// The unit's globals (for the overload check below).
var unitGlobals: usize = 0

// Whether another function of this file has the same name (a C++
// overload): the Mlx name then carries the parameter types.
fn isOverloaded(obj: *ast.Obj) -> bool {
    if !chainsFull && obj.*.name != 0 {
        var entry = firstOfName(obj.*.name)
        while entry != 0 {
            if overloads(ast.obj(chainObj[entry]), obj) { return true }
            entry = chainNextName[entry]
        }
        return false
    }
    var o = unitGlobals
    while o != 0 {
        const other = ast.obj(o)
        if overloads(other, obj) { return true }
        o = other.*.next
    }
    return false
}

// Whether `other` is another function of `obj`'s name beside it.
// (A declaration and its definition have the same type, in two type
// records: compared by their shape. Another namespace's function of the
// name, sh::IsOpaqueType beside gl::IsOpaqueType, is no overload.)
fn overloads(other: *ast.Obj, obj: *ast.Obj) -> bool {
    return other.*.isFunction && other.*.name == obj.*.name && other.*.classType == obj.*.classType && !types.sameType(other.*.ty, obj.*.ty) && @intFromPtr(other) != @intFromPtr(obj) && other.*.isConstructor == obj.*.isConstructor && other.*.isDestructor == obj.*.isDestructor && (sameScope(other, obj) || functionHere(other))
}

// The part of a mangled name before the function's own name segment
// (`_ZN2gl12IsOpaqueTypeEj`: `_ZN2gl`), the scope the function is in;
// the whole name when the segment is not found.
fn scopePrefix(obj: *ast.Obj) -> []const u8 {
    if obj.*.linkName == 0 || obj.*.name == 0 { return "" }
    const text = base.nameOf(obj.*.linkName)
    const name = base.nameOf(obj.*.name)
    if startsWith(name, "operator") {
        // (An operator's own segment is a code, `eq` of operator==: the
        // scope is the names before it, `_ZN3std` of std's, `_Z` outside
        // the namespaces.)
        if !startsWith(text, "_ZN") { return "_Z" }
        var at: usize = 3
        if at < text.length && text[at] == 75 { at += 1 }
        while at < text.length && text[at] >= 48 && text[at] <= 57 {
            var length: usize = 0
            while at < text.length && text[at] >= 48 && text[at] <= 57 {
                length = length * 10 + @intCast(usize, text[at] - 48)
                at += 1
            }
            if at + length > text.length { break }
            at += length
        }
        return text[0..at]
    }
    var digits: [20]u8 = undefined
    var count: usize = 0
    var n = name.length
    while n > 0 {
        digits[count] = @intCast(u8, 48 + n % 10)
        n /= 10
        count += 1
    }
    var k: usize = 0
    while k + count + name.length <= text.length {
        var matches = true
        var d: usize = 0
        while d < count {
            if text[k + d] != digits[count - 1 - d] { matches = false }
            d += 1
        }
        if matches && base.same(text[k + count..k + count + name.length], name) { return text[0..k] }
        k += 1
    }
    return text
}

// Whether two free functions are in the same namespace (methods of one
// class are; a class's scope is its own). (Two of a name this unit
// defines, gl::GetGenericErrorMessage and egl::GetGenericErrorMessage,
// are told apart by their types all the same.)
fn sameScope(a: *ast.Obj, b: *ast.Obj) -> bool {
    if a.*.classType != 0 || b.*.classType != 0 { return true }
    return base.same(scopePrefix(a), scopePrefix(b))
}

// A C++ operator function's Mlx name (`operator==` is `eq`).
fn putOperatorName(text: []const u8) -> void {
    const rest = text[8..text.length]
    const pairs = [26][2][]const u8{ [2][]const u8{ "==", "eq" }, [2][]const u8{ "!=", "ne" }, [2][]const u8{ "<=", "le" }, [2][]const u8{ ">=", "ge" }, [2][]const u8{ "<<", "shl" }, [2][]const u8{ ">>", "shr" }, [2][]const u8{ "+=", "addAssign" }, [2][]const u8{ "-=", "subAssign" }, [2][]const u8{ "*=", "mulAssign" }, [2][]const u8{ "/=", "divAssign" }, [2][]const u8{ "[]", "at" }, [2][]const u8{ "()", "call" }, [2][]const u8{ "<", "lt" }, [2][]const u8{ ">", "gt" }, [2][]const u8{ "+", "add" }, [2][]const u8{ "-", "sub" }, [2][]const u8{ "*", "mul" }, [2][]const u8{ "/", "div" }, [2][]const u8{ "%", "rem" }, [2][]const u8{ "=", "assign" }, [2][]const u8{ "&", "bitAnd" }, [2][]const u8{ "|", "bitOr" }, [2][]const u8{ "^", "bitXor" }, [2][]const u8{ "!", "not" }, [2][]const u8{ "~", "bitNot" }, [2][]const u8{ " bool", "toBool" } }
    for pair in pairs {
        if base.same(rest, pair[0]) {
            put(pair[1])
            return
        }
    }
    put("operator_")
    putIdentText(rest)
}

// The functions' Mlx names, one per object, made unique: two template
// instances whose parameter types read the same in Mlx (`exchange<uint8_t
// *, std::nullptr_t>` and `exchange<uint8_t *, uint8_t *>`) get `_2`,
// `_3`.
// (Two tables with open addressing: a function's name by the function,
// and the names given.)
const FN_NAME_SLOTS: usize = 262144
const FN_NAME_MAX: usize = 196608
var fnNameObj: [FN_NAME_SLOTS]usize = undefined
var fnNameId: [FN_NAME_SLOTS]u32 = undefined
var fnNameGiven: [FN_NAME_SLOTS]u32 = undefined
var fnNameCount: usize = 0

fn clearFunctionNames() -> void {
    var k: usize = 0
    while k < FN_NAME_SLOTS {
        fnNameObj[k] = 0
        fnNameGiven[k] = 0
        k += 1
    }
    fnNameCount = 0
}

fn fnNameSlot(address: usize) -> usize {
    var slot = ((address >> 4) *% 2654435761) % FN_NAME_SLOTS
    while fnNameObj[slot] != 0 && fnNameObj[slot] != address { slot = (slot + 1) % FN_NAME_SLOTS }
    return slot
}

fn fnGivenSlot(id: u32) -> usize {
    var slot = (@intCast(usize, id) *% 2654435761) % FN_NAME_SLOTS
    while fnNameGiven[slot] != 0 && fnNameGiven[slot] != id { slot = (slot + 1) % FN_NAME_SLOTS }
    return slot
}

fn functionNameTaken(id: u32) -> bool {
    return fnNameGiven[fnGivenSlot(id)] == id
}

fn putFunctionName(obj: *ast.Obj) -> void {
    const known = functionEntry(obj)
    if known != 0 {
        put(base.nameOf(entryName(known)))
        return
    }
    const slot = fnNameSlot(@intFromPtr(obj))
    if fnNameObj[slot] == @intFromPtr(obj) {
        put(base.nameOf(fnNameId[slot]))
        return
    }
    const savedOut = out
    out = emptyBuffer()
    putFunctionNameText(obj)
    var text = out
    out = savedOut
    var id = base.intern(textOf(&text))
    var serial: u64 = 2
    while functionNameTaken(id) {
        var longer = emptyBuffer()
        putTo(&longer, textOf(&text))
        putTo(&longer, "_")
        const savedOut2 = out
        out = longer
        putNumber(serial)
        longer = out
        out = savedOut2
        id = base.intern(textOf(&longer))
        serial += 1
    }
    if fnNameCount < FN_NAME_MAX {
        // (The name's text asked for other names: the slot found again.)
        const free = fnNameSlot(@intFromPtr(obj))
        fnNameObj[free] = @intFromPtr(obj)
        fnNameId[free] = id
        fnNameGiven[fnGivenSlot(id)] = id
        fnNameCount += 1
    } else {
        listsFull = true
    }
    put(base.nameOf(id))
}

// The function's Mlx name: its own, with `_T1_T2` (the parameter types,
// their characters made identifier ones) when it is overloaded here.
fn putFunctionNameText(obj: *ast.Obj) -> void {
    const nameStart = out.length
    if obj.*.classType != 0 {
        putTypeName(obj.*.classType)
        putByte(95)
    } else {
        putScopePrefix(obj)
    }
    const scoped = out.length != nameStart
    if obj.*.isConstructor {
        put("init")
    } else if obj.*.isDestructor {
        put("deinit")
    } else if startsWith(base.nameOf(obj.*.name), "operator") {
        putOperatorName(base.nameOf(obj.*.name))
    } else {
        ident(obj.*.name)
        // (A C++ function with a C function's name and no scope written,
        // std::copysign(float, float): apart from the C one's extern.)
        if !scoped && !isCFunction(obj) && isCFunctionName(base.nameOf(obj.*.name)) { putByte(95) }
    }
    if suffixMode == 1 || (suffixMode == 0 && !isOverloaded(obj)) { return }
    if types.at(obj.*.ty).*.constMethod { put("_const") }
    var text = emptyBuffer()
    const savedOut = out
    out = text
    namingSuffix = true
    var p = types.at(obj.*.ty).*.params
    // (A method's `this` is no part of the suffix.)
    if obj.*.classType != 0 && !obj.*.isStaticMember && p != 0 { p = types.param(p).*.next }
    while p != 0 {
        putByte(95)
        putType(types.param(p).*.ty)
        p = types.param(p).*.next
    }
    namingSuffix = false
    text = out
    out = savedOut
    const suffix = textOf(&text)
    var k: usize = 0
    while k < suffix.length {
        putByte(if isIdentByte(suffix[k]) { suffix[k] } else { 95 })
        k += 1
    }
}

fn functionHere(obj: *ast.Obj) -> bool {
    if !obj.*.isFunction || obj.*.body == 0 { return false }
    return inMainFile(ast.node(obj.*.body).*.token) || inMainFile(obj.*.token)
}

fn definedHere(ty: usize) -> bool {
    const m = types.at(ty).*.members
    if m == 0 { return false }
    return inMainFile(types.member(m).*.token)
}

fn putPlace(token: usize) -> void {
    if token == 0 {
        put("?")
        return
    }
    const t = tokens.at(token)
    put(lastComponent(base.nameOf(base.fileName(@intCast(u32, t.*.file)))))
    putByte(58)
    putNumber(@intCast(u64, t.*.line))
}

// ---------------------------------------------------------------------------
// Structs

// A record's bit-fields are kept in words of their own: each run of them
// is a packed struct of 1, 2, 4 or 8 bytes at the bytes the C++ layout
// gives the fields (the member `bitsN`, N its byte offset, of the type
// `Record_bitsN`). The record itself stays an extern struct, its other
// members where C++ has them.
const Word = struct {
    // Its first byte and its bytes (0: the field shares bytes with a
    // neighbour that is no bit-field, no word of its own holds it).
    start: i64
    size: i64
    // Its first member (0: no word).
    first: usize
}

fn sameMember(m: usize, target: usize) -> bool {
    if m == target { return true }
    if target == 0 { return false }
    const a = types.member(m)
    const b = types.member(target)
    return a.*.name != 0 && a.*.name == b.*.name && a.*.offset == b.*.offset && a.*.bitOffset == b.*.bitOffset && a.*.bitWidth == b.*.bitWidth
}

// Where the member after the bit-fields from `m` on starts (the record's
// end when none follows).
fn nextPlainOffset(ty: usize, from: usize) -> i64 {
    var m = from
    while m != 0 {
        const member = types.member(m)
        if member.*.bitWidth == 0 && !(member.*.isBase && types.emptyClass(member.*.ty)) { return member.*.offset }
        m = member.*.next
    }
    return types.size(ty)
}

// The bytes of a word that starts at or before byte `low`, holds the
// bits up to `bitsEnd` and lies between `floor` and `limit`: the smallest
// of `least`, .., 8 that does, 0 for none.
fn fitWord(low: i64, bitsEnd: i64, floor: i64, limit: i64, least: i64) -> i64 {
    var size = least
    while size <= 8 {
        const start = low - low % size
        if start >= floor && (start + size) * 8 >= bitsEnd && start + size <= limit { return size }
        size = size * 2
    }
    return 0
}

// The word the bit-field `target` of `ty` is in.
fn wordOf(ty: usize, target: usize) -> Word {
    const isUnion = types.at(ty).*.kind == types.UNION
    var word = Word.{ .start = 0, .size = 0, .first = 0 }
    var open = false
    var found = false
    var floor: i64 = 0
    var m = types.at(ty).*.members
    while m != 0 {
        const member = types.member(m)
        if member.*.bitWidth > 0 {
            const from = member.*.offset * 8 + member.*.bitOffset
            const to = from + member.*.bitWidth
            const limit = if isUnion { types.size(ty) } else { nextPlainOffset(ty, m) }
            var joined = false
            if open && !isUnion && word.size > 0 {
                if from >= word.start * 8 && to <= (word.start + word.size) * 8 {
                    joined = true
                } else if word.size < 8 {
                    const larger = fitWord(word.start, to, floor, limit, word.size * 2)
                    if larger != 0 {
                        word.start = word.start - word.start % larger
                        word.size = larger
                        joined = true
                    }
                }
            }
            if !joined {
                if found { return word }
                if open && !isUnion && word.start + word.size > floor { floor = word.start + word.size }
                const low = from / 8
                const size = fitWord(low, to, floor, limit, 1)
                word = Word.{ .start = if size == 0 { low } else { low - low % size }, .size = size, .first = m }
                open = true
            }
            if sameMember(m, target) { found = true }
        } else if member.*.bitWidth == 0 && !(member.*.isBase && types.emptyClass(member.*.ty)) {
            if found { return word }
            open = false
            if !isUnion { floor = member.*.offset + types.size(member.*.ty) }
        }
        m = member.*.next
    }
    if found { return word }
    return Word.{ .start = 0, .size = 0, .first = 0 }
}

// A member's place among its record's (a union's unnamed members and
// words are told apart by it: they all start at byte 0).
fn placeOf(ty: usize, target: usize) -> u64 {
    var place: u64 = 0
    var m = types.at(ty).*.members
    while m != 0 {
        if sameMember(m, target) { return place }
        place += 1
        m = types.member(m).*.next
    }
    return place
}

// A word's member name: `bitsN`, N its byte in the object (`base`: where
// the record lies in it, a base class's members being the object's own).
fn putWordName(ty: usize, word: Word, base: i64) -> void {
    put("bits")
    putNumber(@bitCast(u64, base + word.start))
    if types.at(ty).*.kind == types.UNION {
        putByte(95)
        putNumber(placeOf(ty, word.first))
    }
}

fn putWordType(ty: usize, word: Word) -> void {
    putTypeRef(ty)
    putByte(95)
    putWordName(ty, word, 0)
}

// An unnamed member's name (an anonymous union or struct, the table
// pointer): `fieldN`, N its byte in the object; in a union its place.
fn putUnnamed(ty: usize, m: usize, base: i64) -> void {
    put("field")
    if ty != 0 && types.at(ty).*.kind == types.UNION {
        putNumber(placeOf(ty, m))
    } else {
        putNumber(@bitCast(u64, base + types.member(m).*.offset))
    }
}

// The packed structs of a record's words, before the record.
fn emitWords(ty: usize) -> void {
    var m = types.at(ty).*.members
    while m != 0 {
        const member = types.member(m)
        if member.*.bitWidth > 0 {
            const word = wordOf(ty, m)
            if word.first == m && word.size > 0 {
                put("pub const ")
                putTypeName(ty)
                putByte(95)
                putWordName(ty, word, 0)
                put(" = packed struct {\n")
                var bit = word.start * 8
                var k = m
                while k != 0 {
                    const field = types.member(k)
                    if field.*.bitWidth == 0 && !(field.*.isBase && types.emptyClass(field.*.ty)) { break }
                    if field.*.bitWidth > 0 {
                        if wordOf(ty, k).first != m { break }
                        const from = field.*.offset * 8 + field.*.bitOffset
                        if field.*.name != 0 {
                            if from > bit { putUnusedBits(bit - word.start * 8, from - bit) }
                            indent(1)
                            ident(field.*.name)
                            put(": ")
                            putBitFieldType(field)
                            newline()
                            bit = from + field.*.bitWidth
                        }
                    }
                    k = field.*.next
                }
                const end = (word.start + word.size) * 8
                if end > bit { putUnusedBits(bit - word.start * 8, end - bit) }
                put("}\n\n")
            }
        }
        m = member.*.next
    }
}

fn putUnusedBits(at: i64, count: i64) -> void {
    indent(1)
    put("unused")
    putNumber(@bitCast(u64, at))
    put(": u")
    putNumber(@bitCast(u64, count))
    newline()
}

fn emitStruct(ty: usize) -> void {
    logRecord(ty, true)
    const dropped = beginDropped(recordEntry(ty))
    emitStructHere(ty)
    endDropped(dropped)
}

fn emitStructHere(ty: usize) -> void {
    const t = types.at(ty)
    emitWords(ty)
    put("pub const ")
    putTypeName(ty)
    put(if t.*.kind == types.UNION { " = extern union {\n" } else { " = extern struct {\n" })
    putMembers(ty, 0)
    put("}\n\n")
}

// How many members of the base classes of `ty` have the name (a class's
// member of a base's member's name hides it in C++: the two are apart in
// the object, and both are fields of the Mlx record).
fn hiddenMembers(ty: usize, name: u32, depth: usize) -> u64 {
    if ty == 0 || depth > 16 { return 0 }
    var count: u64 = 0
    var m = types.at(ty).*.members
    while m != 0 {
        const member = types.member(m)
        if member.*.isBase {
            const base = types.unqualified(member.*.ty)
            var inner = types.at(base).*.members
            while inner != 0 {
                if !types.member(inner).*.isBase && types.member(inner).*.name == name { count += 1 }
                inner = types.member(inner).*.next
            }
            count += hiddenMembers(base, name, depth + 1)
        }
        m = member.*.next
    }
    return count
}

// A member's field name: its own; `name_2` for a member of the class
// `owner` that a base class of it has too (the second of the name in the
// object), `name_3` under two of them.
fn putFieldName(owner: usize, name: u32) -> void {
    ident(name)
    if owner == 0 { return }
    const hidden = hiddenMembers(types.unqualified(owner), name, 0)
    if hidden > 0 {
        putByte(95)
        putNumber(hidden + 1)
    }
}

// The members of a struct, one a line; a base class's in place (the base
// object comes first in the layout; a virtual base is marked). `base`:
// where the record lies in the object written.
fn putMembers(ty: usize, base: i64) -> void {
    var m = types.at(ty).*.members
    while m != 0 {
        const member = types.member(m)
        if member.*.bitWidth != 0 {
            if member.*.bitWidth > 0 {
                const word = wordOf(ty, m)
                if word.first == m {
                    indent(1)
                    if word.size == 0 {
                        marker("the bit-field ")
                        if member.*.name != 0 { ident(member.*.name) }
                        put(" shares its bytes with a neighbour")
                    } else {
                        putWordName(ty, word, base)
                        put(": ")
                        putWordType(ty, word)
                    }
                    newline()
                }
            }
        } else if member.*.isBase && !member.*.isVirtual && types.at(member.*.ty).*.members != 0 {
            indent(1)
            put("// the base class ")
            putTypeName(member.*.ty)
            put(":\n")
            noteType(member.*.ty)
            putMembers(member.*.ty, base + member.*.offset)
        } else if member.*.isBase {
            indent(1)
            marker("base class ")
            putTypeName(member.*.ty)
            newline()
        } else {
            indent(1)
            if member.*.name == 0 {
                putUnnamed(ty, m, base)
            } else {
                putFieldName(ty, member.*.name)
            }
            put(": ")
            putType(member.*.ty)
            newline()
        }
        m = member.*.next
    }
}

// ---------------------------------------------------------------------------
// Globals

fn readLittle(address: usize, size: i64) -> u64 {
    var value: u64 = 0
    var k: usize = 0
    while k < @intCast(usize, size) && k < 8 {
        value |= @intCast(u64, base.get8(address + k)) << @intCast(u6, k * 8)
        k += 1
    }
    return value
}

// The names of the globals written so far (a declaration and a definition
// of one variable are two objects in the unit's list).
var emittedGlobals: [MAX_LIST]u32 = undefined
var emittedGlobalCount: usize = 0

// Whether global `o` is a declaration of a variable another object in the
// list defines with an initializer, or a repeat of a name written already.
// What tells a global from another: its symbol (two classes' `kShift`
// are two variables), its name where it has none.
fn globalKey(obj: *ast.Obj) -> u32 {
    if obj.*.linkName != 0 { return obj.*.linkName }
    // (A static of a name another has: its own key, as its own name; a
    // variable without a name always.)
    if unscopedStatic(obj) && (staticNumber(obj) > 0 || obj.*.name == 0) {
        var text = emptyBuffer()
        putTo(&text, if obj.*.name == 0 { "anonymous" } else { base.nameOf(obj.*.name) })
        putTo(&text, "#")
        putTo(&text, base.decimal(@intCast(u64, staticNumber(obj))))
        return base.intern(textOf(&text))
    }
    return obj.*.name
}

fn otherDefinition(globals: usize, o: usize) -> bool {
    const obj = ast.obj(o)
    var k: usize = 0
    while k < emittedGlobalCount {
        if emittedGlobals[k] == globalKey(obj) { return true }
        k += 1
    }
    if obj.*.initData != 0 { return false }
    var other = globals
    while other != 0 {
        const candidate = ast.obj(other)
        if other != o && globalKey(candidate) == globalKey(obj) && !candidate.*.isFunction && !candidate.*.isLocal && candidate.*.initData != 0 && inMainFile(candidate.*.token) { return true }
        other = candidate.*.next
    }
    return false
}

// One scalar of a type's bytes as a literal.
fn putScalarData(bits: u64, t: *types.Type) -> void {
    if isFloatKind(t.*.kind) {
        if t.*.size == 4 {
            const narrow = @bitCast(f32, @intCast(u32, bits))
            putFloat(@bitCast(u64, @floatCast(f64, narrow)))
        } else {
            putFloat(bits)
        }
    } else if t.*.kind == types.BOOL {
        put(if bits != 0 { "true" } else { "false" })
    } else if t.*.unsigned {
        putNumber(bits)
    } else {
        const shift = @intCast(u6, 64 - t.*.size * 8)
        putSigned((@bitCast(i64, bits) << shift) >> shift)
    }
}

fn isScalarType(t: *types.Type) -> bool {
    return isIntKind(t.*.kind) || isFloatKind(t.*.kind) || t.*.kind == types.BOOL
}

// Whether a type's initializer bytes can be written as a literal: a
// scalar, or an array (of arrays) of scalars.
fn hasLiteralData(ty: usize) -> bool {
    const t = types.at(ty)
    if isScalarType(t) { return true }
    // (A pointer: null, or what its relocation names.)
    if t.*.kind == types.PTR && t.*.size == 8 { return true }
    if t.*.kind == types.ARRAY && t.*.arrayLength > 0 { return hasLiteralData(t.*.base) }
    if isStdArray(ty) { return hasLiteralData(stdArrayType(ty)) }
    if isRecordKind(t.*.kind) && t.*.kind != types.UNION && isTranslated(ty) {
        var m = t.*.members
        // (A record of nothing, std::nullopt_t: `Name.{}`.)
        if m == 0 { return !t.*.incomplete }
        while m != 0 {
            const member = types.member(m)
            if member.*.isBase {
                // (A base class's members are the record's own: an empty
                // base holds nothing, another's are written in place.)
                if member.*.isVirtual { return false }
                if !types.emptyClass(member.*.ty) && types.at(member.*.ty).*.members != 0 && !hasLiteralData(member.*.ty) { return false }
            } else if member.*.bitWidth != 0 {
                // (A bit-field: in its word, a packed struct of its
                // own; one that shares bytes with a neighbour has none.)
                if member.*.bitWidth > 0 && wordOf(ty, m).size == 0 { return false }
            } else if !hasLiteralData(member.*.ty) {
                // (An unnamed member too: the table pointer, an
                // anonymous struct; an anonymous union is none.)
                return false
            }
            m = member.*.next
        }
        return true
    }
    return false
}

// The initializer bytes at `address` of type `ty` as a literal (an array
// as `[N]T{ ... }`, eight to a line when there are more than eight).
// The object whose initializer is being written: its bytes' start and
// its relocations (the addresses in it: of functions in a vtable, of
// strings and variables in a table of pointers).
var dataBase: usize = 0
var dataRelocations: usize = 0

// A pointer in an initializer: the address a relocation gives it (a
// function's, a string literal's, a variable's), else its word (null, or
// a number a vtable keeps in a slot: an adjustment of `this`).
// A mark owed for the value just written (said after its comma, at the
// end of its line): a function without Mlx, or 1 for an address the
// translator does not write.
var pendingDataMark: usize = 0

fn flushDataMark() -> void {
    if pendingDataMark == 0 { return }
    put("  ")
    if pendingDataMark == 1 {
        marker("an address the translator does not write (an offset into an object)")
    } else {
        marker("no Mlx for ")
        putFunctionName(ast.obj(pendingDataMark))
    }
    pendingDataMark = 0
}

// The deleting destructors the vtables written name.
const MAX_DELETING: usize = 2048
var deletingList: [MAX_DELETING]usize = undefined
var deletingCount: usize = 0

fn noteDeleting(o: usize) -> void {
    var k: usize = 0
    while k < deletingCount {
        if deletingList[k] == o { return }
        k += 1
    }
    if deletingCount >= MAX_DELETING {
        listsFull = true
        return
    }
    deletingList[deletingCount] = o
    deletingCount += 1
}

// `Class_deinit_deleting`: the destructor, then the object freed with the
// class's operator delete (the runtime's for the global one).
fn emitDeleting(o: usize) -> void {
    // (It lives with its destructor.)
    const dropped = beginDropped(functionEntry(ast.obj(ast.obj(o).*.entryOf)))
    emitDeletingHere(o)
    endDropped(dropped)
}

fn emitDeletingHere(o: usize) -> void {
    const obj = ast.obj(o)
    const dtor = ast.obj(obj.*.entryOf)
    put("// the deleting destructor of ")
    putTypeName(obj.*.classType)
    put(" (`delete p` through its table)\npub fn ")
    putFunctionName(dtor)
    put("_deleting(self: *")
    putTypeRef(types.unqualified(obj.*.classType))
    put(") -> void {\n    ")
    putCallee(obj.*.entryOf)
    put("(self)\n    ")
    const freeing = obj.*.entry
    if freeing == 0 || (ast.obj(freeing).*.classType == 0 && ast.obj(freeing).*.body == 0) {
        usesRuntime = true
        put("c.free(unsafe { @ptrCast(?[*]u8, self) })\n")
    } else {
        putCallee(freeing)
        put("(unsafe { @ptrCast(?[*]u8, self) }")
        if obj.*.entryKind == 4 {
            put(", ")
            putNumber(@bitCast(u64, types.at(obj.*.classType).*.size))
        }
        put(")\n")
    }
    put("}\n\n")
}

fn putPointerData(address: usize, ty: usize) -> void {
    const offset = @bitCast(i64, address -% dataBase)
    var r = dataRelocations
    while r != 0 && ast.relocation(r).*.offset != offset { r = ast.relocation(r).*.next }
    const toFunction = types.at(types.at(ty).*.base).*.kind == types.FUNC
    if r == 0 {
        const word = readLittle(address, 8)
        if word == 0 {
            put("null")
        } else {
            put("unsafe { @ptrFromInt(")
            putType(ty)
            put(", ")
            putNumber(word)
            put(") }")
        }
        return
    }
    const o = ast.relocation(r).*.target
    const target = ast.obj(o)
    if target.*.isFunction {
        // A deleting destructor (the entry `delete p` calls through the
        // table): the front end makes it in the code generator; written
        // here from its destructor and its operator delete.
        if target.*.entryKind >= 3 && target.*.entryOf != 0 && !isHeldBack(target.*.entryOf) && (ast.obj(target.*.entryOf).*.body != 0 || moduleOfFunction(ast.obj(target.*.entryOf)) != 0 || functionEntry(ast.obj(target.*.entryOf)) != 0) {
            noteDeleting(o)
            put("unsafe { @ptrCast(")
            putType(ty)
            put(", ")
            putHomePrefix(functionEntry(ast.obj(target.*.entryOf)))
            putFunctionName(ast.obj(target.*.entryOf))
            put("_deleting) }")
            return
        }
        // (A function the Mlx does not have: no address to give.)
        // (In a program of many units a function another unit defines
        // is the manifest's.)
        if isHeldBack(o) || (target.*.body == 0 && moduleOfFunction(target) == 0 && functionEntry(target) == 0) {
            put("null")
            pendingDataMark = o
            return
        }
        // (As the pointer's type where that is no function's, or another
        // function type's: a table of `void (*)()` with every kind of
        // function in it.)
        const plain = toFunction && sameType(types.at(ty).*.base, target.*.ty)
        if !plain {
            put("unsafe { @ptrCast(")
            putType(ty)
            put(", ")
        }
        putCallee(o)
        if !plain { put(") }") }
        return
    }
    if target.*.isLiteral {
        put("unsafe { @ptrCast(")
        putType(ty)
        put(", ")
        putStringLiteral(target)
        put(".pointer) }")
        return
    }
    if target.*.isTable && ast.relocation(r).*.addend == target.*.addressPoint {
        // An object's table pointer: the table's address point.
        put("unsafe { @ptrCast(")
        putType(ty)
        put(", ")
        putTableAddress(o)
        put(") }")
        return
    }
    if target.*.name == 0 {
        put("null")
        pendingDataMark = 1
        return
    }
    if ast.relocation(r).*.addend != 0 {
        // A place inside a variable (`&table[3]`, a member's address):
        // the variable's bytes, that many on.
        if !inMainFile(target.*.token) { noteHeaderGlobal(o) }
        put("unsafe { @ptrCast(")
        putType(ty)
        put(", &unsafe { @ptrCast([*]u8, &")
        putHomePrefix(functionEntry(target))
        putGlobalName(target)
        put(") }[")
        putNumber(@bitCast(u64, ast.relocation(r).*.addend))
        put("]) }")
        return
    }
    if !inMainFile(target.*.token) { noteHeaderGlobal(o) }
    put("unsafe { @ptrCast(")
    putType(ty)
    put(", &")
    putHomePrefix(functionEntry(target))
    putGlobalName(target)
    put(") }")
}

fn putData(address: usize, ty: usize, lvl: usize) -> void {
    const t = types.at(ty)
    if t.*.kind == types.PTR {
        putPointerData(address, ty)
        return
    }
    if isScalarType(t) {
        putScalarData(readLittle(address, t.*.size), t)
        return
    }
    if isStdArray(ty) {
        putData(address, stdArrayType(ty), lvl)
        return
    }
    if isRecordKind(t.*.kind) {
        // `Name.{ .a = ..., .b = ... }`, a member a line.
        putTypeRef(ty)
        put(".{")
        if types.at(ty).*.members != 0 {
            putMemberData(address, ty, lvl, 0)
            newline()
            indent(lvl)
        }
        put("}")
        return
    }
    const count = @intCast(usize, t.*.arrayLength)
    const element = types.at(t.*.base)
    const stride = @intCast(usize, element.*.size)
    putType(ty)
    put("{")
    const long = count > 8 || !isScalarType(element)
    // (Addresses one a line: a mark may follow one.)
    const perLine: usize = if element.*.kind == types.PTR { 1 } else { 8 }
    var k: usize = 0
    while k < count {
        if long && k % perLine == 0 {
            newline()
            indent(lvl + 1)
        } else if k > 0 {
            put(" ")
        }
        putData(address + k * stride, t.*.base, lvl + 1)
        put(",")
        flushDataMark()
        k += 1
    }
    if long {
        newline()
        indent(lvl)
    } else {
        put(" ")
    }
    put("}")
}

// A record's members in a literal, a member a line; a base class's in
// place, as the record's own (`base`: where the record lies in the
// object written). A run of bit-fields is its word's literal.
fn putMemberData(address: usize, ty: usize, lvl: usize, base: i64) -> void {
    var m = types.at(ty).*.members
    while m != 0 {
        const member = types.member(m)
        if member.*.isBase {
            if !types.emptyClass(member.*.ty) && types.at(member.*.ty).*.members != 0 { putMemberData(address + @intCast(usize, member.*.offset), member.*.ty, lvl, base + member.*.offset) }
        } else if member.*.bitWidth != 0 {
            if member.*.bitWidth > 0 {
                const word = wordOf(ty, m)
                if word.first == m && word.size > 0 {
                    newline()
                    indent(lvl + 1)
                    putByte(46)
                    putWordName(ty, word, base)
                    put(" = ")
                    putWordData(address, ty, m, word)
                    put(",")
                }
            }
        } else {
            newline()
            indent(lvl + 1)
            putByte(46)
            if member.*.name == 0 {
                putUnnamed(ty, m, base)
            } else {
                putFieldName(ty, member.*.name)
            }
            put(" = ")
            putData(address + @intCast(usize, member.*.offset), member.*.ty, lvl + 1)
            put(",")
            flushDataMark()
        }
        m = member.*.next
    }
}

// The bits `from` on, `width` of them, of the bytes at `address`.
fn readBits(address: usize, from: i64, width: i64) -> u64 {
    const start = address + @intCast(usize, from / 8)
    const shift = @intCast(u6, from % 8)
    var value = readLittle(start, 8) >> shift
    // (A field that ends beyond the eighth byte.)
    if @intCast(i64, shift) + width > 64 { value |= @intCast(u64, base.get8(start + 8)) << @intCast(u6, 64 - @intCast(u64, shift)) }
    if width < 64 { value &= (@intCast(u64, 1) << @intCast(u6, width)) - 1 }
    return value
}

// A word of bit-fields in a literal: `Record_bitsN.{ .a = 1, .unused3 =
// 0, .b = 2 }`, its fields as emitWords declares them.
fn putWordData(address: usize, ty: usize, first: usize, word: Word) -> void {
    putWordType(ty, word)
    put(".{ ")
    var bit = word.start * 8
    var written = false
    var k = first
    while k != 0 {
        const field = types.member(k)
        if field.*.bitWidth == 0 && !(field.*.isBase && types.emptyClass(field.*.ty)) { break }
        if field.*.bitWidth > 0 {
            if wordOf(ty, k).first != first { break }
            const from = field.*.offset * 8 + field.*.bitOffset
            if field.*.name != 0 {
                if from > bit {
                    if written { put(", ") }
                    put(".unused")
                    putNumber(@bitCast(u64, bit - word.start * 8))
                    put(" = 0")
                    written = true
                }
                if written { put(", ") }
                putByte(46)
                ident(field.*.name)
                put(" = ")
                const bits = readBits(address, from, field.*.bitWidth)
                const ft = types.at(field.*.ty)
                if ft.*.unsigned || ft.*.kind == types.BOOL || field.*.bitWidth >= 64 || (bits >> @intCast(u6, field.*.bitWidth - 1)) & 1 == 0 {
                    putNumber(bits)
                } else {
                    // (A signed field with its top bit set.)
                    putSigned(@bitCast(i64, bits | (~@intCast(u64, 0) << @intCast(u6, field.*.bitWidth))))
                }
                written = true
                bit = from + field.*.bitWidth
            }
        }
        k = field.*.next
    }
    const end = (word.start + word.size) * 8
    if end > bit {
        if written { put(", ") }
        put(".unused")
        putNumber(@bitCast(u64, bit - word.start * 8))
        put(" = 0")
    }
    put(" }")
}

fn holdsRecord(ty: usize) -> bool {
    const t = types.at(ty)
    if t.*.kind == types.ARRAY { return holdsRecord(t.*.base) }
    if isStdArray(ty) { return holdsRecord(stdArrayType(ty)) }
    return isRecordKind(t.*.kind)
}

// The vtables, written after the functions: Mlx reads a constant's
// initializer before the functions declared below it, and a table names
// its class's.
var tablesText: Buffer = undefined

fn emitGlobal(o: usize) -> void {
    logGlobal(o)
    if elsewhere(functionEntry(ast.obj(o))) {
        // (Its home is another unit: written and dropped, what it names
        // walked as before.)
        const dropped = beginDropped(functionEntry(ast.obj(o)))
        emitGlobalText(o)
        endDropped(dropped)
        return
    }
    if ast.obj(o).*.isTable {
        const savedOut = out
        out = tablesText
        emitGlobalText(o)
        tablesText = out
        out = savedOut
        return
    }
    emitGlobalText(o)
}

fn emitGlobalText(o: usize) -> void {
    const obj = ast.obj(o)
    const t = types.at(obj.*.ty)
    if emittedGlobalCount < MAX_LIST {
        emittedGlobals[emittedGlobalCount] = globalKey(obj)
        emittedGlobalCount += 1
    }
    put("// from ")
    putPlace(obj.*.token)
    newline()
    putNamespaceComment(obj)
    // (A constant that is or holds a record is a variable: its address
    // is a plain pointer, as every pointer to a record is. A vtable and
    // an array are variables too: a module-level `var` is static data,
    // one address wherever it is named, which the objects' table
    // pointers and a returned `kTable` need; a `const` aggregate is a
    // value built where it is used.)
    // (A pointer too: `const char *const kMessage` is taken by reference
    // (`const char *const &`), its address kept; and an address is no
    // constant mlx4 folds.)
    const constant = t.*.isConst && !holdsRecord(obj.*.ty) && !obj.*.isTable && t.*.kind != types.ARRAY && t.*.kind != types.PTR && !isStdArray(obj.*.ty) && !obj.*.runtimeInit
    put(if constant { if obj.*.isStatic { "const " } else { "pub const " } } else { if obj.*.isStatic { "var " } else { "pub var " } })
    putGlobalName(obj)
    put(": ")
    putType(obj.*.ty)
    put(" = ")
    if obj.*.initData != 0 && hasLiteralData(obj.*.ty) {
        const savedBase = dataBase
        const savedRelocations = dataRelocations
        dataBase = obj.*.initData
        dataRelocations = obj.*.relocations
        putData(obj.*.initData, obj.*.ty, 0)
        flushDataMark()
        dataBase = savedBase
        dataRelocations = savedRelocations
    } else {
        put("undefined")
        if obj.*.initData != 0 {
            put("  ")
            marker("an initializer the translator does not read yet")
        }
    }
    newline()
    newline()
}

// ---------------------------------------------------------------------------
// Functions: their locals

var localObj: [MAX_LOCALS]usize = undefined
var localName: [MAX_LOCALS]u32 = undefined
var localUsed: [MAX_LOCALS]bool = undefined
var localCount: usize = 0
var scratch: [96]u8 = undefined

// (The locals by their object and the names taken, in tables with open
// addressing: a unit's start has thousands of temporaries. A table's
// entries are of the function whose stamp they carry.)
// (A function's locals in declaration order, while they are bound: a
// module's variable, not a local of the writer, whose frame would take
// its bytes anew for every function written.)
var localOrder: [MAX_LOCALS]usize = undefined
const LOCAL_SLOTS: usize = 131072
var localSlotObj: [LOCAL_SLOTS]usize = undefined
var localSlotIndex: [LOCAL_SLOTS]u32 = undefined
var localSlotStamp: [LOCAL_SLOTS]u32 = undefined
var localNameTaken: [LOCAL_SLOTS]u32 = undefined
var localNameStamp: [LOCAL_SLOTS]u32 = undefined
var localStamp: u32 = 1

// A function's locals begin.
fn resetLocals() -> void {
    localCount = 0
    localStamp += 1
    if localStamp == 0 {
        // (The stamps came round: every entry is stale.)
        var k: usize = 0
        while k < LOCAL_SLOTS {
            localSlotStamp[k] = 0
            localNameStamp[k] = 0
            k += 1
        }
        localStamp = 1
    }
}

fn localSlot(o: usize) -> usize {
    var slot = ((o >> 4) *% 2654435761) % LOCAL_SLOTS
    while localSlotStamp[slot] == localStamp && localSlotObj[slot] != o { slot = (slot + 1) % LOCAL_SLOTS }
    return slot
}

fn nameSlotOfLocal(name: u32) -> usize {
    var slot = (@intCast(usize, name) *% 2654435761) % LOCAL_SLOTS
    while localNameStamp[slot] == localStamp && localNameTaken[slot] != name { slot = (slot + 1) % LOCAL_SLOTS }
    return slot
}

fn nameTaken(name: u32) -> bool {
    return localNameStamp[nameSlotOfLocal(name)] == localStamp
}

// Whether a local of this name would hide a class the module writes
// under the same name: the library's (`const GLchar *const *string`
// beside std::string, written `string`) or one outside every namespace.
fn hidesClass(name: u32) -> bool {
    if className[classSlot(name)] == name { return true }
    const text = base.nameOf(name)
    if text.length > 80 { return false }
    const prefix = "std::"
    var at: usize = 0
    for byte in prefix {
        scratch[at] = byte
        at += 1
    }
    for byte in text {
        scratch[at] = byte
        at += 1
    }
    const p: [*]u8 = &scratch
    const full = base.intern(p[0..at])
    return className[classSlot(full)] == full
}

// A local's name in the Mlx: its own, made unique when another local of
// the function has it (C scopes, flattened) or a class the module names
// does, or made up for a temporary.
fn bindLocal(o: usize) -> u32 {
    const obj = ast.obj(o)
    var name = obj.*.name
    if name == 0 || nameTaken(name) || hidesClass(name) {
        const text = if name == 0 { "tmp" } else { base.nameOf(name) }
        var at: usize = 0
        var k: usize = 0
        while k < text.length && at < 80 {
            scratch[at] = if isIdentByte(text[k]) { text[k] } else { 95 }
            at += 1
            k += 1
        }
        scratch[at] = 95
        at += 1
        var digits: [20]u8 = undefined
        var count: usize = 0
        var rest = localCount
        while true {
            digits[19 - count] = @intCast(u8, 48 + rest % 10)
            count += 1
            rest = rest / 10
            if rest == 0 { break }
        }
        var d: usize = 20 - count
        while d < 20 {
            scratch[at] = digits[d]
            at += 1
            d += 1
        }
        const p: [*]u8 = &scratch
        name = base.intern(p[0..at])
    }
    if localCount < MAX_LOCALS {
        localObj[localCount] = o
        localName[localCount] = name
        localUsed[localCount] = false
        const slot = localSlot(o)
        localSlotObj[slot] = o
        localSlotIndex[slot] = @intCast(u32, localCount)
        localSlotStamp[slot] = localStamp
        const taken = nameSlotOfLocal(name)
        localNameTaken[taken] = name
        localNameStamp[taken] = localStamp
        localCount += 1
    } else {
        listsFull = true
    }
    return name
}

// Whether the object is a local bound in the function being written (a
// temporary of the unit's start is one, whatever the front end says of
// its storage).
fn isBoundLocal(o: usize) -> bool {
    const slot = localSlot(o)
    return localSlotStamp[slot] == localStamp && localSlotObj[slot] == o
}

fn putLocal(o: usize) -> void {
    const slot = localSlot(o)
    if localSlotStamp[slot] == localStamp && localSlotObj[slot] == o {
        const k = @intCast(usize, localSlotIndex[slot])
        localUsed[k] = true
        ident(localName[k])
        return
    }
    ident(ast.obj(o).*.name)
}

// A function's parameters are cells of (object, next); its locals an
// object list (the parameters among them).
// The parameter object behind a hidden pointer parameter (a class C++
// passes by its address): the local stored where the pointer points; 0
// when `hidden` is no such pointer.
fn indirectParameter(function: *ast.Obj, hidden: usize) -> usize {
    const pointer = ast.obj(hidden)
    if pointer.*.name != 0 || pointer.*.isResultBuffer || types.at(pointer.*.ty).*.kind != types.PTR { return 0 }
    var l = function.*.locals
    while l != 0 {
        const local = ast.obj(l)
        if local.*.storedAt == hidden && local.*.name != 0 && !local.*.isResultBuffer { return l }
        l = local.*.next
    }
    return 0
}

fn isTakenByValue(function: *ast.Obj, o: usize) -> bool {
    const at = ast.obj(o).*.storedAt
    return at != 0 && isParam(function, at) && indirectParameter(function, at) == o
}

fn isParam(function: *ast.Obj, o: usize) -> bool {
    var c = function.*.params
    while c != 0 {
        if base.getWord(c) == o { return true }
        c = base.getWord(c + 8)
    }
    return false
}

// ---------------------------------------------------------------------------
// Functions: break and continue

var breakLabels: [64]u32 = undefined
var continueLabels: [64]u32 = undefined
var loopDepth: usize = 0

// (A for loop's increment: a `continue` in it runs the increment first,
// as Mlx's continue goes to the condition.)
var loopIncrements: [64]usize = undefined

// What an entry is in the Mlx: a loop of the C++ (`while`), a `match` (a
// switch; no loop, a continue goes through it), or a dispatcher (the
// labelled `while true` around a block with labels or a switch that
// falls through, below): a jump from inside a dispatcher to a loop
// around it names the loop, `continue :loop_3`.
const ENTRY_LOOP: u8 = 0
const ENTRY_MATCH: u8 = 1
const ENTRY_DISPATCH: u8 = 2
var loopKinds: [64]u8 = undefined
// (A dispatcher's number; a loop's, once a jump names it.)
var loopIds: [64]u32 = undefined
// (Where the loop's `while` begins in the statement's text: its label
// is put in there when a jump names it.)
var loopMarks: [64]usize = undefined
var loopNamed: [64]bool = undefined
var pendingLoopMark: usize = 0
var loopSerial: u32 = 0
var dispatchSerial: u32 = 0

// The loop's `while` comes next in the text.
fn markLoop() -> void { pendingLoopMark = out.length }

fn pushEntry(kind: u8, breakLabel: u32, continueLabel: u32, id: u32) -> void {
    if loopDepth < 64 {
        breakLabels[loopDepth] = breakLabel
        continueLabels[loopDepth] = continueLabel
        loopIncrements[loopDepth] = 0
        loopKinds[loopDepth] = kind
        loopIds[loopDepth] = id
        loopMarks[loopDepth] = pendingLoopMark
        loopNamed[loopDepth] = false
    }
    loopDepth += 1
}

fn pushLoop(breakLabel: u32, continueLabel: u32) -> void {
    pushEntry(if continueLabel != 0 { ENTRY_LOOP } else { ENTRY_MATCH }, breakLabel, continueLabel, 0)
}

fn setLoopIncrement(inc: usize) -> void {
    if loopDepth > 0 && loopDepth <= 64 { loopIncrements[loopDepth - 1] = inc }
}

fn popLoop() -> void {
    if loopDepth == 0 { return }
    loopDepth -= 1
    if loopDepth < 64 && loopKinds[loopDepth] == ENTRY_LOOP && loopNamed[loopDepth] {
        // The label, before the loop's `while`.
        const at = loopMarks[loopDepth]
        var whole = emptyBuffer()
        putTo(&whole, base.bytes(out.data, at))
        const savedOut = out
        out = whole
        put("loop_")
        putNumber(@intCast(u64, loopIds[loopDepth]))
        put(": ")
        whole = out
        out = savedOut
        putTo(&whole, base.bytes(out.data + at, out.length - at))
        out = whole
    }
}

// The loop at `depth` named by a jump: its label's number.
fn nameLoop(depth: usize) -> void {
    if !loopNamed[depth] {
        loopNamed[depth] = true
        loopIds[depth] = loopSerial
        loopSerial += 1
    }
    put("loop_")
    putNumber(@intCast(u64, loopIds[depth]))
}

// The labels of the dispatchers being written, each with its dispatcher
// and its state there.
const MAX_TARGETS: usize = 1024
var targetNames: [MAX_TARGETS]u32 = undefined
var targetStates: [MAX_TARGETS]u32 = undefined
var targetOwners: [MAX_TARGETS]u32 = undefined
var targetCount: usize = 0

// ---------------------------------------------------------------------------
// Statements

// The indentation of the statement being written (for hoisted ones).
var level: usize = 0
// Hoisting off while an expression is written a second time (std::min/max).
var hoistOff = false

// The variable a statement assigns (`x = ...` as an expression
// statement), or 0.
fn assignedVariable(s: usize) -> usize {
    if s == 0 || ast.kindOf(s) != ast.EXPR_STMT { return 0 }
    var e = ast.node(s).*.lhs
    while e != 0 && ast.kindOf(e) == ast.CAST { e = ast.node(e).*.lhs }
    if e == 0 || ast.kindOf(e) != ast.ASSIGN { return 0 }
    const target = ast.node(e).*.lhs
    if target == 0 || ast.kindOf(target) != ast.VAR { return 0 }
    return ast.node(target).*.variable
}

// Whether the statement assigns a zero (the value-initialization the C++
// front end puts before a local's initializer).
fn assignsZero(s: usize) -> bool {
    var e = ast.node(s).*.lhs
    while e != 0 && ast.kindOf(e) == ast.CAST { e = ast.node(e).*.lhs }
    var value = ast.node(e).*.rhs
    while value != 0 && ast.kindOf(value) == ast.CAST { value = ast.node(value).*.lhs }
    if value == 0 { return false }
    if ast.kindOf(value) == ast.NULL_EXPR { return true }
    return ast.kindOf(value) == ast.NUM && ast.node(value).*.value == 0
}

fn emitList(head: usize, lvl: usize) -> void {
    if listHasLabel(head) {
        emitDispatch(head, lvl, 0)
        return
    }
    var s = head
    while s != 0 {
        const next = ast.node(s).*.next
        // `x = 0` right before `x = value`: the value alone.
        const zeroed = assignedVariable(s)
        if zeroed != 0 && assignsZero(s) && assignedVariable(next) == zeroed {
            s = next
            continue
        }
        emitStmt(s, lvl)
        s = next
    }
}

// A statement's body: a block's statements, or the one statement.
fn emitBody(n: usize, lvl: usize) -> void {
    if n == 0 { return }
    if ast.kindOf(n) == ast.BLOCK {
        emitList(ast.node(n).*.body, lvl)
    } else {
        emitStmt(n, lvl)
    }
}

// A statement: written on its own, with what its expressions hoist
// before it.
fn emitStmt(n: usize, lvl: usize) -> void {
    if n == 0 { return }
    const savedOut = out
    const savedPre = pre
    const savedLevel = level
    out = emptyBuffer()
    pre = emptyBuffer()
    level = lvl
    emitStatement(n, lvl)
    const text = out
    const hoisted = pre
    out = savedOut
    pre = savedPre
    level = savedLevel
    if hoisted.length > 0 { put(textOf(&hoisted)) }
    put(textOf(&text))
}

// A statement's text. One that begins with an unsafe cast (`unsafe {
// @ptrCast(...) }[0] = v`, a virtual call through the table) has the
// cast in parentheses: a line beginning `unsafe {` is an unsafe block.
fn putStatementText(whole: []const u8) -> void {
    // (Line by line: a comma expression is several statements.)
    var from: usize = 0
    while from < whole.length {
        var to = from
        while to < whole.length && whole[to] != 10 { to += 1 }
        if to < whole.length { to += 1 }
        putStatementLine(whole[from..to])
        from = to
    }
}

fn putStatementLine(text: []const u8) -> void {
    var start: usize = 0
    while start < text.length && text[start] == 32 { start += 1 }
    if !(start + 8 <= text.length && base.same(text[start..start + 8], "unsafe {")) {
        put(text)
        return
    }
    // (The block's closing brace: the one that balances its opening.)
    var depth: usize = 0
    var end = start + 7
    while end < text.length {
        if text[end] == 123 { depth += 1 }
        if text[end] == 125 {
            depth -= 1
            if depth == 0 { break }
        }
        if text[end] == 10 { break }
        end += 1
    }
    if end >= text.length || text[end] != 125 {
        put(text)
        return
    }
    put(text[0..start])
    putByte(40)
    put(text[start..end + 1])
    putByte(41)
    put(text[end + 1..text.length])
}

// An expression written as a statement before the current one.
// (The statement is written into buffers of its own, as emitStmt writes
// one, so that what it hoists itself comes before it; then both go to the
// statements before the current one.)
fn hoist(n: usize) -> void {
    if hoistOff { return }
    const savedOut = out
    const savedPre = pre
    out = emptyBuffer()
    pre = emptyBuffer()
    emitExprStmt(n, level)
    const text = out
    const inner = pre
    out = savedOut
    pre = savedPre
    if inner.length > 0 { putTo(&pre, textOf(&inner)) }
    putTo(&pre, textOf(&text))
}

fn hasContinue(n: usize, label: u32) -> bool {
    if n == 0 { return false }
    const node = ast.node(n)
    if node.*.kind == ast.JUMP && node.*.label == label { return true }
    if hasContinue(node.*.lhs, label) || hasContinue(node.*.cond, label) || hasContinue(node.*.then, label) || hasContinue(node.*.els, label) { return true }
    var s = node.*.body
    while s != 0 {
        if hasContinue(s, label) { return true }
        s = ast.node(s).*.next
    }
    return false
}

fn emitIf(n: usize, lvl: usize) -> void {
    const node = ast.node(n)
    put("if ")
    emitCond(node.*.cond)
    put(" {\n")
    emitBody(node.*.then, lvl + 1)
    indent(lvl)
    if node.*.els != 0 {
        put("} else ")
        if ast.kindOf(node.*.els) == ast.IF {
            emitIf(node.*.els, lvl)
            return
        }
        put("{\n")
        emitBody(node.*.els, lvl + 1)
        indent(lvl)
    }
    put("}\n")
}

// switch as match: each case an arm up to its break; a case that runs
// into the next is marked.
var switchBreak: u32 = 0
var switchDefault: usize = 0
var armOpen = false
// The default's arm: Mlx tries the arms in order and `else` takes
// everything, so the arm is cut out where C++ has it and written last.
var armIsDefault = false
var defaultArmStart: usize = 0
var defaultArmText: Buffer = undefined
var hasDefaultArmText = false

fn finishDefaultArm() -> void {
    if !armIsDefault { return }
    armIsDefault = false
    if out.length <= defaultArmStart { return }
    defaultArmText = emptyBuffer()
    putTo(&defaultArmText, base.bytes(out.data + defaultArmStart, out.length - defaultArmStart))
    out.length = defaultArmStart
    hasDefaultArmText = true
}

// The labels of the arm being written (`case A: case B: case C:` on one
// body): sorted and merged into ranges; the first range heads the arm,
// the body is written once more under each of the others when the arm
// closes (an Mlx pattern is one value or one range).
const MAX_LABELS: usize = 256
var armLow: [MAX_LABELS]i64 = undefined
var armHigh: [MAX_LABELS]i64 = undefined
var armRanges: usize = 0
var armBodyStart: usize = 0
var armLevel: usize = 0

// (An Mlx range pattern excludes its upper bound.)
fn putRange(k: usize) -> void {
    putSigned(armLow[k])
    if armHigh[k] != armLow[k] {
        put("..")
        putSigned(armHigh[k] + 1)
    }
}

// Closes the open arm; the other labels' arms follow with the same body.
fn closeArm() -> void {
    if !armOpen { return }
    const lvl = armLevel
    var body = emptyBuffer()
    if out.length > armBodyStart { putTo(&body, base.bytes(out.data + armBodyStart, out.length - armBodyStart)) }
    indent(lvl + 1)
    put("}\n")
    var k: usize = 1
    while k < armRanges {
        indent(lvl + 1)
        putRange(k)
        put(" => {\n")
        put(textOf(&body))
        indent(lvl + 1)
        put("}\n")
        k += 1
    }
    armOpen = false
    armRanges = 0
    finishDefaultArm()
}

// Opens the arm of the case labels from `c` down to the first statement
// (a chain of CASE nodes, each the body of the one before).
fn openArm(c: usize, lvl: usize) -> void {
    if armOpen {
        indent(lvl + 1)
        put("}  ")
        marker("the case above falls through into this one")
        newline()
        armOpen = false
        armRanges = 0
        finishDefaultArm()
    }
    var isDefault = false
    var count: usize = 0
    var label = c
    while label != 0 && ast.kindOf(label) == ast.CASE {
        if label == switchDefault {
            isDefault = true
        } else if count < MAX_LABELS {
            armLow[count] = ast.node(label).*.value
            armHigh[count] = ast.node(label).*.high
            count += 1
        }
        label = ast.node(label).*.lhs
    }
    // Sorted by their low value (insertion sort: a few dozen at most).
    var i: usize = 1
    while i < count {
        const low = armLow[i]
        const high = armHigh[i]
        var j = i
        while j > 0 && armLow[j - 1] > low {
            armLow[j] = armLow[j - 1]
            armHigh[j] = armHigh[j - 1]
            j -= 1
        }
        armLow[j] = low
        armHigh[j] = high
        i += 1
    }
    // Merged where one follows the other.
    var merged: usize = 0
    i = 0
    while i < count {
        if merged > 0 && armLow[i] <= armHigh[merged - 1] + 1 {
            if armHigh[i] > armHigh[merged - 1] { armHigh[merged - 1] = armHigh[i] }
        } else {
            armLow[merged] = armLow[i]
            armHigh[merged] = armHigh[i]
            merged += 1
        }
        i += 1
    }
    armRanges = merged
    armLevel = lvl
    if isDefault {
        armIsDefault = true
        defaultArmStart = out.length
    }
    indent(lvl + 1)
    if isDefault {
        // (`else` takes the other labels of the group with it.)
        put("else => {\n")
        armRanges = 0
    } else {
        putRange(0)
        put(" => {\n")
    }
    armBodyStart = out.length
    armOpen = true
}

fn armStatement(s: usize, lvl: usize) -> void {
    if s == 0 { return }
    const node = ast.node(s)
    if node.*.kind == ast.CASE {
        openArm(s, lvl)
        // (The first statement after the labels.)
        var body = node.*.lhs
        while body != 0 && ast.kindOf(body) == ast.CASE { body = ast.node(body).*.lhs }
        armStatement(body, lvl)
        return
    }
    if node.*.kind == ast.JUMP && node.*.label == switchBreak {
        closeArm()
        return
    }
    // (A statement before the first case is unreachable in C.)
    if armOpen { emitStmt(s, lvl + 2) }
    // A statement that never completes ends the arm: what follows is the
    // next case's, not fallen into.
    if endsAbruptly(s) { closeArm() }
}

// Whether a statement never completes: a return or a jump, a block whose
// last statement does not, an if whose two branches do not.
fn endsAbruptly(s: usize) -> bool {
    if s == 0 { return false }
    const node = ast.node(s)
    if node.*.kind == ast.RETURN || node.*.kind == ast.JUMP || node.*.kind == ast.GOTO { return true }
    if node.*.kind == ast.BLOCK {
        var last: usize = 0
        var b = node.*.body
        while b != 0 {
            last = b
            b = ast.node(b).*.next
        }
        return endsAbruptly(last)
    }
    if node.*.kind == ast.IF { return node.*.els != 0 && endsAbruptly(node.*.then) && endsAbruptly(node.*.els) }
    return false
}

fn emitSwitch(n: usize, lvl: usize) -> void {
    const node = ast.node(n)
    if switchNeedsDispatch(n) {
        emitDispatch(ast.node(node.*.then).*.body, lvl, n)
        return
    }
    const savedBreak = switchBreak
    const savedDefault = switchDefault
    const savedOpen = armOpen
    const savedRanges = armRanges
    const savedBodyStart = armBodyStart
    const savedLevel = armLevel
    const savedIsDefault = armIsDefault
    const savedDefaultStart = defaultArmStart
    const savedDefaultText = defaultArmText
    const savedHasDefaultText = hasDefaultArmText
    armIsDefault = false
    hasDefaultArmText = false
    var savedLow: [MAX_LABELS]i64 = undefined
    var savedHigh: [MAX_LABELS]i64 = undefined
    var saved: usize = 0
    while saved < savedRanges {
        savedLow[saved] = armLow[saved]
        savedHigh[saved] = armHigh[saved]
        saved += 1
    }
    switchBreak = node.*.breakLabel
    switchDefault = node.*.defaultCase
    armOpen = false
    armRanges = 0
    indent(lvl)
    put("match ")
    emitExpr(node.*.cond)
    put(" {\n")
    pushLoop(node.*.breakLabel, 0)
    var s = if node.*.then != 0 && ast.kindOf(node.*.then) == ast.BLOCK { ast.node(node.*.then).*.body } else { node.*.then }
    while s != 0 {
        armStatement(s, lvl)
        s = ast.node(s).*.next
    }
    closeArm()
    if hasDefaultArmText {
        put(textOf(&defaultArmText))
    } else if switchDefault == 0 {
        indent(lvl + 1)
        put("else => {}\n")
    }
    popLoop()
    indent(lvl)
    put("}\n")
    armIsDefault = savedIsDefault
    defaultArmStart = savedDefaultStart
    defaultArmText = savedDefaultText
    hasDefaultArmText = savedHasDefaultText
    switchBreak = savedBreak
    switchDefault = savedDefault
    armOpen = savedOpen
    armRanges = savedRanges
    armBodyStart = savedBodyStart
    armLevel = savedLevel
    saved = 0
    while saved < savedRanges {
        armLow[saved] = savedLow[saved]
        armHigh[saved] = savedHigh[saved]
        saved += 1
    }
}

fn emitJump(n: usize, lvl: usize) -> void {
    const label = ast.node(n).*.label
    indent(lvl)
    var depth = loopDepth
    // (A dispatcher's loop between the jump and its target.)
    var crossed = false
    while depth > 0 {
        depth -= 1
        if depth >= 64 { continue }
        const kind = loopKinds[depth]
        if kind == ENTRY_LOOP && continueLabels[depth] == label {
            if loopIncrements[depth] != 0 {
                // The for loop's increment, then the condition.
                newline()
                emitStmt(loopIncrements[depth], lvl)
                indent(lvl)
            }
            if crossed {
                put("continue :")
                nameLoop(depth)
                newline()
            } else {
                put("continue\n")
            }
            return
        }
        if breakLabels[depth] == label && label != 0 {
            if kind == ENTRY_DISPATCH {
                put("break :dispatch_")
                putNumber(@intCast(u64, loopIds[depth]))
                newline()
            } else if kind == ENTRY_MATCH {
                // (A switch with such a break is written as a dispatcher:
                // not reached.)
                marker("break out of a switch from inside a nested statement")
                newline()
            } else if crossed {
                put("break :")
                nameLoop(depth)
                newline()
            } else {
                put("break\n")
            }
            return
        }
        if kind == ENTRY_DISPATCH { crossed = true }
    }
    marker("a jump the translator cannot place")
    newline()
}

// `goto name`: the dispatcher's state, and around again.
fn emitGoto(n: usize, lvl: usize) -> void {
    const name = ast.node(n).*.name
    var k = targetCount
    while k > 0 {
        k -= 1
        if targetNames[k] == name {
            indent(lvl)
            put("state_")
            putNumber(@intCast(u64, targetOwners[k]))
            put(" = ")
            putNumber(@intCast(u64, targetStates[k]))
            newline()
            indent(lvl)
            put("continue :dispatch_")
            putNumber(@intCast(u64, targetOwners[k]))
            newline()
            return
        }
    }
    indent(lvl)
    marker("goto ")
    ident(name)
    newline()
}

// Whether a list of statements has a label of its own (not inside one of
// its statements).
fn listHasLabel(head: usize) -> bool {
    var s = head
    while s != 0 {
        var inner = s
        while inner != 0 && (ast.kindOf(inner) == ast.LABEL || ast.kindOf(inner) == ast.CASE) {
            if ast.kindOf(inner) == ast.LABEL { return true }
            inner = ast.node(inner).*.lhs
        }
        s = ast.node(s).*.next
    }
    return false
}

// Whether a switch is more than a `match` says: a label among its
// cases, a case that runs into the next, or a break inside a statement
// of a case (`if (x) break;`). It is written as a dispatcher then.
fn switchNeedsDispatch(n: usize) -> bool {
    const node = ast.node(n)
    if node.*.then == 0 || ast.kindOf(node.*.then) != ast.BLOCK { return false }
    var open = false
    var s = ast.node(node.*.then).*.body
    while s != 0 {
        var inner = s
        var isCase = false
        while inner != 0 && (ast.kindOf(inner) == ast.LABEL || ast.kindOf(inner) == ast.CASE) {
            if ast.kindOf(inner) == ast.LABEL { return true }
            isCase = true
            inner = ast.node(inner).*.lhs
        }
        if isCase {
            if open { return true }
            open = false
        }
        s = ast.node(s).*.next
        if inner == 0 { continue }
        if ast.kindOf(inner) == ast.JUMP && ast.node(inner).*.label == node.*.breakLabel {
            open = false
            continue
        }
        if hasContinue(inner, node.*.breakLabel) { return true }
        if ast.kindOf(inner) == ast.EXPR_STMT && isNoop(ast.node(inner).*.lhs) { continue }
        open = !endsAbruptly(inner)
    }
    return false
}

// A dispatcher: a list of statements with labels (and the cases of
// `switchNode`, when the list is a switch's body) as the segments
// between them, each run when the state is its number and running into
// the next, all in a labelled loop:
//
//     var state_0: u32 = 0
//     dispatch_0: while true {
//         if state_0 == 0 {
//             ...                     // before the first label
//             state_0 = 1
//         }
//         if state_0 == 1 {           // again:
//             ...
//             state_0 = 1             // goto again
//             continue :dispatch_0
//         }
//         break
//     }
//
// A goto sets the state and goes around; a switch begins at its case's
// state, and its break leaves the loop.
fn emitDispatch(head: usize, lvl: usize, switchNode: usize) -> void {
    const id = dispatchSerial
    dispatchSerial += 1
    const savedTargets = targetCount
    // The states: 0 before the first label or case, one more at each
    // statement with labels.
    var states: u32 = 0
    var defaultState: u32 = 0
    var hasDefault = false
    var s = head
    while s != 0 {
        var inner = s
        var starts = false
        while inner != 0 && (ast.kindOf(inner) == ast.LABEL || (switchNode != 0 && ast.kindOf(inner) == ast.CASE)) {
            if !starts {
                starts = true
                states += 1
            }
            if ast.kindOf(inner) == ast.LABEL {
                if targetCount < MAX_TARGETS {
                    targetNames[targetCount] = ast.node(inner).*.name
                    targetStates[targetCount] = states
                    targetOwners[targetCount] = id
                    targetCount += 1
                } else {
                    listsFull = true
                }
            } else if inner == ast.node(switchNode).*.defaultCase {
                hasDefault = true
                defaultState = states
            }
            inner = ast.node(inner).*.lhs
        }
        s = ast.node(s).*.next
    }
    const end = states + 1
    indent(lvl)
    put("var state_")
    putNumber(@intCast(u64, id))
    put(": u32 = ")
    putNumber(@intCast(u64, if switchNode == 0 { 0 } else if hasDefault { defaultState } else { end }))
    newline()
    if switchNode != 0 {
        // The case chosen.
        indent(lvl)
        put("match ")
        emitExpr(ast.node(switchNode).*.cond)
        put(" {\n")
        var state: u32 = 0
        s = head
        while s != 0 {
            var inner = s
            var starts = false
            while inner != 0 && (ast.kindOf(inner) == ast.LABEL || ast.kindOf(inner) == ast.CASE) {
                if !starts {
                    starts = true
                    state += 1
                }
                if ast.kindOf(inner) == ast.CASE && inner != ast.node(switchNode).*.defaultCase {
                    indent(lvl + 1)
                    putSigned(ast.node(inner).*.value)
                    if ast.node(inner).*.high != ast.node(inner).*.value {
                        put("..")
                        putSigned(ast.node(inner).*.high + 1)
                    }
                    put(" => { state_")
                    putNumber(@intCast(u64, id))
                    put(" = ")
                    putNumber(@intCast(u64, state))
                    put(" }\n")
                }
                inner = ast.node(inner).*.lhs
            }
            s = ast.node(s).*.next
        }
        indent(lvl + 1)
        put("else => {}\n")
        indent(lvl)
        put("}\n")
    }
    indent(lvl)
    put("dispatch_")
    putNumber(@intCast(u64, id))
    put(": while true {\n")
    pushEntry(ENTRY_DISPATCH, if switchNode != 0 { ast.node(switchNode).*.breakLabel } else { 0 }, 0, id)
    // The segments. (A switch's statements before its first case are
    // not reached.)
    var state: u32 = 0
    var open = switchNode == 0
    var dead = false
    var runsOn = true
    if open {
        indent(lvl + 1)
        put("if state_")
        putNumber(@intCast(u64, id))
        put(" == 0 {\n")
    }
    s = head
    while s != 0 {
        var inner = s
        var starts = false
        while inner != 0 && (ast.kindOf(inner) == ast.LABEL || (switchNode != 0 && ast.kindOf(inner) == ast.CASE)) {
            starts = true
            inner = ast.node(inner).*.lhs
        }
        if starts {
            if open {
                if runsOn {
                    indent(lvl + 2)
                    put("state_")
                    putNumber(@intCast(u64, id))
                    put(" = ")
                    putNumber(@intCast(u64, state + 1))
                    newline()
                }
                indent(lvl + 1)
                put("}\n")
            }
            state += 1
            open = true
            dead = false
            runsOn = true
            indent(lvl + 1)
            put("if state_")
            putNumber(@intCast(u64, id))
            put(" == ")
            putNumber(@intCast(u64, state))
            put(" {\n")
        }
        // (What follows a statement that never completes, a `break`
        // after a `return`, is not written.)
        if open && !dead && inner != 0 {
            emitStmt(inner, lvl + 2)
            if endsAbruptly(inner) {
                dead = true
                runsOn = false
            }
        }
        s = ast.node(s).*.next
    }
    if open {
        indent(lvl + 1)
        put("}\n")
    }
    // (The way out at the end: after the last segment when it completes,
    // or for a switch none of whose cases was the value. Without one
    // the loop is left by `return` and `break :dispatch` alone, and a
    // function may end with it.)
    if !open || runsOn || (switchNode != 0 && !hasDefault) {
        indent(lvl + 1)
        put("break\n")
    }
    popLoop()
    indent(lvl)
    put("}\n")
    targetCount = savedTargets
}

// Whether a goto of a body has no dispatcher: its label is not a
// statement of a list around the goto (a jump into a block, a label on a
// single statement of an `if`). The labels of the lists around the place
// walked are kept in `scopeLabels`.
var scopeLabels: [MAX_TARGETS]u32 = undefined
var scopeCount: usize = 0

fn hasStrayGoto(n: usize) -> bool {
    if n == 0 { return false }
    const node = ast.node(n)
    const kind = node.*.kind
    if kind == ast.GOTO {
        var k: usize = 0
        while k < scopeCount {
            if scopeLabels[k] == node.*.name { return false }
            k += 1
        }
        return true
    }
    const saved = scopeCount
    if kind == ast.BLOCK {
        var s = node.*.body
        while s != 0 {
            var inner = s
            while inner != 0 && (ast.kindOf(inner) == ast.LABEL || ast.kindOf(inner) == ast.CASE) {
                if ast.kindOf(inner) == ast.LABEL {
                    if scopeCount >= MAX_TARGETS { return true }
                    scopeLabels[scopeCount] = ast.node(inner).*.name
                    scopeCount += 1
                }
                inner = ast.node(inner).*.lhs
            }
            s = ast.node(s).*.next
        }
    }
    var stray = hasStrayGoto(node.*.lhs) || hasStrayGoto(node.*.rhs) || hasStrayGoto(node.*.cond) || hasStrayGoto(node.*.then) || hasStrayGoto(node.*.els) || hasStrayGoto(node.*.init) || hasStrayGoto(node.*.inc)
    var b = node.*.body
    while b != 0 && !stray {
        stray = hasStrayGoto(b)
        b = ast.node(b).*.next
    }
    var a = node.*.args
    while a != 0 && !stray {
        stray = hasStrayGoto(a)
        a = ast.node(a).*.next
    }
    scopeCount = saved
    return stray
}

// Whether a function's body has what the translator has no Mlx for.
fn bodyUnknown(body: usize) -> bool {
    if hasUnknownNode(body) { return true }
    scopeCount = 0
    if hasStrayGoto(body) {
        lastUnknownKind = ast.GOTO
        return true
    }
    return false
}

fn emitStatement(n: usize, lvl: usize) -> void {
    const node = ast.node(n)
    const kind = node.*.kind
    if kind == ast.BLOCK {
        // (C scopes flattened: the locals are declared at the top.)
        emitList(node.*.body, lvl)
    } else if kind == ast.EXPR_STMT {
        emitExprStmt(node.*.lhs, lvl)
    } else if kind == ast.RETURN {
        if trace && node.*.lhs != 0 {
            indent(lvl)
            put("// trace: return ")
            putTree(node.*.lhs, 0)
            newline()
        }
        indent(lvl)
        put("return")
        if node.*.lhs != 0 {
            putByte(32)
            const returned = types.at(ast.typeOf(node.*.lhs)).*.kind
            const result = if currentFunction != 0 { types.at(ast.obj(currentFunction).*.ty).*.base } else { 0 }
            // (A derived object returned as its base class's reference,
            // `std::ostream &stream() { return mStream; }`: the base's
            // part of it.)
            if result != 0 && types.at(result).*.kind == types.REF && (returned == types.PTR || returned == types.REF) && argumentRecord(node.*.lhs) != 0 && otherRecord(types.at(result).*.base, argumentRecord(node.*.lhs)) && offsetOfBase(argumentRecord(node.*.lhs), types.at(result).*.base, 0) >= 0 {
                const offset = offsetOfBase(argumentRecord(node.*.lhs), types.at(result).*.base, 0)
                put("unsafe { @ptrCast(")
                putPointer(types.at(result).*.base, false)
                put(", ")
                if offset == 0 {
                    emitExpr(node.*.lhs)
                    if !isPlainPointer(node.*.lhs) { put(".?") }
                } else {
                    put("&unsafe { @ptrCast([*]u8, ")
                    emitExpr(node.*.lhs)
                    if !isPlainPointer(node.*.lhs) { put(".?") }
                    put(") }[")
                    putNumber(@bitCast(u64, offset))
                    put("]")
                }
                put(") }")
                newline()
                return
            }
            emitExpr(node.*.lhs)
            // (A reference returned, as a plain pointer, from a pointer
            // local, which is optional in Mlx: unwrapped.)
            if result != 0 && types.at(result).*.kind == types.REF && (returned == types.PTR || returned == types.REF) && !isPlainPointer(node.*.lhs) { put(".?") }
        }
        newline()
    } else if kind == ast.IF {
        indent(lvl)
        emitIf(n, lvl)
    } else if kind == ast.FOR {
        if node.*.init != 0 { emitStmt(node.*.init, lvl) }
        // The condition, with what it hoists (`i-- > 0`, a call through a
        // temporary): hoisted, it is re-evaluated each time around, as
        // the first statements of a `while true`.
        const savedOut = out
        const savedPre = pre
        const savedLevel = level
        out = emptyBuffer()
        pre = emptyBuffer()
        level = lvl + 1
        if node.*.cond != 0 { emitCond(node.*.cond) } else { put("true") }
        const condText = out
        const condPre = pre
        out = savedOut
        pre = savedPre
        level = savedLevel
        indent(lvl)
        markLoop()
        if condPre.length > 0 {
            put("while true {\n")
            put(textOf(&condPre))
            indent(lvl + 1)
            put("if !")
            put(textOf(&condText))
            put(" { break }\n")
        } else {
            put("while ")
            put(textOf(&condText))
            put(" {\n")
        }
        pushLoop(node.*.breakLabel, node.*.continueLabel)
        setLoopIncrement(node.*.inc)
        emitBody(node.*.then, lvl + 1)
        if node.*.inc != 0 { emitStmt(node.*.inc, lvl + 1) }
        popLoop()
        indent(lvl)
        put("}\n")
    } else if kind == ast.DO && constantValue(node.*.cond) == 0 && !hasContinue(node.*.then, node.*.breakLabel) && !hasContinue(node.*.then, node.*.continueLabel) {
        // `do { ... } while (0)` (a macro's body): the body once.
        emitBody(node.*.then, lvl)
    } else if kind == ast.DO {
        indent(lvl)
        markLoop()
        put("while true {\n")
        pushLoop(node.*.breakLabel, node.*.continueLabel)
        emitBody(node.*.then, lvl + 1)
        {
            const savedOut = out
            const savedPre = pre
            const savedLevel = level
            out = emptyBuffer()
            pre = emptyBuffer()
            level = lvl + 1
            emitCond(node.*.cond)
            const condText = out
            const condPre = pre
            out = savedOut
            pre = savedPre
            level = savedLevel
            put(textOf(&condPre))
            indent(lvl + 1)
            put("if !")
            put(textOf(&condText))
            put(" { break }\n")
        }
        popLoop()
        indent(lvl)
        put("}\n")
    } else if kind == ast.SWITCH {
        emitSwitch(n, lvl)
    } else if kind == ast.CASE {
        emitStmt(node.*.lhs, lvl)
    } else if kind == ast.JUMP {
        emitJump(n, lvl)
    } else if kind == ast.GOTO {
        emitGoto(n, lvl)
    } else if kind == ast.LABEL {
        indent(lvl)
        marker("label ")
        ident(node.*.name)
        newline()
        emitStmt(node.*.lhs, lvl)
    } else if kind == ast.ASM {
        // The instructions with a meaning of their own in Mlx: a fence, a
        // trap; a pause or nop is nothing. (Another is held back with its
        // function, hasUnknownNode.)
        const instruction = node.*.value
        if instruction == 4 || instruction == 5 || instruction == 6 {
            indent(lvl)
            put("@fence(seq_cst)\n")
        } else if instruction == 2 || instruction == 7 {
            usesRuntime = true
            indent(lvl)
            put("c.abort()\n")
        } else if instruction != 0 && instruction != 1 && instruction != 3 {
            indent(lvl)
            marker("inline assembly")
            newline()
        }
    } else {
        emitExprStmt(n, lvl)
    }
}

// `__builtin_add_overflow(x, y, p)` (sub, mul) as the front end makes it
// for one integer type of 4 or 8 bytes: an instruction with the
// operation's name on it; 0 for another node.
fn overflowOperation(n: usize) -> u32 {
    if n == 0 || ast.kindOf(n) != ast.ASM || ast.node(n).*.value != 15 { return 0 }
    const name = ast.node(n).*.name
    if name == 0 { return 0 }
    const text = base.nameOf(name)
    if base.same(text, "add") || base.same(text, "sub") || base.same(text, "mul") { return name }
    return 0
}

// The operand under the cast to a word the front end gave it.
fn asmOperand(n: usize) -> usize {
    if n != 0 && ast.kindOf(n) == ast.CAST && ast.node(n).*.lhs != 0 { return ast.node(n).*.lhs }
    return n
}

// The runtime's `c.mul_overflow_u64(x, y, p)`: the result stored at p,
// true when it did not fit.
fn emitOverflow(n: usize) -> void {
    const node = ast.node(n)
    const x = asmOperand(node.*.lhs)
    const y = asmOperand(node.*.rhs)
    const p = asmOperand(node.*.cond)
    usesRuntime = true
    put("c.")
    put(base.nameOf(overflowOperation(n)))
    put("_overflow_")
    putIntType(types.at(types.unqualified(ast.typeOf(x))))
    putByte(40)
    emitExpr(x)
    put(", ")
    emitExpr(y)
    put(", ")
    emitExpr(p)
    if !isPlainPointer(p) { put(".?") }
    putByte(41)
}

fn containsText(text: []const u8, part: []const u8) -> bool {
    if part.length > text.length { return false }
    var at: usize = 0
    while at + part.length <= text.length {
        if base.same(text[at..at + part.length], part) { return true }
        at += 1
    }
    return false
}

// std::initializer_list<T> (made over an array temporary: the translator
// reads the list itself).
fn isInitializerList(cls: usize) -> bool {
    if cls == 0 { return false }
    const name = types.at(cls).*.name
    return name != 0 && containsText(base.nameOf(name), "initializer_list")
}

// Whether a tree calls a C++ operator function or makes a C++ object
// (the stream and voidify machinery of ANGLE's ASSERT and ERR): dropped
// with a mark, as the Mlx says it with std.io.
fn callsOperator(n: usize) -> bool {
    if n == 0 { return false }
    const node = ast.node(n)
    if node.*.kind == ast.FUNCALL && node.*.lhs != 0 && ast.kindOf(node.*.lhs) == ast.VAR {
        const callee = ast.obj(ast.node(node.*.lhs).*.variable)
        if callee.*.isFunction {
            const translatedClass = callee.*.classType != 0 && isTranslated(callee.*.classType)
            // (The global operator new and delete go to the runtime.)
            const runtimeOperator = callee.*.classType == 0 && callee.*.body == 0 && isRuntimeFunction(base.nameOf(callee.*.name))
            // (An operator outside a class is a function as any other
            // where the program has it: written in this unit or, by the
            // manifest, in another.)
            const freeOperator = callee.*.classType == 0 && (callee.*.body != 0 || functionEntry(callee) != 0)
            if startsWith(base.nameOf(callee.*.name), "operator") && !translatedClass && !runtimeOperator && !freeOperator { return true }
            if (callee.*.isConstructor || callee.*.isDestructor) && !isInitializerList(callee.*.classType) && !translatedClass { return true }
        }
    }
    if callsOperator(node.*.lhs) || callsOperator(node.*.rhs) || callsOperator(node.*.cond) || callsOperator(node.*.then) || callsOperator(node.*.els) { return true }
    var a = node.*.args
    while a != 0 {
        if callsOperator(a) { return true }
        a = ast.node(a).*.next
    }
    return false
}

// The string literals in a tree, quoted, one after the other (the text
// of a dropped log message).
fn putStrings(n: usize) -> void {
    if n == 0 { return }
    const node = ast.node(n)
    if node.*.kind == ast.VAR && ast.obj(node.*.variable).*.isLiteral {
        putByte(32)
        putStringLiteral(ast.obj(node.*.variable))
    }
    putStrings(node.*.lhs)
    putStrings(node.*.rhs)
    putStrings(node.*.cond)
    putStrings(node.*.then)
    putStrings(node.*.els)
    var a = node.*.args
    while a != 0 {
        putStrings(a)
        a = ast.node(a).*.next
    }
}

// An expression with no effect as a statement (`(void)0`).
fn isNoop(n: usize) -> bool {
    var e = n
    while e != 0 && ast.kindOf(e) == ast.CAST { e = ast.node(e).*.lhs }
    if e == 0 { return true }
    const kind = ast.kindOf(e)
    return kind == ast.NUM || kind == ast.VAR || kind == ast.NULL_EXPR
}

fn constantValue(n: usize) -> i64 {
    var e = n
    while e != 0 && ast.kindOf(e) == ast.CAST { e = ast.node(e).*.lhs }
    if e != 0 && ast.kindOf(e) == ast.NUM { return ast.node(e).*.value }
    return -1
}

// The zero of a type, as C's zero initialization leaves it.
fn putZero(ty: usize) -> void {
    const kind = types.at(ty).*.kind
    if isIntKind(kind) {
        put("0")
    } else if isFloatKind(kind) {
        put("0.0")
    } else if kind == types.BOOL {
        put("false")
    } else if kind == types.PTR {
        put("null")
    } else {
        put("undefined  ")
        marker("zeroed in C")
    }
}

// Whether a zeroed object is written as a value (`0`, `null`, `false`);
// a record or an array is zeroed in place by the runtime's memset.
fn zeroIsValue(ty: usize) -> bool {
    const kind = types.at(ty).*.kind
    return isIntKind(kind) || isFloatKind(kind) || kind == types.BOOL || kind == types.PTR
}

fn putMemset() -> void {
    usesRuntime = true
    put("_ = c.memset(unsafe { @ptrCast(?[*]u8, &")
}

fn emitMemzero(n: usize, lvl: usize) -> void {
    const node = ast.node(n)
    indent(lvl)
    if node.*.variable != 0 {
        const ty = ast.obj(node.*.variable).*.ty
        if zeroIsValue(ty) {
            putLocal(node.*.variable)
            put(" = ")
            putZero(ty)
        } else {
            putMemset()
            putLocal(node.*.variable)
            put(") }, 0, @sizeOf(")
            putType(ty)
            put("))")
        }
    } else if node.*.lhs != 0 && ast.kindOf(node.*.lhs) == ast.ADDR {
        const target = ast.node(node.*.lhs).*.lhs
        const ty = ast.typeOf(target)
        if zeroIsValue(ty) {
            emitLvalue(target)
            put(" = ")
            putZero(ty)
        } else {
            putMemset()
            emitLvalue(target)
            put(") }, 0, @sizeOf(")
            putType(ty)
            put("))")
        }
    } else {
        marker("memory zeroed through an address")
    }
    newline()
}

// `!c` as a condition (a `!` already there is taken off).
fn emitNegated(n: usize) -> void {
    if ast.kindOf(n) == ast.NOT {
        emitCond(ast.node(n).*.lhs)
        return
    }
    putByte(33)
    emitCond(n)
}

// The outermost call's function in a tree, as `name(...)` (what a
// dropped statement was about).
fn putCalleeName(n: usize) -> void {
    var e = n
    while e != 0 && (ast.kindOf(e) == ast.CAST || ast.kindOf(e) == ast.DEREF || ast.kindOf(e) == ast.ADDR || ast.kindOf(e) == ast.COMMA) {
        e = if ast.kindOf(e) == ast.COMMA { ast.node(e).*.rhs } else { ast.node(e).*.lhs }
    }
    if e == 0 || ast.kindOf(e) != ast.FUNCALL { return }
    const callee = ast.node(e).*.lhs
    if callee == 0 || ast.kindOf(callee) != ast.VAR { return }
    const obj = ast.obj(ast.node(callee).*.variable)
    if isStdFunction(obj) { put("std::") }
    if obj.*.classType != 0 {
        putTypeName(obj.*.classType)
        put("::")
    }
    ident(obj.*.name)
    put("(...)")
}

// A tree for MLX_CC_EMIT_TRACE: `kind:name/typekind(lhs,rhs;args)`.
fn putTree(n: usize, depth: usize) -> void {
    if n == 0 { return }
    if depth > 8 {
        put("...")
        return
    }
    const node = ast.node(n)
    putNumber(@intCast(u64, node.*.kind))
    if node.*.kind == ast.VAR {
        putByte(58)
        ident(ast.obj(node.*.variable).*.name)
    }
    if node.*.ty != 0 {
        putByte(47)
        putNumber(@intCast(u64, types.at(node.*.ty).*.kind))
    }
    // (Only a call's arguments: another node's field is not a list.)
    const arguments: usize = if node.*.kind == ast.FUNCALL { node.*.args } else { 0 }
    if node.*.lhs == 0 && node.*.rhs == 0 && arguments == 0 && node.*.cond == 0 { return }
    putByte(40)
    if node.*.cond != 0 {
        putTree(node.*.cond, depth + 1)
        putByte(63)
        putTree(node.*.then, depth + 1)
        putByte(58)
        putTree(node.*.els, depth + 1)
    }
    putTree(node.*.lhs, depth + 1)
    if node.*.rhs != 0 {
        putByte(44)
        putTree(node.*.rhs, depth + 1)
    }
    var a = arguments
    while a != 0 {
        putByte(59)
        putTree(a, depth + 1)
        a = ast.node(a).*.next
    }
    putByte(41)
}

fn emitExprStmt(n: usize, lvl: usize) -> void {
    if n == 0 { return }
    if trace {
        indent(lvl)
        put("// trace: ")
        putTree(n, 0)
        newline()
    }
    var e = n
    while ast.kindOf(e) == ast.CAST && types.at(ast.typeOf(e)).*.kind == types.VOID && ast.node(e).*.lhs != 0 { e = ast.node(e).*.lhs }
    const node = ast.node(e)
    const kind = node.*.kind
    if kind == ast.NUM || kind == ast.VAR || kind == ast.NULL_EXPR { return }
    if kind == ast.COMMA {
        emitExprStmt(node.*.lhs, lvl)
        emitExprStmt(node.*.rhs, lvl)
        return
    }
    if kind == ast.MEMZERO {
        emitMemzero(e, lvl)
        return
    }
    if kind == ast.STMT_EXPR && types.at(node.*.ty).*.kind == types.VOID {
        // (`delete[] p`, a loop of destructors: its statements.)
        var s = node.*.body
        while s != 0 {
            emitStmt(s, lvl)
            s = ast.node(s).*.next
        }
        return
    }
    // (A braced list's std::initializer_list where the Mlx has no record
    // for it: its making is dropped with what takes it. Where it is a
    // record, a pointer and a count, it is made as any other.)
    if kind == ast.ASSIGN && isInitializerList(ast.typeOf(node.*.lhs)) && !isTranslated(types.unqualified(ast.typeOf(node.*.lhs))) { return }
    if kind == ast.FUNCALL && node.*.lhs != 0 && ast.kindOf(node.*.lhs) == ast.VAR && isInitializerList(ast.obj(ast.node(node.*.lhs).*.variable).*.classType) && !isTranslated(ast.obj(ast.node(node.*.lhs).*.variable).*.classType) { return }
    if kind == ast.COND && types.at(ast.typeOf(e)).*.kind == types.VOID {
        // `c ? (void)0 : log...`: ANGLE's ASSERT and ERR. A constant
        // condition (NDEBUG) leaves one branch; a branch that is only a
        // dropped stream expression is no branch; a log whose other side
        // is empty is one mark with the message's text, its gate (a call
        // of the logging's own) dropped with it.
        const constant = constantValue(node.*.cond)
        if constant == 0 {
            emitExprStmt(node.*.els, lvl)
            return
        }
        if constant > 0 {
            emitExprStmt(node.*.then, lvl)
            return
        }
        const thenLive = !isNoop(node.*.then) && !callsOperator(node.*.then)
        const elsLive = !isNoop(node.*.els) && !callsOperator(node.*.els)
        if !thenLive && !elsLive {
            indent(lvl)
            marker("a log dropped:")
            putStrings(node.*.then)
            putStrings(node.*.els)
            newline()
            return
        }
        if thenLive && !elsLive {
            indent(lvl)
            put("if ")
            emitCond(node.*.cond)
            put(" {\n")
            emitExprStmt(node.*.then, lvl + 1)
            indent(lvl)
            put("}\n")
            return
        }
        if !thenLive && elsLive {
            indent(lvl)
            put("if ")
            emitNegated(node.*.cond)
            put(" {\n")
            emitExprStmt(node.*.els, lvl + 1)
            indent(lvl)
            put("}\n")
            return
        }
        indent(lvl)
        put("if ")
        emitCond(node.*.cond)
        put(" {\n")
        emitExprStmt(node.*.then, lvl + 1)
        indent(lvl)
        put("} else {\n")
        emitExprStmt(node.*.els, lvl + 1)
        indent(lvl)
        put("}\n")
        return
    }
    if callsOperator(e) {
        indent(lvl)
        marker("dropped (a C++ operator call, a stream or a temporary object): ")
        if kind == ast.ASSIGN {
            emitLvalue(node.*.lhs)
            put(" = ")
            putCalleeName(node.*.rhs)
        } else {
            putCalleeName(e)
        }
        putStrings(e)
        newline()
        return
    }
    indent(lvl)
    if kind == ast.ASSIGN {
        emitAssign(e)
        newline()
        return
    }
    if kind == ast.VA_START {
        // va_start(list, last): the list over the function's words.
        usesRuntime = true
        put("c.va_start(")
        emitVaPointer(node.*.lhs)
        put(", va_arguments)\n")
        return
    }
    if kind == ast.FUNCALL && isVariadicCall(e) {
        // (A C function's variable arguments without words in the Mlx:
        // its function is held back, this is its comment's text.)
        marker("a variadic C call dropped: ")
        putCalleeName(e)
        putStrings(e)
        newline()
        return
    }
    if kind == ast.FUNCALL && types.at(ast.typeOf(e)).*.kind == types.VOID {
        emitExpr(e)
        newline()
        return
    }
    if kind == ast.FUNCALL && node.*.returnBuffer != 0 {
        // A class returned through the hidden buffer: the buffer's variable
        // takes the call's value.
        putLocal(node.*.returnBuffer)
        put(" = ")
        emitCall(e)
        newline()
        return
    }
    if kind == ast.DEREF && node.*.lhs != 0 && ast.kindOf(uncast(node.*.lhs)) == ast.FUNCALL {
        // A reference a call returns, dropped: the call.
        put("_ = ")
        emitExpr(uncast(node.*.lhs))
        newline()
        return
    }
    put("_ = ")
    emitExpr(e)
    newline()
}

// `a = b`, with a bit-field narrowed to its width.
fn emitAssign(n: usize) -> void {
    const node = ast.node(n)
    const assigned = ast.typeOf(node.*.rhs)
    if ast.typeOf(node.*.lhs) != 0 && assigned != 0 && otherRecord(ast.typeOf(node.*.lhs), assigned) {
        // (A record assigned another record's value, a class made from
        // its base's bytes: the bytes of the value's type written.)
        put("unsafe { @ptrCast(*")
        putType(types.unqualified(assigned))
        put(", &")
        emitLvalue(node.*.lhs)
        put(") }.*")
    } else {
        emitLvalue(node.*.lhs)
    }
    put(" = ")
    if ast.kindOf(node.*.lhs) == ast.MEMBER {
        const member = types.member(ast.node(node.*.lhs).*.member)
        if member.*.bitWidth > 0 {
            if isBoolish(node.*.rhs) {
                put("(if ")
                emitExpr(node.*.rhs)
                put(" { @intCast(")
                putBitFieldType(member)
                put(", 1) } else { @intCast(")
                putBitFieldType(member)
                put(", 0) })")
                return
            }
            put("@intCast(")
            putBitFieldType(member)
            put(", ")
            emitExpr(node.*.rhs)
            putByte(41)
            return
        }
    }
    // (A pointer's zero: null.)
    if types.at(ast.typeOf(node.*.lhs)).*.kind == types.PTR && ast.kindOf(uncast(node.*.rhs)) == ast.NUM && ast.node(uncast(node.*.rhs)).*.value == 0 {
        put("null")
        return
    }
    emitExpr(node.*.rhs)
    // (A reference bound to a C pointer, nullable in the Mlx: `char &ch
    // = *it`.)
    var bindsReference = types.at(ast.typeOf(node.*.lhs)).*.kind == types.REF
    if ast.kindOf(node.*.lhs) == ast.VAR && types.at(ast.obj(ast.node(node.*.lhs).*.variable).*.ty).*.kind == types.REF { bindsReference = true }
    const rk = types.at(ast.typeOf(node.*.rhs)).*.kind
    if bindsReference && (rk == types.PTR || rk == types.REF) && !isPlainPointer(node.*.rhs) { put(".?") }
}

// ---------------------------------------------------------------------------
// Expressions

fn isBoolish(n: usize) -> bool {
    const kind = ast.kindOf(n)
    if kind == ast.EQ || kind == ast.NE || kind == ast.LT || kind == ast.LE || kind == ast.LOGAND || kind == ast.LOGOR || kind == ast.NOT { return true }
    if overflowOperation(n) != 0 { return true }
    return types.at(ast.typeOf(n)).*.kind == types.BOOL
}

// A condition: Mlx wants a bool where C takes any scalar.
fn emitCond(n: usize) -> void {
    if isBoolish(n) {
        emitExpr(n)
        return
    }
    putByte(40)
    if pointerFromInteger(n) != 0 {
        // (A pointer made of an integer is no optional: the integer.)
        emitExpr(pointerFromInteger(n))
        put(" != 0)")
        return
    }
    emitExpr(n)
    put(if types.at(ast.typeOf(n)).*.kind == types.PTR { " != null)" } else { " != 0)" })
}

fn shiftType(ty: usize) -> []const u8 {
    const size = types.at(ty).*.size
    if size <= 1 { return "u3" }
    if size == 2 { return "u4" }
    if size == 4 { return "u5" }
    return "u6"
}

// Whether arithmetic of a type wraps in C: an unsigned integer's.
fn wraps(ty: usize) -> bool {
    const t = types.at(ty)
    return (isIntKind(t.*.kind) && t.*.unsigned) || t.*.kind == types.WIDE
}

fn binary(n: usize, operator: []const u8) -> void {
    const node = ast.node(n)
    putByte(40)
    emitExpr(node.*.lhs)
    put(operator)
    emitExpr(node.*.rhs)
    putByte(41)
}

// Whether a pointer-typed expression is never null in the Mlx: `this`
// (self), a reference.
// The integer a cast makes a pointer of (0: the node is no such cast,
// or the integer is the constant 0, null).
fn pointerFromInteger(n: usize) -> usize {
    var e = n
    while true {
        if e == 0 || ast.kindOf(e) != ast.CAST || ast.node(e).*.lhs == 0 || ast.typeOf(e) == 0 || types.at(ast.typeOf(e)).*.kind != types.PTR { return 0 }
        const inner = ast.node(e).*.lhs
        const from = ast.typeOf(inner)
        if from == 0 { return 0 }
        // (Under a cast to another pointer type: that one's.)
        if types.at(from).*.kind == types.PTR && ast.kindOf(inner) == ast.CAST {
            e = inner
            continue
        }
        if !(isIntKind(types.at(from).*.kind) || types.at(from).*.kind == types.BOOL) { return 0 }
        if ast.kindOf(inner) == ast.NUM && ast.node(inner).*.value == 0 { return 0 }
        return inner
    }
    return 0
}

// Whether a node is the null pointer constant.
fn isNullConstant(n: usize) -> bool {
    const e = uncast(n)
    if e == 0 { return false }
    return ast.kindOf(e) == ast.NULL_EXPR || (ast.kindOf(e) == ast.NUM && ast.node(e).*.value == 0)
}

fn isPlainPointer(given: usize) -> bool {
    // (A reference bound as another record's is written as that record's
    // plain pointer, emitCast.)
    if given != 0 && ast.kindOf(given) == ast.CAST && ast.node(given).*.lhs != 0 && ast.typeOf(given) != 0 && types.at(ast.typeOf(given)).*.kind == types.REF {
        const from = ast.typeOf(ast.node(given).*.lhs)
        if from != 0 && (types.at(from).*.kind == types.PTR || types.at(from).*.kind == types.REF) && otherRecord(pointee(ast.typeOf(given)), pointee(from)) { return true }
    }
    // (A pointer made of an integer, `reinterpret_cast<T *>(handle)`:
    // @ptrFromInt's bare pointer.)
    if given != 0 && ast.kindOf(given) == ast.CAST && pointerFromInteger(given) != 0 { return true }
    const n = uncast(given)
    // (`(tmp = value, &tmp)`, a temporary materialized: its address.)
    if ast.kindOf(n) == ast.COMMA && ast.node(n).*.rhs != 0 { return isPlainPointer(ast.node(n).*.rhs) }
    // (`c ? a : b` of two references: one of two plain pointers. Of
    // two pointers the arms are written as the optional pointer type,
    // emitBranch.)
    if ast.kindOf(n) == ast.COND && ast.node(n).*.then != 0 && ast.node(n).*.els != 0 && ast.typeOf(n) != 0 && types.at(ast.typeOf(n)).*.kind == types.REF {
        return isPlainPointer(ast.node(n).*.then) && isPlainPointer(ast.node(n).*.els)
    }
    if ast.kindOf(n) == ast.FUNCALL {
        // (std::move(x) is written as x: as plain as x.)
        if isMoveCall(n) && ast.node(n).*.args != 0 { return isPlainPointer(ast.node(n).*.args) }
        // A call returning a reference: never null.
        const callee = ast.node(n).*.lhs
        if callee != 0 && ast.kindOf(callee) == ast.VAR {
            var ft = types.at(ast.obj(ast.node(callee).*.variable).*.ty)
            // (A variable that is a pointer to a function, a stream's
            // manipulator.)
            if ft.*.kind == types.PTR && ft.*.base != 0 { ft = types.at(ft.*.base) }
            return ft.*.kind == types.FUNC && ft.*.base != 0 && types.at(ft.*.base).*.kind == types.REF
        }
        // (Through a pointer, a virtual call: the function type it
        // points to.)
        if callee != 0 && ast.typeOf(callee) != 0 {
            var ft = ast.typeOf(callee)
            if types.at(ft).*.kind == types.PTR && types.at(ft).*.base != 0 { ft = types.at(ft).*.base }
            return types.at(ft).*.kind == types.FUNC && types.at(ft).*.base != 0 && types.at(types.at(ft).*.base).*.kind == types.REF
        }
        return false
    }
    // (A reference member, `int &head` of std::tie's tuple: never null.)
    if ast.kindOf(n) == ast.MEMBER { return types.at(ast.typeOf(n)).*.kind == types.REF || types.at(types.member(ast.node(n).*.member).*.ty).*.kind == types.REF }
    if ast.kindOf(n) == ast.ADDR {
        // (`&*p`, the object a pointer names: as plain as the pointer;
        // `&*(p + i)` is written `&p[i]`, plain.)
        const target = ast.node(n).*.lhs
        if target != 0 && ast.kindOf(target) == ast.DEREF && ast.node(target).*.lhs != 0 {
            const pointer = ast.node(target).*.lhs
            // (`&*this` as its base class's pointer: written plain.)
            if otherRecord(pointee(ast.node(n).*.ty), writtenPointee(pointer)) { return true }
            if ast.kindOf(uncast(pointer)) == ast.ADD && types.at(ast.typeOf(uncast(pointer))).*.kind == types.PTR { return true }
            return isPlainPointer(pointer)
        }
        return true
    }
    // (`p + i` is written `&p[i]`, `p - i` the pointer stepped back:
    // neither is optional.)
    if (ast.kindOf(n) == ast.ADD || ast.kindOf(n) == ast.SUB) && ast.typeOf(n) != 0 && types.at(ast.typeOf(n)).*.kind == types.PTR { return true }
    if ast.kindOf(n) != ast.VAR { return false }
    const obj = ast.obj(ast.node(n).*.variable)
    return obj.*.name == names.K_THIS || types.at(obj.*.ty).*.kind == types.REF
}

// An index from a byte offset the front end scaled (`i * size`, or a
// constant), back in elements.
// A node under the casts the front end wraps around it (an offset cast
// to a pointer's width, an address cast to another pointer type).
fn uncast(n: usize) -> usize {
    var e = n
    while e != 0 && ast.kindOf(e) == ast.CAST && ast.node(e).*.lhs != 0 { e = ast.node(e).*.lhs }
    return e
}

// An index expression as a usize (Mlx indexes with usize; a C index is
// an int of some width): a literal as it is, a 64-bit unsigned value as
// it is, the rest through @intCast.
fn putAsIndex(n: usize) -> void {
    const e = uncast(n)
    if ast.kindOf(e) == ast.NUM {
        putSigned(ast.node(e).*.value)
        return
    }
    const t = types.at(ast.typeOf(n))
    if isIntKind(t.*.kind) && t.*.unsigned && t.*.size == 8 {
        emitExpr(n)
        return
    }
    put("@intCast(usize, ")
    emitExpr(n)
    putByte(41)
}

fn putIndex(given: usize, elementSize: i64) -> void {
    const offset = uncast(given)
    if elementSize <= 1 {
        putAsIndex(offset)
        return
    }
    if ast.kindOf(offset) == ast.NUM {
        putSigned(ast.node(offset).*.value / elementSize)
        return
    }
    if ast.kindOf(offset) == ast.MUL {
        const m = ast.node(offset)
        const l = uncast(m.*.lhs)
        const r = uncast(m.*.rhs)
        if ast.kindOf(r) == ast.NUM && ast.node(r).*.value == elementSize {
            putAsIndex(l)
            return
        }
        if ast.kindOf(l) == ast.NUM && ast.node(l).*.value == elementSize {
            putAsIndex(r)
            return
        }
    }
    put("@intCast(usize, (")
    emitExpr(offset)
    put(" / ")
    putSigned(elementSize)
    put("))")
}

// `*p`: through an optional pointer `.?`, then `.*` for a record, `[0]`
// for a many-item pointer.
// std::min(a, b) / std::max(a, b) called with references and read
// through: the comparison inline (its arguments written twice: fine for
// variables and constants, noted for calls).
fn stdMinMax(call: usize) -> u8 {
    const callee = ast.node(call).*.lhs
    if callee == 0 || ast.kindOf(callee) != ast.VAR { return 0 }
    const obj = ast.obj(ast.node(callee).*.variable)
    if !obj.*.isFunction || !isStdFunction(obj) { return 0 }
    const first = ast.node(call).*.args
    if first == 0 || ast.node(first).*.next == 0 || ast.node(ast.node(first).*.next).*.next != 0 { return 0 }
    const name = base.nameOf(obj.*.name)
    if base.same(name, "min") { return 1 }
    if base.same(name, "max") { return 2 }
    return 0
}

// The value a reference argument refers to.
fn emitRefValue(given: usize) -> void {
    var n = given
    while true {
        if ast.kindOf(n) == ast.CAST && ast.node(n).*.lhs != 0 && (types.at(ast.typeOf(n)).*.kind == types.REF || types.at(ast.typeOf(n)).*.kind == types.PTR) {
            n = ast.node(n).*.lhs
        } else if ast.kindOf(n) == ast.COMMA {
            // `tmp = v, &tmp`: the store before the statement, the address.
            hoist(ast.node(n).*.lhs)
            n = ast.node(n).*.rhs
        } else {
            break
        }
    }
    if ast.kindOf(n) == ast.ADDR {
        const inner = ast.node(n).*.lhs
        if ast.kindOf(inner) == ast.DEREF && ast.kindOf(ast.node(inner).*.lhs) == ast.FUNCALL && stdMinMax(ast.node(inner).*.lhs) != 0 {
            emitMinMax(ast.node(inner).*.lhs)
            return
        }
        if ast.kindOf(inner) == ast.FUNCALL { note("an argument of std::min/max is a call, written twice") }
        emitExpr(inner)
        return
    }
    // A reference or pointer value: read through.
    emitExpr(n)
    const t = types.at(ast.typeOf(n))
    if t.*.kind == types.REF || t.*.kind == types.PTR { putDerefSuffix(ast.typeOf(n), isPlainPointer(n)) }
}

fn emitMinMax(call: usize) -> void {
    const which = stdMinMax(call)
    const a = ast.node(call).*.args
    const b = ast.node(a).*.next
    put("(if (")
    emitRefValue(a)
    put(if which == 1 { " < " } else { " > " })
    emitRefValue(b)
    put(") { ")
    const savedHoist = hoistOff
    hoistOff = true
    emitRefValue(a)
    put(" } else { ")
    emitRefValue(b)
    put(" })")
    hoistOff = savedHoist
}


// What follows a pointer-valued expression of type `ptrType` to reach
// the value: `.*` for a record (and a function), `[0]` for a many-item
// pointer, through `.?` first unless the pointer is known not null.
fn putDerefSuffix(ptrType: usize, plain: bool) -> void {
    const pt = types.at(ptrType)
    // (No pointer: the value itself, a bitCast's argument taken by value.)
    if pt.*.kind != types.PTR && pt.*.kind != types.REF && pt.*.kind != types.ARRAY { return }
    const target = types.at(pt.*.base)
    // (`(*fp)(x)`: the function pointer itself, called.)
    if target.*.kind == types.FUNC {
        if pt.*.kind != types.REF && !plain { put(".?") }
        return
    }
    const record = isRecordKind(target.*.kind)
    if pt.*.kind == types.REF || plain {
        put(if record { ".*" } else { "[0]" })
    } else {
        put(if record { ".?.*" } else { ".?[0]" })
    }
}

// std::max / std::min of a braced list (`std::max({a, b, c})`): the
// list is an initializer_list made over an array temporary; its elements'
// stores are hoisted, the comparison folded over the elements.
fn listArray(n: usize, array: *usize, length: *i64) -> void {
    if n == 0 { return }
    const node = ast.node(n)
    if node.*.kind == ast.VAR && array.* == 0 {
        const t = types.at(ast.obj(node.*.variable).*.ty)
        if t.*.kind == types.ARRAY && ast.obj(node.*.variable).*.isLocal {
            array.* = node.*.variable
            length.* = t.*.arrayLength
        }
    }
    listArray(node.*.lhs, array, length)
    listArray(node.*.rhs, array, length)
    listArray(node.*.cond, array, length)
    listArray(node.*.then, array, length)
    listArray(node.*.els, array, length)
    listArray(node.*.init, array, length)
    var b = node.*.body
    while b != 0 {
        listArray(b, array, length)
        b = ast.node(b).*.next
    }
    var a = node.*.args
    while a != 0 {
        listArray(a, array, length)
        a = ast.node(a).*.next
    }
}

// The assignments in a tree (the list's element stores), as statements
// before the current one.
fn hoistAssignments(n: usize) -> void {
    if n == 0 { return }
    const node = ast.node(n)
    if node.*.kind == ast.ASSIGN {
        // The list object made of the stores and its constructor
        // (`list = (stores, initializer_list(first, count))`): the stores
        // in it; an element's store itself.
        if isInitializerList(ast.typeOf(node.*.lhs)) { hoistAssignments(node.*.rhs) } else { hoist(n) }
        return
    }
    hoistAssignments(node.*.lhs)
    hoistAssignments(node.*.rhs)
    hoistAssignments(node.*.cond)
    hoistAssignments(node.*.then)
    hoistAssignments(node.*.els)
    hoistAssignments(node.*.init)
    var b = node.*.body
    while b != 0 {
        hoistAssignments(b)
        b = ast.node(b).*.next
    }
    var a = node.*.args
    while a != 0 {
        hoistAssignments(a)
        a = ast.node(a).*.next
    }
}

fn putElement(array: usize, k: i64) -> void {
    putLocal(array)
    putByte(91)
    putSigned(k)
    putByte(93)
}

// max(a[k], max(a[k+1], ...)) from element k on.
fn putListFold(array: usize, k: i64, length: i64, which: u8) -> void {
    if k + 1 >= length {
        putElement(array, k)
        return
    }
    put("(if (")
    putElement(array, k)
    put(if which == 1 { " < " } else { " > " })
    putListFold(array, k + 1, length, which)
    put(") { ")
    putElement(array, k)
    put(" } else { ")
    putListFold(array, k + 1, length, which)
    put(" })")
}

// A compact dump of a tree into the notes (the translator's own eyes).
fn noteTree(n: usize, depth: usize) -> void {
    if n == 0 || depth > 12 { return }
    const node = ast.node(n)
    putTo(&notes, "//   ")
    var d: usize = 0
    while d < depth {
        putTo(&notes, ". ")
        d += 1
    }
    putTo(&notes, "kind ")
    var digits: [8]u8 = undefined
    var count: usize = 0
    var rest: usize = @intCast(usize, node.*.kind)
    while true {
        digits[7 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    const dp: [*]u8 = &digits
    putTo(&notes, dp[8 - count..8])
    if node.*.kind == ast.VAR && node.*.variable != 0 {
        putTo(&notes, " ")
        putTo(&notes, base.nameOf(ast.obj(node.*.variable).*.name))
    }
    if node.*.kind == ast.FUNCALL && node.*.lhs != 0 && ast.kindOf(node.*.lhs) == ast.VAR {
        putTo(&notes, " call ")
        putTo(&notes, base.nameOf(ast.obj(ast.node(node.*.lhs).*.variable).*.name))
    }
    putTo(&notes, "\n")
    noteTree(node.*.lhs, depth + 1)
    noteTree(node.*.rhs, depth + 1)
    noteTree(node.*.cond, depth + 1)
    noteTree(node.*.then, depth + 1)
    noteTree(node.*.els, depth + 1)
    var a = node.*.args
    while a != 0 {
        noteTree(a, depth + 1)
        a = ast.node(a).*.next
    }
}

fn emitListMinMax(call: usize, which: u8) -> bool {
    const arg = ast.node(call).*.args
    var array: usize = 0
    var length: i64 = 0
    listArray(arg, &array, &length)
    if array == 0 || length < 1 || length > 16 { return false }
    // The argument is `zeroing, ((store, store), store), list`
    // (cpp.listTemporary): the element stores before the statement, the
    // list object itself left out.
    hoistAssignments(arg)
    putListFold(array, 0, length, which)
    return true
}

fn isStdArrayIndexCall(call: usize) -> bool {
    const callee = ast.node(call).*.lhs
    if callee == 0 || ast.kindOf(callee) != ast.VAR { return false }
    const obj = ast.obj(ast.node(callee).*.variable)
    if !obj.*.isFunction || obj.*.classType == 0 || !isStdArray(obj.*.classType) { return false }
    const name = base.nameOf(obj.*.name)
    const first = ast.node(call).*.args
    if first == 0 || ast.node(first).*.next == 0 || ast.node(ast.node(first).*.next).*.next != 0 { return false }
    return base.same(name, "operator[]") || base.same(name, "at")
}

// A call of a C function with `...` the Mlx has no words for (sscanf,
// syscall).
fn isVariadicCall(call: usize) -> bool {
    const callee = ast.node(call).*.lhs
    if callee == 0 || ast.kindOf(callee) != ast.VAR { return false }
    const obj = ast.obj(ast.node(callee).*.variable)
    return obj.*.isFunction && types.at(obj.*.ty).*.variadic && obj.*.body == 0 && !takesWords(obj)
}

fn isMoveCall(call: usize) -> bool {
    const callee = ast.node(call).*.lhs
    if callee == 0 || ast.kindOf(callee) != ast.VAR { return false }
    const obj = ast.obj(ast.node(callee).*.variable)
    if !obj.*.isFunction || !isStdFunction(obj) { return false }
    const name = base.nameOf(obj.*.name)
    return base.same(name, "move") || base.same(name, "forward")
}

fn emitDeref(n: usize) -> void {
    const node = ast.node(n)
    if node.*.lhs == 0 {
        put("0")
        note("a dereference of nothing")
        return
    }
    if ast.kindOf(node.*.lhs) == ast.VA_ARG {
        emitVaArg(node.*.lhs)
        return
    }
    if ast.typeOf(node.*.lhs) != 0 && types.at(ast.typeOf(node.*.lhs)).*.kind == types.ARRAY && (isVaRecord(types.at(ast.typeOf(node.*.lhs)).*.base) || ast.kindOf(node.*.lhs) == ast.VAR || ast.kindOf(node.*.lhs) == ast.MEMBER) {
        // (va_copy's `*list` of a va_list, an array of one; `*rows` of
        // an array of arrays: its first.)
        emitLvalue(node.*.lhs)
        put("[0]")
        return
    }
    if ast.kindOf(node.*.lhs) == ast.FUNCALL && stdMinMax(node.*.lhs) != 0 {
        emitMinMax(node.*.lhs)
        return
    }
    if ast.kindOf(node.*.lhs) == ast.ADDR {
        // `*&x`: x; as another record (`static_cast<Base &>(*this)`),
        // x's bytes as that record.
        const named = ast.node(node.*.lhs).*.lhs
        if node.*.ty != 0 && ast.typeOf(named) != 0 && otherRecord(node.*.ty, ast.typeOf(named)) {
            put("unsafe { @ptrCast(*")
            putType(types.unqualified(node.*.ty))
            put(", &")
            emitLvalue(named)
            put(") }.*")
            return
        }
        emitLvalue(named)
        return
    }
    if ast.kindOf(node.*.lhs) == ast.FUNCALL && isStdArrayIndexCall(node.*.lhs) {
        // `*array[i]` (std::array's operator[] read through): the element.
        const call = ast.node(node.*.lhs)
        emitRefValue(call.*.args)
        putByte(91)
        putAsIndex(ast.node(call.*.args).*.next)
        putByte(93)
        return
    }
    if ast.kindOf(node.*.lhs) == ast.FUNCALL && isMoveCall(node.*.lhs) {
        // `*std::move(x)`, `*std::forward<T>(x)`: x (a temporary made
        // for it, `(tmp = value, &tmp)`: made before, then tmp).
        var arg = uncast(ast.node(node.*.lhs).*.args)
        while ast.kindOf(arg) == ast.COMMA && ast.node(arg).*.rhs != 0 {
            hoist(ast.node(arg).*.lhs)
            arg = uncast(ast.node(arg).*.rhs)
        }
        if ast.kindOf(arg) == ast.ADDR {
            emitLvalue(ast.node(arg).*.lhs)
        } else {
            emitExpr(arg)
            putDerefSuffix(ast.typeOf(arg), isPlainPointer(arg))
        }
        return
    }
    if ast.kindOf(node.*.lhs) == ast.ADD && emitIndexed(node.*.lhs) { return }
    // (`*(const T *)(p + i)`, the sum under a cast that keeps the
    // element: the element all the same.)
    const under = uncast(node.*.lhs)
    if under != node.*.lhs && ast.kindOf(under) == ast.ADD && sameElement(ast.typeOf(under), ast.typeOf(node.*.lhs)) && emitIndexed(under) { return }
    // (`*this` as its base class, the object read as another record
    // without a cast in the tree: the pointer as that record's.)
    if node.*.ty != 0 && otherRecord(node.*.ty, writtenPointee(node.*.lhs)) {
        putAsRecordPointer(node.*.ty, node.*.lhs)
        put(".*")
        return
    }
    emitExpr(node.*.lhs)
    putDerefSuffix(ast.typeOf(node.*.lhs), isPlainPointer(node.*.lhs))
}

// What a pointer or reference type points to (0 for another type).
fn pointee(ty: usize) -> usize {
    if ty == 0 { return 0 }
    const t = types.at(ty)
    if t.*.kind != types.PTR && t.*.kind != types.REF { return 0 }
    return t.*.base
}

// What a pointer expression points to as the Mlx has it: a variable's
// declared type (the front end types `this` as the base's pointer where
// a base is meant, without a cast), else the expression's.
fn writtenPointee(n: usize) -> usize {
    if ast.kindOf(n) == ast.VAR { return pointee(ast.obj(ast.node(n).*.variable).*.ty) }
    return pointee(ast.typeOf(n))
}

// A pointer as the plain pointer of the record `record`.
fn putAsRecordPointer(record: usize, pointer: usize) -> void {
    put("unsafe { @ptrCast(*")
    putType(types.unqualified(record))
    put(", ")
    emitExpr(pointer)
    if !isPlainPointer(pointer) { put(".?") }
    put(") }")
}

// Whether two pointer types name the same element (const aside).
fn sameElement(first: usize, second: usize) -> bool {
    if first == 0 || second == 0 { return false }
    const a = types.at(first)
    const b = types.at(second)
    if a.*.kind != types.PTR || b.*.kind != types.PTR || a.*.base == 0 || b.*.base == 0 { return false }
    return types.compatible(a.*.base, b.*.base)
}

// `p + i` with p a pointer or an array, as the element it names
// (`a[i]`: the C++ front end scales the offset by the element's size; the
// index is taken back). False when the sum is not that.
// The base of an index: an array or a many-item pointer as it is; a
// pointer to a record is a single-item pointer `*S` in the Mlx (see
// putPointer), so C's `items[i]` on one goes through a many-item view.
// The array a `data()` or `begin()` call of std::array is made on, when
// the object is at hand (`&a` its argument): the node of `a`, else 0.
fn stdArrayObject(n: usize) -> usize {
    const call = uncast(n)
    if call == 0 || ast.kindOf(call) != ast.FUNCALL { return 0 }
    const callee = ast.node(call).*.lhs
    if callee == 0 || ast.kindOf(callee) != ast.VAR { return 0 }
    const obj = ast.obj(ast.node(callee).*.variable)
    if !obj.*.isFunction || obj.*.classType == 0 || !isStdArray(obj.*.classType) { return 0 }
    const name = base.nameOf(obj.*.name)
    if !base.same(name, "data") && !base.same(name, "begin") { return 0 }
    const first = ast.node(call).*.args
    if first == 0 || ast.node(first).*.next != 0 || ast.kindOf(uncast(first)) != ast.ADDR { return 0 }
    return ast.node(uncast(first)).*.lhs
}

fn emitIndexBase(baseExpr: usize) -> void {
    // (`array.data() + i`: the Mlx array indexed.)
    const array = stdArrayObject(baseExpr)
    if array != 0 {
        emitLvalue(array)
        return
    }
    const bt = types.at(ast.typeOf(baseExpr))
    // (A sum again, `(p + i) + j` with the element changed between: the
    // first element's address as a many-item pointer.)
    const under = uncast(baseExpr)
    if bt.*.kind == types.PTR && under != 0 && ast.kindOf(under) == ast.ADD && ast.typeOf(under) != 0 && types.at(ast.typeOf(under)).*.kind == types.PTR && !isRecordKind(types.at(bt.*.base).*.kind) {
        put("unsafe { @ptrCast([*]")
        if types.at(bt.*.base).*.kind == types.VOID { put("u8") } else { putType(bt.*.base) }
        put(", ")
        emitExpr(under)
        put(") }")
        return
    }
    // (A pointer to an array stepped, `T (*)[16]` over an array of
    // arrays: the Mlx pointer to an array indexes the array's elements,
    // so the arrays are indexed through a many-item view too.)
    if bt.*.kind == types.PTR && ((isRecordKind(types.at(bt.*.base).*.kind) && !isStdArray(bt.*.base) && !isCStream(bt.*.base)) || types.at(bt.*.base).*.kind == types.ARRAY) {
        put("unsafe { @ptrCast([*]")
        putType(bt.*.base)
        put(", ")
        emitExpr(baseExpr)
        if !isPlainPointer(baseExpr) { put(".?") }
        put(") }")
        return
    }
    // (`(&pixel.R)[ch]`: one object's address indexed, the objects
    // after it read as its array.)
    if bt.*.kind == types.PTR && under != 0 && ast.kindOf(under) == ast.ADDR && ast.node(under).*.lhs != 0 && ast.typeOf(ast.node(under).*.lhs) != 0 {
        const single = ast.node(under).*.lhs
        const st = types.at(ast.typeOf(single))
        const literal = ast.kindOf(uncast(single)) == ast.VAR && (ast.obj(ast.node(uncast(single)).*.variable).*.isLiteral || ast.obj(ast.node(uncast(single)).*.variable).*.isTable)
        if st.*.kind != types.ARRAY && !isRecordKind(st.*.kind) && ast.kindOf(single) != ast.DEREF && ast.kindOf(uncast(single)) != ast.COND && !literal && types.at(bt.*.base).*.kind != types.VOID && types.at(bt.*.base).*.kind != types.FUNC {
            put("unsafe { @ptrCast([*]")
            putType(bt.*.base)
            put(", ")
            emitExpr(under)
            put(") }")
            return
        }
    }
    emitExpr(baseExpr)
    if bt.*.kind == types.PTR && !isPlainPointer(baseExpr) { put(".?") }
}

// `p - n`: the element before (`&p[i - n]` for `(p + i) - n`, else the
// many-item pointer stepped back).
fn emitPointerStep(n: usize) -> void {
    const node = ast.node(n)
    const lhs = node.*.lhs
    const lt = types.at(ast.typeOf(lhs))
    const size: i64 = if lt.*.kind == types.PTR || lt.*.kind == types.ARRAY { types.at(lt.*.base).*.size } else { 1 }
    if ast.kindOf(uncast(lhs)) == ast.ADD && types.at(ast.typeOf(uncast(lhs))).*.kind == types.PTR {
        const inner = ast.node(uncast(lhs))
        putByte(38)
        emitIndexBase(inner.*.lhs)
        putByte(91)
        putIndex(inner.*.rhs, size)
        put(" - ")
        putIndex(node.*.rhs, size)
        putByte(93)
        return
    }
    putByte(40)
    emitIndexBase(lhs)
    put(" - ")
    putIndex(node.*.rhs, size)
    putByte(41)
}

// A byte offset's value when it is a constant (a number, under casts
// and products of numbers), else 0.
fn constantOffset(given: usize) -> i64 {
    const n = uncast(given)
    if n == 0 { return 0 }
    if ast.kindOf(n) == ast.NUM { return ast.node(n).*.value }
    if ast.kindOf(n) == ast.NEG { return 0 - constantOffset(ast.node(n).*.lhs) }
    if ast.kindOf(n) == ast.MUL { return constantOffset(ast.node(n).*.lhs) * constantOffset(ast.node(n).*.rhs) }
    return 0
}

// A pointer expression under `&*`: `&*p` (`&p[0]` in the C++) is p, also
// under a cast that keeps the element (`reinterpret_cast<const uint8_t
// *>(&input[0])` of a `const uint8_t *input`).
fn underAddressOfDeref(given: usize) -> usize {
    var n = given
    while n != 0 {
        var m = n
        while ast.kindOf(m) == ast.CAST && ast.node(m).*.lhs != 0 && ast.typeOf(m) != 0 && ast.typeOf(ast.node(m).*.lhs) != 0 && types.at(ast.typeOf(m)).*.kind == types.PTR && types.at(ast.typeOf(ast.node(m).*.lhs)).*.kind == types.PTR && sameElement(ast.typeOf(m), ast.typeOf(ast.node(m).*.lhs)) {
            m = ast.node(m).*.lhs
        }
        if !(ast.kindOf(m) == ast.ADDR && ast.node(m).*.lhs != 0 && ast.kindOf(ast.node(m).*.lhs) == ast.DEREF && ast.node(ast.node(m).*.lhs).*.lhs != 0 && ast.typeOf(ast.node(ast.node(m).*.lhs).*.lhs) != 0 && types.at(ast.typeOf(ast.node(ast.node(m).*.lhs).*.lhs)).*.kind == types.PTR && sameElement(ast.typeOf(m), ast.typeOf(ast.node(ast.node(m).*.lhs).*.lhs))) { break }
        n = ast.node(ast.node(m).*.lhs).*.lhs
    }
    return n
}

// Set by the writer of a pointer sum's value (`&a[i]`), read and cleared
// by emitIndexed: the element is only addressed, not read.
var addressOnly = false

// Whether an offset is a constant inside an array of `length` elements.
fn constantIndexWithin(offset: usize, elementSize: i64, length: i64) -> bool {
    const n = uncast(offset)
    if n == 0 || ast.kindOf(n) != ast.NUM { return false }
    const index = ast.node(n).*.value / (if elementSize > 1 { elementSize } else { 1 })
    return index >= 0 && index < length
}

// An array as the base of an index. Where the element is only addressed
// (`a + n`, which may be the address after the last: `std::sort(a, a +
// 4)`) and the index is no constant inside the array, the array is
// indexed as a many-item pointer: Mlx checks an array's index.
fn putArrayBase(array: usize, offset: usize, elementSize: i64, address: bool) -> void {
    const at = types.at(ast.typeOf(array))
    if address && at.*.kind == types.ARRAY && !constantIndexWithin(offset, elementSize, at.*.arrayLength) {
        put("unsafe { @ptrCast([*]")
        putType(at.*.base)
        put(", &")
        emitLvalue(array)
        put(") }")
        return
    }
    emitLvalue(array)
}

fn emitIndexed(add: usize) -> bool {
    {
        const address = addressOnly
        addressOnly = false
        const sum = ast.node(add)
        var baseExpr = underAddressOfDeref(sum.*.lhs)
        // (`(p + i) + j`: p indexed by i + j.)
        if ast.kindOf(uncast(baseExpr)) == ast.ADD && types.at(ast.typeOf(uncast(baseExpr))).*.kind == types.PTR {
            const inner = ast.node(uncast(baseExpr))
            const it = types.at(ast.typeOf(inner.*.lhs))
            const innerSize: i64 = if it.*.kind == types.PTR || it.*.kind == types.ARRAY { types.at(it.*.base).*.size } else { 1 }
            emitIndexBase(inner.*.lhs)
            putByte(91)
            putIndex(inner.*.rhs, innerSize)
            put(" + ")
            putIndex(sum.*.rhs, innerSize)
            putByte(93)
            return true
        }
        var bt = types.at(ast.typeOf(baseExpr))
        var elementSize: i64 = if bt.*.kind == types.PTR || bt.*.kind == types.ARRAY { types.at(bt.*.base).*.size } else { 1 }
        // (`(const E *)&array + i`: the array under the cast.)
        if bt.*.kind == types.PTR && ast.kindOf(baseExpr) == ast.CAST && ast.kindOf(uncast(baseExpr)) == ast.ADDR && types.at(ast.typeOf(ast.node(uncast(baseExpr)).*.lhs)).*.kind == types.ARRAY && types.at(types.at(ast.typeOf(ast.node(uncast(baseExpr)).*.lhs)).*.base).*.size == elementSize {
            baseExpr = uncast(baseExpr)
        }
        // (`array + i` with the array decayed to a pointer by a cast: the
        // array indexed.)
        if bt.*.kind == types.PTR && ast.kindOf(baseExpr) == ast.CAST {
            const decayed = uncast(baseExpr)
            const dt = types.at(ast.typeOf(decayed))
            if dt.*.kind == types.ARRAY && types.at(dt.*.base).*.size == elementSize {
                putArrayBase(decayed, sum.*.rhs, elementSize, address)
                putByte(91)
                putIndex(sum.*.rhs, elementSize)
                putByte(93)
                return true
            }
        }
        if bt.*.kind == types.PTR && ast.kindOf(baseExpr) == ast.ADDR && types.at(ast.typeOf(ast.node(baseExpr).*.lhs)).*.kind == types.ARRAY {
            // `&array + i`: the array indexed.
            baseExpr = ast.node(baseExpr).*.lhs
            bt = types.at(ast.typeOf(baseExpr))
            elementSize = types.at(bt.*.base).*.size
            putArrayBase(baseExpr, sum.*.rhs, elementSize, address)
            putByte(91)
            putIndex(sum.*.rhs, elementSize)
            putByte(93)
            return true
        }
        if bt.*.kind == types.PTR && constantOffset(sum.*.rhs) < 0 {
            // `p[-1]` (the front end's `*p++` reads so): the pointer
            // stepped back, a usize index cannot be negative.
            putByte(40)
            emitIndexBase(baseExpr)
            put(" - ")
            putNumber(@bitCast(u64, (0 - constantOffset(sum.*.rhs)) / (if elementSize > 1 { elementSize } else { 1 })))
            put(")[0]")
            return true
        }
        if bt.*.kind == types.ARRAY && stdArrayObject(baseExpr) == 0 {
            putArrayBase(baseExpr, sum.*.rhs, elementSize, address)
            putByte(91)
            putIndex(sum.*.rhs, elementSize)
            putByte(93)
            return true
        }
        if bt.*.kind == types.ARRAY || bt.*.kind == types.PTR {
            emitIndexBase(baseExpr)
            putByte(91)
            putIndex(sum.*.rhs, elementSize)
            putByte(93)
            return true
        }
    }
    return false
}

// An expression written where it is assigned to (a bit-field read is
// widened, a bit-field written is not).
fn emitLvalue(n: usize) -> void {
    if ast.kindOf(n) == ast.MEMBER {
        const node = ast.node(n)
        const member = types.member(node.*.member)
        // (A base-class subobject: the object's bytes that are the
        // base's, as the base's record.)
        if member.*.isBase {
            putBaseAddress(n)
            put(".*")
            return
        }
        // (std::array's storage: the Mlx array itself.)
        const arrayType = ast.typeOf(node.*.lhs)
        if arrayType != 0 && isStdArray(types.unqualified(arrayType)) {
            emitExpr(node.*.lhs)
            return
        }
        // (Through a base class: the base's members are the object's own.)
        var object = node.*.lhs
        while ast.kindOf(object) == ast.MEMBER && types.member(ast.node(object).*.member).*.isBase { object = ast.node(object).*.lhs }
        emitExpr(object)
        putByte(46)
        // (Where the record lies in the object: the base classes it is
        // reached through.)
        var base: i64 = 0
        var inner = node.*.lhs
        while ast.kindOf(inner) == ast.MEMBER && types.member(ast.node(inner).*.member).*.isBase {
            base += types.member(ast.node(inner).*.member).*.offset
            inner = ast.node(inner).*.lhs
        }
        const lhsType = ast.typeOf(node.*.lhs)
        const owner = if lhsType != 0 { types.unqualified(lhsType) } else { 0 }
        if member.*.bitWidth > 0 {
            const word = if owner != 0 { wordOf(owner, node.*.member) } else { Word.{ .start = 0, .size = 0, .first = 0 } }
            if word.first == 0 || word.size == 0 {
                note("a bit-field without a word of its own is read or written")
                put("bits")
            } else {
                putWordName(owner, word, base)
            }
            putByte(46)
        }
        if member.*.name == 0 { putUnnamed(owner, node.*.member, base) } else { putFieldName(owner, member.*.name) }
        return
    }
    emitExpr(n)
}

// The address of a base-class subobject (`n`: the object's member that is
// the base). The base's members are the object's own: the object's
// address as the base's, moved to where the base lies when that is not
// the object's start (a second base, a base of one).
fn baseOffset(n: usize) -> i64 {
    var offset: i64 = 0
    var object = n
    while ast.kindOf(object) == ast.MEMBER && types.member(ast.node(object).*.member).*.isBase {
        offset += types.member(ast.node(object).*.member).*.offset
        object = ast.node(object).*.lhs
    }
    return offset
}

fn putBaseAddress(n: usize) -> void {
    var offset: i64 = 0
    var object = n
    while ast.kindOf(object) == ast.MEMBER && types.member(ast.node(object).*.member).*.isBase {
        offset += types.member(ast.node(object).*.member).*.offset
        object = ast.node(object).*.lhs
    }
    put("unsafe { @ptrCast(*")
    putType(types.unqualified(ast.typeOf(n)))
    put(", &")
    if offset == 0 {
        emitLvalue(object)
    } else {
        put("unsafe { @ptrCast([*]u8, &")
        emitLvalue(object)
        put(") }[")
        putNumber(@bitCast(u64, offset))
        putByte(93)
    }
    put(") }")
}

// A branch of `c ? a : b`. Of pointers, both sides are given the
// expression's type (`p ? p + 16 : nullptr`, the cast to a second base:
// a plain address on one side and null on the other have no type in
// common in the Mlx).
fn emitBranch(n: usize, ty: usize) -> void {
    if types.at(ty).*.kind != types.PTR {
        emitExpr(n)
        return
    }
    const value = uncast(n)
    if value != 0 && (ast.kindOf(value) == ast.NULL_EXPR || (ast.kindOf(value) == ast.NUM && ast.node(value).*.value == 0)) {
        put("null")
        return
    }
    put("unsafe { @ptrCast(")
    putType(ty)
    put(", ")
    emitExpr(n)
    put(") }")
}

// A vtable's address: its address point, the word a vtable pointer
// names.
fn putTableAddress(o: usize) -> void {
    const table = ast.obj(o)
    if !inMainFile(table.*.token) { noteHeaderGlobal(o) }
    put("unsafe { @ptrCast(?[*]?[*]u8, &")
    putHomePrefix(functionEntry(table))
    putGlobalName(table)
    putByte(91)
    putNumber(@bitCast(u64, table.*.addressPoint / 8))
    put("]) }")
}

// Whether two pointed-to types are different records (const aside).
fn otherRecord(first: usize, second: usize) -> bool {
    if first == 0 || second == 0 { return false }
    const a = types.unqualified(first)
    const b = types.unqualified(second)
    if !isRecordKind(types.at(a).*.kind) || !isRecordKind(types.at(b).*.kind) { return false }
    return !sameStruct(a, b)
}

// Where the base class `wanted` lies in an object of `derived`: its
// offset, -1 when it is no base of it.
fn offsetOfBase(derived: usize, wanted: usize, depth: usize) -> i64 {
    if derived == 0 || wanted == 0 || depth > 16 { return -1 }
    var m = types.at(types.unqualified(derived)).*.members
    while m != 0 {
        const member = types.member(m)
        if member.*.isBase {
            if sameStruct(types.unqualified(member.*.ty), types.unqualified(wanted)) { return member.*.offset }
            const inner = offsetOfBase(member.*.ty, wanted, depth + 1)
            if inner >= 0 { return member.*.offset + inner }
        }
        m = member.*.next
    }
    return -1
}

// The record an argument's pointer is of in the Mlx, when the argument
// is an object's address or a variable (the front end types `&derived`
// as the base's pointer where a base is wanted, without a cast): 0
// otherwise.
fn argumentRecord(argument: usize) -> usize {
    if ast.kindOf(argument) == ast.ADDR && ast.node(argument).*.lhs != 0 {
        const target = ast.node(argument).*.lhs
        if ast.kindOf(target) != ast.VAR && ast.kindOf(target) != ast.MEMBER { return 0 }
        if ast.kindOf(target) == ast.MEMBER && types.member(ast.node(target).*.member).*.isBase { return 0 }
        const ty = if ast.kindOf(target) == ast.VAR { ast.obj(ast.node(target).*.variable).*.ty } else { ast.typeOf(target) }
        if ty == 0 { return 0 }
        const record = types.unqualified(ty)
        return if isRecordKind(types.at(record).*.kind) && !isStdArray(record) { record } else { 0 }
    }
    if ast.kindOf(argument) == ast.VAR && ast.obj(ast.node(argument).*.variable).*.isLocal {
        const record = writtenPointee(argument)
        if record == 0 { return 0 }
        const plain = types.unqualified(record)
        return if isRecordKind(types.at(plain).*.kind) && !isStdArray(plain) { plain } else { 0 }
    }
    return 0
}

fn emitCast(n: usize) -> void {
    const node = ast.node(n)
    const to = node.*.ty
    const from = ast.typeOf(node.*.lhs)
    const tt = types.at(to)
    const ft = types.at(from)
    const tk = tt.*.kind
    const fk = ft.*.kind
    if tk == types.VOID {
        emitExpr(node.*.lhs)
        return
    }
    if tk == types.BOOL {
        emitCond(node.*.lhs)
        return
    }
    // (The front end's wide integer, `_BitInt(130)` of the overflow
    // builtins: 128 bits in the Mlx, enough for two 64-bit operands'
    // sum, difference and product to tell an overflow; a signed value
    // goes in with its sign.)
    if tk == types.WIDE && fk == types.WIDE {
        emitExpr(node.*.lhs)
        return
    }
    if tk == types.WIDE && (isIntKind(fk) || fk == types.BOOL) {
        if fk == types.BOOL {
            put("(if ")
            emitCond(node.*.lhs)
            put(" { @intCast(u128, 1) } else { @intCast(u128, 0) })")
        } else if ft.*.unsigned {
            put("@intCast(u128, ")
            emitExpr(node.*.lhs)
            putByte(41)
        } else {
            put("@bitCast(u128, @intCast(i128, ")
            emitExpr(node.*.lhs)
            put("))")
        }
        return
    }
    if fk == types.WIDE && isIntKind(tk) {
        put("@intCast(")
        putType(to)
        put(", ")
        emitExpr(node.*.lhs)
        putByte(41)
        return
    }
    if tk == types.REF {
        // Binding a reference: the operand is the address already. As
        // another record's (a base's reference from the object's, a
        // record read where another lies): the address as that one's.
        if (fk == types.PTR || fk == types.REF) && otherRecord(tt.*.base, ft.*.base) {
            put("unsafe { @ptrCast(")
            putPointer(tt.*.base, false)
            put(", ")
            emitExpr(node.*.lhs)
            if !isPlainPointer(node.*.lhs) { put(".?") }
            put(") }")
            return
        }
        // (Bytes read as a record, `(Base &)*((char *)&object + 16)`,
        // a base class's part where the front end adds its offset.)
        if fk == types.PTR && tt.*.base != 0 && ft.*.base != 0 && isRecordKind(types.at(types.unqualified(tt.*.base)).*.kind) && !isStdArray(types.unqualified(tt.*.base)) && !isRecordKind(types.at(types.unqualified(ft.*.base)).*.kind) && types.at(ft.*.base).*.kind != types.PTR && types.at(ft.*.base).*.kind != types.ARRAY && types.at(ft.*.base).*.kind != types.FUNC {
            put("unsafe { @ptrCast(")
            putPointer(tt.*.base, false)
            put(", ")
            emitExpr(node.*.lhs)
            if !isPlainPointer(node.*.lhs) { put(".?") }
            put(") }")
            return
        }
        emitExpr(node.*.lhs)
        return
    }
    const toInt = isIntKind(tk)
    const fromInt = isIntKind(fk) || fk == types.BOOL
    const toFloat = isFloatKind(tk)
    const fromFloat = isFloatKind(fk)
    const toPtr = tk == types.PTR
    const fromPtr = fk == types.PTR || fk == types.ARRAY || fk == types.FUNC || fk == types.REF
    if toInt && fromInt {
        if fk == types.BOOL {
            // (A bool as a number: 1 or 0 of the target type.)
            put("(if ")
            emitCond(node.*.lhs)
            put(" { @intCast(")
            putType(node.*.ty)
            put(", 1) } else { @intCast(")
            putType(node.*.ty)
            put(", 0) })")
            return
        }
        // (`(size_t)-1`, `i + -1` on an unsigned: the number it wraps to.)
        if tt.*.unsigned && ast.kindOf(uncast(node.*.lhs)) == ast.NUM && ast.node(uncast(node.*.lhs)).*.value < 0 && !isFloatKind(types.at(ast.typeOf(uncast(node.*.lhs))).*.kind) {
            const bits = @intCast(u6, if tt.*.size >= 8 { 0 } else { tt.*.size * 8 })
            var wrapped = @bitCast(u64, ast.node(uncast(node.*.lhs)).*.value)
            if tt.*.size < 8 { wrapped = wrapped & ((@intCast(u64, 1) << bits) - 1) }
            putNumber(wrapped)
            return
        }
        if tt.*.size == ft.*.size && writtenUnsigned(tt) == writtenUnsigned(ft) {
            emitExpr(node.*.lhs)
            return
        }
        put(if tt.*.size == ft.*.size { "@bitCast(" } else { "@intCast(" })
        putType(to)
        put(", ")
        emitExpr(node.*.lhs)
        putByte(41)
        return
    }
    if toFloat && fromInt {
        if ast.kindOf(node.*.lhs) == ast.NUM {
            const v = ast.node(node.*.lhs).*.value
            if v < 0 { putByte(45) }
            putNumber(@bitCast(u64, if v < 0 { 0 -% v } else { v }))
            put(".0")
            return
        }
        put("@floatFromInt(")
        putType(to)
        put(", ")
        emitExpr(node.*.lhs)
        putByte(41)
        return
    }
    if toInt && fromFloat {
        put("@intFromFloat(")
        putType(to)
        put(", ")
        emitExpr(node.*.lhs)
        putByte(41)
        return
    }
    if toFloat && fromFloat {
        if tt.*.size == ft.*.size {
            emitExpr(node.*.lhs)
            return
        }
        put("@floatCast(")
        putType(to)
        put(", ")
        emitExpr(node.*.lhs)
        putByte(41)
        return
    }
    if toPtr && fromInt {
        if constantValue(node.*.lhs) == 0 && ast.kindOf(node.*.lhs) == ast.NUM {
            put("null")
            return
        }
        put("unsafe { @ptrFromInt(")
        putPointer(tt.*.base, false)
        put(", ")
        emitExpr(node.*.lhs)
        put(") }")
        return
    }
    if toInt && fromPtr {
        // (The address is a usize: as the integer type asked for.)
        if tt.*.size == 8 && !tt.*.unsigned {
            put("@bitCast(i64, @intFromPtr(")
        } else {
            put("@intCast(")
            putType(to)
            put(", @intFromPtr(")
        }
        emitExpr(node.*.lhs)
        put("))")
        return
    }
    if toPtr && fromPtr {
        if fk == types.ARRAY {
            // An array decayed to a pointer: a string literal's bytes'
            // pointer, else the array's address.
            const decayed = uncast(node.*.lhs)
            if ast.kindOf(decayed) == ast.VAR && ast.obj(ast.node(decayed).*.variable).*.isLiteral {
                putStringLiteral(ast.obj(ast.node(decayed).*.variable))
                put(".pointer")
                return
            }
            // (One of two arrays, `append ? "ab" : "wb"`: the address of
            // the one chosen, each as its kind is addressed.)
            if ast.kindOf(decayed) == ast.COND && ast.node(decayed).*.then != 0 && ast.node(decayed).*.els != 0 {
                emitAddressOf(decayed, to)
                return
            }
            if ast.kindOf(decayed) == ast.VAR && ast.obj(ast.node(decayed).*.variable).*.isTable {
                putTableAddress(ast.node(decayed).*.variable)
                return
            }
            // (An array of records as a pointer to its first: a record's
            // pointer is a single-item one.)
            if isRecordKind(types.at(ft.*.base).*.kind) && !isStdArray(ft.*.base) && !otherRecord(tt.*.base, ft.*.base) && isRecordKind(types.at(tt.*.base).*.kind) {
                putByte(38)
                emitExpr(node.*.lhs)
                put("[0]")
                return
            }
            // (An array read as another type's object, a record in its
            // bytes of storage, ints as bytes: the address as that
            // type's.)
            // (An array of arrays as its first row's elements too:
            // `reinterpret_cast<uint8_t *>(values)` of a [4][4].)
            if !types.compatible(tt.*.base, ft.*.base) && (types.at(ft.*.base).*.kind != types.ARRAY || types.at(tt.*.base).*.kind != types.ARRAY) {
                put("unsafe { @ptrCast(")
                putPointer(tt.*.base, false)
                put(", &")
                emitExpr(node.*.lhs)
                put(") }")
                return
            }
            putByte(38)
            emitExpr(node.*.lhs)
            return
        }
        // (const_cast: `const char *` as `char *`. The Mlx pointer says
        // the const of a scalar's and a byte's, so the cast is written.)
        // (Below the first pointer the two say the same const or the
        // cast is written: `const char *const *` as `char **`.)
        const dropsConst = fk == types.PTR && tk == types.PTR && ((writesConst(ft.*.base) && !writesConst(tt.*.base)) || constDiffersBelow(tt.*.base, ft.*.base))
        // (An object's address as its bytes, `(char *)&object`, is a
        // cast all the same: a record's pointer is no byte pointer.)
        const asBytes = fk == types.REF && ft.*.base != 0 && tt.*.base != 0 && isRecordKind(types.at(types.unqualified(ft.*.base)).*.kind) && !isRecordKind(types.at(types.unqualified(tt.*.base)).*.kind)
        if !dropsConst && !asBytes && ((fk == types.REF && !otherRecord(tt.*.base, ft.*.base)) || sameType(tt.*.base, ft.*.base)) {
            emitExpr(node.*.lhs)
            return
        }
        put("unsafe { @ptrCast(")
        // (A plain pointer stays one: a reference, an address, `this`.)
        // (`&*p` is as plain as p: isPlainPointer looks under it.)
        const plainSource = fk == types.REF || isPlainPointer(node.*.lhs)
        if plainSource && tk == types.PTR { putPointer(tt.*.base, false) } else { putType(to) }
        put(", ")
        emitExpr(node.*.lhs)
        put(") }")
        return
    }
    note("a cast the translator does not know")
    emitExpr(node.*.lhs)
}

fn putStringLiteral(obj: *ast.Obj) -> void {
    putByte(34)
    const length = types.at(obj.*.ty).*.arrayLength
    var k: usize = 0
    while length > 0 && k + 1 < @intCast(usize, length) {
        const byte = base.get8(obj.*.initData + k)
        if byte == 34 || byte == 92 {
            putByte(92)
            putByte(byte)
        } else if byte == 10 {
            put("\\n")
        } else if byte == 13 {
            put("\\r")
        } else if byte == 9 {
            put("\\t")
        } else if byte < 32 || byte >= 127 {
            put("\\x")
            const high = byte >> 4
            const low = byte & 15
            putByte(if high < 10 { 48 + high } else { 87 + high })
            putByte(if low < 10 { 48 + low } else { 87 + low })
        } else {
            putByte(byte)
        }
        k += 1
    }
    putByte(34)
}

// A float argument as f64 for std.math (and back for a float result).
fn putAsDouble(n: usize) -> void {
    if ast.kindOf(n) == ast.NUM || (ast.kindOf(n) == ast.CAST && ast.kindOf(ast.node(n).*.lhs) == ast.NUM) {
        emitExpr(n)
        return
    }
    if isIntKind(types.at(ast.typeOf(n)).*.kind) {
        // (std::log2 of an integer: C++ takes it as a double.)
        put("@floatFromInt(f64, ")
        emitExpr(n)
        putByte(41)
    } else if types.at(ast.typeOf(n)).*.size == 4 {
        put("@floatCast(f64, ")
        emitExpr(n)
        putByte(41)
    } else {
        emitExpr(n)
    }
}

// The calls the translator knows: ANGLE's bitCast, the standard
// library's math; true when written.
// std::numeric_limits<T>::max(), min(), lowest() for an integer T: the
// number itself.
fn emitNumericLimit(node: *ast.Node, obj: *ast.Obj) -> bool {
    if obj.*.classType == 0 || !isStdFunction(obj) { return false }
    const className = types.at(obj.*.classType).*.name
    if className == 0 || !containsText(base.nameOf(className), "numeric_limits") { return false }
    const name = base.nameOf(obj.*.name)
    const t = types.at(node.*.ty)
    if !isIntKind(t.*.kind) || t.*.size > 8 { return false }
    if t.*.size < 1 { return false }
    // (The sign bit's place: 7, 15, 31 or 63.)
    const top = @intCast(u6, t.*.size * 8 - 1)
    const signedMax = (@intCast(u64, 1) << top) - 1
    if base.same(name, "max") {
        if t.*.unsigned { putNumber(signedMax * 2 + 1) } else { putNumber(signedMax) }
        return true
    }
    if base.same(name, "min") || base.same(name, "lowest") {
        if t.*.unsigned {
            put("0")
        } else if t.*.size == 8 {
            // (An i64's lowest has no positive to negate.)
            put("(-9223372036854775807 - 1)")
        } else {
            putSigned(0 - @bitCast(i64, signedMax) - 1)
        }
        return true
    }
    return false
}

// std::array's methods on the Mlx array: data()/begin() its address (a
// many-item pointer), size() the length, [i]/at(i) the element's address
// (a reference, read through by the caller).
fn emitStdArrayCall(node: *ast.Node, obj: *ast.Obj) -> bool {
    if obj.*.classType == 0 || !isStdArray(obj.*.classType) { return false }
    const name = base.nameOf(obj.*.name)
    const first = node.*.args
    if first == 0 { return false }
    const second = ast.node(first).*.next
    const storage = types.at(stdArrayType(obj.*.classType))
    const length = @bitCast(u64, storage.*.arrayLength)
    const ofRecords = storage.*.base != 0 && isRecordKind(types.at(storage.*.base).*.kind)
    if second == 0 && (base.same(name, "data") || base.same(name, "begin") || base.same(name, "cbegin")) {
        // (Of records: the first one's address, a record's pointer being
        // a single-item one.)
        if ofRecords {
            put("unsafe { @ptrCast(*")
            putType(storage.*.base)
            put(", ")
            emitExpr(first)
            if !isPlainPointer(first) { put(".?") }
            put(") }")
            return true
        }
        emitExpr(first)
        return true
    }
    if second == 0 && (base.same(name, "end") || base.same(name, "cend")) {
        // The address after the last element.
        put("&unsafe { @ptrCast([*]")
        putType(storage.*.base)
        put(", ")
        emitExpr(first)
        if !isPlainPointer(first) { put(".?") }
        put(") }[")
        putNumber(length)
        putByte(93)
        return true
    }
    if second == 0 && (base.same(name, "front") || base.same(name, "back")) {
        putByte(38)
        emitRefValue(first)
        putByte(91)
        putNumber(if base.same(name, "back") && length > 0 { length - 1 } else { 0 })
        putByte(93)
        return true
    }
    if second == 0 && (base.same(name, "size") || base.same(name, "max_size")) {
        putNumber(length)
        return true
    }
    if second == 0 && base.same(name, "empty") {
        put(if length == 0 { "true" } else { "false" })
        return true
    }
    if second != 0 && ast.node(second).*.next == 0 && (base.same(name, "operator[]") || base.same(name, "at")) {
        putByte(38)
        emitRefValue(first)
        putByte(91)
        putAsIndex(second)
        putByte(93)
        return true
    }
    return false
}

// The C library's math functions (`tanf`, `pow`, `floorf`) as std.math
// and the float builtins: the Mlx computes what mlxlibc's libm computes
// (compiler/libc/libm.mlx wraps the same std.math).
fn emitCMathCall(node: *ast.Node, obj: *ast.Obj) -> bool {
    if obj.*.classType != 0 || isStdFunction(obj) || obj.*.body != 0 { return false }
    var name = base.nameOf(obj.*.name)
    const first = node.*.args
    if first == 0 { return false }
    const second = ast.node(first).*.next
    // (The float versions end in f.)
    if name.length > 1 && name[name.length - 1] == 102 { name = name[0..name.length - 1] }
    const resultFloat = types.at(node.*.ty).*.size == 4
    if second == 0 && (base.same(name, "floor") || base.same(name, "ceil") || base.same(name, "sqrt")) {
        putByte(64)
        put(name)
        putByte(40)
        emitExpr(first)
        putByte(41)
        return true
    }
    const unary = base.same(name, "sin") || base.same(name, "cos") || base.same(name, "tan") || base.same(name, "exp") || base.same(name, "log2") || base.same(name, "log10") || base.same(name, "log")
    if second == 0 && unary {
        usesStd = true
        if resultFloat { put("@floatCast(f32, ") }
        put("math.")
        put(if base.same(name, "log") { "ln" } else { name })
        putByte(40)
        putAsDouble(first)
        putByte(41)
        if resultFloat { putByte(41) }
        return true
    }
    if second != 0 && ast.node(second).*.next == 0 && base.same(name, "pow") {
        usesStd = true
        if resultFloat { put("@floatCast(f32, ") }
        put("math.pow(")
        putAsDouble(first)
        put(", ")
        putAsDouble(second)
        putByte(41)
        if resultFloat { putByte(41) }
        return true
    }
    return false
}

// A C library function the runtime module has (memory, bytes, strings;
// C++'s operator new and delete over them): `c.NAME(...)`.
fn isCStreamName(name: []const u8) -> bool {
    return base.same(name, "stdin") || base.same(name, "stdout") || base.same(name, "stderr")
}

// The global allocation functions (the front end interns their names
// without the blank: `operatornew`, `operatordelete[]`).
fn isOperatorNew(name: []const u8) -> bool {
    return base.same(name, "operatornew") || base.same(name, "operatornew[]") || base.same(name, "operator new") || base.same(name, "operator new[]")
}

fn isOperatorDelete(name: []const u8) -> bool {
    return base.same(name, "operatordelete") || base.same(name, "operatordelete[]") || base.same(name, "operator delete") || base.same(name, "operator delete[]")
}

fn isRuntimeFunction(name: []const u8) -> bool {
    if startsWith(name, "pthread_mutex_") { return base.same(name, "pthread_mutex_init") || base.same(name, "pthread_mutex_destroy") || base.same(name, "pthread_mutex_lock") || base.same(name, "pthread_mutex_trylock") || base.same(name, "pthread_mutex_unlock") }
    if isRuntimeVariadic(name) { return true }
    // (A static local's guard.)
    if base.same(name, "__mlxcc_guard_acquire") || base.same(name, "__mlxcc_guard_release") { return true }
    const names = [32][]const u8{ "malloc", "calloc", "realloc", "free", "posix_memalign", "memcpy", "memmove", "memset", "memcmp", "strlen", "strcmp", "strncmp", "strchr", "abort", "fputs", "fputc", "putc", "puts", "fflush", "isdigit", "toupper", "tolower", "__errno_location", "strtol", "strtoul", "strtod", "atoi", "atof", "vsnprintf", "vsprintf", "vfprintf", "vprintf" }
    for known in names {
        if base.same(name, known) { return true }
    }
    return isOperatorNew(name) || isOperatorDelete(name)
}

fn emitRuntimeCall(node: *ast.Node, obj: *ast.Obj) -> bool {
    if obj.*.classType != 0 || obj.*.body != 0 { return false }
    const name = base.nameOf(obj.*.name)
    if !isRuntimeFunction(name) { return false }
    usesRuntime = true
    put("c.")
    if isOperatorNew(name) {
        put("malloc")
    } else if isOperatorDelete(name) {
        put("free")
    } else {
        put(name)
    }
    putByte(40)
    var a = node.*.args
    var first = true
    // (A C library's object, pthread's mutex, is its bytes to the
    // runtime.)
    const handles = startsWith(name, "pthread_")
    const words: usize = if isRuntimeVariadic(name) { firstVariableArgument(@intFromPtr(node)) } else { 0 }
    while a != 0 {
        if isRuntimeVariadic(name) && a == words { break }
        if !first { put(", ") }
        first = false
        if handles && ast.typeOf(a) != 0 && types.at(ast.typeOf(a)).*.kind == types.PTR {
            put("unsafe { @ptrCast(?[*]u8, ")
            emitExpr(a)
            put(") }")
        } else {
            emitExpr(a)
        }
        // (operator delete's second argument, the size, is not free's.)
        if isOperatorDelete(name) { break }
        a = ast.node(a).*.next
    }
    if isRuntimeVariadic(name) {
        if !first { put(", ") }
        emitVaWords(words)
    }
    putByte(41)
    return true
}

fn emitKnownCall(node: *ast.Node, obj: *ast.Obj) -> bool {
    if emitRuntimeCall(node, obj) { return true }
    if emitStdArrayCall(node, obj) { return true }
    if emitCMathCall(node, obj) { return true }
    const name = base.nameOf(obj.*.name)
    const first = node.*.args
    if first == 0 { return emitNumericLimit(node, obj) }
    const second = ast.node(first).*.next
    if obj.*.classType == 0 && base.same(name, "bitCast") && second == 0 {
        // gl::bitCast<T>(x): @bitCast (its argument a reference).
        put("@bitCast(")
        putType(node.*.ty)
        put(", ")
        if ast.kindOf(first) == ast.ADDR { emitExpr(ast.node(first).*.lhs) } else { emitDeref(first) }
        putByte(41)
        return true
    }
    if !isStdFunction(obj) { return false }
    if second == 0 && (base.same(name, "min") || base.same(name, "max")) {
        if emitListMinMax(@intFromPtr(node), if base.same(name, "min") { 1 } else { 2 }) { return true }
        note("std::min/max of a list the translator could not read")
        return false
    }
    if second == 0 && (base.same(name, "floor") || base.same(name, "ceil") || base.same(name, "sqrt")) {
        putByte(64)
        put(name)
        putByte(40)
        emitExpr(first)
        putByte(41)
        return true
    }
    const resultFloat = types.at(node.*.ty).*.size == 4
    if second != 0 && ast.node(second).*.next == 0 && base.same(name, "pow") {
        usesStd = true
        if resultFloat { put("@floatCast(f32, ") }
        put("math.pow(")
        putAsDouble(first)
        put(", ")
        putAsDouble(second)
        putByte(41)
        if resultFloat { putByte(41) }
        return true
    }
    if second == 0 && base.same(name, "log") {
        usesStd = true
        if resultFloat { put("@floatCast(f32, ") }
        put("math.ln(")
        putAsDouble(first)
        putByte(41)
        if resultFloat { putByte(41) }
        return true
    }
    if second == 0 && (base.same(name, "sin") || base.same(name, "cos") || base.same(name, "tan") || base.same(name, "exp") || base.same(name, "log2") || base.same(name, "log10")) {
        usesStd = true
        if resultFloat { put("@floatCast(f32, ") }
        put("math.")
        put(name)
        putByte(40)
        putAsDouble(first)
        putByte(41)
        if resultFloat { putByte(41) }
        return true
    }
    // std::move(x), std::forward<T>(x): x (a reference in, the same out).
    if second == 0 && (base.same(name, "move") || base.same(name, "forward")) {
        emitExpr(first)
        return true
    }
    // std::size(array): its length.
    if second == 0 && base.same(name, "size") {
        var at = ast.typeOf(first)
        if types.at(at).*.kind == types.PTR || types.at(at).*.kind == types.REF { at = types.at(at).*.base }
        if isStdArray(at) { at = stdArrayType(at) }
        if types.at(at).*.kind == types.ARRAY {
            putNumber(@bitCast(u64, types.at(at).*.arrayLength))
            return true
        }
    }
    return false
}

// A call whose class result comes through the hidden buffer, inside an
// expression: `buffer = call(...)` before the statement, the buffer here.
fn emitBufferedCall(n: usize) -> void {
    const node = ast.node(n)
    if hoistOff {
        emitCall(n)
        return
    }
    const savedOut = out
    const savedPre = pre
    out = emptyBuffer()
    pre = emptyBuffer()
    indent(level)
    putLocal(node.*.returnBuffer)
    put(" = ")
    emitCall(n)
    newline()
    const text = out
    const inner = pre
    out = savedOut
    pre = savedPre
    if inner.length > 0 { putTo(&pre, textOf(&inner)) }
    putTo(&pre, textOf(&text))
    putLocal(node.*.returnBuffer)
}

// `({ statements; value })` (the front end's `new T[n]`, `delete[] p`,
// a GNU statement expression): the statements written before the one
// this is part of, the value where it stands (nothing for a void one,
// which stands as a statement).
fn emitStatementExpression(n: usize) -> void {
    const node = ast.node(n)
    var last: usize = 0
    var s = node.*.body
    while s != 0 {
        last = s
        s = ast.node(s).*.next
    }
    const valued = last != 0 && ast.kindOf(last) == ast.EXPR_STMT && types.at(node.*.ty).*.kind != types.VOID
    s = node.*.body
    while s != 0 {
        if !(valued && s == last) { hoistStatement(s) }
        s = ast.node(s).*.next
    }
    if valued { emitExpr(ast.node(last).*.lhs) } else { put("{}") }
}

// A statement written before the current one (see hoist).
fn hoistStatement(s: usize) -> void {
    if hoistOff { return }
    const savedOut = out
    const savedPre = pre
    out = emptyBuffer()
    pre = emptyBuffer()
    emitStatement(s, level)
    const text = out
    const inner = pre
    out = savedOut
    pre = savedPre
    if inner.length > 0 { putTo(&pre, textOf(&inner)) }
    putTo(&pre, textOf(&text))
}

// A bit builtin (`__builtin_clz`, `__builtin_ctzll`, `__builtin_popcount`,
// `__builtin_bswap32`, `__builtin_ffs`): Mlx's @popCount, the runtime's
// for the others.
fn emitBitop(n: usize) -> void {
    const node = ast.node(n)
    const op = node.*.value
    if op == 3 {
        put("@intCast(i32, @popCount(")
        emitExpr(node.*.lhs)
        put("))")
        return
    }
    if op != 1 && op != 2 && op != 4 && op != 5 {
        note("a builtin the translator does not know (alloca)")
        put("0")
        return
    }
    usesRuntime = true
    if op == 4 {
        put("@intCast(")
        putType(node.*.ty)
        put(", ")
    }
    put(if op == 1 { "c.clz(" } else if op == 2 { "c.ctz(" } else if op == 4 { "c.bswap(" } else { "c.ffs(" })
    put("@intCast(u64, ")
    emitExpr(node.*.lhs)
    put("), ")
    putNumber(@bitCast(u64, node.*.high))
    putByte(41)
    if op == 4 { putByte(41) }
}

// The address of the object a pointer expression names, as Mlx's plain
// `*T` (an atomic builtin's operand): `&x` as it is, else `&p[0]`.
fn putObjectAddress(n: usize) -> void {
    if ast.kindOf(uncast(n)) == ast.ADDR {
        emitExpr(uncast(n))
        return
    }
    putByte(38)
    emitIndexBase(n)
    put("[0]")
}

// An atomic builtin (`__atomic_load_n`, std::atomic's members under
// them): Mlx's, sequentially consistent as the front end takes them. A
// compare-exchange is the runtime's generic one (the expected value
// through a pointer, which takes the value seen).
fn emitAtomic(n: usize) -> void {
    const node = ast.node(n)
    const op = node.*.value
    if op == 11 {
        put("@fence(seq_cst)")
        return
    }
    const pt = types.at(ast.typeOf(node.*.lhs))
    const ty = types.unqualified(pt.*.base)
    if op == 10 {
        usesRuntime = true
        put("c.atomic_compare_exchange(")
        putType(ty)
        put(", ")
        putObjectAddress(node.*.lhs)
        put(", ")
        putObjectAddress(node.*.cond)
        put(", ")
        emitExpr(node.*.rhs)
        putByte(41)
        return
    }
    if op == 1 {
        put("@atomicLoad(")
        putType(ty)
        put(", ")
        putObjectAddress(node.*.lhs)
        put(", seq_cst)")
        return
    }
    if op == 2 {
        put("@atomicStore(")
        putType(ty)
        put(", ")
        putObjectAddress(node.*.lhs)
        put(", ")
        emitExpr(node.*.rhs)
        put(", seq_cst)")
        return
    }
    // The read-modify-write operations answer the value before; the
    // value after (`__atomic_add_fetch`) is the operation once more.
    const operations = [10][]const u8{ "", "", "", "xchg", "add", "sub", "and", "or", "xor", "nand" }
    const after = [10][]const u8{ "", "", "", "", " +% ", " -% ", " & ", " | ", " ^ ", " & " }
    const index = @intCast(usize, op)
    if index < 3 || index > 9 {
        note("an atomic operation the translator does not know")
        put("0")
        return
    }
    const fetchNew = node.*.high == 1 && index != 3
    if fetchNew { put(if index == 9 { "~(" } else { "(" }) }
    put("@atomicRmw(")
    putType(ty)
    put(", ")
    putObjectAddress(node.*.lhs)
    put(", ")
    put(operations[index])
    put(", ")
    emitExpr(node.*.rhs)
    put(", seq_cst)")
    if fetchNew {
        put(after[index])
        emitExpr(node.*.rhs)
        putByte(41)
    }
}

// A function named where it is called or its address taken: its module's
// alias before it when another module has it, noted as called when this
// one has to declare or carry it.
fn putCallee(o: usize) -> void {
    const obj = ast.obj(o)
    const module = moduleOfFunction(obj)
    if module != 0 {
        putModulePrefix(module)
    } else if obj.*.body == 0 || !inMainFile(obj.*.token) {
        noteExtern(o)
        // (A header class's method with a body: the class comes along
        // with it, char_traits<char>'s static methods.)
        if obj.*.body != 0 && obj.*.classType != 0 && !functionHere(obj) { noteType(obj.*.classType) }
    }
    if module == 0 { putHomePrefix(functionEntry(obj)) }
    putFunctionName(obj)
}

fn emitCall(n: usize) -> void {
    const node = ast.node(n)
    const callee = node.*.lhs
    if callee != 0 && ast.kindOf(callee) == ast.VAR && ast.obj(ast.node(callee).*.variable).*.isFunction {
        const o = ast.node(callee).*.variable
        const obj = ast.obj(o)
        if emitKnownCall(node, obj) { return }
        putCallee(o)
    } else if callee != 0 {
        emitExpr(callee)
        // (Through a pointer to a function, absent in the Mlx when null.)
        if types.at(ast.typeOf(callee)).*.kind == types.PTR && !isPlainPointer(callee) { put(".?") }
    } else {
        put("call")
    }
    putByte(40)
    var a = node.*.args
    var first = true
    // (The parameters, walked with the arguments.)
    var param: usize = 0
    if callee != 0 && ast.kindOf(callee) == ast.VAR && ast.obj(ast.node(callee).*.variable).*.isFunction {
        param = types.at(ast.obj(ast.node(callee).*.variable).*.ty).*.params
    } else if callee != 0 && ast.typeOf(callee) != 0 {
        // (Through a pointer, a virtual call: the parameters of the
        // function type it points to.)
        var called = ast.typeOf(callee)
        if types.at(called).*.kind == types.PTR && types.at(called).*.base != 0 { called = types.at(called).*.base }
        if types.at(called).*.kind == types.FUNC { param = types.at(called).*.params }
    }
    // (The arguments after the named ones of a function with `...`: its
    // words.)
    const packs = packsArguments(n)
    const words: usize = if packs { firstVariableArgument(n) } else { 0 }
    while a != 0 {
        if packs && a == words { break }
        if !first { put(", ") }
        if first && callee != 0 && ast.kindOf(callee) == ast.VAR && needsBaseCast(ast.obj(ast.node(callee).*.variable), a) {
            // A base class's method (an inherited constructor) on a derived
            // object: the pointer as the base's.
            const method = ast.obj(ast.node(callee).*.variable)
            put("unsafe { @ptrCast(*")
            putType(method.*.classType)
            put(", ")
            emitExpr(a)
            put(") }")
        } else if param != 0 && types.at(types.param(param).*.ty).*.kind == types.REF && !types.at(types.at(types.param(param).*.ty).*.base).*.isConst && pointsIntoConst(a) {
            // A member of a const object for a `T &` parameter: the front
            // end deduces T without the const (std::tie on a const
            // VersionTriple's members), the Mlx pointer is const; cast
            // away, as the C++ does.
            put("unsafe { @ptrCast(")
            putPointer(types.at(types.param(param).*.ty).*.base, false)
            put(", ")
            emitExpr(a)
            put(") }")
        } else if param != 0 && (types.at(types.param(param).*.ty).*.kind == types.REF || types.at(types.param(param).*.ty).*.kind == types.PTR) && types.at(types.param(param).*.ty).*.base != 0 && types.at(types.at(types.param(param).*.ty).*.base).*.kind == types.ARRAY && !isStdArray(types.at(types.param(param).*.ty).*.base) {
            // A reference (or pointer) to an array, `const char (&)[6]`
            // given "hello": the Mlx type says the array, the argument is
            // its bytes' pointer.
            put("unsafe { @ptrCast(")
            putType(types.param(param).*.ty)
            put(", ")
            emitExpr(a)
            put(") }")
        } else if param != 0 && pointerConstDiffers(types.param(param).*.ty, a) {
            // A pointer by reference where the parameter's points to
            // const and the object's does not (`const T *const &` given a
            // `T *` member: C++ would bind a converted temporary, the
            // front end hands over the member's address): the address as
            // the parameter's type.
            put("unsafe { @ptrCast(")
            if types.at(types.param(param).*.ty).*.kind == types.REF { putPointer(types.at(types.param(param).*.ty).*.base, false) } else { putType(types.param(param).*.ty) }
            put(", ")
            emitExpr(a)
            put(") }")
        } else if param != 0 && isRecordKind(types.at(types.param(param).*.ty).*.kind) && !isStdArray(types.param(param).*.ty) && ast.typeOf(a) != 0 && (types.at(ast.typeOf(a)).*.kind == types.PTR || types.at(ast.typeOf(a)).*.kind == types.REF) {
            // A record taken by value, handed over as the address of a
            // copy the caller made (a class with a copy constructor): the
            // copy itself.
            emitRefValue(a)
        } else if param != 0 && !(first && callee != 0 && ast.kindOf(callee) == ast.VAR && ast.obj(ast.node(callee).*.variable).*.classType != 0 && !ast.obj(ast.node(callee).*.variable).*.isStaticMember) && pointee(types.param(param).*.ty) != 0 && argumentRecord(a) != 0 && otherRecord(pointee(types.param(param).*.ty), argumentRecord(a)) && offsetOfBase(argumentRecord(a), pointee(types.param(param).*.ty), 0) >= 0 {
            // An object of a derived class where its base is taken (by
            // reference or pointer): the base's part of it.
            const offset = offsetOfBase(argumentRecord(a), pointee(types.param(param).*.ty), 0)
            put("unsafe { @ptrCast(")
            putPointer(pointee(types.param(param).*.ty), types.at(types.param(param).*.ty).*.kind == types.PTR && !isPlainPointer(a))
            put(", ")
            if offset == 0 {
                emitExpr(a)
            } else {
                put("&unsafe { @ptrCast([*]u8, ")
                emitExpr(a)
                if types.at(ast.typeOf(a)).*.kind == types.PTR && !isPlainPointer(a) { put(".?") }
                put(") }[")
                putNumber(@bitCast(u64, offset))
                put("]")
            }
            put(") }")
        } else {
            emitExpr(a)
            // (A C pointer, nullable in the Mlx, where the callee takes
            // `this` or a reference: a placement new's object, `*p`.)
            const method = callee != 0 && ast.kindOf(callee) == ast.VAR && ast.obj(ast.node(callee).*.variable).*.isFunction && ast.obj(ast.node(callee).*.variable).*.classType != 0 && !ast.obj(ast.node(callee).*.variable).*.isStaticMember
            const ak = types.at(ast.typeOf(a)).*.kind
            if ((first && method) || (param != 0 && wantsPlainPointer(types.param(param)))) && (ak == types.PTR || ak == types.REF) && !isPlainPointer(a) { put(".?") }
        }
        first = false
        a = ast.node(a).*.next
        if param != 0 { param = types.param(param).*.next }
    }
    if packs {
        if !first { put(", ") }
        emitVaWords(words)
    }
    putByte(41)
}

// Whether an argument `&object` is given to a parameter, a reference or
// a pointer to a pointer, whose pointer the Mlx writes with another
// const than the object's own type.
fn pointerConstDiffers(parameter: usize, argument: usize) -> bool {
    const pt = types.at(parameter)
    if (pt.*.kind != types.REF && pt.*.kind != types.PTR) || pt.*.base == 0 || types.at(pt.*.base).*.kind != types.PTR { return false }
    const e = uncast(argument)
    if e == 0 || ast.kindOf(e) != ast.ADDR || ast.node(e).*.lhs == 0 { return false }
    const object = ast.typeOf(ast.node(e).*.lhs)
    if object == 0 || types.at(object).*.kind != types.PTR { return false }
    return constDiffersBelow(pt.*.base, object)
}

// Whether an address expression points into a const object in the Mlx
// (`&a->member` with `a` a pointer to const), whatever the front end
// types the member.
fn pointsIntoConst(n: usize) -> bool {
    const e = uncast(n)
    // (`*this` of a const method.)
    if ast.kindOf(e) == ast.VAR && ast.obj(ast.node(e).*.variable).*.name == names.K_THIS { return currentFunction != 0 && types.at(ast.obj(currentFunction).*.ty).*.constMethod }
    if ast.kindOf(e) != ast.ADDR { return false }
    var target = ast.node(e).*.lhs
    while target != 0 {
        const kind = ast.kindOf(target)
        if kind == ast.MEMBER {
            target = ast.node(target).*.lhs
        } else if kind == ast.CAST {
            target = ast.node(target).*.lhs
        } else if kind == ast.DEREF {
            const pointer = uncast(ast.node(target).*.lhs)
            if pointer != 0 && ast.kindOf(pointer) == ast.VAR && ast.obj(ast.node(pointer).*.variable).*.name == names.K_THIS { return currentFunction != 0 && types.at(ast.obj(currentFunction).*.ty).*.constMethod }
            const pt = types.at(ast.typeOf(ast.node(target).*.lhs))
            if pt.*.kind == types.PTR || pt.*.kind == types.REF { return types.at(pt.*.base).*.isConst }
            return false
        } else if kind == ast.VAR {
            if ast.obj(ast.node(target).*.variable).*.name == names.K_THIS { return currentFunction != 0 && types.at(ast.obj(currentFunction).*.ty).*.constMethod }
            const vt = types.at(ast.typeOf(target))
            if vt.*.kind == types.REF { return types.at(vt.*.base).*.isConst }
            return vt.*.isConst
        } else {
            return false
        }
    }
    return false
}

// Whether a parameter is a plain (non-null) pointer in the Mlx: `this`,
// or a reference.
fn wantsPlainPointer(param: *types.Param) -> bool {
    if param.*.name == names.K_THIS { return true }
    return types.at(param.*.ty).*.kind == types.REF
}

// Whether the `this` argument of a method call is a pointer to another
// record than the method's class (a derived object).
fn needsBaseCast(method: *ast.Obj, argument: usize) -> bool {
    if method.*.classType == 0 || method.*.isStaticMember || !method.*.isFunction { return false }
    // (The object's own type, under the address-of and the casts: the
    // front end types `&(Base &)derived` as the base's pointer.)
    // (Down through the casts, address-ofs and derefs to the object named.)
    var e = argument
    while e != 0 && (ast.kindOf(e) == ast.CAST || ast.kindOf(e) == ast.ADDR || ast.kindOf(e) == ast.DEREF) && ast.node(e).*.lhs != 0 { e = ast.node(e).*.lhs }
    if e == 0 { return false }
    var objectType = ast.typeOf(e)
    if types.at(objectType).*.kind == types.PTR || types.at(objectType).*.kind == types.REF { objectType = types.at(objectType).*.base }
    const target = types.unqualified(objectType)
    if target == 0 || !isRecordKind(types.at(target).*.kind) { return false }
    return !sameStruct(target, method.*.classType)
}

// What an operand C++ evaluates only on a condition hoists before the
// statement (a temporary constructed for one arm of `c ? a : b`, for the
// right side of `a && b`) runs on that condition too: the condition is
// kept in a variable of the function, `chosen_N`, the hoisted statements
// go under an `if` of it, and the expression reads the variable. How
// many the function being written has: declared with its locals.
var chosenCount: usize = 0

fn putChosen(k: usize) -> void {
    put("chosen_")
    putNumber(@intCast(u64, k))
}

// `c ? a : b`.
fn emitChoice(n: usize) -> void {
    const node = ast.node(n)
    const savedOut = out
    const savedPre = pre
    out = emptyBuffer()
    pre = emptyBuffer()
    level += 1
    emitBranch(node.*.then, node.*.ty)
    const thenText = out
    const thenPre = pre
    out = emptyBuffer()
    pre = emptyBuffer()
    emitBranch(node.*.els, node.*.ty)
    const elsText = out
    const elsPre = pre
    level -= 1
    out = savedOut
    pre = savedPre
    if thenPre.length == 0 && elsPre.length == 0 {
        put("(if ")
        emitCond(node.*.cond)
        put(" { ")
        put(textOf(&thenText))
        put(" } else { ")
        put(textOf(&elsText))
        put(" })")
        return
    }
    const k = chosenCount
    chosenCount += 1
    // (The condition's own hoisted statements go before, as they come.)
    out = emptyBuffer()
    indent(level)
    putChosen(k)
    put(" = ")
    emitCond(node.*.cond)
    newline()
    indent(level)
    put("if ")
    putChosen(k)
    put(" {\n")
    put(textOf(&thenPre))
    indent(level)
    put("} else {\n")
    put(textOf(&elsPre))
    indent(level)
    put("}\n")
    const made = out
    out = savedOut
    putTo(&pre, textOf(&made))
    put("(if ")
    putChosen(k)
    put(" { ")
    put(textOf(&thenText))
    put(" } else { ")
    put(textOf(&elsText))
    put(" })")
}

// `a && b`, `a || b`.
fn emitShortCircuit(n: usize) -> void {
    const node = ast.node(n)
    const both = node.*.kind == ast.LOGAND
    const savedOut = out
    const savedPre = pre
    out = emptyBuffer()
    pre = emptyBuffer()
    level += 1
    emitCond(node.*.rhs)
    const rightText = out
    const rightPre = pre
    level -= 1
    out = savedOut
    pre = savedPre
    if rightPre.length == 0 {
        putByte(40)
        emitCond(node.*.lhs)
        put(if both { " && " } else { " || " })
        put(textOf(&rightText))
        putByte(41)
        return
    }
    const k = chosenCount
    chosenCount += 1
    out = emptyBuffer()
    indent(level)
    putChosen(k)
    put(" = ")
    emitCond(node.*.lhs)
    newline()
    indent(level)
    put(if both { "if " } else { "if !" })
    putChosen(k)
    put(" {\n")
    put(textOf(&rightPre))
    indent(level + 1)
    putChosen(k)
    put(" = ")
    put(textOf(&rightText))
    newline()
    indent(level)
    put("}\n")
    const made = out
    out = savedOut
    putTo(&pre, textOf(&made))
    putChosen(k)
}

// The `chosen_N` of the function written, declared.
fn putChosenLocals() -> void {
    var k: usize = 0
    while k < chosenCount {
        indent(1)
        put("var ")
        putChosen(k)
        put(": bool = undefined\n")
        k += 1
    }
}

// `&operand`, as a value of the pointer type `ty`.
fn emitAddressOf(operand: usize, ty: usize) -> void {
    const target = uncast(operand)
    if ast.kindOf(target) == ast.VAR && ast.obj(ast.node(target).*.variable).*.name == names.K_THIS && ty != 0 && (types.at(ty).*.kind == types.PTR || types.at(ty).*.kind == types.REF) && types.at(ty).*.base != 0 {
        // `this` by reference (a template's `T &&` given `this`): the
        // parameter's address, as the pointer to a pointer the callee
        // reads (self is no variable in the Mlx: its address is
        // const, and not of an optional).
        put("unsafe { @ptrCast(")
        putPointer(types.at(ty).*.base, false)
        put(", &self) }")
    } else if types.isMemberPointer(ty) && ast.kindOf(target) == ast.VAR && ast.obj(ast.node(target).*.variable).*.isFunction {
        // `&Class::method`: a pointer to a member function is a word
        // in the front end's model, the function's address (a virtual
        // one's is its table offset and one, a number already).
        // (The function's own value: `&name` would be the address of
        // a copy of it.)
        put("@bitCast(i64, @intFromPtr(")
        putCallee(ast.node(target).*.variable)
        put("))")
    } else if ast.kindOf(target) == ast.VAR && ast.obj(ast.node(target).*.variable).*.isTable {
        putTableAddress(ast.node(target).*.variable)
    } else if ast.kindOf(target) == ast.VAR && ast.obj(ast.node(target).*.variable).*.isLiteral {
        // `"text"` where a `const char *` is wanted: the bytes' pointer.
        putStringLiteral(ast.obj(ast.node(target).*.variable))
        put(".pointer")
    } else if ast.kindOf(target) == ast.COND && ast.node(target).*.then != 0 && ast.node(target).*.els != 0 {
        // `&(c ? a : b)`: the address of the one chosen (each as its
        // own kind of thing is addressed: a string's bytes, a table).
        const choice = ast.node(target)
        put("(if ")
        emitCond(choice.*.cond)
        put(" { ")
        emitAddressOf(choice.*.then, ty)
        put(" } else { ")
        emitAddressOf(choice.*.els, ty)
        put(" })")
    } else if ast.kindOf(operand) == ast.DEREF && ast.node(operand).*.lhs != 0 && otherRecord(pointee(ty), writtenPointee(ast.node(operand).*.lhs)) {
        // (`&*this` as its base class's pointer.)
        putAsRecordPointer(pointee(ty), ast.node(operand).*.lhs)
    } else if ast.kindOf(operand) == ast.DEREF && ast.node(operand).*.lhs != 0 {
        // `&*p`: the pointer (or reference) itself.
        emitExpr(ast.node(operand).*.lhs)
    } else if ast.kindOf(operand) == ast.MEMBER && types.member(ast.node(operand).*.member).*.isBase {
        putBaseAddress(operand)
    } else if ty != 0 && types.at(ty).*.kind == types.PTR && types.at(ty).*.base != 0 && isRecordKind(types.at(types.at(ty).*.base).*.kind) && !isStdArray(types.at(ty).*.base) && ast.typeOf(target) != 0 && types.at(ast.typeOf(target)).*.kind == types.ARRAY && isRecordKind(types.at(types.at(ast.typeOf(target)).*.base).*.kind) {
        // (An array of records where a pointer to a record is wanted,
        // an initializer_list's elements: its first.)
        putByte(38)
        emitLvalue(target)
        put("[0]")
    } else {
        putByte(38)
        emitLvalue(operand)
    }
}

pub fn emitExpr(n: usize) -> void {
    if n == 0 {
        put("0")
        return
    }
    const node = ast.node(n)
    const kind = node.*.kind
    if kind == ast.NUM {
        const t = types.at(node.*.ty)
        if isFloatKind(t.*.kind) {
            // (A float constant is kept as a double's bits.)
            putFloat(@bitCast(u64, node.*.value))
        } else if t.*.kind == types.BOOL {
            put(if node.*.value != 0 { "true" } else { "false" })
        } else if t.*.unsigned {
            putNumber(@bitCast(u64, node.*.value))
        } else if isIntKind(t.*.kind) && t.*.size == 4 && node.*.value > 2147483647 && node.*.value <= 4294967295 {
            // (`0xFFFFFFFF` where an int is taken: the int of those bits.)
            putSigned(node.*.value - 4294967296)
        } else {
            putSigned(node.*.value)
        }
    } else if kind == ast.VAR {
        const o = node.*.variable
        const obj = ast.obj(o)
        if obj.*.isLiteral {
            putStringLiteral(obj)
        } else if obj.*.name == names.K_THIS {
            put("self")
        } else if obj.*.isLocal || isBoundLocal(o) {
            putLocal(o)
        } else if obj.*.name != 0 && !inMainFile(obj.*.token) && isCStreamName(base.nameOf(obj.*.name)) {
            // stdin, stdout, stderr: the runtime's.
            usesRuntime = true
            put("c.")
            ident(obj.*.name)
            put("()")
        } else {
            if obj.*.isFunction {
                // (A function named as a value: its address.)
                putCallee(o)
            } else {
                if !inMainFile(obj.*.token) { noteHeaderGlobal(o) }
                putHomePrefix(functionEntry(obj))
                putGlobalName(obj)
            }
        }
    } else if kind == ast.MEMBER {
        const member = types.member(node.*.member)
        if member.*.bitWidth > 0 {
            // A bit-field read, widened to its declared type.
            if types.at(member.*.ty).*.kind == types.BOOL {
                putByte(40)
                emitLvalue(n)
                put(" != 0)")
            } else {
                put("@intCast(")
                putType(member.*.ty)
                put(", ")
                emitLvalue(n)
                putByte(41)
            }
        } else {
            emitLvalue(n)
        }
    } else if kind == ast.DEREF {
        emitDeref(n)
    } else if kind == ast.ADDR {
        emitAddressOf(node.*.lhs, node.*.ty)
    } else if kind == ast.NOT {
        if isBoolish(node.*.lhs) {
            putByte(33)
            emitExpr(node.*.lhs)
        } else {
            putByte(40)
            if pointerFromInteger(node.*.lhs) != 0 {
                emitExpr(pointerFromInteger(node.*.lhs))
                put(" == 0)")
            } else {
                emitExpr(node.*.lhs)
                put(if types.at(ast.typeOf(node.*.lhs)).*.kind == types.PTR { " == null)" } else { " == 0)" })
            }
        }
    } else if kind == ast.BITNOT {
        putByte(126)
        emitExpr(node.*.lhs)
    } else if kind == ast.NEG {
        put(if wraps(node.*.ty) { "(0 -% " } else { "(-" })
        emitExpr(node.*.lhs)
        putByte(41)
    } else if kind == ast.LOGAND || kind == ast.LOGOR {
        emitShortCircuit(n)
    } else if kind == ast.ADD && types.at(node.*.ty).*.kind == types.PTR {
        // Pointer arithmetic: the address of the element it names.
        putByte(38)
        addressOnly = true
        if !emitIndexed(n) {
            put("0  ")
            note("a pointer sum the translator could not index")
        }
    } else if kind == ast.ADD {
        // (C's unsigned arithmetic wraps; Mlx's `+` checks.)
        binary(n, if wraps(node.*.ty) { " +% " } else { " + " })
    } else if kind == ast.SUB && types.at(ast.typeOf(node.*.lhs)).*.kind == types.PTR && types.at(ast.typeOf(node.*.rhs)).*.kind == types.PTR && !isIntKind(types.at(ast.typeOf(uncast(node.*.rhs))).*.kind) {
        // Two pointers' difference, in bytes (the front end divides by
        // the element's size after).
        put("@bitCast(i64, (@intFromPtr(")
        emitExpr(node.*.lhs)
        if !isPlainPointer(node.*.lhs) { put(".?") }
        put(") -% @intFromPtr(")
        emitExpr(node.*.rhs)
        if !isPlainPointer(node.*.rhs) { put(".?") }
        put(")))")
    } else if kind == ast.SUB && types.at(ast.typeOf(node.*.lhs)).*.kind == types.PTR {
        emitPointerStep(n)
    } else if kind == ast.SUB {
        binary(n, if wraps(node.*.ty) { " -% " } else { " - " })
    } else if kind == ast.MUL {
        binary(n, if wraps(node.*.ty) { " *% " } else { " * " })
    } else if kind == ast.DIV {
        binary(n, " / ")
    } else if kind == ast.MOD {
        binary(n, " % ")
    } else if kind == ast.BITAND {
        binary(n, " & ")
    } else if kind == ast.BITOR {
        binary(n, " | ")
    } else if kind == ast.BITXOR {
        binary(n, " ^ ")
    } else if (kind == ast.EQ || kind == ast.NE) && ((pointerFromInteger(node.*.lhs) != 0 && isNullConstant(node.*.rhs)) || (pointerFromInteger(node.*.rhs) != 0 && isNullConstant(node.*.lhs))) {
        // (A pointer made of an integer against null: the integer
        // against 0; the pointer is no optional in the Mlx.)
        putByte(40)
        emitExpr(if pointerFromInteger(node.*.lhs) != 0 { pointerFromInteger(node.*.lhs) } else { pointerFromInteger(node.*.rhs) })
        put(if kind == ast.EQ { " == 0)" } else { " != 0)" })
    } else if kind == ast.EQ {
        binary(n, " == ")
    } else if kind == ast.NE {
        binary(n, " != ")
    } else if kind == ast.LT {
        binary(n, " < ")
    } else if kind == ast.LE {
        binary(n, " <= ")
    } else if kind == ast.SHL || kind == ast.SHR {
        putByte(40)
        emitExpr(node.*.lhs)
        put(if kind == ast.SHL { " << @intCast(" } else { " >> @intCast(" })
        put(shiftType(node.*.ty))
        put(", ")
        emitExpr(node.*.rhs)
        put("))")
    } else if kind == ast.ASSIGN {
        // An assignment inside an expression: done before the statement,
        // its value the variable.
        hoist(n)
        emitLvalue(node.*.lhs)
    } else if kind == ast.COND {
        emitChoice(n)
    } else if kind == ast.COMMA {
        // `a, b`: a before the statement, b the value.
        hoist(node.*.lhs)
        emitExpr(node.*.rhs)
    } else if kind == ast.CAST {
        emitCast(n)
    } else if kind == ast.FUNCALL {
        if node.*.returnBuffer != 0 { emitBufferedCall(n) } else { emitCall(n) }
    } else if kind == ast.NULL_EXPR {
        put("null")
    } else if kind == ast.ATOMIC {
        emitAtomic(n)
    } else if kind == ast.MEMZERO {
        put("undefined")
    } else if kind == ast.BITCAST {
        put("@bitCast(")
        putType(node.*.ty)
        put(", ")
        emitExpr(node.*.lhs)
        putByte(41)
    } else if kind == ast.STMT_EXPR {
        emitStatementExpression(n)
    } else if kind == ast.BITOP {
        emitBitop(n)
    } else if kind == ast.ASM && overflowOperation(n) != 0 {
        emitOverflow(n)
    } else {
        var text: [48]u8 = undefined
        const p: [*]u8 = &text
        const label = "a node the translator does not know, kind "
        var at: usize = 0
        while at < label.length {
            text[at] = label[at]
            at += 1
        }
        text[at] = @intCast(u8, 48 + kind / 10)
        text[at + 1] = @intCast(u8, 48 + kind % 10)
        note(p[0..at + 2])
        put("0")
    }
}

// ---------------------------------------------------------------------------
// Functions

// Whether a type names a record the file does not define (a header's).
// A record of the C++ library (std::string, std::vector<...>): not
// translated, the hand gives it an Mlx shape.
fn isStdRecord(ty: usize) -> bool {
    const name = types.at(ty).*.name
    if name == 0 { return false }
    const text = base.nameOf(name)
    return startsWith(text, "std::") || startsWith(text, "__")
}

// Whether a class has virtual functions (a vtable the Mlx struct cannot
// carry yet).
// Whether a class has a virtual base (its layout comes from a table at
// run time: not translated).
fn hasVirtualBase(ty: usize) -> bool {
    var m = types.at(ty).*.members
    while m != 0 {
        if types.member(m).*.isVirtual { return true }
        m = types.member(m).*.next
    }
    return false
}

fn hasVirtualMethods(ty: usize) -> bool {
    const known = memoGet(1, ty)
    if known != 0 { return known == 2 }
    const answer = hasVirtualMethodsScan(ty)
    memoPut(1, ty, answer)
    return answer
}

fn hasVirtualMethodsScan(ty: usize) -> bool {
    if types.at(ty).*.name != 0 {
        if classFlag(types.at(ty).*.name, CLASS_VIRTUAL) { return true }
    } else {
        var o = unitGlobals
        while o != 0 {
            const obj = ast.obj(o)
            if obj.*.isFunction && obj.*.isVirtual && obj.*.classType == ty { return true }
            o = obj.*.next
        }
    }
    var m = types.at(ty).*.members
    while m != 0 {
        if types.member(m).*.isVirtual { return true }
        m = types.member(m).*.next
    }
    return false
}

// A record from a header the file can carry along: the project's own
// (not the C++ library's), complete, named, without virtual functions.
// Its struct and its inline methods are written after the file's own.
fn translatable(ty: usize) -> bool {
    const t = types.at(ty)
    if !isRecordKind(t.*.kind) || t.*.name == 0 { return false }
    // (No members: a class of static methods, char_traits<char>; not an
    // incomplete type.)
    if t.*.members == 0 && t.*.incomplete { return false }
    if hasVirtualBase(ty) { return false }
    // (A unit alone: a lambda's closure class is not translated, and the
    // library's classes come from the std module; its template instances
    // (vector<T>, optional<T>) have their bodies here and come along
    // like any header's. In a program of many units the library's
    // classes are records like the others, with their homes: std::mutex
    // and the tree under std::map are all in their headers, string's
    // and the streams' functions are the library's own units'.)
    if !wholeProgram() && startsWith(lastComponent(base.nameOf(t.*.name)), "__lambda") { return false }
    if !wholeProgram() && isStdRecord(ty) && !containsText(base.nameOf(t.*.name), "<") { return false }
    // (Its members' records must be ones the Mlx has too: a std::vector
    // or an ostringstream inside keeps the whole record out.)
    var m = t.*.members
    while m != 0 {
        if !memberTypeTranslated(types.member(m).*.ty, 0) { return false }
        m = types.member(m).*.next
    }
    return true
}

fn memberTypeTranslated(ty: usize, depth: usize) -> bool {
    if depth > 8 { return true }
    const t = types.at(ty)
    // (A pointer's target may be opaque.)
    if t.*.kind == types.PTR || t.*.kind == types.REF { return true }
    if t.*.kind == types.ARRAY { return memberTypeTranslated(t.*.base, depth + 1) }
    if !isRecordKind(t.*.kind) { return true }
    // (A record's answer is kept: the members of members are asked of
    // again and again from every record that has them.)
    const known = memoGet(4, ty)
    if known != 0 { return known == 2 }
    const answer = memberRecordTranslated(ty, depth)
    memoPut(4, ty, answer)
    return answer
}

fn memberRecordTranslated(ty: usize, depth: usize) -> bool {
    const t = types.at(ty)
    if isStdArray(ty) { return memberTypeTranslated(stdArrayType(ty), depth + 1) }
    if definedHere(ty) || ownedHere(ty) || moduleOfType(ty) != 0 { return true }
    if hasVirtualBase(ty) { return false }
    if !wholeProgram() && startsWith(lastComponent(base.nameOf(t.*.name)), "__lambda") { return false }
    if !wholeProgram() && isStdRecord(ty) && !containsText(base.nameOf(t.*.name), "<") { return false }
    if t.*.members == 0 { return true }
    var m = t.*.members
    while m != 0 {
        if !memberTypeTranslated(types.member(m).*.ty, depth + 1) { return false }
        m = types.member(m).*.next
    }
    return true
}

// std::array<T, N>: an Mlx array `[N]T` (its one member is the C array).
fn isStdArray(given: usize) -> bool {
    // (The const version of a class may not have its members yet.)
    const ty = types.unqualified(given)
    const t = types.at(ty)
    if !isRecordKind(t.*.kind) || t.*.name == 0 || t.*.members == 0 { return false }
    return startsWith(base.nameOf(t.*.name), "std::array<")
}

fn stdArrayType(ty: usize) -> usize {
    return types.member(types.at(types.unqualified(ty)).*.members).*.ty
}

// A record the Mlx has: defined in this file, brought from a header, or
// one of the library's it has a shape for.
fn isTranslated(ty: usize) -> bool {
    const known = memoGet(2, ty)
    if known != 0 { return known == 2 }
    const answer = isVaRecord(ty) || definedHere(ty) || ownedHere(ty) || translatable(ty) || isStdArray(ty) || moduleOfType(ty) != 0
    memoPut(2, ty, answer)
    return answer
}

// Whether a type holds, by value, a record the Mlx lacks. A pointer or a
// reference to one does not: the record is declared opaque (a Vulkan
// handle, a class not translated yet), and the pointer passed along.
fn hasForeignRecord(ty: usize) -> bool {
    if ty == 0 { return false }
    const t = types.at(ty)
    if t.*.kind == types.PTR || t.*.kind == types.REF { return false }
    if t.*.kind == types.ARRAY { return hasForeignRecord(t.*.base) }
    if isRecordKind(t.*.kind) {
        if !isTranslated(ty) { lastForeign = ty }
        return !isTranslated(ty)
    }
    return false
}

// The last record a question about foreign types was answered yes for,
// and the last node kind without an Mlx: what the list of the unit's
// definitions says a function waits for.
var lastForeign: usize = 0
var lastUnknownKind: u8 = 0

fn isForeignRecord(ty: usize) -> bool {
    if ty == 0 { return false }
    const t = types.at(ty)
    // (A record only declared here, `struct State;`: the C++ can do no
    // more with its value than refer to it, `*p` bound to a reference or
    // addressed again; the Mlx passes the pointer.)
    if isRecordKind(t.*.kind) && t.*.members == 0 && t.*.incomplete && t.*.name != 0 { return false }
    const foreign = isRecordKind(t.*.kind) && !isStdArray(ty) && !isTranslated(ty)
    if foreign { lastForeign = ty }
    return foreign
}

// Whether a body works on the inside of a record the Mlx lacks: a value
// of it (a local, a copy, a member read through `*p`, a call's result) or
// arithmetic on a pointer to it (its size is not known to the Mlx). Such
// a function is held back; one that only passes the pointer is not.
fn touchesForeignValue(n: usize) -> bool {
    if n == 0 { return false }
    const node = ast.node(n)
    const kind = node.*.kind
    // (What the emitter drops is not worked on: ASSERT's and ERR's stream
    // machinery, as in callsForeign.)
    if kind == ast.COND && types.at(node.*.ty).*.kind == types.VOID && (callsOperator(node.*.then) || callsOperator(node.*.els)) { return touchesForeignValue(node.*.cond) }
    if kind == ast.EXPR_STMT && callsOperator(node.*.lhs) { return false }
    if kind != ast.BLOCK && kind != ast.IF && kind != ast.FOR && kind != ast.DO && kind != ast.SWITCH && kind != ast.CASE && kind != ast.RETURN && kind != ast.EXPR_STMT && kind != ast.LABEL && kind != ast.JUMP && kind != ast.GOTO {
        if node.*.ty != 0 && isForeignRecord(node.*.ty) { return true }
        if (kind == ast.ADD || kind == ast.SUB) && node.*.ty != 0 && types.at(node.*.ty).*.kind == types.PTR && isForeignRecord(types.at(node.*.ty).*.base) { return true }
    }
    if touchesForeignValue(node.*.lhs) || touchesForeignValue(node.*.rhs) || touchesForeignValue(node.*.cond) || touchesForeignValue(node.*.then) || touchesForeignValue(node.*.els) || touchesForeignValue(node.*.init) || touchesForeignValue(node.*.inc) { return true }
    var b = node.*.body
    while b != 0 {
        if touchesForeignValue(b) { return true }
        b = ast.node(b).*.next
    }
    var a = node.*.args
    while a != 0 {
        if touchesForeignValue(a) { return true }
        a = ast.node(a).*.next
    }
    return false
}


fn signatureIsForeign(obj: *ast.Obj) -> bool {
    if obj.*.classType != 0 && !isTranslated(obj.*.classType) {
        lastForeign = obj.*.classType
        return true
    }
    if hasForeignRecord(types.at(obj.*.ty).*.base) { return true }
    var c = obj.*.params
    while c != 0 {
        if hasForeignRecord(ast.obj(base.getWord(c)).*.ty) { return true }
        c = base.getWord(c + 8)
    }
    return false
}

// Whether a body calls a function the Mlx cannot declare: one whose
// signature names a type the Mlx lacks and that the translator does not
// write inline (std::tie and the tuple comparisons behind `operator<`).
var foreignCallee: *ast.Obj = undefined

// The functions written as comments (a foreign signature, a foreign
// call): a call to one is a foreign call too.
// (A set by the function's object, open addressing: a unit of libANGLE
// has tens of thousands of them.)
const HELD_SLOTS: usize = 262144
var heldBackSet: [HELD_SLOTS]usize = undefined
var heldBackCount: usize = 0

fn heldSlot(o: usize) -> usize {
    var slot = ((o >> 3) *% 11400714819323198485) >> 46
    var probes: usize = 0
    while heldBackSet[slot] != 0 && heldBackSet[slot] != o && probes < HELD_SLOTS {
        slot = (slot + 1) % HELD_SLOTS
        probes += 1
    }
    return slot
}

fn isHeldBack(o: usize) -> bool {
    if heldBackSet[heldSlot(o)] == o { return true }
    // (Held back in the program: by a function another unit has.)
    if manifestLoaded && ast.obj(o).*.isFunction {
        const known = functionEntry(ast.obj(o))
        return known != 0 && entryFlag(known)
    }
    return false
}

// Marks a function held back; false when it was already (or the set is
// full: nothing more is marked, and the fixed point ends).
fn holdBack(o: usize) -> bool {
    const slot = heldSlot(o)
    if heldBackSet[slot] == o || heldBackCount >= HELD_SLOTS / 2 { return false }
    heldBackSet[slot] = o
    heldBackCount += 1
    return true
}

// The unit's functions that cannot be written, to a fixed point: one
// that calls a held-back one is held back as well.
// Whether a body has a node the translator has no Mlx for (variadic
// arguments, a computed goto, alloca): its function is written as a
// comment, not with a made-up value.
fn hasUnknownNode(n: usize) -> bool {
    if n == 0 { return false }
    const node = ast.node(n)
    const kind = node.*.kind
    lastUnknownKind = kind
    if kind == ast.LABEL_ADDR || kind == ast.BRACED || kind == ast.DEFAULT_ARG { return true }
    // (va_arg of what a word does not hold, a record; an argument of that
    // kind handed to a function with `...`.)
    if kind == ast.VA_ARG && !vaArgTranslates(n) { return true }
    if kind == ast.FUNCALL && packsArguments(n) {
        var word = firstVariableArgument(n)
        while word != 0 {
            if !vaWordTranslates(word) { return true }
            word = ast.node(word).*.next
        }
    }
    if kind == ast.BITOP && node.*.value == 6 { return true }
    // (A C function's variable arguments the runtime has no words for,
    // sscanf's, syscall's.)
    if kind == ast.FUNCALL && isVariadicCall(n) && !isKnownCall(node, ast.obj(ast.node(node.*.lhs).*.variable)) { return true }
    // (Machine instructions: the overflow builtins have a meaning in Mlx,
    // a fence, a trap, a pause and a nop too; cpuid, the time stamp, the
    // stack pointer and assembler text have none.)
    if kind == ast.ASM && overflowOperation(n) == 0 && node.*.value > 7 { return true }
    if hasUnknownNode(node.*.lhs) || hasUnknownNode(node.*.rhs) || hasUnknownNode(node.*.cond) || hasUnknownNode(node.*.then) || hasUnknownNode(node.*.els) || hasUnknownNode(node.*.init) || hasUnknownNode(node.*.inc) { return true }
    var b = node.*.body
    while b != 0 {
        if hasUnknownNode(b) { return true }
        b = ast.node(b).*.next
    }
    var a = node.*.args
    while a != 0 {
        if hasUnknownNode(a) { return true }
        a = ast.node(a).*.next
    }
    return false
}

fn findHeldBack() -> void {
    heldBackCount = 0
    var clear: usize = 0
    while clear < HELD_SLOTS {
        heldBackSet[clear] = 0
        clear += 1
    }
    var changed = true
    while changed {
        changed = false
        var o = unitGlobals
        while o != 0 {
            const obj = ast.obj(o)
            if obj.*.isFunction && obj.*.body != 0 && !isHeldBack(o) && (signatureIsForeign(obj) || callsForeign(obj.*.body) || bodyUnknown(obj.*.body) || touchesForeignValue(obj.*.body)) {
                if holdBack(o) { changed = true }
            }
            o = obj.*.next
        }
    }
}

fn callsForeign(n: usize) -> bool {
    if n == 0 { return false }
    const node = ast.node(n)
    // (What the emitter drops is not called: ASSERT's and ERR's stream
    // machinery, a `c ? (void)0 : log` and the statements made of it.)
    if node.*.kind == ast.COND && types.at(node.*.ty).*.kind == types.VOID && (callsOperator(node.*.then) || callsOperator(node.*.els)) { return callsForeign(node.*.cond) }
    if node.*.kind == ast.EXPR_STMT && callsOperator(node.*.lhs) { return false }
    if node.*.kind == ast.FUNCALL && node.*.lhs != 0 && ast.kindOf(node.*.lhs) == ast.VAR {
        const callee = ast.obj(ast.node(node.*.lhs).*.variable)
        // (Constructors, destructors and operators of foreign classes are
        // the machinery the emitter drops: ASSERT's stream, a braced list.)
        const machinery = callee.*.isConstructor || callee.*.isDestructor || startsWith(base.nameOf(callee.*.name), "operator")
        if callee.*.isFunction && !machinery && (signatureIsForeign(callee) || (isHeldBack(ast.node(node.*.lhs).*.variable) && !isKnownCall(node, callee))) && !isKnownCall(node, callee) {
            foreignCallee = callee
            return true
        }
        // (A constructor, destructor or operator of a class the Mlx has,
        // held back itself: its call is written, so the caller waits
        // with it.)
        if callee.*.isFunction && machinery && isHeldBack(ast.node(node.*.lhs).*.variable) && (callee.*.classType == 0 || isTranslated(callee.*.classType)) && !isKnownCall(node, callee) {
            foreignCallee = callee
            return true
        }
    }
    if callsForeign(node.*.lhs) || callsForeign(node.*.rhs) || callsForeign(node.*.cond) || callsForeign(node.*.then) || callsForeign(node.*.els) || callsForeign(node.*.init) || callsForeign(node.*.inc) { return true }
    var b = node.*.body
    while b != 0 {
        if callsForeign(b) { return true }
        b = ast.node(b).*.next
    }
    var a = node.*.args
    while a != 0 {
        if callsForeign(a) { return true }
        a = ast.node(a).*.next
    }
    return false
}

// Whether emitKnownCall would write the call itself (no declaration of
// the callee needed): tried on a scratch buffer.
fn isKnownCall(node: *ast.Node, callee: *ast.Obj) -> bool {
    const savedOut = out
    const savedPre = pre
    const savedNotes = notes
    const savedMarkers = markerCount
    const savedStd = usesStd
    const savedRuntime = usesRuntime
    const savedHoist = hoistOff
    out = emptyBuffer()
    pre = emptyBuffer()
    hoistOff = true
    const known = emitKnownCall(node, callee)
    out = savedOut
    pre = savedPre
    notes = savedNotes
    markerCount = savedMarkers
    usesStd = savedStd
    usesRuntime = savedRuntime
    hoistOff = savedHoist
    return known
}

// `text` with every line a comment.
fn putCommented(text: []const u8) -> void {
    var lineStart = true
    for byte in text {
        if lineStart && byte != 10 { put("// ") }
        putByte(byte)
        lineStart = byte == 10
    }
}

// The functions written whole (not as comments): their externs are not
// declared again.
var liveFunctionList: [MAX_LIST]usize = undefined
var liveFunctionCount: usize = 0

fn isLiveFunction(o: usize) -> bool {
    var k: usize = 0
    while k < liveFunctionCount {
        if liveFunctionList[k] == o { return true }
        k += 1
    }
    return false
}

// A header's record carried along: its struct, then its methods whose
// bodies the header has (inline ones, a template instance's).
fn emitHeaderRecord(ty: usize) -> void {
    const first = types.at(ty).*.members
    if !elsewhere(recordEntry(ty)) {
        put("// from ")
        putPlace(if first != 0 { types.member(first).*.token } else { 0 })
        put(" (a header's record, carried along)\n")
    }
    emitStruct(ty)
    if !chainsFull && types.at(ty).*.name != 0 {
        var entry = firstOfClass(types.at(ty).*.name)
        while entry != 0 {
            const obj = ast.obj(chainObj[entry])
            if obj.*.body != 0 && !functionHere(obj) {
                emitFunction(chainObj[entry])
                newline()
            }
            entry = chainNextClass[entry]
        }
        return
    }
    var o = unitGlobals
    while o != 0 {
        const obj = ast.obj(o)
        if obj.*.isFunction && obj.*.body != 0 && obj.*.classType != 0 && sameStruct(obj.*.classType, ty) && !functionHere(obj) {
            emitFunction(o)
            newline()
        }
        o = obj.*.next
    }
}

fn emitFunction(o: usize) -> void {
    const obj = ast.obj(o)
    if indexLength != 0 { logFunction(o, isHeldBack(o) || signatureIsForeign(obj) || callsForeign(obj.*.body) || bodyUnknown(obj.*.body) || touchesForeignValue(obj.*.body)) }
    const dropped = beginDropped(functionEntry(obj))
    emitFunctionHere(o)
    endDropped(dropped)
}

fn emitFunctionHere(o: usize) -> void {
    const obj = ast.obj(o)
    if isHeldBack(o) || signatureIsForeign(obj) || callsForeign(obj.*.body) || bodyUnknown(obj.*.body) || touchesForeignValue(obj.*.body) {
        // Written as a comment: it cannot compile until the types it
        // takes exist in Mlx (a header's record, a C++ class). What it
        // alone called or named is not declared for it.
        const savedOut = out
        const savedExterns = externCount
        const savedStructs = structCount
        const savedHeaderGlobals = headerGlobalCount
        out = emptyBuffer()
        emitFunctionText(o)
        const text = out
        out = savedOut
        // (In a program of many units what a held-back function names is
        // walked all the same: the units agree on what each walks, held
        // back or not.)
        if !wholeProgram() {
            externCount = savedExterns
            structCount = savedStructs
            headerGlobalCount = savedHeaderGlobals
        }
        if signatureIsForeign(obj) {
            marker("this function takes or returns a type from a header (translate that first); its translation:")
        } else if bodyUnknown(obj.*.body) && !callsForeign(obj.*.body) {
            marker("this function has what the translator has no Mlx for (variadic arguments, a goto, alloca); its translation:")
        } else if !callsForeign(obj.*.body) {
            marker("this function works on a value of a type the Mlx lacks (opaque here); its translation:")
        } else {
            marker("this function calls one that takes or returns a type the Mlx lacks (")
            putFunctionName(foreignCallee)
            put("); its translation:")
        }
        newline()
        putCommented(textOf(&text))
        return
    }
    if liveFunctionCount < MAX_LIST {
        liveFunctionList[liveFunctionCount] = o
        liveFunctionCount += 1
    } else {
        listsFull = true
    }
    emitFunctionText(o)
}

// A method's `self`: a plain pointer to the class, const for a const
// method.
fn putSelf(obj: *ast.Obj, param: *ast.Obj) -> void {
    put("self: *")
    putType(types.unqualified(types.at(param.*.ty).*.base))
}

// The parameters copied into locals (see emitFunctionText).
var copiedParams: [64]usize = undefined
var copiedCount: usize = 0

// Whether the tree assigns the variable `o` (or a member of it) or takes
// its address (a method called on it, a field written through it).
fn mutatesVariable(n: usize, o: usize) -> bool {
    if n == 0 { return false }
    const node = ast.node(n)
    if node.*.kind == ast.ASSIGN && rootVariable(node.*.lhs) == o { return true }
    if node.*.kind == ast.ADDR && rootVariable(node.*.lhs) == o { return true }
    if node.*.kind == ast.MEMZERO && rootVariable(node.*.lhs) == o { return true }
    if mutatesVariable(node.*.lhs, o) || mutatesVariable(node.*.rhs, o) || mutatesVariable(node.*.cond, o) || mutatesVariable(node.*.then, o) || mutatesVariable(node.*.els, o) || mutatesVariable(node.*.init, o) || mutatesVariable(node.*.inc, o) { return true }
    var b = node.*.body
    while b != 0 {
        if mutatesVariable(b, o) { return true }
        b = ast.node(b).*.next
    }
    var a = node.*.args
    while a != 0 {
        if mutatesVariable(a, o) { return true }
        a = ast.node(a).*.next
    }
    return false
}

// The variable an lvalue is rooted in (`x`, `x.m`, `x.m[i]`), or 0.
fn rootVariable(n: usize) -> usize {
    var e = n
    while e != 0 {
        const kind = ast.kindOf(e)
        if kind == ast.VAR { return ast.node(e).*.variable }
        if kind == ast.MEMBER || kind == ast.CAST { e = ast.node(e).*.lhs } else if kind == ast.DEREF && ast.kindOf(ast.node(e).*.lhs) == ast.ADD { e = ast.node(ast.node(e).*.lhs).*.lhs } else if kind == ast.DEREF && ast.kindOf(ast.node(e).*.lhs) == ast.ADDR { e = ast.node(ast.node(e).*.lhs).*.lhs } else { return 0 }
    }
    return 0
}

// The function being written (its return type decides a returned
// reference's unwrapping).
var currentFunction: usize = 0

fn emitFunctionText(o: usize) -> void {
    const obj = ast.obj(o)
    currentFunction = o
    resetLocals()
    chosenCount = 0
    loopDepth = 0
    copiedCount = 0
    loopSerial = 0
    dispatchSerial = 0
    targetCount = 0
    put("// from ")
    putPlace(obj.*.token)
    newline()
    putNamespaceComment(obj)
    put(if obj.*.isStatic { "fn " } else { "pub fn " })
    putFunctionName(obj)
    putByte(40)
    var c = obj.*.params
    var first = true
    while c != 0 {
        const p = base.getWord(c)
        const param = ast.obj(p)
        c = base.getWord(c + 8)
        // (The hidden result buffer of a function returning a class by
        // value is the return value in Mlx.)
        if param.*.isResultBuffer { continue }
        if !first { put(", ") }
        first = false
        if param.*.name == names.K_THIS {
            putSelf(obj, param)
        } else {
            // (A class taken by value that C++ hands over by its address,
            // one with a copy constructor: the Mlx takes the value, the
            // copy the caller made.)
            const taken = indirectParameter(obj, p)
            const shown = if taken != 0 { taken } else { p }
            ident(bindLocal(shown))
            // (A parameter the body assigns or takes the address of: the
            // Mlx parameter is `NAME_in`, copied into `var NAME` below.)
            if mutatesVariable(obj.*.body, shown) {
                put("_in")
                if copiedCount < 64 {
                    copiedParams[copiedCount] = shown
                    copiedCount += 1
                }
            }
            put(": ")
            putType(ast.obj(shown).*.ty)
        }
    }
    if types.at(obj.*.ty).*.variadic { put(if first { "va_arguments: []const u64" } else { ", va_arguments: []const u64" }) }
    put(") -> ")
    putType(types.at(obj.*.ty).*.base)
    put(" {\n")
    var copied: usize = 0
    while copied < copiedCount {
        indent(1)
        put("var ")
        putLocal(copiedParams[copied])
        put(": ")
        putType(ast.obj(copiedParams[copied]).*.ty)
        put(" = ")
        putLocal(copiedParams[copied])
        put("_in\n")
        copied += 1
    }
    // The locals get their names, in declaration order (the list is the
    // other way round).
    const firstLocal = localCount
    var l = obj.*.locals
    var count: usize = 0
    while l != 0 {
        count += 1
        l = ast.obj(l).*.next
    }
    l = obj.*.locals
    var k = count
    while l != 0 {
        k -= 1
        if k < MAX_LOCALS { localOrder[k] = l }
        l = ast.obj(l).*.next
    }
    k = 0
    while k < count && k < MAX_LOCALS {
        const local = ast.obj(localOrder[k])
        if !isParam(obj, localOrder[k]) && !isTakenByValue(obj, localOrder[k]) && !local.*.isLiteral && !local.*.isResultBuffer && local.*.name != names.K_THIS { _ = bindLocal(localOrder[k]) }
        k += 1
    }
    // The body, then the locals it uses declared before it.
    const savedOut = out
    out = emptyBuffer()
    emitBody(obj.*.body, 1)
    // (A body that does not end in a return, a `for (;;)` with the returns
    // inside: the Mlx wants one after it.)
    if types.at(types.at(obj.*.ty).*.base).*.kind != types.VOID && !endsAbruptly(obj.*.body) {
        indent(1)
        put("return undefined\n")
    }
    const body = out
    out = savedOut
    k = firstLocal
    while k < localCount {
        if localUsed[k] && !isParam(obj, localObj[k]) && !isTakenByValue(obj, localObj[k]) {
            indent(1)
            put("var ")
            ident(localName[k])
            put(": ")
            putType(ast.obj(localObj[k]).*.ty)
            put(" = undefined\n")
        }
        k += 1
    }
    putChosenLocals()
    // (Every line of the body, the hoisted statements among them.)
    putStatementText(textOf(&body))
    put("}\n\n")
}

// The constructions of the unit's global objects (a class object with a
// constructor, a variable whose initializer is no constant): C++ runs
// them before main, Mlx has no code before main, so they are a function
// of the module, `lattice_start`, which the program's start calls once
// for every unit that has one (tools/lattice_translate.sh writes that
// start; a test calls its unit's).
fn emitStart() -> void {
    currentFunction = 0
    resetLocals()
    chosenCount = 0
    loopDepth = 0
    copiedCount = 0
    loopSerial = 0
    dispatchSerial = 0
    targetCount = 0
    // (The temporaries of the expressions, in declaration order: the
    // list is the other way round.)
    var l = program.startLocals()
    var count: usize = 0
    while l != 0 {
        count += 1
        l = ast.obj(l).*.next
    }
    l = program.startLocals()
    var k = count
    while l != 0 {
        k -= 1
        if k < MAX_LOCALS { localOrder[k] = l }
        l = ast.obj(l).*.next
    }
    k = 0
    while k < count && k < MAX_LOCALS {
        if !ast.obj(localOrder[k]).*.isLiteral { _ = bindLocal(localOrder[k]) }
        k += 1
    }
    const savedOut = out
    out = emptyBuffer()
    var cell = program.globalInitializers()
    while cell != 0 {
        emitStmt(base.getWord(cell), 1)
        cell = base.getWord(cell + 8)
    }
    const body = out
    out = savedOut
    put("// The unit's global objects made, as C++ makes them before main: the\n// program's start calls this once.\npub fn lattice_start() -> void {\n")
    k = 0
    while k < localCount {
        if localUsed[k] {
            indent(1)
            put("var ")
            ident(localName[k])
            put(": ")
            putType(ast.obj(localObj[k]).*.ty)
            put(" = undefined\n")
        }
        k += 1
    }
    putChosenLocals()
    putStatementText(textOf(&body))
    put("}\n\n")
}

fn emitExtern(o: usize) -> void {
    const obj = ast.obj(o)
    const t = types.at(obj.*.ty)
    put("extern(\"c\") fn ")
    putFunctionName(obj)
    putByte(40)
    var p = t.*.params
    var first = true
    var index: usize = 0
    while p != 0 {
        if !first { put(", ") }
        first = false
        const param = types.param(p)
        if param.*.name == names.K_THIS {
            put("self: ")
            putPointer(types.at(param.*.ty).*.base, false)
        } else {
            if param.*.name == 0 {
                put("argument")
                putNumber(@intCast(u64, index))
            } else {
                ident(param.*.name)
            }
            put(": ")
            putType(param.*.ty)
        }
        p = param.*.next
        index += 1
    }
    if t.*.variadic && !isCFunction(obj) { put(if first { "va_arguments: []const u64" } else { ", va_arguments: []const u64" }) }
    put(") -> ")
    putType(t.*.base)
    if t.*.variadic && isCFunction(obj) {
        put("  ")
        marker("variadic in C: the arguments after these are not declared")
    }
    newline()
    if obj.*.linkName != 0 && !obj.*.externC {
        marker("the C++ symbol is ")
        put(base.nameOf(obj.*.linkName))
        put(" (mangled: a C shim is needed to call it)")
        newline()
    }
}

// ---------------------------------------------------------------------------
// The unit

// Whether a record is declared in this unit's own header (`x.h` of
// `x.cpp`): the unit exports it whether or not its own code names it.
fn fromOwnHeader(ty: usize) -> bool {
    const t = types.at(ty)
    if !isRecordKind(t.*.kind) || t.*.members == 0 || t.*.name == 0 || isStdArray(ty) { return false }
    const token = types.member(t.*.members).*.token
    if token == 0 || inMainFile(token) { return false }
    const path = fileOfToken(token)
    if isStdHeader(path) { return false }
    return mainUnitName != 0 && base.same(baseNameOf(path), base.nameOf(mainUnitName))
}

fn noteOwnHeaderRecord(ty: usize) -> void {
    if ty == 0 { return }
    var t = types.at(ty)
    var inner = ty
    while t.*.kind == types.PTR || t.*.kind == types.REF || t.*.kind == types.ARRAY {
        inner = t.*.base
        t = types.at(inner)
    }
    inner = types.unqualified(inner)
    if fromOwnHeader(inner) { noteType(inner) }
}

// The records of this unit's own header named by any function or
// variable of the unit: noted, so the translation carries them for the
// other units that import this one.
fn noteOwnHeaderRecords() -> void {
    var o = unitGlobals
    while o != 0 {
        const obj = ast.obj(o)
        if obj.*.isFunction {
            if obj.*.classType != 0 { noteOwnHeaderRecord(obj.*.classType) }
            const ft = types.at(obj.*.ty)
            noteOwnHeaderRecord(ft.*.base)
            var p = ft.*.params
            while p != 0 {
                noteOwnHeaderRecord(types.param(p).*.ty)
                p = types.param(p).*.next
            }
        } else if !obj.*.isLocal {
            noteOwnHeaderRecord(obj.*.ty)
        }
        o = obj.*.next
    }
}

pub fn writeUnit(globals: usize, file: u32) -> void {
    mainFile = file
    unitGlobals = globals
    mainUnitName = base.intern(baseNameOf(base.nameOf(base.fileName(file))))
    usedModuleCount = 0
    out = emptyBuffer()
    pre = emptyBuffer()
    notes = emptyBuffer()
    markerCount = 0
    structCount = 0
    externCount = 0
    headerGlobalCount = 0
    liveFunctionCount = 0
    clearFunctionNames()
    clearStatics()
    usesStd = false
    usesRuntime = false
    listsFull = false
    tablesText = emptyBuffer()
    deletingCount = 0
    pendingDataMark = 0
    memoClear()
    indexClasses()
    var slot: usize = 0
    while slot < KEY_SLOTS {
        keyOwner[slot] = 0
        slot += 1
    }
    indexText = emptyBuffer()
    if manifestLength != 0 && !manifestLoaded { loadManifest() }
    findHeldBack()
    // The globals and functions of the main file (the records and the
    // calls they mention are noted as they are written).
    var functions: usize = 0
    var o = globals
    emittedGlobalCount = 0
    while o != 0 {
        const obj = ast.obj(o)
        if !obj.*.isFunction && !obj.*.isLocal && !obj.*.isLiteral && inMainFile(obj.*.token) && !(obj.*.isExtern && !obj.*.isDefinition) && !otherDefinition(globals, o) { emitGlobal(o) }
        o = obj.*.next
    }
    o = globals
    while o != 0 {
        const obj = ast.obj(o)
        if functionHere(obj) {
            emitFunction(o)
            functions += 1
        }
        o = obj.*.next
    }
    if program.globalInitializers() != 0 { emitStart() }
    const body = out
    noteOwnHeaderRecords()
    // The records: those defined here as structs, the headers' as structs
    // with their inline methods (they name more records: the list grows
    // while it is walked), the others as marks.
    out = emptyBuffer()
    // (The records and the carried functions name more of each other:
    // both lists grow while they are walked, to a fixed point.)
    var k: usize = 0
    var carried: usize = 0
    var carriedDone: usize = 0
    var globalsDone: usize = 0
    var deletingDone: usize = 0
    var externTypesDone: usize = 0
    while k < structCount || carriedDone < externCount || globalsDone < headerGlobalCount || deletingDone < deletingCount || externTypesDone < externCount {
        while k < structCount {
            if definedHere(structList[k]) {
                emitStruct(structList[k])
            } else if moduleOfType(structList[k]) != 0 {
                useModule(moduleOfType(structList[k]))
            } else if ownedHere(structList[k]) || translatable(structList[k]) {
                emitHeaderRecord(structList[k])
            }
            k += 1
        }
        // The headers' functions the file calls and the headers define (an
        // inline function, a template's instance): carried along as well.
        while carriedDone < externCount {
            const o = externList[carriedDone]
            const obj = ast.obj(o)
            if obj.*.body != 0 && obj.*.classType == 0 && !functionHere(obj) && !isLiveFunction(o) && !types.at(obj.*.ty).*.variadic {
                if carried == 0 { put("// The headers' functions the file calls, carried along:\n") }
                carried += 1
                emitFunction(o)
                newline()
            }
            carriedDone += 1
        }
        // The headers' constants the functions name, and the vtables (a
        // table names its class's functions: more to carry).
        while globalsDone < headerGlobalCount {
            // (A declaration and its definition are two objects: once.)
            if !otherDefinition(unitGlobals, headerGlobalList[globalsDone]) { emitGlobal(headerGlobalList[globalsDone]) }
            globalsDone += 1
        }
        while deletingDone < deletingCount {
            emitDeleting(deletingList[deletingDone])
            deletingDone += 1
        }
        // (The records the declarations of what is called elsewhere
        // name, a C library's `pthread_mutexattr_t *`: noted while the
        // records are still being written.)
        while externTypesDone < externCount {
            const called = ast.obj(externList[externTypesDone])
            if !functionHere(called) && called.*.body == 0 && !signatureIsForeign(called) {
                const savedOut = out
                const savedMarkers = markerCount
                out = emptyBuffer()
                emitExtern(externList[externTypesDone])
                out = savedOut
                markerCount = savedMarkers
            }
            externTypesDone += 1
        }
    }
    var foreign: usize = 0
    k = 0
    while k < structCount {
        if !isTranslated(structList[k]) { logRecord(structList[k], false) }
        // (In a program of many units a record no unit has in full, a
        // Vulkan handle's `struct VkImage_T`, is declared by its home.)
        const listed = recordEntry(structList[k])
        if !isTranslated(structList[k]) && (listed == 0 || (!elsewhere(listed) && !entryFlag(listed))) {
            // Opaque: pointers to it are passed along, nothing reads it.
            if listed != 0 {
                put("// ")
                put(base.nameOf(types.at(structList[k]).*.name))
                put(": declared only, in every unit of the program (opaque)\n")
            } else {
                marker("the type ")
                putTypeName(structList[k])
                put(" comes from a header (")
                put(base.nameOf(types.at(structList[k]).*.name))
                put("), opaque here: translate or import it\n")
            }
            put("pub const ")
            putTypeName(structList[k])
            put(" = extern struct {\n}\n")
            foreign += 1
        }
        k += 1
    }
    if foreign > 0 { newline() }
    const records = out
    // The calls outside the file.
    out = emptyBuffer()
    var declared: usize = 0
    k = 0
    while k < externCount {
        // (A function the program defines is its home's, not declared.)
        if !functionHere(ast.obj(externList[k])) && !isLiveFunction(externList[k]) && functionEntry(ast.obj(externList[k])) == 0 {
            if declared == 0 { put("// Called, defined elsewhere:\n") }
            declared += 1
            if signatureIsForeign(ast.obj(externList[k])) {
                marker("called, takes or returns a type the Mlx lacks: ")
                putFunctionName(ast.obj(externList[k]))
                newline()
            } else {
                emitExtern(externList[k])
            }
        }
        k += 1
    }
    if declared > 0 { newline() }
    const externs = out
    // The file.
    out = emptyBuffer()
    put("// Translated by mlx-cc --emit-mlx from ")
    put(base.nameOf(base.fileName(mainFile)))
    put(": a first version of the C++ (LATTICE.md).\n")
    put("// The `// LATTICE:` marks name what the hand settles; the notes at the end list the rest.\n")
    if usesStd { put("const math = @import(\"std.math\")\n") }
    if usesRuntime {
        put("const c = @import(\"")
        put(runtimeImport())
        put("\")\n")
    }
    k = 0
    while k < usedModuleCount {
        put("const ")
        put(base.nameOf(usedModules[k]))
        put(" = @import(\"")
        if base.same(base.nameOf(usedModules[k]), "libcpp") && stdModuleLength > 0 {
            put(base.bytes(stdModuleAt, stdModuleLength))
        } else {
            put("./")
            put(base.nameOf(usedModules[k]))
            put(".mlx")
        }
        put("\")\n")
        k += 1
    }
    newline()
    put(textOf(&records))
    put(textOf(&body))
    put(textOf(&tablesText))
    if functions == 0 {
        marker("no function of the main file (id ")
        putNumber(@intCast(u64, mainFile))
        put(") was found; the objects seen, with their files:\n")
        o = globals
        var shown: usize = 0
        while o != 0 && shown < 40 {
            const obj = ast.obj(o)
            if !obj.*.isLocal && !obj.*.isLiteral {
                put("//   ")
                ident(obj.*.name)
                put(if obj.*.isFunction { " fn" } else { " var" })
                put(" token-file ")
                putNumber(if obj.*.token != 0 { @intCast(u64, tokens.at(obj.*.token).*.file) } else { 0 })
                newline()
                shown += 1
            }
            o = obj.*.next
        }
    }
    put(textOf(&externs))
    if listsFull { note("the translator's lists were full: records, functions or names are missing here (emitmlx.mlx, MAX_LIST)") }
    if notes.length > 0 {
        put("// Notes:\n")
        put(textOf(&notes))
    }
    put("// LATTICE: ")
    putNumber(@intCast(u64, markerCount))
    put(" marks in this file.\n")
    if indexLength != 0 && !program.writeBytes(base.bytes(indexAt, indexLength), indexText.data, indexText.length) {
        base.say("mlx-cc: cannot write ")
        base.say(base.bytes(indexAt, indexLength))
        base.say("\n")
        base.exit(1)
    }
    if !program.writeBytes(outputPath(), out.data, out.length) {
        base.say("mlx-cc: cannot write ")
        base.say(outputPath())
        base.say("\n")
        base.exit(1)
    }
}
