// The preprocessed tokens made ready for the parser (C11 translation
// phases 6 and 7): keywords told from identifiers, preprocessing numbers
// read as integer or floating constants with their C type (C11 6.4.4),
// character constants given theirs, and adjacent string literals joined
// and decoded into the bytes of their array (C11 6.4.5).
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const lexer = @import("./lexer.mlx")
const standard = @import("./standard.mlx")
const extended = @import("./extended.mlx")

// String literal element kinds: char, char16_t, char32_t, wchar_t.
const PLAIN: u8 = 0
const UTF16: u8 = 1
const UTF32: u8 = 2
const WIDE: u8 = 3

fn isDigit(c: u8) -> bool { return c >= 48 && c <= 57 }

fn isHex(c: u8) -> bool { return isDigit(c) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }

fn digitValue(c: u8) -> u64 {
    if isDigit(c) { return @intCast(u64, c - 48) }
    if c >= 97 { return @intCast(u64, c - 97 + 10) }
    return @intCast(u64, c - 65 + 10)
}

fn lower(c: u8) -> u8 {
    if c >= 65 && c <= 90 { return c + 32 }
    return c
}

// Reads an integer constant; false when the text is not one (it may be a
// floating constant).
fn readInteger(token: usize) -> bool {
    const text = tokens.text(token)
    var index: usize = 0
    var radix: u64 = 10
    if text.length > 2 && text[0] == 48 && lower(text[1]) == 120 && isHex(text[2]) {
        radix = 16
        index = 2
    } else if text.length > 2 && text[0] == 48 && lower(text[1]) == 98 && (text[2] == 48 || text[2] == 49) {
        radix = 2
        index = 2
    } else if text[0] == 48 {
        radix = 8
    }
    // The digits into limbs of 64 bits, the lowest first (a wb constant
    // may be wider than 64 bits); `value` is the low 64.
    var limbs: [64]u64 = undefined
    var count: usize = 1
    limbs[0] = 0
    while index < text.length {
        const c = text[index]
        if c == 39 {
            // A digit separator (C23).
            index += 1
            continue
        }
        if !isHex(c) { break }
        const digit = digitValue(c)
        if digit >= radix {
            // An 8 or 9 in an octal number, or a decimal exponent's `e`:
            // not an integer.
            return false
        }
        // limbs = limbs * radix + digit, in 32-bit halves.
        var carry = digit
        var limb: usize = 0
        while limb < count {
            const low = (limbs[limb] & 4294967295) * radix + carry
            const high = (limbs[limb] >> 32) * radix + (low >> 32)
            limbs[limb] = (high << 32) | (low & 4294967295)
            carry = high >> 32
            limb += 1
        }
        if carry != 0 {
            if count == 64 { tokens.errorAt(token, "integer constant is too large") }
            limbs[count] = carry
            count += 1
        }
        index += 1
    }
    const value = limbs[0]
    // The suffix: u and l, ll in either order; wb (C23) for a _BitInt;
    // z (C++23) for size_t's signed type, with u size_t.
    var unsignedSuffix = false
    var longs: u32 = 0
    var bitPrecise = false
    var sized = false
    while index < text.length {
        const c = lower(text[index])
        if c == 117 && !unsignedSuffix {
            unsignedSuffix = true
            index += 1
        } else if c == 122 && longs == 0 && !bitPrecise && !sized {
            sized = true
            index += 1
        } else if c == 108 && longs == 0 && !bitPrecise && !sized {
            longs = 1
            index += 1
            if index < text.length && text[index] == text[index - 1] {
                longs = 2
                index += 1
            }
        } else if c == 119 && index + 1 < text.length && lower(text[index + 1]) == 98 && longs == 0 && !bitPrecise {
            bitPrecise = true
            index += 2
        } else {
            return false
        }
    }
    var ty: usize = 0
    if bitPrecise {
        // The narrowest _BitInt that holds the value (a sign bit more
        // for a signed one); over 64 bits the limbs go with the token.
        var needed: i64 = @intCast(i64, count - 1) * 64
        var rest = limbs[count - 1]
        while rest != 0 {
            needed += 1
            rest = rest >> 1
        }
        if unsignedSuffix {
            if needed == 0 { needed = 1 }
        } else {
            needed += 1
        }
        if needed > types.MAX_BITINT { tokens.errorAt(token, "integer constant is too large for a _BitInt") }
        const t = tokens.at(token)
        t.*.kind = tokens.INTEGER
        t.*.value = value
        t.*.ty = types.bitIntOf(needed, unsignedSuffix)
        if needed > 64 {
            const words = @intCast(usize, (needed + 63) / 64)
            const payload = base.alloc(words * 8)
            var word: usize = 0
            while word < words {
                base.putWord(payload + word * 8, @intCast(usize, if word < count { limbs[word] } else { 0 }))
                word += 1
            }
            t.*.data = payload
        }
        return true
    }
    if count > 1 { tokens.warnAt(token, "integer constant is too large for its type") }
    if sized {
        const t = tokens.at(token)
        t.*.kind = tokens.INTEGER
        t.*.value = value
        t.*.ty = if unsignedSuffix { types.ulongOf() } else { types.longOf() }
        return true
    }
    const high63 = value >> 63 != 0
    const high32 = value >> 32 != 0
    const high31 = value >> 31 != 0
    if radix == 10 {
        if unsignedSuffix && longs > 0 {
            ty = if longs > 1 { types.ulongLongOf() } else { types.ulongOf() }
        } else if longs > 1 {
            ty = if high63 { types.ulongLongOf() } else { types.longLongOf() }
        } else if longs > 0 {
            ty = if high63 { types.ulongOf() } else { types.longOf() }
        } else if unsignedSuffix {
            ty = if high32 { types.ulongOf() } else { types.uintOf() }
        } else if high63 {
            ty = types.ulongOf()
        } else if high31 {
            ty = types.longOf()
        } else {
            ty = types.intOf()
        }
    } else {
        if unsignedSuffix && longs > 0 {
            ty = if longs > 1 { types.ulongLongOf() } else { types.ulongOf() }
        } else if longs > 1 {
            ty = if high63 { types.ulongLongOf() } else { types.longLongOf() }
        } else if longs > 0 {
            ty = if high63 { types.ulongOf() } else { types.longOf() }
        } else if unsignedSuffix {
            ty = if high32 { types.ulongOf() } else { types.uintOf() }
        } else if high63 {
            ty = types.ulongOf()
        } else if high32 {
            ty = types.longOf()
        } else if high31 {
            ty = types.uintOf()
        } else {
            ty = types.intOf()
        }
    }
    const t = tokens.at(token)
    t.*.kind = tokens.INTEGER
    t.*.value = value
    t.*.ty = ty
    return true
}

// 10 to the power `exponent` (0 to 22 exactly, beyond by repeated
// multiplication).
fn powerOfTen(exponent: i64) -> f64 {
    var result: f64 = 1.0
    var count: i64 = 0
    while count < exponent {
        result = result * 10.0
        count += 1
    }
    return result
}

// A long double constant's digits in the extended format: up to 19
// decimal (16 hexadecimal) significant digits, the rest counted into the
// exponent.
fn readExtended(text: []const u8) -> (u64, u16) {
    var index: usize = 0
    var exponent: i64 = 0
    var afterPoint = false
    if text.length > 2 && text[0] == 48 && lower(text[1]) == 120 {
        index = 2
        const hexDigits = extended.newDigits()
        while index < text.length && (isHex(text[index]) || text[index] == 46 || text[index] == 39) {
            const c = text[index]
            if c == 46 {
                afterPoint = true
            } else if c != 39 {
                if extended.hasRoom(hexDigits) {
                    extended.pushHex(hexDigits, digitValue(c))
                    if afterPoint { exponent -= 4 }
                } else if !afterPoint {
                    exponent += 4
                }
            }
            index += 1
        }
        if index < text.length && lower(text[index]) == 112 {
            index += 1
            var negative = false
            if index < text.length && (text[index] == 43 || text[index] == 45) {
                negative = text[index] == 45
                index += 1
            }
            var e: i64 = 0
            while index < text.length && (isDigit(text[index]) || text[index] == 39) {
                if e < 100000 && text[index] != 39 { e = e * 10 + @intCast(i64, text[index] - 48) }
                index += 1
            }
            exponent += if negative { 0 - e } else { e }
        }
        return extended.fromWideBinary(hexDigits, exponent, false)
    }
    const digits = extended.newDigits()
    while index < text.length && (isDigit(text[index]) || text[index] == 46 || text[index] == 39) {
        const c = text[index]
        if c == 46 {
            afterPoint = true
        } else if c != 39 {
            if extended.hasRoom(digits) {
                extended.pushDigit(digits, @intCast(u64, c - 48))
                if afterPoint { exponent -= 1 }
            } else if !afterPoint {
                exponent += 1
            }
        }
        index += 1
    }
    if index < text.length && lower(text[index]) == 101 {
        index += 1
        var negative = false
        if index < text.length && (text[index] == 43 || text[index] == 45) {
            negative = text[index] == 45
            index += 1
        }
        var e: i64 = 0
        while index < text.length && (isDigit(text[index]) || text[index] == 39) {
            if e < 100000 && text[index] != 39 { e = e * 10 + @intCast(i64, text[index] - 48) }
            index += 1
        }
        exponent += if negative { 0 - e } else { e }
    }
    return extended.fromDigits(digits, exponent, false)
}

// Reads a floating constant (decimal or hexadecimal); the value's bits.
fn readFloating(token: usize) -> void {
    const text = tokens.text(token)
    var index: usize = 0
    var value: f64 = 0.0
    var hex = false
    if text.length > 2 && text[0] == 48 && lower(text[1]) == 120 {
        hex = true
        index = 2
    }
    if hex {
        var mantissa: u64 = 0
        var binaryExponent: i64 = 0
        var afterPoint = false
        while index < text.length && (isHex(text[index]) || text[index] == 46 || text[index] == 39) {
            if text[index] == 39 {
                // A digit separator (C23).
            } else if text[index] == 46 {
                afterPoint = true
            } else if mantissa >> 59 == 0 {
                mantissa = mantissa * 16 + digitValue(text[index])
                if afterPoint { binaryExponent -= 4 }
            } else if !afterPoint {
                binaryExponent += 4
            }
            index += 1
        }
        if index < text.length && lower(text[index]) == 112 {
            index += 1
            var negative = false
            if index < text.length && (text[index] == 43 || text[index] == 45) {
                negative = text[index] == 45
                index += 1
            }
            var exponent: i64 = 0
            while index < text.length && (isDigit(text[index]) || text[index] == 39) {
                if text[index] != 39 { exponent = exponent * 10 + @intCast(i64, text[index] - 48) }
                index += 1
            }
            binaryExponent += if negative { 0 - exponent } else { exponent }
        }
        value = @floatFromInt(f64, mantissa)
        while binaryExponent > 0 {
            value = value * 2.0
            binaryExponent -= 1
        }
        while binaryExponent < 0 {
            value = value / 2.0
            binaryExponent += 1
        }
    } else {
        // The significant digits as an integer (19 at most) and the power
        // of ten that scales them.
        var mantissa: u64 = 0
        var scale: i64 = 0
        var afterPoint = false
        while index < text.length && (isDigit(text[index]) || text[index] == 46 || text[index] == 39) {
            if text[index] == 39 {
                // A digit separator (C23).
            } else if text[index] == 46 {
                afterPoint = true
            } else if mantissa < 1000000000000000000 {
                mantissa = mantissa * 10 + @intCast(u64, text[index] - 48)
                if afterPoint { scale -= 1 }
            } else if !afterPoint {
                scale += 1
            }
            index += 1
        }
        if index < text.length && lower(text[index]) == 101 {
            index += 1
            var negative = false
            if index < text.length && (text[index] == 43 || text[index] == 45) {
                negative = text[index] == 45
                index += 1
            }
            var exponent: i64 = 0
            while index < text.length && (isDigit(text[index]) || text[index] == 39) {
                if exponent < 100000 && text[index] != 39 { exponent = exponent * 10 + @intCast(i64, text[index] - 48) }
                index += 1
            }
            scale += if negative { 0 - exponent } else { exponent }
        }
        value = @floatFromInt(f64, mantissa)
        if scale > 0 {
            if scale > 400 { scale = 400 }
            value = value * powerOfTen(scale)
        } else if scale < 0 {
            // Below 1e-308 the divisor itself would overflow: divide in
            // two steps.
            var down = 0 - scale
            if down > 300 {
                value = value / powerOfTen(300)
                down -= 300
            }
            if down > 400 { down = 400 }
            value = value / powerOfTen(down)
        }
    }
    var ty = types.doubleOf()
    var payload: usize = 0
    // The value to 64 bits from the digits themselves (the arithmetic
    // above runs out of range near DBL_MAX), the double nearest to it;
    // a long double keeps the 80 bits in the arena.
    const exact = readExtended(text)
    value = extended.toDouble(exact.0, exact.1)
    if literalLongDouble {
        // The argument of a user-defined literal: a long double.
        ty = types.ldoubleOf()
        payload = base.alloc(extended.SIZE)
        extended.store(payload, exact.0, exact.1)
    }
    if index < text.length {
        const c = lower(text[index])
        if c == 102 {
            ty = types.floatOf()
            index += 1
        } else if c == 108 {
            ty = types.ldoubleOf()
            index += 1
            payload = base.alloc(extended.SIZE)
            extended.store(payload, exact.0, exact.1)
        }
    }
    if index != text.length { tokens.errorAt(token, "invalid numeric constant") }
    const t = tokens.at(token)
    t.*.kind = tokens.FLOATING
    t.*.value = @bitCast(u64, value)
    t.*.ty = ty
    t.*.data = payload
}

// A string literal token's element kind and where its opening quote is.
fn stringKind(token: usize) -> (u8, usize) {
    const start = tokens.at(token).*.start
    const c = base.get8(start)
    if c == 34 { return -> (PLAIN, start) }
    if c == 76 { return -> (WIDE, start + 1) }
    if c == 85 { return -> (UTF32, start + 1) }
    if base.get8(start + 1) == 56 { return -> (PLAIN, start + 2) }
    return -> (UTF16, start + 1)
}

fn unitSize(kind: u8) -> usize {
    if kind == PLAIN { return 1 }
    if kind == UTF16 { return 2 }
    return 4
}

// The code point of the UTF-8 sequence at `at` and where the next one
// starts.
fn utf8At(at: usize) -> (u64, usize) {
    const c = base.get8(at)
    if c < 128 { return -> (@intCast(u64, c), at + 1) }
    var count: usize = 2
    var value: u64 = @intCast(u64, c & 31)
    if c >= 240 {
        count = 4
        value = @intCast(u64, c & 7)
    } else if c >= 224 {
        count = 3
        value = @intCast(u64, c & 15)
    }
    var index: usize = 1
    while index < count {
        const next = base.get8(at + index)
        if next & 192 != 128 { return -> (@intCast(u64, c), at + 1) }
        value = (value << 6) | @intCast(u64, next & 63)
        index += 1
    }
    return -> (value, at + count)
}

fn putUnit(buffer: usize, length: usize, size: usize, value: u64) -> usize {
    if size == 1 {
        base.put8(buffer + length, @intCast(u8, value & 255))
    } else if size == 2 {
        base.put8(buffer + length, @intCast(u8, value & 255))
        base.put8(buffer + length + 1, @intCast(u8, (value >> 8) & 255))
    } else {
        base.put32(buffer + length, @intCast(u32, value & 4294967295))
    }
    return length + size
}

// The UTF-8 bytes of the code point `value`.
fn putUtf8(buffer: usize, length: usize, value: u64) -> usize {
    var written = length
    if value < 128 {
        base.put8(buffer + written, @intCast(u8, value))
        return written + 1
    }
    if value < 2048 {
        base.put8(buffer + written, @intCast(u8, 192 | (value >> 6)))
        base.put8(buffer + written + 1, @intCast(u8, 128 | (value & 63)))
        return written + 2
    }
    if value < 65536 {
        base.put8(buffer + written, @intCast(u8, 224 | (value >> 12)))
        base.put8(buffer + written + 1, @intCast(u8, 128 | ((value >> 6) & 63)))
        base.put8(buffer + written + 2, @intCast(u8, 128 | (value & 63)))
        return written + 3
    }
    base.put8(buffer + written, @intCast(u8, 240 | ((value >> 18) & 7)))
    base.put8(buffer + written + 1, @intCast(u8, 128 | ((value >> 12) & 63)))
    base.put8(buffer + written + 2, @intCast(u8, 128 | ((value >> 6) & 63)))
    base.put8(buffer + written + 3, @intCast(u8, 128 | (value & 63)))
    return written + 4
}

// Decodes the text of the string token into units of `kind`, appended at
// `buffer` + `length`; the new length in bytes.
fn decode(token: usize, kind: u8, buffer: usize, length: usize) -> usize {
    const quote = stringKind(token).1
    const end = tokens.at(token).*.start + @intCast(usize, tokens.at(token).*.length) - 1
    const size = unitSize(kind)
    var at = quote + 1
    var written = length
    while at < end {
        const c = base.get8(at)
        if c == 92 {
            // An escape gives the unit's value itself (\xFF is one byte
            // of a char string, one unit of a wide one); a universal
            // character name is a character, UTF-8 in a char string.
            const universal = base.get8(at + 1) == 117 || base.get8(at + 1) == 85
            const escaped = lexer.escape(at + 1)
            if universal && kind == PLAIN {
                written = putUtf8(buffer, written, escaped.0)
            } else if universal && kind == UTF16 && escaped.0 >= 65536 {
                const rest = escaped.0 - 65536
                written = putUnit(buffer, written, 2, 55296 + (rest >> 10))
                written = putUnit(buffer, written, 2, 56320 + (rest & 1023))
            } else {
                written = putUnit(buffer, written, size, escaped.0)
            }
            at = escaped.1
        } else if kind == PLAIN {
            base.put8(buffer + written, c)
            written += 1
            at += 1
        } else {
            const decoded = utf8At(at)
            if kind == UTF16 && decoded.0 >= 65536 {
                const rest = decoded.0 - 65536
                written = putUnit(buffer, written, 2, 55296 + (rest >> 10))
                written = putUnit(buffer, written, 2, 56320 + (rest & 1023))
            } else {
                written = putUnit(buffer, written, size, decoded.0)
            }
            at = decoded.1
        }
    }
    return written
}

// Whether the string literal token is a u8"..." one.
fn isUtf8(token: usize) -> bool {
    const start = tokens.at(token).*.start
    return base.get8(start) == 117 && base.get8(start + 1) == 56
}

// Joins the string literals starting at `first` (their kind is the wide
// one among them) into `first`; returns the token after them.
fn joinStrings(first: usize) -> usize {
    var kind: u8 = PLAIN
    var capacity: usize = 0
    var last = first
    var at = first
    while tokens.kind(at) == tokens.STRING {
        const found = stringKind(at).0
        if found != PLAIN {
            if kind != PLAIN && kind != found { tokens.errorAt(at, "unsupported non-standard concatenation of string literals") }
            kind = found
        }
        capacity += @intCast(usize, tokens.at(at).*.length) * 4
        last = at
        at = tokens.next(at)
    }
    const size = unitSize(kind)
    const buffer = base.alloc(capacity + 8)
    var length: usize = 0
    at = first
    while true {
        length = decode(at, kind, buffer, length)
        if at == last { break }
        at = tokens.next(at)
    }
    var element = types.charOf()
    if kind == UTF16 { element = types.ushortOf() }
    if kind == UTF32 { element = types.uintOf() }
    if kind == WIDE { element = types.intOf() }
    if standard.cpp {
        // C++'s character types of their own: u"" char16_t, U"" char32_t,
        // L"" wchar_t, u8"" char8_t (C++20).
        if kind == UTF16 { element = types.char16Of() }
        if kind == UTF32 { element = types.char32Of() }
        if kind == WIDE { element = types.wcharOf() }
        if kind == PLAIN && standard.cppYear >= 2020 && isUtf8(first) { element = types.char8Of() }
    }
    const t = tokens.at(first)
    t.*.data = buffer
    // In C++ a string literal is an array of const characters.
    t.*.ty = types.arrayOf(if standard.cpp { types.constOf(element) } else { element }, @intCast(i64, length / size) + 1)
    t.*.next = tokens.next(last)
    return t.*.next
}

// Character constants (their value is the lexer's) get their type.
fn readCharacter(token: usize) -> void {
    const start = tokens.at(token).*.start
    const c = base.get8(start)
    var ty = types.intOf()
    // In C++ a plain character constant is a char (an int in C).
    if standard.cpp && (c == 39 || (c == 117 && base.get8(start + 1) == 56)) { ty = types.charOf() }
    if c == 117 && base.get8(start + 1) != 56 { ty = types.ushortOf() }
    if c == 85 { ty = types.uintOf() }
    if standard.cpp {
        if c == 117 && base.get8(start + 1) != 56 { ty = types.char16Of() }
        if c == 85 { ty = types.char32Of() }
        if c == 76 { ty = types.wcharOf() }
        if c == 117 && base.get8(start + 1) == 56 && standard.cppYear >= 2020 { ty = types.char8Of() }
    }
    const t = tokens.at(token)
    if c == 117 && base.get8(start + 1) == 39 { t.*.value = t.*.value & 65535 }
    if c == 117 && base.get8(start + 1) == 56 { t.*.value = t.*.value & 255 }
    t.*.kind = tokens.INTEGER
    t.*.ty = ty
}

// Converts the list in place.
// A floating constant read as a user-defined literal's argument is a
// long double.
var literalLongDouble = false

// The suffix of a user-defined literal (C++: `10_s`, `1.5_ms`), where
// it starts in the number's text; 0 when there is none.
fn suffixStart(text: []const u8) -> usize {
    var index: usize = 0
    const radixPrefix = text.length > 2 && text[0] == 48 && (lower(text[1]) == 120 || lower(text[1]) == 98)
    if radixPrefix { index = 2 }
    while index < text.length {
        if text[index] == 95 { return index }
        index += 1
    }
    if radixPrefix { return 0 }
    // The standard library's suffixes have no underscore (`10ms`, `2s`,
    // `1h`): trailing letters that are no suffix of C's own.
    var start = text.length
    while start > 0 && isLetter(text[start - 1]) { start -= 1 }
    if start == text.length || start == 0 { return 0 }
    if !isDigit(text[start - 1]) && text[start - 1] != 46 { return 0 }
    const suffix = text[start..text.length]
    if builtinSuffix(suffix) { return 0 }
    return start
}

// Whether `s` is a suffix of C's own (integer, floating, _BitInt, GNU's
// imaginary).
fn builtinSuffix(s: []const u8) -> bool {
    if sameLower(s, "u") || sameLower(s, "l") || sameLower(s, "ul") || sameLower(s, "lu") || sameLower(s, "ll") { return true }
    if sameLower(s, "ull") || sameLower(s, "llu") || sameLower(s, "f") || sameLower(s, "z") || sameLower(s, "uz") || sameLower(s, "zu") { return true }
    if sameLower(s, "wb") || sameLower(s, "uwb") || sameLower(s, "df") || sameLower(s, "dd") || sameLower(s, "dl") { return true }
    return sameLower(s, "f16") || sameLower(s, "f32") || sameLower(s, "f64") || sameLower(s, "bf16") || sameLower(s, "i") || sameLower(s, "j")
}

fn isLetter(c: u8) -> bool { return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) }

fn sameLower(a: []const u8, b: []const u8) -> bool {
    if a.length != b.length { return false }
    var i: usize = 0
    while i < a.length {
        if lower(a[i]) != b[i] { return false }
        i += 1
    }
    return true
}

fn punct(model: usize, name: u32) -> usize {
    const t = tokens.copy(model)
    tokens.at(t).*.kind = tokens.PUNCT
    tokens.at(t).*.name = name
    tokens.at(t).*.length = 1
    tokens.at(t).*.flags = 0
    return t
}

// The name of the literal operator with `suffix`: `operator""_s`.
pub fn literalOperatorName(suffix: []const u8) -> u32 {
    return base.intern(base.join("operator\"\"", suffix))
}

// `literal suffix` (C++'s user-defined literal) as the call
// `operator""suffix(literal)` (`(literal, length)` for a string), the
// tokens put in place of `first` to `last`; the call's last token.
fn literalCall(first: usize, last: usize, suffix: []const u8, isString: bool) -> usize {
    const after = tokens.next(last)
    const callee = tokens.copy(first)
    tokens.at(callee).*.kind = tokens.IDENT
    tokens.at(callee).*.name = literalOperatorName(suffix)
    const open = punct(first, names.P_LPAREN)
    const literal = tokens.copy(first)
    // `first` becomes the callee (it may be pointed to), the literal a
    // copy of what it was.
    base.copy(first, callee, @sizeOf(tokens.Token))
    tokens.at(first).*.next = open
    tokens.at(open).*.next = literal
    var tail = literal
    if isString {
        tokens.at(literal).*.next = tokens.next(first)
        const comma = punct(first, names.P_COMMA)
        const length = tokens.copy(first)
        tokens.at(length).*.kind = tokens.INTEGER
        tokens.at(length).*.ty = types.ulongOf()
        const arrayType = tokens.at(literal).*.ty
        tokens.at(length).*.value = @intCast(u64, types.at(arrayType).*.arrayLength - 1)
        tokens.at(comma).*.next = length
        tokens.at(literal).*.next = comma
        tail = length
    }
    const close = punct(first, names.P_RPAREN)
    tokens.at(tail).*.next = close
    tokens.at(close).*.next = after
    return close
}

// C99's `_Pragma("...")` operator (made by macros: WebKit's
// IGNORE_WARNINGS_BEGIN): taken out of the tokens, as a #pragma the
// compiler does not act on is.
fn dropPragmaOperators(list: usize) -> void {
    var previous: usize = 0
    var t = list
    while !tokens.isEof(t) {
        const open = tokens.next(t)
        if tokens.kind(t) == tokens.IDENT && base.same(tokens.text(t), "_Pragma") && tokens.is(open, names.P_LPAREN) {
            var close = tokens.next(open)
            while tokens.kind(close) == tokens.STRING { close = tokens.next(close) }
            if tokens.is(close, names.P_RPAREN) {
                const after = tokens.next(close)
                if previous == 0 {
                    // The list's first token: it becomes the one after.
                    base.copy(t, after, @sizeOf(tokens.Token))
                } else {
                    tokens.at(previous).*.next = after
                    t = after
                }
                continue
            }
        }
        previous = t
        t = open
    }
}

pub fn convert(list: usize) -> void {
    dropPragmaOperators(list)
    var at = list
    while !tokens.isEof(at) {
        const kind = tokens.kind(at)
        if standard.cpp && kind == tokens.IDENT && tokens.name(at) == names.K_OPERATOR && tokens.kind(tokens.next(at)) == tokens.STRING && tokens.at(tokens.next(at)).*.length == 2 {
            // `operator""_s` (or `operator"" _s`): the literal operator's
            // name as one identifier.
            const quotes = tokens.next(at)
            const suffix = tokens.next(quotes)
            if tokens.kind(suffix) == tokens.IDENT {
                tokens.at(at).*.name = literalOperatorName(base.nameOf(tokens.name(suffix)))
                tokens.at(at).*.next = tokens.next(suffix)
                at = tokens.next(at)
                continue
            }
        }
        if standard.cpp && kind == tokens.NUMBER {
            const text = tokens.text(at)
            const split = suffixStart(text)
            if split > 0 {
                // `10_s`: the number without its suffix, as the argument.
                const suffix = text[split..text.length]
                tokens.at(at).*.length = @intCast(u32, split)
                const isInteger = readInteger(at)
                if !isInteger {
                    literalLongDouble = true
                    readFloating(at)
                    literalLongDouble = false
                } else {
                    tokens.at(at).*.ty = types.ulongLongOf()
                }
                at = tokens.next(literalCall(at, at, suffix, false))
                continue
            }
        }
        if standard.cpp && kind == tokens.STRING {
            // `"text"_s`: the joined strings, then the suffix.
            var last = at
            while tokens.kind(tokens.next(last)) == tokens.STRING { last = tokens.next(last) }
            const suffix = tokens.next(last)
            if tokens.kind(suffix) == tokens.IDENT && tokens.at(suffix).*.flags & tokens.SPACE_BEFORE == 0 {
                const rest = joinStrings(at)
                // joinStrings left `at` the whole string, followed by the suffix.
                tokens.at(at).*.next = tokens.next(suffix)
                at = tokens.next(literalCall(at, at, base.nameOf(tokens.name(suffix)), true))
                continue
            }
        }
        if kind == tokens.IDENT {
            const name = tokens.name(at)
            // A keyword of this variant (standard.mlx); C23's `bool` is
            // `_Bool`, `static_assert` is `_Static_assert` and so on.
            if name >= names.FIRST_KEYWORD && name <= names.LAST_KEYWORD && standard.isKeyword(name) {
                tokens.at(at).*.kind = tokens.KEYWORD
                tokens.at(at).*.name = standard.canonical(name)
            } else if standard.cpp && standard.cppYear >= 2020 && (base.same(base.nameOf(name), "consteval") || base.same(base.nameOf(name), "constinit")) {
                // C++20's `consteval` (a function is compiled as a
                // constexpr one; `if consteval` is read by the statement)
                // and `constinit` (passed over, as __extension__ is).
                tokens.at(at).*.kind = tokens.KEYWORD
                tokens.at(at).*.name = if base.same(base.nameOf(name), "consteval") { names.K_CONSTEXPR } else { names.K_GNU2_EXTENSION }
            } else if standard.cpp && alternativeToken(base.nameOf(name)) != 0 {
                // C++'s alternative tokens: `and` is `&&`, `not` is `!`.
                tokens.at(at).*.kind = tokens.PUNCT
                tokens.at(at).*.name = alternativeToken(base.nameOf(name))
            }
            at = tokens.next(at)
        } else if kind == tokens.NUMBER {
            if !readInteger(at) { readFloating(at) }
            at = tokens.next(at)
        } else if kind == tokens.CHAR {
            readCharacter(at)
            at = tokens.next(at)
        } else if kind == tokens.STRING {
            at = joinStrings(at)
        } else {
            at = tokens.next(at)
        }
    }
}

// The punctuator a C++ alternative token spells, 0 for another word.
fn alternativeToken(text: []const u8) -> u32 {
    if base.same(text, "and") { return names.P_ANDAND }
    if base.same(text, "or") { return names.P_OROR }
    if base.same(text, "not") { return names.P_BANG }
    if base.same(text, "not_eq") { return names.P_NE }
    if base.same(text, "bitand") { return names.P_AMP }
    if base.same(text, "bitor") { return names.P_PIPE }
    if base.same(text, "xor") { return names.P_CARET }
    if base.same(text, "compl") { return names.P_TILDE }
    if base.same(text, "and_eq") { return names.P_AND_ASSIGN }
    if base.same(text, "or_eq") { return names.P_OR_ASSIGN }
    if base.same(text, "xor_eq") { return names.P_XOR_ASSIGN }
    return 0
}
