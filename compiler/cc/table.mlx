// A table from a word to a word (an address or an id to what it stands
// for), open-addressed in the arena, doubled when half full. The lists
// the parser keeps for the whole unit (a function's return choices, the
// names a scope has resolved) are long by the end of a WebCore unit; a
// walk of such a list per function or per name was quadratic. Keys are
// not 0.
const base = @import("./base.mlx")

pub const Table = struct {
    slots: usize
    capacity: usize
    count: usize
}

pub fn make(capacity: usize) -> Table {
    var c: usize = 16
    while c < capacity { c *= 2 }
    return Table.{ .slots = base.alloc(c * 16), .capacity = c, .count = 0 }
}

// A table of its own in the arena (one per template, say): its address.
pub fn new() -> usize {
    const t = base.alloc(@sizeOf(Table))
    at(t).* = Table.{ .slots = 0, .capacity = 0, .count = 0 }
    return t
}

pub fn at(address: usize) -> *Table {
    unsafe { return @ptrFromInt(*Table, address) }
}

fn slotOf(t: *Table, key: usize) -> usize {
    return @intCast(usize, (@intCast(u64, key) *% 11400714819323198485) >> 20) & (t.*.capacity - 1)
}

// The value of `key`, 0 when the table has none.
pub fn get(t: *Table, key: usize) -> usize {
    if t.*.slots == 0 { return 0 }
    var slot = slotOf(t, key)
    while true {
        const at = t.*.slots + slot * 16
        const held = base.getWord(at)
        if held == 0 { return 0 }
        if held == key { return base.getWord(at + 8) }
        slot = (slot + 1) & (t.*.capacity - 1)
    }
    return 0
}

// Sets `key` to `value` (made or replaced).
pub fn set(t: *Table, key: usize, value: usize) -> void {
    if t.*.slots == 0 { t.* = make(1024) }
    if t.*.count * 2 >= t.*.capacity { grow(t) }
    var slot = slotOf(t, key)
    while true {
        const at = t.*.slots + slot * 16
        const held = base.getWord(at)
        if held == 0 {
            base.putWord(at, key)
            base.putWord(at + 8, value)
            t.*.count += 1
            return
        }
        if held == key {
            base.putWord(at + 8, value)
            return
        }
        slot = (slot + 1) & (t.*.capacity - 1)
    }
}

fn grow(t: *Table) -> void {
    const old = t.*
    t.* = make(old.capacity * 2)
    var i: usize = 0
    while i < old.capacity {
        const at = old.slots + i * 16
        const key = base.getWord(at)
        if key != 0 { set(t, key, base.getWord(at + 8)) }
        i += 1
    }
}
