// Where #include finds its files: "name" first next to the file that
// includes it, then like <name> in the directories of -I (in order),
// then in the system's (mlx-cc's own headers for mlxlibc). #include_next
// goes on from the directory after the one the including file came from.
const std = @import("std")
const base = @import("./base.mlx")
const table = @import("./table.mlx")

const SYS_access: usize = 21
// (WebCore compiles with more than 330: its own directories, one by one.)
const MAX_DIRS: usize = 1024

var dirs: usize = 0
var dirCount: usize = 0
var systemStart: usize = 0

pub fn init() -> void {
    dirs = base.alloc(MAX_DIRS * 4)
}

// A directory to search (a -I, or a system directory when `system`).
pub fn add(path: []const u8, system: bool) -> void {
    if dirCount == MAX_DIRS { base.fatal("too many include directories") }
    base.put32(dirs + dirCount * 4, base.intern(path))
    dirCount += 1
    if !system { systemStart = dirCount }
}

pub fn exists(path: []const u8) -> bool {
    return std.linux.syscall2(SYS_access, base.cPath(path), 0) == 0
}

// Whether `path` names a file to include (a directory of the name is
// none: WebCore's css/typedom/numeric beside <numeric>).
fn isHeader(path: []const u8) -> bool {
    return exists(path) && !base.isDirectory(path)
}

// `directory` + "/" + `name`, kept.
pub fn join(directory: []const u8, name: []const u8) -> []const u8 {
    if directory.length == 0 { return base.bytes(base.keep(name), name.length) }
    const length = directory.length + 1 + name.length
    const text = base.alloc(length + 1)
    base.putText(text, directory)
    base.put8(text + directory.length, 47)
    base.putText(text + directory.length + 1, name)
    return base.bytes(text, length)
}

// The directory part of `path` ("" when it has none).
pub fn directoryOf(path: []const u8) -> []const u8 {
    var stop = path.length
    while stop > 0 && path[stop - 1] != 47 { stop -= 1 }
    if stop == 0 { return path[0..0] }
    return path[0..stop - 1]
}

// The path `name` names for a file included from `from` (a path), "" when
// none is there. `after` > 0 starts the search at that directory (the
// index + 1 of the one `from` was found in: #include_next).
pub fn find(name: []const u8, quoted: bool, from: []const u8, after: usize) -> []const u8 {
    if name.length > 0 && name[0] == 47 {
        if isHeader(name) { return name }
        return name[0..0]
    }
    if quoted && after == 0 {
        const local = join(directoryOf(from), name)
        if isHeader(local) { return local }
        // (The misses of the -include files, which a snapshot's reader
        // checks again where a directory changed.)
        if recording { table.set(&localMisses, (@intCast(usize, base.intern(directoryOf(from))) << 32) | @intCast(usize, base.intern(name)), 1) }
    }
    // The search of the directories depends on the name and where it
    // starts alone, and a header is included again and again (its guard
    // keeps its text out, not the lookup): the answer is remembered. A
    // WebCore unit has 250 directories to try with a system call or two
    // each.
    const key: usize = (@intCast(usize, base.intern(name)) << 32) | after
    const slot = foundSlot(key)
    if base.getWord(slot) == key {
        const kept = base.getWord(slot + 8)
        if kept == 0 { return name[0..0] }
        return base.bytes(kept, base.getWord(slot + 16))
    }
    var index: usize = if after > 0 { after } else { 0 }
    var result = name[0..0]
    while index < dirCount {
        // (Tried in a buffer of its own; only the path found is kept.)
        const candidate = joinInto(base.nameOf(base.get32(dirs + index * 4)), name)
        if isHeader(candidate) {
            result = base.bytes(base.keep(candidate), candidate.length)
            break
        }
        index += 1
    }
    if foundCount < FOUND_SLOTS / 2 {
        base.putWord(slot, key)
        base.putWord(slot + 8, if result.length == 0 { 0 } else { @intFromPtr(result.pointer) })
        base.putWord(slot + 16, result.length)
        base.putWord(slot + 24, index)
        foundCount += 1
    }
    return result
}

// The answers of the directory search: slots of (key, the kept path's
// address or 0 for none, its length, the index of the directory it was
// found in or dirCount), open-addressed on the key (the name's id above
// the directory index); an empty slot has key 0 (no name has id 0).
const FOUND_SLOTS: usize = 65536
var found: usize = 0
var foundCount: usize = 0

// While the -include files are read: the names a quoted #include did not
// find next to the file including it, by (directory, name).
pub var recording = false
var localMisses = table.Table.{ .slots = 0, .capacity = 0, .count = 0 }

// What a snapshot keeps of the searches to check them again: the
// directories, the remembered answers (slot by slot: key 0 for an empty
// one, else the key and the index of the directory found or dirCount)
// and the local misses (keys of directory and name ids, 0 for none).
pub fn directoryCount() -> usize { return dirCount }
pub fn directoryName(index: usize) -> u32 { return base.get32(dirs + index * 4) }
pub fn answerSlots() -> usize { return if found == 0 { 0 } else { FOUND_SLOTS } }
pub fn answerKey(slot: usize) -> usize { return base.getWord(found + slot * 32) }
pub fn answerIndex(slot: usize) -> usize { return base.getWord(found + slot * 32 + 24) }
pub fn missSlots() -> usize { return localMisses.capacity }
pub fn missKey(slot: usize) -> usize {
    const held = base.getWord(localMisses.slots + slot * 16)
    return if held == 0 { 0 } else { held - 1 }
}

fn foundSlot(key: usize) -> usize {
    if found == 0 { found = base.alloc(FOUND_SLOTS * 32) }
    var index: usize = ((key >> 32) *% 2654435761 + (key & 4294967295)) & (FOUND_SLOTS - 1)
    var probes: usize = 0
    while probes < FOUND_SLOTS {
        const slot = found + index * 32
        const held = base.getWord(slot)
        if held == 0 || held == key { return slot }
        index = (index + 1) & (FOUND_SLOTS - 1)
        probes += 1
    }
    base.fatal("the include cache is full")
    return 0
}

var candidateBuffer: usize = 0
var candidateSize: usize = 0

// `directory` + "/" + `name` in the buffer of the candidates, valid until
// the next.
fn joinInto(directory: []const u8, name: []const u8) -> []const u8 {
    const length = directory.length + 1 + name.length
    if length + 1 > candidateSize {
        candidateSize = (length + 1) * 2
        candidateBuffer = base.alloc(candidateSize)
    }
    base.putText(candidateBuffer, directory)
    base.put8(candidateBuffer + directory.length, 47)
    base.putText(candidateBuffer + directory.length + 1, name)
    return base.bytes(candidateBuffer, length)
}

// Whether `path` is a C header of the system's (not of the C++
// directory): in C++ it is read as extern "C".
pub fn isSystemC(path: []const u8) -> bool {
    // The innermost directory holding the file (sys/stat.h lies under
    // include/, the C++ headers under include/c++/).
    var index: usize = 0
    var found: usize = 0
    var foundLength: usize = 0
    while index < dirCount {
        const directory = base.nameOf(base.get32(dirs + index * 4))
        if directory.length > foundLength && path.length > directory.length && path[directory.length] == 47 && base.same(path[0..directory.length], directory) {
            found = index + 1
            foundLength = directory.length
        }
        index += 1
    }
    if found == 0 || found <= systemStart { return false }
    const directory = base.nameOf(base.get32(dirs + (found - 1) * 4))
    return !(directory.length > 4 && base.same(directory[directory.length - 4..directory.length], "/c++"))
}

// The index + 1 of the directory `path` lies in, 0 when it is in none.
pub fn dirIndexOf(path: []const u8) -> usize {
    const directory = directoryOf(path)
    var index: usize = 0
    while index < dirCount {
        if base.same(base.nameOf(base.get32(dirs + index * 4)), directory) { return index + 1 }
        index += 1
    }
    return 0
}

// --- prefix snapshot state (tools/cc_snapshot_state.py writes this) ---
pub fn keepState() -> void {
    base.keepState(@intFromPtr(&dirs), @sizeOf(@typeOf(dirs)))
    base.keepState(@intFromPtr(&dirCount), @sizeOf(@typeOf(dirCount)))
    base.keepState(@intFromPtr(&systemStart), @sizeOf(@typeOf(systemStart)))
    base.keepState(@intFromPtr(&found), @sizeOf(@typeOf(found)))
    base.keepState(@intFromPtr(&foundCount), @sizeOf(@typeOf(foundCount)))
    base.keepState(@intFromPtr(&recording), @sizeOf(@typeOf(recording)))
    base.keepState(@intFromPtr(&localMisses), @sizeOf(@typeOf(localMisses)))
    base.keepState(@intFromPtr(&candidateBuffer), @sizeOf(@typeOf(candidateBuffer)))
    base.keepState(@intFromPtr(&candidateSize), @sizeOf(@typeOf(candidateSize)))
}
// --- end of prefix snapshot state ---
