// What every part of mlx-cc stands on: one arena of memory that is never
// freed (a compiler run is short), the bytes in it by address, the names
// table (every identifier, keyword and punctuator interned once, so they
// compare as numbers), the source files read whole, and the messages: an
// error says the file and the line and ends the run.
const std = @import("std")

const SYS_read: usize = 0
const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_stat: usize = 4
const SYS_fstat: usize = 5
const SYS_exit_group: usize = 231
const O_RDONLY: usize = 0
const O_CLOEXEC: usize = 524288

// The arena: 8 GiB of address space, reserved without committing it
// (MAP_NORESERVE): only what is touched counts, and fresh pages are
// zero. Its interface is a std arena's (`allocator()`, what std's
// containers in the compiler take); alloc() bumps it directly, as the
// arena's own alloc would.
//
// It lies at a fixed address (MAP_FIXED_NOREPLACE), so that the state a
// run keeps in it is valid in another run of the same compiler: a
// prefix snapshot (snapshot.mlx) is the arena's used part and the
// modules' variables after the -include files, mapped back at the same
// place. When the address is taken (or the kernel cannot be asked for
// it) the arena is anywhere and no snapshot is written or read.
const ARENA_SIZE: usize = 8589934592
pub const ARENA_BASE: usize = 52776558133248
// After the arena, the run's own memory while its command line is read
// (beginSide to endSide): the files, -o, -D and -I texts and the link's
// inputs, which a snapshot does not hold and a snapshot read must not
// overwrite. Nothing of the compilation proper is made there.
const SIDE_SIZE: usize = 1073741824
const PAGE_SIZE: usize = 4096

var arena: std.arena_allocator.Arena = undefined // (per run)
var arenaBase: usize = 0 // (per run)
pub var fixedArena = false // (per run)
var sideOffset: usize = 0 // (per run)
var onSide = false // (per run)

// The names: an open-addressed table of ids and, by id, where each name's
// bytes are.
const NAME_SLOTS: usize = 8388608
pub const MAX_NAMES: usize = 4194304

var nameSlots: usize = 0
var nameEntries: usize = 0
var nameCount: u32 = 0

// The source files, by id: their path (a name) and their bytes.
pub const MAX_FILES: usize = 65536
var fileEntries: usize = 0
var fileCount: u32 = 0

pub fn init() -> bool {
    // MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, with MAP_FIXED_NOREPLACE.
    const anywhere: usize = 16418
    const all: usize = 18446744073709551615
    var at = std.linux.syscall6(9, ARENA_BASE, ARENA_SIZE + SIDE_SIZE, 3, anywhere | 1048576, all, 0)
    if at == @bitCast(isize, ARENA_BASE) {
        fixedArena = true
    } else {
        // (A kernel before 4.17 takes the address as a hint.)
        if at >= 0 { const dropped = std.linux.syscall2(11, @bitCast(usize, at), ARENA_SIZE + SIDE_SIZE) }
        at = std.linux.syscall6(9, 0, ARENA_SIZE + SIDE_SIZE, 3, anywhere, all, 0)
        if at < 0 { return false }
    }
    arenaBase = @bitCast(usize, at)
    var memory: [*]u8 = undefined
    unsafe { memory = @ptrFromInt([*]u8, arenaBase) }
    arena = std.arena_allocator.Arena.{ .memory = memory, .capacity = ARENA_SIZE, .offset = 0, .child = std.page_allocator.init() }
    nameSlots = alloc(NAME_SLOTS * 4)
    nameEntries = alloc(MAX_NAMES * 16)
    nameCount = 1
    fileEntries = alloc(MAX_FILES * 24)
    fileCount = 1
    // (Made now, not when first used: used first while the command line
    // is read, they would be in the side memory.)
    pathBuffer = alloc(PATH_BUFFER)
    statBuffer = alloc(144)
    return true
}

// `size` bytes of zeroed memory, 16-byte aligned; its address.
pub fn alloc(size: usize) -> usize {
    if onSide { return sideAlloc(size) }
    const at = (arena.offset + 15) / 16 * 16
    if at + size > ARENA_SIZE {
        // (MLX_CC_STATS: what filled it.)
        if stats { showStats() }
        fatal("out of memory")
    }
    arena.offset = at + size
    if stats { countSize(size) }
    return arenaBase + at
}

// `size` bytes of the side memory (above).
pub fn sideAlloc(size: usize) -> usize {
    const at = (sideOffset + 15) / 16 * 16
    if at + size > SIDE_SIZE { fatal("out of memory (the command line's)") }
    sideOffset = at + size
    return arenaBase + ARENA_SIZE + at
}

// While the command line is read: alloc() takes the side memory.
pub fn beginSide() -> void { onSide = true }
pub fn endSide() -> void { onSide = false }
pub fn isSide(address: usize) -> bool { return address >= arenaBase + ARENA_SIZE && address < arenaBase + ARENA_SIZE + SIDE_SIZE }

// The arena's used bytes (a snapshot's image), and the arena continued
// from a snapshot's.
pub fn arenaUsed() -> usize { return arena.offset }
pub fn arenaStart() -> usize { return arenaBase }
pub fn continueArena(used: usize) -> void { arena.offset = used }

// The variables of the modules that a snapshot holds: (address, size)
// pairs, each module's keepState() naming its own (the variables marked
// `(per run)` aside: the arena's place, the side memory, the command
// line's options, the counts of MLX_CC_STATS).
var stateCells: usize = 0 // (per run)
var stateCount: usize = 0 // (per run)
const MAX_STATE: usize = 4096

pub fn keepState(address: usize, size: usize) -> void {
    if stateCells == 0 { stateCells = sideAlloc(MAX_STATE * 16) }
    if stateCount >= MAX_STATE { fatal("too many variables for a snapshot") }
    putWord(stateCells + stateCount * 16, address)
    putWord(stateCells + stateCount * 16 + 8, size)
    stateCount += 1
}
pub fn stateCellCount() -> usize { return stateCount }
pub fn stateCell(index: usize) -> usize { return stateCells + index * 16 }

// A hash of `length` bytes at `address` (a file's contents, the
// compiler's own): by the word, not cryptographic.
pub fn contentHash(address: usize, length: usize) -> u64 {
    var hash: u64 = 14695981039346656037 ^ @intCast(u64, length)
    var index: usize = 0
    while index + 8 <= length {
        hash = (hash ^ @intCast(u64, getWord(address + index))) *% 11400714819323198485
        hash = hash ^ (hash >> 29)
        index += 8
    }
    while index < length {
        hash = (hash ^ @intCast(u64, get8(address + index))) *% 1099511628211
        index += 1
    }
    return hash ^ (hash >> 32)
}

// The arena as an Allocator (std's containers in the compiler): freed
// blocks stay, as everything in the arena does.
pub fn allocator() -> std.allocator.Allocator { return std.arena_allocator.interface(&arena) }

// (MLX_CC_STATS: the arena's allocations by size, below 4096 bytes one
// bucket per size, above in one.)
var sizeBytes: usize = 0 // (per run)
fn countSize(size: usize) -> void {
    if sizeBytes == 0 {
        // (Its own memory, outside the counts.)
        sizeBytes = sideAlloc(4097 * 16)
    }
    const bucket = if size < 4096 { size } else { 4096 }
    putWord(sizeBytes + bucket * 16, getWord(sizeBytes + bucket * 16) + size)
    putWord(sizeBytes + bucket * 16 + 8, getWord(sizeBytes + bucket * 16 + 8) + 1)
}

// Scratch memory taken and given back in turn (a stack): the argument
// lists of calls are read into it, then kept at their size.
const SCRATCH_SIZE: usize = 16777216
var scratchBase: usize = 0
var scratchTop: usize = 0

pub fn scratchMark() -> usize { return scratchTop }

// `count` words of scratch memory, not zeroed (an argument list's room:
// 4096 arguments, WTF's enumNames<E>() making an array of 511 names, its
// zeroing cost every call).
pub fn scratchWords(count: usize) -> usize {
    if scratchBase == 0 {
        scratchBase = alloc(SCRATCH_SIZE)
        scratchTop = 0
    }
    const rounded = (count * 8 + 15) / 16 * 16
    if scratchTop + rounded > SCRATCH_SIZE { return alloc(count * 8) }
    const at = scratchBase + scratchTop
    scratchTop += rounded
    return at
}

// `size` bytes of zeroed scratch memory (arena memory when it is full).
pub fn scratch(size: usize) -> usize {
    if scratchBase == 0 {
        scratchBase = alloc(SCRATCH_SIZE)
        scratchTop = 0
    }
    const rounded = (size + 15) / 16 * 16
    if scratchTop + rounded > SCRATCH_SIZE {
        if stats { count(STAT_SCRATCH, size) }
        return alloc(size)
    }
    const at = scratchBase + scratchTop
    scratchTop += rounded
    var i: usize = 0
    while i < rounded {
        putWord(at + i, 0)
        i += 8
    }
    return at
}

pub fn releaseScratch(mark: usize) -> void { scratchTop = mark }

// MLX_CC_STATS: the arena's use by kind of thing, shown at the end.
pub var stats = false // (per run)
pub const STAT_TOKENS: usize = 0
pub const STAT_NODES: usize = 1
pub const STAT_OBJS: usize = 2
pub const STAT_TYPES: usize = 3
pub const STAT_MEMBERS: usize = 4
pub const STAT_KEEP: usize = 5
pub const STAT_JOIN: usize = 6
pub const STAT_SCRATCH: usize = 7
// (Of the tokens and nodes above: the tokens that are copies, and the
// nodes made while a function's body is read.)
pub const STAT_TOKENS_COPIED: usize = 8
pub const STAT_NODES_IN_FUNCTION: usize = 9
pub const STAT_COUNT: usize = 10
var statBytes: [10]u64 = undefined // (per run)
var statCounts: [10]u64 = undefined // (per run)
// Whether a function's body is being read (state.startFunction), for
// the counts.
pub var inFunction = false

pub fn count(kind: usize, size: usize) -> void {
    statBytes[kind] += @intCast(u64, size)
    statCounts[kind] += 1
}

pub fn showStats() -> void {
    // The process's memory: its peak, and now the private and the
    // file-backed pages (a prefix snapshot's, shared with the other runs
    // mapping it, until written).
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr("/proc/self/status"), O_RDONLY | O_CLOEXEC, 0)
    if descriptor >= 0 {
        const buffer = sideAlloc(8192)
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), buffer, 8191)
        const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
        var start: usize = 0
        var index: usize = 0
        const length = if count > 0 { @intCast(usize, count) } else { 0 }
        while index < length {
            if get8(buffer + index) == 10 {
                const line = bytes(buffer + start, index + 1 - start)
                if startsWith(line, "VmHWM") || startsWith(line, "RssAnon") || startsWith(line, "RssFile") { say(line) }
                start = index + 1
            }
            index += 1
        }
    }
    say("arena bytes: ")
    sayNumber(@intCast(u64, arena.offset))
    say("\n")
    say("names: ")
    sayNumber(@intCast(u64, nameCount))
    say("\n")
    // The ten sizes with the most bytes.
    if sizeBytes != 0 {
        var shown: usize = 0
        var last: usize = 0
        var limit: usize = 18446744073709551615
        while shown < 12 {
            var best: usize = 4097
            var bestBytes: usize = 0
            var bucket: usize = 0
            while bucket <= 4096 {
                const b = getWord(sizeBytes + bucket * 16)
                if b > bestBytes && (b < limit || (b == limit && bucket > last)) {
                    best = bucket
                    bestBytes = b
                }
                bucket += 1
            }
            if best == 4097 { break }
            say("  size ")
            sayNumber(@intCast(u64, best))
            say(": ")
            sayNumber(@intCast(u64, getWord(sizeBytes + best * 16 + 8)))
            say(" allocations, ")
            sayNumber(@intCast(u64, bestBytes))
            say(" bytes\n")
            limit = bestBytes
            last = best
            shown += 1
        }
    }
    var kind: usize = 0
    while kind < STAT_COUNT {
        say(if kind == 0 { "tokens " } else if kind == 1 { "nodes " } else if kind == 2 { "objs " } else if kind == 3 { "types " } else if kind == 4 { "members " } else if kind == 5 { "kept " } else if kind == 6 { "joined " } else if kind == 7 { "scratch overflow " } else if kind == 8 { "  tokens copied " } else { "  nodes in function bodies " })
        sayNumber(statCounts[kind])
        say(" ")
        sayNumber(statBytes[kind])
        say("\n")
        kind += 1
    }
}

// The `count` words at `words` kept in the arena.
pub fn keptWords(words: usize, count: usize) -> usize {
    const kept = alloc(count * 8 + 8)
    copy(kept, words, count * 8)
    return kept
}

// ---------------------------------------------------------------------------
// Bytes by address

pub inline fn get8(address: usize) -> u8 {
    unsafe { return @ptrFromInt(*u8, address).* }
}

pub inline fn put8(address: usize, value: u8) -> void {
    unsafe { @ptrFromInt(*u8, address).* = value }
}

pub inline fn get32(address: usize) -> u32 {
    unsafe { return @ptrFromInt(*u32, address).* }
}

pub inline fn put32(address: usize, value: u32) -> void {
    unsafe { @ptrFromInt(*u32, address).* = value }
}

pub inline fn get64(address: usize) -> u64 {
    unsafe { return @ptrFromInt(*u64, address).* }
}

pub inline fn put64(address: usize, value: u64) -> void {
    unsafe { @ptrFromInt(*u64, address).* = value }
}

// A word that holds an address or a size.
pub inline fn getWord(address: usize) -> usize {
    unsafe { return @ptrFromInt(*usize, address).* }
}

pub inline fn putWord(address: usize, value: usize) -> void {
    unsafe { @ptrFromInt(*usize, address).* = value }
}

pub fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

pub inline fn pointer(address: usize) -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, address) }
}

// (A word at a time, then the rest: the cells copied are 16-byte
// aligned and the texts short; a loop of put8 calls was the hot spot.)
pub fn copy(target: usize, source: usize, length: usize) -> void {
    var index: usize = 0
    while index + 8 <= length {
        putWord(target + index, getWord(source + index))
        index += 8
    }
    while index < length {
        put8(target + index, get8(source + index))
        index += 1
    }
}

// Whether `text` begins with `prefix`.
pub fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    if text.length < prefix.length { return false }
    var index: usize = 0
    while index < prefix.length {
        if text[index] != prefix[index] { return false }
        index += 1
    }
    return true
}

pub fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

// Writes `text` at `address`. (By the word, as `copy`: every kept
// text, built name and instance key passes through here, 15% of a
// WebCore unit's time as a loop over the bytes.)
pub fn putText(address: usize, text: []const u8) -> void {
    copy(address, @intFromPtr(text.pointer), text.length)
}

// A copy of `text` in the arena with a NUL after it; its address.
pub fn keep(text: []const u8) -> usize {
    const at = alloc(text.length + 1)
    if stats { count(STAT_KEEP, text.length + 1) }
    putText(at, text)
    return at
}

// `first` followed by `second`, kept in the arena (messages).
pub fn join(first: []const u8, second: []const u8) -> []const u8 {
    const at = alloc(first.length + second.length + 1)
    if stats { count(STAT_JOIN, first.length + second.length + 1) }
    putText(at, first)
    putText(at + first.length, second)
    return bytes(at, first.length + second.length)
}

// The decimal digits of `value`, kept in the arena.
// Texts made piece by piece (mangled names, template instances' keys):
// a stack of bytes of its own, so that a text only interned or copied
// out costs no arena memory (joins would keep every partial text).
const BUILD_SIZE: usize = 268435456
var buildBase: usize = 0
var buildTop: usize = 0

pub fn buildMark() -> usize {
    if buildBase == 0 { buildBase = alloc(BUILD_SIZE) }
    return buildTop
}

pub fn append(text: []const u8) -> void {
    if buildTop + text.length > BUILD_SIZE { fatal("a name is too long") }
    putText(buildBase + buildTop, text)
    buildTop += text.length
}

pub fn appendDecimal(value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    append(view[24 - count..24])
}

// The text appended since `mark` (valid until the stack moves back).
pub fn built(mark: usize) -> []const u8 { return bytes(buildBase + mark, buildTop - mark) }

// The text appended since `mark` interned, the stack back at `mark`.
pub fn internBuilt(mark: usize) -> u32 {
    const id = intern(built(mark))
    buildTop = mark
    return id
}

// The text appended since `mark` copied to the arena, the stack back at
// `mark`.
pub fn keepBuilt(mark: usize) -> []const u8 {
    const text = built(mark)
    const at = keep(text)
    buildTop = mark
    return bytes(at, text.length)
}

pub fn decimal(value: u64) -> []const u8 {
    const at = alloc(24)
    var count: usize = 0
    var rest = value
    while true {
        put8(at + 23 - count, @intCast(u8, 48 + rest % 10))
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    return bytes(at + 24 - count, count)
}

// The length of the NUL-ended text at `address`.
pub fn cLength(address: usize) -> usize {
    var length: usize = 0
    while get8(address + length) != 0 { length += 1 }
    return length
}

// ---------------------------------------------------------------------------
// Names

fn hashOf(text: []const u8) -> u32 {
    var hash: u64 = 2166136261
    var index: usize = 0
    while index < text.length {
        hash = ((hash ^ @intCast(u64, text[index])) * 16777619) & 4294967295
        index += 1
    }
    return @intCast(u32, hash)
}

fn entryAddress(id: u32) -> usize { return nameEntries + @intCast(usize, id) * 16 }

// The hash going on from `hash` over `text` (hashOf's, so that a name's
// hash continues into the hash of a longer name it starts).
fn hashOn(hash: u64, text: []const u8) -> u64 {
    var h = hash
    var index: usize = 0
    while index < text.length {
        h = ((h ^ @intCast(u64, text[index])) * 16777619) & 4294967295
        index += 1
    }
    return h
}

// The id of the name `first::last`, 0 when there is none: found without
// making it, so that what a lookup misses makes no name. Each answer is
// remembered by the pair (a lookup from a nested prefix asks every prefix
// around and every namespace a using-directive names, almost all of
// which miss; hashing the joined text for each was a tenth of a unit's
// time). A miss is remembered only when `last` has no "::" of its own:
// then the name, if it is ever made, splits into the pair at its last
// "::", which is where `intern` corrects what was remembered.
pub fn findJoined(first: u32, last: u32) -> u32 {
    const at = joinedEntry(first, last)
    if get32(at) != 0 { return get32(at + 8) }
    const found = probeJoined(first, last)
    if found != 0 || !hasScope(nameOf(last)) { rememberJoined(first, last, found) }
    return found
}

// The id of the name `first::last` as the table holds it, 0 for none
// (the hash goes on from `first`'s).
fn probeJoined(first: u32, last: u32) -> u32 {
    const firstText = nameOf(first)
    const lastText = nameOf(last)
    const hash = joinedHash(first, lastText)
    const total = firstText.length + 2 + lastText.length
    var nameSlot = @intCast(usize, hash) & (NAME_SLOTS - 1)
    while true {
        const id = get32(nameSlots + nameSlot * 4)
        if id == 0 { return 0 }
        const entry = entryAddress(id)
        if get32(entry + 12) == hash && @intCast(usize, get32(entry + 8)) == total {
            const text = bytes(getWord(entry), total)
            const middleEnd = firstText.length + 2
            if same(text[0..firstText.length], firstText) && same(text[firstText.length..middleEnd], "::") && same(text[middleEnd..total], lastText) { return id }
        }
        nameSlot = (nameSlot + 1) & (NAME_SLOTS - 1)
    }
    return 0
}

fn joinedHash(first: u32, lastText: []const u8) -> u32 {
    return @intCast(u32, hashOn(hashOn(@intCast(u64, get32(entryAddress(first) + 12)), "::"), lastText))
}

// Whether `text` has a "::" in it (a qualified name).
pub fn hasScope(text: []const u8) -> bool {
    var i: usize = 1
    while i < text.length {
        if text[i] == 58 && text[i - 1] == 58 { return true }
        i += 1
    }
    return false
}

// The id of the name `first::last`, made when there is none (what
// scope.qualify asks: most names declared in a WebCore unit are made so,
// and hashing the joined text whole, then scanning it for the pairs it
// splits into, was a fifth of the unit's time).
pub fn internJoined(first: u32, last: u32) -> u32 {
    const at = joinedEntry(first, last)
    if get32(at) != 0 && get32(at + 8) != 0 { return get32(at + 8) }
    const known = probeJoined(first, last)
    if known != 0 {
        rememberJoined(first, last, known)
        return known
    }
    const firstText = nameOf(first)
    const lastText = nameOf(last)
    const hash = joinedHash(first, lastText)
    const total = firstText.length + 2 + lastText.length
    const text = alloc(total + 1)
    if stats { count(STAT_KEEP, total + 1) }
    putText(text, firstText)
    put8(text + firstText.length, 58)
    put8(text + firstText.length + 1, 58)
    putText(text + firstText.length + 2, lastText)
    const id = addName(text, total, hash)
    // (The pair itself; and when `last` has a "::", the name's last
    // split is another pair, which may have been asked.)
    rememberJoined(first, last, id)
    if hasScope(lastText) { noteJoined(bytes(text, total), id) }
    return id
}

// The name `text` (kept at that address) made with `hash`: its id.
fn addName(text: usize, length: usize, hash: u32) -> u32 {
    var slot = @intCast(usize, hash) & (NAME_SLOTS - 1)
    while get32(nameSlots + slot * 4) != 0 { slot = (slot + 1) & (NAME_SLOTS - 1) }
    if @intCast(usize, nameCount) >= MAX_NAMES { fatal("too many names") }
    const id = nameCount
    nameCount += 1
    const entry = entryAddress(id)
    putWord(entry, text)
    put32(entry + 8, @intCast(u32, length))
    put32(entry + 12, hash)
    put32(nameSlots + slot * 4, id)
    return id
}

// The pairs asked of findJoined and their answers: an open-addressed
// table of (first, last, id), doubled when half full.
var joinedSlots: usize = 0
var joinedCapacity: usize = 0
var joinedCount: usize = 0

// The pair's entry: its own, or the empty one it would take.
fn joinedEntry(first: u32, last: u32) -> usize {
    if joinedSlots == 0 { growJoined() }
    const pair = (@intCast(u64, first) << 32) | @intCast(u64, last)
    var slot = @intCast(usize, (pair *% 11400714819323198485) >> 24) & (joinedCapacity - 1)
    while true {
        const at = joinedSlots + slot * 12
        const held = get32(at)
        if held == 0 || (held == first && get32(at + 4) == last) { return at }
        slot = (slot + 1) & (joinedCapacity - 1)
    }
    return 0
}

fn rememberJoined(first: u32, last: u32, id: u32) -> void {
    if joinedSlots == 0 || joinedCount * 2 >= joinedCapacity { growJoined() }
    const at = joinedEntry(first, last)
    if get32(at) == 0 { joinedCount += 1 }
    put32(at, first)
    put32(at + 4, last)
    put32(at + 8, id)
}

fn growJoined() -> void {
    const oldSlots = joinedSlots
    const oldCapacity = joinedCapacity
    joinedCapacity = if oldCapacity == 0 { 1048576 } else { oldCapacity * 2 }
    joinedSlots = alloc(joinedCapacity * 12)
    joinedCount = 0
    var i: usize = 0
    while i < oldCapacity {
        const at = oldSlots + i * 12
        if get32(at) != 0 { rememberJoined(get32(at), get32(at + 4), get32(at + 8)) }
        i += 1
    }
}

// A name made with "::" in it: split at its last "::", when both halves
// are names, it is a pair findJoined may have remembered as missing.
fn noteJoined(text: []const u8, id: u32) -> void {
    var i = text.length
    while i > 2 {
        i -= 1
        if text[i] == 58 && text[i - 1] == 58 {
            if i + 1 >= text.length { return }
            const first = find(text[0..i - 1])
            if first == 0 { return }
            const last = find(text[i + 1..text.length])
            if last != 0 { rememberJoined(first, last, id) }
            return
        }
    }
}

// The id of `text`, 0 when it is no name yet.
pub fn find(text: []const u8) -> u32 {
    const hash = hashOf(text)
    var slot = @intCast(usize, hash) & (NAME_SLOTS - 1)
    while true {
        const found = get32(nameSlots + slot * 4)
        if found == 0 { return 0 }
        const at = entryAddress(found)
        if get32(at + 12) == hash && same(bytes(getWord(at), @intCast(usize, get32(at + 8))), text) { return found }
        slot = (slot + 1) & (NAME_SLOTS - 1)
    }
    return 0
}

// The id of `text`, interned on first sight (the text is kept).
pub fn intern(text: []const u8) -> u32 {
    const hash = hashOf(text)
    var slot = @intCast(usize, hash) & (NAME_SLOTS - 1)
    while true {
        const found = get32(nameSlots + slot * 4)
        if found == 0 { break }
        const at = entryAddress(found)
        if get32(at + 12) == hash && same(bytes(getWord(at), @intCast(usize, get32(at + 8))), text) { return found }
        slot = (slot + 1) & (NAME_SLOTS - 1)
    }
    if @intCast(usize, nameCount) >= MAX_NAMES { fatal("too many names") }
    const id = nameCount
    nameCount += 1
    const entry = entryAddress(id)
    putWord(entry, keep(text))
    put32(entry + 8, @intCast(u32, text.length))
    put32(entry + 12, hash)
    put32(nameSlots + slot * 4, id)
    noteJoined(text, id)
    return id
}

pub fn nameOf(id: u32) -> []const u8 {
    const entry = entryAddress(id)
    return bytes(getWord(entry), @intCast(usize, get32(entry + 8)))
}

// The name's NUL-ended text (for the object writer).
pub fn nameAddress(id: u32) -> usize { return getWord(entryAddress(id)) }

pub fn names() -> u32 { return nameCount }

// ---------------------------------------------------------------------------
// Files

fn fileAddress(id: u32) -> usize { return fileEntries + @intCast(usize, id) * 24 }

pub fn fileName(id: u32) -> u32 { return get32(fileAddress(id)) }
pub fn fileData(id: u32) -> usize { return getWord(fileAddress(id) + 8) }
pub fn fileLength(id: u32) -> usize { return getWord(fileAddress(id) + 16) }
pub fn files() -> u32 { return fileCount }

// A path as the system calls take it (NUL-ended), in a buffer of its
// own that the next call reuses; a copy kept in the arena when it is too
// long for it. (Every #include looks for its file in each of hundreds of
// directories: a copy per attempt was 270 MB of a WebCore unit.)
const PATH_BUFFER: usize = 4096
var pathBuffer: usize = 0

pub fn cPath(path: []const u8) -> usize {
    if path.length >= PATH_BUFFER { return keep(path) }
    if pathBuffer == 0 { pathBuffer = alloc(PATH_BUFFER) }
    putText(pathBuffer, path)
    put8(pathBuffer + path.length, 0)
    return pathBuffer
}

// stat(2)'s result, in a buffer reused likewise; false when there is none.
var statBuffer: usize = 0

fn statOf(path: []const u8) -> bool {
    if statBuffer == 0 { statBuffer = alloc(144) }
    return std.linux.syscall2(SYS_stat, cPath(path), statBuffer) >= 0
}

// The file `path` names, as its device and inode (0 when there is
// none): one file however its path is spelled.
pub fn fileIdentity(path: []const u8) -> u64 {
    if !statOf(path) { return 0 }
    return (@intCast(u64, getWord(statBuffer)) << 32) ^ @intCast(u64, getWord(statBuffer + 8))
}

// Whether `path` names a directory.
pub fn isDirectory(path: []const u8) -> bool {
    if !statOf(path) { return false }
    return (get32(statBuffer + 24) & 61440) == 16384
}

// Reads the file at `path` whole; its id, 0 when it cannot be read. A NUL
// follows its bytes. (Its memory is its size, from fstat: a header read
// again for each #include of it took 64 KB however small it was.)
pub fn readFile(path: []const u8) -> u32 {
    if @intCast(usize, fileCount) >= MAX_FILES { fatal("too many files") }
    const descriptor = std.linux.syscall3(SYS_open, cPath(path), O_RDONLY | O_CLOEXEC, 0)
    if descriptor < 0 { return 0 }
    if statBuffer == 0 { statBuffer = alloc(144) }
    var capacity: usize = 65536
    if std.linux.syscall2(SYS_fstat, @bitCast(usize, descriptor), statBuffer) >= 0 && (get32(statBuffer + 24) & 61440) == 32768 {
        // (A byte more than its size: the read that sees the end needs
        // no larger buffer.)
        capacity = getWord(statBuffer + 48) + 1
    }
    var data = alloc(capacity + 1)
    var length: usize = 0
    while true {
        if length == capacity {
            const larger = alloc(capacity * 2 + 1)
            copy(larger, data, length)
            data = larger
            capacity = capacity * 2
        }
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), data + length, capacity - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    put8(data + length, 0)
    const id = fileCount
    fileCount += 1
    put32(fileAddress(id), intern(path))
    putWord(fileAddress(id) + 8, data)
    putWord(fileAddress(id) + 16, length)
    return id
}

// A file made of `text` (the predefined macros, the command line's -D).
pub fn textFile(name: []const u8, text: []const u8) -> u32 {
    const id = fileCount
    fileCount += 1
    put32(fileAddress(id), intern(name))
    putWord(fileAddress(id) + 8, keep(text))
    putWord(fileAddress(id) + 16, text.length)
    return id
}

// ---------------------------------------------------------------------------
// Messages

pub fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

pub fn sayNumber(value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    say(view[24 - count..24])
}

pub fn exit(status: usize) -> void {
    const ignored = std.linux.syscall1(SYS_exit_group, status)
}

pub fn fatal(message: []const u8) -> void {
    say("mlx-cc: ")
    say(message)
    say("\n")
    exit(1)
}

// "file:line: error: message" and the end of the run (with the
// template instances being read, innermost first).
pub fn errorAt(file: u32, line: u32, message: []const u8) -> void {
    if file != 0 { say(nameOf(fileName(file))) } else { say("mlx-cc") }
    say(":")
    sayNumber(@intCast(u64, line))
    say(": error: ")
    say(message)
    say("\n")
    // (More than 16: the innermost 10 and the outermost 6, where the
    // chain began, the others counted.)
    var index = traceTop
    var shown: usize = 0
    while index > 0 && shown < 16 {
        index -= 1
        if traceTop > 16 && shown == 10 {
            say("  note: ... ")
            sayNumber(@intCast(u64, traceTop - 16))
            say(" more instances ...\n")
            index = 5
        }
        const entry = traceStack + index * 16
        const at_ = getWord(entry)
        const name = @intCast(u32, getWord(entry + 8))
        say("  note: in ")
        if name != 0 { say(nameOf(name)) } else { say("a template instance") }
        say(", needed at ")
        const traceFile = @intCast(u32, at_ >> 32)
        if traceFile != 0 { say(nameOf(fileName(traceFile))) } else { say("mlx-cc") }
        say(":")
        sayNumber(at_ & 0xffffffff)
        say("\n")
        shown += 1
    }
    exit(1)
}

// The template instances being read (C++): entries of (file << 32 |
// line where needed, name), for the notes after an error.
var traceStack: usize = 0
var traceTop: usize = 0
const MAX_TRACE: usize = 4096
pub fn pushTrace(file: u32, line: u32) -> void {
    if traceStack == 0 { traceStack = alloc(MAX_TRACE * 16) }
    if traceTop >= MAX_TRACE { return }
    putWord(traceStack + traceTop * 16, (@intCast(u64, file) << 32) | @intCast(u64, line))
    putWord(traceStack + traceTop * 16 + 8, 0)
    traceTop += 1
}
pub fn nameTrace(name: u32) -> void {
    if traceTop > 0 && traceTop <= MAX_TRACE { putWord(traceStack + (traceTop - 1) * 16 + 8, @intCast(u64, name)) }
}
pub fn popTrace() -> void { if traceTop > 0 { traceTop -= 1 } }

pub fn warnAt(file: u32, line: u32, message: []const u8) -> void {
    if recordWarnings {
        // (Kept as one text, said again by a run that reads the snapshot.)
        var text = join(if file != 0 { nameOf(fileName(file)) } else { "mlx-cc" }, ":")
        text = join(join(join(text, decimal(@intCast(u64, line))), ": warning: "), message)
        text = join(text, "\n")
        const cell = alloc(24)
        putWord(cell, @intFromPtr(text.pointer))
        putWord(cell + 8, text.length)
        putWord(cell + 16, warnings)
        warnings = cell
        say(text)
        return
    }
    if file != 0 { say(nameOf(fileName(file))) } else { say("mlx-cc") }
    say(":")
    sayNumber(@intCast(u64, line))
    say(": warning: ")
    say(message)
    say("\n")
}

// The warnings of the -include files (while recordWarnings): cells of
// (text, length, next), the last first.
pub var recordWarnings = false
pub var warnings: usize = 0

// They said again, in their order (a snapshot read).
pub fn sayWarnings() -> void {
    var reversed: usize = 0
    var cell = warnings
    while cell != 0 {
        const c = sideAlloc(16)
        putWord(c, cell)
        putWord(c + 8, reversed)
        reversed = c
        cell = getWord(cell + 16)
    }
    while reversed != 0 {
        const at = getWord(reversed)
        say(bytes(getWord(at), getWord(at + 8)))
        reversed = getWord(reversed + 8)
    }
}

// --- prefix snapshot state (tools/cc_snapshot_state.py writes this) ---
pub fn keepBaseState() -> void {
    keepState(@intFromPtr(&nameSlots), @sizeOf(@typeOf(nameSlots)))
    keepState(@intFromPtr(&nameEntries), @sizeOf(@typeOf(nameEntries)))
    keepState(@intFromPtr(&nameCount), @sizeOf(@typeOf(nameCount)))
    keepState(@intFromPtr(&fileEntries), @sizeOf(@typeOf(fileEntries)))
    keepState(@intFromPtr(&fileCount), @sizeOf(@typeOf(fileCount)))
    keepState(@intFromPtr(&scratchBase), @sizeOf(@typeOf(scratchBase)))
    keepState(@intFromPtr(&scratchTop), @sizeOf(@typeOf(scratchTop)))
    keepState(@intFromPtr(&inFunction), @sizeOf(@typeOf(inFunction)))
    keepState(@intFromPtr(&buildBase), @sizeOf(@typeOf(buildBase)))
    keepState(@intFromPtr(&buildTop), @sizeOf(@typeOf(buildTop)))
    keepState(@intFromPtr(&joinedSlots), @sizeOf(@typeOf(joinedSlots)))
    keepState(@intFromPtr(&joinedCapacity), @sizeOf(@typeOf(joinedCapacity)))
    keepState(@intFromPtr(&joinedCount), @sizeOf(@typeOf(joinedCount)))
    keepState(@intFromPtr(&pathBuffer), @sizeOf(@typeOf(pathBuffer)))
    keepState(@intFromPtr(&statBuffer), @sizeOf(@typeOf(statBuffer)))
    keepState(@intFromPtr(&traceStack), @sizeOf(@typeOf(traceStack)))
    keepState(@intFromPtr(&traceTop), @sizeOf(@typeOf(traceTop)))
    keepState(@intFromPtr(&recordWarnings), @sizeOf(@typeOf(recordWarnings)))
    keepState(@intFromPtr(&warnings), @sizeOf(@typeOf(warnings)))
}
// --- end of prefix snapshot state ---
