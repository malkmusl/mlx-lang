// What every part of mlx-cc stands on: one arena of memory that is never
// freed (a compiler run is short), the bytes in it by address, the names
// table (every identifier, keyword and punctuator interned once, so they
// compare as numbers), the source files read whole, and the messages: an
// error says the file and the line and ends the run.
const std = @import("std")

const SYS_read: usize = 0
const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_stat: usize = 4
const SYS_mmap: usize = 9
const SYS_exit_group: usize = 231
const O_RDONLY: usize = 0
const O_CLOEXEC: usize = 524288

// The arena: 8 GiB of address space, reserved without committing it
// (MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE): only what is touched
// counts, and fresh pages are zero.
const ARENA_SIZE: usize = 8589934592

var arenaNext: usize = 0
var arenaEnd: usize = 0

// The names: an open-addressed table of ids and, by id, where each name's
// bytes are.
const NAME_SLOTS: usize = 8388608
pub const MAX_NAMES: usize = 4194304

var nameSlots: usize = 0
var nameEntries: usize = 0
var nameCount: u32 = 0

// The source files, by id: their path (a name) and their bytes.
pub const MAX_FILES: usize = 65536
var fileEntries: usize = 0
var fileCount: u32 = 0

pub fn init() -> bool {
    const base = std.linux.syscall6(SYS_mmap, 0, ARENA_SIZE, 3, 16418, @bitCast(usize, @intCast(isize, -1)), 0)
    if base < 0 { return false }
    arenaNext = @bitCast(usize, base)
    arenaEnd = arenaNext + ARENA_SIZE
    nameSlots = alloc(NAME_SLOTS * 4)
    nameEntries = alloc(MAX_NAMES * 16)
    nameCount = 1
    fileEntries = alloc(MAX_FILES * 24)
    fileCount = 1
    return true
}

// `size` bytes of zeroed memory, 16-byte aligned; its address.
pub fn alloc(size: usize) -> usize {
    const at = (arenaNext + 15) / 16 * 16
    if at + size > arenaEnd { fatal("out of memory") }
    arenaNext = at + size
    if stats { countSize(size) }
    return at
}

// (MLX_CC_STATS: the arena's allocations by size, below 4096 bytes one
// bucket per size, above in one.)
var sizeBytes: usize = 0
fn countSize(size: usize) -> void {
    if sizeBytes == 0 {
        // (Its own memory, outside the counts.)
        stats = false
        sizeBytes = alloc(4097 * 16)
        stats = true
    }
    const bucket = if size < 4096 { size } else { 4096 }
    putWord(sizeBytes + bucket * 16, getWord(sizeBytes + bucket * 16) + size)
    putWord(sizeBytes + bucket * 16 + 8, getWord(sizeBytes + bucket * 16 + 8) + 1)
}

// Scratch memory taken and given back in turn (a stack): the argument
// lists of calls are read into it, then kept at their size.
const SCRATCH_SIZE: usize = 16777216
var scratchBase: usize = 0
var scratchTop: usize = 0

pub fn scratchMark() -> usize { return scratchTop }

// `size` bytes of zeroed scratch memory (arena memory when it is full).
pub fn scratch(size: usize) -> usize {
    if scratchBase == 0 {
        scratchBase = alloc(SCRATCH_SIZE)
        scratchTop = 0
    }
    const rounded = (size + 15) / 16 * 16
    if scratchTop + rounded > SCRATCH_SIZE {
        if stats { count(STAT_SCRATCH, size) }
        return alloc(size)
    }
    const at = scratchBase + scratchTop
    scratchTop += rounded
    var i: usize = 0
    while i < rounded {
        putWord(at + i, 0)
        i += 8
    }
    return at
}

pub fn releaseScratch(mark: usize) -> void { scratchTop = mark }

// MLX_CC_STATS: the arena's use by kind of thing, shown at the end.
pub var stats = false
pub const STAT_TOKENS: usize = 0
pub const STAT_NODES: usize = 1
pub const STAT_OBJS: usize = 2
pub const STAT_TYPES: usize = 3
pub const STAT_MEMBERS: usize = 4
pub const STAT_KEEP: usize = 5
pub const STAT_JOIN: usize = 6
pub const STAT_SCRATCH: usize = 7
var statBytes: [8]u64 = undefined
var statCounts: [8]u64 = undefined

pub fn count(kind: usize, size: usize) -> void {
    statBytes[kind] += @intCast(u64, size)
    statCounts[kind] += 1
}

pub fn showStats() -> void {
    say("arena bytes: ")
    sayNumber(@intCast(u64, arenaNext - (arenaEnd - ARENA_SIZE)))
    say("\n")
    // The ten sizes with the most bytes.
    if sizeBytes != 0 {
        var shown: usize = 0
        var last: usize = 0
        var limit: usize = 18446744073709551615
        while shown < 12 {
            var best: usize = 4097
            var bestBytes: usize = 0
            var bucket: usize = 0
            while bucket <= 4096 {
                const b = getWord(sizeBytes + bucket * 16)
                if b > bestBytes && (b < limit || (b == limit && bucket > last)) {
                    best = bucket
                    bestBytes = b
                }
                bucket += 1
            }
            if best == 4097 { break }
            say("  size ")
            sayNumber(@intCast(u64, best))
            say(": ")
            sayNumber(@intCast(u64, getWord(sizeBytes + best * 16 + 8)))
            say(" allocations, ")
            sayNumber(@intCast(u64, bestBytes))
            say(" bytes\n")
            limit = bestBytes
            last = best
            shown += 1
        }
    }
    var kind: usize = 0
    while kind < 8 {
        say(if kind == 0 { "tokens " } else if kind == 1 { "nodes " } else if kind == 2 { "objs " } else if kind == 3 { "types " } else if kind == 4 { "members " } else if kind == 5 { "kept " } else if kind == 6 { "joined " } else { "scratch overflow " })
        sayNumber(statCounts[kind])
        say(" ")
        sayNumber(statBytes[kind])
        say("\n")
        kind += 1
    }
}

// The `count` words at `words` kept in the arena.
pub fn keptWords(words: usize, count: usize) -> usize {
    const kept = alloc(count * 8 + 8)
    copy(kept, words, count * 8)
    return kept
}

// ---------------------------------------------------------------------------
// Bytes by address

pub fn get8(address: usize) -> u8 {
    unsafe { return @ptrFromInt(*u8, address).* }
}

pub fn put8(address: usize, value: u8) -> void {
    unsafe { @ptrFromInt(*u8, address).* = value }
}

pub fn get32(address: usize) -> u32 {
    unsafe { return @ptrFromInt(*u32, address).* }
}

pub fn put32(address: usize, value: u32) -> void {
    unsafe { @ptrFromInt(*u32, address).* = value }
}

pub fn get64(address: usize) -> u64 {
    unsafe { return @ptrFromInt(*u64, address).* }
}

pub fn put64(address: usize, value: u64) -> void {
    unsafe { @ptrFromInt(*u64, address).* = value }
}

// A word that holds an address or a size.
pub fn getWord(address: usize) -> usize {
    unsafe { return @ptrFromInt(*usize, address).* }
}

pub fn putWord(address: usize, value: usize) -> void {
    unsafe { @ptrFromInt(*usize, address).* = value }
}

pub fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

pub fn pointer(address: usize) -> [*]const u8 {
    unsafe { return @ptrFromInt([*]const u8, address) }
}

pub fn copy(target: usize, source: usize, length: usize) -> void {
    var index: usize = 0
    while index < length {
        put8(target + index, get8(source + index))
        index += 1
    }
}

// Whether `text` begins with `prefix`.
pub fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    if text.length < prefix.length { return false }
    var index: usize = 0
    while index < prefix.length {
        if text[index] != prefix[index] { return false }
        index += 1
    }
    return true
}

pub fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

// Writes `text` at `address`.
pub fn putText(address: usize, text: []const u8) -> void {
    var index: usize = 0
    while index < text.length {
        put8(address + index, text[index])
        index += 1
    }
}

// A copy of `text` in the arena with a NUL after it; its address.
pub fn keep(text: []const u8) -> usize {
    const at = alloc(text.length + 1)
    if stats { count(STAT_KEEP, text.length + 1) }
    var index: usize = 0
    while index < text.length {
        put8(at + index, text[index])
        index += 1
    }
    return at
}

// `first` followed by `second`, kept in the arena (messages).
pub fn join(first: []const u8, second: []const u8) -> []const u8 {
    const at = alloc(first.length + second.length + 1)
    if stats { count(STAT_JOIN, first.length + second.length + 1) }
    putText(at, first)
    putText(at + first.length, second)
    return bytes(at, first.length + second.length)
}

// The decimal digits of `value`, kept in the arena.
// Texts made piece by piece (mangled names, template instances' keys):
// a stack of bytes of its own, so that a text only interned or copied
// out costs no arena memory (joins would keep every partial text).
const BUILD_SIZE: usize = 268435456
var buildBase: usize = 0
var buildTop: usize = 0

pub fn buildMark() -> usize {
    if buildBase == 0 { buildBase = alloc(BUILD_SIZE) }
    return buildTop
}

pub fn append(text: []const u8) -> void {
    if buildTop + text.length > BUILD_SIZE { fatal("a name is too long") }
    putText(buildBase + buildTop, text)
    buildTop += text.length
}

pub fn appendDecimal(value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    append(view[24 - count..24])
}

// The text appended since `mark` (valid until the stack moves back).
pub fn built(mark: usize) -> []const u8 { return bytes(buildBase + mark, buildTop - mark) }

// The text appended since `mark` interned, the stack back at `mark`.
pub fn internBuilt(mark: usize) -> u32 {
    const id = intern(built(mark))
    buildTop = mark
    return id
}

// The text appended since `mark` copied to the arena, the stack back at
// `mark`.
pub fn keepBuilt(mark: usize) -> []const u8 {
    const text = built(mark)
    const at = keep(text)
    buildTop = mark
    return bytes(at, text.length)
}

pub fn decimal(value: u64) -> []const u8 {
    const at = alloc(24)
    var count: usize = 0
    var rest = value
    while true {
        put8(at + 23 - count, @intCast(u8, 48 + rest % 10))
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    return bytes(at + 24 - count, count)
}

// The length of the NUL-ended text at `address`.
pub fn cLength(address: usize) -> usize {
    var length: usize = 0
    while get8(address + length) != 0 { length += 1 }
    return length
}

// ---------------------------------------------------------------------------
// Names

fn hashOf(text: []const u8) -> u32 {
    var hash: u64 = 2166136261
    var index: usize = 0
    while index < text.length {
        hash = ((hash ^ @intCast(u64, text[index])) * 16777619) & 4294967295
        index += 1
    }
    return @intCast(u32, hash)
}

fn entryAddress(id: u32) -> usize { return nameEntries + @intCast(usize, id) * 16 }

// The id of `text`, interned on first sight (the text is kept).
pub fn intern(text: []const u8) -> u32 {
    const hash = hashOf(text)
    var slot = @intCast(usize, hash) & (NAME_SLOTS - 1)
    while true {
        const found = get32(nameSlots + slot * 4)
        if found == 0 { break }
        const at = entryAddress(found)
        if get32(at + 12) == hash && same(bytes(getWord(at), @intCast(usize, get32(at + 8))), text) { return found }
        slot = (slot + 1) & (NAME_SLOTS - 1)
    }
    if @intCast(usize, nameCount) >= MAX_NAMES { fatal("too many names") }
    const id = nameCount
    nameCount += 1
    const entry = entryAddress(id)
    putWord(entry, keep(text))
    put32(entry + 8, @intCast(u32, text.length))
    put32(entry + 12, hash)
    put32(nameSlots + slot * 4, id)
    return id
}

pub fn nameOf(id: u32) -> []const u8 {
    const entry = entryAddress(id)
    return bytes(getWord(entry), @intCast(usize, get32(entry + 8)))
}

// The name's NUL-ended text (for the object writer).
pub fn nameAddress(id: u32) -> usize { return getWord(entryAddress(id)) }

pub fn names() -> u32 { return nameCount }

// ---------------------------------------------------------------------------
// Files

fn fileAddress(id: u32) -> usize { return fileEntries + @intCast(usize, id) * 24 }

pub fn fileName(id: u32) -> u32 { return get32(fileAddress(id)) }
pub fn fileData(id: u32) -> usize { return getWord(fileAddress(id) + 8) }
pub fn fileLength(id: u32) -> usize { return getWord(fileAddress(id) + 16) }

// Reads the file at `path` whole; its id, 0 when it cannot be read. A NUL
// follows its bytes.
// The file `path` names, as its device and inode (0 when there is
// none): one file however its path is spelled.
pub fn fileIdentity(path: []const u8) -> u64 {
    const name = keep(path)
    const buffer = alloc(144)
    const result = std.linux.syscall2(SYS_stat, name, buffer)
    if result < 0 { return 0 }
    return (@intCast(u64, getWord(buffer)) << 32) ^ @intCast(u64, getWord(buffer + 8))
}

// Whether `path` names a directory.
pub fn isDirectory(path: []const u8) -> bool {
    const name = keep(path)
    const buffer = alloc(144)
    const result = std.linux.syscall2(SYS_stat, name, buffer)
    if result < 0 { return false }
    return (get32(buffer + 24) & 61440) == 16384
}

pub fn readFile(path: []const u8) -> u32 {
    if @intCast(usize, fileCount) >= MAX_FILES { fatal("too many files") }
    const name = keep(path)
    const descriptor = std.linux.syscall3(SYS_open, name, O_RDONLY | O_CLOEXEC, 0)
    if descriptor < 0 { return 0 }
    var capacity: usize = 65536
    var data = alloc(capacity + 1)
    var length: usize = 0
    while true {
        if length == capacity {
            const larger = alloc(capacity * 2 + 1)
            copy(larger, data, length)
            data = larger
            capacity = capacity * 2
        }
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), data + length, capacity - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    put8(data + length, 0)
    const id = fileCount
    fileCount += 1
    put32(fileAddress(id), intern(path))
    putWord(fileAddress(id) + 8, data)
    putWord(fileAddress(id) + 16, length)
    return id
}

// A file made of `text` (the predefined macros, the command line's -D).
pub fn textFile(name: []const u8, text: []const u8) -> u32 {
    const id = fileCount
    fileCount += 1
    put32(fileAddress(id), intern(name))
    putWord(fileAddress(id) + 8, keep(text))
    putWord(fileAddress(id) + 16, text.length)
    return id
}

// ---------------------------------------------------------------------------
// Messages

pub fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

pub fn sayNumber(value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    say(view[24 - count..24])
}

pub fn exit(status: usize) -> void {
    const ignored = std.linux.syscall1(SYS_exit_group, status)
}

pub fn fatal(message: []const u8) -> void {
    say("mlx-cc: ")
    say(message)
    say("\n")
    exit(1)
}

// "file:line: error: message" and the end of the run (with the
// template instances being read, innermost first).
pub fn errorAt(file: u32, line: u32, message: []const u8) -> void {
    if file != 0 { say(nameOf(fileName(file))) } else { say("mlx-cc") }
    say(":")
    sayNumber(@intCast(u64, line))
    say(": error: ")
    say(message)
    say("\n")
    var index = traceTop
    var shown: usize = 0
    while index > 0 && shown < 16 {
        index -= 1
        const entry = traceStack + index * 16
        const at_ = getWord(entry)
        const name = @intCast(u32, getWord(entry + 8))
        say("  note: in ")
        if name != 0 { say(nameOf(name)) } else { say("a template instance") }
        say(", needed at ")
        const traceFile = @intCast(u32, at_ >> 32)
        if traceFile != 0 { say(nameOf(fileName(traceFile))) } else { say("mlx-cc") }
        say(":")
        sayNumber(at_ & 0xffffffff)
        say("\n")
        shown += 1
    }
    exit(1)
}

// The template instances being read (C++): entries of (file << 32 |
// line where needed, name), for the notes after an error.
var traceStack: usize = 0
var traceTop: usize = 0
const MAX_TRACE: usize = 4096
pub fn pushTrace(file: u32, line: u32) -> void {
    if traceStack == 0 { traceStack = alloc(MAX_TRACE * 16) }
    if traceTop >= MAX_TRACE { return }
    putWord(traceStack + traceTop * 16, (@intCast(u64, file) << 32) | @intCast(u64, line))
    putWord(traceStack + traceTop * 16 + 8, 0)
    traceTop += 1
}
pub fn nameTrace(name: u32) -> void {
    if traceTop > 0 && traceTop <= MAX_TRACE { putWord(traceStack + (traceTop - 1) * 16 + 8, @intCast(u64, name)) }
}
pub fn popTrace() -> void { if traceTop > 0 { traceTop -= 1 } }

pub fn warnAt(file: u32, line: u32, message: []const u8) -> void {
    if file != 0 { say(nameOf(fileName(file))) } else { say("mlx-cc") }
    say(":")
    sayNumber(@intCast(u64, line))
    say(": warning: ")
    say(message)
    say("\n")
}
