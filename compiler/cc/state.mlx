// What the parser keeps while it reads a translation unit: the file, its
// globals (functions, variables, string literals, in order), the function
// being defined with its locals, the goto labels, the jump targets of the
// loop or switch around, and the counters that make labels and the
// symbols of statics unique in the program.
const base = @import("./base.mlx")
const ast = @import("./ast.mlx")

var fileId: u32 = 0
var globalsHead: usize = 0
var globalsTail: usize = 0
var function: usize = 0
var localsHead: usize = 0
// Cells of two words (node, next): the function's gotos and labels.
var gotoCells: usize = 0
var labelCells: usize = 0
var breakLabel: u32 = 0
var continueLabel: u32 = 0
var currentSwitch: usize = 0
var labelCounter: u32 = 0
var staticCounter: u32 = 0
// C++ (cpp.mlx): the class whose member function is being defined; the
// objects to destroy when their scopes end (a stack of locals), and how
// far down a break or continue destroys; the temporaries of the
// expression being read (cells of object and next).
var currentClassType: usize = 0
var cleanupStack: usize = 0
var cleanupTop: usize = 0
var loopCleanupHeight: usize = 0
var temporaries: usize = 0
const MAX_CLEANUPS: usize = 65536

pub fn startFile(file: u32) -> void {
    fileId = file
    globalsHead = 0
    globalsTail = 0
}

pub fn file() -> u32 { return fileId }
pub fn globals() -> usize { return globalsHead }

// Adds a global object to the file's list.
pub fn addGlobal(obj: usize) -> void {
    ast.obj(obj).*.file = fileId
    if globalsHead == 0 { globalsHead = obj } else { ast.obj(globalsTail).*.next = obj }
    globalsTail = obj
}

pub fn startFunction(fn_obj: usize) -> void {
    function = fn_obj
    localsHead = 0
    gotoCells = 0
    labelCells = 0
    breakLabel = 0
    continueLabel = 0
    currentSwitch = 0
    currentClassType = 0
    cleanupTop = 0
    loopCleanupHeight = 0
    temporaries = 0
}

pub fn endFunction() -> void {
    function = 0
    currentClassType = 0
}

pub fn currentClass() -> usize { return currentClassType }
pub fn setCurrentClass(ty: usize) -> void { currentClassType = ty }

// The objects to destroy, innermost last.
pub fn pushCleanup(obj: usize) -> void {
    if cleanupStack == 0 { cleanupStack = base.alloc(MAX_CLEANUPS * 8) }
    if cleanupTop >= MAX_CLEANUPS { base.fatal("too many objects to destroy") }
    base.putWord(cleanupStack + cleanupTop * 8, obj)
    cleanupTop += 1
}

pub fn cleanupCount() -> usize { return cleanupTop }
pub fn cleanupAt(index: usize) -> usize { return base.getWord(cleanupStack + index * 8) }
pub fn popCleanups(height: usize) -> void { if height < cleanupTop { cleanupTop = height } }

pub fn loopCleanups() -> usize { return loopCleanupHeight }
pub fn setLoopCleanups(height: usize) -> void { loopCleanupHeight = height }

// The temporaries made so far in the expression being read.
pub fn addTemporary(obj: usize) -> void { temporaries = cell(obj, temporaries) }

pub fn hasTemporaries() -> bool { return temporaries != 0 }

// The temporary `obj` taken off the list (it was never made: its
// initialization went to another object).
pub fn removeTemporary(obj: usize) -> void {
    var c = temporaries
    var previous: usize = 0
    while c != 0 {
        if cellNode(c) == obj {
            if previous == 0 { temporaries = cellNext(c) } else { base.putWord(previous + 8, cellNext(c)) }
            return
        }
        previous = c
        c = cellNext(c)
    }
}

// Puts a list taken before back (after a branch's own were flushed).
pub fn setTemporaries(list: usize) -> void { temporaries = list }

pub fn takeTemporaries() -> usize {
    const head = temporaries
    temporaries = 0
    return head
}

pub fn isPendingTemporary(obj: usize) -> bool {
    var c = temporaries
    while c != 0 {
        if cellNode(c) == obj { return true }
        c = cellNext(c)
    }
    return false
}

pub fn currentFunction() -> usize { return function }
pub fn locals() -> usize { return localsHead }

// The temporaries of expressions at file scope (the wide integer
// arithmetic of initializers): locals of __mlxcc_init.
var initLocalsHead: usize = 0

pub fn initLocals() -> usize { return initLocalsHead }

pub fn addInitLocal(obj: usize) -> void {
    ast.obj(obj).*.next = initLocalsHead
    initLocalsHead = obj
}

pub fn addLocal(obj: usize) -> void {
    ast.obj(obj).*.next = localsHead
    localsHead = obj
}

fn cell(node: usize, next: usize) -> usize {
    const c = base.alloc(16)
    base.putWord(c, node)
    base.putWord(c + 8, next)
    return c
}

pub fn addGoto(node: usize) -> void { gotoCells = cell(node, gotoCells) }
pub fn addLabel(node: usize) -> void { labelCells = cell(node, labelCells) }
pub fn gotos() -> usize { return gotoCells }
pub fn labels() -> usize { return labelCells }

pub fn cellNode(c: usize) -> usize { return base.getWord(c) }
pub fn cellNext(c: usize) -> usize { return base.getWord(c + 8) }

pub fn breakTarget() -> u32 { return breakLabel }
pub fn continueTarget() -> u32 { return continueLabel }
pub fn setBreakTarget(label: u32) -> void { breakLabel = label }
pub fn setContinueTarget(label: u32) -> void { continueLabel = label }

pub fn switchNode() -> usize { return currentSwitch }
pub fn setSwitchNode(node: usize) -> void { currentSwitch = node }

// The function being read, kept while a template is instantiated in
// its middle: a snapshot, and its restoration.
pub fn save() -> usize {
    const s = base.alloc(12 * 8 + cleanupTop * 8)
    base.putWord(s, function)
    base.putWord(s + 8, localsHead)
    base.putWord(s + 16, gotoCells)
    base.putWord(s + 24, labelCells)
    base.putWord(s + 32, @intCast(usize, breakLabel))
    base.putWord(s + 40, @intCast(usize, continueLabel))
    base.putWord(s + 48, currentSwitch)
    base.putWord(s + 56, currentClassType)
    base.putWord(s + 64, cleanupTop)
    base.putWord(s + 72, loopCleanupHeight)
    base.putWord(s + 80, temporaries)
    var index: usize = 0
    while index < cleanupTop {
        base.putWord(s + 96 + index * 8, base.getWord(cleanupStack + index * 8))
        index += 1
    }
    return s
}

pub fn restore(s: usize) -> void {
    function = base.getWord(s)
    localsHead = base.getWord(s + 8)
    gotoCells = base.getWord(s + 16)
    labelCells = base.getWord(s + 24)
    breakLabel = @intCast(u32, base.getWord(s + 32))
    continueLabel = @intCast(u32, base.getWord(s + 40))
    currentSwitch = base.getWord(s + 48)
    currentClassType = base.getWord(s + 56)
    cleanupTop = base.getWord(s + 64)
    loopCleanupHeight = base.getWord(s + 72)
    temporaries = base.getWord(s + 80)
    var index: usize = 0
    while index < cleanupTop {
        if cleanupStack == 0 { cleanupStack = base.alloc(MAX_CLEANUPS * 8) }
        base.putWord(cleanupStack + index * 8, base.getWord(s + 96 + index * 8))
        index += 1
    }
}

// A label number unique in the program (code generation names it .L<n>).
pub fn newLabel() -> u32 {
    labelCounter += 1
    return labelCounter
}

// A number for the symbol of a static (a static local, a literal, a
// static function's or variable's symbol made unique among files).
pub fn newStatic() -> u32 {
    staticCounter += 1
    return staticCounter
}
