// Scopes (C11 6.2.1): what an identifier names where it is used (a
// variable or function, a typedef, an enumeration constant), and the
// tags of structs, unions and enums, which have their own name space.
// Each name has a chain of bindings, the innermost first; leaving a scope
// pops the bindings it made.
//
// C++ namespaces (and the scopes of classes and scoped enums) are
// prefixes: a name declared at file scope inside `namespace N` is bound
// under the key `N::name`, and an unqualified use looks the name up
// under the prefixes from the innermost namespace outward, then under
// the namespaces of the using-directives in force.
const base = @import("./base.mlx")
const types = @import("./types.mlx")

pub const VARIABLE: u8 = 1
pub const TYPEDEF: u8 = 2
pub const ENUM_CONSTANT: u8 = 3
pub const TAG: u8 = 4
// A namespace: `value` is its qualified prefix's name id.
pub const NAMESPACE: u8 = 5
// A C++ template: `obj` is its record (template.mlx).
pub const TEMPLATE: u8 = 6
// A C++ parameter pack bound to its arguments: `obj` is the holder
// (types.mlx), `ty` the pack as a type (0 for a pack of variables).
pub const PACK: u8 = 7

// A pack expansion being read: the element the pack's names stand for
// (-1 outside one: a pack read then is noted in `packSeen`, its first
// element taken, for the reader to expand after `...`); with
// `packPlaceholders`, a pack type stands for itself (a parameter list,
// expanded by the reader).
pub var packIndex: i64 = -1
pub var packSeen: usize = 0
pub var packPlaceholders = false

pub fn bindPack(name: u32, ty: usize, holder: usize) -> usize {
    const binding = bind(variableHeads, madeVariables, PACK, name)
    at(binding).*.obj = holder
    at(binding).*.ty = ty
    return binding
}

pub const Binding = struct {
    kind: u8
    name: u32
    depth: u32
    // A variable's or function's object; a typedef's, enum constant's or
    // tag's type.
    obj: usize
    ty: usize
    value: i64
    // The binding of the same name it hides, and the next one made in the
    // same scope.
    hidden: usize
    sibling: usize
}

const MAX_DEPTH: usize = 4096

var variableHeads: usize = 0
var tagHeads: usize = 0
// Per depth: the bindings made there (ordinary names, tags).
var madeVariables: usize = 0
var madeTags: usize = 0
var depth: u32 = 0
// The namespace being declared into: a stack of qualified prefixes
// (name ids); each prefix's parent; the using-directives per depth
// (cells of prefix and next).
var namespaceStack: usize = 0
var namespaceDepth: usize = 0
var parents: usize = 0
var madeUsings: usize = 0
// Suspended scopes (a template instantiated inside a function): the
// depths to come back to, a stack.
var suspended: usize = 0
var suspendedCount: usize = 0
// Whether each level was put aside by a lambda or a local class
// (markExposed), whose body sees that level's types: a byte a level.
var suspendedExposed: usize = 0

// Moved on whenever what a name means may change (a binding made, a scope
// or prefix entered or left, a using-directive): decl's memo of the last
// qualified type name read holds while it stays.
pub var stamp: u64 = 1

pub fn at(binding: usize) -> *Binding {
    unsafe { return @ptrFromInt(*Binding, binding) }
}

pub fn init() -> void {
    variableHeads = base.alloc(base.MAX_NAMES * 8)
    tagHeads = base.alloc(base.MAX_NAMES * 8)
    madeVariables = base.alloc(MAX_DEPTH * 8)
    madeTags = base.alloc(MAX_DEPTH * 8)
    namespaceStack = base.alloc(MAX_DEPTH * 8)
    parents = base.alloc(base.MAX_NAMES * 4)
    madeUsings = base.alloc(MAX_DEPTH * 8)
    suspended = base.alloc(MAX_DEPTH * 8)
    suspendedExposed = base.alloc(MAX_DEPTH)
    depth = 0
    namespaceDepth = 0
    suspendedCount = 0
}

// Leaves the block scopes without forgetting them: their bindings are
// unlinked from the names, the depth is 0, and `resume` brings them
// back. For a template instantiated in the middle of a function (its
// class and functions belong to the file).
pub fn suspend() -> void {
    stamp += 1
    var d: usize = @intCast(usize, depth)
    while d > 0 {
        var binding = base.getWord(madeVariables + d * 8)
        while binding != 0 {
            base.putWord(variableHeads + @intCast(usize, at(binding).*.name) * 8, at(binding).*.hidden)
            binding = at(binding).*.sibling
        }
        binding = base.getWord(madeTags + d * 8)
        while binding != 0 {
            base.putWord(tagHeads + @intCast(usize, at(binding).*.name) * 8, at(binding).*.hidden)
            binding = at(binding).*.sibling
        }
        d -= 1
    }
    // The blocks' binding lists, which the instance's own blocks reuse.
    const n: usize = @intCast(usize, depth)
    const snapshot = base.alloc(8 + n * 24)
    base.putWord(snapshot, n)
    d = 1
    while d <= n {
        base.putWord(snapshot + 8 + (d - 1) * 24, base.getWord(madeVariables + d * 8))
        base.putWord(snapshot + 16 + (d - 1) * 24, base.getWord(madeTags + d * 8))
        base.putWord(snapshot + 24 + (d - 1) * 24, base.getWord(madeUsings + d * 8))
        d += 1
    }
    if suspendedCount >= MAX_DEPTH { base.fatal("templates nested too deeply") }
    base.putWord(suspended + suspendedCount * 8, snapshot)
    base.put8(suspendedExposed + suspendedCount, 0)
    suspendedCount += 1
    depth = 0
}

// In a lambda or a local class: the types, enumerators and templates of
// the function around (suspended), in sight; its variables are not.
pub var exposeSuspended = false

// (A variable of the function around found first: it hides the names
// outside the function, the global `typedef ... id` behind a local `id`;
// the lambda reads it through its captures.)
const HIDDEN: usize = 1

fn suspendedType(isTag: bool, name: u32) -> usize {
    if suspendedCount == 0 { return 0 }
    // (Further out while the level was put aside by a lambda too: a local
    // enum of the function around a lambda in a lambda, WebCore's
    // SelectorChecker.)
    var level = suspendedCount
    while level > 0 {
        level -= 1
        const snapshot = base.getWord(suspended + level * 8)
        var d = base.getWord(snapshot)
        while d > 0 {
            var binding = base.getWord(snapshot + (if isTag { 16 } else { 8 }) + (d - 1) * 24)
            while binding != 0 {
                if at(binding).*.name == name {
                    const k = at(binding).*.kind
                    if isTag || k == TYPEDEF || k == ENUM_CONSTANT || k == TEMPLATE || k == NAMESPACE { return binding }
                    if k == VARIABLE { return HIDDEN }
                }
                binding = at(binding).*.sibling
            }
            d -= 1
        }
        if level == 0 || base.get8(suspendedExposed + level - 1) == 0 { break }
    }
    return 0
}

// The scopes put aside last were a lambda's or a local class's function
// around (template.beginContext).
pub fn markExposed() -> void {
    if suspendedCount > 0 { base.put8(suspendedExposed + suspendedCount - 1, 1) }
}

// The binding of `name` in the block scopes suspended last (a local of
// the function a lambda is written in), innermost first; 0 for none.
pub fn findSuspended(name: u32) -> usize {
    if suspendedCount == 0 { return 0 }
    return findSuspendedAt(suspendedCount - 1, name)
}

// The scopes put aside `outward` levels further out than findSuspended's
// (0: those): the binding of `name` there, 0 when none or no such level.
pub fn findSuspendedOut(outward: usize, name: u32) -> usize {
    if outward >= suspendedCount { return 0 }
    return findSuspendedAt(suspendedCount - 1 - outward, name)
}

// The tag `name` in the block scopes suspended last (a local class or
// enum of the function a lambda is written in); 0 for none.
pub fn findSuspendedTag(name: u32) -> usize {
    if suspendedCount == 0 { return 0 }
    const snapshot = base.getWord(suspended + (suspendedCount - 1) * 8)
    var d = base.getWord(snapshot)
    while d > 0 {
        var binding = base.getWord(snapshot + 16 + (d - 1) * 24)
        while binding != 0 {
            if at(binding).*.name == name { return binding }
            binding = at(binding).*.sibling
        }
        d -= 1
    }
    return 0
}

fn findSuspendedAt(level: usize, name: u32) -> usize {
    const snapshot = base.getWord(suspended + level * 8)
    var d = base.getWord(snapshot)
    while d > 0 {
        var binding = base.getWord(snapshot + 8 + (d - 1) * 24)
        while binding != 0 {
            if at(binding).*.name == name { return binding }
            binding = at(binding).*.sibling
        }
        d -= 1
    }
    return 0
}

fn relink(heads: usize, binding: usize) -> void {
    // The oldest sibling first, so the newest ends up on top.
    if binding == 0 { return }
    relink(heads, at(binding).*.sibling)
    base.putWord(heads + @intCast(usize, at(binding).*.name) * 8, binding)
}

pub fn resume() -> void {
    stamp += 1
    if suspendedCount == 0 { return }
    suspendedCount -= 1
    const snapshot = base.getWord(suspended + suspendedCount * 8)
    const n = base.getWord(snapshot)
    depth = @intCast(u32, n)
    var d: usize = 1
    while d <= n {
        base.putWord(madeVariables + d * 8, base.getWord(snapshot + 8 + (d - 1) * 24))
        base.putWord(madeTags + d * 8, base.getWord(snapshot + 16 + (d - 1) * 24))
        base.putWord(madeUsings + d * 8, base.getWord(snapshot + 24 + (d - 1) * 24))
        relink(variableHeads, base.getWord(madeVariables + d * 8))
        relink(tagHeads, base.getWord(madeTags + d * 8))
        d += 1
    }
}

// The namespace declarations go into (its qualified prefix; 0: the
// global one).
pub fn currentNamespace() -> u32 {
    if namespaceDepth == 0 { return 0 }
    return @intCast(u32, base.getWord(namespaceStack + (namespaceDepth - 1) * 8))
}

// `prefix::name` as a name id (`name` alone under the global prefix).
// (Each pair made once: a table of (prefix, name, key), open-addressed.)
const QUALIFIED_SLOTS: usize = 4194304
var qualified: usize = 0
var qualifiedCount: usize = 0

pub fn qualify(prefix: u32, name: u32) -> u32 {
    if prefix == 0 { return name }
    if qualified == 0 { qualified = base.alloc(QUALIFIED_SLOTS * 12) }
    const pair = (@intCast(u64, prefix) << 32) | @intCast(u64, name)
    var slot = @intCast(usize, (pair *% 11400714819323198485) >> 42) & (QUALIFIED_SLOTS - 1)
    while true {
        const at = qualified + slot * 12
        const held = base.get32(at + 8)
        if held == 0 { break }
        if base.get32(at) == prefix && base.get32(at + 4) == name { return held }
        slot = (slot + 1) & (QUALIFIED_SLOTS - 1)
    }
    const mark = base.buildMark()
    base.append(base.nameOf(prefix))
    base.append("::")
    base.append(base.nameOf(name))
    const key = base.internBuilt(mark)
    base.put32(parents + @intCast(usize, key) * 4, prefix)
    // (A full table only stops caching.)
    if qualifiedCount < QUALIFIED_SLOTS / 2 {
        const at = qualified + slot * 12
        base.put32(at, prefix)
        base.put32(at + 4, name)
        base.put32(at + 8, key)
        qualifiedCount += 1
    }
    return key
}

// `prefix::name` when that name exists, else 0: what lookups ask. (A
// lookup from a nested prefix asks every prefix around and every
// namespace a using-directive names; each name it missed was made and
// kept, millions in WebCore's larger units: "too many names".)
pub fn qualifiedKnown(prefix: u32, name: u32) -> u32 {
    if prefix == 0 { return name }
    if qualified != 0 {
        const pair = (@intCast(u64, prefix) << 32) | @intCast(u64, name)
        var slot = @intCast(usize, (pair *% 11400714819323198485) >> 42) & (QUALIFIED_SLOTS - 1)
        while true {
            const at = qualified + slot * 12
            const held = base.get32(at + 8)
            if held == 0 { break }
            if base.get32(at) == prefix && base.get32(at + 4) == name { return held }
            slot = (slot + 1) & (QUALIFIED_SLOTS - 1)
        }
    }
    return base.findJoined(prefix, "::", name)
}

// The binding `heads` holds for `prefix::name` (0 when that name does
// not exist).
fn headOf(heads: usize, prefix: u32, name: u32) -> usize {
    const key = qualifiedKnown(prefix, name)
    if key == 0 { return 0 }
    return base.getWord(heads + @intCast(usize, key) * 8)
}

pub fn parentOf(prefix: u32) -> u32 { return base.get32(parents + @intCast(usize, prefix) * 4) }

// The prefixes entered, innermost last: their number and each.
pub fn prefixCount() -> usize { return namespaceDepth }
// The prefixes entered before the template instance being read
// (template.beginInstance): its injected class names are above them.
pub var prefixFloor: usize = 0
pub fn prefixAt(index: usize) -> u32 { return @intCast(u32, base.getWord(namespaceStack + index * 8)) }

// Declares into `namespace name` of the current one.
pub fn enterNamespace(name: u32) -> void {
    enterPrefix(qualify(currentNamespace(), name))
}

// Declares into the namespace or class with the qualified `prefix`.
// Whether the current namespace is `prefix` or one below it: names
// under `prefix` are found already.
pub fn isWithin(prefix: u32) -> bool {
    var p = currentNamespace()
    while p != prefix {
        if p == 0 { return false }
        p = parentOf(p)
    }
    return true
}

pub fn enterPrefix(prefix: u32) -> void {
    if namespaceDepth + 1 >= MAX_DEPTH { base.fatal("namespaces nested too deeply") }
    base.putWord(namespaceStack + namespaceDepth * 8, @intCast(usize, prefix))
    namespaceDepth += 1
    stamp += 1
}

pub fn leaveNamespace() -> void {
    if namespaceDepth > 0 { namespaceDepth -= 1 }
    stamp += 1
}

// `using namespace` with the qualified `prefix`, in force in the current
// scope.
pub fn usingNamespace(prefix: u32) -> void {
    stamp += 1
    const cell = base.alloc(16)
    base.putWord(cell, @intCast(usize, prefix))
    base.putWord(cell + 8, base.getWord(madeUsings + @intCast(usize, depth) * 8))
    base.putWord(madeUsings + @intCast(usize, depth) * 8, cell)
}

// The using-directives in force at depth `d`: cells of (prefix, next).
pub fn usingsAt(d: u32) -> usize { return base.getWord(madeUsings + @intCast(usize, d) * 8) }

// The key a name is bound under here: qualified at file scope.
fn keyOf(name: u32) -> u32 {
    if depth == 0 || qualifiedDepth > 0 { return qualify(currentNamespace(), name) }
    return name
}

// While a local class's body is read (C++, a class in a function), its
// members are bound by their qualified names at the file's depth, as
// a class's at file scope are: its member functions, read apart from
// the function, find them so.
var qualifiedDepth: u32 = 0
pub fn beginQualified() -> void { qualifiedDepth += 1 }
pub fn endQualified() -> void { qualifiedDepth -= 1 }

// The binding of `name` seen from here: a local one, else the one under
// the prefixes from the current namespace outward, else one a
// using-directive brings in.
fn lookup(heads: usize, name: u32) -> usize {
    const local = base.getWord(heads + @intCast(usize, name) * 8)
    if local != 0 && at(local).*.depth > 0 { return local }
    if exposeSuspended {
        const outer = suspendedType(heads == tagHeads, name)
        if outer == HIDDEN { return 0 }
        if outer != 0 { return outer }
    }
    var prefix = currentNamespace()
    while true {
        const found = headOf(heads, prefix, name)
        if found != 0 && at(found).*.depth == 0 { return found }
        if prefix == 0 { break }
        prefix = parentOf(prefix)
    }
    var d: usize = @intCast(usize, depth) + 1
    while d > 0 {
        d -= 1
        var cell = base.getWord(madeUsings + d * 8)
        while cell != 0 {
            const using = @intCast(u32, base.getWord(cell))
            const found = headOf(heads, using, name)
            if found != 0 && at(found).*.depth == 0 { return found }
            cell = base.getWord(cell + 8)
        }
    }
    if exposeSuspended { return suspendedUsing(heads, name, 0) }
    return 0
}

// In a lambda or a local class: the binding of `name` (of the kind
// `wanted`, 0 any) that a using-directive of the function around brings
// in (`using namespace SkSL;` before a local class); 0 for none.
fn suspendedUsing(heads: usize, name: u32, wanted: u8) -> usize {
    if suspendedCount == 0 { return 0 }
    const snapshot = base.getWord(suspended + (suspendedCount - 1) * 8)
    var d = base.getWord(snapshot)
    while d > 0 {
        var cell = base.getWord(snapshot + 24 + (d - 1) * 24)
        while cell != 0 {
            const using = @intCast(u32, base.getWord(cell))
            const found = headOf(heads, using, name)
            if found != 0 && at(found).*.depth == 0 && (wanted == 0 || at(found).*.kind == wanted) { return found }
            cell = base.getWord(cell + 8)
        }
        d -= 1
    }
    return 0
}

// The innermost binding of `name` of the kind `wanted` (a namespace, a
// template), passing the others (a class's constructor is bound under
// the class's own name).
pub fn findKind(name: u32, wanted: u8) -> usize {
    const local = base.getWord(variableHeads + @intCast(usize, name) * 8)
    var b = local
    while b != 0 && at(b).*.depth > 0 {
        if at(b).*.kind == wanted { return b }
        b = at(b).*.hidden
    }
    var prefix = currentNamespace()
    while true {
        var found = headOf(variableHeads, prefix, name)
        // (The file scope's binding of a name a block's hides: `angle::`
        // beside a parameter `angle`.)
        while found != 0 && at(found).*.depth > 0 { found = at(found).*.hidden }
        if found != 0 && at(found).*.depth == 0 && at(found).*.kind == wanted { return found }
        if prefix == 0 { break }
        prefix = parentOf(prefix)
    }
    var d: usize = @intCast(usize, depth) + 1
    while d > 0 {
        d -= 1
        var cell = base.getWord(madeUsings + d * 8)
        while cell != 0 {
            const using = @intCast(u32, base.getWord(cell))
            const found = headOf(variableHeads, using, name)
            if found != 0 && at(found).*.depth == 0 && at(found).*.kind == wanted { return found }
            cell = base.getWord(cell + 8)
        }
    }
    if exposeSuspended { return suspendedUsing(variableHeads, name, wanted) }
    return 0
}

pub fn currentDepth() -> u32 { return depth }

pub fn isFileScope() -> bool { return depth == 0 }

pub fn enter() -> void {
    if @intCast(usize, depth) + 1 >= MAX_DEPTH { base.fatal("blocks nested too deeply") }
    depth += 1
    stamp += 1
    base.putWord(madeVariables + @intCast(usize, depth) * 8, 0)
    base.putWord(madeTags + @intCast(usize, depth) * 8, 0)
    base.putWord(madeUsings + @intCast(usize, depth) * 8, 0)
}

pub fn leave() -> void {
    stamp += 1
    var binding = base.getWord(madeVariables + @intCast(usize, depth) * 8)
    while binding != 0 {
        base.putWord(variableHeads + @intCast(usize, at(binding).*.name) * 8, at(binding).*.hidden)
        binding = at(binding).*.sibling
    }
    binding = base.getWord(madeTags + @intCast(usize, depth) * 8)
    while binding != 0 {
        base.putWord(tagHeads + @intCast(usize, at(binding).*.name) * 8, at(binding).*.hidden)
        binding = at(binding).*.sibling
    }
    depth -= 1
}

// Leaves every scope down to the file's and forgets the file's own
// bindings (the next translation unit starts empty).
pub fn reset() -> void {
    while depth > 0 { leave() }
    var binding = base.getWord(madeVariables)
    while binding != 0 {
        base.putWord(variableHeads + @intCast(usize, at(binding).*.name) * 8, 0)
        binding = at(binding).*.sibling
    }
    binding = base.getWord(madeTags)
    while binding != 0 {
        base.putWord(tagHeads + @intCast(usize, at(binding).*.name) * 8, 0)
        binding = at(binding).*.sibling
    }
    base.putWord(madeVariables, 0)
    base.putWord(madeTags, 0)
    base.putWord(madeUsings, 0)
    namespaceDepth = 0
}

fn bind(heads: usize, made: usize, kind: u8, name: u32) -> usize {
    stamp += 1
    const key = keyOf(name)
    const at_depth: usize = if qualifiedDepth > 0 { 0 } else { @intCast(usize, depth) }
    const binding = base.alloc(@sizeOf(Binding))
    const b = at(binding)
    b.*.kind = kind
    b.*.name = key
    b.*.depth = @intCast(u32, at_depth)
    b.*.hidden = base.getWord(heads + @intCast(usize, key) * 8)
    b.*.sibling = base.getWord(made + at_depth * 8)
    base.putWord(heads + @intCast(usize, key) * 8, binding)
    base.putWord(made + at_depth * 8, binding)
    return binding
}

pub fn bindTemplate(name: u32, record: usize) -> usize {
    const binding = bind(variableHeads, madeVariables, TEMPLATE, name)
    at(binding).*.obj = record
    return binding
}

pub fn bindNamespace(name: u32, prefix: u32) -> usize {
    const binding = bind(variableHeads, madeVariables, NAMESPACE, name)
    at(binding).*.value = @intCast(i64, prefix)
    return binding
}

// The binding of `name` under the qualified `prefix` exactly (a tag with
// `isTag`), 0 when there is none.
pub fn findQualified(prefix: u32, name: u32, isTag: bool) -> usize {
    const heads = if isTag { tagHeads } else { variableHeads }
    var found = headOf(heads, prefix, name)
    // `::link(...)` where a local or parameter `link` hides the global.
    while found != 0 && at(found).*.depth != 0 && at(found).*.hidden != 0 && at(at(found).*.hidden).*.name == at(found).*.name { found = at(found).*.hidden }
    if found != 0 && at(found).*.depth == 0 { return found }
    // The inline namespaces of `prefix` hold its names too.
    var c = inlineNamespaces
    while c != 0 {
        if @intCast(u32, base.getWord(c)) == prefix {
            const inner = findQualified(@intCast(u32, base.getWord(c + 8)), name, isTag)
            if inner != 0 { return inner }
        }
        c = base.getWord(c + 16)
    }
    // And those a using-directive in `prefix` names (`namespace JSON {
    // using namespace JSONImpl; }`, then `JSON::Object`).
    if qualifiedNesting < 8 {
        c = directiveNamespaces
        while c != 0 {
            if @intCast(u32, base.getWord(c)) == prefix {
                qualifiedNesting += 1
                const inner = findQualified(@intCast(u32, base.getWord(c + 8)), name, isTag)
                qualifiedNesting -= 1
                if inner != 0 { return inner }
            }
            c = base.getWord(c + 16)
        }
    }
    return 0
}

// The using-directives in namespaces: cells of (the namespace's prefix,
// the prefix named, next).
var directiveNamespaces: usize = 0
var qualifiedNesting: u32 = 0
pub fn addDirective(parent: u32, prefix: u32) -> void {
    if parent == prefix { return }
    stamp += 1
    const c = base.alloc(24)
    base.putWord(c, @intCast(usize, parent))
    base.putWord(c + 8, @intCast(usize, prefix))
    base.putWord(c + 16, directiveNamespaces)
    directiveNamespaces = c
}

// The inline namespaces: cells of (parent prefix, the namespace's
// prefix, next). `inline namespace N` in P makes N's names P's.
var inlineNamespaces: usize = 0
pub fn isInlineNamespace(parent: u32, prefix: u32) -> bool {
    var c = inlineNamespaces
    while c != 0 {
        if @intCast(u32, base.getWord(c)) == parent && @intCast(u32, base.getWord(c + 8)) == prefix { return true }
        c = base.getWord(c + 16)
    }
    return false
}

// The bindings of `name` that the inline namespaces of `prefix` (the
// unnamed one among them) hold, one at each call: *CELL is where the
// walk is (0 to start); 0 when there are no more.
pub fn nextInlineBinding(prefix: u32, name: u32, cell: *usize) -> usize {
    var c = if cell.* == 0 { inlineNamespaces } else { base.getWord(cell.* + 16) }
    while c != 0 {
        if @intCast(u32, base.getWord(c)) == prefix {
            const found = headOf(variableHeads, @intCast(u32, base.getWord(c + 8)), name)
            if found != 0 && at(found).*.depth == 0 {
                cell.* = c
                return found
            }
        }
        c = base.getWord(c + 16)
    }
    return 0
}

pub fn addInlineNamespace(parent: u32, prefix: u32) -> void {
    const c = base.alloc(24)
    base.putWord(c, @intCast(usize, parent))
    base.putWord(c + 8, @intCast(usize, prefix))
    base.putWord(c + 16, inlineNamespaces)
    inlineNamespaces = c
    usingNamespace(prefix)
}

pub fn bindVariable(name: u32, obj: usize) -> usize {
    const binding = bind(variableHeads, madeVariables, VARIABLE, name)
    at(binding).*.obj = obj
    return binding
}

pub fn bindTypedef(name: u32, ty: usize) -> usize {
    const binding = bind(variableHeads, madeVariables, TYPEDEF, name)
    at(binding).*.ty = ty
    return binding
}

pub fn bindEnumConstant(name: u32, ty: usize, value: i64) -> usize {
    const binding = bind(variableHeads, madeVariables, ENUM_CONSTANT, name)
    at(binding).*.ty = ty
    at(binding).*.value = value
    return binding
}

pub fn bindTag(name: u32, ty: usize) -> usize {
    const binding = bind(tagHeads, madeTags, TAG, name)
    at(binding).*.ty = ty
    return binding
}

// The innermost binding of `name`, 0 when there is none.
pub fn find(name: u32) -> usize {
    return lookup(variableHeads, name)
}

pub fn findTag(name: u32) -> usize {
    return lookup(tagHeads, name)
}

// The binding of `name` made in the current scope itself, 0 when none.
pub fn findHere(name: u32) -> usize {
    const binding = base.getWord(variableHeads + @intCast(usize, keyOf(name)) * 8)
    if binding != 0 && at(binding).*.depth == depth { return binding }
    return 0
}

pub fn findTagHere(name: u32) -> usize {
    const binding = base.getWord(tagHeads + @intCast(usize, keyOf(name)) * 8)
    if binding != 0 && at(binding).*.depth == depth { return binding }
    return 0
}

// The typedef `name` stands for, 0 when it names no type here.
pub fn typedefOf(name: u32) -> usize {
    const binding = find(name)
    if binding == 0 { return 0 }
    if at(binding).*.kind == TYPEDEF { return at(binding).*.ty }
    return packTypeOf(binding)
}

// The type a pack's binding stands for here (see typedefOf), 0 when
// `binding` is not a type pack's.
pub fn packTypeOf(binding: usize) -> usize {
    if at(binding).*.kind == PACK && at(binding).*.ty != 0 {
        const holder = at(binding).*.obj
        if packIndex >= 0 { return types.packTypeAt(holder, packIndex) }
        if packPlaceholders { return at(binding).*.ty }
        packSeen = holder
        if types.packCount(holder) > 0 { return types.packTypeAt(holder, 0) }
        return at(binding).*.ty
    }
    return 0
}
