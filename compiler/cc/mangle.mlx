// C++ names as the linker sees them (the Itanium C++ ABI's mangling,
// as g++ and clang++ write it): a function is `_Z`, its qualified name
// (a nested name `N...E` when it is in a namespace or a class), and the
// codes of its parameter types, so that functions of the same name with
// other parameters (overloads) are different symbols; a variable in a
// namespace is `_ZN...E`. Types: `i` int, `c` char, `P` a pointer to,
// `R` a reference to, a class by its name's length and text. Not yet:
// `const` in the codes (the parser does not keep qualifiers), the
// substitutions `S_` for repeated types (every type is spelled out), so
// a name with a repeated class type differs from g++'s.
const base = @import("./base.mlx")
const types = @import("./types.mlx")
const scope = @import("./scope.mlx")
const table = @import("./table.mlx")

// `<length><text>` of a name, appended to the text being built
// (base.append).
fn emitSource(text: []const u8) -> void {
    base.appendDecimal(@intCast(u64, text.length))
    base.append(text)
}

fn sourceName(text: []const u8) -> []const u8 {
    const mark = base.buildMark()
    emitSource(text)
    return base.keepBuilt(mark)
}

// A lambda's closure class named as the Itanium ABI names it
// (lambda.mlx): `__lambda@LOCAL@CODE`, CODE its `<closure-type-name>`
// (`UlvE_`, `UliE0_`, after a data member's or variable's `2fnM` when
// it is in that one's initializer), LOCAL the `Z<encoding>E` of the
// function it is in (empty for one in a class's or a namespace's
// initializer). Its name in a qualified name is the CODE alone, and
// one in a function makes a local name: what comes before it is the
// function's (`_ZZ7countervENKUlvE_clEv`).
fn closureSeparator(text: []const u8) -> usize {
    if text.length < 10 || !base.startsWith(text, "__lambda@") { return 0 }
    var index = text.length
    while index > 9 {
        index -= 1
        if text[index] == 64 { return index }
    }
    return 0
}

// One component of a qualified name: a closure's code, else the source
// name.
fn emitComponent(text: []const u8) -> void {
    const separator = closureSeparator(text)
    if separator != 0 {
        base.append(text[separator + 1..text.length])
        return
    }
    emitSource(text)
}

// Where the components after the local name of a qualified name start:
// at its last closure in a function (0: none).
fn localStart(qualified: []const u8) -> usize {
    var found: usize = 0
    var start: usize = 0
    var index: usize = 0
    while index <= qualified.length {
        if index == qualified.length || (qualified[index] == 58 && index + 1 < qualified.length && qualified[index + 1] == 58) {
            const separator = closureSeparator(qualified[start..index])
            if separator > 9 { found = start + 1 }
            index += 2
            start = index
        } else {
            index += 1
        }
    }
    return found
}

// The `Z<encoding>E` of the qualified name's last closure in a function
// (empty: none); the rest from `localStart(qualified) - 1`.
fn localPart(qualified: []const u8) -> []const u8 {
    const at_ = localStart(qualified)
    if at_ == 0 { return "" }
    const rest = qualified[at_ - 1..qualified.length]
    var end: usize = 0
    while end + 1 < rest.length && !(rest[end] == 58 && rest[end + 1] == 58) { end += 1 }
    if end + 1 >= rest.length { end = rest.length }
    const component = rest[0..end]
    return component[9..closureSeparator(component)]
}

// The qualified name past its local part (all of it without one).
fn pastLocal(qualified: []const u8) -> []const u8 {
    const at_ = localStart(qualified)
    if at_ == 0 { return qualified }
    return qualified[at_ - 1..qualified.length]
}

// Whether the qualified name has more than one component.
fn isNested(qualified: []const u8) -> bool {
    var index: usize = 0
    while index + 1 < qualified.length {
        if qualified[index] == 58 && qualified[index + 1] == 58 { return true }
        index += 1
    }
    return false
}

// The components of a qualified name (`N::M::x`), each as a source name.
fn emitComponents(qualified: []const u8) -> void {
    var start: usize = 0
    var index: usize = 0
    while index < qualified.length {
        if qualified[index] == 58 && index + 1 < qualified.length && qualified[index + 1] == 58 {
            emitComponent(qualified[start..index])
            index += 2
            start = index
        } else {
            index += 1
        }
    }
    emitComponent(qualified[start..qualified.length])
}

// The operator function `operatorX` as the ABI spells it.
fn operatorName(text: []const u8) -> []const u8 {
    const op = text[8..text.length]
    // A conversion operator: `cv` and the target type's code.
    if op.length > 1 && op[0] == 64 { return base.join("cv", op[1..op.length]) }
    if base.same(op, "+") { return "pl" }
    if base.same(op, "-") { return "mi" }
    if base.same(op, "*") { return "ml" }
    if base.same(op, "/") { return "dv" }
    if base.same(op, "%") { return "rm" }
    if base.same(op, "==") { return "eq" }
    if base.same(op, "<=>") { return "ss" }
    if op.length > 2 && op[0] == 34 && op[1] == 34 { return base.join(base.join("li", base.decimal(@intCast(u64, op.length - 2))), op[2..op.length]) }
    if base.same(op, "!=") { return "ne" }
    if base.same(op, "<") { return "lt" }
    if base.same(op, ">") { return "gt" }
    if base.same(op, "<=") { return "le" }
    if base.same(op, ">=") { return "ge" }
    if base.same(op, "<<") { return "ls" }
    if base.same(op, ">>") { return "rs" }
    if base.same(op, "=") { return "aS" }
    if base.same(op, "[]") { return "ix" }
    if base.same(op, "()") { return "cl" }
    if base.same(op, "++") { return "pp" }
    if base.same(op, "--") { return "mm" }
    if base.same(op, "!") { return "nt" }
    if base.same(op, "~") { return "co" }
    if base.same(op, "&") { return "an" }
    if base.same(op, "|") { return "or" }
    if base.same(op, "^") { return "eo" }
    if base.same(op, "&&") { return "aa" }
    if base.same(op, "||") { return "oo" }
    if base.same(op, "+=") { return "pL" }
    if base.same(op, "-=") { return "mI" }
    if base.same(op, "*=") { return "mL" }
    if base.same(op, "/=") { return "dV" }
    if base.same(op, "%=") { return "rM" }
    if base.same(op, "&=") { return "aN" }
    if base.same(op, "|=") { return "oR" }
    if base.same(op, "^=") { return "eO" }
    if base.same(op, "<<=") { return "lS" }
    if base.same(op, ">>=") { return "rS" }
    if base.same(op, "->") { return "pt" }
    if base.same(op, "->*") { return "pm" }
    if base.same(op, ",") { return "cm" }
    if base.same(op, "new") { return "nw" }
    if base.same(op, "delete") { return "dl" }
    if base.same(op, "new[]") { return "na" }
    if base.same(op, "delete[]") { return "da" }
    return base.join("v0", sourceName(op))
}

// The variant of the constructors and destructors named: 1 the
// complete-object one (`C1`, `D1`), 2 the base-object one (`C2`, `D2`,
// which a class with virtual bases has apart).
pub var structorVariant: u8 = 1

// One component of a name: an operator's code, a constructor's `C1`, a
// destructor's `D1`, else the source name.
fn emitUnqualified(text: []const u8, classText: []const u8) -> void {
    if text.length > 8 && base.same(text[0..8], "operator") {
        base.append(operatorName(text))
        return
    }
    if classText.length > 0 && base.same(text, classText) {
        base.append(if structorVariant == 2 { "C2" } else { "C1" })
        return
    }
    if text.length > 1 && text[0] == 126 {
        base.append(if structorVariant == 2 { "D2" } else { "D1" })
        return
    }
    emitSource(text)
}

// The code of a type.
pub fn typeCode(ty: usize) -> []const u8 {
    const mark = base.buildMark()
    emitType(ty)
    return base.keepBuilt(mark)
}

// The code of a type appended to the text being built.
pub fn emitType(ty: usize) -> void {
    if types.isConst(ty) {
        base.append("K")
        // (The type without const: through the origins of copies of const
        // types, `const` once. One whose origin is const again, or none,
        // is written as it is after the K, not read again for its const.)
        var plain = types.unqualified(ty)
        var steps: u32 = 0
        while types.isConst(plain) && types.unqualified(plain) != plain && steps < 64 {
            plain = types.unqualified(plain)
            steps += 1
        }
        emitTypePastConst(plain)
        return
    }
    emitTypePastConst(ty)
}

// emitType of `ty` past its const.
fn emitTypePastConst(ty: usize) -> void {
    const k = types.kind(ty)
    const u = types.isUnsigned(ty)
    if types.isMemberPointer(ty) {
        base.append("M")
        emitType(types.memberClassOf(ty))
        emitType(types.baseOf(ty))
        return
    }
    if k == types.WIDE {
        base.append(if u { "DU" } else { "DB" })
        base.appendDecimal(@intCast(u64, types.at(ty).*.bits))
        base.append("_")
        return
    }
    if k == types.PTR && !types.isNullptr(ty) {
        base.append("P")
        emitType(types.baseOf(ty))
        return
    }
    if k == types.REF {
        base.append(if types.at(ty).*.isRvalueRef { "O" } else { "R" })
        emitType(types.baseOf(ty))
        return
    }
    // An array (as a template argument, or behind a reference: a
    // parameter's own decays to a pointer before): `A6_Kc`.
    if k == types.ARRAY {
        base.append("A")
        const length = types.at(ty).*.arrayLength
        if length >= 0 { base.appendDecimal(@intCast(u64, length)) }
        base.append("_")
        emitType(types.baseOf(ty))
        return
    }
    if k == types.FUNC {
        base.append("F")
        emitType(types.baseOf(ty))
        emitParameters(ty)
        base.append("E")
        return
    }
    if k == types.TPARAM {
        if types.at(ty).*.arrayLength < 0 {
            base.append("T_")
            return
        }
        base.append("T")
        base.appendDecimal(@intCast(u64, types.at(ty).*.arrayLength))
        base.append("_")
        return
    }
    const simple = simpleCode(ty)
    if simple.length > 0 {
        base.append(simple)
        return
    }
    // A struct, union or enum: its qualified name.
    const name = types.at(ty).*.name
    if name == 0 {
        base.append("9anonymous")
        return
    }
    base.append(classCode(name))
}

// The code of the class, union or enum named `name`: its qualified
// name's components as a nested name, or the one name. Kept by name:
// every template instance's key spells its arguments' types, and
// splitting the same qualified names again was a tenth of a WebCore
// unit's time.
var classCodes = table.Table.{ .slots = 0, .capacity = 0, .count = 0 }

fn classCode(name: u32) -> []const u8 {
    const known = table.get(&classCodes, @intCast(usize, name))
    if known != 0 { return base.bytes(base.getWord(known), base.getWord(known + 8)) }
    const whole = base.nameOf(name)
    // (A closure in a function, or a class in one's: its local name.)
    const local = localPart(whole)
    const text = pastLocal(whole)
    var inner = false
    var index: usize = 0
    while index + 1 < text.length {
        if text[index] == 58 && text[index + 1] == 58 { inner = true }
        index += 1
    }
    const mark = base.buildMark()
    base.append(local)
    if inner {
        base.append("N")
        emitComponents(text)
        base.append("E")
    } else {
        emitComponent(text)
    }
    const code = base.keepBuilt(mark)
    const cell = base.alloc(16)
    base.putWord(cell, @intFromPtr(code.pointer))
    base.putWord(cell + 8, code.length)
    table.set(&classCodes, @intCast(usize, name), cell)
    return code
}

// The code of a scalar type (empty for the others).
fn simpleCode(ty: usize) -> []const u8 {
    const k = types.kind(ty)
    const u = types.isUnsigned(ty)
    if k == types.VOID { return "v" }
    if k == types.BOOL { return "b" }
    if types.at(ty).*.charKind == 1 { return "w" }
    if types.at(ty).*.charKind == 2 { return "Ds" }
    if types.at(ty).*.charKind == 3 { return "Di" }
    if types.at(ty).*.charKind == 4 { return "Du" }
    if k == types.CHAR {
        if types.at(ty).*.signedChar { return "a" }
        return if u { "h" } else { "c" }
    }
    if k == types.SHORT { return if u { "t" } else { "s" } }
    if k == types.INT { return if u { "j" } else { "i" } }
    if k == types.LONG {
        if types.at(ty).*.longLong { return if u { "y" } else { "x" } }
        return if u { "m" } else { "l" }
    }
    if k == types.FLOAT { return "f" }
    if k == types.DOUBLE { return "d" }
    if k == types.LDOUBLE { return "e" }
    if k == types.PTR && types.isNullptr(ty) { return "Dn" }
    return ""
}

// The parameter types' codes (`v` for none).
fn emitParameters(fnType: usize) -> void {
    var p = types.at(fnType).*.params
    if p == 0 {
        base.append("v")
        return
    }
    while p != 0 {
        // A parameter's own const is not part of the signature.
        emitType(types.unqualified(types.param(p).*.ty))
        p = types.param(p).*.next
    }
    if types.at(fnType).*.variadic { base.append("z") }
}

// The symbol of the function `name` declared in the namespace or class
// `prefix` (0: the global namespace) with type `fnType`; `classText`
// the class's own name when the function is its member (for the
// constructor's and destructor's names), empty otherwise.
// Whether the closure whose call operator is being declared is
// `mutable` (lambda.mlx): its operator() is no const member function.
pub var mutableClosure = false

pub fn functionSymbol(prefix: u32, name: u32, fnType: usize, classText: []const u8) -> u32 {
    const text = base.nameOf(name)
    const mark = base.buildMark()
    if prefix == 0 {
        base.append("_Z")
        emitUnqualified(text, classText)
    } else {
        // (A member of a closure in a function: the local name first,
        // `_ZZ7countervENKUlvE_clEv`.)
        base.append("_Z")
        base.append(localPart(base.nameOf(prefix)))
        // A const member function has `K` before the class (a closure's
        // operator() unless mutable).
        const closureCall = !mutableClosure && base.same(text, "operator()") && closureSeparator(lastComponent(base.nameOf(prefix))) != 0
        base.append(if types.at(fnType).*.constMethod || closureCall { "NK" } else { "N" })
        // (A ref-qualified one: `R` for `&`, `O` for `&&`.)
        if types.at(fnType).*.refQualifier == 1 { base.append("R") }
        if types.at(fnType).*.refQualifier == 2 { base.append("O") }
        emitComponents(pastLocal(base.nameOf(prefix)))
        emitUnqualified(text, classText)
        base.append("E")
    }
    emitParameters(fnType)
    return base.internBuilt(mark)
}

// The symbol of the instance of the function template `name` of the
// namespace `prefix` with the template arguments' codes `args` and the
// instance's type `fnType`: `_Z3maxIiEiRiRi` (g++ writes the result
// type and substitutions in: `_Z3maxIiET_RKS0_S2_`).
pub fn templateFunctionSymbol(prefix: u32, name: u32, args: []const u8, fnType: usize) -> u32 {
    const mark = base.buildMark()
    if prefix == 0 {
        base.append("_Z")
        emitSource(base.nameOf(name))
    } else {
        base.append("_Z")
        // (A member of a closure in a function: the local name first; a
        // generic lambda's call operator `cl`, `_ZZ7genericvENKUlT_E_clIiEEDaS_`
        // as g++ writes it but for the result and substitutions.)
        const local = localPart(base.nameOf(prefix))
        base.append(local)
        // (A const member function's: `_ZNK...`.)
        base.append(if types.at(fnType).*.constMethod { "NK" } else { "N" })
        // (A ref-qualified one: `R` for `&`, `O` for `&&`.)
        if types.at(fnType).*.refQualifier == 1 { base.append("R") }
        if types.at(fnType).*.refQualifier == 2 { base.append("O") }
        emitComponents(pastLocal(base.nameOf(prefix)))
        if closureSeparator(lastComponent(base.nameOf(prefix))) != 0 { emitUnqualified(base.nameOf(name), "") } else { emitSource(base.nameOf(name)) }
        base.append("E")
    }
    base.append("I")
    base.append(args)
    base.append("E")
    emitParameters(fnType)
    return base.internBuilt(mark)
}

// The last component of a qualified name.
fn lastComponent(qualified: []const u8) -> []const u8 {
    var start: usize = 0
    var index: usize = 0
    while index + 1 < qualified.length {
        if qualified[index] == 58 && qualified[index + 1] == 58 { start = index + 2 }
        index += 1
    }
    return qualified[start..qualified.length]
}

// The symbol of the variable `name` in the namespace or class `prefix`.
pub fn variableSymbol(prefix: u32, name: u32) -> u32 {
    if prefix == 0 { return name }
    const mark = base.buildMark()
    base.append("_ZN")
    emitComponents(base.nameOf(prefix))
    emitSource(base.nameOf(name))
    base.append("E")
    return base.internBuilt(mark)
}

// The symbol of the vtable of the class with the qualified name `prefix`.
pub fn vtableSymbol(prefix: u32) -> u32 {
    const text = base.nameOf(prefix)
    var inner = false
    var index: usize = 0
    while index + 1 < text.length {
        if text[index] == 58 && text[index + 1] == 58 { inner = true }
        index += 1
    }
    const mark = base.buildMark()
    if inner {
        base.append("_ZTVN")
        emitComponents(text)
        base.append("E")
    } else {
        base.append("_ZTV")
        emitSource(text)
    }
    return base.internBuilt(mark)
}
