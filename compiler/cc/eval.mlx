// Constant expressions (C11 6.6): integer constant expressions for array
// sizes, enum values, case labels, bit-field widths and #if-free static
// assertions, and the address constants of global initializers, which
// may name one object (its address plus a constant). Arithmetic wraps as
// it does at run time.
const base = @import("./base.mlx")
const ast = @import("./ast.mlx")
const types = @import("./types.mlx")
const typing = @import("./typing.mlx")
const standard = @import("./standard.mlx")
const program = @import("./program.mlx")
const expr = @import("./expr.mlx")
const interp = @import("./interp.mlx")
const gen = @import("./gen.mlx")
const cpp = @import("./cpp.mlx")
const template = @import("./template.mlx")

// The object an address constant names (0: none), set by the last
// evaluation that allowed one.
var target: usize = 0

pub fn constExpression() -> i64 {
    const n = expr.conditional()
    return evaluate(n)
}

// Whether `n` is an arithmetic constant expression that `evaluate` can
// fold (no address, nothing wide: those are computed when the program
// starts).
pub fn isConstant(n: usize) -> bool {
    typing.addType(n)
    const node = ast.node(n)
    const k = node.*.kind
    if k == ast.NUM { return true }
    if k == ast.CAST || k == ast.NEG || k == ast.BITNOT || k == ast.NOT || k == ast.BITCAST {
        if types.isWide(ast.typeOf(node.*.lhs)) { return false }
        return isConstant(node.*.lhs)
    }
    if k == ast.ADD || k == ast.SUB || k == ast.MUL || k == ast.DIV || k == ast.MOD || k == ast.BITAND || k == ast.BITOR || k == ast.BITXOR || k == ast.SHL || k == ast.SHR || k == ast.EQ || k == ast.NE || k == ast.LT || k == ast.LE || k == ast.LOGAND || k == ast.LOGOR || k == ast.COMMA {
        return isConstant(node.*.lhs) && isConstant(node.*.rhs)
    }
    if k == ast.COND { return isConstant(node.*.cond) && isConstant(node.*.then) && isConstant(node.*.els) }
    if k == ast.VAR { return constGlobal(node.*.variable) }
    if k == ast.DEREF && constElementArray(n) != 0 { return true }
    // A constexpr call returning a reference: the value it refers to.
    if k == ast.DEREF && interp.isReferenceCall(node.*.lhs) {
        // (Of an object that is no constant address, a constexpr local:
        // the whole read computed, `*info.category`.)
        if !argumentsConstant(node.*.lhs) && wholeExpression(n) { return interp.wholeValue(n).0 }
        return isConstant(node.*.lhs)
    }
    if k == ast.FUNCALL {
        // C++: a constexpr function called with constants.
        const constantArguments = argumentsConstant(n)
        if !constantArguments && wholeCall(n) { return interp.wholeValue(n).0 }
        if !interp.isConstantCall(n, constantArguments) { return false }
        return constantCall(n).0
    }
    if wholeExpression(n) { return interp.wholeValue(n).0 }
    // A float or double member of a constant object (`range.min <= 0`
    // in a constraint, `range` a class's static constexpr Range):
    // floatValue reads its bytes.
    if k == ast.MEMBER && (types.kind(ast.typeOf(n)) == types.DOUBLE || types.kind(ast.typeOf(n)) == types.FLOAT) && types.member(node.*.member).*.bitWidth == 0 { return literalMember(n).0 != 0 }
    return false
}

// Whether `n` is an integer member or element read (`f(a).x`,
// `c.items()[1]`, `kTable.size`) to be computed whole by interp.mlx.
fn wholeExpression(n: usize) -> bool {
    const k = ast.kindOf(n)
    if k != ast.MEMBER && k != ast.DEREF { return false }
    const ty = ast.typeOf(n)
    if !(types.isInteger(ty) || types.kind(ty) == types.BOOL) || types.isWide(ty) { return false }
    return true
}

// Whether the arguments of the call `n` are constants constantCall
// passes.
fn argumentsConstant(n: usize) -> bool {
    const node = ast.node(n)
    var constantArguments = true
    var a = node.*.args
    // An empty class's member function (a lambda without captures:
    // `[]{ ... }()`) does not read its object.
    if emptyThis(n) { a = ast.node(a).*.next }
    var formal = calleeParams(n)
    if emptyThis(n) && formal != 0 { formal = types.param(formal).*.next }
    while a != 0 && constantArguments {
        // (A string literal for `const char (&)[N]` is read through; a
        // constant for a `const T &` is passed as its value.)
        const byValue = formal != 0 && valueReference(types.param(formal).*.ty) && referencedConstant(a).0
        if !byValue && !isConstant(a) && interp.dataPointer(a) == 0 && functionDesignated(a) == 0 { constantArguments = false }
        if formal != 0 { formal = types.param(formal).*.next }
        a = ast.node(a).*.next
    }
    return constantArguments
}

// Whether the call `n` is of a constexpr function returning an integer,
// to be computed whole by interp.mlx (its arguments objects made there).
fn wholeCall(n: usize) -> bool {
    const callee = ast.node(n).*.lhs
    if ast.kindOf(callee) != ast.VAR { return false }
    const f = ast.obj(ast.node(callee).*.variable)
    // (A body that waits for a use is read for the computation.)
    if f.*.isFunction && f.*.isConstexpr && f.*.body == 0 && types.isInteger(ast.typeOf(n)) && !types.isWide(ast.typeOf(n)) { template.defineForEvaluation(ast.node(callee).*.variable) }
    return f.*.isFunction && f.*.isConstexpr && f.*.body != 0 && types.isInteger(ast.typeOf(n)) && !types.isWide(ast.typeOf(n))
}

// The call `n` of a constexpr function computed: whether it could be,
// and its value.
fn constantCall(n: usize) -> (bool, i64) {
    // (A call through a pointer, a virtual function's in a static local's
    // initializer: `theme().maxOverlap()`, nothing to compute.)
    const callee = ast.node(n).*.lhs
    if ast.kindOf(callee) != ast.VAR || !ast.obj(ast.node(callee).*.variable).*.isFunction { return -> (false, 0) }
    const mark = base.scratchMark()
    const values = base.scratch(64 * 8)
    var count: usize = 0
    var a = ast.node(n).*.args
    var formal = calleeParams(n)
    var byValue: u64 = 0
    if emptyThis(n) {
        base.putWord(values, 0)
        count += 1
        a = ast.node(a).*.next
        if formal != 0 { formal = types.param(formal).*.next }
    }
    while a != 0 && count < 64 {
        if formal != 0 && valueReference(types.param(formal).*.ty) && referencedConstant(a).0 {
            // A constant for a `const T &`: its value, read through the
            // reference (interp.mlx).
            base.putWord(values + count * 8, @bitCast(u64, referencedConstant(a).1))
            const bit: u64 = 1
            byValue = byValue | (bit << @intCast(u6, count))
        } else if functionDesignated(a) != 0 && !isConstant(a) {
            // A function (`parameterCount(Malloc::free)`): it stands for
            // itself, its object.
            base.putWord(values + count * 8, functionDesignated(a))
        } else {
            const data = interp.dataPointer(a)
            base.putWord(values + count * 8, @bitCast(u64, if data != 0 { data } else { argumentBits(a) }))
        }
        if formal != 0 { formal = types.param(formal).*.next }
        count += 1
        a = ast.node(a).*.next
    }
    const result = interp.call(n, values, count, byValue)
    base.releaseScratch(mark)
    return result
}

fn sameFunction(a: usize, b: usize) -> bool {
    if a == b { return true }
    return gen.linkNameOf(a) == gen.linkNameOf(b)
}

// The function the argument `a` names (`f`, `&f`, either converted to a
// pointer), 0 for none.
fn functionDesignated(a: usize) -> usize {
    var x = a
    while ast.kindOf(x) == ast.CAST || ast.kindOf(x) == ast.ADDR { x = ast.node(x).*.lhs }
    if ast.kindOf(x) != ast.VAR { return 0 }
    const o = ast.node(x).*.variable
    if !ast.obj(o).*.isFunction { return 0 }
    return o
}

// The static invoker of the lambda whose conversion to a function pointer
// the call `n` is (lambda.mlx makes both), 0 when it is no such call.
var conversionName: u32 = 0
var invokerName: u32 = 0

fn lambdaInvoker(n: usize) -> usize {
    const callee = ast.node(n).*.lhs
    if ast.kindOf(callee) != ast.VAR { return 0 }
    const f = ast.node(callee).*.variable
    if !ast.obj(f).*.isFunction || ast.obj(f).*.classType == 0 { return 0 }
    if conversionName == 0 {
        conversionName = base.intern("operator@__mlxcc_fp")
        invokerName = base.intern("__mlxcc_invoke")
    }
    if ast.obj(f).*.name != conversionName { return 0 }
    const invoker = cpp.memberOf(ast.obj(f).*.classType, invokerName)
    if invoker == 0 || !ast.obj(invoker).*.isFunction { return 0 }
    return invoker
}

// The parameters of the function the call `n` calls (0 for none known).
fn calleeParams(n: usize) -> usize {
    const callee = ast.node(n).*.lhs
    if ast.kindOf(callee) != ast.VAR { return 0 }
    return types.at(ast.obj(ast.node(callee).*.variable).*.ty).*.params
}

// Whether a parameter of type `ty` is a reference to an integer (given a
// constant's value).
fn valueReference(ty: usize) -> bool {
    if types.kind(ty) != types.REF { return false }
    const target = types.referenced(ty)
    const k = types.kind(target)
    return (types.isInteger(target) && !types.isWide(target)) || k == types.FLOAT || k == types.DOUBLE
}

// An argument's value for interp.mlx: a float's or double's bits, an
// integer's or address's value.
fn argumentBits(a: usize) -> i64 {
    typing.addType(a)
    const ty = ast.typeOf(a)
    if types.isFloat(ty) && types.kind(ty) != types.LDOUBLE { return floatBits(floatValue(a), ty) }
    return evaluate(a)
}

// The constant a reference argument refers to: `&x` of a constant x,
// or a temporary made of a constant (`(t = e, &t)`).

fn referencedConstant(a: usize) -> (bool, i64) {
    const k = ast.kindOf(a)
    if k == ast.ADDR {
        const inner = ast.node(a).*.lhs
        if isConstant(inner) { return -> (true, argumentBits(inner)) }
    }
    if k == ast.COMMA {
        const l = ast.node(a).*.lhs
        if ast.kindOf(l) == ast.ASSIGN && isConstant(ast.node(l).*.rhs) { return -> (true, argumentBits(ast.node(l).*.rhs)) }
    }
    if isConstant(a) { return -> (true, argumentBits(a)) }
    return -> (false, 0)
}

// Whether the call `n` is of a member function of an empty class (its
// first argument the object's address, never read).
fn emptyThis(n: usize) -> bool {
    const callee = ast.node(n).*.lhs
    if ast.kindOf(callee) != ast.VAR || ast.node(n).*.args == 0 { return false }
    const f = ast.obj(ast.node(callee).*.variable)
    return f.*.isFunction && f.*.classType != 0 && !f.*.isStaticMember && types.emptyClass(f.*.classType)
}

// C++: a const integer global with a constant initializer is a
// constant itself (`static const char LF = 10; char buffer[LF];`).
pub fn constGlobal(o: usize) -> bool {
    const obj = ast.obj(o)
    if obj.*.hasConstValue { return true }
    if obj.*.isLocal || obj.*.isFunction || obj.*.initData == 0 || obj.*.isTentative { return false }
    return types.isConst(obj.*.ty) && types.isInteger(obj.*.ty) && !types.isWide(obj.*.ty)
}

// A const floating-point global with its initial bytes written.
pub fn constFloating(o: usize) -> bool {
    const obj = ast.obj(o)
    // (A constexpr local: its value made at compile time.)
    if obj.*.isLocal && obj.*.constantImage != 0 { return true }
    if obj.*.isLocal || obj.*.isFunction || obj.*.initData == 0 || obj.*.isTentative { return false }
    return types.isConst(obj.*.ty) || obj.*.isConstexpr
}

// C++: an element of a const (or constexpr) integer array with its
// initial bytes written, at a constant index (`table[uint8_t(' ')]`):
// the array, 0 when `n` is no such element.
fn constElementArray(n: usize) -> usize {
    if !standard.cpp { return 0 }
    const ty = ast.typeOf(n)
    if !types.isInteger(ty) || types.isWide(ty) { return 0 }
    var at_ = ast.node(n).*.lhs
    var o: usize = 0
    // (The array decays to a pointer: a cast of it.)
    if ast.kindOf(at_) == ast.ADD {
        var array = ast.node(at_).*.lhs
        if ast.kindOf(array) == ast.CAST { array = ast.node(array).*.lhs }
        if ast.kindOf(array) != ast.VAR || !isConstant(ast.node(at_).*.rhs) { return 0 }
        o = ast.node(array).*.variable
    } else if ast.kindOf(at_) == ast.CAST && ast.kindOf(ast.node(at_).*.lhs) == ast.VAR {
        o = ast.node(ast.node(at_).*.lhs).*.variable
    } else if ast.kindOf(at_) == ast.VAR {
        o = ast.node(at_).*.variable
    } else {
        return 0
    }
    const obj = ast.obj(o)
    if obj.*.isLocal || obj.*.isFunction || obj.*.initData == 0 || obj.*.isTentative { return 0 }
    if types.kind(obj.*.ty) != types.ARRAY || program.hasLateInitializer(o) { return 0 }
    if !(types.isConst(types.baseOf(obj.*.ty)) || types.isConst(obj.*.ty) || obj.*.isConstexpr) { return 0 }
    if types.size(types.baseOf(obj.*.ty)) != types.size(ty) { return 0 }
    return o
}

// Its value, from the array's initial bytes.
fn constElementValue(n: usize) -> i64 {
    const o = constElementArray(n)
    const ty = ast.typeOf(n)
    const at_ = ast.node(n).*.lhs
    const offset = if ast.kindOf(at_) == ast.ADD { evaluate(ast.node(at_).*.rhs) } else { 0 }
    const size = types.size(ty)
    if offset < 0 || offset + size > types.size(ast.obj(o).*.ty) {
        notConstant(n)
        return 0
    }
    var bits: u64 = 0
    var index: i64 = size
    while index > 0 {
        index -= 1
        bits = (bits << 8) | @intCast(u64, base.get8(ast.obj(o).*.initData + @intCast(usize, offset + index)))
    }
    if types.isUnsigned(ty) || size >= 8 { return @bitCast(i64, bits) }
    const shift: u64 = 64 - @intCast(u64, size) * 8
    return @bitCast(i64, bits << shift) >> shift
}

// Its value, from its initial bytes.
pub fn constGlobalValue(o: usize) -> i64 {
    const obj = ast.obj(o)
    if obj.*.hasConstValue { return obj.*.constValue }
    const size = types.size(obj.*.ty)
    var bits: u64 = 0
    var index: i64 = size
    while index > 0 {
        index -= 1
        bits = (bits << 8) | @intCast(u64, base.get8(obj.*.initData + @intCast(usize, index)))
    }
    if types.isUnsigned(obj.*.ty) || size >= 8 { return @bitCast(i64, bits) }
    // Sign-extended.
    const shift: u64 = 64 - @intCast(u64, size) * 8
    return @bitCast(i64, bits << shift) >> shift
}

// An integer constant expression's value.
pub fn evaluate(n: usize) -> i64 {
    return value(n, false)
}

// An initializer's value: a number, or an object's address plus a
// number; the object (0 when none).
pub fn evaluateAddress(n: usize) -> (i64, usize) {
    target = 0
    const result = value(n, true)
    return -> (result, target)
}

// While `softFailures` is set, an expression that is no constant sets
// `failed` instead of ending the compilation (C++: a global is then
// initialized when the program starts).
pub var softFailures = false
pub var failed = false

fn notConstant(n: usize) -> void {
    if softFailures {
        failed = true
        return
    }
    if interp.trace { interp.dumpTree(n, 1, "not constant: ") }
    ast.errorAt(n, "not a compile-time constant")
}

fn truncated(v: i64, ty: usize) -> i64 {
    if !types.isInteger(ty) { return v }
    const bits = @bitCast(u64, v)
    if types.kind(ty) == types.BOOL { return if v != 0 { 1 } else { 0 } }
    // The value's low `w` bits, sign-extended for a signed type (a
    // _BitInt's width, else the size's).
    const w = types.width(ty)
    if w >= 64 { return v }
    const mask = (@intCast(u64, 1) << @intCast(u6, w)) - 1
    if types.isUnsigned(ty) { return @bitCast(i64, bits & mask) }
    const sign = @intCast(u64, 1) << @intCast(u6, w - 1)
    return @bitCast(i64, (bits & mask) ^ sign) -% @bitCast(i64, sign)
}

fn unsignedLess(a: i64, b: i64) -> bool { return @bitCast(u64, a) < @bitCast(u64, b) }

fn shiftAmount(v: i64) -> u6 { return @intCast(u6, @bitCast(u64, v) & 63) }

// The compound literal at file scope a member access reads from (its
// initial bytes made already) and the member's offset in it; 0 for none.
fn literalMember(n: usize) -> (usize, i64) {
    const k = ast.kindOf(n)
    if k == ast.MEMBER {
        const inner = literalMember(ast.node(n).*.lhs)
        if inner.0 == 0 { return -> (0, 0) }
        return -> (inner.0, inner.1 + types.member(ast.node(n).*.member).*.offset)
    }
    if k == ast.VAR {
        const o = ast.node(n).*.variable
        if ast.obj(o).*.name == 0 && !ast.obj(o).*.isLocal && !ast.obj(o).*.isLiteral && ast.obj(o).*.initData != 0 { return -> (o, 0) }
        // (C++: a constexpr global or static of class type, its bytes
        // made at compile time: `kSafeBounds.fRight` in a static_assert.)
        if standard.cpp && ast.obj(o).*.isConstexpr && !ast.obj(o).*.isLocal && !ast.obj(o).*.runtimeInit && !ast.obj(o).*.isLiteral && ast.obj(o).*.initData != 0 { return -> (o, 0) }
        // (A constexpr local of a class type: the image of its value,
        // `componentInfo.min == ...` in an `if constexpr`.)
        if standard.cpp && ast.obj(o).*.isLocal && ast.obj(o).*.constantImage != 0 && types.kind(ast.obj(o).*.ty) != types.FLOAT && types.kind(ast.obj(o).*.ty) != types.DOUBLE { return -> (ast.obj(o).*.constantImage, 0) }
    }
    return -> (0, 0)
}

// A float's or double's bits (a float's in the low 32), and back.
pub fn floatBits(f: f64, ty: usize) -> i64 {
    if types.kind(ty) == types.FLOAT { return @intCast(i64, @bitCast(u32, @floatCast(f32, f))) & 4294967295 }
    return @bitCast(i64, f)
}

pub fn floatFromBits(bits: i64, ty: usize) -> f64 {
    if types.kind(ty) == types.FLOAT { return @floatCast(f64, @bitCast(f32, @intCast(u32, @bitCast(u64, bits) & 4294967295))) }
    return @bitCast(f64, bits)
}

// The `size` bytes at `data` as a little-endian number.
fn readWord(data: usize, size: i64) -> u64 {
    var v: u64 = 0
    var index: i64 = size - 1
    while index >= 0 {
        v = (v << 8) | @intCast(u64, base.get8(data + @intCast(usize, index)))
        index -= 1
    }
    return v
}

// The `ty` at `offset` in the compound literal `o`: an address (its
// relocation's target and addend) or the bytes' number.
fn literalValue(o: usize, offset: i64, ty: usize) -> i64 {
    var r = ast.obj(o).*.relocations
    while r != 0 {
        if ast.relocation(r).*.offset == offset {
            target = ast.relocation(r).*.target
            return ast.relocation(r).*.addend
        }
        r = ast.relocation(r).*.next
    }
    return truncated(@bitCast(i64, readWord(ast.obj(o).*.initData + @intCast(usize, offset), types.size(ty))), ty)
}

fn value(n: usize, allowAddress: bool) -> i64 {
    typing.addType(n)
    const node = ast.node(n)
    const k = node.*.kind
    const ty = node.*.ty
    if types.isFloat(ty) {
        // An arithmetic constant of floating type converted to an
        // integer by a cast around it.
        const whole: i64 = @intFromFloat(i64, floatValue(n))
        return whole
    }
    if k == ast.NUM { return node.*.value }
    if k == ast.BITCAST {
        const from = ast.typeOf(node.*.lhs)
        if types.isFloat(from) { return truncated(floatBits(floatValue(node.*.lhs), from), ty) }
        return truncated(value(node.*.lhs, allowAddress), ty)
    }
    if k == ast.MEMBER && types.member(node.*.member).*.bitWidth == 0 && (types.isInteger(ty) || types.kind(ty) == types.PTR) {
        // GNU C: a member of a compound literal at file scope
        // (`(CONFIG).config_ptr`): the value its bytes hold.
        const place = literalMember(n)
        if place.0 != 0 { return literalValue(place.0, place.1, ty) }
    }
    if k == ast.VAR && constGlobal(node.*.variable) { return constGlobalValue(node.*.variable) }
    if k == ast.DEREF && constElementArray(n) != 0 { return constElementValue(n) }
    if k == ast.DEREF && interp.isReferenceCall(node.*.lhs) {
        if !argumentsConstant(node.*.lhs) && wholeExpression(n) {
            const whole = interp.wholeValue(n)
            if !whole.0 { notConstant(n) }
            return whole.1
        }
        const referenced = constantCall(node.*.lhs)
        if !referenced.0 { notConstant(n) }
        return truncated(referenced.1, ty)
    }
    if k == ast.FUNCALL && allowAddress {
        // A captureless lambda converted to a pointer to a function (in a
        // table of callbacks): the address of its static invoker.
        const invoker = lambdaInvoker(n)
        if invoker != 0 {
            target = invoker
            ast.obj(invoker).*.isReferenced = true
            return 0
        }
    }
    if k == ast.FUNCALL {
        const computed = if wholeCall(n) && !argumentsConstant(n) { interp.wholeValue(n) } else { constantCall(n) }
        if !computed.0 { notConstant(n) }
        return computed.1
    }
    if k == ast.ADD { return value(node.*.lhs, allowAddress) +% evaluate(node.*.rhs) }
    if k == ast.SUB {
        // Two addresses in one object differ by a number (`&a[3] - &a[1]`).
        const saved = target
        target = 0
        const left = value(node.*.lhs, true)
        const leftTarget = target
        target = 0
        const right = value(node.*.rhs, true)
        const rightTarget = target
        if rightTarget != 0 {
            if rightTarget != leftTarget { notConstant(n) }
            target = saved
        } else if leftTarget != 0 {
            if !allowAddress { notConstant(n) }
            target = leftTarget
        } else {
            target = saved
        }
        return left -% right
    }
    if k == ast.MUL { return evaluate(node.*.lhs) *% evaluate(node.*.rhs) }
    if k == ast.DIV || k == ast.MOD {
        const left = evaluate(node.*.lhs)
        const right = evaluate(node.*.rhs)
        if right == 0 { ast.errorAt(n, "division by zero") }
        if types.isUnsigned(ty) {
            const ul = @bitCast(u64, left)
            const ur = @bitCast(u64, right)
            return @bitCast(i64, if k == ast.DIV { ul / ur } else { ul % ur })
        }
        if right == -1 {
            return if k == ast.DIV { 0 -% left } else { 0 }
        }
        return if k == ast.DIV { left / right } else { left % right }
    }
    if k == ast.NEG { return 0 -% evaluate(node.*.lhs) }
    if k == ast.BITAND { return evaluate(node.*.lhs) & evaluate(node.*.rhs) }
    if k == ast.BITOR { return evaluate(node.*.lhs) | evaluate(node.*.rhs) }
    if k == ast.BITXOR { return evaluate(node.*.lhs) ^ evaluate(node.*.rhs) }
    if k == ast.SHL { return truncated(@bitCast(i64, @bitCast(u64, evaluate(node.*.lhs)) << shiftAmount(evaluate(node.*.rhs))), ty) }
    if k == ast.SHR {
        const left = evaluate(node.*.lhs)
        const amount = shiftAmount(evaluate(node.*.rhs))
        if types.isUnsigned(ty) { return @bitCast(i64, @bitCast(u64, left) >> amount) }
        return left >> amount
    }
    if (k == ast.EQ || k == ast.NE) && functionDesignated(node.*.lhs) != 0 && functionDesignated(node.*.rhs) != 0 {
        // Two functions' addresses (`Derived::destroy == Base::destroy`):
        // equal when they name one function.
        const same = sameFunction(functionDesignated(node.*.lhs), functionDesignated(node.*.rhs))
        return if same == (k == ast.EQ) { 1 } else { 0 }
    }
    if (k == ast.EQ || k == ast.NE || k == ast.LT || k == ast.LE) && (types.isFloat(ast.typeOf(node.*.lhs)) || types.isFloat(ast.typeOf(node.*.rhs))) {
        // Floating comparisons (`maxSafeInteger() < 1e+21`): as doubles.
        const fl = floatValue(node.*.lhs)
        const fr = floatValue(node.*.rhs)
        var holds = false
        if k == ast.EQ { holds = fl == fr }
        if k == ast.NE { holds = fl != fr }
        if k == ast.LT { holds = fl < fr }
        if k == ast.LE { holds = fl <= fr }
        return if holds { 1 } else { 0 }
    }
    if k == ast.EQ { return if evaluate(node.*.lhs) == evaluate(node.*.rhs) { 1 } else { 0 } }
    if k == ast.NE { return if evaluate(node.*.lhs) != evaluate(node.*.rhs) { 1 } else { 0 } }
    if k == ast.LT || k == ast.LE {
        const left = evaluate(node.*.lhs)
        const right = evaluate(node.*.rhs)
        const unsigned = types.isUnsigned(ast.typeOf(node.*.lhs))
        var less = if unsigned { unsignedLess(left, right) } else { left < right }
        if k == ast.LE { less = less || left == right }
        return if less { 1 } else { 0 }
    }
    if k == ast.COND {
        if evaluate(node.*.cond) != 0 { return value(node.*.then, allowAddress) }
        return value(node.*.els, allowAddress)
    }
    if k == ast.COMMA { return value(node.*.rhs, allowAddress) }
    if k == ast.NOT { return if evaluate(node.*.lhs) == 0 { 1 } else { 0 } }
    if k == ast.BITNOT { return truncated(~evaluate(node.*.lhs), ty) }
    if k == ast.LOGAND { return if evaluate(node.*.lhs) != 0 && evaluate(node.*.rhs) != 0 { 1 } else { 0 } }
    if k == ast.LOGOR { return if evaluate(node.*.lhs) != 0 || evaluate(node.*.rhs) != 0 { 1 } else { 0 } }
    if k == ast.CAST {
        const inner = node.*.lhs
        if types.isFloat(ast.typeOf(inner)) && types.isInteger(ty) {
            const whole: i64 = @intFromFloat(i64, floatValue(inner))
            return truncated(whole, ty)
        }
        return truncated(value(inner, allowAddress), ty)
    }
    if k == ast.ADDR { return addressOf(node.*.lhs, allowAddress) }
    if (k == ast.MEMBER || k == ast.DEREF) && !allowAddress && wholeExpression(n) {
        const computed = interp.wholeValue(n)
        if computed.0 { return truncated(computed.1, ty) }
    }
    if k == ast.MEMBER {
        // An array member decays to its address.
        if !allowAddress || types.kind(ty) != types.ARRAY { notConstant(n) }
        if types.member(node.*.member).*.isVirtual { notConstant(n) }
        return addressOf(node.*.lhs, true) +% types.member(node.*.member).*.offset
    }
    if k == ast.DEREF {
        // `*&x` or an array element that decays: still an address.
        if allowAddress && types.kind(ty) == types.ARRAY { return value(node.*.lhs, true) }
        notConstant(n)
    }
    if k == ast.LABEL_ADDR {
        // `&&label` in a static's initializer: an object standing for
        // the place in the code (program.mlx relocates against it).
        if !allowAddress { notConstant(n) }
        const o = base.alloc(@sizeOf(ast.Obj))
        ast.obj(o).*.name = node.*.name
        ast.obj(o).*.ty = node.*.ty
        ast.obj(o).*.labelAddress = n
        target = o
        return 0
    }
    if k == ast.VAR {
        const o = node.*.variable
        if !allowAddress { notConstant(n) }
        const vk = types.kind(ast.obj(o).*.ty)
        if vk != types.ARRAY && vk != types.FUNC { notConstant(n) }
        if ast.obj(o).*.isLocal { notConstant(n) }
        target = o
        return 0
    }
    notConstant(n)
    return 0
}

// The address of the lvalue `n` as an offset from the object it is in.
fn addressOf(n: usize, allowAddress: bool) -> i64 {
    if !allowAddress { notConstant(n) }
    const node = ast.node(n)
    const k = node.*.kind
    if k == ast.VAR {
        if ast.obj(node.*.variable).*.isLocal { notConstant(n) }
        target = node.*.variable
        return 0
    }
    if k == ast.DEREF { return value(node.*.lhs, true) }
    // (A virtual base: its offset is the vtable's, read when the program
    // runs.)
    if k == ast.MEMBER && types.member(node.*.member).*.isVirtual { notConstant(n) }
    if k == ast.MEMBER { return addressOf(node.*.lhs, true) +% types.member(node.*.member).*.offset }
    if k == ast.COMMA { return addressOf(node.*.rhs, true) }
    notConstant(n)
    return 0
}

// A floating constant expression's value.
pub fn floatValue(n: usize) -> f64 {
    typing.addType(n)
    const node = ast.node(n)
    const k = node.*.kind
    const ty = node.*.ty
    if types.isInteger(ty) || types.kind(ty) == types.PTR {
        if types.isUnsigned(ty) && evaluate(n) < 0 {
            // Above 2^63: halve, convert, double (keeping the low bit).
            const bits = @bitCast(u64, evaluate(n))
            const half = @floatFromInt(f64, @bitCast(i64, (bits >> 1) | (bits & 1)))
            return half * 2.0
        }
        return @floatFromInt(f64, evaluate(n))
    }
    if k == ast.NUM {
        const bits = @bitCast(u64, node.*.value)
        return @bitCast(f64, bits)
    }
    if k == ast.ADD { return floatValue(node.*.lhs) + floatValue(node.*.rhs) }
    if k == ast.SUB { return floatValue(node.*.lhs) - floatValue(node.*.rhs) }
    if k == ast.MUL { return floatValue(node.*.lhs) * floatValue(node.*.rhs) }
    if k == ast.DIV { return floatValue(node.*.lhs) / floatValue(node.*.rhs) }
    if k == ast.NEG { return @bitCast(f64, @bitCast(u64, floatValue(node.*.lhs)) ^ (@intCast(u64, 1) << 63)) }
    if k == ast.COND {
        if evaluate(node.*.cond) != 0 { return floatValue(node.*.then) }
        return floatValue(node.*.els)
    }
    if k == ast.COMMA { return floatValue(node.*.rhs) }
    if k == ast.BITCAST { return floatFromBits(evaluate(node.*.lhs), ty) }
    if k == ast.FUNCALL && types.kind(ty) != types.LDOUBLE {
        // A constexpr function's float or double result (its bits).
        const computed = constantCall(n)
        if !computed.0 { notConstant(n) }
        return floatFromBits(computed.1, ty)
    }
    if k == ast.MEMBER && (types.kind(ty) == types.DOUBLE || types.kind(ty) == types.FLOAT) {
        // A member of a compound literal at file scope: its bytes.
        const place = literalMember(n)
        if place.0 != 0 {
            const data = ast.obj(place.0).*.initData + @intCast(usize, place.1)
            if types.kind(ty) == types.FLOAT { return @floatCast(f64, @bitCast(f32, @intCast(u32, readWord(data, 4)))) }
            return @bitCast(f64, readWord(data, 8))
        }
    }
    if k == ast.VAR && constFloating(node.*.variable) && (types.kind(ty) == types.DOUBLE || types.kind(ty) == types.FLOAT) {
        // A constant global (`std::numbers::pi`): its initial bytes.
        var data = ast.obj(node.*.variable).*.initData
        if ast.obj(node.*.variable).*.isLocal { data = ast.obj(ast.obj(node.*.variable).*.constantImage).*.initData }
        const size: usize = if types.kind(ty) == types.FLOAT { 4 } else { 8 }
        var bits: u64 = 0
        var index: usize = size
        while index > 0 {
            index -= 1
            bits = (bits << 8) | @intCast(u64, base.get8(data + index))
        }
        if size == 4 { return @floatCast(f64, @bitCast(f32, @intCast(u32, bits))) }
        return @bitCast(f64, bits)
    }
    if k == ast.CAST {
        const inner = ast.node(n).*.lhs
        const result = floatValue(inner)
        if types.kind(ty) == types.FLOAT { return @floatCast(f64, @floatCast(f32, result)) }
        return result
    }
    notConstant(n)
    return 0.0
}

// --- prefix snapshot state (tools/cc_snapshot_state.py writes this) ---
pub fn keepState() -> void {
    base.keepState(@intFromPtr(&target), @sizeOf(@typeOf(target)))
    base.keepState(@intFromPtr(&conversionName), @sizeOf(@typeOf(conversionName)))
    base.keepState(@intFromPtr(&invokerName), @sizeOf(@typeOf(invokerName)))
    base.keepState(@intFromPtr(&softFailures), @sizeOf(@typeOf(softFailures)))
    base.keepState(@intFromPtr(&failed), @sizeOf(@typeOf(failed)))
}
// --- end of prefix snapshot state ---
