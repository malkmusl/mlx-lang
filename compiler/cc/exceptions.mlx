// C++ exceptions (-fexceptions): every try, catch and throw of a unit
// written as C++ over <__mlxcc_exception>, which -fexceptions includes
// before the unit, once the unit's tokens are read (after
// literal.convert, before the parser). The header says what each
// becomes; in short, a try is a frame and a _setjmp, a handler an if on
// the exception's type, a throw a call that jumps to the innermost
// frame. The type of an exception and of a handler is told by
// __mlxcc_exception_type(T) (typeText below), the builtin that writes
// the codes of T and of its bases, with their offsets, as a string.
//
// The objects with destructors that an exception passes are destroyed
// on its way (cpp.localObject puts each local on the thread's list when
// it is made, cpp.destroyAbove takes it off when it is destroyed: see
// registers and unregister below). Without -fexceptions nothing here
// runs: try and throw are refused by the parser as before.
const base = @import("./base.mlx")
const names = @import("./names.mlx")
const tokens = @import("./tokens.mlx")
const types = @import("./types.mlx")
const mangle = @import("./mangle.mlx")
const cpp = @import("./cpp.mlx")

// Whether -fexceptions was given.
pub var enabled = false

// The number the names of the next try's locals carry.
var count: u64 = 0

// The tokens of TEXT (C++ the rewrite writes), placed where `at` is for
// messages: the first and the last, the EOF after it dropped.
fn piece(text: []const u8, at: usize) -> (usize, usize) {
    const list = cpp.generatedTokens(text)
    var t = list
    var last: usize = 0
    while !tokens.isEof(t) {
        tokens.at(t).*.file = tokens.at(at).*.file
        tokens.at(t).*.line = tokens.at(at).*.line
        last = t
        t = tokens.next(t)
    }
    if last == 0 { return (0, 0) }
    return (list, last)
}

// `first ... last`, copies of the tokens from `first` to `last`: the
// first and the last copy.
fn copies(first: usize, last: usize) -> (usize, usize) {
    var head: usize = 0
    var tail: usize = 0
    var t = first
    while true {
        const c = tokens.copy(t)
        if head == 0 { head = c } else { tokens.at(tail).*.next = c }
        tail = c
        if t == last { break }
        t = tokens.next(t)
    }
    return (head, tail)
}

fn isPunct(t: usize, id: u32) -> bool {
    return (tokens.kind(t) == tokens.PUNCT || tokens.kind(t) == tokens.KEYWORD) && tokens.name(t) == id
}

// The `}` that closes the `{` at `open`.
fn closing(open: usize) -> usize {
    var depth: i64 = 0
    var t = open
    while !tokens.isEof(t) {
        if isPunct(t, names.P_LBRACE) { depth += 1 }
        if isPunct(t, names.P_RBRACE) {
            depth -= 1
            if depth == 0 { return t }
        }
        t = tokens.next(t)
    }
    tokens.errorAt(open, "this block of a try or a handler has no end")
    return 0
}

// The `)` that closes the `(` at `open`.
fn closingParen(open: usize) -> usize {
    var depth: i64 = 0
    var t = open
    while !tokens.isEof(t) {
        if isPunct(t, names.P_LPAREN) { depth += 1 }
        if isPunct(t, names.P_RPAREN) {
            depth -= 1
            if depth == 0 { return t }
        }
        t = tokens.next(t)
    }
    tokens.errorAt(open, "a handler's parameter has no ')'")
    return 0
}

// Links `a`'s last token to `b`'s first: the end of the joined run.
fn link(tail: usize, first: usize) -> void { tokens.at(tail).*.next = first }

// Every try, catch and throw of the list (its head is the first token,
// never a try or throw: the unit starts with the header's tokens).
pub fn rewrite(list: usize) -> void {
    var previous: usize = 0
    var t = list
    while !tokens.isEof(t) {
        if tokens.kind(t) == tokens.KEYWORD && tokens.name(t) == names.K_TRY {
            if previous == 0 { tokens.errorAt(t, "a try before anything else") }
            previous = rewriteTry(previous, t)
            t = tokens.next(previous)
            continue
        }
        if tokens.kind(t) == tokens.KEYWORD && tokens.name(t) == names.K_THROW {
            if previous == 0 { tokens.errorAt(t, "a throw before anything else") }
            previous = rewriteThrow(previous, t)
            t = tokens.next(previous)
            continue
        }
        if tokens.kind(t) == tokens.KEYWORD && tokens.name(t) == names.K_CATCH {
            tokens.errorAt(t, "a handler without its try")
        }
        previous = t
        t = tokens.next(t)
    }
}

// `try { BODY } catch (...) { ... } ...` after `previous`: written over
// the header's frame and handling; the token the walk goes on after
// (`previous` itself: the frame's tokens and BODY, whose own try and
// throw are written next, follow it).
fn rewriteTry(previous: usize, at: usize) -> usize {
    count += 1
    const n = base.decimal(count)
    const bodyOpen = tokens.next(at)
    var tail = previous
    // (A constructor's function-try-block, `try : a(1) { ... }`, is not
    // written: what its member initializers throw would need a frame
    // around them.)
    if isPunct(bodyOpen, names.P_COLON) { tokens.errorAt(at, "a constructor's try around its member initializers is not supported") }
    if !isPunct(bodyOpen, names.P_LBRACE) { tokens.errorAt(at, "a try is followed by its block") }
    const bodyClose = closing(bodyOpen)
    const head = piece(base.join(base.join(base.join(base.join(base.join(base.join(base.join("{ ::__mlxcc_eh::try_frame __mlxcc_try", n), "; int __mlxcc_jump"), n), base.join("; __mlxcc_jump", n)), base.join(" = _setjmp(__mlxcc_try", n)), base.join(".jump); if (__mlxcc_jump", n)), " == 0)"), at)
    link(tail, head.0)
    link(head.1, bodyOpen)
    tail = bodyClose
    var handler = tokens.next(bodyClose)
    const open = piece(base.join(base.join(base.join("else { ::__mlxcc_eh::handling __mlxcc_caught", n), "; void *__mlxcc_seen"), base.join(n, ";")), at)
    link(tail, open.0)
    tail = open.1
    if !(tokens.kind(handler) == tokens.KEYWORD && tokens.name(handler) == names.K_CATCH) { tokens.errorAt(at, "a try without a handler") }
    var first = true
    while tokens.kind(handler) == tokens.KEYWORD && tokens.name(handler) == names.K_CATCH {
        const lparen = tokens.next(handler)
        if !isPunct(lparen, names.P_LPAREN) { tokens.errorAt(handler, "a handler names what it takes in ()") }
        const rparen = closingParen(lparen)
        const blockOpen = tokens.next(rparen)
        if !isPunct(blockOpen, names.P_LBRACE) { tokens.errorAt(handler, "a handler is followed by its block") }
        const blockClose = closing(blockOpen)
        const after = tokens.next(blockClose)
        if !first {
            const e = piece("else", at)
            link(tail, e.0)
            tail = e.1
        }
        first = false
        const paramFirst = tokens.next(lparen)
        if isPunct(paramFirst, names.P_ELLIPSIS) && tokens.next(paramFirst) == rparen {
            // catch (...): any exception.
            const all = piece("if (1)", at)
            link(tail, all.0)
            link(all.1, blockOpen)
            tail = blockClose
        } else {
            if paramFirst == rparen { tokens.errorAt(handler, "a handler takes a type or ...") }
            // The parameter: its type, and its name when it has one (a
            // last identifier after a type that is more than const and
            // volatile, not after ::).
            var paramLast = paramFirst
            var beforeLast: usize = 0
            while tokens.next(paramLast) != rparen {
                beforeLast = paramLast
                paramLast = tokens.next(paramLast)
            }
            var typeLast = paramLast
            var nameToken: usize = 0
            if tokens.kind(paramLast) == tokens.IDENT && beforeLast != 0 && !isPunct(beforeLast, names.P_SCOPE) {
                var more = false
                var u = paramFirst
                while u != paramLast {
                    if !(isPunct(u, names.K_CONST) || isPunct(u, names.K_VOLATILE)) { more = true }
                    u = tokens.next(u)
                }
                if more {
                    nameToken = paramLast
                    typeLast = beforeLast
                }
            }
            const asking = piece(base.join(base.join("if ((__mlxcc_seen", n), " = __mlxcc_eh_adjusted(__mlxcc_exception_type("), at)
            link(tail, asking.0)
            const asked = copies(paramFirst, typeLast)
            link(asking.1, asked.0)
            const tested = piece(") )) != 0) {", at)
            link(asked.1, tested.0)
            tail = tested.1
            if nameToken != 0 {
                // `T x = __mlxcc_eh::ref_of<T>::get(__mlxcc_seenN);`
                const declared = copies(paramFirst, typeLast)
                link(tail, declared.0)
                tokens.at(nameToken).*.next = 0
                link(declared.1, nameToken)
                const getter = piece("= ::__mlxcc_eh::ref_of<", at)
                link(nameToken, getter.0)
                const referred = copies(paramFirst, typeLast)
                link(getter.1, referred.0)
                const got = piece(base.join(base.join(">::get(__mlxcc_seen", n), ");"), at)
                link(referred.1, got.0)
                tail = got.1
            }
            link(tail, blockOpen)
            const shut = piece("}", at)
            link(blockClose, shut.0)
            tail = shut.1
        }
        handler = after
    }
    const end = piece("else __mlxcc_eh_unmatched(); } }", at)
    link(tail, end.0)
    link(end.1, handler)
    return previous
}

// `throw E` (to `__mlxcc_eh::raise(E)`), `throw;` (to
// `__mlxcc_eh_rethrow()`) and `throw()` in a declaration (to
// `noexcept`) after `previous`: the token the walk goes on after.
fn rewriteThrow(previous: usize, at: usize) -> usize {
    const next = tokens.next(at)
    if isPunct(next, names.P_SEMI) {
        const again = piece("__mlxcc_eh_rethrow()", at)
        link(previous, again.0)
        link(again.1, next)
        return again.1
    }
    if isPunct(next, names.P_LPAREN) && isPunct(tokens.next(next), names.P_RPAREN) {
        const none = piece("noexcept", at)
        link(previous, none.0)
        link(none.1, tokens.next(tokens.next(next)))
        return none.1
    }
    // The operand: up to a `;`, `,`, `)`, `]`, `}` or `:` outside its
    // brackets (a `,` inside a template's <> and a `:` of its own ?:
    // belong to it).
    var depth: i64 = 0
    var angles: i64 = 0
    var questions: i64 = 0
    var last = at
    var u = next
    while !tokens.isEof(u) {
        if depth == 0 {
            if isPunct(u, names.P_SEMI) || isPunct(u, names.P_RPAREN) || isPunct(u, names.P_RBRACKET) || isPunct(u, names.P_RBRACE) { break }
            if isPunct(u, names.P_COMMA) && angles == 0 { break }
            if isPunct(u, names.P_COLON) {
                if questions == 0 { break }
                questions -= 1
            }
            if isPunct(u, names.P_QUESTION) { questions += 1 }
            if isPunct(u, names.P_LT) && tokens.kind(last) == tokens.IDENT { angles += 1 }
            if isPunct(u, names.P_GT) && angles > 0 { angles -= 1 }
        }
        if isPunct(u, names.P_LPAREN) || isPunct(u, names.P_LBRACKET) || isPunct(u, names.P_LBRACE) { depth += 1 }
        if isPunct(u, names.P_RPAREN) || isPunct(u, names.P_RBRACKET) || isPunct(u, names.P_RBRACE) { depth -= 1 }
        last = u
        u = tokens.next(u)
    }
    if last == at { tokens.errorAt(at, "a throw of nothing but ;") }
    const call = piece("::__mlxcc_eh::raise(", at)
    link(previous, call.0)
    link(call.1, next)
    const shut = piece(")", at)
    link(last, shut.0)
    link(shut.1, u)
    return call.1
}

// ---------------------------------------------------------------------------
// The type of an exception

// What __mlxcc_exception_type(T) writes of T (without a reference, const
// or volatile): its spelling, `|`, then its code and, for a class, the
// code of every base that is not virtual, with the offset where it is in
// T, each `code@offset` and a space between (the run-time library,
// compiler/libcpp/exception.cpp, reads it).
pub fn typeText(given: usize) -> []const u8 {
    var ty = types.unqualified(types.referenced(given))
    if cpp.isClassType(ty) { const ignored = cpp.completeIfNeeded(ty) }
    const mark = base.buildMark()
    base.append(clean(mangle.spelling(ty)))
    base.append("|")
    appendCodes(ty, 0, true)
    return base.keepBuilt(mark)
}

// A spelling fit for a string literal (no quote or backslash in it).
fn clean(text: []const u8) -> []const u8 {
    const mark = base.buildMark()
    var index: usize = 0
    while index < text.length {
        const c = text[index]
        if c != 34 && c != 92 { base.append(text[index..index + 1]) }
        index += 1
    }
    return base.keepBuilt(mark)
}

fn appendCodes(ty: usize, offset: i64, firstOne: bool) -> void {
    if !firstOne { base.append(" ") }
    base.append(mangle.typeCode(ty))
    base.append("@")
    base.append(base.decimal(@intCast(u64, offset)))
    if !cpp.isClassType(ty) { return }
    var m = types.at(ty).*.members
    while m != 0 {
        const member = types.member(m)
        if member.*.isBase && !member.*.isVirtual { appendCodes(types.unqualified(member.*.ty), offset + member.*.offset, false) }
        m = member.*.next
    }
}

// --- prefix snapshot state (tools/cc_snapshot_state.py writes this) ---
pub fn keepState() -> void {
    base.keepState(@intFromPtr(&enabled), @sizeOf(@typeOf(enabled)))
    base.keepState(@intFromPtr(&count), @sizeOf(@typeOf(count)))
}
// --- end of prefix snapshot state ---
