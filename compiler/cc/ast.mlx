// The syntax tree: nodes for expressions and statements, objects for
// variables and functions, and the relocations of global initializers
// (an address a global holds). They live in the arena and are known by
// their address.
const base = @import("./base.mlx")
const tokens = @import("./tokens.mlx")

// Node kinds.
pub const ADD: u8 = 1
pub const SUB: u8 = 2
pub const MUL: u8 = 3
pub const DIV: u8 = 4
pub const MOD: u8 = 5
pub const BITAND: u8 = 6
pub const BITOR: u8 = 7
pub const BITXOR: u8 = 8
pub const SHL: u8 = 9
pub const SHR: u8 = 10
pub const EQ: u8 = 11
pub const NE: u8 = 12
pub const LT: u8 = 13
pub const LE: u8 = 14
pub const ASSIGN: u8 = 15
pub const COND: u8 = 16
pub const COMMA: u8 = 17
pub const MEMBER: u8 = 18
pub const ADDR: u8 = 19
pub const DEREF: u8 = 20
pub const NOT: u8 = 21
pub const BITNOT: u8 = 22
pub const LOGAND: u8 = 23
pub const LOGOR: u8 = 24
pub const RETURN: u8 = 25
pub const IF: u8 = 26
pub const FOR: u8 = 27
pub const DO: u8 = 28
pub const SWITCH: u8 = 29
pub const CASE: u8 = 30
pub const BLOCK: u8 = 31
pub const GOTO: u8 = 32
pub const LABEL: u8 = 33
pub const FUNCALL: u8 = 34
pub const EXPR_STMT: u8 = 35
pub const STMT_EXPR: u8 = 36
pub const VAR: u8 = 37
pub const NUM: u8 = 38
pub const CAST: u8 = 39
pub const MEMZERO: u8 = 40
pub const NULL_EXPR: u8 = 41
pub const NEG: u8 = 42
// A jump to a loop's or switch's own label (break, continue).
pub const JUMP: u8 = 43
pub const VA_START: u8 = 44
pub const VA_ARG: u8 = 45
pub const VA_COPY: u8 = 46
// An atomic builtin (atomics.mlx): value the operation, lhs the address,
// rhs the operand, cond the expected value's address (compare-exchange),
// high 1 for the value after the operation.
pub const ATOMIC: u8 = 47
// An asm statement (builtins.mlx): value the instruction.
pub const ASM: u8 = 48
// A bit builtin (builtins.mlx): value the operation, high the width in
// bits, lhs the operand (unsigned, of that width).
pub const BITOP: u8 = 49
// C++: a braced list given as a function's argument (`f({a, b})`):
// value its `{` token; replaced by the parameter's type made from it
// once the function is chosen (cpp.bracedArgument).
pub const BRACED: u8 = 50
// C++: a member function's default argument read when a call needs it
// (it may name members declared after the function): `value` its first
// token, `high` the prefix it is read under.
pub const DEFAULT_ARG: u8 = 51
// GNU C's `&&label`: the label's address (`name` the label, `label` its
// number once the function's gotos are resolved).
pub const LABEL_ADDR: u8 = 52
// `__builtin_bit_cast(T, x)` of scalars of one size: x's bits as a T
// (`lhs` x; `ty` T).
pub const BITCAST: u8 = 53

pub const Node = struct {
    kind: u8
    // C++: an object named through an rvalue reference (`static_cast<T &&>(x)`,
    // `std::move(x)`): an rvalue to overloads, though addressable.
    xvalue: bool
    // The name of a GOTO or LABEL; a function call's callee name.
    name: u32
    ty: usize
    token: usize
    next: usize
    lhs: usize
    rhs: usize
    // if, for, while, do, ?:
    cond: usize
    then: usize
    els: usize
    init: usize
    inc: usize
    // A block's or statement expression's statements; a loop's body.
    body: usize
    // A member access's member.
    member: usize
    // A function call's type and arguments.
    funcType: usize
    args: usize
    // A variable.
    variable: usize
    // A number; a case's low and high values.
    value: i64
    high: i64
    // Labels: a loop's or switch's break and continue labels, a case's
    // label, a jump's target.
    breakLabel: u32
    continueLabel: u32
    label: u32
    // A switch's cases (linked through caseNext) and default.
    cases: usize
    caseNext: usize
    defaultCase: usize
    // A call argument passed on the stack (at stackOffset from the stack
    // pointer at the call); a call's buffer for a struct it returns in
    // memory.
    passByStack: bool
    stackOffset: i64
    returnBuffer: usize
    // A long double constant's 16 bytes (extended.mlx).
    extra: usize
}

pub const Obj = struct {
    name: u32
    // The symbol it has in the program (a static's name made unique).
    symbol: u32
    ty: usize
    token: usize
    next: usize
    isLocal: bool
    isFunction: bool
    isDefinition: bool
    isStatic: bool
    isExtern: bool
    isTentative: bool
    isInline: bool
    // C++: a constexpr function (computed by interp.mlx when called
    // with constants in a constant expression).
    isConstexpr: bool
    // A local's place below the frame pointer.
    offset: i64
    alignment: i64
    // A global's initial bytes and the addresses in them.
    initData: usize
    relocations: usize
    // A function's parameters and locals (Obj lists), body, frame size,
    // and the register save area of a variadic one.
    params: usize
    locals: usize
    body: usize
    stackSize: i64
    vaArea: usize
    // A string literal's object; a static local (its symbol is made
    // unique); the file a static belongs to.
    isLiteral: bool
    file: u32
    // Where code generation put it: a global's offset in the data area,
    // a function's or global's resolved definition (the one object of the
    // program its name stands for).
    placed: bool
    dataOffset: usize
    definition: usize
    // Whether the program refers to it (an unused static function is
    // left out).
    isReferenced: bool
    // A weak definition (the wide integer runtime, compiled into every
    // object that needs it: one copy is linked).
    isWeak: bool
    // `_Thread_local`, `thread_local`, `__thread`: one per thread, in the
    // TLS image at `dataOffset` (placed) and reached from the thread
    // pointer.
    isThreadLocal: bool
    // Its symbol in the object being built, plus one (0: none).
    objectSymbol: usize
    // C++: the name the linker sees (mangled; 0: the plain name), the
    // next function of the same name with other parameters, and whether
    // the function has C linkage (extern "C").
    linkName: u32
    nextOverload: usize
    externC: bool
    // C++ classes (cpp.mlx): a member function's class (0: a free
    // function), a static member function (no `this`), a constructor, a
    // destructor, a virtual function and its slot in the vtable; a
    // temporary object that is moved into another object and so not
    // destroyed at the end of its expression.
    classType: usize
    isStaticMember: bool
    isConstructor: bool
    isDestructor: bool
    isVirtual: bool
    isPure: bool
    // C++: an `explicit` constructor or conversion operator (no implicit
    // conversion goes through it).
    isExplicit: bool
    slot: i64
    noDestroy: bool
    // C++: the object `T{...}` or `T(args)` made (an rvalue).
    isMadeTemporary: bool
    // A function whose address is taken (`&dispatch<Is>...`): its body
    // is made even when nothing calls it here.
    addressTaken: bool
    // C++: a local whose place is not in the frame but at the address
    // the local `storedAt` holds (`return T(args);` made right in the
    // caller's result buffer).
    storedAt: usize
    // Such a temporary made by a constructor call (`T(args)`): the
    // arguments and their number, a cell (an object of the class
    // initialized from it is made from them instead: no copy).
    madeFrom: usize
    // C++: a global some of whose bytes are made when the program starts
    // (its initial bytes are not its value).
    runtimeInit: bool
    // A function template named in a call (template.mlx's record): the
    // instance is chosen by the arguments, after the template arguments
    // given explicitly (`f<int>(x)`; cells as template.parseArguments
    // makes them, 0 for none).
    template: usize
    templateArgs: usize
    // A member function of a class template's instance whose body is
    // read only when it is first called: the body's first token and the
    // class (template.ensureDefined).
    pendingBody: usize
    pendingClass: usize
    // C++: a const integer local with a constant initializer is a
    // constant itself (`const int n = 10; char buffer[n];`).
    hasConstValue: bool
    constValue: i64
    // The `&&label` (LABEL_ADDR node) a static's initializer holds: the
    // object stands for the place in the code.
    labelAddress: usize
    // C++: a base's member function brought among a class's overloads of
    // its name by `using Base::f;`: that function (chosen, it is called).
    usingOf: usize
    // C++: a function given to a `template <auto fn>` parameter (its
    // alias): `decltype(fn)` is a pointer to the function.
    asPointer: bool
    // C++: a constexpr local of a class type whose value is known at
    // compile time: an object (not in the program) holding it, which
    // the constant evaluator reads while the function is not running.
    constantImage: usize
    // C++: the constructor or destructor of a class with virtual bases
    // (its base-object variant, C2 or D2) and its complete-object entry
    // (C1 or D1), which jumps to it: the entry's `entryOf` is the
    // function and `entryKind` says what it does first (1: a
    // constructor's, zeroing the object's first word, where the
    // function reads its VTT; 2: a destructor's, zeroing the VTT
    // argument).
    entry: usize
    entryOf: usize
    entryKind: u8
    // C++: a vtable's address point (the offset in it a vtable pointer
    // holds the address of: past the words before the offset to the top).
    addressPoint: i64
    // C++: a vtable or VTT, left out of the object when nothing refers to
    // it (program.markTables).
    isTable: bool
}

// An address in a global's initial bytes: `offset` holds the address of
// the object `target` (an Obj) plus `addend`.
pub const Relocation = struct {
    offset: i64
    target: usize
    addend: i64
    next: usize
}

pub fn node(address: usize) -> *Node {
    unsafe { return @ptrFromInt(*Node, address) }
}

pub fn obj(address: usize) -> *Obj {
    unsafe { return @ptrFromInt(*Obj, address) }
}

pub fn relocation(address: usize) -> *Relocation {
    unsafe { return @ptrFromInt(*Relocation, address) }
}

pub fn make(kind: u8, token: usize) -> usize {
    const n = base.alloc(@sizeOf(Node))
    base.count(base.STAT_NODES, @sizeOf(Node))
    node(n).*.kind = kind
    node(n).*.token = token
    return n
}

pub fn binary(kind: u8, lhs: usize, rhs: usize, token: usize) -> usize {
    const n = make(kind, token)
    node(n).*.lhs = lhs
    node(n).*.rhs = rhs
    return n
}

pub fn unary(kind: u8, operand: usize, token: usize) -> usize {
    const n = make(kind, token)
    node(n).*.lhs = operand
    return n
}

pub fn number(value: i64, token: usize) -> usize {
    const n = make(NUM, token)
    node(n).*.value = value
    return n
}

pub fn variableNode(variable: usize, token: usize) -> usize {
    const n = make(VAR, token)
    node(n).*.variable = variable
    return n
}

pub fn newObj(name: u32, ty: usize, token: usize) -> usize {
    const o = base.alloc(@sizeOf(Obj))
    base.count(base.STAT_OBJS, @sizeOf(Obj))
    obj(o).*.name = name
    obj(o).*.symbol = name
    obj(o).*.ty = ty
    obj(o).*.token = token
    return o
}

pub fn kindOf(n: usize) -> u8 { return node(n).*.kind }
pub fn typeOf(n: usize) -> usize { return node(n).*.ty }
pub fn tokenOf(n: usize) -> usize { return node(n).*.token }

pub fn errorAt(n: usize, message: []const u8) -> void {
    tokens.errorAt(node(n).*.token, message)
}
