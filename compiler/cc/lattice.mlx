// `mlx-cc --lattice-manifest=OUT --lattice-units=LIST`: the manifest of a
// program translated to Mlx unit by unit (emitmlx.mlx, "One program of
// many units"; projects/webkit/LATTICE.md).
//
// LIST names the units in their order, a line each: the unit's module
// name, a tab, the list `--emit-mlx-index` wrote for it. From the lists:
//
// - a thing's home is the first unit that defines it (a record's the
//   first that writes it in full, else the first that names it);
// - its name is unique in its home: a record keeps the name it was given,
//   a variable too, a function its name alone, or with its parameter
//   types when another function of its home has the name, and a number
//   after that when a name is taken still;
// - a function is held back when it is on its own account in its home or
//   calls one that is, in whatever unit (a fixed point over the calls).
//
// OUT has a line a thing: its kind (F, R, G), its key, its home, its name
// and a flag (a function held back, a record in full), tabs between.
const base = @import("./base.mlx")
const program = @import("./program.mlx")

const MAX_THINGS: usize = 2097152
const SLOTS: usize = 8388608

// The things, an index each: parallel arrays.
var kinds: usize = 0
var keys: usize = 0
var homes: usize = 0
var shorts: usize = 0
var longs: usize = 0
var finals: usize = 0
var flags: usize = 0
var edgeStarts: usize = 0
var edgeCounts: usize = 0
var count: usize = 0

// A key's thing (an index and one).
var slotKeys: usize = 0
var slotThings: usize = 0

// The calls: the callees' key hashes, a run a function.
var edges: usize = 0
var edgeCount: usize = 0
var edgeCapacity: usize = 0

fn words(n: usize) -> usize {
    const at = base.alloc(n * 8)
    var k: usize = 0
    while k < n {
        base.putWord(at + k * 8, 0)
        k += 1
    }
    return at
}

fn halves(n: usize) -> usize {
    const at = base.alloc(n * 4)
    var k: usize = 0
    while k < n {
        base.put32(at + k * 4, 0)
        k += 1
    }
    return at
}

fn zeroBytes(n: usize) -> usize {
    const at = base.alloc(n)
    var k: usize = 0
    while k < n {
        base.put8(at + k, 0)
        k += 1
    }
    return at
}

fn slotOf(key: u32) -> usize {
    var slot = (@intCast(usize, key) *% 2654435761) & (SLOTS - 1)
    while base.get32(slotKeys + slot * 4) != 0 && base.get32(slotKeys + slot * 4) != key { slot = (slot + 1) & (SLOTS - 1) }
    return slot
}

// A table from a 64-bit key (never 0) to a 32-bit value.
const Wide = struct {
    keys: usize
    values: usize
    slots: usize
}

fn wideTable(slots: usize) -> Wide {
    return Wide.{ .keys = words(slots), .values = halves(slots), .slots = slots }
}

fn wideSlot(table: *const Wide, key: u64) -> usize {
    var slot = @intCast(usize, (key *% 11400714819323198485) >> 20) & (table.*.slots - 1)
    while base.getWord(table.*.keys + slot * 8) != 0 && base.getWord(table.*.keys + slot * 8) != @intCast(usize, key) { slot = (slot + 1) & (table.*.slots - 1) }
    return slot
}

fn wideGet(table: *const Wide, key: u64) -> u32 {
    const slot = wideSlot(table, key)
    if base.getWord(table.*.keys + slot * 8) == 0 { return 0 }
    return base.get32(table.*.values + slot * 4)
}

fn widePut(table: *const Wide, key: u64, value: u32) -> void {
    const slot = wideSlot(table, key)
    base.putWord(table.*.keys + slot * 8, @intCast(usize, key))
    base.put32(table.*.values + slot * 4, value)
}

fn keyHash(key: u32) -> u64 {
    var hash: u64 = 14695981039346656037
    for byte in base.nameOf(key) {
        hash = (hash ^ @intCast(u64, byte)) *% 1099511628211
    }
    return if hash == 0 { 1 } else { hash }
}

fn addEdge(hash: u64) -> void {
    if edgeCount == edgeCapacity {
        const capacity = if edgeCapacity == 0 { 1048576 } else { edgeCapacity * 2 }
        const larger = base.alloc(capacity * 8)
        if edgeCount > 0 { base.copy(larger, edges, edgeCount * 8) }
        edges = larger
        edgeCapacity = capacity
    }
    base.putWord(edges + edgeCount * 8, @intCast(usize, hash))
    edgeCount += 1
}

fn hexValue(text: []const u8) -> u64 {
    var value: u64 = 0
    for byte in text {
        const digit: u64 = if byte >= 97 { @intCast(u64, byte) - 87 } else { @intCast(u64, byte) - 48 }
        value = (value << 4) | (digit & 15)
    }
    return if value == 0 { 1 } else { value }
}

var listings: usize = 0

// A unit's list read: the first definition of a thing makes it.
fn readIndex(unit: u32, path: []const u8) -> void {
    const id = base.readFile(path)
    if id == 0 {
        base.say("mlx-cc: cannot read ")
        base.say(path)
        base.say("\n")
        base.exit(1)
    }
    const text = base.bytes(base.fileData(id), base.fileLength(id))
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        var fields: [6]usize = undefined
        var fieldCount: usize = 0
        fields[0] = at
        var f = at
        while f < end && fieldCount < 5 {
            if text[f] == 9 {
                fieldCount += 1
                fields[fieldCount] = f + 1
            }
            f += 1
        }
        const kind = if end > at { text[at] } else { 0 }
        if (kind == 70 && fieldCount == 5) || (kind == 82 && fieldCount == 3) || (kind == 71 && fieldCount == 2) {
            listings += 1
            const key = base.intern(text[fields[1]..fields[2] - 1])
            const slot = slotOf(key)
            var thing = @intCast(usize, base.get32(slotThings + slot * 4))
            const full = kind == 82 && fields[3] < end && text[fields[3]] == 49
            if thing == 0 {
                if count >= MAX_THINGS { base.fatal("too many things in the program") }
                thing = count + 1
                count += 1
                base.put32(slotKeys + slot * 4, key)
                base.put32(slotThings + slot * 4, @intCast(u32, thing))
                const t = thing - 1
                base.put8(kinds + t, kind)
                base.put32(keys + t * 4, key)
                base.put32(homes + t * 4, unit)
                if kind == 70 {
                    base.put32(shorts + t * 4, base.intern(text[fields[2]..fields[3] - 1]))
                    base.put32(longs + t * 4, base.intern(text[fields[3]..fields[4] - 1]))
                    base.put8(flags + t, if text[fields[4]] == 49 { 1 } else { 0 })
                    base.putWord(edgeStarts + t * 8, edgeCount)
                    var c = fields[5]
                    while c + 16 <= end {
                        if text[c] == 32 {
                            c += 1
                        } else {
                            addEdge(hexValue(text[c..c + 16]))
                            c += 16
                        }
                    }
                    base.put32(edgeCounts + t * 4, @intCast(u32, edgeCount - base.getWord(edgeStarts + t * 8)))
                } else {
                    const nameEnd = if kind == 82 { fields[3] - 1 } else { end }
                    base.put32(shorts + t * 4, base.intern(text[fields[2]..nameEnd]))
                    base.put8(flags + t, if full { 1 } else { 0 })
                }
            } else if full && base.get8(flags + thing - 1) == 0 {
                // (A record named before, written in full here: its home.)
                base.put32(homes + (thing - 1) * 4, unit)
                base.put32(shorts + (thing - 1) * 4, base.intern(text[fields[2]..fields[3] - 1]))
                base.put8(flags + thing - 1, 1)
            }
        }
        at = end + 1
    }
}

// Held back: what calls a held-back function is, to a fixed point.
fn holdBack() -> usize {
    var byHash = wideTable(SLOTS)
    var t: usize = 0
    while t < count {
        if base.get8(kinds + t) == 70 { widePut(&byHash, keyHash(base.get32(keys + t * 4)), @intCast(u32, t + 1)) }
        t += 1
    }
    // The callers of each function: lists through the calls.
    const heads = halves(count)
    const nexts = halves(edgeCount + 1)
    const callers = halves(edgeCount + 1)
    t = 0
    while t < count {
        if base.get8(kinds + t) == 70 {
            const start = base.getWord(edgeStarts + t * 8)
            var e: usize = 0
            while e < @intCast(usize, base.get32(edgeCounts + t * 4)) {
                const callee = @intCast(usize, wideGet(&byHash, @intCast(u64, base.getWord(edges + (start + e) * 8))))
                if callee != 0 {
                    base.put32(callers + (start + e) * 4, @intCast(u32, t + 1))
                    base.put32(nexts + (start + e) * 4, base.get32(heads + (callee - 1) * 4))
                    base.put32(heads + (callee - 1) * 4, @intCast(u32, start + e + 1))
                }
                e += 1
            }
        }
        t += 1
    }
    const queue = halves(count + 1)
    var tail: usize = 0
    t = 0
    while t < count {
        if base.get8(kinds + t) == 70 && base.get8(flags + t) != 0 {
            base.put32(queue + tail * 4, @intCast(u32, t))
            tail += 1
        }
        t += 1
    }
    var head: usize = 0
    while head < tail {
        const held = @intCast(usize, base.get32(queue + head * 4))
        head += 1
        var e = @intCast(usize, base.get32(heads + held * 4))
        while e != 0 {
            const caller = @intCast(usize, base.get32(callers + (e - 1) * 4)) - 1
            if base.get8(flags + caller) == 0 {
                base.put8(flags + caller, 1)
                base.put32(queue + tail * 4, @intCast(u32, caller))
                tail += 1
            }
            e = @intCast(usize, base.get32(nexts + (e - 1) * 4))
        }
    }
    return tail
}

fn pair(home: u32, name: u32) -> u64 { return (@intCast(u64, home) << 32) | @intCast(u64, name) }

// A name not taken in `home`: `name`, else `name_2`, `name_3`...
fn freeName(taken: *const Wide, home: u32, name: u32) -> u32 {
    var candidate = name
    var serial: u64 = 2
    while wideGet(taken, pair(home, candidate)) != 0 {
        candidate = base.intern(base.join(base.nameOf(name), base.join("_", base.decimal(serial))))
        serial += 1
    }
    widePut(taken, pair(home, candidate), 1)
    return candidate
}

fn nameThings() -> void {
    var taken = wideTable(SLOTS)
    var sharing = wideTable(SLOTS)
    // Records, then variables, keep their names.
    var round: u8 = 82
    while true {
        var t: usize = 0
        while t < count {
            if base.get8(kinds + t) == round { base.put32(finals + t * 4, freeName(&taken, base.get32(homes + t * 4), base.get32(shorts + t * 4))) }
            t += 1
        }
        if round == 71 { break }
        round = 71
    }
    // Functions: how many of a home share a name.
    var t: usize = 0
    while t < count {
        if base.get8(kinds + t) == 70 {
            const key = pair(base.get32(homes + t * 4), base.get32(shorts + t * 4))
            widePut(&sharing, key, wideGet(&sharing, key) + 1)
        }
        t += 1
    }
    t = 0
    while t < count {
        if base.get8(kinds + t) == 70 {
            const home = base.get32(homes + t * 4)
            const short = base.get32(shorts + t * 4)
            const alone = wideGet(&sharing, pair(home, short)) == 1 && wideGet(&taken, pair(home, short)) == 0
            base.put32(finals + t * 4, freeName(&taken, home, if alone { short } else { base.get32(longs + t * 4) }))
        }
        t += 1
    }
}

var outData: usize = 0
var outLength: usize = 0
var outCapacity: usize = 0

fn write(text: []const u8) -> void {
    if outLength + text.length > outCapacity {
        var capacity = if outCapacity == 0 { 4194304 } else { outCapacity * 2 }
        while capacity < outLength + text.length { capacity *= 2 }
        const larger = base.alloc(capacity)
        if outLength > 0 { base.copy(larger, outData, outLength) }
        outData = larger
        outCapacity = capacity
    }
    base.putText(outData + outLength, text)
    outLength += text.length
}

pub fn run(unitsPath: []const u8, outputPath: []const u8) -> void {
    kinds = zeroBytes(MAX_THINGS)
    flags = zeroBytes(MAX_THINGS)
    keys = halves(MAX_THINGS)
    homes = halves(MAX_THINGS)
    shorts = halves(MAX_THINGS)
    longs = halves(MAX_THINGS)
    finals = halves(MAX_THINGS)
    edgeCounts = halves(MAX_THINGS)
    edgeStarts = words(MAX_THINGS)
    slotKeys = halves(SLOTS)
    slotThings = halves(SLOTS)
    const id = base.readFile(unitsPath)
    if id == 0 {
        base.say("mlx-cc: cannot read ")
        base.say(unitsPath)
        base.say("\n")
        base.exit(1)
    }
    const list = base.bytes(base.fileData(id), base.fileLength(id))
    var units: usize = 0
    var at: usize = 0
    while at < list.length {
        var end = at
        while end < list.length && list[end] != 10 { end += 1 }
        var tab = at
        while tab < end && list[tab] != 9 { tab += 1 }
        if tab < end {
            readIndex(base.intern(list[at..tab]), list[tab + 1..end])
            units += 1
        }
        at = end + 1
    }
    const held = holdBack()
    nameThings()
    var functions: usize = 0
    var records: usize = 0
    var full: usize = 0
    var variables: usize = 0
    var t: usize = 0
    while t < count {
        const kind = base.get8(kinds + t)
        var letter: [2]u8 = [2]u8{ kind, 9 }
        write(letter[0..2])
        write(base.nameOf(base.get32(keys + t * 4)))
        write("\t")
        write(base.nameOf(base.get32(homes + t * 4)))
        write("\t")
        write(base.nameOf(base.get32(finals + t * 4)))
        write(if base.get8(flags + t) != 0 { "\t1\n" } else { "\t0\n" })
        if kind == 70 {
            functions += 1
        } else if kind == 82 {
            records += 1
            if base.get8(flags + t) != 0 { full += 1 }
        } else {
            variables += 1
        }
        t += 1
    }
    if !program.writeBytes(outputPath, outData, outLength) {
        base.say("mlx-cc: cannot write ")
        base.say(outputPath)
        base.say("\n")
        base.exit(1)
    }
    base.say(base.decimal(@intCast(u64, units)))
    base.say(" units, ")
    base.say(base.decimal(@intCast(u64, listings)))
    base.say(" definitions listed: ")
    base.say(base.decimal(@intCast(u64, functions)))
    base.say(" functions (")
    base.say(base.decimal(@intCast(u64, held)))
    base.say(" held back), ")
    base.say(base.decimal(@intCast(u64, records)))
    base.say(" records (")
    base.say(base.decimal(@intCast(u64, full)))
    base.say(" in full), ")
    base.say(base.decimal(@intCast(u64, variables)))
    base.say(" variables\n")
}
