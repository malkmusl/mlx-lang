// The parser's place in the token list, and the small questions it asks
// there. One list is parsed at a time; save() and restore() let the
// parser look ahead (a declarator's parentheses, a cast or a compound
// literal) and come back.
const base = @import("./base.mlx")
const tokens = @import("./tokens.mlx")
const names = @import("./names.mlx")

var current: usize = 0

pub fn restore(token: usize) -> void { current = token }
pub fn save() -> usize { return current }
pub fn peek() -> usize { return current }
pub fn peekNext() -> usize { return tokens.next(current) }

pub fn advance() -> void {
    if !tokens.isEof(current) { current = tokens.next(current) }
}

// Whether `token` is the punctuator or keyword `id`.
pub fn isToken(token: usize, id: u32) -> bool {
    const t = tokens.at(token)
    return (t.*.kind == tokens.PUNCT || t.*.kind == tokens.KEYWORD) && t.*.name == id
}

pub fn is(id: u32) -> bool { return isToken(current, id) }

pub fn consume(id: u32) -> bool {
    if isToken(current, id) {
        advance()
        return true
    }
    return false
}

pub fn expect(id: u32) -> void {
    if !consume(id) { fail(base.join(base.join("expected '", base.nameOf(id)), "'")) }
}

pub fn isIdent() -> bool { return tokens.kind(current) == tokens.IDENT }

// The identifier here, passed.
pub fn expectIdent() -> usize {
    if !isIdent() { fail("expected an identifier") }
    const token = current
    advance()
    return token
}

pub fn isEof() -> bool { return tokens.isEof(current) }

pub fn fail(message: []const u8) -> void { tokens.errorAt(current, message) }

pub fn warn(message: []const u8) -> void { tokens.warnAt(current, message) }

// The end of a brace-enclosed list: `}` or `, }`.
pub fn isEnd() -> bool {
    return is(names.P_RBRACE) || (is(names.P_COMMA) && isToken(peekNext(), names.P_RBRACE))
}

// Passes the end of a brace-enclosed list if it is here.
pub fn consumeEnd() -> bool {
    if is(names.P_RBRACE) {
        advance()
        return true
    }
    if is(names.P_COMMA) && isToken(peekNext(), names.P_RBRACE) {
        advance()
        advance()
        return true
    }
    return false
}

// --- prefix snapshot state (tools/cc_snapshot_state.py writes this) ---
pub fn keepState() -> void {
    base.keepState(@intFromPtr(&current), @sizeOf(@typeOf(current)))
}
// --- end of prefix snapshot state ---
