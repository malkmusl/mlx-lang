// <fstream>: std::ifstream, reading a file through a C stream (>>,
// get, getline, read, seekg, tellg), and std::ofstream, an ostream (all
// of its << and formatting) whose text goes to the file when it is
// flushed or closed; istreambuf_iterator over either input stream.
#ifndef __MLXCC_FSTREAM
#define __MLXCC_FSTREAM
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string>
#include <iostream>
#include <sstream>
#include <iterator>

namespace std {

typedef long streampos;
typedef long streamoff;

class ifstream {
public:
    ifstream() : _file(0), _failed(false), _ended(false), _count(0) {}
    explicit ifstream(const char *path, ios_base::openmode mode = ios_base::in) : _file(0), _failed(false), _ended(false), _count(0) { open(path, mode); }
    explicit ifstream(const string &path, ios_base::openmode mode = ios_base::in) : ifstream(path.c_str(), mode) {}
    ifstream(const ifstream &) = delete;
    ~ifstream() { close(); }
    void open(const char *path, ios_base::openmode = ios_base::in) {
        close();
        _file = fopen(path, "rb");
        _failed = _file == 0;
        _ended = false;
    }
    void open(const string &path, ios_base::openmode mode = ios_base::in) { open(path.c_str(), mode); }
    bool is_open() const { return _file != 0; }
    void close() {
        if (_file) fclose(_file);
        _file = 0;
    }
    bool good() const { return !_failed && !_ended; }
    bool fail() const { return _failed; }
    bool bad() const { return false; }
    bool eof() const { return _ended; }
    void clear() { _failed = false; _ended = false; }
    explicit operator bool() const { return !_failed; }
    bool operator!() const { return _failed; }
    locale imbue(const locale &) { return locale(); }
    streamsize gcount() const { return _count; }

    int get() {
        if (!_file) { _failed = true; return -1; }
        int c = fgetc(_file);
        if (c < 0) { _ended = true; _failed = true; }
        _count = c < 0 ? 0 : 1;
        return c;
    }
    ifstream &get(char &c) {
        int read = get();
        if (read >= 0) c = (char)read;
        return *this;
    }
    int peek() {
        if (!_file) return -1;
        int c = fgetc(_file);
        if (c < 0) { _ended = true; return -1; }
        ungetc(c, _file);
        return c;
    }
    ifstream &unget() {
        if (_file) fseek(_file, -1, SEEK_CUR);
        return *this;
    }
    ifstream &read(char *buffer, streamsize n) {
        _count = _file ? (streamsize)fread(buffer, 1, n, _file) : 0;
        if (_count < n) { _ended = true; _failed = true; }
        return *this;
    }
    ifstream &ignore(streamsize n = 1, int delimiter = -1) {
        for (streamsize i = 0; i < n; i++) {
            int c = get();
            if (c < 0 || c == delimiter) break;
        }
        return *this;
    }
    ifstream &getline(char *buffer, streamsize size, char delimiter = '\n') {
        streamsize n = 0;
        while (n + 1 < size) {
            int c = fgetc(_file);
            if (c < 0) { _ended = true; if (n == 0) _failed = true; break; }
            if (c == delimiter) break;
            buffer[n++] = (char)c;
        }
        if (size > 0) buffer[n] = 0;
        _count = n;
        return *this;
    }
    ifstream &seekg(streamoff offset, ios_base::seekdir direction) {
        if (_file && fseek(_file, offset, direction == ios_base::beg ? SEEK_SET : direction == ios_base::cur ? SEEK_CUR : SEEK_END) != 0) _failed = true;
        _ended = false;
        return *this;
    }
    ifstream &seekg(streampos position) { return seekg(position, ios_base::beg); }
    streampos tellg() { return _file ? ftell(_file) : -1; }

    ifstream &operator>>(string &word) {
        int c = skipSpace();
        word.clear();
        while (c >= 0 && !isspace(c)) {
            word.push_back((char)c);
            c = fgetc(_file);
        }
        if (c < 0) _ended = true; else ungetc(c, _file);
        if (word.empty()) _failed = true;
        return *this;
    }
    ifstream &operator>>(char &c) {
        int read = skipSpace();
        if (read < 0) { _ended = true; _failed = true; } else c = (char)read;
        return *this;
    }
    ifstream &operator>>(long &value) {
        string word;
        *this >> word;
        if (_failed) return *this;
        char *stop;
        long read = strtol(word.c_str(), &stop, 10);
        if (stop == word.c_str()) _failed = true; else value = read;
        return *this;
    }
    ifstream &operator>>(int &value) { long v = 0; *this >> v; if (!_failed) value = (int)v; return *this; }
    ifstream &operator>>(unsigned &value) { long v = 0; *this >> v; if (!_failed) value = (unsigned)v; return *this; }
    ifstream &operator>>(unsigned long &value) { long v = 0; *this >> v; if (!_failed) value = (unsigned long)v; return *this; }
    ifstream &operator>>(double &value) {
        string word;
        *this >> word;
        if (_failed) return *this;
        char *stop;
        double read = strtod(word.c_str(), &stop);
        if (stop == word.c_str()) _failed = true; else value = read;
        return *this;
    }
    ifstream &operator>>(float &value) { double v = 0; *this >> v; if (!_failed) value = (float)v; return *this; }

private:
    FILE *_file;
    bool _failed;
    bool _ended;
    streamsize _count;
    int skipSpace() {
        if (!_file) return -1;
        int c = fgetc(_file);
        while (c >= 0 && isspace(c)) c = fgetc(_file);
        return c;
    }
};

inline ifstream &getline(ifstream &in, string &line, char delimiter = '\n') {
    line.clear();
    int c = in.get();
    if (c < 0) return in;
    while (c >= 0 && c != delimiter) {
        line.push_back((char)c);
        c = in.get();
    }
    // (The last line without its delimiter is read, not failed.)
    if (c < 0 && !line.empty()) in.clear();
    return in;
}

class ofstream : public ostringstream {
public:
    ofstream() : _file(0) {}
    explicit ofstream(const char *path, ios_base::openmode mode = ios_base::out) : _file(0) { open(path, mode); }
    explicit ofstream(const string &path, ios_base::openmode mode = ios_base::out) : ofstream(path.c_str(), mode) {}
    ofstream(const ofstream &) = delete;
    ~ofstream() { close(); }
    void open(const char *path, ios_base::openmode mode = ios_base::out) {
        close();
        _file = fopen(path, (mode & ios_base::app) ? "ab" : "wb");
        failed = _file == 0;
    }
    void open(const string &path, ios_base::openmode mode = ios_base::out) { open(path.c_str(), mode); }
    bool is_open() const { return _file != 0; }
    ofstream &flush() {
        string text = str();
        if (_file && !text.empty()) {
            if (fwrite(text.data(), 1, text.size(), _file) != text.size()) failed = true;
            fflush(_file);
        }
        str("");
        return *this;
    }
    void close() {
        if (!_file) return;
        flush();
        fclose(_file);
        _file = 0;
    }
private:
    FILE *_file;
};

// Characters read one by one from an input stream (an ifstream or an
// istringstream) until it ends; the default one is the end.
template <class C, class Traits = char_traits<C> > class istreambuf_iterator {
public:
    typedef input_iterator_tag iterator_category;
    typedef C value_type;
    typedef ptrdiff_t difference_type;
    typedef const C *pointer;
    typedef C reference;

    istreambuf_iterator() noexcept : _source(0), _read(0), _held(-1) {}
    istreambuf_iterator(ifstream &in) noexcept : _source(&in), _read(&readFrom<ifstream>), _held(-1) { fetch(); }
    istreambuf_iterator(istringstream &in) noexcept : _source(&in), _read(&readFrom<istringstream>), _held(-1) { fetch(); }
    C operator*() const { return (C)_held; }
    istreambuf_iterator &operator++() { fetch(); return *this; }
    istreambuf_iterator operator++(int) { istreambuf_iterator old = *this; fetch(); return old; }
    bool equal(const istreambuf_iterator &other) const { return (_source == 0) == (other._source == 0); }
    bool operator==(const istreambuf_iterator &other) const { return equal(other); }
    bool operator!=(const istreambuf_iterator &other) const { return !equal(other); }

private:
    void *_source;
    int (*_read)(void *);
    int _held;
    template <class S> static int readFrom(void *source) { return static_cast<S *>(source)->get(); }
    void fetch() {
        if (!_source) return;
        _held = _read(_source);
        if (_held < 0) _source = 0;
    }
};

}
#endif
