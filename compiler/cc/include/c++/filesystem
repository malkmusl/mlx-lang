// <filesystem>: std::filesystem over POSIX calls. path (a string of
// '/'-separated names, decomposed and normalized lexically), file
// status and types, directory_entry, directory_iterator and
// recursive_directory_iterator, and the operations (exists, file_size,
// copy, remove_all, space, ...). Each operation takes an error_code;
// without one an error ends the program (there are no exceptions).
#ifndef __MLXCC_FILESYSTEM
#define __MLXCC_FILESYSTEM
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <dirent.h>
#include <sys/stat.h>
#include <sys/statvfs.h>
#include <string>
#include <vector>
#include <memory>
#include <chrono>
#include <iterator>
#include <system_error>

namespace std {
namespace filesystem {

// ---------------------------------------------------------------------------
// path

class path {
public:
    typedef char value_type;
    typedef std::string string_type;
    static constexpr char preferred_separator = '/';
    enum format { native_format, generic_format, auto_format };

    path() {}
    path(const path &other) : _text(other._text) {}
    path(path &&other) : _text(other._text) {}
    path(const std::string &text) : _text(text) {}
    path(const char *text) : _text(text) {}
    path(const std::u8string &text) : _text(text.__bytes()) {}
    template <class It> path(It first, It last) { for (; first != last; ++first) _text.push_back((char)*first); }
    path &operator=(const path &other) { _text = other._text; return *this; }
    path &operator=(const std::string &text) { _text = text; return *this; }
    path &operator=(const char *text) { _text = text; return *this; }
    path &assign(const std::string &text) { _text = text; return *this; }

    // `a / b`: b after a separator, or b alone when it is absolute.
    path &operator/=(const path &other) {
        if (other.is_absolute() || _text.empty()) {
            _text = other._text;
            return *this;
        }
        if (_text[_text.size() - 1] != '/' && !other._text.empty()) _text.push_back('/');
        _text += other._text;
        return *this;
    }
    path &append(const path &other) { return *this /= other; }
    path &operator+=(const path &other) { _text += other._text; return *this; }
    path &operator+=(const std::string &text) { _text += text; return *this; }
    path &operator+=(const char *text) { _text += text; return *this; }
    path &operator+=(char c) { _text.push_back(c); return *this; }
    path &concat(const path &other) { _text += other._text; return *this; }

    void clear() noexcept { _text.clear(); }
    path &make_preferred() { return *this; }
    path &remove_filename() { _text.erase(__filenameStart()); return *this; }
    path &replace_filename(const path &name) { remove_filename(); return *this /= name; }
    path &replace_extension(const path &extension = path()) {
        const std::string ext = this->extension()._text;
        if (!ext.empty()) _text.erase(_text.size() - ext.size());
        if (!extension._text.empty() && extension._text[0] != '.') _text.push_back('.');
        _text += extension._text;
        return *this;
    }
    void swap(path &other) noexcept { _text.swap(other._text); }

    const string_type &native() const noexcept { return _text; }
    const char *c_str() const noexcept { return _text.c_str(); }
    operator string_type() const { return _text; }
    std::string string() const { return _text; }
    std::u8string u8string() const { return std::u8string((const char8_t *)_text.c_str(), _text.size()); }
    std::string generic_string() const { return _text; }
    std::u8string generic_u8string() const { return u8string(); }

    int compare(const path &other) const noexcept { return _text.compare(other._text); }
    int compare(const std::string &text) const { return _text.compare(text); }
    int compare(const char *text) const { return _text.compare(text); }

    path root_name() const { return path(); }
    path root_directory() const { return has_root_directory() ? path("/") : path(); }
    path root_path() const { return root_directory(); }
    path relative_path() const {
        size_t at = 0;
        while (at < _text.size() && _text[at] == '/') at++;
        return path(_text.substr(at));
    }
    // The path without its last name ("/a/b" -> "/a", "/a/b/" -> "/a/b").
    path parent_path() const {
        if (!has_relative_path()) return *this;
        size_t start = __filenameStart();
        if (start == 0) return path();
        std::string prefix = _text.substr(0, start);
        while (prefix.size() > 1 && prefix[prefix.size() - 1] == '/') prefix.pop_back();
        return path(prefix);
    }
    path filename() const { return path(_text.substr(__filenameStart())); }
    path stem() const {
        const std::string name = _text.substr(__filenameStart());
        const size_t dot = __extensionDot(name);
        return path(dot == std::string::npos ? name : name.substr(0, dot));
    }
    path extension() const {
        const std::string name = _text.substr(__filenameStart());
        const size_t dot = __extensionDot(name);
        return path(dot == std::string::npos ? std::string() : name.substr(dot));
    }

    bool empty() const noexcept { return _text.empty(); }
    bool has_root_name() const { return false; }
    bool has_root_directory() const { return !_text.empty() && _text[0] == '/'; }
    bool has_root_path() const { return has_root_directory(); }
    bool has_relative_path() const { return !relative_path().empty(); }
    bool has_parent_path() const { return !parent_path().empty(); }
    bool has_filename() const { return !filename().empty(); }
    bool has_stem() const { return !stem().empty(); }
    bool has_extension() const { return !extension().empty(); }
    bool is_absolute() const { return has_root_directory(); }
    bool is_relative() const { return !is_absolute(); }

    // "." and ".." taken out, separators made single ("a/./b/../c" -> "a/c").
    path lexically_normal() const {
        if (_text.empty()) return path();
        const bool absolute = _text[0] == '/';
        std::vector<std::string> names;
        bool trailing = false;
        size_t at = 0;
        while (at < _text.size()) {
            while (at < _text.size() && _text[at] == '/') at++;
            if (at >= _text.size()) break;
            size_t end = at;
            while (end < _text.size() && _text[end] != '/') end++;
            const std::string name = _text.substr(at, end - at);
            const bool last = end >= _text.size() || _text.find_first_not_of("/", end) == std::string::npos;
            if (name == ".") {
                trailing = true;
            } else if (name == "..") {
                if (!names.empty() && names[names.size() - 1] != "..") {
                    names.pop_back();
                    trailing = true;
                } else if (!absolute) {
                    names.push_back(name);
                    trailing = false;
                } else {
                    trailing = true;
                }
            } else {
                names.push_back(name);
                trailing = last && end < _text.size();
            }
            at = end;
        }
        std::string result = absolute ? "/" : "";
        for (size_t i = 0; i < names.size(); i++) {
            if (i > 0) result.push_back('/');
            result += names[i];
        }
        if (trailing && !names.empty() && names[names.size() - 1] != "..") result.push_back('/');
        if (result.empty()) result = ".";
        return path(result);
    }
    // This path relative to `base` (both normal): "/a/b/c" from "/a" is "b/c".
    path lexically_relative(const path &base) const {
        const std::string a = lexically_normal()._text;
        const std::string b = base.lexically_normal()._text;
        if ((!a.empty() && a[0] == '/') != (!b.empty() && b[0] == '/')) return path();
        std::vector<std::string> left = __names(a);
        std::vector<std::string> right = __names(b);
        size_t same = 0;
        while (same < left.size() && same < right.size() && left[same] == right[same]) same++;
        if (same == left.size() && same == right.size()) return path(".");
        std::string result;
        for (size_t i = same; i < right.size(); i++) {
            if (right[i] == ".") continue;
            if (!result.empty()) result.push_back('/');
            result += "..";
        }
        for (size_t i = same; i < left.size(); i++) {
            if (!result.empty()) result.push_back('/');
            result += left[i];
        }
        return path(result);
    }
    path lexically_proximate(const path &base) const {
        path relative = lexically_relative(base);
        return relative.empty() ? *this : relative;
    }

    size_t __filenameStart() const {
        const size_t slash = _text.rfind('/');
        return slash == std::string::npos ? 0 : slash + 1;
    }
private:
    static size_t __extensionDot(const std::string &name) {
        if (name == "." || name == "..") return std::string::npos;
        const size_t dot = name.rfind('.');
        if (dot == std::string::npos || dot == 0) return std::string::npos;
        return dot;
    }
    static std::vector<std::string> __names(const std::string &text) {
        std::vector<std::string> names;
        size_t at = 0;
        while (at < text.size()) {
            while (at < text.size() && text[at] == '/') at++;
            size_t end = at;
            while (end < text.size() && text[end] != '/') end++;
            if (end > at) names.push_back(text.substr(at, end - at));
            at = end;
        }
        return names;
    }
    std::string _text;
};

inline path operator/(const path &a, const path &b) { path result(a); result /= b; return result; }
inline bool operator==(const path &a, const path &b) noexcept { return a.compare(b) == 0; }
inline bool operator!=(const path &a, const path &b) noexcept { return a.compare(b) != 0; }
inline bool operator<(const path &a, const path &b) noexcept { return a.compare(b) < 0; }
inline bool operator<=(const path &a, const path &b) noexcept { return a.compare(b) <= 0; }
inline bool operator>(const path &a, const path &b) noexcept { return a.compare(b) > 0; }
inline bool operator>=(const path &a, const path &b) noexcept { return a.compare(b) >= 0; }
inline void swap(path &a, path &b) noexcept { a.swap(b); }
inline size_t hash_value(const path &p) noexcept {
    size_t h = 14695981039346656037UL;
    for (const char *c = p.c_str(); *c; c++) h = (h ^ (unsigned char)*c) * 1099511628211UL;
    return h;
}
inline path u8path(const std::string &text) { return path(text); }
inline path u8path(const char *text) { return path(text); }

// ---------------------------------------------------------------------------
// Types, options and status

enum class file_type { none = 0, not_found = -1, regular = 1, directory = 2, symlink = 3, block = 4, character = 5, fifo = 6, socket = 7, unknown = 8 };

enum class perms : unsigned {
    none = 0, owner_read = 0400, owner_write = 0200, owner_exec = 0100, owner_all = 0700,
    group_read = 040, group_write = 020, group_exec = 010, group_all = 070,
    others_read = 04, others_write = 02, others_exec = 01, others_all = 07,
    all = 0777, set_uid = 04000, set_gid = 02000, sticky_bit = 01000, mask = 07777, unknown = 0xFFFF
};
constexpr perms operator|(perms a, perms b) { return perms((unsigned)a | (unsigned)b); }
constexpr perms operator&(perms a, perms b) { return perms((unsigned)a & (unsigned)b); }
constexpr perms operator^(perms a, perms b) { return perms((unsigned)a ^ (unsigned)b); }
constexpr perms operator~(perms a) { return perms(~(unsigned)a & 07777); }

enum class perm_options : unsigned { replace = 1, add = 2, remove = 4, nofollow = 8 };
constexpr perm_options operator|(perm_options a, perm_options b) { return perm_options((unsigned)a | (unsigned)b); }
constexpr perm_options operator&(perm_options a, perm_options b) { return perm_options((unsigned)a & (unsigned)b); }

enum class copy_options : unsigned {
    none = 0, skip_existing = 1, overwrite_existing = 2, update_existing = 4,
    recursive = 8, copy_symlinks = 16, skip_symlinks = 32, directories_only = 64,
    create_symlinks = 128, create_hard_links = 256
};
constexpr copy_options operator|(copy_options a, copy_options b) { return copy_options((unsigned)a | (unsigned)b); }
constexpr copy_options operator&(copy_options a, copy_options b) { return copy_options((unsigned)a & (unsigned)b); }
constexpr copy_options operator^(copy_options a, copy_options b) { return copy_options((unsigned)a ^ (unsigned)b); }
constexpr copy_options operator~(copy_options a) { return copy_options(~(unsigned)a & 511); }
inline copy_options &operator|=(copy_options &a, copy_options b) { a = a | b; return a; }

enum class directory_options : unsigned { none = 0, follow_directory_symlink = 1, skip_permission_denied = 2 };
constexpr directory_options operator|(directory_options a, directory_options b) { return directory_options((unsigned)a | (unsigned)b); }
constexpr directory_options operator&(directory_options a, directory_options b) { return directory_options((unsigned)a & (unsigned)b); }

class file_status {
public:
    file_status() noexcept : _type(file_type::none), _perms(perms::unknown) {}
    explicit file_status(file_type type, perms permissions = perms::unknown) noexcept : _type(type), _perms(permissions) {}
    file_type type() const noexcept { return _type; }
    void type(file_type type) noexcept { _type = type; }
    perms permissions() const noexcept { return _perms; }
    void permissions(perms permissions) noexcept { _perms = permissions; }
private:
    file_type _type;
    perms _perms;
};

struct space_info {
    uintmax_t capacity;
    uintmax_t free;
    uintmax_t available;
};

typedef chrono::time_point<chrono::file_clock> file_time_type;

// No exceptions: what would be thrown is reported and the program ends.
class filesystem_error {
public:
    filesystem_error(const std::string &what, const error_code &ec) : _what(what), _code(ec) {}
    filesystem_error(const std::string &what, const path &p1, const error_code &ec) : _what(what), _path1(p1), _code(ec) {}
    filesystem_error(const std::string &what, const path &p1, const path &p2, const error_code &ec) : _what(what), _path1(p1), _path2(p2), _code(ec) {}
    const path &path1() const noexcept { return _path1; }
    const path &path2() const noexcept { return _path2; }
    const error_code &code() const noexcept { return _code; }
    const char *what() const noexcept { return _what.c_str(); }
private:
    std::string _what;
    path _path1;
    path _path2;
    error_code _code;
};

inline void __fs_check(const error_code &ec, const char *operation, const path &p) {
    if (!ec) return;
    fprintf(stderr, "filesystem error: %s: %s [%s]\n", operation, ec.message().c_str(), p.c_str());
    abort();
}
inline void __fs_fail(error_code &ec) { ec.assign(errno, generic_category()); }

inline file_type __fs_type(mode_t mode) {
    if (S_ISREG(mode)) return file_type::regular;
    if (S_ISDIR(mode)) return file_type::directory;
    if (S_ISLNK(mode)) return file_type::symlink;
    if (S_ISBLK(mode)) return file_type::block;
    if (S_ISCHR(mode)) return file_type::character;
    if (S_ISFIFO(mode)) return file_type::fifo;
    if (S_ISSOCK(mode)) return file_type::socket;
    return file_type::unknown;
}

inline file_status __fs_status(const path &p, error_code &ec, bool follow, struct stat *info) {
    struct stat st;
    if (!info) info = &st;
    int r = follow ? ::stat(p.c_str(), info) : ::lstat(p.c_str(), info);
    if (r != 0) {
        int err = errno;
        ec.assign(err, generic_category());
        if (err == ENOENT || err == ENOTDIR) return file_status(file_type::not_found);
        return file_status();
    }
    ec.clear();
    return file_status(__fs_type(info->st_mode), perms(info->st_mode & 07777));
}

inline file_status status(const path &p, error_code &ec) noexcept { return __fs_status(p, ec, true, 0); }
inline file_status status(const path &p) { error_code ec; file_status s = status(p, ec); if (s.type() != file_type::not_found) __fs_check(ec, "status", p); return s; }
inline file_status symlink_status(const path &p, error_code &ec) noexcept { return __fs_status(p, ec, false, 0); }
inline file_status symlink_status(const path &p) { error_code ec; file_status s = symlink_status(p, ec); if (s.type() != file_type::not_found) __fs_check(ec, "symlink_status", p); return s; }

inline bool status_known(file_status s) noexcept { return s.type() != file_type::none; }
inline bool exists(file_status s) noexcept { return status_known(s) && s.type() != file_type::not_found; }
inline bool is_regular_file(file_status s) noexcept { return s.type() == file_type::regular; }
inline bool is_directory(file_status s) noexcept { return s.type() == file_type::directory; }
inline bool is_symlink(file_status s) noexcept { return s.type() == file_type::symlink; }
inline bool is_block_file(file_status s) noexcept { return s.type() == file_type::block; }
inline bool is_character_file(file_status s) noexcept { return s.type() == file_type::character; }
inline bool is_fifo(file_status s) noexcept { return s.type() == file_type::fifo; }
inline bool is_socket(file_status s) noexcept { return s.type() == file_type::socket; }
inline bool is_other(file_status s) noexcept { return exists(s) && !is_regular_file(s) && !is_directory(s) && !is_symlink(s); }

inline bool exists(const path &p, error_code &ec) noexcept {
    file_status s = status(p, ec);
    if (s.type() == file_type::not_found) { ec.clear(); return false; }
    return !ec && exists(s);
}
inline bool exists(const path &p) { error_code ec; bool r = exists(p, ec); __fs_check(ec, "exists", p); return r; }
inline bool is_regular_file(const path &p, error_code &ec) noexcept { return is_regular_file(status(p, ec)); }
inline bool is_regular_file(const path &p) { return is_regular_file(status(p)); }
inline bool is_directory(const path &p, error_code &ec) noexcept { return is_directory(status(p, ec)); }
inline bool is_directory(const path &p) { return is_directory(status(p)); }
inline bool is_symlink(const path &p, error_code &ec) noexcept { return is_symlink(symlink_status(p, ec)); }
inline bool is_symlink(const path &p) { return is_symlink(symlink_status(p)); }
inline bool is_other(const path &p, error_code &ec) noexcept { return is_other(status(p, ec)); }

// ---------------------------------------------------------------------------
// Operations

inline uintmax_t file_size(const path &p, error_code &ec) noexcept {
    struct stat info;
    file_status s = __fs_status(p, ec, true, &info);
    if (ec) return (uintmax_t)-1;
    if (s.type() == file_type::directory) { ec = make_error_code(errc::is_a_directory); return (uintmax_t)-1; }
    if (s.type() != file_type::regular) { ec = make_error_code(errc::not_supported); return (uintmax_t)-1; }
    return (uintmax_t)info.st_size;
}
inline uintmax_t file_size(const path &p) { error_code ec; uintmax_t r = file_size(p, ec); __fs_check(ec, "file_size", p); return r; }

inline uintmax_t hard_link_count(const path &p, error_code &ec) noexcept {
    struct stat info;
    __fs_status(p, ec, true, &info);
    if (ec) return (uintmax_t)-1;
    return (uintmax_t)info.st_nlink;
}
inline uintmax_t hard_link_count(const path &p) { error_code ec; uintmax_t r = hard_link_count(p, ec); __fs_check(ec, "hard_link_count", p); return r; }

inline file_time_type last_write_time(const path &p, error_code &ec) noexcept {
    struct stat info;
    __fs_status(p, ec, true, &info);
    if (ec) return file_time_type::min();
    long long ns = (long long)info.st_mtim.tv_sec * 1000000000LL + (long long)info.st_mtim.tv_nsec;
    return file_time_type(chrono::nanoseconds(ns));
}
inline file_time_type last_write_time(const path &p) { error_code ec; file_time_type r = last_write_time(p, ec); __fs_check(ec, "last_write_time", p); return r; }
inline void last_write_time(const path &p, file_time_type when, error_code &ec) noexcept {
    long long ns = chrono::duration_cast<chrono::nanoseconds>(when.time_since_epoch()).count();
    struct timespec times[2];
    times[0].tv_sec = 0;
    times[0].tv_nsec = UTIME_OMIT;
    times[1].tv_sec = (time_t)(ns / 1000000000LL);
    times[1].tv_nsec = (long)(ns % 1000000000LL);
    if (times[1].tv_nsec < 0) { times[1].tv_nsec += 1000000000L; times[1].tv_sec -= 1; }
    if (utimensat(AT_FDCWD, p.c_str(), times, 0) != 0) __fs_fail(ec); else ec.clear();
}
inline void last_write_time(const path &p, file_time_type when) { error_code ec; last_write_time(p, when, ec); __fs_check(ec, "last_write_time", p); }

inline void permissions(const path &p, perms prms, perm_options opts, error_code &ec) noexcept {
    struct stat info;
    file_status s = __fs_status(p, ec, (opts & perm_options::nofollow) == perm_options(0), &info);
    if (ec) return;
    unsigned mode = (unsigned)s.permissions();
    if ((opts & perm_options::add) != perm_options(0)) mode |= (unsigned)prms;
    else if ((opts & perm_options::remove) != perm_options(0)) mode &= ~(unsigned)prms;
    else mode = (unsigned)prms;
    if (::chmod(p.c_str(), (mode_t)(mode & 07777)) != 0) __fs_fail(ec);
}
inline void permissions(const path &p, perms prms, error_code &ec) noexcept { permissions(p, prms, perm_options::replace, ec); }
inline void permissions(const path &p, perms prms, perm_options opts = perm_options::replace) { error_code ec; permissions(p, prms, opts, ec); __fs_check(ec, "permissions", p); }

inline path current_path(error_code &ec) {
    char buffer[4096];
    if (!getcwd(buffer, sizeof buffer)) { __fs_fail(ec); return path(); }
    ec.clear();
    return path(buffer);
}
inline path current_path() { error_code ec; path r = current_path(ec); __fs_check(ec, "current_path", r); return r; }
inline void current_path(const path &p, error_code &ec) noexcept { if (chdir(p.c_str()) != 0) __fs_fail(ec); else ec.clear(); }
inline void current_path(const path &p) { error_code ec; current_path(p, ec); __fs_check(ec, "current_path", p); }

inline path absolute(const path &p, error_code &ec) {
    ec.clear();
    if (p.is_absolute() || p.empty()) return p;
    return current_path(ec) / p;
}
inline path absolute(const path &p) { error_code ec; path r = absolute(p, ec); __fs_check(ec, "absolute", p); return r; }

inline path canonical(const path &p, error_code &ec) {
    // (A buffer of our own: glibc's realpath bound without a symbol
    // version is the old one, which refuses a null buffer.)
    char resolved[4096];
    if (!realpath(p.c_str(), resolved)) { __fs_fail(ec); return path(); }
    ec.clear();
    return path(resolved);
}
inline path canonical(const path &p) { error_code ec; path r = canonical(p, ec); __fs_check(ec, "canonical", p); return r; }

// The canonical form of the part that exists, the rest appended.
inline path weakly_canonical(const path &p, error_code &ec) {
    path head = p;
    path tail;
    while (!head.empty() && !exists(head, ec)) {
        tail = head.filename() / tail;
        head = head.parent_path();
        if (head == p) break;
    }
    if (ec) return path();
    if (head.empty()) return absolute(p, ec).lexically_normal();
    path result = canonical(head, ec);
    if (ec) return path();
    if (!tail.empty()) result /= tail;
    return result.lexically_normal();
}
inline path weakly_canonical(const path &p) { error_code ec; path r = weakly_canonical(p, ec); __fs_check(ec, "weakly_canonical", p); return r; }

inline path relative(const path &p, const path &base, error_code &ec) {
    path a = weakly_canonical(p, ec);
    if (ec) return path();
    path b = weakly_canonical(base, ec);
    if (ec) return path();
    return a.lexically_relative(b);
}
inline path relative(const path &p, error_code &ec) { path here = current_path(ec); return ec ? path() : relative(p, here, ec); }
inline path relative(const path &p, const path &base = current_path()) { error_code ec; path r = relative(p, base, ec); __fs_check(ec, "relative", p); return r; }
inline path proximate(const path &p, const path &base, error_code &ec) {
    path a = weakly_canonical(p, ec);
    if (ec) return path();
    path b = weakly_canonical(base, ec);
    if (ec) return path();
    return a.lexically_proximate(b);
}
inline path proximate(const path &p, const path &base = current_path()) { error_code ec; path r = proximate(p, base, ec); __fs_check(ec, "proximate", p); return r; }

inline bool create_directory(const path &p, error_code &ec) noexcept {
    if (::mkdir(p.c_str(), 0777) == 0) { ec.clear(); return true; }
    int err = errno;
    if (err == EEXIST && is_directory(p, ec)) { ec.clear(); return false; }
    ec.assign(err, generic_category());
    return false;
}
inline bool create_directory(const path &p) { error_code ec; bool r = create_directory(p, ec); __fs_check(ec, "create_directory", p); return r; }
inline bool create_directory(const path &p, const path &existing, error_code &ec) noexcept {
    struct stat info;
    if (::stat(existing.c_str(), &info) != 0) { __fs_fail(ec); return false; }
    if (::mkdir(p.c_str(), info.st_mode & 07777) == 0) { ec.clear(); return true; }
    int err = errno;
    if (err == EEXIST && is_directory(p, ec)) { ec.clear(); return false; }
    ec.assign(err, generic_category());
    return false;
}

inline bool create_directories(const path &p, error_code &ec) {
    ec.clear();
    if (p.empty()) return false;
    file_status s = status(p, ec);
    if (s.type() == file_type::directory) { ec.clear(); return false; }
    if (s.type() != file_type::not_found && !ec) { ec = make_error_code(errc::file_exists); return false; }
    ec.clear();
    path normal = p.lexically_normal();
    std::string text = normal.string();
    while (text.size() > 1 && text[text.size() - 1] == '/') text.pop_back();
    path target(text);
    path parent = target.parent_path();
    if (!parent.empty() && parent != target) {
        create_directories(parent, ec);
        if (ec) return false;
    }
    return create_directory(target, ec);
}
inline bool create_directories(const path &p) { error_code ec; bool r = create_directories(p, ec); __fs_check(ec, "create_directories", p); return r; }

inline void create_symlink(const path &target, const path &link, error_code &ec) noexcept { if (::symlink(target.c_str(), link.c_str()) != 0) __fs_fail(ec); else ec.clear(); }
inline void create_symlink(const path &target, const path &link) { error_code ec; create_symlink(target, link, ec); __fs_check(ec, "create_symlink", link); }
inline void create_directory_symlink(const path &target, const path &link, error_code &ec) noexcept { create_symlink(target, link, ec); }
inline void create_directory_symlink(const path &target, const path &link) { create_symlink(target, link); }
inline void create_hard_link(const path &target, const path &link, error_code &ec) noexcept { if (::link(target.c_str(), link.c_str()) != 0) __fs_fail(ec); else ec.clear(); }
inline void create_hard_link(const path &target, const path &link) { error_code ec; create_hard_link(target, link, ec); __fs_check(ec, "create_hard_link", link); }

inline path read_symlink(const path &p, error_code &ec) {
    char buffer[4096];
    ssize_t n = ::readlink(p.c_str(), buffer, sizeof buffer - 1);
    if (n < 0) { __fs_fail(ec); return path(); }
    ec.clear();
    buffer[n] = 0;
    return path(buffer);
}
inline path read_symlink(const path &p) { error_code ec; path r = read_symlink(p, ec); __fs_check(ec, "read_symlink", p); return r; }

inline bool remove(const path &p, error_code &ec) noexcept {
    file_status s = symlink_status(p, ec);
    if (s.type() == file_type::not_found) { ec.clear(); return false; }
    if (ec) return false;
    int r = s.type() == file_type::directory ? ::rmdir(p.c_str()) : ::unlink(p.c_str());
    if (r != 0) { __fs_fail(ec); return false; }
    return true;
}
inline bool remove(const path &p) { error_code ec; bool r = remove(p, ec); __fs_check(ec, "remove", p); return r; }

inline uintmax_t remove_all(const path &p, error_code &ec) {
    file_status s = symlink_status(p, ec);
    if (s.type() == file_type::not_found) { ec.clear(); return 0; }
    if (ec) return (uintmax_t)-1;
    uintmax_t count = 0;
    if (s.type() == file_type::directory) {
        DIR *dir = opendir(p.c_str());
        if (!dir) { __fs_fail(ec); return (uintmax_t)-1; }
        std::vector<std::string> names;
        while (struct dirent *entry = readdir(dir)) {
            if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) continue;
            names.push_back(std::string(entry->d_name));
        }
        closedir(dir);
        for (size_t i = 0; i < names.size(); i++) {
            uintmax_t n = remove_all(p / path(names[i]), ec);
            if (ec) return (uintmax_t)-1;
            count += n;
        }
    }
    if (!remove(p, ec)) return ec ? (uintmax_t)-1 : count;
    return count + 1;
}
inline uintmax_t remove_all(const path &p) { error_code ec; uintmax_t r = remove_all(p, ec); __fs_check(ec, "remove_all", p); return r; }

inline void rename(const path &from, const path &to, error_code &ec) noexcept { if (::rename(from.c_str(), to.c_str()) != 0) __fs_fail(ec); else ec.clear(); }
inline void rename(const path &from, const path &to) { error_code ec; rename(from, to, ec); __fs_check(ec, "rename", from); }

inline void resize_file(const path &p, uintmax_t size, error_code &ec) noexcept { if (::truncate(p.c_str(), (off_t)size) != 0) __fs_fail(ec); else ec.clear(); }
inline void resize_file(const path &p, uintmax_t size) { error_code ec; resize_file(p, size, ec); __fs_check(ec, "resize_file", p); }

inline space_info space(const path &p, error_code &ec) noexcept {
    space_info info;
    info.capacity = info.free = info.available = (uintmax_t)-1;
    struct statvfs fs;
    if (::statvfs(p.c_str(), &fs) != 0) { __fs_fail(ec); return info; }
    ec.clear();
    info.capacity = (uintmax_t)fs.f_blocks * fs.f_frsize;
    info.free = (uintmax_t)fs.f_bfree * fs.f_frsize;
    info.available = (uintmax_t)fs.f_bavail * fs.f_frsize;
    return info;
}
inline space_info space(const path &p) { error_code ec; space_info r = space(p, ec); __fs_check(ec, "space", p); return r; }

inline bool equivalent(const path &a, const path &b, error_code &ec) noexcept {
    struct stat x, y;
    if (::stat(a.c_str(), &x) != 0 || ::stat(b.c_str(), &y) != 0) { __fs_fail(ec); return false; }
    ec.clear();
    return x.st_dev == y.st_dev && x.st_ino == y.st_ino;
}
inline bool equivalent(const path &a, const path &b) { error_code ec; bool r = equivalent(a, b, ec); __fs_check(ec, "equivalent", a); return r; }

inline path temp_directory_path(error_code &ec) {
    const char *names[4] = { "TMPDIR", "TMP", "TEMP", "TEMPDIR" };
    const char *dir = 0;
    for (int i = 0; i < 4 && !dir; i++) dir = getenv(names[i]);
    path p(dir ? dir : "/tmp");
    if (!is_directory(p, ec)) {
        if (!ec) ec = make_error_code(errc::not_a_directory);
        return path();
    }
    return p;
}
inline path temp_directory_path() { error_code ec; path r = temp_directory_path(ec); __fs_check(ec, "temp_directory_path", r); return r; }

inline bool copy_file(const path &from, const path &to, copy_options options, error_code &ec) {
    struct stat source;
    file_status s = __fs_status(from, ec, true, &source);
    if (ec) return false;
    if (s.type() != file_type::regular) { ec = make_error_code(errc::not_supported); return false; }
    struct stat target;
    error_code targetEc;
    file_status t = __fs_status(to, targetEc, true, &target);
    if (t.type() != file_type::not_found && !targetEc) {
        if (t.type() != file_type::regular || (source.st_dev == target.st_dev && source.st_ino == target.st_ino)) { ec = make_error_code(errc::file_exists); return false; }
        if ((options & copy_options::skip_existing) != copy_options::none) return false;
        if ((options & copy_options::update_existing) != copy_options::none) {
            if (source.st_mtim.tv_sec < target.st_mtim.tv_sec || (source.st_mtim.tv_sec == target.st_mtim.tv_sec && source.st_mtim.tv_nsec <= target.st_mtim.tv_nsec)) return false;
        } else if ((options & copy_options::overwrite_existing) == copy_options::none) {
            ec = make_error_code(errc::file_exists);
            return false;
        }
    }
    int in = ::open(from.c_str(), O_RDONLY);
    if (in < 0) { __fs_fail(ec); return false; }
    int out = ::open(to.c_str(), O_WRONLY | O_CREAT | O_TRUNC, source.st_mode & 07777);
    if (out < 0) { __fs_fail(ec); ::close(in); return false; }
    char buffer[65536];
    bool ok = true;
    for (;;) {
        ssize_t n = ::read(in, buffer, sizeof buffer);
        if (n == 0) break;
        if (n < 0) { if (errno == EINTR) continue; ok = false; break; }
        ssize_t done = 0;
        while (done < n) {
            ssize_t w = ::write(out, buffer + done, (size_t)(n - done));
            if (w < 0) { if (errno == EINTR) continue; ok = false; break; }
            done += w;
        }
        if (!ok) break;
    }
    if (!ok) __fs_fail(ec);
    ::close(in);
    ::close(out);
    if (!ok) return false;
    ::chmod(to.c_str(), source.st_mode & 07777);
    ec.clear();
    return true;
}
inline bool copy_file(const path &from, const path &to, error_code &ec) { return copy_file(from, to, copy_options::none, ec); }
inline bool copy_file(const path &from, const path &to, copy_options options = copy_options::none) { error_code ec; bool r = copy_file(from, to, options, ec); __fs_check(ec, "copy_file", from); return r; }

inline void copy_symlink(const path &from, const path &to, error_code &ec) {
    path target = read_symlink(from, ec);
    if (!ec) create_symlink(target, to, ec);
}

inline void copy(const path &from, const path &to, copy_options options, error_code &ec) {
    const bool links = (options & (copy_options::copy_symlinks | copy_options::skip_symlinks)) != copy_options::none;
    file_status f = links ? symlink_status(from, ec) : status(from, ec);
    if (ec) return;
    if (f.type() == file_type::symlink) {
        if ((options & copy_options::skip_symlinks) != copy_options::none) return;
        copy_symlink(from, to, ec);
        return;
    }
    error_code targetEc;
    file_status t = status(to, targetEc);
    if (f.type() == file_type::regular) {
        if ((options & copy_options::directories_only) != copy_options::none) return;
        if ((options & copy_options::create_symlinks) != copy_options::none) { create_symlink(from, to, ec); return; }
        if ((options & copy_options::create_hard_links) != copy_options::none) { create_hard_link(from, to, ec); return; }
        if (t.type() == file_type::directory) copy_file(from, to / from.filename(), options, ec);
        else copy_file(from, to, options, ec);
        return;
    }
    if (f.type() == file_type::directory) {
        if (t.type() != file_type::directory) {
            if (!create_directory(to, from, ec) && ec) return;
        }
        DIR *dir = opendir(from.c_str());
        if (!dir) { __fs_fail(ec); return; }
        std::vector<std::string> names;
        while (struct dirent *entry = readdir(dir)) {
            if (strcmp(entry->d_name, ".") == 0 || strcmp(entry->d_name, "..") == 0) continue;
            names.push_back(std::string(entry->d_name));
        }
        closedir(dir);
        const bool recursive = (options & copy_options::recursive) != copy_options::none;
        for (size_t i = 0; i < names.size(); i++) {
            path child = from / path(names[i]);
            if (!recursive && is_directory(child, ec)) continue;
            copy(child, to / path(names[i]), options, ec);
            if (ec) return;
        }
        ec.clear();
        return;
    }
    ec = make_error_code(errc::not_supported);
}
inline void copy(const path &from, const path &to, error_code &ec) { copy(from, to, copy_options::none, ec); }
inline void copy(const path &from, const path &to, copy_options options = copy_options::none) { error_code ec; copy(from, to, options, ec); __fs_check(ec, "copy", from); }

inline bool is_empty(const path &p, error_code &ec) {
    file_status s = status(p, ec);
    if (ec) return false;
    if (s.type() == file_type::directory) {
        DIR *dir = opendir(p.c_str());
        if (!dir) { __fs_fail(ec); return false; }
        bool empty = true;
        while (struct dirent *entry = readdir(dir)) {
            if (strcmp(entry->d_name, ".") != 0 && strcmp(entry->d_name, "..") != 0) { empty = false; break; }
        }
        closedir(dir);
        return empty;
    }
    return file_size(p, ec) == 0;
}
inline bool is_empty(const path &p) { error_code ec; bool r = is_empty(p, ec); __fs_check(ec, "is_empty", p); return r; }

// ---------------------------------------------------------------------------
// Directory entries and iteration

class directory_entry {
public:
    directory_entry() noexcept {}
    explicit directory_entry(const filesystem::path &p) : _path(p) {}
    directory_entry(const filesystem::path &p, error_code &ec) : _path(p) { ec.clear(); }
    directory_entry &operator=(const directory_entry &other) { _path = other._path; return *this; }
    void assign(const filesystem::path &p) { _path = p; }
    void assign(const filesystem::path &p, error_code &ec) { _path = p; ec.clear(); }
    void replace_filename(const filesystem::path &name) { _path.replace_filename(name); }
    void refresh() noexcept {}
    void refresh(error_code &ec) noexcept { ec.clear(); }
    const filesystem::path &path() const noexcept { return _path; }
    operator const filesystem::path &() const noexcept { return _path; }
    bool exists() const { return filesystem::exists(_path); }
    bool exists(error_code &ec) const noexcept { return filesystem::exists(_path, ec); }
    bool is_regular_file() const { return filesystem::is_regular_file(_path); }
    bool is_regular_file(error_code &ec) const noexcept { return filesystem::is_regular_file(_path, ec); }
    bool is_directory() const { return filesystem::is_directory(_path); }
    bool is_directory(error_code &ec) const noexcept { return filesystem::is_directory(_path, ec); }
    bool is_symlink() const { return filesystem::is_symlink(_path); }
    bool is_symlink(error_code &ec) const noexcept { return filesystem::is_symlink(_path, ec); }
    uintmax_t file_size() const { return filesystem::file_size(_path); }
    uintmax_t file_size(error_code &ec) const noexcept { return filesystem::file_size(_path, ec); }
    uintmax_t hard_link_count() const { return filesystem::hard_link_count(_path); }
    uintmax_t hard_link_count(error_code &ec) const noexcept { return filesystem::hard_link_count(_path, ec); }
    file_time_type last_write_time() const { return filesystem::last_write_time(_path); }
    file_time_type last_write_time(error_code &ec) const noexcept { return filesystem::last_write_time(_path, ec); }
    file_status status() const { return filesystem::status(_path); }
    file_status status(error_code &ec) const noexcept { return filesystem::status(_path, ec); }
    file_status symlink_status() const { return filesystem::symlink_status(_path); }
    file_status symlink_status(error_code &ec) const noexcept { return filesystem::symlink_status(_path, ec); }
    bool operator==(const directory_entry &other) const noexcept { return _path == other._path; }
    bool operator!=(const directory_entry &other) const noexcept { return _path != other._path; }
    bool operator<(const directory_entry &other) const noexcept { return _path < other._path; }
private:
    filesystem::path _path;
};

// An open directory and the entry last read from it.
struct __dir_stream {
    DIR *dir;
    path base;
    directory_entry entry;
    __dir_stream(DIR *d, const path &p) : dir(d), base(p) {}
    ~__dir_stream() { if (dir) closedir(dir); }
    // The next entry ("." and ".." passed over); false at the end.
    bool advance(error_code &ec) {
        for (;;) {
            errno = 0;
            struct dirent *found = readdir(dir);
            if (!found) {
                if (errno != 0) __fs_fail(ec);
                return false;
            }
            if (strcmp(found->d_name, ".") == 0 || strcmp(found->d_name, "..") == 0) continue;
            entry.assign(base / path(found->d_name));
            return true;
        }
    }
};

inline DIR *__fs_open_directory(const path &p, directory_options options, error_code &ec) {
    DIR *dir = opendir(p.c_str());
    if (dir) { ec.clear(); return dir; }
    int err = errno;
    if (err == EACCES && (options & directory_options::skip_permission_denied) != directory_options::none) { ec.clear(); return 0; }
    ec.assign(err, generic_category());
    return 0;
}

class directory_iterator {
public:
    typedef directory_entry value_type;
    typedef ptrdiff_t difference_type;
    typedef const directory_entry *pointer;
    typedef const directory_entry &reference;
    typedef input_iterator_tag iterator_category;

    directory_iterator() noexcept {}
    explicit directory_iterator(const path &p) { error_code ec; open(p, directory_options::none, ec); __fs_check(ec, "directory_iterator", p); }
    directory_iterator(const path &p, directory_options options) { error_code ec; open(p, options, ec); __fs_check(ec, "directory_iterator", p); }
    directory_iterator(const path &p, error_code &ec) { open(p, directory_options::none, ec); }
    directory_iterator(const path &p, directory_options options, error_code &ec) { open(p, options, ec); }
    directory_iterator(const directory_iterator &other) : _stream(other._stream) {}
    directory_iterator &operator=(const directory_iterator &other) { _stream = other._stream; return *this; }

    const directory_entry &operator*() const { return _stream->entry; }
    const directory_entry *operator->() const { return &_stream->entry; }
    directory_iterator &operator++() { error_code ec; increment(ec); __fs_check(ec, "directory_iterator::operator++", path()); return *this; }
    directory_iterator &increment(error_code &ec) {
        ec.clear();
        if (_stream && !_stream->advance(ec)) _stream.reset();
        return *this;
    }
    bool operator==(const directory_iterator &other) const noexcept { return _stream.get() == other._stream.get(); }
    bool operator!=(const directory_iterator &other) const noexcept { return _stream.get() != other._stream.get(); }
private:
    void open(const path &p, directory_options options, error_code &ec) {
        DIR *dir = __fs_open_directory(p, options, ec);
        if (!dir) return;
        _stream.reset(new __dir_stream(dir, p));
        if (!_stream->advance(ec)) _stream.reset();
    }
    shared_ptr<__dir_stream> _stream;
};
inline directory_iterator begin(directory_iterator it) noexcept { return it; }
inline directory_iterator end(const directory_iterator &) noexcept { return directory_iterator(); }

// The open directories, outermost first, and the entry last read.
struct __recursive_state {
    std::vector<__dir_stream *> stack;
    directory_options options;
    bool pending;
    ~__recursive_state() { for (size_t i = 0; i < stack.size(); i++) delete stack[i]; }
};

class recursive_directory_iterator {
public:
    typedef directory_entry value_type;
    typedef ptrdiff_t difference_type;
    typedef const directory_entry *pointer;
    typedef const directory_entry &reference;
    typedef input_iterator_tag iterator_category;

    recursive_directory_iterator() noexcept {}
    explicit recursive_directory_iterator(const path &p) { error_code ec; open(p, directory_options::none, ec); __fs_check(ec, "recursive_directory_iterator", p); }
    recursive_directory_iterator(const path &p, directory_options options) { error_code ec; open(p, options, ec); __fs_check(ec, "recursive_directory_iterator", p); }
    recursive_directory_iterator(const path &p, error_code &ec) { open(p, directory_options::none, ec); }
    recursive_directory_iterator(const path &p, directory_options options, error_code &ec) { open(p, options, ec); }
    recursive_directory_iterator(const recursive_directory_iterator &other) : _state(other._state) {}
    recursive_directory_iterator &operator=(const recursive_directory_iterator &other) { _state = other._state; return *this; }

    const directory_entry &operator*() const { return top()->entry; }
    const directory_entry *operator->() const { return &top()->entry; }
    directory_options options() const { return _state->options; }
    int depth() const { return (int)_state->stack.size() - 1; }
    bool recursion_pending() const { return _state->pending; }
    void disable_recursion_pending() { _state->pending = false; }

    recursive_directory_iterator &operator++() { error_code ec; increment(ec); __fs_check(ec, "recursive_directory_iterator::operator++", path()); return *this; }
    recursive_directory_iterator &increment(error_code &ec) {
        ec.clear();
        if (!_state) return *this;
        // Into the entry when it is a directory (a link to one only when
        // asked), then on to the next entry at the deepest level left.
        if (_state->pending) {
            const directory_entry &entry = top()->entry;
            const bool follow = (_state->options & directory_options::follow_directory_symlink) != directory_options::none;
            error_code statusEc;
            file_status s = follow ? entry.status(statusEc) : entry.symlink_status(statusEc);
            if (!statusEc && s.type() == file_type::directory) {
                DIR *dir = __fs_open_directory(entry.path(), _state->options, ec);
                if (ec) return *this;
                if (dir) _state->stack.push_back(new __dir_stream(dir, entry.path()));
            }
        }
        _state->pending = true;
        next(ec);
        return *this;
    }
    void pop(error_code &ec) {
        ec.clear();
        delete top();
        _state->stack.pop_back();
        _state->pending = true;
        next(ec);
    }
    void pop() { error_code ec; pop(ec); __fs_check(ec, "recursive_directory_iterator::pop", path()); }

    bool operator==(const recursive_directory_iterator &other) const noexcept { return _state.get() == other._state.get(); }
    bool operator!=(const recursive_directory_iterator &other) const noexcept { return _state.get() != other._state.get(); }
private:
    __dir_stream *top() const { return _state->stack[_state->stack.size() - 1]; }
    void open(const path &p, directory_options options, error_code &ec) {
        DIR *dir = __fs_open_directory(p, options, ec);
        if (!dir) return;
        _state.reset(new __recursive_state());
        _state->options = options;
        _state->pending = true;
        _state->stack.push_back(new __dir_stream(dir, p));
        next(ec);
    }
    // The next entry of the innermost directory, the finished ones
    // closed; the end when none is left.
    void next(error_code &ec) {
        while (!_state->stack.empty()) {
            if (top()->advance(ec)) return;
            if (ec) return;
            delete top();
            _state->stack.pop_back();
        }
        _state.reset();
    }
    shared_ptr<__recursive_state> _state;
};
inline recursive_directory_iterator begin(recursive_directory_iterator it) noexcept { return it; }
inline recursive_directory_iterator end(const recursive_directory_iterator &) noexcept { return recursive_directory_iterator(); }

}
