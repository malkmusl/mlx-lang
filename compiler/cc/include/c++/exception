// <exception>: std::exception and its kin as classes (exceptions are
// not thrown by mlx-cc: `throw` is refused; the types exist for code
// that names them), terminate.
#ifndef __MLXCC_EXCEPTION
#define __MLXCC_EXCEPTION
#include <stdlib.h>

namespace std {

class exception {
public:
    exception() noexcept {}
    exception(const exception &) noexcept {}
    exception &operator=(const exception &) noexcept { return *this; }
    virtual ~exception() noexcept {}
    virtual const char *what() const noexcept { return "std::exception"; }
};

class bad_exception : public exception {
public:
    const char *what() const noexcept { return "std::bad_exception"; }
};

typedef void (*terminate_handler)();
inline void terminate() noexcept { abort(); }
inline terminate_handler set_terminate(terminate_handler) noexcept { return 0; }
inline terminate_handler get_terminate() noexcept { return 0; }
inline bool uncaught_exception() noexcept { return false; }
inline int uncaught_exceptions() noexcept { return 0; }

class nested_exception {
public:
    nested_exception() noexcept {}
    virtual ~nested_exception() {}
};

}
#endif
