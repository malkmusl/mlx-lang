namespace std {

template <class T> constexpr typename remove_reference<T>::type &&move(T &&x) noexcept { return static_cast<typename remove_reference<T>::type &&>(x); }
template <class T> constexpr T &&forward(typename remove_reference<T>::type &x) noexcept { return static_cast<T &&>(x); }
template <class T> constexpr T &&forward(typename remove_reference<T>::type &&x) noexcept { return static_cast<T &&>(x); }
template <class E> constexpr typename underlying_type<E>::type to_underlying(E e) noexcept { return static_cast<typename underlying_type<E>::type>(e); }
template <class T> constexpr const T &as_const(T &x) noexcept { return x; }

template <class T> void swap(T &a, T &b) {
    T held(move(a));
    a = move(b);
    b = move(held);
}
template <class T, size_t N> void swap(T (&a)[N], T (&b)[N]) {
    for (size_t i = 0; i < N; i++) swap(a[i], b[i]);
}
template <class T, class U = T> T exchange(T &object, U &&value) {
    T old(move(object));
    object = forward<U>(value);
    return old;
}

template <class T, T... Is> struct integer_sequence {
    typedef T value_type;
    static constexpr size_t size() noexcept { return sizeof...(Is); }
};
template <size_t... Is> using index_sequence = integer_sequence<size_t, Is...>;
// (Halves joined, the second's numbers shifted: instances nest log N
// deep, not N: WTF's enumNames<E>() makes one of 511 for a uint16_t enum.)
template <class T, class A, class B> struct __join_integer_sequence;
template <class T, T... As, T... Bs> struct __join_integer_sequence<T, integer_sequence<T, As...>, integer_sequence<T, Bs...> > { typedef integer_sequence<T, As..., (T(sizeof...(As)) + Bs)...> type; };
template <class T, size_t N> struct __make_integer_sequence { typedef typename __join_integer_sequence<T, typename __make_integer_sequence<T, N / 2>::type, typename __make_integer_sequence<T, N - N / 2>::type>::type type; };
template <class T> struct __make_integer_sequence<T, 0> { typedef integer_sequence<T> type; };
template <class T> struct __make_integer_sequence<T, 1> { typedef integer_sequence<T, 0> type; };
template <class T, T N> using make_integer_sequence = typename __make_integer_sequence<T, size_t(N)>::type;
template <size_t N> using make_index_sequence = make_integer_sequence<size_t, N>;
template <class... T> using index_sequence_for = make_index_sequence<sizeof...(T)>;

struct in_place_t { explicit in_place_t() = default; };
constexpr in_place_t in_place = in_place_t();
template <class T> struct in_place_type_t { explicit in_place_type_t() = default; };
template <size_t I> struct in_place_index_t { explicit in_place_index_t() = default; };
template <class T> inline constexpr in_place_type_t<T> in_place_type{};
template <size_t I> inline constexpr in_place_index_t<I> in_place_index{};
struct piecewise_construct_t { explicit piecewise_construct_t() = default; };
constexpr piecewise_construct_t piecewise_construct = piecewise_construct_t();

template <class... T> class tuple;
template <size_t I, class T> struct tuple_element;
template <size_t I, class... Ts> constexpr typename tuple_element<I, tuple<Ts...> >::type &get(tuple<Ts...> &t);

template <class A, class B> struct pair {
    typedef A first_type;
    typedef B second_type;
    A first;
    B second;
    constexpr pair() : first(), second() {}
    constexpr pair(const A &a, const B &b) : first(a), second(b) {}
    template <class U, class V> constexpr pair(U &&a, V &&b) : first(forward<U>(a)), second(forward<V>(b)) {}
    constexpr pair(const pair &other) : first(other.first), second(other.second) {}
    constexpr pair(pair &&other) : first(move(other.first)), second(move(other.second)) {}
    template <class U, class V> constexpr pair(const pair<U, V> &other) : first(other.first), second(other.second) {}
    template <class U, class V> constexpr pair(pair<U, V> &&other) : first(forward<U>(other.first)), second(forward<V>(other.second)) {}
    // Each member made of its tuple's elements (std::map's and
    // std::unordered_map's emplace with std::piecewise_construct).
    template <class... X, class... Y> constexpr pair(piecewise_construct_t, tuple<X...> a, tuple<Y...> b)
        : pair(a, b, make_index_sequence<sizeof...(X)>(), make_index_sequence<sizeof...(Y)>()) {}
    template <class TA, class TB, size_t... I, size_t... J> constexpr pair(TA &a, TB &b, index_sequence<I...>, index_sequence<J...>)
        : first(std::forward<typename tuple_element<I, TA>::type>(std::get<I>(a))...), second(std::forward<typename tuple_element<J, TB>::type>(std::get<J>(b))...) {}
    constexpr pair &operator=(const pair &other) {
        first = other.first;
        second = other.second;
        return *this;
    }
    constexpr pair &operator=(pair &&other) {
        first = move(other.first);
        second = move(other.second);
        return *this;
    }
    void swap(pair &other) {
        std::swap(first, other.first);
        std::swap(second, other.second);
    }
};

template <class A, class B> pair<typename decay<A>::type, typename decay<B>::type> make_pair(A &&a, B &&b) {
    return pair<typename decay<A>::type, typename decay<B>::type>(forward<A>(a), forward<B>(b));
}

template <class A, class B> bool operator==(const pair<A, B> &x, const pair<A, B> &y) { return x.first == y.first && x.second == y.second; }
template <class A, class B> bool operator!=(const pair<A, B> &x, const pair<A, B> &y) { return !(x == y); }
template <class A, class B> bool operator<(const pair<A, B> &x, const pair<A, B> &y) {
    if (x.first < y.first) return true;
    if (y.first < x.first) return false;
    return x.second < y.second;
}
template <class A, class B> bool operator>(const pair<A, B> &x, const pair<A, B> &y) { return y < x; }
template <class A, class B> bool operator<=(const pair<A, B> &x, const pair<A, B> &y) { return !(y < x); }
template <class A, class B> bool operator>=(const pair<A, B> &x, const pair<A, B> &y) { return !(x < y); }
// (C++20's three-way comparison, first by first: WebCore's
// CompositionHighlight orders by `make_pair(start, end) <=> ...`.)
template <class A, class B> constexpr auto operator<=>(const pair<A, B> &x, const pair<A, B> &y) {
    auto byFirst = x.first <=> y.first;
    if (byFirst != 0) return byFirst;
    return x.second <=> y.second;
}

template <size_t I, class T> struct tuple_element;
template <class T> struct tuple_size;
template <class A, class B> struct tuple_size<pair<A, B> > : integral_constant<size_t, 2> {};
template <class A, class B> struct tuple_element<0, pair<A, B> > { typedef A type; };
template <class A, class B> struct tuple_element<1, pair<A, B> > { typedef B type; };
// A const tuple-like class's (`std::tuple_size_v<std::remove_reference_t<T>>`
// of a `const T &`, WTF::apply's): its class's, where that has one.
template <class T, class = void> struct __tuple_size_of_const {};
template <class T> struct __tuple_size_of_const<T, void_t<decltype(tuple_size<T>::value)> > : integral_constant<size_t, tuple_size<T>::value> {};
template <class T> struct tuple_size<const T> : __tuple_size_of_const<T> {};
template <size_t I, class T> struct tuple_element<I, const T> { typedef const typename tuple_element<I, T>::type type; };
template <size_t I, class T> using tuple_element_t = typename tuple_element<I, T>::type;
template <class T> constexpr size_t tuple_size_v = tuple_size<T>::value;

template <size_t I, class A, class B> struct __pair_get;
template <class A, class B> struct __pair_get<0, A, B> {
    static A &get(pair<A, B> &p) { return p.first; }
    static const A &get(const pair<A, B> &p) { return p.first; }
};
template <class A, class B> struct __pair_get<1, A, B> {
    static B &get(pair<A, B> &p) { return p.second; }
    static const B &get(const pair<A, B> &p) { return p.second; }
};
template <size_t I, class A, class B> typename tuple_element<I, pair<A, B> >::type &get(pair<A, B> &p) { return __pair_get<I, A, B>::get(p); }
template <size_t I, class A, class B> const typename tuple_element<I, pair<A, B> >::type &get(const pair<A, B> &p) { return __pair_get<I, A, B>::get(p); }




