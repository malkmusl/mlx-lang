// <new>: the allocation functions `new` and `delete` call (a program
// may define its own; mlxlibcpp defines them over malloc and free), and
// placement new, which mlx-cc builds in.
#ifndef __MLXCC_NEW
#define __MLXCC_NEW
#include <stddef.h>
void *operator new(size_t size);
void *operator new[](size_t size);
void operator delete(void *p);
void operator delete[](void *p);
inline void *operator new(size_t, void *where) { return where; }
inline void *operator new[](size_t, void *where) { return where; }
#ifdef __cplusplus
namespace std {
// C++20: a class's `operator delete(T *, std::destroying_delete_t)`
// destroys and frees the object itself.
struct destroying_delete_t { explicit destroying_delete_t() = default; };
inline constexpr destroying_delete_t destroying_delete {};
// The object at p, which a new object replaced (here: p itself).
template <class T> constexpr T *launder(T *p) noexcept { return p; }
}
#endif
#endif
