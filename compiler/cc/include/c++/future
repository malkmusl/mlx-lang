// <future>: std::promise and std::future over a shared state (a value
// set once, waited for under a mutex and a condition variable),
// std::shared_future, std::async (a thread of its own for
// launch::async, the call made by get() or wait() for launch::deferred).
// No exceptions: set_exception is not here.
#ifndef __MLXCC_FUTURE
#define __MLXCC_FUTURE
#include <stddef.h>
#include <new>
#include <utility>
#include <type_traits>
#include <memory>
#include <mutex>
#include <condition_variable>
#include <thread>
#include <chrono>
#include <functional>
#include <tuple>

namespace std {

enum class future_status { ready, timeout, deferred };
enum class launch { async = 1, deferred = 2 };
inline constexpr launch operator|(launch a, launch b) { return launch(int(a) | int(b)); }
inline constexpr launch operator&(launch a, launch b) { return launch(int(a) & int(b)); }

// The state a promise and its future share: the value (in raw storage
// until set), whether it is set, a deferred call making it.
template <class T> struct __future_state {
    mutex lock;
    condition_variable changed;
    bool ready = false;
    alignas(T) unsigned char storage[sizeof(T)];
    function<void()> deferred;
    ~__future_state() { if (ready) value().~T(); }
    T &value() { return *reinterpret_cast<T *>(storage); }
    template <class U> void set(U &&v) {
        unique_lock<mutex> held(lock);
        ::new ((void *)storage) T(std::forward<U>(v));
        ready = true;
        changed.notify_all();
    }
    void wait() {
        function<void()> call;
        {
            unique_lock<mutex> held(lock);
            call = std::move(deferred);
            deferred = nullptr;
        }
        if (call) call();
        unique_lock<mutex> held(lock);
        while (!ready) changed.wait(held);
    }
};
template <> struct __future_state<void> {
    mutex lock;
    condition_variable changed;
    bool ready = false;
    function<void()> deferred;
    void set() {
        unique_lock<mutex> held(lock);
        ready = true;
        changed.notify_all();
    }
    void wait() {
        function<void()> call;
        {
            unique_lock<mutex> held(lock);
            call = std::move(deferred);
            deferred = nullptr;
        }
        if (call) call();
        unique_lock<mutex> held(lock);
        while (!ready) changed.wait(held);
    }
};

template <class T> class shared_future;

template <class T> class future {
public:
    future() noexcept {}
    explicit future(shared_ptr<__future_state<T> > s) : _state(std::move(s)) {}
    future(future &&other) noexcept : _state(std::move(other._state)) {}
    future(const future &) = delete;
    future &operator=(future &&other) noexcept { _state = std::move(other._state); return *this; }
    future &operator=(const future &) = delete;
    bool valid() const noexcept { return (bool)_state; }
    void wait() const { _state->wait(); }
    template <class R, class P> future_status wait_for(const chrono::duration<R, P> &) const {
        unique_lock<mutex> held(_state->lock);
        return _state->ready ? future_status::ready : (_state->deferred ? future_status::deferred : future_status::timeout);
    }
    T get() {
        _state->wait();
        shared_ptr<__future_state<T> > s = std::move(_state);
        return std::move(s->value());
    }
    shared_future<T> share() noexcept;
private:
    shared_ptr<__future_state<T> > _state;
};
template <> class future<void> {
public:
    future() noexcept {}
    explicit future(shared_ptr<__future_state<void> > s) : _state(std::move(s)) {}
    future(future &&other) noexcept : _state(std::move(other._state)) {}
    future(const future &) = delete;
    future &operator=(future &&other) noexcept { _state = std::move(other._state); return *this; }
    bool valid() const noexcept { return (bool)_state; }
    void wait() const { _state->wait(); }
    template <class R, class P> future_status wait_for(const chrono::duration<R, P> &) const {
        unique_lock<mutex> held(_state->lock);
        return _state->ready ? future_status::ready : (_state->deferred ? future_status::deferred : future_status::timeout);
    }
    void get() {
        _state->wait();
        _state = nullptr;
    }
private:
    shared_ptr<__future_state<void> > _state;
};

template <class T> class shared_future {
public:
    shared_future() noexcept {}
    explicit shared_future(shared_ptr<__future_state<T> > s) : _state(std::move(s)) {}
    bool valid() const noexcept { return (bool)_state; }
    void wait() const { _state->wait(); }
    const T &get() const {
        _state->wait();
        return _state->value();
    }
private:
    shared_ptr<__future_state<T> > _state;
};
template <class T> shared_future<T> future<T>::share() noexcept { return shared_future<T>(std::move(_state)); }

template <class T> class promise {
public:
    promise() : _state(make_shared<__future_state<T> >()) {}
    promise(promise &&other) noexcept : _state(std::move(other._state)) {}
    promise(const promise &) = delete;
    promise &operator=(promise &&other) noexcept { _state = std::move(other._state); return *this; }
    future<T> get_future() { return future<T>(_state); }
    void set_value(const T &value) { _state->set(value); }
    void set_value(T &&value) { _state->set(std::move(value)); }
private:
    shared_ptr<__future_state<T> > _state;
};
template <> class promise<void> {
public:
    promise() : _state(make_shared<__future_state<void> >()) {}
    promise(promise &&other) noexcept : _state(std::move(other._state)) {}
    promise(const promise &) = delete;
    future<void> get_future() { return future<void>(_state); }
    void set_value() { _state->set(); }
private:
    shared_ptr<__future_state<void> > _state;
};

// The function and its arguments, copied, called by async.
template <class F, class... A> struct __async_call {
    F f;
    tuple<A...> args;
    decltype(auto) operator()() { return std::apply(f, args); }
};

// The call made into the state: its result set.
template <class R> struct __async_run {
    template <class F> static void run(__future_state<R> &state, F &f) { state.set(f()); }
};
template <> struct __async_run<void> {
    template <class F> static void run(__future_state<void> &state, F &f) {
        f();
        state.set();
    }
};

template <class F, class... Args> future<typename decay<decltype(declval<F>()(declval<Args>()...))>::type> async(launch policy, F &&f, Args &&... args) {
    typedef typename decay<decltype(declval<F>()(declval<Args>()...))>::type R;
    shared_ptr<__future_state<R> > state = make_shared<__future_state<R> >();
    function<R()> call = __async_call<typename decay<F>::type, typename decay<Args>::type...>{ std::forward<F>(f), tuple<typename decay<Args>::type...>(std::forward<Args>(args)...) };
    if ((int(policy) & int(launch::async)) != 0) {
        thread([state, call]() mutable { __async_run<R>::run(*state, call); }).detach();
    } else {
        // (The state's own call: it holds no owner of the state.)
        __future_state<R> *raw = state.get();
        state->deferred = [raw, call]() mutable { __async_run<R>::run(*raw, call); };
    }
    return future<R>(state);
}
template <class F, class... Args> future<typename decay<decltype(declval<F>()(declval<Args>()...))>::type> async(F &&f, Args &&... args) {
    return async(launch::async, std::forward<F>(f), std::forward<Args>(args)...);
}

}
#endif
