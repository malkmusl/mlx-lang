// <deque>: std::deque, elements in blocks of fixed size reached through a
// table of block pointers: pushing or popping at either end moves no
// element, so references to the others stay valid. Iterators are a
// deque and a position (random access). The allocator parameter is taken
// and not used (<__allocator>).
#ifndef __MLXCC_DEQUE
#define __MLXCC_DEQUE
#include <stddef.h>
#include <new>
#include <initializer_list>
#include <type_traits>
#include <utility>
#include <iterator>
#include <__allocator>

namespace std {

template <class D, class T> class __deque_iterator {
public:
    typedef random_access_iterator_tag iterator_category;
    typedef typename remove_cv<T>::type value_type;
    typedef ptrdiff_t difference_type;
    typedef T *pointer;
    typedef T &reference;

    D *owner;
    size_t at;

    __deque_iterator() : owner(0), at(0) {}
    __deque_iterator(D *d, size_t i) : owner(d), at(i) {}
    // (iterator to const_iterator)
    template <class D2, class T2, class = typename enable_if<is_convertible<D2 *, D *>::value>::type>
    __deque_iterator(const __deque_iterator<D2, T2> &other) : owner(other.owner), at(other.at) {}

    T &operator*() const { return (*owner)[at]; }
    T *operator->() const { return &(*owner)[at]; }
    T &operator[](ptrdiff_t n) const { return (*owner)[at + n]; }
    __deque_iterator &operator++() { at++; return *this; }
    __deque_iterator operator++(int) { __deque_iterator old = *this; at++; return old; }
    __deque_iterator &operator--() { at--; return *this; }
    __deque_iterator operator--(int) { __deque_iterator old = *this; at--; return old; }
    __deque_iterator &operator+=(ptrdiff_t n) { at += n; return *this; }
    __deque_iterator &operator-=(ptrdiff_t n) { at -= n; return *this; }
    __deque_iterator operator+(ptrdiff_t n) const { return __deque_iterator(owner, at + n); }
    __deque_iterator operator-(ptrdiff_t n) const { return __deque_iterator(owner, at - n); }
    template <class D2, class T2> ptrdiff_t operator-(const __deque_iterator<D2, T2> &other) const { return (ptrdiff_t)at - (ptrdiff_t)other.at; }
    template <class D2, class T2> bool operator==(const __deque_iterator<D2, T2> &other) const { return at == other.at; }
    template <class D2, class T2> bool operator!=(const __deque_iterator<D2, T2> &other) const { return at != other.at; }
    template <class D2, class T2> bool operator<(const __deque_iterator<D2, T2> &other) const { return at < other.at; }
    template <class D2, class T2> bool operator>(const __deque_iterator<D2, T2> &other) const { return at > other.at; }
    template <class D2, class T2> bool operator<=(const __deque_iterator<D2, T2> &other) const { return at <= other.at; }
    template <class D2, class T2> bool operator>=(const __deque_iterator<D2, T2> &other) const { return at >= other.at; }
};
template <class D, class T> __deque_iterator<D, T> operator+(ptrdiff_t n, const __deque_iterator<D, T> &it) { return it + n; }

template <class T, class Alloc = allocator<T> > class deque {
public:
    typedef T value_type;
    typedef Alloc allocator_type;
    typedef T &reference;
    typedef const T &const_reference;
    typedef T *pointer;
    typedef const T *const_pointer;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef __deque_iterator<deque, T> iterator;
    typedef __deque_iterator<const deque, const T> const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

    deque() noexcept : table(0), blocks(0), first(0), count(0) {}
    explicit deque(const Alloc &) noexcept : deque() {}
    explicit deque(size_t n, const Alloc & = Alloc()) : deque() { resize(n); }
    deque(size_t n, const T &value, const Alloc & = Alloc()) : deque() { for (size_t i = 0; i < n; i++) push_back(value); }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> deque(It from, It to, const Alloc & = Alloc()) : deque() {
        for (; from != to; ++from) emplace_back(*from);
    }
    deque(initializer_list<T> list, const Alloc & = Alloc()) : deque() {
        for (const T *at = list.begin(); at != list.end(); ++at) push_back(*at);
    }
    deque(const deque &other) : deque() {
        for (size_t i = 0; i < other.count; i++) push_back(other[i]);
    }
    deque(deque &&other) noexcept : table(other.table), blocks(other.blocks), first(other.first), count(other.count) {
        other.table = 0;
        other.blocks = 0;
        other.first = 0;
        other.count = 0;
    }
    ~deque() {
        clear();
        for (size_t i = 0; i < blocks; i++) ::operator delete(table[i]);
        ::operator delete(table);
    }
    deque &operator=(const deque &other) {
        if (this != &other) {
            clear();
            for (size_t i = 0; i < other.count; i++) push_back(other[i]);
        }
        return *this;
    }
    deque &operator=(deque &&other) noexcept {
        deque moved(static_cast<deque &&>(other));
        swap(moved);
        return *this;
    }
    allocator_type get_allocator() const noexcept { return allocator_type(); }

    size_t size() const noexcept { return count; }
    bool empty() const noexcept { return count == 0; }
    size_t max_size() const noexcept { return size_t(-1) / sizeof(T); }
    T &operator[](size_t i) { size_t p = first + i; return table[p / BLOCK][p % BLOCK]; }
    const T &operator[](size_t i) const { size_t p = first + i; return table[p / BLOCK][p % BLOCK]; }
    T &at(size_t i) { return (*this)[i]; }
    const T &at(size_t i) const { return (*this)[i]; }
    T &front() { return (*this)[0]; }
    const T &front() const { return (*this)[0]; }
    T &back() { return (*this)[count - 1]; }
    const T &back() const { return (*this)[count - 1]; }
    iterator begin() noexcept { return iterator(this, 0); }
    iterator end() noexcept { return iterator(this, count); }
    const_iterator begin() const noexcept { return const_iterator(this, 0); }
    const_iterator end() const noexcept { return const_iterator(this, count); }
    const_iterator cbegin() const noexcept { return const_iterator(this, 0); }
    const_iterator cend() const noexcept { return const_iterator(this, count); }
    reverse_iterator rbegin() noexcept { return reverse_iterator(end()); }
    reverse_iterator rend() noexcept { return reverse_iterator(begin()); }
    const_reverse_iterator rbegin() const noexcept { return const_reverse_iterator(end()); }
    const_reverse_iterator rend() const noexcept { return const_reverse_iterator(begin()); }

    void push_back(const T &value) { emplace_back(value); }
    void push_back(T &&value) { emplace_back(static_cast<T &&>(value)); }
    void push_front(const T &value) { emplace_front(value); }
    void push_front(T &&value) { emplace_front(static_cast<T &&>(value)); }
    template <class... A> T &emplace_back(A &&... args) {
        if (first + count == blocks * BLOCK) grow(false);
        size_t p = first + count;
        ensure(p / BLOCK);
        T *place = table[p / BLOCK] + p % BLOCK;
        ::new ((void *)place) T(std::forward<A>(args)...);
        count++;
        return *place;
    }
    template <class... A> T &emplace_front(A &&... args) {
        if (first == 0) grow(true);
        size_t p = first - 1;
        ensure(p / BLOCK);
        T *place = table[p / BLOCK] + p % BLOCK;
        ::new ((void *)place) T(std::forward<A>(args)...);
        first = p;
        count++;
        return *place;
    }
    void pop_back() {
        (*this)[count - 1].~T();
        count--;
    }
    void pop_front() {
        (*this)[0].~T();
        first++;
        count--;
        if (count == 0) first = blocks * BLOCK / 2;
    }
    void clear() noexcept {
        for (size_t i = 0; i < count; i++) (*this)[i].~T();
        count = 0;
        first = blocks * BLOCK / 2;
    }
    void resize(size_t n) {
        while (count > n) pop_back();
        while (count < n) emplace_back();
    }
    void resize(size_t n, const T &value) {
        while (count > n) pop_back();
        while (count < n) push_back(value);
    }
    void shrink_to_fit() {}
    template <class... A> iterator emplace(const_iterator where, A &&... args) {
        size_t index = where.at;
        emplace_back(std::forward<A>(args)...);
        for (size_t i = count - 1; i > index; i--) swapAt(i, i - 1);
        return iterator(this, index);
    }
    iterator insert(const_iterator where, const T &value) { return emplace(where, value); }
    iterator insert(const_iterator where, T &&value) { return emplace(where, static_cast<T &&>(value)); }
    iterator insert(const_iterator where, size_t n, const T &value) {
        size_t index = where.at;
        for (size_t i = 0; i < n; i++) insert(const_iterator(this, index + i), value);
        return iterator(this, index);
    }
    template <class It, class = typename enable_if<!is_integral<It>::value>::type> iterator insert(const_iterator where, It from, It to) {
        size_t index = where.at;
        size_t at = index;
        for (; from != to; ++from) insert(const_iterator(this, at++), *from);
        return iterator(this, index);
    }
    iterator erase(const_iterator where) { return erase(where, where + 1); }
    iterator erase(const_iterator from, const_iterator to) {
        size_t a = from.at;
        size_t n = to.at - from.at;
        if (n == 0) return iterator(this, a);
        if (a == 0) {
            for (size_t i = 0; i < n; i++) pop_front();
            return iterator(this, 0);
        }
        for (size_t i = a + n; i < count; i++) (*this)[i - n] = static_cast<T &&>((*this)[i]);
        for (size_t i = 0; i < n; i++) pop_back();
        return iterator(this, a);
    }
    void swap(deque &other) noexcept {
        T **t = table; table = other.table; other.table = t;
        size_t b = blocks; blocks = other.blocks; other.blocks = b;
        size_t f = first; first = other.first; other.first = f;
        size_t c = count; count = other.count; other.count = c;
    }

private:
    static constexpr size_t BLOCK = sizeof(T) <= 256 ? 4096 / sizeof(T) : 16;
    // The table of BLOCKS block pointers (null until a block is used);
    // element i is at position FIRST + i of the blocks laid end to end.
    T **table;
    size_t blocks;
    size_t first;
    size_t count;

    void ensure(size_t block) {
        if (!table[block]) table[block] = static_cast<T *>(::operator new(BLOCK * sizeof(T)));
    }
    // A table twice the size (at least 2), the blocks in its middle: room
    // made at the front (FRONT) or the back.
    void grow(bool front) {
        size_t more = blocks ? blocks : 2;
        T **bigger = static_cast<T **>(::operator new((blocks + more) * sizeof(T *)));
        size_t shift = front ? more : 0;
        for (size_t i = 0; i < blocks + more; i++) bigger[i] = 0;
        for (size_t i = 0; i < blocks; i++) bigger[i + shift] = table[i];
        ::operator delete(table);
        table = bigger;
        if (blocks == 0) first = more * BLOCK / 2;
        else first += shift * BLOCK;
        blocks += more;
    }
    void swapAt(size_t a, size_t b) {
        T held(static_cast<T &&>((*this)[a]));
        (*this)[a] = static_cast<T &&>((*this)[b]);
        (*this)[b] = static_cast<T &&>(held);
    }
};

template <class T, class A> bool operator==(const deque<T, A> &a, const deque<T, A> &b) {
    if (a.size() != b.size()) return false;
    for (size_t i = 0; i < a.size(); i++)
        if (!(a[i] == b[i])) return false;
    return true;
}
template <class T, class A> bool operator!=(const deque<T, A> &a, const deque<T, A> &b) { return !(a == b); }
template <class T, class A> void swap(deque<T, A> &a, deque<T, A> &b) noexcept { a.swap(b); }

}
#endif
