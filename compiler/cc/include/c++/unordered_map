// <unordered_map>: std::unordered_map and std::unordered_multimap's
// common part, a hash table of chained nodes (a node keeps its place, so
// iterators and references survive insertions; a rehash only relinks
// the nodes). Keys hash with Hash and compare with KeyEqual; the
// allocator parameter is accepted and not used; at() of a missing key
// aborts (no exceptions).
#ifndef __MLXCC_UNORDERED_MAP
#define __MLXCC_UNORDERED_MAP
#include <stddef.h>
#include <utility>
#include <functional>
#include <initializer_list>
#include <iterator>
#include <stdlib.h>

namespace std {

template <class Value> struct __hash_node {
    Value value;
    __hash_node *next;
    size_t hash;
    template <class... Args> __hash_node(size_t h, Args &&... args) : value(forward<Args>(args)...), next(0), hash(h) {}
};

// The table: buckets of node chains; KeyOf gives a value's key.
template <class Key, class Value, class KeyOf, class Hash, class KeyEqual> class __hash_table {
public:
    typedef __hash_node<Value> node;
    node **buckets;
    size_t bucketCount;
    size_t count;
    Hash hasher;
    KeyEqual equal;

    __hash_table() : buckets(0), bucketCount(0), count(0) {}
    ~__hash_table() { clear(); delete[] buckets; }

    void clear() {
        for (size_t b = 0; b < bucketCount; b++) {
            node *n = buckets[b];
            while (n) { node *next = n->next; delete n; n = next; }
            buckets[b] = 0;
        }
        count = 0;
    }

    void rehash(size_t wanted) {
        if (wanted < 8) wanted = 8;
        if (wanted <= bucketCount) return;
        node **fresh = new node *[wanted];
        for (size_t b = 0; b < wanted; b++) fresh[b] = 0;
        for (size_t b = 0; b < bucketCount; b++) {
            node *n = buckets[b];
            while (n) {
                node *next = n->next;
                size_t at = n->hash % wanted;
                n->next = fresh[at];
                fresh[at] = n;
                n = next;
            }
        }
        delete[] buckets;
        buckets = fresh;
        bucketCount = wanted;
    }

    node *find(const Key &key) const {
        if (!bucketCount) return 0;
        size_t h = hasher(key);
        for (node *n = buckets[h % bucketCount]; n; n = n->next)
            if (n->hash == h && equal(KeyOf::key(n->value), key)) return n;
        return 0;
    }

    // Links a made node in (the table grown when it would be over full).
    node *link(node *n) {
        if (count + 1 > bucketCount) rehash(bucketCount * 2);
        size_t at = n->hash % bucketCount;
        n->next = buckets[at];
        buckets[at] = n;
        count++;
        return n;
    }

    // Takes the node out of its chain (the caller owns it): false when
    // it is not in the table.
    bool detach(node *target) {
        if (!bucketCount) return false;
        node **link_ = &buckets[target->hash % bucketCount];
        while (*link_) {
            if (*link_ == target) {
                *link_ = target->next;
                target->next = 0;
                count--;
                return true;
            }
            link_ = &(*link_)->next;
        }
        return false;
    }
    bool unlink(node *target) {
        if (!detach(target)) return false;
        delete target;
        return true;
    }

    node *first() const {
        for (size_t b = 0; b < bucketCount; b++)
            if (buckets[b]) return buckets[b];
        return 0;
    }

    node *after(node *n) const {
        if (n->next) return n->next;
        for (size_t b = n->hash % bucketCount + 1; b < bucketCount; b++)
            if (buckets[b]) return buckets[b];
        return 0;
    }
};

template <class Table, class Value> class __hash_iterator {
public:
    typedef forward_iterator_tag iterator_category;
    typedef Value value_type;
    typedef ptrdiff_t difference_type;
    typedef Value *pointer;
    typedef Value &reference;
    const Table *table;
    typename Table::node *at;
    __hash_iterator() : table(0), at(0) {}
    __hash_iterator(const Table *t, typename Table::node *n) : table(t), at(n) {}
    template <class Other> __hash_iterator(const __hash_iterator<Table, Other> &other) : table(other.table), at(other.at) {}
    Value &operator*() const { return at->value; }
    Value *operator->() const { return &at->value; }
    __hash_iterator &operator++() { at = table->after(at); return *this; }
    __hash_iterator operator++(int) { __hash_iterator old = *this; at = table->after(at); return old; }
    friend bool operator==(const __hash_iterator &a, const __hash_iterator &b) { return a.at == b.at; }
    friend bool operator!=(const __hash_iterator &a, const __hash_iterator &b) { return a.at != b.at; }
};

template <class K, class V> struct __hash_map_key_of { static const K &key(const pair<const K, V> &p) { return p.first; } };

template <class K, class V, class Hash = hash<K>, class KeyEqual = equal_to<K>, class Alloc = void>
class unordered_map {
public:
    typedef K key_type;
    typedef V mapped_type;
    typedef pair<const K, V> value_type;
    typedef size_t size_type;
    typedef Hash hasher;
    typedef KeyEqual key_equal;
    typedef __hash_table<K, value_type, __hash_map_key_of<K, V>, Hash, KeyEqual> table_type;
    typedef __hash_iterator<table_type, value_type> iterator;
    typedef __hash_iterator<table_type, const value_type> const_iterator;

    unordered_map() {}
    explicit unordered_map(size_t buckets) { table.rehash(buckets); }
    unordered_map(initializer_list<value_type> list) { for (const value_type &v : list) insert(v); }
    unordered_map(const unordered_map &other) { for (const value_type &v : other) insert(v); }
    unordered_map(unordered_map &&other) noexcept { swap(other); }
    template <class It> unordered_map(It first, It last) { for (; first != last; ++first) insert(*first); }
    unordered_map &operator=(const unordered_map &other) {
        if (this != &other) { clear(); for (const value_type &v : other) insert(v); }
        return *this;
    }
    unordered_map &operator=(unordered_map &&other) noexcept {
        if (this != &other) { clear(); swap(other); }
        return *this;
    }

    size_t size() const { return table.count; }
    bool empty() const { return table.count == 0; }
    size_t bucket_count() const { return table.bucketCount; }
    void reserve(size_t n) { table.rehash(n); }
    void rehash(size_t n) { table.rehash(n); }
    void clear() { table.clear(); }

    iterator begin() { return iterator(&table, table.first()); }
    iterator end() { return iterator(&table, 0); }
    const_iterator begin() const { return const_iterator(&table, table.first()); }
    const_iterator end() const { return const_iterator(&table, 0); }
    const_iterator cbegin() const { return begin(); }
    const_iterator cend() const { return end(); }

    iterator find(const K &key) { return iterator(&table, table.find(key)); }
    const_iterator find(const K &key) const { return const_iterator(&table, table.find(key)); }
    size_t count(const K &key) const { return table.find(key) ? 1 : 0; }
    bool contains(const K &key) const { return table.find(key) != 0; }

    V &operator[](const K &key) {
        typename table_type::node *n = table.find(key);
        if (!n) n = table.link(new typename table_type::node(table.hasher(key), key, V()));
        return n->value.second;
    }
    V &at(const K &key) {
        typename table_type::node *n = table.find(key);
        if (!n) abort();
        return n->value.second;
    }
    const V &at(const K &key) const {
        typename table_type::node *n = table.find(key);
        if (!n) abort();
        return n->value.second;
    }

    pair<iterator, bool> insert(const value_type &v) {
        typename table_type::node *n = table.find(v.first);
        if (n) return pair<iterator, bool>(iterator(&table, n), false);
        return pair<iterator, bool>(iterator(&table, table.link(new typename table_type::node(table.hasher(v.first), v))), true);
    }
    template <class P> pair<iterator, bool> insert(P &&v) { return emplace(forward<P>(v)); }
    template <class It> void insert(It first, It last) { for (; first != last; ++first) insert(*first); }
    void insert(initializer_list<value_type> list) { for (const value_type &v : list) insert(v); }
    template <class... Args> pair<iterator, bool> emplace(Args &&... args) {
        typename table_type::node *made = new typename table_type::node(0, forward<Args>(args)...);
        typename table_type::node *n = table.find(made->value.first);
        if (n) { delete made; return pair<iterator, bool>(iterator(&table, n), false); }
        made->hash = table.hasher(made->value.first);
        return pair<iterator, bool>(iterator(&table, table.link(made)), true);
    }
    template <class... Args> pair<iterator, bool> try_emplace(const K &key, Args &&... args) {
        typename table_type::node *n = table.find(key);
        if (n) return pair<iterator, bool>(iterator(&table, n), false);
        return pair<iterator, bool>(iterator(&table, table.link(new typename table_type::node(table.hasher(key), key, V(forward<Args>(args)...)))), true);
    }
    template <class M> pair<iterator, bool> insert_or_assign(const K &key, M &&value) {
        typename table_type::node *n = table.find(key);
        if (n) { n->value.second = forward<M>(value); return pair<iterator, bool>(iterator(&table, n), false); }
        return pair<iterator, bool>(iterator(&table, table.link(new typename table_type::node(table.hasher(key), key, forward<M>(value)))), true);
    }

    // Node handles (C++17): a node taken out of the map, its key
    // changeable, put back into a map by insert.
    class node_type {
    public:
        typedef K key_type;
        typedef V mapped_type;
        node_type() : n(0) {}
        node_type(node_type &&other) noexcept : n(other.n) { other.n = 0; }
        node_type &operator=(node_type &&other) noexcept {
            if (this != &other) { delete n; n = other.n; other.n = 0; }
            return *this;
        }
        ~node_type() { delete n; }
        bool empty() const { return n == 0; }
        explicit operator bool() const { return n != 0; }
        key_type &key() const { return const_cast<key_type &>(n->value.first); }
        mapped_type &mapped() const { return n->value.second; }
    private:
        friend class unordered_map;
        explicit node_type(typename table_type::node *taken) : n(taken) {}
        node_type(const node_type &);
        node_type &operator=(const node_type &);
        typename table_type::node *n;
    };
    struct insert_return_type {
        iterator position;
        bool inserted;
        node_type node;
    };
    node_type extract(const K &key) {
        typename table_type::node *n = table.find(key);
        if (!n || !table.detach(n)) return node_type();
        return node_type(n);
    }
    node_type extract(const_iterator position) {
        typename table_type::node *n = position.at;
        if (!n || !table.detach(n)) return node_type();
        return node_type(n);
    }
    insert_return_type insert(node_type &&handle) {
        insert_return_type result;
        if (!handle.n) { result.position = end(); result.inserted = false; return result; }
        typename table_type::node *existing = table.find(handle.n->value.first);
        if (existing) {
            result.position = iterator(&table, existing);
            result.inserted = false;
            result.node = std::move(handle);
            return result;
        }
        handle.n->hash = table.hasher(handle.n->value.first);
        result.position = iterator(&table, table.link(handle.n));
        result.inserted = true;
        handle.n = 0;
        return result;
    }

    size_t erase(const K &key) {
        typename table_type::node *n = table.find(key);
        return n && table.unlink(n) ? 1 : 0;
    }
    iterator erase(const_iterator position) {
        typename table_type::node *next = table.after(position.at);
        table.unlink(position.at);
        return iterator(&table, next);
    }
    iterator erase(iterator position) { return erase(const_iterator(position)); }

    void swap(unordered_map &other) noexcept {
        std::swap(table.buckets, other.table.buckets);
        std::swap(table.bucketCount, other.table.bucketCount);
        std::swap(table.count, other.table.count);
    }

private:
    table_type table;
};

// Equal: the same keys, each with an equal value (ANGLE's
// ProgramExecutableVk compares its immutable samplers' maps).
template <class K, class V, class H, class E, class A>
bool operator==(const unordered_map<K, V, H, E, A> &a, const unordered_map<K, V, H, E, A> &b) {
    if (a.size() != b.size()) return false;
    for (const auto &entry : a) {
        auto found = b.find(entry.first);
        if (found == b.end() || !(found->second == entry.second)) return false;
    }
    return true;
}
template <class K, class V, class H, class E, class A>
bool operator!=(const unordered_map<K, V, H, E, A> &a, const unordered_map<K, V, H, E, A> &b) { return !(a == b); }

}
#endif
