// <typeinfo>: std::type_info, named and compared by its mangled name,
// and the exceptions bad_cast and bad_typeid. typeid(T) is
// __mlxcc_typeid_of<T>() (mlx-cc writes it so): one type_info object of
// the program's per type (a class template's static member), named by
// the type's code; typeid of an expression is that of its type (mlx-cc
// keeps no run-time type of a polymorphic object).
#ifndef __MLXCC_TYPEINFO
#define __MLXCC_TYPEINFO
#include <stddef.h>
#include <string.h>
#include <exception>

namespace std {

class type_info {
public:
    virtual ~type_info() {}
    const char *name() const { return __name; }
    bool operator==(const type_info &other) const { return this == &other || strcmp(__name, other.__name) == 0; }
    bool operator!=(const type_info &other) const { return !(*this == other); }
    bool before(const type_info &other) const { return strcmp(__name, other.__name) < 0; }
    size_t hash_code() const {
        size_t h = 14695981039346656037ULL;
        for (const char *p = __name; *p; ++p) h = (h ^ (unsigned char)*p) * 1099511628211ULL;
        return h;
    }
    type_info(const type_info &) = delete;
    type_info &operator=(const type_info &) = delete;

protected:
    explicit constexpr type_info(const char *n) : __name(n) {}
    const char *__name;
};

struct __mlxcc_type_info : public type_info {
    explicit constexpr __mlxcc_type_info(const char *n) : type_info(n) {}
};
template <class T> struct __mlxcc_typeid_holder { static const __mlxcc_type_info info; };
template <class T> const __mlxcc_type_info __mlxcc_typeid_holder<T>::info(__mlxcc_type_name(T));
template <class T> struct __mlxcc_bare { typedef T type; };
template <class T> struct __mlxcc_bare<const T> { typedef T type; };
template <class T> struct __mlxcc_bare<T &> { typedef typename __mlxcc_bare<T>::type type; };
template <class T> struct __mlxcc_bare<T &&> { typedef typename __mlxcc_bare<T>::type type; };
template <class T> inline const type_info &__mlxcc_typeid_of() { return __mlxcc_typeid_holder<typename __mlxcc_bare<T>::type>::info; }

class bad_cast : public exception {
public:
    const char *what() const noexcept override { return "std::bad_cast"; }
};

class bad_typeid : public exception {
public:
    const char *what() const noexcept override { return "std::bad_typeid"; }
};

}

#endif
