// <typeinfo>: std::type_info, named and compared by its mangled name
// (mlx-cc has no run-time type information yet: typeid is not
// supported, so no type_info object is made), and the exceptions
// bad_cast and bad_typeid.
#ifndef __MLXCC_TYPEINFO
#define __MLXCC_TYPEINFO
#include <stddef.h>
#include <string.h>
#include <exception>

namespace std {

class type_info {
public:
    virtual ~type_info() {}
    const char *name() const { return __name; }
    bool operator==(const type_info &other) const { return this == &other || strcmp(__name, other.__name) == 0; }
    bool operator!=(const type_info &other) const { return !(*this == other); }
    bool before(const type_info &other) const { return strcmp(__name, other.__name) < 0; }
    size_t hash_code() const {
        size_t h = 14695981039346656037ULL;
        for (const char *p = __name; *p; ++p) h = (h ^ (unsigned char)*p) * 1099511628211ULL;
        return h;
    }
    type_info(const type_info &) = delete;
    type_info &operator=(const type_info &) = delete;

protected:
    explicit type_info(const char *n) : __name(n) {}
    const char *__name;
};

class bad_cast : public exception {
public:
    const char *what() const noexcept override { return "std::bad_cast"; }
};

class bad_typeid : public exception {
public:
    const char *what() const noexcept override { return "std::bad_typeid"; }
};

}

#endif
