// <bit>: bit_cast, the bit counts and rotations, endian.
#ifndef __MLXCC_BIT
#define __MLXCC_BIT
#include <type_traits>
#include <string.h>

namespace std {

// (Scalars through the compiler's __builtin_bit_cast, in constant
// expressions too; anything else copied.)
template <class To, class From> constexpr To bit_cast(const From &from) noexcept {
    static_assert(sizeof(To) == sizeof(From), "bit_cast needs types of one size");
    if constexpr (is_scalar<To>::value && is_scalar<From>::value && !is_member_pointer<To>::value && !is_member_pointer<From>::value && !is_null_pointer<From>::value) {
        return __builtin_bit_cast(To, from);
    } else {
        To to;
        memcpy(&to, &from, sizeof(To));
        return to;
    }
}

enum class endian { little = 0, big = 1, native = little };

template <class T> constexpr int countl_zero(T x) noexcept {
    const int width = sizeof(T) * 8;
    if (x == 0) return width;
    int n = 0;
    unsigned long v = x;
    unsigned long top = 1UL << (width - 1);
    while ((v & top) == 0) { v <<= 1; n++; }
    return n;
}
template <class T> constexpr int countr_zero(T x) noexcept {
    const int width = sizeof(T) * 8;
    if (x == 0) return width;
    int n = 0;
    unsigned long v = x;
    while ((v & 1) == 0) { v >>= 1; n++; }
    return n;
}
template <class T> constexpr int countl_one(T x) noexcept { return countl_zero(T(~x)); }
template <class T> constexpr int countr_one(T x) noexcept { return countr_zero(T(~x)); }
template <class T> constexpr int popcount(T x) noexcept {
    int n = 0;
    unsigned long v = x;
    while (v) { n += v & 1; v >>= 1; }
    return n;
}
template <class T> constexpr bool has_single_bit(T x) noexcept { return x != 0 && (x & (x - 1)) == 0; }
template <class T> constexpr int bit_width(T x) noexcept { return sizeof(T) * 8 - countl_zero(x); }
template <class T> constexpr T bit_ceil(T x) noexcept {
    if (x <= 1) return T(1);
    return T(T(1) << bit_width(T(x - 1)));
}
template <class T> constexpr T bit_floor(T x) noexcept {
    if (x == 0) return T(0);
    return T(T(1) << (bit_width(x) - 1));
}
template <class T> constexpr T rotl(T x, int s) noexcept {
    const int width = sizeof(T) * 8;
    s = ((s % width) + width) % width;
    if (s == 0) return x;
    return T((x << s) | (x >> (width - s)));
}
template <class T> constexpr T rotr(T x, int s) noexcept {
    const int width = sizeof(T) * 8;
    s = ((s % width) + width) % width;
    if (s == 0) return x;
    return T((x >> s) | (x << (width - s)));
}
template <class T> constexpr T byteswap(T x) noexcept {
    T r = 0;
    for (unsigned i = 0; i < sizeof(T); i++) { r = T((r << 8) | ((x >> (8 * i)) & 0xff)); }
    return r;
}

}
#endif
