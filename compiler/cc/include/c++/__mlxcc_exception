// <__mlxcc_exception>: what mlx-cc's exceptions stand on. -fexceptions
// includes it before the unit, and the compiler writes every try, catch
// and throw of the unit as C++ over it (compiler/cc/exceptions.mlx):
//
//   try BODY catch (T x) HANDLER catch (...) OTHER
//     { __mlxcc_eh::try_frame f; int j; j = _setjmp(f.jump);
//       if (j == 0) BODY
//       else { __mlxcc_eh::handling h; void *p;
//              if ((p = __mlxcc_eh_adjusted(__mlxcc_exception_type(T))) != 0)
//                  { T x = __mlxcc_eh::ref_of<T>::get(p); HANDLER }
//              else if (1) OTHER
//              else __mlxcc_eh_unmatched(); } }
//   throw E;   __mlxcc_eh::raise(E);
//   throw;     __mlxcc_eh_rethrow();
//   throw()    noexcept (a dynamic exception specification)
//
// A try is a frame on the thread's chain of frames and the place
// _setjmp keeps; a throw puts the object into storage of its own, then
// destroys the objects with destructors made since the innermost frame
// (the thread's list of them, which every such local joins when it is
// made and leaves when it is destroyed) and jumps to that frame. The
// handler that runs holds the exception (`handling`) and gives it up at
// its end: then it is destroyed, unless it was thrown on (`throw;`). The
// run-time functions are mlxlibcpp's (compiler/libcpp/exception.cpp).
#ifndef __MLXCC_EXCEPTION_RUNTIME
#define __MLXCC_EXCEPTION_RUNTIME
#include <setjmp.h>
#include <new>

extern "C" {
// Storage for an exception object of SIZE bytes.
void *__mlxcc_eh_allocate(unsigned long size);
// OBJECT (in __mlxcc_eh_allocate's storage) thrown: TYPE is what
// __mlxcc_exception_type says of its type, DESTROY its destructor.
[[noreturn]] void __mlxcc_eh_throw(void *object, const char *type, void (*destroy)(void *));
// `throw;`: the exception being handled thrown on.
[[noreturn]] void __mlxcc_eh_rethrow(void);
// No handler of a try took the exception: thrown on to the next frame.
[[noreturn]] void __mlxcc_eh_unmatched(void);
// A try's frame joins the thread's chain, and leaves it.
void __mlxcc_eh_try_enter(void *frame);
void __mlxcc_eh_try_leave(void *frame);
// A handler starts (the exception it handles), and ends.
void *__mlxcc_eh_begin_catch(void);
void __mlxcc_eh_end_catch(void *exception);
// The exception being handled seen as the type TYPE (what
// __mlxcc_exception_type says of it): its address as that, 0 when it is
// not one.
void *__mlxcc_eh_adjusted(const char *type);
// A local with a destructor made (OBJECT, destroyed by DESTROY when an
// exception passes it), and destroyed: it leaves the list.
void __mlxcc_eh_push(void *object, void (*destroy)(void *));
void __mlxcc_eh_pop(void *object);
// How many exceptions are thrown and not yet handled.
int __mlxcc_eh_uncaught(void);
}

namespace __mlxcc_eh {

// A try: its place to jump back to, the frame outside it, the length of
// the thread's list of objects to destroy and of its exceptions being
// handled when it was entered, and whether it is on the chain.
struct try_frame {
    jmp_buf jump;
    try_frame *outer;
    unsigned long objects;
    unsigned long handled;
    int linked;
    try_frame() { __mlxcc_eh_try_enter(this); }
    ~try_frame() { __mlxcc_eh_try_leave(this); }
};

// A handler running: the exception it handles until it ends.
struct handling {
    void *exception;
    handling() : exception(__mlxcc_eh_begin_catch()) {}
    ~handling() { __mlxcc_eh_end_catch(exception); }
};

// A handler's parameter of the type T, from the address of the
// exception seen as T.
template <class T> struct ref_of { static T &get(void *p) { return *static_cast<T *>(p); } };
template <class T> struct ref_of<T &> { static T &get(void *p) { return *static_cast<T *>(p); } };
template <class T> struct ref_of<T &&> { static T &get(void *p) { return *static_cast<T *>(p); } };

// The type an exception object has for `throw e`: e's without a
// reference and const.
template <class T> struct decayed { typedef T type; };
template <class T> struct decayed<T &> { typedef typename decayed<T>::type type; };
template <class T> struct decayed<T &&> { typedef typename decayed<T>::type type; };
template <class T> struct decayed<const T> { typedef typename decayed<T>::type type; };

template <class T> void destroy(void *object) { static_cast<T *>(object)->~T(); }

// `throw value`: the exception object made from it in storage of its
// own, and thrown.
template <class T> [[noreturn]] void raise(T &&value) {
    typedef typename decayed<T>::type U;
    void *object = __mlxcc_eh_allocate(sizeof(U));
    ::new (object) U(static_cast<T &&>(value));
    __mlxcc_eh_throw(object, __mlxcc_exception_type(U), &destroy<U>);
}

}
#endif
