// <charconv>: to_chars and from_chars, integers in any base from 2 to 36
// and floating-point values (the shortest text that reads back as the
// same value, or a given precision and format).
#ifndef __MLXCC_CHARCONV
#define __MLXCC_CHARCONV
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <system_error>
#include <type_traits>

namespace std {

enum class chars_format { scientific = 1, fixed = 2, hex = 4, general = 3 };
constexpr chars_format operator|(chars_format a, chars_format b) { return chars_format((int)a | (int)b); }
constexpr chars_format operator&(chars_format a, chars_format b) { return chars_format((int)a & (int)b); }

struct to_chars_result {
    char *ptr;
    errc ec;
    friend bool operator==(const to_chars_result &a, const to_chars_result &b) { return a.ptr == b.ptr && a.ec == b.ec; }
};
struct from_chars_result {
    const char *ptr;
    errc ec;
    friend bool operator==(const from_chars_result &a, const from_chars_result &b) { return a.ptr == b.ptr && a.ec == b.ec; }
};

inline to_chars_result __to_chars_unsigned(char *first, char *last, unsigned long long value, int base, bool negative) {
    char reversed[72];
    size_t n = 0;
    do {
        unsigned digit = (unsigned)(value % (unsigned)base);
        reversed[n++] = (char)(digit < 10 ? '0' + digit : 'a' + digit - 10);
        value /= (unsigned)base;
    } while (value != 0);
    size_t needed = n + (negative ? 1 : 0);
    if ((size_t)(last - first) < needed) return to_chars_result{last, errc::value_too_large};
    char *at = first;
    if (negative) *at++ = '-';
    while (n > 0) *at++ = reversed[--n];
    return to_chars_result{at, errc()};
}

template <class T, class = typename enable_if<is_integral<T>::value>::type>
to_chars_result to_chars(char *first, char *last, T value, int base = 10) {
    if (is_signed<T>::value && value < 0) return __to_chars_unsigned(first, last, 0ULL - (unsigned long long)(long long)value, base, true);
    return __to_chars_unsigned(first, last, (unsigned long long)value, base, false);
}

inline to_chars_result __to_chars_text(char *first, char *last, const char *text) {
    size_t n = strlen(text);
    if ((size_t)(last - first) < n) return to_chars_result{last, errc::value_too_large};
    memcpy(first, text, n);
    return to_chars_result{first + n, errc()};
}

// The shortest %g, %e or %f text of `value` that reads back as it.
inline to_chars_result __to_chars_double(char *first, char *last, double value, chars_format format, int precision, bool shortest, bool isFloat) {
    char text[512];
    char spec[8] = "%.*g";
    if (format == chars_format::scientific) spec[3] = 'e';
    else if (format == chars_format::fixed) spec[3] = 'f';
    else if (format == chars_format::hex) spec[3] = 'a';
    if (!shortest) {
        snprintf(text, sizeof text, spec, precision, value);
    } else if (format == chars_format::hex) {
        snprintf(text, sizeof text, "%a", value);
    } else {
        int p = format == chars_format::fixed ? 0 : 1;
        int most = format == chars_format::fixed ? 340 : 17;
        for (; p <= most; p++) {
            snprintf(text, sizeof text, spec, p, value);
            if (isFloat ? (float)strtod(text, 0) == (float)value : strtod(text, 0) == value) break;
        }
    }
    return __to_chars_text(first, last, text);
}

inline to_chars_result to_chars(char *first, char *last, double value) { return __to_chars_double(first, last, value, chars_format::general, 0, true, false); }
inline to_chars_result to_chars(char *first, char *last, float value) { return __to_chars_double(first, last, value, chars_format::general, 0, true, true); }
inline to_chars_result to_chars(char *first, char *last, long double value) { return to_chars(first, last, (double)value); }
inline to_chars_result to_chars(char *first, char *last, double value, chars_format format) { return __to_chars_double(first, last, value, format, 0, true, false); }
inline to_chars_result to_chars(char *first, char *last, float value, chars_format format) { return __to_chars_double(first, last, value, format, 0, true, true); }
inline to_chars_result to_chars(char *first, char *last, double value, chars_format format, int precision) { return __to_chars_double(first, last, value, format, precision, false, false); }
inline to_chars_result to_chars(char *first, char *last, float value, chars_format format, int precision) { return __to_chars_double(first, last, value, format, precision, false, true); }

template <class T, class = typename enable_if<is_integral<T>::value>::type>
from_chars_result from_chars(const char *first, const char *last, T &value, int base = 10) {
    const char *at = first;
    bool negative = false;
    if (is_signed<T>::value && at < last && *at == '-') { negative = true; at++; }
    const char *digits = at;
    unsigned long long total = 0;
    bool overflow = false;
    while (at < last) {
        char c = *at;
        int digit = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'z' ? c - 'a' + 10 : c >= 'A' && c <= 'Z' ? c - 'A' + 10 : 99;
        if (digit >= base) break;
        unsigned long long next = total * (unsigned long long)base + (unsigned long long)digit;
        if (next / (unsigned long long)base != total) overflow = true;
        total = next;
        at++;
    }
    if (at == digits) return from_chars_result{first, errc::invalid_argument};
    if (overflow) return from_chars_result{at, errc::result_out_of_range};
    if (negative) {
        long long v = (long long)(0ULL - total);
        if (total > (unsigned long long)1 << 63 || (T)v != v) return from_chars_result{at, errc::result_out_of_range};
        value = (T)v;
    } else {
        if ((unsigned long long)(T)total != total || (is_signed<T>::value && (T)total < 0)) return from_chars_result{at, errc::result_out_of_range};
        value = (T)total;
    }
    return from_chars_result{at, errc()};
}

inline from_chars_result __from_chars_double(const char *first, const char *last, double &value) {
    char text[512];
    size_t n = (size_t)(last - first);
    if (n >= sizeof text) n = sizeof text - 1;
    memcpy(text, first, n);
    text[n] = 0;
    if (n > 0 && (text[0] == '+' || text[0] == ' ')) return from_chars_result{first, errc::invalid_argument};
    char *stop = 0;
    double read = strtod(text, &stop);
    if (stop == text) return from_chars_result{first, errc::invalid_argument};
    value = read;
    return from_chars_result{first + (stop - text), errc()};
}
inline from_chars_result from_chars(const char *first, const char *last, double &value, chars_format = chars_format::general) { return __from_chars_double(first, last, value); }
inline from_chars_result from_chars(const char *first, const char *last, float &value, chars_format = chars_format::general) {
    double d = 0;
    from_chars_result r = __from_chars_double(first, last, d);
    if (r.ec == errc()) value = (float)d;
    return r;
}

}
#endif
