// The red-black tree under <map> and <set> (and their multi forms):
// nodes ordered by the comparator over their keys, a header node whose
// parent is the root and whose left and right are the first and last
// nodes (end() is the header). Iterators stay valid until their own
// node is erased.
#ifndef __MLXCC_RB_TREE
#define __MLXCC_RB_TREE
#include <stddef.h>
#include <functional>
#include <initializer_list>
#include <iterator>
#include <new>
#include <utility>

namespace std {

struct __rb_base {
    __rb_base *parent;
    __rb_base *left;
    __rb_base *right;
    bool red;
};

inline __rb_base *__rb_minimum(__rb_base *x) { while (x->left) x = x->left; return x; }
inline __rb_base *__rb_maximum(__rb_base *x) { while (x->right) x = x->right; return x; }

inline __rb_base *__rb_increment(__rb_base *x) {
    if (x->right) return __rb_minimum(x->right);
    __rb_base *y = x->parent;
    while (x == y->right) { x = y; y = y->parent; }
    // (From the last node: the header, whose right is that node.)
    if (x->right != y) x = y;
    return x;
}

inline __rb_base *__rb_decrement(__rb_base *x) {
    // The header (end()): the last node.
    if (x->red && x->parent->parent == x) return x->right;
    if (x->left) return __rb_maximum(x->left);
    __rb_base *y = x->parent;
    while (x == y->left) { x = y; y = y->parent; }
    return y;
}

inline void __rb_rotate_left(__rb_base *x, __rb_base *&root) {
    __rb_base *y = x->right;
    x->right = y->left;
    if (y->left) y->left->parent = x;
    y->parent = x->parent;
    if (x == root) root = y;
    else if (x == x->parent->left) x->parent->left = y;
    else x->parent->right = y;
    y->left = x;
    x->parent = y;
}

inline void __rb_rotate_right(__rb_base *x, __rb_base *&root) {
    __rb_base *y = x->left;
    x->left = y->right;
    if (y->right) y->right->parent = x;
    y->parent = x->parent;
    if (x == root) root = y;
    else if (x == x->parent->right) x->parent->right = y;
    else x->parent->left = y;
    y->right = x;
    x->parent = y;
}

// `x` linked below `p` (its left when `left`), then the colors mended.
inline void __rb_insert_rebalance(bool left, __rb_base *x, __rb_base *p, __rb_base &header) {
    __rb_base *&root = header.parent;
    x->parent = p;
    x->left = nullptr;
    x->right = nullptr;
    x->red = true;
    if (p == &header) {
        header.parent = x;
        header.left = x;
        header.right = x;
    } else if (left) {
        p->left = x;
        if (p == header.left) header.left = x;
    } else {
        p->right = x;
        if (p == header.right) header.right = x;
    }
    while (x != root && x->parent->red) {
        __rb_base *gp = x->parent->parent;
        if (x->parent == gp->left) {
            __rb_base *uncle = gp->right;
            if (uncle && uncle->red) {
                x->parent->red = false;
                uncle->red = false;
                gp->red = true;
                x = gp;
            } else {
                if (x == x->parent->right) {
                    x = x->parent;
                    __rb_rotate_left(x, root);
                }
                x->parent->red = false;
                gp->red = true;
                __rb_rotate_right(gp, root);
            }
        } else {
            __rb_base *uncle = gp->left;
            if (uncle && uncle->red) {
                x->parent->red = false;
                uncle->red = false;
                gp->red = true;
                x = gp;
            } else {
                if (x == x->parent->left) {
                    x = x->parent;
                    __rb_rotate_right(x, root);
                }
                x->parent->red = false;
                gp->red = true;
                __rb_rotate_left(gp, root);
            }
        }
    }
    root->red = false;
}

// `z` taken out of the tree, the colors mended; z returned.
inline __rb_base *__rb_erase_rebalance(__rb_base *z, __rb_base &header) {
    __rb_base *&root = header.parent;
    __rb_base *&leftmost = header.left;
    __rb_base *&rightmost = header.right;
    __rb_base *y = z;
    __rb_base *x = nullptr;
    __rb_base *xParent = nullptr;
    if (!y->left) {
        x = y->right;
    } else if (!y->right) {
        x = y->left;
    } else {
        y = __rb_minimum(y->right);
        x = y->right;
    }
    if (y != z) {
        // z's successor y takes z's place.
        z->left->parent = y;
        y->left = z->left;
        if (y != z->right) {
            xParent = y->parent;
            if (x) x->parent = y->parent;
            y->parent->left = x;
            y->right = z->right;
            z->right->parent = y;
        } else {
            xParent = y;
        }
        if (root == z) root = y;
        else if (z->parent->left == z) z->parent->left = y;
        else z->parent->right = y;
        y->parent = z->parent;
        bool color = y->red;
        y->red = z->red;
        z->red = color;
        y = z;
    } else {
        xParent = y->parent;
        if (x) x->parent = y->parent;
        if (root == z) root = x;
        else if (z->parent->left == z) z->parent->left = x;
        else z->parent->right = x;
        if (leftmost == z) leftmost = z->right ? __rb_minimum(x) : z->parent;
        if (rightmost == z) rightmost = z->left ? __rb_maximum(x) : z->parent;
    }
    if (!y->red) {
        while (x != root && (!x || !x->red)) {
            if (x == xParent->left) {
                __rb_base *w = xParent->right;
                if (w->red) {
                    w->red = false;
                    xParent->red = true;
                    __rb_rotate_left(xParent, root);
                    w = xParent->right;
                }
                if ((!w->left || !w->left->red) && (!w->right || !w->right->red)) {
                    w->red = true;
                    x = xParent;
                    xParent = xParent->parent;
                } else {
                    if (!w->right || !w->right->red) {
                        w->left->red = false;
                        w->red = true;
                        __rb_rotate_right(w, root);
                        w = xParent->right;
                    }
                    w->red = xParent->red;
                    xParent->red = false;
                    if (w->right) w->right->red = false;
                    __rb_rotate_left(xParent, root);
                    break;
                }
            } else {
                __rb_base *w = xParent->left;
                if (w->red) {
                    w->red = false;
                    xParent->red = true;
                    __rb_rotate_right(xParent, root);
                    w = xParent->left;
                }
                if ((!w->right || !w->right->red) && (!w->left || !w->left->red)) {
                    w->red = true;
                    x = xParent;
                    xParent = xParent->parent;
                } else {
                    if (!w->left || !w->left->red) {
                        w->right->red = false;
                        w->red = true;
                        __rb_rotate_left(w, root);
                        w = xParent->left;
                    }
                    w->red = xParent->red;
                    xParent->red = false;
                    if (w->left) w->left->red = false;
                    __rb_rotate_right(xParent, root);
                    break;
                }
            }
        }
        if (x) x->red = false;
    }
    return y;
}

template <class V> struct __rb_node : __rb_base {
    V value;
    template <class... A> __rb_node(A &&... args) : value(std::forward<A>(args)...) {}
};

template <class V, class R, class P> class __rb_iterator {
public:
    typedef bidirectional_iterator_tag iterator_category;
    typedef V value_type;
    typedef ptrdiff_t difference_type;
    typedef P pointer;
    typedef R reference;

    __rb_base *node;

    __rb_iterator() : node(nullptr) {}
    explicit __rb_iterator(__rb_base *n) : node(n) {}
    template <class R2, class P2> __rb_iterator(const __rb_iterator<V, R2, P2> &other) : node(other.node) {}

    R operator*() const { return static_cast<__rb_node<V> *>(node)->value; }
    P operator->() const { return &static_cast<__rb_node<V> *>(node)->value; }
    __rb_iterator &operator++() { node = __rb_increment(node); return *this; }
    __rb_iterator operator++(int) { __rb_iterator old = *this; node = __rb_increment(node); return old; }
    __rb_iterator &operator--() { node = __rb_decrement(node); return *this; }
    __rb_iterator operator--(int) { __rb_iterator old = *this; node = __rb_decrement(node); return old; }
    template <class R2, class P2> bool operator==(const __rb_iterator<V, R2, P2> &other) const { return node == other.node; }
    template <class R2, class P2> bool operator!=(const __rb_iterator<V, R2, P2> &other) const { return node != other.node; }
};

// KeyOf::key(value) is a value's key; Multi: equal keys allowed.
template <class Key, class Value, class KeyOf, class Compare, bool Multi> class __rb_tree {
public:
    typedef __rb_iterator<Value, Value &, Value *> iterator;
    typedef __rb_iterator<Value, const Value &, const Value *> const_iterator;
    typedef __rb_node<Value> node_type_;

    __rb_tree() : count(0), comp() { reset(); }
    explicit __rb_tree(const Compare &c) : count(0), comp(c) { reset(); }
    __rb_tree(const __rb_tree &other) : count(0), comp(other.comp) {
        reset();
        copyFrom(other);
    }
    __rb_tree(__rb_tree &&other) : count(0), comp(other.comp) {
        reset();
        take(other);
    }
    ~__rb_tree() { clear(); }

    __rb_tree &operator=(const __rb_tree &other) {
        if (this != &other) {
            clear();
            comp = other.comp;
            copyFrom(other);
        }
        return *this;
    }
    __rb_tree &operator=(__rb_tree &&other) {
        if (this != &other) {
            clear();
            comp = other.comp;
            take(other);
        }
        return *this;
    }

    iterator begin() { return iterator(header.left); }
    iterator end() { return iterator(&header); }
    const_iterator begin() const { return const_iterator(header.left); }
    const_iterator end() const { return const_iterator(const_cast<__rb_base *>(&header)); }
    size_t size() const { return count; }
    bool empty() const { return count == 0; }
    const Compare &key_comp() const { return comp; }

    void clear() {
        destroy(header.parent);
        reset();
    }

    iterator lower_bound(const Key &key) { return iterator(lowerNode(key)); }
    const_iterator lower_bound(const Key &key) const { return const_iterator(lowerNode(key)); }
    iterator upper_bound(const Key &key) { return iterator(upperNode(key)); }
    const_iterator upper_bound(const Key &key) const { return const_iterator(upperNode(key)); }
    iterator find(const Key &key) {
        __rb_base *n = lowerNode(key);
        if (n == &header || comp(key, keyOf(n))) return end();
        return iterator(n);
    }
    const_iterator find(const Key &key) const {
        __rb_base *n = lowerNode(key);
        if (n == &header || comp(key, keyOf(n))) return end();
        return const_iterator(n);
    }
    size_t countOf(const Key &key) const {
        size_t n = 0;
        for (__rb_base *x = lowerNode(key); x != &header && !comp(key, keyOf(x)); x = __rb_increment(x)) ++n;
        return n;
    }

    // A node made of `args`, linked in (unless its key is there already
    // and the tree is not Multi: then freed, and the one there given).
    template <class... A> pair<iterator, bool> emplace(A &&... args) {
        node_type_ *made = new node_type_(std::forward<A>(args)...);
        pair<__rb_base *, bool> place = position(KeyOf::key(made->value));
        if (!place.second) {
            delete made;
            return pair<iterator, bool>(iterator(place.first), false);
        }
        link(made, place.first);
        return pair<iterator, bool>(iterator(made), true);
    }

    iterator erase(const_iterator it) {
        __rb_base *n = it.node;
        __rb_base *next = __rb_increment(n);
        __rb_erase_rebalance(n, header);
        delete static_cast<node_type_ *>(n);
        --count;
        return iterator(next);
    }
    iterator erase(const_iterator first, const_iterator last) {
        while (first != last) first = erase(first);
        return iterator(last.node);
    }
    size_t eraseKey(const Key &key) {
        size_t n = 0;
        __rb_base *x = lowerNode(key);
        while (x != &header && !comp(key, keyOf(x))) {
            __rb_base *next = __rb_increment(x);
            erase(const_iterator(x));
            x = next;
            ++n;
        }
        return n;
    }

    void swap(__rb_tree &other) {
        __rb_tree held(std::move(other));
        other.take(*this);
        take(held);
        Compare c = comp;
        comp = other.comp;
        other.comp = c;
    }

private:
    __rb_base header;
    size_t count;
    Compare comp;

    static const Key &keyOf(__rb_base *n) { return KeyOf::key(static_cast<node_type_ *>(n)->value); }

    void reset() {
        header.red = true;
        header.parent = nullptr;
        header.left = &header;
        header.right = &header;
        count = 0;
    }
    void destroy(__rb_base *n) {
        while (n) {
            destroy(n->right);
            __rb_base *left = n->left;
            delete static_cast<node_type_ *>(n);
            n = left;
        }
    }
    void copyFrom(const __rb_tree &other) {
        for (const_iterator it = other.begin(); it != other.end(); ++it) {
            node_type_ *made = new node_type_(*it);
            // (In order: always the right child of the last.)
            linkAt(made, header.parent ? header.right : &header, false);
        }
    }
    void take(__rb_tree &other) {
        if (!other.header.parent) { reset(); return; }
        header.parent = other.header.parent;
        header.left = other.header.left;
        header.right = other.header.right;
        header.red = true;
        header.parent->parent = &header;
        count = other.count;
        other.reset();
    }

    __rb_base *lowerNode(const Key &key) const {
        __rb_base *y = const_cast<__rb_base *>(&header);
        __rb_base *x = header.parent;
        while (x) {
            if (!comp(keyOf(x), key)) { y = x; x = x->left; } else x = x->right;
        }
        return y;
    }
    __rb_base *upperNode(const Key &key) const {
        __rb_base *y = const_cast<__rb_base *>(&header);
        __rb_base *x = header.parent;
        while (x) {
            if (comp(key, keyOf(x))) { y = x; x = x->left; } else x = x->right;
        }
        return y;
    }
    // Where a node of `key` goes: its parent-to-be (true), or the node
    // with the key already (false, not Multi).
    pair<__rb_base *, bool> position(const Key &key) {
        __rb_base *y = &header;
        __rb_base *x = header.parent;
        bool less = true;
        while (x) {
            y = x;
            less = comp(key, keyOf(x));
            x = less ? x->left : x->right;
        }
        if (Multi) return pair<__rb_base *, bool>(y, true);
        __rb_base *j = y;
        if (less) {
            if (j == header.left) return pair<__rb_base *, bool>(y, true);
            j = __rb_decrement(j);
        }
        if (comp(keyOf(j), key)) return pair<__rb_base *, bool>(y, true);
        return pair<__rb_base *, bool>(j, false);
    }
    void link(node_type_ *made, __rb_base *parent) {
        bool left = parent == &header || comp(KeyOf::key(made->value), keyOf(parent));
        __rb_insert_rebalance(left, made, parent, header);
        ++count;
    }
    void linkAt(node_type_ *made, __rb_base *parent, bool left) {
        __rb_insert_rebalance(left, made, parent, header);
        ++count;
    }
};

}

#endif
