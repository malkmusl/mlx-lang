// <source_location>: where a call is, by the default arguments of
// current(), which mlx-cc's __builtin_LINE() and the like give the call's
// place in. (The column is 0: mlx-cc keeps no columns. The function's name
// is its __func__, not GCC's signature.)
#ifndef __MLXCC_SOURCE_LOCATION
#define __MLXCC_SOURCE_LOCATION

#include <cstdint>

namespace std {

struct source_location {
    static constexpr source_location current(const char* __file = __builtin_FILE(), const char* __function = __builtin_FUNCTION(),
        uint_least32_t __line = __builtin_LINE(), uint_least32_t __column = __builtin_COLUMN()) noexcept
    {
        source_location __location;
        __location._M_file = __file;
        __location._M_function = __function;
        __location._M_line = __line;
        __location._M_column = __column;
        return __location;
    }

    constexpr source_location() noexcept { }

    constexpr uint_least32_t line() const noexcept { return _M_line; }
    constexpr uint_least32_t column() const noexcept { return _M_column; }
    constexpr const char* file_name() const noexcept { return _M_file; }
    constexpr const char* function_name() const noexcept { return _M_function; }

private:
    const char* _M_file = "";
    const char* _M_function = "";
    uint_least32_t _M_line = 0;
    uint_least32_t _M_column = 0;
};

}

#endif
