// <variant>: std::variant (one of its alternatives, kept in place in a
// buffer of the largest one's size, with the index of the one held),
// monostate, get, get_if, holds_alternative, visit (of one variant, or
// of two), variant_size, variant_alternative.
#ifndef __MLXCC_VARIANT
#define __MLXCC_VARIANT
#include <stddef.h>
#include <stdlib.h>
#include <new>
#include <utility>
#include <type_traits>
#include <exception>

namespace std {

struct monostate {};
constexpr bool operator==(monostate, monostate) noexcept { return true; }
constexpr bool operator!=(monostate, monostate) noexcept { return false; }
constexpr bool operator<(monostate, monostate) noexcept { return false; }

class bad_variant_access : public exception {
public:
    const char *what() const noexcept { return "bad variant access"; }
};

constexpr size_t variant_npos = (size_t)-1;

template <class... Ts> class variant;

template <class V> struct variant_size;
template <class... Ts> struct variant_size<variant<Ts...> > : integral_constant<size_t, sizeof...(Ts)> {};
template <class V> struct variant_size<const V> : variant_size<V> {};
template <class V> constexpr size_t variant_size_v = variant_size<V>::value;

template <size_t I, class... Ts> struct __variant_nth;
template <class T, class... Ts> struct __variant_nth<0, T, Ts...> { typedef T type; };
template <size_t I, class T, class... Ts> struct __variant_nth<I, T, Ts...> : __variant_nth<I - 1, Ts...> {};

template <size_t I, class V> struct variant_alternative;
template <size_t I, class... Ts> struct variant_alternative<I, variant<Ts...> > { typedef typename __variant_nth<I, Ts...>::type type; };
template <size_t I, class V> struct variant_alternative<I, const V> { typedef const typename variant_alternative<I, V>::type type; };
template <size_t I, class V> using variant_alternative_t = typename variant_alternative<I, V>::type;

// The index of T among Ts (sizeof...(Ts) when it is not there).
template <class T, class... Ts> struct __variant_index : integral_constant<size_t, 0> {};
template <class T, class U, class... Ts> struct __variant_index<T, U, Ts...>
    : integral_constant<size_t, is_same<T, U>::value ? 0 : 1 + __variant_index<T, Ts...>::value> {};

// The alternative a value of type U makes: the same type, else the
// first one it converts to.
template <class U, class... Ts> struct __variant_convertible : integral_constant<size_t, 0> {};
template <class U, class T, class... Ts> struct __variant_convertible<U, T, Ts...>
    : integral_constant<size_t, is_convertible<U, T>::value ? 0 : 1 + __variant_convertible<U, Ts...>::value> {};
template <class U, class... Ts> struct __variant_choice
    : integral_constant<size_t, __variant_index<typename decay<U>::type, Ts...>::value < sizeof...(Ts)
          ? __variant_index<typename decay<U>::type, Ts...>::value
          : __variant_convertible<U, Ts...>::value> {};

template <size_t A, size_t B> struct __variant_max : integral_constant<size_t, (A > B ? A : B)> {};
template <class... Ts> struct __variant_storage_size : integral_constant<size_t, 1> {};
template <class T, class... Ts> struct __variant_storage_size<T, Ts...>
    : __variant_max<sizeof(T), __variant_storage_size<Ts...>::value> {};

// The operations on the alternative held, by its index.
template <class... Ts> struct __variant_ops {
    static void destroy(size_t, void *) {}
    static void copy(size_t, void *, const void *) {}
    static void move(size_t, void *, void *) {}
    static bool equal(size_t, const void *, const void *) { return true; }
    static bool less(size_t, const void *, const void *) { return false; }
};
template <class T, class... Ts> struct __variant_ops<T, Ts...> {
    static void destroy(size_t i, void *p) { if (i == 0) static_cast<T *>(p)->~T(); else __variant_ops<Ts...>::destroy(i - 1, p); }
    static void copy(size_t i, void *d, const void *s) { if (i == 0) new (d) T(*static_cast<const T *>(s)); else __variant_ops<Ts...>::copy(i - 1, d, s); }
    static void move(size_t i, void *d, void *s) { if (i == 0) new (d) T(std::move(*static_cast<T *>(s))); else __variant_ops<Ts...>::move(i - 1, d, s); }
    static bool equal(size_t i, const void *a, const void *b) { if (i == 0) return *static_cast<const T *>(a) == *static_cast<const T *>(b); return __variant_ops<Ts...>::equal(i - 1, a, b); }
    static bool less(size_t i, const void *a, const void *b) { if (i == 0) return *static_cast<const T *>(a) < *static_cast<const T *>(b); return __variant_ops<Ts...>::less(i - 1, a, b); }
};

template <class... Ts> class variant {
public:
    variant() : _index(0) { new (_storage) typename __variant_nth<0, Ts...>::type(); }
    variant(const variant &other) : _index(other._index) { __variant_ops<Ts...>::copy(_index, _storage, other._storage); }
    variant(variant &&other) : _index(other._index) { __variant_ops<Ts...>::move(_index, _storage, other._storage); }
    template <class U, class = typename enable_if<!is_same<typename decay<U>::type, variant>::value>::type>
    variant(U &&value) : _index(__variant_choice<U, Ts...>::value) {
        typedef typename __variant_nth<__variant_choice<U, Ts...>::value, Ts...>::type T;
        new (_storage) T(std::forward<U>(value));
    }
    template <class T, class... Args> explicit variant(in_place_type_t<T>, Args &&... args) : _index(__variant_index<T, Ts...>::value) {
        new (_storage) T(std::forward<Args>(args)...);
    }
    template <size_t I, class... Args> explicit variant(in_place_index_t<I>, Args &&... args) : _index(I) {
        new (_storage) typename __variant_nth<I, Ts...>::type(std::forward<Args>(args)...);
    }
    ~variant() { __variant_ops<Ts...>::destroy(_index, _storage); }
    variant &operator=(const variant &other) {
        if (this != &other) {
            __variant_ops<Ts...>::destroy(_index, _storage);
            _index = other._index;
            __variant_ops<Ts...>::copy(_index, _storage, other._storage);
        }
        return *this;
    }
    variant &operator=(variant &&other) {
        if (this != &other) {
            __variant_ops<Ts...>::destroy(_index, _storage);
            _index = other._index;
            __variant_ops<Ts...>::move(_index, _storage, other._storage);
        }
        return *this;
    }
    template <class U, class = typename enable_if<!is_same<typename decay<U>::type, variant>::value>::type>
    variant &operator=(U &&value) {
        typedef typename __variant_nth<__variant_choice<U, Ts...>::value, Ts...>::type T;
        __variant_ops<Ts...>::destroy(_index, _storage);
        _index = __variant_choice<U, Ts...>::value;
        new (_storage) T(std::forward<U>(value));
        return *this;
    }
    template <class T, class... Args> T &emplace(Args &&... args) {
        __variant_ops<Ts...>::destroy(_index, _storage);
        _index = __variant_index<T, Ts...>::value;
        return *new (_storage) T(std::forward<Args>(args)...);
    }
    template <size_t I, class... Args> typename __variant_nth<I, Ts...>::type &emplace(Args &&... args) {
        __variant_ops<Ts...>::destroy(_index, _storage);
        _index = I;
        return *new (_storage) typename __variant_nth<I, Ts...>::type(std::forward<Args>(args)...);
    }
    constexpr size_t index() const noexcept { return _index; }
    constexpr bool valueless_by_exception() const noexcept { return false; }
    void swap(variant &other) { variant t(std::move(other)); other = std::move(*this); *this = std::move(t); }

    void *__address() { return _storage; }
    const void *__address() const { return _storage; }
private:
    alignas(16) unsigned char _storage[__variant_storage_size<Ts...>::value];
    size_t _index;
};

// The comparisons: the same alternative, then its values (function
// templates, made only for the variants compared).
template <class... Ts> bool operator==(const variant<Ts...> &a, const variant<Ts...> &b) {
    return a.index() == b.index() && __variant_ops<Ts...>::equal(a.index(), a.__address(), b.__address());
}
template <class... Ts> bool operator!=(const variant<Ts...> &a, const variant<Ts...> &b) { return !(a == b); }
template <class... Ts> bool operator<(const variant<Ts...> &a, const variant<Ts...> &b) {
    return a.index() < b.index() || (a.index() == b.index() && __variant_ops<Ts...>::less(a.index(), a.__address(), b.__address()));
}

template <class T, class... Ts> constexpr bool holds_alternative(const variant<Ts...> &v) noexcept { return v.index() == __variant_index<T, Ts...>::value; }

template <size_t I, class... Ts> typename __variant_nth<I, Ts...>::type &get(variant<Ts...> &v) {
    if (v.index() != I) abort();
    return *static_cast<typename __variant_nth<I, Ts...>::type *>(v.__address());
}
template <size_t I, class... Ts> const typename __variant_nth<I, Ts...>::type &get(const variant<Ts...> &v) {
    if (v.index() != I) abort();
    return *static_cast<const typename __variant_nth<I, Ts...>::type *>(v.__address());
}
template <size_t I, class... Ts> typename __variant_nth<I, Ts...>::type &&get(variant<Ts...> &&v) {
    if (v.index() != I) abort();
    return std::move(*static_cast<typename __variant_nth<I, Ts...>::type *>(v.__address()));
}
template <class T, class... Ts> T &get(variant<Ts...> &v) { return get<__variant_index<T, Ts...>::value>(v); }
template <class T, class... Ts> const T &get(const variant<Ts...> &v) { return get<__variant_index<T, Ts...>::value>(v); }
template <class T, class... Ts> T &&get(variant<Ts...> &&v) { return std::move(get<__variant_index<T, Ts...>::value>(v)); }

template <size_t I, class... Ts> typename __variant_nth<I, Ts...>::type *get_if(variant<Ts...> *v) noexcept {
    if (!v || v->index() != I) return 0;
    return static_cast<typename __variant_nth<I, Ts...>::type *>(v->__address());
}
template <size_t I, class... Ts> const typename __variant_nth<I, Ts...>::type *get_if(const variant<Ts...> *v) noexcept {
    if (!v || v->index() != I) return 0;
    return static_cast<const typename __variant_nth<I, Ts...>::type *>(v->__address());
}
template <class T, class... Ts> T *get_if(variant<Ts...> *v) noexcept { return get_if<__variant_index<T, Ts...>::value>(v); }
template <class T, class... Ts> const T *get_if(const variant<Ts...> *v) noexcept { return get_if<__variant_index<T, Ts...>::value>(v); }

// visit: the alternative held, found by its index (the visitor's
// result type is the first alternative's).
template <size_t I, size_t N> struct __variant_visit {
    template <class F, class V> static auto one(F &f, V &v) -> decltype(f(get<0>(v))) {
        if (v.index() == I) return f(get<I>(v));
        return __variant_visit<I + 1, N>::one(f, v);
    }
    template <class F, class V, class W> static auto two(F &f, V &v, W &w) -> decltype(f(get<0>(v), get<0>(w))) {
        if (v.index() == I) return __variant_visit<0, variant_size<typename remove_reference<W>::type>::value>::second(f, get<I>(v), w);
        return __variant_visit<I + 1, N>::two(f, v, w);
    }
    template <class F, class A, class W> static auto second(F &f, A &a, W &w) -> decltype(f(a, get<0>(w))) {
        if (w.index() == I) return f(a, get<I>(w));
        return __variant_visit<I + 1, N>::second(f, a, w);
    }
};
template <size_t N> struct __variant_visit<N, N> {
    template <class F, class V> static auto one(F &f, V &v) -> decltype(f(get<0>(v))) { abort(); }
    template <class F, class V, class W> static auto two(F &f, V &v, W &w) -> decltype(f(get<0>(v), get<0>(w))) { abort(); }
    template <class F, class A, class W> static auto second(F &f, A &a, W &w) -> decltype(f(a, get<0>(w))) { abort(); }
};
template <class F, class V> auto visit(F &&f, V &&v) -> decltype(f(get<0>(v))) {
    return __variant_visit<0, variant_size<typename remove_reference<V>::type>::value>::one(f, v);
}
template <class F, class V, class W> auto visit(F &&f, V &&v, W &&w) -> decltype(f(get<0>(v), get<0>(w))) {
    return __variant_visit<0, variant_size<typename remove_reference<V>::type>::value>::two(f, v, w);
}

template <class T> struct hash;
template <class... Ts> struct hash<variant<Ts...> > {
    size_t operator()(const variant<Ts...> &v) const noexcept { return v.index(); }
};

}
#endif
