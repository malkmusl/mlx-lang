// <tuple>: std::tuple over a recursive pair of a head and a tail, with
// get, tuple_size, tuple_element, make_tuple, tie, tuple_cat, apply.
#ifndef __MLXCC_TUPLE
#define __MLXCC_TUPLE
#include <stddef.h>
#include <utility>

namespace std {

template <class... Ts> struct tuple;
// (A head and a tail joined: tuple_cat.)
struct __tuple_join_t {};
template <> struct tuple<> {
    constexpr tuple() {}
    void swap(tuple &) {}
};
template <class T> struct __is_tuple : false_type {};
template <class... Ts> struct __is_tuple<tuple<Ts...> > : true_type {};
template <class T, class... Rest> struct tuple<T, Rest...> {
    T head;
    tuple<Rest...> tail;
    constexpr tuple() : head(), tail() {}
    constexpr tuple(const T &h, const Rest &... rest) : head(h), tail(rest...) {}
    template <class U, class... URest> requires (sizeof...(URest) == sizeof...(Rest) && !(sizeof...(Rest) == 0 && __is_tuple<typename remove_cvref<U>::type>::value)) constexpr tuple(U &&h, URest &&... rest) : head(forward<U>(h)), tail(forward<URest>(rest)...) {}
    // (From a tuple of other types, element by element.)
    template <class U, class... URest> requires (sizeof...(URest) == sizeof...(Rest)) constexpr tuple(const tuple<U, URest...> &other) : head(other.head), tail(other.tail) {}
    template <class U, class... URest> requires (sizeof...(URest) == sizeof...(Rest)) constexpr tuple(tuple<U, URest...> &&other) : head(forward<U>(other.head)), tail(move(other.tail)) {}
    template <class U, class... URest> requires (sizeof...(URest) == sizeof...(Rest)) tuple &operator=(const tuple<U, URest...> &other) { head = other.head; tail = other.tail; return *this; }
    template <class U, class... URest> requires (sizeof...(URest) == sizeof...(Rest)) tuple &operator=(tuple<U, URest...> &&other) { head = forward<U>(other.head); tail = move(other.tail); return *this; }
    // (A tuple of two made of a pair: `FPAndInfo(entry)` of a map's.)
    template <class U1, class U2> requires (sizeof...(Rest) == 1) constexpr tuple(const pair<U1, U2> &p) : head(p.first), tail(p.second) {}
    template <class U1, class U2> requires (sizeof...(Rest) == 1) constexpr tuple(pair<U1, U2> &&p) : head(forward<U1>(p.first)), tail(forward<U2>(p.second)) {}
    // (A pair to a tuple of two: `std::tie(a, b) = pair`.)
    template <class U1, class U2> requires (sizeof...(Rest) == 1) tuple &operator=(const pair<U1, U2> &p) { head = p.first; tail.head = p.second; return *this; }
    template <class U1, class U2> requires (sizeof...(Rest) == 1) tuple &operator=(pair<U1, U2> &&p) { head = forward<U1>(p.first); tail.head = forward<U2>(p.second); return *this; }
    constexpr tuple(__tuple_join_t, const T &h, tuple<Rest...> &&t) : head(h), tail(move(t)) {}
    constexpr tuple(const tuple &other) : head(other.head), tail(other.tail) {}
    constexpr tuple(tuple &&other) : head(move(other.head)), tail(move(other.tail)) {}
    tuple &operator=(const tuple &other) { head = other.head; tail = other.tail; return *this; }
    tuple &operator=(tuple &&other) { head = move(other.head); tail = move(other.tail); return *this; }
    void swap(tuple &other) { std::swap(head, other.head); tail.swap(other.tail); }
};

template <class... Ts> struct tuple_size<tuple<Ts...> > : integral_constant<size_t, sizeof...(Ts)> {};
template <class T, class... Rest> struct tuple_element<0, tuple<T, Rest...> > { typedef T type; };
template <size_t I, class T, class... Rest> struct tuple_element<I, tuple<T, Rest...> > : tuple_element<I - 1, tuple<Rest...> > {};

// (get and make_tuple are constexpr, as C++14 has them: WebCore reads
// `std::get<Index>(Descriptor::components)` of a constexpr tuple into a
// constexpr local.)
template <size_t I> struct __tuple_get {
    template <class T, class... Rest> static constexpr typename tuple_element<I, tuple<T, Rest...> >::type &get(tuple<T, Rest...> &t) { return __tuple_get<I - 1>::get(t.tail); }
    template <class T, class... Rest> static constexpr const typename tuple_element<I, tuple<T, Rest...> >::type &get(const tuple<T, Rest...> &t) { return __tuple_get<I - 1>::get(t.tail); }
};
template <> struct __tuple_get<0> {
    template <class T, class... Rest> static constexpr T &get(tuple<T, Rest...> &t) { return t.head; }
    template <class T, class... Rest> static constexpr const T &get(const tuple<T, Rest...> &t) { return t.head; }
};
template <size_t I, class... Ts> constexpr typename tuple_element<I, tuple<Ts...> >::type &get(tuple<Ts...> &t) { return __tuple_get<I>::get(t); }
template <size_t I, class... Ts> constexpr const typename tuple_element<I, tuple<Ts...> >::type &get(const tuple<Ts...> &t) { return __tuple_get<I>::get(t); }
template <size_t I, class... Ts> constexpr typename tuple_element<I, tuple<Ts...> >::type &&get(tuple<Ts...> &&t) { return move(__tuple_get<I>::get(t)); }
// By type (C++14): the element of that type, the one there is.
template <class T, class... Ts> struct __tuple_index { static constexpr size_t value = 0; };
template <class T, class U, class... Rest> struct __tuple_index<T, U, Rest...> { static constexpr size_t value = is_same<T, U>::value ? 0 : 1 + __tuple_index<T, Rest...>::value; };
template <class T, class... Ts> constexpr T &get(tuple<Ts...> &t) { return __tuple_get<__tuple_index<T, Ts...>::value>::get(t); }
template <class T, class... Ts> constexpr const T &get(const tuple<Ts...> &t) { return __tuple_get<__tuple_index<T, Ts...>::value>::get(t); }
template <class T, class... Ts> constexpr T &&get(tuple<Ts...> &&t) { return move(__tuple_get<__tuple_index<T, Ts...>::value>::get(t)); }

template <class... Ts> constexpr tuple<typename decay<Ts>::type...> make_tuple(Ts &&... args) { return tuple<typename decay<Ts>::type...>(forward<Ts>(args)...); }
template <class... Ts> tuple<Ts &...> tie(Ts &... args) noexcept { return tuple<Ts &...>(args...); }
template <class... Ts> tuple<Ts &&...> forward_as_tuple(Ts &&... args) noexcept { return tuple<Ts &&...>(forward<Ts>(args)...); }

template <class T1, class T2> struct __tuple_cat2;
template <class... B> struct __tuple_cat2<tuple<>, tuple<B...> > {
    typedef tuple<B...> type;
    static type cat(const tuple<> &, const tuple<B...> &b) { return b; }
};
template <class A, class... As, class... B> struct __tuple_cat2<tuple<A, As...>, tuple<B...> > {
    typedef tuple<A, As..., B...> type;
    static type cat(const tuple<A, As...> &a, const tuple<B...> &b) { return type(__tuple_join_t(), a.head, __tuple_cat2<tuple<As...>, tuple<B...> >::cat(a.tail, b)); }
};
inline tuple<> tuple_cat() { return tuple<>(); }
template <class T1> T1 tuple_cat(const T1 &a) { return a; }
template <class T1, class T2> typename __tuple_cat2<T1, T2>::type tuple_cat(const T1 &a, const T2 &b) { return __tuple_cat2<T1, T2>::cat(a, b); }
template <class T1, class T2, class T3, class... R> auto tuple_cat(const T1 &a, const T2 &b, const T3 &c, const R &... r) { return tuple_cat(tuple_cat(a, b), c, r...); }

// (Element by element through a class: a declared-only operator over
// any tuple would be chosen for some of them and never defined.)
template <class... Ts> struct __tuple_equal;
template <> struct __tuple_equal<> {
    static bool equal(const tuple<> &, const tuple<> &) { return true; }
};
template <class T, class... Rest> struct __tuple_equal<T, Rest...> {
    static bool equal(const tuple<T, Rest...> &a, const tuple<T, Rest...> &b) { return a.head == b.head && __tuple_equal<Rest...>::equal(a.tail, b.tail); }
};
template <class... Ts> bool operator==(const tuple<Ts...> &a, const tuple<Ts...> &b) { return __tuple_equal<Ts...>::equal(a, b); }
template <class... Ts> bool operator!=(const tuple<Ts...> &a, const tuple<Ts...> &b) { return !(a == b); }
// Lexicographic order, element by element.
template <class... Ts> struct __tuple_less;
template <> struct __tuple_less<> {
    static bool less(const tuple<> &, const tuple<> &) { return false; }
};
template <class T, class... Rest> struct __tuple_less<T, Rest...> {
    static bool less(const tuple<T, Rest...> &a, const tuple<T, Rest...> &b) { return a.head < b.head || (!(b.head < a.head) && __tuple_less<Rest...>::less(a.tail, b.tail)); }
};
template <class... Ts> bool operator<(const tuple<Ts...> &a, const tuple<Ts...> &b) { return __tuple_less<Ts...>::less(a, b); }
template <class... Ts> bool operator>(const tuple<Ts...> &a, const tuple<Ts...> &b) { return b < a; }
template <class... Ts> bool operator<=(const tuple<Ts...> &a, const tuple<Ts...> &b) { return !(b < a); }
template <class... Ts> bool operator>=(const tuple<Ts...> &a, const tuple<Ts...> &b) { return !(a < b); }

template <class F, class Tuple, size_t... Is> decltype(auto) __apply(F &&f, Tuple &&t, index_sequence<Is...>) { return f(get<Is>(t)...); }
template <class F, class Tuple> decltype(auto) apply(F &&f, Tuple &&t) { return __apply(forward<F>(f), forward<Tuple>(t), make_index_sequence<tuple_size<typename decay<Tuple>::type>::value>()); }

struct ignore_t { template <class T> const ignore_t &operator=(const T &) const { return *this; } };
constexpr ignore_t ignore = ignore_t();


template <class... Ts> tuple(Ts...) -> tuple<Ts...>;
template <class A, class B> tuple(pair<A, B>) -> tuple<A, B>;
}
#endif
