// <functional>: reference_wrapper, ref and cref, invoke, the operator
// function objects, less and hash, std::function over a heap-held
// callable.
#ifndef __MLXCC_FUNCTIONAL
#define __MLXCC_FUNCTIONAL
#include <stddef.h>
#include <utility>
#include <type_traits>
#include <new>
// (The C++20 concepts come along, as with other libraries: code naming
// std::derived_from after <functional> alone.)
#if __cplusplus >= 202002L
#include <concepts>
#endif

namespace std {

template <class T> class reference_wrapper {
public:
    typedef T type;
    reference_wrapper(T &ref) noexcept : _ptr(&ref) {}
    reference_wrapper(const reference_wrapper &other) noexcept : _ptr(other._ptr) {}
    reference_wrapper &operator=(const reference_wrapper &other) noexcept { _ptr = other._ptr; return *this; }
    operator T &() const noexcept { return *_ptr; }
    T &get() const noexcept { return *_ptr; }
    template <class... Args> auto operator()(Args &&... args) const -> decltype((*_ptr)(forward<Args>(args)...)) { return (*_ptr)(forward<Args>(args)...); }
private:
    T *_ptr;
};
template <class T> reference_wrapper<T> ref(T &t) noexcept { return reference_wrapper<T>(t); }
template <class T> reference_wrapper<const T> cref(const T &t) noexcept { return reference_wrapper<const T>(t); }
template <class T> struct unwrap_reference { typedef T type; };
template <class T> struct unwrap_reference<reference_wrapper<T> > { typedef T &type; };
template <class T> struct unwrap_ref_decay : unwrap_reference<typename decay<T>::type> {};
template <class T> struct __is_reference_wrapper : false_type {};
template <class T> struct __is_reference_wrapper<reference_wrapper<T> > : true_type {};

// (A pointer to a member function takes the object first, by
// reference or pointer.)
template <class P, class T, class... A> decltype(auto) __invoke_member(P pm, T &&object, A &&... args) {
    if constexpr (is_pointer<typename remove_reference<T>::type>::value) return ((*object).*pm)(forward<A>(args)...);
    else return (object.*pm)(forward<A>(args)...);
}
template <class F, class... Args> decltype(auto) __invoke(F &&f, Args &&... args) {
    if constexpr (is_member_function_pointer<typename remove_cvref<F>::type>::value) return __invoke_member(f, forward<Args>(args)...);
    else return forward<F>(f)(forward<Args>(args)...);
}
template <class F, class... Args> decltype(auto) invoke(F &&f, Args &&... args) { return __invoke(forward<F>(f), forward<Args>(args)...); }

// mem_fn: a pointer to a member function as a callable taking the
// object (by pointer or reference) first.
template <class P> struct __mem_fn {
    P pm;
    template <class T, class... A> decltype(auto) operator()(T *object, A &&... args) const { return (object->*pm)(forward<A>(args)...); }
    template <class T, class... A> decltype(auto) operator()(T &object, A &&... args) const { return (object.*pm)(forward<A>(args)...); }
};
template <class P> __mem_fn<P> mem_fn(P pm) noexcept { return __mem_fn<P>{ pm }; }

// bind: a callable with some arguments bound, `placeholders::_1`... the
// call's own (WTF's RunLoop::Timer `std::bind(function, object)`,
// WebCore's MarkupAccumulator `std::bind(f, _1, std::ref(element))`).
namespace placeholders {
template <int N> struct __placeholder {};
inline constexpr __placeholder<1> _1 {};
inline constexpr __placeholder<2> _2 {};
inline constexpr __placeholder<3> _3 {};
inline constexpr __placeholder<4> _4 {};
}
template <class T> struct is_placeholder : integral_constant<int, 0> {};
template <int N> struct is_placeholder<placeholders::__placeholder<N> > : integral_constant<int, N> {};
template <class T> struct is_placeholder<const T> : is_placeholder<T> {};
template <class T> inline constexpr int is_placeholder_v = is_placeholder<T>::value;
template <class T> struct is_bind_expression : false_type {};
template <class T> inline constexpr bool is_bind_expression_v = is_bind_expression<T>::value;

template <class... B> struct __bind_store {};
template <class H, class... T> struct __bind_store<H, T...> {
    template <class U, class... R> __bind_store(U &&u, R &&... rest) : head(forward<U>(u)), tail(forward<R>(rest)...) {}
    H head;
    __bind_store<T...> tail;
};
template <size_t I, class S> auto &__bind_get(S &store) {
    if constexpr (I == 0) return store.head;
    else return __bind_get<I - 1>(store.tail);
}
template <size_t N, class H, class... T> decltype(auto) __bind_nth(H &&h, T &&... t) {
    if constexpr (N == 0) return forward<H>(h);
    else return __bind_nth<N - 1>(forward<T>(t)...);
}
// A bound argument as the call gets it: the call's own for a
// placeholder, the referred object for a reference_wrapper, else the one
// stored.
template <class B, class... A> decltype(auto) __bind_argument(B &bound, A &&... args) {
    if constexpr (is_placeholder<B>::value > 0) return __bind_nth<is_placeholder<B>::value - 1>(forward<A>(args)...);
    else if constexpr (__is_reference_wrapper<B>::value) return bound.get();
    else return (bound);
}
template <class F, class... B> class __bind {
public:
    template <class G, class... U> __bind(G &&g, U &&... u) : _f(forward<G>(g)), _bound(forward<U>(u)...) {}
    template <class... A> decltype(auto) operator()(A &&... args) { return call(index_sequence_for<B...> {}, forward<A>(args)...); }
    template <class... A> decltype(auto) operator()(A &&... args) const { return const_cast<__bind *>(this)->call(index_sequence_for<B...> {}, forward<A>(args)...); }
private:
    template <size_t... I, class... A> decltype(auto) call(index_sequence<I...>, A &&... args) { return __invoke(_f, __bind_argument(__bind_get<I>(_bound), args...)...); }
    F _f;
    __bind_store<B...> _bound;
};
template <class F, class... B> struct is_bind_expression<__bind<F, B...> > : true_type {};
template <class F, class... B> __bind<typename decay<F>::type, typename decay<B>::type...> bind(F &&f, B &&... bound) {
    return __bind<typename decay<F>::type, typename decay<B>::type...>(forward<F>(f), forward<B>(bound)...);
}

template <class T = void> struct plus { constexpr T operator()(const T &a, const T &b) const { return a + b; } };
template <class T = void> struct minus { constexpr T operator()(const T &a, const T &b) const { return a - b; } };
template <class T = void> struct multiplies { constexpr T operator()(const T &a, const T &b) const { return a * b; } };
template <class T = void> struct divides { constexpr T operator()(const T &a, const T &b) const { return a / b; } };
template <class T = void> struct modulus { constexpr T operator()(const T &a, const T &b) const { return a % b; } };
template <class T = void> struct negate { constexpr T operator()(const T &a) const { return -a; } };
template <class T = void> struct equal_to { constexpr bool operator()(const T &a, const T &b) const { return a == b; } };
template <class T = void> struct not_equal_to { constexpr bool operator()(const T &a, const T &b) const { return a != b; } };
template <class T = void> struct greater { constexpr bool operator()(const T &a, const T &b) const { return a > b; } };
template <class T = void> struct less { constexpr bool operator()(const T &a, const T &b) const { return a < b; } };
template <class T = void> struct greater_equal { constexpr bool operator()(const T &a, const T &b) const { return a >= b; } };
template <class T = void> struct less_equal { constexpr bool operator()(const T &a, const T &b) const { return a <= b; } };
template <class T = void> struct logical_and { constexpr bool operator()(const T &a, const T &b) const { return a && b; } };
template <class T = void> struct logical_or { constexpr bool operator()(const T &a, const T &b) const { return a || b; } };
template <class T = void> struct logical_not { constexpr bool operator()(const T &a) const { return !a; } };
template <class T = void> struct bit_and { constexpr T operator()(const T &a, const T &b) const { return a & b; } };
template <class T = void> struct bit_or { constexpr T operator()(const T &a, const T &b) const { return a | b; } };
template <class T = void> struct bit_xor { constexpr T operator()(const T &a, const T &b) const { return a ^ b; } };
template <> struct less<void> { template <class A, class B> constexpr bool operator()(const A &a, const B &b) const { return a < b; } };
template <> struct equal_to<void> { template <class A, class B> constexpr bool operator()(const A &a, const B &b) const { return a == b; } };
template <> struct plus<void> { template <class A, class B> constexpr auto operator()(const A &a, const B &b) const -> decltype(a + b) { return a + b; } };
struct identity { template <class T> constexpr T &&operator()(T &&t) const noexcept { return forward<T>(t); } };
// not_fn(f): a callable answering !f(args...).
template <class F> struct __not_fn {
    F f;
    template <class... Args> constexpr bool operator()(Args &&... args) const { return !f(forward<Args>(args)...); }
};
template <class F> constexpr __not_fn<typename decay<F>::type> not_fn(F &&f) { return __not_fn<typename decay<F>::type>{forward<F>(f)}; }

// (An enum's hash is its value; other types' hashes are the
// specializations below and those of their headers.)
template <class T> struct hash {
    size_t operator()(T value) const noexcept requires is_enum<T>::value { return static_cast<size_t>(value); }
};
template <> struct hash<bool> { size_t operator()(bool v) const noexcept { return v; } };
template <> struct hash<char> { size_t operator()(char v) const noexcept { return (unsigned char)v; } };
template <> struct hash<unsigned char> { size_t operator()(unsigned char v) const noexcept { return v; } };
template <> struct hash<short> { size_t operator()(short v) const noexcept { return (unsigned short)v; } };
template <> struct hash<unsigned short> { size_t operator()(unsigned short v) const noexcept { return v; } };
template <> struct hash<int> { size_t operator()(int v) const noexcept { return (unsigned)v; } };
template <> struct hash<unsigned> { size_t operator()(unsigned v) const noexcept { return v; } };
template <> struct hash<long> { size_t operator()(long v) const noexcept { return (unsigned long)v; } };
template <> struct hash<unsigned long> { size_t operator()(unsigned long v) const noexcept { return v; } };
template <> struct hash<signed char> { size_t operator()(signed char v) const noexcept { return (unsigned char)v; } };
template <> struct hash<long long> { size_t operator()(long long v) const noexcept { return (unsigned long long)v; } };
template <> struct hash<unsigned long long> { size_t operator()(unsigned long long v) const noexcept { return v; } };
template <> struct hash<char16_t> { size_t operator()(char16_t v) const noexcept { return v; } };
template <> struct hash<char32_t> { size_t operator()(char32_t v) const noexcept { return v; } };
template <> struct hash<wchar_t> { size_t operator()(wchar_t v) const noexcept { return (unsigned)v; } };
template <> struct hash<decltype(nullptr)> { size_t operator()(decltype(nullptr)) const noexcept { return 0; } };
template <class T> struct hash<T *> { size_t operator()(T *p) const noexcept { return reinterpret_cast<size_t>(p) >> 3; } };

// std::function: a callable of any type held on the heap behind a
// virtual call.
template <class Signature> class function;
template <class R, class... Args> class function<R(Args...)> {
    struct Holder {
        virtual ~Holder() {}
        virtual R call(Args... args) = 0;
        virtual Holder *clone() const = 0;
    };
    template <class F> struct Held : Holder {
        F f;
        Held(const F &callable) : f(callable) {}
        R call(Args... args) { return __invoke(f, forward<Args>(args)...); }
        Holder *clone() const { return new Held(f); }
    };
    Holder *_held;
public:
    typedef R result_type;
    function() noexcept : _held(0) {}
    function(nullptr_t) noexcept : _held(0) {}
    function(const function &other) : _held(other._held ? other._held->clone() : 0) {}
    function(function &&other) noexcept : _held(other._held) { other._held = 0; }
    // (Of a callable taking the arguments only: is_convertible of
    // another is false, `requires (!std::is_convertible_v<Predicate,
    // ViolatedDirectiveCallback>)` in WebCore's ContentSecurityPolicy.h.)
    template <class F, class = typename enable_if<is_invocable_r<R, F &, Args...>::value>::type> function(F f) : _held(new Held<F>(f)) {}
    ~function() { delete _held; }
    function &operator=(const function &other) {
        if (this != &other) { delete _held; _held = other._held ? other._held->clone() : 0; }
        return *this;
    }
    function &operator=(function &&other) noexcept {
        if (this != &other) { delete _held; _held = other._held; other._held = 0; }
        return *this;
    }
    function &operator=(nullptr_t) noexcept { delete _held; _held = 0; return *this; }
    template <class F, class = typename enable_if<is_invocable_r<R, F &, Args...>::value>::type> function &operator=(F f) { delete _held; _held = new Held<F>(f); return *this; }
    void swap(function &other) noexcept { Holder *h = _held; _held = other._held; other._held = h; }
    explicit operator bool() const noexcept { return _held != 0; }
    R operator()(Args... args) const { return _held->call(forward<Args>(args)...); }
};
template <class R, class... Args> bool operator==(const function<R(Args...)> &f, nullptr_t) noexcept { return !f; }
template <class R, class... Args> bool operator!=(const function<R(Args...)> &f, nullptr_t) noexcept { return (bool)f; }

}
#endif
