// <forward_list>: std::forward_list, a singly linked list from a head
// link (before_begin); iterators stay valid until their element is
// erased.
#ifndef __MLXCC_FORWARD_LIST
#define __MLXCC_FORWARD_LIST
#include <stddef.h>
#include <initializer_list>
#include <iterator>
#include <new>
#include <utility>

namespace std {

template <typename T> struct __flist_link {
    __flist_link *next;
};

template <typename T> struct __flist_node : __flist_link<T> {
    T value;
    template <typename... A> __flist_node(A &&... args) : value(std::forward<A>(args)...) {}
};

template <typename T, typename R, typename P> class __flist_iterator {
public:
    typedef forward_iterator_tag iterator_category;
    typedef T value_type;
    typedef ptrdiff_t difference_type;
    typedef P pointer;
    typedef R reference;

    __flist_link<T> *link;

    __flist_iterator() : link(nullptr) {}
    explicit __flist_iterator(__flist_link<T> *l) : link(l) {}
    // (iterator to const_iterator)
    template <typename R2, typename P2> __flist_iterator(const __flist_iterator<T, R2, P2> &other) : link(other.link) {}

    R operator*() const { return static_cast<__flist_node<T> *>(link)->value; }
    P operator->() const { return &static_cast<__flist_node<T> *>(link)->value; }
    __flist_iterator &operator++() { link = link->next; return *this; }
    __flist_iterator operator++(int) { __flist_iterator old = *this; link = link->next; return old; }
    template <typename R2, typename P2> bool operator==(const __flist_iterator<T, R2, P2> &other) const { return link == other.link; }
    template <typename R2, typename P2> bool operator!=(const __flist_iterator<T, R2, P2> &other) const { return link != other.link; }
};

template <typename T> class forward_list {
public:
    typedef T value_type;
    typedef T &reference;
    typedef const T &const_reference;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef __flist_iterator<T, T &, T *> iterator;
    typedef __flist_iterator<T, const T &, const T *> const_iterator;

    forward_list() { head.next = nullptr; }
    forward_list(initializer_list<T> values) {
        head.next = nullptr;
        assign(values.begin(), values.end());
    }
    forward_list(const forward_list &other) {
        head.next = nullptr;
        assign(other.begin(), other.end());
    }
    forward_list(forward_list &&other) noexcept {
        head.next = other.head.next;
        other.head.next = nullptr;
    }
    ~forward_list() { clear(); }

    forward_list &operator=(const forward_list &other) {
        if (this != &other) assign(other.begin(), other.end());
        return *this;
    }
    forward_list &operator=(forward_list &&other) noexcept {
        if (this != &other) {
            clear();
            head.next = other.head.next;
            other.head.next = nullptr;
        }
        return *this;
    }
    forward_list &operator=(initializer_list<T> values) {
        assign(values.begin(), values.end());
        return *this;
    }

    // (The elements in order: each after the last one made.)
    template <typename It> void assign(It first, It last) {
        clear();
        __flist_link<T> *tail = &head;
        for (; first != last; ++first) {
            __flist_node<T> *node = new __flist_node<T>(*first);
            node->next = nullptr;
            tail->next = node;
            tail = node;
        }
    }

    iterator before_begin() { return iterator(&head); }
    const_iterator before_begin() const { return const_iterator(const_cast<__flist_link<T> *>(&head)); }
    const_iterator cbefore_begin() const { return before_begin(); }
    iterator begin() { return iterator(head.next); }
    const_iterator begin() const { return const_iterator(head.next); }
    const_iterator cbegin() const { return begin(); }
    iterator end() { return iterator(nullptr); }
    const_iterator end() const { return const_iterator(nullptr); }
    const_iterator cend() const { return end(); }

    bool empty() const { return head.next == nullptr; }
    T &front() { return static_cast<__flist_node<T> *>(head.next)->value; }
    const T &front() const { return static_cast<__flist_node<T> *>(head.next)->value; }

    template <typename... A> T &emplace_front(A &&... args) {
        return *emplace_after(before_begin(), std::forward<A>(args)...);
    }
    void push_front(const T &value) { emplace_after(before_begin(), value); }
    void push_front(T &&value) { emplace_after(before_begin(), std::move(value)); }
    void pop_front() { erase_after(before_begin()); }

    template <typename... A> iterator emplace_after(const_iterator position, A &&... args) {
        __flist_node<T> *node = new __flist_node<T>(std::forward<A>(args)...);
        node->next = position.link->next;
        position.link->next = node;
        return iterator(node);
    }
    iterator insert_after(const_iterator position, const T &value) { return emplace_after(position, value); }
    iterator insert_after(const_iterator position, T &&value) { return emplace_after(position, std::move(value)); }

    iterator erase_after(const_iterator position) {
        __flist_link<T> *gone = position.link->next;
        position.link->next = gone->next;
        delete static_cast<__flist_node<T> *>(gone);
        return iterator(position.link->next);
    }
    iterator erase_after(const_iterator position, const_iterator last) {
        while (position.link->next != last.link) erase_after(position);
        return iterator(last.link);
    }

    template <typename Pred> size_type remove_if(Pred pred) {
        size_type removed = 0;
        __flist_link<T> *at = &head;
        while (at->next != nullptr) {
            if (pred(static_cast<__flist_node<T> *>(at->next)->value)) {
                erase_after(const_iterator(at));
                ++removed;
            } else {
                at = at->next;
            }
        }
        return removed;
    }
    size_type remove(const T &value) {
        return remove_if([&value](const T &element) { return element == value; });
    }

    void reverse() noexcept {
        __flist_link<T> *done = nullptr;
        __flist_link<T> *at = head.next;
        while (at != nullptr) {
            __flist_link<T> *next = at->next;
            at->next = done;
            done = at;
            at = next;
        }
        head.next = done;
    }

    void clear() noexcept {
        __flist_link<T> *at = head.next;
        while (at != nullptr) {
            __flist_link<T> *next = at->next;
            delete static_cast<__flist_node<T> *>(at);
            at = next;
        }
        head.next = nullptr;
    }
    void swap(forward_list &other) noexcept {
        __flist_link<T> *mine = head.next;
        head.next = other.head.next;
        other.head.next = mine;
    }

private:
    __flist_link<T> head;
};

template <typename T> bool operator==(const forward_list<T> &a, const forward_list<T> &b) {
    auto i = a.begin();
    auto j = b.begin();
    for (; i != a.end() && j != b.end(); ++i, ++j) {
        if (!(*i == *j)) return false;
    }
    return i == a.end() && j == b.end();
}
template <typename T> bool operator!=(const forward_list<T> &a, const forward_list<T> &b) { return !(a == b); }
template <typename T> void swap(forward_list<T> &a, forward_list<T> &b) noexcept { a.swap(b); }

}
#endif
