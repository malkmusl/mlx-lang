// <memory>: std::unique_ptr (one owner), std::shared_ptr and weak_ptr
// (owners counted in a shared control block, atomically),
// enable_shared_from_this, make_unique and make_shared (the object in
// the control block), the pointer casts, std::allocator.
#ifndef __MLXCC_MEMORY
#define __MLXCC_MEMORY
#include <stddef.h>
#include <new>
#include <utility>
#include <type_traits>
#include <__allocator>

namespace std {

template <class T> T *addressof(T &t) noexcept { return &t; }
template <class T, class... Args> T *construct_at(T *p, Args &&... args) { return new (p) T(forward<Args>(args)...); }
template <class T> void destroy_at(T *p) { p->~T(); }
template <class It> void destroy(It first, It last) { for (; first != last; ++first) destroy_at(&*first); }
template <class It, class N> It destroy_n(It first, N n) { for (; n > 0; ++first, --n) destroy_at(&*first); return first; }

// The uninitialized algorithms: objects made in raw memory at `d`, as
// placement new (the element type is the destination's).
template <class It> using __uninit_value = typename remove_cv<typename remove_reference<decltype(*declval<It &>())>::type>::type;
template <class I, class O> O uninitialized_copy(I first, I last, O d) {
    for (; first != last; ++first, ++d) ::new (static_cast<void *>(&*d)) __uninit_value<O>(*first);
    return d;
}
template <class I, class N, class O> O uninitialized_copy_n(I first, N n, O d) {
    for (; n > 0; ++first, ++d, --n) ::new (static_cast<void *>(&*d)) __uninit_value<O>(*first);
    return d;
}
template <class I, class O> O uninitialized_move(I first, I last, O d) {
    for (; first != last; ++first, ++d) ::new (static_cast<void *>(&*d)) __uninit_value<O>(std::move(*first));
    return d;
}
template <class I, class N, class O> pair<I, O> uninitialized_move_n(I first, N n, O d) {
    for (; n > 0; ++first, ++d, --n) ::new (static_cast<void *>(&*d)) __uninit_value<O>(std::move(*first));
    return pair<I, O>(first, d);
}
template <class O, class T> void uninitialized_fill(O first, O last, const T &value) {
    for (; first != last; ++first) ::new (static_cast<void *>(&*first)) __uninit_value<O>(value);
}
template <class O, class N, class T> O uninitialized_fill_n(O first, N n, const T &value) {
    for (; n > 0; ++first, --n) ::new (static_cast<void *>(&*first)) __uninit_value<O>(value);
    return first;
}
template <class O> void uninitialized_default_construct(O first, O last) {
    for (; first != last; ++first) ::new (static_cast<void *>(&*first)) __uninit_value<O>;
}
template <class O, class N> O uninitialized_default_construct_n(O first, N n) {
    for (; n > 0; ++first, --n) ::new (static_cast<void *>(&*first)) __uninit_value<O>;
    return first;
}
template <class O> void uninitialized_value_construct(O first, O last) {
    for (; first != last; ++first) ::new (static_cast<void *>(&*first)) __uninit_value<O>();
}
template <class O, class N> O uninitialized_value_construct_n(O first, N n) {
    for (; n > 0; ++first, --n) ::new (static_cast<void *>(&*first)) __uninit_value<O>();
    return first;
}

template <class T> T *to_address(T *p) noexcept { return p; }

// The first address from ptr aligned to `alignment` with `size` bytes
// in the `space` left: ptr and space moved to it; null when there is
// no room.
inline void *align(size_t alignment, size_t size, void *&ptr, size_t &space) {
    const size_t address = (size_t)ptr;
    const size_t aligned = (address + alignment - 1) & ~(alignment - 1);
    const size_t skipped = aligned - address;
    if (skipped > space || size > space - skipped) return nullptr;
    space -= skipped;
    ptr = (void *)aligned;
    return ptr;
}
template <class P> auto to_address(const P &p) noexcept -> decltype(p.get()) { return p.get(); }

template <class T> struct default_delete {
    constexpr default_delete() noexcept = default;
    template <class U> default_delete(const default_delete<U> &) noexcept {}
    void operator()(T *p) const { delete p; }
};
template <class T> struct default_delete<T[]> {
    constexpr default_delete() noexcept = default;
    void operator()(T *p) const { delete[] p; }
};

// The deleter a unique_ptr holds: an empty one as a base (no room
// taken), any other as a member.
template <class D, bool = __is_empty(D) && !__is_final(D)> struct __deleter_box : D {
    __deleter_box() {}
    __deleter_box(const D &d) : D(d) {}
    D &deleter() { return *this; }
    const D &deleter() const { return *this; }
};
template <class D> struct __deleter_box<D, false> {
    D held_deleter;
    __deleter_box() : held_deleter() {}
    __deleter_box(const D &d) : held_deleter(d) {}
    D &deleter() { return held_deleter; }
    const D &deleter() const { return held_deleter; }
};

template <typename T, class D = default_delete<T> > class unique_ptr : private __deleter_box<D> {
    typedef __deleter_box<D> box_;
public:
    typedef T element_type;
    typedef T *pointer;
    typedef D deleter_type;
    unique_ptr() : held(0) {}
    unique_ptr(nullptr_t) : held(0) {}
    explicit unique_ptr(T *p) : held(p) {}
    unique_ptr(T *p, const D &d) : box_(d), held(p) {}
    unique_ptr(unique_ptr &&other) : box_(other.get_deleter()), held(other.release()) {}
    template <class U, class E> requires is_convertible_v<U *, T *> unique_ptr(unique_ptr<U, E> &&other) : box_(D(other.get_deleter())), held(other.release()) {}
    unique_ptr(const unique_ptr &) = delete;
    ~unique_ptr() { if (held) get_deleter()(held); }
    unique_ptr &operator=(unique_ptr &&other) { reset(other.release()); get_deleter() = other.get_deleter(); return *this; }
    template <class U, class E> requires is_convertible_v<U *, T *> unique_ptr &operator=(unique_ptr<U, E> &&other) { reset(other.release()); get_deleter() = D(other.get_deleter()); return *this; }
    unique_ptr &operator=(nullptr_t) { reset(); return *this; }
    unique_ptr &operator=(const unique_ptr &) = delete;
    D &get_deleter() { return box_::deleter(); }
    const D &get_deleter() const { return box_::deleter(); }
    T *get() const { return held; }
    T *release() { T *p = held; held = 0; return p; }
    void reset(T *p = 0) { T *old = held; held = p; if (old) get_deleter()(old); }
    void swap(unique_ptr &other) { T *p = held; held = other.held; other.held = p; D d = get_deleter(); get_deleter() = other.get_deleter(); other.get_deleter() = d; }
    T &operator*() const { return *held; }
    T *operator->() const { return held; }
    operator bool() const { return held != 0; }
private:
    T *held;
};

// An array's owner: `unique_ptr<T[]>`, `p[i]`, deleted by `delete[]`.
template <typename T, class D> class unique_ptr<T[], D> : private __deleter_box<D> {
    typedef __deleter_box<D> box_;
public:
    typedef T element_type;
    typedef T *pointer;
    typedef D deleter_type;
    unique_ptr() : held(0) {}
    unique_ptr(nullptr_t) : held(0) {}
    explicit unique_ptr(T *p) : held(p) {}
    unique_ptr(T *p, const D &d) : box_(d), held(p) {}
    unique_ptr(unique_ptr &&other) : box_(other.get_deleter()), held(other.release()) {}
    // (From an array of the elements made const: `unique_ptr<const char[]>`
    // of a `unique_ptr<char[]>`; the default deleters.)
    template <class U> requires is_same_v<const U, T> && (!is_same_v<U, T>) unique_ptr(unique_ptr<U[], default_delete<U[]> > &&other) : held(other.release()) {}
    unique_ptr(const unique_ptr &) = delete;
    ~unique_ptr() { if (held) get_deleter()(held); }
    unique_ptr &operator=(unique_ptr &&other) { reset(other.release()); get_deleter() = other.get_deleter(); return *this; }
    template <class U> requires is_same_v<const U, T> && (!is_same_v<U, T>) unique_ptr &operator=(unique_ptr<U[], default_delete<U[]> > &&other) { reset(other.release()); return *this; }
    unique_ptr &operator=(nullptr_t) { reset(); return *this; }
    unique_ptr &operator=(const unique_ptr &) = delete;
    D &get_deleter() { return box_::deleter(); }
    const D &get_deleter() const { return box_::deleter(); }
    T *get() const { return held; }
    T *release() { T *p = held; held = 0; return p; }
    void reset(T *p = 0) { T *old = held; held = p; if (old) get_deleter()(old); }
    void swap(unique_ptr &other) { T *p = held; held = other.held; other.held = p; D d = get_deleter(); get_deleter() = other.get_deleter(); other.get_deleter() = d; }
    T &operator[](size_t i) const { return held[i]; }
    operator bool() const { return held != 0; }
private:
    T *held;
};

template <typename T> bool operator==(const unique_ptr<T> &a, const unique_ptr<T> &b) { return a.get() == b.get(); }
template <typename T> bool operator!=(const unique_ptr<T> &a, const unique_ptr<T> &b) { return a.get() != b.get(); }

template <typename T, class... Args> unique_ptr<T> make_unique(Args &&... args) requires (!is_array_v<T>) { return unique_ptr<T>(new T(forward<Args>(args)...)); }
template <typename T> unique_ptr<T> make_unique(size_t n) requires is_array_v<T> { return unique_ptr<T>(new remove_extent_t<T>[n]()); }
template <typename T> bool operator==(const unique_ptr<T> &a, nullptr_t) { return a.get() == 0; }
template <typename T> bool operator!=(const unique_ptr<T> &a, nullptr_t) { return a.get() != 0; }

// shared_ptr and weak_ptr share a control block: the owners' count, the
// weak count (the weak_ptrs, plus one while there are owners), and how
// the object is destroyed (its deleter, or in place for make_shared);
// the counts change atomically.
struct __shared_control {
    long uses;
    long weaks;
    __shared_control() noexcept : uses(1), weaks(1) {}
    virtual ~__shared_control() {}
    virtual void dispose() noexcept = 0;
    void retain() noexcept { __atomic_fetch_add(&uses, 1, 5); }
    void release() noexcept {
        if (__atomic_sub_fetch(&uses, 1, 5) == 0) {
            dispose();
            releaseWeak();
        }
    }
    void retainWeak() noexcept { __atomic_fetch_add(&weaks, 1, 5); }
    void releaseWeak() noexcept {
        if (__atomic_sub_fetch(&weaks, 1, 5) == 0) delete this;
    }
    // An owner more, unless there are none left (weak_ptr::lock).
    bool retainIfAlive() noexcept {
        long seen = __atomic_load_n(&uses, 5);
        while (seen != 0) {
            if (__atomic_compare_exchange_n(&uses, &seen, seen + 1, 0, 5, 5)) return true;
        }
        return false;
    }
    long count() const noexcept { return __atomic_load_n(&uses, 5); }
};
template <class P, class D> struct __shared_pointer_control : __shared_control {
    P pointer;
    D deleter;
    __shared_pointer_control(P p, D d) : pointer(p), deleter(d) {}
    void dispose() noexcept { deleter(pointer); }
};
template <class T> struct __shared_inline_control : __shared_control {
    alignas(T) unsigned char storage[sizeof(T)];
    template <class... A> __shared_inline_control(A &&... args) { ::new ((void *)storage) T(forward<A>(args)...); }
    T *object() noexcept { return reinterpret_cast<T *>(storage); }
    void dispose() noexcept { object()->~T(); }
};

template <class T> class weak_ptr;
template <class T> class enable_shared_from_this;

template <typename T> class shared_ptr {
public:
    typedef T element_type;
    typedef weak_ptr<T> weak_type;

    constexpr shared_ptr() noexcept : held(0), control(0) {}
    constexpr shared_ptr(nullptr_t) noexcept : held(0), control(0) {}
    template <class Y> explicit shared_ptr(Y *p) : held(p), control(p ? new __shared_pointer_control<Y *, default_delete<Y> >(p, default_delete<Y>()) : 0) { enableWeak(p); }
    template <class Y, class D> shared_ptr(Y *p, D d) : held(p), control(new __shared_pointer_control<Y *, D>(p, d)) { enableWeak(p); }
    template <class D> shared_ptr(nullptr_t, D d) : held(0), control(new __shared_pointer_control<T *, D>(0, d)) {}
    shared_ptr(const shared_ptr &other) noexcept : held(other.held), control(other.control) { if (control) control->retain(); }
    template <class Y, class = typename enable_if<is_convertible<Y *, T *>::value>::type> shared_ptr(const shared_ptr<Y> &other) noexcept : held(other.__held()), control(other.__control()) { if (control) control->retain(); }
    shared_ptr(shared_ptr &&other) noexcept : held(other.held), control(other.control) {
        other.held = 0;
        other.control = 0;
    }
    template <class Y, class = typename enable_if<is_convertible<Y *, T *>::value>::type> shared_ptr(shared_ptr<Y> &&other) noexcept : held(other.__held()), control(other.__control()) { other.__forget(); }
    // (Aliasing: owning what `other` owns, pointing at `p`.)
    template <class Y> shared_ptr(const shared_ptr<Y> &other, T *p) noexcept : held(p), control(other.__control()) { if (control) control->retain(); }
    template <class Y> explicit shared_ptr(const weak_ptr<Y> &other) : held(0), control(0) {
        if (other.__control() && other.__control()->retainIfAlive()) {
            held = other.__held();
            control = other.__control();
        }
    }
    template <class Y, class D> shared_ptr(unique_ptr<Y, D> &&other) : held(other.get()), control(0) {
        if (held) control = new __shared_pointer_control<Y *, D>(other.release(), other.get_deleter());
        enableWeak(held);
    }
    // (make_shared's: the object in the control block.)
    shared_ptr(T *p, __shared_control *c, bool) noexcept : held(p), control(c) { enableWeak(p); }
    ~shared_ptr() { if (control) control->release(); }

    shared_ptr &operator=(const shared_ptr &other) noexcept {
        shared_ptr(other).swap(*this);
        return *this;
    }
    template <class Y> shared_ptr &operator=(const shared_ptr<Y> &other) noexcept {
        shared_ptr(other).swap(*this);
        return *this;
    }
    shared_ptr &operator=(shared_ptr &&other) noexcept {
        shared_ptr(static_cast<shared_ptr &&>(other)).swap(*this);
        return *this;
    }
    template <class Y> shared_ptr &operator=(shared_ptr<Y> &&other) noexcept {
        shared_ptr(static_cast<shared_ptr<Y> &&>(other)).swap(*this);
        return *this;
    }
    template <class Y, class D> shared_ptr &operator=(unique_ptr<Y, D> &&other) {
        shared_ptr(static_cast<unique_ptr<Y, D> &&>(other)).swap(*this);
        return *this;
    }
    shared_ptr &operator=(nullptr_t) noexcept {
        reset();
        return *this;
    }

    void reset() noexcept { shared_ptr().swap(*this); }
    template <class Y> void reset(Y *p) { shared_ptr(p).swap(*this); }
    template <class Y, class D> void reset(Y *p, D d) { shared_ptr(p, d).swap(*this); }
    void swap(shared_ptr &other) noexcept {
        T *p = held;
        held = other.held;
        other.held = p;
        __shared_control *c = control;
        control = other.control;
        other.control = c;
    }
    T *get() const noexcept { return held; }
    T &operator*() const noexcept { return *held; }
    T *operator->() const noexcept { return held; }
    long use_count() const noexcept { return control ? control->count() : 0; }
    bool unique() const noexcept { return use_count() == 1; }
    explicit operator bool() const noexcept { return held != 0; }
    template <class Y> bool owner_before(const shared_ptr<Y> &other) const noexcept { return control < other.__control(); }
    template <class Y> bool owner_before(const weak_ptr<Y> &other) const noexcept { return control < other.__control(); }

    T *__held() const noexcept { return held; }
    __shared_control *__control() const noexcept { return control; }
    void __forget() noexcept {
        held = 0;
        control = 0;
    }

private:
    T *held;
    __shared_control *control;
    // An object deriving from enable_shared_from_this learns its owner.
    template <class Y> void enableWeak(Y *p) noexcept {
        if constexpr (requires { p->__weak_this; }) {
            if (p && p->__weak_this.expired()) p->__weak_this = shared_ptr<typename remove_cv<Y>::type>(*this, const_cast<typename remove_cv<Y>::type *>(p));
        }
    }
};

template <class T> class weak_ptr {
public:
    typedef T element_type;
    constexpr weak_ptr() noexcept : held(0), control(0) {}
    weak_ptr(const weak_ptr &other) noexcept : held(other.held), control(other.control) { if (control) control->retainWeak(); }
    template <class Y> weak_ptr(const weak_ptr<Y> &other) noexcept : held(other.__held()), control(other.__control()) { if (control) control->retainWeak(); }
    template <class Y> weak_ptr(const shared_ptr<Y> &other) noexcept : held(other.__held()), control(other.__control()) { if (control) control->retainWeak(); }
    weak_ptr(weak_ptr &&other) noexcept : held(other.held), control(other.control) {
        other.held = 0;
        other.control = 0;
    }
    ~weak_ptr() { if (control) control->releaseWeak(); }
    weak_ptr &operator=(const weak_ptr &other) noexcept {
        weak_ptr(other).swap(*this);
        return *this;
    }
    template <class Y> weak_ptr &operator=(const weak_ptr<Y> &other) noexcept {
        weak_ptr(other).swap(*this);
        return *this;
    }
    template <class Y> weak_ptr &operator=(const shared_ptr<Y> &other) noexcept {
        weak_ptr(other).swap(*this);
        return *this;
    }
    weak_ptr &operator=(weak_ptr &&other) noexcept {
        weak_ptr(static_cast<weak_ptr &&>(other)).swap(*this);
        return *this;
    }
    void reset() noexcept { weak_ptr().swap(*this); }
    void swap(weak_ptr &other) noexcept {
        T *p = held;
        held = other.held;
        other.held = p;
        __shared_control *c = control;
        control = other.control;
        other.control = c;
    }
    long use_count() const noexcept { return control ? control->count() : 0; }
    bool expired() const noexcept { return use_count() == 0; }
    shared_ptr<T> lock() const noexcept { return shared_ptr<T>(*this); }
    template <class Y> bool owner_before(const weak_ptr<Y> &other) const noexcept { return control < other.__control(); }
    template <class Y> bool owner_before(const shared_ptr<Y> &other) const noexcept { return control < other.__control(); }

    T *__held() const noexcept { return held; }
    __shared_control *__control() const noexcept { return control; }

private:
    T *held;
    __shared_control *control;
};

template <class T> class enable_shared_from_this {
public:
    shared_ptr<T> shared_from_this() { return shared_ptr<T>(__weak_this); }
    shared_ptr<const T> shared_from_this() const { return shared_ptr<const T>(__weak_this); }
    weak_ptr<T> weak_from_this() noexcept { return __weak_this; }
    weak_ptr<const T> weak_from_this() const noexcept { return __weak_this; }
    // (Set by the first shared_ptr owning the object.)
    mutable weak_ptr<T> __weak_this;
protected:
    constexpr enable_shared_from_this() noexcept {}
    enable_shared_from_this(const enable_shared_from_this &) noexcept {}
    enable_shared_from_this &operator=(const enable_shared_from_this &) noexcept { return *this; }
    ~enable_shared_from_this() {}
};

template <class T, class U> bool operator==(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept { return a.get() == b.get(); }
template <class T, class U> bool operator!=(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept { return a.get() != b.get(); }
template <class T, class U> bool operator<(const shared_ptr<T> &a, const shared_ptr<U> &b) noexcept { return a.get() < b.get(); }
template <class T> bool operator==(const shared_ptr<T> &a, nullptr_t) noexcept { return !a; }
template <class T> bool operator==(nullptr_t, const shared_ptr<T> &a) noexcept { return !a; }
template <class T> bool operator!=(const shared_ptr<T> &a, nullptr_t) noexcept { return (bool)a; }
template <class T> bool operator!=(nullptr_t, const shared_ptr<T> &a) noexcept { return (bool)a; }
template <class T> void swap(shared_ptr<T> &a, shared_ptr<T> &b) noexcept { a.swap(b); }
template <class T> void swap(weak_ptr<T> &a, weak_ptr<T> &b) noexcept { a.swap(b); }

template <typename T, class... Args> shared_ptr<T> make_shared(Args &&... args) {
    __shared_inline_control<T> *c = new __shared_inline_control<T>(forward<Args>(args)...);
    return shared_ptr<T>(c->object(), c, true);
}
template <class T, class U> shared_ptr<T> static_pointer_cast(const shared_ptr<U> &p) noexcept { return shared_ptr<T>(p, static_cast<T *>(p.get())); }
template <class T, class U> shared_ptr<T> const_pointer_cast(const shared_ptr<U> &p) noexcept { return shared_ptr<T>(p, const_cast<T *>(p.get())); }
template <class T, class U> shared_ptr<T> reinterpret_pointer_cast(const shared_ptr<U> &p) noexcept { return shared_ptr<T>(p, reinterpret_cast<T *>(p.get())); }

template <class T> struct hash;
template <class T> struct hash<shared_ptr<T> > {
    size_t operator()(const shared_ptr<T> &p) const noexcept { return reinterpret_cast<size_t>(p.get()) >> 3; }
};
template <class T, class D> struct hash<unique_ptr<T, D> > {
    size_t operator()(const unique_ptr<T, D> &p) const noexcept { return reinterpret_cast<size_t>(p.get()) >> 3; }
};
template <class T = void> struct owner_less {
    template <class A, class B> bool operator()(const A &a, const B &b) const noexcept { return a.owner_before(b); }
};

}
