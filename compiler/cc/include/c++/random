// <random>: the engines the standard defines exactly (linear
// congruential, Mersenne twister: minstd_rand0, minstd_rand, mt19937,
// mt19937_64; default_random_engine is minstd_rand0, as libstdc++'s),
// seed_seq, random_device (the kernel's getrandom), generate_canonical
// and the uniform, Bernoulli, normal and exponential distributions,
// which draw as libstdc++'s do (the same numbers of the same engine).
#ifndef __MLXCC_RANDOM
#define __MLXCC_RANDOM
#include <stddef.h>
#include <stdint.h>
#include <unistd.h>
#include <sys/syscall.h>
#include <cmath>
#include <initializer_list>
#include <iterator>
#include <limits>
#include <string>
#include <type_traits>
#include <vector>
#include <__uniform_int>

namespace std {

// (a * x + c) mod m without overflowing UIntType; m == 0 is 2^w.
template <class U, U a, U c, U m> constexpr U __mlx_lcg_next(U x) {
    if (m == 0) return U(a * x + c);
    if ((unsigned long long)m <= 0x100000000ull) return U(((unsigned long long)a * (unsigned long long)x + (unsigned long long)c) % (unsigned long long)m);
    return U(((unsigned __int128)a * (unsigned __int128)x + (unsigned __int128)c) % (unsigned __int128)m);
}

// A seed sequence: anything with generate() (not the engine's own
// result type).
template <class S, class E> concept __mlx_seed_sequence = !is_convertible<S, typename E::result_type>::value && !is_same<typename remove_cv<S>::type, E>::value;

class seed_seq {
public:
    typedef uint_least32_t result_type;
    seed_seq() {}
    template <class T> seed_seq(initializer_list<T> list) : seed_seq(list.begin(), list.end()) {}
    template <class I> seed_seq(I first, I last) {
        for (; first != last; ++first) __v.push_back(result_type(*first));
    }
    seed_seq(const seed_seq &) = delete;
    seed_seq &operator=(const seed_seq &) = delete;
    size_t size() const { return __v.size(); }
    template <class O> void param(O out) const {
        for (result_type x : __v) *out++ = x;
    }
    // [rand.util.seedseq]: the standard's mixing, exactly.
    template <class I> void generate(I first, I last) const {
        if (first == last) return;
        typedef typename iterator_traits<I>::value_type V;
        const size_t n = last - first;
        for (I i = first; i != last; ++i) *i = V(0x8b8b8b8bu);
        const size_t s = __v.size();
        const size_t t = n >= 623 ? 11 : n >= 68 ? 7 : n >= 39 ? 5 : n >= 7 ? 3 : (n - 1) / 2;
        const size_t p = (n - t) / 2;
        const size_t q = p + t;
        const size_t m = (s + 1 > n) ? s + 1 : n;
        auto T = [](uint32_t x) { return x ^ (x >> 27); };
        for (size_t k = 0; k < m; ++k) {
            uint32_t r1 = 1664525u * T(uint32_t(first[k % n]) ^ uint32_t(first[(k + p) % n]) ^ uint32_t(first[(k + n - 1) % n]));
            uint32_t r2 = r1;
            if (k == 0) r2 += uint32_t(s);
            else if (k <= s) r2 += uint32_t(k % n) + __v[k - 1];
            else r2 += uint32_t(k % n);
            first[(k + p) % n] = V(uint32_t(first[(k + p) % n]) + r1);
            first[(k + q) % n] = V(uint32_t(first[(k + q) % n]) + r2);
            first[k % n] = V(r2);
        }
        for (size_t k = m; k < m + n; ++k) {
            uint32_t r3 = 1566083941u * T(uint32_t(first[k % n]) + uint32_t(first[(k + p) % n]) + uint32_t(first[(k + n - 1) % n]));
            uint32_t r4 = r3 - uint32_t(k % n);
            first[(k + p) % n] = V(uint32_t(first[(k + p) % n]) ^ r3);
            first[(k + q) % n] = V(uint32_t(first[(k + q) % n]) ^ r4);
            first[k % n] = V(r4);
        }
    }

private:
    vector<result_type> __v;
};

template <class UIntType, UIntType a, UIntType c, UIntType m> class linear_congruential_engine {
public:
    typedef UIntType result_type;
    static constexpr result_type multiplier = a;
    static constexpr result_type increment = c;
    static constexpr result_type modulus = m;
    static constexpr result_type default_seed = 1u;

    linear_congruential_engine() : linear_congruential_engine(default_seed) {}
    explicit linear_congruential_engine(result_type s) { seed(s); }
    template <class S> requires __mlx_seed_sequence<S, linear_congruential_engine> explicit linear_congruential_engine(S &q) { seed(q); }

    void seed(result_type s = default_seed) {
        if (m == 0) {
            __x = s;
        } else if (c % m == 0 && s % m == 0) {
            __x = 1;
        } else {
            __x = s % m;
        }
    }
    template <class S> requires __mlx_seed_sequence<S, linear_congruential_engine> void seed(S &q) {
        // [rand.eng.lcong]: k words of 32 bits, k = ceil(log2(m) / 32).
        const int bits = m == 0 ? numeric_limits<UIntType>::digits : 64 - __builtin_clzll((unsigned long long)m - 1);
        const int k = (bits + 31) / 32;
        uint_least32_t words[5] = {};
        q.generate(words, words + k + 3);
        unsigned long long s = 0;
        for (int j = 0; j < k; ++j) s += (unsigned long long)words[j + 3] << (32 * j);
        seed(result_type(s));
    }

    static constexpr result_type min() { return c == 0u ? 1u : 0u; }
    static constexpr result_type max() { return m - 1u; }
    result_type operator()() { return __x = __mlx_lcg_next<UIntType, a, c, m>(__x); }
    void discard(unsigned long long z) {
        for (; z != 0; --z) (*this)();
    }
    friend bool operator==(const linear_congruential_engine &x, const linear_congruential_engine &y) { return x.__x == y.__x; }
    friend bool operator!=(const linear_congruential_engine &x, const linear_congruential_engine &y) { return x.__x != y.__x; }

private:
    UIntType __x;
};

template <class UIntType, size_t w, size_t n, size_t m, size_t r, UIntType a, size_t u, UIntType d, size_t s, UIntType b, size_t t, UIntType c, size_t l, UIntType f>
class mersenne_twister_engine {
public:
    typedef UIntType result_type;
    static constexpr size_t word_size = w;
    static constexpr size_t state_size = n;
    static constexpr size_t shift_size = m;
    static constexpr size_t mask_bits = r;
    static constexpr UIntType xor_mask = a;
    static constexpr size_t tempering_u = u;
    static constexpr UIntType tempering_d = d;
    static constexpr size_t tempering_s = s;
    static constexpr UIntType tempering_b = b;
    static constexpr size_t tempering_t = t;
    static constexpr UIntType tempering_c = c;
    static constexpr size_t tempering_l = l;
    static constexpr UIntType initialization_multiplier = f;
    static constexpr result_type default_seed = 5489u;

    mersenne_twister_engine() : mersenne_twister_engine(default_seed) {}
    explicit mersenne_twister_engine(result_type value) { seed(value); }
    template <class S> requires __mlx_seed_sequence<S, mersenne_twister_engine> explicit mersenne_twister_engine(S &q) { seed(q); }

    void seed(result_type value = default_seed) {
        __x[0] = value & __mask();
        for (size_t i = 1; i < n; ++i) {
            UIntType x = __x[i - 1];
            x ^= x >> (w - 2);
            x *= f;
            x += UIntType(i % n);
            __x[i] = x & __mask();
        }
        __i = n;
    }
    template <class S> requires __mlx_seed_sequence<S, mersenne_twister_engine> void seed(S &q) {
        const size_t k = (w + 31) / 32;
        uint_least32_t words[n * ((w + 31) / 32)];
        q.generate(words, words + n * k);
        bool zero = true;
        for (size_t i = 0; i < n; ++i) {
            UIntType factor = 1u;
            UIntType sum = 0u;
            for (size_t j = 0; j < k; ++j) {
                sum += UIntType(words[k * i + j]) * factor;
                factor = k > 1 ? UIntType(factor << 16 << 16) : factor;
            }
            __x[i] = sum & __mask();
            if (zero) {
                if (i == 0) {
                    if ((__x[0] >> r) != 0u) zero = false;
                } else if (__x[i] != 0u) {
                    zero = false;
                }
            }
        }
        if (zero) __x[0] = UIntType(1) << (w - 1);
        __i = n;
    }

    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return __mask(); }

    result_type operator()() {
        if (__i >= n) __twist();
        result_type z = __x[__i++];
        z ^= (z >> u) & d;
        z ^= (z << s) & b;
        z ^= (z << t) & c;
        z ^= z >> l;
        return z;
    }
    void discard(unsigned long long z) {
        for (; z != 0; --z) (*this)();
    }
    friend bool operator==(const mersenne_twister_engine &x, const mersenne_twister_engine &y) {
        // (The same state whatever the twist's position: compared
        // through their next n outputs' sources.)
        mersenne_twister_engine p = x;
        mersenne_twister_engine q = y;
        for (size_t i = 0; i < n; ++i)
            if (p() != q()) return false;
        return true;
    }
    friend bool operator!=(const mersenne_twister_engine &x, const mersenne_twister_engine &y) { return !(x == y); }

private:
    static constexpr UIntType __mask() { return w == numeric_limits<UIntType>::digits ? numeric_limits<UIntType>::max() : UIntType((UIntType(1) << w) - 1u); }
    void __twist() {
        const UIntType upper = (~UIntType()) << r & __mask();
        const UIntType lower = ~upper & __mask();
        for (size_t k = 0; k < n; ++k) {
            UIntType y = (__x[k] & upper) | (__x[(k + 1) % n] & lower);
            __x[k] = __x[(k + m) % n] ^ (y >> 1) ^ ((y & 1u) ? a : UIntType(0));
        }
        __i = 0;
    }
    UIntType __x[n];
    size_t __i;
};

typedef linear_congruential_engine<uint_fast32_t, 16807, 0, 2147483647> minstd_rand0;
typedef linear_congruential_engine<uint_fast32_t, 48271, 0, 2147483647> minstd_rand;
typedef mersenne_twister_engine<uint_fast32_t, 32, 624, 397, 31, 0x9908b0df, 11, 0xffffffff, 7, 0x9d2c5680, 15, 0xefc60000, 18, 1812433253> mt19937;
typedef mersenne_twister_engine<uint_fast64_t, 64, 312, 156, 31, 0xb5026f5aa96619e9ULL, 29, 0x5555555555555555ULL, 17, 0x71d67fffeda60000ULL, 37, 0xfff7eee000000000ULL, 43, 6364136223846793005ULL> mt19937_64;
typedef minstd_rand0 default_random_engine;

// Nondeterministic numbers: the kernel's getrandom.
class random_device {
public:
    typedef unsigned int result_type;
    random_device() {}
    explicit random_device(const string &) {}
    random_device(const random_device &) = delete;
    void operator=(const random_device &) = delete;
    static constexpr result_type min() { return 0; }
    static constexpr result_type max() { return 0xffffffffu; }
    double entropy() const noexcept { return 32.0; }
    result_type operator()() {
        result_type value = 0;
        while (syscall(SYS_getrandom, &value, sizeof value, 0) != (long)sizeof value) {}
        return value;
    }
};

// A real in [0, 1) of `bits` bits of the engine's draws, as libstdc++
// sums them.
template <class RealType, size_t bits, class G> RealType generate_canonical(G &g) {
    const size_t b = (size_t)numeric_limits<RealType>::digits < bits ? (size_t)numeric_limits<RealType>::digits : bits;
    const long double range = static_cast<long double>(g.max()) - static_cast<long double>(g.min()) + 1.0L;
    const size_t log2r = std::log(range) / std::log(2.0L);
    size_t k = (b + log2r - 1ul) / log2r;
    if (k < 1) k = 1;
    RealType sum = RealType(0);
    RealType factor = RealType(1);
    for (; k != 0; --k) {
        sum += RealType(g() - g.min()) * factor;
        factor *= range;
    }
    RealType ret = sum / factor;
    if (ret >= RealType(1)) ret = std::nextafter(RealType(1), RealType(0));
    return ret;
}

template <class RealType = double> class uniform_real_distribution {
public:
    typedef RealType result_type;
    struct param_type {
        typedef uniform_real_distribution distribution_type;
        param_type() : param_type(0) {}
        explicit param_type(RealType a, RealType b = RealType(1)) : __a(a), __b(b) {}
        result_type a() const { return __a; }
        result_type b() const { return __b; }
        friend bool operator==(const param_type &x, const param_type &y) { return x.__a == y.__a && x.__b == y.__b; }
        friend bool operator!=(const param_type &x, const param_type &y) { return !(x == y); }
        RealType __a;
        RealType __b;
    };
    uniform_real_distribution() : uniform_real_distribution(0.0) {}
    explicit uniform_real_distribution(RealType a, RealType b = RealType(1)) : __p(a, b) {}
    explicit uniform_real_distribution(const param_type &p) : __p(p) {}
    void reset() {}
    result_type a() const { return __p.a(); }
    result_type b() const { return __p.b(); }
    param_type param() const { return __p; }
    void param(const param_type &p) { __p = p; }
    result_type min() const { return a(); }
    result_type max() const { return b(); }
    template <class G> result_type operator()(G &g) { return (*this)(g, __p); }
    template <class G> result_type operator()(G &g, const param_type &p) {
        return generate_canonical<RealType, numeric_limits<RealType>::digits>(g) * (p.b() - p.a()) + p.a();
    }
    friend bool operator==(const uniform_real_distribution &x, const uniform_real_distribution &y) { return x.__p == y.__p; }
    friend bool operator!=(const uniform_real_distribution &x, const uniform_real_distribution &y) { return !(x == y); }

private:
    param_type __p;
};

class bernoulli_distribution {
public:
    typedef bool result_type;
    struct param_type {
        typedef bernoulli_distribution distribution_type;
        param_type() : param_type(0.5) {}
        explicit param_type(double p) : __p(p) {}
        double p() const { return __p; }
        friend bool operator==(const param_type &x, const param_type &y) { return x.__p == y.__p; }
        friend bool operator!=(const param_type &x, const param_type &y) { return !(x == y); }
        double __p;
    };
    bernoulli_distribution() : bernoulli_distribution(0.5) {}
    explicit bernoulli_distribution(double p) : __p(p) {}
    explicit bernoulli_distribution(const param_type &p) : __p(p) {}
    void reset() {}
    double p() const { return __p.p(); }
    param_type param() const { return __p; }
    void param(const param_type &p) { __p = p; }
    result_type min() const { return false; }
    result_type max() const { return true; }
    template <class G> result_type operator()(G &g) { return (*this)(g, __p); }
    template <class G> result_type operator()(G &g, const param_type &p) {
        return generate_canonical<double, numeric_limits<double>::digits>(g) < p.p();
    }
    friend bool operator==(const bernoulli_distribution &x, const bernoulli_distribution &y) { return x.__p == y.__p; }
    friend bool operator!=(const bernoulli_distribution &x, const bernoulli_distribution &y) { return !(x == y); }

private:
    param_type __p;
};

// Marsaglia's polar method, the second value of a pair kept for the
// next call.
template <class RealType = double> class normal_distribution {
public:
    typedef RealType result_type;
    struct param_type {
        typedef normal_distribution distribution_type;
        param_type() : param_type(0.0) {}
        explicit param_type(RealType mean, RealType stddev = RealType(1)) : __mean(mean), __stddev(stddev) {}
        RealType mean() const { return __mean; }
        RealType stddev() const { return __stddev; }
        friend bool operator==(const param_type &x, const param_type &y) { return x.__mean == y.__mean && x.__stddev == y.__stddev; }
        friend bool operator!=(const param_type &x, const param_type &y) { return !(x == y); }
        RealType __mean;
        RealType __stddev;
    };
    normal_distribution() : normal_distribution(0.0) {}
    explicit normal_distribution(RealType mean, RealType stddev = RealType(1)) : __p(mean, stddev) {}
    explicit normal_distribution(const param_type &p) : __p(p) {}
    void reset() { __saved_available = false; }
    RealType mean() const { return __p.mean(); }
    RealType stddev() const { return __p.stddev(); }
    param_type param() const { return __p; }
    void param(const param_type &p) { __p = p; }
    result_type min() const { return numeric_limits<RealType>::lowest(); }
    result_type max() const { return numeric_limits<RealType>::max(); }
    template <class G> result_type operator()(G &g) { return (*this)(g, __p); }
    template <class G> result_type operator()(G &g, const param_type &p) {
        result_type ret;
        if (__saved_available) {
            __saved_available = false;
            ret = __saved;
        } else {
            result_type x, y, r2;
            do {
                x = result_type(2.0) * generate_canonical<RealType, numeric_limits<RealType>::digits>(g) - 1.0;
                y = result_type(2.0) * generate_canonical<RealType, numeric_limits<RealType>::digits>(g) - 1.0;
                r2 = x * x + y * y;
            } while (r2 > 1.0 || r2 == 0.0);
            const result_type mult = std::sqrt(-2 * std::log(r2) / r2);
            __saved = x * mult;
            __saved_available = true;
            ret = y * mult;
        }
        return ret * p.stddev() + p.mean();
    }
    friend bool operator==(const normal_distribution &x, const normal_distribution &y) { return x.__p == y.__p && x.__saved_available == y.__saved_available && (!x.__saved_available || x.__saved == y.__saved); }
    friend bool operator!=(const normal_distribution &x, const normal_distribution &y) { return !(x == y); }

private:
    param_type __p;
    result_type __saved = 0;
    bool __saved_available = false;
};

template <class RealType = double> class exponential_distribution {
public:
    typedef RealType result_type;
    struct param_type {
        typedef exponential_distribution distribution_type;
        param_type() : param_type(1.0) {}
        explicit param_type(RealType lambda) : __lambda(lambda) {}
        RealType lambda() const { return __lambda; }
        friend bool operator==(const param_type &x, const param_type &y) { return x.__lambda == y.__lambda; }
        friend bool operator!=(const param_type &x, const param_type &y) { return !(x == y); }
        RealType __lambda;
    };
    exponential_distribution() : exponential_distribution(1.0) {}
    explicit exponential_distribution(RealType lambda) : __p(lambda) {}
    explicit exponential_distribution(const param_type &p) : __p(p) {}
    void reset() {}
    RealType lambda() const { return __p.lambda(); }
    param_type param() const { return __p; }
    void param(const param_type &p) { __p = p; }
    result_type min() const { return result_type(0); }
    result_type max() const { return numeric_limits<RealType>::max(); }
    template <class G> result_type operator()(G &g) { return (*this)(g, __p); }
    template <class G> result_type operator()(G &g, const param_type &p) {
        return -std::log(result_type(1) - generate_canonical<RealType, numeric_limits<RealType>::digits>(g)) / p.lambda();
    }
    friend bool operator==(const exponential_distribution &x, const exponential_distribution &y) { return x.__p == y.__p; }
    friend bool operator!=(const exponential_distribution &x, const exponential_distribution &y) { return !(x == y); }

private:
    param_type __p;
};

