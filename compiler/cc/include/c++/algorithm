        long there = 0;
        J other = first2;
        for (I x = first; x != last; ++x, ++other) {
            if (*x == *at) here++;
            if (*other == *at) there++;
        }
        if (here != there) return false;
    }
    return true;
}

// Heaps (the largest first, as LESS orders them) over random access
// iterators, for std::priority_queue.
template <typename I, typename C> void __sift_down(I first, ptrdiff_t at, ptrdiff_t n, C less) {
    while (true) {
        ptrdiff_t child = 2 * at + 1;
        if (child >= n) return;
        if (child + 1 < n && less(*(first + child), *(first + (child + 1)))) child++;
        if (!less(*(first + at), *(first + child))) return;
        swap(*(first + at), *(first + child));
        at = child;
    }
}
template <typename I, typename C> void push_heap(I first, I last, C less) {
    ptrdiff_t at = (last - first) - 1;
    while (at > 0) {
        ptrdiff_t parent = (at - 1) / 2;
        if (!less(*(first + parent), *(first + at))) return;
        swap(*(first + parent), *(first + at));
        at = parent;
    }
}
template <typename I> void push_heap(I first, I last) { push_heap(first, last, [](const auto &a, const auto &b) { return a < b; }); }
template <typename I, typename C> void pop_heap(I first, I last, C less) {
    ptrdiff_t n = last - first;
    if (n <= 1) return;
    swap(*first, *(first + (n - 1)));
    __sift_down(first, 0, n - 1, less);
}
template <typename I> void pop_heap(I first, I last) { pop_heap(first, last, [](const auto &a, const auto &b) { return a < b; }); }
template <typename I, typename C> void make_heap(I first, I last, C less) {
    ptrdiff_t n = last - first;
    for (ptrdiff_t at = n / 2; at-- > 0;) __sift_down(first, at, n, less);
}
template <typename I> void make_heap(I first, I last) { make_heap(first, last, [](const auto &a, const auto &b) { return a < b; }); }
template <typename I, typename C> void sort_heap(I first, I last, C less) {
    for (; last - first > 1; --last) pop_heap(first, last, less);
}
template <typename I> void sort_heap(I first, I last) { sort_heap(first, last, [](const auto &a, const auto &b) { return a < b; }); }
template <typename I, typename C> bool is_heap(I first, I last, C less) {
    ptrdiff_t n = last - first;
    for (ptrdiff_t at = 1; at < n; at++)
        if (less(*(first + (at - 1) / 2), *(first + at))) return false;
    return true;
}
template <typename I> bool is_heap(I first, I last) { return is_heap(first, last, [](const auto &a, const auto &b) { return a < b; }); }

// C++20's ranges, over a range's begin and end (the common ones).
