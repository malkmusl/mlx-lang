// <algorithm>: over pointers as iterators (std::vector's, std::string's,
// arrays): min, max, swap, fill, count, find, reverse, copy, sort
// (insertion sort for short ranges, quicksort above), unique, equal.
#ifndef __MLXCC_ALGORITHM
#define __MLXCC_ALGORITHM
#include <stddef.h>
#include <utility>
#include <initializer_list>
#include <iterator>

namespace std {

template <typename T> constexpr const T &min(const T &a, const T &b) { return b < a ? b : a; }
template <typename T> constexpr const T &max(const T &a, const T &b) { return a < b ? b : a; }

template <typename I, typename T> void fill(I first, I last, const T &value) {
    for (; first != last; ++first) *first = value;
}

template <typename I, typename T> long count(I first, I last, const T &value) {
    long n = 0;
    for (; first != last; ++first)
        if (*first == value) n++;
    return n;
}

template <typename I, typename T> I find(I first, I last, const T &value) {
    for (; first != last; ++first)
        if (*first == value) return first;
    return last;
}

template <typename I> void reverse(I first, I last) {
    while (first != last && first != --last) {
        swap(*first, *last);
        ++first;
    }
}

template <typename I, typename O> O copy(I first, I last, O out) {
    for (; first != last; ++first, ++out) *out = *first;
    return out;
}

template <typename I, typename J> bool equal(I first, I last, J other) {
    for (; first != last; ++first, ++other)
        if (!(*first == *other)) return false;
    return true;
}

template <typename I, typename C> void sort(I first, I last, C less) {
    long n = last - first;
    if (n < 2) return;
    if (n < 16) {
        for (I i = first + 1; i != last; ++i) {
            I j = i;
            while (j != first && less(*i, *(j - 1))) --j;
            if (j != i) {
                I k = i;
                while (k != j) {
                    swap(*k, *(k - 1));
                    --k;
                }
            }
        }
        return;
    }
    I pivot = first + n / 2;
    swap(*pivot, *(last - 1));
    I store = first;
    for (I i = first; i != last - 1; ++i) {
        if (less(*i, *(last - 1))) {
            swap(*i, *store);
            ++store;
        }
    }
    swap(*store, *(last - 1));
    sort(first, store, less);
    sort(store + 1, last, less);
}

template <typename I, typename P> I find_if(I first, I last, P test) {
    for (; first != last; ++first)
        if (test(*first)) return first;
    return last;
}

template <typename I, typename P> long count_if(I first, I last, P test) {
    long n = 0;
    for (; first != last; ++first)
        if (test(*first)) n++;
    return n;
}

template <typename I, typename F> F for_each(I first, I last, F action) {
    for (; first != last; ++first) action(*first);
    return action;
}

template <typename I, typename O, typename F> O transform(I first, I last, O out, F mapping) {
    for (; first != last; ++first, ++out) *out = mapping(*first);
    return out;
}

template <typename I, typename P> I remove_if(I first, I last, P test) {
    I out = first;
    for (; first != last; ++first)
        if (!test(*first)) {
            *out = *first;
            ++out;
        }
    return out;
}

template <typename I> void sort(I first, I last) {
    long n = last - first;
    if (n < 2) return;
    if (n < 16) {
        for (I i = first + 1; i != last; ++i) {
            I j = i;
            while (j != first && *i < *(j - 1)) --j;
            if (j != i) {
                I k = i;
                while (k != j) {
                    swap(*k, *(k - 1));
                    --k;
                }
            }
        }
        return;
    }
    I pivot = first + n / 2;
    swap(*pivot, *(last - 1));
    I store = first;
    for (I i = first; i != last - 1; ++i) {
        if (*i < *(last - 1)) {
            swap(*i, *store);
            ++store;
        }
    }
    swap(*store, *(last - 1));
    sort(first, store);
    sort(store + 1, last);
}

template <typename I> I unique(I first, I last) {
    if (first == last) return last;
    I out = first;
    for (I i = first + 1; i != last; ++i)
        if (!(*i == *out)) {
            ++out;
            *out = *i;
        }
    return out + 1;
}


// Searching sorted ranges, by < or by a comparison.
template <typename I, typename T, typename C> I lower_bound(I first, I last, const T &value, C less) {
    long n = std::distance(first, last);
    while (n > 0) {
        long half = n / 2;
        I middle = first;
        std::advance(middle, half);
        if (less(*middle, value)) { first = ++middle; n -= half + 1; } else n = half;
    }
    return first;
}
template <typename I, typename T> I lower_bound(I first, I last, const T &value) {
    return lower_bound(first, last, value, [](const auto &a, const auto &b) { return a < b; });
}
template <typename I, typename T, typename C> I upper_bound(I first, I last, const T &value, C less) {
    long n = std::distance(first, last);
    while (n > 0) {
        long half = n / 2;
        I middle = first;
        std::advance(middle, half);
        if (!less(value, *middle)) { first = ++middle; n -= half + 1; } else n = half;
    }
    return first;
}
template <typename I, typename T> I upper_bound(I first, I last, const T &value) {
    return upper_bound(first, last, value, [](const auto &a, const auto &b) { return a < b; });
}
template <typename I, typename T, typename C> bool binary_search(I first, I last, const T &value, C less) {
    I at = lower_bound(first, last, value, less);
    return at != last && !less(value, *at);
}
template <typename I, typename T> bool binary_search(I first, I last, const T &value) {
    I at = lower_bound(first, last, value);
    return at != last && !(value < *at);
}
template <typename I, typename T> pair<I, I> equal_range(I first, I last, const T &value) {
    return pair<I, I>(lower_bound(first, last, value), upper_bound(first, last, value));
}
template <typename I, typename C> bool is_sorted(I first, I last, C less) {
    if (first == last) return true;
    for (I next = first + 1; next != last; ++first, ++next)
        if (less(*next, *first)) return false;
    return true;
}
template <typename I> bool is_sorted(I first, I last) {
    return is_sorted(first, last, [](const auto &a, const auto &b) { return a < b; });
}

// Extremes.
template <typename T, typename C> constexpr const T &min(const T &a, const T &b, C less) { return less(b, a) ? b : a; }
template <typename T, typename C> constexpr const T &max(const T &a, const T &b, C less) { return less(a, b) ? b : a; }
template <typename T> constexpr T min(initializer_list<T> list) {
    const T *at = list.begin();
    T best = *at;
    for (++at; at != list.end(); ++at)
        if (*at < best) best = *at;
    return best;
}
template <typename T> constexpr T max(initializer_list<T> list) {
    const T *at = list.begin();
    T best = *at;
    for (++at; at != list.end(); ++at)
        if (best < *at) best = *at;
    return best;
}
template <typename T> constexpr pair<const T &, const T &> minmax(const T &a, const T &b) {
    return b < a ? pair<const T &, const T &>(b, a) : pair<const T &, const T &>(a, b);
}
// (Of a list: the first smallest and the last largest, by value.)
template <typename T> constexpr pair<T, T> minmax(initializer_list<T> list) {
    const T *at = list.begin();
    T low = *at;
    T high = *at;
    for (++at; at != list.end(); ++at) {
        if (*at < low) low = *at;
        if (!(*at < high)) high = *at;
    }
    return pair<T, T>(low, high);
}
template <typename T> constexpr const T &clamp(const T &v, const T &low, const T &high) { return v < low ? low : high < v ? high : v; }
template <typename I, typename C> I min_element(I first, I last, C less) {
    if (first == last) return last;
    I best = first;
    for (++first; first != last; ++first)
        if (less(*first, *best)) best = first;
    return best;
}
template <typename I> I min_element(I first, I last) { return min_element(first, last, [](const auto &a, const auto &b) { return a < b; }); }
template <typename I, typename C> I max_element(I first, I last, C less) {
    if (first == last) return last;
    I best = first;
    for (++first; first != last; ++first)
        if (less(*best, *first)) best = first;
    return best;
}
template <typename I> I max_element(I first, I last) { return max_element(first, last, [](const auto &a, const auto &b) { return a < b; }); }

// Predicates over ranges.
template <typename I, typename P> bool any_of(I first, I last, P test) {
    for (; first != last; ++first)
        if (test(*first)) return true;
    return false;
}
template <typename I, typename P> bool all_of(I first, I last, P test) {
    for (; first != last; ++first)
        if (!test(*first)) return false;
    return true;
}
template <typename I, typename P> bool none_of(I first, I last, P test) { return !any_of(first, last, test); }
template <typename I, typename P> I find_if_not(I first, I last, P test) {
    for (; first != last; ++first)
        if (!test(*first)) return first;
    return last;
}
template <typename I> I adjacent_find(I first, I last) {
    if (first == last) return last;
    for (I next = first + 1; next != last; ++first, ++next)
        if (*first == *next) return first;
    return last;
}
template <typename I, typename J> pair<I, J> mismatch(I first, I last, J other) {
    while (first != last && *first == *other) { ++first; ++other; }
    return pair<I, J>(first, other);
}
template <typename I, typename J> bool lexicographical_compare(I first, I last, J first2, J last2) {
    for (; first != last && first2 != last2; ++first, ++first2) {
        if (*first < *first2) return true;
        if (*first2 < *first) return false;
    }
    return first == last && first2 != last2;
}

// Copies, moves and fills.
template <typename I, typename N, typename O> O copy_n(I first, N n, O out) {
    for (N i = 0; i < n; ++i, ++first, ++out) *out = *first;
    return out;
}
template <typename I, typename O, typename P> O copy_if(I first, I last, O out, P test) {
    for (; first != last; ++first)
        if (test(*first)) { *out = *first; ++out; }
    return out;
}
template <typename I, typename O> O copy_backward(I first, I last, O out) {
    while (first != last) *--out = *--last;
    return out;
}
template <typename I, typename O> O move(I first, I last, O out) {
    for (; first != last; ++first, ++out) *out = std::move(*first);
    return out;
}
template <typename I, typename O> O move_backward(I first, I last, O out) {
    while (first != last) *--out = std::move(*--last);
    return out;
}
template <typename O, typename N, typename T> O fill_n(O out, N n, const T &value) {
    for (N i = 0; i < n; ++i, ++out) *out = value;
    return out;
}
template <typename I, typename G> void generate(I first, I last, G make) {
    for (; first != last; ++first) *first = make();
}
template <typename I, typename T> void replace(I first, I last, const T &old, const T &value) {
    for (; first != last; ++first)
        if (*first == old) *first = value;
}
template <typename I, typename T> I remove(I first, I last, const T &value) {
    I out = first;
    for (; first != last; ++first)
        if (!(*first == value)) { *out = std::move(*first); ++out; }
    return out;
}
template <typename I> void iter_swap(I a, I b) { swap(*a, *b); }
template <typename I> I rotate(I first, I middle, I last) {
    if (first == middle) return last;
    if (middle == last) return first;
    reverse(first, middle);
    reverse(middle, last);
    reverse(first, last);
    return first + (last - middle);
}
template <typename I, typename C> void stable_sort(I first, I last, C less) {
    for (I i = first; i != last; ++i)
        for (I j = i; j != first && less(*j, *(j - 1)); --j) swap(*j, *(j - 1));
}
template <typename I> void stable_sort(I first, I last) { stable_sort(first, last, [](const auto &a, const auto &b) { return a < b; }); }

// The rest of the standard's algorithms over iterators: comparisons of
// two ranges, searches, partitions, the sorted ranges' set operations,
// permutations.
template <typename I, typename J, typename P> bool equal(I first, I last, J other, P same) {
    for (; first != last; ++first, ++other)
        if (!same(*first, *other)) return false;
    return true;
}
template <typename I, typename J> bool equal(I first, I last, J first2, J last2) {
    for (; first != last && first2 != last2; ++first, ++first2)
        if (!(*first == *first2)) return false;
    return first == last && first2 == last2;
}
template <typename I, typename J, typename P> bool equal(I first, I last, J first2, J last2, P same) {
    for (; first != last && first2 != last2; ++first, ++first2)
        if (!same(*first, *first2)) return false;
    return first == last && first2 == last2;
}
template <typename I, typename J, typename P> pair<I, J> mismatch(I first, I last, J other, P same) {
    while (first != last && same(*first, *other)) { ++first; ++other; }
    return pair<I, J>(first, other);
}
template <typename I, typename J> pair<I, J> mismatch(I first, I last, J first2, J last2) {
    while (first != last && first2 != last2 && *first == *first2) { ++first; ++first2; }
    return pair<I, J>(first, first2);
}
template <typename I, typename J, typename C> bool lexicographical_compare(I first, I last, J first2, J last2, C less) {
    for (; first != last && first2 != last2; ++first, ++first2) {
        if (less(*first, *first2)) return true;
        if (less(*first2, *first)) return false;
    }
    return first == last && first2 != last2;
}
template <typename I, typename P> I adjacent_find(I first, I last, P same) {
    if (first == last) return last;
    I next = first;
    for (++next; next != last; ++first, ++next)
        if (same(*first, *next)) return first;
    return last;
}
template <typename I, typename J, typename P> I search(I first, I last, J first2, J last2, P same) {
    for (;; ++first) {
        I at = first;
        J other = first2;
        for (;; ++at, ++other) {
            if (other == last2) return first;
            if (at == last) return last;
            if (!same(*at, *other)) break;
        }
    }
}
template <typename I, typename J> I search(I first, I last, J first2, J last2) {
    return search(first, last, first2, last2, [](const auto &a, const auto &b) { return a == b; });
}
template <typename I, typename N, typename T> I search_n(I first, I last, N count, const T &value) {
    if (count <= 0) return first;
    for (; first != last; ++first) {
        if (!(*first == value)) continue;
        I start = first;
        N n = 1;
        while (n < count) {
            ++first;
            if (first == last) return last;
            if (!(*first == value)) break;
            ++n;
        }
        if (n == count) return start;
    }
    return last;
}
template <typename I, typename J, typename P> I find_end(I first, I last, J first2, J last2, P same) {
    if (first2 == last2) return last;
    I found = last;
    while (true) {
        I at = search(first, last, first2, last2, same);
        if (at == last) return found;
        found = at;
        first = at;
        ++first;
    }
}
template <typename I, typename J> I find_end(I first, I last, J first2, J last2) {
    return find_end(first, last, first2, last2, [](const auto &a, const auto &b) { return a == b; });
}
template <typename I, typename J, typename P> I find_first_of(I first, I last, J first2, J last2, P same) {
    for (; first != last; ++first)
        for (J at = first2; at != last2; ++at)
            if (same(*first, *at)) return first;
    return last;
}
template <typename I, typename J> I find_first_of(I first, I last, J first2, J last2) {
    return find_first_of(first, last, first2, last2, [](const auto &a, const auto &b) { return a == b; });
}
template <typename I, typename J, typename O, typename F> O transform(I first, I last, J first2, O out, F mapping) {
    for (; first != last; ++first, ++first2, ++out) *out = mapping(*first, *first2);
    return out;
}
template <typename I, typename P, typename T> void replace_if(I first, I last, P test, const T &value) {
    for (; first != last; ++first)
        if (test(*first)) *first = value;
}
template <typename I, typename O, typename T> O replace_copy(I first, I last, O out, const T &old, const T &value) {
    for (; first != last; ++first, ++out) *out = *first == old ? value : *first;
    return out;
}
template <typename I, typename O, typename T> O remove_copy(I first, I last, O out, const T &value) {
    for (; first != last; ++first)
        if (!(*first == value)) { *out = *first; ++out; }
    return out;
}
template <typename I, typename O, typename P> O remove_copy_if(I first, I last, O out, P test) {
    for (; first != last; ++first)
        if (!test(*first)) { *out = *first; ++out; }
    return out;
}
template <typename I, typename P> I unique(I first, I last, P same) {
    if (first == last) return last;
    I out = first;
    for (++first; first != last; ++first)
        if (!same(*out, *first)) *++out = std::move(*first);
    return ++out;
}
template <typename I, typename O> O unique_copy(I first, I last, O out) {
    if (first == last) return out;
    auto held = *first;
    *out = held;
    ++out;
    for (++first; first != last; ++first)
        if (!(held == *first)) { held = *first; *out = held; ++out; }
    return out;
}
template <typename I, typename O> O reverse_copy(I first, I last, O out) {
    while (first != last) { --last; *out = *last; ++out; }
    return out;
}
template <typename I, typename O> O rotate_copy(I first, I middle, I last, O out) {
    out = copy(middle, last, out);
    return copy(first, middle, out);
}
template <typename I, typename J> J swap_ranges(I first, I last, J other) {
    for (; first != last; ++first, ++other) swap(*first, *other);
    return other;
}
template <typename O, typename N, typename G> O generate_n(O out, N n, G make) {
    for (N i = 0; i < n; ++i, ++out) *out = make();
    return out;
}
template <typename I, typename N, typename F> I for_each_n(I first, N n, F action) {
    for (N i = 0; i < n; ++i, ++first) action(*first);
    return first;
}
template <typename I, typename P> bool is_partitioned(I first, I last, P test) {
    for (; first != last && test(*first); ++first) {}
    for (; first != last; ++first)
        if (test(*first)) return false;
    return true;
}
template <typename I, typename P> I partition(I first, I last, P test) {
    I out = first;
    for (; first != last; ++first) {
        if (test(*first)) {
            if (out != first) swap(*out, *first);
            ++out;
        }
    }
    return out;
}
template <typename I, typename P> I stable_partition(I first, I last, P test) {
    // (Insertion: each element passing moves before the failing ones.)
    I out = first;
    for (I at = first; at != last; ++at) {
        if (test(*at)) {
            for (I j = at; j != out; --j) swap(*j, *(j - 1));
            ++out;
        }
    }
    return out;
}
template <typename I, typename P> I partition_point(I first, I last, P test) {
    for (; first != last; ++first)
        if (!test(*first)) return first;
    return last;
}
template <typename I, typename C> void partial_sort(I first, I middle, I last, C less) {
    sort(first, last, less);
    (void)middle;
}
template <typename I> void partial_sort(I first, I middle, I last) { sort(first, last); (void)middle; }
template <typename I, typename C> void nth_element(I first, I nth, I last, C less) {
    sort(first, last, less);
    (void)nth;
}
template <typename I> void nth_element(I first, I nth, I last) { sort(first, last); (void)nth; }
template <typename I, typename C> I is_sorted_until(I first, I last, C less) {
    if (first == last) return last;
    I next = first;
    for (++next; next != last; ++first, ++next)
        if (less(*next, *first)) return next;
    return last;
}
template <typename I> I is_sorted_until(I first, I last) {
    return is_sorted_until(first, last, [](const auto &a, const auto &b) { return a < b; });
}
template <typename I, typename T, typename C> pair<I, I> equal_range(I first, I last, const T &value, C less) {
    return pair<I, I>(lower_bound(first, last, value, less), upper_bound(first, last, value, less));
}
template <typename I, typename C> pair<I, I> minmax_element(I first, I last, C less) {
    return pair<I, I>(min_element(first, last, less), max_element(first, last, less));
}
template <typename I> pair<I, I> minmax_element(I first, I last) { return pair<I, I>(min_element(first, last), max_element(first, last)); }
template <typename T, typename C> constexpr T min(initializer_list<T> list, C less) {
    const T *at = list.begin();
    T best = *at;
    for (++at; at != list.end(); ++at)
        if (less(*at, best)) best = *at;
    return best;
}
template <typename T, typename C> constexpr T max(initializer_list<T> list, C less) {
    const T *at = list.begin();
    T best = *at;
    for (++at; at != list.end(); ++at)
        if (less(best, *at)) best = *at;
    return best;
}
template <typename T, typename C> constexpr const T &clamp(const T &v, const T &low, const T &high, C less) { return less(v, low) ? low : less(high, v) ? high : v; }
template <typename I, typename J, typename O, typename C> O merge(I first, I last, J first2, J last2, O out, C less) {
    while (first != last && first2 != last2) {
        if (less(*first2, *first)) { *out = *first2; ++first2; } else { *out = *first; ++first; }
        ++out;
    }
    out = copy(first, last, out);
    return copy(first2, last2, out);
}
template <typename I, typename J, typename O> O merge(I first, I last, J first2, J last2, O out) {
    return merge(first, last, first2, last2, out, [](const auto &a, const auto &b) { return a < b; });
}
template <typename I, typename C> void inplace_merge(I first, I middle, I last, C less) {
    (void)middle;
    stable_sort(first, last, less);
}
template <typename I> void inplace_merge(I first, I middle, I last) { (void)middle; stable_sort(first, last); }
template <typename I, typename J, typename C> bool includes(I first, I last, J first2, J last2, C less) {
    for (; first2 != last2; ++first) {
        if (first == last || less(*first2, *first)) return false;
        if (!less(*first, *first2)) ++first2;
    }
    return true;
}
template <typename I, typename J> bool includes(I first, I last, J first2, J last2) {
    return includes(first, last, first2, last2, [](const auto &a, const auto &b) { return a < b; });
}
template <typename I, typename J, typename O, typename C> O set_union(I first, I last, J first2, J last2, O out, C less) {
    for (; first != last; ++out) {
        if (first2 == last2) return copy(first, last, out);
        if (less(*first2, *first)) { *out = *first2; ++first2; }
        else {
