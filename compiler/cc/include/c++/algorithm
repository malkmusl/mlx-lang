// (With a comparison and a projection: the first element whose
// projection is not less than the value.)
template <typename I, typename T, typename C, typename P> I lower_bound(I first, I last, const T &value, C comp, P proj) {
    auto count = std::distance(first, last);
    while (count > 0) {
        auto step = count / 2;
        I mid = first;
        std::advance(mid, step);
        if (comp(__project(proj, *mid), value)) {
            first = ++mid;
            count -= step + 1;
        } else
            count = step;
    }
    return first;
}
