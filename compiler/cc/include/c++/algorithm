template <typename I, typename C> bool next_permutation(I first, I last, C less) {
    if (first == last) return false;
    I i = last;
    if (first == --i) return false;
    while (true) {
        I after = i;
        if (less(*--i, *after)) {
            I j = last;
            while (!less(*i, *--j)) {}
            swap(*i, *j);
            reverse(after, last);
            return true;
        }
        if (i == first) {
            reverse(first, last);
            return false;
        }
    }
}
template <typename I> bool next_permutation(I first, I last) {
    return next_permutation(first, last, [](const auto &a, const auto &b) { return a < b; });
}
template <typename I, typename C> bool prev_permutation(I first, I last, C less) {
    return next_permutation(first, last, [&](const auto &a, const auto &b) { return less(b, a); });
}
template <typename I> bool prev_permutation(I first, I last) {
    return next_permutation(first, last, [](const auto &a, const auto &b) { return b < a; });
}
template <typename I, typename J> bool is_permutation(I first, I last, J first2) {
    for (I at = first; at != last; ++at) {
