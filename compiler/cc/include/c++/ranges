// <ranges>: the range concepts over begin() and end(), range_value_t
// and the other aliases, the whole-range algorithms, and two views:
// views::transform and views::reverse (over a range kept by its
// address; called or piped: `r | views::reverse`).
#ifndef __MLXCC_RANGES
#define __MLXCC_RANGES
#include <iterator>
#include <concepts>

namespace std {
namespace ranges {

template <class R> concept range = requires(R &r) { begin(r); end(r); };
template <class R> concept input_range = range<R>;
template <class R> concept forward_range = range<R>;
template <class R> concept bidirectional_range = range<R>;
template <class R> concept random_access_range = range<R>;
template <class R> concept contiguous_range = range<R> && requires(R &r) { data(r); };
template <class R> concept sized_range = range<R> && requires(R &r) { size(r); };
template <class R> concept borrowed_range = range<R>;
template <class R> concept view = range<R>;
template <class R> using iterator_t = decltype(begin(declval<R &>()));
template <class R> using sentinel_t = decltype(end(declval<R &>()));
template <class R> using range_value_t = typename iterator_traits<iterator_t<R> >::value_type;
template <class R> using range_reference_t = decltype(*begin(declval<R &>()));
template <class R> using range_difference_t = typename iterator_traits<iterator_t<R> >::difference_type;
template <class R> using range_size_t = decltype(size(declval<R &>()));

using std::begin;
using std::end;
using std::size;
using std::data;
using std::empty;
// (Of two iterators, and of a range below: one name.)
template <class I> constexpr auto distance(I first, I last) { return std::distance(first, last); }
template <class R, class = decltype(begin(declval<R &>()))> constexpr auto distance(R &&r) { return std::distance(begin(r), end(r)); }

// The algorithms over a whole range (the iterator pairs are <algorithm>'s).
template <class R, class T> constexpr long count(R &&r, const T &value) {
    long n = 0;
    for (auto it = begin(r); it != end(r); ++it) if (*it == value) ++n;
    return n;
}
template <class R, class P> constexpr long count_if(R &&r, P pred) {
    long n = 0;
    for (auto it = begin(r); it != end(r); ++it) if (pred(*it)) ++n;
    return n;
}
template <class R, class T> constexpr auto find(R &&r, const T &value) {
    auto it = begin(r);
    for (; it != end(r); ++it) if (*it == value) break;
    return it;
}
template <class R, class P> constexpr auto find_if(R &&r, P pred) {
    auto it = begin(r);
    for (; it != end(r); ++it) if (pred(*it)) break;
    return it;
}
template <class R, class P> constexpr bool all_of(R &&r, P pred) {
    for (auto it = begin(r); it != end(r); ++it) if (!pred(*it)) return false;
    return true;
}
template <class R, class P> constexpr bool any_of(R &&r, P pred) {
    for (auto it = begin(r); it != end(r); ++it) if (pred(*it)) return true;
    return false;
}
template <class R, class P> constexpr bool none_of(R &&r, P pred) { return !any_of(r, pred); }
template <class R, class F> constexpr F for_each(R &&r, F f) {
    for (auto it = begin(r); it != end(r); ++it) f(*it);
    return f;
}
template <class R1, class R2> constexpr bool equal(R1 &&a, R2 &&b) {
    auto i = begin(a);
    auto j = begin(b);
    for (; i != end(a) && j != end(b); ++i, ++j) if (!(*i == *j)) return false;
    return i == end(a) && j == end(b);
}
template <class R, class Out> constexpr Out copy(R &&r, Out out) {
    for (auto it = begin(r); it != end(r); ++it) { *out = *it; ++out; }
    return out;
}
template <class R, class T> constexpr void fill(R &&r, const T &value) {
    for (auto it = begin(r); it != end(r); ++it) *it = value;
}
template <class R> constexpr void reverse(R &&r) {
    auto first = begin(r);
    auto last = end(r);
    while (first != last && first != --last) { auto t = *first; *first = *last; *last = t; ++first; }
}
template <class R> constexpr auto max_element(R &&r) {
    auto best = begin(r);
    for (auto it = begin(r); it != end(r); ++it) if (*best < *it) best = it;
    return best;
}
template <class R> constexpr auto min_element(R &&r) {
    auto best = begin(r);
    for (auto it = begin(r); it != end(r); ++it) if (*it < *best) best = it;
    return best;
}
template <class T> constexpr const T &min(const T &a, const T &b) { return b < a ? b : a; }
template <class T> constexpr const T &max(const T &a, const T &b) { return a < b ? b : a; }

}
}

namespace std {
namespace ranges {

template <class R, class F> class transform_view {
public:
    typedef decltype(begin(declval<R &>())) base_iterator;
    class iterator {
    public:
        iterator(base_iterator at, const F *f) : _at(at), _f(f) {}
        decltype(auto) operator*() const { return (*_f)(*_at); }
        iterator &operator++() { ++_at; return *this; }
        iterator operator++(int) { iterator before = *this; ++_at; return before; }
        bool operator==(const iterator &other) const { return _at == other._at; }
        bool operator!=(const iterator &other) const { return _at != other._at; }
    private:
        base_iterator _at;
        const F *_f;
    };
    transform_view(R &range, F f) : _range(&range), _f(f) {}
    iterator begin() const { return iterator(std::begin(*_range), &_f); }
    iterator end() const { return iterator(std::end(*_range), &_f); }
    size_t size() const { return (size_t)(std::end(*_range) - std::begin(*_range)); }
private:
    R *_range;
    F _f;
};

// The values from one to before another (`std::views::iota(first,
// last)`, WebCore's RenderGrid.cpp).
template <class W> class iota_view {
public:
    class iterator {
    public:
        explicit iterator(W value) : _value(value) {}
        W operator*() const { return _value; }
        iterator &operator++() { ++_value; return *this; }
        iterator operator++(int) { iterator before = *this; ++_value; return before; }
        bool operator==(const iterator &other) const { return _value == other._value; }
        bool operator!=(const iterator &other) const { return _value != other._value; }
    private:
        W _value;
    };
    iota_view(W first, W last) : _first(first), _last(last) {}
    iterator begin() const { return iterator(_first); }
    iterator end() const { return iterator(_last); }
    size_t size() const { return (size_t)(_last - _first); }
    bool empty() const { return _first == _last; }
private:
    W _first;
    W _last;
};

template <class R> class reverse_view {
public:
    typedef decltype(begin(declval<R &>())) base_iterator;
    class iterator {
    public:
        explicit iterator(base_iterator at) : _at(at) {}
        decltype(auto) operator*() const { base_iterator before = _at; --before; return *before; }
        iterator &operator++() { --_at; return *this; }
        iterator operator++(int) { iterator before = *this; --_at; return before; }
        bool operator==(const iterator &other) const { return _at == other._at; }
        bool operator!=(const iterator &other) const { return _at != other._at; }
    private:
        base_iterator _at;
    };
    explicit reverse_view(R &range) : _range(&range) {}
    iterator begin() const { return iterator(std::end(*_range)); }
    iterator end() const { return iterator(std::begin(*_range)); }
    size_t size() const { return (size_t)(std::end(*_range) - std::begin(*_range)); }
private:
    R *_range;
};

// The same over a range given as a temporary (`list.usedValues() |
// views::reverse` of a std::span returned, WebCore's StyleFillLayers.h):
// kept whole in the view.
template <class R> class __owning_reverse_view {
public:
    typedef typename reverse_view<R>::iterator iterator;
    explicit __owning_reverse_view(R &&range) : _range(static_cast<R &&>(range)) {}
    iterator begin() const { return iterator(std::end(const_cast<R &>(_range))); }
    iterator end() const { return iterator(std::begin(const_cast<R &>(_range))); }
    size_t size() const { return (size_t)(std::end(_range) - std::begin(_range)); }
private:
    R _range;
};

}

namespace views {

struct __iota_fn {
    template <class W, class B> ranges::iota_view<W> operator()(W first, B last) const { return ranges::iota_view<W>(first, (W)last); }
};
inline constexpr __iota_fn iota{};

struct __reverse_fn {
    template <class R> ranges::reverse_view<R> operator()(R &range) const { return ranges::reverse_view<R>(range); }
    template <class R> requires (!is_lvalue_reference<R>::value) ranges::__owning_reverse_view<R> operator()(R &&range) const { return ranges::__owning_reverse_view<R>(static_cast<R &&>(range)); }
};
inline constexpr __reverse_fn reverse{};
template <class R> ranges::reverse_view<R> operator|(R &range, const __reverse_fn &) { return ranges::reverse_view<R>(range); }
template <class R> requires (!is_lvalue_reference<R>::value) ranges::__owning_reverse_view<R> operator|(R &&range, const __reverse_fn &) { return ranges::__owning_reverse_view<R>(static_cast<R &&>(range)); }

template <class F> struct __transform_closure {
    F f;
};
struct __transform_fn {
    template <class F> __transform_closure<F> operator()(F f) const { return __transform_closure<F>{f}; }
    template <class R, class F> ranges::transform_view<R, F> operator()(R &range, F f) const { return ranges::transform_view<R, F>(range, f); }
};
inline constexpr __transform_fn transform{};
template <class R, class F> ranges::transform_view<R, F> operator|(R &range, const __transform_closure<F> &closure) { return ranges::transform_view<R, F>(range, closure.f); }

}

}
#endif
