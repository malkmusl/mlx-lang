// <optional>: std::optional (a value in place or none), nullopt,
// make_optional.
#ifndef __MLXCC_OPTIONAL
#define __MLXCC_OPTIONAL
#include <new>
#include <utility>
#include <type_traits>

namespace std {

struct nullopt_t { explicit constexpr nullopt_t(int) {} };
constexpr nullopt_t nullopt = nullopt_t(0);

// The value lives in a union with nothing (`_empty`), so that an optional
// made in a constant expression can be read there (`static constexpr
// std::optional<JSTypeRange> typeRange { ... }` and `typeRange->last` in
// a static_assert, WebCore's JSNodeCustom.h).
template <class T> class optional {
public:
    typedef T value_type;
    constexpr optional() noexcept : _empty(), _present(false) {}
    constexpr optional(nullopt_t) noexcept : _empty(), _present(false) {}
    constexpr optional(const T &value) : _value(value), _present(true) {}
    constexpr optional(T &&value) : _value(move(value)), _present(true) {}
    template <class... Args> constexpr explicit optional(in_place_t, Args &&... args) : _value(forward<Args>(args)...), _present(true) {}
    // (A copy in a constant expression too: `constexpr auto info =
    // Model::componentInfo[i];` of a class holding an optional.)
    constexpr optional(const optional &other) : _empty(), _present(other._present) { if (_present) new (&_value) T(other._value); }
    optional(optional &&other) : _empty(), _present(other._present) { if (_present) new (storage()) T(move(*other.storage())); }
    template <class U> optional(const optional<U> &other) : _empty(), _present(other.has_value()) { if (_present) new (storage()) T(*other); }
    // A value T is made from (`optional<uint64_t>` from a Checked<uint64_t>).
    template <class U, class = typename enable_if<!is_same<typename decay<U>::type, optional>::value && !is_same<typename decay<U>::type, T>::value && !is_same<typename decay<U>::type, in_place_t>::value && !is_same<typename decay<U>::type, nullopt_t>::value && is_constructible<T, U &&>::value>::type> optional(U &&value) : _empty(), _present(true) { new (storage()) T(forward<U>(value)); }
    ~optional() { reset(); }
    optional &operator=(nullopt_t) noexcept { reset(); return *this; }
    optional &operator=(const optional &other) {
        if (this != &other) {
            if (_present && other._present) *storage() = *other.storage();
            else { reset(); if (other._present) { new (storage()) T(*other.storage()); _present = true; } }
        }
        return *this;
    }
    optional &operator=(optional &&other) {
        if (this != &other) {
            if (_present && other._present) *storage() = move(*other.storage());
            else { reset(); if (other._present) { new (storage()) T(move(*other.storage())); _present = true; } }
        }
        return *this;
    }
    template <class U> optional &operator=(U &&value) {
        if (_present) *storage() = forward<U>(value);
        else { new (storage()) T(forward<U>(value)); _present = true; }
        return *this;
    }
    template <class... Args> T &emplace(Args &&... args) {
        reset();
        new (storage()) T(forward<Args>(args)...);
        _present = true;
        return *storage();
    }
    void reset() noexcept { if (_present) { storage()->~T(); _present = false; } }
    void swap(optional &other) {
        if (_present && other._present) std::swap(*storage(), *other.storage());
        else if (_present) { other.emplace(move(*storage())); reset(); }
        else if (other._present) { emplace(move(*other.storage())); other.reset(); }
    }
    constexpr bool has_value() const noexcept { return _present; }
    constexpr explicit operator bool() const noexcept { return _present; }
    constexpr T &value() & { return _value; }
    constexpr const T &value() const & { return _value; }
    T &&value() && { return move(*storage()); }
    constexpr T &operator*() & { return _value; }
    constexpr const T &operator*() const & { return _value; }
    T &&operator*() && { return move(*storage()); }
    constexpr T *operator->() { return &_value; }
    constexpr const T *operator->() const { return &_value; }
    template <class U> T value_or(U &&fallback) const & { return _present ? *storage() : T(forward<U>(fallback)); }
    template <class U> T value_or(U &&fallback) && { return _present ? move(*storage()) : T(forward<U>(fallback)); }
    // C++23's: the function's result on the value (an optional of it for
    // transform), else none; or_else's, without one.
    template <class F> constexpr auto transform(F &&f) & { return __transform<T &>(*this, forward<F>(f)); }
    template <class F> constexpr auto transform(F &&f) const & { return __transform<const T &>(*this, forward<F>(f)); }
    template <class F> constexpr auto transform(F &&f) && { return __transform<T &&>(*this, forward<F>(f)); }
    template <class F> constexpr auto and_then(F &&f) & { return __and_then<T &>(*this, forward<F>(f)); }
    template <class F> constexpr auto and_then(F &&f) const & { return __and_then<const T &>(*this, forward<F>(f)); }
    template <class F> constexpr auto and_then(F &&f) && { return __and_then<T &&>(*this, forward<F>(f)); }
    template <class F> constexpr optional or_else(F &&f) const & { if (_present) return *this; return forward<F>(f)(); }
    template <class F> constexpr optional or_else(F &&f) && { if (_present) return move(*this); return forward<F>(f)(); }
private:
    template <class V, class O, class F> static constexpr auto __transform(O &self, F &&f) {
        typedef typename remove_cv<typename remove_reference<decltype(forward<F>(f)(static_cast<V>(self._value)))>::type>::type U;
        if (self._present) return optional<U>(forward<F>(f)(static_cast<V>(self._value)));
        return optional<U>();
    }
    template <class V, class O, class F> static constexpr auto __and_then(O &self, F &&f) {
        typedef typename remove_cv<typename remove_reference<decltype(forward<F>(f)(static_cast<V>(self._value)))>::type>::type R;
        if (self._present) return R(forward<F>(f)(static_cast<V>(self._value)));
        return R();
    }
    T *storage() { return &_value; }
    const T *storage() const { return &_value; }
    union {
        char _empty;
        T _value;
    };
    bool _present;
};

template <class T> bool operator==(const optional<T> &a, const optional<T> &b) {
    if (a.has_value() != b.has_value()) return false;
    return !a.has_value() || *a == *b;
}
template <class T> bool operator!=(const optional<T> &a, const optional<T> &b) { return !(a == b); }
template <class T> bool operator==(const optional<T> &a, nullopt_t) noexcept { return !a.has_value(); }
template <class T> bool operator==(nullopt_t, const optional<T> &a) noexcept { return !a.has_value(); }
template <class T> bool operator!=(const optional<T> &a, nullopt_t) noexcept { return a.has_value(); }
template <class T> bool operator!=(nullopt_t, const optional<T> &a) noexcept { return a.has_value(); }
template <class T, class U> bool operator==(const optional<T> &a, const U &b) { return a.has_value() && *a == b; }
template <class T, class U> bool operator!=(const optional<T> &a, const U &b) { return !a.has_value() || !(*a == b); }
// The ordering: an empty optional before any value.
template <class T> struct __is_optional_type : false_type {};
template <class T> struct __is_optional_type<optional<T> > : true_type {};
template <class T, class U> bool operator<(const optional<T> &a, const optional<U> &b) { return b.has_value() && (!a.has_value() || *a < *b); }
template <class T, class U> bool operator>(const optional<T> &a, const optional<U> &b) { return b < a; }
template <class T, class U> bool operator<=(const optional<T> &a, const optional<U> &b) { return !(b < a); }
template <class T, class U> bool operator>=(const optional<T> &a, const optional<U> &b) { return !(a < b); }
template <class T, class U> requires (!__is_optional_type<U>::value) bool operator<(const optional<T> &a, const U &b) { return !a.has_value() || *a < b; }
template <class T, class U> requires (!__is_optional_type<U>::value) bool operator>(const optional<T> &a, const U &b) { return a.has_value() && b < *a; }
template <class T, class U> requires (!__is_optional_type<U>::value) bool operator<=(const optional<T> &a, const U &b) { return !a.has_value() || !(b < *a); }
template <class T, class U> requires (!__is_optional_type<U>::value) bool operator>=(const optional<T> &a, const U &b) { return a.has_value() && !(*a < b); }
template <class T, class U> requires (!__is_optional_type<T>::value) bool operator<(const T &a, const optional<U> &b) { return b.has_value() && a < *b; }
template <class T, class U> requires (!__is_optional_type<T>::value) bool operator>(const T &a, const optional<U> &b) { return !b.has_value() || *b < a; }
template <class T, class U> requires (!__is_optional_type<T>::value) bool operator<=(const T &a, const optional<U> &b) { return b.has_value() && !(*b < a); }
template <class T, class U> requires (!__is_optional_type<T>::value) bool operator>=(const T &a, const optional<U> &b) { return !b.has_value() || !(a < *b); }
template <class T, class U> requires (!__is_optional_type<T>::value) bool operator==(const T &a, const optional<U> &b) { return b.has_value() && a == *b; }
template <class T, class U> requires (!__is_optional_type<T>::value) bool operator!=(const T &a, const optional<U> &b) { return !b.has_value() || !(a == *b); }

template <class T> optional<typename decay<T>::type> make_optional(T &&value) { return optional<typename decay<T>::type>(forward<T>(value)); }
template <class T, class... Args> optional<T> make_optional(Args &&... args) { return optional<T>(in_place, forward<Args>(args)...); }


template <class T> optional(T) -> optional<T>;
}
#endif
