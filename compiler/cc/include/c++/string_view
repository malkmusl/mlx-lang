// <string_view>: std::char_traits (of every character type) and
// std::basic_string_view, a pointer and a length over characters owned
// elsewhere, with string_view, u8string_view, u16string_view,
// u32string_view and wstring_view, and the ""sv literals.
#ifndef __MLXCC_STRING_VIEW
#define __MLXCC_STRING_VIEW
#include <stddef.h>

namespace std {

template <class C> struct char_traits {
    typedef C char_type;
    typedef int int_type;
    static constexpr void assign(C &to, const C &from) noexcept { to = from; }
    static constexpr bool eq(C a, C b) noexcept { return a == b; }
    static constexpr bool lt(C a, C b) noexcept { return a < b; }
    static constexpr size_t length(const C *s) {
        size_t n = 0;
        while (!(s[n] == C()))
            ++n;
        return n;
    }
    static constexpr int compare(const C *a, const C *b, size_t n) {
        for (size_t i = 0; i < n; ++i) {
            if (a[i] < b[i]) return -1;
            if (b[i] < a[i]) return 1;
        }
        return 0;
    }
    static constexpr const C *find(const C *s, size_t n, const C &c) {
        for (size_t i = 0; i < n; ++i)
            if (s[i] == c) return s + i;
        return nullptr;
    }
    static constexpr C *copy(C *to, const C *from, size_t n) {
        for (size_t i = 0; i < n; ++i) to[i] = from[i];
        return to;
    }
    static constexpr C *move(C *to, const C *from, size_t n) {
        if (to < from) {
            for (size_t i = 0; i < n; ++i) to[i] = from[i];
        } else {
            for (size_t i = n; i > 0; --i) to[i - 1] = from[i - 1];
        }
        return to;
    }
    static constexpr C *assign(C *to, size_t n, C c) {
        for (size_t i = 0; i < n; ++i) to[i] = c;
        return to;
    }
    static constexpr int_type eof() noexcept { return -1; }
    static constexpr int_type not_eof(int_type i) noexcept { return i == -1 ? 0 : i; }
    static constexpr C to_char_type(int_type i) noexcept { return (C)i; }
    static constexpr int_type to_int_type(C c) noexcept { return sizeof(C) == 1 ? (int_type)(unsigned char)c : (int_type)c; }
    static constexpr bool eq_int_type(int_type a, int_type b) noexcept { return a == b; }
};

template <class C, class Traits = char_traits<C> > class basic_string_view {
public:
    typedef Traits traits_type;
    typedef C value_type;
    typedef const C *pointer;
    typedef const C *const_pointer;
    typedef const C &reference;
    typedef const C &const_reference;
    typedef const C *iterator;
    typedef const C *const_iterator;
    typedef size_t size_type;
    typedef long difference_type;
    static constexpr size_t npos = (size_t)-1;

    constexpr basic_string_view() noexcept : _data(nullptr), _size(0) {}
    constexpr basic_string_view(const C *s) : _data(s), _size(Traits::length(s)) {}
    constexpr basic_string_view(const C *s, size_t n) : _data(s), _size(n) {}
    constexpr basic_string_view(const C *first, const C *last) : _data(first), _size(last - first) {}
    basic_string_view(decltype(nullptr)) = delete;

    constexpr const C *begin() const noexcept { return _data; }
    constexpr const C *end() const noexcept { return _data + _size; }
    constexpr const C *cbegin() const noexcept { return _data; }
    constexpr const C *cend() const noexcept { return _data + _size; }
    constexpr size_t size() const noexcept { return _size; }
    constexpr size_t length() const noexcept { return _size; }
    constexpr size_t max_size() const noexcept { return npos / sizeof(C); }
    constexpr bool empty() const noexcept { return _size == 0; }
    constexpr const C &operator[](size_t i) const { return _data[i]; }
    constexpr const C &at(size_t i) const { return _data[i]; }
    constexpr const C &front() const { return _data[0]; }
    constexpr const C &back() const { return _data[_size - 1]; }
    constexpr const C *data() const noexcept { return _data; }

    constexpr void remove_prefix(size_t n) { _data += n; _size -= n; }
    constexpr void remove_suffix(size_t n) { _size -= n; }
    constexpr void swap(basic_string_view &other) noexcept {
        const C *d = _data; _data = other._data; other._data = d;
        size_t s = _size; _size = other._size; other._size = s;
    }
    size_t copy(C *to, size_t n, size_t from = 0) const {
        size_t count = n < _size - from ? n : _size - from;
        Traits::copy(to, _data + from, count);
        return count;
    }
    constexpr basic_string_view substr(size_t from = 0, size_t n = npos) const {
        size_t count = n < _size - from ? n : _size - from;
        return basic_string_view(_data + from, count);
    }
    constexpr int compare(basic_string_view other) const noexcept {
        size_t n = _size < other._size ? _size : other._size;
        int r = Traits::compare(_data, other._data, n);
        if (r != 0) return r;
        return _size < other._size ? -1 : _size > other._size ? 1 : 0;
    }
    constexpr int compare(size_t from, size_t n, basic_string_view other) const { return substr(from, n).compare(other); }
    constexpr int compare(const C *s) const { return compare(basic_string_view(s)); }
    constexpr bool starts_with(basic_string_view prefix) const noexcept { return _size >= prefix._size && Traits::compare(_data, prefix._data, prefix._size) == 0; }
    constexpr bool starts_with(C c) const noexcept { return _size > 0 && _data[0] == c; }
    constexpr bool starts_with(const C *s) const { return starts_with(basic_string_view(s)); }
    constexpr bool ends_with(basic_string_view suffix) const noexcept { return _size >= suffix._size && Traits::compare(_data + _size - suffix._size, suffix._data, suffix._size) == 0; }
    constexpr bool ends_with(C c) const noexcept { return _size > 0 && _data[_size - 1] == c; }
    constexpr bool ends_with(const C *s) const { return ends_with(basic_string_view(s)); }
    constexpr bool contains(basic_string_view s) const noexcept { return find(s) != npos; }
    constexpr bool contains(C c) const noexcept { return find(c) != npos; }
    constexpr bool contains(const C *s) const { return find(s) != npos; }

    constexpr size_t find(basic_string_view s, size_t from = 0) const noexcept {
        if (s._size > _size) return npos;
        for (size_t i = from; i + s._size <= _size; ++i)
            if (Traits::compare(_data + i, s._data, s._size) == 0) return i;
        return npos;
    }
    constexpr size_t find(C c, size_t from = 0) const noexcept {
        for (size_t i = from; i < _size; ++i)
            if (_data[i] == c) return i;
        return npos;
    }
    constexpr size_t find(const C *s, size_t from = 0) const { return find(basic_string_view(s), from); }
    constexpr size_t rfind(basic_string_view s, size_t from = npos) const noexcept {
        if (s._size > _size) return npos;
        size_t i = _size - s._size;
        if (from < i) i = from;
        for (;; --i) {
            if (Traits::compare(_data + i, s._data, s._size) == 0) return i;
            if (i == 0) break;
        }
        return npos;
    }
    constexpr size_t rfind(C c, size_t from = npos) const noexcept {
        if (_size == 0) return npos;
        size_t i = from < _size - 1 ? from : _size - 1;
        for (;; --i) {
            if (_data[i] == c) return i;
            if (i == 0) break;
        }
        return npos;
    }
    constexpr size_t rfind(const C *s, size_t from = npos) const { return rfind(basic_string_view(s), from); }
    constexpr size_t find_first_of(basic_string_view set, size_t from = 0) const noexcept {
        for (size_t i = from; i < _size; ++i)
            if (set.find(_data[i]) != npos) return i;
        return npos;
    }
    constexpr size_t find_first_of(C c, size_t from = 0) const noexcept { return find(c, from); }
    constexpr size_t find_first_not_of(basic_string_view set, size_t from = 0) const noexcept {
        for (size_t i = from; i < _size; ++i)
            if (set.find(_data[i]) == npos) return i;
        return npos;
    }
    constexpr size_t find_first_not_of(C c, size_t from = 0) const noexcept {
        for (size_t i = from; i < _size; ++i)
            if (_data[i] != c) return i;
        return npos;
    }
    constexpr size_t find_last_of(basic_string_view set, size_t from = npos) const noexcept {
        if (_size == 0) return npos;
        size_t i = from < _size - 1 ? from : _size - 1;
        for (;; --i) {
            if (set.find(_data[i]) != npos) return i;
            if (i == 0) break;
        }
        return npos;
    }
    constexpr size_t find_last_of(C c, size_t from = npos) const noexcept { return rfind(c, from); }
    constexpr size_t find_last_not_of(basic_string_view set, size_t from = npos) const noexcept {
        if (_size == 0) return npos;
        size_t i = from < _size - 1 ? from : _size - 1;
        for (;; --i) {
            if (set.find(_data[i]) == npos) return i;
            if (i == 0) break;
        }
        return npos;
    }

private:
    const C *_data;
    size_t _size;
};

template <class C, class T> constexpr bool operator==(basic_string_view<C, T> a, basic_string_view<C, T> b) noexcept { return a.size() == b.size() && a.compare(b) == 0; }
template <class C, class T> constexpr bool operator!=(basic_string_view<C, T> a, basic_string_view<C, T> b) noexcept { return !(a == b); }
template <class C, class T> constexpr bool operator<(basic_string_view<C, T> a, basic_string_view<C, T> b) noexcept { return a.compare(b) < 0; }
template <class C, class T> constexpr bool operator>(basic_string_view<C, T> a, basic_string_view<C, T> b) noexcept { return a.compare(b) > 0; }
template <class C, class T> constexpr bool operator<=(basic_string_view<C, T> a, basic_string_view<C, T> b) noexcept { return a.compare(b) <= 0; }
template <class C, class T> constexpr bool operator>=(basic_string_view<C, T> a, basic_string_view<C, T> b) noexcept { return a.compare(b) >= 0; }

typedef basic_string_view<char> string_view;
typedef basic_string_view<char8_t> u8string_view;
typedef basic_string_view<char16_t> u16string_view;
typedef basic_string_view<char32_t> u32string_view;
typedef basic_string_view<wchar_t> wstring_view;

// A view and a C string compared (the template operators above do not
// convert their operands).
inline bool operator==(string_view a, const char *b) { return a == string_view(b); }
inline bool operator==(const char *a, string_view b) { return string_view(a) == b; }
inline bool operator!=(string_view a, const char *b) { return !(a == string_view(b)); }
inline bool operator!=(const char *a, string_view b) { return !(string_view(a) == b); }

inline namespace literals {
inline namespace string_view_literals {
constexpr string_view operator""sv(const char *s, size_t n) noexcept { return string_view(s, n); }
constexpr u16string_view operator""sv(const char16_t *s, size_t n) noexcept { return u16string_view(s, n); }
constexpr u32string_view operator""sv(const char32_t *s, size_t n) noexcept { return u32string_view(s, n); }
}
}

}
#endif
