// <iomanip>: the manipulators with an argument: setw, setfill,
// setprecision, setbase, setiosflags, resetiosflags.
#ifndef __MLXCC_IOMANIP
#define __MLXCC_IOMANIP
#include <iostream>

namespace std {

struct __setw { long n; };
struct __setfill { char c; };
struct __setprecision { int n; };
struct __setbase { int base; };
struct __setiosflags { ios_base::fmtflags flags; };
struct __resetiosflags { ios_base::fmtflags flags; };

inline __setw setw(int n) { __setw m; m.n = n; return m; }
inline __setfill setfill(char c) { __setfill m; m.c = c; return m; }
inline __setprecision setprecision(int n) { __setprecision m; m.n = n; return m; }
inline __setbase setbase(int base) { __setbase m; m.base = base; return m; }
inline __setiosflags setiosflags(ios_base::fmtflags flags) { __setiosflags m; m.flags = flags; return m; }
inline __resetiosflags resetiosflags(ios_base::fmtflags flags) { __resetiosflags m; m.flags = flags; return m; }

inline ostream &operator<<(ostream &out, __setw m) { out.width(m.n); return out; }
inline ostream &operator<<(ostream &out, __setfill m) { out.fill(m.c); return out; }
inline ostream &operator<<(ostream &out, __setprecision m) { out.precision(m.n); return out; }
inline ostream &operator<<(ostream &out, __setbase m) {
    out.setf(m.base == 16 ? ios_base::hex : m.base == 8 ? ios_base::oct : m.base == 10 ? ios_base::dec : 0, ios_base::basefield);
    return out;
}
inline ostream &operator<<(ostream &out, __setiosflags m) { out.setf(m.flags); return out; }
inline ostream &operator<<(ostream &out, __resetiosflags m) { out.unsetf(m.flags); return out; }

}
#endif
