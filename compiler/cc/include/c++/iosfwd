// <iosfwd>: the stream classes declared, for headers that name them
// without needing them (mlxlibcpp's streams are plain classes, not
// basic_* templates over a character type).
#ifndef __MLXCC_IOSFWD
#define __MLXCC_IOSFWD
#include <stddef.h>

namespace std {
class ios_base;
class ostream;
class istream;
class ostringstream;
class istringstream;
// (The wide streams are declared only: no wide stream is made.)
class wostream;
class wistream;
typedef ostringstream stringstream;
// The stream templates, declared only, for the headers that name them
// in their own templates (`operator<<(std::basic_ostream<C, CT> &, ...)`):
// the streams above are not their instances.
template <class C> struct char_traits;
template <class C, class Traits = char_traits<C> > class basic_ios;
template <class C, class Traits = char_traits<C> > class basic_ostream;
template <class C, class Traits = char_traits<C> > class basic_istream;
template <class C, class Traits = char_traits<C> > class basic_iostream;
typedef long streamoff;
typedef long streamsize;
typedef long streampos;
}
#endif
