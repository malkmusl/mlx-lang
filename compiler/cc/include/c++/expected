// <expected>: std::expected (a value or an error), unexpected.
#ifndef __MLXCC_EXPECTED
#define __MLXCC_EXPECTED
#include <new>
#include <utility>

namespace std {

template <class E> class unexpected {
public:
    explicit unexpected(const E &e) : _error(e) {}
    explicit unexpected(E &&e) : _error(move(e)) {}
    const E &error() const & { return _error; }
    E &error() & { return _error; }
    E &&error() && { return move(_error); }
private:
    E _error;
};
template <class E> unexpected<typename decay<E>::type> make_unexpected(E &&e) { return unexpected<typename decay<E>::type>(forward<E>(e)); }

struct unexpect_t { explicit unexpect_t() = default; };
constexpr unexpect_t unexpect = unexpect_t();

template <class T, class E> class expected {
public:
    typedef T value_type;
    typedef E error_type;
    expected() : _has(true) { new (valueStorage()) T(); }
    expected(const T &v) : _has(true) { new (valueStorage()) T(v); }
    expected(T &&v) : _has(true) { new (valueStorage()) T(move(v)); }
    expected(const unexpected<E> &u) : _has(false) { new (errorStorage()) E(u.error()); }
    expected(unexpected<E> &&u) : _has(false) { new (errorStorage()) E(move(u.error())); }
    template <class... Args> expected(unexpect_t, Args &&... args) : _has(false) { new (errorStorage()) E(forward<Args>(args)...); }
    expected(const expected &other) : _has(other._has) { if (_has) new (valueStorage()) T(*other.valueStorage()); else new (errorStorage()) E(*other.errorStorage()); }
    expected(expected &&other) : _has(other._has) { if (_has) new (valueStorage()) T(move(*other.valueStorage())); else new (errorStorage()) E(move(*other.errorStorage())); }
    ~expected() { destroy(); }
    expected &operator=(const expected &other) {
        if (this != &other) { destroy(); _has = other._has; if (_has) new (valueStorage()) T(*other.valueStorage()); else new (errorStorage()) E(*other.errorStorage()); }
        return *this;
    }
    expected &operator=(expected &&other) {
        if (this != &other) { destroy(); _has = other._has; if (_has) new (valueStorage()) T(move(*other.valueStorage())); else new (errorStorage()) E(move(*other.errorStorage())); }
        return *this;
    }
    bool has_value() const noexcept { return _has; }
    explicit operator bool() const noexcept { return _has; }
    T &value() & { return *valueStorage(); }
    const T &value() const & { return *valueStorage(); }
    T &operator*() & { return *valueStorage(); }
    const T &operator*() const & { return *valueStorage(); }
    T *operator->() { return valueStorage(); }
    const T *operator->() const { return valueStorage(); }
    E &error() & { return *errorStorage(); }
    const E &error() const & { return *errorStorage(); }
    template <class U> T value_or(U &&fallback) const & { return _has ? *valueStorage() : T(forward<U>(fallback)); }
private:
    void destroy() { if (_has) valueStorage()->~T(); else errorStorage()->~E(); }
    T *valueStorage() { return reinterpret_cast<T *>(_storage); }
    const T *valueStorage() const { return reinterpret_cast<const T *>(_storage); }
    E *errorStorage() { return reinterpret_cast<E *>(_storage); }
    const E *errorStorage() const { return reinterpret_cast<const E *>(_storage); }
    alignas(8) unsigned char _storage[sizeof(T) > sizeof(E) ? sizeof(T) : sizeof(E)];
    bool _has;
};

template <class E> class expected<void, E> {
public:
    typedef void value_type;
    typedef E error_type;
    expected() : _has(true) {}
    expected(const unexpected<E> &u) : _has(false) { new (errorStorage()) E(u.error()); }
    expected(unexpected<E> &&u) : _has(false) { new (errorStorage()) E(move(u.error())); }
    expected(const expected &other) : _has(other._has) { if (!_has) new (errorStorage()) E(*other.errorStorage()); }
    ~expected() { if (!_has) errorStorage()->~E(); }
    expected &operator=(const expected &other) {
        if (this != &other) { if (!_has) errorStorage()->~E(); _has = other._has; if (!_has) new (errorStorage()) E(*other.errorStorage()); }
        return *this;
    }
    bool has_value() const noexcept { return _has; }
    explicit operator bool() const noexcept { return _has; }
    void value() const {}
    E &error() & { return *errorStorage(); }
    const E &error() const & { return *errorStorage(); }
private:
    E *errorStorage() { return reinterpret_cast<E *>(_storage); }
    const E *errorStorage() const { return reinterpret_cast<const E *>(_storage); }
    alignas(8) unsigned char _storage[sizeof(E)];
    bool _has;
};

}
#endif
