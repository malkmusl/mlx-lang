// <set>: std::set and std::multiset, keys in a red-black tree ordered
// by the comparator (<__rb_tree>); iterators give the keys const and
// survive insertions and the erasure of other elements. The allocator
// parameter is taken and not used.
#ifndef __MLXCC_SET
#define __MLXCC_SET
#include <stddef.h>
#include <utility>
#include <__rb_tree>

namespace std {

template <class K> struct __set_tree_key { static const K &key(const K &k) { return k; } };

template <class K, class Compare, bool Multi> class __set_base {
protected:
    typedef __rb_tree<K, K, __set_tree_key<K>, Compare, Multi> tree_type;
    tree_type tree;

public:
    typedef K key_type;
    typedef K value_type;
    typedef Compare key_compare;
    typedef Compare value_compare;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef const K &reference;
    typedef const K &const_reference;
    typedef typename tree_type::const_iterator iterator;
    typedef typename tree_type::const_iterator const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

    __set_base() {}
    explicit __set_base(const Compare &c) : tree(c) {}

    iterator begin() const { return tree.begin(); }
    iterator end() const { return tree.end(); }
    iterator cbegin() const { return tree.begin(); }
    iterator cend() const { return tree.end(); }
    reverse_iterator rbegin() const { return reverse_iterator(end()); }
    reverse_iterator rend() const { return reverse_iterator(begin()); }

    size_t size() const { return tree.size(); }
    bool empty() const { return tree.empty(); }
    size_t max_size() const { return ((size_t)-1) / 64; }
    void clear() { tree.clear(); }
    key_compare key_comp() const { return tree.key_comp(); }
    value_compare value_comp() const { return tree.key_comp(); }

    iterator find(const K &key) const { return tree.find(key); }
    size_t count(const K &key) const { return tree.countOf(key); }
    bool contains(const K &key) const { return tree.find(key) != tree.end(); }
    iterator lower_bound(const K &key) const { return tree.lower_bound(key); }
    iterator upper_bound(const K &key) const { return tree.upper_bound(key); }
    pair<iterator, iterator> equal_range(const K &key) const { return pair<iterator, iterator>(lower_bound(key), upper_bound(key)); }

    iterator erase(const_iterator it) { return tree.erase(it); }
    iterator erase(const_iterator first, const_iterator last) { return tree.erase(first, last); }
    size_t erase(const K &key) { return tree.eraseKey(key); }
    template <class P> size_t erase_if_(P predicate) {
        size_t removed = 0;
        for (iterator it = begin(); it != end();) {
            if (predicate(*it)) { it = erase(it); ++removed; } else ++it;
        }
        return removed;
    }
};

template <class K, class Compare = less<K>, class Alloc = void> class set : public __set_base<K, Compare, false> {
    typedef __set_base<K, Compare, false> base_;

public:
    typedef typename base_::iterator iterator;
    typedef typename base_::const_iterator const_iterator;

    set() {}
    explicit set(const Compare &c) : base_(c) {}
    set(initializer_list<K> values) { for (const K &v : values) insert(v); }
    template <class I, class = decltype(*declval<I &>()), class = decltype(++declval<I &>())>
    set(I first, I last) { for (; first != last; ++first) insert(*first); }
    set(const set &other) : base_(other) {}
    set(set &&other) : base_(std::move(other)) {}
    set &operator=(const set &other) { this->tree = other.tree; return *this; }
    set &operator=(set &&other) { this->tree = std::move(other.tree); return *this; }
    set &operator=(initializer_list<K> values) { this->clear(); for (const K &v : values) insert(v); return *this; }

    pair<iterator, bool> insert(const K &key) { return this->tree.emplace(key); }
    pair<iterator, bool> insert(K &&key) { return this->tree.emplace(std::move(key)); }
    iterator insert(const_iterator, const K &key) { return insert(key).first; }
    template <class I> void insert(I first, I last) { for (; first != last; ++first) insert(*first); }
    void insert(initializer_list<K> values) { for (const K &v : values) insert(v); }
    template <class... A> pair<iterator, bool> emplace(A &&... args) { return this->tree.emplace(std::forward<A>(args)...); }
    template <class... A> iterator emplace_hint(const_iterator, A &&... args) { return emplace(std::forward<A>(args)...).first; }
    void swap(set &other) { this->tree.swap(other.tree); }
};

template <class K, class Compare = less<K>, class Alloc = void> class multiset : public __set_base<K, Compare, true> {
    typedef __set_base<K, Compare, true> base_;

public:
    typedef typename base_::iterator iterator;

    multiset() {}
    explicit multiset(const Compare &c) : base_(c) {}
    multiset(initializer_list<K> values) { for (const K &v : values) insert(v); }
    template <class I, class = decltype(*declval<I &>()), class = decltype(++declval<I &>())>
    multiset(I first, I last) { for (; first != last; ++first) insert(*first); }
    multiset(const multiset &other) : base_(other) {}
    multiset(multiset &&other) : base_(std::move(other)) {}
    multiset &operator=(const multiset &other) { this->tree = other.tree; return *this; }
    multiset &operator=(multiset &&other) { this->tree = std::move(other.tree); return *this; }

    iterator insert(const K &key) { return this->tree.emplace(key).first; }
    iterator insert(K &&key) { return this->tree.emplace(std::move(key)).first; }
    template <class I> void insert(I first, I last) { for (; first != last; ++first) insert(*first); }
    template <class... A> iterator emplace(A &&... args) { return this->tree.emplace(std::forward<A>(args)...).first; }
    void swap(multiset &other) { this->tree.swap(other.tree); }
};

template <class K, class C, class A> bool operator==(const set<K, C, A> &a, const set<K, C, A> &b) {
    if (a.size() != b.size()) return false;
    auto x = a.begin();
    auto y = b.begin();
    for (; x != a.end(); ++x, ++y)
        if (!(*x == *y)) return false;
    return true;
}
template <class K, class C, class A> bool operator!=(const set<K, C, A> &a, const set<K, C, A> &b) { return !(a == b); }
template <class K, class C, class A> void swap(set<K, C, A> &a, set<K, C, A> &b) { a.swap(b); }
template <class K, class C, class A, class P> size_t erase_if(set<K, C, A> &s, P predicate) { return s.erase_if_(predicate); }

}
#endif
