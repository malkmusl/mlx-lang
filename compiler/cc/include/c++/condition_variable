// <condition_variable>: std::condition_variable over a pthread condition,
// waiting with a unique_lock<mutex> (wait, wait with a predicate,
// wait_for and wait_until with <chrono>'s durations and time points).
#ifndef __MLXCC_CONDITION_VARIABLE
#define __MLXCC_CONDITION_VARIABLE
#include <pthread.h>
#include <time.h>
#include <mutex>
#include <chrono>

namespace std {

enum class cv_status { no_timeout, timeout };

class condition_variable {
public:
    typedef pthread_cond_t *native_handle_type;
    condition_variable() { pthread_cond_init(&_handle, 0); }
    ~condition_variable() { pthread_cond_destroy(&_handle); }
    condition_variable(const condition_variable &) = delete;
    condition_variable &operator=(const condition_variable &) = delete;
    void notify_one() noexcept { pthread_cond_signal(&_handle); }
    void notify_all() noexcept { pthread_cond_broadcast(&_handle); }
    void wait(unique_lock<mutex> &lock) { pthread_cond_wait(&_handle, lock.mutex()->native_handle()); }
    template <class Predicate> void wait(unique_lock<mutex> &lock, Predicate pred) { while (!pred()) wait(lock); }
    template <class Clock, class Duration> cv_status wait_until(unique_lock<mutex> &lock, const chrono::time_point<Clock, Duration> &when) {
        long long left = chrono::duration_cast<chrono::nanoseconds>(when - Clock::now()).count();
        return wait_nanoseconds(lock, left);
    }
    template <class Clock, class Duration, class Predicate> bool wait_until(unique_lock<mutex> &lock, const chrono::time_point<Clock, Duration> &when, Predicate pred) {
        while (!pred()) {
            if (wait_until(lock, when) == cv_status::timeout) return pred();
        }
        return true;
    }
    template <class Rep, class Period> cv_status wait_for(unique_lock<mutex> &lock, const chrono::duration<Rep, Period> &d) {
        return wait_nanoseconds(lock, chrono::duration_cast<chrono::nanoseconds>(d).count());
    }
    template <class Rep, class Period, class Predicate> bool wait_for(unique_lock<mutex> &lock, const chrono::duration<Rep, Period> &d, Predicate pred) {
        return wait_until(lock, chrono::steady_clock::now() + chrono::duration_cast<chrono::nanoseconds>(d), pred);
    }
    native_handle_type native_handle() { return &_handle; }
private:
    cv_status wait_nanoseconds(unique_lock<mutex> &lock, long long left) {
        if (left <= 0) return cv_status::timeout;
        struct timespec deadline;
        clock_gettime(CLOCK_REALTIME, &deadline);
        long long total = (long long)deadline.tv_nsec + left % 1000000000LL;
        deadline.tv_sec += (time_t)(left / 1000000000LL + total / 1000000000LL);
        deadline.tv_nsec = (long)(total % 1000000000LL);
        int r = pthread_cond_timedwait(&_handle, lock.mutex()->native_handle(), &deadline);
        return r == 0 ? cv_status::no_timeout : cv_status::timeout;
    }
    pthread_cond_t _handle;
};

class condition_variable_any {
public:
    template <class Lock> void wait(Lock &lock) { unique_lock<mutex> inner(_inner); lock.unlock(); _cv.wait(inner); inner.unlock(); lock.lock(); }
    template <class Lock, class Predicate> void wait(Lock &lock, Predicate pred) { while (!pred()) wait(lock); }
    void notify_one() noexcept { lock_guard<mutex> g(_inner); _cv.notify_one(); }
    void notify_all() noexcept { lock_guard<mutex> g(_inner); _cv.notify_all(); }
private:
    mutex _inner;
    condition_variable _cv;
};

}
#endif
