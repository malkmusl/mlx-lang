// <atomic>: std::atomic over the __atomic builtins (a plain
// sequentially consistent memory order is the one mlx-cc does),
// memory_order, atomic_thread_fence, atomic_flag.
#ifndef __MLXCC_ATOMIC
#define __MLXCC_ATOMIC
#ifndef ATOMIC_VAR_INIT
#define ATOMIC_VAR_INIT(value) { value }
#endif
#ifndef ATOMIC_FLAG_INIT
#define ATOMIC_FLAG_INIT { 0 }
#endif
#include <stddef.h>
#include <stdint.h>
#include <type_traits>

namespace std {

enum memory_order { memory_order_relaxed = 0, memory_order_consume = 1, memory_order_acquire = 2, memory_order_release = 3, memory_order_acq_rel = 4, memory_order_seq_cst = 5 };

// A class object of 1, 2, 4 or 8 bytes (`atomic<ThreadId>`): its bytes
// as an unsigned integer of its size, which the builtins take.
template <class T> struct __atomic_bits {
    typedef typename conditional<sizeof(T) == 1, uint8_t, typename conditional<sizeof(T) == 2, uint16_t, typename conditional<sizeof(T) == 4, uint32_t, uint64_t>::type>::type>::type type;
    static type of(const T &value) noexcept {
        type bits = 0;
        const unsigned char *from = reinterpret_cast<const unsigned char *>(&value);
        unsigned char *to = reinterpret_cast<unsigned char *>(&bits);
        for (size_t i = 0; i < sizeof(T); i++) to[i] = from[i];
        return bits;
    }
    static T from(type bits) noexcept { return *reinterpret_cast<const T *>(&bits); }
};

template <class T> struct atomic {
    typedef T value_type;
    static constexpr bool is_always_lock_free = true;
    atomic() noexcept : _value() {}
    constexpr atomic(T desired) noexcept : _value(desired) {}
    atomic(const atomic &) = delete;
    atomic &operator=(const atomic &) = delete;
    bool is_lock_free() const noexcept { return true; }
    void store(T desired, memory_order = memory_order_seq_cst) noexcept {
        if constexpr (is_scalar<T>::value) __atomic_store_n(&_value, desired, 5);
        else __atomic_store_n(_bits(), __atomic_bits<T>::of(desired), 5);
    }
    T load(memory_order = memory_order_seq_cst) const noexcept {
        if constexpr (is_scalar<T>::value) return __atomic_load_n(&_value, 5);
        else return __atomic_bits<T>::from(__atomic_load_n(_bits(), 5));
    }
    operator T() const noexcept { return load(); }
    T operator=(T desired) noexcept { store(desired); return desired; }
    T exchange(T desired, memory_order = memory_order_seq_cst) noexcept {
        if constexpr (is_scalar<T>::value) return __atomic_exchange_n(&_value, desired, 5);
        else return __atomic_bits<T>::from(__atomic_exchange_n(_bits(), __atomic_bits<T>::of(desired), 5));
    }
    bool compare_exchange_strong(T &expected, T desired, memory_order = memory_order_seq_cst) noexcept {
        if constexpr (is_scalar<T>::value) {
            return __atomic_compare_exchange_n(&_value, &expected, desired, 0, 5, 5);
        } else {
            typename __atomic_bits<T>::type seen = __atomic_bits<T>::of(expected);
            bool swapped = __atomic_compare_exchange_n(_bits(), &seen, __atomic_bits<T>::of(desired), 0, 5, 5);
            if (!swapped) expected = __atomic_bits<T>::from(seen);
            return swapped;
        }
    }
    bool compare_exchange_strong(T &expected, T desired, memory_order, memory_order) noexcept { return compare_exchange_strong(expected, desired); }
    bool compare_exchange_weak(T &expected, T desired, memory_order = memory_order_seq_cst) noexcept { return compare_exchange_strong(expected, desired); }
    bool compare_exchange_weak(T &expected, T desired, memory_order, memory_order) noexcept { return compare_exchange_strong(expected, desired); }
    T fetch_add(T arg, memory_order = memory_order_seq_cst) noexcept { return __atomic_fetch_add(&_value, arg, 5); }
    T fetch_sub(T arg, memory_order = memory_order_seq_cst) noexcept { return __atomic_fetch_sub(&_value, arg, 5); }
    T fetch_and(T arg, memory_order = memory_order_seq_cst) noexcept { return __atomic_fetch_and(&_value, arg, 5); }
    T fetch_or(T arg, memory_order = memory_order_seq_cst) noexcept { return __atomic_fetch_or(&_value, arg, 5); }
    T fetch_xor(T arg, memory_order = memory_order_seq_cst) noexcept { return __atomic_fetch_xor(&_value, arg, 5); }
    T operator++() noexcept { return fetch_add(1) + 1; }
    T operator++(int) noexcept { return fetch_add(1); }
    T operator--() noexcept { return fetch_sub(1) - 1; }
    T operator--(int) noexcept { return fetch_sub(1); }
    T operator+=(T arg) noexcept { return fetch_add(arg) + arg; }
    T operator-=(T arg) noexcept { return fetch_sub(arg) - arg; }
    T operator&=(T arg) noexcept { return fetch_and(arg) & arg; }
    T operator|=(T arg) noexcept { return fetch_or(arg) | arg; }
    T operator^=(T arg) noexcept { return fetch_xor(arg) ^ arg; }
private:
    typename __atomic_bits<T>::type *_bits() const noexcept { return (typename __atomic_bits<T>::type *)&_value; }
    T _value;
};

template <class T> struct atomic<T *> {
    typedef T *value_type;
    atomic() noexcept : _value(0) {}
    constexpr atomic(T *desired) noexcept : _value(desired) {}
    atomic(const atomic &) = delete;
    atomic &operator=(const atomic &) = delete;
    void store(T *desired, memory_order = memory_order_seq_cst) noexcept { __atomic_store_n(&_value, desired, 5); }
    T *load(memory_order = memory_order_seq_cst) const noexcept { return __atomic_load_n(&_value, 5); }
    operator T *() const noexcept { return load(); }
    T *operator=(T *desired) noexcept { store(desired); return desired; }
    T *exchange(T *desired, memory_order = memory_order_seq_cst) noexcept { return __atomic_exchange_n(&_value, desired, 5); }
    bool compare_exchange_weak(T *&expected, T *desired, memory_order = memory_order_seq_cst) noexcept { return __atomic_compare_exchange_n(&_value, &expected, desired, 0, 5, 5); }
    bool compare_exchange_strong(T *&expected, T *desired, memory_order = memory_order_seq_cst) noexcept { return __atomic_compare_exchange_n(&_value, &expected, desired, 0, 5, 5); }
    bool compare_exchange_strong(T *&expected, T *desired, memory_order, memory_order) noexcept { return __atomic_compare_exchange_n(&_value, &expected, desired, 0, 5, 5); }
    T *operator->() const noexcept { return load(); }
private:
    T *_value;
};

struct atomic_flag {
    atomic_flag() noexcept : _value(0) {}
    bool test_and_set(memory_order = memory_order_seq_cst) noexcept { return __atomic_exchange_n(&_value, 1, 5) != 0; }
    void clear(memory_order = memory_order_seq_cst) noexcept { __atomic_store_n(&_value, 0, 5); }
    bool test(memory_order = memory_order_seq_cst) const noexcept { return __atomic_load_n(&_value, 5) != 0; }
private:
    int _value;
};

inline void atomic_thread_fence(memory_order) noexcept { __atomic_thread_fence(5); }
inline void atomic_signal_fence(memory_order) noexcept { __atomic_signal_fence(5); }
