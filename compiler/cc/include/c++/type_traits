template <class T, bool = is_arithmetic<T>::value> struct __signedness : false_type {};
template <class T> struct __signedness<T, true> : bool_constant<(T(-1) < T(0))> {};
template <class T> struct is_signed : __signedness<T> {};
template <class T, bool = is_arithmetic<T>::value> struct __unsignedness : false_type {};
