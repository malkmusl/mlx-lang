// Choices.
template <bool B, class T = void> struct enable_if {};
template <class T> struct enable_if<true, T> { typedef T type; };
template <bool B, class T = void> using enable_if_t = typename enable_if<B, T>::type;
template <bool B, class T, class F> struct conditional { typedef T type; };
template <class T, class F> struct conditional<false, T, F> { typedef F type; };
template <bool B, class T, class F> using conditional_t = typename conditional<B, T, F>::type;
template <class...> struct conjunction : true_type {};
template <class B> struct conjunction<B> : B {};
template <class B, class... Bs> struct conjunction<B, Bs...> : conditional<bool(B::value), conjunction<Bs...>, B>::type {};
template <class...> struct disjunction : false_type {};
template <class B> struct disjunction<B> : B {};
template <class B, class... Bs> struct disjunction<B, Bs...> : conditional<bool(B::value), B, disjunction<Bs...> >::type {};
template <class B> struct negation : bool_constant<!bool(B::value)> {};
template <class... B> constexpr bool conjunction_v = conjunction<B...>::value;
template <class... B> constexpr bool disjunction_v = disjunction<B...>::value;
template <class B> constexpr bool negation_v = negation<B>::value;

template <class T> struct decay {
    typedef typename remove_reference<T>::type U;
    typedef typename conditional<is_array<U>::value, typename remove_extent<U>::type *, typename conditional<is_function<U>::value, U *, typename remove_cv<U>::type>::type>::type type;
};
template <class T> using decay_t = typename decay<T>::type;

template <class... T> struct common_type {};
template <class T> struct common_type<T> { typedef typename decay<T>::type type; };
template <class T, class U> struct common_type<T, U> { typedef typename decay<decltype(true ? declval<T>() : declval<U>())>::type type; };
template <class T, class U, class... R> struct common_type<T, U, R...> { typedef typename common_type<typename common_type<T, U>::type, R...>::type type; };
template <class... T> using common_type_t = typename common_type<T...>::type;

// Invocation: a function or a callable object with the arguments.
// (No `type` when the call is not possible: SFINAE-friendly.)
template <class Void, class F, class... Args> struct __invoke_result {};
template <class F, class... Args> struct __invoke_result<void_t<decltype(declval<F>()(declval<Args>()...))>, F, Args...> { typedef decltype(declval<F>()(declval<Args>()...)) type; };
// A pointer to a member function or data member called on an object
// (its first argument): what the member gives.
template <class F> struct __member_result {};
template <class R, class C, class... P> struct __member_result<R (C::*)(P...)> { typedef R type; };
template <class R, class C, class... P> struct __member_result<R (C::*)(P...) const> { typedef R type; };
template <class R, class C, class... P> struct __member_result<R (C::*)(P...) noexcept> { typedef R type; };
template <class R, class C, class... P> struct __member_result<R (C::*)(P...) const noexcept> { typedef R type; };
template <bool member, class F, class... Args> struct __invoke_dispatch : __invoke_result<void, F, Args...> {};
template <class F, class... Args> struct __invoke_dispatch<true, F, Args...> : __member_result<typename remove_cvref<F>::type> {};
template <class F, class... Args> struct invoke_result : __invoke_dispatch<__is_member_function_pointer<typename remove_cvref<F>::type>::value, F, Args...> {};
template <class F, class... Args> using invoke_result_t = typename invoke_result<F, Args...>::type;
template <class Void, class F, class... Args> struct __is_invocable : false_type {};
template <class F, class... Args> struct __is_invocable<void_t<typename invoke_result<F, Args...>::type>, F, Args...> : true_type {};
template <class F, class... Args> struct is_invocable : __is_invocable<void, F, Args...> {};
template <class F, class... Args> constexpr bool is_invocable_v = is_invocable<F, Args...>::value;
template <class Void, class R, class F, class... Args> struct __is_invocable_r : false_type {};
template <class R, class F, class... Args> struct __is_invocable_r<void_t<typename invoke_result<F, Args...>::type>, R, F, Args...> : bool_constant<is_void<R>::value || is_convertible<typename invoke_result<F, Args...>::type, R>::value> {};
template <class R, class F, class... Args> struct is_invocable_r : __is_invocable_r<void, R, F, Args...> {};
template <class R, class F, class... Args> constexpr bool is_invocable_r_v = is_invocable_r<R, F, Args...>::value;
template <class F, class... Args> struct is_nothrow_invocable : is_invocable<F, Args...> {};

template <size_t Len, size_t Align = 8> struct aligned_storage { struct type { alignas(Align) unsigned char data[Len]; }; };
template <size_t Len, size_t Align = 8> using aligned_storage_t = typename aligned_storage<Len, Align>::type;

constexpr bool is_constant_evaluated() noexcept { return false; }


// Clang's __type_pack_element<I, Ts...> (mpark's variant asks
// __has_builtin for it): the I-th type of the pack.
template <size_t I, class T, class... Ts> struct __mlx_pack_element { typedef typename __mlx_pack_element<I - 1, Ts...>::type type; };
template <class T, class... Ts> struct __mlx_pack_element<0, T, Ts...> { typedef T type; };
}
template <size_t I, class... Ts> using __type_pack_element = typename std::__mlx_pack_element<I, Ts...>::type;
