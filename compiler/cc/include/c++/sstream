// <sstream>: std::ostringstream, an ostream writing into a string of
// its own (all of ostream's << and formatting, passed as an ostream &), and
// std::istringstream, reading a string with >>. stringstream is the
// former with str(); neither shares code with the FILE streams.
#ifndef __MLXCC_SSTREAM
#define __MLXCC_SSTREAM
#include <stddef.h>
#include <string>
#include <iostream>
#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>

namespace std {

// The buffer of a string stream (its rdbuf()): what of the string can be
// read, which is all that was written.
class stringbuf {
public:
    explicit stringbuf(const string *text = 0) : text(text) {}
    streamsize in_avail() const { return text ? (streamsize)text->size() : 0; }
    string str() const { return text ? *text : string(); }
private:
    const string *text;
};

class ostringstream : public ostream {
public:
    ostringstream() { init(); }
    ostringstream(const string &initial) : buffer(initial) { init(); }
    ostringstream(const ostringstream &) = delete;
    string str() const { return buffer; }
    void str(const string &text) { buffer = text; }
    stringbuf *rdbuf() const { view = stringbuf(&buffer); return &view; }
private:
    string buffer;
    mutable stringbuf view;
    void init() {
        which = 0;
        digits = 6;
        failed = false;
        format = 0;
        fieldWidth = 0;
        fillChar = 0;
        sink = &buffer;
    }
};

typedef ostringstream stringstream;

class istringstream : public ios_base {
public:
    istringstream() : at(0), failed(false), format(0) {}
    istringstream(const string &text) : source(text), at(0), failed(false), format(0) {}
    // The base of the integers read: ios_base::hex, oct or dec (0).
    ios_base::fmtflags flags() const { return format; }
    ios_base::fmtflags flags(ios_base::fmtflags wanted) { unsigned before = format; format = wanted; return before; }
    ios_base::fmtflags setf(ios_base::fmtflags wanted) { unsigned before = format; format |= wanted; return before; }
    ios_base::fmtflags setf(ios_base::fmtflags wanted, ios_base::fmtflags mask) { unsigned before = format; format = (format & ~mask) | (wanted & mask); return before; }
    void unsetf(ios_base::fmtflags mask) { format &= ~mask; }
    void str(const string &text) { source = text; at = 0; failed = false; }
    string str() const { return source; }
    locale imbue(const locale &) { return locale(); }
    locale getloc() const { return locale(); }
    bool fail() const { return failed; }
    bool eof() const { return at >= source.size(); }
    bool good() const { return !failed && at < source.size(); }
    void clear() { failed = false; }
    operator bool() const { return !failed; }
    int get() { if (at >= source.size()) { failed = true; return -1; } return (unsigned char)source[at++]; }
    int peek() const { return at < source.size() ? (unsigned char)source[at] : -1; }
    istringstream &operator>>(string &word) {
        skipSpace();
        size_t start = at;
        while (at < source.size() && !::isspace((unsigned char)source[at])) at++;
        if (at == start) failed = true; else word = source.substr(start, at - start);
        return *this;
    }
    istringstream &operator>>(char &c) {
        skipSpace();
        if (at >= source.size()) failed = true; else c = source[at++];
        return *this;
    }
    istringstream &operator>>(long &value) {
        string word;
        *this >> word;
        if (failed) return *this;
        char *stop;
        const int base = (format & ios_base::hex) ? 16 : (format & ios_base::oct) ? 8 : 10;
        long read = strtol(word.c_str(), &stop, base);
        // (What follows the number stays to be read.)
        if (stop == word.c_str()) failed = true; else { value = read; at -= word.size() - (stop - word.c_str()); }
        return *this;
    }
    istringstream &operator>>(unsigned long &value) {
        string word;
        *this >> word;
        if (failed) return *this;
        char *stop;
        const int base = (format & ios_base::hex) ? 16 : (format & ios_base::oct) ? 8 : 10;
        unsigned long read = strtoul(word.c_str(), &stop, base);
        if (stop == word.c_str() || word[0] == '-') failed = true; else { value = read; at -= word.size() - (stop - word.c_str()); }
        return *this;
    }
    istringstream &operator>>(long long &value) { long v = 0; *this >> v; if (!failed) value = v; return *this; }
    istringstream &operator>>(unsigned long long &value) { unsigned long v = 0; *this >> v; if (!failed) value = v; return *this; }
    istringstream &operator>>(int &value) { long v = 0; *this >> v; if (!failed && (v < -2147483648L || v > 2147483647L)) failed = true; if (!failed) value = (int)v; return *this; }
    istringstream &operator>>(unsigned &value) {
        unsigned long v = 0;
        *this >> v;
        if (!failed && v > 0xffffffffUL) failed = true;
        if (!failed) value = (unsigned)v;
        return *this;
    }
    istringstream &operator>>(short &value) { long v = 0; *this >> v; if (!failed) value = (short)v; return *this; }
    istringstream &operator>>(bool &value) { long v = 0; *this >> v; if (!failed) value = v != 0; return *this; }
    istringstream &operator>>(double &value) {
        string word;
        *this >> word;
        if (failed) return *this;
        char *stop;
        double read = strtod(word.c_str(), &stop);
        if (stop == word.c_str()) failed = true; else value = read;
        return *this;
    }
    istringstream &operator>>(float &value) { double v = 0; *this >> v; if (!failed) value = (float)v; return *this; }
private:
    string source;
    size_t at;
    bool failed;
    unsigned format;
    void skipSpace() { while (at < source.size() && ::isspace((unsigned char)source[at])) at++; }
};

// The basic_ templates over char (any traits and allocator): the
// streams above, str() giving the basic_string of those.
template <class C, class Traits = char_traits<C>, class Alloc = allocator<C> > class basic_ostringstream;
template <class Traits, class Alloc> class basic_ostringstream<char, Traits, Alloc> : public ostringstream {
public:
    basic_ostringstream() {}
    explicit basic_ostringstream(const string &initial) : ostringstream(initial) {}
    basic_string<char, Traits, Alloc> str() const { return basic_string<char, Traits, Alloc>(ostringstream::str()); }
    void str(const string &text) { ostringstream::str(text); }
};
template <class C, class Traits = char_traits<C>, class Alloc = allocator<C> > class basic_istringstream;
template <class Traits, class Alloc> class basic_istringstream<char, Traits, Alloc> : public istringstream {
public:
    basic_istringstream() {}
    explicit basic_istringstream(const string &text) : istringstream(text) {}
    basic_string<char, Traits, Alloc> str() const { return basic_string<char, Traits, Alloc>(istringstream::str()); }
    void str(const string &text) { istringstream::str(text); }
};

inline istringstream &getline(istringstream &in, string &line, char delimiter = '\n') {
    line.clear();
    if (in.eof()) { in.clear(); int c = in.get(); return in; }
    while (true) {
        int c = in.get();
        if (c < 0) { if (line.empty()) {} else in.clear(); break; }
        if (c == delimiter) break;
        line.push_back((char)c);
    }
    return in;
}

}
#endif
