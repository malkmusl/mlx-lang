// <list>: std::list, a doubly linked list around a sentinel node (the
// end); iterators stay valid until their element is erased.
#ifndef __MLXCC_LIST
#define __MLXCC_LIST
#include <stddef.h>
#include <initializer_list>
#include <iterator>
#include <new>
#include <utility>

namespace std {

template <typename T> struct __list_link {
    __list_link *prev;
    __list_link *next;
};

template <typename T> struct __list_node : __list_link<T> {
    T value;
    template <typename... A> __list_node(A &&... args) : value(std::forward<A>(args)...) {}
};

template <typename T, typename R, typename P> class __list_iterator {
public:
    typedef bidirectional_iterator_tag iterator_category;
    typedef T value_type;
    typedef ptrdiff_t difference_type;
    typedef P pointer;
    typedef R reference;

    __list_link<T> *link;

    __list_iterator() : link(nullptr) {}
    explicit __list_iterator(__list_link<T> *l) : link(l) {}
    // (iterator to const_iterator)
    template <typename R2, typename P2> __list_iterator(const __list_iterator<T, R2, P2> &other) : link(other.link) {}

    R operator*() const { return static_cast<__list_node<T> *>(link)->value; }
    P operator->() const { return &static_cast<__list_node<T> *>(link)->value; }
    __list_iterator &operator++() { link = link->next; return *this; }
    __list_iterator operator++(int) { __list_iterator old = *this; link = link->next; return old; }
    __list_iterator &operator--() { link = link->prev; return *this; }
    __list_iterator operator--(int) { __list_iterator old = *this; link = link->prev; return old; }
    template <typename R2, typename P2> bool operator==(const __list_iterator<T, R2, P2> &other) const { return link == other.link; }
    template <typename R2, typename P2> bool operator!=(const __list_iterator<T, R2, P2> &other) const { return link != other.link; }
};

template <typename T> class list {
public:
    typedef T value_type;
    typedef T &reference;
    typedef const T &const_reference;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    typedef __list_iterator<T, T &, T *> iterator;
    typedef __list_iterator<T, const T &, const T *> const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;

    list() { reset(); }
    explicit list(size_t n) { reset(); while (n--) emplace_back(); }
    list(size_t n, const T &value) { reset(); while (n--) push_back(value); }
    list(initializer_list<T> values) { reset(); for (const T &v : values) push_back(v); }
    template <typename I, typename = decltype(*declval<I &>()), typename = decltype(++declval<I &>())>
    list(I first, I last) { reset(); for (; first != last; ++first) push_back(*first); }
    list(const list &other) { reset(); for (const T &v : other) push_back(v); }
    list(list &&other) { reset(); take(other); }
    ~list() { clear(); }

    list &operator=(const list &other) {
        if (this != &other) {
            clear();
            for (const T &v : other) push_back(v);
        }
        return *this;
    }
    list &operator=(list &&other) {
        if (this != &other) {
            clear();
            take(other);
        }
        return *this;
    }
    list &operator=(initializer_list<T> values) { clear(); for (const T &v : values) push_back(v); return *this; }

    iterator begin() { return iterator(sentinel.next); }
    iterator end() { return iterator(&sentinel); }
    const_iterator begin() const { return const_iterator(sentinel.next); }
    const_iterator end() const { return const_iterator(const_cast<__list_link<T> *>(&sentinel)); }
    const_iterator cbegin() const { return begin(); }
    const_iterator cend() const { return end(); }
    reverse_iterator rbegin() { return reverse_iterator(end()); }
    reverse_iterator rend() { return reverse_iterator(begin()); }
    const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
    const_reverse_iterator rend() const { return const_reverse_iterator(begin()); }

    size_t size() const { return count; }
    bool empty() const { return count == 0; }
    size_t max_size() const { return ((size_t)-1) / sizeof(__list_node<T>); }

    T &front() { return *begin(); }
    const T &front() const { return *begin(); }
    T &back() { return *--end(); }
    const T &back() const { return *--end(); }

    template <typename... A> iterator emplace(const_iterator position, A &&... args) {
        __list_node<T> *node = new __list_node<T>(std::forward<A>(args)...);
        link(position.link, node);
        return iterator(node);
    }
    template <typename... A> T &emplace_back(A &&... args) { return *emplace(end(), std::forward<A>(args)...); }
    template <typename... A> T &emplace_front(A &&... args) { return *emplace(begin(), std::forward<A>(args)...); }
    void push_back(const T &value) { emplace(end(), value); }
    void push_back(T &&value) { emplace(end(), std::move(value)); }
    void push_front(const T &value) { emplace(begin(), value); }
    void push_front(T &&value) { emplace(begin(), std::move(value)); }
    iterator insert(const_iterator position, const T &value) { return emplace(position, value); }
    iterator insert(const_iterator position, T &&value) { return emplace(position, std::move(value)); }
    iterator insert(const_iterator position, size_t n, const T &value) {
        iterator first(position.link);
        bool any = false;
        while (n--) {
            iterator made = emplace(position, value);
            if (!any) { first = made; any = true; }
        }
        return first;
    }
    template <typename I, typename = decltype(*declval<I &>()), typename = decltype(++declval<I &>())>
    iterator insert(const_iterator position, I first, I last) {
        iterator result(position.link);
        bool any = false;
        for (; first != last; ++first) {
            iterator made = emplace(position, *first);
            if (!any) { result = made; any = true; }
        }
        return result;
    }

    iterator erase(const_iterator position) {
        __list_link<T> *l = position.link;
        __list_link<T> *after = l->next;
        unlink(l);
        delete static_cast<__list_node<T> *>(l);
        return iterator(after);
    }
    iterator erase(const_iterator first, const_iterator last) {
        while (first != last) first = erase(first);
        return iterator(last.link);
    }
    void pop_back() { erase(--end()); }
    void pop_front() { erase(begin()); }
    void clear() {
        __list_link<T> *l = sentinel.next;
        while (l != &sentinel) {
            __list_link<T> *after = l->next;
            delete static_cast<__list_node<T> *>(l);
            l = after;
        }
        reset();
    }
    void resize(size_t n) {
        while (count > n) pop_back();
        while (count < n) emplace_back();
    }
    void resize(size_t n, const T &value) {
        while (count > n) pop_back();
        while (count < n) push_back(value);
    }
    void assign(size_t n, const T &value) { clear(); while (n--) push_back(value); }
    void swap(list &other) {
        list held(std::move(other));
        other.take(*this);
        take(held);
    }

    // Moves the elements of `other` (all, one, or a range) before
    // `position`; nothing is copied.
    void splice(const_iterator position, list &other) { splice(position, other, other.begin(), other.end()); }
    void splice(const_iterator position, list &&other) { splice(position, other); }
    void splice(const_iterator position, list &other, const_iterator it) {
        const_iterator next = it;
        ++next;
        // (The element already before `position`, or `position` itself,
        // as an LRU list moving its front to the front: nothing to do;
        // linking it before itself would make a cycle.)
        if (&other == this && (position == it || position == next)) return;
        splice(position, other, it, next);
    }
    void splice(const_iterator position, list &other, const_iterator first, const_iterator last) {
        if (&other == this && position == last) return;
        while (first != last) {
            __list_link<T> *l = first.link;
            ++first;
            other.unlink(l);
            link(position.link, l);
        }
    }

    size_t remove(const T &value) {
        size_t removed = 0;
        for (iterator it = begin(); it != end();) {
            if (*it == value) { it = erase(it); ++removed; } else ++it;
        }
        return removed;
    }
    template <typename F> size_t remove_if(F predicate) {
        size_t removed = 0;
        for (iterator it = begin(); it != end();) {
            if (predicate(*it)) { it = erase(it); ++removed; } else ++it;
        }
        return removed;
    }
    size_t unique() {
        size_t removed = 0;
        if (count < 2) return 0;
        iterator previous = begin();
        for (iterator it = ++begin(); it != end();) {
            if (*it == *previous) { it = erase(it); ++removed; } else { previous = it; ++it; }
        }
        return removed;
    }
    void reverse() {
        __list_link<T> *l = &sentinel;
        do {
            __list_link<T> *next = l->next;
            l->next = l->prev;
            l->prev = next;
            l = next;
        } while (l != &sentinel);
    }
    // Both lists sorted: `other`'s elements moved in, in order (stable).
    template <typename C> void merge(list &other, C less) {
        if (&other == this) return;
        iterator mine = begin();
        while (!other.empty()) {
            iterator theirs = other.begin();
            while (mine != end() && !less(*theirs, *mine)) ++mine;
            splice(mine, other, theirs);
        }
    }
    void merge(list &other) { merge(other, [](const T &a, const T &b) { return a < b; }); }
    void merge(list &&other) { merge(other); }
    // A stable merge sort of the links.
    template <typename C> void sort(C less) {
        if (count < 2) return;
        list second;
        iterator middle = begin();
        for (size_t i = 0; i < count / 2; ++i) ++middle;
        second.splice(second.begin(), *this, middle, end());
        sort(less);
        second.sort(less);
        merge(second, less);
    }
    void sort() { sort([](const T &a, const T &b) { return a < b; }); }

private:
    __list_link<T> sentinel;
    size_t count;

    void reset() {
        sentinel.prev = &sentinel;
        sentinel.next = &sentinel;
        count = 0;
    }
    // `l` before `position`.
    void link(__list_link<T> *position, __list_link<T> *l) {
        l->next = position;
        l->prev = position->prev;
        position->prev->next = l;
        position->prev = l;
        ++count;
    }
    void unlink(__list_link<T> *l) {
        l->prev->next = l->next;
        l->next->prev = l->prev;
        --count;
    }
    // The links of `other` made this list's (this one empty).
    void take(list &other) {
        if (other.count == 0) { reset(); return; }
        sentinel.next = other.sentinel.next;
        sentinel.prev = other.sentinel.prev;
        sentinel.next->prev = &sentinel;
        sentinel.prev->next = &sentinel;
        count = other.count;
        other.reset();
    }
};

template <typename T> bool operator==(const list<T> &a, const list<T> &b) {
    if (a.size() != b.size()) return false;
    auto i = a.begin();
    auto j = b.begin();
    for (; i != a.end(); ++i, ++j) if (!(*i == *j)) return false;
    return true;
}
template <typename T> bool operator!=(const list<T> &a, const list<T> &b) { return !(a == b); }
template <typename T> void swap(list<T> &a, list<T> &b) { a.swap(b); }

}

#endif
