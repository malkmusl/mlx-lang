// A function's LIR (ir.mlx) made into code: mlx4's optimizer over it,
// then its x86-64 back end instruction by instruction into the encoder
// x86.mlx writes to, with the instructions the back end leaves to its
// client (lir.Opcode.external, external_value) emitted here with x86.mlx
// and gen.mlx: the addresses of globals, a memzero, the bit builtins,
// the plain asm instructions.
const base = @import("./base.mlx")
const ast = @import("./ast.mlx")
const x86 = @import("./x86.mlx")
const gen = @import("./gen.mlx")
const builtins = @import("./builtins.mlx")
const ir = @import("./ir.mlx")
const lir = @import("../../compiler/selfhost/ir/lir.mlx")
const optimize = @import("../../compiler/selfhost/ir/optimize.mlx")
const region_loads = @import("../../compiler/selfhost/ir/region_loads.mlx")
const frame = @import("../../compiler/selfhost/ir/frame.mlx")
const registers = @import("../../compiler/selfhost/ir/registers.mlx")
const encoder = @import("../../compiler/selfhost/backend/x86_64/encoder.mlx")
const target = @import("../../compiler/selfhost/backend/x86_64/target.mlx")
const state_module = @import("../../compiler/selfhost/backend/x86_64/codegen/state.mlx")
const emitter = @import("../../compiler/selfhost/backend/x86_64/codegen/emitter.mlx")
const heap = @import("std.heap")

// The client's words of an external instruction (its low byte; the rest
// its payload).
pub const EXT_GLOBAL: usize = 1
pub const EXT_MEMZERO: usize = 2
pub const EXT_BITOP: usize = 3
pub const EXT_ASM: usize = 4
pub const EXT_ASM_CODE: usize = 5
pub const EXT_ASM_FIXED: usize = 6

// Every function's blocks are named after the ones before (.block_N).
var blockLabelBase: usize = 0 // (per run)

// The slot budget per instruction: a C value is one word.
const SLOT_BUDGET: usize = 8

pub fn emitFunction(fn_obj: usize, program: *lir.Lir, block_count: usize, frame_bytes: usize) -> void {
    const allocator = heap.allocator()
    // C code keeps no arena in r14 and r15: five registers for locals,
    // ints and bytes among them.
    registers.registerCount = 5
    registers.narrowLocals = true
    registers.parameterHomes = true
    optimize.narrowArithmetic = true
    // (The memzero external, for region_loads: its kind in the client
    // word's low byte, the byte count above it.)
    region_loads.zeroingKind = EXT_MEMZERO
    region_loads.zeroingShift = 8
    region_loads.typeStoreAddress = @intFromPtr(ir.store())
    var chosen = true
    if region_loads.onlyFunctionLength > 0 { chosen = contains(base.nameOf(ast.obj(fn_obj).*.symbol), base.bytes(region_loads.onlyFunctionPointer, region_loads.onlyFunctionLength)) }
    region_loads.foldLoads = chosen && region_loads.foldAllowed
    region_loads.dropWrites = chosen && region_loads.dropAllowed
    region_loads.foldLogged = 0
    region_loads.foldBudget = region_loads.foldLimit
    const result = optimize.runLocal(program, allocator)
    // The places left packed, the frame sized by them.
    const compacted = frame.compact(program, allocator, frame_bytes)
    const frame_size = compacted.bytes
    if ir.trace && compacted.moved {
        base.say(base.join("lir: frame of ", base.join(base.nameOf(ast.obj(fn_obj).*.symbol), ": ")))
        sayCount("", frame_bytes)
        sayCount(" bytes compacted to ", frame_size)
        sayCount(", places kept ", compacted.kept)
        base.say("\n")
    }
    if ir.trace {
        const r = optimize.lastRegions
        base.say(base.join("lir: regions of ", base.join(base.nameOf(ast.obj(fn_obj).*.symbol), ": loads ")))
        sayCount("", r.loadsSeen)
        sayCount(" tried ", r.loadsTried)
        sayCount(" folded ", r.loadsFolded)
        sayCount(" writes dropped ", r.writesDropped)
        sayCount(" regions dropped ", r.regionsDropped)
        sayCount(" escaped ", r.regionsEscaped)
        sayCount(" (not folded: no write ", region_loads.failNoWrite)
        sayCount(" a write not before ", region_loads.failManyWriters)
        sayCount(" not dominating ", region_loads.failNotDominating)
        sayCount(" partial ", region_loads.failPartial)
        sayCount(" copy source ", region_loads.failCopySource)
        sayCount(" class ", region_loads.failClass)
        if r.firstEscapeAt != lir.NONE {
            sayCount("; first escape at ", r.firstEscapeAt)
            sayCount(" opcode ", r.firstEscapeOpcode)
        }
        base.say(")\n")
        var fold: usize = 0
        while fold < region_loads.foldLogged {
            sayCount("lir: fold: load ", region_loads.foldLog[fold * 4])
            sayCount(" by write ", region_loads.foldLog[fold * 4 + 1])
            sayCount(" kind ", region_loads.foldLog[fold * 4 + 2])
            sayCount(" value ", region_loads.foldLog[fold * 4 + 3])
            base.say("\n")
            fold += 1
        }
        ir.dump(fn_obj, program, "optimized")
    }
    const enc = x86.enc()
    const count = lir.instCount(program)
    const reserved = encoder.reserve(enc, count * 20 + 4096)
    const state = state_module.State.create(allocator, enc, program, ir.store())
    state.*.blockLabelBase = blockLabelBase
    state.*.slotBudget = SLOT_BUDGET
    state.*.slotBase = frame_size
    state.*.preciseSlots = true
    state.*.keepBlockLabels = true
    blockLabelBase += block_count
    // (At 16: a function's address is even, which a pointer to a virtual
    // member function, odd, is told apart from.)
    while x86.position() % 16 != 0 { x86.int3() }
    var index: usize = 0
    while index < count {
        const instruction = lir.getInst(program, index)
        state_module.State.settleLazy(state, index, instruction)
        if instruction.opcode == lir.Opcode.external || instruction.opcode == lir.Opcode.external_value {
            emitExternal(state, index, instruction)
        } else {
            emitter.Emitter.emitInstruction(state, index, instruction)
        }
        state_module.State.releaseDead(state, index, instruction)
        index += 1
    }
    if ir.trace {
        // (The values whose slots were never given back.)
        var at: usize = 0
        var kept: usize = 0
        while at < count {
            if state.*.slotEpochs[at] == state.*.slotEpoch {
                const inst = lir.getInst(program, at)
                if kept < 40 {
                    base.say(base.join("lir: slot kept by ", base.join(base.decimal(@intCast(u64, at)), base.join(" opcode ", base.join(base.decimal(@intCast(u64, @intFromEnum(inst.opcode))), base.join(" last use ", base.join(if state.*.lastUse[at] == lir.NONE { "none" } else { base.decimal(@intCast(u64, state.*.lastUse[at])) }, "\n")))))))
                }
                kept += 1
            }
            at += 1
        }
        base.say(base.join("lir: slots kept ", base.join(base.decimal(@intCast(u64, kept)), "\n")))
        base.say(base.join("lir: frame ", base.join(base.decimal(@intCast(u64, state.*.frameSize)), base.join(" slots to ", base.join(base.decimal(@intCast(u64, @bitCast(u64, @intCast(i64, state.*.slotHighWater)))), base.join(" of ", base.join(base.nameOf(ast.obj(fn_obj).*.symbol), "\n")))))))
    }
    if @intCast(usize, state.*.slotHighWater) + 32 > state.*.frameSize {
        base.say(base.join("internal error: the frame of ", base.join(base.nameOf(ast.obj(fn_obj).*.symbol), " is too small for its values\n")))
        base.fatal("the LIR back end's frame estimate")
    }
    state_module.State.destroy(state)
}

fn sayCount(label: []const u8, value: usize) -> void { base.say(base.join(label, base.decimal(@intCast(u64, value)))) }

fn contains(text: []const u8, part: []const u8) -> bool {
    if part.length > text.length { return false }
    var at: usize = 0
    while at + part.length <= text.length {
        if base.same(text[at..at + part.length], part) { return true }
        at += 1
    }
    return false
}

fn operand(state: *state_module.State, instruction: lir.Inst, at: usize) -> usize {
    return lir.getExtra(state.*.lir, instruction.arg1 + at)
}

fn emitExternal(state: *state_module.State, index: usize, instruction: lir.Inst) -> void {
    const kind = instruction.arg0 & 255
    const payload = instruction.arg0 >> 8
    const enc = x86.enc()
    if kind == EXT_GLOBAL {
        gen.globalAddress(x86.RAX, payload)
        enc.*.raxStackSlot = 0
        state_module.State.storeRaxResult(state, index)
        return
    }
    if kind == EXT_MEMZERO {
        // rep stosb: rcx bytes of al at rdi.
        state_module.State.loadOp(state, target.Register.rdi, operand(state, instruction, 0))
        x86.moveImmediate(x86.RCX, @intCast(i64, payload))
        x86.moveImmediate(x86.RAX, 0)
        x86.repStoreBytes()
        enc.*.raxStackSlot = 0
        encoder.forgetXmm(enc)
        state_module.State.storeRaxResult(state, index)
        return
    }
    if kind == EXT_BITOP {
        state_module.State.loadOp(state, target.Register.rax, operand(state, instruction, 0))
        emitBitop(@intCast(i64, payload & 255), @intCast(i64, payload >> 8))
        enc.*.raxStackSlot = 0
        state_module.State.storeRaxResult(state, index)
        return
    }
    if kind == EXT_ASM {
        const instruction_kind = @intCast(i64, payload)
        if instruction_kind == builtins.ASM_PAUSE { x86.pause() }
        if instruction_kind == builtins.ASM_INT3 { x86.int3() }
        if instruction_kind == builtins.ASM_NOP { x86.nop() }
        if instruction_kind == builtins.ASM_MFENCE { x86.mfence() }
        if instruction_kind == builtins.ASM_LFENCE { x86.lfence() }
        if instruction_kind == builtins.ASM_SFENCE { x86.sfence() }
        if instruction_kind == builtins.ASM_UD2 { x86.ud2() }
        enc.*.raxStackSlot = 0
        encoder.forgetXmm(enc)
        state_module.State.storeRaxResult(state, index)
        return
    }
    if kind == EXT_ASM_CODE {
        emitAsmCode(state, instruction, payload)
        enc.*.raxStackSlot = 0
        encoder.forgetXmm(enc)
        state_module.State.storeRaxResult(state, index)
        return
    }
    if kind == EXT_ASM_FIXED {
        // __builtin_mlxcc_asm's bytes (gen.genAsmFixed): the operands in
        // rdi, rsi and rdx, the result in rax; rsp is at the frame's
        // bottom, 16-byte aligned, for a call in the text.
        state_module.State.loadOp(state, target.Register.rdi, operand(state, instruction, 0))
        state_module.State.loadOp(state, target.Register.rsi, operand(state, instruction, 1))
        state_module.State.loadOp(state, target.Register.rdx, operand(state, instruction, 2))
        const node = ast.node(payload)
        gen.asmBytes(@intCast(usize, node.*.high), @intCast(usize, node.*.label), node.*.extra)
        enc.*.raxStackSlot = 0
        encoder.forgetXmm(enc)
        state_module.State.storeRaxResult(state, index)
        return
    }
    base.fatal("internal error: an external LIR instruction of an unknown kind")
}

// An asm statement's assembled bytes (gen.genAsmCode, with nothing
// pushed by an expression here: rsp is at the frame's bottom, 16-byte
// aligned): rax, rcx, rdx, rbx, rsi, rdi, r8, r9 and r10 loaded from the
// slots at the operand, the bytes, the registers stored back; rbx and
// the callee-saved registers the text clobbers kept for the caller.
fn emitAsmCode(state: *state_module.State, instruction: lir.Inst, n: usize) -> void {
    const node = ast.node(n)
    const address = @intCast(usize, node.*.high)
    const length = @intCast(usize, node.*.label)
    const symbols = node.*.extra
    if instruction.arg2 == 0 {
        // (A call in the text finds the stack as a C call would.)
        gen.asmBytes(address, length, symbols)
        return
    }
    const saved = @intCast(u64, node.*.breakLabel)
    state_module.State.loadOp(state, target.Register.rax, operand(state, instruction, 0))
    x86.push(x86.RBX)
    var r: u8 = 5
    while r < 16 {
        if (saved >> @intCast(u6, r)) & 1 != 0 { x86.push(r) }
        r += 1
    }
    x86.move(x86.R11, x86.RAX)
    x86.push(x86.R11)
    var slotRegisters: [9]u8 = [9]u8{ 0, 1, 2, 3, 6, 7, 8, 9, 10 }
    var i: usize = 9
    while i > 0 {
        i -= 1
        x86.load(slotRegisters[i], x86.R11, @intCast(i64, i * 8), 8, false)
    }
    // rbx, the callee-saved registers kept and r11 pushed: a call in the
    // text finds the stack 16-byte aligned, as a C call would.
    var pushed: i64 = 2
    r = 5
    while r < 16 {
        if (saved >> @intCast(u6, r)) & 1 != 0 { pushed += 1 }
        r += 1
    }
    const odd = symbols != 0 && pushed % 2 == 1
    if odd { x86.subtractStack(8) }
    gen.asmBytes(address, length, symbols)
    if odd { x86.addStack(8) }
    x86.pop(x86.R11)
    i = 0
    while i < 9 {
        x86.store(x86.R11, @intCast(i64, i * 8), slotRegisters[i], 8)
        i += 1
    }
    r = 16
    while r > 5 {
        r -= 1
        if (saved >> @intCast(u6, r)) & 1 != 0 { x86.pop(r) }
    }
    x86.pop(x86.RBX)
}

// A bit builtin on the unsigned operand in rax (gen.genBitop's code):
// the result in rax.
fn emitBitop(op: i64, width: i64) -> void {
    if op == builtins.BSWAP {
        if width == 64 {
            x86.bswap(x86.RAX, true)
        } else if width == 32 {
            x86.bswap(x86.RAX, false)
        } else {
            x86.move(x86.RCX, x86.RAX)
            x86.shiftImmediate(x86.RAX, 8, true, false)
            x86.shiftImmediate(x86.RCX, 8, false, false)
            x86.orRegisters(x86.RAX, x86.RCX)
            x86.extend(x86.RAX, 16, false)
        }
        return
    }
    // clz, ctz, ffs: a zero operand has no set bit (clz and ctz give
    // the width, ffs 0).
    const zero = gen.newLabel()
    const done = gen.newLabel()
    x86.testRegisters(x86.RAX, x86.RAX)
    x86.jumpIf(x86.CC_E, zero)
    x86.bitScan(x86.RCX, x86.RAX, op == builtins.CLZ)
    if op == builtins.CLZ {
        x86.moveImmediate(x86.RAX, width - 1)
        x86.sub(x86.RAX, x86.RCX)
    } else {
        x86.move(x86.RAX, x86.RCX)
        if op == builtins.FFS { x86.immediate(0, x86.RAX, 1) }
    }
    x86.jump(done)
    x86.defineLabel(zero)
    x86.moveImmediate(x86.RAX, if op == builtins.FFS { 0 } else { width })
    x86.defineLabel(done)
}
