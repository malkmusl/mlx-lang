// The languages std.fontconfig knows (its langsets and the languages it
// finds a font supports), made from Fontconfig 2.15's orthographies
// (std/registry/fontconfig/orth/*.orth, the files of its fc-lang
// directory, each the characters a language is written with) and their
// order (std/registry/fontconfig/ORDER, the list of fc-lang/meson.build,
// whose positions are the languages' bits in a langset), and the case
// folding Fontconfig compares names with (its fc-case: the common and
// full foldings of the Unicode Character Database's CaseFolding.txt):
//
//     fontconfig-generate REGISTRY-DIRECTORY CASEFOLDING-FILE OUTPUT-FILE
//
// writes OUTPUT-FILE (std/src/fontconfig/data.mlx): a line a language, in
// the order of their file names (as fc-lang sorts them), with its name,
// its bit and its characters as hexadecimal ranges; and a line a folded
// character, with the characters it folds to. `./mlx build
// fontconfig-data` runs it on this checkout (with
// std/registry/unicode/ucd/CaseFolding.txt).
//
// An orthography file has a character or a range (`0041-005a`,
// `0041..005A`, `0x3000`) a line, `#` comments, `-` before a line to take
// characters out again, and `include FILE` to take another's.
const std = @import("std")

const SYS_mmap: usize = 9
const SYS_exit_group: usize = 231

// ---------------------------------------------------------------------------
// Memory: an arena, reserved and never freed (the run is short).

var arenaNext: usize = 0
var arenaEnd: usize = 0

fn alloc(size: usize) -> usize {
    if arenaNext == 0 {
        const reserved = std.linux.syscall6(SYS_mmap, 0, 1073741824, 3, 16418, @bitCast(usize, @intCast(isize, -1)), 0)
        if reserved < 0 { fail("no memory") }
        arenaNext = @bitCast(usize, reserved)
        arenaEnd = arenaNext + 1073741824
    }
    const at = (arenaNext + 15) / 16 * 16
    if at + size > arenaEnd { fail("out of memory") }
    arenaNext = at + size
    return at
}

fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }
fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }
fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }

fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn fail(message: []const u8) -> void {
    say("fontconfig-generate: ")
    say(message)
    say("\n")
    const ignored = std.linux.syscall1(SYS_exit_group, 1)
}

fn join(first: []const u8, second: []const u8) -> []const u8 {
    const at = alloc(first.length + second.length + 1)
    var index: usize = 0
    while index < first.length {
        put8(at + index, first[index])
        index += 1
    }
    index = 0
    while index < second.length {
        put8(at + first.length + index, second[index])
        index += 1
    }
    return bytes(at, first.length + second.length)
}

fn readWhole(path: []const u8) -> []const u8 {
    const capacity: usize = 262144
    const data = alloc(capacity)
    const length = std.fs.readFileResult(join(path, "").pointer, unsafe { @ptrFromInt([*]u8, data) }, capacity)
    if length < 0 { fail(join("cannot read ", path)) }
    return bytes(data, @bitCast(usize, length))
}

fn writeWhole(path: []const u8, text: []const u8) -> void {
    if !std.fs.writeFile(join(path, "").pointer, text.pointer, text.length, 420) { fail(join("cannot write ", path)) }
}

// ---------------------------------------------------------------------------
// Output: text built up in one buffer.

const OUT_SIZE: usize = 16777216
var outBase: usize = 0
var outTop: usize = 0

fn out(text: []const u8) -> void {
    if outBase == 0 { outBase = alloc(OUT_SIZE) }
    if outTop + text.length > OUT_SIZE { fail("the output is too large") }
    var index: usize = 0
    while index < text.length {
        put8(outBase + outTop + index, text[index])
        index += 1
    }
    outTop += text.length
}

fn outNumber(value: usize) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        out(digits[count..count + 1])
    }
}

fn outHex(value: usize) -> void {
    const hex = "0123456789abcdef"
    var digits: [16]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[count] = hex[rest & 15]
        count += 1
        rest = rest >> 4
        if rest == 0 { break }
    }
    while count > 0 {
        count -= 1
        out(digits[count..count + 1])
    }
}

// ---------------------------------------------------------------------------
// Characters: one bitmap of all of Unicode, filled from a language's file
// (and those it includes), then read out as ranges.

const PLANES: usize = 1114112
var bitmap: usize = 0

fn setChar(code: usize, on: bool) -> void {
    if code >= PLANES { fail("a character beyond Unicode") }
    const at = bitmap + code / 8
    const bit = @intCast(u8, (@intCast(usize, 1) << (code & 7)) & 255)
    if on {
        put8(at, get8(at) | bit)
    } else {
        put8(at, get8(at) & (255 ^ bit))
    }
}

fn hasChar(code: usize) -> bool { return ((@intCast(usize, get8(bitmap + code / 8)) >> (code & 7)) & 1) != 0 }

fn hexValue(c: u8) -> isize {
    if c >= 48 && c <= 57 { return @intCast(isize, c - 48) }
    if c >= 97 && c <= 102 { return @intCast(isize, c - 87) }
    if c >= 65 && c <= 70 { return @intCast(isize, c - 55) }
    return -1
}

fn isSpace(c: u8) -> bool { return c == 32 || c == 9 || c == 13 }

// A hexadecimal number of `text` from `at` (an `0x` before it allowed),
// blanks before it skipped; the position after it in `end`.
fn number(text: []const u8, at: usize, end: *usize) -> usize {
    var i = at
    while i < text.length && isSpace(text[i]) { i += 1 }
    if i + 1 < text.length && text[i] == 48 && (text[i + 1] == 120 || text[i + 1] == 88) { i += 2 }
    var value: usize = 0
    var digits: usize = 0
    while i < text.length && hexValue(text[i]) >= 0 {
        value = value * 16 + @bitCast(usize, hexValue(text[i]))
        digits += 1
        i += 1
    }
    if digits == 0 { fail(join("a line without a character: ", text)) }
    end.* = i
    return value
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    if text.length < prefix.length { return false }
    var i: usize = 0
    while i < prefix.length {
        if text[i] != prefix[i] { return false }
        i += 1
    }
    return true
}

// One line of an orthography (its comment cut off, as fc-lang reads it:
// the text before `#`, then before a tab).
fn readLine(directory: []const u8, line: []const u8) -> void {
    if startsWith(line, "include ") {
        var start: usize = 8
        while start < line.length && isSpace(line[start]) { start += 1 }
        var stop = line.length
        while stop > start && isSpace(line[stop - 1]) { stop -= 1 }
        readFile(directory, line[start..stop])
        return
    }
    var length: usize = 0
    while length < line.length && line[length] != 35 && line[length] != 9 { length += 1 }
    var start: usize = 0
    while start < length && isSpace(line[start]) { start += 1 }
    while length > start && isSpace(line[length - 1]) { length -= 1 }
    if start == length { return }
    var text = line[start..length]
    var on = true
    if text[0] == 45 {
        on = false
        text = text[1..text.length]
    }
    var end: usize = 0
    const first = number(text, 0, &end)
    var last = first
    if end < text.length && text[end] == 45 {
        last = number(text, end + 1, &end)
    } else if end + 1 < text.length && text[end] == 46 && text[end + 1] == 46 {
        last = number(text, end + 2, &end)
    }
    var code = first
    while code <= last {
        setChar(code, on)
        code += 1
    }
}

fn readFile(directory: []const u8, name: []const u8) -> void {
    const text = readWhole(join(join(directory, "/orth/"), name))
    var at: usize = 0
    while at < text.length {
        var stop = at
        while stop < text.length && text[stop] != 10 { stop += 1 }
        readLine(directory, text[at..stop])
        at = stop + 1
    }
}

// ---------------------------------------------------------------------------
// The languages: their files in ORDER's order (a language's bit), sorted by
// file name for the output.

fn lessName(a: []const u8, b: []const u8) -> bool {
    var i: usize = 0
    while i < a.length && i < b.length {
        if a[i] != b[i] { return a[i] < b[i] }
        i += 1
    }
    return a.length < b.length
}

fn nameAt(table: usize, index: usize) -> []const u8 { return bytes(getWord(table + index * 24), getWord(table + index * 24 + 8)) }

// The common (C) and full (F) foldings of CaseFolding.txt ("0041; C;
// 0061; # ..."), as fc-case takes them: a line a character, its code and
// the codes it folds to, in hexadecimal.
fn caseFolding(text: []const u8) -> void {
    out("\n// A line a character Fontconfig folds the case of (CaseFolding.txt's\n")
    out("// common and full foldings, in its order): its code, then the codes it\n")
    out("// folds to, in hexadecimal.\n")
    out("pub const CASE_FOLDING: []const u8 = \"")
    var at: usize = 0
    while at < text.length {
        var stop = at
        while stop < text.length && text[stop] != 10 { stop += 1 }
        const line = text[at..stop]
        at = stop + 1
        if line.length == 0 || line[0] == 35 { continue }
        // The fields: code; status; mapping; # name.
        var fields: usize = 0
        var starts: [4]usize = undefined
        var ends: [4]usize = undefined
        var k: usize = 0
        var begin: usize = 0
        while k <= line.length && fields < 4 {
            if k == line.length || line[k] == 59 {
                var b = begin
                var e = k
                while b < e && line[b] == 32 { b += 1 }
                while e > b && line[e - 1] == 32 { e -= 1 }
                starts[fields] = b
                ends[fields] = e
                fields += 1
                begin = k + 1
            }
            k += 1
        }
        if fields < 3 { fail("a CaseFolding.txt line has too few fields") }
        const status = line[starts[1]..ends[1]]
        if status.length != 1 || (status[0] != 67 && status[0] != 70) { continue }
        outLower(line[starts[0]..ends[0]])
        out(" ")
        outLower(line[starts[2]..ends[2]])
        out("\\n")
    }
    out("\"\n")
}

// Hexadecimal digits (and the spaces between codes) in lower case.
fn outLower(text: []const u8) -> void {
    var index: usize = 0
    while index < text.length {
        var c = text[index]
        if c >= 65 && c <= 70 { c = c + 32 }
        var one: [1]u8 = [1]u8{ c }
        out(one[0..1])
        index += 1
    }
}

fn cString(pointer: [*]const u8) -> []const u8 {
    var length: usize = 0
    while pointer[length] != 0 { length += 1 }
    return pointer[0..length]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 4 { fail("usage: fontconfig-generate REGISTRY-DIRECTORY CASEFOLDING-FILE OUTPUT-FILE") }
    const directory = cString(arguments[1])
    bitmap = alloc(PLANES / 8)
    const order = readWhole(join(directory, "/ORDER"))
    // Records of three words: the file name, its length, its bit.
    const table = alloc(400 * 24)
    var count: usize = 0
    var at: usize = 0
    while at < order.length {
        var stop = at
        while stop < order.length && order[stop] != 10 { stop += 1 }
        if stop > at {
            if count == 400 { fail("too many languages") }
            putWord(table + count * 24, @intFromPtr(order.pointer) + at)
            putWord(table + count * 24 + 8, stop - at)
            putWord(table + count * 24 + 16, count)
            count += 1
        }
        at = stop + 1
    }
    // (Insertion sort: there are fewer than 300.)
    var i: usize = 1
    while i < count {
        var j = i
        while j > 0 && lessName(nameAt(table, j), nameAt(table, j - 1)) {
            var k: usize = 0
            while k < 3 {
                const t = getWord(table + j * 24 + k * 8)
                putWord(table + j * 24 + k * 8, getWord(table + (j - 1) * 24 + k * 8))
                putWord(table + (j - 1) * 24 + k * 8, t)
                k += 1
            }
            j -= 1
        }
        i += 1
    }
    out("// The languages and case folding of std.fontconfig: made by\n")
    out("// fontconfig-generate (std/registry/fontconfig/generate.mlx) from\n")
    out("// Fontconfig 2.15's orthographies (std/registry/fontconfig/orth,\n")
    out("// Copyright Keith Packard and others: see the files) and the Unicode\n")
    out("// Character Database's CaseFolding.txt; do not edit.\n\n")
    out("pub const LANG_COUNT: usize = ")
    outNumber(count)
    out("\n\n// A line a language, in the order of their names: the name (`-` between\n")
    out("// language and territory), its bit in a langset's map, then its\n")
    out("// characters as hexadecimal ranges (\"41-5a 61-7a c0 ...\").\n")
    out("pub const LANGS: []const u8 = \"")
    i = 0
    while i < count {
        const file = nameAt(table, i)
        var e: usize = 0
        while e < PLANES / 8 {
            put8(bitmap + e, 0)
            e += 1
        }
        readFile(directory, file)
        var n: usize = 0
        while n < file.length && file[n] != 46 {
            var c = file[n]
            if c == 95 { c = 45 }
            if c >= 65 && c <= 90 { c = c + 32 }
            if c != 32 {
                var one: [1]u8 = [1]u8{ c }
                out(one[0..1])
            }
            n += 1
        }
        out(" ")
        outNumber(getWord(table + i * 24 + 16))
        var code: usize = 0
        while code < PLANES {
            if !hasChar(code) {
                code += 1
                continue
            }
            var last = code
            while last + 1 < PLANES && hasChar(last + 1) { last += 1 }
            out(" ")
            outHex(code)
            if last > code {
                out("-")
                outHex(last)
            }
            code = last + 1
        }
        out("\\n")
        i += 1
    }
    out("\"\n")
    caseFolding(readWhole(cString(arguments[2])))
    writeWhole(cString(arguments[3]), bytes(outBase, outTop))
    return 0
}
