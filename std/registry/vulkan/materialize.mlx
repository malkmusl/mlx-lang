// Stage-1 standard-library bootstrap tool: materializes std.vulkan from the
// Vulkan API registry in this directory.
//
//   materialize            parse vk.xml, resolve the selection below and
//                          (re)write std/src/vulkan.mlx
//   materialize --check    verify the committed module is current
//
// Run from the repository root (see materialize.sh). Ordinary projects never
// run this tool; they import std.vulkan.

const std = @import("std")
const registry = @import("std.vulkan.registry")
const materialize = @import("std.vulkan.materialize")

const ArrayList = std.array_list.ArrayList
const String = std.string.String

const SOURCE = "std/registry/vulkan/vk.xml"
const OUTPUT = "std/src/vulkan.mlx"

// The API surface: Vulkan 1.3 core plus these extensions.
//
// - WSI: surfaces, swapchains, and the Wayland, Android, direct-to-display
//   (VK_KHR_display) and headless (VK_EXT_headless_surface: swapchains
//   without a window system, for tests) surfaces;
// - debugging: VK_EXT_debug_utils;
// - portability enumeration (implementations such as MoltenVK);
// - buffer sharing with other processes and APIs: external memory and
//   semaphores as file descriptors, dma-buf memory and DRM format modifiers
//   (the path to Wayland's linux-dmabuf), and imported host memory (a
//   wl_shm pool rendered into directly).
fn select(selection: *registry.Selection) -> void {
    selection.*.maxMinor = 3
    selection.*.extensionCount = 0
    addExtension(selection, "VK_KHR_surface")
    addExtension(selection, "VK_KHR_swapchain")
    addExtension(selection, "VK_KHR_display")
    addExtension(selection, "VK_KHR_wayland_surface")
    addExtension(selection, "VK_KHR_android_surface")
    addExtension(selection, "VK_EXT_headless_surface")
    addExtension(selection, "VK_EXT_debug_utils")
    addExtension(selection, "VK_KHR_portability_enumeration")
    addExtension(selection, "VK_KHR_external_memory_fd")
    addExtension(selection, "VK_KHR_external_semaphore_fd")
    addExtension(selection, "VK_KHR_external_fence_fd")
    addExtension(selection, "VK_EXT_external_memory_dma_buf")
    addExtension(selection, "VK_EXT_image_drm_format_modifier")
    addExtension(selection, "VK_EXT_queue_family_foreign")
    addExtension(selection, "VK_EXT_external_memory_host")
}

fn addExtension(selection: *registry.Selection, name: []const u8) -> void {
    selection.*.extensions[selection.*.extensionCount] = std.string.fromSlice(name)
    selection.*.extensionCount += 1
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn sayString(text: String) -> void {
    const ignored = std.io.writeString(std.io.stderr(), text)
}

fn readFile(path: [*]const u8, allocator: std.allocator.Allocator, result: *ArrayList) -> bool {
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return false }
    result.* = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    return true
}

fn sameContents(left: *const ArrayList, right: *const ArrayList) -> bool {
    if left.*.length != right.*.length { return false }
    var index: usize = 0
    while index < left.*.length {
        if left.*.items[index] != right.*.items[index] { return false }
        index += 1
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var check = false
    if std.process.count(arguments) > 1 {
        const flag = std.process.argument(arguments, 1)
        if std.string.eql(flag, std.string.fromSlice("--check")) {
            check = true
        } else {
            say("usage: materialize [--check]\n")
            return 2
        }
    }
    var source: ArrayList = undefined
    unsafe {
        if !readFile(@ptrCast([*]const u8, SOURCE), allocator, &source) {
            say("cannot read std/registry/vulkan/vk.xml\n")
            return 1
        }
    }
    var selection: registry.Selection = undefined
    select(&selection)
    var model: registry.Registry = undefined
    registry.initAt(&model, allocator, source.items, source.length, selection)
    if !registry.parse(&model) {
        say("std/registry/vulkan/vk.xml:")
        const line = std.io.writeUnsigned(std.io.stderr(), model.errorLine)
        say(": error: ")
        sayString(model.failure)
        say("\n")
        return 1
    }
    if !registry.resolve(&model) {
        say("materialize: required definition missing from the registry: ")
        sayString(model.failure)
        say("\n")
        return 1
    }
    var out = ArrayList.init(allocator, 1 << 22)
    if !materialize.emit(&model, &out) {
        say("materialize: out of memory\n")
        return 1
    }
    if check {
        var existing: ArrayList = undefined
        var present = false
        unsafe { present = readFile(@ptrCast([*]const u8, OUTPUT), allocator, &existing) }
        if !present || !sameContents(&existing, &out) {
            say("stale generated module: std/src/vulkan.mlx\n")
            return 1
        }
        say("std.vulkan is current\n")
        return 0
    }
    var file = std.fs.open(@ptrFromInt([*]const u8, 0), 0, 0)
    unsafe { file = std.fs.open(@ptrCast([*]const u8, OUTPUT), 577, 420) }
    if !std.fs.isValid(file) {
        say("cannot write std/src/vulkan.mlx\n")
        return 1
    }
    const written = std.fs.writeAllBytes(file, out.items, out.length)
    const closed = std.fs.close(file)
    if !written { return 1 }
    say("materialized std.vulkan into std/src/vulkan.mlx\n")
    return 0
}
