// The zones of std.timezone.database (std/src/timezone/tzdata.mlx, made
// by generate.mlx from tzdata.zi here) against the zone files zic made
// of the same database, where the system has them (/usr/share/zoneinfo,
// TZif): the offset from UTC on both sides of every transition either
// knows of, 1850 to 2100, and at the middle of every month. Zones the
// system lacks are counted, not compared. tools/check_unicode.sh runs it.
//
//     ./mlx std/registry/tz/compare.mlx -o compare
//     ./compare [ZONEINFO-DIRECTORY]
const std = @import("std")
const timezone = @import("std.timezone")
const zones = @import("std.timezone.database")

var zone: timezone.Zone = undefined
var file: [1048576]u8 = undefined
var path: [512]u8 = undefined

const FROM: i64 = -3786825600
const TO: i64 = 4102444800

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stdout(), text)
}

fn sayNumber(value: i64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest: u64 = if value < 0 { @intCast(u64, -value) } else { @intCast(u64, value) }
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    if value < 0 { say("-") }
    const view: [*]const u8 = unsafe { @ptrCast([*]const u8, &digits) }
    say(view[24 - count..24])
}

// The system's file for `name` read into `zone`; false without one.
fn load(directory: []const u8, name: []const u8) -> bool {
    var length: usize = 0
    for byte in directory {
        path[length] = byte
        length += 1
    }
    path[length] = 47
    length += 1
    for byte in name {
        path[length] = byte
        length += 1
    }
    path[length] = 0
    const opened = std.fs.open(unsafe { @ptrCast([*]const u8, &path) }, 0, 0)
    if !std.fs.isValid(opened) { return false }
    var size: usize = 0
    while size < 1048576 {
        const count = std.fs.read(opened, unsafe { @ptrCast([*]u8, &file) } + size, 1048576 - size)
        if count <= 0 { break }
        size += @intCast(usize, count)
    }
    _ = std.fs.close(opened)
    zone.count = 0
    zone.typeCount = 0
    zone.hasRule = false
    zone.hasDaylight = false
    return timezone.parseTzif(&zone, unsafe { @ptrCast([*]const u8, &file) }, size)
}

var differences: usize = 0

fn check(z: usize, name: []const u8, utc: i64) -> void {
    if utc < FROM || utc > TO { return }
    const ours = zones.totalAt(z, utc)
    const theirs = timezone.offsetAt(&zone, utc)
    if ours != theirs {
        if differences < 20 {
            say(name)
            say(" at ")
            sayNumber(utc)
            say(": ")
            sayNumber(ours)
            say(" against zic's ")
            sayNumber(theirs)
            say("\n")
        }
        differences += 1
    }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    var directory: []const u8 = "/usr/share/zoneinfo"
    if arguments.length > 1 {
        var length: usize = 0
        while arguments[1][length] != 0 { length += 1 }
        directory = arguments[1][0..length]
    }
    var compared: usize = 0
    var missing: usize = 0
    var moments: usize = 0
    var id: usize = 0
    while id < zones.idCount() {
        const name = zones.idName(id)
        if !zones.isCanonical(id) {
            id += 1
            continue
        }
        if !load(directory, name) {
            missing += 1
            id += 1
            continue
        }
        compared += 1
        const z = zones.zoneOf(id)
        // zic's transitions and the rule after them.
        var index: usize = 0
        while index < zone.count {
            check(z, name, zone.times[index])
            check(z, name, zone.times[index] - 1)
            moments += 2
            index += 1
        }
        // Ours.
        var at = FROM
        while true {
            const next = zones.nextTransition(z, at, false)
            if !next.found || next.time > TO { break }
            check(z, name, next.time)
            check(z, name, next.time - 1)
            moments += 2
            at = next.time
        }
        // The middle of every month.
        at = FROM
        while at < TO {
            check(z, name, at)
            moments += 1
            at += 2629746
        }
        id += 1
    }
    sayNumber(@intCast(i64, compared))
    say(" zones compared with zic's files at ")
    sayNumber(@intCast(i64, moments))
    say(" moments, ")
    sayNumber(@intCast(i64, differences))
    say(" differences")
    if missing > 0 {
        say(" (")
        sayNumber(@intCast(i64, missing))
        say(" not on this system)")
    }
    say("\n")
    return if differences == 0 && compared > 0 { 0 } else { 1 }
}
