// Stage-1 standard-library bootstrap tool: materializes std.spirv.core from
// the SPIR-V core grammar in this directory.
//
//   materialize            parse the grammar and (re)write std/src/spirv/core.mlx
//   materialize --check    verify the committed module is current
//
// Run from the repository root (see materialize.sh).

const std = @import("std")
const spirv = @import("std.spirv.materialize")

const ArrayList = std.array_list.ArrayList

const SOURCE = "std/registry/spirv/spirv.core.grammar.json"
const OUTPUT = "std/src/spirv/core.mlx"

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn readFile(path: [*]const u8, allocator: std.allocator.Allocator, result: *ArrayList) -> bool {
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return false }
    result.* = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    return true
}

fn sameContents(left: *const ArrayList, right: *const ArrayList) -> bool {
    if left.*.length != right.*.length { return false }
    var index: usize = 0
    while index < left.*.length {
        if left.*.items[index] != right.*.items[index] { return false }
        index += 1
    }
    return true
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var check = false
    if std.process.count(arguments) > 1 {
        if std.string.eql(std.process.argument(arguments, 1), std.string.fromSlice("--check")) {
            check = true
        } else {
            say("usage: materialize [--check]\n")
            return 2
        }
    }
    var source: ArrayList = undefined
    var present = false
    unsafe { present = readFile(@ptrCast([*]const u8, SOURCE), allocator, &source) }
    if !present {
        say("cannot read std/registry/spirv/spirv.core.grammar.json\n")
        return 1
    }
    var grammar: spirv.Grammar = undefined
    if !spirv.parse(&grammar, allocator, source.items, source.length) {
        say("std/registry/spirv/spirv.core.grammar.json:")
        const line = std.io.writeUnsigned(std.io.stderr(), grammar.errorLine)
        say(": error: ")
        const message = std.io.writeString(std.io.stderr(), grammar.failure)
        say("\n")
        return 1
    }
    var out = ArrayList.init(allocator, 1 << 20)
    spirv.emit(&grammar, &out)
    if check {
        var existing: ArrayList = undefined
        var found = false
        unsafe { found = readFile(@ptrCast([*]const u8, OUTPUT), allocator, &existing) }
        if !found || !sameContents(&existing, &out) {
            say("stale generated module: std/src/spirv/core.mlx\n")
            return 1
        }
        say("std.spirv.core is current\n")
        return 0
    }
    var file = std.fs.open(@ptrFromInt([*]const u8, 0), 0, 0)
    unsafe { file = std.fs.open(@ptrCast([*]const u8, OUTPUT), 577, 420) }
    if !std.fs.isValid(file) {
        say("cannot write std/src/spirv/core.mlx\n")
        return 1
    }
    const written = std.fs.writeAllBytes(file, out.items, out.length)
    const closed = std.fs.close(file)
    if !written { return 1 }
    say("materialized std.spirv.core into std/src/spirv/core.mlx\n")
    return 0
}
