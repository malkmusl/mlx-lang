// The locale data of std.unicode's formatters (dates, numbers, currencies,
// plural rules, lists, relative times, measure units, the names of
// languages, scripts, regions and the rest), made of CLDR's JSON packages as npm has them
// (std/registry/unicode/cldr/packages/*.tgz) into one file std.unicode maps:
//
//     cldr-data PACKAGES-DIRECTORY OUTPUT-FILE
//
// Each locale's data is a tree of keys ("dates/calendars/gregorian/months/
// format/wide/1" -> "Januar"; arrays by index), and a locale keeps only
// what differs from its parent's (CLDR's parentLocales, else the locale
// without its last subtag, else und, the root): a lookup goes up the
// parents until it finds the key, as ICU's resource bundles do. CLDR's
// supplemental data (plural rules, numbering systems, currencies, time
// and calendar data...) is the tree of the locale "@supplemental".
//
// The calendars' data (dates/calendars/TYPE/..., CLDR's cldr-cal-*
// packages and the dates package's) is whole in CLDR's JSON for each
// type, what a type takes of another (Buddhist months are the Gregorian
// ones, islamic-civil's the Islamic calendar's) copied in: a locale keeps
// of a type only what differs from the type it takes from (the same
// locale's), and a lookup goes on to that type when the locale and its
// parents have none, as ICU's aliases in its root calendars do. (The
// eras and the tables of skeletons are kept whole: what keys they have
// is what the type has.)
//
// The file (numbers are u32, little-endian):
//     "MLXCLDR\0", the version (1), the counts of locales, keys, entries
//     and strings, and where the five tables below start;
//     locales: for each (sorted by name) its name's string, its parent's
//         index (0xFFFFFFFF for none), its first entry and their count;
//     keys: each key's string, sorted;
//     entries: each locale's (key index, value string), sorted by key;
//     strings: where each starts, then their bytes (UTF-8, each ending
//         in NUL).
// `./mlx build unicode` runs it (mlx-out/share/mlx-unicode/cldr.dat).
const std = @import("std")
const crash = @import("std.crash")
const flate = @import("std.flate")
const tar = @import("std.tar")
const json = @import("std.json")

const SYS_mmap: usize = 9
const SYS_exit_group: usize = 231

const NONE: u32 = 4294967295
// The value of a key a locale does not have though its parent does.
pub const ABSENT: []const u8 = "\xe2\x88\x85\xe2\x88\x85\xe2\x88\x85"
const SUPPLEMENTAL: []const u8 = "@supplemental"

// What is taken of each package: its files under main/LOCALE/ and
// supplemental/ (by name, without .json).
const MAIN_FILES = [33][]const u8{ "ca-gregorian", "ca-generic", "dateFields", "timeZoneNames", "numbers", "currencies",
    "listPatterns", "contextTransforms", "delimiters", "layout", "languages", "scripts", "territories", "variants",
    "localeDisplayNames", "units", "ca-buddhist", "ca-chinese", "ca-coptic", "ca-dangi", "ca-ethiopic",
    "ca-ethiopic-amete-alem", "ca-hebrew", "ca-indian", "ca-islamic", "ca-islamic-civil", "ca-islamic-rgsa",
    "ca-islamic-tbla", "ca-islamic-umalqura", "ca-japanese", "ca-persian", "ca-roc", "" }
const SUPPLEMENTAL_FILES = [16][]const u8{ "plurals", "ordinals", "pluralRanges", "numberingSystems", "currencyData",
    "timeData", "calendarData", "calendarPreferenceData", "dayPeriods", "metaZones", "primaryZones", "measurementData",
    "weekData", "parentLocales", "unitsMetadata", "grammaticalFeatures" }
const PACKAGES = [17][]const u8{ "cldr-core", "cldr-dates-full", "cldr-numbers-full", "cldr-misc-full", "cldr-localenames-full",
    "cldr-units-full", "cldr-cal-buddhist-full", "cldr-cal-chinese-full", "cldr-cal-coptic-full", "cldr-cal-dangi-full",
    "cldr-cal-ethiopic-full", "cldr-cal-hebrew-full", "cldr-cal-indian-full", "cldr-cal-islamic-full",
    "cldr-cal-japanese-full", "cldr-cal-persian-full", "cldr-cal-roc-full" }

// The calendar each type takes what it lacks from ("" for none).
fn fallbackCalendar(name: []const u8) -> []const u8 {
    if same(name, "gregorian") || same(name, "generic") { return "" }
    if same(name, "islamic-civil") || same(name, "islamic-umalqura") || same(name, "islamic-tbla") || same(name, "islamic-rgsa") { return "islamic" }
    if same(name, "ethiopic-amete-alem") { return "ethiopic" }
    if same(name, "dangi") { return "chinese" }
    return "gregorian"
}

// ---------------------------------------------------------------------------
// Memory: an arena, reserved and never freed.

const ARENA_SIZE: usize = 68719476736
var arenaNext: usize = 0
var arenaEnd: usize = 0

fn alloc(size: usize) -> usize {
    if arenaNext == 0 {
        const reserved = std.linux.syscall6(SYS_mmap, 0, ARENA_SIZE, 3, 16418, @bitCast(usize, @intCast(isize, -1)), 0)
        if reserved < 0 { fail("no memory") }
        arenaNext = @bitCast(usize, reserved)
        arenaEnd = arenaNext + ARENA_SIZE
    }
    const at = (arenaNext + 15) / 16 * 16
    if at + size > arenaEnd { fail("out of memory") }
    arenaNext = at + size
    return at
}

fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

fn writable(address: usize) -> [*]u8 {
    var view: [*]u8 = undefined
    unsafe { view = @ptrFromInt([*]u8, address) }
    return view
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn fail(message: []const u8) -> void {
    say("cldr-data: ")
    say(message)
    say("\n")
    const ignored = std.linux.syscall1(SYS_exit_group, 1)
}

fn same(a: []const u8, b: []const u8) -> bool { return std.text.same(a, b) }

fn join(first: []const u8, second: []const u8) -> []const u8 {
    const at = alloc(first.length + second.length + 1)
    const view = writable(at)
    var index: usize = 0
    while index < first.length {
        view[index] = first[index]
        index += 1
    }
    index = 0
    while index < second.length {
        view[first.length + index] = second[index]
        index += 1
    }
    view[first.length + second.length] = 0
    return bytes(at, first.length + second.length)
}

fn endsWith(text: []const u8, suffix: []const u8) -> bool {
    return text.length >= suffix.length && same(text[text.length - suffix.length..text.length], suffix)
}

fn before(a: []const u8, b: []const u8) -> bool {
    var k: usize = 0
    while k < a.length && k < b.length {
        if a[k] != b[k] { return a[k] < b[k] }
        k += 1
    }
    return a.length < b.length
}

fn readWhole(path: []const u8) -> []const u8 {
    const capacity: usize = 268435456
    const data = alloc(capacity)
    const length = std.fs.readFileResult(join(path, "").pointer, unsafe { @ptrFromInt([*]u8, data) }, capacity)
    if length < 0 { fail(join("cannot read ", path)) }
    return bytes(data, @bitCast(usize, length))
}

// ---------------------------------------------------------------------------
// Strings, each kept once: an open-addressing table of their ids.

const MAX_STRINGS: usize = 2097152
const SLOTS: usize = 4194304
var stringAt: [*][]const u8 = undefined
var stringCount: usize = 0
var slots: [*]u32 = undefined

fn hashOf(text: []const u8) -> u64 {
    var h: u64 = 14695981039346656037
    for byte in text {
        h ^= @intCast(u64, byte)
        h *%= 1099511628211
    }
    return h
}

fn intern(text: []const u8) -> u32 {
    var slot = @intCast(usize, hashOf(text) % @intCast(u64, SLOTS))
    while slots[slot] != NONE {
        if same(stringAt[slots[slot]], text) { return slots[slot] }
        slot = (slot + 1) % SLOTS
    }
    if stringCount == MAX_STRINGS { fail("too many strings") }
    // Kept in the arena (the text it came from is not).
    stringAt[stringCount] = join(text, "")
    slots[slot] = @intCast(u32, stringCount)
    stringCount += 1
    return slots[slot]
}

// Keys: the strings used as keys, numbered apart.
const MAX_KEYS: usize = 131072
var keyOfString: [*]u32 = undefined
var keyString: [*]u32 = undefined
var keyCount: usize = 0

fn keyOf(text: []const u8) -> u32 {
    const id = intern(text)
    if keyOfString[id] == NONE {
        if keyCount == MAX_KEYS { fail("too many keys") }
        keyOfString[id] = @intCast(u32, keyCount)
        keyString[keyCount] = id
        keyCount += 1
    }
    return keyOfString[id]
}

// ---------------------------------------------------------------------------
// Locales, and their values: (locale << 52) | (key << 32) | value.

const MAX_LOCALES: usize = 2048
var localeName: [*][]const u8 = undefined
var localeCount: usize = 0

fn localeOf(name: []const u8) -> u32 {
    var index: usize = 0
    while index < localeCount {
        if same(localeName[index], name) { return @intCast(u32, index) }
        index += 1
    }
    if localeCount == MAX_LOCALES { fail("too many locales") }
    localeName[localeCount] = join(name, "")
    // Its name is a string of the file.
    _ = intern(name)
    localeCount += 1
    return @intCast(u32, localeCount - 1)
}

const MAX_VALUES: usize = 33554432
var values: [*]u64 = undefined
var valueCount: usize = 0

fn addValue(locale: u32, key: []const u8, value: []const u8) -> void {
    if valueCount == MAX_VALUES { fail("too many values") }
    values[valueCount] = (@intCast(u64, locale) << 52) | (@intCast(u64, keyOf(key)) << 32) | @intCast(u64, intern(value))
    valueCount += 1
}

// The values of a JSON file, each with its path of keys below SKIP levels
// (main/LOCALE, or supplemental): arrays' elements by their index.
fn flatten(locale: u32, text: []const u8, skip: usize) -> void {
    var tokenizer: json.Tokenizer = undefined
    json.initAt(&tokenizer, text.pointer, text.length)
    var token: json.Token = undefined
    var keys: [64][]const u8 = undefined
    var isArray: [64]bool = undefined
    var index: [64]usize = undefined
    var depth: usize = 0
    var pending: []const u8 = ""
    var hasPending = false
    var decoded: [*]u8 = writable(alloc(1048576))
    while json.next(&tokenizer, &token) {
        const kind = token.kind
        if kind == json.TokenKind.key {
            const raw = token.value
            const length = json.decodeString(raw, decoded, 1048576)
            if length < 0 { fail("a bad key") }
            pending = join(decoded[0..@intCast(usize, length)], "")
            hasPending = true
            continue
        }
        // An element of an array is keyed by its index.
        if !hasPending && depth > 0 && isArray[depth - 1] {
            var digits: [24]u8 = undefined
            const view: [*]u8 = unsafe { @ptrCast([*]u8, &digits) }
            const length = std.text.appendUnsigned(view, 0, 24, index[depth - 1])
            pending = join(view[0..length], "")
            hasPending = true
            if kind != json.TokenKind.objectEnd && kind != json.TokenKind.arrayEnd { index[depth - 1] += 1 }
        }
        if kind == json.TokenKind.objectStart || kind == json.TokenKind.arrayStart {
            if depth == 64 { fail("too deep") }
            keys[depth] = if hasPending { pending } else { "" }
            isArray[depth] = kind == json.TokenKind.arrayStart
            index[depth] = 0
            depth += 1
            hasPending = false
            continue
        }
        if kind == json.TokenKind.objectEnd || kind == json.TokenKind.arrayEnd {
            depth -= 1
            hasPending = false
            continue
        }
        // A value: its path is the open keys below SKIP and the pending one.
        var path: []const u8 = ""
        var level: usize = 1 + skip
        while level < depth {
            path = if path.length == 0 { keys[level] } else { join(join(path, "/"), keys[level]) }
            level += 1
        }
        if hasPending { path = if path.length == 0 { pending } else { join(join(path, "/"), pending) } }
        hasPending = false
        // Who and what made the data is not data.
        if depth <= 1 + skip { continue }
        if std.text.same(keys[1 + skip], "identity") || (skip == 1 && std.text.same(keys[1 + skip], "version")) { continue }
        var value: []const u8 = ""
        if kind == json.TokenKind.string {
            const length = json.decodeString(token.value, decoded, 1048576)
            if length < 0 { fail("a bad string") }
            value = decoded[0..@intCast(usize, length)]
        } else if kind == json.TokenKind.trueValue {
            value = "true"
        } else if kind == json.TokenKind.falseValue {
            value = "false"
        } else if kind == json.TokenKind.number {
            value = token.value.pointer[0..token.value.length]
        } else {
            continue
        }
        if !wantedValue(path) { continue }
        addValue(locale, path, value)
    }
    if json.failed(&tokenizer) { fail(json.errorMessage(json.errorCode(&tokenizer))) }
}

// Of the units (main/LOCALE/units), what formatting takes: the unit
// patterns by plural form, the per-unit patterns, the genders, the
// compound patterns (per, times, powers, prefixes) and the duration
// patterns. Not the display names, the coordinates, nor the patterns of
// the grammatical cases (ICU's C API has no way to ask for a case).
fn wantedValue(path: []const u8) -> bool {
    if !std.text.startsWith(path, "units/") { return true }
    var last: usize = path.length
    while last > 0 && path[last - 1] != 47 { last -= 1 }
    const leaf = path[last..path.length]
    if contains(leaf, "-case-") { return false }
    if std.text.startsWith(leaf, "unitPattern-count-") || std.text.startsWith(leaf, "compoundUnitPattern") { return true }
    return same(leaf, "perUnitPattern") || same(leaf, "gender") || same(leaf, "unitPrefixPattern") || std.text.startsWith(leaf, "durationUnitPattern")
}

fn contains(text: []const u8, part: []const u8) -> bool {
    var at: usize = 0
    while at + part.length <= text.length {
        if same(text[at..at + part.length], part) { return true }
        at += 1
    }
    return false
}

fn wanted(list: []const []const u8, name: []const u8) -> bool {
    for entry in list {
        if entry.length > 0 && same(entry, name) { return true }
    }
    return false
}

// The files of a package's tarball that are taken.
fn readPackage(path: []const u8) -> void {
    const archive = readWhole(path)
    const size = flate.gzipSize(archive.pointer, archive.length)
    if size == 0 { fail(join("not a gzip file: ", path)) }
    const output = writable(alloc(size + 16))
    if flate.gunzip(archive.pointer, archive.length, output, size) != size { fail(join("damaged: ", path)) }
    var r = tar.reader(output, size)
    var entry: tar.Entry = undefined
    while tar.next(&r, &entry) {
        const name = tar.name(&entry)
        if !endsWith(name, ".json") { continue }
        // package/main/LOCALE/FILE.json, package/supplemental/FILE.json
        var parts: [5][]const u8 = undefined
        var count: usize = 0
        var start: usize = 0
        var at: usize = 0
        while at <= name.length && count < 5 {
            if at == name.length || name[at] == 47 {
                parts[count] = name[start..at]
                count += 1
                start = at + 1
            }
            at += 1
        }
        const text = entry.data[0..entry.size]
        if count == 4 && same(parts[1], "main") {
            const file = parts[3][0..parts[3].length - 5]
            if wanted(MAIN_FILES[0..33], file) { flatten(localeOf(parts[2]), text, 2) }
        } else if count == 3 && same(parts[1], "supplemental") {
            const file = parts[2][0..parts[2].length - 5]
            if wanted(SUPPLEMENTAL_FILES[0..16], file) { flatten(localeOf(SUPPLEMENTAL), text, 1) }
        }
    }
}

// ---------------------------------------------------------------------------
// The calendars' values a type has of the one it takes from.

// The key id of a string that is a key, NONE otherwise.
fn existingKey(text: []const u8) -> u32 {
    var slot = @intCast(usize, hashOf(text) % @intCast(u64, SLOTS))
    while slots[slot] != NONE {
        if same(stringAt[slots[slot]], text) { return keyOfString[slots[slot]] }
        slot = (slot + 1) % SLOTS
    }
    return NONE
}

// The value of LOCALE's KEY in the sorted values, NONE when it has none.
fn valueAt(locale: u64, key: u32) -> u32 {
    const wanted = (locale << 52) | (@intCast(u64, key) << 32)
    var low: usize = 0
    var high = valueCount
    while low < high {
        const middle = low + (high - low) / 2
        if values[middle] < wanted { low = middle + 1 } else { high = middle }
    }
    if low < valueCount && (values[low] >> 32) == (wanted >> 32) { return @intCast(u32, values[low] & 4294967295) }
    return NONE
}

// The tables of a calendar type whose keys say what it has: its eras,
// the skeletons of its patterns and intervals (a type has "yyyyMMMd"
// where the Gregorian calendar has "yMMMd").
fn keptWhole(rest: []const u8) -> bool {
    return std.text.startsWith(rest, "/eras/") || std.text.startsWith(rest, "/dateTimeFormats/availableFormats/") || std.text.startsWith(rest, "/dateTimeFormats/intervalFormats/")
}

// Each value of dates/calendars/TYPE/REST that the same locale has for
// dates/calendars/FALLBACK/REST goes (but those of keptWhole's tables).
fn dropInheritedCalendarValues() -> void {
    const prefix = "dates/calendars/"
    const dropped: [*]bool = unsafe { @ptrFromInt([*]bool, alloc(valueCount + 16)) }
    var index: usize = 0
    while index < valueCount {
        dropped[index] = false
        const v = values[index]
        const key = stringAt[keyString[@intCast(usize, (v >> 32) & 1048575)]]
        if std.text.startsWith(key, prefix) {
            var end = prefix.length
            while end < key.length && key[end] != 47 { end += 1 }
            const kind = key[prefix.length..end]
            const rest = key[end..key.length]
            const fallback = fallbackCalendar(kind)
            if fallback.length > 0 && !keptWhole(rest) {
                const other = existingKey(join(join(prefix, fallback), rest))
                if other != NONE && valueAt(v >> 52, other) == @intCast(u32, v & 4294967295) { dropped[index] = true }
            }
        }
        index += 1
    }
    var kept: usize = 0
    index = 0
    while index < valueCount {
        if !dropped[index] {
            values[kept] = values[index]
            kept += 1
        }
        index += 1
    }
    valueCount = kept
}

// ---------------------------------------------------------------------------
// Sorting: a merge sort of u64 (the values), and one of key ids by their
// strings.

fn sortValues(data: [*]u64, count: usize) -> void {
    const scratch: [*]u64 = unsafe { @ptrFromInt([*]u64, alloc(count * 8 + 8)) }
    var from = data
    var to = scratch
    var width: usize = 1
    while width < count {
        var start: usize = 0
        while start < count {
            const middle = if start + width < count { start + width } else { count }
            const end = if start + 2 * width < count { start + 2 * width } else { count }
            var i = start
            var j = middle
            var k = start
            while k < end {
                if i < middle && (j >= end || from[i] <= from[j]) {
                    to[k] = from[i]
                    i += 1
                } else {
                    to[k] = from[j]
                    j += 1
                }
                k += 1
            }
            start += 2 * width
        }
        const swap = from
        from = to
        to = swap
        width *= 2
    }
    if from != data {
        var index: usize = 0
        while index < count {
            data[index] = from[index]
            index += 1
        }
    }
}

fn sortKeys(order: [*]u32, count: usize) -> void {
    const scratch: [*]u32 = unsafe { @ptrFromInt([*]u32, alloc(count * 4 + 4)) }
    var from = order
    var to = scratch
    var width: usize = 1
    while width < count {
        var start: usize = 0
        while start < count {
            const middle = if start + width < count { start + width } else { count }
            const end = if start + 2 * width < count { start + 2 * width } else { count }
            var i = start
            var j = middle
            var k = start
            while k < end {
                if i < middle && (j >= end || !before(stringAt[keyString[from[j]]], stringAt[keyString[from[i]]])) {
                    to[k] = from[i]
                    i += 1
                } else {
                    to[k] = from[j]
                    j += 1
                }
                k += 1
            }
            start += 2 * width
        }
        const swap = from
        from = to
        to = swap
        width *= 2
    }
    if from != order {
        var index: usize = 0
        while index < count {
            order[index] = from[index]
            index += 1
        }
    }
}

// ---------------------------------------------------------------------------
// Parents.

var parentKeys: [*][]const u8 = undefined
var parentValues: [*][]const u8 = undefined
var parentCount: usize = 0

// The locale a locale inherits from: CLDR's parentLocales, else itself
// without its last subtag (one there is), else und.
fn parentOf(name: []const u8) -> u32 {
    if same(name, "und") || same(name, SUPPLEMENTAL) { return NONE }
    var index: usize = 0
    while index < parentCount {
        if same(parentKeys[index], name) { return findLocale(parentValues[index]) }
        index += 1
    }
    var cut = name.length
    while cut > 0 {
        cut -= 1
        if name[cut] == 45 {
            const shorter = findLocale(name[0..cut])
            if shorter != NONE { return shorter }
        }
    }
    return findLocale("und")
}

fn findLocale(name: []const u8) -> u32 {
    var index: usize = 0
    while index < localeCount {
        if same(localeName[index], name) { return @intCast(u32, index) }
        index += 1
    }
    return NONE
}

// ---------------------------------------------------------------------------
// The file.

var file: [*]u8 = undefined
var fileLength: usize = 0

fn put32(value: u32) -> void {
    file[fileLength] = @intCast(u8, value & 255)
    file[fileLength + 1] = @intCast(u8, (value >> 8) & 255)
    file[fileLength + 2] = @intCast(u8, (value >> 16) & 255)
    file[fileLength + 3] = @intCast(u8, value >> 24)
    fileLength += 4
}

fn set32(at: usize, value: u32) -> void {
    file[at] = @intCast(u8, value & 255)
    file[at + 1] = @intCast(u8, (value >> 8) & 255)
    file[at + 2] = @intCast(u8, (value >> 16) & 255)
    file[at + 3] = @intCast(u8, value >> 24)
}

fn writeWhole(path: []const u8, data: [*]const u8, length: usize) -> void {
    if !std.fs.writeFile(join(path, "").pointer, data, length, 420) { fail(join("cannot write ", path)) }
}

fn generate(directory: []const u8, output: []const u8) -> void {
    unsafe {
        stringAt = @ptrFromInt([*][]const u8, alloc(MAX_STRINGS * 16))
        slots = @ptrFromInt([*]u32, alloc(SLOTS * 4))
        keyOfString = @ptrFromInt([*]u32, alloc(MAX_STRINGS * 4))
        keyString = @ptrFromInt([*]u32, alloc(MAX_KEYS * 4))
        localeName = @ptrFromInt([*][]const u8, alloc(MAX_LOCALES * 16))
        values = @ptrFromInt([*]u64, alloc(MAX_VALUES * 8))
        parentKeys = @ptrFromInt([*][]const u8, alloc(4096 * 16))
        parentValues = @ptrFromInt([*][]const u8, alloc(4096 * 16))
    }
    var index: usize = 0
    while index < SLOTS {
        slots[index] = NONE
        index += 1
    }
    index = 0
    while index < MAX_STRINGS {
        keyOfString[index] = NONE
        index += 1
    }
    // Locale names first, so the empty string is not the first string.
    for name in PACKAGES { readPackage(join(join(join(directory, "/"), name), "-48.0.0.tgz")) }
    sortValues(values, valueCount)
    dropInheritedCalendarValues()

    // The parents CLDR names, from the supplemental data.
    const supplemental = findLocale(SUPPLEMENTAL)
    if supplemental == NONE { fail("no supplemental data") }
    index = 0
    while index < valueCount {
        const v = values[index]
        if @intCast(u32, v >> 52) == supplemental {
            const key = stringAt[keyString[@intCast(usize, (v >> 32) & 1048575)]]
            const prefix = "parentLocales/parentLocale/"
            if std.text.startsWith(key, prefix) && parentCount < 4096 {
                parentKeys[parentCount] = key[prefix.length..key.length]
                parentValues[parentCount] = stringAt[@intCast(usize, v & 4294967295)]
                parentCount += 1
            }
        }
        index += 1
    }

    // Locales in order of their names; keys in order of theirs.
    const localeOrder: [*]u32 = unsafe { @ptrFromInt([*]u32, alloc(localeCount * 4 + 4)) }
    index = 0
    while index < localeCount {
        var at = index
        while at > 0 && before(localeName[index], localeName[localeOrder[at - 1]]) {
            localeOrder[at] = localeOrder[at - 1]
            at -= 1
        }
        localeOrder[at] = @intCast(u32, index)
        index += 1
    }
    const localeRank: [*]u32 = unsafe { @ptrFromInt([*]u32, alloc(localeCount * 4 + 4)) }
    index = 0
    while index < localeCount {
        localeRank[localeOrder[index]] = @intCast(u32, index)
        index += 1
    }
    const keyOrder: [*]u32 = unsafe { @ptrFromInt([*]u32, alloc(keyCount * 4 + 4)) }
    index = 0
    while index < keyCount {
        keyOrder[index] = @intCast(u32, index)
        index += 1
    }
    sortKeys(keyOrder, keyCount)
    const keyRank: [*]u32 = unsafe { @ptrFromInt([*]u32, alloc(keyCount * 4 + 4)) }
    index = 0
    while index < keyCount {
        keyRank[keyOrder[index]] = @intCast(u32, index)
        index += 1
    }

    // Each locale's values as (key rank << 32 | value), sorted, from where
    // they start in `values` (which is in order of locale ids).
    const firstOf: [*]usize = unsafe { @ptrFromInt([*]usize, alloc(localeCount * 8 + 16)) }
    const countOf: [*]usize = unsafe { @ptrFromInt([*]usize, alloc(localeCount * 8 + 16)) }
    const ranked: [*]u64 = unsafe { @ptrFromInt([*]u64, alloc(valueCount * 8 + 8)) }
    index = 0
    while index < localeCount {
        countOf[index] = 0
        index += 1
    }
    index = 0
    while index < valueCount {
        const locale = @intCast(usize, values[index] >> 52)
        if countOf[locale] == 0 { firstOf[locale] = index }
        countOf[locale] += 1
        ranked[index] = (@intCast(u64, keyRank[@intCast(usize, (values[index] >> 32) & 1048575)]) << 32) | (values[index] & 4294967295)
        index += 1
    }
    index = 0
    while index < localeCount {
        if countOf[index] > 0 {
            const view: [*]u64 = unsafe { @ptrFromInt([*]u64, @intFromPtr(ranked) + firstOf[index] * 8) }
            sortValues(view, countOf[index])
        }
        index += 1
    }

    // What each locale keeps: what its parent has otherwise.
    // (Room for the markers too: at most a parent's values each.)
    const kept: [*]u64 = unsafe { @ptrFromInt([*]u64, alloc(valueCount * 16 + 8)) }
    // What a locale has not that its parent has: CLDR's "no value" for it
    // (en-001's short zone names), kept as its marker, which a lookup
    // takes for none.
    const absent = @intCast(u64, intern(ABSENT))
    var keptCount: usize = 0
    const keptFirst: [*]usize = unsafe { @ptrFromInt([*]usize, alloc(localeCount * 8 + 16)) }
    const keptCountOf: [*]usize = unsafe { @ptrFromInt([*]usize, alloc(localeCount * 8 + 16)) }
    const parentIndex: [*]u32 = unsafe { @ptrFromInt([*]u32, alloc(localeCount * 4 + 4)) }
    var rank: usize = 0
    while rank < localeCount {
        const locale = @intCast(usize, localeOrder[rank])
        const parent = parentOf(localeName[locale])
        parentIndex[locale] = parent
        keptFirst[locale] = keptCount
        var i: usize = 0
        var j: usize = 0
        const own: [*]u64 = unsafe { @ptrFromInt([*]u64, @intFromPtr(ranked) + firstOf[locale] * 8) }
        const ownCount = countOf[locale]
        var theirs: [*]u64 = own
        var theirCount: usize = 0
        if parent != NONE {
            unsafe { theirs = @ptrFromInt([*]u64, @intFromPtr(ranked) + firstOf[parent] * 8) }
            theirCount = countOf[parent]
        }
        // The two in order of their keys: what differs is kept, what the
        // parent has alone is marked absent.
        while i < ownCount || j < theirCount {
            const ownKey = if i < ownCount { own[i] >> 32 } else { 4294967295 }
            const theirKey = if j < theirCount { theirs[j] >> 32 } else { 4294967295 }
            if theirKey < ownKey {
                if (theirs[j] & 4294967295) != absent {
                    kept[keptCount] = (theirKey << 32) | absent
                    keptCount += 1
                }
                j += 1
            } else if ownKey < theirKey {
                kept[keptCount] = own[i]
                keptCount += 1
                i += 1
            } else {
                if theirs[j] != own[i] {
                    kept[keptCount] = own[i]
                    keptCount += 1
                }
                i += 1
                j += 1
            }
        }
        keptCountOf[locale] = keptCount - keptFirst[locale]
        rank += 1
    }

    // The strings the file keeps: the locales', the keys', the values'.
    const used: [*]u32 = unsafe { @ptrFromInt([*]u32, alloc(stringCount * 4 + 4)) }
    index = 0
    while index < stringCount {
        used[index] = NONE
        index += 1
    }
    const usedOrder: [*]u32 = unsafe { @ptrFromInt([*]u32, alloc(stringCount * 4 + 4)) }
    var usedCount: usize = 0
    index = 0
    while index < localeCount {
        const id = intern(localeName[localeOrder[index]])
        if used[id] == NONE {
            used[id] = @intCast(u32, usedCount)
            usedOrder[usedCount] = id
            usedCount += 1
        }
        index += 1
    }
    index = 0
    while index < keyCount {
        const id = keyString[keyOrder[index]]
        if used[id] == NONE {
            used[id] = @intCast(u32, usedCount)
            usedOrder[usedCount] = id
            usedCount += 1
        }
        index += 1
    }
    index = 0
    while index < keptCount {
        const id = @intCast(usize, kept[index] & 4294967295)
        if used[id] == NONE {
            used[id] = @intCast(u32, usedCount)
            usedOrder[usedCount] = @intCast(u32, id)
            usedCount += 1
        }
        index += 1
    }
    var stringBytes: usize = 0
    index = 0
    while index < usedCount {
        stringBytes += stringAt[usedOrder[index]].length + 1
        index += 1
    }

    file = writable(alloc(64 + localeCount * 16 + keyCount * 4 + keptCount * 8 + usedCount * 4 + 4 + stringBytes + 64))
    fileLength = 0
    const magic = "MLXCLDR\x00"
    for byte in magic {
        file[fileLength] = byte
        fileLength += 1
    }
    put32(1)
    put32(@intCast(u32, localeCount))
    put32(@intCast(u32, keyCount))
    put32(@intCast(u32, keptCount))
    put32(@intCast(u32, usedCount))
    const sections = fileLength
    index = 0
    while index < 5 {
        put32(0)
        index += 1
    }
    set32(sections, @intCast(u32, fileLength))
    index = 0
    var entryAt: usize = 0
    while index < localeCount {
        const locale = @intCast(usize, localeOrder[index])
        put32(used[intern(localeName[locale])])
        put32(if parentIndex[locale] == NONE { NONE } else { localeRank[parentIndex[locale]] })
        put32(@intCast(u32, entryAt))
        put32(@intCast(u32, keptCountOf[locale]))
        entryAt += keptCountOf[locale]
        index += 1
    }
    set32(sections + 4, @intCast(u32, fileLength))
    index = 0
    while index < keyCount {
        put32(used[keyString[keyOrder[index]]])
        index += 1
    }
    // The entries in the order of the locales.
    set32(sections + 8, @intCast(u32, fileLength))
    index = 0
    while index < localeCount {
        const locale = @intCast(usize, localeOrder[index])
        var e: usize = 0
        while e < keptCountOf[locale] {
            const v = kept[keptFirst[locale] + e]
            put32(@intCast(u32, v >> 32))
            put32(used[@intCast(usize, v & 4294967295)])
            e += 1
        }
        index += 1
    }
    set32(sections + 12, @intCast(u32, fileLength))
    var offset: usize = 0
    index = 0
    while index < usedCount {
        put32(@intCast(u32, offset))
        offset += stringAt[usedOrder[index]].length + 1
        index += 1
    }
    put32(@intCast(u32, offset))
    set32(sections + 16, @intCast(u32, fileLength))
    index = 0
    while index < usedCount {
        for byte in stringAt[usedOrder[index]] {
            file[fileLength] = byte
            fileLength += 1
        }
        file[fileLength] = 0
        fileLength += 1
        index += 1
    }
    writeWhole(output, file, fileLength)
}

fn cString(pointer: [*]const u8) -> []const u8 {
    var length: usize = 0
    while pointer[length] != 0 { length += 1 }
    return pointer[0..length]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    // The crash report before anything else: a crash names the function it
    // was in and its callers, and is kept for MLX Observatory (std.crash).
    _ = crash.install()
    if arguments.length != 3 {
        say("usage: cldr-data PACKAGES-DIRECTORY OUTPUT-FILE\n")
        return 2
    }
    generate(cString(arguments[1]), cString(arguments[2]))
    return 0
}
