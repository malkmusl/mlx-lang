// The tables of std.unicode.charmaps, the single-byte charsets, made
// from their mapping tables (std/registry/unicode/charsets): the Encoding
// Standard's indexes (`index-NAME.txt`, https://encoding.spec.whatwg.org/,
// the pointer of each byte from 0x80 and its code point) and Apple's
// tables of the Mac OS charsets the web still names but the Encoding
// Standard does not (`apple-NAME.TXT`, unicode.org's
// MAPPINGS/VENDORS/APPLE, each byte and its code point):
//
//     charset-generate OUTPUT-FILE TABLE-FILE...
//
// writes OUTPUT-FILE (std/src/unicode/charmaps/tables.mlx): the charsets'
// names, in the order of the files given, and the code points of their
// bytes 0x80 to 0xFF (0 where a byte has none; the bytes below 0x80 are
// ASCII in all of them). `./mlx build unicode-charmaps` runs it on this
// checkout.
const std = @import("std")
const crash = @import("std.crash")

const SYS_exit_group: usize = 231

// The tables are each a few kilobytes; the output a few tens.
const INPUT_SIZE: usize = 65536
const OUTPUT_SIZE: usize = 262144
const MAX_CHARSETS: usize = 64

var input: [65536]u8 = undefined
var output: [262144]u8 = undefined
var outputLength: usize = 0
var names: [4096]u8 = undefined
var namesLength: usize = 0
var codes: [8192]u16 = undefined
var count: usize = 0

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn fail(message: []const u8, detail: []const u8) -> void {
    say("charset-generate: ")
    say(message)
    say(detail)
    say("\n")
    const ignored = std.linux.syscall1(SYS_exit_group, 1)
}

fn emit(text: []const u8) -> void {
    var outputBytes: [*]u8 = undefined
    unsafe { outputBytes = @ptrCast([*]u8, &output) }
    outputLength = std.text.append(outputBytes, outputLength, OUTPUT_SIZE, text)
}

fn emitNumber(value: usize) -> void {
    var outputBytes: [*]u8 = undefined
    unsafe { outputBytes = @ptrCast([*]u8, &output) }
    outputLength = std.text.appendUnsigned(outputBytes, outputLength, OUTPUT_SIZE, value)
}

fn lower(byte: u8) -> u8 { return if byte >= 65 && byte <= 90 { byte + 32 } else { byte } }

fn upper(byte: u8) -> u8 { return if byte >= 97 && byte <= 122 { byte - 32 } else { byte } }

fn addName(text: []const u8) -> void {
    var index: usize = 0
    while index < text.length {
        names[namesLength] = text[index]
        namesLength += 1
        index += 1
    }
    names[namesLength] = 10
    namesLength += 1
}

// The charset's name as the Encoding Standard (and WebKit) spells it:
// IBM866, ISO-8859-N and KOI8-X in capitals, windows-N, macintosh and the
// x-mac- names in small letters; Apple's tables by the names WebKit gives
// them.
fn addNameOf(file: []const u8) -> void {
    var start: usize = 0
    var index: usize = 0
    while index < file.length {
        if file[index] == 47 { start = index + 1 }
        index += 1
    }
    const base = file[start..file.length]
    if std.text.startsWith(base, "apple-") {
        if std.text.same(base, "apple-GREEK.TXT") {
            addName("x-mac-greek")
        } else if std.text.same(base, "apple-CENTEURO.TXT") {
            addName("x-mac-centraleurroman")
        } else if std.text.same(base, "apple-TURKISH.TXT") {
            addName("x-mac-turkish")
        } else {
            fail("no name for ", base)
        }
        return
    }
    if !std.text.startsWith(base, "index-") || !std.text.endsWith(base, ".txt") { fail("not a table: ", base) }
    const stem = base[6..base.length - 4]
    const capitals = std.text.startsWith(stem, "iso-") || std.text.startsWith(stem, "koi8-") || std.text.startsWith(stem, "ibm")
    index = 0
    while index < stem.length {
        names[namesLength] = if capitals { upper(stem[index]) } else { lower(stem[index]) }
        namesLength += 1
        index += 1
    }
    names[namesLength] = 10
    namesLength += 1
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 }

fn hexDigit(byte: u8) -> i32 {
    if byte >= 48 && byte <= 57 { return @intCast(i32, byte) - 48 }
    if byte >= 97 && byte <= 102 { return @intCast(i32, byte) - 87 }
    if byte >= 65 && byte <= 70 { return @intCast(i32, byte) - 55 }
    return -1
}

// A number at `at.*` in `text` (decimal, or hexadecimal after 0x),
// skipping the spaces before it; -1 when there is none.
fn number(text: []const u8, at: *usize) -> i64 {
    while at.* < text.length && isSpace(text[at.*]) { at.* += 1 }
    if at.* >= text.length { return -1 }
    var hex = false
    if at.* + 1 < text.length && text[at.*] == 48 && (text[at.* + 1] == 120 || text[at.* + 1] == 88) {
        hex = true
        at.* += 2
    }
    var value: i64 = 0
    var digits: usize = 0
    while at.* < text.length {
        const digit = hexDigit(text[at.*])
        if digit < 0 || (!hex && digit > 9) { break }
        value = value * (if hex { 16 } else { 10 }) + @intCast(i64, digit)
        digits += 1
        at.* += 1
    }
    return if digits == 0 { -1 } else { value }
}

fn readTable(file: []const u8) -> void {
    if count >= MAX_CHARSETS { fail("too many tables at ", file) }
    var path: [1024]u8 = undefined
    const pathPointer = std.text.zeroTerminated(unsafe { @ptrCast([*]u8, &path) }, 1024, file)
    var inputBytes: [*]u8 = undefined
    unsafe { inputBytes = @ptrCast([*]u8, &input) }
    const length = std.fs.readFileResult(pathPointer, inputBytes, INPUT_SIZE)
    if length < 0 { fail("cannot read ", file) }
    const text = inputBytes[0..@bitCast(usize, length)]
    // Apple's tables give the byte itself; the Encoding Standard's the
    // byte's pointer, from 0x80.
    var first: usize = 0
    while first < file.length && !std.text.startsWith(file[first..file.length], "apple-") { first += 1 }
    const pointers = first >= file.length
    addNameOf(file)
    var index: usize = 0
    while index < 128 {
        codes[count * 128 + index] = 0
        index += 1
    }
    var at: usize = 0
    while at < text.length {
        var end = at
        while end < text.length && text[end] != 10 { end += 1 }
        const line = text[at..end]
        at = end + 1
        if line.length == 0 || line[0] == 35 { continue }
        var position: usize = 0
        const pointer = number(line, &position)
        const code = number(line, &position)
        if pointer < 0 || code < 0 { continue }
        const byte = if pointers { pointer + 128 } else { pointer }
        // (Apple's tables list the ASCII bytes too: they are ASCII.)
        if byte < 128 {
            if byte != code { fail("a byte below 0x80 is not ASCII in ", file) }
            continue
        }
        if byte > 255 || code > 65535 || code == 0 { fail("a byte out of range in ", file) }
        codes[count * 128 + @intCast(usize, byte - 128)] = @intCast(u16, code)
    }
    count += 1
}

fn generate(target: []const u8) -> void {
    emit("// The tables of std.unicode.charmaps (the single-byte charsets), made by\n")
    emit("// std/registry/unicode/charsetgenerate.mlx from their mapping tables\n")
    emit("// (std/registry/unicode/charsets): do not edit; `./mlx build\n")
    emit("// unicode-charmaps` makes them again.\n\n")
    emit("pub const COUNT: usize = ")
    emitNumber(count)
    emit("\n\n// Their names, a line each, in the order of the tables.\n")
    emit("pub const NAMES: []const u8 = \"")
    var index: usize = 0
    while index < namesLength {
        if names[index] == 10 { emit("\\n") } else { emit(names[index..index + 1]) }
        index += 1
    }
    emit("\"\n\n// The code point of each byte from 0x80 to 0xFF, 128 a charset (0: none).\n")
    emit("pub var UPPER: [")
    emitNumber(count * 128)
    emit("]u16 = [")
    emitNumber(count * 128)
    emit("]u16{\n")
    index = 0
    while index < count * 128 {
        if index % 16 == 0 { emit("    ") }
        emitNumber(@intCast(usize, codes[index]))
        emit(if index % 16 == 15 { ",\n" } else { ", " })
        index += 1
    }
    emit("}\n")
    var path: [1024]u8 = undefined
    const pathPointer = std.text.zeroTerminated(unsafe { @ptrCast([*]u8, &path) }, 1024, target)
    var outputBytes: [*]u8 = undefined
    unsafe { outputBytes = @ptrCast([*]u8, &output) }
    if !std.fs.writeFile(pathPointer, outputBytes, outputLength, 420) { fail("cannot write ", target) }
}

pub fn main(arguments: [][*]const u8) -> u8 {
    // The crash report before anything else: a crash names the function it
    // was in and its callers, and is kept for MLX Observatory (std.crash).
    _ = crash.install()
    if arguments.length < 3 {
        say("usage: charset-generate OUTPUT-FILE TABLE-FILE...\n")
        return 2
    }
    var index: usize = 2
    while index < arguments.length {
        readTable(std.text.cString(arguments[index]))
        index += 1
    }
    generate(std.text.cString(arguments[1]))
    return 0
}
