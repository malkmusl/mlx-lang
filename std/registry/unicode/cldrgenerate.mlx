// The locale data of std.unicode, made from the Unicode Common Locale
// Data Repository (std/registry/unicode/cldr, CLDR's JSON):
//
//     cldr-generate CLDR-DIRECTORY OUTPUT-FILE
//
// writes OUTPUT-FILE (std/src/unicode/locale/data.mlx): the likely subtags,
// the aliases of languages, scripts, regions and variants, the BCP 47
// keys and types of the -u- and -t- extensions with their legacy names
// (and the types' preferred replacements), and the locales CLDR has data
// for. Each table is sorted text: `NAME_KEYS`, `NAME_VALUES` (each entry
// ended by a NUL, so that each is a C string) and where each begins
// (`NAME_KEYS_STARTS`, `NAME_VALUES_STARTS`). `./mlx build
// unicode-locales` runs it.
const std = @import("std")
const json = @import("std.json")

const SYS_read: usize = 0
const SYS_write: usize = 1
const SYS_open: usize = 2
const SYS_close: usize = 3
const SYS_mmap: usize = 9
const SYS_exit_group: usize = 231
const O_RDONLY: usize = 0
const O_WRITE_NEW: usize = 577

// ---------------------------------------------------------------------------
// Memory, files, output

var arenaNext: usize = 0
var arenaEnd: usize = 0

fn alloc(size: usize) -> usize {
    if arenaNext == 0 {
        const reserved = std.linux.syscall6(SYS_mmap, 0, 4294967296, 3, 16418, @bitCast(usize, @intCast(isize, -1)), 0)
        if reserved < 0 { fail("no memory") }
        arenaNext = @bitCast(usize, reserved)
        arenaEnd = arenaNext + 4294967296
    }
    const at = (arenaNext + 15) / 16 * 16
    if at + size > arenaEnd { fail("out of memory") }
    arenaNext = at + size
    return at
}

fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }

fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn fail(message: []const u8) -> void {
    say("cldr-generate: ")
    say(message)
    say("\n")
    const ignored = std.linux.syscall1(SYS_exit_group, 1)
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool { return text.length >= prefix.length && same(text[0..prefix.length], prefix) }

fn before(first: []const u8, second: []const u8) -> bool {
    var index: usize = 0
    while index < first.length && index < second.length {
        if first[index] != second[index] { return first[index] < second[index] }
        index += 1
    }
    return first.length < second.length
}

fn copy(text: []const u8) -> []const u8 {
    const at = alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        put8(at + index, text[index])
        index += 1
    }
    return bytes(at, text.length)
}

fn join(first: []const u8, second: []const u8) -> []const u8 {
    const at = alloc(first.length + second.length + 1)
    var index: usize = 0
    while index < first.length {
        put8(at + index, first[index])
        index += 1
    }
    index = 0
    while index < second.length {
        put8(at + first.length + index, second[index])
        index += 1
    }
    return bytes(at, first.length + second.length)
}

fn lowered(text: []const u8) -> []const u8 {
    const at = alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        const c = text[index]
        put8(at + index, if c >= 65 && c <= 90 { c + 32 } else { c })
        index += 1
    }
    return bytes(at, text.length)
}

// `-` as `_`.
fn underscored(text: []const u8) -> []const u8 {
    const at = alloc(text.length + 1)
    var index: usize = 0
    while index < text.length {
        put8(at + index, if text[index] == 45 { 95 } else { text[index] })
        index += 1
    }
    return bytes(at, text.length)
}

fn readWhole(path: []const u8) -> []const u8 {
    const name = join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_RDONLY, 0)
    if descriptor < 0 { fail(join("cannot read ", path)) }
    const capacity: usize = 16777216
    const data = alloc(capacity)
    var length: usize = 0
    while length < capacity {
        const count = std.linux.syscall3(SYS_read, @bitCast(usize, descriptor), data + length, capacity - length)
        if count <= 0 { break }
        length += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
    return bytes(data, length)
}

fn writeWhole(path: []const u8, text: []const u8) -> void {
    const name = join(path, "")
    const descriptor = std.linux.syscall3(SYS_open, @intFromPtr(name.pointer), O_WRITE_NEW, 420)
    if descriptor < 0 { fail(join("cannot write ", path)) }
    var done: usize = 0
    while done < text.length {
        const count = std.linux.syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(text.pointer) + done, text.length - done)
        if count <= 0 { fail(join("cannot write ", path)) }
        done += @intCast(usize, count)
    }
    const closed = std.linux.syscall1(SYS_close, @bitCast(usize, descriptor))
}

const OUT_SIZE: usize = 67108864
var outBase: usize = 0
var outTop: usize = 0

fn out(text: []const u8) -> void {
    if outBase == 0 { outBase = alloc(OUT_SIZE) }
    if outTop + text.length > OUT_SIZE { fail("the output is too large") }
    var index: usize = 0
    while index < text.length {
        put8(outBase + outTop + index, text[index])
        index += 1
    }
    outTop += text.length
}

fn outNumber(value: usize) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    out(view[24 - count..24])
}

// A string literal's content: `"` and `\` escaped.
fn outEscaped(text: []const u8) -> void {
    for byte in text {
        if byte == 34 || byte == 92 {
            out("\\")
            put8(outBase + outTop, byte)
            outTop += 1
        } else {
            put8(outBase + outTop, byte)
            outTop += 1
        }
    }
}

// ---------------------------------------------------------------------------
// JSON flattened: every string (and `true`) leaf with its path of keys
// (array elements share their array's path).

const Leaf = struct {
    path: []const u8
    value: []const u8
}

var leaves: [*]Leaf = undefined
var leafCount: usize = 0

fn flatten(text: []const u8) -> void {
    var tokenizer: json.Tokenizer = undefined
    json.initAt(&tokenizer, text.pointer, text.length)
    var token: json.Token = undefined
    // The keys of the open objects (an array adds no key).
    var keys: [64][]const u8 = undefined
    var isArray: [64]bool = undefined
    var depth: usize = 0
    var pending: []const u8 = ""
    var hasPending = false
    while json.next(&tokenizer, &token) {
        const kind = token.kind
        if kind == json.TokenKind.key {
            pending = copy(token.value.pointer[0..token.value.length])
            hasPending = true
            continue
        }
        if kind == json.TokenKind.objectStart || kind == json.TokenKind.arrayStart {
            keys[depth] = if hasPending { pending } else { "" }
            isArray[depth] = kind == json.TokenKind.arrayStart
            depth += 1
            hasPending = false
            continue
        }
        if kind == json.TokenKind.objectEnd || kind == json.TokenKind.arrayEnd {
            depth -= 1
            continue
        }
        // A value: its path is the open keys and the pending one.
        var path: []const u8 = ""
        var level: usize = 1
        while level < depth {
            if keys[level].length > 0 { path = if path.length == 0 { keys[level] } else { join(join(path, "/"), keys[level]) } }
            level += 1
        }
        if hasPending { path = if path.length == 0 { pending } else { join(join(path, "/"), pending) } }
        hasPending = false
        var value: []const u8 = ""
        if kind == json.TokenKind.string {
            const raw = token.value
            const at = alloc(raw.length + 1)
            var view: [*]u8 = undefined
            unsafe { view = @ptrFromInt([*]u8, at) }
            const length = json.decodeString(raw, view, raw.length + 1)
            if length < 0 { fail("a bad string") }
            value = bytes(at, @intCast(usize, length))
        } else if kind == json.TokenKind.trueValue {
            value = "true"
        } else {
            continue
        }
        if leafCount >= 262144 { fail("too many values") }
        leaves[leafCount] = Leaf.{ .path = path, .value = value }
        leafCount += 1
    }
    if json.failed(&tokenizer) { fail(json.errorMessage(json.errorCode(&tokenizer))) }
}

fn read(directory: []const u8, name: []const u8) -> void {
    leafCount = 0
    flatten(readWhole(join(join(directory, "/"), name)))
}

// ---------------------------------------------------------------------------
// Tables: pairs of text, sorted by key.

const Table = struct {
    keys: [*][]const u8
    values: [*][]const u8
    count: usize
}

fn table() -> Table {
    var t = Table.{ .keys = undefined, .values = undefined, .count = 0 }
    unsafe {
        t.keys = @ptrFromInt([*][]const u8, alloc(65536 * 16))
        t.values = @ptrFromInt([*][]const u8, alloc(65536 * 16))
    }
    return t
}

fn add(t: *Table, key: []const u8, value: []const u8) -> void {
    if t.*.count >= 65536 { fail("a table too large") }
    t.*.keys[t.*.count] = key
    t.*.values[t.*.count] = value
    t.*.count += 1
}

// Sorted by key (a merge sort through a second pair of arrays, stable);
// of equal keys the last added stays (a type's legacy alias over its
// own name).
fn sort(t: *Table) -> void {
    var scratchKeys: [*][]const u8 = undefined
    var scratchValues: [*][]const u8 = undefined
    unsafe {
        scratchKeys = @ptrFromInt([*][]const u8, alloc(t.*.count * 16 + 16))
        scratchValues = @ptrFromInt([*][]const u8, alloc(t.*.count * 16 + 16))
    }
    var width: usize = 1
    while width < t.*.count {
        var start: usize = 0
        while start < t.*.count {
            const middle = if start + width < t.*.count { start + width } else { t.*.count }
            const end = if start + 2 * width < t.*.count { start + 2 * width } else { t.*.count }
            var i = start
            var j = middle
            var k = start
            while k < end {
                if i < middle && (j >= end || !before(t.*.keys[j], t.*.keys[i])) {
                    scratchKeys[k] = t.*.keys[i]
                    scratchValues[k] = t.*.values[i]
                    i += 1
                } else {
                    scratchKeys[k] = t.*.keys[j]
                    scratchValues[k] = t.*.values[j]
                    j += 1
                }
                k += 1
            }
            start += 2 * width
        }
        var index: usize = 0
        while index < t.*.count {
            t.*.keys[index] = scratchKeys[index]
            t.*.values[index] = scratchValues[index]
            index += 1
        }
        width *= 2
    }
    // Duplicates: the last stays.
    var kept: usize = 0
    var index: usize = 0
    while index < t.*.count {
        if kept > 0 && same(t.*.keys[kept - 1], t.*.keys[index]) {
            t.*.values[kept - 1] = t.*.values[index]
        } else {
            t.*.keys[kept] = t.*.keys[index]
            t.*.values[kept] = t.*.values[index]
            kept += 1
        }
        index += 1
    }
    t.*.count = kept
}

fn outText(name: []const u8, items: [*][]const u8, count: usize) -> void {
    out("pub const ")
    out(name)
    out(": []const u8 = \"")
    var index: usize = 0
    while index < count {
        outEscaped(items[index])
        out("\\0")
        index += 1
    }
    out("\"\n")
    out("pub var ")
    out(name)
    out("_STARTS: [")
    outNumber(count + 1)
    out("]u32 = [")
    outNumber(count + 1)
    out("]u32{")
    var offset: usize = 0
    index = 0
    while index <= count {
        if index % 16 == 0 { out("\n    ") } else { out(" ") }
        outNumber(offset)
        out(",")
        if index < count { offset += items[index].length + 1 }
        index += 1
    }
    out("\n}\n")
}

fn outTable(name: []const u8, t: *Table) -> void {
    sort(t)
    out("pub const ")
    out(name)
    out("_COUNT: usize = ")
    outNumber(t.*.count)
    out("\n")
    outText(join(name, "_KEYS"), t.*.keys, t.*.count)
    outText(join(name, "_VALUES"), t.*.values, t.*.count)
    out("\n")
}

// ---------------------------------------------------------------------------

// The part of `path` after `prefix` when it has no further `/`; "".
fn under(path: []const u8, prefix: []const u8) -> []const u8 {
    if !startsWith(path, prefix) { return "" }
    const rest = path[prefix.length..path.length]
    for byte in rest {
        if byte == 47 { return "" }
    }
    return rest
}

// The part of `path` between `prefix` and `/suffix`; "".
fn between(path: []const u8, prefix: []const u8, suffix: []const u8) -> []const u8 {
    if !startsWith(path, prefix) || path.length < prefix.length + suffix.length + 1 { return "" }
    const end = path.length - suffix.length
    if !same(path[end..path.length], suffix) || path[end - 1] != 47 { return "" }
    const middle = path[prefix.length..end - 1]
    for byte in middle {
        if byte == 47 { return "" }
    }
    return middle
}

const BCP47_FILES: [16][]const u8 = [16][]const u8{
    "bcp47-calendar.json", "bcp47-collation.json", "bcp47-currency.json", "bcp47-measure.json",
    "bcp47-number.json", "bcp47-segmentation.json", "bcp47-timezone.json", "bcp47-transform.json",
    "bcp47-transform_hybrid.json", "bcp47-transform_ime.json", "bcp47-transform_keyboard.json", "bcp47-transform_mt.json",
    "bcp47-transform_private_use.json", "bcp47-variant.json", "", "",
}

fn generate(directory: []const u8, output: []const u8) -> void {
    unsafe { leaves = @ptrFromInt([*]Leaf, alloc(262144 * @sizeOf(Leaf))) }

    // Likely subtags.
    var likely = table()
    read(directory, "likelySubtags.json")
    var index: usize = 0
    while index < leafCount {
        const key = under(leaves[index].path, "supplemental/likelySubtags/")
        if key.length > 0 { add(&likely, underscored(key), underscored(leaves[index].value)) }
        index += 1
    }

    // Aliases: their replacements.
    var languages = table()
    var scripts = table()
    var territories = table()
    var variants = table()
    var languagesOverlong = table()
    var territoriesOverlong = table()
    read(directory, "aliases.json")
    index = 0
    while index < leafCount {
        const path = leaves[index].path
        const value = leaves[index].value
        var key = between(path, "supplemental/metadata/alias/languageAlias/", "_replacement")
        if key.length > 0 { add(&languages, underscored(key), underscored(value)) }
        key = between(path, "supplemental/metadata/alias/scriptAlias/", "_replacement")
        if key.length > 0 { add(&scripts, key, value) }
        key = between(path, "supplemental/metadata/alias/territoryAlias/", "_replacement")
        if key.length > 0 { add(&territories, key, value) }
        key = between(path, "supplemental/metadata/alias/variantAlias/", "_replacement")
        if key.length > 0 { add(&variants, lowered(key), lowered(value)) }
        // The three-letter codes of the two-letter ones (ISO 639-2, 3166
        // alpha-3).
        if index + 1 < leafCount && same(value, "overlong") {
            const next = leaves[index + 1]
            key = between(path, "supplemental/metadata/alias/languageAlias/", "_reason")
            if key.length == 3 && same(next.path, join(join("supplemental/metadata/alias/languageAlias/", key), "/_replacement")) && next.value.length == 2 { add(&languagesOverlong, key, next.value) }
            key = between(path, "supplemental/metadata/alias/territoryAlias/", "_reason")
            if key.length == 3 && key[0] >= 65 && same(next.path, join(join("supplemental/metadata/alias/territoryAlias/", key), "/_replacement")) && next.value.length == 2 { add(&territoriesOverlong, key, next.value) }
        }
        if index > 0 && same(value, "overlong") {
            const previous = leaves[index - 1]
            key = between(path, "supplemental/metadata/alias/languageAlias/", "_reason")
            if key.length == 3 && same(previous.path, join(join("supplemental/metadata/alias/languageAlias/", key), "/_replacement")) && previous.value.length == 2 { add(&languagesOverlong, key, previous.value) }
            key = between(path, "supplemental/metadata/alias/territoryAlias/", "_reason")
            if key.length == 3 && key[0] >= 65 && same(previous.path, join(join("supplemental/metadata/alias/territoryAlias/", key), "/_replacement")) && previous.value.length == 2 { add(&territoriesOverlong, key, previous.value) }
        }
        index += 1
    }

    // BCP 47: keys (KEY/legacy), types (key/type: legacy, the first of
    // its aliases), the legacy names back (legacy key/legacy type: key/
    // type), deprecated types' preferred ones, and the keys whose types
    // are a kind of value (CODEPOINTS...).
    var keys = table()
    var legacyKeys = table()
    var types = table()
    var legacyTypes = table()
    var preferred = table()
    var specials = table()
    const files = BCP47_FILES
    var file: usize = 0
    while file < 14 {
        read(directory, files[file])
        index = 0
        while index < leafCount {
            const path = leaves[index].path
            const value = leaves[index].value
            // keyword/EXT/KEY/_alias or keyword/EXT/KEY/TYPE/_alias.
            if startsWith(path, "keyword/") && path.length > 10 {
                const rest = path[10..path.length]
                var slash: usize = 0
                while slash < rest.length && rest[slash] != 47 { slash += 1 }
                const key = lowered(rest[0..slash])
                const after = if slash < rest.length { rest[slash + 1..rest.length] } else { "" }
                if same(after, "_alias") {
                    add(&keys, key, lowered(value))
                    add(&legacyKeys, lowered(value), key)
                } else {
                    var second: usize = 0
                    while second < after.length && after[second] != 47 { second += 1 }
                    const kind = after[0..second]
                    const field = if second < after.length { after[second + 1..after.length] } else { "" }
                    if kind.length > 0 && kind[0] != 95 {
                        if kind.length > 3 && kind[0] >= 65 && kind[0] <= 90 && same(field, "_description") {
                            add(&specials, key, kind)
                        } else if kind[0] < 65 || kind[0] > 90 {
                            const typeKey = join(join(key, "/"), lowered(kind))
                            if same(field, "_description") { add(&types, typeKey, lowered(kind)) }
                            if same(field, "_alias") {
                                // Aliases separated by spaces: the first is
                                // the legacy name, all name the type.
                                var start: usize = 0
                                var at: usize = 0
                                while at <= value.length {
                                    if at == value.length || value[at] == 32 {
                                        if at > start {
                                            const alias = lowered(value[start..at])
                                            if start == 0 { add(&types, typeKey, copy(value[start..at])) }
                                            add(&legacyTypes, join(join(key, "/"), alias), lowered(kind))
                                        }
                                        start = at + 1
                                    }
                                    at += 1
                                }
                            }
                            if same(field, "_preferred") { add(&preferred, typeKey, lowered(value)) }
                        }
                    }
                }
            }
            index += 1
        }
        file += 1
    }
    // Each region's ISO 3166 alpha-3 code (the private-use ones left out).
    var alpha3 = table()
    read(directory, "codeMappings.json")
    index = 0
    while index < leafCount {
        const region = between(leaves[index].path, "supplemental/codeMappings/", "_alpha3")
        const code = leaves[index].value
        const privateUse = code.length == 3 && (same(code, "AAA") || same(code, "ZZZ") || code[0] == 81 || code[0] == 88)
        if region.length > 0 && !privateUse { add(&alpha3, region, code) }
        index += 1
    }
    var available = table()
    read(directory, "availableLocales.json")
    index = 0
    while index < leafCount {
        if same(leaves[index].path, "availableLocales/full") {
            const name = underscored(leaves[index].value)
            add(&available, name, name)
        }
        index += 1
    }

    out("// The locale data of std.unicode: made by cldr-generate\n")
    out("// (std/registry/unicode/cldrgenerate.mlx) from CLDR\n")
    out("// (std/registry/unicode/cldr); do not edit. Each table is sorted text,\n")
    out("// each entry ended by a NUL; *_STARTS say where each begins. Locale IDs are\n")
    out("// ICU's (`_`), BCP 47 keys and types lower case.\n\n")
    outTable("LIKELY", &likely)
    outTable("LANGUAGE_ALIAS", &languages)
    outTable("SCRIPT_ALIAS", &scripts)
    outTable("TERRITORY_ALIAS", &territories)
    outTable("VARIANT_ALIAS", &variants)
    outTable("LANGUAGE_OVERLONG", &languagesOverlong)
    outTable("TERRITORY_OVERLONG", &territoriesOverlong)
    outTable("KEY", &keys)
    outTable("LEGACY_KEY", &legacyKeys)
    outTable("TYPE", &types)
    outTable("LEGACY_TYPE", &legacyTypes)
    outTable("PREFERRED_TYPE", &preferred)
    outTable("SPECIAL_TYPE", &specials)
    outTable("ALPHA3", &alpha3)
    outTable("AVAILABLE", &available)
    writeWhole(output, bytes(outBase, outTop))
}

fn cString(pointer: [*]const u8) -> []const u8 {
    var length: usize = 0
    while pointer[length] != 0 { length += 1 }
    return pointer[0..length]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 3 {
        say("usage: cldr-generate CLDR-DIRECTORY OUTPUT-FILE\n")
        return 2
    }
    generate(cString(arguments[1]), cString(arguments[2]))
    return 0
}
