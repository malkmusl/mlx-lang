    "INSCRIPTIONAL_PARTHIAN", "Samr", "SAMARITAN", "Tavt", "TAI_VIET", "Zmth", "MATHEMATICAL_NOTATION", "Zsym",
    "SYMBOLS", "Bamu", "BAMUM", "Lisu", "LISU", "Nkgb", "NAKHI_GEBA", "Sarb", "OLD_SOUTH_ARABIAN", "Bass", "BASSA_VAH",
    "Dupl", "DUPLOYAN", "Elba", "ELBASAN", "Gran", "GRANTHA", "Kpel", "KPELLE", "Loma", "LOMA", "Mend", "MENDE",
    "Merc", "MEROITIC_CURSIVE", "Narb", "OLD_NORTH_ARABIAN", "Nbat", "NABATAEAN", "Palm", "PALMYRENE", "Sind",
    "KHUDAWADI", "Wara", "WARANG_CITI", "Afak", "AFAKA", "Jurc", "JURCHEN", "Mroo", "MRO", "Nshu", "NUSHU", "Shrd",
    "SHARADA", "Sora", "SORA_SOMPENG", "Takr", "TAKRI", "Tang", "TANGUT", "Wole", "WOLEAI", "Hluw",
    "ANATOLIAN_HIEROGLYPHS", "Khoj", "KHOJKI", "Tirh", "TIRHUTA", "Aghb", "CAUCASIAN_ALBANIAN", "Mahj", "MAHAJANI",
    "Ahom", "AHOM", "Hatr", "HATRAN", "Modi", "MODI", "Mult", "MULTANI", "Pauc", "PAU_CIN_HAU", "Sidd", "SIDDHAM",
    "Adlm", "ADLAM", "Bhks", "BHAIKSUKI", "Marc", "MARCHEN", "Newa", "NEWA", "Osge", "OSAGE", "Hanb",
    "HAN_WITH_BOPOMOFO", "Jamo", "JAMO", "Zsye", "SYMBOLS_EMOJI", "Gonm", "MASARAM_GONDI", "Soyo", "SOYOMBO", "Zanb",
    "ZANABAZAR_SQUARE", "Dogr", "DOGRA", "Gong", "GUNJALA_GONDI", "Maka", "MAKASAR", "Medf", "MEDEFAIDRIN", "Rohg",
    "HANIFI_ROHINGYA", "Sogd", "SOGDIAN", "Sogo", "OLD_SOGDIAN", "Elym", "ELYMAIC", "Hmnp", "NYIAKENG_PUACHUE_HMONG",
    "Nand", "NANDINAGARI", "Wcho", "WANCHO", "Chrs", "CHORASMIAN", "Diak", "DIVES_AKURU", "Kits",
    "KHITAN_SMALL_SCRIPT", "Yezi", "YEZIDI", "Cpmn", "CYPRO_MINOAN", "Ougr", "OLD_UYGHUR", "Tnsa", "TANGSA", "Toto",
    "TOTO", "Vith", "VITHKUQI", "Kawi", "KAWI", "Nagm", "NAG_MUNDARI", "Gara", "GARAY", "Gukh", "GURUNG_KHEMA", "Krai",
    "KIRAT_RAI", "Onao", "OL_ONAL", "Sunu", "SUNUWAR", "Todr", "TODHRI", "Tutg", "TULU_TIGALARI"
}
// Other names C knows a script by.
const SCRIPT_ALIASES = [6][]const u8{ "ORKHON", "Orkh", "MEROITIC", "Mero", "PHONETIC_POLLARD", "Plrd" }

var scriptCount: usize = 0
// By number: the short name, the long name, the C name.
var scriptShort: usize = 0
var scriptLong: usize = 0
var scriptName: usize = 0

fn putSlice(table: usize, index: usize, value: []const u8) -> void {
    putWord(table + index * 16, @intFromPtr(value.pointer))
    putWord(table + index * 16 + 8, value.length)
}

fn getSlice(table: usize, index: usize) -> []const u8 { return bytes(getWord(table + index * 16), getWord(table + index * 16 + 8)) }

// NAME as C spells it: upper case, `_` for what is not a letter or digit.
fn cName(name: []const u8) -> []const u8 {
    const at = alloc(name.length + 1)
    var index: usize = 0
    while index < name.length {
        var byte = name[index]
        if byte >= 97 && byte <= 122 { byte -= 32 }
        if !((byte >= 65 && byte <= 90) || (byte >= 48 && byte <= 57)) { byte = 95 }
        put8(at + index, byte)
        index += 1
    }
    return bytes(at, name.length)
}

fn addScript(short: []const u8, long: []const u8, name: []const u8) -> void {
    putSlice(scriptShort, scriptCount, short)
    putSlice(scriptLong, scriptCount, long)
    putSlice(scriptName, scriptCount, name)
    scriptCount += 1
}

fn readScripts() -> void {
    scriptShort = alloc(512 * 16)
    scriptLong = alloc(512 * 16)
    scriptName = alloc(512 * 16)
    const icu = ICU_SCRIPTS[0..414]
    var index: usize = 0
    while index + 1 < icu.length {
        // The long name, when the script has code points.
        var long: []const u8 = ""
        var line: usize = 0
        while line < aliasCount {
            if same(aliasField(line, 0), "sc") && same(aliasField(line, 1), icu[index]) { long = aliasField(line, 2) }
            line += 1
        }
        addScript(icu[index], long, icu[index + 1])
        index += 2
    }
    // Every script of the database has its number.
    var line: usize = 0
    while line < aliasCount {
        if same(aliasField(line, 0), "sc") {
            const short = aliasField(line, 1)
            var known = false
            index = 0
            while index < scriptCount {
                if same(getSlice(scriptShort, index), short) { known = true }
                index += 1
            }
            if !known { fail(join("a script ICU does not number: ", short)) }
        }
        line += 1
    }
}

fn scriptIndex(name: []const u8) -> usize {
    var index: usize = 0
    while index < scriptCount {
        if same(getSlice(scriptShort, index), name) || same(getSlice(scriptLong, index), name) { return index }
        index += 1
    }
    // An alias (Qaai for Inherited, Qaac for Coptic).
    const short = shortName("sc", name)
    if short.length > 0 && !same(short, name) { return scriptIndex(short) }
    fail(join("no script ", name))
    return 0
}

// The blocks of Blocks.txt, numbered from 1 (0: none).
var blockCount: usize = 0
var blockFirst: usize = 0
var blockLast: usize = 0
var blockName: usize = 0

fn readBlocks() -> void {
    blockFirst = alloc(1024 * 4)
    blockLast = alloc(1024 * 4)
    blockName = alloc(1024 * 16)
    begin("Blocks.txt")
    while next() {
        if missing { continue }
        put32(blockFirst + blockCount * 4, @intCast(u32, first))
        put32(blockLast + blockCount * 4, @intCast(u32, last))
        putSlice(blockName, blockCount, cName(field(1)))
        blockCount += 1
    }
}

// ---------------------------------------------------------------------------
// The properties of each code point.

var gc: usize = 0
var bc: usize = 0
var ccc: usize = 0
var lb: usize = 0
var gcb: usize = 0
var wb: usize = 0
var sb: usize = 0
var ea: usize = 0
var hst: usize = 0
var jt: usize = 0
var nt: usize = 0
var dt: usize = 0
var bpt: usize = 0
var vo: usize = 0
var incb: usize = 0
var sc: usize = 0
var nfcqc: usize = 0
var nfkcqc: usize = 0
var nfdqc: usize = 0
var nfkdqc: usize = 0
var bits0: usize = 0
var bits1: usize = 0
var upper: usize = 0
var lower: usize = 0
var title: usize = 0
var fold: usize = 0
var mirror: usize = 0
var bracket: usize = 0
var caseFlags: usize = 0
// The numeric values: each code point's number in the list (0: none),
// the list's numerators and denominators.
var numeric: usize = 0
var numericCount: usize = 0
var numerators: usize = 0
var denominators: usize = 0

fn fill(array: usize, from: usize, to: usize, value: usize) -> void {
    var code = from
    while code <= to {
        put8(array + code, @intCast(u8, value))
        code += 1
    }
}

fn setBit(code: usize, bit: usize) -> void {
    if bit < 64 {
        put64(bits0 + code * 8, get64(bits0 + code * 8) | (@intCast(u64, 1) << @intCast(u6, bit)))
    } else {
        put64(bits1 + code * 8, get64(bits1 + code * 8) | (@intCast(u64, 1) << @intCast(u6, bit - 64)))
    }
}

fn hasBit(code: usize, bit: usize) -> bool {
    if bit < 64 { return ((get64(bits0 + code * 8) >> @intCast(u6, bit)) & 1) != 0 }
    return ((get64(bits1 + code * 8) >> @intCast(u6, bit - 64)) & 1) != 0
}

// An enumerated property from a file whose second field is the value.
fn enumerated(file: []const u8, property: []const u8, order: []const []const u8, array: usize) -> void {
    begin(file)
    while next() { fill(array, first, last, valueIndex(property, order, field(1))) }
}

// The binary properties a file lists (`CODE ; Name`).
fn binaries(file: []const u8) -> void {
    // (A constant array named in a loop is made again each time round:
    // once here.)
    const names = BINARY[0..76]
    begin(file)
    while next() {
        if missing { continue }
        const name = field(1)
        var bit: usize = 0
        while bit < names.length {
            if names[bit].length > 0 && same(names[bit], name) {
                var code = first
                while code <= last {
                    setBit(code, bit)
                    code += 1
                }
            }
            bit += 1
        }
    }
}

// The decompositions (UnicodeData.txt's sixth field): code, whether
// compatibility, the code points.
var decompositionCount: usize = 0
var decompositionCode: usize = 0
var decompositionInfo: usize = 0
var decompositionData: usize = 0
var decompositionLength: usize = 0

// The full case mappings and foldings: code, then lower/title/upper (or
// the folding) as offset << 8 | length into the data.
var specialCount: usize = 0
var specialCode: usize = 0
var specialLower: usize = 0
var specialTitle: usize = 0
var specialUpper: usize = 0
var specialData: usize = 0
var specialLength: usize = 0
var foldCount: usize = 0
var foldCode: usize = 0
var foldInfo: usize = 0
var foldData: usize = 0
var foldLength: usize = 0

fn signedDelta(to: usize, from: usize) -> u32 { return @bitCast(u32, @intCast(i32, @intCast(isize, to) - @intCast(isize, from))) }

fn readUnicodeData() -> void {
    decompositionCode = alloc(16384 * 4)
    decompositionInfo = alloc(16384 * 4)
    decompositionData = alloc(65536 * 4)
    begin("UnicodeData.txt")
    const scratch = alloc(64 * 4)
    const tags = DT_TAGS[0..18]
    while next() {
        if missing { continue }
        const code = first
        const mapping = field(5)
        if mapping.length > 0 {
            var kind: usize = 1
            var rest = mapping
            if mapping[0] == 60 {
                var close: usize = 0
                while mapping[close] != 62 { close += 1 }
                const tag = mapping[0..close + 1]
                kind = 0
                var index: usize = 2
                while index < tags.length {
                    if same(tags[index], tag) { kind = index }
                    index += 1
                }
                if kind == 0 { fail(join("unknown decomposition tag ", tag)) }
                rest = mapping[close + 1..mapping.length]
            }
            put8(dt + code, @intCast(u8, kind))
            const count = codes(rest, scratch)
            put32(decompositionCode + decompositionCount * 4, @intCast(u32, code))
            const compat: u32 = if kind != 1 { 2147483648 } else { 0 }
            put32(decompositionInfo + decompositionCount * 4, compat | (@intCast(u32, count) << 24) | @intCast(u32, decompositionLength))
            var index: usize = 0
            while index < count {
                put32(decompositionData + decompositionLength * 4, get32(scratch + index * 4))
                decompositionLength += 1
                index += 1
            }
            decompositionCount += 1
        }
        if field(12).length > 0 { put32(upper + code * 4, signedDelta(hex(field(12)), code)) }
        if field(13).length > 0 { put32(lower + code * 4, signedDelta(hex(field(13)), code)) }
        if field(14).length > 0 {
            put32(title + code * 4, signedDelta(hex(field(14)), code))
        } else {
            put32(title + code * 4, get32(upper + code * 4))
        }
    }
    // The Hangul syllables decompose by rule.
    fill(dt, 44032, 55203, 1)
}

fn readCasing() -> void {
    specialCode = alloc(1024 * 4)
    specialLower = alloc(1024 * 4)
    specialTitle = alloc(1024 * 4)
    specialUpper = alloc(1024 * 4)
    specialData = alloc(8192 * 4)
    begin("SpecialCasing.txt")
    while next() {
        if missing { continue }
        // (Those with conditions, Final_Sigma and the languages', the
        // library does by hand.)
        if field(4).length > 0 { continue }
        put32(specialCode + specialCount * 4, @intCast(u32, first))
        put32(specialLower + specialCount * 4, (@intCast(u32, specialLength) << 8) | @intCast(u32, codes(field(1), specialData + specialLength * 4)))
        specialLength += @intCast(usize, get32(specialLower + specialCount * 4) & 255)
        put32(specialTitle + specialCount * 4, (@intCast(u32, specialLength) << 8) | @intCast(u32, codes(field(2), specialData + specialLength * 4)))
        specialLength += @intCast(usize, get32(specialTitle + specialCount * 4) & 255)
        put32(specialUpper + specialCount * 4, (@intCast(u32, specialLength) << 8) | @intCast(u32, codes(field(3), specialData + specialLength * 4)))
        specialLength += @intCast(usize, get32(specialUpper + specialCount * 4) & 255)
        put8(caseFlags + first, get8(caseFlags + first) | 1)
        specialCount += 1
    }
    sortCodes(specialCode, specialCount, specialLower, specialTitle, specialUpper)
    foldCode = alloc(2048 * 4)
    foldInfo = alloc(2048 * 4)
    foldData = alloc(8192 * 4)
    begin("CaseFolding.txt")
    while next() {
        if missing { continue }
        const status = field(1)
        if same(status, "C") || same(status, "S") {
            put32(fold + first * 4, signedDelta(hex(field(2)), first))
        } else if same(status, "F") {
            put32(foldCode + foldCount * 4, @intCast(u32, first))
            const count = codes(field(2), foldData + foldLength * 4)
            put32(foldInfo + foldCount * 4, (@intCast(u32, foldLength) << 8) | @intCast(u32, count))
            foldLength += count
            put8(caseFlags + first, get8(caseFlags + first) | 2)
            foldCount += 1
        }
    }
    begin("BidiMirroring.txt")
    while next() {
        if !missing { put32(mirror + first * 4, signedDelta(hex(field(1)), first)) }
    }
    begin("BidiBrackets.txt")
    while next() {
        if missing { continue }
        put32(bracket + first * 4, signedDelta(hex(field(1)), first))
        put8(bpt + first, @intCast(u8, valueIndex("bpt", BPT[0..3], field(2))))
    }
}

fn signedDecimal(value: []const u8) -> i64 {
    if value.length > 0 && value[0] == 45 { return -@intCast(i64, decimal(value[1..value.length])) }
    return @intCast(i64, decimal(value))
}

fn readNumericValues() -> void {
    numerators = alloc(1024 * 8)
    denominators = alloc(1024 * 8)
    begin("extracted/DerivedNumericValues.txt")
    while next() {
        if missing { continue }
        const rational = field(3)
        var slash: usize = 0
        while slash < rational.length && rational[slash] != 47 { slash += 1 }
        const numerator = signedDecimal(rational[0..slash])
        var denominator: u64 = 1
        if slash < rational.length { denominator = @intCast(u64, decimal(rational[slash + 1..rational.length])) }
        var index: usize = 0
        while index < numericCount {
            if @bitCast(i64, get64(numerators + index * 8)) == numerator && get64(denominators + index * 8) == denominator { break }
            index += 1
        }
        if index == numericCount {
            put64(numerators + index * 8, @bitCast(u64, numerator))
            put64(denominators + index * 8, denominator)
            numericCount += 1
        }
        if numericCount > 511 { fail("too many numeric values") }
        var code = first
        while code <= last {
            put16(numeric + code * 2, @intCast(u16, index + 1))
            code += 1
        }
    }
}

// Sorts `count` codes at `keys`, the three tables beside them alike.
fn sortCodes(keys: usize, count: usize, a: usize, b: usize, c: usize) -> void {
    var index: usize = 1
    while index < count {
        var place = index
        while place > 0 && get32(keys + (place - 1) * 4) > get32(keys + place * 4) {
            swap32(keys, place)
            if a != 0 { swap32(a, place) }
            if b != 0 { swap32(b, place) }
            if c != 0 { swap32(c, place) }
            place -= 1
        }
        index += 1
    }
}

fn swap32(table: usize, place: usize) -> void {
    const value = get32(table + place * 4)
    put32(table + place * 4, get32(table + (place - 1) * 4))
    put32(table + (place - 1) * 4, value)
}

// ---------------------------------------------------------------------------
// What follows from the rest.

// The canonical compositions: (first << 21 | second) and the composite,
// sorted.
var compositionCount: usize = 0
var compositionKey: usize = 0
var compositionValue: usize = 0

fn decompositionOf(code: usize) -> usize {
    // (The index + 1 of its decomposition, 0 when none: by halves.)
    var low: usize = 0
    var high = decompositionCount
    while low < high {
        const middle = (low + high) / 2
        const found = @intCast(usize, get32(decompositionCode + middle * 4))
        if found == code { return middle + 1 }
        if found < code { low = middle + 1 } else { high = middle }
    }
    return 0
}

fn compositions() -> void {
    compositionKey = alloc(4096 * 8)
    compositionValue = alloc(4096 * 4)
    var index: usize = 0
    while index < decompositionCount {
        const info = get32(decompositionInfo + index * 4)
        const code = @intCast(usize, get32(decompositionCode + index * 4))
        if (info & 2147483648) == 0 && ((info >> 24) & 127) == 2 && !hasBit(code, 9) {
            const offset = @intCast(usize, info & 16777215)
            const key = (@intCast(u64, get32(decompositionData + offset * 4)) << 21) | @intCast(u64, get32(decompositionData + offset * 4 + 4))
            var place = compositionCount
            while place > 0 && get64(compositionKey + (place - 1) * 8) > key {
                put64(compositionKey + place * 8, get64(compositionKey + (place - 1) * 8))
                put32(compositionValue + place * 4, get32(compositionValue + (place - 1) * 4))
                place -= 1
            }
            put64(compositionKey + place * 8, key)
            put32(compositionValue + place * 4, @intCast(u32, code))
            compositionCount += 1
        }
        index += 1
    }
}

// The binary properties made of others.
fn derived() -> void {
    // Whether a code point composes with one before it (the second of
    // a pair) or after it (the first).
    const combinesBack = alloc(LIMIT)
    const combinesForward = alloc(LIMIT)
    var index: usize = 0
    while index < compositionCount {
        const key = get64(compositionKey + index * 8)
        put8(combinesForward + @intCast(usize, key >> 21), 1)
        put8(combinesBack + @intCast(usize, key & 2097151), 1)
        index += 1
    }
    // Case_Sensitive: changed by a case mapping or folding, or what one
    // maps to.
    var code: usize = 0
    while code < LIMIT {
        if get32(upper + code * 4) != 0 || get32(lower + code * 4) != 0 || get32(title + code * 4) != 0 || get32(fold + code * 4) != 0 || get8(caseFlags + code) != 0 {
            setBit(code, CASE_SENSITIVE)
            setBit(@intCast(usize, @intCast(isize, code) + @intCast(isize, @bitCast(i32, get32(upper + code * 4)))), CASE_SENSITIVE)
            setBit(@intCast(usize, @intCast(isize, code) + @intCast(isize, @bitCast(i32, get32(lower + code * 4)))), CASE_SENSITIVE)
            setBit(@intCast(usize, @intCast(isize, code) + @intCast(isize, @bitCast(i32, get32(title + code * 4)))), CASE_SENSITIVE)
            setBit(@intCast(usize, @intCast(isize, code) + @intCast(isize, @bitCast(i32, get32(fold + code * 4)))), CASE_SENSITIVE)
        }
        code += 1
    }
    code = 0
    while code < LIMIT {
        const decomposed = if code >= 44032 && code <= 55203 { 1 } else { decompositionOf(code) }
        const canonical = decomposed != 0 && ((code >= 44032 && code <= 55203) || (get32(decompositionInfo + (decomposed - 1) * 4) & 2147483648) == 0)
        const starter = get8(ccc + code) == 0
        if starter && !canonical { setBit(code, NFD_INERT) }
        if starter && decomposed == 0 { setBit(code, NFKD_INERT) }
        const composing = get8(combinesBack + code) != 0 || get8(combinesForward + code) != 0
        const hangulJoins = (code >= 4352 && code <= 4370) || (code >= 4449 && code <= 4469) || (code >= 4520 && code <= 4546) || (code >= 44032 && code <= 55203)
        if starter && !canonical && !composing && !hangulJoins && get8(nfcqc + code) == 0 { setBit(code, NFC_INERT) }
        if starter && decomposed == 0 && !composing && !hangulJoins && get8(nfkcqc + code) == 0 { setBit(code, NFKC_INERT) }
        if starter && get8(combinesBack + code) == 0 && !(code >= 4449 && code <= 4546) { setBit(code, SEGMENT_STARTER) }
        code += 1
    }
}

// ---------------------------------------------------------------------------
// The tries.

// Record numbers of each code point into `numbers` (2 bytes each) from
// the records `words` (that many 8-byte words per code point, `width`
// bytes apart in their arrays); the records kept once, in `records`.
var recordCount: usize = 0

fn hashWords(address: usize, count: usize) -> u64 {
    var hash: u64 = 14695981039346656037
    var index: usize = 0
    while index < count {
        hash = (hash ^ get64(address + index * 8)) *% 1099511628211
        hash = hash ^ (hash >> 29)
        index += 1
    }
    return hash
}

fn sameWords(a: usize, b: usize, count: usize) -> bool {
    var index: usize = 0
    while index < count {
        if get64(a + index * 8) != get64(b + index * 8) { return false }
        index += 1
    }
    return true
}

// Numbers each distinct `words`-word value at `values` (one per code
// point) in `numbers`; the distinct values to `records`, their count.
fn number(values: usize, words: usize, numbers: usize, records: usize) -> usize {
    const SLOTS: usize = 1048576
    const slots = alloc(SLOTS * 4)
    var count: usize = 0
    var code: usize = 0
    while code < LIMIT {
        const value = values + code * words * 8
        var slot = @intCast(usize, hashWords(value, words) & @intCast(u64, SLOTS - 1))
        var found: usize = 0
        while get32(slots + slot * 4) != 0 {
            const candidate = @intCast(usize, get32(slots + slot * 4)) - 1
            if sameWords(records + candidate * words * 8, value, words) {
                found = candidate + 1
                break
            }
            slot = (slot + 1) & (SLOTS - 1)
        }
        if found == 0 {
            var index: usize = 0
            while index < words {
                put64(records + count * words * 8 + index * 8, get64(value + index * 8))
                index += 1
            }
            count += 1
            put32(slots + slot * 4, @intCast(u32, count))
            found = count
        }
        if found > 65536 { fail("too many records for a trie") }
        put16(numbers + code * 2, @intCast(u16, found - 1))
        code += 1
    }
    return count
}

// The index and the blocks of the record numbers: blocks alike kept once.
var trieIndex: usize = 0
var trieBlocks: usize = 0
var trieBlockCount: usize = 0

fn trie(numbers: usize) -> void {
    const SLOTS: usize = 65536
    const blocks = LIMIT / BLOCK
    trieIndex = alloc(blocks * 2)
    trieBlocks = alloc(LIMIT * 2)
    trieBlockCount = 0
    const slots = alloc(SLOTS * 4)
    var block: usize = 0
    while block < blocks {
        const values = numbers + block * BLOCK * 2
        var slot = @intCast(usize, hashWords(values, BLOCK / 4) & @intCast(u64, SLOTS - 1))
        var found: usize = 0
        while get32(slots + slot * 4) != 0 {
            const candidate = @intCast(usize, get32(slots + slot * 4)) - 1
            if sameWords(trieBlocks + candidate * BLOCK * 2, values, BLOCK / 4) {
                found = candidate + 1
                break
            }
            slot = (slot + 1) & (SLOTS - 1)
        }
        if found == 0 {
            var index: usize = 0
            while index < BLOCK / 4 {
                put64(trieBlocks + trieBlockCount * BLOCK * 2 + index * 8, get64(values + index * 8))
                index += 1
            }
            trieBlockCount += 1
            put32(slots + slot * 4, @intCast(u32, trieBlockCount))
            found = trieBlockCount
        }
        put16(trieIndex + block * 2, @intCast(u16, found - 1))
        block += 1
    }
}

// ---------------------------------------------------------------------------
// The collation elements of the Unicode Collation Algorithm's table
// (uca/allkeys.txt, DUCET): for each code point it lists, its elements
// (primary << 16 | secondary << 7 | tertiary << 2 | 1 when variable) in
// COLLATION_CES; the sequences it lists (contractions) sorted by their
// first code point; and the ranges whose implicit weights it names.

var collationValues: usize = 0
var ces: usize = 0
var ceCount: usize = 0
var contractionCount: usize = 0
var contractionFirst: usize = 0
var contractionInfo: usize = 0
var contractionCes: usize = 0
var contractionCodes: usize = 0
var contractionLength: usize = 0
var implicitCount: usize = 0
var implicitFirst: usize = 0
var implicitLast: usize = 0
var implicitBase: usize = 0

// The elements of a field `[.2380.0020.0008][*0209.0020.001A]` into the
// pool; their count.
fn collationElements(value: []const u8) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < value.length {
        if value[index] != 91 {
            index += 1
            continue
        }
        const variable: u32 = if value[index + 1] == 42 { 1 } else { 0 }
        var weights: [3]u32 = undefined
        var which: usize = 0
        index += 2
        while which < 3 {
            const start = index
            while index < value.length && hexDigit(value[index]) != 99 { index += 1 }
            weights[which] = @intCast(u32, hex(value[start..index]))
            which += 1
            index += 1
        }
        put32(ces + ceCount * 4, (weights[0] << 16) | (weights[1] << 7) | (weights[2] << 2) | variable)
        ceCount += 1
        count += 1
    }
    return count
}

fn readCollation() -> void {
    collationValues = alloc(LIMIT * 8)
    var code: usize = 0
    while code < LIMIT {
        put64(collationValues + code * 8, 4294967295)
        code += 1
    }
    ces = alloc(262144 * 4)
    contractionFirst = alloc(4096 * 4)
    contractionInfo = alloc(4096 * 4)
    contractionCes = alloc(4096 * 4)
    contractionCodes = alloc(16384 * 4)
    implicitFirst = alloc(64 * 4)
    implicitLast = alloc(64 * 4)
    implicitBase = alloc(64 * 4)
    begin("../uca/allkeys.txt")
    const text = current()
    const scratch = alloc(64 * 4)
    var position: usize = 0
    while position < text.length {
        const start = position
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        position = end + 1
        var stop = start
        while stop < end && text[stop] != 35 { stop += 1 }
        const line = text[start..stop]
        if line.length == 0 { continue }
        var semicolon: usize = 0
        while semicolon < line.length && line[semicolon] != 59 { semicolon += 1 }
        if semicolon == line.length { continue }
        if startsWith(line, "@implicitweights") {
            // `@implicitweights 17000..18AFF; FB00`
            var from: usize = 16
            while isSpace(line[from]) { from += 1 }
            var dots = from
            while line[dots] != 46 { dots += 1 }
            put32(implicitFirst + implicitCount * 4, @intCast(u32, hex(line[from..dots])))
            var to = dots + 2
            while to < semicolon && !isSpace(line[to]) { to += 1 }
            put32(implicitLast + implicitCount * 4, @intCast(u32, hex(line[dots + 2..to])))
            var base = semicolon + 1
            while isSpace(line[base]) { base += 1 }
            var baseEnd = base
            while baseEnd < line.length && !isSpace(line[baseEnd]) { baseEnd += 1 }
            put32(implicitBase + implicitCount * 4, @intCast(u32, hex(line[base..baseEnd])))
            implicitCount += 1
            continue
        }
        if hexDigit(line[0]) == 99 { continue }
        const count = codes(line[0..semicolon], scratch)
        const offset = ceCount
        const elements = collationElements(line[semicolon + 1..line.length])
        const value = (@intCast(u64, offset) << 5) | @intCast(u64, elements)
        if count == 1 {
            put64(collationValues + @intCast(usize, get32(scratch)) * 8, value)
        } else {
            put32(contractionFirst + contractionCount * 4, get32(scratch))
            put32(contractionInfo + contractionCount * 4, (@intCast(u32, contractionLength) << 8) | @intCast(u32, count - 1))
            var index: usize = 1
            while index < count {
                put32(contractionCodes + contractionLength * 4, get32(scratch + index * 4))
                contractionLength += 1
                index += 1
            }
            put32(contractionCes + contractionCount * 4, @intCast(u32, value))
            contractionCount += 1
        }
    }
    sortCodes(contractionFirst, contractionCount, contractionInfo, contractionCes, 0)
}

// ---------------------------------------------------------------------------
// IDNA (UTS #46, idna/IdnaMappingTable.txt): each code point's status
// (0 valid, 1 mapped, 2 deviation, 3 ignored, 4 disallowed) and mapping
// as status << 29 | length << 24 | offset into IDNA_DATA.

const IDNA_STATUSES = [5][]const u8{ "valid", "mapped", "deviation", "ignored", "disallowed" }
var idnaValues: usize = 0
var idnaData: usize = 0
var idnaLength: usize = 0

fn readIdna() -> void {
    const statuses = IDNA_STATUSES[0..5]
    idnaValues = alloc(LIMIT * 8)
    idnaData = alloc(65536 * 4)
    var code: usize = 0
    while code < LIMIT {
        put64(idnaValues + code * 8, @intCast(u64, 4) << 29)
        code += 1
    }
    begin("../idna/IdnaMappingTable.txt")
    while next() {
        if missing { continue }
        var status: usize = 0
        while status < 5 && !same(statuses[status], field(1)) { status += 1 }
        if status == 5 { fail(join("unknown IDNA status ", field(1))) }
        const count = codes(field(2), idnaData + idnaLength * 4)
        const value = (@intCast(u64, status) << 29) | (@intCast(u64, count) << 24) | @intCast(u64, idnaLength)
        idnaLength += count
        code = first
        while code <= last {
            put64(idnaValues + code * 8, value)
            code += 1
        }
    }
}

fn outRecords(name: []const u8, records: usize, count: usize) -> void {
    const column = alloc(count * 4 + 4)
    var index: usize = 0
    while index < count {
        put32(column + index * 4, @intCast(u32, get64(records + index * 8)))
        index += 1
    }
    outArray(name, "u32", column, count, 4, false)
}

// ---------------------------------------------------------------------------

fn generate(tablesPath: []const u8, apiPath: []const u8) -> void {
    readAliases()
    readScripts()
    readBlocks()
    gc = alloc(LIMIT)
    bc = alloc(LIMIT)
    ccc = alloc(LIMIT)
    lb = alloc(LIMIT)
    gcb = alloc(LIMIT)
    wb = alloc(LIMIT)
    sb = alloc(LIMIT)
    ea = alloc(LIMIT)
    hst = alloc(LIMIT)
    jt = alloc(LIMIT)
    nt = alloc(LIMIT)
    dt = alloc(LIMIT)
    bpt = alloc(LIMIT)
    vo = alloc(LIMIT)
    incb = alloc(LIMIT)
    sc = alloc(LIMIT * 2)
    nfcqc = alloc(LIMIT)
    nfkcqc = alloc(LIMIT)
    nfdqc = alloc(LIMIT)
    nfkdqc = alloc(LIMIT)
    bits0 = alloc(LIMIT * 8)
    bits1 = alloc(LIMIT * 8)
    upper = alloc(LIMIT * 4)
    lower = alloc(LIMIT * 4)
    title = alloc(LIMIT * 4)
    fold = alloc(LIMIT * 4)
    mirror = alloc(LIMIT * 4)
    bracket = alloc(LIMIT * 4)
    caseFlags = alloc(LIMIT)
    numeric = alloc(LIMIT * 2)

    enumerated("extracted/DerivedGeneralCategory.txt", "gc", GC[0..30], gc)
    enumerated("extracted/DerivedBidiClass.txt", "bc", BC[0..23], bc)
    enumerated("LineBreak.txt", "lb", LB[0..48], lb)
    enumerated("auxiliary/GraphemeBreakProperty.txt", "GCB", GCB[0..18], gcb)
    enumerated("auxiliary/WordBreakProperty.txt", "WB", WB[0..23], wb)
    enumerated("auxiliary/SentenceBreakProperty.txt", "SB", SB[0..15], sb)
    enumerated("EastAsianWidth.txt", "ea", EA[0..6], ea)
    enumerated("HangulSyllableType.txt", "hst", HST[0..6], hst)
    enumerated("extracted/DerivedJoiningType.txt", "jt", JT[0..6], jt)
    enumerated("extracted/DerivedNumericType.txt", "nt", NT[0..4], nt)
    enumerated("VerticalOrientation.txt", "vo", VO[0..4], vo)
    begin("extracted/DerivedCombiningClass.txt")
    while next() {
        var value = decimal(field(1))
        if value == 999999 { value = decimal(shortName("ccc", field(1))) }
        if value > 255 { fail(join("no combining class ", field(1))) }
        fill(ccc, first, last, value)
    }
    begin("Scripts.txt")
    while next() {
        const value = scriptIndex(field(1))
        var code = first
        while code <= last {
            put16(sc + code * 2, @intCast(u16, value))
            code += 1
        }
    }
    begin("DerivedCoreProperties.txt")
    while next() {
        if same(field(1), "InCB") { fill(incb, first, last, valueIndex("InCB", INCB[0..4], field(2))) }
    }
    begin("DerivedNormalizationProps.txt")
    while next() {
        const name = field(1)
        if same(name, "NFC_QC") { fill(nfcqc, first, last, valueIndex("NFC_QC", QC[0..3], field(2))) }
        if same(name, "NFKC_QC") { fill(nfkcqc, first, last, valueIndex("NFKC_QC", QC[0..3], field(2))) }
        if same(name, "NFD_QC") { fill(nfdqc, first, last, valueIndex("NFD_QC", QC[0..3], field(2))) }
        if same(name, "NFKD_QC") { fill(nfkdqc, first, last, valueIndex("NFKD_QC", QC[0..3], field(2))) }
    }
    binaries("PropList.txt")
    binaries("DerivedCoreProperties.txt")
    binaries("DerivedNormalizationProps.txt")
    binaries("emoji/emoji-data.txt")
    binaries("extracted/DerivedBinaryProperties.txt")
    readUnicodeData()
    readCasing()
    readNumericValues()
    compositions()
    derived()

    // The property records: CORE, EXTRA, BITS0, BITS1.
    const values = alloc(LIMIT * 32)
    var code: usize = 0
    while code < LIMIT {
        var core: u64 = @intCast(u64, get8(gc + code))
        core |= @intCast(u64, get8(bc + code)) << 5
        core |= @intCast(u64, get8(ccc + code)) << 10
        core |= @intCast(u64, get8(lb + code)) << 18
        core |= @intCast(u64, get8(gcb + code)) << 24
        core |= @intCast(u64, get8(wb + code)) << 29
        core |= @intCast(u64, get8(sb + code)) << 34
        core |= @intCast(u64, get8(ea + code)) << 38
        core |= @intCast(u64, get8(hst + code)) << 41
        core |= @intCast(u64, get8(jt + code)) << 44
        core |= @intCast(u64, get8(nt + code)) << 47
        core |= @intCast(u64, get8(dt + code)) << 49
        core |= @intCast(u64, get8(bpt + code)) << 54
        core |= @intCast(u64, get8(vo + code)) << 56
        core |= @intCast(u64, get8(incb + code)) << 58
        var extra: u64 = @intCast(u64, get16(sc + code * 2))
        extra |= @intCast(u64, get8(nfcqc + code)) << 10
        extra |= @intCast(u64, get8(nfkcqc + code)) << 12
        extra |= @intCast(u64, get8(nfdqc + code)) << 14
        extra |= @intCast(u64, get8(nfkdqc + code)) << 15
        extra |= @intCast(u64, get16(numeric + code * 2)) << 16
        put64(values + code * 32, core)
        put64(values + code * 32 + 8, extra)
        put64(values + code * 32 + 16, get64(bits0 + code * 8))
        put64(values + code * 32 + 24, get64(bits1 + code * 8))
        code += 1
    }
    const propertyNumbers = alloc(LIMIT * 2)
    const propertyRecords = alloc(65536 * 32)
    const propertyCount = number(values, 4, propertyNumbers, propertyRecords)
    // The case records: UPPER, LOWER, TITLE, FOLD, MIRROR, BRACKET (32
    // bits each) and FLAGS.
    code = 0
    while code < LIMIT {
        put64(values + code * 32, @intCast(u64, get32(upper + code * 4)) | (@intCast(u64, get32(lower + code * 4)) << 32))
        put64(values + code * 32 + 8, @intCast(u64, get32(title + code * 4)) | (@intCast(u64, get32(fold + code * 4)) << 32))
        put64(values + code * 32 + 16, @intCast(u64, get32(mirror + code * 4)) | (@intCast(u64, get32(bracket + code * 4)) << 32))
        put64(values + code * 32 + 24, @intCast(u64, get8(caseFlags + code)))
        code += 1
    }
    const caseNumbers = alloc(LIMIT * 2)
    const caseRecords = alloc(65536 * 32)
    const caseCount = number(values, 4, caseNumbers, caseRecords)

    outStart()
    out("// The tables of std.unicode, made by std/registry/unicode/generate.mlx from\n")
    out("// the Unicode Character Database 16.0.0 (std/registry/unicode/ucd): do not edit;\n")
    out("// `./mlx build unicode-tables` makes them again.\n\n")
    out("pub const BLOCK_SHIFT: usize = 6\n\n")
    trie(propertyNumbers)
    outArray("PROPERTY_INDEX", "u16", trieIndex, LIMIT / BLOCK, 2, false)
    outArray("PROPERTY_BLOCKS", "u16", trieBlocks, trieBlockCount * BLOCK, 2, false)
    const column = alloc(65536 * 8)
    var word: usize = 0
    while word < 4 {
        var index: usize = 0
        while index < propertyCount {
            put64(column + index * 8, get64(propertyRecords + index * 32 + word * 8))
            index += 1
        }
        if word == 0 { outArray("PROPERTY_CORE", "u64", column, propertyCount, 8, false) }
        if word == 1 { outArray("PROPERTY_EXTRA", "u64", column, propertyCount, 8, false) }
        if word == 2 { outArray("PROPERTY_BITS0", "u64", column, propertyCount, 8, false) }
        if word == 3 { outArray("PROPERTY_BITS1", "u64", column, propertyCount, 8, false) }
        word += 1
    }
    trie(caseNumbers)
    outArray("CASE_INDEX", "u16", trieIndex, LIMIT / BLOCK, 2, false)
    outArray("CASE_BLOCKS", "u16", trieBlocks, trieBlockCount * BLOCK, 2, false)
    word = 0
    while word < 7 {
        var index: usize = 0
        while index < caseCount {
            const pair = get64(caseRecords + index * 32 + (word / 2) * 8)
            put32(column + index * 4, @intCast(u32, if word % 2 == 0 { pair & 4294967295 } else { pair >> 32 }))
            index += 1
        }
        if word == 0 { outArray("CASE_UPPER", "i32", column, caseCount, 4, true) }
        if word == 1 { outArray("CASE_LOWER", "i32", column, caseCount, 4, true) }
        if word == 2 { outArray("CASE_TITLE", "i32", column, caseCount, 4, true) }
        if word == 3 { outArray("CASE_FOLD", "i32", column, caseCount, 4, true) }
        if word == 4 { outArray("CASE_MIRROR", "i32", column, caseCount, 4, true) }
        if word == 5 { outArray("CASE_BRACKET", "i32", column, caseCount, 4, true) }
        if word == 6 { outArray("CASE_FLAGS", "u32", column, caseCount, 4, false) }
        word += 1
    }
    outArray("DECOMPOSITION_CODES", "u32", decompositionCode, decompositionCount, 4, false)
    outArray("DECOMPOSITION_INFO", "u32", decompositionInfo, decompositionCount, 4, false)
    outArray("DECOMPOSITION_DATA", "u32", decompositionData, decompositionLength, 4, false)
    outArray("COMPOSITION_KEYS", "u64", compositionKey, compositionCount, 8, false)
    outArray("COMPOSITION_VALUES", "u32", compositionValue, compositionCount, 4, false)
    outArray("SPECIAL_CODES", "u32", specialCode, specialCount, 4, false)
    outArray("SPECIAL_LOWER", "u32", specialLower, specialCount, 4, false)
    outArray("SPECIAL_TITLE", "u32", specialTitle, specialCount, 4, false)
    outArray("SPECIAL_UPPER", "u32", specialUpper, specialCount, 4, false)
    outArray("SPECIAL_DATA", "u32", specialData, specialLength, 4, false)
    outArray("FOLD_CODES", "u32", foldCode, foldCount, 4, false)
    outArray("FOLD_INFO", "u32", foldInfo, foldCount, 4, false)
    outArray("FOLD_DATA", "u32", foldData, foldLength, 4, false)
    scriptExtensions()
    outArray("NUMERIC_NUMERATORS", "u64", numerators, numericCount, 8, false)
    outArray("NUMERIC_DENOMINATORS", "u64", denominators, numericCount, 8, false)
    readCollation()
    const collationNumbers = alloc(LIMIT * 2)
    const collationRecords = alloc(65536 * 8)
    const collationCount = number(collationValues, 1, collationNumbers, collationRecords)
    trie(collationNumbers)
    outArray("COLLATION_INDEX", "u16", trieIndex, LIMIT / BLOCK, 2, false)
    outArray("COLLATION_BLOCKS", "u16", trieBlocks, trieBlockCount * BLOCK, 2, false)
    outRecords("COLLATION_RECORDS", collationRecords, collationCount)
    outArray("COLLATION_CES", "u32", ces, ceCount, 4, false)
    outArray("CONTRACTION_FIRST", "u32", contractionFirst, contractionCount, 4, false)
    outArray("CONTRACTION_INFO", "u32", contractionInfo, contractionCount, 4, false)
    outArray("CONTRACTION_CES", "u32", contractionCes, contractionCount, 4, false)
    outArray("CONTRACTION_CODES", "u32", contractionCodes, contractionLength, 4, false)
    outArray("IMPLICIT_FIRST", "u32", implicitFirst, implicitCount, 4, false)
    outArray("IMPLICIT_LAST", "u32", implicitLast, implicitCount, 4, false)
    outArray("IMPLICIT_BASE", "u32", implicitBase, implicitCount, 4, false)
    readIdna()
    const idnaNumbers = alloc(LIMIT * 2)
    const idnaRecords = alloc(65536 * 8)
    const idnaCount = number(idnaValues, 1, idnaNumbers, idnaRecords)
    trie(idnaNumbers)
    outArray("IDNA_INDEX", "u16", trieIndex, LIMIT / BLOCK, 2, false)
    outArray("IDNA_BLOCKS", "u16", trieBlocks, trieBlockCount * BLOCK, 2, false)
    outRecords("IDNA_RECORDS", idnaRecords, idnaCount)
    outArray("IDNA_DATA", "u32", idnaData, idnaLength, 4, false)
    outArray("BLOCK_FIRST", "u32", blockFirst, blockCount, 4, false)
    outArray("BLOCK_LAST", "u32", blockLast, blockCount, 4, false)
    // The scripts' names, a line each by number: the short name, the long
    // one (none for the codes no code point has), the C name.
    out("pub const SCRIPT_COUNT: usize = ")
    outNumber(@intCast(u64, scriptCount))
    out("\npub const SCRIPT_NAMES: []const u8 = \"")
    var index: usize = 0
    while index < scriptCount {
        out(getSlice(scriptShort, index))
        out(" ")
        out(getSlice(scriptLong, index))
        out("\\n")
        index += 1
    }
    out("\"\n")
    writeWhole(tablesPath, outText())

    // The enumerations, as an API module (mlx-cheaders makes their
    // header).
    outStart()
    out("// unicode/ugenerated.h\n")
    out("// mlx-unicode: the enumerations the data decides, made by\n")
    out("// std/registry/unicode/generate.mlx from the Unicode Character Database\n")
    out("// 16.0.0: do not edit.\n\n")
    out("pub const U_UNICODE_VERSION: []const u8 = \"16.0\"\n\n")
    out("pub const UScriptCode = enum(i32, nonexhaustive) {\n    USCRIPT_INVALID_CODE = -1,\n")
    index = 0
    while index < scriptCount {
        out("    // ")
        out(getSlice(scriptShort, index))
        out("\n    USCRIPT_")
        out(getSlice(scriptName, index))
        out(" = ")
        outNumber(@intCast(u64, index))
        out(",\n")
        index += 1
    }
    out("    USCRIPT_CODE_LIMIT = ")
    outNumber(@intCast(u64, scriptCount))
    out(",\n}\n\n// Other names of scripts.\n")
    const aliases = SCRIPT_ALIASES[0..6]
    index = 0
    while index + 1 < aliases.length {
        out("pub const USCRIPT_")
        out(aliases[index])
        out(": UScriptCode = UScriptCode.USCRIPT_")
        out(getSlice(scriptName, scriptIndex(aliases[index + 1])))
        out("\n")
        index += 2
    }
    out("\npub const UBlockCode = enum(i32, nonexhaustive) {\n    UBLOCK_NO_BLOCK = 0,\n")
    index = 0
    while index < blockCount {
        out("    UBLOCK_")
        out(getSlice(blockName, index))
        out(" = ")
        outNumber(@intCast(u64, index + 1))
        out(",\n")
        index += 1
    }
    out("    UBLOCK_COUNT = ")
    outNumber(@intCast(u64, blockCount + 1))
    out(",\n    UBLOCK_INVALID_CODE = -1,\n}\n\n// Other names of blocks.\n")
    out("pub const UBLOCK_GREEK: UBlockCode = UBlockCode.UBLOCK_GREEK_AND_COPTIC\n")
    out("pub const UBLOCK_CYRILLIC_SUPPLEMENTARY: UBlockCode = UBlockCode.UBLOCK_CYRILLIC_SUPPLEMENT\n")
    out("pub const UBLOCK_COMBINING_MARKS_FOR_SYMBOLS: UBlockCode = UBlockCode.UBLOCK_COMBINING_DIACRITICAL_MARKS_FOR_SYMBOLS\n")
    out("pub const UBLOCK_PRIVATE_USE: UBlockCode = UBlockCode.UBLOCK_PRIVATE_USE_AREA\n")
    writeWhole(apiPath, outText())
}

// The script extensions: ranges sorted, each with its scripts (a list
// in SCX_DATA ended by 65535).
fn scriptExtensions() -> void {
    const rangeFirst = alloc(4096 * 4)
    const rangeLast = alloc(4096 * 4)
    const rangeOffset = alloc(4096 * 4)
    const data = alloc(65536 * 2)
    var count: usize = 0
    var length: usize = 0
    begin("ScriptExtensions.txt")
    while next() {
        if missing { continue }
        put32(rangeFirst + count * 4, @intCast(u32, first))
        put32(rangeLast + count * 4, @intCast(u32, last))
        put32(rangeOffset + count * 4, @intCast(u32, length))
        const names = field(1)
        var index: usize = 0
        while index < names.length {
            while index < names.length && isSpace(names[index]) { index += 1 }
            const start = index
            while index < names.length && !isSpace(names[index]) { index += 1 }
            if index > start {
                put16(data + length * 2, @intCast(u16, scriptIndex(names[start..index])))
                length += 1
            }
        }
        put16(data + length * 2, 65535)
        length += 1
        count += 1
    }
    sortCodes(rangeFirst, count, rangeLast, rangeOffset, 0)
    outArray("SCX_FIRST", "u32", rangeFirst, count, 4, false)
    outArray("SCX_LAST", "u32", rangeLast, count, 4, false)
    outArray("SCX_OFFSET", "u32", rangeOffset, count, 4, false)
    outArray("SCX_DATA", "u16", data, length, 2, false)
}

fn cString(pointer: [*]const u8) -> []const u8 {
    var length: usize = 0
    while pointer[length] != 0 { length += 1 }
    return pointer[0..length]
}

pub fn main(arguments: [][*]const u8) -> u8 {
    if arguments.length != 4 {
        say("usage: unicode-generate UCD-DIRECTORY TABLES-FILE API-FILE\n")
        return 2
    }
    const directory = cString(arguments[1])
    ucdBase = @intFromPtr(directory.pointer)
    ucdLength = directory.length
    generate(cString(arguments[2]), cString(arguments[3]))
    return 0
}
