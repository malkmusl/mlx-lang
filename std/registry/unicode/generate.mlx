// The tables of std.unicode, made from the Unicode Character Database
// (std/registry/unicode/ucd, Unicode 16.0.0), the Unicode Collation
// Algorithm's table (uca/ beside it) and the IDNA mapping table (idna/):
//
//     unicode-generate UCD-DIRECTORY TABLES-FILE API-FILE
//
// writes TABLES-FILE (std/src/unicode/tables.mlx, what std.unicode looks
// up) and API-FILE (compiler/capi/icu/api/ugenerated.mlx, the
// enumerations C sees that the data decides, the scripts and the blocks,
// as an API module of the C API). `./mlx build unicode-tables` runs it on
// this checkout.
//
// The properties of a code point are two tries, each an index by blocks
// of 64 code points into blocks of record numbers (blocks alike are
// kept once), and the records:
//
//   PROPERTY_*  the enumerated properties packed in a word (CORE, EXTRA)
//               and the binary ones as bits (BITS0, BITS1)
//   CASE_*      the simple case mappings, the simple case folding, the
//               mirrored glyph and the paired bracket, as differences
//
// with sorted lists beside them for what few code points have: the
// decompositions, the canonical compositions, the full case mappings
// (SpecialCasing.txt without its conditions) and foldings, the script
// extensions and the blocks.
const std = @import("std")

const SYS_mmap: usize = 9
const SYS_exit_group: usize = 231

// 0x110000: the code points.
const LIMIT: usize = 1114112
const BLOCK: usize = 64

// ---------------------------------------------------------------------------
// Memory: an arena, reserved and never freed (the run is short).

var arenaNext: usize = 0
var arenaEnd: usize = 0

fn alloc(size: usize) -> usize {
    if arenaNext == 0 {
        const reserved = std.linux.syscall6(SYS_mmap, 0, 17179869184, 3, 16418, @bitCast(usize, @intCast(isize, -1)), 0)
        if reserved < 0 { fail("no memory") }
        arenaNext = @bitCast(usize, reserved)
        arenaEnd = arenaNext + 17179869184
    }
    const at = (arenaNext + 15) / 16 * 16
    if at + size > arenaEnd { fail("out of memory") }
    arenaNext = at + size
    return at
}

fn get8(address: usize) -> u8 { unsafe { return @ptrFromInt(*u8, address).* } }
fn put8(address: usize, value: u8) -> void { unsafe { @ptrFromInt(*u8, address).* = value } }
fn get16(address: usize) -> u16 { unsafe { return @ptrFromInt(*u16, address).* } }
fn put16(address: usize, value: u16) -> void { unsafe { @ptrFromInt(*u16, address).* = value } }
fn get32(address: usize) -> u32 { unsafe { return @ptrFromInt(*u32, address).* } }
fn put32(address: usize, value: u32) -> void { unsafe { @ptrFromInt(*u32, address).* = value } }
fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
fn put64(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u64, address).* = value } }
fn getWord(address: usize) -> usize { unsafe { return @ptrFromInt(*usize, address).* } }
fn putWord(address: usize, value: usize) -> void { unsafe { @ptrFromInt(*usize, address).* = value } }

fn bytes(address: usize, length: usize) -> []const u8 {
    var view: [*]const u8 = undefined
    unsafe { view = @ptrFromInt([*]const u8, address) }
    return view[0..length]
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn fail(message: []const u8) -> void {
    say("unicode-generate: ")
    say(message)
    say("\n")
    const ignored = std.linux.syscall1(SYS_exit_group, 1)
}

fn same(first: []const u8, second: []const u8) -> bool {
    if first.length != second.length { return false }
    var index: usize = 0
    while index < first.length {
        if first[index] != second[index] { return false }
        index += 1
    }
    return true
}

fn startsWith(text: []const u8, prefix: []const u8) -> bool {
    return text.length >= prefix.length && same(text[0..prefix.length], prefix)
}

// `first` and `second` joined, in the arena, NUL after them.
fn join(first: []const u8, second: []const u8) -> []const u8 {
    const at = alloc(first.length + second.length + 1)
    var index: usize = 0
    while index < first.length {
        put8(at + index, first[index])
        index += 1
    }
    index = 0
    while index < second.length {
        put8(at + first.length + index, second[index])
        index += 1
    }
    return bytes(at, first.length + second.length)
}

// ---------------------------------------------------------------------------
// Files

var ucdBase: usize = 0
var ucdLength: usize = 0

fn readWhole(path: []const u8) -> []const u8 {
    const contents = std.fs.readFileAlloc(join(path, "").pointer, std.page_allocator.init())
    if contents == null { fail(join("cannot read ", path)) }
    return bytes(@intFromPtr(contents.?.items), contents.?.length)
}

fn ucd(name: []const u8) -> []const u8 { return readWhole(join(join(bytes(ucdBase, ucdLength), "/"), name)) }

fn writeWhole(path: []const u8, text: []const u8) -> void {
    if !std.fs.writeFile(join(path, "").pointer, text.pointer, text.length, 420) { fail(join("cannot write ", path)) }
}

// ---------------------------------------------------------------------------
// Output: text built up in one buffer.

const OUT_SIZE: usize = 268435456
var outBase: usize = 0
var outTop: usize = 0

fn outStart() -> void {
    if outBase == 0 { outBase = alloc(OUT_SIZE) }
    outTop = 0
}

fn out(text: []const u8) -> void {
    if outTop + text.length > OUT_SIZE { fail("the output is too large") }
    var index: usize = 0
    while index < text.length {
        put8(outBase + outTop + index, text[index])
        index += 1
    }
    outTop += text.length
}

fn outByte(value: u8) -> void {
    put8(outBase + outTop, value)
    outTop += 1
}

fn outNumber(value: u64) -> void {
    var digits: [24]u8 = undefined
    var count: usize = 0
    var rest = value
    while true {
        digits[23 - count] = @intCast(u8, 48 + rest % 10)
        count += 1
        rest = rest / 10
        if rest == 0 { break }
    }
    var view: [*]const u8 = undefined
    unsafe { view = @ptrCast([*]const u8, &digits) }
    out(view[24 - count..24])
}

fn outSigned(value: i64) -> void {
    if value < 0 {
        outByte(45)
        outNumber(@intCast(u64, -value))
    } else {
        outNumber(@intCast(u64, value))
    }
}

fn outText() -> []const u8 { return bytes(outBase, outTop) }

// A table: `pub var NAME: [count]TYPE = [count]TYPE{ ... }` of the
// values at `address`, each `size` bytes (signed when `signed`). (A
// global `var` is read where it lies in the image; a `const` array is
// made afresh wherever it is indexed.)
fn outArray(name: []const u8, kind: []const u8, address: usize, count: usize, size: usize, signed: bool) -> void {
    out("pub var ")
    out(name)
    out(": [")
    outNumber(@intCast(u64, count))
    out("]")
    out(kind)
    out(" = [")
    outNumber(@intCast(u64, count))
    out("]")
    out(kind)
    out("{")
    var index: usize = 0
    while index < count {
        if index % 16 == 0 { out("\n    ") } else { out(" ") }
        const at = address + index * size
        if size == 1 {
            outNumber(@intCast(u64, get8(at)))
        } else if size == 2 {
            outNumber(@intCast(u64, get16(at)))
        } else if size == 4 {
            if signed { outSigned(@intCast(i64, @bitCast(i32, get32(at)))) } else { outNumber(@intCast(u64, get32(at))) }
        } else {
            outNumber(get64(at))
        }
        out(",")
        index += 1
    }
    out("\n}\n\n")
}

// ---------------------------------------------------------------------------
// The lines of a UCD file: `CODE[..CODE] ; FIELD ; FIELD # comment`, and
// the defaults in `# @missing: CODE..CODE; FIELD` lines (taken in order,
// as data: a file's later lines are the more particular).

var textBase: usize = 0
var textLength: usize = 0

fn current() -> []const u8 { return bytes(textBase, textLength) }
var at: usize = 0
var first: usize = 0
var last: usize = 0
var missing = false
var fieldCount: usize = 0
var fieldStarts: usize = 0
var fieldLengths: usize = 0

fn begin(name: []const u8) -> void {
    const read = ucd(name)
    textBase = @intFromPtr(read.pointer)
    textLength = read.length
    at = 0
    if fieldStarts == 0 {
        fieldStarts = alloc(32 * 8)
        fieldLengths = alloc(32 * 8)
    }
}

fn field(index: usize) -> []const u8 {
    const text = current()
    if index >= fieldCount { return "" }
    return text[getWord(fieldStarts + index * 8)..getWord(fieldStarts + index * 8) + getWord(fieldLengths + index * 8)]
}

fn isSpace(byte: u8) -> bool { return byte == 32 || byte == 9 || byte == 13 }

fn hexDigit(byte: u8) -> usize {
    if byte >= 48 && byte <= 57 { return @intCast(usize, byte - 48) }
    if byte >= 65 && byte <= 70 { return @intCast(usize, byte - 55) }
    if byte >= 97 && byte <= 102 { return @intCast(usize, byte - 87) }
    return 99
}

fn hex(value: []const u8) -> usize {
    var result: usize = 0
    var index: usize = 0
    while index < value.length {
        const digit = hexDigit(value[index])
        if digit == 99 { fail(join("not a code point: ", value)) }
        result = result * 16 + digit
        index += 1
    }
    return result
}

fn decimal(value: []const u8) -> usize {
    var result: usize = 0
    var index: usize = 0
    while index < value.length {
        if value[index] < 48 || value[index] > 57 { return 999999 }
        result = result * 10 + @intCast(usize, value[index] - 48)
        index += 1
    }
    return result
}

// The next record of the file; false at its end.
fn next() -> bool {
    const text = current()
    while at < text.length {
        const start = at
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        at = end + 1
        var from = start
        missing = false
        if startsWith(text[start..end], "# @missing:") {
            from = start + 11
            missing = true
        } else if end > start && text[start] == 35 {
            continue
        }
        // The fields, up to the comment.
        var stop = from
        while stop < end && text[stop] != 35 { stop += 1 }
        fieldCount = 0
        var cursor = from
        while cursor <= stop && fieldCount < 32 {
            var fieldEnd = cursor
            while fieldEnd < stop && text[fieldEnd] != 59 { fieldEnd += 1 }
            var a = cursor
            var b = fieldEnd
            while a < b && isSpace(text[a]) { a += 1 }
            while b > a && isSpace(text[b - 1]) { b -= 1 }
            putWord(fieldStarts + fieldCount * 8, a)
            putWord(fieldLengths + fieldCount * 8, b - a)
            fieldCount += 1
            cursor = fieldEnd + 1
        }
        const range = field(0)
        if range.length == 0 { continue }
        if hexDigit(range[0]) == 99 { continue }
        var dots: usize = 0
        while dots + 1 < range.length && !(range[dots] == 46 && range[dots + 1] == 46) { dots += 1 }
        if dots + 1 < range.length {
            first = hex(range[0..dots])
            last = hex(range[dots + 2..range.length])
        } else {
            first = hex(range)
            last = first
        }
        return true
    }
    return false
}

// The code points of a field (`0041 0301`) into `into`; their count.
fn codes(value: []const u8, into: usize) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < value.length {
        while index < value.length && isSpace(value[index]) { index += 1 }
        const start = index
        while index < value.length && !isSpace(value[index]) { index += 1 }
        if index > start {
            put32(into + count * 4, @intCast(u32, hex(value[start..index])))
            count += 1
        }
    }
    return count
}

// ---------------------------------------------------------------------------
// Values: each enumerated property's values in the order of the C
// enumeration (the ICU API's numbers), by short name; a file's long or
// other names are found through PropertyValueAliases.txt.

const GC = [30][]const u8{ "Cn", "Lu", "Ll", "Lt", "Lm", "Lo", "Mn", "Me", "Mc", "Nd", "Nl", "No", "Zs", "Zl", "Zp", "Cc", "Cf", "Co", "Cs", "Pd", "Ps", "Pe", "Pc", "Po", "Sm", "Sc", "Sk", "So", "Pi", "Pf" }
const BC = [23][]const u8{ "L", "R", "EN", "ES", "ET", "AN", "CS", "B", "S", "WS", "ON", "LRE", "LRO", "AL", "RLE", "RLO", "PDF", "NSM", "BN", "FSI", "LRI", "RLI", "PDI" }
const LB = [48][]const u8{ "XX", "AI", "AL", "B2", "BA", "BB", "BK", "CB", "CL", "CM", "CR", "EX", "GL", "HY", "ID", "IN", "IS", "LF", "NS", "NU", "OP", "PO", "PR", "QU", "SA", "SG", "SP", "SY", "ZW", "NL", "WJ", "H2", "H3", "JL", "JT", "JV", "CP", "CJ", "HL", "RI", "EB", "EM", "ZWJ", "AK", "AP", "AS", "VF", "VI" }
const GCB = [18][]const u8{ "XX", "CN", "CR", "EX", "L", "LF", "LV", "LVT", "T", "V", "SM", "PP", "RI", "EB", "EBG", "EM", "GAZ", "ZWJ" }
const WB = [23][]const u8{ "XX", "LE", "FO", "KA", "ML", "MN", "NU", "EX", "CR", "Extend", "LF", "MB", "NL", "RI", "HL", "SQ", "DQ", "EB", "EBG", "EM", "GAZ", "ZWJ", "WSegSpace" }
const SB = [15][]const u8{ "XX", "AT", "CL", "FO", "LO", "NU", "LE", "SE", "SP", "ST", "UP", "CR", "EX", "LF", "SC" }
const EA = [6][]const u8{ "N", "A", "H", "F", "Na", "W" }
const HST = [6][]const u8{ "NA", "L", "V", "T", "LV", "LVT" }
const JT = [6][]const u8{ "U", "C", "D", "L", "R", "T" }
const NT = [4][]const u8{ "None", "De", "Di", "Nu" }
const DT = [18][]const u8{ "none", "can", "com", "enc", "fin", "font", "fra", "init", "iso", "med", "nar", "nb", "sml", "sqr", "sub", "sup", "vert", "wide" }
const DT_TAGS = [18][]const u8{ "", "", "<compat>", "<circle>", "<final>", "<font>", "<fraction>", "<initial>", "<isolated>", "<medial>", "<narrow>", "<noBreak>", "<small>", "<square>", "<sub>", "<super>", "<vertical>", "<wide>" }
const BPT = [3][]const u8{ "n", "o", "c" }
const VO = [4][]const u8{ "R", "Tr", "Tu", "U" }
const INCB = [4][]const u8{ "None", "Consonant", "Extend", "Linker" }
const QC = [3][]const u8{ "Y", "N", "M" }

// The binary properties, by the number C asks with (UProperty); the
// empty ones are worked out here or by the library.
const BINARY = [76][]const u8{
    "Alphabetic", "ASCII_Hex_Digit", "Bidi_Control", "Bidi_Mirrored", "Dash", "Default_Ignorable_Code_Point", "Deprecated", "Diacritic",
    "Extender", "Full_Composition_Exclusion", "Grapheme_Base", "Grapheme_Extend", "Grapheme_Link", "Hex_Digit", "Hyphen", "ID_Continue",
    "ID_Start", "Ideographic", "IDS_Binary_Operator", "IDS_Trinary_Operator", "Join_Control", "Logical_Order_Exception", "Lowercase", "Math",
    "Noncharacter_Code_Point", "Quotation_Mark", "Radical", "Soft_Dotted", "Terminal_Punctuation", "Unified_Ideograph", "Uppercase", "White_Space",
    "XID_Continue", "XID_Start", "", "Sentence_Terminal", "Variation_Selector", "", "", "",
    "", "", "Pattern_Syntax", "Pattern_White_Space", "", "", "", "",
    "", "Cased", "Case_Ignorable", "Changes_When_Lowercased", "Changes_When_Uppercased", "Changes_When_Titlecased", "Changes_When_Casefolded", "Changes_When_Casemapped",
    "Changes_When_NFKC_Casefolded", "Emoji", "Emoji_Presentation", "Emoji_Modifier", "Emoji_Modifier_Base", "Emoji_Component", "Regional_Indicator", "Prepended_Concatenation_Mark",
    "Extended_Pictographic", "", "", "", "", "", "", "",
    "IDS_Unary_Operator", "ID_Compat_Math_Start", "ID_Compat_Math_Continue", "Modifier_Combining_Mark",
}
const CASE_SENSITIVE: usize = 34
const NFD_INERT: usize = 37
const NFKD_INERT: usize = 38
const NFC_INERT: usize = 39
const NFKC_INERT: usize = 40
const SEGMENT_STARTER: usize = 41

// PropertyValueAliases.txt, each line's fields: the property, then the
// names of the value (short first). A line: its field count, then up to
// 7 fields as address and length.
const ALIAS_LINE: usize = 128
var aliasCount: usize = 0
var aliasLines: usize = 0

fn readAliases() -> void {
    begin("PropertyValueAliases.txt")
    aliasLines = alloc(8192 * ALIAS_LINE)
    const text = current()
    // (Its lines start with the property's name, not a code point: read
    // here without next().)
    var position: usize = 0
    while position < text.length {
        const start = position
        var end = start
        while end < text.length && text[end] != 10 { end += 1 }
        position = end + 1
        if end == start || text[start] == 35 { continue }
        var stop = start
        while stop < end && text[stop] != 35 { stop += 1 }
        const line = aliasLines + aliasCount * ALIAS_LINE
        var count: usize = 0
        var cursor = start
        while cursor <= stop && count < 7 {
            var fieldEnd = cursor
            while fieldEnd < stop && text[fieldEnd] != 59 { fieldEnd += 1 }
            var a = cursor
            var b = fieldEnd
            while a < b && isSpace(text[a]) { a += 1 }
            while b > a && isSpace(text[b - 1]) { b -= 1 }
            putWord(line + 8 + count * 16, @intFromPtr(text.pointer) + a)
            putWord(line + 16 + count * 16, b - a)
            count += 1
            cursor = fieldEnd + 1
        }
        putWord(line, count)
        aliasCount += 1
    }
}

fn aliasField(line: usize, index: usize) -> []const u8 {
    const at = aliasLines + line * ALIAS_LINE
    return bytes(getWord(at + 8 + index * 16), getWord(at + 16 + index * 16))
}

fn aliasFields(line: usize) -> usize { return getWord(aliasLines + line * ALIAS_LINE) }

// The short name of the value `name` of `property` ("" when none).
fn shortName(property: []const u8, name: []const u8) -> []const u8 {
    var line: usize = 0
    while line < aliasCount {
        if same(aliasField(line, 0), property) {
            var index: usize = 1
            while index < aliasFields(line) {
                if same(aliasField(line, index), name) { return aliasField(line, 1) }
                index += 1
            }
        }
        line += 1
    }
    return ""
}

fn valueIndex(property: []const u8, order: []const []const u8, name: []const u8) -> usize {
    var index: usize = 0
    while index < order.length {
        if same(order[index], name) { return index }
        index += 1
    }
    const short = shortName(property, name)
    index = 0
    while index < order.length {
        if same(order[index], short) { return index }
        index += 1
    }
    fail(join(join(join("no value ", name), " of "), property))
    return 0
}

// ---------------------------------------------------------------------------
// The scripts, numbered as ICU numbers them (its UScriptCode, which C
// programs keep): ICU 74's 200 codes of ISO 15924 (those no code point
// has too), then the scripts of Unicode 16.0 as ICU 76 adds them. Each is
// its short name and C name; the long name is PropertyValueAliases.txt's.
const ICU_SCRIPTS = [414][]const u8{
    "Zyyy", "COMMON", "Zinh", "INHERITED", "Arab", "ARABIC", "Armn", "ARMENIAN", "Beng", "BENGALI", "Bopo", "BOPOMOFO",
