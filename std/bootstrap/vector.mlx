const allocator_module = @import("./allocator.mlx")
const mem = @import("./mem.mlx")

pub const Allocator = allocator_module.Allocator

// Type-erased bootstrap vector. Mlx1 uses this for tokens and AST records
// until its comptime pipeline can instantiate a generic ArrayList(T).
pub const Vector = struct {
    items: [*]u8
    length: usize
    capacity: usize
    elementSize: usize
    elementAlignment: usize
    allocator: Allocator

    pub fn init(allocator: Allocator, element_size: usize, element_alignment: usize, initial_capacity: usize) -> Self {
        const capacity = if initial_capacity > 0 { initial_capacity } else { 8 }
        return Self.{
            .items = allocator.alloc(capacity * element_size, element_alignment).?,
            .length = 0,
            .capacity = capacity,
            .elementSize = element_size,
            .elementAlignment = element_alignment,
            .allocator = allocator,
        }
    }

    pub fn initAt(result: *Self, allocator: Allocator, element_size: usize, element_alignment: usize, initial_capacity: usize) -> void {
        const capacity = if initial_capacity > 0 { initial_capacity } else { 8 }
        result.*.items = allocator.alloc(capacity * element_size, element_alignment).?
        result.*.length = 0
        result.*.capacity = capacity
        result.*.elementSize = element_size
        result.*.elementAlignment = element_alignment
        result.*.allocator = allocator
    }

    fn ensureCapacity(vector: Self, minimum_capacity: usize) -> Self {
        var result = vector
        if minimum_capacity <= result.capacity { return result }
        var new_capacity = result.capacity
        while new_capacity < minimum_capacity { new_capacity *= 2 }
        result.items = result.allocator.resize(result.items, result.capacity * result.elementSize, new_capacity * result.elementSize, result.elementAlignment).?
        result.capacity = new_capacity
        return result
    }

    pub fn append(vector: Self, value: [*]const u8) -> Self {
        var result = Self.ensureCapacity(vector, vector.length + 1)
        unsafe {
            const destination = @ptrFromInt([*]u8, @intFromPtr(result.items) + result.length * result.elementSize)
            mem.copy(destination, value, result.elementSize)
        }
        result.length += 1
        return result
    }

    pub fn appendAt(vector: *Self, value: [*]const u8) -> bool {
        if vector.*.length + 1 > vector.*.capacity {
            var new_capacity = vector.*.capacity * 2
            while new_capacity < vector.*.length + 1 { new_capacity *= 2 }
            const resized = vector.*.allocator.resize(vector.*.items, vector.*.capacity * vector.*.elementSize, new_capacity * vector.*.elementSize, vector.*.elementAlignment)
            if resized == null { return false }
            vector.*.items = resized.?
            vector.*.capacity = new_capacity
        }
        unsafe {
            const destination = @ptrFromInt([*]u8, @intFromPtr(vector.*.items) + vector.*.length * vector.*.elementSize)
            mem.copy(destination, value, vector.*.elementSize)
        }
        vector.*.length += 1
        return true
    }

    pub inline fn at(vector: Self, index: usize) -> [*]u8 {
        unsafe { return @ptrFromInt([*]u8, @intFromPtr(vector.items) + index * vector.elementSize) }
    }

    pub fn clear(vector: Self) -> Self {
        var result = vector
        result.length = 0
        return result
    }

    pub fn pop(vector: Self) -> Self {
        if vector.length == 0 { return vector }
        var result = vector
        result.length -= 1
        return result
    }

    pub fn deinit(vector: Self) -> void {
        vector.allocator.free(vector.items, vector.capacity * vector.elementSize, vector.elementAlignment)
    }
}
