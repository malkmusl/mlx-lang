const strings = @import("../string.mlx")

pub const String = strings.String

pub const Kind = enum(u8) {
    unsigned_integer,
    signed_integer,
    character,
    string,
    pointer,
    boolean
}

// Two machine words keep Argument cheap to return and store in bootstrap code.
// For strings, `value` is the byte pointer and metadata stores length << 8.
pub const Argument = struct {
    value: usize
    metadata: usize
}

fn metadata(kind_value: Kind, length: usize) -> usize {
    return (length << 8) | @intCast(usize, @intFromEnum(kind_value))
}

pub fn unsigned(value: usize) -> Argument {
    return Argument.{ .value = value, .metadata = metadata(Kind.unsigned_integer, 0) }
}

pub fn signed(value: isize) -> Argument {
    return Argument.{ .value = @bitCast(usize, value), .metadata = metadata(Kind.signed_integer, 0) }
}

pub fn character(value: u8) -> Argument {
    return Argument.{ .value = @intCast(usize, value), .metadata = metadata(Kind.character, 0) }
}

pub fn string(value: []const u8) -> Argument {
    var length: usize = 0
    for byte in value { length += 1 }
    unsafe {
        return Argument.{ .value = @intFromPtr(@ptrCast([*]const u8, value)), .metadata = metadata(Kind.string, length) }
    }
}

pub fn ownedString(value: String) -> Argument {
    unsafe {
        return Argument.{ .value = @intFromPtr(value.pointer), .metadata = metadata(Kind.string, value.length) }
    }
}

pub fn pointer(address: usize) -> Argument {
    return Argument.{ .value = address, .metadata = metadata(Kind.pointer, 0) }
}

pub fn boolean(value: bool) -> Argument {
    var integer_value: usize = 0
    if value { integer_value = 1 }
    return Argument.{ .value = integer_value, .metadata = metadata(Kind.boolean, 0) }
}

pub fn kind(value: Argument) -> Kind {
    return @enumFromInt(Kind, @intCast(u8, value.metadata & 255))
}

pub fn stringValue(value: Argument) -> []const u8 {
    unsafe {
        return @ptrFromInt([*]const u8, value.value)[0..value.metadata >> 8]
    }
}
