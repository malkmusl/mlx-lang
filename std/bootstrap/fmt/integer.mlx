fn digitCharacter(digit: usize, uppercase: bool) -> u8 {
    if digit < 10 { return 48 + @intCast(u8, digit) }
    return (if uppercase { 55 } else { 87 }) + @intCast(u8, digit)
}

pub fn unsignedBase(value: usize, base: usize, uppercase: bool, destination: [*]u8, capacity: usize) -> usize {
    if capacity == 0 || base < 2 || base > 36 { return 0 }
    if value == 0 {
        destination[0] = 48
        return 1
    }

    var remaining = value
    var length: usize = 0
    while remaining > 0 && length < capacity {
        destination[length] = digitCharacter(remaining % base, uppercase)
        remaining = remaining / base
        length += 1
    }
    if remaining > 0 { return 0 }

    var left: usize = 0
    var right = length - 1
    while left < right {
        const temporary = destination[left]
        destination[left] = destination[right]
        destination[right] = temporary
        left += 1
        right -= 1
    }
    return length
}

pub fn unsignedDecimal(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return unsignedBase(value, 10, false, destination, capacity)
}

pub fn unsignedHex(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return unsignedBase(value, 16, false, destination, capacity)
}

pub fn unsignedHexUpper(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return unsignedBase(value, 16, true, destination, capacity)
}

pub fn unsignedBinary(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return unsignedBase(value, 2, false, destination, capacity)
}

pub fn unsignedOctal(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return unsignedBase(value, 8, false, destination, capacity)
}

pub fn signedMagnitude(value: isize) -> usize {
    if value >= 0 { return @intCast(usize, value) }
    return @intCast(usize, -(value + 1)) + 1
}

pub fn signedDecimal(value: isize, destination: [*]u8, capacity: usize) -> usize {
    if value >= 0 { return unsignedDecimal(@intCast(usize, value), destination, capacity) }
    if capacity < 2 { return 0 }
    destination[0] = 45
    unsafe {
        const digits = unsignedDecimal(
            signedMagnitude(value),
            @ptrFromInt([*]u8, @intFromPtr(destination) + 1),
            capacity - 1,
        )
        if digits == 0 { return 0 }
        return digits + 1
    }
}
