const allocator_module = @import("./allocator.mlx")
const mem = @import("./mem.mlx")

pub const Allocator = allocator_module.Allocator
pub const VTable = allocator_module.VTable

pub const State = struct {
    memory: [*]u8
    capacity: usize
    offset: usize
}

fn alignForward(value: usize, alignment: usize) -> usize {
    if alignment <= 1 { return value }
    return ((value + alignment - 1) / alignment) * alignment
}

fn allocate(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    unsafe {
        const state_pointer = @ptrCast(*State, context)
        var state = state_pointer.*
        const base = @intFromPtr(state.memory)
        const start = alignForward(base + state.offset, alignment) - base
        const end = start + length
        if end > state.capacity { return null }
        state_pointer.*.offset = end
        return @ptrFromInt([*]u8, @intFromPtr(state.memory) + start)
    }
}

// A bump allocator never grows or shrinks a block in place (a later
// allocation may already sit right after it), so resizes always remap.
fn resize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> bool {
    return false
}

fn remap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> ?[*]u8 {
    const replacement = allocate(context, new_length, alignment)
    if replacement == null { return null }
    const result = replacement.?
    mem.copy(result, memory, if length < new_length { length } else { new_length })
    return result
}

fn free(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {}

const VTABLE: VTable = VTable.{
    .alloc = allocate,
    .resize = resize,
    .remap = remap,
    .free = free,
}

pub fn init(memory: [*]u8, capacity: usize) -> State {
    return State.{ .memory = memory, .capacity = capacity, .offset = 0 }
}

pub fn interface(state: *State) -> Allocator {
    unsafe {
        return Allocator.{
            .ptr = @ptrCast(*anyopaque, state),
            .vtable = &VTABLE,
        }
    }
}

pub fn reset(state: *State) -> void {
    state.*.offset = 0
}
