pub fn isDigit(value: u8) -> bool {
    return value >= 48 && value <= 57
}

pub fn isLower(value: u8) -> bool {
    return value >= 97 && value <= 122
}

pub fn isUpper(value: u8) -> bool {
    return value >= 65 && value <= 90
}

pub fn isAlphabetic(value: u8) -> bool {
    return isLower(value) || isUpper(value)
}

pub fn isAlphanumeric(value: u8) -> bool {
    return isAlphabetic(value) || isDigit(value)
}

pub fn isWhitespace(value: u8) -> bool {
    return value == 32 || value == 9 || value == 10 || value == 13
}

pub fn isHexDigit(value: u8) -> bool {
    return isDigit(value) || (value >= 97 && value <= 102) || (value >= 65 && value <= 70)
}

pub fn toLower(value: u8) -> u8 {
    if isUpper(value) {
        return value + 32
    }
    return value
}

pub fn toUpper(value: u8) -> u8 {
    if isLower(value) {
        return value - 32
    }
    return value
}
