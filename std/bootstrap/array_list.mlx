const allocator_module = @import("./allocator.mlx")

pub const Allocator = allocator_module.Allocator
pub const AllocFn = allocator_module.AllocFn
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn

// Bootstrap specialization used by source buffers, names, and emitted bytes.
// Stage 1 can layer a generic ArrayList(T) over the same allocator contract.
pub const ArrayList = struct {
    items: [*]u8
    length: usize
    capacity: usize
    allocatorContext: usize
    allocFn: AllocFn
    resizeFn: ResizeFn
    freeFn: FreeFn

    pub fn init(allocator: Allocator, initial_capacity: usize) -> Self {
        const capacity = if initial_capacity > 0 { initial_capacity } else { 16 }
        return Self.{
            .items = allocator.alloc(capacity, 1).?,
            .length = 0,
            .capacity = capacity,
            .allocatorContext = allocator.context,
            .allocFn = allocator.allocFn,
            .resizeFn = allocator.resizeFn,
            .freeFn = allocator.freeFn,
        }
    }

    pub fn initAt(result: *Self, allocator: Allocator, initial_capacity: usize) -> void {
        const capacity = if initial_capacity > 0 { initial_capacity } else { 16 }
        result.*.items = allocator.alloc(capacity, 1).?
        result.*.length = 0
        result.*.capacity = capacity
        result.*.allocatorContext = allocator.context
        result.*.allocFn = allocator.allocFn
        result.*.resizeFn = allocator.resizeFn
        result.*.freeFn = allocator.freeFn
    }

    pub fn ensureCapacity(list: Self, minimum_capacity: usize) -> Self {
        var result = list
        if minimum_capacity <= result.capacity { return result }
        var new_capacity = result.capacity
        while new_capacity < minimum_capacity { new_capacity *= 2 }
        result.items = result.resizeFn(result.allocatorContext, result.items, result.capacity, new_capacity, 1).?
        result.capacity = new_capacity
        return result
    }

    pub fn appendAt(list: *Self, value: u8) -> bool {
        if list.*.length + 1 > list.*.capacity {
            var new_capacity = list.*.capacity * 2
            while new_capacity < list.*.length + 1 { new_capacity *= 2 }
            const resized = list.*.resizeFn(list.*.allocatorContext, list.*.items, list.*.capacity, new_capacity, 1)
            if resized == null { return false }
            list.*.items = resized.?
            list.*.capacity = new_capacity
        }
        list.*.items[list.*.length] = value
        list.*.length += 1
        return true
    }

    pub fn append(list: Self, value: u8) -> Self {
        var result = Self.ensureCapacity(list, list.length + 1)
        result.items[result.length] = value
        result.length += 1
        return result
    }

    pub fn resize(list: Self, new_length: usize, fill: u8) -> Self {
        var result = Self.ensureCapacity(list, new_length)
        while result.length < new_length {
            result.items[result.length] = fill
            result.length += 1
        }
        if new_length < result.length { result.length = new_length }
        return result
    }

    pub fn appendSlice(list: Self, values: []const u8) -> Self {
        var result = list
        for value in values { result = Self.append(result, value) }
        return result
    }

    pub inline fn get(list: Self, index: usize) -> u8 { return list.items[index] }

    pub fn set(list: Self, index: usize, value: u8) -> void { list.items[index] = value }

    pub fn clear(list: Self) -> Self {
        var result = list
        result.length = 0
        return result
    }

    pub inline fn last(list: Self) -> u8 { return list.items[list.length - 1] }

    pub fn pop(list: Self) -> Self {
        if list.length == 0 { return list }
        var result = list
        result.length -= 1
        return result
    }

    pub inline fn asSlice(list: Self) -> []const u8 {
        unsafe { return @ptrCast([*]const u8, list.items)[0..list.length] }
    }

    pub fn deinit(list: Self) -> void {
        list.freeFn(list.allocatorContext, list.items, list.capacity, 1)
    }
}
