const allocator_module = @import("./allocator.mlx")
const mem = @import("./mem.mlx")

pub const Allocator = allocator_module.Allocator

pub const Arena = struct {
    memory: [*]u8
    capacity: usize
    offset: usize
    child: Allocator
}

fn alignForward(value: usize, alignment: usize) -> usize {
    if alignment <= 1 { return value }
    return ((value + alignment - 1) / alignment) * alignment
}

fn arenaAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    unsafe {
        const arena_pointer = @ptrCast(*Arena, context)
        var arena = arena_pointer.*
        const base = @intFromPtr(arena.memory)
        const start = alignForward(base + arena.offset, alignment) - base
        const end = start + length
        if end > arena.capacity { return null }
        arena_pointer.*.offset = end
        return @ptrFromInt([*]u8, @intFromPtr(arena.memory) + start)
    }
}

// An arena never grows or shrinks a block in place, so resizes always remap.
fn arenaResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> bool {
    return false
}

fn arenaRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> ?[*]u8 {
    const replacement = arenaAlloc(context, new_length, alignment)
    if replacement == null { return null }
    const result = replacement.?
    mem.copy(result, memory, if length < new_length { length } else { new_length })
    return result
}

fn arenaFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {}

pub fn init(child: Allocator, capacity: usize) -> Arena {
    return Arena.{
        .memory = child.alloc(capacity, 16).?,
        .capacity = capacity,
        .offset = 0,
        .child = child,
    }
}

pub fn interface(arena: *Arena) -> Allocator {
    unsafe {
        return Allocator.{
            .context = @ptrCast(*anyopaque, arena),
            .allocFn = arenaAlloc,
            .resizeFn = arenaResize,
            .remapFn = arenaRemap,
            .freeFn = arenaFree,
        }
    }
}

pub fn reset(arena: *Arena) -> void {
    arena.*.offset = 0
}

pub fn deinit(arena: *Arena) -> void {
    arena.*.child.free(arena.*.memory, arena.*.capacity, 16)
    arena.*.offset = 0
}
