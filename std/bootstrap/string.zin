pub const String = struct {
    pointer: [*]const u8
    length: usize
}

pub fn fromSlice(bytes: []const u8) -> String {
    var length: usize = 0
    for byte in bytes {
        length += 1
    }
    unsafe {
        return String.{
            .pointer = @ptrCast([*]const u8, bytes),
            .length = length,
        }
    }
}

pub fn asSlice(value: String) -> []const u8 {
    return value.pointer[0..value.length]
}

pub fn eql(left: String, right: String) -> bool {
    if left.length != right.length {
        return false
    }
    var index: usize = 0
    while index < left.length {
        if left.pointer[index] != right.pointer[index] {
            return false
        }
        index += 1
    }
    return true
}

pub fn startsWith(value: String, prefix: String) -> bool {
    if prefix.length > value.length {
        return false
    }
    var index: usize = 0
    while index < prefix.length {
        if value.pointer[index] != prefix.pointer[index] {
            return false
        }
        index += 1
    }
    return true
}

pub fn hash(value: String) -> usize {
    var result: usize = 14695981039346656037
    var index: usize = 0
    while index < value.length {
        result = (result ^ @intCast(usize, value.pointer[index])) *% 1099511628211
        index += 1
    }
    return result
}
