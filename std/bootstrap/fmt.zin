pub fn unsignedDecimal(value: usize, destination: [*]u8, capacity: usize) -> usize {
    if capacity == 0 {
        return 0
    }
    if value == 0 {
        destination[0] = 48
        return 1
    }
    var remaining = value
    var length: usize = 0
    while remaining > 0 && length < capacity {
        destination[length] = 48 + @intCast(u8, remaining % 10)
        remaining = remaining / 10
        length += 1
    }
    var left: usize = 0
    var right = length - 1
    while left < right {
        const temporary = destination[left]
        destination[left] = destination[right]
        destination[right] = temporary
        left += 1
        right -= 1
    }
    return length
}

pub fn unsignedHex(value: usize, destination: [*]u8, capacity: usize) -> usize {
    if capacity == 0 {
        return 0
    }
    if value == 0 {
        destination[0] = 48
        return 1
    }
    var remaining = value
    var length: usize = 0
    while remaining > 0 && length < capacity {
        const digit = @intCast(u8, remaining % 16)
        destination[length] = if digit < 10 { 48 + digit } else { 87 + digit }
        remaining = remaining / 16
        length += 1
    }
    var left: usize = 0
    var right = length - 1
    while left < right {
        const temporary = destination[left]
        destination[left] = destination[right]
        destination[right] = temporary
        left += 1
        right -= 1
    }
    return length
}
