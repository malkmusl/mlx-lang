const allocator_module = @import("./allocator.zin")
const strings = @import("./string.zin")

pub const Allocator = allocator_module.Allocator
pub const String = strings.String
pub const AllocFn = allocator_module.AllocFn
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn

// Allocation-backed open-addressing map used for compiler symbol tables.
// It intentionally starts as String -> usize; Stage 1 will genericize it.
pub const HashMap = struct {
    hashes: [*]usize
    keyPointers: [*][*]const u8
    keyLengths: [*]usize
    values: [*]usize
    occupied: [*]u8
    length: usize
    capacity: usize
    allocatorContext: usize
    allocFn: AllocFn
    resizeFn: ResizeFn
    freeFn: FreeFn
}

pub fn init(allocator: Allocator, requested_capacity: usize) -> HashMap {
    const capacity = if requested_capacity > 7 { requested_capacity } else { 8 }
    const hashes_memory = allocator.allocFn(allocator.context, capacity * 8, 8).?
    const pointers_memory = allocator.allocFn(allocator.context, capacity * 8, 8).?
    const lengths_memory = allocator.allocFn(allocator.context, capacity * 8, 8).?
    const values_memory = allocator.allocFn(allocator.context, capacity * 8, 8).?
    const occupied_memory = allocator.allocFn(allocator.context, capacity, 1).?
    var index: usize = 0
    while index < capacity {
        occupied_memory[index] = 0
        index += 1
    }
    unsafe {
        return HashMap.{
            .hashes = @ptrCast([*]usize, hashes_memory),
            .keyPointers = @ptrCast([*][*]const u8, pointers_memory),
            .keyLengths = @ptrCast([*]usize, lengths_memory),
            .values = @ptrCast([*]usize, values_memory),
            .occupied = occupied_memory,
            .length = 0,
            .capacity = capacity,
            .allocatorContext = allocator.context,
            .allocFn = allocator.allocFn,
            .resizeFn = allocator.resizeFn,
            .freeFn = allocator.freeFn,
        }
    }
}

fn keyMatches(stored_hash: usize, stored_pointer: [*]const u8, stored_length: usize, key_pointer: [*]const u8, key_length: usize, hash_value: usize) -> bool {
    if stored_hash != hash_value || stored_length != key_length {
        return false
    }
    var byte_index: usize = 0
    while byte_index < key_length {
        if stored_pointer[byte_index] != key_pointer[byte_index] {
            return false
        }
        byte_index += 1
    }
    return true
}

pub fn put(map: HashMap, key: String, value: usize) -> HashMap {
    var result = map
    if result.length * 2 >= result.capacity {
        result = grow(result)
    }
    const hash_value = strings.hash(key)
    var index = hash_value % result.capacity
    while result.occupied[index] != 0 {
        if keyMatches(result.hashes[index], result.keyPointers[index], result.keyLengths[index], key.pointer, key.length, hash_value) {
            result.values[index] = value
            return result
        }
        index = (index + 1) % result.capacity
    }
    result.occupied[index] = 1
    result.hashes[index] = hash_value
    result.keyPointers[index] = key.pointer
    result.keyLengths[index] = key.length
    result.values[index] = value
    result.length += 1
    return result
}

fn grow(map: HashMap) -> HashMap {
    var result = init(Allocator.{
        .context = map.allocatorContext,
        .allocFn = map.allocFn,
        .resizeFn = map.resizeFn,
        .freeFn = map.freeFn,
    }, map.capacity * 2)
    var index: usize = 0
    while index < map.capacity {
        if map.occupied[index] != 0 {
            result = put(result, String.{
                .pointer = map.keyPointers[index],
                .length = map.keyLengths[index],
            }, map.values[index])
        }
        index += 1
    }
    deinit(map)
    return result
}

pub fn get(map: HashMap, key: String) -> (bool, usize) {
    const hash_value = strings.hash(key)
    var index = hash_value % map.capacity
    var probes: usize = 0
    while probes < map.capacity {
        if map.occupied[index] == 0 {
            return -> (false, 0)
        }
        if keyMatches(map.hashes[index], map.keyPointers[index], map.keyLengths[index], key.pointer, key.length, hash_value) {
            return -> (true, map.values[index])
        }
        index = (index + 1) % map.capacity
        probes += 1
    }
    return -> (false, 0)
}

pub fn contains(map: HashMap, key: String) -> bool {
    const result = get(map, key)
    return result.0
}

pub fn deinit(map: HashMap) -> void {
    unsafe {
        map.freeFn(map.allocatorContext, @ptrCast([*]u8, map.hashes), map.capacity * 8, 8)
        map.freeFn(map.allocatorContext, @ptrCast([*]u8, map.keyPointers), map.capacity * 8, 8)
        map.freeFn(map.allocatorContext, @ptrCast([*]u8, map.keyLengths), map.capacity * 8, 8)
        map.freeFn(map.allocatorContext, @ptrCast([*]u8, map.values), map.capacity * 8, 8)
    }
    map.freeFn(map.allocatorContext, map.occupied, map.capacity, 1)
}
