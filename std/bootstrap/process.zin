const string = @import("./string.zin")

pub const String = string.String

pub fn count(arguments: [][*]const u8) -> usize {
    var result: usize = 0
    for argument_pointer in arguments {
        result += 1
    }
    return result
}

pub fn fromCString(pointer: [*]const u8) -> String {
    var length: usize = 0
    while pointer[length] != 0 {
        length += 1
    }
    return string.fromParts(pointer, length)
}

pub fn argument(arguments: [][*]const u8, index: usize) -> String {
    if index >= count(arguments) {
        unsafe {
            return string.fromParts(@ptrFromInt([*]const u8, 0), 0)
        }
    }
    return fromCString(arguments[index])
}
