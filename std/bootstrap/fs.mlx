const linux = @import("./os/linux.mlx")
const allocator_module = @import("./allocator.mlx")
const lists = @import("./array_list.mlx")

pub const Allocator = allocator_module.Allocator
pub const ArrayList = lists.ArrayList

pub const File = struct {
    descriptor: isize
}

pub const Pipe = struct {
    readDescriptor: isize
    writeDescriptor: isize
}

pub const Stat = struct {
    device: usize
    inode: usize
    links: usize
    mode: u32
    user: u32
    group: u32
    padding: u32
    specialDevice: usize
    size: isize
    blockSize: isize
    blocks: isize
    accessedSeconds: isize
    accessedNanoseconds: isize
    modifiedSeconds: isize
    modifiedNanoseconds: isize
    changedSeconds: isize
    changedNanoseconds: isize
    reserved0: isize
    reserved1: isize
    reserved2: isize
}

pub const READ_ONLY: usize = 0
pub const WRITE_ONLY: usize = 1
pub const READ_WRITE: usize = 2
pub const CREATE: usize = 64
pub const TRUNCATE: usize = 512
pub const APPEND: usize = 1024
pub const SEEK_START: usize = 0
pub const SEEK_CURRENT: usize = 1
pub const SEEK_END: usize = 2
pub const SET_PIPE_SIZE: usize = 1031

pub fn open(path: [*]const u8, flags: usize, mode: usize) -> File {
    return File.{ .descriptor = linux.syscall3(linux.SYS_open, @intFromPtr(path), flags, mode) }
}

pub fn close(file: File) -> bool {
    return linux.syscall1(linux.SYS_close, @bitCast(usize, file.descriptor)) == 0
}

pub fn makePipe() -> ?Pipe {
    var descriptors: [2]i32 = [2]i32{ -1, -1 }
    if linux.syscall2(linux.SYS_pipe2, @intFromPtr(&descriptors), 0) < 0 { return null }
    return Pipe.{
        .readDescriptor = @intCast(isize, descriptors[0]),
        .writeDescriptor = @intCast(isize, descriptors[1]),
    }
}

pub fn setPipeSize(file: File, length: usize) -> bool {
    return linux.syscall3(linux.SYS_fcntl, @bitCast(usize, file.descriptor), SET_PIPE_SIZE, length) >= 0
}

pub fn splice(source: File, destination: File, length: usize) -> isize {
    return linux.syscall6(
        linux.SYS_splice,
        @bitCast(usize, source.descriptor),
        0,
        @bitCast(usize, destination.descriptor),
        0,
        length,
        0,
    )
}

pub fn isValid(file: File) -> bool {
    return file.descriptor >= 0
}

pub fn status(path: [*]const u8, result: *Stat) -> isize {
    return linux.syscall2(linux.SYS_stat, @intFromPtr(path), @intFromPtr(result))
}

pub fn fileStatus(file: File, result: *Stat) -> isize {
    return linux.syscall2(linux.SYS_fstat, @bitCast(usize, file.descriptor), @intFromPtr(result))
}

pub fn getWorkingDirectory(destination: [*]u8, length: usize) -> isize {
    return linux.syscall2(linux.SYS_getcwd, @intFromPtr(destination), length)
}

pub fn read(file: File, destination: [*]u8, length: usize) -> isize {
    return linux.syscall3(linux.SYS_read, @bitCast(usize, file.descriptor), @intFromPtr(destination), length)
}

pub fn write(file: File, source: [*]const u8, length: usize) -> isize {
    return linux.syscall3(linux.SYS_write, @bitCast(usize, file.descriptor), @intFromPtr(source), length)
}

pub fn writeAllBytes(file: File, source: [*]const u8, length: usize) -> bool {
    var written: usize = 0
    while written < length {
        unsafe {
            const current = @ptrFromInt([*]const u8, @intFromPtr(source) + written)
            const result = write(file, current, length - written)
            if result <= 0 { return false }
            written += @bitCast(usize, result)
        }
    }
    return true
}

pub fn pread(file: File, destination: [*]u8, length: usize, offset: usize) -> isize {
    return linux.syscall4(linux.SYS_pread64, @bitCast(usize, file.descriptor), @intFromPtr(destination), length, offset)
}

pub fn pwrite(file: File, source: [*]const u8, length: usize, offset: usize) -> isize {
    return linux.syscall4(linux.SYS_pwrite64, @bitCast(usize, file.descriptor), @intFromPtr(source), length, offset)
}

pub fn seek(file: File, offset: isize, origin: usize) -> isize {
    return linux.syscall3(linux.SYS_lseek, @bitCast(usize, file.descriptor), @bitCast(usize, offset), origin)
}

pub fn delete(path: [*]const u8) -> bool {
    return linux.syscall1(linux.SYS_unlink, @intFromPtr(path)) == 0
}

pub fn hardLink(source: [*]const u8, destination: [*]const u8) -> bool {
    return linux.syscall2(linux.SYS_link, @intFromPtr(source), @intFromPtr(destination)) == 0
}

pub fn rename(old_path: [*]const u8, new_path: [*]const u8) -> bool {
    return linux.syscall2(linux.SYS_rename, @intFromPtr(old_path), @intFromPtr(new_path)) == 0
}

pub fn makeDirResult(path: [*]const u8, mode: usize) -> isize {
    return linux.syscall2(linux.SYS_mkdir, @intFromPtr(path), mode)
}

pub fn makeDir(path: [*]const u8, mode: usize) -> bool {
    return makeDirResult(path, mode) == 0
}

pub fn removeDirResult(path: [*]const u8) -> isize {
    return linux.syscall1(linux.SYS_rmdir, @intFromPtr(path))
}

pub fn removeDir(path: [*]const u8) -> bool {
    return removeDirResult(path) == 0
}

pub fn chmod(path: [*]const u8, mode: usize) -> bool {
    return linux.syscall2(linux.SYS_chmod, @intFromPtr(path), mode) == 0
}

pub fn truncate(file: File, length: usize) -> bool {
    return linux.syscall2(linux.SYS_ftruncate, @bitCast(usize, file.descriptor), length) == 0
}

pub fn writeAll(file: File, source: []const u8) -> bool {
    var length: usize = 0
    for byte in source {
        length += 1
    }
    unsafe {
        return writeAllBytes(file, @ptrCast([*]const u8, source), length)
    }
}

pub fn readToEnd(file: File, buffer: ArrayList) -> ArrayList {
    var result = buffer
    while true {
        result = lists.ArrayList.ensureCapacity(result, result.length + 4096)
        const available = result.capacity - result.length
        unsafe {
            const destination = @ptrFromInt([*]u8, @intFromPtr(result.items) + result.length)
            const amount = read(file, destination, available)
            if amount <= 0 {
                return result
            }
            result.length += @bitCast(usize, amount)
        }
    }
    return result
}

pub fn readToEndAlloc(file: File, allocator: Allocator) -> ArrayList {
    return readToEnd(file, lists.ArrayList.init(allocator, 4096))
}
