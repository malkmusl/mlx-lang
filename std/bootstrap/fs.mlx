const linux = @import("./os/linux.mlx")
const allocator_module = @import("./allocator.mlx")
const lists = @import("./array_list.mlx")
const page_allocator = @import("./page_allocator.mlx")

const COPY_BUFFER_SIZE: usize = 65536
const COPY_SPLICE_SIZE: usize = 524288

pub const Allocator = allocator_module.Allocator
pub const ArrayList = lists.ArrayList

pub const File = struct {
    descriptor: isize
}

pub const Pipe = struct {
    readDescriptor: isize
    writeDescriptor: isize
}

pub const Stat = struct {
    device: usize
    inode: usize
    links: usize
    mode: u32
    user: u32
    group: u32
    padding: u32
    specialDevice: usize
    size: isize
    blockSize: isize
    blocks: isize
    accessedSeconds: isize
    accessedNanoseconds: isize
    modifiedSeconds: isize
    modifiedNanoseconds: isize
    changedSeconds: isize
    changedNanoseconds: isize
    reserved0: isize
    reserved1: isize
    reserved2: isize
}

pub const FileSystemStat = struct {
    fileSystemType: isize
    blockSize: isize
    blocks: usize
    blocksFree: usize
    blocksAvailable: usize
    files: usize
    filesFree: usize
    fileSystemId0: i32
    fileSystemId1: i32
    nameLength: isize
    fragmentSize: isize
    mountFlags: isize
    spare0: isize
    spare1: isize
    spare2: isize
    spare3: isize
}

pub const StatxTimestamp = struct {
    seconds: isize
    nanoseconds: u32
    reserved: i32
}

pub const Statx = struct {
    mask: u32
    blockSize: u32
    attributes: usize
    links: u32
    user: u32
    group: u32
    mode: u16
    padding: u16
    inode: usize
    size: usize
    blocks: usize
    attributesMask: usize
    accessed: StatxTimestamp
    born: StatxTimestamp
    changed: StatxTimestamp
    modified: StatxTimestamp
    specialDeviceMajor: u32
    specialDeviceMinor: u32
    deviceMajor: u32
    deviceMinor: u32
    mountId: usize
    directIoMemoryAlignment: u32
    directIoOffsetAlignment: u32
    spare: [12]usize
}

pub const Timespec = struct {
    seconds: isize
    nanoseconds: isize
}

pub const READ_ONLY: usize = 0
pub const WRITE_ONLY: usize = 1
pub const READ_WRITE: usize = 2
pub const CREATE: usize = 64
pub const TRUNCATE: usize = 512
pub const APPEND: usize = 1024
pub const DIRECTORY: usize = 65536
pub const NO_FOLLOW: usize = 131072
pub const SEEK_START: usize = 0
pub const SEEK_CURRENT: usize = 1
pub const SEEK_END: usize = 2
pub const SET_PIPE_SIZE: usize = 1031
pub const UTIME_NOW: isize = 1073741823
pub const UTIME_OMIT: isize = 1073741822
const AT_CURRENT_WORKING_DIRECTORY: usize = 18446744073709551516
const AT_SYMLINK_NOFOLLOW: usize = 256
const STATX_BIRTH_TIME: usize = 2048

pub fn open(path: [*]const u8, flags: usize, mode: usize) -> File {
    return File.{ .descriptor = linux.syscall3(linux.SYS_open, @intFromPtr(path), flags, mode) }
}

pub const ACCESS_EXISTS: usize = 0
pub const ACCESS_EXECUTE: usize = 1
pub const ACCESS_WRITE: usize = 2
pub const ACCESS_READ: usize = 4

pub fn access(path: [*]const u8, mode: usize) -> bool {
    return linux.syscall2(linux.SYS_access, @intFromPtr(path), mode) == 0
}

pub fn openAt(directory: File, path: [*]const u8, flags: usize, mode: usize) -> File {
    return File.{ .descriptor = linux.syscall4(linux.SYS_openat, @bitCast(usize, directory.descriptor), @intFromPtr(path), flags, mode) }
}

pub fn close(file: File) -> bool {
    return linux.syscall1(linux.SYS_close, @bitCast(usize, file.descriptor)) == 0
}

pub fn makePipe() -> ?Pipe {
    var descriptors: [2]i32 = [2]i32{ -1, -1 }
    if linux.syscall2(linux.SYS_pipe2, @intFromPtr(&descriptors), 0) < 0 { return null }
    return Pipe.{
        .readDescriptor = @intCast(isize, descriptors[0]),
        .writeDescriptor = @intCast(isize, descriptors[1]),
    }
}

pub fn setPipeSize(file: File, length: usize) -> bool {
    return linux.syscall3(linux.SYS_fcntl, @bitCast(usize, file.descriptor), SET_PIPE_SIZE, length) >= 0
}

pub fn splice(source: File, destination: File, length: usize) -> isize {
    return linux.syscall6(
        linux.SYS_splice,
        @bitCast(usize, source.descriptor),
        0,
        @bitCast(usize, destination.descriptor),
        0,
        length,
        0,
    )
}

pub fn isValid(file: File) -> bool {
    return file.descriptor >= 0
}

pub fn status(path: [*]const u8, result: *Stat) -> isize {
    return linux.syscall2(linux.SYS_stat, @intFromPtr(path), @intFromPtr(result))
}

pub fn statusAt(path: [*]const u8, result: *Stat, no_follow: bool) -> isize {
    const flags: usize = if no_follow { AT_SYMLINK_NOFOLLOW } else { 0 }
    return linux.syscall4(linux.SYS_newfstatat, AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(path), @intFromPtr(result), flags)
}

pub fn statusFrom(directory: File, path: [*]const u8, result: *Stat, no_follow: bool) -> isize {
    const flags: usize = if no_follow { AT_SYMLINK_NOFOLLOW } else { 0 }
    return linux.syscall4(linux.SYS_newfstatat, @bitCast(usize, directory.descriptor), @intFromPtr(path), @intFromPtr(result), flags)
}

pub fn fileStatus(file: File, result: *Stat) -> isize {
    return linux.syscall2(linux.SYS_fstat, @bitCast(usize, file.descriptor), @intFromPtr(result))
}

pub fn fileSystemStatus(path: [*]const u8, result: *FileSystemStat) -> isize {
    return linux.syscall2(linux.SYS_statfs, @intFromPtr(path), @intFromPtr(result))
}

pub fn extendedStatus(path: [*]const u8, result: *Statx, no_follow: bool) -> isize {
    const flags: usize = if no_follow { AT_SYMLINK_NOFOLLOW } else { 0 }
    return linux.syscall5(linux.SYS_statx, AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(path), flags, STATX_BIRTH_TIME, @intFromPtr(result))
}

pub fn extendedStatusFrom(directory: File, path: [*]const u8, result: *Statx, no_follow: bool) -> isize {
    const flags: usize = if no_follow { AT_SYMLINK_NOFOLLOW } else { 0 }
    return linux.syscall5(linux.SYS_statx, @bitCast(usize, directory.descriptor), @intFromPtr(path), flags, STATX_BIRTH_TIME, @intFromPtr(result))
}

pub fn getWorkingDirectory(destination: [*]u8, length: usize) -> isize {
    return linux.syscall2(linux.SYS_getcwd, @intFromPtr(destination), length)
}

pub fn changeDirectory(path: [*]const u8) -> bool {
    return linux.syscall1(linux.SYS_chdir, @intFromPtr(path)) == 0
}

pub fn read(file: File, destination: [*]u8, length: usize) -> isize {
    return linux.syscall3(linux.SYS_read, @bitCast(usize, file.descriptor), @intFromPtr(destination), length)
}

pub fn readDirectory(file: File, destination: [*]u8, length: usize) -> isize {
    return linux.syscall3(linux.SYS_getdents64, @bitCast(usize, file.descriptor), @intFromPtr(destination), length)
}

pub fn write(file: File, source: [*]const u8, length: usize) -> isize {
    return linux.syscall3(linux.SYS_write, @bitCast(usize, file.descriptor), @intFromPtr(source), length)
}

pub fn writeAllBytes(file: File, source: [*]const u8, length: usize) -> bool {
    var written: usize = 0
    while written < length {
        unsafe {
            const current = @ptrFromInt([*]const u8, @intFromPtr(source) + written)
            const result = write(file, current, length - written)
            if result <= 0 { return false }
            written += @bitCast(usize, result)
        }
    }
    return true
}

pub fn pread(file: File, destination: [*]u8, length: usize, offset: usize) -> isize {
    return linux.syscall4(linux.SYS_pread64, @bitCast(usize, file.descriptor), @intFromPtr(destination), length, offset)
}

pub fn pwrite(file: File, source: [*]const u8, length: usize, offset: usize) -> isize {
    return linux.syscall4(linux.SYS_pwrite64, @bitCast(usize, file.descriptor), @intFromPtr(source), length, offset)
}

pub fn seek(file: File, offset: isize, origin: usize) -> isize {
    return linux.syscall3(linux.SYS_lseek, @bitCast(usize, file.descriptor), @bitCast(usize, offset), origin)
}

pub fn delete(path: [*]const u8) -> bool {
    return linux.syscall1(linux.SYS_unlink, @intFromPtr(path)) == 0
}

pub fn deleteAt(directory: File, path: [*]const u8, is_directory: bool) -> bool {
    const flags: usize = if is_directory { 512 } else { 0 }
    return linux.syscall3(linux.SYS_unlinkat, @bitCast(usize, directory.descriptor), @intFromPtr(path), flags) == 0
}

pub fn hardLink(source: [*]const u8, destination: [*]const u8) -> bool {
    return linux.syscall2(linux.SYS_link, @intFromPtr(source), @intFromPtr(destination)) == 0
}

pub fn hardLinkFollow(source: [*]const u8, destination: [*]const u8) -> bool {
    return linux.syscall5(linux.SYS_linkat, AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(source), AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(destination), 1024) == 0
}

pub fn symbolicLink(target: [*]const u8, link_path: [*]const u8) -> bool {
    return linux.syscall2(linux.SYS_symlink, @intFromPtr(target), @intFromPtr(link_path)) == 0
}

pub fn readLink(path: [*]const u8, destination: [*]u8, length: usize) -> isize {
    return linux.syscall3(linux.SYS_readlink, @intFromPtr(path), @intFromPtr(destination), length)
}

pub fn getExtendedAttribute(path: [*]const u8, name: [*]const u8, destination: [*]u8, length: usize, no_follow: bool) -> isize {
    const syscall = if no_follow { linux.SYS_lgetxattr } else { linux.SYS_getxattr }
    return linux.syscall4(syscall, @intFromPtr(path), @intFromPtr(name), @intFromPtr(destination), length)
}

pub fn rename(old_path: [*]const u8, new_path: [*]const u8) -> bool {
    return linux.syscall2(linux.SYS_rename, @intFromPtr(old_path), @intFromPtr(new_path)) == 0
}

pub fn renameWithFlags(old_path: [*]const u8, new_path: [*]const u8, flags: usize) -> bool {
    return linux.syscall5(linux.SYS_renameat2, AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(old_path), AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(new_path), flags) == 0
}

pub fn makeDirResult(path: [*]const u8, mode: usize) -> isize {
    return linux.syscall2(linux.SYS_mkdir, @intFromPtr(path), mode)
}

pub fn makeDir(path: [*]const u8, mode: usize) -> bool {
    return makeDirResult(path, mode) == 0
}

pub fn makeFifo(path: [*]const u8, mode: usize) -> bool {
    const fifo_type: usize = 4096
    return linux.syscall3(linux.SYS_mknod, @intFromPtr(path), fifo_type | mode, 0) == 0
}

pub fn removeDirResult(path: [*]const u8) -> isize {
    return linux.syscall1(linux.SYS_rmdir, @intFromPtr(path))
}

pub fn removeDir(path: [*]const u8) -> bool {
    return removeDirResult(path) == 0
}

pub fn chmod(path: [*]const u8, mode: usize) -> bool {
    return linux.syscall2(linux.SYS_chmod, @intFromPtr(path), mode) == 0
}

pub fn chmodAt(directory: File, path: [*]const u8, mode: usize) -> bool {
    return linux.syscall4(linux.SYS_fchmodat, @bitCast(usize, directory.descriptor), @intFromPtr(path), mode, 0) == 0
}

pub fn changeOwner(path: [*]const u8, user: usize, group: usize, no_follow: bool) -> bool {
    const number = if no_follow { linux.SYS_lchown } else { linux.SYS_chown }
    return linux.syscall3(number, @intFromPtr(path), user, group) == 0
}

pub fn changeOwnerAt(directory: File, path: [*]const u8, user: usize, group: usize, no_follow: bool) -> bool {
    const flags: usize = if no_follow { AT_SYMLINK_NOFOLLOW } else { 0 }
    return linux.syscall5(linux.SYS_fchownat, @bitCast(usize, directory.descriptor), @intFromPtr(path), user, group, flags) == 0
}

pub fn currentUmask() -> usize {
    const previous = linux.syscall1(linux.SYS_umask, 0)
    const restored = linux.syscall1(linux.SYS_umask, @bitCast(usize, previous))
    return @bitCast(usize, previous)
}

pub fn updateTimes(path: [*]const u8) -> bool {
    return linux.syscall4(linux.SYS_utimensat, AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(path), 0, 0) == 0
}

pub fn setTimes(path: [*]const u8, accessed_seconds: isize, accessed_nanoseconds: isize, modified_seconds: isize, modified_nanoseconds: isize, no_follow: bool) -> bool {
    var times: [2]Timespec = undefined
    times[0].seconds = accessed_seconds
    times[0].nanoseconds = accessed_nanoseconds
    times[1].seconds = modified_seconds
    times[1].nanoseconds = modified_nanoseconds
    const flags: usize = if no_follow { AT_SYMLINK_NOFOLLOW } else { 0 }
    return linux.syscall4(linux.SYS_utimensat, AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(path), @intFromPtr(&times), flags) == 0
}

pub fn setDescriptorTimes(file: File, accessed_seconds: isize, accessed_nanoseconds: isize, modified_seconds: isize, modified_nanoseconds: isize) -> bool {
    var times: [2]Timespec = undefined
    times[0].seconds = accessed_seconds
    times[0].nanoseconds = accessed_nanoseconds
    times[1].seconds = modified_seconds
    times[1].nanoseconds = modified_nanoseconds
    return linux.syscall4(linux.SYS_utimensat, @bitCast(usize, file.descriptor), 0, @intFromPtr(&times), 0) == 0
}

pub fn truncate(file: File, length: usize) -> bool {
    return linux.syscall2(linux.SYS_ftruncate, @bitCast(usize, file.descriptor), length) == 0
}

pub fn syncAll() -> bool {
    return linux.syscall0(linux.SYS_sync) == 0
}

pub fn syncFile(file: File, data_only: bool) -> bool {
    const number = if data_only { linux.SYS_fdatasync } else { linux.SYS_fsync }
    return linux.syscall1(number, @bitCast(usize, file.descriptor)) == 0
}

pub fn syncFileSystem(file: File) -> bool {
    return linux.syscall1(linux.SYS_syncfs, @bitCast(usize, file.descriptor)) == 0
}

pub fn writeAll(file: File, source: []const u8) -> bool {
    var length: usize = 0
    for byte in source {
        length += 1
    }
    unsafe {
        return writeAllBytes(file, @ptrCast([*]const u8, source), length)
    }
}

pub fn readToEnd(file: File, buffer: ArrayList) -> ArrayList {
    var result = buffer
    while true {
        result = lists.ArrayList.ensureCapacity(result, result.length + 4096)
        const available = result.capacity - result.length
        unsafe {
            const destination = @ptrFromInt([*]u8, @intFromPtr(result.items) + result.length)
            const amount = read(file, destination, available)
            if amount <= 0 {
                return result
            }
            result.length += @bitCast(usize, amount)
        }
    }
    return result
}

pub fn readToEndAlloc(file: File, allocator: Allocator) -> ArrayList {
    return readToEnd(file, lists.ArrayList.init(allocator, 4096))
}

fn copyBuffered(source: File, destination: File) -> bool {
    const allocator: page_allocator.Allocator = page_allocator.init()
    const allocation = allocator.alloc(COPY_BUFFER_SIZE, 8)
    if allocation == null { return false }
    const buffer = allocation.?
    var success = false
    while true {
        var amount: isize = 0
        unsafe {
            amount = read(source, buffer, COPY_BUFFER_SIZE)
        }
        if amount < 0 { break }
        if amount == 0 {
            success = true
            break
        }
        const length = @bitCast(usize, amount)
        if !writeAllBytes(destination, buffer, length) { break }
    }
    allocator.free(buffer, COPY_BUFFER_SIZE, 8)
    return success
}

fn closeCopyPipe(pipe: Pipe) -> bool {
    const read_closed = close(File.{ .descriptor = pipe.readDescriptor })
    const write_closed = close(File.{ .descriptor = pipe.writeDescriptor })
    return read_closed && write_closed
}

fn finishBufferedCopy(source: File, read_end: File, write_end: File, destination: File) -> bool {
    const write_closed = close(write_end)
    const drained = copyBuffered(read_end, destination)
    const read_closed = close(read_end)
    if !drained { return false }
    return copyBuffered(source, destination)
}

fn copySpliced(source: File, destination: File) -> ?bool {
    const created = makePipe()
    if created == null { return null }
    const pipe = created.?
    const read_end = File.{ .descriptor = pipe.readDescriptor }
    const write_end = File.{ .descriptor = pipe.writeDescriptor }
    const resized = setPipeSize(write_end, COPY_SPLICE_SIZE)
    var transferred = false
    while true {
        const amount = splice(source, write_end, COPY_SPLICE_SIZE)
        if amount < 0 {
            const closed = closeCopyPipe(pipe)
            if !transferred { return null }
            return false
        }
        if amount == 0 { return closeCopyPipe(pipe) }
        transferred = true
        var remaining = @bitCast(usize, amount)
        while remaining > 0 {
            const written = splice(read_end, destination, remaining)
            if written <= 0 {
                return finishBufferedCopy(source, read_end, write_end, destination)
            }
            remaining -= @bitCast(usize, written)
        }
    }
    return false
}

pub fn copy(source: File, destination: File) -> bool {
    const spliced = copySpliced(source, destination)
    if spliced != null { return spliced.? }
    return copyBuffered(source, destination)
}
