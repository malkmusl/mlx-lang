const string = @import("./string.mlx")
const page_allocator = @import("./page_allocator.mlx")
const process = @import("./process.mlx")

pub const Arguments = struct {
    items: [*][*]const u8
    length: usize
    itemBytes: usize
    storage: [*]u8
    storageBytes: usize
    valid: bool
}

fn invalid() -> Arguments {
    unsafe {
        return Arguments.{ .items = @ptrFromInt([*][*]const u8, 0), .length = 0, .itemBytes = 0, .storage = @ptrFromInt([*]u8, 0), .storageBytes = 0, .valid = false }
    }
}

fn whitespace(byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13
}

fn escapedByte(byte: u8) -> u8 {
    if byte == 110 { return 10 }
    if byte == 114 { return 13 }
    if byte == 116 { return 9 }
    if byte == 102 { return 12 }
    if byte == 118 { return 11 }
    if byte == 95 { return 32 }
    return byte
}

fn allocate(text_length: usize, appended: usize) -> Arguments {
    const allocator = page_allocator.init()
    const storage_bytes = text_length + 1
    const item_bytes = (text_length + appended + 2) * @sizeOf([*]const u8)
    const storage = allocator.alloc(storage_bytes, 1)
    const item_memory = allocator.alloc(item_bytes, @alignOf([*]const u8))
    if storage == null || item_memory == null { return invalid() }
    unsafe {
        return Arguments.{ .items = @ptrCast([*][*]const u8, item_memory.?), .length = 0, .itemBytes = item_bytes, .storage = storage.?, .storageBytes = storage_bytes, .valid = true }
    }
}

fn copyToken(text: string.String, input: *usize, result: *Arguments, output: *usize) -> bool {
    result.*.items[result.*.length] = @ptrFromInt([*]const u8, @intFromPtr(result.*.storage) + output.*)
    var quote: u8 = 0
    while input.* < text.length {
        const byte = text.pointer[input.*]
        if quote == 0 && whitespace(byte) { break }
        if byte == 39 || byte == 34 {
            if quote == 0 { quote = byte } else if quote == byte { quote = 0 } else {
                result.*.storage[output.*] = byte
                output.* += 1
            }
        } else if byte == 92 && quote != 39 {
            input.* += 1
            if input.* >= text.length { return false }
            result.*.storage[output.*] = escapedByte(text.pointer[input.*])
            output.* += 1
        } else {
            result.*.storage[output.*] = byte
            output.* += 1
        }
        input.* += 1
    }
    if quote != 0 { return false }
    result.*.storage[output.*] = 0
    output.* += 1
    result.*.length += 1
    return true
}

pub fn expand(text: string.String, arguments: [][*]const u8, append_from: usize) -> Arguments {
    const argument_count = process.count(arguments)
    const appended = if append_from < argument_count { argument_count - append_from } else { 0 }
    var result = allocate(text.length, appended)
    if !result.valid { return result }
    var input: usize = 0
    var output: usize = 0
    while input < text.length {
        while input < text.length && whitespace(text.pointer[input]) { input += 1 }
        if input < text.length && !copyToken(text, &input, &result, &output) {
            result.valid = false
            return result
        }
    }
    var index = append_from
    while index < argument_count {
        unsafe { result.items[result.length] = @ptrCast([*]const u8, arguments[index]) }
        result.length += 1
        index += 1
    }
    unsafe { result.items[result.length] = @ptrFromInt([*]const u8, 0) }
    result.valid = result.length > 0
    return result
}

pub fn deinit(arguments: Arguments) -> void {
    if @intFromPtr(arguments.items) == 0 { return }
    const allocator = page_allocator.init()
    unsafe { allocator.free(@ptrCast([*]u8, arguments.items), arguments.itemBytes, @alignOf([*]const u8)) }
    allocator.free(arguments.storage, arguments.storageBytes, 1)
}
