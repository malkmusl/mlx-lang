const allocator_module = @import("./allocator.zin")

pub const Allocator = allocator_module.Allocator
pub const AllocFn = allocator_module.AllocFn
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn

// Bootstrap specialization used by source buffers, names, and emitted bytes.
// Stage 1 can layer a generic ArrayList(T) over the same allocator contract.
pub const ArrayList = struct {
    items: [*]u8
    length: usize
    capacity: usize
    allocatorContext: usize
    allocFn: AllocFn
    resizeFn: ResizeFn
    freeFn: FreeFn
}

pub fn init(allocator: Allocator, initial_capacity: usize) -> ArrayList {
    const capacity = if initial_capacity > 0 { initial_capacity } else { 16 }
    const allocation = allocator.allocFn(allocator.context, capacity, 1)
    return ArrayList.{
        .items = allocation.?,
        .length = 0,
        .capacity = capacity,
        .allocatorContext = allocator.context,
        .allocFn = allocator.allocFn,
        .resizeFn = allocator.resizeFn,
        .freeFn = allocator.freeFn,
    }
}

pub fn append(list: ArrayList, value: u8) -> ArrayList {
    var result = list
    if result.length == result.capacity {
        const new_capacity = result.capacity * 2
        const resized = result.resizeFn(result.allocatorContext, result.items, result.capacity, new_capacity, 1)
        result.items = resized.?
        result.capacity = new_capacity
    }
    result.items[result.length] = value
    result.length += 1
    return result
}

pub fn appendSlice(list: ArrayList, values: []const u8) -> ArrayList {
    var result = list
    for value in values {
        result = append(result, value)
    }
    return result
}

pub fn get(list: ArrayList, index: usize) -> u8 {
    return list.items[index]
}

pub fn asSlice(list: ArrayList) -> []const u8 {
    unsafe {
        return @ptrCast([*]const u8, list.items)[0..list.length]
    }
}

pub fn deinit(list: ArrayList) -> void {
    list.freeFn(list.allocatorContext, list.items, list.capacity, 1)
}
