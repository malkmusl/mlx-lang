const allocator_module = @import("./allocator.zin")
const mem = @import("./mem.zin")

pub const Allocator = allocator_module.Allocator
pub const AllocFn = allocator_module.AllocFn
pub const ResizeFn = allocator_module.ResizeFn
pub const FreeFn = allocator_module.FreeFn

// Type-erased bootstrap vector. Zin1 uses this for tokens and AST records
// until its comptime pipeline can instantiate a generic ArrayList(T).
pub const Vector = struct {
    items: [*]u8
    length: usize
    capacity: usize
    elementSize: usize
    elementAlignment: usize
    allocatorContext: usize
    allocFn: AllocFn
    resizeFn: ResizeFn
    freeFn: FreeFn
}

pub fn init(allocator: Allocator, element_size: usize, element_alignment: usize, initial_capacity: usize) -> Vector {
    const capacity = if initial_capacity > 0 { initial_capacity } else { 8 }
    const byte_length = capacity * element_size
    const allocation = allocator.allocFn(allocator.context, byte_length, element_alignment)
    return Vector.{
        .items = allocation.?,
        .length = 0,
        .capacity = capacity,
        .elementSize = element_size,
        .elementAlignment = element_alignment,
        .allocatorContext = allocator.context,
        .allocFn = allocator.allocFn,
        .resizeFn = allocator.resizeFn,
        .freeFn = allocator.freeFn,
    }
}

pub fn ensureCapacity(vector: Vector, minimum_capacity: usize) -> Vector {
    var result = vector
    if minimum_capacity <= result.capacity { return result }
    var new_capacity = result.capacity
    while new_capacity < minimum_capacity { new_capacity *= 2 }
    const old_byte_length = result.capacity * result.elementSize
    const new_byte_length = new_capacity * result.elementSize
    result.items = result.resizeFn(
        result.allocatorContext,
        result.items,
        old_byte_length,
        new_byte_length,
        result.elementAlignment,
    ).?
    result.capacity = new_capacity
    return result
}

pub fn append(vector: Vector, value: [*]const u8) -> Vector {
    var result = ensureCapacity(vector, vector.length + 1)
    unsafe {
        const destination = @ptrFromInt([*]u8, @intFromPtr(result.items) + result.length * result.elementSize)
        mem.copy(destination, value, result.elementSize)
    }
    result.length += 1
    return result
}

pub fn at(vector: Vector, index: usize) -> [*]u8 {
    unsafe {
        return @ptrFromInt([*]u8, @intFromPtr(vector.items) + index * vector.elementSize)
    }
}

pub fn clear(vector: Vector) -> Vector {
    var result = vector
    result.length = 0
    return result
}

pub fn pop(vector: Vector) -> Vector {
    if vector.length == 0 { return vector }
    var result = vector
    result.length -= 1
    return result
}

pub fn deinit(vector: Vector) -> void {
    vector.freeFn(
        vector.allocatorContext,
        vector.items,
        vector.capacity * vector.elementSize,
        vector.elementAlignment,
    )
}
