const allocator_module = @import("./allocator.zin")
const mem = @import("./mem.zin")

pub const Allocator = allocator_module.Allocator
pub const FreeFn = allocator_module.FreeFn

pub const Arena = struct {
    memory: [*]u8
    capacity: usize
    offset: usize
    childContext: usize
    childFreeFn: FreeFn
}

fn alignForward(value: usize, alignment: usize) -> usize {
    if alignment <= 1 { return value }
    return ((value + alignment - 1) / alignment) * alignment
}

fn arenaAlloc(context: usize, length: usize, alignment: usize) -> ?[*]u8 {
    unsafe {
        const arena_pointer = @ptrFromInt(*Arena, context)
        var arena = arena_pointer.*
        const base = @intFromPtr(arena.memory)
        const start = alignForward(base + arena.offset, alignment) - base
        const end = start + length
        if end > arena.capacity { return null }
        arena.offset = end
        return @ptrFromInt([*]u8, @intFromPtr(arena.memory) + start)
    }
}

fn arenaResize(context: usize, memory: [*]u8, old_length: usize, new_length: usize, alignment: usize) -> ?[*]u8 {
    const replacement = arenaAlloc(context, new_length, alignment)
    if replacement == null { return null }
    const result = replacement.?
    mem.copy(result, memory, if old_length < new_length { old_length } else { new_length })
    return result
}

fn arenaFree(context: usize, memory: [*]u8, length: usize, alignment: usize) -> void {}

pub fn init(child: Allocator, capacity: usize) -> Arena {
    return Arena.{
        .memory = child.allocFn(child.context, capacity, 16).?,
        .capacity = capacity,
        .offset = 0,
        .childContext = child.context,
        .childFreeFn = child.freeFn,
    }
}

pub fn interface(arena: *Arena) -> Allocator {
    return Allocator.{
        .context = @intFromPtr(arena),
        .allocFn = arenaAlloc,
        .resizeFn = arenaResize,
        .freeFn = arenaFree,
    }
}

pub fn reset(arena: *Arena) -> void {
    arena.*.offset = 0
}

pub fn deinit(arena: *Arena) -> void {
    arena.*.childFreeFn(arena.*.childContext, arena.*.memory, arena.*.capacity, 16)
    arena.*.offset = 0
}
