const fs = @import("./fs.zin")

pub const File = fs.File

pub fn stdin() -> File {
    return File.{ .descriptor = 0 }
}

pub fn stdout() -> File {
    return File.{ .descriptor = 1 }
}

pub fn stderr() -> File {
    return File.{ .descriptor = 2 }
}

pub fn writeAll(file: File, source: []const u8) -> bool {
    return fs.writeAll(file, source)
}
