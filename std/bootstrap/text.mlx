// std.text: text in fixed buffers, without allocating. The helpers every
// program wrote again (a number or a word appended to a line being built,
// a C string as a slice, a hex digit's value) once, here.
//
//     var line: [128]u8 = undefined
//     var bytes: [*]u8 = undefined
//     unsafe { bytes = @ptrCast([*]u8, &line) }
//     var length = text.append(bytes, 0, 128, "frames: ")
//     length = text.appendUnsigned(bytes, length, 128, count)
//
// Appending never writes past `capacity`; what does not fit is left out.
const integer = @import("./fmt/integer.mlx")
const ascii = @import("./ascii.mlx")

// `value` after `at` bytes of `into`; the new length.
pub fn append(into: [*]u8, at: usize, capacity: usize, value: []const u8) -> usize {
    var length = at
    for byte in value {
        if length < capacity {
            into[length] = byte
            length += 1
        }
    }
    return length
}

// One byte after `at`; the new length.
pub fn appendByte(into: [*]u8, at: usize, capacity: usize, value: u8) -> usize {
    if at >= capacity { return at }
    into[at] = value
    return at + 1
}

// `value` in decimal after `at`; the new length.
pub fn appendUnsigned(into: [*]u8, at: usize, capacity: usize, value: usize) -> usize {
    if at >= capacity { return at }
    var digits: [24]u8 = undefined
    var digit_bytes: [*]u8 = undefined
    unsafe { digit_bytes = @ptrCast([*]u8, &digits) }
    const count = integer.unsignedDecimal(value, digit_bytes, 24)
    return append(into, at, capacity, digit_bytes[0..count])
}

// `value` in decimal (a minus first when below zero) after `at`.
pub fn appendSigned(into: [*]u8, at: usize, capacity: usize, value: isize) -> usize {
    var length = at
    if value < 0 { length = appendByte(into, length, capacity, 45) }
    return appendUnsigned(into, length, capacity, integer.signedMagnitude(value))
}

// `value` in lowercase hex (no 0x) after `at`.
pub fn appendHex(into: [*]u8, at: usize, capacity: usize, value: usize) -> usize {
    if at >= capacity { return at }
    var digits: [24]u8 = undefined
    var digit_bytes: [*]u8 = undefined
    unsafe { digit_bytes = @ptrCast([*]u8, &digits) }
    const count = integer.unsignedHex(value, digit_bytes, 24)
    return append(into, at, capacity, digit_bytes[0..count])
}

// The NUL-terminated string at `pointer` as a slice (without the NUL).
pub fn cString(pointer: [*]const u8) -> []const u8 {
    var length: usize = 0
    while pointer[length] != 0 { length += 1 }
    return pointer[0..length]
}

// The value of a hex digit (0-9, a-f, A-F); 16 for any other byte.
pub fn hexValue(byte: u8) -> u8 {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 97 && byte <= 102 { return byte - 87 }
    if byte >= 65 && byte <= 70 { return byte - 55 }
    return 16
}

// Whether two byte strings are the same.
pub fn same(left: []const u8, right: []const u8) -> bool {
    if left.length != right.length { return false }
    var index: usize = 0
    while index < left.length {
        if left[index] != right[index] { return false }
        index += 1
    }
    return true
}

// Whether `value` starts with `prefix`.
pub fn startsWith(value: []const u8, prefix: []const u8) -> bool {
    if prefix.length > value.length { return false }
    var index: usize = 0
    while index < prefix.length {
        if value[index] != prefix[index] { return false }
        index += 1
    }
    return true
}

// Whether `value` ends with `suffix`.
pub fn endsWith(value: []const u8, suffix: []const u8) -> bool {
    if suffix.length > value.length { return false }
    return same(value[value.length - suffix.length..value.length], suffix)
}

// Where `needle` first occurs in `value`; `value.length` when it does not
// (an empty needle is found at 0).
pub fn find(value: []const u8, needle: []const u8) -> usize {
    if needle.length > value.length { return value.length }
    var at: usize = 0
    while at + needle.length <= value.length {
        if same(value[at..at + needle.length], needle) { return at }
        at += 1
    }
    return value.length
}

// Whether `needle` occurs in `value` (an empty needle always does).
pub fn contains(value: []const u8, needle: []const u8) -> bool {
    return needle.length == 0 || find(value, needle) < value.length
}

// `value` copied into `into` with a NUL after it, for a call that wants a
// C string; the bytes past `capacity` - 1 are left out. `capacity` is at
// least 1. The pointer to pass.
pub fn zeroTerminated(into: [*]u8, capacity: usize, value: []const u8) -> [*]const u8 {
    var length: usize = 0
    for byte in value {
        if length + 1 < capacity {
            into[length] = byte
            length += 1
        }
    }
    into[length] = 0
    return into
}

// `value` without the spaces, tabs and line ends around it.
pub fn trimmed(value: []const u8) -> []const u8 {
    var start: usize = 0
    var end = value.length
    while start < end && ascii.isWhitespace(value[start]) { start += 1 }
    while end > start && ascii.isWhitespace(value[end - 1]) { end -= 1 }
    return value[start..end]
}
