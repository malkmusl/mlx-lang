// Zig-style allocator interface: every concrete implementation exposes a
// single static VTable (MlxComptime materializes it in static storage since
// every field is a comptime-known function value) and each instance carries
// only an opaque context pointer plus a pointer to that table, mirroring
// std.mem.Allocator's `ptr: *anyopaque, vtable: *const VTable` shape rather
// than storing per-instance function pointers directly.
//
// `resize`/`remap`/`free` take an explicit `length` alongside the pointer
// instead of a `[]u8` slice: Mlx slices do not expose a `.length`/`.pointer`
// accessor the way Zig's do, so every buffer-passing API in this codebase
// (this one included) carries pointer and length as separate values.

pub const AllocFn = fn(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8
pub const ResizeFn = fn(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> bool
pub const RemapFn = fn(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> ?[*]u8
pub const FreeFn = fn(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void

pub const VTable = struct {
    alloc: AllocFn
    resize: ResizeFn
    remap: RemapFn
    free: FreeFn
}

pub const Allocator = struct {
    ptr: *anyopaque
    vtable: *const VTable

    // Raw vtable dispatch, named after Zig's Allocator.rawAlloc/rawResize/
    // rawRemap/rawFree internals. `vtable` is a pointer, so its fields need
    // an explicit `.*` dereference before they can be called.
    pub fn rawAlloc(self: Self, length: usize, alignment: usize) -> ?[*]u8 {
        return self.vtable.*.alloc(self.ptr, length, alignment)
    }

    pub fn rawResize(self: Self, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> bool {
        return self.vtable.*.resize(self.ptr, memory, length, alignment, new_length)
    }

    pub fn rawRemap(self: Self, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> ?[*]u8 {
        return self.vtable.*.remap(self.ptr, memory, length, alignment, new_length)
    }

    pub fn rawFree(self: Self, memory: [*]u8, length: usize, alignment: usize) -> void {
        self.vtable.*.free(self.ptr, memory, length, alignment)
    }

    // Pointer/length convenience wrappers kept source-compatible with the
    // bootstrap collections and userland programs that were already calling
    // Allocator.alloc/resize/free with this exact shape.
    pub fn alloc(self: Self, length: usize, alignment: usize) -> ?[*]u8 {
        return self.rawAlloc(length, alignment)
    }

    // Tries an in-place resize first and falls back to allocate+copy+free
    // (a "remap" in Zig's terms) when the implementation cannot grow or
    // shrink the block in place.
    pub fn resize(self: Self, memory: [*]u8, old_length: usize, new_length: usize, alignment: usize) -> ?[*]u8 {
        if new_length == 0 {
            self.free(memory, old_length, alignment)
            return null
        }
        if old_length > 0 && self.rawResize(memory, old_length, alignment, new_length) { return memory }
        return self.rawRemap(memory, old_length, alignment, new_length)
    }

    pub fn free(self: Self, memory: [*]u8, length: usize, alignment: usize) -> void {
        self.rawFree(memory, length, alignment)
    }

    // Zig-style typed convenience API, restricted to what Mlx1's current
    // comptime pipeline can actually type-check. `destroy`/`freeSlice` infer
    // their element type from an existing typed pointer via `anytype` +
    // `@childType(@typeOf(...))`, which mlx0 resolves fine. A `create`/
    // `allocSlice`/`dupe` that *manufactures* a new `*T`/`[*]T` value out of
    // nothing but a `comptime T: type` parameter does not compile yet: mlx0
    // does not resolve `*T`, `[*]T`, `?*T`, or a generic `anytype` return
    // built purely from a comptime type parameter (confirmed against mlx0
    // directly; tracked as a follow-up once Mlx1's generics mature). Callers
    // needing a typed allocation still go through `alloc`/`resize`/`free`
    // and their own `@ptrCast`, exactly as the rest of this codebase does.
    pub fn destroy(self: Self, pointer: anytype) -> void {
        const Element = @childType(@typeOf(pointer))
        unsafe { self.rawFree(@ptrCast([*]u8, pointer), @sizeOf(Element), @alignOf(Element)) }
    }

    pub fn freeSlice(self: Self, memory: anytype, count: usize) -> void {
        const Element = @childType(@typeOf(memory))
        unsafe { self.rawFree(@ptrCast([*]u8, memory), count * @sizeOf(Element), @alignOf(Element)) }
    }
}
