// Minimal allocator contract shared by the bootstrap collections. Function
// values are ordinary indirect-callable values in Zin; context is kept as a
// usize until Stage 1 introduces richer opaque-pointer ergonomics.

pub const AllocFn = fn(context: usize, length: usize, alignment: usize) -> ?[*]u8
pub const ResizeFn = fn(context: usize, memory: [*]u8, old_length: usize, new_length: usize, alignment: usize) -> ?[*]u8
pub const FreeFn = fn(context: usize, memory: [*]u8, length: usize, alignment: usize) -> void

pub const Allocator = struct {
    context: usize
    allocFn: AllocFn
    resizeFn: ResizeFn
    freeFn: FreeFn
}

pub fn alloc(allocator: Allocator, length: usize, alignment: usize) -> ?[*]u8 {
    return allocator.allocFn(allocator.context, length, alignment)
}

pub fn resize(allocator: Allocator, memory: [*]u8, old_length: usize, new_length: usize, alignment: usize) -> ?[*]u8 {
    return allocator.resizeFn(allocator.context, memory, old_length, new_length, alignment)
}

pub fn free(allocator: Allocator, memory: [*]u8, length: usize, alignment: usize) -> void {
    allocator.freeFn(allocator.context, memory, length, alignment)
}
