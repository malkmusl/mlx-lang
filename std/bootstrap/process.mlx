const string = @import("./string.mlx")

pub const String = string.String

pub fn count(arguments: [][*]const u8) -> usize {
    var result: usize = 0
    for argument_pointer in arguments {
        result += 1
    }
    return result
}

pub fn fromCString(pointer: [*]const u8) -> String {
    var length: usize = 0
    while pointer[length] != 0 {
        length += 1
    }
    return string.fromParts(pointer, length)
}

pub fn argument(arguments: [][*]const u8, index: usize) -> String {
    if index >= count(arguments) {
        unsafe {
            return string.fromParts(@ptrFromInt([*]const u8, 0), 0)
        }
    }
    return fromCString(arguments[index])
}

fn environmentNameMatches(entry: String, name: []const u8, name_length: usize) -> bool {
    if entry.length <= name_length || entry.pointer[name_length] != 61 { return false }
    var index: usize = 0
    while index < name_length {
        if entry.pointer[index] != name[index] { return false }
        index += 1
    }
    return true
}

pub fn environment(arguments: [][*]const u8, name: []const u8) -> ?String {
    var name_length: usize = 0
    for byte in name { name_length += 1 }
    unsafe {
        const argument_pointers = @ptrCast([*][*]const u8, arguments)
        const environment_address = @intFromPtr(argument_pointers) + (count(arguments) + 1) * @sizeOf([*]const u8)
        const entries = @ptrFromInt([*][*]const u8, environment_address)
        var index: usize = 0
        while @intFromPtr(entries[index]) != 0 {
            const entry = fromCString(entries[index])
            if environmentNameMatches(entry, name, name_length) {
                const value = @ptrFromInt([*]const u8, @intFromPtr(entry.pointer) + name_length + 1)
                return string.fromParts(value, entry.length - name_length - 1)
            }
            index += 1
        }
    }
    return null
}
