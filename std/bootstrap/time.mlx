const linux = @import("./os/linux.mlx")
const brix = @import("./os/brix.mlx")
const builtin = @import("builtin")

pub const Timespec = struct {
    seconds: isize
    nanoseconds: isize
}

pub fn realtime() -> Timespec {
    if comptime builtin.os == builtin.Os.brixos {
        const now = brix.clock(brix.Clock.REAL_TIME)
        return Timespec.{ .seconds = @bitCast(isize, now / 1000000000), .nanoseconds = @bitCast(isize, now % 1000000000) }
    }
    var value = Timespec.{ .seconds = -1, .nanoseconds = -1 }
    var result: isize = 0
    unsafe { result = linux.syscall2(linux.SYS_clock_gettime, 0, @intFromPtr(&value)) }
    if result != 0 { return Timespec.{ .seconds = -1, .nanoseconds = -1 } }
    return value
}

pub fn monotonicNanoseconds() -> usize {
    if comptime builtin.os == builtin.Os.brixos { return brix.clock(brix.Clock.MONOTONIC) }
    var value = Timespec.{ .seconds = 0, .nanoseconds = 0 }
    var result: isize = 0
    unsafe { result = linux.syscall2(linux.SYS_clock_gettime, 1, @intFromPtr(&value)) }
    if result != 0 || value.seconds < 0 || value.nanoseconds < 0 { return 0 }
    return @intCast(usize, value.seconds) * 1000000000 + @intCast(usize, value.nanoseconds)
}

// Milliseconds on the monotonic clock (for timeouts and animations).
pub fn milliseconds() -> usize { return monotonicNanoseconds() / 1000000 }

pub fn elapsedNanoseconds(started: usize, finished: usize) -> usize {
    if finished < started { return 0 }
    return finished - started
}

pub fn sleepNanoseconds(duration: usize) -> bool {
    const seconds = duration / 1000000000
    if seconds > 9223372036854775807 { return false }
    var request = Timespec.{
        .seconds = @intCast(isize, seconds),
        .nanoseconds = @intCast(isize, duration % 1000000000),
    }
    var remaining = Timespec.{ .seconds = 0, .nanoseconds = 0 }
    while true {
        var result: isize = 0
        unsafe { result = linux.syscall2(linux.SYS_nanosleep, @intFromPtr(&request), @intFromPtr(&remaining)) }
        if result == 0 { return true }
        if result != -4 { return false }
        request.seconds = remaining.seconds
        request.nanoseconds = remaining.nanoseconds
    }
    return false
}
