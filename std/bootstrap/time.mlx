// The clocks: the platform's (host.brixos.mlx on brixOS).
const host = @import("./os/host.mlx")

pub const Timespec = struct {
    seconds: isize
    nanoseconds: isize
}

pub fn realtime() -> Timespec {
    var value = Timespec.{ .seconds = -1, .nanoseconds = -1 }
    if !host.clock(host.REALTIME, &value.seconds, &value.nanoseconds) { return Timespec.{ .seconds = -1, .nanoseconds = -1 } }
    return value
}

pub fn monotonicNanoseconds() -> usize {
    var value = Timespec.{ .seconds = 0, .nanoseconds = 0 }
    if !host.clock(host.MONOTONIC, &value.seconds, &value.nanoseconds) || value.seconds < 0 || value.nanoseconds < 0 { return 0 }
    return @intCast(usize, value.seconds) * 1000000000 + @intCast(usize, value.nanoseconds)
}

// Milliseconds on the monotonic clock (for timeouts and animations).
pub fn milliseconds() -> usize { return monotonicNanoseconds() / 1000000 }

pub fn elapsedNanoseconds(started: usize, finished: usize) -> usize {
    if finished < started { return 0 }
    return finished - started
}

pub fn sleepNanoseconds(duration: usize) -> bool { return host.sleep(duration) }
