const allocator_module = @import("./allocator.zin")
const linux = @import("./os/linux.zin")
const mem = @import("./mem.zin")

pub const Allocator = allocator_module.Allocator

fn pageAlloc(context: usize, length: usize, alignment: usize) -> ?[*]u8 {
    if length == 0 {
        return null
    }
    const result = linux.syscall6(linux.SYS_mmap, 0, length, 3, 34, 0, 0)
    if result < 0 {
        return null
    }
    unsafe {
        return @ptrFromInt([*]u8, @bitCast(usize, result))
    }
}

fn pageResize(context: usize, memory: [*]u8, old_length: usize, new_length: usize, alignment: usize) -> ?[*]u8 {
    if new_length == 0 {
        pageFree(context, memory, old_length, alignment)
        return null
    }
    const replacement = pageAlloc(context, new_length, alignment)
    if replacement == null {
        return null
    }
    const destination = replacement.?
    const copy_length = if old_length < new_length { old_length } else { new_length }
    mem.copy(destination, memory, copy_length)
    pageFree(context, memory, old_length, alignment)
    return destination
}

fn pageFree(context: usize, memory: [*]u8, length: usize, alignment: usize) -> void {
    if length > 0 {
        linux.syscall2(linux.SYS_munmap, @intFromPtr(memory), length)
    }
}

pub fn init() -> Allocator {
    return Allocator.{
        .context = 0,
        .allocFn = pageAlloc,
        .resizeFn = pageResize,
        .freeFn = pageFree,
    }
}
