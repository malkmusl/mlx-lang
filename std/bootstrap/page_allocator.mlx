const allocator_module = @import("./allocator.mlx")
const linux = @import("./os/linux.mlx")
const mem = @import("./mem.mlx")

pub const Allocator = allocator_module.Allocator

// Told every block mapped and unmapped from now on, wherever the program
// took a page allocator: the debug allocator's watch (debug_allocator.
// watchPages, which std.leaks uses). The free hook answers the length to
// unmap (0: none, a double free). Function pointers rather than an
// import, so that the compiler, which takes its pages here, does not
// depend on the debug allocator.
pub const WatchAlloc = fn(address: usize, length: usize, alignment: usize) -> void
pub const WatchFree = fn(address: usize, length: usize, alignment: usize) -> usize

var watchAlloc: ?WatchAlloc = null
var watchFree: ?WatchFree = null

pub fn watch(on_alloc: WatchAlloc, on_free: WatchFree) -> void {
    watchAlloc = on_alloc
    watchFree = on_free
}

pub fn unwatch() -> void {
    watchAlloc = null
    watchFree = null
}

fn pageAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    if length == 0 {
        return null
    }
    const result = linux.syscall6(linux.SYS_mmap, 0, length, 3, 34, 0, 0)
    if result < 0 {
        return null
    }
    if watchAlloc != null { watchAlloc.?(@bitCast(usize, result), length, alignment) }
    unsafe {
        return @ptrFromInt([*]u8, @bitCast(usize, result))
    }
}

// mmap regions never grow or shrink in place here, so every resize goes
// through remap (allocate, copy, free the old mapping).
fn pageResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> bool {
    return false
}

fn pageRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> ?[*]u8 {
    const replacement = pageAlloc(context, new_length, alignment)
    if replacement == null {
        return null
    }
    const destination = replacement.?
    const copy_length = if length < new_length { length } else { new_length }
    mem.copy(destination, memory, copy_length)
    pageFree(context, memory, length, alignment)
    return destination
}

fn pageFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    if length == 0 { return }
    // Watched: a double free is not unmapped again (the address may be
    // another block's by now), and a block goes with the length it came
    // with.
    const mapped = if watchFree != null { watchFree.?(@intFromPtr(memory), length, alignment) } else { length }
    if mapped > 0 { linux.syscall2(linux.SYS_munmap, @intFromPtr(memory), mapped) }
}

pub fn init() -> Allocator {
    unsafe {
        return Allocator.{
            .context = @ptrFromInt(*anyopaque, 0),
            .allocFn = pageAlloc,
            .resizeFn = pageResize,
            .remapFn = pageRemap,
            .freeFn = pageFree,
        }
    }
}
