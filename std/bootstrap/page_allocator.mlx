const allocator_module = @import("./allocator.mlx")
const linux = @import("./os/linux.mlx")
const mem = @import("./mem.mlx")

pub const Allocator = allocator_module.Allocator

fn pageAlloc(context: *anyopaque, length: usize, alignment: usize) -> ?[*]u8 {
    if length == 0 {
        return null
    }
    const result = linux.syscall6(linux.SYS_mmap, 0, length, 3, 34, 0, 0)
    if result < 0 {
        return null
    }
    unsafe {
        return @ptrFromInt([*]u8, @bitCast(usize, result))
    }
}

// mmap regions never grow or shrink in place here, so every resize goes
// through remap (allocate, copy, free the old mapping).
fn pageResize(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> bool {
    return false
}

fn pageRemap(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize, new_length: usize) -> ?[*]u8 {
    const replacement = pageAlloc(context, new_length, alignment)
    if replacement == null {
        return null
    }
    const destination = replacement.?
    const copy_length = if length < new_length { length } else { new_length }
    mem.copy(destination, memory, copy_length)
    pageFree(context, memory, length, alignment)
    return destination
}

fn pageFree(context: *anyopaque, memory: [*]u8, length: usize, alignment: usize) -> void {
    if length > 0 {
        linux.syscall2(linux.SYS_munmap, @intFromPtr(memory), length)
    }
}

pub fn init() -> Allocator {
    unsafe {
        return Allocator.{
            .context = @ptrFromInt(*anyopaque, 0),
            .allocFn = pageAlloc,
            .resizeFn = pageResize,
            .remapFn = pageRemap,
            .freeFn = pageFree,
        }
    }
}
