pub const String = struct {
    pointer: [*]const u8
    length: usize
}

pub fn fromSlice(bytes: []const u8) -> String {
    var length: usize = 0
    for byte in bytes {
        length += 1
    }
    unsafe {
        return String.{
            .pointer = @ptrCast([*]const u8, bytes),
            .length = length,
        }
    }
}

pub fn fromParts(pointer: [*]const u8, length: usize) -> String {
    return String.{ .pointer = pointer, .length = length }
}

pub fn isEmpty(value: String) -> bool {
    return value.length == 0
}

pub fn asSlice(value: String) -> []const u8 {
    return value.pointer[0..value.length]
}

pub fn eql(left: String, right: String) -> bool {
    if left.length != right.length {
        return false
    }
    var index: usize = 0
    while index < left.length {
        if left.pointer[index] != right.pointer[index] {
            return false
        }
        index += 1
    }
    return true
}

pub fn startsWith(value: String, prefix: String) -> bool {
    if prefix.length > value.length {
        return false
    }
    var index: usize = 0
    while index < prefix.length {
        if value.pointer[index] != prefix.pointer[index] {
            return false
        }
        index += 1
    }
    return true
}

pub fn endsWith(value: String, suffix: String) -> bool {
    if suffix.length > value.length {
        return false
    }
    const start = value.length - suffix.length
    var index: usize = 0
    while index < suffix.length {
        if value.pointer[start + index] != suffix.pointer[index] {
            return false
        }
        index += 1
    }
    return true
}

pub fn slice(value: String, start: usize, end: usize) -> String {
    if start > end || end > value.length {
        return String.{ .pointer = value.pointer, .length = 0 }
    }
    unsafe {
        return String.{
            .pointer = @ptrFromInt([*]const u8, @intFromPtr(value.pointer) + start),
            .length = end - start,
        }
    }
}

pub fn compare(left: String, right: String) -> isize {
    const common = if left.length < right.length { left.length } else { right.length }
    var index: usize = 0
    while index < common {
        if left.pointer[index] < right.pointer[index] { return -1 }
        if left.pointer[index] > right.pointer[index] { return 1 }
        index += 1
    }
    if left.length < right.length { return -1 }
    if left.length > right.length { return 1 }
    return 0
}

pub fn hash(value: String) -> usize {
    var result: usize = 14695981039346656037
    var index: usize = 0
    while index < value.length {
        result = (result ^ @intCast(usize, value.pointer[index])) *% 1099511628211
        index += 1
    }
    return result
}
