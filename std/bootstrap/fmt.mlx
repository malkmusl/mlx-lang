const integer = @import("./fmt/integer.mlx")
const argument = @import("./fmt/argument.mlx")
const writer = @import("./fmt/write.mlx")

pub const Error = writer.Error
pub const Argument = argument.Argument
pub const ArgumentKind = argument.Kind
pub const File = writer.File
pub const String = argument.String

pub fn unsignedBase(value: usize, base: usize, uppercase: bool, destination: [*]u8, capacity: usize) -> usize {
    return integer.unsignedBase(value, base, uppercase, destination, capacity)
}

pub fn unsignedDecimal(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return integer.unsignedDecimal(value, destination, capacity)
}

pub fn signedDecimal(value: isize, destination: [*]u8, capacity: usize) -> usize {
    return integer.signedDecimal(value, destination, capacity)
}

pub fn unsignedHex(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return integer.unsignedHex(value, destination, capacity)
}

pub fn unsignedHexUpper(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return integer.unsignedHexUpper(value, destination, capacity)
}

pub fn unsignedBinary(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return integer.unsignedBinary(value, destination, capacity)
}

pub fn unsignedOctal(value: usize, destination: [*]u8, capacity: usize) -> usize {
    return integer.unsignedOctal(value, destination, capacity)
}

pub fn unsigned(value: usize) -> Argument { return argument.unsigned(value) }
pub fn signed(value: isize) -> Argument { return argument.signed(value) }
pub fn character(value: u8) -> Argument { return argument.character(value) }
pub fn string(value: []const u8) -> Argument { return argument.string(value) }
pub fn ownedString(value: argument.String) -> Argument { return argument.ownedString(value) }
pub fn pointer(address: usize) -> Argument { return argument.pointer(address) }
pub fn boolean(value: bool) -> Argument { return argument.boolean(value) }

pub fn printArguments(file: File, format: []const u8, values: []const Argument) -> Error!void {
    return writer.printArguments(file, format, values)
}

pub fn print(file: File, format: []const u8, values: anytype) -> Error!void {
    return writer.print(file, format, values)
}
