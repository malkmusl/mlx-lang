const string = @import("./string.mlx")
const fs = @import("./fs.mlx")

pub const Result = struct {
    value: usize
    valid: bool
}

fn invalid() -> Result {
    return Result.{ .value = 0, .valid = false }
}

fn parseOctal(text: string.String) -> Result {
    if text.length == 0 { return invalid() }
    var value: usize = 0
    var index: usize = 0
    while index < text.length {
        const byte = text.pointer[index]
        if byte < 48 || byte > 55 { return invalid() }
        value = value * 8 + @intCast(usize, byte - 48)
        if value > 4095 { return invalid() }
        index += 1
    }
    return Result.{ .value = value, .valid = true }
}

fn whoValue(byte: u8) -> usize {
    if byte == 117 { return 1 }
    if byte == 103 { return 2 }
    if byte == 111 { return 4 }
    if byte == 97 { return 7 }
    return 0
}

fn classMask(who: usize) -> usize {
    var result: usize = 0
    if who & 1 != 0 { result |= 448 }
    if who & 2 != 0 { result |= 56 }
    if who & 4 != 0 { result |= 7 }
    return result
}

fn specialMask(who: usize) -> usize {
    var result: usize = 0
    if who & 1 != 0 { result |= 2048 }
    if who & 2 != 0 { result |= 1024 }
    if who & 4 != 0 { result |= 512 }
    return result
}

fn distribute(value: usize, who: usize) -> usize {
    var result: usize = 0
    if who & 1 != 0 { result |= value << 6 }
    if who & 2 != 0 { result |= value << 3 }
    if who & 4 != 0 { result |= value }
    return result
}

fn copied(mode: usize, source: u8, who: usize) -> usize {
    var value = mode & 7
    if source == 117 { value = mode >> 6 & 7 }
    if source == 103 { value = mode >> 3 & 7 }
    return distribute(value, who)
}

fn simplePermission(byte: u8, who: usize) -> usize {
    if byte == 114 { return distribute(4, who) }
    if byte == 119 { return distribute(2, who) }
    if byte == 120 { return distribute(1, who) }
    if byte == 115 {
        return (if who & 1 != 0 { 2048 } else { 0 }) | (if who & 2 != 0 { 1024 } else { 0 })
    }
    if byte == 116 && who & 4 != 0 { return 512 }
    return 0
}

fn permissionBits(text: string.String, index: *usize, who: usize, mode: usize, directory: bool) -> Result {
    var result: usize = 0
    while index.* < text.length {
        const byte = text.pointer[index.*]
        if byte == 44 || byte == 43 || byte == 45 || byte == 61 { break }
        if byte >= 48 && byte <= 55 {
            var numeric: usize = 0
            while index.* < text.length && text.pointer[index.*] >= 48 && text.pointer[index.*] <= 55 {
                numeric = numeric * 8 + @intCast(usize, text.pointer[index.*] - 48)
                if numeric > 4095 { return invalid() }
                index.* += 1
            }
            result |= numeric
        } else if byte == 117 || byte == 103 || byte == 111 {
            result |= copied(mode, byte, who)
        } else if byte == 88 {
            if directory || mode & 73 != 0 { result |= distribute(1, who) }
        } else if byte == 114 || byte == 119 || byte == 120 || byte == 115 || byte == 116 {
            result |= simplePermission(byte, who)
        } else { return invalid() }
        if byte < 48 || byte > 55 { index.* += 1 }
    }
    return Result.{ .value = result, .valid = true }
}

fn applyOperation(mode: usize, who: usize, operation: u8, bits: usize) -> usize {
    if operation == 43 { return mode | bits }
    if operation == 45 { return mode & ~bits }
    return mode & ~(classMask(who) | specialMask(who)) | bits
}

fn parseClause(text: string.String, index: *usize, mode: *usize, directory: bool, mask: usize) -> bool {
    var who: usize = 0
    while index.* < text.length && whoValue(text.pointer[index.*]) != 0 {
        who |= whoValue(text.pointer[index.*])
        index.* += 1
    }
    const implicit_who = who == 0
    if implicit_who { who = 7 }
    var actions: usize = 0
    while index.* < text.length && text.pointer[index.*] != 44 {
        const operation = text.pointer[index.*]
        if operation != 43 && operation != 45 && operation != 61 { return false }
        index.* += 1
        var bits = permissionBits(text, index, who, mode.*, directory)
        if !bits.valid { return false }
        if implicit_who { bits.value &= ~mask }
        mode.* = applyOperation(mode.*, who, operation, bits.value)
        actions += 1
    }
    return actions > 0
}

fn parseSymbolic(text: string.String, initial: usize, directory: bool) -> Result {
    var mode = initial
    var index: usize = 0
    const mask = fs.currentUmask()
    while index < text.length {
        if !parseClause(text, &index, &mode, directory, mask) { return invalid() }
        if index < text.length {
            index += 1
            if index == text.length { return invalid() }
        }
    }
    return Result.{ .value = mode, .valid = text.length > 0 }
}

pub fn parse(text: string.String, initial: usize, directory: bool, allow_special: bool) -> Result {
    const numeric = parseOctal(text)
    var result = if numeric.valid { numeric } else { parseSymbolic(text, initial, directory) }
    if result.valid && !allow_special && result.value > 511 { result.valid = false }
    return result
}
