// Allocation-free memory primitives used by the self-hosted compiler.

pub fn copy(destination: [*]u8, source: [*]const u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        destination[index] = source[index]
        index += 1
    }
}

pub fn copyBackwards(destination: [*]u8, source: [*]const u8, length: usize) -> void {
    var remaining = length
    while remaining > 0 {
        remaining -= 1
        destination[remaining] = source[remaining]
    }
}

pub fn set(destination: [*]u8, value: u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        destination[index] = value
        index += 1
    }
}

pub fn zero(destination: [*]u8, length: usize) -> void {
    set(destination, 0, length)
}

pub fn eql(left: [*]const u8, right: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < length {
        if left[index] != right[index] {
            return false
        }
        index += 1
    }
    return true
}
