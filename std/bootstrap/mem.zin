// Allocation-free memory primitives used by the self-hosted compiler.

pub fn copy(destination: [*]u8, source: [*]const u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        destination[index] = source[index]
        index += 1
    }
}

pub fn copyBackwards(destination: [*]u8, source: [*]const u8, length: usize) -> void {
    var remaining = length
    while remaining > 0 {
        remaining -= 1
        destination[remaining] = source[remaining]
    }
}

pub fn set(destination: [*]u8, value: u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        destination[index] = value
        index += 1
    }
}

pub fn zero(destination: [*]u8, length: usize) -> void {
    set(destination, 0, length)
}

pub fn eql(left: [*]const u8, right: [*]const u8, length: usize) -> bool {
    var index: usize = 0
    while index < length {
        if left[index] != right[index] {
            return false
        }
        index += 1
    }
    return true
}

pub fn readU16Little(source: [*]const u8, offset: usize) -> u16 {
    return @intCast(u16, source[offset]) | (@intCast(u16, source[offset + 1]) << 8)
}

pub fn readU32Little(source: [*]const u8, offset: usize) -> u32 {
    var value: u32 = 0
    var index: usize = 0
    while index < 4 {
        value = value | (@intCast(u32, source[offset + index]) << @intCast(u5, index * 8))
        index += 1
    }
    return value
}

pub fn readU64Little(source: [*]const u8, offset: usize) -> u64 {
    var value: u64 = 0
    var index: usize = 0
    while index < 8 {
        value = value | (@intCast(u64, source[offset + index]) << @intCast(u6, index * 8))
        index += 1
    }
    return value
}

pub fn writeU16Little(destination: [*]u8, offset: usize, value: u16) -> void {
    destination[offset] = @intCast(u8, value)
    destination[offset + 1] = @intCast(u8, value >> 8)
}

pub fn writeU32Little(destination: [*]u8, offset: usize, value: u32) -> void {
    var index: usize = 0
    while index < 4 {
        destination[offset + index] = @intCast(u8, value >> @intCast(u5, index * 8))
        index += 1
    }
}

pub fn writeU64Little(destination: [*]u8, offset: usize, value: u64) -> void {
    var index: usize = 0
    while index < 8 {
        destination[offset + index] = @intCast(u8, value >> @intCast(u6, index * 8))
        index += 1
    }
}
