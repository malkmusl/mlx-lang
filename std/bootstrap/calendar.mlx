const string = @import("./string.mlx")
const time = @import("./time.mlx")

pub const Timestamp = struct {
    seconds: isize
    nanoseconds: isize
    valid: bool
}

const Number = struct {
    value: usize
    valid: bool
}

const SignedNumber = struct {
    value: isize
    valid: bool
}

fn invalid() -> Timestamp {
    return Timestamp.{ .seconds = 0, .nanoseconds = 0, .valid = false }
}

fn pair(text: string.String, offset: usize) -> Number {
    if offset + 2 > text.length { return Number.{ .value = 0, .valid = false } }
    const first = text.pointer[offset]
    const second = text.pointer[offset + 1]
    if first < 48 || first > 57 || second < 48 || second > 57 { return Number.{ .value = 0, .valid = false } }
    return Number.{ .value = @intCast(usize, first - 48) * 10 + @intCast(usize, second - 48), .valid = true }
}

fn four(text: string.String, offset: usize) -> Number {
    const high = pair(text, offset)
    const low = pair(text, offset + 2)
    return Number.{ .value = high.value * 100 + low.value, .valid = high.valid && low.valid }
}

fn leap(year: usize) -> bool {
    return year % 4 == 0 && year % 100 != 0 || year % 400 == 0
}

fn monthDays(year: usize, month: usize) -> usize {
    if month == 2 { return if leap(year) { 29 } else { 28 } }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
    return 31
}

fn epochDays(year: usize, month: usize, day: usize) -> SignedNumber {
    if year == 0 || month == 0 || month > 12 || day == 0 || day > monthDays(year, month) {
        return SignedNumber.{ .value = 0, .valid = false }
    }
    var days: isize = 0
    var current: usize = 1970
    if year >= 1970 {
        while current < year {
            days += if leap(current) { 366 } else { 365 }
            current += 1
        }
    } else {
        while current > year {
            current -= 1
            days -= if leap(current) { 366 } else { 365 }
        }
    }
    current = 1
    while current < month {
        days += @intCast(isize, monthDays(year, current))
        current += 1
    }
    return SignedNumber.{ .value = days + @intCast(isize, day) - 1, .valid = true }
}

fn create(year: usize, month: usize, day: usize, hour: usize, minute: usize, second: usize, nanoseconds: usize) -> Timestamp {
    const days = epochDays(year, month, day)
    if !days.valid || hour > 23 || minute > 59 || second > 60 || nanoseconds > 999999999 { return invalid() }
    const value = days.value * 86400 + @intCast(isize, hour * 3600 + minute * 60 + second)
    return Timestamp.{ .seconds = value, .nanoseconds = @intCast(isize, nanoseconds), .valid = true }
}

fn fraction(text: string.String, offset: usize) -> Number {
    if offset >= text.length || text.length - offset > 9 { return Number.{ .value = 0, .valid = false } }
    var value: usize = 0
    var index = offset
    while index < text.length {
        const byte = text.pointer[index]
        if byte < 48 || byte > 57 { return Number.{ .value = 0, .valid = false } }
        value = value * 10 + @intCast(usize, byte - 48)
        index += 1
    }
    while index - offset < 9 {
        value *= 10
        index += 1
    }
    return Number.{ .value = value, .valid = true }
}

fn currentYear() -> usize {
    const now = time.realtime()
    if now.seconds < 0 { return 1970 }
    var days = @intCast(usize, now.seconds) / 86400
    var year: usize = 1970
    while days >= if leap(year) { 366 } else { 365 } {
        days -= if leap(year) { 366 } else { 365 }
        year += 1
    }
    return year
}

pub fn parseTouch(text: string.String) -> Timestamp {
    var main_length = text.length
    var seconds: usize = 0
    var index: usize = 0
    while index < text.length && text.pointer[index] != 46 { index += 1 }
    if index < text.length {
        if index + 3 != text.length { return invalid() }
        const parsed_seconds = pair(text, index + 1)
        if !parsed_seconds.valid { return invalid() }
        seconds = parsed_seconds.value
        main_length = index
    }
    if main_length != 8 && main_length != 10 && main_length != 12 { return invalid() }
    var year = currentYear()
    var offset: usize = 0
    if main_length == 10 {
        const short_year = pair(text, 0)
        if !short_year.valid { return invalid() }
        year = if short_year.value <= 68 { 2000 + short_year.value } else { 1900 + short_year.value }
        offset = 2
    } else if main_length == 12 {
        const full_year = four(text, 0)
        if !full_year.valid { return invalid() }
        year = full_year.value
        offset = 4
    }
    const month = pair(text, offset)
    const day = pair(text, offset + 2)
    const hour = pair(text, offset + 4)
    const minute = pair(text, offset + 6)
    if !month.valid || !day.valid || !hour.valid || !minute.valid { return invalid() }
    return create(year, month.value, day.value, hour.value, minute.value, seconds, 0)
}

fn parseEpoch(text: string.String) -> Timestamp {
    if text.length < 2 || text.pointer[0] != 64 { return invalid() }
    var index: usize = 1
    var seconds: usize = 0
    while index < text.length && text.pointer[index] >= 48 && text.pointer[index] <= 57 {
        const digit = @intCast(usize, text.pointer[index] - 48)
        if seconds > (9223372036854775807 - digit) / 10 { return invalid() }
        seconds = seconds * 10 + digit
        index += 1
    }
    if index == 1 { return invalid() }
    var nanoseconds: usize = 0
    if index < text.length {
        if text.pointer[index] != 46 { return invalid() }
        const parsed = fraction(text, index + 1)
        if !parsed.valid { return invalid() }
        nanoseconds = parsed.value
        index = text.length
    }
    return Timestamp.{ .seconds = @intCast(isize, seconds), .nanoseconds = @intCast(isize, nanoseconds), .valid = index == text.length }
}

fn parseIso(text: string.String) -> Timestamp {
    if text.length < 10 || text.pointer[4] != 45 || text.pointer[7] != 45 { return invalid() }
    const year = four(text, 0)
    const month = pair(text, 5)
    const day = pair(text, 8)
    if !year.valid || !month.valid || !day.valid { return invalid() }
    if text.length == 10 { return create(year.value, month.value, day.value, 0, 0, 0, 0) }
    if text.length < 16 || text.pointer[10] != 32 && text.pointer[10] != 84 || text.pointer[13] != 58 { return invalid() }
    const hour = pair(text, 11)
    const minute = pair(text, 14)
    var second = Number.{ .value = 0, .valid = true }
    var nanos = Number.{ .value = 0, .valid = true }
    var end: usize = 16
    if text.length >= 19 && text.pointer[16] == 58 {
        second = pair(text, 17)
        end = 19
    }
    if end < text.length && text.pointer[end] == 46 {
        nanos = fraction(text, end + 1)
        end = text.length
    }
    if !hour.valid || !minute.valid || !second.valid || !nanos.valid || end != text.length { return invalid() }
    return create(year.value, month.value, day.value, hour.value, minute.value, second.value, nanos.value)
}

pub fn parseDate(text: string.String) -> Timestamp {
    if string.eql(text, string.fromSlice("now")) {
        const value = time.realtime()
        return Timestamp.{ .seconds = value.seconds, .nanoseconds = value.nanoseconds, .valid = value.seconds >= 0 }
    }
    if text.length > 0 && text.pointer[0] == 64 { return parseEpoch(text) }
    return parseIso(text)
}
