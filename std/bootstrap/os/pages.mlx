// Pages of memory from the operating system, for std's allocators: Linux's
// mmap, munmap, mprotect and madvise here; pages.brixos.mlx has brixOS's
// own (memory_map, memory_unmap), which the compiler takes for
// --target=x86_64-brixos.
const linux = @import("./linux.mlx")

// MAP_PRIVATE | MAP_ANONYMOUS, with MAP_NORESERVE, with
// MAP_FIXED_NOREPLACE | MAP_NORESERVE.
const MAP_FLAGS: usize = 34
const MAP_FLAGS_RESERVED: usize = 16418
const MAP_FLAGS_FIXED: usize = 1064994
const ALL: usize = 18446744073709551615
const SYS_mprotect: usize = 10
const SYS_madvise: usize = 28
const MADV_DONTNEED: usize = 4

// `length` bytes of zeroed pages somewhere (`reserved`: only the pages
// touched count against memory); the address, 0 when there are none.
pub fn map(length: usize, reserved: bool) -> usize {
    const result = linux.syscall6(linux.SYS_mmap, 0, length, 3, if reserved { MAP_FLAGS_RESERVED } else { MAP_FLAGS }, ALL, 0)
    if result < 0 { return 0 }
    return @bitCast(usize, result)
}

pub fn unmap(address: usize, length: usize) -> void { _ = linux.syscall2(linux.SYS_munmap, address, length) }

// `length` bytes at `address` exactly, readable and writable when
// `usable` (else to be made so by commit), never over what is mapped
// there: the address, -17 when something is, another -errno, or another
// address when the kernel took `address` as a hint (to be unmapped).
pub fn mapAt(address: usize, length: usize, usable: bool) -> isize {
    return linux.syscall6(linux.SYS_mmap, address, length, if usable { 3 } else { 0 }, MAP_FLAGS_FIXED, ALL, 0)
}

// Pages of a mapAt (not usable) made readable and writable.
pub fn commit(address: usize, length: usize) -> bool { return linux.syscall3(SYS_mprotect, address, length, 3) == 0 }

// Pages given back (zero when touched again), their addresses kept.
pub fn release(address: usize, length: usize) -> void { _ = linux.syscall3(SYS_madvise, address, length, MADV_DONTNEED) }

// Says `text` on the errors (an allocator out of memory).
pub fn say(text: []const u8) -> void { _ = linux.syscall3(linux.SYS_write, 2, @intFromPtr(text.pointer), text.length) }

// A lock's word: sleep while it holds `expected`, wake one sleeper
// (futex, private), give the processor up (sched_yield).
pub fn sleepOn(word: *u32, expected: u32) -> void { _ = linux.thread.futexWait(word, expected, 0, true) }
pub fn wakeOne(word: *u32) -> void { _ = linux.thread.futexWake(word, 1, true) }
pub fn yield() -> void { _ = linux.syscall0(24) }
