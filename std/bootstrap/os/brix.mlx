// brixOS's own calls (spec/04-stdlib/os/brix.xml): handles, the one
// wait over them, reads and writes at a position or streaming, the
// clocks, the end of the process. SYSCALL with NATIVE_BASE + n in rax,
// the arguments in rdi, rsi, rdx, r10, r8, r9; a negative result is a
// Status, negated. (Below NATIVE_BASE brixOS takes Linux's numbers, so a
// program may use std.os.linux beside these while std moves over.)
pub extern("syscall") fn call1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn call2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn call3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn call4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}
pub extern("syscall") fn call5(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize {}
pub extern("syscall") fn call6(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {}

pub const NATIVE_BASE: usize = 0x4000
pub const HANDLE_CLOSE: usize = NATIVE_BASE + 0
pub const HANDLE_DUPLICATE: usize = NATIVE_BASE + 1
pub const HANDLE_INFO: usize = NATIVE_BASE + 2
pub const WAIT: usize = NATIVE_BASE + 3
pub const READ: usize = NATIVE_BASE + 4
pub const WRITE: usize = NATIVE_BASE + 5
pub const NODE_OPEN: usize = NATIVE_BASE + 6
pub const NODE_INFO: usize = NATIVE_BASE + 7
pub const NODE_MAKE: usize = NATIVE_BASE + 8
pub const NODE_REMOVE: usize = NATIVE_BASE + 9
pub const NODE_RENAME: usize = NATIVE_BASE + 10
pub const NODE_LIST: usize = NATIVE_BASE + 11
pub const STREAM_PAIR: usize = NATIVE_BASE + 12
pub const CHANNEL_PAIR: usize = NATIVE_BASE + 13
pub const CHANNEL_SEND: usize = NATIVE_BASE + 14
pub const CHANNEL_RECEIVE: usize = NATIVE_BASE + 15
pub const MEMORY_MAP: usize = NATIVE_BASE + 16
pub const MEMORY_UNMAP: usize = NATIVE_BASE + 17
pub const MEMORY_OBJECT: usize = NATIVE_BASE + 18
pub const MEMORY_MAP_OBJECT: usize = NATIVE_BASE + 19
pub const PROCESS_SPAWN: usize = NATIVE_BASE + 20
pub const PROCESS_BRANCH: usize = NATIVE_BASE + 21
pub const PROCESS_REPLACE: usize = NATIVE_BASE + 22
pub const PROCESS_EXIT: usize = NATIVE_BASE + 23
pub const PROCESS_CHANGE: usize = NATIVE_BASE + 24
pub const EVENT_SEND: usize = NATIVE_BASE + 25
pub const EVENTS_CLAIM: usize = NATIVE_BASE + 26
pub const EVENTS_TAKE: usize = NATIVE_BASE + 27
pub const UPCALL_SET: usize = NATIVE_BASE + 28
pub const UPCALL_RETURN: usize = NATIVE_BASE + 29
pub const GROUP_JOIN: usize = NATIVE_BASE + 30
pub const SESSION_FRONT: usize = NATIVE_BASE + 31
pub const CLOCK_READ: usize = NATIVE_BASE + 32
pub const TIMER_CREATE: usize = NATIVE_BASE + 33
pub const SNAPSHOT: usize = NATIVE_BASE + 34
pub const HANDLE_OF_DESCRIPTOR: usize = NATIVE_BASE + 35

// A read or write without a position (streams, the session).
pub const STREAM: usize = 0xFFFFFFFFFFFFFFFF
// A wait without a deadline.
pub const FOREVER: usize = 0xFFFFFFFFFFFFFFFF

pub const Status = struct {
    pub const invalid_handle: isize = 1
    pub const wrong_kind: isize = 2
    pub const no_right: isize = 3
    pub const would_block: isize = 4
    pub const timed_out: isize = 5
    pub const not_found: isize = 6
    pub const exists: isize = 7
    pub const no_memory: isize = 8
    pub const bad_address: isize = 9
    pub const invalid: isize = 10
    pub const peer_gone: isize = 11
    pub const interrupted: isize = 12
    pub const unsupported: isize = 18
}

// The state bits of an object, as a wait watches them.
pub const State = struct {
    pub const READABLE: u32 = 0x1
    pub const WRITABLE: u32 = 0x2
    pub const PEER_GONE: u32 = 0x4
    pub const ENDED: u32 = 0x8
    pub const CHANGED: u32 = 0x10
    pub const EVENTS: u32 = 0x20
    pub const FRONT: u32 = 0x40
}

pub const Kind = struct {
    pub const PROCESS: u32 = 1
    pub const GROUP: u32 = 2
    pub const NODE: u32 = 3
    pub const STREAM: u32 = 4
    pub const CHANNEL: u32 = 5
    pub const SESSION: u32 = 6
    pub const MEMORY: u32 = 7
    pub const TIMER: u32 = 8
}

pub const Rights = struct {
    pub const READ: u32 = 0x1
    pub const WRITE: u32 = 0x2
    pub const WAIT: u32 = 0x4
    pub const DUPLICATE: u32 = 0x8
    pub const TRANSFER: u32 = 0x10
    pub const CONTROL: u32 = 0x20
}

pub const Handle = u32

pub const WaitItem = struct {
    handle: u32
    want: u32
    // The state when the wait returned.
    seen: u32
    reserved: u32
}

pub const Info = struct {
    kind: u32
    rights: u32
    state: u32
    reserved: u32
}

// The kinds of events (spec <Events>).
pub const Event = struct {
    pub const INTERRUPT: u32 = 1
    pub const QUIT: u32 = 2
    pub const SUSPEND: u32 = 3
    pub const RESUME: u32 = 4
    pub const TERMINATE: u32 = 5
    pub const HANGUP: u32 = 6
    pub const CHILD: u32 = 7
    pub const FAULT: u32 = 8
    pub const READ_BEHIND: u32 = 9
    pub const HALT: u32 = 10
    pub const KILL: u32 = 11
    pub const NOTICE: u32 = 12
    pub const USER: u32 = 13
    pub const BROKEN: u32 = 14

    pub fn bit(kind: u32) -> u32 {
        const one: u32 = 1
        return one << @intCast(u5, kind)
    }
}

pub const EventRecord = struct {
    kind: u32
    detail: u32
    sender: u32
    reserved: u32
}

// The registers and SSE registers of the code an upcall interrupted.
pub const CONTEXT_SIZE: usize = 704

pub const Clock = struct {
    pub const MONOTONIC: usize = 0
    pub const REAL_TIME: usize = 1
}

// The handle of a descriptor the Linux layer opened (while std moves
// over); 0 when it is not open.
pub fn ofDescriptor(descriptor: isize) -> Handle {
    const result = call1(HANDLE_OF_DESCRIPTOR, @bitCast(usize, descriptor))
    return if result < 0 { 0 } else { @intCast(u32, result) }
}

pub fn close(handle: Handle) -> isize { return call1(HANDLE_CLOSE, @intCast(usize, handle)) }

// A handle to the same object with `rights` (no more than it has).
pub fn duplicate(handle: Handle, rights: u32) -> isize { return call2(HANDLE_DUPLICATE, @intCast(usize, handle), @intCast(usize, rights)) }

pub fn info(handle: Handle, into: *Info) -> isize { return call2(HANDLE_INFO, @intCast(usize, handle), @intFromPtr(into)) }

// Waits until one of `items` has a state it wants (the count of those
// that do), or -timed_out at `deadline` (monotonic nanoseconds; 0: do
// not wait, FOREVER: none); every item's seen word is filled.
pub fn wait(items: []WaitItem, deadline: usize) -> isize { return call3(WAIT, @intFromPtr(items.pointer), items.length, deadline) }

pub fn read(handle: Handle, into: []u8, at: usize) -> isize { return call4(READ, @intCast(usize, handle), @intFromPtr(into.pointer), into.length, at) }

pub fn write(handle: Handle, bytes: []const u8, at: usize) -> isize { return call4(WRITE, @intCast(usize, handle), @intFromPtr(bytes.pointer), bytes.length, at) }

pub fn clock(which: usize) -> usize { return @bitCast(usize, call1(CLOCK_READ, which)) }

pub fn exit(code: usize) -> void { _ = call1(PROCESS_EXIT, code) }

// The kinds (Event.bit of each) the program handles itself: they wait in
// its queue (or run the upcall) instead of their default action.
pub fn claim(kinds: u32) -> isize { return call1(EVENTS_CLAIM, @intCast(usize, kinds)) }

// The oldest events of the queue, taken out; how many.
pub fn take(records: []EventRecord) -> isize { return call2(EVENTS_TAKE, @intFromPtr(records.pointer), records.length) }

// The upcall: `entry(context)` runs on `stack` when a claimed event comes,
// and goes back by upcallReturn(context).
pub fn upcall(entry: usize, stack: usize, size: usize) -> isize { return call3(UPCALL_SET, entry, stack, size) }

pub fn upcallReturn(context: usize) -> void { _ = call1(UPCALL_RETURN, context) }

// node_open's flags.
pub const Open = struct {
    pub const READ: usize = 0x1
    pub const WRITE: usize = 0x2
    pub const CREATE: usize = 0x4
    pub const EXCLUSIVE: usize = 0x8
    pub const TRUNCATE: usize = 0x10
}

// A node's kind (node_info, node_list, node_make).
pub const NodeKind = struct {
    pub const FILE: u32 = 1
    pub const DIRECTORY: u32 = 2
    pub const LINK: u32 = 3
    pub const FIFO: u32 = 4
    pub const DEVICE: u32 = 5
}

pub const NodeInfo = struct {
    kind: u32
    mode: u32
    links: u32
    reserved: u32
    size: u64
    // Nanoseconds since 1970.
    modified: u64
    number: u64
}

// What became of a child (process_change).
pub const Change = struct {
    pub const EXITED: u32 = 1
    pub const ENDED: u32 = 2
    pub const STOPPED: u32 = 3
    pub const WENT_ON: u32 = 4

    what: u32
    // The exit code, or the event's kind.
    value: u32
    detail: u32
    reserved: u32
}

// A program's start: its arguments and environment (NULL-terminated
// arrays of NUL-terminated strings).
pub const Start = struct {
    arguments: usize
    environment: usize
}

// The node `path` names from `directory` (0: the working directory).
pub fn open(directory: Handle, path: []const u8, flags: usize, mode: usize) -> isize { return call5(NODE_OPEN, @intCast(usize, directory), @intFromPtr(path.pointer), path.length, flags, mode) }

pub fn nodeInfo(handle: Handle, into: *NodeInfo) -> isize { return call2(NODE_INFO, @intCast(usize, handle), @intFromPtr(into)) }

// A directory, a FIFO, or a link holding `target` at `path`.
pub fn make(directory: Handle, path: []const u8, kind: u32, mode: usize, target: []const u8) -> isize { return call6(NODE_MAKE, @intCast(usize, directory), @intFromPtr(path.pointer), path.length, @intCast(usize, kind) | (mode << 8), @intFromPtr(target.pointer), target.length) }

pub fn remove(directory: Handle, path: []const u8) -> isize { return call3(NODE_REMOVE, @intCast(usize, directory), @intFromPtr(path.pointer), path.length) }

// A directory's entries from `cookie` on into `into`: each the cookie
// after it (u64), its kind and its name's length (u32), the name, padded
// to 8 bytes; the bytes written.
pub fn list(handle: Handle, into: []u8, cookie: usize) -> isize { return call4(NODE_LIST, @intCast(usize, handle), @intFromPtr(into.pointer), into.length, cookie) }

// A pipe: [0] reads, [1] writes.
pub fn streamPair(ends: *[2]u32) -> isize { return call1(STREAM_PAIR, @intFromPtr(ends)) }

pub fn channelPair(ends: *[2]u32) -> isize { return call1(CHANNEL_PAIR, @intFromPtr(ends)) }

// A message: bytes and handles (which leave this process).
pub fn send(handle: Handle, bytes: []const u8, handles: []const u32) -> isize { return call5(CHANNEL_SEND, @intCast(usize, handle), @intFromPtr(bytes.pointer), bytes.length, @intFromPtr(handles.pointer), handles.length) }

// The oldest message: its bytes and handles; sizes[0] its bytes, sizes[1]
// its handles.
pub fn receive(handle: Handle, bytes: []u8, handles: []u32, sizes: *[2]u32) -> isize { return call6(CHANNEL_RECEIVE, @intCast(usize, handle), @intFromPtr(bytes.pointer), bytes.length, @intFromPtr(handles.pointer), handles.length, @intFromPtr(sizes)) }

pub fn map(size: usize) -> isize { return call3(MEMORY_MAP, 0, size, 0) }

pub fn unmap(address: usize, size: usize) -> isize { return call2(MEMORY_UNMAP, address, size) }

// `program` in a new process with exactly `handles` (input, output,
// errors, ...); a handle to it.
pub fn spawn(program: Handle, start: *const Start, handles: []const u32) -> isize { return call4(PROCESS_SPAWN, @intCast(usize, program), @intFromPtr(start), @intFromPtr(handles.pointer), handles.length) }

// A copy-on-write copy of this process: a handle to it here, 0 in it.
pub fn branch() -> isize { return call1(PROCESS_BRANCH, 0) }

pub fn replace(program: Handle, start: *const Start) -> isize { return call2(PROCESS_REPLACE, @intCast(usize, program), @intFromPtr(start)) }

// What became of a child, taken; -would_block when nothing did yet.
pub fn change(process: Handle, into: *Change) -> isize { return call2(PROCESS_CHANGE, @intCast(usize, process), @intFromPtr(into)) }

// event_send: to a process, or to every process of a group.
pub fn sendEvent(process: Handle, kind: u32) -> isize { return call2(EVENT_SEND, @intCast(usize, process), @intCast(usize, kind)) }

// node_rename: `from` (in `fromDirectory`) to `to` (in `toDirectory`).
pub fn rename(fromDirectory: Handle, from: []const u8, toDirectory: Handle, to: []const u8) -> isize { return call6(NODE_RENAME, @intCast(usize, fromDirectory), @intFromPtr(from.pointer), from.length, @intCast(usize, toDirectory), @intFromPtr(to.pointer), to.length) }

// snapshot's flags.
pub const Snapshot = struct {
    pub const READ_ONLY: usize = 0x1
}

// snapshot: a copy of the tree the directory handle `source` names, at
// `path` (a new name; from `directory`), sharing its files' pages.
pub fn snapshot(source: Handle, directory: Handle, path: []const u8, flags: usize) -> isize { return call5(SNAPSHOT, @intCast(usize, source), @intCast(usize, directory), @intFromPtr(path.pointer), path.length, flags) }

// timer_create: a timer whose deadline is `deadline` (the monotonic
// clock's nanoseconds), again every `period` (0: once). Its handle is
// READABLE once it expired; a streaming read of 8 bytes takes how many
// times since the last (0 bytes: it will not expire again).
pub fn timer(deadline: usize, period: usize) -> isize { return call2(TIMER_CREATE, deadline, period) }

// memory_map_object's flags.
pub const Map = struct {
    pub const WRITE: usize = 0x1
}

// memory_object: `size` bytes of memory of their own (zeroed), shared by
// every process that maps them (a branch keeps them shared).
pub fn memoryObject(size: usize) -> isize { return call1(MEMORY_OBJECT, size) }

// memory_map_object: `size` bytes of a memory object from `offset` (a
// page's start) mapped; the address.
pub fn mapObject(object: Handle, offset: usize, size: usize, flags: usize) -> isize { return call4(MEMORY_MAP_OBJECT, @intCast(usize, object), offset, size, flags) }

// group_join: a process (0: the caller; else a child) into a group (0: a
// new one); a handle to the group.
pub fn joinGroup(process: Handle, group: Handle) -> isize { return call2(GROUP_JOIN, @intCast(usize, process), @intCast(usize, group)) }

// session_front: a group in front of the session.
pub fn front(session: Handle, group: Handle) -> isize { return call2(SESSION_FRONT, @intCast(usize, session), @intCast(usize, group)) }
