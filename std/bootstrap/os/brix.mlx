// brixOS's own calls (spec/04-stdlib/os/brix.xml): handles, the one
// wait over them, reads and writes at a position or streaming, the
// clocks, the end of the process. SYSCALL with NATIVE_BASE + n in rax,
// the arguments in rdi, rsi, rdx, r10, r8, r9; a negative result is a
// Status, negated. (Below NATIVE_BASE brixOS takes Linux's numbers, so a
// program may use std.os.linux beside these while std moves over.)
pub extern("syscall") fn call1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn call2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn call3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn call4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}
pub extern("syscall") fn call5(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize {}
pub extern("syscall") fn call6(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {}

pub const NATIVE_BASE: usize = 0x4000
pub const HANDLE_CLOSE: usize = NATIVE_BASE + 0
pub const HANDLE_DUPLICATE: usize = NATIVE_BASE + 1
pub const HANDLE_INFO: usize = NATIVE_BASE + 2
pub const WAIT: usize = NATIVE_BASE + 3
pub const READ: usize = NATIVE_BASE + 4
pub const WRITE: usize = NATIVE_BASE + 5
pub const NODE_OPEN: usize = NATIVE_BASE + 6
pub const NODE_INFO: usize = NATIVE_BASE + 7
pub const NODE_MAKE: usize = NATIVE_BASE + 8
pub const NODE_REMOVE: usize = NATIVE_BASE + 9
pub const NODE_RENAME: usize = NATIVE_BASE + 10
pub const NODE_LIST: usize = NATIVE_BASE + 11
pub const STREAM_PAIR: usize = NATIVE_BASE + 12
pub const CHANNEL_PAIR: usize = NATIVE_BASE + 13
pub const CHANNEL_SEND: usize = NATIVE_BASE + 14
pub const CHANNEL_RECEIVE: usize = NATIVE_BASE + 15
pub const MEMORY_MAP: usize = NATIVE_BASE + 16
pub const MEMORY_UNMAP: usize = NATIVE_BASE + 17
pub const MEMORY_OBJECT: usize = NATIVE_BASE + 18
pub const MEMORY_MAP_OBJECT: usize = NATIVE_BASE + 19
pub const PROCESS_SPAWN: usize = NATIVE_BASE + 20
pub const PROCESS_BRANCH: usize = NATIVE_BASE + 21
pub const PROCESS_REPLACE: usize = NATIVE_BASE + 22
pub const PROCESS_EXIT: usize = NATIVE_BASE + 23
pub const PROCESS_CHANGE: usize = NATIVE_BASE + 24
pub const EVENT_SEND: usize = NATIVE_BASE + 25
pub const EVENTS_CLAIM: usize = NATIVE_BASE + 26
pub const EVENTS_TAKE: usize = NATIVE_BASE + 27
pub const UPCALL_SET: usize = NATIVE_BASE + 28
pub const UPCALL_RETURN: usize = NATIVE_BASE + 29
pub const GROUP_JOIN: usize = NATIVE_BASE + 30
pub const SESSION_FRONT: usize = NATIVE_BASE + 31
pub const CLOCK_READ: usize = NATIVE_BASE + 32
pub const TIMER_CREATE: usize = NATIVE_BASE + 33
pub const SNAPSHOT: usize = NATIVE_BASE + 34
pub const HANDLE_OF_DESCRIPTOR: usize = NATIVE_BASE + 35
pub const DIRECTORY_SET: usize = NATIVE_BASE + 36
pub const NODE_PATH: usize = NATIVE_BASE + 37
pub const NODE_MAP: usize = NATIVE_BASE + 38
pub const SOCKET_OPEN: usize = NATIVE_BASE + 39
pub const SOCKET_BIND: usize = NATIVE_BASE + 40
pub const SOCKET_CONNECT: usize = NATIVE_BASE + 41
pub const SOCKET_LISTEN: usize = NATIVE_BASE + 42
pub const SOCKET_ACCEPT: usize = NATIVE_BASE + 43
pub const SOCKET_SEND: usize = NATIVE_BASE + 44
pub const SOCKET_RECEIVE: usize = NATIVE_BASE + 45
pub const SOCKET_INFO: usize = NATIVE_BASE + 46
pub const PROCESS_START: usize = NATIVE_BASE + 47
pub const SESSION_PAIR: usize = NATIVE_BASE + 48
pub const SESSION_SIZE: usize = NATIVE_BASE + 49
pub const SYSTEM_POWER: usize = NATIVE_BASE + 50
pub const LISTENER_MAKE: usize = NATIVE_BASE + 51
pub const SYSTEM_INFO: usize = NATIVE_BASE + 52
pub const IDENTITY_SET: usize = NATIVE_BASE + 53
pub const NODE_OWN: usize = NATIVE_BASE + 54
pub const CHANNEL_PEER: usize = NATIVE_BASE + 55
pub const VOLUME_INFO: usize = NATIVE_BASE + 56

// A read or write without a position (streams, the session).
pub const STREAM: usize = 0xFFFFFFFFFFFFFFFF
// A wait without a deadline.
pub const FOREVER: usize = 0xFFFFFFFFFFFFFFFF

pub const Status = struct {
    pub const invalid_handle: isize = 1
    pub const wrong_kind: isize = 2
    pub const no_right: isize = 3
    pub const would_block: isize = 4
    pub const timed_out: isize = 5
    pub const not_found: isize = 6
    pub const exists: isize = 7
    pub const no_memory: isize = 8
    pub const bad_address: isize = 9
    pub const invalid: isize = 10
    pub const peer_gone: isize = 11
    pub const interrupted: isize = 12
    pub const too_large: isize = 17
    pub const unsupported: isize = 18
    // What a socket was to send cannot leave this machine as it is (it
    // has no network device, the link is down, it has no address, or the
    // destination is not on its subnet and there is no gateway): the
    // link's record (networkLink) says which.
    pub const unreachable: isize = 27
}

// The state bits of an object, as a wait watches them.
pub const State = struct {
    pub const READABLE: u32 = 0x1
    pub const WRITABLE: u32 = 0x2
    pub const PEER_GONE: u32 = 0x4
    pub const ENDED: u32 = 0x8
    pub const CHANGED: u32 = 0x10
    pub const EVENTS: u32 = 0x20
    pub const FRONT: u32 = 0x40
}

pub const Kind = struct {
    pub const PROCESS: u32 = 1
    pub const GROUP: u32 = 2
    pub const NODE: u32 = 3
    pub const STREAM: u32 = 4
    pub const CHANNEL: u32 = 5
    pub const SESSION: u32 = 6
    pub const MEMORY: u32 = 7
    pub const TIMER: u32 = 8
    pub const SOCKET: u32 = 9
}

pub const Rights = struct {
    pub const READ: u32 = 0x1
    pub const WRITE: u32 = 0x2
    pub const WAIT: u32 = 0x4
    pub const DUPLICATE: u32 = 0x8
    pub const TRANSFER: u32 = 0x10
    pub const CONTROL: u32 = 0x20
}

pub const Handle = u32

pub const WaitItem = struct {
    handle: u32
    want: u32
    // The state when the wait returned.
    seen: u32
    reserved: u32
}

pub const Info = struct {
    kind: u32
    rights: u32
    state: u32
    reserved: u32
}

// The kinds of events (spec <Events>).
pub const Event = struct {
    pub const INTERRUPT: u32 = 1
    pub const QUIT: u32 = 2
    pub const SUSPEND: u32 = 3
    pub const RESUME: u32 = 4
    pub const TERMINATE: u32 = 5
    pub const HANGUP: u32 = 6
    pub const CHILD: u32 = 7
    pub const FAULT: u32 = 8
    pub const READ_BEHIND: u32 = 9
    pub const HALT: u32 = 10
    pub const KILL: u32 = 11
    pub const NOTICE: u32 = 12
    pub const USER: u32 = 13
    pub const BROKEN: u32 = 14

    pub fn bit(kind: u32) -> u32 {
        const one: u32 = 1
        return one << @intCast(u5, kind)
    }
}

pub const EventRecord = struct {
    kind: u32
    detail: u32
    sender: u32
    reserved: u32
}

// The registers and SSE registers of the code an upcall interrupted.
pub const CONTEXT_SIZE: usize = 704

pub const Clock = struct {
    pub const MONOTONIC: usize = 0
    pub const REAL_TIME: usize = 1
}

// The handle of a descriptor the Linux layer opened (while std moves
// over); 0 when it is not open.
pub fn ofDescriptor(descriptor: isize) -> Handle {
    const result = call1(HANDLE_OF_DESCRIPTOR, @bitCast(usize, descriptor))
    return if result < 0 { 0 } else { @intCast(u32, result) }
}

pub fn close(handle: Handle) -> isize { return call1(HANDLE_CLOSE, @intCast(usize, handle)) }

// A handle to the same object with `rights` (no more than it has).
pub fn duplicate(handle: Handle, rights: u32) -> isize { return call2(HANDLE_DUPLICATE, @intCast(usize, handle), @intCast(usize, rights)) }

pub fn info(handle: Handle, into: *Info) -> isize { return call2(HANDLE_INFO, @intCast(usize, handle), @intFromPtr(into)) }

// Waits until one of `items` has a state it wants (the count of those
// that do), or -timed_out at `deadline` (monotonic nanoseconds; 0: do
// not wait, FOREVER: none); every item's seen word is filled.
pub fn wait(items: []WaitItem, deadline: usize) -> isize { return call3(WAIT, @intFromPtr(items.pointer), items.length, deadline) }

pub fn read(handle: Handle, into: []u8, at: usize) -> isize { return call4(READ, @intCast(usize, handle), @intFromPtr(into.pointer), into.length, at) }

pub fn write(handle: Handle, bytes: []const u8, at: usize) -> isize { return call4(WRITE, @intCast(usize, handle), @intFromPtr(bytes.pointer), bytes.length, at) }

pub fn clock(which: usize) -> usize { return @bitCast(usize, call1(CLOCK_READ, which)) }

pub fn exit(code: usize) -> void { _ = call1(PROCESS_EXIT, code) }

// The kinds (Event.bit of each) the program handles itself: they wait in
// its queue (or run the upcall) instead of their default action.
pub fn claim(kinds: u32) -> isize { return call1(EVENTS_CLAIM, @intCast(usize, kinds)) }

// The oldest events of the queue, taken out; how many.
pub fn take(records: []EventRecord) -> isize { return call2(EVENTS_TAKE, @intFromPtr(records.pointer), records.length) }

// The upcall: `entry(context)` runs on `stack` when a claimed event comes,
// and goes back by upcallReturn(context).
pub fn upcall(entry: usize, stack: usize, size: usize) -> isize { return call3(UPCALL_SET, entry, stack, size) }

pub fn upcallReturn(context: usize) -> void { _ = call1(UPCALL_RETURN, context) }

// node_open's flags.
pub const Open = struct {
    pub const READ: usize = 0x1
    pub const WRITE: usize = 0x2
    pub const CREATE: usize = 0x4
    pub const EXCLUSIVE: usize = 0x8
    pub const TRUNCATE: usize = 0x10
}

// A node's kind (node_info, node_list, node_make).
pub const NodeKind = struct {
    pub const FILE: u32 = 1
    pub const DIRECTORY: u32 = 2
    pub const LINK: u32 = 3
    pub const FIFO: u32 = 4
    pub const DEVICE: u32 = 5
    pub const LISTENER: u32 = 6
}

pub const NodeInfo = struct {
    kind: u32
    mode: u32
    links: u32
    reserved: u32
    size: u64
    // Nanoseconds since 1970.
    modified: u64
    number: u64
}

// What became of a child (process_change).
pub const Change = struct {
    pub const EXITED: u32 = 1
    pub const ENDED: u32 = 2
    pub const STOPPED: u32 = 3
    pub const WENT_ON: u32 = 4

    what: u32
    // The exit code, or the event's kind.
    value: u32
    detail: u32
    reserved: u32
}

// The roles a program's handles play, named in its start block by the
// spawner and asked for by the program (startRoles, handleFor).
pub const Role = struct {
    pub const INPUT: u32 = 1
    pub const OUTPUT: u32 = 2
    pub const ERRORS: u32 = 3
    // A directory: the program's working directory.
    pub const DIRECTORY: u32 = 4
    // The terminal the program belongs to.
    pub const SESSION: u32 = 5
    // The spawner's own roles start here.
    pub const OWN: u32 = 16
}

// A role and the handle playing it: in a start block the spawner's
// handle (one of those the program gets, or the caller's own for a
// replace); from process_start the program's own.
pub const RoleRecord = struct {
    role: u32
    handle: u32
}

// A program's start block: its arguments and environment
// (NULL-terminated arrays of NUL-terminated strings) and its handles by
// role (`count` RoleRecords at `roles`; none: input, output and errors
// are the first three handles).
pub const Start = struct {
    arguments: usize
    environment: usize
    roles: usize
    count: usize
}

// process_start: this program's roles as (role, handle) records, up to
// `into.length` of them; how many there are (more than fit: the first
// are given).
pub fn startRoles(into: []RoleRecord) -> isize { return call2(PROCESS_START, @intFromPtr(into.pointer), into.length) }

// The handle playing `role`, or 0 when none does.
pub fn handleFor(role: u32) -> Handle {
    var records: [16]RoleRecord = undefined
    const count = startRoles(records[0..16])
    if count < 0 { return 0 }
    var k: usize = 0
    while k < @intCast(usize, count) && k < 16 {
        if records[k].role == role { return records[k].handle }
        k += 1
    }
    return 0
}

// The node `path` names from `directory` (0: the working directory).
pub fn open(directory: Handle, path: []const u8, flags: usize, mode: usize) -> isize { return call5(NODE_OPEN, @intCast(usize, directory), @intFromPtr(path.pointer), path.length, flags, mode) }

pub fn nodeInfo(handle: Handle, into: *NodeInfo) -> isize { return call2(NODE_INFO, @intCast(usize, handle), @intFromPtr(into)) }

// A directory, a FIFO, or a link holding `target` at `path`.
pub fn make(directory: Handle, path: []const u8, kind: u32, mode: usize, target: []const u8) -> isize { return call6(NODE_MAKE, @intCast(usize, directory), @intFromPtr(path.pointer), path.length, @intCast(usize, kind) | (mode << 8), @intFromPtr(target.pointer), target.length) }

pub fn remove(directory: Handle, path: []const u8) -> isize { return call3(NODE_REMOVE, @intCast(usize, directory), @intFromPtr(path.pointer), path.length) }

// A directory's entries from `cookie` on into `into`: each the cookie
// after it (u64), its kind and its name's length (u32), the name, padded
// to 8 bytes; the bytes written.
pub fn list(handle: Handle, into: []u8, cookie: usize) -> isize { return call4(NODE_LIST, @intCast(usize, handle), @intFromPtr(into.pointer), into.length, cookie) }

// A pipe: [0] reads, [1] writes.
pub fn streamPair(ends: *[2]u32) -> isize { return call2(STREAM_PAIR, @intFromPtr(ends), 0) }

// stream_pair's flags: the ends go when the program is replaced.
pub const CLOSE_ON_REPLACE: usize = 0x1

pub fn streamPairWith(ends: *[2]u32, flags: usize) -> isize { return call2(STREAM_PAIR, @intFromPtr(ends), flags) }

// directory_set: the working directory.
pub fn setDirectory(directory: Handle) -> isize { return call1(DIRECTORY_SET, @intCast(usize, directory)) }

// node_path: a directory's path (0: the working directory) into `into`,
// NUL-terminated; its length.
pub fn pathOf(directory: Handle, into: []u8) -> isize { return call3(NODE_PATH, @intCast(usize, directory), @intFromPtr(into.pointer), into.length) }

pub fn channelPair(ends: *[2]u32) -> isize { return call1(CHANNEL_PAIR, @intFromPtr(ends)) }

// A message: bytes and handles (which leave this process).
pub fn send(handle: Handle, bytes: []const u8, handles: []const u32) -> isize { return call5(CHANNEL_SEND, @intCast(usize, handle), @intFromPtr(bytes.pointer), bytes.length, @intFromPtr(handles.pointer), handles.length) }

// The oldest message: its bytes and handles; sizes[0] its bytes, sizes[1]
// its handles.
pub fn receive(handle: Handle, bytes: []u8, handles: []u32, sizes: *[2]u32) -> isize { return call6(CHANNEL_RECEIVE, @intCast(usize, handle), @intFromPtr(bytes.pointer), bytes.length, @intFromPtr(handles.pointer), handles.length, @intFromPtr(sizes)) }

pub fn map(size: usize) -> isize { return call3(MEMORY_MAP, 0, size, 0) }

pub fn unmap(address: usize, size: usize) -> isize { return call2(MEMORY_UNMAP, address, size) }

// `program` in a new process with exactly `handles` (its start block's
// roles name some of them; none named: input, output, errors, ...); a
// handle to it.
pub fn spawn(program: Handle, start: *const Start, handles: []const u32) -> isize { return call4(PROCESS_SPAWN, @intCast(usize, program), @intFromPtr(start), @intFromPtr(handles.pointer), handles.length) }

// A copy-on-write copy of this process: a handle to it here, 0 in it.
pub fn branch() -> isize { return call1(PROCESS_BRANCH, 0) }

pub fn replace(program: Handle, start: *const Start) -> isize { return call2(PROCESS_REPLACE, @intCast(usize, program), @intFromPtr(start)) }

// What became of a child, taken; -would_block when nothing did yet.
pub fn change(process: Handle, into: *Change) -> isize { return call2(PROCESS_CHANGE, @intCast(usize, process), @intFromPtr(into)) }

// event_send: to a process, or to every process of a group.
pub fn sendEvent(process: Handle, kind: u32) -> isize { return call2(EVENT_SEND, @intCast(usize, process), @intCast(usize, kind)) }

// node_rename: `from` (in `fromDirectory`) to `to` (in `toDirectory`).
pub fn rename(fromDirectory: Handle, from: []const u8, toDirectory: Handle, to: []const u8) -> isize { return call6(NODE_RENAME, @intCast(usize, fromDirectory), @intFromPtr(from.pointer), from.length, @intCast(usize, toDirectory), @intFromPtr(to.pointer), to.length) }

// snapshot's flags.
pub const Snapshot = struct {
    pub const READ_ONLY: usize = 0x1
}

// snapshot: a copy of the tree the directory handle `source` names, at
// `path` (a new name; from `directory`), sharing its files' pages.
pub fn snapshot(source: Handle, directory: Handle, path: []const u8, flags: usize) -> isize { return call5(SNAPSHOT, @intCast(usize, source), @intCast(usize, directory), @intFromPtr(path.pointer), path.length, flags) }

// timer_create: a timer whose deadline is `deadline` (the monotonic
// clock's nanoseconds), again every `period` (0: once). Its handle is
// READABLE once it expired; a streaming read of 8 bytes takes how many
// times since the last (0 bytes: it will not expire again).
pub fn timer(deadline: usize, period: usize) -> isize { return call2(TIMER_CREATE, deadline, period) }

// memory_map_object's flags.
pub const Map = struct {
    pub const WRITE: usize = 0x1
}

// memory_object: `size` bytes of memory of their own (zeroed), shared by
// every process that maps them (a branch keeps them shared).
pub fn memoryObject(size: usize) -> isize { return call1(MEMORY_OBJECT, size) }

// memory_map_object: `size` bytes of a memory object from `offset` (a
// page's start) mapped; the address.
pub fn mapObject(object: Handle, offset: usize, size: usize, flags: usize) -> isize { return call4(MEMORY_MAP_OBJECT, @intCast(usize, object), offset, size, flags) }

// group_join: a process (0: the caller; else a child) into a group (0: a
// new one); a handle to the group.
pub fn joinGroup(process: Handle, group: Handle) -> isize { return call2(GROUP_JOIN, @intCast(usize, process), @intCast(usize, group)) }

// session_front: a group in front of the session.
pub fn front(session: Handle, group: Handle) -> isize { return call2(SESSION_FRONT, @intCast(usize, session), @intCast(usize, group)) }

// session_pair: a terminal of its own: `ends[0]` its control side (what
// programs write is read there, what is written there is typed),
// `ends[1]` the session programs get.
pub fn sessionPair(ends: *[2]u32) -> isize { return call1(SESSION_PAIR, @intFromPtr(ends)) }

// session_size: the terminal's size in cells.
pub fn sessionSize(session: Handle, columns: usize, rows: usize) -> isize { return call3(SESSION_SIZE, @intCast(usize, session), columns, rows) }

// system_power: the system's end, by the first process (the init):
// every volume committed, then the machine halted, powered off or
// restarted (it does not return then).
pub const Power = struct {
    pub const HALT: usize = 0
    pub const POWEROFF: usize = 1
    pub const REBOOT: usize = 2
}
pub fn power(kind: usize) -> isize { return call1(SYSTEM_POWER, kind) }

// listener_make: a listener node at `path` (from `directory`; 0: the
// working directory), the caller's end of its channel as the handle. A
// program that opens the node gets a channel of its own, whose far end
// arrives on the listener's channel as a message with no bytes and one
// handle (channel_receive takes it; READABLE says one waits): brixOS's
// listening socket.
// system_info: the machine's figures (memory and what is free of it in
// bytes, processors, the uptime in nanoseconds, the kernel's counts of
// page faults, system calls, switches and the devices' message-signalled
// interrupts since the boot; the waits for the kernel in nanoseconds:
// those of processors that had something to run summed, the longest
// since the boot and the longest of the last ten to twenty seconds, each
// with what held the kernel for most of it (the process's id above 32
// bits, 0 for a processor that idled; below them HELD_BY_CALL and a
// system call's number, an interrupt's or fault's vector, or HELD_IDLE
// for the idle loop), and the waits of processors that had nothing to
// run summed); how many words the kernel has (more than the struct's: a
// newer kernel; fewer: an older one, which leaves the last ones 0), or a
// status.
pub const SystemInfo = struct {
    pub const HELD_BY_CALL: usize = 0x80000000
    pub const HELD_IDLE: usize = 0x7FFFFFFF

    memory: usize
    free: usize
    processors: usize
    uptime: usize
    pageFaults: usize
    systemCalls: usize
    switches: usize
    deviceInterrupts: usize
    kernelWaits: usize
    longestWait: usize
    longestWaitHolder: usize
    recentWait: usize
    recentWaitHolder: usize
    idleWaits: usize
}

pub fn systemInfo(into: *SystemInfo) -> isize {
    into.*.deviceInterrupts = 0
    into.*.kernelWaits = 0
    into.*.longestWait = 0
    into.*.longestWaitHolder = 0
    into.*.recentWait = 0
    into.*.recentWaitHolder = 0
    into.*.idleWaits = 0
    return call2(SYSTEM_INFO, @intFromPtr(into), 14)
}

// volume_info: the volume a path is on (from `directory`, 0: the working
// directory), as the kernel keeps it: its size and what is free (a count
// the store keeps: asking is cheap), and what the store did since the
// mount (times in nanoseconds). The words the kernel has (more than the
// struct's: a newer kernel), or a status.
pub const VolumeInfo = struct {
    // kind
    pub const MEMORY: usize = 0
    pub const BRIXFS: usize = 1
    // flags: what changed is committed, the free blocks are found again
    // by a walk over every root and compared with what the store held
    // (user 0 only): `unreached` and `unheld` say what differed.
    pub const CHECK: usize = 1

    kind: usize
    blockSize: usize
    blocks: usize
    free: usize
    inodes: usize
    inodesNeverUsed: usize
    generation: usize
    readOnly: usize
    // 1: a commit frees just what it replaced; 0: a walk over every root
    // after each commit finds the free blocks.
    exact: usize
    mountTime: usize
    commits: usize
    commitTime: usize
    longestCommit: usize
    walks: usize
    walkTime: usize
    blocksRead: usize
    blocksWritten: usize
    // With CHECK: blocks the store held that no root reaches (room lost
    // until the next walk), and blocks a root reaches that it did not
    // hold (never: 0).
    unreached: usize
    unheld: usize
}

pub fn volumeInfo(directory: Handle, path: []const u8, into: *VolumeInfo, flags: usize) -> isize {
    return call6(VOLUME_INFO, @intCast(usize, directory), @intFromPtr(path.pointer), path.length, @intFromPtr(into), 19, flags)
}

// identity_set: this process's user and group, which its children
// inherit (user 0 may take any; another only its own).
pub fn setIdentity(user: usize, group: usize) -> isize { return call2(IDENTITY_SET, user, group) }

// node_own: the node's owner and group (KEEP: as it is).
pub const KEEP: usize = 0xFFFFFFFF
pub fn own(handle: Handle, user: usize, group: usize) -> isize { return call3(NODE_OWN, @intCast(usize, handle), user, group) }

// channel_peer: who holds the other end of a channel (its program's
// leaf name, so a bus can name the app).
pub const Peer = struct {
    pid: u32
    user: u32
    group: u32
    nameLength: u32
    name: [64]u8
}
pub fn channelPeer(handle: Handle, into: *Peer) -> isize { return call2(CHANNEL_PEER, @intCast(usize, handle), @intFromPtr(into)) }

pub fn listen(directory: Handle, path: []const u8, mode: usize) -> isize { return call4(LISTENER_MAKE, @intCast(usize, directory), @intFromPtr(path.pointer), path.length, mode) }

// node_map: a file's bytes from `offset` (a page's start) mapped as the
// program's own (its pages shared with the file until written: a private
// view); the address.
pub fn mapNode(file: Handle, offset: usize, size: usize) -> isize { return call3(NODE_MAP, @intCast(usize, file), offset, size) }

// ---- sockets (spec <Calls> 39 to 46) ----

// socket_open's kinds.
pub const SocketKind = struct {
    pub const STREAM: usize = 1
    pub const DATAGRAM: usize = 2
    pub const PING: usize = 3
}

// An IPv4 address and a port, as the socket calls take and give them.
pub const SocketAddress = struct {
    address: [4]u8
    port: u32
}

// socket_info's record.
pub const SocketInfo = struct {
    local: SocketAddress
    peer: SocketAddress
    // A Status code (0: none), taken by the call.
    pendingError: u32
    connected: u32
}

// A socket of `kind`: its handle, or -Status.
pub fn socketOpen(kind: usize) -> isize { return call1(SOCKET_OPEN, kind) }
pub fn socketBind(socket: Handle, port: usize) -> isize { return call2(SOCKET_BIND, @intCast(usize, socket), port) }
// A stream's connection begins (the handle WRITABLE when made,
// PEER_GONE when it failed; -Status.unreachable at once when nothing
// can leave this machine for the address); a datagram socket's peer.
pub fn socketConnect(socket: Handle, to: *const SocketAddress) -> isize { return call2(SOCKET_CONNECT, @intCast(usize, socket), @intFromPtr(to)) }
pub fn socketListen(socket: Handle) -> isize { return call1(SOCKET_LISTEN, @intCast(usize, socket)) }
// The next connection's handle (would_block: none yet; wait for READABLE).
pub fn socketAccept(socket: Handle, peer: ?*SocketAddress) -> isize { return call2(SOCKET_ACCEPT, @intCast(usize, socket), if peer == null { 0 } else { @intFromPtr(peer.?) }) }
// Bytes taken (would_block: none could be); a datagram to `to` (null:
// the peer; -Status.unreachable when it cannot leave this machine as it
// is).
pub fn socketSend(socket: Handle, bytes: []const u8, to: ?*const SocketAddress) -> isize { return call4(SOCKET_SEND, @intCast(usize, socket), @intFromPtr(bytes.pointer), bytes.length, if to == null { 0 } else { @intFromPtr(to.?) }) }
// Bytes received (0: the peer closed; would_block: none yet), their
// source into `from`.
pub fn socketReceive(socket: Handle, into: []u8, from: ?*SocketAddress) -> isize { return call4(SOCKET_RECEIVE, @intCast(usize, socket), @intFromPtr(into.pointer), into.length, if from == null { 0 } else { @intFromPtr(from.?) }) }
pub fn socketInfo(socket: Handle, into: *SocketInfo) -> isize { return call2(SOCKET_INFO, @intCast(usize, socket), @intFromPtr(into)) }

// ---- network links (spec <NetworkLink>) ----

// A network link's state, from the record a read of /devices/netN gives
// (the kernel runs the network; this is how a program sees it).
pub const NetworkLink = struct {
    // Where the address is from.
    pub const NONE: u32 = 0
    pub const DHCP: u32 = 1
    pub const SETTINGS: u32 = 2
    // A lease that does not end.
    pub const FOR_EVER: u32 = 0xFFFFFFFF

    // The link is up: a cable with a partner at its other end.
    up: bool
    // DHCP is asking for an address.
    asking: bool
    // NONE (no address: the four addresses are 0.0.0.0), DHCP, or
    // SETTINGS (the file /system/settings/network).
    configured: u32
    // Megabits a second; 0 when the device does not say or the link is
    // down.
    speed: u32
    hardware: [6]u8
    // The driver's name ("virtio", "igb"): `driverLength` bytes of it.
    driver: [8]u8
    driverLength: usize
    address: [4]u8
    mask: [4]u8
    // 0.0.0.0: none (only the own subnet is reached; no names are
    // looked up).
    gateway: [4]u8
    nameServer: [4]u8
    // The frames the device took and sent since the boot.
    received: usize
    sent: usize
    // DHCP's lease: the seconds it still runs and the seconds it was
    // given for. 0: there is no lease (a static configuration, no
    // address, or a kernel whose record does not say); FOR_EVER: it does
    // not end.
    leaseLeft: u32
    leaseTime: u32
}

// The record's bytes as this std knows it, and its flags.
const NETWORK_RECORD: usize = 72
const NETWORK_UP: usize = 0x1
const NETWORK_ASKING: usize = 0x2

// The most links there are names for here (net0 to net9).
pub const NETWORK_LINKS: usize = 10

fn recordWord(record: [*]const u8, at: usize, bytes: usize) -> usize {
    var value: usize = 0
    var k: usize = 0
    while k < bytes {
        value |= @intCast(usize, record[at + k]) << @intCast(u6, k * 8)
        k += 1
    }
    return value
}

// Link `index`'s state (/devices/net<index>) into `into`: 0, or a Status
// negated (not_found: there is no such link; the links are numbered
// without gaps, so the first one not found ends the list). What a
// shorter record of an older kernel lacks is left 0; what a longer one
// adds is not read.
pub fn networkLink(index: usize, into: *NetworkLink) -> isize {
    if index >= NETWORK_LINKS { return -Status.not_found }
    var path: [16]u8 = undefined
    const prefix = "/devices/net"
    var length: usize = 0
    while length < prefix.length {
        path[length] = prefix[length]
        length += 1
    }
    path[length] = @intCast(u8, 48 + index)
    length += 1
    const opened = open(0, path[0..length], Open.READ, 0)
    if opened < 0 { return opened }
    var record: [72]u8 = undefined
    var k: usize = 0
    while k < NETWORK_RECORD {
        record[k] = 0
        k += 1
    }
    const got = read(@intCast(Handle, opened), record[0..NETWORK_RECORD], 0)
    _ = close(@intCast(Handle, opened))
    if got < 0 { return got }
    if got < 4 { return -Status.invalid }
    const bytes: [*]const u8 = &record
    // (Only what the record says it has counts.)
    const said = recordWord(bytes, 0, 4)
    k = if said < @bitCast(usize, got) { said } else { @bitCast(usize, got) }
    while k < NETWORK_RECORD {
        record[k] = 0
        k += 1
    }
    const flags = recordWord(bytes, 4, 4)
    into.*.up = flags & NETWORK_UP != 0
    into.*.asking = flags & NETWORK_ASKING != 0
    into.*.configured = @intCast(u32, recordWord(bytes, 8, 4))
    into.*.speed = @intCast(u32, recordWord(bytes, 12, 4))
    k = 0
    while k < 6 {
        into.*.hardware[k] = record[16 + k]
        k += 1
    }
    into.*.driverLength = 0
    k = 0
    while k < 8 {
        into.*.driver[k] = record[24 + k]
        if record[24 + k] != 0 && into.*.driverLength == k { into.*.driverLength = k + 1 }
        k += 1
    }
    k = 0
    while k < 4 {
        into.*.address[k] = record[32 + k]
        into.*.mask[k] = record[36 + k]
        into.*.gateway[k] = record[40 + k]
        into.*.nameServer[k] = record[44 + k]
        k += 1
    }
    into.*.received = recordWord(bytes, 48, 8)
    into.*.sent = recordWord(bytes, 56, 8)
    into.*.leaseLeft = @intCast(u32, recordWord(bytes, 64, 4))
    into.*.leaseTime = @intCast(u32, recordWord(bytes, 68, 4))
    return 0
}
