// brixOS's own calls (spec/04-stdlib/os/brix.xml): handles, the one
// wait over them, reads and writes at a position or streaming, the
// clocks, the end of the process. SYSCALL with NATIVE_BASE + n in rax,
// the arguments in rdi, rsi, rdx, r10, r8, r9; a negative result is a
// Status, negated. (Below NATIVE_BASE brixOS takes Linux's numbers, so a
// program may use std.os.linux beside these while std moves over.)
pub extern("syscall") fn call1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn call2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn call3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn call4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}

pub const NATIVE_BASE: usize = 0x4000
pub const HANDLE_CLOSE: usize = NATIVE_BASE + 0
pub const HANDLE_DUPLICATE: usize = NATIVE_BASE + 1
pub const HANDLE_INFO: usize = NATIVE_BASE + 2
pub const WAIT: usize = NATIVE_BASE + 3
pub const READ: usize = NATIVE_BASE + 4
pub const WRITE: usize = NATIVE_BASE + 5
pub const PROCESS_EXIT: usize = NATIVE_BASE + 23
pub const CLOCK_READ: usize = NATIVE_BASE + 32

// A read or write without a position (streams, the session).
pub const STREAM: usize = 0xFFFFFFFFFFFFFFFF
// A wait without a deadline.
pub const FOREVER: usize = 0xFFFFFFFFFFFFFFFF

pub const Status = struct {
    pub const invalid_handle: isize = 1
    pub const wrong_kind: isize = 2
    pub const no_right: isize = 3
    pub const would_block: isize = 4
    pub const timed_out: isize = 5
    pub const not_found: isize = 6
    pub const exists: isize = 7
    pub const no_memory: isize = 8
    pub const bad_address: isize = 9
    pub const invalid: isize = 10
    pub const peer_gone: isize = 11
    pub const interrupted: isize = 12
    pub const unsupported: isize = 18
}

// The state bits of an object, as a wait watches them.
pub const State = struct {
    pub const READABLE: u32 = 0x1
    pub const WRITABLE: u32 = 0x2
    pub const PEER_GONE: u32 = 0x4
    pub const ENDED: u32 = 0x8
    pub const CHANGED: u32 = 0x10
    pub const EVENTS: u32 = 0x20
    pub const FRONT: u32 = 0x40
}

pub const Kind = struct {
    pub const PROCESS: u32 = 1
    pub const GROUP: u32 = 2
    pub const NODE: u32 = 3
    pub const STREAM: u32 = 4
    pub const CHANNEL: u32 = 5
    pub const SESSION: u32 = 6
    pub const MEMORY: u32 = 7
    pub const TIMER: u32 = 8
}

pub const Rights = struct {
    pub const READ: u32 = 0x1
    pub const WRITE: u32 = 0x2
    pub const WAIT: u32 = 0x4
    pub const DUPLICATE: u32 = 0x8
    pub const TRANSFER: u32 = 0x10
    pub const CONTROL: u32 = 0x20
}

pub const Handle = u32

pub const WaitItem = struct {
    handle: u32
    want: u32
    // The state when the wait returned.
    seen: u32
    reserved: u32
}

pub const Info = struct {
    kind: u32
    rights: u32
    state: u32
    reserved: u32
}

pub const Clock = struct {
    pub const MONOTONIC: usize = 0
    pub const REAL_TIME: usize = 1
}

// While programs get their descriptors from the Linux layer, a
// descriptor's handle is its number plus one.
pub fn ofDescriptor(descriptor: isize) -> Handle { return @intCast(u32, descriptor + 1) }

pub fn close(handle: Handle) -> isize { return call1(HANDLE_CLOSE, @intCast(usize, handle)) }

// A handle to the same object with `rights` (no more than it has).
pub fn duplicate(handle: Handle, rights: u32) -> isize { return call2(HANDLE_DUPLICATE, @intCast(usize, handle), @intCast(usize, rights)) }

pub fn info(handle: Handle, into: *Info) -> isize { return call2(HANDLE_INFO, @intCast(usize, handle), @intFromPtr(into)) }

// Waits until one of `items` has a state it wants (the count of those
// that do), or -timed_out at `deadline` (monotonic nanoseconds; 0: do
// not wait, FOREVER: none); every item's seen word is filled.
pub fn wait(items: []WaitItem, deadline: usize) -> isize { return call3(WAIT, @intFromPtr(items.pointer), items.length, deadline) }

pub fn read(handle: Handle, into: []u8, at: usize) -> isize { return call4(READ, @intCast(usize, handle), @intFromPtr(into.pointer), into.length, at) }

pub fn write(handle: Handle, bytes: []const u8, at: usize) -> isize { return call4(WRITE, @intCast(usize, handle), @intFromPtr(bytes.pointer), bytes.length, at) }

pub fn clock(which: usize) -> usize { return @bitCast(usize, call1(CLOCK_READ, which)) }

pub fn exit(code: usize) -> void { _ = call1(PROCESS_EXIT, code) }
