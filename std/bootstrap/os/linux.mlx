pub const LOCK_EX: usize = 2
pub const LOCK_NB: usize = 4
pub const LOCK_UN: usize = 8

// The file type bits of a mode (st_mode).
pub const S_IFMT: u32 = 61440
pub const S_IFSOCK: u32 = 49152
pub const S_IFLNK: u32 = 40960
pub const S_IFREG: u32 = 32768
pub const S_IFDIR: u32 = 16384
pub const S_IFCHR: u32 = 8192
pub const S_IFIFO: u32 = 4096

pub fn read(descriptor: isize, into: [*]u8, capacity: usize) -> isize {
    return syscall3(SYS_read, @bitCast(usize, descriptor), @intFromPtr(into), capacity)
}

pub fn write(descriptor: isize, bytes: [*]const u8, length: usize) -> isize {
    return syscall3(SYS_write, @bitCast(usize, descriptor), @intFromPtr(bytes), length)
}

// Writes all of `bytes`, again after a signal interrupts it; false when
// the descriptor takes no more.
pub fn writeAll(descriptor: isize, bytes: []const u8) -> bool {
    const start = @intFromPtr(bytes.pointer)
    var done: usize = 0
    while done < bytes.length {
        const wrote = syscall3(SYS_write, @bitCast(usize, descriptor), start + done, bytes.length - done)
        if wrote != EINTR {
            if wrote <= 0 { return false }
            done += @bitCast(usize, wrote)
        }
    }
    return true
}

// Closes `descriptor`; a negative one (none) is left alone.
pub fn close(descriptor: isize) -> void {
    if descriptor >= 0 {
        const ignored = syscall1(SYS_close, @bitCast(usize, descriptor))
    }
}

// open(2) of a NUL-terminated path: the descriptor or -errno.
pub fn open(path: [*]const u8, flags: usize, mode: usize) -> isize {
    return syscall3(SYS_open, @intFromPtr(path), flags, mode)
}

pub fn openAt(directory: isize, path: [*]const u8, flags: usize, mode: usize) -> isize {
    return syscall4(SYS_openat, @bitCast(usize, directory), @intFromPtr(path), flags, mode)
}

pub fn ioctl(descriptor: isize, request: usize, argument: usize) -> isize {
    return syscall3(SYS_ioctl, @bitCast(usize, descriptor), request, argument)
}

pub fn fcntl(descriptor: isize, command: usize, argument: usize) -> isize {
    return syscall3(SYS_fcntl, @bitCast(usize, descriptor), command, argument)
}

// Lets `descriptor` stay open across execve (clears FD_CLOEXEC): how a
// child is handed a descriptor of its parent's.
pub fn keepOnExec(descriptor: isize) -> isize {
    return syscall3(SYS_fcntl, @bitCast(usize, descriptor), F_SETFD, 0)
}

// Adds O_NONBLOCK to the descriptor's flags; false when it could not.
pub fn setNonBlocking(descriptor: isize) -> bool {
    const flags = syscall3(SYS_fcntl, @bitCast(usize, descriptor), F_GETFL, 0)
    if flags < 0 { return false }
    return syscall3(SYS_fcntl, @bitCast(usize, descriptor), F_SETFL, @bitCast(usize, flags) | O_NONBLOCK) >= 0
}

pub fn dup(descriptor: isize) -> isize {
    return syscall1(SYS_dup, @bitCast(usize, descriptor))
}

pub fn dup2(from: isize, to: isize) -> isize {
    return syscall2(SYS_dup2, @bitCast(usize, from), @bitCast(usize, to))
}

// A pipe (pipe2 with `flags`, as O_CLOEXEC | O_NONBLOCK): its read and its
// write end; false when the kernel made none.
pub fn pipe(read_end: *isize, write_end: *isize, flags: usize) -> bool {
    var ends: [2]i32 = [2]i32{ -1, -1 }
    if syscall2(SYS_pipe2, @intFromPtr(&ends), flags) != 0 { return false }
    read_end.* = @intCast(isize, ends[0])
    write_end.* = @intCast(isize, ends[1])
    return true
}

pub fn seek(descriptor: isize, offset: isize, whence: usize) -> isize {
    return syscall3(SYS_lseek, @bitCast(usize, descriptor), @bitCast(usize, offset), whence)
}

pub fn truncate(descriptor: isize, length: usize) -> isize {
    return syscall2(SYS_ftruncate, @bitCast(usize, descriptor), length)
}

// Directory records (linux_dirent64) into `into`: the bytes read, 0 at
// the end, or -errno.
pub fn getdents(descriptor: isize, into: [*]u8, capacity: usize) -> isize {
    return syscall3(SYS_getdents64, @bitCast(usize, descriptor), @intFromPtr(into), capacity)
}

pub fn unlink(path: [*]const u8) -> isize { return syscall1(SYS_unlink, @intFromPtr(path)) }

pub fn makeDirectory(path: [*]const u8, mode: usize) -> isize { return syscall2(SYS_mkdir, @intFromPtr(path), mode) }

pub fn chmod(path: [*]const u8, mode: usize) -> isize { return syscall2(SYS_chmod, @intFromPtr(path), mode) }

pub fn chdir(path: [*]const u8) -> isize { return syscall1(SYS_chdir, @intFromPtr(path)) }

// ---------------------------------------------------------------------------
// Memory

pub const PROT_NONE: usize = 0
pub const PROT_READ: usize = 1
pub const PROT_WRITE: usize = 2
pub const PROT_EXEC: usize = 4
pub const MAP_SHARED: usize = 1
pub const MAP_PRIVATE: usize = 2
pub const MAP_ANONYMOUS: usize = 32
pub const MFD_CLOEXEC: usize = 1
pub const MFD_ALLOW_SEALING: usize = 2

// mmap(2): the address, or -errno (see `failed`).
pub fn mmap(address: usize, length: usize, protection: usize, flags: usize, descriptor: isize, offset: usize) -> isize {
    return syscall6(SYS_mmap, address, length, protection, flags, @bitCast(usize, descriptor), offset)
}

// `length` bytes of `descriptor` mapped shared, for reading (and writing
// when `writable`): the address, 0 when it could not be mapped.
pub fn mapShared(descriptor: isize, length: usize, writable: bool) -> usize {
    const protection = if writable { PROT_READ | PROT_WRITE } else { PROT_READ }
    const result = syscall6(SYS_mmap, 0, length, protection, MAP_SHARED, @bitCast(usize, descriptor), 0)
    if failed(result) { return 0 }
    return @bitCast(usize, result)
}

// `length` bytes of zeroed private memory of the process's own (no file,
// no allocator, as programs keep it for a crash handler, a profile or a
// scratch area): the address, 0 when there is none.
pub fn mapAnonymous(length: usize) -> usize {
    const result = syscall6(SYS_mmap, 0, length, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, 18446744073709551615, 0)
    if failed(result) { return 0 }
    return @bitCast(usize, result)
}

// Unmaps what mapShared or mmap mapped; address 0 (none) is left alone.
pub fn munmap(address: usize, length: usize) -> void {
    if address != 0 {
        const ignored = syscall2(SYS_munmap, address, length)
    }
}

// An anonymous memory file (memfd_create) named `name` (NUL-terminated):
// the descriptor or -errno.
pub fn memfdCreate(name: [*]const u8, flags: usize) -> isize {
    return syscall2(SYS_memfd_create, @intFromPtr(name), flags)
}

