// Raw Linux x86_64 syscall gateway. The first argument is loaded into rax;
// the remaining six use rdi, rsi, rdx, r10, r8, and r9.
//
// Programs name system calls by their x86_64 numbers everywhere; the
// aarch64 backend translates them (compiler/selfhost/backend/aarch64), so
// this table is the only one a program needs. Below it are the kernel's
// constants (as the system calls take them: errors negated, flags as
// usize) and thin wrappers over descriptors, memory and processes that
// keep the kernel's conventions: a negative result is -errno. The
// submodules hold the rest: `event` (poll, epoll, signals, timers and
// counters as descriptors), `socket` (sockets, Unix addresses and
// descriptors passed along), `process` (processes and their signals),
// `tty` (the ioctls of terminals and virtual consoles), `fbdev`,
// `evdev` and `drm` (framebuffers, input devices and DRM cards),
// `thread` and `system`.

pub const thread = @import("./linux/thread.mlx")
pub const socket = @import("./linux/socket.mlx")
pub const event = @import("./linux/event.mlx")
pub const system = @import("./linux/system.mlx")
pub const process = @import("./linux/process.mlx")
pub const tty = @import("./linux/tty.mlx")
pub const fbdev = @import("./linux/fbdev.mlx")
pub const evdev = @import("./linux/evdev.mlx")
pub const drm = @import("./linux/drm.mlx")

pub extern("syscall") fn syscall0(number: usize) -> isize {}
pub extern("syscall") fn syscall1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn syscall2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}
pub extern("syscall") fn syscall5(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize {}
pub extern("syscall") fn syscall6(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {}

