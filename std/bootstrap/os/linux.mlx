pub fn getpid() -> isize { return syscall0(SYS_getpid) }

// Ends the process (every thread) with `status`.
pub fn exitGroup(status: usize) -> void {
    const ignored = syscall1(SYS_exit_group, status)
}

// ---------------------------------------------------------------------------
// Time

pub const CLOCK_REALTIME: usize = 0
pub const CLOCK_MONOTONIC: usize = 1
pub const CLOCK_BOOTTIME: usize = 7

pub fn sleepMilliseconds(milliseconds: usize) -> void {
    var duration: [2]usize = [2]usize{ milliseconds / 1000, (milliseconds % 1000) * 1000000 }
    const ignored = syscall2(SYS_nanosleep, @intFromPtr(&duration), 0)
}
