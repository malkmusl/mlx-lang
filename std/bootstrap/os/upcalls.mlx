// The program's one upcall on brixOS (spec/04-stdlib/os/brix.xml,
// <Events>), shared by whatever takes events: a handler per kind, each
// given the event's record and the upcall's context (the registers where
// the program was; context.mlx's offsets). std.events gives programs
// their handlers here, std.crash the fault's. The upcall runs on a stack
// of its own, mapped the first time a kind is handled.
//
// Elsewhere nothing calls this (a Linux program's signals are
// std.linux.process's).
const brix = @import("./brix.mlx")

pub const Record = brix.EventRecord
pub const Handler = fn(record: Record, context: usize) -> void

// The kinds there are and the upcall's stack (a crash report runs on it:
// it is not small).
const KINDS: usize = 16
pub const STACK: usize = 262144

// The context record's words: the registers (as the kernel's frame keeps
// them), then the last fault's address.
pub const R15: usize = 0
pub const R14: usize = 1
pub const R13: usize = 2
pub const R12: usize = 3
pub const R11: usize = 4
pub const R10: usize = 5
pub const R9: usize = 6
pub const R8: usize = 7
pub const RBP: usize = 8
pub const RDI: usize = 9
pub const RSI: usize = 10
pub const RDX: usize = 11
pub const RCX: usize = 12
pub const RBX: usize = 13
pub const RAX: usize = 14
pub const VECTOR: usize = 15
pub const CODE: usize = 16
pub const RIP: usize = 17
pub const RSP: usize = 20
pub const FAULT_ADDRESS: usize = 22

var handlers: [KINDS]Handler = undefined // (per run)
var handled: u32 = 0 // (per run)
// Kinds the program claims to take itself (events_take, waiting on its
// own handle's EVENTS): claimed, not routed to the upcall.
var queued: u32 = 0 // (per run)
var installed: bool = false // (per run)

// The records the upcall takes, not a value of its own: a crash because
// the value arena is full comes through here, before the report makes
// room in it.
var takenRecords: [8]Record = undefined // (per run)

// The upcall: every event waiting, each to its kind's handler; then back
// to where the program was.
export fn mlxUpcall(context: usize) -> void {
    const records: [*]Record = &takenRecords
    while true {
        const taken = brix.take(records[0..8])
        if taken <= 0 { break }
        var k: usize = 0
        while k < @bitCast(usize, taken) {
            const kind = records[k].kind
            if @intCast(usize, kind) < KINDS && handled & brix.Event.bit(kind) != 0 { handlers[@intCast(usize, kind)](records[k], context) }
            k += 1
        }
    }
    brix.upcallReturn(context)
}

// `handler` runs for each event of `kind` from now on; false when the
// kind cannot be handled (halt, kill) or the upcall could not be set.
pub fn handle(kind: u32, handler: Handler) -> bool {
    if kind == 0 || @intCast(usize, kind) >= KINDS || kind == brix.Event.HALT || kind == brix.Event.KILL { return false }
    if !installed {
        const stack = brix.map(STACK)
        if stack < 0 { return false }
        const entry = unsafe { @intFromPtr(mlxUpcall) }
        if brix.upcall(entry, @bitCast(usize, stack), STACK) < 0 { return false }
        installed = true
    }
    handlers[@intCast(usize, kind)] = handler
    handled |= brix.Event.bit(kind)
    return claimAll()
}

// What is claimed: the kinds a handler takes (routed to the upcall) and
// the ones the program takes itself.
fn claimAll() -> bool {
    if installed { _ = brix.route(handled) }
    return brix.claim(handled | queued) >= 0
}

// The program takes events of `kinds` itself (brix.take; they wait in the
// queue, the upcall leaves them): its own handling of them, beside
// whatever handlers take (theirs win for a kind both name).
pub fn queue(kinds: u32) -> bool {
    queued = kinds & ~handled
    return claimAll()
}

// `kind` back to its default.
pub fn release(kind: u32) -> void {
    if @intCast(usize, kind) >= KINDS { return }
    handled &= ~brix.Event.bit(kind)
    _ = claimAll()
}

// Whether a handler takes `kind`.
pub fn handles(kind: u32) -> bool { return @intCast(usize, kind) < KINDS && handled & brix.Event.bit(kind) != 0 }

// The context word `index` (R15 ... FAULT_ADDRESS).
pub fn word(context: usize, index: usize) -> usize {
    const words: [*]const usize = unsafe { @ptrFromInt([*]const usize, context) }
    return words[index]
}
