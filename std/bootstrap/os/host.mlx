// The calls std's files and clocks make to the operating system the
// program runs on: Linux's here. host.brixos.mlx has brixOS's own; the
// compiler takes it for --target=x86_64-brixos (a module X.mlx is
// X.<platform>.mlx when there is one). This file is plain enough for
// every compiler that builds the compiler.
const linux = @import("./linux.mlx")

// clock's clocks.
pub const REALTIME: usize = 0
pub const MONOTONIC: usize = 1

// open(2): a descriptor, or -errno.
pub fn open(path: [*]const u8, flags: usize, mode: usize) -> isize {
    return linux.syscall3(linux.SYS_open, @intFromPtr(path), flags, mode)
}

// openat(2), from the directory `directory` (AT_FDCWD: the working one).
pub fn openAt(directory: isize, path: [*]const u8, flags: usize, mode: usize) -> isize {
    return linux.syscall4(linux.SYS_openat, @bitCast(usize, directory), @intFromPtr(path), flags, mode)
}

pub fn read(descriptor: isize, destination: usize, length: usize) -> isize {
    return linux.syscall3(linux.SYS_read, @bitCast(usize, descriptor), destination, length)
}

pub fn write(descriptor: isize, source: usize, length: usize) -> isize {
    return linux.syscall3(linux.SYS_write, @bitCast(usize, descriptor), source, length)
}

// getdents64: the directory's entries from where the last read ended.
pub fn readDirectory(descriptor: isize, destination: usize, length: usize) -> isize {
    return linux.syscall3(linux.SYS_getdents64, @bitCast(usize, descriptor), destination, length)
}

// pipe2 without flags: its read end and its write end.
pub fn pipe(ends: *[2]isize) -> bool {
    var descriptors: [2]i32 = [2]i32{ -1, -1 }
    if linux.syscall2(linux.SYS_pipe2, @intFromPtr(&descriptors), 0) < 0 { return false }
    ends.*[0] = @intCast(isize, descriptors[0])
    ends.*[1] = @intCast(isize, descriptors[1])
    return true
}

// getcwd: the working directory's path, NUL-terminated; its length with
// the NUL, or -errno.
pub fn workingDirectory(destination: usize, length: usize) -> isize {
    return linux.syscall2(linux.SYS_getcwd, destination, length)
}

pub fn changeDirectory(path: [*]const u8) -> isize {
    return linux.syscall1(linux.SYS_chdir, @intFromPtr(path))
}

// A copy of `from` as `to` (dup2: what `to` was closed first): `to`, or
// -errno.
pub fn duplicateTo(from: isize, to: isize) -> isize { return linux.dup2(from, to) }

pub fn close(descriptor: isize) -> isize {
    return linux.syscall1(linux.SYS_close, @bitCast(usize, descriptor))
}

// statfs(2): the figures of the file system a path is on, into the 15
// words at `result` (std.fs's FileSystemStat); 0 or -errno.
pub fn fileSystemStatus(path: [*]const u8, result: usize) -> isize {
    return linux.syscall2(linux.SYS_statfs, @intFromPtr(path), result)
}

// The clock `which` read: its seconds and nanoseconds; false when it
// cannot be read.
pub fn clock(which: usize, seconds: *isize, nanoseconds: *isize) -> bool {
    var pair: [2]isize = [2]isize{ 0, 0 }
    var result: isize = 0
    unsafe { result = linux.syscall2(linux.SYS_clock_gettime, which, @intFromPtr(&pair)) }
    if result != 0 { return false }
    seconds.* = pair[0]
    nanoseconds.* = pair[1]
    return true
}

// ---------------------------------------------------------------------------
// Files beyond reading and writing: std.fs's calls, as Linux has them
// (a directory descriptor, AT_FDCWD for the working one; -errno).

pub const AT_FDCWD: isize = -100

pub fn access(path: [*]const u8, mode: usize) -> isize { return linux.syscall2(linux.SYS_access, @intFromPtr(path), mode) }

// newfstatat: struct stat at `result`.
pub fn statAt(directory: isize, path: [*]const u8, result: usize, flags: usize) -> isize {
    return linux.syscall4(linux.SYS_newfstatat, @bitCast(usize, directory), @intFromPtr(path), result, flags)
}

pub fn fileStatus(descriptor: isize, result: usize) -> isize { return linux.syscall2(linux.SYS_fstat, @bitCast(usize, descriptor), result) }

pub fn statx(directory: isize, path: [*]const u8, flags: usize, mask: usize, result: usize) -> isize {
    return linux.syscall5(linux.SYS_statx, @bitCast(usize, directory), @intFromPtr(path), flags, mask, result)
}

pub fn readAt(descriptor: isize, destination: usize, length: usize, offset: usize) -> isize { return linux.syscall4(linux.SYS_pread64, @bitCast(usize, descriptor), destination, length, offset) }

pub fn writeAt(descriptor: isize, source: usize, length: usize, offset: usize) -> isize { return linux.syscall4(linux.SYS_pwrite64, @bitCast(usize, descriptor), source, length, offset) }

pub fn seek(descriptor: isize, offset: isize, whence: usize) -> isize { return linux.syscall3(linux.SYS_lseek, @bitCast(usize, descriptor), @bitCast(usize, offset), whence) }

// unlinkat (flags 512: a directory).
pub fn removeAt(directory: isize, path: [*]const u8, flags: usize) -> isize { return linux.syscall3(linux.SYS_unlinkat, @bitCast(usize, directory), @intFromPtr(path), flags) }

pub fn linkAt(fromDirectory: isize, from: [*]const u8, toDirectory: isize, to: [*]const u8, flags: usize) -> isize {
    return linux.syscall5(linux.SYS_linkat, @bitCast(usize, fromDirectory), @intFromPtr(from), @bitCast(usize, toDirectory), @intFromPtr(to), flags)
}

pub fn symbolicLink(target: [*]const u8, path: [*]const u8) -> isize { return linux.syscall2(linux.SYS_symlink, @intFromPtr(target), @intFromPtr(path)) }

pub fn readLink(path: [*]const u8, destination: usize, length: usize) -> isize { return linux.syscall3(linux.SYS_readlink, @intFromPtr(path), destination, length) }

pub fn extendedAttribute(path: [*]const u8, name: [*]const u8, destination: usize, length: usize, no_follow: bool) -> isize {
    return linux.syscall4(if no_follow { linux.SYS_lgetxattr } else { linux.SYS_getxattr }, @intFromPtr(path), @intFromPtr(name), destination, length)
}

// renameat2 (flags 1: never over what is there).
pub fn renameAt(fromDirectory: isize, from: [*]const u8, toDirectory: isize, to: [*]const u8, flags: usize) -> isize {
    return linux.syscall5(linux.SYS_renameat2, @bitCast(usize, fromDirectory), @intFromPtr(from), @bitCast(usize, toDirectory), @intFromPtr(to), flags)
}

pub fn makeDirectory(path: [*]const u8, mode: usize) -> isize { return linux.syscall2(linux.SYS_mkdir, @intFromPtr(path), mode) }

pub fn makeNode(path: [*]const u8, mode: usize, device: usize) -> isize { return linux.syscall3(linux.SYS_mknod, @intFromPtr(path), mode, device) }

pub fn removeDirectory(path: [*]const u8) -> isize { return linux.syscall1(linux.SYS_rmdir, @intFromPtr(path)) }

pub fn changeModeAt(directory: isize, path: [*]const u8, mode: usize) -> isize { return linux.syscall4(linux.SYS_fchmodat, @bitCast(usize, directory), @intFromPtr(path), mode, 0) }

pub fn changeOwnerAt(directory: isize, path: [*]const u8, user: usize, group: usize, flags: usize) -> isize {
    return linux.syscall5(linux.SYS_fchownat, @bitCast(usize, directory), @intFromPtr(path), user, group, flags)
}

// umask: the mask before.
pub fn setUmask(mask: usize) -> usize { return @bitCast(usize, linux.syscall1(linux.SYS_umask, mask)) }

// utimensat (`path` 0: the descriptor's file; `times` 0: now).
pub fn setTimesAt(directory: isize, path: usize, times: usize, flags: usize) -> isize { return linux.syscall4(linux.SYS_utimensat, @bitCast(usize, directory), path, times, flags) }

pub fn truncate(descriptor: isize, length: usize) -> isize { return linux.syscall2(linux.SYS_ftruncate, @bitCast(usize, descriptor), length) }

pub fn syncAll() -> isize { return linux.syscall0(linux.SYS_sync) }

pub fn syncFile(descriptor: isize, data_only: bool) -> isize { return linux.syscall1(if data_only { linux.SYS_fdatasync } else { linux.SYS_fsync }, @bitCast(usize, descriptor)) }

pub fn syncFileSystem(descriptor: isize) -> isize { return linux.syscall1(linux.SYS_syncfs, @bitCast(usize, descriptor)) }

pub fn setPipeSize(descriptor: isize, length: usize) -> isize { return linux.syscall3(linux.SYS_fcntl, @bitCast(usize, descriptor), 1031, length) }

pub fn splice(source: isize, destination: isize, length: usize) -> isize {
    return linux.syscall6(linux.SYS_splice, @bitCast(usize, source), 0, @bitCast(usize, destination), 0, length, 0)
}

pub fn copyRange(source: isize, destination: isize, length: usize) -> isize {
    return linux.syscall6(linux.SYS_copy_file_range, @bitCast(usize, source), 0, @bitCast(usize, destination), 0, length, 0)
}

// Waits `duration` nanoseconds (nanosleep, again after an interruption);
// false when the kernel refused.
pub fn sleep(duration: usize) -> bool {
    var request: [2]usize = [2]usize{ duration / 1000000000, duration % 1000000000 }
    var remaining: [2]usize = [2]usize{ 0, 0 }
    while true {
        const result = linux.syscall2(linux.SYS_nanosleep, @intFromPtr(&request), @intFromPtr(&remaining))
        if result == 0 { return true }
        if result != -4 { return false }
        request[0] = remaining[0]
        request[1] = remaining[1]
    }
    return false
}

// ---------------------------------------------------------------------------
// The process itself: Linux tells it through /proc/self and getpid.

pub fn processId() -> usize { return @bitCast(usize, linux.syscall0(linux.SYS_getpid)) }

pub fn userId() -> usize { return @bitCast(usize, linux.syscall0(linux.SYS_getuid)) }

// A /proc/self file's first `capacity` bytes into `into`; how many.
fn readProc(path: [*]const u8, into: [*]u8, capacity: usize) -> usize {
    const file = open(path, 0, 0)
    if file < 0 { return 0 }
    var length: usize = 0
    while length < capacity {
        const got = read(file, @intFromPtr(into) + length, capacity - length)
        if got <= 0 { break }
        length += @bitCast(usize, got)
    }
    _ = close(file)
    return length
}

// The process's name (/proc/self/comm, without its line end).
pub fn processName(into: [*]u8, capacity: usize) -> usize {
    var length = readProc("/proc/self/comm".pointer, into, capacity)
    if length > 0 && into[length - 1] == 10 { length -= 1 }
    return length
}

// The program's file (what /proc/self/exe links to), not NUL-terminated.
pub fn executablePath(into: [*]u8, capacity: usize) -> usize {
    const length = linux.syscall3(linux.SYS_readlink, @intFromPtr("/proc/self/exe".pointer), @intFromPtr(into), capacity)
    return if length > 0 { @bitCast(usize, length) } else { 0 }
}

// The environment the program started with, NAME=VALUE entries each
// ended by a NUL (/proc/self/environ); its length.
pub fn environmentText(into: [*]u8, capacity: usize) -> usize { return readProc("/proc/self/environ".pointer, into, capacity) }

// Whether the page holding `address` is mapped (mincore).
pub fn pageMapped(address: usize) -> bool {
    var residency: [1]u8 = [1]u8{ 0 }
    return linux.syscall3(linux.SYS_mincore, address & 18446744073709547520, 4096, @intFromPtr(&residency)) == 0
}

// `length` bytes of a file mapped to read (private): the address, 0 when
// it cannot be.
pub fn mapFile(descriptor: isize, length: usize) -> usize {
    const result = linux.syscall6(linux.SYS_mmap, 0, length, 1, 2, @bitCast(usize, descriptor), 0)
    return if result < 0 { 0 } else { @bitCast(usize, result) }
}

pub fn unmapFile(address: usize, length: usize) -> void { _ = linux.syscall2(linux.SYS_munmap, address, length) }

// Whether there is something to read from `descriptor` (or it is at its
// end), waiting up to `wait_ns` nanoseconds (poll).
pub fn readable(descriptor: isize, wait_ns: usize) -> bool {
    var item: [2]i32 = [2]i32{ @intCast(i32, descriptor), 1 }
    return linux.syscall3(linux.SYS_poll, @intFromPtr(&item), 1, wait_ns / 1000000) > 0
}
