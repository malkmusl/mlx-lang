// The calls std's files and clocks make to the operating system the
// program runs on: Linux's here. host.brixos.mlx has brixOS's own; the
// compiler takes it for --target=x86_64-brixos (a module X.mlx is
// X.<platform>.mlx when there is one). This file is plain enough for
// every compiler that builds the compiler.
const linux = @import("./linux.mlx")

// clock's clocks.
pub const REALTIME: usize = 0
pub const MONOTONIC: usize = 1

// open(2): a descriptor, or -errno.
pub fn open(path: [*]const u8, flags: usize, mode: usize) -> isize {
    return linux.syscall3(linux.SYS_open, @intFromPtr(path), flags, mode)
}

// openat(2), from the directory `directory` (AT_FDCWD: the working one).
pub fn openAt(directory: isize, path: [*]const u8, flags: usize, mode: usize) -> isize {
    return linux.syscall4(linux.SYS_openat, @bitCast(usize, directory), @intFromPtr(path), flags, mode)
}

pub fn read(descriptor: isize, destination: usize, length: usize) -> isize {
    return linux.syscall3(linux.SYS_read, @bitCast(usize, descriptor), destination, length)
}

pub fn write(descriptor: isize, source: usize, length: usize) -> isize {
    return linux.syscall3(linux.SYS_write, @bitCast(usize, descriptor), source, length)
}

// getdents64: the directory's entries from where the last read ended.
pub fn readDirectory(descriptor: isize, destination: usize, length: usize) -> isize {
    return linux.syscall3(linux.SYS_getdents64, @bitCast(usize, descriptor), destination, length)
}

pub fn close(descriptor: isize) -> isize {
    return linux.syscall1(linux.SYS_close, @bitCast(usize, descriptor))
}

// The clock `which` read: its seconds and nanoseconds; false when it
// cannot be read.
pub fn clock(which: usize, seconds: *isize, nanoseconds: *isize) -> bool {
    var pair: [2]isize = [2]isize{ 0, 0 }
    var result: isize = 0
    unsafe { result = linux.syscall2(linux.SYS_clock_gettime, which, @intFromPtr(&pair)) }
    if result != 0 { return false }
    seconds.* = pair[0]
    nanoseconds.* = pair[1]
    return true
}
