// Pages of memory on brixOS (pages.mlx is Linux's): memory_map and
// memory_unmap. Pages come when first touched, so a reservation and a
// commit need nothing more; a release maps the pages afresh.
const brix = @import("./brix.mlx")

const FIXED: usize = 1
const KEEP: usize = 2

pub fn map(length: usize, reserved: bool) -> usize {
    const result = brix.call3(brix.MEMORY_MAP, 0, length, 0)
    if result < 0 { return 0 }
    return @bitCast(usize, result)
}

pub fn unmap(address: usize, length: usize) -> void { _ = brix.call2(brix.MEMORY_UNMAP, address, length) }

// At `address` exactly, never over what is there (-17 when something is).
pub fn mapAt(address: usize, length: usize, usable: bool) -> isize {
    const result = brix.call3(brix.MEMORY_MAP, address, length, FIXED | KEEP)
    if result == -brix.Status.exists { return -17 }
    if result < 0 { return -12 }
    return result
}

pub fn commit(address: usize, length: usize) -> bool { return true }

pub fn release(address: usize, length: usize) -> void {
    _ = brix.call2(brix.MEMORY_UNMAP, address, length)
    _ = brix.call3(brix.MEMORY_MAP, address, length, FIXED)
}

// To the errors: the start block's errors role (std.io's own needs the
// allocator).
pub fn say(text: []const u8) -> void { _ = brix.call4(brix.WRITE, @intCast(usize, brix.handleFor(brix.Role.ERRORS)), @intFromPtr(text.pointer), text.length, brix.STREAM) }

// A lock's word. A brixOS process runs one thread: a lock it finds taken
// is its own, taken again from an upcall; there is nobody to wait for, so
// these give nothing up and the caller's loop looks again.
pub fn sleepOn(word: *u32, expected: u32) -> void {}
pub fn wakeOne(word: *u32) -> void {}
pub fn yield() -> void {}
