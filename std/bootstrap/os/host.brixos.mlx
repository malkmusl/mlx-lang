// The calls std's files and clocks make on brixOS (host.mlx is Linux's):
// brixOS's own. std keeps descriptor numbers, as the Linux layer gives
// them out, and reads and writes them by their handles, which it
// remembers; a remembered handle that a close or a dup2 made stale is
// invalid (its generation), so it is asked for again and the call made
// once more. The native statuses reach std's callers as the errno values
// they check.
const linux = @import("./linux.mlx")
const brix = @import("./brix.mlx")

pub const REALTIME: usize = 0
pub const MONOTONIC: usize = 1

const DESCRIPTORS: usize = 64

var remembered: [DESCRIPTORS]u32 = undefined // (per run)
var primed: bool = false // (per run)

fn prime() -> void {
    if primed { return }
    var k: usize = 0
    while k < DESCRIPTORS {
        remembered[k] = 0
        k += 1
    }
    primed = true
}

// The handle of a descriptor (0 when it is not open), asked for again
// when `fresh`.
fn handleFor(descriptor: isize, fresh: bool) -> u32 {
    if descriptor < 0 || descriptor >= @intCast(isize, DESCRIPTORS) { return brix.ofDescriptor(descriptor) }
    prime()
    const k = @bitCast(usize, descriptor)
    if fresh || remembered[k] == 0 { remembered[k] = brix.ofDescriptor(descriptor) }
    return remembered[k]
}

fn forget(descriptor: isize) -> void {
    if descriptor < 0 || descriptor >= @intCast(isize, DESCRIPTORS) { return }
    prime()
    remembered[@bitCast(usize, descriptor)] = 0
}

// A streaming read or write of a descriptor through its handle.
fn transfer(descriptor: isize, address: usize, length: usize, writing: bool) -> isize {
    const number = if writing { brix.WRITE } else { brix.READ }
    var result = brix.call4(number, @intCast(usize, handleFor(descriptor, false)), address, length, brix.STREAM)
    if result == -brix.Status.invalid_handle { result = brix.call4(number, @intCast(usize, handleFor(descriptor, true)), address, length, brix.STREAM) }
    return asErrno(result)
}

// Linux's open flags std passes, and how they read in node_open's.
const O_ACCESS: usize = 3
const O_CREAT: usize = 64
const O_EXCL: usize = 128
const O_TRUNC: usize = 512
const AT_FDCWD: isize = -100

// open: by node_open (brixOS's paths: /temporary, /devices, ...), its
// handle remembered for its descriptor; flags node_open has no word for
// (append, no-follow, directory only, ...) go to the Linux layer's open.
pub fn open(path: [*]const u8, flags: usize, mode: usize) -> isize { return openAt(AT_FDCWD, path, flags, mode) }

pub fn openAt(directory: isize, path: [*]const u8, flags: usize, mode: usize) -> isize {
    if flags & ~(O_ACCESS | O_CREAT | O_EXCL | O_TRUNC) != 0 || flags & O_ACCESS == O_ACCESS {
        return linux.syscall4(linux.SYS_openat, @bitCast(usize, directory), @intFromPtr(path), flags, mode)
    }
    var native: usize = 0
    const access = flags & O_ACCESS
    if access == 0 || access == 2 { native |= brix.Open.READ }
    if access == 1 || access == 2 { native |= brix.Open.WRITE }
    if flags & O_CREAT != 0 { native |= brix.Open.CREATE }
    if flags & O_EXCL != 0 { native |= brix.Open.EXCLUSIVE }
    if flags & O_TRUNC != 0 { native |= brix.Open.TRUNCATE }
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    var base: u32 = 0
    if directory != AT_FDCWD { base = handleFor(directory, false) }
    const opened = brix.call5(brix.NODE_OPEN, @intCast(usize, base), @intFromPtr(path), length, native, mode)
    if opened < 0 { return asErrno(opened) }
    // The handle's slot is the Linux layer's descriptor.
    const handle = @intCast(u32, opened)
    const descriptor = @intCast(isize, (handle & 0xFF) - 1)
    if descriptor < @intCast(isize, DESCRIPTORS) {
        prime()
        remembered[@bitCast(usize, descriptor)] = handle
    }
    return descriptor
}

pub fn read(descriptor: isize, destination: usize, length: usize) -> isize { return transfer(descriptor, destination, length, false) }

pub fn write(descriptor: isize, source: usize, length: usize) -> isize { return transfer(descriptor, source, length, true) }

pub fn close(descriptor: isize) -> isize {
    forget(descriptor)
    return linux.syscall1(linux.SYS_close, @bitCast(usize, descriptor))
}

pub fn clock(which: usize, seconds: *isize, nanoseconds: *isize) -> bool {
    const now = brix.clock(if which == REALTIME { brix.Clock.REAL_TIME } else { brix.Clock.MONOTONIC })
    seconds.* = @bitCast(isize, now / 1000000000)
    nanoseconds.* = @bitCast(isize, now % 1000000000)
    return true
}

// A Status as Linux's errno (for std's callers that check them).
pub fn asErrno(result: isize) -> isize {
    if result >= 0 { return result }
    const code = -result
    if code == brix.Status.invalid_handle || code == brix.Status.no_right { return -9 }
    if code == brix.Status.wrong_kind { return -29 }
    if code == brix.Status.would_block { return -11 }
    if code == brix.Status.timed_out { return -110 }
    if code == brix.Status.not_found { return -2 }
    if code == brix.Status.exists { return -17 }
    if code == brix.Status.no_memory { return -12 }
    if code == brix.Status.bad_address { return -14 }
    if code == brix.Status.peer_gone { return -32 }
    if code == brix.Status.interrupted { return -4 }
    if code == brix.Status.unsupported { return -38 }
    // not_directory, is_directory, not_empty, read_only, too_large,
    // busy, denied, too_many, link_loop, no_space, io_error,
    // cross_volume, name_too_long.
    if code == 13 { return -20 }
    if code == 14 { return -21 }
    if code == 15 { return -39 }
    if code == 16 { return -30 }
    if code == 17 { return -27 }
    if code == 19 { return -16 }
    if code == 20 { return -13 }
    if code == 21 { return -24 }
    if code == 22 { return -40 }
    if code == 23 { return -28 }
    if code == 24 { return -5 }
    if code == 25 { return -18 }
    if code == 26 { return -36 }
    return -22
}
