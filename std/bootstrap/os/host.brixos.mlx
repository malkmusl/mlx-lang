// The calls std's files and clocks make on brixOS (host.mlx is Linux's):
// brixOS's own. std keeps descriptor numbers, as the Linux layer gives
// them out, and reads and writes them by their handles, which it
// remembers; a remembered handle that a close or a dup2 made stale is
// invalid (its generation), so it is asked for again and the call made
// once more. The native statuses reach std's callers as the errno values
// they check.
const brix = @import("./brix.mlx")

pub const REALTIME: usize = 0
pub const MONOTONIC: usize = 1

const DESCRIPTORS: usize = 64

var remembered: [DESCRIPTORS]u32 = undefined // (per run)
// Where each descriptor's directory reading is: 0 before ".", 1 before
// "..", then 2 + node_list's cookie.
var cookies: [DESCRIPTORS]usize = undefined // (per run)
var primed: bool = false // (per run)

fn prime() -> void {
    if primed { return }
    var k: usize = 0
    while k < DESCRIPTORS {
        remembered[k] = 0
        cookies[k] = 0
        k += 1
    }
    primed = true
}

// The handle of a descriptor (0 when it is not open), asked for again
// when `fresh`.
fn handleFor(descriptor: isize, fresh: bool) -> u32 {
    if descriptor < 0 || descriptor >= @intCast(isize, DESCRIPTORS) { return brix.ofDescriptor(descriptor) }
    prime()
    const k = @bitCast(usize, descriptor)
    if fresh || remembered[k] == 0 { remembered[k] = brix.ofDescriptor(descriptor) }
    return remembered[k]
}

fn forget(descriptor: isize) -> void {
    if descriptor < 0 || descriptor >= @intCast(isize, DESCRIPTORS) { return }
    prime()
    remembered[@bitCast(usize, descriptor)] = 0
    cookies[@bitCast(usize, descriptor)] = 0
}

// A streaming read or write of a descriptor through its handle.
fn transfer(descriptor: isize, address: usize, length: usize, writing: bool) -> isize {
    const number = if writing { brix.WRITE } else { brix.READ }
    var result = brix.call4(number, @intCast(usize, handleFor(descriptor, false)), address, length, brix.STREAM)
    if result == -brix.Status.invalid_handle { result = brix.call4(number, @intCast(usize, handleFor(descriptor, true)), address, length, brix.STREAM) }
    // One the upcall came in (std.events) is made again.
    while result == -brix.Status.interrupted { result = brix.call4(number, @intCast(usize, handleFor(descriptor, false)), address, length, brix.STREAM) }
    return asErrno(result)
}

// Linux's open flags std passes, and how they read in node_open's.
const O_ACCESS: usize = 3
const O_CREAT: usize = 64
const O_EXCL: usize = 128
const O_TRUNC: usize = 512
pub const AT_FDCWD: isize = -100

const O_APPEND: usize = 1024
const O_NONBLOCK: usize = 2048
const O_DIRECTORY: usize = 65536
const O_NOFOLLOW: usize = 131072
const O_CLOEXEC: usize = 524288

// open: by node_open (brixOS's paths: /temporary, /devices, ...), its
// handle remembered for its descriptor. Linux's other flags as they mean
// here: close-on-exec is every handle's (a child gets the handles
// process_launch is given, no others); a directory only, no link at the
// end, appending (from the end: the file's place set there) are checked
// or done here; non-blocking is the caller's own wait (brix.wait).
pub fn open(path: [*]const u8, flags: usize, mode: usize) -> isize { return openAt(AT_FDCWD, path, flags, mode) }

pub fn openAt(directory: isize, path: [*]const u8, flags: usize, mode: usize) -> isize {
    if flags & O_ACCESS == O_ACCESS { return -22 }
    var native: usize = 0
    const access = flags & O_ACCESS
    if access == 0 || access == 2 { native |= brix.Open.READ }
    if access == 1 || access == 2 { native |= brix.Open.WRITE }
    if flags & O_CREAT != 0 { native |= brix.Open.CREATE }
    if flags & O_EXCL != 0 { native |= brix.Open.EXCLUSIVE }
    if flags & O_TRUNC != 0 { native |= brix.Open.TRUNCATE }
    if flags & O_APPEND != 0 { native |= brix.Open.APPEND }
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    var base: u32 = 0
    if directory != AT_FDCWD { base = handleFor(directory, false) }
    if flags & (O_DIRECTORY | O_NOFOLLOW) != 0 {
        var info: brix.NodeInfo = undefined
        const got = brix.nodeInfoAt(base, path[0..length], &info, if flags & O_NOFOLLOW != 0 { brix.LINK_ITSELF } else { 0 })
        if got >= 0 {
            if flags & O_NOFOLLOW != 0 && info.kind == brix.NodeKind.LINK { return -40 }
            if flags & O_DIRECTORY != 0 && info.kind != brix.NodeKind.DIRECTORY { return -20 }
        } else if flags & O_CREAT == 0 {
            return asErrno(got)
        }
    }
    const opened = brix.call5(brix.NODE_OPEN, @intCast(usize, base), @intFromPtr(path), length, native, mode)
    if opened < 0 { return asErrno(opened) }
    // The handle's slot is the Linux layer's descriptor.
    return remember(@intCast(u32, opened))
}

pub fn read(descriptor: isize, destination: usize, length: usize) -> isize { return transfer(descriptor, destination, length, false) }

pub fn write(descriptor: isize, source: usize, length: usize) -> isize { return transfer(descriptor, source, length, true) }

// getdents64's records, made from node_list's (".", ".." first, as the
// Linux layer gives them; no inode numbers: 0).
pub fn readDirectory(descriptor: isize, destination: usize, capacity: usize) -> isize {
    if descriptor < 0 || descriptor >= @intCast(isize, DESCRIPTORS) { return -24 }
    prime()
    const k = @bitCast(usize, descriptor)
    const into = unsafe { @ptrFromInt([*]u8, destination) }
    var at: usize = 0
    while cookies[k] < 2 {
        const name = if cookies[k] == 0 { "." } else { ".." }
        if !record(into, capacity, &at, name, 4, cookies[k] + 1) { return if at > 0 { @intCast(isize, at) } else { -22 } }
        cookies[k] += 1
    }
    var listed: [4096]u8 = undefined
    const room = if capacity < 4096 { capacity } else { 4096 }
    var got = brix.call4(brix.NODE_LIST, @intCast(usize, handleFor(descriptor, false)), @intFromPtr(&listed), room, cookies[k] - 2)
    if got == -brix.Status.invalid_handle { got = brix.call4(brix.NODE_LIST, @intCast(usize, handleFor(descriptor, true)), @intFromPtr(&listed), room, cookies[k] - 2) }
    if got < 0 { return if at > 0 { @intCast(isize, at) } else { asErrno(got) } }
    var offset: usize = 0
    while offset < @bitCast(usize, got) {
        const next = read64(&listed, offset)
        const kind = @intCast(usize, listed[offset + 8])
        const length = @intCast(usize, listed[offset + 12]) | (@intCast(usize, listed[offset + 13]) << 8)
        if !record(into, capacity, &at, listed[offset + 16..offset + 16 + length], typeOf(kind), next + 2) {
            if at == 0 { return -22 }
            break
        }
        cookies[k] = next + 2
        offset += (16 + length + 7) & ~@intCast(usize, 7)
    }
    return @intCast(isize, at)
}

fn read64(bytes: [*]const u8, at: usize) -> usize {
    var value: usize = 0
    var k: usize = 8
    while k > 0 {
        k -= 1
        value = (value << 8) | @intCast(usize, bytes[at + k])
    }
    return value
}

// A getdents64 record (no inode, `next` as its offset) at `at`; false
// when it does not fit.
fn record(into: [*]u8, capacity: usize, at: *usize, name: []const u8, kind: u8, next: usize) -> bool {
    const size = (19 + name.length + 1 + 7) & ~@intCast(usize, 7)
    if at.* + size > capacity { return false }
    const base = at.*
    var k: usize = 0
    while k < size {
        into[base + k] = 0
        k += 1
    }
    k = 0
    while k < 8 {
        into[base + 8 + k] = @intCast(u8, (next >> @intCast(u6, k * 8)) & 0xFF)
        k += 1
    }
    into[base + 16] = @intCast(u8, size & 0xFF)
    into[base + 17] = @intCast(u8, size >> 8)
    into[base + 18] = kind
    k = 0
    while k < name.length {
        into[base + 19 + k] = name[k]
        k += 1
    }
    at.* = base + size
    return true
}

// node_list's kinds as getdents64's.
fn typeOf(kind: usize) -> u8 {
    if kind == 1 { return 8 }
    if kind == 2 { return 4 }
    if kind == 3 { return 10 }
    if kind == 4 { return 1 }
    if kind == 5 { return 2 }
    if kind == 6 { return 12 }
    if kind == 7 { return 6 }
    return 0
}

// stream_pair: the ends' handles, whose slots are the descriptors.
pub fn pipe(ends: *[2]isize) -> bool {
    var handles: [2]u32 = [2]u32{ 0, 0 }
    if brix.streamPair(&handles) < 0 { return false }
    ends.*[0] = remember(handles[0])
    ends.*[1] = remember(handles[1])
    return true
}

// A handle's descriptor (its slot), remembered.
fn remember(handle: u32) -> isize {
    const descriptor = @intCast(isize, (handle & 0xFF) - 1)
    if descriptor < @intCast(isize, DESCRIPTORS) {
        prime()
        remembered[@bitCast(usize, descriptor)] = handle
        cookies[@bitCast(usize, descriptor)] = 0
    }
    return descriptor
}

// node_path of the working directory: its length with the NUL.
pub fn workingDirectory(destination: usize, length: usize) -> isize {
    const got = brix.pathOf(0, unsafe { @ptrFromInt([*]u8, destination) }[0..length])
    if got < 0 { return if -got == 17 { -34 } else { asErrno(got) } }
    return got + 1
}

// The directory opened by node_open, made the working one.
pub fn changeDirectory(path: [*]const u8) -> isize {
    const opened = open(path, O_ACCESS & 0, 0)
    if opened < 0 { return opened }
    const result = brix.setDirectory(handleFor(opened, false))
    _ = close(opened)
    return asErrno(result)
}

// handle_close (a descriptor's slot is its handle's).
// A copy of `from` as `to` (handle_duplicate_at: what `to` was closed
// first): `to`, or -errno.
pub fn duplicateTo(from: isize, to: isize) -> isize {
    if to < 0 { return -9 }
    if from == to { return if brix.info(handleFor(from, false), &infoScratch) < 0 { -9 } else { to } }
    const copied = brix.duplicateAt(handleFor(from, false), @bitCast(usize, to))
    if copied < 0 { return asErrno(copied) }
    forget(to)
    return remember(@intCast(u32, copied))
}

var infoScratch = brix.Info.{ .kind = 0, .rights = 0, .state = 0, .reserved = 0 } // (per run)

pub fn close(descriptor: isize) -> isize {
    const handle = handleFor(descriptor, false)
    forget(descriptor)
    if handle == 0 { return -9 }
    return asErrno(brix.close(handle))
}

// The volume a path is on, by volume_info, as statfs's record (the 15
// words of std.fs's FileSystemStat: the kind as Linux's magic numbers,
// the block size, blocks, free and available ones, inodes, free ones,
// the longest name).
pub fn fileSystemStatus(path: [*]const u8, result: usize) -> isize {
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    var info: brix.VolumeInfo = undefined
    const got = brix.volumeInfo(0, path[0..length], &info, 0)
    if got < 0 { return asErrno(got) }
    const into = unsafe { @ptrFromInt([*]usize, result) }
    var k: usize = 0
    while k < 15 {
        into[k] = 0
        k += 1
    }
    into[0] = if info.kind == brix.VolumeInfo.BRIXFS { 0x58495242 } else { 0x01021994 }
    into[1] = info.blockSize
    into[2] = info.blocks
    into[3] = info.free
    into[4] = info.free
    into[5] = info.inodes
    into[6] = info.inodesNeverUsed
    into[8] = 59
    into[9] = info.blockSize
    return 0
}

pub fn clock(which: usize, seconds: *isize, nanoseconds: *isize) -> bool {
    const now = brix.clock(if which == REALTIME { brix.Clock.REAL_TIME } else { brix.Clock.MONOTONIC })
    seconds.* = @bitCast(isize, now / 1000000000)
    nanoseconds.* = @bitCast(isize, now % 1000000000)
    return true
}

// A Status as Linux's errno (for std's callers that check them).
pub fn asErrno(result: isize) -> isize {
    if result >= 0 { return result }
    const code = -result
    if code == brix.Status.invalid_handle || code == brix.Status.no_right { return -9 }
    if code == brix.Status.wrong_kind { return -29 }
    if code == brix.Status.would_block { return -11 }
    if code == brix.Status.timed_out { return -110 }
    if code == brix.Status.not_found { return -2 }
    if code == brix.Status.exists { return -17 }
    if code == brix.Status.no_memory { return -12 }
    if code == brix.Status.bad_address { return -14 }
    if code == brix.Status.peer_gone { return -32 }
    if code == brix.Status.interrupted { return -4 }
    if code == brix.Status.unsupported { return -38 }
    // (What a socket was to send cannot leave this machine: Linux's
    // ENETUNREACH, as the Linux layer's own calls say it.)
    if code == brix.Status.unreachable { return -101 }
    // not_directory, is_directory, not_empty, read_only, too_large,
    // busy, denied, too_many, link_loop, no_space, io_error,
    // cross_volume, name_too_long.
    if code == 13 { return -20 }
    if code == 14 { return -21 }
    if code == 15 { return -39 }
    if code == 16 { return -30 }
    if code == 17 { return -27 }
    if code == 19 { return -16 }
    if code == 20 { return -13 }
    if code == 21 { return -24 }
    if code == 22 { return -40 }
    if code == 23 { return -28 }
    if code == 24 { return -5 }
    if code == 25 { return -18 }
    if code == 26 { return -36 }
    return -22
}

// ---------------------------------------------------------------------------
// Files beyond reading and writing (host.mlx's calls, Linux's shapes),
// by node_info_at, node_make, node_remove, node_rename, node_set,
// node_target, node_own and handle_seek.

const AT_SYMLINK_NOFOLLOW: usize = 256
const AT_REMOVEDIR: usize = 512
const RENAME_NOREPLACE: usize = 1
const UTIME_NOW: usize = 1073741823
const UTIME_OMIT: usize = 1073741822
// struct stat's kinds of file.
const S_IFIFO: u32 = 4096
const S_IFCHR: u32 = 8192
const S_IFBLK: u32 = 24576
const S_IFDIR: u32 = 16384
const S_IFREG: u32 = 32768
const S_IFLNK: u32 = 40960
const S_IFSOCK: u32 = 49152

fn lengthOf(path: [*]const u8) -> usize {
    var length: usize = 0
    while path[length] != 0 { length += 1 }
    return length
}

// The directory a path is taken from: the working one, or a descriptor's.
fn baseOf(directory: isize) -> u32 { return if directory == AT_FDCWD { 0 } else { handleFor(directory, false) } }

fn kindBits(kind: u32) -> u32 {
    if kind == brix.NodeKind.DIRECTORY { return S_IFDIR }
    if kind == brix.NodeKind.LINK { return S_IFLNK }
    if kind == brix.NodeKind.FIFO { return S_IFIFO }
    if kind == brix.NodeKind.DEVICE { return S_IFCHR }
    if kind == brix.NodeKind.LISTENER { return S_IFSOCK }
    if kind == brix.NodeKind.STORAGE { return S_IFBLK }
    return S_IFREG
}

fn put32(into: [*]u8, at: usize, value: usize) -> void {
    var k: usize = 0
    while k < 4 {
        into[at + k] = @intCast(u8, (value >> @intCast(u6, k * 8)) & 0xFF)
        k += 1
    }
}

fn put64(into: [*]u8, at: usize, value: usize) -> void {
    var k: usize = 0
    while k < 8 {
        into[at + k] = @intCast(u8, (value >> @intCast(u6, k * 8)) & 0xFF)
        k += 1
    }
}

fn zero(into: [*]u8, size: usize) -> void {
    var k: usize = 0
    while k < size {
        into[k] = 0
        k += 1
    }
}

// node_info's record as struct stat (144 bytes).
fn toStat(info: *const brix.NodeInfo, result: usize) -> void {
    const into = unsafe { @ptrFromInt([*]u8, result) }
    zero(into, 144)
    put64(into, 8, @intCast(usize, info.*.number))
    put64(into, 16, @intCast(usize, info.*.links))
    put64(into, 40, @intCast(usize, info.*.device))
    put32(into, 24, @intCast(usize, kindBits(info.*.kind) | (info.*.mode & 0xFFF)))
    put32(into, 28, @intCast(usize, info.*.owners & 0xFFFF))
    put32(into, 32, @intCast(usize, info.*.owners >> 16))
    put64(into, 48, @intCast(usize, info.*.size))
    put64(into, 56, 4096)
    put64(into, 64, (@intCast(usize, info.*.size) + 511) / 512)
    const modified = @intCast(usize, info.*.modified)
    var at: usize = 72
    while at <= 104 {
        put64(into, at, modified / 1000000000)
        put64(into, at + 8, modified % 1000000000)
        at += 16
    }
}

pub fn statAt(directory: isize, path: [*]const u8, result: usize, flags: usize) -> isize {
    var info: brix.NodeInfo = undefined
    const got = brix.nodeInfoAt(baseOf(directory), path[0..lengthOf(path)], &info, if flags & AT_SYMLINK_NOFOLLOW != 0 { brix.LINK_ITSELF } else { 0 })
    if got < 0 { return asErrno(got) }
    toStat(&info, result)
    return 0
}

// A descriptor's: a node's record; a stream, a channel or a session as
// a fifo, a socket or a terminal.
pub fn fileStatus(descriptor: isize, result: usize) -> isize {
    var info: brix.NodeInfo = undefined
    var got = brix.nodeInfo(handleFor(descriptor, false), &info)
    if got == -brix.Status.invalid_handle { got = brix.nodeInfo(handleFor(descriptor, true), &info) }
    if got == -brix.Status.wrong_kind {
        var kind = brix.Info.{ .kind = 0, .rights = 0, .state = 0, .reserved = 0 }
        if brix.info(handleFor(descriptor, false), &kind) < 0 { return -9 }
        const into = unsafe { @ptrFromInt([*]u8, result) }
        zero(into, 144)
        put32(into, 24, @intCast(usize, (if kind.kind == brix.Kind.SESSION { S_IFCHR } else if kind.kind == brix.Kind.CHANNEL { S_IFSOCK } else { S_IFIFO }) | 0x1B6))
        return 0
    }
    if got < 0 { return asErrno(got) }
    toStat(&info, result)
    return 0
}

// statx's record (the basic fields; no birth time: its mask says so).
pub fn statx(directory: isize, path: [*]const u8, flags: usize, mask: usize, result: usize) -> isize {
    var info: brix.NodeInfo = undefined
    const got = brix.nodeInfoAt(baseOf(directory), path[0..lengthOf(path)], &info, if flags & AT_SYMLINK_NOFOLLOW != 0 { brix.LINK_ITSELF } else { 0 })
    if got < 0 { return asErrno(got) }
    const into = unsafe { @ptrFromInt([*]u8, result) }
    zero(into, 256)
    put32(into, 0, 0x7FF)
    put32(into, 4, 4096)
    put32(into, 16, @intCast(usize, info.links))
    put32(into, 20, @intCast(usize, info.owners & 0xFFFF))
    put32(into, 24, @intCast(usize, info.owners >> 16))
    into[28] = @intCast(u8, (kindBits(info.kind) | (info.mode & 0xFFF)) & 0xFF)
    into[29] = @intCast(u8, ((kindBits(info.kind) | (info.mode & 0xFFF)) >> 8) & 0xFF)
    put64(into, 32, @intCast(usize, info.number))
    put64(into, 40, @intCast(usize, info.size))
    put64(into, 48, (@intCast(usize, info.size) + 511) / 512)
    put32(into, 128, @intCast(usize, info.device >> 8))
    put32(into, 132, @intCast(usize, info.device & 0xFF))
    const modified = @intCast(usize, info.modified)
    const stamps: [3]usize = [3]usize{ 64, 96, 112 }
    for at in stamps {
        put64(into, at, modified / 1000000000)
        put32(into, at + 8, modified % 1000000000)
    }
    return 0
}

// Whether the caller may: the node's bits for its owner when the caller
// is it, else for everyone else (user 0 may read and write anything,
// run what someone may run).
var selfUser: usize = 0xFFFFFFFF // (per run)

fn callerUser() -> usize {
    if selfUser == 0xFFFFFFFF {
        var record: brix.ProcessRecord = undefined
        var none: [1]u8 = undefined
        selfUser = if brix.processSelf(&record, none[0..0]) >= 0 { @intCast(usize, record.user) } else { 0 }
    }
    return selfUser
}

pub fn access(path: [*]const u8, mode: usize) -> isize {
    var info: brix.NodeInfo = undefined
    const got = brix.nodeInfoAt(0, path[0..lengthOf(path)], &info, 0)
    if got < 0 { return asErrno(got) }
    if mode == 0 { return 0 }
    const user = callerUser()
    const bits = @intCast(usize, info.mode)
    if user == 0 { return if mode & 1 == 0 || bits & 0x49 != 0 || info.kind == brix.NodeKind.DIRECTORY { 0 } else { -13 } }
    const allowed = if @intCast(usize, info.owners & 0xFFFF) == user { (bits >> 6) & 7 } else { bits & 7 }
    return if allowed & mode == mode { 0 } else { -13 }
}

pub fn readAt(descriptor: isize, destination: usize, length: usize, offset: usize) -> isize {
    var result = brix.call4(brix.READ, @intCast(usize, handleFor(descriptor, false)), destination, length, offset)
    if result == -brix.Status.invalid_handle { result = brix.call4(brix.READ, @intCast(usize, handleFor(descriptor, true)), destination, length, offset) }
    return asErrno(result)
}

pub fn writeAt(descriptor: isize, source: usize, length: usize, offset: usize) -> isize {
    var result = brix.call4(brix.WRITE, @intCast(usize, handleFor(descriptor, false)), source, length, offset)
    if result == -brix.Status.invalid_handle { result = brix.call4(brix.WRITE, @intCast(usize, handleFor(descriptor, true)), source, length, offset) }
    return asErrno(result)
}

pub fn seek(descriptor: isize, offset: isize, whence: usize) -> isize { return asErrno(brix.seek(handleFor(descriptor, false), offset, whence)) }

pub fn removeAt(directory: isize, path: [*]const u8, flags: usize) -> isize {
    const bytes = path[0..lengthOf(path)]
    var info: brix.NodeInfo = undefined
    const got = brix.nodeInfoAt(baseOf(directory), bytes, &info, brix.LINK_ITSELF)
    if got < 0 { return asErrno(got) }
    const is_directory = info.kind == brix.NodeKind.DIRECTORY
    if flags & AT_REMOVEDIR != 0 && !is_directory { return -20 }
    if flags & AT_REMOVEDIR == 0 && is_directory { return -21 }
    return asErrno(brix.remove(baseOf(directory), bytes))
}

// node_link (a link at the end is the node: AT_SYMLINK_FOLLOW's taking
// where it leads is not done).
pub fn linkAt(fromDirectory: isize, from: [*]const u8, toDirectory: isize, to: [*]const u8, flags: usize) -> isize {
    return asErrno(brix.link(baseOf(fromDirectory), from[0..lengthOf(from)], baseOf(toDirectory), to[0..lengthOf(to)]))
}

pub fn symbolicLink(target: [*]const u8, path: [*]const u8) -> isize {
    return asErrno(brix.make(0, path[0..lengthOf(path)], brix.NodeKind.LINK, 0x1FF, target[0..lengthOf(target)]))
}

pub fn readLink(path: [*]const u8, destination: usize, length: usize) -> isize {
    const into = unsafe { @ptrFromInt([*]u8, destination) }
    return asErrno(brix.nodeTarget(0, path[0..lengthOf(path)], into[0..length]))
}

// No extended attributes (ENOTSUP).
pub fn extendedAttribute(path: [*]const u8, name: [*]const u8, destination: usize, length: usize, no_follow: bool) -> isize { return -95 }

pub fn renameAt(fromDirectory: isize, from: [*]const u8, toDirectory: isize, to: [*]const u8, flags: usize) -> isize {
    const target = to[0..lengthOf(to)]
    if flags & RENAME_NOREPLACE != 0 {
        var info: brix.NodeInfo = undefined
        if brix.nodeInfoAt(baseOf(toDirectory), target, &info, brix.LINK_ITSELF) >= 0 { return -17 }
    }
    return asErrno(brix.rename(baseOf(fromDirectory), from[0..lengthOf(from)], baseOf(toDirectory), target))
}

pub fn makeDirectory(path: [*]const u8, mode: usize) -> isize {
    return asErrno(brix.make(0, path[0..lengthOf(path)], brix.NodeKind.DIRECTORY, mode & 0xFFF, path[0..0]))
}

// A fifo, or an empty file.
pub fn makeNode(path: [*]const u8, mode: usize, device: usize) -> isize {
    if mode & 0xF000 == @intCast(usize, S_IFIFO) { return asErrno(brix.make(0, path[0..lengthOf(path)], brix.NodeKind.FIFO, mode & 0xFFF, path[0..0])) }
    if mode & 0xF000 != 0 && mode & 0xF000 != @intCast(usize, S_IFREG) { return -1 }
    const made = brix.open(0, path[0..lengthOf(path)], brix.Open.WRITE | brix.Open.CREATE | brix.Open.EXCLUSIVE, mode & 0xFFF)
    if made < 0 { return asErrno(made) }
    _ = brix.close(@intCast(brix.Handle, made))
    return 0
}

pub fn removeDirectory(path: [*]const u8) -> isize { return removeAt(AT_FDCWD, path, AT_REMOVEDIR) }

// The node opened without reading or writing it (for node_set and
// node_own); a listener or a fifo cannot be had so (they are not files).
fn nodeOf(directory: isize, path: [*]const u8) -> isize {
    const bytes = path[0..lengthOf(path)]
    var info: brix.NodeInfo = undefined
    const got = brix.nodeInfoAt(baseOf(directory), bytes, &info, 0)
    if got < 0 { return got }
    if info.kind == brix.NodeKind.LISTENER || info.kind == brix.NodeKind.FIFO { return -brix.Status.unsupported }
    return brix.open(baseOf(directory), bytes, 0, 0)
}

pub fn changeModeAt(directory: isize, path: [*]const u8, mode: usize) -> isize {
    return asErrno(brix.nodeSetAt(baseOf(directory), path[0..lengthOf(path)], brix.NodeSet.MODE, mode, 0))
}

pub fn changeOwnerAt(directory: isize, path: [*]const u8, user: usize, group: usize, flags: usize) -> isize {
    const node = nodeOf(directory, path)
    if node < 0 { return asErrno(node) }
    const result = brix.own(@intCast(brix.Handle, node), user & 0xFFFFFFFF, group & 0xFFFFFFFF)
    _ = brix.close(@intCast(brix.Handle, node))
    return asErrno(result)
}

// The kernel keeps the process's mask (what node_make and a creating
// node_open leave out); it is not asked for: the usual one.
pub fn setUmask(mask: usize) -> usize { return brix.setUmask(mask) }

// A timespec's nanoseconds, or NOW, or none (OMIT).
fn stampOf(times: usize, index: usize) -> usize {
    if times == 0 { return brix.NodeSet.NOW }
    const words = unsafe { @ptrFromInt([*]const usize, times) }
    const nanoseconds = words[index * 2 + 1]
    if nanoseconds == UTIME_NOW { return brix.NodeSet.NOW }
    if nanoseconds == UTIME_OMIT { return 0 }
    return words[index * 2] * 1000000000 + nanoseconds
}

pub fn setTimesAt(directory: isize, path: usize, times: usize, flags: usize) -> isize {
    const accessed = stampOf(times, 0)
    const modified = stampOf(times, 1)
    var result: isize = 0
    if path == 0 {
        // The node `directory` is open on (futimens).
        const handle = handleFor(directory, false)
        if accessed != 0 { result = brix.nodeSet(handle, brix.NodeSet.ACCESSED, accessed) }
        if result >= 0 && modified != 0 { result = brix.nodeSet(handle, brix.NodeSet.MODIFIED, modified) }
        return asErrno(result)
    }
    const bytes = unsafe { @ptrFromInt([*]const u8, path) }
    const named = bytes[0..lengthOf(bytes)]
    const itself = if flags & AT_SYMLINK_NOFOLLOW != 0 { brix.LINK_ITSELF } else { @intCast(usize, 0) }
    if accessed != 0 { result = brix.nodeSetAt(baseOf(directory), named, brix.NodeSet.ACCESSED, accessed, itself) }
    if result >= 0 && modified != 0 { result = brix.nodeSetAt(baseOf(directory), named, brix.NodeSet.MODIFIED, modified, itself) }
    return asErrno(result)
}

pub fn truncate(descriptor: isize, length: usize) -> isize { return asErrno(brix.nodeSet(handleFor(descriptor, false), brix.NodeSet.SIZE, length)) }

// What is written is on its volume (brixfs writes through).
pub fn syncAll() -> isize {
    _ = brix.sync(0)
    return 0
}
pub fn syncFile(descriptor: isize, data_only: bool) -> isize {
    const synced = brix.sync(handleFor(descriptor, false))
    return if synced < 0 { asErrno(synced) } else { 0 }
}
pub fn syncFileSystem(descriptor: isize) -> isize { return syncFile(descriptor, false) }

// A stream's size is the kernel's.
pub fn setPipeSize(descriptor: isize, length: usize) -> isize { return 0 }

// Neither: std.fs copies through memory (ENOSYS).
pub fn splice(source: isize, destination: isize, length: usize) -> isize { return -38 }
pub fn copyRange(source: isize, destination: isize, length: usize) -> isize {
    const copied = brix.copy(handleFor(source, false), handleFor(destination, false), length)
    return if copied < 0 { asErrno(copied) } else { copied }
}

// Waits `duration` nanoseconds: a wait on nothing until then (again after
// an upcall came in).
pub fn sleep(duration: usize) -> bool {
    const deadline = brix.clock(brix.Clock.MONOTONIC) + duration
    while true {
        const result = brix.call3(brix.WAIT, 0, 0, deadline)
        if result != -brix.Status.interrupted { return true }
    }
    return true
}

// ---------------------------------------------------------------------------
// The process itself: process_self, process_start_stack, memory_region.

pub fn userId() -> usize {
    var record: brix.ProcessRecord = undefined
    var none: [1]u8 = undefined
    if brix.processSelf(&record, none[0..0]) < 0 { return 0 }
    return @intCast(usize, record.user)
}

pub fn processId() -> usize {
    var record: brix.ProcessRecord = undefined
    var none: [1]u8 = undefined
    if brix.processSelf(&record, none[0..0]) < 0 { return 0 }
    return @intCast(usize, record.pid)
}

pub fn processName(into: [*]u8, capacity: usize) -> usize {
    var record: brix.ProcessRecord = undefined
    var none: [1]u8 = undefined
    if brix.processSelf(&record, none[0..0]) < 0 { return 0 }
    var length: usize = 0
    while length < 32 && length < capacity && record.name[length] != 0 {
        into[length] = record.name[length]
        length += 1
    }
    return length
}

pub fn executablePath(into: [*]u8, capacity: usize) -> usize {
    var record: brix.ProcessRecord = undefined
    const length = brix.processSelf(&record, into[0..capacity])
    return if length > 0 { @bitCast(usize, length) } else { 0 }
}

pub fn environmentText(into: [*]u8, capacity: usize) -> usize {
    const entries = brix.startEnvironment()
    var length: usize = 0
    var index: usize = 0
    while @intFromPtr(entries[index]) != 0 {
        const entry = entries[index]
        var at: usize = 0
        while entry[at] != 0 && length < capacity {
            into[length] = entry[at]
            length += 1
            at += 1
        }
        if length >= capacity { return length }
        into[length] = 0
        length += 1
        index += 1
    }
    return length
}

pub fn pageMapped(address: usize) -> bool {
    var region: [2]usize = [2]usize{ 0, 0 }
    return brix.memoryRegion(address, &region) == 0
}

// A file mapped as the process's own pages (node_map).
pub fn mapFile(descriptor: isize, length: usize) -> usize {
    const result = brix.mapNode(handleFor(descriptor, false), 0, length)
    return if result < 0 { 0 } else { @bitCast(usize, result) }
}

pub fn unmapFile(address: usize, length: usize) -> void { _ = brix.unmap(address, length) }

// A wait for the handle to be readable (or its writer gone).
pub fn readable(descriptor: isize, wait_ns: usize) -> bool {
    var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = handleFor(descriptor, false), .want = brix.State.READABLE | brix.State.PEER_GONE, .seen = 0, .reserved = 0 } }
    const deadline = if wait_ns == 0 { 0 } else { brix.clock(brix.Clock.MONOTONIC) + wait_ns }
    return brix.wait(items[0..1], deadline) > 0
}
