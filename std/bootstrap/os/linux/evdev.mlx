// Input devices (<linux/input.h>, <linux/input-event-codes.h>): the
// requests that say what an /dev/input/eventN is, and its events as the
// compositor's DRM backend and the console read them.
//
// An event (struct input_event on 64-bit Linux) is 24 bytes: the time
// (16), u16 type, u16 code, s32 value. Types and codes are u32 here, as
// their users compute with them.

const mem = @import("../../mem.mlx")

pub const EVENT_SIZE: usize = 24

pub const EV_SYN: u32 = 0
pub const EV_KEY: u32 = 1
pub const EV_REL: u32 = 2
pub const EV_ABS: u32 = 3
pub const SYN_REPORT: u32 = 0
pub const REL_X: u32 = 0
pub const REL_Y: u32 = 1
pub const REL_HWHEEL: u32 = 6
pub const REL_WHEEL: u32 = 8
pub const ABS_X: u32 = 0
pub const ABS_Y: u32 = 1
pub const KEY_A: u32 = 30
pub const KEY_SPACE: u32 = 57
pub const BTN_LEFT: u32 = 272
pub const BTN_RIGHT: u32 = 273
pub const BTN_MIDDLE: u32 = 274
pub const BTN_TASK: u32 = 279
pub const BTN_TOOL_FINGER: u32 = 325
pub const BTN_TOUCH: u32 = 330
pub const BTN_TOOL_DOUBLETAP: u32 = 333
pub const BTN_TOOL_TRIPLETAP: u32 = 334
pub const BTN_TOOL_QUADTAP: u32 = 335
// The device's properties (EVIOCGPROP): a touchscreen, a clickpad.
pub const INPUT_PROP_DIRECT: usize = 1
pub const INPUT_PROP_BUTTONPAD: usize = 2

// The EVIOCG* requests: _IOC(_IOC_READ, 'E', number, size).
pub fn readRequest(number: usize, size: usize) -> usize { return 2147483648 + size * 65536 + 17664 + number }

// EVIOCGNAME(size): the device's name.
pub fn nameRequest(size: usize) -> usize { return readRequest(6, size) }

// EVIOCGPROP(size): its property bits.
pub fn propertiesRequest(size: usize) -> usize { return readRequest(9, size) }

// EVIOCGBIT(kind, size): the bits of event type `kind` it has (kind 0:
// the types themselves).
pub fn bitsRequest(kind: usize, size: usize) -> usize { return readRequest(32 + kind, size) }

// EVIOCGABS(axis): struct input_absinfo (24 bytes: value, minimum,
// maximum, fuzz, flat, resolution, s32 each).
pub fn absoluteRequest(axis: u32) -> usize { return readRequest(64 + @intCast(usize, axis), 24) }

pub fn hasBit(bits: [*]const u8, bit: usize) -> bool {
    return (bits[bit / 8] >> @intCast(u8, bit % 8)) & 1 != 0
}

// Whether a device's EV_KEY bits (EVIOCGBIT(EV_KEY, 96)) are a keyboard's:
// letters and a space bar (a mouse or a power button has neither).
pub fn isKeyboard(key_bits: [*]const u8) -> bool {
    return hasBit(key_bits, @intCast(usize, KEY_A)) && hasBit(key_bits, @intCast(usize, KEY_SPACE))
}

// The type, code and value of the event at `at` in `bytes`.
pub fn eventType(bytes: [*]const u8, at: usize) -> u32 { return @intCast(u32, mem.readU16Little(bytes, at + 16)) }
pub fn eventCode(bytes: [*]const u8, at: usize) -> u32 { return @intCast(u32, mem.readU16Little(bytes, at + 18)) }
pub fn eventValue(bytes: [*]const u8, at: usize) -> i32 { return @bitCast(i32, mem.readU32Little(bytes, at + 20)) }
