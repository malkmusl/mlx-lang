// Raw Linux x86_64 socket ABI. Addresses and option buffers are passed as
// integer addresses so the portable layer can define its own typed layouts.

const mem = @import("../../mem.mlx")

pub extern("syscall") fn syscall1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn syscall2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}
pub extern("syscall") fn syscall5(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize {}
pub extern("syscall") fn syscall6(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {}

pub const AF_UNIX: usize = 1
pub const AF_INET: usize = 2
pub const AF_INET6: usize = 10
pub const SOCK_STREAM: usize = 1
pub const SOCK_DGRAM: usize = 2
pub const SOCK_NONBLOCK: usize = 2048
pub const SOCK_CLOEXEC: usize = 524288
pub const SOL_SOCKET: usize = 1
pub const SO_REUSEADDR: usize = 2
pub const SHUT_RD: usize = 0
pub const SHUT_WR: usize = 1
pub const SHUT_RDWR: usize = 2
pub const MSG_DONTWAIT: usize = 64
pub const MSG_NOSIGNAL: usize = 16384
pub const F_GETFL: usize = 3
pub const F_SETFL: usize = 4
pub const O_NONBLOCK: usize = 2048

const SYS_close: usize = 3
const SYS_socket: usize = 41
const SYS_connect: usize = 42
const SYS_accept: usize = 43
const SYS_sendto: usize = 44
const SYS_recvfrom: usize = 45
const SYS_sendmsg: usize = 46
const SYS_recvmsg: usize = 47
const SYS_shutdown: usize = 48
const SYS_bind: usize = 49
const SYS_listen: usize = 50
const SYS_getsockname: usize = 51
const SYS_getpeername: usize = 52
const SYS_socketpair: usize = 53
const SYS_setsockopt: usize = 54
const SYS_getsockopt: usize = 55
const SYS_fcntl: usize = 72
const SYS_accept4: usize = 288

pub fn open(domain: usize, kind: usize, protocol: usize) -> isize { return syscall3(SYS_socket, domain, kind, protocol) }
pub fn close(descriptor: isize) -> isize { return syscall1(SYS_close, @bitCast(usize, descriptor)) }
pub fn bind(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_bind, @bitCast(usize, descriptor), address, length) }
pub fn listen(descriptor: isize, backlog: usize) -> isize { return syscall2(SYS_listen, @bitCast(usize, descriptor), backlog) }
pub fn connect(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_connect, @bitCast(usize, descriptor), address, length) }
pub fn accept(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_accept, @bitCast(usize, descriptor), address, length) }
pub fn accept4(descriptor: isize, address: usize, length: usize, flags: usize) -> isize { return syscall4(SYS_accept4, @bitCast(usize, descriptor), address, length, flags) }
pub fn shutdown(descriptor: isize, how: usize) -> isize { return syscall2(SYS_shutdown, @bitCast(usize, descriptor), how) }

pub fn send(descriptor: isize, buffer: [*]const u8, length: usize, flags: usize) -> isize {
    return syscall6(SYS_sendto, @bitCast(usize, descriptor), @intFromPtr(buffer), length, flags, 0, 0)
}

pub fn receive(descriptor: isize, buffer: [*]u8, length: usize, flags: usize) -> isize {
    return syscall6(SYS_recvfrom, @bitCast(usize, descriptor), @intFromPtr(buffer), length, flags, 0, 0)
}

pub fn sendTo(descriptor: isize, buffer: [*]const u8, length: usize, flags: usize, address: usize, address_length: usize) -> isize {
    return syscall6(SYS_sendto, @bitCast(usize, descriptor), @intFromPtr(buffer), length, flags, address, address_length)
}

pub fn receiveFrom(descriptor: isize, buffer: [*]u8, length: usize, flags: usize, address: usize, address_length: usize) -> isize {
    return syscall6(SYS_recvfrom, @bitCast(usize, descriptor), @intFromPtr(buffer), length, flags, address, address_length)
}

pub fn sendMessage(descriptor: isize, message: usize, flags: usize) -> isize { return syscall3(SYS_sendmsg, @bitCast(usize, descriptor), message, flags) }
pub fn receiveMessage(descriptor: isize, message: usize, flags: usize) -> isize { return syscall3(SYS_recvmsg, @bitCast(usize, descriptor), message, flags) }
pub fn socketPair(domain: usize, kind: usize, protocol: usize, descriptors: *[2]i32) -> isize { return syscall4(SYS_socketpair, domain, kind, protocol, @intFromPtr(descriptors)) }
pub fn getSocketName(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_getsockname, @bitCast(usize, descriptor), address, length) }
pub fn getPeerName(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_getpeername, @bitCast(usize, descriptor), address, length) }
pub fn setOption(descriptor: isize, level: usize, name: usize, value: usize, length: usize) -> isize { return syscall5(SYS_setsockopt, @bitCast(usize, descriptor), level, name, value, length) }
pub fn getOption(descriptor: isize, level: usize, name: usize, value: usize, length: usize) -> isize { return syscall5(SYS_getsockopt, @bitCast(usize, descriptor), level, name, value, length) }
pub fn getFlags(descriptor: isize) -> isize { return syscall3(SYS_fcntl, @bitCast(usize, descriptor), F_GETFL, 0) }
pub fn setFlags(descriptor: isize, flags: usize) -> isize { return syscall3(SYS_fcntl, @bitCast(usize, descriptor), F_SETFL, flags) }

pub fn setNonBlocking(descriptor: isize) -> isize {
    const flags = getFlags(descriptor)
    if flags < 0 { return flags }
    return setFlags(descriptor, @bitCast(usize, flags) | O_NONBLOCK)
}

// ---------------------------------------------------------------------------
// Unix sockets

pub const MSG_CTRUNC: u32 = 8
pub const MSG_CMSG_CLOEXEC: usize = 1073741824
pub const SO_PEERCRED: usize = 17
pub const SCM_RIGHTS: u32 = 1
// The longest path a sockaddr_un holds (108 bytes with its NUL).
pub const MAX_UNIX_PATH: usize = 107

const EINTR: isize = -4
const ENAMETOOLONG: isize = -36

// A sockaddr_un in `address` (110 bytes or more): AF_UNIX, then `path`
// NUL-terminated, or for an abstract socket (`abstract`) a NUL and the
// name. Its length for bind and connect, or 0 when the path does not fit
// (or is empty).
pub fn unixAddress(address: [*]u8, path: []const u8, abstract: bool) -> usize {
    if path.length == 0 || path.length > MAX_UNIX_PATH { return 0 }
    var index: usize = 0
    while index < 110 {
        address[index] = 0
        index += 1
    }
    address[0] = 1
    const start: usize = if abstract { 3 } else { 2 }
    if start + path.length > 110 { return 0 }
    index = 0
    while index < path.length {
        address[start + index] = path[index]
        index += 1
    }
    // A path's length counts its NUL; an abstract name's is exact.
    return if abstract { start + path.length } else { start + path.length + 1 }
}

// A stream socket (`flags`: SOCK_NONBLOCK, SOCK_CLOEXEC) connected to the
// Unix socket `path`: its descriptor, or -errno.
pub fn connectUnix(path: []const u8, abstract: bool, flags: usize) -> isize {
    var address: [112]u8 = undefined
    const bytes: [*]u8 = &address
    const length = unixAddress(bytes, path, abstract)
    if length == 0 { return ENAMETOOLONG }
    const descriptor = open(AF_UNIX, SOCK_STREAM | flags, 0)
    if descriptor < 0 { return descriptor }
    const result = connect(descriptor, @intFromPtr(bytes), length)
    if result < 0 {
        const ignored = close(descriptor)
        return result
    }
    return descriptor
}

// A stream socket (`flags` as above) listening at `path` with `backlog`:
// its descriptor, or -errno. A path socket left behind by an earlier run
// is the caller's to remove (it may be another's).
pub fn listenUnix(path: []const u8, abstract: bool, flags: usize, backlog: usize) -> isize {
    var address: [112]u8 = undefined
    const bytes: [*]u8 = &address
    const length = unixAddress(bytes, path, abstract)
    if length == 0 { return ENAMETOOLONG }
    const descriptor = open(AF_UNIX, SOCK_STREAM | flags, 0)
    if descriptor < 0 { return descriptor }
    const bound = bind(descriptor, @intFromPtr(bytes), length)
    if bound < 0 {
        const ignored = close(descriptor)
        return bound
    }
    const listening = listen(descriptor, backlog)
    if listening < 0 {
        const ignored = close(descriptor)
        return listening
    }
    return descriptor
}

// The pid, uid and gid of a Unix socket's peer (SO_PEERCRED).
pub fn peerCredentials(descriptor: isize, pid: *u32, uid: *u32, gid: *u32) -> bool {
    var credentials: [3]u32 = [3]u32{ 0, 0, 0 }
    var length: u32 = 12
    if getOption(descriptor, SOL_SOCKET, SO_PEERCRED, @intFromPtr(&credentials), @intFromPtr(&length)) != 0 { return false }
    pid.* = credentials[0]
    uid.* = credentials[1]
    gid.* = credentials[2]
    return true
}

// The most descriptors one message carries here (the kernel's limit is
// 253; Wayland's and D-Bus's messages take far fewer).
pub const MAX_PASSED: usize = 28

// sendmsg(2) of `length` bytes with `count` descriptors (SCM_RIGHTS, at
// most MAX_PASSED; the kernel duplicates them, the caller's stay open),
// again after a signal interrupts it: the bytes sent, or -errno.
pub fn sendWithDescriptors(descriptor: isize, bytes: [*]const u8, length: usize, descriptors: [*]const isize, count: usize, flags: usize) -> isize {
    var header: [56]u8 = undefined
    var vector: [16]u8 = undefined
    var control: [128]u8 = undefined
    const header_bytes: [*]u8 = &header
    const vector_bytes: [*]u8 = &vector
    const control_bytes: [*]u8 = &control
    mem.zero(header_bytes, 56)
    mem.writeU64Little(vector_bytes, 0, @intFromPtr(bytes))
    mem.writeU64Little(vector_bytes, 8, length)
    mem.writeU64Little(header_bytes, 16, @intFromPtr(vector_bytes))
    mem.writeU64Little(header_bytes, 24, 1)
    const passed = if count > MAX_PASSED { MAX_PASSED } else { count }
    if passed > 0 {
        mem.zero(control_bytes, 128)
        mem.writeU64Little(control_bytes, 0, 16 + passed * 4)
        mem.writeU32Little(control_bytes, 8, 1)
        mem.writeU32Little(control_bytes, 12, SCM_RIGHTS)
        var index: usize = 0
        while index < passed {
            mem.writeU32Little(control_bytes, 16 + index * 4, @intCast(u32, descriptors[index] & 4294967295))
            index += 1
        }
        mem.writeU64Little(header_bytes, 32, @intFromPtr(control_bytes))
        mem.writeU64Little(header_bytes, 40, 16 + ((passed * 4 + 7) / 8) * 8)
    }
    var sent = sendMessage(descriptor, @intFromPtr(header_bytes), flags)
    while sent == EINTR { sent = sendMessage(descriptor, @intFromPtr(header_bytes), flags) }
    return sent
}

// recvmsg(2) into `into` (again after a signal interrupts it), with the
// descriptors that came along (SCM_RIGHTS) put in `descriptors`: their
// number in `count`; those beyond `room` are closed. The bytes read, 0 at
// the end of the stream, or -errno; -EPROTO when the kernel had more
// descriptors than the record had room for (the bytes are lost then, and
// the descriptors that did come are in `descriptors`).
pub fn receiveWithDescriptors(descriptor: isize, into: [*]u8, capacity: usize, descriptors: [*]isize, room: usize, count: *usize, flags: usize) -> isize {
    count.* = 0
    var header: [56]u8 = undefined
    var vector: [16]u8 = undefined
    var control: [256]u8 = undefined
    const header_bytes: [*]u8 = &header
    const vector_bytes: [*]u8 = &vector
    const control_bytes: [*]u8 = &control
    mem.zero(header_bytes, 56)
    mem.writeU64Little(vector_bytes, 0, @intFromPtr(into))
    mem.writeU64Little(vector_bytes, 8, capacity)
    mem.writeU64Little(header_bytes, 16, @intFromPtr(vector_bytes))
    mem.writeU64Little(header_bytes, 24, 1)
    mem.writeU64Little(header_bytes, 32, @intFromPtr(control_bytes))
    mem.writeU64Little(header_bytes, 40, 256)
    var received = receiveMessage(descriptor, @intFromPtr(header_bytes), flags)
    while received == EINTR { received = receiveMessage(descriptor, @intFromPtr(header_bytes), flags) }
    if received < 0 { return received }
    const control_length = @intCast(usize, mem.readU64Little(header_bytes, 40))
    var offset: usize = 0
    while offset + 16 <= control_length {
        const record_length = @intCast(usize, mem.readU64Little(control_bytes, offset))
        if record_length < 16 || offset + record_length > control_length { break }
        if mem.readU32Little(control_bytes, offset + 8) == 1 && mem.readU32Little(control_bytes, offset + 12) == SCM_RIGHTS {
            var index: usize = 0
            while index < (record_length - 16) / 4 {
                const passed = @intCast(isize, mem.readU32Little(control_bytes, offset + 16 + index * 4))
                if count.* < room {
                    descriptors[count.*] = passed
                    count.* += 1
                } else {
                    const ignored = close(passed)
                }
                index += 1
            }
        }
        offset += ((record_length + 7) / 8) * 8
    }
    if (mem.readU32Little(header_bytes, 48) & MSG_CTRUNC) != 0 { return -71 }
    return received
}
