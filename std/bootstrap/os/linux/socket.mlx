// Raw Linux x86_64 socket ABI. Addresses and option buffers are passed as
// integer addresses so the portable layer can define its own typed layouts.

pub extern("syscall") fn syscall1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn syscall2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}
pub extern("syscall") fn syscall5(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize {}
pub extern("syscall") fn syscall6(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {}

pub const AF_UNIX: usize = 1
pub const AF_INET: usize = 2
pub const AF_INET6: usize = 10
pub const SOCK_STREAM: usize = 1
pub const SOCK_DGRAM: usize = 2
pub const SOCK_NONBLOCK: usize = 2048
pub const SOCK_CLOEXEC: usize = 524288
pub const SOL_SOCKET: usize = 1
pub const SO_REUSEADDR: usize = 2
pub const SHUT_RD: usize = 0
pub const SHUT_WR: usize = 1
pub const SHUT_RDWR: usize = 2
pub const MSG_DONTWAIT: usize = 64
pub const MSG_NOSIGNAL: usize = 16384
pub const F_GETFL: usize = 3
pub const F_SETFL: usize = 4
pub const O_NONBLOCK: usize = 2048

const SYS_close: usize = 3
const SYS_socket: usize = 41
const SYS_connect: usize = 42
const SYS_accept: usize = 43
const SYS_sendto: usize = 44
const SYS_recvfrom: usize = 45
const SYS_sendmsg: usize = 46
const SYS_recvmsg: usize = 47
const SYS_shutdown: usize = 48
const SYS_bind: usize = 49
const SYS_listen: usize = 50
const SYS_getsockname: usize = 51
const SYS_getpeername: usize = 52
const SYS_socketpair: usize = 53
const SYS_setsockopt: usize = 54
const SYS_getsockopt: usize = 55
const SYS_fcntl: usize = 72
const SYS_accept4: usize = 288

pub fn open(domain: usize, kind: usize, protocol: usize) -> isize { return syscall3(SYS_socket, domain, kind, protocol) }
pub fn close(descriptor: isize) -> isize { return syscall1(SYS_close, @bitCast(usize, descriptor)) }
pub fn bind(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_bind, @bitCast(usize, descriptor), address, length) }
pub fn listen(descriptor: isize, backlog: usize) -> isize { return syscall2(SYS_listen, @bitCast(usize, descriptor), backlog) }
pub fn connect(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_connect, @bitCast(usize, descriptor), address, length) }
pub fn accept(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_accept, @bitCast(usize, descriptor), address, length) }
pub fn accept4(descriptor: isize, address: usize, length: usize, flags: usize) -> isize { return syscall4(SYS_accept4, @bitCast(usize, descriptor), address, length, flags) }
pub fn shutdown(descriptor: isize, how: usize) -> isize { return syscall2(SYS_shutdown, @bitCast(usize, descriptor), how) }

pub fn send(descriptor: isize, buffer: [*]const u8, length: usize, flags: usize) -> isize {
    return syscall6(SYS_sendto, @bitCast(usize, descriptor), @intFromPtr(buffer), length, flags, 0, 0)
}

pub fn receive(descriptor: isize, buffer: [*]u8, length: usize, flags: usize) -> isize {
    return syscall6(SYS_recvfrom, @bitCast(usize, descriptor), @intFromPtr(buffer), length, flags, 0, 0)
}

pub fn sendTo(descriptor: isize, buffer: [*]const u8, length: usize, flags: usize, address: usize, address_length: usize) -> isize {
    return syscall6(SYS_sendto, @bitCast(usize, descriptor), @intFromPtr(buffer), length, flags, address, address_length)
}

pub fn receiveFrom(descriptor: isize, buffer: [*]u8, length: usize, flags: usize, address: usize, address_length: usize) -> isize {
    return syscall6(SYS_recvfrom, @bitCast(usize, descriptor), @intFromPtr(buffer), length, flags, address, address_length)
}

pub fn sendMessage(descriptor: isize, message: usize, flags: usize) -> isize { return syscall3(SYS_sendmsg, @bitCast(usize, descriptor), message, flags) }
pub fn receiveMessage(descriptor: isize, message: usize, flags: usize) -> isize { return syscall3(SYS_recvmsg, @bitCast(usize, descriptor), message, flags) }
pub fn socketPair(domain: usize, kind: usize, protocol: usize, descriptors: *[2]i32) -> isize { return syscall4(SYS_socketpair, domain, kind, protocol, @intFromPtr(descriptors)) }
pub fn getSocketName(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_getsockname, @bitCast(usize, descriptor), address, length) }
pub fn getPeerName(descriptor: isize, address: usize, length: usize) -> isize { return syscall3(SYS_getpeername, @bitCast(usize, descriptor), address, length) }
pub fn setOption(descriptor: isize, level: usize, name: usize, value: usize, length: usize) -> isize { return syscall5(SYS_setsockopt, @bitCast(usize, descriptor), level, name, value, length) }
pub fn getOption(descriptor: isize, level: usize, name: usize, value: usize, length: usize) -> isize { return syscall5(SYS_getsockopt, @bitCast(usize, descriptor), level, name, value, length) }
pub fn getFlags(descriptor: isize) -> isize { return syscall3(SYS_fcntl, @bitCast(usize, descriptor), F_GETFL, 0) }
pub fn setFlags(descriptor: isize, flags: usize) -> isize { return syscall3(SYS_fcntl, @bitCast(usize, descriptor), F_SETFL, flags) }

pub fn setNonBlocking(descriptor: isize) -> isize {
    const flags = getFlags(descriptor)
    if flags < 0 { return flags }
    return setFlags(descriptor, @bitCast(usize, flags) | O_NONBLOCK)
}
