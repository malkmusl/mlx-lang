// The ioctl requests of terminals (<asm-generic/ioctls.h>) and of the
// virtual consoles (<linux/kd.h>, <linux/vt.h>), as std.terminal, the
// init's services, the splash, the console and the login take them.

// Terminals: their modes (struct termios), the controlling terminal,
// the foreground process group, the window size (struct winsize), and a
// pseudo-terminal's number and lock.
pub const TCGETS: usize = 21505
pub const TCSETS: usize = 21506
pub const TIOCSCTTY: usize = 21518
pub const TIOCGPGRP: usize = 21519
pub const TIOCSPGRP: usize = 21520
pub const TIOCGWINSZ: usize = 21523
pub const TIOCSWINSZ: usize = 21524
pub const TIOCGPTN: usize = 2147767344
pub const TIOCSPTLCK: usize = 1074025521

// A console's mode: text, or graphics (the kernel draws nothing on it).
pub const KDSETMODE: usize = 19258
pub const KDGETMODE: usize = 19259
pub const KD_TEXT: usize = 0
pub const KD_GRAPHICS: usize = 1
// Its keyboard's mode: K_UNICODE, or K_OFF (the keys are left to the
// program reading the input devices).
pub const KDGKBMODE: usize = 19268
pub const KDSKBMODE: usize = 19269
pub const K_UNICODE: usize = 3
pub const K_OFF: usize = 4

// Switching consoles: to number N, and waiting until N is the one shown.
pub const VT_ACTIVATE: usize = 22022
pub const VT_WAITACTIVE: usize = 22023
