pub extern("syscall") fn syscall1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}

const SYS_uname: usize = 63
const SYS_sched_getaffinity: usize = 204

pub const UtsName = struct {
    systemName: [65]u8
    nodeName: [65]u8
    release: [65]u8
    version: [65]u8
    machine: [65]u8
    domainName: [65]u8
}

pub fn getSystemInfo(result: *UtsName) -> bool {
    return syscall1(SYS_uname, @intFromPtr(result)) == 0
}

pub fn availableProcessorCount() -> usize {
    var mask: [128]u8 = undefined
    const amount = syscall3(SYS_sched_getaffinity, 0, 128, @intFromPtr(&mask))
    if amount <= 0 { return 1 }
    var result: usize = 0
    var index: usize = 0
    while index < @bitCast(usize, amount) {
        var bits = mask[index]
        while bits > 0 {
            result += @intCast(usize, bits & 1)
            bits = bits >> 1
        }
        index += 1
    }
    return if result == 0 { 1 } else { result }
}
