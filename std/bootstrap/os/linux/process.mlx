pub extern("syscall") fn syscall0(number: usize) -> isize {}
pub extern("syscall") fn syscall2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}

pub const SYS_execve: usize = 59
const SYS_rt_sigaction: usize = 13
const SYS_rt_sigprocmask: usize = 14
const SYS_kill: usize = 62
const SYS_getuid: usize = 102
const SYS_getgid: usize = 104
const SYS_geteuid: usize = 107
const SYS_getegid: usize = 108
const SYS_setuid: usize = 105
const SYS_setgid: usize = 106
const SYS_getgroups: usize = 115
const SYS_getpgrp: usize = 111
const SYS_getppid: usize = 110
const SYS_getpid: usize = 39

pub const INTERRUPT_SIGNAL: usize = 2
pub const BROKEN_PIPE_SIGNAL: usize = 13

const SignalAction = struct {
    handler: usize
    flags: usize
    restorer: usize
    mask: usize
}

pub fn execute(path: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8) -> isize {
    return syscall3(SYS_execve, @intFromPtr(path), @intFromPtr(arguments), @intFromPtr(environment))
}

pub fn ignoreSignal(number: usize) -> bool {
    var action = SignalAction.{ .handler = 1, .flags = 0, .restorer = 0, .mask = 0 }
    return syscall4(SYS_rt_sigaction, number, @intFromPtr(&action), 0, 8) == 0
}

pub fn defaultSignal(number: usize) -> bool {
    var action = SignalAction.{ .handler = 0, .flags = 0, .restorer = 0, .mask = 0 }
    return syscall4(SYS_rt_sigaction, number, @intFromPtr(&action), 0, 8) == 0
}

pub fn blockSignals(mask: usize) -> bool {
    var value = mask
    return syscall4(SYS_rt_sigprocmask, 0, @intFromPtr(&value), 0, 8) == 0
}

pub fn unblockSignals(mask: usize) -> bool {
    var value = mask
    return syscall4(SYS_rt_sigprocmask, 1, @intFromPtr(&value), 0, 8) == 0
}

pub fn isAlive(identifier: usize) -> bool {
    const result = syscall2(SYS_kill, identifier, 0)
    return result == 0 || result == -1
}

pub fn realUserId() -> u32 { return @intCast(u32, syscall0(SYS_getuid)) }
pub fn effectiveUserId() -> u32 { return @intCast(u32, syscall0(SYS_geteuid)) }
pub fn realGroupId() -> u32 { return @intCast(u32, syscall0(SYS_getgid)) }
pub fn effectiveGroupId() -> u32 { return @intCast(u32, syscall0(SYS_getegid)) }
pub fn processId() -> usize { return @bitCast(usize, syscall0(SYS_getpid)) }
pub fn parentProcessId() -> usize { return @bitCast(usize, syscall0(SYS_getppid)) }
pub fn processGroupId() -> usize { return @bitCast(usize, syscall0(SYS_getpgrp)) }

pub fn supplementaryGroups(list: [*]u32, capacity: usize) -> isize {
    return syscall2(SYS_getgroups, capacity, @intFromPtr(list))
}

// ---------------------------------------------------------------------------
// Children

const SYS_fork: usize = 57
const SYS_wait4: usize = 61
const SYS_setsid: usize = 112
const SYS_prctl: usize = 157
const EINTR: isize = -4

// fork(2): 0 in the child, the child's pid in the parent, -errno. (vfork
// has no wrapper: its child shares the caller's stack until execve, so it
// must be issued where the child's work is; see std.spawn.)
pub fn fork() -> isize { return syscall0(SYS_fork) }

// wait4(2) for `pid` (-1: any child; options WNOHANG and the like), again
// after a signal interrupts it: the pid that ended (0 with WNOHANG when
// none did) or -errno, its raw wait status in `status`.
pub fn waitProcess(pid: isize, status: *usize, options: usize) -> isize {
    var raw: u32 = 0
    var result = syscall4(SYS_wait4, @bitCast(usize, pid), @intFromPtr(&raw), options, 0)
    while result == EINTR { result = syscall4(SYS_wait4, @bitCast(usize, pid), @intFromPtr(&raw), options, 0) }
    status.* = @intCast(usize, raw & 65535)
    return result
}

// From a raw wait status: the exit code, or 128 plus the signal that
// ended the child (as shells report it).
pub fn exitStatus(raw: usize) -> usize {
    if raw & 127 == 0 { return (raw >> 8) & 255 }
    return 128 + (raw & 127)
}

// Whether a raw wait status says the child ended by exit(code 0).
pub fn succeeded(raw: usize) -> bool { return raw & 65535 == 0 }

// With WUNTRACED: whether the child stopped, and by which signal; with
// WCONTINUED, whether it went on.
pub fn stopped(raw: usize) -> bool { return raw & 255 == 127 }
pub fn stopSignal(raw: usize) -> usize { return (raw >> 8) & 255 }
pub fn continued(raw: usize) -> bool { return raw == 65535 }

// kill(2); a negative pid is a process group, 0 a signal checks it lives.
pub fn kill(pid: isize, signal: usize) -> isize {
    return syscall2(SYS_kill, @bitCast(usize, pid), signal)
}

// setsid(2): a new session (and process group) led by the caller.
pub fn setSession() -> isize { return syscall0(SYS_setsid) }

// prctl(2), as PR_SET_PDEATHSIG (1) or PR_SET_NAME (15).
pub const PR_SET_PDEATHSIG: usize = 1
pub const PR_SET_NAME: usize = 15
pub fn prctl(option: usize, argument: usize) -> isize {
    return syscall3(SYS_prctl, option, argument, 0)
}

// ---------------------------------------------------------------------------
// Signal sets (a word: bit signal - 1)

pub fn signalBit(signal: usize) -> usize {
    if signal == 0 || signal > 64 { return 0 }
    var bit: usize = 1
    bit = bit << (signal - 1)
    return bit
}

// rt_sigprocmask(how: SIG_BLOCK 0, SIG_UNBLOCK 1, SIG_SETMASK 2, `mask`):
// the set as it was.
pub fn changeSignalMask(how: usize, mask: usize) -> usize {
    var wanted: usize = mask
    var old: usize = 0
    const ignored = syscall4(SYS_rt_sigprocmask, how, @intFromPtr(&wanted), @intFromPtr(&old), 8)
    return old
}

// No signal blocked: what a child is given before execve when its parent
// took its signals through a descriptor (event.signalDescriptor).
pub fn unblockAllSignals() -> void {
    var none: usize = 0
    const ignored = syscall4(SYS_rt_sigprocmask, 2, @intFromPtr(&none), 0, 8)
}

// sigaction(2) with no flags: a handler's address, or 0 (SIG_DFL) and 1
// (SIG_IGN).
pub fn setSignalHandler(number: usize, handler: usize) -> bool {
    var action = SignalAction.{ .handler = handler, .flags = 0, .restorer = 0, .mask = 0 }
    return syscall4(SYS_rt_sigaction, number, @intFromPtr(&action), 0, 8) == 0
}
