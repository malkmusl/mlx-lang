// Raw poll/epoll entry points. Event buffers retain the kernel ABI layout;
// the portable event-loop layer owns typed decoding.

pub extern("syscall") fn syscall1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}

pub const EPOLL_CLOEXEC: usize = 524288
pub const EPOLL_CTL_ADD: usize = 1
pub const EPOLL_CTL_DEL: usize = 2
pub const EPOLL_CTL_MOD: usize = 3
pub const EPOLLIN: u32 = 1
pub const EPOLLOUT: u32 = 4
pub const EPOLLERR: u32 = 8
pub const EPOLLHUP: u32 = 16
pub const EPOLLET: u32 = 2147483648

const SYS_poll: usize = 7
const SYS_epoll_wait: usize = 232
const SYS_epoll_ctl: usize = 233
const SYS_epoll_create1: usize = 291

pub fn poll(descriptors: usize, count: usize, timeout_milliseconds: isize) -> isize {
    return syscall3(SYS_poll, descriptors, count, @bitCast(usize, timeout_milliseconds))
}

pub fn epollCreate(flags: usize) -> isize { return syscall1(SYS_epoll_create1, flags) }

pub fn epollControl(epoll: isize, operation: usize, descriptor: isize, event: usize) -> isize {
    return syscall4(SYS_epoll_ctl, @bitCast(usize, epoll), operation, @bitCast(usize, descriptor), event)
}

pub fn epollWait(epoll: isize, events: usize, maximum: usize, timeout_milliseconds: isize) -> isize {
    return syscall4(SYS_epoll_wait, @bitCast(usize, epoll), events, maximum, @bitCast(usize, timeout_milliseconds))
}
