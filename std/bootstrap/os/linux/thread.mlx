// Raw Linux x86_64 thread and futex ABI.  This module intentionally does not
// select a public std.Thread handle, stack policy, or error-propagation model.

pub extern("syscall") fn syscall0(number: usize) -> isize {}
pub extern("syscall") fn syscall1(number: usize, a1: usize) -> isize {}
pub extern("syscall") fn syscall2(number: usize, a1: usize, a2: usize) -> isize {}
pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}
pub extern("syscall") fn syscall4(number: usize, a1: usize, a2: usize, a3: usize, a4: usize) -> isize {}
pub extern("syscall") fn syscall5(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize) -> isize {}
pub extern("syscall") fn syscall6(number: usize, a1: usize, a2: usize, a3: usize, a4: usize, a5: usize, a6: usize) -> isize {}

pub const SYS_clone: usize = 56
pub const SYS_exit: usize = 60
pub const SYS_sched_yield: usize = 24
pub const SYS_gettid: usize = 186
pub const SYS_futex: usize = 202
pub const SYS_set_robust_list: usize = 273
pub const SYS_rseq: usize = 334
pub const SYS_clone3: usize = 435

// clone/clone3 must be issued through syscall5/syscall2 at the spawning call
// site. A normal function wrapper would return on the child's replaced stack;
// std.Thread will provide the required compiler/runtime trampoline once its
// normative handle and worker contracts are fixed.

pub const FUTEX_WAIT: usize = 0
pub const FUTEX_WAKE: usize = 1
pub const FUTEX_REQUEUE: usize = 3
pub const FUTEX_CMP_REQUEUE: usize = 4
pub const FUTEX_WAKE_OP: usize = 5
pub const FUTEX_WAIT_BITSET: usize = 9
pub const FUTEX_WAKE_BITSET: usize = 10
pub const FUTEX_PRIVATE_FLAG: usize = 128
pub const FUTEX_CLOCK_REALTIME: usize = 256
pub const FUTEX_BITSET_MATCH_ANY: usize = 4294967295

pub fn futex(address: *u32, operation: usize, value: u32, timeout: usize, address2: usize, value3: u32) -> isize {
    return syscall6(SYS_futex, @intFromPtr(address), operation, @intCast(usize, value), timeout, address2, @intCast(usize, value3))
}

pub fn futexWait(address: *u32, expected: u32, timeout: usize, private: bool) -> isize {
    return futex(address, FUTEX_WAIT | if private { FUTEX_PRIVATE_FLAG } else { 0 }, expected, timeout, 0, 0)
}

pub fn futexWake(address: *u32, maximum: u32, private: bool) -> isize {
    return futex(address, FUTEX_WAKE | if private { FUTEX_PRIVATE_FLAG } else { 0 }, maximum, 0, 0, 0)
}

pub fn getTid() -> isize { return syscall0(SYS_gettid) }

pub fn yield() -> isize { return syscall0(SYS_sched_yield) }

pub fn exit(code: u8) -> void {
    const ignored = syscall1(SYS_exit, @intCast(usize, code))
}

pub fn setRobustList(head: usize, length: usize) -> isize {
    return syscall2(SYS_set_robust_list, head, length)
}

pub fn registerRestartableSequence(area: usize, length: usize, flags: usize, signature: usize) -> isize {
    return syscall4(SYS_rseq, area, length, flags, signature)
}
