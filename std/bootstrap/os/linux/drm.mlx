// DRM cards (<drm/drm.h>, <drm/drm_mode.h>, <drm/drm_fourcc.h> on 64-bit
// Linux): the ioctl requests of legacy modesetting with dumb buffers and
// PRIME, as the compositor's KMS output (and the splash's, through it)
// makes them, and the pixel formats and modifiers buffers are shared in.
// The structure layouts stay with their users.

// The card's master (the right to set modes).
pub const SET_MASTER: usize = 25630
pub const DROP_MASTER: usize = 25631
pub const GET_CAP: usize = 3222299660
pub const GETRESOURCES: usize = 3225445536
pub const GETCONNECTOR: usize = 3226494119
pub const GETENCODER: usize = 3222561958
pub const GETCRTC: usize = 3228066977
pub const SETCRTC: usize = 3228066978
pub const CREATE_DUMB: usize = 3223348402
pub const MAP_DUMB: usize = 3222299827
pub const DESTROY_DUMB: usize = 3221513396
pub const ADDFB: usize = 3223086254
pub const RMFB: usize = 3221513391
pub const PAGE_FLIP: usize = 3222824112
pub const PRIME_HANDLE_TO_FD: usize = 3222037549
pub const PRIME_FD_TO_HANDLE: usize = 3222037550
pub const GEM_CLOSE: usize = 1074291721
pub const CLOSEFB: usize = 3221775568
pub const GETGAMMA: usize = 3223348388
pub const SETGAMMA: usize = 3223348389
// PRIME_HANDLE_TO_FD's flags: DRM_CLOEXEC, DRM_RDWR.
pub const PRIME_CLOEXEC: u32 = 2147483648
pub const PRIME_RDWR: u32 = 2

pub const CAP_DUMB_BUFFER: usize = 1
pub const PAGE_FLIP_EVENT: u32 = 1
// The event read from the card when a flip is on screen.
pub const EVENT_FLIP_COMPLETE: u32 = 2
pub const MODE_TYPE_PREFERRED: u32 = 8
pub const MODE_FLAG_INTERLACE: u32 = 16
pub const MODE_FLAG_DOUBLESCAN: u32 = 32
// A connector's connection: DRM_MODE_CONNECTED.
pub const CONNECTED: u32 = 1
// struct drm_mode_modeinfo, struct drm_mode_crtc, a gamma entry.
pub const MODE_SIZE: usize = 68
pub const CRTC_SIZE: usize = 104
pub const LUT_SIZE: usize = 32

// Pixel formats (fourcc codes): 'AR24' and 'XR24'.
pub const FORMAT_ARGB8888: u32 = 875713089
pub const FORMAT_XRGB8888: u32 = 875713112
// DRM_FORMAT_MOD_INVALID, "the buffer's layout is implicit"
// (0x00ffffffffffffff), in the two halves Wayland's dma-buf protocol
// carries it.
pub const MODIFIER_INVALID_HI: u32 = 16777215
pub const MODIFIER_INVALID_LO: u32 = 4294967295
