// Framebuffer devices (<linux/fb.h>): what a /dev/fbN shows and how its
// memory is laid out, for the programs that draw on one without DRM (the
// console, the boot splash).

const mem = @import("../../mem.mlx")

pub extern("syscall") fn syscall3(number: usize, a1: usize, a2: usize, a3: usize) -> isize {}

const SYS_ioctl: usize = 16

pub const FBIOGET_VSCREENINFO: usize = 17920
pub const FBIOGET_FSCREENINFO: usize = 17922

// What a framebuffer shows: from struct fb_var_screeninfo (xres, yres,
// xres_virtual, yres_virtual, xoffset, yoffset, bits_per_pixel,
// grayscale, then the bitfields red, green, blue and transp: offset,
// length, msb_right) and struct fb_fix_screeninfo (id[16], smem_start,
// smem_len at 24, ..., line_length at 48).
pub const Screen = struct {
    width: usize
    height: usize
    xOffset: usize
    yOffset: usize
    bitsPerPixel: u32
    redOffset: u32
    // The bytes of memory to map, and of a line in it.
    memoryLength: usize
    lineLength: usize
}

// The screen of the framebuffer `descriptor`; false when it is none.
pub fn query(descriptor: isize, screen: *Screen) -> bool {
    var fixed: [128]u8 = undefined
    var variable: [192]u8 = undefined
    const fixed_bytes: [*]u8 = &fixed
    const variable_bytes: [*]u8 = &variable
    mem.zero(fixed_bytes, 128)
    mem.zero(variable_bytes, 192)
    if syscall3(SYS_ioctl, @bitCast(usize, descriptor), FBIOGET_FSCREENINFO, @intFromPtr(fixed_bytes)) < 0 { return false }
    if syscall3(SYS_ioctl, @bitCast(usize, descriptor), FBIOGET_VSCREENINFO, @intFromPtr(variable_bytes)) < 0 { return false }
    screen.*.width = @intCast(usize, mem.readU32Little(variable_bytes, 0))
    screen.*.height = @intCast(usize, mem.readU32Little(variable_bytes, 4))
    screen.*.xOffset = @intCast(usize, mem.readU32Little(variable_bytes, 16))
    screen.*.yOffset = @intCast(usize, mem.readU32Little(variable_bytes, 20))
    screen.*.bitsPerPixel = mem.readU32Little(variable_bytes, 24)
    screen.*.redOffset = mem.readU32Little(variable_bytes, 32)
    screen.*.memoryLength = @intCast(usize, mem.readU32Little(fixed_bytes, 24))
    screen.*.lineLength = @intCast(usize, mem.readU32Little(fixed_bytes, 48))
    return true
}

// Where the visible screen starts in the memory (32 bits per pixel).
pub fn start(screen: *const Screen) -> usize {
    return screen.*.yOffset * screen.*.lineLength + screen.*.xOffset * 4
}
