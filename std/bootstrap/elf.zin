pub const ELF_HEADER_SIZE: usize = 64
pub const PROGRAM_HEADER_SIZE: usize = 56
pub const IMAGE_BASE: u64 = 4194304

pub fn writeU16(destination: [*]u8, offset: usize, value: u16) -> void {
    destination[offset] = @intCast(u8, value)
    destination[offset + 1] = @intCast(u8, value >> 8)
}

pub fn writeU32(destination: [*]u8, offset: usize, value: u32) -> void {
    var index: usize = 0
    while index < 4 {
        destination[offset + index] = @intCast(u8, value >> @intCast(u6, index * 8))
        index += 1
    }
}

pub fn writeU64(destination: [*]u8, offset: usize, value: u64) -> void {
    var index: usize = 0
    while index < 8 {
        destination[offset + index] = @intCast(u8, value >> @intCast(u6, index * 8))
        index += 1
    }
}

// Writes an ELF64 executable header and one RX PT_LOAD program header.
// Returns the byte offset immediately following both headers.
pub fn writeExecutableHeaders(destination: [*]u8, entry: u64, image_size: u64) -> usize {
    var index: usize = 0
    while index < ELF_HEADER_SIZE + PROGRAM_HEADER_SIZE {
        destination[index] = 0
        index += 1
    }
    destination[0] = 127
    destination[1] = 69
    destination[2] = 76
    destination[3] = 70
    destination[4] = 2
    destination[5] = 1
    destination[6] = 1
    writeU16(destination, 16, 2)
    writeU16(destination, 18, 62)
    writeU32(destination, 20, 1)
    writeU64(destination, 24, entry)
    writeU64(destination, 32, @intCast(u64, ELF_HEADER_SIZE))
    writeU16(destination, 52, @intCast(u16, ELF_HEADER_SIZE))
    writeU16(destination, 54, @intCast(u16, PROGRAM_HEADER_SIZE))
    writeU16(destination, 56, 1)

    const program = ELF_HEADER_SIZE
    writeU32(destination, program, 1)
    writeU32(destination, program + 4, 5)
    writeU64(destination, program + 8, 0)
    writeU64(destination, program + 16, IMAGE_BASE)
    writeU64(destination, program + 24, IMAGE_BASE)
    writeU64(destination, program + 32, image_size)
    writeU64(destination, program + 40, image_size)
    writeU64(destination, program + 48, 4096)
    return ELF_HEADER_SIZE + PROGRAM_HEADER_SIZE
}
