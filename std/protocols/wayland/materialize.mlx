// Stage-1 standard-library bootstrap tool: materializes std.wayland from the
// canonical protocol XML in this directory.
//
//   materialize            parse, validate and (re)write std/src/wayland/generated
//   materialize --check    verify the committed generated modules are current
//
// Run from the repository root (see materialize.sh). Ordinary projects never
// run this tool; they import std.wayland.

const std = @import("std")
const protocol = @import("std.wayland.protocol")
const materialize = @import("std.wayland.materialize")

const ArrayList = std.array_list.ArrayList
const String = std.string.String

const PROTOCOL_COUNT: usize = 3

fn source(index: usize) -> []const u8 {
    if index == 0 { return "std/protocols/wayland/wayland.xml" }
    if index == 1 { return "std/protocols/wayland/xdg-shell.xml" }
    return "std/protocols/wayland/linux-dmabuf-v1.xml"
}

const Path = struct {
    bytes: [512]u8
    length: usize
}

fn pathReset(path: *Path) -> void { path.*.length = 0 }

fn pathAppend(path: *Path, text: []const u8) -> void {
    for byte in text {
        if path.*.length < 511 {
            path.*.bytes[path.*.length] = byte
            path.*.length += 1
        }
    }
}

fn pathAppendString(path: *Path, text: String) -> void {
    var index: usize = 0
    while index < text.length {
        if path.*.length < 511 {
            path.*.bytes[path.*.length] = text.pointer[index]
            path.*.length += 1
        }
        index += 1
    }
}

fn pathTerminate(path: *Path) -> [*]const u8 {
    path.*.bytes[path.*.length] = 0
    unsafe { return @ptrCast([*]const u8, path) }
}

fn say(text: []const u8) -> void {
    const ignored = std.io.writeAll(std.io.stderr(), text)
}

fn sayPath(path: *Path) -> void {
    unsafe { const ignored = std.io.writeAllBytes(std.io.stderr(), @ptrCast([*]const u8, path), path.*.length) }
}

fn sayString(text: String) -> void {
    const ignored = std.io.writeString(std.io.stderr(), text)
}

fn readFile(path: [*]const u8, allocator: std.allocator.Allocator, result: *ArrayList) -> bool {
    const file = std.fs.open(path, 0, 0)
    if !std.fs.isValid(file) { return false }
    result.* = std.fs.readToEndAlloc(file, allocator)
    const closed = std.fs.close(file)
    return true
}

// Writes `contents` to `path`, or in check mode compares them. Returns
// false on an I/O failure or (check mode) a difference.
fn store(path: *Path, contents: *const ArrayList, check: bool, allocator: std.allocator.Allocator) -> bool {
    const terminated = pathTerminate(path)
    if check {
        var existing: ArrayList = undefined
        if !readFile(terminated, allocator, &existing) {
            say("missing generated module: ")
            sayPath(path)
            say("\n")
            return false
        }
        var same = existing.length == contents.*.length
        var index: usize = 0
        while same && index < existing.length {
            if existing.items[index] != contents.*.items[index] { same = false }
            index += 1
        }
        ArrayList.deinit(existing)
        if !same {
            say("stale generated module: ")
            sayPath(path)
            say("\n")
        }
        return same
    }
    const file = std.fs.open(terminated, 577, 420)
    if !std.fs.isValid(file) {
        say("cannot write ")
        sayPath(path)
        say("\n")
        return false
    }
    const written = std.fs.writeAllBytes(file, contents.*.items, contents.*.length)
    const closed = std.fs.close(file)
    return written
}

fn generatedPath(path: *Path, protocol_name: String, file_name: String, has_file: bool) -> void {
    pathReset(path)
    pathAppend(path, "std/src/wayland/generated/")
    pathAppendString(path, protocol_name)
    if has_file {
        pathAppend(path, "/")
        pathAppendString(path, file_name)
    }
    pathAppend(path, ".mlx")
}

pub fn main(arguments: [][*]const u8) -> u8 {
    const allocator = std.page_allocator.init()
    var check = false
    if std.process.count(arguments) > 1 {
        const flag = std.process.argument(arguments, 1)
        if std.string.eql(flag, std.string.fromSlice("--check")) {
            check = true
        } else {
            say("usage: materialize [--check]\n")
            return 2
        }
    }

    const memory = allocator.alloc(PROTOCOL_COUNT * @sizeOf(protocol.Protocol), 16)
    if memory == null { return 1 }
    var protocols: [*]protocol.Protocol = undefined
    unsafe { protocols = @ptrCast([*]protocol.Protocol, memory.?) }
    var index: usize = 0
    while index < PROTOCOL_COUNT {
        var contents: ArrayList = undefined
        var path: Path = undefined
        pathReset(&path)
        pathAppend(&path, source(index))
        if !readFile(pathTerminate(&path), allocator, &contents) {
            say("cannot read ")
            sayPath(&path)
            say("\n")
            return 1
        }
        var diagnostic: protocol.Diagnostic = undefined
        var target: *protocol.Protocol = undefined
        unsafe { target = @ptrFromInt(*protocol.Protocol, @intFromPtr(protocols) + index * @sizeOf(protocol.Protocol)) }
        if !protocol.parse(target, allocator, contents.items, contents.length, &diagnostic) {
            sayPath(&path)
            say(":")
            const line = std.io.writeUnsigned(std.io.stderr(), diagnostic.line)
            say(":")
            const column = std.io.writeUnsigned(std.io.stderr(), diagnostic.column)
            say(": error: ")
            say(protocol.errorMessage(diagnostic.kind))
            say("\n")
            return 1
        }
        index += 1
    }

    var failure: materialize.Failure = undefined
    failure.failed = false
    var set: materialize.Set = undefined
    set.protocols = protocols
    set.count = PROTOCOL_COUNT
    set.failure = &failure
    if !materialize.validate(&set) {
        say("materialize: ")
        sayString(failure.protocolName)
        say(": ")
        sayString(failure.subject)
        say(": ")
        say(failure.message)
        say("\n")
        return 1
    }

    if !check {
        unsafe { const made = std.fs.makeDir(@ptrCast([*]const u8, "std/src/wayland/generated"), 493) }
    }
    var ok = true
    var path: Path = undefined
    var out = ArrayList.init(allocator, 1 << 20)
    const ignored = materialize.emitInterfaces(&set, &out)
    generatedPath(&path, std.string.fromSlice("interfaces"), std.string.fromSlice(""), false)
    if !store(&path, &out, check, allocator) { ok = false }

    index = 0
    while index < PROTOCOL_COUNT {
        var current: *protocol.Protocol = undefined
        unsafe { current = @ptrFromInt(*protocol.Protocol, @intFromPtr(protocols) + index * @sizeOf(protocol.Protocol)) }
        if !check {
            pathReset(&path)
            pathAppend(&path, "std/src/wayland/generated/")
            pathAppendString(&path, current.*.name)
            const made = std.fs.makeDir(pathTerminate(&path), 493)
        }
        out = ArrayList.clear(out)
        const facade = materialize.emitFacade(&set, index, &out)
        generatedPath(&path, current.*.name, std.string.fromSlice(""), false)
        if !store(&path, &out, check, allocator) { ok = false }

        out = ArrayList.clear(out)
        const types = materialize.emitTypes(&set, index, &out)
        generatedPath(&path, current.*.name, std.string.fromSlice("types"), true)
        if !store(&path, &out, check, allocator) { ok = false }

        var interface_index: usize = 0
        while interface_index < protocol.interfaceCount(current) {
            out = ArrayList.clear(out)
            const emitted = materialize.emitInterface(&set, index, interface_index, &out)
            generatedPath(&path, current.*.name, protocol.interfaceAt(current, interface_index).*.name, true)
            if !store(&path, &out, check, allocator) { ok = false }
            interface_index += 1
        }
        index += 1
    }
    if !ok { return 1 }
    if check {
        say("std.wayland generated modules are current\n")
    } else {
        say("materialized std.wayland into std/src/wayland/generated\n")
    }
    return 0
}
