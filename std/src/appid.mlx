// Which app a process is, as the desktop names apps (MLXIPC's permissions,
// MLX Audio's settings per app): a Flatpak app's id (from
// /proc/PID/root/.flatpak-info; it then runs sandboxed), else its
// program's file name (/proc/PID/exe; without a "-bin" at its end).
//
//     var name: [128]u8 = undefined
//     var sandboxed = false
//     const length = appid.identify(pid, &name, 128, &sandboxed)
const std = @import("std")

fn advance(bytes: [*]u8, count: usize) -> [*]u8 {
    return bytes + count
}

// Reads the file at `path` (NUL-terminated) into `buffer`: its length, 0
// when it is not there or empty.
pub fn readFile(path: [*]const u8, buffer: [*]u8, capacity: usize) -> usize {
    const file = std.fs.open(path, 524288, 0)
    if file.descriptor < 0 { return 0 }
    var length: usize = 0
    while length < capacity {
        const got = std.fs.read(file, advance(buffer, length), capacity - length)
        if got <= 0 { break }
        length += @intCast(usize, got)
    }
    _ = std.fs.close(file)
    return length
}

// "/proc/PID/" followed by `rest`, NUL-terminated, into `path`.
pub fn procPath(path: [*]u8, pid: u32, rest: []const u8) -> void {
    var length = std.text.append(path, 0, 6, "/proc/")
    var digits: [12]u8 = undefined
    var count: usize = 0
    var value = pid
    while true {
        digits[count] = @intCast(u8, 48 + value % 10)
        count += 1
        value = value / 10
        if value == 0 { break }
    }
    while count > 0 {
        count -= 1
        path[length] = digits[count]
        length += 1
    }
    path[length] = 47
    length += 1
    length += std.text.append(advance(path, length), 0, 200, rest)
    path[length] = 0
}

// The app process `pid` is, into `out` (at most `capacity` bytes): its
// length. `sandboxed` says whether it runs in a Flatpak sandbox.
// "unknown" when the process cannot be read.
pub fn identify(pid: u32, out: [*]u8, capacity: usize, sandboxed: *bool) -> usize {
    sandboxed.* = false
    if pid == 0 { return std.text.append(out, 0, capacity, "unknown") }
    var path: [256]u8 = undefined
    const path_bytes: [*]u8 = &path
    // A Flatpak app: [Application] name=ID.
    var info: [4096]u8 = undefined
    const info_bytes: [*]u8 = &info
    procPath(path_bytes, pid, "root/.flatpak-info")
    const length = readFile(path_bytes, info_bytes, 4096)
    if length > 0 {
        sandboxed.* = true
        var line: usize = 0
        while line < length {
            var end = line
            while end < length && info[end] != 10 { end += 1 }
            const text = info_bytes[line..end]
            if text.length > 5 && std.text.same(text[0..5], "name=") { return std.text.append(out, 0, capacity, text[5..text.length]) }
            line = end + 1
        }
        // Sandboxed, and no id: an app of its own nobody can name.
        return std.text.append(out, 0, capacity, "flatpak")
    }
    var target: [512]u8 = undefined
    const target_bytes: [*]u8 = &target
    procPath(path_bytes, pid, "exe")
    const linked = std.fs.readLink(path_bytes, target_bytes, 512)
    if linked <= 0 { return std.text.append(out, 0, capacity, "unknown") }
    var end = @intCast(usize, linked)
    // A replaced program: "/usr/bin/obs (deleted)".
    if end > 10 && std.text.same(target_bytes[end - 10..end], " (deleted)") { end -= 10 }
    var start = end
    while start > 0 && target[start - 1] != 47 { start -= 1 }
    // A program's real binary beside its launcher: "firefox-bin" is
    // firefox.
    if end - start > 4 && std.text.same(target_bytes[end - 4..end], "-bin") { end -= 4 }
    if start == end { return std.text.append(out, 0, capacity, "unknown") }
    return std.text.append(out, 0, capacity, target_bytes[start..end])
}
