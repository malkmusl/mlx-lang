// std.sql: an SQLite-compatible database engine in Mlx: SQLite's file
// format (B-tree pages, records, the rollback journal, its locks), the
// SQL that WebKit and its tests use (std.sql.parser), its query planning
// and evaluation (std.sql.query, std.sql.eval), and connections and
// statements (std.sql.engine) as SQLite's C API presents them;
// compiler/libc/sqlite3 is that C API over this module.
//
//     const sql = @import("std.sql")
//     sql.use(allocator)
//     var db: usize = 0
//     _ = sql.engine.open("app.db", sql.engine.OPEN_READWRITE | sql.engine.OPEN_CREATE, &db)
//
// The parts: mem (memory and bytes), numbers (SQLite's number texts),
// value (SQL values), record (records and varints), os (files, locks,
// mutexes), pager (the page cache and journal), btree (tables and
// indexes), lexer, ast and parser (SQL), schema, core (the shared
// structures and result codes), query and eval (SELECT and expressions),
// functions and dates (built-in functions), write (INSERT, UPDATE,
// DELETE), ddl (CREATE, DROP, ALTER), pragma, vacuum, integrity, engine.
pub const mem = @import("./sql/mem.mlx")
pub const numbers = @import("./sql/numbers.mlx")
pub const value = @import("./sql/value.mlx")
pub const record = @import("./sql/record.mlx")
pub const os = @import("./sql/os.mlx")
pub const pager = @import("./sql/pager.mlx")
pub const btree = @import("./sql/btree.mlx")
pub const core = @import("./sql/core.mlx")
pub const engine = @import("./sql/engine.mlx")
pub const functions = @import("./sql/functions.mlx")

pub const Allocator = mem.Allocator

// The allocator the engine takes its memory from (once, before use).
pub fn use(allocator: Allocator) -> void { mem.use(allocator) }
