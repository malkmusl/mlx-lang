// Fills `table` through vkGetInstanceProcAddr (with a null instance).
pub fn loadGlobalCommands(table: *GlobalCommands, getInstanceProcAddr: usize) -> void {
    var get: PFN_vkGetInstanceProcAddr = undefined
    unsafe {
        get = @ptrFromInt(PFN_vkGetInstanceProcAddr, getInstanceProcAddr)
        table.*.vkGetInstanceProcAddr = getInstanceProcAddr
        table.*.vkCreateInstance = get(0, @ptrCast([*]const u8, "vkCreateInstance"))
        table.*.vkEnumerateInstanceVersion = get(0, @ptrCast([*]const u8, "vkEnumerateInstanceVersion"))
        table.*.vkEnumerateInstanceLayerProperties = get(0, @ptrCast([*]const u8, "vkEnumerateInstanceLayerProperties"))
        table.*.vkEnumerateInstanceExtensionProperties = get(0, @ptrCast([*]const u8, "vkEnumerateInstanceExtensionProperties"))
    }
}

// The command names of InstanceCommands and DeviceCommands, in field order:
// per field the command's name and then the other names it has (the
// extension names implementations older than the core version may only
// provide), each followed by \0, and one more \0 after the field's last.

