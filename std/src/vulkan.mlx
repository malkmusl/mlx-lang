pub fn makeApiVersion(variant: u32, major: u32, minor: u32, patch: u32) -> u32 {
    return (variant << 29) | (major << 22) | (minor << 12) | patch
}

pub fn apiVersionVariant(version: u32) -> u32 { return version >> 29 }
pub fn apiVersionMajor(version: u32) -> u32 { return (version >> 22) & 127 }
pub fn apiVersionMinor(version: u32) -> u32 { return (version >> 12) & 1023 }
pub fn apiVersionPatch(version: u32) -> u32 { return version & 4095 }

