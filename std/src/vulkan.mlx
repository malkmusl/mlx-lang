// Fills the table `slots` (one usize field per command, in the order of
// `names`, above): each gets the first of its names `getProcAddr`
// (vkGetInstanceProcAddr or vkGetDeviceProcAddr) knows for `handle`, or 0.
fn loadCommandTable(slots: [*]usize, handle: usize, getProcAddr: usize, names: [*]const u8) -> void {
    var get: PFN_vkGetInstanceProcAddr = undefined
    unsafe { get = @ptrFromInt(PFN_vkGetInstanceProcAddr, getProcAddr) }
    var at: usize = 0
    var slot: usize = 0
    while names[at] != 0 {
        slots[slot] = 0
        while names[at] != 0 {
            if slots[slot] == 0 {
                unsafe { slots[slot] = get(handle, @ptrFromInt([*]const u8, @intFromPtr(names) + at)) }
            }
            while names[at] != 0 { at += 1 }
            at += 1
        }
        at += 1
        slot += 1
    }
}

// Fills `table` with the instance-level and physical-device-level commands
// of `instance`.
pub fn loadInstanceCommands(table: *InstanceCommands, instance: Instance, getInstanceProcAddr: usize) -> void {
    unsafe { loadCommandTable(@ptrCast([*]usize, table), instance, getInstanceProcAddr, @ptrCast([*]const u8, INSTANCE_COMMAND_NAMES)) }
}

// Fills `table` with the device-level commands of `device`, straight from
// its driver (vkGetDeviceProcAddr).
pub fn loadDeviceCommands(table: *DeviceCommands, device: Device, getDeviceProcAddr: usize) -> void {
    unsafe { loadCommandTable(@ptrCast([*]usize, table), device, getDeviceProcAddr, @ptrCast([*]const u8, DEVICE_COMMAND_NAMES)) }
}

// ---------------------------------------------------------------------------
// Commands: each takes the dispatch table holding it, then the C parameters.

pub fn createInstance(dispatch: *const GlobalCommands, pCreateInfo: *const InstanceCreateInfo, pAllocator: ?*const AllocationCallbacks, pInstance: *Instance) -> Result {
    var entry: PFN_vkCreateInstance = undefined
    unsafe { entry = @ptrFromInt(PFN_vkCreateInstance, dispatch.*.vkCreateInstance) }
    return entry(pCreateInfo, pAllocator, pInstance)
}

