pub const BaseOutStructure = struct {
    sType: StructureType
    pNext: ?*anyopaque

    pub fn init() -> Self {
        var value: Self = undefined
        unsafe { vulkan_mem.zero(@ptrCast([*]u8, &value), @sizeOf(Self)) }
        return value
    }
}

