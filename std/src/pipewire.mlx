// std.pipewire: the numbers of PipeWire's native protocol (version 3) that
// both ends of a connection need: MLX Capture's server
// (projects/desktop/capture), which answers as the PipeWire daemon would,
// and its client library (compiler/libc/pipewire, libpipewire-0.3). The
// values themselves are PODs (std.pipewire.pod).
//
// A message: the object's id (u32), the opcode (8 bits) and the payload's
// size (24 bits), a sequence number and the count of descriptors that came
// with it, then the payload, one Struct pod. Object 0 is the core, 1 the
// client; the client names the objects it creates. Methods go to the
// server, events come from it; each interface numbers both from its own 0
// or 1, as PipeWire's headers do.

pub const pod = @import("./pipewire/pod.mlx")

// The message header's size.
pub const HEADER: usize = 16

// An id that names nothing (SPA_ID_INVALID).
pub const INVALID: u32 = 4294967295

