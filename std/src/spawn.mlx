// std.spawn: starting programs. A child is described by Options (what
// runs, with which arguments and environment, and what the child does
// with its descriptors before execve), started with `start`, and waited
// for with `wait` or `ended`:
//
//     var options = spawn.options(path, argv, envp)
//     options.output = log            // its standard output (and errors)
//     options.errors = log
//     options.searchPath = true       // a name without a slash: in PATH
//     const child = spawn.start(&options)
//     if !child.started() { ... }
//     const ending = spawn.wait(child) // its exit code, or what ended it
//     const status = ending.status()   // as a shell's $?
//
// A Child is the operating system's: a pid on Linux, a process handle on
// brixOS (which spawns natively: process_spawn with exactly the handles
// given). Code that needs a pid for Linux's own calls takes child.pid().
//
// `startReading` hands back a pipe with what the child writes, and
// `capture` runs a program to its end with its output kept.
//
// The child is forked (or vforked with `shareMemory`, for a large parent:
// the child borrows its memory until execve, so only these system calls
// run in it). Everything the child does is here: descriptors moved and
// kept, its directory, a session of its own, its signals unblocked, the
// program found in PATH; a program that cannot run exits with 127, as a
// shell's would. Programs whose child does more (a pty's, a login's)
// fork themselves with std.linux.process.fork and run `execute`.
const std = @import("std")
const builtin = @import("builtin")
const platform = @import("std.platform")

const linux = std.linux
const process = std.linux.process
const brix = std.os.brix

// PATH when the environment has none (as execvp's; brixOS's programs are
// in /system/programs).
pub const DEFAULT_PATH: []const u8 = platform.PROGRAMS

// A detached brixOS child (process_launch gave no handle): started, and
// nothing to wait for.
pub const DETACHED: isize = 9223372036854775807

// A started program (or why it did not start: `id` negative).
pub const Child = struct {
    // Linux: the pid; brixOS: a process handle (a pid when the Linux
    // layer started it).
    id: isize
    // Whether `id` is a brixOS process handle.
    handle: bool

    pub fn started(self: Self) -> bool { return self.id > 0 }

    // The pid, for Linux's own calls (kill, waiting for any child); -1
    // for a brixOS handle.
    pub fn pid(self: Self) -> isize { return if self.handle { -1 } else { self.id } }

    pub fn none() -> Child { return Child.{ .id = -1, .handle = false } }
}

// How a child ended: its exit code, or what ended it (Linux: the
// signal's number; brixOS: the event's kind).
pub const Ending = struct {
    exited: bool
    code: usize

    // As a shell's $?: the exit code, or 128 plus what ended it.
    pub fn status(self: Self) -> usize { return if self.exited { self.code } else { 128 + self.code } }

    // The ending of a child that was none of ours (255).
    pub fn lost() -> Ending { return Ending.{ .exited = true, .code = 255 } }
}

pub const Options = struct {
    // The program (NUL-terminated), its NULL-terminated arguments (the
    // first is its name) and environment.
    program: [*]const u8
    arguments: [*][*]const u8
    environment: [*][*]const u8
    // A program named without a slash is looked up in the environment's
    // PATH (else in `defaultPath`; "": then it does not run).
    searchPath: bool
    defaultPath: []const u8
    // What the child gets as its standard input, output and errors (-1:
    // the parent's).
    input: isize
    output: isize
    errors: isize
    // A descriptor the child gets as `extraAt` (-1: none), as a socket's
    // end handed over at a number agreed on.
    extra: isize
    extraAt: isize
    // Descriptors kept open as they are across execve (FD_CLOEXEC
    // cleared; -1: none), and ones closed in the child first.
    keep: isize
    keepAlso: isize
    closing: isize
    closingAlso: isize
    // The child's working directory (NUL-terminated; null: the parent's).
    directory: ?[*]const u8
    // The child leads a session of its own (setsid).
    newSession: bool
    // The child starts with no signal blocked (its parent took some
    // through a signal descriptor).
    unblockSignals: bool
    // The program is no child of ours: an intermediate child starts it
    // and ends at once (reaped here), so nobody waits for the program.
    detach: bool
    // vfork rather than fork.
    shareMemory: bool
}

// Options that run `program` with `arguments` and `environment` and
// change nothing else.
pub fn options(program: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8) -> Options {
    return Options.{
        .program = program,
        .arguments = arguments,
        .environment = environment,
        .searchPath = false,
        .defaultPath = DEFAULT_PATH,
        .input = -1,
        .output = -1,
        .errors = -1,
        .extra = -1,
        .extraAt = -1,
        .keep = -1,
        .keepAlso = -1,
        .closing = -1,
        .closingAlso = -1,
        .directory = null,
        .newSession = false,
        .unblockSignals = false,
        .detach = false,
        .shareMemory = false,
    }
}

fn hasSlash(program: [*]const u8) -> bool {
    var index: usize = 0
    while program[index] != 0 {
        if program[index] == 47 { return true }
        index += 1
    }
    return false
}

// execve `program`, looked up in `path` (directories separated by ':')
// when it has no slash. Returns only when it could not run (in a child,
// before it exits).
pub fn executeIn(program: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8, path: []const u8) -> void {
    if hasSlash(program) {
        _ = process.execute(program, arguments, environment)
        return
    }
    var length: usize = 0
    while program[length] != 0 { length += 1 }
    var candidate: [1024]u8 = undefined
    const candidate_bytes: [*]u8 = &candidate
    var start: usize = 0
    while start <= path.length {
        var end = start
        while end < path.length && path[end] != 58 { end += 1 }
        if end > start && end - start + length + 2 < 1024 {
            var at = std.text.append(candidate_bytes, 0, end - start, path[start..end])
            candidate[at] = 47
            at += 1
            at = std.text.append(candidate_bytes, at, at + length, program[0..length])
            candidate[at] = 0
            _ = process.execute(candidate_bytes, arguments, environment)
        }
        start = end + 1
    }
}

// The same with the environment's PATH (`fallback` when it has none).
pub fn execute(program: [*]const u8, arguments: [*][*]const u8, environment: [*][*]const u8, fallback: []const u8) -> void {
    const found = std.process.environmentFrom(environment, "PATH")
    if found == null {
        executeIn(program, arguments, environment, fallback)
        return
    }
    const path = found.?
    executeIn(program, arguments, environment, std.string.asSlice(path))
}

// Where `name` runs from: itself when it has a slash, else the first
// directory of the environment's PATH (`fallback` when it has none) with
// an executable of that name. Its length in `into` (NUL-terminated), 0
// when there is none.
pub fn find(name: []const u8, environment: [*][*]const u8, fallback: []const u8, into: [*]u8, capacity: usize) -> usize {
    if name.length == 0 || name.length + 2 > capacity { return 0 }
    for byte in name {
        if byte == 47 {
            const length = std.text.append(into, 0, capacity - 1, name)
            into[length] = 0
            return length
        }
    }
    var path = fallback
    const found = std.process.environmentFrom(environment, "PATH")
    if found != null {
        const value = found.?
        path = std.string.asSlice(value)
    }
    var start: usize = 0
    while start <= path.length {
        var end = start
        while end < path.length && path[end] != 58 { end += 1 }
        if end > start && end - start + name.length + 2 <= capacity {
            var length = std.text.append(into, 0, capacity - 1, path[start..end])
            length = std.text.appendByte(into, length, capacity - 1, 47)
            length = std.text.append(into, length, capacity - 1, name)
            into[length] = 0
            if std.fs.access(into, std.fs.ACCESS_EXECUTE) { return length }
        }
        start = end + 1
    }
    return 0
}

// What the child does between fork and execve; it never returns.
fn child(spec: *const Options) -> void {
    if spec.*.closing >= 0 { linux.close(spec.*.closing) }
    if spec.*.closingAlso >= 0 { linux.close(spec.*.closingAlso) }
    if spec.*.unblockSignals { process.unblockAllSignals() }
    if spec.*.newSession { _ = process.setSession() }
    if spec.*.input >= 0 { _ = linux.dup2(spec.*.input, 0) }
    if spec.*.output >= 0 { _ = linux.dup2(spec.*.output, 1) }
    if spec.*.errors >= 0 { _ = linux.dup2(spec.*.errors, 2) }
    if spec.*.extra >= 0 && spec.*.extraAt >= 0 {
        // dup2 onto itself would leave FD_CLOEXEC set.
        if spec.*.extra == spec.*.extraAt {
            _ = linux.keepOnExec(spec.*.extra)
        } else {
            _ = linux.dup2(spec.*.extra, spec.*.extraAt)
        }
    }
    if spec.*.keep >= 0 { _ = linux.keepOnExec(spec.*.keep) }
    if spec.*.keepAlso >= 0 { _ = linux.keepOnExec(spec.*.keepAlso) }
    if spec.*.directory != null {
        const directory = spec.*.directory.?
        _ = linux.chdir(directory)
    }
    if spec.*.detach && process.fork() != 0 { linux.exitGroup(0) }
    if spec.*.searchPath {
        execute(spec.*.program, spec.*.arguments, spec.*.environment, spec.*.defaultPath)
    } else {
        _ = process.execute(spec.*.program, spec.*.arguments, spec.*.environment)
    }
    linux.exitGroup(127)
}

// Starts the child (with `detach`: the intermediate child, already
// reaped); not started(): its id is -errno.
pub fn start(spec: *const Options) -> Child {
    if comptime builtin.os == builtin.Os.brixos { return startNative(spec) }
    return Child.{ .id = startForked(spec), .handle = false }
}

// brixOS: process_launch, the program's node opened (found in PATH when
// asked), with exactly its input, output and errors and the descriptors
// it is to have at their numbers (extra, keep); others it lacks between
// are its errors' again. In `directory` when given; a new session is a
// group of its own without the caller's session; a detached child is
// nobody's (DETACHED: no handle to wait on). brixOS has no signal masks
// to undo (unblockSignals).
fn startNative(spec: *const Options) -> Child {
    var length: usize = 0
    while spec.*.program[length] != 0 { length += 1 }
    var found: [1024]u8 = undefined
    var program: []const u8 = spec.*.program[0..length]
    if spec.*.searchPath {
        const at = find(program, spec.*.environment, spec.*.defaultPath, &found, 1024)
        if at == 0 { return Child.{ .id = -2, .handle = true } }
        program = found[0..at]
    }
    const opened = brix.open(0, program, brix.Open.READ, 0)
    if opened < 0 { return Child.{ .id = opened, .handle = true } }
    const node = @intCast(u32, opened)
    var handles: [16]u32 = undefined
    handles[0] = brix.ofDescriptor(if spec.*.input >= 0 { spec.*.input } else { 0 })
    handles[1] = brix.ofDescriptor(if spec.*.output >= 0 { spec.*.output } else { 1 })
    handles[2] = brix.ofDescriptor(if spec.*.errors >= 0 { spec.*.errors } else { 2 })
    var count: usize = 3
    if spec.*.extra >= 0 && spec.*.extraAt >= 0 { count = place(&handles, count, spec.*.extraAt, spec.*.extra) }
    if spec.*.keep >= 0 { count = place(&handles, count, spec.*.keep, spec.*.keep) }
    if spec.*.keepAlso >= 0 { count = place(&handles, count, spec.*.keepAlso, spec.*.keepAlso) }
    // The roles: input, output and errors as placed, and our session
    // (when we have one) as the child's too.
    var roles: [4]brix.RoleRecord = undefined
    roles[0] = brix.RoleRecord.{ .role = brix.Role.INPUT, .handle = handles[0] }
    roles[1] = brix.RoleRecord.{ .role = brix.Role.OUTPUT, .handle = handles[1] }
    roles[2] = brix.RoleRecord.{ .role = brix.Role.ERRORS, .handle = handles[2] }
    var roleCount: usize = 3
    const session = if spec.*.newSession { @intCast(u32, 0) } else { brix.handleFor(brix.Role.SESSION) }
    if session != 0 && count < 16 {
        handles[count] = session
        count += 1
        roles[3] = brix.RoleRecord.{ .role = brix.Role.SESSION, .handle = session }
        roleCount = 4
    }
    const begin = brix.Start.{ .arguments = @intFromPtr(spec.*.arguments), .environment = @intFromPtr(spec.*.environment), .roles = @intFromPtr(&roles), .count = roleCount }
    var directory: u32 = 0
    if spec.*.directory != null {
        const where = spec.*.directory.?
        var where_length: usize = 0
        while where[where_length] != 0 { where_length += 1 }
        const opened_directory = brix.open(0, where[0..where_length], brix.Open.READ, 0)
        if opened_directory < 0 {
            _ = brix.close(node)
            return Child.{ .id = opened_directory, .handle = true }
        }
        directory = @intCast(u32, opened_directory)
    }
    var flags: usize = 0
    if spec.*.detach { flags |= brix.Launch.DETACHED }
    if spec.*.newSession { flags |= brix.Launch.OWN_GROUP }
    const spawned = brix.launch(node, &begin, handles[0..count], flags, directory)
    _ = brix.close(node)
    if directory != 0 { _ = brix.close(directory) }
    if spawned == 0 && spec.*.detach { return Child.{ .id = DETACHED, .handle = true } }
    return Child.{ .id = spawned, .handle = true }
}

// `descriptor`'s handle at `at` of the child's handles (the ones between
// filled with its errors'); the count.
fn place(handles: *[16]u32, count: usize, at: isize, descriptor: isize) -> usize {
    if at < 0 || at >= 16 { return count }
    const index = @bitCast(usize, at)
    var filled = count
    while filled < index {
        handles.*[filled] = handles.*[2]
        filled += 1
    }
    handles.*[index] = brix.ofDescriptor(descriptor)
    return if index + 1 > filled { index + 1 } else { filled }
}

fn startForked(spec: *const Options) -> isize {
    var pid: isize = 0
    if spec.*.shareMemory {
        pid = linux.syscall0(linux.SYS_vfork)
    } else {
        pid = process.fork()
    }
    if pid == 0 { child(spec) }
    if pid > 0 && spec.*.detach {
        var status: usize = 0
        _ = process.waitProcess(pid, &status, 0)
    }
    return pid
}

// Starts the child with its output (and its errors when `errors_too`)
// into a new pipe, whose read end (close-on-exec, and non-blocking when
// `nonblocking`) goes to `read_end`.
pub fn startReading(spec: *Options, errors_too: bool, nonblocking: bool, read_end: *isize) -> Child {
    var reading: isize = -1
    var writing: isize = -1
    if comptime builtin.os == builtin.Os.brixos {
        // A stream pair (the child's end not kept: process_launch hands
        // it over; reads of it wait).
        const made = std.fs.makePipe()
        if made == null { return Child.{ .id = -24, .handle = true } }
        reading = made.?.readDescriptor
        writing = made.?.writeDescriptor
    } else {
        const flags = if nonblocking { linux.O_CLOEXEC | linux.O_NONBLOCK } else { linux.O_CLOEXEC }
        if !linux.pipe(&reading, &writing, flags) { return Child.{ .id = linux.EMFILE, .handle = false } }
    }
    spec.*.output = writing
    if errors_too { spec.*.errors = writing }
    const child = start(spec)
    _ = std.fs.close(std.fs.File.{ .descriptor = writing })
    if !child.started() {
        _ = std.fs.close(std.fs.File.{ .descriptor = reading })
        return child
    }
    read_end.* = reading
    return child
}

// Waits for the child to end (Ending.lost() when it was none of ours).
pub fn wait(child: Child) -> Ending {
    if child.id == DETACHED { return Ending.lost() }
    if child.handle {
        var items: [1]brix.WaitItem = [1]brix.WaitItem{ brix.WaitItem.{ .handle = @intCast(u32, child.id), .want = brix.State.ENDED, .seen = 0, .reserved = 0 } }
        _ = brix.wait(items[0..1], brix.FOREVER)
        var ending = Ending.lost()
        _ = takeEnding(child, &ending)
        return ending
    }
    var raw: usize = 0
    if process.waitProcess(child.id, &raw, 0) != child.id { return Ending.lost() }
    return endingOf(raw)
}

// Whether the child has ended (then it is reaped, its ending in
// `ending`); false while it runs.
pub fn ended(child: Child, ending: *Ending) -> bool {
    if child.id == DETACHED {
        ending.* = Ending.lost()
        return true
    }
    if child.handle {
        if takeEnding(child, ending) { return true }
        // Gone (no handle any more): none of ours.
        var info = brix.Info.{ .kind = 0, .rights = 0, .state = 0, .reserved = 0 }
        if brix.info(@intCast(u32, child.id), &info) < 0 {
            ending.* = Ending.lost()
            return true
        }
        return false
    }
    var raw: usize = 0
    const waited = process.waitProcess(child.id, &raw, linux.WNOHANG)
    if waited == 0 { return false }
    ending.* = if waited == child.id { endingOf(raw) } else { Ending.lost() }
    return true
}

// A brixOS child's ending, taken (its stops and goings-on passed over),
// its handle closed then; false while it runs.
fn takeEnding(child: Child, ending: *Ending) -> bool {
    var change = brix.Change.{ .what = 0, .value = 0, .detail = 0, .reserved = 0 }
    while brix.change(@intCast(u32, child.id), &change) == 0 {
        if change.what == brix.Change.EXITED || change.what == brix.Change.ENDED {
            ending.* = Ending.{ .exited = change.what == brix.Change.EXITED, .code = @intCast(usize, change.value) }
            _ = brix.close(@intCast(u32, child.id))
            return true
        }
    }
    return false
}

// wait4's status word as an Ending.
fn endingOf(raw: usize) -> Ending {
    if raw & 0x7F == 0 { return Ending.{ .exited = true, .code = (raw >> 8) & 0xFF } }
    return Ending.{ .exited = false, .code = raw & 0x7F }
}

// Asks the child to end (SIGTERM; brixOS: the terminate event).
pub fn terminate(child: Child) -> bool {
    if child.id == DETACHED { return false }
    if child.handle { return brix.sendEvent(@intCast(u32, child.id), brix.Event.TERMINATE) == 0 }
    return process.kill(child.id, linux.SIGTERM) == 0
}

// Ends the child at once (SIGKILL; brixOS: the kill event).
pub fn kill(child: Child) -> bool {
    if child.id == DETACHED { return false }
    if child.handle { return brix.sendEvent(@intCast(u32, child.id), brix.Event.KILL) == 0 }
    return process.kill(child.id, linux.SIGKILL) == 0
}

// Runs the child to its end with its output (and its errors when
// `errors_too`) read into `into` (what does not fit is read and dropped):
// the bytes kept, how it ended in `ending`; -errno when it did not start.
pub fn capture(spec: *Options, errors_too: bool, into: [*]u8, capacity: usize, ending: *Ending) -> isize {
    var reading: isize = -1
    const child = startReading(spec, errors_too, false, &reading)
    if !child.started() { return child.id }
    var length: usize = 0
    var spare: [512]u8 = undefined
    while true {
        var got: isize = 0
        if length < capacity {
            got = std.fs.read(std.fs.File.{ .descriptor = reading }, into + length, capacity - length)
        } else {
            got = std.fs.read(std.fs.File.{ .descriptor = reading }, &spare, 512)
        }
        if got == -4 { continue }
        if got <= 0 { break }
        if length < capacity { length += @bitCast(usize, got) }
    }
    _ = std.fs.close(std.fs.File.{ .descriptor = reading })
    ending.* = wait(child)
    return @bitCast(isize, length)
}
