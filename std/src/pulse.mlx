// std.pulse: the numbers of PulseAudio's native protocol, for both ends of
// it: MLX Audio's server (projects/desktop/audio) and its client
// libraries (compiler/capi/pulse: libpulse, libpulse-simple, the ALSA
// plugin). The commands' bodies are tagstructs (std.pulse.tagstruct).
//
// A packet is a descriptor of five big-endian u32 (the payload's length,
// the channel: CONTROL for commands, else a stream's index; the offset's
// two halves; flags), then the payload. A command's payload is a
// tagstruct: the command, its tag (the reply says it again), its
// arguments.

pub const tagstruct = @import("./pulse/tagstruct.mlx")

// The protocol version spoken (PulseAudio 15 and later).
pub const VERSION: u32 = 35
// A packet's descriptor.
pub const DESCRIPTOR: usize = 20
// The channel of commands, and an index that names nothing.
pub const CONTROL: u32 = 4294967295
pub const INVALID: u32 = 4294967295

