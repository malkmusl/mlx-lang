// std.colorprofile.matrix: 3 x 3 matrices of doubles (row by row) and
// the colorimetry built of them, as Little CMS (2.14) computes it
// (cmsmtrx.c, cmswtpnt.c): inverses, products, the Bradford chromatic
// adaptation, the RGB to XYZ matrix of a white point and primaries.
// Each sum is formed in Little CMS's order, so that the doubles are the
// same to the bit.
const mem = @import("./mem.mlx")

pub fn identity(m: *[9]f64) -> void {
    var index: usize = 0
    while index < 9 {
        m.*[index] = if index == 0 || index == 4 || index == 8 { 1.0 } else { 0.0 }
        index += 1
    }
}

// _cmsMAT3isIdentity: within 1/65535 of the identity.
pub fn isIdentity(m: *[9]f64) -> bool {
    var index: usize = 0
    while index < 9 {
        const expected: f64 = if index == 0 || index == 4 || index == 8 { 1.0 } else { 0.0 }
        if !(mem.fabs(expected - m.*[index]) < (1.0 / 65535.0)) { return false }
        index += 1
    }
    return true
}

// _cmsMAT3per: R = A B.
pub fn multiply(r: *[9]f64, a: *[9]f64, b: *[9]f64) -> void {
    var result: [9]f64 = undefined
    var i: usize = 0
    while i < 3 {
        var j: usize = 0
        while j < 3 {
            result[i * 3 + j] = a.*[i * 3] * b.*[j] + a.*[i * 3 + 1] * b.*[3 + j] + a.*[i * 3 + 2] * b.*[6 + j]
            j += 1
        }
        i += 1
    }
    i = 0
    while i < 9 {
        r.*[i] = result[i]
        i += 1
    }
}

// _cmsMAT3inverse: false for a singular matrix.
pub fn inverse(a: *[9]f64, b: *[9]f64) -> bool {
    const c0 = a.*[4] * a.*[8] - a.*[5] * a.*[7]
    const c1 = -a.*[3] * a.*[8] + a.*[5] * a.*[6]
    const c2 = a.*[3] * a.*[7] - a.*[4] * a.*[6]
    const det = a.*[0] * c0 + a.*[1] * c1 + a.*[2] * c2
    if mem.fabs(det) < mem.MATRIX_DET_TOLERANCE { return false }
    var r: [9]f64 = undefined
    r[0] = c0 / det
    r[1] = (a.*[2] * a.*[7] - a.*[1] * a.*[8]) / det
    r[2] = (a.*[1] * a.*[5] - a.*[2] * a.*[4]) / det
    r[3] = c1 / det
    r[4] = (a.*[0] * a.*[8] - a.*[2] * a.*[6]) / det
    r[5] = (a.*[2] * a.*[3] - a.*[0] * a.*[5]) / det
    r[6] = c2 / det
    r[7] = (a.*[1] * a.*[6] - a.*[0] * a.*[7]) / det
    r[8] = (a.*[0] * a.*[4] - a.*[1] * a.*[3]) / det
    var index: usize = 0
    while index < 9 {
        b.*[index] = r[index]
        index += 1
    }
    return true
}

// _cmsMAT3eval: R = A V.
pub fn apply(r: *[3]f64, a: *[9]f64, v: *[3]f64) -> void {
    const x = a.*[0] * v.*[0] + a.*[1] * v.*[1] + a.*[2] * v.*[2]
    const y = a.*[3] * v.*[0] + a.*[4] * v.*[1] + a.*[5] * v.*[2]
    const z = a.*[6] * v.*[0] + a.*[7] * v.*[1] + a.*[8] * v.*[2]
    r.*[0] = x
    r.*[1] = y
    r.*[2] = z
}

// cmsxyY2XYZ.
pub fn xyYToXYZ(x: f64, y: f64, bigY: f64, out: *[3]f64) -> void {
    out.*[0] = (x / y) * bigY
    out.*[1] = bigY
    out.*[2] = ((1.0 - x - y) / y) * bigY
}

// cmsXYZ2xyY.
pub fn xyzToxyY(x: f64, y: f64, z: f64, out: *[3]f64) -> void {
    const d = 1.0 / (x + y + z)
    out.*[0] = x * d
    out.*[1] = y * d
    out.*[2] = y
}

fn bradford(m: *[9]f64) -> void {
    m.*[0] = 0.8951
    m.*[1] = 0.2664
    m.*[2] = -0.1614
    m.*[3] = -0.7502
    m.*[4] = 1.7135
    m.*[5] = 0.0367
    m.*[6] = 0.0389
    m.*[7] = -0.0685
    m.*[8] = 1.0296
}

// _cmsAdaptationMatrix with the Bradford cone matrix
// (ComputeChromaticAdaptation): FROM's white to TO's.
pub fn adaptationMatrix(r: *[9]f64, from: *[3]f64, to: *[3]f64) -> bool {
    var chad: [9]f64 = undefined
    bradford(&chad)
    var chadInverse: [9]f64 = undefined
    if !inverse(&chad, &chadInverse) { return false }
    var sourceRGB: [3]f64 = undefined
    var destRGB: [3]f64 = undefined
    apply(&sourceRGB, &chad, from)
    apply(&destRGB, &chad, to)
    var cone: [9]f64 = undefined
    cone[0] = destRGB[0] / sourceRGB[0]
    cone[1] = 0.0
    cone[2] = 0.0
    cone[3] = 0.0
    cone[4] = destRGB[1] / sourceRGB[1]
    cone[5] = 0.0
    cone[6] = 0.0
    cone[7] = 0.0
    cone[8] = destRGB[2] / sourceRGB[2]
    var tmp: [9]f64 = undefined
    multiply(&tmp, &cone, &chad)
    multiply(r, &chadInverse, &tmp)
    return true
}

// _cmsBuildRGB2XYZtransferMatrix: the colorants of the white point (XN,
// YN) and the primaries P (red, green, blue: x, y, Y each), adapted to
// D50 (_cmsAdaptMatrixToD50).
pub fn rgbToXYZTransferMatrix(r: *[9]f64, xn: f64, yn: f64, p: [*]const f64) -> bool {
    const xr = p[0]
    const yr = p[1]
    const xg = p[3]
    const yg = p[4]
    const xb = p[6]
    const yb = p[7]
    var primaries: [9]f64 = undefined
    primaries[0] = xr
    primaries[1] = xg
    primaries[2] = xb
    primaries[3] = yr
    primaries[4] = yg
    primaries[5] = yb
    primaries[6] = 1.0 - xr - yr
    primaries[7] = 1.0 - xg - yg
    primaries[8] = 1.0 - xb - yb
    var result: [9]f64 = undefined
    if !inverse(&primaries, &result) { return false }
    var white: [3]f64 = undefined
    white[0] = xn / yn
    white[1] = 1.0
    white[2] = (1.0 - xn - yn) / yn
    var coef: [3]f64 = undefined
    apply(&coef, &result, &white)
    r.*[0] = coef[0] * xr
    r.*[1] = coef[1] * xg
    r.*[2] = coef[2] * xb
    r.*[3] = coef[0] * yr
    r.*[4] = coef[1] * yg
    r.*[5] = coef[2] * yb
    r.*[6] = coef[0] * (1.0 - xr - yr)
    r.*[7] = coef[1] * (1.0 - xg - yg)
    r.*[8] = coef[2] * (1.0 - xb - yb)
    var dn: [3]f64 = undefined
    xyYToXYZ(xn, yn, 1.0, &dn)
    var d50: [3]f64 = undefined
    d50[0] = mem.D50X
    d50[1] = mem.D50Y
    d50[2] = mem.D50Z
    var adapt: [9]f64 = undefined
    if !adaptationMatrix(&adapt, &dn, &d50) { return false }
    var tmp: [9]f64 = undefined
    var index: usize = 0
    while index < 9 {
        tmp[index] = r.*[index]
        index += 1
    }
    multiply(r, &adapt, &tmp)
    return true
}
