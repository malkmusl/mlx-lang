// std.colorprofile.mem: what the parts of std.colorprofile share: memory
// by address (the profiles, curves, pipelines and transforms are blocks
// of an Allocator, as Little CMS's are blocks of its context's malloc),
// the numbers Little CMS rounds and saturates its way, and the 32-bit
// arithmetic its interpolators wrap in.
//
// Arithmetic is done in 64-bit words (i64, u64, usize) and narrowed only
// where memory holds it narrower: a narrow integer in a register is not
// cut to its width by every operation.
const allocator_module = @import("../../bootstrap/allocator.mlx")
const bmem = @import("../../bootstrap/mem.mlx")

pub const Allocator = allocator_module.Allocator

pub inline fn bytes(address: usize) -> [*]u8 { return unsafe { @ptrFromInt([*]u8, address) } }
pub inline fn shorts(address: usize) -> [*]u16 { return unsafe { @ptrFromInt([*]u16, address) } }
pub inline fn floats(address: usize) -> [*]f32 { return unsafe { @ptrFromInt([*]f32, address) } }
pub inline fn doubles(address: usize) -> [*]f64 { return unsafe { @ptrFromInt([*]f64, address) } }
pub inline fn words(address: usize) -> [*]usize { return unsafe { @ptrFromInt([*]usize, address) } }
pub inline fn ints(address: usize) -> [*]i64 { return unsafe { @ptrFromInt([*]i64, address) } }

pub inline fn get8(address: usize) -> u64 { unsafe { return @intCast(u64, @ptrFromInt(*u8, address).*) } }
pub inline fn put8(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u8, address).* = @intCast(u8, value & 255) } }
pub inline fn get16(address: usize) -> u64 { unsafe { return @intCast(u64, @ptrFromInt(*u16, address).*) } }
pub inline fn put16(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u16, address).* = @intCast(u16, value & 0xffff) } }
pub inline fn get32(address: usize) -> u64 { unsafe { return @intCast(u64, @ptrFromInt(*u32, address).*) } }
pub inline fn put32(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u32, address).* = @intCast(u32, value & 0xffffffff) } }
pub inline fn get64(address: usize) -> u64 { unsafe { return @ptrFromInt(*u64, address).* } }
pub inline fn put64(address: usize, value: u64) -> void { unsafe { @ptrFromInt(*u64, address).* = value } }
pub inline fn getF32(address: usize) -> f32 { unsafe { return @ptrFromInt(*f32, address).* } }
pub inline fn putF32(address: usize, value: f32) -> void { unsafe { @ptrFromInt(*f32, address).* = value } }
pub inline fn getF64(address: usize) -> f64 { unsafe { return @ptrFromInt(*f64, address).* } }
pub inline fn putF64(address: usize, value: f64) -> void { unsafe { @ptrFromInt(*f64, address).* = value } }

// Big-endian numbers, as ICC profiles hold them.
pub fn getBE16(address: usize) -> u64 { return (get8(address) << 8) | get8(address + 1) }
pub fn getBE32(address: usize) -> u64 { return (getBE16(address) << 16) | getBE16(address + 2) }
pub fn putBE16(address: usize, value: u64) -> void {
    put8(address, (value >> 8) & 255)
    put8(address + 1, value & 255)
}
pub fn putBE32(address: usize, value: u64) -> void {
    putBE16(address, (value >> 16) & 0xffff)
    putBE16(address + 2, value & 0xffff)
}

pub fn copy(target: usize, source: usize, count: usize) -> void {
    if count != 0 { bmem.copy(bytes(target), bytes(source), count) }
}

// A copy between places that may overlap.
pub fn move(target: usize, source: usize, count: usize) -> void {
    if count == 0 { return }
    if target <= source || target >= source + count {
        bmem.copy(bytes(target), bytes(source), count)
    } else {
        bmem.copyBackwards(bytes(target), bytes(source), count)
    }
}

pub fn zero(target: usize, count: usize) -> void {
    if count != 0 { bmem.zero(bytes(target), count) }
}

// SIZE bytes, 16-byte aligned and zeroed; 0 when there are none. Every
// block remembers its size in the 16 bytes before it, so that `release`
// needs only the address (as free does).
pub fn allocate(allocator: Allocator, size: usize) -> usize {
    const memory = allocator.alloc(size + 16, 16)
    if memory == null { return 0 }
    const address = @intFromPtr(memory.?)
    zero(address, size + 16)
    put64(address, @intCast(u64, size))
    return address + 16
}

pub fn release(allocator: Allocator, address: usize) -> void {
    if address == 0 { return }
    const size = @intCast(usize, get64(address - 16))
    allocator.free(bytes(address - 16), size + 16, 16)
}

pub fn sizeOf(address: usize) -> usize {
    if address == 0 { return 0 }
    return @intCast(usize, get64(address - 16))
}

// A copy of SIZE bytes at SOURCE in a block of its own (0 for none).
pub fn duplicate(allocator: Allocator, source: usize, size: usize) -> usize {
    if source == 0 { return 0 }
    const address = allocate(allocator, size)
    if address != 0 { copy(address, source, size) }
    return address
}

// ---------------------------------------------------------------------------
// Little CMS's numbers (lcms2_internal.h)

// 1 + 32767/32768: the largest XYZ a 16-bit PCS value encodes.
pub const MAX_ENCODEABLE_XYZ: f64 = 1.999969482421875
pub const D50X: f64 = 0.9642
pub const D50Y: f64 = 1.0
pub const D50Z: f64 = 0.8249
pub const MATRIX_DET_TOLERANCE: f64 = 0.0001

pub inline fn fabs(x: f64) -> f64 { return if x < 0.0 { -x } else { x } }

pub inline fn from8to16(value: u64) -> u64 { return ((value & 255) << 8) | (value & 255) }
pub inline fn from16to8(value: u64) -> u64 { return (((value & 0xffff) * 65281 + 8388608) >> 24) & 255 }

// _cmsQuickFloor: VAL rounded to 1/65536 and then down to a whole number,
// as Little CMS does it, through the low word of VAL + 1.5 * 2^36.
pub fn quickFloor(value: f64) -> i64 {
    const temp: f64 = value + 103079215104.0
    const low = @bitCast(u64, temp) & 0xffffffff
    var signed: i64 = @intCast(i64, low)
    if low >= 0x80000000 { signed = signed - 4294967296 }
    return signed >> 16
}

pub fn quickFloorWord(d: f64) -> u64 {
    const floor = quickFloor(d - 32767.0) + 32767
    return @intCast(u64, floor & 0xffff)
}

// _cmsQuickSaturateWord: D rounded to a 16-bit number, 0 and 65535 at the
// ends.
pub fn saturateWord(value: f64) -> u64 {
    const d = value + 0.5
    if d <= 0.0 { return 0 }
    if d >= 65535.0 { return 0xffff }
    return quickFloorWord(d)
}

// _cmsToFixedDomain: 0..0xffff onto 15.16 fixed point's 0..1.0.
pub inline fn toFixedDomain(a: i64) -> i64 { return a + (a + 0x7fff) / 0xffff }

// A 64-bit value wrapped to 32 bits and read as signed: what C's int
// arithmetic gives where it overflows.
pub inline fn wrap32(value: i64) -> i64 {
    const low = @bitCast(u64, value) & 0xffffffff
    var signed: i64 = @intCast(i64, low)
    if low >= 0x80000000 { signed = signed - 4294967296 }
    return signed
}

// _cmsQuantizeVal: sample I of MAX on 0..0xffff.
pub fn quantize(i: f64, max: usize) -> u64 {
    const x = (i * 65535.0) / @floatFromInt(f64, max - 1)
    return saturateWord(x)
}

pub inline fn f32of(value: f64) -> f32 { return @floatCast(f32, value) }
pub inline fn f64of(value: f32) -> f64 { return @floatCast(f64, value) }
