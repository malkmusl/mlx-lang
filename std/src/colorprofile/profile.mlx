// std.colorprofile.profile: ICC profiles (v2 and v4) as Little CMS
// (2.14) opens and reads them (cmsio0.c, cmstypes.c): the header, the
// tag directory (tags out of the file's bounds passed over, tags sharing
// their data linked, duplicates refused), and the tags a colour
// transform reads, each read once when first asked for: XYZ numbers
// (colorants, white point), tone curves (`curv`, `para`), the
// chromatic adaptation (`sf32`), and the LUT-based transforms (`mft1`,
// `mft2`, `mAB `, `mBA `) as pipelines. And the profiles Little CMS
// builds in memory (cmsvirt.c): RGB of a white point, primaries and
// curves (sRGB among them), and grey.
const mem = @import("./mem.mlx")
const curve = @import("./curve.mlx")
const pipeline = @import("./pipeline.mlx")
const matrix = @import("./matrix.mlx")

pub const Allocator = mem.Allocator

pub const MAX_TAGS: usize = 100

// Signatures (lcms2.h).
pub const MAGIC: u64 = 0x61637370
pub const CLASS_INPUT: u64 = 0x73636E72
pub const CLASS_DISPLAY: u64 = 0x6D6E7472
pub const CLASS_OUTPUT: u64 = 0x70727472
pub const CLASS_LINK: u64 = 0x6C696E6B
pub const CLASS_ABSTRACT: u64 = 0x61627374
pub const CLASS_COLORSPACE: u64 = 0x73706163
pub const CLASS_NAMED_COLOR: u64 = 0x6e6d636c

pub const SPACE_XYZ: u64 = 0x58595A20
pub const SPACE_LAB: u64 = 0x4C616220
pub const SPACE_RGB: u64 = 0x52474220
pub const SPACE_GRAY: u64 = 0x47524159
pub const SPACE_CMYK: u64 = 0x434D594B
pub const SPACE_CMY: u64 = 0x434D5920

pub const TAG_A2B0: u64 = 0x41324230
pub const TAG_A2B1: u64 = 0x41324231
pub const TAG_A2B2: u64 = 0x41324232
pub const TAG_B2A0: u64 = 0x42324130
pub const TAG_B2A1: u64 = 0x42324131
pub const TAG_B2A2: u64 = 0x42324132
pub const TAG_D2B0: u64 = 0x44324230
pub const TAG_D2B1: u64 = 0x44324231
pub const TAG_D2B2: u64 = 0x44324232
pub const TAG_D2B3: u64 = 0x44324233
pub const TAG_B2D0: u64 = 0x42324430
pub const TAG_B2D1: u64 = 0x42324431
pub const TAG_B2D2: u64 = 0x42324432
pub const TAG_B2D3: u64 = 0x42324433
pub const TAG_RED_COLORANT: u64 = 0x7258595A
pub const TAG_GREEN_COLORANT: u64 = 0x6758595A
pub const TAG_BLUE_COLORANT: u64 = 0x6258595A
pub const TAG_RED_TRC: u64 = 0x72545243
pub const TAG_GREEN_TRC: u64 = 0x67545243
pub const TAG_BLUE_TRC: u64 = 0x62545243
pub const TAG_GRAY_TRC: u64 = 0x6b545243
pub const TAG_MEDIA_WHITE_POINT: u64 = 0x77747074
pub const TAG_MEDIA_BLACK_POINT: u64 = 0x626B7074
pub const TAG_CHROMATIC_ADAPTATION: u64 = 0x63686164
pub const TAG_DESCRIPTION: u64 = 0x64657363
pub const TAG_COPYRIGHT: u64 = 0x63707274

pub const TYPE_CURVE: u64 = 0x63757276
pub const TYPE_PARAMETRIC_CURVE: u64 = 0x70617261
pub const TYPE_MONACO_BROKEN_CURVE: u64 = 0x9478ee00
pub const TYPE_XYZ: u64 = 0x58595A20
pub const TYPE_CORBIS_BROKEN_XYZ: u64 = 0x17A505B8
pub const TYPE_LUT16: u64 = 0x6d667432
pub const TYPE_LUT8: u64 = 0x6d667431
pub const TYPE_LUT_ATOB: u64 = 0x6d414220
pub const TYPE_LUT_BTOA: u64 = 0x6d424120
pub const TYPE_S15FIXED16_ARRAY: u64 = 0x73663332
pub const TYPE_MULTI_LOCALIZED_UNICODE: u64 = 0x6D6C7563
pub const TYPE_CHROMATICITY: u64 = 0x6368726D
pub const TAG_CHROMATICITY: u64 = 0x6368726D

// What a tag holds once read (or written).
pub const OBJECT_NONE: u64 = 0
pub const OBJECT_XYZ: u64 = 1
pub const OBJECT_CURVE: u64 = 2
pub const OBJECT_PIPELINE: u64 = 3
pub const OBJECT_DOUBLES: u64 = 4

pub const Profile = struct {
    allocator: Allocator
    // The file (a copy of it), 0 for a profile made in memory.
    data: usize
    size: usize
    deviceClass: u64
    colorSpace: u64
    pcs: u64
    renderingIntent: u64
    flags: u64
    manufacturer: u64
    model: u64
    creator: u64
    attributes: u64
    version: u64
    profileID: [16]u8
    tagCount: usize
    tagNames: [100]u64
    tagOffsets: [100]u64
    tagSizes: [100]u64
    tagLinked: [100]u64
    // The tag's object once read (or as written), its kind, and the type
    // it was read as (or is written as).
    tagObjects: [100]usize
    tagObjectKinds: [100]u64
    tagTypes: [100]u64
}

pub inline fn profileAt(address: usize) -> *Profile { return unsafe { @ptrFromInt(*Profile, address) } }

// ---------------------------------------------------------------------------
// Reading the file (the memory IO handler: reads past the end fail)

pub const Reader = struct {
    data: usize
    size: usize
    at: usize
    ok: bool
}

fn need(reader: *Reader, count: usize) -> bool {
    if !reader.*.ok { return false }
    if reader.*.at + count > reader.*.size {
        reader.*.ok = false
        return false
    }
    return true
}

fn seek(reader: *Reader, offset: u64) -> bool {
    if offset > @intCast(u64, reader.*.size) {
        reader.*.ok = false
        return false
    }
    reader.*.at = @intCast(usize, offset)
    reader.*.ok = true
    return true
}

fn read8(reader: *Reader) -> u64 {
    if !need(reader, 1) { return 0 }
    const value = mem.get8(reader.*.data + reader.*.at)
    reader.*.at += 1
    return value
}

fn read16(reader: *Reader) -> u64 {
    if !need(reader, 2) { return 0 }
    const value = mem.getBE16(reader.*.data + reader.*.at)
    reader.*.at += 2
    return value
}

fn read32(reader: *Reader) -> u64 {
    if !need(reader, 4) { return 0 }
    const value = mem.getBE32(reader.*.data + reader.*.at)
    reader.*.at += 4
    return value
}

// _cms15Fixed16toDouble.
pub fn fixed15ToDouble(word: u64) -> f64 {
    var fix: i64 = @intCast(i64, word & 0xffffffff)
    if fix >= 0x80000000 { fix = fix - 4294967296 }
    const sign: f64 = if fix < 0 { -1.0 } else { 1.0 }
    if fix < 0 { fix = -fix }
    const whole = (fix >> 16) & 0xffff
    const fraction = fix & 0xffff
    const mid = @floatFromInt(f64, fraction) / 65536.0
    const floater = @floatFromInt(f64, whole) + mid
    return sign * floater
}

fn readFixed15(reader: *Reader) -> f64 { return fixed15ToDouble(read32(reader)) }

// _cmsReadAlignment.
fn readAlignment(reader: *Reader) -> bool {
    const next = (reader.*.at + 3) & ~@intCast(usize, 3)
    const count = next - reader.*.at
    if count == 0 { return reader.*.ok }
    if !need(reader, count) { return false }
    reader.*.at = next
    return true
}

// ---------------------------------------------------------------------------
// Opening

// _validatedVersion on the header's version word (big-endian: the major
// version first).
fn validatedVersion(word: u64) -> u64 {
    var major = (word >> 24) & 255
    if major > 9 { major = 9 }
    var high = (word >> 16) & 0xf0
    var low = (word >> 16) & 0x0f
    if high > 0x90 { high = 0x90 }
    if low > 0x09 { low = 0x09 }
    return (major << 24) | ((high | low) << 16)
}

fn validClass(cl: u64) -> bool {
    if cl == 0 { return true }
    return cl == CLASS_INPUT || cl == CLASS_DISPLAY || cl == CLASS_OUTPUT || cl == CLASS_LINK || cl == CLASS_ABSTRACT || cl == CLASS_COLORSPACE || cl == CLASS_NAMED_COLOR
}

// The types a tag may have (0 terminated), its least element count;
// false for tags this module does not read.
fn descriptor(sig: u64, types: *[4]u64, count: *usize) -> bool {
    types.*[0] = 0
    types.*[1] = 0
    types.*[2] = 0
    types.*[3] = 0
    count.* = 1
    if sig == TAG_A2B0 || sig == TAG_A2B1 || sig == TAG_A2B2 {
        types.*[0] = TYPE_LUT16
        types.*[1] = TYPE_LUT_ATOB
        types.*[2] = TYPE_LUT8
        return true
    }
    if sig == TAG_B2A0 || sig == TAG_B2A1 || sig == TAG_B2A2 {
        types.*[0] = TYPE_LUT16
        types.*[1] = TYPE_LUT_BTOA
        types.*[2] = TYPE_LUT8
        return true
    }
    if sig == TAG_RED_COLORANT || sig == TAG_GREEN_COLORANT || sig == TAG_BLUE_COLORANT || sig == TAG_MEDIA_WHITE_POINT || sig == TAG_MEDIA_BLACK_POINT {
        types.*[0] = TYPE_XYZ
        types.*[1] = TYPE_CORBIS_BROKEN_XYZ
        return true
    }
    if sig == TAG_RED_TRC || sig == TAG_GREEN_TRC || sig == TAG_BLUE_TRC || sig == TAG_GRAY_TRC {
        types.*[0] = TYPE_CURVE
        types.*[1] = TYPE_PARAMETRIC_CURVE
        types.*[2] = TYPE_MONACO_BROKEN_CURVE
        return true
    }
    if sig == TAG_CHROMATIC_ADAPTATION {
        types.*[0] = TYPE_S15FIXED16_ARRAY
        count.* = 9
        return true
    }
    return false
}

fn sameDescriptor(a: u64, b: u64) -> bool {
    var typesA: [4]u64 = undefined
    var typesB: [4]u64 = undefined
    var countA: usize = 0
    var countB: usize = 0
    const knownA = descriptor(a, &typesA, &countA)
    const knownB = descriptor(b, &typesB, &countB)
    if !knownA || !knownB { return false }
    if countA != countB { return false }
    return typesA[0] == typesB[0] && typesA[1] == typesB[1] && typesA[2] == typesB[2]
}

fn emptyProfile(allocator: Allocator) -> usize {
    const address = mem.allocate(allocator, @sizeOf(Profile))
    if address == 0 { return 0 }
    const profile = profileAt(address)
    profile.*.allocator = allocator
    profile.*.version = 0x02100000
    profile.*.deviceClass = CLASS_DISPLAY
    return address
}

// cmsOpenProfileFromMem: the profile of SIZE bytes at DATA (copied); 0
// when it is no ICC profile Little CMS would open.
pub fn open(allocator: Allocator, data: usize, size: usize) -> usize {
    if data == 0 || size < 132 { return 0 }
    const address = emptyProfile(allocator)
    if address == 0 { return 0 }
    const profile = profileAt(address)
    profile.*.data = mem.duplicate(allocator, data, size)
    profile.*.size = size
    if profile.*.data == 0 {
        close(address)
        return 0
    }
    const base = profile.*.data
    if mem.getBE32(base + 36) != MAGIC {
        close(address)
        return 0
    }
    profile.*.deviceClass = mem.getBE32(base + 12)
    profile.*.colorSpace = mem.getBE32(base + 16)
    profile.*.pcs = mem.getBE32(base + 20)
    profile.*.renderingIntent = mem.getBE32(base + 64)
    profile.*.flags = mem.getBE32(base + 44)
    profile.*.manufacturer = mem.getBE32(base + 48)
    profile.*.model = mem.getBE32(base + 52)
    profile.*.creator = mem.getBE32(base + 80)
    profile.*.attributes = (mem.getBE32(base + 56) << 32) | mem.getBE32(base + 60)
    profile.*.version = validatedVersion(mem.getBE32(base + 8))
    var index: usize = 0
    while index < 16 {
        profile.*.profileID[index] = @intCast(u8, mem.get8(base + 84 + index))
        index += 1
    }
    if profile.*.version > 0x5000000 || !validClass(profile.*.deviceClass) {
        close(address)
        return 0
    }
    var headerSize = mem.getBE32(base)
    if headerSize >= @intCast(u64, size) { headerSize = @intCast(u64, size) }
    var reader = Reader.{ .data = base, .size = size, .at = 128, .ok = true }
    const tagCount = read32(&reader)
    if !reader.ok || tagCount > @intCast(u64, MAX_TAGS) {
        close(address)
        return 0
    }
    var tag: u64 = 0
    while tag < tagCount {
        const sig = read32(&reader)
        const offset = read32(&reader)
        const tagSize = read32(&reader)
        if !reader.ok {
            close(address)
            return 0
        }
        tag += 1
        if tagSize == 0 || offset == 0 { continue }
        if offset + tagSize > headerSize || ((offset + tagSize) & 0xffffffff) < offset { continue }
        const n = profile.*.tagCount
        profile.*.tagNames[n] = sig
        profile.*.tagOffsets[n] = offset
        profile.*.tagSizes[n] = tagSize
        profile.*.tagLinked[n] = 0
        var j: usize = 0
        while j < n {
            if profile.*.tagOffsets[j] == offset && profile.*.tagSizes[j] == tagSize {
                if sameDescriptor(profile.*.tagNames[j], sig) { profile.*.tagLinked[n] = profile.*.tagNames[j] }
            }
            j += 1
        }
        profile.*.tagCount = n + 1
    }
    var i: usize = 0
    while i < profile.*.tagCount {
        var j: usize = 0
        while j < profile.*.tagCount {
            if i != j && profile.*.tagNames[i] == profile.*.tagNames[j] {
                close(address)
                return 0
            }
            j += 1
        }
        i += 1
    }
    return address
}

fn freeObject(profile: *Profile, index: usize) -> void {
    const object = profile.*.tagObjects[index]
    const kind = profile.*.tagObjectKinds[index]
    if object != 0 {
        if kind == OBJECT_CURVE {
            curve.freeCurve(object)
        } else if kind == OBJECT_PIPELINE {
            pipeline.freePipeline(object)
        } else {
            mem.release(profile.*.allocator, object)
        }
    }
    profile.*.tagObjects[index] = 0
    profile.*.tagObjectKinds[index] = OBJECT_NONE
}

pub fn close(address: usize) -> void {
    if address == 0 { return }
    const profile = profileAt(address)
    var index: usize = 0
    while index < profile.*.tagCount {
        freeObject(profile, index)
        index += 1
    }
    mem.release(profile.*.allocator, profile.*.data)
    mem.release(profile.*.allocator, address)
}

// ---------------------------------------------------------------------------
// Tags

fn searchOne(profile: *Profile, sig: u64) -> i64 {
    var index: usize = 0
    while index < profile.*.tagCount {
        if profile.*.tagNames[index] == sig { return @intCast(i64, index) }
        index += 1
    }
    return -1
}

// _cmsSearchTag: the tag's index (following links), -1 when absent.
pub fn search(profile: *Profile, sig: u64, followLinks: bool) -> i64 {
    var name = sig
    while true {
        const n = searchOne(profile, name)
        if n < 0 { return -1 }
        if !followLinks { return n }
        const linked = profile.*.tagLinked[@intCast(usize, n)]
        if linked == 0 { return n }
        name = linked
    }
    return -1
}

pub fn isTag(profile: *Profile, sig: u64) -> bool { return search(profile, sig, false) >= 0 }

fn readXYZ(profile: *Profile, reader: *Reader) -> usize {
    const x = readFixed15(reader)
    const y = readFixed15(reader)
    const z = readFixed15(reader)
    if !reader.*.ok { return 0 }
    const address = mem.allocate(profile.*.allocator, 24)
    if address == 0 { return 0 }
    mem.doubles(address)[0] = x
    mem.doubles(address)[1] = y
    mem.doubles(address)[2] = z
    return address
}

// Type_Curve_Read: no entries (gamma 1), one (an 8.8 gamma), or a table.
fn readCurve(profile: *Profile, reader: *Reader) -> usize {
    const count = read32(reader)
    if !reader.*.ok { return 0 }
    const allocator = profile.*.allocator
    if count == 0 { return curve.buildGamma(allocator, 1.0) }
    if count == 1 {
        const fixed = read16(reader)
        if !reader.*.ok { return 0 }
        const gamma = @floatFromInt(f64, (fixed >> 8) & 255) + @floatFromInt(f64, fixed & 255) / 256.0
        return curve.buildGamma(allocator, gamma)
    }
    if count > 0x7fff { return 0 }
    const entries = @intCast(usize, count)
    const address = curve.buildTabulated16(allocator, entries, 0)
    if address == 0 { return 0 }
    const table = curve.tableOf(curve.curveAt(address))
    var index: usize = 0
    while index < entries {
        table[index] = @intCast(u16, read16(reader))
        index += 1
    }
    if !reader.*.ok {
        curve.freeCurve(address)
        return 0
    }
    return address
}

// Type_ParametricCurve_Read: the ICC's types 0 to 4 (Little CMS's 1 to 5).
fn readParametric(profile: *Profile, reader: *Reader) -> usize {
    const kind = read16(reader)
    const ignored = read16(reader)
    if !reader.*.ok || kind > 4 { return 0 }
    var params: [10]f64 = undefined
    var index: usize = 0
    while index < 10 {
        params[index] = 0.0
        index += 1
    }
    const count = curve.parameterCount(@intCast(i64, kind) + 1)
    index = 0
    while index < count {
        params[index] = readFixed15(reader)
        index += 1
    }
    if !reader.*.ok { return 0 }
    return curve.buildParametric(profile.*.allocator, @intCast(i64, kind) + 1, &params)
}

fn readTypeBase(reader: *Reader) -> u64 {
    const sig = read32(reader)
    const ignored = read32(reader)
    if !reader.*.ok { return 0 }
    return sig
}

fn readEmbeddedCurve(profile: *Profile, reader: *Reader) -> usize {
    const base = readTypeBase(reader)
    if base == TYPE_CURVE { return readCurve(profile, reader) }
    if base == TYPE_PARAMETRIC_CURVE { return readParametric(profile, reader) }
    return 0
}

// ReadSetOfCurves: COUNT curves at OFFSET, each aligned to 4 bytes.
fn readSetOfCurves(profile: *Profile, reader: *Reader, offset: u64, count: usize) -> usize {
    if count > pipeline.MAX_CHANNELS { return 0 }
    if !seek(reader, offset) { return 0 }
    var curves: [16]usize = undefined
    var index: usize = 0
    while index < 16 {
        curves[index] = 0
        index += 1
    }
    var stage: usize = 0
    var good = true
    index = 0
    while index < count {
        curves[index] = readEmbeddedCurve(profile, reader)
        if curves[index] == 0 || !readAlignment(reader) {
            good = false
            break
        }
        index += 1
    }
    if good { stage = pipeline.toneCurves(profile.*.allocator, count, @intCast(usize, @intFromPtr(&curves))) }
    index = 0
    while index < count {
        curve.freeCurve(curves[index])
        index += 1
    }
    return stage
}

// ReadMatrix: 3 x 3 and 3 offsets.
fn readMatrix(profile: *Profile, reader: *Reader, offset: u64) -> usize {
    if !seek(reader, offset) { return 0 }
    var values: [12]f64 = undefined
    var index: usize = 0
    while index < 12 {
        values[index] = readFixed15(reader)
        index += 1
    }
    if !reader.*.ok { return 0 }
    return pipeline.matrix(profile.*.allocator, 3, 3, @intFromPtr(&values), @intFromPtr(&values) + 72)
}

// ReadCLUT: the grid points of each input, the precision (1 or 2
// bytes), the entries.
fn readClut(profile: *Profile, reader: *Reader, offset: u64, inputs: usize, outputs: usize) -> usize {
    if !seek(reader, offset) { return 0 }
    var grid: [16]usize = undefined
    var index: usize = 0
    while index < 16 {
        grid[index] = @intCast(usize, read8(reader))
        if reader.*.ok && grid[index] == 1 { return 0 }
        index += 1
    }
    const precision = read8(reader)
    const pad1 = read8(reader)
    const pad2 = read8(reader)
    const pad3 = read8(reader)
    if !reader.*.ok { return 0 }
    const address = pipeline.clut16Granular(profile.*.allocator, &grid, inputs, outputs, 0)
    if address == 0 { return 0 }
    const stage = pipeline.stageAt(address)
    const table = mem.shorts(stage.*.clut.table)
    if precision == 1 {
        index = 0
        while index < stage.*.entries {
            table[index] = @intCast(u16, mem.from8to16(read8(reader)))
            index += 1
        }
    } else if precision == 2 {
        index = 0
        while index < stage.*.entries {
            table[index] = @intCast(u16, read16(reader))
            index += 1
        }
    } else {
        pipeline.freeStage(address)
        return 0
    }
    if !reader.*.ok {
        pipeline.freeStage(address)
        return 0
    }
    return address
}

// Type_LUTA2B_Read and Type_LUTB2A_Read: the elements whose offsets are
// not 0, in the order of the direction.
fn readLutAB(profile: *Profile, reader: *Reader, atoB: bool) -> usize {
    const base = @intCast(u64, reader.*.at - 8)
    const inputs = @intCast(usize, read8(reader))
    const outputs = @intCast(usize, read8(reader))
    const ignored = read16(reader)
    const offsetB = read32(reader)
    const offsetMat = read32(reader)
    const offsetM = read32(reader)
    const offsetC = read32(reader)
    const offsetA = read32(reader)
    if !reader.*.ok { return 0 }
    if inputs == 0 || inputs >= pipeline.MAX_CHANNELS { return 0 }
    if outputs == 0 || outputs >= pipeline.MAX_CHANNELS { return 0 }
    const address = pipeline.allocPipeline(profile.*.allocator, inputs, outputs)
    if address == 0 { return 0 }
    const pipe = pipeline.pipelineAt(address)
    var good = true
    if atoB {
        if good && offsetA != 0 { good = pipeline.insertStage(pipe, true, readSetOfCurves(profile, reader, base + offsetA, inputs)) }
        if good && offsetC != 0 { good = pipeline.insertStage(pipe, true, readClut(profile, reader, base + offsetC, inputs, outputs)) }
        if good && offsetM != 0 { good = pipeline.insertStage(pipe, true, readSetOfCurves(profile, reader, base + offsetM, outputs)) }
        if good && offsetMat != 0 { good = pipeline.insertStage(pipe, true, readMatrix(profile, reader, base + offsetMat)) }
        if good && offsetB != 0 { good = pipeline.insertStage(pipe, true, readSetOfCurves(profile, reader, base + offsetB, outputs)) }
    } else {
        if good && offsetB != 0 { good = pipeline.insertStage(pipe, true, readSetOfCurves(profile, reader, base + offsetB, inputs)) }
        if good && offsetMat != 0 { good = pipeline.insertStage(pipe, true, readMatrix(profile, reader, base + offsetMat)) }
        if good && offsetM != 0 { good = pipeline.insertStage(pipe, true, readSetOfCurves(profile, reader, base + offsetM, inputs)) }
        if good && offsetC != 0 { good = pipeline.insertStage(pipe, true, readClut(profile, reader, base + offsetC, inputs, outputs)) }
        if good && offsetA != 0 { good = pipeline.insertStage(pipe, true, readSetOfCurves(profile, reader, base + offsetA, outputs)) }
    }
    if !good {
        pipeline.freePipeline(address)
        return 0
    }
    return address
}

// uipow: N * A^B, 0xffffffff on overflow.
fn uipow(n: u64, a: u64, b: u64) -> u64 {
    if a == 0 || n == 0 { return 0 }
    var rv: u64 = 1
    var count = b
    while count > 0 {
        rv = rv * a
        if rv > 4294967295 / a { return 4294967295 }
        count -= 1
    }
    const rc = rv * n
    if rc > 4294967295 { return 4294967295 }
    return rc
}

// Read8bitTables and Read16bitTables: one curve a channel.
fn readTables(profile: *Profile, reader: *Reader, pipe: *pipeline.Pipeline, channels: usize, entries: usize, eightBit: bool) -> bool {
    if channels > pipeline.MAX_CHANNELS { return false }
    var curves: [16]usize = undefined
    var index: usize = 0
    while index < 16 {
        curves[index] = 0
        index += 1
    }
    var good = true
    index = 0
    while index < channels {
        curves[index] = curve.buildTabulated16(profile.*.allocator, entries, 0)
        if curves[index] == 0 {
            good = false
            break
        }
        const table = curve.tableOf(curve.curveAt(curves[index]))
        var j: usize = 0
        while j < entries {
            if eightBit {
                table[j] = @intCast(u16, mem.from8to16(read8(reader)))
            } else {
                table[j] = @intCast(u16, read16(reader))
            }
            j += 1
        }
        if !reader.*.ok {
            good = false
            break
        }
        index += 1
    }
    if good { good = pipeline.insertStage(pipe, true, pipeline.toneCurves(profile.*.allocator, channels, @intFromPtr(&curves))) }
    index = 0
    while index < channels {
        curve.freeCurve(curves[index])
        index += 1
    }
    return good
}

// Type_LUT8_Read and Type_LUT16_Read: the matrix (when not the identity
// and there are 3 inputs), the input tables, the grid, the output tables.
fn readLut(profile: *Profile, reader: *Reader, eightBit: bool) -> usize {
    const inputs = @intCast(usize, read8(reader))
    const outputs = @intCast(usize, read8(reader))
    const points = @intCast(usize, read8(reader))
    const ignored = read8(reader)
    if !reader.*.ok { return 0 }
    if eightBit && points == 1 { return 0 }
    if inputs == 0 || inputs > pipeline.MAX_CHANNELS { return 0 }
    if outputs == 0 || outputs > pipeline.MAX_CHANNELS { return 0 }
    const address = pipeline.allocPipeline(profile.*.allocator, inputs, outputs)
    if address == 0 { return 0 }
    const pipe = pipeline.pipelineAt(address)
    var m: [9]f64 = undefined
    var index: usize = 0
    while index < 9 {
        m[index] = readFixed15(reader)
        index += 1
    }
    if !reader.*.ok {
        pipeline.freePipeline(address)
        return 0
    }
    if inputs == 3 && !matrix.isIdentity(&m) {
        if !pipeline.insertStage(pipe, true, pipeline.matrix(profile.*.allocator, 3, 3, @intFromPtr(&m), 0)) {
            pipeline.freePipeline(address)
            return 0
        }
    }
    var inputEntries: usize = 256
    var outputEntries: usize = 256
    if !eightBit {
        inputEntries = @intCast(usize, read16(reader))
        outputEntries = @intCast(usize, read16(reader))
        if !reader.*.ok || inputEntries > 0x7fff || outputEntries > 0x7fff || points == 1 {
            pipeline.freePipeline(address)
            return 0
        }
    }
    var good = true
    if eightBit || inputEntries > 0 {
        if !eightBit && inputEntries < 2 { good = false } else { good = readTables(profile, reader, pipe, inputs, inputEntries, eightBit) }
    }
    if good {
        const size = uipow(@intCast(u64, outputs), @intCast(u64, points), @intCast(u64, inputs))
        if size == 4294967295 {
            good = false
        } else if size > 0 {
            const count = @intCast(usize, size)
            const table = mem.allocate(profile.*.allocator, count * 2)
            if table == 0 {
                good = false
            } else {
                const values = mem.shorts(table)
                index = 0
                while index < count {
                    if eightBit {
                        values[index] = @intCast(u16, mem.from8to16(read8(reader)))
                    } else {
                        values[index] = @intCast(u16, read16(reader))
                    }
                    index += 1
                }
                if !reader.*.ok {
                    good = false
                } else {
                    good = pipeline.insertStage(pipe, true, pipeline.clut16(profile.*.allocator, points, inputs, outputs, table))
                }
                mem.release(profile.*.allocator, table)
            }
        }
    }
    if good && (eightBit || outputEntries > 0) {
        if !eightBit && outputEntries < 2 { good = false } else { good = readTables(profile, reader, pipe, outputs, outputEntries, eightBit) }
    }
    if !good {
        pipeline.freePipeline(address)
        return 0
    }
    return address
}

// cmsReadTag: the tag's object (its kind into KIND), read when first
// asked for; 0 when it is absent, of a type the tag may not have, or
// damaged.
pub fn readTag(profile: *Profile, sig: u64, kind: *u64) -> usize {
    kind.* = OBJECT_NONE
    const found = search(profile, sig, true)
    if found < 0 { return 0 }
    const n = @intCast(usize, found)
    var types: [4]u64 = undefined
    var least: usize = 1
    if !descriptor(sig, &types, &least) { return 0 }
    if profile.*.tagObjects[n] != 0 {
        const t = profile.*.tagTypes[n]
        if t != types[0] && t != types[1] && t != types[2] { return 0 }
        kind.* = profile.*.tagObjectKinds[n]
        return profile.*.tagObjects[n]
    }
    if profile.*.data == 0 { return 0 }
    const tagSize = profile.*.tagSizes[n]
    if tagSize < 8 { return 0 }
    var reader = Reader.{ .data = profile.*.data, .size = profile.*.size, .at = 0, .ok = true }
    if !seek(&reader, profile.*.tagOffsets[n]) { return 0 }
    const base = readTypeBase(&reader)
    if base == 0 { return 0 }
    if base != types[0] && base != types[1] && base != types[2] { return 0 }
    var object: usize = 0
    var objectKind = OBJECT_NONE
    var count: usize = 1
    if base == TYPE_XYZ || base == TYPE_CORBIS_BROKEN_XYZ {
        object = readXYZ(profile, &reader)
        objectKind = OBJECT_XYZ
    } else if base == TYPE_CURVE || base == TYPE_MONACO_BROKEN_CURVE {
        object = readCurve(profile, &reader)
        objectKind = OBJECT_CURVE
    } else if base == TYPE_PARAMETRIC_CURVE {
        object = readParametric(profile, &reader)
        objectKind = OBJECT_CURVE
    } else if base == TYPE_LUT16 || base == TYPE_LUT8 {
        object = readLut(profile, &reader, base == TYPE_LUT8)
        objectKind = OBJECT_PIPELINE
    } else if base == TYPE_LUT_ATOB || base == TYPE_LUT_BTOA {
        object = readLutAB(profile, &reader, base == TYPE_LUT_ATOB)
        objectKind = OBJECT_PIPELINE
    } else if base == TYPE_S15FIXED16_ARRAY {
        count = @intCast(usize, (tagSize - 8) / 4)
        object = mem.allocate(profile.*.allocator, count * 8 + 8)
        objectKind = OBJECT_DOUBLES
        if object != 0 {
            var index: usize = 0
            while index < count {
                mem.doubles(object)[index] = readFixed15(&reader)
                index += 1
            }
            if !reader.ok {
                mem.release(profile.*.allocator, object)
                object = 0
            }
        }
    }
    if object == 0 { return 0 }
    if count < least {
        profile.*.tagObjects[n] = object
        profile.*.tagObjectKinds[n] = objectKind
        freeObject(profile, n)
        return 0
    }
    profile.*.tagObjects[n] = object
    profile.*.tagObjectKinds[n] = objectKind
    profile.*.tagTypes[n] = base
    kind.* = objectKind
    return object
}

// The type a tag was read as (_cmsGetTagTrueType), 0 when not read.
pub fn tagType(profile: *Profile, sig: u64) -> u64 {
    const found = search(profile, sig, true)
    if found < 0 { return 0 }
    return profile.*.tagTypes[@intCast(usize, found)]
}

pub fn readXYZTag(profile: *Profile, sig: u64) -> usize {
    var kind: u64 = 0
    const object = readTag(profile, sig, &kind)
    if kind != OBJECT_XYZ { return 0 }
    return object
}

pub fn readCurveTag(profile: *Profile, sig: u64) -> usize {
    var kind: u64 = 0
    const object = readTag(profile, sig, &kind)
    if kind != OBJECT_CURVE { return 0 }
    return object
}

pub fn readPipelineTag(profile: *Profile, sig: u64) -> usize {
    var kind: u64 = 0
    const object = readTag(profile, sig, &kind)
    if kind != OBJECT_PIPELINE { return 0 }
    return object
}

pub fn readDoublesTag(profile: *Profile, sig: u64) -> usize {
    var kind: u64 = 0
    const object = readTag(profile, sig, &kind)
    if kind != OBJECT_DOUBLES { return 0 }
    return object
}

// ---------------------------------------------------------------------------
// Profiles made in memory

// cmsWriteTag of an object this module made (owned by the profile from
// now on), as type TYPE.
fn writeTag(profile: *Profile, sig: u64, object: usize, kind: u64, base: u64) -> bool {
    if object == 0 { return false }
    var n = searchOne(profile, sig)
    if n < 0 {
        if profile.*.tagCount >= MAX_TAGS { return false }
        n = @intCast(i64, profile.*.tagCount)
        profile.*.tagCount += 1
    }
    const index = @intCast(usize, n)
    freeObject(profile, index)
    profile.*.tagNames[index] = sig
    profile.*.tagLinked[index] = 0
    profile.*.tagObjects[index] = object
    profile.*.tagObjectKinds[index] = kind
    profile.*.tagTypes[index] = base
    return true
}

// A tag that is there (for cmsIsTag and the tag count) and not read:
// the texts and the chromaticity Little CMS writes into the profiles it
// makes.
fn placeholderTag(profile: *Profile, sig: u64, base: u64) -> bool {
    var n = searchOne(profile, sig)
    if n < 0 {
        if profile.*.tagCount >= MAX_TAGS { return false }
        n = @intCast(i64, profile.*.tagCount)
        profile.*.tagCount += 1
    }
    const index = @intCast(usize, n)
    freeObject(profile, index)
    profile.*.tagNames[index] = sig
    profile.*.tagLinked[index] = 0
    profile.*.tagTypes[index] = base
    return true
}

// SetTextTags: the description and the copyright.
fn textTags(profile: *Profile) -> bool {
    return placeholderTag(profile, TAG_DESCRIPTION, TYPE_MULTI_LOCALIZED_UNICODE) && placeholderTag(profile, TAG_COPYRIGHT, TYPE_MULTI_LOCALIZED_UNICODE)
}

fn linkTag(profile: *Profile, sig: u64, dest: u64) -> bool {
    if profile.*.tagCount >= MAX_TAGS { return false }
    const index = profile.*.tagCount
    profile.*.tagCount += 1
    profile.*.tagNames[index] = sig
    profile.*.tagLinked[index] = dest
    return true
}

fn xyzObject(allocator: Allocator, x: f64, y: f64, z: f64) -> usize {
    const address = mem.allocate(allocator, 24)
    if address == 0 { return 0 }
    mem.doubles(address)[0] = x
    mem.doubles(address)[1] = y
    mem.doubles(address)[2] = z
    return address
}

// cmsSetProfileVersion: 4.4 as 0x04400000.
pub fn setVersion(profile: *Profile, version: f64) -> void {
    var decimal = @intFromFloat(u64, @floor(version * 100.0 + 0.5))
    var out: u64 = 0
    var shift: u64 = 0
    while decimal > 0 {
        out = out | ((decimal % 10) << shift)
        decimal = decimal / 10
        shift += 4
    }
    profile.*.version = out << 16
}

// cmsGetProfileVersion: the version as a number (4.3 for 0x04300000).
pub fn getVersion(profile: *Profile) -> f64 {
    var n = profile.*.version >> 16
    var out: u64 = 0
    var scale: u64 = 1
    while n > 0 {
        out = out + (n % 16) * scale
        n = n / 16
        scale = scale * 10
    }
    return @floatFromInt(f64, out) / 100.0
}

// cmsCreateRGBProfile: the white point WHITE (x, y, Y; 0: none) and the
// primaries PRIMARIES (red, green, blue x, y, Y; 0: none) adapted to D50,
// and the curves at CURVES (three curve addresses; 0: none, the same
// address twice linked).
pub fn createRGB(allocator: Allocator, white: usize, primaries: usize, curves: usize) -> usize {
    const address = emptyProfile(allocator)
    if address == 0 { return 0 }
    const profile = profileAt(address)
    setVersion(profile, 4.4)
    profile.*.deviceClass = CLASS_DISPLAY
    profile.*.colorSpace = SPACE_RGB
    profile.*.pcs = SPACE_XYZ
    profile.*.renderingIntent = 0
    var good = textTags(profile)
    if good && white != 0 {
        const w = mem.doubles(white)
        good = writeTag(profile, TAG_MEDIA_WHITE_POINT, xyzObject(allocator, mem.D50X, mem.D50Y, mem.D50Z), OBJECT_XYZ, TYPE_XYZ)
        var whiteXYZ: [3]f64 = undefined
        matrix.xyYToXYZ(w[0], w[1], w[2], &whiteXYZ)
        var chad: [9]f64 = undefined
        var d50: [3]f64 = undefined
        d50[0] = mem.D50X
        d50[1] = mem.D50Y
        d50[2] = mem.D50Z
        if good && matrix.adaptationMatrix(&chad, &whiteXYZ, &d50) {
            good = writeTag(profile, TAG_CHROMATIC_ADAPTATION, mem.duplicate(allocator, @intFromPtr(&chad), 72), OBJECT_DOUBLES, TYPE_S15FIXED16_ARRAY)
        } else {
            good = false
        }
    }
    if good && white != 0 && primaries != 0 {
        const w = mem.doubles(white)
        var colorants: [9]f64 = undefined
        if matrix.rgbToXYZTransferMatrix(&colorants, w[0], w[1], mem.doubles(primaries)) {
            good = writeTag(profile, TAG_RED_COLORANT, xyzObject(allocator, colorants[0], colorants[3], colorants[6]), OBJECT_XYZ, TYPE_XYZ)
            if good { good = writeTag(profile, TAG_BLUE_COLORANT, xyzObject(allocator, colorants[2], colorants[5], colorants[8]), OBJECT_XYZ, TYPE_XYZ) }
            if good { good = writeTag(profile, TAG_GREEN_COLORANT, xyzObject(allocator, colorants[1], colorants[4], colorants[7]), OBJECT_XYZ, TYPE_XYZ) }
        } else {
            good = false
        }
    }
    if good && curves != 0 {
        const list = mem.words(curves)
        good = writeTag(profile, TAG_RED_TRC, curve.duplicateCurve(list[0]), OBJECT_CURVE, TYPE_PARAMETRIC_CURVE)
        if good {
            if list[1] == list[0] { good = linkTag(profile, TAG_GREEN_TRC, TAG_RED_TRC) } else { good = writeTag(profile, TAG_GREEN_TRC, curve.duplicateCurve(list[1]), OBJECT_CURVE, TYPE_PARAMETRIC_CURVE) }
        }
        if good {
            if list[2] == list[0] { good = linkTag(profile, TAG_BLUE_TRC, TAG_RED_TRC) } else { good = writeTag(profile, TAG_BLUE_TRC, curve.duplicateCurve(list[2]), OBJECT_CURVE, TYPE_PARAMETRIC_CURVE) }
        }
    }
    if good && primaries != 0 { good = placeholderTag(profile, TAG_CHROMATICITY, TYPE_CHROMATICITY) }
    if !good {
        close(address)
        return 0
    }
    return address
}

// Build_sRGBGamma: IEC 61966-2.1's curve as parametric type 4.
pub fn srgbCurve(allocator: Allocator) -> usize {
    var params: [10]f64 = undefined
    params[0] = 2.4
    params[1] = 1.0 / 1.055
    params[2] = 0.055 / 1.055
    params[3] = 1.0 / 12.92
    params[4] = 0.04045
    return curve.buildParametric(allocator, 4, &params)
}

// cmsCreate_sRGBProfile: D65, the primaries of Rec. 709, the sRGB curve.
pub fn createSRGB(allocator: Allocator) -> usize {
    var white: [3]f64 = undefined
    white[0] = 0.3127
    white[1] = 0.3290
    white[2] = 1.0
    var primaries: [9]f64 = undefined
    primaries[0] = 0.6400
    primaries[1] = 0.3300
    primaries[2] = 1.0
    primaries[3] = 0.3000
    primaries[4] = 0.6000
    primaries[5] = 1.0
    primaries[6] = 0.1500
    primaries[7] = 0.0600
    primaries[8] = 1.0
    const gamma = srgbCurve(allocator)
    if gamma == 0 { return 0 }
    var curves: [3]usize = undefined
    curves[0] = gamma
    curves[1] = gamma
    curves[2] = gamma
    const address = createRGB(allocator, @intFromPtr(&white), @intFromPtr(&primaries), @intFromPtr(&curves))
    curve.freeCurve(gamma)
    if address != 0 && !textTags(profileAt(address)) {
        close(address)
        return 0
    }
    return address
}

// cmsCreateGrayProfile: the white point (x, y, Y; 0: none) as is and the
// curve CURVE (0: none).
pub fn createGray(allocator: Allocator, white: usize, transfer: usize) -> usize {
    const address = emptyProfile(allocator)
    if address == 0 { return 0 }
    const profile = profileAt(address)
    setVersion(profile, 4.4)
    profile.*.deviceClass = CLASS_DISPLAY
    profile.*.colorSpace = SPACE_GRAY
    profile.*.pcs = SPACE_XYZ
    var good = textTags(profile)
    if good && white != 0 {
        const w = mem.doubles(white)
        var xyz: [3]f64 = undefined
        matrix.xyYToXYZ(w[0], w[1], w[2], &xyz)
        good = writeTag(profile, TAG_MEDIA_WHITE_POINT, xyzObject(allocator, xyz[0], xyz[1], xyz[2]), OBJECT_XYZ, TYPE_XYZ)
    }
    if good && transfer != 0 { good = writeTag(profile, TAG_GRAY_TRC, curve.duplicateCurve(transfer), OBJECT_CURVE, TYPE_PARAMETRIC_CURVE) }
    if !good {
        close(address)
        return 0
    }
    return address
}

// cmsCreateXYZProfile: an abstract profile whose A2B0 is the identity
// on XYZ.
pub fn createXYZ(allocator: Allocator) -> usize {
    var white: [3]f64 = undefined
    matrix.xyzToxyY(mem.D50X, mem.D50Y, mem.D50Z, &white)
    const address = createRGB(allocator, @intFromPtr(&white), 0, 0)
    if address == 0 { return 0 }
    const profile = profileAt(address)
    setVersion(profile, 4.4)
    profile.*.deviceClass = CLASS_ABSTRACT
    profile.*.colorSpace = SPACE_XYZ
    profile.*.pcs = SPACE_XYZ
    const lut = pipeline.allocPipeline(allocator, 3, 3)
    if lut == 0 || !pipeline.insertStage(pipeline.pipelineAt(lut), false, pipeline.identityCurves(allocator, 3)) || !writeTag(profile, TAG_A2B0, lut, OBJECT_PIPELINE, TYPE_LUT_ATOB) {
        pipeline.freePipeline(lut)
        close(address)
        return 0
    }
    return address
}

// cmsCreateLab2Profile and cmsCreateLab4Profile (white point D50): the
// abstract profiles whose A2B0 is the identity on Lab, a 16-bit LUT of
// version 2 (an identity grid) or a lutAtoB of version 4 (identity
// curves).
pub fn createLab(allocator: Allocator, version4: bool) -> usize {
    var white: [3]f64 = undefined
    matrix.xyzToxyY(mem.D50X, mem.D50Y, mem.D50Z, &white)
    const address = createRGB(allocator, @intFromPtr(&white), 0, 0)
    if address == 0 { return 0 }
    const profile = profileAt(address)
    setVersion(profile, if version4 { 4.3 } else { 2.1 })
    profile.*.deviceClass = CLASS_ABSTRACT
    profile.*.colorSpace = SPACE_LAB
    profile.*.pcs = SPACE_LAB
    const lut = pipeline.allocPipeline(allocator, 3, 3)
    var stage: usize = 0
    if version4 {
        stage = pipeline.identityCurves(allocator, 3)
    } else {
        stage = pipeline.clut16(allocator, 2, 3, 3, 0)
        if stage != 0 {
            const s = pipeline.stageAt(stage)
            const table = mem.shorts(s.*.clut.table)
            var node: usize = 0
            while node < 8 {
                table[node * 3] = if (node & 4) != 0 { 0xffff } else { 0 }
                table[node * 3 + 1] = if (node & 2) != 0 { 0xffff } else { 0 }
                table[node * 3 + 2] = if (node & 1) != 0 { 0xffff } else { 0 }
                node += 1
            }
            s.*.implements = pipeline.SIG_IDENTITY
        }
    }
    if lut == 0 || !pipeline.insertStage(pipeline.pipelineAt(lut), false, stage) || !writeTag(profile, TAG_A2B0, lut, OBJECT_PIPELINE, if version4 { TYPE_LUT_ATOB } else { TYPE_LUT16 }) {
        pipeline.freePipeline(lut)
        close(address)
        return 0
    }
    return address
}

// cmsChannelsOf: 3 for a colour space it does not know.
pub fn channelsOf(space: u64) -> usize {
    const n = channelsOfSpace(space)
    return if n < 0 { 3 } else { @intCast(usize, n) }
}

// cmsChannelsOfColorSpace: -1 for a colour space it does not know.
pub fn channelsOfSpace(space: u64) -> i64 {
    if space == SPACE_GRAY { return 1 }
    if space == SPACE_CMYK { return 4 }
    if space == 0x32434C52 { return 2 }
    if space == 0x33434C52 || space == SPACE_XYZ || space == SPACE_LAB || space == SPACE_RGB || space == SPACE_CMY { return 3 }
    if space == 0x4C757620 || space == 0x59436272 || space == 0x59787920 || space == 0x48535620 || space == 0x484C5320 { return 3 }
    if space == 0x4C756F76 || space == 0x4D434831 { return 1 }
    if space == 0x34434C52 || space == 0x4D434834 { return 4 }
    if space == 0x35434C52 || space == 0x4D434835 { return 5 }
    if space == 0x36434C52 || space == 0x4D434836 { return 6 }
    if space == 0x37434C52 || space == 0x4D434837 { return 7 }
    if space == 0x38434C52 || space == 0x4D434838 { return 8 }
    if space == 0x39434C52 || space == 0x4D434839 { return 9 }
    if space == 0x41434C52 || space == 0x4D43483A { return 10 }
    if space == 0x42434C52 || space == 0x4D43483B { return 11 }
    if space == 0x43434C52 || space == 0x4D43483C { return 12 }
    if space == 0x44434C52 || space == 0x4D43483D { return 13 }
    if space == 0x45434C52 || space == 0x4D43483E { return 14 }
    if space == 0x46434C52 || space == 0x4D43483F { return 15 }
    if space == 0x4D434832 { return 2 }
    if space == 0x4D434833 { return 3 }
    return -1
}
