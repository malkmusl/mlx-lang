// std.colorprofile.interp: the interpolation of colour lookup tables as
// Little CMS (2.14) does it (cmsintrp.c), in its 16-bit fixed point: a
// table of one input (to one or more outputs), and of three inputs,
// tetrahedral (the default) or trilinear (the B2A tables of Lab
// profiles). Grids are laid out with the last input varying fastest and
// the outputs of a node together, as ICC tables are.
//
// The arithmetic is C's on Little CMS's types, overflow included: the
// tetrahedral sums are 32-bit ints that wrap where the table's steps are
// large, and a different sum would round otherwise.
const mem = @import("./mem.mlx")
const curve = @import("./curve.mlx")

pub const MAX_INPUTS: usize = 8

pub const Params = struct {
    inputs: usize
    outputs: usize
    samples: [8]usize
    domain: [8]usize
    // The distance in table entries between neighbours along each input:
    // opta[0] is the last input's (the outputs), opta[inputs-1] the
    // first's.
    opta: [8]usize
    trilinear: bool
    // The table (16-bit entries).
    table: usize
}

// _cmsComputeInterpParamsEx; false when there is no interpolation for so
// many inputs.
pub fn compute(p: *Params, samples: [*]const usize, inputs: usize, outputs: usize, table: usize) -> bool {
    if inputs > MAX_INPUTS { return false }
    if inputs != 1 && inputs != 3 { return false }
    p.*.inputs = inputs
    p.*.outputs = outputs
    p.*.table = table
    p.*.trilinear = false
    var index: usize = 0
    while index < inputs {
        p.*.samples[index] = samples[index]
        p.*.domain[index] = samples[index] - 1
        index += 1
    }
    p.*.opta[0] = outputs
    index = 1
    while index < inputs {
        p.*.opta[index] = p.*.opta[index - 1] * samples[inputs - index]
        index += 1
    }
    return true
}

inline fn at(table: [*]const u16, index: usize) -> i64 { return @intCast(i64, table[index]) }

// Eval1Input and LinLerp1D.
fn eval1(p: *Params, input: [*]const u16, output: [*]u16) -> void {
    const table = mem.shorts(p.*.table)
    const value = @intCast(u64, input[0])
    if p.*.outputs == 1 {
        output[0] = @intCast(u16, curve.lerp16(table, @intCast(u64, p.*.domain[0]), value))
        return
    }
    if value == 0xffff || p.*.domain[0] == 0 {
        const y0 = p.*.domain[0] * p.*.opta[0]
        var channel: usize = 0
        while channel < p.*.outputs {
            output[channel] = table[y0 + channel]
            channel += 1
        }
        return
    }
    const fk = mem.toFixedDomain(@intCast(i64, value * @intCast(u64, p.*.domain[0])))
    const k0 = @intCast(usize, fk >> 16)
    const rk = @intCast(u64, fk & 0xffff)
    const k1 = k0 + 1
    const base0 = p.*.opta[0] * k0
    const base1 = p.*.opta[0] * k1
    var channel: usize = 0
    while channel < p.*.outputs {
        output[channel] = @intCast(u16, curve.linearInterp(rk, @intCast(u64, table[base0 + channel]), @intCast(u64, table[base1 + channel])))
        channel += 1
    }
}

// TetrahedralInterp16.
fn tetrahedral(p: *Params, input: [*]const u16, output: [*]u16) -> void {
    const table = mem.shorts(p.*.table)
    const in0 = @intCast(i64, input[0])
    const in1 = @intCast(i64, input[1])
    const in2 = @intCast(i64, input[2])
    const fx = mem.toFixedDomain(in0 * @intCast(i64, p.*.domain[0]))
    const fy = mem.toFixedDomain(in1 * @intCast(i64, p.*.domain[1]))
    const fz = mem.toFixedDomain(in2 * @intCast(i64, p.*.domain[2]))
    const rx = fx & 0xffff
    const ry = fy & 0xffff
    const rz = fz & 0xffff
    const base = p.*.opta[2] * @intCast(usize, fx >> 16) + p.*.opta[1] * @intCast(usize, fy >> 16) + p.*.opta[0] * @intCast(usize, fz >> 16)
    const x1: usize = if in0 == 0xffff { 0 } else { p.*.opta[2] }
    const y1: usize = if in1 == 0xffff { 0 } else { p.*.opta[1] }
    const z1: usize = if in2 == 0xffff { 0 } else { p.*.opta[0] }
    var channel: usize = 0
    while channel < p.*.outputs {
        const o = base + channel
        const c0 = at(table, o)
        var c1: i64 = 0
        var c2: i64 = 0
        var c3: i64 = 0
        if rx >= ry {
            if ry >= rz {
                c1 = at(table, o + x1) - c0
                c2 = at(table, o + x1 + y1) - at(table, o + x1)
                c3 = at(table, o + x1 + y1 + z1) - at(table, o + x1 + y1)
            } else if rz >= rx {
                c1 = at(table, o + x1 + z1) - at(table, o + z1)
                c2 = at(table, o + x1 + y1 + z1) - at(table, o + x1 + z1)
                c3 = at(table, o + z1) - c0
            } else {
                c1 = at(table, o + x1) - c0
                c2 = at(table, o + x1 + y1 + z1) - at(table, o + x1 + z1)
                c3 = at(table, o + x1 + z1) - at(table, o + x1)
            }
        } else {
            if rx >= rz {
                c1 = at(table, o + x1 + y1) - at(table, o + y1)
                c2 = at(table, o + y1) - c0
                c3 = at(table, o + x1 + y1 + z1) - at(table, o + x1 + y1)
            } else if ry >= rz {
                c1 = at(table, o + x1 + y1 + z1) - at(table, o + y1 + z1)
                c2 = at(table, o + y1) - c0
                c3 = at(table, o + y1 + z1) - at(table, o + y1)
            } else {
                c1 = at(table, o + x1 + y1 + z1) - at(table, o + y1 + z1)
                c2 = at(table, o + y1 + z1) - at(table, o + z1)
                c3 = at(table, o + z1) - c0
            }
        }
        const rest = mem.wrap32(c1 * rx + c2 * ry + c3 * rz + 0x8001)
        const value = c0 + (mem.wrap32(rest + (rest >> 16)) >> 16)
        output[channel] = @intCast(u16, @bitCast(u64, value) & 0xffff)
        channel += 1
    }
}

// TrilinearInterp16's LERP: L to H at A, in C's int arithmetic, cut to
// 16 bits.
inline fn lerp(a: i64, l: i64, h: i64) -> i64 {
    const product = mem.wrap32((h - l) * a)
    const value = l + (mem.wrap32(product + 0x8000) >> 16)
    return @intCast(i64, @bitCast(u64, value) & 0xffff)
}

// TrilinearInterp16.
fn trilinear(p: *Params, input: [*]const u16, output: [*]u16) -> void {
    const table = mem.shorts(p.*.table)
    const in0 = @intCast(i64, input[0])
    const in1 = @intCast(i64, input[1])
    const in2 = @intCast(i64, input[2])
    const fx = mem.toFixedDomain(in0 * @intCast(i64, p.*.domain[0]))
    const fy = mem.toFixedDomain(in1 * @intCast(i64, p.*.domain[1]))
    const fz = mem.toFixedDomain(in2 * @intCast(i64, p.*.domain[2]))
    const rx = fx & 0xffff
    const ry = fy & 0xffff
    const rz = fz & 0xffff
    const x0 = p.*.opta[2] * @intCast(usize, fx >> 16)
    const y0 = p.*.opta[1] * @intCast(usize, fy >> 16)
    const z0 = p.*.opta[0] * @intCast(usize, fz >> 16)
    const x1 = x0 + (if in0 == 0xffff { 0 } else { p.*.opta[2] })
    const y1 = y0 + (if in1 == 0xffff { 0 } else { p.*.opta[1] })
    const z1 = z0 + (if in2 == 0xffff { 0 } else { p.*.opta[0] })
    var channel: usize = 0
    while channel < p.*.outputs {
        const d000 = at(table, x0 + y0 + z0 + channel)
        const d001 = at(table, x0 + y0 + z1 + channel)
        const d010 = at(table, x0 + y1 + z0 + channel)
        const d011 = at(table, x0 + y1 + z1 + channel)
        const d100 = at(table, x1 + y0 + z0 + channel)
        const d101 = at(table, x1 + y0 + z1 + channel)
        const d110 = at(table, x1 + y1 + z0 + channel)
        const d111 = at(table, x1 + y1 + z1 + channel)
        const dx00 = lerp(rx, d000, d100)
        const dx01 = lerp(rx, d001, d101)
        const dx10 = lerp(rx, d010, d110)
        const dx11 = lerp(rx, d011, d111)
        const dxy0 = lerp(ry, dx00, dx10)
        const dxy1 = lerp(ry, dx01, dx11)
        const dxyz = lerp(rz, dxy0, dxy1)
        output[channel] = @intCast(u16, dxyz)
        channel += 1
    }
}

// The interpolation the parameters ask for (Lerp16).
pub fn eval16(p: *Params, input: [*]const u16, output: [*]u16) -> void {
    if p.*.inputs == 1 {
        eval1(p, input, output)
    } else if p.*.trilinear {
        trilinear(p, input, output)
    } else {
        tetrahedral(p, input, output)
    }
}
