// std.colorprofile.curve: tone curves as Little CMS (2.14) keeps and
// evaluates them (cmsgamma.c): a list of segments, each a parametric
// function (the ICC's five types and Little CMS's own 6, 7, 8, 108 and
// 109, their inverses as the negative types) or sampled points, over a
// part of the real line; and a table of 16-bit values, made of the
// segments (4096 entries, 2 for a gamma of 1) or read from a profile's
// `curv`, which 16-bit evaluation interpolates.
//
// Evaluation in floating point goes through the segments where there are
// any (in double precision, the result a float), else through the table.
// The results are Little CMS's to the bit: the rounding of 16-bit values
// (_cmsQuickSaturateWord), the fixed-point interpolation and the float
// arithmetic are its own.
const mem = @import("./mem.mlx")
const math = @import("../math.mlx")

pub const Allocator = mem.Allocator

// cmsgamma.c's limits: (float) 1e22 for the infinities.
pub const PLUS_INF: f64 = 9999999778196308361216.0
pub const MINUS_INF: f64 = -9999999778196308361216.0
pub const MAX_NODES_IN_CURVE: usize = 4097

pub const Segment = struct {
    // The segment covers x0 < x <= x1.
    x0: f32
    x1: f32
    // 0: sampled points; else a parametric type (negative: an inverse).
    kind: i64
    params: [10]f64
    gridPoints: usize
    // gridPoints floats (kind 0).
    sampled: usize
}

pub const Curve = struct {
    allocator: Allocator
    segmentCount: usize
    // segmentCount Segments.
    segments: usize
    entries: usize
    // entries 16-bit values.
    table: usize
}

pub inline fn curveAt(address: usize) -> *Curve { return unsafe { @ptrFromInt(*Curve, address) } }
pub inline fn segmentAt(curve: *Curve, index: usize) -> *Segment {
    return unsafe { @ptrFromInt(*Segment, curve.*.segments + index * @sizeOf(Segment)) }
}
pub inline fn tableOf(curve: *Curve) -> [*]u16 { return mem.shorts(curve.*.table) }

// How many parameters a parametric type has; 0 for an unknown type.
pub fn parameterCount(kind: i64) -> usize {
    const k = if kind < 0 { -kind } else { kind }
    if k == 1 { return 1 }
    if k == 2 { return 3 }
    if k == 3 { return 4 }
    if k == 4 { return 5 }
    if k == 5 { return 7 }
    if k == 6 { return 4 }
    if k == 7 { return 5 }
    if k == 8 { return 5 }
    if k == 108 { return 1 }
    if k == 109 { return 1 }
    return 0
}

inline fn tiny(x: f64) -> bool { return mem.fabs(x) < mem.MATRIX_DET_TOLERANCE }

fn sigmoidBase(k: f64, t: f64) -> f64 { return (1.0 / (1.0 + math.exp(-k * t))) - 0.5 }
fn invertedSigmoidBase(k: f64, t: f64) -> f64 { return -ln((1.0 / (t + 0.5)) - 1.0) / k }
fn sigmoidFactory(k: f64, t: f64) -> f64 {
    const correction = 0.5 / sigmoidBase(k, 1.0)
    return correction * sigmoidBase(k, 2.0 * t - 1.0) + 0.5
}
fn inverseSigmoidFactory(k: f64, t: f64) -> f64 {
    const correction = 0.5 / sigmoidBase(k, 1.0)
    return (invertedSigmoidBase(k, (t - 0.5) / correction) + 1.0) / 2.0
}

// pow as the C library's: a negative base to a whole power keeps its
// sign; to any other power it is the x86 "indefinite" NaN (the sign bit
// set), which is what C's pow gives Little CMS there.
// The x86 "indefinite" NaN, what invalid operations give.
inline fn indefinite() -> f64 { return @bitCast(f64, @intCast(u64, 0xFFF8000000000000)) }

// The logarithms as the C library's: NaN passed through, the indefinite
// NaN below 0.
fn ln(x: f64) -> f64 {
    if x != x { return x }
    if x < 0.0 { return indefinite() }
    return math.ln(x)
}

fn log10(x: f64) -> f64 {
    if x != x { return x }
    if x < 0.0 { return indefinite() }
    return math.log10(x)
}

pub fn pow(x: f64, y: f64) -> f64 {
    if y == 0.0 { return 1.0 }
    if x != x || y != y { return x + y }
    if x < 0.0 {
        if @floor(y) != y { return indefinite() }
        const magnitude = math.pow(-x, y)
        const half = y * 0.5
        return if @floor(half) != half { -magnitude } else { magnitude }
    }
    if x == 0.0 { return if y > 0.0 { 0.0 } else { math.infinity() } }
    return math.pow(x, y)
}

// DefaultEvalParametricFn: the parametric function KIND of P at R.
pub fn evalParametric(kind: i64, p: [*]const f64, r: f64) -> f64 {
    var value: f64 = 0.0
    if kind == 1 {
        if r < 0.0 {
            value = if tiny(p[0] - 1.0) { r } else { 0.0 }
        } else {
            value = pow(r, p[0])
        }
    } else if kind == -1 {
        if r < 0.0 {
            value = if tiny(p[0] - 1.0) { r } else { 0.0 }
        } else if tiny(p[0]) {
            value = PLUS_INF
        } else {
            value = pow(r, 1.0 / p[0])
        }
    } else if kind == 2 {
        if !tiny(p[1]) {
            const disc = -p[2] / p[1]
            if r >= disc {
                const e = p[1] * r + p[2]
                if e > 0.0 { value = pow(e, p[0]) }
            }
        }
    } else if kind == -2 {
        if !tiny(p[0]) && !tiny(p[1]) {
            if r >= 0.0 { value = (pow(r, 1.0 / p[0]) - p[2]) / p[1] }
            if value < 0.0 { value = 0.0 }
        }
    } else if kind == 3 {
        if !tiny(p[1]) {
            var disc = -p[2] / p[1]
            if disc < 0.0 { disc = 0.0 }
            if r >= disc {
                const e = p[1] * r + p[2]
                if e > 0.0 { value = pow(e, p[0]) + p[3] }
            } else {
                value = p[3]
            }
        }
    } else if kind == -3 {
        if !tiny(p[0]) && !tiny(p[1]) {
            if r >= p[3] {
                const e = r - p[3]
                if e > 0.0 { value = (pow(e, 1.0 / p[0]) - p[2]) / p[1] }
            } else {
                value = -p[2] / p[1]
            }
        }
    } else if kind == 4 {
        if r >= p[4] {
            const e = p[1] * r + p[2]
            if e > 0.0 { value = pow(e, p[0]) }
        } else {
            value = r * p[3]
        }
    } else if kind == -4 {
        const e = p[1] * p[4] + p[2]
        var disc: f64 = 0.0
        if e >= 0.0 { disc = pow(e, p[0]) }
        if r >= disc {
            if !tiny(p[0]) && !tiny(p[1]) { value = (pow(r, 1.0 / p[0]) - p[2]) / p[1] }
        } else if !tiny(p[3]) {
            value = r / p[3]
        }
    } else if kind == 5 {
        if r >= p[4] {
            const e = p[1] * r + p[2]
            value = if e > 0.0 { pow(e, p[0]) + p[5] } else { p[5] }
        } else {
            value = r * p[3] + p[6]
        }
    } else if kind == -5 {
        const disc = p[3] * p[4] + p[6]
        if r >= disc {
            const e = r - p[5]
            if e >= 0.0 && !tiny(p[0]) && !tiny(p[1]) { value = (pow(e, 1.0 / p[0]) - p[2]) / p[1] }
        } else if !tiny(p[3]) {
            value = (r - p[6]) / p[3]
        }
    } else if kind == 6 {
        const e = p[1] * r + p[2]
        value = if e < 0.0 { p[3] } else { pow(e, p[0]) + p[3] }
    } else if kind == -6 {
        if !tiny(p[0]) && !tiny(p[1]) {
            const e = r - p[3]
            if e >= 0.0 { value = (pow(e, 1.0 / p[0]) - p[2]) / p[1] }
        }
    } else if kind == 7 {
        const e = p[2] * pow(r, p[0]) + p[3]
        value = if e <= 0.0 { p[4] } else { p[1] * log10(e) + p[4] }
    } else if kind == -7 {
        if !tiny(p[0]) && !tiny(p[1]) && !tiny(p[2]) {
            value = pow((pow(10.0, (r - p[4]) / p[1]) - p[3]) / p[2], 1.0 / p[0])
        }
    } else if kind == 8 {
        value = p[0] * pow(p[1], p[2] * r + p[3]) + p[4]
    } else if kind == -8 {
        const disc = r - p[4]
        if disc >= 0.0 && !tiny(p[0]) && !tiny(p[2]) {
            value = (ln(disc / p[0]) / ln(p[1]) - p[3]) / p[2]
        }
    } else if kind == 108 {
        if !tiny(p[0]) { value = pow(1.0 - pow(1.0 - r, 1.0 / p[0]), 1.0 / p[0]) }
    } else if kind == -108 {
        value = 1.0 - pow(1.0 - pow(r, p[0]), p[0])
    } else if kind == 109 {
        value = sigmoidFactory(p[0], r)
    } else if kind == -109 {
        value = inverseSigmoidFactory(p[0], r)
    }
    return value
}

// ---------------------------------------------------------------------------
// The 1-D interpolations of cmsintrp.c

// LinearInterp: L to H at A/65536, in C's unsigned 32-bit arithmetic.
pub inline fn linearInterp(a: u64, l: u64, h: u64) -> u64 {
    const difference = (h -% l) & 0xffffffff
    const dif = ((difference *% a) +% 0x8000) & 0xffffffff
    return ((dif >> 16) +% l) & 0xffff
}

// LinLerp1D: VALUE through TABLE (DOMAIN + 1 entries).
pub fn lerp16(table: [*]const u16, domain: u64, value: u64) -> u64 {
    if value == 0xffff || domain == 0 { return @intCast(u64, table[domain]) }
    const fixed = mem.toFixedDomain(@intCast(i64, domain * value))
    const cell = @intCast(usize, fixed >> 16)
    const rest = @intCast(u64, fixed & 0xffff)
    return linearInterp(rest, @intCast(u64, table[cell]), @intCast(u64, table[cell + 1]))
}

// fclamp: 0 below 1e-9 (and for NaN), 1 above 1.
pub fn fclamp(v: f32) -> f32 {
    if v < @floatCast(f32, 0.000000001) || v != v { return @floatCast(f32, 0.0) }
    if v > @floatCast(f32, 1.0) { return @floatCast(f32, 1.0) }
    return v
}

// LinLerp1Dfloat: VALUE through the floats of TABLE (DOMAIN + 1).
pub fn lerpFloat(table: [*]const f32, domain: u64, value: f32) -> f32 {
    var v = fclamp(value)
    if v == @floatCast(f32, 1.0) || domain == 0 { return table[domain] }
    v = v * @floatFromInt(f32, domain)
    const cell0 = @intFromFloat(i64, @floor(@floatCast(f64, v)))
    const cell1 = @intFromFloat(i64, @ceil(@floatCast(f64, v)))
    const rest: f32 = v - @floatFromInt(f32, cell0)
    const y0 = table[@intCast(usize, cell0)]
    const y1 = table[@intCast(usize, cell1)]
    return y0 + (y1 - y0) * rest
}

// ---------------------------------------------------------------------------
// Building and freeing

// AllocateToneCurveStruct: ENTRIES table entries (copied from VALUES, an
// address, when not 0) and the SEGMENTCOUNT segments at SEGMENTS (an
// address of Segments, whose sampled points are copied). 0 when the
// sizes are out of range or there is no memory.
pub fn allocateCurve(allocator: Allocator, entries: usize, segmentCount: usize, segments: usize, values: usize) -> usize {
    if entries > 65530 { return 0 }
    if entries == 0 && segmentCount == 0 { return 0 }
    const address = mem.allocate(allocator, @sizeOf(Curve))
    if address == 0 { return 0 }
    const curve = curveAt(address)
    curve.*.allocator = allocator
    curve.*.segmentCount = segmentCount
    curve.*.entries = entries
    curve.*.segments = 0
    curve.*.table = 0
    if segmentCount > 0 {
        curve.*.segments = mem.allocate(allocator, segmentCount * @sizeOf(Segment))
        if curve.*.segments == 0 {
            freeCurve(address)
            return 0
        }
    }
    if entries > 0 {
        curve.*.table = mem.allocate(allocator, entries * 2)
        if curve.*.table == 0 {
            freeCurve(address)
            return 0
        }
        if values != 0 { mem.copy(curve.*.table, values, entries * 2) }
    }
    if segments != 0 {
        var index: usize = 0
        while index < segmentCount {
            const target = segmentAt(curve, index)
            mem.copy(@intFromPtr(target), segments + index * @sizeOf(Segment), @sizeOf(Segment))
            target.*.sampled = 0
            const source = unsafe { @ptrFromInt(*Segment, segments + index * @sizeOf(Segment)) }
            if source.*.kind == 0 && source.*.sampled != 0 {
                target.*.sampled = mem.duplicate(allocator, source.*.sampled, source.*.gridPoints * 4)
                if target.*.sampled == 0 {
                    freeCurve(address)
                    return 0
                }
            }
            index += 1
        }
    }
    return address
}

pub fn freeCurve(address: usize) -> void {
    if address == 0 { return }
    const curve = curveAt(address)
    const allocator = curve.*.allocator
    if curve.*.segments != 0 {
        var index: usize = 0
        while index < curve.*.segmentCount {
            mem.release(allocator, segmentAt(curve, index).*.sampled)
            index += 1
        }
        mem.release(allocator, curve.*.segments)
    }
    mem.release(allocator, curve.*.table)
    mem.release(allocator, address)
}

pub fn duplicateCurve(address: usize) -> usize {
    if address == 0 { return 0 }
    const curve = curveAt(address)
    return allocateCurve(curve.*.allocator, curve.*.entries, curve.*.segmentCount, curve.*.segments, curve.*.table)
}

// EvalSegmentedFn: R through the segments (the last that covers it).
pub fn evalSegmented(curve: *Curve, r: f64) -> f64 {
    var index = curve.*.segmentCount
    while index > 0 {
        index -= 1
        const segment = segmentAt(curve, index)
        if r > @floatCast(f64, segment.*.x0) && r <= @floatCast(f64, segment.*.x1) {
            var out: f64 = 0.0
            if segment.*.kind == 0 {
                const r1: f32 = @floatCast(f32, r - @floatCast(f64, segment.*.x0)) / (segment.*.x1 - segment.*.x0)
                const out32 = lerpFloat(mem.floats(segment.*.sampled), @intCast(u64, segment.*.gridPoints - 1), r1)
                out = @floatCast(f64, out32)
            } else {
                out = evalParametric(segment.*.kind, &segment.*.params, r)
            }
            // (isinf: either infinity gives PLUS_INF, as Little CMS's test
            // does.)
            if out == math.infinity() || out == math.negativeInfinity() { return PLUS_INF }
            return out
        }
    }
    return MINUS_INF
}

// cmsBuildSegmentedToneCurve: the segments and a table of them (4096
// entries; 2 for one segment of gamma 1).
pub fn buildSegmented(allocator: Allocator, segmentCount: usize, segments: usize) -> usize {
    var gridPoints: usize = 4096
    if segmentCount == 1 {
        const first = unsafe { @ptrFromInt(*Segment, segments) }
        if first.*.kind == 1 && mem.fabs(first.*.params[0] - 1.0) < 0.001 { gridPoints = 2 }
    }
    const address = allocateCurve(allocator, gridPoints, segmentCount, segments, 0)
    if address == 0 { return 0 }
    const curve = curveAt(address)
    const table = tableOf(curve)
    var index: usize = 0
    while index < gridPoints {
        const r = @floatFromInt(f64, index) / @floatFromInt(f64, gridPoints - 1)
        const value = evalSegmented(curve, r)
        table[index] = @intCast(u16, mem.saturateWord(value * 65535.0))
        index += 1
    }
    return address
}

// cmsBuildParametricToneCurve: one segment of type KIND over the whole
// line, with PARAMS (its parameterCount of them). 0 for an unknown type.
pub fn buildParametric(allocator: Allocator, kind: i64, params: [*]const f64) -> usize {
    const count = parameterCount(kind)
    if count == 0 { return 0 }
    var segment: Segment = undefined
    mem.zero(@intFromPtr(&segment), @sizeOf(Segment))
    segment.x0 = @floatCast(f32, MINUS_INF)
    segment.x1 = @floatCast(f32, PLUS_INF)
    segment.kind = kind
    var index: usize = 0
    while index < count {
        segment.params[index] = params[index]
        index += 1
    }
    return buildSegmented(allocator, 1, @intFromPtr(&segment))
}

pub fn buildGamma(allocator: Allocator, gamma: f64) -> usize {
    var params: [10]f64 = undefined
    params[0] = gamma
    return buildParametric(allocator, 1, &params)
}

// cmsBuildTabulatedToneCurve16: ENTRIES values (VALUES an address; 0
// leaves them zero).
pub fn buildTabulated16(allocator: Allocator, entries: usize, values: usize) -> usize {
    return allocateCurve(allocator, entries, 0, 0, values)
}

// cmsBuildTabulatedToneCurveFloat: ENTRIES floats sampled on 0..1, the
// first and last values held below and above.
pub fn buildTabulatedFloat(allocator: Allocator, entries: usize, values: usize) -> usize {
    if entries == 0 { return 0 }
    var segments: [3]Segment = undefined
    mem.zero(@intFromPtr(&segments), 3 * @sizeOf(Segment))
    segments[0].x0 = @floatCast(f32, MINUS_INF)
    segments[0].x1 = @floatCast(f32, 0.0)
    segments[0].kind = 6
    segments[0].params[0] = 1.0
    segments[0].params[3] = @floatCast(f64, mem.getF32(values))
    segments[1].x0 = @floatCast(f32, 0.0)
    segments[1].x1 = @floatCast(f32, 1.0)
    segments[1].kind = 0
    segments[1].gridPoints = entries
    segments[1].sampled = values
    segments[2].x0 = @floatCast(f32, 1.0)
    segments[2].x1 = @floatCast(f32, PLUS_INF)
    segments[2].kind = 6
    segments[2].params[0] = 1.0
    segments[2].params[3] = @floatCast(f64, mem.getF32(values + (entries - 1) * 4))
    return buildSegmented(allocator, 3, @intFromPtr(&segments))
}

// ---------------------------------------------------------------------------
// Evaluating

pub fn eval16(curve: *Curve, value: u64) -> u64 {
    return lerp16(tableOf(curve), @intCast(u64, curve.*.entries - 1), value & 0xffff)
}

pub fn evalFloat(curve: *Curve, value: f32) -> f32 {
    if curve.*.segmentCount == 0 {
        const input = mem.saturateWord(@floatCast(f64, value) * 65535.0)
        const output = eval16(curve, input)
        return @floatCast(f32, @floatFromInt(f64, output) / 65535.0)
    }
    return @floatCast(f32, evalSegmented(curve, @floatCast(f64, value)))
}

// ---------------------------------------------------------------------------
// Properties

pub fn isDescending(curve: *Curve) -> bool {
    const table = tableOf(curve)
    return table[0] > table[curve.*.entries - 1]
}

pub fn isLinear(curve: *Curve) -> bool {
    const table = tableOf(curve)
    var index: usize = 0
    while index < curve.*.entries {
        const expected = @intCast(i64, mem.quantize(@floatFromInt(f64, index), curve.*.entries))
        var difference = @intCast(i64, table[index]) - expected
        if difference < 0 { difference = -difference }
        if difference > 0x0f { return false }
        index += 1
    }
    return true
}

pub fn isMonotonic(curve: *Curve) -> bool {
    const n = curve.*.entries
    if n < 2 { return true }
    const table = tableOf(curve)
    if isDescending(curve) {
        var last = @intCast(i64, table[0])
        var index: usize = 1
        while index < n {
            const value = @intCast(i64, table[index])
            if value - last > 2 { return false }
            last = value
            index += 1
        }
    } else {
        var last = @intCast(i64, table[n - 1])
        var index = n - 1
        while index > 0 {
            index -= 1
            const value = @intCast(i64, table[index])
            if value - last > 2 { return false }
            last = value
        }
    }
    return true
}

// cmsGetToneCurveParametricType: the type of a curve of one segment.
pub fn parametricType(curve: *Curve) -> i64 {
    if curve.*.segmentCount != 1 { return 0 }
    return segmentAt(curve, 0).*.kind
}

// GetInterval: the cell of the table whose two ends hold IN.
fn interval(value: f64, table: [*]const u16, domain: usize) -> i64 {
    if domain < 1 { return -1 }
    if table[0] < table[domain] {
        var index = domain
        while index > 0 {
            index -= 1
            const y0 = @floatFromInt(f64, table[index])
            const y1 = @floatFromInt(f64, table[index + 1])
            if y0 <= y1 {
                if value >= y0 && value <= y1 { return @intCast(i64, index) }
            } else if y1 < y0 {
                if value >= y1 && value <= y0 { return @intCast(i64, index) }
            }
        }
    } else {
        var index: usize = 0
        while index < domain {
            const y0 = @floatFromInt(f64, table[index])
            const y1 = @floatFromInt(f64, table[index + 1])
            if y0 <= y1 {
                if value >= y0 && value <= y1 { return @intCast(i64, index) }
            } else if y1 < y0 {
                if value >= y1 && value <= y0 { return @intCast(i64, index) }
            }
            index += 1
        }
    }
    return -1
}

// cmsReverseToneCurveEx: the inverse of a parametric curve as the
// negative type; else SAMPLES table entries found in the curve's table.
pub fn reverse(address: usize, samples: usize) -> usize {
    const curve = curveAt(address)
    const allocator = curve.*.allocator
    if curve.*.segmentCount == 1 {
        const segment = segmentAt(curve, 0)
        if segment.*.kind > 0 && parameterCount(segment.*.kind) != 0 {
            return buildParametric(allocator, -segment.*.kind, &segment.*.params)
        }
    }
    const out = buildTabulated16(allocator, samples, 0)
    if out == 0 { return 0 }
    const table = tableOf(curveAt(out))
    const source = tableOf(curve)
    const ascending = !isDescending(curve)
    var a: f64 = 0.0
    var b: f64 = 0.0
    var index: usize = 0
    while index < samples {
        const y = @floatFromInt(f64, index) * 65535.0 / @floatFromInt(f64, samples - 1)
        const j = interval(y, source, curve.*.entries - 1)
        var done = false
        if j >= 0 {
            const at = @intCast(usize, j)
            const x1 = @floatFromInt(f64, source[at])
            const x2 = @floatFromInt(f64, source[at + 1])
            const y1 = @floatFromInt(f64, at) * 65535.0 / @floatFromInt(f64, curve.*.entries - 1)
            const y2 = @floatFromInt(f64, at + 1) * 65535.0 / @floatFromInt(f64, curve.*.entries - 1)
            if x1 == x2 {
                table[index] = @intCast(u16, mem.saturateWord(if ascending { y2 } else { y1 }))
                done = true
            } else {
                a = (y2 - y1) / (x2 - x1)
                b = y2 - a * x2
            }
        }
        if !done { table[index] = @intCast(u16, mem.saturateWord(a * y + b)) }
        index += 1
    }
    return out
}

// cmsEstimateGamma: the mean exponent of the curve on its middle part,
// -1 when the exponents spread more than PRECISION.
pub fn estimateGamma(curve: *Curve, precision: f64) -> f64 {
    var sum: f64 = 0.0
    var sum2: f64 = 0.0
    var n: f64 = 0.0
    var index: usize = 1
    while index < MAX_NODES_IN_CURVE - 1 {
        const x = @floatFromInt(f64, index) / @floatFromInt(f64, MAX_NODES_IN_CURVE - 1)
        const y = @floatCast(f64, evalFloat(curve, @floatCast(f32, x)))
        if y > 0.0 && y < 1.0 && x > 0.07 {
            const gamma = math.ln(y) / math.ln(x)
            sum += gamma
            sum2 += gamma * gamma
            n += 1.0
        }
        index += 1
    }
    if n <= 1.0 { return -1.0 }
    const deviation = math.sqrt((n * sum2 - sum * sum) / (n * (n - 1.0)))
    if deviation > precision { return -1.0 }
    return sum / n
}
