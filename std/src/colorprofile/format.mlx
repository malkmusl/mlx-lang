// std.colorprofile.format: Little CMS's pixel format words (lcms2.h's
// TYPE_ constants are made of these fields) and the colour spaces they
// name.
const profile = @import("./profile.mlx")

pub inline fn colorspaceOf(format: u64) -> u64 { return (format >> 16) & 31 }
pub inline fn swapFirst(format: u64) -> bool { return ((format >> 14) & 1) != 0 }
pub inline fn flavor(format: u64) -> bool { return ((format >> 13) & 1) != 0 }
pub inline fn planar(format: u64) -> bool { return ((format >> 12) & 1) != 0 }
pub inline fn endian16(format: u64) -> bool { return ((format >> 11) & 1) != 0 }
pub inline fn doSwap(format: u64) -> bool { return ((format >> 10) & 1) != 0 }
pub inline fn extra(format: u64) -> u64 { return (format >> 7) & 7 }
pub inline fn channels(format: u64) -> u64 { return (format >> 3) & 15 }
pub inline fn bytes(format: u64) -> u64 { return format & 7 }
pub inline fn isFloat(format: u64) -> bool { return ((format >> 22) & 1) != 0 }
pub inline fn premul(format: u64) -> bool { return ((format >> 23) & 1) != 0 }
pub inline fn is8bit(format: u64) -> bool { return bytes(format) == 1 }

pub const OPTIMIZED: u64 = 0x200000

pub const PT_ANY: u64 = 0
pub const PT_GRAY: u64 = 3
pub const PT_RGB: u64 = 4
pub const PT_CMY: u64 = 5
pub const PT_CMYK: u64 = 6
pub const PT_YCBCR: u64 = 7
pub const PT_YUV: u64 = 8
pub const PT_XYZ: u64 = 9
pub const PT_LAB: u64 = 10
pub const PT_YUVK: u64 = 11
pub const PT_HSV: u64 = 12
pub const PT_HLS: u64 = 13
pub const PT_YXY: u64 = 14
pub const PT_MCH1: u64 = 15
pub const PT_MCH15: u64 = 29
pub const PT_LABV2: u64 = 30

// _cmsICCcolorSpace: the signature of a format's colour space, 0 for
// none.
pub fn iccColorSpace(pt: u64) -> u64 {
    if pt == 1 || pt == PT_GRAY { return profile.SPACE_GRAY }
    if pt == 2 || pt == PT_RGB { return profile.SPACE_RGB }
    if pt == PT_CMY { return profile.SPACE_CMY }
    if pt == PT_CMYK { return profile.SPACE_CMYK }
    if pt == PT_YCBCR { return 0x59436272 }
    if pt == PT_YUV { return 0x4C757620 }
    if pt == PT_XYZ { return profile.SPACE_XYZ }
    if pt == PT_LAB || pt == PT_LABV2 { return profile.SPACE_LAB }
    if pt == PT_YUVK { return 0x4C75764B }
    if pt == PT_HSV { return 0x48535620 }
    if pt == PT_HLS { return 0x484C5320 }
    if pt == PT_YXY { return 0x59787920 }
    if pt >= PT_MCH1 && pt <= PT_MCH15 {
        const n = pt - PT_MCH1 + 1
        // 'MCH1' ... 'MCH9', then 'MCHA' ... 'MCHF'.
        const digit: u64 = if n <= 9 { 0x30 + n } else { 0x41 + n - 10 }
        return 0x4D434800 | digit
    }
    return 0
}

// _cmsLCMScolorSpace.
pub fn lcmsColorSpace(space: u64) -> u64 {
    if space == profile.SPACE_GRAY { return PT_GRAY }
    if space == profile.SPACE_RGB { return PT_RGB }
    if space == profile.SPACE_CMY { return PT_CMY }
    if space == profile.SPACE_CMYK { return PT_CMYK }
    if space == 0x59436272 { return PT_YCBCR }
    if space == 0x4C757620 { return PT_YUV }
    if space == profile.SPACE_XYZ { return PT_XYZ }
    if space == profile.SPACE_LAB { return PT_LAB }
    if space == 0x4C75764B { return PT_YUVK }
    if space == 0x48535620 { return PT_HSV }
    if space == 0x484C5320 { return PT_HLS }
    if space == 0x59787920 { return PT_YXY }
    // 'nCLR' (n colours) and 'MCHn'.
    if (space & 0xffffff00) == 0x4D434800 {
        const c = space & 255
        if c >= 0x31 && c <= 0x39 { return PT_MCH1 + c - 0x31 }
        if c >= 0x41 && c <= 0x46 { return PT_MCH1 + 9 + c - 0x41 }
    }
    if (space & 0x00ffffff) == 0x00434C52 {
        const c = (space >> 24) & 255
        if c >= 0x31 && c <= 0x39 { return PT_MCH1 + c - 0x31 }
        if c >= 0x41 && c <= 0x46 { return PT_MCH1 + 9 + c - 0x41 }
    }
    return 0
}
