// std.png.rows: what is done to a PNG's rows once they are inflated: the
// filters undone, the interlaced passes' geometry (Adam7), a pass's row
// spread over the image's width and combined into a whole row, and the
// pixel transformations libpng offers (palette and low depths expanded,
// transparency made alpha, grey made RGB, gamma correction, 16 bits cut
// to 8, filler bytes, byte swapping...), each the routine of libpng
// 1.6.43 (pngrtran.c, pngrutil.c, pngtrans.c, png.c) with the same
// results byte for byte, so that the C API (compiler/libc/png) gives
// what libpng gives. std.png (png.mlx) uses them to decode whole images.
//
// A row is worked on in place at an address (its first pixel; the filter
// byte before it); a RowInfo says what the row holds now and is updated
// by each transformation. The buffer must have room for the widest form
// the row takes (eight bytes a pixel, eight pixels' worth of rounding).
//
// Arithmetic is done in 64-bit words and narrowed values are masked first.
const zs = @import("../flate/stream.mlx")
const math = @import("../math.mlx")

pub const Allocator = zs.Allocator

pub const RowInfo = struct {
    width: usize
    rowBytes: usize
    colorType: usize
    bitDepth: usize
    channels: usize
    pixelDepth: usize
}

inline fn get8(address: usize) -> usize { return @intCast(usize, zs.get8(address)) }
inline fn put8(address: usize, value: usize) -> void { zs.put8(address, value) }

// PNG_ROWBYTES.
pub fn rowBytes(depth: usize, width: usize) -> usize {
    if depth >= 8 { return width * (depth >> 3) }
    return (width * depth + 7) >> 3
}

// ---------------------------------------------------------------------------
// Adam7: where each pass starts and how far apart its pixels are.

pub fn passStartColumn(pass: usize) -> usize {
    const values = [7]usize{ 0, 4, 0, 2, 0, 1, 0 }
    return values[pass]
}

pub fn passColumnStep(pass: usize) -> usize {
    const values = [7]usize{ 8, 8, 4, 4, 2, 2, 1 }
    return values[pass]
}

pub fn passStartRow(pass: usize) -> usize {
    const values = [7]usize{ 0, 0, 4, 0, 2, 0, 1 }
    return values[pass]
}

pub fn passRowStep(pass: usize) -> usize {
    const values = [7]usize{ 8, 8, 8, 4, 4, 2, 2 }
    return values[pass]
}

// The pixels of a row of PASS in an image WIDTH wide (0: none).
pub fn passWidth(pass: usize, width: usize) -> usize {
    const start = passStartColumn(pass)
    const step = passColumnStep(pass)
    return (width + step - 1 - start) / step
}

// The rows of PASS in an image HEIGHT high.
pub fn passHeight(pass: usize, height: usize) -> usize {
    const start = passStartRow(pass)
    const step = passRowStep(pass)
    return (height + step - 1 - start) / step
}

// ---------------------------------------------------------------------------
// Filters (png_read_filter_row): ROW and PREVIOUS point at the first byte
// after the filter byte; PIXEL the bytes of a pixel (at least 1).

fn paeth(left: usize, up: usize, corner: usize) -> usize {
    const p = @intCast(i64, left) + @intCast(i64, up) - @intCast(i64, corner)
    var pa = p - @intCast(i64, left)
    var pb = p - @intCast(i64, up)
    var pc = p - @intCast(i64, corner)
    if pa < 0 { pa = -pa }
    if pb < 0 { pb = -pb }
    if pc < 0 { pc = -pc }
    if pa <= pb && pa <= pc { return left }
    if pb <= pc { return up }
    return corner
}

// Undoes FILTER (1 sub, 2 up, 3 average, 4 Paeth) over COUNT bytes.
pub fn unfilter(filter: usize, row: usize, previous: usize, count: usize, pixel: usize) -> void {
    var index: usize = 0
    if filter == 1 {
        index = pixel
        while index < count {
            put8(row + index, get8(row + index) + get8(row + index - pixel))
            index += 1
        }
    } else if filter == 2 {
        while index < count {
            put8(row + index, get8(row + index) + get8(previous + index))
            index += 1
        }
    } else if filter == 3 {
        while index < count {
            var left: usize = 0
            if index >= pixel { left = get8(row + index - pixel) }
            put8(row + index, get8(row + index) + ((left + get8(previous + index)) >> 1))
            index += 1
        }
    } else if filter == 4 {
        while index < count {
            var left: usize = 0
            var corner: usize = 0
            if index >= pixel {
                left = get8(row + index - pixel)
                corner = get8(previous + index - pixel)
            }
            put8(row + index, get8(row + index) + paeth(left, get8(previous + index), corner))
            index += 1
        }
    }
}

// ---------------------------------------------------------------------------
// Pixels of fewer than 8 bits, most significant first (or least, with
// `swapped`: libpng's PNG_PACKSWAP).

inline fn bitShift(index: usize, depth: usize, swapped: bool) -> usize {
    const position = (index * depth) & 7
    if swapped { return position }
    return 8 - depth - position
}

pub fn getPixel(row: usize, index: usize, depth: usize, swapped: bool) -> usize {
    const at = row + ((index * depth) >> 3)
    return (get8(at) >> bitShift(index, depth, swapped)) & ((@intCast(usize, 1) << depth) - 1)
}

pub fn setPixel(row: usize, index: usize, depth: usize, swapped: bool, value: usize) -> void {
    const at = row + ((index * depth) >> 3)
    const shift = bitShift(index, depth, swapped)
    const mask = ((@intCast(usize, 1) << depth) - 1) << shift
    put8(at, (get8(at) & (255 ^ mask)) | ((value << shift) & mask))
}

// ---------------------------------------------------------------------------
// The interlaced passes (png_do_read_interlace, png_combine_row)

// Spreads a row of PASS (info.width pixels) over the image's width, each
// pixel repeated as far as the next one of the pass; the row's width
// becomes width * step.
pub fn expandInterlaced(info: *RowInfo, row: usize, pass: usize, swapped: bool) -> void {
    const step = passColumnStep(pass)
    const width = info.*.width
    const finalWidth = width * step
    const depth = info.*.pixelDepth
    if depth < 8 {
        var index = width
        while index > 0 {
            index -= 1
            const value = getPixel(row, index, depth, swapped)
            var copy: usize = 0
            while copy < step {
                setPixel(row, index * step + copy, depth, swapped, value)
                copy += 1
            }
        }
    } else {
        const bytes = depth >> 3
        var index = width
        while index > 0 {
            index -= 1
            var copy = step
            while copy > 0 {
                copy -= 1
                if index * step + copy != index { zs.move(row + (index * step + copy) * bytes, row + index * bytes, bytes) }
            }
        }
    }
    info.*.width = finalWidth
    info.*.rowBytes = rowBytes(depth, finalWidth)
}

// The masks of png_combine_row for pixels below 8 bits: which bits of 8
// pixels a pass's row (`display` false) or its 'blocky' display copies.
fn combineMask(pass: usize, depth: usize, display: bool, swapped: bool) -> usize {
    var total: usize = 0
    var x: usize = 0
    while x < 8 {
        var copy: usize = 0
        if display {
            if pass < 4 { copy = (0xff0fff33 >> ((3 - pass) * 8 + (7 - x))) & 1 } else { copy = (0xff55ff00 >> ((7 - pass) * 8 + (7 - x))) & 1 }
        } else {
            if pass < 4 { copy = (0x80088822 >> ((3 - pass) * 8 + (7 - x))) & 1 } else { copy = (0xaa55ff00 >> ((7 - pass) * 8 + (7 - x))) & 1 }
        }
        if copy != 0 {
            var shift = x * depth
            if !swapped { shift = shift ^ (8 - depth) }
            total += ((@intCast(usize, 1) << depth) - 1) << shift
        }
        x += 1
    }
    if depth == 1 { return (total * 0x01010101) & 0xffffffff }
    if depth == 2 { return (total * 0x00010001) & 0xffffffff }
    return total & 0xffffffff
}

// png_combine_row: the pixels of the row in SOURCE (as the transforms
// left it, PIXELDEPTH bits a pixel) that PASS gives, copied into TARGET,
// a row WIDTH pixels wide. `interlacing`: the passes are being combined
// (libpng's PNG_INTERLACE on an interlaced image); `display` 1 copies a
// pass's pixels over the ones later passes give (libpng's 'blocky'
// progressive display), 0 only its own.
pub fn combineRow(target: usize, source: usize, width: usize, pixelDepth: usize, pass: usize, interlacing: bool, display: usize, swapped: bool) -> void {
    var endAt: usize = 0
    var endByte: usize = 0
    var endMask = (pixelDepth * width) & 7
    if endMask != 0 {
        endAt = target + rowBytes(pixelDepth, width) - 1
        endByte = get8(endAt)
        if swapped { endMask = (0xff << endMask) & 255 } else { endMask = 0xff >> endMask }
    }
    if interlacing && pass < 6 && (display == 0 || (display == 1 && pass & 1 != 0)) {
        if width <= passStartColumn(pass) { return }
        if pixelDepth < 8 {
            const perByte = 8 / pixelDepth
            var mask = combineMask(pass, pixelDepth, display != 0, swapped)
            var remaining = width
            var dp = target
            var sp = source
            while true {
                var m = mask
                mask = ((m >> 8) | (m << 24)) & 0xffffffff
                m = m & 255
                if m != 0 {
                    if m != 255 { put8(dp, (get8(dp) & (255 ^ m)) | (get8(sp) & m)) } else { put8(dp, get8(sp)) }
                }
                if remaining <= perByte { break }
                remaining -= perByte
                dp += 1
                sp += 1
            }
        } else {
            const pixelBytes = pixelDepth >> 3
            var remaining = width * pixelBytes
            const offset = passStartColumn(pass) * pixelBytes
            remaining -= offset
            var dp = target + offset
            var sp = source + offset
            var bytesToCopy = pixelBytes
            if display != 0 {
                bytesToCopy = (@intCast(usize, 1) << ((6 - pass) >> 1)) * pixelBytes
                if bytesToCopy > remaining { bytesToCopy = remaining }
            }
            const bytesToJump = passColumnStep(pass) * pixelBytes
            while true {
                zs.copy(dp, sp, bytesToCopy)
                if remaining <= bytesToJump { return }
                sp += bytesToJump
                dp += bytesToJump
                remaining -= bytesToJump
                if bytesToCopy > remaining { bytesToCopy = remaining }
            }
        }
    } else {
        zs.copy(target, source, rowBytes(pixelDepth, width))
    }
    if endAt != 0 { put8(endAt, (endByte & endMask) | (get8(endAt) & (255 ^ endMask))) }
}

// ---------------------------------------------------------------------------
// Transformations, in the order libpng applies them

// png_do_expand_palette: indices to RGB, or RGBA when NUMTRANS entries
// have alpha (TRANSALPHA). PALETTE has 256 entries (zero past the file's).
pub fn expandPalette(info: *RowInfo, row: usize, palette: usize, transAlpha: usize, numTrans: usize) -> void {
    if info.*.colorType != 3 { return }
    const width = info.*.width
    if info.*.bitDepth < 8 {
        const depth = info.*.bitDepth
        var index = width
        while index > 0 {
            index -= 1
            put8(row + index, getPixel(row, index, depth, false))
        }
        info.*.bitDepth = 8
        info.*.pixelDepth = 8
        info.*.rowBytes = width
    }
    if info.*.bitDepth != 8 { return }
    if numTrans > 0 {
        var index = width
        while index > 0 {
            index -= 1
            const entry = get8(row + index)
            const at = row + index * 4
            const alpha = if entry >= numTrans { 255 } else { get8(transAlpha + entry) }
            put8(at + 3, alpha)
            put8(at + 2, get8(palette + entry * 3 + 2))
            put8(at + 1, get8(palette + entry * 3 + 1))
            put8(at, get8(palette + entry * 3))
        }
        info.*.pixelDepth = 32
        info.*.rowBytes = width * 4
        info.*.colorType = 6
        info.*.channels = 4
    } else {
        var index = width
        while index > 0 {
            index -= 1
            const entry = get8(row + index)
            const at = row + index * 3
            put8(at + 2, get8(palette + entry * 3 + 2))
            put8(at + 1, get8(palette + entry * 3 + 1))
            put8(at, get8(palette + entry * 3))
        }
        info.*.pixelDepth = 24
        info.*.rowBytes = width * 3
        info.*.colorType = 2
        info.*.channels = 3
    }
}

// png_do_expand: grey below 8 bits to 8, and with `hasTrans` the
// transparent colour (TRANSGRAY, or TRANSRED/GREEN/BLUE) to an alpha
// channel.
pub fn expand(info: *RowInfo, row: usize, hasTrans: bool, transGray: usize, transRed: usize, transGreen: usize, transBlue: usize) -> void {
    const width = info.*.width
    if info.*.colorType == 0 {
        var gray = if hasTrans { transGray } else { 0 }
        if info.*.bitDepth < 8 {
            const depth = info.*.bitDepth
            var scale: usize = 0x11
            if depth == 1 { scale = 0xff } else if depth == 2 { scale = 0x55 }
            gray = (gray & ((@intCast(usize, 1) << depth) - 1)) * scale
            var index = width
            while index > 0 {
                index -= 1
                put8(row + index, getPixel(row, index, depth, false) * scale)
            }
            info.*.bitDepth = 8
            info.*.pixelDepth = 8
            info.*.rowBytes = width
        }
        if hasTrans {
            if info.*.bitDepth == 8 {
                gray = gray & 255
                var index = width
                while index > 0 {
                    index -= 1
                    const value = get8(row + index)
                    put8(row + index * 2 + 1, if value == gray { 0 } else { 255 })
                    put8(row + index * 2, value)
                }
            } else if info.*.bitDepth == 16 {
                var index = width
                while index > 0 {
                    index -= 1
                    const high = get8(row + index * 2)
                    const low = get8(row + index * 2 + 1)
                    const alpha = if high == ((gray >> 8) & 255) && low == (gray & 255) { 0 } else { 255 }
                    put8(row + index * 4 + 3, alpha)
                    put8(row + index * 4 + 2, alpha)
                    put8(row + index * 4 + 1, low)
                    put8(row + index * 4, high)
                }
            }
            info.*.colorType = 4
            info.*.channels = 2
            info.*.pixelDepth = info.*.bitDepth << 1
            info.*.rowBytes = rowBytes(info.*.pixelDepth, width)
        }
    } else if info.*.colorType == 2 && hasTrans {
        if info.*.bitDepth == 8 {
            var index = width
            while index > 0 {
                index -= 1
                const red = get8(row + index * 3)
                const green = get8(row + index * 3 + 1)
                const blue = get8(row + index * 3 + 2)
                const opaque = !(red == (transRed & 255) && green == (transGreen & 255) && blue == (transBlue & 255))
                put8(row + index * 4 + 3, if opaque { 255 } else { 0 })
                put8(row + index * 4 + 2, blue)
                put8(row + index * 4 + 1, green)
                put8(row + index * 4, red)
            }
        } else if info.*.bitDepth == 16 {
            var index = width
            while index > 0 {
                index -= 1
                const source = row + index * 6
                const red = (get8(source) << 8) | get8(source + 1)
                const green = (get8(source + 2) << 8) | get8(source + 3)
                const blue = (get8(source + 4) << 8) | get8(source + 5)
                const alpha = if red == (transRed & 0xffff) && green == (transGreen & 0xffff) && blue == (transBlue & 0xffff) { 0 } else { 255 }
                const target = row + index * 8
                put8(target + 7, alpha)
                put8(target + 6, alpha)
                var byte: usize = 6
                while byte > 0 {
                    byte -= 1
                    put8(target + byte, get8(source + byte))
                }
            }
        }
        info.*.colorType = 6
        info.*.channels = 4
        info.*.pixelDepth = info.*.bitDepth << 2
        info.*.rowBytes = rowBytes(info.*.pixelDepth, width)
    }
}

// png_do_expand_16: 8-bit samples to 16 (each byte twice).
pub fn expand16(info: *RowInfo, row: usize) -> void {
    if info.*.bitDepth != 8 || info.*.colorType == 3 { return }
    var index = info.*.rowBytes
    while index > 0 {
        index -= 1
        const value = get8(row + index)
        put8(row + index * 2 + 1, value)
        put8(row + index * 2, value)
    }
    info.*.rowBytes = info.*.rowBytes * 2
    info.*.bitDepth = 16
    info.*.pixelDepth = info.*.channels * 16
}

// png_do_strip_channel (pngtrans.c): drops the alpha (last) channel, or
// with `atStart` the first.
pub fn stripChannel(info: *RowInfo, row: usize, atStart: bool) -> void {
    const channels = info.*.channels
    if !(channels == 2 && info.*.bitDepth >= 8) && channels != 4 { return }
    const sample = info.*.bitDepth >> 3
    const width = info.*.width
    var out: usize = 0
    var index: usize = 0
    while index < width {
        var channel: usize = 0
        while channel < channels {
            const keep = if atStart { channel != 0 } else { channel != channels - 1 }
            if keep {
                var byte: usize = 0
                while byte < sample {
                    put8(row + out, get8(row + (index * channels + channel) * sample + byte))
                    out += 1
                    byte += 1
                }
            }
            channel += 1
        }
        index += 1
    }
    info.*.channels = channels - 1
    info.*.pixelDepth = info.*.channels * info.*.bitDepth
    info.*.rowBytes = rowBytes(info.*.pixelDepth, width)
    if info.*.colorType == 4 { info.*.colorType = 0 } else if info.*.colorType == 6 { info.*.colorType = 2 }
}

// png_do_gray_to_rgb: grey (8 or 16 bits, with or without alpha) to RGB.
pub fn grayToRgb(info: *RowInfo, row: usize) -> void {
    if info.*.bitDepth < 8 || info.*.colorType & 2 != 0 { return }
    const width = info.*.width
    const sample = info.*.bitDepth >> 3
    const alpha = info.*.colorType == 4
    const inPixel = if alpha { 2 * sample } else { sample }
    const outPixel = if alpha { 4 * sample } else { 3 * sample }
    var index = width
    while index > 0 {
        index -= 1
        const source = row + index * inPixel
        const target = row + index * outPixel
        if alpha {
            var byte = sample
            while byte > 0 {
                byte -= 1
                put8(target + 3 * sample + byte, get8(source + sample + byte))
            }
        }
        var copy: usize = 3
        while copy > 0 {
            copy -= 1
            var byte = sample
            while byte > 0 {
                byte -= 1
                put8(target + copy * sample + byte, get8(source + byte))
            }
        }
    }
    info.*.channels = info.*.channels + 2
    info.*.colorType = info.*.colorType | 2
    info.*.pixelDepth = info.*.channels * info.*.bitDepth
    info.*.rowBytes = rowBytes(info.*.pixelDepth, width)
}

// png_do_gamma: the colour samples (not alpha) through the tables: TABLE8
// (256 bytes) at 8 bits and below, TABLE16 at 16 (sub-tables of 256
// words, the sample's low byte >> SHIFT choosing one, its high byte the
// entry).
pub fn gamma(info: *RowInfo, row: usize, table8: usize, table16: usize, shift: usize) -> void {
    const width = info.*.width
    const depth = info.*.bitDepth
    if !((depth <= 8 && table8 != 0) || (depth == 16 && table16 != 0)) { return }
    const colorType = info.*.colorType
    var colors: usize = 1
    var stride: usize = 1
    if colorType == 2 {
        colors = 3
        stride = 3
    } else if colorType == 6 {
        colors = 3
        stride = 4
    } else if colorType == 4 {
        stride = 2
    } else if colorType != 0 {
        return
    }
    if depth == 8 {
        var index: usize = 0
        while index < width {
            var channel: usize = 0
            while channel < colors {
                const at = row + index * stride + channel
                put8(at, get8(table8 + get8(at)))
                channel += 1
            }
            index += 1
        }
    } else if depth == 16 {
        var index: usize = 0
        while index < width {
            var channel: usize = 0
            while channel < colors {
                const at = row + (index * stride + channel) * 2
                const entry = ((get8(at + 1) >> shift) << 8) + get8(at)
                const value = @intCast(usize, zs.get16(table16 + entry * 2))
                put8(at, value >> 8)
                put8(at + 1, value & 255)
                channel += 1
            }
            index += 1
        }
    } else if colorType == 0 && depth == 2 {
        var index: usize = 0
        while index < width {
            const at = row + index / 4
            const byte = get8(at)
            const a = byte & 0xc0
            const b = byte & 0x30
            const c = byte & 0x0c
            const d = byte & 0x03
            put8(at, (get8(table8 + (a | (a >> 2) | (a >> 4) | (a >> 6))) & 0xc0) | ((get8(table8 + ((b << 2) | b | (b >> 2) | (b >> 4))) >> 2) & 0x30) | ((get8(table8 + ((c << 4) | (c << 2) | c | (c >> 2))) >> 4) & 0x0c) | (get8(table8 + ((d << 6) | (d << 4) | (d << 2) | d)) >> 6))
            index += 4
        }
    } else if colorType == 0 && depth == 4 {
        var index: usize = 0
        while index < width {
            const at = row + index / 2
            const byte = get8(at)
            const high = byte & 0xf0
            const low = byte & 0x0f
            put8(at, (get8(table8 + (high | (high >> 4))) & 0xf0) | (get8(table8 + ((low << 4) | low)) >> 4))
            index += 2
        }
    }
}

// png_do_chop: 16-bit samples to their high byte.
pub fn chop16(info: *RowInfo, row: usize) -> void {
    if info.*.bitDepth != 16 { return }
    var index: usize = 0
    const count = info.*.rowBytes / 2
    while index < count {
        put8(row + index, get8(row + index * 2))
        index += 1
    }
    info.*.bitDepth = 8
    info.*.pixelDepth = 8 * info.*.channels
    info.*.rowBytes = info.*.width * info.*.channels
}

// png_do_scale_16_to_8: 16-bit samples scaled (rounded) to 8 bits.
pub fn scale16(info: *RowInfo, row: usize) -> void {
    if info.*.bitDepth != 16 { return }
    var index: usize = 0
    const count = info.*.rowBytes / 2
    while index < count {
        var value = @intCast(i64, get8(row + index * 2))
        value += ((@intCast(i64, get8(row + index * 2 + 1)) - value + 128) * 65535) >> 24
        put8(row + index, @intCast(usize, value) & 255)
        index += 1
    }
    info.*.bitDepth = 8
    info.*.pixelDepth = 8 * info.*.channels
    info.*.rowBytes = info.*.width * info.*.channels
}

// png_do_invert: grey samples inverted (not alpha).
pub fn invertMono(info: *RowInfo, row: usize) -> void {
    if info.*.colorType == 0 {
        var index: usize = 0
        while index < info.*.rowBytes {
            put8(row + index, 255 ^ get8(row + index))
            index += 1
        }
    } else if info.*.colorType == 4 {
        const sample = info.*.bitDepth >> 3
        var index: usize = 0
        while index < info.*.rowBytes {
            var byte: usize = 0
            while byte < sample {
                put8(row + index + byte, 255 ^ get8(row + index + byte))
                byte += 1
            }
            index += 2 * sample
        }
    }
}

// png_do_read_invert_alpha: the alpha channel inverted.
pub fn invertAlpha(info: *RowInfo, row: usize) -> void {
    if info.*.colorType & 4 == 0 { return }
    const sample = info.*.bitDepth >> 3
    const pixel = info.*.channels * sample
    var index: usize = 0
    while index < info.*.width {
        var byte: usize = 0
        while byte < sample {
            const at = row + index * pixel + pixel - sample + byte
            put8(at, 255 ^ get8(at))
            byte += 1
        }
        index += 1
    }
}

// png_do_unpack: pixels of 1, 2 or 4 bits to a byte each, values kept.
pub fn unpack(info: *RowInfo, row: usize) -> void {
    if info.*.bitDepth >= 8 { return }
    const depth = info.*.bitDepth
    var index = info.*.width
    while index > 0 {
        index -= 1
        put8(row + index, getPixel(row, index, depth, false))
    }
    info.*.bitDepth = 8
    info.*.pixelDepth = 8 * info.*.channels
    info.*.rowBytes = info.*.width * info.*.channels
}

// png_do_bgr: red and blue swapped.
pub fn bgr(info: *RowInfo, row: usize) -> void {
    if info.*.colorType != 2 && info.*.colorType != 6 { return }
    const sample = info.*.bitDepth >> 3
    if sample == 0 { return }
    const pixel = info.*.channels * sample
    var index: usize = 0
    while index < info.*.width {
        var byte: usize = 0
        while byte < sample {
            const red = row + index * pixel + byte
            const blue = red + 2 * sample
            const value = get8(red)
            put8(red, get8(blue))
            put8(blue, value)
            byte += 1
        }
        index += 1
    }
}

// png_do_packswap: the order of the pixels in each byte reversed.
pub fn packswap(info: *RowInfo, row: usize) -> void {
    const depth = info.*.bitDepth
    if depth >= 8 { return }
    var index: usize = 0
    while index < info.*.rowBytes {
        const byte = get8(row + index)
        var result: usize = 0
        var bit: usize = 0
        while bit < 8 {
            const value = (byte >> bit) & ((@intCast(usize, 1) << depth) - 1)
            result |= value << (8 - depth - bit)
            bit += depth
        }
        put8(row + index, result)
        index += 1
    }
}

// png_do_read_filler: a filler sample (FILLER's low byte at 8 bits, both
// at 16) after or before each grey or RGB pixel.
pub fn filler(info: *RowInfo, row: usize, value: usize, after: bool) -> void {
    const colorType = info.*.colorType
    const depth = info.*.bitDepth
    if (colorType != 0 && colorType != 2) || (depth != 8 && depth != 16) { return }
    const sample = depth >> 3
    const channels = if colorType == 0 { 1 } else { 3 }
    const inPixel = channels * sample
    const outPixel = inPixel + sample
    var index = info.*.width
    while index > 0 {
        index -= 1
        const source = row + index * inPixel
        const target = row + index * outPixel
        const colorAt = if after { target } else { target + sample }
        const fillAt = if after { target + inPixel } else { target }
        var byte = inPixel
        while byte > 0 {
            byte -= 1
            put8(colorAt + byte, get8(source + byte))
        }
        if sample == 2 {
            put8(fillAt, (value >> 8) & 255)
            put8(fillAt + 1, value & 255)
        } else {
            put8(fillAt, value & 255)
        }
    }
    info.*.channels = channels + 1
    info.*.pixelDepth = info.*.channels * depth
    info.*.rowBytes = info.*.width * (outPixel)
}

// png_do_read_swap_alpha: RGBA to ARGB (and grey-alpha to alpha-grey).
pub fn swapAlpha(info: *RowInfo, row: usize) -> void {
    if info.*.colorType & 4 == 0 { return }
    const sample = info.*.bitDepth >> 3
    const pixel = info.*.channels * sample
    var index: usize = 0
    while index < info.*.width {
        const at = row + index * pixel
        var byte: usize = 0
        var alpha: [2]u8 = undefined
        while byte < sample {
            alpha[byte] = zs.get8(at + pixel - sample + byte)
            byte += 1
        }
        zs.move(at + sample, at, pixel - sample)
        byte = 0
        while byte < sample {
            zs.put8(at + byte, @intCast(usize, alpha[byte]))
            byte += 1
        }
        index += 1
    }
}

// png_do_swap: 16-bit samples little-endian.
pub fn swapBytes(info: *RowInfo, row: usize) -> void {
    if info.*.bitDepth != 16 { return }
    var index: usize = 0
    while index + 1 < info.*.rowBytes {
        const high = get8(row + index)
        put8(row + index, get8(row + index + 1))
        put8(row + index + 1, high)
        index += 2
    }
}

// ---------------------------------------------------------------------------
// Gamma (png.c's tables): values are fixed-point, 100000 for 1.0.

// png_reciprocal: 1/a in fixed point (0 on overflow).
pub fn reciprocal(a: i64) -> i64 {
    if a == 0 { return 0 }
    const value = @floor(10000000000.0 / @floatFromInt(f64, a) + 0.5)
    if value <= 2147483647.0 && value >= -2147483648.0 { return @intFromFloat(i64, value) }
    return 0
}

// png_reciprocal2: 1/(a * b).
pub fn reciprocal2(a: i64, b: i64) -> i64 {
    if a != 0 && b != 0 {
        var value = 1000000000000000.0 / @floatFromInt(f64, a)
        value = value / @floatFromInt(f64, b)
        value = @floor(value + 0.5)
        if value <= 2147483647.0 && value >= -2147483648.0 { return @intFromFloat(i64, value) }
    }
    return 0
}

// png_product2: a * b.
pub fn product2(a: i64, b: i64) -> i64 {
    var value = @floatFromInt(f64, a) * 0.00001
    value = value * @floatFromInt(f64, b)
    value = @floor(value + 0.5)
    if value <= 2147483647.0 && value >= -2147483648.0 { return @intFromFloat(i64, value) }
    return 0
}

pub fn gammaSignificant(value: i64) -> bool { return value < 95000 || value > 105000 }

fn power(x: f64, y: f64) -> f64 { return math.pow(x, y) }

// png_gamma_8bit_correct.
pub fn gamma8(value: usize, g: i64) -> usize {
    if value > 0 && value < 255 {
        const fraction = @floatFromInt(f64, value) / 255.0
        const result = @floor(255.0 * power(fraction, @floatFromInt(f64, g) * 0.00001) + 0.5)
        return @intFromFloat(usize, result) & 255
    }
    return value & 255
}

// png_gamma_16bit_correct.
pub fn gamma16(value: usize, g: i64) -> usize {
    if value > 0 && value < 65535 {
        const fraction = @floatFromInt(f64, value) / 65535.0
        const result = @floor(65535.0 * power(fraction, @floatFromInt(f64, g) * 0.00001) + 0.5)
        return @intFromFloat(usize, result) & 0xffff
    }
    return value & 0xffff
}

// png_build_8bit_table into TABLE (256 bytes).
pub fn build8(table: usize, g: i64) -> void {
    var index: usize = 0
    while index < 256 {
        if gammaSignificant(g) { put8(table + index, gamma8(index, g)) } else { put8(table + index, index) }
        index += 1
    }
}

fn put16(address: usize, value: usize) -> void {
    unsafe { @ptrFromInt(*u16, address).* = @intCast(u16, value & 0xffff) }
}

// png_build_16bit_table into TABLE ((256 >> SHIFT) sub-tables of 256
// words).
pub fn build16(table: usize, shift: usize, g: i64) -> void {
    const count = @intCast(usize, 1) << (8 - shift)
    const most = (@intCast(usize, 1) << (16 - shift)) - 1
    const fmax = 1.0 / @floatFromInt(f64, most)
    const half = @intCast(usize, 1) << (15 - shift)
    var sub: usize = 0
    while sub < count {
        var j: usize = 0
        while j < 256 {
            var ig = (j << (8 - shift)) + sub
            var value: usize = 0
            if gammaSignificant(g) {
                const d = @floor(65535.0 * power(@floatFromInt(f64, ig) * fmax, @floatFromInt(f64, g) * 0.00001) + 0.5)
                value = @intFromFloat(usize, d) & 0xffff
            } else {
                if shift != 0 { ig = (ig * 65535 + half) / most }
                value = ig & 0xffff
            }
            put16(table + (sub * 256 + j) * 2, value)
            j += 1
        }
        sub += 1
    }
}

// png_build_16to8_table: for output cut to 8 bits, the 16-bit value whose
// high byte is the closest 8-bit result (G is the inverse gamma).
pub fn build16to8(table: usize, shift: usize, g: i64) -> void {
    const count = @intCast(usize, 1) << (8 - shift)
    const most = (@intCast(usize, 1) << (16 - shift)) - 1
    var last: usize = 0
    var output: usize = 0
    while output < 255 {
        const out = output * 257
        var bound = gamma16(out + 128, g)
        bound = (bound * most + 32768) / 65535 + 1
        while last < bound {
            put16(table + ((last & (0xff >> shift)) * 256 + (last >> (8 - shift))) * 2, out)
            last += 1
        }
        output += 1
    }
    while last < (count << 8) {
        put16(table + ((last & (0xff >> shift)) * 256 + (last >> (8 - shift))) * 2, 65535)
        last += 1
    }
}
