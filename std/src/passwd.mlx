// std.passwd: the accounts of /etc/passwd and the groups of /etc/group,
// found by name or by number. Each line of /etc/passwd is
// name:password:uid:gid:gecos:home:shell, each of /etc/group
// name:password:gid:member,member; a line that is not one (too few
// fields, a number that is not a number) is passed over.
//
//     var text: [65536]u8 = undefined
//     const bytes: [*]u8 = &text
//     const length = std.fs.readFile("/etc/passwd".pointer, bytes, 65536)
//     var user: passwd.User = undefined
//     if passwd.findUserById(bytes[0..length], uid, &user) { ... user.home ... }
//
// The fields are slices of the text, valid as long as it is. Nothing here
// allocates; userById and groupById read the file into a buffer the
// caller gives (64 KiB holds the files of any ordinary system).
const std = @import("std")

pub const User = struct {
    name: []const u8
    password: []const u8
    id: u32
    group: u32
    // The comment field: the person's full name, mostly.
    gecos: []const u8
    home: []const u8
    shell: []const u8
}

pub const Group = struct {
    name: []const u8
    password: []const u8
    id: u32
    // The members' names, comma-separated (empty when it has none).
    members: []const u8
}

// A user or group number: decimal digits, at most 4294967295.
pub fn parseId(text: []const u8, id: *u32) -> bool {
    if text.length == 0 || text.length > 10 { return false }
    var value: u64 = 0
    for byte in text {
        if byte < 48 || byte > 57 { return false }
        value = value * 10 + @intCast(u64, byte - 48)
    }
    if value > 4294967295 { return false }
    id.* = @intCast(u32, value)
    return true
}

// Splits `line` at its colons into `fields` (up to `count`); how many
// there are (`count` + 1 when there are more).
fn split(line: []const u8, fields: *[8][]const u8, count: usize) -> usize {
    var found: usize = 0
    var start: usize = 0
    var at: usize = 0
    while at <= line.length {
        if at == line.length || line[at] == 58 {
            if found == count { return count + 1 }
            fields.*[found] = line[start..at]
            found += 1
            start = at + 1
        }
        at += 1
    }
    return found
}

// One line of /etc/passwd into `user`; false when it is not one.
pub fn parseUser(line: []const u8, user: *User) -> bool {
    var fields: [8][]const u8 = undefined
    if split(line, &fields, 7) != 7 { return false }
    if !parseId(fields[2], &user.*.id) || !parseId(fields[3], &user.*.group) { return false }
    user.*.name = fields[0]
    user.*.password = fields[1]
    user.*.gecos = fields[4]
    user.*.home = fields[5]
    user.*.shell = fields[6]
    return true
}

// One line of /etc/group into `group`; false when it is not one.
pub fn parseGroup(line: []const u8, group: *Group) -> bool {
    var fields: [8][]const u8 = undefined
    if split(line, &fields, 4) != 4 { return false }
    if !parseId(fields[2], &group.*.id) { return false }
    group.*.name = fields[0]
    group.*.password = fields[1]
    group.*.members = fields[3]
    return true
}

// The line of `text` from `at` (without its line feed), `at` moved past it.
fn nextLine(text: []const u8, at: *usize) -> []const u8 {
    const start = at.*
    var end = start
    while end < text.length && text[end] != 10 { end += 1 }
    at.* = end + 1
    return text[start..end]
}

// The first account of `text` (an /etc/passwd) named `name`, into `user`;
// false when there is none.
pub fn findUserNamed(text: []const u8, name: []const u8, user: *User) -> bool {
    var at: usize = 0
    while at < text.length {
        if parseUser(nextLine(text, &at), user) && std.text.same(user.*.name, name) { return true }
    }
    return false
}

// The first account of `text` whose number is `id`; false when there is
// none.
pub fn findUserById(text: []const u8, id: u32, user: *User) -> bool {
    var at: usize = 0
    while at < text.length {
        if parseUser(nextLine(text, &at), user) && user.*.id == id { return true }
    }
    return false
}

// The first group of `text` (an /etc/group) named `name`.
pub fn findGroupNamed(text: []const u8, name: []const u8, group: *Group) -> bool {
    var at: usize = 0
    while at < text.length {
        if parseGroup(nextLine(text, &at), group) && std.text.same(group.*.name, name) { return true }
    }
    return false
}

// The first group of `text` whose number is `id`.
pub fn findGroupById(text: []const u8, id: u32, group: *Group) -> bool {
    var at: usize = 0
    while at < text.length {
        if parseGroup(nextLine(text, &at), group) && group.*.id == id { return true }
    }
    return false
}

// The account numbered `id` in /etc/passwd, read into `buffer`
// (`capacity` bytes; the fields point into it); false when there is none
// or the file cannot be read.
pub fn userById(id: u32, buffer: [*]u8, capacity: usize, user: *User) -> bool {
    const length = std.fs.readFile("/etc/passwd".pointer, buffer, capacity)
    return findUserById(buffer[0..length], id, user)
}

// The account named `name` in /etc/passwd, as userById.
pub fn userNamed(name: []const u8, buffer: [*]u8, capacity: usize, user: *User) -> bool {
    const length = std.fs.readFile("/etc/passwd".pointer, buffer, capacity)
    return findUserNamed(buffer[0..length], name, user)
}

// The group numbered `id` in /etc/group, as userById.
pub fn groupById(id: u32, buffer: [*]u8, capacity: usize, group: *Group) -> bool {
    const length = std.fs.readFile("/etc/group".pointer, buffer, capacity)
    return findGroupById(buffer[0..length], id, group)
}

// The group named `name` in /etc/group, as userById.
pub fn groupNamed(name: []const u8, buffer: [*]u8, capacity: usize, group: *Group) -> bool {
    const length = std.fs.readFile("/etc/group".pointer, buffer, capacity)
    return findGroupNamed(buffer[0..length], name, group)
}
