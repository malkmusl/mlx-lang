// Portable operating-system namespace. Target-independent adapters live here;
// target ABI details remain isolated below std.os.<target>.
const builtin = @import("builtin")

pub const linux = @import("../bootstrap/os/linux.mlx")
// brixOS's own calls (spec/04-stdlib/os/brix.xml).
pub const brix = @import("../bootstrap/os/brix.mlx")

// How many processors this program can run on (at least 1): what to size
// a pool of workers or a build's jobs by. On brixOS the kernel's own word
// (system_info: every processor the firmware lists runs programs); on
// Linux the processors the program's affinity allows (sched_getaffinity,
// as nproc counts them: a container's or taskset's limit included).
pub fn processorCount() -> usize {
    if comptime builtin.os == builtin.Os.brixos { return brix.processorCount() }
    return linux.system.availableProcessorCount()
}
