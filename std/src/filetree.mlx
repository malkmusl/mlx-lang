// std.filetree: what a file manager does to files and folders, with
// everything in them, by the kernel's calls alone (no cp, mv or rm): copy,
// move (renamed when it can be, else copied and then removed: another file
// system) and remove. Nothing is overwritten. Paths are NUL-terminated;
// they may be up to PATH_MAX bytes and nested as deep as the stack lets
// (a few KiB a level).
const std = @import("std")

const fs = std.fs
const linux = std.linux

pub const PATH_MAX: usize = 4096

// struct stat's mode: the kind of file.
const MODE_KIND: u32 = 61440
const MODE_DIRECTORY: u32 = 16384
const MODE_FILE: u32 = 32768
const MODE_LINK: u32 = 40960
const OPEN_EXCLUSIVE: usize = 128
const AT_CURRENT_WORKING_DIRECTORY: usize = 18446744073709551516 // -100
const RENAME_NO_REPLACE: usize = 1
const EXDEV: isize = -18
const EINVAL: isize = -22

// A path being built: `length` bytes and a NUL.
const Path = struct {
    bytes: [4096]u8
    length: usize
}

fn load(path: *Path, text: [*]const u8) -> bool {
    path.*.length = 0
    while text[path.*.length] != 0 {
        if path.*.length + 1 >= PATH_MAX { return false }
        path.*.bytes[path.*.length] = text[path.*.length]
        path.*.length += 1
    }
    path.*.bytes[path.*.length] = 0
    return true
}

// path + "/" + name; false when it would not fit.
fn push(path: *Path, name: []const u8) -> bool {
    if path.*.length + 1 + name.length + 1 > PATH_MAX { return false }
    path.*.bytes[path.*.length] = 47
    var index: usize = 0
    while index < name.length {
        path.*.bytes[path.*.length + 1 + index] = name[index]
        index += 1
    }
    path.*.length += 1 + name.length
    path.*.bytes[path.*.length] = 0
    return true
}

fn cut(path: *Path, length: usize) -> void {
    path.*.length = length
    path.*.bytes[length] = 0
}

fn textOf(path: *Path) -> [*]const u8 {
    unsafe { return @ptrCast([*]const u8, path) }
}

// Whether something (even a dangling link) is at `path`.
pub fn exists(path: [*]const u8) -> bool {
    var status: fs.Stat = undefined
    return fs.statusAt(path, &status, true) == 0
}

// Copies `source` to `target` (which must not be there yet): a file with
// its bytes, mode and modification time, a folder with everything in it, a
// symbolic link as a link. False when anything could not be copied (what
// could be stays).
pub fn copy(source: [*]const u8, target: [*]const u8) -> bool {
    var from: Path = undefined
    var to: Path = undefined
    if !load(&from, source) || !load(&to, target) { return false }
    if exists(target) { return false }
    // Not into itself.
    if from.length <= to.length && std.text.same(from.bytes[0..from.length], to.bytes[0..from.length]) && (to.length == from.length || to.bytes[from.length] == 47) { return false }
    return copyAt(&from, &to)
}

fn copyAt(from: *Path, to: *Path) -> bool {
    var status: fs.Stat = undefined
    if fs.statusAt(textOf(from), &status, true) != 0 { return false }
    const kind = status.mode & MODE_KIND
    if kind == MODE_LINK {
        var link: [4096]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &link) }
        const length = fs.readLink(textOf(from), bytes, PATH_MAX - 1)
        if length < 0 { return false }
        bytes[@intCast(usize, length)] = 0
        return fs.symbolicLink(bytes, textOf(to))
    }
    if kind == MODE_DIRECTORY { return copyDirectory(from, to, status.mode & 4095) }
    if kind != MODE_FILE { return false }
    if !copyFile(textOf(from), textOf(to), status.mode & 4095) { return false }
    const timed = fs.setTimes(textOf(to), status.accessedSeconds, status.accessedNanoseconds, status.modifiedSeconds, status.modifiedNanoseconds, true)
    return true
}

fn copyFile(source: [*]const u8, target: [*]const u8, mode: u32) -> bool {
    const input = fs.open(source, fs.READ_ONLY, 0)
    if !fs.isValid(input) { return false }
    const output = fs.open(target, fs.WRITE_ONLY | fs.CREATE | OPEN_EXCLUSIVE, @intCast(usize, mode))
    if !fs.isValid(output) {
        const closed = fs.close(input)
        return false
    }
    var buffer: [65536]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var ok = true
    while ok {
        const got = fs.read(input, bytes, 65536)
        if got < 0 { ok = false }
        if got <= 0 { break }
        if !fs.writeAllBytes(output, bytes, @intCast(usize, got)) { ok = false }
    }
    const closed_input = fs.close(input)
    const closed_output = fs.close(output)
    if !ok { const removed = fs.delete(target) }
    return ok
}

fn copyDirectory(from: *Path, to: *Path, mode: u32) -> bool {
    // Writable for us while it fills, its own mode after.
    if !fs.makeDir(textOf(to), @intCast(usize, mode | 448)) { return false }
    const directory = fs.open(textOf(from), fs.READ_ONLY | fs.DIRECTORY, 0)
    if !fs.isValid(directory) { return false }
    var buffer: [8192]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var reader = fs.entries(directory, bytes, 8192)
    var entry: fs.Entry = undefined
    var ok = true
    const from_length = from.*.length
    const to_length = to.*.length
    while fs.nextEntry(&reader, &entry) {
        if !fs.isDotName(entry.name) {
            const name = entry.name.pointer[0..entry.name.length]
            if push(from, name) && push(to, name) {
                if !copyAt(from, to) { ok = false }
            } else {
                ok = false
            }
            cut(from, from_length)
            cut(to, to_length)
        }
    }
    if reader.failed { ok = false }
    const closed = fs.close(directory)
    const moded = fs.chmod(textOf(to), @intCast(usize, mode))
    return ok
}

// Removes `path` and, for a folder, everything in it. False when anything
// stayed.
pub fn remove(path: [*]const u8) -> bool {
    var at: Path = undefined
    if !load(&at, path) { return false }
    return removeAt(&at)
}

fn removeAt(path: *Path) -> bool {
    var status: fs.Stat = undefined
    if fs.statusAt(textOf(path), &status, true) != 0 { return false }
    if status.mode & MODE_KIND != MODE_DIRECTORY { return fs.delete(textOf(path)) }
    const directory = fs.open(textOf(path), fs.READ_ONLY | fs.DIRECTORY, 0)
    if !fs.isValid(directory) { return false }
    var buffer: [8192]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &buffer) }
    var ok = true
    const length = path.*.length
    // Read again from the start after each batch: removing while reading
    // can skip entries on some file systems.
    var removed_any = true
    while removed_any {
        removed_any = false
        const rewound = fs.seek(directory, 0, fs.SEEK_START)
        var reader = fs.entries(directory, bytes, 8192)
        var entry: fs.Entry = undefined
        while fs.nextEntry(&reader, &entry) {
            if !fs.isDotName(entry.name) {
                if push(path, entry.name.pointer[0..entry.name.length]) {
                    if removeAt(path) { removed_any = true } else { ok = false }
                } else {
                    ok = false
                }
                cut(path, length)
            }
        }
        if !ok { removed_any = false }
    }
    const closed = fs.close(directory)
    return fs.removeDir(textOf(path)) && ok
}

// Moves `source` to `target` (which must not be there yet): renamed on the
// same file system, else copied and, once all of it is, removed.
pub fn move(source: [*]const u8, target: [*]const u8) -> bool {
    var result: isize = 0
    unsafe { result = linux.syscall5(linux.SYS_renameat2, AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(source), AT_CURRENT_WORKING_DIRECTORY, @intFromPtr(target), RENAME_NO_REPLACE) }
    if result == 0 { return true }
    // A file system without RENAME_NOREPLACE (FUSE, Android's shared
    // storage): a plain rename when nothing is there.
    if result == EINVAL {
        if exists(target) { return false }
        if fs.rename(source, target) { return true }
    } else if result != EXDEV {
        return false
    }
    if !copy(source, target) { return false }
    return remove(source)
}

// A name for `name` in `folder` that nothing has yet: name, "name 2",
// "name 3", ... (before the extension: "photo 2.png") into `into`
// (NUL-terminated); its length, 0 when none fits.
pub fn freeName(folder: []const u8, name: []const u8, into: [*]u8, capacity: usize) -> usize {
    var dot = name.length
    var index: usize = 1
    while index < name.length {
        if name[index] == 46 { dot = index }
        index += 1
    }
    var number: usize = 1
    while number < 10000 {
        var length: usize = 0
        var ok = true
        for byte in folder {
            if length + 1 < capacity { into[length] = byte } else { ok = false }
            length += 1
        }
        if length + 1 < capacity { into[length] = 47 } else { ok = false }
        length += 1
        const start = length
        var at: usize = 0
        while at < name.length {
            if at == dot && number > 1 {
                length = appendNumber(into, length, capacity, number, &ok)
            }
            if length + 1 < capacity { into[length] = name[at] } else { ok = false }
            length += 1
            at += 1
        }
        if dot == name.length && number > 1 { length = appendNumber(into, length, capacity, number, &ok) }
        if !ok { return 0 }
        into[length] = 0
        if !exists(into) { return length }
        number += 1
    }
    return 0
}

fn appendNumber(into: [*]u8, at: usize, capacity: usize, number: usize, ok: *bool) -> usize {
    var length = at
    if length + 1 < capacity { into[length] = 32 } else { ok.* = false }
    length += 1
    var digits: [20]u8 = undefined
    var count: usize = 0
    var rest = number
    while rest > 0 {
        digits[count] = @intCast(u8, 48 + rest % 10)
        rest /= 10
        count += 1
    }
    while count > 0 {
        count -= 1
        if length + 1 < capacity { into[length] = digits[count] } else { ok.* = false }
        length += 1
    }
    return length
}
