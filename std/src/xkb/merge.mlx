// std.xkb.merge: definitions meeting what is there already, as
// libxkbcommon merges them: a key, type, interpretation or indicator
// defined again in a file, and everything an included file defines
// (std.xkb.compile). The merge mode (xkb.MERGE_*) decides who wins:
// override and the default take the new definition, augment keeps the
// old, replace takes the new one whole. Keys and interpretations merge
// field by field (a key level by level).
const std = @import("std")
const xkb = @import("std.xkb")

// The mode a definition merges with when included with `mode`: its own
// unless the include gave one.
pub fn effective(mode: u8, own: u8) -> u8 { return if mode == xkb.MERGE_DEFAULT { own } else { mode } }

// Whether a field takes the new value: when the old one is not given, or
// both are and the new one wins.
fn useNew(old_has: bool, new_has: bool, clobber: bool) -> bool {
    if !old_has { return new_has }
    return new_has && clobber
}

// ---------------------------------------------------------------------------
// Keycodes

// Names keycode `keycode` `name` (AddKeyName).
pub fn keyName(into: *xkb.Keymap, keycode: usize, name: []const u8, mode: u8) -> void {
    const names = xkb.bytesOf(into, @offsetOf(xkb.Keymap, "keyNames"))
    const old = xkb.keyName(into, @intCast(u32, keycode))
    if old.length > 0 {
        if std.text.same(old, name) || mode == xkb.MERGE_AUGMENT { return }
        xkb.store(names, keycode * xkb.NAME, xkb.NAME, "")
    }
    var other: usize = 0
    while other < xkb.MAX_KEYCODE {
        if other != keycode && std.text.same(xkb.keyName(into, @intCast(u32, other)), name) {
            if mode != xkb.MERGE_OVERRIDE { return }
            xkb.store(names, other * xkb.NAME, xkb.NAME, "")
        }
        other += 1
    }
    xkb.store(names, keycode * xkb.NAME, xkb.NAME, name)
}

pub fn alias(into: *xkb.Keymap, name: []const u8, target: []const u8, mode: u8) -> void {
    const names = xkb.bytesOf(into, @offsetOf(xkb.Keymap, "aliasNames"))
    const targets = xkb.bytesOf(into, @offsetOf(xkb.Keymap, "aliasTargets"))
    var index: usize = 0
    while index < into.*.aliasCount {
        if std.text.same(xkb.stored(names, index * xkb.NAME, xkb.NAME), name) {
            if mode != xkb.MERGE_AUGMENT { xkb.store(targets, index * xkb.NAME, xkb.NAME, target) }
            return
        }
        index += 1
    }
    if into.*.aliasCount >= xkb.MAX_ALIASES { return }
    xkb.store(names, into.*.aliasCount * xkb.NAME, xkb.NAME, name)
    xkb.store(targets, into.*.aliasCount * xkb.NAME, xkb.NAME, target)
    into.*.aliasCount += 1
}

// Names indicator `index` (from 0).
pub fn ledName(into: *xkb.Keymap, index: usize, name: []const u8, mode: u8) -> void {
    if index >= xkb.MAX_LEDS { return }
    const names = xkb.bytesOf(into, @offsetOf(xkb.Keymap, "ledNames"))
    const replace = mode == xkb.MERGE_REPLACE || mode == xkb.MERGE_OVERRIDE
    var other: usize = 0
    while other < into.*.ledCount {
        if std.text.same(xkb.ledName(into, other), name) {
            if other == index { return }
            if !replace { return }
            xkb.store(names, other * xkb.LED_NAME, xkb.LED_NAME, "")
        }
        other += 1
    }
    if index + 1 > into.*.ledCount { into.*.ledCount = index + 1 }
    if xkb.ledName(into, index).length > 0 && !replace { return }
    xkb.store(names, index * xkb.LED_NAME, xkb.LED_NAME, name)
}

pub fn keycodes(into: *xkb.Keymap, from: *xkb.Keymap, mode: u8) -> void {
    var keycode: usize = 0
    while keycode < xkb.MAX_KEYCODE {
        const name = xkb.keyName(from, @intCast(u32, keycode))
        if name.length > 0 { keyName(into, keycode, name, mode) }
        keycode += 1
    }
    var index: usize = 0
    while index < from.*.aliasCount {
        alias(into, xkb.stored(xkb.bytesOf(from, @offsetOf(xkb.Keymap, "aliasNames")), index * xkb.NAME, xkb.NAME), xkb.stored(xkb.bytesOf(from, @offsetOf(xkb.Keymap, "aliasTargets")), index * xkb.NAME, xkb.NAME), mode)
        index += 1
    }
    index = 0
    while index < from.*.ledCount {
        const name = xkb.ledName(from, index)
        if name.length > 0 { ledName(into, index, name, mode) }
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Types

fn copyType(into: *xkb.Keymap, to: usize, from: *xkb.Keymap, index: usize) -> void {
    xkb.store(xkb.bytesOf(into, @offsetOf(xkb.Keymap, "typeNames")), to * xkb.TYPE_NAME, xkb.TYPE_NAME, xkb.typeName(from, index))
    into.*.typeMods[to] = from.*.typeMods[index]
    into.*.typeLevels[to] = from.*.typeLevels[index]
    into.*.typeEntryCount[to] = from.*.typeEntryCount[index]
    into.*.typeMerge[to] = from.*.typeMerge[index]
    var entry: usize = 0
    while entry < xkb.MAX_ENTRIES {
        into.*.entryMods[to * xkb.MAX_ENTRIES + entry] = from.*.entryMods[index * xkb.MAX_ENTRIES + entry]
        into.*.entryLevel[to * xkb.MAX_ENTRIES + entry] = from.*.entryLevel[index * xkb.MAX_ENTRIES + entry]
        into.*.entryPreserve[to * xkb.MAX_ENTRIES + entry] = from.*.entryPreserve[index * xkb.MAX_ENTRIES + entry]
        entry += 1
    }
    var level: usize = 0
    while level < xkb.MAX_LEVELS {
        xkb.store(xkb.bytesOf(into, @offsetOf(xkb.Keymap, "levelNames")), (to * xkb.MAX_LEVELS + level) * xkb.LEVEL_NAME, xkb.LEVEL_NAME, xkb.levelName(from, index, level))
        level += 1
    }
}

// Type `index` of `from` into `into` (AddKeyType): a type of the same
// name stays unless the new one overrides or replaces it. `from` may be
// `into` with the new type just past its types.
pub fn addType(into: *xkb.Keymap, from: *xkb.Keymap, index: usize, mode: u8) -> void {
    const existing = xkb.typeIndex(into, xkb.typeName(from, index))
    var to = into.*.typeCount
    if existing != xkb.NO_TYPE {
        if mode != xkb.MERGE_OVERRIDE && mode != xkb.MERGE_REPLACE { return }
        to = @intCast(usize, existing)
    } else {
        if to >= xkb.MAX_TYPES { return }
        into.*.typeCount += 1
    }
    if !(into == from && to == index) { copyType(into, to, from, index) }
    into.*.typeMerge[to] = mode
}

pub fn types(into: *xkb.Keymap, from: *xkb.Keymap, mode: u8) -> void {
    var index: usize = 0
    while index < from.*.typeCount {
        addType(into, from, index, effective(mode, from.*.typeMerge[index]))
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Compatibility map

fn copyInterpretField(into: *xkb.Keymap, to: usize, from: *xkb.Keymap, index: usize, field: u8) -> void {
    if field == xkb.INTERPRET_VMOD { into.*.interpretVmod[to] = from.*.interpretVmod[index] }
    if field == xkb.INTERPRET_REPEAT { into.*.interpretRepeat[to] = from.*.interpretRepeat[index] }
    if field == xkb.INTERPRET_LEVEL_ONE { into.*.interpretLevelOne[to] = from.*.interpretLevelOne[index] }
    if field == xkb.INTERPRET_ACTION {
        into.*.interpretActionKind[to] = from.*.interpretActionKind[index]
        into.*.interpretActionFlags[to] = from.*.interpretActionFlags[index]
        into.*.interpretActionMods[to] = xkb.actionModsInto(into, from, from.*.interpretActionKind[index], from.*.interpretActionMods[index], from.*.interpretActionGroup[index])
        into.*.interpretActionGroup[to] = from.*.interpretActionGroup[index]
    }
}

fn copyInterpret(into: *xkb.Keymap, to: usize, from: *xkb.Keymap, index: usize) -> void {
    into.*.interpretSym[to] = from.*.interpretSym[index]
    into.*.interpretAny[to] = from.*.interpretAny[index]
    into.*.interpretMatch[to] = from.*.interpretMatch[index]
    into.*.interpretMods[to] = from.*.interpretMods[index]
    into.*.interpretMerge[to] = from.*.interpretMerge[index]
    into.*.interpretDefined[to] = from.*.interpretDefined[index]
    var field: u8 = 1
    while field <= xkb.INTERPRET_LEVEL_ONE {
        copyInterpretField(into, to, from, index, field)
        field = field << 1
    }
}

// Interpretation `index` of `from` into `into` (AddInterp): one for the
// same keysym and modifiers takes the new fields it may (all with
// replace). `from` may be `into` with the new one just past its own.
pub fn addInterpret(into: *xkb.Keymap, from: *xkb.Keymap, index: usize, mode: u8) -> void {
    var at: usize = 0
    while at < into.*.interpretCount {
        if into.*.interpretSym[at] == from.*.interpretSym[index] && into.*.interpretAny[at] == from.*.interpretAny[index] && into.*.interpretMatch[at] == from.*.interpretMatch[index] && into.*.interpretMods[at] == from.*.interpretMods[index] { break }
        at += 1
    }
    if at == into.*.interpretCount {
        if at >= xkb.MAX_INTERPRETS { return }
        if !(into == from && at == index) { copyInterpret(into, at, from, index) }
        into.*.interpretMerge[at] = mode
        into.*.interpretCount += 1
        return
    }
    if mode == xkb.MERGE_REPLACE {
        copyInterpret(into, at, from, index)
        into.*.interpretMerge[at] = mode
        return
    }
    var field: u8 = 1
    while field <= xkb.INTERPRET_LEVEL_ONE {
        const old_has = into.*.interpretDefined[at] & field != 0
        const new_has = from.*.interpretDefined[index] & field != 0
        if !old_has || new_has && mode != xkb.MERGE_AUGMENT {
            copyInterpretField(into, at, from, index, field)
            into.*.interpretDefined[at] |= field
        }
        field = field << 1
    }
}

fn copyLedField(into: *xkb.Keymap, to: usize, from: *xkb.Keymap, index: usize, field: u8) -> void {
    if field == xkb.LED_MODS {
        into.*.ledWhichMods[to] = from.*.ledWhichMods[index]
        into.*.ledMods[to] = from.*.ledMods[index]
    }
    if field == xkb.LED_GROUPS {
        into.*.ledWhichGroups[to] = from.*.ledWhichGroups[index]
        into.*.ledGroups[to] = from.*.ledGroups[index]
    }
    if field == xkb.LED_CONTROLS { into.*.ledControls[to] = from.*.ledControls[index] }
}

// Indicator map `index` of `from` into `into` (AddLedMap), as for the
// interpretations; `from` may be `into` with the new one past its own.
pub fn addLedMap(into: *xkb.Keymap, from: *xkb.Keymap, index: usize, mode: u8) -> void {
    const name = xkb.ledMapName(from, index)
    var at: usize = 0
    while at < into.*.ledMapCount && !std.text.same(xkb.ledMapName(into, at), name) { at += 1 }
    const fresh = at == into.*.ledMapCount
    if fresh {
        if at >= xkb.MAX_LEDS { return }
        into.*.ledMapCount += 1
        if !(into == from && at == index) { xkb.store(xkb.bytesOf(into, @offsetOf(xkb.Keymap, "ledMapNames")), at * xkb.LED_NAME, xkb.LED_NAME, name) }
        into.*.ledMapDefined[at] = 0
        into.*.ledMapMerge[at] = mode
    }
    if mode == xkb.MERGE_REPLACE { into.*.ledMapDefined[at] = 0 }
    var field: u8 = 1
    while field <= xkb.LED_CONTROLS {
        const old_has = into.*.ledMapDefined[at] & field != 0
        const new_has = from.*.ledMapDefined[index] & field != 0
        if fresh || mode == xkb.MERGE_REPLACE || !old_has || new_has && mode != xkb.MERGE_AUGMENT {
            if !(into == from && at == index) { copyLedField(into, at, from, index, field) }
            if new_has { into.*.ledMapDefined[at] |= field }
        }
        field = field << 1
    }
}

pub fn compat(into: *xkb.Keymap, from: *xkb.Keymap, mode: u8) -> void {
    var index: usize = 0
    while index < from.*.interpretCount {
        addInterpret(into, from, index, effective(mode, from.*.interpretMerge[index]))
        index += 1
    }
    index = 0
    while index < from.*.ledMapCount {
        addLedMap(into, from, index, effective(mode, from.*.ledMapMerge[index]))
        index += 1
    }
}

// ---------------------------------------------------------------------------
// Symbols

// A group of a key meeting the same group defined again (MergeGroups).
fn group(into: *xkb.Keymap, into_key: usize, from: *xkb.Keymap, from_key: usize, at: usize, clobber: bool) -> void {
    const type_bit = xkb.EXPLICIT_TYPE << @intCast(u4, at)
    const into_group = into_key * xkb.MAX_GROUPS + at
    const from_group = from_key * xkb.MAX_GROUPS + at
    if from.*.keyExplicit[from_key] & type_bit != 0 && (into.*.keyExplicit[into_key] & type_bit == 0 || clobber) {
        into.*.keyTypes[into_group] = from.*.keyTypes[from_group]
        into.*.keyExplicit[into_key] |= type_bit
    }
    const from_width = @intCast(usize, from.*.keyWidth[from_group])
    const into_width = @intCast(usize, into.*.keyWidth[into_group])
    if from_width > 0 {
        var level: usize = 0
        while level < from_width {
            const into_slot = xkb.slotOf(into_key, at, level)
            const from_slot = xkb.slotOf(from_key, at, level)
            if level >= into_width {
                xkb.copyLevel(into, into_slot, from, from_slot)
            } else {
                if from.*.actionKind[from_slot] != xkb.ACTION_NONE && (into.*.actionKind[into_slot] == xkb.ACTION_NONE || clobber) { xkb.copyAction(into, into_slot, from, from_slot) }
                if from.*.slotCount[from_slot] > 0 && (into.*.slotCount[into_slot] == 0 || clobber) {
                    const kind = into.*.actionKind[into_slot]
                    const flags = into.*.actionFlags[into_slot]
                    const mods = into.*.actionMods[into_slot]
                    const action_group = into.*.actionGroup[into_slot]
                    xkb.copyLevel(into, into_slot, from, from_slot)
                    into.*.actionKind[into_slot] = kind
                    into.*.actionFlags[into_slot] = flags
                    into.*.actionMods[into_slot] = mods
                    into.*.actionGroup[into_slot] = action_group
                }
            }
            level += 1
        }
        if from_width > into_width { into.*.keyWidth[into_group] = @intCast(u8, from_width) }
    }
    into.*.groupDefined[into_group] |= from.*.groupDefined[from_group]
}

// Key `from_key` of `from` into key `into_key` of `into` (MergeKeys),
// merging with `mode` (the effective one). `from` may be `into`.
pub fn key(into: *xkb.Keymap, into_key: usize, from: *xkb.Keymap, from_key: usize, mode: u8) -> void {
    if !into.*.keyDefined[into_key] || mode == xkb.MERGE_REPLACE {
        xkb.copyKey(into, into_key, from, from_key)
        into.*.keyDefined[into_key] = true
        into.*.keyMerge[into_key] = mode
        return
    }
    const clobber = mode != xkb.MERGE_AUGMENT
    var at: usize = 0
    while at < xkb.MAX_GROUPS {
        group(into, into_key, from, from_key, at, clobber)
        at += 1
    }
    const old = into.*.keyExplicit[into_key]
    const new = from.*.keyExplicit[from_key]
    if useNew(old & xkb.EXPLICIT_VMODMAP != 0, new & xkb.EXPLICIT_VMODMAP != 0, clobber) {
        into.*.keyVmodmap[into_key] = from.*.keyVmodmap[from_key]
        into.*.keyExplicit[into_key] |= xkb.EXPLICIT_VMODMAP
    }
    if useNew(old & xkb.EXPLICIT_REPEAT != 0, new & xkb.EXPLICIT_REPEAT != 0, clobber) {
        into.*.keyRepeats[into_key] = from.*.keyRepeats[from_key]
        into.*.keyExplicit[into_key] |= xkb.EXPLICIT_REPEAT
    }
    if useNew(old & xkb.EXPLICIT_DEFAULT_TYPE != 0, new & xkb.EXPLICIT_DEFAULT_TYPE != 0, clobber) {
        into.*.keyDefaultType[into_key] = from.*.keyDefaultType[from_key]
        into.*.keyExplicit[into_key] |= xkb.EXPLICIT_DEFAULT_TYPE
    }
    if useNew(old & xkb.EXPLICIT_RANGE != 0, new & xkb.EXPLICIT_RANGE != 0, clobber) {
        into.*.keyRange[into_key] = from.*.keyRange[from_key]
        into.*.keyRedirect[into_key] = from.*.keyRedirect[from_key]
        into.*.keyExplicit[into_key] |= xkb.EXPLICIT_RANGE
    }
    if new & xkb.EXPLICIT_INTERP != 0 { into.*.keyExplicit[into_key] |= xkb.EXPLICIT_INTERP }
}

// A modifier_map entry (AddModMapEntry): a key or keysym belongs to one
// modifier; a second entry for it moves it unless it augments.
pub fn modmap(into: *xkb.Keymap, keycode: u32, sym: u32, modifier: u8, mode: u8) -> void {
    var index: usize = 0
    while index < into.*.modmapCount {
        if into.*.modmapKey[index] == keycode && (keycode != 0 || into.*.modmapSym[index] == sym) {
            if mode != xkb.MERGE_AUGMENT { into.*.modmapMod[index] = modifier }
            return
        }
        index += 1
    }
    if into.*.modmapCount >= xkb.MAX_MODMAP { return }
    into.*.modmapKey[index] = keycode
    into.*.modmapSym[index] = sym
    into.*.modmapMod[index] = modifier
    into.*.modmapMerge[index] = mode
    into.*.modmapCount += 1
}

pub fn symbols(into: *xkb.Keymap, from: *xkb.Keymap, mode: u8) -> void {
    var keycode: usize = 2
    while keycode < xkb.MAX_KEYCODE {
        if from.*.keyDefined[keycode] { key(into, keycode, from, keycode, effective(mode, from.*.keyMerge[keycode])) }
        keycode += 1
    }
    var index: usize = 0
    while index < from.*.modmapCount {
        modmap(into, from.*.modmapKey[index], from.*.modmapSym[index], from.*.modmapMod[index], effective(mode, from.*.modmapMerge[index]))
        index += 1
    }
    var at: usize = 0
    while at < xkb.MAX_GROUPS {
        const name = xkb.groupName(from, at)
        if name.length > 0 && !(mode == xkb.MERGE_AUGMENT && xkb.groupName(into, at).length > 0) {
            xkb.store(xkb.bytesOf(into, @offsetOf(xkb.Keymap, "groupNames")), at * xkb.GROUP_NAME, xkb.GROUP_NAME, name)
        }
        at += 1
    }
}

// Everything section `which` of `from` defines, into `into`.
pub fn section(into: *xkb.Keymap, from: *xkb.Keymap, which: u8, mode: u8) -> void {
    if which == xkb.SECTION_KEYCODES { keycodes(into, from, mode) }
    if which == xkb.SECTION_TYPES { types(into, from, mode) }
    if which == xkb.SECTION_COMPAT { compat(into, from, mode) }
    if which == xkb.SECTION_SYMBOLS { symbols(into, from, mode) }
    xkb.takeVmods(into, from)
}
