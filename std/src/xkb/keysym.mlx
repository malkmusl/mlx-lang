// std.xkb.keysym: keysyms by name and back, the character a keysym types,
// and its upper case (what Caps Lock makes of it).
//
//     var names: keysym.Names = undefined
//     if !keysym.init(&names, allocator) { ... }
//     const a = keysym.fromName(&names, "adiaeresis")      // 0xe4
//     const length = keysym.toUtf8(&names, a, out)          // "ä", 2 bytes
//
// The names are those of the X11 keysym headers (std.xkb.keysyms, generated
// by tools/materialize_xkb_keysyms.py), plus "U" and a hexadecimal code
// point (a Unicode keysym, 0x01000000 + the code point) and "0x" and a
// hexadecimal keysym value.
const std = @import("std")
const keysyms = @import("std.xkb.keysyms")

pub const Allocator = std.allocator.Allocator

pub const NO_SYMBOL: u32 = 0
pub const VOID_SYMBOL: u32 = 16777215

// The table's lines, indexed: where each line starts, sorted by name and by
// value (the canonical name of a value first).
pub const Names = struct {
    text: []const u8
    count: usize
    byName: [*]u32
    byValue: [*]u32
}

// The parts of a table line.
fn nameAt(names: *const Names, start: u32) -> []const u8 {
    var end = @intCast(usize, start)
    while names.*.text[end] != 32 { end += 1 }
    return names.*.text[@intCast(usize, start)..end]
}

fn hexAt(text: []const u8, at: usize, end: *usize) -> u32 {
    var value: u32 = 0
    var index = at
    while index < text.length {
        const digit = std.text.hexValue(text[index])
        if digit >= 16 { break }
        value = value * 16 + @intCast(u32, digit)
        index += 1
    }
    end.* = index
    return value
}

fn valueAt(names: *const Names, start: u32) -> u32 {
    var at = @intCast(usize, start)
    while names.*.text[at] != 32 { at += 1 }
    var end: usize = 0
    return hexAt(names.*.text, at + 1, &end)
}

// The character a line gives (0: none).
fn codeAt(names: *const Names, start: u32) -> u32 {
    var at = @intCast(usize, start)
    while names.*.text[at] != 32 { at += 1 }
    var end: usize = 0
    const value = hexAt(names.*.text, at + 1, &end)
    if names.*.text[end] != 32 { return 0 }
    return hexAt(names.*.text, end + 1, &end)
}

fn compareNames(left: []const u8, right: []const u8) -> i32 {
    var index: usize = 0
    while index < left.length && index < right.length {
        if left[index] != right[index] { return if left[index] < right[index] { -1 } else { 1 } }
        index += 1
    }
    if left.length == right.length { return 0 }
    return if left.length < right.length { -1 } else { 1 }
}

// Whether line `left` sorts before line `right` by name (key 0) or value.
fn before(names: *const Names, key: u8, left: u32, right: u32) -> bool {
    if key == 0 { return compareNames(nameAt(names, left), nameAt(names, right)) < 0 }
    return valueAt(names, left) < valueAt(names, right)
}

fn sort(names: *const Names, lines: [*]u32, count: usize, key: u8) -> void {
    // Insertion sort with a binary search for the place: stable, and the
    // tables are small (a few thousand lines, once).
    var index: usize = 1
    while index < count {
        const line = lines[index]
        var low: usize = 0
        var high = index
        while low < high {
            const middle = (low + high) / 2
            if before(names, key, line, lines[middle]) { high = middle } else { low = middle + 1 }
        }
        var at = index
        while at > low {
            lines[at] = lines[at - 1]
            at -= 1
        }
        lines[low] = line
        index += 1
    }
}

pub fn init(names: *Names, allocator: Allocator) -> bool {
    names.*.text = keysyms.table()
    names.*.count = keysyms.COUNT
    names.*.byName = allocator.words(keysyms.COUNT)
    names.*.byValue = allocator.words(keysyms.COUNT)
    var line: usize = 0
    var start: usize = 0
    while start < names.*.text.length && line < keysyms.COUNT {
        names.*.byName[line] = @intCast(u32, start)
        names.*.byValue[line] = @intCast(u32, start)
        while names.*.text[start] != 10 { start += 1 }
        start += 1
        line += 1
    }
    sort(names, names.*.byName, line, 0)
    sort(names, names.*.byValue, line, 1)
    return line == keysyms.COUNT
}

// The keysym named `name` (NO_SYMBOL: none).
pub fn fromName(names: *const Names, name: []const u8) -> u32 {
    if name.length == 0 { return NO_SYMBOL }
    var low: usize = 0
    var high = names.*.count
    while low < high {
        const middle = (low + high) / 2
        const order = compareNames(nameAt(names, names.*.byName[middle]), name)
        if order == 0 { return valueAt(names, names.*.byName[middle]) }
        if order < 0 { low = middle + 1 } else { high = middle }
    }
    // U and a code point, 0x and a value.
    var end: usize = 0
    if name.length > 1 && name[0] == 85 {
        const code = hexAt(name, 1, &end)
        if end == name.length && code <= 1114111 {
            if code >= 32 && code <= 126 || code >= 160 && code <= 255 { return code }
            return 16777216 + code
        }
    }
    if name.length > 2 && name[0] == 48 && (name[1] == 120 || name[1] == 88) {
        const value = hexAt(name, 2, &end)
        if end == name.length { return value }
    }
    return NO_SYMBOL
}

// The keysym's canonical name into `out` (at least 12 bytes); its length.
// Keysyms without a name are written "U" and their code point (Unicode
// keysyms) or "0x" and eight hexadecimal digits.
pub fn nameOf(names: *const Names, value: u32, out: [*]u8, capacity: usize) -> usize {
    var low: usize = 0
    var high = names.*.count
    while low < high {
        const middle = (low + high) / 2
        if valueAt(names, names.*.byValue[middle]) < value { low = middle + 1 } else { high = middle }
    }
    if low < names.*.count && valueAt(names, names.*.byValue[low]) == value {
        return std.text.append(out, 0, capacity, nameAt(names, names.*.byValue[low]))
    }
    if value >= 16777472 && value <= 17891327 {
        var length = std.text.append(out, 0, capacity, "U")
        return appendHexDigits(out, length, capacity, @intCast(usize, value - 16777216), 4)
    }
    var length = std.text.append(out, 0, capacity, "0x")
    return appendHexDigits(out, length, capacity, @intCast(usize, value), 8)
}

fn appendHexDigits(out: [*]u8, at: usize, capacity: usize, value: usize, minimum: usize) -> usize {
    var digits: [16]u8 = undefined
    var count: usize = 0
    var rest = value
    while rest > 0 || count < minimum {
        const digit = @intCast(u8, rest % 16)
        digits[count] = if digit < 10 { 48 + digit } else { 55 + digit }
        rest /= 16
        count += 1
    }
    var length = at
    while count > 0 {
        count -= 1
        length = std.text.appendByte(out, length, capacity, digits[count])
    }
    return length
}

// The character `keysym` types (0: none), as libxkbcommon's
// xkb_keysym_to_utf32.
pub fn toUtf32(names: *const Names, keysym: u32) -> u32 {
    if keysym >= 32 && keysym <= 126 || keysym >= 160 && keysym <= 255 { return keysym }
    // KP_Space
    if keysym == 65408 { return 32 }
    // BackSpace .. Clear, KP_Multiply .. KP_9, Return, Escape, Delete,
    // KP_Tab, KP_Enter, KP_Equal.
    if keysym >= 65288 && keysym <= 65291 || keysym >= 65450 && keysym <= 65465 || keysym == 65293 || keysym == 65307 || keysym == 65535 || keysym == 65417 || keysym == 65421 || keysym == 65469 {
        return keysym & 127
    }
    if keysym >= 16777216 && keysym <= 17891327 {
        const code = keysym - 16777216
        if code >= 55296 && code <= 57343 { return 0 }
        return code
    }
    var low: usize = 0
    var high = names.*.count
    while low < high {
        const middle = (low + high) / 2
        if valueAt(names, names.*.byValue[middle]) < keysym { low = middle + 1 } else { high = middle }
    }
    // Every name of the value (the first with a character counts).
    while low < names.*.count && valueAt(names, names.*.byValue[low]) == keysym {
        const code = codeAt(names, names.*.byValue[low])
        if code != 0 { return code }
        low += 1
    }
    return 0
}

// UTF-8 of `keysym`'s character into `out` (at least 4 bytes); its length
// (0: it types nothing).
pub fn toUtf8(names: *const Names, keysym: u32, out: [*]u8) -> usize {
    return encodeUtf8(toUtf32(names, keysym), out)
}

pub fn encodeUtf8(code: u32, out: [*]u8) -> usize {
    if code == 0 { return 0 }
    if code < 128 {
        out[0] = @intCast(u8, code)
        return 1
    }
    if code < 2048 {
        out[0] = @intCast(u8, 192 | (code >> 6))
        out[1] = @intCast(u8, 128 | (code & 63))
        return 2
    }
    if code < 65536 {
        out[0] = @intCast(u8, 224 | (code >> 12))
        out[1] = @intCast(u8, 128 | ((code >> 6) & 63))
        out[2] = @intCast(u8, 128 | (code & 63))
        return 3
    }
    out[0] = @intCast(u8, 240 | (code >> 18))
    out[1] = @intCast(u8, 128 | ((code >> 12) & 63))
    out[2] = @intCast(u8, 128 | ((code >> 6) & 63))
    out[3] = @intCast(u8, 128 | (code & 63))
    return 4
}

// The upper case of a Unicode character as X11's UCSConvertCase gives it
// (the simple mappings of Unicode 4.0 for Latin, IPA, Greek, Cyrillic,
// Armenian, Latin and Greek Extended and a few symbol blocks); itself when
// it has none. Latin-1 characters may get an upper case outside Latin-1
// (micro sign, sharp s, y with diaeresis).
pub fn upperCode(code: u32) -> u32 {
    if code < 256 {
        if code >= 97 && code <= 122 || code >= 224 && code <= 254 && code != 247 { return code - 32 }
        if code == 255 { return 376 }
        if code == 181 { return 924 }
        if code == 223 { return 7838 }
        return code
    }
    // Latin Extended-A.
    if code <= 383 {
        if code >= 256 && code <= 303 || code >= 306 && code <= 311 || code >= 330 && code <= 375 { return code & 4294967294 }
        if code >= 313 && code <= 328 || code >= 377 && code <= 382 { return if code & 1 == 0 { code - 1 } else { code } }
        if code == 305 { return 73 }
        if code == 383 { return 83 }
        return code
    }
    // Latin Extended-B.
    if code <= 591 {
        if code >= 461 && code <= 476 { return if code & 1 == 0 { code - 1 } else { code } }
        if code >= 478 && code <= 495 || code >= 500 && code <= 501 || code >= 504 && code <= 543 || code >= 546 && code <= 563 { return code & 4294967294 }
        if code == 387 || code == 389 || code == 392 || code == 396 || code == 402 || code == 409 || code == 417 || code == 419 || code == 421 || code == 424 || code == 429 || code == 432 || code == 436 || code == 438 || code == 441 || code == 445 { return code - 1 }
        if code == 405 { return 502 }
        if code == 414 { return 544 }
        if code == 447 { return 503 }
        if code == 453 || code == 456 || code == 459 || code == 498 { return code - 1 }
        if code == 454 || code == 457 || code == 460 || code == 499 { return code - 2 }
        if code == 477 { return 398 }
        return code
    }
    // IPA Extensions.
    if code <= 687 {
        return match code {
            595 => 385, 596 => 390, 598 => 393, 599 => 394, 601 => 399, 603 => 400, 608 => 403, 611 => 404,
            616 => 407, 617 => 406, 623 => 412, 626 => 413, 629 => 415, 640 => 422, 643 => 425, 648 => 430,
            650 => 433, 651 => 434, 658 => 439, else => code
        }
    }
    if code == 837 { return 921 }
    // Greek and Coptic.
    if code >= 880 && code <= 1023 {
        if code == 940 { return 902 }
        if code >= 941 && code <= 943 { return code - 37 }
        if code == 962 { return 931 }
        if code >= 945 && code <= 971 { return code - 32 }
        if code == 972 { return 908 }
        if code == 973 || code == 974 { return code - 63 }
        if code >= 985 && code <= 1007 { return if code & 1 == 1 { code - 1 } else { code } }
        return match code {
            976 => 914, 977 => 920, 981 => 934, 982 => 928, 1008 => 922, 1009 => 929, 1010 => 1017, 1013 => 917,
            1016 => 1015, 1019 => 1018, else => code
        }
    }
    // Cyrillic and Cyrillic Supplement.
    if code >= 1024 && code <= 1327 {
        if code >= 1072 && code <= 1103 { return code - 32 }
        if code >= 1104 && code <= 1119 { return code - 80 }
        if code >= 1121 && code <= 1153 || code >= 1163 && code <= 1215 || code >= 1233 && code <= 1269 || code >= 1281 && code <= 1295 {
            return if code & 1 == 1 { code - 1 } else { code }
        }
        if code == 1273 { return 1272 }
        if code >= 1218 && code <= 1230 { return if code & 1 == 0 { code - 1 } else { code } }
        return code
    }
    // Armenian.
    if code >= 1377 && code <= 1414 { return code - 48 }
    // Latin Extended Additional.
    if code >= 7680 && code <= 7829 || code >= 7840 && code <= 7929 { return code & 4294967294 }
    if code == 7835 { return 7776 }
    // Greek Extended.
    if code >= 7936 && code <= 8191 { return greekExtendedUpper(code) }
    // Number Forms, Enclosed Alphanumerics, Halfwidth and Fullwidth Forms,
    // Deseret.
    if code >= 8560 && code <= 8575 { return code - 16 }
    if code >= 9424 && code <= 9449 { return code - 26 }
    if code >= 65345 && code <= 65370 { return code - 32 }
    if code >= 66600 && code <= 66639 { return code - 40 }
    return code
}

fn greekExtendedUpper(code: u32) -> u32 {
    const low = code & 15
    const row = code & 4294967280
    // Rows whose first eight (or six) are the lower case of the next eight.
    if row == 7936 || row == 7968 || row == 7984 || row == 8032 || row == 8064 || row == 8080 || row == 8096 {
        return if low < 8 { code + 8 } else { code }
    }
    if row == 7952 || row == 8000 { return if low < 6 { code + 8 } else { code } }
    if code == 8017 || code == 8019 || code == 8021 || code == 8023 { return code + 8 }
    if code == 8048 || code == 8049 { return code + 74 }
    if code >= 8050 && code <= 8053 { return code + 86 }
    if code == 8054 || code == 8055 { return code + 100 }
    if code == 8056 || code == 8057 { return code + 128 }
    if code == 8058 || code == 8059 { return code + 112 }
    if code == 8060 || code == 8061 { return code + 126 }
    if code == 8112 || code == 8113 || code == 8144 || code == 8145 || code == 8160 || code == 8161 { return code + 8 }
    if code == 8115 || code == 8131 || code == 8179 { return code + 9 }
    if code == 8126 { return 921 }
    if code == 8165 { return 8172 }
    return code
}

// The upper case of `keysym` (what Caps Lock types), as libxkbcommon's
// xkb_keysym_to_upper (X11's XConvertCase): Latin-1 keysyms and Unicode
// keysyms by their character (a Latin-1 keysym's upper case is a code
// point, as there), legacy keysyms of Latin-2, -3, -4, -9, Cyrillic and
// Greek by their own ranges.
pub fn toUpper(names: *const Names, keysym: u32) -> u32 {
    if keysym < 256 { return upperCode(keysym) }
    if keysym & 4278190080 == 16777216 { return 16777216 | upperCode(keysym & 16777215) }
    const block = keysym >> 8
    if block == 1 {
        // Latin-2: aogonek, lstroke..sacute, scaron..zacute,
        // zcaron..zabovedot, racute..tcedilla.
        if keysym == 433 { return 417 }
        if keysym >= 435 && keysym <= 438 || keysym >= 441 && keysym <= 444 || keysym >= 446 && keysym <= 447 { return keysym - 16 }
        if keysym >= 480 && keysym <= 510 { return keysym - 32 }
    } else if block == 2 {
        // Latin-3: hstroke..hcircumflex, gbreve..jcircumflex,
        // cabovedot..scircumflex.
        if keysym >= 689 && keysym <= 694 || keysym >= 699 && keysym <= 700 { return keysym - 16 }
        if keysym >= 741 && keysym <= 766 { return keysym - 32 }
    } else if block == 3 {
        // Latin-4: rcedilla..tslash, eng, amacron..umacron.
        if keysym >= 947 && keysym <= 956 { return keysym - 16 }
        if keysym == 959 { return 957 }
        if keysym >= 992 && keysym <= 1022 { return keysym - 32 }
    } else if block == 6 {
        // Cyrillic: Serbian_dje..Serbian_dze, Cyrillic_yu..Cyrillic_hardsign.
        if keysym >= 1697 && keysym <= 1711 { return keysym + 16 }
        if keysym >= 1728 && keysym <= 1759 { return keysym + 32 }
    } else if block == 7 {
        // Greek: the accented and the plain small letters (not
        // iotaaccentdieresis, upsilonaccentdieresis, finalsmallsigma).
        if keysym >= 1969 && keysym <= 1979 && keysym != 1974 && keysym != 1978 { return keysym - 16 }
        if keysym >= 2017 && keysym <= 2041 && keysym != 2035 { return keysym - 32 }
    } else if block == 19 {
        // Latin-9: oe.
        if keysym == 5053 { return 5052 }
    }
    return keysym
}

// The lower case of a Unicode character as X11's UCSConvertCase gives it;
// itself when it has none.
pub fn lowerCode(code: u32) -> u32 {
    if code < 256 {
        if code >= 65 && code <= 90 || code >= 192 && code <= 222 && code != 215 { return code + 32 }
        return code
    }
    if code <= 383 {
        if code >= 256 && code <= 303 || code >= 306 && code <= 311 || code >= 330 && code <= 375 { return code | 1 }
        if code >= 313 && code <= 328 || code >= 377 && code <= 382 { return if code & 1 == 1 { code + 1 } else { code } }
        if code == 304 { return 105 }
        if code == 376 { return 255 }
        return code
    }
    if code <= 591 {
        if code >= 461 && code <= 476 { return if code & 1 == 1 { code + 1 } else { code } }
        if code >= 478 && code <= 495 || code >= 500 && code <= 501 || code >= 504 && code <= 543 || code >= 546 && code <= 563 { return code | 1 }
        if code == 386 || code == 388 || code == 391 || code == 395 || code == 401 || code == 408 || code == 416 || code == 418 || code == 420 || code == 423 || code == 428 || code == 431 || code == 435 || code == 437 || code == 440 || code == 444 { return code + 1 }
        if code == 452 || code == 455 || code == 458 || code == 497 { return code + 2 }
        if code == 453 || code == 456 || code == 459 || code == 498 { return code + 1 }
        return match code {
            385 => 595, 390 => 596, 393 => 598, 394 => 599, 398 => 477, 399 => 601, 400 => 603, 403 => 608,
            404 => 611, 406 => 617, 407 => 616, 412 => 623, 413 => 626, 415 => 629, 422 => 640, 425 => 643,
            430 => 648, 433 => 650, 434 => 651, 439 => 658, 502 => 405, 503 => 447, 544 => 414, else => code
        }
    }
    if code >= 880 && code <= 1023 {
        if code == 902 { return 940 }
        if code >= 904 && code <= 906 { return code + 37 }
        if code == 908 { return 972 }
        if code == 910 || code == 911 { return code + 63 }
        if code >= 913 && code <= 939 && code != 930 { return code + 32 }
        if code >= 984 && code <= 1006 { return code | 1 }
        return match code { 1012 => 952, 1015 => 1016, 1017 => 1010, 1018 => 1019, else => code }
    }
    if code >= 1024 && code <= 1327 {
        if code <= 1039 { return code + 80 }
        if code <= 1071 { return code + 32 }
        if code >= 1120 && code <= 1152 || code >= 1162 && code <= 1214 || code >= 1232 && code <= 1268 || code >= 1280 && code <= 1294 {
            return code | 1
        }
        if code == 1272 { return 1273 }
        if code >= 1217 && code <= 1229 { return if code & 1 == 1 { code + 1 } else { code } }
        return code
    }
    if code >= 1329 && code <= 1366 { return code + 48 }
    if code >= 7680 && code <= 7828 || code >= 7840 && code <= 7928 { return code | 1 }
    if code == 7838 { return 223 }
    if code >= 7936 && code <= 8191 { return greekExtendedLower(code) }
    if code == 8486 { return 969 }
    if code == 8490 { return 107 }
    if code == 8491 { return 229 }
    if code >= 8544 && code <= 8559 { return code + 16 }
    if code >= 9398 && code <= 9423 { return code + 26 }
    if code >= 65313 && code <= 65338 { return code + 32 }
    if code >= 66560 && code <= 66599 { return code + 40 }
    return code
}

fn greekExtendedLower(code: u32) -> u32 {
    const low = code & 15
    const row = code & 4294967280
    if row == 7936 || row == 7968 || row == 7984 || row == 8032 || row == 8064 || row == 8080 || row == 8096 {
        return if low >= 8 { code - 8 } else { code }
    }
    if row == 7952 || row == 8000 { return if low >= 8 && low <= 13 { code - 8 } else { code } }
    if code == 8025 || code == 8027 || code == 8029 || code == 8031 { return code - 8 }
    if code == 8120 || code == 8121 || code == 8152 || code == 8153 || code == 8168 || code == 8169 { return code - 8 }
    if code == 8122 || code == 8123 { return code - 74 }
    if code == 8124 || code == 8140 || code == 8188 { return code - 9 }
    if code >= 8136 && code <= 8139 { return code - 86 }
    if code == 8154 || code == 8155 { return code - 100 }
    if code == 8170 || code == 8171 { return code - 112 }
    if code == 8172 { return 8165 }
    if code == 8184 || code == 8185 { return code - 128 }
    if code == 8186 || code == 8187 { return code - 126 }
    return code
}

// The lower case of `keysym`, as libxkbcommon's xkb_keysym_to_lower.
pub fn toLower(names: *const Names, keysym: u32) -> u32 {
    if keysym < 256 { return lowerCode(keysym) }
    if keysym & 4278190080 == 16777216 { return 16777216 | lowerCode(keysym & 16777215) }
    const block = keysym >> 8
    if block == 1 {
        // Latin-2: Aogonek, Lstroke..Sacute, Scaron..Zacute,
        // Zcaron..Zabovedot, Racute..Tcedilla.
        if keysym == 417 { return 433 }
        if keysym >= 419 && keysym <= 422 || keysym >= 425 && keysym <= 428 || keysym >= 430 && keysym <= 431 { return keysym + 16 }
        if keysym >= 448 && keysym <= 478 { return keysym + 32 }
    } else if block == 2 {
        // Latin-3: Hstroke..Hcircumflex, Gbreve..Jcircumflex,
        // Cabovedot..Scircumflex.
        if keysym >= 673 && keysym <= 678 || keysym >= 683 && keysym <= 684 { return keysym + 16 }
        if keysym >= 709 && keysym <= 734 { return keysym + 32 }
    } else if block == 3 {
        // Latin-4: Rcedilla..Tslash, ENG, Amacron..Umacron.
        if keysym >= 931 && keysym <= 940 { return keysym + 16 }
        if keysym == 957 { return 959 }
        if keysym >= 960 && keysym <= 990 { return keysym + 32 }
    } else if block == 6 {
        // Cyrillic: Serbian_DJE..Serbian_DZE, Cyrillic_YU..Cyrillic_HARDSIGN.
        if keysym >= 1713 && keysym <= 1727 { return keysym - 16 }
        if keysym >= 1760 && keysym <= 1791 { return keysym - 32 }
    } else if block == 7 {
        // Greek: Greek_ALPHAaccent..Greek_OMEGAaccent, Greek_ALPHA..Greek_OMEGA.
        if keysym >= 1953 && keysym <= 1963 { return keysym + 16 }
        if keysym >= 1985 && keysym <= 2009 { return keysym + 32 }
    } else if block == 19 {
        // Latin-9: OE, Ydiaeresis.
        if keysym == 5052 { return 5053 }
        if keysym == 5054 { return 255 }
    }
    return keysym
}

// libxkbcommon's xkb_keysym_is_lower and xkb_keysym_is_upper: the keysym
// has two cases and is the lower (upper) one.
pub fn isLower(names: *const Names, keysym: u32) -> bool {
    const lower = toLower(names, keysym)
    const upper = toUpper(names, keysym)
    return lower != upper && keysym == lower
}

pub fn isUpper(names: *const Names, keysym: u32) -> bool {
    const lower = toLower(names, keysym)
    const upper = toUpper(names, keysym)
    return lower != upper && keysym == upper
}

// KP_Space .. KP_Equal.
pub fn isKeypad(keysym: u32) -> bool { return keysym >= 65408 && keysym <= 65469 }
