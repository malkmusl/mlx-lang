// std.xkb.compile: keymaps from the XKB data (/usr/share/X11/xkb), as
// libxkbcommon's xkb_keymap_new_from_names: a model, layouts, variants
// and options go through the rules (std.xkb.rules) to the components'
// include strings, whose files are read section by section
// (std.xkb.parse) and merged (std.xkb.merge).
//
//     var compiler: compile.Compiler = undefined
//     compile.init(&compiler, allocator, &names, environment)
//     const keymap = xkb.create(allocator, &names)
//     if !compile.fromNames(&compiler, keymap, "", "", "de,ru", "", "grp:alt_shift_toggle") {
//         // compile.message(&compiler) says what went wrong
//     }
//
// Files are looked for in $XDG_CONFIG_HOME/xkb (or ~/.config/xkb),
// ~/.xkb, $XKB_CONFIG_EXTRA_PATH (or /etc/xkb) and $XKB_CONFIG_ROOT (or
// /usr/share/X11/xkb), the first that has them.
const std = @import("std")
const xkb = @import("std.xkb")
const keysym = @import("std.xkb.keysym")
const parse = @import("std.xkb.parse")
const merge = @import("std.xkb.merge")
const rules = @import("std.xkb.rules")

pub const MAX_ROOTS: usize = 4
pub const ROOT: usize = 512
// How deep includes may nest.
pub const MAX_DEPTH: usize = 15

pub const Compiler = struct {
    allocator: std.allocator.Allocator
    names: *keysym.Names
    // The directories searched, ROOT bytes apart.
    roots: [2048]u8
    rootLength: [4]usize
    rootCount: usize
    // The section's default action flags (setMods.clearLocks = True),
    // shared by its files.
    actionDefaults: [8]u8
    depth: usize
    // What went wrong, for a message.
    problem: [512]u8
    errorLength: usize
}

fn rootOf(compiler: *Compiler, index: usize) -> []const u8 {
    var base: [*]u8 = undefined
    unsafe { base = @ptrFromInt([*]u8, @intFromPtr(compiler) + @offsetOf(Compiler, "roots")) }
    return base[index * ROOT..index * ROOT + compiler.*.rootLength[index]]
}

fn errorBytes(compiler: *Compiler) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(compiler) + @offsetOf(Compiler, "problem")) }
}

// What went wrong in the last compile ("" when nothing did).
pub fn message(compiler: *Compiler) -> []const u8 { return errorBytes(compiler)[0..compiler.*.errorLength] }

// Keeps the first thing that went wrong (the deepest include).
fn say(compiler: *Compiler, first: []const u8, second: []const u8, third: []const u8) -> void {
    if compiler.*.errorLength > 0 { return }
    var length = std.text.append(errorBytes(compiler), 0, 512, first)
    length = std.text.append(errorBytes(compiler), length, 512, second)
    compiler.*.errorLength = std.text.append(errorBytes(compiler), length, 512, third)
}

fn sayMore(compiler: *Compiler, text: []const u8) -> void {
    compiler.*.errorLength = std.text.append(errorBytes(compiler), compiler.*.errorLength, 512, text)
}

// Adds a directory to search when it is one.
fn addRoot(compiler: *Compiler, first: []const u8, second: []const u8) -> void {
    if compiler.*.rootCount >= MAX_ROOTS || first.length == 0 { return }
    const index = compiler.*.rootCount
    var base: [*]u8 = undefined
    unsafe { base = @ptrFromInt([*]u8, @intFromPtr(compiler) + @offsetOf(Compiler, "roots") + index * ROOT) }
    var length = std.text.append(base, 0, ROOT - 1, first)
    length = std.text.append(base, length, ROOT - 1, second)
    base[length] = 0
    const directory = std.fs.open(base, std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(directory) { return }
    const closed = std.fs.close(directory)
    compiler.*.rootLength[index] = length
    compiler.*.rootCount += 1
}

fn variable(environment: [*][*]const u8, name: []const u8) -> []const u8 {
    const value = std.process.environmentFrom(environment, name)
    if value == null { return "" }
    return std.string.asSlice(value.?)
}

// Prepares a compiler: the directories it searches, from the environment
// (a NUL-terminated list such as a program starts with).
pub fn init(compiler: *Compiler, allocator: std.allocator.Allocator, names: *keysym.Names, environment: [*][*]const u8) -> void {
    compiler.*.allocator = allocator
    compiler.*.names = names
    compiler.*.rootCount = 0
    compiler.*.depth = 0
    compiler.*.errorLength = 0
    const config = variable(environment, "XDG_CONFIG_HOME")
    const home = variable(environment, "HOME")
    if config.length > 0 { addRoot(compiler, config, "/xkb") } else if home.length > 0 { addRoot(compiler, home, "/.config/xkb") }
    if home.length > 0 { addRoot(compiler, home, "/.xkb") }
    const extra = variable(environment, "XKB_CONFIG_EXTRA_PATH")
    addRoot(compiler, if extra.length > 0 { extra } else { "/etc/xkb" }, "")
    const root = variable(environment, "XKB_CONFIG_ROOT")
    addRoot(compiler, if root.length > 0 { root } else { "/usr/share/X11/xkb" }, "")
}

// Reads `directory`/`file` from the `root`th directory (an empty list
// when there is none).
fn readFile(compiler: *Compiler, root: usize, directory: []const u8, file: []const u8) -> std.fs.ArrayList {
    var path: [1024]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &path) }
    var length = std.text.append(bytes, 0, 1023, rootOf(compiler, root))
    length = std.text.append(bytes, length, 1023, "/")
    length = std.text.append(bytes, length, 1023, directory)
    length = std.text.append(bytes, length, 1023, "/")
    length = std.text.append(bytes, length, 1023, file)
    bytes[length] = 0
    const opened = std.fs.open(bytes, std.fs.READ_ONLY, 0)
    if !std.fs.isValid(opened) { return std.fs.ArrayList.init(compiler.*.allocator, 0) }
    const contents = std.fs.readToEndAlloc(opened, compiler.*.allocator)
    const closed = std.fs.close(opened)
    return contents
}

fn directoryOf(which: u8) -> []const u8 {
    return match which { 0 => "keycodes", 1 => "types", 2 => "compat", else => "symbols" }
}

// One part of an include string: file(map):group, and what comes after.
const Part = struct {
    file: []const u8
    map: []const u8
    group: []const u8
    // The text after it and how it merges (+ or |; 0 at the end).
    rest: []const u8
    next: u8
}

fn splitPart(text: []const u8, part: *Part) -> bool {
    var end: usize = 0
    while end < text.length && text[end] != 43 && text[end] != 124 { end += 1 }
    part.*.next = if end < text.length { text[end] } else { 0 }
    part.*.rest = if end < text.length { text[end + 1..text.length] } else { text[text.length..text.length] }
    var piece = text[0..end]
    part.*.group = ""
    var colon: usize = 0
    while colon < piece.length && piece[colon] != 58 { colon += 1 }
    if colon < piece.length {
        part.*.group = piece[colon + 1..piece.length]
        piece = piece[0..colon]
    }
    var open: usize = 0
    while open < piece.length && piece[open] != 40 { open += 1 }
    part.*.map = ""
    if open == piece.length {
        part.*.file = piece
        return true
    }
    if open == 0 || piece[piece.length - 1] != 41 { return false }
    part.*.file = piece[0..open]
    part.*.map = piece[open + 1..piece.length - 1]
    return true
}

fn numberOf(text: []const u8) -> u32 {
    var value: u32 = 0
    for byte in text {
        if byte < 48 || byte > 57 { return 0 }
        value = value * 10 + @intCast(u32, byte - 48)
    }
    return value
}

// Reads one file's section into `into`; false when no directory has it.
fn readPart(compiler: *Compiler, into: *xkb.Keymap, which: u8, part: *Part, group: u32) -> bool {
    var root: usize = 0
    var seen = false
    while root < compiler.*.rootCount {
        const contents = readFile(compiler, root, directoryOf(which), part.*.file)
        if contents.length > 0 {
            seen = true
            const text = contents.items[0..contents.length]
            const at = parse.findSection(into, text, which, part.*.map)
            if at != 0 {
                var context: *anyopaque = undefined
                unsafe { context = @ptrCast(*anyopaque, compiler) }
                const ok = parse.parseSection(into, text, at, which, group, actionDefaultsOf(compiler), includeFiles, context)
                if !ok {
                    var line: [24]u8 = undefined
                    var line_bytes: [*]u8 = undefined
                    unsafe { line_bytes = @ptrCast([*]u8, &line) }
                    const written = std.text.appendUnsigned(line_bytes, 0, 24, into.*.errorLine)
                    if compiler.*.errorLength == 0 {
                        say(compiler, directoryOf(which), "/", part.*.file)
                        sayMore(compiler, ": line ")
                        sayMore(compiler, line_bytes[0..written])
                    }
                }
                contents.deinit()
                return ok
            }
        }
        contents.deinit()
        root += 1
    }
    if compiler.*.errorLength > 0 { return false }
    if seen {
        say(compiler, directoryOf(which), "/", part.*.file)
        sayMore(compiler, " has no section ")
        sayMore(compiler, part.*.map)
    } else {
        say(compiler, "no file ", directoryOf(which), "/")
        sayMore(compiler, part.*.file)
    }
    return false
}

fn actionDefaultsOf(compiler: *Compiler) -> [*]u8 {
    unsafe { return @ptrFromInt([*]u8, @intFromPtr(compiler) + @offsetOf(Compiler, "actionDefaults")) }
}

// The includer (parse.Includer): reads every file of the include string
// into a keymap of its own, merging them in turn, and merges the result
// into `keymap` with `mode`.
fn includeFiles(context: *anyopaque, keymap: *xkb.Keymap, which: u8, include: []const u8, mode: u8, group: u32) -> bool {
    var compiler: *Compiler = undefined
    unsafe { compiler = @ptrCast(*Compiler, context) }
    if compiler.*.depth >= MAX_DEPTH {
        say(compiler, "includes nest too deep: ", include, "")
        return false
    }
    compiler.*.depth += 1
    const allocator = compiler.*.allocator
    const included = xkb.copy(keymap, allocator)
    xkb.clearSection(included, which)
    var rest = include
    var part_mode = mode
    var ok = true
    while ok && rest.length > 0 {
        var part: Part = undefined
        if !splitPart(rest, &part) {
            say(compiler, "bad include \"", include, "\"")
            ok = false
            break
        }
        rest = part.rest
        if part.file.length == 0 { continue }
        var part_group = group
        if part.group.length > 0 {
            const number = numberOf(part.group)
            if number > 0 && number <= @intCast(u32, xkb.MAX_GROUPS) { part_group = number - 1 }
        }
        const read = xkb.copy(included, allocator)
        xkb.clearSection(read, which)
        ok = readPart(compiler, read, which, &part, part_group)
        if ok { merge.section(included, read, which, part_mode) }
        xkb.destroy(read, allocator)
        part_mode = if part.next == 124 { xkb.MERGE_AUGMENT } else { xkb.MERGE_OVERRIDE }
    }
    if ok { merge.section(keymap, included, which, mode) }
    xkb.destroy(included, allocator)
    compiler.*.depth -= 1
    return ok
}

// Compiles a keymap from its components' include strings (as the rules
// give them) into `keymap`, finished.
pub fn fromComponents(compiler: *Compiler, keymap: *xkb.Keymap, keycodes: []const u8, types: []const u8, compat: []const u8, symbols: []const u8) -> bool {
    compiler.*.errorLength = 0
    compiler.*.depth = 0
    xkb.clear(keymap, compiler.*.names)
    var context: *anyopaque = undefined
    unsafe { context = @ptrCast(*anyopaque, compiler) }
    var which: u8 = 0
    while which <= xkb.SECTION_SYMBOLS {
        std.mem.zero(actionDefaultsOf(compiler), 8)
        const include = match which { 0 => keycodes, 1 => types, 2 => compat, else => symbols }
        if !includeFiles(context, keymap, which, include, xkb.MERGE_DEFAULT, parse.NO_GROUP) { return false }
        which += 1
    }
    xkb.finish(keymap)
    return true
}

// Compiles the keymap for a model, layouts, variants and options (comma
// separated, as in the desktop's settings) through rules file `rules_name`;
// empty ones take libxkbcommon's defaults (evdev, pc105, us).
pub fn fromNames(compiler: *Compiler, keymap: *xkb.Keymap, rules_name: []const u8, model: []const u8, layouts: []const u8, variants: []const u8, options: []const u8) -> bool {
    compiler.*.errorLength = 0
    const name = if rules_name.length > 0 { rules_name } else { "evdev" }
    var root: usize = 0
    var contents = std.fs.ArrayList.init(compiler.*.allocator, 0)
    while root < compiler.*.rootCount && contents.length == 0 {
        contents.deinit()
        contents = readFile(compiler, root, "rules", name)
        root += 1
    }
    if contents.length == 0 {
        say(compiler, "no rules file rules/", name, "")
        return false
    }
    var components: rules.Components = undefined
    const resolved = rules.resolve(contents.items[0..contents.length], if model.length > 0 { model } else { "pc105" }, if layouts.length > 0 { layouts } else { "us" }, variants, options, &components)
    contents.deinit()
    if !resolved {
        say(compiler, "the rules give no keymap for \"", layouts, "\"")
        return false
    }
    return fromComponents(compiler, keymap, rules.component(&components, rules.KEYCODES), rules.component(&components, rules.TYPES), rules.component(&components, rules.COMPAT), rules.component(&components, rules.SYMBOLS))
}

// fromNames with the names libxkbcommon takes from the environment
// (XKB_DEFAULT_RULES, _MODEL, _LAYOUT, _VARIANT, _OPTIONS).
pub fn fromEnvironment(compiler: *Compiler, keymap: *xkb.Keymap, environment: [*][*]const u8) -> bool {
    const layout = variable(environment, "XKB_DEFAULT_LAYOUT")
    return fromNames(compiler, keymap, variable(environment, "XKB_DEFAULT_RULES"), variable(environment, "XKB_DEFAULT_MODEL"), layout, if layout.length > 0 { variable(environment, "XKB_DEFAULT_VARIANT") } else { "" }, variable(environment, "XKB_DEFAULT_OPTIONS"))
}
