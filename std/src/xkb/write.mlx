// std.xkb.write: a keymap as text in the format a compositor sends in
// wl_keyboard.keymap (what libxkbcommon's xkb_keymap_get_as_string
// writes), for a keymap std.xkb.compile made. Every key says its types,
// actions, virtual modifiers and whether it repeats, so a reader
// (libxkbcommon in the clients, std.xkb.parse) gets the same keyboard
// without working them out again.
//
//     const text = write.keymap(keymap, allocator)   // std.fs.ArrayList
const std = @import("std")
const xkb = @import("std.xkb")
const keysym = @import("std.xkb.keysym")
const parse = @import("std.xkb.parse")

const Out = struct {
    list: std.fs.ArrayList
}

fn put(out: *Out, text: []const u8) -> void { out.*.list = out.*.list.appendSlice(text) }

fn putNumber(out: *Out, value: usize) -> void {
    var digits: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    put(out, bytes[0..std.text.appendUnsigned(bytes, 0, 24, value)])
}

fn putHex(out: *Out, value: usize) -> void {
    var digits: [24]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &digits) }
    put(out, "0x")
    put(out, bytes[0..std.text.appendHex(bytes, 0, 24, value)])
}

// A modifier mask by names: Shift+Lock+LevelThree, or none.
fn putMods(out: *Out, keymap: *xkb.Keymap, mask: u32) -> void {
    const real = "Shift Lock Control Mod1 Mod2 Mod3 Mod4 Mod5"
    var written = false
    var bit: usize = 0
    var start: usize = 0
    var index: usize = 0
    while index <= real.length {
        if index == real.length || real[index] == 32 {
            if mask & (@intCast(u32, 1) << @intCast(u5, bit)) != 0 {
                if written { put(out, "+") }
                put(out, real[start..index])
                written = true
            }
            bit += 1
            start = index + 1
        }
        index += 1
    }
    var vmod: usize = 0
    while vmod < keymap.*.vmodCount {
        if mask & (@intCast(u32, 256) << @intCast(u5, vmod)) != 0 {
            if written { put(out, "+") }
            put(out, xkb.vmodName(keymap, vmod))
            written = true
        }
        vmod += 1
    }
    if !written { put(out, "none") }
}

fn putSym(out: *Out, keymap: *xkb.Keymap, sym: u32) -> void {
    if sym == 0 {
        put(out, "NoSymbol")
        return
    }
    var name: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &name) }
    put(out, bytes[0..keysym.nameOf(keymap.*.names, sym, bytes, 64)])
}

fn putVmods(out: *Out, keymap: *xkb.Keymap) -> void {
    if keymap.*.vmodCount == 0 { return }
    put(out, "\tvirtual_modifiers ")
    var index: usize = 0
    while index < keymap.*.vmodCount {
        if index > 0 { put(out, ",") }
        put(out, xkb.vmodName(keymap, index))
        if keymap.*.vmodGiven[index] != 0 {
            put(out, "=")
            putMods(out, keymap, keymap.*.vmodGiven[index])
        }
        index += 1
    }
    put(out, ";\n\n")
}

fn putStates(out: *Out, states: u8) -> void {
    const names = "base latched locked effective"
    var written = false
    var bit: u8 = 1
    var start: usize = 0
    var index: usize = 0
    while index <= names.length {
        if index == names.length || names[index] == 32 {
            if states & bit != 0 {
                if written { put(out, "+") }
                put(out, names[start..index])
                written = true
            }
            bit = bit << 1
            start = index + 1
        }
        index += 1
    }
    if !written { put(out, "none") }
}

fn putControls(out: *Out, controls: u32) -> void {
    const names = parse.CONTROL_NAMES
    var written = false
    var bit: u32 = 1
    var start: usize = 0
    var index: usize = 0
    while index <= names.length {
        if index == names.length || names[index] == 32 {
            if controls & bit != 0 {
                if written { put(out, "+") }
                put(out, names[start..index])
                written = true
            }
            bit = bit << 1
            start = index + 1
        }
        index += 1
    }
    if !written { put(out, "none") }
}

// An action: SetMods(modifiers=Shift,clearLocks), NoAction().
fn putAction(out: *Out, keymap: *xkb.Keymap, kind: u8, flags: u8, mods: u32, group: i32) -> void {
    if kind == xkb.ACTION_NONE {
        put(out, "NoAction()")
        return
    }
    if kind >= xkb.ACTION_OTHER {
        put(out, xkb.actionText(keymap, mods, group))
        return
    }
    put(out, match kind { 1 => "SetMods(", 2 => "LatchMods(", 3 => "LockMods(", 4 => "SetGroup(", 5 => "LatchGroup(", else => "LockGroup(" })
    if kind <= xkb.ACTION_LOCK_MODS {
        put(out, "modifiers=")
        if flags & xkb.FLAG_MODMAP_MODS != 0 { put(out, "modMapMods") } else { putMods(out, keymap, mods) }
    } else {
        put(out, "group=")
        if flags & xkb.FLAG_GROUP_ABSOLUTE != 0 {
            putNumber(out, @intCast(usize, group + 1))
        } else {
            put(out, if group < 0 { "-" } else { "+" })
            putNumber(out, @intCast(usize, if group < 0 { 0 - group } else { group }))
        }
    }
    if flags & xkb.FLAG_CLEAR_LOCKS != 0 { put(out, ",clearLocks") }
    if flags & xkb.FLAG_LATCH_TO_LOCK != 0 { put(out, ",latchToLock") }
    const no_lock = flags & xkb.FLAG_LOCK_NO_LOCK != 0
    const no_unlock = flags & xkb.FLAG_LOCK_NO_UNLOCK != 0
    if no_lock && no_unlock { put(out, ",affect=neither") } else if no_lock { put(out, ",affect=unlock") } else if no_unlock { put(out, ",affect=lock") }
    put(out, ")")
}

fn keycodes(out: *Out, keymap: *xkb.Keymap) -> void {
    put(out, "xkb_keycodes \"(unnamed)\" {\n\tminimum = ")
    putNumber(out, @intCast(usize, if keymap.*.minKeycode < 8 { keymap.*.minKeycode } else { 8 }))
    put(out, ";\n\tmaximum = ")
    putNumber(out, @intCast(usize, if keymap.*.maxKeycode > 255 { keymap.*.maxKeycode } else { 255 }))
    put(out, ";\n")
    var keycode: usize = 0
    while keycode < xkb.MAX_KEYCODE {
        const name = xkb.keyName(keymap, @intCast(u32, keycode))
        if name.length > 0 {
            put(out, "\t<")
            put(out, name)
            put(out, "> = ")
            putNumber(out, keycode)
            put(out, ";\n")
        }
        keycode += 1
    }
    var led: usize = 0
    while led < keymap.*.ledCount {
        if xkb.ledName(keymap, led).length > 0 {
            put(out, "\tindicator ")
            putNumber(out, led + 1)
            put(out, " = \"")
            put(out, xkb.ledName(keymap, led))
            put(out, "\";\n")
        }
        led += 1
    }
    // Aliases to keys there are, not hiding a key's own name.
    var alias: usize = 0
    while alias < keymap.*.aliasCount {
        const name = xkb.stored(xkb.bytesOf(keymap, @offsetOf(xkb.Keymap, "aliasNames")), alias * xkb.NAME, xkb.NAME)
        const target = xkb.stored(xkb.bytesOf(keymap, @offsetOf(xkb.Keymap, "aliasTargets")), alias * xkb.NAME, xkb.NAME)
        var shadows = false
        var target_named = false
        keycode = 0
        while keycode < xkb.MAX_KEYCODE {
            const key_name = xkb.keyName(keymap, @intCast(u32, keycode))
            if std.text.same(key_name, name) { shadows = true }
            if std.text.same(key_name, target) { target_named = true }
            keycode += 1
        }
        if target_named && !shadows {
            put(out, "\talias <")
            put(out, name)
            put(out, "> = <")
            put(out, target)
            put(out, ">;\n")
        }
        alias += 1
    }
    put(out, "};\n\n")
}

fn types(out: *Out, keymap: *xkb.Keymap) -> void {
    put(out, "xkb_types \"(unnamed)\" {\n")
    putVmods(out, keymap)
    var index: usize = 0
    while index < keymap.*.typeCount {
        put(out, "\ttype \"")
        put(out, xkb.typeName(keymap, index))
        put(out, "\" {\n\t\tmodifiers= ")
        putMods(out, keymap, keymap.*.typeMods[index])
        put(out, ";\n")
        var entry: usize = 0
        while entry < @intCast(usize, keymap.*.typeEntryCount[index]) {
            const at = index * xkb.MAX_ENTRIES + entry
            put(out, "\t\tmap[")
            putMods(out, keymap, keymap.*.entryMods[at])
            put(out, "]= ")
            putNumber(out, @intCast(usize, keymap.*.entryLevel[at]) + 1)
            put(out, ";\n")
            if keymap.*.entryPreserve[at] != 0 {
                put(out, "\t\tpreserve[")
                putMods(out, keymap, keymap.*.entryMods[at])
                put(out, "]= ")
                putMods(out, keymap, keymap.*.entryPreserve[at])
                put(out, ";\n")
            }
            entry += 1
        }
        var level: usize = 0
        while level < @intCast(usize, keymap.*.typeLevels[index]) {
            const name = xkb.levelName(keymap, index, level)
            if name.length > 0 {
                put(out, "\t\tlevel_name[")
                putNumber(out, level + 1)
                put(out, "]= \"")
                put(out, name)
                put(out, "\";\n")
            }
            level += 1
        }
        put(out, "\t};\n")
        index += 1
    }
    put(out, "};\n\n")
}

fn compat(out: *Out, keymap: *xkb.Keymap) -> void {
    put(out, "xkb_compatibility \"(unnamed)\" {\n")
    putVmods(out, keymap)
    put(out, "\tinterpret.useModMapMods= AnyLevel;\n\tinterpret.repeat= False;\n")
    var index: usize = 0
    while index < keymap.*.interpretCount {
        put(out, "\tinterpret ")
        if keymap.*.interpretAny[index] { put(out, "Any") } else { putSym(out, keymap, keymap.*.interpretSym[index]) }
        put(out, "+")
        put(out, match keymap.*.interpretMatch[index] { 0 => "NoneOf(", 1 => "AnyOfOrNone(", 2 => "AnyOf(", 3 => "AllOf(", else => "Exactly(" })
        putMods(out, keymap, keymap.*.interpretMods[index])
        put(out, ") {\n")
        if keymap.*.interpretVmod[index] >= 0 {
            put(out, "\t\tvirtualModifier= ")
            put(out, xkb.vmodName(keymap, @intCast(usize, keymap.*.interpretVmod[index])))
            put(out, ";\n")
        }
        if keymap.*.interpretLevelOne[index] { put(out, "\t\tuseModMapMods=level1;\n") }
        // (Never an empty body: libxkbcommon does not read one.)
        put(out, if keymap.*.interpretRepeat[index] { "\t\trepeat= True;\n" } else { "\t\trepeat= False;\n" })
        if keymap.*.interpretActionKind[index] != xkb.ACTION_NONE {
            put(out, "\t\taction= ")
            putAction(out, keymap, keymap.*.interpretActionKind[index], keymap.*.interpretActionFlags[index], keymap.*.interpretActionMods[index], keymap.*.interpretActionGroup[index])
            put(out, ";\n")
        }
        put(out, "\t};\n")
        index += 1
    }
    var map: usize = 0
    while map < keymap.*.ledMapCount {
        const which_mods = keymap.*.ledWhichMods[map]
        const which_groups = keymap.*.ledWhichGroups[map]
        if which_mods != 0 || keymap.*.ledMods[map] != 0 || which_groups != 0 || keymap.*.ledGroups[map] != 0 || keymap.*.ledControls[map] != 0 {
            put(out, "\tindicator \"")
            put(out, xkb.ledMapName(keymap, map))
            put(out, "\" {\n")
            if which_groups != 0 || keymap.*.ledGroups[map] != 0 {
                if which_groups != 0 && which_groups != xkb.STATE_EFFECTIVE {
                    put(out, "\t\twhichGroupState= ")
                    putStates(out, which_groups)
                    put(out, ";\n")
                }
                put(out, "\t\tgroups= ")
                putHex(out, @intCast(usize, keymap.*.ledGroups[map]))
                put(out, ";\n")
            }
            if which_mods != 0 || keymap.*.ledMods[map] != 0 {
                if which_mods != 0 && which_mods != xkb.STATE_EFFECTIVE {
                    put(out, "\t\twhichModState= ")
                    putStates(out, which_mods)
                    put(out, ";\n")
                }
                put(out, "\t\tmodifiers= ")
                putMods(out, keymap, keymap.*.ledMods[map])
                put(out, ";\n")
            }
            if keymap.*.ledControls[map] != 0 {
                put(out, "\t\tcontrols= ")
                putControls(out, keymap.*.ledControls[map])
                put(out, ";\n")
            }
            put(out, "\t};\n")
        }
        map += 1
    }
    put(out, "};\n\n")
}

fn groupLabel(out: *Out, word: []const u8, group: usize) -> void {
    put(out, word)
    put(out, "[Group")
    putNumber(out, group + 1)
    put(out, "]= ")
}

fn key(out: *Out, keymap: *xkb.Keymap, keycode: usize) -> void {
    const groups = @intCast(usize, keymap.*.keyGroups[keycode])
    put(out, "\tkey <")
    put(out, xkb.keyName(keymap, @intCast(u32, keycode)))
    put(out, "> {\n\t\trepeat= ")
    put(out, if keymap.*.keyRepeats[keycode] { "Yes" } else { "No" })
    put(out, ",\n\t\tvmods= ")
    putMods(out, keymap, keymap.*.keyVmodmap[keycode])
    const range = keymap.*.keyRange[keycode]
    if range == xkb.RANGE_CLAMP { put(out, ",\n\t\tgroupsClamp") }
    if range == xkb.RANGE_REDIRECT {
        put(out, ",\n\t\tgroupsRedirect= Group")
        putNumber(out, @intCast(usize, keymap.*.keyRedirect[keycode]) + 1)
    }
    var has_actions = false
    var group: usize = 0
    while group < groups {
        put(out, ",\n\t\t")
        groupLabel(out, "type", group)
        put(out, "\"")
        const type_index = keymap.*.keyTypes[keycode * xkb.MAX_GROUPS + group]
        put(out, if type_index == xkb.NO_TYPE { "ONE_LEVEL" } else { xkb.typeName(keymap, @intCast(usize, type_index)) })
        put(out, "\"")
        group += 1
    }
    group = 0
    while group < groups {
        put(out, ",\n\t\t")
        groupLabel(out, "symbols", group)
        put(out, "[ ")
        const width = @intCast(usize, keymap.*.keyWidth[keycode * xkb.MAX_GROUPS + group])
        var level: usize = 0
        while level < width {
            const slot = xkb.slotOf(keycode, group, level)
            if keymap.*.actionKind[slot] != xkb.ACTION_NONE { has_actions = true }
            if level > 0 { put(out, ", ") }
            const count = @intCast(usize, keymap.*.slotCount[slot])
            const first = @intCast(usize, keymap.*.slotFirst[slot])
            if count == 0 { put(out, "NoSymbol") }
            if count == 1 { putSym(out, keymap, keymap.*.syms[first]) }
            if count > 1 {
                put(out, "{ ")
                var index: usize = 0
                while index < count {
                    if index > 0 { put(out, ", ") }
                    putSym(out, keymap, keymap.*.syms[first + index])
                    index += 1
                }
                put(out, " }")
            }
            level += 1
        }
        if width == 0 { put(out, "NoSymbol") }
        put(out, " ]")
        group += 1
    }
    group = 0
    while has_actions && group < groups {
        put(out, ",\n\t\t")
        groupLabel(out, "actions", group)
        put(out, "[ ")
        const width = @intCast(usize, keymap.*.keyWidth[keycode * xkb.MAX_GROUPS + group])
        var level: usize = 0
        while level < width {
            const slot = xkb.slotOf(keycode, group, level)
            if level > 0 { put(out, ", ") }
            putAction(out, keymap, keymap.*.actionKind[slot], keymap.*.actionFlags[slot], keymap.*.actionMods[slot], keymap.*.actionGroup[slot])
            level += 1
        }
        if width == 0 { put(out, "NoAction()") }
        put(out, " ]")
        group += 1
    }
    put(out, "\n\t};\n")
}

fn symbols(out: *Out, keymap: *xkb.Keymap) -> void {
    put(out, "xkb_symbols \"(unnamed)\" {\n")
    var group: usize = 0
    while group < xkb.MAX_GROUPS {
        if xkb.groupName(keymap, group).length > 0 {
            put(out, "\t")
            groupLabel(out, "name", group)
            put(out, "\"")
            put(out, xkb.groupName(keymap, group))
            put(out, "\";\n")
        }
        group += 1
    }
    put(out, "\n")
    var keycode: usize = 0
    while keycode < xkb.MAX_KEYCODE {
        if keymap.*.keyGroups[keycode] > 0 && xkb.keyName(keymap, @intCast(u32, keycode)).length > 0 { key(out, keymap, keycode) }
        keycode += 1
    }
    const real = "Shift Lock Control Mod1 Mod2 Mod3 Mod4 Mod5"
    var bit: usize = 0
    var start: usize = 0
    var index: usize = 0
    while index <= real.length {
        if index == real.length || real[index] == 32 {
            var written = false
            keycode = 0
            while keycode < xkb.MAX_KEYCODE {
                if keymap.*.keyModmap[keycode] & (@intCast(u8, 1) << @intCast(u3, bit)) != 0 && xkb.keyName(keymap, @intCast(u32, keycode)).length > 0 {
                    if !written {
                        put(out, "\tmodifier_map ")
                        put(out, real[start..index])
                        put(out, " { ")
                    } else {
                        put(out, ", ")
                    }
                    put(out, "<")
                    put(out, xkb.keyName(keymap, @intCast(u32, keycode)))
                    put(out, ">")
                    written = true
                }
                keycode += 1
            }
            if written { put(out, " };\n") }
            bit += 1
            start = index + 1
        }
        index += 1
    }
    put(out, "};\n\n")
}

// The keymap as text (NUL not included).
pub fn keymap(map: *xkb.Keymap, allocator: std.allocator.Allocator) -> std.fs.ArrayList {
    var out = Out.{ .list = std.fs.ArrayList.init(allocator, 131072) }
    put(&out, "xkb_keymap {\n")
    keycodes(&out, map)
    types(&out, map)
    compat(&out, map)
    symbols(&out, map)
    put(&out, "};\n")
    return out.list
}
