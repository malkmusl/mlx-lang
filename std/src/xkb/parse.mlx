// std.xkb.parse: reads XKB text into a keymap (std.xkb): a whole keymap
// as a compositor sends it (parse), or one section of a source file of the
// XKB data (/usr/share/X11/xkb) for std.xkb.compile (parseSection), with
// its include statements handed to the compiler.
const std = @import("std")
const xkb = @import("std.xkb")
const keysym = @import("std.xkb.keysym")
const merge = @import("std.xkb.merge")

// ---------------------------------------------------------------------------
// Tokens

const TOKEN_END: u8 = 0
const TOKEN_IDENT: u8 = 1
const TOKEN_NUMBER: u8 = 2
const TOKEN_STRING: u8 = 3
const TOKEN_KEYNAME: u8 = 4
const TOKEN_PUNCT: u8 = 5

// Hands an include statement to the compiler (std.xkb.compile):
// `include` (an include string such as "pc+de(nodeadkeys)+ru:2") read
// into section `which` of `keymap`, merged with `mode` (xkb.MERGE_*);
// `group` is the group the including file's keys go to (NO_GROUP: their
// own). False when a file is missing or wrong.
pub const Includer = fn(context: *anyopaque, keymap: *xkb.Keymap, which: u8, include: []const u8, mode: u8, group: u32) -> bool

// The including file's keys keep their groups.
pub const NO_GROUP: u32 = 255

const Parser = struct {
    keymap: *xkb.Keymap
    text: []const u8
    at: usize
    line: usize
    kind: u8
    start: usize
    end: usize
    number: u32
    failed: bool
    // The merge mode of the statement at hand (xkb.MERGE_*).
    mode: u8
    // The interpretations' defaults (interpret.useModMapMods = ...) and
    // which of them the file set (xkb.INTERPRET_*).
    levelOne: bool
    repeat: bool
    interpretDefined: u8
    // Default flags per action kind (setMods.clearLocks = True), shared by
    // the files of a section.
    actionDefaults: [*]u8
    // The group this file's keys go to (`:2` in the include), NO_GROUP.
    group: u32
    hasIncluder: bool
    includer: Includer
    includeContext: *anyopaque
}

fn noIncluder(context: *anyopaque, keymap: *xkb.Keymap, which: u8, include: []const u8, mode: u8, group: u32) -> bool { return false }

fn initParser(parser: *Parser, keymap: *xkb.Keymap, text: []const u8, action_defaults: [*]u8) -> void {
    parser.*.keymap = keymap
    parser.*.text = text
    parser.*.at = 0
    parser.*.line = 0
    parser.*.kind = TOKEN_END
    parser.*.start = 0
    parser.*.end = 0
    parser.*.number = 0
    parser.*.failed = false
    parser.*.mode = xkb.MERGE_DEFAULT
    parser.*.levelOne = false
    parser.*.repeat = false
    parser.*.interpretDefined = 0
    parser.*.actionDefaults = action_defaults
    parser.*.group = NO_GROUP
    parser.*.hasIncluder = false
    parser.*.includer = noIncluder
    unsafe { parser.*.includeContext = @ptrCast(*anyopaque, keymap) }
}

fn isIdentByte(byte: u8) -> bool {
    return byte >= 97 && byte <= 122 || byte >= 65 && byte <= 90 || byte >= 48 && byte <= 57 || byte == 95
}

fn next(parser: *Parser) -> void {
    const text = parser.*.text
    while parser.*.at < text.length {
        const byte = text[parser.*.at]
        if byte == 10 {
            parser.*.line += 1
            parser.*.at += 1
        } else if byte == 32 || byte == 9 || byte == 13 {
            parser.*.at += 1
        } else if byte == 35 || byte == 47 && parser.*.at + 1 < text.length && text[parser.*.at + 1] == 47 {
            while parser.*.at < text.length && text[parser.*.at] != 10 { parser.*.at += 1 }
        } else {
            break
        }
    }
    parser.*.start = parser.*.at
    if parser.*.at >= text.length {
        parser.*.kind = TOKEN_END
        parser.*.end = parser.*.at
        return
    }
    const first = text[parser.*.at]
    if first == 34 {
        parser.*.at += 1
        parser.*.start = parser.*.at
        while parser.*.at < text.length && text[parser.*.at] != 34 {
            if text[parser.*.at] == 92 { parser.*.at += 1 }
            parser.*.at += 1
        }
        parser.*.end = if parser.*.at < text.length { parser.*.at } else { text.length }
        if parser.*.at < text.length { parser.*.at += 1 }
        parser.*.kind = TOKEN_STRING
        return
    }
    if first == 60 {
        parser.*.at += 1
        parser.*.start = parser.*.at
        while parser.*.at < text.length && text[parser.*.at] != 62 { parser.*.at += 1 }
        parser.*.end = parser.*.at
        if parser.*.at < text.length { parser.*.at += 1 }
        parser.*.kind = TOKEN_KEYNAME
        return
    }
    if first >= 48 && first <= 57 {
        var value: u32 = 0
        if first == 48 && parser.*.at + 1 < text.length && (text[parser.*.at + 1] == 120 || text[parser.*.at + 1] == 88) {
            parser.*.at += 2
            while parser.*.at < text.length && std.text.hexValue(text[parser.*.at]) < 16 {
                value = value * 16 + @intCast(u32, std.text.hexValue(text[parser.*.at]))
                parser.*.at += 1
            }
        } else {
            while parser.*.at < text.length && text[parser.*.at] >= 48 && text[parser.*.at] <= 57 {
                value = value * 10 + @intCast(u32, text[parser.*.at] - 48)
                parser.*.at += 1
            }
        }
        parser.*.number = value
        parser.*.end = parser.*.at
        parser.*.kind = TOKEN_NUMBER
        return
    }
    if isIdentByte(first) {
        while parser.*.at < text.length && isIdentByte(text[parser.*.at]) { parser.*.at += 1 }
        parser.*.end = parser.*.at
        parser.*.kind = TOKEN_IDENT
        return
    }
    parser.*.at += 1
    parser.*.end = parser.*.at
    parser.*.kind = TOKEN_PUNCT
}

fn token(parser: *Parser) -> []const u8 { return parser.*.text[parser.*.start..parser.*.end] }

fn isPunct(parser: *Parser, byte: u8) -> bool {
    return parser.*.kind == TOKEN_PUNCT && parser.*.text[parser.*.start] == byte
}

fn isWord(parser: *Parser, word: []const u8) -> bool {
    return parser.*.kind == TOKEN_IDENT && xkb.sameIgnoringCase(token(parser), word)
}

// Takes the punctuation `byte` if it comes next.
fn accept(parser: *Parser, byte: u8) -> bool {
    if !isPunct(parser, byte) { return false }
    next(parser)
    return true
}

fn expect(parser: *Parser, byte: u8) -> void {
    if !accept(parser, byte) { fail(parser) }
}

fn fail(parser: *Parser) -> void {
    if !parser.*.failed { parser.*.keymap.*.errorLine = parser.*.line + 1 }
    parser.*.failed = true
}

// Skips to after the `;` that ends the statement at hand (or to before the
// `}` that ends the block), past nested brackets.
fn skipStatement(parser: *Parser) -> void {
    var depth: usize = 0
    while parser.*.kind != TOKEN_END {
        if depth == 0 && isPunct(parser, 59) {
            next(parser)
            return
        }
        if depth == 0 && isPunct(parser, 125) { return }
        if isPunct(parser, 123) || isPunct(parser, 40) || isPunct(parser, 91) {
            depth += 1
        } else if (isPunct(parser, 125) || isPunct(parser, 41) || isPunct(parser, 93)) && depth > 0 {
            depth -= 1
        }
        next(parser)
    }
}

// ---------------------------------------------------------------------------
// Values

// A modifier expression: names joined by + or |.
fn parseMods(parser: *Parser) -> u32 {
    var mask: u32 = 0
    while true {
        if parser.*.kind == TOKEN_IDENT {
            mask |= xkb.modifierByName(parser.*.keymap, token(parser))
            next(parser)
        } else if parser.*.kind == TOKEN_NUMBER {
            mask |= parser.*.number
            next(parser)
        } else {
            fail(parser)
            return mask
        }
        if !accept(parser, 43) && !accept(parser, 124) { return mask }
    }
    return mask
}

// A level ("2", "Level2"), from 0.
fn parseLevel(parser: *Parser) -> u32 {
    var value: u32 = 0
    if parser.*.kind == TOKEN_NUMBER {
        value = parser.*.number
    } else if parser.*.kind == TOKEN_IDENT && token(parser).length > 5 && xkb.sameIgnoringCase(token(parser)[0..5], "level") {
        value = numberIn(token(parser)[5..token(parser).length])
    } else {
        fail(parser)
    }
    next(parser)
    return if value > 0 { value - 1 } else { 0 }
}

// A group ("1", "Group1"), from 0.
fn parseGroup(parser: *Parser) -> u32 {
    var value: u32 = 0
    if parser.*.kind == TOKEN_NUMBER {
        value = parser.*.number
    } else if parser.*.kind == TOKEN_IDENT && token(parser).length > 5 && xkb.sameIgnoringCase(token(parser)[0..5], "group") {
        value = numberIn(token(parser)[5..token(parser).length])
    } else {
        fail(parser)
    }
    next(parser)
    return if value > 0 { value - 1 } else { 0 }
}

fn numberIn(text: []const u8) -> u32 {
    var value: u32 = 0
    for byte in text {
        if byte < 48 || byte > 57 { return 0 }
        value = value * 10 + @intCast(u32, byte - 48)
    }
    return value
}

fn parseBool(parser: *Parser) -> bool {
    const value = isWord(parser, "true") || isWord(parser, "yes") || isWord(parser, "on")
    next(parser)
    return value
}

// A keysym in a symbols list: a name, a single digit (that digit's
// keysym) or a number (the keysym's value).
fn parseKeysym(parser: *Parser) -> u32 {
    var value: u32 = 0
    if parser.*.kind == TOKEN_NUMBER {
        value = if parser.*.end - parser.*.start == 1 { 48 + parser.*.number } else { parser.*.number }
    } else if parser.*.kind == TOKEN_IDENT {
        value = keysymNamed(parser.*.keymap, token(parser))
    } else {
        fail(parser)
    }
    next(parser)
    return value
}

// The action kind a name stands for (ACTION_NONE for those not modelled).
fn actionKind(name: []const u8) -> u8 {
    if xkb.sameIgnoringCase(name, "SetMods") { return xkb.ACTION_SET_MODS }
    if xkb.sameIgnoringCase(name, "LatchMods") { return xkb.ACTION_LATCH_MODS }
    if xkb.sameIgnoringCase(name, "LockMods") { return xkb.ACTION_LOCK_MODS }
    if xkb.sameIgnoringCase(name, "SetGroup") { return xkb.ACTION_SET_GROUP }
    if xkb.sameIgnoringCase(name, "LatchGroup") { return xkb.ACTION_LATCH_GROUP }
    if xkb.sameIgnoringCase(name, "LockGroup") { return xkb.ACTION_LOCK_GROUP }
    return xkb.ACTION_NONE
}

// Actions after which a latch ends (as for keys without an action).
fn breaksLatch(name: []const u8) -> bool {
    const names = "PtrBtn PointerButton LockPtrBtn LockPointerButton LockPtrButton LockPointerBtn SetControls LockControls SwitchScreen Terminate TerminateServer"
    var start: usize = 0
    var index: usize = 0
    while index <= names.length {
        if index == names.length || names[index] == 32 {
            if xkb.sameIgnoringCase(names[start..index], name) { return true }
            start = index + 1
        }
        index += 1
    }
    return false
}

// An action this keymap does not model, kept as its text.
fn otherAction(parser: *Parser, kind: *u8, mods: *u32, group: *i32) -> void {
    const start = parser.*.start
    kind.* = if breaksLatch(token(parser)) { xkb.ACTION_OTHER_BREAKING } else { xkb.ACTION_OTHER }
    next(parser)
    var end = parser.*.end
    if isPunct(parser, 40) {
        var depth: usize = 0
        while parser.*.kind != TOKEN_END {
            if isPunct(parser, 40) { depth += 1 }
            if isPunct(parser, 41) {
                depth -= 1
                if depth == 0 {
                    end = parser.*.end
                    next(parser)
                    break
                }
            }
            next(parser)
        }
    }
    const text = parser.*.text[start..end]
    mods.* = xkb.keepActionText(parser.*.keymap, text)
    group.* = @intCast(i32, text.length)
}

// An action: Name(argument, name=value, ...). Only the modifier and group
// actions do anything here; the others are read as no action.
fn parseAction(parser: *Parser, kind: *u8, flags: *u8, mods: *u32, group: *i32) -> void {
    kind.* = xkb.ACTION_NONE
    flags.* = 0
    mods.* = 0
    group.* = 0
    if parser.*.kind != TOKEN_IDENT {
        fail(parser)
        return
    }
    kind.* = actionKind(token(parser))
    flags.* = parser.*.actionDefaults[@intCast(usize, kind.*)]
    if kind.* == xkb.ACTION_NONE && !isWord(parser, "NoAction") {
        otherAction(parser, kind, mods, group)
        return
    }
    next(parser)
    expect(parser, 40)
    while !parser.*.failed && !isPunct(parser, 41) && parser.*.kind != TOKEN_END {
        var negated = false
        if accept(parser, 33) || accept(parser, 126) { negated = true }
        if parser.*.kind != TOKEN_IDENT {
            skipArgument(parser)
        } else {
            const name = token(parser)
            next(parser)
            // An indexed argument (Private's data[0]=...).
            if accept(parser, 91) {
                while parser.*.kind != TOKEN_END && !accept(parser, 93) { next(parser) }
            }
            var on = !negated
            if xkb.sameIgnoringCase(name, "modifiers") || xkb.sameIgnoringCase(name, "mods") {
                expect(parser, 61)
                if isWord(parser, "modMapMods") || isWord(parser, "useModMapMods") {
                    flags.* |= xkb.FLAG_MODMAP_MODS
                    next(parser)
                } else {
                    mods.* = parseMods(parser)
                }
            } else if xkb.sameIgnoringCase(name, "group") {
                expect(parser, 61)
                var sign: i32 = 0
                if accept(parser, 43) { sign = 1 } else if accept(parser, 45) { sign = -1 }
                const value = @intCast(i32, parseGroup(parser)) + 1
                if sign == 0 {
                    flags.* |= xkb.FLAG_GROUP_ABSOLUTE
                    group.* = value - 1
                } else {
                    group.* = sign * value
                }
            } else if xkb.sameIgnoringCase(name, "clearLocks") || xkb.sameIgnoringCase(name, "clearmods") {
                if accept(parser, 61) { on = parseBool(parser) }
                if on { flags.* |= xkb.FLAG_CLEAR_LOCKS } else { flags.* &= ~xkb.FLAG_CLEAR_LOCKS }
            } else if xkb.sameIgnoringCase(name, "latchToLock") {
                if accept(parser, 61) { on = parseBool(parser) }
                if on { flags.* |= xkb.FLAG_LATCH_TO_LOCK } else { flags.* &= ~xkb.FLAG_LATCH_TO_LOCK }
            } else if xkb.sameIgnoringCase(name, "affect") {
                expect(parser, 61)
                if isWord(parser, "lock") { flags.* |= xkb.FLAG_LOCK_NO_UNLOCK }
                if isWord(parser, "unlock") { flags.* |= xkb.FLAG_LOCK_NO_LOCK }
                if isWord(parser, "neither") { flags.* |= xkb.FLAG_LOCK_NO_LOCK | xkb.FLAG_LOCK_NO_UNLOCK }
                next(parser)
            } else {
                if accept(parser, 61) { skipArgument(parser) }
            }
        }
        if !accept(parser, 44) { break }
    }
    expect(parser, 41)
}

// Skips one action argument's value, to the `,` or `)` after it.
fn skipArgument(parser: *Parser) -> void {
    var depth: usize = 0
    while parser.*.kind != TOKEN_END {
        if depth == 0 && (isPunct(parser, 44) || isPunct(parser, 41)) { return }
        if isPunct(parser, 40) || isPunct(parser, 91) { depth += 1 }
        if (isPunct(parser, 41) || isPunct(parser, 93)) && depth > 0 { depth -= 1 }
        next(parser)
    }
}

// ---------------------------------------------------------------------------
// Keymaps and source files

// Reads a whole keymap (xkb_keymap { xkb_keycodes ... }) into `keymap`
// and finishes it (xkb.finish).
pub fn parse(keymap: *xkb.Keymap, text: []const u8) -> bool {
    var defaults: [8]u8 = undefined
    var defaults_bytes: [*]u8 = undefined
    unsafe { defaults_bytes = @ptrCast([*]u8, &defaults) }
    std.mem.zero(defaults_bytes, 8)
    var parser: Parser = undefined
    initParser(&parser, keymap, text, defaults_bytes)
    xkb.clearKey(keymap, 0)
    next(&parser)
    if !isWord(&parser, "xkb_keymap") {
        fail(&parser)
        return false
    }
    next(&parser)
    if parser.kind == TOKEN_STRING { next(&parser) }
    expect(&parser, 123)
    while !parser.failed && parser.kind != TOKEN_END && !isPunct(&parser, 125) {
        const which = sectionKind(&parser)
        if which > xkb.SECTION_SYMBOLS {
            skipStatement(&parser)
        } else {
            next(&parser)
            if parser.kind == TOKEN_STRING { next(&parser) }
            sectionBody(&parser, which)
        }
    }
    if parser.failed { return false }
    xkb.finish(keymap)
    return true
}

// The section the word at hand starts (SECTION_*; 4 for any other word).
fn sectionKind(parser: *Parser) -> u8 {
    if isWord(parser, "xkb_keycodes") { return xkb.SECTION_KEYCODES }
    if isWord(parser, "xkb_types") { return xkb.SECTION_TYPES }
    if isWord(parser, "xkb_compatibility") || isWord(parser, "xkb_compat") || isWord(parser, "xkb_compatibility_map") { return xkb.SECTION_COMPAT }
    if isWord(parser, "xkb_symbols") { return xkb.SECTION_SYMBOLS }
    return 4
}

// Where section `which` named `name` starts in a source file of the XKB
// data (its `{`): the one named so, else (`name` empty) the one marked
// default, else the first. 0 when there is none.
pub fn findSection(keymap: *xkb.Keymap, text: []const u8, which: u8, name: []const u8) -> usize {
    var defaults: [8]u8 = undefined
    var defaults_bytes: [*]u8 = undefined
    unsafe { defaults_bytes = @ptrCast([*]u8, &defaults) }
    var parser: Parser = undefined
    initParser(&parser, keymap, text, defaults_bytes)
    var found: usize = 0
    var have_default = false
    next(&parser)
    while parser.kind != TOKEN_END {
        // Flags (default, partial, alphanumeric_keys, ...), the kind, the
        // name, the body.
        var is_default = false
        while parser.kind == TOKEN_IDENT && sectionKind(&parser) > xkb.SECTION_SYMBOLS {
            if isWord(&parser, "default") { is_default = true }
            next(&parser)
        }
        if parser.kind != TOKEN_IDENT {
            next(&parser)
            continue
        }
        const kind = sectionKind(&parser)
        next(&parser)
        var section_name: []const u8 = ""
        if parser.kind == TOKEN_STRING {
            section_name = token(&parser)
            next(&parser)
        }
        if kind == which && isPunct(&parser, 123) {
            if name.length > 0 {
                if std.text.same(section_name, name) { return parser.start }
            } else if found == 0 || is_default && !have_default {
                found = parser.start
                have_default = is_default
            }
        }
        skipStatement(&parser)
    }
    return found
}

// Reads the section of a source file whose `{` is at `at` (findSection)
// into `keymap` (not finished). Include statements go to `includer`;
// `group` is where the file's keys go (NO_GROUP: their own groups);
// `action_defaults` (8 bytes) are the section's default action flags.
// False when the section is wrong (keymap.errorLine says where) or an
// include failed.
pub fn parseSection(keymap: *xkb.Keymap, text: []const u8, at: usize, which: u8, group: u32, action_defaults: [*]u8, includer: Includer, context: *anyopaque) -> bool {
    var parser: Parser = undefined
    initParser(&parser, keymap, text, action_defaults)
    parser.hasIncluder = true
    parser.includer = includer
    parser.includeContext = context
    parser.group = group
    // The keys' defaults (key.type = ...) start empty.
    xkb.clearKey(keymap, 0)
    var index: usize = 0
    while index < at && index < text.length {
        if text[index] == 10 { parser.line += 1 }
        index += 1
    }
    parser.at = at
    next(&parser)
    sectionBody(&parser, which)
    return !parser.failed
}

// A section's statements, from its `{` to after its `};`.
fn sectionBody(parser: *Parser, which: u8) -> void {
    expect(parser, 123)
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
        // A merge mode: of the statement, or of an include.
        var mode = xkb.MERGE_DEFAULT
        var merges = true
        if isWord(parser, "augment") {
            mode = xkb.MERGE_AUGMENT
        } else if isWord(parser, "override") {
            mode = xkb.MERGE_OVERRIDE
        } else if isWord(parser, "replace") || isWord(parser, "alternate") {
            mode = xkb.MERGE_REPLACE
        } else if !isWord(parser, "include") {
            merges = false
        }
        if merges { next(parser) }
        if merges && parser.*.kind == TOKEN_STRING {
            include(parser, which, token(parser), mode)
            next(parser)
            const ended = accept(parser, 59)
            continue
        }
        parser.*.mode = mode
        if which == xkb.SECTION_KEYCODES {
            keycodesStatement(parser)
        } else if which == xkb.SECTION_TYPES {
            typesStatement(parser)
        } else if which == xkb.SECTION_COMPAT {
            compatStatement(parser)
        } else {
            symbolsStatement(parser)
        }
    }
    expect(parser, 125)
    const ended = accept(parser, 59)
}

fn include(parser: *Parser, which: u8, text: []const u8, mode: u8) -> void {
    if !parser.*.hasIncluder {
        fail(parser)
        return
    }
    const includer = parser.*.includer
    if !includer(parser.*.includeContext, parser.*.keymap, which, text, mode, parser.*.group) { fail(parser) }
}

// The mode a definition in this file merges with what the file has:
// override unless the statement says.
fn fileMode(parser: *Parser) -> u8 {
    return if parser.*.mode == xkb.MERGE_DEFAULT { xkb.MERGE_OVERRIDE } else { parser.*.mode }
}

// ---------------------------------------------------------------------------
// xkb_keycodes

fn keycodesStatement(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    var mode = fileMode(parser)
    if mode == xkb.MERGE_REPLACE { mode = xkb.MERGE_OVERRIDE }
    if parser.*.kind == TOKEN_KEYNAME {
        const name = token(parser)
        next(parser)
        expect(parser, 61)
        if parser.*.kind == TOKEN_NUMBER && parser.*.number < @intCast(u32, xkb.MAX_KEYCODE) {
            merge.keyName(keymap, @intCast(usize, parser.*.number), name, mode)
        }
        skipStatement(parser)
        return
    }
    if isWord(parser, "alias") {
        next(parser)
        if parser.*.kind == TOKEN_KEYNAME {
            const alias = token(parser)
            next(parser)
            expect(parser, 61)
            if parser.*.kind == TOKEN_KEYNAME { merge.alias(keymap, alias, token(parser), mode) }
        }
        skipStatement(parser)
        return
    }
    if isWord(parser, "indicator") {
        next(parser)
        if parser.*.kind == TOKEN_NUMBER && parser.*.number > 0 {
            const index = @intCast(usize, parser.*.number - 1)
            next(parser)
            expect(parser, 61)
            if parser.*.kind == TOKEN_STRING { merge.ledName(keymap, index, token(parser), mode) }
        }
        skipStatement(parser)
        return
    }
    skipStatement(parser)
}

// virtual_modifiers A, B = Mod2, ...;
fn virtualModifiers(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    next(parser)
    while parser.*.kind == TOKEN_IDENT {
        const index = xkb.vmodIndex(keymap, token(parser))
        next(parser)
        if accept(parser, 61) {
            const given = parseMods(parser)
            if index >= 0 { keymap.*.vmodGiven[@intCast(usize, index)] |= xkb.realMods(keymap, given) }
        }
        if !accept(parser, 44) { break }
    }
    skipStatement(parser)
}

// ---------------------------------------------------------------------------
// xkb_types

fn typesStatement(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    if isWord(parser, "virtual_modifiers") {
        virtualModifiers(parser)
        return
    }
    if !isWord(parser, "type") {
        skipStatement(parser)
        return
    }
    next(parser)
    if parser.*.kind != TOKEN_STRING || keymap.*.typeCount >= xkb.MAX_TYPES {
        skipStatement(parser)
        return
    }
    // Read into the place past the types, then merge (a type defined
    // again replaces the one before unless it augments).
    const index = keymap.*.typeCount
    xkb.store(xkb.bytesOf(keymap, @offsetOf(xkb.Keymap, "typeNames")), index * xkb.TYPE_NAME, xkb.TYPE_NAME, token(parser))
    keymap.*.typeMods[index] = 0
    keymap.*.typeLevels[index] = 1
    keymap.*.typeEntryCount[index] = 0
    var level: usize = 0
    while level < xkb.MAX_LEVELS {
        xkb.store(xkb.bytesOf(keymap, @offsetOf(xkb.Keymap, "levelNames")), (index * xkb.MAX_LEVELS + level) * xkb.LEVEL_NAME, xkb.LEVEL_NAME, "")
        level += 1
    }
    next(parser)
    expect(parser, 123)
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
        if isWord(parser, "modifiers") {
            next(parser)
            expect(parser, 61)
            keymap.*.typeMods[index] = parseMods(parser)
            skipStatement(parser)
        } else if isWord(parser, "map") || isWord(parser, "preserve") {
            typeEntry(parser, index, isWord(parser, "map"))
        } else if isWord(parser, "level_name") || isWord(parser, "levelname") {
            next(parser)
            expect(parser, 91)
            const named = parseLevel(parser)
            expect(parser, 93)
            expect(parser, 61)
            if named < @intCast(u32, xkb.MAX_LEVELS) {
                if named + 1 > @intCast(u32, keymap.*.typeLevels[index]) { keymap.*.typeLevels[index] = @intCast(u8, named + 1) }
                if parser.*.kind == TOKEN_STRING {
                    xkb.store(xkb.bytesOf(keymap, @offsetOf(xkb.Keymap, "levelNames")), (index * xkb.MAX_LEVELS + @intCast(usize, named)) * xkb.LEVEL_NAME, xkb.LEVEL_NAME, token(parser))
                }
            }
            skipStatement(parser)
        } else {
            skipStatement(parser)
        }
    }
    expect(parser, 125)
    expect(parser, 59)
    if !parser.*.failed { merge.addType(keymap, keymap, index, fileMode(parser)) }
}

// map[mods] = level; or preserve[mods] = mods;
fn typeEntry(parser: *Parser, index: usize, map: bool) -> void {
    const keymap = parser.*.keymap
    next(parser)
    expect(parser, 91)
    const mods = parseMods(parser)
    expect(parser, 93)
    expect(parser, 61)
    // The entry for these modifiers (a new one when there is none).
    var entry: usize = 0
    const base = index * xkb.MAX_ENTRIES
    while entry < @intCast(usize, keymap.*.typeEntryCount[index]) && keymap.*.entryMods[base + entry] != mods { entry += 1 }
    if entry == @intCast(usize, keymap.*.typeEntryCount[index]) && entry < xkb.MAX_ENTRIES {
        keymap.*.entryMods[base + entry] = mods
        keymap.*.entryLevel[base + entry] = 0
        keymap.*.entryPreserve[base + entry] = 0
        keymap.*.typeEntryCount[index] += 1
    }
    if entry < xkb.MAX_ENTRIES {
        if map {
            const level = parseLevel(parser)
            keymap.*.entryLevel[base + entry] = @intCast(u8, level)
            if level + 1 > @intCast(u32, keymap.*.typeLevels[index]) { keymap.*.typeLevels[index] = @intCast(u8, level + 1) }
        } else {
            keymap.*.entryPreserve[base + entry] = parseMods(parser)
        }
    }
    skipStatement(parser)
}

// ---------------------------------------------------------------------------
// xkb_compatibility

fn compatStatement(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    if isWord(parser, "virtual_modifiers") {
        virtualModifiers(parser)
        return
    }
    if isWord(parser, "interpret") {
        next(parser)
        if isPunct(parser, 46) {
            next(parser)
            interpretDefault(parser)
            return
        }
        interpret(parser)
        return
    }
    if isWord(parser, "indicator") {
        next(parser)
        if parser.*.kind == TOKEN_STRING {
            indicator(parser)
            return
        }
        skipStatement(parser)
        return
    }
    // An action's default: setMods.clearLocks = True;
    if parser.*.kind == TOKEN_IDENT {
        const kind = actionKind(token(parser))
        next(parser)
        if kind != xkb.ACTION_NONE && accept(parser, 46) && parser.*.kind == TOKEN_IDENT {
            var flag: u8 = 0
            if isWord(parser, "clearLocks") { flag = xkb.FLAG_CLEAR_LOCKS }
            if isWord(parser, "latchToLock") { flag = xkb.FLAG_LATCH_TO_LOCK }
            next(parser)
            if flag != 0 && accept(parser, 61) {
                const at = @intCast(usize, kind)
                if parseBool(parser) {
                    parser.*.actionDefaults[at] |= flag
                } else {
                    parser.*.actionDefaults[at] &= ~flag
                }
            }
        }
    }
    skipStatement(parser)
}

// interpret.useModMapMods = ...; interpret.repeat = ...;
fn interpretDefault(parser: *Parser) -> void {
    if isWord(parser, "useModMapMods") || isWord(parser, "useModMap") {
        next(parser)
        expect(parser, 61)
        parser.*.levelOne = isWord(parser, "level1") || isWord(parser, "levelone")
        parser.*.interpretDefined |= xkb.INTERPRET_LEVEL_ONE
    } else if isWord(parser, "repeat") {
        next(parser)
        expect(parser, 61)
        parser.*.repeat = isWord(parser, "true") || isWord(parser, "yes") || isWord(parser, "on")
        parser.*.interpretDefined |= xkb.INTERPRET_REPEAT
    }
    skipStatement(parser)
}

// interpret Sym+Predicate(mods) { ... };
fn interpret(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    if keymap.*.interpretCount >= xkb.MAX_INTERPRETS {
        skipStatement(parser)
        return
    }
    // Read into the place past the interpretations, then merge.
    const index = keymap.*.interpretCount
    keymap.*.interpretAny[index] = isWord(parser, "Any")
    keymap.*.interpretSym[index] = if isWord(parser, "Any") { 0 } else { parseKeysymValue(parser) }
    next(parser)
    // No predicate: any modifiers or none.
    keymap.*.interpretMatch[index] = xkb.MATCH_ANY_OR_NONE
    keymap.*.interpretMods[index] = xkb.REAL_MODS
    if accept(parser, 43) {
        // Sym+Predicate(mods); Sym+Any; a bare Sym+mods means Exactly(mods).
        var predicate = xkb.MATCH_EXACTLY
        var named = true
        if isWord(parser, "AnyOfOrNone") { predicate = xkb.MATCH_ANY_OR_NONE } else if isWord(parser, "AnyOf") { predicate = xkb.MATCH_ANY } else if isWord(parser, "AllOf") { predicate = xkb.MATCH_ALL } else if isWord(parser, "NoneOf") { predicate = xkb.MATCH_NONE } else if isWord(parser, "Exactly") { predicate = xkb.MATCH_EXACTLY } else { named = false }
        if !named && isWord(parser, "Any") {
            next(parser)
            predicate = xkb.MATCH_ANY
        } else if named {
            next(parser)
            expect(parser, 40)
            keymap.*.interpretMods[index] = parseMods(parser) & xkb.REAL_MODS
            expect(parser, 41)
        } else {
            keymap.*.interpretMods[index] = parseMods(parser) & xkb.REAL_MODS
        }
        keymap.*.interpretMatch[index] = predicate
    }
    keymap.*.interpretVmod[index] = -1
    keymap.*.interpretLevelOne[index] = parser.*.levelOne
    keymap.*.interpretRepeat[index] = parser.*.repeat
    keymap.*.interpretDefined[index] = parser.*.interpretDefined
    keymap.*.interpretActionKind[index] = xkb.ACTION_NONE
    keymap.*.interpretActionFlags[index] = 0
    keymap.*.interpretActionMods[index] = 0
    keymap.*.interpretActionGroup[index] = 0
    expect(parser, 123)
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
        if isWord(parser, "useModMapMods") || isWord(parser, "useModMap") {
            next(parser)
            expect(parser, 61)
            keymap.*.interpretLevelOne[index] = isWord(parser, "level1") || isWord(parser, "levelone")
            keymap.*.interpretDefined[index] |= xkb.INTERPRET_LEVEL_ONE
        } else if isWord(parser, "virtualModifier") || isWord(parser, "virtualMod") {
            next(parser)
            expect(parser, 61)
            if parser.*.kind == TOKEN_IDENT { keymap.*.interpretVmod[index] = xkb.vmodIndex(keymap, token(parser)) }
            keymap.*.interpretDefined[index] |= xkb.INTERPRET_VMOD
        } else if isWord(parser, "repeat") {
            next(parser)
            expect(parser, 61)
            keymap.*.interpretRepeat[index] = parseBool(parser)
            keymap.*.interpretDefined[index] |= xkb.INTERPRET_REPEAT
        } else if isWord(parser, "action") {
            next(parser)
            expect(parser, 61)
            var kind: u8 = 0
            var flags: u8 = 0
            var mods: u32 = 0
            var group: i32 = 0
            parseAction(parser, &kind, &flags, &mods, &group)
            keymap.*.interpretActionKind[index] = kind
            keymap.*.interpretActionFlags[index] = flags
            keymap.*.interpretActionMods[index] = mods
            keymap.*.interpretActionGroup[index] = group
            keymap.*.interpretDefined[index] |= xkb.INTERPRET_ACTION
        }
        skipStatement(parser)
    }
    expect(parser, 125)
    expect(parser, 59)
    if !parser.*.failed { merge.addInterpret(keymap, keymap, index, fileMode(parser)) }
}

// The state components named (base, latched, locked, effective, ...).
fn parseStates(parser: *Parser) -> u8 {
    var states: u8 = 0
    while parser.*.kind == TOKEN_IDENT {
        if isWord(parser, "base") { states |= xkb.STATE_BASE }
        if isWord(parser, "latched") { states |= xkb.STATE_LATCHED }
        if isWord(parser, "locked") { states |= xkb.STATE_LOCKED }
        if isWord(parser, "effective") || isWord(parser, "compat") || isWord(parser, "any") || isWord(parser, "all") { states |= xkb.STATE_EFFECTIVE }
        next(parser)
        if !accept(parser, 43) && !accept(parser, 124) { break }
    }
    return states
}

// A group mask: All - group1, group2 + group3, 0xfe.
fn parseGroups(parser: *Parser) -> u32 {
    var mask: u32 = 0
    var subtract = false
    while true {
        var term: u32 = 0
        if parser.*.kind == TOKEN_NUMBER {
            term = parser.*.number
        } else if isWord(parser, "all") {
            term = 255
        } else if isWord(parser, "none") {
            term = 0
        } else if parser.*.kind == TOKEN_IDENT {
            const group = numberIn(token(parser)[if token(parser).length > 5 { 5 } else { token(parser).length }..token(parser).length])
            if group > 0 && group <= 8 { term = @intCast(u32, 1) << @intCast(u5, group - 1) }
        } else {
            return mask
        }
        next(parser)
        if subtract { mask &= ~term } else { mask |= term }
        if accept(parser, 45) {
            subtract = true
        } else if accept(parser, 43) || accept(parser, 124) {
            subtract = false
        } else {
            return mask
        }
    }
    return mask
}

// The controls named (MouseKeys, ...), a bit each as CONTROL_NAMES.
pub const CONTROL_NAMES = "RepeatKeys SlowKeys BounceKeys StickyKeys MouseKeys MouseKeysAccel AccessXKeys AccessXTimeout AccessXFeedback AudibleBell Overlay1 Overlay2 IgnoreGroupLock"

fn controlBit(name: []const u8) -> u32 {
    const names = CONTROL_NAMES
    var bit: u32 = 1
    var start: usize = 0
    var index: usize = 0
    while index <= names.length {
        if index == names.length || names[index] == 32 {
            if xkb.sameIgnoringCase(names[start..index], name) { return bit }
            bit = bit << 1
            start = index + 1
        }
        index += 1
    }
    if xkb.sameIgnoringCase(name, "all") { return 8191 }
    return 0
}

fn parseControls(parser: *Parser) -> u32 {
    var mask: u32 = 0
    while parser.*.kind == TOKEN_IDENT {
        mask |= controlBit(token(parser))
        next(parser)
        if !accept(parser, 43) && !accept(parser, 124) { break }
    }
    return mask
}

// indicator "Caps Lock" { whichModState = locked; modifiers = Lock; };
fn indicator(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    if keymap.*.ledMapCount >= xkb.MAX_LEDS {
        skipStatement(parser)
        return
    }
    const index = keymap.*.ledMapCount
    xkb.store(xkb.bytesOf(keymap, @offsetOf(xkb.Keymap, "ledMapNames")), index * xkb.LED_NAME, xkb.LED_NAME, token(parser))
    keymap.*.ledMapDefined[index] = 0
    keymap.*.ledWhichMods[index] = 0
    keymap.*.ledMods[index] = 0
    keymap.*.ledWhichGroups[index] = 0
    keymap.*.ledGroups[index] = 0
    keymap.*.ledControls[index] = 0
    next(parser)
    expect(parser, 123)
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
        const negated = accept(parser, 33) || accept(parser, 126)
        if isWord(parser, "modifiers") || isWord(parser, "mods") {
            next(parser)
            expect(parser, 61)
            keymap.*.ledMods[index] = parseMods(parser)
            keymap.*.ledMapDefined[index] |= xkb.LED_MODS
        } else if isWord(parser, "whichModState") || isWord(parser, "whichModifierState") {
            next(parser)
            expect(parser, 61)
            keymap.*.ledWhichMods[index] = parseStates(parser)
            keymap.*.ledMapDefined[index] |= xkb.LED_MODS
        } else if isWord(parser, "groups") {
            next(parser)
            expect(parser, 61)
            keymap.*.ledGroups[index] = parseGroups(parser)
            keymap.*.ledMapDefined[index] |= xkb.LED_GROUPS
        } else if isWord(parser, "whichGroupState") {
            next(parser)
            expect(parser, 61)
            keymap.*.ledWhichGroups[index] = parseStates(parser)
            keymap.*.ledMapDefined[index] |= xkb.LED_GROUPS
        } else if isWord(parser, "controls") || isWord(parser, "ctrls") {
            next(parser)
            expect(parser, 61)
            keymap.*.ledControls[index] = parseControls(parser)
            keymap.*.ledMapDefined[index] |= xkb.LED_CONTROLS
        }
        skipStatement(parser)
    }
    expect(parser, 125)
    expect(parser, 59)
    if !parser.*.failed { merge.addLedMap(keymap, keymap, index, fileMode(parser)) }
}

// The keysym named by the token at hand (not taking it).
fn parseKeysymValue(parser: *Parser) -> u32 {
    if parser.*.kind == TOKEN_NUMBER { return if parser.*.end - parser.*.start == 1 { 48 + parser.*.number } else { parser.*.number } }
    if parser.*.kind != TOKEN_IDENT { return 0 }
    return keysymNamed(parser.*.keymap, token(parser))
}

// A keysym by name; any and NoSymbol are none, none and VoidSymbol the
// void one (as libxkbcommon reads them).
fn keysymNamed(keymap: *xkb.Keymap, name: []const u8) -> u32 {
    if xkb.sameIgnoringCase(name, "NoSymbol") || xkb.sameIgnoringCase(name, "any") { return 0 }
    if xkb.sameIgnoringCase(name, "VoidSymbol") || xkb.sameIgnoringCase(name, "none") { return keysym.VOID_SYMBOL }
    return keysym.fromName(keymap.*.names, name)
}

// ---------------------------------------------------------------------------
// xkb_symbols. A key statement is read into keycode 1, starting from the
// defaults (key.type = ..., in keycode 0), then merged into the key.

const DEFAULT_KEY: usize = 0
const READ_KEY: usize = 1

fn symbolsStatement(parser: *Parser) -> void {
    const keymap = parser.*.keymap
    if isWord(parser, "virtual_modifiers") {
        virtualModifiers(parser)
        return
    }
    if isWord(parser, "name") || isWord(parser, "groupname") {
        next(parser)
        expect(parser, 91)
        var group = parseGroup(parser)
        expect(parser, 93)
        expect(parser, 61)
        // A file read into one group names that group only.
        var ok = group < @intCast(u32, xkb.MAX_GROUPS)
        if parser.*.group != NO_GROUP {
            ok = group == 0
            group = parser.*.group
        }
        if ok && parser.*.kind == TOKEN_STRING {
            xkb.store(xkb.bytesOf(keymap, @offsetOf(xkb.Keymap, "groupNames")), @intCast(usize, group) * xkb.GROUP_NAME, xkb.GROUP_NAME, token(parser))
        }
        skipStatement(parser)
        return
    }
    if isWord(parser, "key") {
        next(parser)
        // key.field = value: a default for the keys after it.
        if accept(parser, 46) {
            keyField(parser, DEFAULT_KEY)
            skipStatement(parser)
            return
        }
        if parser.*.kind != TOKEN_KEYNAME {
            skipStatement(parser)
            return
        }
        const keycode = @intCast(usize, xkb.keycodeOf(keymap, token(parser)))
        next(parser)
        xkb.copyKey(keymap, READ_KEY, keymap, DEFAULT_KEY)
        keyBody(parser, READ_KEY)
        intoGroup(parser, READ_KEY)
        // Keys the keycodes do not name are left out.
        if !parser.*.failed && keycode > READ_KEY { merge.key(keymap, keycode, keymap, READ_KEY, parser.*.mode) }
        return
    }
    if isWord(parser, "modifier_map") || isWord(parser, "modmap") || isWord(parser, "mod_map") {
        next(parser)
        const mods = xkb.modifierByName(keymap, token(parser)) & xkb.REAL_MODS
        var modifier: u8 = 0
        while modifier < 8 && mods != @intCast(u32, 1) << @intCast(u5, modifier) { modifier += 1 }
        next(parser)
        expect(parser, 123)
        while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
            if modifier < 8 {
                if parser.*.kind == TOKEN_KEYNAME {
                    const keycode = xkb.keycodeOf(keymap, token(parser))
                    if keycode != 0 { merge.modmap(keymap, keycode, 0, modifier, parser.*.mode) }
                } else {
                    const sym = parseKeysymValue(parser)
                    if sym != 0 { merge.modmap(keymap, 0, sym, modifier, parser.*.mode) }
                }
            }
            next(parser)
            if !accept(parser, 44) { break }
        }
        expect(parser, 125)
        expect(parser, 59)
        return
    }
    skipStatement(parser)
}

// A file read into one group (`:2`): its keys' first group goes there,
// their other groups are dropped.
fn intoGroup(parser: *Parser, key: usize) -> void {
    const target = parser.*.group
    if target == NO_GROUP || target >= @intCast(u32, xkb.MAX_GROUPS) { return }
    const keymap = parser.*.keymap
    var group: usize = 1
    while group < xkb.MAX_GROUPS {
        xkb.clearGroup(keymap, key, group)
        group += 1
    }
    if target > 0 {
        xkb.copyGroup(keymap, key, @intCast(usize, target), keymap, key, 0)
        xkb.clearGroup(keymap, key, 0)
    }
}

// { [ syms ], type = "...", symbols[Group2] = [ ... ], ... };
fn keyBody(parser: *Parser, key: usize) -> void {
    expect(parser, 123)
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
        if isPunct(parser, 91) {
            symbolList(parser, key, firstGroupWithout(parser.*.keymap, key, xkb.GROUP_SYMS))
        } else {
            keyField(parser, key)
        }
        if !accept(parser, 44) { break }
    }
    expect(parser, 125)
    expect(parser, 59)
}

// The first group of the key that does not define `what` yet.
fn firstGroupWithout(keymap: *xkb.Keymap, key: usize, what: u8) -> u32 {
    var group: usize = 0
    while group + 1 < xkb.MAX_GROUPS && keymap.*.groupDefined[key * xkb.MAX_GROUPS + group] & what != 0 { group += 1 }
    return @intCast(u32, group)
}

// One field of a key: name[group] = value, or a flag on its own.
fn keyField(parser: *Parser, key: usize) -> void {
    const keymap = parser.*.keymap
    const negated = accept(parser, 33) || accept(parser, 126)
    if parser.*.kind != TOKEN_IDENT {
        skipValue(parser)
        return
    }
    const name = token(parser)
    next(parser)
    var group: u32 = 0
    var indexed = false
    if accept(parser, 91) {
        group = parseGroup(parser)
        indexed = true
        expect(parser, 93)
    }
    const given = accept(parser, 61)
    if xkb.sameIgnoringCase(name, "symbols") || xkb.sameIgnoringCase(name, "actions") {
        if !indexed {
            group = firstGroupWithout(keymap, key, if xkb.sameIgnoringCase(name, "symbols") { xkb.GROUP_SYMS } else { xkb.GROUP_ACTIONS })
        }
        if xkb.sameIgnoringCase(name, "symbols") { symbolList(parser, key, group) } else { actionList(parser, key, group) }
        return
    }
    if xkb.sameIgnoringCase(name, "type") {
        const type_index = if parser.*.kind == TOKEN_STRING { xkb.typeIndex(keymap, token(parser)) } else { xkb.NO_TYPE }
        next(parser)
        if !indexed {
            keymap.*.keyDefaultType[key] = type_index
            keymap.*.keyExplicit[key] |= xkb.EXPLICIT_DEFAULT_TYPE
        } else if group < @intCast(u32, xkb.MAX_GROUPS) {
            keymap.*.keyTypes[key * xkb.MAX_GROUPS + @intCast(usize, group)] = type_index
            keymap.*.keyExplicit[key] |= xkb.EXPLICIT_TYPE << @intCast(u4, group)
        }
        return
    }
    if xkb.sameIgnoringCase(name, "virtualMods") || xkb.sameIgnoringCase(name, "vmods") || xkb.sameIgnoringCase(name, "virtualModifiers") {
        keymap.*.keyVmodmap[key] = parseMods(parser) & 16776960
        keymap.*.keyExplicit[key] |= xkb.EXPLICIT_VMODMAP
        return
    }
    if xkb.sameIgnoringCase(name, "repeat") || xkb.sameIgnoringCase(name, "repeats") || xkb.sameIgnoringCase(name, "repeating") {
        var value = !negated
        if given {
            if isWord(parser, "default") {
                next(parser)
                return
            }
            value = parseBool(parser)
        }
        keymap.*.keyRepeats[key] = value
        keymap.*.keyExplicit[key] |= xkb.EXPLICIT_REPEAT
        return
    }
    if xkb.sameIgnoringCase(name, "groupsWrap") || xkb.sameIgnoringCase(name, "wrapGroups") || xkb.sameIgnoringCase(name, "groupsClamp") || xkb.sameIgnoringCase(name, "clampGroups") {
        var value = !negated
        if given { value = parseBool(parser) }
        const clamp = xkb.sameIgnoringCase(name, "groupsClamp") || xkb.sameIgnoringCase(name, "clampGroups")
        keymap.*.keyRange[key] = if clamp == value { xkb.RANGE_CLAMP } else { xkb.RANGE_WRAP }
        keymap.*.keyExplicit[key] |= xkb.EXPLICIT_RANGE
        return
    }
    if xkb.sameIgnoringCase(name, "groupsRedirect") || xkb.sameIgnoringCase(name, "redirectGroups") {
        const target = parseGroup(parser)
        keymap.*.keyRange[key] = xkb.RANGE_REDIRECT
        keymap.*.keyRedirect[key] = @intCast(u8, target)
        keymap.*.keyExplicit[key] |= xkb.EXPLICIT_RANGE
        return
    }
    // Anything else (overlays, radio groups, locks): its value.
    if given { skipValue(parser) }
}

// Skips a value up to the `,`, `;` or `}` after it.
fn skipValue(parser: *Parser) -> void {
    var depth: usize = 0
    while parser.*.kind != TOKEN_END {
        if depth == 0 && (isPunct(parser, 44) || isPunct(parser, 125) || isPunct(parser, 59)) { return }
        if isPunct(parser, 40) || isPunct(parser, 91) || isPunct(parser, 123) { depth += 1 }
        if (isPunct(parser, 41) || isPunct(parser, 93) || isPunct(parser, 125)) && depth > 0 { depth -= 1 }
        next(parser)
    }
}

// [ sym, sym, { sym, sym }, ... ] into the key's group.
fn symbolList(parser: *Parser, key: usize, group: u32) -> void {
    const keymap = parser.*.keymap
    const ok_group = group < @intCast(u32, xkb.MAX_GROUPS)
    if ok_group {
        var level: usize = 0
        while level < xkb.MAX_LEVELS {
            const slot = xkb.slotOf(key, @intCast(usize, group), level)
            keymap.*.slotFirst[slot] = 0
            keymap.*.slotCount[slot] = 0
            level += 1
        }
    }
    expect(parser, 91)
    var level: usize = 0
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 93) {
        const ok = ok_group && level < xkb.MAX_LEVELS
        const slot = if ok { xkb.slotOf(key, @intCast(usize, group), level) } else { 0 }
        if ok { keymap.*.slotFirst[slot] = @intCast(u32, keymap.*.symCount) }
        if accept(parser, 123) {
            while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 125) {
                addSym(keymap, ok, slot, parseKeysym(parser))
                if !accept(parser, 44) { break }
            }
            expect(parser, 125)
        } else {
            addSym(keymap, ok, slot, parseKeysym(parser))
        }
        level += 1
        if !accept(parser, 44) { break }
    }
    expect(parser, 93)
    if ok_group {
        const at = key * xkb.MAX_GROUPS + @intCast(usize, group)
        if level > xkb.MAX_LEVELS { level = xkb.MAX_LEVELS }
        if level > @intCast(usize, keymap.*.keyWidth[at]) { keymap.*.keyWidth[at] = @intCast(u8, level) }
        keymap.*.groupDefined[at] |= xkb.GROUP_SYMS
    }
}

fn addSym(keymap: *xkb.Keymap, ok: bool, slot: usize, sym: u32) -> void {
    // NoSymbol in a list of one leaves the level empty.
    if !ok || sym == 0 || keymap.*.symCount >= xkb.MAX_SYMS { return }
    keymap.*.syms[keymap.*.symCount] = sym
    keymap.*.symCount += 1
    keymap.*.slotCount[slot] += 1
}

// [ Action(...), ... ] into the key's group; they replace what the
// compatibility map would give the key.
fn actionList(parser: *Parser, key: usize, group: u32) -> void {
    const keymap = parser.*.keymap
    const ok_group = group < @intCast(u32, xkb.MAX_GROUPS)
    expect(parser, 91)
    var level: usize = 0
    while !parser.*.failed && parser.*.kind != TOKEN_END && !isPunct(parser, 93) {
        var kind: u8 = 0
        var flags: u8 = 0
        var mods: u32 = 0
        var action_group: i32 = 0
        parseAction(parser, &kind, &flags, &mods, &action_group)
        if ok_group && level < xkb.MAX_LEVELS {
            const slot = xkb.slotOf(key, @intCast(usize, group), level)
            keymap.*.actionKind[slot] = kind
            keymap.*.actionFlags[slot] = flags
            keymap.*.actionMods[slot] = mods
            keymap.*.actionGroup[slot] = action_group
        }
        level += 1
        if !accept(parser, 44) { break }
    }
    expect(parser, 93)
    keymap.*.keyExplicit[key] |= xkb.EXPLICIT_INTERP
    if ok_group {
        const at = key * xkb.MAX_GROUPS + @intCast(usize, group)
        if level > xkb.MAX_LEVELS { level = xkb.MAX_LEVELS }
        if level > @intCast(usize, keymap.*.keyWidth[at]) { keymap.*.keyWidth[at] = @intCast(u8, level) }
        keymap.*.groupDefined[at] |= xkb.GROUP_ACTIONS
    }
}
