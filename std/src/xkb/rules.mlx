// std.xkb.rules: from a model, layouts, variants and options (RMLVO, what
// a desktop's keyboard settings name) to the keymap's components (KcCGST:
// the keycodes, types, compat and symbols include strings std.xkb.compile
// reads), through a rules file such as /usr/share/X11/xkb/rules/evdev, as
// libxkbcommon does it.
//
//     var components: rules.Components = undefined
//     rules.resolve(rules_text, "pc105", "de,ru", "nodeadkeys,", "grp:alt_shift_toggle", &components)
//     // components: keycodes "evdev+aliases(qwertz)", types "complete",
//     // compat "complete", symbols "pc+de(nodeadkeys)+ru:2+inet(evdev)+group(alt_shift_toggle)"
const std = @import("std")

pub const MAX_LAYOUTS: usize = 4
pub const MAX_OPTIONS: usize = 32
pub const COMPONENT: usize = 1024

pub const KEYCODES: usize = 0
pub const TYPES: usize = 1
pub const COMPAT: usize = 2
pub const SYMBOLS: usize = 3
pub const GEOMETRY: usize = 4

pub const Components = struct {
    // Each component's include string, COMPONENT bytes apart.
    text: [5120]u8
    length: [5]usize
}

pub fn component(components: *Components, which: usize) -> []const u8 {
    var base: [*]u8 = undefined
    unsafe { base = @ptrFromInt([*]u8, @intFromPtr(components) + @offsetOf(Components, "text")) }
    return base[which * COMPONENT..which * COMPONENT + components.*.length[which]]
}

// What is being matched: the model, up to MAX_LAYOUTS layouts and their
// variants, the options.
const Request = struct {
    model: []const u8
    layouts: [4][]const u8
    variants: [4][]const u8
    layoutCount: usize
    options: [32][]const u8
    optionCount: usize
}

// Splits a comma-separated list into `into` (at most `capacity`); how many.
fn split(text: []const u8, into: [*][]const u8, capacity: usize) -> usize {
    var count: usize = 0
    var start: usize = 0
    var index: usize = 0
    while index <= text.length {
        if index == text.length || text[index] == 44 {
            if count < capacity {
                into[count] = std.text.trimmed(text[start..index])
                count += 1
            }
            start = index + 1
        }
        index += 1
    }
    return count
}

// A mapping (a "! ... = ..." line): what each column of its rules matches
// and fills.
const MLVO_MODEL: u8 = 0
const MLVO_LAYOUT: u8 = 1
const MLVO_VARIANT: u8 = 2
const MLVO_OPTION: u8 = 3

const Mapping = struct {
    mlvo: [4]u8
    mlvoCount: usize
    kccgst: [5]usize
    kccgstCount: usize
    // The layout index the columns name (layout[2]: 1); NO_INDEX for none.
    index: usize
    hasLayout: bool
    hasOption: bool
    skip: bool
}

const NO_INDEX: usize = 4294967295

pub fn resolve(text: []const u8, model: []const u8, layouts: []const u8, variants: []const u8, options: []const u8, out: *Components) -> bool {
    var request: Request = undefined
    request.model = model
    var layout_list: [*][]const u8 = undefined
    var variant_list: [*][]const u8 = undefined
    var option_list: [*][]const u8 = undefined
    unsafe {
        layout_list = @ptrCast([*][]const u8, &request.layouts)
        variant_list = @ptrCast([*][]const u8, &request.variants)
        option_list = @ptrCast([*][]const u8, &request.options)
    }
    request.layoutCount = split(layouts, layout_list, MAX_LAYOUTS)
    const variant_count = split(variants, variant_list, MAX_LAYOUTS)
    var index = variant_count
    while index < MAX_LAYOUTS {
        request.variants[index] = variants[0..0]
        index += 1
    }
    request.optionCount = if options.length == 0 { 0 } else { split(options, option_list, MAX_OPTIONS) }
    var which: usize = 0
    while which < 5 {
        out.*.length[which] = 0
        which += 1
    }
    var mapping: Mapping = undefined
    mapping.mlvoCount = 0
    mapping.kccgstCount = 0
    mapping.skip = true
    var at: usize = 0
    var line: [2048]u8 = undefined
    var line_bytes: [*]u8 = undefined
    unsafe { line_bytes = @ptrCast([*]u8, &line) }
    while at < text.length {
        // A logical line: joined over a backslash at the end, comments cut.
        var length: usize = 0
        while at < text.length {
            const byte = text[at]
            if byte == 10 {
                at += 1
                if length > 0 && line[length - 1] == 92 {
                    length -= 1
                } else {
                    break
                }
            } else {
                if length < 2048 {
                    line[length] = byte
                    length += 1
                }
                at += 1
            }
        }
        var end: usize = 0
        while end + 1 < length && !(line[end] == 47 && line[end + 1] == 47) { end += 1 }
        if end + 1 >= length { end = length }
        const statement = std.text.trimmed(line_bytes[0..end])
        if statement.length == 0 { continue }
        if statement[0] == 33 {
            header(std.text.trimmed(statement[1..statement.length]), &request, &mapping)
        } else if !mapping.skip {
            rule(text, statement, &request, &mapping, out)
        }
    }
    return out.*.length[KEYCODES] > 0 && out.*.length[SYMBOLS] > 0
}

// The words of a line (split at blanks), into `words`; how many.
fn wordsOf(line: []const u8, words: [*][]const u8, capacity: usize) -> usize {
    var count: usize = 0
    var index: usize = 0
    while index < line.length && count < capacity {
        while index < line.length && (line[index] == 32 || line[index] == 9) { index += 1 }
        if index >= line.length { break }
        const start = index
        while index < line.length && line[index] != 32 && line[index] != 9 { index += 1 }
        words[count] = line[start..index]
        count += 1
    }
    return count
}

// A "! ..." line: a group definition ($name = ...), handled where it is
// used, or a mapping.
fn header(line: []const u8, request: *Request, mapping: *Mapping) -> void {
    if line.length > 0 && line[0] == 36 { return }
    if std.text.startsWith(line, "include") {
        mapping.*.skip = true
        return
    }
    var words: [16][]const u8 = undefined
    var list: [*][]const u8 = undefined
    unsafe { list = @ptrCast([*][]const u8, &words) }
    const count = wordsOf(line, list, 16)
    mapping.*.mlvoCount = 0
    mapping.*.kccgstCount = 0
    mapping.*.index = NO_INDEX
    mapping.*.hasLayout = false
    mapping.*.hasOption = false
    mapping.*.skip = false
    var after = false
    var index: usize = 0
    var variant_index = NO_INDEX
    var has_variant = false
    while index < count {
        const word = words[index]
        if std.text.same(word, "=") {
            after = true
        } else if !after {
            var name = word
            var given = NO_INDEX
            var bracket: usize = 0
            while bracket < word.length && word[bracket] != 91 { bracket += 1 }
            if bracket < word.length {
                name = word[0..bracket]
                given = 0
                var digit = bracket + 1
                while digit < word.length && word[digit] >= 48 && word[digit] <= 57 {
                    given = given * 10 + @intCast(usize, word[digit] - 48)
                    digit += 1
                }
                if given > 0 { given -= 1 }
            }
            if mapping.*.mlvoCount < 4 {
                if std.text.same(name, "model") {
                    mapping.*.mlvo[mapping.*.mlvoCount] = MLVO_MODEL
                } else if std.text.same(name, "layout") {
                    mapping.*.mlvo[mapping.*.mlvoCount] = MLVO_LAYOUT
                    mapping.*.hasLayout = true
                    mapping.*.index = given
                } else if std.text.same(name, "variant") {
                    mapping.*.mlvo[mapping.*.mlvoCount] = MLVO_VARIANT
                    has_variant = true
                    variant_index = given
                } else if std.text.same(name, "option") {
                    mapping.*.mlvo[mapping.*.mlvoCount] = MLVO_OPTION
                    mapping.*.hasOption = true
                } else {
                    mapping.*.skip = true
                }
                mapping.*.mlvoCount += 1
            }
        } else if mapping.*.kccgstCount < 5 {
            var target: usize = 5
            if std.text.same(word, "keycodes") { target = KEYCODES }
            if std.text.same(word, "types") { target = TYPES }
            if std.text.same(word, "compat") { target = COMPAT }
            if std.text.same(word, "symbols") { target = SYMBOLS }
            if std.text.same(word, "geometry") { target = GEOMETRY }
            if target == 5 { mapping.*.skip = true }
            mapping.*.kccgst[mapping.*.kccgstCount] = target
            mapping.*.kccgstCount += 1
        }
        index += 1
    }
    if mapping.*.mlvoCount == 0 || mapping.*.kccgstCount == 0 { mapping.*.skip = true }
    if !mapping.*.hasLayout && has_variant { mapping.*.index = variant_index }
    // `layout` without an index is for one layout; `layout[N]` for several.
    if mapping.*.hasLayout || has_variant {
        if mapping.*.index == NO_INDEX {
            if request.*.layoutCount > 1 { mapping.*.skip = true }
        } else if request.*.layoutCount == 1 || mapping.*.index >= request.*.layoutCount {
            mapping.*.skip = true
        }
    }
}

// Whether `value` (a rule's column) matches `given`: * anything, $group a
// member of the group the rules file defines, else the same text.
fn matches(text: []const u8, value: []const u8, given: []const u8) -> bool {
    if std.text.same(value, "*") { return true }
    if value.length > 1 && value[0] == 36 { return inGroup(text, value, given) }
    return std.text.same(value, given)
}

// Whether `given` is one of the words of "! $name = ..." in the rules
// (the list may go on over lines ending in a backslash).
fn inGroup(text: []const u8, name: []const u8, given: []const u8) -> bool {
    var at: usize = 0
    while at < text.length {
        var position = at
        while position < text.length && (text[position] == 32 || text[position] == 9) { position += 1 }
        if position < text.length && text[position] == 33 {
            position += 1
            while position < text.length && (text[position] == 32 || text[position] == 9) { position += 1 }
            const after = position + name.length
            if after < text.length && std.text.same(text[position..after], name) && (text[after] == 32 || text[after] == 9 || text[after] == 61) {
                position = after
                while position < text.length && text[position] != 61 && text[position] != 10 { position += 1 }
                if position < text.length && text[position] == 61 { position += 1 }
                while position < text.length {
                    while position < text.length && (text[position] == 32 || text[position] == 9) { position += 1 }
                    if position >= text.length || text[position] == 10 { return false }
                    if text[position] == 92 {
                        position += 1
                        if position < text.length && text[position] == 10 { position += 1 }
                    } else {
                        const start = position
                        while position < text.length && text[position] != 32 && text[position] != 9 && text[position] != 10 && text[position] != 92 { position += 1 }
                        if std.text.same(text[start..position], given) { return true }
                    }
                }
                return false
            }
        }
        while at < text.length && text[at] != 10 { at += 1 }
        at += 1
    }
    return false
}

fn rule(text: []const u8, line: []const u8, request: *Request, mapping: *Mapping, out: *Components) -> void {
    var words: [16][]const u8 = undefined
    var list: [*][]const u8 = undefined
    unsafe { list = @ptrCast([*][]const u8, &words) }
    const count = wordsOf(line, list, 16)
    if count != mapping.*.mlvoCount + 1 + mapping.*.kccgstCount { return }
    if !std.text.same(words[mapping.*.mlvoCount], "=") { return }
    const layout_index = if mapping.*.index == NO_INDEX { 0 } else { mapping.*.index }
    var column: usize = 0
    while column < mapping.*.mlvoCount {
        const kind = mapping.*.mlvo[column]
        const value = words[column]
        var matched = false
        if kind == MLVO_MODEL { matched = matches(text, value, request.*.model) }
        if kind == MLVO_LAYOUT { matched = matches(text, value, request.*.layouts[layout_index]) }
        if kind == MLVO_VARIANT { matched = matches(text, value, request.*.variants[layout_index]) }
        if kind == MLVO_OPTION {
            var option: usize = 0
            while option < request.*.optionCount && !matched {
                matched = matches(text, value, request.*.options[option])
                option += 1
            }
        }
        if !matched { return }
        column += 1
    }
    column = 0
    while column < mapping.*.kccgstCount {
        const target = mapping.*.kccgst[column]
        if target < 5 { append(out, target, words[mapping.*.mlvoCount + 1 + column], request) }
        column += 1
    }
    // The first matching rule of a set wins, except for options.
    if !mapping.*.hasOption { mapping.*.skip = true }
}

fn isMergePrefix(byte: u8) -> bool { return byte == 43 || byte == 124 }

// The value with %m, %l, %v (and %l[N], %(v), %+l, ...) expanded, added to
// the component: appended when it starts with + or | or the component is
// empty; put in front when only the component starts with one; else the
// component keeps what it has.
fn append(out: *Components, target: usize, value: []const u8, request: *Request) -> void {
    var expanded: [512]u8 = undefined
    var length: usize = 0
    var index: usize = 0
    while index < value.length {
        if value[index] != 37 {
            if length < 512 {
                expanded[length] = value[index]
                length += 1
            }
            index += 1
            continue
        }
        index += 1
        if index >= value.length { return }
        var prefix: u8 = 0
        var suffix: u8 = 0
        if value[index] == 40 || isMergePrefix(value[index]) || value[index] == 95 || value[index] == 45 {
            prefix = value[index]
            if prefix == 40 { suffix = 41 }
            index += 1
            if index >= value.length { return }
        }
        const kind = value[index]
        index += 1
        var item = NO_INDEX
        if index < value.length && value[index] == 91 {
            index += 1
            item = 0
            while index < value.length && value[index] >= 48 && value[index] <= 57 {
                item = item * 10 + @intCast(usize, value[index] - 48)
                index += 1
            }
            if index < value.length && value[index] == 93 { index += 1 }
            if item > 0 { item -= 1 }
        }
        if suffix != 0 {
            if index >= value.length || value[index] != suffix { return }
            index += 1
        }
        var found = value[0..0]
        if kind == 109 {
            found = request.*.model
        } else if kind == 108 || kind == 118 {
            const several = request.*.layoutCount > 1
            var chosen = NO_INDEX
            if item != NO_INDEX && item < request.*.layoutCount && several { chosen = item }
            if item == NO_INDEX && !several { chosen = 0 }
            if chosen != NO_INDEX { found = if kind == 108 { request.*.layouts[chosen] } else { request.*.variants[chosen] } }
        }
        if found.length == 0 { continue }
        if prefix != 0 && length < 512 {
            expanded[length] = prefix
            length += 1
        }
        for byte in found {
            if length < 512 {
                expanded[length] = byte
                length += 1
            }
        }
        if suffix != 0 && length < 512 {
            expanded[length] = suffix
            length += 1
        }
    }
    if length == 0 { return }
    var base: [*]u8 = undefined
    unsafe { base = @ptrFromInt([*]u8, @intFromPtr(out) + @offsetOf(Components, "text") + target * COMPONENT) }
    const existing = out.*.length[target]
    const expanded_merge = isMergePrefix(expanded[0])
    const existing_merge = existing > 0 && isMergePrefix(base[0])
    if expanded_merge || existing == 0 {
        if existing + length > COMPONENT { return }
        var copy: usize = 0
        while copy < length {
            base[existing + copy] = expanded[copy]
            copy += 1
        }
        out.*.length[target] = existing + length
    } else if existing_merge {
        if existing + length > COMPONENT { return }
        var move = existing
        while move > 0 {
            move -= 1
            base[move + length] = base[move]
        }
        var copy: usize = 0
        while copy < length {
            base[copy] = expanded[copy]
            copy += 1
        }
        out.*.length[target] = existing + length
    }
}
