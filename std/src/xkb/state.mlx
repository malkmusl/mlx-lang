// std.xkb.state: a keyboard's state on a keymap (std.xkb): the modifiers
// held, latched and locked, the group, and what a key types in it, as
// libxkbcommon's xkb_state. A Wayland client sets it from
// wl_keyboard.modifiers (updateMask); a compositor follows the keys
// (updateKey) and sends what serialized gives.
const std = @import("std")
const xkb = @import("std.xkb")
const keysym = @import("std.xkb.keysym")

pub const State = struct {
    keymap: *xkb.Keymap
    baseMods: u32
    latchedMods: u32
    lockedMods: u32
    baseGroup: i32
    latchedGroup: i32
    lockedGroup: i32
    // Derived: the effective modifiers and group.
    mods: u32
    group: u32
}

pub fn init(state: *State, keymap: *xkb.Keymap) -> void {
    state.*.keymap = keymap
    state.*.baseMods = 0
    state.*.latchedMods = 0
    state.*.lockedMods = 0
    state.*.baseGroup = 0
    state.*.latchedGroup = 0
    state.*.lockedGroup = 0
    state.*.mods = 0
    state.*.group = 0
}

// A group brought into 0 .. count - 1 by wrapping (0 without groups).
fn wrapGroup(group: i32, count: usize) -> u32 {
    if count == 0 { return 0 }
    const total = @intCast(i32, count)
    if group >= 0 && group < total { return @intCast(u32, group) }
    var wrapped = group % total
    if wrapped < 0 { wrapped += total }
    return @intCast(u32, wrapped)
}

fn derive(state: *State) -> void {
    const groups = state.*.keymap.*.groupCount
    state.*.lockedGroup = @intCast(i32, wrapGroup(state.*.lockedGroup, groups))
    state.*.group = wrapGroup(state.*.baseGroup + state.*.latchedGroup + state.*.lockedGroup, groups)
    state.*.mods = state.*.baseMods | state.*.latchedMods | state.*.lockedMods
}

// The state as a compositor serialized it (xkb_state_update_mask): masks
// of real modifiers (virtual ones are replaced by their real ones) and
// groups.
pub fn updateMask(state: *State, depressed: u32, latched: u32, locked: u32, base_group: i32, latched_group: i32, locked_group: i32) -> void {
    const keymap = state.*.keymap
    state.*.baseMods = xkb.realMods(keymap, depressed)
    state.*.latchedMods = xkb.realMods(keymap, latched)
    state.*.lockedMods = xkb.realMods(keymap, locked)
    state.*.baseGroup = base_group
    state.*.latchedGroup = latched_group
    state.*.lockedGroup = locked_group
    derive(state)
}

// The group `keycode` types in now (its own number of groups, its
// out-of-range rule); NO_GROUP for a key without groups.
pub const NO_GROUP: u32 = 4294967295

pub fn keyGroup(state: *State, keycode: u32) -> u32 {
    const keymap = state.*.keymap
    if keycode >= @intCast(u32, xkb.MAX_KEYCODE) { return NO_GROUP }
    const key = @intCast(usize, keycode)
    const count = @intCast(u32, keymap.*.keyGroups[key])
    if count == 0 { return NO_GROUP }
    const group = state.*.group
    if group < count { return group }
    const range = keymap.*.keyRange[key]
    if range == xkb.RANGE_CLAMP { return count - 1 }
    if range == xkb.RANGE_REDIRECT {
        const redirect = @intCast(u32, keymap.*.keyRedirect[key])
        return if redirect < count { redirect } else { 0 }
    }
    return group % count
}

// The type entry the modifiers select for the key's group (MAX_ENTRIES
// when none does: level 1).
fn entryFor(state: *State, key: usize, group: usize) -> usize {
    const keymap = state.*.keymap
    const type_index = keymap.*.keyTypes[key * xkb.MAX_GROUPS + group]
    if type_index == xkb.NO_TYPE { return xkb.MAX_ENTRIES }
    const t = @intCast(usize, type_index)
    const active = state.*.mods & keymap.*.typeModsReal[t]
    var entry: usize = 0
    while entry < @intCast(usize, keymap.*.typeEntryCount[t]) {
        const at = t * xkb.MAX_ENTRIES + entry
        if keymap.*.entryActive[at] && keymap.*.entryModsReal[at] == active { return entry }
        entry += 1
    }
    return xkb.MAX_ENTRIES
}

// The level the key types in its group now.
pub fn keyLevel(state: *State, keycode: u32, group: u32) -> u32 {
    if group == NO_GROUP || keycode >= @intCast(u32, xkb.MAX_KEYCODE) { return 0 }
    const key = @intCast(usize, keycode)
    const entry = entryFor(state, key, @intCast(usize, group))
    if entry == xkb.MAX_ENTRIES { return 0 }
    const t = @intCast(usize, state.*.keymap.*.keyTypes[key * xkb.MAX_GROUPS + @intCast(usize, group)])
    return @intCast(u32, state.*.keymap.*.entryLevel[t * xkb.MAX_ENTRIES + entry])
}

// The modifiers the key's type uses up now (those it does not preserve):
// they do not also apply to what the key types (Caps Lock, Control).
pub fn consumedMods(state: *State, keycode: u32) -> u32 {
    const group = keyGroup(state, keycode)
    if group == NO_GROUP { return 0 }
    const key = @intCast(usize, keycode)
    const keymap = state.*.keymap
    const type_index = keymap.*.keyTypes[key * xkb.MAX_GROUPS + @intCast(usize, group)]
    if type_index == xkb.NO_TYPE { return 0 }
    const t = @intCast(usize, type_index)
    const entry = entryFor(state, key, @intCast(usize, group))
    const preserve = if entry == xkb.MAX_ENTRIES { 0 } else { keymap.*.entryPreserveReal[t * xkb.MAX_ENTRIES + entry] }
    return keymap.*.typeModsReal[t] & ~preserve
}

// The keysyms the key types now: how many, the first at `first` in the
// keymap's syms.
pub fn keySyms(state: *State, keycode: u32, first: *usize) -> usize {
    const group = keyGroup(state, keycode)
    if group == NO_GROUP { return 0 }
    const level = keyLevel(state, keycode, group)
    if level >= @intCast(u32, xkb.MAX_LEVELS) { return 0 }
    const slot = @intCast(usize, keycode) * xkb.SLOTS + @intCast(usize, group) * xkb.MAX_LEVELS + @intCast(usize, level)
    first.* = @intCast(usize, state.*.keymap.*.slotFirst[slot])
    return @intCast(usize, state.*.keymap.*.slotCount[slot])
}

// The keysym the key types now when it types one (NoSymbol otherwise),
// upper-cased under Caps Lock the key's type does not use.
pub fn keyOneSym(state: *State, keycode: u32) -> u32 {
    var first: usize = 0
    if keySyms(state, keycode, &first) != 1 { return 0 }
    const sym = state.*.keymap.*.syms[first]
    if capsApplies(state, keycode) { return keysym.toUpper(state.*.keymap.*.names, sym) }
    return sym
}

fn capsApplies(state: *State, keycode: u32) -> bool {
    return state.*.mods & xkb.LOCK != 0 && consumedMods(state, keycode) & xkb.LOCK == 0
}

fn controlApplies(state: *State, keycode: u32) -> bool {
    return state.*.mods & xkb.CONTROL != 0 && consumedMods(state, keycode) & xkb.CONTROL == 0
}

// The text the key types now, UTF-8 into `out` (`capacity` bytes); its
// length (0: none, or it would not fit), as xkb_state_key_get_utf8: Caps
// Lock upper-cases, Control makes a control character of a single ASCII
// character, when the key's type does not use them.
pub fn keyUtf8(state: *State, keycode: u32, out: [*]u8, capacity: usize) -> usize {
    const names = state.*.keymap.*.names
    var first: usize = 0
    const count = keySyms(state, keycode, &first)
    if count == 0 { return 0 }
    var length: usize = 0
    var bytes: [4]u8 = undefined
    var bytes_out: [*]u8 = undefined
    unsafe { bytes_out = @ptrCast([*]u8, &bytes) }
    var index: usize = 0
    while index < count {
        var sym = state.*.keymap.*.syms[first + index]
        if count == 1 && sym > 127 && controlApplies(state, keycode) { sym = latinForControl(state, keycode, sym) }
        if count == 1 && capsApplies(state, keycode) { sym = keysym.toUpper(names, sym) }
        const written = keysym.toUtf8(names, sym, bytes_out)
        if written == 0 { return 0 }
        if length + written >= capacity { return 0 }
        var byte: usize = 0
        while byte < written {
            out[length + byte] = bytes[byte]
            byte += 1
        }
        length += written
        index += 1
    }
    if length == 1 && out[0] < 128 && controlApplies(state, keycode) { out[0] = toControl(out[0]) }
    return length
}

// With Control, a key that types no ASCII character (a Cyrillic letter)
// types what it would in the first group where it does (Ctrl+C stays a
// copy in every layout), as libxkbcommon.
fn latinForControl(state: *State, keycode: u32, sym: u32) -> u32 {
    const keymap = state.*.keymap
    const key = @intCast(usize, keycode)
    var group: usize = 0
    while group < @intCast(usize, keymap.*.keyGroups[key]) {
        const level = keyLevel(state, keycode, @intCast(u32, group))
        const slot = key * xkb.SLOTS + group * xkb.MAX_LEVELS + @intCast(usize, level)
        if level < @intCast(u32, xkb.MAX_LEVELS) && keymap.*.slotCount[slot] == 1 {
            const candidate = keymap.*.syms[@intCast(usize, keymap.*.slotFirst[slot])]
            if candidate <= 127 { return candidate }
        }
        group += 1
    }
    return sym
}

// XkbToControl: what Control makes of an ASCII character.
fn toControl(byte: u8) -> u8 {
    if byte >= 64 && byte < 127 || byte == 32 { return byte & 31 }
    if byte == 50 { return 0 }
    if byte >= 51 && byte <= 55 { return byte - 24 }
    if byte == 56 { return 127 }
    if byte == 47 { return 31 }
    return byte
}

// The real modifiers of the modifier `name` ("Shift", "Control", a virtual
// one such as "LevelThree" or "Alt"); 0 when the keymap has none.
pub fn modMask(keymap: *xkb.Keymap, name: []const u8) -> u32 {
    return xkb.realMods(keymap, xkb.modifierByName(keymap, name))
}

pub fn keyRepeats(keymap: *xkb.Keymap, keycode: u32) -> bool {
    if keycode >= @intCast(u32, xkb.MAX_KEYCODE) { return false }
    return keymap.*.keyRepeats[@intCast(usize, keycode)]
}
