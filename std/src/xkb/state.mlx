// std.xkb.state: a keyboard's state on a keymap (std.xkb): the modifiers
// held, latched and locked, the group, and what a key types in it, as
// libxkbcommon's xkb_state. A Wayland client sets it from
// wl_keyboard.modifiers (updateMask); a compositor follows the keys
// (updateKey) and sends what serialized gives.
const std = @import("std")
const xkb = @import("std.xkb")
const keysym = @import("std.xkb.keysym")

pub const State = struct {
    keymap: *xkb.Keymap
    baseMods: u32
    latchedMods: u32
    lockedMods: u32
    baseGroup: i32
    latchedGroup: i32
    lockedGroup: i32
    // Derived: the effective modifiers and group.
    mods: u32
    group: u32
    // Following the keys (updateKey): the modifiers a key press sets and
    // clears, how many held keys set each real modifier, and the actions
    // in progress (filters, libxkbcommon calls them): the key, the action
    // (kind 0: a free place), what it keeps, how often its key is down.
    setMods: u32
    clearMods: u32
    modKeyCount: [8]i32
    filterCount: usize
    filterKey: [64]u32
    filterKind: [64]u8
    filterFlags: [64]u8
    filterMods: [64]u32
    filterGroup: [64]i32
    filterPriv: [64]i32
    filterRefs: [64]i32
}

pub fn init(state: *State, keymap: *xkb.Keymap) -> void {
    state.*.setMods = 0
    state.*.clearMods = 0
    state.*.filterCount = 0
    var index: usize = 0
    while index < 8 {
        state.*.modKeyCount[index] = 0
        index += 1
    }
    state.*.keymap = keymap
    state.*.baseMods = 0
    state.*.latchedMods = 0
    state.*.lockedMods = 0
    state.*.baseGroup = 0
    state.*.latchedGroup = 0
    state.*.lockedGroup = 0
    state.*.mods = 0
    state.*.group = 0
}

// A group brought into 0 .. count - 1 by wrapping (0 without groups).
fn wrapGroup(group: i32, count: usize) -> u32 {
    if count == 0 { return 0 }
    const total = @intCast(i32, count)
    if group >= 0 && group < total { return @intCast(u32, group) }
    var wrapped = group % total
    if wrapped < 0 { wrapped += total }
    return @intCast(u32, wrapped)
}

fn derive(state: *State) -> void {
    const groups = state.*.keymap.*.groupCount
    state.*.lockedGroup = @intCast(i32, wrapGroup(state.*.lockedGroup, groups))
    state.*.group = wrapGroup(state.*.baseGroup + state.*.latchedGroup + state.*.lockedGroup, groups)
    state.*.mods = state.*.baseMods | state.*.latchedMods | state.*.lockedMods
}

// The state as a compositor serialized it (xkb_state_update_mask): masks
// of real modifiers (virtual ones are replaced by their real ones) and
// groups.
pub fn updateMask(state: *State, depressed: u32, latched: u32, locked: u32, base_group: i32, latched_group: i32, locked_group: i32) -> void {
    const keymap = state.*.keymap
    state.*.baseMods = xkb.realMods(keymap, depressed)
    state.*.latchedMods = xkb.realMods(keymap, latched)
    state.*.lockedMods = xkb.realMods(keymap, locked)
    state.*.baseGroup = base_group
    state.*.latchedGroup = latched_group
    state.*.lockedGroup = locked_group
    derive(state)
}

// The group `keycode` types in now (its own number of groups, its
// out-of-range rule); NO_GROUP for a key without groups.
pub const NO_GROUP: u32 = 4294967295

pub fn keyGroup(state: *State, keycode: u32) -> u32 {
    const keymap = state.*.keymap
    if keycode >= @intCast(u32, xkb.MAX_KEYCODE) { return NO_GROUP }
    const key = @intCast(usize, keycode)
    const count = @intCast(u32, keymap.*.keyGroups[key])
    if count == 0 { return NO_GROUP }
    const group = state.*.group
    if group < count { return group }
    const range = keymap.*.keyRange[key]
    if range == xkb.RANGE_CLAMP { return count - 1 }
    if range == xkb.RANGE_REDIRECT {
        const redirect = @intCast(u32, keymap.*.keyRedirect[key])
        return if redirect < count { redirect } else { 0 }
    }
    return group % count
}

// The type entry the modifiers select for the key's group (MAX_ENTRIES
// when none does: level 1).
fn entryFor(state: *State, key: usize, group: usize) -> usize {
    const keymap = state.*.keymap
    const type_index = keymap.*.keyTypes[key * xkb.MAX_GROUPS + group]
    if type_index == xkb.NO_TYPE { return xkb.MAX_ENTRIES }
    const t = @intCast(usize, type_index)
    const active = state.*.mods & keymap.*.typeModsReal[t]
    var entry: usize = 0
    while entry < @intCast(usize, keymap.*.typeEntryCount[t]) {
        const at = t * xkb.MAX_ENTRIES + entry
        if keymap.*.entryActive[at] && keymap.*.entryModsReal[at] == active { return entry }
        entry += 1
    }
    return xkb.MAX_ENTRIES
}

// The level the key types in its group now.
pub fn keyLevel(state: *State, keycode: u32, group: u32) -> u32 {
    if group == NO_GROUP || keycode >= @intCast(u32, xkb.MAX_KEYCODE) { return 0 }
    const key = @intCast(usize, keycode)
    const entry = entryFor(state, key, @intCast(usize, group))
    if entry == xkb.MAX_ENTRIES { return 0 }
    const t = @intCast(usize, state.*.keymap.*.keyTypes[key * xkb.MAX_GROUPS + @intCast(usize, group)])
    return @intCast(u32, state.*.keymap.*.entryLevel[t * xkb.MAX_ENTRIES + entry])
}

// The modifiers the key's type uses up now (those it does not preserve):
// they do not also apply to what the key types (Caps Lock, Control).
pub fn consumedMods(state: *State, keycode: u32) -> u32 {
    const group = keyGroup(state, keycode)
    if group == NO_GROUP { return 0 }
    const key = @intCast(usize, keycode)
    const keymap = state.*.keymap
    const type_index = keymap.*.keyTypes[key * xkb.MAX_GROUPS + @intCast(usize, group)]
    if type_index == xkb.NO_TYPE { return 0 }
    const t = @intCast(usize, type_index)
    const entry = entryFor(state, key, @intCast(usize, group))
    const preserve = if entry == xkb.MAX_ENTRIES { 0 } else { keymap.*.entryPreserveReal[t * xkb.MAX_ENTRIES + entry] }
    return keymap.*.typeModsReal[t] & ~preserve
}

// The keysyms the key types now: how many, the first at `first` in the
// keymap's syms.
pub fn keySyms(state: *State, keycode: u32, first: *usize) -> usize {
    const group = keyGroup(state, keycode)
    if group == NO_GROUP { return 0 }
    const level = keyLevel(state, keycode, group)
    if level >= @intCast(u32, xkb.MAX_LEVELS) { return 0 }
    const slot = @intCast(usize, keycode) * xkb.SLOTS + @intCast(usize, group) * xkb.MAX_LEVELS + @intCast(usize, level)
    first.* = @intCast(usize, state.*.keymap.*.slotFirst[slot])
    return @intCast(usize, state.*.keymap.*.slotCount[slot])
}

// The keysym the key types now when it types one (NoSymbol otherwise),
// upper-cased under Caps Lock the key's type does not use.
pub fn keyOneSym(state: *State, keycode: u32) -> u32 {
    var first: usize = 0
    if keySyms(state, keycode, &first) != 1 { return 0 }
    const sym = state.*.keymap.*.syms[first]
    if capsApplies(state, keycode) { return keysym.toUpper(state.*.keymap.*.names, sym) }
    return sym
}

fn capsApplies(state: *State, keycode: u32) -> bool {
    return state.*.mods & xkb.LOCK != 0 && consumedMods(state, keycode) & xkb.LOCK == 0
}

fn controlApplies(state: *State, keycode: u32) -> bool {
    return state.*.mods & xkb.CONTROL != 0 && consumedMods(state, keycode) & xkb.CONTROL == 0
}

// The text the key types now, UTF-8 into `out` (`capacity` bytes); its
// length (0: none, or it would not fit), as xkb_state_key_get_utf8: Caps
// Lock upper-cases, Control makes a control character of a single ASCII
// character, when the key's type does not use them.
pub fn keyUtf8(state: *State, keycode: u32, out: [*]u8, capacity: usize) -> usize {
    const names = state.*.keymap.*.names
    var first: usize = 0
    const count = keySyms(state, keycode, &first)
    if count == 0 { return 0 }
    var length: usize = 0
    var bytes: [4]u8 = undefined
    var bytes_out: [*]u8 = undefined
    unsafe { bytes_out = @ptrCast([*]u8, &bytes) }
    var index: usize = 0
    while index < count {
        var sym = state.*.keymap.*.syms[first + index]
        if count == 1 && sym > 127 && controlApplies(state, keycode) { sym = latinForControl(state, keycode, sym) }
        if count == 1 && capsApplies(state, keycode) { sym = keysym.toUpper(names, sym) }
        const written = keysym.toUtf8(names, sym, bytes_out)
        if written == 0 { return 0 }
        if length + written >= capacity { return 0 }
        var byte: usize = 0
        while byte < written {
            out[length + byte] = bytes[byte]
            byte += 1
        }
        length += written
        index += 1
    }
    if length == 1 && out[0] < 128 && controlApplies(state, keycode) { out[0] = toControl(out[0]) }
    return length
}

// With Control, a key that types no ASCII character (a Cyrillic letter)
// types what it would in the first group where it does (Ctrl+C stays a
// copy in every layout), as libxkbcommon.
fn latinForControl(state: *State, keycode: u32, sym: u32) -> u32 {
    const keymap = state.*.keymap
    const key = @intCast(usize, keycode)
    var group: usize = 0
    while group < @intCast(usize, keymap.*.keyGroups[key]) {
        const level = keyLevel(state, keycode, @intCast(u32, group))
        const slot = key * xkb.SLOTS + group * xkb.MAX_LEVELS + @intCast(usize, level)
        if level < @intCast(u32, xkb.MAX_LEVELS) && keymap.*.slotCount[slot] == 1 {
            const candidate = keymap.*.syms[@intCast(usize, keymap.*.slotFirst[slot])]
            if candidate <= 127 { return candidate }
        }
        group += 1
    }
    return sym
}

// XkbToControl: what Control makes of an ASCII character.
fn toControl(byte: u8) -> u8 {
    if byte >= 64 && byte < 127 || byte == 32 { return byte & 31 }
    if byte == 50 { return 0 }
    if byte >= 51 && byte <= 55 { return byte - 24 }
    if byte == 56 { return 127 }
    if byte == 47 { return 31 }
    return byte
}

// The real modifiers of the modifier `name` ("Shift", "Control", a virtual
// one such as "LevelThree" or "Alt"); 0 when the keymap has none.
pub fn modMask(keymap: *xkb.Keymap, name: []const u8) -> u32 {
    return xkb.realMods(keymap, xkb.modifierByName(keymap, name))
}

pub fn keyRepeats(keymap: *xkb.Keymap, keycode: u32) -> bool {
    if keycode >= @intCast(u32, xkb.MAX_KEYCODE) { return false }
    return keymap.*.keyRepeats[@intCast(usize, keycode)]
}

// ---------------------------------------------------------------------------
// Following the keys, as libxkbcommon's xkb_state_update_key: a key's
// action (SetMods, LatchMods, LockMods and the group ones) takes effect
// while it is down, latches until the next key, or locks.

// Actions in progress at once (one per key held, and latches).
pub const MAX_FILTERS: usize = 64

const LATCH_NONE: i32 = 0
const LATCH_KEY_DOWN: i32 = 1
const LATCH_PENDING: i32 = 2

// The action key `keycode` has now: its kind (ACTION_NONE without one),
// flags, real modifiers and group.
fn actionOf(state: *State, keycode: u32, kind: *u8, flags: *u8, mods: *u32, group: *i32) -> void {
    kind.* = xkb.ACTION_NONE
    flags.* = 0
    mods.* = 0
    group.* = 0
    const key_group = keyGroup(state, keycode)
    if key_group == NO_GROUP { return }
    const level = keyLevel(state, keycode, key_group)
    if level >= @intCast(u32, xkb.MAX_LEVELS) { return }
    const keymap = state.*.keymap
    const slot = xkb.slotOf(@intCast(usize, keycode), @intCast(usize, key_group), @intCast(usize, level))
    kind.* = keymap.*.actionKind[slot]
    flags.* = keymap.*.actionFlags[slot]
    group.* = keymap.*.actionGroup[slot]
    if flags.* & xkb.FLAG_MODMAP_MODS != 0 {
        mods.* = @intCast(u32, keymap.*.keyModmap[@intCast(usize, keycode)])
    } else {
        mods.* = xkb.realMods(keymap, keymap.*.actionMods[slot])
    }
}

// Actions that end a latch when their key is pressed (keys without one).
fn breaksLatch(kind: u8) -> bool { return kind == xkb.ACTION_NONE || kind == xkb.ACTION_OTHER_BREAKING }

fn freeFilter(state: *State, at: usize) -> void { state.*.filterKind[at] = xkb.ACTION_NONE }

// The group a group action makes of `group`.
fn groupAfter(flags: u8, action_group: i32, group: i32) -> i32 {
    return if flags & xkb.FLAG_GROUP_ABSOLUTE != 0 { action_group } else { group + action_group }
}

// What a filter does when its action starts.
fn startFilter(state: *State, at: usize) -> void {
    const mods = state.*.filterMods[at]
    const flags = state.*.filterFlags[at]
    const kind = state.*.filterKind[at]
    if kind == xkb.ACTION_SET_MODS { state.*.setMods = mods }
    if kind == xkb.ACTION_LATCH_MODS {
        state.*.filterPriv[at] = LATCH_KEY_DOWN
        state.*.setMods = mods
    }
    if kind == xkb.ACTION_LOCK_MODS {
        state.*.filterPriv[at] = @bitCast(i32, state.*.lockedMods & mods)
        state.*.setMods |= mods
        if flags & xkb.FLAG_LOCK_NO_LOCK == 0 { state.*.lockedMods |= mods }
    }
    if kind == xkb.ACTION_SET_GROUP {
        state.*.filterPriv[at] = state.*.baseGroup
        state.*.baseGroup = groupAfter(flags, state.*.filterGroup[at], state.*.baseGroup)
    }
    if kind == xkb.ACTION_LATCH_GROUP {
        state.*.filterPriv[at] = LATCH_KEY_DOWN
        state.*.baseGroup = groupAfter(flags, state.*.filterGroup[at], state.*.baseGroup)
    }
    if kind == xkb.ACTION_LOCK_GROUP { state.*.lockedGroup = groupAfter(flags, state.*.filterGroup[at], state.*.lockedGroup) }
}

// A press or release of `keycode` meeting a filter; true when the filter
// takes it (the key's own action does not start).
fn runFilter(state: *State, at: usize, keycode: u32, down: bool) -> bool {
    const kind = state.*.filterKind[at]
    const own = keycode == state.*.filterKey[at]
    const mods = state.*.filterMods[at]
    if kind == xkb.ACTION_LATCH_MODS || kind == xkb.ACTION_LATCH_GROUP { return runLatch(state, at, keycode, down) }
    if !own {
        // Another key pressed while this one is held: it no longer clears
        // locks when let go.
        if kind == xkb.ACTION_SET_MODS || kind == xkb.ACTION_SET_GROUP { state.*.filterFlags[at] &= ~xkb.FLAG_CLEAR_LOCKS }
        return false
    }
    if down {
        state.*.filterRefs[at] += 1
        return true
    }
    state.*.filterRefs[at] -= 1
    if state.*.filterRefs[at] > 0 { return true }
    const flags = state.*.filterFlags[at]
    if kind == xkb.ACTION_SET_MODS {
        state.*.clearMods = mods
        if flags & xkb.FLAG_CLEAR_LOCKS != 0 { state.*.lockedMods &= ~mods }
    }
    if kind == xkb.ACTION_LOCK_MODS {
        state.*.clearMods |= mods
        if flags & xkb.FLAG_LOCK_NO_UNLOCK == 0 { state.*.lockedMods &= ~@bitCast(u32, state.*.filterPriv[at]) }
    }
    if kind == xkb.ACTION_SET_GROUP {
        state.*.baseGroup = state.*.filterPriv[at]
        if flags & xkb.FLAG_CLEAR_LOCKS != 0 { state.*.lockedGroup = 0 }
    }
    freeFilter(state, at)
    return false
}

// LatchMods and LatchGroup: set while the key is down; latched after it
// for the next key, unless another key came while it was down; the same
// latch again locks it (latchToLock) or sets it.
fn runLatch(state: *State, at: usize, keycode: u32, down: bool) -> bool {
    const is_mods = state.*.filterKind[at] == xkb.ACTION_LATCH_MODS
    const mods = state.*.filterMods[at]
    const flags = state.*.filterFlags[at]
    const delta = state.*.filterGroup[at]
    var latch = state.*.filterPriv[at]
    if down && latch == LATCH_PENDING {
        var kind: u8 = 0
        var key_flags: u8 = 0
        var key_mods: u32 = 0
        var key_group: i32 = 0
        actionOf(state, keycode, &kind, &key_flags, &key_mods, &key_group)
        const same = kind == state.*.filterKind[at] && key_flags == flags && (if is_mods { key_mods == mods } else { key_group == delta })
        if same {
            state.*.filterKey[at] = keycode
            if is_mods {
                if flags & xkb.FLAG_LATCH_TO_LOCK != 0 {
                    state.*.filterKind[at] = xkb.ACTION_LOCK_MODS
                    state.*.lockedMods |= mods
                } else {
                    state.*.filterKind[at] = xkb.ACTION_SET_MODS
                    state.*.setMods = mods
                }
                state.*.latchedMods &= ~mods
            } else {
                if flags & xkb.FLAG_LATCH_TO_LOCK != 0 && delta != 0 {
                    state.*.filterKind[at] = xkb.ACTION_LOCK_GROUP
                } else {
                    state.*.filterKind[at] = xkb.ACTION_SET_GROUP
                }
                startFilter(state, at)
                state.*.latchedGroup -= delta
            }
            return true
        }
        if breaksLatch(kind) {
            if is_mods { state.*.latchedMods &= ~mods } else { state.*.latchedGroup -= delta }
            freeFilter(state, at)
            return false
        }
    } else if !down && keycode == state.*.filterKey[at] {
        const clears = flags & xkb.FLAG_CLEAR_LOCKS != 0 && (if is_mods { state.*.lockedMods & mods == mods } else { state.*.lockedGroup != 0 })
        if latch == LATCH_NONE || clears {
            if is_mods {
                if latch == LATCH_PENDING { state.*.latchedMods &= ~mods } else { state.*.clearMods = mods }
                state.*.lockedMods &= ~mods
            } else {
                if latch == LATCH_PENDING { state.*.latchedGroup -= delta } else { state.*.baseGroup -= delta }
                if flags & xkb.FLAG_CLEAR_LOCKS != 0 { state.*.lockedGroup = 0 }
            }
            freeFilter(state, at)
        } else {
            latch = LATCH_PENDING
            if is_mods {
                state.*.clearMods = mods
                state.*.latchedMods |= mods
            } else {
                state.*.baseGroup -= delta
                state.*.latchedGroup += delta
            }
        }
    } else if down && latch == LATCH_KEY_DOWN {
        latch = LATCH_NONE
    }
    if state.*.filterKind[at] == xkb.ACTION_LATCH_MODS || state.*.filterKind[at] == xkb.ACTION_LATCH_GROUP { state.*.filterPriv[at] = latch }
    return false
}

// A key pressed (`down`) or let go: its action and those in progress
// change the modifiers and group. True when they changed.
pub fn updateKey(state: *State, keycode: u32, down: bool) -> bool {
    if keycode < state.*.keymap.*.minKeycode || keycode > state.*.keymap.*.maxKeycode || keycode >= @intCast(u32, xkb.MAX_KEYCODE) { return false }
    const before_base = state.*.baseMods
    const before_latched = state.*.latchedMods
    const before_locked = state.*.lockedMods
    const before_group = state.*.group
    const before_base_group = state.*.baseGroup
    const before_latched_group = state.*.latchedGroup
    const before_locked_group = state.*.lockedGroup
    state.*.setMods = 0
    state.*.clearMods = 0
    var consumed = false
    var at: usize = 0
    while at < state.*.filterCount {
        if state.*.filterKind[at] != xkb.ACTION_NONE {
            if runFilter(state, at, keycode, down) { consumed = true }
        }
        at += 1
    }
    if !consumed && down {
        var kind: u8 = 0
        var flags: u8 = 0
        var mods: u32 = 0
        var group: i32 = 0
        actionOf(state, keycode, &kind, &flags, &mods, &group)
        if kind != xkb.ACTION_NONE && kind < xkb.ACTION_OTHER {
            at = 0
            while at < state.*.filterCount && state.*.filterKind[at] != xkb.ACTION_NONE { at += 1 }
            if at < MAX_FILTERS {
                if at == state.*.filterCount { state.*.filterCount += 1 }
                state.*.filterKey[at] = keycode
                state.*.filterKind[at] = kind
                state.*.filterFlags[at] = flags
                state.*.filterMods[at] = mods
                state.*.filterGroup[at] = group
                state.*.filterPriv[at] = 0
                state.*.filterRefs[at] = 1
                startFilter(state, at)
            }
        }
    }
    var bit: usize = 0
    while bit < 8 {
        const mask = @intCast(u32, 1) << @intCast(u5, bit)
        if state.*.setMods & mask != 0 {
            state.*.modKeyCount[bit] += 1
            state.*.baseMods |= mask
        }
        bit += 1
    }
    bit = 0
    while bit < 8 {
        const mask = @intCast(u32, 1) << @intCast(u5, bit)
        if state.*.clearMods & mask != 0 {
            state.*.modKeyCount[bit] -= 1
            if state.*.modKeyCount[bit] <= 0 {
                state.*.baseMods &= ~mask
                state.*.modKeyCount[bit] = 0
            }
        }
        bit += 1
    }
    derive(state)
    return state.*.baseMods != before_base || state.*.latchedMods != before_latched || state.*.lockedMods != before_locked || state.*.group != before_group || state.*.baseGroup != before_base_group || state.*.latchedGroup != before_latched_group || state.*.lockedGroup != before_locked_group
}

// What a compositor sends in wl_keyboard.modifiers: the real modifiers
// held, latched and locked, and the group in effect.
pub fn depressedMods(state: *State) -> u32 { return state.*.baseMods }
pub fn latchedMods(state: *State) -> u32 { return state.*.latchedMods }
pub fn lockedMods(state: *State) -> u32 { return state.*.lockedMods }
pub fn effectiveGroup(state: *State) -> u32 { return state.*.group }
