// std.audio: MLX Audio's protocol and its client. MLX Audio (mlx-audiod,
// projects/desktop/audio) is the desktop's sound server, and it runs on
// MLXIPC: a program finds it on the session bus as org.mlx.Audio, gets a
// direct channel to it (org.mlx.IPC.Connect: the bus checks that the app
// may talk to it), and from then on speaks this protocol over the
// channel. The server asks the bus whether the app may play
// (audio.play), record (audio.record) or record what plays (a sink's
// monitor: audio.monitor) before it opens a stream: the permissions are
// MLXIPC's, per app (~/.config/mlx/ipc.conf).
//
//     var audio: audio_module.Audio = undefined
//     if audio_module.connect(&audio, allocator, environment) != audio_module.OK { ... }
//     const stream = audio_module.openStream(&audio, audio_module.PLAY, audio_module.S16, 2, 44100, 100, "music")
//     if audio_module.refusal(&audio, stream) == 0 {
//         audio_module.write(&audio, stream, samples, length)    blocks as the server asks
//         audio_module.drain(&audio, stream)                     until it was heard
//     }
//
// The protocol: messages of an 8-byte header (u32 kind, u32 payload
// length, little-endian) and their payload. The server says how many
// bytes of a playing stream it wants (REQUEST) and the client sends no
// more (DATA): the server's buffer is the stream's latency, never more.
// Recording streams get RECORDED messages as the input comes.
const allocator_module = @import("../bootstrap/allocator.mlx")
const linux = @import("../bootstrap/os/linux.mlx")
const dbus = @import("./dbus.mlx")

pub const Allocator = allocator_module.Allocator

pub const BUS_NAME: []const u8 = "org.mlx.Audio"
pub const HEADER: usize = 8
// The most a message carries.
pub const MAX_PAYLOAD: usize = 32768

// Client to server.
// OPEN: u32 stream, u32 direction, u32 format, u32 channels, u32 rate,
// u32 latency (milliseconds), then the stream's name and, after a NUL
// byte, where it goes: playing, the sink to play to (none: its app's
// route, the default sink unless set); recording, "input" (the default)
// or a sink's monitor, "monitor" (the default sink's: the desktop's
// sound) or "monitor:NAME".
pub const OPEN: u32 = 1
// DATA: u32 stream, then samples.
pub const DATA: u32 = 2
// CLOSE: u32 stream.
pub const CLOSE: u32 = 3
// VOLUME: u32 stream (0: the output's), u32 volume (65536 is 100%).
pub const VOLUME: u32 = 4
// DRAIN: u32 stream: DRAINED once what it sent was played.
pub const DRAIN: u32 = 5
// LIST: STREAMS comes back.
pub const LIST: u32 = 6
// STATUS: STATE comes back (the server's state, for mlx-settings).
pub const STATUS: u32 = 7
// SET: u32 what (SET_*), u32 value, u32 target, then text. STATUS and
// SET need the MLXIPC permission audio.control (unsandboxed apps have
// it).
pub const SET: u32 = 8

// Server to client.
// OPENED: u32 stream, u32 the device's rate, u32 latency.
pub const OPENED: u32 = 101
// REFUSED: u32 stream, u32 reason, then a message.
pub const REFUSED: u32 = 102
// REQUEST: u32 stream, u32 bytes the server wants now.
pub const REQUEST: u32 = 103
// RECORDED: u32 stream, then samples.
pub const RECORDED: u32 = 104
// DRAINED: u32 stream.
pub const DRAINED: u32 = 105
// STREAMS: lines "id app direction rate channels volume% name".
pub const STREAMS: u32 = 106
// ENDED: u32 stream: the server closed it.
pub const ENDED: u32 = 107
// STATE: lines "key = value": control (0: the app may not see or change
// anything), rate, output, input (what was asked for), output-problem,
// input-problem (busy, missing; holder: who has the card), volume, mute,
// input-volume, input-mute (65536 is 100%), and one per item:
//   device = p|c <tab> pcmC0D0p <tab> label
//   stream = id <tab> app <tab> play|record <tab> volume <tab> rate <tab> name <tab> sink or source
//   sink = name <tab> output|none <tab> volume <tab> 1|0 (muted)
//   app = name <tab> volume <tab> 1|0 (muted) <tab> sink (empty: default)
//   asked = app <tab> play|record|monitor <tab> 1|0     (the bus's last answer)
pub const STATE: u32 = 108

// What SET changes.
pub const SET_VOLUME: u32 = 1
pub const SET_MUTE: u32 = 2
pub const SET_INPUT_VOLUME: u32 = 3
pub const SET_INPUT_MUTE: u32 = 4
// value: the volume; target: the stream's id in STATE.
pub const SET_STREAM_VOLUME: u32 = 5
// text: the device ("auto", "alsa:pcmC1D0p", "null"; "none" for the input).
pub const SET_OUTPUT: u32 = 6
pub const SET_INPUT: u32 = 7
// The permissions changed (ipc.conf): the server asks the bus again for
// every stream, and ends those no longer allowed.
pub const SET_RECHECK: u32 = 8
// value: the volume (or 1 to mute, 0 not); text: the app's name. The app's
// volume and mute apply over its streams' own.
pub const SET_APP_VOLUME: u32 = 9
pub const SET_APP_MUTE: u32 = 10
// text: "app <tab> sink": the sink the app's streams play to from now on
// ("default" or empty: the default sink); its streams move at once.
pub const SET_APP_SINK: u32 = 11
// target: the stream's id in STATE; text: the sink.
pub const SET_STREAM_SINK: u32 = 12
// text: a sink's name (letters, digits, '-', '_', '.'); value: 1 when its
// mix goes on to the output, 0 when only its monitor has it.
pub const SET_SINK_ADD: u32 = 13
pub const SET_SINK_REMOVE: u32 = 14
pub const SET_SINK_VOLUME: u32 = 15
pub const SET_SINK_MUTE: u32 = 16

pub const PLAY: u32 = 0
pub const RECORD: u32 = 1

// Sample formats (little-endian, interleaved).
pub const S16: u32 = 0
pub const S32: u32 = 1
pub const F32: u32 = 2

// Why a stream was refused.
pub const DENIED: u32 = 1
pub const INVALID: u32 = 2
pub const LIMIT: u32 = 3

// What connect says.
pub const OK: u32 = 0
pub const NO_BUS: u32 = 1
pub const NO_SERVER: u32 = 2
pub const NOT_ALLOWED: u32 = 3

pub const MAX_STREAMS: usize = 16
// The recorded samples kept for read (older ones go when it is full).
pub const RECORD_BUFFER: usize = 262144

pub fn sampleBytes(format: u32) -> usize {
    if format == S16 { return 2 }
    return 4
}

pub fn load32(bytes: [*]const u8, at: usize) -> u32 { return dbus.load32(bytes, at, false) }
pub fn store32(bytes: [*]u8, at: usize, value: u32) -> void { dbus.store32(bytes, at, value, false) }

// A message's header and payload into `bytes` (HEADER + payload long).
pub fn header(bytes: [*]u8, kind: u32, length: usize) -> void {
    store32(bytes, 0, kind)
    store32(bytes, 4, @intCast(u32, length))
}

// ---------------------------------------------------------------------------
// The client

pub const Stream = struct {
    used: bool
    id: u32
    direction: u32
    frameBytes: usize
    opened: bool
    refused: bool
    reason: u32
    drained: bool
    ended: bool
    // Bytes the server asked for and has not had yet.
    allowed: usize
    deviceRate: u32
}

pub const Audio = struct {
    channel: dbus.Connection
    connected: bool
    nextId: u32
    streams: [16]Stream
    // Recorded samples of the first recording stream, for read.
    recorded: [*]u8
    recordedStart: usize
    recordedLength: usize
    recordStream: u32
    // The last STREAMS (or STATE).
    listing: [*]u8
    listingLength: usize
    listed: bool
    stated: bool
    // Where DATA messages are built (from the allocator: a program that
    // plays for hours keeps no values per write).
    outgoing: [*]u8
    allocator: Allocator
}

fn channelOf(audio: *Audio) -> *dbus.Connection {
    unsafe { return @ptrCast(*dbus.Connection, &audio.*.channel) }
}

fn streamAt(audio: *Audio, index: usize) -> *Stream {
    unsafe { return @ptrCast(*Stream, &audio.*.streams[index]) }
}

// The stream `id`'s record (0 when there is none).
fn find(audio: *Audio, id: u32) -> usize {
    var index: usize = 0
    while index < MAX_STREAMS {
        const stream = streamAt(audio, index)
        if stream.*.used && stream.*.id == id { return @intFromPtr(stream) }
        index += 1
    }
    return 0
}

fn streamOf(address: usize) -> *Stream {
    unsafe { return @ptrFromInt(*Stream, address) }
}

fn errorIs(client: *dbus.Client, reply: *const dbus.Header, name: []const u8) -> bool {
    if reply.*.kind != dbus.ERROR || reply.*.errorName.length != name.length { return false }
    var index: usize = 0
    while index < name.length {
        if reply.*.errorName[index] != name[index] { return false }
        index += 1
    }
    return true
}

// org.mlx.IPC.Connect(org.mlx.Audio): the reply.
fn askChannel(client: *dbus.Client, reply: *dbus.Header) -> bool {
    var body: [64]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &body) }
    var writing: dbus.Writer = undefined
    dbus.begin(&writing, bytes, 64, false)
    dbus.putString(&writing, BUS_NAME)
    const serial = dbus.call(client, "org.freedesktop.DBus", "/org/mlx/IPC", "org.mlx.IPC", "Connect", "s", bytes, writing.length)
    return serial != 0 && dbus.waitReply(client, serial, reply, 10000)
}

// Connects to MLX Audio through the session bus (starting it when a
// service file provides it): OK, NO_BUS, NO_SERVER or NOT_ALLOWED.
pub fn connect(audio: *Audio, allocator: Allocator, environment: [*][*]const u8) -> u32 {
    audio.*.connected = false
    audio.*.nextId = 1
    audio.*.allocator = allocator
    var index: usize = 0
    while index < MAX_STREAMS {
        streamAt(audio, index).*.used = false
        index += 1
    }
    const memory = allocator.alloc(@sizeOf(dbus.Client), 16)
    if memory == null { return NO_BUS }
    var client: *dbus.Client = undefined
    unsafe { client = @ptrCast(*dbus.Client, memory.?) }
    if !dbus.connectSession(client, allocator, environment) { return NO_BUS }
    var reply: dbus.Header = undefined
    var result = OK
    if !askChannel(client, &reply) {
        result = NO_SERVER
    } else if errorIs(client, &reply, "org.freedesktop.DBus.Error.NameHasNoOwner") {
        // Not running: started by its service file, if there is one.
        var body: [64]u8 = undefined
        var bytes: [*]u8 = undefined
        unsafe { bytes = @ptrCast([*]u8, &body) }
        var writing: dbus.Writer = undefined
        dbus.begin(&writing, bytes, 64, false)
        dbus.putString(&writing, BUS_NAME)
        dbus.putU32(&writing, 0)
        const serial = dbus.call(client, "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "StartServiceByName", "su", bytes, writing.length)
        if serial == 0 || !dbus.waitReply(client, serial, &reply, 30000) || reply.kind == dbus.ERROR || !askChannel(client, &reply) { result = NO_SERVER }
    }
    if result == OK && reply.kind == dbus.ERROR { result = if errorIs(client, &reply, "org.freedesktop.DBus.Error.AccessDenied") { NOT_ALLOWED } else { NO_SERVER } }
    var descriptor: isize = -1
    if result == OK {
        descriptor = dbus.descriptorOf(client, 0)
        if descriptor < 0 { result = NO_SERVER }
    }
    // The bus is not needed any more: the channel is.
    dbus.disconnect(client, allocator)
    allocator.free(memory.?, @sizeOf(dbus.Client), 16)
    if result != OK { return result }
    if !dbus.open(channelOf(audio), allocator, descriptor) {
        dbus.closeDescriptor(descriptor)
        return NO_SERVER
    }
    const recorded = allocator.alloc(RECORD_BUFFER, 16)
    const listing = allocator.alloc(MAX_PAYLOAD, 16)
    const outgoing = allocator.alloc(MAX_PAYLOAD + HEADER + 8, 16)
    if recorded == null || listing == null || outgoing == null { return NO_SERVER }
    audio.*.outgoing = outgoing.?
    audio.*.recorded = recorded.?
    audio.*.recordedStart = 0
    audio.*.recordedLength = 0
    audio.*.recordStream = 0
    audio.*.listing = listing.?
    audio.*.listingLength = 0
    audio.*.listed = false
    audio.*.stated = false
    audio.*.connected = true
    return OK
}

pub fn disconnect(audio: *Audio) -> void {
    if !audio.*.connected { return }
    dbus.close(channelOf(audio))
    audio.*.allocator.free(audio.*.recorded, RECORD_BUFFER, 16)
    audio.*.allocator.free(audio.*.listing, MAX_PAYLOAD, 16)
    audio.*.allocator.free(audio.*.outgoing, MAX_PAYLOAD + HEADER + 8, 16)
    audio.*.connected = false
}

// Sends a message (waiting while the channel is full); false when the
// server went.
fn send(audio: *Audio, bytes: [*]const u8, length: usize) -> bool {
    if !audio.*.connected { return false }
    const channel = channelOf(audio)
    var nothing: [1]isize = [1]isize{ 0 }
    var queued = false
    while !queued {
        unsafe { queued = dbus.queue(channel, bytes, length, @ptrCast([*]const isize, &nothing), 0) }
        if !queued && dbus.waitReady(channel.*.descriptor, true, 5000) <= 0 {
            audio.*.connected = false
            return false
        }
    }
    while true {
        const flushed = dbus.flush(channel)
        if flushed == 0 { return true }
        if flushed != dbus.EAGAIN || dbus.waitReady(channel.*.descriptor, true, 5000) <= 0 {
            audio.*.connected = false
            return false
        }
    }
    return false
}

fn keepRecorded(audio: *Audio, bytes: [*]const u8, length: usize) -> void {
    var index: usize = 0
    while index < length {
        if audio.*.recordedLength == RECORD_BUFFER {
            // Full: the oldest byte goes.
            audio.*.recordedStart = (audio.*.recordedStart + 1) % RECORD_BUFFER
            audio.*.recordedLength -= 1
        }
        audio.*.recorded[(audio.*.recordedStart + audio.*.recordedLength) % RECORD_BUFFER] = bytes[index]
        audio.*.recordedLength += 1
        index += 1
    }
}

// One message from the server.
fn handle(audio: *Audio, kind: u32, payload: [*]const u8, length: usize) -> void {
    if kind == STREAMS || kind == STATE {
        var index: usize = 0
        while index < length && index < MAX_PAYLOAD {
            audio.*.listing[index] = payload[index]
            index += 1
        }
        audio.*.listingLength = index
        if kind == STREAMS { audio.*.listed = true } else { audio.*.stated = true }
        return
    }
    if length < 4 { return }
    const address = find(audio, load32(payload, 0))
    if address == 0 { return }
    const stream = streamOf(address)
    if kind == OPENED && length >= 12 {
        stream.*.opened = true
        stream.*.deviceRate = load32(payload, 4)
    } else if kind == REFUSED && length >= 8 {
        stream.*.refused = true
        stream.*.reason = load32(payload, 4)
    } else if kind == REQUEST && length >= 8 {
        stream.*.allowed += @intCast(usize, load32(payload, 4))
    } else if kind == RECORDED {
        if audio.*.recordStream == 0 { audio.*.recordStream = stream.*.id }
        if audio.*.recordStream == stream.*.id {
            var data: [*]const u8 = undefined
            unsafe { data = @ptrFromInt([*]const u8, @intFromPtr(payload) + 4) }
            keepRecorded(audio, data, length - 4)
        }
    } else if kind == DRAINED {
        stream.*.drained = true
    } else if kind == ENDED {
        stream.*.ended = true
    }
}

// Waits up to `timeout` milliseconds for messages and handles what came;
// false when the server went.
pub fn pump(audio: *Audio, timeout: isize) -> bool {
    if !audio.*.connected { return false }
    const channel = channelOf(audio)
    if dbus.waitReady(channel.*.descriptor, false, timeout) > 0 {
        const got = dbus.receive(channel)
        if got == 0 || (got < 0 && got != dbus.EAGAIN) {
            audio.*.connected = false
            return false
        }
    }
    while true {
        const available = dbus.buffered(channel)
        if available < HEADER { return true }
        const bytes = dbus.input(channel)
        const length = @intCast(usize, load32(bytes, 4))
        if length > MAX_PAYLOAD + 64 {
            audio.*.connected = false
            return false
        }
        if available < HEADER + length { return true }
        var payload: [*]const u8 = undefined
        unsafe { payload = @ptrFromInt([*]const u8, @intFromPtr(bytes) + HEADER) }
        handle(audio, load32(bytes, 0), payload, length)
        dbus.consume(channel, HEADER + length, 0)
    }
    return true
}

// Opens a stream: its id once the server answered (refusal says whether
// it was refused), 0 when the server went.
pub fn openStream(audio: *Audio, direction: u32, format: u32, channels: u32, rate: u32, latency: u32, name: []const u8) -> u32 {
    return openStreamOn(audio, direction, format, channels, rate, latency, name, "")
}

// openStream to a sink (playing) or from a source (recording: "input",
// "monitor", "monitor:NAME"); "" is the default. The server may take a
// while to answer when the bus asks the user (a permission prompt).
pub fn openStreamOn(audio: *Audio, direction: u32, format: u32, channels: u32, rate: u32, latency: u32, name: []const u8, target: []const u8) -> u32 {
    var slot: usize = MAX_STREAMS
    var index: usize = 0
    while index < MAX_STREAMS {
        if !streamAt(audio, index).*.used {
            slot = index
            break
        }
        index += 1
    }
    if slot == MAX_STREAMS { return 0 }
    const stream = streamAt(audio, slot)
    stream.*.used = true
    stream.*.id = audio.*.nextId
    audio.*.nextId += 1
    stream.*.direction = direction
    stream.*.frameBytes = sampleBytes(format) * @intCast(usize, channels)
    stream.*.opened = false
    stream.*.refused = false
    stream.*.reason = 0
    stream.*.drained = false
    stream.*.ended = false
    stream.*.allowed = 0
    stream.*.deviceRate = 0
    var message: [400]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &message) }
    var name_length = name.length
    if name_length > 240 { name_length = 240 }
    var target_length = target.length
    if target_length > 100 { target_length = 100 }
    const extra = if target_length > 0 { target_length + 1 } else { 0 }
    header(bytes, OPEN, 24 + name_length + extra)
    store32(bytes, 8, stream.*.id)
    store32(bytes, 12, direction)
    store32(bytes, 16, format)
    store32(bytes, 20, channels)
    store32(bytes, 24, rate)
    store32(bytes, 28, latency)
    index = 0
    while index < name_length {
        message[32 + index] = name[index]
        index += 1
    }
    if target_length > 0 {
        message[32 + name_length] = 0
        index = 0
        while index < target_length {
            message[33 + name_length + index] = target[index]
            index += 1
        }
    }
    if !send(audio, bytes, 32 + name_length + extra) { return 0 }
    while !stream.*.opened && !stream.*.refused {
        if !pump(audio, 10000) { return 0 }
    }
    return stream.*.id
}

// Why the stream was refused (DENIED: the app may not; INVALID; LIMIT),
// 0 when it is open.
pub fn refusal(audio: *Audio, id: u32) -> u32 {
    const address = find(audio, id)
    if address == 0 { return INVALID }
    if streamOf(address).*.refused { return streamOf(address).*.reason }
    return 0
}

// The device's rate the stream plays or records at (0: not open).
pub fn deviceRate(audio: *Audio, id: u32) -> u32 {
    const address = find(audio, id)
    if address == 0 { return 0 }
    return streamOf(address).*.deviceRate
}

// Plays `length` bytes of samples (whole frames), as fast as the server
// asks for them; false when the server went or ended the stream.
pub fn write(audio: *Audio, id: u32, samples: [*]const u8, length: usize) -> bool {
    const address = find(audio, id)
    if address == 0 { return false }
    const stream = streamOf(address)
    const bytes = audio.*.outgoing
    var done: usize = 0
    while done < length {
        if stream.*.ended { return false }
        if stream.*.allowed < stream.*.frameBytes {
            if !pump(audio, 5000) { return false }
            continue
        }
        var part = length - done
        if part > stream.*.allowed { part = stream.*.allowed }
        if part > MAX_PAYLOAD - 4 { part = MAX_PAYLOAD - 4 }
        part = part / stream.*.frameBytes * stream.*.frameBytes
        header(bytes, DATA, 4 + part)
        store32(bytes, 8, id)
        var index: usize = 0
        while index < part {
            bytes[12 + index] = samples[done + index]
            index += 1
        }
        if !send(audio, bytes, 12 + part) { return false }
        stream.*.allowed -= part
        done += part
    }
    return true
}

// Whether the server ended the stream (ENDED: the app's permission was
// taken back).
pub fn ended(audio: *Audio, id: u32) -> bool {
    const address = find(audio, id)
    return address == 0 || streamOf(address).*.ended
}

// Up to `capacity` bytes of recorded samples (whole frames; waits up to
// `timeout` milliseconds for some): how many, 0 when none came.
pub fn read(audio: *Audio, id: u32, buffer: [*]u8, capacity: usize, timeout: isize) -> usize {
    const address = find(audio, id)
    if address == 0 { return 0 }
    const frame = streamOf(address).*.frameBytes
    if audio.*.recordStream == id || audio.*.recordStream == 0 {
        if audio.*.recordedLength < frame {
            if !pump(audio, timeout) { return 0 }
        }
    }
    if audio.*.recordStream != id { return 0 }
    var length = audio.*.recordedLength
    if length > capacity { length = capacity }
    length = length / frame * frame
    var index: usize = 0
    while index < length {
        buffer[index] = audio.*.recorded[(audio.*.recordedStart + index) % RECORD_BUFFER]
        index += 1
    }
    audio.*.recordedStart = (audio.*.recordedStart + length) % RECORD_BUFFER
    audio.*.recordedLength -= length
    return length
}

fn simple(audio: *Audio, kind: u32, id: u32) -> bool {
    var message: [12]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &message) }
    header(bytes, kind, 4)
    store32(bytes, 8, id)
    return send(audio, bytes, 12)
}

// Waits until what the stream sent was played.
pub fn drain(audio: *Audio, id: u32) -> bool {
    const address = find(audio, id)
    if address == 0 { return false }
    const stream = streamOf(address)
    stream.*.drained = false
    if !simple(audio, DRAIN, id) { return false }
    while !stream.*.drained && !stream.*.ended {
        if !pump(audio, 10000) { return false }
    }
    return stream.*.drained
}

pub fn closeStream(audio: *Audio, id: u32) -> void {
    const address = find(audio, id)
    if address == 0 { return }
    const sent = simple(audio, CLOSE, id)
    streamOf(address).*.used = false
    if audio.*.recordStream == id {
        audio.*.recordStream = 0
        audio.*.recordedLength = 0
    }
}

// The volume of stream `id` (0: the output's), 65536 being 100%.
pub fn setVolume(audio: *Audio, id: u32, volume: u32) -> bool {
    var message: [16]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &message) }
    header(bytes, VOLUME, 8)
    store32(bytes, 8, id)
    store32(bytes, 12, volume)
    return send(audio, bytes, 16)
}

// The server's streams, a line each, into `buffer`: the length.
pub fn list(audio: *Audio, buffer: [*]u8, capacity: usize) -> usize {
    audio.*.listed = false
    var message: [8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &message) }
    header(bytes, LIST, 0)
    if !send(audio, bytes, 8) { return 0 }
    while !audio.*.listed {
        if !pump(audio, 5000) { return 0 }
    }
    var length = audio.*.listingLength
    if length > capacity { length = capacity }
    var index: usize = 0
    while index < length {
        buffer[index] = audio.*.listing[index]
        index += 1
    }
    return length
}

// The server's state (STATE's lines) into `buffer`: their length, 0 when
// the server went or did not answer within `timeout` milliseconds (at
// least 0).
pub fn status(audio: *Audio, buffer: [*]u8, capacity: usize, timeout: isize) -> usize {
    audio.*.stated = false
    var message: [8]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &message) }
    header(bytes, STATUS, 0)
    if !send(audio, bytes, 8) { return 0 }
    const deadline = milliseconds() + @intCast(usize, timeout)
    while !audio.*.stated {
        const now = milliseconds()
        if now >= deadline { return 0 }
        if !pump(audio, @intCast(isize, deadline - now)) { return 0 }
    }
    var length = audio.*.listingLength
    if length > capacity { length = capacity }
    var index: usize = 0
    while index < length {
        buffer[index] = audio.*.listing[index]
        index += 1
    }
    return length
}

fn milliseconds() -> usize {
    var time: [2]usize = [2]usize{ 0, 0 }
    const result = linux.syscall2(228, 1, @intFromPtr(&time))
    return time[0] * 1000 + time[1] / 1000000
}

// Changes something of the server's (SET_*).
pub fn set(audio: *Audio, what: u32, value: u32, target: u32, text: []const u8) -> bool {
    var message: [300]u8 = undefined
    var bytes: [*]u8 = undefined
    unsafe { bytes = @ptrCast([*]u8, &message) }
    var length = text.length
    if length > 200 { length = 200 }
    header(bytes, SET, 12 + length)
    store32(bytes, 8, what)
    store32(bytes, 12, value)
    store32(bytes, 16, target)
    var index: usize = 0
    while index < length {
        message[20 + index] = text[index]
        index += 1
    }
    return send(audio, bytes, 20 + length)
}

// Reads what came without waiting (STATE among it); false when the
// server went.
pub fn poll(audio: *Audio) -> bool { return pump(audio, 0) }
