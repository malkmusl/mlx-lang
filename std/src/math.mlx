// Floating-point math in Mlx on the doubles' bits, without libm: the
// constants, whole numbers, sine and cosine, e^x, the logarithms, powers
// and the cube root. The square root is @sqrt and floor, ceil and trunc
// are @floor, @ceil and @trunc, one instruction each.
//
// sin, cos, exp and ln follow fdlibm (argument reduction, then a minimax
// polynomial) and come within an ulp or two of the exact result; their
// coefficients are fdlibm's. Huge arguments to sin and cos (from 2^20
// pi/2 on) are reduced with the bits of 2/pi (Payne and Hanek's way),
// so they keep their digits up to the largest double:
//
//   Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//   Developed at SunPro, a Sun Microsystems, Inc. business.
//   Permission to use, copy, modify, and distribute this software is
//   freely granted, provided that this notice is preserved.

pub const pi: f64 = 3.141592653589793
pub const tau: f64 = 6.283185307179586
pub const e: f64 = 2.718281828459045
pub const ln2: f64 = 0.6931471805599453
pub const ln10: f64 = 2.302585092994046
pub const sqrt2: f64 = 1.4142135623730951

const INFINITY_BITS: u64 = 9218868437227405312
const NEGATIVE_INFINITY_BITS: u64 = 18442240474082181120
const NAN_BITS: u64 = 9221120237041090560
const MANTISSA_BITS: u64 = 4503599627370495
// 2^52: from there on a double has no fraction bits.
const WHOLE: f64 = 4503599627370496.0

pub inline fn infinity() -> f64 { return @bitCast(f64, INFINITY_BITS) }
pub inline fn negativeInfinity() -> f64 { return @bitCast(f64, NEGATIVE_INFINITY_BITS) }
pub inline fn nan() -> f64 { return @bitCast(f64, NAN_BITS) }
pub inline fn isNan(x: f64) -> bool { return x != x }

pub inline fn abs(x: f64) -> f64 { return if x < 0.0 { -x } else { x } }

pub inline fn trunc(x: f64) -> f64 { return @trunc(x) }
pub inline fn floor(x: f64) -> f64 { return @floor(x) }
pub inline fn ceil(x: f64) -> f64 { return @ceil(x) }

// To the nearest whole number, halves away from zero. (x - @trunc(x) is
// exact, so 0.49999999999999994 stays 0.)
pub inline fn round(x: f64) -> f64 {
    return @trunc(x) + (if x - @trunc(x) >= 0.5 { 1.0 } else if @trunc(x) - x >= 0.5 { -1.0 } else { 0.0 })
}

// ---------------------------------------------------------------------------
// Sine and cosine: x = n pi/2 + r with |r| <= pi/4, then the kernel the
// quadrant n asks for. pi/2 comes in three parts of 33, 33 and 53 bits,
// so n times each of the first two is exact for |x| up to about 2^20 pi
// and r keeps its digits next to the zeros. Past 2^52 the reduction has
// nothing left: 0, and NaN for the infinities and NaN.

const PIO2_1: f64 = 1.57079632673412561417
const PIO2_2: f64 = 0.0000000000607710050630396597660
const PIO2_2_TAIL: f64 = 0.00000000000000000000202226624879595063154
const INVERSE_PIO2: f64 = 0.636619772367581382433

const S1: f64 = -0.166666666666666324348
const S2: f64 = 0.00833333333332248946124
const S3: f64 = -0.000198412698298579493134
const S4: f64 = 0.00000275573137070700676789
const S5: f64 = -0.0000000250507602534068634195
const S6: f64 = 0.000000000158969099521155010221

const C1: f64 = 0.0416666666666666019037
const C2: f64 = -0.00138888888888741095749
const C3: f64 = 0.0000248015872894767294178
const C4: f64 = -0.000000275573143513906633035
const C5: f64 = 0.00000000208757232129817482790
const C6: f64 = -0.0000000000113596475577881948265

fn kernelSin(r: f64) -> f64 {
    const z = r * r
    const rest = S2 + z * (S3 + z * (S4 + z * (S5 + z * S6)))
    return r + z * r * (S1 + z * rest)
}

fn kernelCos(r: f64) -> f64 {
    const z = r * r
    const w = z * z
    const poly = z * (C1 + z * (C2 + z * C3)) + w * w * (C4 + z * (C5 + z * C6))
    const half = 0.5 * z
    const near = 1.0 - half
    return near + (((1.0 - near) - half) + z * poly)
}

// The quadrant (0..3) and the remainder of `x` (|x| < 2^52).
fn reduce(x: f64) -> (i64, f64) {
    const n = round(x * INVERSE_PIO2)
    const first = x - n * PIO2_1
    const second = n * PIO2_2
    const r = first - second
    const tail = n * PIO2_2_TAIL - ((first - r) - second)
    return -> (@intFromFloat(i64, n) & 3, r - tail)
}

// From 2^20 pi/2 on the three parts of pi/2 run out of digits.
const LARGE: f64 = 1647099.0

// The bits of 2/pi after the binary point, 32 a word, 1344 of them:
// enough for the largest double's exponent and 190 bits more.
const TWO_OVER_PI: [42]u32 = [42]u32{
    2734261102, 1313084713, 4230436817, 4113882560, 3680671129, 1011060801,
    4266746795, 3736847713, 3072618042, 1112396512, 105459434, 164729372,
    4263373596, 2972297022, 3900847605, 784024708, 3919343654, 3026157121,
    965858873, 2203269620, 2625920907, 3187222587, 536385535, 3724908559,
    4012839307, 1510632735, 1832287951, 667617719, 1330003814, 2657085997,
    1965537991, 3957715323, 1023883767, 2320667370, 1811636145, 529358088,
    1443049542, 4235946923, 4040145952, 2599695901, 2850263393, 1592138504,
}

const PIO2_HIGH: f64 = 1.5707963267948966
const PIO2_LOW: f64 = 0.00000000000000006123233995736766

// Bit `p` of 2/pi (p = 1 is the first after the binary point; p < 1 is
// the integer part, 0).
fn twoOverPiBit(p: i64) -> u64 {
    if p < 1 { return 0 }
    const index = @intCast(usize, (p - 1) / 32)
    const shift = @intCast(u5, 31 - ((p - 1) % 32))
    return @intCast(u64, (TWO_OVER_PI[index] >> shift) & 1)
}

// a + b and what the sum rounded away.
fn twoSum(a: f64, b: f64) -> (f64, f64) {
    const s = a + b
    const bb = s - a
    return -> (s, (a - (s - bb)) + (b - bb))
}

// a b and what the product rounded away (Dekker's halves).
fn twoProduct(a: f64, b: f64) -> (f64, f64) {
    const p = a * b
    const ta = 134217729.0 * a
    const ah = ta - (ta - a)
    const al = a - ah
    const tb = 134217729.0 * b
    const bh = tb - (tb - b)
    const bl = b - bh
    return -> (p, ((ah * bh - p) + ah * bl + al * bh) + al * bl)
}

// a b in 128 bits (high, low), from 32-bit halves.
fn mulWide(a: u64, b: u64) -> (u64, u64) {
    const al = a & 4294967295
    const ah = a >> 32
    const bl = b & 4294967295
    const bh = b >> 32
    const ll = al * bl
    const lh = al * bh
    const hl = ah * bl
    const hh = ah * bh
    const mid = (ll >> 32) + (lh & 4294967295) + (hl & 4294967295)
    const low = (mid << 32) | (ll & 4294967295)
    const high = hh + (lh >> 32) + (hl >> 32) + (mid >> 32)
    return -> (high, low)
}

// The quadrant and the remainder of a huge positive x (Payne and Hanek):
// x = m 2^e; the 192 bits of 2/pi 2^e from the two above the binary
// point (the quadrant's) down, times m, are the product's quadrant and
// 190 bits of its fraction, which times pi/2 is the remainder.
fn reduceLarge(x: f64) -> (i64, f64) {
    const bits = @bitCast(u64, x)
    const m = (bits & MANTISSA_BITS) | 4503599627370496
    const e = @intCast(i64, (bits >> 52) & 2047) - 1075
    var w2: u64 = 0
    var w1: u64 = 0
    var w0: u64 = 0
    var p = e - 1
    var count: i64 = 0
    while count < 192 {
        const bit = twoOverPiBit(p)
        if count < 64 {
            w2 = (w2 << 1) | bit
        } else if count < 128 {
            w1 = (w1 << 1) | bit
        } else {
            w0 = (w0 << 1) | bit
        }
        p += 1
        count += 1
    }
    const p0 = mulWide(m, w0)
    const p1 = mulWide(m, w1)
    const p2 = mulWide(m, w2)
    var l0 = p0.1
    var l1 = p1.1 +% p0.0
    var carry: u64 = if l1 < p1.1 { 1 } else { 0 }
    var l2 = p2.1 +% (p1.0 + carry)
    var quadrant = @intCast(i64, (l2 >> 62) & 3)
    l2 = l2 & 4611686018427387903
    var negative = false
    if l2 & 2305843009213693952 != 0 {
        // The fraction is above a half: the next quadrant, minus the rest.
        negative = true
        quadrant += 1
        const n0 = (~l0) +% 1
        var carry: u64 = if n0 == 0 && l0 != 0 { 1 } else { if l0 == 0 { 1 } else { 0 } }
        const n1 = (~l1) +% carry
        carry = if carry == 1 && n1 == 0 { 1 } else { 0 }
        const n2 = ((~l2) +% carry) & 4611686018427387903
        l0 = n0
        l1 = n1
        l2 = n2
    }
    // Four 32-bit pieces of the fraction, exact as doubles.
    const a = @floatFromInt(f64, (l2 >> 30) & 4294967295) * twoTo(-32)
    const b = @floatFromInt(f64, ((l2 & 1073741823) << 2) | (l1 >> 62)) * twoTo(-64)
    const c = @floatFromInt(f64, (l1 >> 30) & 4294967295) * twoTo(-96)
    const d = @floatFromInt(f64, ((l1 & 1073741823) << 2) | (l0 >> 62)) * twoTo(-128)
    const sum = twoSum(a, b)
    const high = sum.0
    const low = sum.1 + (c + d)
    const product = twoProduct(high, PIO2_HIGH)
    const r = product.0 + (product.1 + (high * PIO2_LOW + low * PIO2_HIGH))
    return -> (quadrant & 3, if negative { -r } else { r })
}

fn sinQuadrant(quadrant: i64, r: f64) -> f64 {
    if quadrant == 0 { return kernelSin(r) }
    if quadrant == 1 { return kernelCos(r) }
    if quadrant == 2 { return -kernelSin(r) }
    return -kernelCos(r)
}

fn cosQuadrant(quadrant: i64, r: f64) -> f64 {
    if quadrant == 0 { return kernelCos(r) }
    if quadrant == 1 { return -kernelSin(r) }
    if quadrant == 2 { return -kernelCos(r) }
    return kernelSin(r)
}

pub fn sin(x: f64) -> f64 {
    if !(abs(x) < LARGE) {
        if !(abs(x) < infinity()) { return x - x }
        const reduced = reduceLarge(abs(x))
        const value = sinQuadrant(reduced.0, reduced.1)
        return if x < 0.0 { -value } else { value }
    }
    if abs(x) <= 0.7853981633974483 { return kernelSin(x) }
    const reduced = reduce(x)
    return sinQuadrant(reduced.0, reduced.1)
}

pub fn cos(x: f64) -> f64 {
    if !(abs(x) < LARGE) {
        if !(abs(x) < infinity()) { return x - x }
        const reduced = reduceLarge(abs(x))
        return cosQuadrant(reduced.0, reduced.1)
    }
    if abs(x) <= 0.7853981633974483 { return kernelCos(x) }
    const reduced = reduce(x)
    return cosQuadrant(reduced.0, reduced.1)
}

// ---------------------------------------------------------------------------
// e^x: x = k ln 2 + r with |r| <= ln 2 / 2 (ln 2 in two parts), e^r from
// a rational approximation, 2^k into the exponent.

const LN2_HIGH: f64 = 0.693147180369123816490
const LN2_LOW: f64 = 0.000000000190821492927058770002
const INVERSE_LN2: f64 = 1.44269504088896338700
const OVERFLOW: f64 = 709.782712893383973096
const UNDERFLOW: f64 = -745.133219101941108420

const P1: f64 = 0.166666666666666019037
const P2: f64 = -0.00277777777770155933842
const P3: f64 = 0.0000661375632143793436117
const P4: f64 = -0.00000165339022054652515390
const P5: f64 = 0.0000000413813679705723846039

// 2^k for -1022 <= k <= 1023.
inline fn twoTo(k: i64) -> f64 { return @bitCast(f64, @intCast(u64, k + 1023) << 52) }

// `value` times 2^k, in steps where 2^k leaves the normal range.
fn scale(value: f64, k: i64) -> f64 {
    var result = value
    var power = k
    while power > 1023 {
        result = result * twoTo(1023)
        power -= 1023
    }
    while power < -1022 {
        result = result * twoTo(-1022)
        power += 1022
    }
    return result * twoTo(power)
}

pub fn exp(x: f64) -> f64 {
    if isNan(x) { return x }
    if x > OVERFLOW { return infinity() }
    if x < UNDERFLOW { return 0.0 }
    const k = round(x * INVERSE_LN2)
    const high = x - k * LN2_HIGH
    const low = k * LN2_LOW
    const r = high - low
    const t = r * r
    const c = r - t * (P1 + t * (P2 + t * (P3 + t * (P4 + t * P5))))
    const y = 1.0 - ((low - (r * c) / (2.0 - c)) - high)
    return scale(y, @intFromFloat(i64, k))
}

// ---------------------------------------------------------------------------
// The logarithms: x = 2^k (1 + f) with sqrt(2)/2 <= 1 + f < sqrt(2),
// then ln(1 + f) = f - f^2/2 + s (f^2/2 + R(s^2)), s = f / (2 + f). log2
// and log10 take k exactly, so whole powers come out exact.

const LG1: f64 = 0.6666666666666735130
const LG2: f64 = 0.3999999999940941908
const LG3: f64 = 0.2857142874366239149
const LG4: f64 = 0.2222219843214978396
const LG5: f64 = 0.1818357216161805012
const LG6: f64 = 0.1531383769920937332
const LG7: f64 = 0.1479819860511658591
const INVERSE_LN10: f64 = 0.434294481903251816668
const LOG10_2_HIGH: f64 = 0.301029995663611771306
const LOG10_2_LOW: f64 = 0.000000000000369423907715893078616

// The logarithm of what is not a positive finite number: NaN below 0 (and
// for NaN), minus infinity at 0, infinity at infinity.
fn logEdge(x: f64) -> f64 {
    if x == 0.0 { return negativeInfinity() }
    if x == infinity() { return x }
    return nan()
}

// k (as a float) and f for a positive finite x.
fn logReduce(x: f64) -> (f64, f64) {
    var value = x
    var k: i64 = 0
    // A subnormal: 2^54 times it is normal.
    if @bitCast(u64, value) < 4503599627370496 {
        value = value * 18014398509481984.0
        k = -54
    }
    const bits = @bitCast(u64, value)
    k += @intCast(i64, bits >> 52) - 1023
    const mantissa = bits & MANTISSA_BITS
    // Above sqrt(2) the mantissa's exponent becomes -1 (and k one more).
    const above: u64 = ((mantissa >> 32) + 614244) & 1048576
    k += @intCast(i64, above >> 20)
    const f = @bitCast(f64, mantissa | ((1072693248 ^ above) << 32)) - 1.0
    const dk: f64 = @floatFromInt(f64, k)
    return -> (dk, f)
}

// f^2/2 and s (f^2/2 + R(s^2)), the two terms ln(1 + f) needs past f.
fn logTerms(f: f64) -> (f64, f64) {
    const s = f / (2.0 + f)
    const z = s * s
    const w = z * z
    const even = w * (LG2 + w * (LG4 + w * LG6))
    const odd = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)))
    const half_square = 0.5 * f * f
    return -> (half_square, s * (half_square + odd + even))
}

pub fn ln(x: f64) -> f64 {
    if !(x > 0.0) || x == infinity() { return logEdge(x) }
    const reduced = logReduce(x)
    const dk = reduced.0
    const f = reduced.1
    const terms = logTerms(f)
    return dk * LN2_HIGH - ((terms.0 - (terms.1 + dk * LN2_LOW)) - f)
}

pub fn log2(x: f64) -> f64 {
    if !(x > 0.0) || x == infinity() { return logEdge(x) }
    const reduced = logReduce(x)
    const f = reduced.1
    const terms = logTerms(f)
    return reduced.0 + (f - (terms.0 - terms.1)) * INVERSE_LN2
}

pub fn log10(x: f64) -> f64 {
    if !(x > 0.0) || x == infinity() { return logEdge(x) }
    const reduced = logReduce(x)
    const dk = reduced.0
    const f = reduced.1
    const terms = logTerms(f)
    return dk * LOG10_2_HIGH + (dk * LOG10_2_LOW + (f - (terms.0 - terms.1)) * INVERSE_LN10)
}

// x^y for x > 0 (and 0^y = 0 for y > 0, x^0 = 1). The error grows with
// |y ln x|: a few ulps for results up to about 2^50.
pub fn pow(x: f64, y: f64) -> f64 {
    if y == 0.0 { return 1.0 }
    if x == 0.0 && y > 0.0 { return 0.0 }
    return exp(y * ln(x))
}

// The cube root (of a negative value too): a first guess from the
// logarithm, then Newton's steps.
pub fn cbrt(x: f64) -> f64 {
    if x == 0.0 || isNan(x) || abs(x) == infinity() { return x }
    const size = abs(x)
    var y = exp(ln(size) / 3.0)
    var step: usize = 0
    while step < 3 {
        y = y - (y * y * y - size) / (3.0 * y * y)
        step += 1
    }
    return if x < 0.0 { -y } else { y }
}
