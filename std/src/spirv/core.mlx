// The signature of the parameters following enumerant `value` of operand
// kind `kind` (for a bit enumeration, one bit at a time).
pub fn enumerantParameters(kind: u8, value: u32) -> []const u8 {
    if kind == 0 {
        return match value {
            1 => "n",
            2 => "n",
            4 => "nn",
            8 => "n",
            16 => "n",
            32 => "n",
            64 => "n",
            128 => "n",
            256 => "m",
            512 => "m",
            65536 => "n",
            else => "",
        }
    }
    if kind == 3 {
        return match value {
            8 => "o",
            16 => "o",
            32 => "o",
            64 => "o",
            128 => "o",
            256 => "o",
            65536 => "o",
            131072 => "o",
            262144 => "o",
            524288 => "o",
            1048576 => "o",
            2097152 => "o",
            4194304 => "o",
            16777216 => "o",
            33554432 => "o",
            268435456 => "o",
            else => "",
        }
    }
    if kind == 6 {
        return match value {
            2 => "o",
            8 => "m",
            16 => "m",
            65536 => "n",
            131072 => "n",
            else => "",
        }
    }
    if kind == 15 {
        return match value {
            0 => "o",
            17 => "ooo",
            18 => "ooo",
            26 => "o",
