// The signature of the parameters following enumerant `value` of operand
// kind `kind` (for a bit enumeration, one bit at a time).
pub fn enumerantParameters(kind: u8, value: u32) -> []const u8 {
    if kind == 0 {
        return match value {
            1 => "m",
            2 => "m",
            4 => "mm",
            8 => "m",
            16 => "m",
            32 => "m",
            64 => "m",
            128 => "m",
            256 => "l",
            512 => "l",
            65536 => "m",
            else => "",
        }
    }
    if kind == 3 {
        return match value {
            8 => "n",
            16 => "n",
            32 => "n",
            64 => "n",
            128 => "n",
            256 => "n",
            65536 => "n",
            131072 => "n",
            262144 => "n",
            524288 => "n",
            1048576 => "n",
            2097152 => "n",
            4194304 => "n",
            16777216 => "n",
            33554432 => "n",
            else => "",
        }
    }
    if kind == 6 {
        return match value {
            2 => "n",
            8 => "l",
            16 => "l",
            65536 => "m",
            131072 => "m",
            else => "",
        }
    }
    if kind == 15 {
        return match value {
            0 => "n",
            17 => "nnn",
            18 => "nnn",
            26 => "n",
            30 => "n",
            35 => "n",
            36 => "n",
            37 => "m",
            38 => "mmm",
            39 => "mmm",
            4459 => "n",
            4460 => "n",
            4461 => "n",
            4462 => "n",
            4463 => "n",
            5070 => "m",
            5071 => "m",
            5072 => "mmm",
            5073 => "m",
            5077 => "mmm",
            5102 => "mm",
            5270 => "n",
            5618 => "n",
            5620 => "n",
            5621 => "n",
            5622 => "n",
            5623 => "n",
            5893 => "nnn",
            5894 => "n",
            5896 => "n",
            5903 => "n",
            6028 => "mm",
            6154 => "n",
            6160 => "n",
            6417 => "n",
            6461 => "n",
            6462 => "m",
            6463 => "d",
            else => "",
        }
    }
    if kind == 32 {
        return match value {
            1 => "n",
            6 => "n",
            7 => "n",
            11 => "Q",
            27 => "l",
            29 => "n",
            30 => "n",
            31 => "n",
            32 => "n",
            33 => "n",
            34 => "n",
            35 => "n",
            36 => "n",
            37 => "n",
            38 => "O",
            39 => "G",
            40 => "1",
            41 => "oL",
            43 => "n",
            44 => "n",
            45 => "n",
            46 => "m",
            47 => "m",
            5019 => "m",
            5020 => "m",
            5091 => "m",
            5098 => "m",
            5100 => "m",
            5256 => "n",
            5599 => "n",
            5607 => "o",
            5625 => "n",
            5628 => "n",
            5634 => "m",
            5635 => "o",
            5636 => "o",
            5822 => "nG",
            5823 => "nH",
            5826 => "o",
            5827 => "n",
            5828 => "n",
            5829 => "n",
            5832 => "n",
            5834 => "oo",
            5835 => "#n",
            5836 => "n",
            5883 => "n",
            5884 => "n",
            5900 => "n",
            5902 => "n",
            5909 => "nn",
            5914 => "m",
            5915 => "m",
            5917 => "n",
            5918 => "n",
            5919 => "n",
            5921 => "n",
            5944 => "n",
            6080 => "nJ",
            6170 => "p",
            6172 => "n",
            6173 => "nnn",
            6177 => "n",
            6178 => "n",
            6179 => "n",
            6180 => "M",
            6181 => "n",
            6182 => "n",
            6188 => "No",
            6190 => "a",
            6191 => "n",
            6442 => "nb",
            6443 => "nc",
            else => "",
        }
    }
    if kind == 47 {
        return match value {
            1 => "m",
            2 => "m",
            else => "",
        }
    }
    return ""
}
