// The signature of a composite kind's parts (PairLiteralIntegerIdRef ...).
pub fn compositeSignature(kind: u8) -> []const u8 {
    return match kind {
        67 => "nm",
        68 => "mn",
        69 => "mm",
        else => "",
    }
}

