// from the SPIR-V core grammar (std/registry/spirv/spirv.core.grammar.json).
//
// GENERATED by std/registry/spirv/materialize.sh -- do not edit.
//
// Opcodes are Op members without the "Op" prefix (Op.typeVoid); value
// enumerations are enums (StorageClass.storageBuffer); bit enumerations are
// masks with constants (FUNCTION_CONTROL_INLINE). operandSignature describes
// the operands of an instruction for generic decoding (see std.spirv.module).

pub const MAGIC_NUMBER: u32 = 119734787
pub const MAJOR_VERSION: u32 = 1
pub const MINOR_VERSION: u32 = 6
pub const REVISION: u32 = 4

// The version word of a module header: 0x00MMmm00.
pub fn version(major: u32, minor: u32) -> u32 { return (major << 16) | (minor << 8) }

