pub const OPERAND_KIND_COUNT: usize = 72

// The signature byte of operand kind `kind`, and back.
pub fn kindCode(kind: u8) -> u8 { return if kind >= 44 { kind + 49 } else { kind + 48 } }
pub fn kindOfCode(code: u8) -> u8 { return if code >= 93 { code - 49 } else { code - 48 } }

