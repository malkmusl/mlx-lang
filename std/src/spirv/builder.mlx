// std.spirv.builder: writes SPIR-V modules.
//
// Instructions go into the sections of the logical module layout (SPIR-V
// 2.4) in any order; `wordCount`/`writeWords` concatenate the sections
// after the five-word header. Ids are allocated with `newId` or by the
// helpers that create a result. The generic `instruction` emits any opcode;
// the helpers cover what a compute or graphics shader commonly needs.
//
//     var b: builder.Builder = undefined
//     builder.init(&b, allocator, spv.version(1, 3))
//     builder.capability(&b, spv.Capability.shader)
//     builder.memoryModel(&b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)
//     const void_type = builder.typeVoid(&b)
//     ...
//     var words = allocate(builder.wordCount(&b) * 4)
//     builder.writeWords(&b, words)       // for vkCreateShaderModule

const allocator_module = @import("../../bootstrap/allocator.mlx")
const vector = @import("../../bootstrap/vector.mlx")
const spv = @import("./core.mlx")

pub const Allocator = allocator_module.Allocator
pub const Vector = vector.Vector

pub const SECTION_CAPABILITY: u8 = 0
pub const SECTION_EXTENSION: u8 = 1
pub const SECTION_EXT_INST_IMPORT: u8 = 2
pub const SECTION_MEMORY_MODEL: u8 = 3
pub const SECTION_ENTRY_POINT: u8 = 4
pub const SECTION_EXECUTION_MODE: u8 = 5
pub const SECTION_DEBUG: u8 = 6
pub const SECTION_ANNOTATION: u8 = 7
pub const SECTION_GLOBAL: u8 = 8
pub const SECTION_FUNCTION: u8 = 9
pub const SECTION_COUNT: usize = 10

// The generator word: tool id 0 (unregistered) in the high half.
pub const GENERATOR: u32 = 0

pub const Builder = struct {
    allocator: Allocator
    sections: [10]Vector
    nextId: u32
    version: u32
}

pub fn init(builder: *Builder, allocator: Allocator, version: u32) -> void {
    builder.*.allocator = allocator
    var index: usize = 0
    while index < SECTION_COUNT {
        builder.*.sections[index] = Vector.init(allocator, 4, 4, 64)
        index += 1
    }
    builder.*.nextId = 1
    builder.*.version = version
}

pub fn deinit(builder: *Builder) -> void {
    var index: usize = 0
    while index < SECTION_COUNT {
        Vector.deinit(builder.*.sections[index])
        index += 1
    }
}

// The next result id; the header's bound is one past the last.
pub fn newId(builder: *Builder) -> u32 {
    const id = builder.*.nextId
    builder.*.nextId += 1
    return id
}

pub fn word(builder: *Builder, section: u8, value: u32) -> void {
    var copy = value
    unsafe { builder.*.sections[section] = Vector.append(builder.*.sections[section], @ptrCast([*]const u8, &copy)) }
}

fn opcodeValue(opcode: spv.Op) -> u32 { return @intCast(u32, @intFromEnum(opcode)) }

// The first word of an instruction of `word_count` words.
pub fn begin(builder: *Builder, section: u8, opcode: spv.Op, word_count: usize) -> void {
    word(builder, section, (@intCast(u32, word_count) << 16) | opcodeValue(opcode))
}

// Number of words a literal string occupies (NUL-terminated, padded).
pub fn stringWords(text: []const u8) -> usize {
    var length: usize = 0
    for byte in text { length += 1 }
    return length / 4 + 1
}

pub fn literalString(builder: *Builder, section: u8, text: []const u8) -> void {
    var current: u32 = 0
    var shift: u32 = 0
    for byte in text {
        current = current | (@intCast(u32, byte) << shift)
        shift += 8
        if shift == 32 {
            word(builder, section, current)
            current = 0
            shift = 0
        }
    }
    // The terminating NUL (and padding) completes the last word.
    word(builder, section, current)
}

// Any instruction: opcode and operand words.
pub fn instruction(builder: *Builder, section: u8, opcode: spv.Op, operands: [*]const u32, count: usize) -> void {
    begin(builder, section, opcode, count + 1)
    var index: usize = 0
    while index < count {
        word(builder, section, operands[index])
        index += 1
    }
}

pub fn op0(builder: *Builder, section: u8, opcode: spv.Op) -> void {
    begin(builder, section, opcode, 1)
}

pub fn op1(builder: *Builder, section: u8, opcode: spv.Op, a: u32) -> void {
    begin(builder, section, opcode, 2)
    word(builder, section, a)
}

pub fn op2(builder: *Builder, section: u8, opcode: spv.Op, a: u32, b: u32) -> void {
    begin(builder, section, opcode, 3)
    word(builder, section, a)
    word(builder, section, b)
}

pub fn op3(builder: *Builder, section: u8, opcode: spv.Op, a: u32, b: u32, c: u32) -> void {
    begin(builder, section, opcode, 4)
    word(builder, section, a)
    word(builder, section, b)
    word(builder, section, c)
}

pub fn op4(builder: *Builder, section: u8, opcode: spv.Op, a: u32, b: u32, c: u32, d: u32) -> void {
    begin(builder, section, opcode, 5)
    word(builder, section, a)
    word(builder, section, b)
    word(builder, section, c)
    word(builder, section, d)
}

pub fn op5(builder: *Builder, section: u8, opcode: spv.Op, a: u32, b: u32, c: u32, d: u32, e: u32) -> void {
    begin(builder, section, opcode, 6)
    word(builder, section, a)
    word(builder, section, b)
    word(builder, section, c)
    word(builder, section, d)
    word(builder, section, e)
}

fn enumValue32(value: u32) -> u32 { return value }

// ---------------------------------------------------------------------------
// Module-level declarations

pub fn capability(builder: *Builder, value: spv.Capability) -> void {
    op1(builder, SECTION_CAPABILITY, spv.Op.capability, @intFromEnum(value))
}

pub fn extension(builder: *Builder, name: []const u8) -> void {
    begin(builder, SECTION_EXTENSION, spv.Op.extension, 1 + stringWords(name))
    literalString(builder, SECTION_EXTENSION, name)
}

pub fn extInstImport(builder: *Builder, name: []const u8) -> u32 {
    const id = newId(builder)
    begin(builder, SECTION_EXT_INST_IMPORT, spv.Op.extInstImport, 2 + stringWords(name))
    word(builder, SECTION_EXT_INST_IMPORT, id)
    literalString(builder, SECTION_EXT_INST_IMPORT, name)
    return id
}

pub fn memoryModel(builder: *Builder, addressing: spv.AddressingModel, model: spv.MemoryModel) -> void {
    op2(builder, SECTION_MEMORY_MODEL, spv.Op.memoryModel, @intFromEnum(addressing), @intFromEnum(model))
}

pub fn entryPoint(builder: *Builder, model: spv.ExecutionModel, function: u32, name: []const u8, interfaces: ?[*]const u32, interface_count: usize) -> void {
    begin(builder, SECTION_ENTRY_POINT, spv.Op.entryPoint, 3 + stringWords(name) + interface_count)
    word(builder, SECTION_ENTRY_POINT, @intFromEnum(model))
    word(builder, SECTION_ENTRY_POINT, function)
    literalString(builder, SECTION_ENTRY_POINT, name)
    var index: usize = 0
    while index < interface_count {
        word(builder, SECTION_ENTRY_POINT, interfaces.?[index])
        index += 1
    }
}

pub fn executionMode(builder: *Builder, function: u32, mode: spv.ExecutionMode, literals: ?[*]const u32, count: usize) -> void {
    begin(builder, SECTION_EXECUTION_MODE, spv.Op.executionMode, 3 + count)
    word(builder, SECTION_EXECUTION_MODE, function)
    word(builder, SECTION_EXECUTION_MODE, @intFromEnum(mode))
    var index: usize = 0
    while index < count {
        word(builder, SECTION_EXECUTION_MODE, literals.?[index])
        index += 1
    }
}

pub fn localSize(builder: *Builder, function: u32, x: u32, y: u32, z: u32) -> void {
    op5(builder, SECTION_EXECUTION_MODE, spv.Op.executionMode, function, @intFromEnum(spv.ExecutionMode.localSize), x, y, z)
}

pub fn name(builder: *Builder, id: u32, text: []const u8) -> void {
    begin(builder, SECTION_DEBUG, spv.Op.name, 2 + stringWords(text))
    word(builder, SECTION_DEBUG, id)
    literalString(builder, SECTION_DEBUG, text)
}

pub fn decorate(builder: *Builder, target: u32, decoration: spv.Decoration) -> void {
    op2(builder, SECTION_ANNOTATION, spv.Op.decorate, target, @intFromEnum(decoration))
}

pub fn decorateValue(builder: *Builder, target: u32, decoration: spv.Decoration, value: u32) -> void {
    op3(builder, SECTION_ANNOTATION, spv.Op.decorate, target, @intFromEnum(decoration), value)
}

pub fn decorateBuiltIn(builder: *Builder, target: u32, built_in: spv.BuiltIn) -> void {
    op3(builder, SECTION_ANNOTATION, spv.Op.decorate, target, @intFromEnum(spv.Decoration.builtIn), @intFromEnum(built_in))
}

pub fn memberDecorateValue(builder: *Builder, structure: u32, member: u32, decoration: spv.Decoration, value: u32) -> void {
    op4(builder, SECTION_ANNOTATION, spv.Op.memberDecorate, structure, member, @intFromEnum(decoration), value)
}

// ---------------------------------------------------------------------------
// Types, constants and global variables

fn result0(builder: *Builder, opcode: spv.Op) -> u32 {
    const id = newId(builder)
    op1(builder, SECTION_GLOBAL, opcode, id)
    return id
}

pub fn typeVoid(builder: *Builder) -> u32 { return result0(builder, spv.Op.typeVoid) }

pub fn typeBool(builder: *Builder) -> u32 { return result0(builder, spv.Op.typeBool) }

pub fn typeInt(builder: *Builder, width: u32, signed: bool) -> u32 {
    const id = newId(builder)
    op3(builder, SECTION_GLOBAL, spv.Op.typeInt, id, width, if signed { 1 } else { 0 })
    return id
}

pub fn typeFloat(builder: *Builder, width: u32) -> u32 {
    const id = newId(builder)
    op2(builder, SECTION_GLOBAL, spv.Op.typeFloat, id, width)
    return id
}

pub fn typeVector(builder: *Builder, component: u32, count: u32) -> u32 {
    const id = newId(builder)
    op3(builder, SECTION_GLOBAL, spv.Op.typeVector, id, component, count)
    return id
}

// `length` is the id of a constant.
pub fn typeArray(builder: *Builder, element: u32, length: u32) -> u32 {
    const id = newId(builder)
    op3(builder, SECTION_GLOBAL, spv.Op.typeArray, id, element, length)
    return id
}

pub fn typeRuntimeArray(builder: *Builder, element: u32) -> u32 {
    const id = newId(builder)
    op2(builder, SECTION_GLOBAL, spv.Op.typeRuntimeArray, id, element)
    return id
}

pub fn typeStruct(builder: *Builder, members: ?[*]const u32, count: usize) -> u32 {
    const id = newId(builder)
    begin(builder, SECTION_GLOBAL, spv.Op.typeStruct, 2 + count)
    word(builder, SECTION_GLOBAL, id)
    var index: usize = 0
    while index < count {
        word(builder, SECTION_GLOBAL, members.?[index])
        index += 1
    }
    return id
}

pub fn typePointer(builder: *Builder, storage: spv.StorageClass, pointee: u32) -> u32 {
    const id = newId(builder)
    op3(builder, SECTION_GLOBAL, spv.Op.typePointer, id, @intFromEnum(storage), pointee)
    return id
}

pub fn typeFunction(builder: *Builder, return_type: u32, parameters: ?[*]const u32, count: usize) -> u32 {
    const id = newId(builder)
    begin(builder, SECTION_GLOBAL, spv.Op.typeFunction, 3 + count)
    word(builder, SECTION_GLOBAL, id)
    word(builder, SECTION_GLOBAL, return_type)
    var index: usize = 0
    while index < count {
        word(builder, SECTION_GLOBAL, parameters.?[index])
        index += 1
    }
    return id
}

// A 32-bit constant (integer, or float bits) of `type`.
pub fn constant(builder: *Builder, type_id: u32, value: u32) -> u32 {
    const id = newId(builder)
    op3(builder, SECTION_GLOBAL, spv.Op.constant, type_id, id, value)
    return id
}

pub fn constant64(builder: *Builder, type_id: u32, value: u64) -> u32 {
    const id = newId(builder)
    op4(builder, SECTION_GLOBAL, spv.Op.constant, type_id, id, @intCast(u32, value & 4294967295), @intCast(u32, value >> 32))
    return id
}

pub fn constantBool(builder: *Builder, type_id: u32, value: bool) -> u32 {
    const id = newId(builder)
    op2(builder, SECTION_GLOBAL, if value { spv.Op.constantTrue } else { spv.Op.constantFalse }, type_id, id)
    return id
}

// A module-scope variable.
pub fn variable(builder: *Builder, pointer_type: u32, storage: spv.StorageClass) -> u32 {
    const id = newId(builder)
    op3(builder, SECTION_GLOBAL, spv.Op.variable, pointer_type, id, @intFromEnum(storage))
    return id
}

// ---------------------------------------------------------------------------
// Functions and their instructions

pub fn function(builder: *Builder, result_type: u32, control: spv.FunctionControlMask, function_type: u32) -> u32 {
    const id = newId(builder)
    op4(builder, SECTION_FUNCTION, spv.Op.function, result_type, id, control, function_type)
    return id
}

pub fn functionEnd(builder: *Builder) -> void { op0(builder, SECTION_FUNCTION, spv.Op.functionEnd) }

pub fn label(builder: *Builder) -> u32 { return labelWith(builder, newId(builder)) }

// A label for an id allocated earlier (a branch target).
pub fn labelWith(builder: *Builder, id: u32) -> u32 {
    op1(builder, SECTION_FUNCTION, spv.Op.label, id)
    return id
}

// A function-scope variable (at the start of the first block).
pub fn localVariable(builder: *Builder, pointer_type: u32) -> u32 {
    const id = newId(builder)
    op3(builder, SECTION_FUNCTION, spv.Op.variable, pointer_type, id, @intFromEnum(spv.StorageClass.function))
    return id
}

pub fn load(builder: *Builder, type_id: u32, pointer: u32) -> u32 {
    const id = newId(builder)
    op3(builder, SECTION_FUNCTION, spv.Op.load, type_id, id, pointer)
    return id
}

pub fn store(builder: *Builder, pointer: u32, value: u32) -> void {
    op2(builder, SECTION_FUNCTION, spv.Op.store, pointer, value)
}

pub fn accessChain(builder: *Builder, type_id: u32, base: u32, indices: ?[*]const u32, count: usize) -> u32 {
    const id = newId(builder)
    begin(builder, SECTION_FUNCTION, spv.Op.accessChain, 4 + count)
    word(builder, SECTION_FUNCTION, type_id)
    word(builder, SECTION_FUNCTION, id)
    word(builder, SECTION_FUNCTION, base)
    var index: usize = 0
    while index < count {
        word(builder, SECTION_FUNCTION, indices.?[index])
        index += 1
    }
    return id
}

pub fn compositeExtract(builder: *Builder, type_id: u32, composite: u32, index: u32) -> u32 {
    const id = newId(builder)
    op4(builder, SECTION_FUNCTION, spv.Op.compositeExtract, type_id, id, composite, index)
    return id
}

// A two-operand instruction with a result (OpIAdd, OpIMul, OpULessThan ...).
pub fn binary(builder: *Builder, opcode: spv.Op, type_id: u32, left: u32, right: u32) -> u32 {
    const id = newId(builder)
    op4(builder, SECTION_FUNCTION, opcode, type_id, id, left, right)
    return id
}

// A one-operand instruction with a result (OpNot, OpSNegate, OpBitcast ...).
pub fn unary(builder: *Builder, opcode: spv.Op, type_id: u32, operand: u32) -> u32 {
    const id = newId(builder)
    op3(builder, SECTION_FUNCTION, opcode, type_id, id, operand)
    return id
}

pub fn branch(builder: *Builder, target: u32) -> void { op1(builder, SECTION_FUNCTION, spv.Op.branch, target) }

pub fn branchConditional(builder: *Builder, condition: u32, true_label: u32, false_label: u32) -> void {
    op3(builder, SECTION_FUNCTION, spv.Op.branchConditional, condition, true_label, false_label)
}

pub fn selectionMerge(builder: *Builder, merge: u32) -> void {
    op2(builder, SECTION_FUNCTION, spv.Op.selectionMerge, merge, spv.SELECTION_CONTROL_NONE)
}

pub fn loopMerge(builder: *Builder, merge: u32, continue_target: u32) -> void {
    op3(builder, SECTION_FUNCTION, spv.Op.loopMerge, merge, continue_target, spv.LOOP_CONTROL_NONE)
}

pub fn returnVoid(builder: *Builder) -> void { op0(builder, SECTION_FUNCTION, spv.Op.return_) }

pub fn returnValue(builder: *Builder, value: u32) -> void { op1(builder, SECTION_FUNCTION, spv.Op.returnValue, value) }

// ---------------------------------------------------------------------------
// Output

pub fn wordCount(builder: *const Builder) -> usize {
    var count: usize = 5
    var index: usize = 0
    while index < SECTION_COUNT {
        count += builder.*.sections[index].length
        index += 1
    }
    return count
}

// Writes the module (header and sections) as native-endian words.
pub fn writeWords(builder: *const Builder, destination: [*]u32) -> void {
    destination[0] = spv.MAGIC_NUMBER
    destination[1] = builder.*.version
    destination[2] = GENERATOR
    destination[3] = builder.*.nextId
    destination[4] = 0
    var position: usize = 5
    var section: usize = 0
    while section < SECTION_COUNT {
        const words = builder.*.sections[section]
        var index: usize = 0
        while index < words.length {
            unsafe { destination[position] = @ptrCast(*u32, words.at(index)).* }
            position += 1
            index += 1
        }
        section += 1
    }
}
