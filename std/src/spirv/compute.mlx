// Compute kernels on std.spirv.builder: the declarations every kernel
// starts with (the invocation id, u32 push constants, storage buffers of
// u32 at bindings 0..) and the small instructions kernels share (push
// constant words, buffer elements, select, one-sided ifs, color channels,
// GLSL.std.450 calls).
//
//     var kernel: compute.Kernel = undefined
//     compute.declare(b, &kernel, 4, 2, false)
//     const main = builder.function(b, kernel.voidType, spv.FUNCTION_CONTROL_NONE, kernel.functionType)
//     ...
//     compute.finish(b, &kernel, main, 8, 8)
const spv = @import("std.spirv.core")
const builder = @import("std.spirv.builder")

// At most 32 push constant words (128 bytes, the least every device offers).
pub const MAX_PUSH_WORDS: u32 = 32
pub const MAX_BUFFERS: u32 = 4

// GLSL.std.450 instructions (with `floats`).
pub const GLSL_SQRT: u32 = 31
pub const GLSL_FMIN: u32 = 37
pub const GLSL_FMAX: u32 = 40
pub const GLSL_FCLAMP: u32 = 43

// The ids declare made.
pub const Kernel = struct {
    voidType: u32
    functionType: u32
    boolean: u32
    uint: u32
    int: u32
    // 32-bit float and the GLSL.std.450 import (0 without `floats`).
    float: u32
    glsl: u32
    uvec3: u32
    // The invocation id (gl_GlobalInvocationID), an input uvec3.
    globalId: u32
    // The uint constant 0.
    zero: u32
    push: u32
    pushPointer: u32
    storagePointer: u32
    // The storage buffer variables, by binding.
    buffers: [4]u32
}

// Declares the module header and the common types, `push_words` u32 push
// constants (at most MAX_PUSH_WORDS) and `buffer_count` storage buffers
// of u32 (at most MAX_BUFFERS, bindings 0.., descriptor set 0); with
// `floats` also the float type and GLSL.std.450.
pub fn declare(b: *builder.Builder, kernel: *Kernel, push_words: u32, buffer_count: u32, floats: bool) -> void {
    builder.capability(b, spv.Capability.shader)
    kernel.*.glsl = 0
    if floats { kernel.*.glsl = builder.extInstImport(b, "GLSL.std.450") }
    builder.memoryModel(b, spv.AddressingModel.logical, spv.MemoryModel.glsl450)
    kernel.*.voidType = builder.typeVoid(b)
    kernel.*.functionType = builder.typeFunction(b, kernel.*.voidType, null, 0)
    kernel.*.boolean = builder.typeBool(b)
    kernel.*.uint = builder.typeInt(b, 32, false)
    kernel.*.int = builder.typeInt(b, 32, true)
    kernel.*.float = 0
    if floats { kernel.*.float = builder.typeFloat(b, 32) }
    kernel.*.uvec3 = builder.typeVector(b, kernel.*.uint, 3)
    const input_pointer = builder.typePointer(b, spv.StorageClass.input, kernel.*.uvec3)
    kernel.*.globalId = builder.variable(b, input_pointer, spv.StorageClass.input)
    builder.decorateBuiltIn(b, kernel.*.globalId, spv.BuiltIn.globalInvocationId)
    kernel.*.zero = builder.constant(b, kernel.*.uint, 0)

    // Push constants: a Block of `push_words` u32 members.
    var members: [32]u32 = undefined
    var member_index: usize = 0
    while member_index < 32 {
        members[member_index] = kernel.*.uint
        member_index += 1
    }
    var push_block: u32 = 0
    unsafe { push_block = builder.typeStruct(b, @ptrCast([*]const u32, &members), @intCast(usize, push_words)) }
    builder.decorate(b, push_block, spv.Decoration.block)
    var member: u32 = 0
    while member < push_words {
        builder.memberDecorateValue(b, push_block, member, spv.Decoration.offset, member * 4)
        member += 1
    }
    const push_block_pointer = builder.typePointer(b, spv.StorageClass.pushConstant, push_block)
    kernel.*.push = builder.variable(b, push_block_pointer, spv.StorageClass.pushConstant)
    kernel.*.pushPointer = builder.typePointer(b, spv.StorageClass.pushConstant, kernel.*.uint)

    // Storage buffers: struct { uint words[]; }.
    const words = builder.typeRuntimeArray(b, kernel.*.uint)
    builder.decorateValue(b, words, spv.Decoration.arrayStride, 4)
    var fields: [1]u32 = [1]u32{ words }
    var buffer_block: u32 = 0
    unsafe { buffer_block = builder.typeStruct(b, @ptrCast([*]const u32, &fields), 1) }
    builder.decorate(b, buffer_block, spv.Decoration.block)
    builder.memberDecorateValue(b, buffer_block, 0, spv.Decoration.offset, 0)
    const buffer_pointer = builder.typePointer(b, spv.StorageClass.storageBuffer, buffer_block)
    kernel.*.storagePointer = builder.typePointer(b, spv.StorageClass.storageBuffer, kernel.*.uint)
    var binding: u32 = 0
    while binding < buffer_count {
        const variable = builder.variable(b, buffer_pointer, spv.StorageClass.storageBuffer)
        builder.decorateValue(b, variable, spv.Decoration.descriptorSet, 0)
        builder.decorateValue(b, variable, spv.Decoration.binding, binding)
        kernel.*.buffers[binding] = variable
        binding += 1
    }
}

// The entry point "main" with a `x` x `y` work group.
pub fn finish(b: *builder.Builder, kernel: *const Kernel, main: u32, x: u32, y: u32) -> void {
    var interfaces: [1]u32 = [1]u32{ kernel.*.globalId }
    unsafe { builder.entryPoint(b, spv.ExecutionModel.glCompute, main, "main", @ptrCast([*]const u32, &interfaces), 1) }
    builder.localSize(b, main, x, y, 1)
    builder.name(b, main, "main")
}

pub fn constant(b: *builder.Builder, kernel: *const Kernel, value: u32) -> u32 {
    return builder.constant(b, kernel.*.uint, value)
}

// Push constant word `index`.
pub fn pushWord(b: *builder.Builder, kernel: *const Kernel, index: u32) -> u32 {
    var chain: [1]u32 = [1]u32{ constant(b, kernel, index) }
    var pointer: u32 = 0
    unsafe { pointer = builder.accessChain(b, kernel.*.pushPointer, kernel.*.push, @ptrCast([*]const u32, &chain), 1) }
    return builder.load(b, kernel.*.uint, pointer)
}

// Pointer to element `index` of the storage buffer variable `buffer`.
pub fn element(b: *builder.Builder, kernel: *const Kernel, buffer: u32, index: u32) -> u32 {
    var chain: [2]u32 = [2]u32{ kernel.*.zero, index }
    var pointer: u32 = 0
    unsafe { pointer = builder.accessChain(b, kernel.*.storagePointer, buffer, @ptrCast([*]const u32, &chain), 2) }
    return pointer
}

// Element `index` of the storage buffer variable `buffer`.
pub fn load(b: *builder.Builder, kernel: *const Kernel, buffer: u32, index: u32) -> u32 {
    return builder.load(b, kernel.*.uint, element(b, kernel, buffer, index))
}

pub fn select(b: *builder.Builder, type_id: u32, condition: u32, yes: u32, no: u32) -> u32 {
    const id = builder.newId(b)
    builder.op5(b, builder.SECTION_FUNCTION, spv.Op.select, type_id, id, condition, yes, no)
    return id
}

// Opens `if (condition)`: returns the merge block to close it with
// closeIf. (OpSelectionMerge must come right before the branch.)
pub fn openIf(b: *builder.Builder, condition: u32) -> u32 {
    const then = builder.newId(b)
    const merge = builder.newId(b)
    builder.selectionMerge(b, merge)
    builder.branchConditional(b, condition, then, merge)
    const then_label = builder.labelWith(b, then)
    return merge
}

pub fn closeIf(b: *builder.Builder, merge: u32) -> void {
    builder.branch(b, merge)
    const merge_label = builder.labelWith(b, merge)
}

// (flags & flag) != 0
pub fn flagSet(b: *builder.Builder, kernel: *const Kernel, flags: u32, flag: u32) -> u32 {
    const masked = builder.binary(b, spv.Op.bitwiseAnd, kernel.*.uint, flags, constant(b, kernel, flag))
    return builder.binary(b, spv.Op.iNotEqual, kernel.*.boolean, masked, kernel.*.zero)
}

// (value >> shift) & 255: a color channel (shift 16 red, 8 green, 0 blue,
// 24 alpha).
pub fn channel(b: *builder.Builder, kernel: *const Kernel, value: u32, shift: u32) -> u32 {
    const shifted = if shift == 0 { value } else { builder.binary(b, spv.Op.shiftRightLogical, kernel.*.uint, value, constant(b, kernel, shift)) }
    return builder.binary(b, spv.Op.bitwiseAnd, kernel.*.uint, shifted, constant(b, kernel, 255))
}

// 0xFF000000 | red << 16 | green << 8 | blue
pub fn pack(b: *builder.Builder, kernel: *const Kernel, red: u32, green: u32, blue: u32) -> u32 {
    const r = builder.binary(b, spv.Op.shiftLeftLogical, kernel.*.uint, red, constant(b, kernel, 16))
    const g = builder.binary(b, spv.Op.shiftLeftLogical, kernel.*.uint, green, constant(b, kernel, 8))
    const rg = builder.binary(b, spv.Op.bitwiseOr, kernel.*.uint, r, g)
    const rgb = builder.binary(b, spv.Op.bitwiseOr, kernel.*.uint, rg, blue)
    return builder.binary(b, spv.Op.bitwiseOr, kernel.*.uint, rgb, constant(b, kernel, 4278190080))
}

// alpha << 24 | red << 16 | green << 8 | blue
pub fn packAlpha(b: *builder.Builder, kernel: *const Kernel, alpha: u32, red: u32, green: u32, blue: u32) -> u32 {
    const a = builder.binary(b, spv.Op.shiftLeftLogical, kernel.*.uint, alpha, constant(b, kernel, 24))
    const r = builder.binary(b, spv.Op.shiftLeftLogical, kernel.*.uint, red, constant(b, kernel, 16))
    const g = builder.binary(b, spv.Op.shiftLeftLogical, kernel.*.uint, green, constant(b, kernel, 8))
    const ar = builder.binary(b, spv.Op.bitwiseOr, kernel.*.uint, a, r)
    return builder.binary(b, spv.Op.bitwiseOr, kernel.*.uint, ar, builder.binary(b, spv.Op.bitwiseOr, kernel.*.uint, g, blue))
}

// A GLSL.std.450 call on floats with `count` (1 to 3) operands.
pub fn glsl(b: *builder.Builder, kernel: *const Kernel, instruction: u32, operands: [*]const u32, count: usize) -> u32 {
    const id = builder.newId(b)
    var words: [7]u32 = undefined
    words[0] = kernel.*.float
    words[1] = id
    words[2] = kernel.*.glsl
    words[3] = instruction
    var at: usize = 0
    while at < count {
        words[4 + at] = operands[at]
        at += 1
    }
    unsafe { builder.instruction(b, builder.SECTION_FUNCTION, spv.Op.extInst, @ptrCast([*]const u32, &words), 4 + count) }
    return id
}
