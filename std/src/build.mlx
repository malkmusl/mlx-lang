// std.build: what a build.mlx is written against, and what `mlx build`
// runs.
//
// A build.mlx says what the project is and what it builds:
//
//     const build = @import("std.build")
//
//     pub fn package() -> build.Package {
//         return build.Package.{ .name = "hello", .version = "0.1.0", .description = "a greeting" }
//     }
//
//     pub fn build(b: *build.Builder) -> void {
//         const all = build.group(b, "all", "everything")
//         build.add(b, all, build.program(b, "hello", "src/main.mlx"))
//         build.byDefault(b, all)
//     }
//
// `mlx build [STEP...]` builds the steps named (the default one without a
// name) and what they need, each one only when it is not current: an Mlx
// step when one of the modules its last build read changed (the compiler
// lists them, --depfile), its options, or the compiler; a command when its
// line or an input changed. Jobs run side by side (-j, the processors by
// default), the longest first. What was built and from what is kept in
// mlx-out/build (cache/, logs/, stamps/); programs go to mlx-out/bin,
// shared objects and plugins to mlx-out/lib.
//
// A step that is not current is first looked for in the result cache
// (std/src/build/store.mlx), shared by all of the user's checkouts: when
// it was built before from the same command, compiler and input contents
// (here, in another worktree, before a branch switch), its file is taken
// from there ("cached" in the progress lines) instead of being made.
// MLX_BUILD_CACHE=DIR puts the cache elsewhere ($XDG_CACHE_HOME/mlx/build
// by default), MLX_BUILD_CACHE=off turns it off, MLX_BUILD_CACHE_SIZE
// limits it (6G by default).
//
//     mlx build [STEP...]   build them (and what they need)
//       -j N, --jobs=N      at most N jobs at once, and only as many as
//                           the memory has room for (each step expected
//                           to take what it took last time, or what
//                           build.mlx declared: std/src/build/memory.mlx)
//       --no-memory-limit   -j jobs whatever the memory
//       --force             build them even when current
//       --dry-run           say what would be built
//       --keep-going        go on after a step failed
//       --retry-failed      run a step again whose failure the result
//                           cache remembers for the same program and
//                           files (by default it fails at once, its log
//                           shown, without a job)
//       --verbose           name the current steps too
//       --list              the steps and groups
//       --clean             forget what was built (all is built again)
//       --cache-stats       what the result cache holds
//       --cache-clear       empty the result cache
//       --verify-epoch N    then make N steps keyed by an epoch again (a
//                           random sample, those not made now first) and
//                           fail when one makes another file than it had:
//                           a forgotten bump of mlx-cc's CODEGEN_EPOCH
const std = @import("std")
const crash = @import("std.crash")
const graph = @import("./build/graph.mlx")
const cache = @import("./build/cache.mlx")
const jobs = @import("./build/jobs.mlx")
const store = @import("./build/store.mlx")
const memory_module = @import("./build/memory.mlx")

pub const Package = graph.Package
pub const Builder = graph.Builder
pub const Step = graph.Step

pub fn group(b: *Builder, name: []const u8, description: []const u8) -> Step { return graph.group(b, name, description) }
pub fn program(b: *Builder, name: []const u8, root: []const u8) -> Step { return graph.program(b, name, root) }
pub fn sharedObject(b: *Builder, name: []const u8, root: []const u8) -> Step { return graph.sharedObject(b, name, root) }
pub fn plugin(b: *Builder, name: []const u8, root: []const u8) -> Step { return graph.plugin(b, name, root) }
pub fn command(b: *Builder, name: []const u8, output: []const u8, line: []const u8) -> Step { return graph.command(b, name, output, line) }
pub fn link(b: *Builder, name: []const u8, target: []const u8) -> Step { return graph.link(b, name, target) }
pub fn copy(b: *Builder, name: []const u8, source: []const u8, output: []const u8) -> Step { return graph.copy(b, name, source, output) }
pub fn output(b: *Builder, step: Step, path: []const u8) -> void { graph.output(b, step, path) }
pub fn describe(b: *Builder, step: Step, description: []const u8) -> void { graph.describe(b, step, description) }
pub fn option(b: *Builder, step: Step, flag: []const u8) -> void { graph.option(b, step, flag) }
pub fn input(b: *Builder, step: Step, path: []const u8) -> void { graph.input(b, step, path) }
pub fn depfile(b: *Builder, step: Step, path: []const u8) -> void { graph.depfile(b, step, path) }
pub fn setLine(b: *Builder, step: Step, line: []const u8) -> void { graph.setLine(b, step, line) }
pub fn inputTree(b: *Builder, step: Step, directory: []const u8, suffix: []const u8) -> void { graph.inputTree(b, step, directory, suffix) }
pub fn dependOn(b: *Builder, step: Step, other: Step) -> void { graph.dependOn(b, step, other) }
pub fn cacheable(b: *Builder, step: Step) -> void { graph.cacheable(b, step) }
pub fn uncached(b: *Builder, step: Step) -> void { graph.uncached(b, step) }
pub fn memory(b: *Builder, step: Step, megabytes: usize) -> void { graph.memory(b, step, megabytes) }
pub fn programEpoch(b: *Builder, step: Step, stamp: []const u8) -> void { graph.programEpoch(b, step, stamp) }
pub fn add(b: *Builder, group_step: Step, step: Step) -> void { graph.addTo(b, group_step, step) }
pub fn byDefault(b: *Builder, step: Step) -> void { graph.byDefault(b, step) }
// The step called NAME, declared before (a mistake is reported when the
// build starts).
pub fn step(b: *Builder, name: []const u8) -> Step {
    const found = graph.find(b, name)
    if found == graph.NONE {
        graph.fail(b, "no step of that name was declared before", name)
        return Step.{ .index = 0 }
    }
    return Step.{ .index = found }
}
// LEFT and RIGHT as one string (kept as long as the build runs).
pub fn concat(b: *Builder, left: []const u8, right: []const u8) -> []const u8 { return graph.joined(b, left, right) }

// What a build.mlx reads and writes while it declares the steps (the
// sources a large project lists, the files it generates in Mlx): a file
// whole, kept as long as the build runs ("" when it cannot be read).
pub fn readText(b: *Builder, path: []const u8) -> []const u8 {
    const length = cache.readWhole(b, path)
    if length == graph.NONE { return "" }
    return graph.keep(b, graph.fileBytes(b)[0..length])
}

// Writes TEXT to PATH (making its directories) unless the file already
// holds it, so what reads it is not made again; false when it failed.
pub fn writeText(b: *Builder, path: []const u8, text: []const u8) -> bool {
    const length = cache.readWhole(b, path)
    if length != graph.NONE && std.text.same(graph.fileBytes(b)[0..length], text) { return true }
    _ = std.fs.makeParents(path, 493)
    return std.fs.writeFile(graph.cPath(b, path), text.pointer, text.length, 420)
}

// The environment variable NAME ("" when it is not set).
pub fn environment(b: *Builder, name: []const u8) -> []const u8 {
    const value = std.process.environmentFrom(b.*.environment, name)
    if value == null { return "" }
    return graph.keep(b, std.string.asSlice(value.?))
}

// A mistake in what is declared, about SUBJECT: reported, and the build
// does not start.
pub fn fail(b: *Builder, message: []const u8, subject: []const u8) -> void { graph.fail(b, message, subject) }

// Whether PATH names a file or a directory.
pub fn exists(b: *Builder, path: []const u8) -> bool {
    const handle = std.fs.open(graph.cPath(b, path), std.fs.READ_ONLY, 0)
    if !std.fs.isValid(handle) { return false }
    _ = std.fs.close(handle)
    return true
}

// The names of the files in DIRECTORY ending in SUFFIX, a name a line in
// order ("" when there are none).
pub fn filesIn(b: *Builder, directory: []const u8, suffix: []const u8) -> []const u8 {
    const handle = std.fs.open(graph.cPath(b, directory), std.fs.READ_ONLY | std.fs.DIRECTORY, 0)
    if !std.fs.isValid(handle) { return "" }
    var buffer: [8192]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &buffer) }
    var reader = std.fs.entries(handle, bytes, 8192)
    var entry: std.fs.Entry = undefined
    var names: [4096][]const u8 = undefined
    var count: usize = 0
    while std.fs.nextEntry(&reader, &entry) && count < 4096 {
        if std.fs.isDotName(entry.name) || entry.kind == std.fs.ENTRY_DIRECTORY { continue }
        const name: []const u8 = unsafe { entry.name.pointer[0..entry.name.length] }
        if name.length < suffix.length || !std.text.same(name[name.length - suffix.length..name.length], suffix) { continue }
        // In order as it comes (insertion: directories are small).
        const kept = graph.keep(b, name)
        var at = count
        while at > 0 && before(kept, names[at - 1]) {
            names[at] = names[at - 1]
            at -= 1
        }
        names[at] = kept
        count += 1
    }
    _ = std.fs.close(handle)
    var listing: [262144]u8 = undefined
    const out: [*]u8 = unsafe { @ptrCast([*]u8, &listing) }
    var length: usize = 0
    var index: usize = 0
    while index < count {
        length = std.text.append(out, length, 262144, names[index])
        length = std.text.append(out, length, 262144, "\n")
        index += 1
    }
    return graph.keep(b, out[0..length])
}

fn before(left: []const u8, right: []const u8) -> bool {
    var at: usize = 0
    while at < left.length && at < right.length {
        if left[at] != right[at] { return left[at] < right[at] }
        at += 1
    }
    return left.length < right.length
}

// The line of TEXT at AT (without its newline), AT moved past it; for
//     var at: usize = 0
//     while at < text.length { const line = Build.nextLine(text, &at) ... }
pub fn nextLine(text: []const u8, at: *usize) -> []const u8 {
    const start = at.*
    var end = start
    while end < text.length && text[end] != 10 { end += 1 }
    at.* = if end < text.length { end + 1 } else { end }
    return text[start..end]
}

fn say(text: []const u8) -> void { jobs.say(text) }

fn sayNumber(value: usize) -> void {
    var digits: [24]u8 = undefined
    const bytes: [*]u8 = unsafe { @ptrCast([*]u8, &digits) }
    const length = std.text.appendUnsigned(bytes, 0, 24, value)
    say(bytes[0..length])
}

fn saySeconds(milliseconds: usize) -> void {
    sayNumber(milliseconds / 1000)
    say(".")
    sayNumber((milliseconds % 1000) / 100)
    say(" s")
}

fn parseCount(text: []const u8) -> usize {
    if text.length == 0 { return 0 }
    const parsed = std.parse.unsigned(std.string.fromSlice(text))
    return if parsed.valid { parsed.value } else { 0 }
}

fn makeDirectory(path: [*]const u8) -> void {
    _ = std.fs.makeDirResult(path, 493)
}

fn makeDirectories() -> void {
    unsafe {
        makeDirectory(@ptrCast([*]const u8, "mlx-out"))
        makeDirectory(@ptrCast([*]const u8, "mlx-out/bin"))
        makeDirectory(@ptrCast([*]const u8, "mlx-out/lib"))
        makeDirectory(@ptrCast([*]const u8, "mlx-out/build"))
        makeDirectory(@ptrCast([*]const u8, "mlx-out/build/cache"))
        makeDirectory(@ptrCast([*]const u8, "mlx-out/build/logs"))
        makeDirectory(@ptrCast([*]const u8, "mlx-out/build/stamps"))
    }
}

fn usage() -> void {
    say("usage: mlx build [STEP...] [-j N] [--force] [--dry-run] [--keep-going] [--retry-failed] [--verbose] [--list] [--clean]\n")
    say("                 [--cache-stats] [--cache-clear] [--verify-epoch N]\n")
    say("  builds the steps named (the default one without a name) and what they need,\n")
    say("  each only when it is not current; --list names the steps\n")
    say("  a step built before from the same command and inputs (in any checkout) is\n")
    say("  taken from the result cache: MLX_BUILD_CACHE=DIR (default $XDG_CACHE_HOME/mlx/build\n")
    say("  or ~/.cache/mlx/build), MLX_BUILD_CACHE=off, MLX_BUILD_CACHE_SIZE=6G\n")
}

// The runner: compiled from build.mlx by `mlx build` and kept current like
// a step, so a change to build.mlx, std.build or the compiler is in the
// next run. Runs it again (with --fresh) after compiling it; returns only
// when that failed.
fn renew(b: *Builder, arguments: [][*]const u8) -> u8 {
    const runner = graph.runnerNode(b)
    if store.restore(b, runner) {
        say("mlx build: build.mlx, std.build or the compiler changed; the runner for them was cached\n")
    } else {
        say("mlx build: build.mlx, std.build or the compiler changed; compiling build.mlx again\n")
        if !jobs.start(b, runner) {
            jobs.showLog(b, runner, 40)
            return 1
        }
        var status: u8 = 0
        var peak: usize = 0
        var pid = jobs.waitAny(&status, &peak)
        while pid != 0 && pid != runner.*.pid { pid = jobs.waitAny(&status, &peak) }
        if !jobs.finish(b, runner, status) {
            jobs.showLog(b, runner, 40)
            say("mlx build: build.mlx did not compile (its log: mlx-out/build/logs/build.mlx.log)\n")
            return 1
        }
        store.save(b, runner)
    }
    var forwarded: [128][*]const u8 = undefined
    unsafe {
        forwarded[0] = @ptrCast([*]const u8, runner.*.output)
        forwarded[1] = @ptrCast([*]const u8, graph.joined(b, "--compiler=", b.*.compiler))
        forwarded[2] = @ptrCast([*]const u8, "--fresh")
    }
    var used: usize = 3
    var index: usize = 1
    while index < arguments.length && used < 127 {
        const argument = std.text.cString(arguments[index])
        if !std.text.startsWith(argument, "--compiler=") && !std.text.same(argument, "--fresh") {
            forwarded[used] = arguments[index]
            used += 1
        }
        index += 1
    }
    unsafe { forwarded[used] = @ptrFromInt([*]const u8, 0) }
    _ = std.linux.syscall3(std.linux.SYS_execve, @intFromPtr(forwarded[0]), @intFromPtr(&forwarded), @intFromPtr(b.*.environment))
    say("mlx build: cannot run mlx-out/build/runner\n")
    return 1
}

fn kindName(kind: u8) -> []const u8 {
    if kind == graph.KIND_GROUP { return "group" }
    if kind == graph.KIND_PROGRAM { return "program" }
    if kind == graph.KIND_SHARED { return "shared object" }
    if kind == graph.KIND_PLUGIN { return "plugin" }
    if kind == graph.KIND_COMMAND { return "command" }
    if kind == graph.KIND_LINK { return "link" }
    return "copy"
}

fn pad(text: []const u8, width: usize) -> void {
    say(text)
    var column = text.length
    while column < width {
        say(" ")
        column += 1
    }
}

fn list(b: *Builder) -> void {
    say(b.*.package.name)
    say(" ")
    say(b.*.package.version)
    if b.*.package.description.length > 0 {
        say(": ")
        say(b.*.package.description)
    }
    say("\n\ngroups (mlx build NAME):\n")
    var index: usize = 0
    while index < b.*.nodeCount {
        const item = graph.node(b, index)
        if item.*.kind == graph.KIND_GROUP {
            say("  ")
            pad(item.*.name, 22)
            say(item.*.description)
            if index == b.*.defaultNode { say(" (the default)") }
            say("\n")
        }
        index += 1
    }
    say("\nsteps:\n")
    index = 0
    while index < b.*.nodeCount {
        const item = graph.node(b, index)
        if item.*.kind != graph.KIND_GROUP {
            say("  ")
            pad(item.*.name, 30)
            pad(kindName(item.*.kind), 14)
            say(if item.*.output.length > 0 { item.*.output } else { item.*.source })
            say("\n")
        }
        index += 1
    }
}

fn markWanted(b: *Builder, index: usize) -> void {
    const item = graph.node(b, index)
    if item.*.wanted { return }
    item.*.wanted = true
    var dependency: usize = 0
    while dependency < item.*.dependencyCount {
        markWanted(b, item.*.dependencies[dependency])
        dependency += 1
    }
}

// What the steps' dependencies say: 0 not all finished, 1 all done, 2 one
// failed (or was skipped). REBUILT tells whether one was built now.
fn dependencies(b: *Builder, item: *graph.Node, rebuilt: *bool) -> u8 {
    var result: u8 = 1
    var index: usize = 0
    while index < item.*.dependencyCount {
        const other = graph.node(b, item.*.dependencies[index])
        if other.*.state == graph.STATE_FAILED || other.*.state == graph.STATE_SKIPPED { return 2 }
        if other.*.state != graph.STATE_DONE { result = 0 }
        if other.*.rebuilt { rebuilt.* = true }
        index += 1
    }
    return result
}

const Counts = struct {
    built: usize
    // Taken from the result cache.
    cached: usize
    current: usize
    failed: usize
    // Failed at once: their failure was remembered.
    remembered: usize
    skipped: usize
    started: usize
    stale: usize
}

fn sayStart(item: *graph.Node, counts: *Counts, cached: bool) -> void {
    counts.*.started += 1
    if counts.*.started > counts.*.stale { counts.*.stale = counts.*.started }
    say("[")
    sayNumber(counts.*.started)
    say("/")
    sayNumber(counts.*.stale)
    say("] ")
    if cached { say("cached ") }
    say(item.*.name)
    say("\n")
}

fn sayFailure(b: *Builder, item: *graph.Node, status: u8) -> void {
    say("FAILED ")
    say(item.*.name)
    if status != 0 {
        say(" (exit ")
        sayNumber(@intCast(usize, status))
        say(")")
    }
    say("; its log: ")
    say(jobs.logPath(b, item))
    say("\n")
    jobs.showLog(b, item, 40)
}

// Runs the wanted steps; 0 when every one is done.
fn schedule(b: *Builder) -> u8 {
    var counts = Counts.{ .built = 0, .cached = 0, .current = 0, .failed = 0, .remembered = 0, .skipped = 0, .started = 0, .stale = 0 }
    const began = std.time.milliseconds()
    var wanted: usize = 0
    // A first look at every wanted step: what is not current now (a step
    // whose dependency gets built is looked at again then).
    var index: usize = 0
    while index < b.*.nodeCount {
        const item = graph.node(b, index)
        if item.*.wanted && item.*.kind != graph.KIND_GROUP {
            wanted += 1
            item.*.checked = true
            crash.contextAt("checking step", item.*.name, 0)
            item.*.stale = b.*.force || !cache.isCurrent(b, item)
            if item.*.stale { counts.stale += 1 }
        }
        index += 1
    }
    var running: usize = 0
    var stopped = false
    while true {
        // Settle what can be settled without a job.
        var progress = true
        while progress {
            progress = false
            index = 0
            while index < b.*.nodeCount {
                const item = graph.node(b, index)
                if item.*.wanted && item.*.state == graph.STATE_WAITING {
                    var rebuilt = false
                    const ready = dependencies(b, item, &rebuilt)
                    if ready == 2 {
                        item.*.state = graph.STATE_SKIPPED
                        if item.*.kind != graph.KIND_GROUP { counts.skipped += 1 }
                        progress = true
                    } else if ready == 1 {
                        if item.*.kind == graph.KIND_GROUP {
                            item.*.state = graph.STATE_DONE
                            item.*.rebuilt = rebuilt
                            progress = true
                        } else {
                            if rebuilt && !item.*.stale {
                                // Its dependency changed: its inputs may have.
                                item.*.stale = b.*.dryRun || !cache.isCurrent(b, item)
                                if item.*.stale { counts.stale += 1 }
                            }
                            if !item.*.stale {
                                item.*.state = graph.STATE_DONE
                                counts.current += 1
                                if b.*.verbose {
                                    say("current ")
                                    say(item.*.name)
                                    say("\n")
                                }
                                progress = true
                            } else if !item.*.looked {
                                // Taken from the result cache when it holds
                                // what the step would make now (no job
                                // needed; not with --force: that builds).
                                item.*.looked = true
                                if !b.*.dryRun && !b.*.force && store.restore(b, item) {
                                    sayStart(item, &counts, true)
                                    item.*.state = graph.STATE_DONE
                                    item.*.rebuilt = true
                                    counts.cached += 1
                                    progress = true
                                } else if !b.*.dryRun && !b.*.force && !b.*.retryFailed {
                                    // Failed before with the same program
                                    // and files: fails again, at once.
                                    const status = store.rememberedFailure(b, item)
                                    if status != 0 {
                                        item.*.state = graph.STATE_FAILED
                                        counts.failed += 1
                                        counts.remembered += 1
                                        say("FAILED ")
                                        say(item.*.name)
                                        say(" (exit ")
                                        sayNumber(@intCast(usize, status))
                                        say(", remembered: it failed so with this program and these files; --retry-failed runs it); its log: ")
                                        say(jobs.logPath(b, item))
                                        say("\n")
                                        jobs.showLog(b, item, 40)
                                        if !b.*.keepGoing { stopped = true }
                                        progress = true
                                    }
                                }
                            }
                        }
                    }
                }
                index += 1
            }
        }
        // Start what is ready, the longest last build first, when its
        // memory fits beside the running jobs' (memory.mlx); a step that
        // does not fit waits for one to end.
        var settled = false
        while running < b.*.jobs && !stopped {
            const room = memory_module.budget(b, running)
            var best = graph.NONE
            var ready = false
            index = 0
            while index < b.*.nodeCount {
                const item = graph.node(b, index)
                if item.*.wanted && item.*.state == graph.STATE_WAITING && item.*.stale {
                    var rebuilt = false
                    if dependencies(b, item, &rebuilt) == 1 {
                        ready = true
                        if memory_module.expected(item) <= room && (best == graph.NONE || item.*.took > graph.node(b, best).*.took) { best = index }
                    }
                }
                index += 1
            }
            if best == graph.NONE {
                if ready {
                    b.*.heldForMemory += 1
                    if b.*.verbose {
                        say("waiting: the ready steps' memory does not fit beside the ")
                        sayNumber(running)
                        say(" running (")
                        sayNumber(room / 1024)
                        say(" MiB left)\n")
                    }
                }
                break
            }
            const item = graph.node(b, best)
            crash.contextAt("starting step", item.*.name, 0)
            sayStart(item, &counts, false)
            if b.*.dryRun {
                item.*.state = graph.STATE_DONE
                item.*.rebuilt = true
                counts.built += 1
            } else if item.*.kind == graph.KIND_LINK || item.*.kind == graph.KIND_COPY {
                if jobs.makeInline(b, item) {
                    item.*.state = graph.STATE_DONE
                    item.*.rebuilt = true
                    counts.built += 1
                } else {
                    item.*.state = graph.STATE_FAILED
                    counts.failed += 1
                    say("FAILED ")
                    say(item.*.name)
                    say("\n")
                    if !b.*.keepGoing { stopped = true }
                }
            } else if jobs.start(b, item) {
                item.*.state = graph.STATE_RUNNING
                running += 1
            } else {
                item.*.state = graph.STATE_FAILED
                counts.failed += 1
                sayFailure(b, item, 0)
                if !b.*.keepGoing { stopped = true }
            }
            // A settled step may have readied others: settle again first
            // (without waiting for a running job).
            if item.*.state != graph.STATE_RUNNING {
                settled = true
                break
            }
        }
        if settled && !stopped { continue }
        if running == 0 {
            // Nothing runs: done, unless settling or starting can go on.
            var more = false
            if !stopped {
                index = 0
                while index < b.*.nodeCount {
                    const item = graph.node(b, index)
                    if item.*.wanted && item.*.state == graph.STATE_WAITING {
                        var rebuilt = false
                        if dependencies(b, item, &rebuilt) != 0 { more = true }
                    }
                    index += 1
                }
            }
            if !more { break }
            continue
        }
        var status: u8 = 0
        var peak: usize = 0
        const pid = jobs.waitAny(&status, &peak)
        if pid == 0 { break }
        index = 0
        while index < b.*.nodeCount {
            const item = graph.node(b, index)
            if item.*.state == graph.STATE_RUNNING && item.*.pid == pid {
                running -= 1
                if peak > 0 { item.*.peak = peak }
                if peak > b.*.peakSeen { b.*.peakSeen = peak }
                crash.contextAt("finishing step", item.*.name, 0)
                if jobs.finish(b, item, status) {
                    item.*.state = graph.STATE_DONE
                    item.*.rebuilt = true
                    item.*.made = true
                    counts.built += 1
                    store.save(b, item)
                } else {
                    item.*.state = graph.STATE_FAILED
                    counts.failed += 1
                    store.saveFailure(b, item, status, std.time.milliseconds() - item.*.started)
                    sayFailure(b, item, status)
                    if !b.*.keepGoing { stopped = true }
                }
                break
            }
            index += 1
        }
    }
    // Steps never reached (after a failure without --keep-going).
    var left: usize = 0
    index = 0
    while index < b.*.nodeCount {
        const item = graph.node(b, index)
        if item.*.wanted && item.*.kind != graph.KIND_GROUP && item.*.state == graph.STATE_WAITING { left += 1 }
        index += 1
    }
    if !b.*.dryRun { store.trim(b) }
    const took = std.time.milliseconds() - began
    say("mlx build: ")
    if counts.failed == 0 && counts.built == 0 && counts.cached == 0 && left == 0 && counts.skipped == 0 {
        if wanted == 1 {
            say("the step is current (")
        } else {
            say("all ")
            sayNumber(wanted)
            say(" steps current (")
        }
        saySeconds(took)
        say(")\n")
        return 0
    }
    sayNumber(counts.built)
    say(if b.*.dryRun { " to build, " } else { " built, " })
    if counts.cached > 0 {
        sayNumber(counts.cached)
        say(" cached, ")
    }
    sayNumber(counts.current)
    say(" current")
    if counts.failed > 0 {
        say(", ")
        sayNumber(counts.failed)
        say(" failed")
        if counts.remembered > 0 {
            say(" (")
            sayNumber(counts.remembered)
            say(" remembered)")
        }
    }
    if counts.skipped + left > 0 {
        say(", ")
        sayNumber(counts.skipped + left)
        say(" not built")
    }
    say(" (")
    saySeconds(took)
    if b.*.heldForMemory > 0 {
        say("; steps waited for memory ")
        sayNumber(b.*.heldForMemory)
        say(" times")
    }
    if b.*.peakSeen > 0 && counts.built > 0 {
        say("; largest job ")
        sayNumber(b.*.peakSeen / 1024)
        say(" MiB")
    }
    say(")\n")
    return if counts.failed == 0 && counts.skipped + left == 0 { 0 } else { 1 }
}

// `mlx build`'s main: build.mlx's PACKAGE and graph (CONFIGURE), the
// command line in ARGUMENTS.
pub fn run(arguments: [][*]const u8, package: Package, configure: fn(*Builder) -> void) -> u8 {
    // The crash report before anything else: a crash of the runner names
    // the function it was in and its callers, says the step it was at
    // (crash.contextAt, here and in schedule), and is kept for MLX
    // Observatory (std.crash).
    _ = crash.install()
    const created = graph.create()
    if created == null {
        say("mlx build: out of memory\n")
        return 1
    }
    const b = created.?
    b.*.package = package
    b.*.environment = std.process.environmentEntries(arguments)
    var fresh = false
    var listing = false
    var cleaning = false
    var cacheStats = false
    var cacheClear = false
    var index: usize = 1
    while index < arguments.length {
        const argument = std.text.cString(arguments[index])
        if std.text.startsWith(argument, "--compiler=") {
            b.*.compiler = argument[11..argument.length]
        } else if std.text.same(argument, "--fresh") {
            fresh = true
        } else if std.text.same(argument, "-j") && index + 1 < arguments.length {
            index += 1
            b.*.jobs = parseCount(std.text.cString(arguments[index]))
            if b.*.jobs == 0 {
                say("mlx build: -j wants a number above 0\n")
                return 2
            }
        } else if std.text.startsWith(argument, "-j") || std.text.startsWith(argument, "--jobs=") {
            b.*.jobs = parseCount(argument[if argument[1] == 106 { 2 } else { 7 }..argument.length])
            if b.*.jobs == 0 {
                say("mlx build: -j wants a number above 0\n")
                return 2
            }
        } else if std.text.same(argument, "--force") {
            b.*.force = true
        } else if std.text.same(argument, "--dry-run") || std.text.same(argument, "-n") {
            b.*.dryRun = true
        } else if std.text.same(argument, "--keep-going") || std.text.same(argument, "-k") {
            b.*.keepGoing = true
        } else if std.text.same(argument, "--no-memory-limit") {
            b.*.memoryAware = false
        } else if std.text.same(argument, "--retry-failed") {
            b.*.retryFailed = true
        } else if std.text.same(argument, "--verbose") || std.text.same(argument, "-v") {
            b.*.verbose = true
        } else if std.text.same(argument, "--list") || std.text.same(argument, "-l") {
            listing = true
        } else if std.text.same(argument, "--clean") {
            cleaning = true
        } else if std.text.same(argument, "--verify-epoch") && index + 1 < arguments.length {
            index += 1
            b.*.verifyCount = parseCount(std.text.cString(arguments[index]))
            if b.*.verifyCount == 0 {
                say("mlx build: --verify-epoch wants a number above 0\n")
                return 2
            }
        } else if std.text.startsWith(argument, "--verify-epoch=") {
            b.*.verifyCount = parseCount(argument[15..argument.length])
            if b.*.verifyCount == 0 {
                say("mlx build: --verify-epoch wants a number above 0\n")
                return 2
            }
        } else if std.text.same(argument, "--cache-stats") {
            cacheStats = true
        } else if std.text.same(argument, "--cache-clear") {
            cacheClear = true
        } else if std.text.same(argument, "--help") || std.text.same(argument, "-h") {
            usage()
            return 0
        } else if argument.length > 0 && argument[0] == 45 {
            say("mlx build: unknown option ")
            say(argument)
            say("\n")
            usage()
            return 2
        } else if b.*.requestedCount < graph.MAX_REQUESTED {
            b.*.requested[b.*.requestedCount] = argument
            b.*.requestedCount += 1
        }
        index += 1
    }
    if b.*.jobs == 0 { b.*.jobs = std.linux.system.availableProcessorCount() }
    store.configure(b)
    if cacheClear {
        if b.*.store.length == 0 {
            say("mlx build: the result cache is off\n")
            return 1
        }
        if !store.clear(b) {
            say("mlx build: cannot remove the result cache at ")
            say(b.*.store)
            say("\n")
            return 1
        }
        say("mlx build: emptied the result cache at ")
        say(b.*.store)
        say("\n")
        if !cacheStats { return 0 }
    }
    if cacheStats {
        store.stats(b)
        return 0
    }
    makeDirectories()
    const runner = graph.runnerNode(b)
    graph.initNode(runner, graph.KIND_PROGRAM, "build.mlx", "mlx-out/build/runner.mlx", "mlx-out/build/runner")
    runner.*.depfile = "mlx-out/build/runner.d"
    if fresh {
        if cache.record(b, runner, 0) { store.save(b, runner) }
    } else if !cache.isCurrent(b, runner) {
        return renew(b, arguments)
    }
    crash.contextAt("configuring", "build.mlx", 0)
    configure(b)
    if b.*.problem.length != 0 {
        say("mlx build: build.mlx: ")
        say(b.*.problem)
        if b.*.problemName.length > 0 {
            say(": ")
            say(b.*.problemName)
        }
        say("\n")
        return 2
    }
    if cleaning {
        unsafe {
            _ = std.fs.removeTree(@ptrCast([*]const u8, "mlx-out/build/cache"))
            _ = std.fs.removeTree(@ptrCast([*]const u8, "mlx-out/build/stamps"))
        }
        makeDirectories()
        say("mlx build: forgot what was built; the next build builds everything\n")
        return 0
    }
    if listing {
        list(b)
        return 0
    }
    if b.*.requestedCount == 0 {
        if b.*.defaultNode != graph.NONE {
            markWanted(b, b.*.defaultNode)
        } else {
            index = 0
            while index < b.*.nodeCount {
                markWanted(b, index)
                index += 1
            }
        }
    } else {
        index = 0
        while index < b.*.requestedCount {
            const found = graph.find(b, b.*.requested[index])
            if found == graph.NONE {
                say("mlx build: no step called ")
                say(b.*.requested[index])
                say(" (mlx build --list names them)\n")
                return 2
            }
            markWanted(b, found)
            index += 1
        }
    }
    const status = schedule(b)
    if status != 0 || b.*.verifyCount == 0 || b.*.dryRun { return status }
    return verifyEpoch(b)
}

// --verify-epoch N: N of the wanted steps keyed by their program's epoch
// (Build.programEpoch: mlx-cc's objects) whose files are there, picked at
// random (those taken from the cache or current, not made by this run,
// first), are made again by the program as it is now, and each new file
// is compared with the one it replaces. A step whose file differs is a
// program whose epoch should have moved and did not (compiler/cc/epoch.mlx):
// the files cached under that epoch are stale. Said loudly; 1 then.
fn verifyEpoch(b: *Builder) -> u8 {
    const allocator = std.heap.allocator()
    const memory = allocator.alloc((b.*.nodeCount + 1) * 24, 16)
    if memory == null {
        say("mlx build: out of memory\n")
        return 1
    }
    const words: [*]usize = unsafe { @ptrCast([*]usize, memory.?) }
    // Candidates: those not made now first, then the others.
    var count: usize = 0
    var older: usize = 0
    var pass: usize = 0
    while pass < 2 {
        var index: usize = 0
        while index < b.*.nodeCount {
            const item = graph.node(b, index)
            if item.*.wanted && item.*.kind == graph.KIND_COMMAND && item.*.epoch.length != 0 && item.*.state == graph.STATE_DONE && item.*.output.length != 0 && cache.present(b, item.*.output) {
                const made = item.*.made
                if (pass == 0) == !made {
                    words[count] = index
                    count += 1
                }
            }
            index += 1
        }
        if pass == 0 { older = count }
        pass += 1
    }
    if count == 0 {
        say("mlx build: --verify-epoch: no step keyed by an epoch is built here\n")
        return 0
    }
    // A random sample: each part shuffled (xorshift from the clock).
    var seed: u64 = @intCast(u64, std.time.monotonicNanoseconds()) | 1
    var part: usize = 0
    while part < 2 {
        const from: usize = if part == 0 { 0 } else { older }
        const to: usize = if part == 0 { older } else { count }
        var at = from
        while at + 1 < to {
            seed = seed ^ (seed << 13)
            seed = seed ^ (seed >> 7)
            seed = seed ^ (seed << 17)
            const pick = at + @intCast(usize, seed % @intCast(u64, to - at))
            const kept = words[at]
            words[at] = words[pick]
            words[pick] = kept
            at += 1
        }
        part += 1
    }
    const total = if b.*.verifyCount < count { b.*.verifyCount } else { count }
    // Each one's file's hash before (words[count + i]); 1 for a differing
    // one after.
    var index: usize = 0
    while index < total {
        const item = graph.node(b, words[index])
        var hash: u64 = 0
        if !cache.hashFile(b, item.*.output, &hash) { hash = 0 }
        words[count + index] = @bitCast(usize, hash)
        words[count * 2 + index] = 0
        index += 1
    }
    say("mlx build: --verify-epoch: making ")
    sayNumber(total)
    say(" of ")
    sayNumber(count)
    say(" files keyed by an epoch again\n")
    var next: usize = 0
    var running: usize = 0
    var finished: usize = 0
    var differing: usize = 0
    var failed: usize = 0
    while finished < total {
        while running < b.*.jobs && next < total {
            const item = graph.node(b, words[next])
            item.*.state = graph.STATE_RUNNING
            if !jobs.start(b, item) {
                item.*.state = graph.STATE_FAILED
                failed += 1
                finished += 1
                sayFailure(b, item, 0)
            } else {
                running += 1
            }
            next += 1
        }
        if running == 0 { continue }
        var status: u8 = 0
        var peak: usize = 0
        const pid = jobs.waitAny(&status, &peak)
        if pid == 0 { break }
        var at: usize = 0
        while at < total {
            const item = graph.node(b, words[at])
            if item.*.state == graph.STATE_RUNNING && item.*.pid == pid {
                running -= 1
                finished += 1
                if !jobs.finish(b, item, status) {
                    item.*.state = graph.STATE_FAILED
                    failed += 1
                    sayFailure(b, item, status)
                } else {
                    item.*.state = graph.STATE_DONE
                    var hash: u64 = 0
                    const same = cache.hashFile(b, item.*.output, &hash) && hash == @bitCast(u64, words[count + at])
                    say("[verify ")
                    sayNumber(finished)
                    say("/")
                    sayNumber(total)
                    say(if same { "] same " } else { "] DIFFERS " })
                    say(item.*.name)
                    say("\n")
                    if !same {
                        differing += 1
                        // (Not kept as current: the next build makes it
                        // again under the new epoch.)
                        cache.forget(b, item)
                    }
                }
                break
            }
            at += 1
        }
    }
    if differing > 0 {
        say("mlx build: --verify-epoch: ")
        sayNumber(differing)
        say(" of ")
        sayNumber(total)
        say(" files made again differ from the ones made under the same epoch.\n")
        say("  The program changed what it makes without moving its epoch: bump it\n")
        say("  (CODEGEN_EPOCH in compiler/cc/epoch.mlx for mlx-cc); every file cached\n")
        say("  under this epoch may be stale.\n")
        return 1
    }
    if failed > 0 {
        say("mlx build: --verify-epoch: ")
        sayNumber(failed)
        say(" of the steps made again failed\n")
        return 1
    }
    say("mlx build: --verify-epoch: the ")
    sayNumber(total)
    say(" files made again are the same, byte for byte\n")
    return 0
}
