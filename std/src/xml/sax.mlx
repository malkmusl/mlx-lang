// std.xml.sax: a streaming XML 1.0 parser with namespaces, the SAX2
// parser of libxml2 2.9.14 (parser.c, parserInternals.c) in Mlx: pushed
// a chunk at a time or given a document's content whole, it calls a
// handler for each thing it reads, in the order and with the arguments
// libxml2's push parser gives its SAX2 callbacks (startElementNs with
// the namespaces it declares and the attributes as (localname, prefix,
// URI, value, end) quintuples, characters, CDATA blocks, comments,
// processing instructions, the DOCTYPE and its internal subset's
// entities), and reports libxml2's errors with libxml2's codes, messages
// and positions: an event stream a C program could not tell from the
// one libxml2 gives it (compiler/libc/xml2 is libxml2's C API made of
// this module, and tools/check_xml2.sh compares the two).
//
// What it reads: the document's encoding (UTF-8, UTF-16 with or without
// a byte order mark, an encoding declaration of ISO-8859-1, ASCII, UCS-4
// or a charset of std.unicode.charmaps; std.xml.encoding), the XML and
// text declarations, the internal subset (entity, attribute list,
// element and notation declarations; parameter entities; attribute
// defaults and the normalization of non-CDATA attributes, as SAX2
// libxml2 applies them), general entities expanded where they are
// referenced (XML_PARSE_NOENT) or reported, character references,
// namespaces with libxml2's checks of them, CDATA sections, comments and
// processing instructions, and libxml2's quirks with them: line ends
// counted as it counts them, characters split where it splits them,
// whitespace in an entity's content reported as ignorable.
//
// Not here: external entities and the external subset are never loaded
// (as when libxml2 cannot load them), validation, the SAX1 callbacks,
// XML_PARSE_OLD10's older name rules, the limits libxml2 sets without
// XML_PARSE_HUGE on entity expansion (the parser always behaves as with
// that option, but for names and nesting). Entities nested in entities
// are parsed by recursion, as libxml2 parses them, up to its limit of
// 1024 or until the recursion has taken 3 MB of the stack, whichever
// comes first (some 300 entities deep in content): the loop is then
// reported as libxml2 reports it at its limit.
//
//     var handler: sax.Handler = sax.emptyHandler()
//     handler.user = ...
//     handler.startElementNs = @intFromPtr(onStart)
//     const address = sax.createPush(allocator, handler, 0, 0)
//     const parser = sax.parserAt(address)
//     const unknown = sax.useOptions(parser, sax.PARSE_NOENT)
//     const status = sax.parseChunk(parser, bytes, count, false)
//     const end = sax.parseChunk(parser, 0, 0, true)
//     sax.free(address)
const text = @import("./text.mlx")
const encoding = @import("./encoding.mlx")
const uri = @import("./uri.mlx")

pub const Allocator = text.Allocator
pub const Buffer = text.Buffer

